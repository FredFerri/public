lse,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-09-27T19:07:39+02:00","published_at":"2024-07-03T15:56:11+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":303544,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"theatre","ranking":0.43679023236814946,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":49,"translations":{"de":"Theater","pt":null,"en":"Theatre","it":"Teatro","cn":null,"fr":"Th\u00e9\u00e2tre","sp":"Teatro","nl":"Theater"}},"others":{}},"translations":{"de":{"name":"Silence en coulisses","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50012217"},"pt":{"name":"Silence en coulisses","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50012217"},"en":{"name":"Silence en coulisses","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50012217"},"it":{"name":"Silence en coulisses","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50012217"},"cn":{"name":"Silence en coulisses","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50012217"},"fr":{"name":"Silence en coulisses","shortdescr":null,"longdescr":"Silence\u2026 en coulisses ! Dans l\u2019impossibilit\u00e9 de g\u00e9rer sa troupe, le metteur en sc\u00e8ne craque. \u00ab La premi\u00e8re \u00bb approche, rien n\u2019est pr\u00e8s, il devient fou. Ses huit interpr\u00e8tes sont des branquignols. Ils ne comprennent rien \u00e0 rien. Pas m\u00e9chants, c\u2019est s\u00fbr, manquerait plus que \u00e7a, mais tellement mauvais, si peu concentr\u00e9s et compl\u00e8tement \u00e0 c\u00f4t\u00e9 de leurs pompes... si ce n\u2019\u00e9tait pour rire, il en pleurerait !\nCe n\u2019est quand m\u00eame pas compliqu\u00e9 le th\u00e9\u00e2tre : Hop tu entres en sc\u00e8ne ! Hop tu dis n\u2019importe quoi ! Et hop tu sors ! Qu\u2019est-ce que ces fichus com\u00e9diens ne comprennent pas l\u00e0-dedans ?\n \nPour f\u00eater dignement nos 30 ans de complicit\u00e9 avec vous, voici un vaudeville sur les coulisses du vaudeville. On va se laver la t\u00eate, arr\u00eater de se cuisiner la rate au cours bouillon, \u00eatre un moment en cong\u00e9 des fake news anxiog\u00e8nes et se mettre la cervelle en vacances. Comme le grand Jacques l\u2019a dit \u00ab il nous faut bien du talent pour \u00eatre vieux sans \u00eatre adultes \u00bb, non ? Alors, pour un soir, se gondoler devant le spectacle d\u2019humains si b\u00eates, si fragiles, si inconstants... tellement humains en somme, \u00e7a r\u00e9veille notre \u00e2me d\u2019enfant.\nVous voulez voir les coulisses ? Vous allez \u00eatre servis ! Venez vous \u00e9clater, la troupe est en d\u00e9lire.\n__________\n\nDe Michael Frayn \/ Adaptation fran\u00e7aise : St\u00e9phane Laporte \/ Mise en sc\u00e8ne : Michel Kacenelenbogen \/ Avec : Barbara Borguet, Bernard Cogniaux, Charlie Dupont, Tania Garbarski, Tiphanie Lefran\u00e7ois, Michelangelo Marchese, Nicole Oliver , Pierre Poucet et Fabio Zenoni \/ Assistantes \u00e0 la mise en sc\u00e8ne : Anne Sylvain et Diane Delangre \/ Sc\u00e9nographie : Sophie Hazebrouck \/ Costumes : Chandra Vellut \/ Lumi\u00e8re : Laurent Kaye \/ Musique originale : Pascal Charpentier\n__________\n\nUNE PRODUCTION DU TH\u00c9\u00c2TRE LE PUBLIC. AVEC L'AIDE DE LA F\u00c9D\u00c9RATION WALLONIE-BRUXELLES - DIRECTION DU TH\u00c9\u00c2TRE, ET LE SOUTIEN DU TAX SHELTER DE L\u2019\u00c9TAT F\u00c9D\u00c9RAL BELGE VIA BESIDE. La pi\u00e8ce \"Silence en Coulisses\" \/ \"Noises Off\" de Michael Frayn dans la traduction de St\u00e9phane Laporte est repr\u00e9sent\u00e9e par l'agence Drama (www.dramaparis.com) en accord avec United Agents Ltd \u00e0 Londres. ","performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50012217"},"sp":{"name":"Silence en coulisses","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50012217"},"nl":{"name":"Silence en coulisses","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50012217"}},"place":{"id":224476,"translations":{"de":{"name":"Th\u00e9\u00e2tre Le Public","address_street_name":"Rue Braemt","address_street_number":"64 70","addre