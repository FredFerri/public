":null,"email":"billetterie@theatre-martyrs.be","website":"http:\/\/www.theatre-martyrs.be","phone_contact":"+32 2 223 32 08","phone_booking":"+32 2 223 32 08","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Martyrs, 22","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"fr":{"name":"Th\u00e9\u00e2tre des Martyrs","address_street_name":"Place des Martyrs","address_street_number":"22","address_street_box":null,"email":"billetterie@theatre-martyrs.be","website":"http:\/\/www.theatre-martyrs.be","phone_contact":"+32 2 223 32 08","phone_booking":"+32 2 223 32 08","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Martyrs, 22","address_line2":"1000 Bruxelles","description_web":"Plac\u00e9 aujourd\u2019hui sous la direction artistique de Philippe Sireuil, le Th\u00e9\u00e2tre des Martyrs se d\u00e9finit aujourd\u2019hui comme un th\u00e9\u00e2tre mais pluriel, une sc\u00e8ne et des artistes.\r\nIl affirme ainsi le m\u00e9tissage des origines de cet art n\u00e9 \u00e0 c\u00f4t\u00e9 du forum grec ou sur le parvis de l\u2019\u00e9glise m\u00e9di\u00e9vale et dont il est l\u2019un des multiples h\u00e9ritiers, reprenant le t\u00e9moin de cet art qui, de tout temps, a rec\u00e9l\u00e9 toutes les peines et toutes les joies, tous les conflits et tous les d\u00e9bats de notre condition humaine, rires et larmes m\u00eal\u00e9s.\r\nIl comporte deux salles de spectacles : la grande salle, dite \u00e0 l\u2019italienne entre 255 (parterre) et 356 places (avec le balcon) et la petite salle destin\u00e9e \u00e0 des projets plus intimistes.","description_print":"Plac\u00e9 aujourd\u2019hui sous la direction artistique de Philippe Sireuil, le Th\u00e9\u00e2tre des Martyrs se d\u00e9finit aujourd\u2019hui comme un th\u00e9\u00e2tre mais pluriel, une sc\u00e8ne et des artistes.\r\nIl affirme ainsi le m\u00e9tissage des origines de cet art n\u00e9 \u00e0 c\u00f4t\u00e9 du forum grec ou sur le parvis de l\u2019\u00e9glise m\u00e9di\u00e9vale et dont il est l\u2019un des multiples h\u00e9ritiers, reprenant le t\u00e9moin de cet art qui, de tout temps, a rec\u00e9l\u00e9 toutes les peines et toutes les joies, tous les conflits et tous les d\u00e9bats de notre condition humaine, rires et larmes m\u00eal\u00e9s.\r\nIl comporte deux salles de spectacles : la grande salle, dite \u00e0 l\u2019italienne de 366 places, et la petite salle destin\u00e9e \u00e0 des projets plus intimistes.","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Th\u00e9\u00e2tre des Martyrs","address_street_name":"Place des Martyrs","address_street_number":"22","address_street_box":null,"email":"billetterie@theatre-martyrs.be","website":"http:\/\/www.theatre-martyrs.be","phone_contact":"+32 2 223 32 08","phone_booking":"+32 2 223 32 08","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Martyrs, 22","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Th\u00e9\u00e2tre des Martyrs","address_street_name":"Martelaarsplein","address_street_number":"22","address_street_box":null,"email":"billetterie@theatre-martyrs.be","website":"http:\/\/www.theatre-martyrs.be","phone_contact":"+32 2 223 32 08","phone_booking":"+32 2 223 32 08","address_zip":"1000","address_city":"Bruxelles","address_line1":"Martelaarsplein, 22","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":974,"location":{"lat":50.85207651,"lon":4.35620378},"last_updated_at":"2022-11-30T17:04:52+01:00","published_at":"2013-10-19T01:13:57+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/ag