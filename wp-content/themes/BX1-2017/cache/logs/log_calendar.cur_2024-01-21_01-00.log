ne_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50004162"},"pt":{"name":"De l'autre c\u00f4t\u00e9 - Spectacle familial cont\u00e9 et chant\u00e9","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lepetitchapeaurondrouge.be\/","email":"info@lepetitchapeaurondrouge.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50004162"},"en":{"name":"De l'autre c\u00f4t\u00e9 - Spectacle familial cont\u00e9 et chant\u00e9","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lepetitchapeaurondrouge.be\/","email":"info@lepetitchapeaurondrouge.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50004162"},"it":{"name":"De l'autre c\u00f4t\u00e9 - Spectacle familial cont\u00e9 et chant\u00e9","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lepetitchapeaurondrouge.be\/","email":"info@lepetitchapeaurondrouge.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50004162"},"cn":{"name":"De l'autre c\u00f4t\u00e9 - Spectacle familial cont\u00e9 et chant\u00e9","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lepetitchapeaurondrouge.be\/","email":"info@lepetitchapeaurondrouge.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50004162"},"fr":{"name":"De l'autre c\u00f4t\u00e9 - Spectacle familial cont\u00e9 et chant\u00e9","shortdescr":"Un solo th\u00e9\u00e2tral positif mis en chansons pour nous accompagner \u00e0 vivre l\u2019absence, avec un texte tendre, souriant et po\u00e9tique.","longdescr":"Vu le succ\u00e8s de la repr\u00e9sentation de ce 04 novembre (et parce que c'est un spectacle incroyable), nous vous le re-proposons ce dimanche 21 janvier!\n\nUn solo th\u00e9\u00e2tral positif mis en chansons pour nous accompagner \u00e0 vivre l\u2019absence, avec un texte tendre, souriant et po\u00e9tique. Ce qu\u2019Olivia Auclair (com\u00e9dienne) et le metteur en sc\u00e8ne Benoit Pauwels proposent c\u2019est avant tout un hymne \u00e0 la vie !\n\nPrunelle, dix ans, apprend que sa maman vient de mourir. Une succession d\u2019\u00e9motions fortes et de questions vont l\u2019envahir : Comment vivre sans ma maman ? Qui sera l\u00e0 pour me consoler ? Elle rencontre la Grande Faucheuse, une vieille dame pleine d\u2019empathie et de tendresse qui souhaite aider Prunelle \u00e0 se relever. Elle vous fera m\u00eame rire !\n\n\"Nous esp\u00e9rons que ce spectacle sera per\u00e7u comme si votre maman vous prenait dans les bras (quel que soit votre \u00e2ge) pour vous raconter la plus belle des histoires : celle de la Vie. Avec du sourire parfois mais surtout avec beaucoup de tendresse car ce texte se veut avant tout positif\".\n\nPour les \u00e2mes d'enfants de 8 \u00e0 88 ans.","performers":"Olivia Auclair","boxoffice_url":null,"website":"https:\/\/lepetitchapeaurondrouge.be\/","email":"info@lepetitchapeaurondrouge.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50004162"},"sp":{"name":"De l'autre c\u00f4t\u00e9 - Spectacle familial cont\u00e9 et chant\u00e9","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lepetitchapeaurondrouge.be\/","email":"info@lepetitchapeaurondrouge.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50004162"},"nl":{"name":"De l'autre c\u00f4t\u00e9 - Spectacle familial cont\u00e9 et chant\u00e9","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lepetitchapeaurondrouge.be\/","email":"info@lepetitchapeaurondro