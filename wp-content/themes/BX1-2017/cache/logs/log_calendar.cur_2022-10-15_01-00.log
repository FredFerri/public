:"1.0","oEmbed_provider_name":"YouTube","oEmbed_provider_url":"https:\/\/www.youtube.com\/","oEmbed_thumbnail_height":360,"oEmbed_thumbnail_width":480,"oEmbed_thumbnail_url":"https:\/\/i.ytimg.com\/vi\/9K14ke8ojj8\/hqdefault.jpg","oEmbed_html":"<iframe width=\"356\" height=\"200\" src=\"https:\/\/www.youtube.com\/embed\/9K14ke8ojj8?feature=oembed\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" allowfullscreen title=\"NO ANGRY YOUNG MAN - EYES FIXED ON ONE\"><\/iframe>","translations":{"fr":{"title":"NO ANGRY YOUNG MAN - EYES FIXED ON ONE"},"nl":{"title":"NO ANGRY YOUNG MAN - EYES FIXED ON ONE"},"en":{"title":"NO ANGRY YOUNG MAN - EYES FIXED ON ONE"}}},{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/417d1b57afa8de157d0891d098b8767f668132b2.png","width":2122,"height":1057,"ratio":2.01,"translations":{"fr":{"title":"ANNUL\u00c9 No Angry Young Man - Release Party \/ concert","copyright":"Hugo Segers"},"nl":{"title":"ANNUL\u00c9 No Angry Young Man - Release Party \/ concert","copyright":"Hugo Segers"},"en":{"title":"ANNUL\u00c9 No Angry Young Man - Release Party \/ concert","copyright":"Hugo Segers"}}},{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/640a41ed4e66cefd65691799e1bd1bb34201a257.png","width":731,"height":1300,"ratio":0.56,"translations":{"fr":{"title":"ANNUL\u00c9 No Angry Young Man - Release Party \/ concert","copyright":"Hugo Segers"},"nl":{"title":"ANNUL\u00c9 No Angry Young Man - Release Party \/ concert","copyright":"Hugo Segers"},"en":{"title":"ANNUL\u00c9 No Angry Young Man - Release Party \/ concert","copyright":"Hugo Segers"}}}],"dates":[{"day":"2022-10-18","doors":"20:00:00","start":"20:30:00","end":null,"is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Pr\u00e9vente"},"nl":{"name":"Voorverkoop"},"en":{"name":"Presale"}},"value":12},{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":15},{"translations":{"fr":{"name":"< 12 ans"},"nl":{"name":"< 12 jaar"},"en":{"name":"< 12 years"}},"value":0}],"child_events":[],"parent_events":[],"targets":{"list":[11,5,7,8,10,19],"translations":{"fr":["Famille","Enfants 9-12 ans","Jeunes 12-15 ans","Jeunes 15-18 ans","Seniors","Enseignants"],"nl":["Familie","Kinderen 9-12 j.","Jongeren 12-15 j.","Jongeren 15-18 j.","Senioren","Leerkrachten"],"en":["Family","Children 9-12 yr.","Youth 12-15  yr.","Youth 15-18  yr.","Seniors","Teachers"]}},"tags":["kids"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-11T04:35:36+02:00","published_at":"2022-09-09T11:34:19+02:00","backoffice_id":261435,"import_origin":null,"sub_type":"concert","show_in_agenda":true,"ranking":1.2599210498949},{"id":537326,"date_start":"2022-10-18","date_end":"2022-10-22","date_next":"2022-10-18","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater"}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"],"de":["Theater"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Quatuor","shortdescr":"Les deux derni\u00e8res pi\u00e8ces de la compagnie ZOO\/Thomas Hauert (How to proceed en 2018 et If Only en 2020) forment une sorte de diptyque o\u00f9 le moteur du mouvement provient des \u00e9tats \u00e9motionnels que procure l\u2019\u00e9tat du monde actuel. Dans cette nouvelle cr\u00e9ation, la compagnie laisse de c\u00f4t\u00e9 l\u2019\u00e9tat du monde tourment\u00e9 pour se plonger dans le rapport physique entre la vie et la terre.","longdescr":"Pouss\u00e9 peut-\u00eatre par le besoin de se rappeler que les \u00eatres humains font partie de la nature : une approche plus concr\u00e8te o\u00f9 la mati\u00e8re \u00e9merge directement des corps des interpr\u00e8tes confront\u00e9\u00b7es aux forces ext\u00e9rieures et \u00e0 l\u2019espace. Une dramaturgie abstraite s\u2019y d\u00e9ploie, plus proche de la composition musicale que de la narration th\u00e9\u00e2trale.\r\nLa vie et tous les \u00eatres vivants semblent constituer une anomalie, une coordination ing\u00e9nieuse entre mati\u00e8re et \u00e9nergie \u00e0 l\u2019origine bien moins ordonn\u00e9es. Ils vont \u00e0 l\u2019encontre de l\u2019entropie, de la perte d\u2019ordre et de concentration et de la tendance au chaos, qui est le destin absolument in\u00e9vitable pour tous les syst\u00e8mes physiques. Ce ph\u00e9nom\u00e8ne nomm\u00e9 n\u00e9guentropie, est fascinant : il est une sorte de force de coh\u00e9sion, comme une traduction physique de l\u2019information, un d\u00e9tournement ing\u00e9nieux de l\u2019\u00e9nergie. Il ne peut \u00eatre que transitoire mais cela ne le rend pas moins myst\u00e9rieux. Il a, entre autres, comme effet que tout organisme se distingue par la capacit\u00e9 de se soulever seul contre la gravit\u00e9, prouesse qu\u2019aucune mati\u00e8re inanim\u00e9e ne pourrait accomplir. Le mouvement est un \u00e9l\u00e9ment inh\u00e9rent \u00e0 la vie. Cependant, tout mouvement de notre corps se joue en relation avec la gravit\u00e9 et implique n\u00e9cessairement des tensions et des rel\u00e2chements en proportions et coordinations diverses. Cette fluctuation entre tension et rel\u00e2chement, la complexit\u00e9 de la pr\u00e9sence simultan\u00e9e et dynamique de ces antagonismes dans notre corps, ainsi que l\u2019alternance entre la r\u00e9sistance et l\u2019abandon \u00e0 la gravit\u00e9, sont les points de d\u00e9part, le focus et le champ cr\u00e9atif de Quatuor. Le mouvement du corps humain comme mati\u00e8re premi\u00e8re contient dans son essence la r\u00e9sistance aux forces les plus destructrices et les plus implacables de l\u2019univers. La vie a besoin de conditions tr\u00e8s pr\u00e9cises et improbables pour pouvoir na\u00eetre et perdurer. Une sorte d\u2019ode \u00e0 la vie, \u00e0 la terre et \u00e0 son atmosph\u00e8re fragile.","performers":"Concept, direction Thomas Hauert\r\nRecherche et cr\u00e9ation Fabian Barba, Thomas Hauert, Liz Kinoshita, Sarah Ludi, Federica Porello, Samantha Van Wissen\r\nInterpr\u00e9t\u00e9 par 4 danseur\u00b7ses de la compagnie\r\nMusique (en cours)\r\nLumi\u00e8re Bert Van Dijck\r\nSon Bart Celis\r\nCostume Chevalier-Masson\r\nSc\u00e9nographie Chevalier-Masson","boxoffice_url":null,"website":"http:\/\/www.lestanneurs.be","email":"info@lestanneurs.be","phone_contact":"+32 2 502 37 43","phone_booking":"+32 2 512 17 84","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.537326"},"nl":{"name":"Quatuor","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.537326"},"en":{"name":"Quatuor","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.537326"},"de":{"name":"Quatuor","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.537326"},"it":{"name":"Quatuor","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.537326"},"sp":{"name":"Quatuor","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":