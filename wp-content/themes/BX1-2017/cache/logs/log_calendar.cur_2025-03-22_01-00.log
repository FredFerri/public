ls\/fr\/visitors\/agenda\/event-detail.5700007113"},"sp":{"name":"Trio F\u00e9minin","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"concerts11amh@gmail.com","phone_contact":"+32 471 21 31 60","phone_booking":"+32 471 21 31 60","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700007113"},"nl":{"name":"Trio F\u00e9minin","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"concerts11amh@gmail.com","phone_contact":"+32 471 21 31 60","phone_booking":"+32 471 21 31 60","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700007113"}},"place":{"id":242272,"translations":{"de":{"name":"Atelier Marcel Hastir","address_street_name":"Rue du Commerce","address_street_number":"51","address_street_box":null,"email":"ateliermarcelhastir@gmail.com","website":"http:\/\/ateliermarcelhastir.eu\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Commerce, 51","address_line2":"1000 Bruxelles","description_web":"Das Atelier Marcel Hastir ist ein Ort der Kunst, der kulturellen und k\u00fcnstlerischen Begegnungen, der 1935 von dem Maler Marcel Hastir in seinem K\u00fcnstleratelier in der Rue du Commerce 51 eingerichtet wurde. Das ungew\u00f6hnliche Haus hei\u00dft seit Jahrzehnten inmitten der Kunstwerke sowohl junge K\u00fcnstler als auch gro\u00dfe Namen der belgischen und internationalen Musik- und Theaterszene willkommen - ein Ort, der mit seiner ganz besonderen Atmosph\u00e4re verzaubert.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Atelier Marcel Hastir","address_street_name":"Rue du Commerce","address_street_number":"51","address_street_box":null,"email":"ateliermarcelhastir@gmail.com","website":"http:\/\/ateliermarcelhastir.eu\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Commerce, 51","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Atelier Marcel Hastir","address_street_name":"Handelsstraat","address_street_number":"51","address_street_box":null,"email":"ateliermarcelhastir@gmail.com","website":"http:\/\/ateliermarcelhastir.eu\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Handelsstraat, 51","address_line2":"1000 Brussels","description_web":"The Atelier Marcel Hastir is a magical place where culture lovers and artists meet in the midst of Marcel Hastir's paintings, in the intimate setting of what has been his place of work since 1935.\r\nMarcel Hastir was a Belgian painter, theosofist and resistance fighter. His studio in the Leopold district served also as a concert hall for young musicians, and during the Second World War this \"painters school\" actually served as a relatively safe meeting place for young artists, students and resistance fighters. A team of passionate volunteers work for the preservation of his work and home organising concerts with both young and confirmed talent from Belgium and abroad.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Atelier Marcel Hastir","address_street_name":"Rue du Commerce","address_street_number":"51","address_street_box":null,"email":"ateliermarcelhastir@gmail.com","website":"http:\/\/ateliermarcelhastir.eu\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Commerce, 51","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Atelier Marcel Hastir","address_street_name":"Rue du Commerce","address_street_number":"51","address_street_box":null,"email":"ateliermarcelhastir@gmail.com","website":"http:\/\/ateliermarcelhastir.eu\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Commerce, 51","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Atelier Marcel Hastir","address_street_name":"Rue du Commerce","address_street_number":"51","address_street_box":null,"email":"ateliermarcelhastir@gmail.com","website":"http:\/\/ateliermarcelhastir.eu\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Commerce, 51","address_line2":"1000 Bruxelles","description_web":"Le nom Marcel Hastir vous dit quelque chose ?  Ce peintre, th\u00e9osophe et r\u00e9sistant belge a v\u00e9cu durant 76 ans (de 1935 jusqu\u2019\u00e0 sa mort) dans la rue du Commerce situ\u00e9e dans le quartier L\u00e9opold \u00e0 Bruxelles. Vous pouvez toujours y admirer ses toiles tout en appr\u00e9ciant de la musique classique ou du th\u00e9\u00e2tre. De grands noms du monde de la musique viennent dans ce lieu sp\u00e9cial depuis des d\u00e9cennies. L'atmosph\u00e8re intime et magique ne vous laissera pas indiff\u00e9rent.    \r\n\r\n","description_print":null,"booking_url":"https:\/\/ateliermarcelhastir.eu\/agenda\/","sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Atelier Marcel Hastir","address_street_name":"Rue du Commerce","address_street_number":"51","address_street_box":null,"email":"ateliermarcelhastir@gmail.com","website":"http:\/\/ateliermarcelhastir.eu\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Commerce, 51","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Atelier Marcel Hastir","address_street_name":"Handelsstraat","address_street_number":"51","address_street_box":null,"email":"ateliermarcelhastir@gmail.com","website":"http:\/\/ateliermarcelhastir.eu\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Handelsstraat, 51","address_line2":"1000 Brussel","description_web":"Zegt de naam Marcel Hastir je wat? Hij was een Belgisch kunstschilder, theosoof en verzetsstrijder. Van 1935 tot aan zijn dood 76 jaar later woonde hij in de Handelsstraat in de Brusselse Leopoldwijk. Je kan er zijn doeken nog steeds bewonderen terwijl je geniet van klassieke muziek of theater. Al decennialang komen op deze bijzondere plek grote namen uit de muziekwereld over de vloer. De intieme en magische sfeer zal je niet onberoerd laten.  ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[9],"translations":{"de":["Europ\u00e4isches Viertel"],"pt":[null],"en":["European Quarter"],"it":["Quartiere europeo"],"cn":[null],"fr":["Quartier europ\u00e9en"],"sp":["Barrio Europeo"],"nl":["Europese wijk"]}},"zones":{"list":[22],"translations":{"de":["Osten"],"pt":[null],"en":["East"],"it":["Est"],"cn":[null],"fr":["Est"],"sp":["Este"],"nl":["Oost"]}},"neca":null,"facebook_id":"AtelierMarcelHastir","backoffice_id":4704,"location":{"lat":50.8420134,"lon":4.3685574},"region":"brussels","last_updated_at":"2024-10-24T10:12:29+02:00","published_at":"2013-10-19T01:17:42+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":242272,"translations":{"de":{"name":"Atelier Marcel Hastir","address_street_name":"Rue du Commerce","address_street_number":"51","address_street_box":null,"email":"ateliermarcelhastir@gmail.com","website":"http:\/\/ateliermarcelhastir.eu\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Commerce, 51","address_line2":"1000 Bruxelles","description_web":"Das Atelier Marcel Hastir ist ein Ort der Kunst, der kulturellen und k\u00fcnstlerischen Begegnungen, der 1935 von dem Maler Marcel Hastir in seinem K\u00fcnstleratelier in der Rue du Commerce 51 eingerichtet wurde. Das ungew\u00f6hnliche Haus hei\u00dft seit Jahrzehnten inmitten der Kunstwerke sowohl junge K\u00fcnstler als auch gro\u00dfe Namen der belgischen und internationalen Musik- und Theaterszene willkommen - ein Ort, der mit seiner ganz besonderen Atmosph\u00e4re verzaubert.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Atelier Marcel Hastir","address_street_name":"Rue du Commerce","address_street_number":"51","address_street_box":null,"email":"ateliermarcelhastir@gmail.com","website":"http:\/\/ateliermarcelhastir.eu\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Commerce, 51","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Atelier Marcel Hastir","address_street_name":"Handelsstraat","address_street_number":"51","address_street_box":null,"email":"ateliermarcelhastir@gmail.com","website":"http:\/\/ateliermarcelhastir.eu\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Handelsstraat, 51","address_line2":"1000 Brussels","description_web":"The Atelier Marcel Hastir is a magical place where culture lovers and artists meet in the midst of Marcel Hastir's paintings, in the intimate setting of what has been his place of work since 1935.\r\nMarcel Hastir was a Belgian painter, theosofist and resistance fighter. His studio in the Leopold district served also as a concert hall for young musicians, and during the Second World War this \"painters school\" actually served as a relatively safe meeting place for young artists, students and resistance fighters. A team of passionate volunteers work for the preservation of his work and home organising concerts with both young and confirmed talent from Belgium and abroad.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Atelier Marcel Hastir","address_street_name":"Rue du Commerce","address_street_number":"51","address_street_box":null,"email":"ateliermarcelhastir@gmail.com","website":"http:\/\/ateliermarcelhastir.eu\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Commerce, 51","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Atelier Marcel Hastir","address_street_name":"Rue du Commerce","address_street_number":"51","address_street_box":null,"email":"ateliermarcelhastir@gmail.com","website":"http:\/\/ateliermarcelhastir.eu\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Commerce, 51","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Atelier Marcel Hastir","address_street_name":"Rue du Commerce","address_street_number":"51","address_street_box":null,"email":"ateliermarcelhastir@gmail.com","website":"http:\/\/ateliermarcelhastir.eu\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Commerce, 51","address_line2":"1000 Bruxelles","description_web":"Le nom Marcel Hastir vous dit quelque chose ?  Ce peintre, th\u00e9osophe et r\u00e9sistant belge a v\u00e9cu durant 76 ans (de 1935 jusqu\u2019\u00e0 sa mort) dans la rue du Commerce situ\u00e9e dans le quartier L\u00e9opold \u00e0 Bruxelles. Vous pouvez t