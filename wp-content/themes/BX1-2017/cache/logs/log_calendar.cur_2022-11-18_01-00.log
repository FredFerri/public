,"external_id":null,"is_in_address_book":true,"is_in_vb_export":false,"resto_ranking":0},"media":[{"type":"poster","link":"https:\/\/agendabrussels.imgix.net\/db02df03d6be0779536125088eb43fde59b8bf42.jpg","width":1280,"height":720,"ratio":1.78,"translations":{"fr":{"title":"Ars Musica - Soir\u00e9e en hommage de philippe boesmans","copyright":null},"nl":{"title":"Ars Musica - Soir\u00e9e en hommage de philippe boesmans","copyright":null},"en":{"title":"Ars Musica - Soir\u00e9e en hommage de philippe boesmans","copyright":null}}}],"dates":[{"day":"2022-11-29","doors":null,"start":"19:00:00","end":null,"is_soldout":false,"is_canceled":false},{"day":"2029-11-22","doors":null,"start":"20:30:00","end":null,"is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":15},{"translations":{"fr":{"name":"Seniors"},"nl":{"name":"Senioren"},"en":{"name":"Seniors"}},"value":12},{"translations":{"fr":{"name":"Jeunes"},"nl":{"name":"Jongeren"},"en":{"name":"Young people"}},"value":12}],"child_events":[],"parent_events":[538036],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":{"list":[257],"translations":{"fr":["Am\u00e9nagements pour personnes sourdes et malentendantes"],"nl":["Voorzieningen voor dove en slechthorende personen"],"en":["Facilities for deaf and hearing-impaired people"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-11-09T14:35:07+01:00","published_at":"2022-10-11T14:03:32+02:00","backoffice_id":257601,"import_origin":null,"sub_type":"concert","show_in_agenda":true,"ranking":1.2599210498949},{"id":545086,"date_start":"2022-11-29","date_end":"2022-11-29","date_next":"2022-11-29","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":true,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert","de":"Konzert"}},"others":{"list":[4,6],"translations":{"fr":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"],"nl":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"],"en":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"],"de":["Pop, Rock, Jazz...","Worldmusic, Folk & Country"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Volosi (POL)","shortdescr":"Polish powerfolk-strings","longdescr":"Consid\u00e9r\u00e9 comme le groupe le plus embl\u00e9matique de la sc\u00e8ne world-trad polonaise, VO\u0141OSI d\u00e9passe les limites de l\u2019instrument \u00e0 cordes, affichant une fusion actuelle unique ancr\u00e9e dans la tradition des Carpates. Les membres du quintet, dot\u00e9s d\u2019une \u00e9nergie brute et rock, vibrent sans fin d\u2019une virtuosit\u00e9 exub\u00e9rante, proche de la transe.\r\n\r\nLeur histoire d\u00e9bute en 2010, lorsque les fr\u00e8res Krzysztof et Stanis\u0142aw, de formation classique, ont un v\u00e9ritable coup de c\u0153ur pour des artistes de g\u00e9nie nich\u00e9s au c\u0153ur des montagnes des Beskides dans la r\u00e9gion de Sil\u00e9sie. Immerg\u00e9 dans la tradition, VO\u0141OSI cr\u00e9e alors un style musical authentique et inimitable, avec une sophistication h\u00e9rit\u00e9e du classique mais une improvisation du jazz . Ce ph\u00e9nom\u00e8ne les hisse tout autant sur les grandes sc\u00e8nes rock que classiques.","performers":"Krysztof Lason : violon\r\nZbigniew Micalek: violon\r\nJan Kacmarzyk: alto, pipes\r\nStanislaw Lason: violoncelle\r\nRobert Waszut: contrebasse","boxoffice_url":null,"website":"http:\/\/www.muziekpublique.be","email":"info@muziekpublique.be","phone_contact":null,"phone_booking":"+32 2 217 26 00","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.545086"},"nl":{"name":"Volosi (POL)","shortdescr":"Polish powerfolk-strings","longdescr":"Volosi heeft een verbluffende virtuositeit en cre\u00ebert een magische en toegankelijke mix van klassieke en traditionele Poolse volksmuziek, stevig onderbouwd met melodie, melancholie en het kruidige aroma van Oost-Europa. De hypnotiserende sound, gebracht door musici uit de Karpatische traditie, evolueert naar een compleet nieuw type van wereldmuziek: snaarinstrumenten met een rock sound, jazzy improvisaties en hedendaagse sensualiteit. Hun muziek kan worden omschreven als een explosie van muzikale energie. Een traditioneel trio ontmoet een klassieke violist en cellist voor een grensoverschrijdende trip waarbij ze muziek maken zoals dat vooraf nog nooit is gehoord. Dit strijkkwintet is momenteel een van de meest vooraanstaande ensembles in de Poolse en zelfs Europese sc\u00e8ne. Sinds hun debuut in 2010 heeft de band verschillende awards ontvangen, onder andere de Svetozar Stracina Grand Prix van de European Broadcasting, Czech Music Crossroads Award (Ostrava), \u2026","performers":"Krysztof Lason : viool\r\nZbigniew Micalek: viool\r\nJan Kacmarzyk: 3-snaar viola, pipes\r\nStanislaw Lason: cello\r\nRobert Waszut: contrabas","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.545086"},"en":{"name":"Volosi (POL)","shortdescr":"Polish powerfolk-strings","longdescr":"Considered the most emblematic band of the Polish world-trad scene, VO\u0141OSI goes beyond the limits of the stringed instrument, displaying a unique current fusion rooted in the Carpathian tradition. The members of the quintet, endowed with raw, rocking energy, endlessly vibrate with exuberant, trance-like virtuosity.\r\n\r\nTheir story began in 2010, when classically trained brothers Krzysztof and Stanis\u0142aw fell in love with the genius artists nestled in the heart of the Beskid Mountains in the Silesian region. Immersed in tradition, VO\u0141OSI then created an authentic and inimitable musical style, with a sophistication inherited from classical but an improvisation of jazz . This phenomenon brought them to the big rock and classical stages.","performers":"Krysztof Lason : violin\r\nZbigniew Micalek: violin\r\nJan Kacmarzyk: alto, pipes\r\nStanislaw Lason: cello\r\nRobert Waszut: double bass","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.545086"},"de":{"name":"Volosi (POL)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.545086"},"it":{"name":"Volosi (POL)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.545086"},"sp":{"name":"Volosi (POL)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.545086"},"pt":{"name":"Volosi (POL)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.545086"},"cn":{"name":"Volosi (POL)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.545086"}},"place":{"id":238099,"translations":{"fr":{"name":"Muziekpublique","address_street_name":"Galerie de la Porte de Namur","address_street_number":"3","address_street_box":null,"email":"info@muziekpublique.be","website":"http:\/\/www.muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":"+32 2 217 26 00","address_zip":"1050","address_city":"Ixelles","address_line1":"Galerie de la Porte de Namur, 3","address_line2":"1050 Ixelles","description_web":"Muziekpublique est le centre des musiques traditionnelles du monde de Bruxelles. Etablie dans le Th\u00e9\u00e2tre Moli\u00e8re au c\u0153ur du quartier africain, l\u2019asbl organise plus de 100 concerts par an et deux festivals (Hide & Seek Festival etc.). Par ailleurs Muziekpublique propose aussi 50 cours de musique et de danse du monde, comptant plus de 600 \u00e9l\u00e8ves. Ensuite, l\u2019asbl d\u00e9veloppe certains artistes et projets via son label, qui est aussi une agence de booking et de management. La musique traditionnelle a donc trouv\u00e9 un endroit id\u00e9al o\u00f9 se d\u00e9velopper et les artistes y constituent un r\u00e9seau vivant et dynamique cr\u00e9ant des liens de qualit\u00e9 avec le public. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Muziekpublique","address_street_name":"Galerij van de Naamsepoort","address_street_number":"3","address_street_box":null,"email":"info@muziekpublique.be","website":"http:\/\/www.muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":"+32 2 217 26 00","address_zip":"1050","address_city":"Elsene","address_line1":"Galerij van de Naamsepoort, 3","address_line2":"1050 Elsene","description_web":"Muziekpublique verspreidt en promoot muziek- en danstradities via een ambitieus programma van concerten, cursussen en projecten. Een jaarrond concertprogramma met Belgische en internationale artiesten vormt de kern van de activiteiten van de organisatie. Van contemplatieve tot feestelijke concerten vinden het hele jaar door plaats in het prachtige Moli\u00e8re Theater, aan de Naamsepoort, maar ook op verschillende plaatsen de hoofdstad.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},