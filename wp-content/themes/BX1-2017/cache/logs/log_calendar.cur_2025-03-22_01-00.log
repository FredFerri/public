ch das Jugendstil- und Art-d\u00e9co-Festival BANAD, die Brussels Biennale - Neoclassic (BBN) sowie weitere Projekte, darunter die Ausbildung von Stadtf\u00fchrern, der \u201eVerein der Freunde\u201c und der \u201eVerein der Eigent\u00fcmer\u201c. \r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Explore.brussels ","address_street_name":"Avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"https:\/\/www.explore.brussels\/fr","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Avenue Brugmann, 405","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Explore.brussels ","address_street_name":"Avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"https:\/\/www.explore.brussels\/fr","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Avenue Brugmann, 405","address_line2":"1180 Uccle","description_web":"Explore.Brussels is a network of guided tour associations in Brussels. This organisation includes ARAU, Arkadia, Bruxelles Bavard, Pro Velo, La Fonderie and Korei. Events are organised in co-production with these 6 companies. Individual or group tours are available on foot, by bike, by bus and by boat.  Visitors discover UNESCO heritage, Magritte, art deco, chocolate and much more. Explore.Brussels also organises Brussels festivals and other large-scale projects.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Explore.brussels ","address_street_name":"Avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"https:\/\/