"expo","show_in_agenda":true,"ranking":0.32363786536193},{"id":516586,"date_start":"2022-05-10","date_end":"2022-06-04","date_next":"2022-05-18","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre"}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Le Champ de Bataille","shortdescr":null,"longdescr":"Spectacle nomm\u00e9 aux Prix Maeterlinck de la Critique 2020 dans la cat\u00e9gorie \"Meilleur Seul en sc\u00e8ne\".\r\n\r\nL\u2019ennui avec les enfants, c\u2019est qu\u2019ils grandissent. C\u2019est qu\u2019un beau matin, sans pr\u00e9venir, ils mettent des trainings, r\u00e9pondent par onomatop\u00e9es et \u00e9coutent de la mauvaise musique (\u2026) \u00c7a co\u00fbte une fortune en cr\u00e8me anti-boutons, \u00e7a change d\u2019humeur toutes les six minutes, \u00e7a a le nez qui pousse. \u00c7a se tra\u00eene du divan au lit en mettant un point d\u2019honneur \u00e0 vous rappeler que vous n\u2019\u00eates absolument pas \u00e0 la hauteur de votre r\u00f4le de p\u00e8re. \u00c7a vous empoisonne. \u00c7a vous d\u00e9teste. C\u2019est cruel un enfant qui grandit. Comble de tout, une fois d\u00e9pass\u00e9 le m\u00e8tre 50, \u00e7a cesse de vous consid\u00e9rer comme Dieu en personne.\r\n\r\nLa quarantaine galopante, voil\u00e0 ce que se dit ce p\u00e8re, enferm\u00e9 dans les toilettes, ultime forteresse inviolable, o\u00f9 il consulte des d\u00e9pliants de voyage, mani\u00e8re d\u2019\u00e9chapper pour de bon \u00e0 la pesanteur du quotidien, avec d\u2019un c\u00f4t\u00e9 un fils a\u00een\u00e9 en pleine adolescence, de l\u2019autre son couple en crise, sexuelle notamment.\r\n\r\nJ\u00e9r\u00f4me Colin, Denis Laujol et Thierry Helin nous offrent un spectacle sur l\u2019amour familial o\u00f9 les sentiments sont \u00e0 vif, comme sur un champ de bataille. Un spectacle qui questionne la violence sociale, notamment produite par l\u2019\u00e9cole et la famille, mais qui n\u2019est jamais d\u00e9nu\u00e9 d\u2019esp\u00e9rance car il est port\u00e9 par une plume pleine de tendresse et de d\u00e9rision.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.poche.be\/show\/2021-le-champ-de-bataille","email":"reservation@poche.be","phone_contact":null,"phone_booking":"+32 2 649 17 27","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/516586.html"},"nl":{"name":"Le Champ de Bataille","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/516586.html"},"en":{"name":"Le Champ de Bataille","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/516586.html"},"de":{"name":"Le Champ de Bataille","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/516586.html"},"it":{"name":"Le Champ de Bataille","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/516586.html"},"sp":{"name":"Le Champ de Bataille","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/516586.html