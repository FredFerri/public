els\/de\/visitors\/agenda\/event-detail.539638"},"pt":{"name":"Parcours BD de Bruxelles - Visite priv\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.bravodiscovery.com","email":"info@bravodiscovery.com","phone_contact":null,"phone_booking":"+32 495 32 03 62","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.539638"},"en":{"name":"Comic Book Experience in Brussels","shortdescr":"Comic strip route in Brussels. Stroll through the center of Brussels and admire the monumental paintings honoring many characters from the Belgian comic strip.","longdescr":"Practical information: Price: 170 \u20ac (private tour of 3 hours \u2013 up to 10 people). 220 \u20ac (private tour of 3 hours \u2013 up to 25 people). When: Every day. Starting time: To be agreed with the guide. Meeting point: To be agreed with the guide. Duration: 3 hours or 6 hours. Language: The tour is exclusively in English. Included: English speaking guide. Exclusive and private tour. Tours defined according to your needs. Can be included: transport, museum admissions, meals, drinks\u2026","performers":null,"boxoffice_url":null,"website":"http:\/\/www.bravodiscovery.com","email":"info@bravodiscovery.com","phone_contact":null,"phone_booking":"+32 495 32 03 62","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.539638"},"it":{"name":"Parcours BD de Bruxelles - Visite priv\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.bravodiscovery.com","email":"info@bravodiscovery.com","phone_contact":null,"phone_booking":"+32 495 32 03 62","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.539638"},"cn":{"name":"Parcours BD de Bruxelles - Visite priv\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.bravodiscovery.com","email":"info@bravodiscovery.com","phone_contact":null,"phone_booking":"+32 495 32 03 62","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.539638"},"fr":{"name":"Parcours BD de Bruxelles - Visite priv\u00e9e","shortdescr":"Partons \u00e0 la d\u00e9couverte de la capitale belge d\u2019une mani\u00e8re originale et insolite en faisant son fameux parcours BD en visite priv\u00e9e avec un guide personnel et passionn\u00e9 par le sujet et par Bruxelles","longdescr":"Partons sur les traces d\u2019Herg\u00e9, Olivier Rameau, Fran\u00e7ois Schuiten, Uderzo et Goscinny et tant d\u2019autres gr\u00e2ce \u00e0 leurs planches repeintes sur des fa\u00e7ades des rues \u00e9troites aux quatre coins du centre de Bruxelles. Gr\u00e2ce \u00e0 notre parcours BD en visite priv\u00e9e \u00e0 Bruxelles, d\u00e9couvrons l\u2019hommage rendu par la ville \u00e0 ses dessinateurs et \u00e0 ses personnages. Nous parcourrons avec le guide de magnifiques rues \u00e0 la recherche des planches et il se fera un plaisir de nous raconter tout ce que nous avons \u00e0 savoir sur les personnages et les dessinateurs : histoires, l\u00e9gendes, anecdotes, \u2026 Il pourra \u00e9galement nous conter la naissance et l\u2019\u00e9volution de la bande dessin\u00e9e jusqu\u2019\u00e0 nos jours. Programme : Le programme du parcours BD de Bruxelles \u2013 visite priv\u00e9e, est similaire \u00e0 celui du \u00ab Parcours BD de Bruxelles \u00bb. Bien entendu, nous adapterons l\u2019itin\u00e9raire pour r\u00e9pondre \u00e0 vos besoins. Informations pratiques : Prix : 170 \u20ac (visite priv\u00e9e de 3 heures \u2013 jusqu\u2019\u00e0 10 personnes). 220 \u20ac (visite priv\u00e9e de 3 heures \u2013 jusqu\u2019\u00e0 25 personnes). Quand : Tous les jours. Heures de d\u00e9part : \u00c0 vous de choisir. Point de rencontre : \u00c0 vous de choisir : \u00e0 la Grand-Place de Bruxelles, \u00e0 votre h\u00f4tel (tant que celui-ci est situ\u00e9 dans le centre de Bruxelles) ou \u00e0 l\u2019endroit de votre choix au centre-ville de Bruxelles. Dur\u00e9e : 3 heures. Langue : Fran\u00e7ais. Inclus : Guide professionnel francophone, expert de l\u2019histoire de la BD. Parcours d\u00e9finis selon nos besoins. Circuits d\u00e9finis selon vos besoins. Peuvent \u00eatre inclus: transport, entr\u00e9es aux mus\u00e9es, repas, boissons, \u2026","performers":null,"boxoffice_url":null,"website":"http:\/\/www.bravodiscovery.com","email":"info@bravodiscovery.com","phone_contact":null,"phone_booking":"+32 495 32 03 62","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.539638"},"sp":{"name":"Parcours BD de Bruxelles - Visite priv\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.bravodiscovery.com","email":"info@bravodiscovery.com","phone_contact":null,"phone_booking":"+32 495 32 03 62","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.539638"},"nl":{"name":"Parcours BD de Bruxelles - Visite priv\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.bravodiscovery.com","email":"info@bravodiscovery.com","phone_contact":null,"phone_booking":"+32 495 32 03 62","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.539638"}},"place":{"id":258936,"translations":{"de":{"name":"Bravo Discovery sprl","address_street_name":"Rue du Midi 76 ","address_street_number":"76","address_street_box":null,"email":"info@bravodiscovery.com","website":"http:\/\/www.bravodiscovery.com","phone_contact":"+32 470 60 35 05","phone_booking":"+32 495 32 03 62","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Midi 76 , 76","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Bravo Discovery sprl","address_street_name":"Rue du Midi 76 ","address_street_number":"76","address_street_box":null,"email":"info@bravodiscovery.com","website":"http:\/\/www.bravodiscovery.com","phone_contact":"+32 470 60 35 05","phone_booking":"+32 495 32 03 62","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Midi 76 , 76","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Bravo Discovery sprl","address_street_name":"Rue du Midi 76 ","address_street_number":"76","address_street_box":null,"email":"info@bravodiscovery.com","website":"http:\/\/www.bravodiscovery.com","phone_contact":"+32 470 60 35 05","phone_booking":"+32 495 32 03 62","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Midi 76 , 76","address_line2":"1000 Bruxelles","description_web":"Bravo Discovery offers you a quality tour guide service anywhere in Belgium.\r\nWe work in conjunction with the Brussels tourism office. We practice responsible tourism while respecting the local economy. Our employees are professional guides and we have a team of freelance guides trained in the \u201cHaute \u00c9coles\u201d of Brussels.\r\n\u200bWe work in partnership with local businesses and can call on a range of quality service providers to suit your needs.\r\nWe specialize in providing tailor-made tours, based on the interests of our clients and mindful of the need to balance culture and relaxation.\r\n\u200bOur strengths: experience, local guides, enthusiastic and charismatic staff.\r\nOur values: responsible tourism, professionalism, respect of the historical and cultural heritage, protection of the environment, sustainable competitiveness.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Bravo Discovery sprl","address_street_name":"Rue du Midi 76 ","address_street_number":"76","address_street_box":null,"email":"info@bravodiscovery.com","website":"http:\/\/www.bravodiscovery.com","phone_contact":"+32 470 60 35 05","phone_booking":"+32 495 32 03 62","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue