:"18:00:00","end":"19:00:00"}]},"saturday":{"is_open":true,"hours":[{"start":"10:00:00","end":"11:00:00"},{"start":"11:00:00","end":"12:00:00"}]},"sunday":{"is_open":false}},"translations":{"fr":["lundi, mardi, mercredi, jeudi et dimanche: ferm\u00e9","vendredi: de 18:00 \u00e0 19:00","samedi: de 10:00 \u00e0 11:00 et de 11:00 \u00e0 12:00"],"nl":["maandag, dinsdag, woensdag, donderdag en zondag: gesloten","vrijdag: van 18:00 tot 19:00","zaterdag: van 10:00 tot 11:00 en van 11:00 tot 12:00"],"en":["monday, tuesday, wednesday, thursday and sunday: closed","friday: from 18:00 to 19:00","saturday: from 10:00 to 11:00 and from 11:00 to 12:00"]},"date_start":"2022-09-10","date_end":"2023-06-24","is_also_by_appointment":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":60}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-23T01:08:07+02:00","published_at":"2022-09-08T15:05:44+02:00","backoffice_id":261343,"import_origin":null,"sub_type":"sport","show_in_agenda":true,"ranking":0.15142671606934},{"id":515896,"date_start":"2021-07-19","date_end":"2022-12-31","date_next":"2022-10-28","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen"}},"others":{}},"languages":{"spoken":["en","fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Visite des brasseries de Bruxelles & rencontrez le brasseur","shortdescr":"Visite d'une brasserie artisanale bruxelloise : d\u00e9couvrez les diff\u00e9rences entre le Lambic centenaire et la plus jeune brasserie de la ville. En bonus : rencontrez le brasseur!\r\nFaites connaissance avec le march\u00e9 belge de la bi\u00e8re en d\u00e9couvrant deux brasseries locales diff\u00e9rentes.","longdescr":"Inclus: \r\nSix bi\u00e8res belges de qualit\u00e9, des \u00e9ditions limit\u00e9es \u00e0 notre cr\u00e9ations traditionnelles\r\nDeux brasseries artisanales dont une n'est g\u00e9n\u00e9ralement pas ouverte au public\r\nDeux lieux r\u00e9put\u00e9s pour les amateurs de bi\u00e8re\r\nUn guide jeune et passionn\u00e9 qui a lanc\u00e9 l'une des premi\u00e8res bi\u00e8res artisanales belges\r\nTransport entre les brasseries\r\n\r\nPoints forts: \r\nVisitez une brasserie de Lambic et d\u00e9couvrez l'ancien style de brassage bruxellois (disponible uniquement \u00e0 Bruxelles - en journ\u00e9e)\r\nRencontre avec le brasseur\r\nD\u00e9couvrez le processus de brassage, de la malterie \u00e0 la salle de fermentation\r\nD\u00e9fiez vos amis pendant le jeu de la bi\u00e8re\r\nD\u00e9couvrez le vrai go\u00fbt du houblon et des malts\r\nInspirez-vous des nouvelles visites de brasseries dans toute la Belgique\r\nD\u00e9couvrez d'autres d\u00e9lices locaux gr\u00e2ce \u00e0 un accord mets et bi\u00e8res","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.515896"},"nl":{"name":"Brussels craft brouwerijtour & ontmoet de brouwer","shortdescr":"Ontdek via een brouwerijbezoek het contrast tussen de 100-jarige Lambiek en de jongste brouwerij van Brussel.\r\n\r\nBezoek twee verschillende craft brouwerijen: de beste manier om jou te introduceren tot de Belgische biercultuur.","longdescr":"Inbegrepen: \r\nDegusteren van 6 hoogstaande Belgische bieren; van exclusieve tot traditionele brouwsels\r\nBezoek aan 2 ambachtelijke Brusselse brouwerijen, waarvan \u00e9\u00e9n met exclusieve toegang\r\nTussenstop in 2 hoog gekwalificeerde biercaf\u00e9s dat \u00e9\u00e9n en al Brussel uitstraalt\r\nJonge, lokale en gepassioneerd gastvrouw die \u00e9\u00e9n van de eerste Belgische craft bieren lanceerde\r\nTransport tussen de brouwerijbezoeken\r\n\r\nHoogtepunten: \r\nBezoek de oudste Lambiek brouwerij waar nog steeds de authentieke brouwtechnieken worden toegepast (Niet beschikbaar op zondag)\r\nOntmoet de brouwer\r\nReis mee met het graan door het volledige brouwproces: van de mouterij tot in de fermentatieruimte.\r\nDaag je vrienden uit tijdens een leerrijke bierquiz (en win een smakelijke prijs)\r\nOntdek de echte smaak van hop en mout\r\nDe smaak te pakken? Doe inspiratie op voor andere brouwerijbezoeken doorheen in Belgi\u00eb\r\nPrikkel je smaakpapillen en ontdek de lokale eetcultuur via een doordachte foodpairing","performers":"Liselot Caura ( zaakvoerder & gepassioneerde biergids) \r\nMaxim & Gregoire ( brouwers L'Annexe)","boxoffice_url":null,"website":"https:\/\/beersecret.com\/tour\/brussels-craft-brewery-tour-meet-the-brewer\/","email":"liselot@creatiefcaura.com","phone_contact":null,"phone_booking":"+32 472 60 47 46","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.515896"},"en":{"name":"Brussels craft brewery tour & meet the brewer","shortdescr":"Explore the differences between the 100-year-old Lambic and the youngest brewery in town. Bonus: get to meet the brewer!\r\nGet introduced to the Belgian beer market by exploring two different local breweries.","longdescr":"Included in the price: \r\n6 high-quality Belgian beers from limited editions to our traditional brews\r\n2 craft breweries: Cantillon & L'Annexe, which is not usually open to the public\r\n1 renowned beer lovers' spots\r\nA young and passionate local guide who launched one of the first Belgian craft beers\r\nTransportation between breweries\r\n\r\nHIghlights: \r\nVisit a Lambic brewery and discover the old Brussels style (not on Sundays)\r\nMeet the brewer\r\nLearn about the brewing process, from the maltery to the fermentation room\r\nChallenge your friends during the beer game\r\nDiscover the real taste of hops and malts\r\nGet inspiration for new brewery visits all over Belgium\r\nDiscover more of the local delicacies thanks to a special food pairing","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.515896"},"de":{"name":"Ontdek de Brusselse brouwerijwereld met een local bierkenner","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.515896"},"it":{"name":"Ontdek de Brusselse brouwerijwereld met een local bierkenner","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.515896"},"sp":{"name":"Ontdek de Brusselse brouwerijwereld met een local bierkenner","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.515896"},"pt":{"name":"Ontdek de Brusselse brouwerijwereld met een local bierkenner","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.515896"},"cn":{"name":"Ontdek de Brusselse brouwerijwereld met een local bierkenner","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.515896"}},"place":{"id":266754,"translations":