slations":{"de":{"name":"Time, Place, Memory","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"info@aloft-brussels.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700007107"},"pt":{"name":"Time, Place, Memory","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"info@aloft-brussels.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700007107"},"en":{"name":"Time, Place, Memory","shortdescr":"Her artistic practice spans a wide variety of projects, including book illustration and writing, mural painting, graphic design, printmaking, ceramics, and embroidery.","longdescr":"Her artistic practice spans a wide variety of projects, including book illustration and writing, mural painting, graphic design, printmaking, ceramics, and embroidery. \n\nWhen traveling, Dina always carries a sketchbook with her. \nThe places she explores inspire her to capture a moment, a memory, feeling through her drawings.\n \nEach sketch becomes a frozen moment, deeply personal, reflecting her unique perspective and emotional state at the time of its creation. \n\nHer travel sketches enrich her sensitive and visual language. They allow her to fully immerse herself in the present moment, sharpen her focus, and delve deeply into the act of drawing This exhibition showcases a selection of travel sketches created between 2021 and 2024. \n\nDina Melnikova has published two books with CotCotCot Editions: Soir\u00e9e d'\u00e9t\u00e9 and A tire-d'aile.\n","performers":"Artist: Dina Melnikova","boxoffice_url":null,"website":null,"email":"info@aloft-brussels.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700007107"},"it":{"name":"Time, Place, Memory","shortdescr":null,"longdescr":null,"perform