10-16","doors":null,"start":"14:00:00","end":"19:00:00"}],"weekschema":[{"days":{"monday":{"is_open":false},"tuesday":{"is_open":false},"wednesday":{"is_open":false},"thursday":{"is_open":true,"hours":[{"start":"14:00:00","end":"19:00:00"}]},"friday":{"is_open":true,"hours":[{"start":"14:00:00","end":"19:00:00"}]},"saturday":{"is_open":true,"hours":[{"start":"14:00:00","end":"19:00:00"}]},"sunday":{"is_open":true,"hours":[{"start":"14:00:00","end":"19:00:00"}]}},"translations":{"fr":["lundi, mardi et mercredi: ferm\u00e9","jeudi, vendredi, samedi et dimanche: de 14:00 \u00e0 19:00"],"nl":["maandag, dinsdag en woensdag: gesloten","donderdag, vrijdag, zaterdag en zondag: van 14:00 tot 19:00"],"en":["monday, tuesday and wednesday: closed","thursday, friday, saturday and sunday: from 14:00 to 19:00"]},"date_start":"2022-09-16","date_end":"2022-10-16","is_also_by_appointment":true}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"opening":{"day":"2022-09-15","start":"18:00:00","timestamp":"2022-09-15T18:00:00+02:00","end":"23:00:00","is_only_by_appointment":false},"tags":[],"accessibilities":{"list":[252,255,261,263,265],"translations":{"fr":["Accessible aux personnes ayant des difficult\u00e9s de compr\u00e9hension","Accessible","Parking accessible","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9"],"nl":["Toegankelijk voor mensen met een verstandelijke beperking","Toegankelijk","Toegankelijke parking","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet"],"en":["Accessible to people with intellectual disabilities","Accessible","Accessible parking","Accessible to pedestrians with mobility aids","Adapted toilet"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-09-30T02:05:30+02:00","published_at":"2022-09-12T08:59:33+02:00","backoffice_id":261583,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.31833136784577},{"id":541365,"date_start":"2022-09-16","date_end":"2022-10-16","date_next":"2022-09-30","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[24,25],"translations":{"fr":["Galeries d'art","Arts audiovisuels"],"nl":["Galeries","Audiovisuele kunst"],"en":["Art Galleries","Audiovisual art"]}}},"languages":{"spoken":["fr","en"],"subtitles":[]},"translations":{"fr":{"name":"Baiser la peur - Rituels pluriels par HIRO","shortdescr":"Pour cette premi\u00e8re exposition chez that\u2019s what x said, HIRO (Nour Beetch et Nicky Lapierre), produit par Porn Freaks Club, pr\u00e9sente une exp\u00e9rience immersive impr\u00e9gn\u00e9e d\u2019une nouvelle r\u00e9alit\u00e9, fa\u00e7onn\u00e9e par leur amour tendre et radical.","longdescr":"Le d\u00e9sir est r\u00e9sistance \u00e0 la norme (Monique Wittig). \r\n\r\nC\u2019est par ce m\u00eame d\u00e9sir qu\u2019HIRO fait barrage et rejette la norme cis-h\u00e9t\u00e9ropatriarcale qui r\u00e8gne sur nos vies sociales et intimes pour envahir le monde de nouvelles images sanglantes et amoureuses, monstrueuses et d\u00e9licates. \r\n\r\nPour cette premi\u00e8re exposition chez that\u2019s what x said, HIRO (Nour Beetch et Nicky Lapierre), produit par Porn Freaks Club, pr\u00e9sente une exp\u00e9rience immersive impr\u00e9gn\u00e9e d\u2019une nouvelle r\u00e9alit\u00e9, fa\u00e7onn\u00e9e par leur amour tendre et radical. \r\n\r\nHIRO est une recherche visuelle et artiviste, un documentaire intime queer et militant, une cam\u00e9ra cach\u00e9e sur leur vie commune et crois\u00e9e. Le duo travaille sans hi\u00e9rarchie, proposant des positions interchangeables o\u00f9 lae mod\u00e8le et lae photographe sont \u00e0 la fois sujets de plaisir et cr\u00e9ateurices de visuels. En conversation \u00e9gale et continue, HIRO \u00e9labore des rituels pluriels, en transmutation permanente, entre alchimie et magie, brulant les genres et transgressant les codes. Leur travail se traduit en une explosion de possibles \u00e0 la fois tendres, sexy et trash o\u00f9 leurs enveloppes incarnent leur moyen d\u2019expression.\r\n\r\n\u00c0 travers diff\u00e9rents m\u00e9diums, en appelant \u00e0 tous nos sens, le duo cherche \u00e0 d\u00e9construire la culture dominante qui nous \u00e9touffe jusqu\u2019au plus intime de nos vies. Iels utilisent la photographie et la vid\u00e9o pour offrir une nouvelle forme de pornographie \u00e0 la fois douce et hors des tabous, donnant \u00e0 leurs cr\u00e9ations une dimension multiple ; alliant revendications politiques, artistiques et intimes. Ce laboratoire \u00e9rotique propose une nouvelle approche sensorielle, alternative et vulgaire mais aussi bienveillante et radicale. HIRO prend la voix que l\u2019on ne leur a jamais donn\u00e9e pour tenter de changer les mentalit\u00e9s. \r\n\r\nLe duo se photographie dans la vie de tous les jours, captures d\u2019un moment ou mise en sc\u00e8ne, en manipulant leurs chairs et leurs transidentit\u00e9s comme arme de lib\u00e9ration : leur nudit\u00e9 est politique. Trop souvent lieu de projection des in\u00e9galit\u00e9s, iels utilisent leurs corps pour se d\u00e9charger des injonctions binaires et exprimer leurs sensualit\u00e9s propres et plurielles. HIRO revendique un monde plus inclusif, accueillant leurs vuln\u00e9rabilit\u00e9s comme une force. \r\n\r\n\"Consumer les failles rena\u00eetre dans l\u2019image br\u00fbl\u00e9e\r\nSucer le jour, poncer la nuit, n\u2019importe comment,\r\n\u00eatre un autre suspendu entre les heures, baiser la peur\r\nToujours les flammes pour l\u00e9cher nos plaies\r\nToujours les armes pour supporter \u201d\r\n\r\n\u00c0 travers cette exposition, HIRO, en d\u00e9construction constante, nous fait voir un \u00e9chantillon de leur utopie intime, pornographique et militante.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.thatswhatxsaid.com","email":"contact@thatswhatxsaid.com","phone_contact":"+32 2 646 37 19","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.541365"},"nl":{"name":"Baiser la peur - Rituels pluriels by HIRO","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.541365"},"en":{"name":"Baiser la peur - Rituels pluriels by HIRO","shortdescr":"For this first exhibition at that\u2019s what x said, HIRO (Nour Beetch and Nicky Lapierre), produced by Porn Freaks Club, presents an immersive experience into their universe imbued with a new reality, shaped by their love that is both delicate and radical.","longdescr":"Le d\u00e9sir est r\u00e9sistance \u00e0 la norme (Desire is a resistance against the norm) \u2013 Monique Wittig. \r\n\r\nIt\u2019s through that desire that HIRO rejects the cis-heteropatriarchal norms that dominates our social and intimate lives, invading the world with new images, both ferocious and in love, monstrous and delicate. \r\n\r\nFor this first exhibition at that\u2019s what x said, HIRO (Nour Beetch and Nicky Lapierre), produced by Porn Freaks Club, presents an immersive experience into their universe imbued with a new reality, shaped by their love that is both delicate and radical.  \r\n\r\nHIRO is a visual and artivist exploration, a queer militant documentary, a behind the scenes of their most intimate moments, of their lives together. HIRO works without hierarchy, the roles of models and photographers are interchangeable, both subjects of pleasure and image creators. Through equal and continuous conversations, HIRO creates multiple rituals, permanently evolving, between alchemy and magic, burning genders and transgressing the rules. Their work promises a multitude of possibilities, all tenders, sexy and crude, in which their bodies symbolise their means of expressing themselves freely. \r\n\r\nThrough different mediums, calling to all our senses, the duo aims to confront the dominant culture restricting all aspects of life, right to the most intimate parts of ourselves. They use photography and film to create a new type of pornography, soft and without taboos, overlapping political, artistic, and intimate statements. Their ever-growing erotic lab illustrates a new sensory approach, alternative and vulgar, but also caring and radical. HIRO claims the voice that was never handed to them, in an attempt to change mentalities. \r\n\r\nThe duo photographs each other in their everyday lives, capturing a moment or staging an image, manipulating their flesh and transidentities as their weapon of liberation; their naked bodies are political. Too often the canvas of inequalities, they use their bodies to break away from binary injunctions and express their sensualities. HIRO claims a more inclusive world, welcoming their vulnerabilities as a strength. \r\n\r\n\"Consumer les failles rena\u00eetre dans l\u2019image br\u00fbl\u00e9e\r\nSucer le jour, poncer la nuit, n\u2019importe comment,\r\n\u00eatre un autre suspendu entre les heures, baiser la peur\r\nToujours les flammes pour l\u00e9cher nos plaies\r\nToujours les armes pour supporter \u201d\r\n\r\nIn this exhibition, HIRO gives us a glimpse of their innermost utopia, both pornographic and militant.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.541365"},"de":{"name":"OPENING 15\/09 -","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detai