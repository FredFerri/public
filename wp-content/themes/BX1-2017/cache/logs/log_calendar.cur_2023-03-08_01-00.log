625"},"nl":{"name":"TAI CHI - Beweging in Museum","shortdescr":"TAI CHI  \r\nInnerlijke bewegingskunst","longdescr":"HEROPSTART\u00a0 TAI CHI\u00a0\r\nTai Chi is een van oorsprong Chinese vechtkunst vaak beoefend als innerlijke bewegingskunst opgebouwd rond de energie Chi. Traag vloeiende bewegingen worden in patronen uitgevoerd. Tai chi ontspant de spieren en gewrichten, zorgt voor een betere bloedcirculatie en effici\u00ebntere stofwisseling en maakt stressbestendiger.\r\n\r\nOutfit\u00a0: Losse kleding, zachte schoenen of pantoffels.\r\n\r\nDatums\u00a0:\r\nop vrijdagen van 10u tot 11u30\r\n10-17-24-31.03.2023\r\n28.04.2023\r\n19-26.06.2023\r\n\r\nMogelijkheid om deel te nemen aan een gratis sessie op reservatie bij\u00a0:\r\nFemigra vzw asbl\r\nDiliara 0478\/13 94 39 of femigrada@gmail.com\r\nInlichtingen over de prijs ook bij de begeleider.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":"+32 478 13 94 39","phone_booking":"+32 478 13 94 39","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.547625"},"en":{"name":"TAI CHI - Mouvement au Mus\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":"+32 478 13 94 39","phone_booking":"+32 478 13 94 39","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.547625"},"de":{"name":"TAI CHI - Mouvement au Mus\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":"+32 478 13 94 39","phone_booking":"+32 478 13 94 39","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.547625"},"it":{"name":"TAI CHI - Mouvement au Mus\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":"+32 478 13 94 39","phone_booking":"+32 478 13 94 39","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.547625"},"sp":