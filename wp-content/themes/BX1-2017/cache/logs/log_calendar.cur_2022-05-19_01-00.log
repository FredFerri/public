alse,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre"}},"others":{"list":[51],"translations":{"fr":["Caf\u00e9 th\u00e9\u00e2tre"],"nl":["Cabaret"],"en":["Cabaret"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"The Boring Show ) Spectacle d'improvisation","shortdescr":null,"longdescr":"Vous aurez le plaisir de d\u00e9couvrir un\u00b7e improvisateur\u00b7trice d'exception \u00e0 chaque spectacle en plus de vos quatre Boring pr\u00e9f\u00e9r\u00e9\u00b7e\u00b7s.\r\nLes invit\u00e9\u00b7e\u00b7s sont des ami\u00b7e\u00b7s de la Boring Team venant des meilleures troupes d'improvisation.\r\n\r\nPour le reste, c'est toujours votre recette pr\u00e9f\u00e9r\u00e9e : un spectacle enti\u00e8rement improvis\u00e9 en deux parties.\r\nEn premi\u00e8re partie, en \u00e9change des mots de d\u00e9part qui vous seront demand\u00e9s, la Boring cr\u00e9era des histoires incroyables.\r\nEn deuxi\u00e8me partie, trois improvisations de 12 minutes, inspir\u00e9es de la premi\u00e8re partie, prendront vie sous vos yeux.\r\nUn cocktail de cr\u00e9ations instantan\u00e9es qui vous \u00e9tonnera encore et toujours par sa spontan\u00e9it\u00e9!\r\nN\u2019attendez plus, plut\u00f4t que de passer une soir\u00e9e boring venez plut\u00f4t voir un spectacle BORING !","performers":"La Boring Team","boxoffice_url":null,"website":"http:\/\/www.letrac.be\/reservations","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/530593.html"},"nl":{"name":"The Boring Show ) Spectacle d'improvisation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/530593.html"