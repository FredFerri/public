ldout":false,"categories":{"main":{"id":118,"translations":{"fr":"Festival","nl":"Festival","en":"Festival"}},"others":{"list":[120],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Festival Paroles de r\u00e9sistance - 4i\u00e8me \u00e9dition","shortdescr":null,"longdescr":"La quatri\u00e8me \u00e9dition du Festival Paroles de r\u00e9sistance abordera cette ann\u00e9e au travers de spectacles pour grands et petits, de d\u00e9bats, de conf\u00e9rence, de musique, la question de la r\u00e9sistance et de la d\u00e9sob\u00e9issance d'un point de vue f\u00e9minin.\r\nQuatre jours pour nous questionner, quand ob\u00e9issons-nous ? A quoi et surtout comment ? Et quand devons-nous d\u00e9sob\u00e9ir et pourquoi ? Quelle est la diff\u00e9rence entre la soumission, le conformisme de tradition et quelle diff\u00e9rence y a-t-il entre la r\u00e9volte, la r\u00e9sistance, la r\u00e9forme, la r\u00e9bellion ?","performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatredelaparole.be\/la-saison\/festival-parole-de-resistance-4eme-edition\/","email":"info@theatredelaparole.be","phone_contact":"+32 2 736 69 50","phone_booking":"+32 2 736 69 50","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/533592.html"},"nl":{"name":"Festival Paroles de r\u00e9sistance - 4i\u00e8me \u00e9dition","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/533592.html"},"en":{"name":"Festival Paroles de r\u00e9sistance - 4i\u00e8me \u00e9dition","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/533592.html"},"de":{"name":"Festival Paroles de r\u00e9sistance 4i\u00e8me \u00e9dition","shortd