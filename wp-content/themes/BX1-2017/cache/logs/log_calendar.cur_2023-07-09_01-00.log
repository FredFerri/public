, friday and saturday: from 12:00 to 18:00"],"sp":["monday, tuesday, wednesday and sunday: closed","thursday, friday and saturday: from 12:00 to 18:00"],"pt":["monday, tuesday, wednesday and sunday: closed","thursday, friday and saturday: from 12:00 to 18:00"],"cn":["monday, tuesday, wednesday and sunday: closed","thursday, friday and saturday: from 12:00 to 18:00"]},"date_start":"2023-06-15","date_end":"2023-07-29","is_also_by_appointment":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[19,11,20,10,12],"translations":{"fr":["Enseignants","Famille","PMR","Seniors","LGTBQIA"],"nl":["Leerkrachten","Familie","PBM","Senioren","LGTBQIA"],"en":["Teachers","Family","PRM","Seniors","LGTBQIA"],"de":["Lehrkr\u00e4fte","Familie","PRM","Senioren","LGTBQIA"],"it":["Insegnanti","Famiglie","PRM","Anziani","LGTBQIA"],"sp":["Profesores","Familias","PRM","Personas de la tercera edad","LGTBQIA"],"pt":[null,null,null,null,null],"cn":[null,null,null,null,null]}},"opening":{"day":"2023-06-10","start":"14:00:00","timestamp":"2023-06-10T14:00:00+02:00","end":"18:00:00","is_only_by_appointment":false},"tags":["kids"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-07-08T03:07:27+02:00","published_at":"2023-05-09T11:26:00+02:00","backoffice_id":276867,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.28114422176725},{"id":557198,"date_start":"2023-05-25","date_end":"2023-07-09","date_next":"2023-07-08","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung","it":"Esposizioni","sp":"Exhibici\u00f3n","pt":null,"cn":null}},"others":{"list":[24,30],"translations":{"fr":["Galeries d'art","Peinture"],"nl":["Galeries","Schilderkunst"],"en":["Art Galleries","Painting"],"de":["Kunstgalerien","Malerei"],"it":["Gallerie d'arte","Pittura"],"sp":["Galer\u00edas de arte","Pintura"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Peintures Bernard Bouin \"du r\u00e9el au myst\u00e8re\"","shortdescr":"Le langage pictural de Bernard Bouin s\u2019inscrit dans la lign\u00e9e de peintres aussi \u00e9clectiques que della Francesca, Giotto, Poussin, Balthus et Hopper.\r\nSes peintures sont des instants \u00e9nigmatiques o\u00f9 le temps se fige, exer\u00e7ant sur le spectateur une force d\u2019attraction myst\u00e9rieuse. Elles sont envahies par le silence, les vibrations lumineuses et inspirent la sensation d\u2019un temps suspendu.","longdescr":"Pr\u00e9sentation de l\u2019exposition \u00ab Du r\u00e9el au myst\u00e8re \u00bb de Bernard Bouin \u00e0 la galerie mhaata \u00e0 Bruxelles.\r\nVernissage jeudi 25 mai 2023\r\nExposition du 26 mai au 7 juillet 2023\r\nPour cette premi\u00e8re exposition \u00e0 Bruxelles, le galeriste Jacques Antoine Tanner a choisi d'exposer des oeuvres (diptyques ou autres formats) de la p\u00e9riode 1990 \u00e0 2000 au cours de laquelle Bernard Bouin s\u2019inspirait des primitifs italiens, en particulier de Piero Della Francesca.\r\nDes \u0153uvres plus r\u00e9centes, natures mortes et paysages nocturnes, ainsi que des repr\u00e9sentations graphiques de rochers et des falaises d\u2019Etretat r\u00e9alis\u00e9es en technique mixte dans les ann\u00e9es 2015 \u00e0 2018 compl\u00e8tent l\u2019accrochage; vingt quatre \u0153uvres de l\u2019artiste sont expos\u00e9es, illustrant le parcours du peintre de 1990 \u00e0 nos jours.\r\nLa carri\u00e8re professionnelle de Bernard Bouin (n\u00e9 en 1945) a commenc\u00e9 en 1990 \u00e0 la Galerie Visconti 37, rue de Seine \u00e0 Paris. Depuis, il a fait l\u2019objet de nombreuses expositions en France et \u00e0 l\u2019\u00e9tranger dans plusieurs galeries, lieux institutionnels et mus\u00e9es.\r\nEn Belgique notamment en 2005, Michel de Reymaeker, alors conservateur en chef des Mus\u00e9es communaux de Mons avait pr\u00e9sent\u00e9 \u00e0 la Salle Saint Georges un ensemble important de son travail lors d'une exposition intitul\u00e9e \u00ab Le temps suspendu \u00bb.\r\n\u00ab Si Bernard Bouin est figuratif, c\u2019est d\u2019abord que la figure, bien plus que l\u2019image, l\u2019interpelle. S\u2019il est figuratif, c\u2019est qu\u2019il est d\u2019abord peintre. Ce qui pousse Bernard Bouin \u00e0 peindre, c'est donc la peinture elle-m\u00eame et ses possibilit\u00e9s d'existence. Bernard Bouin cherche \u00e0 concilier et \u00e0 exprimer en un seul mouvement, en une \u0153uvre unique, le monde visible et le monde spirituel, le concret et le mental...Au fur et \u00e0 mesure de son parcours, Bernard Bouin cherche \u00e0 d\u00e9finir, avec une pr\u00e9cision quasi-scientifique, les param\u00e8tres d\u2019une repr\u00e9sentation qui convienne \u00e0 sa qu\u00eate de sens certes, mais qui soit aussi, et surtout, toujours en phase avec l\u2019\u00e9volution de son questionnement inquiet sur la pertinence, aujourd\u2019hui, d\u2019une peinture figurative de type classique : des reproductions de Piero Della Francesca, de Nicolas Poussin et de Chardin habillent les murs de son atelier.... \u00bb.\r\nMichel De Reymaeker - Ancien conservateur en chef des Mus\u00e9es communaux de Mons.\r\nEn D\u00e9cembre 2019, les Editions El Viso Paris-Madrid ont publi\u00e9 une importante monographie \u00ab Bernard Bouin peintures du r\u00e9el au myst\u00e8re \u00bb qui rend compte de toute l\u2019\u00e9tendue de son travail. Cet ouvrage r\u00e9trospectif permet de d\u00e9couvrir un artiste rare \u00e0 travers plus de 200 toiles, \u00e9clair\u00e9es par les textes de l\u2019historienne de l\u2019art Lydia Harambourg.\r\n\u00ab Bernard Bouin porte \u00e0 son comble le message de la peinture, qui ne doit rien qu\u2019\u00e0 elle-m\u00eame. N\u00e9e de sa propre lumi\u00e8re, de sa force suggestive, de ses coloris tout aussi translucides, son \u0153uvre est p\u00e9n\u00e9tr\u00e9e de silence et d\u2019immobilit\u00e9 dans une \u00e9poque si agit\u00e9e et si bruyante. Sa peinture est en qu\u00eate d\u2019elle-m\u00eame, accord\u00e9e aux lois de l\u2019harmonie qui ordonnent l\u2019univers \u00bb.\r\nLydia Harambourg \u2013 historienne et critique d\u2019art \u00e0 Paris.","performers":"Bernard Bouin","boxoffice_url":null,"website":"http:\/\/mhaata.com","email":"contact@mhaata.com","phone_contact":"+32 2 833 98 88","phone_booking":"+32 2 833 98 88","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.557198"},"nl":{"name":"Peintures Bernard Bouin \"du r\u00e9el au myst\u00e8re\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/mhaata.com","email":"contact@mhaata.com","phone_contact":"+32 2 833 98 88","phone_booking":"+32 2 833 98 88","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.557198"},"en":{"name":"Peintures Bernard Bouin \"du r\u00e9el au myst\u00e8re\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/mhaata.com","email":"contact@mhaata.com","phone_contact":"+32 2 833 98 88","phone_booking":"+32 2 833 98 88","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.557198"},"de":{"name":"Peintures Bernard Bouin \"du r\u00e9el au myst\u00e8re\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/mhaata.com","email":"contact@mhaata.com","phone_contact":"+32 2 833 98 88","phone_booking":"+32 2 833 98 88","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.557198"},"it":{"name":"Peintures Bernard Bouin \"du r\u00e9el au myst\u00e8re\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/mhaata.com"