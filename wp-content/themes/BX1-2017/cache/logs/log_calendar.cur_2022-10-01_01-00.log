ac"},"nl":{"title":"CALCUTTA: Bengali Palaces & Vestiges of Her Majesty\u2019s Empire, Photographs by Fabien de Cugnac & Fran\u00e7ois Loze","copyright":"Barakpur Trunk Road, after Circular Canal, Chitpur. \u00a9 Bruxelles, Fabien de Cugnac"},"en":{"title":"CALCUTTA: Bengali Palaces & Vestiges of Her Majesty\u2019s Empire, Photographs by Fabien de Cugnac & Fran\u00e7ois Loze","copyright":"Barakpur Trunk Road, after Circular Canal, Chitpur. \u00a9 Bruxelles, Fabien de Cugnac"}}},{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/efaaba994745a69a61580a4cc4ba45eb39469f0f.jpg","width":750,"height":592,"ratio":1.27,"translations":{"fr":{"title":"CALCUTTA: Bengali Palaces & Vestiges of Her Majesty\u2019s Empire, Photographs by Fabien de Cugnac & Fran\u00e7ois Loze","copyright":"Halder House, Gurupada Halder Road, Kalighat. \u00a9 Bruxelles, Fran\u00e7ois Loze"},"nl":{"title":"CALCUTTA: Bengali Palaces & Vestiges of Her Majesty\u2019s Empire, Photographs by Fabien de Cugnac & Fran\u00e7ois Loze","copyright":"Halder House, Gurupada Halder Road, Kalighat. \u00a9 Bruxelles, Fran\u00e7ois Loze"},"en":{"title":"CALCUTTA: Bengali Palaces & Vestiges of Her Majesty\u2019s Empire, Photographs by Fabien de Cugnac & Fran\u00e7ois Loze","copyright":"Halder House, Gurupada Halder Road, Kalighat. \u00a9 Bruxelles, Fran\u00e7ois Loze"}}},{"type":"poster","link":"https:\/\/agendabrussels.imgix.net\/c1b5007c749e439664d1093f760c677b0f76fd65.jpg","width":1614,"height":2543,"ratio":0.63,"translations":{"fr":{"title":"CALCUTTA: Bengali Palaces & Vestiges of Her Majesty\u2019s Empire, Photographs by Fabien de Cugnac & Fran\u00e7ois Loze","copyright":null},"nl":{"title":"CALCUTTA: Bengali Palaces & Vestiges of Her Majesty\u2019s Empire, Photographs by Fabien de Cugnac & Fran\u00e7ois Loze","copyright":null},"en":{"title":"CALCUTTA: Bengali Palaces & Vestiges of Her Majesty\u2019s Empire, Photographs by Fabien de Cugnac & Fran\u00e7ois Loze","copyright":null}}}],"dates":[{"day":"2022-09-