nn\u00e9, 35,5 x 28 cm ","copyright":"Courtesy de l\u2019artist et de la galerie Ir\u00e8ne Laub "},"fr":{"title":"Pedro A.H Paix\u00e3o, Alfredo, 2021, Crayon de couleur sur papier cartonn\u00e9, 35,5 x 28 cm ","copyright":"Courtesy de l\u2019artist et de la galerie Ir\u00e8ne Laub "},"sp":{"title":"Pedro A.H Paix\u00e3o, Alfredo, 2021, Crayon de couleur sur papier cartonn\u00e9, 35,5 x 28 cm ","copyright":"Courtesy de l\u2019artist et de la galerie Ir\u00e8ne Laub "},"nl":{"title":"Pedro A.H Paix\u00e3o, Alfredo, 2021, Crayon de couleur sur papier cartonn\u00e9, 35,5 x 28 cm ","copyright":"Courtesy de l\u2019artist et de la galerie Ir\u00e8ne Laub "}}}],"dates":[{"day":"2023-10-27","doors":null,"start":"11:00:00","end":"18:00:00","is_soldout":false,"is_canceled":false},{"day":"2023-10-28","doors":null,"start":"11:00:00","end":"18:00:00","is_soldout":false,"is_canceled":false},{"day":"2023-10-31","doors":null,"start":"11:00:00","end":"18:00:00","is_soldout":false,"is_canceled":false},{"day":"2023-11-01","doors":null,"start":"11:00:00","end":"18:00:00","is_soldout":false,"is_canceled":false},{"day":"2023-11-02","doors":null,"start":"11:00:00","end":"18:00:00","is_soldout":false,"is_canceled":false},{"day":"2023-11-03","doors":null,"start":"11:00:00","end":"18:00:00","is_soldout":false,"is_canceled":false},{"day":"2023-11-04","doors":null,"start":"11:00:00","end":"18:00:00","is_soldout":false,"is_canceled":false},{"day":"2023-11-07","doors":null,"start":"11:00:00","end":"18:00:00","is_soldout":false,"is_canceled":false},{"day":"2023-11-08","doors":null,"start":"11:00:00","end":"18:00:00","is_soldout":false,"is_canceled":false},{"day":"2023-11-09","doors":null,"start":"11:00:00","end":"18:00:00","is_soldout":false,"is_canceled":false},{"day":"2023-11-10","doors":null,"start":"11:00:00","end":"18:00:00","is_soldout":false,"is_canceled":false},{"day":"2023-11-11","doors":null,"start":"11:00:00","end":"18:00:00","is_soldout":false,"is_canceled":false},{"day":"2023-11-14"