gement. Son jardin, \u00e0 l\u2019ombre du parlement europ\u00e9en, est aujourd\u2019hui accessible au public, avec son tr\u00e8s beau kiosque. Cette promenade part \u00e0 la d\u00e9couverte des rues Vautier et Wiertz qui poss\u00e8dent un patrimoine architectural tout-\u00e0-fait original et pittoresque : un petit village miraculeusement pr\u00e9serv\u00e9 au milieu de la ville o\u00f9 une communaut\u00e9 d\u2019artistes a r\u00e9cemment \u00e9lu domicile.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.arau.org","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.559185"},"nl":{"name":"Un village d'artistes \u00e0 Ixelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.arau.org","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.559185"},"en":{"name":"Un village d'artistes \u00e0 Ixelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.arau.org","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.559185"},"de":{"name":"Un village d'artistes \u00e0 Ixelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.arau.org","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.559185"},"it":{"name":"Un village d'artistes \u00e0 Ixelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.arau.org","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.559185"},"sp":{"name":"Un village d'artistes \u00e0 Ixelles","shortdescr":null,"lon