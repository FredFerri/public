state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":true,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":266394,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"tour","ranking":0.13929411186473264,"languages":{"spoken":["en","fr","nl"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{}},"translations":{"de":{"name":"Higlights en minder betreden paden van Brussel met de fiets","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/cactus.brussels\/tours-velo-publiques","email":"info@cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.546394"},"pt":{"name":"Higlights en minder betreden paden van Brussel met de fiets","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/cactus.brussels\/tours-velo-publiques","email":"info@cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.546394"},"en":{"name":"Guided bike tour Brussels: Highlights and Hidden Gems","shortdescr":"Explore Brussels on a bike tour with our local guides. Discover iconic places and hidden gems and immerse yourself in the history and culture of the city. Available in English, French or Dutch. Book your places on our website!","longdescr":"Cycle along on an unforgettable 3h30 discovery of the City of Brussels and its surrounding municipalities. Our local guides reveal iconic highlights as well as hidden gems along less beaten tracks. The tour offers you a perfect introduction to Brussels and its various neighbourhoods! Plunge into the city's rich history and culture and discover more than you expect during this fun and enriching experience by bike. Along the way, we take a break in a cozy bar. Ideal for a taste of the local atmosphere and getting to know fellow travelers. Choose from our quality city bikes or e-bikes for a comfortable ride. \nBook your spot now for a unique experience of Brussels by bike!\n- Tours are available in English, French or Dutch\n- Every Saturday and other days. Find all availabilities on our website\n- Find us in the heart of the city at Grand Hospice\nInfo and reservations on our website: https:\/\/cactus.brussels\/public-bike-tours","performers":null,"boxoffice_url":null,"website":"https:\/\/cactus.brussels\/public-bike-tours","email":"info@cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.546394"},"it":{"name":"Higlights en minder betreden paden van Brussel met de fiets","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/cactus.brussels\/tours-velo-publiques","email":"info@cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.546394"},"cn":{"name":"Higlights en minder betreden paden van Brussel met de fiets","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/cactus.brussels\/tours-velo-publiques","email":"info@cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.546394"},"fr":{"name":"Visite guid\u00e9e \u00e0 v\u00e9lo de Bruxelles: les incontournables et insolites","shortdescr":"Explorez Bruxelles lors d'une balade \u00e0 v\u00e9lo avec nos guides locaux. D\u00e9couvrez les lieux embl\u00e9matiques et insolites et plongez dans l'histoire et la culture de la ville. Les tours sont disponibles en anglais, fran\u00e7ais ou n\u00e9erlandais. R\u00e9servez votre place via notre site web!","longdescr":"D\u00e9couvrez la ville de Bruxelles et ses communes environnantes au cours d'une balade \u00e0 v\u00e9lo inoubliable de 3h30. Nos guides locaux vous d\u00e9voileront les lieux embl\u00e9matiques ainsi que les endroits insolites hors des sentiers battus. Cette visite est une parfaite introduction \u00e0 Bruxelles et \u00e0 ses diff\u00e9rents quartiers ! Plongez dans la riche histoire et la culture de la ville et d\u00e9couvrez plus que vous ne l'imaginez pendant cette exp\u00e9rience amusante et enrichissante \u00e0 v\u00e9lo. En cours de route, nous ferons une pause dans un caf\u00e9 sympa. Id\u00e9al pour go\u00fbter \u00e0 l'ambiance locale et faire connaissance avec les autres voyageurs. Choisissez parmi nos v\u00e9los de ville de qualit\u00e9 ou nos v\u00e9los \u00e9lectriques pour une balade confortable. \nR\u00e9servez votre place d\u00e8s maintenant pour une exp\u00e9rience unique de Bruxelles \u00e0 v\u00e9lo !\n- Les tours sont disponible en anglais, fran\u00e7ais ou n\u00e9erlandais\n- Tous les samedis et autres jours. Retrouvez toutes les disponibilit\u00e9s dans notre calendrier de r\u00e9servation en ligne sur notre site web\n- Retrouvez-nous dans le centre-ville au Grand Hospice\nPlus d'information et r\u00e9servation: https:\/\/cactus.brussels\/tours-velo-publiques ","performers":null,"boxoffice_url":null,"website":"https:\/\/cactus.brussels\/tours-velo-publiques","email":"info@cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.546394"},"sp":{"name":"Higlights en minder betreden paden van Brussel met de fiets","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/cactus.brussels\/tours-velo-publiques","email":"info@cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.546394"},"nl":{"name":"Gegidste fietstocht Brussel: highlights en minder betreden paden","shortdescr":"Ontdek Brussel tijdens een fietstocht met een lokale gids. Fiets langs iconische plekken en de verborgen parels van Brussel en duik in de geschiedenis en cultuur van de stad. De tours zijn beschikbaar in Engels, Frans of Nederlands. Boek op onze website voor een uniek fietsavontuur in Brussel!","longdescr":"Fiets mee op een onvergetelijke ontdekking van 3u30 door de Stad-Brussel en de omliggende gemeenten. Onze lokale gidsen onthullen zowel iconische highlights als verborgen plekjes langs de minder betreden paden. De tour biedt je een perfecte introductie tot Brussel en haar verschillende wijken! Duik in de rijke geschiedenis en cultuur van de stad en ontdek meer dan je verwacht tijdens deze leuke en verrijkende ervaring met de fiets. Onderweg nemen we een pauze in een gezellige bar. Ideaal om te proeven van de lokale sfeer en kennis te maken met medereizigers. Kies uit onze kwaliteitsvolle stadsfietsen of e-bikes voor een comfortabele rit.\nBoek nu je plek voor een unieke fietservaring van Brussel!\n- Beschikbaar in het Engels, Frans of Nederlands\n- Start en einde in het hart van de stad, Grand Hospice.\n- Elke zaterdag en andere dagen. Vind alle beschikbaarheden op op onze website.\nInfo en reservaties op onze website: https:\/\/cactus.brussels\/brussel-met-de-fiets","performers":null,"boxoffice_url":null,"website":"https:\/\/cactus.brussels\/brussel-met-de-fiets","email":"info@cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.546394"}},"place":{"id":277608,"translations":{"de":{"name":"Cactus Brussel \u00e0 v\u00e9lo","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"info@cactus.brussels","website":"ht