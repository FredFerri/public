heids-, sport- en intellectuele spelen\r\n\r\n- 7 dagen per week geopend, flexibele uren, concurrerende prijzen, dicht bij openbaar vervoer en gratis parkeren.\r\n\r\nJe zult vertrekken met je hoofd in de sterren.","performers":"De Team van Space Fun Games","boxoffice_url":null,"website":null,"email":"info@spacefungames.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/535886.html"},"en":{"name":"Laser Games and Escape Games - Group games 150% Fun","shortdescr":"An ideal place to have fun with family, friends and colleagues.\r\nFor a birthday party, a company party, Team Building and EVG & EVJF.","longdescr":"- Space Fun Games = Space Laser Games + Space Team Games\r\n\r\n- 1000m2 of indoor team games guaranteed 150% Fun and accessible to all from 7 years old \r\n\r\n- The biggest laser games in Brussels with a spatial decor & 11 mini escape games with agility, sports and intellectual games\r\n\r\n- Open 7 days a week, flexible hours, competitive prices, close to public transport and free parking.\r\n\r\nYou will leave with your head in the stars.","performers":"The Team of Space Fun Games","boxoffice_url":null,"website":null,"email":"info@spacefungames.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/535886.html"},"de":{"name":"Laser Games et Escape Games","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/535886.html"},"it":{"name":"Laser Games et Escape Games","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/535886.html"},"sp":{"name":"Laser Games et Escape Games","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":