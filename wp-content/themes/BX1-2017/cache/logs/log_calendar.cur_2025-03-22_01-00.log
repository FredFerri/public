ou_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2025-03-17T01:00:20+01:00","published_at":"2025-01-31T10:12:31+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":317261,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"tour","ranking":0.6057068642773799,"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{"list":[253],"translations":{"de":["F\u00fchrungen durch Innenr\u00e4ume"],"pt":[null],"en":["Interior guided tours"],"it":["Visite guidate all\u2019interno"],"cn":[null],"fr":["Visites guid\u00e9es d\u2019int\u00e9rieurs"],"sp":["Visitas guiadas en espacios interiores"],"nl":["Interieur rondleidingen"]}}},"translations":{"de":{"name":"BANAD Festival - Guided tour of the Solvay Mansion","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700006044"},"pt":{"name":"BANAD Festival - Guided tour of the Solvay Mansion","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700006044"},"en":{"name":"BANAD Festival - Solvay Mansion","shortdescr":null,"longdescr":"In 1894, the Art Nouveau enthusiast and millionaire industrialist Armand Solvay commissioned Victor Horta to build him a huge mansion on the fashionable Avenue Louise. Having developed a friendship with Horta and a close understanding of his requirements and preferences, he gave the architect carte blanche and an unlimited budget. Horta did not disappoint his friend and channelled his design genius into what is considered by many to be his masterpiece. The fa\u00e7ade features two symmetrical, two-storey bay windows, topped with balconies. Inside, Horta used expensive materials to decorate an airy interior that could be adapted for entertaining and family life. Horta used 23 different types of marble and 17 varieties of wood in a decorative scheme dominated by red and orange tones that reinforced the luxurious atmosphere. The interior has been remarkably well-preserved and maintained and the building is a UNESCO World Heritage Site. \n\n25 euros per person additionally\n\nChildren under 12 years of age are not allowed.\n\nArch. Victor HORTA, 1894 - 1903\n\n","performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/en\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700006044"},"it":{"name":"BANAD Festival - Guided tour of the Solvay Mansion","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700006044"},"cn":{"name":"BANAD Festival - Guided tour of the Solvay Mansion","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700006044"},"fr":{"name":"BANAD Festival - H\u00f4tel Solvay","shortdescr":null,"longdescr":"En 1894, Armand Solvay tr\u00e8s enthousiasm\u00e9 par l'Art nouveau confie la construction de son h\u00f4tel de ma\u00eetre sur la prestigieuse avenue Louise \u00e0 Victor Horta. L'architecte aura carte blanche et un budget illimit\u00e9 pour \u00e9riger l'h\u00f4tel Solvay. B\u00e9n\u00e9ficiant d'une entente parfaite avec le commanditaire, Horta y d\u00e9ploiera tout son art pour faire de cette maison une de ces r\u00e9alisations les plus grandioses. En fa\u00e7ade, deux bow-windows sym\u00e9triques s'\u00e9l\u00e8vent sur deux \u00e9tages et sont surmont\u00e9s de balcons. Une fois pass\u00e9e la porte, Horta utilise des mat\u00e9riaux pr\u00e9cieux pour d\u00e9velopper un int\u00e9rieur d\u00e9cloisonn\u00e9 \u00e0 la fois fonctionnel et adapt\u00e9 aux usages de l'\u00e9poque. Il m\u00e9lange ainsi 23 marbres et 17 essences de bois qui se d\u00e9clinent dans des gammes de couleurs rouges-oranges, renfor\u00e7ant ainsi cette atmosph\u00e8re de luxe. Incroyablement bien conserv\u00e9, l'h\u00f4tel Solvay est inscrit sur la liste du patrimoine mondial de l'UNESCO.\n\nSuppl\u00e9ment de 25 euros par personne \u00e0 payer pour pouvoir visiter ce lieu \n\nEnfant de moins de 12 ans non admis\n\nArch. Victor HORTA, 1894 - 1903","performers":"\n","boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700006044"},"sp":{"name":"BANAD Festival - Guided tour of the Solvay Mansion","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700006044"},"nl":{"name":"BANAD Festival - Solvay Herenhuis","shortdescr":null,"longdescr":"In 1894 vertrouwde Armand Solvay, een vurige bewonderaar van de art nouveau, de bouw van zijn herenhuis op de prestigieuze Louizalaan toe aan Victor Horta. De architect kreeg carte blanche en een onbeperkt budget om herenhuis Solvay uit de grond te stampen. Horta, die het prima kon vinden met de opdrachtgever, haalde al zijn talent uit de kast om van dit huis een van zijn meest grandioze pronkstukken te maken. Op de gevel rekken twee erkerramen, bekroond met balkons, zich uit over twee verdiepingen. Achter de voordeur gebruikt Horta edele materialen voor een open interieur dat functioneel is maar ook de gebruiken van die tijd volgt. Zo vermengt hij 23 soorten marmer en 17 verschillende houtsoorten in rode en oranje tinten, waarmee hij deze luxueuze sfeer nog extra versterkt. Dit verbluffend goed bewaard gebleven herenhuis prijkt op de werelderfgoedlijst van UNESCO. \n\nToeslag van 25 euro per persoon \n\nKinderen onder 12 jaar niet toegestaan\n\nArch. Victor HORTA, 1894 - 1903\n\n","performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/nl\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700006044"}},"place":{"id":261979,"translations":{"de":{"name":"H\u00f4tel Solvay","address_street_name":"Avenue Louise","address_street_number":"224","address_street_box":null,"email":"info@hotelsolvay.be","website":"http:\/\/www.hotelsolvay.be","phone_contact":"+32 2 640 56 45","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Louise, 224","address_line2":"1050 Ixelles","description_web":"Architekt: Victor Horta - 1895\/1898\r\nDieses luxuri\u00f6se Anwesen wurde 1894 von Victor Horta f\u00fcr den Sohn des Unternehmers Ernest Solvay erbaut. Dem Architekten wurde vollkommen freie Hand gelassen und bei der bis ins kleinste Detail durchdachten Innenausstattung und dem Mobiliar \u00fcberlie\u00df er nichts dem Zufall. Die Fassade wird von zwei symmetrischen Erkern geziert, die sich \u00fcber zwei Etagen erstrecken. Dar\u00fcber befinden sich zwei Balkone. Im Interieur erwartet den Besucher ein optisches Feuerwerk. Die Farbpalette zwischen Rot- und Oranget\u00f6nen verst\u00e4rkt noch den Eindruck von Luxus und Komfort. Ein Besuch lohnt sich! ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"H\u00f4tel Solvay","address_street_name":"Avenue Louise","address_street_number":"224","address_street_box":null,"email":"info@hotelsolvay.be","website":"http:\/\/www.hotelsolvay.be","phone_contact":"+32 2 640 56 45","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Louise, 224","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Solvay House","address_street_name":"Louizalaan","address_street_number":"224","address_street_box":null,"email":"info@hotelsolvay.be","website":"http:\/\/www.hotelsolvay.be","phone_contact":"+32 2 640 56 45","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Louizalaan, 224","address_line2":"1050 Ixelles","description_web":"Architect: Victor Horta - 1895\/1898 \r\nThis luxury townhouse was built by Victor Horta in 1894 for the son of captain of industry Ernest Solvay. The architect was given \u201ccarte blanche\u201d and designed the interior and the furniture down to the smallest detail. On the fa\u00e7ade, two symmetric bow windows surmounted by balconies are seen to protrude across two floors. Indoors it is a visual extravaganza, with the sheer range of red-orange hues on offer only acting to underpin the atmosphere of luxury and comfort. A must-see building. \r\n\r\nPlease note : Children under 12 years of age are not admitted to the guided tours.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"H\u00f4tel Solvay","address_street_name":"Avenue Louise","address_street_number":"224","address_street_box":null,"email":"info@hotelsolvay.be","website":"http:\/\/www.hotelsolvay.be","phone_contact":"+32 2 640 56 45","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Louise, 224","address_line2":"1050 Ixelles","description_web":"Architetto Victor Horta \u2013 1895 \/ 1898 \r\nQuesta lussuosa villa \u00e9 stata costruita da Victor Horta nel 1894 per il figlio dell\u2019industriale Ernest Solvay. L\u2019architetto ha ricevuto totale libert\u00e0 e ha concepito l\u2019interno e i mobili nei minimi dettagli. Sulla facciata, due \u201cbow-window\u201d simetriche si elevano su due piani e sono superate da balconi. Al interno, \u00e9 un fuoco d'artificio visivo. La gamma dei toni rossi \u2013 arrancione rinforza l\u2019atmosfera di lusso e di conforto. Da vedere assolutamente. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"H\u00f4tel Solvay","address_street_name":"Avenue Louise","address_street_number":"224","address_street_box":null,"email":"info@hotelsolvay.be","website":"http:\/\/www.hotelsolvay.be","phone_contact":"+32 2 640 56 45","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Louise, 224","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"H\u00f4tel Solvay","address_street_name":"Avenue Louise","address_street_number":"224","address_street_box":null,"email":"info@hotelsolvay.be","website":"http:\/\/www.hotelsolvay.be","phone_contact":"+32 2 640 56 45","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Louise, 224","address_line2":"1050 Ixelles","description_web":"Architecte: Victor Horta - 1895\/1898\nCette demeure luxueuse fut construite par Victor Horta en 1894 pour le fils de l\u2019industriel Ernest Solvay. L\u2019architecte re\u00e7ut \u201ccarte blanche\u201d et con\u00e7ut l\u2019int\u00e9rieur et le mobilier jusque dans les moindres d\u00e9tails. Sur la fa\u00e7ade, deux bow-windows sym\u00e9triques s\u2019\u00e9l\u00e8vent sur deux \u00e9tages et sont surmont\u00e9s de balcons. A l\u2019int\u00e9rieur, c\u2019est un feu d\u2019artifices visuel. La gamme des tons rouge-orange renforce l\u2019atmosph\u00e8re de luxe et de confort. A voir absolument.\n\nAchat des tickets uniquement en ligne.\n\nVisite guid\u00e9e sur demande \u00e0 l'adresse  info@hotelsolvay.be\n\nAttention : Les enfants de moins de 12 ans ne sont pas admis aux visites guid\u00e9es.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"H\u00f4tel Solvay","address_street_name":"Avenue Louise","address_street_number":"224","address_street_box":null,"email":"info@hotelsolvay.be","website":"http:\/\/www.hotelsolvay.be","phone_contact":"+32 2 640 56 45","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Louise, 224","address_line2":"1050 Ixelles","description_web":"Arquitecto: Victor Horta - 1895\/1898\r\nEsta lujosa mansi\u00f3n fue construida por Victor Horta en 1894 para el hijo del empresario Ernest Solvay. El arquitecto recibi\u00f3 carta blanca y concibi\u00f3 el interior y el mobiliario hasta el \u00faltimo detalle. En la fachada, dos miradores sim\u00e9tricos se elevan sobre los dos pisos y los balcones. El interior es una maravilla visual. La gama de los tonos rojo-naranja refuerza la atm\u00f3sfera de lujo y de confort. Una visita imprescindible.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Solvay Herenhuis","address_street_name":"Louizalaan","address_street_number":"224","address_street_box":null,"email":"info@hotelsolvay.be","website":"http:\/\/www.hotelsolvay.be","phone_contact":"+32 2 640 56 45","phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"Louizalaan, 224","address_line2":"1050 Elsene","description_web":"Architect: Victor Horta - 1895\/1898\r\nVictor Horta bouwde dit luxueuze herenhuis in 1894 voor de zoon van de industrieel Ernest Solvay. De architect kreeg carte blanche voor dit project. Hij ontwierp het interieur en het meubilair tot in de kleinste details. Op de gevel lopen twee symmetrische erkers over twee verdiepingen, met daarboven balkons. Binnen wacht een visueel vuurwerk. Het palet van rood- en oranjetinten zet de sfeer van luxe en comfort nog sterker in de verf. Een bezoek meer dan waard.\r\n\r\nBelangrijke opmerking : Kinderen jonger dan 12 jaar mogen niet deelnemen aan rondleidingen.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[6,5],"translations":{"de":["Chatelain\/Bailli","Flagey"],"pt":[null,null],"en":["Chatelain\/Bailli","Flagey"],"it":["Chatelain\/Bailli","Flagey"],"cn":[null,null],"fr":["Chatelain\/Bailli","Flagey"],"sp":["Ch\u00e2telain\/Bailli","Flagey"],"nl":["Kasteleinswijk\/Baljuw","Flagey"]}},"zones":{"list":[21],"translations":{"de":["S\u00fcden"],"pt":[null],"en":["South"],"it":["Sud"],"cn":[null],"fr":["Sud"],"sp":["Sur"],"nl":["Zuid"]}},"neca":null,"facebook_id":null,"backoffice_id":21979,"location":{"lat":50.8263727,"lon":4.3654832},"region":"brussels","last_updated_at":"2025-01-30T15:59:01+01:00","published_at":"2015-06-26T11:03:12+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":267246,"translations":{"de":{"name":"Explore.brussels ","address_street_name":"Avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"https:\/\/www.explore.brussels\/fr","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Avenue Brugmann, 405","address_line2":"1180 Uccle","description_web":"Explore.Brussels ist ein Zusammenschluss von Vereinen, die qualitativ hochwertige Stadtf\u00fchrungen in der Region Br\u00fcssel-Hauptstadt organisieren.\r\nDie Mitgliedsvereine sind ARAU, Pro Velo, Brussels Chatterguides und Arkadia. Im Jahr 2020 hat sich La Fonderie als Partnerverein angeschlossen.\r\nEntdecken Sie das UNESCO-Weltkulturerbe, Jugendstilarchitektur, die Bauwerke von Victoria Horta, Gem\u00e4lde von Magritte, Comic-Kunst von Herg\u00e9, Streetart, Europa, Bier, Schokolade oder besichtigen Sie architektonische Perlen des Jugendstils, des Art-d\u00e9co oder des Neoklassizismus, die normalerweise nicht f\u00fcr die \u00d6ffentlichkeit zug\u00e4nglich sind. Die F\u00fchrungen werden sowohl f\u00fcr Einzelbesucher als auch f\u00fcr Gruppen angeboten und reichen von klassischen \u00fcber originelle bis hin zu vollkommen neuen Konzepten und Formaten. Neben Stadtf\u00fchrungen zu Fu\u00df sind auch Besichtigungen per Fahrrad, Bus oder Boot m\u00f6glich.\r\nExplore.Brussels organisiert unter anderem auch das Jugendstil- und Art-d\u00e9co-Festival BANAD, die Brussels Biennale - Neoclassic (BBN) sowie weitere Projekte, darunter die Ausbildung von Stadtf\u00fchrern, der \u201eVerein der Freunde\u201c und der \u201eVerein der Eigent\u00fcmer\u201c. \r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Explore.brussels ","address_street_name":"Avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"https:\/\/www.explore.brussels\/fr","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Avenue Brugmann, 405","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Explore.brussels ","address_street_name":"Avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"https:\/\/www.explore.brussels\/fr","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Avenue Brugmann, 405","address_line2":"1180 Uccle","description_web":"Explore.Brussels is a network of guided tour associations in Brussels. This organisation includes ARAU, Arkadia, Bruxelles Bavard, Pro Velo, La Fonderie and Korei. Events are organised in co-production with these 6 companies. Individual or group tours are available on foot, by bike, by bus and by boat.  Visitors discover UNESCO heritage, Magritte, art deco, chocolate and much more. Explore.Brussels also organises Brussels festivals and other large-scale projects.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Explore.brussels ","address_street_name":"Avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"https:\/\/www.explore.brussels\/fr","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Avenue Brugmann, 405","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Explore.brussels ","address_street_name":"Avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"https:\/\/www.explore.brussels\/fr","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Avenue Brugmann, 405","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Explore.brussels ","address_street_name":"Avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"https:\/\/www.explore.brussels\/fr","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Avenue Brugmann, 405","address_line2":"1180 Uccle","description_web":"Explore.Brussels est un r\u00e9seau d'associations de visites guid\u00e9es \u00e0 Bruxelles. Cet organisme regroupe notamment ARAU, Arkadia, Bruxelles Bavard, Pro Velo, La Fonderie et Korei. les \u00e9v\u00e9nements sont organis\u00e9s en coproduction avec ces 6 entreprises  Les visites individuelles ou en groupe sont disponibles \u00e0 pied, \u00e0 v\u00e9lo, en car et en bateau.  Les visiteurs partent \u00e0 la d\u00e9couverte du patrimoine de l'UNESCO, de Magritte, de l'art d\u00e9co, du chocolat et bien plus encore. Explore.Brussels organise \u00e9galement des festivals bruxellois et d'autres projets de grande envergure.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Explore.brussels ","address_street_name":"Avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"https:\/\/www.explore.brussels\/fr","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Avenue Brugmann, 405","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Explore.brussels ","address_street_name":"Brugmannlaan","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"https:\/\/www.explore.brussels\/fr","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Ukkel","address_line1":"Brugmannlaan, 405","address_line2":"1180 Ukkel","description_web":"Explore.Brussels is een netwerk van verenigingen voor geleide bezoeken in Brussel. Deze organisatie omvat ARAU, Arkadia, Bruxelles Bavard, Pro Velo, La Fonderie en Korei. De evenementen worden georganiseerd in coproductie met deze 6 bedrijven. Individuele of groepstochten zijn mogelijk te voet, per fiets, per bus en per boot.  Bezoekers ontdekken UNESCO erfgoed, Magritte, art deco, chocolade en nog veel meer. Explore.Brussels organiseert ook Brusselse festivals en andere grootschalige projecten.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":27246,"location":{"lat":50.80795462,"lon":4.34397082},"last_updated_at":"2024-05-29T15:24:29+02:00","published_at":"2017-02-27T10:05:49+01:00","is_in_address_book":false,"is_in_vb_export":false,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/131962ae770d56f2f593009dfb3995ac4bed79c0.jpg","width":1499,"height":1000,"ratio":1.5,"oEmbed_height":1000,"oEmbed_width":1499,"translations":{"de":{"title":"BANAD Festival - H\u00f4tel Solvay","copyright":"\u00a9EB- Sophie Voituron"},"pt":{"title":"BANAD Festival - H\u00f4tel Solvay","copyright":"\u00a9EB- Sophie Voituron"},"en":{"title":"BANAD Festival - H\u00f4tel Solvay","copyright":"\u00a9EB- Sophie Voituron"},"it":{"title":"BANAD Festival - H\u00f4tel Solvay","copyright":"\u00a9EB- Sophie Voituron"},"cn":{"title":"BANAD Festival - H\u00f4tel Solvay","copyright":"\u00a9EB- Sophie Voituron"},"fr":{"title":"BANAD Festival - H\u00f4tel Solvay","copyright":"\u00a9EB- Sophie Voituron"},"sp":{"title":"BANAD Festival - H\u00f4tel Solvay","copyright":"\u00a9EB- Sophie Voituron"},"nl":{"title":"BANAD Festival - H\u00f4tel Solvay","copyright":"\u00a9EB- Sophie Voituron"}}}],"dates":[{"day":"2025-03-15","doors":"10:00:00","start":"10:00:00","end":"16:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2025-03-16","d