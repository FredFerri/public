els","last_updated_at":"2022-07-26T04:05:30+02:00","published_at":"2021-07-23T14:48:31+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/explore-a5c2b00041e4da645e6cc9f258c941d245a090b3.jpg","width":785,"height":350,"ratio":2.24,"translations":{"fr":{"title":"PARK TOUR : Visite gratuite du Parc du Cinquantenaire","copyright":null},"nl":{"title":"PARK TOUR : Visite gratuite du Parc du Cinquantenaire","copyright":null},"en":{"title":"PARK TOUR : Visite gratuite du Parc du Cinquantenaire","copyright":null}}}],"dates":[{"day":"2022-08-28","doors":null,"start":"11:00:00","end":"12:00:00","is_soldout":false,"is_canceled":false},{"day":"2022-09-04","doors":null,"start":"11:00:00","end":"12:00:00","is_soldout":false,"is_canceled":false},{"day":"2022-09-11","doors":null,"start":"11:00:00","end":"12:00:00","is_soldout":false,"is_canceled":false},{"day":"2022-09-25","doors":null,"start":"11:00:00","end":"12:00:00","is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":0}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"visit_profile":{"list":[328],"translations":{"fr":["Vert & durable"],"nl":["Groen & duurzaam"],"en":["Green & sustainable"]}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-07-26T04:05:31+02:00","published_at":"2022-06-23T03:30:14+02:00","backoffice_id":256236,"import_origin":"explore","sub_type":"other","show_in_agenda":true,"ranking":0.32548726473767},{"id":536644,"date_start":"2022-07-01","date_end":"2022-08-28","date_next":"2022-08-28","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":118,"translations":{"fr":"Festival","nl":"Festival","en":"Festival"}},"others":{}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Park Po\u00e9tik","shortdescr":"Un \u00e9t\u00e9 artistique po\u00e9tique et participatif \u00e0 St-Gilles et Forest !","longdescr":"Pour trouver Park Po\u00e9tik, vous n'avez pas besoin de chercher ! C'est un festival qui cherche son public dans l'espace public : dans les rues, sur les places, dans les parcs et dans les quartiers de Forest et de Saint-Gilles. Les artistes explorent l'imagination et la cr\u00e9ativit\u00e9 afin de rencontrer les habitants.\r\n\r\nUn \u00e9t\u00e9 plein de merveilles s'offre \u00e0 vous ! Du 1er juillet au 28 ao\u00fbt 2022, nous semerons de la po\u00e9sie au sens le plus large du terme. Tout ce qui peut vous \u00e9mouvoir, qui stimule le dialogue ou cr\u00e9e l'\u00e9merveillement a sa place dans notre programme.\r\n\r\nLa th\u00e9matique 'Dr\u00f4les d'oiseaux & Vreemde Vogels' sera le fil conducteur d'une multitude d'interventions surprenantes lors de cette troisi\u00e8me \u00e9dition.  Plusieurs \"nids\" ou \"Nesten\" verront le jour, dans lesquels des artistes et des perform\u00b7eur\u00b7euse\u00b7s d\u00e9ploient leurs ailes comme de dr\u00f4les d'oiseaux afin de faire \u00e9clore des cr\u00e9ations artistiques. Nous sortons \u00e9galement avec des \"Spirale\" : rencontrer ces parades sera plut\u00f4t une co\u00efncidence, mais vous \u00eates invit\u00e9s \u00e0 participer sur place !","performers":"Park Po\u00e9tik est une collaboration de Team Po\u00e9tik, Gemeente Vorst, Gemeente Sint-Gillis, WIELS, Le BRASS Centre Culturel de Forest, GC Pianofabriek, GC Ten Weyngaert, CC Le Jacques Franck & toustes les Po\u00e9tikizen.n.e.s.","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/536644.html"},"nl":{"name":"Park Po\u00e9tik","shortdescr":"Een po\u00ebtische, participatieve kunstenzomer in Sint-Gillis & Vorst!","longdescr":"Om Park Po\u00e9tik te vinden hoef je niet te zoeken! Het is een festival dat zijn publiek opzoekt in de openbare ruimte: in de straten, op pleinen, in parken en in wijken van Vorst en Sint-Gillis. Kunstenaars verkennen er de verbeelding en de creativiteit om inwoners te ontmoeten.\r\n\r\nEr staat je dus een zomer vol verwondering te wachten! Van 1 juli tot en met 28 augustus 2022 verspreiden we po\u00ebzie in de ruime zin van het woord. Alles wat ontroeren kan, waar dialoog wordt aangewakkerd of verwondering bij komt kijken vindt zijn plekje binnen ons programma.\r\n\r\nHet thema van dit jaar \u2018Dr\u00f4les d\u2019oiseaux & Vreemde Vogels\u2019 brengt een veelheid aan verrassende interventies tijdens deze derde editie. We cre\u00ebren verschillende \u201cNesten\u201d op pleintjes en in parken, waarin kunstenaars en artiesten als vreemde vogels hun vleugels zullen uitslaan om artistieke creaties uit te broeden. We trekken er ook op uit met \"Spirale\": parades die je eerder toevallig zal tegenkomen en waarbij je uitgenodigd wordt om ter plekke deel te nemen!","performers":"Park Po\u00e9tik is een samenwerking tussen Team Po\u00e9tik, Gemeente Vorst, Gemeente Sint-Gillis, WIELS, Le BRASS Centre Culturel de Forest, GC Pianofabriek, GC Ten Weyngaert, CC Le Jacques Franck & alle Po\u00e9tikizen.n.e.s.","boxoffice_url":null,"website":"http:\/\/www.parkpoetik.be","email":"com@parkpoetik.be","phone_contact":"+32 495 48 51 41","phone_booking":"+32 495 48 51 41","agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/536644.html"},"en":{"name":"Park Po\u00e9tik","shortdescr":"A poetic, participatory summer of arts in Sint-Gillis & Vorst!","longdescr":"To find Park Poetik you don't have to look for it! It is a festival that seeks its audience in the public space: in the streets, on squares, in parks and in neighbourhoods of Forest and Saint-Gilles. Artists explore imagination and creativity in order to meet inhabitants.\r\n\r\nA summer full of wonder awaits you! From 1 July to 28 August 2022, we spread poetry in the broadest sense of the word. Everything that can move you, that stimulates dialogue or creates wonder has its place in our programme.\r\n\r\nThis year's theme 'Dr\u00f4les d'oiseaux & Vreemde Vogels' will bring a multitude of surprising interventions during this third edition. We will create several \"nests\" on squares and in parks in which artists and performers will spread their wings like strange birds to hatch artistic creations. We are also moving with \"Spirale\": parades that you are more likely to encounter by chance and in which you are invited to participate on the spot!","performers":"Park Po\u00e9tik is a collaboration of Team Po\u00e9tik, Gemeente Vorst, Gemeente Sint-Gillis, WIELS, Le BRASS Centre Culturel de Forest, GC Pianofabriek, GC Ten Weyngaert, CC Le Jacques Franck & all the Po\u00e9tikizen.n.e.s.","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/536644.html"},"de":{"name":"Park Po\u00e9tik","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/536644.html"},"it":{"name":"Park Po\u00e9tik","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/536644.html"},"sp":{"name":"Park Po\u00e9tik","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/536644.html"},"pt":{"name":"Park Po\u00e9tik","shortdescr":null,"longdescr":null,"performers"