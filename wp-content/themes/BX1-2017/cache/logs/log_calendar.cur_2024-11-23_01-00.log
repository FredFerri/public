ss_city":"Anderlecht","address_line1":"Rue de la Promenade, 13","address_line2":"1070 Anderlecht","description_web":"Le B\u2019Izou est le th\u00e9\u00e2tre de toutes les proximit\u00e9s. (C\u2019est l\u2019occasion de d\u00e9couvrir des artistes, de laisser la t\u00e9l\u00e9 pour sortir, rire, s\u2019\u00e9mouvoir, r\u00e9fl\u00e9chir, revenir). L\u2019ancien atelier de garnissage de fauteuils s\u2019est transform\u00e9 en un espace chaleureux. Jean s\u2019affaire derri\u00e8re la console, Izou \u00e9crit des chansons. Au B\u2019Izou vous \u00eates chez Jean et Izou, autant dire vous \u00eates chez vous.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Au B'izou","address_street_name":"Rue de la Promenade","address_street_number":"13","address_street_box":null,"email":"reservation@aubizou.be","website":"http:\/\/www.aubizou.be\/","phone_contact":"+32 474 10 75 76","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de la Promenade, 13","address_line2":"1070 Anderlecht","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Au B'izou","address_street_name":"Wandelingstraat","address_street_number":"13","address_street_box":null,"email":"reservation@aubizou.be","website":"http:\/\/www.aubizou.be\/","phone_contact":"+32 474 10 75 76","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Wandelingstraat, 13","address_line2":"1070 Anderlecht","description_web":"De B\u2019Izou is een theater van uitersten. Het is een theater waar je, nadat je de stekker uit de televisie hebt getrokken, naartoe gaat om artiesten te ontdekken, om de bloemen buiten te zetten, om te lachen, te huilen en met verstomming te worden geslagen. Dit oude atelier van meubelstoffeerders werd omgetoverd in een warme theaterplek. Jean zit er achter de toetsen, Izou schrijft er de liedjes. Je bent er thuis, ook al ben je eigenlijk op bezoek bij Jean en Izou. Komt dat zien!","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[21],"translations":{"de":["S\u00fcden"],"pt":[null],"en":["South"],"it":["Sud"],"cn":[null],"fr":["Sud"],"sp":["Sur"],"nl":["Zuid"]}},"neca":null,"facebook_id":null,"backoffice_id":9284,"location":{"lat":50.82589161,"lon":4.29772179},"region":"brussels","last_updated_at":"2024-08-19T15:42:08+02:00","published_at":"2013-10-19T01:25:47+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":247078,"translations":{"de":{"name":"Au B'izou","address_street_name":"Rue de la Promenade","address_street_number":"13","address_street_box":null,"email":"reservation@aubizou.be","website":"http:\/\/www.aubizou.be\/","phone_contact":"+32 474 10 75 76","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de la Promenade, 13","address_line2":"1070 Anderlecht","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Au B'izou","address_street_name":"Rue de la Promenade","address_street_number":"13","address_street_box":null,"email":"reservation@aubizou.be","website":"http:\/\/www.aubizou.be\/","phone_contact":"+32 474 10 75 76","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de la Promenade, 13","address_line2":"1070 Anderlecht","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Au B'izou","address_street_name":"Rue de la Promenade","address_street_number":"13","address_street_box":null,"email":"reservation@aubizou.be","website":"http:\/\/www.aubizou.be\/","phone_contact":"+32 474 10 75 76","phone_booking":null,"addr