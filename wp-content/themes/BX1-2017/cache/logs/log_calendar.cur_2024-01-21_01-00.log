ttp:\/\/www.lelogisfloreal.be\/expo","email":"gthomas@lelogisfloreal.be","phone_contact":"+32 2 205 17 73","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50006301"},"en":{"name":"Le Logis-Flor\u00e9al, une cit\u00e9 en-visag\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lelogisfloreal.be\/expo","email":"gthomas@lelogisfloreal.be","phone_contact":"+32 2 205 17 73","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50006301"},"it":{"name":"Le Logis-Flor\u00e9al, une cit\u00e9 en-visag\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lelogisfloreal.be\/expo","email":"gthomas@lelogisfloreal.be","phone_contact":"+32 2 205 17 73","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50006301"},"cn":{"name":"Le Logis-Flor\u00e9al, une cit\u00e9 en-visag\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lelogisfloreal.be\/expo","email":"gthomas@lelogisfloreal.be","phone_contact":"+32 2 205 17 73","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50006301"},"fr":{"name":"Le Logis-Flor\u00e9al, une cit\u00e9 en-visag\u00e9e","shortdescr":"Quatre photographes habitant le quartier du Logis \u2013 Flor\u00e9al sont all\u00e9s \u00e0 la rencontre de leurs voisins durant plusieurs mois. Ils ont tir\u00e9 le portrait d\u2019une centaine d\u2019habitants \u00e2g\u00e9s de 0 \u00e0 103 ans avec comme d\u00e9cor des maisons du Logis \u2013 Flor\u00e9al. Cette nouvelle exposition sera accompagn\u00e9e d\u2019une publication.","longdescr":"Les cit\u00e9s-jardins du Logis-Flor\u00e9al, on y na\u00eet, on y arrive, on y vit, on y vieillit, on y meurt parfois. Autant d\u2019individualit\u00e9s, de v\u00e9cus et d\u2019histoires qui cohabitent et qui se croisent, et dont le portrait, face visible et sensible, r\u00e9v\u00e8le notre commune humanit\u00e9. Ce projet a mobilis\u00e9 une centaine de personnes, entre 0 et 100 ans, le but \u00e9tait de r\u00e9aliser leur portrait avec une approche artistique et de montrer par cet ensemble toute la diversit\u00e9 des habitantes et des habitants des cit\u00e9s-jardins.  Les prises de vue ont eu lieu pendant trois mois dans des maisons vides du Logis \u2013 Flor\u00e9al, mettant \u00e9galement en valeur les caract\u00e9ristiques architecturales du patrimoine de la cit\u00e9-jardin, et laissant appara\u00eetre les traces du passage des habitants pr\u00e9c\u00e9dents dans ces maisons. ","performers":"Photos de Olivia Droeshaut, Julien Pohl, Michel Gelinne et G\u00e9raldine Thomas +  Projet \u00ab Premiers pas derri\u00e8re la porte \u00bb pr\u00e9sent\u00e9 par Nicolas Andry","boxoffice_url":null,"website":"http:\/\/www.lelogisfloreal.be\/expo","email":"gthomas@lelogisfloreal.be","phone_contact":"+32 2 205 17 73","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50006301"},"sp":{"name":"Le Logis-Flor\u00e9al, une cit\u00e9 en-visag\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lelogisfloreal.be\/expo","email":"gthomas@lelogisfloreal.be","phone_contact":"+32 2 205 17 73","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50006301"},"nl":{"name":"Le Logis-Flor\u00e9al, une cit\u00e9 en-visag\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lelogisfloreal.be\/expo","email":"gthomas@lelogisfloreal.be","phone_contact":"+32 2 205 17 73","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50006301"}},"place":{"id":243805,"translations":{"de":{"name":"Gare de Watermael","address_street_name":"Avenue des Taillis","address_str