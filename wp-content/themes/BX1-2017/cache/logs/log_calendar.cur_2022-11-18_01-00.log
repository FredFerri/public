s_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater"}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"],"de":["Theater"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Un petit air de Chelm","shortdescr":"Grandit-on par le haut ou par le bas\u200a?\r\nQu\u2019est-ce qui est le plus important, le soleil ou la lune\u200a?\r\nSavez-vous qu\u2019il suffit parfois de pousser une montagne pour trouver sa place\u200a?","longdescr":"Grandit-on par le haut ou par le bas\u200a?\r\nQu\u2019est-ce qui est le plus important, le soleil ou la lune\u200a?\r\n\r\nSavez-vous qu\u2019il suffit parfois de pousser une montagne pour trouver sa place\u200a? Il faut dire qu\u2019\u00e0 Chelm, petit village tomb\u00e9 du ciel entre Pinsk et Minsk, rien ne se passe comme ailleurs. C\u2019est bien simple, on ne peut plus logique\u200a: rien n\u2019est impossible l\u00e0 o\u00f9 la sagesse se mesure \u00e0 longueur de la barbe, l\u00e0 o\u00f9 l\u2019imaginaire a autant de poids que la r\u00e9alit\u00e9\u200a!\r\n\r\nDignes fondateurs d\u2019une certaine forme de philosophie, les Chelmiens et les Chelmiennes font preuve d\u2019une grande cr\u00e9ativit\u00e9, d\u2019une pers\u00e9v\u00e9rance tenace et d\u2019un \u00e9tonnant optimisme.\r\n\r\nApr\u00e8s les avoir rencontr\u00e9s, vous n\u2019aurez plus qu\u2019une envie\u200a: courir \u00e0 Chelm\u200a!\r\n\r\nAvec Nathalie de Pierpont et St\u00e9phane Groyne. Mise en sc\u00e8ne\u200a: Manon Dumonceaux. Adaptation\u200a: St\u00e9phane Groyne, Nathalie de Pierpont et Manon Dumonceaux. Costumes\u200a: Isabelle Airaud. Sc\u00e9nographie\u200a: Thomas Jodogne. Constructions\u200a: Jean Louyest et Arnaud Van Hamm\u00e9e. Lumi\u00e8re\u200a: Thyl Beniest. R\u00e9gie\u200a: Luc Jouniaux. Mise en mouvement\u200a: Isabelle Lamouline. D\u00e9cors et accessoires\u200a: Jean Louyest, Arnaud Van Hamm\u00e9e, St\u00e9phane Groyne et Thyl Beniest.","performers":"Micmac Th\u00e9\u00e2tre","boxoffice_url":null,"website":"https:\/\/lamontagnemagique.be\/un-petit-air-de-chelm-2\/","email":"info@montagnemagique.be","phone_contact":"+32 2 210 15 90","phone_booking":"+32 2 210 15 90","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.541610"},"nl":{"name":"Un petit air de Chelm","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.541610"},"en":{"name":"Un petit air de Chelm","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.541610"},"de":{"name":"Un petit air de Chelm","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.541610"},"it":{"name":"Un petit air de Chelm","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.541610"},"sp":{"name":"Un petit air de Chelm","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.541610"},"pt":{"name":"Un petit air de Chelm","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"pho