9sentations de femmes qui ont particip\u00e9 et participent encore \u00e0 cr\u00e9er Bruxelles et \u00e0 forger son histoire.","longdescr":"Ouvrons ensemble les portes des quartiers Sainte-Catherine, B\u00e9guinage et Dansaert pour y poser un nouveau regard sur l\u2019espace public bruxellois. Des lieux embl\u00e9matiques aux architectures peu communes se r\u00e9v\u00e8lent au fil de nos partages sur les r\u00f4les et les repr\u00e9sentations de femmes qui ont particip\u00e9 et participent encore \u00e0 cr\u00e9er Bruxelles et \u00e0 forger son histoire. Avec une palette d\u2019explorations sensorielles, de regards crois\u00e9s et de dialogues partag\u00e9s, nous interconnecterons architecture et histoire avec un contexte actuel de recherche d\u2019\u00e9galit\u00e9.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.bruxellesbavard.be","email":"info@bruxellesbavard.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/530403.html"},"nl":{"name":"Parcours de femmes \u00e0 Bruxelles : aristocrates, b\u00e9guines, poissonni\u00e8res et stylistes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.brusselbabbelt.be","email":"info@brusselbabbelt.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/530403.html"},"en":{"name":"Parcours de femmes \u00e0 Bruxelles : aristocrates, b\u00e9guines, poissonni\u00e8res et stylistes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.brusselschatterguides.be","email":"info@brusselschatterguides.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/530403.html"},"de":{"name":"Parcours de femmes \u00e0 Bruxelles : aristocrates, b\u00e9guines, poissonni\u00e8res et stylistes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_