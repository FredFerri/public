d\u00e9di\u00e9 \u00e0 la dynamique actuelle et engag\u00e9e de l\u2019ULB. \r\n\r\nImpr\u00e9gnez-vous de cette \u00e9bullition cr\u00e9ative, artistique et sociale sur le campus du Solbosch du 12\/09 au 12\/12. \r\n\r\nToutes les informations sur www.ulb.be\/centenaire","performers":null,"boxoffice_url":null,"website":"http:\/\/www.ulb.be\/centenaire","email":"Culture@ulb.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.540957"},"nl":{"name":"Imagine Cultures","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.540957"},"en":{"name":"Imagine Cultures","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.540957"},"de":{"name":"Imagine Cultures","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.540957"},"it":{"name":"Imagine Cultures","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.540957"},"sp":{"name":"Imagine Cultures","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.540957"},"pt":{"name":"Imagine Cultures","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"htt