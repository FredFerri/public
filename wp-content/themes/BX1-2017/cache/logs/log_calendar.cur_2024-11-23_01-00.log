_link":null,"import_origin":null,"is_part_of":null,"sub_type":"theatre","ranking":0.6299605249474366,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":49,"translations":{"de":"Theater","pt":null,"en":"Theatre","it":"Teatro","cn":null,"fr":"Th\u00e9\u00e2tre","sp":"Teatro","nl":"Theater"}},"others":{"list":[50],"translations":{"de":["Theater"],"pt":[null],"en":["Theatre"],"it":["Teatro"],"cn":[null],"fr":["Th\u00e9\u00e2tre"],"sp":["Teatro"],"nl":["Theater"]}}},"translations":{"de":{"name":"Les liaisons dangereuses","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.jopaprofs.be\/","email":"reservation@jopaprofs.be","phone_contact":null,"phone_booking":"+32 492 70 53 92","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700001852"},"pt":{"name":"Les liaisons dangereuses","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.jopaprofs.be\/","email":"reservation@jopaprofs.be","phone_contact":null,"phone_booking":"+32 492 70 53 92","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700001852"},"en":{"name":"Les liaisons dangereuses","shortdescr":"Les Jopaprofs vous pr\u00e9sentent \"Les liaisons dangereuses\".","longdescr":"Mensonges, libertinage, trahisons et coups de plume sont au c\u0153ur des passes d\u2019armes entre la Marquise de Merteuil et le Vicomte de Valmont.\nCe qui semble n\u2019\u00eatre qu\u2019un simple jeu de s\u00e9duction dont vengeance et pouvoir sont les moteurs, va rapidement se d\u00e9clarer en conflit d\u2019influences.\n\nLes deux ma\u00eetres de la manipulation vont engager une impitoyable partie d\u2019\u00e9checs o\u00f9 tous les coups seront permis. Cette liaison s\u2019av\u00e9rera plus que dangereuse car l\u2019ego de chacun ne peut souffrir d\u2019aucune faiblesse au point d\u2019en perdre leur \u00e2me.\n\nDans cet affrontement sans merci, les deux duellistes entrainent dans leur tourmente la candide C\u00e9cile de Volanges, premi\u00e8re victime du pi\u00e8ge machiav\u00e9lique qui se refermera aussi sur Madame de Tourvel et le Chevalier Danceny. Autant de personnages contrast\u00e9s, issus de la noblesse nantie et oisive du 18 \u00e8me si\u00e8cle qui touche \u00e0 sa fin de r\u00e8gne\u2026\n\nAdapt\u00e9e de l\u2019\u0153uvre \u00e9pistolaire de Choderlos de Laclos, cette pi\u00e8ce de th\u00e9\u00e2tre est port\u00e9e par des d\u00e9cors et costumes hauts en couleur et par une prose stylistique qui ravira les amateurs de joutes verbales.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.jopaprofs.be\/","email":"reservation@jopaprofs.be","phone_contact":null,"phone_booking":"+32 492 70 53 92","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700001852"},"it":{"name":"Les liaisons dangereuses","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.jopaprofs.be\/","email":"reservation@jopaprofs.be","phone_contact":null,"phone_booking":"+32 492 70 53 92","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700001852"},"cn":{"name":"Les liaisons dangereuses","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.jopaprofs.be\/","email":"reservation@jopaprofs.be","phone_contact":null,"phone_booking":"+32 492 70 53 92","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700001852"},"fr":{"name":"Les liaisons dangereuses","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.jopaprofs.be\/","email":"reservation@jopaprofs.be","phone_contact":null,"phone_booking":"+32 492 70 53 92","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700001852"},"sp":{"name":"Les liaisons dangereuses","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.jopaprofs.be\/","e