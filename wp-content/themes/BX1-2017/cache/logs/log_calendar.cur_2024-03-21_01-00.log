lse,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-03-20T01:01:21+01:00","published_at":"2024-03-04T08:46:57+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":295761,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.43679023236814946,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[46,36],"translations":{"de":["Multidisziplin\u00e4r","Museen & Kunstzentren"],"pt":[null,null],"en":["Multidisciplinary","Museums and art centers"],"it":["Multidisciplinare","Musei e centri artistici"],"cn":[null,null],"fr":["Pluridisciplinaire","Mus\u00e9es et art centers"],"sp":["Multidisciplinar","Museos y centros de arte"],"nl":["Multidisciplinair","Musea en kunstcentra"]}}},"translations":{"de":{"name":"EXPO PARTIR \u2013 \u00c9migration des femmes espagnoles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.migratiemuseummigration.be","email":"museum@foyer.be","phone_contact":"+32 2 609 55 61","phone_booking":"+32 2 609 55 61","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50007956"},"pt":{"name":"EXPO PARTIR \u2013 \u00c9migration des femmes espagnoles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.migratiemuseummigration.be","email":"museum@foyer.be","phone_contact":"+32 2 609 55 61","phone_booking":"+32 2 609 55 61","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50007956"},"en":{"name":"PARTIR \u2013 \u00c9migration des femmes espagnoles","shortdescr":"Between the 1950s and 1960s, more than 7,000 Spaniards immigrated to Belgium. Most of the men went to work in the mines, but what about the women?","longdescr":"Between the 1950s and 1960s, more than 7,000 Spaniards immigrated to Belgium. Most of the men went to work in the mines, but what about the women?\n\nFrom 6 to 29 March 2024, the MMM runs the new exhibition \u201cPARTIR\u201d.\n\nThis exhibition is a journey through the lives and experiences of Spanish women who left their country in the 1960s in search of a better life in Belgium. Through a careful compilation of objects from that period and excerpts from interviews conducted for the podcast PARTIR, the exhibition aims to pay tribute to this generation by bringing visitors closer to their stories, experiences and lifestyles.\n\nThe exhibition also establishes a dialogue with the museum\u2019s other exhibitions and highlights Spain\u2019s contribution to the history of migratory movements in the Belgian capital.\n\nWith this exhibition, Partir provides continuity and offers new elements to complement the testimonies heard in the podcast series to reconstruct history from a feminist perspective.\n\n\u2192 Opening on 6 March at 11am\n\nReservations: museum@foyer.be","performers":null,"boxoffice_url":null,"website":"http:\/\/www.migratiemuseummigration.be","email":"museum@foyer.be","phone_contact":"+32 2 609 55 61","phone_booking":"+32 2 609 55 61","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50007956"},"it":{"name":"EXPO PARTIR \u2013 \u00c9migration des femmes espagnoles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.migratiemuseummigration.be","email":"museum@foyer.be","phone_contact":"+32 2 609 55 61","phone_booking":"+32 2 609 55 61","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50007956"},"cn":{"name":"EXPO PARTIR \u2013 \u00c9migration des femmes espagnoles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.migratiemuseummigration.be","email":"museum@foyer.be","phone_contact":"+32 2 609 55 61","phone_booking":"+32 2 609 55 61","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50007956"},"fr":{"name":"PARTIR \u2013 \u00c9migration des femmes espagnoles","shortdescr":"Entre les ann\u00e9es 1950 et 1960, plus de 7 000 Espagnols ont \u00e9migr\u00e9 en Belgique. La plupart des hommes sont all\u00e9s travailler dans les mines, mais qu\u2019en est-il des femmes ?","longdescr":"Entre les ann\u00e9es 1950 et 1960, plus de 7 000 Espagnols ont \u00e9migr\u00e9 en Belgique. La plupart des hommes sont all\u00e9s travailler dans les mines, mais qu\u2019en est-il des femmes ?\n\nDu 6 au 29 mars 2024, le MMM accueille une nouvelle exposition \u201cPARTIR\u201d.\n\nCette exposition est un voyage \u00e0 travers la vie et les exp\u00e9riences des femmes espagnoles qui ont quitt\u00e9 leur pays \u00e0 la recherche d\u2019opportunit\u00e9s en Belgique dans les ann\u00e9es 1960. Gr\u00e2ce \u00e0 une compilation minutieuse d\u2019objets de l\u2019\u00e9poque et \u00e0 des fragments d\u2019interviews r\u00e9alis\u00e9es pour le podcast PARTIR, cette exposition vise \u00e0 rendre hommage \u00e0 cette g\u00e9n\u00e9ration en rapprochant les visiteurs de leurs histoires, de leurs exp\u00e9riences et de leur mode de vie.\n\nElle \u00e9tablit \u00e9galement un dialogue avec les autres pi\u00e8ces expos\u00e9es dans le mus\u00e9e, en soulignant la contribution de l\u2019Espagne \u00e0 l\u2019histoire des mouvements migratoires dans la capitale belge.\n\nAvec cette exposition, Partir donne une continuit\u00e9 et offre des nouveaux \u00e9l\u00e9ments pour compl\u00e9ter les t\u00e9moignages qui peuvent \u00eatre entendus dans la s\u00e9rie de podcasts pour reconstruire l\u2019histoire \u00e0 partir d\u2019une perspective f\u00e9ministe.\n\n\u2192 Vernissage : mercredi 6 mars \u00e0 11h\n\nR\u00e9servations : museum@foyer.be","performers":"Laia Boloix\nTamara Atienzar","boxoffice_url":null,"website":"http:\/\/www.migratiemuseummigration.be","email":"museum@foyer.be","phone_contact":"+32 2 609 55 61","phone_booking":"+32 2 609 55 61","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50007956"},"sp":{"name":"EXPO PARTIR \u2013 \u00c9migration des femmes espagnoles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.migratiemuseummigration.be","email":"museum@foyer.be","phone_contact":"+32 2 609 55 61","phone_booking":"+32 2 609 55 61","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50007956"},"nl":{"name":"PARTIR \u2013 \u00c9migration des femmes espagnoles","shortdescr":"Tussen de jaren 1950 en 1960 emigreerden meer dan 7.000 Spanjaarden naar Belgi\u00eb. De meeste mannen gingen in de mijnen werken, maar hoe zit het met de vrouwen?","longdescr":"Tussen de jaren 1950 en 1960 emigreerden meer dan 7.000 Spanjaarden naar Belgi\u00eb. De meeste mannen gingen in de mijnen werken, maar hoe zit het met de vrouwen?\n\nVan 6 tot 29 maart 2024 loopt in het MMM de nieuwe tentoonstelling \u201cPARTIR\u201d.\n\nDeze tentoonstelling is een reis door het leven en de ervaringen van Spaanse vrouwen die in de jaren 1960 hun land verlieten op zoek naar een beter leven in Belgi\u00eb. Door een zorgvuldige compilatie van voorwerpen uit die periode en fragmenten van interviews die werden afgenomen voor de podcast PARTIR, wil de tentoonstelling hulde brengen aan deze generatie door bezoekers dichter bij hun verhalen, ervaringen en levensstijlen te brengen.\n\nDe tentoonstelling gaat ook een dialoog aan met de andere tentoonstellingen in het museum en belicht de bijdrage van Spanje aan de geschiedenis van de migratiebewegingen in de Belgische hoofdstad.\n\nMet deze tentoonstelling geeft Partir continu\u00efteit en biedt we nieuwe elementen als aanvulling op de getuigenissen die te horen zijn in de podcastreeks om de geschiedenis te reconstrueren vanuit een feministisch perspectief.\n\n\u2192 Opening op 6 maart om 11u\n\nReservaties: museum@foyer.be","performers":null,"boxoffice_url":null,"website":"http:\/\/www.migratiemuseummigration.be","email":"museum@foyer.be","phone_contact":"+32 2 609 55 61","phone_booking":"+32 2 609 55 61","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50007956"}},"place":{"id":274307,"translations":{"de":{"name":"MigratieMuseumMigration","address_street_name":"rue des ateliers","address_street_number":"17","address_street_box":null,"email":"museum@foyer.be","website":"http:\/\/www.migratiemuseummigration.be","phone_contact":"+32 2 609 55 61","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue des ateliers, 17","address_line2":"1080 Molenbeek-Saint-Jean","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"MigratieMuseumMigration","address_street_name":"rue des ateliers","address_street_number":"17","address_street_box":null,"email":"museum@foyer.be","website":"http:\/\/www.migratiemuseummigration.be","phone_contact":"+32 2 609 55 61","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue des ateliers, 17","address_line2":"1080 Molenbeek-Saint-Jean","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"MigratieMuseumMigration","address_street_name":"rue des ateliers","address_street_number":"17","address_street_box":null,"email":"museum@foyer.be","website":"http:\/\/www.migratiemuseummigration.be","phone_contact":"+32 2 609 55 61","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue des ateliers, 17","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"Today, more than 180 nationalities live together in Brussels. The MigratieMuseumMigration gives a permanent 