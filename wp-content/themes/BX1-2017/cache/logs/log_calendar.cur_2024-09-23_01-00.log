itles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[30,24],"translations":{"de":["Malerei","Kunstgalerien"],"pt":[null,null],"en":["Painting","Art Galleries"],"it":["Pittura","Gallerie d'arte"],"cn":[null,null],"fr":["Peinture","Galeries d'art"],"sp":["Pintura","Galer\u00edas de arte"],"nl":["Schilderkunst","Galeries"]}}},"translations":{"de":{"name":"Igor Tishin","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.zedes-art-gallery.be","email":"zedes.art.gallery@gmail.com","phone_contact":"+32 475 52 62 58","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700000107"},"pt":{"name":"Igor Tishin","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.zedes-art-gallery.be","email":"zedes.art.gallery@gmail.com","phone_contact":"+32 475 52 62 58","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700000107"},"en":{"name":"Igor Tishin","shortdescr":null,"longdescr":"Igor Tishin is one of the most important representatives of subversive Belarusian painting, His work is defined by a martyrology that hasits origins in the successive tragedies that have filled his country's memory. Using metaphors, the artistexplores the collective consciousness where the spirit of Chagall and folklore continueto colour life, while dark Soviet dogmas continue to weigh heavily. Igor now lives in\nBelgium and shows a growing interest in socio-philosophical and universal issues.\nHis approach as a painter remains shifted, constantly balancing between reality\nand the imaginary, between identity and otherness. Igor Tishin likes to recklessly break\nhis own stylistic forms. His disruptive brushstrokes result in an insolent, absurd work\ndriven by derision, where the trick is to be able to read between the lines.\n","performers":null,"boxoffice_url":null,"website":"http:\/\/www.zedes-art-gallery.be","email":"zedes.art.gallery@gmail.com","phone_contact":"+32 475 52 62 58","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700000107"},"it":{"name":"Igor Tishin","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.zedes-art-gallery.be","email":"zedes.art.gallery@gmail.com","phone_contact":"+32 475 52 62 58","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700000107"},"cn":{"name":"Igor Tishin","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.zedes-art-gallery.be","email":"zedes.art.gallery@gmail.com","phone_contact":"+32 475 52 62 58","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700000107"},"fr":{"name":"Igor Tishin","shortdescr":null,"longdescr":"Igor Tishin est l\u2019un des repr\u00e9sentants les plus importants de la peinture bi\u00e9lorusse subversive. Son travail se d\u00e9finit par une \u00ab martyrologie \u00bb qui trouve son origine dans les trag\u00e9dies successives qui ont empli la m\u00e9moire de son pays. L\u2019artiste explore \u00e0 l\u2019aide de m\u00e9taphores, cette conscience collective o\u00f9 l\u2019esprit de Chagall et le folklore persistent \u00e0 vouloir colorer la vie, alors que planent encore les sombres dogmes sovi\u00e9tiques. Igor vit en Belgique depuis plusieurs ann\u00e9es et  son regard de peintre bien que plus universel ,  reste d\u00e9cal\u00e9 et balance constamment entre r\u00e9alit\u00e9 et imaginaire, entre identit\u00e9 et alt\u00e9rit\u00e9. Igor Tishin aime briser imprudemment ses propres formes stylistiques. Ses coups de brosse perturbateurs aboutissent \u00e0 une \u0153uvre insolente, absurde et anim\u00e9e par la d\u00e9rision o\u00f9 l\u2019astuce est de pouvoir lire entre les lignes.","performers":"Igor Tishin","boxoffice_url":null,"website":"http:\/\/www.zedes-art-gallery.be","email":"zedes.art.gallery@gmail.com","phone_contact":"+32 475 52 62 58","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700000107"},"sp":{"name":"Igor Tishin","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.zedes-art-gallery.be","email":"zedes.art.gallery@gmail.com","phone_contact":"+32 475 52 62 58","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700000107"},"nl":{"name":"Igor Tishin","shortdescr":null,"longdescr":"Igor Tishin is  een van de belangrijkste vertegenwoordigers van de subversieve Wit-\nRussische schilderkunst.  Zijn werk wordt gekenmerkt door een martelaars cultuur die haar oorsprong vindt in de opeenvolgende tragedies die het geheugen van zijn land hebben gevuld. Met behulp van\nmetaforen verkent de kunstenaar het collectieve bewustzijn waar de geest van Chagall en folklore het leven blijven kleuren, terwijl duistere Sovjetdogma's zwaar blijven wegen.\nIgor woont nu in Belgi\u00eb en is steeds meer ge\u00efnteresseerd in sociaal-filosofische en\nuniversele kwesties. Zijn benadering als schilder blijft verschoven, voortdurend balancerend tussen realiteit en het imaginaire, tussen identiteit en anders-zijn. Igor Tishin breekt graag roekeloos met\nzijn eigen stijlvormen. Zijn ontwrichtende penseelstreken leveren brutaal, absurd werk\nop, gedreven door spot, waarbij de kunst tussen de lijnen door te lezen is.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.zedes-art-gallery.be","email":"zedes.art.gallery@gmail.com","phone_contact":"+32 475 52 62 58","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700000107"}},"place":{"id":260455,"translations":{"de":{"name":"zedes art gallery","address_street_name":"R