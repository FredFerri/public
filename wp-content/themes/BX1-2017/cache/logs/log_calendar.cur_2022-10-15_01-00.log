,"last_updated_at":"2022-10-11T00:06:10+02:00","published_at":"2022-08-03T13:03:34+02:00","backoffice_id":259248,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":0.43679023236815},{"id":538289,"date_start":"2022-10-25","date_end":"2022-11-19","date_next":"2022-10-25","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung"}},"others":{"list":[36,47],"translations":{"fr":["Mus\u00e9es et art centers","Bande dessin\u00e9e"],"nl":["Musea en kunstcentra","Stripverhaal"],"en":["Museums and art centers","Comicstrip"],"de":["Museen & Kunstzentren","Comics"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Hshouma de Zainab Fasiki","shortdescr":"Mi-projet artistique, mi-initiative \u00e9ducative, Hshouma est une bande dessin\u00e9e qui se veut une tentative d\u2019\u00e9br\u00e9cher les tabous li\u00e9s au genre, \u00e0 l\u2019\u00e9ducation sexuelle et aux violences faites aux femmes. D\u00e9couvrez les planches et rencontrez la talentueuse b\u00e9d\u00e9iste marocaine Zainab Fasiki lors du vernissage de l'exposition qui se d\u00e9roulera le mardi 25 octobre \u00e0 18h00.","longdescr":"Hshouma signifie \u00ab honte \u00bb dans le dialecte marocain. Il est aussi utilis\u00e9 pour dire: \u00ab Tais-toi ! \u00bb et ainsi arr\u00eater la conversation. Plus pr\u00e9cis\u00e9ment, ce mot d\u00e9signe l\u2019ensemble des sujets tabous que l\u2019on ne doit pas aborder en soci\u00e9t\u00e9 ou en famille. \r\n\r\nLes femmes dessin\u00e9es par Zainab Fasiki peuvent sembler provocantes et fatales, parfois m\u00eame sarcastiques. Nues, en lingerie ou portant le voile, en ville ou au hammam, elles se moquent d\u2019un masculisme hypocrite et effray\u00e9 par les corps, faisant ainsi fi des canons de beaut\u00e9 impos\u00e9s par les autres. \r\n\r\nLes dessins et planches de l\u2019artiste sont ainsi autant de mani\u00e8res de c\u00e9l\u00e9brer les corps et leur beaut\u00e9, mettant \u00e0 mal un des piliers sur lequel repose nos soci\u00e9t\u00e9s patriarcales, autant au Maroc qu\u2019en Europe. Outre la beaut\u00e9 du trait, Hshouma est un livre important, qui milite pour la lib\u00e9ration de la femme dans le monde arabe. \r\n\r\n\u00ab La nudit\u00e9 dans l\u2019art est encore taboue au Maroc, tout comme de nombreuses libert\u00e9s individuelles et c\u2019est pourquoi j\u2019ai cr\u00e9\u00e9 ce livre. Hshouma est un guide dessin\u00e9 simple qui explique les identit\u00e9s de genre, les orientations sexuelles et les corps, que nous ne pouvons apprendre ni \u00e0 l\u2019\u00e9cole ni en famille. C\u2019est avant tout un guide la\u00efque qui d\u00e9taille le corps et la sexualit\u00e9 dans la culture marocaine avec une neutralit\u00e9 religieuse. Hshouma est le livre que j\u2019avais besoin de lire quand j\u2019avais 15 ans...\u00bb (Zineb Fasiki).","performers":null,"boxoffice_url":null,"website":"http:\/\/www.espacemagh.be","email":"reservation@espacemagh.be","phone_contact":"+32 2 274 05 22","phone_booking":"+32 2 274 05 10","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.538289"},"nl":{"name":"Hshouma de Zainab Fasiki","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.538289"},"en":{"name":"Hshouma de Zainab Fasiki","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.538289"},"de":{"name":"Hshouma de Zainab Fasiki","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.538289"},"it":{"name":"Hshouma de Zainab Fasiki","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.538289"},"sp":{"name":"Hshouma de Zainab Fasiki","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.538289"},"pt":{"name":"Hshouma de Zainab Fasiki","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.538289"},"cn":{"name":"Hshouma de Zainab Fasiki","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.538289"}},"place":{"id":247296,"translations":{"fr":{"name":"Centre culturel Espace Magh asbl","address_street_name":"Rue du Poin\u00e7on","address_street_number":"17","address_street_box":null,"email":"info@espacemagh.be","website":"http:\/\/www.espacemagh.be","phone_contact":"+32 2 274 05 10","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Poin\u00e7on, 17","address_line2":"1000 Bruxelles","description_web":"Lieu de cr\u00e9ation, de production et de diffusion n\u00e9 de la volont\u00e9 d\u2019une minorit\u00e9 \r\nculturelle (l\u2019immigration maghr\u00e9bine) de notre pays, l\u2019Espace Magh est un projet artistique engag\u00e9