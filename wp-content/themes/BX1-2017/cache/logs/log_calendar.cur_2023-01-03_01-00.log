ull,null,null,null,null,null,null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-11-23T15:53:19+01:00","published_at":"2022-10-11T15:43:28+02:00","backoffice_id":263906,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":0.7937005259841},{"id":543909,"date_start":"2023-01-10","date_end":"2023-01-28","date_next":"2023-01-10","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater","it":null,"sp":null,"pt":null,"cn":null}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"],"de":["Theater"],"it":[null],"sp":[null],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"La cabane d'Alexandra Kollonta\u00ef","shortdescr":"Cette cabane, c\u2019est ma lutte pour vivre autrement. C\u2019est le r\u00eave d\u2019une autre vie et c\u2019est \u00e0 port\u00e9e de main, la preuve. Rien ne nous oblige \u00e0 vivre comme \u00e7a.","longdescr":"\u00abL\u2019amour n\u2019\u00e9tait l\u00e9gitime que dans le mariage ; ailleurs, il \u00e9tait consid\u00e9r\u00e9 comme immoral. Un tel id\u00e9al \u00e9tait dict\u00e9 par des consid\u00e9rations \u00e9conomiques : il s\u2019agissait d\u2019emp\u00eacher la dispersion du capital parmi les enfants collat\u00e9raux. Toute la morale bourgeoise avait pour fonction de contribuer \u00e0 la concentration du capital\u00bb a \u00e9crit Alexandra Kollonta\u00ef, femme politique marxiste, militante f\u00e9ministe sovi\u00e9tique, premi\u00e8re femme membre d\u2019un gouvernement, et premi\u00e8re \u00abpolyamoureuse\u00bb. \u2028Christine Delmotte-Weber s\u2019empare de cette figure comme contrepoint de l\u2019histoire d\u2019aujourd\u2019hui qu\u2019elle \u00e9crit et met en sc\u00e8ne, o\u00f9 Alix rencontre Julia gr\u00e2ce \u00e0 Lisbeth, en tombe amoureuse, puis apprend la maladie de Julia, d\u00e9couvre l\u2019existence de son compagnon, Samuel, homme poly-amoureux aux multiples relations : avec Julia, Renata et Saskia, et de son mode de vie pleinement assum\u00e9 \u2013 monde \u00e9trange pour Alix \u00e0 la d\u00e9couverte duquel elle ira, d\u2019abord r\u00e9ticente, voire moqueuse, puis, mue par son amour pour Julia, sensible aux arguments de Samuel.\u2028 \u00abVite, des cabanes, en effet. Pas pour s\u2019isoler, vivre de peu, ou tourner le dos \u00e0 notre monde ab\u00eem\u00e9 ; mais pour braver ce monde, l\u2019habiter autrement : l\u2019\u00e9largir\u00bb \u00e9crit Marielle Mac\u00e9, historienne de la litt\u00e9rature et essayiste fran\u00e7aise. C\u2019est \u00e0 cette injonction positive \u00e0 vivre pleinement qu\u2019Alix, Julia et Samuel entendent s\u2019atteler.","performers":"texte Christine Delmotte-Weber \u2022 jeu Maximilien Delmelle, Sarah Joseph, Sarah Messens \u2022 sc\u00e9nographie, costumes et marionnettes Ana\u00eblle Impe \u2022 r\u00e9gie g\u00e9n\u00e9rale Yohan Van Wymeersch \u2022 mise en sc\u00e8ne Christine Delmotte-Weber","boxoffice_url":null,"website":"http:\/\/www.theatre-martyrs.be","email":"billetterie@theatre-martyrs.be","phone_contact":null,"phone_booking":"+32 2 223 32 08","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.543909"},"nl":{"name":"La cabane d'Alexandra Kollonta\u00ef","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.543909"},"en":{"name":"La cabane d'Alexandra Kollonta\u00ef","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_con