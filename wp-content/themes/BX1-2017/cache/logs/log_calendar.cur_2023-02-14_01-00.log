0e9servation : 10\u20ac\/\u00e9tudiant & 13\u20ac\/adulte\r\n- Sur place : 15\u20ac\/personne","performers":"Vincent Vanderbeeken, Beno\u00eet Pauwels et un.e invit\u00e9.e INOUBLIABLE","boxoffice_url":null,"website":"http:\/\/www.letrac.be\/reservation","email":"info@letrac.be","phone_contact":"+32 470 50 04 75","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.540185"},"nl":{"name":"LAST CALL - Spectacle D'improvisation de Benoit P, Vincent V et leur invit\u00e9.e surprise","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.letrac.be\/reservation","email":"info@letrac.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.540185"},"en":{"name":"LAST CALL - Spectacle D'improvisation de Benoit P, Vincent V et leur invit\u00e9.e surprise","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.letrac.be\/reservation","email":"info@letrac.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.540185"},"de":{"name":"LAST CALL - Spectacle D'improvisation de Benoit P, Vincent V et leur invit\u00e9.e surprise","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.letrac.be\/reservation","email":"info@letrac.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.540185"},"it":{"name":"LAST CALL - Spectacle D'improvisation de Benoit P, Vincent V et leur invit\u00e9.e surprise","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.letrac.be\/reservation","email":"info@letrac.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.540185"},"sp":{"name":"LAST CALL - Spectacle D'improvisation de Benoi