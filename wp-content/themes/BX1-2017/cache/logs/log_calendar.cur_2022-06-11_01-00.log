se},{"day":"2022-06-26","doors":null,"start":"15:00:00","end":"16:30:00","is_soldout":false,"is_canceled":false},{"day":"2022-09-04","doors":null,"start":"15:00:00","end":"16:30:00","is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":16},{"translations":{"fr":{"name":"Senior"},"nl":{"name":"Senioren"},"en":{"name":"Senior"}},"value":13.9},{"translations":{"fr":{"name":"Jeunes"},"nl":{"name":"Jongeren"},"en":{"name":"Young"}},"value":10.8},{"translations":{"fr":{"name":"Demandeurs d'emploi"},"nl":{"name":"Werkzoekenden"},"en":{"name":"Jobseekers"}},"value":10.8},{"translations":{"fr":{"name":"Enfants"},"nl":{"name":"Kinderen"},"en":{"name":"Children"}},"value":8.7},{"translations":{"fr":{"name":"Article 27"},"nl":{"name":"Artikel 27"},"en":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[],"targets":{"list":[4,5,3],"translations":{"fr":["Enfants 6-9 ans","Enfants 9-12 ans","Enfants 3-6 ans"],"nl":["Kinderen 6-9 j.","Kinderen 9-12 j.","Kinderen 3-6 j."],"en":["Children 6-9 yr.","Children 9-12 yr.","Children 3-6 yr."]}},"tags":["kids"],"accessibilities":{"list":[255,265,266],"translations":{"fr":["Accessible","WC adapt\u00e9","Brussels Health Safety Label"],"nl":["Toegankelijk","Aangepast toilet","Brussels Health Safety Label"],"en":["Accessible","Adapted toilet","Brussels Health Safety Label"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-05-23T01:07:36+02:00","published_at":"2021-10-05T15:56:50+02:00","backoffice_id":240428,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":0.18232183586429},{"id":533540,"date_start":"2022-06-26","date_end":"2022-06-30","date_next":"2022-06-27","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":true,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":true,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert"}},"others":{"list":[4,6],"translations":{"fr":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"],"nl":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"],"en":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"The Firefly Sessions","shortdescr":"Randonn\u00e9e musicale des Lucioles","longdescr":"REMARQUE : les tickets pour cet \u00e9v\u00e9nement seront mis en vente le mardi 17 mai \u00e0 10h30 sur notre site internet\r\n\r\nLes lucioles offrent un spectacle fascinant \u00e0 l\u2019heure du coucher du soleil, seulement quelques jours par an. Leur danse de lumi\u00e8re si particuli\u00e8re est \u00e0 observer dans certains endroits sombres et bois\u00e9s aux alentours de la capitale bruxelloise. Avec le musicien-biologiste Rapha\u00ebl De Cock, le sp\u00e9cialiste belge des lucioles, nous vous invitons \u00e0 une balade musicale dans la for\u00eat de Soignes. Entre concert intimiste et moment d\u2019observation de la nature, les \u00ab firefly sessions \u00bb ont tout d\u2019un moment magique et inoubliable. Le parcours comprend des explications sur les lucioles, des moments de musique acoustique tr\u00e8s calmes orchestr\u00e9s par Rapha\u00ebl De Cock et un invit\u00e9 surprise, et se termine par l\u2019observation des lucioles, qui ne pointent le bout de leur nez qu\u2019au coucher du soleil.\r\n\r\nC\u00f4t\u00e9 Pratique\r\nPr\u00e9voyez de bonnes chaussures ou bottines, de quoi vous asseoir sur le sol et de quoi vous couvrir en cas de pluie. Nous ferons une boucle \u00e0 pied de +-4 km qui n\u2019est pas accessible avec tout autre v\u00e9hicule. Vous recevrez l\u2019adresse pr\u00e9cise du rendez-vous par mail apr\u00e8s avoir achet\u00e9 votre ticket, mais sachez que le d\u00e9part se fait sur la commune de Watermael-Boitsfort. Le d\u00e9part group\u00e9 se fait \u00e0 20h15 pr\u00e9cise, nous n\u2019attendrons pas les retardataires. Fin de l\u2019activit\u00e9 vers 23h30. Cette activit\u00e9 vous invitera \u00e0 respecter les lieux en apprenant \u00e0 conna\u00eetre leur magie.","performers":"Rapha\u00ebl De Cock","boxoffice_url":null,"website":"http:\/\/www.muziekpublique.be","email":"info@muziekpublique.be","phone_contact":null,"phone_booking":"+32 2 217 26 00","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/533540.html"},"nl":{"name":"The Firefly Sessions","shortdescr":"Muzikale vuurvliegjes wandeling","longdescr":"NOOT: De ticketverkoop voor dit evenement start op dinsdag 17 mei om 10.30 uur via onze website\r\n\r\nHet is een betoverend zicht als de vuurvliegjes gedurende enkele weken per jaar na zonsondergang ronddansen. Ook in Brussel kan je deze magische momenten beleven. Samen met muzikant-bioloog Raphael De Cock, de Belgische specialist in vuurvliegjes, trekken we het Zoni\u00ebnwoud in voor een intiem concert met telkens een gastmuzikant(e). Het hoogtepunt van de avond breekt als de mannetjes van de kleine glimworm of vuurvliegje, een opvallende en herkenbare soort glimworm, na zonsondergang beginnen rond te vliegen. Wanneer zij in grote aantallen rondvliegen, zorgen ze voor een fee\u00ebriek spektakel!\r\n\r\nPraktisch\r\nDraag stevige schoenen of stapschoenen, iets om op de grond te gaan zitten en indien nodig regenkledij. We wandelen een lus van ongeveer 4 km die niet met een voertuig te bereiken is. Na bevestiging van betaling ontvangt u per e-mail het exacte adres van het vertrekpunt, in de gemeente Watermaal-Bosvoorde. We vertrekken stipt om 20:15 uur en wachten niet op laatkomers. Het einde van de activiteit is voorzien rond 23.30 uur. Deze activiteit vraagt het nodige respect voor de natuur en het woud in ruil voor een magische ervaring.","performers":"Rapha\u00ebl De Cock","boxoffice_url":null,"website":"http:\/\/www.muziekpublique.be","email":"info@muziekpublique.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/533540.html"},"en":{"name":"The Firefly Sessions","shortdescr":"Fireflies musical walk","longdescr":"NOTE: Tickets for this event will go on sale on Tuesday 17 May at 10.30am on our website\r\n\r\nAs darkness sets over Brussels, male fireflies hit the forest looking for mates. They blink their beaming bellies as they fly around and before long they have synchronized with their neighbors. This bioluminescent mating dance peaks for just a few nights a year.\r\n\r\nWith musician-biologist Rapha\u00ebl De Cock, the Belgian firefly specialist, we invite you to a musical stroll through the For\u00eat de Soignes. Between an intimate concert and a moment of nature observation, the \u201cfirefly sessions\u201d are a magical and unforgettable moment. The tour includes explanations about fireflies, moments of very quiet acoustic music orchestrated by Rapha\u00ebl De Cock and a surprise guest, and ends with the observation of fireflies, which only appear at sunset.\r\n\r\nPracticalities\r\nBring good shoes or boots, something to sit on and something to cover yourself with in case of rain. We will walk +-4 km following a path which is not accessible with a vehicle. After confirmation of payment you will receive the exact address of the meeting point by e-mail. The departure is in the municipality of Watermael-Boitsfort. The group departure is at 8.15 pm precisely, we will not wait for latecomers. The activity ends at about 11.30 pm.","performers":"Rapha\u00ebl De Cock","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/533540.html"},"de":{"name":"The Firefly Sessions","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/533540.html"},"it":{"name":"The Firefly Sessions","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/533540.html"},"sp":{"name":"The Firefly Sessions","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/533540.html"},"pt":{"name":"The Firefly Sessions","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/533540.html"},"cn":{"name":"The Firefly Sessions","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/533540.html"}},"place":{"id":266067,"translations":{"fr":{"name":"For\u00eat de Soigne","address_street_name":"Rue Nisard","address_street_number":"63","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1170","address_city":"Watermael-Boitsfort","address_line1":"Rue Nisard, 63","address_line2":"1170 Watermael-Boitsfort","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"For\u00eat de Soigne","address_street_name":"Nisardstraat","address_street_number":"63","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1170","address_city":"Watermaal-Bosvoorde","address_line1":"Nisardstraat, 63","address_line2":"1170 Watermaal-Bosvoorde","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"For\u00eat de Soigne","address_street_name":"Rue Nisard","addres