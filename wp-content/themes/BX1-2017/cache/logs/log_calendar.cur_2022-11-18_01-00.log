[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-11-15T05:05:15+01:00","published_at":"2022-11-14T16:02:19+01:00","backoffice_id":265577,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":1.2599210498949},{"id":545832,"date_start":"2022-11-23","date_end":"2022-11-23","date_next":"2022-11-23","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":90,"translations":{"fr":"Animations","nl":"Animaties","en":"Animations","de":"Animationen"}},"others":{"list":[99],"translations":{"fr":["Gastronomie"],"nl":["Gastronomie"],"en":["Gastronomy"],"de":["Gastronomie"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Dessous de table : D\u00eener chef.fe & Vigneron.ne","shortdescr":"Dessous de table : n. m. inv. D\u00eener convivial rassemblant un\u00b7e vigneron\u00b7ne et un\u00b7e chef\u00b7fe le temps d'une soir\u00e9e o\u00f9 les assiettes mettent \u00e0 l'honneur les vins et inversement.","longdescr":"On relance les d\u00eeners chef\u00b7fe \/ vigneron\u00b7ne pour une nouvelle saison et sous un nouveau nom !\r\n\r\nDessous de table : n. m. inv. D\u00eener convivial rassemblant un\u00b7e vigneron\u00b7ne et un\u00b7e chef\u00b7fe le temps d'une soir\u00e9e o\u00f9 les assiettes mettent \u00e0 l'honneur les vins et inversement.\r\n\r\nApr\u00e8s Philippe Brand, le domaine Ottomani et la c\u00e9l\u00e8bre brasserie 3 Fonteinen, direction la Bourgogne pour cette nouvelle \u00e9dition ! On invite Paul Marchand-Perarnau du domaine AMI. On explorera des terroirs prestigieux tels que la C\u00f4te de Beaune, Volnay, Saint Romain ou Maranges. Des vins d'exception travaill\u00e9s avec finesse et dans le respect du raisin.\r\n\r\nEt pendant que Paul remplira vos verres, c'est Igor de Red Mullet qui se lancera le d\u00e9fi d'accorder chaque vin avec une assiette con\u00e7ue sur mesure. Pass\u00e9 par les fourneaux de Kamo et de La Buvette, Igor propose une cuisine locale et de saison inspir\u00e9e du Japon, qui fait la part belle aux produits gr\u00e2ce \u00e0 la justesse des cuissons et la pr\u00e9cision des assaisonnements.\r\n\r\nVous prendrez place \u00e0 une grande tabl\u00e9e de 20 convives, au c\u00f4t\u00e9 du vigneron, avec vue sur une cuisine ouverte o\u00f9 le chef pr\u00e9parera les plats.\r\n\r\nOn se retrouve le mercredi 23\/11 \u00e0 partir de 19h \u00e0 la Cave St-Job pour une bulle de bienvenue avant de se rendre toustes ensemble sur le lieu du banquet, au-dessus du restaurant Le Refuge.\r\n\r\nMenu 5 services \/ 5 vins : 100\u20ac\r\n\r\n20 couverts \/ R\u00e9servation imp\u00e9rative via\r\nlacavestjob@gmail.com ou par t\u00e9l\u00e9phone 02 851 07 66","performers":"Paul Perarnau vigneron du domaine AMI\r\nRed Mullet en cuisine","boxoffice_url":null,"website":"https:\/\/www.cavesaintjob.be\/fr\/","email":"lacavestjob@gmail.com","phone_contact":null,"phone_booking":"+32 2 851 07 66","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.545832"},"nl":{"name":"Dessous de table : D\u00eener chef.fe & Vigneron.ne","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.545832"},"en":{"name":"Dessous de table : D\u00eener chef.fe & Vigneron.ne","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.545832"},"de":{"name":"Dessous de table : D\u00eener chef.fe & Vigneron.ne","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":nul