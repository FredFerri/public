se,"last_updated_at":"2024-12-13T01:02:37+01:00","published_at":"2024-11-19T10:09:34+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":311719,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"theatre","ranking":0.5897597462169347,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":49,"translations":{"de":"Theater","pt":null,"en":"Theatre","it":"Teatro","cn":null,"fr":"Th\u00e9\u00e2tre","sp":"Teatro","nl":"Theater"}},"others":{"list":[52],"translations":{"de":["Musiktheater"],"pt":[null],"en":["Musical theatre"],"it":["Teatro musicale"],"cn":[null],"fr":["Th\u00e9\u00e2tre musical"],"sp":["Teatro musical"],"nl":["Muziektheater"]}}},"translations":{"de":{"name":"Sophie au Cabaret","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/magiccabaret.be\/sophie-au-cabaret\/","email":"bienvenue@aucabaret.be","phone_contact":"+32 2 888 76 51","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700003730"},"pt":{"name":"Sophie au Cabaret","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/magiccabaret.be\/sophie-au-cabaret\/","email":"bienvenue@aucabaret.be","phone_contact":"+32 2 888 76 51","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700003730"},"en":{"name":"Sophie au Cabaret","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/magiccabaret.be\/sophie-au-cabaret\/","email":"bienvenue@aucabaret.be","phone_contact":"+32 2 888 76 51","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700003730"},"it":{"name":"Sophie au Cabaret","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/magiccabaret.be\/sophie-au-cabaret\/","email":"bienvenue@aucabaret.be","phone_contact":"+32 2 888 76 51","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700003730"},"cn":{"name":"Sophie au Cabaret","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/magiccabaret.be\/sophie-au-cabaret\/","email":"bienvenue@aucabaret.be","phone_contact":"+32 2 888 76 51","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700003730"},"fr":{"name":"Sophie au Cabaret","shortdescr":"SOPHIE au Cabaret !\nApr\u00e8s le succ\u00e8s d'Alice et Julia, Au cabaret revient avec un nouveau spectacle incroyable !\nUn spectacle pour tous les \u00e2ges, \u00e0 la Gare Maritime de Tour et Taxi, du 6 d\u00e9cembre au 12 Janvier 2025.","longdescr":"Plongez au c\u0153ur de l'atmosph\u00e8re enchanteresse des ann\u00e9es 20.\n\nUne marionnette grandeur nature avec une \u00e2me vibrante et un d\u00e9sir poignant de devenir femme.\nElle chante, danse, parle et vous emporte dans un tourbillon d'aventures captivantes, sous la protection bienveillante de son cr\u00e9ateur.\n\nPlongez au c\u0153ur de l\u2019atmosph\u00e8re enchanteresse des ann\u00e9es 1920 dans le prestigieux Magic Mirror, o\u00f9 se d\u00e9voile le spectacle \u201cSophie au Cabaret\u201d. Rencontrez Sophie, une marionnette grandeur nature anim\u00e9e par le d\u00e9sir poignant de devenir femme, elle chante, danse, parle et vous transporte dans ses aventures sous la bienveillance de son cr\u00e9ateur. Dans ce lieu f\u00e9\u00e9rique, laissez-vous \u00e9blouir par des num\u00e9ros a\u00e9riens exceptionnels, des instants d\u2019humour \u00e9tincelants, des jeux de mime, de th\u00e9\u00e2tre, de magie fascinante, de frissons et les airs envo\u00fbtants d\u2019un accord\u00e9on live. Ce spectacle unique vous promet une soir\u00e9e exceptionnelle o\u00f9 se m\u00ealent avec harmonie le fantastique et le r\u00e9tro, l\u2019humour, les \u00e9motions intenses et des moments de pur enchantement.\n\nNous ferons de notre mieux pour placer les unes \u00e0 cot\u00e9 des autres les personnes achetant leurs tickets Last Minute ensemble, mais nous ne pouvons pas le garantir \u00e0 100%.\n\n----------\n\nRel\u00e2ches tous les lundis sauf le 23\/12 et tous les mardis sauf le 31\/12.\nPas de repr\u00e9sentation les 24, 25, 30 d\u00e9cembre et 1 et 2 janvier.","performers":null,"boxoffice_url":null,"website":"https:\/\/magiccabaret.be\/sophie-au-cabaret\/","email":"bienvenue@aucabaret.be","phone_contact":"+32 2 888 76 51","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700003730"},"sp":{"name":"Sophie au Cabaret","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/magiccabaret.be\/sophie-au-cabaret\/","email":"bienvenue@aucabaret.be","phone_contact":"+32 2 888 76 51","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700003730"},"nl":{"name":"Sophie au Cabaret","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/magiccabaret.be\/sophie-au-cabaret\/","email":"bienvenue@aucabaret.be","phone_contact":"+32 2 888 76 51","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700003730"}},"place":{"id":258279,"translations":{"de":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Rue Picard","address_street_number":null,"address_street_box":null,"email":"welcome@tour-taxis.com","website":"https:\/\/www.tour-taxis.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Rue Picard","address_street_number":null,"address_street_box":null,"email":"welcome@tour-taxis.com","website":"https:\/\/www.tour-taxis.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Picardstraat","address_street_number":null,"address_street_box":null,"email":"welcome@tour-taxis.com","website":"https:\/\/www.tour-taxis.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Picardstraat","address_line2":"1000 Brussels","description_web":"The Gare Maritime - From industrial freight station to energy neutral urban jungle!\r\n\r\nIt is the perfect setting for innovative cultural events, film or photo shoots, trade shows, fairs, product launches or promotions. \r\nThe historic station concourse that was part of the Gare Maritime has been transformed into an indoor city with its own food hall (coming September 2021), exclusive shops and offices. Countless unique and inspiring areas and warm, wooden structures alternate in this building complex. It is perfectly suited to accommodate both small and major events. The monumental nave is a true architectural eye-catcher, bathed in indirect sunlight and providing ample space for well-attended indoor activities.\r\nAny event in the Gare Maritime is a green event. Sustainability has been key during the renovation works. The building generates its own energy from renewable sources, using geothermics and solar panels. The green boulevards on either side of the nave are lined with themed gardens and tall trees, as if the adjacent park found its way inside. \r\nThe Gare Maritime is a unique place - attractive, innovative and ambitious.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Rue Picard","address_street_number":null,"address_street_box":null,"email":"welcome@tour-taxis.com","website":"https:\/\/www.tour-taxis.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Rue Picard","address_street_number":null,"address_street_box":null,"email":"welcome@tour-taxis.com","website":"https:\/\/www.tour-taxis.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Rue Picard","address_street_number":null,"address_street_box":null,"email":"welcome@tour-taxis.com","website":"https:\/\/www.tour-taxis.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard","address_line2":"1000 Bruxelles","description_web":"Der Gare Maritime: Vom ehemaligen G\u00fcterbahnhof zum energieneutralen Urban Jungle!\n\nDer Gare Maritime bietet die ideale Kulisse f\u00fcr Kulturveranstaltungen, Dreharbeiten und Fotosessions, M\u00e4rkte und Messen, Produkt-Launches und Promotion Events. Die Hallen des Gare Maritime wurden in eine Art Stadt in der Stadt umgewandelt, dazu z\u00e4hlen eine eigene Food Hall, exklusive Gesch\u00e4fte und B\u00fcros. Die R\u00e4umlichkeiten mit vielen Holzakzenten eignen sich sowohl f\u00fcr Treffen im kleinen Kreis als auch f\u00fcr gro\u00dfe Happenings. Die architektonisch spektakul\u00e4re zentrale Halle wird von indirektem Tageslicht durchflutet und bietet ausreichend Platz f\u00fcr gr\u00f6\u00dfere Veranstaltungen Innenbereich, wobei Nachhaltigkeit und Umweltfreundlichkeit stets im Vordergrund stehen, denn bei den Renovierungsarbeiten wurde ein besonderes Augenmerk auf diese beiden Kriterien gelegt. Anhand von Geothermie und Photovoltaikanlagen wird direkt vor Ort erneuerbare Energie Ort erzeugt. Entlang der gr\u00fcnen Promenaden, die das Mittelschiff s\u00e4umen, wurden Themeng\u00e4rten und B\u00e4ume gepflanzt, die einen flie\u00dfenden \u00dcbergang  zu dem nahegelegenen Park bilden. \nDer Gare Maritime \u00fcberzeugt als attraktive, innovative und ambitionierte Location.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Rue Picard","address_street_number":null,"address_street_box":null,"email":"welcome@tour-taxis.com","website":"https:\/\/www.tour-taxis.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Picardstraat","address_street_number":null,"address_street_box":null,"email":"welcome@tour-taxis.com","website":"https:\/\/www.tour-taxis.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Picardstraat","address_line2":"1000 Brussel","description_web":"Gare Maritime: van industrieel goederenstation tot energieneutrale urban jungle!\r\n\r\nDe Gare Maritime is de perfecte setting voor innovatieve, culturele evenementen, film- en fotoshoots, markten, beurzen, lanceringen en promoties. De historische stationshallen van de Gare Maritime zijn omgevormd tot overdekte stad, met foodhall (vanaf september 2021), exclusieve winkels en kantoren. Het gebouwencomplex biedt een waaier aan unieke, inspirerende ruimtes afgewisseld met warme houten volumes: perfect voor de organisatie van kleine en grootschalige happenings. D\u00e9 architecturale eyecatcher is de monumentale middenbeuk die baadt in indirect daglicht en over meer dan voldoende ruimte beschikt voor overdekte activiteiten met veel bezoekers.\r\nEen event in de Gare Maritime is een groen event. Tijdens de renovatie van het gebouw was duurzaamheid een speerpunt. Energie wordt ter plaatse hernieuwbaar opgewekt met geothermie en zonnepanelen. De groene wandelboulevards aan weerszijden van de middenbeuk zijn voorzien van thematuinen en hoogstammige bomen, alsof het aangrenzende park het gebouw binnenstroomt. Gare Maritime is een unieke plek: aantrekkelijk, vernieuwend en ambitieus.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[8],"translations":{"de":["Kanal-Viertel"],"pt":[null],"en":["Canal"],"it":["Canal"],"cn":[null],"fr":["Canal"],"sp":["Canal"],"nl":["Kanaalwijk"]}},"zones":{"list":[20],"translations":{"de":["Norden"],"pt":[null],"en":["North"],"it":["Nord"],"cn":[null],"fr":["Nord"],"sp":["Norte"],"nl":["Noord"]}},"neca":null,"facebook_id":null,"backoffice_id":18279,"location":{"lat":50.8642401,"lon":4.3434934},"region":"brussels","last_updated_at":"2024-07-30T15:05:56+02:00","published_at":"2014-05-14T12:03:05+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":50002631,"translations":{"de":{"name":"Le Magic Cabaret","address_street_name":"Rue Picard","address_street_number":"13","address_street_box":null,"email":"bienvenue@aucabaret.be","website":"http:\/\/magiccabaret.be","phone_contact":"+32 2 888 76 51","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard, 13","address_line2":"1000 Bruxelles","description_web":null,"d