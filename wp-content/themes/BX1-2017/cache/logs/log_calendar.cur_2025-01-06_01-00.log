":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2025-01-05T01:01:17+01:00","published_at":"2024-11-12T15:45:04+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":311386,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"other","ranking":0.41008825631569273,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{}},"translations":{"de":{"name":"Jean Roba. R\u00e9trospective Boule et Bill","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/hubertybreyne.com\/fr\/expositions\/presentation\/864\/retrospective-boule-et-bill","email":"contact@hubertybreyne.com","phone_contact":"+32 2 893 90 30","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700003574"},"pt":{"name":"Jean Roba. R\u00e9trospective Boule et Bill","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/hubertybreyne.com\/fr\/expositions\/presentation\/864\/retrospective-boule-et-bill","email":"contact@hubertybreyne.com","phone_contact":"+32 2 893 90 30","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700003574"},"en":{"name":"Jean Roba. Boule et Bill retrospective","shortdescr":"Jean Roba, the renowned Belgian comic book artist, will be honored in a non-commercial exhibition at the Huberty & Breyne gallery (Brussels) from November 29, 2024, to January 25, 2025. This retrospective of Boule and Bill, organized in collaboration with the Roba Foundation and Dargaud Publishing, brings together nearly 100 original plates that have never been shown to the public before.","longdescr":"Jean Roba, the renowned Belgian comic book artist, will be honored in a non-commercial exhibition at the Huberty & Breyne gallery (Brussels) from November 29, 2024, to January 25, 2025. This retrospective of Boule and Bill, organized in collaboration with the Roba Foundation and Dargaud Publishing, brings together nearly 100 original plates that have never been shown to the public before.\n\nThis successful comic first appeared in the magazine Spirou in 1959. Soon, the little boy Boule and his dog Bill won the hearts of readers. The simplicity and warmth of the family, along with the repeated gags of our two heroes, immediately captured the audience\u2019s attention. For more than forty years, Jean Roba provided moments of lightness and joy with his quirky and endearing characters.\n\nSince his passing in 2006, his 1,149 original plates have been protected in the Roba Foundation, in accordance with his wishes. His work, full of humor and simplicity, is a true treasure of Belgian comics and is now being returned to the public through this free exhibition. This is a unique opportunity to rediscover these iconic characters who have captivated so many children in their youth.","performers":null,"boxoffice_url":null,"website":"https:\/\/hubertybreyne.com\/fr\/expositions\/presentation\/864\/retrospective-boule-et-bill","email":"contact@hubertybreyne.com","phone_contact":"+32 2 893 90 30","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700003574"},"it":{"name":"Jean Roba. R\u00e9trospective Boule et Bill","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/hubertybreyne.com\/fr\/expositions\/presentation\/864\/retrospective-boule-et-bill","email":"contact@hubertybreyne.com","phone_contact":"+32 2 893 90 30","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700003574"},"cn":{"name":"Jean Roba. R\u00e9trospective Boule et Bill","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/hubertybreyne.com\/fr\/expositions\/presentation\/864\/retrospective-boule-et-bill","email":"contact@hubertybreyne.com","phone_contact":"+32 2 893 90 30","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700003574"},"fr":{"name":"Jean Roba. R\u00e9trospective Boule et Bill","shortdescr":"Jean Roba, c\u00e9l\u00e8bre auteur belge de bande dessin\u00e9e, est mis \u00e0 l\u2019honneur dans une exposition non marchande organis\u00e9e \u00e0 la galerie Huberty & Breyne (Bruxelles) du 29 novembre 2024 au 25 janvier 2025. Cette exposition r\u00e9trospective Boule et Bill, organis\u00e9e en collaboration avec la fondation Roba et les \u00e9ditions Dargaud, regroupe pr\u00e8s de 100 planches originales jamais pr\u00e9sent\u00e9es au public.","longdescr":"Jean Roba, c\u00e9l\u00e8bre auteur belge de bande dessin\u00e9e, est mis \u00e0 l\u2019honneur dans une exposition non marchande organis\u00e9e \u00e0 la galerie Huberty & Breyne (Bruxelles) du 29 novembre 2024 au 25 janvier 2025. Cette exposition r\u00e9trospective Boule et Bill, organis\u00e9e en collaboration avec la fondation Roba et les \u00e9ditions Dargaud, regroupe pr\u00e8s de 100 planches originales jamais pr\u00e9sent\u00e9es au public.\nCette bande dessin\u00e9e \u00e0 succ\u00e8s appara\u00eet pour la premi\u00e8re fois dans le magazine Spirou en 1959. Tr\u00e8s vite, le petit gar\u00e7on Boule et le chien Bill se sont invit\u00e9s dans nos foyers. La simplicit\u00e9 et la sympathie de la famille ainsi que les gags r\u00e9p\u00e9t\u00e9s de nos deux h\u00e9ros ont tout de suite conquis le public. Pendant plus de quarante ans, Jean Roba a permis aux lecteurs de vivre des moments de l\u00e9g\u00e8ret\u00e9 et de rire gr\u00e2ce \u00e0 ses personnages loufoques et attachants.\nDepuis son d\u00e9c\u00e8s en 2006, ses 1149 planches originales sont prot\u00e9g\u00e9es dans la fondation Roba, conform\u00e9ment \u00e0 ses souhaits. V\u00e9ritable tr\u00e9sor de la bande dessin\u00e9e belge, son \u0153uvre pleine d\u2019humour et de candeur est rendue au public gr\u00e2ce \u00e0 cette exposition-\u00e9v\u00e9nement gratuite. Une occasion unique de red\u00e9couvrir ces c\u00e9l\u00e8bres personnages qui ont berc\u00e9 bien des enfances.","performers":null,"boxoffice_url":null,"website":"https:\/\/hubertybreyne.com\/fr\/expositions\/presentation\/864\/retrospective-boule-et-bill","email":"contact@hubertybreyne.com","phone_contact":"+32 2 893 90 30","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700003574"},"sp":{"name":"Jean Roba. R\u00e9trospective Boule et Bill","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/hubertybreyne.com\/fr\/expositions\/presentation\/864\/retrospective-boule-et-bill","email":"contact@hubertybreyne.com","phone_contact":"+32 2 893 90 30","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700003574"},"nl":{"name":"Jean Roba. Retrospectief Bollie en Billie","shortdescr":"Jean Roba, de beroemde Belgische striptekenaar, wordt van 29 november 2024 tot 25 januari 2025 ge\u00eberd in een niet-commerci\u00eble tentoonstelling in de galerie Huberty & Breyne (Brussel). Deze retrospectieve van Bollie en Billie, georganiseerd in samenwerking met de stichting Roba en de uitgeverij Dargaud, brengt bijna 100 originele platen samen die nog nooit eerder aan het publiek zijn getoond.","longdescr":"Jean Roba, de beroemde Belgische striptekenaar, wordt van 29 november 2024 tot 25 januari 2025 ge\u00eberd in een niet-commerci\u00eble tentoonstelling in de galerie Huberty & Breyne (Brussel). Deze retrospectieve van Bollie en Billie, georganiseerd in samenwerking met de stichting Roba en de uitgeverij Dargaud, brengt bijna 100 originele platen samen die nog nooit eerder aan het publiek zijn getoond.\n\nDit succesvolle stripverhaal verscheen voor het eerst in het tijdschrift Robbedoes in 1959. Al snel veroverden het jongetje Bollie en de hond Billie de harten van de lezers. De eenvoud en de sympathie van de familie, samen met de herhaalde grappen van onze twee helden, wonnen onmiddellijk de aandacht van het publiek. Meer dan veertig jaar lang zorgde Jean Roba voor momenten van lichtheid en vreugde met zijn gekke en charmante personages.\n\nSinds zijn overlijden in 2006 worden zijn 1.149 originele platen beschermd in de stichting Roba, in overeenstemming met zijn wensen. Zijn werk, vol humor en eenvoud, is een ware schat van de Belgische stripverhalen en wordt nu teruggegeven aan het publiek met deze gratis tentoonstelling. Dit is een unieke kans om deze iconische personages te herontdekken die zoveel kinderen in hun kindertijd hebben geboeid.","performers":null,"boxoffice_url":null,"website":"https:\/\/hubertybreyne.com\/fr\/expositions\/presentation\/864\/retrospective-boule-et-bill","email":"contact@hubertybreyne.com","phone_contact":"+32 2 893 90 30","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700003574"}},"place":{"id":267549,"translations":{"de":{"name":"Huberty & Breyne Gallery","address_street_name":"Place du Ch\u00e2telain","address_street_number":"33","address_street_box":null,"email":"contact@hubertybreyne.com","website":"http:\/\/www.hubertybreyne.com","phone_contact":"+32 2 893 90 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Place du Ch\u00e2telain, 33","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Huberty & Breyne Gallery","address_street_name":"Place du Ch\u00e2telain","address_street_number":"33","address_street_box":null,"email":"contact@hubertybreyne.com","website":"http:\/\/www.hubertybreyne.com","phone_contact":"+32 2 893 90 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Place du Ch\u00e2telain, 33","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Huberty & Breyne Gallery","address_street_name":"Place du Ch\u00e2telain","address_street_number":"33","address_street_box":null,"email":"contact@hubertybreyne.com","website":"http:\/\/www.hubertybreyne.com","phone_contact":"+32 2 893 90 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Place du Ch\u00e2telain, 33","address_line2":"1050 Ixelles","description_web":"Alain Huberty and Marc Breyne are opening a new 1000 square meters exhibition space in Brussels entirely dedicated to the 9th art. After having brought Comic Strip to the Sablon, mecca to the art dealers and collectors, the gallery becomes now established in Ch\u00e2telain square, one of the most dynamic areas of Ixelles.\r\nThis new stage is part of an evolution, wich will make possible for the artists to exhibit into a space that will fullfil their talent and initiate new projects. Alain Huberty and Marc Breyne aim at bridging the gap between 9th Art and Contemporary Art, therefore they will welcome different events : Solo Shows, collective exhibitions, album launches,\r\nperformances, artists residences\u2026","description_print":"Alain Huberty and Marc Breyne are opening a new 1000 square meters exhibition space in Brussels entirely dedicated to the 9th art. After having brought Comic Strip to the Sablon, mecca to the art dealers and collectors, the gallery becomes now established in Ch\u00e2telain square, one of the most dynamic areas of Ixelles.\r\nThis new stage is part of an evolution, wich will make possible for the artists to exhibit into a space that will fullfil their talent and initiate new projects. Alain Huberty and Marc Breyne aim at bridging the gap between 9th Art and Contemporary Art, therefore they will welcome different events : Solo Shows, collective exhibitions, album launches,\r\nperformances, artists residences\u2026","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Huberty & Breyne Gallery","address_street_name":"Place du Ch\u00e2telain","address_street_number":"33","address_street_box":null,"email":"contact@hubertybreyne.com","website":"http:\/\/www.hubertybreyne.com","phone_contact":"+32 2 893 90 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Place du Ch\u00e2telain, 33","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Huberty & Breyne Gallery","address_street_name":"Place du Ch\u00e2telain","address_street_number":"33","address_street_box":null,"email":"contact@hubertybreyne.com","website":"http:\/\/www.hubertybreyne.com","phone_contact":"+32 2 893 90 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Place du Ch\u00e2telain, 33","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Huberty & Breyne Gallery","address_street_name":"Place du Ch\u00e2telain","address_street_number":"33","address_street_box":null,"email":"contact@hubertybreyne.com","website":"http:\/\/www.hubertybreyne.com","phone_contact":"+32 2 893 90 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Place du Ch\u00e2telain, 33","address_line2":"1050 Ixelles","description_web":"Nouvel espace de 1 000 m2 enti\u00e8rement consacr\u00e9 au 9e Art. Apr\u00e8s avoir cr\u00e9\u00e9 une passerelle entre 9e Art et Art Contemporain, Alain Huberty et Marc Breyne accueilleront en leurs murs diff\u00e9rentes manifestations : Solo Shows, expositions\r\ncollectives, lancements d\u2019albums, performances ou encore r\u00e9sidences d\u2019artistes\u2026","description_print":"Alain Huberty et Marc Breyne inaugurent \u00e0 Bruxelles un nouvel espace de 1 000 m2\r\nenti\u00e8rement consacr\u00e9 au 9e Art. Apr\u00e8s avoir fait entrer la Bande Dessin\u00e9e au Sablon, haut lieu des marchands d\u2019art et des antiquaires, la galerie s\u2019implante aujourd\u2019hui Place du Ch\u00e2telain, l\u2019un des quartiers les plus dynamiques d\u2019Ixelles. Cette nouvelle \u00e9tape marque une \u00e9volution, celle de pouvoir proposer aux artistes un endroit \u00e0 la dimension de leur talent et d\u2019initier de nouveaux projets. Apr\u00e8s avoir cr\u00e9\u00e9 une passerelle entre 9e Art et Art Contemporain, Alain Huberty et Marc Breyne accueilleront en leurs murs diff\u00e9rentes manifestations : Solo Shows, expositions\r\ncollectives, lancements d\u2019albums, performances ou encore r\u00e9sidences d\u2019artistes\u2026","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Huberty & Breyne Gallery","address_street_name":"Place du Ch\u00e2telain","address_street_number":"33","address_street_box":null,"email":"contact@hubertybreyne.com","website":"http:\/\/www.hubertybreyne.com","phone_contact":"+32 2 893 90 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Place du Ch\u00e2telain, 33","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Huberty & Breyne Gallery","address_street_name":"Kasteleinsplein","address_street_number":"33","address_street_box":null,"email":"contact@hubertybreyne.com","website":"http:\/\/www.hubertybreyne.com","phone_contact":"+32 2 893 90 30","phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"Kasteleinsplein, 33","address_line2":"1050 Elsene","description_web":"Alain Huberty en Marc Breyne openen in het hart van de Europese hoofdstad een nieuwe tentoonstellingsruimte van 1 000m2, helemaal gewijd aan de negende kunst. Nadat ze de voorbije jaren het beeldverhaal op de Brusselse Zavel introduceerden, het kloppend hart van de Brusselse kunst- en antiekhandel, vindt de galerij van Huberty en Breyne voortaan onderdak aan het Kasteleinsplein, in een van de meest dynamische wijken van Elsene. De twee galerijhouders willen de artiesten waar ze mee werken een nog betere plaats aanbieden, die past bij de dimensie en de allures van hun werk, en die hen in staat stelt nieuwe projecten te initi\u00ebren. In Elsene denken ze die plaats gevonden te hebben. Een brug slaan tussen de strip en de hedendaagse kunst blijft een belangrijke betrachting, en in Elsene zullen onder meer solo-exposities, groepstentoonstellingen, veilingen, albumlanceringen en optredens plaatsvinden. Kunstenaars kunnen er ook in residentie gaan.","description_print":"Alain Huberty en Marc Breyne openen in het hart van de Europese hoofdstad een nieuwe tentoonstellingsruimte van 1 000m2, helemaal gewijd aan de negende kunst. Nadat ze de voorbije jaren het beeldverhaal op de Brusselse Zavel introduceerden, het kloppend hart van de Brusselse kunst- en antiekhandel, vindt de galerij van Huberty en Breyne voortaan onderdak aan het Kasteleinsplein, in een van de meest dynamische wijken van Elsene. De twee galerijhouders willen de artiesten waar ze mee werken een nog betere plaats aanbieden, die past bij de dimensie en de allures van hun werk, en die hen in staat stelt nieuwe projecten te initi\u00ebren. In Elsene denken ze die plaats gevonden te hebben. Een brug slaan tussen de strip en de hedendaagse kunst blijft een belangrijke betrachting, en in Elsene zullen onder meer solo-exposities, groepstentoonstellingen, veilingen, albumlanceringen en optredens plaatsvinden. Kunstenaars kunnen er ook in residentie gaan.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[6],"translations":{"de":["Chatelain\/Bailli"],"pt":[null],"en":["Chatelain\/Bailli"],"it":["Chatelain\/Bailli"],"cn":[null],"fr":["Chatelain\/Bailli"],"sp":["Ch\u00e2telain\/Bailli"],"nl":["Kasteleinswijk\/Baljuw"]}},"zones":{"list":[21],"translations":{"de":["S\u00fcden"],"pt":[null],"en":["South"],"it":["Sud"],"cn":[null],"fr":["Sud"],"sp":["Sur"],"nl":["Zuid"]}},"neca":null,"facebook_id":null,"backoffice_id":27549,"location":{"lat":50.82437346,"lon":4.36056093},"region":"brussels","last_updated_at":"2022-10-10T10:25:09+02:00","published_at":"2017-04-10T16:26:24+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":false,"resto_ranking":0},"organizer":{"id":242496,"translations":{"de":{"name":"PR Caracas","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"PR Caracas","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"PR Caracas","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"PR Caracas","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"PR Caracas","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"PR Caracas","address_line2":"1000 Brussels","description_web":null,"description_print":null,"booking_url