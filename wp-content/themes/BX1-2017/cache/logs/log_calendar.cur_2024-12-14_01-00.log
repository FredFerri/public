00e0 11 ans! Ils seront pris en charge par des animateurs qui dirigeront des ateliers artistiques et culinaires en langue anglaise. L'atelier pour enfants \u00e0 lieu \u00e0 quelques m\u00e8tres du th\u00e9\u00e2tre \u00e0 l'\u00e9cole Tutti Frutti de 15h45 \u00e0 17h45.","performers":"Ecrit et mis en sc\u00e8ne par Carole Ventura  ","boxoffice_url":null,"website":"https:\/\/www.theatrecreanova.be\/programmation\/","email":"adm@theatrecreanova.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700000233"},"sp":{"name":"Pousser les murs","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrecreanova.be\/programmation\/","email":"adm@theatrecreanova.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700000233"},"nl":{"name":"Pousser les murs","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrecreanova.be\/programmation\/","email":"adm@theatrecreanova.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700000233"}},"place":{"id":275475,"translations":{"de":{"name":"Th\u00e9\u00e2tre CreaNova","address_street_name":"rue de la victoire ","address_street_number":"96","address_street_box":"1060","email":"adm@theatrecreanova.be","website":"http:\/\/theatrecreanova.be","phone_contact":"+32 490 25 97 76","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"rue de la victoire , 96 \/ 1060","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Th\u00e9\u00e2tre CreaNova","address_street_name":"rue de la victoire ","address_street_number":"96","address_street_box":"1060","email":"adm@theatrecreanova.be","website"