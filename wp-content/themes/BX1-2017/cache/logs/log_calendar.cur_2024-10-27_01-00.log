ext":"2024-10-26","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-10-26T03:01:12+02:00","published_at":"2024-07-02T10:49:06+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":303372,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.3375531905895819,"languages":{"spoken":["en","nl","fr"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[34,24],"translations":{"de":["Multidisziplin\u00e4r","Kunstgalerien"],"pt":[null,null],"en":["Multidisciplinary","Art Galleries"],"it":["Multidisciplinare","Gallerie d'arte"],"cn":[null,null],"fr":["Pluridisciplinaire","Galeries d'art"],"sp":["Multidisciplinar","Galer\u00edas de arte"],"nl":["Pluridisciplinair","Galeries"]}}},"translations":{"de":{"name":"Tinka Pittoors - 'Marsyas and Me'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.galerielaforestdivonne.com\/fr\/accueil\/","email":"brussels@galerielaforestdivonne.com","phone_contact":"+32 2 544 16 73","phone_booking":"+32 2 544 16 73","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50012082"},"pt":{"name":"Tinka Pittoors - 'Marsyas and Me'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.galerielaforestdivonne.com\/fr\/accueil\/","email":"brussels@galerielaforestdivonne.com","phone_contact":"+32 2 544 16 73","phone_booking":"+32 2 544 16 73","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50012082"},"en":{"name":"Tinka Pittoors - 'Marsyas and Me'","shortdescr":"Galerie La Forest Divonne Bruxelles is delighted to present Marsyas and me, a solo exhibition by Antwerp-based sculptor Tinka Pittoors from September 12 to November 2, 2024.","longdescr":"Galerie La Forest Divonne Bruxelles is delighted to present Marsyas and me, a solo exhibition by Tinka Pittoors from September 12 to November 2, 2024. For this second exhibition under the gallery's Art Deco glass roof, the Antwerp-based sculptor will unveil new glazed ceramic sculptures with intriguing, organic forms inspired by the myth of Marsyas.\n\nThe myth of Marsyas is an ancient tale of pride between Apollo, the celestial god, and Marsyas, a satyr with the chest of a man and the feet of a goat. Marsyas, full of arrogance, claims he can challenge the god of Music to a duel to determine who plays the most beautiful melody. But Apollo is victorious and decides to punish the satyr by flaying him alive, then nailing his skin to a tree.\n\nThis exhibition follows Daphne and me, presented at the gallery in 2019. In that exhibition, the Antwerp-based artist explored the mythological character of Daphne, who transforms herself into a laurel tree in order to escape the pursuit of Apollo. Pittoors, once again, draws inspiration from a founding myth that develops two powerful, contradictory themes: one whereby the artist escapes his mortal condition through creative inspiration and the quest for beauty, the other whereby he identifies with ephemeral, fragile nature, through his body and sensibility. Marsyas is punished for trying to equal Apollo through music, and ends up chained to a tested Nature to which his destiny is inextricably linked.\n\nMarsyas and me is part of RENDEZ-VOUS, the new Brussels Gallery Weekend running from September 12 to 15, including Sunday.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.galerielaforestdivonne.com\/fr\/accueil\/","email":"brussels@galerielaforestdivonne.com","phone_contact":"+32 2 544 16 73","phone_booking":"+32 2 544 16 73","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50012082"},"it":{"name":"Tinka Pittoors - 'Marsyas and Me'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.galerielaforestdivonne.com\/fr\/accueil\/","email":"brussels@galerielaforestdivonne.com","phone_contact":"+32 2 544 16 73","phone_booking":"+32 2 544 16 73","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50012082"},"cn":{"name":"Tinka Pittoors - 'Marsyas and Me'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.galerielaforestdivonne.com\/fr\/accueil\/","email":"brussels@galerielaforestdivonne.com","phone_contact":"+32 2 544 16 73","phone_booking":"+32 2 544 16 73","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50012082"},"fr":{"name":"Tinka Pittoors - 'Marsyas and Me'","shortdescr":"La Galerie La Forest Divonne Bruxelles est heureuse de pr\u00e9senter Marsyas and me, une exposition personnelle de Tinka Pittoors, une sculptrice anversoise du 12 septembre au 2 novembre 2024.","longdescr":"La Galerie La Forest Divonne Bruxelles est heureuse de pr\u00e9senter Marsyas and me, une exposition personnelle de Tinka Pittoors du 12 septembre au 2 novembre 2024. Pour cette seconde exposition sous la verri\u00e8re Art D\u00e9co de la galerie, la sculptrice anversoise d\u00e9voilera de nouvelles sculptures en c\u00e9ramique \u00e9maill\u00e9e aux formes organiques et intrigantes inspir\u00e9es du mythe de Marsyas.\n\nLe mythe de Marsyas est une antique histoire d'orgueil entre Apollon, le dieu c\u00e9leste, et Marsyas, un satyre \u00e0 la poitrine d'homme et aux pieds de ch\u00e8vre. Marsyas, plein d'arrogance, pr\u00e9tend pouvoir d\u00e9fier le dieu de la Musique en duel pour d\u00e9terminer qui joue la plus belle m\u00e9lodie. Mais Apollon est victorieux et d\u00e9cide de punir le satyre en l'\u00e9corchant vif, puis en clouant sa peau \u00e0 un arbre.\n\nCette exposition s'inscrit \u00e0 la suite de l'exposition\u00a0 Daphn\u00e9 and me pr\u00e9sent\u00e9e en 2019 \u00e0 la galerie. L'artiste anversoise y explorait le personnage mythologique de Daphn\u00e9e, qui se transforme en laurier afin d'\u00e9chapper \u00e0 Apollon qui la poursuit. Pittoors, puise \u00e0 nouveau son inspiration dans un mythe fondateur qui d\u00e9veloppe deux th\u00e9matiques puissantes et contradictoires : l'une par laquelle l'artiste \u00e9chappe \u00e0 sa condition de mortel par l'inspiration cr\u00e9atrice et la recherche de la beaut\u00e9, l'autre par laquelle il s'identifie \u00e0 la nature \u00e9ph\u00e9m\u00e8re et fragile, au travers de son corps et sa sensibilit\u00e9. Marsyas est puni pour avoir tent\u00e9 d'\u00e9galer Apollon au travers de la musique et fini enchain\u00e9 \u00e0 une Nature \u00e9prouv\u00e9e \u00e0 laquelle son destin est indissociablement li\u00e9.\n\nL'exposition Marsyas and me\u00a0s'inscrit dans le parcours du RENDEZ-VOUS, le nouveau Brussels Gallery Weekend qui se d\u00e9roulera du 12 au 15 septembre, dimanche inclus.","performers":"Tinka Pittoors","boxoffice_url":null,"website":"https:\/\/www.galerielaforestdivonne.com\/fr\/accueil\/","email":"brussels@galerielaforestdivonne.com","phone_contact":"+32 2 544 16 73","phone_booking":"+32 2 544 16 73","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50012082"},"sp":{"name":"Tinka Pittoors - 'Marsyas and Me'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.galerielaforestdivonne.com\/fr\/accueil\/","email":"brussels@galerielaforestdivonne.com","phone_contact":"+32 2 544 16 73","phone_booking":"+32 2 544 16 73","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50012082"},"nl":{"name":"Tinka Pittoors - 'Marsyas and Me'","shortdescr":"Galerie La Forest Divonne Bruxelles is verheugd Marsyas and me te presenteren, een solotentoonstelling van de Antwerpse beeldhouwer Tinka Pittoors van 12 september tot 2 november 2024.","longdescr":"Galerie La Forest Divonne Bruxelles is verheugd Marsyas and me te presenteren, een solotentoonstelling van Tinka Pittoors van 12 september tot 2 november 2024. In deze tweede tentoonstelling onder het glazen Art Deco dak van de galerie onthult de Antwerpse beeldhouwster nieuwe geglazuurde keramische sculpturen in intrigerende, organische vormen ge\u00efnspireerd op de mythe van Marsyas.\n\nDe mythe van Marsyas is een oud verhaal over hoogmoed tussen Apollo, de hemelgod, en Marsyas, een sater met de borst van een man en de voeten van een geit. Marsyas, vol arrogantie, beweert dat hij de god van de muziek kan uitdagen tot een duel om te zien wie de mooiste melodie kan spelen. Maar Apollo zegeviert en besluit de sater te straffen door hem levend te villen en vervolgens zijn huid aan een boom te nagelen.\n\nDeze tentoonstelling volgt op Daphne and me, die in 2019 in de galerie werd gepresenteerd. In die tentoonstelling verkende de Antwerpse kunstenares het mythologische personage van Daphne, die zichzelf in een laurierboom verandert om te ontsnappen aan Apollo, die haar achtervolgt. Pittoors laat zich opnieuw inspireren door een stichtingsmythe die twee krachtige en tegenstrijdige thema's ontwikkelt: enerzijds ontsnapt de kunstenaar aan zijn sterfelijke toestand door middel van creatieve inspiratie en de zoektocht naar schoonheid, anderzijds identificeert hij zich met de natuur, die vergankelijk en kwetsbaar is, door middel van zijn lichaam en zijn gevoeligheid. Marsyas wordt gestraft omdat hij Apollo probeert te evenaren door middel van muziek, en eindigt geketend aan een beproefde Natuur waarmee zijn lot onlosmakelijk is verbonden.\n\nMarsyas and me maakt deel uit van RENDEZ-VOUS, het nieuwe Brussels Gallery Weekend, dat loopt van 12 tot 15 september, inclusief zondag.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.galerielaforestdivonne.com\/fr\/accueil\/","email":"brussels@galerielaforestdivonne.com","phone_contact":"+32 2 544 16 73","phone_booking":"+32 2 544 16 73","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50012082"}},"place":{"id":266540,"translations":{"de":{"name":"Galerie La Forest Divonne","address_street_name":"Rue H\u00f4tel des Monnaies","address_street_number":"66","address_street_box":null,"email":"brussels@galerielaforestdivonne.com","website":"http:\/\/www.galerielaforestdivonne.com","phone_contact":"+ 32 (0) 25 44 16 73","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue H\u00f4tel des Monnaies, 66","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Galerie La Forest Divonne","address_street_name":"Rue H\u00f4tel des Monnaies","address_street_number":"66","address_street_box":null,"email":"brussels@galerielaforestdivonne.com","website":"http:\/\/www.galerielaforestdivonne.com","phone_contact":"+ 32 (0) 25 44 16 73","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue H\u00f4tel des Monnaies, 66","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Galerie La Forest Divonne","address_street_name":"rue de l'H\u00f4tel des Monnaies","address_street_number":"66","address_street_box":null,"email":"brussels@galerielaforestdivonne.com","website":"https:\/\/www.galerielaforestdivonne.com\/en\/home\/","phone_contact":"+ 32 (0)25 44 16 73","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"rue de l'H\u00f4tel des Monnaies, 66","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null