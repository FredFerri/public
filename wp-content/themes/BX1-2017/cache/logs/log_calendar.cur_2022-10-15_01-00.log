e0 v\u00e9lo par Vanelo","copyright":null},"nl":{"title":"Balade \u00e0 v\u00e9lo par Vanelo","copyright":null},"en":{"title":"Balade \u00e0 v\u00e9lo par Vanelo","copyright":null}}}],"dates":[{"day":"2022-10-16","doors":null,"start":"11:00:00","end":"17:00:00","is_soldout":false,"is_canceled":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[10,11],"translations":{"fr":["Seniors","Famille"],"nl":["Senioren","Familie"],"en":["Seniors","Family"]}},"tags":["kids"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-11T05:05:57+02:00","published_at":"2022-10-03T14:58:47+02:00","backoffice_id":262968,"import_origin":null,"sub_type":"misc","show_in_agenda":true,"ranking":1.2599210498949},{"id":531290,"date_start":"2022-10-16","date_end":"2022-10-16","date_next":"2022-10-16","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen"}},"others":{"list":[109],"translations":{"fr":["Espaces verts"],"nl":["Groene zones"],"en":["Green spaces"],"de":["Gr\u00fcnfl\u00e4chen"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"La for\u00eat de Soignes : toute une histoire !","shortdescr":"La for\u00eat de Soignes vous d\u00e9voile ses myst\u00e8res.","longdescr":"A seulement 4 km du centre-ville, la for\u00eat de Soignes s\u2019\u00e9tend sur 45 km\u00b2 aux portes de Bruxelles. Sautez en selle et partez \u00e0 la d\u00e9couverte de ce v\u00e9ritable poumon vert, class\u00e9 au patrimoine mondial de l\u2019UNESCO depuis 2017. Suivez le guide \u00e0 la recherche des lieux-dits et monuments qui pars\u00e8ment la for\u00eat