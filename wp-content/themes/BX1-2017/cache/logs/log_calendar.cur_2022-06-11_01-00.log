ps:\/\/agendabrussels.imgix.net\/993b6bb1ec7bc5e95398fed68a4923647c98e38e.jpg","width":1500,"height":1001,"ratio":1.5,"translations":{"fr":{"title":"Sur les traces de Lamoral, comte d'Egmont, & Philippe de Montmorency, comte de Hornes","copyright":"Place du petit sablon Jean Paul Remy"},"nl":{"title":"Sur les traces de Lamoral, comte d'Egmont, & Philippe de Montmorency, comte de Hornes","copyright":"Place du petit sablon Jean Paul Remy"},"en":{"title":"Sur les traces de Lamoral, comte d'Egmont, & Philippe de Montmorency, comte de Hornes","copyright":"Place du petit sablon Jean Paul Remy"}}}],"dates":[],"weekschema":[{"days":{"monday":{"is_open":false},"tuesday":{"is_open":false},"wednesday":{"is_open":false},"thursday":{"is_open":false},"friday":{"is_open":false},"saturday":{"is_open":false},"sunday":{"is_open":false}},"translations":{"fr":["lundi, mardi, mercredi, jeudi, vendredi, samedi et dimanche: ferm\u00e9"],"nl":["maandag, dinsdag, woensdag, donderdag, vrijdag, zaterdag en zondag: gesloten"],"en":["monday, tuesday, wednesday, thursday, friday, saturday and sunday: closed"]},"date_start":"2022-06-18","date_end":"2022-07-10","is_also_by_appointment":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":160}],"child_events":[],"parent_events":[532743],"targets":{"list":[],"translations":{}},"visit_profile":{"list":[320],"translations":{"fr":["Classique"],"nl":["Klassiek"],"en":["Classic"]}},"visit_content":{"list":[428],"values":["brussels-renaissance-festival"]},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-05-12T10:05:04+02:00","published_at":"2022-04-29T10:02:44+02:00","backoffice_id":252814,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.35163388691696},{"id":532751,"date_start":"2022-06-18","date_end":"2022-07-10","date_next":"2022-07-10","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Us et coutumes de la Renaissance: focus sur la Maison du Roi","shortdescr":null,"longdescr":"Il \u00e9tait une fois une halle au pain qui devenue Maison du Roi s'est m\u00e9tamorphos\u00e9e en mus\u00e9e. Une fa\u00e7ade de dentelles cache des secrets d'architecture, des symboles de l'histoire de la ville, de la pr\u00e9sence ducale. \u00c0 l'int\u00e9rieur, des maquettes, des statues en bronze, en bois, des vieilles pierres, des retables, des peintures qui se d\u00e9voilent au visiteur plus acharn\u00e9. Quand la Maison du Roi parle d'elle, l'histoire, les quartiers de Bruxelles s'\u00e9clairent et se montrent autrement. Des surprises, elle en abrite ! \r\n\r\nMise \u00e0 disposition d\u2019un guide pendant 2h. Possibilit\u00e9 d\u2019inclure la visite de la Maison du Roi en suppl\u00e9ment. R\u00e9servation obligatoire.","performers":null,"boxoffice_url":null,"website":null,"email":"info@itineraires.be","phone_contact":"+32 2 541 03 77","phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/532751.html"},"nl":{"name":"Gebruiken en gewoonten uit de renaissance: het Broodhuis in de kijker","shortdescr":null,"longdescr":"Er was eens een broodhal waar de koning zijn intrek nam en die uitgroeide tot het museum van de stad. Achter de gevel, een kantwerk in steen, gaan architecturale geheimen, geschiedkundige symbolen en sporen van een hertogelijk hof schuil. Binnen kunnen geboeide bezoekers tal van maquettes, bronzen en houten beelden, oude stenen, retabels en schilderijen bewonderen. Als het Broodhuis van zich laat spreken, licht de geschiedenis op en tonen de wijken van Brussel zich van een andere kant. Het pand heeft heel wat verrassende hoekjes! \r\n\r\nMogelijkheid om het bezoek aan het Broodhuis als extra te boeken, volgens de prijsvoorwaarden van onze partners.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/532751.html"},"en":{"name":"Customs and habits of the Renaissance: Focus on the Maison du Roi","shortdescr":null,"longdescr":"Once upon a time there was a bakery that became the Maison du Roi (\u201cKing\u2019s House\u201d) and eventually turned into a museum. Its lacy facade hides architectural secrets, symbols of the city\u2019s history and the presence of the Duke. Inside are models, statues in bronze and wood, old stones, altarpieces and paintings that reveal themselves to the most determined visitor. When the Maison du Roi speaks of history, the past and neighbourhoods of Brussels shine in a new and brighter light. It really does have some surprises in store!  \r\n\r\nPossibility of including a visit of the Maison du Roi as an extra. Depending on the price conditions of our partners:","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/532751.html"},"de":{"name":"Us et coutumes de la Renaissance: focus sur la Maison du Roi","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/532751.html"},"it":{"name":"Us et coutumes de la Renaissance: focus sur la Maison du Roi","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/532751.html"},"sp":{"name":"Costumbres y tradiciones renacentistas: enfoque en la Maison du Roi","shortdescr":null,"longdescr":"Una vez fue un mercado de pan que luego se convirti\u00f3 en la Maison du Roi y ahora se ha transformado en un museo. Una fachada de encaje esconde secretos arquitect\u00f3nicos, s\u00edmbolos de la historia de la ciudad y la presencia ducal. En el interior, maquetas, estatuas de bronce y madera, piedras antiguas, retablos y pinturas que se revelan al visitante m\u00e1s interesado. Cuando la Maison du Roi habla de s\u00ed misma, la historia y los barrios de Bruselas se iluminan y se muestran de forma diferente. En ella encontrar\u00e1s numerosas sorpresas.  \r\n\r\nPrestaci\u00f3n de los servicios de un gu\u00eda durante 2 horas. Posibilidad de incluir una visita a la Maison du Roi con un coste adicional.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/532751.html"},"pt":{"name":"Us et coutumes de la Renaissance: focus sur la Maison du Roi","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/532751.html"},"cn":{"name":"Us et coutumes de la Renaissance: focus sur la Maison du Roi","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/532751.html"}},"place":{"id":248488,"translations":{"fr":{"name":"devant la Maison du Roi","address_street_name":"Grand-Place","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"vi