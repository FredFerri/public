vents":[],"targets":{"list":[4,5,11,7,8],"translations":{"fr":["Enfants 6-9 ans","Enfants 9-12 ans","Famille","Jeunes 12-15 ans","Jeunes 15-18 ans"],"nl":["Kinderen 6-9 j.","Kinderen 9-12 j.","Familie","Jongeren 12-15 j.","Jongeren 15-18 j."],"en":["Children 6-9 yr.","Children 9-12 yr.","Family","Youth 12-15  yr.","Youth 15-18  yr."]}},"tags":["kids"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-11T05:06:06+02:00","published_at":"2022-09-09T13:55:15+02:00","backoffice_id":261459,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.3568829277518},{"id":541728,"date_start":"2022-09-22","date_end":"2022-10-16","date_next":"2022-10-15","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung"}},"others":{"list":[24,34],"translations":{"fr":["Galeries d'art","Pluridisciplinaire"],"nl":["Galeries","Pluridisciplinair"],"en":["Art Galleries","Multidisciplinary"],"de":["Kunstgalerien","Multidisziplin\u00e4r"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"BrAMS : Numero Due","shortdescr":"Fabio Denker, Jean Paul Masse de Rouch (alias JPMDR) et Yorgoland les fondateurs du collectif, invitent \u00e0 se joindre \u00e0 eux leurs homologues cr\u00e9atifs Pascal Bernier, Pascal Duquenne, Didier Engels, Denis Meyers et Serge Vankerck.","longdescr":"Fort du succ\u00e8s d\u2019une premi\u00e8re \u00e9dition de cette exposition pluri artistique l\u2019\u00e9t\u00e9 dernier au Sablon, le collectif d\u2019artistes BrAMS d\u00e9voile \u00e0 la rentr\u00e9e son tout aussi r\u00e9jouissant volet \u00ab Numero Due \u00bb.\r\nFabio Denker, Jean Paul Masse de Rouch (alias JPMDR) et Yorgoland les fondateurs du collectif, invitent \u00e0 se joindre \u00e0 eux leurs homologues cr\u00e9atifs Pascal Bernier, Pascal Duquenne, Didier Engels, Denis Meyers et Serge Vankerck.  \r\nDans une accueillante maison de ma\u00eetre \u00e0 Ixelles, chaque espace priv\u00e9 sera livr\u00e9 \u00e0 l\u2019imagination des artistes dans un esprit d\u00e9cal\u00e9, l\u00e9ger, ironique, underground, voire insolent, parce qu\u2019il en faut de temps en temps.\r\n\r\nBrAMS Numero Due sera ponctu\u00e9e d\u2019\u00e9v\u00e9nements organis\u00e9s par les talents impliqu\u00e9s.\r\n\r\nAU PROGRAMME\r\nMode, Musique & Gourmandise\r\n\r\nYorgoland, Jean Paul Masse de Rouch JPMDR, Fabio Denker, Didier Engels, Denis Meyers, Serge VanKerck, Pascal Duquenne, Pascal Bernier","performers":null,"boxoffice_url":null,"website":"https:\/\/www.brams.art\/","email":"press@sophiecarree.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.541728"},"nl":{"name":"BrAMS : Numero Due","shortdescr":"Fabio Denker, Jean Paul Masse de Rouch (alias JPMDR) en Yorgoland , de oprichters van het collectief, hebben hun creatieve collega\u2019s Pascal Bernier, Pascal Duquenne, Didier Engels, Denis Meyers en Serge Vankerck uitgenodigd om samen te komen.","longdescr":"De eerste editie van deze pluri-artistieke tentoonstelling, vorige zomer aan de Zavel, was zo\u2019n succes dat het kunstenaarscollectief BrAMS heeft besloten om er in september een al even vrolijk vervolg aan te breien onder de naam \u201cNumero Due\u201d.\r\nFabio Denker, Jean Paul Masse de Rouch (alias JPMDR) en Yorgoland , de oprichters van het collectief, hebben hun creatieve collega\u2019s Pascal Bernier, Pascal Duquenne, Didier Engels, Denis Meyers en Serge Vankerck uitgenodigd om samen te komen.\r\nIn een gezellig herenhuis in Elsene wordt elke ruimte overgelaten aan de verbeelding van de kunstenaars. En omdat er af en toe nood aan is, zal elke ruimte baden in een luchtige, ironische, underground en soms zelfs wat brutale sfeer met een hoekje af.\r\n\r\nTijdens BrAMS Numero Due worden er ook verschillende evenementen georganiseerd door de betrokken talenten. \r\n\r\nOP HET PROGRAMMA\r\nMode, muziek en eten\r\n\r\nYorgoland, Jean Paul Masse de Rouch JPMDR, Fabio Denker, Didier Engels, Denis Meyers, Serge VanKerck, Pascal Duquenne, Pascal Bernier","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.541728"},"en":{"name":"BrAMS : Numero Due","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.541728"},"de":{"name":"BrAMS : Numero Due","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.541728"},"it":{"name":"BrAMS : Numero Due","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.541728"},"sp":{"name":"BrAMS : Numero Due","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.541728"},"pt":{"name":"BrAMS : Numero Due","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.541728"},"cn":{"name":"BrAMS : Numero Due","shortdescr":null,"longdescr":null,"p