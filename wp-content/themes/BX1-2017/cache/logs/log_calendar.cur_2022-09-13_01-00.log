oe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":84,"translations":{"fr":"Divers","nl":"Varia","en":"Various"}},"others":{}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Witches","shortdescr":"Witches","longdescr":"Witches, du 12 septembre au 30 septembre 2022, exposition pendant les heures d'ouverture de la biblioth\u00e8que.\r\nL'exposition Witches plonge aux racines de l'histoire de la sorcellerie : des proc\u00e8s en sorcellerie \u00e0 la litt\u00e9rature merveilleuse, de la figure d\u00e9moniaque \u00e0 la gentille sorci\u00e8re de la pop culture. Objets ethnographiques, manuscrits, peintures, photographies, oeuvres du cin\u00e9ma, performances artistiques\u2026\r\nWitches croise les histoires r\u00e9elles des sorci\u00e8res et leurs repr\u00e9sentations \u00e0 travers les \u00e2ges et les arts, jusqu'\u00e0 leur r\u00e9habilitation contemporaine, notamment par les mouvements queer et f\u00e9ministes qui ont pris la sorci\u00e8re comme embl\u00e8me de leur r\u00e9volte.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.brunette.brucity.be\/","email":"bp1@brucity.education","phone_contact":"+32 2 548 26 10","phone_booking":"+32 2 548 26 10","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.540659"},"nl":{"name":"Witches","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"bp1@brucity.education","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.540659"},"en":{"name":"Witches","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"bp1@brucity.education","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-