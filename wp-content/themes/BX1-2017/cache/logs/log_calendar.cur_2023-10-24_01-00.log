 en Europe, enti\u00e8rement d\u00e9di\u00e9 \u00e0 l\u2019improvisation. En quelques ann\u00e9es, il s\u2019est forg\u00e9 une solide r\u00e9putation de lieu incontournable de la sc\u00e8ne improvisatrice internationale. Ses planches ont accueilli des centaines de com\u00e9diens belges et \u00e9trangers.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Th\u00e9\u00e2tre L'improviste","address_street_name":"Rue de Fierlant","address_street_number":"120","address_street_box":null,"email":null,"website":"http:\/\/www.improviste.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Rue de Fierlant, 120","address_line2":"1190 Forest","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Th\u00e9\u00e2tre l\u2019Improviste ","address_street_name":"de Fierlantstraat","address_street_number":"120","address_street_box":null,"email":null,"website":"http:\/\/www.improviste.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"de Fierlantstraat, 120","address_line2":"1190 Forest","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[21],"translations":{"de":["S\u00fcden"],"pt":[null],"en":["South"],"it":["Sud"],"cn":[null],"fr":["Sud"],"sp":["Sur"],"nl":["Zuid"]}},"neca":null,"facebook_id":null,"backoffice_id":30611,"location":{"lat":50.82474185,"lon":4.3319982},"region":"brussels","last_updated_at":"2022-10-18T11:21:01+02:00","published_at":"2018-01-17T15:25:41+01:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":270611,"translations":{"de":{"name":"Th\u00e9\u00e2tre l\u2019Improviste ","address_street_name":"Rue de Fierlant","address_street_number":"120","addre