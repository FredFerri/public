name":"Estudiantes"},"nl":{"name":"Studenten"}},"value":8},{"translations":{"de":{"name":"Normal"},"en":{"name":"Normal"},"it":{"name":"Normale"},"fr":{"name":"Normal"},"sp":{"name":"Normal"},"nl":{"name":"Normaal"}},"value":15}],"date_exceptions":[],"closing_days":[],"child_events":[],"parent_events":[],"accessibilities":{"list":[255],"translations":{"de":["Barrierefrei"],"pt":[null],"en":["Accessible"],"it":["Accessibile"],"cn":[null],"fr":["Accessible"],"sp":["Habilitado"],"nl":["Toegankelijk"]}},"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[]},{"id":50007162,"date_start":"2024-05-31","date_end":"2024-05-31","date_next":"2024-05-31","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-05-21T11:37:00+02:00","published_at":"2024-02-12T15:25:42+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":294369,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"concert","ranking":1.2599210498948732,"languages":{"spoken":["en","fr","nl"],"subtitles":[]},"categories":{"main":{"id":1,"translations":{"de":"Konzert","pt":null,"en":"Concert","it":"Concerti","cn":null,"fr":"Concert","sp":"Concierto","nl":"Concert"}},"others":{"list":[7,4],"translations":{"de":["Pop, Rock","Pop, Rock, Jazz..."],"pt":[null,null],"en":["Pop, Rock","Pop, rock, jazz\u2026"],"it":["Pop, Rock","Pop, rock, jazz\u2026"],"cn":[null,null],"fr":["Pop, Rock","Pop, rock, jazz\u2026"],"sp":["Pop, rock","Pop, rock, jazz\u2026"],"nl":["Pop, Rock","Pop, rock, jazz\u2026"]}}},"translations":{"de":{"name":"Earth Tongue (NZ) + Den Der Hale (SE)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.facebook.com\/events\/584104497270836","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50007162"},"pt":{"name":"Earth Tongue (NZ) + Den Der Hale (SE)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.facebook.com\/events\/584104497270836","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50007162"},"en":{"name":"Earth Tongue (NZ) + Den Der Hale (SE) + Bicky Love (BE)","shortdescr":"Collectif Mental proudly presents:\nEARTH TONGUE (fuzz\/heavy psych\/stoner rock - NZ)\nDEN DER HALE (psychedelic rock\/krautrock - SE)\nBICKY LOVE (garage hypnotic noise - BE)","longdescr":"Collectif Mental proudly presents:\n\n\nEARTH TONGUE (fuzz\/heavy psych\/stoner rock - NZ)\n\nSometimes music is supposed to feel weird and indescribable. It's the moments of clarity within the dense, sonic mess that often feels the most satisfying. That's the space that Earth Tongue occupy. At times, their songs are shrill and disorientating, other times their reverb-washed textures and instantly- familiar hooks can wrap you in a warm, loving embrace. The one consistent thread through their music, however, is the thick and all encompassing fuzz. Guitarist Gussie Larkin has become a master of the fuzz-smothered riff, and along with Ezra Simons' off-kilter drumming, they've been sending punters into transcendental states since they began gigging in their home town of Wellington, New Zealand in 2016.\nEarth Tongue are playing three arena shows this year opening for Queens of the Stone Age and their new album will be released in the summer.\n\n\u2022 https:\/\/www.facebook.com\/earthtongueband\n\u2022 https:\/\/earthtongue.bandcamp.com\n\n\nDEN DER HALE (psychedelic rock\/krautrock - SE)\n\nSwedish post-psych outfit Den Der Hale aims not so much at creating a specific sound, as much as melding together the various creative inspirations of each\nindividual member. As such, the result is eclectic and experimental and, in many ways, more than the mere sum of its parts. Itinerant rhythms and atonal melodies\nare filtered through heavy effects, harsh layers of noise are contrasted by animate bass lines and propulsive percussions. In this seemingly chaotic amalgam, there is\nalways a red line, and often each musical output becomes a synthesis, a whole.\n\n\u2022 https:\/\/www.facebook.com\/denderhaleband\n\u2022 https:\/\/denderhale.bandcamp.com\n\n\nBICKY LOVE (garage hypnotic noise - BE)\n\nAs delicious and cruel as life itself, five female musicians from the Brussels scene (DJs, comedians, musicians, performers, etc.) got together to develop a stimulating and subversive band.\nBicky Love pulls the delirium towards shadowy zones. Each musician has voluntarily changed instruments to find new sounds and bring a different perspective to their deliciously offbeat compositions.\nPushing the envelope. Screaming to make it louder. The taste is unique. Just like the famous Bicky burger with 3 sauces, this band is mellow and hearty.\n\n\u2022 https:\/\/www.facebook.com\/BickyLoveShow\n\u2022 https:\/\/bickylove.bandcamp.com","performers":"Earth Tongue; Den Der Hale; Bicky Love","boxoffice_url":null,"website":"https:\/\/www.facebook.com\/events\/584104497270836","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50007162"},"it":{"name":"Earth Tongue (NZ) + Den Der Hale (SE)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.facebook.com\/events\/584104497270836","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50007162"},"cn":{"name":"Earth Tongue (NZ) + Den Der Hale (SE)","s