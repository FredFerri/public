te":"public","last_updated_at":"2023-02-13T02:07:45+01:00","published_at":"2022-08-16T10:09:36+02:00","backoffice_id":259766,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.12565790685486},{"id":515896,"date_start":"2023-02-13","date_end":"2024-07-31","date_next":"2023-02-13","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen","it":"Visite guidate","sp":"Visitas guiadas","pt":null,"cn":null}},"others":{}},"languages":{"spoken":["en","fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Visite des brasseries de Bruxelles & rencontrez le brasseur","shortdescr":"Visite d'une brasserie artisanale bruxelloise : d\u00e9couvrez les diff\u00e9rences entre le Lambic centenaire et la plus jeune brasserie de la ville. En bonus : rencontrez le brasseur!\r\nFaites connaissance avec le march\u00e9 belge de la bi\u00e8re en d\u00e9couvrant deux brasseries locales diff\u00e9rentes.","longdescr":"Inclus: \r\nSix bi\u00e8res belges de qualit\u00e9, des \u00e9ditions limit\u00e9es \u00e0 notre cr\u00e9ations traditionnelles\r\nDeux brasseries artisanales dont une n'est g\u00e9n\u00e9ralement pas ouverte au public\r\nDeux lieux r\u00e9put\u00e9s pour les amateurs de bi\u00e8re\r\nUn guide jeune et passionn\u00e9 qui a lanc\u00e9 l'une des premi\u00e8res bi\u00e8res artisanales belges\r\nTransport entre les brasseries\r\n\r\nPoints forts: \r\nVisitez une brasserie de Lambic et d\u00e9couvrez l'ancien style de brassage bruxellois (disponible uniquement \u00e0 Bruxelles - en journ\u00e9e)\r\nRencontre avec le brasseur\r\nD\u00e9couvrez le processus de brassage, de la malterie \u00e0 la salle de fermentation\r\nD\u00e9fiez vos amis pendant le jeu de la bi\u00e8re\r\nD\u00e9couvrez le vrai go\u00fbt du houblon et des malts\r\nInspirez-vous des nouvelles visites de brasseries dans toute la Belgique\r\nD\u00e9couvrez d'autres d\u00e9lices locaux gr\u00e2ce \u00e0 un accord mets et bi\u00e8res","performers":"Liselot Caura ( zaakvoerder BeerSecret) \r\nMaxim & Gregoire (brasseurs brasserie L'Annexe)","boxoffice_url":null,"website":"https:\/\/beersecret.com\/tour\/brussels-craft-brewery-tour-meet-the-brewer\/","email":"liselot@creatiefcaura.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.515896"},"nl":{"name":"Brussels craft brouwerijtour & ontmoet de brouwer","shortdescr":"Ontdek via een brouwerijbezoek het contrast tussen de 100-jarige Lambiek en de jongste brouwerij van Brussel.\r\n\r\nBezoek twee verschillende craft brouwerijen: de beste manier om jou te introduceren tot de Belgische biercultuur.","longdescr":"Inbegrepen: \r\nDegusteren van 6 hoogstaande Belgische bieren; van exclusieve tot traditionele brouwsels\r\nBezoek aan 2 ambachtelijke Brusselse brouwerijen, waarvan \u00e9\u00e9n met exclusieve toegang\r\nTussenstop in 2 hoog gekwalificeerde biercaf\u00e9s dat \u00e9\u00e9n en al Brussel uitstraalt\r\nJonge, lokale en gepassioneerd gastvrouw die \u00e9\u00e9n van de eerste Belgische craft bieren lanceerde\r\nTransport tussen de brouwerijbezoeken\r\n\r\nHoogtepunten: \r\nBezoek de oudste Lambiek brouwerij waar nog steeds de authentieke brouwtechnieken worden toegepast (Niet beschikbaar op zondag)\r\nOntmoet de brouwer\r\nReis mee met het graan door het volledige brouwproces: van de mouterij tot in de fermentatieruimte.\r\nDaag je vrienden uit tijdens een leerrijke bierquiz (en win een smakelijke prijs)\r\nOntdek de echte smaak van hop en mout\r\nDe smaak te pakken? Doe inspiratie op voor andere brouwerijbezoeken doorheen in Belgi\u00eb\r\nPrikkel je smaakpapillen en ontdek de lokale eetcultuur via een doordachte foodpairing","performers":"Liselot Caura ( zaakvoerder & gepassioneerde biergids) \r\nMaxim & Gregoire ( brouwers L'Annexe)","boxoffice_url":null,"website":"https:\/\/beersecret.com\/tour\/brussels-craft-brewery-tour-meet-the-brewer\/","email":"liselot@creatiefcaura.com","phone_contact":null,"phone_booking":"+32 472 60 47 46","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.515896"},"en":{"name":"Brussels craft brewery tour & meet the brewer","shortdescr":"Explore the differences between the 100-year-old Lambic and the youngest brewery in town. Bonus: get to meet the brewer!\r\nGet introduced to the Belgian beer market by exploring two different local breweries.","longdescr":"Included in the price: \r\n6 high-quality Belgian beers from limited editions to our traditional brews\r\n2 craft breweries: Cantillon & L'Annexe, which is not usually open to the public\r\n1 renowned beer lovers' spots\r\nA young and passionate local guide who launched one of the first Belgian craft beers\r\nTransportation between breweries\r\n\r\nHIghlights: \r\nVisit a Lambic brewery and discover the old Brussels style (not on Sundays)\r\nMeet the brewer\r\nLearn about the brewing process, from the maltery to the fermentation room\r\nChallenge your friends during the beer game\r\nDiscover the real taste of hops and malts\r\nGet inspiration for new brewery visits all over Belgium\r\nDiscover more of the local delicacies thanks to a special food pairing","performers":"Liselot Caura ( founder & passionated beer guide) \r\nMaxim & Gregoire ( brewers brewery L'Annexe)","boxoffice_url":null,"website":"https:\/\/beersecret.com\/tour\/brussels-craft-brewery-tour-meet-the-brewer\/","email":"liselot@creatiefcaura.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.515896"},"de":{"name":"Ontdek de Brusselse brouwerijwereld met een local bierkenner","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/beersecret.com\/tour\/brussels-craft-brewery-tour-meet-the-brewer\/","email":"liselot@creatiefcaura.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.515896"},"it":{"name":"Ontdek de Brusselse brouwerijwereld met een local bierkenner","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/beersecret.com\/tour\/brussels-craft-brewery-tour-meet-the-brewer\/","email":"liselot@creatiefcaura.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.515896"},"sp":{"name":"Ontdek de Brusselse brouwerijwereld met een local bierkenner","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/beersecret.com\/tour\/brussels-craft-brewery-tour-meet-the-brewer\/","email":"liselot@creatiefcaura.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.515896"},"pt":{"name":"Ontdek de Brusselse brouwerijwereld met een local bierkenner","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/beersecret.com\/tour\/brussels-craft-brewery-tour-meet-the-brewer\/","email":"liselot@creatiefcaura.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.515896"},"cn":{"name":"Ontdek de Brusselse brouwerijwereld met een local bierkenner","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/beersecret.com\/tour\/brussels-craft-brewery-tour-meet-the-brewer\/","email":"liselot@creatiefcaura.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.515896"}},"place":{"id":266754,"translations":{"fr":{"name":"BeerSecret","address_street_name":"Rue Antoine Dansaert","address_street_number":"188","address_street_box":null,"email":"liselot@creatiefcaura.com","website":"http:\/\/www.beersecret.com","phone_contact":"+32 472 60 47 46","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Antoine Dansaert, 188","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"BeerSecret","address_street_name":"Antoine Dansaertstraat","address_street_number":"188","address_street_box":null,"email":"liselot@creatiefcaura.com","website":"http:\/\/www.beersecret.com","phone_contact":"+32 472 60 47 46","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Antoine Dansaertstraat, 188","address_line2":"1000 Brussel","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"BeerSecret","address_street_name":"Rue Antoine Dansaert","address_street_number":"188","address_street_box":null,"email":"liselot@creatiefcaura.com","website":"http:\/\/www.beersecret.com","phone_contact":"+32 472 60 47 46","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue Antoine Dansaert, 188","address_line2":"1000 Brussels","description_web":"Take part in an interactive and tasty beer tour in historical Brussels, Ghent or Bruges. In a small group you will learn about the history of beer, immerse yourself in the brewing process and discover the reasons behind  Belgian beer\u2019s worldwide fame. Savour a mix of traditional and craft beers paired with  artisan chocolate and other local delicacies. With the right mix of knowledge and humour, a young, passionate guide will reveal tantalizing beer secrets and tell you all about the rich world of Belgian beers. Our promise: the guarantee that you\u2019ll go home with a new favorite beer style after this unique tour.\r\nSince Covid-19, Liselot also developed virtu