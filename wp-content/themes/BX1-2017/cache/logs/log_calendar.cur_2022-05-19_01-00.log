nants","Famille","LGTBQIA","Seniors","Sourd\/malentendant"],"nl":["Leerkrachten","Familie","LGTBQIA","Senioren","Doof\/slechthorend"],"en":["Teachers","Family","LGTBQIA","Seniors","Deaf\/hard of hearing"]}},"tags":["exterior","kids"],"accessibilities":{"list":[252,256,257,259,263,265],"translations":{"fr":["Accessible aux personnes ayant des difficult\u00e9s de compr\u00e9hension","Am\u00e9nagements pour les personnes aveugles et malvoyantes","Am\u00e9nagements pour personnes sourdes et malentendantes","Chien d'assistance","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9"],"nl":["Toegankelijk voor mensen met een verstandelijke beperking","Voorzieningen voor blinde en slechtziende personen","Voorzieningen voor dove en slechthorende personen","Assistentiehonden","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet"],"en":["Accessible to people with intellectual disabilities","Facilities for blind and partially-sighted persons","Facilities for deaf and hearing-impaired people","Assistance dogs","Accessible to pedestrians with mobility aids","Adapted toilet"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-05-15T01:06:36+02:00","published_at":"2021-05-12T09:11:18+02:00","backoffice_id":231490,"import_origin":null,"sub_type":"other","show_in_agenda":true,"ranking":0.1399912277661},{"id":534000,"date_start":"2022-05-21","date_end":"2022-05-21","date_next":"2022-05-21","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{"list":[109],"translations":{"fr":["Espaces verts"],"nl":["Groene zones"],"en":["Green spaces"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Garden Tales \u2013 Vogelzangbeek","shortdescr":"Garden Tales est un \u00e9v\u00e9nement annuel gratuit qui vous propose de visiter des jardins priv\u00e9s et publics \u00e0 Bruxelles.","longdescr":"A deux pas de la ville, la R\u00e9serve Naturelle Agr\u00e9\u00e9e du Vogelzangbeek abrite quantit\u00e9 d'esp\u00e8ces sauvages gr\u00e2ce \u00e0 la pr\u00e9servation d'une mosa\u00efque de milieux diff\u00e9rents : bois humides, \u00e9tangs, zones mar\u00e9cageuses, haies bocag\u00e8res, vastes prairies. Garden Tales vous propose une visite th\u00e9matique de ce site exceptionnel, qui t\u00e9moigne de la nature en ville, face \u00e0 la pression urbanistique. N\u2019oubliez pas de vous habiller et de vous chausser en cons\u00e9quence.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.civa.brussels\/en\/exhibitions-events\/within-vogelzangbeek-nature-reserve","email":"info@civa.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/534000.html"},"nl":{"name":"Garden Tales \u2013 Vogelzangbeek","shortdescr":"Garden Tales is een jaarlijks evenement waarbij je gratis heel wat priv\u00e9- en publieke tuinen in Brussel kan bezoeken.","longdescr":"Op een steenworp van de stad herbergt het natuurreservaat Vogelzangbeek heel wat wilde diersoorten dankzij de instandhouding van een lappendeken van verschillende natuurlijke omgevingen: vochtige bossen, vijvers, moerasgebieden, hagen en uitgestrekte weiden. Garden Tales biedt je een thematisch bezoek aan deze uitzonderlijke site die getuigt van de natuur in de stad, tegen de stedelijke druk in. Vergeet niet je te voorzien van aangepaste kledij en schoenen.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/534000.html"},"en":{"name":"Garden Tales \u2013 Vogelzangbeek","shortdescr":"Garden Tales is a free yearly festival that turns the spotlight on private and public gardens in Brussels.","longdescr":"A stone's throw from the city, the Vogelzangbeek Nature Reserve is home to a large number of wild species thanks to the preservation of a mosaic of different environments: wet woods, ponds, marshy areas, hedgerows and vast meadows. Garden Tales offers you a thematic visit of this exceptional site, which bears witness to nature in the city while resisting urban pressure. Don't forget to dress appropriately and wear suitable shoes.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/534000.html"},"de":{"name":"Garden Tales \u2013 Vogelzangbeek","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/534000.html"},"it":{"name":"Garden Tales \u2013 Vogelzangbeek","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/534000.html"},"sp":{"name":"Garden Tales \u2013 Vogelzangbeek","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/534000.html"},"pt":{"name":"Garden Tales \u2013 Vogelzangbeek","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/534000.html"},"cn":{"name":"Garden Tales \u2013 Vogelzangbeek","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/5