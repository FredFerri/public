ublished_at":"2022-04-08T12:28:05+02:00","backoffice_id":251214,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.15647795590281},{"id":531665,"date_start":"2022-08-21","date_end":"2022-08-21","date_next":"2022-08-21","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{"list":[109],"translations":{"fr":["Espaces verts"],"nl":["Groene zones"],"en":["Green spaces"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"La promenade verte","shortdescr":"Embarquez pour une aventure d\u2019une journ\u00e9e \u00e0 v\u00e9lo \u00e0 la d\u00e9couverte de la c\u00e9l\u00e8bre promenade verte bruxelloise.","longdescr":"Cet itin\u00e9raire de 60 km entourant la r\u00e9gion bruxelloise n\u2019est plus \u00e0 pr\u00e9senter aujourd\u2019hui. Reliant les diff\u00e9rents espaces verts de la ville par des chemins d\u00e9tourn\u00e9s et r\u00e9serv\u00e9s aux pi\u00e9tons et cyclistes, elle permet de d\u00e9couvrir une multitude de paysages et de milieux naturels. De la for\u00eat de Soignes au plateau du Heysel en passant par le Neerpeede et le parc de la Woluwe, enfourchez votre v\u00e9lo pour une mise au vert radicale dans une ambiance conviviale.\n* Pr\u00e9voyez un pique-nique pour le temps de midi.\n* La balade est athl\u00e9tique au niveau du nombre de km parcourus, le guide s\u2019adapte au groupe et \u00e0 son rythme.\n* Il est possible d\u2019arr\u00eater la balade en cours si celle-ci s\u2019av\u00e8re trop longue. Durant le parcours, \u00e0 diff\u00e9rents endroits pr\u00e9cis, le guide vous indiquera le meilleur moyen de reprendre le m\u00e9tro pour rejoindre le centre-ville.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.provelo.org","email":"info@provelo.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/531665.html"},"nl":{"name":"La promenade verte","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.provelo.org","email":"info@provelo.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/531665.html"},"en":{"name":"La promenade verte","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/531665.html"},"de":{"name":"La promenade verte","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/531665.html"},"it":{"name":"La promenade verte","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/531665.html"},"sp":{"name":"La promenade verte","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/531665.html"},"pt":{"name":"La promenade verte","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/531665.html"},"cn":{"name":"La promenade verte","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/531665.html"