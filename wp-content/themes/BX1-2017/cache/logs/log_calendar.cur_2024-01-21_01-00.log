ons":{}},"tags":[]},{"id":50005611,"date_start":"2024-01-26","date_end":"2024-01-27","date_next":"2024-01-26","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2023-12-22T10:15:04+01:00","published_at":"2023-12-22T10:01:02+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":291348,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"party","ranking":1,"languages":{"spoken":["fr","en","nl"],"subtitles":[]},"categories":{"main":{"id":57,"translations":{"de":"Clubbing","pt":null,"en":"Clubbing","it":"Locali notturni","cn":null,"fr":"Clubbing","sp":"Ir de discoteca","nl":"Clubbing"}},"others":{}},"translations":{"de":{"name":"C12 Nite","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/c12space.com\/","email":"info@c12space.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50005611"},"pt":{"name":"C12 Nite","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/c12space.com\/","email":"info@c12space.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50005611"},"en":{"name":"C12 Nite","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/c12space.com\/","email":"info@c12space.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50005611"},"it":{"name":"C12 Nite","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/c12space.com\/","email":"info@c12space.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50005611"},"cn":{"name":"C12 Nite","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/c12space.com\/","email":"info@c12space.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50005611"},"fr":{"name":"C12 Nite","shortdescr":null,"longdescr":"Good to know\n\u2594\u2594\u2594\nDoors open: 23h\n\u2014\u2014\u2014\u2014\u2014\u2014\nAge limit : + 18\n\u2014\u2014\u2014\u2014\u2014\u2014\nIn = In \/\/ Out = Out\n\u2014\u2014\u2014\u2014\u2014\u2014\nFor all kinds of people.\n\nTerms & Conditions\n\nA presale ticket is cheaper. A presale ticket is not a VIP ticket though, it doesn't give you faster or guaranteed access to our club, you will still have to act in line with our house rules. Holders of presale tickets use the same entrance queue as those without.\n\u2594\u2594\u2594\n\nDoor sale starts at 23h\nLockers : 2\u20ac\nToilets : Free\n\nAddress\n\u2594\u2594\u2594\u2594\n116 rue marche aux herbes\n1000 Brussels\n\n\ufeff\nWhat we stand for\n\u2594\u2594\u2594\nC12 is a pluridisciplinary space where art & clubbing collide. It\u2019s a place where freedom, diversity, creativity and alternative cultures are protected from the outside world and its norms and restrictions. By doing this, we wish to establish a place owned by artists, musicians and every individual who comes through our door.\nNO!\n\u2014\u2014-\nIn order to protect our space, we will not tolerate any discriminating comportment (racism, sexism, homophobia, \u2026), shaming, violence, consumption of drugs and any kind of intrusive behaviour, even in its most passive form.\n\nRESPECT!\n\u2014\u2014\u2014\u2014-\nBetween these walls, we look out for each other and respect and tolerance are key. Everyone among us is treated equally, regardless of who they are, where they come from and what they do. The space belongs to everyone and to no group or no community in particular.\n\nIN OR NOT?\n\u2014\u2014\u2014\u2014-\nC12 is a private space and reserves the right to decide which visitors are allowed to enter. Represented by our door staff, we reserve the right to deny entry to every person deemed unable to respect the values connected to the project.\n\nNEED HELP?\n\u2014\u2014\u2014\u2014-\nC12\u2019s staff has been trained to act against any disputative situation or behavior. We have a help desk located near the entrance of the main room, where you can talk to a staff member any time of the night. We have staff present on the dance floor and in every corner of the club, functioning as our eyes and ears. We encourage anyone who witnesses a violation of the rules to contact a C12 staff member. In case of indictment, C12 reserves the right to contact the authorities. Respect yourself, the audience, the artists and the staff, stay hydrated and have a pleasant time.\n\nPHOTOGRAPHY\n\u2014\u2014\u2014\u2014-\nWe have a strict no-photography and no-flashes policy at C12. Here is why.\nWe see our club as a private and preserved space, belonging to everyone and allowing all visitors to feel free and behave, dance, dress, \u2026 the way they feel. The lens of a smartphone camera can become an obstacle in creating this atmosphere, for both the photographer and the subject. We like to see every night as an experience lived together and in the moment, instead of bringing the outside world into the club or the other way around.\nFurthermore we frequently notice the use of the smartphone\u2019s flashlights in our club, often while photographing. These sudden flashes may not be intended negatively but often disturb other clubbers or the performing artists.\nWe have an in-house photographer who is solely responsible for the photographic identity of C12 on our social and online media. His pictures comply with our DNA and will always try to respect clubber\u2019s privacy. If ever you feel unhappy about a picture we used, please get in touch.\nFrom now on we will use stickers to cover the photo camera of your smartphone. These are easily removable afterwards and do remember all of us not to photograph at C12. We thank you for understanding and helping us to continue finetuning our club into a better place.\nWe wish you an incredible night of clubbing. ","performers":"Francesco Del Garda \n(all night long)","boxoffice_url":null,"website":"https:\/\/c12space.com\/","email":"info@c12space.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50005611"},"sp":{"name":"C12 Nite","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/c12space.com\/","email":"info@c12space.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50005611"},"nl":{"name":"C12 Nite","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/c12space.com\/","email":"info@c12space.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50005611"}},"place":{"id":270712,"translations":{"de":{"name":"C12","address_street_name":"rue March\u00e9 aux Herbes","address_street_number":null,"address_street_box":null,"email":null,"website":"https:\/\/c12space.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"rue March\u00e9 aux Herbes","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"C12","address_street_name":"rue March\u00e9 aux Herbes","address_street_number":null,"address_street_box":null,"email":null,"website":"https:\/\/c12space.com","phone_contact":null,"phone_booking":n