only_by_appointment":false,"is_permanent":false,"is_free":true,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-06-22T03:00:36+02:00","published_at":"2024-04-26T11:42:25+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":299114,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.3624601243342974,"languages":{"spoken":["en","fr"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[40,36],"translations":{"de":["Grafische K\u00fcnste","Museen & Kunstzentren"],"pt":[null,null],"en":["Graphic art","Museums and art centers"],"it":["Arti grafiche","Musei e centri artistici"],"cn":[null,null],"fr":["Arts graphiques","Mus\u00e9es et art centers"],"sp":["Artes gr\u00e1ficas","Museos y centros de arte"],"nl":["Grafische kunst, vormgeving","Musea en kunstcentra"]}}},"translations":{"de":{"name":"Clarice Prache - The Japan Connection","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/forms.office.com\/r\/rgyZFbn14X","email":"info@bx.mofa.go.jp","phone_contact":"+32 2 513 23 40","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50010111"},"pt":{"name":"Clarice Prache - The Japan Connection","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/forms.office.com\/r\/rgyZFbn14X","email":"info@bx.mofa.go.jp","phone_contact":"+32 2 513 23 40","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50010111"},"en":{"name":"Clarice Prache - The Japan Connection","shortdescr":"The exhibition marks the first public display of key artworks by Clarice Prache (1995-2018) that are deeply intertwined with her relationship with Japan and rich cultural heritage. ","longdescr":"For her family and friends, Clarice was luminous, bright, solar, like the ancient meaning of her name. Very generous and caring to others, and very sensitive to human and animal suffering. She was sick to see humans hurting others and damaging their own planet. \n\nIn 2018, she graduates from the UAL. She then goes back to Brussels and is to move to Catalonia for an Art Residence in Spring 2019, when a terrible, long and painful disease finally overwhelms her and takes her life on this Planet. \n\nHer last written words: \u201cI want truth from mouths and eyes, respect from gestures and love from words, between people. I want society to be what it will never be. Open. Humble, flexible. It cannot. This is mostly why I die within life. I never got used to our nature. I can't\u2026 \n\nI wish I could die in Japan, in my sleep on a rice-filled pillow.\u201d ","performers":"Clarice Prache (16 February 1995 \u2013 8 December 2018). \n\nVisual artist, Clarice was a citizen of the World. Born in Lyon Monplaisir, France. Her mother was born in France from a Japanese mother and a half-German half Georgian father. Her father is French. Her mother will transmit her love for her Japanese roots to her. ","boxoffice_url":null,"website":"https:\/\/forms.office.com\/r\/rgyZFbn14X","email":"info@bx.mofa.go.jp","phone_contact":"+32 2 513 23 40","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50010111"},"it":{"name":"Clarice Prache - The Japan Connection","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/forms.office.com\/r\/rgyZFbn14X","email":"info@bx.mofa.go.jp","phone_contact":"+32 2 513 23 40","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50010111"},"cn":{"name":"Clarice Prache - The Japan Connection","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/forms.office.com\/r\/rgyZFbn14X","email":"info@bx.mofa.go.jp","phone_contact":"+32 2 513 23 40","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50010111"},"fr":{"name":"Clarice Prache - The Japan Connection","shortdescr":"L'exposition marque la premi\u00e8re pr\u00e9sentation publique d'\u0153uvres d'art cl\u00e9s de Clarice Prache (1995-2018) qui sont profond\u00e9ment li\u00e9es \u00e0 sa relation avec le Japon et \u00e0 son riche patrimoine culturel. ","longdescr":"Pour sa famille et ses amis, Clarice \u00e9tait lumineuse, brillante, solaire, comme la signification ancienne de son nom. Tr\u00e8s g\u00e9n\u00e9reuse et attentionn\u00e9e envers les autres, elle \u00e9tait \u00e9galement tr\u00e8s sensible \u00e0 la souffrance humaine et animale. Elle \u00e9tait malade de voir les humains blesser les autres et endommager leur propre plan\u00e8te. \n\nEn 2018, elle obtient son dipl\u00f4me \u00e0 l'UAL. Elle retourne ensuite \u00e0 Bruxelles et doit s'installer en Catalogne pour une R\u00e9sidence d'Art au printemps 2019, quand une terrible, longue et douloureuse maladie finit par la terrasser et lui \u00f4ter la vie sur cette Plan\u00e8te. \n\nSes derniers mots \u00e9crits : \u00ab Je veux que la v\u00e9rit\u00e9 sorte des bouches et des yeux, le respect des gestes et l'amour des mots, entre les gens. Je veux que la soci\u00e9t\u00e9 soit ce qu'elle ne sera jamais. Ouverte. Humble, souple. Elle ne le peut pas. C'est surtout pour cela que je meurs dans la vie. Je ne me suis jamais habitu\u00e9 \u00e0 notre nature. Je ne peux pas... \n\nJ'aimerais mourir au Japon, dans mon sommeil, sur un oreiller rempli de riz. \u00bb ","performers":"Clarice Prache (16 f\u00e9vrier 1995 - 8 d\u00e9cembre 2018). \n\nArtiste visuelle, Clarice \u00e9tait une citoyenne du monde. N\u00e9e \u00e0 Lyon Monplaisir, France. Sa m\u00e8re est n\u00e9e en France d'une m\u00e8re japonaise et d'un p\u00e8re mi-allemand mi-g\u00e9orgien. Son p\u00e8re est fran\u00e7ais. Sa m\u00e8re lui transmettra son amour pour ses racines japonaises. ","boxoffice_url":null,"website":"https:\/\/forms.office.com\/r\/rgyZFbn14X","email":"info@bx.mofa.go.jp","phone_contact":"+32 2 513 23 40","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50010111"},"sp":{"name":"Clarice Prache - The Japan Connection","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/forms.office.com\/r\/rgyZFbn14X","email":"info@bx.mofa.go.jp","phone_contact":"+32 2 513 23 40","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50010111"},"nl":{"name":"Clarice Prache - The Japan Connection","shortdescr":"De tentoonstelling is de eerste publieke vertoning van belangrijke kunstwerken van Clarice Prache (1995-2018) die diep verweven zijn met haar relatie met Japan en haar rijke culturele erfgoed. ","longdescr":"Voor haar familie en vrienden was Clarice lichtgevend, helder, zonnig, zoals de oude betekenis van haar naam. Ze was heel gul en zorgzaam voor anderen en heel gevoelig voor het lijden van mensen en dieren. Ze was ziek om te zien hoe mensen anderen pijn deden en hun eigen planeet beschadigden. \n\nIn 2018 studeert ze af aan de UAL. Ze gaat dan terug naar Brussel en zal in de lente van 2019 naar Cataloni\u00eb verhuizen voor een Art Residence, wanneer een vreselijke, lange en pijnlijke ziekte haar uiteindelijk overweldigt en haar leven op deze Planeet neemt. \n\nHaar laatste geschreven woorden: \u201cIk wil waarheid uit monden en ogen, respect uit gebaren en liefde uit woorden, tussen mensen. Ik wil dat de samenleving is wat het nooit zal zijn. Open. Nederig, flexibel. Dat kan ze niet. Dit is meestal waarom ik sterf in het leven. Ik ben nooit gewend geraakt aan onze natuur. Ik kan niet... \n\nIk wou dat ik in Japan kon sterven, in mijn slaap op een met rijst gevuld kussen.\u201d ","performers":"Clarice Prache (16 februari 1995 - 8 december 2018). \n\nVisueel kunstenaar, Clarice was een wereldburger. Geboren in Lyon Monplaisir, Frankrijk. Haar moeder is in Frankrijk geboren uit een Japanse moeder en een half-Duitse half-Georgische vader. Haar vader is Frans. Haar moeder brengt haar liefde voor haar Japanse roots op haar over. ","boxoffice_url":null,"website":"https:\/\/forms.office.com\/r\/rgyZFbn14X","email":"info@bx.mofa.go.jp","phone_contact":"+32 2 513 23 40","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50010111"}},"place":{"id":261989,"translations":{"de":{"name":"Centre Culturel et d'information de l'Ambassade du Japon","address_street_name":"Rue Van Maerlant","address_street_number":"1","address_street_box":null,"email":null,"website":"http:\/\/www.be.emb-japan.go.jp","phone_contact":null,"phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Rue Van Maerlant, 1","address_line2":"1040 Etterbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Centre Culturel et d'information de l'Ambassade du Japon","address_street_name":"Rue Van Maerlant","address_street_number":"1","address_street_box":null,"email":null,"website":"http:\/\/www.be.emb-japan.go.jp","phone_contact":null,"phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Rue Van Maerlant, 1","address_line2":"1040 Etterbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Japan Information and Cultural Centre of the Embassy of Japan","address_street_name":"Van Maerlantstraat","address_street_number":"1","address_street_box":null,"email":null,"website":"http:\/\/www.be.emb-japan.go.jp","phone_contact":null,"phone_booking":null,"address_zip":"1040","address_city":