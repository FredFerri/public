t vivre un moment de partage interg\u00e9n\u00e9rationnel ! A travers des exercices et des improvisations collectives et individuelles nous d\u00e9couvririons les bases du th\u00e9\u00e2tre le tout dans une ambiance ludique et d\u00e9contract\u00e9e.\r\nAvec Alice De Marchi\r\nLocal Th\u00e9\u00e2tre\r\n\r\nLes dimanches matins De 10h0 - 12h00 : 17\/9, 15\/10, 19\/11, 17\/12, 14\/1, 11\/2, 17\/3, 14\/4, 19\/5, 9\/6","performers":"Avec Alice De Marchi\r\n","boxoffice_url":null,"website":"http:\/\/www.wolubilis.be","email":"secretariat.atl@woluwe1200.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.559491"},"sp":{"name":"Th\u00e9\u00e2tre en Famille","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wolubilis.be","email":"secretariat.atl@woluwe1200.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.559491"},"nl":{"name":"Th\u00e9\u00e2tre en Famille","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wolubilis.be","email":"secretariat.atl@woluwe1200.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.559491"}},"place":{"id":220532,"translations":{"de":{"name":"Centre Culturel Wolubilis","address_street_name":"Cours Paul-Henri Spaak","address_street_number":"1","address_street_box":null,"email":"secretariat.atl@woluwe1200.be","website":"http:\/\/www.wolubilis.be","phone_contact":"+32 2 761 60 29","phone_booking":"+32 2 761 60 30","address_zip":"1200","address_city":"Woluwe-Saint-Lambert","address_line1":"Cours Paul-Henri Spaak, 1","address_line2":"1200 Woluwe-Saint-Lambert","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Centre Culturel Wolubilis","address_st