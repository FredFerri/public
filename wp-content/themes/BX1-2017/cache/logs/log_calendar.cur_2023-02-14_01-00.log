orable au sein de la soci\u00e9t\u00e9. Mais ce \u00ab pouvoir \u00bb est aussi le premier pas vers la folie, qui l\u2019am\u00e8ne \u00e0 cr\u00e9er sa propre version de la r\u00e9alit\u00e9 : il s\u2019autoproclame \u201cRoi d\u2019Espagne Ferdinand VIII\u201d.\r\n\r\n\"Ovation debout. Pluie de vivats. Tsunami d'applaudissements. La premi\u00e8re de LOCO a re\u00e7u un accueil \u00e0 l'image de son titre : du d\u00e9lire.\" (Le Soir)\r\n\r\n(Le spectacle est aussi propos\u00e9 \u00e0 prix libre et conscient)","performers":"Mise en sc\u00e8ne et dramaturgie Tita Iacobelli\r\nMise en sc\u00e8ne, dramaturgie, conception de la sc\u00e9nographie et marionnettes Natacha Belova\r\nInterpr\u00e9tation Marta Pereira et Tita Iacobelli (en alternance avec Anne Romain)","boxoffice_url":null,"website":"https:\/\/www.lavenerie.be\/programme\/loco\/","email":null,"phone_contact":"+32 2 663 85 50","phone_booking":"+32 2 672 14 39","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.546370"},"nl":{"name":"Loco","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lavenerie.be\/programme\/loco\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.546370"},"en":{"name":"Loco","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lavenerie.be\/programme\/loco\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.546370"},"de":{"name":"Loco","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lavenerie.be\/programme\/loco\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.546370"},"it":{"name":"Loco","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\