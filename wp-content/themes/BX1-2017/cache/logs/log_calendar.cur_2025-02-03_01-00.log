0e9n\u00e9ral Capiaumont, 45\/47","address_line2":"1040 Etterbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Contraste - L'atelier de photographie","address_street_name":"Rue G\u00e9n\u00e9ral Capiaumont","address_street_number":"45\/47","address_street_box":null,"email":"info@photo-contraste.com","website":"http:\/\/www.photo-contraste.com","phone_contact":"+32 2 640 94 40","phone_booking":"+32 475 81 90 12","address_zip":"1040","address_city":"Etterbeek","address_line1":"Rue G\u00e9n\u00e9ral Capiaumont, 45\/47","address_line2":"1040 Etterbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Contraste - L'atelier de photographie","address_street_name":"Rue G\u00e9n\u00e9ral Capiaumont","address_street_number":"45\/47","address_street_box":null,"email":"info@photo-contraste.com","website":"http:\/\/www.photo-contraste.com","phone_contact":"+32 2 640 94 40","phone_booking":"+32 475 81 90 12","address_zip":"1040","address_city":"Etterbeek","address_line1":"Rue G\u00e9n\u00e9ral Capiaumont, 45\/47","address_line2":"1040 Etterbeek","description_web":"Contraste is a venue dedicated to photography, hosting a gallery and a school. The Contraste gallery organises exhibitions and conferences open to the public.\r\n\r\nFor 25 years, Contraste has been teaching photography to the general public. Focusing. Exposing. Processing. Revealing. Mastering the techniques. Educating the eye. Atelier Contraste's mission is to teach all the necessary skills to produce quality photographs. By sharing their professional experiences and their passion for the medium, the teachers - all graduated from art schools - teach basic and advanced notions of photography. Contraste offers an approach to photography for different audiences of all levels and ages. Weekly workshops, holiday courses, but also short workshops, personalised private lessons and conferences.\r\n\r\nThe Contraste gallery presents two exhibitions per year.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Contraste - L'atelier de photographie","address_street_name":"Rue G\u00e9n\u00e9ral Capiaumont","address_street_number":"45\/47","address_street_box":null,"email":"info@photo-contraste.com","website":"http:\/\/www.photo-contraste.com","phone_contact":"+32 2 640 94 40","phone_booking":"+32 475 81 90 12","address_zip":"1040","address_city":"Etterbeek","address_line1":"Rue G\u00e9n\u00e9ral Capiaumont, 45\/47","address_line2":"1040 Etterbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Contraste - L'atelier de photographie","address_street_name":"Rue G\u00e9n\u00e9ral Capiaumont","address_street_number":"45\/47","address_street_box":null,"email":"info@photo-contraste.com","website":"http:\/\/www.photo-contraste.com","phone_contact":"+32 2 640 94 40","phone_booking":"+32 475 81 90 12","address_zip":"1040","address_city":"Etterbeek","address_line1":"Rue G\u00e9n\u00e9ral Capiaumont, 45\/47","address_line2":"1040 Etterbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Contraste - L'atelier de photographie","address_street_name":"Rue G\u00e9n\u00e9ral Capiaumont","address_street_number":"45\/47","address_street_box":null,"email":"info@photo-contraste.com","website":"http:\/\/www.photo-contraste.com","phone_contact":"+32 2 640 94 40","phone_booking":"+32 475 81 90 12","address_zip":"1040","address_city":"Etterbeek","address_line1":"Rue G\u00e9n\u00e9ral Capiaumont, 45\/47","address_line2":"1040 Etterbeek","description_web":"Contraste est un lieu d\u00e9di\u00e9 \u00e0 la photographie qui regroupe une galerie et une \u00e9cole.\r\n\r\nLa galerie de photographie Contraste,  accueille des artistes et des conf\u00e9rences ouvertes au public.\r\n\r\nDepuis 25 ans, Contraste enseigne la photographie au grand public. Mettre au point. Impressionner. D\u00e9velopper. R\u00e9v\u00e9ler. Ma\u00eetriser la technique. Eduquer l\u2019oeil. La mission de l\u2019atelier Contraste est d\u2019enseigner toutes les aptitudes n\u00e9cessaires \u00e0 une pratique photographique de qualit\u00e9. En partageant leurs exp\u00e9riences du m\u00e9tier et leur passion du m\u00e9dium, les professeurs, tous issus d\u2019\u00e9coles d\u2019art, initient aux bases et perfectionnements de la photographie. Contraste propose une approche de la photographie pour diff\u00e9rents publics de tous niveaux et \u00e2ges. Ateliers hebdos, stages de vacances, mais aussi des workshops courts, des formations sur mesure et des conf\u00e9rences.\r\n\r\nLa galerie pr\u00e9sente deux expositions par an .\r\n\r\n\r\n","description_print":"Contraste est un lieu d\u00e9di\u00e9 \u00e0 la photographie qui regroupe une galerie et une \u00e9cole.\r\n\r\nLa galerie de photographie Contraste,  accueille des artistes et des conf\u00e9rences ouvertes au public.\r\n\r\nDepuis 25 ans, Contraste enseigne la photographie au grand public. Mettre au point. Impressionner. D\u00e9velopper. R\u00e9v\u00e9ler. Ma\u00eetriser la technique. Eduquer l\u2019oeil. La mission de l\u2019atelier Contraste est d\u2019enseigner toutes les aptitudes n\u00e9cessaires \u00e0 une pratique photographique de qualit\u00e9. En partageant leurs exp\u00e9riences du m\u00e9tier et leur passion du m\u00e9dium, les professeurs, tous issus d\u2019\u00e9coles d\u2019art, initient aux bases et perfectionnements de la photographie. Contraste propose une approche de la photographie pour diff\u00e9rents publics de tous niveaux et \u00e2ges. Ateliers hebdos, stages de vacances, mais aussi des workshops courts, des formations sur mesure et des conf\u00e9rences.\r\n\r\nLa galerie pr\u00e9sente deux expositions par an .\r\n","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Contraste - L'atelier de photographie","address_street_name":"Rue G\u00e9n\u00e9ral Capiaumont","address_street_number":"45\/47","address_street_box":null,"email":"info@photo-contraste.com","website":"http:\/\/www.photo-contraste.com","phone_contact":"+32 2 640 94 40","phone_booking":"+32 475 81 90 12","address_zip":"1040","address_city":"Etterbeek","address_line1":"Rue G\u00e9n\u00e9ral Capiaumont, 45\/47","address_line2":"1040 Etterbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Contraste - L'atelier de photographie","address_street_name":"Generaal Capiaumontstraat","address_street_number":"45\/47","address_street_box":null,"email":"info@photo-contraste.com","website":"http:\/\/www.photo-contraste.com","phone_contact":"+32 2 640 94 40","phone_booking":"+32 475 81 90 12","address_zip":"1040","address_city":"Etterbeek","address_line1":"Generaal Capiaumontstraat, 45\/47","address_line2":"1040 Etterbeek","description_web":"Contraste is zowel een galerij als een school, gewijd aan fotografie.\r\n\r\nSedert 25 jaar geeft Contraste les aan een breed publiek. Scherpstellen. Belichten. Verwerken. Ontwikkelen. Onthullen. De techniek beheersen. Het oog trainen.\r\nDe missie van Atelier Contraste is het meegeven van alle nodige kennis om tot een kwalitatieve fotografische praktijk te komen. De lesgevers, allen afkomstig uit het artistiek onderwijs, delen hun ervaring en passie voor het medium. Ze onderwijzen zowel de basis van de fotografie als kennis voor gevorderden. Contraste richt zich tot een breed publiek met verschillende kennisniveaus en leeftijden, en organiseert wekelijkse cursussen, vakantiestages, korte workshops en lezingen.\r\n\r\nDe galerij stelt twee tentoonstellingen voor per jaar.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":nu