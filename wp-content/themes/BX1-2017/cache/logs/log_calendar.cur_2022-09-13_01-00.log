derosamente m\u00e1s complicadas. El proyecto de la fundaci\u00f3n consiste en explorar las riesgos y contradicciones  de la imagen-documento, cuestionando un mundo en el que todo es visible. Organiza tres exhibiciones temporales cada a\u00f1o.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Fondation A Stichting","address_street_name":"Avenue Van Volxem","address_street_number":"304","address_street_box":null,"email":"info@fondationastichting.be","website":"http:\/\/www.fondationastichting.be","phone_contact":"+32 2 502 38 78","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 304","address_line2":"1190 Forest","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Fondation A Stichting","address_street_name":"Avenue Van Volxem","address_street_number":"304","address_street_box":null,"email":"info@fondationastichting.be","website":"http:\/\/www.fondationastichting.be","phone_contact":"+32 2 502 38 78","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 304","address_line2":"1190 Forest","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":[],"zones":{"list":[21],"translations":{"fr":["Sud"],"nl":["Zuid"],"en":["South"]}},"neca":"art_center","facebook_id":null,"backoffice_id":13764,"location":{"lat":50.82266385,"lon":4.32563819},"region":"brussels","last_updated_at":"2022-08-10T15:05:44+02:00","published_at":"2013-10-19T01:38:02+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":251684,"translations":{"fr":{"name":"Fondation A Stichting","address_street_name":"Avenue Van Volxem","address_street_number":"304","address_street_box":null,"email":"info@fondationastichting.be","website":"http:\/\/www.fondationastichting.b