"height":3648,"ratio":1.5,"translations":{"fr":{"title":"Tango","copyright":null},"nl":{"title":"Tango","copyright":null},"en":{"title":"Tango","copyright":null}}},{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/b4a197fc5721f01035d2617976e63c3c421c8545.jpg","width":5472,"height":3648,"ratio":1.5,"translations":{"fr":{"title":"Tango","copyright":null},"nl":{"title":"Tango","copyright":null},"en":{"title":"Tango","copyright":null}}}],"dates":[{"day":"2022-06-15","doors":"19:30:00","start":"20:30:00","end":"22:30:00","is_soldout":false,"is_canceled":false},{"day":"2022-06-16","doors":"19:30:00","start":"20:30:00","end":"22:30:00","is_soldout":false,"is_canceled":false},{"day":"2022-06-17","doors":"19:30:00","start":"20:30:00","end":"22:30:00","is_soldout":false,"is_canceled":false},{"day":"2022-06-18","doors":"19:30:00","start":"20:30:00","end":"22:30:00","is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":18},{"translations":{"fr":{"name":"<= 21 ans"},"nl":{"name":"<= 21 jaar"},"en":{"name":"<= 21 years"}},"value":12},{"translations":{"fr":{"name":"Senior"},"nl":{"name":"Senioren"},"en":{"name":"Senior"}},"value":16},{"translations":{"fr":{"name":"Enfants"},"nl":{"name":"Kinderen"},"en":{"name":"Children"}},"value":16},{"translations":{"fr":{"name":"Groupe"},"nl":{"name":"Groepen"},"en":{"name":"Group"}},"value":14}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":{"list":[255,265],"translations":{"fr":["Accessible","WC adapt\u00e9"],"nl":["Toegankelijk","Aangepast toilet"],"en":["Accessible","Adapted toilet"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-05-12T15:35:24+02:00","published_at":"2022-04-27T10:21:20+02:00","backoffice_id":252646,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":0.62996052494744},{"id":533656,"date_start":"2022-06-15","date_end":"2022-06-15","date_next":"2022-06-15","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{"list":[249],"translations":{"fr":["Les incontournables "],"nl":["Highlights"],"en":["Highlights"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Palais de Justice de Bruxelles","shortdescr":"Le Palais de Justice est un cas \u00e0 part, un v\u00e9ritable \u201cmonument\u201d, dans tous les sens du terme, du patrimoine bruxellois... Gigantesque, ce colosse est plus grand que la basilique Saint-Pierre de Rome !","longdescr":"Le Palais de Justice est un cas \u00e0 part, un v\u00e9ritable \u201cmonument\u201d, dans tous les sens du terme, du patrimoine bruxellois... Gigantesque, ce colosse est plus grand que la basilique Saint-Pierre de Rome ! Au moment de la construction du b\u00e2timent, l\u2019intention est claire : tout est fait pour impressionner, depuis l\u2019ext\u00e9rieur comme \u00e0 l\u2019int\u00e9rieur. Lieu symbolique, porteur d\u2019une lourde histoire, le palais de justice est \u00e9rig\u00e9 sur l\u2019ancien \u201cMont des Potences\u201d, o\u00f9 l\u2019on ex\u00e9cutait les condamn\u00e9s au Moyen \u00c2ge. La l\u00e9gende raconte qu\u2019au 16e si\u00e8cle, le c\u00e9l\u00e8bre m\u00e9decin V\u00e9sale allait y d\u00e9rober les cadavres la nuit pour \u00e9tudier le corps humain\u2026\nC\u2019est un des monuments les plus impressionnants de Bruxelles qui offre \u00e0 ses c\u00f4t\u00e9s un panorama \u00e9poustouflant sur le bas de la ville. Il est l\u2019\u0153uvre de Joseph Poelart, qui remporte le concours international mis en place par le gouvernement belge en 1860. L\u2019inauguration du palais aura lieu le 15 octobre 1883, 4 ans apr\u00e8s la mort de son architecte.\nAdul\u00e9 par certains, d\u00e9cri\u00e9 par d\u2019autres, cet ouvrage pharaonique compte 40.000 m\u00b2 de surface exploitable ; sa coupole culmine \u00e0 plus de 100 m\u00e8tres de hauteur et il contient plus de 250 locaux dont 27 salles d\u2019audience impressionnantes !La visite du palais de justice vous permettra d\u2019en savoir plus sur son histoire truculente, mais aussi sur l\u2019architecture du b\u00e2timent, sur les \u0153uvres d\u2019art qu\u2019il renferme ou encore sur le syst\u00e8me judiciaire belge.Les visites en fran\u00e7ais sont assur\u00e9es par Arkadia et les visites en n\u00e9erlandais et en anglais par Korei Guides Tours.\nRemarques importantes :\nLes r\u00e9servations ne peuvent se faire qu'en ligne \u00e0 l'avance. Nous demandons aux visteurs d'arriver 15 min en avance pour passer le contr\u00f4le de s\u00e9curit\u00e9. Les retardataires ne pouront plus rejoindre le groupe.\nContr\u00f4le de s\u00e9curit\u00e9 : les objets tranchants tels que couteaux, compas, etc. sont interdits.Le b\u00e2timent a un acc\u00e8s limit\u00e9 pour les participants \u00e0 mobilit\u00e9 r\u00e9duite. Veuillez contacter info@arkadia.be \u00e0 l'avance pour voir ce qui est possible.\nLes photos sont autoris\u00e9es sauf dans les salles d'audience quand une audience est en cours.\nVous pouvez r\u00e9server des visites pour les groupes en semaine ici\nEn collaboration avec Urban.brussels \u2013 Service Public F\u00e9d\u00e9ral Justice \u2013 R\u00e9gie des B\u00e2timents","performers":null,"boxoffice_url":null,"website":"http:\/\/www.arkadia.be","email":"info@arkadia.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/533656.html"},"nl":{"name":"Palais de Justice de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.arkadia.be","email":"info@arkadia.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/533656.html"},"en":{"name":"Palais de Justice de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.arkadia.be","email":"info@arkadia.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/533656.html"},"de":{"name":"Palais de Justice de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/533656.html"},"it":{"name":"Palais de Justice de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/533656.html"},"sp":{"name":"Palais de Justice de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/533656.html"},"pt":{"name":"Palais de Justice de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/533656.html"},"cn":{"name":"Palais de Justice de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/533656.html"}},"place":{"id":232780,"translations":{"fr":{"name":"Le Palais de Justice de Bruxelles","address_street_name":"Place Poelaert","address_street_number":"1","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Poelaert, 1","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Het Brusselse Justitiepaleis","address_street_name":"Poelaertplein","address_street_number":"1","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Poelaertplein, 1","address_line2":"1000 Brussel","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Le Palais de Justice de Bruxelles","address_street_name":"Place Poelaert","address_street_number":"1","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Place Poelaert, 1","address_line2":"1000 Brussels","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Der Br\u00fcsseler Justizpalast","address_street_name":"Pl. Poelaert","address_street_number":"1","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Pl. Poelaert, 1","address_line2":"1000 Bruxelles","description_web":"Der Br\u00fcsseler Justizpalast z\u00e4hlt zu den bemerkenswertesten und gleichzeitig bombastischsten europ\u00e4ischen Monumenten des 19. Jh. und ist in Europa noch heute der gr\u00f6\u00dfte seiner Art.\r\n\r\nMajest\u00e4tische Dimensionen: Die L\u00e4ngs- und die Querachse des Bauwerks messen 160 bzw. 150 Meter. Die Gesamtfl\u00e4che bel\u00e4uft sich auf 26 000 m\u00b2 mit acht Innenh\u00f6fen. Dominiert wird das imposante Rechteck von einer massiven Kuppel (24 000 Tonnen) in einer H\u00f6he von 142 Metern. Architektonisch herrscht der griechisch-r\u00f6mische Stil vor. Die belgischen K\u00f6nige Leopold I. und Leopold II. wollten mit diesem symboltr\u00e4chtigen Bauwerk hoch \u00fcber der Stadt zwischen Ober- und Unterstadt ein Zeichen f\u00fcr den damals noch jungen,1830 gegr\u00fcndeten belgischen Staat setzen.\r\n\r\nEin architektonisches Mammutprojekt: Mit dem Bau wurde der Architekt Joseph Poelaert beauftragt. Von der Grundsteinlegung 1866 bis zur Einweihung 1883 vergingen ganze 17 Jahre, sie fand im Jahr 1883, bereits einige Jahre nach dem Tode Poelaerts, statt.\r\n\r\nGestern & heute: Gesellschaftlich sorgte der Bau des Kolosses seinerzeit f\u00fcr Unmut, da gro\u00dfe Teile des volkst\u00fcmlichen Marollenviertels dem Justizpalast weichen mussten - und auch heute ist er nicht unumstritten: Seit Mitte der 80er Jahre ist die Kuppel von Bauger\u00fcsten umgeben, von denen aus Sicherungs- und Restaurierungsarbeiten durchgef\u00fchrt werden.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Palazzo di Giustizia di Bruxelles","address_street_name":"pl. Poelaert","address_street_number":"1","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"pl. Poelaert, 1","address_line2":"1000 Bruxelles","description_web":"Costruito tra il 1866 ed il 1883 dall'architetto Poelaert, maestoso simbolo della potenza della giustizia, \u00e8 il pi\u00f9 grande edificio eretto nel XIX secolo in Occidente.\u00a0...\r\n\"Costruito tra il 1866 ed il 1883 dall'architetto Poelaert, maestoso simbolo della potenza della giustizia, \u00e8 il pi\u00f9 grande edificio eretto nel XIX secolo in Occidente.Su una superficie di 26.000 m\u00b2, 27 sale d'udienza, 245 sale...ispirazione di stile classico greco-romano. \r\nDa vedere: la sala dei Pas-Perdus sovrastata da una grandiosa cupola che si erge a 100 m dal suolo, le gallerie del primo piano, il panorama (dalla terrazza) sulla citt\u00e0 bassa e sul quartiere di Marolles\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"El Palacio de Justicia de Bruselas y su espectacular mirador","address_street_name":"pl. Poelaert","address_street_number":"1","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"pl. Poelaert, 1","address_line2":"1000 Bruxelles","description_web":"Construido entre 1866 y 1883 por Poelaert, este majestuoso s\u00edmbolo de la justicia, constituy\u00f3 la mayor construcci\u00f3n del s. XIX en Occidente....\r\n\"Construido entre 1866 y 1883 por Poelaert, este majestuoso s\u00edmbolo de la justicia, constituy\u00f3 la mayor construcci\u00f3n del s. XIX en Occidente.\r\nVisita:Sus 26.000 m de superficie, 27 salas de audiencia, 245 salas...\r\nEl estilo grecorromano cl\u00e1sico \r\nLa sala Pas-Perdus con una grandiosa c\u00fapula a 100 m de altura\r\nLas galer\u00edas de la primera planta\r\nEl mirador que hay en la plaza, con vistas a la parte baja de la ciudad \r\nEl ascensor acristalado que te llevar\u00e1 al Barrio de Les Marolles\r\nEl mirador de noche\r\n\r\nRecuerda que, por la noche, el Palacio de Justicia se ilumina ofreciendo una imagen evocadora.\"\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Le Palais de Justice de Bruxelles","address_street_name":"Place Poelaert","address_street_number":"1","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Poelaert, 1","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Le Palais de Justice de Bruxelles","address_street_name":"Place Poelaert","address_street_number":"1","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Poelaert, 1","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[2],"translations":{"fr":["Marolles"],"nl":["Marollen"],"en":["Marolles"]}},"zones":{"list":[19],"translations":{"fr":["Centre"],"nl":["Centrum"],"en":["Centre"]}},"neca":null,"facebook_id":null,"backoffice_id":1128,"location":{"lat":50.83701292,"lon":4.35210879},"region":"brussels","last_updated_at":"2022-06-10T04:05:41+02:00","published_at":"2013-10-19T01:14:04+02:00","import_origin":null,"external_id":null,"is_in_address_book":false,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":1487,"translations":{"fr":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"http:\/\/www.arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Arkadia","address_street_name":"Naamsestraat","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"http:\/\/www.arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Naamsestraat, 10","address_line2":"1000 Brussel","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Arkadia","address_street_name":"rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"http:\/\/www.arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"rue de Namur, 10","address_line2":"1000 Brussels","description_web":"As specialists in architectural heritage and contemporary art, we make the public (re)discover the city through guided tours and conferences in several languages. \r\n\r\nOur activities :\r\nGuided tours by foot, bus and metro - Educational projects - Exceptional interior visit- Team Building \r\n\r\nArkadia offers a wide selection of guided tours, under different forms: \r\n* For individual, we propose an annual programmation (almost only in French), which will make you take a new and attentive look on the city of Brussels. \r\n* For groups we offer a series of fun and original activities, around history, architecture, art and in exceptional interiors. \r\n* For schools and children, we offer thematic, educational and entertaining tours and stages. \r\n\r\nOur expertise : Our team is made up of 60 guides, historians and art historians. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"http:\/\/www.arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"http:\/\/www.arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"h