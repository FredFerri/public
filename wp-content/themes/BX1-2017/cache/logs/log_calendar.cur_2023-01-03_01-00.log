e":"Normal"},"cn":{"name":"Normal"}},"value":9},{"translations":{"fr":{"name":"Enfants"},"nl":{"name":"Kinderen"},"en":{"name":"Children"},"de":{"name":"Kinder"},"it":{"name":"Enfants"},"sp":{"name":"Enfants"},"pt":{"name":"Enfants"},"cn":{"name":"Enfants"}},"value":8},{"translations":{"fr":{"name":"Article 27"},"nl":{"name":"Artikel 27"},"en":{"name":"Article 27"},"de":{"name":"Article 27"},"it":{"name":"Article 27"},"sp":{"name":"Article 27"},"pt":{"name":"Article 27"},"cn":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[],"targets":{"list":[11],"translations":{"fr":["Famille"],"nl":["Familie"],"en":["Family"],"de":["Familie"],"it":[null],"sp":[null],"pt":[null],"cn":[null]}},"tags":["kids"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-11-23T15:53:20+01:00","published_at":"2022-10-11T09:59:44+02:00","backoffice_id":262659,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":1},{"id":545973,"date_start":"2023-01-21","date_end":"2023-01-22","date_next":"2023-01-21","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater","it":null,"sp":null,"pt":null,"cn":null}},"others":{"list":[52],"translations":{"fr":["Th\u00e9\u00e2tre musical"],"nl":["Muziektheater"],"en":["Musical theatre"],"de":["Musiktheater"],"it":[null],"sp":[null],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Schubert est amoureux","shortdescr":"SCHUBERT EST AMOUREUX est un spectacle musical humoristique pour les enfants et leurs parents, qui raconte l'histoire vraie du premier amour de Franz Schubert.","longdescr":"SCHUBERT EST AMOUREUX est un spectacle musical humoristique pour les enfants et leurs parents, qui raconte l'histoire vraie du premier amour de Franz Schubert. La Truite raconte comment le grand compositeur est tomb\u00e9 amoureux de Th\u00e9r\u00e8se, une jolie chanteuse de sa chorale. Th\u00e9r\u00e8se aime beaucoup la musique de Franz Schubert. Mais elle aime aussi beaucoup\u2026 les croissants. Quel affreux dilemme, que de devoir choisir entre la musique et la p\u00e2tisserie!\r\nSCHUBERT EST AMOUREUX raconte la grande histoire d\u2019amour de Franz Schubert avec Th\u00e9r\u00e8se Grob, et sa sublimation dans la musique. \r\nUne initiation tendre et d\u00e9cal\u00e9e aux Lieder de Franz Schubert, l\u2019un des premiers grands romantiques viennois.","performers":"Ecriture et mise en sc\u00e8ne : Sophie van der Stegen\r\nAvec : Sarah Laulan, dans le r\u00f4le de Th\u00e9r\u00e8se Grob\r\nNN, dans le r\u00f4le de Schubert et NN dans le r\u00f4le de la truite","boxoffice_url":null,"website":"https:\/\/www.cieartichoke.com","email":"asblartichoke@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.545973"},"nl":{"name":"Schubert is verliefd","shortdescr":"SCHUBERT IS IN LOVE is een humoristische muziekvoorstelling voor kinderen en hun ouders, die het ware verhaal vertelt van de eerste liefde van Franz Schubert.","longdescr":"SCHUBERT IS IN LOVE is een humoristische muziekvoorstelling voor kinderen en hun ouders, die het ware verhaal vertelt van de eerste liefde van Franz Schubert. De Forel vertelt het verhaal van hoe de grote componist verliefd werd op Therese, een van de mooie zangeressen in zijn koor. Therese houdt erg van Franz Schubert's muziek. Maar ze houdt ook van... croissants. Wat een vreselijk dilemma is het om te moeten kiezen tussen muziek en gebak!\r\nSCHUBERT IS IN LOVE vertelt het verhaal van Franz Schuberts grote liefdesaffaire met Th\u00e9r\u00e8se Grob, en de sublimatie daarvan in de muziek. \r\nEen tedere en onconventionele inleiding tot de liederen van Franz Schubert, een van de eerste grote Weense romantici.","performers":"Geschreven en geregisseerd door Sophie van der Stegen\r\nMet: Sarah Laulan, als Th\u00e9r\u00e8se Grob\r\nNN als Schubert en NN als de forel","boxoffice_url":null,"website":"https:\/\/www.cieartichoke.com","email":"asblartichoke@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.545973"},"en":{"name":"Schubert is in love","shortdescr":"SCHUBERT IS IN LOVE is a humorous musical show for children and their parents, which tells the true story of Franz Schubert's first love.","longdescr":"SCHUBERT EST AMOUREUX is a humorous musical show for children and their parents, which tells the true story of Franz Schubert's first love. The Trout tells the story of how the great composer fell in love with Therese, a pretty singer in his choir. Therese loves Franz Schubert's music very much. But she also loves... croissants. What a terrible dilemma it is to have to choose between music and pastries!\r\nSCHUBERT EST AMOUREUX tells the story of Franz Schubert's great love affair with Th\u00e9r\u00e8se Grob, and its sublimation in music. \r\nA tender and offbeat introduction to the Lieder of Franz Schubert, one of the first great Viennese romantics.","performers":"Written and directed by Sophie van der Stegen\r\nWith : Sarah Laulan, as Th\u00e9r\u00e8se Grob\r\nNN as Schubert and NN as the trout","boxoffice_url":null,"website":"https:\/\/www.cieartichoke.com","email":"asblartichoke@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.545973"},"de":{"name":"Schubert is verliefd","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.545973"},"it":{"name":"Schubert is verliefd","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.545973"},"sp":{"name":"Schubert is verliefd","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.545973"},"pt":{"name":"Schubert is verliefd","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.545973"},"cn":{"name":"Schubert is verliefd","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.545973"}},"place":{"id":67,"translations":{"fr":{"name":"Petit Th\u00e9\u00e2tre Mercelis","address_street_name":"Rue Mercelis","address_street_number":"13","address_street_box":null,"email":"culture@ixelles.brussels","website":"https:\/\/culture.ixelles.be\/fr\/mercelis\/","phone_contact":"+32 2 515 64 63","phone_booking":"+32 2 515 64 63","address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Mercelis, 13","address_line2":"1050 Ixelles","description_web":"Sp\u00e9cialis\u00e9 dans les spectacles jeune public, le th\u00e9\u00e2tre Mercelis est un \u00e9crin au c\u0153ur d\u2019Ixelles. Il accueille public et artistes en r\u00e9sidence tout au long de la saison.\r\n","description_print":"Sp\u00e9cialis\u00e9 dans les spectacles jeune public, le th\u00e9\u00e2tre Mercelis est un \u00e9crin au c\u0153ur d\u2019Ixelles. Il accueille public et artistes en r\u00e9sidence tout au long de la saison.\r\n","booking_url":null,"so