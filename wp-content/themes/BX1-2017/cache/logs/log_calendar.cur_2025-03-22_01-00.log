ations":{"de":{"name":"BANAD Festival - Art Nouveau and Art Deco Antiques Fair","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700006762"},"pt":{"name":"BANAD Festival - Art Nouveau and Art Deco Antiques Fair","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700006762"},"en":{"name":"BANAD Festival - Art Nouveau and Art Deco Antiques Fair","shortdescr":null,"longdescr":"On Saturday 29 and Sunday 30 March 2025, the 10th Art Nouveau and Art Deco Collectors' and Valuation Fair will be held in the superb surroundings of an Art Nouveau school designed by Henri Jacobs and built between 1907 and 1922. The Fair will consist of around 50 collectors and dealers with ornaments, small pieces of furniture, glassware, silverware, ceramics, books and posters on display and for sale, plus restoration experts who will be demonstrating their skills, plus, on the Sunday only, free valuations by Jean-Jacques Wattel of Art Research (Paris). Also present, on both days, will be representatives of Brussels heritage associations.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/en\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700006762"},"it":{"name":"BANAD Festival - Art Nouveau and Art Deco Antiques Fair","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700006762"},"cn":{"name":"BANAD Festival - Art Nouveau and Art Deco Antiques Fair","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700006762"},"fr":{"name":"BANAD Festival - Foire d'objets et salon de restaurateurs","shortdescr":null,"longdescr":"Le samedi 29 et dimanche 30 mars 2025, se d\u00e9roulera la 10e \u00e9dition de la Foire d'objets Art nouveau et Art D\u00e9co dans le cadre d'un superbe complexe scolaire Art nouveau construit par Henri Jacobs (1907-1922). La foire sera doubl\u00e9e d'un salon de restaurateurs du patrimoine et, le dimanche, d'une journ\u00e9e d'expertises assur\u00e9es par Jean-Jacques Wattel et Art Research Paris. Des associations de sensibilisation au patrimoine bruxellois seront \u00e9galement pr\u00e9sentes durant les deux jours. Environ cinquante collectionneurs et marchands pr\u00e9senteront \u00e0 la vente des objets, petits meubles, livres, affiches... Des techniques telles que le verre, l'orf\u00e8vrerie, l'\u00e9dition et la c\u00e9ramique seront particuli\u00e8rement bien repr\u00e9sent\u00e9es.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700006762"},"sp":{"name":"BANAD Festival - Art Nouveau and Art Deco Antiques Fair","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700006762"},"nl":{"name":"BANAD Festival - Objecten en Erfgoedrestaurateurs beurs","shortdescr":null,"longdescr":"Op zaterdag 29 en zondag 30 maart 2025 vindt de 10de editie van de Objectenbeurs Art nouveau en Art Deco plaats. Het schouwtoneel is een prachtig schoolgebouw in art-nouveaustijl, gebouwd door Henri Jacobs (1907-1922). De beurs wordt gecombineerd met een vakbeurs voor erfgoedrestaurateurs en op zondag met een expertisedag, georganiseerd door Jean-Jacques Wattel van Art Research (Parijs). Die twee dagen zullen er ook organisaties zijn die het Brussels erfgoed belichten. Zo'n vijftig verzamelaars en handelaars verkopen er objecten, kleine meubels, boeken, affiches enz. Vooral technieken zoals glasblazen, de edelsmeedkunst, boekbinderij en pottenbakken zullen er goed vertegenwoordigd zijn.'","performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/nl\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700006762"}},"place":{"id":279677,"translations":{"de":{"name":"Foire d'objets Art nouveau et Art D\u00e9co","address_street_name":"Rue Victor Hugo 205 1030 Schaerbeek Belgique","address_street_number":"205","address_street_box":"1","email":"cecile8968@hotmail.com","website":null,"phone_contact":"+32 478 22 92 28","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Rue Victor Hugo 205 1030 Schaerbeek Belgique, 205 \/ 1","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Foire d'objets Art nouveau et Art D\u00e9co","address_street_name":"Rue Victor Hugo 205 1030 Schaerbeek Belgique","address_street_number":"205","address_street_box":"1","email":"cecile8968@hotmail.com","website":null,"phone_contact":"+32 478 22 92 28","phone_booking":null,"address_zip":"1030","a