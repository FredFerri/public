enda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700005255"},"pt":{"name":"Art D\u00e9co \u00e0 Jette","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.itineraires.be\/art-nouveau-art-deco","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700005255"},"en":{"name":"Art D\u00e9co \u00e0 Jette","shortdescr":"Discover the history of the commune and its architectural reflection along the streets around Place Cardinal Mercier and Place du Miroir. Immerse yourself in the captivating world of Art Deco and discover Jette's architectural treasures!","longdescr":"Embark on a fascinating stroll through Jette, discovering the treasures of Art Deco. Start your exploration at the Maison de Magritte, hidden away in the former hamlet of Esseghem. Discover the town's history and its architectural reflection along the streets around Place Cardinal Mercier and Place du Miroir. Immerse yourself in the captivating world of Art Deco and discover Jette's architectural treasures!","performers":null,"boxoffice_url":null,"website":"https:\/\/www.itineraires.be\/art-nouveau-art-deco","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700005255"},"it":{"name":"Art D\u00e9co \u00e0 Jette","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.itineraires.be\/art-nouveau-art-deco","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700005255"},"cn":{"name":"Art D\u00e9co \u00e0 Jette","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.itineraires.be\/art-nouveau-art-deco","email":"info@itineraires.be","pho