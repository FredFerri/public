 175 euros qui donne acc\u00e8s 2 jours \u00e0 l'\u00e9v\u00e9nement (panels, etc.) et la possibilit\u00e9 d'acheter des extras avec les invit\u00e9s\r\n","longdescr":null,"performers":"Holly Marie Combs (Charmed); Rose McGowan (Charmed); James Lafferty & Antwon Tanner (Les Fr\u00e8res Scott); David Conrad (Ghost Whisperer); et plus \u00e0 venir!","boxoffice_url":null,"website":"https:\/\/flyawayconventions.com","email":"jean.flyawayconventions@gmail.com","phone_contact":null,"phone_booking":"+32 470 33 13 41","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.555907"},"sp":{"name":"So 2000's : Back To My Teenage Years","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/flyawayconventions.com","email":"jean.flyawayconventions@gmail.com","phone_contact":null,"phone_booking":"+32 470 33 13 41","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.555907"},"nl":{"name":"So 2000's : Back To My Teenage Years","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/flyawayconventions.com","email":"jean.flyawayconventions@gmail.com","phone_contact":null,"phone_booking":"+32 470 33 13 41","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.555907"}},"place":{"id":260160,"translations":{"de":{"name":"Lieu \u00e0 confirmer","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Lieu \u00e0 confirmer","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Lieu \u00e0 confirmer","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles