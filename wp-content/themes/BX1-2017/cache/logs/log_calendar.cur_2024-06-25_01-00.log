null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Muntpunt","address_street_name":"Place de la Monnaie","address_street_number":"6","address_street_box":null,"email":"info@muntpunt.be","website":"http:\/\/www.muntpunt.be","phone_contact":"+32 2 278 11 11","phone_booking":"+32 2 278 11 11","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Monnaie, 6","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Muntpunt","address_street_name":"Place de la Monnaie","address_street_number":"6","address_street_box":null,"email":"info@muntpunt.be","website":"http:\/\/www.muntpunt.be","phone_contact":"+32 2 278 11 11","phone_booking":"+32 2 278 11 11","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Monnaie, 6","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Muntpunt","address_street_name":"Place de la Monnaie","address_street_number":"6","address_street_box":null,"email":"info@muntpunt.be","website":"http:\/\/www.muntpunt.be","phone_contact":"+32 2 278 11 11","phone_booking":"+32 2 278 11 11","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Monnaie, 6","address_line2":"1000 Bruxelles","description_web":"Muntpunt est une biblioth\u00e8que, un lieu d'information et de rencontres. Laissez-vous inspirer par des livres, des histoires et des rencontres adapt\u00e9es \u00e0 la capitale. Apprenez tout sur le travail, les \u00e9tudes, et la vie \u00e0 Bruxelles et en Flandre. D\u00e9couvrez la richesse de l' offre culturelle n\u00e9erlandophone des organisations bruxelloises et flamandes.  ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Muntpunt","address_street_name":"Place de la Monnaie","address_street_number":"6","address_street_box":null,"email":"info@muntpunt.be","website":"http:\/\/www.muntpunt.be","phone_contact":"+32 2 278 11 11","phone_booking":"+32 2 278 11 11","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Monnaie, 6","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Muntpunt ","address_street_name":"Muntplein","address_street_number":"6","address_street_box":null,"email":"info@muntpunt.be","website":"http:\/\/www.muntpunt.be","phone_contact":"+32 2 278 11 11","phone_booking":"+32 2 278 11 11","address_zip":"1000","address_city":"Brussel","address_line1":"Muntplein, 6","address_line2":"1000 Brussel","description_web":"Muntpunt is een bibliotheek, informatiehuis, ontmoetingsplek en je venster op Brussel. Laat je inspireren door boeken, verhalen en ontmoetingen op maat van de hoofdstad. Kom meer te weten over wonen, werken, studeren, leven en beleven in Brussel en Vlaanderen. Ontdek het rijke Nederlandstalige culturele en vrijetijdsaanbod van Brusselse en Vlaamse organisaties.\r\n\r\nIn Muntpunt kan je meer dan alleen boeken, cd\u2019s en dvd\u2019s ontlenen. Je kan er ook terecht voor activiteiten, taalcursussen, infosessies, luisterboeken, strips, spelletjes, en nog veel meer. Er valt bijna dagelijks iets te beleven in Muntpunt, van voorlezen tot documentaires, van infosessies tot rondleidingen, voor jong en oud. De activiteiten sluiten aan bij de bibliotheekwerking of spelen in op actuele thema's, steeds met de Brusselse hoofdstedelijke context in het achterhoofd. De rode draad door de programmatie is de samenwerking met Vlaamse en Brusselse partnerorganisaties. \r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":13020,"location":{"lat":50.84996484,"lon":4.35348679},"last_updated_at":"2022-11-03T17:13:45+01:00","published_at":"2013-10-19T01:35:36+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/1718422856369-muntpunt-00b7129241ef135f674fe6f8b4daa1c2b8ca3e3b.jpg","width":2250,"height":2250,"ratio":1,"oEmbed_height":2250,"oEmbed_width":2250,"translations":{"de":{"title":"Muntpunt Schaakclub","copyright":null},"pt":{"title":"Muntpunt Schaakclub","copyright":null},"en":{"title":"Muntpunt Schaakclub","copyright":null},"it":{"title":"Muntpunt Schaakclub","copyright":null},"cn":{"title":"Muntpunt Schaakclub","copyright":null},"fr":{"title":"Muntpunt Schaakclub","copyright":null},"sp":{"title":"Muntpunt Schaakclub","copyright":null},"nl":{"title":"Muntpunt Schaakclub","copyright":null}}}],"dates":[{"day":"2024-06-26","doors":null,"start":"16:00:00","end":"19:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"de":{"name":"Normal"},"en":{"name":"Normal"},"it":{"name":"Normale"},"fr":{"name":"Normal"},"sp":{"name":"Normal"},"nl":{"name":"Normaal"}},"value":0}],"date_exceptions":[],"closing_days":[],"child_events":[],"parent_events":[],"accessibilities":[],"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[]},{"id":50011198,"date_start":"2024-06-26","date_end":"2024-07-26","date_next":"2024-06-26","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":true,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-06-24T11:05:00+02:00","published_at":"2024-05-30T08:28:42+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":true,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":301127,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"festival","ranking":0.5053195481928565,"languages":{"spoken":["fr","en","nl"],"subtitles":[]},"categories":{"main":{"id":118,"translations":{"de":"Festival","pt":null,"en":"Festival","it":"Festival","cn":null,"fr":"Festival","sp":"Festival","nl":"Festival"}},"others":{"list":[126],"translations":{"de":["Zeitgen\u00f6ssische Musik"],"pt":[null],"en":["Contemporary music"],"it":["Musica contemporanea"],"cn":[null],"fr":["Musique Contemporaine"],"sp":["M\u00fasica contempor\u00e1nea"],"nl":["Hedendaagse Muziek"]}}},"translations":{"de":{"name":"Recyclart Holidays 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/recyclart.be\/nl\/agenda\/recyclart-holidays-2024","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50011198"},"pt":{"name":"Recyclart Holidays 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/recyclart.be\/nl\/agenda\/recyclart-holidays-2024","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50011198"},"en":{"name":"Recyclart Holidays 2024","shortdescr":"Viens jouer ! Kom spelen ! This summer, Recyclart is Brussels' playground for all kids, artists, ravers, foodies, and more. It is the last summer before we go into renovation and thus the last Holidays before our buildings will be trashed down. Because of this, this year's Holidays are all about destruction, reconstruction, playfulness and games. Welcome to our PLEIN DE JEUX ! ","longdescr":"Every Wednesday we blow up our homemade bouncy castle, CANAL PALACE. Imagine; children bouncing around, attending building ateliers and fantasizing about the future Recyclart. Parents bathing in the sun and enjoying the delicious food of our Bar Resto while entertained by inflatable performances.  \n\n \n\nOn Thursdays, it\u2019s time for LIVE MUSIC and POP UP COUR. Every week, another collective takes over the courtyard and proposes their take on playfulness. With circus performances by 4Square Cirque, an open-mic with Anticyclone, drag performances by Bal des Monstres and carnival games by Sadistic. While playing, enjoy live music of Brussels-based Aili, post-punk band eat-girls or interdisciplinary artist MUXXXE.  \n\n \n\nPlayful workshops and rituals on joy as a means of resistance and behind-the-scenes tours of the Recyclart are on the program on Friday. Bake your own bread in our wood-fired oven or enjoy a vegan or halal Lahmacun. From 11pm, we welcome you to head into the night and continue playing on a sweaty dance floor. ","performers":null,"boxoffice_url":null,"website":"https:\/\/recyclart.be\/nl\/agenda\/recyclart-holidays-2024","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50011198"},"it":{"name":"Recyclart Holidays 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/recyclart.be\/nl\/agenda\/recyclart-holidays-2024","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50011198"},"cn":{"name":"Recyclart Holidays 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/recyclart.be\/nl\/agenda\/recyclart-holidays-2024","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50011198"},"fr":{"name":"Recyclart Holidays 2024","shortdescr":"Cet \u00e9t\u00e9, Recyclart est le terrain de jeu de Bruxelles pour les enfants, les artistes, les gourmand\u00b7e\u00b7s et bien plus encore. C'est le dernier \u00e9t\u00e9 avant les r\u00e9novations et donc les derni\u00e8res HOLIDAYS avant que nos b\u00e2timents ne soient d\u00e9truits. C'est pourquoi cette ann\u00e9e les HOLIDAYS sont plac\u00e9s sous le signe de la destruction, de la reconstruction et du jeu. Welkom \u00e0 notre PLEIN DE JEUX ! ","longdescr":"Tous les mercredis, nous gonflons notre ch\u00e2teau gonflable maison, le CANAL PALACE. Imaginez les enfants en train de rebondir, de participer \u00e0 un atelier de construction et de fantasmer sur le futur Recyclart. Les parents se baignent au soleil et savourent les d\u00e9licieux plats de notre Bar Resto tout en se divertissant gr\u00e2ce \u00e0 des spectacles gonflables.  \n\n \n\nLe jeudi, place au LIVE MUSIC et au POP UP COUR. Chaque semaine, un collectif diff\u00e9rent prend possession de la cour et apporte sa touche ludique. Au programme, des performances de cirque par 4Square Cirque, un open-mic avec Anticyclone, des performances de drag par le Bal des Monstres et des jeux kermesse avec Sadistic. Tout en jouant, profitez de la musique live du groupe bruxellois Aili, du groupe post-punk eat-girls ou de l'artiste interdisciplinaire MUXXXE.  \n\n \n\nDes ateliers ludiques et des rituels sur le plaisir comme moyen de r\u00e9sistance et des visites du Recyclart sont au programme du vendredi. Faites cuire votre propre pain dans notre four \u00e0 bois ou d\u00e9gustez un Lahmacun v\u00e9gan ou hallal. \u00c0 partir de 23 heures, nous vous invitons \u00e0 entrer dans la nuit et \u00e0 continuer \u00e0 jouer sur une piste de danse pleine de sueur.","performers":null,"boxoffice_url":null,"website":"https:\/\/recyclart.be\/nl\/agenda\/recyclart-holidays-2024","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50011198"},"sp":{"name":"Recyclart Holidays 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/recyclart.be\/nl\/agenda\/recyclart-holidays-2024","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50011198"},"nl":{"name":"Recyclart Holidays 2024","shortdescr":"Viens jouer! Kom spelen! Deze zomer is Recyclart de speeltuin van Brussel voor kinderen, kunstenaars, ravers, foodies, en meer. Het is de laatste zomer voordat we gaan verbouwen en dus de laatste Holidays voordat onze gebouwen in puin liggen. Daarom staan de Holidays dit jaar in het teken van destructie, reconstructie, spel & plezier. Welkom op ons PLEIN DE JEUX! ","longdescr":"Elke woensdag blazen we ons zelfgemaakte springkasteel CANAL PALACE op. Stel je voor; kinderen die rondstuiteren, een bouwatelier volgen en fantaseren over de toekomstige Recyclart. Ouders baden in de zon en genieten van het heerlijke eten van onze Bar Resto terwijl ze worden vermaakt door opblaasbare performances.  \n\n \n\nOp donderdag is het tijd voor LIVE MUZIEK en POP UP COUR. Elke week neemt een ander collectief de binnenplaats over en brengen ze hun kijk op speelsheid. Met circusvoorstellingen door 4Square Cirque, een open-mic met Anticyclone, dragperformances door Bal des Monstres en kermisspelen door Sadistic. Geniet tijdens het spelen van livemuziek van de Brusselse Aili, post-punk band eat-girls of interdisciplinair artiest MUXXXE.  \n\n \n\nSpeelse workshops en rituelen over plezier als middel voor verzet en rondleidingen achter de schermen van de Recyclart staan vrijdag op het programma. Bak je eigen brood in onze houtoven of geniet van een vegan of hallal Lahmacun. Vanaf 23u ontvangen we je om de nacht in te gaan en verder te spelen op een zwetende dansvloer. ","performers":null,"boxoffice_url":null,"website":"https:\/\/recyclart.be\/nl\/agenda\/recyclart-holidays-2024","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50011198"}},"place":{"id":231699,"translations":{"de":{"name":"Recyclart","address_street_name":"rue de Manchester","address_street_number":"13-15","address_street_box":null,"email":"info@recyclart.be","website":"http:\/\/www.recyclart.be","phone_contact":"+32 2 502 57 34","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue de Manchester, 13-15","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"Die alternative Kunst-, Kultur- und Stadtteilinitiative Recyclart betreibt einen der dynamischsten Orte der Stadt. Zwischen Kunst und gesellschaftlichen Themen bietet Recyclart eine bunte und eklektische Vielfalt an Veranstaltungen und Initiativen. Und seit dem Standortwechsel von dem stillgelegten Bahnhof Bruxelles-Chapelle in ein sch\u00f6nes Geb\u00e4ude mit charmanter Terrasse in einem fast schon Berlinerisch anmutenden Innenhof weht seit 2018 abermals ein frischer Wind. Das Projekt f\u00e4chert sich in drei Bereiche auf: Ein Kunstzentrum, die Bar Recyclart (Bar und Restaurant) und die Recyclart Fabrik (Infra-\/Holz-\/Metallwerkst\u00e4tten) mit Wiedereingliederungsma\u00dfnahmen f\u00fcr Langzeitarbeitslose.\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Recyclart","address_street_name":"rue de Manchester","address_street_number":"13-15","address_street_box":null,"email":"info@recyclart.be","website":"http:\/\/www.recyclart.be","phone_contact":"+32 2 502 57 34","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue de Manchester, 13-15","address_line2":"1080 Molenbeek-Saint-Jean","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Recyclart","address_street_name":"rue de Manchester","address_street_number":"13-15","address_street_box":null,"email":"info@recyclart.be","website":"http:\/\/www.recyclart.be","phone_contact":"+32 2 502 57 34","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue de Manchester, 13-15","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"Created in 2000 and now located in Molenbeek since 2018, Recyclart is a multidisciplinary urban project that draws inspiration from the city and its district. A landmark in the history of underground culture in Brussels, it is composed of an ARTS CENTRE and two socio-professional integration projects, namely the RECYCLART BAR and the RECYCLART FABRIK (infra\/wood\/metal workshops).\r\n\r\nAs an art centre, Recyclart connects art to the urban context in which it is embedded. This context acts as a source of inspiration for the artistic activities and, conversely, Recyclart also uses its artistic programme as a catalyst to open up this same urban context and make it more liveable. \r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Recyclart","address_street_name":"rue de Manchester","address_street_number":"13-15","address_street_box":null,"email":"info@recyclart.be","website":"http:\/\/www.recyclart.be","phone_contact":"+32 2 502 57 34","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue de Manchester, 13-15","address_line2":"1080 Molenbeek-Saint-Jean","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Recyclart","address_street_name":"rue de Manchester","address_street_number":"13-15","address_street_box":null,"email":"info@recyclart.be","website":"http:\/\/www.recyclart.be","phone_contact":"+32 2 502 57 34","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue de Manchester, 13-15","address_line2":"1080 Molenbeek-Saint-Jean","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Recyclart","address_street_name":"rue de Manchester","address_street_number":"13-15","address_street_box":null,"email":"info@recyclart.be","website":"http:\/\/www.recyclart.be","phone_contact":"+32 2 502 57 34","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue de Manchester, 13-15","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"Cr\u00e9\u00e9 en 2000 et relocalis\u00e9 depuis 2018 \u00e0 Molenbeek, Recyclart est un projet urbain pluridisciplinaire qui s'inspire de la ville et de son quartier. Haut lieu de l\u2019histoire de la culture underground \u00e0 Bruxelles, il se compose d\u2019un CENTRE D\u2019ARTS et de deux projets d\u2019insertion socioprofessionnelle que sont le BAR RECYCLART et le RECYCLART FABRIK (ateliers infra\/bois\/m\u00e9tal).\r\n\r\nEn tant que centre artistique, Recyclart relie l'art au contexte urbain dans lequel il s'inscrit. Ce contexte sert de source d'inspiration pour les activit\u00e9s artistiques et, inversement, Recyclart utilise \u00e9galement son programme artistique comme un catalyseur pour ouvrir ce m\u00eame contexte urbain et le rendre plus vivable. \r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Recyclart","address_street_name":"rue de Manchester","address_street_number":"13-15","address_street_box":null,"email":"info@recyclart.be","website":"http:\/\/www.recyclart.be","phone_contact":"+32 2 502 57 34","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue de Manchester, 13-15","address_line2":"1080 Molenbeek-Saint-Jean","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Recyclart","address_street_name":"Manchesterstraat ","address_street_number":"13-15","address_street_box":null,"email":"info@recyclart.be","website":"http:\/\/www.recyclart.be","phone_contact":"+32 2 502 57 34","phone_booking":null,"address_zip":"1080","address_city":"Sint-Jans-Molenbeek","address_line1":"Manchesterstraat , 13-15","address_line2":"1080 Sint-Jans-Molenbeek","description_web":"Het multidisciplinaire stadsproject Recyclart bestaat sinds 2000 en verhuisde in 2018 naar Molenbeek, waar het zich blijft inspireren op de stad en de wijk.  Als een van de belangrijkste plekken in de Brusselse underground-geschiedenis combineert het een KUNSTENCENTRUM met twee sociale integratieprojecten, BAR RECYCLART en RECYCLART FABRIK (werkplaats voor hout-, metaal- en infrastructuurwerk).\r\n\r\nMet het kunstencentrum verbindt Recyclart kunst met de stedelijke context waar het deel van uitmaakt. De stad dient als inspiratiebron voor de artistieke activiteiten, maar ook omgekeerd zet Recyclart haar artistieke programma in als katalysator, om zo diezelfde stedelijke context toegankelijker en leefbaarder te maken.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[8],"translations":{"de":["Kanal-Viertel"],"pt":[null],"en":["Canal"],"it":["Canal"],"cn":[null],"fr":["Canal"],"sp":["Canal"],"nl":["Kanaalwijk"]}},"zones":{"list":[23],"translations":{"de":["Westen"],"pt":[null],"en":["West"],"it":["Ovest"],"cn":[null],"fr":["Ouest"],"sp":["Oeste"],"nl":["West"]}},"neca":null,"facebook_id":"RECYCLARTBXL","backoffice_id":973,"location":{"lat":50.84757339,"lon":4.32864108},"region":"brussels","last_updated_at":"2023-09-19T16:52:47+02:00","published_at":"2013-10-19T01:13:57+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":231699,"translations":{"de":{"name":"Recyclart","address_street_name":"rue de Manchester","address_street_number":"13-15","address_street_box":null,"email":"info@recyclart.be","website":"http:\/\/www.recyclart.be","phone_contact":"+32 2 502 57 34","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue de Manchester, 13