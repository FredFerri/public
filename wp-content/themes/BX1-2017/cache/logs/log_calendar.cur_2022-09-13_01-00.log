"main":{"id":90,"translations":{"fr":"Animations","nl":"Animaties","en":"Animations"}},"others":{}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"L\u2019Agora s\u2019installe au parc Victoria","shortdescr":"Du 31 ao\u00fbt au 14 octobre, l\u2019Agora se d\u00e9ploie dans le Parc Victoria.  En cette rentr\u00e9e scolaire, rien de tel que des activit\u00e9s en plein air avant de s\u2019enfermer pour l\u2019hiver. L\u2019occasion notamment de d\u00e9couvrir les activit\u00e9s du Centre Sportif voisin, de participer \u00e0 une Biblioth\u00e8que Vivante, de participer \u00e0 des ateliers cr\u00e9atifs ou de c\u00e9l\u00e9brer le chocolat ! On vous voit bient\u00f4t ?","longdescr":"Du 31 ao\u00fbt au 14 octobre, l\u2019Agora se d\u00e9ploie dans le Parc Victoria.  En cette rentr\u00e9e scolaire, rien de tel que des activit\u00e9s en plein air avant de s\u2019enfermer pour l\u2019hiver. L\u2019occasion notamment de d\u00e9couvrir les activit\u00e9s du Centre Sportif voisin, de participer \u00e0 une Biblioth\u00e8que Vivante, de participer \u00e0 des ateliers cr\u00e9atifs ou de c\u00e9l\u00e9brer le chocolat ! On vous voit bient\u00f4t ?\r\n\r\nLe programme complet \u00e0 d\u00e9couvrir ici https:\/\/bit.ly\/3Oslwdn\r\n\r\nUne programmation propos\u00e9e par les Centres Culturels du Nord-Ouest de Bruxelles Archipel 19 (Berchem-Sainte-Agathe et Koekelberg), La Villa (Ganshoren) et le Centre Culturel de Jette en partenariat avec le Centre Sportif Victoria, La Concertation, la Biblioth\u00e8que francophone de Koekelberg et le Belgian Chocolate Village.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.archipel19.be","email":"c.poinas@culturebruxellesno.be","phone_contact":"+32 478 90 41 99","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.536408"},"nl":{"name":"L\u2019Agora s\u2019installe au parc Victoria","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"websit