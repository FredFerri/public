and sunday: closed","thursday and friday: from 20:30 to 22:00","saturday: from 16:00 to 17:30 and from 20:30 to 22:00"],"sp":["monday, tuesday, wednesday and sunday: closed","thursday and friday: from 20:30 to 22:00","saturday: from 16:00 to 17:30 and from 20:30 to 22:00"],"pt":["monday, tuesday, wednesday and sunday: closed","thursday and friday: from 20:30 to 22:00","saturday: from 16:00 to 17:30 and from 20:30 to 22:00"],"cn":["monday, tuesday, wednesday and sunday: closed","thursday and friday: from 20:30 to 22:00","saturday: from 16:00 to 17:30 and from 20:30 to 22:00"]},"date_start":"2023-06-15","date_end":"2023-09-02","is_also_by_appointment":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"},"de":{"name":"Normal"},"it":{"name":"Normale"},"sp":{"name":"Normal"},"pt":{"name":"Normal"},"cn":{"name":"Normal"}},"value":15},{"translations":{"fr":{"name":"Enfants"},"nl":{"name":"Kinderen"},"en":{"name":"Children"},"de":{"name":"Kinder"},"it":{"name":"Bambini"},"sp":{"name":"Ni\u00f1os"},"pt":{"name":"Enfants"},"cn":{"name":"Enfants"}},"value":10},{"translations":{"fr":{"name":"Jeunes"},"nl":{"name":"Jongeren"},"en":{"name":"Young people"},"de":{"name":"Jugendliche"},"it":{"name":"Ragazzi"},"sp":{"name":"J\u00f3venes"},"pt":{"name":"Jeunes"},"cn":{"name":"Jeunes"}},"value":10},{"translations":{"fr":{"name":"Etudiants"},"nl":{"name":"Studenten"},"en":{"name":"Students"},"de":{"name":"Studierende"},"it":{"name":"Studenti"},"sp":{"name":"Estudiantes"},"pt":{"name":"Etudiants"},"cn":{"name":"Etudiants"}},"value":10},{"translations":{"fr":{"name":"Seniors"},"nl":{"name":"Senioren"},"en":{"name":"Seniors"},"de":{"name":"Senioren"},"it":{"name":"Anziani"},"sp":{"name":"Mayores"},"pt":{"name":"Seniors"},"cn":{"name":"Seniors"}},"value":10},{"translations":{"fr":{"name":"Article 27"},"nl":{"name":"Artikel 27"},"en":{"name":"Article 27"},"de":{"name":"Article 27"},"it":{"name":"Article 27"},"sp":{"name":"Article 27"},"pt":{"name":"Article 27"},"cn":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[],"targets":{"list":[11],"translations":{"fr":["Famille"],"nl":["Familie"],"en":["Family"],"de":["Familie"],"it":["Famiglie"],"sp":["Familias"],"pt":[null],"cn":[null]}},"tags":["kids"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-07-08T03:05:25+02:00","published_at":"2023-06-12T08:13:31+02:00","backoffice_id":279211,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":0.29240177382129},{"id":557538,"date_start":"2023-05-26","date_end":"2024-01-24","date_next":"2023-07-08","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung","it":"Esposizioni","sp":"Exhibici\u00f3n","pt":null,"cn":null}},"others":{"list":[36,46],"translations":{"fr":["Mus\u00e9es et art centers","Pluridisciplinaire"],"nl":["Musea en kunstcentra","Multidisciplinair"],"en":["Museums and art centers","Multidisciplinary"],"de":["Museen & Kunstzentren","Multidisziplin\u00e4r"],"it":["Musei e centri artistici","Multidisciplinare"],"sp":["Museos y centros de arte","Multidisciplinar"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"L'Immortalit\u00e9 chim\u00e9rique. Camille De Taeye dans les livres","shortdescr":"Bon vivant \u00e0 l\u2018humour subversif et au v\u00e9cu tragique, Camille De Taeye (1938-2013) est un artiste peintre bruxellois. \u00c9voluant en marge des tendances et mouvements artistiques, il a con\u00e7u avec plusieurs auteurs et autrices des ouvrages qu\u2019il accompagnait de lithographies. Chaque estampe est un \u00e9cho aux textes mais aussi aux multiples facettes du peintre qui se retrouvent dans ses tableaux.","longdescr":"Bon vivant \u00e0 l\u2018humour subversif et au v\u00e9cu tragique, Camille De Taeye (1938-2013) est un artiste peintre bruxellois \u00e9voluant en marge des tendances et mouvements artistiques. Sa premi\u00e8re \u00e9pouse Gerda Vancluysen, \u00e9crivaine et po\u00e9tesse, l\u2019a initi\u00e9 au monde de l\u2019\u00e9dition. Ensemble, ils ont r\u00e9alis\u00e9 une s\u00e9rie de livres, d\u00e9veloppant un univers pictural et po\u00e9tique qui leur est propre. L\u2019artiste a \u00e9galement con\u00e7u avec plusieurs auteurs et autrices des ouvrages qu\u2019il accompagnait de lithographies tir\u00e9es sur sa presse \u00e0 bras. Chaque estampe est un \u00e9cho aux textes mais aussi aux multiples facettes du peintre qui se retrouvent dans ses tableaux.\r\n\r\nPour Camille De Taeye, la peinture est une forme de r\u00e9silience. Son \u0153uvre est jalonn\u00e9e de plusieurs th\u00e8mes transversaux, incarn\u00e9s par des motifs r\u00e9currents qui traduisent et d\u00e9tournent les drames de son existence \u00e0 travers un imaginaire singulier. Cette exposition propose de d\u00e9couvrir quelques aspects cruciaux de sa cr\u00e9ation : sa syntaxe, ses symboles, qui sont autant d\u2019\u00e9l\u00e9ments grammaticaux n\u00e9cessaires \u00e0 son art relationnel; la cohabitation de l\u2019\u00e9ros et de thanatos ; une forme d\u2019identit\u00e9 belge et les \u00e9quilibres pr\u00e9caires.\r\n\r\nL\u2019ouverture de l\u2019exposition est l\u2019occasion de d\u00e9couvrir le livre \u00c9quilibres pr\u00e9caires de Dani\u00e8le Gillemon, aux \u00c9ditions CFC & La Pierre d\u2019Alun, paru au dixi\u00e8me anniversaire de la disparition de Camille De Taeye.\r\n\r\nAvec le soutien du Fonds Camille De Taeye \u2013 Fondation Roi Baudouin","performers":null,"boxoffice_url":null,"website":"http:\/\/www.wittockiana.org","email":"info@wittockiana.org","phone_contact":"+32 2 770 53 33","phone_booking":"+32 2 770 53 33","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.557538"},"nl":{"name":"L'Immortalit\u00e9 chim\u00e9rique. Camille De Taeye in de boeken","shortdescr":"Camille De Taeye (1938-2013) was een Brusselse schilder met een subversief gevoel voor humor en een tragisch levensverhaal. Hij evolueerde in de marge van artistieke trends en bewegingen en ontwierp boeken met verschillende auteurs, die hij begeleidde met lithografie\u00ebn. Elke prent is een echo van de teksten, maar ook van de vele facetten van de schilder die in zijn schilderijen tot uiting komen.","longdescr":"Camille De Taeye (1938-2013), een levensgenieter met een subversief gevoel voor humor en een tragisch levensverhaal, was een Brusselse schilder die evolueerde in de marge van artistieke bewegingen. Zijn eerste vrouw Gerda Vancluysen, schrijfster en dichteres, introduceerde hem in de wereld van de uitgeverij. Samen produceerden ze een reeks boeken en ontwikkelden zo hun eigen picturale en po\u00ebtische universum. De kunstenaar ontwierp ook boeken met verschillende auteurs, die hij begeleidde met lithografie\u00ebn gedrukt op zijn handpers. Elke prent is een echo van de teksten, maar ook van de vele facetten van de schilder die in zijn schilderijen tot uiting komen.\r\n\r\nVoor Camille De Taeye is schilderen een vorm van veerkracht. Zijn werk wordt gekenmerkt door verschillende transversale thema's, belichaamd door terugkerende motieven die de drama's van zijn bestaan vertalen en omleiden via een singuliere verbeelding. Deze tentoonstelling wil enkele cruciale aspecten van zijn creatie onthullen: zijn syntaxis, zijn symbolen, die noodzakelijke grammaticale elementen vormen voor zijn relationele kunst; het samenleven van eros en thanatos; een vorm van Belgische identiteit en het precaire evenwicht.\r\n\r\nDe opening van de tentoonstelling is een gelegenheid om het boek \u00c9quilibres pr\u00e9caires van Dani\u00e8le Gillemon te ontdekken, uitgegeven door CFC & La Pierre d'Alun op de tiende verjaardag van de dood van Camille De Taeye.\r\n\r\nMet de steun van het Fonds Camille De Taeye - Koning Boudewijnstichting","performers":null,"boxoffice_url":null,"website":"http:\/\/www.wittockiana.org","email":"info@wittockiana.org","phone_contact":"+32 2 770 53 33","phone_booking":"+32 2 770 53 33","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.557538"},"en":{"name":"L'Immortalit\u00e9 chim\u00e9rique. Camille De Taeye in the books","shortdescr":"A bon vivant with a subversive sense of humour and a tragic life, Camille De Taeye (1938-2013) was a Brussels painter who loved books. Evolving on the fringes of artistic trends and movements, he designed books with several authors, which he accompanied with lithographs. Each print is an echo of the texts but also of the multiple facets of the painter that are reflected in his paintings.","longdescr":"A bon vivant with a subversive sense of humour and a tragic life, Camille De Taeye (1938-2013) was a Brussels painter who evolved on the fringes of artistic trends and movements. His first wife Gerda Vancluysen, a writer and poet, introduced him to the world of publishing. Together they produced a series of books, developing their own pictorial and poetic universe. The artist has also designed books with several authors, which he accompanied with lithographs printed on his hand press. Each print is an echo of the texts but also of the multiple facets of the painter that are reflected in his paintings.\r\n \r\n \r\nFor Camille De Taeye, painting is a form of resilience. His work is marked by several transversal themes, embodied by recurring motifs that translate and divert the dramas of his existence through a unique imagery. This exhibition proposes to discover some crucial aspects of his creation: his syntax, his symbols, which are so many grammatical elements necessary to his relational art; the cohabitation of eros and thanatos; a form of Belgian identity and precarious equilibriums.\r\n\r\nThe opening of the exhibition is an opportunity to discover the book \u00c9quilibres pr\u00e9caires by Dani\u00e8le Gillemon, published by CFC & La Pierre d\u2019Alun on the tenth anniversary of Camille De Taeye\u2019s death.\r\n\r\nWith the support of the Fonds Camille De Taeye \u2013 King Baudouin Foundation","performers":null,"boxoffice_url":null,"website":"http:\/\/www.wittockiana.org","email":"info@wittockiana.org","phone_contact":"+32 2 770 53 33","phone_booking":"+32 2 770 53 33","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.557538"},"de":{"name":"L'Immortalit\u00e9 chim\u00e9rique. Camille De Taeye dans les livres","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wittockiana.org","email":"info@wittockiana.org","phone_contact":"+32 2 770 53 33","phone_booking":"+32 2 770 53 33","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.557538"},"it":{"name":"L'Immortalit\u00e9 chim\u00e9rique. Camille De Taeye dans les livres","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wittockiana.org","email":"info@wittockiana.org","phone_contact":"+32 2 770 53 33","phone_booking":"+32 2 770 53 33","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.557538"},"sp":{"name":"L'Immortalit\u00e9 chim\u00e9rique. Camille De Taeye dans les livres","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wittockiana.org","email":"info@wittockiana.org","phone_contact":"+32 2 770 53 33","phone_booking":"+32 2 770 53 33","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.557538"},"pt":{"name":"L'Immortalit\u00e9 chim\u00e9rique. Camille De Taeye dans les livres","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wittockiana.org","email":"info@wittockia