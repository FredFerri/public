de":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":312997,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"concert","ranking":1,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":1,"translations":{"de":"Konzert","pt":null,"en":"Concert","it":"Concerti","cn":null,"fr":"Concert","sp":"Concierto","nl":"Concert"}},"others":{"list":[2],"translations":{"de":["Klassisch"],"pt":[null],"en":["Classical"],"it":["Classica"],"cn":[null],"fr":["Classique"],"sp":["Cl\u00e1sica"],"nl":["Klassiek"]}}},"translations":{"de":{"name":"Immersion dans le concept japonais du \u9593 \"MA\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/ma-artspace.com\/pages\/expositions","email":"info@ma-artspace.com","phone_contact":"+32 470 41 57 56","phone_booking":"+32 470 41 57 56","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700004180"},"pt":{"name":"Immersion dans le concept japonais du \u9593 \"MA\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/ma-artspace.com\/pages\/expositions","email":"info@ma-artspace.com","phone_contact":"+32 470 41 57 56","phone_booking":"+32 470 41 57 56","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700004180"},"en":{"name":"Immersion dans le concept japonais du \u9593 \"MA\"","shortdescr":"This Saturday, January 25, MA. ART SPACE opens its doors to you for an unprecedented immersion into the world of the Japanese concept of \u9593 (MA). On the program, a captivating lecture by Adina Mazzoni-Cernus and a koto and shamisen concert by Aki Sato, all sublimated by an exhibition by artist Michel Mazzoni. An evening to explore this unique notion of space and temporality. ","longdescr":"Exhibition by Michel Mazzoni | 16h00 > 18h00 | free admission\nOn view from January 25 to February 9\n\nArtist Michel Mazzoni reinterprets the aesthetics of AM in a contemporary timeframe. Through his images, he captures spaces, light variations and details, offering a striking illustration of the MA philosophy.\n\nLecture by Adina Mazzoni-Cernus | 6:00 pm > 7:00 pm | booking required\n\nA specialist in Japanese culture, lecturer and journalist Adina Mazzoni-Cernus will explore the concept of MA, covering its history, aesthetics and traditions. She will highlight this pillar of Japanese thought, which influences architecture, music and the art of living by cultivating harmony and rhythm. \n\nConcert by Aki Sato, koto and shamisen player | 7:30 pm > 8:00 pm | reservation required\n\nRenowned koto and shamisen player Aki Sato gives a concert celebrating the MA in traditional Japanese music. Through silences and notes, she illustrates this philosophical concept in which sound and silence dialogue to reveal the beauty of emptiness.","performers":null,"boxoffice_url":null,"website":"https:\/\/ma-artspace.com\/pages\/expositions","email":"info@ma-artspace.com","phone_contact":"+32 470 41 57 56","phone_booking":"+32 470 41 57 56","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700004180"},"it":{"name":"Immersion dans le concept japonais du \u9593 \"MA\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/ma-artspace.com\/pages\/expositions","email":"info@ma-artspace.com","phone_contact":"+32 470 41 57 56","phone_booking":"+32 470 41 57 56","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700004180"},"cn":{"name":"Immersion dans le concept japonais du \u9593 \"MA\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/ma-artspace.com\/pages\/expositions","email":"info@ma-artspace.com","phone_contact":"+32 470 41 57 56","phone_booking":"+32 470 41 57 56","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700004180"},"fr":{"name":"Immersion dans le concept japonais du \u9593 \"MA\"","shortdescr":"Ce samedi 25 janvier, le MA. ART SPACE vous ouvre ses portes pour une immersion in\u00e9dite dans l\u2019univers du concept japonais du \u9593 (MA). Au programme, une conf\u00e9rence captivante d\u2019Adina Mazzoni-Cernus et un concert au koto et au shamisen par Aki Sato, le tout sublim\u00e9 par une exposition de l\u2019artiste Michel Mazzoni. Une soir\u00e9e pour explorer cette notion unique d\u2019espace et de temporalit\u00e9. \n\n","longdescr":"Qu\u2019est-ce que le \u9593 ? \n\nLe MA \u9593 est un concept japonais qui incarne l\u2019espace ou l\u2019intervalle entre les objets et les \u00e9v\u00e9nements, jouant sur les dimensions spatiales et temporelles. Dans la culture japonaise, le MA est essentiel en esth\u00e9tique, en architecture, en musique ou en calligraphie : il incarne le silence entre deux notes, la fluidit\u00e9 des espaces, et le rythme visuel. Le MA est \u00e0 la fois ce qui s\u00e9pare et ce qui unit.\n\nAU PROGRAMME :\n\nExposition de Michel Mazzoni | 16h00 > 18h00 | entr\u00e9e libre\n\u00c0 visiter du 25 janvier au 9 f\u00e9vrier\n\nL\u2019artiste Michel Mazzoni propose une r\u00e9interpr\u00e9tation de l\u2019esth\u00e9tique du MA dans une temporalit\u00e9 contemporaine. \u00c0 travers ses images, il capte des espaces, des variations de lumi\u00e8re et des d\u00e9tails, offrant ainsi une illustration saisissante de la philosophie du MA.\n\nConf\u00e9rence d\u2019Adina Mazzoni-Cernus | 18h00 > 19h00 | sur r\u00e9servation\n\nSp\u00e9cialiste de la culture japonaise, la conf\u00e9renci\u00e8re et journaliste Adina Mazzoni-Cernus explorera le concept du MA, abordant son histoire, son esth\u00e9tique et ses traditions. Elle mettra en lumi\u00e8re ce pilier de la pens\u00e9e japonaise qui influence l\u2019architecture, la musique, et l\u2019art de vivre en cultivant harmonie et rythme. \n\nConcert d\u2019Aki Sato, joueuse de koto et de shamisen | 19h30 > 20h00 | sur r\u00e9servation\n\nLa musicienne Aki Sato, c\u00e9l\u00e8bre joueuse de koto et de shamisen, donnera un concert c\u00e9l\u00e9brant le MA dans la musique traditionnelle japonaise. \u00c0 travers silences et notes, elle illustre ce concept philosophique o\u00f9 le son et le silence dialoguent pour r\u00e9v\u00e9ler la beaut\u00e9 du vide.","performers":"Michel Mazzoni, Adina Mazzoni-Cernus, Aki Sato","boxoffice_url":null,"website":"https:\/\/ma-artspace.com\/pages\/expositions","email":"info@ma-artspace.com","phone_contact":"+32 470 41 57 56","phone_booking":"+32 470 41 57 56","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700004180"},"sp":{"name":"Immersion dans le concept japonais du \u9593 \"MA\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/ma-artspace.com\/pages\/expositions","email":"info@ma-artspace.com","phone_contact":"+32 470 41 57 56","phone_booking":"+32 470 41 57 56","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700004180"},"nl":{"name":"Immersion dans le concept japonais du \u9593 \"MA\"","shortdescr":"Aanstaande zaterdag 25 januari opent de MA. ART SPACE haar deuren voor u open voor een ongekende onderdompeling in de wereld van het Japanse concept van \u9593. Op het programma staan een boeiende lezing van Adina Mazzoni-Cernus en een koto- en shamisenconcert van Aki Sato, aangevuld met een tentoonstelling van kunstenaar Michel Mazzoni. Een avond om deze unieke notie van ruimte en tijd te verkennen. ","longdescr":"Tentoonstelling door Michel Mazzoni | 16h00 > 18h00 | gratis toegang\nTe zien van 25 januari tot 9 februari\n\nDe kunstenaar Michel Mazzoni biedt een herinterpretatie van de esthetiek van AM in een hedendaagse context. Door middel van zijn beelden legt hij ruimtes, variaties in licht en details vast en biedt hij een treffende illustratie van de MA-filosofie.\n\nLezing door Adina Mazzoni-Cernus | 18.00 > 19.00 | reserveren verplicht\n\nAdina Mazzoni-Cernus, gespecialiseerd in Japanse cultuur, geeft een lezing over het concept MA en gaat in op de geschiedenis, esthetiek en tradities ervan. Ze zal de aandacht vestigen op deze pijler van het Japanse denken, die architectuur, muziek en levenskunst be\u00efnvloedt door harmonie en ritme te cultiveren. \n\nConcert door Aki Sato, koto en shamisen speler | 19.30 > 20.00 | reserveren verplicht\n\nDe beroemde koto- en shamisisspeelster Aki Sato geeft een concert over de MA in traditionele Japanse muziek. Door middel van stiltes en noten illustreert ze dit filosofische concept waarin geluid en stilte samenwerken om de schoonheid van leegte te onthullen.","performers":null,"boxoffice_url":null,"website":"https:\/\/ma-artspace.com\/pages\/expositions","email":"info@ma-artspace.com","phone_contact":"+32 470 41 57 56","phone_booking":"+32 470 41 57 56","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700004180"}},"place":{"id":50001409,"translations":{"de":{"name":"Ma. Art Space","address_street_name":"Rue de la Victoire","address_street_number":"102","address_street_box":null,"email":"info@ma-artspace.com","website":"https:\/\/ma-artspace.com","phone_contact":"+32 470 41 57 56","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue de la Victoire, 102","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Ma. Art Space","address_street_name":"Rue de la Victoire","address_street_number":"102","address_street_box":null,"email":"info@ma-artspace.com","website":"https:\/\/ma-artspace.com","phone_contact":"+32 470 41 57 56","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue de la Victoire, 102","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Ma. Art Space","address_street_name":