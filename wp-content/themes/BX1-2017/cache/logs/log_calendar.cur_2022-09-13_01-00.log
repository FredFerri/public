lse,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":0}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"visit_profile":{"list":[328],"translations":{"fr":["Vert & durable"],"nl":["Groen & duurzaam"],"en":["Green & sustainable"]}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-09-12T01:35:25+02:00","published_at":"2022-06-23T03:30:14+02:00","backoffice_id":256236,"import_origin":"explore","sub_type":"other","show_in_agenda":true,"ranking":0.40548013303823},{"id":540961,"date_start":"2022-09-26","date_end":"2022-09-26","date_next":"2022-09-26","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":84,"translations":{"fr":"Divers","nl":"Varia","en":"Various"}},"others":{"list":[89],"translations":{"fr":["Litt\u00e9rature"],"nl":["Literatuur"],"en":["Litterature "]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Les lundis en coulisse","shortdescr":"A la rencontre des \u00e9critures circassiennes contemporaines...","longdescr":"LECTURES CIRQUE ET ARTS DE RUE\r\n26\/09 \u2013 14H > 17H | TOUT PUBLIC\r\nENTR\u00c9E LIBRE\r\n\r\n_____________________________________\r\nLes Lundis en coulisse ont \u00e9t\u00e9 lanc\u00e9s en Belgique en 2015, \u00e0 l\u2019initiative de Silvia Berutti-Ronelt, pour faire d\u00e9couvrir des nouvelles pi\u00e8ces aux professionnel\u00b7le\u00b7s et amateur\u00b7e\u00b7s de th\u00e9\u00e2tre gr\u00e2ce \u00e0 leur participation active. Ils r\u00e9unissent aujourd\u2019hui 15 partenaires et coproducteurs qui invitent une fois par mois les passionn\u00e9\u00b7e\u00b7s professionnel\u00b7le\u00b7s ou amateur\u00b7e\u00b7s \u00e0 d\u00e9couvrir des pi\u00e8ces choisies par un\u00b7e passeur\u00b7euse. Chaque s\u00e9ance se d\u00e9roule dans une ambiance propre \u00e0 chacun des lieux d\u2019accueil et le choix de la passeuse ou du passeur refl\u00e8te \u00e0 chaque fois une sensibilit\u00e9 et un go\u00fbt particulier pour le vaste champ du th\u00e9\u00e2tre contemporain. Cette personnalit\u00e9 pr\u00e9sente bri\u00e8vement chaque pi\u00e8ce, les r\u00f4les sont distribu\u00e9s et les textes lus au d\u00e9bott\u00e9. Une exp\u00e9rience captivante pour tous les participant\u00b7e\u00b7s, qu\u2019ils soient lecteur\u00b7rice\u00b7s ou simples auditeur\u00b7rice\u00b7s !\r\n\r\nPROGRAMME: \u00c9l\u00e9phant \u2013 Les Vrais Majors\r\nLe Cri du Bombyx \u2013 Gorillas Cie\r\nClickIt \u2013 Hopscotch Circus Company\r\nWomanhood \u2013 Mille Lundt","performers":"\u00c9l\u00e9phant \u2013 Les Vrais Majors\r\nLe Cri du Bombyx \u2013 Gorillas Cie\r\nClickIt \u2013 Hopscotch Circus Company\r\nWomanhood \u2013 Mille Lundt","boxoffice_url":null,"website":"http:\/\/www.roseraie.org","email":"secretariat@roseraie.org","phone_contact":null,"phone_booking":"+32 2 376 46 45","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.540961"},"nl":{"name":"Les lundis en coulisse","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.540961"},"en":{"name":"Les lundis en coulisse","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.540961"},"de":{"name":"Les lundis en coulisse","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.br