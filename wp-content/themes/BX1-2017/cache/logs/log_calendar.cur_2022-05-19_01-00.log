 du corps. Cette pratique saine am\u00e9liore la sant\u00e9 et le bien-\u00eatre.\r\n\r\nCes cours sont ouverts pour tout les niveaux: d\u00e9butants, avances et confirm\u00e9s.\r\n\r\nPour plus d'information et inscriptions, veuillez visiter notre site internet.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.redforce.be","email":"contact@redforce.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/516120.html"},"nl":{"name":"Cours de taekwondo pour les enfants de 3-5 ans","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/516120.html"},"en":{"name":"Cours de taekwondo pour les enfants de 3-5 ans","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/516120.html"},"de":{"name":"Cours de taekwondo pour les enfants de 3-5 ans","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/516120.html"},"it":{"name":"Cours de taekwondo pour les enfants de 3-5 ans","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/516120.html"},"sp":{"name":"Cours de taekwondo pour les enfants de 3-5 ans","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/516120.html"},"pt":{"name":"Cours de taekwondo pour les enfants de 3-5 ans","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":