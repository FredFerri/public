sed","wednesday, thursday, friday, saturday and sunday: from 15:00 to 18:00"],"pt":["monday and tuesday: closed","wednesday, thursday, friday, saturday and sunday: from 15:00 to 18:00"],"cn":["monday and tuesday: closed","wednesday, thursday, friday, saturday and sunday: from 15:00 to 18:00"]},"date_start":"2023-03-18","date_end":"2023-06-22","is_also_by_appointment":false}],"closing_days":["2023-04-05","2023-04-06","2023-04-07","2023-04-08","2023-04-09","2023-04-10","2023-04-11"],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":{"list":[255,261],"translations":{"fr":["Accessible","Parking accessible"],"nl":["Toegankelijk","Toegankelijke parking"],"en":["Accessible","Accessible parking"],"de":["Barrierefrei","Barrierefreier Parkplatz"],"it":["Accessibile","Parcheggio accessibile"],"sp":["Habilitado","Estacionamiento habilitado"],"pt":[null,null],"cn":[null,null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2023-04-24T03:05:11+02:00","published_at":"2023-03-20T10:48:22+01:00","backoffice_id":273777,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.27516060407455},{"id":555748,"date_start":"2023-04-13","date_end":"2023-06-10","date_next":"2023-04-26","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung","it":"Esposizioni","sp":"Exhibici\u00f3n","pt":null,"cn":null}},"others":{"list":[24,30],"translations":{"fr":["Galeries d'art","Peinture"],"nl":["Galeries","Schilderkunst"],"en":["Art Galleries","Painting"],"de":["Kunstgalerien","Malerei"],"it":["Gallerie d'arte","Pittura"],"sp":["Galer\u00edas de arte","Pintura"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","en"],"subtitles":[]},"translations":{"fr":{"name":"The Weight of Silence","shortdescr":"In-Gate Gallery a le plaisir de pr\u00e9senter The Weight of Silence, une exposition personnelle de Marie Theres Madani (n\u00e9e en 1993 \u00e0 Vienne, Autriche), \u00e0 l\u2019affiche du 13 avril au 10 juin 2023.","longdescr":"In-Gate Gallery a le plaisir de pr\u00e9senter The Weight of Silence, une exposition personnelle de Marie Theres Madani (n\u00e9e en 1993 \u00e0 Vienne, Autriche), \u00e0 l\u2019affiche du 13 avril au 10 juin 2023.\r\n\r\nAvec ses peintures abstraites grand format, l'artiste cherche un acc\u00e8s sensuel direct \u00e0 elle-m\u00eame et, par extension, \u00e0 son public. L'apparence abstraite et la composition expressive de ses \u0153uvres forcent un \u00e9lan d'engagement et une r\u00e9action \u00e9motionnelle spontan\u00e9e chez le spectateur.\r\nMarie Theres Madani consacre sa premi\u00e8re exposition avec la galerie au th\u00e8me qui joue un r\u00f4le important dans son approche au travail et sa perception du monde en g\u00e9n\u00e9ral. C'est le sujet de la lutte permanente entre les manifestations ext\u00e9rieures de la r\u00e9alit\u00e9, qui peuvent \u00eatre trop bruyantes, excessives et d\u00e9rangeantes, et la voix de l'espace int\u00e9rieur de l'esprit humain, o\u00f9 l'on peut trouver la source vitale de l'\u00e9nergie, de la force, et du flux cr\u00e9atif.\r\nL'exposition comprend des peintures en techniques mixtes sur toile en grands et petits formats des s\u00e9ries The Weight of Silence (2023) et Between the Shadow and the Fold (2022).","performers":"Marie Theres Madani consacre sa premi\u00e8re exposition avec la galerie au th\u00e8me de la lutte permanente entre les manifestations ext\u00e9rieures de la r\u00e9alit\u00e9, qui peuvent \u00eatre trop bruyantes, excessives et d\u00e9rangeantes, et la voix de l'espace int\u00e9rieur de l'esprit humain, o\u00f9 l'on peut trouver la source vitale de l'\u00e9nergie, de la force, et du flux cr\u00e9atif.","boxoffice_url":null,"website":"http:\/\/www.ingategallery.com","email":"info@ingategallery.com","phone_contact":"+32 499 63 74 76","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.555748"},"nl":{"name":"The Weight of Silence","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.ingategallery.com","email":"info@ingategallery.com","phone_contact":"+32 499 63 74 76","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.555748"},"en":{"name":"The Weight of Silence","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.ingategallery.com","email":"info@ingategallery.com","phone_contact":"+32 499 63 74 76","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.555748"},"de":{"name":"The Weight of Silence","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.ingategallery.com","email":"info@ingategallery.com","phone_contact":"+32 499 63 74 76","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.555748"},"it":{"name":"The Weight of Silence","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.ingategallery.com","email":"info@ingategallery.com","phone_contact":"+32 499 63 74 76","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.555748"},"sp":{"name":"The Weight of Silence","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.ingategallery.com","email":"info@ingategallery.com","phone_contact":"+32 499 63 74 76","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.555748"},"pt":{"name":"The Weight of Silence","shortdescr":n