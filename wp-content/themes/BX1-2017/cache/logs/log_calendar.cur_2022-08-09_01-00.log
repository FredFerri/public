e \/ Episode 2","copyright":null},"nl":{"title":"Art D\u00e9co et Modernisme \u00e0 Uccle \/ Episode 2","copyright":null},"en":{"title":"Art D\u00e9co et Modernisme \u00e0 Uccle \/ Episode 2","copyright":null}}}],"dates":[{"day":"2022-08-13","doors":null,"start":"14:00:00","end":"16:00:00","is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":10},{"translations":{"fr":{"name":"Article 27"},"nl":{"name":"Artikel 27"},"en":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-07-27T12:05:44+02:00","published_at":"2022-04-03T03:30:22+02:00","backoffice_id":250790,"import_origin":"explore","sub_type":"other","show_in_agenda":true,"ranking":1.2599210498949},{"id":538354,"date_start":"2022-08-13","date_end":"2022-08-13","date_next":"2022-08-13","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre"}},"others":{"list":[53],"translations":{"fr":["Contes"],"nl":["Verteltheater"],"en":["Tales"]}}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"BABY Zomer Quartier d'\u00e9t\u00e9","shortdescr":null,"longdescr":"VIVEZ UN \u00c9T\u00c9 CULTUREL AVEC ZOMER QUARTIER D\u2019\u00c9T\u00c9\r\nTout l'\u00e9t\u00e9, profitez de nombreuses activit\u00e9s culturelles gratuites, organis\u00e9es en plein air dans diff\u00e9rents quartiers d\u2019Uccle !\r\n\r\nBABY Zomer quartier d\u2019\u00e9t\u00e9\r\nLe samedi 13 ao\u00fbt (en matin\u00e9e), au Parc de Wolvendael\r\nPour les tout-petits de 6 mois \u00e0 3 ans et leurs parents\r\n\r\nAu programme : coin b\u00e9b\u00e9, lecture de contes et conte musical \u00ab Les animaux rythmiques \u00bb d\u2019Esterita : \u00ab Bzzz \u00bb, \u00ab flap - flap - flap \u00bb, \u00ab hou-hou \u00bb, \u00ab ron-ron \u00bb. \u00c0 quoi nous font penser ces bruitages ? D\u00e9couvrez qui se cache derri\u00e8re ces bourdonnements, ces gazouillis et ces ronronnements et laissez-vous emporter par les sons et les m\u00e9lodies des animaux rythmiques !\r\n\r\nSAMEDI 13 ao\u00fbt, de 10h30 \u00e0 12h\r\nActivit\u00e9s en plein air pour les tout-petits de 6 mois \u00e0 3 ans et leurs parents\r\nParc de Wolvendael \u2013 Th\u00e9\u00e2tre de Verdure (entr\u00e9e avenue de Wolvendael \/ Rue Rouge)\r\nGRATUIT - Plus d\u2019infos : culture@uccle.brussels \u2013 02\/605 15 30","performers":null,"boxoffice_url":null,"website":"http:\/\/www.uccle.be","email":"culture@uccle.brussels","phone_contact":"+32 2 605 15 30","phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/538354.html"},"nl":{"name":"BABY Zomer Quartier d'\u00e9t\u00e9","shortdescr":null,"longdescr":"BELEEF EEN CULTURELE ZOMER MET ZOMER QUARTIER D'\u00c9T\u00c9\r\nGeniet de hele zomer lang van tal van gratis culturele activiteiten, georganiseerd in openlucht in verschillende wijken van Ukkel!\r\n\r\nBABY Zomer quartier d\u2019\u00e9t\u00e9\r\nZaterdag 13 augustus (ochtend) - Wolvendael Park\r\nVoor kleine kinderen van 6 maanden tot 3 jaar en hun ouders\r\n\r\nOp het programma : babyhoek, voorlezen van verhaaltjes en muzikale vertelling \"Les animaux rythmiques\" door Esterita: \"Bzzz\", \"flap - flap - flap\", \"hou-hou\", \"ron-ron\". Waar doen deze geluiden ons aan denken? Ontdek wie er achter het gezoem, getjilp en gespin zit en laat je meeslepen door de geluiden en melodie\u00ebn van ritmische dieren !\r\n\r\nZATERDAG 13 augustus van 10.30 uur tot 12.00 uur\r\nBuitenactiviteiten voor peuters van 6 maanden tot 3 jaar en hun ouders\r\nWolvenda