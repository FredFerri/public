gdescr":"Au d\u00e9part de la Guinguette du Parc de Laeken - Bar Andr\u00e9, un guide Arkadia vous fera d\u00e9couvrir l'histoire du parc et de ses environs. Les visites seront \u00e9galement ax\u00e9es sur l'\u00e9cologie et l'environnement et sensibiliseront les habitants \u00e0 l'importance des espaces verts dans la ville. :)\r\n\r\nLe point de rencontre avec le guide se trouve devant le kiosque de la guinguette.\r\nLes visites auront \u00e9galement lieu en cas de pluie.\r\n\r\nAvec le soutien de Bruxelles Environnement","performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/park-tour-visite-au-parc-de-laeken-0","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":"+32 2 319 45 60","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.557943"},"nl":{"name":"PARK TOUR : Visite au Parc de Laeken","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/park-tour-visite-au-parc-de-laeken-0","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":"+32 2 319 45 60","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.557943"},"en":{"name":"PARK TOUR : Visite au Parc de Laeken","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/park-tour-visite-au-parc-de-laeken-0","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":"+32 2 319 45 60","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.557943"},"de":{"name":"PARK TOUR : Visite au Parc de Laeken","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/park-tour-visite-au-parc-de-laeken-0","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":"+32 2 319 45 60","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.557943"},"it":