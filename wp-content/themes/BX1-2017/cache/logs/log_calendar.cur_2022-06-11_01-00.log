n":{"name":"Normal"}},"value":0}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"opening":{"day":"2022-05-19","start":"18:00:00","timestamp":"2022-05-19T18:00:00+02:00","end":"21:00:00","is_only_by_appointment":false},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-06-10T01:07:18+02:00","published_at":"2022-05-12T12:06:36+02:00","backoffice_id":253611,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.19689872388277},{"id":526798,"date_start":"2022-04-23","date_end":"2022-06-26","date_next":"2022-06-10","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[36,46],"translations":{"fr":["Mus\u00e9es et art centers","Pluridisciplinaire"],"nl":["Musea en kunstcentra","Multidisciplinair"],"en":["Museums and art centers","Multidisciplinary"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Thomas Boivin - 'Belleville'","shortdescr":"Black and white analogue documentary photography","longdescr":"Les photographies de Thomas Boivin \u00e0 Belleville, Paris, montrent la ville \u00e0 l\u2019\u00e9tat organique, d\u00e9sordonn\u00e9e. Ces images sont d\u00e9lib\u00e9r\u00e9ment d\u00e9pourvues des marqueurs habituels de la ville planifi\u00e9e par Hausmann mais elles n'en sont pas moins belles, parfois romantiques. Belleville est issue de l'exp\u00e9rience v\u00e9cue de Thomas Boivin, photographiant des lieux et des personnes proches de chez lui, fixant les limites du projet au quartier qu\u2019il pouvait parcourir lentement en une journ\u00e9e.\r\n\r\nBelleville refl\u00e8te le passage du temps, des saisons, le mouvement de l'\u0153il du sol \u00e0 l'arbre, d\u2019une cl\u00f4ture \u00e0 un visage. Boivin reste dans les espaces ouverts, en documentant les limites - cl\u00f4tures, trottoirs, vitrines \u00e0 rideaux \u00e0 travers lesquelles nous ne pouvons pas voir. Il capture des moments priv\u00e9s dans des espaces publics, ses sujets savent qu'il est l\u00e0 et sont complices et confortables m\u00eame s\u2019il reste toujours une distance. Les images collect\u00e9es dansent sur une ligne fine, suffisamment proche pour \u00e9mouvoir, tout en \u00e9vitant l'intrusion.\r\n\r\nPlace de la R\u00e9publique est un travail en cours, montr\u00e9 publiquement pour la premi\u00e8re fois \u00e0 la Fondation A. Contrairement \u00e0 Belleville, ces portraits de la jeunesse parisienne sont pris \u00e0 partir d'une position fixe, Boivin revenant encore et encore sur la m\u00eame place, \u00e0 une courte distance de son domicile, avec un appareil photo mont\u00e9 sur tr\u00e9pied. Comme \u00e0 Belleville, ses sujets sont clairement au courant de la pr\u00e9sence du photographe. Prises ensemble comme s\u00e9rie, ces oeuvres soulignent l'\u00e9change entre le sujet et l'artiste et la profondeur de ce geste simple : t\u00e9moigner de l\u2019existence d\u2019une personne en demandant de faire son portrait.\r\n\r\n\r\nLes deux projets tiennent l\u00e9g\u00e8rement \u00e0 distance la nostalgie et la m\u00e9lancolie profonde de Paris. Au contraire, en enracinant sa pratique dans son propre quartier, les images de Thomas Boivin expriment plut\u00f4t une curiosit\u00e9 pour son environnement imm\u00e9diat, un d\u00e9sir d'une forme d'intimit\u00e9 dans l'espace public et, surtout, un souci des autres.\r\n\r\nTristan Lund, commissaire de l\u2019exposition.","performers":"Les photographies de Thomas Boivin \u00e0 Belleville, Paris, montrent la ville \u00e0 l\u2019\u00e9tat organique, d\u00e9sordonn\u00e9e. Belleville est issue de l'exp\u00e9rience v\u00e9cue de Thomas Boivin, photographiant des lieux et des personnes proches de chez lui, fixant les limites du projet au quartier qu\u2019il pouvait parcourir lentement en une journ\u00e9e.","boxoffice_url":null,"website":"http:\/\/www.fondationastichting.com","email":"info@fondationastichting.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/526798.html"},"nl":{"name":"Thomas Boivin - 'Belleville'","shortdescr":"Zwart-wit analoge documentaire fotografie","longdescr":"Thomas Boivins foto\u2019s van Belleville, in Parijs, tonen de stad in gebruik \u2013 organisch, rommelig, ongeordend. Ze missen opzettelijk de stereotiepe kenmerken van Hausmanns geplande visie op de stad, maar zijn nog steeds mooi, romantisch zelfs. Belleville realiseerde Boivin op basis van zijn eigen ervaringen, hij fotografeerde enkel plaatsen en mensen in de buurt van zijn huis: de grenzen van het project waren bepaald door de afstand die hij op een dag tijd met gemak kon afleggen.\r\n\r\nBelleville weerspiegelt het verstrijken van de tijd, de seizoenen, de beweging van het oog van grond naar boom naar hek naar persoon. Boivin blijft overal in de openbare ruimte, houdt zich aan de paden en documenteert de grenzen \u2013 hekken, trottoirs, etalages met gordijnen waar we niet doorheen kunnen kijken. Hij legt priv\u00e9momenten vast in de openbare ruimte, zijn onderwerpen weten dat hij er is, ze zijn medeplichtig en comfortabel, maar er zijn nog steeds barri\u00e8res. De verzamelde beelden balanceren op een dunne lijn, tussen dichtbij genoeg om te ontroeren en ver genoeg om intrusie vermijden.\r\n\r\nPlace de la R\u00e9publique is een work in progress, dat voor het eerst in het openbaar getoond wordt bij Fondation A Stichting.\r\nIn tegenstelling tot Belleville zijn deze portretten van Parijse jongeren vanuit een vaste positie genomen. Boivin keert telkens terug naar hetzelfde plein, niet ver van zijn woning, met een camera op een statief. Net als in Belleville zijn zijn onderwerpen duidelijk gewillige \u2018sitters\u2019. Het geheel van foto\u2019s benadrukt de relatie tussen onderwerp en kunstenaar en de betekenis van de erkenning van het bestaan van de ander door te vragen om zijn of haar portret te mogen maken.\r\n\r\nBeide projecten zijn lichtjes getekend door de diep doordrongen nostalgie en melancholie van Parijs. Door zijn praktijk te verankeren in zijn eigen buurt drukt Thomas Boivin met zijn beelden vooral een nieuwsgierigheid naar zijn directe omgeving uit, een verlangen naar een vorm van intimiteit in de openbare ruimte en vooral een bekommernis om de anderen.\r\n\r\nTristan Lund, curator van de tentoonstelling.","performers":"Thomas Boivins foto\u2019s van Belleville, in Parijs, tonen de stad in gebruik \u2013 organisch, rommelig, ongeordend. Belleville realiseerde Boivin op basis van zijn eigen ervaringen, hij fotografeerde enkel plaatsen en mensen in de buurt van zijn huis: de grenzen van het project waren bepaald door de afstand die hij op een dag tijd met gemak kon afleggen.","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/526798.html"},"en":{"name":"Thomas Boivin - 'Belleville'","shortdescr":"Photographie noir et blanc analogue documentaire","longdescr":"Thomas Boivin\u2019s photographs of Belleville, Paris show the city in use - organic, messy, disordered. They intentionally lack the stereotypical markers of Hausmann\u2019s planned vision for the city but are still beautiful, romantic even. Belleville was created from Boivin\u2019s lived experience, he only photographed places and people near to his home, the boundaries of the project set by a neighbourhood he would slowly walk in a day.\r\n\r\nBelleville reflects the passing of time, the seasons, the movement of the eye from ground to tree to fence to person. Boivin remains in public spaces throughout, keeping to the paths and documenting the boundaries - fences, pavements, curtained shop windows we cannot see into. He captures private moments in public spaces, his subjects know he is there, they are complicit and comfortable but there are still barriers. The collected images dance a fine line, close enough to feel soulful whilst avoiding intrusion.\r\n\r\nPlace de la R\u00e9publique is still a work in progress, shown publicly for the first time at A Foundation.\r\nIn contrast to Belleville these portraits of Parisian youth are taken from a fixed position, Boivin returning again and again to the same square, a short distance from his home, with a tripod-mounted camera. As in Belleville his subjects are clearly willing \u2018sitters\u2019. And as a group these works emphasise the exchange between subject and artist and the profundity of acknowledging a stranger\u2019s existence by asking to take their portrait.\r\n\r\nBoth projects hold lightly Paris\u2019 deep soaked nostalgia and melancholy. Rather, by rooting his practice within his own neighbourhood, Thomas Boivin\u2019s images express a curiosity for his immediate surroundings, a desire for a form of intimacy in public spaces and, above all, a concern for others.\r\n\r\nTristan Lund, curator of the exhibition.","performers":"Thomas Boivin\u2019s photographs of Belleville, Paris show the city in use - organic, messy, disordered. Belleville was created from Boivin\u2019s lived experience, he only photographed places and people near to his home, the boundaries of the project set by a neighbourhood he would slowly walk in a day.","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/526798.html"},"de":{"name":"Thomas Boivin - 'Belleville'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/526798.html"},"it":{"name":"Thomas Boivin - 'Belleville'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/526798.html"},"sp":{"name":"Thomas Boivin - 'Belleville'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/526798.html"},"pt":{"name":"Thomas Boivin - 'Belleville'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/526798.html"},"cn":{"name":"Thomas Boivin - 'Belleville'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/526798.html"}},"place":{"id":251684,"translations":{"fr":{"name":"Fondation A Stichting","address_street_name":"Avenue Van Volxem","address_street_number":"304","address_street_box":null,"email":"info@fondationastichting.be","website":"http:\/\/www.fondationastichting.be","phone_contact":"+32 2 502 38 78","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 304","address_line2":"1190 Forest","description_web":"Cr\u00e9\u00e9e \u00e0 l\u2019initiative d\u2019Astrid Ullens de Schooten, la Fondation A, reconnue d\u2019utilit\u00e9 publique, a ouvert ses portes au sud de Bruxelles, en octobre 2012. Elle a pour vocation de soutenir la cr\u00e9ation, la connaissance et la conservation de l\u2019image photographique. L\u2019objectif consiste \u00e0 explorer les enjeux et les contradictions de l\u2019image-document afin de questionner ce monde du tout visuel que nous habitons. Trois expositions temporaires sont organis\u00e9es chaque ann\u00e9e. Au c\u0153ur de la Fondation A, il y a une collection. Elle est compos\u00e9e de grands ensembles d\u2019\u0153uvres de photographes \u00e0 la sensibilit\u00e9 documentaire, reconnus mondialement pour bon nombre d\u2019entre eux. Depuis 2015, la Fondation A consacre \u00e9galement une exposition par saison \u00e0 un jeune cr\u00e9ateur. V\u00e9ritable plateforme consacr\u00e9e \u00e0 l\u2019image photographique, elle est aussi le partenaire de projets d\u2019expositions et d\u2019\u00e9ditions, organis\u00e9s en collaboration avec d\u2019autres institutions culturelles. ","description_print":"","booking_url":null,"sort_order":"FONDATION A STICHTING","virtual_visit":null},"nl":{"name":"Fondation A Stichting","address_street_name":"Van Volxemlaan","address_street_number":"304","address_street_box":null,"email":"info@fondationastichting.be","website":"http:\/\/www.fondationastichting.be","phone_contact":"+32 2 502 38 78","phone_booking":null,"address_zip":"1190","address_city":"Vorst","address_line1":"Van Volxemlaan, 304","address_line2":"1190 Vorst","description_web":"Op initiatief van Astrid Ullens de Schooten opende A Stichting, een vereniging van openbaar nut, in het zuiden van Brussel in oktober 2012 haar deuren. Ze wil ondersteuning bieden aan de creatie, de kennis en de conservatie van het fotografische beeld. Het doel is de uitdagingen en de tegenstellingen die van het beelddocument uitgaan te onderzoeken, met de bedoeling de visuele wereld waarin we leven in vraag te stellen. Elk jaar worden drie tijdelijke tentoonstellingen georganiseerd. Het hart van A Stichting is een fotocollectie. Die bestaat uit grote gehelen van werk van fotografen met een documentaire insteek en van wie een groot aantal wereldwijd erkend is. Sinds 2015 besteedt A Stichting ook \u00e9\u00e9n tentoonstelling per seizoen aan een jonge fotograaf. Het is een echt platform gewijd aan de fotografie en is ook partner van tentoonstellings- en boekprojecten georganiseerd in samenwerking met andere culturele instellingen.","description_print":"","booking_url":null,"sort_order":"FONDATION A STICHTING","virtual_visit":null},"en":{"name":"Fondation A Stichting","address_street_name":"Avenue Van Volxem","address_street_number":"304","address_street_box":null,"email":"info@fondationastichting.be","website":"http:\/\/www.fondationastichting.be","phone_contact":"+32 2 502 38 78","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 304","address_line2":"1190 Forest","description_web":"Instigated by Astrid Ullens de Schooten, the state-approved A Foundation opened south of Brussels in October 2012. It aims to support the creation, awareness and conservation of photographic images. The purpose consists of exploring the challenges and contradictions surrounding document images in order to examine this very visual world that we inhabit. Three temporary exhibitions are organised each year. The collection is central to the A Foundation. It comprises great sets of works by photographers with a documentary tendency; many of them are highly regarded throughout the world. Since 2015, the A Foundation has also devoted one exhibition per season to a young creator. It is a real platform for photographic images, is also a partner for exhibition and publishing projects organised in conjunction with other cultural institutions. ","description_print":"","booking_url":null,"sort_order":"FONDATION A STICHTING","virtual_visit":null},"de":{"name":"Fondation A Stichting","address_street_name":"Avenue Van Volxem","address_street_number":"304","address_street_box":null,"email":"info@fondationastichting.be","website":"http:\/\/www.fondationastichting.be","phone_contact":"+32 2 502 38 78","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 304","address_line2":"1190 Forest","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Fondation A Stichting","address_street_name":"Avenue Van Volxem","address_street_number":"304","address_street_box":null,"email":"info@fondationastichting.be","website":"http:\/\/www.fondationastichting.be","phone_contact":"+32 2 502 38 78","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 304","address_line2":"1190 Forest","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Fundaci\u00f3n A Stichting","address_street_name":"Avenue Van Volxem","address_street_number":"304","address_street_box":null,"email":"info@fondationastichting.be","website":"http:\/\/www.fondationastichting.be","phone_contact":"+32 2 502 38 78","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 304","address_line2":"1190 Forest","description_web":"En octubre de 2012, la Fundaci\u00f3n A stichting abri\u00f3 sus puertas en el sur de Bruselas en el lugar de la antigua f\u00e1brica Bata. Creada bajo la iniciativa de Astrid Ullens de Schooten, y reconocida por promover el inter\u00e9s p\u00fablico, tiene una vocaci\u00f3n para apoyar la creaci\u00f3n, el conocimiento y la preservaci\u00f3n de la imagen fotogr\u00e1fica. Ya no existe nada que no parezca haber sido atestiguado por la imagen. Sin embargo, la idea de dejar constancia sobre el uso real de la fotograf\u00eda no es necesaria. Lo que ocurre con nuestra capacidad de ver y percibir cuando en su abundancia y su inmediaci\u00f3n virtual, las im\u00e1genes que nos rodean se est\u00e1n convirtiendo r\u00e1pida y poderosamente m\u00e1s complicadas. El proyecto de la fundaci\u00f3n consiste en explorar las riesgos y contradicciones  de la imagen-documento, cuestionando un mundo en el que todo es visible. Organiza tres exhibiciones temporales cada a\u00f1o.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Fondation A Stichting","address_street_name":"Avenue Van Volxem","address_street_number":"304","address_street_box":null,"email":"info@fondationastichting.be","website":"http:\/\/www.fondationastichting.be","phone_contact":"+32 2 502 38 78","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 304","address_line2":"1190 Forest","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Fondation A Stichting","address_street_name":"Avenue Van Volxem","address_street_number":"304","address_street_box":null,"email":"info@fondationastichting.be","website":"http:\/\/www.fondationastichting.be","phone_contact":"+32 2 502 38 78","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 304","address_line2":"1190 Forest","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":[],"zones":{"list":[21],"translations":{"fr":["Sud"],"nl":["Zuid"],"en":["South"]}},"neca":"art_center","facebook_id":null,"backoffice_id":13764,"location":{"lat":50.82266385,"lon":4.32563819},"region":"brussels","last_updated_at":"2022-06-10T01:36:40+02:00","published_at":"2013-10-19T01:38:02+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":251684,"translations":{"fr":{"name":"Fondation A Stichting","address_street_name":"Avenue Van Volxem","address_street_number":"304","address_street_box":null,"email":"info@fondationastichting.be","website":"http:\/\/www.fondationastichting.be","phone_contact":"+32 2 502 38 78","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 304","address_line2":"1190 Forest","description_web":"Cr\u00e9\u00e9e \u00e0 l\u2019initiative d\u2019Astrid Ullens de Schooten, la Fondation A, reconnue d\u2019utilit\u00e9 publique, a ouvert ses portes au sud de Bruxelles, en octobre 2012. Elle a pour vocation de soutenir la cr\u00e9ation, la connaissance et la conservation de l\u2019image photographique. L\u2019objectif consiste \u00e0 explorer les enjeux et les contradictions de l\u2019image-document afin de questionner ce monde du tout visuel que nous habitons. Trois expositions temporaires sont organis\u00e9es chaque ann\u00e9e. Au c\u0153ur de la Fondation A, il y a une collection. Elle est compos\u00e9e de grands ensembles d\u2019\u0153uvres de photographes \u00e0 la sensibilit\u00e9 documentaire, reconnus mondialement pour bon nombre d\u2019entre eux. Depuis 2015, la Fondation A consacre \u00e9galement une exposition par saison \u00e0 un jeune cr\u00e9ateur. V\u00e9ritable plateforme consacr\u00e9e \u00e0 l\u2019image photographique, elle est aussi le partenaire de projets d\u2019expositions et d\u2019\u00e9ditions, organis\u00e9s en collaboration avec d\u2019autres institutions culturelles. ","description_print":"","booking_url":null,"sort_order":"FONDATION A STICHTING","virtual_visit":null},"nl":{"name":"Fondation A Stichting","address_street_name":"Van Volxemlaan","address_street_number":"304","address_street_box":null,"email":"info@fondationastichting.be","website":"http:\/\/www.fondationastichting.be","phone_contact":"+32 2 502 38 78","phone_booking":null,"address_zip":"1190","address_city":"Vorst","address_line1":"Van Volxemlaan, 304","address_line2":"1190 Vorst","description_web":"Op initiatief van Astrid Ullens de Schooten opende A Stichting, een vereniging van openbaar nut, in het zuiden van Brussel in oktober 2012 haar deuren. Ze wil ondersteuning bieden aan de creatie, de kennis en de conservatie van het fotografische beeld. Het doel is de uitdagingen en de tegenstellingen die van het beelddocument uitgaan te onderzoeken, met de bedoeling de visuele wereld waarin we leven in vraag te stellen. Elk jaar worden drie tijdelijke tentoonstellingen georganiseerd. Het hart van A Stichting is een fotocollectie. Die bestaat uit grote gehelen van werk van fotografen met een documentaire insteek en van wie een groot aantal wereldwijd erkend is. Sinds 2015 besteedt A Stichting ook \u00e9\u00e9n tentoonstelling per seizoen aan een jonge fotograaf. Het is een echt platform gewijd aan de fotografie en is ook partner van tentoonstellings- en boekprojecten georganiseerd in samenwerking met andere culturele instellingen.","description_print":"","booking_url":null,"sort_order":"FONDATION A STICHTING","virtual_visit":null},"en":{"name":"Fondation A Stichting","address_street_name":"Avenue Van Volxem","address_street_number":"304","address_street_box":null,"email":"info@fondationastichting.be","website":"http:\/\/www.fondationastichting.be","phone_contact":"+32 2 502 38 78","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 304","address_line2":"1190 Forest","description_web":"Instigated by Astrid Ullens de Schooten, the state-approved A Foundation opened south of Brussels in October 2012. It aims to support the creation, awareness and conservation of photographic images. The purpose consists of exploring the challenges and contradictions surrounding document images in order to examine this very visual world that we inhabit. Three temporary exhibitions are organised each year. The collection is central to the A Foundation. It comprises great sets of works by photographers with a documentary tendency; many of them are highly regarded throughout the world. Since 2015, the A Foundation has also devoted one exhibition per season to a young creator. It is a real platform for photographic images, is also a partner for exhibition and publishing projects organised in conjunction with other cultural institutions. ","description_print":"","booking_url":null,"sort_order":"FONDATION A STICHTING","virtual_visit":null},"de":{"name":"Fondation A Stichting","address_street_name":"Avenue Van Volxem","address_street_number":"304","address_street_box":null,"email":"info@fondationastichting.be","website":"http:\/\/www.fondationastichting.be","phone_contact":"+32 2 502 38 78","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 304","address_line2":"1190 Forest","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Fondation A Stichting","address_street_name":"Avenue Van Volxem","address_street_number":"304","address_street_box":null,"email":"info@fondationastichting.be","website":"http:\/\/www.fondationastichting.be","phone_contact":"+32 2 502 38 78","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 304","address_line2":"1190 Forest","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Fundaci\u00f3n A Stichting","address_street_name":"Avenue Van Volxem","address_street_number":"304","address_street_box":null,"email":"info@fondationastichting.be","website":"http:\/\/www.fondationastichting.be","phone_contact":"+32 2 502 38 78","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 304","address_line2":"1190 Forest","description_web":"En octubre de 2012, la Fundaci\u00f3n A stichting abri\u00f3 sus puertas en el sur de Bruselas en el lugar de la antigua f\u00e1brica Bata. Creada bajo la iniciativa de Astrid Ullens de Schooten, y reconocida por promover el inter\u00e9s p\u00fablico, tiene una vocaci\u00f3n para apoyar la creaci\u00f3n, el conocimiento y la preservaci\u00f3n de la imagen fotogr\u00e1fica. Ya no existe nada que no parezca haber sido atestiguado por la imagen. Sin embargo, la idea de dejar constancia sobre el uso real de la fotograf\u00eda no es necesaria. Lo que ocurre con nuestra capacidad de ver y percibir cuando en su abundancia y su inmediaci\u00f3n virtual, las im\u00e1genes que nos rodean se est\u00e1n convirtiendo r\u00e1pida y poderosamente m\u00e1s complicadas. El proyecto de la fundaci\u00f3n consiste en explorar las riesgos y contradicciones  de la imagen-documento, cuestionando un mundo en el que todo es visible. Organiza tres exhibiciones temporales cada a\u00f1o.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Fondation A Stichting","address_street_name":"Avenue Van Volxem","address_street_number":"304","address_street_box":null,"email":"info@fondationastichting.be","website":"http:\/\/www.fondationastichting.be","phone_contact":"+32 2 502 38 78","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 304","address_line2":"1190 Forest","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Fondation A Stichting","address_street_name":"Avenue Van Volxem","address_street_number":"304","address_street_box":null,"email":"info@fondationastichting.be","website":"http:\/\/www.fondationastichting.be","phone_contact":"+32 2 502 38 78","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 304","address_line2":"1190 Forest","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":"art_center","facebook_id":null,"backoffice_id":13764,"location":{"lat":50.82266385,"lon":4.32563819},"region":"brussels","last_updated_at":"2022-06-10T01:36:40+02:00","published_at":"2013-10-19T01:38:02+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/be10d6e0d46716d309a64ea6b43a47ad499eaa1b.jpg","width":639,"height":842,"ratio":0.76,"translations":{"fr":{"title":"Thomas Boivin - 'Belleville'","copyright":null},"nl":{"title":"Thomas Boivin - 'Belleville'","copyright":null},"en":{"title":"Thomas Boivin - 'Belleville'","copyright":null}}}],"dates":[{"day":"2022-04-23"