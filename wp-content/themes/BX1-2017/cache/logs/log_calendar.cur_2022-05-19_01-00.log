ts","copyright":null}}}],"dates":[{"day":"2022-05-21","doors":null,"start":"14:00:00","end":"18:00:00","is_soldout":false,"is_canceled":false},{"day":"2022-05-22","doors":null,"start":"14:00:00","end":"17:00:00","is_soldout":false,"is_canceled":false}],"prices":[],"child_events":[],"parent_events":[528646],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-04-14T16:05:08+02:00","published_at":"2022-04-14T14:18:02+02:00","backoffice_id":251991,"import_origin":null,"sub_type":"other","show_in_agenda":true,"ranking":0.7937005259841},{"id":534015,"date_start":"2022-05-21","date_end":"2022-05-21","date_next":"2022-05-21","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{"list":[109],"translations":{"fr":["Espaces verts"],"nl":["Groene zones"],"en":["Green spaces"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Garden Tales \u2013 Du champ \u00e0 l'assiette","shortdescr":"Garden Tales est un \u00e9v\u00e9nement annuel gratuit qui vous propose de visiter des jardins priv\u00e9s et publics \u00e0 Bruxelles.","longdescr":"Smala, c\u2019est un projet circulaire du champ \u00e0 l\u2019assiette \u00e0 Bruxelles. Leur mission, depuis 2019, est de sensibiliser les bruxellois \u00e0 une alimentation plus durable et les reconnecter \u00e0 la terre. Sur ce champ \u00e0 Anderlecht, les mara\u00eech\u00e8res Marie et Zofia cultivent de d\u00e9licieux l\u00e9gumes selon les principes de l\u2019agriculture paysanne et de l\u2019agro\u00e9cologie. Une visite guid\u00e9e vous est r\u00e9serv\u00e9e dans cet espace bucolique \u00e0 deux pas de la ville o\u00f9 il r\u00e8gne une ambiance conviviale et chaleureuse.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.civa.brussels\/fr\/expos-events\/du-champ-lassiette-smala-farming","email":"info@civa.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/534015.html"},"nl":{"name":"Garden Tales \u2013 Van het veld naar je bord","shortdescr":"Garden Tales is een jaarlijks evenement waarbij je gratis heel wat priv\u00e9- en publieke tuinen in Brussel kan bezoeken.","longdescr":"Smala is een circulair project in Brussel dat het voedsel rechtstreeks van het veld naar je bord brengt. Sinds 2019 is het Smala\u2019s missie om de Brusselaars bewust te maken van duurzame voeding en hen opnieuw in contact te brengen met de aarde. Op dit veld in Anderlecht telen Marie en Zofia heerlijke groenten volgens de principes van de boerenlandbouw en de agro-ecologie. Ze geven je graag een rondleiding in deze bucolische ruimte waar op een steenworp van de stad een warme en gemoedelijke sfeer heerst.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.civa.brussels","email":"info@civa.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/534015.html"},"en":{"name":"Garden Tales \u2013 From the field to the fork","shortdescr":"Garden Tales is a free yearly festival that turns the spotlight on private and public gardens in Brussels.","longdescr":"Smala is a circular from-field-to-plate project in Brussels. Their mission, since 2019, has been to raise awareness among Brussels residents about a more sustainable food system and to reconnect them to the earth. On this field in Anderlecht, market gardeners Marie and Zofia grow delicious vegetables according to the principles of peasant agriculture and agroecology.\r\n\r\nBook a guided tour of this bucolic space which is just a stone\u2019s throw from the city and where a friendly and warm atmosphere prevails.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.civa.brussels","email":"info@civa.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/534015.html"},"de":{"name":"Garden Tales \u2013 Du champ \u00e0 l'assiette","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/534015.html"},"it":{"name":"Garden Tales \u2013 Du champ \u00e0 l'assiette","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/534015.html"},"sp":{"name":"Garden Tales \u2013 Du champ \u00e0 l'assiette","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/534015.html"},"pt":{"name":"Garden Tales \u2013 Du champ \u00e0 l'assiette","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/534015.html"},"cn":{"name":"Garden Tales \u2013 Du champ \u00e0 l'assiette","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/534015.html"}},"place":{"id":277161,"translations":{"fr":{"name":"Smala","address_street_name":"Rue de Neerpede","address_street_number":null,"address_street_box":null,"email":"smala.cooking@gmail.com","website":"http:\/\/www.smala.brussels","phone_contact":null,"phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de Neerpede","a