 techniques mixtes. C'est la richesse de ces associations de mat\u00e9riaux au service de la repr\u00e9sentation d'un sujet ou d'une id\u00e9e qu'illustre cette exposition.","performers":"Add Fuel; David Bruce; C215; Fanakapan; Maike Freess; Stan Manoukian; Murmure; Gabriela Noelle -  Laurina Paperina; Pantonio; PEZ; PichiAvo; Austyn Taylor; YZ","boxoffice_url":null,"website":"http:\/\/www.mazelgalerie.com","email":"contact@mazelgalerie.com","phone_contact":"+32 2 850 29 28","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700003245"},"it":{"name":"Rock, paper, scissor","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.mazelgalerie.com","email":"contact@mazelgalerie.com","phone_contact":"+32 2 850 29 28","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700003245"},"cn":{"name":"Rock, paper, scissor","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.mazelgalerie.com","email":"contact@mazelgalerie.com","phone_contact":"+32 2 850 29 28","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700003245"},"fr":{"name":"Pierre, feuille, ciseaux","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.mazelgalerie.com","email":"contact@mazelgalerie.com","phone_contact":"+32 2 850 29 28","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700003245"},"sp":{"name":"Rock, paper, scissor","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.mazelgalerie.com","email":"contact@mazelgalerie.com","phone_contact":"+32 2 850 29 28","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700003245"},"nl":{"name":"Rock, paper, scissors","shortdescr":null,"longdescr":null,"performers":nu