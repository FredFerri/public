ra l\u2019occasion de partir \u00e0 la recherche des traces du Broebelaer disparu et de vous promener dans l\u2019un des parcs les plus charmants et les plus secrets de Bruxelles ; en arpentant la chauss\u00e9e Saint-Pierre, l\u2019une des plus vieilles art\u00e8res de la commune, vous d\u00e9couvrirez plusieurs demeures aristocratiques de l\u2019Ancien R\u00e9gime ; la rue Louis Hap vous permettra quant \u00e0 elle de r\u00e9viser vos connaissances en mati\u00e8re de styles architecturaux du tournant du si\u00e8cle.\r\n\r\nCe tour comprend la visite de la maison Hap !","performers":null,"boxoffice_url":null,"website":"http:\/\/www.arau.org","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.559745"},"nl":{"name":"Etterbeek c\u00f4t\u00e9 village","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.arau.org","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.559745"},"en":{"name":"Etterbeek c\u00f4t\u00e9 village","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.arau.org","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.559745"},"de":{"name":"Etterbeek c\u00f4t\u00e9 village","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.arau.org","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.559745"},"it":{"name":"Etterbeek c\u00f4t\u00e9 village","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.arau.org","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda