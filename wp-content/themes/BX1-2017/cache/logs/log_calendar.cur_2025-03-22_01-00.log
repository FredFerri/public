null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700006503"},"pt":{"name":"BANAD Festival - Guided tour of the Herrero House","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700006503"},"en":{"name":"BANAD Festival - Guided tour of the Herrero House","shortdescr":null,"longdescr":"Built to the designs of an unknown architect in 1924 for a Spanish lady who obviously wanted it to make reference to her native country's architecture and designs, its sober exterior belies its surprisingly ornate interior, laid out around a courtyard with a stained-glass ceiling, ceramic-tiled walls and floor and a small fountain. Many of its structural and decorative details refer to Spanish esthetics and Art Deco. Guided tours by the owners\n\nArch. Inconnu\/Onbekend, 1924","performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/en\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700006503"},"it":{"name":"BANAD Festival - Guided tour of the Herrero House","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700006503"},"cn":{"name":"BANAD Festival - Guided tour of the Herrero House","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700006503"},"fr":{"name":"BANAD Festival - Visite de la Maison Herrero","shortdescr":null,"longdescr":"\u0152uvre d'un architecte inconnu construite en 1924 pour une dame d'origine espagnole qui souhaitait visiblement retrouver ici des r\u00e9f\u00e9rences \u00e0 l'architecture et la d\u00e9coration de son pays. Ext\u00e9rieurement tr\u00e8s sobre, c'est l'int\u00e9rieur de cette maison qui nous surprend avec son organisation autour d'un patio coiff\u00e9 d'une verri\u00e8re aux verres color\u00e9s, par\u00e9 de c\u00e9ramiques et anim\u00e9 d'une petite fontaine. De nombreux d\u00e9tails structurels et d\u00e9coratifs font r\u00e9f\u00e9rence \u00e0 l'esth\u00e9tique hispanique et \u00e0 l'Art D\u00e9co. Visite assur\u00e9e notamment par les propri\u00e9taires.\n\nArch. Inconnu\/Onbekend, 1924","performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700006503"},"sp":{"name":"BANAD Festival - Guided tour of the Herrero House","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700006503"},"nl":{"name":"BANAD Festival - Rondleiding van de Woning Herrero","shortdescr":null,"longdescr":"Een werk dat in 1924 door een onbekende architect werd gebouwd voor een Spaanse dame die hier duidelijke verwijzingen naar de architectuur en decoratie van haar land wou terugzien. Achter een sobere gevel schuilt een verrassend interieur, georganiseerd rond een patio met een overkapping van gekleurd glas, versierd met keramiek en bezield door een fonteintje. Talloze structurele en decoratieve details verwijzen naar de Spaanse stijl en de art deco. Bezoek onder leiding van de eigenaars.\n\nArch. Inconnu\/Onbekend, 1924","performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/nl\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700006503"}},"place":{"id":275783,"translations":{"de":{"name":"Maison Herrero","address_street_name":"Avenue de l'Opale","address_street_number":"11","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Avenue de l'Opale, 11","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Maison Herrero","address_street_name":"Avenue de l'Opale","address_street_number":"11","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Avenue de l'Opale, 11","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Maison Herrero","address_street_name":"Avenue de l'Opale","address_street_number":"11","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Avenue de l'Opale, 11","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Maison Herrero","address_street_name":"Avenue de l'Opale","address_street_number":"11","address_street_box":null,"email":null,"website":null,"phon