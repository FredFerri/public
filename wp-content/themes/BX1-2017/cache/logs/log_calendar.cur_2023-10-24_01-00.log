:00 - 21:30 | Reclaiming Our Joy: Sarah Diedro Jord\u00e3o\n- 26\/10\u00a0| 20:00 - 21:30 |\u00a0What's Up With Reine?\u00a0x Menji Talks\n- 27\/10 | 20:00 - 21:30 | The Aftertea Podcast: Sonia Dorcas Mutaganzwa, Fouzia Sadala & Marck Kapenda + afterparty (TBC)\n- 28\/10 | 15:00 - 18:00 | Workshop - DIY podcasting with Sonia Dorcas (The Aftertea Podcast)\n\nSom\u2022m\u2022e Of Us is a multidisciplinarycollective of independent black cultural curators and community space organizers.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.muntpunt.be","email":"info@muntpunt.be","phone_contact":null,"phone_booking":"+32 2 278 11 11","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.563556"}},"place":{"id":277273,"translations":{"de":{"name":"Muntpunt,  De Grid +5","address_street_name":"Place de la Monnaie","address_street_number":"6","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Monnaie, 6","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Muntpunt,  De Grid +5","address_street_name":"Place de la Monnaie","address_street_number":"6","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Monnaie, 6","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Muntpunt,  De Grid +5","address_street_name":"Place de la Monnaie","address_street_number":"6","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Monnaie, 6","address_line2":"1000 Bruxelles","description_web":null,"description_