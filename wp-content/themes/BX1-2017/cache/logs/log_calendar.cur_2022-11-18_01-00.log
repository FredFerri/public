c","last_updated_at":"2022-10-10T21:36:36+02:00","published_at":"2022-10-08T03:30:22+02:00","backoffice_id":256247,"import_origin":"explore","sub_type":"other","show_in_agenda":true,"ranking":1},{"id":543704,"date_start":"2022-11-20","date_end":"2022-11-20","date_next":"2022-11-20","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen"}},"others":{"list":[112],"translations":{"fr":["Insolite"],"nl":["Ongewoon"],"en":["Unusual"],"de":["Ausgefallenes"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"L'ancien cin\u00e9ma le Movy Club","shortdescr":"Le Movy, l\u2019enseigne d\u2019origine du cin\u00e9ma, \u00e9tait l\u2019une des dizaines de \u00ab salles des faubourgs \u00bb ou cin\u00e9ma de quartier de Bruxelles.","longdescr":"Le Movy, l\u2019enseigne d\u2019origine du cin\u00e9ma, \u00e9tait l\u2019une des dizaines de \u00ab salles des faubourgs \u00bb ou cin\u00e9ma de quartier de Bruxelles. Ouverte en 1934 dans une petite rue de Forest, la coquette salle et son \u00e9cran unique ont connu leurs heures de gloire r\u00e9centes dans les ann\u00e9es 80 et 90 sous l\u2019enseigne de Movy Club, gr\u00e2ce \u00e0 son propri\u00e9taire et exploitant homme-orchestre Pierre Gueulette. Ces soins ont permis au Movy Club d\u2019\u00eatre inscrit sur la liste de sauvegarde de la R\u00e9gion de Bruxelles-Capitale, pour son int\u00e9r\u00eat architectural, historique et technique, notamment sa cabine de projection munies de deux projecteurs au charbon.Rachet\u00e9 en 2015 par la R\u00e9gion, le Movy s\u2019appr\u00eate \u00e0 redevenir un cin\u00e9ma de proximit\u00e9 \u00e0 destination du public forestois gr\u00e2ce \u00e0 une r\u00e9novation et une extension des lieux pr\u00e9vue pour 2024 environ. La visite aura lieu en cours de chantier.","performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be","email":"info@arkadia.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.543704"},"nl":{"name":"L'ancien cin\u00e9ma le Movy Club","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/nl","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.543704"},"en":{"name":"L'ancien cin\u00e9ma le Movy Club","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/en","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.543704"},"de":{"name":"L'ancien cin\u00e9ma le Movy Club","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.543704"},"it":{"name":"L'ancien cin\u00e9ma le Movy Club","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.543704"},"sp":{"name":"L'ancien cin\u00e9ma le Movy Club","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.543704"},"pt":{"name":"L'ancien cin\u00e9ma le Movy Club","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_bookin