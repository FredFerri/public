g, zorgen tijdelijke tentoonstellingen voor een dynamische dialoog met de werken van professionele kunstenaars die actief zijn in het offici\u00eble culturele milieu, om de grenzen van de in- en outsiderkunst af te tasten. art )&( marges museum is geen ghettomuseum maar een plaats van uitwisseling, een ruimte waarin de individualiteit hoogtij viert en waarin alles in het werk gesteld wordt om ervoor te zorgen dat alle doelgroepen zich thuis voelen.\r\n\r\nOpen op vrijdag, zaterdag en zondag tussen 11.00 en 17.30 uur, alleen op afspraak.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":149,"location":{"lat":50.83472811,"lon":4.3463823},"last_updated_at":"2023-06-04T15:50:58+02:00","published_at":"2013-10-19T01:13:19+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/ad4235fd834ce0a9c6b3b304cd3f4c1fa1e36712.jpg","width":4167,"height":2917,"ratio":1.43,"oEmbed_height":2917,"oEmbed_width":4167,"translations":{"de":{"title":"N'appelez pas \u00e7a Art brut","copyright":null},"pt":{"title":"N'appelez pas \u00e7a Art brut","copyright":null},"en":{"title":"N'appelez pas \u00e7a Art brut","copyright":null},"it":{"title":"N'appelez pas \u00e7a Art brut","copyright":null},"cn":{"title":"N'appelez pas \u00e7a Art brut","copyright":null},"fr":{"title":"N'appelez pas \u00e7a Art brut","copyright":null},"sp":{"title":"N'appelez pas \u00e7a Art brut","copyright":null},"nl":{"title":"N'appelez pas \u00e7a Art brut","copyright":null}}},{"type":"poster","link":"https:\/\/agendabrussels2.imgix.net\/759d031f82802fb3322fb935411c7d88214a75d7.jpg","width":3508,"height":4961,"ratio":0.71,"oEmbed_height":4961,"oEmbed_width":3508,"translations":{"de":{"title":"N'appelez pas \u00e7a Art brut","copyright":null},"pt":{"title":"N'appelez pas \u00e