":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 147","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Huis der Kunsten","address_street_name":"Haachtsesteenweg","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaarbeek","address_line1":"Haachtsesteenweg, 147","address_line2":"1030 Schaarbeek","description_web":"La Maison des Arts, geanimeerd door de dienst Franstalige Cultuur van de gemeente Schaarbeek, is een heel bijzondere plek. De activiteiten zijn vooral gericht op hedendaagse creativiteit in de plastische kunsten.\r\n\r\nIn La Maison des Arts heerst reeds sedert 1950 ( datum waarop de gemeente het huis aankocht) een ruime artistieke activiteit. In 2005 is er een belangrijke ontwikkeling : het voorstel aan de kunstenaars om ter plaatse te werken, teneinde een echte samenhang te bereiken tussen het werk en het Huis. Uiteindelijk beslist de Gemeente Schaarbeek er een echte broeikast van te maken in het domein van de beeldende kunsten, een bron van schepping, verspreiding en culturele uitstraling.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":663,"location":{"lat":50.85951067,"lon":4.37063079},"last_updated_at":"2022-11-09T13:59:40+01:00","published_at":"2013-10-19T01:13:42+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo"