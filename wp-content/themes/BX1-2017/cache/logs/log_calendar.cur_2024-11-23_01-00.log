l_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-11-22T01:00:51+01:00","published_at":"2024-10-30T16:33:53+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":310787,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"other","ranking":0.2811442217672498,"languages":{"spoken":["en","fr","nl"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[24],"translations":{"de":["Kunstgalerien"],"pt":[null],"en":["Art Galleries"],"it":["Gallerie d'arte"],"cn":[null],"fr":["Galeries d'art"],"sp":["Galer\u00edas de arte"],"nl":["Galeries"]}}},"translations":{"de":{"name":"Mati\u00e8res cueillies","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/hectare-galerie.be\/expositions\/","email":"atelier@hectare-galerie.be","phone_contact":"+32 2 640 72 53","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700003221"},"pt":{"name":"Mati\u00e8res cueillies","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/hectare-galerie.be\/expositions\/","email":"atelier@hectare-galerie.be","phone_contact":"+32 2 640 72 53","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700003221"},"en":{"name":"Mati\u00e8res cueillies","shortdescr":null,"longdescr":"For its new exhibition, Hectare Gallery has invited six designers with diverse profiles, six gatherers, each in her own way. They explore, reinterpret and reshape materials, rewriting the history that inhabits them.  \nThrough the work of Charlotte Van de Velde, Isabelle Aza\u00efs, Julie Decubber, Juliette M\u00eame, Ognyana Teneva and Xinyi Chen, the thought of memory is requestioned. As well as its future. From letting go and transformation, of shedding, if not of alchemy.  \n  \nAntique clasps arranged in contemporary bracelets; ceramic shards, charms and santons strung together: the idea of a collection becomes more playful and expands its definition. Iridescent surfaces merged into mutant creatures; dazzling jewelry emerging from almost nothing; threads drawn from bottles and wo-ven into lace: the old is reinvented, between models of the past and structures of the future. Electronic components set with recycled and colored silver: the concept of the jewel, reimagined, enters a new era.  \n  \nSix unique, meticulous and bold approaches, opening up new semantic fields and shifting the cursor on the axis of past\/discarded - future\/recomposed. A deliciously subtle dialogue develops between these multiple identities, sensitive to the unexpected.  \n  \nHumour often seeps through in these creative adventures, which are nevertheless imbued with an awareness of an uncertain present. The works of the six artists brought together by Hectare under the title Mati\u00e8res cueillies are at times a mockery of prejudices and references to 'value', at other times an invi-tation to share stories made up of memories or utopian dreams, offering our senses an oeuvre of enno-blement where technical finesse is spiked with poetry, in pieces imbued with their multifaceted personal-ities, oscillating between extravagance, rigour and lightness. ","performers":null,"boxoffice_url":null,"website":"https:\/\/hectare-galerie.be\/en\/exhibitions\/","email":"atelier@hectare-galerie.be","phone_contact":"+32 2 640 72 53","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700003221"},"it":{"name":"Mati\u00e8res cueillies","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/hectare-galerie.be\/expositions\/","email":"atelier@hectare-galerie.be","phone_contact":"+32 2 640 72 53","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700003221"},"cn":{"name":"Mati\u00e8res cueillies","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/hectare-galerie.be\/expositions\/","email":"atelier@hectare-galerie.be","phone_contact":"+32 2 640 72 53","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700003221"},"fr":{"name":"Mati\u00e8res cueillies","shortdescr":"Pour sa nouvelle exposition, la galerie Hectare convoque six cr\u00e9atrices aux profils divers, six glaneuses, chacune \u00e0 sa mani\u00e8re. Qui interrogent, d\u00e9tournent, remod\u00e8lent les mati\u00e8res, r\u00e9\u00e9crivent l\u2019histoire qui les habite.","longdescr":"Pour sa nouvelle exposition, la galerie Hectare convoque six cr\u00e9atrices aux profils divers, six glaneuses, chacune \u00e0 sa mani\u00e8re. Qui interrogent, d\u00e9tournent, remod\u00e8lent les mati\u00e8res, r\u00e9\u00e9crivent l\u2019histoire qui les habite.\n\u00c0 travers le travail de Charlotte Van de Velde, Isabelle Aza\u00efs, Julie Decubber, Juliette M\u00eame,\nOgnyana Teneva et Xinyi Chen, c\u2019est de m\u00e9moire qu\u2019il est question. D\u2019avenir aussi. D\u2019abandon et de transformation, de mue, sinon d\u2019alchimie.\n\nFermoirs anciens agenc\u00e9s en bracelet contemporain ; tessons, f\u00e8ves ou santons de c\u00e9ramique ressuscit\u00e9s en ribambelles : l\u2019id\u00e9e de collection s\u2019encanaille et \u00e9largit sa d\u00e9finition. Surfaces iridescentes assembl\u00e9es en cr\u00e9atures mutantes ; parures \u00e9blouissantes jaillies d\u2019un presque rien ; filaments de flacons nou\u00e9s en dentelle : l\u2019ancien se r\u00e9invente, entre mod\u00e8les de jadis et structures du futur. Composants \u00e9lectroniques sertis d\u2019argent recycl\u00e9 et teint\u00e9 : le principe du joyau, repens\u00e9, entre dans une \u00e8re neuve.\n\nSix d\u00e9marches singuli\u00e8res, minutieuses, audacieuses, qui ouvrent de nouveaux champs s\u00e9mantiques, manient le curseur sur l\u2019axe pass\u00e9\/d\u00e9class\u00e9 \u2013 futur\/recompos\u00e9. Un dialogue s\u2019installe, savoureusement subtil, parmi ces identit\u00e9s multiples, \u00e0 l\u2019\u00e9coute de l\u2019in\u00e9dit.\n\nL\u2019humour souvent s\u2019invite dans ces aventures cr\u00e9atives, empreintes cependant de la conscience d\u2019un pr\u00e9sent qui vacille. Tant\u00f4t pied-de-nez aux pr\u00e9jug\u00e9s et r\u00e9f\u00e9rences \u00e0 la \u00ab valeur \u00bb, tant\u00f4t invitation \u00e0 se raconter des histoires faites de souvenirs ou d\u2019utopies, les \u0153uvres des six artistes regroup\u00e9es par Hectare sous la banni\u00e8re de Mati\u00e8res cueillies offrent \u00e0 nos sens un travail d\u2019ennoblissement o\u00f9 la finesse technique se pique de po\u00e9sie, dans des pi\u00e8ces imbib\u00e9es de leurs personnalit\u00e9s plurielles, entre extravagance, rigueur et l\u00e9g\u00e8ret\u00e9.","performers":"Charlotte Van de Velde\nIsabelle Aza\u00efs\nJulie Decubber\nJuliette M\u00eame\nOgnyana Teneva\nXinyi Chen","boxoffice_url":null,"website":"https:\/\/hectare-galerie.be\/expositions\/","email":"atelier@hectare-galerie.be","phone_contact":"+32 2 640 72 53","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700003221"},"sp":{"name":"Mati\u00e8res cueillies","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/hectare-galerie.be\/expositions\/","email":"atelier@hectare-galerie.be","phone_contact":"+32 2 640 72 53","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700003221"},"nl":{"name":"Mati\u00e8res cueillies","shortdescr":null,"longdescr":"Voor haar nieuwe tentoonstelling heeft de galerij Hectare zes ontwerpsters met diverse profielen uitge-nodigd, zes verzamelaars, ieder op haar eigen manier. Zij onderzoeken, herinterpreteren, geven opnieuw vorm aan materialen, en herschrijven diens verhalen. \nIn het werk van Charlotte Van de Velde, Isabelle Aza\u00efs, Julie Decubber, Juliette M\u00eame,  \nOgnyana Teneva en Xinyi Chen staat de herinnering centraal. Evenwel de toekomst. Van loslaten en transformatie, tot vervellen, misschien zelfs alchemie.  \n  \nAntieke sluitingen omgevormd tot hedendaagse armbanden; keramische scherven, porseleinen beeldjes en herrezen \u2018kleine heiligen\u2019 aan elkaar gerijgd: de idee van een verzameling wordt speelser en breidt zijn definitie uit. Iriserende oppervlakken samengevoegd tot gemuteerde wezens; verblindende sieraden die voortkomen uit bijna niets; draden gewonnen uit flessen en geknoopt tot kant: het oude wordt opnieuw uitgevonden, tussen objecten van het verleden en structuren van de toekomst. Elektronische componen-ten bezet met gerecycled en gekleurd zilver: het principe van het juweel, opnieuw uitgedacht, betreedt een nieuwe dimensie.  \n  \nZes unieke, nauwgezette en gedurfde benaderingen, die nieuwe semantische velden openen en de wijzer verleggen van het verleden\/afgedankt naar de toekomst\/reconstructie. Er ontwikkelt zich een heerlijk subtiele dialoog tussen deze verschillende identiteiten, gevoelig voor het onverwachte.  \n  \nHumor sijpelt vaak door in deze creatieve avonturen, die echter doordrongen zijn van het bewustzijn van een onzeker heden.  \nNu eens een uitdagende houding tegenover vooroordelen en verwijzingen naar de betekenis van \u2018waar-de\u2019, dan weer een uitnodiging om verhalen te delen van herinneringen of utopische dromen, bieden de werken van de zes kunstenaars die Hectare samenbrengt onder de noemer Mati\u00e8res cueillies, onze zintui-gen een veredeld \u0153uvre waarvan de technische finesse doorprikt wordt met po\u00ebzie, in werken door-drongen van hun veelzijdige persoonlijkheden, tussen extravagantie, strengheid en lichtheid. ","performers":null,"boxoffice_url":null,"website":"https:\/\/hectare-galerie.be\/nl\/tentoonstellingen\/","email":"atelier@hectare-galerie.be","phone_contact":"+32 2 640 72 53","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700003221"}},"place":{"id":50001488,"translations":{"de":{"name":"Hectare Galerie","address_street_name":"Rue Faider","address_street_number":"86","address_street_box":null,"email":"atelier@hectare-galerie.be","website":"https:\/\/hectare-galerie.be\/","phone_contact":"+32 2 640 72 53","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Faider, 86","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Hectare Galerie","address_street_name":"Rue Faider","address_street_number":"86","address_street_box":null,"email":"atelier@hectare-galerie.be","website":"https:\/\/hectare-galerie.be\/","phone_contact":"+32 2 640 72 53","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Faider, 86","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Hectare Galerie","address_street_name":"Faiderstraat","address_street_number":"86","address_street_box":null,"email":"atelier@hectare-galerie.be","website":"https:\/\/hectare-galerie.be\/","phone_contact":"+32 2 640 72 53","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Faiderstraat, 86","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Hectare Galerie","address_street_name":"Rue Faider","address_street_number":"86","address_street_box":null,