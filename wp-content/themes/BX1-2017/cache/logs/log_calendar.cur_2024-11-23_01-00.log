blished_at":"2024-11-20T09:11:28+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":311758,"facebook_link":null,"import_origin":null,"is_part_of":"Art Deco 2025","sub_type":"other","ranking":0.31833136784577337,"languages":{"spoken":["it","en","pl","fr","de"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{}},"translations":{"de":{"name":"Art Deco meets Pop Art","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.napiorkowska.pl","email":"galeria@napiorkowska.pl","phone_contact":"495718988","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700003769"},"pt":{"name":"Art Deco meets Pop Art","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.napiorkowska.pl","email":"galeria@napiorkowska.pl","phone_contact":"495718988","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700003769"},"en":{"name":"Art Deco meets Pop Art","shortdescr":"Glamour & Extravagance\nART DECO meets POP ART\nDanuta Dabrowska Siemaszkiewicz\n\nWe kindly invite you to the exhibition of works by the esteemed painter and graphic artist Danuta D\u0105browska-Siemaszkiewicz at the Katarzyna Napi\u00f3rkowska Gallery in Brussels.","longdescr":"Danuta D\u0105browska-Siemaszkiewicz, a graduate of the Faculty of Graphic Arts at the Academy of Fine Arts in Krakow, is an artist whose work reflects a fascination with the Art Deco style. Her works have been published in prestigious magazines such as \u201cThe New Yorker,\u201d \u201cPrzekr\u00f3j,\u201d and \u201cMarie Claire,\u201d paying homage to the glamour and refined elegance of the 1920s.\nArt Deco, a style characterized by bold geometric forms and symmetry, emerged in Europe just before World War I. However, its full development occurred after 1925, when the Exposition Internationale des Arts D\u00e9coratifs et Industriels Modernes took place in Paris. This exhibition was a critical moment that defined a new style, attracting the attention of artists, architects, and designers worldwide. The name \u201cArt Deco\u201d derives from this exposition. The style gained popularity in the 1920s and 1930s, setting the direction for art celebrating elegance, sophistication, and extravagance.\nOn the other hand, Pop Art, as an art movement, emerged in the mid-1950s in the United Kingdom and the United States, with key figures like Richard Hamilton and Andy Warhol. It was characterized by incorporating imagery from popular culture, such as advertising, comic books, and mundane objects. It sought to challenge traditional fine art conventions by blurring the boundaries of the \u201chigh\u201d and popular culture.\nThe motifs and aesthetics of Art Deco and Pop Art continue to inspire contemporary artists. Danuta D\u0105browska-Siemaszkiewicz\u2019s exhibition is an opportunity to see her exceptional works and immerse yourself in the atmosphere of two inspiring movements. It is also a meeting with fascinating heroines depicted in her works. Among them is Amelia Earhart, the first woman to fly solo across the Atlantic Ocean.\nThe exhibition will open on Thursday, November 21, 2024, at 7:00 PM at the Katarzyna Napi\u00f3rkowska Gallery at Mont des Arts 8 in Brussels.\nOpening: 21.11.2024 at 7 pm\nExhibition:  21 November 2024-21 December 2024 ( appointments and 7\/7, 24\/24)\nGallery of Katarzyna Napi\u00f3rkowska\nMont des Arts 8\nBruxelles","performers":null,"boxoffice_url":null,"website":"http:\/\/www.napiorkowska.pl","email":"galeria@napiorkowska.pl","phone_contact":"495718988","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700003769"},"it":{"name":"Art Deco meets Pop Art","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.napiorkowska.pl","email":"galeria@napiorkowska.pl","phone_contact":"495718988","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700003769"},"cn":{"name":"Art Deco meets Pop Art","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.napiorkowska.pl","email":"galeria@napiorkowska.pl","phone_contact":"495718988","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700003769"},"fr":{"name":"Art D\u00e9co rencontre Pop Art","shortdescr":"Glamour & Extravagance-\nART DECO rencontre POP ART\nDanuta Dabrowska Siemaszkiewicz\n\nNous avons le plaisir de vous inviter \u00e0 l\u2019exposition des \u0153uvres de la peintre et graphiste estim\u00e9e Danuta D\u0105browska-Siemaszkiewicz \u00e0 la Galerie Katarzyna Napi\u00f3rkowska \u00e0 Bruxelles.","longdescr":"Danuta D\u0105browska-Siemaszkiewicz, dipl\u00f4m\u00e9e de la Facult\u00e9 des Arts Graphiques de l\u2019Acad\u00e9mie des Beaux-Arts de Cracovie, est une artiste dont l\u2019\u0153uvre refl\u00e8te une fascination pour le style Art d\u00e9co et Pop Art. Ses \u0153uvres ont \u00e9t\u00e9 publi\u00e9es dans des magazines prestigieux tels que \u201cThe New Yorker\u201d, \u201cPrzekr\u00f3j\u201d et \u201cMarie Claire\u201d, rendant hommage au glamour et \u00e0 l\u2019\u00e9l\u00e9gance raffin\u00e9e des ann\u00e9es 1920.\n\nL\u2019Art d\u00e9co, un style caract\u00e9ris\u00e9 par des formes g\u00e9om\u00e9triques audacieuses et la sym\u00e9trie, est apparu en Europe juste avant la Premi\u00e8re Guerre mondiale. Cependant, son plein d\u00e9veloppement s\u2019est produit apr\u00e8s 1925, lors de l\u2019Exposition Internationale des Arts D\u00e9coratifs et Industriels Modernes \u00e0 Paris. Cette exposition fut un moment crucial qui d\u00e9finit un nouveau style, attirant l\u2019attention des artistes, architectes et designers du monde entier. Le nom \u201cArt d\u00e9co\u201d d\u00e9rive de cette exposition. Le style a gagn\u00e9 en popularit\u00e9 dans les ann\u00e9es 1920 et 1930, donnant le ton \u00e0 un art c\u00e9l\u00e9brant l\u2019\u00e9l\u00e9gance, la sophistication et l\u2019extravagance.\n\nD\u2019autre part, le Pop Art, en tant que mouvement artistique, est apparu au milieu des ann\u00e9es 1950 au Royaume-Uni et aux \u00c9tats-Unis, avec des figures cl\u00e9s comme Richard Hamilton et Andy Warhol. Il se caract\u00e9risait par l\u2019incorporation d\u2019images de la culture populaire, telles que la publicit\u00e9, les bandes dessin\u00e9es et les objets du quotidien. Il cherchait \u00e0 remettre en question les conventions traditionnelles des beaux-arts en brouillant les fronti\u00e8res entre l\u2019art \u201cnoble\u201d et la culture \u201cpopulaire\u201d.\n\nLes motifs et l\u2019esth\u00e9tique de l\u2019Art d\u00e9co et du Pop Art continuent d\u2019inspirer les artistes contemporains. L\u2019exposition de Danuta D\u0105browska-Siemaszkiewicz est une opportunit\u00e9 de voir ses \u0153uvres exceptionnelles et de s\u2019immerger dans l\u2019atmosph\u00e8re de deux mouvements inspirants. C\u2019est \u00e9galement une rencontre avec des h\u00e9ro\u00efnes fascinantes repr\u00e9sent\u00e9es dans ses \u0153uvres. Parmi elles, Amelia Earhart, la premi\u00e8re femme \u00e0 traverser l\u2019Atlantique en solo.\n\nL\u2019exposition ouvrira ses portes le jeudi 21 novembre 2024, \u00e0 19h00, \u00e0 la Galerie Katarzyna Napi\u00f3rkowska situ\u00e9e au Mont des Arts 8 \u00e0 Bruxelles.\nVernissage: 21.11.2024 at 7 pm\nExposition:  21.11.2024-21.12.2024 ( sur RV et 7\/7, 24\/24)\nGalerie de Katarzyna Napi\u00f3rkowska\nMont des Arts 8\nBruxelles","performers":null,"boxoffice_url":null,"website":"http:\/\/www.napiorkowska.pl","email":"galeria@napiorkowska.pl","phone_contact":"495718988","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700003769"},"sp":{"name":"Art Deco meets Pop Art","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.napiorkowska.pl","email":"galeria@napiorkowska.pl","phone_contact":"495718988","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700003769"},"nl":{"name":"Art Deco meets Pop Art","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.napiorkowska.pl","email":"galeria@napiorkowska.pl","phone_contact":"495718988","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700003769"}},"place":{"id":251322,"translations":{"de":{"name":"Galerie Katarzyna Napi\u00f3rkowska","address_street_name":"Mont des Arts","address_street_number":"8","address_street_box":null,"email":null,"website":"http:\/\/www.napiorkowska.pl","phone_contact":"+32 495 71 89 88","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Mont des Arts, 8","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Galerie Katarzyna Napi\u00f3rkowska","address_street_name":"Mont des Arts","address_street_number":"8","address_street_box":null,"email":null,"website":"http:\/\/www.napiorkowska.pl","phone_contact":"+32 495 71 89 88","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Mont des Arts, 8","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Galerie Katarzyna Napi\u00f3rkowska","address_street_name":"Mont des Arts","address_street_number":"8","address_street_box":null,"email":null,"website":"http:\/\/www.napiorkowska.pl","phone_contact":"+32 495 71 89 88","