nt":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2023-08-30T13:45:02+02:00","published_at":"2023-08-30T13:37:08+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":284265,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"concert","ranking":1.2599210498948732,"languages":{"spoken":["en","fr"],"subtitles":[]},"categories":{"main":{"id":1,"translations":{"de":"Konzert","pt":null,"en":"Concert","it":"Concerti","cn":null,"fr":"Concert","sp":"Concierto","nl":"Concert"}},"others":{"list":[2],"translations":{"de":["Klassisch"],"pt":[null],"en":["Classical"],"it":["Classica"],"cn":[null],"fr":["Classique"],"sp":["Cl\u00e1sica"],"nl":["Klassiek"]}}},"translations":{"de":{"name":"\"Enluminures\". Quatuor Akhtamar","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lebaixu.be","email":"info@lebaixu.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50001552"},"pt":{"name":"\"Enluminures\". Quatuor Akhtamar","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lebaixu.be","email":"info@lebaixu.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50001552"},"en":{"name":"\"Enluminures\". Quatuor Akhtamar","shortdescr":"Now a staple of the repertoire, the String Quartet in G minor, Op. 10, nonetheless disconcerted Parisian audiences in its day. It takes us down the most unexpected harmonic paths, drawing on sounds as diverse as jazz, gamelan and Spanish folk music","longdescr":"Rich in colour and exotic tones, this majestic poetic work breaks free from the traditional musical rules of the West. Balancing between Belgium and France and with its heart set on Armenia, the Akhtamar Quartet was immediately won over by this unique work, a veritable bridge between different cultures and traditions.\n\nJust as the relationship between letters and illumination is constantly being revisited, Judith Adler de Oliveira has reworked age-old Armenian themes in a spirit that is sometimes faithful, sometimes at odds with tradition. The initial theme is always audible, and its anatomy provides the initial impetus for the composition, which moves imperceptibly, surreptitiously, from one musical language to another.\nSome of the themes chosen already feature in the Komitas\/Aslamazyan Miniatures, providing a gateway to this essential work in the Akhtamar Quartet's repertoire.","performers":"Quatuor Akhtamar","boxoffice_url":null,"website":"http:\/\/www.lebaixu.be","email":"info@lebaixu.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50001552"},"it":{"name":"\"Enluminures\". Quatuor Akhtamar","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lebaixu.be","email":"info@lebaixu.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50001552"},"cn":{"name":"\"Enluminures\". Quatuor Akhtamar","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lebaixu.be","email":"info@lebaixu.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50001552"},"fr":{"name":"\"Enluminures\". Quatuor Akhtamar","shortdescr":"D\u00e9sormais incontournable du r\u00e9pertoire, le Quatuor \u00e0 cordes en sol mineur, op. 10, a pourtant d\u00e9concert\u00e9 le public parisien en son temps. Il nous emm\u00e8ne sur les chemins harmoniques les plus inattendus, puisant dans des sonorit\u00e9s aussi diverses que le jazz, le gamelan et la musique folklorique espagnole","longdescr":" Riche en couleurs et en tonalit\u00e9s exotiques, cette \u0153uvre po\u00e9tique majestueuse s'affranchit des r\u00e8gles musicales traditionnelles de l'Occident. \u00c9quilibrant entre la Belgique et la France et le c\u0153ur tourn\u00e9 vers l'Arm\u00e9nie, le Quatuor Akhtamar a tout de suite \u00e9t\u00e9 conquis par cette \u0153uvre unique, v\u00e9ritable passerelle entre diff\u00e9rentes cultures et traditions.\nTout comme la relation entre lettre et enluminure est constamment revisit\u00e9e, Judith Adler de Oliveira a retravaill\u00e9 des th\u00e8mes arm\u00e9niens s\u00e9culaires dans un esprit tant\u00f4t fid\u00e8le, tant\u00f4t en rupture avec la tradition. Le th\u00e8me initial est toujours audible, et son anatomie donnera l'\u00e9lan initial \u00e0 la composition, qui passe insensiblement, subrepticement, d'un langage musical \u00e0 l'autre.\nCertains des th\u00e8mes choisis figurent d\u00e9j\u00e0 dans les Miniatures Komitas\/Aslamazyan, tra\u00e7ant ainsi une porte d'entr\u00e9e \u00e0 cette \u0153uvre essentielle du r\u00e9pertoire du Quatuor Akhtamar.","performers":"Quatuor Akhtamar","boxoffice_url":null,"website":"http:\/\/www.lebaixu.be","email":"info@lebaixu.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50001552"},"sp":{"name":"\"Enluminures\". Quatuor Akhtamar","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lebaixu.be","email":"info@lebaixu.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50001552"},"nl":{"name":"\"Enluminures\". Quatuor Akhtamar","shortdescr":"Het Strijkkwartet in G klein, op. 10, is nu niet meer weg te denken uit het repertoire, maar het bracht het Parijse publiek destijds toch in beroering. Het neemt ons mee op de meest onverwachte harmonische paden, puttend uit geluiden zo divers als jazz, gamelan en Spaanse volksmuziek.","longdescr":"Rijk aan kleur en exotische tonen breekt dit majestueuze po\u00ebtische werk los van de traditionele muzikale regels van het Westen. Balancerend tussen Belgi\u00eb en Frankrijk en met Armeni\u00eb in het vizier, was het Akhtamar Quartet onmiddellijk gewonnen voor dit unieke werk, een echte brug tussen verschillende culturen en tradities.\nNet zoals de relatie tussen letters en verlichting steeds opnieuw wordt bekeken, heeft Judith Adler de Oliveira eeuwenoude Armeense thema's bewerkt in een geest die soms trouw is, soms haaks staat op de traditie. Het beginthema is altijd hoorbaar en de anatomie ervan geeft de aanzet tot de compositie, die zich ongemerkt, stiekem, van de ene muzikale taal naar de andere beweegt.\nSommige van de gekozen thema's komen al voor in de Komitas\/Aslamazyan Miniaturen, en bieden zo een toegangspoort tot dit essenti\u00eble werk in het repertoire van het Akhtamar Quartet.","performers":"Quatuor Akhtamar","boxoffice_url":null,"website":"http:\/\/www.lebaixu.be","email":"info@lebaixu.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50001552"}},"place":{"id":279109,"translations":{"de":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"info@lebaixu.be","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"info@lebaixu.be","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"info@lebaixu.be","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard, 3","address_line2":"1000 Bruxelles","description_web":"The name \u201cBaixu\u201d means \u201cbeautiful\u201d in the native language of the Patax\u00f3 peoples, indigenous to the south of the state of Bahia in Brazil. This word represents both the ambition of the project and the quality of the cultural events presented, as well as the founders\u2019 attachment to Brazilian culture. Baisu is a quaint and welcoming space in the Tour & Taxis neighborhood in Brussels, which hosts concerts, expositions, screenings, or conferences \u2013 or where you can organise your private event.\r\nA project dedicated to \u201cbeauty\u201d in all its forms, where the keywords are quality, exchange and interaction.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"info@lebaixu.be","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"info@lebaixu.be","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"fr":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"info@lebaixu.be","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard, 3","address_line2":"1000 Bruxelles","description_web":"Un lieu atypique et chaleureux dans le quartier de Tour & Taxis \u00e0 Bruxelles pour assister \u00e0 des concerts, des expositions, des projections ou des conf\u00e9rences, ou pour y organiser vos \u00e9v\u00e8nements priv\u00e9s.\r\nUn projet d\u00e9di\u00e9 au \u00ab beau \u00bb sous toutes ses coutures, dont les maitres-mots sont qualit\u00e9, \u00e9changes et rencontres.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"info@lebaixu.be","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Le Baixu","address_street_name":"Picardstraat","address_street_number":"3","address_street_box":null,"email":"info@lebaixu.be","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Picardstraat, 3","address_line2":"1000 Bruxelles","description_web":"De naam \"Baixu\" betekent \"mooi\" in de taal van de Pataxos indianen die in de zuidelijke staat Bahia (Brazili\u00eb) wonen. Dit woord staat voor de ambitie van het project en de kwaliteit van de culturele evenementen, maar ook voor de verbondenheid van de initiatiefnemers met de Braziliaanse cultuur. \r\nLe Baixu is ondergebracht in een voormalig industrieel gebouw in het hart van de trendy Brusselse Tour & Taxis wijk. Een atypische en warme plek bedoeld voor concerten, tentoonstellingen, filmvertoningen en conferenties en waar je ook priv\u00e9 evenementen kan organiseren. Het is een volledig uitgeruste, multidisciplinaire culturele ruimte met een oppervlakte van 150 m2, gewijd aan de \"schoonheid\" in al haar vormen. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[8],"translations":{"de":["Kanal-Viertel"],"pt":[null],"en":["Canal"],"it":["Canal"],"cn":[null],"fr":["Canal"],"sp":["Canal"],"nl":["Kanaalwijk"]}},"zones":{"list":[20],"translations":{"de":["Norden"],"pt":[null],"en":["North"],"it":["Nord"],"cn":[null],"fr":["Nord"],"sp":["Norte"],"nl":["Noord"]}},"neca":null,"facebook_id":null,"backoffice_id":39109,"location":{"lat":50.86391031,"lon":4.34697026},"region":"brussels","last_updated_at":"2023-05-11T08:22:15+02:00","published_at":"2022-07-15T20:19:31+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":false,"resto_ranking":0},"organizer":{"id":279109,"translations":{"de":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"info@lebaixu.be","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"info@lebaixu.be","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard, 3