","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.atlantis-expo.com\/index.php?lang=fr","email":"info@atlantis-expo.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50002010"},"pt":{"name":"Atlantis - The Immersive Odyssey","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.atlantis-expo.com\/index.php?lang=fr","email":"info@atlantis-expo.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50002010"},"en":{"name":"Atlantis - The Immersive Odyssey","shortdescr":"Immerse yourself in the world of Atlantis - The Immersive Odyssey! Experience the magic with our captivating LED room, multi-user VR zone, and interactive dialogues with Zeus. Book now for an extraordinary adventure!","longdescr":"Dive into a mythical world in the heart of Brussels! Our immersive exhibition offers a captivating experience with a 150m\u00b2 LED room, a multi-user VR zone, interactive dialogue with Zeus via AI, and much more. An unforgettable adventure awaits you in a spectacular mythological setting. Book your spot now for an extraordinary experience!","performers":"Produced by ActiveMe (Creative Studio) & Tickets operated by Guestbooster","boxoffice_url":null,"website":"https:\/\/www.atlantis-expo.com\/index.php?lang=en","email":"info@atlantis-expo.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50002010"},"it":{"name":"Atlantis - The Immersive Odyssey","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.atlantis-expo.com\/index.php?lang=fr","email":"info@atlantis-expo.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50002010"},"cn":{"name":"Atlantis - The Immersiv