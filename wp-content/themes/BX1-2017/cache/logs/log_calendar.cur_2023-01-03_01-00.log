],"it":[null,null],"sp":[null,null],"pt":[null,null],"cn":[null,null]}},"tags":[],"accessibilities":{"list":[255],"translations":{"fr":["Accessible"],"nl":["Toegankelijk"],"en":["Accessible"],"de":["Barrierefrei"],"it":[null],"sp":[null],"pt":[null],"cn":[null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2023-01-02T01:35:47+01:00","published_at":"2022-06-16T11:50:36+02:00","backoffice_id":256182,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.32006146360353},{"id":535569,"date_start":"2022-06-11","date_end":"2023-01-08","date_next":"2023-01-03","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung","it":null,"sp":null,"pt":null,"cn":null}},"others":{"list":[36,39],"translations":{"fr":["Mus\u00e9es et art centers","Photographie"],"nl":["Musea en kunstcentra","Fotografie"],"en":["Museums and art centers","Photography"],"de":["Museen & Kunstzentren","Fotografie"],"it":[null,null],"sp":[null,null],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Voyages | Paysages \u2013 Christian Dotremont","shortdescr":"Cette ann\u00e9e, Christian Dotremont aurait eu 100 ans. La Fondation Roi Baudouin lui rend un hommage artistique \u00e0 la Wittockiana, o\u00f9 seront pr\u00e9sent\u00e9es des photos de Georges A. Bertrand. Il nous invite \u00e0 une d\u00e9couverte po\u00e9tique \u00e0 travers des lieux chers au c\u0153ur du po\u00e8te.","longdescr":"Christian Dotremont aurait eu 100 ans cette ann\u00e9e. En hommage, la Fondation Roi Baudouin organise une exposition de photographies de Georges A. Bertrand. Celui-ci nous invite \u00e0 un voyage po\u00e9tique au fil de lieux embl\u00e9matiques de la vie de Christian Dotremont et les fait dialoguer avec l\u2019\u0153uvre de l\u2019artiste. \u00c0 la Wittockiana, \u00e0 Bruxelles, du 11 juin au 2 octobre.\r\nSur les traces de Dotremont\r\nPhotographe-voyageur et \u00e2me-s\u0153ur de Christian Dotremont (1922-1979), Georges A. Bertrand \u00e9tait la personne idoine pour remonter les traces de l\u2019inventeur des logogrammes. Ses photos d\u00e9voilent des lieux chers au c\u0153ur du po\u00e8te, et la po\u00e9sie des clich\u00e9s tisse un dialogue avec des citations et des vers de Dotremont, ainsi qu\u2019avec une s\u00e9lection d\u2019objets et de livres illustr\u00e9s provenant de ses archives. \r\n\r\nFonds d\u2019archives Christian Dotremont\r\n\r\nC\u2019est en 2011 que Guy Dotremont rapporta de France le Fonds d\u2019archives de Christian Dotremont, son fr\u00e8re, pour le confier \u00e0 la Fondation Roi Baudouin. Depuis, la Fondation assure la conservation, la gestion et la mise en valeur de ce Fonds crucial pour le d\u00e9veloppement des connaissances au sujet de l\u2019artiste et de son \u0153uvre, mais aussi de la litt\u00e9rature et de l\u2019art d\u2019apr\u00e8s-guerre, et du mouvement CoBrA en particulier.\r\n \r\nDotremont, un grand voyageur\r\n\r\nLe po\u00e8te belge Christian Dotremont fut un grand voyageur qui eut un parcours \u00e9tonnant au sein de l\u2019avant-garde du XXe si\u00e8cle. Quittant le coll\u00e8ge \u00e0 l\u2019\u00e2ge de 17 ans, il rencontre les surr\u00e9alistes belges qu\u2019il fr\u00e9quente durant la guerre, voyageant entre Bruxelles et Paris, avant de fonder le mouvement CoBrA autour duquel il f\u00e9d\u00e8re les artistes exp\u00e9rimentaux du Nord. Si CoBrA fut une aventure ferroviaire, amenant le po\u00e8te \u00e0 voyager entre Copenhague, Bruxelles et Amsterdam, il poursuit sur sa lanc\u00e9e et accomplit de nombreux voyages vers le Grand Nord, jusqu\u2019\u00e0 sa d\u00e9couverte de la Laponie durant l\u2019hiver 1956 \u2013 1957. Il s\u2019y rendra r\u00e9guli\u00e8rement pour y tracer des logogrammes et des logoneiges. En 1963, il d\u00e9couvre l\u2019Irlande qu\u2019il nomme sa \u00ab Laponie verte \u00bb. \r\n\r\nUn cheminement po\u00e9tique, dans le sillage du cr\u00e9ateur du logogramme\r\n\r\nLe photographe Georges A. Bertrand et le commissaire d\u2019exposition St\u00e9phane Massonet nous invitent donc \u00e0 une d\u00e9couverte po\u00e9tique, \u00e0 travers l\u2019image photographique et le livre, en compagnie de l\u2019inventeur du logogramme.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.wittockiana.org","email":"info@wittockiana.org","phone_contact":null,"phone_booking":"+32 2 770 53 33","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.535569"},"nl":{"name":"Reizen | Landschappen - Christian Dotremont","shortdescr":"Christian Dotremont zou dit jaar 100 zijn geworden. De Koning Boudewijnstichting brengt in de Wittockiana een artistiek eerbetoon met foto\u2019s van Georges A. Bertrand. Hij neemt ons mee op een po\u00ebtische reis langs betekenisvolle plaatsen uit Dotremonts leven.","longdescr":"Christian Dotremont zou dit jaar 100 zijn geworden. Om hem te eren organiseert de Koning Boudewijnstichting een fototentoonstelling met werk van Georges A. Bertrand. Hij neemt ons mee op een po\u00ebtische reis langs betekenisvolle plaatsen uit Dotremonts leven en plaatst deze in dialoog met po\u00ebtisch werk van Christian Dotremont. \r\n\r\nIn de sporen van Dotremont\r\n\r\nAls fotograaf-reiziger en geestverwant van Christian Dotremont (1922-1979) is Georges A. Bertrand de geknipte persoon om de voetsporen te volgen van de uitvinder van het logogram. In zijn foto\u2019s toont hij plaatsen die bijzonder zijn voor de dichter en schilder. Citaten en gedichten van Christian Dotremont gaan in dialoog met de po\u00ebtische foto\u2019s van Georges A. Bertrand. Ook een selectie ge\u00efllustreerde boeken en objecten, afkomstig uit het priv\u00e9archief van deze emblematische kunstenaar, vergezellen de foto\u2019s.\r\n\r\nArchieffonds Christian Dotremont\r\n\r\nIn 2011 bracht Guy Dotremont, broer van Christian Dotremont, het Archieffonds van Christian Dotremont terug uit Frankrijk en schonk het aan de Koning Boudewijnstichting. Sindsdien staat de Stichting garant voor het behoud, het beheer en het verder levend houden van dit Fonds dat van kapitaal belang is voor de kennis van Dotremont en zijn werk, maar ook van de naoorlogse literatuur en kunst en meer specifiek van de CoBrA-beweging.\r\n\r\nDotremont, een groot reiziger\r\n\r\nDe Belgische dichter Christian Dotremont was een groot reiziger die een indrukwekkend parcours aflegde binnen de avant-gardebewegingen van de 20ste eeuw. Op 17-jarige leeftijd verliet hij de school en ontmoette de Belgische surrealisten, met wie hij tijdens de oorlog meermaals afsprak, reizend tussen Brussel en Parijs. Vervolgens richtte hij de Cobra-beweging op, waarin hij de experimentele kunstenaars van het Noorden verenigt. Cobra was een spoorwegavontuur, met vele reizen tussen Kopenhagen, Brussel en Amsterdam (COpenhagen, BRussels, Amsterdam). Daarna volgden talrijke reizen naar het Hoge Noorden, tot zijn ontdekking van Lapland in de winter van 1956-1957, waar hij regelmatig heen ging om logogrammen en logoneiges te tekenen. In 1963 ontdekte hij tot slot Ierland, dat hij zijn \"groene Lapland\" noemde.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.patrimoine-frb.be\/actualites\/voyages-paysages-christian-dotremont","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.535569"},"en":{"name":"Voyages | Paysages \u2013 Christian Dotremont","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.535569"},"de":{"name":"Voyages | Paysages \u2013 Christian Dotremont","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.535569"},"it":{"name":"Voyages | Paysages \u2013 Christian Dotremont","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.535569"},"sp":{"name":"Voyages | Paysages \u2013 Christian Dotremont","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.535569"},"pt":{"name":"Voyages | Paysages \u2013 Christian Dotremont","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.535569"},"cn":{"name":"Voyages | Paysages \u2013 Christian Dotremont","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.535569"}},"place":{"id":142,"translations":{"fr":{"name":"Bibliotheca Wittockiana : Mus\u00e9e des Arts du livre et de la Reliure","address_street_name":"Rue du Bemel","address_street_number":"23","address_street_box":null,"email":"info@wittockiana.org","website":"http:\/\/www.wittockiana.org","phone_contact":"+32 2 770 53 33","phone_booking":null,"address_zip":"1150","address_city":"Woluwe-Saint-Pierre","address_line1":"Rue du Bemel, 23","address_line2":"1150 Woluwe-Saint-Pierre","description_web":"Fond\u00e9e en 1983 par Michel Wittock, bibliophile de re