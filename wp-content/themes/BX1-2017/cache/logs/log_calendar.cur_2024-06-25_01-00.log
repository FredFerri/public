r\nEen extraatje: de Jacques Brel Foundation organiseert regelmatig filmclubs waarop France Brel aanwezig is, een van de dochters van de befaamde zanger (in het Frans).\r\n\r\nToerist of echte kenner, iedereen Is welkom ! \r\n\r\n*De Brussels Card omvat enkel de permanente tentoonstelling van het museum. De cinema en de wandeling zijn bijkomende activiteiten.  ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":31719,"location":{"lat":50.84424659,"lon":4.35199771},"last_updated_at":"2022-10-10T10:25:09+02:00","published_at":"2018-08-03T13:26:29+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/e83d4b16a11a764def3f89eeffe8361dc4a9121f.png","width":2500,"height":1875,"ratio":1.33,"oEmbed_height":1875,"oEmbed_width":2500,"translations":{"de":{"title":"Avec Brel dans Bruxelles - Promenade","copyright":"\u00a9 Fondation Jacques Brel"},"pt":{"title":"Avec Brel dans Bruxelles - Promenade","copyright":"\u00a9 Fondation Jacques Brel"},"en":{"title":"Avec Brel dans Bruxelles - Promenade","copyright":"\u00a9 Fondation Jacques Brel"},"it":{"title":"Avec Brel dans Bruxelles - Promenade","copyright":"\u00a9 Fondation Jacques Brel"},"cn":{"title":"Avec Brel dans Bruxelles - Promenade","copyright":"\u00a9 Fondation Jacques Brel"},"fr":{"title":"Avec Brel dans Bruxelles - Promenade","copyright":"\u00a9 Fondation Jacques Brel"},"sp":{"title":"Avec Brel dans Bruxelles - Promenade","copyright":"\u00a9 Fondation Jacques Brel"},"nl":{"title":"Avec Brel dans Bruxelles - Promenade","copyright":"\u00a9 Fondation Jacques Brel"}}},{"type":"video","link":"https:\/\/www.youtube.com\/watch?v=qZaIvCILP_o","width":356,"height":200,"ratio":null,"oEmbed_title":"Promenade JACQUES BREL Wandeling","oEmbed_author_name":"Fondation Jacques Brel","oEmbed_au