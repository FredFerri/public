achent-elles des arbres? Un juste \u00e9quilibre des v\u00e9g\u00e9taux afin de survivre. Nous aborderons la g\u00e9omorphologie de la \"for\u00eat de Soignes\" ainsi que l'aspect historique. ","performers":"Guide: Guy Rens","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":"+32 476 35 19 12","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50011926"},"sp":{"name":"Promenade en for\u00eat de Soignes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":"+32 476 35 19 12","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50011926"},"nl":{"name":"Promenade en for\u00eat de Soignes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":"+32 476 35 19 12","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50011926"}},"place":{"id":1353,"translations":{"de":{"name":"Centre d'Art de Rouge-Clo\u00eetre","address_street_name":"Rue du Rouge-Clo\u00eetre","address_street_number":"4","address_street_box":null,"email":"info@rouge-cloitre.be","website":"http:\/\/www.rouge-cloitre.be","phone_contact":"+32 2 660 55 97","phone_booking":null,"address_zip":"1160","address_city":"Auderghem","address_line1":"Rue du Rouge-Clo\u00eetre, 4","address_line2":"1160 Auderghem","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Centre d'Art de Rouge-Clo\u00eetre","address_street_name":"Rue du Rouge-Clo\u00eetre","address_street_number":"4","address_street_box":null,"email":"info@rouge-cloitre.be","website":"http:\/\/www.rouge-cloitre.be","phone_contact":"+32 2 660 55 97","phone_booking":null,"address_zip":"1160","address_city":"Auderghem","address_line1":"Rue du Rouge-Clo\u00eetre, 4","address_line2":"1160 Auderghem","description_w