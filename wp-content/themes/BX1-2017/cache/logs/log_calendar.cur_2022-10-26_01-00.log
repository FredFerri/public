urences":{"is_first":true,"is_second":true,"is_third":true,"is_fourth":true,"is_last":false},"time_start":"14:00:00","time_end":"18:00:00","translations":{"fr":"Ouvert les premier, deuxi\u00e8me, troisi\u00e8me et quatri\u00e8me samedis du mois de 14:00 \u00e0 18:00","nl":"Open op de eerste, tweede, derde en vierde zaterdags van de maand van 14:00 tot 18:00","en":"Open the first, second, third and fourth saturdays of the month from 14:00 to 18:00"}},{"day":"sunday","occurences":{"is_first":true,"is_second":true,"is_third":true,"is_fourth":true,"is_last":true},"time_start":"09:00:00","time_end":"13:00:00","translations":{"fr":"Ouvert les premier, deuxi\u00e8me, troisi\u00e8me, quatri\u00e8me et dernier dimanches du mois de 09:00 \u00e0 13:00","nl":"Open op de eerste, tweede, derde, vierde en laatste zondags van de maand van 09:00 tot 13:00","en":"Open the first, second, third, fourth and last sundays of the month from 09:00 to 13:00"}}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":75},{"translations":{"fr":{"name":"Enfants"},"nl":{"name":"Kinderen"},"en":{"name":"Children"}},"value":45}],"child_events":[],"parent_events":[],"targets":{"list":[11,10,19,7,8,16],"translations":{"fr":["Famille","Seniors","Enseignants","Jeunes 12-15 ans","Jeunes 15-18 ans","Ecoles"],"nl":["Familie","Senioren","Leerkrachten","Jongeren 12-15 j.","Jongeren 15-18 j.","Scholen"],"en":["Family","Seniors","Teachers","Youth 12-15  yr.","Youth 15-18  yr.","Schools"]}},"tags":["kids"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-24T01:05:55+02:00","published_at":"2021-06-16T12:32:30+02:00","backoffice_id":233441,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.10233859542617},{"id":510572,"date_start":"2021-05-02","date_end":"2025-08-31","date_next":"2022-10-30","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen"}},"others":{}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Art Nouveau : De la Source aux \u00c9tangs","shortdescr":"Le tour \u00ab Art Nouveau : de la Source aux \u00c9tangs \u00bb vous emm\u00e8ne du quartier Defacqz jusqu\u2019aux \u00e9tangs d\u2019Ixelles, \u00e0 la d\u00e9couverte d\u2019architectes de la premi\u00e8re et de la seconde g\u00e9n\u00e9ration de l\u2019Art Nouveau.","longdescr":"Laissez-vous conter l\u2019histoire urbanistique de ces quartiers jouxtant l\u2019Avenue Louise et l\u2019Abbaye de La Cambre en (re-)d\u00e9couvrant de nombreuses fa\u00e7ades de maisons et h\u00f4tels particuliers.\r\n\r\nAbritant plusieurs \u0153uvres d\u2019architectes majeurs, le quartier Defacqz t\u00e9moigne des premiers \u00e9lans de l\u2019architecture Art Nouveau \u00e0 Bruxelles. Apr\u00e8s quelques arr\u00eats autour de la rue Defacqz et de l\u2019avenue Louise, la visite se poursuit dans le quartier plus paisible des \u00e9tangs d\u2019Ixelles \u00e0 la rencontre d\u2019autres tr\u00e9sors architecturaux.\r\n\r\nD\u00e9couvrez des bijoux insoup\u00e7onn\u00e9s dans des quartiers travers\u00e9s tous les jours par des milliers de personnes et qui ont vu, malgr\u00e9 les (r)\u00e9volutions urbaines, leur beaut\u00e9 et leurs richesses pr\u00e9serv\u00e9es !\r\n\r\nAu programme de la balade, entre autres\u2026\r\n\u2013 L\u2019H\u00f4tel Tassel, de Victor Horta ;\r\n\u2013 L\u2019H\u00f4tel Solvay, de Victor Horta ;\r\n\u2013 L\u2019H\u00f4tel Otlet, d\u2019Octave van Rysselberghe et Henry Van de Velde ;\r\n\u2013 L\u2019H\u00f4tel Ciamberlani, de Paul Hankar ;\r\n\u2013 D\u2019autres \u0153uvres d\u2019Albert Roosenboom, Ernest Delune, Ernest Blerot ;\r\n\u2013 Mais aussi de nombreuses petites histoires et anecdotes !\r\n\r\nNous ne rentrerons pas dans les maisons et h\u00f4tels (souvent habit\u00e9s), mais des supports photographiques sont pr\u00e9vus pour vous permettre de mieux vous rendre compte de l\u2019int\u00e9rieur des \u00e9difices. Parce que l\u2019Art Nouveau est un \u201cArt Total\u201d qui ne s\u2019arr\u00eate certainement pas aux fa\u00e7ades !\r\n\r\nINFORMATIONS Pratiques\r\ntours r\u00e9guliers en fran\u00e7ais et en anglais :\r\nPrix : Libre et conscient\r\nR\u00e9servation + que conseill\u00e9e\r\nDur\u00e9e : Environ 2 heures\r\nRendez-vous : \u201cLouise Tower\u201d (devant l\u2019entr\u00e9e de la tour), avenue Louise 149 \u2013 1050 Bruxelles (en face de l\u2019arr\u00eat de tram Defacqz)\r\nFin de la visite : Au bord des \u00c9tangs d\u2019Ixelles\r\n\r\nTour priv\u00e9 sur demande en fran\u00e7ais ou en anglais","performers":"Une visite guid\u00e9e originale de Brussels By Foot","boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/art-nouveau-de-la-source-aux-etangs\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.510572"},"nl":{"name":"Art Nouveau : De la Source aux \u00c9tangs","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.510572"},"en":{"name":"Art Nouveau : From the Spring to the Ponds","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.510572"},"de":{"name":"Art Nouveau : De la Source aux \u00c9tangs","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url"