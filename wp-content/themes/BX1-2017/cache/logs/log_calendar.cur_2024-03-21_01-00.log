ame":"Exposition - Cities of Lost Memory","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/fullcircle15.wildapricot.org\/event-5586894","email":"events@fullcircle.eu","phone_contact":"+32 2 644 37 77","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50006596"},"en":{"name":"Cities of Lost Memory","shortdescr":"To visit the exhibition, please make an appointment.","longdescr":"His Indian ink drawings of historical events and figures offer us a perception of history that is neither smooth nor comfortable. He brings vestiges of our past to life, offering a guided tour of history through his drawings. Just like an archaeologist, he brings the vestiges of the past to life in the present, offering us, through his visual perspective, an alternative tour of History.","performers":"Alexandre Mitchell is a writer, archaeologist and artist based in Brussels exploring the contradictions of history and how our cities have been moulded by events.","boxoffice_url":null,"website":"https:\/\/fullcircle15.wildapricot.org\/event-5586894","email":"events@fullcircle.eu","phone_contact":"+32 2 644 37 77","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50006596"},"it":{"name":"Exposition - Cities of Lost Memory","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/fullcircle15.wildapricot.org\/event-5586894","email":"events@fullcircle.eu","phone_contact":"+32 2 644 37 77","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50006596"},"cn":{"name":"Exposition - Cities of Lost Memory","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/fullcircle15.wildapricot.org\/event-5586894","email":"events@fullcircle.eu","phone_contact":"+32 2 644 37 77","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50006596"},"fr":{"name":"Cities of Lost Memory","shortdescr":"Pour visiter l'exposition, veuillez prendre rendez-vous.","longdescr":"Ses dessins \u00e0 l'encre de Chine d'\u00e9v\u00e9nements et de personnages historiques nous offrent une perception de l'histoire qui n'est ni lisse ni confortable. Il ravive les vestiges de notre pass\u00e9, offrant une visite guid\u00e9e de l'histoire \u00e0 travers ses dessins. Tel un arch\u00e9ologue, il fait revivre les vestiges du pass\u00e9 dans le pr\u00e9sent, nous offrant, \u00e0 travers sa perspective visuelle, une visite alternative de l'Histoire.","performers":"Alexandre Mitchell est un \u00e9crivain, arch\u00e9ologue et artiste bas\u00e9 \u00e0 Bruxelles. Il explore les contradictions de l'histoire et la fa\u00e7on dont nos villes ont \u00e9t\u00e9 fa\u00e7onn\u00e9es par les \u00e9v\u00e9nements.  ","boxoffice_url":null,"website":"https:\/\/fullcircle15.wildapricot.org\/event-5586894","email":"events@fullcircle.eu","phone_contact":"+32 2 644 37 77","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50006596"},"sp":{"name":"Exposition - Cities of Lost Memory","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/fullcircle15.wildapricot.org\/event-5586894","email":"events@fullcircle.eu","phone_contact":"+32 2 644 37 77","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50006596"},"nl":{"name":"Cities of Lost Memory","shortdescr":"Maak een afspraak om de expositie te bezoeken.","longdescr":"Zijn tekeningen in Oost-Indische inkt van historische gebeurtenissen en figuren bieden ons een perceptie van de geschiedenis die noch glad noch comfortabel is. Hij brengt overblijfselen van ons verleden tot leven en biedt ons via zijn tekeningen een rondleiding door de geschiedenis. Net als een archeoloog brengt hij de overblijfselen van het verleden tot leven in het heden en biedt hij ons, via zijn visuele perspectief, een alternatieve rondleiding door de geschiedenis.","performers":"Alexandre Mitchell is schrijver, archeoloog en kunstenaar in Brussel. Hij onderzoekt de tegenstrijdigheden van de geschiedenis en hoe onze steden zijn gevormd door gebeurtenissen.  ","boxoffice_url":null,"website":"https:\/\/fullcircle15.wildapricot.org\/event-5586894","email":"events@fullcircle.eu","phone_contact":"+32 2 644 37 77","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50006596"}},"place":{"id":275426,"translations":{"de":{"name":"Full Circle","address_street_name":"Chauss\u00e9e de Vleurgat","address_street_number":"89","address_street_box":null,"email":"info@fullcircle.eu","website":"http:\/\/www.fullcirclespaces.com","phone_contact":"+32 2 644 37 77","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Chauss\u00e9e de Vleurgat, 89","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Full Circle","address_street_name":"Chauss\u00e9e de Vleurgat","address_street_number":"89","address_street_box":null,"email":"info@fullcircle.eu","website":"http:\/\/www.fullcirclespaces.com","phone_contact":"+32 2 644 37 77","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Chauss\u00e9e de Vleurgat, 89","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Full Circle","address_street_name":"Chauss\u00e9e de Vleurgat","address_street_number":"89","address_street_box":null,"email":"info@fullcircle.eu","website":"http:\/\/www.fullcirclespaces.com","phone_contact":"+32 2 644 37 77","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Chauss\u00e9e de Vleurgat, 89","address_line2":"1050 Ixelles","description_web"