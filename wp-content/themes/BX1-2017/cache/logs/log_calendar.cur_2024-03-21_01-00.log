\/agenda\/event-detail.50006762"},"sp":{"name":"1 H Quiz Game 150% FUN : 2 persons","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.spacefungame.com","email":"info@spacefungame.com","phone_contact":"+32 2 720 01 23","phone_booking":"+32 2 720 01 23","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50006762"},"nl":{"name":"1 U Quiz Game 150% FUN : 2 personen","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.spacefungame.com","email":"info@spacefungame.com","phone_contact":"+32 2 720 01 23","phone_booking":"+32 2 720 01 23","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50006762"}},"place":{"id":267946,"translations":{"de":{"name":"Space Fun Games","address_street_name":"Galerie Carrefour Shopping Saint Michel","address_street_number":null,"address_street_box":null,"email":"info@spacefungame.com","website":"http:\/\/www.spacefungame.com","phone_contact":"+32 2 720 01 23","phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Galerie Carrefour Shopping Saint Michel","address_line2":"1040 Etterbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Space Fun Games","address_street_name":"Galerie Carrefour Shopping Saint Michel","address_street_number":null,"address_street_box":null,"email":"info@spacefungame.com","website":"http:\/\/www.spacefungame.com","phone_contact":"+32 2 720 01 23","phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Galerie Carrefour Shopping Saint Michel","address_line2":"1040 Etterbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Space Fun Games","address_street_name":"Galerie Carrefour Shopping Saint Michel","address_street_number":null,"address_street