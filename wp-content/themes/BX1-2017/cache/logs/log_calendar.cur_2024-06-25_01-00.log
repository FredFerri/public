mail":"adm@theatrecreanova.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50010976"},"cn":{"name":"Stage : L'art de la chute","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrecreanova.be\/stages-adultes\/","email":"adm@theatrecreanova.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50010976"},"fr":{"name":"Stage : L'art de la chute","shortdescr":"Comment les petits accidents dans le jeu m\u00e8nent aux grands \u00e9clats de rire ?","longdescr":"\nVoici un atelier d\u00e9di\u00e9 aux petits rat\u00e9s, aux d\u00e9parts qui ont lieu trop t\u00f4t ou trop tard, \u00e0 l\u2019\u00e9nergie du corps parfois trop molle ou trop fougueuse.\n\nComment le corps peut heurter une chaise, un nez se cogner contre une porte, une joue recevoir une claque, un verre nous glisser des doigts\u2026 Il s\u2019agira d\u2019explorer les mouvements qui provoquent la chute, le glissement, le heurt mais aussi l\u2019impossibilit\u00e9 de r\u00e9aliser une action simple comme enfiler son propre pull.\n\nCet atelier vous permettra d\u2019acqu\u00e9rir des techniques pr\u00e9cises pour cr\u00e9er et jouer un accident corporel sans vous blesser et provoquer ainsi le rire du spectateur.","performers":"Maxime Membrive","boxoffice_url":null,"website":"https:\/\/www.theatrecreanova.be\/stages-adultes\/","email":"adm@theatrecreanova.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50010976"},"sp":{"name":"Stage : L'art de la chute","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrecreanova.be\/stages-adultes\/","email":"adm@theatrecreanova.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50010976"},"nl":{"