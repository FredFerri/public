e in het Brussels Gewest. \r\nHet bevindt zich in een uitzonderlijke staat van bewaring, waardoor de aanwezigheid van een oud vakwerkgebouw uit de eerste helft van de 15de eeuw aan het licht is gekomen, dat gedeeltelijk bewaard is gebleven in het hart van recentere constructies.\r\nHet team van onderzoekers zal u meenemen op een reis van herontdekking van zijn \r\ngeschiedenis.","performers":null,"boxoffice_url":null,"website":null,"email":"toerisme@anderlecht.brussels","phone_contact":"+32 2 526 83 30","phone_booking":"+32 2 526 83 30","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.544948"},"en":{"name":"Le centre historique d'Anderlecht et ses d\u00e9couvertes arch\u00e9ologiques","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.544948"},"de":{"name":"Le centre historique d'Anderlecht et ses d\u00e9couvertes arch\u00e9ologiques","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.544948"},"it":{"name":"Le centre historique d'Anderlecht et ses d\u00e9couvertes arch\u00e9ologiques","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.544948"},"sp":{"name":"Le centre historique d'Anderlecht et ses d\u00e9couvertes arch\u00e9ologiques","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.544948"},"pt":{"name":"Le centre historique d'Anderlecht et ses d\u00e9couvertes arch\u00e9ologiqu