ee":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2025-01-28T15:52:44+01:00","published_at":"2025-01-27T10:20:05+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":316952,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"misc","ranking":1.100642416298209,"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"categories":{"main":{"id":84,"translations":{"de":"Verschiedenes","pt":null,"en":"Various","it":"Varie","cn":null,"fr":"Divers","sp":"Varios","nl":"Varia"}},"others":{"list":[89],"translations":{"de":["Literatur"],"pt":[null],"en":["Litterature "],"it":["Letteratura"],"cn":[null],"fr":["Litt\u00e9rature"],"sp":["Literatura"],"nl":["Literatuur"]}}},"translations":{"de":{"name":"Passa Porta Festival 2025","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.passaporta.be\/fr\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700005836"},"pt":{"name":"Passa Porta Festival 2025","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.passaporta.be\/fr\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700005836"},"en":{"name":"Passa Porta Festival 2025","shortdescr":"Power to the imagination in Brussels! Next spring, a hundred writers and artists will animate the city, as literature takes over the capital for three days. Welcome to the Passa Porta Festival!","longdescr":"Every two years, the international house of literature Passa Porta hosts a multilingual festival, the largest literary event in the Benelux and a regular fixture in the calendar of many readers.\n\nFor its 10th edition, the Passa Porta Festival once again takes us on a wonderful voyage of discovery into contemporary literature, driven by an inspiring theme: GHOSTS. Each new book conjures up the ghosts of past writers, while casting its shadow into the future. Writers never die. From 28 to 30 March, they will conspire with ghosts to turn Brussels into a great literary hall of mirrors.\n\nAuthors, musicians, artists, and actors will explore the different aspects of this theme and confront the ghost worlds of family, love, and politics. Writers will poke holes in time and space, debate the shadowy sides of history, and reflect on apocalyptic visions of the future.\n\nYou won\u2019t find any ghostwriters at the 10th Passa Porta Festival, but there will be plenty of flesh-and-blood writers to enthral you with the most vibrant works of literature.\n\nOn the programme\nThe full programme will be revealed in February, but you can already save the following dates:\n\nFriday 28 March\nFive international authors read a new text in \u2018Ghost Stories\u2019, a haunting evening at La Monnaie.\n\nSaturday 29 and Sunday 30 March\nMeetings, interviews, panel discussions, readings, reading clubs, concerts, book signings, workshops, walks, tours, and performances at a dozen cultural hotspots in Brussels, making for two days of literary celebrations.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.passaporta.be\/en\/magazine\/the-tenth-passa-porta-festival-will-be-held-from-27-to-30-march-2025","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700005836"},"it":{"name":"Passa Porta Festival 2025","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.passaporta.be\/fr\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700005836"},"cn":{"name":"Passa Porta Festival 2025","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.passaporta.be\/fr\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700005836"},"fr":{"name":"Passa Porta Festival 2025","shortdescr":"L'imagination au pouvoir \u00e0 Bruxelles ! Au printemps prochain, une centaine d'\u00e9crivain\u00b7e\u00b7s et d'artistes investiront Bruxelles pour y faire rayonner la litt\u00e9rature pendant trois jours. Bienvenue au Passa Porta Festival ! ","longdescr":"Tous les deux ans, la Maison internationale des litt\u00e9ratures Passa Porta donne rendez-vous pour son festival, l'un des \u00e9v\u00e9nements litt\u00e9raires internationaux les plus ambitieux d'Europe : un rendez-vous attendu par les lecteurs et les lectrices.\n\nPour ce qui sera sa dixi\u00e8me \u00e9dition du 28 au 30 mars prochain, le Passa Porta Festival promet une nouvelle exploration de la litt\u00e9rature contemporaine sous un th\u00e8me fascinant : \"GHOSTS\". Nous sommes tous et toutes hant\u00e9\u00b7es par un moment, une histoire, un geste. Fant\u00f4mes amoureux, familiaux ou politiques : la litt\u00e9rature, qui raconte ces histoires, est une maison hant\u00e9e. Et, puisque les \u00e9crivain\u00b7e\u00b7s ne meurent jamais vraiment, les grand\u00b7e\u00b7s \u00e9crivain\u00b7e\u00b7s du pass\u00e9 continuent \u00e0 parler aux auteurs et autrices contemporains.\n\nDu 28 au 30 mars, le Passa Porta Festival conspirera avec les fant\u00f4mes pour faire de Bruxelles un grand bal de spectres et un jeu de miroirs litt\u00e9raires. Auteur\u00b7ices, musicien\u00b7nes et artistes raconteront leurs visions des fant\u00f4mes. Ils creuseront des passages dans l'espace-temps, investiront les zones d'ombre de l'Histoire. Ils exploreront aussi les images apocalyptiques de l'avenir, la spectralisation annonc\u00e9e des relations humaines et les enjeux de l'Intelligence artificielle ...\n\nVous ne trouverez pas de \"ghostwriters\" \u00e0 la dixi\u00e8me \u00e9dition du Passa Porta Festival, mais de vrai\u00b7e\u00b7s \u00e9crivain\u00b7e\u00b7s qui incarnent le meilleur de la litt\u00e9rature contemporaine.\n\nAu programme\nNous d\u00e9voilerons le programme complet du festival en f\u00e9vrier, mais en voici d\u00e9j\u00e0 quelques grandes lignes :\n\nVendredi 28 mars\nCinq \u00e9crivain\u00b7e\u00b7s de renomm\u00e9e internationale livrent un texte in\u00e9dit pour \"Ghost Stories\", une soir\u00e9e hant\u00e9e \u00e0 La Monnaie.\n\nSamedi 29 et dimanche 30 mars\nRencontres, interviews, tables rondes, lectures in\u00e9dites, clubs de lectures, ateliers, s\u00e9ances de d\u00e9dicaces, promenades litt\u00e9raires, visites guid\u00e9es d'exposition et performances seront au programme de deux jours de parcours dans une dizaine de th\u00e9\u00e2tres, salles de spectacle et lieux culturels du centre de Bruxelles.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.passaporta.be\/fr\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700005836"},"sp":{"name":"Passa Porta Festival 2025","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.passaporta.be\/fr\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700005836"},"nl":{"name":"Passa Porta Festival 2025","shortdescr":"De verbeelding aan de macht in Brussel. Volgend voorjaar begeestert een honderdtal schrijvers en kunstenaars de hoofdstad en zwaait de literatuur drie dagen lang de scepter. Welkom op het Passa Porta Festival!","longdescr":"Om de twee jaar presenteert internationaal literatuurhuis Passa Porta zijn meertalige festival, het grootste literatuurevenement van de Benelux, een vaste afspraak in de agenda van veel lezers.\n\nVoor zijn tiende editie belooft het Passa Porta Festival opnieuw een mooie ontdekkingsreis door de hedendaagse literatuur, aangedreven door een inspirerend thema: \u2018GHOSTS\u2019. Elk nieuw boek roept geesten op van schrijvers uit het verleden en werpt tegelijkertijd zijn schaduw vooruit. Schrijvers sterven niet. Van 28 tot 30 maart spannen ze samen met spoken om van Brussel een groot literair spiegelpaleis te maken.\n\nAuteurs, muzikanten, kunstenaars en acteurs gaan in interactie met de vele associaties die het thema biedt en kijken de spookwerelden van familie, liefde en politiek in de ogen. Schrijvers slaan gaten in tijd en ruimte, debatteren over schimmige onderdelen uit de geschiedenis en reflecteren over doembeelden voor de toekomst.\n\nGhostwriters zal je niet vinden op het tiende Passa Porta Festival, wel heel veel echte schrijvers die je begeesteren met het beste uit de springlevende literatuur.\n\nOp het programma\nHet volledige programma onthullen we in februari, maar je kan alvast volgende momenten noteren:\n\nVrijdag 28 maart\nVijf internationale auteurs brengen een nieuwe tekst in \u2018Ghost Stories\u2019, een beklijvende avond in De Munt.\n\nZaterdag 29 en zondag 30 maart\nOntmoetingen, interviews, panelgesprekken, lezingen, leesclubs, optredens, signeersessies, workshops, wandelingen, rondleidingen en performances op een dozijn culturele hotspots in Brussel, goed voor twee dagen literair feest.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.passaporta.be\/nl\/magazine\/de-tiende-editie-van-het-passa-porta-festival-van-27-tot-30-maart-2025","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700005836"}},"place":{"id":240645,"translations":{"de":{"name":"Passa Porta","address_street_name":"Rue Antoine Dansaert","address_street_number":"46","address_street_box":null,"email":"info@passaporta.be","website":"http:\/\/www.passaporta.be","phone_contact":"+32 2 226 04 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Antoine Dansaert, 46","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Passa Porta","address_street_name":"Rue Antoine Dansaert","address_street_number":"46","address_street_box":null,"email":"info@passaporta.be","website":"http:\/\/www.passaporta.be","phone_contact":"+32 2 226 04 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Antoine Dansaert, 46","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Passa Porta","address_street_name":"Rue Antoine Dansaert","address_street_number":"46","address_street_box":null,"email":"info@passaporta.be","website":"http:\/\/www.passaporta.be","phone_contact":"+32 2 226 04 54","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue Antoine Dansaert, 46","address_line2":"1000 Brussels","description_web":"Passa Porta is the international house of literature in Brussels. Founded in 2004 by the organizations Het beschrijf and Entrez Lire, it is a multilingual organization in the heart of Europe. A unique place where all kinds of literature lovers, authors, readers, translators and cultural mediators can meet and work.\r\nIt offers literary encounters, creative projects for authors and translators and an international program for writers in residence. \r\nPassa Porta also organizes the biennial Passa Porta Festival, one of the most prestigious literary festivals in Europe. It attracts thousands of visitors to more than twenty locations in Brussels.     \r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Passa Porta","address_street_name":"Rue Antoine Dansaert","address_street_number":"46","address_street_box":null,"email":"info@passaporta.be","website":"http:\/\/www.passaporta.be","phone_contact":"+32 2 226 04 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Antoine Dansaert, 46","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Passa Porta","address_street_name":"Rue Antoine Dansaert","address_street_number":"46","address_street_box":null,"email":"info@passaporta.be","website":"http:\/\/www.passaporta.be","phone_contact":"+32 2 226 04 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Antoine Dansaert, 46","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Passa Porta","address_street_name":"Rue Antoine Dansaert","address_street_number":"46","address_street_box":null,"email":"info@passaporta.be","website":"http:\/\/www.passaporta.be","phone_contact":"+32 2 226 04 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Antoine Dansaert, 46","address_line2":"1000 Bruxelles","description_web":"Passa Porta est la maison internationale des litt\u00e9ratures \u00e0 Bruxelles. Fond\u00e9e en 2004 sous l\u2019impulsion des organisations litt\u00e9raires Het beschrijf et Entrez Lire, elle est aujourd\u2019hui un lieu unique en son genre, au c\u0153ur de l\u2019Europe. Une maison plurillingue qui permet aux auteurs, lecteurs, traducteurs et autres amoureux litt\u00e9raires de se rencontrer et de s\u2019inspirer mutuellement. \r\nRencontres litt\u00e9raires (intra et extra muros), d\u00e9bats d\u2019id\u00e9es, cr\u00e9ations de textes, clubs de lecture, traductions, collectif de po\u00e8tes\u2026 Passa Porta se veut \u00e0 la fois exigeante et ouverte \u00e0 tous. La maison g\u00e8re \u00e9galement un programme international pour les \u00e9crivains en r\u00e9sidence. \r\nLe festival Passa Porta (un des plus prestigieux d\u2019Europe), a lieu tous les deux ans et attire plusieurs milliers de curieux et\/ou passionn\u00e9s dans une vingtaine de lieux culturels bruxellois. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Passa Porta","address_street_name":"Rue Antoine Dansaert","address_street_number":"46","address_street_box":null,"email":"info@passaporta.be","website":"http:\/\/www.passaporta.be","phone_contact":"+32 2 226 04 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Antoine Dansaert, 46","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Passa Porta","address_street_name":"Antoine Dansaertstraat","address_street_number":"46","address_street_box":null,"email":"info@passaporta.be","website":"http:\/\/www.passaporta.be","phone_contact":"+32 2 226 04 54","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Antoine Dansaertstraat, 46","address_line2":"1000 Brussel","description_web":"Passa Porta is het internationale literatuurhuis in Brussel. Het werd opgericht in 2004 door literaire organisaties Het beschrijf en Entrez Lire en heeft sindsdien een unieke plek ingenomen in het hart van Europa. Passa Porta is een meertalig huis, een werk- en ontmoetingsplek voor auteurs, lezers, vertalers en andere literatuurliefhebbers uit de hele wereld. \r\nNaast literaire ontmoetingen (intra en extra muros), leesclubs, en diverse creatieprojecten voor auteurs en vertalers, ontwikkelt Passa Porta ook een internationaal programma voor writers-in-residence.\r\nHet tweejaarlijkse Passa Porta Festival, h\u00e9t internationale literatuurfestival van Belgi\u00eb, is zeer gewaardeerd in heel Europa en trekt vele duizenden bezoekers. ","description_print":null,"booking_url":null,"sort_ord