formers":null,"boxoffice_url":null,"website":"https:\/\/beermyguest.be\/shop\/jeu-de-piste\/","email":"magali@beermyguest.be","phone_contact":"+32 476 78 56 25","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50001814"},"en":{"name":"Jeu de piste - d\u00e9gustations bi\u00e8re","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/beermyguest.be\/shop\/jeu-de-piste\/","email":"magali@beermyguest.be","phone_contact":"+32 476 78 56 25","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50001814"},"it":{"name":"Jeu de piste - d\u00e9gustations bi\u00e8re","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/beermyguest.be\/shop\/jeu-de-piste\/","email":"magali@beermyguest.be","phone_contact":"+32 476 78 56 25","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50001814"},"cn":{"name":"Jeu de piste - d\u00e9gustations bi\u00e8re","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/beermyguest.be\/shop\/jeu-de-piste\/","email":"magali@beermyguest.be","phone_contact":"+32 476 78 56 25","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50001814"},"fr":{"name":"Jeu de piste - d\u00e9gustations bi\u00e8re","shortdescr":"Un jeu de piste originale dans les petites rues de Bruxelles ; les participants auront des challenges et surtout les participants auront a\u0300 faire halte dans 4 bars sur leur parcours, ou\u0300 un galopin de bie\u0300re leur sera servi a\u0300 l\u2019aveugle. Pourquoi a\u0300 l\u2019aveugle ? Car pour marquer des points et gagner la gloire \u00e9ternelle, ils devront remplir les questionnaires de de\u0301gustation inclus au roadbook. ","longdescr":"Chacun de nos jeux de pistes propose une aventure originale de Bruxelles. En e\u0301quipes de 4-5 personnes, les participants partent a\u0300 l\u2019assaut des rues et ruelles munis de leur roadbook pour re\u0301soudre une petite enque\u0302te et des challenges. Mais surtout, ils auront a\u0300 faire halte dans 4 bars sur leur parcours, ou\u0300 un galopin de bie\u0300re leur sera servi a\u0300 l\u2019aveugle. Pourquoi a\u0300 l\u2019aveugle ? Car pour marquer des points et gagner la gloire \u00e9ternelle, ils devront remplir les questionnaires de de\u0301gustation inclus au roadbook. D'autres challenges comple\u0300tent l\u2019animation : e\u0301nigmes, de\u0301fi photo, quiz d'observation, etc... Un jeu complet qui se\u0301duira autant les amateurs de bie\u0300re que les enque\u0302teurs en herbe et les amoureux de culture et d'histoire. \n\nNotre animateur vous accueillera pour vous expliquer le fonctionnement du jeu de piste et il\/elle vous expliquera les techniques de d\u00e9gustation des bi\u00e8res. A la fin du jeu, vous recevrez toutes les r\u00e9ponses sur les bi\u00e8res d\u00e9gust\u00e9es, et on d\u00e9terminera quel groupe \u00e0 gagn\u00e9 la gloire \u00e9ternelle! \n\nEt pour ceux qui n'aiment pas la bi\u00e8re, pas de panique! Ils peuvent prendre un soft drink \u00e0 la place et le jeu reste tout aussi attrayant. C'est une activit\u00e9 id\u00e9ale pour appr\u00e9cier Bruxelles et d\u00e9couvrir la bi\u00e8re! ","performers":"4 bars typiquement bruxellois (on peut pas vous dire lesquels, ce serait tricher!)","boxoffice_url":null,"website":"https:\/\/beermyguest.be\/shop\/jeu-de-piste\/","email":"magali@beermyguest.be","phone_contact":"+32 476 78 56 25","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50001814"},"sp":{"name":"Jeu de piste - d\u00e9gustations bi\u00e8re","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/beermyguest.be\/shop\/jeu-de-piste\/","email":"magali@beermyguest.be","phone_contact":"+32 476 78 56 25","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50001814"},"nl":{"name":"Jeu de piste - d\u00e9gustations bi\u00e8re","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/beermyguest.be\/shop\/jeu-de-piste\/","email":"magali@beermyguest.be","phone_contact":"+32 476 78 56 25","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50001814"}},"place":{"id":247099,"translations":{"de":{"name":"Caf\u00e9 des Halles Saint-G\u00e9ry","address_street_name":"Place Saint-G\u00e9ry","address_street_number":null,"address_street_box":null,"email":"info@cafedeshalles.be","website":"http:\/\/www.cafedeshalles.be","phone_contact":"+32 2 503 33 25","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Saint-G\u00e9ry","address_line2":"1000 Bruxelles","description_web":"Das Caf\u00e9 Des Halles ist ein sch\u00f6nes Caf\u00e9 in dem ehemaligen pr\u00e4chtigen Marktgeb\u00e4ude an einer der belebtesten Pl\u00e4tze Br\u00fcssels. Das komplett renovierte Geb\u00e4ude bietet Raum f\u00fcr mehrere gem\u00fctliche Ecken, in denen Ledersessel zum Verweilen einladen. In den Kellergew\u00f6lben befindet sich ein Club, in dem regelm\u00e4\u00dfig Partys stattfinden.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Caf\u00e9 des Halles Saint-G\u00e9ry","address_street_name":"Place Saint-G\u00e9ry","address_street_number":null,"address_street_box":null,"email":"info@cafedeshalles.be","website":"http:\/\/www.cafedeshalles.be","phone_contact":"+32 2 503 33 25","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Saint-G\u00e9ry","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Caf\u00e9 Des Halles Saint-G\u00e9ry","address_street_name":"Place Saint-G\u00e9ry","address_street_number