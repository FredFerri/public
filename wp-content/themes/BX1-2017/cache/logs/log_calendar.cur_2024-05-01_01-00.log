box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be\/en","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue de Namur, 10","address_line2":"1000 Brussels","description_web":"Since 1983, Arkadia has been exploring the richness of Belgium's and Brussels' heritage and developing numerous cultural projects especially in Brussels, between architecture, urbanism, culture, plastic arts and ideology from the Middle Ages to the present day. Seeing and understanding the city and its architectural development, approaching artistic creation and giving it meaning, these are the activities that the ASBL wants to share with the public. Specialists in architectural heritage and contemporary art, they show the city through guided tours and lectures in several languages.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":"Depuis 1983, Arkadia explore les richesses du patrimoine belge et bruxellois et d\u00e9veloppe de nombreux projets culturels sp\u00e9cialement \u00e0 Bruxelles, entre architecture, urbanisme, culture, arts plastiques et id\u00e9ologie depuis le Moyen \u00c2ge jusqu\u2019\u00e0 nos jours. Voir et comprendre la ville et son d\u00e9veloppement architectural, approcher la cr\u00e9ation artistique et lui donner un sens, telles sont les activit\u00e9s que l'ASBL veut partager avec le public. Sp\u00e9cialistes du patrimoine  architectural et de l'art contemporain, ils font d\u00e9couvrir la ville \u00e0 travers des visites guid\u00e9es et des conf\u00e9rences en plusieurs langues.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Arkadia","address_street_name":"Naamsestraat","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be\/nl","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Naamsestraat, 10","address_line2":"1000 Brussel","description_web":"Sinds 1983 verkent Arkadia de rijkdom van het Belgische en Brusselse erfgoed en ontwikkelt talrijke culturele projecten, vooral in Brussel, tussen architectuur, stedenbouw, cultuur, plastische kunsten en ideologie, van de Middeleeuwen tot vandaag. De stad en haar architecturale ontwikkeling zien en begrijpen, de artistieke creatie benaderen en er een betekenis aan geven, dat zijn de activiteiten die de VZW met het publiek wil delen. Zij zijn gespecialiseerd in architectonisch erfgoed en hedendaagse kunst en laten de stad zien door middel van rondleidingen en lezingen in verschillende talen.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":36946,"location":{"lat":50.84145283,"lon":4.35976257},"is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/de8a65e970cee44e85911c5e3be5897449e6d4ad.jpg","width":900,"height":600,"ratio":1.5,"oEmbed_height":600,"oEmbed_width":900,"translations":{"de":{"title":"L'h\u00f4tel van Eetvelde et son bureau","copyright":"Laurent et Luc Viatour"},"pt":{"title":"L'h\u00f4tel van Eetvelde et son bureau","copyright":"Laurent et Luc Viatour"},"en":{"title":"L'h\u00f4tel van Eetvelde et son bureau","copyright":"Laurent et Luc Viatour"},"it":{"title":"L'h\u00f4tel van Eetvelde et son bureau","copyright":"Laurent et Luc Viatour"},"cn":{"title":"L'h\u00f4tel van Eetvelde et son bureau","copyright":"Laurent et Luc Viatour"},"fr":{"title":"L'h\u00f4tel van Eetvelde et son bureau","copyright":"Laurent et Luc Viatour"},"sp":{"title":"L'h\u00f4tel van Eetvelde et son bureau","copyright":"Laurent et Luc Viatour"},"nl":{"title":"L'h\u00f4tel van Eetvelde et son bureau","copyright":"Laurent et Luc Viatour"}}}],"dates":[{"day":"2024-03-31","doors":null,"start":"11:30:00","end":"13:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-04-07","doors":null,"start":"11:30:00","end":"13:00:00","end_night_life":