"2023-01-20","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2023-01-21","doors":null,"start":"11:00:00","end":"18:00:00"},{"day":"2023-01-22","doors":null,"start":"11:00:00","end":"18:00:00"},{"day":"2023-01-23","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2023-01-24","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2023-01-25","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2023-01-26","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2023-01-27","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2023-01-28","doors":null,"start":"11:00:00","end":"18:00:00"},{"day":"2023-01-29","doors":null,"start":"11:00:00","end":"18:00:00"},{"day":"2023-01-30","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2023-01-31","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2023-02-01","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2023-02-02","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2023-02-03","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2023-02-04","doors":null,"start":"11:00:00","end":"18:00:00"},{"day":"2023-02-05","doors":null,"start":"11:00:00","end":"18:00:00"},{"day":"2023-02-06","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2023-02-07","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2023-02-08","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2023-02-09","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2023-02-10","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2023-02-11","doors":null,"start":"11:00:00","end":"18:00:00"},{"day":"2023-02-12","doors":null,"start":"11:00:00","end":"18:00:00"}],"weekschema":[{"days":{"monday":{"is_open":true,"hours":[{"start":"10:00:00","end":"17:00:00"}]},"tuesday":{"is_open":true,"hours":[{"start":"10:00:00","end":"17:00:00"}]},"wednesday":{"is_open":true,"hours":[{"start":"10:00:00","end":"17:00:00"}]},"thursday":{"is_open":true,"hours":[{"start":"10:00:00","end":"17:00:00"}]},"friday":{"is_open":true,"hours":[{"start":"10:00:00","end":"17:00:00"}]},"saturday":{"is_open":true,"hours":[{"start":"11:00:00","end":"18:00:00"}]},"sunday":{"is_open":true,"hours":[{"start":"11:00:00","end":"18:00:00"}]}},"translations":{"fr":["lundi, mardi, mercredi, jeudi et vendredi: de 10:00 \u00e0 17:00","samedi et dimanche: de 11:00 \u00e0 18:00"],"nl":["maandag, dinsdag, woensdag, donderdag en vrijdag: van 10:00 tot 17:00","zaterdag en zondag: van 11:00 tot 18:00"],"en":["monday, tuesday, wednesday, thursday and friday: from 10:00 to 17:00","saturday and sunday: from 11:00 to 18:00"]},"date_start":"2022-10-14","date_end":"2023-02-12","is_also_by_appointment":false}],"prices":[{"translations":{"fr":{"name":"Pr\u00e9vente"},"nl":{"name":"Voorverkoop"},"en":{"name":"Presale"}},"value":15},{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":17},{"translations":{"fr":{"name":"Article 27"},"nl":{"name":"Artikel 27"},"en":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-10T16:05:44+02:00","published_at":"2022-08-31T12:05:09+02:00","backoffice_id":260714,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.25403295200937},{"id":541966,"date_start":"2022-09-30","date_end":"2023-02-12","date_next":"2022-10-14","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":true,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung"}},"others":{"list":[36,48],"translations":{"fr":["Mus\u00e9es et art centers","Architecture"],"nl":["Musea en kunstcentra","Architectuur"],"en":["Museums and art centers","Architecture "],"de":["Museen & Kunstzentren","Architektur"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Jules Buyssens, architecte paysagiste","shortdescr":"Jules Buyssens, architecte paysagiste","longdescr":"Apr\u00e8s une formation internationale qu\u2019il termine comme chef de bureau dans la c\u00e9l\u00e8bre agence d\u2019\u00c9douard Andr\u00e9 \u00e0 Paris, Jules Buyssens con\u00e7oit pr\u00e8s d'un millier de projets en Belgique et dans une dizaine de pays europ\u00e9ens (France, Russie, Suisse, Pays-Bas, Luxembourg, Monaco, Pologne, Lituanie).\r\n\r\nInspecteur des plantations de la Ville de Bruxelles pendant plus de 30 ans (1904- 1937), il fut aussi le responsable des am\u00e9nagements paysagers de l\u2019Exposition universelle de 1935 au Heysel. Avec la restauration des jardins de l\u2019abbaye de la Cambre \u00e0 Bruxelles, il est aussi l\u2019un des premiers en Belgique \u00e0 aborder la dimension patrimoniale de l\u2019architecture du paysage.\r\n\r\nEnfin, Buyssens est la cheville ouvri\u00e8re de l\u2019association et de la revue Le Nouveau Jardin Pittoresque (1913-1940) qui d\u00e9fendent de mani\u00e8re syst\u00e9matique et structur\u00e9e une inspiration reposant directement sur les exemples de la nature sauvage. Il d\u00e9veloppe cette r\u00e9flexion \u2018pr\u00e9-\u00e9cologique\u2019 \u00e0 travers des relations \u00e9troites avec le monde des botanistes de l\u2019Universit\u00e9 de Bruxelles, notamment Jean Massart.\r\n\r\nCette personnalit\u00e9 centrale de la premi\u00e8re moiti\u00e9 du XXe si\u00e8cle n\u2019a pas fait l\u2019objet d\u2019une pr\u00e9sentation globale depuis pr\u00e8s de 40 ans. L\u2019exposition est l\u2019occasion de combler cette lacune dans l\u2019histoire des jardins belge et internationale, de montrer des documents d\u2019une qualit\u00e9 graphique exceptionnelle en grande partie in\u00e9dits (photos anciennes, plans, archives \u00e9crites, objets), mais aussi de r\u00e9pondre aux questions contemporaines li\u00e9es \u00e0 l\u2019architecture du paysage.","performers":"Ursula Wieser Benedetti & Eric Hennaut","boxoffice_url":null,"website":"https:\/\/civa.brussels\/fr\/expos-events\/expo-picturesque-jules-buyssens-architecte-paysagiste","email":"info@civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.541966"},"nl":{"name":"Jules Buyssens, landschaps-architect","shortdescr":"Jules Buyssens, landschapsarchitect","longdescr":"Na een internationale opleiding, die hij afrondde als kantoordirecteur in het befaamde bureau van \u00c9douard Andr\u00e9 in Parijs, ontwierp Jules Buyssens een duizendtal projecten in Belgi\u00eb en in een tiental Europese landen (Frankrijk, Rusland, Zwitserland, Nederland, Luxemburg, Monaco, Polen, Litouwen).\r\n\r\nGedurende meer dan 30 jaar (1904-1937) was hij Inspecteur van de Dienst Plantsoenen van de Stad Brussel (1904-1937). Hij was onder meer verantwoordelijk voor de aanleg van de Heizel voor de Wereldtentoonstelling van 1935. Met de restauratie van de tuinen van de Abdij Ter Kameren in Brussel was hij ook een van de eersten in Belgi\u00eb die zich bezighield met de erfgoedstatuut van landschapsarchitectuur.\r\n\r\nTenslotte was Buyssens de drijvende kracht achter de beweging en het tijdschrift \u201cLe Nouveau Jardin Pittoresque\u201d (1913-1940), dat systematisch en op gestructureerde wijze de inspiratie vormde voor vrije natuurlandschappen. Hij ontwikkelde dit \"pre-ecologisch\" denken via nauwe banden met de plantkundigen van de Universiteit van Brussel, waaronder ook Jean Massart.\r\n\r\nDeze tentoonstelling is de perfecte gelegenheid om de te weinig besproken, uiterst belangrijke figuur Jules Buyssens in de schijnwerpers te plaatsen en aan de hand daarvan hedendaagse vragen omtrent landschapsarchitectuur te beantwoorden. Dit alles aan de hand van documenten van uitzonderlijke grafische kwaliteit, waarvan er vele nooit eerder vertoond werden (oude foto's, plannen, tekstmateriaal, voorwerpen).","performers":"Ursula Wieser Benedetti & Eric Hennaut","boxoffice_url":null,"website":"https:\/\/civa.brussels\/nl\/expo-events\/expo-picturesque-jules-buyssens-landschaps-architect","email":"info@civa.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.541966"},"en":{"name":"Jules Buyssens, landscape architect","shortdescr":"Jules Buyssens, Landscape Architect","longdescr":"After an international education, which he completed as head of the office of the famous practice of \u00c9douard Andr\u00e9 in Paris, Jules Buyssens designed nearly a thousand projects in Belgium and in a dozen European countries (France, Russia, Switzerland, the Netherlands, Luxembourg, Monaco, Poland and Lithuania).\r\n\r\nHead of the Plantation Service of the City of Brussels for more than 30 years (1904-1937), he was responsible for the landscape design of the 1935 World Expo at Heysel. With the restoration of the gardens of the La Cambre Abbey in Brussels, he was also one of the first in Belgium to tackle the heritage dimension of landscape architecture.\r\n\r\nIn addition, Buyssens was the driving force behind the association and magazine Le Nouveau Jardin Pittoresque (1913-1940), which systematically and in a structured manner promoted an inspiration based directly on examples from wild nature. He developed this 'pre-ecological' thinking through close relations with leading botanists at the University of Brussels, including Jean Massart.\r\n\r\nThe central and important figure in landscape architecture Jules Buyssens, has not been the subject of a comprehensive presentation for almost 40 years. This exhibition is an opportunity to fill this gap in Belgian and international garden history, to show documents of exceptional graphic quality, many of which have never been shown before (old photos, plans, written archives, objects), and to answer contemporary questions of landscape architecture.","performers":"Ursula Wieser Benedetti & Eric Hennaut","boxoffice_url":null,"website":"https:\/\/civa.brussels\/en\/exhibitions-events\/expo-picturesque-jules-buyssens-landscape-architect","email":"info@civa.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.541966"},"de":{"name":"EXPO : PICTURESQUE \u2014 Jules Buyssens, architecte paysagiste","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.541966"},"it":{"name":"EXPO : PICTURESQUE \u2014 Jules Buyssens, architecte paysagiste","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.541966"},"sp":{"name":"EXPO : PICTURESQUE \u2014 Jules Buyssens, architecte paysagiste","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.541966"},"pt":{"name":"EXPO : PICTURESQUE \u2014 Jules Buyssens, architecte paysagiste","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.541966"},"cn":{"name":"EXPO : PICTURESQUE \u2014 Jules Buyssens, architecte paysagiste","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.541966"}},"place":{"id":235577,"translations":{"fr":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"CIVA est un muse\u0301e, un centre d'archives, une bibliothe\u0300que et un lieu de rencontre pour les amateurs d'architecture, d'architecture paysage\u0300re, d'e\u0301cosyste\u0300mes urbains et d'histoire a\u0300 Bruxelles. Tout au long de l'anne\u0301e, vous pouvez vous y rendre pour des expositions temporaires, des confe\u0301rences, des de\u0301bats, des visites guide\u0301es, des lancements de livres et des activite\u0301s pour les enfants. Les activite\u0301s se trouvent a\u0300 Ixelles, pre\u0300s de la Place Flagey et au centre de Bruxelles, a\u0300 KANAL - Centre Pompidou.\r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"CIVA","address_street_name":"Kluisstraat","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"Kluisstraat","address_line2":"1050 Elsene","description_web":"CIVA is een museum, een archiefcentrum, een bibliotheek en een ontmoetingsplek voor liefhebbers van architectuur, landschapsarchitectuur, stadsecosystemen en geschiedenis in Brussel. Het hele jaar door kan je er terecht voor tijdelijke tentoonstellingen, lezingen, debatten, rondleidingen, book launches en kinderactiviteiten. De activiteiten vind je in Elsene, vlakbij het Flageyplein en in Brussel-centrum, in KANAL \u2013 Centre Pompidou.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"CIVA is a museum, an archive center, a library and a meeting place for lovers of architecture, landscape architecture, urban ecosystems and history in Brussels. Throughout the year, CIVA organizes temporary exhibitions, lectures, debates, guided tours, book launches and activities for children. The activities are organized in Ixelles, near Place Flagey and in the center of Brussels, in KANAL - Centre Pompidou.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"Das Architekturzentrum CIVA, das 2016 auf Betreiben der Region Br\u00fcssel-Hauptstadt ins Leben gerufen wurde, vereint in einer einzigen Struktur Ressourcen, Wissen und Know-how verschiedener Br\u00fcsseler Vereine aus dem Bereich Kultur, Architektur, St\u00e4dteplanung, Landschaftsarchitektur und Forschungen zum \u00d6kosystem: die Archive f\u00fcr moderne Architektur, die Bibliothek Ren\u00e9 Pech\u00e8re, der Architekturfonds und das Centre Paul Duvigneaud.\r\nMit ihrem kulturellen Projekt tr\u00e4gt die Fondation CIA zur Entwicklung einer architektonischen, landschaftsarchitektonischen und st\u00e4dteplanerischen Kultur bei, die sich mit den Herausforderungen der Gegenwart auseinandersetzt. Schwerpunkt ist Br\u00fcssel. \r\n\r\nDie Fondation CIVA bietet eine ganze Reihe von Aktivit\u00e4ten und Angeboten: Ausstellungen, Konferenzen, Orte des Austauschs und der Debatten, p\u00e4dagogische Aktivit\u00e4ten, Archiveinblicke und Bibliotheken mit knapp 40.000 Werken und Zeitschriften zu den Themen Architektur, St\u00e4dteplanung, Stadtgeschichte, Landschaften, G\u00e4rten und urbane \u00d6kosysteme.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"Creado en 2016 por iniciativa de la Regi\u00f3n Bruselas-Capital, el CIVA re\u00fane una \u00fanica estructura de recursos, conocimiento y aprendizaje de varias asociaciones culturales activas en Bruselas en los campos de la arquitectura, urbanismo, paisajes y el estudio de ecosistemas: los Archivos de Arquitectura Moderna, la Biblioteca Ren\u00e9 Pech\u00e8re, los Fondos para la arquitectura, el Centro Paul Duvigneaud y el CIVA asbl, ahora disuelto.\r\nA trav\u00e9s de este proyecto cultural, la Fundaci\u00f3n CIVA contribuye al desarrollo del paisaje arquitect\u00f3nico y la cultura urbana como base para afrontar desaf\u00edos contempor\u00e1neos, poniendo especial \u00e9nfasis en Bruselas.\r\nSiempre tiene \u00e9xito a la hora de cumplir sus objetivos y tratar con un p\u00fablico amplio (adultos y ni\u00f1os, estudiantes, investigadores, arquitectos, paisajistas, amantes de la naturaleza, pol\u00edticos, etc), la fundaci\u00f3n CIVA organiza numerosos eventos y actividades en diferentes lugares, incluyendo exhibiciones permanentes y temporales, conferencias, debates y actividades educativas. Tambi\u00e9n dispone archivos excepcionales abiertos para todos los p\u00fablicos (documentos de arquitectos y paisajistas: planos, bocetos, modelos, muebles, etc.) y librer\u00edas que contienen casi 40.000 obras y peri\u00f3dicos de arquitectura, urbanismo, la historia de los pueblos y ciudades, paisajes, jardines y ecolog\u00eda urbana.\r\nEstas actividades y materiales est\u00e1n dise\u00f1ados para despertar la curiosidad y el inter\u00e9s de todo nuestro entorno, ya sea un hecho hist\u00f3rico o una construcci\u00f3n.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[5],"translations":{"fr":["Flagey"],"nl":["Flagey"],"en":["Flagey"]}},"zones":{"list":[21],"translations":{"fr":["Sud"],"nl":["Zuid"],"en":["South"]}},"neca":null,"facebook_id":null,"backoffice_id":1436,"location":{"lat":50.82873218,"lon":4.36569034},"region":"brussels","last_updated_at":"2022-10-14T01:08:36+02:00","published_at":"2013-10-19T01:14:20+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":235577,"translations":{"fr":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"CIVA est un muse\u0301e, un centre d'archives, une bibliothe\u0300que et un lieu de rencontre pour les amateurs d'architecture, d'architecture paysage\u0300re, d'e\u0301cosyste\u0300mes urbains et d'histoire a\u0300 Bruxelles. Tout au long de l'anne\u0301e, vous pouvez vous y rendre pour des expositions temporaires, des confe\u0301rences, des de\u0301bats, des visites guide\u0301es, des lancements de livres et des activite\u0301s pour les enfants. Les activite\u0301s se trouvent a\u0300 Ixelles, pre\u0300s de la Place Flagey et au centre de Bruxelles, a\u0300 KANAL - Centre Pompidou.\r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"CIVA","address_street_name":"Kluisstraat","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"Kluisstraat","address_line2":"1050 Elsene","description_web":"CIVA is een museum, een archiefcentrum, een bibliotheek en een ontmoetingsplek voor liefhebbers van architectuur, landschapsarchitectuur, stadsecosystemen en geschiedenis in Brussel. Het hele jaar door kan je er terecht voor tijdelijke tentoonstellingen, lezingen, debatten, rondleidingen, book launches en kinderactiviteiten. De activiteiten vind je in Elsene, vlakbij het Flageyplein en in Brussel-centrum, in KANAL \u2013 Centre Pompidou.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"CIVA is a museum, an archive center, a library and a meeting place for lovers of architecture, landscape architecture, urban ecosystems and history in Brussels. Throughout the year, CIVA organizes temporary exhibitions, lectures, debates, guided tours, book launches and activities for children. The activities are organized in Ixelles, near Place Flagey and in the center of Brussels, in KANAL - Centre Pompidou.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"Das Architekturzentrum CIVA, das 2016 auf Betreiben der Region Br\u00fcssel-Hauptstadt ins Leben gerufen wurde, vereint in einer einzigen Struktur Ressourcen, Wissen und Know-how verschiedener Br\u00fcsseler Vereine aus dem Bereich Kultur, Architektur, St\u00e4dteplanung, Landschaftsarchitektur und Forschungen zum \u00d6kosystem: die Archive f\u00fcr moderne Architektur, die Bibliothek Ren\u00e9 Pech\u00e8re, der Archite