ays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen","it":"Visite guidate","sp":"Visitas guiadas","pt":null,"cn":null}},"others":{"list":[253],"translations":{"fr":["Visites guid\u00e9es d\u2019int\u00e9rieurs"],"nl":["Interieur rondleidingen"],"en":["Interior guided tours"],"de":["F\u00fchrungen durch Innenr\u00e4ume"],"it":["Visite guidate all\u2019interno"],"sp":["Visitas guiadas en espacios interiores"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Les coulisses du Civa","shortdescr":null,"longdescr":"Rassembl\u00e9s depuis la fin des ann\u00e9es soixante, les centaines de milliers de plans, dessins, documents, dossiers \u00e9crits ainsi que les pi\u00e8ces de mobilier, photographies et maquettes que conserve le CIVA offrent, au-del\u00e0 de leur qualit\u00e9 esth\u00e9tique, un panorama unique de la cr\u00e9ation architecturale et paysag\u00e8re belge des XIXe et XXe \r\nsi\u00e8cles (Victor Horta, Ernest Bl\u00e9rot, Victor Bourgeois, Robert Schuiten, Louis Herman De Koninck, Renaat Braem, Paul Duvigneaud, Ren\u00e9 Pech\u00e8re, \u2026).\r\n\r\nINSCRIPTION OBLIGATOIRE\u00a0:\r\n- Par courrier postal (rue des Moineaux, 17-19 \u2013 1000 Bruxelles)\r\n  A notre accueil (Rue du Midi 118 \u2013 1000 Bruxelles, ouvert du lundi au vendredi de 8h30 \u00e0 15h)\r\n- Par e-mail (sacademie.asbl@solidaris.be)\r\n\r\nY mentionner :\r\nnom, pr\u00e9nom, adresse, date de naissance, n\u00b0 de gsm,\r\nl'activit\u00e9 choisie, n\u00b0 de membre S\u2019Acad\u00e9mie (ou n\u00b0 de mutuelle) ou demande d'affiliation.\r\n\r\nIl n'y a pas d'inscription par t\u00e9l\u00e9phone, mais l'asbl est joignable au 02 546 14 94 pour toute information.\r\nUne confirmation d'inscription vous parviendra par voie postale avec les modalit\u00e9s de paiement.\r\nUn courrier avec les informations pratiques vous sera envoy\u00e9 quelques jours avant l'activit\u00e9.\r\n\r\nLes activit\u00e9s sont r\u00e9serv\u00e9es aux membres de S'Acad\u00e9mie asbl:\r\n- Membres de Solidaris Brabant  : AFFILIATION gratuite\r\n- Non-Solidaris  : 50 \u20ac par ann\u00e9e acad\u00e9mique\r\n- AFFILIATION possible sur simple demande pour les personnes de plus de 50 ans, pensionn\u00e9es ou non. \r\n\r\nLes conditions g\u00e9n\u00e9rales sous lesquelles sont organis\u00e9es les activit\u00e9s sont disponibles sur le site www.fmsb.be\/fr\/sacademie. Vous inscrire implique que vous en ayez pris connaissance.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.fmsb.be\/fr\/sacademie","email":"sacademie.asbl@solidaris.be","phone_contact":"+32 2 546 14 94","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.549373"},"nl":{"name":"Les coulisses du Civa","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.fmsb.be\/fr\/sacademie","email":"sacademie.asbl@solidaris.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.549373"},"en":{"name":"Les coulisses du Civa","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.fmsb.be\/fr\/sacademie","email":"sacademie.asbl@solidaris.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.549373"},"de":{"name":"Les coulisses du Civa","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.fmsb.be\/fr\/sacademie","email":"sacademie.asbl@solidaris.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.549373"},"it":{"name":"Les coulisses du Civa","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.fmsb.be\/fr\/sacademie","email":"sacademie.asbl@solidaris.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.549373"},"sp":{"name":"Les coulisses du Civa","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.fmsb.be\/fr\/sacademie","email":"sacademie.asbl@solidaris.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.549373"},"pt":{"name":"Les coulisses du Civa","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.fmsb.be\/fr\/sacademie","email":"sacademie.asbl@solidaris.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.549373"},"cn":{"name":"Les coulisses du Civa","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.fmsb.be\/fr\/sacademie","email":"sacademie.asbl@solidaris.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.549373"}},"place":{"id":235577,"translations":{"fr":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"CIVA est un muse\u0301e, un centre d'archives, une bibliothe\u0300que et un lieu de rencontre pour les amateurs d'architecture, d'architecture paysage\u0300re, d'e\u0301cosyste\u0300mes urbains et d'histoire a\u0300 Bruxelles. Tout au long de l'anne\u0301e, vous pouvez vous y rendre pour des expositions temporaires, des confe\u0301rences, des de\u0301bats, des visites guide\u0301es, des lancements de livres et des activite\u0301s pour les enfants. Les activite\u0301s se trouvent a\u0300 Ixelles, pre\u0300s de la Place Flagey et au centre de Bruxelles, a\u0300 KANAL - Centre Pompidou.\r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"CIVA","address_street_name":"Kluisstraat","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"Kluisstraat","address_line2":"1050 Elsene","description_web":"CIVA is een museum, een archiefcentrum, een bibliotheek en een ontmoetingsplek voor liefhebbers van architectuur, landschapsarchitectuur, stadsecosystemen en geschiedenis in Brussel. Het hele jaar door kan je er terecht voor tijdelijke tentoonstellingen, lezingen, debatten, rondleidingen, book launches en kinderactiviteiten. De activiteiten vind je in Elsene, vlakbij het Flageyplein en in Brussel-centrum, in KANAL \u2013 Centre Pompidou.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"CIVA is a museum, an archive center, a library and a meeting place for lovers of architecture, landscape architecture, urban ecosystems and history in Brussels. Throughout the year, CIVA organizes temporary exhibitions, lectures, debates, guided tours, book launches and activities for children. The activities are organized in Ixelles, near Place Flagey and in the center of Brussels, in KANAL - Centre Pompidou.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"Das Architekturzentrum CIVA, das 2016 auf Betreiben der Region Br\u00fcssel-Hauptstadt ins Leben gerufen wurde, vereint in einer einzigen Struktur Ressourcen, Wissen und Know-how verschiedener Br\u00fcsseler Vereine aus dem Bereich Kultur, Architektur, St\u00e4dteplanung, Landschaftsarchitektur und Forschungen zum \u00d6kosystem: die Archive f\u00fcr moderne Architektur, die Bibliothek Ren\u00e9 Pech\u00e8re, der Architekturfonds und das Centre Paul Duvigneaud.\r\nMit ihrem kulturellen Projekt tr\u00e4gt die Fondation CIA zur Entwicklung einer architektonischen, landschaftsarchitektonischen und st\u00e4dteplanerischen Kultur bei, die sich mit den Herausforderungen der Gegenwart auseinandersetzt. Schwerpunkt ist Br\u00fcssel. \r\n\r\nDie Fondation CIVA bietet eine ganze Reihe von Aktivit\u00e4ten und Angeboten: Ausstellungen, Konferenzen, Orte des Austauschs und der Debatten, p\u00e4dagogische Aktivit\u00e4ten, Archiveinblicke und Bibliotheken mit knapp 40.000 Werken und Zeitschriften zu den Themen Architektur, St\u00e4dteplanung, Stadtgeschichte, Landschaften, G\u00e4rten und urbane \u00d6kosysteme.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"Creado en 2016 por iniciativa de la Regi\u00f3n Bruselas-Capital, el CIVA re\u00fane una \u00fanica estructura de recursos, conocimiento y aprendizaje de varias asociaciones culturales activas en Bruselas en los campos de la arquitectura, urbanismo, paisajes y el estudio de ecosistemas: los Archivos de Arquitectura Moderna, la Biblioteca Ren\u00e9 Pech\u00e8re, los Fondos para la arquitectura, el Centro Paul Duvigneaud y el CIVA asbl, ahora disuelto.\r\nA trav\u00e9s de este proyecto cultural, la Fundaci\u00f3n CIVA contribuye al desarrollo del paisaje arquitect\u00f3nico y la cultura urbana como base para afrontar desaf\u00edos contempor\u00e1neos, poniendo especial \u00e9nfasis en Bruselas.\r\nSiempre tiene \u00e9xito a la hora de cumplir sus objetivos y tratar con un p\u00fablico amplio (adultos y ni\u00f1os, estudiantes, investigadores, arquitectos, paisajistas, amantes de la naturaleza, pol\u00edticos, etc), la fundaci\u00f3n CIVA organiza numerosos eventos y actividades en diferentes lugares, incluyendo exhibiciones permanentes y temporales, conferencias, debates y actividades educativas. Tambi\u00e9n dispone archivos excepcionales abiertos para todos los p\u00fablicos (documentos de arquitectos y paisajistas: planos, bocetos, modelos, muebles, etc.) y librer\u00edas que contienen casi 40.000 obras y peri\u00f3dicos de arquitectura, urbanismo, la historia de los pueblos y ciudades, paisajes, jardines y ecolog\u00eda urbana.\r\nEstas actividades y materiales est\u00e1n dise\u00f1ados para despertar la curiosidad y el inter\u00e9s de todo nuestro entorno, ya sea un hecho hist\u00f3rico o una construcci\u00f3n.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[5],"translations":{"fr":["Flagey"],"nl":["Flagey"],"en":["Flagey"],"de":["Flagey"],"it":["Flagey"],"sp":["Flagey"],"pt":[null],"cn":[null]}},"zones":{"list":[21],"translations":{"fr":["Sud"],"nl":["Zuid"],"en":["South"],"de":["S\u00fcden"],"it":["Sud"],"sp":["Sur"],"pt":[null],"cn":[null]}},"neca":null,"facebook_id":null,"backoffice_id":1436,"location":{"lat":50.82873218,"lon":4.36569034},"region":"brussels","last_updated_at":"2023-02-11T10:05:31+01:00","published_at":"2013-10-19T01:14:20+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":279778,"translations":{"fr":{"name":"ASBL Seniors Acad\u00e9mie","address_street_name":"Rue des Moineaux","address_street_number":"17-19","address_street_box":null,"email":"sacademie.asbl@solidaris.be","webs