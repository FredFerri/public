nl":["Art nouveau, art deco"]}}},"translations":{"de":{"name":"Bruxelles : Belle \u00c9poque et Art Nouveau","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/bruxelles-belle-epoque-art-nouveau\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.552677"},"pt":{"name":"Bruxelles : Belle \u00c9poque et Art Nouveau","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/bruxelles-belle-epoque-art-nouveau\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.552677"},"en":{"name":"Bruxelles : Belle \u00c9poque et Art Nouveau","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/bruxelles-belle-epoque-art-nouveau\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.552677"},"it":{"name":"Bruxelles : Belle \u00c9poque et Art Nouveau","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/bruxelles-belle-epoque-art-nouveau\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.552677"},"cn":{"name":"Bruxelles : Belle \u00c9poque et Art Nouveau","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/bruxelles-belle-epoque-art-nouveau\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.552677"},"fr":{"name":"Bruxelles : Belle \u00c9poque et Art Nouveau","shortdescr":"Au tournant du 19\u00e8me et du 20\u00e8me si\u00e8cle, Bruxelles conna\u00eet bien des bouleversement ! La r\u00e9volution industrielle, le d\u00e9veloppement urbain vont m\u00e9tamorphos\u00e9 la vie des bruxellois !\n\nLa vie \u00e9conomique est florissante, les arts se d\u00e9veloppent, on a un int\u00e9r\u00eat grandissant pour les activit\u00e9s culturelles. Un courant artistique voit le jour \u00e0 Bruxelles : l\u2019Art Nouveau","longdescr":"QU\u2019ALLEZ-VOUS D\u00c9COUVRIR ?\nNous vous emmenons plus de 120 ans en arri\u00e8re, dans un quartier qui a \u00e9t\u00e9 le t\u00e9moins privil\u00e9gi\u00e9 de la Belle \u00c9poque \u00e0 bien des \u00e9gards\u2026\n\nAvec une attention toute particuli\u00e8re au mouvement Art Nouveau, on retrace avec vous les grandes \u00e9tapes de cette transformation urbaine afin de mieux comprendre cette \u00e9poque, mais aussi les enjeux urbains plus actuels dans un quartier qui n\u2019a pas arr\u00eat\u00e9 sa mue \u00e0 la Belle \u00c9poque, loin s\u2019en faut !\n\nAu cours de cette promenade, vous d\u00e9couvrirez :\n\u2013 la Maison personnelle de Paul Cauchie\n\u2013 Le palais et le parc du Cinquantenaire\n\u2013 Les b\u00e2tisseurs de Villes par Van der Stappen\n\u2013 Le monument \u00ab \u00e0 la m\u00e9moire des Belges morts pour l\u2019\u0153uvre coloniale\u201d, par Thomas Vin\u00e7otte\n\u2013 le Pavillon des Passions Humaines (V Horta)\n\u2013 la maison de l\u2019architecte Edouard Ramakers\n\u2013 une composition sculpturale de Jacques de Lalaing qui pr\u00e9sente des All\u00e9gories des trois \u00e2ges de l\u2019humanit\u00e9.\n\u2013 La fameuse Maison Saint-Cyr par Gustave Streuven. \n\n\nINFORMATIONS PRATIQUES\nTours r\u00e9guliers en fran\u00e7ais :\nPrix  : Libre et conscient* (3\u20ac \u00e0 l\u2019inscription, puis le montant qui vous semble juste \u00e0 la fin de la visite)\nDur\u00e9e : Environ 2 heures\nGroupe maximum : +\/- 25 personnes\nRendez-vous : Merode\nSur l\u2019esplanade devant l\u2019entr\u00e9e du Parc, \u00e0 c\u00f4t\u00e9 du Rond Point\n1040 Bruxelles\nTour priv\u00e9 sur demande en fran\u00e7ais, russe ou anglais\n","performers":"Une visite guid\u00e9e originale de Brussels By Foot","boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/bruxelles-belle-epoque-art-nouveau\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.552677"},"sp":{"name":"Bruxelles : Belle \u00c9poque et Art Nouveau","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/bruxelles-belle-epoque-art-nouveau\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.552677"},"nl":{"name":"Bruxelles : Belle \u00c9poque et Art Nouveau","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/bruxelles-belle-epoque-art-nouveau\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.552677"}},"place":{"id":235980,"translations":{"de":{"name":"Parc du Cinquentenaire in Br\u00fcssel","address_street_name":"Parc du Cinquantenaire","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.brussels-gardens.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire","address_line2":"1000 Bruxelles","description_web":"Der 1880 anl\u00e4sslich des 50. Jahrestags der Unabh\u00e4ngigkeit Belgiens angelegte Parc du Cinquantenaire ist eine Gartenanlage im \u201efranz\u00f6sischen Stil\u201c mit historischer Bedeutung. Hier kann man neben Gartenkunst auch Denkm\u00e4ler, Skulpturen und Museen bewundern. \u00dcberragt wird der Park von einem Triumphbogen mit drei Arkaden, auf denen eine bronzene Quadriga prangt. Von hier aus k\u00f6nnen Besucher einen atemberaubenden Blick auf die belgische Hauptstadt genie\u00dfen. Die breiten Alleen f\u00fchren unter anderem zum Pavillon der menschlichen Leidenschaften aus der Feder des ber\u00fchmten Jugendstilarchitekten Victor Horta, zum K\u00f6niglichen Armee- und Milit\u00e4rmuseum, zum Museum f\u00fcr Kunst & Geschichte und zum Automuseum Autoworld.\r\n\r\nGanzj\u00e4hrig finden hier zudem Veranstaltungen aller Art statt: Sportveranstaltungen, Feste, Konzerte, Feuerwerk... Im Sommer l\u00e4dt Sie das Park-Caf\u00e9 \u201eGuinguette Maurice\u201c zu einer sonnigen Pause ein.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Parque do Cinquenten\u00e1rio","address_street_name":"Parc du Cinquantenaire","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.brussels-gardens.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire","address_line2":"1000 Bruxelles","description_web":"O local \u00e9 um vasto conjunto de jardins, pontuado por monumentos e museus. \u00c9 dominado por um arco do triunfo de tr\u00eas arcadas: o Cinquenten\u00e1rio. O parque acolhe numerosas atividades ao longo de todo o ano: manifesta\u00e7\u00f5es, festas, fogos de artif\u00edcio, eventos desportivos, concertos\u2026 O local foi constru\u00eddo em 1880 para o 50.\u00ba anivers\u00e1rio da independ\u00eancia da B\u00e9lgica. As grandes vias levam ao Pavilh\u00e3o das Paix\u00f5es Humanas, desenhado por Victor Horta, ao Museu Real das For\u00e7as Armadas e da Hist\u00f3ria Militar, aos Museus Reais de Arte e Hist\u00f3ria e \u00e0 Autoworld. No \u00e1pice dos tr\u00eas arcos triunfais, uma quadriga de bronze e um panorama com vista deslumbrante de Bruxelas inteira. Equipamentos: -Bancos -Mesas de piquenique -Chafarizes -Parque infantil 3-7 anos -Parque infantil 7-12 anos -Campo polidesportivo -Espregui\u00e7adeiras (no ver\u00e3o) Acessibilidade: a entrada do lado Schuman foi toda especialmente adaptada neste sentido. O revestimento das vias \u00e9 conveniente para os carrinhos. Aqui e ali, s\u00e3o atravessadas por canais pouco profundos. Ladrilhado redondo na esplanada.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Cinquantenaire Park","address_street_name":"Parc du Cinquantenaire","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.brussels-gardens.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Parc du Cinquantenaire","address_line2":"1000 Brussels","description_web":"Built in 1880 to mark the 50th anniversary of Belgium's independence, Cinquantenaire Park is both a collection of French-style gardens and a historical site that's home to monuments, sculptures and museums. It's dominated by a triumphal arch with three arches and a bronze quadriga at its summit, which offers a stunning panoramic view of the capital. The wide paths lead to the Pavilion of Human Passions designed by Victor Horta, the Royal Museum of the Armed Forces and Military History, the Art & History Museum and Autoworld, the car museum.\r\n\r\nTake part in events here throughout the year: sporting events, festivals, concerts, fireworks... In the summer, you can enjoy a short break at the Guinguette Maurice pop-up bar.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Parco del Cinquantenario, natura e cultura nel centro di Bruxelles","address_street_name":"Parc du Cinquantenaire","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.brussels-gardens.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire","address_line2":"1000 Bruxelles","description_web":"Il Parc du Cinquantenaire, polmone verde di Bruxelles, \u00e8 un'oasi di pace nel mezzo del Quartiere Europeo.\u00a0\r\n\r\nRifugio tranquillo in mezzo alla tempesta delle automobili, il parco cela dei veri e propri tesori : la Grande Moschea, la statua del cane verde o il Pavillon des passions humaines di Victor Horta.\u00a0\r\nUbicato tra la rotonda Schuman, le avenues des Nerviens, de la Renaissance e de Tervueren, il Parco del Cinquantenario copre una trentina di ettari di giardino classico, con vialetti tracciati da funi, siepi di allori potati e un tracciato simmetrico. Il Museo del Cinquantenario, i Musei d'Arte e di Storia Militare e Autoworld sono ospitati all'interno della grande costruzione del Cinquantenario.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Parc du Cinquantenaire","address_street_name":"Parc du Cinquantenaire","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.brussels-gardens.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Parc du Cinquantenaire","address_street_name":"Parc du Cinquantenaire","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.brussels-gardens.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire","address_line2":"1000 Bruxelles","description_web":"Construit en 1880 pour le 50e anniversaire de l\u2019ind\u00e9pendance de la Belgique, le parc du Cinquantenaire est \u00e0 la fois un ensemble de jardins \u00ab\u00a0\u00e0 la fran\u00e7aise\u00a0\u00bb et un site historique o\u00f9 d\u00e9couvrir monuments, sculptures et mus\u00e9es. Il est domin\u00e9 par un arc de triomphe \u00e0 trois arcades avec, au sommet, un quadrige de bronze et un panorama avec une vue imprenable sur la capitale. Les grandes all\u00e9es vous conduisent au Pavillon des Passions humaines dessin\u00e9 par Victor Horta, au Mus\u00e9e Royal de l'Arm\u00e9e et d'Histoire Militaire, au Mus\u00e9e Art & Histoire et \u00e0 Autoworld, le mus\u00e9e de l\u2019automobile.\r\n\r\nParticipez \u00e0 des manifestations tout au long de l\u2019ann\u00e9e\u00a0: \u00e9v\u00e8nements sportifs, f\u00eates, concerts, feux d\u2019artifice\u2026 En \u00e9t\u00e9, la guinguette Maurice vous accueille pour une petite pause.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Parque del Cincuentenario","address_street_name":"Parc du Cinquantenaire","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.brussels-gardens.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire","address_line2":"1000 Bruxelles","description_web":"El Cincuentenario est\u00e1 compuesto por un amplio conjunto de jardines llenos de monumentos y museos. Destaca por su por su arco de triunfo compuesto por tres arcos. El parque acoge numerosas actividades a lo largo del a\u00f1o: eventos, celebraciones, espect\u00e1culos de fuegos artificiales, eventos deportivos, conciertos, etc.. \r\nEste lugar de inter\u00e9s fue construido en 1880 por el 50\u00ba aniversario de la independencia de B\u00e9lgica. Sus amplios caminos llevan hacia el Templo de las pasiones humanas, dise\u00f1ado por Victor Horta, el Real Museo de las Fuerzas armadas y de Historia Militar, el Museo Real de Arte e Historia y el Autoworld. En la parte superior de los tres arcos de triunfo hay una cuadriga y una vista impresionante de Bruselas.\r\n\r\nInstalaciones: \r\n- Bancos\r\n- Mesas de p\u00edcnic\r\n- Fuentes \r\n- Parques para ni\u00f1os de 3 a 7 a\u00f1os\r\n- Parques para ni\u00f1os de 7 a 12 a\u00f1os\r\n- Una pista deportiva polivalente\r\n- Tumbonas (en verano)\r\n\r\nAccesibilidad: \r\nLa entrada por Schuman ha sido especialmente dise\u00f1ada teniendo esto en mente. El camino est\u00e1 adecuado para sillas de ruedas. Aqu\u00ed y all\u00e1 encontrar\u00e1s peque\u00f1os caminos rodeando la explanada.\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Jubelpark","address_street_name":"Jubelpark","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.brussels-gardens.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Jubelpark","address_line2":"1000 Brussel","description_web":"Het Jubelpark werd in 1880 aangelegd ter gelegenheid van de 50e verjaardag van de Belgische onafhankelijkheid. Het park bestaat uit een aantal tuinen in Franse stijl. Maar het is vooral een historische site met veel monumenten, beeldhouwwerken en musea. Centraal staat de gigantische triomfboog. Die telt drie bogen, een bronzen vierspan helemaal bovenaan en een panoramisch uitzicht over de hoofdstad. In het park leiden de brede lanen je naar het Paviljoen der Menselijke Driften (ontworpen door Victor Horta), het Koninklijk Museum van het Leger en de Krijgsgeschiedenis, de Koninklijke Musea voor Kunst en Geschiedenis en Autoworld, het automuseum.\r\n\r\nJe kan er het hele jaar door naar sportevenementen, feesten, concerten, vuurwerk... In de zomer vind je er ook de Guinguette Maurice.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[9],"translations":{"de":["Europ\u00e4isches Viertel"],"pt":[null],"en":["European Quarter"],"it":["Quartiere europeo"],"cn":[null],"fr":["Quartier europ\u00e9en"],"sp":["Barrio Europeo"],"nl":["Europese wijk"]}},"zones":{"list":[22],"translations":{"de":["Osten"],"pt":[null],"en":["East"],"it":["Est"],"cn":[null],"fr":["Est"],"sp":["Este"],"nl":["Oost"]}},"neca":null,"facebook_id":"138560756189921","backoffice_id":1468,"location":{"lat":50.84192984,"lon":4.38610375},"region":"brussels","last_updated_at":"2022-10-10T10:25:09+02:00","published_at":"2013-10-19T01:14:22+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":50001075,"translations":{"de":{"name":"Brussels By Foot","address_street_name":"\u00c0 la jonction entre la Galerie de la Reine et la Galerie du Roi (devant le restaurant \u00ab Le Marmiton \u00bb)","address_street_number":null,"address_street_box":null,"email":"info@brusselsbyfoot.com","website":"https:\/\/brusselsbyfoot.be\/sur-les-traces-de-karl-marx\/","phone_contact":"+32 472 39 82 17","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"\u00c0 la jonction entre la Galerie de la Reine et la Galerie du Roi (devant le restaurant \u00ab Le Marmiton \u00bb)","address_line2":"1000 Bruxelles","description_web":"Brussels By Foot is a small company offering unusual guided tours of Brussels. They create themed tours to help you discover Brussels from very special, sometimes surprising angles... All passionate Brusseleirs, they take you through the streets and alleys of Brussels and show you the city as they know it, as they love it.\n\nUrban legends, social struggles, crime scenes, Art Nouveau, or other themes, join us and discover Brussels as you've never seen it before!\n\nThe tours are available on registration via the website, but private tours for groups can also be arranged on request. In these private experiences, why not 