14:00 tot 18:00","zondag: gesloten"]},"date_start":"2024-11-15","date_end":"2024-12-21","is_also_by_appointment":true}],"date_exceptions":[],"closing_days":[],"child_events":[],"parent_events":[],"accessibilities":[],"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[],"opening":{"day":"2024-11-14","end":"21:00:00","start":"18:00:00","timestamp":"2024-11-14T18:00:00"}},{"id":5700002755,"date_start":"2024-10-12","date_end":"2025-02-02","date_next":"2024-11-22","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-11-22T01:01:51+01:00","published_at":"2024-10-18T15:14:26+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":310040,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"other","ranking":0.37475617678431544,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[46,36],"translations":{"de":["Multidisziplin\u00e4r","Museen & Kunstzentren"],"pt":[null,null],"en":["Multidisciplinary","Museums and art centers"],"it":["Multidisciplinare","Musei e centri artistici"],"cn":[null,null],"fr":["Pluridisciplinaire","Mus\u00e9es et art centers"],"sp":["Multidisciplinar","Museos y centros de arte"],"nl":["Multidisciplinair","Musea en kunstcentra"]}}},"translations":{"de":{"name":"L'Atelier du Faux","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/wittockiana.org\/","email":"info@wittockiana.org","phone_contact":"+32 2 770 53 33","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700002755"},"pt":{"name":"L'Atelier du Faux","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/wittockiana.org\/","email":"info@wittockiana.org","phone_contact":"+32 2 770 53 33","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700002755"},"en":{"name":"L'Atelier du Faux","shortdescr":"From the original to the copy, the fake is not necessarily the opposite of the true. Authors of the book world had it clear: evidence of this includes the humor of pastiches, the imagination behind pseudonyms and subversions, or yet the collective creation that dismantles the illusion of the creative genius. L'Atelier du Faux reflects these paradoxes over time with humor and lightness.","longdescr":"L'Atelier du Faux will bring you into a fascinating universe, where reproach and admiration intertwine. \nSince the Renaissance, forgers have satisfied collectors' desires with remarkable creations. Even today, just like in the art market, the trade of luxury goods and consumer items must compete with the sophisticated mastery of forgers. With the rise of new technologies, copying systems are multiplying, and anonymity allows for excesses. Fake news and disinformation thus slide down a slippery slope with disconcerting ease.\n\nThrough this new exhibition, Wittockiana invites you to explore the paradoxes of deception and ingenuity through the centuries. This exhibition combines lightness and depth, reflecting our own quest for authenticity in a world of illusions.","performers":null,"boxoffice_url":null,"website":"https:\/\/wittockiana.org\/en\/home-en\/","email":"info@wittockiana.org","phone_contact":"+32 2 770 53 33","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700002755"},"it":{"name":"L'Atelier du Faux","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/wittockiana.org\/","email":"info@wittockiana.org","phone_contact":"+32 2 770 53 33","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700002755"},"cn":{"name":"L'Atelier du Faux","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/wittockiana.org\/","email":"info@wittockiana.org","phone_contact":"+32 2 770 53 33","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700002755"},"fr":{"name":"L'Atelier du Faux","shortdescr":"De l\u2019original \u00e0 la copie, le faux n\u2019est pas forc\u00e9ment le contraire du vrai. Et les acteurs du monde du livre l\u2019ont bien compris. Pour preuve, l\u2019humour \u00e9rudit des pastiches, l\u2019imagination des pseudonymes et des d\u00e9tournements, ou encore la cr\u00e9ation collective qui d\u00e9monte l\u2019illusion romantique du g\u00e9nie cr\u00e9ateur.\nL\u2019Atelier du faux refl\u00e8te ces paradoxes \u00e0 travers le temps avec humeur et l\u00e9g\u00e8ret\u00e9.","longdescr":"L\u2019Atelier du Faux vous plonge dans un univers fascinant o\u00f9 se m\u00ealent r\u00e9probation et admiration. Depuis la Renaissance, les faussaires ont nourri la soif des collectionneurs avec des cr\u00e9ations d\u2019une habilet\u00e9 remarquable. Aujourd\u2019hui encore, comme sur le march\u00e9 de l\u2019art, le commerce des objets de luxe et des biens de consommation doit rivaliser avec la ma\u00eetrise sophistiqu\u00e9e des faussaires. Avec l\u2019essor des nouvelles technologies, les syst\u00e8mes de copie se multiplient et l\u2019anonymat lib\u00e8re les d\u00e9rives. Les fake news et la d\u00e9sinformation d\u00e9valent ainsi une pente glissante avec une facilit\u00e9 d\u00e9concertante.\n\n\u00c0 travers cette nouvelle exposition, la Wittockiana vous invite \u00e0 explorer les paradoxes de la tromperie et de l\u2019ing\u00e9niosit\u00e9 \u00e0 travers les si\u00e8cles. Cette exposition marie l\u00e9g\u00e8ret\u00e9 et profondeur, refl\u00e9tant notre propre qu\u00eate d\u2019authenticit\u00e9 dans un monde d\u2019illusions.\n","performers":null,"boxoffice_url":null,"website":"https:\/\/wittockiana.org\/","email":"info@wittockiana.org","phone_contact":"+32 2 770 53 33","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700002755"},"sp":{"name":"L'Atelier du Faux","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/wittockiana.org\/","email":"info@wittockiana.org","phone_contact":"+32 2 770 53 33","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700002755"},"nl":{"name":"Het Namaakatelier","shortdescr":"Van origineel naar kopie, de vervalsing is niet per se het tegenovergestelde van de waarheid. \nTer bewijs, de geleerde humor van pastiches, de verbeelding van pseudoniemen en omleidingen, of de collectieve creatie die de illusie van de creatieve genius ontmantelt. Het Namaakatelier weerspiegelt deze paradoxen door de tijd heen met humeur en lichtheid.","longdescr":"Het Namaakatelier brengt je in een fascinerend universum waar afkeuring en bewondering samensmelten. Sinds de Renaissance hebben vervalsers de wensen van verzamelaars vervuld met opmerkelijke creaties. Ook vandaag de dag moet de handel in luxe goederen en consumptiegoederen concurreren met de verfijnde meesterlijkheid van vervalsers. Met de opkomst van nieuwe technologie\u00ebn vermenigvuldigen de kopieersystemen zich, en anonimiteit laat excessen toe. Fake news en desinformatie glijden zo met verontrustende eenvoud een glibberige helling af.\n\nVia deze nieuwe tentoonstelling nodigt Wittockiana je uit om de paradoxen van bedrog en vindingrijkheid door de eeuwen heen te verkennen. Deze tentoonstelling combineert lichtheid en diepgang, en weerspiegelt onze eigen zoektocht naar authenticiteit in een wereld vol illusies.","performers":null,"boxoffice_url":null,"website":"https:\/\/wittockiana.org\/nl\/home-nl\/","email":"info@wittockiana.org","phone_contact":"+32 2 770 53 33","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700002755"}},"place":{"id":142,"translations":{"de":{"name":"Wittockiana: Msueum f\u00fcr Buch- und Buchbindekunst","address_street_name":"Rue du Bemel","address_street_number":"23","address_street_box":null,"email":"info@wittockiana.org","website":"http:\/\/www.wittockiana.org","phone_contact":"+32 2 770 53 33","phone_booking":null,"address_zip":"1150","address_city":"Woluwe-Saint-Pierre","address_line1":"Rue du Bemel, 23","address_line2":"1150 Woluwe-Saint-Pierre","description_web":"Die Wittockiana wurde 1983 von dem renommierten Buchkenners Michel Wittock gegr\u00fcndet und ist sowohl Buchmuseum als auch Bibliothek und Archiv f\u00fcr kostbare historische, moderne und zeitgen\u00f6ssische B\u00fccher.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Wittockiana : Mus\u00e9e des Arts du livre et de la Reliure ","address_street_name":"Rue du Bemel","address_street_number":"23","address_street_box":null,"email":"info@wittockiana.org","website":"http:\/\/www.wittockiana.org","phone_contact":"+32 2 770 53 33","phone_booking":null,"address_zip":"1150","address_city":"Woluwe-Saint-Pierre","address_line1":"Rue du Bemel, 23","address_line2":"1150 Woluwe-Saint-Pierre","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Wittockiana ","address_street_name":"Rue du Bemel","address_street_number":"23","address_street_box":null,"email":"info@wittockiana.org","website":"http:\/\/www.wittockiana.org","phone_contact":"+32 2 770 53 33","phone_booking":null,"address_zip":"1150","address_city":"Woluwe-Saint-Pierre","address_line1"