russels\/en\/visitors\/agenda\/event-detail.50005729"},"it":{"name":"Stan Pollet et Pipou - Cru 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50005729"},"cn":{"name":"Stan Pollet et Pipou - Cru 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50005729"},"fr":{"name":"Stan Pollet et Pipou - Cru 2024","shortdescr":"On les aime ! Comme le vin ! Cela s'est encore plus affin\u00e9... Le Cru Stan et Pipou 2024 ! Depuis vingt quatre saisons, il a eu le temps d'arriver \u00e0 maturation ce cru-l\u00e0... Alors ils reviennent et on se d\u00e9lecte... On en reprend jusqu'\u00e0 l'ivresse... Et on se r\u00e9p\u00e8te... Et ils avaient d\u00e9j\u00e0 de la bouteille\u2026 Et on est en manque d\u2019eux\u2026 Rien que de la bonne humeur...","longdescr":"On les aime ! Comme le vin ! Cela s'est encore plus affin\u00e9... Le Cru Stan et Pipou 2024 ! Depuis vingt quatre saisons, il a eu le temps d'arriver \u00e0 maturation ce cru-l\u00e0... Alors ils reviennent et on se d\u00e9lecte... On en reprend jusqu'\u00e0 l'ivresse... Et on se r\u00e9p\u00e8te... Ils seront bient\u00f4t class\u00e9s au patrimoine mondial de l'Unesco... et d\u00e9j\u00e0 reconnus d'utilit\u00e9 publique... Et puis, on est en manque d'eux...  Rien que de la bonne humeur. Concert \u00e0 partir de 20h45. \u00c9tablissement accessible \u00e0 partir de 20h00-20h10.","performers":"Stan Pollet (chant, guitare, paroles et musique); Pipou (chant, kongas, paroles et musique)","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50005729"},"sp":{"name":"Stan Pollet et Pipou - Cru 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50005729"},"nl":{"name":"Stan Pollet et Pipou - Cru 2024","shortdescr":null,"longdescr":"We zijn er gek van, van die twee. Ze maken deel uit van de meubelen, van ons dagelijks leven, van onze liefde voor het echte chanson. Ze zijn altijd grappig, komen altijd verrassend uit de hoek. Zelfs als ze het ernstig menen. Voorstelling om 20:45 uur.  Pipou (zang en conga); Stan Pollet (zang en gitaar)","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50005729"}},"place":{"id":220283,"translations":{"de":{"name":"Le Jardin de ma Soeur","address_street_name":"Rue du Grand Hospice","address_street_number":"54","address_street_box":null,"email":"info@lejardindemasoeur.be","website":"http:\/\/www.lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 54","address_line2":"1000 Bruxelles","description_web":"Dieses malerische Caf\u00e9-Theater, das 1994 in der N\u00e4he des alten \"Grand B\u00e9guinage de Bruxelles\" er\u00f6ffnet wurde, \u00fcberrascht durch seine \u00fcberaus kleinen R\u00e4umlichkeiten. Doch daf\u00fcr ist das Programm ist umso \"gr\u00f6\u00dfer\". Reservierung empfohlen!","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Le Jardin de ma Soeur","address_street_name":"Rue du Grand Hospice","address_street_number":"54","address_street_box":null,"email":"info@lejardindemasoeur.be","website":"http:\/\/www.lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 54","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Le Jardin de ma Soeur","address_street_name":"Grootgodshuisstraat","address_street_number":"54","address_street_box":null,"email":"info@lejardindemasoeur.be","website":"http:\/\/www.lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","address_zip":"1000","address_city":"Bruxelles","address_line1":"Grootgodshuisstraat, 54","address_line2":"1000 Bruxelles","description_web":"The desire to present theater amongst people; as if a performance is nothing but a conversation, in a place somewhere in between the large halls and the streets, half living room, half pub, in a warm ambiance where one can sip a glass while watching a performance. That's cafe-theater \"Le Jardin de ma Soeur\", at the edge of the ancient \"Grand B\u00e9guinage de Bruxelles\", alongside one of the quays of the old port of Brussels where the spirit of the dock workers lingers and where one can still feel the presence of the beguines with their long black robes.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Le Jardin de ma Soeur","address_street_name":"Rue du Grand Hospice","address_street_number":"54","address_street_box":null,"email":"info@lejardindemasoeur.be","website":"http:\/\/www.lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 54","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Le Jardin de ma Soeur","address_street_name":"Rue du Grand Hospice","address_street_number":"54","address_street_box":null,"email":"info@lejardindemasoeur.be","website":"http:\/\/www.lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 54","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"fr":{"name":"Le Jardin de ma Soeur","address_street_name":"Rue du Grand Hospice","address_street_number":"54","address_street_box":null,"email":"info@lejardindemasoeur.be","website":"http:\/\/www.lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 54","address_line2":"1000 Bruxelles","description_web":"Le Jardin de ma S\u0153ur est situ\u00e9 au coin d'une rue du pittoresque March\u00e9 aux poissons, \u00e0 proximit\u00e9 de l\u2019ancien Grand B\u00e9guinage de Bruxelles. On peut difficilement imaginer un nom plus familier. Pourtant, cet endroit n'a pas vol\u00e9 son nom. Vous obtenez exactement ce que vous attendez : une soir\u00e9e sans pr\u00e9tention, pleine de divertissements et de moments partag\u00e9s. Vous vous y sentez comme dans votre salon. Vous oubliez imm\u00e9diatement tous vos soucis et riez, chantez et profitez du spectacle avec les autres participants. Sp\u00e9cialement pour les amateurs de chanson fran\u00e7aise et de th\u00e9\u00e2tre.  \u202f \r\nPensez \u00e0 r\u00e9server votre place !\r\n ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Le Jardin de ma Soeur","address_street_name":"Rue du Grand Hospice","address_street_number":"54","address_street_box":null,"email":"info@lejardindemasoeur.be","website":"http:\/\/www.lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 54","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Le Jardin de ma Soeur","address_street_name":"Grootgodshuisstraat","address_street_number":"54","address_street_box":null,"email":"info@lejardindemasoeur.be","website":"http:\/\/www.lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","address_zip":"1000","address_city":"Bruxelles","address_line1":"Grootgodshuisstraat, 54","address_line2":"1000 Bruxelles","description_web":"Op een straathoek aan de pittoreske Vismarkt ligt Le Jardin de ma Soeur. Een familialere naam kan je haast niet bedenken. Toch heeft deze plek haar naam niet gestolen. Je krijgt exact wat je er zou verwachten: een pretentieloze avond vol vertier en gedeelde momenten. Hier waan je je in een gezellige en veilige woonkamer. Je vergeet er meteen al je zorgen en lacht, zingt en geniet met de andere aanwezigen. Vooral voor liefhebbers van het Franse chanson en verhaaltheater.    \u202f\u202f\u202f ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[3],"translations":{"de":["Dansaert\/Sainte-Catherine"],"pt":[null],"en":["Dansaert\/Sainte-Catherine"],"it":["Dansaert\/Sainte-Catherine"],"cn":[null],"fr":["Dansaert\/Sainte-Catherine"],"sp":["Dansaert\/Sainte-Catherine"],"nl":["Dansaertwijk\/Sint-Katelijne"]}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":null,"facebook_id":"terassequai","backoffice_id":596,"location":{"lat":50.8535193,"lon":4.347348},"region":"brussels","last_updated_at":"2023-11-06T09:12:27+01:00","published_at":"2013-10-19T01:13:39+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":220283,"translations":{"de":{"name":"Le Jardin de ma Soeur","address_street_name":"Rue du Grand Hospice","address_street_number":"54",