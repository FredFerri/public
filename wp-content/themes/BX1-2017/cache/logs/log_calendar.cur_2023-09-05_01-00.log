,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2023-08-23T10:15:02+02:00","published_at":"2023-08-23T10:11:49+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":283762,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"theatre","ranking":1.2599210498948732,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":49,"translations":{"de":"Theater","pt":null,"en":"Theatre","it":"Teatro","cn":null,"fr":"Th\u00e9\u00e2tre","sp":"Teatro","nl":"Theater"}},"others":{}},"translations":{"de":{"name":"Maux bleus","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.senghor.be\/event\/maux-bleus\/","email":"reservation@senghor.be","phone_contact":null,"phone_booking":"+32 470 84 56 36","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50001197"},"pt":{"name":"Maux bleus","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.senghor.be\/event\/maux-bleus\/","email":"reservation@senghor.be","phone_contact":null,"phone_booking":"+32 470 84 56 36","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50001197"},"en":{"name":"Maux bleus","shortdescr":"Porteuses de paroles et guerri\u00e8res survivantes, elles t\u00e9moignent pour toutes celles qui ne pourront plus t\u00e9moigner, et nous racontent les maux bleus, l\u2019emprise, les violences, le silence, la fuite et la renaissance.\n","longdescr":"\u00abMon pyjama est totalement d\u00e9chir\u00e9 aux \u00e9paules. C\u2019est l\u00e0 que tout me revient en m\u00e9moire. Je ne sais pas pour quelle raison, je ne saurai jamais pour quelle raison il a hurl\u00e9 et m\u2019a bouscul\u00e9e, une fois de plus\u2026 Je me rappelle les douleurs, les odeurs, les cris, le c\u0153ur qui se serre \u00e0 m\u2019en donner la naus\u00e9e. Comment j\u2019en suis arriv\u00e9e l\u00e0 ? \u00ab Tous les jours, dans le monde, 82 femmes meurent tu\u00e9es par leur partenaire ou expartenaire. En Belgique, on estime qu\u2019une femme sur quatre sera victime de violences physiques et\/ou sexuelles dans son couple. En collaboration avec le Th\u00e9\u00e2tre des Rues, \u00ab Les Chanceuses \u00bb de Solidarit\u00e9 Femmes ont choisi d\u2019enfiler leurs armures de papier et de replonger au c\u0153ur de l\u2019enfer des violences conjugales. Porteuses de paroles et guerri\u00e8res survivantes, elles t\u00e9moignent pour toutes celles qui ne pourront plus t\u00e9moigner, et nous racontent les maux bleus, l\u2019emprise, les violences, le silence, la fuite et la renaissance.","performers":"PAR : Le Th\u00e9\u00e2tre des Rues, une compagnie de Th\u00e9\u00e2tre Action.\nAVEC : Ignazia Abis, Julie Bultot, Christelle Descamps Wendy Descamps, Bernadette Dessart Christine Falques, Barbara Leclercq, Frosi Mammei, Sara Mendicino\nMISE EN SC\u00c8NE : Laura Bejarano Medina","boxoffice_url":null,"website":"https:\/\/www.senghor.be\/event\/maux-bleus\/","email":"reservation@senghor.be","phone_contact":null,"phone_booking":"+32 470 84 56 36","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50001197"},"it":{"name":"Maux bleus","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.senghor.be\/event\/maux-bleus\/","email":"reservation@senghor.be","phone_contact":null,"phone_booking":"+32 470 84 56 36","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50001197"},"cn":{"name":"Maux bleus","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.senghor.be\/event\/maux-bleus\/","email":"reservation@senghor.be","phone_contact":null,"phone_booking":"+32 470 84 56 36","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/e