85 94","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.546251"},"cn":{"name":"Art Nouveau et Art D\u00e9co \u00e0 Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.itineraires.be","email":"info@itineraires.be","phone_contact":null,"phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.546251"},"fr":{"name":"Art Nouveau et Art D\u00e9co \u00e0 Bruxelles","shortdescr":"Des courbes de notre Art Nouveau aux lignes \u00e9pur\u00e9es de l'Art D\u00e9co, une mosa\u00efque complexe d'originalit\u00e9 et d'\u00e9changes a conduit nos architectes \u00e0 conqu\u00e9rir une place unique dans l'histoire de  l'architecture. \u00c0 nous de vous donner \u00e0 voir,  \u00e0 vous de percevoir !","longdescr":"Le Centre-ville nous m\u00e8ne vers les somptueux magasins Waucquez  et des fr\u00e8res Wolfers. Aujourd\u2019hui devenu respectueusement, le Centre Belge de la Bande Dessin\u00e9e et un magasin de jouet, ils sont les seuls espace-magasins \u00e0 subsister. Horta aimait investir des b\u00e2timents de diff\u00e9rentes utilit\u00e9s, ainsi il a \u00e9galement \u00e9labor\u00e9 le Jardin d'enfants n\u00b015 de la ville de Bruxelles.\r\nHorta est un artiste fertile cherchant toujours l\u2019innovation et le renouvellement. Apr\u00e8s la premi\u00e8re guerre mondiale et son voyage en Am\u00e9rique, Horta se donne \u00e0 un style plus d\u00e9pouill\u00e9 et g\u00e9om\u00e9trique l\u2019Art D\u00e9coratif. L\u2019exemple le plus repr\u00e9sentatif de cette p\u00e9riode de l\u2019architecte  est la fa\u00e7ade du Bozar. Et oui, c\u2019est bien une fa\u00e7ade sign\u00e9e Horta. Plus \u00e9tonnant encore, c\u2019est lui qui \u00e9labore la bien connue Gare-Centrale de notre ch\u00e8re Bruxelles. \r\n\r\nVisite guid\u00e9e organis\u00e9e sur mesure pour vous et votre groupe.\r\nPrix sur demande, possibilit\u00e9 d'y inclure la visite d'un int\u00e9rieur, d'adapter en formule teambuilding et\/ou encore avec nos guides costum\u00e9s...","performers":null,"boxoffice_url":null,"website":"http:\/\/www.itineraires.be","email":"info@itineraires.be","phone_contact":null,"phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.546251"},"sp":{"name":"Art Nouveau et Art D\u00e9co \u00e0 Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.itineraires.be","email":"info@itineraires.be","phone_contact":null,"phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.546251"},"nl":{"name":"Art Nouveau et Art D\u00e9co \u00e0 Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.itineraires.be","email":"info@itineraires.be","phone_contact":null,"phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.546251"}},"place":{"id":230072,"translations":{"de":{"name":"Itin\u00e9raires","address_street_name":"Rue de l'Aqueduc","address_street_number":"171","address_street_box":null,"email":"info@itineraires.be","website":"http:\/\/www.itineraires.be","phone_contact":"+32 495 38 85 94","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Aqueduc, 171","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Itin\u00e9raires","address_street_name":"Rue de l'Aqueduc","address_street_number":"171","address_street_box":null,"email":"info@itineraires.be","website":"http:\/\/www.itineraires.be","phone_contact":"+32 495 38 85 94","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Aqueduc, 171","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"