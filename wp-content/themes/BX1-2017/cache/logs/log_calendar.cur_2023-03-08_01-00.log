street_name":"avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"http:\/\/www.explore.brussels\/","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"avenue Brugmann, 405","address_line2":"1180 Uccle","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Explore.Brussels","address_street_name":"Brugmannlaan","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"http:\/\/www.explore.brussels\/","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Ukkel","address_line1":"Brugmannlaan, 405","address_line2":"1180 Ukkel","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Explore.Brussels","address_street_name":"avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"http:\/\/www.explore.brussels\/","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"avenue Brugmann, 405","address_line2":"1180 Uccle","description_web":"Explore.Brussels is a network of associations that organize top-quality guided tours in the Brussels-Capital Region. \r\nIts membre associations are ARAU, Pro Velo, Brussels Chatterguides and Arkadia. La Fonderie (in 2020) & Korei (in 2021) joined the network as a partner association.\r\n\r\nDiscover UNESCO\u2019s heritage, Art nouveau, Victoria Horta, Magritte, Herg\u00e9, Street art, Europe, beer, chocolate, or visit buildings built in Art Nouveau, Art Deco or neoclassical style that are usually closed for public visits. Tours are available for individual visitors and groups, and organized in a classical, exceptional or completely new way. Besides walking tours, visits can be organized by bike, bus or boat.\r\n\r\nExplore.Brussels organizes the Brussels Art Nouveau & Art Deco (BANAD) Festival and Brussels Biennale \u2013 Neoclassic (BBN), Brussels Biennale of Eclectic Architecture (BBEA) as well as other projects such as the visits of Art Nouveau Mansions, the formation of tour guides, the owners club and the friends club. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Explore.brussels","address_street_name":"avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"http:\/\/www.explore.brussels\/","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"avenue Brugmann, 405","address_line2":"1180 Uccle","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Explore.brussels","address_street_name":"avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"http:\/\/www.explore.brussels\/","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"avenue Brugmann, 405","address_line2":"1180 Uccle","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Explore.brussels","address_street_name":"avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"http:\/\/www.explore.brussels\/","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"avenue Brugmann, 405","address_line2":"1180 Uccle","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Explore.brussels","address_street_name":"avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","w