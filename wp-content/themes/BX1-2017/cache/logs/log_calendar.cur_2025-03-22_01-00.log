025-03-25","date_end":"2025-03-29","date_next":"2025-03-25","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":true,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-12-19T20:52:05+01:00","published_at":"2024-12-19T20:51:29+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":314822,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"theatre","ranking":0.7368062997280773,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":49,"translations":{"de":"Theater","pt":null,"en":"Theatre","it":"Teatro","cn":null,"fr":"Th\u00e9\u00e2tre","sp":"Teatro","nl":"Theater"}},"others":{}},"translations":{"de":{"name":"Forum","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/theatredelavie.be\/agenda\/saison-2024-2025\/forum\/","email":"reservations@theatredelavie.be","phone_contact":"+32 2 219 11 86","phone_booking":"+32 2 219 11 86","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700004792"},"pt":{"name":"Forum","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/theatredelavie.be\/agenda\/saison-2024-2025\/forum\/","email":"reservations@theatredelavie.be","phone_contact":"+32 2 219 11 86","phone_booking":"+32 2 219 11 86","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700004792"},"en":{"name":"Forum","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/theatredelavie.be\/agenda\/saison-2024-2025\/forum\/","email":"reservations@theatredelavie.be","phone_contact":"+32 2 219 11 86","phone_booking":"+32 2 219 11 86","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700004792"},"it":{"name":"Forum","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/theatredelavie.be\/agenda\/saison-2024-2025\/forum\/","email":"reservations@theatredelavie.be","phone_contact":"+32 2 219 11 86","phone_booking":"+32 2 219 11 86","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700004792"},"cn":{"name":"Forum","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/theatredelavie.be\/agenda\/saison-2024-2025\/forum\/","email":"reservations@theatredelavie.be","phone_contact":"+32 2 219 11 86","phone_booking":"+32 2 219 11 86","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700004792"},"fr":{"name":"Forum","shortdescr":"Est-ce que \u00ab se parler dans sa t\u00eate \u00bb est un probl\u00e8me\u202f? Qu\u2019est-ce qui se passe quand on \u00ab parle tout\u00b7e seul\u00b7e \u00bb ? A partir d\u2019une conversation sur un forum internet, Nicole Stankiewicz essaie de r\u00e9pondre \u00e0 ces questions \u00e0 la fronti\u00e8re entre r\u00e9alit\u00e9 et imaginaire. Une tragi-com\u00e9die poignante et hilarante, mais aussi une m\u00e9ditation sur la solitude, sur le trop-plein ou trop-vide de l\u2019existence.","longdescr":"Forum part de la d\u00e9couverte d\u2019un forum internet du d\u00e9but des ann\u00e9es 2000, o\u00f9 des femmes se demandent si \u00ab parler toute seule \u00bb est un probl\u00e8me ou non. S\u2019il faut s\u2019inqui\u00e9ter quand on a des conversations avec des personnes imaginaires, quand on vit dans sa t\u00eate ou dans ses r\u00eaves... Ce qu\u2019il faut penser et faire quand cette vie parall\u00e8le se met \u00e0 prendre trop de place, \u00e0 prendre le pas sur la vie \u00ab r\u00e9elle \u00bb.\nDes internautes anonymes se lancent dans une investigation vertigineuse et collective de leur quotidien int\u00e9rieur et de la mani\u00e8re dont elles vivent entre plusieurs dimensions. Elles se demandent si elles sont \u00ab normales \u00bb. Elles d\u00e9battent de la folie, de la norme et des psys.\n\nEn filigrane, elles nous parlent aussi d\u2019ennui, de vies qui sont ressenties comme \u00ab pas assez \u00bb, du besoin de vivre une vie intense. D\u2019un bouillonnement int\u00e9rieur fait de pens\u00e9es, de mots, de d\u00e9sirs, d\u2019imagination, qui ne trouve pas sa place dans leur existence \u00ab r\u00e9elle \u00bb et partag\u00e9e avec les autres.\n\nUne tragi-com\u00e9die poignante et hilarante, brute et absurde, mais aussi une m\u00e9ditation sur la solitude, sur le trop-plein ou trop-vide de l\u2019existence, et sur la recherche d\u2019une vie heureuse.\n","performers":"Conception et interpr\u00e9tation\u202f: Nicole Stankiewicz \/ Collaboration artistique\u202f: Aur\u00e9lien Leforestier et Simon Thomas \/ Regard sc\u00e9nographique : Silvio Palomo \/ Cr\u00e9ation sonore : Selma Raphard-Ayadi \/ Cr\u00e9ation lumi\u00e8res : Ad\u00e8le Evans \/ Regard ext\u00e9rieur sur les premi\u00e8res recherches : Emilienne Flagothier.","boxoffice_url":null,"website":"https:\/\/theatredelavie.be\/agenda\/saison-2024-2025\/forum\/","email":"reservations@theatredelavie.be","phone_contact":"+32 2 219 11 86","phone_booking":"+32 2 219 11 86","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700004792"},"sp":{"name":"Forum","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/theatredelavie.be\/agenda\/saison-2024-2025\/forum\/","email":"reservations@theatredelavie.be","phone_contact":"+32 2 219 11 86","phone_booking":"+32 2 219 11 86","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700004792"},"nl":{"name":"Forum","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/theatredelavie.be\/agenda\/saison-2024-2025\/forum\/","email":"reservations@theatredelavie.be","phone_contact":