itrines de ta ville. Tu d\u00e9couvriras en m\u00eame temps les rouages d'une monnaie locale et comment elle cr\u00e9e du lien entre les habitant\u00b7e\u00b7s et des initiatives engag\u00e9es.\nQuartier Centre- Dansaert et Sainte Catherine","longdescr":"Plonge avec nous dans le grand Zinne Bazaar. \nPars en balade, d\u00e9couvre les histoires, secrets et bons plans qui se cachent derri\u00e8re les vitrines de ta ville. Tu d\u00e9couvriras en m\u00eame temps les rouages d'une monnaie locale et comment elle cr\u00e9e du lien entre les habitant\u00b7e\u00b7s et des initiatives engag\u00e9es.\nQuartier Centre- Dansaert et Sainte Catherine\n\nR\u00e9servations sur : www.zinne.brussels\/events\/\n5 Zinnes vous seront donn\u00e9es pendant la balades ! \n","performers":"Bazaar Trottoir (guide)","boxoffice_url":null,"website":"https:\/\/www.zinne.brussels\/events\/","email":"soizic.cassard@zinne.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50009090"},"sp":{"name":"ZINNE BAZAAR |  La d\u00e9couverte de l'economie locale et engag\u00e9e - Centre","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.zinne.brussels\/events\/","email":"soizic.cassard@zinne.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50009090"},"nl":{"name":"ZINNE BAZAAR |  La d\u00e9couverte de l'economie locale et engag\u00e9e - Centre","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.zinne.brussels\/events\/","email":"soizic.cassard@zinne.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50009090"}},"place":{"id":50001368,"translations":{"de":{"name":"La Zinne","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"info@zinne.brussels","website":"zinne.brussels","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 7","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"La Zinne","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"info@zinne.brussels","website":"zinne.brussels","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 7","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Zinne","address_street_name":"Grootgodshuisstraat","address_street_number":"7","address_street_box":null,"email":"info@zinne.brussels","website":"zinne.brussels","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Grootgodshuisstraat, 7","address_line2":"1000 Brussels","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"La Zinne","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"info@zinne.brussels","website":"zinne.brussels","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 7","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"La Zinne","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"info@zinne.brussels","website":"zinne.brussels","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 7","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"La Zinne","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"info@zinne.brussels","website":"zinne.brussels","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 7","address_line2":"1000 Bruxelles","description_web":"La Zinne, c\u2019est aussi et surtout une exp\u00e9rience citoyenne : un ensemble d\u2019objectifs, de valeurs et de crit\u00e8res, qui mat\u00e9rialise dans de jolis billets color\u00e9s la volont\u00e9 de faire vivre la Bruxelles que l\u2019on aime.\n\nL\u00e9galement, une monnaie locale compl\u00e9mentaire \u00e0 l\u2019euro est reconnue comme \u00ab bon de soutien \u00e0 l\u2019\u00e9conomie locale \u00bb, en R\u00e9gion bruxelloise. C\u2019est pour la g\u00e9rer et la faire grandir que la structure Zinne ASBL a \u00e9t\u00e9 cr\u00e9\u00e9e en 2019.\n\nNos missions principales, en tant qu\u2019ASBL, sont de veiller au respect de la charte de valeurs et aux objectifs du projet, promouvoir l\u2019utilisation des Zinnes en s\u2019activant pour \u00e9largir en permanence le r\u00e9seau o\u00f9 il est possible de les d\u00e9penser, travailler sur les fili\u00e8res professionnelles (fournisseurs, prestataires de services, etc.), afin qu\u2019une Zinne puisse circuler toujours plus longtemps au sein de notre \u00e9conomie locale","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"La Zinne","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"info@zinne.brussels","website":"zinne.brussels","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Gr