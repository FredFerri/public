tail.5700006193"},"en":{"name":"Meet the curator, Nancy Casielles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lamaisondesarts.be\/terrain-de-jeux\/","email":"info@lamaisondesarts.be","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 99","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700006193"},"it":{"name":"Meet the curator, Nancy Casielles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lamaisondesarts.be\/terrain-de-jeux\/","email":"info@lamaisondesarts.be","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 99","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700006193"},"cn":{"name":"Meet the curator, Nancy Casielles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lamaisondesarts.be\/terrain-de-jeux\/","email":"info@lamaisondesarts.be","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 99","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700006193"},"fr":{"name":"Meet the curator, Nancy Casielles","shortdescr":"Dans le cadre de l\u2019exposition Terrain de jeux","longdescr":"\nVisite guid\u00e9e de l\u2019exposition Terrain de jeux avec la curatrice, Nancy Casielles, historienne de l\u2019art et curatrice d\u2019expositions. Venez d\u00e9couvrir le travail de huit artistes qui utilisent l\u2019esprit du jeu dans leur travail. Venez vous frotter \u00e0 des artistes qui utilisent le jeu au sens large comme un outil favorisant l\u2019\u00e9change, l\u2019interaction, la fantaisie, l\u2019imagination, la participation et la coop\u00e9ration. La curatrice vous expliquera comment elle a con\u00e7u l\u2019exposition en mobilisant la notion de jeu, non comme un simple loisir associ\u00e9 \u00e0 l\u2019enfance, mais comme une m\u00e9taphore de la sociabilit\u00e9.\n\nLes artistes : Denicolai & Provoost, David de Tscharner, Eva Evrad, Floris Hovers, Anna Mancuso, Anna Raimondo et Christophe Terlinden\n\n \n\nINFOS: \n\nQuand? 16.03 & 11.05  14h>15h30\nPrix de la visite: 5 \u20ac. Inscription obligatoire. L\u2019entr\u00e9e dans l\u2019expo est gratuite.  ","performers":null,"boxoffice_url":null,"website":"https:\/\/lamaisondesarts.be\/terrain-de-jeux\/","email":"info@lamaisondesarts.be","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 99","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700006193"},"sp":{"name":"Meet the curator, Nancy Casielles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lamaisondesarts.be\/terrain-de-jeux\/","email":"info@lamaisondesarts.be","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 99","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700006193"},"nl":{"name":"Meet the curator, Nancy Casielles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lamaisondesarts.be\/terrain-de-jeux\/","email":"info@lamaisondesarts.be","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 99","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700006193"}},"place":{"id":222932,"translations":{"de":{"name":"Maison des Arts","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 147","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Maison des Arts","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 147","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Maison des Arts","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 147","address_line2":"1030 Schaerbeek","description_web":"The MdA is run and staffed by the Francophone Cultural Service of Schaerbeek Council and is a unique place whose activities are mainly concerned with the creation of works of contemporary art with a significant partnership programme that promotes access for all to contemporary art.\r\n\r\nThe MdA has hosted a rich programme of artistic activities since the 1950s when the building was purchased by Schaerbeek Council. In 2005, the MdA began a programme of inviting artists to work in building, to build more coherence between their works of art and the MdA.\r\n\r\nMost recently, in 2016, Schaerbeek Council decided to position the MdA as a centre for the creation, diffusion and promotion of culture, contemporary two-dimensional, three-dimensional and digital art.\r\nThe MdA\u2019s educational and social approach aims to promoting equality of access to art and its introduction to new audiences.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Maison des Arts","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 147","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Maison des Arts","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 147","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Maison des Arts","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 147","address_line2":"1030 Schaerbeek","description_web":"La Maison des Arts, anim\u00e9e par le Service Culture fran\u00e7aise de la Commune de Schaerbeek, est un espace singulier dont les activit\u00e9s sont principalement ax\u00e9es sur la cr\u00e9ation contemporaine dans le domaine des arts plastiques avec un important programme de m\u00e9diation permettant l\u2019acc\u00e8s de l\u2019art contemporain \u00e0 tous.\r\n\r\nLa MA conna\u00eet une riche activit\u00e9 artistique depuis les ann\u00e9es \u201950, \u00e9poque \u00e0 laquelle la commune rach\u00e8te le b\u00e2timent. En 2005, elle se voit prendre un premier tournant en proposant aux artistes de travailler in situ, afin d\u2019\u00e9tablir une r\u00e9elle coh\u00e9rence entre l\u2019\u0153uvre et la Maison.\r\nEt finalement, c\u2019est en 2016 que la Commune de Schaerbeek d\u00e9cide de la positionner dans le domaine des arts plastiques, contemporains et num\u00e9riques comme un lieu de cr\u00e9ation, de diffusion et de rayonnement culturel.\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Maison des Arts","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 147","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Huis der Kunsten","address_street_name":"Haachtsesteenweg","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaarbeek","address_line1":"Haachtsesteenweg, 147","address_line2":"1030 Schaarbeek","description_web":"La Maison des Arts, geanimeerd door de dienst Franstalige Cultuur van de gemeente Schaarbeek, is een heel bijzondere plek. De activiteiten zijn vooral gericht op hedendaagse creativiteit in de plastische kunsten.\r\n\r\nIn La Maison des Arts heerst reeds sedert 1950 ( datum waarop de gemeente het huis aankocht) een ruime artistieke activiteit. In 2005 is er een belangrijke ontwikkeling : het voorstel aan de kunstenaars om ter plaatse te werken, teneinde een echte samenhang te bereiken tussen het werk en het Huis. Uiteindelijk beslist de Gemeente Schaarbeek er een echte broeikast van te maken in het domein van de beeldende kunsten, een bron van schepping, verspreiding en culturele uitstraling.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[20],"translations":{"de":["Norden"],"pt":[null],"en":["North"],"it":["Nord"],"cn":[null],"fr":["Nord"],"sp":["Norte"],"nl":["Noord"]}},"neca":null,"facebook_id":null,"backoffice_id":663,"location":{"lat":50.85951067,"lon":4.37063079},"region":"brussels","last_updated_at":"2022-11-09T13:59:40+01:00","published_at":"2013-10-19T01:13:42+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":222932,"translations":{"de":{"name":"Maison des Arts","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 147","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Maison des Arts","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 147","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Maison des Arts","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamais