0006000"},"pt":{"name":"Excursion \u00e0 Binche (pr\u00e9paration au carnaval)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/fb.me\/e\/8PkqZR8dV","email":"aymericamexico40@gmail.com","phone_contact":"+32 465 25 17 70","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700006000"},"en":{"name":"Excursion \u00e0 Binche (pr\u00e9paration au carnaval)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/fb.me\/e\/8PkqZR8dV","email":"aymericamexico40@gmail.com","phone_contact":"+32 465 25 17 70","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700006000"},"it":{"name":"Excursion \u00e0 Binche (pr\u00e9paration au carnaval)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/fb.me\/e\/8PkqZR8dV","email":"aymericamexico40@gmail.com","phone_contact":"+32 465 25 17 70","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700006000"},"cn":{"name":"Excursion \u00e0 Binche (pr\u00e9paration au carnaval)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/fb.me\/e\/8PkqZR8dV","email":"aymericamexico40@gmail.com","phone_contact":"+32 465 25 17 70","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700006000"},"fr":{"name":"Excursion \u00e0 Binche (pr\u00e9paration au carnaval)","shortdescr":null,"longdescr":"\u00c0 b\u00e2bord pr\u00e9sente\nBinche pr\u00e9pare son carnaval\n\nDimanche 16 f\u00e9vrier 2025\nTour d\u2019un jour \u00e0 Binche depuis Bruxelles\n\nAu programme\n9h\u00a0: rendez vous \u00e0 la gare (Bruxelles Central)\n\n11h visite du Mus\u00e9e du carnaval et du masque en pr\u00e9sence d\u2019un guide\n\n12h30 d\u00e9jeuner, et visites compl\u00e9mentaires en option (autres sections du mus\u00e9e)\n\n15h retrouver une des soci\u00e9t\u00e9s pour participer aux \u00ab\u00a0soumonces\u00a0\u00bb (en pr\u00e9sence d\u2019Axelle Byster,  membre de soci\u00e9t\u00e9 qui pourra r\u00e9pondre aux questions \u00e9ventuelles) \n\n17\/18h retour vers Bruxelles (arriv\u00e9e vers 20h) \n\nCe tour inclut\nUne entr\u00e9e au mus\u00e9e du Carnaval et du masque et un guide pour la visite\nLa pr\u00e9sence d\u2019un(e) membre de soci\u00e9t\u00e9 avec nous pendant une partie des soumonces\nLe transport en train Bruxelles-Binche A\/R\n\nCe tour n\u2019inclut pas\nLe d\u00e9jeuner ou Pic-nic mais une salle pourra \u00eatre mise \u00e0 notre disposition\n","performers":"\u00c0 b\u00e2bord pr\u00e9sente\nBinche pr\u00e9pare son carnaval (tour d\u2019un jour \u00e0 Binche depuis Bruxelles)\nCe qui rend la ville de Binche si particuli\u00e8re, outre sa muraille, et son Beffroi, c\u2019est surtout son carnaval, class\u00e9 \u00e0 l\u2019Unesco\u00a0! Et le c\u00e9l\u00e8bre personnage du Gille. Soyez de la partie et vous saurez presque tout sur le contexte de ces c\u00e9l\u00e9brations, sans vous prendre d\u2019oranges sur la t\u00eate\u00a0!\n\n","boxoffice_url":null,"website":"https:\/\/fb.me\/e\/8PkqZR8dV","email":"aymericamexico40@gmail.com","phone_contact":"+32 465 25 17 70","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700006000"},"sp":{"name":"Excursion \u00e0 Binche (pr\u00e9paration au carnaval)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/fb.me\/e\/8PkqZR8dV","email":"aymericamexico40@gmail.com","phone_contact":"+32 465 25 17 70","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700006000"},"nl":{"name":"Excursion \u00e0 Binche (pr\u00e9paration au carnaval)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/fb.me\/e\/8PkqZR8dV","email":"aymericamexico40@gmail.com","phone_contact":"+32 465 2