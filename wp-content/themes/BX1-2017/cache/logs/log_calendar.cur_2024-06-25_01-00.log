how_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":230572,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"tour","ranking":0.1399272756202554,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{}},"translations":{"de":{"name":"Art Nouveau : De la Source aux \u00c9tangs","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/art-nouveau-de-la-source-aux-etangs\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.510572"},"pt":{"name":"Art Nouveau : De la Source aux \u00c9tangs","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/art-nouveau-de-la-source-aux-etangs\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.510572"},"en":{"name":"Art Nouveau : From the Spring to the Ponds","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/art-nouveau-de-la-source-aux-etangs\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.510572"},"it":{"name":"Art Nouveau : De la Source aux \u00c9tangs","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/art-nouveau-de-la-source-aux-etangs\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.510572"},"cn":{"name":"Art Nouveau : De la Source aux \u00c9tangs","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/art-nouveau-de-la-source-aux-etangs\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.510572"},"fr":{"name":"Art Nouveau : De la Source aux \u00c9tangs","shortdescr":"Le tour \u00ab Art Nouveau : de la Source aux \u00c9tangs \u00bb vous emm\u00e8ne du quartier Defacqz jusqu\u2019aux \u00e9tangs d\u2019Ixelles, \u00e0 la d\u00e9couverte d\u2019architectes de la premi\u00e8re et de la seconde g\u00e9n\u00e9ration de l\u2019Art Nouveau. ","longdescr":"Laissez-vous conter l\u2019histoire urbanistique de ces quartiers jouxtant l\u2019Avenue Louise et l\u2019Abbaye de La Cambre en (re-)d\u00e9couvrant de nombreuses fa\u00e7ades de maisons et h\u00f4tels particuliers.\r\n\r\nAbritant plusieurs \u0153uvres d\u2019architectes majeurs, le quartier Defacqz t\u00e9moigne des premiers \u00e9lans de l\u2019architecture Art Nouveau \u00e0 Bruxelles. Apr\u00e8s quelques arr\u00eats autour de la rue Defacqz et de l\u2019avenue Louise, la visite se poursuit dans le quartier plus paisible des \u00e9tangs d\u2019Ixelles \u00e0 la rencontre d\u2019autres tr\u00e9sors architecturaux.\r\n\r\nD\u00e9couvrez des bijoux insoup\u00e7onn\u00e9s dans des quartiers travers\u00e9s tous les jours par des milliers de personnes et qui ont vu, malgr\u00e9 les (r)\u00e9volutions urbaines, leur beaut\u00e9 et leurs richesses pr\u00e9serv\u00e9es !\r\n\r\nAu programme de la balade, entre autres\u2026\r\n\u2013 L\u2019H\u00f4tel Tassel, de Victor Horta ;\r\n\u2013 L\u2019H\u00f4tel Solvay, de Victor Horta ;\r\n\u2013 L\u2019H\u00f4tel Otlet, d\u2019Octave van Rysselberghe et Henry Van de Velde ;\r\n\u2013 L\u2019H\u00f4tel Ciamberlani, de Paul Hankar ;\r\n\u2013 D\u2019autres \u0153uvres d\u2019Albert Roosenboom, Ernest Delune, Ernest Blerot ;\r\n\u2013 Mais aussi de nombreuses petites histoires et anecdotes !\r\n\r\nNous ne rentrerons pas dans les maisons et h\u00f4tels (souvent habit\u00e9s), mais des supports photographiques sont pr\u00e9vus pour vous permettre de mieux vous rendre compte de l\u2019int\u00e9rieur des \u00e9difices. Parce que l\u2019Art Nouveau est un \u201cArt Total\u201d qui ne s\u2019arr\u00eate certainement pas aux fa\u00e7ades !\r\n\r\nINFORMATIONS Pratiques\r\ntours r\u00e9guliers en fran\u00e7ais et en anglais :\r\nPrix : Libre et conscient\r\nR\u00e9servation + que conseill\u00e9e\r\nDur\u00e9e : Environ 2 heures\r\nRendez-vous : \u201cLouise Tower\u201d (devant l\u2019entr\u00e9e de la tour), avenue Louise 149 \u2013 1050 Bruxelles (en face de l\u2019arr\u00eat de tram Defacqz)\r\nFin de la visite : Au bord des \u00c9tangs d\u2019Ixelles\r\n\r\nTour priv\u00e9 sur demande en fran\u00e7ais ou en anglais ","performers":"Une visite guid\u00e9e originale de Brussels By Foot","boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/art-nouveau-de-la-source-aux-etangs\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.510572"},"sp":{"name":"Art Nouveau : De la Source aux \u00c9tangs","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/art-nouveau-de-la-source-aux-etangs\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.510572"},"nl":{"name":"Art Nouveau : De la Source aux \u00c9tangs","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/art-nouveau-de-la