,"show_in_agenda":true,"ranking":0.14083339793634},{"id":533658,"date_start":"2022-05-22","date_end":"2022-05-29","date_next":"2022-05-22","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{"list":[249],"translations":{"fr":["Les incontournables "],"nl":["Highlights"],"en":["Highlights"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Promenade guid\u00e9e au Parlement Europ\u00e9en (gratuite)","shortdescr":"Cette promenade vous fera d\u00e9couvrir lefonctionnement et l'architecture du Parlement europ\u00e9en ainsi que la diversit\u00e9 des b\u00e2timents bordant l'h\u00e9miclycle tels que les jardins Wiertz, le parc L\u00e9opold, La Biblioth\u00e8que Solvay et la Maison de l'histoire europ\u00e9enne.","longdescr":"Cette promenade vous fera d\u00e9couvrir lefonctionnement et l'architecture du Parlement europ\u00e9en ainsi que la diversit\u00e9 des b\u00e2timents bordant l'h\u00e9miclycle tels que les jardins Wiertz, le parc L\u00e9opold, La Biblioth\u00e8que Solvay et la Maison de l'histoire europ\u00e9enne.\nCes visites gratuites ont lieu tous les dimanches du 17 avril au 30 octobre 2022 et les r\u00e9servations se font directement sur le site du Parlement Europ\u00e9en.\nVisites en N\u00e9erlandais \u00e0 10h, en fran\u00e7ais \u00e0 11h, en anglais \u00e0 12h et 15h, et en allemand \u00e0 14h.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.arkadia.be","email":"info@arkadia.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/533658.html"},"nl":{"name":"Promenade guid\u00e9e au Parlement Europ\u00e9en (gratuite)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.arkadia.be","email":"info@arkadia.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/533658.html"},"en":{"name":"Promenade guid\u00e9e au Parlement Europ\u00e9en (gratuite)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.arkadia.be","email":"info@arkadia.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/533658.html"},"de":{"name":"Promenade guid\u00e9e au Parlement Europ\u00e9en (gratuite)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/533658.html"},"it":{"name":"Promenade guid\u00e9e au Parlement Europ\u00e9en (gratuite)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/533658.html"},"sp":{"name":"Promenade guid\u00e9e au Parlement Europ\u00e9en (gratuite)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/533658.html"},"pt":{"name":"Promenade guid\u00e9e au Parlement Europ\u00e9en (gratuite)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/533658.html"},"cn":{"name":"Promenade guid\u00e9e au Parlement Europ\u00e9en (gratuite)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/533658.html"}},"place":{"id":266898,"translations":{"fr":{"name":"Station Europe","address_street_name":"Place du Luxembourg","address_street_number":"100","address_street_box":null,"email":"visit@europarl.europa.eu","website":"http:\/\/www.europarl.europa.eu\/visiting\/fr\/brussels\/station-europe","phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Place du Luxembourg, 100","address_line2":"1050 Ixelles","description_web":"FERMEE AUX VISITEURS JUSQU'A NOUVEL ORDRE.\r\nLa Station Europe, situ\u00e9e sur la tr\u00e8s anim\u00e9e place du Luxembourg, est le point de d\u00e9part id\u00e9al pour d\u00e9couvrir l'Europe \u00e0 Bruxelles. \r\nLe point d'accueil du Parlement europ\u00e9en met \u00e0 votre disposition de nombreux outils interactifs qui piqueront votre curiosit\u00e9 quel que soit votre \u00e2ge. Un personnel accueillant est \u00e9galement \u00e0 votre disposition pour vous montrer tout ce qu'il y a \u00e0 faire au Parlement europ\u00e9en, et \u00e0 Bruxelles.\r\nLog\u00e9e dans l\u2019ancienne gare de Bruxelles-Luxembourg, la Station Europe fait le lien entre le pass\u00e9 de cet emplacement, et son r\u00f4le moderne de foyer de la d\u00e9mocratie europ\u00e9enne.\r\n* Gratuit\r\n* Disponible en 24 langues\r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Station Europa","address_street_name":"Luxemburgplein","address_street_number":"100","address_street_box":null,"email":"visit@europarl.europa.eu","website":"http:\/\/www.europarl.europa.eu\/visiting\/nl\/brussels\/station-europe","phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"Luxemburgplein, 100","address_line2":"1050 Elsene","description_web":"VOORLOPIG GESLOTEN VOOR BEZOEKERS\r\nStation Europa ligt op het bruisende Luxemburgplein. Het is het ideale vertrekpunt voor je Europese tocht in Brussel. \r\nInteractieve tools zetten je op weg. Het vriendelijk onthaalpersoneel dat je info geeft over het Europees parlement \u00e9n Brussel krijg je er gratis bij!\r\nStation Europa is ondergebracht in het voormalige stationsgebouw van Brussel-Luxemburg. Het legt perfect de link tussen verleden en heden.\r\nHier zie je het Europees Parlement tot leven komen aan de hand van augmented reality. Duik bij de touchscreentafels in de geschiedenis van het Europees Parlement.  Treed in de voetsporen van je favoriete, inspirerende persoonlijkheden. Diorama's werpen zelfs een blik in het verleden en tonen je het Europees Parlement in verschillende periodes. \r\nStation Europa is ook de ideale toegangspoort tot Brussel. Want visit.brussels geeft je er een voorsmaakje van het beste wat Brussel heeft te bieden. \r\nJe bent meer dan welkom!   \r\n* gratis\r\n * in 24 talen \r\n\r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Station Europe","address_street_name":"Place du Luxembourg","address_street_number":"100","address_street_box":null,"email":"visit@europarl.europa.eu","website":"http:\/\/www.europarl.europa.eu\/visiting\/en\/brussels\/station-europe","phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Place du Luxembourg, 100","address_line2":"1050 Ixelles","description_web":"CLOSED TO VISITORS UNTIL FURTHER NOTICE.\r\nStation Europe, on the very lively place du Luxembourg, is the ideal starting point for seeing Europe in Brussels.\r\nThe European Parliament's visitors' centre has a number of interactive tools that will pique your curiosity, whatever your age. Friendly staff are also on hand to show you everything there is to do at the European Parliament and in Brussels itself.\r\nHoused in the original Brussels-Luxembourg train station building, Station Europe is the perfect bridge between the area\u2019s past and its modern role as the home of European democracy.\r\n* Free\r\n* Available in 24 languages\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Station Europe","address_street_name":"Place du Luxembourg","address_street_number":"100","address_street_box":null,"email":"visit@europarl.europa.eu","website":"http:\/\/www.europarl.europa.eu\/visiting\/fr\/brussels\/station-europe","phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Place du Luxembourg, 100","address_line2":"1050 Ixelles","description_web":"\u201eStation Europe\u201c ist der ideale Ausgangspunkt f\u00fcr Besucher, die sich einen spannenden und fundierten Einblick \u00fcber das Thema Europa in Br\u00fcssel verschaffen m\u00f6chten. Untergebracht ist \u201eStation Europe\u201c in dem ehemaligen Bahnhof Bruxelles-Luxembourg, direkt an dem belebten Place du Luxembourg. Die Mitarbeiter der Br\u00fcsseler Tourismusagentur visit.brussels stehen Besuchern mit Tipps und Informationen \u00fcber das Europ\u00e4ische Parlament im Speziellen und die Stadt Br\u00fcssel im Allgemeinen zur Verf\u00fcgung.\r\nVerschiedene interaktive Angebote geben dem Besucher eine kleine Einstimmung auf das, was ihn im EU-Viertel erwartet: So wird das EU-Parlament anhand eines \u201eAugmented Reality\u201c-Modells des Campus zum Leben erweckt. Nehmen Sie an den Touchscreen-Tischen Platz, tauchen Sie ein in die Geschichte des EU-Parlaments oder gehen Sie auf Tuchf\u00fchlung mit den historischen Pers\u00f6nlichkeiten, die hier eine zentrale Rolle gespielt haben. Anhand von Dioramen treten Sie eine spannende Reise in die Vergangenheit an und k\u00f6nnen das Europ\u00e4ische Parlament aus unterschiedlichen Blickwinkeln und zu verschiedenen Zeitpunkten seines Bestehens betrachten. \r\nDar\u00fcber hinaus ist \u201eStation Europe\u201c eine erste Anlaufstation f\u00fcr Besucher in Br\u00fcssel, denn visit.brussels pr\u00e4sentiert hier eine Auswahl der besten Sehensw\u00fcrdigkeiten und Attraktionen der belgischen Hauptstadt, insbesondere auch im Hinblick auf andere europ\u00e4ische Institutionen und das EU-Viertel insgesamt.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Station Europe","address_street_name":"Place du Luxembourg","address_street_number":"100","address_street_box":null,"email":"visit@europarl.europa.eu","website":"http:\/\/www.europarl.europa.eu\/visiting\/fr\/brussels\/station-europe","phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Place du Luxembourg, 100","address_line2":"1050 Ixelles","description_web":"Station Europe, sulla vivace Place du Luxembourg, \u00e8 il punto di partenza ideale per vedere l\u2019Europa a Bruxelles.. Il centro di accoglienza del Parlamento Europeo \u00e8 ricco di strumenti interattivi e ha di che stuzzicare la curiosit\u00e0 a tutte le et\u00e0. Personale cordiale \u00e8 a disposizione per mostrarvi tutto quello che c\u2019\u00e8 da fare al Parlamento Europeo e a Bruxelles stessa.. \r\n \r\nSituato nella palazzina originale della stazione Bruxelles-Lussemburgo, Station Europe collega perfettamente il passato di quest\u2019area, come Quartiere Leopold, e il suo ruolo moderno come casa della democrazia europea. \r\n  \r\nGuardate come il Parlamento Europeo diventa realt\u00e0 attraverso un modello del campus in 3D. Si pu\u00f2 anche guardare al passato attraverso riproduzioni in scala visibili da uno spioncino e vedere il Parlamento Europeo da diverse prospettive in momenti diversi della sua esistenza.   \r\nStation Europe \u00e8 anche una porta aperta su Bruxelles con visit.brussels a portata di mano per dare un assaggio di tutto ci\u00f2 che c\u2019\u00e8 da fare nella capitale belga. \r\n  \r\nUn caloroso benvenuto vi aspetta!\r\n  \r\n* Gratuito\r\n* Disponibile in 24 lingue\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Estaci\u00f3n Europa","address_street_name":"Place du Luxembourg","address_street_number":"100","address_street_box":null,"email":"visit@europarl.europa.eu","website":"http:\/\/www.europarl.europa.eu\/visiting\/en\/brussels\/station-europe","phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Place du Luxembourg, 100","address_line2":"1050 Ixelles","description_web":"La estaci\u00f3n Europa (\u201cStation Europe\u201d) est\u00e1 situada en la animada plaza de Luxemburgo y es el punto de partida ideal para ver Europa en Bruselas. Este punto de bienvenida del Parlamento Europeo est\u00e1 lleno de herramientas interactivas y tiene algo para despertar la curiosidad de todas las edades. El amable personal tambi\u00e9n est\u00e1 disponible para mostrarle no solo todo lo que hay que hacer en el Parlamento Europeo sino tambi\u00e9n en la propia Bruselas.\r\n  \r\nUbicada en el edificio original de la estaci\u00f3n de tren de Bruselas-Luxemburgo, la estaci\u00f3n Europa (\u201cStation Europe\u201d) une perfectamente el pasado de la zona cuando solo era el Barrio Leopold, con su papel moderno como hogar de la democracia europea.\r\n\r\nVea c\u00f3mo el Parlamento Europeo cobra vida con una maqueta del campus. Incluso puede mirar al pasado con dioramas de mirilla y ver el Parlamento Europeo desde diferentes \u00e1ngulos, en diferentes momentos de su vida.\r\n  \r\nLa estaci\u00f3n Europa es tambi\u00e9n su puerta de entrada a Bruselas ya que la oficina de turismo de visit.brussels se encuentra tambi\u00e9n all\u00ed para darle una idea de todo lo que hay que hacer en la capital belga. \u00a1Le espera una c\u00e1lida bienvenida!\r\n  \r\n* Gratuito\r\n* Disponible en 24 idiomas\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Station Europe","address_street_name":"Place du Luxembourg","address_street_number":"100","address_street_box":null,"email":"visit@europarl.europa.eu","website":"http:\/\/www.europarl.europa.eu\/visiting\/fr\/brussels\/station-europe","phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Place du Luxembourg, 100","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Station Europe","address_street_name":"Place du Luxembourg","address_street_number":"100","address_street_box":null,"email":"visit@europarl.europa.eu","website":"http:\/\/www.europarl.europa.eu\/visiting\/fr\/brussels\/station-europe","phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Place du Luxembourg, 100","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[9],"translations":{"fr":["Quartier europ\u00e9en"],"nl":["Europese wijk"],"en":["European Quarter"]}},"zones":{"list":[22],"translations":{"fr":["Est"],"nl":["Oost"],"en":["East"]}},"neca":null,"facebook_id":null,"backoffice_id":26898,"location":{"lat":50.83914868,"lon":4.3736068},"region":"brussels","last_updated_at":"2022-05-17T04:05:40+02:00","published_at":"2016-12-14T09:03:56+01:00","import_origin":null,"external_id":null,"is_in_address_book":false,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":1487,"translations":{"fr":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"http:\/\/www.arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Arkadia","address_street_name":"Naamsestraat","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"http:\/\/www.arkadia.be","phone_contact