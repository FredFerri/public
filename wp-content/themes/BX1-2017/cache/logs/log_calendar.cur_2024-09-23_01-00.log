blished_at":"2024-08-30T13:13:47+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":306826,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"concert","ranking":1.2599210498948732,"languages":{"spoken":["fr","en"],"subtitles":[]},"categories":{"main":{"id":1,"translations":{"de":"Konzert","pt":null,"en":"Concert","it":"Concerti","cn":null,"fr":"Concert","sp":"Concierto","nl":"Concert"}},"others":{}},"translations":{"de":{"name":"Andrei Irimia - Lights & Shadows - Live in Brussels","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.andreiirimia.com\/live","email":"andrada@andreiirimia.com","phone_contact":"0040720005015","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700000731"},"pt":{"name":"Andrei Irimia - Lights & Shadows - Live in Brussels","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.andreiirimia.com\/live","email":"andrada@andreiirimia.com","phone_contact":"0040720005015","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700000731"},"en":{"name":"Andrei Irimia - Lights & Shadows - Live in Brussels","shortdescr":"Pr\u00e9parez-vous pour une soir\u00e9e envo\u00fbtante avec Andrei Irimia qui pr\u00e9sentera son spectacle captivant \"Lumi\u00e8res & Ombres\" \u00e0 Bruxelles . Rejoignez-nous dans le cadre intimiste du Baixu pour une nuit remplie de musique qui touchera votre \u00e2me. Ne manquez pas cette exp\u00e9rience unique - prenez vos billets d\u00e8s maintenant et pr\u00e9parez-vous \u00e0 \u00eatre captiv\u00e9 par le talent d'Andrei Irimia !","longdescr":"\"Andrei Irimia est un pianiste et compositeur roumain, un nouveau venu du mouvement n\u00e9oclassique qui \u00e9merge actuellement en Europe.\n\nAndrei cr\u00e9e une musique n\u00e9oclassique hypnotique, envo\u00fbtante et m\u00e9lancolique pour piano et cordes. Ses m\u00e9lodies d\u00e9licates apaisent l'\u00e2me en ces temps troubl\u00e9s et r\u00e9sonnent parfaitement avec le public.\n\nAvec une pr\u00e9sence croissante sur tous les r\u00e9seaux sociaux, Andrei Irimia est devenu l'un des compositeurs de piano contemporains les plus appr\u00e9ci\u00e9s de Roumanie.\n\n\"Les m\u00e9lodies \u00e9taient \u00e0 la fois apaisantes et cristallines, m\u00e9ticuleuses dans leur structure et impr\u00e9gn\u00e9es d'une r\u00e9sonance qui se faisait sentir longtemps apr\u00e8s la fin de la musique.\" beatsperminute.com\n\nIl a pr\u00e9sent\u00e9 son premier album, 'Nuit Minimaliste', en 2019 \u2014 un hommage \u00e0 la m\u00e9lancolie et \u00e0 la nonchalance a\u00e9rienne de la musique minimaliste fran\u00e7aise. En 2023, il a d\u00e9voil\u00e9 sa derni\u00e8re \u0153uvre, 'All Strings Attached', une fusion captivante de rythmes \u00e9lectroniques avec des instruments \u00e0 cordes n\u00e9oclassiques et un piano.\n\n\"Un musicien et compositeur pas comme les autres.\" yorkcalling.co.uk\n\nIl a effectu\u00e9 une fantastique tourn\u00e9e europ\u00e9enne en 2023, d\u00e9butant par une performance remarquable au festival Eurosonic aux Pays-Bas, o\u00f9 il a partag\u00e9 la sc\u00e8ne avec les talentueux Eyd\u00eds Evensen, Svaneborg Kardyb et Joep Beving. Il a ensuite fait des apparitions m\u00e9morables au festival SZIGET en Hongrie, \u00e0 Jazz in The Park en Roumanie, et dans diverses salles philharmoniques \u00e0 travers la Roumanie, avec d'autres \u00e9tapes captivantes pr\u00e9vues en cours de route.","performers":" Andrei Irimia,  pianiste et compositeur roumain avec ses coll\u00e8gues Thibault Solorzano, violoncelliste fran\u00e7ais originaire d'Angers,  R\u0103zvan P\u0103un, talentueux violoniste roumain.\n\nCe concert est soutenu et financ\u00e9 par l'A.F.C.N. et vise \u00e0 enrichir le paysage culturel de la Roumanie, tout en promouvant la mobilit\u00e9 culturelle europ\u00e9enne.","boxoffice_url":null,"website":"http:\/\/www.andreiirimia.com\/live","email":"andrada@andreiirimia.com","phone_contact":"0040720005015","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700000731"},"it":{"name":"Andrei Irimia - Lights & Shadows - Live in Brussels","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.andreiirimia.com\/live","email":"andrada@andreiirimia.com","phone_contact":"0040720005015","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700000731"},"cn":{"name":"Andrei Irimia - Lights & Shadows - Live in Brussels","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.andreiirimia.com\/live","email":"andrada@andreiirimia.com","phone_contact":"0040720005015","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700000731"},"fr":{"name":"Andrei Irimia - Lights & Shadows - Live in Brussels","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.andreiirimia.com\/live","email":"andrada@andreiirimia.com","phone_contact":"0040720005015","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700000731"},"sp":{"name":"Andrei Irimia - Lights & Shadows - Live in Brussels","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.andreiirimia.com\/live","email":"andrada@andreiirimia.com","phone_contact":"0040720005015","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700000731"},"nl":{"name":"Andrei Irimia - Lights & Shadows - Live in Brussels","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.andreiirimia.com\/live","email":"andrada@andreiirimia.com","phone_contact":"0040720005015","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700000731"}},"place":{"id":279109,"translations":{"de":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"contact@lebaixu.com","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"contact@lebaixu.com","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"contact@lebaixu.com","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue Picard, 3","address_line2":"1000 Brussels","description_web":"The name \u201cBaixu\u201d means \u201cbeautiful\u201d in the native language of the Patax\u00f3 peoples, indigenous to the south of the state of Bahia in Brazil. This word represents both the ambition of the project and the quality of the cultural events presented, as well as the founders\u2019 attachment to Brazilian culture. Baisu is a quaint and welcoming space in the Tour & Taxis neighborhood in Brussels, which hosts concerts, expositions, screenings, or conferences \u2013 or where you can organise your private event.\r\nA project dedicated to \u201cbeauty\u201d in all its forms, where the keywords are quality, exchange and interaction.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"contact@lebaixu.com","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"contact@lebaixu.com","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"contact@lebaixu.com","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard, 3","address_line2":"1000 Bruxelles","description_web":"Un lieu atypique et chaleureux dans le quartier de Tour & Taxis \u00e0 Bruxelles pour assister \u00e0 des concerts, des expositions, des projections ou des conf\u00e9rences, ou pour y organiser vos \u00e9v\u00e8nements priv\u00e9s.\r\nUn projet d\u00e9di\u00e9 au \u00ab beau \u00bb sous toutes ses coutures, dont les maitres-mots sont qualit\u00e9, \u00e9changes et rencontres.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"contact@lebaixu.com","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Le Baixu","address_street_name":"Picardstraat","address_street_number":"3","address_street_box":null,"email":"contact@lebaixu.com","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Picardstraat, 3","address_line2":"1000 Brussel","description_web":"De naam \"Baixu\" betekent \"mooi\" in de taal van de Pataxos indianen die in de zuidelijke staat Bahia (Brazili\u00eb) wonen. Dit woord staat voor de ambitie van het project en de kwaliteit van de culturele evenementen, maar ook voor de verbondenheid van de initiatiefnemers met de Braziliaanse cultuur. \r\nLe Baixu is ondergebracht in een voormalig industrieel gebouw in het hart van de trendy Brusselse Tour & Taxis wijk. Een atypische en warme plek bedoeld voor concerten, tentoonstellingen, filmvertoningen en conferenties en waar je ook priv\u00e9 evenementen kan organiseren. Het is een volledig uitgeruste, multidisciplinaire culturele ruimte met een oppervlakte van 150 m2, gewijd aan de \"schoonheid\" in al haar vormen. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[8],"translations":{"de":["Kanal-Viertel"],"pt":[null],"en":["Canal"],"it":["Canal"],"cn":[null],"fr":["Canal"],"sp":["Canal"],"nl":["Kanaalwijk"]}},"zones":{"list":[20],"translations":{"de":["Norden"],"pt":[null],"en":["North"],"it":["Nord"],"cn":[null],"fr":["Nord"],"sp":["Norte"],"nl":["