itors\/agenda\/event-detail.5700006602"},"it":{"name":"SOIF D'ID\u00c9AL - Festival du Film d'\u00c9ducation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.cemea.be","email":"festival@cemea.be","phone_contact":"+32 2 543 05 93","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700006602"},"cn":{"name":"SOIF D'ID\u00c9AL - Festival du Film d'\u00c9ducation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.cemea.be","email":"festival@cemea.be","phone_contact":"+32 2 543 05 93","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700006602"},"fr":{"name":"SOIF D'ID\u00c9AL - Festival du Film d'\u00c9ducation","shortdescr":"Du 18 au 22 mars 2025 \u00e0 Ixelles, le festival Soif d\u2019Id\u00e9al  revient pour sa 9\u1d49 \u00e9dition et vous invite \u00e0 d\u00e9couvrir une s\u00e9lection de films et d\u00e9bats engag\u00e9s sur plusieurs th\u00e8mes autour de l\u2019\u00e9ducation et la soci\u00e9t\u00e9. Un \u00e9v\u00e8nement gratuit pour s\u2019interroger, \u00e9changer et r\u00e9inventer le monde ensemble ! ","longdescr":"Le festival SOIF D\u2019ID\u00c9AL - Festival du Film d\u2019\u00c9ducation revient pour sa 9\u1d49 \u00e9dition du 18 au 22 mars 2025 au th\u00e9\u00e2tre Mercelis \u00e0 Ixelles pour cinq jours de projections, d\u00e9bats et rencontres autour des grandes questions \u00e9ducatives et sociales de notre \u00e9poque. \n\nQue ce soit le temps d\u2019une s\u00e9ance, d\u2019une apr\u00e8s-midi ou d\u2019une journ\u00e9e, ce festival port\u00e9 par les CEM\u00c9A propose une programmation qui bouscule les id\u00e9es re\u00e7ues et ouvre de nouvelles perspectives. Films engag\u00e9s, rencontres et discussions collectives : autant d\u2019occasions de pousser d\u2019autres portes, de repenser le cadre et de faire bouger les lignes.\n\nSOIF D'ID\u00c9AL ouvre des espaces de r\u00e9flexion sur des th\u00e8mes vari\u00e9s : \u00e9cole, \u00e9galit\u00e9 des genres, inclusion, petite enfance, environnement, num\u00e9rique, travail, handicap\u2026 Un rendez-vous culturel et citoyen, enti\u00e8rement gratuit, accessible \u00e0 toutes et tous !\n\nEn ouverture du festival, le Centre vid\u00e9o de Bruxelles proposera, en avant-premi\u00e8re, le documentaire de Doroth\u00e9e Bouillon, \u00ab Travail soign\u00e9 \u00bb, autour d'une maison m\u00e9dicale de quartier \u00e0 Li\u00e8ge. Autre format, autre th\u00e9matique avec la projection, durant la semaine, de l'int\u00e9gralit\u00e9 de \u00ab Ceux qui rougissent \u00bb, s\u00e9rie prim\u00e9e dans laquelle une dizaine d'\u00e9tudiant-e-s en option th\u00e9\u00e2tre voient d\u00e9barquer un professeur rempla\u00e7ant pour un mois. \n\nDeux particularit\u00e9s de cette \u00e9dition concernent la mise en place, en partenariat avec la revue Surimpression et l'\u00c9cole Plurielle Maritime, d'un atelier \u00ab Jeune critique \u00bb. Et aussi la possibilit\u00e9 de (re)d\u00e9couvrir l'exposition de l'asbl article 27 intitul\u00e9e \u00ab 27 portraits \u00bb, r\u00e9alis\u00e9e par le photographe Arnaud Ghys.\n\n\u00ab SOIF D'ID\u00c9AL \u00bb accueille un public particuli\u00e8rement large : \u00e9l\u00e8ves et professeurs, \u00e9tudiant-e-s, enseignant-e-s en devenir, demandeurs-demandeuses d'emploi, familles, retrait\u00e9-e-s, citoyen-ne-s. Une invitation \u00e0 se rencontrer, \u00e0 travers des moments formels et informels, parfois surprenants ou improbables afin de r\u00e9inventer le futur. \n\nPour voir le teaser de la derni\u00e8re \u00e9dition: http:\/\/ln.cemea.org\/H9xL8mtS\n\nLe festival est gratuit, mais il est recommand\u00e9 de vous inscrire sur notre site: www.cemea.be. Vous y trouverez  aussi la programmation compl\u00e8te.\n\nAvec le soutien de la la Nationale Loterij \/ Loterie Nationale et de la Commune d'Ixelles. En partenariat avec La Premi\u00e8re.\n\n","performers":null,"boxoffice_url":null,"website":"http:\/\/www.cemea.be","email":"festival@cemea.be","phone_contact":"+32 2 543 05 93","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700006602"},"sp":{"name":"SOIF D'ID\u00c9AL - Festival du Film d'\u00c9ducation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.cemea.be","email":"festival@cemea.be","phone_contact":"+32 2 543 05 93","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700006602"},"nl":{"name":"SOIF D'ID\u00c9AL - Festival du Film d'\u00c9ducation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.cemea.be","email":"festival@cemea.be","phone_contact":"+32 2 543 05 93","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700006602"}},"place":{"id":50000939,"translations":{"de":{"name":"Th\u00e9\u00e2tre Mercelis","address_street_name":"Rue Mercelis","address_street_number":"13","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Mercelis, 13","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Th\u00e9\u00e2tre Mercelis","address_street_name":"Rue Mercelis","address_street_number":"13","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Mercelis, 13","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Mercelis theatre","address_street_name":"Mercelisstraat","address_street_number":"13","address_street_box":null,"email":null,"website":null,"ph