a qu\u00eate de l\u2019harmonie entre le Far West, le negro spiritual, le jazz et les plus beaux mots d\u2019amour !\r\n\r\nCe style, joyeux et romantique, adapte une certaine facette de la culture des \u00c9tats-Unis au tournant du 20e si\u00e8cle en une exploration ethno socio-musico-historique de diverses musiques populaires am\u00e9ricaines: pop, swing, blues, country, gospel, work-song, com\u00e9dies musicales, classiques de Disney.","performers":"Matthieu Collard; Catherine Tilman; Fran\u00e7ois Lourtie; David Serraz; Emmanuel Donnet; Leander Moens","boxoffice_url":null,"website":"http:\/\/kidzik.be","email":"info@kidzik.be","phone_contact":"+32 10 23 74 14","phone_booking":"+32 10 23 74 14","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.551829"},"nl":{"name":"Les rossignols de l'ouest","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/lamaisonquichante.be","email":"info@kidzik.be","phone_contact":"+32 10 23 74 14","phone_booking":"+32 492 86 68 98","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.551829"},"en":{"name":"Les rossignols de l'ouest","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/kidzik.be","email":"info@kidzik.be","phone_contact":"+32 10 23 74 14","phone_booking":"+32 10 23 74 14","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.551829"},"de":{"name":"Les rossignols de l'ouest","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/kidzik.be","email":"info@kidzik.be","phone_contact":"+32 10 23 74 14","phone_booking":"+32 10 23 74 14","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.551829"},"it":{"name":"Les rossignols de l'ouest","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/kidzik.be","email":"info@kidzik.be","phone_contact":"+32 10 23 74 14","phone_booking":"+32 10