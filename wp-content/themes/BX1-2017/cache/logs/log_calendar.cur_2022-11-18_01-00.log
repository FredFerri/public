":"Artikel 27"},"en":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"visit_profile":{"list":[321,337],"translations":{"fr":["Bande Dessin\u00e9e","Highlight"],"nl":["Stripverhaal","Highlight"],"en":["Comic strip","Highlight"],"de":["Comic","Highlight"]}},"tags":[],"accessibilities":{"list":[252,255,256,257,259,263,265],"translations":{"fr":["Accessible aux personnes ayant des difficult\u00e9s de compr\u00e9hension","Accessible","Am\u00e9nagements pour les personnes aveugles et malvoyantes","Am\u00e9nagements pour personnes sourdes et malentendantes","Chien d'assistance","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9"],"nl":["Toegankelijk voor mensen met een verstandelijke beperking","Toegankelijk","Voorzieningen voor blinde en slechtziende personen","Voorzieningen voor dove en slechthorende personen","Assistentiehonden","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet"],"en":["Accessible to people with intellectual disabilities","Accessible","Facilities for blind and partially-sighted persons","Facilities for deaf and hearing-impaired people","Assistance dogs","Accessible to pedestrians with mobility aids","Adapted toilet"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-11-17T01:35:29+01:00","published_at":"2022-05-17T12:21:04+02:00","backoffice_id":253834,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.38380548976378},{"id":543605,"date_start":"2022-10-20","date_end":"2023-08-15","date_next":"2022-11-17","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung"}},"others":{"list":[36,47],"translations":{"fr":["Mus\u00e9es et art centers","Bande dessin\u00e9e"],"nl":["Musea en kunstcentra","Stripverhaal"],"en":["Museums and art centers","Comicstrip"],"de":["Museen & Kunstzentren","Comics"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Carr\u00e9ment Poilu","shortdescr":"Chaque matin, Petit Poilu s'\u00e9veille, passe d'urgence \u00e0 la toilette o\u00f9 le WC est trop grand pour lui. Puis il avale son petit d\u00e9jeuner, fait la bise \u00e0 sa maman et s'en va gaillardement sur le chemin de l'\u00e9cole. De l'\u00e9cole ? Rien n'est moins s\u00fbr, car l'aventure l'attend au coin de la rue.","longdescr":"Chaque matin, Petit Poilu s'\u00e9veille, passe d'urgence \u00e0 la toilette o\u00f9 le WC est trop grand pour lui. Puis il avale son petit d\u00e9jeuner, fait la bise \u00e0 sa maman et s'en va gaillardement sur le chemin de l'\u00e9cole. De l'\u00e9cole ? Rien n'est moins s\u00fbr, car l'aventure l'attend au coin de la rue.\r\n\r\nCette trame immuable, d\u00e9clin\u00e9e dans des variantes chaque fois diff\u00e9rentes, est l'invention du dessinateur Pierre Bailly et de la sc\u00e9nariste C\u00e9line Fraipont qui ont cr\u00e9\u00e9 une BD enti\u00e8rement muette et accessible d\u00e8s l'\u00e2ge de 3 ans. \r\n\r\nHaute en couleurs, cette exposition ludique propose aux plus jeunes de grimper, sauter, ramper et plonger de case en case, en s\u2019immergeant dans des ambiances \u00e0 chaque fois diff\u00e9rentes, comme Petit Poilu lui-m\u00eame.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.cbbd.be\/fr\/expositions\/les-grandes-expositions-temporaires\/carrement-poilu","email":"visit@cbbd.be","phone_contact":"+32 2 219 19 80","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.543605"},"nl":{"name":"Ronduit Stoppeltje","shortdescr":"Elke ochtend staat Stoppeltje op, spurt hij naar het toilet waar de wc-bril natuurlijk veel te groot is voor zijn kleine billen, verorbert vlug zijn ontbijt, geeft zijn mama een dikke kus en vertrekt vrolijk naar school. Naar school? Niets is minder waar, want om elke hoek wacht een nieuw avontuur.","longdescr":"Elke ochtend staat Stoppeltje op, spurt hij naar het toilet waar de wc-bril natuurlijk veel te groot is voor zijn kleine billen, verorbert vlug zijn ontbijt, geeft zijn mama een dikke kus en vertrekt vrolijk naar school. Naar school? Niets is minder waar, want om elke hoek wacht een nieuw avontuur. \r\n\r\nDeze vaste verhaallijn, die telkens anders wordt ingevuld, is een vondst van tekenaar Pierre Bailly en scenarist C\u00e9line Fraipont, die samen een strip zonder tekst cre\u00eberden voor jonge lezers vanaf 3 jaar.  \r\n\r\nEen kleurrijke opstelling nodigt de kleinsten uit om te klimmen, springen en kruipen van het ene vakje naar het andere, waarbij ze, net als Stoppeltje, telkens opnieuw worden ondergedompeld in een nieuw avontuur.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.stripmuseum.be\/nl\/tentoonstellingen\/tijdelijke-tentoonstellingen\/ronduit-stoppeltje","email":"visit@stripmuseum.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.543605"},"en":{"name":"Squarely Furry","shortdescr":"Little Furry wakes up every morning and hurries to the toilet which is far too big for him. He then hurriedly tucks into his breakfast, gives his mummy a kiss, and then briskly walks to school. To school? There is nothing more uncertain, as adventure awaits him on the corner of the street.","longdescr":"Little Furry wakes up every morning and hurries to the toilet which is far too big for him. He then hurriedly tucks into his breakfast, gives his mummy a kiss, and then briskly walks to school. To school? There is nothing more uncertain, as adventure awaits him on the corner of the street.\r\n\r\nThis unchanging pattern, with different variations each time, is the invention of comic artist Pierre Bailly and scriptwriter C\u00e9line Fraipont, who have created a completely wordless comic book accessible to children from the age of 3.\r\n\r\nHighly colourful, this playful exhibition invites children to climb, jump, hide and crawl, from one panel to the next, immersing themselves in a different adventure each time, just like Little Furry.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.comicscenter.net\/en\/exhibitions\/the-great-temporary-exhibitions\/squarely-furry","email":"visit@comicscenter.net","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.543605"},"de":{"name":"Carr\u00e9ment Poilu","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.543605"},"it":{"name":"Carr\u00e9ment Poilu","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.543605"},"sp":{"name":"Carr\u00e9ment Poilu","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.543605"},"pt":{"name":"Carr\u00e9ment Poilu","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.543605"},"cn":{"name":"Carr\u00e9ment Poilu","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.543605"}},"place":{"id":202864,"translations":{"fr":{"name":"Mus\u00e9e de la Bande Dessin\u00e9e (Centre Belge de la Bande Dessin\u00e9e)","address_street_name":"Rue des Sables","address_street_number":"20","address_street_box":null,"email":"visit@cbbd.be","website":"http:\/\/www.cbbd.be","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Sables, 20","address_line2":"1000 Bruxelles","description_web":"Attraction incontournable situ\u00e9e au c\u0153ur de Bruxelles, le mus\u00e9e de la BD met \u00e0 l'honneur depuis plus de 25 ans auteurs et h\u00e9ros du 9\u00e8me Art. \r\n\r\nLes expositions permanentes r\u00e9guli\u00e8rement renouvel\u00e9es et un vaste programme d'expositions temporaires am\u00e8nent les visiteurs \u00e0 d\u00e9couvrir les innombrables facettes de la bande dessin\u00e9e. Tintin et les Schtroumpfs ouvrent la voie vers d'autres aventures, \u00e0 la rencontre d'un monde dont la cr\u00e9ativit\u00e9 n'a aucune limite. \r\n\r\nMagnifi\u00e9 par un exceptionnel cadre Art Nouveau con\u00e7u par Victor Horta, le Mus\u00e9e de la Bande Dessin\u00e9e est tout autant un hommage aux pionniers qu'un regard sur la BD actuelle.\r\n\r\nOuvert 7 jours sur 7, de 10h \u00e0 18h pendant les vacances scolaires belges.\r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Stripmuseum (Belgisch Stripcentrum)","address_street_name":"Zandstraat","address_street_number":"20","address_street_box":null,"email":"visit@stripmuseum.be","website":"http:\/\/www.stripmuseum.be","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Zandstraat, 20","address_line2":"1000 Brussel","description_web":"Het Stripmuseum is voor al wie Brussel bezoekt een \u2018must\u2019 in het hartje van de stad. Al meer dan 25 jaar richt het museum de spots op de auteurs en de helden van de Negende Kunst. \r\n\r\nAan de hand van permanente tentoonstellingen \u2013 die regelmatig vernieuwd worden \u2013 en een afwisselend programma van tijdelijke exposities kan je er als bezoeker kennismaken met de talrijke facetten van het stripverhaal. Kuifje en de Smurfen nemen je mee naar avonturenland, een wereld waar de creativiteit geen grenzen kent. \r\n\r\nHet uitzonderlijke art nouveau-gebouw van Victor Horta geeft een bezoek nog een extra dimensie. Het Stripmuseum is tegelijk een hommage aan de pioniers van het medium als een blik op het hedendaagse stripverhaal.\r\n\r\nOpen van maandag tot zondag van 10 uur tot 18 uur tijdens de Belgische schoolvakanties.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Comic Strip Museum  (Centre Belge de la Bande Dessin\u00e9e)","address_street_name":"Rue des Sables","address_street_number":"20","address_street_box":null,"email":"visit@comicscenter.net","website":"http:\/\/www.comicscenter.net\/en\/home","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue des Sables, 20","address_line2":"1000 Brussels","description_web":"An accomplished attraction located in the heart of Brussels, the Belgian Comic Strip Center has been honouring the creators and heroes of the 9th Art for more than 25 years.\r\n\r\nThe regularly renewed permanent exhibitions and a diversified programme of temporary exhibitions enable visitors to discover the countless aspects of comics art. Tintin and the Smurfs lead the way towards further adventures, an encounter with a world where creativity has no limits. \r\n\r\nEnhanced by an exceptional Art Nouveau home designed by Victor Horta, the Belgian Comic Strip Center is just as much a tribute to the pioneers as a glimpse of contemporary comics art.\r\n\r\nOpen every day (7\/7) in July and August and during Belgian school holidays.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Comic-Museum (Centre Belge de la Bande Dessin\u00e9e)","address_street_name":"Rue des Sables","address_street_number":"20","address_street_box":null,"email":"visit@cbbd.be","website":"https:\/\/www.comicscenter.net\/en\/other-languages","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Sables, 20","address_line2":"1000 Bruxelles","description_web":"Br\u00fcssel als Comic-Hauptstadt g\u00f6nnt sich den Luxus eines eigenen Comic-Museums - das \u201eCentre Belge de la Bande Dessin\u00e9e\u201c. In einem eindrucksvollen Jugendstil-Bau aus der Feder von Victor Horta wird belgische und internationale Comic-Kunst pr\u00e4sentiert. Willkommen im Reich der Schl\u00fcmpfe, bei Tim und Struppi, Lucky Luke, Spirou, Gaston Lagaffe und all den anderen Comic-Helden!\r\n\r\nComic-Kunst und Jugendstilarchitektur: Der ber\u00fchmte Jugendstilarchitekt Victor Horta entwarf 1903, auf dem H\u00f6hepunkt seines Schaffens, Pl\u00e4ne f\u00fcr ein weitl\u00e4ufiges Bauwerk in Br\u00fcssel. Nach der Renovierung 1989 lie\u00df sich in den R\u00e4umen, die in allen Bereichen durch Jugendstilelemente gepr\u00e4gt sind, das \u201eCentre Belge de la Bande Dessin\u00e9e\", das Belgische Comiczentrum nieder, bei dem sich auf einer Fl\u00e4che von mehr als 4000 m\u00b2 - von den Urspr\u00fcngen bis hin zu avantgardistischen Werken - alles um Comics dreht.\r\n\r\nBelgische Comic-Kunst in all ihren Formen: Ausstellungen, Konferenzen, Kreativ-Workshops, Veranstaltungen, eine eigene Comic-Bibliothek mit Dokumentationszentrum sowie eine gut sortierte Buchhandlung bilden ein vielseitiges und buntes Comicangebot. Zentrale Themen der Dauerausstellung sind die Erfindung der Comic-Kunst, die Formen und die Entwicklung der Comic-Kunst sowie verschiedene Schwerpunkt auf belgische Comic-K\u00fcnstler von Peyo, dem Vater der Schl\u00fcmpfe bis Herg\u00e9, dem Erfinder von Tim & Struppi.\r\n\r\nComic-Fans auf zum Br\u00fcsseler Comic-Mekka!\r\n\r\nGe\u00f6ffnet von Montag bis Sonntag in Juli und August.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Museo del Fumetto","address_street_name":"Rue des Sables","address_street_number":"20","address_street_box":null,"email":"visit@comicscenter.net","website":"https:\/\/www.comicscenter.net\/en\/other-languages","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Sables, 20","address_line2":"1000 Bruxelles","description_web":"Il Museo del Fumetto CBBD, situato nel cuore storico di Bruxelles, riunisce su pi\u00f9 di 4.000 m\u00b2 tutto ci\u00f2 che riguarda il fumetto. Ospitato in un edificio tempio dell'Art Nouveau disegnato da Victor Horta, il museo \u00e8 il regno di celebri eroi dei fumetti belgi: Tintin, i Puffi, Lucky Luke, Gaston Lagaffe, Blake et Mortimer, Marsupilami... Le esposizioni organizzate, la biblioteca e il centro di documentazione, non solo rendono il museo vivo e dinamico, ma sono veri e propri centri di documentazione sul fumetto il cuicatalogo \u00e8 accessibile on-line. Il centro belga del fumetto organizza conferenze, laboratori creativi ed animazioni, ecc.\r\n\r\n\r\nAperto i giorni festivi eccetto il 25\/12 e 01\/01. Il Centro Belga del Fumetto diverse formule di visita: la visita guidata del museo, quella del Percorso del Fumetto o quella del museo Marc Sleen. Il museo, anzi il centro belga del fumetto-CBBD ospita anche una brasserie dove potete respirare l'inconfondibile atmosfera di Bruxelles.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Centro belga del c\u00f3mic (CBBD)","address_street_name":"Rue des Sables","address_street_number":"20","address_street_box":null,"email":"visit@comicscenter.net","website":"https:\/\/www.comicscenter.net\/en\/other-languages","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Sables, 20","address_line2":"1000 Bruxelles","description_web":"Ubicado en el centro de Bruselas, en un edificio Art Nouveau construido por Victor Horta en 1906, el CBBD abri\u00f3 sus puertas el 6 de octubre de 1989. \r\n\r\nEn pocos a\u00f1os, este museo se ha convertido en una de las principales atracciones de Bruselas. \r\n\r\nCada a\u00f1o, m\u00e1s de 200.000 visitantes recorren las exposiciones permanentes y temporales que se celebran en m\u00e1s de 4.000 m 2. \r\n\r\nAunque las exposiciones contribuyen a convertir este templo en un lugar viviente, din\u00e1mico y atrayente, esta herramienta al servicio de la promoci\u00f3n del c\u00f3mic constituye un centro de documentaci\u00f3n moderno, con un cat\u00e1logo accesible online. \r\n\r\nTambi\u00e9n se llevan a cabo conferencias y talleres creativos.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"O Centro Belga da Banda Desenhada","address_street_name":"Rue des Sables","address_street_number":"20","address_street_box":null,"email":"visit@cbbd.be","website":"http:\/\/www.cbbd.be","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Sables, 20","address_line2":"1000 Bruxelles","description_web":"Atra\u00e7\u00e3o incontorn\u00e1vel situada no centro de Bruxelas, o museu da BD comemora mais de 25 anos de autores e her\u00f3is da 9.\u00aa arte.\r\nAs exposi\u00e7\u00f5es permanentes regularmente renovadas e um vasto programa de exposi\u00e7\u00f5es tempor\u00e1rias levam os visitantes a descobrir as in\u00fameras facetas da banda desenhada. Tintim e os Estrumpfes abrem a porta a outras aventuras, ao encontro de um mundo onde a criatividade n\u00e3o tem limites. \r\nAmpliado por uma moldura invulgar Arte Nouveau concebida por Victor Horta, o Museu da Banda Desenhada \u00e9 tanto uma homenagem aos pioneiros que um olhar sobre a BD atual.\r\nAberto todos os dias das 10 \u00e0s 18 horas.\r\nEntrada gratuita apenas com o Brussels Card \u201c100masters\u201d","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"The Belgian Comic Strip Center","address_street_name":"Rue des Sables","address_street_number":"20","address_street_box":null,"email":"visit@cbbd.be","website":"http:\/\/www.cbbd.be","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Sables, 20","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":[],"zones":{"list":[19],"translations":{"fr":["Centre"],"nl":["Centrum"],"en":["Centre"]}},"neca":null,"facebook_id":null,"backoffice_id":405,"location":{"lat":50.85107181,"lon":4.36006874},"region":"brussels","last_updated_at":"2022-11-17T01:06:53+01:00","published_at":"2013-10-19T01:13:30+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":202864,"translations":{"fr":{"name":"Mus\u00e9e de la Bande Dessin\u00e9e (Centre Belge de la Bande Dessin\u00e9e)","address_street_name":"Rue des Sables","address_street_number":"20","address_street_box":null,"email":"visit@cbbd.be","website":"http:\/\/www.cbbd.be","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Sables, 20","address_line2":"1000 Bruxelles","description_web":"Attraction incontournable situ\u00e9e au c\u0153ur de Bruxelles, le mus\u00e9e de la BD met \u00e0 l'honneur depuis plus de 25 ans auteurs et h\u00e9ros du 9\u00e8me Art. \r\n\r\nLes expositions permanentes r\u00e9guli\u00e8rement renouvel\u00e9es et un vaste programme d'expositions temporaires am\u00e8nent les visiteurs \u00e0 d\u00e9couvrir les innombrables facettes de la bande dessin\u00e9e. Tintin et les Schtroumpfs ouvrent la voie vers d'au