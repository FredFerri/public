"},"de":{"name":"Normal"},"it":{"name":"Normal"},"sp":{"name":"Normal"},"pt":{"name":"Normal"},"cn":{"name":"Normal"}},"value":28},{"translations":{"fr":{"name":"Seniors"},"nl":{"name":"Senioren"},"en":{"name":"Seniors"},"de":{"name":"Senioren"},"it":{"name":"Seniors"},"sp":{"name":"Seniors"},"pt":{"name":"Seniors"},"cn":{"name":"Seniors"}},"value":24},{"translations":{"fr":{"name":"Etudiants"},"nl":{"name":"Studenten"},"en":{"name":"Students"},"de":{"name":"Studierende"},"it":{"name":"Etudiants"},"sp":{"name":"Etudiants"},"pt":{"name":"Etudiants"},"cn":{"name":"Etudiants"}},"value":10},{"translations":{"fr":{"name":"Article 27"},"nl":{"name":"Artikel 27"},"en":{"name":"Article 27"},"de":{"name":"Article 27"},"it":{"name":"Article 27"},"sp":{"name":"Article 27"},"pt":{"name":"Article 27"},"cn":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":{"list":[255,261],"translations":{"fr":["Accessible","Parking accessible"],"nl":["Toegankelijk","Toegankelijke parking"],"en":["Accessible","Accessible parking"],"de":["Barrierefrei","Barrierefreier Parkplatz"],"it":[null,null],"sp":[null,null],"pt":[null,null],"cn":[null,null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-11-23T15:51:14+01:00","published_at":"2022-07-01T13:34:03+02:00","backoffice_id":257533,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":0.62144650119077},{"id":548045,"date_start":"2022-11-26","date_end":"2023-01-15","date_next":"2023-01-04","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung","it":null,"sp":null,"pt":null,"cn":null}},"others":{"list":[24,25],"translations":{"fr":["Galeries d'art","Arts audiovisuels"],"nl":["Galeries","Audiovisuele kunst"],"en":["Art Galleries","Audiovisual art"],"de":["Kunstgalerien","Audiovisuelle K\u00fcnste"],"it":[null,null],"sp":[null,null],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Goldorak XperienZ 1975-2023 Retrospective","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.facebook.com\/events\/5969904936374601\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.548045"},"nl":{"name":"Goldorak XperienZ 1975-2023 Retrospective","shortdescr":"De pionier van de Japanse anime\/manga, m.n. Goldorak, is in Brussel geland !\r\nKom originele schetsen, standbeelden, muziek, enz. ontdekken in de kelders van Tour & Taxis.\r\nVergeet ook niet het Toys Discovery Museum (speelgoed) en Pixel Museum (videogames) ernaast te bezoeken(!)","longdescr":"Na 2 succesvolle tentoonstellingen in Parijs (meer dan 25.000 bezoekers) in 2021 en in Lille in 2022, steekt de offici\u00eble en unieke retrospectieve ter wereld GOLDORAK XperienZ de grens over en landt van 26 november 2022 tot 15 januari in Tour & Taxis in Brussel 2023.\r\n\r\nIn overeenstemming met Dynamic Planning en Toei Animation biedt PRIME PROD aan om terug in de serie te duiken via plaatsen die zijn ontleend aan het universum: de planeet Euphor, het Research Center, de White Birch-ranch of het Black Moon Camp.\r\n\r\nIn de ondergrondse ruimtes van Tour & Taxis te Brussel, in samenwerking met het Toys Discovery Museum en Pixel Museum Brussels, ontdekt de bezoeker hoe de serie in Japan tot stand kwam aan de hand van originele productiedocumenten en presentaties van de belangrijkste ambachtslieden, te beginnen met beroemde mangaka Ga Nagai. Dit is een gelegenheid om de thema's en referenties in de afleveringen aan te pakken. Nadat de gigantische robot een heel tijdperk heeft gemarkeerd, zullen we ook emblematische voorwerpen uit de jaren 1970 en 1980 ontdekken: afgeleide producten, speelgoed, platen... \r\n\r\nTen slotte heeft de serie door zijn succes een enorme impact gehad op de generaties die hij heeft gewiegd. De kans om zijn invloed met hedendaagse kunstenaars te tonen.\r\nIn de loop der jaren werd Grendizer uiteindelijk het startpunt voor een trend die later het 'manga-fenomeen' werd genoemd. Tegenwoordig is dit aspect van de Japanse popcultuur een belangrijk onderdeel geworden van de vele culturele uitwisselingen tussen Frankrijk en Japan.\r\nDeze offici\u00eble, originele retrospectieve is meer dan een eenvoudige tentoonstelling en heeft tot doel de bezoeker een echte ervaring te geven door middel van een collectie die met elke nieuwe editie wordt verrijkt.","performers":"J\u00e9r\u00f4me Hatton, Richard Blin, Alex, Asmae, Mathieu.","boxoffice_url":null,"website":"http:\/\/www.goldorak-xperienz.com","email":null,"phone_contact":"+32 472 28 21 12","phone_booking":"+32 472 28 21 12","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.548045"},"en":{"name":"Goldorak XperienZ 1975-2023 Retrospective","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.548045"},"de":{"name":"Goldorak XperienZ 1975-2023 Retrospective","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.548045"},"it":{"name":"Goldorak XperienZ 1975-2023 Retrospective","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.548045"},"sp":{"name":"Goldorak XperienZ 1975-2023 Retrospective","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.548045"},"pt":{"name":"Goldorak XperienZ 1975-2023 Retrospective","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.548045"},"cn":{"name":"Goldorak XperienZ 1975-2023 Retrospective","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.548045"}},"place":{"id":222762,"translations":{"fr":{"name":"Tour & Taxis","address_street_name":"Avenue du Port","address_street_number":"86c","address_street_box":null,"email":null,"website":"http:\/\/www.tour-taxis.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue du Port, 86c","address_line2":"1000 Bruxelles","description_web":"L\u2019ancienne plateforme logistique de Tour & Taxis datant du d\u00e9but du 20\u00e8me si\u00e8cle offre des immeubles d\u2019envergure et d\u2019une haute qualit\u00e9 architecturale : l\u2019Entrep\u00f4t Royal, les Sheds, l\u2019H\u00f4tel des Douanes, l\u2019H\u00f4tel de la Poste et la Gare Maritime. Tout en respectant leur authenticit\u00e9 et leur valeur historique, une r\u00e9interpr\u00e9tation contemporaine est donn\u00e9e \u00e0 ces immeubles h\u00e9rit\u00e9s du si\u00e8cle pass\u00e9. Ils connaissent d\u00e9sormais des affectations multiples : expositions, \u00e9v\u00e9nements, espaces de travail, espaces commerciaux, services...\r\nLe site est id\u00e9alement situ\u00e9 sur le parcours touristique bruxellois, entre la vieille ville (Grand-Place, Manneken Pis \u2026) et d\u2019autres attractions touristiques telles que l\u2019Atomium.\r\nLes espaces verts et le parc \u00e9volutif sont des \u00e9l\u00e9ments centraux et inh\u00e9rents \u00e0 la philosophie de d\u00e9veloppement. Ils offrent des lieux de d\u00e9tente et de divertissement.\r\nTour & Taxis devient donc un quartier multifonctionnel r\u00e9invent\u00e9 avec des logements, de la culture, des espaces de travail, cr\u00e9ant une alternative positive pour les visiteurs \u00e0 la recherche de nouvelles exp\u00e9riences.\r\nDans un cadre inspirant, les Sheds accueillent des \u00e9v\u00e9nements incontournables et attirent de nombreux visiteurs.\r\nGr\u00e2ce aux diff\u00e9rents restaurants, bars et activit\u00e9s sur le site, il y a toujours une exp\u00e9rience \u00e0 vivre.\r\n\r\nT&T vous propose de d\u00e9couvrir l\u2019h\u00e9ritage industriel du site \u00e0 l\u2019aide de l\u2019App avec audio-guide, plan et photos. T\u00e9l\u00e9chargez l\u2019App gratuitement via le lien suivant : www.tt-app.be\r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Tour & Taxis","address_street_name":"Havenlaan","address_street_number":"86c","address_street_box":null,"email":null,"website":"http:\/\/www.tour-taxis.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Havenlaan, 86c","address_line2":"1000 Brussel","description_web":"Het voormalige logistieke platform van Tour & Taxis uit de vroege jaren van de 20e eeuw  bestaat uit gebouwen met hoge architectonische kwaliteit: het Koninklijk Pakhuis, de Sheds, het H\u00f4tel des Douanes, het H\u00f4tel de la Poste en de Gare Maritime zijn stuk voor stuk erfgoedparels.  Dit patrimonium kreeg met respect  voor historische waarde en oog voor authenticiteit een nieuwe eigentijdse invulling met  tentoonstellingen, evenementen, kantoren, coworking, retail, services ...\r\nDe site sluit nauw aan bij het toeristisch parcours tussen het historische stadscentrum (Grote Markt, Manneken Pis ...) en andere bezienswaardigheden zoals het Atomium. Het bevindt zich ook op wandelafstand van het toekomstige nieuwe museum voor moderne en hedendaagse kunst.\r\nDe groene ruimtes en het moderne park bieden ruimte aan ontspanning en vrijetijdsactiviteiten.\r\nTour & Taxis wordt een vooruitstrevende participatieve wijk met woningen, cultuur, workspaces, food hall \u2026 die een uitvalsbasis vormt voor de bezoekers op zoek naar nieuwe ervaringen. Zo vinden er in de Sheds uiteenlopende topbeurzen plaats. Dankzij die grote diversiteit aan activiteiten, restaurants, bars en talloze andere activiteiten op de site valt er steeds iets te beleven.\r\n\r\nTour&Taxis biedt u de mogelijkheid om het industrieel patrimonium van de site te ontdekken aan de hand van een App met audio-guide en foto\u2019s. U kunt de App gratis downloaden op: www.tt-app.be\r\n \r\n ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Tour & Taxis","address_street_name":"Avenue du Port","address_street_number":"86c","address_street_box":null,"email":null,"website":"http:\/\/www.tour-taxis.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Avenue du Port, 86c","address_line2":"1000 Brussels","description_web":"The historical logistics platform of Tour & Taxis presents a number of buildings of exceptional size and architectural value: the Royal Depot, the Sheds, the H\u00f4tel des Douanes, the H\u00f4tel de la Poste and the Gare Maritime. A modern interpretation is given to the historic buildings on the Tour & Taxis site, with great respect for their authenticity and heritage value.\r\nThe site is ideally located on the tourist routes, between the Brussels old city centre and other tourist attactions such as the Atomium.\r\nThe green areas and the evolutionary park are central features and an inherent part of the philosophy behind the Tour & Taxis development.\r\nTour & Taxis is becoming a reinvented neighbourhood with residences, culture, offices and public services all in one, creating a positive alternative for people looking for new experiences. The Sheds welcome different major events including antique and art fairs.\r\nWith eateries, bars and activities on the site, there\u2019s something to suit everyone\u2019s taste.\r\n\r\nTour & Taxis offers you the chance to discover the industrial heritage of this unique site using our App, which comprises of an audio guide working together with historic photos. You can download our App for free at: www.tt-app.be","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Tour & Taxis","address_street_name":"Avenue du Port","address_street_number":"86c","address_street_box":null,"email":null,"website":"http:\/\/www.tour-taxis.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue du Port, 86c","address_line2":"1000 Bruxelles","description_web":"Die ehemalige Logistikplattform mit Zolldepot Tour & Taxis, die Anfang des 20. Jahrhunderts erbaut und intensiv genutzt wurde, bietet eine ganze Reihe eindrucksvoller Geb\u00e4ude von hoher architektonischer Qualit\u00e4t: Entrep\u00f4t Royal, Sheds, H\u00f4tel des Douanes, H\u00f4tel de la Poste und Gare Maritime. Unter Ber\u00fccksichtigungen der urspr\u00fcnglichen Architektur und des besonderen historischen Wertes erhielt das Geb\u00e4ude nun eine zeitgem\u00e4\u00dfe Neuinterpretation und erf\u00fcllt inzwischen mehrere Aufgaben: Ausstellungen, Veranstaltungen, Arbeitsbereiche, Gesch\u00e4ftsr\u00e4ume, Dienstleistungen...\r\n\r\nDie Gr\u00fcnfl\u00e4chen und der sich entwickelnde Park als Orte der Entspannung und Unterhaltung sind zentrale Elemente des neuen Konzepts.\r\n\r\nDas industrielle Erbe von Tour & Taxis k\u00f6nnen Sie auch \u00fcber die App mit Audio-Guide, Karte und Fotos entdecken. Laden Sie die kostenlose App \u00fcber den folgenden Link herunter: www.tt-app.be\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Tour & Taxis","address_street_name":"Avenue du Port","address_street_number":"86c","address_street_box":null,"email":null,"website":"http:\/\/www.tour-taxis.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue du Port, 86c","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Tour & Taxis","address_street_name":"Avenue du Port","address_street_number":"86c","address_street_box":null,"email":null,"website":"http:\/\/www.tour-taxis.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue du Port, 86c","address_line2":"1000 Bruxelles","description_web":"La hist\u00f3rica plataforma log\u00edstica de Tour & Taxis presenta un n\u00famero de edificios de gran envergadura y valor arquitect\u00f3nico: Royal Depot, Sheds, H\u00f4tel des Douanes, H\u00f4tel de la Poste y Gare Maritime. Se le da una interpretaci\u00f3n moderna a los edifcios hist\u00f3ricos de Tour & Taxis, respetando su autenticidad y valor patrimonial.\r\nEl lugar est\u00e1 idealmente localizado en las rutas tur\u00edsticas, entre la parte antigua de la ciudad y otros lugares de inter\u00e9s tur\u00edstico tales como el Atomium.\r\nLas zonas verdes y el parque, que est\u00e1 en constante evoluci\u00f3n, son las principales caracter\u00edsticas y una parte inherente de la filosof\u00eda que hay detr\u00e1s del desarrollo de Tour & Taxis.\r\nTour & Taxis se est\u00e1 convirtiendo en un nuevo vecindario con residencias, cultura, oficinas y servicios p\u00fablicos todo en uno, creando una alternativa positiva para aquella gente que busca nuevas experiencias. El edificio Sheds acoge diferentes eventos de gran envergadura, incluyendo ferias de arte y antig\u00fcedades.\r\n\u00a1En los restaurantes, bares y actividades que hay en el lugar encontrar\u00e1s cosas para todos los gustos!\r\n\r\nTour & Taxis te ofrece la oportunidad de descubrir el patrimonio industrial de este lugar \u00fanico usando nuestra aplicaci\u00f3n, que incluye una audiogu\u00eda junto con fotos hist\u00f3ricas. Puedes descargar la aplicaci\u00f3n de manera gratuita aqu\u00ed: www.tt-app.be\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Tour & Taxis","address_street_name":"Avenue du Port","address_street_number":"86c","address_street_box":null,"email":null,"website":"http:\/\/www.tour-taxis.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue du Port, 86c","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Tour & Taxis","address_street_name":"Avenue du Port","address_street_number":"86c","address_street_box":null,"email":null,"website":"http:\/\/www.tour-taxis.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue du Port, 86c","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[8],"translations":{"fr":["Canal"],"nl":["Kanaalwijk"],"en":["Canal"],"de":["Kanal-Viertel"],"it":[null],"sp":[null],"pt":[null],"cn":[null]}},"zones":{"list":[20],"translations":{"fr":["Nord"],"nl":["Noord"],"en":["North"],"de":["Norden"],"it":[null],"sp":[null],"pt":[null],"cn":[null]}},"neca":null,"facebook_id":null,"backoffice_id":658,"location":{"lat":50.86573978,"lon":4.3509828},"region":"brussels","last_updated_at":"2023-01-02T01:35:17+01:00","published_at":"2013-10-19T01:13:42+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":276100,"translations":{"fr":{"name":"Pixel Museum Brussels","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"contact@pixel-museum.brussels","website":"http:\/\/www.pixel-museum.brussels","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard, 3","address_line2":"1000 Bruxelles","description_web":"Pixel Museum, le mus\u00e9e du jeu vid\u00e9o, des loisirs connect\u00e9s et de l\u2019art vid\u00e9oludique \u00e0 Bruxelles !\r\nD\u00e9couvrez l\u2019histoire du jeu vid\u00e9o, jouez et rejouez aux classiques des quarante derni\u00e8res ann\u00e9es, et essayez les derni\u00e8res nouveaut\u00e9s et les jeux ind\u00e9pendants! Des ateliers de d\u00e9couverte sur la cr\u00e9ation de jeux vid\u00e9o et des \u00e9v\u00e9nements sont r\u00e9guli\u00e8rement organis\u00e9s.\r\n\r\nJouer c\u2019est apprendre \u00e0 coop\u00e9rer, \u00e0 perdre et \u00e0 \u00eatre tenace!","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Pixel Museum Brussels","address_street_name":"Picardstraat","address_street_number":"3","address_street_box":null,"email":"contact@pixel-museum.brussels","website":"http:\/\/www.pixel-museum.brussels","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Picardstraat, 3","address_line2":"1000 Brussel","description_web":"Het Pixel Museum is het museum voor videospelletjes, online vrijetijdsbesteding en videogamekunst in Brussel!\r\nOntdek de geschiedenis van videospelletjes, speel de klassiekers van de afgelopen veertig jaar en probeer de allerlaatste nieuwigheden en onafhankelijke games uit! Er worden regelmatig workshops georganiseerd over het maken van videogames, en evenementen.\r\n\r\nSpelen is leren samenwerken, verliezen en ook volhouden!","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Pixel Museum Brussels","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"contact@pixel-museum.brussels","website":"http:\/\/www.pixel-museum.brussels","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue Picard, 3","address_line2":"1000 Brussels","description_web":"Pixel Museum is the museum of video games, connected entertainment and video game art in Brussels!\r\nDiscover the history of video games, play and replay the classics of the last forty years, and try out the latest novelties and independent games! Discovery workshops on video game creation and events are regularly organised.\r\n\r\nPlaying is learning how to cooperate, how to lose and how to be tenacious!","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Pixel Museum Brussels","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"contact@pixel-museum.brussels","website":"http:\/\/www.pixel-museum.brussels","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard, 3","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Pixel Museum Brussels","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"contact@pixel-museum.brussels","website":"http:\/\/www.pixel-museum.brussels","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard, 3","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Pixel Museum Brussels","address_street_name":"Rue Picard","addre