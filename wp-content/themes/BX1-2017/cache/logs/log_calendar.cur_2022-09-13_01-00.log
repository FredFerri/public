+32 2 412 08 12","phone_booking":"+32 2 412 08 12","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.540654"},"nl":{"name":"Finissage van de tentoonstelling \u00ab L\u2019herbier des pr\u00e9sences \u00bb met Claire Gatineau et Micha\u00ebl\/Le Gr\u00e9bil Liberg","shortdescr":null,"longdescr":"Claire Gatineau nodigt de muzikant Micha\u00ebl\/Le Gr\u00e9bil Liberg uit om samen met hem de soundscapes te herbeleven die ze opnam in drie wijken van het historische Molenbeek. Bij deze gelegenheid zullen drie luistersessies worden voorgesteld. De  muziek zal dan in resonantie treden met de klanken en de schilderijen.","performers":"Claire Gatineau nodigt de muzikant Micha\u00ebl\/Le Gr\u00e9bil Liberg uit om samen met hem de soundscapes te herbeleven die ze opnam in drie wijken van het historische Molenbeek.","boxoffice_url":null,"website":"http:\/\/www.momuse.be","email":"jgrafe@molenbeek.irisnet.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.540654"},"en":{"name":"Finissage de l\u2019exposition \u00ab L\u2019herbier des pr\u00e9sences \u00bb avec Claire Gatineau et Micha\u00ebl\/Le Gr\u00e9bil Liberg","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"jgrafe@molenbeek.irisnet.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.540654"},"de":{"name":"Finissage de l\u2019exposition \u00ab L\u2019herbier des pr\u00e9sences \u00bb avec Claire Gatineau et Micha\u00ebl\/Le Gr\u00e9bil Liberg","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.540654"},"it":{"name":"Finissage de l\u2019exposition \u00ab L\u2019herbier des pr\u00e9sences \u00bb avec Claire Gatineau et Micha\u00ebl\/Le Gr\u00e9bil Liber