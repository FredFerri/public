0e9\u00e2tre","sp":"Teatro","nl":"Theater"}},"others":{"list":[50],"translations":{"de":["Theater"],"pt":[null],"en":["Theatre"],"it":["Teatro"],"cn":[null],"fr":["Th\u00e9\u00e2tre"],"sp":["Teatro"],"nl":["Theater"]}}},"translations":{"de":{"name":"R\u00e9v\u00e9lation !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Revelation","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.561629"},"pt":{"name":"R\u00e9v\u00e9lation !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Revelation","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.561629"},"en":{"name":"R\u00e9v\u00e9lation !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Revelation","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.561629"},"it":{"name":"R\u00e9v\u00e9lation !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Revelation","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.561629"},"cn":{"name":"R\u00e9v\u00e9lation !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Revelation","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.561629"},"fr":{"name":"R\u00e9v\u00e9lation !","shortdescr":"Cette grande annonce qui bouleverse tout","longdescr":"Dans ce spectacle, vous d\u00e9tenez la cl\u00e9 de l\u2019intrigue !\r\n\r\nAvant que cette pi\u00e8ce improvis\u00e9e ne commence, les com\u00e9diens vous posent quelques questions. O\u00f9 se trouvent les personnages ? Quelles sont leurs relations ?\r\nEt surtout, quelle est la r\u00e9v\u00e9lation que l\u2019un d\u2019entre eux va faire durant l\u2019histoire ?\r\n\r\nQue sera cette grande annonce ? L\u2019un des membres du groupe d\u2019amis a-t-il gagn\u00e9 au Lotto ? Maman a-t-elle d\u00e9cid\u00e9 de refaire sa vie avec un homme de 30 ans de moins qu\u2019elle ? Une vieille l\u00e9gende raconte-t-elle que ce lieu est hant\u00e9 ?\r\nCette r\u00e9v\u00e9lation va avoir l\u2019effet d\u2019une bombe sur les personnages et leurs relations et vous allez \u00eatre t\u00e9moins des cons\u00e9quences impr\u00e9visibles de cette bouleversante nouvelle.\r\n_________________________________________________________________________\r\nChaque saison, gr\u00e2ce \u00e0 la g\u00e9n\u00e9rosit\u00e9 des com\u00e9diens jouant b\u00e9n\u00e9volement ce spectacle, la moiti\u00e9 des recettes de ce spectacle permet de soutenir une association.\r\nPendant la saison 2022-2023, il s\u2019agit de l\u2019ASBL forestoise \"Centre d\u2019accueil d\u2019urgence Ariane\". L\u2019association a comme but l\u2019organisation de l\u2019aide psychosociale permanente, 24h\/24, 7j\/7 ainsi que l\u2019accueil, les soins et l\u2019accompagnement en situation de crise de chaque personne se trouvant sur le territoire de la R\u00e9gion de Bruxelles-Capitale.\r\nEn venant assister \u00e0 ce spectacle, vous faites donc \u00e9galement une bonne action !\r\n","performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Revelation","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.561629"},"sp":{"name":"R\u00e9v\u00e9lation !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Revelation",