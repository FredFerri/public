ours":[{"start":"00:01:00","end":"23:59:00"}]},"thursday":{"is_open":true,"hours":[{"start":"00:01:00","end":"23:59:00"}]},"friday":{"is_open":true,"hours":[{"start":"00:01:00","end":"23:59:00"}]},"saturday":{"is_open":true,"hours":[{"start":"00:01:00","end":"23:59:00"}]},"sunday":{"is_open":true,"hours":[{"start":"00:01:00","end":"23:59:00"}]}},"translations":{"fr":["lundi, mardi, mercredi, jeudi, vendredi, samedi et dimanche: de 00:01 \u00e0 23:59"],"nl":["maandag, dinsdag, woensdag, donderdag, vrijdag, zaterdag en zondag: van 00:01 tot 23:59"],"en":["monday, tuesday, wednesday, thursday, friday, saturday and sunday: from 00:01 to 23:59"]},"date_start":"2022-07-01","date_end":"2022-09-17","is_also_by_appointment":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"opening":{"day":"2022-06-30","start":"18:00:00","timestamp":"2022-06-30T18:00:00+02:00","end":"22:00:00","is_only_by_appointment":false},"tags":[],"accessibilities":{"list":[255,259,261,263],"translations":{"fr":["Accessible","Chien d'assistance","Parking accessible","Accessible aux pi\u00e9tons appareill\u00e9s"],"nl":["Toegankelijk","Assistentiehonden","Toegankelijke parking","Toegankelijk voor voetgangers met hulpmiddelen"],"en":["Accessible","Assistance dogs","Accessible parking","Accessible to pedestrians with mobility aids"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-07-21T01:08:12+02:00","published_at":"2022-06-29T09:04:17+02:00","backoffice_id":257233,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.23305457683801},{"id":535497,"date_start":"2022-06-17","date_end":"2022-09-05","date_next":"2022-07-21","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":true,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[36,43],"translations":{"fr":["Mus\u00e9es et art centers","Arts D\u00e9coratifs"],"nl":["Musea en kunstcentra","Decoratieve kunsten"],"en":["Museums and art centers","Decorative art"]}}},"languages":{"spoken":["fr","en","es"],"subtitles":[]},"translations":{"fr":{"name":"Intimate Metaphysics","shortdescr":"Nous sommes plus que ravis de vous pr\u00e9senter le SOLO SHOW de l'artiste italien Edo Piantadosi.\r\n\r\n\u00ab Intimate Metaphysics \u00bb est une enqu\u00eate photographique po\u00e9tique et m\u00e9taphysique sur les formes de l'eau.\r\n\"Intimate Metaphysics\" is a poetic and metaphysical photographic investigation about water shapes.","longdescr":"Chers amis, nous sommes plus que ravis de vous pr\u00e9senter le SOLO SHOW de l'artiste italien Edo Piantadosi.\r\n\r\n\u00ab Intimate Metaphysics \u00bb est une enqu\u00eate photographique po\u00e9tique et m\u00e9taphysique sur les formes de l'eau.\r\nDes exp\u00e9riences visuelles uniques de moments qui ne se r\u00e9p\u00e8tent jamais...\r\n\r\nPiantadosi pr\u00e9sente le r\u00e9sultat de plus de quinze ans d'investigation et d'exploration de l'eau sous toutes ses formes, \u00e9tudiant sa gen\u00e8se et sa nature physique, la ramenant \u00e0 son essence dans ses images et les sortant de leur contexte pour les rendre abstraites.\r\n\r\nNous serons ravis de votre visite.","performers":"Edo Piantadosi, photographe italien","boxoffice_url":null,"website":"http:\/\/www.noonconsulting.art\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/535497.html"},"nl":{"name":"Intimate Metaphysics","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/535497.html"},"en":{"name":"Intimate Metaphysics","shortdescr":"We are more than\u00a0glad to present you the SOLO SHOW of the Italian artist Edo Piantadosi.\r\n\r\n\"Intimate Metaphysics\" is a poetic and metaphysical photographic investigation about water shapes.","longdescr":"Dear friends, we are more than\u00a0glad to present you the SOLO SHOW of the Italian artist Edo Piantadosi.\r\n\r\n\"Intimate Metaphysics\" is a poetic and metaphysical photographic investigation about water shapes.\r\nUnique visual experiences of moments that are never repeated...\r\n\r\nPiantadosi presents the result of more than fifteen years of investigation and exploration of the water in all its forms, studying its genesis and physical nature, stripping it back to its essence in his images and removing them\u00a0from their context to make them seem abstract.\r\n\r\nWe will be delighted to have your visit.","performers":"Edo Piantadosi, Italian Photographer","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/535497.html"},"de":{"name":"Intimate Metaphysics","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/535497.html"},"it":{"name":"Intimate Metaphysics","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/535497.html"},"sp":{"name":"Intimate Metaphysics","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/535497.html"},"pt":{"name":"Intimate Metaphysics","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/a