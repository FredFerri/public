s et des rencontres adapt\u00e9es \u00e0 la capitale. Apprenez tout sur le travail, les \u00e9tudes, et la vie \u00e0 Bruxelles et en Flandre. D\u00e9couvrez la richesse de l' offre culturelle n\u00e9erlandophone des organisations bruxelloises et flamandes.  ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Muntpunt","address_street_name":"Place de la Monnaie","address_street_number":"6","address_street_box":null,"email":"info@muntpunt.be","website":"http:\/\/www.muntpunt.be","phone_contact":"+32 2 278 11 11","phone_booking":"+32 2 278 11 11","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Monnaie, 6","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Muntpunt ","address_street_name":"Muntplein","address_street_number":"6","address_street_box":null,"email":"info@muntpunt.be","website":"http:\/\/www.muntpunt.be","phone_contact":"+32 2 278 11 11","phone_booking":"+32 2 278 11 11","address_zip":"1000","address_city":"Brussel","address_line1":"Muntplein, 6","address_line2":"1000 Brussel","description_web":"Muntpunt is een bibliotheek, informatiehuis, ontmoetingsplek en je venster op Brussel. Laat je inspireren door boeken, verhalen en ontmoetingen op maat van de hoofdstad. Kom meer te weten over wonen, werken, studeren, leven en beleven in Brussel en Vlaanderen. Ontdek het rijke Nederlandstalige culturele en vrijetijdsaanbod van Brusselse en Vlaamse organisaties.\r\n\r\nIn Muntpunt kan je meer dan alleen boeken, cd\u2019s en dvd\u2019s ontlenen. Je kan er ook terecht voor activiteiten, taalcursussen, infosessies, luisterboeken, strips, spelletjes, en nog veel meer. Er valt bijna dagelijks iets te beleven in Muntpunt, van voorlezen tot documentaires, van infosessies tot rondleidingen, voor jong en oud. De activiteiten sluiten aan bij de bibliotheekwerking of spelen in op actuele thema's, steeds met de Brusselse hoofdstedelijke context in het achterhoofd. De rode draad door de programmatie is de samenwerking met Vlaamse en Brusselse partnerorganisaties. \r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":13020,"location":{"lat":50.84996484,"lon":4.35348679},"last_updated_at":"2024-08-30T11:20:51+02:00","published_at":"2013-10-19T01:35:36+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[],"dates":[{"day":"2025-02-05","doors":null,"start":"16:00:00","end":"19:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"de":{"name":"Normal"},"en":{"name":"Normal"},"it":{"name":"Normale"},"fr":{"name":"Normal"},"sp":{"name":"Normal"},"nl":{"name":"Normaal"}},"value":0}],"date_exceptions":[],"closing_days":[],"child_events":[],"parent_events":[],"accessibilities":[],"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[]},{"id":5700005195,"date_start":"2025-02-05","date_end":"2025-02-08","date_next":"2025-02-05","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2025-01-08T14:07:03+01:00","published_at":"2025-01-08T13:40:30+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":315797,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"tour","ranking":0.6299605249474366,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{}},"translations":{"de":{"name":"Le Palais de Justice","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/le-palais-de-justice-2","email":"info@arkadia.be","phone_contact":"+32 2 319 44 85","phone_booking":"+32 2 319 44 85","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700005195"},"pt":{"name":"Le Palais de Justice","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/le-palais-de-justice-2","email":"info@arkadia.be","phone_contact":"+32 2 319 44 85","phone_booking":"+32 2 319 44 85","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700005195"},"en":{"name":"Le Palais de Justice","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/le-palais-de-justice-2","email":"info@arkadia.be","phone_contact":"+32 2 319 44 85","phone_booking":"+32 2 319 44 85","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700005195"},"it":{"name":"Le Palais de Justice","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/le-palais-de-justice-2","email":"info@arkadia.be","phone_contact":"+32 2 319 44 85","phone_booking":"+32 2 319 44 85","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700005195"},"cn":{"name":"Le Palais de Justice","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/le-palais-de-justice-2","email":"info@arkadia.be","phone_contact":"+32 2 319 44 85","phone_booking":"+32 2 319 44 85","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700005195"},"fr":{"name":"Le Palais de Justice","shortdescr":"Le palais de justice est un cas \u00e0 part, un v\u00e9ritable \u201cmonument\u201d, dans tous les sens du terme, du patrimoine bruxellois... Gigantesque, ce colosse est plus grand que la basilique Saint-Pierre de Rome ! ","longdescr":"Au moment de la construction du b\u00e2timent, l\u2019intention est claire : tout est fait pour impressionner, depuis l\u2019ext\u00e9rieur comme \u00e0 l\u2019int\u00e9rieur. Lieu symbolique, porteur d\u2019une lourde histoire, le palais de justice est \u00e9rig\u00e9 sur l\u2019ancien \u201cMont des Potences\u201d, o\u00f9 l\u2019on ex\u00e9cutait les condamn\u00e9s au Moyen \u00c2ge. La l\u00e9gende raconte qu\u2019au 16e si\u00e8cle, le c\u00e9l\u00e8bre m\u00e9decin V\u00e9sale allait y d\u00e9rober les cadavres la nuit pour \u00e9tudier le corps humain\u2026\n\nC\u2019est un des monuments les plus impressionnants de Bruxelles qui offre \u00e0 ses c\u00f4t\u00e9s un panorama \u00e9poustouflant sur le bas de la ville. Il est l\u2019\u0153uvre de Joseph Poelart, qui remporte le concours international mis en place par le gouvernement belge en 1860. L\u2019inauguration du palais aura lieu le 15 octobre 1883, 4 ans apr\u00e8s la mort de son architecte.\n\nAdul\u00e9 par certains, d\u00e9cri\u00e9 par d\u2019autres, cet ouvrage pharaonique compte 40.000 m\u00b2 de surface exploitable et une coupole qui culmine \u00e0 100 m\u00e8tres de hauteur !\nLa visite du palais de justice vous permettra d\u2019en savoir plus sur son histoire truculente, mais aussi sur l\u2019architecture du b\u00e2timent, sur les \u0153uvres d\u2019art qu\u2019il renferme ou encore sur le syst\u00e8me judiciaire belge.\n\nATTENTION : arriver 15 minutes \u00e0 l'avance car il faut passer le contr\u00f4le de s\u00e9curit\u00e9 avant la visite ! Pendant les travaux l'entr\u00e9e est du c\u00f4t\u00e9 de la rue des minimes apr\u00e8s l'ascenseur des marolles.\n\nLe Palais de justice est actuellement en travaux. Les cours d'assises, d'appel et de cassation ne sont malheureusement plus ouvertes au public car elles sont utilis\u00e9es pour des proc\u00e8s d\u00e9licats.","performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/le-palais-de-justice-2","email":"info@arkadia.be","phone_contact":"+32 2 319 44 85","phone_booking":"+32 2 319 44 85","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700005195"},"sp":{"name":"Le Palais de Justice","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/le-palais-de-justice-2","email":"info@arkadia.be","phone_contact":"+32 2 319 44 85","phone_booking":"+32 2 319 44 85","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700005195"},"nl":{"name":"Le Palais de Justice","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/le-palais-de-justice-2","email":"info@arkadia.be","phone_contact":"+32 2 319 44 85","phone_booking":"+32 2 319 44 85","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700005195"}},"place":{"id":232780,"translations":{"de":{"name":"Der Br\u00fcsseler Justizpalast","address_street_name":"Pl. Poelaert","address_street_number":"1","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Pl. Poelaert, 1","address_line2":"1000 Bruxelles","description_web":"Der Br\u00fcsseler Justizpalast z\u00e4hlt zu den bemerkenswertesten und gleichzeitig bombastischsten europ\u00e4ischen Monumenten des 19. Jh. und ist in Europa noch heute der gr\u00f6\u00dfte seiner Art.\r\n\r\nMajest\u00e4tische Dimensionen: Die L\u00e4ngs- und die Querachse des Bauwerks messen 160 bzw. 150 Meter. Die Gesamtfl\u00e4che bel\u00e4uft sich auf 26 000 m\u00b2 mit acht Innenh\u00f6fen. Dominiert wird das imposante Rechteck von einer massiven Kuppel (24 000 Tonnen) in einer H\u00f6he von 142 Metern. Architektonisch herrscht der griechisch-r\u00f6mische Stil vor. Die belgischen K\u00f6nige Leopold I. und Leopold II. wollten mit diesem symboltr\u00e4chtigen Bauwerk hoch \u00fcber der Stadt zwischen Ober- und Unterstadt ein Zeichen f\u00fcr den damals noch jungen,1830 gegr\u00fcndeten belgischen Staat setzen.\r\n\r\nEin architektonisches Mammutprojekt: Mit dem Bau wurde der Architekt Joseph Poelaert beauftragt. Von der Grundsteinlegung 1866 bis zur Einweihung 1883 vergingen ganze 17 Jahre, sie fand im Jahr 1883, bereits einige Jahre nach dem Tode Poelaerts, statt.\r\n\r\nGestern & heute: Gesellschaftlich sorgte der Bau des Kolosses seinerzeit f\u00fcr Unmut, da gro\u00dfe Teile des volkst\u00fcmlichen Marollenviertels dem Justizpalast weichen mussten - und auch heute ist er nicht unumstritten: Seit Mitte der 80er Jahre ist die Kuppel von Bauger\u00fcsten umgeben, von denen aus Sicherungs- und Restaurierungsarbeiten durchgef\u00fchrt werden.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Le Palais de Justice de Bruxelles","address_street_name":"Place Poelaert","address_street_number":"1","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Poelaert, 1","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Brussels' Palace of Justice","address_street_name":"Place Poelaert","address_street_number":"1","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Place Poelaert, 1","address_line2":"1000 Brussels","description_web":"Standing in front of this gigantic building leaves you (almost) dizzy. Everything is done to impress, both inside and out. It's a symbolic place with a long history, built on the (rather aptly named) Mont des Potences, meaning Gallows Hill, where condemned men were executed in the Middle Ages.\u202fLegend has it that in the 16th century, the famous doctor Vesalius went there at night to steal corpses so that he could study the human body\u2026 \r\n\r\nIt\u2019s one of the most impressive monuments in Brussels, which also offers a breathtaking panoramic view of lower Brussels. \r\n\r\nA little history \r\nIn March 1860 (under Leopold I), the Belgian government organised an international competition for the construction of a new courthouse in Brussels. The jury did not select any of the projects presented and the project was instead entrusted to the architect of the City of Brussels (who was on the jury!). Joseph Poelaert's project was colossal: to synthesise the history of humanity in the architecture of a single building. The construction, which finally began in October 1866, took 17 years. It led to the sacrificing of part of the Marolles, the working-class district in the lower part of the city, through expropriations at derisory prices, evictions and demolitions. The inauguration (under Leopold II) was held on 15 October 1883, without the architect of this colossus having seen his work completed. Exhausted and driven mad, he died four years before the work was completed. \r\n\r\nThe \u201cSkieven architek\u201d and \u201cThe Great Inkwell\u201d\u2026 \r\nThe monument left no one indifferent. It was adored by some and mocked by others. Poelaert was granted tremendous artistic and financial freedom throughout the project, which led to popular, political and cultural discontent. A number of charming expressions were coined, such as 'Rotten' and 'Skieven architek' (twisted architect), with the latter being adopted as the name of a caf\u00e9 on Place du Jeu de Balle in the heart of the Marolles. Victor Horta described the building as \"... a crushing mass crowned by a cheese bell\". Freud praised it highly: \"At the top of a steep hill stands a massive building, with columns so beautiful that the whole evokes an Assyrian royal palace or an illustration by Gustave Dor\u00e9\". Victor Hugo christened it \"The Great Inkwell\". \r\n\r\nBuilt in the classical Greco-Roman style and larger than Saint Peter's Basilica in Rome, it is (still to this day) the largest palace of justice in the world: \r\n40,000m\u00b2 \r\na dome that reaches a height of 100 metres \r\na colossal vestibule \r\nover 250 rooms, including 27 impressive courtrooms\u2026\r\n \r\n\"A cyclopean architecture, dreamed up by hands unaware of the human scale\" (Victor Horta) ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Palazzo di Giustizia di Bruxelles","address_street_name":"pl. Poelaert","address_street_number":"1","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"pl. Poelaert, 1","address_line2":"1000 Bruxelles","description_web":"Costruito tra il 1866 ed il 1883 dall'architetto Poelaert, maestoso simbolo della potenza della giustizia, \u00e8 il pi\u00f9 grande edificio eretto nel XIX secolo in Occidente.\u00a0...\r\n\"Costruito tra il 1866 ed il 1883 dall'architetto Poelaert, maestoso simbolo della potenza della giustizia, \u00e8 il pi\u00f9 grande edificio eretto nel XIX secolo in Occidente.Su una superficie di 26.000 m\u00b2, 27 sale d'udienza, 245 sale...ispirazione di stile classico greco-romano. \r\nDa vedere: la sala dei Pas-Perdus sovrastata da una grandiosa cupola che si erge a 100 m dal suolo, le gallerie del primo piano, il panorama (dalla terrazza) sulla citt\u00e0 bassa e sul quartiere di Marolles\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Le Palais de Justice de Bruxelles","address_street_name":"Place Poelaert","address_street_number":"1","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Poelaert, 1","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Le Palais de Justice de Bruxelles","address_street_name":"Place Poelaert","address_street_number":"1","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Poelaert, 1","address_line2":"1000 Bruxelles","description_web":"On est (presque) pris d\u2019un vertige face \u00e0 cette gigantesque b\u00e2tisse. Tout est fait pour impressionner, \u00e0 l\u2019ext\u00e9rieur comme \u00e0 l\u2019int\u00e9rieur. Lieu symbolique et porteur d\u2019une lourde histoire, le Palais de Justice est \u00e9rig\u00e9 sur le (bien nomm\u00e9) Mont des Potences o\u00f9 l\u2019on ex\u00e9cutait les condamn\u00e9s au Moyen- Age.\u202fLa l\u00e9gende raconte qu\u2019au XVI\u00e8me si\u00e8cle, le c\u00e9l\u00e8bre m\u00e9decin V\u00e9sale allait y d\u00e9rober les cadavres la nuit pour \u00e9tudier le corps humain\u2026 \r\n\r\nC\u2019est un des monuments les plus impressionnants de Bruxelles qui offre \u00e0 ses c\u00f4t\u00e9s un panorama \u00e9poustouflant sur le bas de la ville. \r\n\r\nUn peu d\u2019histoire \r\n\r\nEn mars 1860, (sous L\u00e9opold Ier), le gouvernement belge organise un concours international pour la construction d\u2019un nouveau palais de justice \u00e0 Bruxelles. \r\nLe jury ne retient aucun des projets pr\u00e9sent\u00e9s et le dossier est confi\u00e9 \u00e0 l\u2019architecte de la Ville de Bruxelles (qui faisait partie du jury !). \r\n\r\nLe projet de Joseph Poelaert est pharaonique : faire la synth\u00e8se de l'histoire de l'humanit\u00e9 dans l'architecture de ce seul b\u00e2timent. La construction qui d\u00e9bute finalement en octobre 1866 prendra 17 ans. \r\n\r\nElle entra\u00eene le sacrifice d\u2019une partie des Marolles, le quartier populaire du bas de la ville, \u00e0 coup d\u2019expropriations \u00e0 prix d\u00e9risoires, d\u2019expulsions et de d\u00e9molitions. \r\n\r\nL\u2019inauguration (sous L\u00e9opold II) aura lieu le 15 octobre 1883, sans que l\u2019architecte de ce colosse n\u2019ait pu voir son oeuvre achev\u00e9e. Epuis\u00e9 et devenu fou, il meurt quatre ans avant la fin des travaux. \r\n\r\nLe \u00ab Skieven architek \u00bb et \u00ab Le grand encrier \u00bb\u2026 \r\n\r\nLe monument ne laisse personne indiff\u00e9rent. Il est ador\u00e9 par certains et moqu\u00e9 par d\u2019autres. \r\n\r\nPour la r\u00e9alisation du projet, Poelaert b\u00e9n\u00e9ficie d\u2019une tr\u00e8s grande libert\u00e9, tant artistique que financi\u00e8re, ce qui va provoquer un m\u00e9contentement populaire, politique et culturel. \r\n\r\nNaissent des expressions savoureuses comme \u00ab Rotten \u00bb et \u00ab Skieven architek \u00bb (architecte pourri ou tordu) qui deviendra le nom d\u2019un caf\u00e9 de la Place du Jeu de Balle au c\u0153ur des Marolles. \r\n\r\nVictor Horta qualifiera le b\u00e2timent de \u00ab \u2026 Masse \u00e9crasante couronn\u00e9e par une cloche \u00e0 fromage \u00bb. Freud en fait un bel \u00e9loge \u00ab Au sommet d\u2019une colline rapide se dresse un b\u00e2timent massif, avec des colonnes si belles que l\u2019ensemble \u00e9voque un palais royal assyrien ou une illustration de Gustave Dor\u00e9 \u00bb. Victor Hugo le baptisera \u00ab le grand encrier \u00bb . \r\n\r\nLe plus grand palais (de justice) du monde\u2026 \r\n\r\nDe style classique gr\u00e9co romain, plus grand que la Basilique St Pierre \u00e0 Rome, il est (encore \u00e0 ce jour) le plus grand palais de Justice du monde : \r\n\r\n40.000 m2 \r\n\r\nune coupole qui culmine \u00e0 100 m\u00e8tres de haut \r\n\r\nune salle des pas perdus pharaonique \r\n\r\nplus de 250 locaux, dont 27 impressionnantes salles d\u2019audience \u2026 \r\n\r\n\u00ab Une architecture cyclop\u00e9enne, r\u00eav\u00e9e par des mains n\u2019ayant pas conscience de l\u2019\u00e9chelle humaine \u00bb (Victor Horta) ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"El Palacio de Justicia de Bruselas","address_street_name":"pl. Poelaert","address_street_number":"1","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"pl. Poelaert, 1","address_line2":"1000 Bruxelles","description_web":"Construido entre 1866 y 1883 por Poelaert, este majestuoso s\u00edmbolo de la justicia, constituy\u00f3 la mayor construcci\u00f3n del s. XIX en Occidente....\r\nVisita: \r\nSus 26.000 m de superficie, 27 salas de audiencia, 245 salas...\r\nEl estilo grecorromano cl\u00e1sico \r\nLa sala Pas-Perdus con una grandiosa c\u00fapula a 100 m de altura\r\nLas galer\u00edas de la primera planta\r\nEl mirador que hay en la plaza, con vistas a la parte baja de la ciudad \r\nEl ascensor acristalado que te llevar\u00e1 al Barrio de Les Marolles\r\nEl mirador de noche\r\n\r\nRecuerda que, por la noche, el Palacio de Justicia se ilumina ofreciendo una imagen evocadora.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Het Brusselse Justitiepaleis ","address_street_name":"Poelaertplein","address_street_number":"1","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Poelaertplein, 1","address_line2":"1000 Brussel","description_web":"Wie voor dit gigantische gebouw staat, kan gaan duizelen. Alles is gedaan om indruk te maken, zowel binnen als buiten. Het Justitiepaleis, een symbolische plek met een zware geschiedenis, is gebouwd op de (toepasselijk genaamde) Galgenberg, waar veroordeelde middeleeuwers werden terechtgesteld. Volgens de legende ging de beroemde 16e-eeuwse dokter Vesalius er 's nachts lijken stelen, zodat hij het menselijk lichaam kon bestuderen... \r\n\r\nHet is een van de indrukwekkendste monumenten in Brussel en biedt een adembenemend uitzicht op de benedenstad. \r\n\r\nEen beetje geschiedenis \r\nIn maart 1860 (onder Leopold I) hield de Belgische regering een internationale wedstrijd voor de bouw van een nieuw justitiepaleis in Brussel. De jury weigerde alle ingediende projecten en het project werd toevertrouwd aan de architect van de Stad Brussel (die deel uitmaakte van de jury!). \r\n\r\nHet project van Joseph Poelaert was megalomaan: de geschiedenis van de hele mensheid synthetiseren in de architectuur van \u00e9\u00e9n enkel gebouw. De bouw, die uiteindelijk van start ging in oktober 1866, duurde 17 jaar. Het leidde tot de opoffering van een deel van de Marollen, de volkswijk in het lagere gedeelte van de stad. Bewoners kregen te maken met onteigeningen tegen belachelijk lage prijzen, uitzettingen en afbraak. De inhuldiging (onder Leopold II) vond plaats op 15 oktober 1883, maar de architect heeft het niet kunnen meemaken. Uitgeput en tot waanzin gedreven stierf hij vier jaar voor de voltooiing van zijn meesterwerk. \r\n\r\nDe \"Skieven Architek\" en \"De Grote Inktpot\"... \r\nHet monument liet niemand onverschillig. Het werd door sommigen aanbeden en door anderen bespot. Poelaert genoot tijdens het hele project een enorme artistieke en financi\u00eble vrijheid, wat voor onvrede zorgde in de politiek, de cultuur en bij het volk. Er werden een aantal charmante uitdrukkingen bedacht, zoals 'Rotten' en 'Skieven architek' (verdraaide architect), dat de naam werd van een caf\u00e9 op het Vossenplein in het hart van de Marollen. \r\n\r\nVictor Horta beschreef het gebouw als \"... een verpletterende massa bekroond met een kaasstolp\". Freud was er vol lof over: \"Op de top van een steile heuvel staat een massief gebouw, met zuilen die zo mooi zijn dat het geheel doet denken aan een Assyrisch koninklijk paleis of een illustratie van Gustave Dor\u00e9\". Victor Hugo doopte het \"De Grote Inktpot\". \r\n\r\nHet Justitiepaleis, gebouwd in de klassieke Grieks-Romeinse stijl en groter dan de Sint-Pietersbasiliek in Rome, is (tot op heden) het grootste gerechtsgebouw ter wereld: \r\n40.000 vierkante meter \r\neen koepel die tot 100 meter hoog reikt \r\neen kolossale vestibule \r\nmeer dan 250 zalen, waaronder 27 indrukwekkende rechtszalen... \r\n\r\n\"Een cyclopische architectuur, bedacht door handen die geen weet hebben van de menselijke maat\" (Victor Horta) ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[2],"translations":{"de":["Marollen"],"pt":[null],"en":["Marolles"],"it":["Marolles"],"cn":[null],"fr":["Marolles"],"sp":["Marolles"],"nl":["Marollen"]}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":null,"facebook_id":null,"backoffice_id":1128,"location":{"lat":50.83701292,"lon":4.35210879},"region":"brussels","last_updated_at":"2025-01-08T13:54:12+01:00","published_at":"2013-10-19T01:14:04+02:00","import_origin":null,"external_id":null,"is_in_address_book":false,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":276946,"translations":{"de":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":null,"description_print":n