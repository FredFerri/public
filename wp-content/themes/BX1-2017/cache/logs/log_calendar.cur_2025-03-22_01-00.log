ortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.dieterengroup.com\/collection\/","email":"gallery@dieterengroup.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700006956"},"pt":{"name":"Nocturnes x\u202f D'Ieteren Gallery","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.dieterengroup.com\/collection\/","email":"gallery@dieterengroup.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700006956"},"en":{"name":"Nocturnes x\u202f D'Ieteren Gallery","shortdescr":"D\u2019Ieteren Gallery is located on rue du Mail in Ixelles. This gallery retraces the history of the D\u2019Ieteren Group since its foundation, exhibiting vehicles, horse-drawn carriages and bodied automobiles, as well as photographs, objects and archive documents. Come and discover the collection through different highlighted themes. Every 30 minutes another tour will begin!","longdescr":"D\u2019Ieteren Gallery is located on rue du Mail in Ixelles. This gallery retraces the history of the D\u2019Ieteren Group since its foundation, exhibiting some one hundred vehicles, horse-drawn carriages and bodied automobiles, as well as photographs, objects and archive documents covering the 7 professions practiced by the company over the years.\nIn this gallery, with more than 2000m2 of space and inaugurated in 2005, you will admire around a hundred vehicles, including horse-drawn carriages and motor vehicles with D\u2019Ieteren bodies, as well as specimens that tell the history of the brands the company distributed or still distributes. Numerous objects, photographs and archive documents form the backdrop of this unique collection, giving an overview of the company\u2019s 220 years of history. \n\nEvery 30 minutes another tour will begin! Coachbuilding and wheelwrighting, made by D'Ieteren, followed by Studebaker, Volkswagen, Porsche, Auto Union and Audi.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.dieterengroup.com\/collection\/","email":"gallery@dieterengroup.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700006956"},"it":{"name":"Nocturnes x\u202f D'Ieteren Gallery","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.dieterengroup.com\/collection\/","email":"gallery@dieterengroup.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700006956"},"cn":{"name":"Nocturnes x\u202f D'Ieteren Gallery","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.dieterengroup.com\/collection\/","email":"gallery@dieterengroup.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700006956"},"fr":{"name":"Nocturnes x\u202f D'Ieteren Gallery","shortdescr":"D\u2019Ieteren Gallery se trouve rue du Mail \u00e0 Ixelles. Cette galerie retrace l\u2019histoire du Groupe D\u2019Ieteren depuis sa fondation, expose une centaine de v\u00e9hicules, voitures hippomobiles et automobiles carross\u00e9es, ainsi que des photographies, des objets et des documents d\u2019archives. Venez d\u00e9couvrir la collection \u00e0 travers diff\u00e9rents th\u00e8mes mis \u00e0 l\u2019honneur. Chaque 30 minutes une autre visite commencera! ","longdescr":"D\u2019Ieteren Gallery se trouve rue du Mail \u00e0 Ixelles. Cette galerie retrace l\u2019histoire du Groupe D\u2019Ieteren depuis sa fondation, expose une centaine de v\u00e9hicules, voitures hippomobiles et automobiles carross\u00e9es, ainsi que des photographies, des objets et des documents d\u2019archives \u00e0 travers les 7 m\u00e9tiers pratiqu\u00e9s par la soci\u00e9t\u00e9 au fil du temps. \nDans cette galerie de plus de 2000m2 inaugur\u00e9e en 2005, vous pourrez admirer une centaine de v\u00e9hicules, dont des voitures hippomobiles et des v\u00e9hicules \u00e0 moteur \u00e0 carrosserie D\u2019Ieteren, ainsi que des sp\u00e9cimens qui racontent l\u2019histoire des marques que l\u2019entreprise a distribu\u00e9es ou distribue encore. De nombreux objets, photographies et documents d\u2019archives constituent la toile de fond de cette collection unique, qui donne un aper\u00e7u des 220 ans de l\u2019entreprise.\n\nVenez d\u00e9couvrir la collection \u00e0 travers diff\u00e9rents th\u00e8mes mis \u00e0 l\u2019honneur: les carrosseries D\u2019Ieteren, Studebaker, Volkswagen, Porsche, Auto Union-Audi. Chaque 30 minutes une autre visite commencera. ","performers":null,"boxoffice_url":null,"website":"https:\/\/www.dieterengroup.com\/collection\/","email":"gallery@dieterengroup.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700006956"},"sp":{"name":"Nocturnes x\u202f D'Ieteren Gallery","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.dieterengroup.com\/collection\/","email":"gallery@dieterengroup.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700006956"},"nl":{"name":"Nocturnes x\u202f D'Ieteren Gallery","shortdescr":"D\u2019Ieteren Gallery bevindt zich in de Maliestraat in Elsene. Deze galerij vertelt de geschiedenis van D\u2019Ieteren Groep sinds zijn oprichting en toont een honderdtal voertuigen, paardenkoetsen en auto\u2019s met carrosserie, maar ook foto\u2019s, voorwerpen en archiefdocumenten. Kom de collectie ontdekken aan de hand van verschillende thema\u2019s. Elke 30 minuten start er een nieuwe rondleiding!","longdescr":"D\u2019Ieteren Gallery bevindt zich in de Maliestraat in Elsene. Deze galerij vertelt de geschiedenis van D\u2019Ieteren Groep sinds zijn oprichting en toont een honderdtal voertuigen, paardenkoetsen en auto\u2019s met carrosserie, maar ook foto\u2019s, voorwerpen en archiefdocumenten over de 7 functies die het bedrijf door de jaren heen heeft uitgeoefend.\nIn deze galerij, met meer dan 2000m2 ruimte en ingehuldigd in 2005, bewonder je een honderdtal voertuigen, waaronder paardenkoetsen en motorvoertuigen met carrosserie\u00ebn van D\u2019Ieteren, evenals exemplaren die de geschiedenis vertellen van de merken die de onderneming heeft verdeeld of nog steeds verdeelt. Tal van voorwerpen, foto\u2019s en archiefdocumenten vormen het decor van deze unieke collectie en geeft een overzicht van de 220 jaar van de onderneming. \n\nKom de collectie ontdekken aan de hand van verschillende thema\u2019s: D\u2019Ieteren autocarrosserie\u00ebn, Studebaker, Volkswagen, Porsche, Auto Union- Audi. Elke 30 minuten start er een nieuwe rondleiding.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.dieterengroup.com\/collection\/","email":"gallery@dieterengroup.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700006956"}},"place":{"id":258178,"translations":{"de":{"name":"D'Ieteren Gallery","address_street_name":"Rue du Mail","address_street_number":"50","address_street_box":null,"email":"gallery@dieterengroup.com","website":"https:\/\/www.dieterengroup.com\/","phone_contact":"+32 2 772 34 26","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue du Mail, 50","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"D'Ieteren Gallery","address_street_name":"Rue du Mail","address_street_number":"50","address_street_box":null,"email":"gallery@dieterengroup.com","website":"https:\/\/www.dieterengroup.com\/","phone_contact":"+32 2 772 34 26","phone_booking":null,"address_zip":"1050","address_city":"Ixelle