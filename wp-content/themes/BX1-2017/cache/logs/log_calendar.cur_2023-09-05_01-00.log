,265,252,266,258],"translations":{"de":["Barrierefrei","Anpassungen f\u00fcr blinde und sehbehinderte Menschen","Anpassungen f\u00fcr geh\u00f6rlose und h\u00f6rgesch\u00e4digte Menschen.","Assistenzhund","Barrierefreier Parkplatz","Barrierefrei f\u00fcr Fu\u00dfg\u00e4nger mit Gehhilfe","Barrierefreies WC","Barrierefrei f\u00fcr Menschen mit Verst\u00e4ndnisschwierigkeiten","Brussels Health Safety Label","H\u00f6rverst\u00e4rker"],"pt":[null,null,null,null,null,null,null,null,null,null],"en":["Accessible","Facilities for blind and partially-sighted persons","Facilities for deaf and hearing-impaired people","Assistance dogs","Accessible parking","Accessible to pedestrians with mobility aids","Adapted toilet","Accessible to people with intellectual disabilities","Brussels Health Safety Label","Sound-amplifying equipment"],"it":["Accessibile","Disposizioni per persone non vedenti e ipovedenti","Disposizioni per persone non udenti e ipoudenti","Cane guida","Parcheggio accessibile","Accessibile ai pedoni con supporti","WC idoneo","Accessibile alle persone con difficolt\u00e0 di comprensione","Brussels Health Safety Label","Apparecchi acustici"],"cn":[null,null,null,null,null,null,null,null,null,null],"fr":["Accessible","Am\u00e9nagements pour les personnes aveugles et malvoyantes","Am\u00e9nagements pour personnes sourdes et malentendantes","Chien d'assistance","Parking accessible","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9","Accessible aux personnes ayant des difficult\u00e9s de compr\u00e9hension","Brussels Health Safety Label","Appareils d'amplification du son"],"sp":["Habilitado","Equipos para personas con problemas de visi\u00f3n y audici\u00f3n","Equipos para personas sordas y con problemas de audici\u00f3n","Perros gu\u00eda","Estacionamiento habilitado","Habilitado para peatones con aud\u00edfonos","Ba\u00f1os adaptados","Habilitado para personas con dificultades de comprensi\u00f3n","Brussels Health Safety Label","Aparatos de amplificaci\u00f3n del sonido"],"nl":["Toegankelijk","Voorzieningen voor blinde en slechtziende personen","Voorzieningen voor dove en slechthorende personen","Assistentiehonden","Toegankelijke parking","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet","Toegankelijk voor mensen met een verstandelijke beperking","Brussels Health Safety Label","Geluidsversterkende apparatuur"]}},"recurring":[{"day":"sunday","occurences":{"is_third":false,"is_fourth":false,"is_last":false,"is_first":false,"is_second":true},"time_start":"14:00:00","time_end":"15:30:00","translations":{"fr":"Ouvert le deuxi\u00e8me, dimanche du mois de 14:00 \u00e0 15:30","nl":"Open op de tweede, zondag van de maand van 14:00 tot 15:30","en":"Open the second, sunday of the month from 14:00 to 15:30"}},{"day":"saturday","occurences":{"is_third":false,"is_fourth":false,"is_last":false,"is_first":false,"is_second":true},"time_start":"13:30:00","time_end":"15:00:00","translations":{"fr":"Ouvert le deuxi\u00e8me, samedi du mois de 13:30 \u00e0 15:00","nl":"Open op de tweede, zaterdag van de maand van 13:30 tot 15:00","en":"Open the second, saturday of the month from 13:30 to 15:00"}}],"targets":{"list":[7,14,10,8,11,16,5,19,12],"translations":{"de":["Jugendliche 12-15 Jahre","Blinde\/Sehbehinderte","Senioren","Jugendliche 15-18 Jahre","Familie","Schulen","Kinder 9-12 Jahre","Lehrkr\u00e4fte","LGTBQIA"],"pt":[null,null,null,null,null,null,null,null,null],"en":["Youth 12-15  yr.","Blind\/visually impaired","Seniors","Youth 15-18  yr.","Family","Schools","Children 9-12 yr.","Teachers","LGTBQIA"],"it":["Ragazzi 12-15 anni","Non vedenti\/ipovedenti","Anziani","Ragazzi 15-18 anni","Famiglie","Scuole","Bambini 9-12 anni","Insegnanti","LGTBQIA"],"cn":[null,null,null,null,null,null,null,null,null],"fr":["Jeunes 12-15 ans","Aveugle\/malvoyant","Seniors","Jeunes 15-18 ans","Famille","Ecoles","Enfants 9-12 ans","Enseignants","LGTBQIA"],"sp":["J\u00f3venes de 12 a 15 a\u00f1os","Personas invidentes o con problemas de vi