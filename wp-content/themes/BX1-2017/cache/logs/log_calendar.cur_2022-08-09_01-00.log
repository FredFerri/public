9:00","samedi et dimanche: de 12:00 \u00e0 17:00"],"nl":["maandag: gesloten","dinsdag, woensdag en donderdag: van 10:00 tot 17:00","vrijdag: van 10:00 tot 19:00","zaterdag en zondag: van 12:00 tot 17:00"],"en":["monday: closed","tuesday, wednesday and thursday: from 10:00 to 17:00","friday: from 10:00 to 19:00","saturday and sunday: from 12:00 to 17:00"]},"date_start":"2022-07-01","date_end":"2022-08-31","is_also_by_appointment":false}],"closing_days":["2022-07-21"],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":5},{"translations":{"fr":{"name":"Enfants"},"nl":{"name":"Kinderen"},"en":{"name":"Children"}},"value":5},{"translations":{"fr":{"name":"Jeunes"},"nl":{"name":"Jongeren"},"en":{"name":"Young people"}},"value":5}],"child_events":[],"parent_events":[],"targets":{"list":[11],"translations":{"fr":["Famille"],"nl":["Familie"],"en":["Family"]}},"tags":["kids"],"accessibilities":{"list":[255,259,263,265,266],"translations":{"fr":["Accessible","Chien d'assistance","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9","Brussels Health Safety Label"],"nl":["Toegankelijk","Assistentiehonden","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet","Brussels Health Safety Label"],"en":["Accessible","Assistance dogs","Accessible to pedestrians with mobility aids","Adapted toilet","Brussels Health Safety Label"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-08-08T01:08:25+02:00","published_at":"2022-07-04T09:22:13+02:00","backoffice_id":257679,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.31833136784577},{"id":533841,"date_start":"2022-07-01","date_end":"2022-08-31","date_next":"2022-08-09","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":90,"translations":{"fr":"Animations","nl":"Animaties","en":"Animations"}},"others":{"list":[95],"translations":{"fr":["Patrimoine"],"nl":["Erfgoed"],"en":["Heritage"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Les tr\u00e9sors de Vlieg la mouche au Mus\u00e9e Art & Histoire !","shortdescr":"Un mus\u00e9e poussi\u00e9reux plein de vieux pots ? Et si je te disais que tu peux sentir ce que ces vieux pots contenaient ? Suis-moi dans le monde des Anciens Grecs !","longdescr":"Un mus\u00e9e poussi\u00e9reux plein de vieux pots ? Et si je te disais que tu peux sentir ce que ces vieux pots contenaient ? Suis-moi dans le monde des Anciens Grecs ! Il y a plus de 2000 ans, ce sont eux qui fabriquaient ces jolis pots et vases d\u00e9cor\u00e9s de dieux, de h\u00e9ros et de f\u00eates. Cherche celui dont on parle et r\u00e9alise la mission de l'odorat. Quand tu auras accompli toutes tes missions, rends-toi \u00e0 l'accueil pour ouvrir le coffre au tr\u00e9sor !\r\n\r\nParcours pour les familles avec enfants de 5 \u00e0 10 ans. \r\nCompris dans le ticket d'entr\u00e9e au Mus\u00e9e : 0\u20ac -18 ans \/ 4\u20ac \u00e9tudiants, professeurs \/ 8\u20ac +65 \/ 10\u20ac adultes\r\nDans le cadre de L'\u00e9t\u00e9 de Vlieg 2022 : Est-ce que tu sens ce que je sens ?","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.533841"},"nl":{"name":"Schatten van Vlieg in het Museum Kunst & Geschiedenis!","shortdescr":"Een stoffig museum vol saaie potten? Wel, als ik je nu eens vertel dat je kan ruiken wat er in zat? Volg mij, Vlieg, naar de wereld van de Oude Grieken!","longdescr":"Een stoffig museum vol saaie potten? Wel, als ik je nu eens vertel dat je kan ruiken wat er in zat? Volg mij, Vlieg, naar de wereld van de Oude Grieken! Meer dan 2000 jaar geleden maakten zij de prachtigste potten en vazen versierd met goden, helden en feesten. Zoek het voorwerp en doe de geuropdracht. Als je alle opdrachten gedaan hebt, mag je aan het onthaal de schatkist openen!\r\n\r\nSpeur- en snuffeltocht voor gezinnen met kinderen van 5 tot 10 jaar in gezinsverband. \r\nInbegrepen in een ticket: \u20ac0 -18 jaar\/\u20ac4 studenten, leerkrachten\/\u20ac8 +65\/\u20ac10 volwassenen\r\nI.k.v. De zomer van Vlieg 2022: ruik jij wat ik ruik?","performers":null,"boxoffice_url":null,"website":"https:\/\/www.artandhistory.museum","email":"info@kmkg.be","phone_contact":null,"phone_booking":"+32 2 741 73 02","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.533841"},"en":{"name":"Fly's treasures at the Art & History Museum!","shortdescr":"A dusty museum full of boring pots? Well, what if I told you you could smell what was in them? Follow me, Fly, to the world of the Ancient Greeks!","longdescr":"A dusty museum full of boring old pots? Well, what if I told you you could smell what was in them? Follow me, Fly, to the world of the Ancient Greeks! More than 2,000 years ago, they made the most beautiful pots and vases decorated with gods, heroes and feasts. Find the object and solve the question. When you have completed all tasks, you can open the treasure chest at the reception desk!\r\n\r\nDiscovery scent trail for families with children aged 5 to 10.\r\nIncluded in a ticket: \u20ac 0 -18 years \/ \u20ac 4 students, teachers \/ \u20ac 8 +65 \/ \u20ac 10 adults\r\nAs part of Treasures of Fly 2022: can you smell what I smell?","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.533841"},"de":{"name":"Schatten van Vlieg in het Museum Kunst & Geschiedenis!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.533841"},"it":{"name":"Schatten van Vlieg in het Museum Kunst & Geschiedenis!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.533841"},"sp":{"name":"Schatten van Vlieg in het Museum Kunst & Geschiedenis!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.533841"},"pt":{"name":"Schatten van Vlieg in het Museum Kunst & Geschiedenis!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.533841"},"cn":{"name":"Schatten van Vlieg in het Museum Kunst & Geschiedenis!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.533841"}},"place":{"id":61,"translations":{"fr":{"name":"Mus\u00e9e Art & Histoire (MRAH)","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Bruxelles","description_web":"Embarquez pour un fascinant voyage \u00e0 travers l'art et l'histoire. Venez fl\u00e2ner parmi les momies \u00e9gyptiennes et les silex pr\u00e9historiques, vous promener entre les verres anciens et prendre du recul pour mieux contempler d'impressionnantes tapisseries m\u00e9di\u00e9vales. Venez vous immerger dans le monde oriental en croisant des Bouddhas d'Asie et voyager jusqu'\u00e0 l'autre bout de la terre pour apercevoir une gigantesque statue de l'\u00eele de P\u00e2ques. La magnifique collection d'Art Nouveau vous attend au bout du voyage.\r\nLe Mus\u00e9e Art & Histoire fait partie des Mus\u00e9es royaux d\u2019Art et d\u2019Histoire, appellation qui chapeaute, outre le Mus\u00e9e Art & Histoire, le mim (Mus\u00e9e des Instruments de Musique), la Porte de Hal et les Mus\u00e9es d\u2019Extr\u00eame-Orient actuellement ferm\u00e9s.\r\n\r\n\r\nLe Mus\u00e9e Art & Histoire fait partie des Mus\u00e9es royaux d\u2019Art et d\u2019Histoire, appellation qui chapeaute, outre le Mus\u00e9e Art & Histoire, le mim (Mus\u00e9e des Instruments de Musique), la Porte de Hal et les Mus\u00e9es d\u2019Extr\u00eame-Orient actuellement ferm\u00e9s. ","description_print":"Le Mus\u00e9e du Cinquantenaire illustre les activit\u00e9s humaines et artistiques des cinq continents \u2013 hormis l\u2019Afrique noire \u2013, de la Pr\u00e9histoire \u00e0 nos jours. Les collections remplissent quatre b\u00e2timents et sont regroup\u00e9es en quatre d\u00e9partements: l\u2019Antiquit\u00e9, les civilisations extra-europ\u00e9ennes, l\u2019arch\u00e9ologie nationale et les arts d\u00e9coratifs europ\u00e9ens.","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Museum Kunst & Geschiedenis (KMKG)","address_street_name":"Jubelpark","address_street_number":"10","address_street_box":null,"email":"info@kmkg.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Brussel","address_line1":"Jubelpark, 10","address_line2":"1000 Brussel","description_web":"Maak een wereldreis door de geschiedenis! Wandel van prehistorische vuistbijlen naar Egyptische mummies. Snuistert tussen betoverende glas en zet een stap achteruit om de indrukwekkende Brusselse wandtapijten te bekijken. Ga de oosterse toer op tussen de Aziatische boeddha\u2019s en steek de Atlantische Oceaan over om Kuifjes \u2018beeldje met het gebroken oor\u2019. En dan is er nog de mooie collectie van Belgische art nouveau\u2026 U komt ogen en oren te kort!\r\n\r\nHet Museum Kunst & Geschiedenis maakt deel uit van de Koninklijke Musea voor Kunst en Geschiedenis (KMKG) die ook het Muziekinstrumentenmuseum (MIM), de Hallepoort en de Musea van het Verre Oosten (gesloten voor renovatie) bundelen.","description_print":"Het Jubelparkmuseum kan bogen op een imposante collectie kunstschatten en archeologische vondsten afkomstig uit de vijf continenten \u2013 met uitzondering van Zwart-Afrika \u2013 van de prehistorie tot op heden. De verzamelingen vullen vier gebouwen en zijn ingedeeld in evenveel departementen: Oudheid (het Nabije Oosten, Egypte, Griekenland, Rome en Byzantium), Niet-Europese Beschavingen (Islam, Azi\u00eb, Polynesi\u00eb & Micronesi\u00eb en Amerika), Nationale Archeologie en Europese Sierkunsten.","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Art & History Museum (RMAH)","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Brussels","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Brussels","description_web":"Embark on a fascinating journey through art and history! Come and stroll among the prehistoric flints and Egyptian mummies, walk between the ancient glasses and stand back to contemplate the impressive medieval tapestries. Immerse yourself in the oriental world as you pass Asian Buddhas and travel to the other side of the world to see a gigantic statue from Easter Island. You still have to admire the magnificent collection of Belgian Art Nouveau...\r\n\r\nThe Art & History Museum is part of the Royal Museums of Art and History (RMAH) that also cover the Musical Instruments Museum (MIM), Halle Gate and the Museums of the Far East (currently closed for renovation).","description_print":"The Cinquantenaire Museum is the headquarters of the Royal Museums of Art and History. It was erected at the end of the nineteenth century and is one of the most extensive museums in Belgium. The collections are divided according to four main themes: 1) National Archaeology; 2) Antiquity; 3) European Decorative Art; 4) Non-European Civilizations.","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Mus\u00e9e Art & Histoire (MRAH)","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Bruxelles","description_web":"Das Cinquantenaire-Museum, gelegen im Br\u00fcsseler Jubelpark, ist Teil der K\u00f6niglichen Museen f\u00fcr Kunst und Geschichte und bietet einen umfassenden und vielseitigen \u00dcberblick \u00fcber die Geschichte von den Hochkulturen der Antike bis hin zu den Kunststr\u00f6mungen der Gegenwart.\r\n\r\nAntike Sammlungen: \r\nDie antiken Sammlungen befassen sich mit den untergegangenen Hochkulturen von \u00c4gypten (Neuheit: das Grabmal von Nakht), Mesopotamien, Griechenland und Rom. Gezeigt werden au\u00dferdem die gro\u00dfen Kunststr\u00f6mungen Europas vom 10. Jahrhundert bis heute. Wandteppiche, Altaraufs\u00e4tze, Spitze, Goldschmiedekunst und Porzellan geh\u00f6ren zu den kostbaren H\u00f6hepunkten der Ausstellung.\r\n\r\nVon Mikronesien bis Amerika: \r\nDie nicht-europ\u00e4ischen Werke laden ihrerseits auf eine Reise ein: nach Mikronesien, Polynesien, Indien, S\u00fcdostasien, China und ins pr\u00e4kolumbische Amerika. In den eindrucksvollen Arch\u00e4ologie-S\u00e4len wird der Geschichte der Region von der Vorgeschichte bis zur Epoche der Merowinger neues Leben eingehaucht.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Museo Arte & Historia","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Bruxelles","description_web":"Situato nel cuore del complesso del Cinquantenario, il Mus\u00e9e du Cinquantenaire vi invita a viaggiatore attraverso i continenti dalla Preistoria al XX secolo. \r\n\r\n\r\nLe sue ricche collezioni sono suddivise in quattro grandi sezioni :\r\n\r\n- L'Antichit\u00e0 dove sono presentate le grandi civilt\u00e0 scomparse dell'Egitto, della Mesopotamia, della Grecia e di Roma.\r\n- Le Arti decorative europee dove scoprire le correnti artistiche dal X secolo ai giorni nostri.\r\n- Le Civilt\u00e0 non europee che invitano al viaggio: India, Sudest asiatico, Cina, America precolombiana.\r\n- L'archeologia nazionale per rivivere il passato delle nostre regioni, dalla Preistoria al periodo merovingio.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Museo de Arte e Historia","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Bruxelles","description_web":"Ad\u00e9ntrate en este edificio hist\u00f3rico, uno de los mayores museos de B\u00e9lgica erigido por el anterior rey belga Leopoldo II. Descubre una gran cantidad de objetos desde la prehistoria hasta la antig\u00fcedad y de las artes aplicadas europeas hasta una amplia colecci\u00f3n de arte no europea. Explora todo, incluyendo las interesantes exposiciones temporales, conferencias y otras actividades. Desafortunadamente, la p\u00e1gina web no es tan amplia como para mostrar toda nuestra colecci\u00f3n, compuesta por miles de tesoros del arte y objetos hist\u00f3ricos. Sin embargo, esperamos que nos visites y disfrutes descubriendo o redescubriendo el inmenso patrimonio que gestionamos y exhibimos. De hecho, para nosotros el arte y la historia no son muerte y temas pasados, si no una viva y constante fuente de inspiraci\u00f3n y diversi\u00f3n.\r\n\r\nEl Museo de Arte e Historia es parte de los Museos Reales de Arte e Historia(MRAH), que incluye el Museo de Instrumentos Musicales(MIM), la Puerta de Hal y los Museos del Lejano Oriente(recientemente cerrado por renovaciones).\r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Museu de Arte e Hist\u00f3ria (MRAH)","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Bruxelles","description_web":"Da arqueologia nacional \u00e0s artes decorativas europeias, passando pela antiguidade cl\u00e1ssica e pelas civiliza\u00e7\u00f5es n\u00e3o europeias, embarque numa fascinante viagem atrav\u00e9s da arte e da hist\u00f3ria num edif\u00edcio magn\u00edfico criado por L\u00e9opold II no parque do Cinquenten\u00e1rio em Bruxelas.\r\n\r\n-  Museu do Cinquenten\u00e1rio muda de pele e torna-se o Museu de Arte e Hist\u00f3ria!\r\n-  Museu do Cinquenten\u00e1rio desenvolveu um trabalho de reflex\u00e3o sobre a sua imagem. Este resultou numa campanha de reorganiza\u00e7\u00e3o global da institui\u00e7\u00e3o. Come\u00e7ou assim uma reconquista museogr\u00e1fica: a decis\u00e3o de organizar exposi\u00e7\u00f5es tempor\u00e1rias baseadas nas pr\u00f3prias cole\u00e7\u00f5es do museu e de renovar progressivamente as salas permanentes, come\u00e7ando pelo armaz\u00e9m Wolfers, que foi a primeira etapa de uma s\u00e9rie de outras renova\u00e7\u00f5es (salas Egito, salas s\u00e9culos XIX e XX, maqueta de Roma\u2026) que atingem rapidamente a sua velocidade de cruzeiro. O\r\n- Museu de Arte e Hist\u00f3ria pertence aos Museus Reais de Arte e da Hist\u00f3ria, que englobam, para al\u00e9m deste, o MIM (Museu dos Instrumentos Musicais), a Porta de Hal e os Museus do Extremo Oriente, atualmente encerrados.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Mus\u00e9e Art & Histoire (MRAH)","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[9],"translations":{"fr":["Quartier europ\u00e9en"],"nl":["Europese wijk"],"en":["European Quarter"]}},"zones":{"list":[22],"translations":{"fr":["Est"],"nl":["Oost"],"en":["East"]}},"neca":null,"facebook_id":null,"backoffice_id":12,"location":{"lat":50.83935087,"lon":4.3917188},"region":"brussels","last_updated_at":"2022-08-08T01:08:26+02:00","published_at":"2013-10-19T01:13:13+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":61,"translations":{"fr":{"name":"Mus\u00e9e Art & Histoire (MRAH)","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Bruxelles","description_web":"Embarquez pour un fascinant voyage \u00e0 travers l'art et l'histoire. Venez fl\u00e2ner parmi les momies \u00e9gyptiennes et les silex pr\u00e9historiques, vous promener entre les verres anciens et prendre du recul pour mieux contempler d'impressionnantes tapisseries m\u00e9di\u00e9vales. Venez vous immerger dans le monde oriental en croisant des Bouddhas d'Asie et voyager jusqu'\u00e0 l'autre bout de la terre pour apercevoir une gigantesque statue de l'\u00eele de P\u00e2ques. La magnifique collection d'Art Nouveau vous attend au bout du voyage.\r\nLe Mus\u00e9e Art & Histoire fait partie des Mus\u00e9es royaux d\u2019Art et d\u2019Histoire, appellation qui chapeaute, outre le Mus\u00e9e Art & Histoire, le mim (Mus\u00e9e des Instruments de Musique), la Porte de Hal et les Mus\u00e9es d\u2019Extr\u00eame-Orient actuellement ferm\u00e9s.\r\n\r\n\r\nLe Mus\u00e9e Art & Histoire fait partie des Mus\u00e9es royaux d\u2019Art et d\u2019Histoire, appellation qui chapeaute, outre le Mus\u00e9e Art & Histoire, le mim (Mus\u00e9e des Instruments de Musique), la Porte de Hal et les Mus\u00e9es d\u2019Extr\u00eame-Orient actuellement ferm\u00e9s. ","description_print":"Le Mus\u00e9e du Cinquantenaire illustre les activit\u00e9s humaines et artistiques des cinq continents \u2013 hormis l\u2019Afrique noire \u2013, de la Pr\u00e9histoire \u00e0 nos jours. Les collections remplissent quatre b\u00e2timents et sont regroup\u00e9es en quatre d\u00e9partements: l\u2019Antiquit\u00e9, les civilisations extra-europ\u00e9ennes, l\u2019arch\u00e9ologie nationale et les arts d\u00e9coratifs europ\u00e9ens.","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Museum Kunst & Geschiedenis (KMKG)","address_street_name":"Jubelpark","address_street_number":"10","address_street_box":null,"email":"info@kmkg.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Brussel","address_line1":"Jubelpark, 10","address_line2":"1000 Brussel","description_web":"Maak een wereldreis door de geschiedenis! Wandel van prehistorische vuistbijlen naar Egyptische mummies. Snuistert tussen betoverende glas en zet een stap achteruit om de indrukwekkende Brusselse wandtapijten te bekijken. Ga de oosterse toer op tussen de Aziatische boeddha\u2019s en steek de Atlantische Oceaan over om Kuifjes \u2018beeldje met het gebroken oor\u2019. En dan is er nog de mooie collectie van Belgische art nouveau\u2026 U komt ogen en oren te kort!\r\n\r\nHet Museum Kunst & Geschiedenis maakt deel uit van de Koninklijke Musea voor Kunst en Geschiedenis (KMKG) die ook het Muziekinstrumentenmuseum (MIM), de Hallepoort en de Musea van het Verre Oosten (gesloten voor renovatie) bundelen.","description_print":"Het Jubelparkmuseum kan bogen op een imposante collectie kunstschatten en archeologische vondsten afkomstig uit de vijf continenten \u2013 met uitzondering van Zwart-Afrika \u2013 van de prehistorie tot op heden. De verzamelingen vullen vier gebouwen en zijn ingedeeld in evenveel departementen: Oudheid (het Nabije Oosten, Egypte, Griekenland, Rome en Byzantium), Niet-Europese Beschavingen (Islam, Azi\u00eb, Polynesi\u00eb & Micronesi\u00eb en Amerika), Nationale Archeologie en Europese Sierkunsten.","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Art & History Museum (RMAH)","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Brussels","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Brussels","description_web":"Embark on a fascinating journey through art and history! Come and stroll among the prehistoric flints and Egyptian mummies, walk between the ancient glasses and stand back to contemplate the impressive medieval tapestries. Immerse yourself in the oriental world as you pass Asian Buddhas and travel to the other side of the world to see a gigantic statue from Easter Island. You still have to admire the magnificent collection of Belgian Art Nouveau...\r\n\r\nThe Art & History Museum is part of the Royal Museums of Art and History (RMAH) that also cover the Musical Instruments Museum (MIM), Halle Gate and the Museums of the Far East (currently closed for renovation).","description_print":"The Cinquantenaire Museum is the headquarters of the Royal Museums of Art and History. It was erected at the end of the nineteenth century and is one of the most extensive museums in Belgium. The collections are divided according to four main themes: 1) National Archaeology; 2) Antiquity; 3) European Decorative Art; 4) Non-European Civilizations.","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Mus\u00e9e Art & Histoire (MRAH)","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Bruxelles","description_web":"Das Cinquantenaire-Museum, gelegen im Br\u00fcsseler Jubelpark, ist Teil der K\u00f6niglichen Museen f\u00fcr Kunst und Geschichte und bietet einen umfassenden und vielseitigen \u00dcberblick \u00fcber die Geschichte von den Hochkulturen der Antike bis hin zu den Kunststr\u00f6mungen der Gegenwart.\r\n\r\nAntike Sammlungen: \r\nDie antiken Sammlungen befassen sich mit den untergegangenen Hochkulturen von \u00c4gypten (Neuheit: das Grabmal von Nakht), Mesopotamien, Griechenland und Rom. Gezeigt werden au\u00dferdem die gro\u00dfen Kunststr\u00f6mungen Europas vom 10. Jahrhundert bis heute. Wandteppiche, Altaraufs\u00e4tze, Spitze, Goldschmiedekunst und Porzellan geh\u00f6ren zu den kostbaren H\u00f6hepunkten der Ausstellung.\r\n\r\nVon Mikronesien bis Amerika: \r\nDie nicht-europ\u00e4ischen Werke laden ihrerseits auf eine Reise ein: nach Mikronesien, Polynesien, Indien, S\u00fcdostasien, China und ins pr\u00e4kolumbische Amerika. In den eindrucksvollen Arch\u00e4ologie-S\u00e4len wird der Geschichte der Region von der Vorgeschichte bis zur Epoche der Merowinger neues Leben eingehaucht.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Museo Arte & Historia","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Bruxelles","description_web":"Situato nel cuore del complesso del Cinquantenario, il Mus\u00e9e du Cinquantenaire vi invita a viaggiatore attraverso i continenti dalla Preistoria al XX secolo. \r\n\r\n\r\nLe sue ricche collezioni sono suddivise in quattro grandi sezioni :\r\n\r\n- L'Antichit\u00e0 dove sono presentate le grandi civilt\u00e0 scomparse dell'Egitto, della Mesopotamia, della Grecia e di Roma.\r\n- Le Arti decorative europee dove scoprire le correnti artistiche dal X secolo ai giorni nostri.\r\n- Le Civilt\u00e0 non europee che invitano al viaggio: India, Sudest asiatico, Cina, America precolombiana.\r\n- L'archeologia nazionale per rivivere il passato delle nostre regioni, dalla Preistoria al periodo merovingio.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Museo de Arte e Historia","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Bruxelles","description_web":"Ad\u00e9ntrate en este edificio hist\u00f3rico, uno de los mayores museos de B\u00e9lgica erigido por el anterior rey belga Leopoldo II. Descubre una gran cantidad de objetos desde la prehistoria hasta la antig\u00fcedad y de las artes aplicadas europeas hasta una amplia colecci\u00f3n de arte no europea. Explora todo, incluyendo las interesantes exposiciones temporales, conferencias y otras actividades. Desafortunadamente, la p\u00e1gina web no es tan amplia como para mostrar toda nuestra colecci\u00f3n, compuesta por miles de tesoros del arte y objetos hist\u00f3ricos. Sin embargo, esperamos que nos visites y disfrutes descubriendo o redescubriendo el inmenso patrimonio que gestionamos y exhibimos. De hecho, para nosotros el arte y la historia no son muerte y temas pasados, si no una viva y constante fuente de inspiraci\u00f3n y diversi\u00f3n.\r\n\r\nEl Museo de Arte e Historia es parte de los Museos Reales de Arte e Historia(MRAH), que incluye el Museo de Instrumentos Musicales(MIM), la Puerta de Hal y los Museos del Lejano Oriente(recientemente cerrado por renovaciones).\r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Museu de Arte e Hist\u00f3ria (MRAH)","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Bruxelles","description_web":"Da arqueologia nacional \u00e0s artes decorativas europeias, passando pela antiguidade cl\u00e1ssica e pelas civiliza\u00e7\u00f5es n\u00e3o europeias, embarque numa fascinante viagem atrav\u00e9s da arte e da hist\u00f3ria num edif\u00edcio magn\u00edfico criado por L\u00e9opold II no parque do Cinquenten\u00e1rio em Bruxelas.\r\n\r\n-  Museu do Cinquenten\u00e1rio muda de pele e torna-se o Museu de Arte e Hist\u00f3ria!\r\n-  Museu do Cinquenten\u00e1rio desenvolveu um trabalho de reflex\u00e3o sobre a sua imagem. Este resultou numa campanha de reorganiza\u00e7\u00e3o global da institui\u00e7\u00e3o. Come\u00e7ou assim uma reconquista museogr\u00e1fica: a decis\u00e3o de organizar exposi\u00e7\u00f5es tempor\u00e1rias baseadas nas pr\u00f3prias cole\u00e7\u00f5es do museu e de renovar progressivamente as salas permanentes, come\u00e7ando pelo armaz\u00e9m Wolfers, que foi a primeira etapa de uma s\u00e9rie de outras renova\u00e7\u00f5es (salas Egito, salas s\u00e9culos XIX e XX, maqueta de Roma\u2026) que atingem rapidamente a sua velocidade de cruzeiro. O\r\n- Museu de Arte e Hist\u00f3ria pertence aos Museus Reais de Arte e da Hist\u00f3ria, que englobam, para al\u00e9m deste, o MIM (Museu dos Instrumentos Musicais), a Porta de Hal e os Museus do Extremo Oriente, atualmente encerrados.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Mus\u00e9e Art & Histoire (MRAH)","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Bruxelles","descri