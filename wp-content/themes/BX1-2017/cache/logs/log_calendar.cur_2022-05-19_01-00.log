ccept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre"}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"R\u00e9zo","shortdescr":"Une conf\u00e9rence gesticul\u00e9e qui d\u00e9shabille les r\u00e9seaux sociaux, la collecte des donn\u00e9es et le capitalisme de surveillance.","longdescr":"Trois ans apr\u00e8s Un mot \u00e0 retenir et sa r\u00e9flexion sur les d\u00e9rives s\u00e9curitaires, la Compagnie Artaban zoome, dans son nouveau spectacle R\u00e9zo, sur le syst\u00e8me d'utilisation des donn\u00e9es par les r\u00e9seaux sociaux. Une fois l'interface utilisateur d\u00e9pass\u00e9e, qu'est-ce qu'un r\u00e9seau social ?\r\n\r\n\u00c0 travers un spectacle qui se veut analogique, nous partons explorer les implications concr\u00e8tes de nos activit\u00e9s num\u00e9riques et leurs impacts : addictions, r\u00e9duction de la vie priv\u00e9e, polarisation des opinions, troubles des repr\u00e9sentations de soi et du monde, bulles informationnelles. Les r\u00e9seaux sociaux affectent chaque aspect de nos vies, depuis nos relations sociales, jusqu\u2019\u00e0 nos visions politiques et m\u00eame nos d\u00e9mocraties, mais dans quel but ?\r\n\r\nLoin des critiques habituelles et g\u00e9n\u00e9rationnelles sur les r\u00e9seaux sociaux, loin de la culpabilisation, R\u00e9zo analyse ce m\u00e9canisme profond\u00e9ment d\u00e9l\u00e9t\u00e8re qui reste \u00e0 combattre.\r\n\r\nCe spectacle, solidement \u00e9tay\u00e9 par une litt\u00e9rature scientifique rigoureuse, se veut pourtant tr\u00e8s accessible. Il est con\u00e7u sous forme de conf\u00e9rence gesticul\u00e9e qui alterne entre des sayn\u00e8tes humoristiques mises en sc\u00e8nes et des moments plus explicatifs et imag\u00e9s. Le tout \u00e9volue au rythme du public, qui, \u00e9tant sollicit\u00e9 en permanence, participe pleinement \u00e0 l\u2019histoire.\r\n\r\nCe sujet, profond\u00e9ment ancr\u00e9 dans nos quotidiens, suscite bien des questions. Ainsi, le spectacle est suivi d\u2019un bord de sc\u00e8ne. Il peut \u00e9galement s\u2019accompagner d\u2019un atelier en partenariat avec l'asbl Article 27, nous amenant \u00e0 r\u00e9fl\u00e9chir sur notre relation aux m\u00e9dias.","performers":"Avec Antoine Giet\r\nPar Antoine Motte dit Falisse\r\nProduction : Article 27 asbl\r\nCoproduction : Centre Culturel Bruegel & Compagnie Artaban","boxoffice_url":null,"website":"http:\/\/www.ccbruegel.be","email":"info@ccbruegel.be","phone_contact":null,"phone_booking":"+32 2 503 42 68","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/532976.html"},"nl":{"name":"R\u00e9zo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/532976.html"},"en":{"name":"R\u00e9zo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/532976.html"},"de":{"name":"R\u00e9zo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/532976.html"},"it":{"name":"R\u00e9zo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/532976.html"},"sp":{"name":"R\u00e9zo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website