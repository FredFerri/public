n Meisterwerken des 20. Jahrhunderts, darunter Broodthaers, Fabre, David, Panamarenko, Alechinsky.\r\n\r\n\u2022\tDie beiden Kunstatelier-Museen Mus\u00e9e Wiertz und Meunier in Ixelles geben einen faszinierenden Einblick in die Welt dieser beiden K\u00fcnstler.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Mus\u00e9es Royaux des Beaux-Arts de Belgique","address_street_name":"Rue de la R\u00e9gence","address_street_number":"3","address_street_box":null,"email":"info@fine-arts-museum.be","website":"http:\/\/www.fine-arts-museum.be","phone_contact":"+32 2 508 32 11","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la R\u00e9gence, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Royal Museums of Fine Arts of Belgium","address_street_name":"rue de la R\u00e9gence","address_street_number":"3","address_street_box":null,"email":"info@fine-arts-museum.be","website":"http:\/\/www.fine-arts-museum.be","phone_contact":"+32 2 508 32 11","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"rue de la R\u00e9gence, 3","address_line2":"1000 Brussels","description_web":"The Royal Museums of Fine Arts of Belgium assemble six different museums: the Oldmasters Museum, Modern Museum, Meunier Museum, Wiertz Museum, Magritte Museum and the Fin-de-Si\u00e8cle Museum.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Museo Reale delle Belle Arti del Belgio","address_street_name":"Rue de la R\u00e9gence","address_street_number":"3","address_street_box":null,"email":"info@fine-arts-museum.be","website":"http:\/\/www.fine-arts-museum.be\/","phone_contact":"+32 2 508 32 11","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la R\u00e9gence, 3","address_line2":"1000 Bruxelles","description_web":"I Musei Reali delle Belle Arti del Belgio sono sei musei di Bruxelles: l'Oldmasters Museum, il Mus\u00e9e Modern, il Meunier Museum, il Wiertz Museum, il Magritte Museum ed il Fin-de-si\u00e8cle Museum.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Mus\u00e9es Royaux des Beaux-Arts de Belgique","address_street_name":"Rue de la R\u00e9gence","address_street_number":"3","address_street_box":null,"email":"info@fine-arts-museum.be","website":"http:\/\/www.fine-arts-museum.be","phone_contact":"+32 2 508 32 11","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la R\u00e9gence, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Mus\u00e9es Royaux des Beaux-Arts de Belgique","address_street_name":"Rue de la R\u00e9gence","address_street_number":"3","address_street_box":null,"email":"info@fine-arts-museum.be","website":"http:\/\/www.fine-arts-museum.be","phone_contact":"+32 2 508 32 11","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la R\u00e9gence, 3","address_line2":"1000 Bruxelles","description_web":"Les Mus\u00e9es Royaux des Beaux-Arts de Belgique sont constitu\u00e9s de six mus\u00e9es bruxellois: le Mus\u00e9e Oldmasters Museum, le Mus\u00e9e Modern Museum, le Mus\u00e9e Meunier Museum, le Mus\u00e9e Wiertz Museum, le Magritte Museum et le Mus\u00e9e fin-de-si\u00e8cle Museum.","description_print":null,"booking_url":null,"sort_order":"Royal Museums of Fine Arts of Belgium","virtual_visit":null,"visit_url":null},"sp":{"name":"Museos Reales de Bellas Artes de B\u00e9lgica","address_street_name":"rue de la R\u00e9gence","address_street_number":"3","address_street_box":null,"email":"info@fine-arts-museum.be","website":"http:\/\/www.fine-arts-museum.be","phone_contact":"+32 2 508 32 11","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"rue de la R\u00e9gence, 3","address_line2":"1000 Bruxelles","description_web":"Los Museos Reales de Bellas Artes de B\u00e9lgica son seis museos situados en Bruselas: el Museo de Arte Antiguo, el Museo de Arte Moderno, el Museo Meunier, el Museo Wiertz, el Museo Magritte y el Museo de Fin de Siglo.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Koninklijke Musea voor Schone Kunsten van Belgi\u00eb","address_street_name":"Regentschapsstraat","address_street_number":"3","address_street_box":null,"email":"info@fine-arts-museum.be","website":"http:\/\/www.fine-arts-museum.be","phone_contact":"+32 2 508 32 11","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Regentschapsstraat, 3","address_line2":"1000 Brussel","description_web":"Onder de hoede van de Koninklijke Musea voor Schone Kunsten van Belgi\u00eb staan zes afzonderlijke musea: het Mus\u00e9e Oldmasters Museum, het Mus\u00e9e Modern Museum, het Mus\u00e9e Meunier Museum, het Mus\u00e9e Wiertz Museum, het Magritte Museum en het Mus\u00e9e fin-de-si\u00e8cle Museum.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":"art_center","facebook_id":null,"region":"brussels","backoffice_id":117,"location":{"lat":50.84167178,"lon":4.35824947},"last_updated_at":"2024-05-29T15:52:41+02:00","published_at":"2013-10-19T01:13:17+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/d67452e6fb576c8713f30f9fce3209aa9d068152.png","width":2160,"height":2872,"ratio":0.75,"oEmbed_height":2872,"oEmbed_width":2160,"translations":{"de":{"title":"MRBAB","copyright":"MRBAB, Brussels"},"pt":{"title":"