partoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2023-10-16T02:03:08+02:00","published_at":"2023-07-10T11:48:43+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":281639,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"theatre","ranking":0.2832581674713524,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":49,"translations":{"de":"Theater","pt":null,"en":"Theatre","it":"Teatro","cn":null,"fr":"Th\u00e9\u00e2tre","sp":"Teatro","nl":"Theater"}},"others":{"list":[50],"translations":{"de":["Theater"],"pt":[null],"en":["Theatre"],"it":["Teatro"],"cn":[null],"fr":["Th\u00e9\u00e2tre"],"sp":["Teatro"],"nl":["Theater"]}}},"translations":{"de":{"name":"Sous mes ailes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrecreanova.be\/programmation\/#sous-mes-ailes","email":"adm@theatrecreanova.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.561639"},"pt":{"name":"Sous mes ailes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrecreanova.be\/programmation\/#sous-mes-ailes","email":"adm@theatrecreanova.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.561639"},"en":{"name":"Sous mes ailes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrecreanova.be\/programmation\/#sous-mes-ailes","email":"adm@theatrecreanova.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.561639"},"it":{"name":"Sous mes ailes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrecreanova.be\/programmation\/#sous-mes-ailes","email":"adm@theatrecreanova.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.561639"},"cn":{"name":"Sous mes ailes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrecreanova.be\/programmation\/#sous-mes-ailes","email":"adm@theatrecreanova.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.561639"},"fr":{"name":"Sous mes ailes","shortdescr":"Comment \u00e9lever ses enfants dans un monde en pleine d\u00e9rive ? Comment ne pas s'\u00e9puiser physiquement, psychiquement et s'y perdre soi-m\u00eame ? Que faire pour sortir de la spirale infernale qui se cr\u00e9\u00e9 autour de nous ?","longdescr":"Spectacle dystopique pour mieux entrevoir la fragilit\u00e9 de nos soci\u00e9t\u00e9s contemporaines en 2023. Inspir\u00e9e d'Orwell (1984), la pi\u00e8ce interroge les d\u00e9rives de notre syst\u00e8me, alerte sur ses limites, participe en quelque sorte \u00e0 la sortie du d\u00e9ni g\u00e9n\u00e9ralis\u00e9 pour finalement contribuer au passage \u00e0 l'action \u00e0 travers une lutte collective qui revendique une autre mani\u00e8re de faire soci\u00e9t\u00e9.\n\nL'auteure-metteure en sc\u00e8ne a choisi d'observer ces d\u00e9rives \u00e0 travers le prisme des m\u00e8res, comme si leur ressenti en tant que responsables des adultes de demain pouvait nous servir de loupe grossissante.\n\nV\u00e9ritables boucs \u00e9missaires d\u2019une soci\u00e9t\u00e9 r\u00e9gie par un pouvoir orwellien qui exerce un contr\u00f4le total et extr\u00eamement culpabilisant, les m\u00e8res de la pi\u00e8ce doivent r\u00e9pondre aux plus grandes attentes : mettre tout en \u0153uvre, seules, pour faire de leur prog\u00e9niture les tant attendus g\u00e9nies qui r\u00e9inventeront le monde. Pour cela, elles sont trac\u00e9es et r\u00e9f\u00e9renc\u00e9es selon leur niveau de r\u00e9ussite. Des statistiques sont \u00e9tablies. Combien de m\u00e8res exemplaires, de m\u00e8res col\u00e9riques, incapables, indignes, indiff\u00e9rentes. M\u00e8res trop. M\u00e8res pas assez. ","performers":"Ecrit et mis en sc\u00e8ne par Carole Ventura  \nCollaboration artistique Luca Franceschi l Interpr\u00e9t\u00e9 par Luca Franceschi, Maximilien Le Meledo, Julie Marichal, Carole Ventura, \nAvec le soutien de F\u00e9d\u00e9ration Wallonie Bruxelles  - Un Futur pour la Culture, de la Commune de Saint Gilles, taxshelter.be, ING et du Tax-shelter du gouvernement f\u00e9d\u00e9ral belge.","boxoffice_url":null,"website":"https:\/\/www.theatrecreanova.be\/programmation\/#sous-mes-ailes","email":"adm@theatrecreanova.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.561639"},"sp":{"name":"Sous mes ailes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrecreanova.be\/programmation\/#sous-mes-ailes","email":"adm@theatrecreanova.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.561639"},"nl":{"name":"Sous mes ailes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrecreanova.be\/programmation\/#sous-mes-ailes","email":"adm@theatrecreanova.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.561639"}},"place":{"id":275475,"translations":{"de":{"name":"Th\u00e9\u00e2tre CreaNova","address_street_name":"rue de la victoire ","address_street_number":"96","address_street_box":"1060","email":"contact@creabxl.org","website":"http:\/\/www.creatheatrebruxelles.be","phone_contact":"+32 4