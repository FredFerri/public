0004314,"date_start":"2025-02-08","date_end":"2025-04-05","date_next":"2025-03-21","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2025-03-21T12:52:35+01:00","published_at":"2024-12-05T14:11:11+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":313242,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"other","ranking":0.2598414203059447,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exposici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[28,24],"translations":{"de":["Grafische K\u00fcnste","Kunstgalerien"],"pt":[null,null],"en":["Graphic art","Art Galleries"],"it":["Arti grafiche","Gallerie d'arte"],"cn":[null,null],"fr":["Arts graphiques","Galeries d'art"],"sp":["Artes gr\u00e1ficas","Galer\u00edas de arte"],"nl":["Grafische kunst, vormgeving","Galeries"]}}},"translations":{"de":{"name":"Yann Kebbi | Las Vegas Travel Book","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/galeriemartel.com","email":"contact@galeriemartel.fr","phone_contact":"+32 2 721 79 57","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700004314"},"pt":{"name":"Yann Kebbi | Las Vegas Travel Book","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/galeriemartel.com","email":"contact@galeriemartel.fr","phone_contact":"+32 2 721 79 57","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700004314"},"en":{"name":"Yann Kebbi | Las Vegas Travel Book","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/galeriemartel.com","email":"contact@galeriemartel.fr","phone_contact":"+32 2 721 79 57","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700004314"},"it":{"name":"Yann Kebbi | Las Vegas Travel Book","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/galeriemartel.com","email":"contact@galeriemartel.fr","phone_contact":"+32 2 721 79 57","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700004314"},"cn":{"name":"Yann Kebbi | Las Vegas Travel Book","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/galeriemartel.com","email":"contact@galeriemartel.fr","phone_contact":"+32 2 721 79 57","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700004314"},"fr":{"name":"Yann Kebbi | Las Vegas Travel Book","shortdescr":"V\u00e9ritable virtuose de la composition graphique, Yann Kebbi fa\u00e7onne des sc\u00e8nes aux d\u00e9tails foisonnants, o\u00f9 la g\u00e9om\u00e9trie occupe une place de choix. Pour les \u00e9ditions Louis Vuitton, il a captur\u00e9 les rues, h\u00f4tels et casinos de Las Vegas pour en livrer une interpr\u00e9tation saisissante. \u00c0 partir du 8 f\u00e9vrier 2025, la Galerie Martel BXL expose les oeuvres originales issues de ce \"Travel Book\".\n\n","longdescr":"Yann Kebbi a d\u00e9couvert la ville en 2012, y passant deux jours lors d\u2019un voyage \u00e0 travers les \u00c9tats-Unis. Il y est revenu dix ans plus tard, dans l\u2019euphorie post-Covid, o\u00f9 la population se retrouvait \u00e0 nouveau pour red\u00e9couvrir le monde ext\u00e9rieur. Le Las Vegas du XXIe si\u00e8cle est devenu un lieu o\u00f9, malgr\u00e9 la chaleur apocalyptique, les Am\u00e9ricains affluent pour y \u00e9lire domicile et r\u00e9inventer leur vie dans un confort climatis\u00e9. \n\nLes lignes de Kebbi capturent cette chaleur, cette lumi\u00e8re qui inondent ce lieu. Il donne vie \u00e0 ses images en remplissant plusieurs carnets de dessins au crayon de couleur, r\u00e9alis\u00e9s sur place. Dans son atelier parisien, il compose ses sc\u00e8nes horizontales, utilisant parfois un marqueur noir \u00e9pais pour tester la composition globale. Une fois le mat\u00e9riel source et la conception de la feuille en place, il r\u00e9alise l\u2019\u0153uvre finale.\n\nCe projet de Las Vegas est sa contribution \u00e0 la grande tradition du reportage visuel, popularis\u00e9 dans les ann\u00e9es 1960, o\u00f9 des artistes dessinaient villes et \u00e9v\u00e9nements en Am\u00e9rique et en Europe pour des magazines. C\u2019est un genre qui permet \u00e0 l\u2019artiste de conter des histoires sp\u00e9cifiques et \u00e9piques \u2014 et dans le cas de Kebbi, de le faire simultan\u00e9ment par des dessins impr\u00e9gn\u00e9s de couleurs qui traduisent le cadre, les rues et l'\u00e9tendue de Las Vegas autant que les personnes et les attitudes qui animent cet ensemble.","performers":null,"boxoffice_url":null,"website":"http:\/\/galeriemartel.com","email":"contact@galeriemartel.fr","phone_contact":"+32 2 721 79 57","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700004314"},"sp":{"name":"Yann Kebbi | Las Vegas Travel Book","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/galeriemartel.com","email":"contact@galeriemartel.fr","phone_contact":"+32 2 721 79 57","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700004314"},"nl":{"name":"Yann Kebbi | Las Vegas Travel Book","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/galeriemartel.com","email":"contact@galeriemartel.fr","phone_contact":"+32 2 7