ay and sunday: closed"],"it":["monday, tuesday, wednesday, thursday, friday, saturday and sunday: closed"],"sp":["monday, tuesday, wednesday, thursday, friday, saturday and sunday: closed"],"pt":["monday, tuesday, wednesday, thursday, friday, saturday and sunday: closed"],"cn":["monday, tuesday, wednesday, thursday, friday, saturday and sunday: closed"]},"date_start":"2023-06-17","date_end":"2023-07-15","is_also_by_appointment":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"},"de":{"name":"Normal"},"it":{"name":"Normale"},"sp":{"name":"Normal"},"pt":{"name":"Normal"},"cn":{"name":"Normal"}},"value":170}],"child_events":[],"parent_events":[545331],"targets":{"list":[],"translations":{}},"visit_content":{"list":[428],"values":["brussels-renaissance-festival"]},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-07-08T03:35:27+02:00","published_at":"2023-03-31T13:19:24+02:00","backoffice_id":274658,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.32548726473767},{"id":554665,"date_start":"2023-06-17","date_end":"2023-07-15","date_next":"2023-07-08","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":true,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen","it":"Visite guidate","sp":"Visitas guiadas","pt":null,"cn":null}},"others":{"list":[108],"translations":{"fr":["Folklore"],"nl":["Folklore"],"en":["Folklore"],"de":["Folklore"],"it":["Folklore"],"sp":["Folclore"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Us et coutumes de la Renaissance: Bruxelles, ville fortifi\u00e9e","shortdescr":"Cet \u00ab Itin\u00e9raires \u00bb reviendra sur le passage d'une enceinte seigneuriale \u00e0 une enceinte bourgeoise. Quels \u00e9taient les habitudes des citadins de l\u2019\u00e9poque ?","longdescr":"Imaginez-vous Bruxelles \u00e0 la Renaissance : la ville est prot\u00e9g\u00e9e par une enceinte\u2026 ou plut\u00f4t deux.. La premi\u00e8re date du d\u00e9but du 13\u00e8me si\u00e8cle, la seconde du 14\u00e8me si\u00e8cle. D\u2019une enceinte de 4km ponctu\u00e9e de sept portes, Bruxelles passera \u00e0 une enceinte de 8km ! Elles coexisteront jusqu\u2019\u00e0 la Renaissance\u2026 Cet \u00ab Itin\u00e9raires \u00bb reviendra sur le passage d'une enceinte seigneuriale \u00e0 une enceinte bourgeoise. Quels \u00e9taient les habitudes des citadins de l\u2019\u00e9poque ? Quel impact cela a-t-il eu sur les orientations oppos\u00e9es des deux murailles et leurs excroissances respectives ? Vous ne regarderez plus ces vestiges de la m\u00eame mani\u00e8re !\r\n\r\nVisite privative, sur mesure et \u00e0 la demande","performers":null,"boxoffice_url":null,"website":"http:\/\/www.itineraires.be","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.554665"},"nl":{"name":"Brussel, versterkte stad","shortdescr":"Deze wandeling staat stil bij de overgang van een feodale omwalling naar een stadsmuur. Welke gewoonten huldigden de be- woners van de stad in die periode?","longdescr":"Zo zag Brussel eruit in de Renaissance: een stad beschermd door een omwalling... of twee. De eerste dateert uit het begin van de 13e eeuw, de tweede uit de 14de eeuw. Waar de oorspronkelijke omwalling rond Brussel 4 km lang was en zeven stadspoorten telde, haalde de tweede een lengte van 8 km! Tot in de Renaissan- ce bestonden ze naast elkaar \u2026 Deze wandeling staat stil bij de overgang van een feodale omwalling naar een stadsmuur. Welke gewoonten huldigden de be- woners van de stad in die periode? Wat was de impact op de tegengestelde func- ties van beide ringmuren die uit hun voegen barstten? U zal de overblijfselen voortaan met andere ogen bekijken!\r\n\r\nPriv\u00e9bezoek, georganiseerd op aanvraag en op maat","performers":null,"boxoffice_url":null,"website":"http:\/\/www.itineraires.be","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.554665"},"en":{"name":"Brussels, fortified town","shortdescr":"This itinerary follows the change from a lordly precinct to a bourgeois town. What were the customs of its citizens at that time?","longdescr":"Imagine Brussels in the Renaissance: the city is protected by a wall... or rather two. The first city wall dates from the early 13th century, and the second from the 14th century. Starting with a wall 4 km long and seven gates, Brussels grew to need an 8 km wall! The two walls coexisted until the Renaissance. This itinerary follows the change from a lordly precinct to a bourgeois town. What were the customs of its citizens at that time? What impact did it have on each side of the two walls and their respective excrescences? You\u2019ll never look at these ruins in the same way again!\r\n\r\nPrivate visit, organized to measure and on demand","performers":null,"boxoffice_url":null,"website":"http:\/\/www.itineraires.be","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.554665"},"de":{"name":"Us et coutumes de la Renaissance: Bruxelles, ville fortifi\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.itineraires.be","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.554665"},"it":{"name":"Us et coutumes de la Renaissance: Bruxelles, ville fortifi\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.itineraires.be","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.554665"},"sp":{"name":"Usos y costumbres del Renacimiento: Bruselas, ciudad fortificada","shortdescr":null,"longdescr":"Imag\u00ednate la ciudad de Bruselas durante el Renacimiento: una ciudad grande y protegida por una muralla... \u00a1o m\u00e1s bien dos! La primera data de principios del siglo XIII, la segunda del siglo XIV. De una muralla de 4 km jalonada por siete puertas, Bruselas pas\u00f3 a tener otra de 8 km, y ambas coexistieron hasta el Renacimiento. Esta ruta te mostrar\u00e1 la transici\u00f3n de una villa se\u00f1orial a un recinto burgu\u00e9s. \u00bfCu\u00e1les eran las costumbres de los ciudadanos de la \u00e9poca? \u00bfQu\u00e9 impacto tuvieron las orientaciones opuestas de las dos murallas y de sus respectivos alargamientos? No volver\u00e1s a ver estos restos de la misma manera...","performers":null,"boxoffice_url":null,"website":"http:\/\/www.itineraires.be","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.554665"},"pt":{"name":"Us et coutumes de la Renaissance: Bruxelles, ville fortifi\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.itineraires.be","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.554665"},"cn":{"name":"Us et coutumes de la Renaissance: Bruxelles, ville fortifi\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":nu