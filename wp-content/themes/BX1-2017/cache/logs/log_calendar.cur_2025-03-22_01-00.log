_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2025-03-10T09:07:04+01:00","published_at":"2025-03-10T08:56:02+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":319636,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"concert","ranking":1.2599210498948732,"languages":{"spoken":["nl","fr","en"],"subtitles":[]},"categories":{"main":{"id":1,"translations":{"de":"Konzert","pt":null,"en":"Concert","it":"Concerti","cn":null,"fr":"Concert","sp":"Concierto","nl":"Concert"}},"others":{"list":[6,4],"translations":{"de":["Worldmusic, Folk & Country","Pop, Rock, Jazz..."],"pt":[null,null],"en":["Worldmusic, Folk & Country","Pop, rock, jazz\u2026"],"it":["Worldmusic, Folk e Country","Pop, rock, jazz\u2026"],"cn":[null,null],"fr":["Worldmusic, Folk & Country","Pop, rock, jazz\u2026"],"sp":["Worldmusic, folk y country","Pop, rock, jazz\u2026"],"nl":["Worldmusic, Folk & Country","Pop, rock, jazz\u2026"]}}},"translations":{"de":{"name":"Mamadou Drame, Musique Mandingue","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lebaixu.com","email":"contact@lebaixu.com","phone_contact":"+32 475 36 18 36","phone_booking":"+32 475 36 18 36","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700007501"},"pt":{"name":"Mamadou Drame, Musique Mandingue","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lebaixu.com","email":"contact@lebaixu.com","phone_contact":"+32 475 36 18 36","phone_booking":"+32 475 36 18 36","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700007501"},"en":{"name":"Mamadou Drame, Musique Mandingue","shortdescr":" Mamadou Dram\u00e9 is a virtuoso on the Kora, a West African instrument linked to the tradition of the griot families, of which he is a 6th-generation descendant. He is also an excellent singer. He's a new face on the Belgian world music scene. Mamadou Dram\u00e9 was born in Casamance in the south of Senegal. ","longdescr":"He began playing the African harp at the age of 8, fascinated by this voluptuous traditional Mandingo instrument, which his father and grandfather, Lalo K\u00e9ba Dram\u00e9, himself a renowned korpe player, introduced him to. From the age of 15, he took part in various concerts in his home town, then in Dakar, where he moved to attend the Conservatoire for 4 years. He obtained his diploma after presenting a brilliant dissertation on the evolution of the kora from its origins to the present day. He played in the Senegalese capital with various groups, including the Ensemble Instrumental de l'Ecole Nationale des Arts for several years, before leaving for Europe. Now settled in Belgium, he performs regularly in concert. He is involved in a number of projects, including his own group M\u00e9dra Jaly, and a duo with Tister Ikomo (Duo Seco). In trio with C\u00e9line Scheen and Karim Baggili (Baroque kora), he performs in prestigious venues such as the Botanique, the Chapelle Musicale Reine Elisabeth, the Ferme du Bi\u00e9reau, Flagey, Wolubilis and other prestigious venues in Belgium and abroad. As a result, his artistic performances extend beyond our borders to South Africa, at the Sun Arena in Pretoria. Mamadou Dram\u00e9 also collaborates with other musical styles: jazz with Chris Joris and Sal La Rocca, and Latino music with Oswald Hernandez.","performers":"Mamadou Dram\u00e9","boxoffice_url":null,"website":"http:\/\/www.lebaixu.com","email":"contact@lebaixu.com","phone_contact":"+32 475 36 18 36","phone_booking":"+32 475 36 18 36","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700007501"},"it":{"name":"Mamadou Drame, Musique Mandingue","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lebaixu.com","email":"contact@lebaixu.com","phone_contact":"+32 475 36 18 36","phone_booking":"+32 475 36 18 36","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700007501"},"cn":{"name":"Mamadou Drame, Musique Mandingue","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lebaixu.com","email":"contact@lebaixu.com","phone_contact":"+32 475 36 18 36","phone_booking":"+32 475 36 18 36","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700007501"},"fr":{"name":"Mamadou Drame, Musique Mandingue","shortdescr":" Mamadou Dram\u00e9 est un virtuose de la Kora, instrument d'Afrique de l'Ouest, li\u00e9 \u00e0 la tradition des familles griottes dont il est un descendant de la 6\u00e8me g\u00e9n\u00e9ration. C'est aussi un excellent chanteur. Il est un nouveau visage de la sc\u00e8ne de la \u00ab Musique du Monde \u00bb en Belgique. Mamadou Dram\u00e9 est n\u00e9 en Casamance dans le sud du S\u00e9n\u00e9gal. ","longdescr":"Il commence \u00e0 jouer de cette harpe africaine \u00e0 l\u2019\u00e2ge de 8 ans, fascin\u00e9 par ce voluptueux instrument traditionnel mandingue que lui fait d\u00e9couvrir son p\u00e8re et son grand-p\u00e8re, Lalo K\u00e9ba Dram\u00e9, lui-m\u00eame koriste reconnu. D\u00e8s l\u2019\u00e2ge de 15 ans, il participe \u00e0 diff\u00e9rents concerts dans sa ville natale, puis \u00e0 Dakar o\u00f9 il s\u2019installe pour suivre les cours au Conservatoire durant 4 ans. Il obtient son dipl\u00f4me apr\u00e8s avoir pr\u00e9sent\u00e9 un brillant m\u00e9moire sur l\u2019\u00e9volution de la kora de ses origines \u00e0 nos jours. Il joue dans la capitale du S\u00e9n\u00e9gal avec diff\u00e9rents groupes, dont l\u2019Ensemble Instrumental de l\u2019Ecole Nationale des Arts durant plusieurs ann\u00e9es, avant de partir pour l\u2019Europe. Install\u00e9 en Belgique, il se produit r\u00e9guli\u00e8rement en concert. Nous le voyons dans de nombreux projets comme son propre groupe M\u00e9dra Jaly, et aussi en duo avec Tister Ikomo (Duo Seco). En trio avec C\u00e9line Scheen et Karim Baggili (kora Baroque) il se produit dans des lieux prestigieux comme le Botanique, la Chapelle Musicale Reine Elisabeth, la Ferme du Bi\u00e9reau, \u00e0 Flagey, Wolubilis et d\u2019autres salles prestigieuses en Belgique et \u00e0 l\u2019\u00e9tranger. Ses prestations artistiques d\u00e9passent donc nos fronti\u00e8res et s\u2019\u00e9tendent jusqu\u2019en Afrique du Sud, dans la salle Sun Arena \u00e0 Pr\u00e9toria. Mamadou Dram\u00e9 collabore \u00e0 d\u2019autres styles musicaux : jazz avec Chris Joris et Sal La Rocca, musique latino avec Oswald Hernandez.","performers":"Mamadou Dram\u00e9","boxoffice_url":null,"website":"http:\/\/www.lebaixu.com","email":"contact@lebaixu.com","phone_contact":"+32 475 36 18 36","phone_booking":"+32 475 36 18 36","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700007501"},"sp":{"name":"Mamadou Drame, Musique Mandingue","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lebaixu.com","email":"contact@lebaixu.com","phone_contact":"+32 475 36 18 36","phone_booking":"+32 475 36 18 36","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700007501"},"nl":{"name":"Mamadou Drame, Musique Mandingue","shortdescr":" Mamadou Dram\u00e9 is een virtuoos op de kora, een West-Afrikaans instrument dat verbonden is met de traditie van de griotfamilies, waarvan hij een afstammeling is van de 6e generatie. Hij is ook een uitstekende zanger. Hij is een nieuw gezicht in de Belgische wereldmuzieksc\u00e8ne. Mamadou Dram\u00e9 werd geboren in Casamance in het zuiden van Senegal. ","longdescr":"Hij begon Afrikaanse harp te spelen toen hij 8 jaar oud was, gefascineerd door dit voluptueuze traditionele Mandingo-instrument dat zijn vader en grootvader, Lalo K\u00e9ba Dram\u00e9, zelf een gerenommeerde korpspeler, hem leerde kennen. Vanaf zijn 15e nam hij deel aan verschillende concerten in zijn geboortestad en vervolgens in Dakar, waar hij 4 jaar naar het Conservatorium ging. Hij behaalde zijn diploma na het presenteren van een briljant proefschrift over de evolutie van de kora vanaf de oorsprong tot nu. Hij speelde in de Senegalese hoofdstad met verschillende groepen, waaronder het Ensemble Instrumental de l'Ecole Nationale des Arts gedurende verschillende jaren, voordat hij naar Europa vertrok. Nu hij zich in Belgi\u00eb heeft gevestigd, treedt hij regelmatig op. Hij is betrokken bij een aantal projecten, waaronder zijn eigen groep M\u00e9dra Jaly en een duo met Tister Ikomo (Duo Seco). In trio met C\u00e9line Scheen en Karim Baggili (barok kora) treedt hij op in prestigieuze zalen zoals de Botanique, de Chapelle Musicale Reine Elisabeth, de Ferme du Bi\u00e9reau, Flagey, Wolubilis en andere prestigieuze zalen in Belgi\u00eb en in het buitenland. Zijn artistieke optredens reiken dan ook verder dan onze landsgrenzen, tot in Zuid-Afrika, in de Sun Arena in Pretoria. Mamadou Dram\u00e9 werkt ook samen met andere muziekstijlen: jazz met Chris Joris en Sal La Rocca, en Latino muziek met Oswald Hernandez.","performers":"Mamadou Dram\u00e9","boxoffice_url":null,"website":"http:\/\/www.lebaixu.com","email":"contact@lebaixu.com","phone_contact":"+32 475 36 18 36","phone_booking":"+32 475 36 18 36","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700007501"}},"place":{"id":279109,"translations":{"de":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"contact@lebaixu.com","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Le Baixu","address_street_name":"Rue Picard",