dredi au dimanche de 14 h \u00e0 19 h.\nVernissage le vendredi 29 novembre \u00e0 partir de 18 h.","performers":"Laurent BOUVIER, Eric CRAPS et Philippe SEYNAEVE, Christine DETHIER, Jilali LAHOUARI, Marc Philippe LEGEIN, Alberto MESIRCA, Jean-Louis SAELENS, Patrick ZELIS et les membres et invit\u00e9s du collectif BRUXELLES PIXELS, dont Philippe CLABOTS, H\u00e9l\u00e8ne COOK, Lionel MAELFEYT, Patrice NISET, Eric OSTERMANN, Adam PALUCH, Sophie VOITURON Joost FONTEYN, Thomas JEAN et Gaspard GIERCE.","boxoffice_url":null,"website":"http:\/\/www.autonomie.brussels","email":"contact@artesio.art","phone_contact":"+32 470 57 40 62","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700003689"},"sp":{"name":"ZOOM, la quinzaine de la photographie de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.autonomie.brussels","email":"contact@artesio.art","phone_contact":"+32 470 57 40 62","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700003689"},"nl":{"name":"ZOOM, la quinzaine de la photographie de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.autonomie.brussels","email":"contact@artesio.art","phone_contact":"+32 470 57 40 62","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700003689"}},"place":{"id":277030,"translations":{"de":{"name":"Autonomie - Centre d'Arts Pluriels","address_street_name":"Rue de l'Autonomie","address_street_number":"2-4","address_street_box":null,"email":null,"website":"http:\/\/artesio.art\/?s=0201000000","phone_contact":null,"phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de l'Autonomie, 2-4","address_line2":"1070 Anderlecht","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"p