it":["Teatro"],"cn":[null],"fr":["Th\u00e9\u00e2tre"],"sp":["Teatro"],"nl":["Theater"]}}},"translations":{"de":{"name":"Le Facteur Cheval ou le r\u00eave d'un fou","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wolubilis.be","email":"info@wolubilis.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.561271"},"pt":{"name":"Le Facteur Cheval ou le r\u00eave d'un fou","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wolubilis.be","email":"info@wolubilis.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.561271"},"en":{"name":"Le Facteur Cheval ou le r\u00eave d'un fou","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wolubilis.be","email":"info@wolubilis.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.561271"},"it":{"name":"Le Facteur Cheval ou le r\u00eave d'un fou","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wolubilis.be","email":"info@wolubilis.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.561271"},"cn":{"name":"Le Facteur Cheval ou le r\u00eave d'un fou","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wolubilis.be","email":"info@wolubilis.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.561271"},"fr":{"name":"Le Facteur Cheval ou le r\u00eave d'un fou","shortdescr":"Fiction d\u2019apr\u00e8s la vie du facteur Cheval \u2013 Adaptation th\u00e9\u00e2trale Nadine Monfils (\u00c9d. du Fleuve \u2013 2019)","longdescr":"Tomb\u00e9 amoureux du r\u00e9cit de Nadine Monfils, inspir\u00e9 par la vie du facteur Ferdinand Cheval, Alain Leempoel a cr\u00e9\u00e9 ce spectacle pour le Festival Off d\u2019Avignon 2022, dans le jardin ensoleill\u00e9 du Th\u00e9\u00e2tre des Halles.\r\nBien lui en a pris, ce fut un triomphe ! Port\u00e9 par l\u2019interpr\u00e9tation magistrale d\u2019Elliot Jenicot, ancien pensionnaire de la Com\u00e9die-Fran\u00e7aise, cette histoire incroyable d\u2019un homme \u00e9corch\u00e9 par le destin, \u00e9meut autant qu\u2019elle fascine : construire, de ses propres mains, pendant plus de trente ans, un palais inou\u00ef. Pour la premi\u00e8re fois en salle !\r\n\r\n\u00ab C\u2019est l\u2019histoire d\u2019un homme qui ne savait pas dire je t\u2019aime\u2026 et qui l\u2019a dit avec des pierres. \u00bb\r\n\r\nN\u00e9 au si\u00e8cle dernier, Ferdinand Cheval, surnomm\u00e9 \u00ab Le facteur Cheval \u00bb a pass\u00e9 plus de trente ans de sa vie \u00e0 construire une sorte de palais extraordinaire, seul, de ses mains. Chacun sur cette terre a sa part de bonheur et de malheur et le facteur Cheval ne sera pas \u00e9pargn\u00e9 : le destin lui enlevant femme et enfant. Fou pour les uns, g\u00e9nie pour les autres mais surtout fou de chagrin, il aura pourtant la force de construire cet \u00e9difice inou\u00ef, n\u00e9 d\u2019un songe. Tel un hymne \u00e0 l\u2019Amour, ce palais est la preuve qu\u2019on peut r\u00e9aliser ses r\u00eaves, m\u00eame les plus insens\u00e9s.","performers":"AVEC Elliot Jenicot ACCOMPAGN\u00c9 DU PLASTICIEN Philippe Doutrelepont MISE EN SC\u00c8NE Alain Leempoel  ASSISTANTE MISE EN SC\u00c8NE Mathilde Pigeolet SC\u00c9NOGRAPHIE No\u00e9mie Vanheste COSTUMES Virginie Delvaux de Fenffe VOIX OFF Mathilde Pigeolet et Luc Van Grunderbeeck IMAGE Kim Tran ou Corinne Vidrequin\nPRODUCTION Panache Diffusion ","boxoffice_url":null,"website":"http:\/\/www.wolubilis.be","email":"info@wolubilis.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.561271"},"sp":{"name":"Le Facteur Cheval ou le r\u00eave d'un fou","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wolubilis.be","email":"info@wolubilis.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.561271"},"nl":{"name":"Le Facteur Cheval ou le r\u00eave d'un fou","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.wolubilis.be\/a-voir\/le-facteur-cheval-ou-le-reve-dun-fou\/","email":"info@wolubilis.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.561271"}},"place":{"id":243359,"translations":{"de":{"name":"Th\u00e9\u00e2tre Wolubilis","address_street_name":"Cours Paul-Henri Spaak","address_street_number":"1","address_street_box":null,"email":null,"website":"http:\/\/www.wolubilis.be","phone_contact":"+32 2 761 60 30","phone_booking":"+32 2 761 60 30","address_zip":"1200","address_city":"Woluwe-Saint-Lambert","address_line1":"Cours Paul-Henri Spaak, 1","address_line2":"1200 Woluwe-Saint-Lambert","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Th\u00e9\u00e2tre Wolubilis","address_street_name":"Cours Paul-Henri Spaak","address_street_number":"1","address_street_box":null,"email":null,"website":"http:\/\/www.wolubilis.be","phone_contact":"+32 2 761 60 30","phone_booking":"+32 2 761 60 30","address_zip":"1200","address_city":"Woluwe-Saint-Lambert","address_line1":"Cours Paul-Henri Spaak, 1","address_line2":"1200 Woluwe-Saint-Lambert","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Th\u00e9\u00e2tre de Wolubilis","address_street_name":"Cours Paul-Henri Spaak","address_street_