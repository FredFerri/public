s":null,"boxoffice_url":null,"website":"https:\/\/poche.be\/show\/2023-samourai","email":"reservation@poche.be","phone_contact":"+32 2 647 27 26","phone_booking":"+32 2 649 17 27","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50001643"},"pt":{"name":"Samoura\u00ef","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/poche.be\/show\/2023-samourai","email":"reservation@poche.be","phone_contact":"+32 2 647 27 26","phone_booking":"+32 2 649 17 27","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50001643"},"en":{"name":"Samoura\u00ef","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/poche.be\/show\/2023-samourai","email":"reservation@poche.be","phone_contact":"+32 2 647 27 26","phone_booking":"+32 2 649 17 27","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50001643"},"it":{"name":"Samoura\u00ef","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/poche.be\/show\/2023-samourai","email":"reservation@poche.be","phone_contact":"+32 2 647 27 26","phone_booking":"+32 2 649 17 27","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50001643"},"cn":{"name":"Samoura\u00ef","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/poche.be\/show\/2023-samourai","email":"reservation@poche.be","phone_contact":"+32 2 647 27 26","phone_booking":"+32 2 649 17 27","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50001643"},"fr":{"name":"Samoura\u00ef","shortdescr":null,"longdescr":"\u00ab Tu veux pas \u00e9crire un roman s\u00e9rieux ? \u00bb. Voil\u00e0 l\u2019ultime conseil prodigu\u00e9 par Lisa \u00e0 Alan, avant qu\u2019elle le quitte.\n\nDepuis, Alan cherche un sujet de \u00abroman s\u00e9rieux\u00bb. Le pr\u00e9c\u00e9dent a fait un flop : 104.546\u00e8me des ventes sur Amazon. Alors, il veut profiter de l\u2019\u00e9t\u00e9 qui commence pour se plonger avec la discipline d\u2019un guerrier samoura\u00ef dans l\u2019\u00e9criture d\u2019une \u00e9pop\u00e9e profonde et poignante. En m\u00eame temps, il s\u2019occupera de la piscine de ses voisins.\n\nMais rien ne va : la piscine verdit et accueille rapidement une quantit\u00e9 de bestioles. Dans le m\u00eame temps, il met une \u00e9nergie de dingue \u00e0 fuir les rencontres amoureuses et \u00e0 g\u00e9rer sa phobie des sc\u00e8nes de spectacles.\n\nAlan s\u2019inscrit dans la prestigieuse lign\u00e9e des anti-h\u00e9ros. Un personnage \u00e0 la Tchekhov, dans lequel on retrouve probablement quelque chose des personnages de Fritland de Zenel Laci et du Champ de Bataille de J\u00e9r\u00f4me Colin, \u00e9galement mis en sc\u00e8ne par Denis Laujol au Poche ces derni\u00e8res saisons.","performers":"Adaptation et mise en sc\u00e8ne Denis Laujol | Avec Herv\u00e9 Piron | Dramaturgie Fanny Esteve | Collaboration artistique Julien Jaillot | Sc\u00e9nographie No\u00e9mie Vanheste | Cr\u00e9ation vid\u00e9o Lionel Ravira | Cr\u00e9ation sonore Marc Doutrepont | Cr\u00e9ation lumi\u00e8re Candice Hansel | Costumes Sol\u00e8ne Valentin","boxoffice_url":null,"website":"https:\/\/poche.be\/show\/2023-samourai","email":"reservation@poche.be","phone_contact":"+32 2 647 27 26","phone_booking":"+32 2 649 17 27","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50001643"},"sp":{"name":"Samoura\u00ef","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/poche.be\/show\/2023-samourai","email":"reservation@poche.be","phone_contact":"+32 2 647 27 26","phone_booking":"+32 2 649 17 27","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50001643"},"nl":{"name":"Samoura\u00ef","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/poche.be\/show\/2023-samourai","email":"reservation@poche.be