l activities, around history, architecture, art and in exceptional interiors. \r\n* For schools and children, we offer thematic, educational and entertaining tours and stages. \r\n\r\nOur expertise : Our team is made up of 60 guides, historians and art historians. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"http:\/\/www.arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"http:\/\/www.arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"http:\/\/www.arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"http:\/\/www.arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"R