:["Parcheggio accessibile","Accessibile","Accessibile ai pedoni con supporti","WC idoneo"],"cn":[null,null,null,null],"fr":["Parking accessible","Accessible","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9"],"sp":["Estacionamiento habilitado","Habilitado","Habilitado para peatones con aud\u00edfonos","Ba\u00f1os adaptados"],"nl":["Toegankelijke parking","Toegankelijk","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet"]}},"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[]},{"id":50001600,"date_start":"2023-09-21","date_end":"2023-10-29","date_next":"2023-09-21","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2023-09-04T16:45:01+02:00","published_at":"2023-08-31T08:55:01+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":284313,"facebook_link":null,"import_origin":null,"is_part_of":"Ann\u00e9e Art Nouveau","sub_type":"misc","ranking":0.29487987310846736,"languages":{"spoken":["fr","en","nl"],"subtitles":[]},"categories":{"main":{"id":84,"translations":{"de":"Verschiedenes","pt":null,"en":"Various","it":"Varie","cn":null,"fr":"Divers","sp":"Varios","nl":"Varia"}},"others":{}},"translations":{"de":{"name":"Caf\u00e9 Hoffmann","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brussels.czechcentres.cz\/fr\/cafe-hoffmann?locale=fr","email":"ccbrussels@czechcentres.cz","phone_contact":"+32 489 49 75 23","phone_booking":"+32 489 49 75 23","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50001600"},"pt":{"name":"Caf\u00e9 Hoffmann","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brussels.czechcentres.cz\/fr\/cafe-hoffmann?locale=fr","email":"ccbrussels@czechcentres.cz","phone_contact":"+32 489 49 75 23","phone_booking":"+32 489 49 75 23","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50001600"},"en":{"name":"Caf\u00e9 Hoffmann","shortdescr":"Caf\u00e9 Hoffmann is a temporary project offering an exhibition, participatory workshops, films, immersive experiences, and other programmes, all linked to the heritage of Josef Hoffmann, the famous architect, and the author of Palais Stoclet in Brussels. Programme updated regularly!","longdescr":"Caf\u00e9 Hoffmann is a temporary project of the Czech Centre - it is an accompanying programme to the exhibition Josef Hoffmann - falling for beauty, which is open from 6 October 2023 to 14 April 2024 at the Arts & History Museum in Brussels. The Caf\u00e9 Hoffmann programme is also included in the prestigious Brussels Design September, and takes place in the context of the Art Nouveau Year in Brussels. We are also not forgetting the European year of skills and focusing on a participatory programme.\n\nJosef Hoffmann, born in Brtnice (Vyso\u010dina Region) in 1870, is one of several famous early nineteenth-century German-speaking architects born in Moravia. Hoffmann, together with his colleague Joseph Maria Olbrich, founded the Viennese Art Nouveau group and laid the groundwork for new principles of modern design and architecture as a whole. His idea of the \u201ctotal work of art\u201d, the so-called Gesamtkunstwerk, became one of the fundamentals of modern architecture and interior design, as did his innovative reduction of shapes to basic geometric forms. He began with Geometric Art Nouveau and arrived at Functionalism, all against a backdrop of dramatic historical circumstances and the worldwide development of applied art.","performers":null,"boxoffice_url":null,"website":"https:\/\/brussels.czechcentres.cz\/en\/cafe-hoffmann?locale=en","email":"ccbrussels@czechcentres.cz","phone_contact":"+32 489 49 75 23","phone_booking":"+32 489 49 75 23","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50001600"},"it":{"name":"Caf\u00e9 Hoffmann","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brussels.czechcentres.cz\/fr\/cafe-hoffmann?locale=fr","email":"ccbrussels@czechcentres.cz","phone_contact":"+32 489 49 75 23","phone_booking":"+32 489 49 75 23","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50001600"},"cn":{"name":"Caf\u00e9 Hoffmann","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brussels.czechcentres.cz\/fr\/cafe-hoffmann?locale=fr","email":"ccbrussels@czechcentres.cz","phone_contact":"+32 489 49 75 23","phone_booking":"+32 489 49 75 23","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50001600"},"fr":{"name":"Caf\u00e9 Hoffmann","shortdescr":"Caf\u00e9 Hoffmann est un projet artistique temporaire qui propose une expo, des ateliers, projection et autres rencontres autour de l'architecte Josef Hoffmann, auteur de Palais Stoclet. Le programme est mis \u00e0 jour r\u00e9guli\u00e8rement!","longdescr":"Caf\u00e9 Hoffmann est un espace temporaire con\u00e7u par le Centre tch\u00e8que \u00e0 Bruxelles dans le cadre de l\u2019exposition \u00ab Josef Hoffmann - Sous le charme de la beaut\u00e9 \u00bb (du 6 octobre 2023 au 14 avril 2024 au Mus\u00e9e Arts et Histoire). Nous faisons partie de Brussels Design September 2023 et de l\u2019Ann\u00e9e Art Nouveau 2023.\n\nJosef Hoffmann, n\u00e9 \u00e0 Brtnice en 1870, est l\u2019un des architectes moraves de l\u2019expression allemande connu, avec notamment Joseph Maria Olbrich. Avec ce dernier il a cofond\u00e9 la S\u00e9cession viennoise et il a \u00e9t\u00e9 le pionnier de principe de l\u2019\u0153uvre total \u2013 Gesamtkunstwerk - qui est devenu le principe fondateur de la cr\u00e9ation architecturale et du design industriel. Comme artiste, son \u00e9volution est surprenant \u2013 d\u2019abord repr\u00e9sentant de l\u2019Art Nouveau, il est devenu vers la fin de sa carri\u00e8re, l\u2019architecte fonctionnaliste. Cette \u00e9volution t\u00e9moigne aussi une vie dans une \u00e9poque tumultueuse de tournant de si\u00e8cle, et deux guerres mondiales, \u00e9volution \u00e9norme dans le domaine des arts et de l\u2019industrie...etc.","performers":null,"boxoffice_url":null,"website":"https:\/\/brussels.czechcentres.cz\/fr\/cafe-hoffmann?locale=fr","email":"ccbrussels@czechcentres.cz","phone_contact":"+32 489 49 75 23","phone_booking":"+32 489 49 75 23","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50001600"},"sp":{"name":"Caf\u00e9 Hoffmann","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brussels.czechcentres.cz\/fr\/cafe-hoffmann?locale=fr","email":"ccbrussels@czechcentres.cz","phone_contact":"+32 489 49 75 23","phone_booking":"+32 489 49 75 23","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50001600"},"nl":{"name":"Caf\u00e9 Hoffmann","shortdescr":"De invloed van Josef Hoffmann op het hedendaagse design en architectuur zal worden gepresenteerd in de tijdelijke galerij Caf\u00e9 Hoffmann, met een programma dat de veelzijdigheid van de architect en ontwerper belicht, die van Brtnice in Vyso\u010dina roem verwierf in Wenen. Hoffmann staat in Belgi\u00eb bekend als een leidende figuur in de Art Deco-stijl en als de auteur van het beroemde Palais Stoclet. ","longdescr":"Caf\u00e9 Hoffmann is een tijdelijk project van het Tsjechisch Centrum - het is een begeleidend programma bij de tentoonstelling \"Josef Hoffmann - In de ban van schoonheid\", die loopt vanaf 6 oktober 2023 tot 14 april 2024 in het Museum Kunst & Geschiedenis. Het programma van Caf\u00e9 Hoffmann maakt ook deel uit het prestigieuze Brussels Design September en vindt plaats in het kader van het Art Nouveau Year in Brussel. We houden ook rekening met het europees jaar van de vaardigheden en leggen de nadruk op participatieve programma's.\n\nJosef Hoffmann, geboren in het Moravische Brtnice in 1870, behoort tot de bekende Duitstalige architecten van de eerste helft van de vorige eeuw die juist op Moravische bodem geboren werden. Samen met een andere architect, Joseph Maria Olbrich, was hij betrokken bij de oprichting van de Weense Secessionistische groep en legde hij tegelijkertijd de basis voor nieuwe principes van modern design en architectuur in het algemeen. Zijn concept van het \"totale kunstwerk\", het zogenaamde \"Gesamtkunstwerk\", werd een van de fundamenten van moderne architecturale en interieurvormgeving, evenals zijn innovatieve reductie van vormen tot elementaire geometrische vormen. Hij begon met geometrische secessie en evolueerde naar functionalisme. Dit alles tegen de achtergrond van dramatische historische omstandigheden en de wereldwijde ontwikkeling van toegepaste kunst.   ","performers":null,"boxoffice_url":null,"website":"https:\/\/brussels.czechcentres.cz\/nl\/cafe-hoffmann?locale=nl","email":"ccbrussels@czechcentres.cz","phone_contact":"+32 489 49 75 23","phone_booking":"+32 489 49 75 23","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50001600"}},"place":{"id":50000466,"translations":{"de":{"name":"Caf\u00e9 Hoffmann","address_street_name":"Rue des Bouchers","address_street_number":"37a","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Bouchers, 37a","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Caf\u00e9 Hoffmann","address_street_name":"Rue des Bouchers","address_street_number":"37a","address_street_box":null,"email":null,"website":null,"phone_co