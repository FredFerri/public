ompagn\u00e9s par Splendeur groupe de rock bruxellois \u00e0 l\u2019\u00e9nergie d\u00e9bordante.\r\n\r\nAttention les murs de mOtown Concerts vont trembler.","performers":"AMALIA BLOOM (Ita) + Splendeur ( Be)","boxoffice_url":null,"website":"https:\/\/www.facebook.com\/mOtown.concerts","email":"info@creative-district.be","phone_contact":null,"phone_booking":"+32 485 24 29 97","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/533885.html"},"nl":{"name":"AMALIA BLOOM (IT) + Splendeur (BE) live","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/533885.html"},"en":{"name":"AMALIA BLOOM (IT) + Splendeur (BE) live","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/533885.html"},"de":{"name":"AMALIA BLOOM (IT) + Splendeur (BE) live","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/533885.html"},"it":{"name":"AMALIA BLOOM (IT) + Splendeur (BE) live","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/533885.html"},"sp":{"name":"AMALIA BLOOM (IT) + Splendeur (BE) live","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/533885.html"},"pt":{"name":"AMALIA BLOOM (IT) + Splendeur (BE) live","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,