itles":[]},"categories":{"main":{"id":90,"translations":{"de":"Animationen","pt":null,"en":"Animations","it":"Animazioni","cn":null,"fr":"Animations","sp":"Animaciones","nl":"Animaties"}},"others":{"list":[99],"translations":{"de":["Gastronomie"],"pt":[null],"en":["Gastronomy"],"it":["Cucina"],"cn":[null],"fr":["Gastronomie"],"sp":["Gastronom\u00eda"],"nl":["Gastronomie"]}}},"translations":{"de":{"name":"Tram Experience","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.tramexperience.be","email":"tramexperience@visit.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.531124"},"pt":{"name":"Tram Experience","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.tramexperience.be","email":"tramexperience@visit.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.531124"},"en":{"name":"Tram Experience","shortdescr":"For its 11th year, let yourself be carried away on a surprising culinary journey in the unique and original atmosphere of the Tram Experience!","longdescr":"Throughout the season, six renowned chefs invite you to discover their gastronomic universes of varied flavours and horizons. From Japan to Italy and Quebec to France via Brussels, of course, each of the menus will be an invitation to explore new taste sensations. All aboard! All the recipes are meticulously prepared on board by our caterer Thibault Granville (Taste Great) and his team. \n\n\nRATES \n\nTable for 2 persons, 6 course menu : 220\u20ac \n\nTable for 2 people, 7 course menu : 270\u20ac \n\nTable for 4 people, 6 course menu : 440\u20ac \n\nTable for 4 people, 7 course menu : 540\u20ac","performers":null,"boxoffice_url":"https:\/\/shop.tramexperience.brussels\/en\/shop","website":"http:\/\/www.tramexperience.be","email":"tramexperience@visit.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.531124"},"it":{"name":"Tram Experience","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.tramexperience.be","email":"tramexperience@visit.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.531124"},"cn":{"name":"Tram Experience","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.tramexperience.be","email":"tramexperience@visit.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.531124"},"fr":{"name":"Tram Experience","shortdescr":"Pour cette 11e ann\u00e9e, laissez-vous emporter par un surprenant voyage culinaire dans l\u2019atmosph\u00e8re unique et originale du Tram Experience !","longdescr":"Tout au long de la saison, six chefs renomm\u00e9s vous proposent de d\u00e9couvrir leur univers gastronomique aux saveurs et horizons vari\u00e9s. Du Japon \u00e0 l\u2019Italie, du Qu\u00e9bec \u00e0 Bordeaux et Paris, tout en passant par Bruxelles bien s\u00fbr \u2026 Chaque menu sera une invitation \u00e0 l\u2019exploration de nouvelles sensations gustatives. En voiture ! Les recettes sont r\u00e9alis\u00e9es \u00e0 bord avec rigueur et minutie par notre traiteur Thibault Granville (Taste Great) et son \u00e9quipe. \n\n\nTARIFS \n\nTable de 2 personnes, menu 6 services : 220\u20ac \n\nTable de 2 personnes, menu 7 services : 270\u20ac \n\nTable de 4 personnes, menu 6 services : 440\u20ac \n\nTable de 4 personnes, menu 7 services : 540\u20ac","performers":null,"boxoffice_url":"https:\/\/shop.tramexperience.brussels\/fr\/shop","website":"http:\/\/www.tramexperience.be","email":"tramexperience@visit.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.531124"},"sp":{"name":"Tram Experience","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.tramexperience.be","email":"tramexperience@visit.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.531124"},"nl":{"name":"Tram Experience","shortdescr":"Laat je tijdens het 11e seizoen van de Tram Experience meevoeren op een verrassende culinaire reis in een unieke sfeer!","longdescr":"Het hele jaar lang kan je kennismaken met de gastronomische wereld van zes gerenommeerde chefs. Ontdek totaal verschillende smaken en horizonten. Van Japan naar Itali\u00eb. Van Quebec naar Bordeaux en Parijs. En natuurlijk houden we halt in Brussel. Elk menu nodigt je uit om nieuwe smaaksensaties te ontdekken. Smakelijke reis! Onze traiteur Thibault Granville (Taste Great) en zijn team bereiden de recepten aan boord met de grootste zorg en aandacht voor het kleinste detail. \n\n\nPRIJZEN \n\nTafel voor 2 personen, 6-gangen menu: 220\u20ac \n\nTafel voor 2 personen, 7-gangen menu: 270\u20ac \n\nTafel voor 4 personen, 6-gangen menu: 440\u20ac \n\nTafel voor 4 personen, 7-gangen menu: 540\u20ac","performers":null,"boxoffice_url":"https:\/\/shop.tramexperience.brussels\/nl\/shop","website":"http:\/\/www.tramexperience.be","email":"tramexperience@visit.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.531124"}},"place":{"id":279379,"translations":{"de":{"name":"Arr\u00eat STIB Poelaert","address_street_name":"Place Poelaert","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Poelaert","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Arr\u00eat STIB Poelaer