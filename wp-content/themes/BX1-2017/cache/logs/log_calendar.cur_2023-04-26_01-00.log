isent et m\u00ealent leurs univers pour avancer ensemble sur la voie des histoires.\r\n\r\nINFOS PRATIQUES :\r\nD\u00e9but : 15h - dur\u00e9e 1h30\r\nR\u00e9servations indispensables\r\nAccessible PMR accompagn\u00e9es\r\nPrix libre (sugg\u00e9r\u00e9 : 7\u20ac)\r\nA partir de 10 ans","performers":"Amina Lafquiri et Marie-Rose Meysman","boxoffice_url":null,"website":"https:\/\/www.conteenbalade.be\/","email":"info@conteenbalade.be","phone_contact":"+32 497 78 20 75","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.550659"},"nl":{"name":"Ode aux vivants \/ balade cont\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.conteenbalade.be\/","email":"info@conteenbalade.be","phone_contact":"+32 497 78 20 75","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.550659"},"en":{"name":"Ode aux vivants \/ balade cont\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.conteenbalade.be\/","email":"info@conteenbalade.be","phone_contact":"+32 497 78 20 75","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.550659"},"de":{"name":"Ode aux vivants \/ balade cont\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.conteenbalade.be\/","email":"info@conteenbalade.be","phone_contact":"+32 497 78 20 75","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.550659"},"it":{"name":"Ode aux vivants \/ balade cont\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.conteenbalade.be\/","email":"info@conteenbalade.be","phone_contact":"+32 497 78 20 75","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.550659"},"sp":{"name":"Ode aux vivants \/ balade cont\u00