doors":null,"start":"10:00:00","end":"18:00:00"},{"day":"2022-08-15","doors":null,"start":"10:00:00","end":"18:00:00"},{"day":"2022-08-16","doors":null,"start":"10:00:00","end":"18:00:00"},{"day":"2022-08-17","doors":null,"start":"10:00:00","end":"18:00:00"},{"day":"2022-08-18","doors":null,"start":"10:00:00","end":"18:00:00"},{"day":"2022-08-19","doors":null,"start":"10:00:00","end":"18:00:00"},{"day":"2022-08-20","doors":null,"start":"10:00:00","end":"18:00:00"},{"day":"2022-08-21","doors":null,"start":"10:00:00","end":"18:00:00"},{"day":"2022-08-22","doors":null,"start":"10:00:00","end":"18:00:00"},{"day":"2022-08-23","doors":null,"start":"10:00:00","end":"18:00:00"},{"day":"2022-08-24","doors":null,"start":"10:00:00","end":"18:00:00"},{"day":"2022-08-25","doors":null,"start":"10:00:00","end":"18:00:00"},{"day":"2022-08-26","doors":null,"start":"10:00:00","end":"18:00:00"},{"day":"2022-08-27","doors":null,"start":"10:00:00","end":"18:00:00"},{"day":"2022-08-28","doors":null,"start":"10:00:00","end":"18:00:00"}],"weekschema":[{"days":{"monday":{"is_open":true,"hours":[{"start":"10:00:00","end":"18:00:00"}]},"tuesday":{"is_open":true,"hours":[{"start":"10:00:00","end":"18:00:00"}]},"wednesday":{"is_open":true,"hours":[{"start":"10:00:00","end":"18:00:00"}]},"thursday":{"is_open":true,"hours":[{"start":"10:00:00","end":"18:00:00"}]},"friday":{"is_open":true,"hours":[{"start":"10:00:00","end":"18:00:00"}]},"saturday":{"is_open":true,"hours":[{"start":"10:00:00","end":"18:00:00"}]},"sunday":{"is_open":true,"hours":[{"start":"10:00:00","end":"18:00:00"}]}},"translations":{"fr":["lundi, mardi, mercredi, jeudi, vendredi, samedi et dimanche: de 10:00 \u00e0 18:00"],"nl":["maandag, dinsdag, woensdag, donderdag, vrijdag, zaterdag en zondag: van 10:00 tot 18:00"],"en":["monday, tuesday, wednesday, thursday, friday, saturday and sunday: from 10:00 to 18:00"]},"date_start":"2022-06-28","date_end":"2022-08-28","is_also_by_appointment":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[11,10,12,7,15],"translations":{"fr":["Famille","Seniors","LGTBQIA","Jeunes 12-15 ans","Sourd\/malentendant"],"nl":["Familie","Senioren","LGTBQIA","Jongeren 12-15 j.","Doof\/slechthorend"],"en":["Family","Seniors","LGTBQIA","Youth 12-15  yr.","Deaf\/hard of hearing"]}},"tags":["kids"],"accessibilities":{"list":[252,255,257,259,263,265],"translations":{"fr":["Accessible aux personnes ayant des difficult\u00e9s de compr\u00e9hension","Accessible","Am\u00e9nagements pour personnes sourdes et malentendantes","Chien d'assistance","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9"],"nl":["Toegankelijk voor mensen met een verstandelijke beperking","Toegankelijk","Voorzieningen voor dove en slechthorende personen","Assistentiehonden","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet"],"en":["Accessible to people with intellectual disabilities","Accessible","Facilities for deaf and hearing-impaired people","Assistance dogs","Accessible to pedestrians with mobility aids","Adapted toilet"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-07-21T01:35:15+02:00","published_at":"2022-06-28T16:11:06+02:00","backoffice_id":257217,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.31833136784577},{"id":533839,"date_start":"2022-07-01","date_end":"2022-08-31","date_next":"2022-07-21","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":90,"translations":{"fr":"Animations","nl":"Animaties","en":"Animations"}},"others":{"list":[95],"translations":{"fr":["Patrimoine"],"nl":["Erfgoed"],"en":["Heritage"]}}},"languages":{"spoken":["nl","fr","en"],"subtitles":[]},"translations":{"fr":{"name":"Les tr\u00e9sors de Vlieg la mouche au Mus\u00e9e des Instruments de Musique !","shortdescr":"Nous les mouches, nous avons un odorat super d\u00e9velopp\u00e9, m\u00eame si on n'a pas de nez pour sentir (notre trompe sert \u00e0 manger) ! Au Mus\u00e9e des Instruments de Musique, par contre, il y a plein de nez ph\u00e9nom\u00e9naux ! Sens-tu ce que je sens ?","longdescr":"Nous les mouches, nous avons un odorat super d\u00e9velopp\u00e9, m\u00eame si on n'a pas de nez pour sentir (notre trompe sert \u00e0 manger) ! Au Mus\u00e9e des Instruments de Musique, par contre, il y a plein de supers nez ! Des nez en trompette, des nez pointus, des nez crochus, des nez fins... Cet \u00e9t\u00e9, nous faisons appel \u00e0 ton flair (!), demande ton enqu\u00eate \u00e0 l'accueil et pars \u00e0 la recherche des nez du MIM. Accomplis tes missions et collectionne les indices pour trouver le tr\u00e9sor !\r\n\r\nParcours pour familles avec enfants de 4 \u00e0 8 ans.\r\nCompris dans le ticket d'entr\u00e9e au Mus\u00e9e: 0\u20ac -18 ans \/ 8\u20ac \u00e9tudiants, professeurs \/ 13\u20ac +65 \/ 15\u20ac adultes\r\nDans le cadre de L'\u00e9t\u00e9 de Vlieg 2022 : est-ce que tu sens ce que je sens ?","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/533839.html"},"nl":{"name":"Schatten van Vlieg in het Muziekinstrumentenmuseum!","shortdescr":"Wij Vliegen hebben een heel verfijnde neus, maar in het muziekinstrumentenmuseum stikt het ook van de fenomenale neuzen! Ruik jij wat ik ruik?","longdescr":"Wij Vliegen hebben een heel verfijnde neus, reken maar! Ik kan lekkere hapjes metersver ruiken. Nu, geloof het of niet, maar in het muziekinstrumentenmuseum stikt het ook van de fenomenale neuzen! Wipneuzen, puntige neuzen, haakneuzen, muzikale neuzen en wijsneuzen. Dus hierbij een warme oproep aan jullie: speurneuzen (!), vraag je zoektocht aan het onthaal en kom snuffelen in het MIM. Voer de opdrachten uit en verzamel de tips om de schat te vinden. Mijn neusje trilt al van spanning!\r\n\r\nSpeur- en luistertocht voor gezinnen met kinderen van 4 tot 8 jaar in gezinsverband.\r\nInbegrepen in een ticket: \u20ac0 -18 jaar\/\u20ac8 studenten, leerkrachten\/\u20ac13 +65\/\u20ac15 volwassenen\r\nI.k.v. De zomer van Vlieg 2022: ruik jij wat ik ruik?","performers":null,"boxoffice_url":null,"website":"https:\/\/www.mim.be","email":"info@mim.be","phone_contact":null,"phone_booking":"+32 2 741 73 02","agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/533839.html"},"en":{"name":"Fly's treasures at the Musical Instruments Museum!","shortdescr":"We Flies have a very refined nose and as it so happens, the Musical Instruments Museum is also full of phenomenal noses! Can you smell what I smell?","longdescr":"We Flies have very refined noses! I can smell tasty morsels from miles away. Now, believe it or not, the Musical Instruments Museum is also full of phenomenal noses! Winky noses, pointed noses, crochet noses and musical noses. So here's a warm appeal to you: ask the reception desk for your copy of the trail and come sniff around in the MIM. Complete the assignments and collect the tips to find the treasure chest. My nose is already twitching with excitement!\r\n\r\nDiscover and listen trail for families with children aged 4 to 8.\r\nIncluded in a ticket: \u20ac 0 -18 years \/ \u20ac 8 students, teachers \/ \u20ac 13 +65 years \/ \u20ac 15 adults\r\nAs part of Fly's treasures 2022: can you smell what I smell?","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/533839.html"},"de":{"name":"Schatten van Vlieg in het Muziekinstrumentenmuseum!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/533839.html"},"it":{"name":"Schatten van Vlieg in het Muziekinstrumentenmuseum!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/533839.html"},"sp":{"name":"Schatten van Vlieg in het Muziekinstrumentenmuseum!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/533839.html"},"pt":{"name":"Schatten van Vlieg in het Muziekinstrumentenmuseum!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/533839.html"},"cn":{"name":"Schatten van Vlieg in het Muziekinstrumentenmuseum!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/533839.html"}},"place":{"id":100473,"translations":{"fr":{"name":"MIM - Mus\u00e9e des instruments de musique (MRAH)","address_street_name":"Rue Montagne de la Cour","address_street_number":"2","address_street_box":null,"email":"info@mim.be","website":"http:\/\/www.mim.be","phone_contact":"+32 2 545 01 30","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Montagne de la Cour, 2","address_line2":"1000 Bruxelles","description_web":"Le monde entier admire la collection du Mus\u00e9e des instruments de musique qui fait partie du groupement des Mus\u00e9es Royaux d\u2019Art et d\u2019Histoire. Ce Mus\u00e9e est camp\u00e9 au c\u0153ur des anciens b\u00e2timents Old England, un des plus beaux b\u00e2timents de style Art Nouveau de Bruxelles, datant de 1899. Ce mus\u00e9e est l\u2019un des plus riches au monde : quelques 1.200 instruments y sont expos\u00e9s. D\u2019int\u00e9ressantes animations et de nombreux concerts y sont programm\u00e9s.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"MIM - Muziekinstrumentenmuseum (KMKG)","address_street_name":"Hofberg","address_street_number":"2","address_street_box":null,"email":"info@mim.be","website":"http:\/\/www.mim.be","phone_contact":"+32 2 545 01 30","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Brussel","address_line1":"Hofberg, 2","address_line2":"1000 Brussel","description_web":"Het Muziekinstrumentenmuseum (MIM) bewaart een onschatbare collectie van muzikaal erfgoed en presenteert ze op een schitterende manier. Het MIM beschikt daarvoor over veel troeven. De intu\u00eftieve presentatie is aantrekkelijk en klantvriendelijk. De collectie huist bovendien in een schitterend gerestaureerd Art Nouveau pand. Het MIM presenteert een honderdtal middagconcerten per jaar en biedt een waaier aan groepsactiviteiten.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"MIM - Musical Instruments Museum (MRAH)","address_street_name":"Rue Montagne de la Cour","address_street_number":"2","address_street_box":null,"email":"info@mim.be","website":"http:\/\/www.mim.be","phone_contact":"+32 2 545 01 30","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Brussels","address_line1":"Rue Montagne de la Cour, 2","address_line2":"1000 Brussels","description_web":"As soon as it opened at the end of the 19th century, the luxurious Old England department store earned an excellent reputation for its highly distinctive building. The entrance to the building is a jewel of the Art Nouveau style, while the rest is in perfect harmony with the neoclassical ensemble on the Place Royale, and just around the corner from the Grand-Place and Central Station, no less! \r\nWith a wealth of some 9.000 instruments, some 1.200 of which are on permanent exhibit, the museum's reputation is mainly built on its extraordinary collections.\r\nOnce inside, you'll embark on a true tour of the musical world. After your visit, the instruments and their history will no longer hold any secrets: from the viola da gamba from the Court of Brussels to the 20th century theremin, and even including the African kora!\r\nThe mim is nothing other than a place to experience music. A visitor's guidance system allows you to explore the thematic tours to the tune of the melodious sound of the instruments presented.\r\nA program packed with concerts, demonstrations and workshops for the young and the not so young makes the mim experience even better.\r\nThe mim has its own concert hall, specialized library, museum shop, workshop for restauration and conservation of musical instruments and is crowned by a restaurant with panoramic view over Brussels.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"MIM - Musikinstrumente-Museum (MRAH)","address_street_name":"Montagne de la Cour","address_street_number":"2","address_street_box":null,"email":"info@mim.be","website":"http:\/\/www.mim.be","phone_contact":"+32 2 545 01 30","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Montagne de la Cour, 2","address_line2":"1000 Bruxelles","description_web":"Das Br\u00fcsseler Musikinstrumente-Museum mit 1200 ausgestellten Musikinstrumenten und vielf\u00e4ltigen Sammlungen (mit insgesamt 8000 Instrumenten!), untergebracht in einem bemerkenswerten Jugendstilgeb\u00e4ude, ist ein Paradies f\u00fcr Musikinteressierte.\r\n\r\nMusikgeschichte und Jugendstilarchitektur: Das Musikinstrumente-Museum befindet sich in den ehemaligen Geb\u00e4uden des \u201eOld England\u201c-Kaufhauses und gilt als eines der herausragenden Beispiele f\u00fcr die Br\u00fcsseler Jugendstilarchitektur.\r\n\r\nMusikalische Welt- und Zeitreise: Auf vier Ebenen pr\u00e4sentiert das Museum Musikinstrumente aus verschiedenen Kulturkreisen und Epochen \u2013 und so begibt sich der Besucher auf eine musikalische Welt- und Zeitreise. Die Ausstellungsgestaltung verkn\u00fcpft gekonnt klangliche und visuelle Dimensionen.\r\n\r\nKulinarischer H\u00f6hepunkt, im wahrsten Sinne des Wortes, ist das Restaurant im 6. Stock mit Dachterrasse.\r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Museo degli Strumenti Musicali","address_street_name":"Rue Montagne de la Cour","address_street_number":"2","address_street_box":null,"email":"info@mim.be","website":"http:\/\/www.mim.be","phone_contact":"+32 2 545 01 30","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Montagne de la Cour, 2","address_line2":"1000 Bruxelles","description_web":"Il MIM presenta una collezione di strumenti musicali di fama internazionale e une larga gamma di attivit\u00e0 in collegamento con questa collezione a un pubblico largo e...\r\n\r\nIl MIM presenta una collezione di strumenti musicali di fama internazionale e une larga gamma di attivit\u00e0 in collegamento con questa collezione a un pubblico largo e diversificato dal Belgio e dall'estero. Presenta un'ampio panorama della musica antica, moderna, popolare e tradizionale.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"El MIM, Museo de Instrumentos de M\u00fasica","address_street_name":"Rue Montagne de la Cour","address_street_number":"2","address_street_box":null,"email":"info@mim.be","website":"http:\/\/www.mim.be","phone_contact":"+32 2 545 01 30","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Montagne de la Cour, 2","address_line2":"1000 Bruxelles","description_web":"El Museo MIM te invita a contemplar y escuchar 1.200 instrumentos de m\u00fasica en un edificio Art Nouveau de Bruselas. \r\n\r\nEl Museo de Instrumentos de M\u00fasica, que forma parte de los Museos Reales de Arte e Historia, abre sus puertas en las proximidades de la Place Royale, en el Mont des Arts, el barrio de los museos de Bruselas. \r\n\r\nEl MIM se encuentra en los antiguos almacenes de Art Nouveau, Old England, un aut\u00e9ntico tesoro arquitect\u00f3nico de finales del s. XIX.\r\n\r\nEl MIM debe su reputaci\u00f3n, sobre todo, a sus extraordinarias colecciones. Ven a dar la vuelta al mundo musical a trav\u00e9s de sus 1.200 piezas distribuidas por las 4 plantas de la exposici\u00f3n.\r\n\r\n\r\nComo es de suponer, el MIM es el lugar ideal para disfrutar de la m\u00fasica. Un sistema de cascos con infrarrojos permite explorar los recorridos tem\u00e1ticos al tiempo que se escucha el sonido melodioso de los instrumentos que se presentan.\r\n   \r\nEl MIM tambi\u00e9n es\u2026\r\n\r\n- Una sala de conciertos\r\n- Un espacio para talleres\r\n- Un Museumshop\r\n- Una biblioteca especializada\r\n- Y un restaurante con terraza, con unas vistas \u00fanicas al centro hist\u00f3rico de la capital europea\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"MIM - Museu dos Instrumentos Musicais","address_street_name":"Rue Montagne de la Cour","address_street_number":"2","address_street_box":null,"email":"info@mim.be","website":"http:\/\/www.mim.be","phone_contact":"+32 2 545 01 30","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Montagne de la Cour, 2","address_line2":"1000 Bruxelles","description_web":"Todo o mundo admira a cole\u00e7\u00e3o do Museu dos Instrumentos Musicais, que pertence ao conjunto dos Museus Reais de Arte e da Hist\u00f3ria. Este museu assenta no cora\u00e7\u00e3o dos velhos edif\u00edcios Old England, um dos edif\u00edcios mais belos de estilo Art Nouveau de Bruxelas, datando de 1899. Este museu \u00e9 um dos mais ricos do mundo: cerca de 1200 instrumentos encontram-se a\u00ed expostos. Consta da programa\u00e7\u00e3o de interessantes anima\u00e7\u00f5es e in\u00fameros concertos.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"MIM - Mus\u00e9e des instruments de musique (MRAH)","address_street_name":"Rue Montagne de la Cour","address_street_number":"2","address_street_box":null,"email":"info@mim.be","website":"http:\/\/www.mim.be","phone_contact":"+32 2 545 01 30","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Montagne de la Cour, 2","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[16],"translations":{"fr":["Quartier Royal"],"nl":["Koninklijke wijk"],"en":["Royal"]}},"zones":{"list":[19],"translations":{"fr":["Centre"],"nl":["Centrum"],"en":["Centre"]}},"neca":null,"facebook_id":null,"backoffice_id":359,"location":{"lat":50.84274286,"lon":4.35903823},"region":"brussels","last_updated_at":"2022-07-21T01:08:57+02:00","published_at":"2013-10-19T01:13:28+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":100473,"translations":{"fr":{"name":"MIM - Mus\u00e9e des instruments de musique (MRAH)","address_street_name":"Rue Montagne de la Cour","address_street_number":"2","address_street_box":null,"email":"info@mim.be","website":"http:\/\/www.mim.be","phone_contact":"+32 2 545 01 30","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Montagne de la Cour, 2","address_line2":"1000 Bruxelles","description_web":"Le monde entier admire la collection du Mus\u00e9e des instruments de musique qui fait partie du groupement des Mus\u00e9es Royaux d\u2019Art et d\u2019Histoire. Ce Mus\u00e9e est camp\u00e9 au c\u0153ur des anciens b\u00e2timents Old England, un des plus beaux b\u00e2timents de style Art Nouveau de Bruxelles, datant de 1899. Ce mus\u00e9e est l\u2019u