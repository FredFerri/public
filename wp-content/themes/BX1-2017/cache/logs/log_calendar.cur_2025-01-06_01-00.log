stheatre-mercelis\/","email":"jmbxl@jeunessesmusicales.be","phone_contact":"+32 2 897 01 70","phone_booking":"+32 2 897 01 70","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700001274"},"pt":{"name":"Bloutch \u201cL\u2019aube des bulles\u201d","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.jeunessesmusicales.be\/bruxelles\/bloutch-laube-des-bullestheatre-mercelis\/","email":"jmbxl@jeunessesmusicales.be","phone_contact":"+32 2 897 01 70","phone_booking":"+32 2 897 01 70","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700001274"},"en":{"name":"Bloutch \u201cL\u2019aube des bulles\u201d","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.jeunessesmusicales.be\/bruxelles\/bloutch-laube-des-bullestheatre-mercelis\/","email":"jmbxl@jeunessesmusicales.be","phone_contact":"+32 2 897 01 70","phone_booking":"+32 2 897 01 70","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700001274"},"it":{"name":"Bloutch \u201cL\u2019aube des bulles\u201d","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.jeunessesmusicales.be\/bruxelles\/bloutch-laube-des-bullestheatre-mercelis\/","email":"jmbxl@jeunessesmusicales.be","phone_contact":"+32 2 897 01 70","phone_booking":"+32 2 897 01 70","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700001274"},"cn":{"name":"Bloutch \u201cL\u2019aube des bulles\u201d","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.jeunessesmusicales.be\/bruxelles\/bloutch-laube-des-bullestheatre-mercelis\/","email":"jmbxl@jeunessesmusicales.be","phone_contact":"+32 2 897 01 70","phone_booking":"+32 2 897 01 70","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700001274"},"fr":{"name":"Bloutch \u201cL\u2019aube des bulles\u201d","shortdescr":"Dans un univers \u00e0 la fois cocoon et myst\u00e9rieux, Sophie et Julien installent un climat de bienveillance avec une s\u00e9rie de chansons intimistes, tant\u00f4t douces, tant\u00f4t entra\u00eenantes. ","longdescr":"Dans un univers \u00e0 la fois cocoon et myst\u00e9rieux, Sophie et Julien installent un climat de bienveillance avec une s\u00e9rie de chansons intimistes, tant\u00f4t douces, tant\u00f4t entra\u00eenantes. Et nous voil\u00e0 embarqu\u00e9s dans un voyage de questionnements et d\u2019observations sur nos v\u00e9cus int\u00e9rieurs et nos besoins de les ext\u00e9rioriser. Bloutch partage avec son public cette pr\u00e9cieuse complicit\u00e9, propice \u00e0 un moment d\u2019\u00e9change et d\u2019interactions o\u00f9 artistes et enfants se nourrissent mutuellement.\n\nDiverses influences composent l\u2019univers musical de Bloutch : on vogue entre la cumbia colombienne, le sega r\u00e9unionnais, la coladeira cap-verdienne, s\u2019autorisant de petites escales dans les Balkans et au Br\u00e9sil. Sur sc\u00e8ne, Sophie et Julien m\u00ealent leurs voix comme leurs instruments ; la batterie, la guitare et l\u2019accord\u00e9on y c\u00f4toient l\u2019harmonium indien et le n\u2019goni d\u2019Afrique de l\u2019Ouest, invitant petits et grands \u00e0 danser et chanter.\n\nLes enfants se baladent \u00e0 travers des jeux de langages, une invitation \u00e0 \u00ab habiter \u00bb son propre corps, un moment exutoire de danse collective, une observation sur la contagiosit\u00e9 de nos humeurs, une satire de notre soci\u00e9t\u00e9 d\u2019empressement permanent, l\u2019\u00e9merveillement de tenir un b\u00e9b\u00e9 contre soi ou encore une ode \u00e0 notre besoin de \u00ab sortir \u00bb. Quelques petites bulles de tendresse distill\u00e9es au sein d\u2019un spectacle musical lumineux et participatif, pour notre plus grand bonheur !","performers":"Julien Burette (Guitare, batterie, percussions, n\u2019goni, chant); Sophie Debaisieux (Accord\u00e9on, harmonium, chant)","boxoffice_url":null,"website":"https:\/\/www.jeunessesmusicales.be\/bruxelles\/bloutch-laube-des-bullestheatre-mercelis\/","email":"jmbxl@jeunessesmusicales.be","phone_contact":"+32 2 897 01 70","phone_booking":"+32 2 897 01 70","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700001274"},"sp":{"name":"Bloutch \u201cL\u2019aube des bulles\u201d","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.jeunessesmusicales.be\/bruxelles\/bloutch-laube-des-bullestheatre-mercelis\/","email":"jmbxl@jeunessesmusicales.be","phone_contact":"+32 2 897 01 70","phone_booking":"+32 2 897 01 70","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700001274"},"nl":{"name":"Bloutch \u201cL\u2019aube des bulles\u201d","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.jeunessesmusicales.be\/bruxelles\/bloutch-laube-des-bullestheatre-mercelis\/","email":"jmbxl@jeunessesmusicales.be","phone_contact":"+32 2 897 01 70","phone_booking":"+32 2 897 01 70","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700001274"}},"place":{"id":50000939,"translations":{"de":{"name":"Th\u00e9\u00e2tre Mercelis","address_street_name":"Rue Mercelis","address_street_number":"13","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Mercelis, 13","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Th\u00e9\u00e2tre Mercelis","address_street_name":"Rue Mercelis","address_street_number":"13","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Mercelis, 13","address_line2":"1050 Ixelles","description_web":nu