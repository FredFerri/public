55+01:00","published_at":"2022-04-07T14:02:59+02:00","backoffice_id":251124,"import_origin":null,"sub_type":"other","show_in_agenda":true,"ranking":0.096961157376676},{"id":537533,"date_start":"2023-01-04","date_end":"2023-01-28","date_next":"2023-01-04","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater","it":null,"sp":null,"pt":null,"cn":null}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"],"de":["Theater"],"it":[null],"sp":[null],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Tout \u00c7a Ne Nous Rendra Pas No\u00ebl","shortdescr":"\u00ab J\u2019ai m\u00eame un ami noir ! \u00bb","longdescr":"Le r\u00e9veillon de No\u00ebl chez Charlotte et Dany, c\u2019est comme chez vous : petits fours, champagne, famille et amis plus ou moins contents d\u2019\u00eatre l\u00e0. Mais au r\u00e9veillon de No\u00ebl chez Charlotte et Dany, il y a aussi une invit\u00e9e surprise aussi charismatique que myst\u00e9rieuse et surtout UNE r\u00e8gle pour les cadeaux qui doivent \u00eatre plac\u00e9s anonymement sous le sapin et pioch\u00e9s au hasard par les invit\u00e9s. Tout d\u00e9rape quand un convive a l\u2019excelllllllente id\u00e9e d\u2019y d\u00e9poser un album de Tintin au Congo, vieil h\u00e9ritage de famille\u2026\r\n\r\nGloups, l\u2019h\u00e9ritage : les vieux dossiers familiaux vont d\u00e9border des placards. \u00c7a rit, \u00e7a grince, ce n\u2019est ni une com\u00e9die ni un drame, c\u2019est un spectacle qui ressemble avant tout \u00e0 la vie quand le politique s\u2019y invite sans crier gare et o\u00f9 l\u2019amour finira par triompher d\u2019une mani\u00e8re, disons\u2026 inattendue. Venez dig\u00e9rer vos exc\u00e8s des f\u00eates au TTO gr\u00e2ce \u00e0 ce spectacle d\u00e9licieusement acide, gros succ\u00e8s des f\u00eates 2021.","performers":"De Albert Maizel Avec Odile Matthieu, Fred Nyssen,Thibaut Neve, Bwanga Pilipili, Pierre Lafleur, Thibault Packeu Mise en sc\u00e8ne Nathalie Uffner Assistanat \u00e0 la mise en sc\u00e8ne Laure Chartier D\u00e9cors Charly Kleinermann Costumes Laurence Van H Cr\u00e9ation lumi\u00e8res Alain Collet  Production Th\u00e9\u00e2tre de la Toison d\u2019Or Photo \u00a9Lou Verschueren","boxoffice_url":null,"website":"http:\/\/www.ttotheatre.be","email":"info@ttotheatre.be","phone_contact":null,"phone_booking":"+32 2 510 05 10","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.537533"},"nl":{"name":"Tout \u00c7a Ne Nous Rendra Pas No\u00ebl","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.537533"},"en":{"name":"Tout \u00c7a Ne Nous Rendra Pas No\u00ebl","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.537533"},"de":{"name":"Tout \u00c7a Ne Nous Rendra Pas No\u00ebl","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.537533"},"it":{"name":"Tout \u00c7a Ne Nous Rendra Pas No\u00ebl","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.537533"},"sp":{"name":"Tout \u00c7a Ne