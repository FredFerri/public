L\u2019Art nouveau se d\u00e9cline de multiples fa\u00e7ons, toutes plus originales les unes que les autres. Les influences g\u00e9om\u00e9triques ou organiques conf\u00e8rent aux \u00e9difices des particularit\u00e9s \u00e9tonnantes, reflets des sensibilit\u00e9s des architectes ou des commanditaires. Ce circuit vous invite \u00e0 une lecture de fa\u00e7ades typiques du style Art nouveau, autour de l\u2019ancien quartier de son chef de file, Victor Horta.","performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/1001-facettes-de-lart-nouveau","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":"+32 2 319 45 60","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.555322"},"nl":{"name":"1001 facettes de l'Art nouveau","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/1001-facettes-de-lart-nouveau","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":"+32 2 319 45 60","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.555322"},"en":{"name":"1001 facettes de l'Art nouveau","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/1001-facettes-de-lart-nouveau","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":"+32 2 319 45 60","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.555322"},"de":{"name":"1001 facettes de l'Art nouveau","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/1001-facettes-de-lart-nouveau","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":"+32 2 319 45 60","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.555322"},"it":{"name":"1001 facettes de l'Art nouveau","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null