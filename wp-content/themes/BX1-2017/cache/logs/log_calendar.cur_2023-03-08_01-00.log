ers met hulpmiddelen","Aangepast toilet"],"en":["Accessible","Accessible to pedestrians with mobility aids","Adapted toilet"],"de":["Barrierefrei","Barrierefrei f\u00fcr Fu\u00dfg\u00e4nger mit Gehhilfe","Barrierefreies WC"],"it":["Accessibile","Accessibile ai pedoni con supporti","WC idoneo"],"sp":["Habilitado","Habilitado para peatones con aud\u00edfonos","Ba\u00f1os adaptados"],"pt":[null,null,null],"cn":[null,null,null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2023-03-06T11:05:07+01:00","published_at":"2023-03-06T10:24:51+01:00","backoffice_id":272925,"import_origin":null,"sub_type":"brocante","show_in_agenda":true,"ranking":1.2599210498949},{"id":552806,"date_start":"2023-03-18","date_end":"2023-03-18","date_next":"2023-03-18","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen","it":"Visite guidate","sp":"Visitas guiadas","pt":null,"cn":null}},"others":{}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Visite guid\u00e9e \u00e0 l\u2019Hof ter Musshen","shortdescr":null,"longdescr":"A la d\u00e9couverte de l\u2019Hof ter Musshen et de la Woluwe.\r\n\r\nEn coop\u00e9ration avec la commune de Woluwe-Saint-Lambert, la CEBE mettra le patrimoine bleu de notre capitale \u00e0 l\u2019honneur en organisant, le dimanche 26 mars, une visite guid\u00e9e intitul\u00e9e \"L\u2019Hof ter Musschen: une zone naturelle en bords de Woluwe\".\r\n\r\nRendez-vous: Coin Boulevard de la Woluwe et Avenue Hippocrate\r\n\r\nAutres d\u00e9tails:\r\nInfo: michel.moreels57@hotmail.com","performers":null,"boxoffice_url":null,"website":"https:\/\/environnement.brussels\/citoyen\/agenda\/campaign\/journees-bruxelloises-de-leau-2023","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.552806"},"nl":{"name":"Rondleiding door het Hof ter Musshen","shortdescr":null,"longdescr":"Ontdekking van het Hof ter Musshen en de Woluwe.\r\n\r\nHet Hof-ter-Musschen of de Mussenhoeve en zijn omgeving vormen een semi-natuurlijk landschap van 10 ha dat wegens zijn grote biologische waarde al in 1994 geklasseerd werd.\r\n\r\nMen vindt er moerassen, drassige weilanden, stukken bos, de Brabantse hoeve en de windmolen, die samen een opmerkelijk openluchtmuseum vormen van het vroegere rurale landschap van Groot Brussel.\r\n\r\nInfo: michel.moreels57@hotmail.com","performers":null,"boxoffice_url":null,"website":"https:\/\/environnement.brussels\/citoyen\/agenda\/campaign\/journees-bruxelloises-de-leau-2023","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.552806"},"en":{"name":"Visite guid\u00e9e \u00e0 l\u2019Hof ter Musshen","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/environnement.brussels\/citoyen\/agenda\/campaign\/journees-bruxelloises-de-leau-2023","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.552806"},"de":{"name":"Visite guid\u00e9e \u00e0 l\u2019Hof ter Musshen","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/environnement.brussels\/citoyen\/agenda\/campaign\/journees-bruxelloises-de-leau-2023","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.552806"},"it":{"name":"Visite guid\u00e9e \u00e0 l\u2019Hof ter Musshen","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/environnement.brussels\