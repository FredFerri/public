"backoffice_id":25706,"location":{"lat":50.82838365,"lon":4.35263178},"region":"brussels","last_updated_at":"2022-10-11T10:35:04+02:00","published_at":"2016-04-07T12:34:26+02:00","import_origin":null,"external_id":null,"is_in_address_book":false,"is_in_vb_export":false,"resto_ranking":0},"media":[{"type":"poster","link":"https:\/\/agendabrussels.imgix.net\/f7b696a240c08c64d2b6546427c4de0bc34cf62e.png","width":1366,"height":762,"ratio":1.79,"translations":{"fr":{"title":"Pop-up shop: SAIAN laboratory & Atelier Sashiko Belgium","copyright":null},"nl":{"title":"Pop-up shop: SAIAN laboratory & Atelier Sashiko Belgium","copyright":null},"en":{"title":"Pop-up shop: SAIAN laboratory & Atelier Sashiko Belgium","copyright":null}}}],"dates":[{"day":"2022-10-16","doors":"11:00:00","start":"12:30:00","end":"17:30:00","is_soldout":false,"is_canceled":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-11T10:35:04+02:00","published_at":"2022-10-11T09:39:36+02:00","backoffice_id":263835,"import_origin":null,"sub_type":"brocante","show_in_agenda":true,"ranking":1},{"id":542600,"date_start":"2022-10-16","date_end":"2022-10-16","date_next":"2022-10-16","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":74,"translations":{"fr":"Sport","nl":"Sport","en":"Sport","de":"Sport"}},"others":{"list":[159,164],"translations":{"fr":["Activit\u00e9 sportive","Fitness, gymnastique, danse et sports de combats"],"nl":["Sportieve activiteit","Fitness, gymnastiek, dans en vechtsport"],"en":["Sporting activity","Fitness, gymnastics, dance and combat sports"],"de":["Sportliche Aktivit\u00e4t","Fitness, Gymnastik, Tanz & Kampfsportarten"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Initiation \u00e0 la self-d\u00e9fense","shortdescr":"Vous pensez que savoir quoi faire en cas d'agression est une bonne id\u00e9e?\r\n\r\nNous aussi! C'est pour \u00e7a que nous organisons des stages d'introduction \u00e0 la self-d\u00e9fense. On ne va pas faire de vous des guerriers en une apr\u00e8s-midi, mais on va vous apprendre les gestes essentiels pour vous sortir d'une mauvaise situation.","longdescr":"Chez Lambda D\u00e9fense nous souhaitons que la self-d\u00e9fense soit accessible \u00e0 tous. Mais nous savons que tout le monde n'a pas le temps de s'y former de mani\u00e8re r\u00e9guli\u00e8re.\r\nC'est pourquoi nous organisons une initiation \u00e0 la protection personnelle en une apr\u00e8s-midi.\r\nNous allons faire en sorte qu'apr\u00e8s ces 3 heures de stage, vous connaissiez les bons gestes \u00e0 avoir en cas de probl\u00e8mes.\r\nNous aborderons les aspects psycho-sociologiques de la protection personnelle ainsi que l\u00e9gaux (notion de l\u00e9gitime d\u00e9fense).\r\nNous pratiquerons ensuite une unique technique de self-d\u00e9fense \"passe-partout\" que nous r\u00e9p\u00e9terons dans de multiples sc\u00e9narii afin de vous pr\u00e9parer \u00e0 toutes sortes de situations.\r\nLe cours est ouvert \u00e0 tous (\u00e0 partir de 14 ans).\r\n=============================================\r\nTarif: 35 \u20ac pour les 3 heures d'initiation.\r\nInscriptions sur le site de Lambda D\u00e9fense: https:\/\/www.lambda-defense.be\/initiation\r\nR\u00e9ductions:\r\n- 50% de r\u00e9duction si vous avez d\u00e9j\u00e0 particip\u00e9 au s\u00e9minaire lors d'une \u00e9dition pr\u00e9c\u00e9dente.\r\n- 100% de r\u00e9duction si vous avez d\u00e9j\u00e0 particip\u00e9 au s\u00e9minaire lors d'une \u00e9dition pr\u00e9c\u00e9dente et que vous venez accompagn\u00e9!\r\nN'h\u00e9sitez pas \u00e0 me contacter pour plus d'informations","performers":null,"boxoffice_url":null,"website":"https:\/\/www.lambda-defense.be\/initiation","email":"quentin@lambda-defense.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.542600"},"nl":{"name":"Initiation \u00e0 la self-d\u00e9fense","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"plomteuxquentin@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.542600"},"en":{"name":"Initiation \u00e0 la self-d\u00e9fense","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"plomteuxquentin@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.542600"},"de":{"name":"Initiation \u00e0 la self-d\u00e9fense","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.542600"},"it":{"name":"Initiation \u00e0 la self-d\u00e9fense","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.542600"},"sp":{"name":"Initiation \u00e0 la self-d\u00e9fense","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.542600"},"pt":{"name":"Initiation \u00e0 la self-d\u00e9fense","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.542600"},"cn":{"name":"Initiation \u00