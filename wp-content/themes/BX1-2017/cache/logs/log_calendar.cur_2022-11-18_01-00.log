n World 2021-2022"},"nl":{"title":"Balades Litte\u0301raires \u00e0 Train World 2021-2022"},"en":{"title":"Balades Litte\u0301raires \u00e0 Train World 2021-2022"}}}],"dates":[],"recurring":[],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":18}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":{"list":[252,255,256,257,259,261,263,265,266],"translations":{"fr":["Accessible aux personnes ayant des difficult\u00e9s de compr\u00e9hension","Accessible","Am\u00e9nagements pour les personnes aveugles et malvoyantes","Am\u00e9nagements pour personnes sourdes et malentendantes","Chien d'assistance","Parking accessible","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9","Brussels Health Safety Label"],"nl":["Toegankelijk voor mensen met een verstandelijke beperking","Toegankelijk","Voorzieningen voor blinde en slechtziende personen","Voorzieningen voor dove en slechthorende personen","Assistentiehonden","Toegankelijke parking","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet","Brussels Health Safety Label"],"en":["Accessible to people with intellectual disabilities","Accessible","Facilities for blind and partially-sighted persons","Facilities for deaf and hearing-impaired people","Assistance dogs","Accessible parking","Accessible to pedestrians with mobility aids","Adapted toilet","Brussels Health Safety Label"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-10T17:05:33+02:00","published_at":"2022-06-22T09:11:00+02:00","backoffice_id":256207,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.20053619559536},{"id":539067,"date_start":"2022-10-10","date_end":"2023-01-23","date_next":"2023-01-23","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater"}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"],"de":["Theater"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Lectures th\u00e9\u00e2trales par les Universit\u00e9s Populaires du Th\u00e9\u00e2tre","shortdescr":null,"longdescr":"\u00ab Vive l\u2019Ecole Moderne ! \u00bb\r\n\r\nPour leur deuxi\u00e8me ann\u00e9e de collaboration, les Universit\u00e9s Populaires du Th\u00e9\u00e2tre et le WHalll ont d\u00e9cid\u00e9 de proposer au public une trilogie qui vous permettra de d\u00e9couvrir trois grandes figures de p\u00e9dagogues qui ont invent\u00e9 l\u2019Ecole Moderne, parfois au p\u00e9ril de leur vie. En effet, deux de ces trois grands personnages (Janusz Korczak et Francisco Ferrer) sont morts pour leurs convictions et par amour de leurs \u00e9l\u00e8ves. Tous trois ont jet\u00e9 les bases de m\u00e9thodes p\u00e9dagogiques devenues aujourd\u2019hui universelles. \r\n\r\nAu programme:\r\n\r\n- Lundi 10\/10\/2022: Francisco Ferrer - Vive l\u2019Ecole Moderne !  \r\n- Lundi 7\/11\/2022: Korczak, la t\u00eate haute  \r\n- Lundi 23\/01\/2023: Les combats de C\u00e9lestin Freinet","performers":null,"boxoffice_url":null,"website":"http:\/\/www.whalll.be","email":"billetterie@whalll.be","phone_contact":"+32 2 435 59 99","phone_booking":"+32 2 435 59 99","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.539067"},"nl":{"name":"Lectures th\u00e9\u00e2trales par les Universit\u00e9s Populaires du Th\u00e9\u00e2tre","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.539067"},"en":{"name":"Lectures th\u00e9\