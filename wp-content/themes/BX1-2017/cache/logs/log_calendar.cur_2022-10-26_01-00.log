t":false,"is_canceled":false},{"day":"2021-12-02","doors":null,"start":"13:30:00","end":"15:30:00","is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":40},{"translations":{"fr":{"name":"Enfants"},"nl":{"name":"Kinderen"},"en":{"name":"Children"}},"value":0}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[1,2,3,4,5,6,7,8,9],"translations":{"fr":["Maternel","Primaire","Secondaire","6 - 8 ans","8 - 10 ans","10 - 12 ans","12 - 14 ans","14 - 16 ans","16 - 18 ans"],"nl":["Kleuteronderwijs","Lagere school","Secundair onderwijs","6 - 8 jaar","8 - 10 jaar","10 - 12 jaar","12 - 14 jaar","14 - 16 jaar","16 - 18 jaar"],"en":["Kindergarden","Primary school","Secondary school","6 - 8 years","8 - 10 years","10 - 12 years","12 - 14 years","14 - 16 years","16 - 18 years"]}},"tags":["exterior"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-11T00:05:07+02:00","published_at":"2021-11-08T11:43:11+01:00","backoffice_id":242403,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.13992727562026},{"id":543692,"date_start":"2022-10-09","date_end":"2022-12-22","date_next":"2022-11-09","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert","de":"Konzert"}},"others":{"list":[4,6],"translations":{"fr":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"],"nl":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"],"en":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"],"de":["Pop, Rock, Jazz...","Worldmusic, Folk & Country"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"L\u2019invitation Au Voyage au Jardin Musical","shortdescr":"Invitation au voyage, o\u00f9 se fondent en harmonie la po\u00e9sie et les musique improvis\u00e9es de l\u2019orient et l\u2019occident, une rencontre propos\u00e9e par la chanteuse d\u2019origine tunisienne Ghalia Benali,le pianiste fran\u00e7ais Julien Brocal et un panel de musiciens vari\u00e9s.","longdescr":"Bien plus qu'un concert dans un salon...\r\n\r\nVivez un moment privil\u00e9gi\u00e9 de musique dans un cadre unique et intimiste.\r\n\u200b\r\nPrenez place au centre d'un \u00e9cosyst\u00e8me d'artistes cr\u00e9e par des artistes et :\r\n\r\nAssistez \u00e0 des concerts exceptionnels de musiciens \u00e0 la renomm\u00e9e internationale\r\n\r\nRencontrez, discutez et \u00e9changez avec les artistes et une \u00e9quipe de passionn\u00e9s apr\u00e8s nos concerts autour d\u2019un verre de l\u2019amiti\u00e9 offert\r\n\r\nDevenez co-producteur des talents de cet \u00e9cosyst\u00e8me : 50 % des b\u00e9n\u00e9fices g\u00e9n\u00e9r\u00e9s par l'achat de vos tickets sont revers\u00e9s aux artistes.\r\n\r\n\r\nN'attendez plus ! Consultez notre programmation et laissez-vous entra\u00eener dans le c\u0153ur historique de Bruxelles pour des moments musicaux et de partage inoubliables.\r\n\r\nL'\u00e9quipe du Jardin Musical","performers":"Avec Ghalia Benali, Julien Brocal et pleins d\u2019invit\u00e9s surprises","boxoffice_url":null,"website":"https:\/\/www.jardinmusical.org\/agenda-billetterie","email":"info@jardinmusical.org","phone_contact":"+32 456 04 35 05","phone_booking":"+32 456 04 35 05","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.543692"},"nl":{"name":"L\u2019invitation Au Voyage in de Jardin Musical","shortdescr":"Een uitnodiging tot reizen, waar po\u00ebzie en ge\u00efmproviseerde muziek uit het Oosten en het Westen in harmonie samensmelten, een ontmoeting voorgesteld door de in Tunesi\u00eb geboren zangeres Ghalia Benali, de Franse pianist Julien Brocal en een panel aan gevarieerde muzikanten.","longdescr":"Veel meer dan een concert in een huiskamer...\r\n\r\nBeleef een bevoorrecht muziekmoment in een unieke en intieme setting.\r\n\r\nNeem plaats midden in een ecosysteem van artiesten voor artiesten en:\r\n\r\n\u200b\r\n\r\nBeleef uitzonderlijke concerten bij van internationaal gerenommeerde muzikanten\r\n\r\nOntmoet, en verbind met de artiesten en een gepassioneerd team na onze concerten rond een glaasje vriendschappelijk aangeboden door het huis\r\n\r\nWordt mede-producent van de talenten in ons ecosysteem: 50% van de winst van de gekochte tickets gaat rechtstreeks naar de artiesten\r\n\r\nKom snel ! Ontdek ons programma en laat u verleiden door deze muzikale momenten en memorabele uitwisselingen in het historisch hart van Brussel!\r\n\r\n\r\nHet team van de \"Jardin Musical\"","performers":"Met Ghalia Benali, Julien Brocal en vele onverwachte gasten...","boxoffice_url":null,"website":null,"email":"info@jardinmusical.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.543692"},"en":{"name":"L\u2019invitation Au Voyage in the Jardin Musical","shortdescr":"Invitation to travel, where poetry and improvised music from the East and the West merge in harmony, a meeting proposed by the Tunisian-born singer Ghalia Benali, the French pianist Julien Brocal and a panel of various musicians.","longdescr":"Much more than a concert in a living room...\r\n\r\nLive a privileged moment of music in a unique and intimate setting.\r\n\r\nBook your seat at the center of an ecosystem created by artists for artists and: \r\n\r\nAttend exceptional concerts by internationally renowned musicians\r\n\r\nMeet, chat and exchange with the artists and the enthusiastic team of the \"Jardin Musical\" after our concerts with a glass of friendship generously presented\r\n\r\nBecome a co-producer of the talents of this ecosystem: 50% of the profits generated by the purchase of your tickets are payed out to the artists.\r\n\r\nDon't wait any longer ! Have a look at our program and allow yourself getting carried away in the historic heart of Brussels for unforgettable musical moments and sharing.\r\n \r\n\r\nJardin Musical team","performers":"With Ghalia Benali, Julien Brocal and many surprise guests","boxoffice_url":null,"website":null,"email":"info@jardinmusical.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.543692"},"de":{"name":"L\u2019invitation Au Voyage au Jardin Musical, avec Ghalia Benali","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.543692"},"it":{"name":"L\u2019invitation Au Voyage au Jardin Musical, avec Ghalia Benali","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.543692"},"sp":{"name":"L\u2019invitation Au Voyage au Jardin Musical, avec Ghalia Benali","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.543692"},"pt":{"name":"L\u2019invitation Au Voyage au Jardin Musical, avec Ghalia Benali","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.543692"},"cn":{"name":"L\u2019invitation Au Voyage au Jardin Musical, avec Ghalia Benali","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"pho