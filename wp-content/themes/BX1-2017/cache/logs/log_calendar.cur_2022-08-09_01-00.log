d":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":10}],"child_events":[],"parent_events":[],"targets":{"list":[10,12,8,7,11,19,5],"translations":{"fr":["Seniors","LGTBQIA","Jeunes 15-18 ans","Jeunes 12-15 ans","Famille","Enseignants","Enfants 9-12 ans"],"nl":["Senioren","LGTBQIA","Jongeren 15-18 j.","Jongeren 12-15 j.","Familie","Leerkrachten","Kinderen 9-12 j."],"en":["Seniors","LGTBQIA","Youth 15-18  yr.","Youth 12-15  yr.","Family","Teachers","Children 9-12 yr."]}},"tags":["exterior","kids"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-07-08T16:05:06+02:00","published_at":"2022-07-08T14:14:20+02:00","backoffice_id":258151,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":1},{"id":535898,"date_start":"2022-08-27","date_end":"2022-08-29","date_next":"2022-08-27","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre"}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"L'envers du d\u00e9cor","shortdescr":"Toujours garder ses amis proches et ses ennemis encore plus proches!\r\n\u00abL\u2019envers du d\u00e9cor\u00bb est une pi\u00e8ce de Florian Zeller, r\u00e9cemment oscaris\u00e9 pour l\u2019adaptation cin\u00e9matographique de sa pi\u00e8ce \u00abLe P\u00e8re\u00bb.","longdescr":"Un Zeller de premier choix qui parle \u00e0 tous ! Avec finesse et justesse, l\u2019auteur explore ici le c\u0153ur des cinquantenaires confront\u00e9s \u00e0 la r\u00e9alit\u00e9 du temps qui passe et l\u2019envie de vivre encore des choses loin de la routine journali\u00e8re. Toute la m\u00e9canique du boulevard est l\u00e0, mais en g\u00e9n\u00e9ral dans ses pi\u00e8ces, l\u2019int\u00e9r\u00eat se porte moins sur ce qui est dit que sur ce qui ne l\u2019est pas. Ici, c\u2019est tout le contraire. L\u2019originalit\u00e9 de \u00ab L\u2019Envers du d\u00e9cor \u00bb r\u00e9side dans le fait que le public est le t\u00e9moin et le r\u00e9ceptacle des pens\u00e9es des personnages qui s\u2019expriment en apart\u00e9. Les acteurs jonglent en permanence avec la technique du double langage et une v\u00e9rit\u00e9 comique, cruelle et merveilleusement path\u00e9tique, appara\u00eet.\r\n\r\nSi nous ne pensons pas toujours ce que nous disons, disons-nous toujours ce que nous pensons ?\r\n\r\nDaniel invite \u00e0 d\u00eener, contre l\u2019avis de son \u00e9pouse, son meilleur ami et sa nouvelle conqu\u00eate. L\u2019apparition de la jeune et sublime cr\u00e9ature agit comme un catalyseur et provoque une temp\u00eate dans la t\u00eate des ma\u00eetres de maison, bousculant leurs certitudes, r\u00e9veillant frustration, jalousie et aigreur.","performers":"COM\u00c9DIE DE FLORIAN ZELLER\r\nMise en sc\u00e8ne: Daniel Hanssens \u25aa Avec: Laure Godisiabois, Sarah Dupr\u00e9, Pierre Pigeolet, Daniel Hanssens \u25aa","boxoffice_url":"https:\/\/shop.utick.be\/?pos=FESTIVALBRUXELLONS&module=CATALOGUE&lg=FR","website":"http:\/\/www.bruxellons.be","email":"info@bruxellons.net","phone_contact":null,"phone_booking":"+32 2 724 24 24","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.535898"},"nl":{"name":"L'envers du d\u00e9cor","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/shop.utick.be\/?pos=FESTIVALBRUXELLONS&module=CATALOGUE&lg=NL","website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.535898"},"en":{"name":"L'envers du d\u00e9cor","shortdescr":null