ts pour une visite jubilatoire ? Alors, suivez le guide !\r\n\r\nUn conservateur terroris\u00e9 par les plantes vertes, des gardiens \u00e9puis\u00e9s par Rodin, des touristes galopant d\u2019une salle \u00e0 l\u2019autre\u2026 Ils sont tous l\u00e0, artistes, visiteurs, conservateurs et guides qui s\u2019\u00e9parpillent en une avalanche de situations burlesques o\u00f9 les go\u00fbts et les couleurs s\u2019expriment dans toute leur splendeur. Jean-Michel Ribes a imagin\u00e9 chaque sayn\u00e8te dans un style th\u00e9\u00e2tral aussi diff\u00e9rent que l\u2019est celui des salles de mus\u00e9e\u2026 Et c\u2019est d\u00e9licieusement dr\u00f4le.\r\n\r\nTARIF \r\nPR\u00c9VENTE jusqu\u2019au 31.07 \u20ac 19 \/ VENTE \u00e0pd 01.08 \u20ac 22 ABO ADULTE-WSL -SENIOR 17\u20ac","performers":"DE Jean-Michel Ribes AVEC Catherine Claeys, S\u00e9verine De Witte, Sarah Woestyn, Arnaud Van Parys, Maroine Amimi, Marc De Roy MISE EN SC\u00c8NE Sandra Raco PRODUCTION Th\u00e9\u00e2tre des Galeries PHOTOS DR","boxoffice_url":null,"website":"https:\/\/www.wolubilis.be\/a-voir\/musee-haut-musee-bas\/","email":null,"phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/537226.html"},"nl":{"name":"Spectacle d'\u00e9t\u00e9: Mus\u00e9e haut, mus\u00e9e bas","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/537226.html"},"en":{"name":"Spectacle d'\u00e9t\u00e9: Mus\u00e9e haut, mus\u00e9e bas","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/537226.html"},"de":{"name":"Spectacle d'\u00e9t\u00e9: Mus\u00e9e haut, mus\u00e9e bas","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_