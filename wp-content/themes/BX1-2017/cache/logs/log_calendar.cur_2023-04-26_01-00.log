6257},"region":"brussels","last_updated_at":"2023-04-25T09:05:15+02:00","published_at":"2013-10-19T01:13:20+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"media":[],"dates":[{"day":"2023-04-29","doors":null,"start":"14:00:00","end":null,"is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"},"de":{"name":"Normal"},"it":{"name":"Normale"},"sp":{"name":"Normal"},"pt":{"name":"Normal"},"cn":{"name":"Normal"}},"value":0}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":["exterior"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-04-25T09:05:15+02:00","published_at":"2023-04-25T08:41:10+02:00","backoffice_id":275993,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":1},{"id":555595,"date_start":"2023-04-29","date_end":"2023-05-14","date_next":"2023-04-29","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":90,"translations":{"fr":"Animations","nl":"Animaties","en":"Animations","de":"Animationen","it":"Animazioni","sp":"Animaciones","pt":null,"cn":null}},"others":{"list":[95],"translations":{"fr":["Patrimoine"],"nl":["Erfgoed"],"en":["Heritage"],"de":["Kulturerbe"],"it":["Patrimonio culturale"],"sp":["Patrimonio"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Waouw! verrassingskoffers","shortdescr":"Waouw ! des coffres \u00e0 surprise(s) pour apprendre et s\u2019amuser","longdescr":"Tu veux explorer ? Deviner ? Retrouver ? Cr\u00e9er ? Rigoler ? Raconter ? Empare-toi des coffres Waouw !\r\n\r\n\u00c0 l\u2019accueil, tu re\u00e7ois un trousseau de cl\u00e9s qui ouvre des coffres contenant chacun des activit\u00e9s vari\u00e9es permettant de d\u00e9couvrir un aspect du palais du Coudenberg : sa construction, son histoire, la collection d\u2019objets arch\u00e9ologiques, le m\u00e9tier d\u2019arch\u00e9ologue\u2026 Les jeux, qui se jouent seuls ou \u00e0 plusieurs, te permettront de d\u00e9couvrir de mani\u00e8re amusante l\u2019ancien palais de Bruxelles.\r\n\r\nInfos pratiques\r\nHoraires : vacances de P\u00e2ques, le 29 avril-14 mai (vacances scolaires francophones). Tous les jours sauf le lundi et le dimanche.\r\nDestin\u00e9 aux familles et groupes avec enfants de 4 \u00e0 12 ans, en pr\u00e9sence d\u2019un adulte minimum (6 enfants maximum par famille ou groupe).\r\nActivit\u00e9 en autonomie, sans animateur du Coudenberg.\r\nTarif activit\u00e9: 4 \u20ac par enfant  (+ adulte 10 \u20ac, senior 8 \u20ac).\r\nR\u00e9servation recommand\u00e9 sur le webshop du mus\u00e9e BELvue.\r\nDur\u00e9e : 1 h - 1 h 30\r\nLangues : fran\u00e7ais, n\u00e9erlandais, anglais","performers":null,"boxoffice_url":null,"website":"http:\/\/www.coudenberg.brussels","email":"info@coudenberg.brussels","phone_contact":"+32 2 500 45 54","phone_booking":"+32 2 500 45 54","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.555595"},"nl":{"name":"Waouw! verrassingskoffers","shortdescr":"WAOUW! Verrassingskoffers om iets te leren en plezier te maken","longdescr":"Zin om te ontdekken? Te raden? Dingen te maken? Te lachen? Te vertellen? Ga op zoek naar de WAOUW koffers!\r\n\r\nAan het onthaal krijg je een sleutelbos waarmee je koffers, verspreid in de site, kan openen. Elke koffer bevat materiaal waarmee een bepaald aspect van het Coudenbergpaleis ontdekt kan worden: het gebouw, de geschiedenis ervan, de collectie archeologische voorwerpen, het beroep van archeoloog \u2026 Met de spelletjes, die je alleen of met meerdere kan spelen, kun je op een leuke manier de overblijfselen van het paleis van Brussel ontdekken.\r\n\r\nPraktische informatie\r\nWanneer: 29 april tot 14 mei 2023 (Paasvakantie voor het franstalig onderwijs). Elke dag behalve maandag en zondag.\r\nGeschikt voor gezinnen en groepen met kinderen van 4 tot 12 jaar, met minstens 1 volwassene (maximum 6 kinderen per familie of groep).\r\nTarief voor de activiteit: \u20ac 4 \/ kind (+ volwassene \u20ac 10, senior \u20ac 8)\r\nReservatie online aanbevolen (webshop van het BELvue museum)\r\nDuur: 1u-1u30\r\nTalen: Nederlands, Frans, Engels","performers":null,"boxoffice_url":null,"website":"http:\/\/www.coudenberg.brussels","email":"info@coudenberg.brussels","phone_contact":"+32 2 500 45 54","phone_booking":"+32 2 500 45 54","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.555595"},"en":{"name":"Waouw! verrassingskoffers","shortdescr":"WAOUW! Treasure chests to enjoy and learn from","longdescr":"You\u2019d like to explore? Guess? Find? Create? Laugh? Tell tales? Just get into the Waouw Chests!\r\n\r\nOn arrival, you receive a bunch of keys; these open a number of chests containing a variety of activities to enjoy and discover some aspects of Coudenberg Palace: what it looked like, how it grew, its history, our collection of archaeological objects, archaeology itself\u2026 Games may be for one or several people and will help you to enjoy exploring the former Brussels\u2019 Palace.\r\n\r\nPractical information\r\nWhen: Easter vacations, from April 29th-14th of May 2023, every day except for Mondays and Sundays\r\nSuitable for families with kids: ages 4-12, with at least 1 adult. (Max. 6 children per group \/ family)\r\nActivity without educator from Coudenberg Palace\r\nActivity cost: \u20ac4 \/ child (+ \u20ac10 Adult, \u20ac8 Senior)\r\nReservation recommended (soon on the BELvue Museum webshop). Call: + 32 (0)2 500 45 54 in case of problem\r\nDuration: 1h - 1h30\r\nLanguages: English, French, Dutch","performers":null,"boxoffice_url":null,"website":"http:\/\/www.coudenberg.brussels","email":"info@coudenberg.brussels","phone_contact":"+32 2 500 45 54","phone_booking":"+32 2 500 45 54","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.555595"},"de":{"name":"Waouw! verrassingskoffers","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.coudenberg.brussels","email":"info@coudenberg.brussels","phone_contact":"+32 2 500 45 54","phone_booking":"+32 2 500 45 54","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.555595"},"it":{"name":"Waouw! verrassingskoffers","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.coudenberg.brussels","email":"info@coudenberg.brussels","phone_contact":"+32 2 500 45 54","phone_booking":"+32 2 500 45 54","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.555595"},"sp":{"name":"Waouw! verrassingskoffers","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.coudenberg.brussels","email":"info@coudenberg.brussels","phone_contact":"+32 2 500 45 54","phone_booking":"+32 2 500 45 54","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.555595"},"pt":{"name":"Waouw! verrassingskoffers","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.coudenberg.brussels","email":"info@coudenberg.brussels","phone_contact":"+32 2 500 45 54","phone_booking":"+32 2 500 45 54","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.555595"},"cn":{"name":"Waouw! verrassingskoffers","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.coudenberg.brussels","email":"info@coudenberg.brussels","phone_contact":"+32 2 500 45 54","phone_booking":"+32 2 500 45 54","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.555595"}},"place":{"id":258195,"translations":{"fr":{"name":"Palais du Coudenberg","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@coudenberg.brussels","website":"http:\/\/www.coudenberg.brussels","phone_contact":"+32 2 500 45 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"Autrefois, l\u2019impressionnant palais du Coudenberg dominait la ville de Bruxelles. Charles Quint et d\u2019autres souverains parmi les plus puissants que l\u2019Europe ait connus ont habit\u00e9 cette r\u00e9sidence princi\u00e8re du 12e au 18e si\u00e8cle, jusqu\u2019\u00e0 ce qu\u2019un terrible incendie la d\u00e9truise \u00e0 jamais. Les ruines de ce palais ont disparu pendant de nombreuses ann\u00e9es dans les sous-sols. Aujourd\u2019hui, ces vestiges forment un site arch\u00e9ologique enchanteur constitu\u00e9 d\u2019un r\u00e9seau de salles et de passages souterrains.\r\n \r\nAu cours de votre visite, vous d\u00e9couvrirez les b\u00e2timents principaux du palais et vous fl\u00e2nerez dans la rue Isabelle, qui est aujourd\u2019hui souterraine. Dans le mus\u00e9e du Coudenberg, qui est abrit\u00e9 dans l\u2019h\u00f4tel d\u2019Hoogstraeten, sont expos\u00e9es les plus belles d\u00e9couvertes arch\u00e9ologiques effectu\u00e9es lors des diff\u00e9rentes campagnes de fouilles men\u00e9es sur le site du Coudenberg\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Coudenbergpaleis","address_street_name":"Paleizenplein","address_street_number":"7","address_street_box":null,"email":"info@coudenberg.brussels","website":"http:\/\/www.coudenberg.brussels","phone_contact":"+32 2 500 45 54","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Paleizenplein, 7","address_line2":"1000 Brussel","description_web":"Ooit werd Brussel gedomineerd door het reusachtige Coudenbergpaleis. Keizer Karel en het kruim van de Europese adel verbleven er tussen de twaalfde en de achttiende eeuw. Tot het noodlot toesloeg en een brand het prachtige gebouw verwoestte. Vele resten bleven echter intact en verdwenen ... onder de grond. Nu is het een betoverende archeologische site, een netwerk van gewelfde gangen, zalen en verborgen kamers.\r\n \r\nTijdens een bezoek ontdek je de hoofdgebouwen van het paleis en flaneer je door de Isabellastraat, die nu onder de grond ligt! In het museum van de Coudenberg, dat in het bovengrondse Hof van Hoogstraeten ondergebracht is, kan je de mooiste archeologische voorwerpen bewonderen die in de loop van de verschillende opgravingswerken op de Coudenbergsite werden ontdekt.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Coudenberg Palace","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@coudenberg.brussels","website":"http:\/\/www.coudenberg.brussels","phone_contact":"+32 2 500 45 54","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Place des Palais, 7","address_line2":"1000 Brussels","description_web":"Once upon a time, the Coudenberg Palace towered over the city of Brussels. Charles V and many other of the most powerful rulers ever to reign in Europe made this princely residence their home between the 12th and 18th centuries, until it was consumed by a terrible fire.  Every trace of this prestigious palace simply disappeared underground for many years. Today, however, these ruins constitute a fascinating archeological site incorporating a network of underground passages and chambers.\r\n \r\nWhen you visit it you can explore the principal buildings of the palace and enjoy a stroll along the Rue Isabelle, which is now underground.  In the Coudenberg Museum, located in Hoogstraeten House, the finest of the archeological discoveries made during the various excavations of the Coudenberg site are displayed.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Coudenberg Palast","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@coudenberg.brussels","website":"http:\/\/www.coudenberg.brussels","phone_contact":"+32 2 500 45 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"Ein unterirdischer Parcours, in dessen Verlauf Sie die \u00dcberreste des Palastes von Charles V. entdecken k\u00f6nnen. Seit dem Mittelalter \u00fcberragt eine f\u00fcrstliche Residenz auf dem Coudenberg die Stadt Br\u00fcssel. Das architektonische Ensemble, das sich seit dem 12. Jahrhundert immer wieder weiterentwickelt hat, gilt als einer der sch\u00f6nsten Pal\u00e4ste Europas und eine der wichtigsten Residenzen von Karl V. Dieses prestigetr\u00e4chtige Geb\u00e4ude wurde bei einem Brand im Februar 1731 schwer besch\u00e4digt. Vierzig Jahre sp\u00e4ter wurden die Ruinen des Palasts dem Erdboden gleichgemacht, um Platz f\u00fcr den Place Royale zu machen. Die \u00dcberreste dieses Geb\u00e4udes bilden heute die arch\u00e4ologische St\u00e4tte des Coudenberg. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Coudenberg Palazzo","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@coudenberg.brussels","website":"http:\/\/www.coudenberg.brussels","phone_contact":"+32 2 500 45 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"\"Il sito archeologico di Coudenberg vi svela un percorso sotterraneo e un museo dedicati a Carlo V sulla Place de Palais a Bruxelles.\tSito Archeologico di Coudenbergl sito...\"\r\n\r\nIl sito archeologico di Coudenberg vi svela un percorso sotterraneo e un museo dedicati a Carlo V sulla Place de Palais a Bruxelles.\r\n\r\nSito Archeologico di Coudenberg\r\n\r\nl sito riunisce vestigia dell'antico palazzo di Bruxelles, della residenza di Hoogstraeten e della Rue Isabelle. Un'affascinante passeggiata che vi conduce sotto il pav\u00e9 della place Royale, alla scoperta dei resti del Palazzo di Coudenberg che fu una delle residenze principali di Carlo V. \u00a0\r\n\r\nMuseo del Coudenberg\r\nil museo vi invita a scoprire un'esposizione permanente di oggetti trovati durante gli scavi effettuati sul sito negli ultimi 25 anni. potete combinare la vostra visita con quella del Museo BELvue.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Coudenberg Palacio","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@coudenberg.brussels","website":"http:\/\/www.coudenberg.brussels","phone_contact":"+32 2 500 45 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"En el emplazamiento arqueol\u00f3gico de Coudenberg encontrar\u00e1s un recorrido subterr\u00e1neo y un museo dedicado al Palacio Carlos V, en la Place des Palais de Bruselas....\r\n\r\nEn el emplazamiento arqueol\u00f3gico de Coudenberg encontrar\u00e1s un recorrido subterr\u00e1neo y un museo dedicado al Palacio Carlos V, en la Place des Palais de Bruselas.\r\n\r\nEl emplazamiento arqueol\u00f3gico Coudenberg\r\n\r\nEl emplazamiento arqueol\u00f3gico Coudenberg est\u00e1 compuesto de vestigios del antiguo Palacio de Bruselas, del Hotel Hoogstraeten y de la Rue Isabelle.\u00a0Este fascinante paseo te llevar\u00e1 a descubrir los <b>vestigios del Palacio Coudenberg<\/b>, que fue una de las residencias de Carlos V.\r\n\r\nMuseo Coudenberg\r\n\r\nInstalado en los vestigios del antiguo Hotel de Hoogstraeten, el Museo Coudenberg  te invita a descubrir una <b>exposici\u00f3n permanente<\/b> de objetos hallados durante las distintas <b>excavaciones arqueol\u00f3gicas<\/b> realizadas los \u00faltimos 25 a\u00f1os.\u00a0Podr\u00e1s combinar tu visita del Coudenberg con la del Museo BELvue.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Palais du Coudenberg","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@coudenberg.brussels","website":"http:\/\/www.coudenberg.brussels","phone_contact":"+32 2 500 45 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Palais du Coudenberg","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@coudenberg.brussels","website":"http:\/\/www.coudenberg.brussels","phone_contact":"+32 2 500 45 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[16],"translations":{"fr":["Quartier Royal"],"nl":["Koninklijke wijk"],"en":["Royal"],"de":["K\u00f6nigliches Viertel"],"it":["Quartiere reale"],"sp":["Quartier Royal \u2014Barrio de la Corte\u2014"],"pt":[null],"cn":[null]}},"zones":{"list":[19],"translations":{"fr":["Centre"],"nl":["Centrum"],"en":["Centre"],"de":["Zentrum"],"it":["Centro"],"sp":["Centro"],"pt":[null],"cn":[null]}},"neca":null,"facebook_id":null,"backoffice_id":18195,"location":{"lat":50.84261029,"lon":4.36068879},"region":"brussels","last_updated_at":"2023-04-18T11:05:11+02:00","published_at":"2014-05-05T10:58:29+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_rank