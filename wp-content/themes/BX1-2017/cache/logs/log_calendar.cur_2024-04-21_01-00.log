ine2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Maison Hannon","address_street_name":"Avenue de la Jonction","address_street_number":"1","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Avenue de la Jonction, 1","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Maison Hannon","address_street_name":"Avenue de la Jonction","address_street_number":"1","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Avenue de la Jonction, 1","address_line2":"1060 Saint-Gilles","description_web":"La Maison Hannon, \u00e0 l\u2019angle des avenues Brugmann et de la Jonction, a \u00e9t\u00e9 construite en 1902, \u00e0 la demande du couple Marie et \u00c9douard Hannon, par leur ami l\u2019architecte Jules Brunfaut. Con\u00e7ue comme univers symboliste et onirique, la maison est un des chefs-d\u2019\u0153uvre de l\u2019art nouveau \u00e0 Bruxelles, union de l\u2019art belge et de l\u2019art fran\u00e7ais de l\u2019\u00e9poque. \r\n\r\nJules Brunfaut, peu familier au style nouveau, s\u2019inspirera d\u2019autres maisons d\u2019architectes de l\u2019\u00e9poque, tel que celles de Victor Horta (maison personnelle, h\u00f4tels Tassel et Wessinger), d\u2019Ernest Bl\u00e9rot (maison personnelle, aujourd\u2019hui d\u00e9truite) et d\u2019Octave Van Rysselbeghe et Henry Van de Velde (h\u00f4tel Otlet). \r\n\r\nAlliant style beaux-arts \u00e0 celui de la modernit\u00e9, soit l\u2019art nouveau \u00e0 l\u2019\u00e9poque, la Maison Hannon est une \u0153uvre singuli\u00e8re, une maison intime et personnelle, r\u00e9unissant les go\u00fbts et passions de ses commanditaires. \r\n\r\nLa Maison Hannon ouvre ses portes au public le 1er juin 2023, en tant que maison-mus\u00e9e.\r\n","description_print":null,"booking_url":"https:\/\/shop.utick.net\/?pos=AGENDABRUSSELS&module=ACTIVITYSERIEDETAILS&s=089B0E9A-DB73-AE2D-92E9-879659B7E80B&lg=fr","sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Maison Hannon","address_street_name":"Avenue de la Jonction","address_street_number":"1","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Avenue de la Jonction, 1","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Maison Hannon","address_street_name":"Verbindingslaan","address_street_number":"1","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1060","address_city":"Sint-Gillis","address_line1":"Verbindingslaan, 1","address_line2":"1060 Sint-Gillis","description_web":"Het Maison Hannon werd in 1902 gebouwd op de hoek van de Brugmannlaan en de Verbindingslaan in Sint-Gillis door de architect Jules Brunfaut op verzoek van het echtpaar Marie en \u00c9douard Hannon. Het huis, opgevat als een droomachtig, symbolistische omsloten wereld, is een van de meesterwerken van de Brusselse art nouveau, een vereniging van Belgische en Franse kunst uit die tijd.\r\n\r\nJules Brunfaut, onbekend met de nouveau-stijl, liet zich inspireren door de huizen van andere architecten uit die tijd, zoals die van Victor Horta (persoonlijk huis, hotels Tassel en Wessinger), Ernest Bl\u00e9rot (persoonlijk huis, nu vernietigd) en Octave Van Rysselbeghe en Henry Van de Velde (hotel Otlet). \r\nHet Maison Hannon combineert de Beaux-Arts stijl met die van de moderniteit, de toenmalige art nouveau, en is een uniek werk, een intiem en persoonlijk huis dat de smaak en de passies van zijn opdrachtgevers samenbrengt. \r\n\r\nHet Maison Hannon zal op 1 juni 2023 de deuren voor het publiek openen als huis-museum.","description_print":null,"booking_url":"https:\/\/shop.utick.net\/?pos=AGENDABRUSSELS&module=ACTIVITYSERIEDETAILS&s=089B0E9A-DB73-AE2D-92E9-879659B7E80B&lg=nl","sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":7146,"location":{"lat":50.820883,"lon":4.3522286},"last_updated_at":"2023-09-21T14:32:39+02:00","published_at":"2013-10-19T01:21:40+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/638b743f30587408db38529841646e827c64f728.jpg","width":7878,"height":7877,"ratio":1,"oEmbed_height":7877,"oEmbed_width":7878,"translations":{"de":{"title":"Art(s) Nouveau(x) Belge(s). Van de Velde, Serrurier-Bovy, Hankar &amp; Co","copyright":null},"pt":{"title":"Art(s) Nouveau(x) Belge(s). Van de Velde, Serrurier-Bovy, Hankar &amp; Co","copyright":null},"en":{"title":"Art(s) Nouveau(x) Belge(s). Van de Velde, Serrurier-Bovy, Hankar &amp; Co","copyright":null},"it":{"title":"Art(s) Nouveau(x) Belge(s). Van de Velde, Serrurier-Bovy, Hankar &amp; Co","copyright":null},"cn":{"title":"Art(s) Nouveau(x) Belge(s). Van de Velde, Serrurier-Bovy, Hankar &amp; Co","copyright":null},"fr":{"title":"Art(s) Nouveau(x) Belge(s). Van de Velde, Serrurier-Bovy, Hankar &amp; Co","copyright":null},"sp":{"title":"Art(s) Nouveau(x) Belge(s). Van de Velde, Serrurier-Bovy, Hankar &amp; Co","copyright":null},"nl":{"title":"Art(s) Nouveau(x) Belge(s). Van de Velde, Serrurier-Bovy, Hankar &amp; Co","copyright":null}}}],"dates":[{"day":"2023-06-01","doors":null,"start":"13:00:00","end":"20:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2023-06-02","doors":null,"start":"11:00:00","end":"18:00:00","end_night_li