\/agenda\/event-detail.5700007843"},"cn":{"name":"A La table des van Buuren","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/hallessaintgery.be\/","email":"accueil@hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700007843"},"fr":{"name":"A La table des van Buuren","shortdescr":"Quand l'Art D\u00e9co se met au service de l'\u00e9l\u00e9gance. Une plong\u00e9e dans les arts de la table dans les ann\u00e9es 1930 chez les van Buuren. ","longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/hallessaintgery.be\/","email":"accueil@hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700007843"},"sp":{"name":"A La table des van Buuren","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/hallessaintgery.be\/","email":"accueil@hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700007843"},"nl":{"name":"Aan de van Buuren tafel","shortdescr":"Wanneer art deco elegantie ontmoet. Een duik in  tafelgerel in de jaren 1930.","longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/hallessaintgery.be\/","email":"accueil@hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700007843"}},"place":{"id":247371,"translations":{"de":{"name":"Halles Saint-G\u00e9ry","address_street_name":"Place Saint-G\u00e9ry","address_street_number":null,"address_street_box":null,"email":"accueil@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Saint-G\u00e9ry","address_line2":"1000 Bruxelles","description_web":"Die Halles Saint-G\u00e9ry mit ihrer eklektischen Architektur wurden Ende des 19. Jahrhundert als Markthalle erbaut und spielten in der Br\u00fcsseler Stadtgeschichte eine wichtige Rolle.\r\n\r\nDie Saint-G\u00e9ry-Hallen waren einerseits sowohl legend\u00e4re als auch kaufm\u00e4nnische Wiege der Stadt. Ab dem 11. Jahrhundert stand an dieser Stelle eine dem Heiligen Saint-G\u00e9ry gewidmete Kapelle. Verschiedene Wohnh\u00e4user waren hier entstanden und aufgrund der N\u00e4he zur Senne entwickelten sich zahlreiche Aktivit\u00e4ten.\r\n\r\nIm 16. Jahrhundert erhielt die Kapelle den Status einer Pfarrkirche, die prachtvoll im gotischen Stil erweitert wurde, dann aber im Zuge der Franz\u00f6sische Revolution dem Erdboden gleichgemacht wurde.\r\n\r\nDer ehemalige Markt - und sogar das gesamte Saint-G\u00e9ry-Viertel \u2013 waren ihrerseits in den 1960er-Jahren von der Zerst\u00f6rung bedroht, bis das Viertel in den 1990er-Jahren eine Art zweiten Fr\u00fchling erlebte. Seit 1999 fungieren die Saint-G\u00e9ry-Hallen als Informations- und Ausstellungszentrum rund um die Br\u00fcsseler Stadtgeschichte und das st\u00e4dtische Leben in Br\u00fcssel. An der Bar gibt es Getr\u00e4nke und Speisen.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Halles Saint-G\u00e9ry","address_street_name":"Place Saint-G\u00e9ry","address_street_number":null,"address_street_box":null,"email":"accueil@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Saint-G\u00e9ry","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Halles Saint-G\u00e9ry","address_street_name":"Place Saint-G\u00e9ry","address_street_number":null,"address_street_box":null,"email":"accueil@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Place Saint-G\u00e9ry","address_line2":"1000 Brussels","description_web":"The Saint-G\u00e9ry Market Halls are a fine architectural example of 19th-century public markets in Brussels. The building was completely restored several years ago and is now a permanent information and exhibition space, with urban planning, heritage, and urban renewal as its central themes.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Halle di Saint-Gery","address_street_name":"Place Saint-G\u00e9ry","address_street_number":null,"address_street_box":null,"email":"accueil@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Saint-G\u00e9ry","address_line2":"1000 Bruxelles","description_web":"Le Halles Saint-G\u00e9ry (mercato coperto) ospitano un centro d'informazione dedicato al patrimonio e al quadro di vita dei Bruxellesi...\r\nLe Halles Saint-G\u00e9ry (mercato coperto) ospitano un centro d'informazione dedicato al patrimonio e al quadro di vita dei Bruxellesi. Sotto il patrocinio della regione di Bruxelles Capitale.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Halles Saint-G\u00e9ry","address_street_name":"Place Saint-G\u00e9ry","address_street_number":null,"address_street_box":null,"email":"accueil@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Saint-G\u00e9ry","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Halles Saint-G\u00e9ry","address_street_name":"Place Saint-G\u00e9ry","address_street_number":null,"address_street_box":null,"email":"accueil@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Saint-G\u00e9ry","address_line2":"1000 Bruxelles","description_web":"Remarquable t\u00e9moin de l\u2019architecture des march\u00e9s couverts, les Halles Saint-G\u00e9ry  contribuent \u00e0 valoriser le patrimoine de la R\u00e9gion de Bruxelles-Capitale. Centre d\u2019exposition et de manifestation bas\u00e9 en plein coeur du pentagone, elles ont pour vocation de mettre en valeur les traits de d\u00e9marcation du cadre de vie bruxellois et de son identit\u00e9 urbaine par le biais d'une programmation hybride, allant des expositions, aux conf\u00e9rences, concerts, rencontres et performances \u2026\r\nLe Centre Urbain (guichet d\u2019information r\u00e9gional, pour mieux vous conseiller sur l\u2019habitat durable en R\u00e9gion de Bruxelles-Capitale) est \u00e9galement situ\u00e9 au sein des Halles.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Halles Saint-G\u00e9ry","address_street_name":"Place Saint-G\u00e9ry","address_street_number":null,"address_street_box":null,"email":"accueil@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Saint-G\u00e9ry","address_line2":"1000 Bruxelles","description_web":"Verdadero testigo de los mercados cubiertos, las Halles Saint-G\u00e9ry albergan un centro de informaci\u00f3n, bajo la \u00e9gida de la Regio\u00f3n de Bruselas Capital y dedicado al patrimonio...\r\nVerdadero testigo de los mercados cubiertos, las Halles Saint-G\u00e9ry albergan un centro de informaci\u00f3n, bajo la \u00e9gida de la Regio\u00f3n de Bruselas Capital y dedicado al patrimonio y al marco de vida de los bruselenses.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Sint-Gorikshallen","address_street_name":"Sint-Goriksplein","address_street_number":null,"address_street_box":null,"email":"accueil@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Sint-Goriksplein","address_line2":"1000 Brussel","description_web":"De Sint-Gorikshallen zijn een prachtig architecturaal staaltje van openbare markthallen in het 19de-eeuwse Brussel. Het gebouw werd een aantal jaren geleden volledig gerestaureerd en doet tegenwoordig dienst als permanente informatie-, tentoonstellings- en evenementenruimte gewijd aan het erfgoed en de levenswijzen in de hoofdstad. Op amper twee minuten stappen van de Beurs vormen de Sint-Gorikshallen een gezellige plek om te ontspannen en nieuwe dingen te ontdekken, zowel overdag als bij het vallen van de nacht.\r\nDe hallen herbergen ook de Stadswinkel, een vereniging die de inwoners van het Brussels Hoofdstedelijk Gewest  wil informeren over het leefmilieu en een kwaliteitsvolle leefomgeving, huisvesting, stadsrenovatie, stedenbouw en ruimtelijke ordening, en rationeel energiegebruik. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[3],"translations":{"de":["Dansaert\/Sainte-Catherine"],"pt":[null],"en":["Dansaert\/Sainte-Catherine"],"it":["Dansaert\/Sainte-Catherine"],"cn":[null],"fr":["Dansaert\/Sainte-Catherine"],"sp":["Dansaert\/Sainte-Catherine"],"nl":["Dansaertwijk\/Sint-Katelijne"]}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":null,"facebook_id":null,"backoffice_id":9562,"location":{"lat":50.84801328,"lon":4.34683241},"region":"brussels","last_updated_at":"2024-05-08T15:56:31+02:00","published_at":"2013-10-19T01:26:22+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":247371,"translations":{"de":{"name":"Halles Saint-G\u00e9ry","address_street_name":"Place Saint-G\u00e9ry","address_street_number":null,"address_street_box":null,"email":"accueil@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Saint-G\u00e9ry","address_line2":"1000 Bruxelles","description_web":"Die Halles Saint-G\u00e9ry mit ihrer eklektischen Architektur wurden Ende des 19. Jahrhundert als Markthalle erbaut und spielten in der Br\u00fcsseler Stadtgeschichte eine wichtige Rolle.\r\n\r\nDie Saint-G\u00e9ry-Hallen waren einerseits sowohl legend\u00e4re als auch kaufm\u00e4nnische Wiege der Stadt. Ab dem 11. Jahrhundert stand an dieser Stelle eine dem Heiligen Saint-G\u00e9ry gewidmete Kapelle. Verschiedene Wohnh\u00e4user waren hier entstanden und aufgrund der N\u00e4he zur Senne entwickelten sich zahlreiche Aktivit\u00e4ten.\r\n\r\nIm 16. Jahrhundert erhielt die Kapelle den Status einer Pfarrkirche, die prachtvoll im gotischen Stil erweitert wurde, dann aber im Zuge der Franz\u00f6sische Revolution dem Erdboden gleichgemacht wurde.\r\n\r\nDer ehemalige Markt - und sogar das gesamte Saint-G\u00e9ry-Viertel \u2013 waren ihrerseits in den 1960er-Jahren von der Zerst\u00f6rung bedroht, bis das Viertel in den 1990er-Jahren eine Art zweiten Fr\u00fchling erlebte. Seit 1999 fungieren die Saint-G\u00e9ry-Hallen als Informations- und Ausstellungszentrum rund um die Br\u00fcsseler Stadtgeschichte und das st\u00e4dtische Leben in Br\u00fcssel. An der Bar gibt es Getr\u00e4nke und Speisen.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Halles Saint-G\u00e9ry","address_street_name":"Place Saint-G\u00e9ry","address_street_number":null,"address_street_box":null,"email":"accueil@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Saint-G\u00e9ry","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Halles Saint-G\u00e9ry","address_street_name":"Place Saint-G\u00e9ry","address_street_number":null,"address_street_box":null,"email":"accueil@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Place Saint-G\u00e9ry","address_line2":"1000 Brussels","description_web":"The Saint-G\u00e9ry Market Halls are a fine architectural example of 19th-century public markets in Brussels. The building was completely restored several years ago and is now a permanent information and exhibition space, with urban planning, heritage, and urban renewal as its central themes.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Halle di Saint-Gery","address_street_name":"Place Saint-G\u00e9ry","address_street_number":null,"address_street_box":null,"email":"accueil@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Saint-G\u00e9ry","address_line2":"1000 Bruxelles","description_web":"Le Halles Saint-G\u00e9ry (mercato coperto) ospitano un centro d'informazione dedicato al patrimonio e al quadro di vita dei Bruxe