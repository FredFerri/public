\/\/agendabrussels.imgix.net\/explore-57e499b8d20c3e0bff3bcab7cbf2d12157ef5771.jpg","width":906,"height":509,"ratio":1.78,"translations":{"fr":{"title":"L'ancien cin\u00e9ma le Movy Club","copyright":null},"nl":{"title":"L'ancien cin\u00e9ma le Movy Club","copyright":null},"en":{"title":"L'ancien cin\u00e9ma le Movy Club","copyright":null}}}],"dates":[{"day":"2022-11-20","doors":null,"start":"11:00:00","end":"12:30:00","is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":12}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-11T04:05:26+02:00","published_at":"2022-10-11T03:30:27+02:00","backoffice_id":263704,"import_origin":"explore","sub_type":"other","show_in_agenda":true,"ranking":1},{"id":537458,"date_start":"2022-10-20","date_end":"2022-11-20","date_next":"2022-11-20","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater"}},"others":{"list":[51],"translations":{"fr":["Caf\u00e9 th\u00e9\u00e2tre"],"nl":["Cabaret"],"en":["Cabaret"],"de":["Kabarett"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Jardini\u00e8res #1 | Bwanga Pili Pili, Loup Rivi\u00e8re","shortdescr":null,"longdescr":"Jardini\u00e8res* est une proposition de travail de m\u00e9moire, de cr\u00e9ation de m\u00e9moires. De l\u2019archive vive, depuis et pour les femmes*. D\u2019une g\u00e9n\u00e9ration \u00e0 une autre.\r\n\r\nAu centre de chacune de ces soir\u00e9es : une discussion publique entre deux femmes*, entre deux g\u00e9n\u00e9rations, entre des pratiques et des m\u00e9moires.\r\nLa plus jeune invitant et interviewant la plus \u00e2g\u00e9e, travaillant \u00e0 ce que s\u2019entende un parcours, un pass\u00e9 et un futur, une \u0153uvre.\r\nLe temps d\u2019une discussion, une vie non arr\u00eat\u00e9e encore, se d\u00e9pose et offre ses r\u00e9cits, ses points de vue, ses mati\u00e8res \u00e0 r\u00e9flexions et \u00e0 \u00e9motions.\r\nCe moment d\u2019\u00e9changes en toute simplicit\u00e9 est suivi d\u2019un spectacle d\u2019une autre femme* artiste qui viendra se poser comme une texture suppl\u00e9mentaire et s\u2019inscrire, \u00e0 son tour et en continuit\u00e9 dans ces histoires de femmes*. Des histoires de jardini\u00e8res* en devenir.\r\n\r\nLes jardini\u00e8res* interview\u00e9es seront invit\u00e9es et d\u00e9voil\u00e9es au cours de la saison. Restez connect\u00e9es* !\r\n\r\n* s\u2019identifiant en tant que femme\/jardini\u00e8re.\r\n\r\nAvec le soutien de la Cocof-Service \u00e9galit\u00e9 des chances","performers":null,"boxoffice_url":null,"website":"http:\/\/www.balsamine.be","email":"reservation@balsamine.be","phone_contact":null,"phone_booking":"+32 2 735 64 68","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.537458"},"nl":{"name":"Jardini\u00e8res #1 | Bwanga Pili Pili, Loup Rivi\u00e8re","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.537458"},"en":{"name":"Jardini\u00e8res #1 | Bwanga Pili Pili, Loup Rivi\u00e8re","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.537458"},"de":{"name":"Jardini\u00e8res #1 | Bwanga Pili Pili, Loup Rivi\u00e8re","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.537458"},"it":{"name":"Jardini\u00e8res #1 | Bwanga Pili Pili, Loup Rivi\u00e8re","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.537458"},"sp":{"name":"Jardini\u00e8res #1 | Bwanga Pili Pili, Loup Rivi\u00e8re","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.537458"},"pt":{"name":"Jardini\u00e8res #1 | Bwanga Pili Pili, Loup Rivi\u00e8re","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.537458"},"cn":{"name":"Jardini\u00e8res #1 | Bwanga Pili Pili, Loup Rivi\u00e8re","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.537458"}},"place":{"id":942,"translations":{"fr":{"name":"Th\u00e9\u00e2tre la Balsamine","address_street_name":"Avenue F\u00e9lix Marchal","address_street_number":"1","address_street_box":null,"email":"info@balsamine.be","website":"http:\/\/www.balsamine.be","phone_contact":"+32 2 732 96 18","phone_booking":"+32 2 735 64 68","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Avenue F\u00e9lix Marchal, 1","address_line2":"1030 Schaerbeek","description_web":"Th\u00e9\u00e2tre la Balsamine d\u00e9fend la n\u00e9cessit\u00e9 de l\u2019Art pour l\u2019Art mais veux le rendre accessible au plus grand nombre. C'est une maison de cr\u00e9ation qui abrite et accompagne des artistes confront\u00e9s quotidiennement \u00e0 la n\u00e9cessit\u00e9 de s\u2019interroger sur le sens, sur le cadre dans lequel ils exercent leur pratique, sur le style qu\u2019ils \u00e9laborent et sur les valeurs qu\u2019ils repr\u00e9sentent. La cr\u00e9ation contemporaine est une forme mouvante et en perp\u00e9tuel questionnement, qui renvoie le spectateur \u00e0 sa capacit\u00e9 \u00e0 cr\u00e9er du sens et \u00e0 vivre son rapport au monde. Elle nous interpelle sur notre propre cr\u00e9ativit\u00e9 et sur notre capacit\u00e9 \u00e0 exprimer qui nous sommes. Elle interroge les normes, y compris celles du go\u00fbt.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Th\u00e9\u00e2tre la Balsamine","address_street_name":"F\u00e9lix Marchallaan","address_street_number":"1","address_street_box":null,"email":"info@balsamine.be","website":"http:\/\/www.balsamine.be","phone_contact":"+32 2 732 96 18","phone_booking":"+32 2 735 64 68","address_zip":"1030","address_city":"Schaarbeek","address_line1":"F\u00e9lix Marchallaan, 1","address_line2":"1030 Schaarbeek","description_web":"La Balsamine verdedigt de noodzaak van kunst voor de kunst, maar wil dat voor een zo groot mogelijk publiek toegankelijk maken. Dit is een huis van creatie dat kunstenaars ontvangt en ondersteunt die dagelijks geconfronteerd worden met de noodzaak om de betekenis van en de context waarin zij hun kunst beoefenen, de stijl die ze ontwikkelen en de waarden die ze vertegenwoordigen in twijfel te trekken. Hedendaagse kunstcreatie is een steeds veranderende vorm en een eeuwige invraagstelling, die het vermogen van de toeschouwer om betekenis te cre\u00ebren en zijn relatie tot de wereld te beleven bevraagt. Het interpelleert ons over onze eigen creativiteit en ons vermogen om te uiten wie we zijn. Onze normen worden onder de loep genomen, waaronder die van de smaak.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Theatre la Balsamine","address_street_name":"avenue F\u00e9lix Marchal","address_street_number":"1","address_street_box":null,"email":"info@balsamine.be","website":"http:\/\/www.balsamine.be","phone_contact":"+32 2 732 96 18","phone_booking":"+32 2 735 64 68","address_zip":"1030","address_city":"Schaerbeek","address_line1":"avenue F\u00e9lix Marchal, 1","address_line2":"1030 Schaerbeek","description_web":"La Balsamine defends the need for Art for Art but wants to make it accessible to as many people as possible. It is a creative house that hosts and accompanies artists who are daily confronted with the need to question the meaning, the context in which they practice their art, the style they develop and the values they represent. Contemporary creation is a moving and perpetually questionable form that confronts the audience to its ability to create meaning and live his relationship with the world. It challenges us on our own creativity and our ability to express who we are. It questions norms, including those of taste.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Th\u00e9\u00e2tre la Balsamine","address_street_name":"Avenue F\u00e9lix Marchal","address_street_number":"1","address_street_box":null,"email":"info@balsamine.be","website":"http:\/\/www.balsamine.be","phone_contact":"+32 2 732 96 18","phone_booking":"+32 2 735 64 68","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Avenue F\u00e9lix Marchal, 1","address_line2":"1030 Schaerbeek","description_web":"Das Th\u00e9\u00e2tre la Balsamine verteidigt die Kunst um der Kunst willen und m\u00f6chte das Theater und die damit verwandten Disziplinen einem breiteren Publikum zug\u00e4nglich machen. \r\nEs handelt sich um ein Haus der Kreationen, das K\u00fcnstlern eine Heimat und B\u00fchne bietet, die t\u00e4glich das Bed\u00fcrfnis versp\u00fcren, den Sinn und den Rahmen, in dem sie ihre Disziplin aus\u00fcben, ihren Stil immer wieder vor dem Hintergrund der von ihnen vertretenen Werte zu hinterfragen.\r\nDie zeitgen\u00f6ssische Kreation ist eine dynamische Form, die sich immer wieder hinterfragt, die den Zuschauer dazu anh\u00e4lt, den Dingen einen Sinn zu geben und die Beziehungen mit der Welt zu leben. \r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Th\u00e9\u00e2tre la Balsamine","address_street_name":"Avenue F\u00e9lix Marchal","address_street_number":"1","address_street_box":null,"email":"info@balsamine.be","website":"http:\/\/www.balsamine.be","phone_contact":"+32 2 732 96 18","phone_booking":"+32 2 735 64 68","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Avenue F\u00e9lix Marchal, 1","address_line2":"1030 Schaerbeek","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Th\u00e9\u00e2tre la Balsamine","address_street_name":"Avenue F\u00e9lix Marchal","address_street_number":"1","address_street_box":null,"email":"info@balsamine.be","website":"http:\/\/www.balsamine.be","phone_contact":"+32 2 732 96 18","phone_booking":"+32 2 735 64 68","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Avenue F\u00e9lix Marchal, 1","address_line2":"1030 Schaerbeek","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Th\u00e9\u00e2tre la Balsamine","address_street_name":"Avenue F\u00e9lix Marchal","address_street_number":"1","address_street_box":null,"email":"info@balsamine.be","website":"http:\/\/www.balsamine.be","phone_contact":"+32 2 732 96 18","phone_booking":"+32 2 735 64 68","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Avenue F\u00e9lix Marchal, 1","address_line2":"1030 Schaerbeek","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Th\u00e9\u0