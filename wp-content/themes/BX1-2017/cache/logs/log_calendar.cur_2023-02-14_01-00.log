u00f3venes de 15 a 18 a\u00f1os","Escuelas"],"pt":[null,null,null,null,null,null],"cn":[null,null,null,null,null,null]}},"tags":["kids"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-02-13T02:07:41+01:00","published_at":"2021-06-16T12:32:30+02:00","backoffice_id":233441,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.10233859542617},{"id":509491,"date_start":"2021-03-05","date_end":"2025-12-31","date_next":"2023-02-17","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen","it":"Visite guidate","sp":"Visitas guiadas","pt":null,"cn":null}},"others":{"list":[112],"translations":{"fr":["Insolite"],"nl":["Ongewoon"],"en":["Unusual"],"de":["Ausgefallenes"],"it":["Insolito"],"sp":["Ins\u00f3lito"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Bruxelles Sc\u00e8ne de Crimes","shortdescr":"Accrochez-vous \u00e0 vos tripes. Nous vous faisons revivre quelques-unes des plus horribles affaires criminelles qui ont frapp\u00e9 Bruxelles entre le 19\u00e8me et le 20\u00e8me si\u00e8cle.","longdescr":"Au fil d\u2019une balade dans les sombres ruelles du centre historique, la visite \u201cBruxelles, Sc\u00e8ne de Crimes\u201d vous relates quelques affaires criminelles qui ont marqu\u00e9 la capitale aux 19\u00e8me et 20\u00e8me si\u00e8cles\u2026\r\n\r\nReplongez, comme si vous y \u00e9tiez, dans l\u2019Histoire de la ville et apprenez-en plus sur les bruxellois, sur la police, mais surtout sur la soci\u00e9t\u00e9 et les m\u0153urs des diff\u00e9rentes \u00e9poques travers\u00e9es.\r\n\r\nEngagez-vous dans une promenade frissonnante, effrayante, lugubre, parfois sanguinolente, quelques fois tr\u00e8s violente, mais toujours respectueuse des diff\u00e9rents protagonistes et scrupuleusement fid\u00e8le aux faits. \r\n\r\n\r\nQU\u2019ALLEZ-VOUS D\u00c9COUVRIR ?\r\n\r\nLe tour \u201cSc\u00e8ne de Crimes\u201d vous d\u00e9voile la face la plus sombre de l\u2019histoire de Bruxelles et vous plonge dans les m\u00e9andres les plus obscures de l\u2019\u00e2me humaine\u2026 Mais la visite vous en apprendra \u00e9galement beaucoup sur la soci\u00e9t\u00e9 bruxelloise aux diff\u00e9rentes \u00e9poques que nous traverserons.\r\n\r\nCrimes d\u2019honneur, vengeances, crimes passionnels ou crapuleux, les quelques r\u00e9cits rapport\u00e9s vous feront frissonner \u00e0 coup s\u00fbr.\r\n\r\nAu programme de la balade, entre autres\u2026\r\n\r\n\u2013 Double meurtre pour 50kg de porc, 1850\r\n\u2013 La l\u00e9gende du Coin du Diable, XVII\u00e8me si\u00e8cle\r\n\u2013 Le crime de la place Saint-Gery, 1847\r\n\u2013 L\u2019affaire Jeanne Van Calk, 1906\r\n\u2013 L\u2019\u201cincident de Bruxelles\u201d, 1873\r\n\u2013 \u2026Mais aussi de nombreuses petites histoires et anecdotes !\r\n\r\n\r\nINFORMATIONS PRATIQUES\r\nTours r\u00e9guliers en fran\u00e7ais (et bient\u00f4t en n\u00e9erlandais)\r\nPrix  : 17,00 \u20ac \/ 14,00 \u20ac tarif r\u00e9duit (\u00e9tudiant, ch\u00f4meur,..)\r\nDur\u00e9e : Environ 2 heures\r\nRendez-vous : Devant l\u2019entr\u00e9e de l\u2019H\u00f4tel Amigo\r\nRue de l\u2019Amigo, 1000 Bruxelles\r\nFin du tour : Place Saint G\u00e9ry\r\n\r\nTour priv\u00e9 sur demande en fran\u00e7ais ou en anglais : info@brusselsbyfoot.com","performers":"Une visite guid\u00e9e originale de l'association de guides ind\u00e9pendants Brussels By Foot","boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/bruxelles-scene-de-crimes\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.509491"},"nl":{"name":"Bruxelles Sc\u00e8ne de Crimes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/bruxelles-scene-de-crimes\/","email":"info@brusselsbyfoot.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.509491"},"en":{"name":"Bruxelles Sc\u00e8ne de Crimes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/bruxelles-scene-de-crimes\/","email":"info@brusselsbyfoot.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.509491"},"de":{"name":"Bruxelles Sc\u00e8ne de Crimes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/bruxelles-scene-de-crimes\/","email":"info@brusselsbyfoot.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.509491"},"it":{"name":"Bruxelles Sc\u00e8ne de Crimes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/bruxelles-scene-de-crimes\/","email":"info@brusselsbyfoot.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.509491"},"sp":{"name":"Bruxelles Sc\u00e8ne de Crimes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/bruxelles-scene-de-crimes\/","email":"info@brusselsbyfoot.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.509491"},"pt":{"name":"Bruxelles Sc\u00e8ne de Crimes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/bruxelles-scene-de-crimes\/","