t":false,"last_updated_at":"2023-10-22T02:06:26+02:00","published_at":"2022-11-16T16:28:36+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":265724,"facebook_link":null,"import_origin":null,"is_part_of":"Ann\u00e9e Art Nouveau","sub_type":"tour","ranking":0.14643004228082399,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{}},"translations":{"de":{"name":"Foundation Frison Horta \"A Living museum\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.foundation-frison-horta.be","email":"contact@foundation-frison-horta.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.545724"},"pt":{"name":"Foundation Frison Horta \"A Living museum\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.foundation-frison-horta.be","email":"contact@foundation-frison-horta.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.545724"},"en":{"name":"Foundation Frison Horta \"A Living museum\"","shortdescr":"Maison muse L'art Nouveau Victor Horta ","longdescr":"Foundation Frison Horta is an Active Cultural Bridge Between East & West Restoring, Preserving and Sustaining Rich Art & Craft of the By-Gone Era, in an Artistic Art-de-Vivre form. \u201cExcellence in Craftsmanship and M\u00e9tiers d\u2019Art\u201d. The Foundation Aims to Foster Greater Understanding and Appreciation of the Rich Heritage & Cultural Traditions of the East particularly of Indian Sub-continent In Europe and vice versa.\r\nFoundation Frison Horta is working Extensively in Restoring the image of Brussels with Art Nouveau as its National Identity to a Global Audience.\r\nMaison Frison is the Only one of a kind house of Victor Horta that was Constructed for Double Function Maurice Frison ( Lawyer of the Court of Belgium) office and living space. Foundation frison Has Continued the double function of Horta with Foundation museum activities and the living space making it a One of a kind in the world \u201cA Living Museum\u201d an Exceptional Unique Time capsule of 19th Century Total Art, Art Nouveau Gem of Victor Horta!\r\n\r\nEntry Fee: 35 Euros (Minimum 2 person)","performers":null,"boxoffice_url":null,"website":"http:\/\/www.foundation-frison-horta.be","email":"contact@foundation-frison-horta.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.545724"},"it":{"name":"Foundation Frison Horta \"A Living museum\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.foundation-frison-horta.be","email":"contact@foundation-frison-horta.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.545724"},"cn":{"name":"Foundation Frison Horta \"A Living museum\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.foundation-frison-horta.be","email":"contact@foundation-frison-horta.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.545724"},"fr":{"name":"Foundation Frison Horta \"A Living museum\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.foundation-frison-horta.be","email":"contact@foundation-frison-horta.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.545724"},"sp":{"name":"Foundation Frison Horta \"A Living museum\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.foundation-frison-horta.be","email":"contact@foundation-frison-horta.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.545724"},"nl":{"name":"Foundation Frison Horta \"A Living museum\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.foundation-frison-horta.be","email":"contact@foundation-frison-horta.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.545724"}},"place":{"id":271767,"translations":{"de":{"name":"Fondation Frison Horta ","address_street_name":"Lebeaustraat","address_street_number":"37","address_street_box":null,"email":"contact@foundation-frison-horta.be","website":"http:\/\/www.foundation-frison-horta.be","phone_contact":"+32 2 330 47 96","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Lebeaustraat, 37","address_line2":"1000 Bruxelles","description_web":"RESTAURIERUNG. BEWAHRUNG. TEILHABE. \r\nDie Stiftung Foundation Frison Horta ist Kultureinrichtung und Kunstzentrum in einem, sie ist ein lebendiges Museum und eine kulturelle Plattform, die die Geschichte des Br\u00fcsseler Kulturguts einem internationalen Publikum n\u00e4herbringt\u2026 und sie ist ein historischer Meilenstein, der die Arbeit von Horta mit Originalmobiliar, dekorativer Kunst, Wandgem\u00e4lden und Fresken in Szene setzt. Sie kooperiert mit anderen multidisziplin\u00e4ren Institutionen und Einrichtungen und geht einen k\u00fcnstlerischen Dialog \u00fcber die Bewahrung und Restaurierung der Geschichte und des Verm\u00e4chtnisses des Jugendstils ein und macht sie der \u00d6ffentlichkeit zug\u00e4nglich. Gleichzeitig dient sie als kultureller Br\u00fcckenschlag zwischen Ost und West und schafft als solcher ein gr\u00f6\u00dferes Verst\u00e4ndnis und ein ausgepr\u00e4gteres Bewusstsein f\u00fcr die reichen kulturellen Traditionen Indiens in Europa und umgekehrt.\r\n\r\nDie Stiftung befindet sich in der Rue Lebeau und wurde 1894 f\u00fcr Georges Frison, einen renommierten Anwalt, erbaut. Das Geb\u00e4ude wird eingefasst von anderen Anwesen im Stile der Neugotik und der Neorenaissance. Vorherrschend sind hier die Themen Natur und Licht, denn die Wandbilder und Fresken mit Motiven aus Flora und Fauna ziehen sich wie ein roter Faden durch das ganze Haus.\r\n\r\nHier offenbart sich eine faszinierende Mischung zwischen einem typischen Br\u00fcsseler Privathaus und dem unverwechselbaren und eleganten Stil von Victor Horta.\r\nDas Haus besticht mit diskreter Eleganz, fernab von jeglicher Extravaganz, und einem feinen Zusammenspiel der wei\u00dfen und blauen Steine.\r\n\r\nF\u00fchrung nur nach Vereinbarung\r\n35 Euro (F\u00fchrung+Exposition)","description_print":"RESTAURIERUNG. BEWAHRUNG. TEILHABE. \r\nDie Stiftung Foundation Frison Horta ist Kultureinrichtung und Kunstzentrum in einem, sie ist ein lebendiges Museum und eine kulturelle Plattform, die die Geschichte des Br\u00fcsseler Kulturguts einem internationalen Publikum n\u00e4herbringt\u2026 und sie ist ein historischer Meilenstein, der die Arbeit von Horta mit Originalmobiliar, dekorativer Kunst, Wandgem\u00e4lden und Fresken in Szene setzt. Sie kooperiert mit anderen multidisziplin\u00e4ren Institutionen und Einrichtungen und geht einen k\u00fcnstlerischen Dialog \u00fcber die Bewahrung und Restaurierung der Geschichte und des Verm\u00e4chtnisses des Jugendstils ein und macht sie der \u00d6ffentlichkeit zug\u00e4nglich. Gleichzeitig dient sie als kultureller Br\u00fcckenschlag zwischen Ost und West und schafft als solcher ein gr\u00f6\u00dferes Verst\u00e4ndnis und ein ausgepr\u00e4gteres Bewusstsein f\u00fcr die reichen kulturellen Traditionen Indiens in Europa und umgekehrt.\r\n\r\nDie Stiftung befindet sich in der Rue Lebeau und wurde 1894 f\u00fcr Georges Frison, einen renommierten Anwalt, erbaut. Das Geb\u00e4ude wird eingefasst von anderen Anwesen im Stile der Neugotik und der Neorenaissance. Vorherrschend sind hier die Themen Natur und Licht, denn die Wandbilder und Fresken mit Motiven aus Flora und Fauna ziehen sich wie ein roter Faden durch das ganze Haus.\r\n\r\nHier offenbart sich eine faszinierende Mischung zwischen einem typischen Br\u00fcsseler Privathaus und dem unverwechselbaren und eleganten Stil von Victor Horta.\r\nDas Haus besticht mit diskreter Eleganz, fernab von jeglicher Extravaganz, und einem feinen Zusammenspiel der wei\u00dfen und blauen Steine.","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Fondation Frison Horta ","address_street_name":"Rue Lebeau","address_street_number":"37","address_street_box":null,"email":"contact@foundation-frison-horta.be","website":"http:\/\/www.foundation-frison-horta.be","phone_contact":"+32 2 330 47 96","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Lebeau, 37","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Foundation Frison Horta ","address_street_name":"Rue Lebeau","address_street_number":"37","address_street_box":null,"email":"contact@foundation-frison-horta.be","website":"http:\/\/www.foundation-frison-horta.be","phone_contact":"+32 2 330 47 96","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Lebeau, 37","address_line2":"1000 Bruxelles","description_web":"RESTORATION. PRESERVATION. SHARING. \r\nFoundation Frison Horta is a cultural institution and centre for art. It\u2019s a living museum and an organic cultural platform that conveys the story of Brussels\u2019 heritage to a global audience. It is a historical landmark which showcases the work of Horta with original furniture, Art Deco, murals and frescoes. It engages with multidisciplinary institutions and bodies in an artistic dialogue on preserving, restoring and sharing the history and heritage of Art Nouveau while acting as a cultural bridge between east and west that fosters greater understanding and appreciation of the rich cultural traditions of India in Europe and vice versa.\r\n\r\nThe foundation sits in the middle of Rue Lebeau and was built in 1894 for Georges Frison, a renowned lawyer. It sits among Neo-Renaissance and Neo-Gothic mansions, looking like a Neo- Renaissance turret. It is a house of nature and light with murals and frescoes of flora and fauna that engulf the whole house.\r\n\r\nIt shows a fascinating play between the conventional Brussels private house and the bold and elegant style of Victor Horta. \r\nThe house stands out in a discreet way, far from extravagant. Everything is subtle, with the play of blue and white stones.\r\n\r\nGuided visit by appointment only\r\nEntry Fee: 35 Euros (Visit+Exposition)","description_print":"RESTORATION. PRESERVATION. SHARING. \r\nFoundation Frison Horta is a cultural institution and centre for art. It\u2019s a living museum and an organic cultural platform that conveys the story of Brussels\u2019 heritage to a global audience. It is a historical landmark which showcases the work of Horta with original furniture, Art Deco, murals and frescoes. It engages with multidisciplinary institutions and bodies in an artistic dialogue on preserving, restoring and sharing the history and heritage of Art Nouveau while acting as a cultural bridge between east and west that fosters greater understanding and appreciation of the rich cultural traditions of India in Europe and vice versa.\r\n\r\nThe foundation sits in the middle of Rue Lebeau and was built in 1894 for Georges Frison, a renowned lawyer. It sits among Neo-Renaissance and Neo-Gothic mansions, looking like a Neo- Renaissance turret. It is a house of nature and light with murals and frescoes of flora and fauna that engulf the whole house.\r\n\r\nIt shows a fascinating play between the conventional Brussels private house and the bold and elegant style of Victor Horta. \r\nThe house stands out in a discreet way, far from extravagant. Everything is subtle, with the play of blue and white stones.","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Fondation Frison Horta ","address_street_name":"Rue Lebeau","address_street_number":"37","address_street_box":null,"email":"contact@foundation-frison-horta.be","website":"http:\/\/www.foundation-frison-horta.be","phone_contact":"+32 2 330 47 96","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Lebeau, 37","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Fondation Frison Horta ","address_street_name":"Rue Lebeau","address_street_number":"37","address_street_box":null,"email":"contact@foundation-frison-horta.be","website":"http:\/\/www.foundation-frison-horta.be","phone_contact":"+32 2 330 47 96","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Lebeau, 37","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"fr":{"name":"Fondation Frison Horta  ","address_street_name":"Rue Lebeau","address_street_number":"37","address_street_box":null,"email":"contact@foundation-frison-horta.be","website":"http:\/\/www.foundation-frison-horta.be","phone_contact":"+32 2 330 47 96","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Lebeau, 37","address_line2":"1000 Bruxelles","description_web":"RESTAURATION. CONSERVATION. PARTAGE. \r\nFondation Frison Horta est une institution culturelle et un centre d'art. C'est un mus\u00e9e vivant et une plateforme culturelle organique qui conte l'histoire du patrimoine bruxellois \u00e0 un public mondial. C'est un point de rep\u00e8re historique qui pr\u00e9sente le travail de Horta avec des meubles originaux, art d\u00e9coratif, des peintures murales et des fresques. Il s\u2019engage aupr\u00e8s d\u2019institutions et d\u2019organismes pluridisciplinaires dans un dialogue artistique sur la conservation, la restauration et le partage de l\u2019histoire et du patrimoine de l\u2019Art nouveau tout en servant de pont culturel entre l\u2019Est et l\u2019Ouest, ce qui favorise une meilleure compr\u00e9hension et appr\u00e9ciation des riches traditions culturelles de l'Inde en Europe et vice versa.\r\n\r\nLa fondation se trouve au milieu de la rue Lebeau et a \u00e9t\u00e9 construite en 1894 pour Georges Frison, un avocat renomm\u00e9. Elle se dresse parmi les manoirs n\u00e9o-renaissance et n\u00e9o-gothique, ressemblant \u00e0 une tourelle n\u00e9o-renaissance. C'est une maison de la nature et de la lumi\u00e8re avec des peintures murales et des fresques de la flore et de la faune qui engloutissent toute la maison.\r\n\r\nCela illustre une pi\u00e8ce fascinante entre la maison priv\u00e9e bruxelloise classique et le style audacieux et \u00e9l\u00e9gant de Victor Horta. \r\nLa maison se distingue de mani\u00e8re discr\u00e8te, loin d'\u00eatre extravagante. Tout est subtil, avec le jeu des pierres bleues et blanches.\r\n\r\nVisite guid\u00e9e uniquement sur rendez-vous\r\nEntr\u00e9e: 35 Eur (visite + exposition)\r\n","description_print":"RESTAURATION. CONSERVATION. PARTAGE. \r\nFondation Frison Horta est une institution culturelle et un centre d'art. C'est un mus\u00e9e vivant et une plateforme culturelle organique qui conte l'histoire du patrimoine bruxellois \u00e0 un public mondial. C'est un point de rep\u00e8re historique qui pr\u00e9sente le travail de Horta avec des meubles originaux, art d\u00e9coratif, des peintures murales et des fresques. Il s\u2019engage aupr\u00e8s d\u2019institutions et d\u2019organismes pluridisciplinaires dans un dialogue artistique sur la conservation, la restauration et le partage de l\u2019histoire et du patrimoine de l\u2019Art nouveau tout en servant de pont culturel entre l\u2019Est et l\u2019Ouest, ce qui favorise une meilleure compr\u00e9hension et appr\u00e9ciation des riches traditions culturelles de l'Inde en Europe et vice versa.\r\n\r\nLa fondation se trouve au milieu de la rue Lebeau et a \u00e9t\u00e9 construite en 1894 pour Georges Frison, un avocat renomm\u00e9. Elle se dresse parmi les manoirs n\u00e9o-renaissance et n\u00e9o-gothique, ressemblant \u00e0 une tourelle n\u00e9o-renaissance. C'est une maison de la nature et de la lumi\u00e8re avec des peintures murales et des fresques de la flore et de la faune qui engloutissent toute la maison.\r\n\r\nCela illustre une pi\u00e8ce fascinante entre la maison priv\u00e9e bruxelloise classique et le style audacieux et \u00e9l\u00e9gant de Victor Horta. \r\nLa maison se distingue de mani\u00e8re discr\u00e8te, loin d'\u00eatre extravagante. Tout est subtil, avec le jeu des pierres bleues et blanches.","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Fondation Frison Horta ","address_street_name":"Rue Lebeau","address_street_number":"37","address_street_box":null,"email":"contact@foundation-frison-horta.be","website":"http:\/\/www.foundation-frison-horta.be","phone_contact":"+32 2 330 47 96","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Lebeau, 37","address_line2":"1000 Bruxelles","description_web":"RESTAURACI\u00d3N. PRESERVACI\u00d3N. COMPARTICI\u00d3N.\r\nLa Fundaci\u00f3n Frison Horta es una instituci\u00f3n cultural y un centro de arte. Es un museo vivo y una plataforma cultural org\u00e1nica que transmite la historia del patrimonio cultural de Bruselas a una audiencia internacional. Es un hito hist\u00f3rico que exhibe el trabajo de Horta con mobiliario original, Art Deco, murales y frescos. Tambi\u00e9n colabora con instituciones y organismos multidisciplinarios, entablando un di\u00e1logo art\u00edstico sobre la preservaci\u00f3n, restauraci\u00f3n y compartici\u00f3n de la historia y el patrimonio del Art Nouveau mientras act\u00faa como puente cultural entre este y oeste, promoviendo as\u00ed la comprensi\u00f3n y la apreciaci\u00f3n de la riqueza de las tradiciones culturales de la India en Europa y viceversa.\r\n \r\nLa fundaci\u00f3n est\u00e1 situada en Rue Lebeau y fue construida en 1984 para Georges Frison, un renombrado abogado. Se sit\u00faa entre las mansiones neorrenacentistas y neog\u00f3ticas, parecida a una torre neorrenacentista. Es una casa natural y luminosa con murales y frescos de flora y fauna que envuelven toda la casa.\r\nSe nos muestra una obra fascinante que oscila entre una casa tradicional bruselense y el atrevido y elegante estilo de Victor Horta.\r\nLa casa destaca de manera discreta, lejos de lo extravagante. Todo es sutil, con un juego de piedras azules y blancas.\r\n\r\nVisita guiada s\u00f3lo con cita previa\r\nEntrada: 35 Eur (Visita+Exposici\u00f3n)","description_print":"RESTAURACI\u00d3N. PRESERVACI\u00d3N. COMPARTICI\u00d3N.\r\nLa Fundaci\u00f3n Frison Horta es una instituci\u00f3n cultural y un centro de arte. Es un museo vivo y una plataforma cultural org\u00e1nica que transmite la historia del patrimonio cultural de Bruselas a una audiencia internacional. Es un hito hist\u00f3rico que exhibe el trabajo de Horta con mobiliario original, Art Deco, murales y frescos. Tambi\u00e9n colabora con instituciones y organismos multidisciplinarios, entablando un di\u00e1logo art\u00edstico sobre la preservaci\u00f3n, restauraci\u00f3n y compartici\u00f3n de la historia y el patrimonio del Art Nouveau mientras act\u00faa como puente cultural entre este y oeste, promoviendo as\u00ed la comprensi\u00f3n y la apreciaci\u00f3n de la riqueza de las tradiciones culturales de la India en Europa y viceversa.\r\n \r\nLa fundaci\u00f3n est\u00e1 situada en Rue Lebeau y fue construida en 1984 para Georges Frison, un renombrado abogado. Se sit\u00faa entre las mansiones neorrenacentistas y neog\u00f3ticas, parecida a una torre neorrenacentista. Es una casa natural y luminosa con murales y frescos de flora y fauna que envuelven toda la casa.\r\nSe nos muestra una obra fascinante que oscila entre una casa tradicional bruselense y el atrevido y elegante estilo de Victor Horta.\r\nLa casa destaca de manera discreta, lejos de lo extravagante. Todo es sutil, con un juego de piedras azules y blancas.","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Fondation Frison Horta ","address_street_name":"Lebeaustraat","address_street_number":"37","address_street_box":null,"email":"contact@foundation-frison-horta.be","website":"http:\/\/www.foundation-frison-horta.be","phone_contact":"+32 2 330 47 96","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Lebeaustraat, 37","address_line2":"1000 Bruxelles","description_web":"RESTAUREREN. BEHOUDEN. DELEN.\r\nStichting Frison Horta is een culturele instelling en kunstcentrum. Het is een \u2018levend\u2019 museum en een \u2018organisch\u2019 cultureel platform dat het verhaal van het Brusselse erfgoed overbrengt naar een wereldwijd publiek. Dit historische monument toont het werk van Horta met origineel meubilair, decoratieve kunst en fresco's. Het wil banden smeden met multidisciplinaire instellingen en een artistieke dialoog aangaan over het behouden, restaureren en delen van de geschiedenis en het erfgoed van de Art Nouveau. Het fungeert eveneens als een cultuurbrug tussen Oost en West en hoopt zo in Europa meer begrip en waardering te oogsten voor de rijke culturele tradities van India, en vice versa.\r\nDe stichting bevindt zich in een pand in de Lebeaustraat en werd in 1894 gebouwd voor Georges Frison, een gerenommeerd advocaat. Het gebouw bevindt zich tussen huizen in neorenaissancestijl en neogotische herenhuizen en ziet eruit als een neorenaissancetorentje. Het is een huis vol licht, met een natuurlijk karakter. De muurschilderingen van flora en fauna die overal in het huis te vinden zijn, maker er iets bijzonders van. \r\nDit Hortahuis houdt het midden tussen een klassiek Brussels priv\u00e9huis en een gebouw opgetrokken in de gedurfde en elegante stijl van Victor Horta.\r\nHet huis valt wel op, maar eerder op een discrete manier. Het is verre van extravagant. Met een spel van blauwe en witte stenen, krijgt het geheel een subtiele touch.\r\n\r\nGeleid bezoek enkel op afspraak\r\nToegang: 35 Eur (bezoek + tentoonstelling)","description_print":"RESTAUREREN. BEHOUDEN. DELEN.\r\nStichting Frison Horta is een culturele instelling en kunstcentrum. Het is een \u2018levend\u2019 museum en een \u2018organisch\u2019 cultureel platform dat het verhaal van het Brusselse erfgoed overbrengt naar een wereldwijd publiek. Dit historische monument toont het werk van Horta met origineel meubilair, decoratieve kunst en fresco's. Het wil banden smeden met multidisciplinaire instellingen en een artistieke dialoog aangaan over het behouden, restaureren en delen van de geschiedenis en het erfgoed van de Art Nouveau. Het fungeert eveneens als een cultuurbrug tussen Oost en West en hoopt zo in Europa meer begrip en waardering te oogsten voor de rijke culturele tradities van India, en vice versa.\r\nDe stichting bevindt zich in een pand in de Lebeaustraat en werd in 1894 gebouwd voor Georges Frison, een gerenommeerd advocaat. Het gebouw bevindt zich tussen huizen in neorenaissancestijl en neogotische herenhuizen en ziet eruit als een neorenaissancetorentje. Het is een huis vol licht, met een natuurlijk karakter. De muurschilderingen van flora en fauna die overal in het huis te vinden zijn, maker er iets bijzonders van. \r\nDit Hortahuis houdt het midden tussen een klassiek Brussels priv\u00e9huis en een gebouw opgetrokken in de gedurfde en elegante stijl van Victor Horta.\r\nHet huis valt wel op, maar eerder op een discrete manier. Het is verre van extravagant. Met een spel van blauwe en witte stenen, krijgt het geheel een subtiele touch.","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":null,"facebook_id":null,"backoffice_id":31767,"location":{"lat":50.84254568,"lon":4.35402095},"region":"brussels","last_updated_at":"2023-01-23T14:09:11+01:00","published_at":"2018-08-21T10:28:33+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":271767,"translations":{"de":{"name":"Fondation Frison Horta ","address_street_name":"Lebeaustraat","address_street_number":"37","address_street_box":null,"email":"contact@foundation-frison-horta.be","website":"http:\/\/www.foundation-frison-horta.be","phone_contact":"+32 2 330 47 96","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Lebeaustraat, 37","address_line2":"1000 Bruxelles","description_web":"RESTAURIERUNG. BEWAHRUNG. TEILHABE. \r\nDie Stiftung Foundation Frison Horta ist Kultureinrichtung und Kunstzentrum in einem, sie ist ein lebendiges Museum und eine kulturelle Plattform, die die Geschichte des Br\u00fcsseler Kulturguts einem internationalen Publikum n\u00e4herbringt\u2026 und sie ist ein historischer Meilenstein, der die Arbeit von Horta mit Originalmobiliar, dekorativer Kunst, Wandgem\u00e4lden und Fresken in Szene setzt. Sie kooperiert mit anderen multidisziplin\u00e4ren Institutionen und Einrichtungen und geht einen k\u00fcnstlerischen Dialog \u00fcber die Bewahrung und Restaurierung der Geschichte und des Verm\u00e4chtnisses des Jugendstils ein und macht sie der \u00d6ffentlichkeit zug\u00e4nglich. Gleichzeitig dient sie als kultureller Br\u00fcckenschlag zwischen Ost und West und schafft als solcher ein gr\u00f6\u00dferes Verst\u00e4ndnis und ein ausgepr\u00e4gteres Bewusstsein f\u00fcr die reichen kulturellen Traditionen Indiens in Europa und umgekehrt.\r\n\r\nDie Stiftung befindet sich in der Rue Lebeau und wurde 1894 f\u00fcr Georges Frison, einen renommierten Anwalt, erbaut. Das Geb\u00e4ude wird eingefasst von anderen Anwesen im Stile der Neugotik und der Neorenaissance. Vorherrschend sind hier die Themen Natur und Licht, denn die Wandbilder und Fresken mit Motiven aus Flora und Fauna ziehen sich wie ein roter Faden durch das ganze Haus.\r\n\r\nHier offenbart sich eine faszinierende Mischung zwischen einem typischen Br\u00fcsseler Privathaus und dem unverwechselbaren und eleganten Stil von Victor Horta.\r\nDas Haus besticht mit diskreter Eleganz, fernab von jeglicher Extravaganz, und einem feinen Zusammenspiel der wei\u00dfen und blauen Steine.\r\n\r\nF\u00fchrung nur nach Vereinbarung\r\n35 Euro (F\u00fchrung+Exposition)","description_print":"RESTAURIERUNG. BEWAHRUNG. TEILHABE. \r\nDie Stiftung Foundation Frison Horta ist Kultureinrichtung und Kunstzentrum in einem, sie ist ein lebendiges Museum und eine kulturelle Plattform, die die Geschichte des Br\u00fcsseler Kulturguts einem internationalen Publikum n\u00e4herbringt\u2026 und sie ist ein historischer Meilenstein, der die Arbeit von Horta mit Originalmobiliar, dekorativer Kunst, Wandgem\u00e4lden und Fresken in Szene setzt. Sie kooperiert mit anderen multidisziplin\u00e4ren Institutionen und Einrichtungen und geht einen k\u00fcnstlerischen Dialog \u00fcber die Bewahrung und Restaurierung der Geschichte und des Verm\u00e4chtnisses des Jugendstils ein und macht sie der \u00d6ffentlichkeit zug\u00e4nglich. Gleichzeitig dient sie als kultureller Br\u00fcckenschlag zwischen Ost und West und schafft als solcher ein gr\u00f6\u00dferes Verst\u00e4ndnis und ein ausgepr\u00e4gteres Bewusstsein f\u00fcr die reichen kulturellen Traditionen Indiens in Europa und umgekehrt.\r\n\r\nDie Stiftung befindet sich in der Rue Lebeau und wurde 1894 f\u00fcr Georges Frison, einen renommierten Anwalt, erbaut. Das Geb\u00e4ude wird eingefasst von anderen Anwesen im Stile der Neugotik und der Neorenaissance. Vorherrschend sind hier die Themen Natur und Licht, denn die Wandbilder und Fresken mit Motiven aus Flora und Fauna ziehen sich wie ein roter Faden durch das ganze Haus.\r\n\r\nHier offenbart sich eine faszinierende Mischung zwischen einem typischen Br\u00fcsseler Privathaus und dem unverwechselbaren und eleganten Stil von Victor Horta.\r\nDas Haus besticht mit diskreter Eleganz, fernab von jeglicher Extravaganz, und einem feinen Zusammenspiel der wei\u00dfen und blauen Steine.","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Fondation Frison Horta ","address_street_name":"Rue Lebeau","address_street_number":"37","address_street_box":null,"email":"contact@foundation-frison-horta.be","website":"http:\/\/www.foundation-frison-horta.be","phone_contact":"+32 2 330 47 96","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Lebeau, 37","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Foundation Frison Horta ","address_street_name":"Rue Lebeau","address_street_number":"37","address_street_box":null,"email":"contact@foundation-frison-horta.be","website":"http:\/\/www.foundation-frison-horta.be","phone_contact":"+32 2 330 47 96","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Lebeau, 37","address_line2":"1000 Bruxelles","description_web":"RESTORATION. PRESERVATION. SHARING. \r\nFoundation Frison Horta is a cultural institution and centre for art. It\u2019s a living museum and an organic cultural platform that conveys the story of Brussels\u2019 heritage to a global audience. It is a historical landmark which showcases the work of Horta with original furniture, Art Deco, murals and frescoes. It engages with multidisciplinary institutions and bodies in an artistic dialogue on preserving, restoring and sharing the history and heritage of Art Nouveau while acting as a cultural bridge between east and west that fosters greater understanding and appreciation of the rich cultural traditions of India in Europe and vice versa.\r\n\r\nThe foundation sits in the middle of Rue Lebeau and was built in 1894 for Georges Frison, a renowned lawyer. It sits among Neo-Renaissance and Neo-Gothic mansions, looking like a Neo- Renaissance turret. It is a house of nature and light with murals and frescoes of flora and fauna that engulf the whole house.\r\n\r\nIt shows a fascinating play between the conventional Brussels private house and the bold and elegant style of Victor Horta. \r\nThe house stands out in a discreet way, far from extravagant. Everything is subtle, with the play of blue and white stones.\r\n\r\nGuided visit by appointment only\r\nEntry Fee: 35 Euros (Visit+Exposition)","description_print":"RESTORATION. PRESERVATION. SHARING. \r\nFoundation Frison Horta is a cultural institution and centre for art. It\u2019s a living museum and an organic cultural platform that conveys the story of Brussels\u2019 heritage to a global audience. It is a historical landmark which showcases the work of Horta with original furniture, Art Deco, murals and frescoes. It engages with multidisciplinary institutions and bodies in an artistic dialogue on preserving, restoring and sharing the history and heritage of Art Nouveau while acting as a cultural bridge between east and west that fosters greater understanding and appreciation of the rich cultural traditions of India in Europe and vice versa.\r\n\r\nThe foundation sits in the middle of Rue Lebeau and was built in 1894 for Georges Frison, a renowned lawyer. It sits among Neo-Renaissance and Neo-Gothic mansions, looking like a Neo- Renaissance turret. It is a house of nature and light with murals and frescoes of flora and fauna that engulf the whole house.\r\n\r\nIt shows a fascinating play between the conventional Brussels private house and the bold and elegant style of Victor Horta. \r\nThe house stands out in a discreet way, far from extravagant. Everything is subtle, with the play of blue and white stones.","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Fondation Frison Horta ","address_street_name":"Rue Lebeau","address_street_number":"37","address_street_box":null,"email":"contact@foundation-frison-horta.be","website":"http:\/\/www.foundation-frison-horta.be","phone_contact":"+32 2 330 47 96","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Lebeau, 37","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Fondation Frison Horta ","address_street_name":"Rue Lebeau","address_street_number":"37","address_street_box":null,"email":"contact@foundation-frison-horta.be","website":"http:\/\/www.foundation-frison-horta.be","phone_contact":"+32 2 330 47 96","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Lebeau, 37","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"fr":{"name":"Fondation Frison Horta  ","address_street_name":"Rue Lebeau","address_street_number":"37","address_street_box":null,"email":"contact@foundation-frison-horta.be","website":"http:\/\/www.foundation-frison-horta.be","phone_contact":"+32 2 330 47 96","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Lebeau, 37","address_line2":"1000 Bruxelles","description_web":"RESTAURATION. CONSERVATION. PARTAGE. \r\nFondation Frison Horta est une institution culturelle et un centre d'art. C'est un mus\u00e9e vivant et une plateforme culturelle organique qui conte l'histoire du patrimoine bruxellois \u00e0 un public mondial. C'est un point de rep\u00e8re historique qui pr\u00e9sente le travail de Horta avec des meubles originaux, art d\u00e9coratif, des peintures murales et des fresques. Il s\u2019engage aupr\u00e8s d\u2019institutions et d\u2019organismes pluridisciplinaires dans un dialogue artistique sur la conservation, la restauration et le partage de l\u2019histoire et du patrimoine de l\u2019Art nouveau tout en servant de pont culturel entre l\u2019Est et l\u2019Ouest, ce qui favorise une meilleure compr\u00e9hension et appr\u00e9ciation des riches traditions culturelles de l'Inde en Europe et vice versa.\r\n\r\nLa fondation se trouve au milieu de la rue Lebeau et a \u00e9t\u00e9 construite en 1894 pour Georges Frison, un avocat renomm\u00e9. Elle se dresse parmi les manoirs n\u00e9o-renaissance et n\u00e9o-gothique, ressemblant \u00e0 une tourelle n\u00e9o-renaissance. C'est une maison de la nature et de la lumi\u00e8re avec des peintures murales et des fresques de la flore et de la faune qui engloutissent toute la maison.\r\n\r\nCela illustre une pi\u00e8ce fascinante entre la maison priv\u00e9e bruxelloise classique et le style audacieux et \u00e9l\u00e9gant de Victor Horta. \r\nLa maison se distingue de mani\u00e8re discr\u00e8te, loin d'\u00eatre extravagante. Tout est subtil, avec le jeu des pierres bleues et blanches.\r\n\r\nVisite guid\u00e9e uniquement sur rendez-vous\r\nEntr\u00e9e: 35 Eur (visite + exposition)\r\n","description_print":"RESTAURATION. CONSERVATION. PARTAGE. \r\nFondation Frison Horta est une institution culturelle et un centre d'art. C'est un mus\u00e9e vivant et une plateforme culturelle organique qui conte l'histoire du patrimoine bruxellois \u00e0 un public mondial. C'est un point de rep\u00e8re historique qui pr\u00e9sente le travail de Horta avec des meubles originaux, art d\u00e9coratif, des peintures murales et des fresques. Il s\u2019engage aupr\u00e8s d\u2019institutions et d\u2019organismes pluridisciplinaires dans un dialogue artistique sur la conservation, la restauration et le partage de l\u2019histoire et du patrimoine de l\u2019Art nouveau tout en servant de pont culturel entre l\u2019Est et l\u2019Ouest, ce qui favorise une meilleure compr\u00e9hension et appr\u00e9ciation des riches traditions culturelles de l'Inde en Europe et vice versa.\r\n\r\nLa fondation se trouve au milieu de la rue Lebeau et a \u00e9t\u00e9 construite en 1894 pour Georges Frison, un avocat renomm\u00e9. Elle se dresse parmi les manoirs n\u00e9o-renaissance et n\u00e9o-gothique, ressemblant \u00e0 une tourelle n\u00e9o-renaissance. C'est une maison de la nature et de la lumi\u00e8re avec des peintures murales et des fresques de la flore et de la faune qui engloutissent toute la maison.\r\n\r\nCela illustre une pi\u00e8ce fascinante entre la maison priv\u00e9e bruxelloise classique et le style audacieux et \u00e9l\u00e9gant de Victor Horta. \r\nLa maison se distingue de mani\u00e8re discr\u00e8te, loin d'\u00eatre extravagante. Tout est subtil, avec le jeu des pierres bleues et blanches.","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Fondation Frison Horta ","address_street_name":"Rue Lebeau","address_street_number":"37","address_street_box":null,"email":"contact@foundation-frison-horta.be","website":"http:\/\/www.foundation-frison-horta.be","phone_contact":"+32 2 330 47 96","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Lebeau, 37","address_line2":"1000 Bruxelles","description_web":"RESTAURACI\u00d3N. PRESERVACI\u00d3N. COMPARTICI\u00d3N.\r\nLa Fundaci\u00f3n Frison Horta es una instituci\u00f3n cultural y un centro de arte. Es un museo vivo y una plataforma cultural org\u00e1nica que transmite la historia del patrimonio cultural de Bruselas a una audiencia internacional. Es un hito hist\u00f3rico que exhibe el trabajo de Horta con mobiliario original, Art Deco, murales y frescos. Tambi\u00e9n colabora con instituciones y organismos multidisciplinarios, entablando un di\u00e1logo art\u00edstico sobre la preservaci\u00f3n, restauraci\u00f3n y compartici\u00f3n de la historia y el patrimonio del Art Nouveau mientras act\u00faa como puente cultural entre este y oeste, promoviendo as\u00ed la comprensi\u00f3n y la apreciaci\u00f3n de la riqueza de las tradiciones culturales de la India en Europa y viceversa.\r\n \r\nLa fundaci\u00f3n est\u00e1 situada en Rue Lebeau y fue construida en 1984 para Georges Frison, un renombrado abogado. Se sit\u00faa entre las mansiones neorrenacentistas y neog\u00f3ticas, parecida a una torre neorrenacentista. Es una casa natural y luminosa con murales y frescos de flora y fauna que envuelven toda la casa.\r\nSe nos muestra una obra fascinante que oscila entre una casa tradicional bruselense y el atrevido y elegante estilo de Victor Horta.\r\nLa casa destaca de manera discreta, lejos de lo extravagante. Todo es sutil, con un juego de piedras azules y blancas.\r\n\r\nVisita guiada s\u00f3lo con cita previa\r\nEntrada: 35 Eur (Visita+Exposici\u00f3n)","description_print":"RESTAURACI\u00d3N. PRESERVACI\u00d3N. COMPARTICI\u00d3N.\r\nLa Fundaci\u00f3n Frison Horta es una instituci\u00f3n cultural y un centro de arte. Es un museo vivo y una plataforma cultural org\u00e1nica que transmite la historia del patrimonio cultural de Bruselas a una audiencia internacional. Es un hito hist\u00f3rico que exhibe el trabajo de Horta con mobiliario original, Art Deco, murales y frescos. Tambi\u00e9n colabora con instituciones y organismos multidisciplinarios, entablando un di\u00e1logo art\u00edstico sobre la preservaci\u00f3n, restauraci\u00f3n y compartici\u00f3n de la historia y el patrimonio del Art Nouveau mientras act\u00faa como puente cultural entre este y oeste, promoviendo as\u00ed la comprensi\u00f3n y la apreciaci\u00f3n de la riqueza de las tradiciones culturales de la India en Europa y viceversa.\r\n \r\nLa fundaci\u00f3n est\u00e1 situada en Rue Lebeau y fue construida en 1984 para Georges Frison, un renombrado abogado. Se sit\u00faa entre las mansiones neorrenacentistas y neog\u00f3ticas, parecida a una torre neorrenacentista. Es una casa natural y luminosa con murales y frescos de flora y fauna que envuelven toda la casa.\r\nSe nos muestra una obra fascinante que oscila entre una casa tradicional bruselense y el atrevido y elegante estilo de Victor Horta.\r\nLa casa destaca de manera discreta, lejos de lo extravagante. Todo es sutil, con un juego de piedras azules y blancas.","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Fondation Frison Horta ","address_street_name":"Lebeaustraat","address_street_number":"37","address_street_box":null,"email":"contact@foundation-frison-horta.be","website":"http:\/\/www.foundation-frison-horta.be","phone_contact":"+32 2 330 47 96","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Lebeaustraat, 37","address_line2":"1000 Bruxelles","description_web":"RESTAUREREN. BEHOUDEN. DELEN.\r\nStichting Frison Horta is een culturele instelling en kunstcentrum. Het is een \u2018levend\u2019 museum en een \u2018organisch\u2019 cultureel platform dat het verhaal van het Brusselse erfgoed overbrengt naar een wereldwijd publiek. Dit historische monument toont het werk van Horta met origineel meubilair, decoratieve kunst en fresco's. Het wil banden smeden met multidisciplinaire instellingen en een artistieke dialoog aangaan over het behouden, restaureren en delen van de geschiedenis en het erfgoed van de Art Nouveau. Het fungeert eveneens als een cultuurbrug tussen Oost en West en hoopt zo in Europa meer begrip en waardering te oogsten voor de rijke culturele tradities van India, en vice versa.\r\nDe stichting bevindt zich in een pand in de Lebeaustraat en werd in 1894 gebouwd voor Georges Frison, een gerenommeerd advocaat. Het gebouw bevindt zich tussen huizen in neorenaissancestijl en neogotische herenhuizen en ziet eruit als een neorenaissancetorentje. Het is een huis vol licht, met een natuurlijk karakter. De muurschilderingen van flora en fauna die overal in het huis te vinden zijn, maker er iets bijzonders van. \r\nDit Hortahuis houdt het midden tussen een klassiek Brussels priv\u00e9huis en een gebouw opgetrokken in de gedurfde en elegante stijl van Victor Horta.\r\nHet huis valt wel op, maar eerder op een discrete manier. Het is verre van extravagant. Met een spel van blauwe en witte stenen, krijgt het geheel een subtiele touch.\r\n\r\nGeleid bezoek enkel op afspraak\r\nToegang: 35 Eur (bezoek + tentoonstelling)","description_print":"RESTAUREREN. BEHOUDEN. DELEN.\r\nStichting Frison Horta is een culturele instelling en kunstcentrum. Het is een \u2018levend\u2019 museum en een \u2018organisch\u2019 cultureel platform dat het verhaal van het Brusselse erfgoed overbrengt naar een wereldwijd publiek. Dit historische monument toont het werk van Horta met origineel meubilair, decoratieve kunst en fresco's. Het wil banden smeden met multidisciplinaire instellingen en een artistieke dialoog aangaan over het behouden, restaureren en delen van de geschiedenis en het erfgoed van de Art Nouveau. Het fungeert eveneens als een cultuurbrug tussen Oost en West en hoopt zo in Europa meer begrip en waardering te oogsten voor de rijke culturele tradities van India, en vice versa.\r\nDe stichting bevindt zich in een pand in de Lebeaustraat en werd in 1894 gebouwd voor Georges Frison, een gerenommeerd advocaat. Het gebouw bevindt zich tussen huizen in neorenaissancestijl en neogotische herenhuizen en ziet eruit als een neorenaissancetorentje. Het is een huis vol licht, met een natuurlijk karakter. De muurschilderingen van flora en fauna die overal in het huis te vinden zijn, maker er iets bijzonders van. \r\nDit Hortahuis houdt het midden tussen een klassiek Brussels priv\u00e9huis en een gebouw opgetrokken in de gedurfde en elegante stijl van Victor Horta.\r\nHet huis valt wel op, maar eerder op een discrete manier. Het is verre van extravagant. Met een spel van blauwe en witte stenen, krijgt het geheel een subtiele touch.","booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":31767,"location":{"lat":50.84254568,"lon":4.35402095},"last_updated_at":"2023-01-23T14:09:11+01:00","published_at":"2018-08-21T10:28:33+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/0dc791cef74108e1b901d0a9fca02ee0d0a2b7a8.jpg","width":2042,"height":3542,"ratio":0.58,"oEmbed_height":3542,"oEmbed_width":2042,"translations":{"de":{"title":"Foundation Frison Horta \"A Living museum\"","copyright":null},"pt":{"title":"Foundation Frison Horta \"A Living museum\"","copyright":null},"en":{"title":"Foundation Frison Horta \"A Living museum\"","copyright":null},"it":{"title":"Foundation Frison Horta \"A Living museum\"","copyright":null},"cn":{"title":"Foundation Frison Horta \"A Living museum\"","copyright":null},"fr":{"title":"Foundation Frison Horta \"A Living museum\"","copyright":null},"sp":{"title":"Foundation Frison Horta \"A Living museum\"","copyright":null},"nl":{"title":"Foundation Frison Horta \"A Living museum\"","copyright":null}}}],"dates":[],"prices":[{"translations":{"de":{"name":"Normal"},"en":{"name":"Normal"},"it":{"name":"Normale"},"fr":{"name":"Normal"},"sp":{"name":"Normal"},"nl":{"name":"Normaal"}},"value":35}],"date_exceptions":[],"closing_days":[],"child_events":[],"parent_events":[],"accessibilities":[],"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":["annee_art_nouveau"]},{"id":551359,"date_start":"2023-02-01","date_end":"2023-12-31","date_next":"2023-10-23","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2023-10-23T02:03:37+02:00","published_at":"2023-02-09T12:16:27+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":271359,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.14412893506025848,"languages":{"spoken":["en","fr"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[30,24],"translations":{"de":["Malerei","Kunstgalerien"],"pt":[null,null],"en":["Painting","Art Galleries"],"it":["Pittura","Gallerie d'arte"],"cn":[null,null],"fr":["Peinture","Galeries d'art"],"sp":["Pintura","Galer\u00edas de arte"],"nl":["Schilderkunst","Galeries"]}}},"translations":{"de":{"name":"Exposition \"Retrospective\" de Blaise Patrix","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/visitin.brussels\/happening\/blaise-patrix-retrospective-exhibition\/","email":"info.brusselsgrandplace@hilton.com","phone_contact":"+32 2 548 42 11","phone_booking":"+32 2 548 42 11","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.551359"},"pt":{"name":"Exposition \"Retrospective\" de Blaise Patrix","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/visitin.brussels\/happening\/blaise-patrix-retrospective-exhibition\/","email":"info.brusselsgrandplace@hilton.com","phone_contact":"+32 2 548 42 11","phone_booking":"+32 2 548 42 11","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.551359"},"en":{"name":"Exhibition \"Retrospective\" by Blaise Patrix","shortdescr":"The second chapter of a collaborative project between the hotel and artists based in the capital, the exhibition of some thirty works by Blaise Patrix aims to give a resolutely multicultural dimension to the different spaces of the Hilton while inviting Belgian and foreign guests, as well as locals, to initiate a discussion around this hybrid and heterogeneous artistic work.","longdescr":"From the Symbiosis series, which mixes countryside landscapes and marine scenes in a poetic approach, to the portraits in the Reconnaissance series, not forgetting the landscapes in the Relations series and Paroles d'Oc\u00e9an, all the works of this artist, who trained in classical painting, celebrate life and \"living together\". QR codes placed next to each painting will allow visitors to discover, via Blaise Patrix's website, the artist's world and the history of the paintings that adorn the hotel's walls. \r\n\r\n\"I am interested in cultivating and enhancing public and collective recognition; recognition that encourages sensitivity, emotion, intuition and creativity. As the philosopher \u00c9douard Glissant rightly said: 'to be is to change by exchanging with the other while remaining oneself.\r\nBlaise Patrix \r\n\r\nIn the course of his career, Blaise Patrix has created monumental frescoes with a participatory approach to creation. This collaboration with the Hilton Brussels Grand Place has enabled him to extend this approach by meeting the hotel's staff and initiating a rich and inspiring dialogue with them. In particular, the artist created a portrait of Vincent Masson, the Sentro's chef. The restaurant menu will feature a portrait of the chef, the result of this face-to-face meeting, as well as a presentation of the works on display. The dishes created by the chef are freely inspired by this encounter. For Ellen Deboeck, this large-scale exhibition project, which was initiated just before the pandemic, is an obvious choice. In the wake of a first exhibition of works by V\u00e9ronique Van der Wielen, it is this artist - with whom she shares a passion for travel - that the director of the Hilton Brussels Grand Place has chosen to invite throughout the year: \r\n\r\n\"Our aim is not to use art as a marketing tool, but to convey an authentic message. Each department is directly involved in the exhibition: the kitchen through our chef, but also the Front Office and our seminar staff. Since we have been organising exhibitions in the hotel, we have noticed a real interest in this project, especially in the photos posted on social networks and the questions that guests ask our teams\" - Ellen Deboeck","performers":null,"boxoffice_url":null,"website":"https:\/\/visitin.brussels\/happening\/blaise-patrix-retrospective-exhibition\/","email":"info.brusselsgrandplace@hilton.com","phone_contact":"+32 2 548 42 11","phone_booking":"+32 2 548 42 11","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.551359"},"it":{"name":"Exposition \"Retrospective\" de Blaise Patrix","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/visitin.brussels\/happening\/blaise-patrix-retrospective-exhibition\/","email":"info.brusselsgrandplace@hilton.com","phone_contact":"+32 2 548 42 11","phone_booking":"+32 2 548 42 11","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.551359"},"cn":{"name":"Exposition \"Retrospective\" de Blaise Patrix","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/visitin.brussels\/happening\/blaise-patrix-retrospective-exhibition\/","email":"info.brusselsgrandplace@hilton.com","phone_contact":"+32 2 548 42 11","phone_booking":"+32 2 548 42 11","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.551359"},"fr":{"name":"Exposition \"Retrospective\" de Blaise Patrix","shortdescr":"Deuxi\u00e8me chapitre d\u2019un projet de collaboration entre l\u2019h\u00f4tel et des artistes install\u00e9s dans la capitale, l\u2019exposition d\u2019une trentaine d\u2019\u0153uvres de Blaise Patrix entend donner une dimension r\u00e9solument multiculturelle aux diff\u00e9rents espaces du Hilton tout en invitant les clients belges et \u00e9trangers, ainsi que les locaux, \u00e0 amorcer une discussion autour de ce travail artistique hybride et h\u00e9t\u00e9roclite.","longdescr":"De la s\u00e9rie Symbiose qui m\u00e9lange paysages de campagne et sc\u00e8nes marines dans une approche po\u00e9tique aux portraits de la s\u00e9rie Reconnaissance en passant par les paysages de la s\u00e9rie Relations ou encore Paroles d\u2019Oc\u00e9an, toutes les \u0153uvres de cet artiste form\u00e9 \u00e0 la peinture classique c\u00e9l\u00e8brent la vie et le \u00ab vivre ensemble \u00bb. Des QR codes plac\u00e9s en regard de chaque tableau permettront aux visiteurs de d\u00e9couvrir, via la voir de Blaise Patrix, l\u2019univers de l\u2019artiste et l\u2019histoire des toiles qui habillent les murs de l\u2019h\u00f4tel. \r\n\r\n\u00ab Ce qui m\u2019int\u00e9resse, c\u2019est de cultiver et de valoriser la reconnaissance publique et collective ; une reconnaissance qui favorise la sensibilit\u00e9, l\u2019\u00e9motion, l\u2019intuition et la cr\u00e9ativit\u00e9. Comme l\u2019a dit tr\u00e8s justement le philosoph\u00e9 \u00c9douard Glissant : \u2018\u00eatre, c\u2019est changer en \u00e9changeant avec l\u2019autre tout en restant soi-m\u00eame.\u00bb\r\nBlaise Patrix \r\n\r\nSi, au cours de sa carri\u00e8re, Blaise Patrix a r\u00e9alis\u00e9 des fresques monumentales dans une approche participative de la cr\u00e9ation, cette collaboration avec le Hilton Brussels Grand Place lui a permis de prolonger cette d\u00e9marche en rencontrant les collaborateurs de l\u2019h\u00f4tel et en amor\u00e7ant avec eux un dialogue nourri et inspirant. L\u2019artiste a notamment r\u00e9alis\u00e9 le portrait de Vincent Masson, le chef du Sentro. Sur la carte du restaurant, on retrouvera un portrait du cuisinier, fruit de ce face-\u00e0-face, ainsi qu\u2019une pr\u00e9sentation des \u0153uvres expos\u00e9es. Quant aux plats cr\u00e9\u00e9s par le chef, ils sont librement inspir\u00e9s de cette rencontre. Pour Ellen Deboeck, ce projet d\u2019exposition \u00e0 grande \u00e9chelle initi\u00e9 juste avant la pand\u00e9mie, sonne comme une \u00e9vidence. Dans le sillage d\u2019un premier accrochage des \u0153uvres de V\u00e9ronique Van der Wielen, c\u2019est donc cet artiste - avec lequel elle partage une passion pour le voyage - que la directrice du Hilton Brussels Grand Place a choisi d\u2019inviter pendant toute cette ann\u00e9e : \r\n\r\n\u00ab Notre volont\u00e9 n\u2019est pas d\u2019utiliser l\u2019art comme outil marketing, mais bien de v\u00e9hiculer un message authentique. Chaque d\u00e9partement est directement associ\u00e9 \u00e0 l\u2019exposition : la cuisine par le biais de notre chef, mais aussi le Front Office ou encore nos collaborateurs en charge des s\u00e9minaires. Depuis que nous organisons des expositions au sein de l\u2019h\u00f4tel, nous remarquons, notamment sur les photos post\u00e9es sur les r\u00e9seaux sociaux et les questions que les clients posent \u00e0 nos \u00e9quipes, un r\u00e9el int\u00e9r\u00eat pour ce projet. \u00bb  \r\nEllen Deboeck\r\n","performers":null,"boxoffice_url":null,"website":"https:\/\/visitin.brussels\/happening\/blaise-patrix-retrospective-exhibition\/","email":"info.brusselsgrandplace@hilton.com","phone_contact":"+32 2 548 42 11","phone_booking":"+32 2 548 42 11","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.551359"},"sp":{"name":"Exposition \"Retrospective\" de Blaise Patrix","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/visitin.brussels\/happening\/blaise-patrix-retrospective-exhibition\/","email":"info.brusselsgrandplace@hilton.com","phone_contact":"+32 2 548 42 11","phone_booking":"+32 2 548 42 11","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.551359"},"nl":{"name":"Tentoonstelling \"Retrospective\" van Blaise Patrix","shortdescr":"De tentoonstelling van een dertigtal werken van Blaise Patrix wil een resoluut multiculturele dimensie geven aan de verschillende ruimtes van het Hilton en nodigt zowel Belgische en buitenlandse gasten als de plaatselijke bevolking uit om een discussie op gang te brengen rond dit hybride en heterogene artistieke werk.","longdescr":"Van de serie Symbiose, waarin landschappen en mariene sc\u00e8nes op po\u00ebtische wijze worden vermengd, tot de portretten in de serie Reconnaissance en niet te vergeten de landschappen in de serie Relations en Paroles d'Oc\u00e9an, alle werken van deze kunstenaar, die een opleiding in de klassieke schilderkunst heeft genoten, vieren het leven en het \"samenleven\". Dankzij QR-codes naast elk schilderij kunnen bezoekers via de website van Blaise Patrix de wereld van de kunstenaar en de geschiedenis van de schilderijen die de muren van het hotel sieren, ontdekken. \r\n\r\n\"Ik ben ge\u00efnteresseerd in het cultiveren en versterken van publieke en collectieve erkenning; een erkenning die gevoeligheid, emotie, intu\u00eftie en creativiteit aanmoedigt. Zoals de filosoof \u00c9douard Glissant terecht zei: 'zijn is veranderen door te ruilen met de ander terwijl je jezelf blijft.\r\nBlaise Patrix \r\n\r\nIn de loop van zijn carri\u00e8re heeft Blaise Patrix monumentale fresco's gemaakt met een participatieve benadering van de creatie. Deze samenwerking met het Hilton Brussels Grand Place heeft hem in staat gesteld deze benadering uit te breiden door het personeel van het hotel te ontmoeten en met hen een rijke en inspirerende dialoog aan te gaan. De kunstenaar heeft met name een portret gemaakt van Vincent Masson, de chef-kok van het Sentro. Op het menu van het restaurant staat een portret van de chef, het resultaat van deze persoonlijke ontmoeting, en een presentatie van de tentoongestelde werken. De gerechten van de chef zijn vrij ge\u00efnspireerd op deze ontmoeting. Voor Ellen Deboeck is dit grootschalige tentoonstellingsproject, dat net voor de pandemie werd gestart, een voor de hand liggende keuze. Na een eerste tentoonstelling van werken van V\u00e9ronique Van der Wielen, is het deze kunstenaar - met wie zij een passie voor reizen deelt - die de directrice van het Hilton Brussels Grand Place heeft gekozen om het hele jaar door uit te nodigen: \r\n\r\n\"Ons doel is niet om kunst te gebruiken als marketinginstrument, maar om een authentieke boodschap over te brengen. Elke afdeling is rechtstreeks betrokken bij de tentoonstelling: de keuken via onze chef-kok, maar ook de Front Office en ons seminariepersoneel. Sinds we tentoonstellingen in het hotel organiseren, merken we een echte belangstelling voor dit project, vooral door de foto's die op sociale netwerken worden geplaatst en de vragen die gasten aan onze teams stellen\" - Ellen Deboeck\r\n","performers":null,"boxoffice_url":null,"website":"https:\/\/visitin.brussels\/happening\/blaise-patrix-retrospective-exhibition\/","email":"info.brusselsgrandplace@hilton.com","phone_contact":"+32 2 548 42 11","phone_booking":"+32 2 548 42 11","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.551359"}},"place":{"id":262631,"translations":{"de":{"name":"Hilton Brussels Grand Place","address_street_name":"Carrefour de l'Europe","address_street_number":"3","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Carrefour de l'Europe, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Hilton Brussels Grand Place","address_street_name":"Carrefour de l'Europe","address_street_number":"3","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Carrefour de l'Europe, 3","address_line2":"1000 Bruxelles","description_web":null,"descript