Label"],"it":[null,null,null],"sp":[null,null,null],"pt":[null,null,null],"cn":[null,null,null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-12-22T01:35:54+01:00","published_at":"2022-08-16T13:58:56+02:00","backoffice_id":259788,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":0.22191822427468},{"id":544963,"date_start":"2022-10-29","date_end":"2023-08-31","date_next":"2023-01-11","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater","it":null,"sp":null,"pt":null,"cn":null}},"others":{"list":[51],"translations":{"fr":["Caf\u00e9 th\u00e9\u00e2tre"],"nl":["Cabaret"],"en":["Cabaret"],"de":["Kabarett"],"it":[null],"sp":[null],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"SOUNDTRACK - Spectacle D'improvisation des Kip Talking","shortdescr":"De la musique au service des improvisations !","longdescr":"* SOUNDTRACK *\r\n\r\nEt si on vous laissait prendre les commandes sonores de nos improvisations ? \r\n\r\n\r\nEt oui, VOUS serez mis \u00e0 contribution en nous proposant des musiques de film qui vous ont marqu\u00e9es, touch\u00e9es, envout\u00e9es, berc\u00e9es... \r\n\r\n\r\nLa suite ? \r\nOn s'en occupe en vous offrant un contenu, qui sait, peut-\u00eatre m\u00eame mieux qu'au cin\u00e9ma ! \r\n\r\n\r\nPour le savoir, il va falloir venir voir au Trac ! \r\n Ca promet d'\u00eatre \u00e9p-KIP !  \r\n\r\n\r\n\r\n\r\nSpectacle des KIP TALKING !\r\n\r\nAvec : \r\nCath lembree \r\nZoe boland \r\nAlice Conard \r\nJuan Rodrigues\r\nThomas Anne de molina \r\nFacundo de guchteneere \r\nCami Bran \r\nNicolas golenvaux \r\nNicolas Goreux\r\n\r\n\r\n\r\n-------`\r\n\r\nINFOS PRATIQUES\r\n\r\nLieu : Le TRAC\r\nAdresse : 110, rue Albert Meunier- Auderghem\r\n\r\nSpectacle \u00e0 20h15\r\nIl est possible de manger et\/ou boire un verre sur place avant le spectacle, pensez donc \u00e0 venir plus t\u00f4t! (Derni\u00e8re commande de restauration \u00e0 19h55!)\r\n\r\nR\u00c9SERVATIONS (vivement conseill\u00e9es)\r\nvia le lien du Trac : https:\/\/www.letrac.be\/reservations\r\n\r\nTARIFS\r\n- Sur r\u00e9servation : 10\u20ac\/\u00e9tudiant & 13\u20ac\/adulte\r\n- Sur place : 15\u20ac\/personne","performers":"Spectacle des KIP TALKING !\r\n\r\nAvec : \r\nCath lembree \r\nZoe boland \r\nAlice Conard \r\nJuan Rodrigues\r\nThomas Anne de molina \r\nFacundo de guchteneere \r\nCami Bran \r\nNicolas golenvaux \r\nNicolas Goreux","boxoffice_url":null,"website":"http:\/\/www.letrac.be\/reservation","email":"info@letrac.be","phone_contact":"+32 470 50 04 75","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.544963"},"nl":{"name":"SOUNDTRACK - Spectacle D'improvisation des Kip Talking","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.544963"},"en":{"name":"SOUNDTRACK - Spectacle D'improvisation des Kip Talking","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.544963"},"de":{"name":"SOUNDTRACK - Spectacle D'improvisation des Kip Talking","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.544963"},"it":{"name":"SOUNDTRACK - Spectacle D'improvisation des Kip Talking","shortdescr"