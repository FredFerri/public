llung"}},"others":{"list":[24,30],"translations":{"fr":["Galeries d'art","Peinture"],"nl":["Galeries","Schilderkunst"],"en":["Art Galleries","Painting"],"de":["Kunstgalerien","Malerei"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"RAY RICHARDSON : Tales From The Soul River","shortdescr":null,"longdescr":"Ray Richardson , c\u00e9l\u00e8bre repr\u00e9sentant de la peinture figurative britannique , dont l'oeuvre est pr\u00e9sente dans les collections permanentes du British Museum, de l'Albert & Victoria Museum et du National Portrait Gallery,  inaugure  sa nouvelle exposition  \"Tales from The  Soul River\". Il pr\u00e9sente un travail  impr\u00e9gn\u00e9 de tradition picturale m\u00eal\u00e9 de culture urbaine et populaire. Fid\u00e8le lecteur des polars de son ami James Ellroy, sa proximit\u00e9 avec l'univers cin\u00e9matographique du\" film noir\" s'illustre magistralement quand il s'agit de mettre en sc\u00e8ne  la banlieue sombre du sud-est de Londres et la vie au bord de la Tamise.","performers":"Ray Richardson","boxoffice_url":null,"website":"http:\/\/www.zedes-art-gallery.be","email":"zedes.art.gallery@gmail.com","phone_contact":"+32 2 646 00 04","phone_booking":"+32 2 646 00 04","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.542663"},"nl":{"name":"RAY RICHARDSON : Tales From The Soul River","shortdescr":null,"longdescr":"Ray Richardson (Woolwich, 1964) is een belangrijke representant van de Britse figuratieve schilderkunst. Zijn werk is een treffende afspielling van de complexiteit van zijn sociale milieu, de zuidoostelijke rand van Londen - een postindustriele wijk in verval. Ray Richardson voert die volkse stadscultuur op in taferelen ontleend aan dagelijks leven, met een mix van humor, maatschapijkritiek en persoolijke bedenkingen. Zijn werken doen denken aan filmscenes, met close-ups, beelden in kikkerperspectief, horizontale formaten, een spel met schaduwen en een dramatische sfeer. er broedt altijd iets in zijn taferelen. De spanning in het mysterie zijn haast tastbaar. We  zien dealers samenzweren in een donker hoekje, dronkhaards  in een groezelige pub, auto's in de nacht. De realiteit is grondstof voor de kunstenaar, die er op gaat dat hij enkel schildert wat hij kent. Hij combineert elementen uit het traditionele schilderkunst en de kunstgesciedenis met elemneten uit de stadcultuur, de soul muziek en de romans van zijn vriend en schrijver James Ellroy.","performers":null,"boxoffice_url":null,"website":null,"email":"zedes.art.gallery@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.542663"},"en":{"name":"RAY RICHARDSON : Tales From The Soul River","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"zedes.art.gallery@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.542663"},"de":{"name":"RAY RICHARDSON : Tales From The Soul River","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.542663"},"it":{"name":"RAY RICHARDSON : Tales From The Soul River","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.542663"},"sp":{"name":"RAY RICHARDSON : Tales From The Soul River","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.542663"},"pt":{"name":"RAY RICHARDSON : Tales From The Soul River","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":nu