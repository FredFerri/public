5-04-19","date_next":"2024-10-26","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-10-26T03:02:55+02:00","published_at":"2024-10-22T16:57:48+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":310245,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"other","ranking":0.22191822427467614,"languages":{"spoken":["fr","en","nl"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{}},"translations":{"de":{"name":"Make a way for trees","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.autrique.be","email":"info@autrique.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700002876"},"pt":{"name":"Make a way for trees","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.autrique.be","email":"info@autrique.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700002876"},"en":{"name":"Make a way for trees","shortdescr":"Our intention is also to raise awareness of the actors and projects linked to the presence, management and preservation of this green heritage: a journey between the long history of nature and the short history of the house, and the relationship between human life and nature.\n","longdescr":"According to the latest data from Brussels Environment (2023), the Belgian capital is one of the greenest cities in Europe, with 1,036 accessible green spaces of all sizes. This represents to an area of 3,129 hectares, or around 20% of its surface area. \n\nThrough the Art Nouveau architectural elements of the Maison Autrique, a selection of artworks from the 19th and 20th century, some contemporary creations and contributions from historians and scientists, the 'Trees' exhibition illustrates the emergence of a new urban scenery. The Maison Autrique propose to analyse the transformation of the way we look at and relate to nature in recent periods of Schaerbeek's history. This exhibition is an opportunity to question the place of nature in the urban environment, to describe our experiences of nature in the city. Our intention is also to raise awareness of the actors and projects linked to the presence, management and preservation of this green heritage: a journey between the long history of nature and the short history of the house, and the relationship between human life and nature.\n\nBy studying the history of our green and majestic neighbours, we question our vision of nature in the 21st century. Make a way for trees!\n","performers":null,"boxoffice_url":null,"website":"http:\/\/www.autrique.be","email":"info@autrique.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700002876"},"it":{"name":"Make a way for trees","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.autrique.be","email":"info@autrique.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700002876"},"cn":{"name":"Make a way for trees","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.autrique.be","email":"info@autrique.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700002876"},"fr":{"name":"Place aux Arbres","shortdescr":"L'exposition est l\u2019occasion de questionner la place de la nature en milieu urbain et de d\u00e9crire nos exp\u00e9riences de celle-ci en ville. Nous voulons \u00e9galement mettre en avant les acteurs et projets li\u00e9s \u00e0 la pr\u00e9sence, \u00e0 la gestion et \u00e0 la sauvegarde de ce patrimoine vert : un parcours entre l\u2019histoire longue de la nature et l\u2019histoire courte de la maison, et le rapport entre vie humaine et nature.","longdescr":"Selon les derni\u00e8res donn\u00e9es de Bruxelles Environnement (2023), la capitale belge est l\u2019une des villes les plus v\u00e9g\u00e9tales d\u2019Europe avec 1.036 espaces verts accessibles, de toutes tailles confondues. Cela correspond \u00e0 une superficie de 3.129 hectares, soit environ 20% de sa surface. \n\nA travers les \u00e9l\u00e9ments architecturaux Art nouveau de la Maison Autrique, par le biais d\u2019une s\u00e9lection d\u2019\u0153uvres d\u2019art des 19e et 20e si\u00e8cles, de quelques cr\u00e9ations contemporaines et d\u2019interventions d\u2019historiens et de scientifiques, l\u2019exposition \u00ab Arbres \u00bb illustre l\u2019apparition d\u2019un nouveau d\u00e9cor urbain. La Maison Autrique propose d\u2019analyser la transformation du regard et du rapport \u00e0 la nature dans les p\u00e9riodes r\u00e9centes de l\u2019histoire schaerbeekoise. Cette exposition est l\u2019occasion de questionner la place de la nature en milieu urbain et de d\u00e9crire nos exp\u00e9riences de celle-ci en ville. Nous voulons \u00e9galement mettre en avant les acteurs et projets li\u00e9s \u00e0 la pr\u00e9sence, \u00e0 la gestion et \u00e0 la sauvegarde de ce patrimoine vert : un parcours entre l\u2019histoire longue de la nature et l\u2019histoire courte de la maison, et le rapport entre vie humaine et nature.\nPar l\u2019\u00e9tude de l\u2019histoire de nos voisins verts et majestueux, nous questionnons notre vision de la nature au 21e si\u00e8cle. Place aux arbres ! \n","performers":"Willem Battaille, Euphrosine Beernaert, Kikie Cr\u00eavecoeur, Gisbert Combaz, Joseph Coosemans, Dominique Discors, Gilbert Fastenaekens, Georges Fr\u00e9d\u00e9ric, Nathalie Joiris, Jenos Kaparthy, Maurice Langaskens, Jacques Mathy, Maurice Minsart, Constant Montald, L\u00e9on Spilliaert, Henri Stiellemans, Taf Wallet, Albert Terken, Eug\u00e8ne Thelen, Victor Van Brabant,  Eug\u00e8ne Verboekhoven, Pascaline Wollast. \n","boxoffice_url":null,"website":"http:\/\/www.autrique.be","email":"info@autrique.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700002876"},"sp":{"name":"Make a way for trees","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.autrique.be","email":"info@autrique.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700002876"},"nl":{"name":"Ruimte voor bomen","shortdescr":"Deze tentoonstelling is een gelegenheid om de plaats van de natuur in de stedelijke omgeving in vraag te stellen, om onze ervaringen met de natuur in de stad te beschrijven. We willen ook een stem geven aan de actoren en projecten in verband met de aanwezigheid, het beheer en het behoud van dit groene erfgoed te sensibiliseren.\n","longdescr":"Volgens de laatste cijfers van Leefmilieu Brussel (2023) is de Belgische hoofdstad een van de groenste steden van Europa, met 1.036 toegankelijke groene ruimten van alle groottes. Dit komt overeen met een oppervlakte van 3.129 hectare, of ongeveer 20% van de oppervlakte. \n\nAan de hand van de architecturale Art Nouveau-elementen van het Autrique-huis zelf, een selectie kunstwerken uit de 19de en 20ste eeuw, enkele hedendaagse creaties en bijdragen van historici en wetenschappers, illustreert deze tentoonstelling de opkomst van een nieuwe stedelijke omgeving. Het Autrique huis stelt voor om te analyseren de transformatie van de manier waarop we naar de natuur kijken. Ons uitgangspunt is de snelle veranderende relatie met de natuur in recente periodes van de geschiedenis van Schaarbeek. Deze tentoonstelling is een gelegenheid om de plaats van de natuur in de stedelijke omgeving in vraag te stellen, om onze ervaringen met de natuur in de stad te beschrijven. We willen ook een stem geven aan de actoren en projecten in verband met de aanwezigheid, het beheer en het behoud van dit groene erfgoed te sensibiliseren: een reis tussen de lange geschiedenis van de natuur en de korte geschiedenis van het huis, en de relatie tussen het menselijk leven en de natuur.\n\nDoor de geschiedenis van onze groene en majestueuze buren te bestuderen, stellen we onze visie op de natuur in de 21e eeuw in vraag. Maak plaats voor de bomen!\n","performers":null,"boxoffice_url":null,"website":"http:\/\/www.autrique.be","email":"info@autrique.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700002876"}},"place":{"id":241931,"translations":{"de":{"name":"Maison Autrique","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"https:\/\/www.facebook.com\/maisonautrique\/","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":"Als erstes bedeutendes Bauwerk des Jugendstil-Architekten Victor Horta bildet das Maison Autrique ein wichtiges Element des Br\u00fcsseler Architekturerbes.\r\n\r\nEin Meilenstein der Br\u00fcsseler Architekturgeschichte: Denn das Geb\u00e4ude aus dem Jahr 1893 stellt eine wesentliche Etappe in der Entwicklung der gr\u00f6\u00dften belgischen Architekten dar. Durch das Geb\u00e4ude f\u00fchrt eine Szenographie, die von den beiden belgischen Comic-Gr\u00f6\u00dfen Fran\u00e7ois Schuiten und Beno\u00eet Peeter konzipiert wurde. Zugrundeliegende Idee war es, aus diesem Geb\u00e4ude eine Art \"Haus der H\u00e4user\" zu machen, eine Huldigung an die Br\u00fcsseler Architektur und zugleich ein Tor zum Imagin\u00e4ren.\r\n\r\nDas Maison Autrique bietet regelm\u00e4\u00dfig Ausstellungen rund um verschiedene Themen: das 19. Jahrhundert in Br\u00fcssel, Comic oder Jugenstil. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Maison Autrique","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"http:\/\/www.autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Autrique House","address_street_name":"Haachtsesteenweg","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"https:\/\/www.facebook.com\/maisonautrique\/","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Haachtsesteenweg, 266","address_line2":"1030 Schaerbeek","description_web":"Maison Autrique is the very first striking building Victor Horta designed. It was built in 1893 and it's a major part of Brussels' architectural patrimonium. It underwent an exemplary restoration and is now open to the public. This house is an important Art Nouveau touchstone: we can already see elements that form a part of the continual explorations of the architect. It's interior division is full of surprises: Fran\u00e7ois Schuiten and Beno\u00eet Peeters have staged an original scenography, from the cellar to the attic. The house has thus become a sort of tribute to Brussels' private architecture, while at the same time tickling the imagination. The house hosts intimate concerts, temporary exhibitions and workshops for children.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Maison Autrique","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"http:\/\/www.autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Maison Autrique","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"http:\/\/www.autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Maison Autrique","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"http:\/\/www.autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":"La Maison Autrique (Horta 1893) est un jalon important de l'Art Nouveau. Elle a fait l'objet d'une restauration exemplaire. Ouverte au public, elle permet \u00e0 chacun de mieux saisir l'int\u00e9r\u00eat historique et esth\u00e9tique des vieilles demeures bruxelloises. Lors de votre visite, vous d\u00e9couvrirez des espaces d'exposition, une petite librairie th\u00e9matique et une sc\u00e9nographie originale sign\u00e9e Beno\u00eet Peeters et Fran\u00e7ois Schuiten. La maison accueille des petits concerts, des expositions temporaires et des ateliers pour enfants. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Casa Autrique","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"http:\/\/www.autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":"La casa Autrique, obra fundacional de Victor Horta, ha sido completamente renovada, con una puesta en escena imaginaria realizada por los guionistas y dibujantes Schuiten y Peeters. Al entrar, te sumerges en una atm\u00f3sfera \u00fanica.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Autrique Huis","address_street_name":"Haachtsesteenweg","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"https:\/\/www.facebook.com\/maisonautrique\/","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaarbeek","address_line1":"Haachtsesteenweg, 266","address_line2":"1030 Schaarbeek","description_web":"Het Autrique Huis is het eerste markante gebouw van Victor Horta. Het werd in 1893 gebouwd en is nog steeds een voornaam element in het architectonisch patrimonium van Brussel. Het huis werd op uitmuntende wijze gerestaureerd en is open voor het publiek. Het huis is een belangrijke maatstaf van de Art Nouveau : men vindt er reeds elementen terug die de architect en zijn zoektocht kenmerken. De manier waarop de ruimte ingedeeld is, staat garant voor verrassingen : Fran\u00e7ois Schuiten en Beno\u00eet Peeters hebben een originele enscenering opgezet, waarbij het huis van de kelder tot de zolder ingericht werd. Zodoende wordt het huis een soort van eerbetoon aan de Brusselse priv\u00e9-architectuur, terwijl het ook de verbeelding aanspreekt. Het huis organiseert intieme concerten, tentoonstellingen en workshops voor kinderen.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[20],"translations":{"de":["Norden"],"pt":[null],"en":["North"],"it":["Nord"],"cn":[null],"fr":["Nord"],"sp":["Norte"],"nl":["Noord"]}},"neca":null,"facebook_id":null,"backoffice_id":4383,"location":{"lat":50.8632575,"lon":4.3731694},"region":"brussels","last_updated_at":"2024-09-10T13:09:05+02:00","published_at":"2013-10-19T01:17:19+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":241931,"translations":{"de":{"name":"Maison Autrique","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"https:\/\/www.facebook.com\/maisonautrique\/","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":"Als erstes bedeutendes Bauwerk des Jugendstil-Architekten Victor Horta bildet das Maison Autrique ein wichtiges Element des Br\u00fcsseler Architekturerbes.\r\n\r\nEin Meilenstein der Br\u00fcsseler Architekturgeschichte: Denn das Geb\u00e4ude aus dem Jahr 1893 stellt eine wesentliche Etappe in der Entwicklung der gr\u00f6\u00dften belgischen Architekten dar. Durch das Geb\u00e4ude f\u00fchrt eine Szenographie, die von den beiden belgischen Comic-Gr\u00f6\u00dfen Fran\u00e7ois Schuiten und Beno\u00eet Peeter konzipiert wurde. Zugrundeliegende Idee war es, aus diesem Geb\u00e4ude eine Art \"Haus der H\u00e4user\" zu machen, eine Huldigung an die Br\u00fcsseler Architektur und zugleich ein Tor zum Imagin\u00e4ren.\r\n\r\nDas Maison Autrique bietet regelm\u00e4\u00dfig Ausstellungen rund um verschiedene Themen: das 19. Jahrhundert in Br\u00fcssel, Comic oder Jugenstil. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Maison Autrique","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"http:\/\/www.autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Autrique House","address_street_name":"Haachtsesteenweg","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"https:\/\/www.facebook.com\/maisonautrique\/","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Haachtsesteenweg, 266","address_line2":"1030 Schaerbeek","description_web":"Maison Autrique is the very first striking building Victor Horta designed. It was built in 1893 and it's a major part of Brussels' architectural patrimonium. It underwent an exemplary restoration and is now open to the public. This house is an important Art Nouveau touchstone: we can already see elements that form a part of the continual explorations of the architect. It's interior division is full of surprises: Fran\u00e7ois Schuiten and Beno\u00eet Peeters have staged an original scenography, from the cellar to the attic. The house has thus become a sort of tribute to Brussels' private architecture, while at the same time tickling the imagination. The house hosts intimate concerts, temporary exhibitions and workshops for children.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Maison Autrique","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"http:\/\/www.autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Maison Autrique","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"http:\/\/www.autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Maison Autrique","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"http:\/\/www.autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":"La Maison Autrique (Horta 1893) est un jalon important de l'Art Nouveau. Elle a fait l'objet d'une restauration exemplaire. Ouverte au public, elle permet \u00e0 chacun de mieux saisir l'int\u00e9r\u00eat historique et esth\u00e9tique des vieilles demeures bruxelloises. Lors de votre visite, vous d\u00e9couvrirez des espaces d'exposition, une petite librairie th\u00e9matique et une sc\u00e9nographie originale sign\u00e9e Beno\u00eet Peeters et Fran\u00e7ois Schuiten. La maison accueille des petits concerts, des expositions temporaires et des ateliers pour enfants. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Casa Autrique","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"http:\/\/www.autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":"La casa Autrique, obra fundacional de Victor Horta, ha sido completamente renovada, con una puesta en escena imaginaria realizada por los guionistas y dibujantes Schuiten y Peeters. Al entrar, te sumerges en una atm\u00f3sfera \u00fanica.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Autrique Huis","address_street_name":"Haachtsesteenweg","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"https:\/\/www.facebook.com\/maisonautrique\/","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaarbeek","address_line1":"Haachtsesteenweg, 266","address_line2":"1030 Schaarbeek","description_web":"Het Autrique Huis is het eerste markante gebouw van Victor Horta. Het werd in 1893 gebouwd en is nog steeds een voornaam element in het architectonisch patrimonium van Brussel. Het huis werd op uitmuntende wijze gerestaureerd en is open voor het publiek. Het huis is een belangrijke maatstaf van de Art Nouveau : men vindt er reeds elementen terug die de architect en zijn zoektocht kenmerken. De manier waarop de ruimte ingedeeld is, staat garant voor verrassingen : Fran\u00e7ois Schuiten en Beno\u00eet Peeters hebben een originele enscenering opgezet, waarbij het huis van de kelder tot de zolder ingericht werd. Zodoende wordt het huis een soort van eerbetoon aan de Brusselse priv\u00e9-architectuur, terwijl het ook de verbeelding aanspreekt. Het huis organiseert intieme concerten, tentoonstellingen en workshops voor kinderen.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":4383,"location":{"lat":50.8632575,"lon":4.3731694},"last_updated_at":"2024-09-10T13:09:05+02:00","published_at":"2013-10-19T01:17:19+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"poster","link":"https:\/\/agendabrussels2.imgix.net\/ea3a9b62cf7893f0dce972a7327aa4eecfeb78ce.jpg","width":2481,"height":3508,"ratio":0.71,"oEmbed_height":3508,"oEmbed_width":2481,"translations":{"de":{"title":"Exposition Place aux Arbres ! ","copyright":"Collection Communale de Schaerbee"},"pt":{"title":"Exposition Place aux Arbres ! ","copyright":"Collection Communale de Schaerbee"},"en":{"title":"Exposition Place aux Arbres ! ","copyright":"Collection Communale de Schaerbee"},"it":{"title":"Exposition Place aux Arbres ! ","copyright":"Collection Communale de Schaerbee"},"cn":{"title":"Exposition Place aux Arbres ! ","copyright":"Collection Communale de Schaerbee"},"fr":{"title":"Exposition Place aux Arbres ! ","copyright":"Collection Communale de Schaerbee"},"sp":{"title":"Exposition Place aux Arbres ! ","copyright":"Collection Communale de Schaerbee"},"nl":{"title":"Exposition Place aux Arbres ! ","copyright":"Collection Communale de Schaerbee"}}}],"dates":[{"day":"2024-10-19","doors":null,"start":"12:00:00","end":"18:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-10-20","doors":null,"start":"12:00:00","end":"18:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-10-23","doors":null,"start":"12:00:00","end":"18:00:00","end_night_life":null,"i