visit.brussels\/pt\/visitors\/agenda\/event-detail.50006047"},"en":{"name":"M\u00e9nart et Joblin \u2013 Cr\u00e9ation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lejardindemasoeur.be\/jardinevents\/2017\/10\/25\/brel-bruno-ke5n8-r6mk8-nks45-sbres-7lany-3zjhw-y6bjj-gx3n7-wh5xp-lf8zb-26jae-6zdj2-z2t7k","email":"info@lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50006047"},"it":{"name":"M\u00e9nart et Joblin \u2013 Cr\u00e9ation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lejardindemasoeur.be\/jardinevents\/2017\/10\/25\/brel-bruno-ke5n8-r6mk8-nks45-sbres-7lany-3zjhw-y6bjj-gx3n7-wh5xp-lf8zb-26jae-6zdj2-z2t7k","email":"info@lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50006047"},"cn":{"name":"M\u00e9nart et Joblin \u2013 Cr\u00e9ation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lejardindemasoeur.be\/jardinevents\/2017\/10\/25\/brel-bruno-ke5n8-r6mk8-nks45-sbres-7lany-3zjhw-y6bjj-gx3n7-wh5xp-lf8zb-26jae-6zdj2-z2t7k","email":"info@lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50006047"},"fr":{"name":"M\u00e9nart et Joblin \u2013 Cr\u00e9ation","shortdescr":"M\u00e9nart et Joblin, c\u2019est d\u2019abord\u00a0une histoire d\u2019amour, qui s'allume au r\u00e9veillon, puis qui s'\u00e9teint, \u00e0 cause des autres, pour se rallumer enfin au cimeti\u00e8re, comme par hasard... Pascale Vander Zypen \u00e9crit comme elle joue et est toujours solidaire de tous ses personnages qui nous ressemblent tant. Un univers singuli\u00e8rement d\u00e9cal\u00e9 qui suscite le rire et l\u2019\u00e9motion.","longdescr":"Les h\u00e9ros d\u2019une aventure path\u00e9tique : la vie des gens ordinaires !\nM\u00e9nart et Joblin, c\u2019est d\u2019abord\u00a0une histoire d\u2019amour, qui s'allume au r\u00e9veillon, comme pour d\u00e9sob\u00e9ir, puis qui s'\u00e9teint, \u00e0 cause des autres, pour se rallumer enfin au cimeti\u00e8re, comme par hasard... Pascale Vander Zypen \u00e9crit comme elle joue, tant\u00f4t moqueuse, tant\u00f4t furieuse, tant\u00f4t affectueuse, mais toujours solidaire de tous ses personnages qui nous ressemblent tant. Des situations aussi quotidiennes qu\u2019improbables d\u2019o\u00f9 jaillissent des \u00e9tincelles d\u2019humanit\u00e9, un univers singuli\u00e8rement d\u00e9cal\u00e9 qui suscite le rire et l\u2019\u00e9motion. - \nRepr\u00e9sentation \u00e0 20h45.","performers":"Pascale Vander Zypen (conception, interpr\u00e9tation); Jean Lambert (regard complice)","boxoffice_url":null,"website":"https:\/\/www.lejardindemasoeur.be\/jardinevents\/2017\/10\/25\/brel-bruno-ke5n8-r6mk8-nks45-sbres-7lany-3zjhw-y6bjj-gx3n7-wh5xp-lf8zb-26jae-6zdj2-z2t7k","email":"info@lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50006047"},"sp":{"name":"M\u00e9nart et Joblin \u2013 Cr\u00e9ation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lejardindemasoeur.be\/jardinevents\/2017\/10\/25\/brel-bruno-ke5n8-r6mk8-nks45-sbres-7lany-3zjhw-y6bjj-gx3n7-wh5xp-lf8zb-26jae-6zdj2-z2t7k","email":"info@lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50006047"},"nl":{"name":"M\u00e9nart et Joblin \u2013 Cr\u00e9ation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lejardindemasoeur.be\/jardinevents\/2017\/10\/25\/brel-bruno-ke5n8-r6mk8-nks45-sbres-7lany-3zjhw-y6bjj-gx3n7-wh5xp-lf8zb-26jae-6zdj2-z2t7k","email":"info@lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50006047"}},"place":{"id":220283,"translations":{"de":{"name":"Le Jardin de ma Soeur","address_street_name":"Rue du Grand Hospice","address_street_number":"54","address_street_box":null,"email":"info@lejardindemasoeur.be","website":"http:\/\/www.lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 54","address_line2":"1000 Bruxelles","description_web":"Dieses malerische Caf\u00e9-Theater, das 1994 in der N\u00e4he des alten \"Grand B\u00e9guinage de Bruxelles\" er\u00f6ffnet wurde, \u00fcberrascht durch seine \u00fcberaus kleinen R\u00e4umlichkeiten. Doch daf\u00fcr ist das Programm ist umso \"gr\u00f6\u00dfer\". Reservierung empfohlen!","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Le Jardin de ma Soeur","address_street_name":"Rue du Grand Hospice","address_street_number":"54","address_street_box":null,"email":"info@lejardindemasoeur.be","website":"http:\/\/www.lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 54","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Le Jardin de ma Soeur","address_street_name":"Grootgodshuisstraat","address_street_number":"54","address_street_box":null,"email":"info@lejardindemasoeur.be","website":"http:\/\/www.lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","address_zip":"1000","address_city":"Bruxelles","address_line1":"Grootgodshuisstraat, 54","address_line2":"1000 Bruxelles","description_web":"The desire to present theater amongst people; as if a performance is nothing but a conversation, in a place somewhere in between the large halls and the streets, half living room, half pub, in a warm ambiance where one can sip a glass while watching a performance. That's cafe-theater \"Le Jardin de ma Soeur\", at the edge of the ancient \"Grand B\u00e9guinage de Bruxelles\", alongside one of the quays of the old port of Brussels where the spirit of the dock workers lingers and where one can still feel the presence of the beguines with their long black robes.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Le Jardin de ma Soeur","address_street_name":"Rue du Grand Hospice","address_street_number":"54","address_street_box":null,"email":"info@lejardindemasoeur.be","website":"http:\/\/www.lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 54","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Le Jardin de ma Soeur","address_street_name":"Rue du Grand Hospice","address_street_number":"54","address_street_box":null,"email":"info@lejardindemasoeur.be","website":"http:\/\/www.lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 54","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Le Jardin de ma Soeur","address_street_name":"Rue du Grand Hospice","address_street_number":"54","address_street_box":null,"email":"info@lejardindemasoeur.be","website":"http:\/\/www.lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 54","address_line2":"1000 Bruxelles","description_web":"Le Jardin de ma S\u0153ur est situ\u00e9 au coin d'une rue du pittoresque March\u00e9 aux poissons, \u00e0 proximit\u00e9 de l\u2019ancien Grand B\u00e9guinage de Bruxelles. On peut difficilement imaginer un nom plus familier. Pourtant, cet endroit n'a pas vol\u00e9 son nom. Vous obtenez exactement ce que vous attendez : une soir\u00e9e sans pr\u00e9tention, pleine de divertissements et de moments partag\u00e9s. Vous vous y sentez comme dans votre salon. Vous oubliez imm\u00e9diatement tous vos soucis et riez, chantez et profitez du spectacle avec les autres participants. Sp\u00e9cialement pour les amateurs de chanson fran\u00e7aise et de th\u00e9\u00e2tre.  \u202f \r\nPensez \u00e0 r\u00e9server votre place !\r\n ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Le Jardin de ma Soeur","address_street_name":"Rue du Grand Hospice","address_street_number":"54","address_street_box":null,"email":"info@lejardindemasoeur.be","website":"http:\/\/www.lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 54","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Le Jardin de ma Soeur","address_street_name":"Grootgodshuisstraat","address_street_number":"54","address_street_box":null,"email":"info@lejardindemasoeur.be","website":"http:\/\/www.lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","address_zip":"1000","address_city":"Bruxelles","address_line1":"Grootgodshuisstraat, 54","address_line2":"1000 Bruxelles","description_web":"Op een straathoek aan de pittoreske Vismarkt ligt Le Jardin de ma Soeur. Een familialere naam kan je haast niet bedenken. Toch heeft deze plek haar naam niet gestolen. Je krijgt exact wat je er zou verwachten: een pretentieloze avond vol vertier en gedeelde momenten. Hier waan je je in een gezellige en veilige woonkamer. Je vergeet er meteen al je zorgen en lacht, zingt en geniet met de andere aanwezigen. Vooral voor liefhebbers van het Franse chanson en verhaaltheater.    \u202f\u202f\u202f ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[3],"translations":{"de":["Dansaert\/Sainte-Catherine"],"pt":[null],"en":["Dansaert\/Sainte-Catherine"],"it":["Dansaert\/Sainte-Catherine"],"cn":[null],"fr":["Dansaert\/Sainte-Catherine"],"sp":["Dansaert\/Sainte-Catherine"],"nl":["Dansaertwijk\/Sint-Katelijne"]}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":null,"facebook_id":"terassequai","backoffice_id":596,"location":{"lat":50.8535193,"lon":4.347348},"region":"brussels","last_updated_at":"2023-11-06T09:12:27+01:00","published_at":"2013-10-19T01:13:39+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":220283,"translations":{"de":{"name":"Le Jardin de ma Soeur","address_street_name":"Rue du Grand Hospice","address_street_number":"54","address_street_box":null,"email":"info@lejardindemasoeur.be","website":"http:\/\/www.lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 54","address_line2":"1000 Bruxelles","description_web":"Dieses malerische Caf\u00e9-Theater, das 1994 in der N\u00e4he des alten \"Grand B\u00e9guinage de