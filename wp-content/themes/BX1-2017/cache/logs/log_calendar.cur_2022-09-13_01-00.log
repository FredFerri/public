line2":"1000 Bruxelles","description_web":"Die Br\u00fcsseler Notre Dame de la Chapelle-Kirche ist aufgrund ihrer romanischen Architektur bemerkenswert und gilt als eine der interessantesten Kirchen Belgiens.\r\n\r\nIn einer der Kapellen befindet sich das Grabmal des Malers Pieter Breughel und seiner Gemahlin, Marie Coucke. In der Kapelle des Heiligen Sakraments erinnert eine Gedenktafel daran, dass sich hier auch die letzte Ruhest\u00e4tte des zum Tode verurteilten und hingerichteten K\u00f6rperschafts\u00e4ltesten Fran\u00e7ois Anneessens, der sich f\u00fcr die Gemeindefreiheit der Stadt Br\u00fcssel eingesetzt hat, befindet.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"\u00c9glise Notre-Dame de la Chapelle","address_street_name":"Rue de la Chapelle","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Chapelle","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"\u00c9glise Notre-Dame de la Chapelle","address_street_name":"Rue de la Chapelle","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Chapelle","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"\u00c9glise Notre-Dame de la Chapelle","address_street_name":"Rue de la Chapelle","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Chapelle","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_u