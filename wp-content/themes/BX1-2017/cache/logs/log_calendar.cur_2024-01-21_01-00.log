{"main":{"id":84,"translations":{"de":"Verschiedenes","pt":null,"en":"Various","it":"Varie","cn":null,"fr":"Divers","sp":"Varios","nl":"Varia"}},"others":{}},"translations":{"de":{"name":"Cr\u00e9ation de chapeaux et couvre-chefs","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wolubilis.be","email":"secretariat.atl@woluwe1200.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.559487"},"pt":{"name":"Cr\u00e9ation de chapeaux et couvre-chefs","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wolubilis.be","email":"secretariat.atl@woluwe1200.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.559487"},"en":{"name":"Cr\u00e9ation de chapeaux et couvre-chefs","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wolubilis.be","email":"secretariat.atl@woluwe1200.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.559487"},"it":{"name":"Cr\u00e9ation de chapeaux et couvre-chefs","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wolubilis.be","email":"secretariat.atl@woluwe1200.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.559487"},"cn":{"name":"Cr\u00e9ation de chapeaux et couvre-chefs","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wolubilis.be","email":"secretariat.atl@woluwe1200.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.559487"},"fr":{"name":"Cr\u00e9ation de chapeaux et couvre-chefs","shortdescr":"Avec Philippe Borg","longdescr":"Venez apprendre \u00e0 d\u00e9velopper votre fibre artistique dans les arts textiles tout en vous initiant \u00e0 la r\u00e9alisation de chapeaux et couvre-chefs. Cet atelier est principalement ax\u00e9 sur la m\u00e9thode du moulage (utilisation de moules en bois) et l\u2019utilisation du feutre, Sisal, toile raide et tissus mais toutes les exp\u00e9riences et projets sont possibles. Que ce soit pour vous m\u00eame ou dans des r\u00e9alisations interdisciplinaires (en collaboration avec d\u2019autres ateliers du Cec) ou \u00e0 partir d\u2019un th\u00e8me d\u00e9fini vous apprendrez et aborderez diff\u00e9rentes techniques de base pour l\u2019\u00e9laboration de chapeaux, de leurs finitions et quelques techniques d\u2019embellissement.\r\n\r\nMat\u00e9riel \u00e0 apporter : Mat\u00e9riel de couture (Une paire de ciseaux, un m\u00e8tre-ruban, un d\u00e9 \u00e0 coudre, des aiguilles, des \u00e9pingles \u00e0 grosse t\u00eate\u2026) De quoi prendre des notes. \r\n\r\nLes mati\u00e8res premi\u00e8res de base pour la r\u00e9alisation des chapeaux peuvent \u00eatre achet\u00e9es sur place. Par la suite, vous ach\u00e8terez vos propres mati\u00e8res.\r\n\r\nLes lundis soirs de 19h \u00e0 21h30 des le 18\/9 et fin le 3\/6\r\n\r\nAvec Philippe Borg \r\n\r\nLocal Couture\r\n\r\nPrix : 465","performers":"Cr\u00e9ation de chapeaux et couvre-chefs - 2023\/2024 - 102\r\nAtelier Couture | Rue Lola Bobesco 11, 2e \u00e9tage - 1200 Woluwe Saint Lambert | Voir la carte","boxoffice_url":null,"website":"http:\/\/www.wolubilis.be","email":"secretariat.atl@woluwe1200.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.559487"},"sp":{"name":"Cr\u00e9ation de chapeaux et couvre-chefs","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wolubilis.be","email":"secretariat.atl@woluwe1200.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","ag