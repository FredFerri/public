show_in_agenda":true,"is_outside":true,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":295606,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"festival","ranking":0.6933612743506347,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":118,"translations":{"de":"Festival","pt":null,"en":"Festival","it":"Festival","cn":null,"fr":"Festival","sp":"Festival","nl":"Festival"}},"others":{}},"translations":{"de":{"name":"Les rencontres \"Mingi Wingi\" : Entre Bruxelles et Kinshasa","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.mingiwingi.org\/","email":"gloria.mukolo@cec-ong.org","phone_contact":"+32 483 32 51 29","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50007833"},"pt":{"name":"Les rencontres \"Mingi Wingi\" : Entre Bruxelles et Kinshasa","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.mingiwingi.org\/","email":"gloria.mukolo@cec-ong.org","phone_contact":"+32 483 32 51 29","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50007833"},"en":{"name":"Les rencontres \"Mingi Wingi\" : Entre Bruxelles et Kinshasa","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.mingiwingi.org\/","email":"gloria.mukolo@cec-ong.org","phone_contact":"+32 483 32 51 29","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50007833"},"it":{"name":"Les rencontres \"Mingi Wingi\" : Entre Bruxelles et Kinshasa","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.mingiwingi.org\/","email":"gloria.mukolo@cec-ong.org","phone_contact":"+32 483 32 51 29","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50007833"},"cn":{"name":"Les rencontres \"Mingi Wingi\" : Entre Bruxelles et Kinshasa","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.mingiwingi.org\/","email":"gloria.mukolo@cec-ong.org","phone_contact":"+32 483 32 51 29","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50007833"},"fr":{"name":"Les rencontres \"Mingi Wingi\" : Entre Bruxelles et Kinshasa","shortdescr":null,"longdescr":"L\u2019\u00e9dition pilote des rencontres Mingi Wingi pr\u00e9pare le terrain pour les ann\u00e9es \u00e0 venir. Notre objectif ? Favoriser l'\u00e9mergence d'id\u00e9es face aux d\u00e9fis du d\u00e9veloppement durable en facilitant un \u00e9change direct entre Bruxelles et Kinshasa. Nos rencontres cr\u00e9ent un carrefour entre l'art, la pens\u00e9e et l'engagement, abordant la question cruciale de la construction d'un monde durable pour tous\u00b7tes.\n\nLes rencontres se tiendront, du 22 au 24 mars, \u00e0 Bruxelles et \u00e0 Kinshasa. Le Grand Hospice \u00e0 Bruxelles, lieu d\u2019occupation temporaire au c\u0153ur de la ville, abrite plus de 150 projets porteurs de changement. \n\nMingi Wingi vise \u00e0 rassembler les initiatives et les id\u00e9es \u00e9manant de cet endroit repr\u00e9sentant les secteurs \u00e9cologiques, artistiques, sociaux, culturels, \u00e9ducatifs et de la solidarit\u00e9 internationale. \u00c0 Kinshasa, l'Acad\u00e9mie des Beaux-Arts, lieu de rassemblement et de ressourcement, sera le partenaire id\u00e9al pour favoriser l'\u00e9change entre citoyen\u00b7nes du monde et porteurs de changement et ce \u00e0 travers l\u2019art.\n\nLe terme \"MINGI\" en lingala et \"WINGI\" en swahili, signifie respectivement beaucoup et abondance. L\u2019\u00e9v\u00e9nement se pr\u00e9sente comme une grande c\u00e9l\u00e9bration de l'abondance en faveur d'un monde durable.\n\nMINGI WINGI, UN PROJET DE CEC\n\nL\u2019ONG culturelle Coop\u00e9ration Education Culture (CEC) propose depuis plus de 40 ans des \u00e9v\u00e8nements culturels et des actions d\u2019\u00e9ducation \u00e0 la citoyennet\u00e9 mondiale et solidaire qui visent la promotion d'une soci\u00e9t\u00e9 inclusive, d\u00e9coloniale et durable. CEC est en lien \u00e9galement avec un r\u00e9seau de partenaires en Afrique et plus sp\u00e9cifiquement en RDC.\n\n\nPour plus d'informations : https:\/\/fb.me\/e\/1kZDczhgY \n\nLa programmation : https:\/\/www.mingiwingi.org\/ ","performers":"Petna Ndaloko Katondolo, Ad\u00e9la\u00efde Charlier, Sename Koffi Agbodjinou, Etienne Minoungou, Wilfried N\u2019sond\u00e9, Micha\u00ebl De Cock, Pitcho Womba Kongo,...","boxoffice_url":null,"website":"https:\/\/www.mingiwingi.org\/","email":"gloria.mukolo@cec-ong.org","phone_contact":"+32 483 32 51 29","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50007833"},"sp":{"name":"Les rencontres \"Mingi Wingi\" : Entre Bruxelles et Kinshasa","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.mingiwingi.org\/","email":"gloria.mukolo@cec-ong.org","phone_contact":"+32 483 32 51 29","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50007833"},"nl":{"name":"Les rencontres \"Mingi Wingi\" : Entre Bruxelles et Kinshasa","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.mingiwingi.org\/","email":"gloria.mukolo@cec-ong.org","phone_contact":"+32 483 32 51 29","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50007833"}},"place":{"id":249502,"translations":{"de":{"name":"CEC - Cooperation par l'\u00e9ducation et la culture","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"info@cec-ong.org","website":"https:\/\/www.cec-ong.org","phone_contact":"+32 470 05 32 36","phone_booking":"+32 470 05 32 36","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 7