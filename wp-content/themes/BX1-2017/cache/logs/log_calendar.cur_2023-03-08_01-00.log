:{"name":"De Ultieme Hallucinatie","address_street_name":"Rue Royale","address_street_number":"316","address_street_box":null,"email":"info@deulha.be","website":"https:\/\/www.ultiemehallucinatie.be\/","phone_contact":"+32 2 889 03 16","phone_booking":"+32 2 889 03 16","address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Royale, 316","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":[],"zones":{"list":[20],"translations":{"fr":["Nord"],"nl":["Noord"],"en":["North"],"de":["Norden"],"it":["Nord"],"sp":["Norte"],"pt":[null],"cn":[null]}},"neca":null,"facebook_id":null,"backoffice_id":20326,"location":{"lat":50.85748896,"lon":4.36767612},"region":"brussels","last_updated_at":"2023-03-02T04:05:30+01:00","published_at":"2015-03-24T17:20:31+01:00","import_origin":null,"external_id":null,"is_in_address_book":false,"is_in_vb_export":false,"resto_ranking":0},"organizer":{"id":267246,"translations":{"fr":{"name":"Explore.brussels","address_street_name":"Avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"https:\/\/www.explore.brussels\/fr","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Avenue Brugmann, 405","address_line2":"1180 Uccle","description_web":"Explore.Brussels est un r\u00e9seau d'associations de visites guid\u00e9es \u00e0 Bruxelles. Cet organisme regroupe notamment ARAU, Arkadia, Bruxelles Bavard, Pro Velo, La Fonderie et Korei. les \u00e9v\u00e9nements sont organis\u00e9s en coproduction avec ces 6 entreprises  Les visites individuelles ou en groupe sont disponibles \u00e0 pied, \u00e0 v\u00e9lo, en car et en bateau.  Les visiteurs partent \u00e0 la d\u00e9couverte du patrimoine de l'UNESCO, de Magritte, de l'art d\u00e9co, du chocolat et bien plus encore. Explore.Brussels organise \u00e9galement des festivals bruxellois et d'autres projets de grande envergure.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Explore.brussels","address_street_name":"Brugmannlaan","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"https:\/\/www.explore.brussels\/fr","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Ukkel","address_line1":"Brugmannlaan, 405","address_line2":"1180 Ukkel","description_web":"Explore.Brussels is een netwerk van verenigingen voor geleide bezoeken in Brussel. Deze organisatie omvat ARAU, Arkadia, Bruxelles Bavard, Pro Velo, La Fonderie en Korei. De evenementen worden georganiseerd in coproductie met deze 6 bedrijven. Individuele of groepstochten zijn mogelijk te voet, per fiets, per bus en per boot.  Bezoekers ontdekken UNESCO erfgoed, Magritte, art deco, chocolade en nog veel meer. Explore.Brussels organiseert ook Brusselse festivals en andere grootschalige projecten.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Explore.brussels","address_street_name":"Avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"https:\/\/www.explore.brussels\/fr","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Avenue Brugmann, 405","address_line2":"1180 Uccle","description_web":"Explore.Brussels is a network of guided tour associations in Brussels. This organisation includes ARAU, Arkadia, Bruxelles Bavard, Pro Velo, La Fonderie and Korei. Events are organised in co-production with these 6 companies. Individual or group tours are available on foot, by bike, by bus and by boat.  Visitors discover UNESCO heritage, Magritte, art deco, chocolate and much more. Explore.Brussels also organises Brussels festivals and other large-scale projects.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Explore.brussels","address_street_name":"Avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"https:\/\/www.explore.brussels\/fr","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Avenue Brugmann, 405","address_line2":"1180 Uccle","description_web":"Explore.Brussels ist ein Zusammenschluss von Vereinen, die qualitativ hochwertige Stadtf\u00fchrungen in der Region Br\u00fcssel-Hauptstadt organisieren.\r\nDie Mitgliedsvereine sind ARAU, Pro Velo, Brussels Chatterguides und Arkadia. Im Jahr 2020 hat sich La Fonderie als Partnerverein angeschlossen.\r\nEntdecken Sie das UNESCO-Weltkulturerbe, Jugendstilarchitektur, die Bauwerke von Victoria Horta, Gem\u00e4lde von Magritte, Comic-Kunst von Herg\u00e9, Streetart, Europa, Bier, Schokolade oder besichtigen Sie architektonische Perlen des Jugendstils, des Art-d\u00e9co oder des Neoklassizismus, die normalerweise nicht f\u00fcr die \u00d6ffentlichkeit zug\u00e4nglich sind. Die F\u00fchrungen werden sowohl f\u00fcr Einzelbesucher als auch f\u00fcr Gruppen angeboten und reichen von klassischen \u00fcber originelle bis hin zu vollkommen neuen Konzepten und Formaten. Neben Stadtf\u00fchrungen zu Fu\u00df sind auch Besichtigungen per Fahrrad, Bus oder Boot m\u00f6glich.\r\nExplore.Brussels organisiert unter anderem auch das Jugendstil- und Art-d\u00e9co-Festival BANAD, die Brussels Biennale - Neoclassic (BBN) sowie weitere Projekte, darunter die Ausbildung von Stadtf\u00fchrern, der \u201eVerein der Freunde\u201c und der \u201eVerein der Eigent\u00fcmer\u201c. \r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Explore.brussels","address_street_name":"Avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"https:\/\/www.explore.brussels\/fr","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Avenue Brugmann, 405","address_line2":"1180 Uccle","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Explore.brussels","address_street_name":"Avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"https:\/\/www.explore.brussels\/fr","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Avenue Brugmann, 405","address_line2":"1180 Uccle","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Explore.brussels","address_street_name":"Avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"https:\/\/www.explore.brussels\/fr","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Avenue Brugmann, 405","address_line2":"1180 Uccle","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Explore.brussels","address_street_name":"Avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"https:\/\/www.explore.brussels\/fr","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Avenue Brugmann, 405","address_line2":"1180 Uccle","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":null,"facebook_id":null,"backoffice_id":27246,"location":{"lat":50.80795462,"lon":4.34397082},"region":"brussels","last_updated_at":"2023-03-02T04:05:31+01:00","published_at":"2017-02-27T10:05:49+01:00","import_origin":null,"external_id":null,"is_in_address_book":false,"is_in_vb_export":false,"resto_ranking":0},"media":[],"dates":[{"day":"2023-03-26","doors":null,"start":"19:00:00","end":"00:00:00","is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"},"de":{"name":"Normal"},"it":{"name":"Normale"},"sp":{"name":"Normal"},"pt":{"name":"Normal"},"cn":{"name":"Normal"}},"value":20}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":["party_brussels"],"is_part_of":"Party.brussels","accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-03-02T04:05:31+01:00","published_at":"2023-02-04T03:30:03+01:00","backoffice_id":270910,"import_origin":"explore","sub_type":"other","show_in_agenda":true,"ranking":1},{"id":552715,"date_start":"2023-03-26","date_end":"2023-03-26","date_next":"2023-03-26","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert","de":"Konzert","it":"Concerti","sp":"Concierto","pt":null,"cn":null}},"others":{"list":[4,10],"translations":{"fr":["Pop, rock, jazz\u2026","Jazz & Blues"],"nl":["Pop, rock, jazz\u2026","Jazz & Blues"],"en":["Pop, rock, jazz\u2026","Jazz & Blues"],"de":["Pop, Rock, Jazz...","Jazz & Blues"],"it":["Pop, rock, jazz\u2026","Jazz e Blues"],"sp":["Pop, rock, jazz\u2026","Jazz y blues"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Entre concert et d\u00e9clamation th\u00e9\u00e2trale, Josse de Pauw et le trio Kris Defoort","shortdescr":"Entre concert et d\u00e9clamation th\u00e9\u00e2trale, Josse De Pauw et le groupe de jazz Kris Defoort Trio nous emportent dans leur univers entre r\u00eaverie et r\u00e9sistance \u00e0 l\u2019\u00e2pret\u00e9 du monde.\r\n\r\nEntr\u00e9e libre. Inscription obligatoire.","longdescr":"Ixelles, 26 boulevard Ge\u0301ne\u0301ral Jacques, la Fondation blan voit le jour au rond-point de l\u2019Etoile. Thomas de Wouters, son fondateur, souhaite apporter un regard neuf sur l\u2019art contemporain.\r\n\r\nC'est dans un ho\u0302tel de mai\u0302tre de quatre e\u0301tages surplombe\u0301s d'un jardin suspendu que ce projet d'envergure a \u00e9t\u00e9 imagin\u00e9. Un appel a\u0300 l'audace. A l'image de la fondation.\r\n\r\nNi galerie d\u2019art, ni muse\u0301e, le lieu se veut e\u0301clectique. Aux arts plastiques r\u00e9pondront d\u2019\u00e9tonnantes correspondances, qu\u2019elles soient lie\u0301es a\u0300 la musique, a\u0300 la litte\u0301rature, aux performances, au cine\u0301ma ou encore au the\u0301a\u0302tre.\r\n\r\nCette furieuse envie de nouveaute\u0301 et de frai\u0302cheur s\u2019installera au c\u0153ur de Bruxelles. Un endroit exceptionnel dont l\u2019artiste plasticien Stephan Balleux prendra largement possession dans le cadre de son exposition inaugurale \"Artificialia\".\r\n\r\nPROGRAMME (sur r\u00e9servation avant le 7 mars, places limit\u00e9es)\r\n23 mars 18h - Cocktail inaugural et vernissage de l'exposition Artificialia - Stephan Balleux\r\n24 mars 14h - Rencontre et visite de l'exposition en compagnie de l'artiste Stephan Balleux\r\n24 mars 15h - Rencontre et visite de l'exposition en compagnie de l'artiste Stephan Balleux\r\n24 mars 16h - Rencontre et visite de l'exposition en compagnie de l'artiste Stephan Balleux\r\n25 mars 9h30 - Atelier pour enfants autour de l\u2019exposition Artificialia\r\n25 mars 11h - Atelier pour enfants autour de l\u2019exposition Artificialia\r\n25 mars 17h - Lecture en proses par Elya Verdal, piano et voix\r\n26 mars 15h - Entre concert et d\u00e9clamation th\u00e9\u00e2trale, Josse de Pauw et le trio Kris Defoort","performers":"Josse de Pauw, Kris Defoort","boxoffice_url":null,"website":"https:\/\/www.fondationblan.org\/","email":"info@fondationblan.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.552715"},"nl":{"name":"Tussen concert en theatrale vertoning, Josse de Pauw en het Kris Defoort trio","shortdescr":"Tussen concert en theatrale vertoning, Josse de Pauw en het Kris Defoort trio","longdescr":"Een nieuwe stichting ziet het daglicht op het Sterreplein in Elsene, aan de Generaal Jacqueslaan 26. Oprichter Thomas de Wouters wil een nieuwe blik op hedendaagse kunst bieden.\r\n\r\nDit grootschalige project is opgezet in een herenhuis met vier verdiepingen en een overhangende tuin. Een oproep tot durf. Net zoals de stichting.\r\n\r\nDeze plek is geen galerie, noch museum, ze wil eclectisch zijn. Er zullen zich verbazingwekkende overeenkomsten ontvouwen tussen de beeldende kunst en muziek, literatuur, performances, film of theater.\r\n\r\nDeze hang naar vernieuwing en frisheid komt centraal te staan in het Brusselse herenhuis. Een uitzonderlijke plek, waarvan de beeldende kunstenaar Stephan Balleux een groot deel zal innemen in het kader van de openingstentoonstelling \"Artificialia\".\r\n\r\nAGENDA (op reservatie voor 7 maart, beperkte plaatsen)\r\n23 maart 18u - Inauguratie drink en vernissage van de tentoonstelling Artificialia - Stephan Balleux\r\n24 maart 14u - Ontmoeting en bezoek aan de tentoonstelling in aanwezigheid van de kunstenaar Stephan Balleux\r\n24 maart 15u - Ontmoeting en bezoek aan de tentoonstelling in aanwezigheid van de kunstenaar Stephan Balleux\r\n24 maart 16u - Ontmoeting en bezoek aan de tentoonstelling in aanwezigheid van de kunstenaar Stephan Balleux\r\n25 maart 9u30 - Workshop voor kinderen rond de tentoonstelling Artificialia\r\n25 maart 11u - Workshop voor kinderen rond de tentoonstelling Artificialia\r\n25 maart 17u - Prozalezing door Elya Verdal, piano en zang\r\n26 maart 15u - Tussen concert en theatrale vertoning, Josse de Pauw en het Kris Defoort trio","performers":"Josse de Pauw, Kris Defoort","boxoffice_url":null,"website":"https:\/\/www.fondationblan.org\/","email":"info@fondationblan.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.552715"},"en":{"name":"Entre concert et d\u00e9clamation th\u00e9\u00e2trale, Josse de Pauw et le trio Kris Defoort","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.fondationblan.org\/","email":"info@fondationblan.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.552715"},"de":{"name":"Entre concert et d\u00e9clamation th\u00e9\u00e2trale, Josse de Pauw et le trio Kris Defoort","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.fondationblan.org\/","email":"info@fondationblan.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.552715"},"it":{"name":"Fondation blan | Entre concert et d\u00e9clamation th\u00e9\u00e2trale, Josse de Pauw et le trio Kris Defoort","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.fondationblan.org\/","email":"info@fondationblan.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.552715"},"sp":{"name":"Fondation blan | Entre concert et d\u00e9clamation th\u00e9\u00e2trale, Josse de Pauw et le trio Kris Defoort","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.fondationblan.org\/","email":"info@fondationblan.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.552715"},"pt":{"name":"Fondation blan | Entre concert et d\u00e9clamation th\u00e9\u00e2trale, Josse de Pauw et le 