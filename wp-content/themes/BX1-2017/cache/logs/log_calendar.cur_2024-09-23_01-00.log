cr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.itineraires.be\/event-details\/a-la-decouverte-de-jette","email":"info@itineraires.be","phone_contact":null,"phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700001307"},"it":{"name":"A la d\u00e9couverte de Jette","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.itineraires.be\/event-details\/a-la-decouverte-de-jette","email":"info@itineraires.be","phone_contact":null,"phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700001307"},"cn":{"name":"A la d\u00e9couverte de Jette","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.itineraires.be\/event-details\/a-la-decouverte-de-jette","email":"info@itineraires.be","phone_contact":null,"phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700001307"},"fr":{"name":"A la d\u00e9couverte de Jette","shortdescr":null,"longdescr":"Jette la bucolique, mais pas que\u2026 Elle est aussi ancr\u00e9e dans le tissu urbain. Cette commune a ranim\u00e9 la passion pour Magritte, le peintre surr\u00e9aliste qui y a v\u00e9cu \u00e0 sa grande \u00e9poque. Des merveilles de c\u00e9ramique jonchent ses sols, colorent les murs. Plus r\u00e9cemment, une tribu de street artistes a jet\u00e9 son d\u00e9volu sur la commune. Un sacr\u00e9 coup de jeune dans la Jette Society.\n\n\u00c0 la fin du 19\u00e8me si\u00e8cle, la cr\u00e9ation de la ligne de chemin de fer reliant Bruxelles \u00e0 Gand va donner le coup d\u2019envoi \u00e0 l\u2019urbanisation de Jette, jusque-l\u00e0 rurale. Ce d\u00e9veloppement va s\u2019acc\u00e9l\u00e9rer dans l\u2019entre-deux-guerres, produisant de belles r\u00e9alisations Art d\u00e9co. Jette est aussi la commune o\u00f9 des artistes comme Ren\u00e9 Magritte, Jef Mennekens, Fernand Crickx ou Jean Roba vont cultiver leur talent.","performers":"Jette la bucolique, mais pas que\u2026 Elle est aussi ancr\u00e9e dans le tissu urbain. Cette commune a ranim\u00e9 la passion pour Magritte, le peintre surr\u00e9aliste qui y a v\u00e9cu \u00e0 sa grande \u00e9poque. Des merveilles de c\u00e9ramique jonchent ses sols, colorent les murs.","boxoffice_url":null,"website":"https:\/\/www.itineraires.be\/event-details\/a-la-decouverte-de-jette","email":"info@itineraires.be","phone_contact":null,"phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700001307"},"sp":{"name":"A la d\u00e9couverte de Jette","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.itineraires.be\/event-details\/a-la-decouverte-de-jette","email":"info@itineraires.be","phone_contact":null,"phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700001307"},"nl":{"name":"A la d\u00e9couverte de Jette","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.itineraires.be\/event-details\/a-la-decouverte-de-jette","email":"info@itineraires.be","phone_contact":null,"phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700001307"}},"place":{"id":50001475,"translations":{"de":{"name":"Kardinaal Mercierplein, voor het treinstation","address_street_name":"Kardinaal Mercierplein, voor het treinstation","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Kardinaal Mercierplein, voor het treinstation","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Kardinaal Merci