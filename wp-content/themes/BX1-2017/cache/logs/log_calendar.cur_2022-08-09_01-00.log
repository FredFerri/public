x.net\/1d3643e9a7e109b364571c44e8bf91467c8b0de2.jpg","width":1280,"height":614,"ratio":2.08,"translations":{"fr":{"title":"L'\u00e9t\u00e9 spectaculaire - Persilette ","copyright":"Vincent Renaud"},"nl":{"title":"L'\u00e9t\u00e9 spectaculaire - Persilette ","copyright":"Vincent Renaud"},"en":{"title":"L'\u00e9t\u00e9 spectaculaire - Persilette ","copyright":"Vincent Renaud"}}}],"dates":[{"day":"2022-08-12","doors":null,"start":"11:00:00","end":null,"is_soldout":false,"is_canceled":false},{"day":"2022-08-12","doors":null,"start":"14:30:00","end":null,"is_soldout":false,"is_canceled":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[3,5,16],"translations":{"fr":["Enfants 3-6 ans","Enfants 9-12 ans","Ecoles"],"nl":["Kinderen 3-6 j.","Kinderen 9-12 j.","Scholen"],"en":["Children 3-6 yr.","Children 9-12 yr.","Schools"]}},"tags":["kids"],"accessibilities":{"list":[255],"translations":{"fr":["Accessible"],"nl":["Toegankelijk"],"en":["Accessible"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-07-25T11:05:09+02:00","published_at":"2022-07-25T10:39:32+02:00","backoffice_id":258885,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":1.2599210498949},{"id":535968,"date_start":"2022-08-12","date_end":"2022-08-13","date_next":"2022-08-12","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":84,"translations":{"fr":"Divers","nl":"Varia","en":"Various"}},"others":{}},"languages":{"spoken":["nl","fr"],"subtitles":[]},"translations":{"fr":{"name":"Micro-aventure \u00e0 v\u00e9lo","shortdescr":"Vivez une petite aventure courte et simple \u00e0 v\u00e9lo pr\u00e8s de Bruxelles. Une experience amusante et rafra\u00eechissante!","longdescr":"Bikepacker et Cactus organisent une petite aventure cycliste pr\u00e8s de chez vous ! En fin d'apr\u00e8s-midi, nous p\u00e9dalons le long d'une belle route hors de la ville vers notre lieu de camping vert \u00e0 Wolvertem. Une promenade \u00e0 v\u00e9lo d'environ 25 km, une transition progressive de la ville \u00e0 la campagne.\r\n\r\nUne fois arriv\u00e9s, nous installons notre tente et pr\u00e9parons le d\u00eener ensemble. Apr\u00e8s le petit-d\u00e9jeuner, \u00e0 l'aube, nous prenons nos v\u00e9los et retournons \u00e0 Bruxelles. Une petite aventure cycliste pr\u00e8s de chez vous!\r\n\r\nVous n'avez pas le bon \u00e9quipement ? Contactez nous et nous verrons si nous pouvons vous fournir un v\u00e9lo, des sacoches, un matelas ou une tente.\r\n\r\nRendez-vous le 12 ao\u00fbt \u00e0 16h au Grand Hospice. Retour le 13 ao\u00fbt vers 10h","performers":null,"boxoffice_url":null,"website":null,"email":"info@cactus.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.535968"},"nl":{"name":"Microavontuur met de fiets","shortdescr":"Beleef een kort en eenvoudig avontuur met de fiets dicht bij Brussel. Een leuke en verkwikkende ervaring!","longdescr":"Bikepacker en Cactus organiseren een klein fietsavontuur dicht bij huis! In de late namiddag fietsen we langs een mooie route de stad uit richting onze groene kampeerplek in Wolvertem. Een fietstocht van een kleine 25km, een geleidelijke transitie van de stad naar het platteland.\r\n\r\nEens aangekomen richten we onze slaapplek in en bereidden we samen het avondeten. De volgende dag, na het ontbijt nemen we bij het ochtendgloren onze fiets en trekken we terug richting Brussel. Kort en krachtig, een klein fietsavontuur dicht bij huis!\r\n\r\nHeb je niet het juiste materiaal? Contacteer ons en we bekijken of we een fiets, fietstassen, een matje of een tent kunnen regelen.\r\n\r\nAfspraak 12 augustus om 16u aan de Grand Hospice. Terug 13 augustus rond 10u","performers":null,"boxoffice_url":null,"website":"https:\/\/cactus.brussels\/fr-brussel-velo\/fr-programme-ete","email":"info@cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.535968"},"en":{"name":"Microavontuur met de fiets","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.535968"},"de":{"name":"Microavontuur met de fiets","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.535968"},"it":{"name":"Microavontuur met de fiets","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.535968"},"sp":{"name":"Microavontuur met de fiets","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.535968"},"pt":{"name":"Microavontuur met de fiets","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.535968"},"cn":{"name":"Microavontuur met de fiets","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.535968"}},"place":{"id":277608,"translations":{"fr":{"name":"Cactus Brussel \u00e0 v\u00e9lo","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"info@cactus.brussels","website":"http:\/\/www.cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 7","address_line2":"1000 Bruxelles","description_web":"Cactus Brussel \u00e0 v\u00e9lo est une association de guides b\u00e9n\u00e9voles locaux ayant \u00e0 c\u0153ur Bruxelles et le v\u00e9lo. Ils partagent avec enthousiasme leur passion pour la ville et le v\u00e9lo avec des visiteurs de Bruxelles et d\u2019autres Bruxellois. A v\u00e9lo ils trouvent le rythme id\u00e9al pour vous immerger dans la ville et ils offrent une exp\u00e9rience authentique \u00e0 Bruxelles. Avant tout, ils pr\u00e9f\u00e8rent vous guider hors des chemins battus et cela dans une ambiance conviviale. Vivez Bruxelles dans toute sa splendeur \u00e0 v\u00e9lo et d\u00e9couvrez plus que vous ne le pensez.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Cactus Brussel \u00e0 v\u00e9lo","address_street_name":"Grootgodshuisstraat","address_street_number":"7","address_street_box":null,"email":"info@cactus.brussels","website":"http:\/\/www.cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Grootgodshuisstraat, 7","address_line2":"1000 Brussel","description_web":"Cactus Brussel \u00e0 v\u00e9lo is een vereniging van lokale vrijwillige gidsen met een passie voor Brussel en de fiets. Ze delen hun passie voor de stad en het fietsen enthousiast met bezoekers van Brussel en andere Brusselaars. Op hun fietsen vinden ze het juiste tempo om u onder te dompelen in de stad en u een authentieke Brusselse ervaring te bieden. Bovenal begeleiden ze jullie graag buiten de gebaande paden in een vriendelijke sfeer. Beleef Brussel in al zijn pracht per fiets en ontdek meer dan jullie denken.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Cactus Brussel \u00e0 v\u00e9lo","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"info@cactus.brussels","website":"http:\/\/www.cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue du Grand Hospice, 7","address_line2":"1000 Brussels","description_web":"Cactus Brussel \u00e0 v\u00e9lo is an association of local volunteer guides with a passion for Brussels and cycling. They enthusiastically share their passion for the city and cycling with visitors to Brussels and other Brussels residents. On their bikes they find the right pace to immerse you in the city and offer an authentic Brussels experience. Above all, they prefer to guide you off the beaten track in a friendly atmosphere. Experience Brussels in all its splendour by bike and discover more than you think.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Cactus Brussel \u00e0 v\u00e9lo","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"info@cactus.brussels","website":"http:\/\/www.cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 7","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Cactus Brussel \u00e0 v\u00e9lo","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"info@cactus.brussels","website":"http:\/\/www.cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 7","address_line2":"1000 Bruxelles","de