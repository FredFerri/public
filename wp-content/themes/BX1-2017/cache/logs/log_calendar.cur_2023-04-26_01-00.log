:"22:15:00","is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"},"de":{"name":"Normal"},"it":{"name":"Normale"},"sp":{"name":"Normal"},"pt":{"name":"Normal"},"cn":{"name":"Normal"}},"value":15},{"translations":{"fr":{"name":"Enfants"},"nl":{"name":"Kinderen"},"en":{"name":"Children"},"de":{"name":"Kinder"},"it":{"name":"Bambini"},"sp":{"name":"Ni\u00f1os"},"pt":{"name":"Enfants"},"cn":{"name":"Enfants"}},"value":10},{"translations":{"fr":{"name":"Jeunes"},"nl":{"name":"Jongeren"},"en":{"name":"Young people"},"de":{"name":"Jugendliche"},"it":{"name":"Ragazzi"},"sp":{"name":"J\u00f3venes"},"pt":{"name":"Jeunes"},"cn":{"name":"Jeunes"}},"value":10},{"translations":{"fr":{"name":"Etudiants"},"nl":{"name":"Studenten"},"en":{"name":"Students"},"de":{"name":"Studierende"},"it":{"name":"Studenti"},"sp":{"name":"Estudiantes"},"pt":{"name":"Etudiants"},"cn":{"name":"Etudiants"}},"value":10},{"translations":{"fr":{"name":"Pr\u00e9vente"},"nl":{"name":"Voorverkoop"},"en":{"name":"Presale"},"de":{"name":"Vorverkauf"},"it":{"name":"Prevendita"},"sp":{"name":"Preventa"},"pt":{"name":"Pr\u00e9vente"},"cn":{"name":"Pr\u00e9vente"}},"value":13}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":{"list":[255,259,263,265],"translations":{"fr":["Accessible","Chien d'assistance","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9"],"nl":["Toegankelijk","Assistentiehonden","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet"],"en":["Accessible","Assistance dogs","Accessible to pedestrians with mobility aids","Adapted toilet"],"de":["Barrierefrei","Assistenzhund","Barrierefrei f\u00fcr Fu\u00dfg\u00e4nger mit Gehhilfe","Barrierefreies WC"],"it":["Accessibile","Cane guida","Accessibile ai pedoni con supporti","WC idoneo"],"sp":["Habilitado","Perros gu\u00eda","Habilitado para peatones con aud\u00edfonos","Ba\u00f1os adaptados"],"pt":[null,null,null,null],"cn":[null,null,null,null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2023-04-13T10:05:04+02:00","published_at":"2022-10-31T11:00:42+01:00","backoffice_id":264965,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":0.18517107476261},{"id":555967,"date_start":"2023-04-01","date_end":"2023-10-29","date_next":"2023-04-26","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung","it":"Esposizioni","sp":"Exhibici\u00f3n","pt":null,"cn":null}},"others":{"list":[36,46],"translations":{"fr":["Mus\u00e9es et art centers","Pluridisciplinaire"],"nl":["Musea en kunstcentra","Multidisciplinair"],"en":["Museums and art centers","Multidisciplinary"],"de":["Museen & Kunstzentren","Multidisziplin\u00e4r"],"it":["Musei e centri artistici","Multidisciplinare"],"sp":["Museos y centros de arte","Multidisciplinar"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Cross-ing Way-s","shortdescr":"CROSS-ING WAY-S -Chemin de croix de la vie. Avec l'exposition CROSS-ING WAY-S \u00e0 la basilique de Koekelberg, curateur Shantar propose une vision innovante et contemporaine du chemin de croix. Avec des \u0153uvres d'Elena Subach, Lina Van Hulle, Daniel C. Muller, Ute Resch, Klaus Verscheure, Erzs\u00e9bet Baerveldt, Nikita Kadan, Sergey Bratkov, Johan Creten.","longdescr":"La tradition du Chemin de Croix a commenc\u00e9\r\ncomme une destination de p\u00e8lerinage en\r\nJ\u00e9rusalem, partant de la pr\u00e9tendue r\u00e9sidence\r\nofficielle de Ponce Pilate vers le mont Calvaire.\r\nAu 19i\u00e8me si\u00e8cle la repr\u00e9sentation de la derni\u00e8re\r\njourn\u00e9e de J\u00e9sus sur terre en tant qu\u2019homme,\r\nconstituait une partie importante des \u00e9glises\r\ncatholiques occidentales.Certaines \u00e9glises\r\ny ont ajout\u00e9 une 15i\u00e8me station non officielle.\r\nCROSS-ING WAY-S est un voyage tr\u00e8s personnel\r\net intime. Nous d\u00e9cidons qui nous sommes.\r\nSommes-nous les spectateurs ?\r\nLa m\u00e8re qui voit son enfant en difficult\u00e9?\r\nSommes-nous Simon ou Veronica qui\r\ndonnent un coup de main ?\r\nOu sommes-nous J\u00e9sus m\u00eame ?\r\nPeu importe avec qui nous nous identifions,\r\nnous attendons tous une r\u00e9surrection;\r\nparce que nous \u00ab sommes le sel de la terre \u00bb.\r\nDenys Shantar nous offre une vision actuelle\r\nsur le Chemin de Croix et la collection du mus\u00e9e,\r\nen invitant des artistes contemporains comme\r\nElena Subach, Lina Van Hulle, Daniel C. Muller,\r\nUte Resch, Klaus Verscheure, et en entrela\u00e7ant\r\ndes pi\u00e8ces uniques des collections de MimDo\r\nIttre, de l\u2019\u00e9glise Sint-Andries Antwerpen,\r\nSint-Agatha Kloostererfgoed des Pays-Bas,\r\nde l\u2019Archive Saint-Luc Bruxelles, Transit Gallery\r\nMechelen et des collections particuli\u00e8res,\r\npour cr\u00e9er une exp\u00e9rience immersive \u00e0 travers\r\nle chagrin, la mort et l\u2019esp\u00e9rance.","performers":"Le curateur et artiste suisse-ukrainien Denys Shantar","boxoffice_url":null,"website":"https:\/\/mmrk.be\/","email":"musea@basilicakoekelberg.be","phone_contact":null,"phone_booking":"+32 2 421 16 79","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.555967"},"nl":{"name":"Cross-ing Way-s","shortdescr":"CROSS-ING WAY-S - Kruisweg van het leven. Over verdriet, dood en hoop.\r\nMet de tentoonstelling CROSS-ING WAY-S in de Basiliek van Koekelberg biedt curator Shantar een vernieuwende en hedendaagse kijk op de Kruisweg. Met werken van o.a. Elena Subach, Lina Van Hulle, Daniel C. Muller, Ute Resch, Klaus Verscheure, Erzs\u00e9bet Baerveldt, Nikita Kadan, Sergey Bratkov, Johan Creten.","longdescr":"De traditie van de Kruisweg begon als een\r\nbedevaart in Jerusalem, van de plaats waarvan\r\nwordt aangenomen dat het de ambtswoning van\r\nPontius Pilatus was tot aan de laatste statie op de\r\nCalvarieberg. In de 19e eeuw werd de laatste dag\r\nvan Jezus als mens op aarde, als een belangrijk\r\nelement in veel Westerse Katholieke kerken.\r\nIn sommige kerken werd de verrijzenis\r\ntoegevoegd, als een niet-offici\u00eble 15e statie.\r\nCROSS-ING WAY-S is een heel persoonlijke\r\nen intiem te beleven reis. We kunnen zelf\r\nbeslissen wie we zijn.\r\nZijn we toeschouwers?\r\nDe moeder die haar kind ziet worstelen?\r\nZijn we Simon of Veronica die een helpende\r\nhand toesteken?\r\nOf zijn we de lijdende Jezus zelf?\r\nHet maakt niet uit wie we kiezen te zijn,\r\nwe verwachten allen een wederopstanding;\r\nuiteindelijk zijn we \u201chet zout der aarde\u201d.\r\nDenys Shantar biedt een vernieuwende en\r\nhedendaagse kijk op de Kruisweg en op de\r\ncollectie van het museum, door hedendaagse\r\nkunstenaars als Elena Subach, Lina Van Hulle,\r\nDaniel C. Muller, Ute Resch, Klaus Verscheure uit\r\nte nodigen en hun werken te verweven met unieke\r\nstukken uit de collecties van het MimDo Ittre, de\r\nSint-Andrieskerk Antwerpen, van het Sint-Agatha\r\nKloostererfgoed Nederland, van Archief Sint-\r\nLucas Brussel, van Transit Gallery Mechelen en uit\r\nparticuliere collecties. De bezoeker wordt volledig\r\nondergedompeld in verdriet, dood en hoop.","performers":"Zwitsers-Oekra\u00efense kunstenaar en curator Denys Shantar","boxoffice_url":null,"website":"https:\/\/mmrk.be\/","email":"musea@basilicakoekelberg.be","phone_contact":null,"phone_booking":"+32 2 421 16 79","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.555967"},"en":{"name":"Cross-ing Way-s","shortdescr":"CROSS-ING WAY-S - Stations of life. About grief, death and hope.\r\nWith the exhibition CROSS-ING WAY-S at Koekelberg Basilica, artist and curator Denys Shantar offers an innovative and contemporary take on the Cross Way. Featuring works by Elena Subach, Lina Van Hulle, Daniel C. Muller, Ute Resch, Klaus Verscheure, Erzs\u00e9bet Baerveldt, Nikita Kadan, Sergey Bratkov and Johan Creten, among others.","longdescr":"The tradition of the Cross Way started as a\r\npilgrimage destination in Jerusalem, from where\r\nit is believed to have been Pontius Pilates\u2019\r\nresidence to the final stage of the Calvary.\r\nThe depiction of Jesus on his last day on earth\r\nas a human became an essential part of most\r\nWestern Catholic churches in the 19th century.\r\nSome churches add the resurrection as an\r\nunofficial 15th station.\r\nCROSS-ING WAY-S is a very personal and\r\nintimate journey. We can decide for ourselves\r\nwho we are. Are we the spectators?\r\nThe mother who sees her struggling child?\r\nAre we Simon or Veronica who lend a\r\nhelping hand?\r\nOr are we Jesus himself?\r\nNo matter who we choose to be,\r\nwe all await a resurrection; in the end\r\nwe \u201care the salt of the earth\u201d.\r\nDenys Shantar gives a fresh and current view\r\non the Cross Way and the museum\u2019s collection:\r\ninviting contemporary artists like Elena Subach,\r\nLina Van Hulle, Daniel C. Muller, Ute Resch, Klaus\r\nVerscheure, tying in unique pieces from collections\r\nof MimDo Ittre, Sint-Andrieskerk Antwerpen,\r\nSint-Agatha Kloostererfgoed The Netherlands,\r\nSint-Lucas Archive Brussels, Transit Gallery\r\nMechelen, as well as private collectors,\r\nto create an immersive experience through\r\nsorrow, death and hope.","performers":"Swiss-Ukrainian artist and curator Denys Shantar","boxoffice_url":null,"website":"https:\/\/mmrk.be\/","email":"musea@basilicakoekelberg.be","phone_contact":null,"phone_booking":"+32 2 421 16 79","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.555967"},"de":{"name":"Cross-ing Way-s","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/mmrk.be\/","email":"musea@basilicakoekelberg.be","phone_contact":null,"phone_booking":"+32 2 421 16 79","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.555967"},"it":{"name":"Cross-ing Way-s","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/mmrk.be\/","email":"musea@basilicakoekelberg.be","phone_contact":null,"phone_booking":"+32 2 421 16 79","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.555967"},"sp":{"name":"Cross-ing Way-s","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/mmrk.be\/","email":"musea@basilicakoekelberg.be","phone_contact":null,"phone_booking":"+32 2 421 16 79","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.555967"},"pt":{"name":"Cross-ing Way-s","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/mmrk.be\/","email":"musea@basilicakoekelberg.be","phone_contact":null,"phone_booking":"+32 2 421 16 79","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.555967"},"cn":{"name":"Cross-ing Way-s","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/mmrk.be\/","email":"musea@basilicakoekelberg.be","phone_contact":null,"phone_booking":"+32 2 421 16 79","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.555967"}},"place":{"id":246228,"translations":{"fr":{"name":"Mus\u00e9e d'Art religieux moderne - Basilique de Koekelberg","address_street_name":"Parvis de la Basilique","address_street_number":"1","address_street_box":null,"email":"toerisme.basilica.tourisme@busmail.net","website":"http:\/\/www.basilicakoekelberg.be","phone_contact":"+32 2 425 88 22","phone_booking":null,"address_zip":"1083","address_city":"Ganshoren","address_line1":"Parvis de la Basilique, 1","address_line2":"1083 Gans