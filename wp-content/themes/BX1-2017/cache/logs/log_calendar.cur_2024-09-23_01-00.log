go":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":223612,"facebook_link":null,"import_origin":"bronks","is_part_of":null,"sub_type":"other","ranking":0.11060765558158418,"languages":{"spoken":["nl","fr"],"subtitles":[]},"categories":{"main":{"id":49,"translations":{"de":"Theater","pt":null,"en":"Theatre","it":"Teatro","cn":null,"fr":"Th\u00e9\u00e2tre","sp":"Teatro","nl":"Theater"}},"others":{"list":[50],"translations":{"de":["Theater"],"pt":[null],"en":["Theatre"],"it":["Teatro"],"cn":[null],"fr":["Th\u00e9\u00e2tre"],"sp":["Teatro"],"nl":["Theater"]}}},"translations":{"de":{"name":"The happy few","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.bronks.be","email":"info@bronks.be","phone_contact":null,"phone_booking":"+32 2 219 99 21","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.503612"},"pt":{"name":"The happy few","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.bronks.be","email":"info@bronks.be","phone_contact":null,"phone_booking":"+32 2 219 99 21","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.503612"},"en":{"name":"The happy few","shortdescr":null,"longdescr":"Are they fake news or the new fakes?  \n \nNowadays, everyone seems to be a politician, academic, consumer, producer, activist, nihilist, capitalist, terrorist, racist, journalist, and idealist all at the same time! \n \nIn The happy few five players deploy everything around them to sculpt their own\u00a0transformation into an ultimate offer. For humanity, for future generations, and for those who don\u2019t have the luxury of choosing between the harsh reality and an Instagram fairy tale. Are they stand-up comedians? Martyrs? Snobby wannabes? Are they superhuman dance virtuosos or insane pamphleteers who want to prick your conscience until you crawl into a corner out of sheer freight. Yet does it really matter?","performers":null,"boxoffice_url":null,"website":"http:\/\/www.bronks.be","email":"info@bronks.be","phone_contact":null,"phone_booking":"+32 2 219 99 21","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.503612"},"it":{"name":"The happy few","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.bronks.be","email":"info@bronks.be","phone_contact":null,"phone_booking":"+32 2 219 99 21","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.503612"},"cn":{"name":"The happy few","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.bronks.be","email":"info@bronks.be","phone_contact":null,"phone_booking":"+32 2 219 99 21","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.503612"},"fr":{"name":"The happy few","shortdescr":null,"longdescr":"Are they fake news or are they the new fakes?  \n\n De nos jours, on dirait que tout le monde est politicien, acad\u00e9micien, consommateur, producteur, militant, nihiliste, capitaliste, terroriste, raciste, journaliste, id\u00e9aliste. Et tout \u00e7a en m\u00eame temps. \n\n \u00a0Dans The happy few cinq artistes se servent de ce qu\u2019ils ont sous la main pour fa\u00e7onner leur propre transformation et ainsi la proposer en offrande ultime. Pour l\u2019humanit\u00e9, pour les prochaines g\u00e9n\u00e9rations et pour celles et ceux qui n\u2019ont pas le loisir de choisir entre la dure r\u00e9alit\u00e9 et un joli conte sur Instagram. \n\n \u00a0S\u2019agit-il d\u2019humoristes ? De martyrs ? De pseudo snobs ? De \u00ab surhommes \u00bb, virtuoses de la danse ou de crieurs publics d\u00e9lirants qui veulent t\u2019enfoncer une conscience dans le cr\u00e2ne, jusqu\u2019\u00e0 ce que tu ailles te cacher dans les jupons de ta maman ? De toute fa\u00e7on, qu\u2019est-ce que \u00e7a peut faire ? \n\n \u00a0","performers":null,"boxoffice_url":null,"website":"http:\/\/www.bronks.be","email":"info@bronks.be","phone_contact":null,"phone_booking":"+32 2 219 99 21","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.503612"},"sp":{"name":"The happy few","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.bronks.be","email":"info@bronks.be","phone_contact":null,"phone_booking":"+32 2 219 99 21","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.503612"},"nl":{"name":"The happy few","shortdescr":null,"longdescr":"Are they fake news or are they the new fakes?  \n\n Iedereen lijkt vandaag de dag politicus, academicus, consument, producent, activist, nihilist, kapitalist, terrorist, racist, journalist, idealist. En dat allemaal tezelfdertijd. \n \nIn  The happy few  doen vijf acteurs een poging om de maakbaarheid van hun identiteit te toetsen aan de realiteit. \nWie zijn ze echt en wie willen ze zijn? \nZitten ze in een luxepositie als acteurs of hebben ze een grotere verantwoordelijkheid naar de wereld toe? \nZullen hun nobele intenties verder reiken dan de theaterzaal of blijft het bij een verwoede poging? Voor de wereld? Voor de generaties die volgen? Voor wie zoekende blijft? \n\n Zijn het stand-upcomedians? Martelaren? Snobistische wannabe\u2019s? \nZijn het bovenmenselijke dansvirtuozen of raaskallende pamflettisten die je een geweten willen schoppen tot je bang in een hoekje wegkruipt. \n \nEn maakt het allemaal iets uit?","performers":null,"boxoffice_url":null,"website":"http:\/\/www.bronks.be","email":"info@bronks.be","phone_contact":null,"phone_booking":"+32 2 219 99 21","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.503612"}},"place":{"id":243112,"translations":{"de":{"name":"BRONKS ","address_street_name":"Rue du March\u00e9 aux Porcs","address_street_number":"15-17","address_street_box":null,"email":"info@bronks.be","website":"http:\/\/www.bronks.be","phone_contact":"+32 2 219 99 21","phone_