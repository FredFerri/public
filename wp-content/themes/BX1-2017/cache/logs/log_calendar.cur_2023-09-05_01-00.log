ourquoi \u2026 \u2753\r\nC\u2019est qu\u2019elle en rec\u00e8le des \u00e9l\u00e9ments myst\u00e9rieux, la Grand-Place de Bruxelles !\r\nInvitez-vous \u00e0 percer ses secrets : \u00e9sot\u00e9risme, symbolisme, alchimie et franc-ma\u00e7onnerie oeuvreront, tels autant de fils conducteurs dans cette visite hors du commun.\r\nAvec un guide bruxellois !","performers":"Vincent Beckers, guide touristique et r\u00e9gional","boxoffice_url":null,"website":"http:\/\/www.visiteguideebruxelles.be","email":"info@visiteguideebruxelles.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.549960"},"sp":{"name":"Les Myst\u00e8res de la Grand-Place","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.visiteguideebruxelles.be","email":"info@visiteguideebruxelles.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.549960"},"nl":{"name":"Les Myst\u00e8res de la Grand-Place","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.visiteguideebruxelles.be","email":"info@visiteguideebruxelles.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.549960"}},"place":{"id":277830,"translations":{"de":{"name":"Visite Guid\u00e9e Bruxelles","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":"info@visiteguideebruxelles.be","website":"http:\/\/www.visiteguideebruxelles.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Visite Guid\u00e9e Bruxelles","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Visite Guid\u00e9e Bruxelles","address_street_name":null,"address_street_number":null,"address_street_box":null,"e