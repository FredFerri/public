rge place est faite aux auteurs, acteurs et artistes de Belgique dans ce th\u00e9\u00e2tre qui se compose de trois salles de spectacle et de deux restaurants.\r\nN\u00e9 de la passion, de la volont\u00e9 et des r\u00eaves un peu fous de deux artistes, Patricia Ide et Michel Kacenelenbogen, le Th\u00e9\u00e2tre Le Public est un lieu o\u00f9 se m\u00ealent diff\u00e9rentes familles th\u00e9\u00e2trales. Un lieu o\u00f9 s\u2019invente une relation chaleureuse entre les acteurs et les spectateurs.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Th\u00e9\u00e2tre Le Public","address_street_name":"Rue Braemt","address_street_number":"64 70","address_street_box":null,"email":"contact@theatrelepublic.be","website":"http:\/\/www.theatrelepublic.be","phone_contact":"+32 2 724 24 44","phone_booking":"+32 2 724 24 44","address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Braemt, 64 70","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Th\u00e9\u00e2tre Le Public","address_street_name":"Braemtstraat","address_street_number":"64 70","address_street_box":null,"email":"info@theatrelepublic.be","website":"http:\/\/www.theatrelepublic.be","phone_contact":"+32 2 724 24 44","phone_booking":"+32 2 724 24 44","address_zip":"1210","address_city":"Sint-Joost-Ten-Node","address_line1":"Braemtstraat, 64 70","address_line2":"1210 Sint-Joost-Ten-Node","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[22],"translations":{"de":["Osten"],"pt":[null],"en":["East"],"it":["Est"],"cn":[null],"fr":["Est"],"sp":["Este"],"nl":["Oost"]}},"neca":null,"facebook_id":null,"backoffice_id":689,"location":{"lat":50.8511915,"lon":4.37676916},"region":"bruss