ild_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"visit_profile":{"list":[321,337],"translations":{"fr":["Bande Dessin\u00e9e","Highlight"],"nl":["Stripverhaal","Highlight"],"en":["Comic strip","Highlight"],"de":["Comic","Highlight"],"it":["Fumetti","Highlight"],"sp":["C\u00f3mics","Highlight"],"pt":[null,null],"cn":[null,null]}},"tags":[],"accessibilities":{"list":[255,259,263,265],"translations":{"fr":["Accessible","Chien d'assistance","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9"],"nl":["Toegankelijk","Assistentiehonden","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet"],"en":["Accessible","Assistance dogs","Accessible to pedestrians with mobility aids","Adapted toilet"],"de":["Barrierefrei","Assistenzhund","Barrierefrei f\u00fcr Fu\u00dfg\u00e4nger mit Gehhilfe","Barrierefreies WC"],"it":["Accessibile","Cane guida","Accessibile ai pedoni con supporti","WC idoneo"],"sp":["Habilitado","Perros gu\u00eda","Habilitado para peatones con aud\u00edfonos","Ba\u00f1os adaptados"],"pt":[null,null,null,null],"cn":[null,null,null,null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2023-03-07T12:35:03+01:00","published_at":"2023-02-02T16:33:52+01:00","backoffice_id":270868,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.40891656919768},{"id":552585,"date_start":"2023-03-24","date_end":"2023-05-06","date_next":"2023-03-24","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung","it":"Esposizioni","sp":"Exhibici\u00f3n","pt":null,"cn":null}},"others":{"list":[24,30],"translations":{"fr":["Galeries d'art","Peinture"],"nl":["Galeries","Schilderkunst"],"en":["Art Galleries","Painting"],"de":["Kunstgalerien","Malerei"],"it":["Gallerie d'arte","Pittura"],"sp":["Galer\u00edas de arte","Pintura"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Jean Pierre M\u00fcller : Sspeechless","shortdescr":null,"longdescr":"Ce qui caract\u00e9rise Jean Pierre M\u00fcller, qui pourtant s\u2019\u00e9crit sans tiret, c\u2019est le trait d\u2019union, dit Bertrand Burgalat. Dans son rapport unique entre la musique et les arts plastiques, avec Aim\u00e9 Mpane, \u00e0 l'AfricaMuseum de Tervuren, ou lors de son travail p\u00e9dagogique \u00e0 La Cambre, il y a dans toute son \u0153uvre une volont\u00e9 de rapprocher litt\u00e9ralement les formes et les \u00eatres. Ses collaborations avec Sean O\u2019Hagan, Nile Rodgers, Archie Shepp, et les peintures sonores de la s\u00e9rie 7x7, en t\u00e9moignent.\" La pratique de Jean Pierre M\u00fcller, bruxellois de naissance, est travers\u00e9e par de multiples univers, celui de la musique, de la mythologie et de la culture urbaine. Pr\u00e9occup\u00e9 essentiellement par l'activit\u00e9 de l'homme, son travail color\u00e9 est tout autant rythm\u00e9 et son esth\u00e9tique se manifeste volontiers dans la surcharge, le d\u00e9bordement et l\u2019accumulation. Certains critiques le rapprochent des peintres fauves braban\u00e7ons. Alors que son \u0153uvre est rarement autobiographique, on d\u00e9tecte cependant, qu'elle s'ouvre aujourd'hui sur un regard infiniment intime, reflet d'un combat qui trouve son origine au plus profond de lui.","performers":"Jean Pierre M\u00fcller","boxoffice_url":null,"website":"http:\/\/www.zedes-art-gallery.be","email":"zedes.art.gallery@gmail.com","phone_contact":"+32 2 646 00 04","phone_booking":"+32 2 646 00 04","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.552585"},"nl":{"name":"Jean Pierre M\u00fcller : Sspeechless","shortdescr":null,"longdescr":"Wat kenmerkt Jean Pierre M\u00fcller, die zonder een streepje geschreven is, is precies het koppelteken. In zijn relatie tussen muziek en kunst, met Aim\u00e9 Mpane, in het AfricaMuseum in Tervueren, of tijdens zijn pedagogische missie in La Cambre, is er in al zijn werk een verlangen om vormen en wezens letterlijk samen te brengen. Zijn samenwerkingen met Sean O'Hagan, Archie Shepp, Nile Rodgers en de geluidsschilderijen van de 7x7-serie getuigen hiervan. De praktijk van Jean Pierre M\u00fcller, geboren in Brussel, wordt doorkruist met meerdere universums, die van muziek, mythologie en \"urban culture\". Eerst in beslag genomen door menselijke activiteit, zijn kleurrijke en ritmische werk manifesteert zich gewillig in de overbelasting, de overloop en accumulatie. Sommige critici brengen hem dichter bij de Brabantse fauvistische schilders. Terwijl zijn werk zelden autobiografisch is, merken we echter op dat het vandaag met een oneindig intiem blik geopend is, een soort weerspiegeling van een strijd die diep in hem ontstaan heeft.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.zedes-art-gallery.be","email":"zedes.art.gallery@gmail.com","phone_contact":"+32 2 646 00 04","phone_booking":"+32 2 646 00 04","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.552585"},"en":{"name":"Jean Pierre M\u00fcller : Sspeechless","shortdescr":null,"longdescr":"What characterizes Jean Pierre M\u00fcller, who is written without a hyphen, is precisely the hyphen. In his relationship between music and art with Aim\u00e9 Mpane, in the AfricaMuseum in Tervueren, or during his pedogogical mission in La Cambre, there is in all his work a desire to literally bring together forms and beings. His collaborations with Sean O'hagan, Archie Shepp, Nile Rodgers and the sound paintings of 7x7-series, bear witness to this. Born in Brussels, Jean Pierre M\u00fcller's practice is intersected with multiple universes,those of music, mythology and \"Urban Culture\".Initialy preoccupied with human activity, his colorful and rythmic work willingly manifests itself in overload, overflow and accumulation.Some critics bring him closer to the Brabant Fauvist painters. While his work is rarely auto biographical, we note  however that today it opens with an infinitely intimate gaze, a kind of reflection of a  struggle that has arisen deep within him.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.zedes-art-gallery.be","email":"zedes.art.gallery@gmail.com","phone_contact":"+32 2 646 00 04","phone_booking":"+32 2 646 00 04","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.552585"},"de":{"name":"Jean Pierre M\u00fcller","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.zedes-art-gallery.be","email":"zedes.art.gallery@gmail.com","phone_contact":"+32 2 646 00 04","phone_booking":"+32 2 646 00 04","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.552585"},"it":{"name":"Jean Pierre M\u00fcller","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.zedes-art-gallery.be","email":"zedes.art.gallery@gmail.com","phone_contact":"+32 2 646 00 04","phone_booking":"+32 2 646 00 04","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.552585"},"sp":{"name":"Jean Pierre M\u00fcller","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.zedes-art-gallery.be","email":"zedes.art.gallery@gmail.com","phone_contact":"+32 2 646 00 04","phone_booking":"+32 2 646 00 04","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.552585"},"pt":{"name":"Jean Pierre M\u00fcller","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.zedes-art-gallery.be","email":"zedes.art.gallery@gmail.com","phone_contact":"+32 2 646 00 04","phone_booking":"+32 2 646 00 04","agenda_url":"https:\/\/v