s_zip":"1080","address_city":"Sint-Jans-Molenbeek","address_line1":"Mariemontkaai, 57","address_line2":"1080 Sint-Jans-Molenbeek","description_web":"L'Abeille Blanche is een inclusieve vzw gevestigd in de artistieke wijk van Molenbeek. Het is een ruimte voor artistieke ontmoetingen die het universum van beeldend kunstenaars uit alle disciplines met elkaar verbindt. Het omvat kunstenaarsateliers die open zijn voor het publiek, artistieke workshops, een tattooshop en een kunstgalerie.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"L\u2019Abeille Blanche ASBL","address_street_name":"Quai de Mariemont","address_street_number":"57","address_street_box":null,"email":"l.abeille.blanche@gmail.com","website":"http:\/\/www.labeilleblanche.com","phone_contact":"+32 478 03 30 70","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Quai de Mariemont, 57","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"L'Abeille Blanche is an inclusive non-profit organization located in the artistic district of Molenbeek. It is a space for artistic encounters linking the universe of visual artists from all disciplines. It includes artists' studios open to the public, artistic workshops, a tattoo parlor and an art gallery.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"L\u2019Abeille Blanche ASBL","address_street_name":"Quai de Mariemont","address_street_number":"57","address_street_box":null,"email":"l.abeille.blanche@gmail.com","website":"http:\/\/www.labeilleblanche.com","phone_contact":"+32 478 03 30 70","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Quai de Mariemont, 57","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"L\u2019Abeille Blanche ASBL","address_street_name":"Quai 