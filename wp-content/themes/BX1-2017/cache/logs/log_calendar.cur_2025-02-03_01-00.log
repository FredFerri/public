ooking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700005204"},"pt":{"name":"Thelonious Monk, sculpteur de silence","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lavenerie.be\/programme\/thelonious-monk-sculpteur-de-silence\/","email":null,"phone_contact":"+32 2 663 85 50","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700005204"},"en":{"name":"Thelonious Monk, sculpteur de silence","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lavenerie.be\/programme\/thelonious-monk-sculpteur-de-silence\/","email":null,"phone_contact":"+32 2 663 85 50","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700005204"},"it":{"name":"Thelonious Monk, sculpteur de silence","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lavenerie.be\/programme\/thelonious-monk-sculpteur-de-silence\/","email":null,"phone_contact":"+32 2 663 85 50","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700005204"},"cn":{"name":"Thelonious Monk, sculpteur de silence","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lavenerie.be\/programme\/thelonious-monk-sculpteur-de-silence\/","email":null,"phone_contact":"+32 2 663 85 50","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700005204"},"fr":{"name":"Thelonious Monk, sculpteur de silence","shortdescr":"\u00c9ric D\u2019Agostino donne, pour la premi\u00e8re fois, la parole \u00e0 la star v\u00e9n\u00e9r\u00e9e aujourd\u2019hui par toustes les musicienn\u00b7es de jazz : Thelonious Monk, le pianiste qui n\u2019a jamais parl\u00e9, celui qui s\u2019est r\u00e9fugi\u00e9 dans les silences de sa musique. Le spectacle raconte les difficult\u00e9s pour un artiste hors norme de vivre dans un monde hostile \u00e0 la folie et \u00e0 la diff\u00e9rence.","longdescr":"Mise en sc\u00e8ne par Guy Theunissen, cette parole imaginaire de Monk dialogue avec sa musique, ses compositions bouffonnes, fantasques, tordues, taquines. Le tout r\u00e9arrang\u00e9 par un quartet passionn\u00e9 de l\u2019artiste. Contrebasse, guitare, saxophone et\u2026 Batterie ! Pas de piano. Une fa\u00e7on pour les musiciens de s\u2019emparer humblement de l\u2019univers de Monk, avec leur sensibilit\u00e9 et leur inventivit\u00e9. C\u2019est \u00e7a, le jazz !\n\n\u201c(\u2026) J\u2019\u00e9cris mon propre chemin et mon chemin est courbe, je tournoie, je circonvolutionne, je danse et je ris mais je ris, \u00e0 piano d\u00e9ploy\u00e9. Je d\u00e9lire, j\u2019angoisse et me r\u00e9fugie entre les touches blanches et noires de mon clavier. Monk bipolaire, f\u00eal\u00e9, tar\u00e9 ? C\u2019est moi. Je m\u2019appelle Monk, Thelonious Monk\u2026 Je suis pianiste de bar et si je n\u2019avais pas rencontr\u00e9 le jazz, je serais devenu clochard.\u201c (Eric D'Agostino) \n\n\n\n\n\n\nUn spectacle d\u2019\u00c9ric D\u2019Agostino, coproduit par La Maison \u00c9ph\u00e9m\u00e8re et Le Grand Miroir.\n\nEn partenariat avec Septem, avec le soutien de la F\u00e9d\u00e9ration Wallonie-Bruxelles, de la Wallonie et du Brabant wallon.\n\nDans le cadre des Rencontres Images Mentales. \n","performers":" Eric D\u2019Agostino (Conception et direction artistique) ;  Eric D\u2019Agostino (Texte et Contrebasse) ; Paolo Loveri (Guitare) ; Michel Mainil ou Pierre Vaiana (Saxophone) ; Patrick Wante (Batterie) ","boxoffice_url":null,"website":"https:\/\/www.lavenerie.be\/programme\/thelonious-monk-sculpteur-de-silence\/","email":null,"phone_contact":"+32 2 663 85 50","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700005204"},"sp":{"name":"Thelonious Monk, sculpteur de silence","shortdescr":null,"longdescr":null,"per