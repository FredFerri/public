ns":{"fr":["LGTBQIA"],"nl":["LGTBQIA"],"en":["LGTBQIA"],"de":["LGTBQIA"],"it":["LGTBQIA"],"sp":["LGTBQIA"],"pt":[null],"cn":[null]}},"visit_profile":{"list":[324],"translations":{"fr":["Culture urbaine"],"nl":["Stadscultuur"],"en":["Urban culture"],"de":["Urban Culture"],"it":["Cultura urbana"],"sp":["Cultura urbana"],"pt":[null],"cn":[null]}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-07-05T11:05:27+02:00","published_at":"2023-07-05T10:55:24+02:00","backoffice_id":281257,"import_origin":null,"sub_type":"party","show_in_agenda":true,"ranking":1},{"id":556677,"date_start":"2023-05-20","date_end":"2023-09-10","date_next":"2023-07-29","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen","it":"Visite guidate","sp":"Visitas guiadas","pt":null,"cn":null}},"others":{"list":[109],"translations":{"fr":["Espaces verts"],"nl":["Groene zones"],"en":["Green spaces"],"de":["Gr\u00fcnfl\u00e4chen"],"it":["Spazi verdi"],"sp":["Espacios verdes:"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Rencontres bruxelloises","shortdescr":"Une apr\u00e8s-midi conviviale \u00e0 v\u00e9lo \u00e0 la rencontre des acteurs et porteurs de projets consacr\u00e9s \u00e0 la pr\u00e9servation et au respect de l\u2019environnement ? Tel est le concept des \u00ab Rencontres bruxelloises \u00bb !","longdescr":"17\/06 \u2013 FR \u2013 Animaux en ville\r\nBruxelles, capitale de l\u2019Europe, ville de plus d\u20191 million d\u2019habitants et \u00e0 premi\u00e8re vue, peu accueillante pour la faune sauvage. Et pourtant, de nombreux animaux y vivent. Cette balade vous emm\u00e8ne \u00e0 la d\u00e9couverte de la flore et de la faune qui, domestique ou sauvage, sont omnipr\u00e9sentes en ville. \r\n20\/05 \u2013 FR \u2013 Nature en Ville\r\n\r\n29-07 \u2013 FR\/NL \u2013 Rivi\u00e8res et zones humides\r\nPiquez une t\u00eate dans le monde aquatique Bruxellois.  L\u2019iris Jaune, embl\u00e8me de la r\u00e9gion bruxelloise est une plante qui se d\u00e9veloppe principalement dans les marais et zones humides. Cela montre l\u2019importance de ces zones qui font l\u2019ADN de la r\u00e9gion. Bien que la Senne soit vout\u00e9e, de nombreuses rivi\u00e8res, \u00e9tangs, mar\u00e9cages et zones humides jalonnent encore le territoire de la r\u00e9gion. A l\u2019honneur lors de cette balade, le Moeraske. Cette zone naturelle repr\u00e9sente un refuge pour la biopersit\u00e9 et tout ceci \u00e0 quelques \u00e8tres \u00e0 peine du chemin de fer!\r\n\r\n26-08 \u2013 FR\/NL \u2013 Mon quartier durable\r\nPro Velo vous emm\u00e8ne \u00e0 la d\u00e9couverte de \u00ab votre quartier durable \u00bb !  \r\n\r\n10-09 \u2013 FR\/NL \u2013 Bruxelles Paysan\r\nD\u00e9velopper une production de nourriture bio et durable en r\u00e9gion bruxelloise ? C\u2019est la mission que rel\u00e8ve Vert d\u2019iris! Cette coop\u00e9rative \u00e0 finalit\u00e9 sociale par la cr\u00e9ation e la gestion e potager permettant de produire une nourriture vari\u00e9e qu\u2019elle redistribuiue via une fili\u00e8re courte.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.provelo.org\/events\/rencontres-bruxelloises-brusselse-ontmoetingen-2\/","email":"info@provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":"+32 2 502 73 55","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.556677"},"nl":{"name":"Brusselse Ontmoetingen","shortdescr":"Zin in een gezellige middag op de fiets en benieuwd wie de drijvend krachten zijn achter de projecten die onze planeet wat gezonder en leefbaarder willen maken? Dan is \u2018Brusselse Ontmoetingen\u2019 misschien iets voor jou!","longdescr":"29-07 \u2013 FR\/NL \u2013 Rivieren en waterrijke gebieden\r\nDuik in de wondere waterrijke wereld van Brussel.  De gele iris, embleem van het Brussels Gewest, is een plant die gedijt in moerassen en waterrijke gebieden. Dit wijst erop hoe belangrijk deze gebieden, die het DNA van het gewest vormen, zijn voor de stad. Hoewel de Zenne is dichtgeslibd, zijn er nog talloze rivieren, vijvers, moerassen en draslanden in het gewest. Wij zetten een specifiek waterrijk gebied in de kijker: het moeras van Wiels. Dit moerasgebied ontstond spontaan op een bouwwerf en is nu het voorwerp van een lange strijd voor het behoud ervan.\r\n\r\n26-08 \u2013 FR\/NL \u2013 Mon quartier durable\r\nPro Velo neemt je mee op sleeptouw door \u00ab je duurzame wijk \u00bb! \r\n\r\n10-09 \u2013 FR\/NL \u2013 Bruxelles Paysan\r\nBiologische en duurzame voeding telen in het Brussels Gewest?","performers":null,"boxoffice_url":null,"website":"https:\/\/www.provelo.org\/events\/rencontres-bruxelloises-brusselse-ontmoetingen-2\/","email":"info@provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":"+32 2 502 73 55","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.556677"},"en":{"name":"Rencontres bruxelloises","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.provelo.org\/events\/rencontres-bruxelloises-brusselse-ontmoetingen-2\/","email":"info@provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":"+32 2 502 73 55","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.556677"},"de":{"name":"Rencontres bruxelloises","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.provelo.org\/events\/rencontres-bruxelloises-brusselse-ontmoetingen-2\/","email":"info@provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":"+32 2 502 73 55","agenda_url":"htt