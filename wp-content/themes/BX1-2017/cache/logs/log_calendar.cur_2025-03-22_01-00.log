},"saturday":{"is_open":true,"hours":[{"start":"14:00:00","end":"18:00:00"}]},"sunday":{"is_open":false}},"translations":{"en":["monday, tuesday and wednesday: closed","thursday, friday and saturday: from 14:00 to 18:00","sunday: closed"],"fr":["lundi, mardi et mercredi: ferm\u00e9","jeudi, vendredi et samedi: de 14:00 \u00e0 18:00","dimanche: ferm\u00e9"],"nl":["maandag, dinsdag en woensdag: gesloten","donderdag, vrijdag en zaterdag: van 14:00 tot 18:00","zondag: gesloten"]},"date_start":"2025-03-09","date_end":"2025-04-12","is_also_by_appointment":true}],"date_exceptions":[],"closing_days":[],"child_events":[],"parent_events":[],"accessibilities":[],"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[],"opening":{"day":"2025-03-09","end":"18:00:00","start":"14:00:00","timestamp":"2025-03-09T14:00:00"}},{"id":5700005777,"date_start":"2025-02-15","date_end":"2025-04-27","date_next":"2025-03-21","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":true,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2025-03-21T12:37:40+01:00","published_at":"2025-01-23T13:20:07+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":316768,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"other","ranking":0.30285343213869,"languages":{"spoken":["nl","fr"],"subtitles":["en"]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exposici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[46,36],"translations":{"de":["Multidisziplin\u00e4r","Museen & Kunstzentren"],"pt":[null,null],"en":["Multidisciplinary","Museums and art centers"],"it":["Multidisciplinare","Musei e centri artistici"],"cn":[null,null],"fr":["Pluridisciplinaire","Mus\u00e9es et art centers"],"sp":["Multidisciplinar","Museos y centros de arte"],"nl":["Multidisciplinair","Musea en kunstcentra"]}}},"translations":{"de":{"name":"solace","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.argosarts.org\/fr\/event\/solace","email":"info@argosarts.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700005777"},"pt":{"name":"solace","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.argosarts.org\/fr\/event\/solace","email":"info@argosarts.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700005777"},"en":{"name":"solace","shortdescr":"solace is a group exhibition that delves into the ability to find comfort amidst inner and outer turmoil. It offers an intimate look at one of our most instinctual yet powerful resources\u2014a place of resilience, care and strength that sustains us in the face of collective and individual experiences of distress and anxiety.","longdescr":"The meaning of solace is personal to each, and is as diverse as the hardships we face. Through a selection of artworks from the argos collection and contributions from invited artists, the exhibition traces the varied landscapes where we seek solace, mapping our shared and solitary journeys. Rituals, family, animals, places of worship, beliefs and convictions\u2014each artwork is a window into moments of respite that help us find the courage to persevere.\n\nThough these moments of comfort may seem small, fleeting or even trivial, the exhibition seeks to unveil their radical potential. Our search for solace\u2014whether physical or metaphysical\u2014serves as a tool of resistance, not only against our innermost struggles, but also against systems of oppression and injustice. solace is an invitation to claim this inner strength we all possess, and to acknowledge its importance and impact.\n\nThe exhibition sketches a mosaic of resilience\u2014from the rituals of the Santer\u00eda religion in Cuba, to the memories of a destroyed home in Palestine\u2014channeling our own questioning, beliefs and reassurances.","performers":"exhibited artists: L\u00e1zara Rosell Albear, Alice Brygo, Emily Vey Duke and Cooper Battersby, Mekhitar Garabedian, Sohrab Hura, Neozoon, Jayce Salloum, Grace Zhang","boxoffice_url":null,"website":"https:\/\/www.argosarts.org\/event\/solace","email":"info@argosarts.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700005777"},"it":{"name":"solace","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.argosarts.org\/fr\/event\/solace","email":"info@argosarts.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700005777"},"cn":{"name":"solace","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.argosarts.org\/fr\/event\/solace","email":"info@argosarts.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700005777"},"fr":{"name":"solace","shortdescr":"L'exposition collective solace se penche sur notre capacit\u00e9 de recueillement en p\u00e9riode de crise, qu\u2019elle soit interne ou externe. Elle propose un regard intime sur l'un de nos instincts les plus puissants \u2013 cette source de r\u00e9silience, de bien \u00eatre et de force qui nous aide \u00e0 tenir face aux d\u00e9tresses collectives ou individuelles.","longdescr":"La d\u00e9finition du r\u00e9confort est personnelle \u00e0 chacun\u00b7e, et aussi diverse que les \u00e9preuves auxquelles nous devons faire face. \u00c0 travers une s\u00e9lection d'\u0153uvres de la collection d'argos et des contributions d'artistes invit\u00e9\u00b7e\u00b7s, l'exposition retrace les multiples paysages du recueillement, et cartographie les voyages, partag\u00e9s ou solitaires, qui les jalonnent. Rituels, famille, animaux, lieux de culte, croyances ou convictions : chacune des \u0153uvres s'ouvre sur des moments de r\u00e9pit qui donnent la force et le courage de pers\u00e9v\u00e9rer.\n\nSi ces moments de r\u00e9confort peuvent sembler fugaces, voire modestes ou insignifiants, l'exposition pointe vers leur potentiel radical. Notre qu\u00eate d'apaisement \u2013 qu'il soit physique ou m\u00e9taphysique \u2013 constitue un outil de r\u00e9sistance, capable d'assister nos combats les plus intimes comme d'affronter des syst\u00e8mes d'oppression et d'injustice les plus tenaces. solace est une invitation \u00e0 convoquer cette force int\u00e9rieure que nous poss\u00e9dons tous\u00b7tes, \u00e0 en mesurer l'importance et l'impact.\n\nV\u00e9ritable mosa\u00efque de r\u00e9silience, depuis des rituels cubains de la religion de Santer\u00eda au souvenirs d'une maison palestinienne d\u00e9truite, l'exposition permet \u00e0 chacun\u00b7e d\u2019interroger ses propres pr\u00e9occupations, ses propres croyances et consolations.","performers":"avec: L\u00e1zara Rosell Albear, Alice Brygo, Emily Vey Duke & Cooper Battersby, Mekhitar Garabedian, Sohrab Hura, Neozoon, Jayce Salloum, Grace Zhang","boxoffice_url":null,"website":"https:\/\/www.argosarts.org\/fr\/event\/solace","email":"info@argosarts.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700005777"},"sp":{"name":"solace","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.argosarts.org\/fr\/event\/solace","email":"info@argosarts.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700005777"},"nl":{"name":"solace","shortdescr":"solace is een groepstentoonstelling over onze zoektocht naar troost in tijden van (innerlijke) onrust. Ze biedt een intieme blik op een uiterst instinctief en krachtig toevluchtsoord \u2013 de plek waar veerkracht, zorg en sterkte ons staande houden tijdens collectieve en individuele uitdagingen.","longdescr":"De betekenis van troost is voor ieder persoonlijk en net zo divers als de beproevingen die we ondergaan. Met een selectie van films uit de argos collectie en bijdragen van uitgenodigde kunstenaars, verkent de tentoonstelling verschillende soorten landschappen van soelaas en brengt ze de gezamenlijke en eenzame reizen die worden afgelegd in kaart. Rituelen, familie, dieren, gebedshuizen, geloof en overtuigingen \u2013 elk kunstwerk is een venster op momenten van respijt die ons helpen de moed bijeen te sprokkelen om door te zetten.\n\nHoewel deze momenten van troost misschien klein, vluchtig of zelfs triviaal lijken, wijst de tentoonstelling op hun radicale potentieel. Onze zoektocht naar \u2013 fysieke of metafysische \u2013 verlichting dient als een middel tot verzet, niet alleen bij onze meest intieme worstelingen, maar ook tegenover systemen van onderdrukking en onrecht. solace is een uitnodiging om die innerlijke kracht op te eisen, om stil te staan bij het belang en de impact ervan.\n\nAls een moza\u00efek van veerkracht \u2013 van de rituelen van de Santer\u00eda in Cuba tot de herinnering aan een verwoest Palestijns huis \u2013 laat de tentoonstelling bezoekers naar hun eigen zorgen, overtuigingen en gerustellingen reiken.","performers":"met werk van: L\u00e1zara Rosell Albear, Alice Brygo, Emily Vey Duke & Cooper Battersby, Mekhitar Garabedian, Sohrab Hura, Neozoon, Jayce Salloum, Grace Zhang","boxoffice_url":null,"website":"https:\/\/www.argosarts.org\/nl\/event\/solace","email":"info@argosarts.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700005777"}},"place":{"id":228372,"translations":{"de":{"name":"ARGOS centre for audivisual arts","address_street_name":"Rue du Chantier","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Chantier, 13","address_line2":"1000 Bruxelles","description_web":"Das Kunstzentrum Argos wurde 1989 mit dem Ziel gegr\u00fcndet, audiovisuelle Kunstformen zu f\u00f6rdern. Heute gilt das Argos, das in der N\u00e4he des Kanals im Br\u00fcsseler Stadtzentrum niedergelassen ist, als Referenz f\u00fcr diese Kunstformen. Das Programm des Hauses ist vielf\u00e4ltig und reicht von audiovisuellen und visuellen Ausstellungen \u00fcber Film- und Videovorf\u00fchrungen bis hin zu Konferenzen und Perfomances.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"ARGOS centre for audivisual arts","address_street_name":"Rue du Chantier","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Chantier, 13","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"argos centre for audiovisuals arts","address_street_name":"Werfstraat","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Brussels","address_line1":"Werfstraat, 13","address_line2":"1000 Brussels","description_web":"Founded in 1989 in Brussels, argos is an institution and resource for the presentation, production, and study of critical audiovisual arts, as well as for its distribution, conservation and restoration. argos considers the audiovisual as a primary means of looking at and understanding the world in more open and integrated ways. Supporting a multiplicity of voices in society, it fosters dialogue with a broad range of institutional and non-institutional partners, both in Brussels and beyond, and seeks new ways to engage diverse audiences. \r\n\r\nargos makes exhibitions and programmes, distributes moving image works, and builds, preserves, and discloses a prominent collection of artist films and videos. It also houses a unique media library containing a broad selection of publications, as well as the audiovisual works of the collection, which is open to both professionals and the general public. Additionally, it develops original research projects relating to significant gaps in art history and its relationship to culture and society. Through these various activities, argos aims to more fully understand the past and present of audiovisual arts, as well as provide tools to collectively imagine and shape its futures.\r\n","description_print":null,"booking_url":null,"sort_order":"ARGOS, CENTRE FOR ART & MEDIA","virtual_visit":null,"visit_url":null},"it":{"name":"ARGOS centre for audivisual arts","address_street_name":"Rue du Chantier","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Chantier, 13","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"ARGOS centre for audivisual arts","address_street_name":"Rue du Chantier","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Chantier, 13","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"argos centre for audiovisuals arts","address_street_name":"Rue du Chantier","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Chantier, 13","address_line2":"1000 Bruxelles","description_web":"Fond\u00e9 en 1989 \u00e0 Bruxelles, argos est un lieu ressource pour la pr\u00e9sentation, la production et le d\u00e9veloppement des arts audiovisuels critiques, ainsi que pour leur distribution, conservation et restauration.\r\n\r\nargos consid\u00e8re l\u2019audiovisuel comme un moyen des plus pertinents pour regarder et comprendre le monde de mani\u00e8re ouverte et int\u00e9gr\u00e9e. Soutenant les voix alternatives dans la soci\u00e9t\u00e9, il favorise le dialogue avec un large \u00e9ventail de partenaires institutionnels ou non, tant \u00e0 Bruxelles qu\u2019ailleurs. argis recherche sans cesse de nouvelles fa\u00e7ons d'impliquer et d\u2019associer les publics les plus larges.\r\n\r\nargos  con\u00e7oit des expositions et programmations, distribue les \u0153uvres audiovisuelles les plus contemporaines et critiques; sa mission par ailleurs constitue, conserve et fait conna\u00eetre un tr\u00e8s important fonds de films et de vid\u00e9os d\u2019artistes. Il comporte \u00e9galement une m\u00e9diath\u00e8que unique en son genre, ouverte aux professionnels et au grand public. Celle-ci inclut une tr\u00e8s large s\u00e9lection de publications et les \u0153uvres audiovisuelles de la collection. De plus, ARGOS d\u00e9veloppe des projets de recherche in\u00e9dits pour pallier les lacunes importantes dans l'histoire de l'art, questionnant les relations entre culture et soci\u00e9t\u00e9.\r\n\r\n\u00c0 travers ces multiples activit\u00e9s, argis a pour objectif de permettre une meilleure compr\u00e9hension du pass\u00e9 et du pr\u00e9sent des arts audiovisuels tout en fournissant les outils pour imaginer et fa\u00e7onner collectivement leur avenir.","description_print":null,"booking_url":null,"sort_order":"ARGOS, CENTRE FOR ART & MEDIA","virtual_visit":null,"visit_url":null},"sp":{"name":"ARGOS centre for audivisual arts","address_street_name":"Rue du Chantier","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Chantier, 13","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"argos centre for audiovisuals arts","address_street_name":"Werfstraat","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Brussel","address_line1":"Werfstraat, 13","address_line2":"1000 Brussel","description_web":"argos werd opgericht in 1989 in Brussel en is een instituut, en bron, voor de studie, productie en vooruitgang van kritische audiovisuele kunsten, evenals de distributie, het behoud en de restauratie ervan.\r\n\r\nargos beschouwt het audiovisuele als een belangrijk middel om op meer open en ge\u00efntegreerde manieren de wereld te bekijken en te begrijpen. We ondersteunen een veelheid aan stemmen in de samenleving en gaan in dialoog met een breed scala aan institutionele en niet-institutionele partners, zowel in Brussel als daarbuiten. Zo willen we een steeds ruimer en \u200b\u200bmeer divers publiek bij onze activiteiten betrekken.\r\n\r\n\u249c\u24ad\u24a2\u24aa\u24ae maakt tentoonstellingen en programma's, distribueert audiovisuele werken en bouwt, beheert en ontsluit een prominente collectie van kunstenaarfilms en -video's. We hebben ook een unieke mediatheek met een ruime selectie van publicaties en de audiovisuele werken van de collectie, die zowel voor professionals als het algemene publiek toegankelijk is. Daarnaast ontwikkelen we originele onderzoeksprojecten met betrekking tot vooraanstaande hiaten in de kunstgeschiedenis en de relatie ervan tot cultuur en maatschappij.\r\n\r\nVia deze verschillende activiteiten wil argos het verleden en het heden van de audiovisuele kunsten beter doorgronden, en ook instrumenten bieden om collectief hun toekomst in te beelden en opnieuw vorm te geven.","description_print":null,"booking_url":null,"sort_order":"ARGOS, CENTRE FOR ART & MEDIA","virtual_visit":null,"visit_url":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":"art_center","facebook_id":null,"backoffice_id":769,"location":{"lat":50.856632,"lon":4.3496322},"region":"brussels","last_updated_at":"2025-01-27T09:40:20+01:00","published_at":"2013-10-19T01:13:47+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":228372,"translations":{"de":{"name":"ARGOS centre for audivisual arts","address_street_name":"Rue du Chantier","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Chantier, 13","address_line2":"1000 Bruxelles","description_web":"Das Kunstzentrum Argos wurde 1989 mit dem Ziel gegr\u00fcndet, audiovisuelle Kunstformen zu f\u00f6rdern. Heute gilt das Argos, das in der N\u00e4he des Kanals im Br\u00fcsseler Stadtzentrum niedergelassen ist, als Referenz f\u00fcr diese Kunstformen. Das Programm des Hauses ist vielf\u00e4ltig und reicht von audiovisuellen und visuellen Ausstellungen \u00fcber Film- und Videovorf\u00fchrungen bis hin zu Konferenzen und Perfomances.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"ARGOS centre for audivisual arts","address_street_name":"Rue du Chantier","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Chantier, 13","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"argos centre for audiovisuals arts","address_street_name":"Werfstraat","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Brussels","address_line1":"Werfstraat, 13","address_line2":"1000 Brussels","description_web":"Founded in 1989 in Brussels, argos is an institution and resource for the presentation, production, and study of critical audiovisual arts, as well as for its distribution, conservation and restoration. argos considers the audiovisual as a primary means of looking at and understanding the world in more open and integrated ways. Supporting a multiplicity of voices in society, it fosters dialogue with a broad range of institutional and non-institutional partners, both in Brussels and beyond, and seeks new ways to engage diverse audiences. \r\n\r\nargos makes exhibitions and programmes, distributes moving image works, and builds, preserves, and discloses a prominent collection of artist films and videos. It also houses a unique media library containing a broad selection of publications, as well as the audiovisual works of the collection, which is open to both professionals and the general public. Additionally, it develops original research projects relating to significant gaps in art history and its relationship to culture and society. Through these various activities, argos aims to more fully understand the past and present of audiovisual arts, as well as provide tools to collectively imagine and shape its futures.\r\n","description_print":null,"booking_url":null,"sort_order":"ARGOS, CENTRE FOR ART & MEDIA","virtual_visit":null,"visit_url":null},"it":{"name":"ARGOS centre for audivisual arts","address_street_name":"Rue du Chantier","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Chantier, 13","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"ARGOS centre for audivisual arts","address_street_name":"Rue du Chantier","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Chantier, 13","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"argos centre for audiovisuals arts","address_street_name":"Rue du Chantier","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Chantier, 13","address_line2":"1000 Bruxelles","description_web":"Fond\u00e9 en 1989 \u00e0 Bruxelles, argos est un lieu ressource pour la pr\u00e9sentation, la production et le d\u00e9veloppement des arts audiovisuels critiques, ainsi que pour leur distribution, conservation et restauration.\r\n\r\nargos consid\u00e8re l\u2019audiovisuel comme un moyen des plus pertinents pour regarder et comprendre le monde de mani\u00e8re ouverte et int\u00e9gr\u00e9e. Soutenant les voix alternatives dans la soci\u00e9t\u00e9, il favorise le dialogue avec un large \u00e9ventail de partenaires institutionnels ou non, tant \u00e0 Bruxelles qu\u2019ailleurs. argis recherche sans cesse de nouvelles fa\u00e7ons d'impliquer et d\u2019associer les publics les plus larges.\r\n\r\nargos  con\u00e7oit des expositions et programmations, distribue les \u0153uvres audiovisuelles les plus contemporaines et critiques; sa mission par ailleurs constitue, conserve et fait conna\u00eetre un tr\u00e8s important fonds de films et de vid\u00e9os d\u2019artistes. Il comporte \u00e9galement une m\u00e9diath\u00e8que unique en son genre, ouverte aux professionnels et au grand public. Celle-ci inclut une tr\u00e8s large s\u00e9lection de publications et les \u0153uvres audiovisuelles de la collection. De plus, ARGOS d\u00e9veloppe des projets de recherche in\u00e9dits pour pallier les lacunes importantes dans l'histoire de l'art, questionnant les relations entre culture et soci\u00e9t\u00e9.\r\n\r\n\u00c0 travers ces multiples activit\u00e9s, argis a pour objectif de permettre une meilleure compr\u00e9hension du pass\u00e9 et du pr\u00e9sent des arts audiovisuels tout en fournissant les outils pour imaginer et fa\u00e7onner collectivement leur avenir.","description_print":null,"booking_url":null,"sort_order":"ARGOS, CENTRE FOR ART & MEDIA","virtual_visit":null,"visit_url":null},"sp":{"name":"ARGOS centre for audivisual arts","address_street_name":"Rue du Chantier","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Chantier, 13","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"argos centre for audiovisuals arts","address_street_name":"Werfstraat","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Brussel","address_line1":"Werfstraat, 13","address_line2":"1000 Brussel","description_web":"argos werd opgericht in 1989 in Brussel en is een instituut, en bron, voor de studie, productie en vooruitgang van kritische audiovisuele kunsten, evenals de distributie, het behoud en de restauratie ervan.\r\n\r\nargos beschouwt het audiovisuele als een belangrijk middel om op meer open en ge\u00efntegreerde manieren de wereld te bekijken en te begrijpen. We ondersteunen een veelheid aan stemmen in de samenleving en gaan in dialoog met een breed scala aan institutionele en niet-institutionele partners, zowel in Brussel als daarbuiten. Zo willen we een steeds ruimer en \u200b\u200bmeer divers publiek bij onze activiteiten betrekken.\r\n\r\n\u249c\u24ad\u24a2\u24aa\u24ae maakt tentoonstellingen en programma's, distribueert audiovisuele werken en bouwt, beheert en ontsluit een prominente collectie van kunstenaarfilms en -video's. We hebben ook een unieke mediatheek met een ruime selectie van publicaties en de audiovisuele werken van de collectie, die zowel voor professionals als het algemene publiek toegankelijk is. Daarnaast ontwikkelen we originele onderzoeksprojecten met betrekking tot vooraanstaande hiaten in de kunstgeschiedenis en de relatie ervan tot cultuur en maatschappij.\r\n\r\nVia deze verschillende activiteiten wil argos het verleden en het heden van de audiovisuele kunsten beter doorgronden, en ook instrumenten bieden om collectief hun toekomst in te beelden en opnieuw vorm te geven.","description_print":null,"booking_url":null,"sort_order":"ARGOS, CENTRE FOR ART & MEDIA","virtual_visit":null,"visit_url":null}},"neca":"art_center","facebook_id":null,"region":"brussels","backoffice_id":769,"location":{"lat":50.856632,"lon":4.3496322},"last_updated_at":"2025-01-27T09:40:20+01:00","published_at":"2013-10-19T01:13:47+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/aec1070df40ab960c5b72180723db510d4dc217c.jpg","width":1600,"height":918,"ratio":1.74,"oEmbed_height":918,"oEmbed_width":1600,"translations":{"de":{"title":"solace","copyright":"Alice Brygo, Le mal des ardents (2023) \u00a9 the artist"},"pt":{"title":"solace","copyright":"Alice Brygo, Le mal des ardents (2023) \u00a9 the artist"},"en":{"title":"solace","copyright":"Alice Brygo, Le mal des ardents (2023) \u00a9 the artist"},"it":{"title":"solace","copyright":"Alice Brygo, Le mal des ardents (2023) \u00a9 the artist"},"cn":{"title":"solace","copyright":"Alice Brygo, Le mal des ardents (2023) \u00a9 the artist"},"fr":{"title":"solace","copyright":"Alice Brygo, Le mal des ardents (2023) \u00a9 the artist"},"sp":{"title":"solace","copyright":"Alice Brygo, Le mal des ardents (2023) \u00a9 the artist"},"nl":{"title":"solace","copyright":"Alice Brygo, Le mal des ardents (2023) \u00a9 the artist"}}}],"dates":[{"day":"2025-02-15","