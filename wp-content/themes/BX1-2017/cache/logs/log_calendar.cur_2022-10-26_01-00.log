ains\"","copyright":null},"nl":{"title":"Expo \"Royals & Trains\"","copyright":null},"en":{"title":"Expo \"Royals & Trains\"","copyright":null}}},{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/e281694679686d73201a637a536c9ad81e61e423.jpg","width":5504,"height":8256,"ratio":0.67,"translations":{"fr":{"title":"Expo \"Royals & Trains\"","copyright":"\u00a9 SNCB | Train World Heritage| Georges De Kinder"},"nl":{"title":"Expo \"Royals & Trains\"","copyright":"\u00a9 SNCB | Train World Heritage| Georges De Kinder"},"en":{"title":"Expo \"Royals & Trains\"","copyright":"\u00a9 SNCB | Train World Heritage| Georges De Kinder"}}},{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/6a49cb47b17e68ca4b46ae0a53a8485db8e59224.jpg","width":8256,"height":5504,"ratio":1.5,"translations":{"fr":{"title":"Expo \"Royals & Trains\"","copyright":"\u00a9 SNCB | Train World Heritage| Georges De Kinder"},"nl":{"title":"Expo \"Royals & Trains\"","copyright":"\u00a9 SNCB | Train World Heritage| Georges De Kinder"},"en":{"title":"Expo \"Royals & Trains\"","copyright":"\u00a9 SNCB | Train World Heritage| Georges De Kinder"}}},{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/edb310166e977067947ed0db5d9a1f58651e751e.jpg","width":8688,"height":5792,"ratio":1.5,"translations":{"fr":{"title":"Expo \"Royals & Trains\"","copyright":"\u00a9 SNCB | Train World Heritage| Georges De Kinder"},"nl":{"title":"Expo \"Royals & Trains\"","copyright":"\u00a9 SNCB | Train World Heritage| Georges De Kinder"},"en":{"title":"Expo \"Royals & Trains\"","copyright":"\u00a9 SNCB | Train World Heritage| Georges De Kinder"}}}],"dates":[{"day":"2022-05-10","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2022-05-11","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2022-05-12","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2022-05-13","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2022-05-14","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2022-0