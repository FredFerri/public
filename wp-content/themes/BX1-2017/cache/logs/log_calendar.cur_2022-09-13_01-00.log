translations":{"fr":{"name":"Cat\u00e9gorie 1"},"nl":{"name":"Categorie 1"},"en":{"name":"Category 1"}},"value":30}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":["exterior"],"is_part_of":"V\u00e9lo tourisme","accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-09-11T01:09:29+02:00","published_at":"2022-03-07T12:53:27+01:00","backoffice_id":244206,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.1838194128904},{"id":539378,"date_start":"2022-09-03","date_end":"2023-08-31","date_next":"2022-09-17","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{"list":[112],"translations":{"fr":["Insolite"],"nl":["Ongewoon"],"en":["Unusual"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Balade Cont\u00e9e : Bruxelles en Histoires et en L\u00e9gendes","shortdescr":"Entrez dans Bruxelles par la porte des l\u00e9gendes urbaines (r\u00e9elles ou invent\u00e9es)\u2026","longdescr":"Bruxelles n\u2019est pas souvent une ville d\u00e9di\u00e9e \u00e0 la r\u00eaverie.  Baudelaire estimait que le relief de la ville emp\u00eachait la fl\u00e2nerie. Tentons de lui donner tort \u00e0 travers cette visite.\r\n\r\nDes l\u00e9gendes bruxelloises ont \u00e9t\u00e9 transmises jusqu\u2019\u00e0 aujourd\u2019hui. Vraies, possibles ou erron\u00e9es, elles s\u2019ancrent n\u00e9anmoins toutes dans l\u2019histoire de la ville. \r\n\r\nNous vous ferons entrer dans la ville et son Histoire par la porte de ses l\u00e9gendes urbaines et anecdotes qui s\u2019y racontent depuis des si\u00e8cles. Entre l\u2019embl\u00e9matique Grand Place, point de d\u00e9part de la visite, et des lieux moins fr\u00e9quent\u00e9s comme le canal, Molenbeek et Sainctelette, suivez le fil de plusieurs histoires, vraies ou imagin\u00e9es, qui ont travers\u00e9 l\u2019imaginaire des bruxellois au fil des \u00e2ges.\r\n\r\nAu fil de cette balade, vous allez d\u00e9couvrir entre autres:\r\n\u2013 La statue de T\u2019Serclaes ;\r\n\u2013 La culasse du juge Herkendael ;\r\n\u2013 Le cracheur de la rue des Pierres\r\n\u2013 La petite cr\u00e9mi\u00e8re de Saint-Nicolas\r\n\u2013 La l\u00e9gende d\u2019Uilenspiegel\r\n\u2013 L\u2019histoire du chien marin\r\n\u2013 La rue du cygne ;\r\n\u2013 Le monument \u00e0 la gloire des Pigeons ;\r\n\u2013 Le Vaartkapoen ;\r\n\u2013 Et d\u2019autres histoires et anecdotes\u2026\r\n\r\nINFORMATIONS PRATIQUES\r\nTours r\u00e9guliers en fran\u00e7ais :\r\nPrix  : 17,00 \u20ac \/ 14,00 \u20ac tarif r\u00e9duit (\u00e9tudiant, ch\u00f4meur)\r\nDur\u00e9e : Environ 2 heures\r\nGroupe maximum : +\/- 25 personnes\r\nRendez-vous : Devant l\u2019entr\u00e9e de l\u2019H\u00f4tel Amigo\r\nRue de l\u2019Amigo, 1000 Bruxelles\r\nFin du tour : Place Sainctelette\r\n\r\nTour priv\u00e9 sur demande en fran\u00e7ais ou en anglais : info@brusselsbyfoot.com","performers":"Une balade cont\u00e9e originale de Brussels By Foot","boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/balade-contee-bruxelles-en-histoires-et-en-legendes\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.539378"},"nl":{"name":"Balade Cont\u00e9e : Bruxelles en Histoires et en L\u00e9gendes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.539378"},"en":{"name":"Balade Cont\u00e9e : Bruxelles en Histoires et en L\u