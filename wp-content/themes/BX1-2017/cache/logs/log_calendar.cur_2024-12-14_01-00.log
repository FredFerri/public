il":"project@minibusmusic.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700003610"},"it":{"name":"Say No! Ode to Frederic Rzewski","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/sayno.be\/fr","email":"project@minibusmusic.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700003610"},"cn":{"name":"Say No! Ode to Frederic Rzewski","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/sayno.be\/fr","email":"project@minibusmusic.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700003610"},"fr":{"name":"Say No! Ode to Frederic Rzewski","shortdescr":"Soir\u00e9e concert autour de la r\u00e9sistance \u00e0 la guerre comme une ode au compositeur Frederic Rzewski.","longdescr":"L'appel pour une soci\u00e9t\u00e9 plus belle r\u00e9sonne dans de nombreuses langues, \u00e9poques et cultures. \n\nLe 14 d\u00e9cembre, lors de la soir\u00e9e de concert Ode to Frederic Rzewski, ce message r\u00e9sonne \u00e9galement dans notre commune sous forme de musique et de po\u00e9sie. En m\u00eame temps, on rend hommage au c\u00e9l\u00e8bre compositeur Frederic Rzewski, qui passait son temps tr\u00e8s r\u00e9guli\u00e8rement \u00e0 Forest.\n\nProgramme :\n- Songs of Insurrection reprend des chants de r\u00e9sistance c\u00e9l\u00e8bres - interpr\u00e9t\u00e9 par le pianiste Daan Vandewalle\n- Ode to the Deserter s'appuie sur des textes sur l'objection de conscience - interpr\u00e9t\u00e9 par le Broder koor et le Choeur de Chambre du Conservatoire Royal de Li\u00e8ge\n- A Mensch, ode de Walter hus \u00e0 son ami Rzewski - interpr\u00e9t\u00e9 par le Zenne Quartet \n\nNous vous accueillons \u00e0 partir de 19h30 dans la magnifique salle des mariages de l'h\u00f4tel communal r\u00e9cemment r\u00e9nov\u00e9 ! \n","performers":"Chorale Broder, chorale de Chambre du Conservatoire Royal de Li\u00e8ge, Liza Dedapper, C\u00e9line Debacquer, Joris Stroobants et Kobe Baeyens en tant que solistes sous Peter Spaepen en Cyril Englebert\nDaan Vandewalle\nZenne Quartet","boxoffice_url":null,"website":"https:\/\/sayno.be\/fr","email":"project@minibusmusic.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700003610"},"sp":{"name":"Say No! Ode to Frederic Rzewski","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/sayno.be\/fr","email":"project@minibusmusic.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700003610"},"nl":{"name":"Say No! Ode to Frederic Rzewski","shortdescr":"Concertavond rond verzet tegen oorlog als ode aan de componist Frederic Rzewski. ","longdescr":"De roep om een mooiere samenleving weerklinkt in vele talen, tijden en culturen. \n\nDe concertavond Ode to Frederic Rzewski brengt die boodschap op zaterdag 14 december naar Vorst in de vorm van muziek en po\u00ebzie. Tegelijkertijd brengt het een ode aan de bekende componist Frederic Rzewski, die heel regelmatig in onze gemeente vertoefde.\n\nProgramma:\n- Ode to the Deserter vertrekt van teksten over dienstweigering - uitgevoerd door het Broder koor en het Choeur de Chambre du Conservatoire Royal de Li\u00e8ge\n- Songs of Insurrection heeft bekende verzetsliederen als basis - uitgevoerd door pianist Daan Vandewalle\n- A Mensch, een ode van Walter hus aan zijn vriend Rzewski - uitgevoerd door het Zenne Quartet \n\nWe verwelkomen je vanaf 19.30 u in de prachtige trouwzaal van het pas gerenoveerde gemeentehuis!\n","performers":"Broder koor, chorale de Chambre du Conservatoire Royal de Li\u00e8ge, Liza Dedapper, C\u00e9line Debacquer, Joris Stroobants en Kobe Baeyens als solisten olv Peter Spaepen en Cyril Englebert\nDaan Vandewalle\nZenne Quartet","boxoffice_url":null,"website":"https:\/\/sayno.be\/","email":"project@minibusmusic.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700003610"}},"place":{"id":50002635,"translations":{"de":{"name":"Maison Communal","address_street_name":"Rue du Cur\u00e9","address_street_number":"2","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Rue du Cur\u00e9, 2","address_line2":"1190 Forest","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Maison Communal","address_street_name":"Rue du Cur\u00e9","address_street_number":"2","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Rue du Cur\u00e9, 2","address_line2":"1190 Forest","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Gemeentehuis Vorst","address_street_name":"Pastoorsstraat","address_street_number":"2","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Pastoorsstraat, 2","address_line2":"1190 Forest","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Maison Communal","address_street_name":"Rue du Cur\u00e9","address_street_number":"2","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Rue du Cur\u00e9, 2","address_line2":"1190 Forest","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":n