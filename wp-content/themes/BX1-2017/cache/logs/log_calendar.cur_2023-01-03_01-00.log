":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":{"list":[255,265,266],"translations":{"fr":["Accessible","WC adapt\u00e9","Brussels Health Safety Label"],"nl":["Toegankelijk","Aangepast toilet","Brussels Health Safety Label"],"en":["Accessible","Adapted toilet","Brussels Health Safety Label"],"de":["Barrierefrei","Barrierefreies WC","Brussels Health Safety Label"],"it":[null,null,null],"sp":[null,null,null],"pt":[null,null,null],"cn":[null,null,null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-12-30T01:09:29+01:00","published_at":"2022-08-01T15:59:28+02:00","backoffice_id":259148,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":0.21402603672367},{"id":540016,"date_start":"2022-09-01","date_end":"2023-06-29","date_next":"2023-01-05","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":true,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":74,"translations":{"fr":"Sport","nl":"Sport","en":"Sport","de":"Sport","it":null,"sp":null,"pt":null,"cn":null}},"others":{"list":[159,164],"translations":{"fr":["Activit\u00e9 sportive","Fitness, gymnastique, danse et sports de combats"],"nl":["Sportieve activiteit","Fitness, gymnastiek, dans en vechtsport"],"en":["Sporting activity","Fitness, gymnastics, dance and combat sports"],"de":["Sportliche Aktivit\u00e4t","Fitness, Gymnastik, Tanz & Kampfsportarten"],"it":[null,null],"sp":[null,null],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","en"],"subtitles":[]},"translations":{"fr":{"name":"Zumba\u00ae dancing","shortdescr":"Zumba\u00ae pour adultes & ados tr\u00e8s dansante et dynamique! Tubes latino, populaires et du monde entier. Plus qu'une simple remise en forme, une heure de Zumba vous apportera le sourire m\u00eame si le stress ou les nuages ont envahi votre journ\u00e9e... Avec notre \u00e9quipe, l'ambiance est assur\u00e9e \u00e0 chaque cours :)","longdescr":"- Les jeudis 19h00-20h00\r\n- Inscription en avance obligatoire svp (1 ou plusieurs dates): info@danceandzumbafun.com t\u00e9l: 0484\/661 000 \r\n- Chez nous il n'y a pas des frais d'inscription ou membre comme dans les structures de sport\/gyms\/clubs: on peut toujours payer par cours; tr\u00e8s pratique pour un court s\u00e9jour \u00e0 Bruxelles! Vous pouvez commencer quand on veut pendant l'ann\u00e9e, et venir uniquement 1 fois. \r\nSi vous restez plus longtemps, optez pour une carte de 5 cours \u00e0 50 euros ou 10 cours \u00e0 90 euros. Vous pouvez aussi utiliser votre carte pour nos cours a Etterbeek, Bruxelles (metro Schuman\/Merode) pour zumba lundi, mardi, mercredi, dimanche.\r\n- M\u00e9lange sympathique des belges et expatri\u00e9s dans nos cours, sympathique pour trouver des co-patriotes et de s'approcher aux belges qui vivent ici :) et ne pas seulement rester \"tourist(e)\".\r\n- Ne restez pas isol\u00e9(e) dans votre chambre d'h\u00f4tel le soir\/week-end: venez passer un bon moment en groupe! Chez nous une ambiance amusante, d\u00e9contract\u00e9z, non-comp\u00e9titive et accueillant pour des nouvelles personnes.\r\n- Nous avons aussi des cours de zumba lundi, mardi, mercredi et dimanche et un cours d'abdos-fessiers-bras les dimanches \u00e0 Etterbeek, Bruxelles.\r\n- Stages de danse; une opportunit\u00e9 d'apprendre par des professeurs sp\u00e9cialis\u00e9s d'ici. Example: Salsa et Bachata lady-styling, Bollywood, Danse orientale... info ici:\r\nhttps:\/\/www.danceandzumbafun.com\/stages-de-danse.html\r\n- Salles spacieuses et facile \u00e0 ventiler.\r\n- Site web: www.danceandzumbafun.com\r\nBienvenue \u00e0 nous joindre! Sofie","performers":null,"boxoffice_url":null,"website":"http:\/\/www.danceandzumbafun.com","email":"info@danceandzumbafun.com","phone_contact":"+32 484 66 10 00","phone_booking":"+32 484 66 10 00","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.540016"},"nl":{"name":"Zumba\u00ae dancing","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"info@danceandzumbafun.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.540016"},"en":{"name":"Zumba\u00ae dancing","shortdescr":"Zumba\u00ae for adults & teens very danceable and dynamic! Latin songs, popular hits and music from all over the world. More than just getting back in shape, an hour of Zumba will bring you a smile even if stress or clouds have invaded your day... With our team, the atmosphere is assured in each class :)","longdescr":"- Thursdays 19h00-20h00\r\n- Advance registration required please (1 or several dates): info@danceandzumbafun.com tel: 0484\/661 000\r\n- No inscription or membership fees as in sports structures\/gyms\/clubs: you can always pay per class; very convenient for a short stay in Brussels! You can start whenever you want during the year, and come only once. \r\nIf you stay longer, opt for a 5 class card at 50 eur or 10 classes at 90 eur. You can also use your card for our zumba classes in Etterbeek, Brussels (metro Schuman\/Merode) Monday, Tuesday, Wednesday, Sunday.\r\n- Nice mix of Belgians and expatriates in our classes; you might find co-patriots and great to approach Belgians who live here :) and not just remain \"a tourist\".\r\n- Don't stay isolated in your hotel room at night\/weekend: come and have a good time in a group! We have a fun, relaxed, non-competitive and welcoming atmosphere for new participants.\r\n- We also have zumba Mondays, Tuesdays, Wednesdays and Sundays + an abs-butt-arms class on Sundays in Etterbeek, Brussels.\r\n- Also dance workshops, example: Salsa and Bachata lady-styling, Bollywood, Belly dancing... see here: https:\/\/www.danceandzumbafun.com\/dance.html\r\n- Spacious venues, easy to ventilate.\r\n- Website: www.dancea