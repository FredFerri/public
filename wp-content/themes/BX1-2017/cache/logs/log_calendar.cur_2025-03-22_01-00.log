iel du d\u00e9but du XX\u00e8me si\u00e8cle. Des b\u00e2timents modernistes de l\u2019ancienne brasserie Wielemans-Ceuppens \u00e0 l'h\u00f4tel communal, chef-d'oeuvre de l'Art D\u00e9co bruxellois, en passant par le quartier des arbres, riche en maisons mitoyennes et immeubles \u00e0 appartement de l\u2019entre-deux-guerres, un circuit insolite qui joue avec le contrastes pour d\u00e9couvrir deux facettes de cette commune du sud de Bruxelles.\n\nCette visite est organis\u00e9e dans le cadre du BANAD 2025.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.bruxellesbavard.be\/fr\/visites-pour-individuels\/","email":"info@bruxellesbavard.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700005933"},"sp":{"name":"A Forest, l'Art nouveau et l'Art D\u00e9co s\u00e9duisent ouvriers et bourgeois","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.bruxellesbavard.be\/fr\/visites-pour-individuels\/","email":"info@bruxellesbavard.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700005933"},"nl":{"name":"A Forest, l'Art nouveau et l'Art D\u00e9co s\u00e9duisent ouvriers et bourgeois","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.bruxellesbavard.be\/fr\/visites-pour-individuels\/","email":"info@bruxellesbavard.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700005933"}},"place":{"id":267624,"translations":{"de":{"name":"Devant l''entr\u00e9e du Wiels","address_street_name":"Avenue Van Volxem","address_street_number":"394","address_street_box":null,"email":"bruksel@skynet.be","website":"http:\/\/www.brukselbinnenstebuiten.be","phone_contact":"+32 2 518 38 78","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Va