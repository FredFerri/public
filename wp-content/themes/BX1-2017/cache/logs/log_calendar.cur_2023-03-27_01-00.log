":"Animazioni","sp":"Animaciones","pt":null,"cn":null}},"others":{"list":[97],"translations":{"fr":["Parc et centre r\u00e9cr\u00e9atifs"],"nl":["Recreatiedomein of centrum"],"en":["Park and recreational centre"],"de":["Park & Erholungszentrum"],"it":["Parchi e centri ricreativi"],"sp":["Parques y centros recreativos"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr","en","nl"],"subtitles":[]},"translations":{"fr":{"name":"Laser Games et Escape Games - Jeux collectifs 150% Fun","shortdescr":"Jeux collectifs, id\u00e9al pour vous amuser en famille, entre amis et coll\u00e8gues.\r\nPour un anniversaire, une sortie entre amis, une f\u00eate d'entreprise, Team Building et EVG & EVJF","longdescr":"- Space Fun Games = Space Laser Games + Space Team Games\r\n\r\n- 1000m2 de jeux collectifs d'int\u00e9rieurs garantis 150% Fun et accessibles \u00e0 tous \u00e0 partir de 7 ans \r\n\r\n- Plus grand laser games de Bruxelles d\u00e9cor spactial & 11 mini escape games avec jeux d'agilit\u00e9, sportifs et intellectuels\r\n\r\n- Ouvert 7\/7 horaires variables, prix comp\u00e9titifs, proches des transports en commun et parking gratuits.\r\n\r\nVous en sortirez la t\u00eate dans les \u00e9toiles.","performers":"L'\u00e9quipe du Space Fun Games","boxoffice_url":null,"website":"http:\/\/www.spacefungame.com","email":"info@spacefungames.com","phone_contact":"+32 2 720 01 23","phone_booking":"+32 499 83 95 30","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.535886"},"nl":{"name":"Laser Games en Escape Games - Groepsspelen 150% Fun","shortdescr":"Een ideale plek om plezier te maken met familie, vrienden en collega's.\r\nVoor een verjaardagsfeestje, een uitje met vrienden, een bedrijfsfeest, teambuilding en toekomstige echtgenoten","longdescr":"- Ruimte Plezier Games = Ruimte Lasergames + Ruimte Team Games\r\n\r\n- 1000m2 indoor team games gegarandeerd 150% plezier en toegankelijk voor iedereen vanaf 7 jaar\r\n\r\n- De grootste lasergames in Brussel met een ruimtelijk decor & 11 mini escape games met behendigheids-, sport- en intellectuele spelen\r\n\r\n- 7 dagen per week geopend, flexibele uren, concurrerende prijzen, dicht bij openbaar vervoer en gratis parkeren.\r\n\r\nJe zult vertrekken met je hoofd in de sterren.","performers":"De Team van Space Fun Games","boxoffice_url":null,"website":"http:\/\/www.spacefungame.com","email":"info@spacefungames.com","phone_contact":"+32 2 720 01 23","phone_booking":"+32 499 83 95 30","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.535886"},"en":{"name":"Laser Games and Escape Games - Group games 150% Fun","shortdescr":"An ideal place to have fun with family, friends and colleagues.\r\nFor a birthday party, a company party, Team Building and EVG & EVJF.","longdescr":"- Space Fun Games = Space Laser Games + Space Team Games\r\n\r\n- 1000m2 of indoor team games guaranteed 150% Fun and accessible to all from 7 years old \r\n\r\n- The biggest laser games in Brussels with a spatial decor & 11 mini escape games with agility, sports and intellectual games\r\n\r\n- Open 7 days a week, flexible hours, competitive prices, close to public transport and free parking.\r\n\r\nYou will leave with your head in the stars.","performers":"The Team of Space Fun Games","boxoffice_url":null,"website":"http:\/\/www.spacefungame.com","email":"info@spacefungames.com","phone_contact":"+32 2 720 01 23","phone_booking":"+32 499 83 95 30","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.535886"},"de":{"name":"Laser Games et Escape Games","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.spacefungame.com","email":"info@spacefungames.com","phone_contact":"+32 2 720 01 23","phone_booking":"+32 499 83 95 30","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.535886"},"it":{"name":"Laser Games et Escape Games","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"websi