d_title":"Visite Bruxelles, Grand-Place, hotel de ville : la fa\u00e7ade","oEmbed_author_name":"Visite Bruxelles","oEmbed_author_url":"https:\/\/www.youtube.com\/c\/VisiteBruxelles","oEmbed_type":"video","oEmbed_height":200,"oEmbed_width":356,"oEmbed_version":"1.0","oEmbed_provider_name":"YouTube","oEmbed_provider_url":"https:\/\/www.youtube.com\/","oEmbed_thumbnail_height":360,"oEmbed_thumbnail_width":480,"oEmbed_thumbnail_url":"https:\/\/i.ytimg.com\/vi\/Hx-0eP1V-7Y\/hqdefault.jpg","oEmbed_html":"<iframe width=\"356\" height=\"200\" src=\"https:\/\/www.youtube.com\/embed\/Hx-0eP1V-7Y?feature=oembed\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" allowfullscreen><\/iframe>","translations":{"fr":{"title":"Visite Bruxelles, Grand-Place, hotel de ville : la fa\u00e7ade"},"nl":{"title":"Visite Bruxelles, Grand-Place, hotel de ville : la fa\u00e7ade"},"en":{"title":"Visite Bruxelles, Grand-Place, hotel de ville : la fa\u00e7ade"}}},{"type":"poster","link":"https:\/\/agendabrussels.imgix.net\/31c53a04be914226bf9bbaa26a62563d4c37e8ac.jpg","width":1080,"height":1920,"ratio":0.56,"translations":{"fr":{"title":"Les symboles de la Grand-Place de Bruxelles","copyright":null},"nl":{"title":"Les symboles de la Grand-Place de Bruxelles","copyright":null},"en":{"title":"Les symboles de la Grand-Place de Bruxelles","copyright":null}}},{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/6fee6bd31f9bde272444455e496e8fc78c3565e6.jpg","width":1441,"height":1080,"ratio":1.33,"translations":{"fr":{"title":"Les symboles de la Grand-Place de Bruxelles","copyright":null},"nl":{"title":"Les symboles de la Grand-Place de Bruxelles","copyright":null},"en":{"title":"Les symboles de la Grand-Place de Bruxelles","copyright":null}}}],"dates":[{"day":"2022-05-15","doors":null,"start":"13:00:00","end":"14:30:00","is_soldout":false,"is_canceled":false},{"day":"2022-09-11","doors":null,"start":"13:00:00","end":"14:30:00","is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":18}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":["exterior"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-07-18T17:05:12+02:00","published_at":"2022-03-03T11:56:39+01:00","backoffice_id":248905,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.23112042478354},{"id":535883,"date_start":"2022-07-30","date_end":"2022-09-16","date_next":"2022-09-16","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre"}},"others":{"list":[52],"translations":{"fr":["Th\u00e9\u00e2tre musical"],"nl":["Muziektheater"],"en":["Musical theatre"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Bruce Ellison & The Jellodies","shortdescr":"L'alchimie de la rencontre entre Bruce Ellison et The Jellodies est absolument magique.\r\nThe Jellodies, c'est le swing et le jive du Nat King Cole Trio, de la section rythmique de Count Basie mais aussi, du Big Three Trio de Willie Dixon, tout ceci pour notre plus grand bonheur, \"groove\" m\u00e9chamment !","longdescr":"Bruce Ellison a d\u00e9but\u00e9 comme mime et voix off pour la t\u00e9l\u00e9vision am\u00e9ricaine, ainsi que dans des com\u00e9dies musicales. En 1981, il arrive \u00e0 Paris et int\u00e8gre l'\u00e9cole du mime Marceau. Fondateur avec Michel Carcan du Th\u00e9\u00e2tre de la Mandragore, il pr\u00eate \u00e9galement sa voix \u00e0 bon nombre de programmes pour enfants. Avec The Jellodies il se r\u00e9v\u00e8le excellent chanteur dans la couleur et les fac\u00e9ties de Thomas Fats Waller et le Jazz chant\u00e9 de Louis Armstrong\r\n\r\nThe Jellodies est un groupe qui s'inspire du c\u00e9l\u00e8bre trio: Art Tatum-Charlie Christian-Ray Brown.","performers":"Bruce Ellison (Voix), Patrick Louis (Guitarre & Voix), Druss Lecomte (Pianon & Voix), Guillaume Durieux (Contrebasse & Voix), Michel Par\u00e9 (Trompette)","boxoffice_url":"https:\/\/shop.utick.be\/?pos=FESTIVALBRUXELLONS&module=CATALOGUE&lg=FR","website":"http:\/\/www.bruxellons.be","email":"info@bruxellons.net","phone_contact":null,"phone_booking":"+32 2 724 24 24","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.535883"},"nl":{"name":"Bruce Ellison & The Jellodies","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/shop.utick.be\/?pos=FESTIVALBRUXELLONS&module=CATALOGUE&lg=NL","website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.535883"},"en":{"name":"Bruce Ellison & The Jellodies","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/shop.utick.be\/?pos=FESTIVALBRUXELLONS&module=CATALOGUE&lg=EN","website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.535883"},"de":{"name":"Bruce Ellison & The Jellodies","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.535883"},"it":{"name":"Bruce Ellison & The Jellodies","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.535883"},"sp":{"name":"Bruce Ellison & The Jellodies","shortdescr":null,"longdescr":null,"performers":nul