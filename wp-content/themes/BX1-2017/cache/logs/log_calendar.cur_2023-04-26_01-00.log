","end":"17:30:00"}]},"friday":{"is_open":true,"hours":[{"start":"10:30:00","end":"17:30:00"}]},"saturday":{"is_open":true,"hours":[{"start":"10:30:00","end":"17:30:00"}]},"sunday":{"is_open":false}},"translations":{"fr":["lundi, mardi, mercredi, jeudi, vendredi et samedi: de 10:30 \u00e0 17:30","dimanche: ferm\u00e9"],"nl":["maandag, dinsdag, woensdag, donderdag, vrijdag en zaterdag: van 10:30 tot 17:30","zondag: gesloten"],"en":["monday, tuesday, wednesday, thursday, friday and saturday: from 10:30 to 17:30","sunday: closed"],"de":["monday, tuesday, wednesday, thursday, friday and saturday: from 10:30 to 17:30","sunday: closed"],"it":["monday, tuesday, wednesday, thursday, friday and saturday: from 10:30 to 17:30","sunday: closed"],"sp":["monday, tuesday, wednesday, thursday, friday and saturday: from 10:30 to 17:30","sunday: closed"],"pt":["monday, tuesday, wednesday, thursday, friday and saturday: from 10:30 to 17:30","sunday: closed"],"cn":["monday, tuesday, wednesday, thursday, friday and saturday: from 10:30 to 17:30","sunday: closed"]},"date_start":"2023-01-10","date_end":"2029-12-31","is_also_by_appointment":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"},"de":{"name":"Normal"},"it":{"name":"Normale"},"sp":{"name":"Normal"},"pt":{"name":"Normal"},"cn":{"name":"Normal"}},"value":35}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":["annee_art_nouveau"],"is_part_of":"Ann\u00e9e Art Nouveau","accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-04-25T02:06:55+02:00","published_at":"2022-11-16T16:28:36+01:00","backoffice_id":265724,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.14643004228082},{"id":551359,"date_start":"2023-02-01","date_end":"2023-12-31","date_next":"2023-04-25","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung","it":"Esposizioni","sp":"Exhibici\u00f3n","pt":null,"cn":null}},"others":{"list":[24,30],"translations":{"fr":["Galeries d'art","Peinture"],"nl":["Galeries","Schilderkunst"],"en":["Art Galleries","Painting"],"de":["Kunstgalerien","Malerei"],"it":["Gallerie d'arte","Pittura"],"sp":["Galer\u00edas de arte","Pintura"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","en"],"subtitles":[]},"translations":{"fr":{"name":"Exposition \"Retrospective\" de Blaise Patrix","shortdescr":"Deuxi\u00e8me chapitre d\u2019un projet de collaboration entre l\u2019h\u00f4tel et des artistes install\u00e9s dans la capitale, l\u2019exposition d\u2019une trentaine d\u2019\u0153uvres de Blaise Patrix entend donner une dimension r\u00e9solument multiculturelle aux diff\u00e9rents espaces du Hilton tout en invitant les clients belges et \u00e9trangers, ainsi que les locaux, \u00e0 amorcer une discussion autour de ce travail artistique hybride et h\u00e9t\u00e9roclite.","longdescr":"De la s\u00e9rie Symbiose qui m\u00e9lange paysages de campagne et sc\u00e8nes marines dans une approche po\u00e9tique aux portraits de la s\u00e9rie Reconnaissance en passant par les paysages de la s\u00e9rie Relations ou encore Paroles d\u2019Oc\u00e9an, toutes les \u0153uvres de cet artiste form\u00e9 \u00e0 la peinture classique c\u00e9l\u00e8brent la vie et le \u00ab vivre ensemble \u00bb. Des QR codes plac\u00e9s en regard de chaque tableau permettront aux visiteurs de d\u00e9couvrir, via la voir de Blaise Patrix, l\u2019univers de l\u2019artiste et l\u2019histoire des toiles qui habillent les murs de l\u2019h\u00f4tel. \r\n\r\n\u00ab Ce qui m\u2019int\u00e9resse, c\u2019est de cultiver et de valoriser la reconnaissance publique et collective ; une reconnaissance qui favorise la sensibilit\u00e9, l\u2019\u00e9motion, l\u2019intuition et la cr\u00e9ativit\u00e9. Comme l\u2019a dit tr\u00e8s justement le philosoph\u00e9 \u00c9douard Glissant : \u2018\u00eatre, c\u2019est changer en \u00e9changeant avec l\u2019autre tout en restant soi-m\u00eame.\u00bb\r\nBlaise Patrix \r\n\r\nSi, au cours de sa carri\u00e8re, Blaise Patrix a r\u00e9alis\u00e9 des fresques monumentales dans une approche participative de la cr\u00e9ation, cette collaboration avec le Hilton Brussels Grand Place lui a permis de prolonger cette d\u00e9marche en rencontrant les collaborateurs de l\u2019h\u00f4tel et en amor\u00e7ant avec eux un dialogue nourri et inspirant. L\u2019artiste a notamment r\u00e9alis\u00e9 le portrait de Vincent Masson, le chef du Sentro. Sur la carte du restaurant, on retrouvera un portrait du cuisinier, fruit de ce face-\u00e0-face, ainsi qu\u2019une pr\u00e9sentation des \u0153uvres expos\u00e9es. Quant aux plats cr\u00e9\u00e9s par le chef, ils sont librement inspir\u00e9s de cette rencontre. Pour Ellen Deboeck, ce projet d\u2019exposition \u00e0 grande \u00e9chelle initi\u00e9 juste avant la pand\u00e9mie, sonne comme une \u00e9vidence. Dans le sillage d\u2019un premier accrochage des \u0153uvres de V\u00e9ronique Van der Wielen, c\u2019est donc cet artiste - avec lequel elle partage une passion pour le voyage - que la directrice du Hilton Brussels Grand Place a choisi d\u2019inviter pendant toute cette ann\u00e9e : \r\n\r\n\u00ab Notre volont\u00e9 n\u2019est pas d\u2019utiliser l\u2019art comme outil marketing, mais bien de v\u00e9hiculer un message authentique. Chaque d\u00e9partement est directement associ\u00e9 \u00e0 l\u2019exposition : la cuisine par le biais de notre chef, mais aussi le Front Office ou encore nos collaborateurs en charge des s\u00e9minaires. Depuis que nous organisons des expositions au sein de l\u2019h\u00f4tel, nous remarquons, notamment sur les photos post\u00e9es sur les r\u00e9seaux sociaux et les questions que les clients posent \u00e0 nos \u00e9quipes, un r\u00e9el int\u00e9r\u00eat pour ce projet. \u00bb  \r\nEllen Deboeck","performers":null,"boxoffice_url":null,"website":"https:\/\/visitin.brussels\/happening\/blaise-patrix-retrospective-exhibition\/","email":"info.brusselsgrandplace@hilton.com","phone_contact":"+32 2 548 42 11","phone_booking":"+32 2 548 42 11","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.551359"},"nl":{"name":"Tentoonstelling \"Retrospective\" van Blaise Patrix","shortdescr":"De tentoonstelling van een dertigtal werken van Blaise Patrix wil een resoluut multiculturele dimensie geven aan de verschillende ruimtes van het Hilton en nodigt zowel Belgische en buitenlandse gasten als de plaatselijke bevolking uit om een discussie op gang te brengen rond dit hybride en heterogene artistieke werk.","longdescr":"Van de serie Symbiose, waarin landschappen en mariene sc\u00e8nes op po\u00ebtische wijze worden vermengd, tot de portretten in de serie Reconnaissance en niet te vergeten de landschappen in de serie Relations en Paroles d'Oc\u00e9an, alle werken van deze kunstenaar, die een opleiding in de klassieke schilderkunst heeft genoten, vieren het leven en het \"samenleven\". Dankzij QR-codes naast elk schilderij kunnen bezoekers via de website van Blaise Patrix de wereld van de kunstenaar en de geschiedenis van de schilderijen die de muren van het hotel sieren, ontdekken. \r\n\r\n\"Ik ben ge\u00efnteresseerd in het cultiveren en versterken van publieke en collectieve erkenning; een erkenning die gevoeligheid, emotie, intu\u00eftie en creativiteit aanmoedigt. Zoals de filosoof \u00c9douard Glissant terecht zei: 'zijn is veranderen door te ruilen met de ander terwijl je jezelf blijft.\r\nBlaise Patrix \r\n\r\nIn de loop van zijn carri\u00e8re heeft Blaise Patrix monumentale fresco's gemaakt met een participatieve benadering van de creatie. Deze samenwerking met het Hilton Brussels Grand Place heeft hem in staat gesteld deze benadering uit te breiden door het personeel van het hotel te ontmoeten en met hen een rijke en inspirerende dialoog aan te gaan. De kunstenaar heeft met name een portret gemaakt van Vincent Masson, de chef-kok van het Sentro. Op het menu van het restaurant staat een portret van de chef, het resultaat van deze persoonlijke ontmoeting, en een presentatie van de tentoongestelde werken. De gerechten van de chef zijn vrij ge\u00efnspireerd op deze ontmoeting. Voor Ellen Deboeck is dit grootschalige tentoonstellingsproject, dat net voor de pandemie werd gestart, een voor de hand liggende keuze. Na een eerste tentoonstelling van werken van V\u00e9ronique Van der Wielen, is het deze kunstenaar - met wie zij een passie voor reizen deelt - die de directrice van het Hilton Brussels Grand Place heeft gekozen om het hele jaar door uit te nodigen: \r\n\r\n\"Ons doel is niet om kunst te gebruiken als marketinginstrument, maar om een authentieke boodschap over te brengen. Elke afdeling is rechtstreeks betrokken bij de tentoonstelling: de keuken via onze chef-kok, maar ook de Front Office en ons seminariepersoneel. Sinds we tentoonstellingen in het hotel organiseren, merken we een echte belangstelling voor dit project, vooral door de foto's die op sociale netwerken worden geplaatst en de vragen die gasten aan onze teams stellen\" - Ellen Deboeck","performers":null,"boxoffice_url":null,"website":"https:\/\/visitin.brussels\/happening\/blaise-patrix-retrospective-exhibition\/","email":"info.brusselsgrandplace@hilton.com","phone_contact":"+32 2 548 42 11","phone_booking":"+32 2 548 42 11","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.551359"},"en":{"name":"Exhibition \"Retrospective\" by Blaise Patrix","shortdescr":"The second chapter of a collaborative project between the hotel and artists based in the capital, the exhibition of some thirty works by Blaise Patrix aims to give a resolutely multicultural dimension to the different spaces of the Hilton while inviting Belgian and foreign guests, as well as locals, to initiate a discussion around this hybrid and heterogeneous artistic work.","longdescr":"From the Symbiosis series, which mixes countryside landscapes and marine scenes in a poetic approach, to the portraits in the Reconnaissance series, not forgetting the landscapes in the Relations series and Paroles d'Oc\u00e9an, all the works of this artist, who trained in classical painting, celebrate life and \"living together\". QR codes placed next to each painting will allow visitors to discover, via Blaise Patrix's website, the artist's world and the history of the paintings that adorn the hotel's walls. \r\n\r\n\"I am interested in cultivating and enhancing public and collective recognition; recognition that encourages sensitivity, emotion, intuition and creativity. As the philosopher \u00c9douard Glissant rightly said: 'to be is to change by exchanging with the other while remaining oneself.\r\nBlaise Patrix \r\n\r\nIn the course of his career, Blaise Patrix has created monumental frescoes with a participatory approach to creation. This collaboration with the Hilton Brussels Grand Place has enabled him to extend this approach by meeting the hotel's staff and initiating a rich and inspiring dialogue with them. In particular, the artist created a portrait of Vincent Masson, the Sentro's chef. The restaurant menu will feature a portrait of the chef, the result of this face-to-face meeting, as well as a presentation of the works on display. The dishes created by the chef are freely inspired by this encounter. For Ellen Deboeck, this large-scale exhibition project, which was initiated just before the pandemic, is an obvious choice. In the wake of a first exhibition of works by V\u00e9ronique Van der Wielen, it is this artist - with whom she shares a passion for travel - that the director of the Hilton Brussels Grand Place has chosen to invite throughout the year: \r\n\r\n\"Our aim is not to use art as a marketing tool, but to convey an authentic message. Each department is directly involved in the exhibition: the kitchen through our chef, but also the Front Office and our seminar staff. Since we have been organising exhibitions in the hotel, we have noticed a real interest in this project, especially in the photos posted on social networks and the questions that guests ask our teams\" - Ellen Deboeck","performers":null,"boxoffice_url":null,"website":"https:\/\/visitin.brussels\/happening\/blaise-patrix-retrospective-exhibition\/","email":"info.brusselsgrandplace@hilton.com","phone_contact":"+32 2 548 42 11","phone_booking":"+32 2 548 42 11","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.551359"},"de":{"name":"Exposition \"Retrospective\" de Blaise Patrix","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/visitin.brussels\/happening\/blaise-patrix-retrospective-exhibition\/","email":"info.brusselsgrandplace@hilton.com","phone_contact":"+32 2 548 42 11","phone_booking":"+32 2 548 42 11","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.551359"},"it":{"name":"Exposition \"Retrospective\" de Blaise Patrix","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/visitin.brussels\/happening\/blaise-patrix-retrospective-exhibition\/","email":"info.brusselsgrandplace@hilton.com","phone_contact":"+32 2 548 42 11","phone_booking":"+32 2 548 42 11","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.551359"},"sp":{"name":"Exposition \"Retrospective\" de Blaise Patrix","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/visitin.brussels\/happening\/blaise-patrix-retrospective-exhibition\/","email":"info.brusselsgrandplace@hilton.com","phone_contact":"+32 2 548 42 11","phone_booking":"+32 2 548 42 11","agenda_url":"https:\/\/visit.brussels\/sp\/visito