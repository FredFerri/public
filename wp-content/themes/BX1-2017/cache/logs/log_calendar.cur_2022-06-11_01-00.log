"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":0}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"visit_profile":{"list":[328],"translations":{"fr":["Vert & Durable"],"nl":["Groen"],"en":["Green"]}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-04-12T04:05:13+02:00","published_at":"2022-04-09T03:30:28+02:00","backoffice_id":251290,"import_origin":"explore","sub_type":"other","show_in_agenda":true,"ranking":0.26060566417839},{"id":526002,"date_start":"2022-03-27","date_end":"2022-10-30","date_next":"2022-06-26","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{"list":[112],"translations":{"fr":["Insolite"],"nl":["Ongewoon"],"en":["Unusual"]}}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Dimanche \u00e0 v\u00e9lo","shortdescr":"Profitez du r\u00e9veil silencieux de la ville le dimanche matin. D\u00e9couvrez le plaisir du v\u00e9lo \u00e0 Bruxelles et les endroits surprenants de la ville et de sa p\u00e9riph\u00e9rie.","longdescr":"Profitez du r\u00e9veil silencieux de la ville le dimanche matin. Une balade \u00e0 v\u00e9lo agr\u00e9able, une excellente dose de mouvement et id\u00e9ale pour rencontrer d'autres Bruxellois !\r\n\r\nChaque mois, nous mettons en avant un coin vert surprenant dans la p\u00e9riph\u00e9rie de Bruxelles. Un(e) de nos guides tracera un itin\u00e9raire agr\u00e9able \u00e0 v\u00e9lo d'environ 25 \u00e0 30 km aller-retour. Apr\u00e8s avoir profit\u00e9 de l'endroit et avoir fait une petite pause, nous retournons \u00e0 v\u00e9lo au ensemble au centre-ville. \r\n\r\nRendez-vous \u00e0 10h00 au Grand Hospice, rue du Grand Hospice 7, 1000 Bruxelles. Vers 13h00 nous serons de retour!\r\n\r\nD\u00e9couvrez le programme sur notre site web! \r\nhttps:\/\/cactus.brussels\/dimanche-a-velo","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/526002.html"},"nl":{"name":"Dimanche \u00e0 v\u00e9lo","shortdescr":"Geniet mee van de nog stille ontwakende stad op zondagochtend. Ontdek het fietsen in Brussel en verrassende plekken in de stad en de rand.","longdescr":"Geniet mee van de nog stille ontwakende stad op zondagochtend.  Een gezellige fietstocht, een gezonde dosis beweging en ideaal om andere Brusselaars te ontmoeten !\r\n\r\nElke maand selecteren we een verrassende groene plek uit in de rand van Brussel. Daar fietsen we tijdens Dimanche \u00e0 v\u00e9lo naar toe! Onze gidsen stippelen een leuke route uit van zo\u2019n 25 \u00e0 30km. Na de pauze en na even van de plek te hebben genoten keren we samen terug naar het centrum. \r\n\r\nAfspraak: 10u00 bij Grand Hospice in de Grootgodshuisstraat 7, 1000 Brussel. En rond 13u00 zijn we terug!\r\n\r\nOntdek het programma op onze website!\r\nhttps:\/\/cactus.brussels\/zondag-a-velo","performers":"Cactus Brussel \u00e0 v\u00e9lo","boxoffice_url":null,"website":"https:\/\/cactus.brussels\/zondag-a-velo","email":"info@cactus.brussels","phone_contact":null,"phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/526002.html"},"en":{"name":"Dimanche \u00e0 v\u00e9lo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/526002.html"},"de":{"name":"Dimanche \u00e0 v\u00e9lo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":n