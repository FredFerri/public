chema":[{"days":{"monday":{"is_open":false},"tuesday":{"is_open":true,"hours":[{"start":"09:30:00","end":"17:00:00"}]},"wednesday":{"is_open":true,"hours":[{"start":"09:30:00","end":"17:00:00"}]},"thursday":{"is_open":true,"hours":[{"start":"09:30:00","end":"17:00:00"}]},"friday":{"is_open":true,"hours":[{"start":"09:30:00","end":"17:00:00"}]},"saturday":{"is_open":true,"hours":[{"start":"10:00:00","end":"17:00:00"}]},"sunday":{"is_open":true,"hours":[{"start":"10:00:00","end":"17:00:00"}]}},"translations":{"fr":["lundi: ferm\u00e9","mardi, mercredi, jeudi et vendredi: de 09:30 \u00e0 17:00","samedi et dimanche: de 10:00 \u00e0 17:00"],"nl":["maandag: gesloten","dinsdag, woensdag, donderdag en vrijdag: van 09:30 tot 17:00","zaterdag en zondag: van 10:00 tot 17:00"],"en":["monday: closed","tuesday, wednesday, thursday and friday: from 09:30 to 17:00","saturday and sunday: from 10:00 to 17:00"]},"date_start":"2022-10-13","date_end":"2023-01-15","is_also_by_appointment":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":16},{"translations":{"fr":{"name":"Enfants"},"nl":{"name":"Kinderen"},"en":{"name":"Children"}},"value":0},{"translations":{"fr":{"name":"Seniors"},"nl":{"name":"Senioren"},"en":{"name":"Seniors"}},"value":12},{"translations":{"fr":{"name":"museumpassmus\u00e9es"},"nl":{"name":"museumpassmus\u00e9es"},"en":{"name":"museumpassmus\u00e9es"}},"value":0}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"visit_profile":{"list":[337],"translations":{"fr":["Highlight"],"nl":["Highlight"],"en":["Highlight"],"de":["Highlight"]}},"tags":[],"accessibilities":{"list":[255,259,261,263,265],"translations":{"fr":["Accessible","Chien d'assistance","Parking accessible","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9"],"nl":["Toegankelijk","Assistentiehonden","Toegankelijke parking","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet"],"en":["Accessible","Assistance dogs","Accessible parking","Accessible to pedestrians with mobility aids","Adapted toilet"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-11-17T01:36:13+01:00","published_at":"2022-05-24T15:18:25+02:00","backoffice_id":254426,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.3478928170979},{"id":544327,"date_start":"2022-11-02","date_end":"2022-12-21","date_next":"2022-11-17","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung"}},"others":{"list":[36,37],"translations":{"fr":["Mus\u00e9es et art centers","Arts audiovisuels"],"nl":["Musea en kunstcentra","Audiovisuele kunst"],"en":["Museums and art centers","Audiovisual art"],"de":["Museen & Kunstzentren","Audiovisuelle K\u00fcnste"]}}},"languages":{"spoken":["en","fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"K-Pop, Now Here","shortdescr":"Chanter l'amour et la libert\u00e9 pendant un demi-si\u00e8cle","longdescr":"Le Centre culturel cor\u00e9en organise une exposition sur la K-pop, la musique populaire cor\u00e9enne. D'un point de vue musical, la K-pop fait r\u00e9f\u00e9rence \u00e0 la musique centr\u00e9e sur les idoles parmi les musiques populaires fabriqu\u00e9es en Cor\u00e9e. Ils recherchent principalement des sons pop sophistiqu\u00e9s et des performances splendides, et \u00e9voluent constamment avec les tendances mondiales. Cependant, il est difficile de voir quel genre de musique est la K-pop simplement en la d\u00e9finissant selon un genre et un style sp\u00e9cifiques. Afin de bien comprendre la K-pop, il est n\u00e9cessaire de l'examiner sous diff\u00e9rents angles, tels que la musique, l'industrie et la soci\u00e9t\u00e9. En effet, la K-POP est un espace musical o\u00f9 se croisent divers d\u00e9sirs de la soci\u00e9t\u00e9 cor\u00e9enne moderne, une industrie culturelle et une ar\u00e8ne sociale. Cette exposition montre l'histoire de la K-pop \u00e0 partir des ann\u00e9es 1950 et comment elle est le produit d'une rencontre fructueuse entre la musique occidentale et la soul cor\u00e9enne.\r\n\r\nAujourd'hui, la K-POP se transforme en une nouvelle vague de culture o\u00f9 les gens du monde entier peuvent s'amuser et communiquer ensemble en collaborant avec des artistes du monde entier et en rencontrant diverses cultures. Que diriez-vous de nous rejoindre dans ce formidable voyage de communication et de cr\u00e9ation ? Les visiteurs pourront profiter pleinement de la K-pop gr\u00e2ce \u00e0 diverses installations multim\u00e9dias dynamiques telles que des vid\u00e9os, une cartographie des m\u00e9dias et des m\u00e9dias immersifs.","performers":null,"boxoffice_url":null,"website":"https:\/\/brussels.korean-culture.org\/fr\/650\/board\/442\/read\/118609","email":"info@kccbrussels.be","phone_contact":"+32 2 274 29 80","phone_booking":"+32 2 274 29 80","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.544327"},"nl":{"name":"K-Pop, Now Here","shortdescr":"Al een halve eeuw zingen over Liefde & Vrijheid","longdescr":"Het Koreaans Cultureel Centrum organiseert een tentoonstelling over K-pop, Koreaanse populaire muziek. Vanuit muzikaal oogpunt verwijst K-pop naar op idool gerichte muziek tussen populaire muziek gemaakt in Korea. Ze streven vooral naar verfijnde popklanken en schitterende uitvoeringen, en veranderen voortdurend mee met wereldwijde trends. Het is echter moeilijk om te zien wat voor soort muziek K-pop is door het simpelweg te defini\u00ebren volgens een specifiek genre en stijl. Om K-pop goed te begrijpen, is het nodig om het vanuit verschillende perspectieven te bekijken, zoals muziek, industrie en samenleving. Dit komt omdat K-POP een muziekruimte is waar verschillende verlangens van de moderne Koreaanse samenleving elkaar kruisen, een culturele industrie en een sociale arena. Deze tentoonstelling toont de geschiedenis van K-pop vanaf de jaren vijftig en hoe deze het product is van een vruchtbare ontmoeting tussen westerse muziek en Koreaanse soul.\r\n\r\nTegenwoordig verandert K-POP in een nieuwe cultuurgolf waar mensen over de hele wereld kunnen genieten en samen kunnen communiceren door samen te werken met artiesten van over de hele wereld en verschillende culturen te ontmoeten. Wat denkt u ervan om met ons mee te gaan op deze geweldige reis van communicatie en creatie? Bezoekers kunnen ten volle genieten van K-pop via verschillende dynamische media-installaties zoals video's, mediamapping en immersive media.","performers":null,"boxoffice_url":null,"website":"https:\/\/brussels.korean-culture.org\/nl\/650\/board\/442\/read\/118609","email":"info@kccbrussels.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.544327"},"en":{"name":"K-Pop, Now Here","shortdescr":"'Singing about Love & Freedom for half a century'","longdescr":"The Korean Cultural Center organizes an exhibition about K-pop, Korean popular music. From a musical point of view, K-pop refers to idol-centered music among popular music made in Korea. They mainly pursue sophisticated pop sounds and splendid performances, and are constantly changing along with global trends. However, it is difficult to see what kind of music K-pop is simply by defining it according to a specific genre and style. In order to properly understand K-pop, it is necessary to look at it from various perspectives, such as music, industry and society. This is because K-POP is a music space where various desires of modern Korean society intersect, a cultural industry, and a social arena. This exhibition shows the history of K-pop starting from the 1950s and how it is the product of a fruitful encounter between Western music and Korean soul.\r\n\r\nToday, K-POP is changing into a new wave of culture where people all over the world can enjoy and communicate together by collaborating with artists from around the world and meeting various cultures. How about joining us in this amazing journey of communication and creation? Visitors will be able to enjoy K-pop to the fullest through various dynamic media installations such as videos, media mapping and immersive media.","performers":null,"boxoffice_url":null,"website":"https:\/\/brussels.korean-culture.org\/en\/650\/board\/442\/read\/118609","email":"info@kccbrussels.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.544327"},"de":{"name":"K-Pop, Now Here","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.544327"},"it":{"name":"K-Pop, Now Here","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.544327"},"sp":{"name":"K-Pop, Now Here","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.544327"},"pt":{"name":"K-Pop, Now Here","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.544327"},"cn":{"name":"K-Pop, Now Here","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.544327"}},"place":{"id":252775,"translations":{"fr":{"name":"Centre Culturel Cor\u00e9en de Bruxelles","address_street_name":"Rue de la R\u00e9gence","address_street_number":"4","address_street_box":null,"email":"info@kccbrussels.be","website":"http:\/\/brussels.korean-culture.org\/","phone_contact":"+32 2 274 29 80","phone_booking":"+32 2 274 29 80","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la R\u00e9gence, 4","address_line2":"1000 Bruxelles","description_web":"Le but du centre culturel cor\u00e9en, situ\u00e9 au c\u0153ur de Bruxelles,  est de promouvoir la cooperation culturelle des echanges entre la Belgique et la Coree, et entre l\u2019Union Europeenne et la Coree, a travers diverses activit\u00e9s culturelles traditionnelles et contemporaines. \r\nLe centre dispose d'une infrastructure adapt\u00e9 \u00e0 sa mission avec une salle multifonctionnelle utilis\u00e9e pour la projection de films, spectacles, conf\u00e9rences et expositions; un sarangbang, espace o\u00f9 les visiteurs peuvent pratiquer la c\u00e9r\u00e9monie cor\u00e9enne du th\u00e9; une biblioth\u00e8que; une cuisine pour les cours hebdomadaires de cuisine cor\u00e9enne et le King Sejong Institute pour les cours de langue.\r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Koreaans Cultureel Centrum Brussel","address_street_name":"Regentschapsstraat","address_street_number":"4","address_street_box":null,"email":"info@kccbrussels.be","website":"http:\/\/brussels.korean-culture.org\/","phone_contact":"+32 2 274 29 80","phone_booking":"+32 2 274 29 80","address_zip":"1000","address_city":"Brussel","address_line1":"Regentschapsstraat, 4","address_line2":"1000 Brussel","description_web":"Het Koreaans Cultureel Centrum van de Koreaanse Ambassade van Korea in de Europese unie en Belgi\u00eb is gevestigd in het hart van Brussel, en wil de samenwerking en uitwisseling promoten tussen Belgi\u00eb, de Europese Unie en Korea door het organiseren van verschillende culturele activiteiten. Het centrum beschikt daarvoor over een aangepaste infrastructuur zoals een evenementenhal gebruikt voor de projectie van Koreaanse films, optredens, tentoonstellingen en lezingen; een Sarangbang waar bezoekers de traditionele Koreaanse theeceremonie kunnen meemaken; een bibliotheek; een keuken waar regelmatig Koreaanse kooklessen worden gehouden en het King Sejong Institute waar de taallessen worden georganiseerd.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Korean Cultural Center Brussels","address_street_name":"Rue de la R\u00e9gence","address_street_number":"4","address_street_box":null,"email":"info@kccbrussels.be","website":"http:\/\/brussels.korean-culture.org\/","phone_contact":"+32 2 274 29 80","phone_booking":"+32 2 274 29 80","address_zip":"1000","address_city":"Brussels","address_line1":"Rue de la R\u00e9gence, 4","address_line2":"1000 Brussels","description_web":"The Korean Cultural Center in Brussels is situated in the heart of Brussels, and strives to promote cultural exchanges between Korea & Belgium and Korea & the EU by diverse cultural activities.\r\nThe center disposes of an adapted infrastructure with an event hall used for screening original Korean cinema, shows, performances, exhibitions and conferences; a sarangbang where visitors can experience Korea's traditional tea ceremony; a library, a kitchen for the Korean cooking classes and the King Sejong Institute, where Korean language classes are held.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Centre Culturel Cor\u00e9en de Bruxelles","address_street_name":"Rue de la R\u00e9gence","address_street_number":"4","address_street_box":null,"email":"info@kccbrussels.be","website":"http:\/\/brussels.korean-culture.org\/","phone_contact":"+32 2 274 29 80","phone_booking"