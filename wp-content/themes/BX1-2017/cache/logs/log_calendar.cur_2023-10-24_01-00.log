ado"],"nl":["Toegankelijk"]}},"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":["annee_art_nouveau"],"opening":{"day":"2023-10-19","start":"19:00:00","timestamp":"2023-10-19T19:00:00"}},{"id":50003319,"date_start":"2023-10-19","date_end":"2023-11-09","date_next":"2023-10-23","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2023-10-23T02:03:01+02:00","published_at":"2023-10-13T15:01:02+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":287120,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.35688292775180414,"languages":{"spoken":["en","nl","fr"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[26,24],"translations":{"de":["Skulptur","Kunstgalerien"],"pt":[null,null],"en":["Sculpture","Art Galleries"],"it":["Scultura","Gallerie d'arte"],"cn":[null,null],"fr":["Sculpture","Galeries d'art"],"sp":["Escultura","Galer\u00edas de arte"],"nl":["Beeldhouwkunst","Galeries"]}}},"translations":{"de":{"name":"Vernissage & Animal Sculpture Exhibition of Sophie Verger : Whispers of Innocence","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.art-yi.com\/fr\/","email":"info@art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":"+32 474 70 04 07","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50003319"},"pt":{"name":"Vernissage & Animal Sculpture Exhibition of Sophie Verger : Whispers of Innocence","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.art-yi.com\/fr\/","email":"info@art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":"+32 474 70 04 07","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50003319"},"en":{"name":"Sophie Verger : Whispers of Innocence","shortdescr":"In the heart of Brussels, where art meets enchantment, Art Yi Gallery presents an extraordinary journey into the realm of whimsical creatures and forgotten innocence. \"Whispers of Innocence: A Tale of Animals of 2023\" invites you to step into the captivating world of French artist Sophie Verger, where imagination knows no bounds, the wonder of childhood is reborn in magnificent animal sculptures.","longdescr":"Sophie Verger was born in Paris in 1953.\n\n\u2022 It is a very old story, perhaps a myth, perhaps not, when the earth was a garden where they lived in peace, an era of harmony and of games: the childhood of the world. The animals remember the lost paradise, the Garden of Eden which can only be reached through the path of childhood and which can only be glimpsed with a look unencumbered by the ugliness of the present time.\n \n\u2022 It is here that Sophie Verger guides us, among the beasts of the museum, in a tranquil world where peace and carefree bliss reign... carefree, it is necessary to brave the Laws of Gravity as her models often do: where art reigns, with a vigorous trunk nothing is impossible. ","performers":"\u2022 VERNISSAGE: THU 19\/10, 19:00 - 21:00, MEET SOPHIE!\n\u2022 WHEN: 19\/10 - 09\/11\/2022 \n\u2022 WHAT: 40 ANIMAL SCULPTURES, NEW OF 2023\n\n59 RUE DE LA MADELEINE, 1000, BRUSSELS\nEVERYDAY, EXCEPT WEDNESDAY\nWEEKDAYS: 11:00 - 18:00; WEEKENDS: 12:00 - 19:00\nWWW.ART-YI.COM\n\n\u2022 HOW TO COME: \nStation (Train\/Subway) : Brussels Central \nPark : Interparking Albertine Square (100m)  \n3 Rue des Sols | 1000 | Brussels","boxoffice_url":null,"website":"https:\/\/www.art-yi.com","email":"info@art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":"+32 474 70 04 07","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50003319"},"it":{"name":"Vernissage & Animal Sculpture Exhibition of Sophie Verger : Whispers of Innocence","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.art-yi.com\/fr\/","email":"info@art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":"+32 474 70 04 07","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50003319"},"cn":{"name":"Vernissage & Animal Sculpture Exhibition of Sophie Verger : Whispers of Innocence","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.art-yi.com\/fr\/","email":"info@art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":"+32 474 70 04 07","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50003319"},"fr":{"name":"Sophie Verger : Murmures d'Innocence","shortdescr":"Au c\u0153ur de Bruxelles, la Galerie Art Yi pr\u00e9sente fi\u00e8rement des cr\u00e9atures fantasques qui nous font retrouver l\u2019innocence enfouie en chaque \u00eatre humain \u00bb\n\u00ab Murmures de l\u2019Innocence : de nouvelles \u0153uvres pour un conte 2023\" vous invite \u00e0 p\u00e9n\u00e9trer dans l\u2019univers captivant de l'artiste fran\u00e7aise Sophie Verger, univers dans lequel  l'imagination ne conna\u00eet pas de limites.  Laissons-nous \u00e9merveiller !","longdescr":"Sophie Verger est n\u00e9e \u00e0 Paris en 1953.\n\nC\u2019est une histoire tr\u00e8s ancienne, peut-\u00eatre un mythe ou peut-\u00eatre pas, quand la terre \u00e9tait un jardin o\u00f9 les animaux vivaient en paix, une \u00e9poque d\u2019harmonie et de jeux : l\u2019enfance du monde. Les animaux se souviennent du paradis perdu, du jardin d\u2019Eden auquel ne peuvent mener que les chemins de l\u2019enfance et que seul un regard \u00e9tanche \u00e0 la laideur du pr\u00e9sent peut permettre d\u2019entrevoir.  \n \n\u2022 C\u2019est ici que nous guide Sophie Verger, parmi ses B\u00eates \u00e0 mus\u00e9e, dans un monde apais\u00e9 o\u00f9 r\u00e8gne une bienheureuse insouciance\u2026 Et de l\u2019insouciance, il en faut pour braver les lois de la pesanteur comme le font souvent ses mod\u00e8les : qu\u2019importe, o\u00f9 r\u00e8gne l\u2019art, \u00e0 trompe vigoureuse rien d\u2019impossible. \n-       Citer Georges Dilly, conservateur en chef du Mus\u00e9e de Berck sur Mer","performers":"\u2022 VERNISSAGE : JEUDI 19\/10, 19h00 - 21h00, RENCONTREZ SOPHIE !\n\u2022 QUAND : 19\/10 - 09\/11\/2022\n\u2022 QUOI : 40 SCULPTURES D'ANIMAUX, NOUVEAUT\u00c9S DE 2023\n\n59 RUE DE LA MADELEINE, 1000, BRUSSELS\nEN SEMAINE : 11H00 - 18H00 ; WEEK-END : 12H00 - 19H00\nWWW.ART-YI.COM\n\n\u2022 COMMENT VENIR :\nGare (Train\/M\u00e9tro) : Bruxelles-Central\nParking : Interparking Albertine Square (\u00e0 100m)\n3 Rue des Sols | 1000 | Bruxelles","boxoffice_url":null,"website":"https:\/\/www.art-yi.com\/fr\/","email":"info@art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":"+32 474 70 04 07","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50003319"},"sp":{"name":"Vernissage & Animal Sculpture Exhibition of Sophie Verger : Whispers of Innocence","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.art-yi.com\/fr\/","email":"info@art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":"+32 474 70 04 07","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50003319"},"nl":{"name":"Sophie Verger: Whispers of Innocence","shortdescr":"In het hart van Brussel, presenteert de Art Yi met trots een buitengewone reis naar het rijk van grillige wezens en vergeten onschuld. \"Fluisteringen van Onschuld\" nodigt je uit om binnen te treden in de betoverende wereld van de Franse kunstenares Sophie Verger, waar de verbeelding geen grenzen kent en de verwondering van de kindertijd herboren wordt in prachtige dierlijke beeldhouwwerken.","longdescr":"Sophie Verger werd geboren in Parijs in 1953. \n\n\u2022 Het is een zeer oud verhaal, misschien een mythe, misschien niet, toen de aarde een tuin was waarin ze in vrede leefden, een tijdperk van harmonie en spel: de kindertijd van de wereld. De dieren herinneren zich het verloren paradijs, de Tuin van Eden, die alleen kan worden bereikt via het pad van de kindertijd en die alleen kan worden geglimpst met een blik die niet wordt gehinderd door de lelijkheid van de tegenwoordige tijd.\n \n\u2022 Hier leidt Sophie Verger ons, tussen de beesten van het museum, in een rustige wereld waar vrede en zorgeloos geluk heersen... zorgeloos, het is nodig om de Wetten van de Zwaartekracht te trotseren, zoals haar modellen vaak doen: waar kunst regeert, is met een krachtige geest niets onmogelijk.","performers":"\u2022 OPENING: DO 19\/10, 19:00 - 21:00, ONTMOET SOPHIE!\n\u2022 WANNEER: 19\/10 - 09\/11\/2022\n\u2022 WAT: 40 DIERENBEELDEN, NIEUW IN 2023\n\n59 RUE DE LA MADELEINE, 1000, BRUSSELS\nELKE DAG, BEHALVE WOENSDAG\nWEEKDAGEN: 11:00 - 18:00; WEEKENDS: 12:00 - 19:00 UUR\nWWW.ART-YI.COM\n\n\u2022 HOE TE BEREIKEN:\nStation (Trein\/Metro): Brussel-Centraal\nParkeerplaats: Interparking Albertine Square (100m)\n3 Rue des Sols | 1000 | Brussel","boxoffice_url":null,"website":"https:\/\/www.art-yi.com\/nl\/","email":"info@art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":"+32 474 70 04 07","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50003319"}},"place":{"id":279896,"translations":{"de":{"name":"Art Yi","address_street_name":"Rue de la Madeleine","address_street_number":"59","address_street_box":null,"email":"info@art-yi.com","website":"https:\/\/www.art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Madeleine, 59","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Art Yi","address_street_name":"Rue de la Madeleine","address_street_number":"59","address_street_box":null,"email":"info@art-yi.com","website":"https:\/\/www.art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Madeleine, 59","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Art Yi","address_street_name":"Rue de la Madeleine","address_street_number":"59","address_street_box":null,"email":"info@art-yi.com","website":"https:\/\/www.art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Madeleine, 59","address_line2":"1000 Bruxelles","description_web":"\u2022 Located at Monts des Arts Museum area and Brussels-Central station, close to the Grand-Place, Art Y\u012b is a contemporary art gallery that receives millions of international tourists passing by every year and serve art collectors from all over the world.\r\n \r\n\u2022 Art Y\u012b offers a unique experience of contemporary art from different cultures. The gallery showcases a wide selection of sculptures and paintings from Europe and Asia. Founded by Shuo LIU, Art Y\u012b has a rich heritage of a 40 years of Belgian gallery.\r\n\r\nOur 5 categories\r\n\u2022 Sculptures\r\n\u2022 Paintings\r\n\u2022 Installation art\r\n\u2022 Ceramics\r\n\u2022 Antiques\r\n\r\n\u2022 An art of fusion, a travel from tradition to contemporary, from the East to the West, leading to a diversity that live outside time and space. We propose a unique version of contemporary art that that talks to everyone at a universal language. \r\n\r\n\u2022 Whether you are an experienced collector or just beginning to explore the world of art, for professional purpose or private collection, we have something to offer. Our collection features a diverse selection of high-quality artwork, ranging from contemporary to traditional pieces. We carefully curate each piece to ensure that it meets our high standards of quality and excellence.\r\n \r\n\u2022 At Art Y\u012b, in addition to our exceptional collection,we are committed to providing our clients with an unparalleled experience. Acquiring a work of art is a unique moment. In order to make this magic possible, Art Y\u012b offers different financing solutions like Art Leasing and\/or Art Renting with an option to buy that can best fit professional profile and acquire art in additional advantages. Our team of experts is always available to provide personalized guidance and assistance, from selecting the perfect piece to finding the best financial solutions.\r\n \r\n\u2022 At Art Y\u012b, we are passionate about art and committed to providing our clients with the very best. Join us on our mission to bring art to the world and discover the exclusive advantages of collecting art with us: \r\n- Receive our personalized membership offer for your 1st Collection !\r\n- Enjoy Free Global Art Shipping\r\n- Have first access to our New Arts & Exhibitions\r\n- Attend our Vernigssages & Art fairs with VIP Entry","description_print":"\u2022 Located at Monts des Arts Museum area and Brussels-Central station, close to the Grand-Place, Art Y\u012b is a contemporary art gallery that receives millions of international tourists passing by every year and serve art collectors from all over the world.\r\n \r\n\u2022 Art Y\u012b offers a unique experience of contemporary art from different cultures. The gallery showcases a wide selection of sculptures and paintings from Europe and Asia. Founded by Shuo LIU, Art Y\u012b has a rich heritage of a 40 years of Belgian gallery.\r\n\r\nOur 5 categories\r\n\u2022 Sculptures\r\n\u2022 Paintings\r\n\u2022 Installation art\r\n\u2022 Ceramics\r\n\u2022 Antiques\r\n\r\n\u2022 An art of fusion, a travel from tradition to contemporary, from the East to the West, leading to a diversity that live outside time and space. We propose a unique version of contemporary art that that talks to everyone at a universal language. \r\n\r\n\u2022 Whether you are an experienced collector or just beginning to explore the world of art, for professional purpose or private collection, we have something to offer. Our collection features a diverse selection of high-quality artwork, ranging from contemporary to traditional pieces. We carefully curate each piece to ensure that it meets our high standards of quality and excellence.\r\n \r\n\u2022 At Art Y\u012b, in addition to our exceptional collection,we are committed to providing our clients with an unparalleled experience. Acquiring a work of art is a unique moment. In order to make this magic possible, Art Y\u012b offers different financing solutions like Art Leasing and\/or Art Renting with an option to buy that can best fit professional profile and acquire art in additional advantages. Our team of experts is always available to provide personalized guidance and assistance, from selecting the perfect piece to finding the best financial solutions.\r\n \r\n\u2022 At Art Y\u012b, we are passionate about art and committed to providing our clients with the very best. Join us on our mission to bring art to the world and discover the exclusive advantages of collecting art with us: \r\n- Receive our personalized membership offer for your 1st Collection !\r\n- Enjoy Free Global Art Shipping\r\n- Have first access to our New Arts & Exhibitions\r\n- Attend our Vernigssages & Art fairs with VIP Entry","booking_url":null,"sort_order":null,"virtual_visit":"https:\/\/www.art-yi.com"},"it":{"name":"Art Yi","address_street_name":"Rue de la Madeleine","address_street_number":"59","address_street_box":null,"email":"info@art-yi.com","website":"https:\/\/www.art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Madeleine, 59","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Art Yi","address_street_name":"Rue de la Madeleine","address_street_number":"59","address_street_box":null,"email":"info@art-yi.com","website":"https:\/\/www.art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Madeleine, 59","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"fr":{"name":"Art Yi","address_street_name":"Rue de la Madeleine","address_street_number":"59","address_street_box":null,"email":"info@art-yi.com","website":"https:\/\/www.art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Madeleine, 59","address_line2":"1000 Bruxelles","description_web":"\u2022 Situ\u00e9 dans la zone du Mus\u00e9e des Monts des Arts et de la gare centrale de Bruxelles, \u00e0 proximit\u00e9 de la Grand-Place, Art Y\u012b est une galerie d'art contemporain qui re\u00e7oit des millions de touristes internationaux qui passent chaque ann\u00e9e et sert des collectionneurs d'art du monde entier.\r\n \r\n\u2022 Art Y\u012b offre une exp\u00e9rience unique de l'art contemporain de diff\u00e9rentes cultures. La galerie pr\u00e9sente une large s\u00e9lection de sculptures et de peintures d'Europe et d'Asie. Fond\u00e9e par Shuo LIU, Art Y\u012b a une riche histoire de 40 ans de galerie belge.\r\n\r\nNos 5 cat\u00e9goies\r\n\u2022 Sculptures\r\n\u2022 Peintures\r\n\u2022 Art d'installation\r\n\u2022 C\u00e9ramiques \r\n\u2022 Antiquit\u00e9s\r\n\r\n\u2022 Une forme d'art de fusion, un voyage de la tradition \u00e0 la contemporaine, de l'Est \u00e0 l'Ouest, menant \u00e0 une diversit\u00e9 qui vit en dehors du temps et de l'espace. Nous proposons une version unique de l'art contemporain qui parle \u00e0 tout le monde dans une langue universelle.\r\n\r\n\u2022 Que vous soyez un collectionneur exp\u00e9riment\u00e9 ou que vous commenciez \u00e0 explorer le monde de l'art, \u00e0 des fins professionnelles ou \u00e0 des fins de collection priv\u00e9e, nous avons quelque chose \u00e0 offrir. Notre collection comprend une s\u00e9lection vari\u00e9e d'\u0153uvres d'art de haute qualit\u00e9, allant du contemporain au traditionnel. Nous s\u00e9lectionnons soigneusement chaque pi\u00e8ce pour nous assurer qu'elle r\u00e9pond \u00e0 nos hauts standards de qualit\u00e9 et d'excellence.\r\n \r\n\u2022 Chez Art Y\u012b, en plus de notre collection exceptionnelle, nous nous engageons \u00e0 offrir \u00e0 nos clients une exp\u00e9rience in\u00e9gal\u00e9e. L'acquisition d'une \u0153uvre d'art est un moment unique. Afin de rendre ce moment magique possible, Art Y\u012b propose diff\u00e9rentes solutions de financement telles que le leasing et\/ou le renting d'art avec une option d'achat qui peut mieux s'adapter au profil professionnel et acqu\u00e9rir de l'art avec des avantages suppl\u00e9mentaires. Notre \u00e9quipe d'experts est toujours disponible pour fournir une orientation et une assistance personnalis\u00e9es, de la s\u00e9lection de la pi\u00e8ce parfaite \u00e0 la recherche des meilleures solutions financi\u00e8res.\r\n \r\n\u2022 Chez Art Y\u012b, nous sommes passionn\u00e9s par l'art et nous nous engageons \u00e0 offrir \u00e0 nos clients le meilleur. Rejoignez-nous dans notre mission d'apporter de l'art au monde et d\u00e9couvrez les avantages exclusifs de la collection d'art avec nous : \r\n- Recevez notre offre de membre personnalis\u00e9e pour votre 1\u00e8re Collection !\r\n- Profitez de la livraison gratuite mondial\r\n- Ayez un premier acc\u00e8s \u00e0 nos nouvelles \u0153uvres d'art et expositions\r\n- Assistez \u00e0 nos Vernigssages et foires d'art avec une entr\u00e9e VIP","description_print":"\u2022 Situ\u00e9 dans la zone du Mus\u00e9e des Monts des Arts et de la gare centrale de Bruxelles, \u00e0 proximit\u00e9 de la Grand-Place, Art Y\u012b est une galerie d'art contemporain qui re\u00e7oit des millions de touristes internationaux qui passent chaque ann\u00e9e et sert des collectionneurs d'art du monde entier.\r\n \r\n\u2022 Art Y\u012b offre une exp\u00e9rience unique de l'art contemporain de diff\u00e9rentes cultures. La galerie pr\u00e9sente une large s\u00e9lection de sculptures et de peintures d'Europe et d'Asie. Fond\u00e9e par Shuo LIU, Art Y\u012b a une riche histoire de 40 ans de galerie belge.\r\n\r\nNos 5 cat\u00e9goies\r\n\u2022 Sculptures\r\n\u2022 Peintures\r\n\u2022 Art d'installation\r\n\u2022 C\u00e9ramiques \r\n\u2022 Antiquit\u00e9s\r\n\r\n\u2022 Une forme d'art de fusion, un voyage de la tradition \u00e0 la contemporaine, de l'Est \u00e0 l'Ouest, menant \u00e0 une diversit\u00e9 qui vit en dehors du temps et de l'espace. Nous proposons une version unique de l'art contemporain qui parle \u00e0 tout le monde dans une langue universelle.\r\n\r\n\u2022 Que vous soyez un collectionneur exp\u00e9riment\u00e9 ou que vous commenciez \u00e0 explorer le monde de l'art, \u00e0 des fins professionnelles ou \u00e0 des fins de collection priv\u00e9e, nous avons quelque chose \u00e0 offrir. Notre collection comprend une s\u00e9lection vari\u00e9e d'\u0153uvres d'art de haute qualit\u00e9, allant du contemporain au traditionnel. Nous s\u00e9lectionnons soigneusement chaque pi\u00e8ce pour nous assurer qu'elle r\u00e9pond \u00e0 nos hauts standards de qualit\u00e9 et d'excellence.\r\n \r\n\u2022 Chez Art Y\u012b, en plus de notre collection exceptionnelle, nous nous engageons \u00e0 offrir \u00e0 nos clients une exp\u00e9rience in\u00e9gal\u00e9e. L'acquisition d'une \u0153uvre d'art est un moment unique. Afin de rendre ce moment magique possible, Art Y\u012b propose diff\u00e9rentes solutions de financement telles que le leasing et\/ou le renting d'art avec une option d'achat qui peut mieux s'adapter au profil professionnel et acqu\u00e9rir de l'art avec des avantages suppl\u00e9mentaires. Notre \u00e9quipe d'experts est toujours disponible pour fournir une orientation et une assistance personnalis\u00e9es, de la s\u00e9lection de la pi\u00e8ce parfaite \u00e0 la recherche des meilleures solutions financi\u00e8res.\r\n \r\n\u2022 Chez Art Y\u012b, nous sommes passionn\u00e9s par l'art et nous nous engageons \u00e0 offrir \u00e0 nos clients le meilleur. Rejoignez-nous dans notre mission d'apporter de l'art au monde et d\u00e9couvrez les avantages exclusifs de la collection d'art avec nous : \r\n- Recevez notre offre de membre personnalis\u00e9e pour votre 1\u00e8re Collection !\r\n- Profitez de la livraison gratuite mondial\r\n- Ayez un premier acc\u00e8s \u00e0 nos nouvelles \u0153uvres d'art et expositions\r\n- Assistez \u00e0 nos Vernigssages et foires d'art avec une entr\u00e9e VIP","booking_url":null,"sort_order":null,"virtual_visit":"https:\/\/www.art-yi.com\/fr\/"},"sp":{"name":"Art Yi","address_street_name":"Rue de la Madeleine","address_street_number":"59","address_street_box":null,"email":"info@art-yi.com","website":"https:\/\/www.art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Madeleine, 59","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Art Yi","address_street_name":"Magdalenasteenweg","address_street_number":"59","address_street_box":null,"email":"info@art-yi.com","website":"https:\/\/www.art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Magdalenasteenweg, 59","address_line2":"1000 Bruxelles","description_web":" Gelegen in het Monts des Arts Museum gebied en vlakbij het Brussel-Centraal station en de Grote Markt, is Art Y\u012b een hedendaagse kunstgalerie die jaarlijks miljoenen internationale toeristen ontvangt en kunstverzamelaars van over de hele wereld bedient.\r\n \r\n\u2022 Art Y\u012b biedt een unieke ervaring van hedendaagse kunst uit verschillende culturen. De galerie presenteert een brede selectie van beeldhouwwerken en schilderijen uit Europa en Azi\u00eb. Opgericht door Shuo LIU, heeft Art Y\u012b een rijke erfenis van 40 jaar Belgische galerie.\r\n\r\nOnze 5 categorie\u00ebn\r\n\u2022 Beeldhouwwerken\r\n\u2022 Schilderijen\r\n\u2022 Installatie kunst\r\n\u2022 Keramiek\r\n\u2022 Antiek\r\n\r\n\u2022 Een vorm van samensmelting in de kunst, een reis van traditie naar hedendaags, van oost naar west, leidend tot diversiteit die buiten tijd en ruimte leeft. We bieden een unieke versie van hedendaagse kunst die spreekt tot iedereen in een universele taal. \r\n\r\n\u2022 Of u nu een ervaren verzamelaar bent of pas begint met het verkennen van de kunstwereld, voor professionele doeleinden of priv\u00e9verzameling, we hebben iets te bieden. Onze collectie omvat een diverse selectie van hoogwaardige kunstwerken, vari\u00ebrend van hedendaagse tot traditionele stukken. We stellen elke kunstwerk zorgvuldig samen om ervoor te zorgen dat het voldoet aan onze hoge normen van kwaliteit en excellentie.\r\n \r\n\u2022 Bij Art Y\u012b, naast onze uitzonderlijke collectie, zijn we toegewijd aan het bieden van een onge\u00ebvenaarde ervaring aan onze klanten. Het verwerven van een kunstwerk is een uniek moment. Om deze magie mogelijk te maken, biedt Art Y\u012b verschillende financieringsoplossingen zoals Art Leasing en\/of Art Renting met een koopoptie die het best past bij het professionele profiel en voordelen biedt om kunst te verwerven. Ons team van experts staat altijd klaar om persoonlijke begeleiding en ondersteuning te bieden, van het selecteren van het perfecte stuk tot het vinden van de beste financi\u00eble oplossingen.\r\n \r\n\u2022 Bij Art Y\u012b zijn we gepassioneerd door kunst en toegewijd om onze klanten het allerbeste te bieden. Sluit u aan bij ons op onze missie om kunst naar de wereld te brengen en ontdek de exclusieve voordelen van het verzamelen van kunst bij ons:\r\n- Ontvang ons gepersonaliseerde lidmaatschapsaanbod voor uw 1e collectie!\r\n- Geniet van gratis wereldwijde kunstverzending\r\n- Heb als eerste toegang tot onze nieuwe kunstwerken & tentoonstellingen\r\n- Woon onze Vernissages & Kunstbeurzen bij met VIP-toegang","description_print":" Gelegen in het Monts des Arts Museum gebied en vlakbij het Brussel-Centraal station en de Grote Markt, is Art Y\u012b een hedendaagse kunstgalerie die jaarlijks miljoenen internationale toeristen ontvangt en kunstverzamelaars van over de hele wereld bedient.\r\n \r\n\u2022 Art Y\u012b biedt een unieke ervaring van hedendaagse kunst uit verschillende culturen. De galerie presenteert een brede selectie van beeldhouwwerken en schilderijen uit Europa en Azi\u00eb. Opgericht door Shuo LIU, heeft Art Y\u012b een rijke erfenis van 40 jaar Belgische galerie.\r\n\r\nOnze 5 categorie\u00ebn\r\n\u2022 Beeldhouwwerken\r\n\u2022 Schilderijen\r\n\u2022 Installatie kunst\r\n\u2022 Keramiek\r\n\u2022 Antiek\r\n\r\n\u2022 Een vorm van samensmelting in de kunst, een reis van traditie naar hedendaags, van oost naar west, leidend tot diversiteit die buiten tijd en ruimte leeft. We bieden een unieke versie van hedendaagse kunst die spreekt tot iedereen in een universele taal. \r\n\r\n\u2022 Of u nu een ervaren verzamelaar bent of pas begint met het verkennen van de kunstwereld, voor professionele doeleinden of priv\u00e9verzameling, we hebben iets te bieden. Onze collectie omvat een diverse selectie van hoogwaardige kunstwerken, vari\u00ebrend van hedendaagse tot traditionele stukken. We stellen elke kunstwerk zorgvuldig samen om ervoor te zorgen dat het voldoet aan onze hoge normen van kwaliteit en excellentie.\r\n \r\n\u2022 Bij Art Y\u012b, naast onze uitzonderlijke collectie, zijn we toegewijd aan het bieden van een onge\u00ebvenaarde ervaring aan onze klanten. Het verwerven van een kunstwerk is een uniek moment. Om deze magie mogelijk te maken, biedt Art Y\u012b verschillende financieringsoplossingen zoals Art Leasing en\/of Art Renting met een koopoptie die het best past bij het professionele profiel en voordelen biedt om kunst te verwerven. Ons team van experts staat altijd klaar om persoonlijke begeleiding en ondersteuning te bieden, van het selecteren van het perfecte stuk tot het vinden van de beste financi\u00eble oplossingen.\r\n \r\n\u2022 Bij Art Y\u012b zijn we gepassioneerd door kunst en toegewijd om onze klanten het allerbeste te bieden. Sluit u aan bij ons op onze missie om kunst naar de wereld te brengen en ontdek de exclusieve voordelen van het verzamelen van kunst bij ons:\r\n- Ontvang ons gepersonaliseerde lidmaatschapsaanbod voor uw 1e collectie!\r\n- Geniet van gratis wereldwijde kunstverzending\r\n- Heb als eerste toegang tot onze nieuwe kunstwerken & tentoonstellingen\r\n- Woon onze Vernissages & Kunstbeurzen bij met VIP-toegang","booking_url":null,"sort_order":null,"virtual_visit":"https:\/\/www.art-yi.com\/nl\/"}},"districts":{"list":[13],"translations":{"de":["Historisches Stadtzentrum"],"pt":[null],"en":["Historical Centre"],"it":["Centro storico"],"cn":[null],"fr":["Centre historique"],"sp":["Centro hist\u00f3rico"],"nl":["Historisch centrum"]}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":null,"facebook_id":null,"backoffice_id":39896,"location":{"lat":50.84475553,"lon":4.35527958},"region":"brussels","last_updated_at":"2023-05-11T15:22:17+02:00","published_at":"2023-02-01T13:55:51+01:00","import_origin":null,"external_id":null,"is_in_address_book":false,"is_in_vb_export":false,"resto_ranking":0},"organizer":{"id":279896,"translations":{"de":{"name":"Art Yi","address_street_name":"Rue de la Madeleine","address_street_number":"59","address_street_box":null,"email":"info@art-yi.com","website":"https:\/\/www.art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Madeleine, 59","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Art Yi","address_street_name":"Rue de la Madeleine","address_street_number":"59","address_street_box":null,"email":"info@art-yi.com","website":"https:\/\/www.art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Madeleine, 59","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Art Yi","address_street_name":"Rue de la Madeleine","address_street_number":"59","address_street_box":null,"email":"info@art-yi.com","website":"https:\/\/www.art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Madeleine, 59","address_line2":"1000 Bruxelles","description_web":"\u2022 Located at Monts des Arts Museum area and Brussels-Central station, close to the Grand-Place, Art Y\u012b is a contemporary art gallery that receives millions of international tourists passing by every year and serve art collectors from all over the world.\r\n \r\n\u2022 Art Y\u012b offers a unique experience of contemporary art from different cultures. The gallery showcases a wide selection of sculptures and paintings from Europe and Asia. Founded by Shuo LIU, Art Y\u012b has a rich heritage of a 40 years of Belgian gallery.\r\n\r\nOur 5 categories\r\n\u2022 Sculptures\r\n\u2022 Paintings\r\n\u2022 Installation art\r\n\u2022 Ceramics\r\n\u2022 Antiques\r\n\r\n\u2022 An art of fusion, a travel from tradition to contemporary, from the East to the West, leading to a diversity that live outside time and space. We propose a unique version of contemporary art that that talks to everyone at a universal language. \r\n\r\n\u2022 Whether you are an experienced collector or just beginning to explore the world of art, for professional purpose or private collection, we have something to offer. Our collection features a diverse selection of high-quality artwork, ranging from contemporary to traditional pieces. We carefully curate each piece to ensure that it meets our high standards of quality and excellence.\r\n \r\n\u2022 At Art Y\u012b, in addition to our exceptional collection,we are committed to providing our clients with an unparalleled experience. Acquiring a work of art is a unique moment. In order to make this magic possible, Art Y\u012b offers different financing solutions like Art Leasing and\/or Art Renting with an option to buy that can best fit professional profile and acquire art in additional advantages. Our team of experts is always available to provide personalized guidance and assistance, from selecting the perfect piece to finding the best financial solutions.\r\n \r\n\u2022 At Art Y\u012b, we are passionate about art and committed to providing our clients with the very best. Join us on our mission to bring art to the world and discover the exclusive advantages of collecting art with us: \r\n- Receive our personalized membership offer for your 1st Collection !\r\n- Enjoy Free Global Art Shipping\r\n- Have first access to our New Arts & Exhibitions\r\n- Attend our Vernigssages & Art fairs with VIP Entry","description_print":"\u2022 Located at Monts des Arts Museum area and Brussels-Central station, close to the Grand-Place, Art Y\u012b is a contemporary art gallery that receives millions of international tourists passing by every year and serve art collectors from all over the world.\r\n \r\n\u2022 Art Y\u012b offers a unique experience of contemporary art from different cultures. The gallery showcases a wide selection of sculptures and paintings from Europe and Asia. Founded by Shuo LIU, Art Y\u012b has a rich heritage of a 40 years of Belgian gallery.\r\n\r\nOur 5 categories\r\n\u2022 Sculptures\r\n\u2022 Paintings\r\n\u2022 Installation art\r\n\u2022 Ceramics\r\n\u2022 Antiques\r\n\r\n\u2022 An art of fusion, a travel from tradition to contemporary, from the East to the West, leading to a diversity that live outside time and space. We propose a unique version of contemporary art that that talks to everyone at a universal language. \r\n\r\n\u2022 Whether you are an experienced collector or just beginning to explore the world of art, for professional purpose or private collection, we have something to offer. Our collection features a diverse selection of high-quality artwork, ranging from contemporary to traditional pieces. We carefully curate each piece to ensure that it meets our high standards of quality and excellence.\r\n \r\n\u2022 At Art Y\u012b, in addition to our exceptional collection,we are committed to providing our clients with an unparalleled experience. Acquiring a work of art is a unique moment. In order to make this magic possible, Art Y\u012b offers different financing solutions like Art Leasing and\/or Art Renting with an option to buy that can best fit professional profile and acquire art in additional advantages. Our team of experts is always available to provide personalized guidance and assistance, from selecting the perfect piece to finding the best financial solutions.\r\n \r\n\u2022 At Art Y\u012b, we are passionate about art and committed to providing our clients with the very best. Join us on our mission to bring art to the world and discover the exclusive advantages of collecting art with us: \r\n- Receive our personalized membership offer for your 1st Collection !\r\n- Enjoy Free Global Art Shipping\r\n- Have first access to our New Arts & Exhibitions\r\n- Attend our Vernigssages & Art fairs with VIP Entry","booking_url":null,"sort_order":null,"virtual_visit":"https:\/\/www.art-yi.com"},"it":{"name":"Art Yi","address_street_name":"Rue de la Madeleine","address_street_number":"59","address_street_box":null,"email":"info@art-yi.com","website":"https:\/\/www.art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Madeleine, 59","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Art Yi","address_street_name":"Rue de la Madeleine","address_street_number":"59","address_street_box":null,"email":"info@art-yi.com","website":"https:\/\/www.art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Madeleine, 59","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"fr":{"name":"Art Yi","address_street_name":"Rue de la Madeleine","address_street_number":"59","address_street_box":null,"email":"info@art-yi.com","website":"https:\/\/www.art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Madeleine, 59","address_line2":"1000 Bruxelles","description_web":"\u2022 Situ\u00e9 dans la zone du Mus\u00e9e des Monts des Arts et de la gare centrale de Bruxelles, \u00e0 proximit\u00e9 de la Grand-Place, Art Y\u012b est une galerie d'art contemporain qui re\u00e7oit des millions de touristes internationaux qui passent chaque ann\u00e9e et sert des collectionneurs d'art du monde entier.\r\n \r\n\u2022 Art Y\u012b offre une exp\u00e9rience unique de l'art contemporain de diff\u00e9rentes cultures. La galerie pr\u00e9sente une large s\u00e9lection de sculptures et de peintures d'Europe et d'Asie. Fond\u00e9e par Shuo LIU, Art Y\u012b a une riche histoire de 40 ans de galerie belge.\r\n\r\nNos 5 cat\u00e9goies\r\n\u2022 Sculptures\r\n\u2022 Peintures\r\n\u2022 Art d'installation\r\n\u2022 C\u00e9ramiques \r\n\u2022 Antiquit\u00e9s\r\n\r\n\u2022 Une forme d'art de fusion, un voyage de la tradition \u00e0 la contemporaine, de l'Est \u00e0 l'Ouest, menant \u00e0 une diversit\u00e9 qui vit en dehors du temps et de l'espace. Nous proposons une version unique de l'art contemporain qui parle \u00e0 tout le monde dans une langue universelle.\r\n\r\n\u2022 Que vous soyez un collectionneur exp\u00e9riment\u00e9 ou que vous commenciez \u00e0 explorer le monde de l'art, \u00e0 des fins professionnelles ou \u00e0 des fins de collection priv\u00e9e, nous avons quelque chose \u00e0 offrir. Notre collection comprend une s\u00e9lection vari\u00e9e d'\u0153uvres d'art de haute qualit\u00e9, allant du contemporain au traditionnel. Nous s\u00e9lectionnons soigneusement chaque pi\u00e8ce pour nous assurer qu'elle r\u00e9pond \u00e0 nos hauts standards de qualit\u00e9 et d'excellence.\r\n \r\n\u2022 Chez Art Y\u012b, en plus de notre collection exceptionnelle, nous nous engageons \u00e0 offrir \u00e0 nos clients une exp\u00e9rience in\u00e9gal\u00e9e. L'acquisition d'une \u0153uvre d'art est un moment unique. Afin de rendre ce moment magique possible, Art Y\u012b propose diff\u00e9rentes solutions de financement telles que le leasing et\/ou le renting d'art avec une option d'achat qui peut mieux s'adapter au profil professionnel et acqu\u00e9rir de l'art avec des avantages suppl\u00e9mentaires. Notre \u00e9quipe d'experts est toujours disponible pour fournir une orientation et une assistance personnalis\u00e9es, de la s\u00e9lection de la pi\u00e8ce parfaite \u00e0 la recherche des meilleures solutions financi\u00e8res.\r\n \r\n\u2022 Chez Art Y\u012b, nous sommes passionn\u00e9s par l'art et nous nous engageons \u00e0 offrir \u00e0 nos clients le meilleur. Rejoignez-nous dans notre mission d'apporter de l'art au monde et d\u00e9couvrez les avantages exclusifs de la collection d'art avec nous : \r\n- Recevez notre offre de membre personnalis\u00e9e pour votre 1\u00e8re Collection !\r\n- Profitez de la livraison gratuite mondial\r\n- Ayez un premier acc\u00e8s \u00e0 nos nouvelles \u0153uvres d'art et expositions\r\n- Assistez \u00e0 nos Vernigssages et foires d'art avec une entr\u00e9e VIP","description_print":"\u2022 Situ\u00e9 dans la zone du Mus\u00e9e des Monts des Arts et de la gare centrale de Bruxelles, \u00e0 proximit\u00e9 de la Grand-Place, Art Y\u012b est une galerie d'art contemporain qui re\u00e7oit des millions de touristes internationaux qui passent chaque ann\u00e9e et sert des collectionneurs d'art du monde entier.\r\n \r\n\u2022 Art Y\u012b offre une exp\u00e9rience unique de l'art contemporain de diff\u00e9rentes cultures. La galerie pr\u00e9sente une large s\u00e9lection de sculptures et de peintures d'Europe et d'Asie. Fond\u00e9e par Shuo LIU, Art Y\u012b a une riche histoire de 40 ans de galerie belge.\r\n\r\nNos 5 cat\u00e9goies\r\n\u2022 Sculptures\r\n\u2022 Peintures\r\n\u2022 Art d'installation\r\n\u2022 C\u00e9ramiques \r\n\u2022 Antiquit\u00e9s\r\n\r\n\u2022 Une forme d'art de fusion, un voyage de la tradition \u00e0 la contemporaine, de l'Est \u00e0 l'Ouest, menant \u00e0 une diversit\u00e9 qui vit en dehors du temps et de l'espace. Nous proposons une version unique de l'art contemporain qui parle \u00e0 tout le monde dans une langue universelle.\r\n\r\n\u2022 Que vous soyez un collectionneur exp\u00e9riment\u00e9 ou que vous commenciez \u00e0 explorer le monde de l'art, \u00e0 des fins professionnelles ou \u00e0 des fins de collection priv\u00e9e, nous avons quelque chose \u00e0 offrir. Notre collection comprend une s\u00e9lection vari\u00e9e d'\u0153uvres d'art de haute qualit\u00e9, allant du contemporain au traditionnel. Nous s\u00e9lectionnons soigneusement chaque pi\u00e8ce pour nous assurer qu'elle r\u00e9pond \u00e0 nos hauts standards de qualit\u00e9 et d'excellence.\r\n \r\n\u2022 Chez Art Y\u012b, en plus de notre collection exceptionnelle, nous nous engageons \u00e0 offrir \u00e0 nos clients une exp\u00e9rience in\u00e9gal\u00e9e. L'acquisition d'une \u0153uvre d'art est un moment unique. Afin de rendre ce moment magique possible, Art Y\u012b propose diff\u00e9rentes solutions de financement telles que le leasing et\/ou le renting d'art avec une option d'achat qui peut mieux s'adapter au profil professionnel et acqu\u00e9rir de l'art avec des avantages suppl\u00e9mentaires. Notre \u00e9quipe d'experts est toujours disponible pour fournir une orientation et une assistance personnalis\u00e9es, de la s\u00e9lection de la pi\u00e8ce parfaite \u00e0 la recherche des meilleures solutions financi\u00e8res.\r\n \r\n\u2022 Chez Art Y\u012b, nous sommes passionn\u00e9s par l'art et nous nous engageons \u00e0 offrir \u00e0 nos clients le meilleur. Rejoignez-nous dans notre mission d'apporter de l'art au monde et d\u00e9couvrez les avantages exclusifs de la collection d'art avec nous : \r\n- Recevez notre offre de membre personnalis\u00e9e pour votre 1\u00e8re Collection !\r\n- Profitez de la livraison gratuite mondial\r\n- Ayez un premier acc\u00e8s \u00e0 nos nouvelles \u0153uvres d'art et expositions\r\n- Assistez \u00e0 nos Vernigssages et foires d'art avec une entr\u00e9e VIP","booking_url":null,"sort_order":null,"virtual_visit":"https:\/\/www.art-yi.com\/fr\/"},"sp":{"name":"Art Yi","address_street_name":"Rue de la Madeleine","address_street_number":"59","address_street_box":null,"email":"info@art-yi.com","website":"https:\/\/www.art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Madeleine, 59","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Art Yi","address_street_name":"Magdalenasteenweg","address_street_number":"59","address_street_box":null,"email":"info@art-yi.com","website":"https:\/\/www.art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Magdalenasteenweg, 59","address_line2":"1000 Bruxelles","description_web":" Gelegen in het Monts des Arts Museum gebied en vlakbij het Brussel-Centraal station en de Grote Markt, is Art Y\u012b een hedendaagse kunstgalerie die jaarlijks miljoenen internationale toeristen ontvangt en kunstverzamelaars van over de hele wereld bedient.\r\n \r\n\u2022 Art Y\u012b biedt een unieke ervaring van hedendaagse kunst uit verschillende culturen. De galerie presenteert een brede selectie van beeldhouwwerken en schilderijen uit Europa en Azi\u00eb. Opgericht door Shuo LIU, heeft Art Y\u012b een rijke erfenis van 40 jaar Belgische galerie.\r\n\r\nOnze 5 categorie\u00ebn\r\n\u2022 Beeldhouwwerken\r\n\u2022 Schilderijen\r\n\u2022 Installatie kunst\r\n\u2022 Keramiek\r\n\u2022 Antiek\r\n\r\n\u2022 Een vorm van samensmelting in de kunst, een reis van traditie naar hedendaags, van oost naar west, leidend tot diversiteit die buiten tijd en ruimte leeft. We bieden een unieke versie van hedendaagse kunst die spreekt tot iedereen in een universele taal. \r\n\r\n\u2022 Of u nu een ervaren verzamelaar bent of pas begint met het verkennen van de kunstwereld, voor professionele doeleinden of priv\u00e9verzameling, we hebben iets te bieden. Onze collectie omvat een diverse selectie van hoogwaardige kunstwerken, vari\u00ebrend van hedendaagse tot traditionele stukken. We stellen elke kunstwerk zorgvuldig samen om ervoor te zorgen dat het voldoet aan onze hoge normen van kwaliteit en excellentie.\r\n \r\n\u2022 Bij Art Y\u012b, naast onze uitzonderlijke collectie, zijn we toegewijd aan het bieden van een onge\u00ebvenaarde ervaring aan onze klanten. Het verwerven van een kunstwerk is een uniek moment. Om deze magie mogelijk te maken, biedt Art Y\u012b verschillende financieringsoplossingen zoals Art Leasing en\/of Art Renting met een koopoptie die het best past bij het professionele profiel en voordelen biedt om kunst te verwerven. Ons team van experts staat altijd klaar om persoonlijke begeleiding en ondersteuning te bieden, van het selecteren van het perfecte stuk tot het vinden van de beste financi\u00eble oplossingen.\r\n \r\n\u2022 Bij Art Y\u012b zijn we gepassioneerd door kunst en toegewijd om onze klanten het allerbeste te bieden. Sluit u aan bij ons op onze missie om kunst naar de wereld te brengen en ontdek de exclusieve voordelen van het verzamelen van kunst bij ons:\r\n- Ontvang ons gepersonaliseerde lidmaatschapsaanbod voor uw 1e collectie!\r\n- Geniet van gratis wereldwijde kunstverzending\r\n- Heb als eerste toegang tot onze nieuwe kunstwerken & tentoonstellingen\r\n- Woon onze Vernissages & Kunstbeurzen bij met VIP-toegang","description_print":" Gelegen in het Monts des Arts Museum gebied en vlakbij het Brussel-Centraal station en de Grote Markt, is Art Y\u012b een hedendaagse kunstgalerie die jaarlijks miljoenen internationale toeristen ontvangt en kunstverzamelaars van over de hele wereld bedient.\r\n \r\n\u2022 Art Y\u012b biedt een unieke ervaring van hedendaagse kunst uit verschillende culturen. De galerie presenteert een brede selectie van beeldhouwwerken en schilderijen uit Europa en Azi\u00eb. Opgericht door Shuo LIU, heeft Art Y\u012b een rijke erfenis van 40 jaar Belgische galerie.\r\n\r\nOnze 5 categorie\u00ebn\r\n\u2022 Beeldhouwwerken\r\n\u2022 Schilderijen\r\n\u2022 Installatie kunst\r\n\u2022 Keramiek\r\n\u2022 Antiek\r\n\r\n\u2022 Een vorm van samensmelting in de kunst, een reis van traditie naar hedendaags, van oost naar west, leidend tot diversiteit die buiten tijd en ruimte leeft. We bieden een unieke versie van hedendaagse kunst die spreekt tot iedereen in een universele taal. \r\n\r\n\u2022 Of u nu een ervaren verzamelaar bent of pas begint met het verkennen van de kunstwereld, voor professionele doeleinden of priv\u00e9verzameling, we hebben iets te bieden. Onze collectie omvat een diverse selectie van hoogwaardige kunstwerken, vari\u00ebrend van hedendaagse tot traditionele stukken. We stellen elke kunstwerk zorgvuldig samen om ervoor te zorgen dat het voldoet aan onze hoge normen van kwaliteit en excellentie.\r\n \r\n\u2022 Bij Art Y\u012b, naast onze uitzonderlijke collectie, zijn we toegewijd aan het bieden van een onge\u00ebvenaarde ervaring aan onze klanten. Het verwerven van een kunstwerk is een uniek moment. Om deze magie mogelijk te maken, biedt Art Y\u012b verschillende financieringsoplossingen zoals Art Leasing en\/of Art Renting met een koopoptie die het best past bij het professionele profiel en voordelen biedt om kunst te verwerven. Ons team van experts staat altijd klaar om persoonlijke begeleiding en ondersteuning te bieden, van het selecteren van het perfecte stuk tot het vinden van de beste financi\u00eble oplossingen.\r\n \r\n\u2022 Bij Art Y\u012b zijn we gepassioneerd door kunst en toegewijd om onze klanten het allerbeste te bieden. Sluit u aan bij ons op onze missie om kunst naar de wereld te brengen en ontdek de exclusieve voordelen van het verzamelen van kunst bij ons:\r\n- Ontvang ons gepersonaliseerde lidmaatschapsaanbod voor uw 1e collectie!\r\n- Geniet van gratis wereldwijde kunstverzending\r\n- Heb als eerste toegang tot onze nieuwe kunstwerken & tentoonstellingen\r\n- Woon onze Vernissages & Kunstbeurzen bij met VIP-toegang","booking_url":null,"sort_order":null,"virtual_visit":"https:\/\/www.art-yi.com\/nl\/"}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":39896,"location":{"lat":50.84475553,"lon":4.35527958},"last_updated_at":"2023-05-11T15:22:17+02:00","published_at":"2023-02-01T13:55:51+01:00","is_in_address_book":false,"is_in_vb_export":false,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{