val.be\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50007337"},"en":{"name":"inauguration of the Giant festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/immensefestival.be\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50007337"},"it":{"name":"inauguration of the Giant festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/immensefestival.be\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50007337"},"cn":{"name":"inauguration of the Giant festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/immensefestival.be\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50007337"},"fr":{"name":"Inauguration de L'immense festival","shortdescr":"Inauguration de L'immense festival : le Syndicat des immenses, \u00e0 l'initiative du projet, vous en jette plein la vue !\n\nVernissage de l'exposition No-home made.\nVernissage de l'exposition Syndicat des immenses : bilan et perspectives.\nVernissage de Pas une fatalit\u00e9 !\nVernissage de Les 4 piliers du sans-chez-soirisme persistant.","longdescr":"Inauguration de L'immense festival : le Syndicat des immenses, \u00e0 l'initiative du projet, vous en jette plein la vue !\n\n\u00c0 partir de 11h : Conf\u00e9rence de presse publique. Le Syndicat r\u00e9pond \u00e0 toutes vos questions.\n\nDe 17h \u00e0 21h :\n\n- Vernissage de l'exposition No-home made. Des \u0153uvres d'immenses pour dire l'immensit\u00e9 (= des personnes en non-logement ou mal-logement cr\u00e9ent pour dire la survie sans authentique chez-soi)\n- Vernissage de l'exposition Syndicat des immenses : bilan et perspectives. Apr\u00e8s 5 ans d'existence, le Syndicat exhibe ses archives pour h\u00e2ter la fin du sans-chez-soirisme\n- Vernissage de Pas une fatalit\u00e9 ! Depuis la coupole de la Bourse, le cri des immenses en mode intimiste\n- Vernissage de Les 4 piliers du sans-chez-soirisme persistant. Le Syndicat customise 4 colonnes de la Bourse pour graver 4 mots dans le cr\u00e2ne des Bruxelloi\u00b7ses\u00b7x","performers":"Le syndicat des Immenses","boxoffice_url":null,"website":"https:\/\/immensefestival.be\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50007337"},"sp":{"name":"inauguration of the Giant festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/immensefestival.be\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50007337"},"nl":{"name":"Inhuldiging van het Gigantisch festival","shortdescr":"Inhuldiging van het Gigantisch festival : de Vakbond der Giganten, die aan de de bron van het project staat, begint met grote trom !\nVernissage van de tentoonstelling No-home made.\nVernissage van de tentoonstelling Syndicat des immenses : bilan et perspectives.\nVernissage van Niet onvermijdelijk !\nVernissage van De 4 pijlers van de persistente thuisloosheid\nPublieke pers conferentie.","longdescr":"Inhuldiging van het Gigantisch festival : de Vakbond der Giganten, die aan de de bron van het project staat, begint met grote trom !\n\nVanaf 11 uur :\n- Vernissage van de tentoonstelling No-home made. Werken van giganten om het gigantisme te vertellen (= mensen zonder thuis of slecht behuisd creeren om het overleven zonder authentieke thuis te vertellen)\n- Vernissage van de tentoonstelling Syndicat des immenses : bilan et perspectives. (Vakbond der giganten: bilan en perspectieven) De vakbond bestaat reeds 5 jaar en stelt zijn archieven tentoon om het einde van de thuisloosheid te bespoedigen.\n- Vernissage van Pas une fatalit\u00e9 ! (Niet onvermijdelijk!) Vanaf de koepel van de Beurs, de schreeuw van de giganten op intieme wijze.\n- Vernissage van Les 4 piliers du sans-chez-soirisme persistant. (De 4 pijlers van de persistente thuisloosheid). De Vakbond customiseert de 4 zuilen van de Bourse om 4 woorden in de hoofden van de Brusselaars te bijtelen.\n- Publieke pers conferentie. De Vakbond antwoordt op al uw vragen.","performers":null,"boxoffice_url":null,"website":"https:\/\/immensefestival.be\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50007337"}},"place":{"id":50000495,"translations":{"de":{"name":"Bourse","address_street_name":"Place de la Bourse","address_street_number":null,"address_street_box":null,"email":null,"website":"https:\/\/beursbourse.be\/","phone_contact":"+32 2 279 29 64","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Bourse","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Bourse","address_street_name":"Place de la Bourse","address_street_number":null,"address_street_box":null,"email":null,"website":"https:\/\/beursbourse.be\/","phone_contact":"+32 2 279 29 64","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Bourse","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"La Bourse","address_street_name":"Beursplein","address_street_number":null,"address_street_box":null,"email":null,"website":"https:\/\/beursbourse.be\/en","phone_contact":"+32 2 279 29 64","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Beursplein","address_line2":"1000 Brussels","description_web":"La Bourse, a magnificent building that was originally conceived as a home to the financial markets, has currently been transformed into a recreational place for public use. Located in the heart of the city, La Bourse underwent a thorough renovation and it now accomodates Belgian Beer World. In addition, the building comprises spaces for young and old, a restaurant, a rooftop bar, an archaeological museum, co-working spaces, a shop and much more.\n\nThe Bourse building, following its spectacular transformation, is now even more of a vibrant meeting place for the people of Brussels and a must-see site for Belgian and international tourists. \n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Bourse","address_street_name":"Place de la Bourse","address_street_number":null,"address_street_box":null,"email":null,"website":"https:\/\/beursbourse.be\/","phone_contact":"+32 2 279 29 64","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Bourse","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Bourse","address_street_name":"Place de la Bourse","address_street_number":null,"address_street_box":null,"email":null,"website":"https:\/\/beursbourse.be\/","phone_contact":"+32 2 279 29 64","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Bourse","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"La Bourse","address_street_name":"Place de la Bourse","address_street_number":null,"address_street_box":null,"email":null,"website":"https:\/\/beursbourse.be\/","phone_contact":"+32 2 279 29 64","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Bourse","address_line2":"1000 Bruxelles","description_web":"La Bourse, un magnifique palais con\u00e7u au d\u00e9part pour la finance, s'est transform\u00e9e aujourd\u2019hui en espace de d\u00e9tente et de rencontre publique. Situ\u00e9e au c\u0153ur de Bruxelles la Bourse a \u00e9t\u00e9 repens\u00e9e et r\u00e9nov\u00e9e de la t\u00eate aux pieds. Elle abrite d\u00e9sormais le Belgian Beer World. Le b\u00e2timent comprend : un espace pour petits et grands, un restaurant, un bar en rooftop, un mus\u00e9e arch\u00e9ologique, des salles de co-working, un shop et bien plus encore.\n\nLe b\u00e2timent de la Bourse, apr\u00e8s sa brillante m\u00e9tamorphose, est un espace de vie convivial et un lieu d\u00e9sormais incontournable pour les visiteurs belges et \u00e9trangers. \n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Bourse","address_street_name":"Place de la Bourse","address_street_number":null,"address_street_box":null,"email":null,"website":"https:\/\/beursbourse.be\/","phone_contact":"+32 2 279 29 64","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Bourse","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"De Beurs","address_street_name":"Beursplein","address_street_number":null,"address_street_box":null,"email":null,"website":"https:\/\/beursbourse.be\/nl","phone_contact":"+32 2 279 29 64","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Beursplein","address_line2":"1000 Brussel","description_web":"De site omvat een indrukwekkend paleis dat oorspronkelijk ontworpen werd voor de handel, maar recent omgetoverd werd tot een openbare plek voor ontspanning en ontmoeting. De Beurs werd heruitgevonden en gerenoveerd, vanaf de kelders tot aan het spectaculaire dakterras. Ze herbergt nu ook Belgian Beer World, met een ruimte voor jong en oud, een plek om te eten en bier te degusteren, een rooftop, een archeologisch museum, coworkingruimtes, een shop en nog veel meer.\n\nHet beursgebouw, na de huidige, fenomenale metamorfose wordt het een uiterst gezellige plek en een niet te missen toeristische hotspot voor bezoekers uit binnen - en buitenland. \n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[3],"translations":{"de":["Dansaert\/Sainte-Catherine"],"pt":[null],"en":["Dansaert\/Sainte-Catherine"],"it":["Dansaert\/Sainte-Catherine"],"cn":[null],"fr":["Dansaert\/Sainte-Catherine"],"sp":["Dansaert\/Sainte-Catherine"],"nl":["Dansaertwijk\/Sint-Katelijne"]}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":null,"facebook_id":null,"backoffice_id":41239,"location":{"lat":50.8485722,"lon":4.3495865},"region":"brussels","last_updated_at":"2023-10-25T09:28:08+02:00","published_at":"2023-09-05T13:34:16+02:00","import_origin":null,"external_id":null,"is_in_address_book":false,"is_in_vb_export":false,"resto_ranking":0},"organizer":{"id":50001178,"translations":{"de":{"name":"Le syndicat des immenses","address_street_name":"Rue des V\u00e9t\u00e9rinaires","address_street_number":"74","address_street_box":null,"email":"karim.tall@syndicatdesimmenses.be","website":"https:\/\/immensefestival.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue des V\u00e9t\u00e9rinaires, 74","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Le syndicat des immenses","address_street_name":"Rue des V\u00e9t\u00e9rinaires","address_street_number":"74","address_stre