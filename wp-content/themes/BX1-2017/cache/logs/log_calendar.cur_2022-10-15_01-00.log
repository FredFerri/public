s_street_box":null,"email":null,"website":"http:\/\/www.kcb.be\/","phone_contact":"+32 2 213 41 10","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la R\u00e9gence","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Koninklijk Conservatorium van Brussel vzw","address_street_name":"Regentschapsstraat","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.kcb.be\/","phone_contact":"+32 2 213 41 10","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Regentschapsstraat","address_line2":"1000 Brussel","description_web":"Het Koninklijk Conservatorium Brussel (KCB) kent een lange traditie. De Vlaamse afdeling maakt thans deel uit van de Erasmushogeschool Brussel. Oorspronkelijk een Franstalig opleidingsinstituut, werd de instelling in 1967 taalkundig gesplitst. De Nederlandstalige en Franstalige afdeling delen hetzelfde gebouw en een aantal professoren. In de praktijk is het Brusselse conservatorium een smeltkroes van culturen en talen. Voor oude (voornamelijk barok) instrumenten heeft het conservatorium een wereldreputatie opgebouwd.\r\nHet KCB programmeert regelmatig concerten waarbij de studenten podiumkansen krijgen om hen vertrouwd te maken met het concertgebeuren in al zijn facetten. Wanneer zij er klaar voor zijn kunnen ze dan uitzwermen naar podia buiten... Daarvoor wordt samengewerkt met de verschillende Brusselse muziekorganisatoren waaronder Flagey, Ars Musica, Het Paleis voor Schone Kunsten van Brussel, het Muziekinstrumentenmuseum en anderen.  \r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Koninklijk Conservatorium van Brussel vzw","address_street_name":"Regentschapsstraat","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.kcb.be\/","phone_contact":"+32 