 11:00 \u00e0 19:00","dimanche: ferm\u00e9"],"nl":["maandag: gesloten","dinsdag, woensdag, donderdag, vrijdag en zaterdag: van 11:00 tot 19:00","zondag: gesloten"]},"date_start":"2025-01-18","date_end":"2025-03-08","is_also_by_appointment":false}],"date_exceptions":[],"closing_days":[],"child_events":[],"parent_events":[],"accessibilities":[],"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[],"opening":{"day":"2025-01-18","end":"19:00:00","start":"11:00:00","timestamp":"2025-01-18T11:00:00"}},{"id":5700005556,"date_start":"2025-01-23","date_end":"2025-03-29","date_next":"2025-02-28","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2025-02-28T01:01:55+01:00","published_at":"2025-01-20T17:24:00+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":316401,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"other","ranking":0.311765953881872,"languages":{"spoken":["en","fr","nl"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{}},"translations":{"de":{"name":"A Public Affair: Final Act","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/cloudseven.be","email":"info@cloudseven.be","phone_contact":"+32 470 38 28 30","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700005556"},"pt":{"name":"A Public Affair: Final Act","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/cloudseven.be","email":"info@cloudseven.be","phone_contact":"+32 470 38 28 30","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700005556"},"en":{"name":"A Public Affair: Final Act","shortdescr":"As part of the 9th edition of PhotoBrussels Festival, A Public Affair returns with a augmented selection, curated by Bayo Hassan Bello. Featuring  additional works by iconic and emerging artists, the exhibition deepens its exploration of intimacy and public space, offering fresh perspectives on their intersections, often charged with political, poignant, and dramatic undertones.","longdescr":"42 artworks originally featured in A Public Affair are now complemented by works from established artists such as Robert Mapplethorpe, Danh V\u014d, and Shirin Neshat, alongside a younger generation, such as Brussels-based L\u00e9a Belooussovitch or Yoel Pytowski, with an in situ installation. You will also find works from artists such as David Armstrong, David Brognon & St\u00e9phanie Rollin, Edgar Martins, Musa N. Nxumalo and Hank Willis Thomas.\n\nThese works, drawn from Fr\u00e9d\u00e9ric de Goldschmidt\u2019s collection, offer a unique perspective on the relationship between intimacy and public space. The exhibition, envisioned as a third chapter, creates a dialogue with its predecessors, A Private Affair and A Public Affair, exploring the transition from intimacy to exposed intimacy\u2014often imbued with poignant, politically charged, and sometimes dramatic struggles. How much violence must still be endured to preserve the softness of intimacy? \n\n*Other artists in the exhibition: Helena Almeida, Reza Aramesh, \u00c9ric Aupol, Younes Baba-Ali, Aline Bouvy, James Casebere, Laurie Charles, Aleskandra Chaushova, David Claerbout, Margaret Courtney-Clarke, Tacita Dean, Dries Depoorter, Romuald Hazoum\u00e8, Jan Henderikse, Hideyuki Ishibashi, Sven 't Jolle, Kapwani Kiwanga, Maria Kley, Michel Mazzoni, Jacqueline Mesmaeker, Terrence Musekiwa, Sophie Nys, Camille Orso, Michael Patterson-Carver, Carmen Re\u00e1tegui, Hiroshi Sugimoto, Barth\u00e9l\u00e9my Toguo, Isaac van Nikelen, Nico Williams, Ulla-Stina Wikander, Wiktoria Wojciechowska, and Yunyao Zhang.","performers":"Alvin Baltrop, L\u00e9a Belooussovitch, David Armstrong, David Brognon, Edgar Martins, Danh V\u014d, Robert Mapplethorpe, Musa N. Nxumalo, Shirin Neshat, St\u00e9phanie Rollin, Hank Willis Thomas, Yoel Pytowski.","boxoffice_url":null,"website":"https:\/\/cloudseven.be","email":"info@cloudseven.be","phone_contact":"+32 470 38 28 30","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700005556"},"it":{"name":"A Public Affair: Final Act","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/cloudseven.be","email":"info@cloudseven.be","phone_contact":"+32 470 38 28 30","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700005556"},"cn":{"name":"A Public Affair: Final Act","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/cloudseven.be","email":"info@cloudseven.be","phone_contact":"+32 470 38 28 30","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700005556"},"fr":{"name":"A Public Affair: Final Act","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/cloudseven.be","email":"info@cloudseven.be","phone_contact":"+32 470 38 28 30","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700005556"},"sp":{"name":"A Public Affair: Final Act","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/cloudseven.be","email":"info@cloudseven.be","phone_contact":"+32 470 38 28 30","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700005556"},"nl":{"name":"A Public Affair: Final Act","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/cloudseven.be","email":"info@cloudseven.be","phone_contact":"+32 470 38 28 30","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700005556"}},"place":{"id":277392,"translations":{"de":{"name":"Cloud Seven","address_street_name":"Quai du Commerce","address_street_number":"7","address_street_box":null,"email":"info@cloudseven.be","website":"http:\/\/www.cloudseven.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Quai du Commerce, 7","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Cloud Seven","address_street_name":"Quai du Commerce","address_street_number":"7","address_street_box":null,"email":"info@cloudseven.be","website":"http:\/\/www.cloudseven.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Quai du Commerce, 7","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Cloud Seven - Fr\u00e9d\u00e9ric de Goldschmidt Collection","address_street_name":"Handelskaai","address_street_number":"7","address_street_box":null,"email":"info@cloudseven.be","website":"https:\/\/cloudseven.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Handelskaai, 7","address_line2":"1000 Brussels","description_web":"Cloud Seven is a coworking, exhibition and residential hub located in downtown Brussels\u2019 fashion and design district. The space spans over seven floors and 1,500 square meters, and provides a coworking facility with a bar, meeting rooms, a multimedia room, a wellness center, exhibition spaces, a diverse cultural program, and private apartments for rental. Cloud Seven's aim is to bring a diverse and dynamic group of creative individuals together within a space that propels art into the office and home, and to inspire a culture that encourages collaboration.\r\n \r\nCloud Seven is home to the Fr\u00e9d\u00e9ric de Goldschmidt collection, which consists mostly of works by emerging artists in dialogue with pieces from historical movements in the 1960s and 70s including the Zero Group, Arte Povera, conceptual and minimal art. On one hand, many works in the collection explore reduced aesthetics with a great sensitivity to humble materials. On the other hand, a distinctive set of sober, geometric and monochromatic abstraction, such as the grid, are present. Themes of delegation, process, chance, combinatory, poetic language that critically describe the oddities in the world are considered in a large portion of the collection.\r\n\r\nOpening Hours Exhibition Space: Thursdays and Fridays 12:00-18:00 (Extended schedule during temporary exhibitions)\r\nOpening Hours Coworking Space: Monday to Friday 09:00-18:00","description_print":null,"booking_url":null,"sort_order":"Cloud","virtual_visit":null,"visit_url":null},"it":{"name":"Cloud Seven","address_street_name":"Quai du Commerce","address_street_number":"7","address_street_box":null,"email":"info@cloudseven.be","website":"http:\/\/www.cloudseven.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Quai du Commerce, 7","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Cloud Seven","address_street_name":"Quai du Commerce","address_street_number":"7","address_street_box":null,"email":"info@cloudseven.be","website":"http:\/\/www.cloudseven.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Quai du Commerce, 7","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Cloud Seven - collection Fr\u00e9d\u00e9ric de Goldschmidt","address_street_name":"Quai du Commerce","address_street_number":"7","address_street_box":null,"email":"info@cloudseven.be","website":"http:\/\/www.cloudseven.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Quai du Commerce, 7","address_line2":"1000 Bruxelles","description_web":"Avec son espace d\u2019exposition, le collectionneur Fr\u00e9d\u00e9ric de Goldschmidt a pris un tournant inattendu tout en ajoutant un atout arty de plus au quartier du Canal. Espace pluriel, Cloud Seven rassemble une galerie d\u2019art, des options de co-working, un bar et\u2026 une salle de gym dans un seul et m\u00eame b\u00e2timent ! Y aller, c\u2019est se donner l\u2019occasion de d\u00e9couvrir certaines des plus belles pi\u00e8ces de la collection de ce passionn\u00e9 d\u2019art contemporain dans un cadre \u00e9pur\u00e9. On y croise des \u0153uvres de Fabrice Samyn, des tissages color\u00e9s d\u2019Alighiero Boetti, mais aussi du Louise Bourgeois, du Lucio Fontana ainsi qu\u2019une belle s\u00e9lection d\u2019artistes \u00e9mergents.","description_print":null,"booking_url":null,"sort_order":"Cloud","virtual_visit":null,"visit_url":null},"sp":{"name":"Cloud Seven","address_street_name":"Quai du Commerce","address_street_number":"7","address_street_box":null,"email":"info@cloudseven.be","website":"http:\/\/www.cloudseven.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Quai du Commerce, 7","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Cloud Seven - collectie Fr\u00e9d\u00e9ric de Goldschmidt","address_street_name":"Handelskaai","address_street_number":"7","address_street_box":null,"email":"info@cloudseven.be","website":"http:\/\/www.cloudseven.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Handelskaai, 7","address_line2":"1000 Brussel","description_web":"Door zijn tentoonstellingsruimte te openen is verzamelaar Fr\u00e9d\u00e9ric de Goldschmidt een verrassende richting ingeslagen en is de Kanaalzone weer een kunstzinnige bezienswaardigheid rijker geworden. Cloud Seven is een veelzijdige plek, je vindt er een kunstgalerie, een coworkingruimte, een bar en ... een sportzaal onder \u00e9\u00e9n dak! Hier ontdek je enkele van de mooiste stukken uit de collectie van deze liefhebber van de moderne kunst in een strak kader. Er zijn bijvoorbeeld werken te bewonderen van Fabrice Samyn, kleurrijke weefkunst van Alighiero Boetti, werken van Louise Bourgeois, Lucio Fontana en een mooie selectie kunst van opkomende kunstenaars.","description_print":null,"booking_url":null,"sort_order":"Cloud","virtual_visit":null,"visit_url":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":"art_center","facebook_id":null,"backoffice_id":37392,"location":{"lat":50.8560861,"lon":4.3481363},"region":"brussels","last_updated_at":"2024-10-11T12:30:57+02:00","published_at":"2021-10-22T14:19:28+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":false,"resto_ranking":0},"organizer":{"id":277392,"translations":{"de":{"name":"Cloud Seven","address_street_name":"Quai du Commerce","address_street_number":"7","address_street_box":null,"email":"info@cloudseven.be","website":"http:\/\/www.cloudseven.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_c