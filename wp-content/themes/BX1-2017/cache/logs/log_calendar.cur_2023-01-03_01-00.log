Toegankelijk voor mensen met een verstandelijke beperking","Voorzieningen voor dove en slechthorende personen","Aangepast toilet"],"en":["Accessible to people with intellectual disabilities","Facilities for deaf and hearing-impaired people","Adapted toilet"],"de":["Barrierefrei f\u00fcr Menschen mit Verst\u00e4ndnisschwierigkeiten","Anpassungen f\u00fcr geh\u00f6rlose und h\u00f6rgesch\u00e4digte Menschen.","Barrierefreies WC"],"it":[null,null,null],"sp":[null,null,null],"pt":[null,null,null],"cn":[null,null,null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2023-01-02T01:35:42+01:00","published_at":"2022-12-28T11:26:54+01:00","backoffice_id":268139,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.35554124994461},{"id":548083,"date_start":"2022-12-01","date_end":"2023-01-19","date_next":"2023-01-02","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung","it":null,"sp":null,"pt":null,"cn":null}},"others":{"list":[24,27],"translations":{"fr":["Galeries d'art","Photographie"],"nl":["Galeries","Fotografie"],"en":["Art Galleries","Photography"],"de":["Kunstgalerien","Fotografie"],"it":[null,null],"sp":[null,null],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","en","nl"],"subtitles":[]},"translations":{"fr":{"name":"DDR-CCCP Souvenirs d'un monde disparu - Expo photos de Thierry Noville","shortdescr":"Une errance photographique \u00e0 la recherche des traces sovi\u00e9tiques autour de Berlin","longdescr":"DDR\/CCCP - Souvenirs d'un monde disparu \u2013 Exposition photos de Thierry Noville\r\nTrente ans apr\u00e8s la chute du mur, de nombreux souvenirs de la pr\u00e9sence\r\nsovi\u00e9tique subsistent encore en ex-Allemagne de l\u2019Est. Dissimul\u00e9es dans la for\u00eat ou perdues dans des friches, rong\u00e9es par les mousses et l'humidit\u00e9, d\u2019anciennes\r\ncasernes de l\u2019arm\u00e9e rouge abritent encore des lambeaux d\u2019histoire : des repr\u00e9sentations du camarade L\u00e9nine, des terrains de basket et des salles de\r\nspectacle ; des fresques \u00e0 la propagande mena\u00e7ante ou encore de na\u00efves\r\npeintures \u00e9gayant les chambr\u00e9es des soldats ; et puis tous ces objets du\r\nquotidien d\u00e9sormais inutiles...\r\nA travers ces photos, Thierry Noville nous invite \u00e0 le suivre \u00e0 la d\u00e9couverte de\r\nreliques d\u2019une \u00e9poque r\u00e9volue et pourtant pas si \u00e9loign\u00e9e.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.ddr-cccp.be","email":"thierrynoville@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.548083"},"nl":{"name":"DDR-CCCP Souvenirs d'un monde disparu - Foto tentoonstelling van Thierry Noville","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.548083"},"en":{"name":"DDR-CCCP Souvenirs d'un monde disparu - photo exhibition of Thierry Noville","shortdescr":null,"longdescr":"DDR \/CCCP Memories of a vanished world. A photography exhibition by Thierry\r\nNoville.\r\nNovember 1989, the Berlin wall fell. thirty years later, remnants of\r\nthe soviet occupation of East Germany are still to be found. Deep in the forest,\r\ncovered in rust an moss, old army barracks , with their auditoriums and\r\ngymnasiums, hide forgotten artefacts : Lenin busts, threatening propaganda or\r\nlighter paintings done by the soldiers to pass the time away in their dormitories ;\r\nalong with long discarded tools and ustensils.\r\nThrough his photographs, Thierry Noville gives us a tour of that not so distant era.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.548083"},"de":{"name":"DDR-CCCP Souvenirs d'un monde disparu - Expo phots de Thierry Noville","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.548083"},"it":{"name":"DDR-CCCP Souvenirs d'un monde disparu - Expo phots de Thierry Noville","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.548083"},"sp":{"name":"DDR-CCCP Souvenirs d'un monde disparu - Expo phots de Thierry Noville","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.548083"},"pt":{"name":"DDR-CCCP Souvenirs d'un monde disparu - Expo phots de Thierry Noville","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.548083"},"cn":{"name":"DDR-CCCP Souvenirs d'un monde disparu - Expo phots de Thierry Noville","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.548083"}},"place":{"id":279419,"translations":{"fr":{"name":"We Insist Boutique","address_street_name":"Rue Haute","address_street_number":"306","address_stree