es"},"nl":{"name":"Studenten"}},"value":10},{"translations":{"de":{"name":"Article 27"},"pt":{"name":"Article 27"},"en":{"name":"Article 27"},"it":{"name":"Article 27"},"cn":{"name":"Article 27"},"fr":{"name":"Article 27"},"sp":{"name":"Article 27"},"nl":{"name":"Artikel 27"}},"value":1.25}],"date_exceptions":[],"closing_days":[],"child_events":[],"parent_events":[],"accessibilities":[],"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[]},{"id":50008283,"date_start":"2024-03-21","date_end":"2024-04-28","date_next":"2024-03-21","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-03-11T12:45:01+01:00","published_at":"2024-03-11T11:29:33+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":296214,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.5897597462169347,"languages":{"spoken":["en","fr","nl"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{}},"translations":{"de":{"name":"From Despair to Hope: Children Beyond Armed Conflict","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.bozar.be\/en\/calendar\/despair-hope-children-beyond-armed-conflict","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50008283"},"pt":{"name":"From Despair to Hope: Children Beyond Armed Conflict","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.bozar.be\/en\/calendar\/despair-hope-children-beyond-armed-conflict","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50008283"},"en":{"name":"From Despair to Hope: Children Beyond Armed Conflict","shortdescr":"Through a collection of powerful portraits, the globally renowned humanitarian photojournalist and correspondent, Paddy Dowling, hopes to reflect the complexity of the lives of children amidst conflict, emphasizing both the tragedy of their stories, their strength and their faith in a better future.","longdescr":"Children are the most vulnerable in times of armed conflict. Wars and hostilities deprive them of their lives, families, friends, homes and rights - essentially of their very childhood and future. They become both targets and instruments of war. They are recruited and used by armed forces and armed groups, abducted, maimed or killed and sexually violated. Their schools and hospitals are attacked, and they are deprived of essential humanitarian aid. Through a collection of powerful portraits, the globally renowned humanitarian photojournalist and correspondent, Paddy Dowling, hopes to reflect the complexity of the lives of children amidst conflict, emphasizing both the tragedy of their stories, their strength and their faith in a better future.\n\u200b\u200b\u200b\u200b\u200b\u200b\u200b","performers":"In the framework of the Belgian Presidency of the Council of the European Union, organised by the Federal Public Service Foreign Affairs, Foreign Trade and Development Cooperation of the Kingdom of Belgium, the Office of the United Nations Special Representative of the Secretary-General for Children and Armed Conflict and the European Commission.","boxoffice_url":null,"website":"https:\/\/www.bozar.be\/en\/calendar\/despair-hope-children-beyond-armed-conflict","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50008283"},"it":{"name":"From Despair to Hope: Children Beyond Armed Conflict","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.bozar.be\/en\/calendar\/despair-hope-children-beyond-armed-conflict","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50008283"},"cn":{"name":"From Despair to Hope: Children Beyond Armed Conflict","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.bozar.be\/en\/calendar\/despair-hope-children-beyond-armed-conflict","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50008283"},"fr":{"name":"Du d\u00e9sespoir \u00e0 l'espoir : les enfants par-del\u00e0 les conflits arm\u00e9s","shortdescr":"\u00c0 travers une collection de portraits puissants, Paddy Dowling, photojournaliste et correspondant humanitaire de renomm\u00e9e mondiale, esp\u00e8re refl\u00e9ter la complexit\u00e9 de la vie des enfants au milieu des conflits, en soulignant \u00e0 la fois la trag\u00e9die de leurs histoires, leur force et leur foi en un avenir meilleur.","longdescr":"Les enfants sont les plus vuln\u00e9rables en p\u00e9riode de conflit arm\u00e9. Les guerres et les hostilit\u00e9s les privent de leur vie, de leur famille, de leurs amis, de leur foyer et de leurs droits \u2013 essentiellement de leur enfance et de leur avenir. Ils deviennent \u00e0 la fois des cibles et des instruments de guerre. Ils sont recrut\u00e9s et utilis\u00e9s par les forces et les groupes arm\u00e9s, sont enlev\u00e9s, mutil\u00e9s ou tu\u00e9s et viol\u00e9s sexuellement. Leurs \u00e9coles et h\u00f4pitaux sont attaqu\u00e9s et ils sont priv\u00e9s de l'aide humanitaire essentielle. \u00c0 travers une collection de portraits puissants, Paddy Dowling, photojournaliste et correspondant humanitaire de renomm\u00e9e mondiale, esp\u00e8re refl\u00e9ter la complexit\u00e9 de la vie des enfants au milieu des conflits, en soulignant \u00e0 la fois la trag\u00e9die de leurs histoires, leur force et leur foi en un avenir meilleur.\n\u200b\u200b\u200b\u200b\u200b\u200b","performers":"Dans le cadre de la Pr\u00e9sidence belge du Conseil de l'Union europ\u00e9enne, cet \u00e9v\u00e9nement est organis\u00e9 par le Service public f\u00e9d\u00e9ral des Affaires \u00e9trang\u00e8res, du Commerce ext\u00e9rieur et de la Coop\u00e9ration au d\u00e9veloppement du Royaume de Belgique, le Bureau de la Repr\u00e9sentante sp\u00e9ciale du Secr\u00e9taire g\u00e9n\u00e9ral des Nations Unies pour le sort des enfants en temps de conflit arm\u00e9 et la Commission europ\u00e9enne.","boxoffice_url":null,"website":"https:\/\/www.bozar.be\/en\/calendar\/despair-hope-children-beyond-armed-conflict","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50008283"},"sp":{"name":"From Despair to Hope: Children Beyond Armed Conflict","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.bozar.be\/en\/calendar\/despair-hope-children-beyond-armed-conflict","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50008283"},"nl":{"name":"Van wanhoop naar hoop: kinderen na gewapend conflict","shortdescr":"Door middel van een collectie krachtige portretten hoopt Paddy Dowling, wereldberoemd fotojournalist en humanitair correspondent, de complexiteit van het leven van kinderen te midden van conflicten weer te geven en zowel de tragedie van hun verhalen als hun kracht en geloof in een betere toekomst te benadrukken.\n\u200b\u200b\u200b\u200b\u200b\u200b\u200b","longdescr":"Kinderen zijn het kwetsbaarst in tijden van gewapend conflict. Oorlog en vijandelijkheden beroven hen van hun leven, hun familie, hun vrienden, hun huis en hun rechten \u2013 in wezen hun kindertijd en hun toekomst. Ze worden zowel doelwit als instrument van de oorlog. Ze worden gerekruteerd en gebruikt door gewapende groepen, ontvoerd, verminkt of gedood en seksueel misbruikt. Hun scholen en ziekenhuizen worden aangevallen en ze worden beroofd van essenti\u00eble humanitaire hulp. Door middel van een collectie krachtige portretten hoopt Paddy Dowling, wereldberoemd fotojournalist en humanitair correspondent, de complexiteit van het leven van kinderen te midden van conflicten weer te geven en zowel de tragedie van hun verhalen als hun kracht en geloof in een betere toekomst te benadrukken.\n\u200b\u200b\u200b\u200b\u200b\u200b\u200b","performers":"In het kader van het Belgische voorzitterschap van de Raad van de Europese Unie wordt dit evenement georganiseerd door de Federale Overheidsdienst Buitenlandse Zaken, Buitenlandse Handel en Ontwikkelingssamenwerking van het Koninkrijk Belgi\u00eb, het Bureau van de Speciale Vertegenwoordiger van de Secretaris-generaal van de Verenigde Naties voor Kinderen en Gewapend Conflict en de Europese Commissie.","boxoffice_url":null,"website":"https:\/\/www.bozar.be\/en\/calendar\/despair-hope-children-beyond-armed-conflict","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50008283"}},"place":{"id":63,"translations":{"de":{"name":"Palais des Beaux-Arts - Bozar","address_street_name":"Rue Ravenstein","address_street_number":"23","address_street_box":null,"email":"info@bozar.be","website":"http:\/\/www.bozar.be","phone_contact":"+32 2 507 82 00","phone_booking":"+32 2 507 82 00","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Ravenstein, 23","address_line2":"1000 Bruxelles","description_web":"Das Br\u00fcsseler BOZAR z\u00e4hlt zu den dynamischsten und hochkar\u00e4tigsten Kultur- und Kunstzentren der belgischen Kulturlandschaft. Das Art D\u00e9co-Meisterwerk aus der Feder Victor Hortas ist zudem einer der gro\u00dfen architektonischen Sch\u00e4tze Br\u00fcssels.\r\nKultur, Kultur und noch mehr Kultur! Auf mehr als 4 000 Quadratmetern gibt es Konzerte, Ausstellungen, Theater, Tanz, Literatur, Konferenzen und Filmvorf\u00fchrungen unter einem Dach zu sehen.\r\n\r\nF\u00fcr Musikinteressierte reicht das Angebot von Weltmusik \u00fcber Electronic DJs bis hin zum klassischen Symphonieorchester. Kunst- und Literaturliebhaber kommen mit zeitgen\u00f6ssischen, avantgardistischen und klassischen Kunst- und Gem\u00e4ldeausstellungen, der Fotobiennale Summer of Photography, mehrsprachigen Theaterinszenierungen, Brussels Short Film Festival, Book Clubs in franz\u00f6sischer und fl\u00e4mischer Version oder auch Architekturkonferenzen auf ihre Kosten.\r\n\r\nBOZAR-Brasserie:\r\nKulturinteressierte Genie\u00dfer k\u00f6nnen sich in der BOZAR-Brasserie von dem franz\u00f6sischen Chefkoch David Martin mit Men\u00fcs verw\u00f6hnen lassen, die dem kulturellen Angebot in nichts nachstehen. Die Brasserie ist Teil eines umfassenden Restaurierungs- und Renovierungsprogramms, sie wurde nach dem Vorbild der Original-Horta-Brasserie gestaltet. Von dem Gourmetf\u00fchrer Gault&Millau 2013 wurde sie \u00fcbrigens zur \u201eBrasserie des Jahres\" gew\u00e4hlt! \r\n\r\nBozar Caf\u00e9 Victor\r\nFr\u00fchst\u00fcck, Mittag- oder Abendessen vor oder nach dem Ausstellungs- oder Konzertbesuch k\u00f6nnen im Caf\u00e9 Victor eingenommen werden. Gro\u00dfe Fensterfronten, puristisches Design, edle Lederb\u00e4nke, spektakul\u00e4re Leuchten und feine Snacks und Speisen ergeben ein harmonisches Ensemble.\r\n","description_print":null,"booking_url":null,"sort_order":"Bozar","virtual_visit":null,"visit_url":null},"pt":{"name":"Centro de Belas Artes \u2014 Bozar","address_street_name":"Rue Ravenstein","address_street_number":"23","address_street_box":null,"email":"info@bozar.be","website":"http:\/\/www.bozar.be","phone_contact":"+32 2 507 82 00","phone_booking":"+32 2 507 82 00","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Ravenstein, 23","address_line2":"1000 Bruxelles","description_web":"Ao falar da cultura belga, \u00e9 obrigat\u00f3rio mencionar o Pal\u00e1cio de Belas Artes de Bruxelas. Quer sejam exposi\u00e7\u00f5es, concertos, teatro, cinema ou projetos liter\u00e1rios e arquitet\u00f3nicos, BOZAR coloca sempre em primeira linha a originalidade e inova\u00e7\u00e3o. N\u00e3o s\u00f3 enfatiza a cria\u00e7\u00e3o, qualidade e riqueza do programa art\u00edstico, mas preocupa-se sobretudo em oferecer uma experi\u00eancia completa aos seus visitantes.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Centre for Fine Arts - Bozar","address_street_name":"Rue Ravenstein","address_street_number":"23","address_street_box":null,"email":"info@bozar.be","website":"http:\/\/www.bozar.be","phone_contact":"+32 2 507 82 00","phone_booking":"+32 2 507 82 00","address_zip":"1000","address_city":"Brussels","address_line1":"Rue Ravenstein, 23","address_line2":"1000 Brussels","description_web":"It\u2019s impossible to talk about culture in Belgium without mentioning the Centre for Fine Arts located in Brussels. Whether it comes to exhibitions, concerts, theater performances, movies or projects concerning literature and architecture, BOZAR will always put originality and innovation first. They prove to keep a finger on the pulse with their varied and sophisticated programme. Besides emphasizing the importance of creation, quality and a rich artistic offering, BOZAR is especially concerned about the total experience of the visitors.","description_print":"It\u2019s impossible to talk about culture in Belgium without mentioning the Centre for Fine Arts located in Brussels. Whether it comes to exhibitions, concerts, theater performances, movies or projects concerning literature and architecture, BOZAR will always put originality and innovation first. They prove to keep a finger on the pulse with their varied and sophisticated programme. Besides emphasizing the importance of creation, quality and a rich artistic offering, BOZAR is especially concerned about the total experience of the visitors.","booking_url":null,"sort_order":"Bozar","virtual_visit":null,"visit_url":null},"it":{"name":"Palazzo delle Belle Arti - Bozar","address_street_name":"Rue Ravenstein","address_street_number":"23","address_street_box":null,"email":"info@bozar.be","website":"http:\/\/www.bozar.be","phone_contact":"+32 2 507 82 00","phone_booking":"+32 2 507 82 00","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Ravenstein, 23","address_line2":"1000 Bruxelles","description_web":"BOZAR il Palazzo delle Belle Arti, centro d'arte per eccellenza del panorama culturale belga, offre un programma internazionale nel cuore di Bruxelles.\r\n\r\nL'edificio \u00e8 un gioiello del patrimonio architettonico del Belgio. E' stato realizzato da Victor Horta in stile Art Nouveau nel 1920.\r\n\r\nIl Bozar \u00e8 un centro d'arte attivo e dinamico che accoglie ogni anno pi\u00f9 di un milione di visitatori: 4.000 m\u00b2 di spazi espositivi, una grandiosa sala concerti, una sala per musica da camera, due piccoli teatri, tre nuove sale multimediali, il BOZAR SHOP, la BOZAR BRASSERIE e la Cinemateca Reale, famosa in tutto il mondo per la sua collezione di grande valore.\r\n\r\n\r\nLa BOZAR BRASSERIE vi aspetta con il suo chef stellato David Martin. Prenotazioni, solo per telefono, al n\u00b0 +32 (0)2 503 00 00. Aperto 7 giorni su 7, dalle 12 alle 23.\r\n\r\nVisitate anche il BOZARSHOP: migliaia di libri d'arte, CD, DVD, idee regalo.\r\nSpazio giochi per i vostri bambini.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Palais des Beaux-Arts - Bozar","address_street_name":"Rue Ravenstein","address_street_number":"23","address_street_box":null,"email":"info@bozar.be","website":"http:\/\/www.bozar.be","phone_contact":"+32 2 507 82 00","phone_booking":"+32 2 507 82 00","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Ravenstein, 23","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Palais des Beaux-Arts - Bozar","address_street_name":"Rue Ravenstein","address_street_number":"23","address_street_box":null,"email":"info@bozar.be","website":"http:\/\/www.bozar.be","phone_contact":"+32 2 507 82 00","phone_booking":"+32 2 507 82 00","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Ravenstein, 23","address_line2":"1000 Bruxelles","description_web":"Lorsqu\u2019on parle de la culture en Belgique, on pense forc\u00e9ment au Palais des Beaux-Arts de Bruxelles. Qu\u2019il s\u2019agisse d\u2019expositions, de concerts, de th\u00e9\u00e2tre ou de cin\u00e9ma, de projets autour de la litt\u00e9rature et d\u2019architecture, BOZAR met toujours en avant l\u2019originalit\u00e9 et l\u2019innovation. Non seulement ils mettent un point d\u2019honneur \u00e0 la cr\u00e9ation, la qualit\u00e9 et la richesse du programme artistique, mais se pr\u00e9occupent surtout d\u2019offrir une exp\u00e9rience totale \u00e0 ses visiteurs.","description_print":"Lorsqu\u2019on parle de la culture en Belgique, on pense forc\u00e9ment au Palais des Beaux-Arts de Bruxelles. Qu\u2019il s\u2019agisse d\u2019expositions, de concerts, de th\u00e9\u00e2tre ou de cin\u00e9ma, de projets autour de la litt\u00e9rature et d\u2019architecture, BOZAR met toujours en avant l\u2019originalit\u00e9 et l\u2019innovation. Non seulement ils mettent un point d\u2019honneur \u00e0 la cr\u00e9ation, la qualit\u00e9 et la richesse du programme artistique, mais se pr\u00e9occupent surtout d\u2019offrir une exp\u00e9rience totale \u00e0 ses visiteurs.","booking_url":null,"sort_order":"Bozar","virtual_visit":null,"visit_url":null},"sp":{"name":"Palacio de las Bellas Artes - Bozar","address_street_name":"Rue Ravenstein","address_street_number":"23","address_street_box":null,"email":"info@bozar.be","website":"http:\/\/www.bozar.be","phone_contact":"+32 2 507 82 00","phone_booking":"+32 2 507 82 00","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Ravenstein, 23","address_line2":"1000 Bruxelles","description_web":"El Bozar, el Palacio de las Bellas Artes, es el centro de arte por excelencia del paisaje cultural belga. \r\n\r\nEl Palacio de las Bellas Artes de Bruselas ofrece un programa cultural y art\u00edstico. Es uno de los n\u00facleos art\u00edsticos m\u00e1s din\u00e1micos de B\u00e9lgica, con 1 mill\u00f3n de visitas al a\u00f1o. \r\n\r\nEn el programa: exposiciones, m\u00fasica, danza, teatro, cine, literatura o arquitectura para peque\u00f1os y no tan peque\u00f1os. \r\n\r\nEl edificio constituye una de las obras maestras del patrimonio arquitect\u00f3nico de B\u00e9lgica. \r\n\r\nEste Palacio Art D\u00e9co lo ide\u00f3 el arquitecto Victor Horta en 1920 e incluye:\r\n\r\n- M\u00e1s de 4.000 m\u00b2 espacios de exposici\u00f3n\r\n- La Sala Henry le B\u0153uf, es decir, una magn\u00edfica sala de conciertos\r\n- 1 sala de m\u00fasica de c\u00e1mara\r\n- 2 peque\u00f1os teatros y 3 nuevas salas multimedia\r\n- La Bozar Brasserie y la cocina innovadora del chef galardonado David Martin\r\n- La Cinemateca Real y su indiscutible colecci\u00f3n internacionalmente conocida\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Paleis voor Schone Kunsten - Bozar","address_street_name":"Ravensteinstraat","address_street_number":"23","address_street_box":null,"email":"info@bozar.be","website":"http:\/\/www.bozar.be","phone_contact":"+32 2 507 82 00","phone_booking":"+32 2 507 82 00","address_zip":"1000","address_city":"Brussel","address_line1":"Ravensteinstraat, 23","address_line2":"1000 Brussel","description_web":"Als je in Belgi\u00eb over cultuur spreekt, dan kun je niet om het Paleis voor Schone Kunsten in Brussel heen. Of het nu gaat om tentoonstellingen, concerten, theater- en filmvoorstellingen, projecten rond literatuur en architectuur, steeds stelt Bozar originaliteit en vernieuwing voorop. Ze bewijzen dat ze de vinger aan de pols hebben met hun gevarieerd en uitgekiend programma. Niet alleen creatie, kwaliteit en een rijk artistiek aanbod draagt de zorg weg. Bij Bozar zijn ze bekommerd om de totaalervaring. Het imposante en tegelijk intieme gebouw - van de hand van Horta- heeft een bevreemdende schoonheid.","description_print":"Als je in Belgi\u00eb over cultuur spreekt, dan kun je niet om het Paleis voor Schone Kunsten in Brussel heen. Of het nu gaat om tentoonstellingen, concerten, theater- en filmvoorstellingen, projecten rond literatuur en architectuur, steeds stelt Bozar originaliteit en vernieuwing voorop. Ze bewijzen dat ze de vinger aan de pols hebben met hun gevarieerd en uitgekiend programma. Niet alleen creatie, kwaliteit en een rijk artistiek aanbod draagt de zorg weg. Bij Bozar zijn ze bekommerd om de totaalervaring. Het imposante en tegelijk intieme gebouw - van de hand van Horta- heeft een bevreemdende schoonheid.","booking_url":null,"sort_order":"Bozar","virtual_visit":null,"visit_url":null}},"districts":{"list":[16],"translations":{"de":["K\u00f6nigliches Viertel"],"pt":[null],"en":["Royal"],"it":["Quartiere reale"],"cn":[null],"fr":["Quartier Royal"],"sp":["Quartier Royal \u2014Barrio de la Corte\u2014"],"nl":["Koninklijke wijk"]}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":"art_center","facebook_id":null,"backoffice_id":13,"location":{"lat":50.8442214,"lon":4.35950594},"region":"brussels","last_updated_at":"2023-08-14T16:21:56+02:00","published_at":"2013-10-19T01:13:13+02:00","import_ori