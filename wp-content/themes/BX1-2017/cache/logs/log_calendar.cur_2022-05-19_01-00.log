ntures internationales de la danse.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.sionobrussels.com\/","email":"Sionobrussels@gmail.com","phone_contact":"+32 467 63 61 90","phone_booking":"+32 467 63 61 90","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/521565.html"},"nl":{"name":"Si O No X Sundays @Pleinpubliek","shortdescr":"Kom elke zondag, vanaf 18.00 uur in de Plein Publiek BXL om verschillende latino-dansdisciplines te leren met de beste dansers uit Belgi\u00eb! \u00bfSi o No ?","longdescr":"Kom elke zondag, vanaf 18.00 uur in de Plein Publiek BXL om verschillende latino-dansdisciplines te leren met de beste dansers uit Belgi\u00eb! \u00bfSi o No ? \r\nOp het programma, 2uren dansles, salsa, Bachata, merengue, cumbia... Op basis van hun niveau, kunnen de deelnemers de danspassen aanleren (beginners en gevorderden). De danspiste wordt na de workshops geopend voor alle dans-liefhebbers, geanimeerd door de beste latino-DJ's!\r\nOp speciale avonden, kan je er internationale shows en exclusieve workshops beleven!\r\n\r\n*Je hoeft niet op voorhand in te schrijven voor de danslessen\r\n*Je mag ook gewoon naar de dansavond komen zonder de danslessen bij te wonen\r\n*Geen danskennis vereist om de danslessen bij te wonen\r\n*Het is niet nodig om in koppel te komen, danspartners zijn altijd ter plaatse beschikbaar\r\n*Met de lidkaart krijg je het hele jaar door korting op de toegang. De lidkaart kan je aan de ingang aanmaken.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/521565.html"},"en":{"name":"Si O No X Sundays @Pleinpubliek","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/521565.html"},"de":{"name":"Si O No X Sundays @Pleinpubliek","shortdescr":null,"longdescr":null,"