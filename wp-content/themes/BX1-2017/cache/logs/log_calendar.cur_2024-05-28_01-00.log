\/www.tricoterie.be\/fr\/agenda\/l-agenda-culturel\/scene-ouverte-et-jam-2585?id_evenement=5819","email":"reservations@tricoterie.be","phone_contact":"+32 2 537 96 69","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50006406"},"en":{"name":"Sc\u00e8ne ouverte et jam","shortdescr":"Le lundi, c\u2019est sc\u00e8ne ouverte \u00e0 la Trico !\n","longdescr":"Le lundi, c\u2019est sc\u00e8ne ouverte \u00e0 la Trico !\n\nTous les lundis, la Tricoterie vous offre sa sc\u00e8ne !\nEntre 20h et 22h30, la sc\u00e8ne ouverte bat son plein ! Vous serez sous le feu des projecteurs, devant une audience bienveillante, avide d\u2019entendre ce que vous avez envie de lui proposer. Que ce soit de la chanson fran\u00e7aise, du funk, du classique, du rap, ou encore un bon vieux rock garage, vous \u00eates les bienvenu\u00b7es !\n\nUn seul mot d\u2019ordre : jouer \u00ab live \u00bb (pas d\u2019enregistrement sur lequel on pose une voix).\nSi vous avez envie de tenter un bout de spectacle, un po\u00e8me, une performance, un tour de magie, pourquoi pas, la sc\u00e8ne sera \u00e9galement \u00e0 vous !\n\nLe modus operandi est simple : la liste de passage d\u00e9coup\u00e9e en 1\/4h n\u2019est accessible que le jour m\u00eame \u00e0 partir de 19h (pas d\u2019inscription par mail ou t\u00e9l\u00e9phone \u00e0 l\u2019avance), donc venez au plus t\u00f4t, inscrivez-vous, puis regardez les autres artistes en d\u00e9gustant un petit verre, avant de monter vous-m\u00eame sur sc\u00e8ne\u2026\n\n\u00c0 partir de 22h30, la jam prend place. Tout\u00b7e musicien\u00b7ne ou chanteur\u00b7euse est bienvenu\u00b7e pour partager la sc\u00e8ne avec d\u2019autres ! L\u2019\u00e9coute des autres est l\u2019\u00e9l\u00e9ment principal et primordial pour que la magie musicale puisse op\u00e9rer\u2026\n\n\u00c0 tout bient\u00f4t !","performers":null,"boxoffice_url":null,"website":"https:\/\/www.tricoterie.be\/fr\/agenda\/l-agenda-culturel\/scene-ouverte-et-jam-2585?id_evenement=5819","email":"reservations@tricoterie.be","phone_contact":"+32 2 537 96 69","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50006406"},"it":{"name":"Sc\u00e8ne ouverte et jam","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.tricoterie.be\/fr\/agenda\/l-agenda-culturel\/scene-ouverte-et-jam-2585?id_evenement=5819","email":"reservations@tricoterie.be","phone_contact":"+32 2 537 96 69","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50006406"},"cn":{"name":"Sc\u00e8ne ouverte et jam","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.tricoterie.be\/fr\/agenda\/l-agenda-culturel\/scene-ouverte-et-jam-2585?id_evenement=5819","email":"reservations@tricoterie.be","phone_contact":"+32 2 537 96 69","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50006406"},"fr":{"name":"Sc\u00e8ne ouverte et jam","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.tricoterie.be\/fr\/agenda\/l-agenda-culturel\/scene-ouverte-et-jam-2585?id_evenement=5819","email":"reservations@tricoterie.be","phone_contact":"+32 2 537 96 69","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50006406"},"sp":{"name":"Sc\u00e8ne ouverte et jam","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.tricoterie.be\/fr\/agenda\/l-agenda-culturel\/scene-ouverte-et-jam-2585?id_evenement=5819","email":"reservations@tricoterie.be","phone_contact":"+32 2 537 96 69","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50006406"},"nl":{"name":"Sc\u00e8ne ouverte et jam","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.tricoterie.be\/fr\/agenda\/l-agenda-culturel\/scene-ouverte-et-jam-2585?id_evenement=5819","email":"reservations@tricoterie.be","phone_contact":"+32 2 537 96 69","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50006406"}},"place":{"last_updated_at":"2024-05-15T13:04:23+02:00","published_at":"2013-10-19T01:47:56+02:00","id":252101,"translations":{"de":{"name":"La Tricoterie","address_street_name":"Rue Th\u00e9odore Verhaegen","address_street_number":"158","address_street_box":null,"email":"charlotte@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+ 32 (0)2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Th\u00e9odore Verhaegen, 158","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"La Tricoterie - Fabrique de liens","address_street_name":"Rue Th\u00e9odore Verhaegen","address_street_number":"158","address_street_box":null,"email":"charlotte@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+ 32 (0)2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Th\u00e9odore Verhaegen, 158","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"La Tricoterie - Link factory","address_street_name":"Rue Th\u00e9odore Verhaegen","address_street_number":"158","address_street_box":null,"email":"charlotte@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+ 32 (0)2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Th\u00e9odore Verhaegen, 158","address_line2":"1060 Saint-Gilles","description_web":"La Tricoterie is above all a civil, cultural, sustainable and innovative project. Their cultural programme featuring performances, shows, exhibitions and so on goes hand in hand with a \u201ccivil\u201d programme of debates, conferences, inter-generational workshops, philosophical caf\u00e9 etc ... The place can be rented for events and there are plenty of really great parties! ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"La Tricoterie","address_street_name":"Rue Th\u00e9odore Verhaegen","address_street_number":"158","address_street_box":null,"email":"charlotte@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+ 32 (0)2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Th\u00e9odore Verhaegen, 158","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"La Tricoterie - Fabrique de liens","address_street_name":"Rue Th\u00e9odore Verhaegen","address_street_number":"158","address_street_box":null,"email":"charlotte@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+ 32 (0)2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Th\u00e9odore Verhaegen, 158","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"La Tricoterie - Fabrique de liens","address_street_name":"Rue Th\u00e9odore Verhaegen","address_street_number":"158","address_street_box":null,"email":"charlotte@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+ 32 (0)2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Th\u00e9odore Verhaegen, 158","address_line2":"1060 Saint-Gilles","description_web":"La Tricoterie est un projet culturel fond\u00e9 en 2010 par une poign\u00e9e de citoyen\u00b7nes et situ\u00e9 dans une ancienne usine restaur\u00e9e avec des mat\u00e9riaux \u00e9cologiques. La Tricoterie propose une programmation culturelle tr\u00e8s diversifi\u00e9e et centr\u00e9e sur la rencontre entre les diff\u00e9rents publics et le m\u00e9lange des activit\u00e9s culturelles.\r\n\r\nPassez la porte et d\u00e9couvrez :\r\n- Des spectacles de th\u00e9\u00e2tre, de danse, de cirque...\r\n- Des concerts, des soir\u00e9es, des sc\u00e8nes ouvertes, des jam sessions, une chorale d'un soir...\r\n- Des ateliers z\u00e9ro d\u00e9chet, peinture, c\u00e9ramique, \u0153nologie, danse...\r\n- Des projections de films, conf\u00e9rences, d\u00e9bats...\r\n- Des couscous \"s\u00e9pharabes\", des soir\u00e9es jeux de soci\u00e9t\u00e9, des activit\u00e9s pour enfants...\r\n- Des march\u00e9s des cr\u00e9ateur\u00b7rices, des vide-dressings, des march\u00e9s de No\u00ebl durables...\r\n\r\nUn petit creux ? La Triciterie vous propose un brunch tous les dimanches et un concept \"live cooking\" tous les vendredis soirs. Tous les plats sont 100% artisanaux, et pr\u00e9par\u00e9s sur place par l'\u00e9quipe avec des ingr\u00e9dients bio, locaux et de saison.\r\n\r\nEnvie d'organiser votre \u00e9v\u00e9nement chez vous ? La Tricoterie met ses salles \u00e0 disposition pour tout type d'\u00e9v\u00e9nement priv\u00e9 ou professionnel et propose \u00e9galement un service traiteur, que ce soit dans ses murs ou \u00e0 l'ext\u00e9rieur. Rendez-vous sur www.tricoterie.be pour en savoir plus !\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"La Tricoterie","address_street_name":"Rue Th\u00e9odore Verhaegen","address_street_number":"158","address_street_box":null,"email":"charlotte@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+ 32 (0)2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Th\u00e9odore Verhaegen, 158","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"La Tricoterie - Contactenfabriek","address_street_name":"Th\u00e9odore Verhaegenstraat","address_street_number":"158","address_street_box":null,"email":"charlotte@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+ 32 (0)2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Sint-Gillis","address_line1":"Th\u00e9odore Verhaegenstraat, 158","address_line2":"1060 Sint-Gillis","description_web":"La Tricoterie is een project met een welomlijnde filosofie, die blijkt uit de zelfgekozen naam (van tricoter, breien) waarmee verwijst wordt naar het smeden van banden om de strijd tegen de ontrafeling van het sociale weefsel aan te gaan. Opgezet als een \u00abContacten Fabriek\u00bb en een ontmoetingsplaats waar verschillende disciplines en publieken elkaar ontmoeten. Naast een culturele programmering (concerten, voorstellingen, expos\u2026) en socioculturele activiteiten die sociale cohesie beogen (debatten, conferenties, intergenerationele ateliers, caf\u00e9-filo\u2026) staan de ruimtes ook open voor verhuur aan externe organisaties en bedrijven. Tal van superleuke feestjes vinden er plaats, alsook een wekelijkse biomarkt, een repaircaf\u00e9 en een alternatieve geschenkenmarkt om maar enkele van de activiteiten te noemen die de duurzame levensvisie van de plek weerspiegelen.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[7],"translations":{"de":["Saint-Gilles Zentrum"],"pt":[null],"en":["Saint-Gilles Centre"],"it":["Saint-Gilles Centre"],"cn":[null],"fr":["Saint-Gilles Centre"],"sp":["Saint-Gilles Centre"],"nl":["Sint-Gillis centrum"]}},"zones":{"list":[21],"translations":{"de":["S\u00fcden"],"pt":[null],"en":["South"],"it":["Sud"],"cn":[null],"fr":["Sud"],"sp":["Sur"],"nl":["Zuid"]}},"neca":null,"facebook_id