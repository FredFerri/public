te_end":"2025-05-04","date_next":"2025-03-21","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2025-03-21T12:37:37+01:00","published_at":"2024-06-06T17:03:13+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":301619,"facebook_link":null,"import_origin":null,"is_part_of":"\u00c9v\u00e9nement Art nouveau","sub_type":"expo","ranking":0.18177267038153255,"languages":{"spoken":["fr","en","nl"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exposici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[44,36],"translations":{"de":["Design","Museen & Kunstzentren"],"pt":[null,null],"en":["Design","Museums and art centers"],"it":["Design","Musei e centri artistici"],"cn":[null,null],"fr":["Design","Mus\u00e9es et art centers"],"sp":["Dise\u00f1o","Museos y centros de arte"],"nl":["Design","Musea en kunstcentra"]}}},"translations":{"de":{"name":"Belgian Art Nouveau. Van de Velde, Serrurier-Bovy, Hankar & co","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.maisonhannon.be","email":"info@maisonhannon.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50011411"},"pt":{"name":"Belgian Art Nouveau. Van de Velde, Serrurier-Bovy, Hankar & co","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.maisonhannon.be","email":"info@maisonhannon.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50011411"},"en":{"name":"Belgian Art Nouveau. Van de Velde, Serrurier-Bovy, Hankar & co","shortdescr":"The exhibition highlights key figures such as Paul Hankar, Henry van de Velde, Gustave Serrurier-Bovy, and many others, who worked together to shape a modern way of life, accessible to all, through radically innovative aesthetics and functionality. Their commitment to change laid the groundwork for an early modernity that inspired future generations of designers.","longdescr":"The exhibition highlights key figures such as Paul Hankar, Henry van de Velde, Gustave Serrurier-Bovy, and many others, who worked together to shape a modern way of life, accessible to all, through radically innovative aesthetics and functionality. Their commitment to change laid the groundwork for an early modernity that inspired future generations of designers. With this exhibition, the Maison Hannon has chosen not to present any works by the architectural genius Victor Horta in order to showcase the diversity of Belgian sensibilities and offer visitors a fresh perspective on the fin de si\u00e8cle world. \n\nThis exhibition was made possible thanks to loans of artworks from public and private collections: Design Museum Gent, Klassik Stiftung Weimar, Spa Museum, Wallonia-Brussels Federation, the Museum of Ixelles, and private collectors like the Jonathan Mangelinckx collection who loaned masterpieces from their collections for this unique occasion.","performers":null,"boxoffice_url":"https:\/\/www.ticketing.brussels\/en\/tickets\/event-details.Maison-Hannon.536bea1a-2f73-4284-9db1-dd3b861df83b","website":"http:\/\/www.maisonhannon.be","email":"info@maisonhannon.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50011411"},"it":{"name":"Belgian Art Nouveau. Van de Velde, Serrurier-Bovy, Hankar & co","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.maisonhannon.be","email":"info@maisonhannon.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50011411"},"cn":{"name":"Belgian Art Nouveau. Van de Velde, Serrurier-Bovy, Hankar & co","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.maisonhannon.be","email":"info@maisonhannon.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50011411"},"fr":{"name":"Art(s) Nouveau(x) belge(s).  Van de Velde, Serrurier-Bovy, Hankar & co","shortdescr":"Cette exposition met en lumi\u00e8re des figures cl\u00e9s telles que Hankar, van de Velde, Serrurier-Bovy et bien d'autres, qui ont \u0153uvr\u00e9 pour fa\u00e7onner un mode de vie moderne, accessible \u00e0 tou.te.s, \u00e0 travers une esth\u00e9tique et une fonctionnalit\u00e9 radicalement innovantes. Leur engagement en faveur du changement a jet\u00e9 les bases d'une premi\u00e8re modernit\u00e9 qui a inspir\u00e9 les futures g\u00e9n\u00e9rations de designers.","longdescr":"Cette exposition met en lumi\u00e8re des figures cl\u00e9s telles que Paul Hankar, Henry van de Velde, Gustave Serrurier-Bovy et bien d'autres, qui ont \u0153uvr\u00e9 ensemble pour fa\u00e7onner un mode de vie moderne, accessible \u00e0 tou.te.s, \u00e0 travers une esth\u00e9tique et une fonctionnalit\u00e9 radicalement innovantes. Leur engagement en faveur du changement a jet\u00e9 les bases d'une premi\u00e8re modernit\u00e9 qui a inspir\u00e9 les futures g\u00e9n\u00e9rations de designers. Avec cette exposition, la Maison Hannon a fait le choix de ne pr\u00e9senter aucune \u0153uvre du g\u00e9nie de l\u2019architecture, Victor Horta afin de valoriser la diversit\u00e9 des sensibilit\u00e9s belges et d\u2019offrir au visiteur un nouveau regard sur le monde fin-de-si\u00e8cle. \n\nCette exposition a \u00e9t\u00e9 rendue possible gr\u00e2ce aux pr\u00eats d'\u0153uvres issues de collections publiques et priv\u00e9es : le Design Museum Gent, la Klassik Stiftung Weimar, le Spa Museum, la F\u00e9d\u00e9ration Wallonie-Bruxelles, le Mus\u00e9e d'Ixelles et les collectionneurs priv\u00e9s tels Jonathan Mangelinckx Collection qui ont pr\u00eat\u00e9 des chefs-d'\u0153uvre de leurs collections pour cette occasion unique. ","performers":null,"boxoffice_url":"https:\/\/www.ticketing.brussels\/fr\/tickets\/event-details.Maison-Hannon.536bea1a-2f73-4284-9db1-dd3b861df83b","website":"http:\/\/www.maisonhannon.be","email":"info@maisonhannon.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50011411"},"sp":{"name":"Belgian Art Nouveau. Van de Velde, Serrurier-Bovy, Hankar & co","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.maisonhannon.be","email":"info@maisonhannon.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50011411"},"nl":{"name":"Belgische art nouveau. Van de Velde, Serrurier-Bovy, Hankar & co","shortdescr":"De tentoonstelling werpt licht op sleutelfiguren zoals Hankar, van de Velde of Serrurier-Bovy, die samenwerkten om een moderne levensstijl te cre\u00ebren die toegankelijk was voor iedereen, met behulp van een esthetiek en een functionaliteit die zowel eenvoudig als innovatief was. Hun streven naar verandering legde de basis voor een vroege moderniteit die toekomstige generaties designers inspireerde.","longdescr":"De tentoonstelling werpt licht op sleutelfiguren zoals Paul Hankar, Henry van de Velde, Gustave Serrurier-Bovy en vele anderen, die samenwerkten om een moderne levensstijl te cre\u00ebren die toegankelijk was voor iedereen, met behulp van een esthetiek en een functionaliteit die zowel eenvoudig als innovatief was. Hun streven naar verandering legde de basis voor een vroege moderniteit die toekomstige generaties designers inspireerde. Met deze tentoonstelling heeft het Maison Hannon de keuze gemaakt om geen enkel werk van het genie Victor Horta te tonen, om de diversiteit van de Belgische stijl te laten zien en bezoekers een frisse kijk te geven op de wereld van het fin-de-si\u00e8cle. \n\nMet een zorgvuldig samengestelde selectie van werken uit zowel openbare als priv\u00e9collecties biedt deze tentoonstelling een fascinerende onderdompeling in de diversiteit van de Belgische art nouveau. We zijn dankbaar voor onze partners, waaronder het Design Museum Gent, de Klassik Stiftung Weimar, het Spa Museum, de Federatie Walloni\u00eb-Brussel, het Museum van Elsene en de priv\u00e9verzamelaars zoals the Jonathan Mangelinckx Collection die enkele topstukken uit hun collectie hebben geleend voor deze unieke gelegenheid. ","performers":null,"boxoffice_url":"https:\/\/www.ticketing.brussels\/nl\/tickets\/event-details.Maison-Hannon.536bea1a-2f73-4284-9db1-dd3b861df83b","website":"http:\/\/www.maisonhannon.be","email":"info@maisonhannon.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50011411"}},"place":{"id":244861,"translations":{"de":{"name":"Maison Hannon","address_street_name":"Avenue de la Jonction","address_street_number":"1","address_street_box":null,"email":"info@maisonhannon.be","website":"https:\/\/maisonhannon.be","phone_contact":null,"phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Avenue de la Jonction, 1","address_line2":"1060 Saint-Gilles","description_web":"Edouard Hannon, Ingenieur der Gesellschaft Solvay und einer der Vertreter der industriellen Bourgeoisie, erwarb 1902 ein Grundst\u00fcck an der Avenue Brugman und beauftragte den Architekten Jules Brunfaut mit dem Bau eines prachtvollen Herrenhauses im Jugendstil.\r\n\r\nJules Brunfaut z\u00e4hlte bis dato nicht zu den Jugendstil-Architekten. Er bediente sich dieses Stils lediglich, um seinem Freund und Gesch\u00e4ftspartner einen Gefallen zu tun. 1903, als sich der Jugendstil auch international durchgesetzt hatte, wagte er sich an neue Stilelemente heran: Ihm sind die Fenster im Tiffany-Stil zu verdanken. Und es wird deutlich, wer Brunfauts Vorbilder waren: Victor Horta und Octave van Rijsselberghe (der Architekt des H\u00f4tel Otlet und H\u00f4tel de Brouck\u00e8re).\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Maison Hannon","address_street_name":"Avenue de la Jonction","address_street_number":"1","address_street_box":null,"email":"info@maisonhannon.be","website":"https:\/\/maisonhannon.be","phone_contact":null,"phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Avenue de la Jonction, 1","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Maison Hannon","address_street_name":"Verbindingslaan","address_street_number":"1","address_street_box":null,"email":"info@maisonhannon.be","website":"https:\/\/maisonhannon.be","phone_contact":null,"phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Verbindingslaan, 1","address_line2":"1060 Saint-Gilles","description_web":"The Maison Hannon, on the corner of Avenue Brugmann and Avenue de la Jonction, was built in 1902, at the request of the couple Marie and \u00c9douard Hannon, by their friend, the architect Jules Brunfaut. Conceived as a symbolist and dreamlike universe, the house is one of the masterpieces of art nouveau in Brussels, a union of Belgian and French art of the time. \r\nJules Brunfaut, unfamiliar with the new style, was inspired by other architects' houses, such as those of Victor Horta (personal house, Tassel and Wessinger hotels), Ernest Bl\u00e9rot (personal house, now destroyed) and Octave Van Rysselbeghe and Henry Van de Velde (Otlet hotel). \r\nCombining the beaux-arts style with that of modernity, or art nouveau at that period, the Maison Hannon is a singular work, an intimate and personal house, bringing together the tastes and passions of its commissioners. \r\n\r\nThe Maison Hannon will open its doors to the public on June 1, 2023, as a house museum. ","description_print":null,"booking_url":"https:\/\/www.ticketing.brussels\/en\/tickets\/event-details.Maison-Hannon.536bea1a-2f73-4284-9db1-dd3b861df83b","sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Maison Hannon","address_street_name":"Avenue de la Jonction","address_street_number":"1","address_street_box":null,"email":"info@maisonhannon.be","website":"https:\/\/maisonhannon.be","phone_contact":null,"phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Avenue de la Jonction, 1","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Maison Hannon","address_street_name":"Avenue de la Jonction","address_street_number":"1","address_street_box":null,"email":"info@maisonhannon.be","website":"https:\/\/maisonhannon.be","phone_contact":null,"phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Avenue de la Jonction, 1","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Maison Hannon","address_street_name":"Avenue de la Jonction","address_street_number":"1","address_street_box":null,"email":"info@maisonhannon.be","website":"https:\/\/maisonhannon.be","phone_contact":null,"phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Avenue de la Jonction, 1","address_line2":"1060 Saint-Gilles","description_web":"La Maison Hannon, \u00e0 l\u2019angle des avenues Brugmann et de la Jonction, a \u00e9t\u00e9 construite en 1902, \u00e0 la demande du couple Marie et \u00c9douard Hannon, par leur ami l\u2019architecte Jules Brunfaut. Con\u00e7ue comme univers symboliste et onirique, la maison est un des chefs-d\u2019\u0153uvre de l\u2019art nouveau \u00e0 Bruxelles, union de l\u2019art belge et de l\u2019art fran\u00e7ais de l\u2019\u00e9poque. \r\n\r\nJules Brunfaut, peu familier au style nouveau, s\u2019inspirera d\u2019autres maisons d\u2019architectes de l\u2019\u00e9poque, tel que celles de Victor Horta (maison personnelle, h\u00f4tels Tassel et Wessinger), d\u2019Ernest Bl\u00e9rot (maison personnelle, aujourd\u2019hui d\u00e9truite) et d\u2019Octave Van Rysselbeghe et Henry Van de Velde (h\u00f4tel Otlet). \r\n\r\nAlliant style beaux-arts \u00e0 celui de la modernit\u00e9, soit l\u2019art nouveau \u00e0 l\u2019\u00e9poque, la Maison Hannon est une \u0153uvre singuli\u00e8re, une maison intime et personnelle, r\u00e9unissant les go\u00fbts et passions de ses commanditaires. \r\n\r\nLa Maison Hannon ouvre ses portes au public le 1er juin 2023, en tant que maison-mus\u00e9e.\r\n","description_print":null,"booking_url":"https:\/\/www.ticketing.brussels\/fr\/tickets\/event-details.Maison-Hannon.536bea1a-2f73-4284-9db1-dd3b861df83b","sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Maison Hannon","address_street_name":"Avenue de la Jonction","address_street_number":"1","address_street_box":null,"email":"info@maisonhannon.be","website":"https:\/\/maisonhannon.be","phone_contact":null,"phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Avenue de la Jonction, 1","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Maison Hannon","address_street_name":"Verbindingslaan","address_street_number":"1","address_street_box":null,"email":"info@maisonhannon.be","website":"https:\/\/maisonhannon.be","phone_contact":null,"phone_booking":null,"address_zip":"1060","address_city":"Sint-Gillis","address_line1":"Verbindingslaan, 1","address_line2":"1060 Sint-Gillis","description_web":"Het Maison Hannon werd in 1902 gebouwd op de hoek van de Brugmannlaan en de Verbindingslaan in Sint-Gillis door de architect Jules Brunfaut op verzoek van het echtpaar Marie en \u00c9douard Hannon. Het huis, opgevat als een droomachtig, symbolistische omsloten wereld, is een van de meesterwerken van de Brusselse art nouveau, een vereniging van Belgische en Franse kunst uit die tijd.\r\n\r\nJules Brunfaut, onbekend met de nouveau-stijl, liet zich inspireren door de huizen van andere architecten uit die tijd, zoals die van Victor Horta (persoonlijk huis, hotels Tassel en Wessinger), Ernest Bl\u00e9rot (persoonlijk huis, nu vernietigd) en Octave Van Rysselbeghe en Henry Van de Velde (hotel Otlet). \r\nHet Maison Hannon combineert de Beaux-Arts stijl met die van de moderniteit, de toenmalige art nouveau, en is een uniek werk, een intiem en persoonlijk huis dat de smaak en de passies van zijn opdrachtgevers samenbrengt. \r\n\r\nHet Maison Hannon zal op 1 juni 2023 de deuren voor het publiek openen als huis-museum.","description_print":null,"booking_url":"https:\/\/www.ticketing.brussels\/nl\/tickets\/event-details.Maison-Hannon.536bea1a-2f73-4284-9db1-dd3b861df83b","sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[7,6],"translations":{"de":["Saint-Gilles Zentrum","Chatelain\/Bailli"],"pt":[null,null],"en":["Saint-Gilles Centre","Chatelain\/Bailli"],"it":["Saint-Gilles Centre","Chatelain\/Bailli"],"cn":[null,null],"fr":["Saint-Gilles Centre","Chatelain\/Bailli"],"sp":["Saint-Gilles Centre","Ch\u00e2telain\/Bailli"],"nl":["Sint-Gillis centrum","Kasteleinswijk\/Baljuw"]}},"zones":{"list":[21],"translations":{"de":["S\u00fcden"],"pt":[null],"en":["South"],"it":["Sud"],"cn":[null],"fr":["Sud"],"sp":["Sur"],"nl":["Zuid"]}},"neca":null,"facebook_id":null,"backoffice_id":7146,"location":{"lat":50.820883,"lon":4.3522286},"region":"brussels","last_updated_at":"2025-02-06T08:28:21+01:00","published_at":"2013-10-19T01:21:40+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":244861,"translations":{"de":{"name":"Maison Hannon","address_street_name":"Avenue de la Jonction","address_street_number":"1","address_street_box":null,"email":"info@maisonhannon.be","website":"https:\/\/maisonhannon.be","phone_contact":null,"phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Avenue de la Jonction, 1","address_line2":"1060 Saint-Gilles","description_web":"Edouard Hannon, Ingenieur der Gesellschaft Solvay und einer der Vertreter der industriellen Bourgeoisie, erwarb 1902 ein Grundst\u00fcck an der Avenue Brugman und beauftragte den Architekten Jules Brunfaut mit dem Bau eines prachtvollen Herrenhauses im Jugendstil.\r\n\r\nJules Brunfaut z\u00e4hlte bis dato nicht zu den Jugendstil-Architekten. Er bediente sich dieses Stils lediglich, um seinem Freund und Gesch\u00e4ftspartner einen Gefallen zu tun. 1903, als sich der Jugendstil auch international durchgesetzt hatte, wagte er sich an neue Stilelemente heran: Ihm sind die Fenster im Tiffany-Stil zu verdanken. Und es wird deutlich, wer Brunfauts Vorbilder waren: Victor Horta und Octave van Rijsselberghe (der Architekt des H\u00f4tel Otlet und H\u00f4tel de Brouck\u00e8re).\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Maison Hannon","address_street_name":"Avenue de la Jonction","address_street_number":"1","address_street_box":null,"email":"info@maisonhannon.be","website":"https:\/\/maisonhannon.be","phone_contact":null,"phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Avenue de la Jonction, 1","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Maison Hannon","address_street_name":"Verbindingslaan","address_street_number":"1","address_street_box":null,"email":"info@maisonhannon.be","website":"https:\/\/maisonhannon.be","phone_contact":null,"phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Verbindingslaan, 1","address_line2":"1060 Saint-Gilles","description_web":"The Maison Hannon, on the corner of Avenue Brugmann and Avenue de la Jonction, was built in 1902, at the request of the couple Marie and \u00c9douard Hannon, by their friend, the architect Jules Brunfaut. Conceived as a symbolist and dreamlike universe, the house is one of the masterpieces of art nouveau in Brussels, a union of Belgian and French art of the time. \r\nJules Brunfaut, unfamiliar with the new style, was inspired by other architects' houses, such as those of Victor Horta (personal house, Tassel and Wessinger hotels), Ernest Bl\u00e9rot (personal house, now destroyed) and Octave Van Rysselbeghe and Henry Van de Velde (Otlet hotel). \r\nCombining the beaux-arts style with that of modernity, or art nouveau at that period, the Maison Hannon is a singular work, an intimate and personal house, bringing together the tastes and passions of its commissioners. \r\n\r\nThe Maison Hannon will open its doors to the public on June 1, 2023, as a house museum. ","description_print":null,"booking_url":"https:\/\/www.ticketing.brussels\/en\/tickets\/event-details.Maison-Hannon.536bea1a-2f73-4284-9db1-dd3b861df83b","sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Maison Hannon","address_street_name":"Avenue de la Jonction","address_street_number":"1","address_street_box":null,"email":"info@maisonhannon.be","website":"https:\/\/maisonhannon.be","phone_contact":null,"phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Avenue de la Jonction, 1","address_line2":"1060 Saint-Gilles","description_web"