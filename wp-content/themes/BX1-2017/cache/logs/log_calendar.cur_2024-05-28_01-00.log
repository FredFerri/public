w.lokahistudio.com\/workshop","email":"contact@macadamgallery.com","phone_contact":"+32 489 11 96 21","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50011012"},"en":{"name":"Yoga in the Gallery | Dreamlike Flow","shortdescr":"Experience an immersive 1-hour yoga class surrounded by a dreamlike installation by artist Jordan Tran-Kean in the beautiful Macadam Gallery. Flow through poses infused with creativity and inspiration, as the surreal beauty of the artwork deepens your mindfulness and connection to body and spirit. This special setting merges physical practice with artistic expression for a transformative journey","longdescr":"About the exhibition: Aurore C\u00e9leste by Jordan Tran \/ Kean\n\nAurore C\u00e9leste is a brand-new seven-piece installation by French artist Jordan Tran \/ Kean presented for the very first time at Macadam Gallery. Kean's expertise in gradients and color nuances is endowed with a strong emotional power, encouraging the viewer to dream and contemplate. Jordan's works are part of the legacy of the American Color Field movement, but above all of the California Light and Space movement, whose artists, such as the famous James Turrell, have made the study of perceptual phenomena, particularly light and space, central to their concerns.\n\n\n\nAbout Macadam Gallery\n\nSince 2012, Macadam Gallery is an art gallery dedicated to the promotion of sensibility and contemporary Belgian and international art; a promise of innovative creation in both content and form. Its artist crew works towards the visual experience and are committed to share a new way of seeing and perceiving. The dialogues between our emerging and established artists reflect the gallery\u2019s commitment to a vision of true art that is open to the world. \n\n\nFor more information get in touch at contact@macadamgallery.com\n\nMacadam Gallery, Rue du Charme 34, 1190 Forest\n\n\u2022 Exhibition on view until Saturday, June 1, 2024\n\n\u2022 Opening hours: Thursday to Saturday, 10-18h\n\n\u2022 @macadamgallery | macadamgallery.com","performers":"Macadam Gallery; L\u014dkahi Holistic Studio","boxoffice_url":null,"website":"https:\/\/www.lokahistudio.com\/workshop","email":"contact@macadamgallery.com","phone_contact":"+32 489 11 96 21","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50011012"},"it":{"name":"Dreamlike Flow | yoga in the Gallery","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lokahistudio.com\/workshop","email":"contact@macadamgallery.com","phone_contact":"+32 489 11 96 21","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50011012"},"cn":{"name":"Dreamlike Flow | yoga in the Gallery","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lokahistudio.com\/workshop","email":"contact@macadamgallery.com","phone_contact":"+32 489 11 96 21","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50011012"},"fr":{"name":"Dreamlike Flow | yoga in the Gallery","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lokahistudio.com\/workshop","email":"contact@macadamgallery.com","phone_contact":"+32 489 11 96 21","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50011012"},"sp":{"name":"Dreamlike Flow | yoga in the Gallery","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lokahistudio.com\/workshop","email":"contact@macadamgallery.com","phone_contact":"+32 489 11 96 21","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50011012"},"nl":{"name":"Dreamlike Flow | yoga in the Gallery","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lok