ets":{"list":[],"translations":{}},"tags":[],"accessibilities":{"list":[255,261],"translations":{"fr":["Accessible","Parking accessible"],"nl":["Toegankelijk","Toegankelijke parking"],"en":["Accessible","Accessible parking"],"de":["Barrierefrei","Barrierefreier Parkplatz"],"it":[null,null],"sp":[null,null],"pt":[null,null],"cn":[null,null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-11-23T15:53:36+01:00","published_at":"2022-07-01T13:34:34+02:00","backoffice_id":257536,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":2},{"id":547192,"date_start":"2023-01-20","date_end":"2023-01-20","date_next":"2023-01-20","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert","de":"Konzert","it":null,"sp":null,"pt":null,"cn":null}},"others":{"list":[4,10],"translations":{"fr":["Pop, rock, jazz\u2026","Jazz & Blues"],"nl":["Pop, rock, jazz\u2026","Jazz & Blues"],"en":["Pop, rock, jazz\u2026","Jazz & Blues"],"de":["Pop, Rock, Jazz...","Jazz & Blues"],"it":[null,null],"sp":[null,null],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","en"],"subtitles":[]},"translations":{"fr":{"name":"Dominque Cravic, Claire Elziere, Gregory Veux & Guests : Jazz & \u00ab Chant\u2019pagne \u00bb","shortdescr":"Des petits cabarets des ann\u00e9es 30 \u00e0 Paris, des chansons de Jean Sablon, du Jazz et du swing sur les ondes de la BBC durant la  guerre, jusqu\u2019au bop des caves de Saint-Germain, Dominique Cravic, Claire Elzi\u00e8res Gregory Veux retracent  en jazz et en chansons l\u2019itin\u00e9raire bariol\u00e9 de ces ann\u00e9es folles qui virent se croiser, Jean & Germaine Sablon, Django , Henri Salvador, Gainsbourg ...","longdescr":"Paris, les Ann\u00e9es 30 s\u2019\u00e9veillent, un jeune homme nomm\u00e9 Sablon effectue ses premiers pas dans le monde du disque.\r\nPionnier de l'introduction du jazz en France et de l'utilisation du microphone sur sc\u00e8ne, Sablon incarna ces ann\u00e9es-l\u00e0 et les d\u00e9cennies qui s\u2019en suivirent, la version fran\u00e7aise du crooner am\u00e9ricain.\r\nDe rencontres en rencontres Sablon devient ainsi le premier interpr\u00e8te \u00e0 avoir enregistr\u00e9 avec Django Reinhardt.\r\nPoursuivant son chemin \u00e0 travers le monde, il tra\u00e7a la voie \u00e0 de tr\u00e8s nombreux artistes dans le monde du jazz et de la chanson , tels Boris Vian, Henri Salvador, Mouloudji, Gainsbourg, Aznavour\u2026.\r\nCette \u00e9poque devint alors largement propice au d\u00e9veloppement de chansons de plus en plus fortement port\u00e9es par le Jazz .","performers":"Dominque Cravic, Claire Elziere, Gregory Veux","boxoffice_url":null,"website":"https:\/\/www.lebaixu.be","email":"info@lebaixu.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.547192"},"nl":{"name":"Dominque Cravic, Claire Elziere, Gregory Veux & Guests : Jazz & \u00ab Chant\u2019pagne \u00bb","shortdescr":"Van de kleine cabarets van de jaren 1930 in Parijs, de liedjes van Jean Sablon, jazz en swing op de BBC tijdens  Wereldoorlog, tot de bop van de kelders van Saint-Germain, Dominique Cravic, Claire Elzi\u00e8res Gregory Veux volgen in jazz en zang de kleurige route van deze waanzinnige jaren waarin Jean & Germaine Sablon, Django , Henri Salvador, Gainsbourg ...","longdescr":"Parijs, de jaren 1930, begint te ontwaken, een jonge man genaamd Jean Sablon zet zijn eerste stappen in de wereld van de muziekopnames.\r\nAls pionier bij de introductie van jazz in Frankrijk en het gebruik van de microfoon op het concertpodium heeft Jean Sablon in die jaren en de decennia daarna de Franse versie van de Amerikaanse crooner vertegenwoordigd.\r\nVan ontmoeting tot ontmoeting werd Sablon de eerste artiest die met Django Reinhardt heeft opgenomen.\r\nHij vervolgde zijn reis over de hele wereld en bereikte de weg voor vele artiesten in de wereld van jazz en song, zoals Boris Vian, Henri Salvador, Mouloudji, Gainsbourg, Aznavour....\r\nDeze periode werd in hoge mate bevorderlijk voor de ontwikkeling van songs die steeds sterker door de jazz werden be\u00efnvloed.","performers":"Dominque Cravic, Claire Elziere, Gregory Veux","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.547192"},"en":{"name":"Dominque Cravic, Claire Elziere, Gregory Veux & Guests : Jazz & \u00ab Chant\u2019pagne \u00bb","shortdescr":"From the small cabarets of the 1930s in Paris, the songs of Sablon, jazz and swing on the BBC radio , to the bop of the caves of Saint-Germain, Dominique Cravic, Claire Elzi\u00e8res Gregory Veux , will recall in jazz and in songs the colourful journey of these crazy years which saw Jean & Germaine Sablon, Reinhardt, Henri Salvador, Gainsbourg ...","longdescr":"Paris, the 1930's, are awakening, a young man named Jean Sablon is taking his first steps into the world of recording.\r\n\r\nA pioneer in the introduction of jazz in France and the use of the microphone on stage, Jean Sablon embodied the French version of the American crooner in those years and the decades that followed.\r\nFrom encounters to encounters, Sablon became the first performer to have recorded with Django Reinhardt.\r\nContinuing his journey around the world, he paved the way for many artists in the world of jazz and song, such as Boris Vian, Henri Salvador, Mouloudji, Gainsbourg, Aznavour....\r\nThis period became largely conducive to the development of songs that were more and more strongly influenced by jazz.","performers":"Dominque Cravic, Claire Elziere, Gregory Veux","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.547192"},"de":{"name":"Dominque Cravic, Claire Elziere, Gregory Veux & Guests : Jazz & \u00ab Chant\u2019pagne \u00bb","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.547192"},"it":{"name":"Dominque Cravic, Claire Elziere, Gregory Veux & Guests : Jazz & \u00ab Chant\u2019pagne \u00bb","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.547192"},"sp":{"name":"Dominque Cravic, Claire Elziere, Gregory Veux & Guests : Jazz & \u00ab Chant\u2019pagne \u00bb","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.547192"},"pt":{"name":"Dominque Cravic, Claire Elziere, Gregory Veux & Guests : Jazz & \u00ab Chant\u2019pagne \u00bb","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.547192"},"cn":{"name":"Dominque Cravic, Claire Elziere, Gregory Veux & Guests : Jazz & \u00ab Chant\u2019pagne \u00bb","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.547192"}},"place":{"id":279109,"translations":{"fr":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"info@lebaixu.be",