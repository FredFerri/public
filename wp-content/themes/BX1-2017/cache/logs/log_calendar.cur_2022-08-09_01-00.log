"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":10}],"child_events":[],"parent_events":[],"targets":{"list":[11,3,4,5],"translations":{"fr":["Famille","Enfants 3-6 ans","Enfants 6-9 ans","Enfants 9-12 ans"],"nl":["Familie","Kinderen 3-6 j.","Kinderen 6-9 j.","Kinderen 9-12 j."],"en":["Family","Children 3-6 yr.","Children 6-9 yr.","Children 9-12 yr."]}},"tags":["kids"],"accessibilities":{"list":[255,259,261,263,265],"translations":{"fr":["Accessible","Chien d'assistance","Parking accessible","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9"],"nl":["Toegankelijk","Assistentiehonden","Toegankelijke parking","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet"],"en":["Accessible","Assistance dogs","Accessible parking","Accessible to pedestrians with mobility aids","Adapted toilet"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-08-08T01:08:26+02:00","published_at":"2022-05-17T12:57:01+02:00","backoffice_id":253841,"import_origin":null,"sub_type":"other","show_in_agenda":true,"ranking":0.31833136784577},{"id":533827,"date_start":"2022-07-01","date_end":"2022-08-31","date_next":"2022-08-09","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":84,"translations":{"fr":"Divers","nl":"Varia","en":"Various"}},"others":{"list":[88],"translations":{"fr":["Jeux et quiz"],"nl":["Spel en quiz"],"en":["Games and quiz"]}}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"VLIEG au Mus\u00e9e Mode & Dentelle","shortdescr":"Durant cet \u00e9t\u00e9, le Mus\u00e9e Mode et Dentelle participe \u00e0 Vlieg ! Cette ann\u00e9e, tout tourne autour de l\u2019odorat.\r\n\r\nGr\u00e2ce \u00e0 des \u00e9nigmes et questions amusantes, vos enfants d\u00e9couvrent le mus\u00e9e et ses collections de mani\u00e8re ludique pour d\u00e9nicher le coffre aux tr\u00e9sors rempli\r\nde cadeaux !","longdescr":null,"performers":"Durant cet \u00e9t\u00e9, le Mus\u00e9e Mode et Dentelle participe \u00e0 Vlieg ! Cette ann\u00e9e, tout tourne autour de l\u2019odorat.\r\n\r\nGr\u00e2ce \u00e0 des \u00e9nigmes et questions amusantes, vos enfants d\u00e9couvrent le mus\u00e9e et ses collections de mani\u00e8re ludique pour d\u00e9nicher le coffre aux tr\u00e9sors rempli\r\nde cadeaux !","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.533827"},"nl":{"name":"VLIEG in het Mode & Kant Museum","shortdescr":"Vlieg wijst de weg naar de leukste activiteiten voor families, zoals een schattenjacht!\r\n\r\nTijdens deze zomer neemt het Mode & Kant Museum deel aan Vlieg!\r\nDit jaar staat helemaal in het teken van de reukzin. Dankzij grappige raadsels en vragen ontdekken je kinderen het museum en zijn collectie op een leuke manier en vinden zo de schatkist vol geschenken!","longdescr":null,"performers":"Vlieg wijst de weg naar de leukste activiteiten voor families, zoals een schattenjacht!\r\n\r\nTijdens deze zomer neemt het Mode & Kant Museum deel aan Vlieg!\r\nDit jaar staat helemaal in het teken van de reukzin. Dankzij grappige raadsels en vragen ontdekken je kinderen het museum en zijn collectie op een leuke manier en vinden zo de schatkist vol geschenken!","boxoffice_url":null,"website":"http:\/\/www.fashionandlacemuseum.brussels\/nl","email":"publiekswerking@brucity.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.533827"},"en":{"name":"VLIEG au Mus\u00e9e Mode & Dentelle","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.533827"},"de":{"name":"VLIEG in het Mode & Kant Museum","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.533827"},"it":{"name":"VLIEG in het Mode & Kant Museum","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.533827"},"sp":{"name":"VLIEG in het Mode & Kant Museum","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.533827"},"pt":{"name":"VLIEG in het Mode & Kant Museum","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.533827"},"cn":{"name":"VLIEG in het Mode & Kant Museum","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.533827"}},"place":{"id":1515,"translations":{"fr":{"name":"Mus\u00e9e Mode et Dentelle (Mus\u00e9es de la Ville de Bruxelles)","address_street_name":"Rue de la Violette","address_street_number":"12","address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museemodeetdentelle.brussels","phone_contact":"+32 2 213 44 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Violette, 12","address_line2":"1000 Bruxelles","description_web":"Le Mus\u00e9e Mode & Dentelle pr\u00e9sente ses collections \u00e0 travers de grandes expositions annuelles. Elles abordent tant la cr\u00e9ation que la production et l\u2019usage social du v\u00eatement.\r\nCes expositions vous transportent dans des univers aussi vari\u00e9s que captivants. De l\u2019in\u00e9dit avec Masculinities ou Back Side, de l\u2019historique avec le glamour des ann\u00e9es 30 ou les audacieuses seventies ou encore des expositions consacr\u00e9es \u00e0 des cr\u00e9ateurs de chez nous comme Carine Gilson ou Jean-Paul Lespagnard.\r\n\r\nEn parall\u00e8le \u00e0 ces grandes expositions, le mus\u00e9e propose \u00e9galement :\r\n\r\n- La Fashion Room, cet espace in\u00e9dit en Belgique vous permet de comprendre comment un mus\u00e9e enrichit ses collections. D\u00e9couvrez y des pi\u00e8ces exceptionnelles, hors vitrine, afin d\u2019\u00eatre au plus proche de celles-ci.\r\n\r\n- La Chambre des Dentelles pr\u00e9sente de remarquables pi\u00e8ces illustrant la finesse, la qualit\u00e9 et la beaut\u00e9 de la dentelle de Bruxelles. Explorez l\u2019histoire de cette \u00e9toffe pris\u00e9e des \u00e9lites d\u00e8s le 17e si\u00e8cle et aujourd\u2019hui disparue.\r\n\r\nAbrit\u00e9 au c\u0153ur de Bruxelles, dans un ensemble de maisons historiques, le Mus\u00e9e Mode & Dentelle conserve quelque 15.000 pi\u00e8ces datant du 16e si\u00e8cle \u00e0 nos jours. Il poss\u00e8de les plus importantes collections au monde en ce qui concerne la cr\u00e9ation et la confection bruxelloises, qu\u2019il vise \u00e0 replacer dans un contexte belge et international.\r\nSes collections sont les t\u00e9moins de l\u2019\u00e9volution de la mode mais aussi d\u2019une \u00e9poque, de notre culture, de notre soci\u00e9t\u00e9.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Mode en Kant Museum (Musea van de Stad Brussel)","address_street_name":"Violetstraat","address_street_number":"12","address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.fashionandlacemuseum.brussels\/nl","phone_contact":"+32 2 213 44 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Brussel","address_line1":"Violetstraat, 12","address_line2":"1000 Brussel","description_web":"Het Mode & Kant Museum presenteert zijn collecties tijdens grote jaarlijkse tentoonstellingen. Daarin komen het ontwerp, de productie en de sociale dimensie van kleding aan bod.\r\nDeze tentoonstellingen nemen je telkens mee naar een wereld die even gevarieerd als boeiend is. Je maakt er kennis met het ongeziene in Masculinities en Back Side, of met de historische glamour uit de jaren dertig. Ook de gedurfde jaren zeventig en tentoonstellingen gewijd aan onze eigen ontwerpers, zoals Carine Gilson of Jean-Paul Lespagnard, stonden ooit op het programma.\r\n\r\nNaast deze grote tentoonstellingen laat het museum je ook graag kennismaken met:\r\n- De Fashion Room, een baanbrekend concept in Belgi\u00eb, dat je toont hoe een museum zijn collecties verrijkt. We hebben enkele uitzonderlijke stukken opgesteld buiten de vitrine, zodat je ze in detail kunt bekijken.\r\n\r\n- De Kantkamer, waar opmerkelijke stukken opgesteld staan die de verfijning, de kwaliteit en de schoonheid van het Brusselse kantwerk illustreren. Kom de geschiedenis van deze stof ontdekken, die vanaf de 17e eeuw erg door de elite werd gewaardeerd, maar die nu verdwenen is.\r\nIn hartje  Brussel, in een groep historische huizen, bewaart het Mode & Kant Museum ongeveer 15.000 voorwerpen die dateren van de 16e eeuw tot vandaag. Het bezit de belangrijkste collecties ter wereld rond de Brusselse ontwerpen en kleding, die het in een Belgische en internationale context wil plaatsen.\r\nDe collecties leggen getuigenis af over de evolutie van de mode, maar ook over een tijdperk, onze cultuur en onze maatschappij.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Museum of Fashion & Lace (Museums of the City of Brussels)","address_street_name":"rue de la Violette","address_street_number":"12","address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.fashionandlacemuseum.brussels","phone_contact":"+32 2 213 44 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Brussels","address_line1":"rue de la Violette, 12","address_line2":"1000 Brussels","description_web":"The Fashion & Lace Museum displays its collections by means of major annual exhibitions. These address both the design and the production and social use of the garments.\r\nThe exhibitions transport you to diverse and captivating worlds. From items never before exhibited, such as in Masculinities or Back Side, through historical themes, such as the glamour of the 1930s or the bold \u201870s, to exhibitions devoted to Belgian designers such as Carine Gilson and Jean-Paul Lespagnard.\r\n\r\nParallel to these major exhibitions, the museum also offers:\r\n\r\n- The Fashion Room, an unparalleled space in Belgium, provides you with the opportunity to understand how a museum builds its collections. Discover exceptional items, not hidden behind glass, in order to see them up close.\r\n\r\n- The Lace Room displays remarkable pieces that illustrate the finesse, high quality and beauty of Brussels lace. Explore the history of this type of fabric, so valued by the elites in the 17th century yet no longer in vogue today.\r\n\r\nHoused in a series of historic houses at the heart of Brussels, the Fashion & Lace Museum holds some 15,000 pieces from the 16th century to the present. The Museum has the most important collections in the world when it comes to Brussels design and production, which it seeks to position in a Belgian and international context.\r\nIts collections attest to the changes in fashion as well as to a specific era of our culture and our society.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Mus\u00e9e Mode et Dentelle - Mode- und Spitzenmuseum (Museen der Stadt Br\u00fcssel)","address_street_name":"Rue de la Violette","address_street_number":"12","address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.fashionandlacemuseum.brussels","phone_contact":"+32 2 213 44 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Violette, 12","address_line2":"1000 Bruxelles","description_web":"Das im Jahr 1977 er\u00f6ffnete Mode- und Spitzenmuseum (Mus\u00e9e Mode et Dentelle) hat in Br\u00fcssel eine echte Daseinsberechtigung, denn die Geschichte der Stadt, ja des Landes ist im wahrsten Sinne des Wortes eng mit der Textilkunst verwoben.\r\n\r\nBr\u00fcssel weist ein reiches Erbe auf, was feine Stoffe und Textilwaren angeht. Die Tradition der Textilindustrie, die bis ins 12. Jahrhundert zur\u00fcckreicht und sich bis heute im Bereich Modedesign und Textilhandel zeigt, ist fest in der Br\u00fcsseler Kultur verankert.\r\n\r\nEinen faszinierenden Einblick in diesen Bereich geben die reichen Sammlungen des Mode- und Spitzenmuseums mit alten, aber auch modernen Spitzengeweben, Stickereien, Kost\u00fcmen und extravaganten Accessoires, die im Rahmen regelm\u00e4\u00dfig wechselnder Ausstellungen gezeigt werden.\r\n\r\nParallel zu den gro\u00dfen thematischen Ausstellungen bietet das Mode- und Spitzenmuseum der zeitgen\u00f6ssischen Textilkreation eine besondere Plattform: Seit 2004 empf\u00e4ngt das Museum wechselnde Ausstellungen, die sowohl die Arbeiten von Studierenden im Bereich Textilkunst als auch die Werke bereits etablierter Textilk\u00fcnstler zeigen.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Mus\u00e9e Mode et Dentelle (Mus\u00e9es de la Ville de Bruxelles)","address_street_name":"Rue de la Violette","address_street_number":"12","address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.fashionandlacemuseum.brussels","phone_contact":"+32 2 213 44 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Violette, 12","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Museo del Traje y Encaje (Museos de la Ciudad de Bruselas)","address_street_name":"Rue de la Violette","address_street_number":"12","address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.fashionandlacemuseum.brussels","phone_contact":"+32 2 213 44 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Violette, 12","address_line2":"1000 Bruxelles","description_web":"El Museo del Traje y el Encaje destaca por su perspectiva din\u00e1mica e innovadora centrada en la moda contempor\u00e1nea. Ideal para ver prendas excepcionales de moda belga y bruselense en exposiciones temporales, como la de Jean-Paul Lespagnard. \r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Mus\u00e9e Mode et Dentelle (Mus\u00e9es de la Ville de Bruxelles)","address_street_name":"Rue de la Violette","address_street_number":"12","address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museemodeetdentelle.brussels","phone_contact":"+32 2 213 44 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Violette, 12","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Mus\u00e9e Mode et Dentelle (Mus\u00e9es de la Ville de Bruxelles)","address_street_name":"Rue de la Violette","address_street_number":"12","address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museemodeetdentelle.brussels","phone_contact":"+32 2 213 44 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Violette, 12","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[13],"translations":{"fr":["Centre historique"],"nl":["Historisch centrum"],"en":["Historical Centre"]}},"zones":{"list":[19],"translations":{"fr":["Centre"],"nl":["Centrum"],"en":["Centre"]}},"neca":null,"facebook_id":null,"backoffice_id":197,"location":{"lat":50.84577733,"lon":4.35198995},"region":"brussels","last_updated_at":"2022-08-08T01:08:19+02:00","published_at":"2013-10-19T01:13:21+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":1515,"translations":{"fr":{"name":"Mus\u00e9e Mode et Dentelle (Mus\u00e9es de la Ville de Bruxelles)","address_street_name":"Rue de la Violette","address_street_number":"12","address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museemodeetdentelle.brussels","phone_contact":"+32 2 213 44 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Violette, 12","address_line2":"1000 Bruxelles","description_web":"Le Mus\u00e9e Mode & Dentelle pr\u00e9sente ses collections \u00e0 travers de grandes expositions annuelles. Elles abordent tant la cr\u00e9ation que la production et l\u2019usage social du v\u00eatement.\r\nCes expositions vous transportent dans des univers aussi vari\u00e9s que captivants. De l\u2019in\u00e9dit avec Masculinities ou Back Side, de l\u2019historique avec le glamour des ann\u00e9es 30 ou les audacieuses seventies ou encore des expositions consacr\u00e9es \u00e0 des cr\u00e9ateurs de chez nous comme Carine Gilson ou Jean-Paul Lespagnard.\r\n\r\nEn parall\u00e8le \u00e0 ces grandes expositions, le mus\u00e9e propose \u00e9galement :\r\n\r\n- La Fashion Room, cet espace in\u00e9dit en Belgique vous permet de comprendre comment un mus\u00e9e enrichit ses collections. D\u00e9couvrez y des pi\u00e8ces exceptionnelles, hors vitrine, afin d\u2019\u00eatre au plus proche de celles-ci.\r\n\r\n- La Chambre des Dentelles pr\u00e9sente de remarquables pi\u00e8ces illustrant la finesse, la qualit\u00e9 et la beaut\u00e9 de la dentelle de Bruxelles. Explorez l\u2019histoire de cette \u00e9toffe pris\u00e9e des \u00e9lites d\u00e8s le 17e si\u00e8cle et aujourd\u2019hui disparue.\r\n\r\nAbrit\u00e9 au c\u0153ur de Bruxelles, dans un ensemble de maisons historiques, le Mus\u00e9e Mode & Dentelle conserve quelque 15.000 pi\u00e8ces datant du 16e si\u00e8cle \u00e0 nos jours. Il poss\u00e8de les plus importantes collections au monde en ce qui concerne la cr\u00e9ation et la confection bruxelloises, qu\u2019il vise \u00e0 replacer dans un contexte belge et international.\r\nSes collections sont les t\u00e9moins de l\u2019\u00e9volution de la mode mais aussi d\u2019une \u00e9poque, de notre culture, de notre soci\u00e9t\u00e9.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Mode en Kant Museum (Musea van de Stad Brussel)","address_street_name":"Violetstraat","address_street_number":"12","address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.fashionandlacemuseum.brussels\/nl","phone_contact":"+32 2 213 44 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Brussel","address_line1":"Violetstraat, 12","address_line2":"1000 Brussel","description_web":"Het Mode & Kant Museum presenteert zijn collecties tijdens grote jaarlijkse tentoonstellingen. Daarin komen het ontwerp, de productie en de sociale dimensie van kleding aan bod.\r\nDeze tentoonstellingen nemen je telkens mee naar een wereld die even gevarieerd als boeiend is. Je maakt er kennis met het ongeziene in Masculinities en Back Side, of met de historische glamour uit de jaren dertig. Ook de gedurfde jaren zeventig en tentoonstellingen gewijd aan onze eigen ontwerpers, zoals Carine Gilson of Jean-Paul Lespagnard, stonden ooit op het programma.\r\n\r\nNaast deze grote tentoonstellingen laat het museum je ook graag kennismaken met:\r\n- De Fashion Room, een baanbrekend concept in Belgi\u00eb, dat je toont hoe een museum zijn collecties verrijkt. We hebben enkele uitzonderlijke stukken opgesteld buiten de vitrine, zodat je ze in detail kunt bekijken.\r\n\r\n- De Kantkamer, waar opmerkelijke stukken opgesteld staan die de verfijning, de kwaliteit en de schoonheid van het Brusselse kantwerk illustreren. Kom de geschiedenis van deze stof ontdekken, die vanaf de 17e eeuw erg door de elite werd gewaardeerd, maar die nu verdwenen is.\r\nIn hartje  Brussel, in een groep historische huizen, bewaart het Mode & Kant Museum ongeveer 15.000 voorwerpen die dateren van de 16e eeuw tot vandaag. Het bezit de belangrijkste collecties ter wereld rond de Brusselse ontwerpen en kleding, die het in een Belgische en internationale context wil plaatsen.\r\nDe collecties leggen getuigenis af over de evolutie van de mode, maar ook over een tijdperk, onze cultuur en onze maatschappij.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Museum of Fashion & Lace (Museums of the City of Brussels)","address_street_name":"rue de la Violette","address_street_number":"12","address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.fashionandlacemuseum.brussels","phone_contact":"+32 2 213 44 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Brussels","address_line1":"rue de la Violette, 12","address_line2":"1000 Brussels","description_web":"The Fashion & Lace Museum displays its collections by means of major annual exhibitions. These address both the design and the production and social use of the garments.\r\nThe exhibitions transport you to diverse and captivating worlds. From items never before exhibited, such as in Masculinities or Back Side, through historical themes, such as the glamour of the 1930s or the bold \u201870s, to exhibitions devoted to Belgian designers such as Carine Gilson and Jean-Paul Lespagnard.\r\n\r\nParallel to these major exhibitions, the museum also offers:\r\n\r\n- The Fashion Room, an unparalleled space in Belgium, provides you with the opportunity to understand how a museum builds its collections. Discover exceptional items, not hidden behind glass, in order to see them up close.\r\n\r\n- The Lace Room displays remarkable pieces that illustrate the finesse, high quality and beauty of Brussels lace. Explore the history of this type of fabric, so valued by the elites in the 17th century yet no longer in vogue today.\r\n\r\nHoused in a series of historic houses at the heart of Brussels, the Fashion & Lace Museum holds some 15,000 pieces from the 16th century to the present. The Museum has the most important collections in the world when it comes to Brussels design and production, which it seeks to position in a Belgian and international context.\r\nIts collections attest to the changes in fashion as well as to a specific era of our culture and our society.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Mus\u00e9e Mode et Dentelle - Mode- und Spitzenmuseum (Museen der Stadt Br\u00fcssel)","address_street_name":"Rue de la Violette","address_street_number":"12","address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.fashionandlacemuseum.brussels","phone_contact":"+32 2 213 44 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Violette, 12","address_line2":"1000 Bruxelles","description_web":"Das im Jahr 1977 er\u00f6ffnete Mode- und Spitzenmuseum (Mus\u00e9e Mode et Dentelle) hat in Br\u00fcssel eine echte Daseinsberechtigung, denn die Geschichte der Stadt, ja des Landes ist im wahrsten Sinne des Wortes eng mit der Textilkunst verwoben.\r\n\r\nBr\u00fcssel weist ein reiches Erbe auf, was feine Stoffe und Textilwaren angeht. Die Tradition der Textilindustrie, die bis ins 12. Jahrhundert zur\u00fcckreicht und sich bis heute im Bereich Modedesign und Textilhandel zeigt, ist fest in der Br\u00fcsseler Kultur verankert.\r\n\r\nEinen faszinierenden Einblick in diesen Bereich geben die reichen Sammlungen des Mode- und Spitzenmuseums mit alten, aber auch modernen Spitzengeweben, Stickereien, Kost\u00fcmen und extravaganten Accessoires, die im Rahmen regelm\u00e4\u00dfig wechselnder Ausstellungen gezeigt werden.\r\n\r\nParallel zu den gro\u00dfen thematischen Ausstellungen bietet das Mode- und Spitzenmuseum der zeitgen\u00f6ssischen Textilkreation eine besondere Plattform: Seit 2004 empf\u00e4ngt das Museum wechselnde Ausstellungen, die sowohl die Arbeiten von Studierenden im Bereich Textilkunst als auch die Werke bereits etablierter Textilk\u00fcnstler zeigen.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Mus\u00e9e Mode et Dentelle (Mus\u00e9es de la Ville de Bruxelles)","address_street_name":"Rue de la Violette","address_street_number":"12","address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.fashionandlacemuseum.brussels","phone_contact":"+32 2 213 44 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Violette, 12","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Museo del Traje y Encaje (Museos de la Ciudad de Bruselas)","address_street_name":"Rue de la Violette","address_street_number":"12","address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.fashionandlacemuseum.brussels","phone_contact":"+32 2 213 44 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Violette, 12","address_line2":"1000 Bruxelles","description_web":"El Museo del Traje y el Encaje destaca por su perspectiva din\u00e1mica e innovadora centrada en la moda contempor\u00e1nea. Ideal para ver prendas excepcionales de moda belga y bruselense en exposiciones temporales, como la de Jean-Paul Lespagnard. \r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Mus\u00e9e Mode et Dentelle (Mus\u00e9es de la Ville de Bruxelles)","address_street_name":"Rue de la Violette","address_street_number":"12","address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museemodeetdentelle.brussels","phone_contact":"+32 2 213 44 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Violette, 12","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Mus\u00e9e Mode et Dentelle (Mus\u00e9es de la Ville de Bruxelles)","address_street_name":"Rue de la Violette","address_street_number":"12","address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museemodeetdentelle.brussels","phone_contact":"+32 2 213 44 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Violette, 12","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":null,"facebook_id":null,"backoffice_id":197,"location":{"lat":50.84577733,"lon":4.35198995},"region":"brussels","last_updated_at":"2022-08-08T01:08:19+02:00","published_at":"2013-10-19T01:13:21+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/f67e3e2e3bff7b2d9fbf1b088b0dbef7d7683069.jpg","width":2500,"height":3264,"ratio":0.77,"translations":{"fr":{"title":"VLIEG au Mus\u00e9e Mode & Dentelle","copyright":"Mode & Kant Museum \u00a9 Peeters-Dohet"},"nl":{"title":"VLIEG au Mus\u00e9e Mode & Dentelle"