che en Brusselse erfgoed en ontwikkelt talrijke culturele projecten, vooral in Brussel, tussen architectuur, stedenbouw, cultuur, plastische kunsten en ideologie, van de Middeleeuwen tot vandaag. De stad en haar architecturale ontwikkeling zien en begrijpen, de artistieke creatie benaderen en er een betekenis aan geven, dat zijn de activiteiten die de VZW met het publiek wil delen. Zij zijn gespecialiseerd in architectonisch erfgoed en hedendaagse kunst en laten de stad zien door middel van rondleidingen en lezingen in verschillende talen.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":36946,"location":{"lat":50.84145283,"lon":4.35976257},"last_updated_at":"2023-06-08T12:25:28+02:00","published_at":"2021-07-23T14:48:31+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/e5f1bc85c9949923e39db7a7bc0d948188c3f860.jpg","width":3108,"height":1798,"ratio":1.73,"oEmbed_height":1798,"oEmbed_width":3108,"translations":{"de":{"title":"Maison Devalck","copyright":null},"pt":{"title":"Maison Devalck","copyright":null},"en":{"title":"Maison Devalck","copyright":null},"it":{"title":"Maison Devalck","copyright":null},"cn":{"title":"Maison Devalck","copyright":null},"fr":{"title":"Maison Devalck","copyright":null},"sp":{"title":"Maison Devalck","copyright":null},"nl":{"title":"Maison Devalck","copyright":null}}}],"dates":[{"day":"2025-01-18","doors":null,"start":"11:00:00","end":"11:50:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2025-02-23","doors":null,"start":"10:00:00","end":"10:50:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2025-02-23","doors":null,"start":"11:00:00","end":"11:50:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2025-03-09"