s_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-10-31T15:22:03+01:00","published_at":"2024-07-01T11:00:41+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":303271,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"theatre","ranking":0.6809771661258215,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":49,"translations":{"de":"Theater","pt":null,"en":"Theatre","it":"Teatro","cn":null,"fr":"Th\u00e9\u00e2tre","sp":"Teatro","nl":"Theater"}},"others":{"list":[50],"translations":{"de":["Theater"],"pt":[null],"en":["Theatre"],"it":["Teatro"],"cn":[null],"fr":["Th\u00e9\u00e2tre"],"sp":["Teatro"],"nl":["Theater"]}}},"translations":{"de":{"name":"pieds nus (vokte bobik) | Agn\u00e8s GUIGNARD","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/theatre-martyrs.be\/spectacles\/pieds-nus\/","email":"billetterie@theatre-martyrs.be","phone_contact":null,"phone_booking":"+32 2 223 32 08","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50012039"},"pt":{"name":"pieds nus (vokte bobik) | Agn\u00e8s GUIGNARD","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/theatre-martyrs.be\/spectacles\/pieds-nus\/","email":"billetterie@theatre-martyrs.be","phone_contact":null,"phone_booking":"+32 2 223 32 08","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50012039"},"en":{"name":"Pieds nus (vokte bobik)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/theatre-martyrs.be\/spectacles\/pieds-nus\/","email":"billetterie@theatre-martyrs.be","phone_contact":null,"phone_booking":"+32 2 223 32 08","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50012039"},"it":{"name":"pieds nus (vokte bobik) | Agn\u00e8s GUIGNARD","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/theatre-martyrs.be\/spectacles\/pieds-nus\/","email":"billetterie@theatre-martyrs.be","phone_contact":null,"phone_booking":"+32 2 223 32 08","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50012039"},"cn":{"name":"pieds nus (vokte bobik) | Agn\u00e8s GUIGNARD","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/theatre-martyrs.be\/spectacles\/pieds-nus\/","email":"billetterie@theatre-martyrs.be","phone_contact":null,"phone_booking":"+32 2 223 32 08","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50012039"},"fr":{"name":"Pieds nus (vokte bobik)","shortdescr":null,"longdescr":"Le mot histoire est un peu pr\u00e9tentieux. Rien n\u2019est romantique dans l\u2019histoire de ces gens ballott\u00e9s en \u00e9quilibre entre la mis\u00e8re, les r\u00eaves, l\u2019amour simple et sans condition pour leurs enfants, et le travail qui leur rendait l\u2019honneur. Voil\u00e0 quelques petits grains que j\u2019ai conserv\u00e9s pr\u00e9cieusement dans ma main, intacts, et que je vais \u00e9grener avec plaisir. Je n\u2019ai rien invent\u00e9.\nAnna\n\nEt pourtant il s\u2019agit bien d\u2019une histoire, d\u2019histoires, d\u2019Histoire. Le jour o\u00f9 Agn\u00e8s Guignard re\u00e7oit des mains de sa m\u00e8re Anna un cahier d\u2019\u00e9cole dans lequel celle-ci a retranscrit le r\u00e9cit de vie d\u2019Hagop, le grand-p\u00e8re d\u2019Agn\u00e8s, commence pour l\u2019actrice et autrice de Pieds nus (vokte bobik), le trajet du saumon\u2026 Celui qui remonte la rivi\u00e8re o\u00f9 il est n\u00e9. Enfant, elle a connu son grand-p\u00e8re, cette pr\u00e9sence silencieuse au sourire \u00e9nigmatique, qui ne parlait qu\u2019en arm\u00e9nien, \u00e0 sa fille. Le cahier \u00e0 l\u2019\u00e9criture brute et sans commentaire est donc celui des confidences d\u2019Hagop vues depuis le prisme d\u2019Anna.\nD\u2019abord habit\u00e9e par la question de la v\u00e9rit\u00e9, notamment en visitant les Archives du Territoire de Belfort dans l\u2019est de la France o\u00f9 Hagop a immigr\u00e9 en 1923, Agn\u00e8s est confront\u00e9e \u00e0 ce que la v\u00e9rit\u00e9 peut comporter de parcellaire et de fragile, et s\u2019approprie aujourd\u2019hui ce r\u00e9cit de transmission en le portant dans son propre langage, celui du th\u00e9\u00e2tre.\nDiyarbakir, Mardine, Mossoul, Alep, Bagdad, Beyrouth, Marseille, Belfort \u2026\nHistoire de ce qu\u2019a travers\u00e9 ce r\u00e9fugi\u00e9 arm\u00e9nien fuyant le g\u00e9nocide de 1915-1916. Histoire d\u2019une survivance, d\u2019une \u00e9chapp\u00e9e et d\u2019une m\u00e9moire qui ne veut pas mourir.\nHistoire aussi en filigrane du chemin partag\u00e9 avec humour et joie de vivre entre une m\u00e8re et sa fille.\nLe spectacle commence d\u2019ailleurs au cimeti\u00e8re, devant la tombe d\u2019Hagop, o\u00f9 la voix d\u2019Anna enregistr\u00e9e par Agn\u00e8s entre en dialogue avec celle de sa fille qui est face \u00e0 nous. Et c\u2019est aussi au creux d\u2019un dialogue entre le singulier et l\u2019universel, le pass\u00e9 et le pr\u00e9sent, le certain et l\u2019incertain, le r\u00e9el et le fictif, que se tisse la question de la pr\u00e9sence. Celle de la voix de la m\u00e8re aujourd\u2019hui disparue, celle du fant\u00f4me au parcours intime adoss\u00e9 \u00e0 l\u2019Histoire, et celle du corps en jeu qui nous offre sa v\u00e9rit\u00e9 vibrante.","performers":"texte, conception & jeu Agn\u00e8s Guignard\ncr\u00e9ation sonore Marc Doutrepont\ncr\u00e9ation lumi\u00e8res Renaud Ceulemans\ndramaturgie & mise en sc\u00e8ne Jean- Gabriel Vidal-Vandroy\ntravail du mouvement & collaboration artistique Sophie Leso\nsc\u00e9nographie & costumes Claire Farah\nillusion Tim Oelbrandt\nproduction Nathalie Kamoun","boxoffice_url":null,"website":"https:\/\/theatre-martyrs.be\/spectacles\/pieds-nus\/","email":"billetterie@theatre-martyrs.be","phone_contact":null,"phone_booking":"+32 2 223 32 08","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50012039"},"sp":{"name":"pieds nus (vokte bobik) | Agn\u00e8s GUIGNARD","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/theatre-martyrs.be\/spectacles\/pieds-nus\/","email":"billetterie@theatre-martyrs.be","phone_contact":null,"phone_booking":"+32 2 223 32 08","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50012039"},"nl":{"name":"Pieds nus (vokte bobik)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/theatre-martyrs.be\/spectacles\/pieds-nus\/","email":"billetterie@theatre-martyrs.be","phone_contact":null,"phone_booking":"+32 2 223 32 08","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50012039"}},"place":{"id":231711,"translations":{"de":{"name":"Th\u00e9\u00e2tre des Martyrs","address_street_name":"Place des Martyrs","address_street_number":"22","address_street_box":null,"email":"billetterie@theatre-martyrs.be","website":"http:\/\/www.theatre-martyrs.be","phone_contact":"+32 2 223 32 08","phone_booking":"+32 2 223 32 08","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Martyrs, 22","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Th\u00e9\u00e2tre des Martyrs","address_street_name":"Place des Martyrs","address_street_number":"22","address_street_box":null,"email":"billetterie@theatre-martyrs.be","website":"http:\/\/www.theatre-martyrs.be","phone_contact":"+32 2 223 32 08","phone_booking":"+32 2 223 32 08","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Martyrs, 22","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtua