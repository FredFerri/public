05:07+01:00","published_at":"2013-10-19T01:14:45+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":false,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/fa7179e44c1ca7a609846f4d035c380facdeb7cd.jpg","width":2642,"height":1587,"ratio":1.66,"translations":{"fr":{"title":"Volosi (POL)","copyright":null},"nl":{"title":"Volosi (POL)","copyright":null},"en":{"title":"Volosi (POL)","copyright":null}}}],"dates":[{"day":"2022-11-29","doors":null,"start":"20:00:00","end":null,"is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":17},{"translations":{"fr":{"name":"Pr\u00e9vente"},"nl":{"name":"Voorverkoop"},"en":{"name":"Presale"}},"value":15},{"translations":{"fr":{"name":"Article 27"},"nl":{"name":"Artikel 27"},"en":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[],"targets":{"list":[12,11,10,7,8],"translations":{"fr":["LGTBQIA","Famille","Seniors","Jeunes 12-15 ans","Jeunes 15-18 ans"],"nl":["LGTBQIA","Familie","Senioren","Jongeren 12-15 j.","Jongeren 15-18 j."],"en":["LGTBQIA","Family","Seniors","Youth 12-15  yr.","Youth 15-18  yr."]}},"tags":["kids"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-11-02T17:05:08+01:00","published_at":"2022-11-02T16:46:43+01:00","backoffice_id":265086,"import_origin":null,"sub_type":"concert","show_in_agenda":true,"ranking":1.2599210498949},{"id":537334,"date_start":"2022-11-29","date_end":"2022-12-02","date_next":"2022-11-29","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater"}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"],"de":["Theater"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Herakles","shortdescr":"Road-trip autofictif au c\u0153ur de la Gr\u00e8ce antique, Herakles est une vir\u00e9e le long du mythe hercul\u00e9en. Violence. Culpabilit\u00e9. H\u00e9ritage. R\u00e9paration. Autant de questions secouent ce \u00ab h\u00e9ros \u00bb mythologique tout autant que le monde d\u2019aujourd\u2019hui.","longdescr":"H\u00e9racl\u00e8s \u2013 aussi connu sous le nom d\u2019Hercule, ou Hercules, ou Heracl\u00e8s, ou d\u2019autres encore, c\u2019est selon \u2013 est l\u2019homme aux douze glorieux travaux, au corps muscl\u00e9 et endurci d\u2019exploits divers, \u00e0 la m\u00e8che lisse et parfaitement rebelle\u2026 Oui, oui. Mais quelque part, dans son histoire, ce demi-dieu devenu h\u00e9ros puis figure in\u00e9vitable du panth\u00e9on culturel, tue sa femme et ses enfants. Cette partie est souvent omise, oubli\u00e9e, ignor\u00e9e peut-\u00eatre. Or cet \u00e9pisode conf\u00e8re au mythe une tout autre ampleur... Herakles est le r\u00e9cit de la rencontre de Joseph Olivennes avec ce \u00ab h\u00e9ros \u00bb. Une rencontre kal\u00e9idoscopique, musicale, narrative, avec quelques questions comme point de d\u00e9part. Que raconte le mythe aujourd\u2019hui ? Que faire de ce h\u00e9ros d\u00e9chu ? Quelle place r\u00e9server \u00e0 la culpabilit\u00e9 ? Et comment faire pour r\u00e9parer ? Un voyage donc, entre questions escarp\u00e9es et plages existentielles.","performers":"De et avec Joseph Olivennes\r\nCollaboration artistique Alyssa Tzavaras\r\nCollaboration \u00e0 la dramaturgie J\u00e9r\u00e9mie Lebreton\r\nCr\u00e9ation lumi\u00e8re Lionel Uebershlag\r\nCr\u00e9ation costumes Clothilde Arzoumanian-Charron\r\nDistribution en cours","boxoffice_url":null,"website":"http:\/\/www.lestanneurs.be","email":"info@lestanneurs.be","phone_contact":"