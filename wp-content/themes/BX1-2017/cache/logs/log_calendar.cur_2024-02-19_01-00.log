type":"tour","ranking":0.3149802624737183,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{"list":[255],"translations":{"de":["Besuche von Ausstellungen"],"pt":[null],"en":["Exhibition guided tours"],"it":["Visite a esposizioni"],"cn":[null],"fr":["Visites d'expositions"],"sp":["Visitas a las exposiciones"],"nl":["Tentoonstelling"]}}},"translations":{"de":{"name":"Exposition \"Ne meurent que ceux que l'on oublie\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/cclj.be\/exposition-ne-meurent-que-ceux-que-lon-oublie\/","email":"celine@cclj.be","phone_contact":"+32 2 543 02 70","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50006093"},"pt":{"name":"Exposition \"Ne meurent que ceux que l'on oublie\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/cclj.be\/exposition-ne-meurent-que-ceux-que-lon-oublie\/","email":"celine@cclj.be","phone_contact":"+32 2 543 02 70","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50006093"},"en":{"name":"Ne meurent que ceux que l'on oublie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/cclj.be\/exposition-ne-meurent-que-ceux-que-lon-oublie\/","email":"celine@cclj.be","phone_contact":"+32 2 543 02 70","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50006093"},"it":{"name":"Exposition \"Ne meurent que ceux que l'on oublie\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/cclj.be\/exposition-ne-meurent-que-ceux-que-lon-oublie\/","email":"celine@cclj.be","phone_contact":"+32 2 543 02 70","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50006093"},"cn":{"name":"Exposition \"Ne meurent que ceux que l'on oublie\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/cclj.be\/exposition-ne-meurent-que-ceux-que-lon-oublie\/","email":"celine@cclj.be","phone_contact":"+32 2 543 02 70","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50006093"},"fr":{"name":"Ne meurent que ceux que l'on oublie","shortdescr":"\u201cNe meurent que ceux que l\u2019on oublie\u201d est une exposition m\u00e9morielle sur la rafle du Pensionnat Gatti de Gamond. Elle a \u00e9t\u00e9 r\u00e9alis\u00e9e \u00e0 l\u2019initiative de Guy Marchand, avec le soutien de Fr\u00e9d\u00e9ric Dambreville, auteur du livre \"Les disparus de Gatti de Gamond\", et avec la participation active des \u00e9l\u00e8ves de Molenbeek-Saint-Jean et de leurs enseignants. \n","longdescr":"Le 12 juin 1943, 14 enfants et plusieurs adultes juifs ainsi qu\u2019Odile Henri-Ovart, directrice du Pensionnat, son mari et leur fille, furent arr\u00eat\u00e9s par la Gestapo suite \u00e0 une d\u00e9nonciation. La plupart d\u2019entre eux seront d\u00e9port\u00e9s et assassin\u00e9s \u00e0 Auschwitz-Birkenau. Parmi les personnes d\u00e9port\u00e9es, H\u00e9l\u00e8ne Gancarska (18 ans au moment de la rafle) et Fajga Warman sont les seules survivantes.\n\nVisite gratuite avec inscription obligatoire.\n\nVous \u00eates enseignant.e et vous voulez aborder cette histoire encore trop peu connue avec vos \u00e9l\u00e8ves?\nNous vous proposons une offre p\u00e9dagogique, et gratuite, \u00e0 destination des \u00e9l\u00e8ves de 5e et 6e primaire et de secondaire. Sur rendez-vous.","performers":null,"boxoffice_url":null,"website":"https:\/\/cclj.be\/exposition-ne-meurent-que-ceux-que-lon-oublie\/","email":"celine@cclj.be","phone_contact":"+32 2 543 02 70","phone_booking":null,"agenda_url":"https:\/\/vi