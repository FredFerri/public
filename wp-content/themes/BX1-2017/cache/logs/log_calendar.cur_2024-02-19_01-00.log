op, een caf\u00e9 en een dakterras met een indrukwekkend uitzicht over de stad. ","description_print":null,"booking_url":null,"sort_order":"WIELS - CONTEMPORARY ART CENTRE","virtual_visit":null,"visit_url":null}},"neca":"art_center","facebook_id":"https:\/\/www.facebook.com\/WielsBrussels","region":"brussels","backoffice_id":195,"location":{"lat":50.82467444,"lon":4.32636558},"last_updated_at":"2023-05-02T15:20:32+02:00","published_at":"2013-10-19T01:13:21+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/8e286982d643ddc2ee4f8374e8fcedb70f267393.jpg","width":2000,"height":1333,"ratio":1.5,"oEmbed_height":1333,"oEmbed_width":2000,"translations":{"de":{"title":"Family Funday","copyright":"Diana Vos"},"pt":{"title":"Family Funday","copyright":"Diana Vos"},"en":{"title":"Family Funday","copyright":"Diana Vos"},"it":{"title":"Family Funday","copyright":"Diana Vos"},"cn":{"title":"Family Funday","copyright":"Diana Vos"},"fr":{"title":"Family Funday","copyright":"Diana Vos"},"sp":{"title":"Family Funday","copyright":"Diana Vos"},"nl":{"title":"Family Funday","copyright":"Diana Vos"}}},{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/c2f222b2729f2ef4a5cd19a6ad4386479b0f8f9a.jpg","width":2677,"height":2139,"ratio":1.25,"oEmbed_height":2139,"oEmbed_width":2677,"translations":{"de":{"title":"Oscar Murillo, disrupted frequencies (detail), 2013-2023 ","copyright":"\u00a9 Oscar Murillo. Photo: Tim Bowditch & Reinis Lismanis"},"pt":{"title":"Oscar Murillo, disrupted frequencies (detail), 2013-2023 ","copyright":"\u00a9 Oscar Murillo. Photo: Tim Bowditch & Reinis Lismanis"},"en":{"title":"Oscar Murillo, disrupted frequencies (detail), 2013-2023 ","copyright":"\u00a9 Oscar Murillo. Photo: Tim Bowditch & Reinis Lismanis"},"it":{"title":"Oscar Murillo, disrupted frequencies (detail), 2013-2023 ","copyright":"\u00a9 Oscar Murillo. Photo: Tim