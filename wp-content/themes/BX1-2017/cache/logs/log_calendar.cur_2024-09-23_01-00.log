me":"Article 27"},"fr":{"name":"Article 27"},"sp":{"name":"Article 27"},"nl":{"name":"Artikel 27"}},"value":1.25}],"date_exceptions":[],"closing_days":[],"child_events":[],"parent_events":[],"accessibilities":[],"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[]},{"id":5700000982,"date_start":"2024-09-28","date_end":"2024-09-29","date_next":"2024-09-28","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-09-05T12:52:08+02:00","published_at":"2024-09-05T12:44:51+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":307238,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"tour","ranking":0.7937005259840998,"languages":{"spoken":["fr","en","nl"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{}},"translations":{"de":{"name":"Guided Tour of the Former Ch\u00e2teau Bischoffsheim (The International School of Brussels) - BBN 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/fr\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700000982"},"pt":{"name":"Guided Tour of the Former Ch\u00e2teau Bischoffsheim (The International School of Brussels) - BBN 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/fr\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700000982"},"en":{"name":"Guided Tour of the Former Ch\u00e2teau Bischoffsheim (The International School of Brussels) - BBN 2024","shortdescr":null,"longdescr":"Originally a country house, the Ch\u00e2teau Bischoffsheim, also called the Ch\u00e2teau des Foug\u00e8res, was built in 1854 for Baron Jonathan Raphael Bischoffsheim and his family. This economist and financier from Frankfurt participated in the establishment of the new nation of Belgium and played an important role in shaping its first economic policies. The architect of the Ch\u00e2teau, Henri Maquet, was subsequently in charge of several important building projects, among them the fa\u00e7ade of the Royal Palace in Brussels. The property, which has housed the International School of Brussels since 1953, sits on top of a hill surrounded by woodland and retains its magnificent salons decorated with mouldings and charming statuary, as well as remarkable parquet floors.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/en\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700000982"},"it":{"name":"Guided Tour of the Former Ch\u00e2teau Bischoffsheim (The International School of Brussels) - BBN 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/fr\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700000982"},"cn":{"name":"Guided Tour of the Former Ch\u00e2teau Bischoffsheim (The International School of Brussels) - BBN 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/fr\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700000982"},"fr":{"name":"Visite Guid\u00e9e de l'Ancien Ch\u00e2teau Bischoffsheim (The International School of Brussels) - BBN 2024","shortdescr":null,"longdescr":"A l'origine maison de campagne, le Ch\u00e2teau Bischoffsheim, \u00e9galement appel\u00e9 \"Ch\u00e2teau des Foug\u00e8res\", fut construit en 1854 pour le baron Jonathan Raphael Bischoffsheim et sa famille. Financier originaire de Francfort, cet \u00e9conomiste participa \u00e0 l'\u00e9tablissement de la jeune nation belge en jouant un r\u00f4le important dans l'\u00e9laboration de ses premi\u00e8res politiques \u00e9conomiques. L'architecte du ch\u00e2teau, Henri Maquet fut, apr\u00e8s cette r\u00e9alisation, charg\u00e9 de plusieurs projets d'importance, dont la fa\u00e7ade du Palais royal de Bruxelles. Accueillant depuis 1953 le si\u00e8ge de l'\u00c9cole Internationale de Bruxelles, cette propri\u00e9t\u00e9 implant\u00e9e au sommet d'une colline et entour\u00e9e de bois, conserve encore de magnifiques salons moulur\u00e9s, de charmants ornements sculpt\u00e9s et de remarquables parquets ouvrag\u00e9s.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/fr\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700000982"},"sp":{"name":"Guided Tour of the Former Ch\u00e2teau Bischoffsheim (The International School of Brussels) - BBN 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/fr\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700000982"},"nl":{"name":"Rondleiding van het  Voormalig kasteel Bischoffsheim (The International School of Brussels) - BBN 2024","shortdescr":null,"longdescr":"Het Kasteel Bischoffsheim was oorspronkelijk een landhuis dat ook wel bekend was onder de naam Ch\u00e2teau des Foug\u00e8res. Het werd gebouwd in 1854 in opdracht van baron Jonathan Raphael Bischoffsheim en zijn familie. Deze econoom en geldschieter uit Frankfurt was betrokken bij de oprichting van de jonge Belgische staat en speelde een belangrijke rol bij de ontwikkeling van Belgi\u00ebs eerste economische beleid. Na de voltooiing van het kasteel kreeg architect Henri Maquet verschillende prestigieuze projecten toegewezen, zoals de bouw van een nieuwe voorgevel voor het Koninklijk Paleis van Brussel. Sinds 1953 heeft de International School of Brussels onderdak in het kasteel. Dit op een heuvel gelegen en door bossen omringd landgoed heeft zijn prachtige salons met sierlijsten, charmant gebeeldhouwde ornamenten en opmerkelijke parketvloeren weten te bewaren.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/nl\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700000982"}},"place":{"id":50002343,"translations":{"de":{"name":"Ancien Ch\u00e2teau Bischoffsheim (The International School of Brussels)","address_street_name":"Kattenberg","address_street_number":"19","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1170","address_city":"Watermael-Boitsfort","address_line1":"Kattenberg, 19","address_line2":"1170 Watermael-Boitsfort","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Ancien Ch\u00e2teau Bisch