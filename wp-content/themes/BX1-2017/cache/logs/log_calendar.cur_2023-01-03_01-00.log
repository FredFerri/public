":"Normaal"},"en":{"name":"Normal"},"de":{"name":"Normal"},"it":{"name":"Normal"},"sp":{"name":"Normal"},"pt":{"name":"Normal"},"cn":{"name":"Normal"}},"value":12},{"translations":{"fr":{"name":"Enfants"},"nl":{"name":"Kinderen"},"en":{"name":"Children"},"de":{"name":"Kinder"},"it":{"name":"Enfants"},"sp":{"name":"Enfants"},"pt":{"name":"Enfants"},"cn":{"name":"Enfants"}},"value":10}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-11-24T13:05:10+01:00","published_at":"2022-11-24T12:18:15+01:00","backoffice_id":266127,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":0.8735804647363},{"id":538040,"date_start":"2023-01-25","date_end":"2023-01-25","date_next":"2023-01-25","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert","de":"Konzert","it":null,"sp":null,"pt":null,"cn":null}},"others":{"list":[4,6],"translations":{"fr":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"],"nl":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"],"en":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"],"de":["Pop, Rock, Jazz...","Worldmusic, Folk & Country"],"it":[null,null],"sp":[null,null],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Le Ba Ya Trio \u2013 Le retour du monde","shortdescr":"Toujours aussi pertinentes et contextualise\u0301es, les chansons du joyeux trio nous invitent a\u0300 les accompagner. Elles nous guident, gra\u0302ce a\u0300 des interactions travaille\u0301es, sur les sentiers de l\u2019interculturalite\u0301 et du vivre ensemble.","longdescr":"Il y a 4 ans commenc\u0327ait un pe\u0301riple a\u0300 la rencontre des musiques du monde. Depuis, la fre\u0301ne\u0301sie de continuer s\u2019est re\u0301pandue comme les sourires sur les visages des enfants rencontre\u0301s.\r\n\r\nApre\u0300s le succe\u0300s de leur premier spectacle, Le Ba Ya Trio a de\u0301cide\u0301 de s\u2019e\u0301loigner le\u0301ge\u0300rement des berceuses et de l\u2019intime sans pour autant stopper ses voyages. Il roule maintenant sa bosse aux confins de la Nouvelle-Ze\u0301lande et des airs maoris, apprenant au passage quelques mouvements Haka. Puis, par quelques pas de flamenco, se dirige vers l\u2019Andalousie avant de rejoindre l\u2019Irlande, la Turquie, le Congo et bon nombre d\u2019autres pays.\r\n\r\nToujours aussi pertinentes et contextualise\u0301es, les chansons du joyeux trio nous invitent a\u0300 les accompagner. Elles nous guident, gra\u0302ce a\u0300 des interactions travaille\u0301es, sur les sentiers de l\u2019interculturalite\u0301 et du vivre ensemble.\r\n\r\nEt si vous apprenez a\u0300 accorder vos yeux, vos oreilles et votre c\u0153ur, vous apercevrez me\u0302me les fondements de nos socie\u0301te\u0301s.\r\n\r\nUn moment complice et une curiosite\u0301 a\u0300 partager !\r\n\r\nlebaya.be\r\n\r\nAvec le soutien du Bourgmestre, de l\u2019Echevin de la Culture, du Coll\u00e8ge des Bourgmestre et Echevins et du Service Culture de la Commune d\u2019Ixelles.","performers":"Samir Barris : chant, guitare\r\nBenoi\u0302t Leseure ou Se\u0301bastien Taminiau ou Jean-Franc\u0327ois Durdu ou Se\u0301bastien Paz : chant, violon\r\nNicholas Yates ou Se\u0301bastien Taminiau : chant, contrebasse","boxoffice_url":null,"website":"https:\/\/www.jeunessesmusicales.be\/bruxelles\/flagey-le-ba-ya-trio\/","email":null,"phone_contact":"+32 2 641 10 20","phone_booking":"+32 2 641 10 20","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.538040"},"nl":{"name":"Le Ba Ya Trio \u2013 Le retour du monde","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.538040"},"en":{"name":"Le Ba Ya Trio \u2013 Le retour du monde","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.538040"},"de":{"name":"Le Ba Ya Trio \u2013 Le retour du monde","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.538040"},"it":{"name":"Le Ba Ya Trio \u2013 Le retour du monde","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.538040"},"sp":{"name":"Le Ba Ya Trio \u2013 Le retour du monde","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.538040"},"pt":{"name":"Le Ba Ya Trio \u2013 Le retour du monde","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.538040"},"cn":{"name":"Le Ba Ya Trio \u2013 Le retour du monde","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.538040"}},"place":{"id":237158,"translations":{"fr":{"name":"Flagey","address_street_name":"Place Sainte-Croix","address_street_number":null,"address_street_box":null,"email":"info@flagey.be","website":"http:\/\/www.flagey.be","phone_contact":"+32 2 641 10 20","phone_booking":"+32 2 641 10 20","address_zip":"1050","address_city":"Ixelles","address_line1":"Place Sainte-Croix","address_line2":"1050 Ixelles","description_web":"Avec un regard tourn\u00e9 vers la place Flagey, vers les \u00e9tangs d'Ixelles, cet ancien b\u00e2timent de radio et de t\u00e9l\u00e9diffusion nationale est aujourd'hui plus que jamais un point de rencontre o\u00f9 diff\u00e9rentes disciplines artistiques se croisent dans un esprit de dialogue. Les amoureux de la culture de tous \u00e2ges sont les bienvenus dans ce magnifique b\u00e2timent Art d\u00e9co pour des concerts de jazz, de musique traditionnelle, de musique classique et contemporaine, mais c\u2019est \u00e9galement une place de choix pour le cin\u00e9ma et la vid\u00e9o.\r\nChaque ann\u00e9e, Flagey accueille les plus grands artistes d\u2019ici et d\u2019ailleurs mais est \u00e9galement une vitrine pour les jeunes talents (belges). \r\nGr\u00e2ce \u00e0 l'appui structurel des diff\u00e9rentes communaut\u00e9s belges, et par les qualit\u00e9s acoustiques exceptionnelles de ses salles, sa programmation vari\u00e9e ainsi que ses festivals telles que les Flagey Piano Days et le Brussels Jazz Festival, Flagey est devenu l'une des plus importantes maisons de la culture en Belgique et \u00e0 l'\u00e9tranger.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Flagey","address_street_name":"Heilig-Kruisplein","address_street_number":null,"address_street_box":null,"email":"info@flagey.be","website":"http:\/\/www.flagey.be","phone_contact":"+32 2 641 10 20","phone_booking":"+32 2 641 10 20","address_zip":"1050","address_city":"Elsene","address_line1":"Heilig-Kruisplein","address_line2":"1050 Elsene","description_web":"Gelegen aan het Flageyplein naast de vijvers van Elsene, is dit voormalige nationale radio- en televisiegebouw een plek waar  verschillende artistieke disciplines elkaar kruisen. Cultuurliefhebbers van alle leeftijden kunnen terecht in dit prachtige art deco gebouw voor zowel jazz, wereldmuziek, als klassieke en hedendaagse muziek, maar ook voor films en videoprojecten. \r\nFlagey ontvangt jaarlijks de allergrootste artiesten uit binnen- en buitenland en wil ook kansen bieden aan jong (Belgisch) talent. \r\nDankzij de structurele steun van de verschillende Belgische gemeenschappen, door de uitzonderlijke akoestische kwaliteiten van de zalen, de gevarieerde programmatie, en door eigen festivals zoals de Flagey Piano Days en het Brussels Jazz Festival, is Flagey uitgegroeid tot \u00e9\u00e9n van de belangrijkste cultuurhuizen in binnen- en buitenland.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Flagey","address_street_name":"place Sainte-Croix","address_street_number":null,"address_street_box":null,"email":"info@flagey.be","website":"http:\/\/www.flagey.be","phone_contact":"+32 2 641 10 20","phone_booking":"+32 2 641 10 20","address_zip":"1050","address_city":"Ixelles","address_line1":"place Sainte-Croix","address_line2":"1050 Ixelles","description_web":"Located on the edge of the Flagey square and next to the Ixelles ponds, this building \u2013 formerly the headquarters of the national radio and television institution \u2013 has now more than ever become a crossroad where artistic disciplines can meet and exchange ideas. Culture lovers of all ages are welcome in this beautiful Art Deco building, to take part in various events which range from concerts of jazz, world, classical and contemporary music, to film events and video projects. Each year, Flagey has the honor of receiving some of the world\u2019s most prominent artists, yet it still insists on offering opportunities to younger (Belgian) talents.\r\n\r\nThanks to the structural support of the different Belgian communities, and because of the exceptional acoustic qualities of the concert studios, the diversity of programming and events such as the Flagey Piano Days and the Brussels Jazz Festival, Flagey is today one of the leading culture houses on the national as well as the international scene.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Flagey","address_street_name":"Place Sainte-Croix","address_street_number":null,"address_street_box":null,"email":"info@flagey.be","website":"http:\/\/www.flagey.be","phone_contact":"+32 2 641 10 20","phone_booking":"+32 2 641 10 20","address_zip":"1050","address_city":"Ixelles","address_line1":"Place Sainte-Croix","address_line2":"1050 Ixelles","description_web":"Das ehemalige Rundfunkgeb\u00e4ude mit Blick auf den Place Flagey und die Teiche von Ixelles ist heute mehr denn je ein Ort der Begegnungen f\u00fcr unterschiedliche k\u00fcnstlerische Disziplinen. Das kulturelle Angebot ist ebenso beeindruckend wie das Art-d\u00e9co-Geb\u00e4ude selbst: Jazz, traditionelle Musik, klassische und zeitgen\u00f6ssische Musik, Film- und Videokunst\u2026 Dank der hervorragenden Akustik haben verschiedene Festivals den Konzertsaal des Flagey zu ihrer B\u00fchne auserkoren, darunter die Flagey Piano Days und das Brussels Jazz Festival. Doch auch junge (belgische) Talente bekommen hier die Gelegenheit, ihr Talent unter Beweis zu stellen.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Flagey","address_street_name":"place Sainte-Croix","address_street_number":null,"address_street_box":null,"email":"info@flagey.be","website":"http:\/\/www.flagey.be","phone_contact":"+32 2 641 10 20","phone_booking":"+32 2 641 10 20","address_zip":"1050","address_city":"Ixelles","address_line1":"place Sainte-Croix","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Flagey","address_street_name":"Place Sainte-Croix","address_street_number":null,"address_street_box":null,"email":"info@flagey.be","website":"http:\/\/www.flagey.be","phone_contact":"+32 2 641 10 20","phone_booking":"+32 2 641 10 20","address_zip":"1050","address_city":"Ixelles","address_line1":"Place Sainte-Croix","address_line2":"1050 Ixelles","description_web":"Situado al borde de la plaza Flagey y cerca de los estanques de Ixelles, este edificio \u2013 anteriormente la sede central de la radio nacional y la televisi\u00f3n p\u00fablica \u2013 ahora m\u00e1s que nunca se ha convertido en un cruce donde las disciplinas art\u00edsticas pueden encontrarse y compartir ideas. Los amantes de la cultura de todas las edades son bienvenidos a este hermoso edificio Art D\u00e9co, para tomar parte en diversos eventos que var\u00edan desde conciertos de jazz, m\u00fasica universal, cl\u00e1sica y m\u00fasica contempor\u00e1nea hasta eventos cinematogr\u00e1ficos y proyecciones de video. Cada a\u00f1o, Flagey tiene el honor de recibir a algunos de los artistas m\u00e1s destacados del mundo, pero a\u00fan as\u00ed insiste en ofrecer una oportunidad a j\u00f3venes talentos.\r\n\r\nGracias al apoyo estructural de las diferentes comunidades belgas y a las excepcionales cualidades ac\u00fasticas de las salas de conciertos, la diversidad de programas y eventos tales como Flagey Piano Days y el Brussels Jazz Festival, Flagey es hoy una de las casas l\u00edderes en cultura en el plano nacional, as\u00ed como en el internacional.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Flagey","address_street_name":"Place Sainte-Croix","address_street_number":null,"address_street_box":null,"email":"info@flagey.be","website":"http:\/\/www.flagey.be","phone_contact":"+32 2 641 10 20","phone_booking":"+32 2 641 10 20","address_zip":"1050","address_city":"Ixelles","address_line1":"Place Sainte-Croix","address_line2":"1050 Ixelles","description_web":"","description_print"