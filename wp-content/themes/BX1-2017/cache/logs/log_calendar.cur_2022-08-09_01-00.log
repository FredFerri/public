les de 1000BXL en Transition","boxoffice_url":null,"website":"http:\/\/1000bxlentransition.be\/all-project-list\/marche-gratuit\/","email":"1000bxlentransition@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/529848.html"},"nl":{"name":"Gratis markt 1000Bxl en Transition","shortdescr":"Een GRATIS MARKT is een markt waar alles gratis is!","longdescr":"Een GRATIS MARKT is een markt waar alles gratis is!\r\nElke 4de zaterdag van de maand van 14u. tot 16u. in het Steenkoolkaaipark (in de Sint-Katelijnewijk). Kom met wat je niet meer nodig hebt of kom met lege handen. Neem mee wat je kan gebruiken. Het is niet nodig om te geven om te kunnen krijgen.","performers":"De fantastische vrijwilligers van 1000BXL en Transition","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/529848.html"},"en":{"name":"March\u00e9 Gratuit 1000Bxl en Transition","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/529848.html"},"de":{"name":"March\u00e9 Gratuit 1000Bxl en Transition - 2022","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/529848.html"},"it":{"name":"March\u00e9 Gratuit 1000Bxl en Transition - 2022","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/529848.html"},"sp":{"name":"March\u00e9 Gratuit 1000Bxl en Transition - 2022","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"