],"pt":[null],"en":["Accessible"],"it":["Accessibile"],"cn":[null],"fr":["Accessible"],"sp":["Habilitado"],"nl":["Toegankelijk"]}},"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[],"opening":{"day":"2023-12-09","end":"21:00:00","start":"18:00:00","timestamp":"2023-12-09T18:00:00"}},{"id":561722,"date_start":"2023-10-27","date_end":"2024-02-18","date_next":"2024-01-20","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-01-20T01:03:51+01:00","published_at":"2023-07-11T11:50:14+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":281722,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.259086063078286,"languages":{"spoken":["en","fr","nl"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[46,36],"translations":{"de":["Multidisziplin\u00e4r","Museen & Kunstzentren"],"pt":[null,null],"en":["Multidisciplinary","Museums and art centers"],"it":["Multidisciplinare","Musei e centri artistici"],"cn":[null,null],"fr":["Pluridisciplinaire","Mus\u00e9es et art centers"],"sp":["Multidisciplinar","Museos y centros de arte"],"nl":["Multidisciplinair","Musea en kunstcentra"]}}},"translations":{"de":{"name":"Europalia G\u00e9orgie : une histoire de rencontres","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.artandhistory.museum","email":"info@mrah.be","phone_contact":null,"phone_booking":"+32 2 741 73 02","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.561722"},"pt":{"name":"Europalia G\u00e9orgie : une histoire de rencontres","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.artandhistory.museum","email":"info@mrah.be","phone_contact":null,"phone_booking":"+32 2 741 73 02","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.561722"},"en":{"name":"Europalia Georgia : A Story of Encounters","shortdescr":"This autumn, europalia will dedicate its festival to Georgia. From 4 October 2023, a comprehensive programme, teeming with exhibitions, performances, concerts, films, dance shows, theatre pieces and literary encounters, will roll-out across Belgium","longdescr":"This autumn, europalia will dedicate its festival to Georgia. From 4 October 2023, a comprehensive programme, teeming with exhibitions, performances, concerts, films, dance shows, theatre pieces and literary encounters, will roll-out across Belgium. In this context, the Art & History Museum will host a heritage exhibition focussing on the culture, history, and art of Georgia since the Neolithic period.\r\n\r\nAt the crossroads of East and West, traversed by trade routes linked to the Silk Roads, and always the object of ambition of the great powers surrounding it, Georgia has been a place of encounters and exchanges from which it has drawn cultural nourishment. The result is a heritage of unparalleled richness.\r\n\r\nWine, fire & myths\r\nWine has been produced in Georgia for at least 8000 years. It accompanies a ritualised art of dining with refined cuisine, an integral part of the country\u2019s heritage. As the oldest cultural asset in Georgia, wine will be the starting point for the exhibition. Metalwork \u2013 gold and bronze \u2013 will also pay a central role. From the Bronze Age onwards, Georgian metalworkers produced pieces of unprecedented delicacy and sumptuousness. The myth of the Golden Fleece has its roots in Georgia: the region was known to the Greeks for its wealth in gold.\r\n\r\nAfter the Greeks, who established trading posts there, numerous other powers would meet and confront each other on this small, coveted territory of the Caucasus: Romans, Persians, Arabs, Byzantines, Mongols, and Ottomans contributed to a unique intermingling of cultures, but also sowed destruction in their wake. A Christian country since the 4th century, Georgia struggled to assert itself in the midst of the great powers around it. It succeeded brilliantly between the 11th and 13th centuries, the golden age of Georgian unification, which shone economically and culturally throughout the Middle East under the reign of its emblematic sovereign, Queen Tamar.\r\n ","performers":"Exhibition curators: Prof. Bernard Coulie & Prof. Nino Simonishvili\r\nCo-curator: Marie-Eve Tesch","boxoffice_url":null,"website":"https:\/\/www.artandhistory.museum","email":"info@mrah.be","phone_contact":null,"phone_booking":"+32 2 741 73 02","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.561722"},"it":{"name":"Europalia G\u00e9orgie : une histoire de rencontres","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.artandhistory.museum","email":"info@mrah.be","phone_contact":null,"phone_booking":"+32 2 741 73 02","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.561722"},"cn":{"name":"Europalia G\u00e9orgie : une histoire de rencontres","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.artandhistory.museum","email":"info@mrah.be","phone_contact":null,"phone_booking":"+32 2 741 73 02","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.561722"},"fr":{"name":"Europalia G\u00e9orgie : une histoire de rencontres","shortdescr":"\u00c0 l\u2019automne prochain, europalia consacrera son festival \u00e0 la G\u00e9orgie. \u00c0 partir du 4 octobre 2023, un programme foisonnant se d\u00e9ploiera dans toute la Belgique, avec \u00e0 l\u2019affiche des expositions, performances, concerts, films, spectacles de danse, pi\u00e8ces de th\u00e9\u00e2tre et rencontres litt\u00e9raires. ","longdescr":"\u00c0 l\u2019automne prochain, europalia consacrera son festival \u00e0 la G\u00e9orgie. \u00c0 partir du 4 octobre 2023, un programme foisonnant se d\u00e9ploiera dans toute la Belgique, avec \u00e0 l\u2019affiche des expositions, performances, concerts, films, spectacles de danse, pi\u00e8ces de th\u00e9\u00e2tre et rencontres litt\u00e9raires. Le Mus\u00e9e Art & Histoire accueillera dans ce contexte une exposition patrimoniale qui se penchera sur la culture, l'histoire et l\u2019art de la G\u00e9orgie depuis le n\u00e9olithique.\r\n\r\n\u00c0 la charni\u00e8re entre Orient et Occident, travers\u00e9e par des voies commerciales reli\u00e9es aux routes de la soie et objet des ambitions des grandes puissances qui l\u2019ont de tout temps entour\u00e9e, la G\u00e9orgie a \u00e9t\u00e9 un lieu de rencontres et d\u2019\u00e9changes dont elle a nourri sa culture. En r\u00e9sulte un patrimoine d\u2019une richesse inou\u00efe.\r\n\r\nVin, feu & mythes\r\nOn produit du vin en G\u00e9orgie depuis au moins 8000 ans. Il accompagne un art de la table ritualis\u00e9, \u00e0 la cuisine raffin\u00e9e, qui fait partie \u00e0 part enti\u00e8re du patrimoine. Bien culturel le plus ancien de G\u00e9orgie, il servira de point de d\u00e9part \u00e0 l\u2019exposition. Le travail du m\u00e9tal - or et bronze - occupera \u00e9galement une place cruciale dans le parcours. D\u00e8s l\u2019\u00e2ge du bronze, on d\u00e9veloppe sur les terres g\u00e9orgiennes des pi\u00e8ces d\u2019orf\u00e8vrerie d\u2019une d\u00e9licatesse et d\u2019une somptuosit\u00e9 inou\u00efes. C\u2019est d\u2019ailleurs en G\u00e9orgie que le mythe de la Toison d\u2019Or trouve ses racines : la r\u00e9gion \u00e9tait connue des Grecs pour sa grande richesse en or.\r\n\r\nApr\u00e8s les Grecs, qui y install\u00e8rent des comptoirs commerciaux, de nombreuses puissances se croiseront et s\u2019affronteront sur ce petit territoire tant convoit\u00e9 du Caucase : Romains, Perses, Arabes, Byzantins, Mongols et Ottomans contribueront au m\u00e9tissage si particulier de la culture, mais s\u00e8meront parfois aussi la destruction sur leur passage. Chr\u00e9tienne depuis le 4e si\u00e8cle, la G\u00e9orgie a lutt\u00e9 pour s\u2019affirmer au milieu des grandes puissances qui l\u2019entouraient. Elle y parviendra brillamment entre le 11e et le 13e si\u00e8cle, p\u00e9riode de l\u2019\u00e2ge d\u2019or de la G\u00e9orgie unifi\u00e9e, qui rayonne alors \u00e9conomiquement et culturellement dans tout le Moyen-Orient, sous le r\u00e8gne de son embl\u00e9matique Reine Tamar.","performers":"Commissaires de l\u2019exposition : Prof. Bernard Coulie & Prof. Nino Simonishvili\r\nCo-curatrice : Marie-Eve Tesch","boxoffice_url":null,"website":"https:\/\/www.artandhistory.museum","email":"info@mrah.be","phone_contact":null,"phone_booking":"+32 2 741 73 02","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.561722"},"sp":{"name":"Europalia G\u00e9orgie : une histoire de rencontres","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.artandhistory.museum","email":"info@mrah.be","phone_contact":null,"phone_booking":"+32 2 741 73 02","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.561722"},"nl":{"name":"Europalia Georgi\u00eb: een verhaal van ontmoetingen","shortdescr":"Dit najaar wijdt europalia een kunstenfestival aan Georgi\u00eb. Vanaf 4 oktober 2023 presenteert Europalia in heel Belgi\u00eb een rijkgevuld programma met tentoonstellingen, performances, concerten, film-, dans- en theatervoorstellingen en literaire ontmoetingen. ","longdescr":"Dit najaar wijdt europalia een kunstenfestival aan Georgi\u00eb. Vanaf 4 oktober 2023 presenteert Europalia in heel Belgi\u00eb een rijkgevuld programma met tentoonstellingen, performances, concerten, film-, dans- en theatervoorstellingen en literaire ontmoetingen. In deze context verwelkomt het Museum Kunst & Geschiedenis een erfgoedtentoonstelling over de kunst, cultuur en geschiedenis van Georgi\u00eb beginnende met het neolithicum.\r\n\r\nGesitueerd langs handelswegen die verbonden waren met de Zijderoute en omringd door ambitieuze grootmachten met expansiedrang, was Georgi\u00eb als verbindingspunt tussen Oost en West een plek voor ontmoetingen en uitwisselingen. Deze interacties be\u00efnvloedden het culturele landschap. Het resultaat is een erfgoed van ongekende rijkdom.\r\n\r\nWijn, vuur & mythes\r\nAl minstens 8000 jaar wordt wijn in Georgi\u00eb geproduceerd. De wijntraditie vloeit samen met een geritualiseerde eetcultuur, gekenmerkt door een verfijnde keuken, die integraal deel uitmaakt van het erfgoed. Wijn is het oudste cultuurgoed van Georgi\u00eb en dient als uitgangspunt van de tentoonstelling. De metallurgie \u2013 goud en brons \u2013 speelt eveneens een cruciale rol in de tentoonstelling. Vanaf de bronstijd werd verfijnde en weelderige edelsmeedkunst op het grondgebied van Georgi\u00eb vervaardigd. Het is bovendien in Georgi\u00eb dat de mythe van het Gulden Vlies zijn oorsprong vindt: de regio was bij de Grieken gekend om zijn grote rijkdom aan goud.\r\n\r\nNa de Grieken, die er handelsposten vestigden, kruisten en confronteerden vele mogendheden elkaar op dit kleine maar begeerde gebied in de Kaukasus: Romeinen, Perzen, Arabieren, Byzantijnen, Mongolen en Ottomanen leverden een bijdrage aan de bijzondere smeltkroes van culturen maar lieten soms ook een pad van vernieling achter. Georgi\u00eb, een christelijke natie sinds de 4e eeuw, worstelde om zich als land te vestigen tussen de omringende grootmachten. Het slaagde er glansrijk in tussen de 11e en 13e eeuw, de gouden eeuw van het verenigd Georgi\u00eb, toen het land een culturele en economische bloei kende en onder het bewind van de emblematische koningin Tamar invloed won in het hele Midden-Oosten.\r\n ","performers":"Curatoren van de tentoonstelling: Prof. Bernard Coulie & Prof. Nino Simonishvili\r\nCo-curator: Marie-Eve Tesch","boxoffice_url":null,"website":"https:\/\/www.artandhistory.museum","email":"info@kmkg.be","phone_contact":null,"phone_booking":"+32 2 741 73 02","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.561722"}},"place":{"id":61,"translations":{"de":{"name":"Mus\u00e9e Art & Histoire (MRAH)","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Bruxelles","description_web":"Das Cinquantenaire-Museum, gelegen im Br\u00fcsseler Jubelpark, ist Teil der K\u00f6niglichen Museen f\u00fcr Kunst und Geschichte und bietet einen umfassenden und vielseitigen \u00dcberblick \u00fcber die Geschichte von den Hochkulturen der Antike bis hin zu den Kunststr\u00f6mungen der Gegenwart.\r\n\r\nAntike Sammlungen: \r\nDie antiken Sammlungen befassen sich mit den untergegangenen Hochkulturen von \u00c4gypten (Neuheit: das Grabmal von Nakht), Mesopotamien, Griechenland und Rom. Gezeigt werden au\u00dferdem die gro\u00dfen Kunststr\u00f6mungen Europas vom 10. Jahrhundert bis heute. Wandteppiche, Altaraufs\u00e4tze, Spitze, Goldschmiedekunst und Porzellan geh\u00f6ren zu den kostbaren H\u00f6hepunkten der Ausstellung.\r\n\r\nVon Mikronesien bis Amerika: \r\nDie nicht-europ\u00e4ischen Werke laden ihrerseits auf eine Reise ein: nach Mikronesien, Polynesien, Indien, S\u00fcdostasien, China und ins pr\u00e4kolumbische Amerika. In den eindrucksvollen Arch\u00e4ologie-S\u00e4len wird der Geschichte der Region von der Vorgeschichte bis zur Epoche der Merowinger neues Leben eingehaucht.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Museu de Arte e Hist\u00f3ria (MRAH)","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Bruxelles","description_web":"Da arqueologia nacional \u00e0s artes decorativas europeias, passando pela antiguidade cl\u00e1ssica e pelas civiliza\u00e7\u00f5es n\u00e3o europeias, embarque numa fascinante viagem atrav\u00e9s da arte e da hist\u00f3ria num edif\u00edcio magn\u00edfico criado por L\u00e9opold II no parque do Cinquenten\u00e1rio em Bruxelas.\r\n\r\n-  Museu do Cinquenten\u00e1rio muda de pele e torna-se o Museu de Arte e Hist\u00f3ria!\r\n-  Museu do Cinquenten\u00e1rio desenvolveu um trabalho de reflex\u00e3o sobre a sua imagem. Este resultou numa campanha de reorganiza\u00e7\u00e3o global da institui\u00e7\u00e3o. Come\u00e7ou assim uma reconquista museogr\u00e1fica: a decis\u00e3o de organizar exposi\u00e7\u00f5es tempor\u00e1rias baseadas nas pr\u00f3prias cole\u00e7\u00f5es do museu e de renovar progressivamente as salas permanentes, come\u00e7ando pelo armaz\u00e9m Wolfers, que foi a primeira etapa de uma s\u00e9rie de outras renova\u00e7\u00f5es (salas Egito, salas s\u00e9culos XIX e XX, maqueta de Roma\u2026) que atingem rapidamente a sua velocidade de cruzeiro. O\r\n- Museu de Arte e Hist\u00f3ria pertence aos Museus Reais de Arte e da Hist\u00f3ria, que englobam, para al\u00e9m deste, o MIM (Museu dos Instrumentos Musicais), a Porta de Hal e os Museus do Extremo Oriente, atualmente encerrados.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Art & History Museum (RMAH)","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Bruxelles","description_web":"Embark on a fascinating journey through art and history! Come and stroll among the prehistoric flints and Egyptian mummies, walk between the ancient glasses and stand back to contemplate the impressive medieval tapestries. Immerse yourself in the oriental world as you pass Asian Buddhas and travel to the other side of the world to see a gigantic statue from Easter Island. You still have to admire the magnificent collection of Belgian Art Nouveau...\r\n\r\nThe Art & History Museum is part of the Royal Museums of Art and History (RMAH) that also cover the Musical Instruments Museum (MIM), Halle Gate and the Museums of the Far East (currently closed for renovation).","description_print":"The Cinquantenaire Museum is the headquarters of the Royal Museums of Art and History. It was erected at the end of the nineteenth century and is one of the most extensive museums in Belgium. The collections are divided according to four main themes: 1) National Archaeology; 2) Antiquity; 3) European Decorative Art; 4) Non-European Civilizations.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Museo Arte & Historia","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Bruxelles","description_web":"Situato nel cuore del complesso del Cinquantenario, il Mus\u00e9e du Cinquantenaire vi invita a viaggiatore attraverso i continenti dalla Preistoria al XX secolo. \r\n\r\n\r\nLe sue ricche collezioni sono suddivise in quattro grandi sezioni :\r\n\r\n- L'Antichit\u00e0 dove sono presentate le grandi civilt\u00e0 scomparse dell'Egitto, della Mesopotamia, della Grecia e di Roma.\r\n- Le Arti decorative europee dove scoprire le correnti artistiche dal X secolo ai giorni nostri.\r\n- Le Civilt\u00e0 non europee che invitano al viaggio: India, Sudest asiatico, Cina, America precolombiana.\r\n- L'archeologia nazionale per rivivere il passato delle nostre regioni, dalla Preistoria al periodo merovingio.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Mus\u00e9e Art & Histoire (MRAH)","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Mus\u00e9e Art & Histoire (MRAH)","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Bruxelles","description_web":"Embarquez pour un fascinant voyage \u00e0 travers l'art et l'histoire. Venez fl\u00e2ner parmi les momies \u00e9gyptiennes et les silex pr\u00e9historiques, vous promener entre les verres anciens et prendre du recul pour mieux contempler d'impressionnantes tapisseries m\u00e9di\u00e9vales. Venez vous immerger dans le monde oriental en croisant des Bouddhas d'Asie et voyager jusqu'\u00e0 l'autre bout de la terre pour apercevoir une gigantesque statue de l'\u00eele de P\u00e2ques. La magnifique collection d'Art Nouveau vous attend au bout du voyage.\r\nLe Mus\u00e9e Art & Histoire fait partie des Mus\u00e9es royaux d\u2019Art et d\u2019Histoire, appellation qui chapeaute, outre le Mus\u00e9e Art & Histoire, le mim (Mus\u00e9e des Instruments de Musique), la Porte de Hal et les Mus\u00e9es d\u2019Extr\u00eame-Orient actuellement ferm\u00e9s.\r\n\r\n\r\nLe Mus\u00e9e Art & Histoire fait partie des Mus\u00e9es royaux d\u2019Art et d\u2019Histoire, appellation qui chapeaute, outre le Mus\u00e9e Art & Histoire, le mim (Mus\u00e9e des Instruments de Musique), la Porte de Hal et les Mus\u00e9es d\u2019Extr\u00eame-Orient actuellement ferm\u00e9s. ","description_print":"Le Mus\u00e9e du Cinquantenaire illustre les activit\u00e9s humaines et artistiques des cinq continents \u2013 hormis l\u2019Afrique noire \u2013, de la Pr\u00e9histoire \u00e0 nos jours. Les collections remplissent quatre b\u00e2timents et sont regroup\u00e9es en quatre d\u00e9partements: l\u2019Antiquit\u00e9, les civilisations extra-europ\u00e9ennes, l\u2019arch\u00e9ologie nationale et les arts d\u00e9coratifs europ\u00e9ens.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Museo de Arte e Historia","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Bruxelles","description_web":"Ad\u00e9ntrate en este edificio hist\u00f3rico, uno de los mayores museos de B\u00e9lgica erigido por el anterior rey belga Leopoldo II. Descubre una gran cantidad de objetos desde la prehistoria hasta la antig\u00fcedad y de las artes aplicadas europeas hasta una amplia colecci\u00f3n de arte no europea. Explora todo, incluyendo las interesantes exposiciones temporales, conferencias y otras actividades. Desafortunadamente, la p\u00e1gina web no es tan amplia como para mostrar toda nuestra colecci\u00f3n, compuesta por miles de tesoros del arte y objetos hist\u00f3ricos. Sin embargo, esperamos que nos visites y disfrutes descubriendo o redescubriendo el inmenso patrimonio que gestionamos y exhibimos. De hecho, para nosotros el arte y la historia no son muerte y temas pasados, si no una viva y constante fuente de inspiraci\u00f3n y diversi\u00f3n.\r\n\r\nEl Museo de Arte e Historia es parte de los Museos Reales de Arte e Historia(MRAH), que incluye el Museo de Instrumentos Musicales(MIM), la Puerta de Hal y los Museos del Lejano Oriente(recientemente cerrado por renovaciones).\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Museum Kunst & Geschiedenis (KMKG)","address_street_name":"Jubelpark","address_street_number":"10","address_street_box":null,"email":"info@kmkg.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Jubelpark, 10","address_line2":"1000 Bruxelles","description_web":"Maak een wereldreis door de geschiedenis! Wandel van prehistorische vuistbijlen naar Egyptische mummies. Snuistert tussen betoverende glas en zet een stap achteruit om de indrukwekkende Brusselse wandtapijten te bekijken. Ga de oosterse toer op tussen de Aziatische boeddha\u2019s en steek de Atlantische Oceaan over om Kuifjes \u2018beeldje met het gebroken oor\u2019. En dan is er nog de mooie collectie van Belgische art nouveau\u2026 U komt ogen en oren te kort!\r\n\r\nHet Museum Kunst & Geschiedenis maakt deel uit van de Koninklijke Musea voor Kunst en Geschiedenis (KMKG) die ook het Muziekinstrumentenmuseum (MIM), de Hallepoort en de Musea van het Verre Oosten (gesloten voor renovatie) bundelen.","description_print":"Het Jubelparkmuseum kan bogen op een imposante collectie kunstschatten en archeologische vondsten afkomstig uit de vijf continenten \u2013 met uitzondering van Zwart-Afrika \u2013 van de prehistorie tot op heden. De verzamelingen vullen vier gebouwen en zijn ingedeeld in evenveel departementen: Oudheid (het Nabije Oosten, Egypte, Griekenland, Rome en Byzantium), Niet-Europese Beschavingen (Islam, Azi\u00eb, Polynesi\u00eb & Micronesi\u00eb en Amerika), Nationale Archeologie en Europese Sierkunsten.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[9],"translations":{"de":["Europ\u00e4isches Viertel"],"pt":[null],"en":["European Quarter"],"it":["Quartiere europeo"],"cn":[null],"fr":["Quartier europ\u00e9en"],"sp":["Barrio Europeo"],"nl":["Europese wijk"]}},"zones":{"list":[22],"translations":{"de":["Osten"],"pt":[null],"en":["East"],"it":["Est"],"cn":[null],"fr":["Est"],"sp":["Este"],"nl":["Oost"]}},"neca":null,"facebook_id":null,"backoffice_id":12,"location":{"lat":50.83935087,"lon":4.3917188},"region":"brussels","last_updated_at":"2023-08-14T16:23:18+02:00","published_at":"2013-10-19T01:13:13+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":61,"translations":{"de":{"name":"Mus\u00e9e Art & Histoire (MRAH)","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Bruxelles","description_web":"Das Cinquantenaire-Museum, gelegen im Br\u00fcsseler Jubelpark, ist Teil der K\u00f6niglichen Museen f\u00fcr Kunst und Geschichte und bietet einen umfassenden und vielseitigen \u00dcberblick \u00fcber die Geschichte von den Hochkulturen der Antike bis hin zu den Kunststr\u00f6mungen der Gegenwart.\r\n\r\nAntike Sammlungen: \r\nDie antiken Sammlungen befassen sich mit den untergegangenen Hochkulturen von \u00c4gypten (Neuheit: das Grabmal von Nakht), Mesopotamien, Griechenland und Rom. Gezeigt werden au\u00dferdem die gro\u00dfen Kunststr\u00f6mungen Europas vom 10. Jahrhundert bis heute. Wandteppiche, Altaraufs\u00e4tze, Spitze, Goldschmiedekunst und Porzellan geh\u00f6ren zu den kostbaren H\u00f6hepunkten der Ausstellung.\r\n\r\nVon Mikronesien bis Amerika: \r\nDie nicht-europ\u00e4ischen Werke laden ihrerseits auf eine Reise ein: nach Mikronesien, Polynesien, Indien, S\u00fcdostasien, China und ins pr\u00e4kolumbische Amerika. In den eindrucksvollen Arch\u00e4ologie-S\u00e4len wird der Geschichte der Region von der Vorgeschichte bis zur Epoche der Merowinger neues Leben eingehaucht.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Museu de Arte e Hist\u00f3ria (MRAH)","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Bruxelles","description_web":"Da arqueologia nacional \u00e0s artes decorativas europeias, passando pela antiguidade cl\u00e1ssica e pelas civiliza\u00e7\u00f5es n\u00e3o europeias, embarque numa fascinante viagem atrav\u00e9s da arte e da hist\u00f3ria num edif\u00edcio magn\u00edfico criado por L\u00e9opold II no parque do Cinquenten\u00e1rio em Bruxelas.\r\n\r\n-  Museu do Cinquenten\u00e1rio muda de pele e torna-se o Museu de Arte e Hist\u00f3ria!\r\n-  Museu do Cinquenten\u00e1rio desenvolveu um trabalho de reflex\u00e3o sobre a sua imagem. Este resultou numa campanha de reorganiza\u00e7\u00e3o global da institui\u00e7\u00e3o. Come\u00e7ou assim uma reconquista museogr\u00e1fica: a decis\u00e3o de organizar exposi\u00e7\u00f5es tempor\u00e1rias baseadas nas pr\u00f3prias cole\u00e7\u00f5es do museu e de renovar progressivamente as salas permanentes, come\u00e7ando pelo armaz\u00e9m Wolfers, que foi a primeira etapa de uma s\u00e9rie de outras renova\u00e7\u00f5es (salas Egito, salas s\u00e9culos XIX e XX, maqueta de Roma\u2026) que atingem rapidamente a sua velocidade de cruzeiro. O\r\n- Museu de Arte e Hist\u00f3ria pertence aos Museus Reais de Arte e da Hist\u00f3ria, que englobam, para al\u00e9m deste, o MIM (Museu dos Instrumentos Musicais), a Porta de Hal e os Museus do Extremo Oriente, atualmente encerrados.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Art & History Museum (RMAH)","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Bruxelles","description_web":"Embark on a fascinating journey through art and history! Come and stroll among the prehistoric flints and Egyptian mummies, walk between the ancient glasses and stand back to contemplate the impressive medieval tapestries. Immerse yourself in the oriental world as you pass Asian Buddhas and travel to the other side of the world to see a gigantic statue from Easter Island. You still have to admire the magnificent collection of Belgian Art Nouveau...\r\n\r\nThe Art & History Museum is part of the Royal Museums of Art and History (RMAH) that also cover the Musical Instruments Museum (MIM), Halle Gate and the Museums of the Far East (currently closed for renovation).","description_print":"The Cinquantenaire Museum is the headquarters of the Royal Museums of Art and History. It was erected at the end of the nineteenth century and is one of the most extensive museums in Belgium. The collections are divided according to four main themes: 1) National Archaeology; 2) Antiquity; 3) European Decorative Art; 4) Non-European Civilizations.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Museo Arte & Historia","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Bruxelles","description_web":"Situato nel cuore del complesso del Cinquantenario, il Mus\u00e9e du Cinquantenaire vi invita a viaggiatore attraverso i continenti dalla Preistoria al XX secolo. \r\n\r\n\r\nLe sue ricche collezioni sono suddivise in quattro grandi sezioni :\r\n\r\n- L'Antichit\u00e0 dove sono presentate le grandi civilt\u00e0 scomparse dell'Egitto, della Mesopotamia, della Grecia e di Roma.\r\n- Le Arti decorative europee dove scoprire le correnti artistiche dal X secolo ai giorni nostri.\r\n- Le Civilt\u00e0 non europee che invitano al viaggio: India, Sudest asiatico, Cina, America precolombiana.\r\n- L'archeologia nazionale per rivivere il passato delle nostre regioni, dalla Preistoria al periodo merovingio.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Mus\u00e9e Art & Histoire (MRAH)","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Mus\u00e9e Art & Histoire (MRAH)","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Bruxelles","description_web":"Embarquez pour un fascinant voyage \u00e0 travers l'art et l'histoire. Venez fl\u00e2ner parmi les momies \u00e9gyptiennes et les silex pr\u00e9historiques, vous promener entre les verres anciens et prendre du recul pour mieux contempler d'impressionnantes tapisseries m\u00e9di\u00e9vales. Venez vous immerger dans le monde oriental en croisant des Bouddhas d'Asie et voyager jusqu'\u00e0 l'autre bout de la terre pour apercevoir une gigantesque statue de l'\u00eele de P\u00e2ques. La magnifique collection d'Art Nouveau vous attend au bout du voyage.\r\nLe Mus\u00e9e Art & Histoire fait partie des Mus\u00e9es royaux d\u2019Art et d\u2019Histoire, appellation qui chapeaute, outre le Mus\u00e9e Art & Histoire, le mim (Mus\u00e9e des Instruments de Musique), la Porte de Hal et les Mus\u00e9es d\u2019Extr\u00eame-Orient actuellement ferm\u00e9s.\r\n\r\n\r\nLe Mus\u00e9e Art & Histoire fait partie des Mus\u00e9es royaux d\u2019Art et d\u2019Histoire, appellation qui chapeaute, outre le Mus\u00e9e Art & Histoire, le mim (Mus\u00e9e des Instruments de Musique), la Porte de Hal et les Mus\u00e9es d\u2019Extr\u00eame-Orient actuellement ferm\u00e9s. ","description_print":"Le Mus\u00e9e du Cinquantenaire illustre les activit\u00e9s humaines et artistiques des cinq continents \u2013 hormis l\u2019Afrique noire \u2013, de la Pr\u00e9histoire \u00e0 nos jours. Les collections remplissent quatre b\u00e2timents et sont regroup\u00e9es en quatre d\u00e9partements: l\u2019Antiquit\u00e9, les civilisations extra-europ\u00e9ennes, l\u2019arch\u00e9ologie nationale et les arts d\u00e9coratifs europ\u00e9ens.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Museo de Arte e Historia","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Bruxelles","description_web":"Ad\u00e9ntrate en este edificio hist\u00f3rico, uno de los mayores museos de B\u00e9lgica erigido por el anterior rey belga Leopoldo II. Descubre una gran cantidad de objetos desde la prehistoria hasta la antig\u00fcedad y de las artes aplicadas europeas hasta una amplia colecci\u00f3n de arte no europea. Explora todo, incluyendo las interesantes exposiciones temporales, conferencias y otras actividades. Desafortunadamente, la p\u00e1gina web no es tan amplia como para mostrar toda nuestra colecci\u00f3n, compuesta por miles de tesoros del arte y objetos hist\u00f3ricos. Sin embargo, esperamos que nos visites y disfrutes descubriendo o redescubriendo el inmenso patrimonio que gestionamos y exhibimos. De hecho, para nosotros el arte y la historia no son muerte y temas pasados, si no una viva y constante fuente de inspiraci\u00f3n y diversi\u00f3n.\r\n\r\nEl Museo de Arte e Historia es parte de los Museos Reales de Arte e Historia(MRAH), que incluye el Museo de Instrumentos Musicales(MIM), la Puerta de Hal y los Museos del Lejano Oriente(recientemente cerrado por renovaciones).\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Museum Kunst & Geschiedenis (KMKG)","address_street_name":"Jubelpark","address_street_number":"10","address_street_box":null,"email":"info@kmkg.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Jubelpark, 10","address_line2":"1000 Bruxelles","description_web":"Maak een wereldreis door de geschiedenis! Wandel van prehistorische vuistbijlen naar Egyptische mummies. Snuistert tussen betoverende glas en zet een stap achteruit om de indrukwekkende Brusselse wandtapijten te bekijken. Ga de oosterse toer op tussen de Aziatische boeddha\u2019s en steek de Atlantische Oceaan over om Kuifjes \u2018beeldje met het gebroken oor\u2019. En dan is er nog de mooie collectie van Belgische art nouveau\u2026 U komt ogen en oren te kort!\r\n\r\nHet Museum Kunst & Geschiedenis maakt deel uit van de Koninklijke Musea voor Kunst en Geschiedenis (KMKG) die ook het Muziekinstrumentenmuseum (MIM), de Hallepoort en de Musea van het Verre Oosten (gesloten voor renovatie) bundelen.","description_print":"Het Jubelparkmuseum kan bogen op een imposante collectie kunstschatten en archeologische vondsten afkomstig uit de vijf continenten \u2013 met uitzondering van Zwart-Afrika \u2013 van de prehistorie tot op heden. De verzamelingen vullen vier gebouwen en zijn ingedeeld in evenveel departementen: Oudheid (het Nabije Oosten, Egypte, Griekenland, Rome en Byzantium), Niet-Europese Beschavingen (Islam, Azi\u00eb, Polynesi\u00eb & Micronesi\u00eb en Amerika), Nationale Archeologie en Europese Sierkunsten.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":12,"location":{"lat":50.83935087,"lon":4.3917188},"last_updated_at":"2023-08-14T16:23:18+02:00","published_at":"2013-10-19T01:13:13+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"poster","link":"https:\/\/agendabrussels2.imgix.net\/e3e26c43dfbbe4f2f9bd3cfd03127d9d48eae6e8.png","width":2880,"height":796,"ratio":3.62,"oEmbed_height":796,"oEmbed_width":2880,"translations":{"de":{"title":"Europalia G\u00e9orgie : une histoire de rencontres","copyright":null},"pt":{"title":"Europalia G\u00e9orgie : une histoire de rencontres","copyright":null},"en":{"title":"Europalia G\u00e9orgie : une histoire de rencontres","copyright":null},"it":{"title":"Europalia G\u00e9orgie : une histoire de rencontres","copyright":null},"cn":{"title":"Europalia G\u00e9orgie : une histoire de rencontres","copyright":null},"fr":{"title":"Europalia G\u00e9orgie : une histoire de rencontres","copyright":null},"sp":{"title":"Europalia G\u00e9orgie : une histoire de rencontres","copyright":null},"nl":{"title":"Europalia G\u00e9orgie : une histoire de rencontres","copyright":null}}},{"type":"poster","link":"https:\/\/agendabrussels2.imgix.net\/061ce78380906dfc476df99f86c9454ad1a391a8.png","width":2420,"height":792,"ratio":3.06,"oEmbed_height":792,"oEmbed_width":2420,"translations":{"de":{"title":"Europalia G\u00e9orgie : une histoire de rencontres","copyright":null},"pt":{"title":"Europalia G\u00e9orgie : une histoire de rencontres","copyright":null},"en":{"title":"Europalia G\u00e9orgie : une histoire de rencontres","copyright":null},"it":{"title":"Europalia G\u00e9orgie : une histoire de rencontres","copyright":null},"cn":{"title":"Europalia G\u00e9orgie : une histoire de rencontres","copyright":null},"fr":{"title":"Europalia G\u00e9orgie : une histoire de rencontres","copyright":null},"sp":{"title":"Europalia G\u00e9orgie : une histoire de rencontres","copyright":null},"nl":{"title":"Europalia G\u00e9orgie : une histoire de rencontres","copyright":null}}}],"dates":[{"day":"2023-10-27","doors":null,"start":"09:30:00","end":"17:00:00","end_night_li