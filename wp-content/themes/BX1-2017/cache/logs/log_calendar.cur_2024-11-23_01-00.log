century.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.itineraires.be\/","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50008883"},"it":{"name":"Sur les traces d\u2019Egmont et Hornes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.itineraires.be\/","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50008883"},"cn":{"name":"Sur les traces d\u2019Egmont et Hornes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.itineraires.be\/","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50008883"},"fr":{"name":"Sur les traces d\u2019Egmont et Hornes","shortdescr":null,"longdescr":"Lamoral d'Egmont, Philippe de Hornes, deux noms qui fleurent comme une odeur de fronde face \u00e0 un aust\u00e8re joug espagnol en cette seconde moiti\u00e9 du XVI\u00e8me si\u00e8cle. Pour les 450 ans de la d\u00e9capitation de ces deux h\u00e9ros, h\u00e9rauts de la pacification, de la tol\u00e9rance religieuse dans nos r\u00e9gions, nous vous proposons de suivre un parcours o\u00f9 nous rencontrerons leurs compagnons, des symboles de la domination du duc d'Albe, des lieux de cette trag\u00e9die narr\u00e9e par Goethe au XIX\u00e8me.\n","performers":null,"boxoffice_url":null,"website":"https:\/\/www.itineraires.be\/","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50008883"},"sp":{"name":"Sur les traces d\u2019Egmont et Hornes","shortdescr":null,"longdescr":null,"performers":null,"b