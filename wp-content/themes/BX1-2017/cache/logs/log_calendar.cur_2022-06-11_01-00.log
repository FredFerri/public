ags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-06-10T01:35:53+02:00","published_at":"2022-01-27T12:36:12+01:00","backoffice_id":246316,"import_origin":null,"sub_type":"misc","show_in_agenda":true,"ranking":0.23505514316043},{"id":514823,"date_start":"2022-06-08","date_end":"2022-06-11","date_next":"2022-06-10","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre"}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Pueblo","shortdescr":"De l\u2019ironie \u00e0 la farce, de la satire politique \u00e0 la r\u00e9alit\u00e9 crue, Ascanio Celestini et David Murgia nous emm\u00e8nent dans un monde engag\u00e9, peupl\u00e9 de personnages attachants, de violences et de po\u00e9sie. Ce triptyque est propos\u00e9 dans le sens inverse de leur cr\u00e9ation.","longdescr":"Deuxi\u00e8me volet d\u2019une trilogie initi\u00e9e par Laika, Pueblo est l\u2019histoire d\u2019une clocharde qui ne fait pas la manche sur le parking d\u2019un supermarch\u00e9 et d\u2019un gitan de huit ans qui fume, l\u2019histoire d\u2019une tenanci\u00e8re de bar qui gagne sa vie avec les machines \u00e0 sous, d\u2019un manutentionnaire africain qui travaille dans l\u2019entrep\u00f4t et d\u2019une poign\u00e9e d\u2019autres personnes dont on ne conna\u00eet pas le nom. C'est l'histoire des cent mille africains morts au fond de la mer. C\u2019est l\u2019histoire d\u2019une jeune dame caissi\u00e8re au supermarch\u00e9 et de toutes les personnes qu\u2019elle rencontre.\r\nPueblo, c\u2019est l\u2019histoire d\u2019un jour de pluie.\r\n\r\nDans le cadre de cet accueil, nous proposons aussi les spectacles Discours \u00e0 la nation et La\u00efka.\r\n\r\nDur\u00e9e 1h30\u2019\r\n\r\n++ \r\nBord de sc\u00e8ne. Je 09.06 apr\u00e8s spectacle. Avec David Murgia.\r\n\r\nProduction Kukaracha ASBL. Coproduction Th\u00e9\u00e2tre National Wallonie Bruxelles, Mars - Mons-Arts de la Sc\u00e8ne, Festival de Li\u00e8ge, Th\u00e9\u00e2tre de Namur, Th\u00e9\u00e2tre Jean Vilar de Vitry sur Seine, Centre de Production des Paroles Contemporaines\/Festival Mythos, Th\u00e9\u00e2tre Joliette, l'Ancre Th\u00e9\u00e2tre Royal, Th\u00e9\u00e2tre des C\u00e9lestins. Avec le soutien de Wirikuta ASBL.","performers":"Texte et mise en sc\u00e8ne Ascanio Celestini - Avec David Murgia - Musique Philippe Orivel - Traduction et adaptation Patrick Bebi & David Murgia - R\u00e9gie Philippe Kariger - Cr\u00e9ation musicale Gianluca Casadei - Production et diffusion Catherine Hance & Aur\u00e9lie Curti.","boxoffice_url":null,"website":"http:\/\/www.lerideau.brussels\/","email":"billetterie@lerideau.brussels","phone_contact":"+32 2 737 16 00","phone_booking":"+32 2 737 16 01","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/514823.html"},"nl":{"name":"Pueblo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/514823.html"},"en":{"name":"Pueblo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/514823.html"},"de":{"name":"Pueblo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/514823.html"},"it":{"name":"Pueblo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/514823.html"},"sp":{"name":"Pueblo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/514823.html"},"pt":{"name":"Pueblo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/514823.html"},"cn":{"name":"Pueblo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/514823.html"}},"place":{"id":944,"translations":{"fr":{"name":"Le Rideau","address_street_name":"Rue Goffart","address_street_number":"7 A","address_street_box":null,"email":"contact@rideaudebruxelles.be","website":"http:\/\/www.rideaudebruxelles.be","phone_contact":"+32 2 737 16 01","phone_booking":"+32 2 737 16 00","address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Goffart, 7 A","address_line2":"1050 Ixelles","description_web":"Fond\u00e9 le 17 mars 1943 par Claude Etienne, le Rideau de Bruxelles est la compagnie th\u00e9\u00e2trale la plus ancienne de la capitale, et m\u00eame du pays. Subventionn\u00e9 par la F\u00e9d\u00e9ration Wallonie-Bruxelles, n'a jusqu'ici connu que trois directeurs artistiques : son fondateur Claude Etienne jusqu'\u00e0 son d\u00e9c\u00e8s (1992), Jules-Henri Marchant, et depuis octobre 2007, Michael Delaunoy. Le Rideau privil\u00e9gie la cr\u00e9ation contemporaine en r\u00e9v\u00e9lant les \u00e9critures belges et internationales les plus singuli\u00e8res et les nouvelles pratiques sc\u00e9niques. Il se veut aussi lieu de m\u00e9moire active, en particulier \u00e0 travers une exploration renouvel\u00e9e du r\u00e9pertoire belge francophone du XX\u00e8me si\u00e8cle et d'oeuvres internationales fondatrices de la modernit\u00e9 \r\nLe Rideau f\u00eate lors de cette saison 2018\/2019, 75 ans d'audace et pr\u00e9sentera ses spectacles HORS LES MURS dans des th\u00e9\u00e2tres partenaires et amis durant les travaux de r\u00e9novation de sa maison de th\u00e9\u00e2tre situ\u00e9e rue Goffart \u00e0 Ixelles. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Le Rideau","address_street_name":"Goffartstraat","address_street_number":"7 A","address_street_box":null,"email":"contact@rideaudebruxelles.be","website":"http:\/\/www.rideaudebruxelles.be","phone_contact":"+32 2 737 16 01","phone_booking":"+32 2 737 16 00","address_zip":"1050","address_city":"Elsene","address_line1":"Goffartstraat, 7 A","address_line2":"1050 Elsene","description_web":"Gesticht op 17 maart 1943 door Claude Etienne is Le Rideau het oudste theatergezelschap van Brussel. Le Rideau streeft  ernaar een schouwburg te zijn voor hedendaagse - zowel Belgische als buitenlandse - auteurs. Sinds 2007 wordt het geleid door Michael Delaunoy, steeds trouw aan de ontdekkingsgeest dankzij een boeiende programmatie die de relatie tussen het intieme en de wereld onderzoekt. Le Rideau de Bruxelles is aan het werk in verschillende zalen zoals de Po\u00e8me 2, Theatre Marni, Atelier 210, Th\u00e9\u00e2tre National en Petit Varia.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Le Rideau","address_street_name":"Rue Goffart","address_street_number":"7 A","address_street_box":null,"email":"contact@rideaudebruxelles.be","website":"http:\/\/www.rideaudebruxelles.be","phone_contact":"+32 2 737 16 01","phone_booking":"+32 2 737 16 00","address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Goffart, 7 A","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":