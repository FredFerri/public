s_canceled":false,"is_soldout":false,"last_updated_at":"2024-03-18T01:01:30+01:00","published_at":"2023-10-20T10:33:16+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":287498,"facebook_link":null,"import_origin":null,"is_part_of":"Ann\u00e9e Art Nouveau","sub_type":"festival","ranking":0.5,"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"categories":{"main":{"id":118,"translations":{"de":"Festival","pt":null,"en":"Festival","it":"Festival","cn":null,"fr":"Festival","sp":"Festival","nl":"Festival"}},"others":{}},"translations":{"de":{"name":"Brussels Art Nouveau & Art D\u00e9co (BANAD) Festival 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50003590"},"pt":{"name":"Brussels Art Nouveau & Art D\u00e9co (BANAD) Festival 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50003590"},"en":{"name":"BANAD - Brussels Art Nouveau & Art Deco Festival","shortdescr":"The Brussels Art Nouveau & Art Deco (BANAD) Festival is a special event that promotes the Art Nouveau and Art Deco heritage of the Brussels-Capital Region. It takes place every year on the weekends of March. ","longdescr":"The Brussels Art Nouveau & Art Deco (BANAD) Festival is a special event that promotes the Art Nouveau and Art Deco heritage of the Brussels-Capital Region. It takes place every year on the weekends of March. \n\nWhat makes this festival so special are guided tours through Art Nouveau and Art Deco buildings that are normally not open for visitors. A unique opportunity to (re) discover these hidden architectural gems!\n\n\n\n\n\nAs part of the Festival, we also offer other activities that spotlight the Art Nouveau and Art Deco heritage and complement the guided tours: walking tours as well as bike and bus tours; concerts; seminars; shows; activities for families; an antique market; activities for disabled people; and activities for schools...\n\nThe event concept is unique in Europe!","performers":"The BANAD Festival is organised by Explore.Brussels, a network of associations that organise guided tours: ARAU, Arkadia, Brussels Chatterguides and Pro Velo. ","boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/en\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50003590"},"it":{"name":"Brussels Art Nouveau & Art D\u00e9co (BANAD) Festival 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50003590"},"cn":{"name":"Brussels Art Nouveau & Art D\u00e9co (BANAD) Festival 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50003590"},"fr":{"name":"BANAD - Brussels Art Nouveau & Art Deco Festival","shortdescr":"Le Brussels Art Nouveau & Art D\u00e9co (BANAD) Festival est un \u00e9v\u00e9nement exceptionnel mettant en valeur le patrimoine Art nouveau et Art D\u00e9co en R\u00e9gion de Bruxelles-Capitale. Il se tient chaque ann\u00e9e durant uniquement les week-ends de mars.","longdescr":"\u00c9v\u00e9nement annuel de notori\u00e9t\u00e9 internationale se d\u00e9clinant sur trois week-ends, le BANAD Festival est une invitation \u00e0 la d\u00e9couverte de lieux remarquables r\u00e9v\u00e9lant le patrimoine Art nouveau et Art D\u00e9co de la r\u00e9gion bruxelloise. Au programme : des visites d\u2019int\u00e9rieurs habituellement ferm\u00e9s au public, de multiples parcours guid\u00e9s th\u00e9matiques \u00e0 suivre \u00e0 pied ou \u00e0 v\u00e9lo, des conf\u00e9rences originales, des activit\u00e9s inclusives et familiales, et enfin les incontournables Foire d\u2019objets et Salon des restaurateurs & experts. \n \nAu menu des visites d\u2019int\u00e9rieur : les \u00ab Essential \u00bb (ces incontournables qu\u2019il faut au moins avoir vu une fois dans sa vie), les \u00ab Classic \u00bb (dont certaines adresses, comme des \u00e9tablissements publics, scolaires ou des institutions mus\u00e9ales, sont r\u00e9guli\u00e8rement visitables mais pas sous le prisme du patrimoine architectural), les \u00ab New \u00bb (n\u2019ayant encore jamais \u00e9t\u00e9 ouverts au public du BANAD) et enfin les \u00ab Previously New \u00bb (nouveaut\u00e9s des ann\u00e9es pr\u00e9c\u00e9dentes, reprogramm\u00e9es \u00e0 l\u2019attention des visiteurs qui les auraient manqu\u00e9es lors des derni\u00e8res \u00e9ditions du festival).\n \nJamais ouvertes dans le cadre du BANAD, les maisons Roosenboom, Danckaert et Van den Broeck font partie des perles de cette huiti\u00e8me s\u00e9lection. Parmi les Essential et les Classic sont \u00e9galement tr\u00e8s attendus du public, les h\u00f4tels Solvay, Tassel, Otlet, Hallet, Cohn-Donnay, les maisons Saint-Cyr et Cauchie, la villa Empain, le R\u00e9sidence Palace, le Old England, les anciens ateliers du ma\u00eetre-verrier Colpaert, les \u00e9glises Saint-Jean-Baptiste et Saint-Augustin, etc.\n","performers":"Le BANAD Festival est organis\u00e9 par Explore.Brussels et ses associations membres : ARAU, Arkadia, Bruxelles Bavard et Pro Velo.\n","boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50003590"},"sp":{"name":"Brussels Art Nouveau & Art D\u00e9co (BANAD) Festival 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50003590"},"nl":{"name":"BANAD - Brussels Art Nouveau & Art Deco Festival","shortdescr":"Het Brussels Art Nouveau & Art Deco (BANAD) Festival is een uitzonderlijk evenement dat het art nouveau en art Deco erfgoed in het Brussels Hoofdstedelijk Gewest in de kijker plaatst. Het vindt ieder jaar tijdens de weekends van maart plaats. ","longdescr":"Het Brussels Art Nouveau & Art Deco (BANAD) Festival is een uitzonderlijk evenement dat het art nouveau en art Deco erfgoed in het Brussels Hoofdstedelijk Gewest in de kijker plaatst. Het vindt ieder jaar tijdens de weekends van maart plaats. \n\nCentraal tijdens het festival: geleide bezoeken aan art nouveau en art Deco interieurs die gewoonlijk gesloten zijn voor het publiek. Kortom, een unieke kans om deze pareltjes van onze architectuur (opnieuw) te ontdekken!\n\n\n\n\n\nDaarnaast worden er nog andere activiteiten georganiseerd om het art nouveau en art Deco erfgoed te belichten, zoals geleide parcours (buiten), concerten, conferenties, evenementen, gezinsactiviteiten, een beurs met voorwerpen uit dezelfde periode, activiteiten voor personen met een beperkte mobiliteit (PBM) en activiteiten voor scholen...\n\nDit concept is uniek in Europa!","performers":"Het BANAD Festival is een organisatie van Explore.Brussels en zijn netwerk van organisaties: ARAU, Arkadia, Brussel Babbelt en Pro Velo. ","boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/nl\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50003590"}},"place":{"id":245448,"translations":{"de":{"name":"Divers lieux \u00e0 Bruxelles","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Divers lieux \u00e0 Bruxelles","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Divers lieux \u00e0 Bruxelles","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Divers lieux \u00e0 Bruxelles","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Various places in Brussels","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Various places in Brussels","address_line2":"1000 Brussels","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Divers lieux \u00e0 Bruxelles","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Divers lieux \u00e0 Bruxelles","address_line2":"