ermanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen","it":"Visite guidate","sp":"Visitas guiadas","pt":null,"cn":null}},"others":{"list":[104],"translations":{"fr":["Art Nouveau, Art D\u00e9co"],"nl":["Art nouveau, art deco"],"en":["Art Nouveau, Art D\u00e9co"],"de":["Jugendstil, Art d\u00e9co"],"it":["Art Nouveau, Art D\u00e9co"],"sp":["Art nouveau, art d\u00e9co"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"L\u2019Ecole Art D\u00e9co La Roue P21","shortdescr":null,"longdescr":"Cette ann\u00e9e le Service du TOURISME D'ANDERLECHT s\u2019associe au BANAD Festival pour vous proposer la d\u00e9couverte d\u2019un bijoux du style Art d\u00e9co \u00e0 Anderlecht.\r\nExemple d\u2019architecture scolaire de l\u2019entre-deux-guerres, l\u2019\u00c9cole P21 se situe au c\u0153ur dela cit\u00e9-jardin de La Roue.  Les b\u00e2timents et lemobilier fixe ont \u00e9t\u00e9 class\u00e9s en 2008.\r\nLe projet est dessin\u00e9 par l\u2019architecte communal Henri Wildenblanck,  \u00e9galement directeur du Service des Propri\u00e9t\u00e9s Communales d\u2019Anderlecht, en 1937-1939. \r\nOutre les locaux de classe, l\u2019\u00e9cole abrite une salle des f\u00eates (dont la sc\u00e8ne se transforme en salle de gymnastique), une conciergerie, des douches publiques.  Son aspect (int\u00e9rieur et ext\u00e9rieur) se caract\u00e9rise par un style moderniste encore ancr\u00e9 dans les influences de l\u2019Art D\u00e9co.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.banad.brussels\/fr\/visites\/la-roue-p21-2023-fr","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.552258"},"nl":{"name":"Art-decoschool Het Rad P21","shortdescr":null,"longdescr":"Dit jaar bundelt de dienst TOERISME VAN ANDERLECHT haar krachten met het BANAD-festival om u de kans te geven een parel van de art-decostijl in Anderlecht te ontdekken. School P21 is een voorbeeld van schoolarchitectuur uit het interbellum en ligt in het hart van tuinwijk Het Rad.  De gebouwen en het vaste meubilair zijn sinds 2008 beschermd. Het project werd tussen 1937 en 1939 ontwikkeld door gemeentearchitect Henri Wildenblanck, die ook directeur van de dienst Gemeentelijke Eigendommen van Anderlecht was.  \r\nNaast de klaslokalen omvat de school een feestzaal (waarvan het podium werd gebruikt als turnzaal), een conci\u00ebrgewoning en openbare douches. Het aanzicht (interieur en exterieur) wordt gekenmerkt door een modernistische stijl met nog duidelijke invloeden van de art deco.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.banad.brussels\/nl\/bezoeken\/la-roue-p21-2023-nl","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.552258"},"en":{"name":"L\u2019Ecole Art D\u00e9co La Roue P21","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.banad.brussels\/fr\/visites\/la-roue-p21-2023-fr","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.552258"},"de":{"name":"L\u2019Ecole Art D\u00e9co La Roue P21","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.banad.brussels\/fr\/visites\/la-roue-p21-2023-fr","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.552258"},"it":{"name":"L\u2019Ecole Art D\u00e9co La Roue P21","shortdescr":null,"longdescr":nul