nt":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Th\u00e9\u00e2tre de la Parole","address_street_name":"Rue du Rouge-Clo\u00eetre","address_street_number":"7","address_street_box":"D","email":"info@theatredelaparole.be","website":"http:\/\/www.theatredelaparole.be","phone_contact":"+32 2 736 69 50","phone_booking":null,"address_zip":"1160","address_city":"Auderghem","address_line1":"Rue du Rouge-Clo\u00eetre, 7 \/ D","address_line2":"1160 Auderghem","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Th\u00e9\u00e2tre de la Parole","address_street_name":"Rue du Rouge-Clo\u00eetre","address_street_number":"7","address_street_box":"D","email":"info@theatredelaparole.be","website":"http:\/\/www.theatredelaparole.be","phone_contact":"+32 2 736 69 50","phone_booking":null,"address_zip":"1160","address_city":"Auderghem","address_line1":"Rue du Rouge-Clo\u00eetre, 7 \/ D","address_line2":"1160 Auderghem","description_web":"Des actions culturelles de sens, qui permettent la r\u00e9flexion, pour ne plus \u00eatre sujet d\u2019\u00e9tude mais un.e v\u00e9ritable acteur.rice de sa vie.\r\n\r\nEn \u00e9cho \u00e0 sa programmation, le Th\u00e9\u00e2tre de la parole d\u00e9veloppe des actions culturelles engag\u00e9es, cibl\u00e9es, et adapt\u00e9es aux diff\u00e9rents publics.\r\n\r\nElles ont pour objectifs d\u2019inviter les publics \u00e0 d\u00e9couvrir les arts de la parole, et de stimuler les liens interg\u00e9n\u00e9rationnels autour la m\u00e9moire collective.\r\n\r\nLes artistes vont \u00e0 la rencontre des jeunes g\u00e9n\u00e9rations et des adultes autour des questions li\u00e9es \u00e0 la m\u00e9moire, aux savoirs et aux savoir-faire, \u00e0 la parole du quotidien.\r\n\r\nElles prennent la forme d\u2019outils p\u00e9dagogiques en \u00e9ducation permanente, de collectages, d\u2019ateliers et d\u2019animations, de prestations et de rencontres.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Th\u00e9\u00e2tre de la Parole","address_street_name":"Rue du Rouge-Clo\u00eetre","address_street_number":"7","address_street_box":"D","email":"info@theatredelaparole.be","website":"http:\/\/www.theatredelaparole.be","phone_contact":"+32 2 736 69 50","phone_booking":null,"address_zip":"1160","address_city":"Auderghem","address_line1":"Rue du Rouge-Clo\u00eetre, 7 \/ D","address_line2":"1160 Auderghem","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Th\u00e9\u00e2tre de la Parole","address_street_name":"Rue du Rouge-Clo\u00eetre","address_street_number":"7","address_street_box":"D","email":"info@theatredelaparole.be","website":"http:\/\/www.theatredelaparole.be","phone_contact":"+32 2 736 69 50","phone_booking":null,"address_zip":"1160","address_city":"Oudergem","address_line1":"Rue du Rouge-Clo\u00eetre, 7 \/ D","address_line2":"1160 Oudergem","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":32222,"location":{"lat":50.81434148,"lon":4.44283848},"last_updated_at":"2022-04-07T15:39:02+02:00","published_at":"2018-10-04T11:28:46+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/9a1298f0452c85f7072a3f4fe5d74a4ad26805ba.jpeg","width":3024,"height":4032,"ratio":0.75,"oEmbed_height":4032,"oEmbed_width":3024,"translations":{"de":{"title":"La parole comme champ de bataille","copyright":null},"pt":{"title":"La parole comme champ de bataille","copyright":null},"en":{"title":"La parole comme champ de bataille","copyright":null},"it":{"title":"La parole comme champ de bataille","copyright":null},"