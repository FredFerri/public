ays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-03-20T01:02:03+01:00","published_at":"2024-02-06T13:04:11+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":293954,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.3236378653619318,"languages":{"spoken":["fr","en"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[26,24],"translations":{"de":["Skulptur","Kunstgalerien"],"pt":[null,null],"en":["Sculpture","Art Galleries"],"it":["Scultura","Gallerie d'arte"],"cn":[null,null],"fr":["Sculpture","Galeries d'art"],"sp":["Escultura","Galer\u00edas de arte"],"nl":["Beeldhouwkunst","Galeries"]}}},"translations":{"de":{"name":"Jean-Bernard Metais - 'R\u00e9sonance'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.galerielaforestdivonne.com\/fr\/accueil\/","email":"brussels@galerielaforestdivonne.com","phone_contact":"+32 2 544 16 73","phone_booking":"+32 2 544 16 73","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50006923"},"pt":{"name":"Jean-Bernard Metais - 'R\u00e9sonance'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.galerielaforestdivonne.com\/fr\/accueil\/","email":"brussels@galerielaforestdivonne.com","phone_contact":"+32 2 544 16 73","phone_booking":"+32 2 544 16 73","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50006923"},"en":{"name":"Jean-Bernard Metais - 'R\u00e9sonance'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.galerielaforestdivonne.com\/fr\/accueil\/","email":"brussels@galerielaforestdivonne.com","phone_contact":"+32 2 544 16 73","phone_booking":"+32 2 544 16 73","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50006923"},"it":{"name":"Jean-Bernard Metais - 'R\u00e9sonance'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.galerielaforestdivonne.com\/fr\/accueil\/","email":"brussels@galerielaforestdivonne.com","phone_contact":"+32 2 544 16 73","phone_booking":"+32 2 544 16 73","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50006923"},"cn":{"name":"Jean-Bernard Metais - 'R\u00e9sonance'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.galerielaforestdivonne.com\/fr\/accueil\/","email":"brussels@galerielaforestdivonne.com","phone_contact":"+32 2 544 16 73","phone_booking":"+32 2 544 16 73","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50006923"},"fr":{"name":"Jean-Bernard Metais - 'R\u00e9sonance'","shortdescr":"\u00abR\u00e9sonance\u00bb est la quatri\u00e8me exposition de Jean-Bernard M\u00e9tais \u00e0 la Galerie La\u00a0Forest\u00a0Divonne\u00a0Bruxelles. A l\u2019image de son atelier, foisonnant, elle rassemblera des sculptures en m\u00e9tal, des sabliers, des ampoules de verre et des photographies, entre lesquelles se tisse le fil rouge de l\u2019\u0153uvre de M\u00e9tais\u00a0: le mouvement, la lumi\u00e8re et le temps. ","longdescr":"Dans le sillage de ses \u00ab chambres sensorielles \u00bb souvent monumentales, les nouvelles sculptures de Jean-Bernard M\u00e9tais se font ici \u00e0 la fois plus rondes et plus intimes : des sculptures plus petites, souvent modulables, aux lignes courbes, dansantes, \u00e0 travers lesquelles s\u2019active toujours le mouvement cin\u00e9tique des mailles de fer, activ\u00e9 par le spectateur intrigu\u00e9 lorsqu\u2019il se d\u00e9place dans l\u2019espace de l\u2019exposition. Plus famili\u00e8res par leur taille, plus douces par leur forme, elles sont aussi plus lumineuses, M\u00e9tais explorant ici les couleurs vives, du rouge \u00e9clatant au bleu azur et au blanc, en dialogue avec le noir historique qui marquait les cr\u00e9ations pr\u00e9c\u00e9dentes.\n\nLe mouvement est \u00e9galement au c\u0153ur des sabliers, que le spectateur est invit\u00e9 \u00e0 activer \u00e0 leur tour. Toute une s\u00e9rie de nouveaux sabliers \u00ab \u00catre mots \u00bb, dont la forme et le r\u00e9sultat sont \u00e0 la fois un paysage g\u00e9om\u00e9trique et l\u2019empreinte de mots qui constituent la litanie de l\u2019artiste\u00a0:\u00a0AMOUR, IVRESSE, ICI, EPERDUMENT\u2026 Trac\u00e9s par l\u2019\u00e9coulement du sable, ils sont une invitation \u00e0 vivre intens\u00e9ment l\u2019\u00e9motion du temps pr\u00e9sent, toujours mouvant, toujours \u00e9ph\u00e9m\u00e8re, mais toujours \u00e0 recommencer, comme ces sabliers que le visiteur pourra retourner \u00e0 l\u2019envie.\n","performers":"Du 14 mars au 11 mai, la Galerie La Forest Divonne pr\u00e9sente \u00ab R\u00e9sonance \u00bb, une exposition personnelle de Jean-Bernard M\u00e9tais.","boxoffice_url":null,"website":"https:\/\/www.galerielaforestdivonne.com\/fr\/accueil\/","email":"brussels@galerielaforestdivonne.com","phone_contact":"+32 2 544 16 73","phone_booking":"+32 2 544 16 73","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50006923"},"sp":{"name":"Jean-Bernard Metais - 'R\u00e9sonance'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.galerielaforestdivonne.com\/fr\/accueil\/","email":"brussels@galerielaforestdivonne.com","phone_contact":"+32 2 544 16 73","phone_booking":"+32 2 544 16 73","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50006923"},"nl":{"name":"Jean-Bernard Metais - 'R\u00e9sonance'","shortd