e,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{"list":[112],"translations":{"fr":["Insolite"],"nl":["Ongewoon"],"en":["Unusual"]}}},"languages":{"spoken":["fr","en","nl"],"subtitles":[]},"translations":{"fr":{"name":"Dimanche \u00e0 v\u00e9lo - Rouge Clo\u00eetre","shortdescr":"Profitez du r\u00e9veil silencieux de la ville le dimanche matin. D\u00e9couvrez le plaisir du v\u00e9lo \u00e0 Bruxelles et les endroits surprenants de la ville et de sa p\u00e9riph\u00e9rie.","longdescr":"Profitez du r\u00e9veil silencieux de la ville le dimanche matin. Une agr\u00e9able promenade \u00e0 v\u00e9lo, id\u00e9ale pour une petite dose d'exercice et pour rencontrer d'autres Bruxellois \u00e0 v\u00e9lo ! Nous nous rendons \u00e0 v\u00e9lo \u00e0 l'une des plus belles perles de la for\u00eat de Soignes \u00e0 Bruxelles, le Rouge-Clo\u00eetre. Nos guides traceront un parcours agr\u00e9able d'environ 20 km. Vers midi nous arrivons au Rouge-Clo\u00eetre et profitons de l'endroit avec un pique-nique - auberge espagnole. A partir de 13 heures, il est possible de retourner au centre \u00e0 v\u00e9lo avec l'un de nos guides.\r\n\r\nRendez-vous \u00e0 10h00 au Grand Hospice, rue du Grand Hospice 7, 1000 Bruxelles.\r\n\r\nD\u00e9couvrez le programme sur notre site web!\r\nhttps:\/\/cactus.brussels\/fr-brussel-velo\/dimanche-a-velo","performers":null,"boxoffice_url":null,"website":"https:\/\/cactus.brussels\/brussel-velo","email":"info@cactus.brussels","phone_contact":null,"phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/535954.html"},"nl":{"name":"Dimanche \u00e0 v\u00e9lo - Rood Klooster","shortdescr":"Geniet mee van de nog stille ontwakende stad op zondagochtend. Ontdek het fietsen in Brussel en verrassende plekken in de stad en de rand.","longdescr":"Geniet mee van de nog stille ontwakende stad op zondagochtend. Een gezellige fietstocht, ideaal voor een gezonde dosis beweging en ontmoetingen met andere Brusselaars op de fiets! We fietsen naar \u00e9\u00e9n van de mooiste parels van het Zoni\u00ebnwoud in Brussel, het Rood Klooster. Onze gidsen stippelen een leuke route uit van zo\u2019n 20km. Tegen de middag komen we aan in het Rood Klooster en genieten we van de plek met een picknick - auberge espagnol. Rond 13u kan je met \u00e9\u00e9n van onze gidsen terugfietsen richting het centrum.\r\n\r\nAfspraak: 10u00 bij Grand Hospice in de Grootgodshuisstraat 7, 1000 Brussel.\r\n\r\nOntdek het programma op onze website!\r\nhttps:\/\/cactus.brussels\/brussel-velo\/zondag-a-velo","performers":null,"boxoffice_url":null,"website":"https:\/\/cactus.brussels\/brussel-velo","email":"info@cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/535954.html"},"en":{"name":"Dimanche \u00e0 v\u00e9lo - Rood Klooster","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/535954.html"},"de":{"name":"Dimanche \u00e0 v\u00e9lo - Rood Klooster","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/535954.html"},"it":{"name":"Dimanche \u00e0 v\u00e9lo - Rood Klooster","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/535954.html"},"sp":{"name":"Dimanche \u00e0 v\u00e9lo 