"backoffice_id":257542,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.49742263463943},{"id":544995,"date_start":"2022-11-17","date_end":"2022-12-05","date_next":"2022-11-17","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung"}},"others":{"list":[36,42],"translations":{"fr":["Mus\u00e9es et art centers","Peinture"],"nl":["Musea en kunstcentra","Schilderkunst"],"en":["Museums and art centers","Painting"],"de":["Museen & Kunstzentren","Malerei"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Apprendre \u00e0 dispara\u00eetre - une exposition de Fr\u00e9d\u00e9ric Cresson","shortdescr":"A partir du 17 novembre au Mus\u00e9e \u00e9ph\u00e9m\u00e8re de l'exil, apprenez \u00e0 dispara\u00eetre avec Fr\u00e9d\u00e9ric Cresson. Avec cette exposition, le MedexMuseum vous propose de mener une r\u00e9flexion sur l\u2019anonymat \u00e0 la fois comme effacement de l\u2019\u00eatre et outil de lutte.","longdescr":"Qui sont les invisibles d\u2019aujourd\u2019hui ? Ils et elles sont imperceptibles, leur quotidien est difficile \u00e0 saisir. Anonymes d\u2019hier et de demain, quelles traces laisseront-ils et elles dans notre m\u00e9moire collective?\r\n\r\nLes portraits anonymes sont le r\u00e9sultat d\u2019un projet men\u00e9 par Fr\u00e9d\u00e9ric Cresson sur plusieurs ann\u00e9es, d\u2019une m\u00eame posture, d\u2019un support \u00e0 l\u2019autre. T\u00e2ches de peintures, scotch cr\u00e9ent une trame sur le mur dans laquelle le visage du mod\u00e8le-spectateur dispara\u00eet. Hybridation, ali\u00e9nation, invisibilisation, anonymisation \u2026 les corps se fondent dans le d\u00e9cor.\r\n\r\nAnonymes nous apparaissent les \u00ab portraits disparus \u00bb de ces \u00eatres rencontr\u00e9s par l\u2019artiste. Parmi elles des personnes sans papiers doublement anonymes mais dont l\u2019insistance \u00e0 \u00eatre nourrit encore ce projet.\r\n\r\n\u272f Le vernissage aura lieu en pr\u00e9sence de l\u2019artiste jeudi 17 novembre (18h30-22h) au CARWASH by MedexMuseum, rue Longue-Vie 34A, Bruxelles (1050) \u272f\r\n\r\nPlus d'infos sur la page de l'\u00e9v\u00e8nement : https:\/\/fb.me\/e\/2Vy30w5hL","performers":"Fr\u00e9d\u00e9ric Cresson (exposition)","boxoffice_url":null,"website":"http:\/\/www.medexmuseum.com","email":"medexmuseum@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.544995"},"nl":{"name":"Apprendre \u00e0 dispara\u00eetre - une exposition de Fr\u00e9d\u00e9ric Cresson","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.544995"},"en":{"name":"Apprendre \u00e0 dispara\u00eetre - une exposition de Fr\u00e9d\u00e9ric Cresson","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.544995"},"de":{"name":"Apprendre \u00e0 dispara\u00eetre - une exposition de Fr\u00e9d\u00e9ric Cresson","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.544995"},"it":{"name":"Apprendre \u00e0 dispara\u00eetre - une exposition de Fr\u00e9d\u00e9ric Cresson","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_book