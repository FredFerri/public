":"https:\/\/agendabrussels.imgix.net\/c22698bf88cdd0eddac8af9fdbe3d86a98577a12.jpg","width":4781,"height":3491,"ratio":1.37,"translations":{"fr":{"title":"Les Zap\u00e9ro-contes","copyright":null},"nl":{"title":"Les Zap\u00e9ro-contes","copyright":null},"en":{"title":"Les Zap\u00e9ro-contes","copyright":null},"de":{"title":"Les Zap\u00e9ro-contes","copyright":null},"it":{"title":"Les Zap\u00e9ro-contes","copyright":null},"sp":{"title":"Les Zap\u00e9ro-contes","copyright":null},"pt":{"title":"Les Zap\u00e9ro-contes","copyright":null},"cn":{"title":"Les Zap\u00e9ro-contes","copyright":null}}}],"dates":[{"day":"2022-10-21","doors":null,"start":"20:00:00","end":"22:30:00"},{"day":"2022-11-18","doors":null,"start":"20:00:00","end":"22:30:00"},{"day":"2022-12-16","doors":null,"start":"20:00:00","end":"22:30:00"},{"day":"2023-01-20","doors":null,"start":"20:00:00","end":"22:30:00"},{"day":"2023-02-17","doors":null,"start":"20:00:00","end":"22:30:00"},{"day":"2023-03-17","doors":null,"start":"20:00:00","end":"22:30:00"},{"day":"2023-04-21","doors":null,"start":"20:00:00","end":"22:30:00"},{"day":"2023-05-19","doors":null,"start":"20:00:00","end":"22:30:00"},{"day":"2023-06-16","doors":null,"start":"20:00:00","end":"22:30:00"}],"recurring":[{"day":"friday","occurences":{"is_first":false,"is_second":false,"is_third":true,"is_fourth":false,"is_last":false},"time_start":"20:00:00","time_end":"22:30:00","translations":{"fr":"Ouvert le troisi\u00e8me vendredi du mois de 20:00 \u00e0 22:30","nl":"Open op de derde vrijdag van de maand van 20:00 tot 22:30","en":"Open the third friday of the month from 20:00 to 22:30","de":"Open the third friday of the month from 20:00 to 22:30","it":"Open the third friday of the month from 20:00 to 22:30","sp":"Open the third friday of the month from 20:00 to 22:30","pt":"Open the third friday of the month from 20:00 to 22:30","cn":"Open the third friday of the month from 20:00 to 22:30"}}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-02-18T02:36:53+01:00","published_at":"2022-10-11T09:39:17+02:00","backoffice_id":263832,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":0.16113901317993},{"id":545111,"date_start":"2023-03-18","date_end":"2023-03-19","date_next":"2023-03-18","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":70,"translations":{"fr":"Foire & salon","nl":"Beurzen & salons","en":"Fairs and shows","de":"Messe & Ausstellung","it":"Fiere ed esposizioni","sp":"Feria y exhibici\u00f3n","pt":null,"cn":null}},"others":{}},"languages":{"spoken":["nl","fr","en"],"subtitles":[]},"translations":{"fr":{"name":"Brussels Design Market","shortdescr":"Brussels Design Market est le plus grand march\u00e9 de design vintage d'Europe.","longdescr":"Depuis sa cr\u00e9ation, Brussels Design Market s'est d\u00e9velopp\u00e9 en tant que le plus grand march\u00e9 de design d'Europe. Consid\u00e9r\u00e9 comme un incontournable du calendrier international du design vintage, il invite \u00e0 la d\u00e9couverte d'exposants \u00e9clair\u00e9s et passionn\u00e9s, encensant le design du 20e si\u00e8cle avec leurs s\u00e9lections de haute qualit\u00e9. Scandinave, italien ou am\u00e9ricain, de Corbusier \u00e0 Jacobsen en passant par Bertoia, le Brussels Design Market offre un large \u00e9ventail de choix pour r\u00e9pondre \u00e0 la diversit\u00e9 des go\u00fbts et des int\u00e9rieurs.\r\n\r\nProvenant des quatre coins d'Europe, les marchands proposent une collection \u00e9clectique, f\u00e9d\u00e9rant en un seul lieu les styles et tendances qui ont marqu\u00e9 le si\u00e8cle dernier. Au c\u00f4t\u00e9 de pi\u00e8ces iconiques, Brussels Design Market propose aussi des pi\u00e8ces anonymes et exclusives \u00e0 des prix abordables.\r\n\r\nDeux fois par an, en mars et en septembre, Brussels Design Market accueille ses exposants et marchands de vintage dans un espace totalement unique en Europe, \u00e0 la pointe de la technologie de l\u2019architecture et du design : la Gare Maritime enti\u00e8rement restaur\u00e9e \u00e0 Tour & Taxis - 18 000 m\u00e8tres carr\u00e9s sp\u00e9cialement d\u00e9di\u00e9s \u00e0 une s\u00e9lection de design vintage de haute qualit\u00e9.\r\n\r\nConservant l\u2019atmosph\u00e8re unique qui caract\u00e9rise les march\u00e9s aux puces, le Brussels Design Market n\u2019a cess\u00e9 de cro\u00eetre, d\u2019attirer de plus en plus de visiteurs d\u2019ann\u00e9e en ann\u00e9e, et s\u2019est d\u00e9velopp\u00e9 en un v\u00e9ritable lieu de rencontre et d\u2019\u00e9change.","performers":null,"boxoffice_url":null,"website":"https:\/\/designmarket.be\/fr\/","email":"info@designmarket.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.545111"},"nl":{"name":"Brussels Design Market","shortdescr":"Brussels Design Market is de grootste designmarkt van Europa","longdescr":"Sinds zijn ontstaan is de Brussels Design Market uitgegroeid tot de grootste designmarkt van Europa. Het wordt beschouwd als een must in de internationale vintage designkalender en nodigt u uit om verlichte en gepassioneerde exposanten te ontdekken die het 20e-eeuwse design ophemelen met hun selecties van hoge kwaliteit. Scandinavisch, Italiaans of Amerikaans, van Corbusier tot Jacobsen via Bertoia, de Brussels Design Market biedt een ruime keuze om tegemoet te komen aan de diversiteit van smaken en interieurs.\r\n\r\nDe handelaars, afkomstig uit de vier hoeken van Europa, bieden een eclectische collectie die op \u00e9\u00e9n plaats de stijlen en tendensen samenbrengt die de afgelopen eeuw hebben gekenmerkt. Naast iconische stukken, biedt Brussels Design Market ook anonieme en exclusieve stukken aan tegen betaalbare prijzen.\r\n\r\nTwee keer per jaar, in maart en september, verwelkomt de Brussels Design Market haar exposanten en vintage handelaars in een ruimte die volstrekt uniek is in Europa, op het snijvlak van architectuur en designtechnologie: het volledig gerestaureerde Gare Maritime van Tour & Taxis - 18.000 vierkante meter speciaal gewijd aan een selectie van hoogwaardig vintage design.\r\n\r\nDe Brussels Design Market, met zijn unieke rommelmarktsfeer, is blijven groeien, trekt jaar na jaar meer en meer bezoekers en is uitgegroeid tot een echte ontmoetings- en uitwisselingsplaats.","performers":null,"boxoffice_url":null,"website":"https:\/\/designmarket.be\/fr\/","email":"info@designmarket.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.545111"},"en":{"name":"Brussels Design Market","shortdescr":"Brussels Design Market is the largest vintage design market in Europe.","longdescr":"Since its creation, Brussels Design Market has evolved into the largest design market in Europe. It has now become an essential part of the international vintage design calendar, inviting to discover enlightened and passionate exhibitors, promoting 20th century design with their high quality selections. Scandinavian, Italian or American, from Corbusier to Jacobsen via Bertoia, the Brussels Design Market offers a wide range of choices to match the diversity of tastes and interiors.\r\n\r\nArriving from all over Europe, the dealers display an eclectic collection, bringing together multiple styles and trends that have impacted the 20th century. Alongside these icons, the Brussels Design Market also offers anonymous and exclusive design pieces at affordable prices.\r\n\r\nTwice a year, in March and in September, Brussels Design Market welcomes its exhibitors and vintage dealers to a totally unique space in Europe, finding the cutting edge architecture and design technology: the fully restored Gare Maritime at Tour & Taxis - 18,000 square metres specially dedicated to a selection of high quality vintage design.\r\n\r\nMaintaining its unique atmosphere usually characterized by flea markets, the Brussels Design Market continues to extend , to attract more and more visitors from each year, and has developed into a real meeting place.","performers":null,"boxoffice_url":null,"website":"https:\/\/designmarket.be\/fr\/","email":"info@designmarket.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.545111"},"de":{"name":"Brussels Design Market","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/designmarket.be\/fr\/","email":"info@designmarket.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.545111"},"it":{"name":"Brussels Design Market","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/designmarket.be\/fr\/","email":"info@designmarket.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.545111"},"sp":{"name":"Brussels Design Market","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/designmarket.be\/fr\/","email":"info@designmarket.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.545111"},"pt":{"name":"Brussels Design Market","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/designmarket.be\/fr\/","email":"info@designmarket.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.545111"},"cn":{"name":"Brussels Design Market","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/designmarket.be\/fr\/","email":"info@designmarket.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.545111"}},"place":{"id":258279,"translations":{"fr":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Rue Picard","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard","address_line2":"1000 Bruxelles","description_web":"La Gare Maritime : l'ancienne gare de fret devenue jungle urbaine, neutre en \u00e9nergie !\r\n\r\nElle offre le cadre id\u00e9al pour les \u00e9v\u00e9nements culturels innovants, les tournages de films ou s\u00e9ances photo, les march\u00e9s et foires, les lancements et promotions de produits. Les halles de la Gare Maritime ont \u00e9t\u00e9 transform\u00e9es en ville int\u00e9rieure. Elle comportera son propre food hall (\u00e0 partir de septembre 2021), des magasins exclusifs et des bureaux. Dans ce complexe, des espaces uniques et inspirants sont entrecoup\u00e9s de structures en bois chaleureuses. Le b\u00e2timent se pr\u00eate \u00e0 l'organisation de rencontres en petit comit\u00e9 ou de grands happenings. La nef monumentale, attrait architectural, est baign\u00e9e de lumi\u00e8re naturelle indirecte et offre suffisamment d'espace pour les activit\u00e9s int\u00e9rieures bien fr\u00e9quent\u00e9es.\r\nTout \u00e9v\u00e8nement dans la Gare Maritime sera un \u00e9v\u00e8nement \u00e9co-responsable. La durabilit\u00e9 \u00e9tait \u00e0 l'avant-plan pendant les r\u00e9novations du b\u00e2timent. L'\u00e9nergie renouvelable est produite sur place, utilisant la g\u00e9othermie et des panneaux photovolta\u00efques. Sur les promenades vertes bordant la nef centrale, des jardins \u00e0 th\u00e8me et des arbres \u00e0 haut tronc ont \u00e9t\u00e9 amen\u00e9s - comme si le parc voisin se faufile dans le b\u00e2timent. \r\nLa Gare Maritime, un lieu unique : attractif, novateur, ambitieux.\r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Picardstraat","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Picardstraat","address_line2":"1000 Brussel","description_web":"Gare Maritime: van industrieel goederenstation tot energieneutrale urban jungle!\r\n\r\nDe Gare Maritime is de perfecte setting voor innovatieve, culturele evenementen, film- en fotoshoots, markten, beurzen, lanceringen en promoties. De historische stationshallen van de Gare Maritime zijn omgevormd tot overdekte stad, met foodhall (vanaf september 2021), exclusieve winkels en kantoren. Het gebouwencomplex biedt een waaier aan unieke, inspirerende ruimtes afgewisseld met warme houten volumes: perfect voor de organisatie van kleine en grootschalige happenings. D\u00e9 architecturale eyecatcher is de monumentale middenbeuk die baadt in indirect daglicht en over meer dan voldoende ruimte beschikt voor overdekte activiteiten met veel bezoekers.\r\nEen event in de Gare Maritime is een groen event. Tijdens de renovatie van het gebouw was duurzaamheid een speerpunt. Energie wordt ter plaatse hernieuwbaar opgewekt met geothermie en zonnepanelen. De groene wandelboulevards aan weerszijden van de middenbeuk zijn voorzien van thematuinen en hoogstammige bomen, alsof het aangrenzende park het gebouw binnenstroomt. Gare Maritime is een unieke plek: aantrekkelijk, vernieuwend en ambitieus.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Rue Picard","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue Picard","address_line2":"1000 Brussels","description_web":"The Gare Maritime - From industrial freight station to energy neutral urban jungle!\r\n\r\nIt is the perfect setting for innovative cultural events, film or photo shoots, trade shows, fairs, product launches or promotions. \r\nThe historic station concourse that was part of the Gare Maritime has been transformed into an indoor city with its own food hall (coming September 2021), exclusive shops and offices. Countless unique and inspiring areas and warm, wooden structures alternate in this building complex. It is perfectly suited to accommodate both small and major events. The monumental nave is a true architectural eye-catcher, bathed in indirect sunlight and providing ample space for well-attended indoor activities.\r\nAny event in the Gare Maritime is a green event. Sustainability has been key during the renovation works. The building generates its own energy from renewable sources, using geothermics and solar panels. The green boulevards on either side of the nave are lined with themed gardens and tall trees, as if the adjacent park found its way inside. \r\nThe Gare Maritime is a unique place - attractive, innovative and ambitious.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Rue Picard","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Rue Picard","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zi