ate":"public","last_updated_at":"2022-10-10T23:35:59+02:00","published_at":"2022-01-09T22:22:50+01:00","backoffice_id":245100,"import_origin":null,"sub_type":"misc","show_in_agenda":true,"ranking":0.21616643908268},{"id":543061,"date_start":"2022-10-07","date_end":"2022-11-10","date_next":"2022-11-10","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":true,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung"}},"others":{"list":[24,30],"translations":{"fr":["Galeries d'art","Peinture"],"nl":["Galeries","Schilderkunst"],"en":["Art Galleries","Painting"],"de":["Kunstgalerien","Malerei"]}}},"languages":{"spoken":["fr","en","nl","it"],"subtitles":[]},"translations":{"fr":{"name":"Marianna Stuhr. Peinture","shortdescr":"Nous vous invitons au vernissage de l'exposition de peinture de Marianna Stuhr. L'artiste est dipl\u00f4m\u00e9e de l'Acad\u00e9mie des Beaux-Arts de Cracovie. Elle a aussi obtenu le titre de docteur dans l'Acad\u00e9mie des Beaux-Arts de Varsovie. \r\nDans son art, elle m\u00e8ne des recherches dont l'inspiration la plus importante est le cosmos et les changements qui s'y produisent.","longdescr":"MARIANNA STUHR est dipl\u00f4m\u00e9e de la Facult\u00e9 de graphisme de l'Acad\u00e9mie des Beaux-Arts de Jan Matejko \u00e0 Cracovie et des \u00e9tudes doctorales \u00e0 l'Acad\u00e9mie des Beaux-Arts de Varsovie. Elle est laur\u00e9ate de nombreux prix et bourses, entre les autres au sein de Programme Jeune Pologne. Elle a particip\u00e9 \u00e0 des expositions, des concours et des ateliers d'art en Pologne et ailleurs; ses \u0153uvres ont \u00e9t\u00e9 incluses dans les collections de la Fondazione Italo-Svedese \u00e0 Venise, de l'Acad\u00e9mie des Beaux-Arts de Cracovie, de l'Acad\u00e9mie des Beaux-Arts de Varsovie, de la Quadriennale polonaise de la gravure sur bois \u00e0 Olsztyn, International Triennial Association Graphics in Cracovie, University of Connceticut in Connecticut, USA, Real Stories Gallery - \"Arts for Humanity\" Foundation in Durban, Afrique du Sud.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.napiorkowska.pl","email":"galeria@napiorkowska.pl","phone_contact":null,"phone_booking":"+32 495 71 89 88","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.543061"},"nl":{"name":"Marianna Stuhr","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.543061"},"en":{"name":"Marianna Stuhr. Paintings","shortdescr":"Opening of the exhibition of paintings by Marianna Stuhr. The artist graduated from the Academy of Fine Arts in Krakow. At the Academy of Fine Arts in Warsaw, she obtained the title of Doctor of Arts. She works in graphic design and painting. Her most important inspiration is the cosmos and the changes taking place in it.","longdescr":"MARIANNA STUHR is a graduate of the Faculty of Graphic Design at the Academy of Fine Arts of Jan Matejko in Krakow and doctoral studies at the Academy of Fine Arts in Warsaw. She received numerous awards and scholarships, incl. Young Poland Program. She has participated in exhibitions, competitions and art workshops in Poland and abroad, and her works have been included in the collections of the Fondazione Italo-Svedese in Venice, the Academy of Fine Arts in Krakow, the Academy of Fine Arts in Warsaw, the Polish Quadrennial of Woodcuts in Olsztyn, International Triennial Association Graphics in Krakow, University of Connceticut in Connecticut, USA, Real Stories Gallery - \"Arts for Humanity\" Foundation in Durban, South Africa.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.543061"},"de":{"name":"Mariann Stuhr. Peinture","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.543061"},"it":{"name":"Mariann Stuhr. Peinture","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.543061"},"sp":{"name":"Mariann Stuhr. Peinture","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.543061"},"pt":{"name":"Mariann Stuhr. Peinture","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.543061"},"cn":{"name":"Mariann Stuhr. Peinture","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.543061"}},"place":{"id":251322,"translations":{"fr":{"name":"Galerie Katarzyna Napi\u00f3rkowska","address_street_name":"Mont des Arts","address_street_number":"8","address_street_box":null,"email":null,"website":"http:\/\/www.napiorkowska.pl","phone_contact":"+32 495 71 89 88","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Mont des Arts, 8","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name