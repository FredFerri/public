:[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[],"opening":{"day":"2024-09-19","start":"19:00:00","timestamp":"2024-09-19T19:00:00"}},{"id":5700000600,"date_start":"2024-09-27","date_end":"2024-11-16","date_next":"2024-10-26","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-10-26T03:01:42+02:00","published_at":"2024-08-28T17:33:03+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":306635,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"other","ranking":0.3397451558437311,"languages":{"spoken":["en","fr","nl"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[44,36],"translations":{"de":["Design","Museen & Kunstzentren"],"pt":[null,null],"en":["Design","Museums and art centers"],"it":["Design","Musei e centri artistici"],"cn":[null,null],"fr":["Design","Mus\u00e9es et art centers"],"sp":["Dise\u00f1o","Museos y centros de arte"],"nl":["Design","Musea en kunstcentra"]}}},"translations":{"de":{"name":"Future Generation \u2014 MAD Incubator Show","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/mad.brussels\/en\/agenda\/future-generation-mad-incubator-show","email":"contact@mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700000600"},"pt":{"name":"Future Generation \u2014 MAD Incubator Show","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/mad.brussels\/en\/agenda\/future-generation-mad-incubator-show","email":"contact@mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700000600"},"en":{"name":"Future Generation \u2014 MAD Incubator Show","shortdescr":"Future Generation presents the next generation of creatives from the Brussels fashion and design sector. Through the work of the 10 designers and design studios in residency at the MAD incubator, the exhibition offers alternatives for a future that is more sustainable, innovative and inclusive. Besides, you can discover 14 graduation projects during your visit to the MAD Graduation Show.\n","longdescr":"MAD Incubator Show presents the design practices and projects of our 10 designers and design studios in residence. From skin-friendly textiles made from algae to upcycled collections that showcase cultural diversity, the designers offer alternatives for a future that is more conscious and innovative. Discover the fashion and design world of tomorrow with a focus on in-depth research, reuse of materials, new bio-sourced materials, innovative technologies and artisan craftsmanship.\n\nThe exhibition introduces you to our incubator and mentoring program and gives an overview of the projects realized by the designers during their two-year stay in our studios.","performers":"Anneleen Bertels, Design For Resilience by Vanessa Colignon, Guillaume Slizewicz, Kana Arioka, Kartchev studio by Stefan Kartchev, Kasbah Kosmic by Kenza Vandeput Taleb, Margot Van den Berghe, Mipinta by Fernando Mir\u00f3, Skin Series by Rosie Broadhead, Studio Minim\u00e8tre by B\u00e9r\u00e9nice de Salvatore & Bastien Chevrier","boxoffice_url":null,"website":"https:\/\/mad.brussels\/en\/agenda\/future-generation-mad-incubator-show","email":"contact@mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700000600"},"it":{"name":"Future Generation \u2014 MAD Incubator Show","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/mad.brussels\/en\/agenda\/future-generation-mad-incubator-show","email":"contact@mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700000600"},"cn":{"name":"Future Generation \u2014 MAD Incubator Show","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/mad.brussels\/en\/agenda\/future-generation-mad-incubator-show","email":"contact@mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700000600"},"fr":{"name":"Future Generation \u2014 MAD Incubator Show","shortdescr":"Future Generation pr\u00e9sente la nouvelle g\u00e9n\u00e9ration de cr\u00e9ateur\u00b7ice\u00b7s du secteur de la mode et du design \u00e0 Bruxelles. L'exposition met en lumi\u00e8re travers le travail de 10 designers en r\u00e9sidence au MAD Incubateur, offrant des perspective d'alternatives pour un avenir plus durable, innovant et inclusif. De plus, vous aurez l'occasion de d\u00e9couvrir 14 projets de fin d'\u00e9tudes dans le MAD Graduation Show.","longdescr":"L\u2019exposition MAD Incubator Show pr\u00e9sente les pratiques et les projets de nos 10 designers et studios de design en r\u00e9sidence. Des textiles \u00e0 base d\u2019algues adapt\u00e9s \u00e0 la peau aux collections upcycl\u00e9s c\u00e9l\u00e9brant la diversit\u00e9 culturelle, les designers proposent des alternatives pour un avenir plus conscient et innovant. D\u00e9couvrez le monde de la mode et du design de demain qui favorise la recherche, la r\u00e9utilisation des mat\u00e9riaux, les nouveaux mat\u00e9riaux biosourc\u00e9s, les technologies innovantes et le savoir-faire artisanal.\n\nL'exposition donne un aper\u00e7u de notre programme de r\u00e9sidence et de mentorat ainsi que des projets r\u00e9alis\u00e9s par les designers au sein de nos ateliers au cours des deux derni\u00e8res ann\u00e9es.","performers":null,"boxoffice_url":null,"website":"https:\/\/mad.brussels\/en\/agenda\/future-generation-mad-incubator-show","email":"contact@mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700000600"},"sp":{"name":"Future Generation \u2014 MAD Incubator Show","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/mad.brussels\/en\/agenda\/future-generation-mad-incubator-show","email":"contact@mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700000600"},"nl":{"name":"Future Generation \u2014 MAD Incubator Show","shortdescr":"Future Generation stelt de nieuwe generatie creatievelingen uit de Brusselse mode- en designsector voor. Aan de hand van het werk van de 10 designers in residentie bij de MAD incubator, biedt de tentoonstelling alternatieven voor een toekomst die duurzamer, innovatiever en inclusiever is. Daarnaast kan je 14 afstudeerprojecten ontdekken tijdens de MAD Graduation Show.","longdescr":"De MAD Incubator Show presenteert de ontwerppraktijk en projecten van onze 10 designers en designstudio's in residentie. Van huidvriendelijk textiel gemaakt van algen tot upcyclede collecties die culturele diversiteit tonen, de designers bieden alternatieven voor een toekomst die bewuster en innovatiever is. Ontdek de mode- en designwereld van morgen met een focus op diepgaand onderzoek, hergebruik van materialen, nieuwe materialen van biologische oorsprong, innovatieve technologie\u00ebn en ambachtelijk vakmanschap.\n\nDe tentoonstelling laat je kennismaken met ons incubator- en begeleidingsprogramma en geeft een overzicht van de projecten die de designers tijdens hun tweejarig verblijf in onze ateliers hebben gerealiseerd.","performers":null,"boxoffice_url":null,"website":"https:\/\/mad.brussels\/en\/agenda\/future-generation-mad-incubator-show","email":"contact@mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700000600"}},"place":{"id":250516,"translations":{"de":{"name":"MAD Brussels","address_street_name":"Place du Nouveau March\u00e9 aux Grains","address_street_number":"10","address_street_box":null,"email":"contact@mad.brussels","website":"http:\/\/www.mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":"+32 2 880 85 62","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place du Nouveau March\u00e9 aux Grains, 10","address_line2":"1000 Bruxelles","description_web":"MAD Brussels ist eine Br\u00fcsseler Mode- und Designplattform, die sich der F\u00f6rderung, Unterst\u00fctzung und Begleitung der Br\u00fcsseler Modesch\u00f6pfer und Designern verschrieben hat, um sowohl landesweit als auch international ihre Reichweite zu erh\u00f6hen.\r\n\r\nDie Er\u00f6ffnung des neuen, komplett in Wei\u00df gehaltenen Geb\u00e4udes hat dem MAD Brussels noch einmal frischen Wind in den Segeln beschert. Hier befinden sich nicht nur Ressourcen f\u00fcr Vertreter der Kreativindustrie und damit zusammenh\u00e4ngenden Metiers, sondern auch vielf\u00e4ltig nutzbare Arbeitspl\u00e4tze und Orte der Begegnung. Modesch\u00f6pfer und Designer haben hier eine Anlaufstelle, gleichzeitig finden in den R\u00e4umen Ateliers, Workshops, Seminare, Ausstellungen, Modeschauen, Kunst-Performances statt\u2026\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"MAD Brussels","address_street_name":"Place du Nouveau March\u00e9 aux Grains","address_street_number":"10","address_street_box":null,"email":"contact@mad.brussels","website":"http:\/\/www.mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":"+32 2 880 85 62","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place du Nouveau March\u00e9 aux Grains, 10","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"MAD Brussels","address_street_name":"Nieuwe Graanmarkt","address_street_number":"10","address_street_box":null,"email":"contact@mad.brussels","website":"http:\/\/www.mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":"+32 2 880 85 62","address_zip":"1000","address_city":"Brussels","address_line1":"Nieuwe Graanmarkt, 10","address_line2":"1000 Brussels","description_web":"MAD Brussels is a Brussels\u2019 platform for gathering expertise from the city\u2019s Fashion and Design sectors. It aims to help with the promotion and development of Brussels stylists and designers and improve their exposure nationally and abroad.\r\n\r\nThe opening in April 2017 of their brand new, sparkling white headquarters marked something of a renaissance for the non-profit organisation, which can now multiply and combine its campaigns. It houses a ressource centre for professionals of the creative industries and related sectors, along with adaptable workspaces, meeting spaces, workshops, seminar rooms and a large space dedicated to public activities where multiple events are organised every year: exhibitions, fashion shows, artistic performances\u2026\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"MAD Brussels","address_street_name":"Place du Nouveau March\u00e9 aux Grains","address_street_number":"10","address_street_box":null,"email":"contact@mad.brussels","website":"http:\/\/www.mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":"+32 2 880 85 62","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place du Nouveau March\u00e9 aux Grains, 10","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"MAD Brussels","address_street_name":"Place du Nouveau March\u00e9 aux Grains","address_street_number":"10","address_street_box":null,"email":"contact@mad.brussels","website":"http:\/\/www.mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":"+32 2 880 85 62","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place du Nouveau March\u00e9 aux Grains, 10","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"MAD Brussels","address_street_name":"Place du Nouveau March\u00e9 aux Grains","address_street_number":"10","address_street_box":null,"email":"contact@mad.brussels","website":"http:\/\/www.mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":"+32 2 880 85 62","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place du Nouveau March\u00e9 aux Grains, 10","address_line2":"1000 Bruxelles","description_web":"MAD Brussels est la plateforme bruxelloise d\u2019expertise dans les secteurs de la Mode et du Design.   Elle s\u2019emploie \u00e0 renforcer la promotion, \u00e0 accompagner le d\u00e9veloppement des stylistes et designers bruxellois et \u00e0 accro\u00eetre leur rayonnement (inter )national.  \r\n\r\nL\u2019ouverture en avril 2017 du nouveau b\u00e2timent enti\u00e8rement blanc a marqu\u00e9 une renaissance pour l\u2019asbl, qui dans ce lieu unique multiplie et combine ses actions. Il h\u00e9berge le centre de ressources pour les professionnels des industries cr\u00e9atives aux fili\u00e8res de m\u00e9tiers d\u00e9riv\u00e9es, des espaces de travail polyvalents, lieux de rencontres, d\u2019accueil de cr\u00e9ateurs, d\u2019ateliers, de s\u00e9minaires, ainsi qu\u2019un grand espace d\u00e9di\u00e9 aux activit\u00e9s publiques o\u00f9 sont organis\u00e9es chaque ann\u00e9e de multiples \u00e9v\u00e8nements: expositions, d\u00e9fil\u00e9s, performances artistiques,\u2026\r\n\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"MAD Brussels","address_street_name":"Place du Nouveau March\u00e9 aux Grains","address_street_number":"10","address_street_box":null,"email":"contact@mad.brussels","website":"http:\/\/www.mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":"+32 2 880 85 62","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place du Nouveau March\u00e9 aux Grains, 10","address_line2":"1000 Bruxelles","description_web":"MAD Brussels es una plataforma de Bruselas que reune expertos del los sectores de la moda y el dise\u00f1o. Tiene como objetivo ayudar en la promoci\u00f3n y el desarrollo de los dise\u00f1adores y estilistas de Bruselas y mejorar su imagen nacional e internacional.\r\nLa apertura de su novedosa y chispeante sede en abril de 2017 marc\u00f3 algo as\u00ed como el renacimiento para la organizaci\u00f3n sin \u00e1nimo de lucro, que ahora puede multiplicar y combinar sus campa\u00f1as. Posee un centro de recursos para profesionales de industrias culturales y sectores relacionados, junto con espacios de trabajo adaptados, lugares de reuni\u00f3n, talleres, seminarios y un gran espacio dedicado a actividades p\u00fablicas donde se organizan diversos eventos cada a\u00f1o: exhibiciones, desfiles de moda, representaciones art\u00edsticas\u2026\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"MAD Brussels","address_street_name":"Nieuwe Graanmarkt","address_street_number":"10","address_street_box":null,"email":"contact@mad.brussels","website":"http:\/\/www.mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":"+32 2 880 85 62","address_zip":"1000","address_city":"Brussel","address_line1":"Nieuwe Graanmarkt, 10","address_line2":"1000 Brussel","description_web":"MAD Brussels is het Brussels kennisplatform voor de mode- en designsectoren.  Het zet zich in voor de promotie en begeleiding van Brusselse stylisten en ontwerpers en de vergroting van hun (inter)nationale uitstraling. \r\n\r\nDe opening van hun nieuwe, volledig witte gebouw in april 2017 betekende een belangrijke impuls voor de vzw die op die unieke plek zijn verschillende doelstellingen kan uitbreiden en combineren. Het gebouw herbergt het onderzoekscentrum voor professionals uit de creatieve sectoren en aanverwante beroepsgroepen, multifunctionele werkruimtes, ontmoetingsplekken, ontvangstruimtes voor ontwerpers, workshops en seminaries en daarbij ook nog een grote ruimte waarin elk jaar verschillende activiteiten voor het grote publiek plaatsvinden, zoals tentoonstellingen, modeshows of artistieke performances.  \r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[3],"translations":{"de":["Dansaert\/Sainte-Catherine"],"pt":[null],"en":["Dansaert\/Sainte-Catherine"],"it":["Dansaert\/Sainte-Catherine"],"cn":[null],"fr":["Dansaert\/Sainte-Catherine"],"sp":["Dansaert\/Sainte-Catherine"],"nl":["Dansaertwijk\/Sint-Katelijne"]}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":null,"facebook_id":null,"backoffice_id":12629,"location":{"lat":50.851148,"lon":4.3441836},"region":"brussels","last_updated_at":"2024-03-04T10:32:39+01:00","published_at":"2013-10-19T01:34:31+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":250516,"translations":{"de":{"name":"MAD Brussels","address_street_name":"Place du Nouveau March\u00e9 aux Grains","address_street_number":"10","address_street_box":null,"em