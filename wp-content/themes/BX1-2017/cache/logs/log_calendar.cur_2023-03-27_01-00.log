ebsite":"http:\/\/lamaisondesarts.be\/meet-the-curator-sub-terra\/","email":"info@lamaisondesarts.be","phone_contact":null,"phone_booking":"+32 490 14 25 37","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.551476"},"en":{"name":"Expo Sub terra | Meet the Curator","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/lamaisondesarts.be\/meet-the-curator-sub-terra\/","email":"info@lamaisondesarts.be","phone_contact":null,"phone_booking":"+32 490 14 25 37","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.551476"},"de":{"name":"Expo Sub terra | Meet the Curator","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/lamaisondesarts.be\/meet-the-curator-sub-terra\/","email":"info@lamaisondesarts.be","phone_contact":null,"phone_booking":"+32 490 14 25 37","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.551476"},"it":{"name":"Expo Sub terra | Meet the Curator","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/lamaisondesarts.be\/meet-the-curator-sub-terra\/","email":"info@lamaisondesarts.be","phone_contact":null,"phone_booking":"+32 490 14 25 37","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.551476"},"sp":{"name":"Expo Sub terra | Meet the Curator","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/lamaisondesarts.be\/meet-the-curator-sub-terra\/","email":"info@lamaisondesarts.be","phone_contact":null,"phone_booking":"+32 490 14 25 37","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.551476"},"pt":{"name":"Expo Sub terra | Meet the Curator","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/lamaisondesarts.be\/meet-the-curator-sub-terra\/","email":"info@lamaisondesarts.be","phone_contact":null,"phone_booking":"+32 490 14 25 37","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.551476"},"cn":{"name":"Expo Sub terra | Meet the Curator","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/lamaisondesarts.be\/meet-the-curator-sub-terra\/","email":"info@lamaisondesarts.be","phone_contact":null,"phone_booking":"+32 490 14 25 37","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.551476"}},"place":{"id":222932,"translations":{"fr":{"name":"Maison des Arts","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 147","address_line2":"1030 Schaerbeek","description_web":"La Maison des Arts, anim\u00e9e par le Service Culture fran\u00e7aise de la Commune de Schaerbeek, est un espace singulier dont les activit\u00e9s sont principalement ax\u00e9es sur la cr\u00e9ation contemporaine dans le domaine des arts plastiques avec un important programme de m\u00e9diation permettant l\u2019acc\u00e8s de l\u2019art contemporain \u00e0 tous.\r\n\r\nLa MA conna\u00eet une riche activit\u00e9 artistique depuis les ann\u00e9es \u201950, \u00e9poque \u00e0 laquelle la commune rach\u00e8te le b\u00e2timent. En 2005, elle se voit prendre un premier tournant en proposant aux artistes de travailler in situ, afin d\u2019\u00e9tablir une r\u00e9elle coh\u00e9rence entre l\u2019\u0153uvre et la Maison.\r\nEt finalement, c\u2019est en 2016 que la Commune de Schaerbeek d\u00e9cide de la positionner dans le domaine des arts plastiques, contemporains et num\u00e9riques comme un lieu de cr\u00e9ation, de diffusion et de rayonnement culturel.\r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Huis der Kunsten","address_street_name":"Haachtsesteenweg","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaarbeek","address_line1":"Haachtsesteenweg, 147","address_line2":"1030 Schaarbeek","description_web":"La Maison des Arts, geanimeerd door de dienst Franstalige Cultuur van de gemeente Schaarbeek, is een heel bijzondere plek. De activiteiten zijn vooral gericht op hedendaagse creativiteit in de plastische kunsten.\r\n\r\nIn La Maison des Arts heerst reeds sedert 1950 ( datum waarop de gemeente het huis aankocht) een ruime artistieke activiteit. In 2005 is er een belangrijke ontwikkeling : het voorstel aan de kunstenaars om ter plaatse te werken, teneinde een echte samenhang te bereiken tussen het werk en het Huis. Uiteindelijk beslist de Gemeente Schaarbeek er een echte broeikast van te maken in het domein van de beeldende kunsten, een bron van schepping, verspreiding en culturele uitstraling.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Maison des Arts","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 147","address_line2":"1030 Schaerbeek","description_web":"The MdA is run and staffed by the Francophone Cultural Service of Schaerbeek Council and is a unique place whose activities are mainly concerned with the creation of works of contemporary art with a significant partnership programme that promotes access for all to contemporary art.\r\n\r\nThe MdA has hosted a rich programme of artistic activities since the 1950s when the building was purchased by Schaerbeek Council. In 2005, the MdA began a programme of inviting artists to work in building, to build more coherence between their works of art and the MdA.\r\n\r\nMost recently, in 2016, Schaerbeek Council decided to position the MdA as a centre for the creation, diffusion and promotion of culture, contemporary two-dimensional, three-dimensional and digital art.\r\nThe MdA\u2019s educational and social approach aims to promoting equality of access to art and its introduction to new audiences.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Maison des Arts","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 147","address_line2":"1030 Schaerbeek","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Maison des Arts","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 147","address_line2":"1030 Schaerbeek","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Maison des Arts","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 147","ad