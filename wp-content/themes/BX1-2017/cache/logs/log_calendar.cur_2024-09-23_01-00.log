le27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-06-28T11:52:02+02:00","published_at":"2024-06-28T11:51:09+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":303114,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"concert","ranking":1.8171205928321397,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":1,"translations":{"de":"Konzert","pt":null,"en":"Concert","it":"Concerti","cn":null,"fr":"Concert","sp":"Concierto","nl":"Concert"}},"others":{}},"translations":{"de":{"name":"Blackout Session - Alice Coltrane","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/atelier210.be\/saisons\/saison-24-25\/blackout-session-alice-coltrane\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50011960"},"pt":{"name":"Blackout Session - Alice Coltrane","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/atelier210.be\/saisons\/saison-24-25\/blackout-session-alice-coltrane\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50011960"},"en":{"name":"Blackout Session - Alice Coltrane","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/atelier210.be\/saisons\/saison-24-25\/blackout-session-alice-coltrane\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50011960"},"it":{"name":"Blackout Session - Alice Coltrane","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/atelier210.be\/saisons\/saison-24-25\/blackout-session-alice-coltrane\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50011960"},"cn":{"name":"Blackout Session - Alice Coltrane","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/atelier210.be\/saisons\/saison-24-25\/blackout-session-alice-coltrane\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50011960"},"fr":{"name":"Blackout Session - Alice Coltrane","shortdescr":"La formule est simple : un disque \u00e0 \u00e9couter en entier et dans l\u2019obscurit\u00e9 totale. Le seule crit\u00e8re de s\u00e9lection : un album solide de bout en bout. ","longdescr":"La formule est simple : un disque \u00e0 \u00e9couter en entier et dans l\u2019obscurit\u00e9 totale. Le seule crit\u00e8re de s\u00e9lection : un album solide de bout en bout. Une fois par mois, ou presque. C\u2019est gratuit, sans r\u00e9servation. Par contre, on vous pr\u00e9vient, il n\u2019y a pas toujours de place pour tout le monde, donc ne venez pas trop tard. La team bar est l\u00e0 pour vous accueillir en musique. Toute entr\u00e9e est impossible apr\u00e8s le lancement du disque et le bar est ferm\u00e9 durant l\u2019\u00e9coute, qu\u2019on se le dise. Programmation et introduction par Xavier Daive alias Funky Bompa.\n\nDisque du jour : Alice Coltrane\n\nAlice Coltrane signe un magnifique 4e album studio pendant une p\u00e9riode de transition, entre m\u00e9ditation, recherche de spiritualit\u00e9, recentrage sur sa vie de famille apr\u00e8s le d\u00e9c\u00e8s de son mari 4 ans plus t\u00f4t. Ses concerts sont rares. Le titre de l\u2019album fait r\u00e9f\u00e9rence au guru \u00ab spiritual preceptor, example of Universal Love or God in action \u00bb Swami Satchidananda Saraswati, fondateur de Yogaville (USA) et dont Alice Coltrane est et restera une fid\u00e8le disciple. Alice m\u00eale piano et harpe sur un disque m\u00e9ditatif et soutenu, teint\u00e9 de sonorit\u00e9s indiennes gr\u00e2ce \u00e0 la musicienne Tulsi Sen Gupta et son tanpura (qui produit cet effet de bourdon caract\u00e9ristique). Elle est accompagn\u00e9e de son line-up attitr\u00e9 et all-star avec Pharaoh Sanders (sax) en invit\u00e9, Cecil McBee & Charlie Haden (dbl bass), Rashied Ali (dr), Vishnu Wood (oud sur \"Isis and Osiris \u00bb), Majid Shabazz (percussion).\n\nDu jazz modal et spirituel \u00e0 son sommet. Un moment de m\u00e9ditation et de connexion.\n\nStyle : jazz\nAnn\u00e9e : 1971\nDur\u00e9e : 37:06\nLabel : Impulse!\nPays : USA","performers":null,"boxoffice_url":null,"website":"https:\/\/atelier210.be\/saisons\/saison-24-25\/blackout-session-alice-coltrane\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50011960"},"sp":{"name":"Blackout Session - Alice Coltrane","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/atelier210.be\/saisons\/saison-24-25\/blackout-session-alice-coltrane\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50011960"},"nl":{"name":"Blackout Session - Alice Coltrane","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/atelier210.be\/saisons\/saison-24-25\/blackout-session-alice-coltrane\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50011960"}},"place":{"id":241923,"translations":{"de":{"name":"Atelier 210","address_street_name":"Chauss\u00e9e Saint-Pierre","address_street_number":"210","address_street_box":null,"email":"info@atelier210.be","website":"http:\/\/ww