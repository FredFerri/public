lic_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre"}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"L'\u00e9t\u00e9 spectaculaire - L\u2019enfant qui est n\u00e9 deux fois","shortdescr":"Un cheminement initiatique qui se veut \u00e0 la fois terrible, cruel, mais aussi lib\u00e9rateur, ludique et dr\u00f4le\u2026","longdescr":"Une m\u00e8re affaiblie par la famine et le froid va mettre au monde un enfant qui respire \u00e0 peine. La grand-m\u00e8re psalmodie alors une incantation exhortant le souffle de l\u2019enfant \u00e0 se trouver un autre corps \u00e0 habiter plut\u00f4t que de les quitter pour aller danser seul dans le ciel. L\u2019\u00e2me du b\u00e9b\u00e9 va suivre son conseil : elle se r\u00e9fugie sur le dos d\u2019une petite souris.\r\n\r\nElle va vivre un \u00e9tonnant p\u00e9riple a\u00e9rien, terrien et aquatique \u00e0 la recherche d\u2019un corps \u00e0 habiter. Seule sur sc\u00e8ne avec pour tout d\u00e9cor la lumi\u00e8re et des planches \u00e9parpill\u00e9es, M\u00e9lancolie Motte propose d\u2019\u00e9voquer avec po\u00e9sie, musicalit\u00e9 et douceur une th\u00e9matique sans \u00e2ge \u00e0 laquelle le jeune public est souvent confront\u00e9 d\u2019une mani\u00e8re ou d\u2019une autre : le cycle implacable de la vie et de la mort.","performers":"De M\u00e9lancolie Motte\r\nMise en sc\u00e8ne Julie Nayer, Caroline Corn\u00e9lis\r\nCr\u00e9ation sonore Antonin De Bernels\r\nCr\u00e9ation lumi\u00e8re Jocelyn Asciak\r\nD\u00e9cors Idiot Productions\r\nAvec le soutien de la F\u00e9d\u00e9ration Wallonie-Bruxelles, du th\u00e9\u00e2tre La montagne magique, La Roseraie, Pierre de Lune, du CC de Nivelles et de la Maison des cultures de Molenbeek.","boxoffice_url":null,"website":"http:\/\/www.roseraie.org","email":"communication@roseraie.org","phone_contact":null,"phone_booking":"+32 2 376 46 45","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/538890.html"},"nl":{"name":"L'\u00e9t\u00e9 spectaculaire - L\u2019enfant qui est n\u00e9 deux fois","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/538890.html"},"en":{"name":"L'\u00e9t\u00e9 spectaculaire - L\u2019enfant qui est n\u00e9 deux fois","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/538890.html"},"de":{"name":"L'\u00e9t\u00e9 spectaculaire - L\u2019enfant qui est n\u00e9 deux fois","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/538890.html"},"it":{"name":"L'\u00e9t\u00e9 spectaculaire - L\u2019enfant qui est n\u00e9 deux fois","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/538890.html"},"sp":{"name":"L'\u00e9t\u00e9 spectaculaire - L\u2019enfant qui est n\u00e9 deux fois","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/538890.html"},"pt":{"name":"L'\u00e9t\u00e9 spectaculaire - L\u2019enfant qui est n\u00e9 deux fois","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/538890.html"},"cn":{"name":"L'\u00e9t\u00e9 spectaculaire - L\u2019enfant qui est n\u00e9 deux fois","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/538890.html"}},"place":{"id":7929,"translations":{"fr":{"name":"Centre Culturel d'Uccle","address_street_name":"Rue Rouge","address_street_number":"47","address_street_box":null,"email":"reservation@ccu.be","website":"http:\/\/www.ccu.be","phone_contact":"+32 2 374 64 84","phone_booking":"+32 2 374 64 84","address_zip":"1180","address_city":"Uccle","address_line1":"Rue Rouge, 47","address_line2":"1180 Uccle","description_web":"Le Centre culturel d\u2019Uccle est contemporain de l\u2019Atomium. Con\u00e7u pour se trouver dans un \u00e9crin de verdure, face au Parc de Wolvendael, la premi\u00e8re pierre fut pos\u00e9e le 30 novembre 1957. Le Centre Culturel et Artistique d\u2019Uccle fut inaugur\u00e9 le 5 octobre 1958.\r\nLe CCU est une \u0153uvre de l\u2019architecte L\u00e9on Stynen, qui avait aussi con\u00e7u les casinos de Knokke, Blankenberge et Ostende.\r\nCe nouveau Centre Culturel permit aux soci\u00e9t\u00e9s et associations int\u00e9ress\u00e9es d\u2019organiser des bals, des conf\u00e9rences, des concerts, des projections de films, des d\u00e9bats et toutes autres manifestations culturelles et artistiques (ballets, concerts, expositions, r\u00e9ceptions, \u2026). Il proposait aussi des repr\u00e9sentations th\u00e9\u00e2trales, un cycle de conf\u00e9rences et des spectacles musicaux.\r\nL'ensemble du b\u00e2timent abrite principalement un hall d\u2019entr\u00e9e donnant acc\u00e8s \u00e0 une grande Salle de Spectacle de 800 fauteuils, un Grand Foyer pouvant accueillir jusqu'\u00e0 400 personnes assises, ainsi qu'un Petit Foyer pouvant contenir 120 personnes.\r\nPlus de cinquante ans apr\u00e8s sa cr\u00e9ation, le Centre Culturel d\u2019Uccle r\u00e9nov\u00e9 a un look \u00e0 la fois contemporain et chaleureux. Pleinement actif, il r\u00e9pond aux d\u00e9fis culturels de son si\u00e8cle en accueillant les plus grands noms du th\u00e9\u00e2tre, de la danse, de la chanson et de la musique ainsi que des artistes et des conf\u00e9renciers de renom. Il s\u2019est constamment modernis\u00e9 pour offrir \u00e0 son public une vie culturelle de qualit\u00e9 au c\u0153ur de la commune d\u2019Uccle.\r\nDirig\u00e9 par une \u00e9quipe dynamique, le CCU met tout en \u0153uvre pour fid\u00e9liser sa client\u00e8le et conqu\u00e9rir sans cesse un public nouveau.\r\nLe Centre Culturel d\u2019Uccle en quelques chiffres, c\u2019est\u2026\r\n-\tUn des plus grands centres culturels \u00e0 Bruxelles et ses environs\r\n-\tUn rendez-vous des professionnels du spectacle\r\n-\t4 espaces bien distincts (Hall, Grand Foyer, Petit Foyer, Salle de Spectacle)\r\n-\tUne salle de spectacle de 800 places\r\n-\tUn gradin r\u00e9tractable de 172 places\r\n-\t200 activit\u00e9s par an\r\n-\t600 artistes par saison\r\n-\t60.000 spectateurs par an\r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"CC Ukkel","address_street_name":"Rodestraat","address_street_number":"47","address_street_box":null,"email":"info@ccu.be","website":"http:\/\/www.ccu.be","phone_contact":"+32 2 374 64 84","phone_booking":"+32 2 374 64 84","address_zip":"1180","address_city":"Ukkel","address_line1":"Rodestraat, 47","address_line2":"1180 Ukkel","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Centre Culturel d'Uccle","address_street_name":"Rue Rouge","address_street_number":"47","address_street_box":null,"email":"reservation@ccu.be","website":"http:\/\/www.ccu.be","phone_contact":"+32 2 374 64 84","phone_booking":"+32 2 374 64 84","address_zip":"1180","address_city":"Uccle","address_line1":"Rue 