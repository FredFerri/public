{"name":"Etudiants"},"nl":{"name":"Studenten"},"en":{"name":"Students"}},"value":15}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-11T16:35:18+02:00","published_at":"2022-10-11T15:47:40+02:00","backoffice_id":263896,"import_origin":null,"sub_type":"concert","show_in_agenda":true,"ranking":1.2599210498949},{"id":541057,"date_start":"2022-10-15","date_end":"2022-10-15","date_next":"2022-10-15","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":true,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert","de":"Konzert"}},"others":{"list":[4,6],"translations":{"fr":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"],"nl":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"],"en":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"],"de":["Pop, Rock, Jazz...","Worldmusic, Folk & Country"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Diab Quintet","shortdescr":"CD-Release \u2018Hurac\u00e1n\u2019","longdescr":"Le Diab Quintet est de retour avec un troisi\u00e8me opus. Toujours bas\u00e9 sur ses compositions, l\u2019accord\u00e9oniste Jonathan De Neck a arrang\u00e9 avec ses complices un r\u00e9pertoire \u00e9clectique, hypnotisant, intense. Voici le nouveau CD \u00ab Hurac\u00e1n \u00bb, un tourbillon m\u00e9lodique o\u00f9 se m\u00ealent le bleu profond des eaux calmes au rouge vif du feu qui les anime.\r\n\r\nLe Diab Quintet est n\u00e9 il y a sept ans de l\u2019envie d\u2019une rencontre entre l\u2019univers des cordes issues de la musique dite classique et celui, plus folk et musiques du monde, de l\u2019accord\u00e9on diatonique et des percussions. Avec deux albums \u00e0 leur actif, \u2018Fourmili\u00e8res\u2019 en 2013 et \u2018Seagull Tango\u2019 en 2016, le Diab Quintet a gagn\u00e9 rapidement en maturit\u00e9 sur sc\u00e8ne. Jonathan De Neck, dans le r\u00f4le de leader, offre des m\u00e9lodies envo\u00fbtantes et des rythmes entra\u00eenants qui m\u00e9langent la musique folk, les musiques du monde, le jazz, la musique classique et l\u2019improvisation. Ses compositions sont mises en valeur par des arrangements subtils qui permettent \u00e0 chaque musicien de faire ressortir sa personnalit\u00e9.","performers":"Jonathan De Neck : compositions, accord\u00e9on diatonique, arrangements\r\nEsinam Dogbatse : fl\u00fbte, percussions, arrangements\r\nS\u00e9bastien Taminiau : violon, arrangements\r\nCorentin Dellicour : violoncelle, arrangements\r\nRui Salgado : contrebasse, arrangements","boxoffice_url":null,"website":"http:\/\/www.muziekpublique.be","email":"info@muziekpublique.be","phone_contact":null,"phone_booking":"+32 2 217 26 00","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.541057"},"nl":{"name":"Diab Quintet","shortdescr":"CD-Release \u2018Hurac\u00e1n\u2019","longdescr":"Het Diab Quintet is terug met een derde opus. Samen met zijn handlangers arrangeerde accordeonist Jonathan De Neck een eclectisch, hypnotiserend, intens repertoire aan eigen composities. Het nieuwe album \u201cHurac\u00e1n\u201d blaast als een melodieuze wervelwind waarin het diepe blauw van kalme wateren zich vermengt met het heldere rood van passioneel vuur.\r\n\r\nHet Diab Quintet zag zeven jaar geleden het levenslicht uit de nood om het universum van strijkers uit de klassieke muziek samen te brengen met diatonisch accordeon en percussie uit de traditionele muziek. Met twee albums op hun conto \u2018Anthills\u2019 (2013) en \u2018Seagull Tango\u2019 (2016), groeide het Diab Quintet uit tot een volwassen podiumact. Leider Jonathan De Neck schrijft beklijvende melodie\u00ebn en pakkende ritmes die traditionele muziek, jazz, klassiek muziek en improvisatie vermengen. De composities worden versterkt door subtiele arrangementen waarin elke muzikant zijn persoonlijkheid kan leggen.","performers":"Jonathan De Neck: composities, diatonische accordeon, arrangementen\r\nEsinam Dogbatse: fluit, percussie, arrangementen\r\nS\u00e9bastien Taminiau: viool, arrangementen\r\nCorentin Dellicour: cello, arrangementen\r\nRui Salgado: contrabas, arrangementen","boxoffice_url":null,"website":"http:\/\/www.muziekpublique.be","email":"info@muziekpublique.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.541057"},"en":{"name":"Diab Quintet","shortdescr":"CD-Release \u2018Hurac\u00e1n\u2019","longdescr":"The Diab Quintet is back, with a third opus. Based, as usual, on his own compositions, accordionist Jonathan De Neck and his accomplices have arranged an eclectic, hypnotizing and intense repertoire. We present you their new CD, \u00ab Hurac\u00e1n \u00bb, a melodic whirlpool that combines the profound blue color of still waters and the bright red of the fire that arouses them.\r\n\r\nThe Diab Quintet came to life seven years ago, from the desire to have the chords of so-called classical music meet the more folk and world music diatonic accordion and percussions. Having made two albums, \u2018Fourmili\u00e8res\u2019 in 2013 and \u2018Seagull Tango\u2019 in 2016, the group quickly gained stage maturity. Its leader, Jonathan De Neck, provides enchanting melodies and swinging rhythms that combine folk music, jazz, world music, classical music and improvisation. His compositions are enhanced by subtle arrangements that allow the personality of every musician to stand out.","performers":"Jonathan De Neck: compositions, diatonic accordion, arrangements\r\nEsinam Dogbatse: flute, percussions, arrangements\r\nS\u00e9bastien Taminiau: violin, arrangements\r\nCorentin Dellicour: cello, arrangements\r\nRui Salgado: bass, arrangements","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.541057"},"de":{"name":"Diab Quintet","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.541057"},"it":{"name":"Diab Quintet","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.541057"},"sp":{"name":"Diab Quintet","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.541057"},"pt":{"name":"Diab Quintet","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.541057"},"cn":{"name":"Diab Quintet","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.541057"}},"place":{"id":238099,"translations":{"fr":{"name":"Muziekpublique","address_street_name":"Galerie de la Porte de Namur","address_street_number":"3","address_street_box":null,"email":"info@muziekpublique.be","website":"http:\/\/www.muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":"+32 2 217 26 00","address_zip":"1050","address_city":"Ixelles","address_line1":"Galerie de la Porte de Namur, 3","address_line2":"1050 Ixelles","description_web":"Muziekpublique est le centre des musiques traditionnelles du monde de Bruxelles. Etablie dans le Th\u00e9\u00e2tre Moli\u00e8re au c\u0153ur du quartier africain, l\u2019asbl organise plus de 100 concerts par an et deux festivals (Hide & Seek Festival etc.). Par ailleurs Muziekpublique propose aussi 50 cours de musique et de danse du monde, comptant plus de 600 \u00e9l\u00e8ves. Ensuite, l\u2019asbl d\u00e9veloppe certains artistes et projets via son label, qui est aussi une agence de booking et de management. La musique traditionnelle a donc trouv\u00e9 un endroit id\u00e9al o\u00f9 se d\u00e9velopper et les artistes y constituent un r\u00e9seau vivant et dynamique cr\u00e9ant des liens de qualit\u00e9 avec le public. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Muziekpublique","address_street_name":"Galerij van de Naamsepoort","address_street_number":"3","address_street_box":null,"email":"info@muziekpublique.be","website":"http:\/\/www.muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":"+32 2 217 26 00","address_zip":"1050","address_city":"Elsene","address_line1":"Galerij van de Naamsepoort, 3","address_line2":"1050 Elsene","description_web":"Muziekpublique verspreidt en promoot muziek- en danstradities via een ambitieus programma van concerten, cursussen en projecten. Een jaarrond concertprogramma met Belgische en internationale artiesten vormt de kern van de activiteiten van de organisatie. Van contemplatieve tot feestelijke concerten vinden het hele jaar door plaats in het prachtige Moli\u00e8re Theater, aan de Naamsepoort, maar ook op verschillende plaatsen de hoofdstad.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Muziekpublique","address_street_name":"Galerie de la Porte de Namur","address_street_number":"3","address_street_box":null,"email":"info@muziekpublique.be","website":"http:\/\/www.muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":"+32 2 217 26 00","address_zip":"1050","address_city":"Ixelles","address_line1":"Galerie de la Porte de Namur, 3","address_line2":"1050 Ixelles","description_web":"Muziekpublique, keeps music and dance traditions alive and kicking in Brussels through an ambitious programme of concerts, courses, and projects. A year-round concert programme, featuring Belgian and international artists, forms the core of the foundation\u2019s activities. From the contemplative to the madly festive concerts take place indoors,  in the small Moli\u00e8re Theatre, in the arcade at the Porte de Namur and outdoors, around the city and throughout the year.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Muziekpublique","address_street_name":"Galerie de la Porte de Namur","address_street_number":"3","address_street_box":null,"email":"info@muziekpublique.be","website":"http:\/\/www.muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":"+32 2 217 26 00","address_zip":"1050","address_city":"Ixelles","address_line1":"Galerie de la Porte de Namur, 3","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Muziekpublique","address_street_name":"Galerie de la Porte de Namur","address_street_number":"3","address_street_box":null,"email":"info@muziekpublique.be","website":"http:\/\/www.muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":"+32 2 217 26 00","address_zip":"1050","address_city":"Ixelles","address_line1":"Galerie de la Porte de Namur, 3","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Muziekpublique","address_street_name":"Galerie de la Porte de Namur","address_street_number":"3","address_street_box":null,"email":"info@muziekpublique.be","website":"http:\/\/www.muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":"+32 2 217 26 00","address_zip"