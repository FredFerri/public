.brussels\/pt\/visitors\/agenda\/event-detail.5700005721"},"en":{"name":"Afterwork by Les Garces - Karaoke Extravaganza","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lesgarces.com","email":"gaetan@lesgarces.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700005721"},"it":{"name":"Afterwork by Les Garces - Karaoke Extravaganza","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lesgarces.com","email":"gaetan@lesgarces.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700005721"},"cn":{"name":"Afterwork by Les Garces - Karaoke Extravaganza","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lesgarces.com","email":"gaetan@lesgarces.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700005721"},"fr":{"name":"Afterwork by Les Garces - Karaoke Extravaganza","shortdescr":"Un Afterwork unique en son genre, m\u00ealant karaok\u00e9, performances drag et ambiance festive. Rejoignez Les Garces tous les jeudis pour une soir\u00e9e pleine d\u2019\u00e9nergie et de surprises.","longdescr":"D\u00e9couvrez un Afterwork pas comme les autres avec Les Garces lors de leur Karaoke Extravaganza. Chaque jeudi, laissez-vous emporter par une ambiance chaleureuse et d\u00e9jant\u00e9e, m\u00ealant karaok\u00e9 interactif, performances drag inoubliables, et une dose de bonne humeur pour bien terminer votre journ\u00e9e.\n\nHoraires :\nOuverture d\u00e8s portes : 17h30\nKaraok\u00e9 d\u00e8s 18h30\nHappy Hour 17:30 - 19:30\n\nL'entr\u00e9e est gratuite!\n\nQue vous soyez chanteur amateur ou simple spectateur, une chose est s\u00fbre : vos jeudis ne seront plus jamais les m\u00eames.","performers":"Natalia, Bianca l'Or, Miss Pam Ella"