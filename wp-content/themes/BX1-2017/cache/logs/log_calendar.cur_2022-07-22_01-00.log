l},"region":"brussels","last_updated_at":"2022-07-12T09:35:05+02:00","published_at":"2020-07-08T05:12:10+02:00","import_origin":null,"external_id":null,"is_in_address_book":false,"is_in_vb_export":false,"resto_ranking":0},"media":[{"type":"poster","link":"https:\/\/agendabrussels.imgix.net\/9493301a6a7506e09bb61c6c958ebfe923be634c.jpg","width":2048,"height":1536,"ratio":1.33,"translations":{"fr":{"title":"Kayak cleanup - Let's Mingle","copyright":null},"nl":{"title":"Kayak cleanup - Let's Mingle","copyright":null},"en":{"title":"Kayak cleanup - Let's Mingle","copyright":null}}}],"dates":[],"weekschema":[{"days":{"monday":{"is_open":false},"tuesday":{"is_open":false},"wednesday":{"is_open":false},"thursday":{"is_open":false},"friday":{"is_open":false},"saturday":{"is_open":false},"sunday":{"is_open":false}},"translations":{"fr":["lundi, mardi, mercredi, jeudi, vendredi, samedi et dimanche: ferm\u00e9"],"nl":["maandag, dinsdag, woensdag, donderdag, vrijdag, zaterdag en zondag: gesloten"],"en":["monday, tuesday, wednesday, thursday, friday, saturday and sunday: closed"]},"date_start":"2022-07-01","date_end":"2022-09-30","is_also_by_appointment":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":["exterior"],"is_part_of":"Summer in the City","accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-07-12T09:35:05+02:00","published_at":"2022-07-12T09:05:07+02:00","backoffice_id":258205,"import_origin":null,"sub_type":"sport","show_in_agenda":true,"ranking":0.22151546799152},{"id":518575,"date_start":"2021-10-09","date_end":"2022-12-10","date_next":"2022-10-15","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{"list":[105],"translations":{"fr":["Gastronomie"],"nl":["Gastronomie"],"en":["Gastronomy"]}}},"languages":{"spoken":["fr","en"],"subtitles":[]},"translations":{"fr":{"name":"ESPRESSO EXTRAVAGANZA Coffee Tour - Uptown Trinit\u00e9","shortdescr":"Be ready to discover and taste new wave espressos during this 3 hours tour in the Uptown Trinit\u00e9 Brussels area. Hosted in FR & EN.","longdescr":"LES COFFEE TOURS\r\nLe caf\u00e9 de sp\u00e9cialit\u00e9 est en plein d\u00e9veloppement \u00e0 Bruxelles, avec l'\u00e9mergence de nouveaux caf\u00e9s et d'initiatives comme la Brussels Coffee Week, mais aussi gr\u00e2ce \u00e0 l\u2019impl\u00e9mentation de grains de qualit\u00e9 dans de plus en plus de lieux HoReCa, \u00e9piceries etc. Le caf\u00e9 de sp\u00e9cialit\u00e9 reste malgr\u00e9 tout encore bien trop m\u00e9connu, il est temps d'explorer ce que la capitale de l'Europe a \u00e0 offrir.\r\n\r\nCes explorations caf\u00e9\u00efn\u00e9es de la ville sont aussi inhabituelles, amusantes qu\u2019instructives et correspondent \u00e0 un cours de base complet sur le caf\u00e9, le fun et la marche en plus.\r\n\r\nPOUR QUI\r\nLes Brussels Coffee Tours s'adressent \u00e0 tout le monde, avec un focus sur l\u2019exp\u00e9rience consommateur\/coffee lovers d\u00e9sireu.x.ses de mieux comprendre leur boisson favorite.\r\n\r\nIl convient \u00e9galement aux professionnel.le.s de l\u2019HoReCa qui encore souvent ignorent ce qu\u2019est le caf\u00e9 de sp\u00e9cialit\u00e9, les aidant ainsi \u00e0 comprendre le parent pauvre de leur secteur mais aussi \u00e0 mieux appr\u00e9hender l\u2019exp\u00e9rience client li\u00e9e au caf\u00e9.\r\n\r\nJe suis l\u00e0 pour aider et esp\u00e8re combler le foss\u00e9 entre les amateurs et les professionnels. Aucun pr\u00e9requis n'est n\u00e9cessaire \u00e0 ce tour.\r\n\r\nOBJECTIF\r\nLe but des Brussels Coffee Tours est de faire d\u00e9couvrir les lieux innovants lorsqu\u2019il est question de caf\u00e9 de sp\u00e9cialit\u00e9, mais aussi de d\u00e9couvrir et comprendre comment consommer \/ go\u00fbter le caf\u00e9 sur base de crit\u00e8res de qualit\u00e9 objectifs.\r\n\r\nComprendre la cha\u00eene de production du champ \u00e0 la tasse, la diff\u00e9rence entre caf\u00e9 de sp\u00e9cialit\u00e9 et caf\u00e9 de commodit\u00e9 et apprendre \u00e0 mieux acheter son caf\u00e9 sont \u00e9galement au c\u0153ur des objectifs des Coffee Tours.\r\n\r\nESPRESSO EXTRAVAGANZA, UN TOUR P\u00c9DAGOGIQUE ! - EDITION UPTOWN TRINIT\u00c9\r\nLors du - ESPRESSO EXTRAVAGANZA TOUR - , nous boirons exclusivement des espressos. Espressos pr\u00e9par\u00e9s dans diff\u00e9rents lieux innovants, par diff\u00e9rents baristas, avec des grains d'origine et de fermentation vari\u00e9es. L\u2019espresso n\u2019aura plus de secret pour vous, et vous arriverez enfin \u00e0 faire la diff\u00e9rence au niveau du go\u00fbt car vous serez accompagn\u00e9 pour apprendre \u00e0 bien \u00e9valuer votre boisson pr\u00e9f\u00e9r\u00e9e, le tout \u00e0 nos frais. Vous ne payez pas d'extra pour vos caf\u00e9s.\r\n\r\nLors de cette \u00e9dition UPTOWN TRINIT\u00c9, nous visitons 4 \u00e0 5 lieux dans le haut de Saint-Gilles.\r\n\r\nNous vous sensibiliserons au m\u00e9tier de BARISTA, \u00e0 la ma\u00eetrise de la th\u00e9orie de l\u2019extraction mais aussi de l\u2019hospitalit\u00e9, et aborderons diff\u00e9rents sujets tels que : les diff\u00e9rences de philosophies et les nouvelles vagues, les fermentations, les habitudes de consommation, le go\u00fbt, la qualit\u00e9, le caf\u00e9 de sp\u00e9cialit\u00e9 - avec un case study de transition commodit\u00e9\/sp\u00e9cialit\u00e9 en Sicile ! -, les labels, les styles de torr\u00e9faction etc\u2026 mais aussi les informations \u00e0 d\u00e9crypter sur les sachets de caf\u00e9 afin de mieux acheter et d\u00e9jouer le marketing global.\r\n\r\nN\u2019ayez crainte quant au niveau de caf\u00e9ine de ce tour car au final, nous ne buvons que de l\u2019Arabica, deux fois plus pauvre en caf\u00e9ine que le Robusta.\r\n\r\nGOOD TO KNOW\r\nLes tours se passent toujours en ext\u00e9rieur.\r\n\r\nNous marchons d'un endroit \u00e0 l'autre et jetons un \u0153il aux lieux, mais les groupes \u00e9tant grands par rapport \u00e0 la capacit\u00e9 des lieux, nous ne consommons pas assis \u00e0 l\u2019int\u00e9rieur.\r\n\r\nIl est pr\u00e9f\u00e9rable de se munir de chaussures confortables, de v\u00eatements CHAUDS en hiver (mieux vaut trop de couches que pas assez !!) et un parapluie en cas de pluie. De l\u2019eau est toujours recommand\u00e9e \u00e9galement. Masque et gel en temps de Covid.\r\n\r\nPetit d\u00e9jeunez avant la visite car nous n'avons pas le temps de manger lors des tours.\r\nPssst, rejoins-nous : INSTA @ok_coffee_tips\r\n\r\nVOTRE GUIDE\r\n\r\nThomas Wyngaard est fondateur de OK Coffee et un des rares experts en Caf\u00e9 de Sp\u00e9cialit\u00e9 en Belgique francophone. Il est consultant ind\u00e9pendant, enseignant (certifi\u00e9 par la Specialty Coffee Association de janvier 2018 \u00e0 avril 2021), tour-ist et broadcaster. Apr\u00e8s avoir \u00e9t\u00e9 form\u00e9 en France, en Pologne et en Estonie, il fait ses armes chez les meilleurs en Belgique, pour ensuite migrer pendant presque 2 ans \u00e0 New York o\u00f9 il a offici\u00e9 comme conseiller et formateur. Au-del\u00e0 de la formation sur les m\u00e9tiers du caf\u00e9, il collabore avec des torr\u00e9facteurs belges engag\u00e9s sur la reconnaissance du caf\u00e9 de sp\u00e9cialit\u00e9, \u0153uvrant ainsi \u00e0 un monde meilleur \u201cone bean at a time\u201d.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.okcoffee.tips","email":"thomas@okcoffee.tips","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/518575.html"},"nl":{"name":"ESPRESSO EXTRAVAGANZA Coffee Tour - Uptown Trinit\u00e9","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/518575.html"},"en":{"name":"ESPRESSO EXTRAVAGANZA Coffee Tour - Uptown Trinit\u00e9","shortdescr":null,"longdescr":"THE COFFEE TOURS\r\nSpecialty coffee is booming in Brussels, with the emergence of new coffee shops and initiatives like the Brussels Coffee Week, but also thanks to the implementation of quality beans in more and more HoReCa places, grocery stores etc. However, specialty coffee is still far too unknown. Now is the time to explore what the capital city of Europe has to offer.\r\n\r\nThese caffeinated explorations of the city are unusual, fun as they are highly informative, and match a complete coffee basics course, with an extra sprinkle of fun and walking.\r\n\r\nFOR WHO\r\nThe Brussels Coffee Tours are for everyone, with a focus on the consumer\/coffee lover experience to better understand your favorite beverage!\r\n\r\nIt is also suitable for HoReCa professionals who are often still unaware of what specialty coffee is, helping them to understand the poor relation of their sector but also to better understand the customer experience related to coffee.\r\n\r\nI'm here to help and hope to bridge the gap between the amateurs and the professionals. No prerequisites are necessary for this tour.\r\n\r\nOBJECTIVE\r\nThe goal of the Brussels Coffee Tours is to discover innovative places when it comes to specialty coffee, but also to discover and understand how to consume\/taste coffee based on objective quality criteria.\r\n\r\nUnderstanding the production chain from field to cup, the difference between specialty and commodity coffee, and learning how to better buy coffee are also central to the objectives of the Coffee Tours.\r\n\r\nESPRESSO EXTRAVAGANZA, AN EDUCATIONAL TOUR! - UPTOWN TRINIT\u00c9 EDITION\r\nDuring the - ESPRESSO EXTRAVAGANZA TOUR - , we will exclusively drink espressos. Espressos prepared in different innovative places, by different baristas, with beans of different origins and fermentation. Espresso will no longer hold any secrets for you, and you will finally be able to tell the difference in taste because you will be accompanied to learn how to properly evaluate your favorite drink, all at our expense. You don't pay extra for your coffees.\r\n\r\nDuring this UPTOWN TRINIT\u00c9 edition, we will visit 4 to 5 locations in the upper Saint-Gilles area.\r\n\r\nWe will bring awareness to you on the craft of BARISTA, mastering the theory of extraction but also hospitality service, and will discuss various topics such as: differences in philosophies and new waves, fermentations, consumption habits, taste, quality, specialty coffee - with a case study of commodity\/specialty transition in Sicily! -, labels, roasting styles etc... but also the information to decipher on coffee bags in order to buy better and thwart global marketing.\r\n\r\nDon't worry about the level of caffeine in this tour because in the end, we only drink Arabica, twice as low in caffeine as Robusta.\r\n\r\nGOOD TO KNOW\r\nThe tours always take place outdoors.\r\n\r\nWe walk from one place to another and have a look at the places, but the groups being large compared to the capacity of the places, we do not consume sitting inside.\r\n\r\nIt is best to bring comfortable shoes, WARM clothes in winter (better too many layers than not enough!!) and an umbrella in case of rain. Water is always recommended as well. Mask and gel in Covid times.\r\n\r\nHave breakfast beforehand because we don't have time to eat during the tours.\r\nPssst, join us: INSTA @ok_coffee_tips\r\n\r\n\r\nYOUR HOST \r\n\r\nThomas Wyngaard is the founder of OK Coffee and one of the few Specialty Coffee experts in French-speaking Belgium. He is an independent consultant, teacher (certified by the Specialty Coffee Association from January 2018 to April 2021), tour-ist and broadcaster. After training in France, Poland and Estonia, he worked with the best in Belgium, and then migrated for almost 2 years to New York where he served as a consultant and trainer. In addition to training in the coffee business, he collaborates with Belgian roasters committed to the recognition of specialty coffee, working towards a better world \"one bean at a time\".","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/518575.html"},"de":{"name":"ESPRESSO EXTRAVAGANZA Coffee Tour - Uptown Trinit\u00e9","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/518575.html"},"it":{"name":"ESPRESSO EXTRAVAGANZA Coffee Tour - Uptown Trinit\u00e9","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/518575.html"},"sp":{"name":"ESPRESSO EXTRAVAGANZA Coffee Tour - Uptown Trinit\u00e9","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/518575.html"},"pt":{"name":"ESPRESSO EXTRAVAGANZA Coffee Tour - Uptown Trinit\u00e9","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/518575.html"},"cn":{"name":"ESPRESSO EXTRAVAGANZA Coffee Tour - Uptown Trinit\u00e9","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/518575.html"}},"place":{"id":277407,"translations":{"fr":{"name":"Vleurgat > Ma Campagne","address_street