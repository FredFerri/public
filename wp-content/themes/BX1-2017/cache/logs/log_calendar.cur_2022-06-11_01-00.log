ay":"2022-06-10","doors":null,"start":"14:00:00","end":"18:00:00"},{"day":"2022-06-11","doors":null,"start":"14:00:00","end":"18:00:00"},{"day":"2022-06-16","doors":null,"start":"14:00:00","end":"18:00:00"},{"day":"2022-06-17","doors":null,"start":"14:00:00","end":"18:00:00"},{"day":"2022-06-18","doors":null,"start":"14:00:00","end":"18:00:00"},{"day":"2022-06-23","doors":null,"start":"14:00:00","end":"18:00:00"},{"day":"2022-06-24","doors":null,"start":"14:00:00","end":"18:00:00"},{"day":"2022-06-25","doors":null,"start":"14:00:00","end":"18:00:00"}],"weekschema":[{"days":{"monday":{"is_open":false},"tuesday":{"is_open":false},"wednesday":{"is_open":false},"thursday":{"is_open":true,"hours":[{"start":"14:00:00","end":"18:00:00"}]},"friday":{"is_open":true,"hours":[{"start":"14:00:00","end":"18:00:00"}]},"saturday":{"is_open":true,"hours":[{"start":"14:00:00","end":"18:00:00"}]},"sunday":{"is_open":false}},"translations":{"fr":["lundi, mardi, mercredi et dimanche: ferm\u00e9","jeudi, vendredi et samedi: de 14:00 \u00e0 18:00"],"nl":["maandag, dinsdag, woensdag en zondag: gesloten","donderdag, vrijdag en zaterdag: van 14:00 tot 18:00"],"en":["monday, tuesday, wednesday and sunday: closed","thursday, friday and saturday: from 14:00 to 18:00"]},"date_start":"2022-06-02","date_end":"2022-06-25","is_also_by_appointment":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":0}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-06-10T01:37:00+02:00","published_at":"2022-05-17T11:53:41+02:00","backoffice_id":253823,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.43679023236815},{"id":531221,"date_start":"2022-05-12","date_end":"2022-06-25","date_next":"2022-06-10","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[24,30],"translations":{"fr":["Galeries d'art","Peinture"],"nl":["Galeries","Schilderkunst"],"en":["Art Galleries","Painting"]}}},"languages":{"spoken":["fr","nl","en","es"],"subtitles":[]},"translations":{"fr":{"name":"Ariane de Rosmorduc - Tumbleweed","shortdescr":"Ariane de Rosmorduc  reprend plaisir \u00e0 la terre ferme.\r\nTUMBLEWEED est le titre de sa nouvelle exposition.\r\nLes tumbleweeds, sont des boules v\u00e9g\u00e9tales l\u00e9g\u00e8res qui une fois ass\u00e9ch\u00e9es, se d\u00e9tachent de leur racine et roulent au gr\u00e9 du vent.\r\nAriane ne perd pas le fil, quand il s'agit d'interpr\u00e9ter ce ph\u00e9nom\u00e8ne en une m\u00e9taphore \r\ncontemporaine sur le sort d'une partie de l'humanit\u00e9.","longdescr":"Apr\u00e8s avoir c\u00e9l\u00e9br\u00e9 les myst\u00e8res et fantasmagories d'un monde sous-marin imaginaire, Ariane \r\nde Rosmorduc (Bruxelles, 1967) reprend plaisir \u00e0 la terre ferme.\r\nTUMBLEWEED est le titre de sa nouvelle exposition.\r\nLes tumbleweeds, typiques des d\u00e9serts de l'ouest am\u00e9ricain, sont des boules v\u00e9g\u00e9tales touffues \r\net l\u00e9g\u00e8res qui une fois ass\u00e9ch\u00e9es, se d\u00e9tachent de leur racine et roulent au gr\u00e9 du vent. Les \r\nwesterns et les m\u00e9dias visuels ont conduit \u00e0 une signification symbolique de cette plante \r\nmyst\u00e9rieuse qui s'agite et tourne sur elle-m\u00eame en toute l\u00e9g\u00e8ret\u00e9, dans des lieux d\u00e9sol\u00e9s, vid\u00e9s \r\nde leurs occupants.\r\nAriane ne perd pas le fil, quand il s'agit d'interpr\u00e9ter ce ph\u00e9nom\u00e8ne en une m\u00e9taphore \r\ncontemporaine sur le sort d'une partie de l'humanit\u00e9. Cette migration v\u00e9g\u00e9tale, l'artiste la \r\nsublime par des nuances chromatiques tr\u00e8s riches et par un travail de la mati\u00e8re \u00e9poustouflant. \r\nCes vibrations mati\u00e8re\/couleur jouent dans l'espace de la toile au point d'y insuffler le \r\nmouvement provoquant ainsi, la fuite en avant du \"virevoltant\"","performers":"Ariane de Rosmorduc","boxoffice_url":null,"website":"http:\/\/www.zedes-art-gallery.be","email":"zedes.art.gallery@gmail.com","phone_contact":"+32 2 646 00 04","phone_booking":"+32 2 646 00 04","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/531221.html"},"nl":{"name":"Ariane de Rosmorduc - Tumbleweed","shortdescr":null,"longdescr":"Na het vieren van mysteries en fantasmagorie van de onderwaterwereld, Ariane de Rosmorduc\r\n(Brussel, 1967) keert terug op de aarde.\r\nTUMBLEWEED is de titel van haar nieuwe tentoonstelling.\r\nTumbleweeds zijn typische planten van de woestijnen in het Westen America. Het zijn vegetal\r\nballen die eenmaal gedroogd, lost komen van hun wortels en meerollen met de wind. Westerns\r\nen visuele media hebben geleid tot een symbolische betekenis van deze mysterieuze plant dat\r\nzich in alle lichtheid, op verlaten en lege plaatsen beweegt en ronddraaien.\r\nAriane verliest de draad niet, als het gaat om het interpreteren van dit fenomeen in een\r\nhedendaagse metafoor over het lot van een deel van de mensheid. Deze plantenmigratie is\r\ngesublimeerd door de kunstenares door zeer rijke chromatische nuances en door een\r\nadembenemend materiaalwerk. Deze materie\/kleuren spelen in de ruimte van het doek tot het\r\npunt dat er een soort beweging in wordt geademd en zo een halsstarrige rush van de\r\n\"wervelende plant\" veroorzaakt.","performers":null,"boxoffice_url":null,"website":null,"email":"zedes.art.gallery@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/531221.html"},"en":{"name":"Ariane de Rosmorduc - Tumbleweed","shortdescr":null,"longdescr":"","performers":null,"boxoffice_url":null,"website":null,"email":"zedes.art.gallery@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/531221.html"},"de":{"name":"Ariane de Rosmorduc - Tumbleweed","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/531221.html"},"it":{"name":"Ariane de Rosmorduc - Tumbleweed","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/531221.html"},"sp":{"name":"Ariane de Rosmorduc - Tumbleweed","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/531221.html"},"pt":{"name":"Ariane de Rosmorduc - Tumbleweed","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/531221.html"},"cn":{"name":"Ariane de Rosmorduc - Tumbleweed","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/531221.html"}},"place":{"id":260455,"translations":{"fr":{"name":"zedes art gallery","address_street_name":"Rue Paul Lauters","address_street_number":"36","address_street_box":null,"email":"zedes.art.gallery@gmail.com","website":"http:\/\/www.zedes-art-gallery.be","phone_contact":"+32 475 52 62 58","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Paul Lauters, 36","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_ur