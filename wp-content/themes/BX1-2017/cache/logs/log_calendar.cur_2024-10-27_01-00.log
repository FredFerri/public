s_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":305031,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"theatre","ranking":0.20080646033694594,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":49,"translations":{"de":"Theater","pt":null,"en":"Theatre","it":"Teatro","cn":null,"fr":"Th\u00e9\u00e2tre","sp":"Teatro","nl":"Theater"}},"others":{"list":[52],"translations":{"de":["Musiktheater"],"pt":[null],"en":["Musical theatre"],"it":["Teatro musicale"],"cn":[null],"fr":["Th\u00e9\u00e2tre musical"],"sp":["Teatro musical"],"nl":["Muziektheater"]}}},"translations":{"de":{"name":"\u00ab Premiers pas \u00e0 l\u2019Op\u00e9ra \u00bb : Animop\u00e9ra","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/soprane.be\/recommends\/animopera-agenda","email":"info@soprane.be","phone_contact":"+32 471 66 05 18","phone_booking":"+32 471 66 05 18","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50013141"},"pt":{"name":"\u00ab Premiers pas \u00e0 l\u2019Op\u00e9ra \u00bb : Animop\u00e9ra","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/soprane.be\/recommends\/animopera-agenda","email":"info@soprane.be","phone_contact":"+32 471 66 05 18","phone_booking":"+32 471 66 05 18","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50013141"},"en":{"name":"\u00ab Premiers pas \u00e0 l\u2019Op\u00e9ra \u00bb : Animop\u00e9ra","shortdescr":"Animop\u00e9ra, a musical show about animals in opera for all the family","longdescr":"Concert-show on animals in opera for all the family (4+).\nAnimopera is a concert-show in the \"First Steps in Opera\" project, designed as an introduction to opera and operetta especially for children. A plunge into the bestiary of the operatic world: arias by cats, dogs, ducks, donkeys, flies and more, written by Rossini, Mozart, Bazin, Messager and Offenbach and sung by a soprano and a baritone. Rediscover the magic of childhood, when animals still populate the world of little ones as they learn to see, speak and read...\nwww.soprane.be\/animopera","performers":"Creation, singing (soprano), production: Olga Dubois\nCreation, singing (baritone), dramaturgy, choreography: Jean-Luc Yerl\u00e8s\nPianists: Anait Karpova, Ines Defuster\nStage direction: Isabelle Dumont\nOpera consultant: Alexandre Maslennikov-Swistounoff\nScenography: Jaroslav Albert","boxoffice_url":null,"website":"https:\/\/soprane.be\/recommends\/animopera-agenda","email":"info@soprane.be","phone_contact":"+32 471 66 05 18","phone_booking":"+32 471 66 05 18","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50013141"},"it":{"name":"\u00ab Premiers pas \u00e0 l\u2019Op\u00e9ra \u00bb : Animop\u00e9ra","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/soprane.be\/recommends\/animopera-agenda","email":"info@soprane.be","phone_contact":"+32 471 66 05 18","phone_booking":"+32 471 66 05 18","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50013141"},"cn":{"name":"\u00ab Premiers pas \u00e0 l\u2019Op\u00e9ra \u00bb : Animop\u00e9ra","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/soprane.be\/recommends\/animopera-agenda","email":"info@soprane.be","phone_contact":"+32 471 66 05 18","phone_booking":"+32 471 66 05 18","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50013141"},"fr":{"name":"\u00ab Premiers pas \u00e0 l\u2019Op\u00e9ra \u00bb : Animop\u00e9ra","shortdescr":"Animop\u00e9ra, un spectacle musical sur les animaux dans l'op\u00e9ra pour toute la famille","longdescr":"Concert-spectacle sur les animaux dans l\u2019op\u00e9ra pour toute la famille (4+).\nAnimopera est un concert-spectacle du projet \u00ab Premiers pas \u00e0 l\u2019Op\u00e9ra \u00bb qui se veut \u00eatre une introduction \u00e0 l\u2019op\u00e9ra et \u00e0 l\u2019op\u00e9rette sp\u00e9cialement destin\u00e9e aux enfants. Une plong\u00e9e dans le bestiaire du monde de l\u2019op\u00e9ra : des arias de chats, de chiens, de canards, d\u2019\u00e2nes, de mouches etc. \u00e9crits par Rossini, Mozart, Bazin, Messager, Offenbach et chant\u00e9s par une soprane et un baryton. Retrouver cette magie de l\u2019enfance o\u00f9 l\u2019animal peuple encore le monde des petits lorsqu\u2019ils apprennent \u00e0 voir, \u00e0 parler et \u00e0 lire\u2026\nwww.soprane.be\/animopera","performers":"Cr\u00e9ation, chant (soprano), production : Olga Dubois\nCr\u00e9ation, chant (baryton), dramaturgie, chor\u00e9graphie : Jean-Luc Yerl\u00e8s\nPianiste : Anait Karpova, Ines Defuster\nMise en sc\u00e8ne : Isabelle Dumont\nConseiller art lyrique : Alexandre Maslennikov-Swistounoff \nSc\u00e9nographie: Jaroslav Albert","boxoffice_url":null,"website":"https:\/\/soprane.be\/recommends\/animopera-agenda","email":"info@soprane.be","phone_contact":"+32 471 66 05 18","phone_booking":"+32 471 66 05 18","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50013141"},"sp":{"name":"\u00ab Premiers pas \u00e0 l\u2019Op\u00e9ra \u00bb : Animop\u00e9ra","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/soprane.be\/recommends\/animopera-agenda","email":"info@soprane.be","phone_contact":"+32 471 66 05 18","phone_booking":"+32 471 66 05 18","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50013141"},"nl":{"name":"\u00ab Premiers pas \u00e0 l\u2019Op\u00e9ra \u00bb : Animop\u00e9ra","shortdescr":"Animop\u00e9ra, een muzikale show over dieren in de opera voor het hele gezin","longdescr":"Concertvoorstelling over dieren in de opera voor het hele gezin (4+).\nAnimop\u00e9ra is een concertvoorstelling in het kader van het project \"Eerste stappen in de opera\", bedoeld als kennismaking met opera en operette speciaal voor kinderen. Een duik in het bestiarium van de operawereld: aria's van katten, honden, eenden, ezels, vliegen en meer, geschreven door Rossini, Mozart, Bazin, Messager en Offenbach en gezongen door een sopraan en een bariton. Herontdek de magie van de kindertijd, wanneer dieren nog steeds de wereld van de kleintjes bevolken terwijl ze leren zien, spreken en lezen...\nwww.soprane.be\/animopera","performers":"Creation, zang (sopraan), productie: Olga Dubois\nCreation, zang (bariton), dramaturgie, choreografie: Jean-Luc Yerl\u00e8s\nPianisten: Anait Karpova, Ines Defuster\nRegie: Isabelle Dumont\nAdviseur tekstkunsten: Alexandre Maslennikov-Swistounoff \nDecorontwerp: Jaroslav Albert","boxoffice_url":null,"website":"https:\/\/soprane.be\/recommends\/animopera-agenda","email":"info@soprane.be","phone_contact":"+32 471 66 05 18","phone_booking":"+32 471 66 05 18","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50013141"}},"place":{"id":266374,"translations":{"de":{"name":"La Ferme Rose - Maison des Cultures - Uccle","address_street_name":"Avenue De Fr\u00e9","address_street_number":"44","address_street_box":null,"email":"lafermerose.asbl@gmail.com","website":"https:\/\/lafermerose-uccle.be\/","phone_contact":"+32 2 375 71 01","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Avenue De Fr\u00e9, 44","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"La Ferme Rose - Maison des Cultures - Uccle","address_street_name":"Avenue De Fr\u00e9","address_street_number":"44","address_street_box":null,"email":"lafermerose.asbl@gmail.com","website":"https:\/\/lafermerose-uccle.be\/","phone_contact":"+32 2 375 71 01","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Avenue De Fr\u00e9, 44","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"vi