list":[30,24],"translations":{"de":["Malerei","Kunstgalerien"],"pt":[null,null],"en":["Painting","Art Galleries"],"it":["Pittura","Gallerie d'arte"],"cn":[null,null],"fr":["Peinture","Galeries d'art"],"sp":["Pintura","Galer\u00edas de arte"],"nl":["Schilderkunst","Galeries"]}}},"translations":{"de":{"name":"Charles le Maire","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.zedes-art-gallery.be","email":"zedes.art.gallery@gmail.com","phone_contact":"+32 475 52 62 58","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50007292"},"pt":{"name":"Charles le Maire","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.zedes-art-gallery.be","email":"zedes.art.gallery@gmail.com","phone_contact":"+32 475 52 62 58","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50007292"},"en":{"name":"Charles le Maire","shortdescr":null,"longdescr":"Charles le Maire likes to work in a square format, where composition and colour are\ninseparable and interdependent. Diluting, mixing, superimposing, hollowing out or\nspreading out the pictorial material ; the act of painting is ultimately about making one\ngesture after another and thus revealing the properties of the material.\u00a0Working on\nthese fundamentals of the medium means finding an unlimited field of exploration, a\nspace of non-mastery and discovering that the material brings to the work nuances\nand shapes impossible to imagine beforehand. Charles le Maire favours a reduced\nvocabulary that produces clear compositions and highlights details.\u00a0His relaxed style\nproduces vibrant ripples at the edges of the contours, distancing the geometric forms\nfrom the regularity we expect of them.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.zedes-art-gallery.be","email":"zedes.art.gallery@gmail.com","phone_contact":"+32 475 52 62 58","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50007292"},"it":{"name":"Charles le Maire","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.zedes-art-gallery.be","email":"zedes.art.gallery@gmail.com","phone_contact":"+32 475 52 62 58","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50007292"},"cn":{"name":"Charles le Maire","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.zedes-art-gallery.be","email":"zedes.art.gallery@gmail.com","phone_contact":"+32 475 52 62 58","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50007292"},"fr":{"name":"Charles le Maire","shortdescr":null,"longdescr":"Charles le Maire aime travailler le format carr\u00e9 dans lequel la  composition et la couleur sont indissociables et interd\u00e9pendantes.\nDiluer, m\u00e9langer, superposer, creuser ou \u00e9taler la mati\u00e8re picturale ; l'acte de  peindre c\u2019est finalement poser un geste apr\u00e8s l\u2019autre et r\u00e9v\u00e9ler ainsi les propri\u00e9t\u00e9s de la mati\u00e8re.Travailler ces fondamentaux du m\u00e9dium, c\u2019est trouver un champ d\u2019exploration illimit\u00e9, un espace de non-ma\u00eetrise et d\u00e9couvrir que la mati\u00e8re apporte \u00e0 l'\u0153uvre des nuances et des formes impossibles \u00e0 imaginer au pr\u00e9alable.\nCharles le Maire privil\u00e9gie  un vocabulaire r\u00e9duit  qui permet d'obtenir des compositions claires et de mettre les d\u00e9tails en \u00e9vidence. \nSa facture rel\u00e2ch\u00e9e produit de vibrantes ondulations aux limites des contours et \u00e9loignant ainsi les formes g\u00e9om\u00e9triques de la r\u00e9gularit\u00e9 que l\u2019on attendait d\u2019elles.","performers":"Charles de Maire","boxoffice_url":null,"website":"http:\/\/www.zedes-art-gallery.be","email":"zedes.art.gallery@gmail.com","phone_contact":"+32 475 52 62 58","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50007292"},"sp":{"name":"Charles le Maire","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.zedes-art-gallery.be","email":"zedes.art.gallery@gmail.com","phone_contact":"+32 475 52 62 58","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50007292"},"nl":{"name":"Charles le Maire","shortdescr":null,"longdescr":"Charles le Maire werkt graag in een vierkantige formaat, waarbij compositie en kleur\nonlosmakelijk met elkaar verbonden en van elkaar afhankelijk zijn. Verdunnen,\nmengen, op elkaar leggen, uithollen of uitspreiden van het picturale materiaal ; de\nhandeling van het schilderen is uiteindelijk het maken van het ene gebaar na het\nandere en zo de eigenschappen van het materiaal onthullen. Werken met deze\nfundamenten van het medium betekent een onbegrensd gebied van exploratie\nvinden, een ruimte van niet-meesterschap en ontdekken dat het materiaal nuances\nen vormen in het werk brengt die van tevoren onmogelijk waren voor te stellen.\nCharles le Maire geeft de voorkeur aan een beperkt woordenschat dat heldere\ncomposities oplevert en details benadrukt. Zijn ontspannen stijl produceert levendige\nrimpelingen aan de randen van de contouren, waardoor de geometrische vormen\nworden losgemaakt van de regelmaat die we ervan verwachten.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.zedes-art-gallery.be","email":"zedes.art.gallery@gmail.com","phone_contact":"+32 475 52 62 58","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50007292"}},"place":{"id":260455,"translations":{"de":{"name":"zedes art gallery","address_street_name":"Rue Paul Lauters","address_street_number":"36","address_street_box":null,"email":"zedes.art.gallery@gmail.com","website":"http:\/\/www.zedes-art-gallery.be","phone_