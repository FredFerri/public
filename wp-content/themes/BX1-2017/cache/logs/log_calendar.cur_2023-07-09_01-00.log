2023-06-12T12:29:32+02:00","backoffice_id":279224,"import_origin":null,"sub_type":"other","show_in_agenda":true,"ranking":0.5},{"id":554650,"date_start":"2023-06-17","date_end":"2023-07-15","date_next":"2023-07-08","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":true,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen","it":"Visite guidate","sp":"Visitas guiadas","pt":null,"cn":null}},"others":{"list":[108],"translations":{"fr":["Folklore"],"nl":["Folklore"],"en":["Folklore"],"de":["Folklore"],"it":["Folklore"],"sp":["Folclore"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Us et coutumes de la Renaissance: focus sur la Maison du Roi","shortdescr":"Il \u00e9tait une fois une halle au pain qui devenue maison du Roi s'est m\u00e9tamorphos\u00e9e en mus\u00e9e. Une fa\u00e7ade de dentelles cache des secrets d'architecture, des symboles de l'histoire de la ville, de la pr\u00e9sence ducale. Suivez le guide pour d\u00e9couvrir son histoire!","longdescr":"Il \u00e9tait une fois une halle au pain qui devenue maison du Roi s'est m\u00e9tamorphos\u00e9e en mus\u00e9e. Une fa\u00e7ade de dentelles cache des secrets d'architecture, des symboles de l'histoire de la ville, de la pr\u00e9sence ducale. A l'int\u00e9rieur, des maquettes, des statues en bronze, en bois, des vieilles pierres, des retables, des peintures qui se d\u00e9voilent au visiteur plus acharn\u00e9. Quand  la maison du Roi parle d'elle, l'histoire, les quartiers de Bruxelles s'\u00e9clairent et se montrent autrement. Des surprises, elle en abrite!  \r\n\r\nVisite privative, sur mesure et \u00e0 la demande\r\nPossibilit\u00e9 d\u2019inclure la visite de la Maison du Roi en suppl\u00e9ment","performers":null,"boxoffice_url":null,"website":"http:\/\/www.itineraires.be","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.554650"},"nl":{"name":"Gebruiken en gewoonten uit de renaissance: het Broodhuis in de kijker","shortdescr":"Er was eens een broodhal waar de koning zijn intrek nam en die uitgroeide tot het museum van de stad. Achter de gevel, een kantwerk in steen, gaan architecturale geheimen, geschiedkundige symbolen en sporen van een hertogelijk hof schuil. Volg de gids om zijn geschiedenis te ontdekken","longdescr":"Er was eens een broodhal waar de koning zijn intrek nam en die uitgroeide tot het museum van de stad. Achter de gevel, een kantwerk in steen, gaan architecturale geheimen, geschiedkundige symbolen en sporen van een hertogelijk hof schuil. Binnen kunnen geboeide bezoekers tal van maquettes, bronzen en houten beel- den, oude stenen, retabels en schilderijen bewonderen. Als het Broodhuis van zich laat spreken, licht de geschiedenis op en tonen de wijken van Brussel zich van een andere kant. Het pand heeft heel wat verrassende hoekjes!\r\n\r\nPriv\u00e9bezoek, georganiseerd op aanvraag en op maat\r\nMogelijkheid om het bezoek aan het Broodhuis als extra te boeken","performers":null,"boxoffice_url":null,"website":"http:\/\/www.itineraires.be","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.554650"},"en":{"name":"Customs and habits of the Renaissance: Focus on the Maison du Roi","shortdescr":"Once upon a time there was a bakery that became the House of the King and eventually turned into a museum. Its lacy fa\u00e7ade hides architectural secrets, symbols of the city\u2019s history and the presence of the Duke. Follow the guide to discover its stories!","longdescr":"Once upon a time there was a bakery that became the House of the King and eventually turned into a museum. Its lacy fa\u00e7ade hides architectural secrets, symbols of the city\u2019s history and the presence of the Duke. Inside are models, statues in bronze and wood, old stones, altarpieces and paintings that reveal themselves to the most determined visitor. When the House of the King speaks of history, the past and neighbourhoods of Brussels shine in a different and bri- ghter light. It really does have some surprises in store!\r\n\r\nPrivate visit, organized on demand\r\nPossibility to include the visit of the Maison du Roi as an extra","performers":null,"boxoffice_url":null,"website":"http:\/\/www.itineraires.be","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.554650"},"de":{"name":"Us et coutumes de la Renaissance: focus sur la Maison du Roi","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.itineraires.be","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.554650"},"it":{"name":"Us et coutumes de la Renaissance: focus sur la Maison du Roi","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.itineraires.be","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.554650"},"sp":{"name":"Usos y costumbres del Renacimiento: enfoque en la Maison du Roi","shortdescr":null,"longdescr":"\u00c9rase una vez una panader\u00eda que se convirti\u00f3 en casa de rey y luego en museo, con una fachada de encaje que esconde secretos arquitect\u00f3nicos, s\u00edmbolos de la historia de la ciudad y restos de la presencia ducal. El visitante m\u00e1s perseverante podr\u00e1 maravillarse con maquetas, estatuas de bronce y madera, piedras antiguas, retablos y pinturas que se exponen en su interior. Cuando se empieza a conocer la historia de la Maison du Roi, los barrios de Bruselas ya no se guardan ning\u00fan secreto y se empiezan a percibir de otra manera. \u00a1Est\u00e1n llenos de sorpresas!","performers":null,"boxoffice_url":null,"website":"http:\/\/www.itineraires.be","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.554650"},"pt":{"name":"Us et coutumes de la Renaissance: focus sur la Maison du Roi","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.itineraires.be","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.554650"},"cn":{"name":"Us et coutumes de la Renaissance: focus sur la Maison du Roi","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.itineraires.be","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.554650"}},"place":{"id":3743,"translations":{"fr":{"name":"Grand-Place","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"Souvent consid\u00e9r\u00e9e comme la plus belle du monde, la r\u00e9putation de la Grand-Place de Bruxelles n\u2019est plus \u00e0 \u00e9tablir !  \r\n \r\nAujourd\u2019hui encore, elle conserve une fonction politico-administrative en accueillant l\u2019H\u00f4tel de Ville de Bruxelles, qui demeure le lieu de travail du bourgmestre et de la plupart des \u00e9chevins.  \r\n \r\nEn tant que lieu de prestige, elle h\u00e9berge de nombreux \u00e9v\u00e9nements festifs \u2014 concerts, foires, manifestations folkloriques, sapin et cr\u00e8che de No\u00ebl, son et lumi\u00e8re, tapis de fleurs en \u00e9t\u00e9, etc. \u2014 ou symboliques, comme par ex. la r\u00e9ception de sportifs suite \u00e0 leurs performances.  \r\n \r\nSon histoire commence en tant que lieu de march\u00e9 au 12e si\u00e8cle. Progressivement, la place se garnit de maisons et de halles, encore principalement en bois. Le splendide H\u00f4tel de Ville gothique est construit au 15e si\u00e8cle en trois phases ; ce m\u00eame 15e si\u00e8cle voit l\u2019installation des corporations de m\u00e9tiers dans les maisons bordant la Grand-Place. Plus encore qu\u2019actuellement, la place est le centre n\u00e9vralgique de la vie bruxelloise : sur le plan \u00e9conomique donc, comme d\u00e9j\u00e0 mentionn\u00e9, avec une intense activit\u00e9 de vente (plusieurs halles consacr\u00e9es \u00e0 la vente du pain \u2014 actuelle Maison du Roi ou Broodhuis en n\u00e9erlandais \u2014, de la viande, des draps, etc.), sur le plan culturel (repr\u00e9sentations th\u00e9\u00e2trales), sur le plan judiciaire (avec des ex\u00e9cutions qui ont lieu sur la place), et \u00e9videmment sur le plan de la politique locale.  \r\n \r\nSujette \u00e0 un bombardement par les troupes de Louis XIV en 1695, elle est presque enti\u00e8rement reconstruite \u00e0 cette occasion. Elle subit encore d\u2019importantes r\u00e9novations et modifications durant les si\u00e8cles suivants, et ce surtout au 19e si\u00e8cle, pour lui conf\u00e9rer son aspect actuel.  \r\n \r\nLa Grand-Place de Bruxelles est inscrite sur la liste du patrimoine mondial de l\u2019UNESCO depuis 1998. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Grote Markt","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Grote Markt","address_line2":"1000 Brussel","description_web":"De Brusselse Grote Markt, die te boek staat als een van de mooiste pleinen ter wereld, is een must-see op het toeristische trekpleisterlijstje.  \r\n \r\nDoor de aanwezigheid van het stadhuis van Brussel heeft het plein ook nog steeds een politieke en administratieve functie: de burgemeester en de meeste schepenen werken hier.  \r\n\r\nHet is ook een plek die aanzien uitstraalt. Getuige daarvan zijn de vele plechtige, feestelijke of symbolische evenementen die er plaatsvinden: concerten, braderie\u00ebn, volksfeesten, de jaarlijkse kerstboom en -kribbe, klank- en lichtspelen, het bloementapijt in de zomer en de huldiging van sporters na een uitzonderlijke prestatie (denk bijvoorbeeld aan het WK voetbal in 2018). \r\n\r\nDe geschiedenis van de Grote Markt als 'marktplaats' gaat terug tot de twaalfde eeuw. Na verloop van tijd werden rondom het plein huizen en hallen opgetrokken, voornamelijk van hout. De bouw van het prachtige gotische stadhuis in de vijftiende eeuw verliep in drie fasen. Vanaf die periode zouden ook de gildehuizen het uitzicht van de Grote Markt mee bepalen. Meer nog dan vandaag was de Grote Markt in die tijd het kloppende hart van de stad, op economisch, cultureel en gerechtelijk vlak. Zo werd er duchtig handel gedreven (in de hallen gingen brood \u2013 het huidige Broodhuis \u2013 vlees, stoffen enzovoort over de toonbank), kon je op het plein theatervoorstellingen bijwonen en vonden er openbare terechtstellingen plaats. Het was uiteraard ook de plek waar het lokale beleid werd uitgetekend. \r\n\r\nNa een bombardement door de troepen van Lodewijk XIV in 1695 werd de Grote Markt zo goed als volledig heropgebouwd. Tijdens de eeuwen daarna ondergingen nog heel wat gebouwen grootschalige renovaties en aanpassingen. Vooral in de negentiende eeuw werd het plein in zijn huidige gedaante vastgelegd. \r\n\r\nDe Grote Markt van Brussel staat sinds 1998 op de Werelderfgoedlijst van de Unesco. \r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Grand-Place","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Grand-Place","address_line2":"1000 Brussels","description_web":"Often considered the most beautiful square in the world, the Grand-Place of Brussels' reputation precedes it!  \r\n \r\nToday, it still has a political and administrative function as it houses the City of Brussels Town Hall, which remains the workplace of the mayor and most of their aldermen.  \r\n \r\nAs a prestigious venue, it hosts many festive events - concerts, fairs, folklore events, the Christmas tree and nativity scene, sound and light shows, the flower carpet in the summer, etc. - or symbolic events, such as the celebration of sportsmen and women after fine performances.  \r\n \r\nIts story began as a market square in the 12th century. Gradually, the square was filled with houses and halls, then primarily made of wood. The splendid Gothic town hall was built in the 15th century in three phases; the same 15th century saw the installation of trade guilds in the houses that border the Grand-Place. Even more so than at present, the square was the nerve centre of Brussels life: economically, as already mentioned, with intense sales activity (several halls devoted to the sale of bread - the present King's House or Broodhuis in Dutch -, meat, linen, etc.), culturally (theatrical performances), judicially (with executions taking place on the square) and, of course, local politics.  \r\n \r\nIt was bombarded by Louis XIV's troops in 1695 and was subsequently almost entirely rebuilt. It underwent further major renovations and modifications during the following centuries, especially in the 19th century, which gave it its current appearance.  \r\n \r\nThe Grand-Place of Brussels has been a UNESCO World Heritage Site since 1998. \r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Grand-Place","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"Der Grand-Place in Br\u00fcssel z\u00e4hlt zum UNESCO-Weltkulturerbe und gilt als einer der sch\u00f6nsten Pl\u00e4tze der Welt.\r\n\r\nArchitektonische Perlen: Hier l\u00e4sst sich eine \u00e4u\u00dferst gelungene Mischung verschiedener architektonischer Stilrichtungen bewundern, charakteristisch f\u00fcr die Kultur und die Gesellschaft einer wohlhabenden, nordeurop\u00e4ischen Stadt. Eingerahmt wird der Grand-Place von majest\u00e4tischen Zunfth\u00e4usern, die \u00fcberwiegend aus dem 17. Jahrhundert stammen. Das Rathaus von Br\u00fcssel, das Anfang des 15. Jahrhunderts (1402) erbaut wurde, dominiert das architektonische Gesamtbild.\r\n\r\nSpektakul\u00e4re Veranstaltungen auf dem Grand-Place: Der Grand-Place wird regelm\u00e4\u00dfig Schauplatz verschiedener Gro\u00dfereignisse, darunter das mittelalterliche Spektakel Ommegang und der ber\u00fchmte Blumenteppich, bei dem der gesamte Platz mit einem riesigen Blumenmeer ausgelegt wird\r\n\r\nSie befinden sich \u00fcbrigens in bester Gesellschaft, denn schon Schriftsteller wie Baudelaire und Victor Hugo und sogar Karl Marx verfielen dem Charme des Grand-Place. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Grand-Place","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"La costruzione della Grand-Place, sito che rientra nella lista dei Patrimoni Mondiali dell'Unesco, inizia nel Quindicesimo secolo; dapprima qualche mercato coperto, le case delle corporazioni, poi l'H\u00f4tel de Ville per rilanciare l'autorit\u00e0 di questo sito commerciale. Bombardata per 3 giorni dall'esercito francese nel 1695, la piazza fu quasi completamente distrutta, ma, come una fenice, rinascer\u00e0 dalle proprie ceneri in meno di 5 anni. Ecco perch\u00e9 sono quattro gli stili che si affiancano e, a volte, si sovrappongono; notiamo una miscela di gotico, opulento barocco, neoclassico e neogotico. La torre dell'H\u00f4tel de Ville \u00e8 alta circa 96 metri.\r\n\r\nUn luogo storico\r\n\r\nLuogo storico, la Grand-Place \u00e8 stata teatro di molti eventi, sia lieti che tragici:\r\n\r\nNel 1523, i primi martiri protestanti, Henri Voes e Jean Van Eschen, vengono bruciati vivi dall'Inquisizione proprio nella Piazza,\r\n1568, i conti di Egmont e Hornes vengono decapitati.\r\nAgosto 1695, nel corso della Guerra della Grande Alleanza, la maggior parte delle case che si affacciano sulla Grand-Place, delle quali alcune sono ancora in legno, vengono distrutte dal bombardamento della citt\u00e0 ad opera delle truppe francesi guidate dal maresciallo di Villeroy. Solamente la facciata e la torre dell'H\u00f4tel de Ville, che fungeva da bersaglio per l'artiglieria, e qualche muro di pietra resistono alle bombe incendiarie. Le case che davano sulla piazza vengono ricostruite rapidamente dalle varie corporazioni che, a questo punto, scelgono come materiale la pietra. Tra esse, spicca la casa della corporazione dei Birrai che oggi accoglie il Mus\u00e9e des Brasseurs (Museo della Birra).\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Grand-Place","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"Inscrita en la lista del Patrimonio Mundial de la UNESCO, la Grand Place comienza a construirse en el siglo XV. Primeramente, se erigen el mercado y algunas casas gremiales; despu\u00e9s, un Ayuntamiento con el que asentar la autoridad de dicho espacio de comercio. V\u00edctima del bombardeo perpetrado por el Ej\u00e9rcito franc\u00e9s durante 3 d\u00edas en 1695, la plaza queda pr\u00e1cticamente destruida pero, como si de un f\u00e9nix se tratase, resurgir\u00e1 de sus cenizas en menos de 5 a\u00f1os. Esa es la raz\u00f3n subyacente en el eclecticismo de la plaza: en ella, cuatro estilos conviven e incluso se superponen en ocasiones: g\u00f3tico, barroco opulento, neocl\u00e1sico y neog\u00f3tico. La torre del Ayuntamiento tiene una altitud aproximada de 96 metros.\r\n\r\nUn emplazamiento hist\u00f3rico\r\n\r\nLugar hist\u00f3rico, la Grand Place ha asistido a numerosos acontecimientos tanto alegres como tr\u00e1gicos:\r\n\r\nen 1523, los primeros m\u00e1rtires protestantes, Henri Voes y Jean Van Eschen, son quemados a manos de la Inquisici\u00f3n,\r\nen 1568, los condes de Egmont y de Hornes son decapitados.\r\nEn agosto de 1695, durante la Guerra de la Liga de Augsburgo, la mayor\u00eda de casas aleda\u00f1as a la Grand Place, algunas de ellas construidas a\u00fan en madera, son arrasadas durante el bombardeo de la ciudad a manos de las tropas francesas dirigidas por el mariscal de Villeroy. \u00danicamente la fachada y la torre del Ayuntamiento, que serv\u00eda de objetivo a los artilleros, as\u00ed como ciertos muros en piedra, resisten a las bolas incendiarias. Varios gremios se encargan de la r\u00e1pida reconstrucci\u00f3n de las casas que enmarcan la plaza, esta vez, en piedra. Entre ellas, se encuentra la casa gremial de los maestros cerveceros, que alberga hoy el Mus\u00e9e des Brasseurs (Museo de los Maestros Cerveceros).\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Grand-Place","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"Classificada como Patrim\u00f3nio Mundial da Unesco, a Grand-Place come\u00e7a a construir-se no s\u00e9culo XV: de in\u00edcio, os sal\u00f5es de algumas sedes de guildas, e, depois, a C\u00e2mara Municipal como sede da autoridade deste local de com\u00e9rcio. Bombardeada durante 3 dias pelas tropas francesas em 1695, fica quase totalmente destru\u00edda, mas, tal como uma f\u00e9nix, renascer\u00e1 das suas cinzas em menos de 5 anos. Por este motivo, quatro estilos coexistem e, por vezes, at\u00e9 se sobrep\u00f5em; \u00e9 uma esp\u00e9cie de mistura de g\u00f3tico, de barroco opulento, de neocl\u00e1ssico e de neog\u00f3tico. A torre da C\u00e2mara Municipal mede, mais ou menos, 96 metros de altura.\r\n\r\nUm local hist\u00f3rico\r\n\r\nLocal hist\u00f3rico, a Grand-Place assistiu ao desenvolvimento de acontecimentos felizes e tr\u00e1gicos:\r\n\r\nEm 1523, os primeiros m\u00e1rtires protestantes, Henri Voes e Jean Van Eschen, foram a\u00ed queimados pela Inquisi\u00e7\u00e3o.\r\nEm 1568, os condes de Egmont e de Hornes foram a\u00ed decapitados.\r\nEm agosto de 1695, durante a Guerra da Liga de Augsburgo, a maior parte das casas que rodeavam a Grand-Place, algumas das quais ainda conservavam a sua constru\u00e7\u00e3o de madeira, foram destru\u00eddas durante o bombardeamento da cidade pelas tropas francesas dirigidas pelo marechal de Villeroy. Apenas a fachada e a torre da C\u00e2mara Municipal, que servia de alvo para os artilheiros, e algumas paredes de pedra resistiram \u00e0s balas de canh\u00e3o. As casas que rodeavam a pra\u00e7a foram rapidamente reconstru\u00eddas, desta feita, usando pedra, pelas diferentes guildas. De entre elas, a sede da guilda dos Cervejeiros que hoje acolhe o Museu os Cervejeiros.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Grand-Place","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[13],"translations":{"fr":["Centre historique"],"nl":["Historisch centrum"],"en":["Historical Centre"],"de":["Historisches Stadtzentrum"],"it":["Centro storico"],"sp":["Centro hist\u00f3rico"],"pt":[null],"cn":[null]}},"zones":{"list":[19],"translations":{"fr":["Centre"],"nl":["Centrum"],"en":["Centre"],"de":["Zentrum"],"it":["Centro"],"sp":["Centro"],"pt":[null],"cn":[null]}},"neca":null,"facebook_id":null,"backoffice_id":266,"location":{"lat":50.84644089,"lon":4.35147641},"region":"brussels","last_updated_at":"2023-07-08T03:35:26+02:00","published_at":"2013-10-19T01:13:24+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":false,"resto_ranking":0},"organizer":{"id":230072,"translations":{"fr":{"name":"Itin\u00e9raires","address_street_name":"Rue de l'Aqueduc","address_street_number":"171","address_street_box":null,"email":"info@itineraires.be","website":"http:\/\/www.itineraires.be","phone_contact":"+32 495 38 85 94","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Aqueduc, 171","address_line2":"1050 Ixelles","description_web":"Professionnels dans l'organisation d\u2019\u00e9v\u00e9nements culturels depuis 1986.\r\nVous \u00eates \u00e0 la recherche d'un team-building cr\u00e9atif et culturel pour vos collaborateurs? Ou d'un programme social pour vos clients? Contactez-nous et d\u00e9couvrez nos propositions:\r\n- Rallyes inoubliables: New: \"Enigme sanglant, mais qui a tu\u00e9 monsieur le Comte?\" devenez un detective et trouvez la solution: \u00e0 pied, en tuk tuk, dans une old timer...\r\n- Chateaux et lieux exclusifs pour vos \u00e9v\u00e9nements d\u2019atmosph\u00e8re et tour VIP\r\n- Diner Thematique: Ex: Art Nouveau, possibilit\u00e9 de l'agr\u00e9menter avec: guides costum\u00e9s, musique live, interpr\u00e8te de Jacques Brel, magiciens, danseurs, acteurs,...\r\n- Itin\u00e9raires sur mesure: Art Nouveau, Anvers \u00e0 la mode, hommage \u00e0 Brel, Brussels by night, Bi\u00e8re et Chocolat, Bruxelles insolite, Simenon et Maigret, Atelier mode, design, Le Gay Bruxelles, \"Qui a tu\u00e9...\", Bruxelles durable.\r\n\r\nSur Bruxelles et toute la Belgique. Nous r\u00e9pondons sur mesure et \u00e0 la demande.\r\nNotre Equipe:\r\n- 4 professionnels pour s'assurer que votre programme atteigne vos objectifs et d\u00e9passe les attentes de vos clients.\r\n- 200 guides multilingues, acteurs, coordinateurs, hotesses,... sp\u00e9cialis\u00e9s dans la mise \u00e0 l'honneur de la Belgique et ses tr\u00e9sors cach\u00e9s.\r\n- 7 jours sur 7\r\n- Notre objectif: vivre l'Art comme un Art de Vivre.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Itin\u00e9raires","address_street_name":"Waterleidingsstraat","address_street_number":"171","address_street_box":null,"email":"info@itineraires.be","website":"http:\/\/www.itineraires.be","phone_contact":"+32 495 38 85 94","phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"Waterleidingsstraat, 171","address_line2":"1050 Elsene","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Itin\u00e9raires","address_street_name":"Rue de l'Aqueduc","address_street_number":"171","address_street_box":null,"email":"info@itineraires.be","website":"http:\/\/www.itineraires.be","phone_contact":"+32 495 38 85 94","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Aqueduc, 171","address_line2":"1050 Ixelles","description_web":"CULTURAL EVENTS SINCE 1986 \r\nAre you looking for fresh and creative incentive, team-building, or social programs for your clients? Contact us and fi nd out what\u2019s on the \u201cmenu\u201d: \r\n\u2022  Unforgettable rallies: CULTURAL CITY GAME\r\nNEW! \u201cBloody inquiry, become one of our most famous detective\u201d On foot, tuk tuk,... \r\n\u2022  Dine Around (3 courses in 3 differents venues)\r\n\u2022  Private Castles for exclusive events & atmosphere and exclusive tours\r\n\u2022  Thematic Diner: Ex: Art Nouveau, possibilities of : costumed guides, live band, a Jacques Brel singer,... \r\n\u2022  Custom-tailored itineraires: Art Nouveau, Trendy Antwerp, Brel and Brussels by night, Beer and chocolate, another Bruges, Simenon and Maigret, Fashion workshops, design, Brussels is there for you, the Gay Brussels, \u201cWho killed Sir the Count?\u201d, Sustainable Brussels.\r\n\r\nIn Brussels and all Belgium. Our programs are exclusive and interactive.\r\nOur team: \r\n\u2022  2 specialists who ensure that your program meets your objectives and exceeds your clients expectations. \r\n\u2022  100 multilingual guides, entertainers, coordinators, hotesses, ... specialists in Belgium\u2019s off  the beaten path treasures. \r\n\u2022  We answer 7 days a week \r\n\u2022 Our aim: to live art as an \u201cArt de Vivre\u201d ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Itin\u00e9raires","address_street_name":"Rue de l'Aqueduc","address_street_number":"171","address_street_box":null,"email":"info@itineraires.be","website":"http:\/\/www.itineraires.be","ph