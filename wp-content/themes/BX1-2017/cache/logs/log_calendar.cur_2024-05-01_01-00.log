:"2024-01-01","date_end":"2024-06-09","date_next":"2024-04-30","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-04-30T02:01:12+02:00","published_at":"2024-03-19T08:22:28+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":296815,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"misc","ranking":0.23159794767993216,"languages":{"spoken":["fr","nl","de","en"],"subtitles":[]},"categories":{"main":{"id":84,"translations":{"de":"Verschiedenes","pt":null,"en":"Various","it":"Varie","cn":null,"fr":"Divers","sp":"Varios","nl":"Varia"}},"others":{}},"translations":{"de":{"name":"Election Experience Path","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/visiting.europarl.europa.eu\/fr\/visitor-offer\/brussels\/info-hub","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50008607"},"pt":{"name":"Election Experience Path","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/visiting.europarl.europa.eu\/fr\/visitor-offer\/brussels\/info-hub","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50008607"},"en":{"name":"Election Experience Path","shortdescr":"June 2024 is a decisive date for European democracy. Europe's future is in the hands of the European citizens. ","longdescr":"The Info Hub is a an open and free forum, which has become an \u2018Election Hub\u2019, so that citizens can be as well informed as possible before they step into the voting booth.\nTo this end, the Info Hub has launched an \u2018Election Experience Path\u2019. This will allow you to choose what your EU policy priorities are, find out how they are being addressed via the \u2018What Europe Does for Me\u2019 platform and learn how decisions taken by Members of the European Parliament (MEPs) are making the European Union a better place to live.\n\n\nIf you have ever wondered what a typical day looks like for an MEP, we have virtual reality glasses that will allow you to try the \u2018Be an MEP\u2019 experience and learn more about how the decision-making process works at the European Parliament.\nThe Info Hub is a forum that is open to all. Come meet other Europeans, hear their stories and have your say on Europe in the \u201cCitizens\u2019 Voices\u201d section of our facility. \n\nThe \u2018Election Experience Path\u2019 concludes with an invitation to put forward your aspirations and ideas, joining other Europeans in having a direct say in determining the course of the democracy in the EU. \nYour voice, your vote, your engagement are key to defending and protecting the democratic principles and values that underpin our way of life.   \n\n\nDrop in and enjoy the \u2018Election Experience Path\u2019: it will help you make an informed decision based on what Europe does for you. The more you know about the role and function of the European Parliament, the more you can help to define what the European Union should focus on over the next five years.","performers":"Vote informed - European Elections at the Info Hub","boxoffice_url":null,"website":"https:\/\/visiting.europarl.europa.eu\/en\/visitor-offer\/brussels\/info-hub","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50008607"},"it":{"name":"Election Experience Path","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/visiting.europarl.europa.eu\/fr\/visitor-offer\/brussels\/info-hub","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50008607"},"cn":{"name":"Election Experience Path","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/visiting.europarl.europa.eu\/fr\/visitor-offer\/brussels\/info-hub","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50008607"},"fr":{"name":"Election Experience Path","shortdescr":"Juin 2024 est une date d\u00e9cisive pour la d\u00e9mocratie europ\u00e9enne. L\u2019avenir de l\u2019Europe est entre les mains des citoyens europ\u00e9ens. ","longdescr":"L\u2019Info Hub se joint \u00e0 la campagne pour les \u00e9lections europ\u00e9ennes 2024, pour vous donner autant d\u2019informations que possible avant de glisser votre bulletin dans l\u2019urne en juin prochain.\n\n\u00c0 cette fin, l\u2019Info Hub a cr\u00e9\u00e9 un \u00abparcours \u00c9lections\u00bb: choisissez vos priorit\u00e9s en mati\u00e8re de politique europ\u00e9enne, d\u00e9couvrez ce que l\u2019UE fait dans ce domaine sur la plateforme \u00abCe que l\u2019Europe fait pour moi\u00bb et voyez comment les d\u00e9cisions prises par les d\u00e9put\u00e9s europ\u00e9ens am\u00e9liorent les conditions de vie dans l\u2019Union.\n\nSi vous vous demandez \u00e0 quoi ressemble la journ\u00e9e d\u2019un d\u00e9put\u00e9 europ\u00e9en, nous vous proposons un casque de r\u00e9alit\u00e9 virtuelle pour vous mettre \u00abDans la peau d\u2019un d\u00e9put\u00e9\u00bb et comprendre le processus d\u00e9cisionnel au Parlement europ\u00e9en.\n\nL\u2019Info Hub est ouvert \u00e0 tous. Venez y rencontrer d\u2019autres Europ\u00e9ens, entendre leur histoire et donner votre avis sur l\u2019Europe dans la section \u00abCitizens\u2019 Voices\u00bb de notre espace. \n\nLe \u00abparcours \u00c9lections\u00bb se conclut sur une invitation \u00e0 soumettre vos aspirations et vos id\u00e9es, et \u00e0 contribuer ainsi avec d\u2019autres Europ\u00e9ens \u00e0 orienter la d\u00e9mocratie dans l\u2019UE. \n\nVotre voix, votre vote, votre engagement sont essentiels \u00e0 la d\u00e9fense et \u00e0 la protection des principes et valeurs d\u00e9mocratiques dont d\u00e9pend notre mode de vie.\n\nVenez d\u00e9couvrir le \u00abparcours \u00c9lections\u00bb et prenez une d\u00e9cision \u00e9clair\u00e9e, en tenant compte de ce que l\u2019Europe fait pour vous. Plus vous en saurez sur le r\u00f4le et la fonction du Parlement europ\u00e9en, mieux vous pourrez contribuer \u00e0 d\u00e9finir les priorit\u00e9s de l\u2019Union europ\u00e9enne pour les cinq ann\u00e9es \u00e0 venir.","performers":"Votez bien inform\u00e9 \u2013 Les \u00e9lections europ\u00e9ennes \u00e0 l\u2019Info Hub","boxoffice_url":null,"website":"https:\/\/visiting.europarl.europa.eu\/fr\/visitor-offer\/brussels\/info-hub","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50008607"},"sp":{"name":"Election Experience Path","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/visiting.europarl.europa.eu\/fr\/visitor-offer\/brussels\/info-hub","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50008607"},"nl":{"name":"Election Experience Path","shortdescr":"Juni 2024 is een cruciale maand voor de Europese democratie. De toekomst van Europa ligt in handen van de EU-burgers. \n\n","longdescr":"De Info Hub is een open en gratis toegankelijk forum, dat nu volledig in het teken staat van de Europese verkiezingen en waar u als EU-burger zo goed mogelijk wordt ge\u00efnformeerd voordat u in juni het stemhokje betreedt.\n\nDe Info Hub heeft daartoe een \u201cBelevenispad Europese verkiezingen\u201d gelanceerd. Daar kunt u vaststellen wat uw prioriteiten voor het EU-beleid zijn. Via het platform \u201cWat Europa voor mij doet\u201d ontdekt u vervolgens hoe aan deze prioriteiten wordt gewerkt en hoe beslissingen van de leden van het Europees Parlement het leven in de EU helpen verbeteren.\n\nHeeft u zich ooit afgevraagd hoe een typische dag voor een Parlementslid eruitziet? Met onze virtualrealitybrillen kunt u ervaren hoe het is om Parlementslid te zijn, en komt u meer te weten over het besluitvormingsproces in het Europees Parlement.\n\nIedereen is welkom bij de Info Hub. Bezoek ons en ontmoet andere Europeanen, luister naar hun verhalen en deel uw mening over Europa in het gedeelte \u201cStemmen van burgers\u201d. \n\nAan het einde van het \u201cBelevenispad Europese verkiezingen\u201d kunt u zelf uw wensen en idee\u00ebn naar voren brengen en samen met andere Europeanen direct meebeslissen over de koers van de democratie in de EU. \n\nUw mening, stem en betrokkenheid zijn belangrijk voor het verdedigen en beschermen van de democratische beginselen en waarden waarop onze samenleving is gestoeld.   \n\nKom langs en begeef u op het \u201cBelevenispad Europese verkiezingen\u201d. Zo komt u te weten wat Europa voor u doet, en kunt u een weloverwogen beslissing nemen. Hoe meer u weet over de rol en de taak van het Europees Parlement, hoe meer u kunt helpen bepalen waar de Europese Unie zich de komende vijf jaar op moet richten.","performers":"Weten waarvoor u stemt \u2013 de Europese verkiezingen bij de Info Hub","boxoffice_url":null,"website":"https:\/\/visiting.europarl.europa.eu\/nl\/visitor-offer\/brussels\/info-hub","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50008607"}},"place":{"last_updated_at":"2023-12-14T10:40:00+01:00","published_at":"2022-07-12T13:11:29+02:00","id":279042,"translations":{"de":{"name":"Info Hub","address_street_name":"Esplanade Solidarnosc 1980","address_street_number":null,"address_street_box":null,"email":null,"website":"https:\/\/visiting.europarl.europa.eu\/fr\/visitor-offer\/brussels\/info-hub","phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Esplanade Solidarnosc 1980","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Info Hub","address_street_name":"Esplanade Solidarnosc 1980","address_street_number":null,"address_street_box":null,"email":null,"website":"https:\/\/visiting.europarl.europa.eu\/fr\/visitor-offer\/brussels\/info-hub","phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Esplanade Solidarnosc 1980","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Info Hub","address_street_name":"Esplanade Solidarnosc 1980","address_street_number":null,"address_street_box":null,"email":null,"website":"https:\/\/visiting.europarl.europa.eu\/en\/visitor-offer\/brussels\/info-hub","phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Esplanade Solidarnosc 1980","address_line2":"1050 Ixelles","description_web":"Please note! Closed on 24, 25 and 31 December 2023 and on 1 January 2024.\nDive into the topics you are interested in with open access research material, policy talks and civil society events, and thought-provoking exhibitions at the heart of the European Quarter. With distinct areas offering access to a variety of content and activities, the Info Hub on the Esplanade Solidarno\u015b\u0107 1980 caters to many needs. Engage in a dialogue on the European Union and democracy, attend a short policy talk, or simply sit and read more about what is going on in Europe. What is more, with a constantly changing programme of events and exhibitions, you can come back time and time again, and discover something new each time.\n\nGot a question? Ask the friendly staff and they will help you find your way around the Info Hub, or the European Parliament campus.  ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Info Hub","address_street_name":"Esplanade Solidarnosc 1980","address_street_number":null,"address_street_box":null,"email":null,"website":"https:\/\/visiting.europarl.europa.eu\/fr\/visitor-offer\/brussels\/info-hub","phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Esplanade Solidarnosc 1980","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Info Hub","address_street_name":"Esplanade Solidarnosc 1980","address_street_number":null,"address_street_box":null,"email":null,"website":"https:\/\/visiting.europarl.europa.eu\/fr\/visitor-offer\/brussels\/info-hub","phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Esplanade Solidarnosc 1980","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Info Hub","address_street_name":"Esplanade Solidarnosc 1980","address_street_number":null,"address_street_box":null,"email":null,"website":"https:\/\/visiting.europarl.europa.eu\/fr\/visitor-offer\/brussels\/info-hub","phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Esplanade Solidarnosc 1980","address_line2":"1050 Ixelles","description_web":"Attention ! Ferm\u00e9 les 24, 25 et 31 d\u00e9cembre 2023 ainsi que le 1er janvier 2024\nExplorez les th\u00e9matiques qui vous int\u00e9ressent gr\u00e2ce \u00e0 nos documents de recherche, d\u00e9bats politiques et \u00e9v\u00e9nements organis\u00e9es avec la soci\u00e9t\u00e9 civile, ainsi qu\u2019\u00e0 des expositions suscitant la r\u00e9flexion, le tout en libre acc\u00e8s au c\u0153ur du quartier europ\u00e9en. Avec des espaces distincts donnant acc\u00e8s \u00e0 une vari\u00e9t\u00e9 de contenus et d'activit\u00e9s, l\u2019Info Hub de l\u2019Esplanade Solidarno\u015b\u0107 1980 r\u00e9pond \u00e0 toute une gamme de besoins. Participez au dialogue sur l\u2019Union europ\u00e9enne et la d\u00e9mocratie, assistez \u00e0 des d\u00e9bats politiques, ou asseyez-vous et lisez tout simplement pour en apprendre davantage sur l\u2019actualit\u00e9 en Europe. Le programme \u00e9v\u00e9nementiel est en constante \u00e9volution, et vous permet ainsi de revenir autant de fois que vous le voulez en d\u00e9couvrant quelque chose de nouveau \u00e0 chaque visite. \n\nUne question ? Posez-la \u00e0 notre \u00e9quipe toujours pr\u00eate \u00e0 vous aider, et elle vous guidera dans l\u2019Info Hub ou sur le campus du Parlement europ\u00e9en.  ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Info Hub","address_street_name":"Esplanade Solidarnosc 1980","address_street_number":null,"address_street_box":null,"email":null,"website":"https:\/\/visiting.europarl.europa.eu\/fr\/visitor-offer\/brussels\/info-hub","phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Esplanade Solidarnosc 1980","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Info Hub","address_street_name":"Esplanade Solidarnosc 1980","address_street_number":null,"address_street_box":null,"email":null,"website":"https:\/\/visiting.europarl.europa.eu\/nl\/visitor-offer\/brussels\/info-hub","phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"Esplanade Solidarnosc 1980","address_line2":"1050 Elsene","description_web":"Let op! Gesloten op 24, 25 en 31 december 2023 en op 1 januari 2024.\nVerdiep u in onderwerpen die u interesseren via vrij toegankelijk onderzoeksmateriaal, beleidsbesprekingen, evenementen van het maatschappelijk middenveld en boeiende tentoonstellingen in het hart van de Europese wijk. Het aan de Esplanade Solidarno\u015b\u0107 1980 gelegen Info Hub biedt uiteenlopende activiteiten en diverse ruimten die ieder in een andere behoefte voorzien. Wissel van gedachten over de Europese Unie en democratie, woon een korte beleidsbespreking bij of neem rustig plaats om u in te lezen over wat er in Europa speelt. Dankzij de voortdurend wisselende evenementen en tentoonstellingen kunt u keer op keer terugkomen en telkens weer iets nieuws ontdekken.\n\nVragen? Onze medewerkers staan voor u klaar. Ze maken u graag wegwijs in het Info Hub of op het terrein van het Europees Parlement.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[9],"translations":{"de":["Europ\u00e4isches Viertel"],"pt":[null],"en":["European Quarter"],"it":["Quartiere europeo"],"cn":[null],"fr":["Quartier europ\u00e9en"],"sp":["Barrio Europeo"],"nl":["Europese wijk"]}},"zones":[],"neca":null,"facebook_id":null,"backoffice_id":39042,"location":{"lat":50.83853444,"lon":4.37381472},"region":"brussels","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"last_updated_at":"2022-10-10T10:25:09+02:00","published_at":"2013-10-19T01:14:19+02:00","id":235087,"translations":{"de":{"name":"Europ\u00e4isches Parlament","address_street_name":"Place du Luxembourg","address_street_number":"100","address_street_box":null,"email":null,"website":"http:\/\/www.europarl.europa.eu","phone_contact":null,"phone_booking":null,"address_zip":"1047","address_city":"Parlement Europ\u00e9en","address_line1":"Place du Luxembourg, 100","address_line2":"1047 Parlement Europ\u00e9en","descriptio