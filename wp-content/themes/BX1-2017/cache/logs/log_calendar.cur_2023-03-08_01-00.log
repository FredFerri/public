":["Art nouveau y art d\u00e9co"],"pt":[null],"cn":[null]}},"tags":["exterior","kids","annee_art_nouveau"],"is_part_of":"Ann\u00e9e Art Nouveau","accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-02-11T05:05:58+01:00","published_at":"2023-01-25T11:40:51+01:00","backoffice_id":270345,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":1},{"id":548220,"date_start":"2023-03-12","date_end":"2023-03-12","date_next":"2023-03-12","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen","it":"Visite guidate","sp":"Visitas guiadas","pt":null,"cn":null}},"others":{"list":[104],"translations":{"fr":["Art Nouveau, Art D\u00e9co"],"nl":["Art nouveau, art deco"],"en":["Art Nouveau, Art D\u00e9co"],"de":["Jugendstil, Art d\u00e9co"],"it":["Art Nouveau, Art D\u00e9co"],"sp":["Art nouveau, art d\u00e9co"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Maison Vizzavona","shortdescr":"Venez d\u00e9couvrir un des joyaux de l'architecture Art Nouveau, au coeur du festival BANAD","longdescr":"La maison Vizzavona fut construite en 1907 par Paul Vizzavona, architecte Art \r\nnouveau de la deuxi\u00e8me g\u00e9n\u00e9ration. D\u2019un aspect sobre et \u00e9l\u00e9gant, la fa\u00e7ade t\u00e9moigne de sa formation \u00e0 l\u2019\u00c9cole des arts d\u00e9coratifs de Paris suivi d\u2019un passage dans l\u2019atelier de Victor Horta en 1904 en associant la ligne organique de Victor Horta et un classicisme \u00e0 la fran\u00e7aise. Elle nous ouvre ses portes au c\u0153ur du BANAD, un Festival dont la particularit\u00e9 sont les visites guid\u00e9es d'int\u00e9rieurs Art nouveau et Art d\u00e9co \r\nhabituellement ferm\u00e9s au public. Une occasion unique de (re)d\u00e9couvrir ces joyaux de l'architecture !\r\n\r\nINSCRIPTION OBLIGATOIRE\r\n- Par courrier postal (rue des Moineaux, 17-19 \u2013 1000 Bruxelles)\r\n- Par e-mail (loisirs.sante@solidaris.be)\r\n\r\nY mentionner :\r\nnom, pr\u00e9nom, adresse, date de naissance, n\u00b0 de gsm,\r\nl'activit\u00e9 choisie, n\u00b0 de membre Loisirs et Sant\u00e9 asbl (ou n\u00b0 de mutuelle) ou demande d'affiliation.\r\n\r\nIl n'y a pas d'inscription par t\u00e9l\u00e9phone, mais l'asbl est joignable au 02 546 15 70 pour toute information. L\u2019inscription pr\u00e9alable est obligatoire. D\u00e8s r\u00e9ception de votre demande, un bulletin de virement vous est transmis par courrier (pas de paiement en liquide sur place). Une semaine avant l'\u00e9v\u00e9nement un courrier vous est envoy\u00e9 avec le lieu de rendez-vous et les d\u00e9tails pratiques.\r\n\r\n\u00catre membre de Loisirs et Sant\u00e9 asbl est obligatoire pour participer\r\nAFFILIATION possible sur simple demande pour les personnes en \u00e2ge d\u2019exercer une activit\u00e9 professionnelle.\r\n- Membres de Solidaris Brabant  : AFFILIATION gratuite\r\n- Non-Solidaris  : 50\u20ac par ann\u00e9e acad\u00e9mique (septembre \u00e0 juin)\r\n\r\nLes conditions g\u00e9n\u00e9rales sous lesquelles sont organis\u00e9es les activit\u00e9s sont disponibles sur le site https:\/\/www.solidaris-brabant.be\/fr\/loisirs-et-sante .Vous inscrire implique que vous en ayez pris connaissance.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.solidaris-brabant.be\/fr\/loisirs-et-sante","email":"loisirs.sante@solidaris.be","phone_contact":"+32 2 546 15 70","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.548220"},"nl":{"name":"Maison Vizzavona","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website"