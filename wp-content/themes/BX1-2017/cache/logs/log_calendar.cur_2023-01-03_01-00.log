t":false,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/6d295fd89a5f5adaffc4ef1519e27b4798af22d2.jpg","width":1400,"height":1400,"ratio":1,"translations":{"fr":{"title":"Duo Coulon \u2013 Az\u00e1n (Chili)","copyright":null},"nl":{"title":"Duo Coulon \u2013 Az\u00e1n (Chili)","copyright":null},"en":{"title":"Duo Coulon \u2013 Az\u00e1n (Chili)","copyright":null},"de":{"title":"Duo Coulon \u2013 Az\u00e1n (Chili)","copyright":null},"it":{"title":"Duo Coulon \u2013 Az\u00e1n (Chili)","copyright":null},"sp":{"title":"Duo Coulon \u2013 Az\u00e1n (Chili)","copyright":null},"pt":{"title":"Duo Coulon \u2013 Az\u00e1n (Chili)","copyright":null},"cn":{"title":"Duo Coulon \u2013 Az\u00e1n (Chili)","copyright":null}}}],"dates":[{"day":"2023-01-21","doors":null,"start":"20:00:00","end":null,"is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"},"de":{"name":"Normal"},"it":{"name":"Normal"},"sp":{"name":"Normal"},"pt":{"name":"Normal"},"cn":{"name":"Normal"}},"value":15},{"translations":{"fr":{"name":"Pr\u00e9vente"},"nl":{"name":"Voorverkoop"},"en":{"name":"Presale"},"de":{"name":"Vorverkauf"},"it":{"name":"Pr\u00e9vente"},"sp":{"name":"Pr\u00e9vente"},"pt":{"name":"Pr\u00e9vente"},"cn":{"name":"Pr\u00e9vente"}},"value":13},{"translations":{"fr":{"name":"Article 27"},"nl":{"name":"Artikel 27"},"en":{"name":"Article 27"},"de":{"name":"Article 27"},"it":{"name":"Article 27"},"sp":{"name":"Article 27"},"pt":{"name":"Article 27"},"cn":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-12-19T13:05:38+01:00","published_at":"2022-12-19T12:20:22+01:00","backoffice_id":267644,"import_origin":null,"sub_type":"concert","show_in_agenda":true,"ranking":1.2599210498949},{"id":540372,"date_start":"2023-01-21","date_end":"2023-01-21","date_next":"2023-01-21","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater","it":null,"sp":null,"pt":null,"cn":null}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"],"de":["Theater"],"it":[null],"sp":[null],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Foxes","shortdescr":null,"longdescr":"Par la Cie Renards\r\n\r\nLily qu\u2019on croyait douce a p\u00e9t\u00e9 le nez de Mammouth, Prosper danse tout seul, pour lui, tous les mercredis. Bambi a atteint la finale d\u2019une \u00e9mission t\u00e9l\u00e9vis\u00e9e de chant, puis s\u2019est enfuie. Herv\u00e9 s\u2019est r\u00e9fugi\u00e9 dans son casque de r\u00e9alit\u00e9 virtuelle\u2026 Tous, pour des raisons diff\u00e9rentes, ont quitt\u00e9 leur maison, leur \u00e9cole, leur quartier, et se sont retrouv\u00e9s par hasard au m\u00eame endroit: un vieux dancing abandonn\u00e9 depuis 20 ans.\r\n\r\nLorsque l\u2019insouciance se barre, quand la magie se d\u00e9construit, que faisons- nous grandir \u00e0 la place ? Quand l\u2019enfance se met \u00e0 ressembler \u00e0 un dancing d\u00e9saffect\u00e9, un th\u00e9\u00e2tre sans magie, une pochette sans surprise. Quand l\u2019illusion s\u2019\u00e9vanouit d\u00e9voilant tous ses outils. C\u2019est l\u2019heure d\u00e9j\u00e0 de s\u2019en emparer. Avant que d\u2019autres r\u00eaves en plastique ne s\u2019immiscent. D\u00e9j\u00e0 agir pour ce que l\u2019on veut et choisir ce que l\u2019on aime.\r\n\r\n\u00c9criture & mise en sc\u00e8ne\r\n\r\nArthur Oudar\r\n\r\nInterpr\u00e9tation\r\n\r\nAdrien Desbons \u00c9line Schumacher Julie Sommervogel Baptiste Toulemonde\r\n\r\nCr\u00e9ation plateau & r\u00e9gie\r\n\r\nIsabelle Derr\r\n\r\nSc\u00e9nographie & costumes\r\n\r\nBertrand Nodet\r\n\r\nCr\u00e9ation lumi\u00e8re\r\n\r\nLionel Ueberschlag\r\n\r\nCr\u00e9ation sonore\r\n\r\nGuillaume Vesin\r\n\r\nCr\u00e9ation marionnette\r\n\r\nLucas Prieux\r\n\r\nHoraires\r\n\r\nSamedi 21 janvier - 18.00\r\n\r\nInformations\r\n\r\nA partir de 9 ans\r\n\r\nDur\u00e9e : 70 minutes\r\n\r\nTarifs\r\n\r\nPrix libre et solidaire \u00e0 partir de 3,5 euros. Nous acceptons aussi les Art.27.\r\n\r\nOptez pour une \u00ab impression \u00e0 domicile \u00bb ou t\u00e9l\u00e9chargez votre e-ticket sur votre Smartphone : vous \u00e9viterez les files gr\u00e2ce \u00e0 votre QR Code.\r\n\r\nPartenaires\r\n\r\nProduction\r\n\r\nRenards \/ Effet Mer\r\n\r\nEn coproduction avec\r\n\r\nLe Th\u00e9\u00e2tre Moli\u00e8re \u2013 S\u00e8te sc\u00e8ne nationale archipel de Thau (34), le Crat\u00e8re \u2013 Sc\u00e8ne Nationale d\u2019Al\u00e8s (30), la Communaut\u00e9 de Communes Sud-H\u00e9rault (34), le Th\u00e9\u00e2tre de Grasse \u2013 sc\u00e8ne conventionn\u00e9e d\u2019int\u00e9r\u00eat national \u2013 Art & Cr\u00e9ation pour la danse et le cirque et la ville (06) et la Ville de Mauguio Carnon (34)\r\n\r\nAvec le soutien de\r\n\r\nLa F\u00e9d\u00e9ration Wallonie-Bruxelles (Be), du Th\u00e9\u00e2tre de la Montage Magique (Bruxelles \u2013 Be), du Th\u00e9\u00e2tre National de la F\u00e9d\u00e9ration Wallonie-Bruxelles (Be), du 140 (Schaerbeek \u2013 Be), de la R\u00e9gion Occitanie et de la DRAC Occitanie. La compagnie est \u00e9galement soutenue par la Ville de Montpellier pour le fonctionnement.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.lejacquesfranck.be","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.540372"},"nl":{"name":"Foxes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url"