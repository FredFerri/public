school"]}},"tags":[],"accessibilities":{"list":[255],"translations":{"fr":["Accessible"],"nl":["Toegankelijk"],"en":["Accessible"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-05-17T01:35:33+02:00","published_at":"2021-07-30T12:57:54+02:00","backoffice_id":236258,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":0.37475617678432},{"id":533529,"date_start":"2022-05-19","date_end":"2022-05-19","date_next":"2022-05-19","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[36,41],"translations":{"fr":["Mus\u00e9es et art centers","Installation, performance"],"nl":["Musea en kunstcentra","Installatie, performance"],"en":["Museums and art centers","Installation, performance"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Pleure(nt) les glaciers. Installation artistique de Clara Thomine","shortdescr":"Avec \u00ab Pleure(nt) les glaciers \u00bb, Clara Thomine intervient sur les vestiges d'un ancien cimeti\u00e8re au c\u0153ur du Parc Georges-Henri ! Ses all\u00e9es, pav\u00e9es d\u2019anciennes pierres tombales, vont bient\u00f4t conna\u00eetre un nouveau destin, celui de comm\u00e9morer le nom de glaciers disparus...\r\n\r\nSoleil, glaces et visites guid\u00e9es viendront ponctuer cette inauguration pr\u00e9vue le 19 mai prochain d\u00e8s 18h!","longdescr":"Avec \u00ab Pleure(nt) les glaciers \u00bb, Clara Thomine intervient sur les vestiges d'un ancien cimeti\u00e8re au c\u0153ur du Parc Georges-Henri ! Ses all\u00e9es, pav\u00e9es d\u2019anciennes pierres tombales, vont bient\u00f4t conna\u00eetre un nouveau destin, celui de comm\u00e9morer le nom de glaciers disparus...\r\nChaque nom, soigneusement choisi par Clara, \u00e9paul\u00e9e dans sa d\u00e9marche par des climatologues du monde entier (Europe, Etats-Unis, Colombie, Kenya, Antarctique,...), vise \u00e0 pointer de mani\u00e8re d\u00e9cal\u00e9e l'urgence \u00e9cologique qui menace notre plan\u00e8te. \r\n\r\nCette \u0153uvre \u00e9ph\u00e9m\u00e8re vivra plusieurs semaines et s\u2019effacera au fil du temps, avec le passage des promeneurs, de la pluie... Et s'inscrit ainsi dans la continuit\u00e9 de son exposition \u00ab Tout doit dispara\u00eetre \u00bb autour de \u00ab La fin du monde \u00bb m\u00ealant art vid\u00e9o, performance, installation et travail sculptural. \r\n\r\nSoleil, glaces et visites guid\u00e9es viendront ponctuer cette inauguration pr\u00e9vue le 19 mai prochain d\u00e8s 18h! RDV \u00e0 la Guinguette...","performers":"Clara Thomine","boxoffice_url":null,"website":"http:\/\/www.wolubilis.be","email":"info@wolubilis.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/533529.html"},"nl":{"name":"Pleure(nt) les glaciers. Installation artistique de Clara Thomine","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/533529.html"},"en":{"name":"Pleure(nt) les glaciers. Installation artistique de Clara Thomine","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/533529.html"},"de":{"name":"Pleure(nt) les glaciers. Installation artistique de Clara Thomine","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/533529.html"},"it":{"name":"Pleure(nt) les g