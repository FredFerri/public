atieve kunsten"],"en":["Museums and art centers","Decorative art"]}}},"languages":{"spoken":["fr","en","es"],"subtitles":[]},"translations":{"fr":{"name":"Intimate Metaphysics","shortdescr":"Nous sommes plus que ravis de vous pr\u00e9senter le SOLO SHOW de l'artiste italien Edo Piantadosi.\r\n\r\n\u00ab Intimate Metaphysics \u00bb est une enqu\u00eate photographique po\u00e9tique et m\u00e9taphysique sur les formes de l'eau.\r\n\"Intimate Metaphysics\" is a poetic and metaphysical photographic investigation about water shapes.","longdescr":"Chers amis, nous sommes plus que ravis de vous pr\u00e9senter le SOLO SHOW de l'artiste italien Edo Piantadosi.\r\n\r\n\u00ab Intimate Metaphysics \u00bb est une enqu\u00eate photographique po\u00e9tique et m\u00e9taphysique sur les formes de l'eau.\r\nDes exp\u00e9riences visuelles uniques de moments qui ne se r\u00e9p\u00e8tent jamais...\r\n\r\nPiantadosi pr\u00e9sente le r\u00e9sultat de plus de quinze ans d'investigation et d'exploration de l'eau sous toutes ses formes, \u00e9tudiant sa gen\u00e8se et sa nature physique, la ramenant \u00e0 son essence dans ses images et les sortant de leur contexte pour les rendre abstraites.\r\n\r\nNous serons ravis de votre visite.","performers":"Edo Piantadosi, photographe italien","boxoffice_url":null,"website":"http:\/\/www.noonconsulting.art\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.535497"},"nl":{"name":"Intimate Metaphysics","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.535497"},"en":{"name":"Intimate Metaphysics","shortdescr":"We are more than\u00a0glad to present you the SOLO SHOW of the Italian artist Edo Piantadosi.\r\n\r\n\"Intimate Metaphysics\" is a poetic and metaphysical photographic investigation about water shapes.","longdescr":"Dear friends, we are more than\u00a0glad to present you the SOLO SHOW of the Italian artist Edo Piantadosi.\r\n\r\n\"Intimate Metaphysics\" is a poetic and metaphysical photographic investigation about water shapes.\r\nUnique visual experiences of moments that are never repeated...\r\n\r\nPiantadosi presents the result of more than fifteen years of investigation and exploration of the water in all its forms, studying its genesis and physical nature, stripping it back to its essence in his images and removing them\u00a0from their context to make them seem abstract.\r\n\r\nWe will be delighted to have your visit.","performers":"Edo Piantadosi, Italian Photographer","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.535497"},"de":{"name":"Intimate Metaphysics","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.535497"},"it":{"name":"Intimate Metaphysics","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.535497"},"sp":{"name":"Intimate Metaphysics","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.535497"},"pt":{"name":"Intimate Metaphysics","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.535497"},"cn":{"name":"Intimate Metaphysics","shortdescr":null,"longdescr":null,"performers