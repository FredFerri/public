9","vendredi, samedi et dimanche: de 14:00 \u00e0 18:00"],"nl":["maandag, dinsdag, woensdag en donderdag: gesloten","vrijdag, zaterdag en zondag: van 14:00 tot 18:00"],"en":["monday, tuesday, wednesday and thursday: closed","friday, saturday and sunday: from 14:00 to 18:00"]},"date_start":"2022-04-27","date_end":"2022-05-23","is_also_by_appointment":false}],"date_exceptions":[{"day":"2022-04-27","start":"18:30:00","end":"21:30:00"},{"day":"2022-05-23","start":"18:30:00","end":"20:00:00"}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"opening":{"day":"2022-04-27","start":"18:30:00","timestamp":"2022-04-27T18:30:00+02:00","end":"21:30:00","is_only_by_appointment":false},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-05-16T01:36:27+02:00","published_at":"2022-05-04T11:16:26+02:00","backoffice_id":253057,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.33333333333333},{"id":529575,"date_start":"2022-05-20","date_end":"2022-05-22","date_next":"2022-05-20","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre"}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Rencontres.com","shortdescr":"Rencontrer quelqu\u2019un en ligne. Aborder un.e inconnu.e dans la s\u00e9curit\u00e9 et la st\u00e9rilit\u00e9 virtuelle. Choisir son partenaire comme on ach\u00e8te sur Amazon. Juger. Comparer. D\u00e9sirer. Oser passer le pas de la rencontre r\u00e9elle. 2 com\u00e9diens d\u00e9cortiquent avec humour et sinc\u00e9rit\u00e9 les rouages de l\u2019amour 2.0. Ses fantasmes, ses d\u00e9sillusions, ses angoisses, ses excitations, ses \u00e9checs et ses charmantes surprises.","longdescr":"Aimer, du virtuel au r\u00e9el\r\n\r\nRencontrer quelqu\u2019un en ligne. Pour un soir, pour la vie, pour tromper son ennui, pour se prouver qu'on peut encore s\u00e9duire...  Se pr\u00e9senter comme on se mettrait en vente sur Amazon. Juger. Comparer. D\u00e9sirer. Aborder un.e inconnu.e dans la s\u00e9curit\u00e9 et la st\u00e9rilit\u00e9 virtuelle. Oser passer le pas de la rencontre r\u00e9elle. Prendre le risque de se confronter \u00e0 la r\u00e9alit\u00e9.\r\n\r\nDeux com\u00e9diens d\u00e9cortiquent avec humour et sinc\u00e9rit\u00e9 les rouages de l\u2019amour 2.0. Ses fantasmes, ses d\u00e9sillusions, ses angoisses, ses excitations, ses \u00e9checs et ses charmantes surprises.","performers":"Claire de Reuck et Patrick Spadrille","boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Rencontres-com.html","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/529575.html"},"nl":{"name":"Rencontres.com","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/529575.html"},"en":{"name":"Rencontres.com","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/529575.html"},"de":{"name":"Rencontres.com","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/529575.html"},"it":{"name":"Rencontres.com","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":nu