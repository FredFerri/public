prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"opening":{"day":"2022-09-15","start":"18:00:00","timestamp":"2022-09-15T18:00:00+02:00","end":"21:00:00","is_only_by_appointment":false},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-09-30T01:37:19+02:00","published_at":"2022-08-08T09:59:49+02:00","backoffice_id":259387,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.30010006671856},{"id":540745,"date_start":"2022-08-24","date_end":"2022-10-01","date_next":"2022-09-30","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[24,34],"translations":{"fr":["Galeries d'art","Pluridisciplinaire"],"nl":["Galeries","Pluridisciplinair"],"en":["Art Galleries","Multidisciplinary"]}}},"languages":{"spoken":["fr","en"],"subtitles":[]},"translations":{"fr":{"name":"Expo #12 'Errances'","shortdescr":"Avec Del\u00e9pine et les Sta\u00eblens, cr\u00e9er pour se sauver","longdescr":"Depuis les d\u00e9buts de la galerie, la Bruno Matthys Gallery a toujours aim\u00e9 cr\u00e9er la rencontre, en mettant en parall\u00e8le deux ou trois artistes lors d\u2019une m\u00eame exposition. Les univers qui se r\u00e9pondent donnent lieu \u00e0 de nouvelles perceptions, une vision unique, comme cr\u00e9\u00e9e par le hasard.\r\n\r\nCette fois, ce sont trois artistes qui seront pr\u00e9sent\u00e9s, le duo hors du commun que forment Ghyslaine et Sylvain Sta\u00eblens, cr\u00e9ateurs de figures tant\u00f4t zoomorphes, tant\u00f4t anthropomorphes et les peintures saisissantes de lumi\u00e8re de J\u00e9r\u00f4me Del\u00e9pine.\r\n\r\nDeux mondes totalement oppos\u00e9s qui pourtant communiquent \u00e0 merveille. Peut-\u00eatre parce que chacun, \u00e0 sa mani\u00e8re, a trouv\u00e9 dans la cr\u00e9ation un chemin vers la lumi\u00e8re.","performers":"Ghyslaine & Sylvain Sta\u00eblens\r\nJ\u00e9r\u00f4me Del\u00e9pine","boxoffice_url":null,"website":"http:\/\/www.brunomatthys.art","email":"bruno.matthys@outlook.be","phone_contact":"+32 475 63 01 49","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.540745"},"nl":{"name":"Expo #12 'Errances'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.540745"},"en":{"name":"Expo #12 'Errances'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.540745"},"de":{"name":"Expo #12 'Errances'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.540745"},"it":{"name":"Expo #12 'Errances'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.540745"},"sp":{"name":"Expo #12 'Errances'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.540745"},"pt":{"name":"Expo #12 'Errances'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_bo