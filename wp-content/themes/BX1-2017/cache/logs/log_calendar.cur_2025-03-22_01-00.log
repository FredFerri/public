ist":[507],"translations":{"de":["Newsletter Highlight"],"pt":[null],"en":["Newsletter Highlight"],"it":["Newsletter Highlight"],"cn":[null],"fr":["Newsletter Highlight"],"sp":["Newsletter Highlight"],"nl":["Newsletter Highlight"]}},"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[]},{"id":5700007531,"date_start":"2025-02-01","date_end":"2025-04-30","date_next":"2025-04-30","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2025-03-10T16:37:01+01:00","published_at":"2025-03-10T16:27:54+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":319666,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"misc","ranking":0.22397695245557508,"languages":{"spoken":["fr","en"],"subtitles":[]},"categories":{"main":{"id":84,"translations":{"de":"Verschiedenes","pt":null,"en":"Various","it":"Varie","cn":null,"fr":"Divers","sp":"Varios","nl":"Varia"}},"others":{}},"translations":{"de":{"name":"Unveiling Our First Artistic Collaboration of 2025 \u2013 Eva Lynen","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.thedominican.be\/news\/art","email":"info@thedominican.be","phone_contact":"+32 2 203 08 08","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700007531"},"pt":{"name":"Unveiling Our First Artistic Collaboration of 2025 \u2013 Eva Lynen","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.thedominican.be\/news\/art","email":"info@thedominican.be","phone_contact":"+32 2 203 08 08","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700007531"},"en":{"name":"Unveiling Our First Artistic Collaboration of 2025 \u2013 Eva Lynen","shortdescr":"We\u2019re excited to present Eva Lynen, running from February 8 for three months. Her unique blend of painting and illustration captures the overlooked moments of daily life, mixing humor, surrealism, and universal themes. Set in Brussels, her work invites viewers to explore hidden narratives and new perspectives, offering an immersive storytelling experience in a vibrant setting.","longdescr":"Continuing our commitment to supporting the arts, we are proud to present the first artistic collaboration of 2025\nFrom February 8 onward, this captivating exhibition will be on display for three months, showcasing the distinctive work of Eva Lynen who masterfully blends painting and illustration to create immersive storytelling experiences.\n\nThe featured artist approaches storytelling through a unique visual language, crafting imagined worlds filled with intriguing characters and settings. Her work captures the essence of small, often overlooked moments in daily life\u2014the quiet, humorous, and sometimes absurd instances that define human routines. With a deep connection to both personal experiences and universal themes, each piece resonates with viewers, inviting them to explore the hidden narratives within everyday scenes.\n\nThrough a careful balance of familiarity and surrealism, the artwork of Eva Lynen encourages viewers to pause and reflect, uncovering the underlying emotions and stories embedded in each composition.\n\nThis exhibition also highlights the visual essence of Brussels in its different facets, incorporating the city\u2019s unique charm and vibrancy. As part of this artistic journey, The Dominican Hotel plays an integral role, offering a distinctive setting that enhances the overall experience.\n\nVisitors will have the opportunity to see Brussels through Eva\u2019s lens, discovering new perspectives and stories woven into the fabric of the city.\n\nThis exhibition serves as a testament to the power of visual storytelling, offering an opportunity for audiences to engage with art that is both thought-provoking and deeply relatable. We invite everyone to explore this remarkable collaboration and immerse themselves in the artist\u2019s world of imagination.","performers":"\n\n\n\n","boxoffice_url":null,"website":"https:\/\/www.thedominican.be\/news\/art","email":"info@thedominican.be","phone_contact":"+32 2 203 08 08","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700007531"},"it":{"name":"Unveiling Our First Artistic Collaboration of 2025 \u2013 Eva Lynen","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.thedominican.be\/news\/art","email":"info@thedominican.be","phone_contact":"+32 2 203 08 08","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700007531"},"cn":{"name":"Unveiling Our First Artistic Collaboration of 2025 \u2013 Eva Lynen","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.thedominican.be\/news\/art","email":"info@thedominican.be","phone_contact":"+32 2 203 08 08","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700007531"},"fr":{"name":"Unveiling Our First Artistic Collaboration of 2025 \u2013 Eva Lynen","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.thedominican.be\/news\/art","email":"info@thedominican.be","phone_contact":"+32 2 203 08 08","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700007531"},"sp":{"name":"Unveiling Our First Artistic Collaboration of 2025 \u2013 Eva Lynen","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"