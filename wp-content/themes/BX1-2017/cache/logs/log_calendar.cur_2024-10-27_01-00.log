null,"email":"info@muziekpublique.be","website":"http:\/\/www.muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":"+32 2 217 26 00","address_zip":"1050","address_city":"Ixelles","address_line1":"Galerie de la Porte de Namur, 3","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Muziekpublique","address_street_name":"Galerie de la Porte de Namur","address_street_number":"3","address_street_box":null,"email":"info@muziekpublique.be","website":"http:\/\/www.muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":"+32 2 217 26 00","address_zip":"1050","address_city":"Ixelles","address_line1":"Galerie de la Porte de Namur, 3","address_line2":"1050 Ixelles","description_web":"Muziekpublique, keeps music and dance traditions alive and kicking in Brussels through an ambitious programme of concerts, courses, and projects. A year-round concert programme, featuring Belgian and international artists, forms the core of the foundation\u2019s activities. From the contemplative to the madly festive concerts take place indoors,  in the small Moli\u00e8re Theatre, in the arcade at the Porte de Namur and outdoors, around the city and throughout the year.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Muziekpublique","address_street_name":"Galerie de la Porte de Namur","address_street_number":"3","address_street_box":null,"email":"info@muziekpublique.be","website":"http:\/\/www.muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":"+32 2 217 26 00","address_zip":"1050","address_city":"Ixelles","address_line1":"Galerie de la Porte de Namur, 3","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Muziekpublique","address_street_name":"Galerie de la Porte de Namur","address_street_number":"3","address_street_box":null,"email":"info@muziekpublique.be","website":"http:\/\/www.muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":"+32 2 217 26 00","address_zip":"1050","address_city":"Ixelles","address_line1":"Galerie de la Porte de Namur, 3","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Muziekpublique","address_street_name":"Galerie de la Porte de Namur","address_street_number":"3","address_street_box":null,"email":"info@muziekpublique.be","website":"http:\/\/www.muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":"+32 2 217 26 00","address_zip":"1050","address_city":"Ixelles","address_line1":"Galerie de la Porte de Namur, 3","address_line2":"1050 Ixelles","description_web":"Muziekpublique est le centre des musiques traditionnelles du monde de Bruxelles. Etablie dans le Th\u00e9\u00e2tre Moli\u00e8re au c\u0153ur du quartier africain, l\u2019asbl organise plus de 100 concerts par an et deux festivals (Hide & Seek Festival etc.). Par ailleurs Muziekpublique propose aussi 50 cours de musique et de danse du monde, comptant plus de 600 \u00e9l\u00e8ves. Ensuite, l\u2019asbl d\u00e9veloppe certains artistes et projets via son label, qui est aussi une agence de booking et de management. La musique traditionnelle a donc trouv\u00e9 un endroit id\u00e9al o\u00f9 se d\u00e9velopper et les artistes y constituent un r\u00e9seau vivant et dynamique cr\u00e9ant des liens de qualit\u00e9 avec le public. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Muziekpublique","address_street_name":"Galerie de la Porte de Namur","address_street_number":"3","address_street_box":null,"email":"info@muziekpublique.be","website":"http:\/\/www.muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":"+32 2 217 26 00","address_zip":"1050","address_city":"Ixelles","address_line1":"Galerie de la Porte de Namur, 3","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Muziekpublique","address_street_name":"Galerij van de Naamsepoort ","address_street_number":"3","address_street_box":null,"email":"info@muziekpublique.be","website":"http:\/\/www.muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":"+32 2 217 26 00","address_zip":"1050","address_city":"Elsene","address_line1":"Galerij van de Naamsepoort , 3","address_line2":"1050 Elsene","description_web":"Muziekpublique verspreidt en promoot muziek- en danstradities via een ambitieus programma van concerten, cursussen en projecten. Een jaarrond concertprogramma met Belgische en internationale artiesten vormt de kern van de activiteiten van de organisatie. Van contemplatieve tot feestelijke concerten vinden het hele jaar door plaats in het prachtige Moli\u00e8re Theater, aan de Naamsepoort, maar ook op verschillende plaatsen de hoofdstad.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":1922,"location":{"lat":50.83785217,"lon":4.3630838},"last_updated_at":"2024-09-10T16:24:23+02:00","published_at":"2013-10-19T01:14:45+02:00","is_in_address_book":true,"is_in_vb_export":false,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/79e57d3b08e8f7dc01ca21184dd3045c30cd758e.jpg","width":5874,"height":3916,"ratio":1.5,"oEmbed_height":3916,"oEmbed_width":5874,"translations":{"de":{"title":"Tamala","copyright":"Dieter Telemans"},"pt":{"title":"Tamala","copyright":"Dieter Telemans"},"en":{"title":"Tamala","copyright":"Dieter Telemans"},"it":{"title":"Tamala","copyright":"Dieter Telemans"},"cn":{"title":"Tamala","copyr