ull,"start":"17:00:00","end":"20:30:00"},{"day":"2022-12-13","doors":null,"start":"17:00:00","end":"20:30:00"},{"day":"2022-12-15","doors":null,"start":"17:00:00","end":"20:30:00"},{"day":"2022-12-20","doors":null,"start":"17:00:00","end":"20:30:00"},{"day":"2022-12-22","doors":null,"start":"17:00:00","end":"20:30:00"},{"day":"2022-12-27","doors":null,"start":"17:00:00","end":"20:30:00"},{"day":"2022-12-29","doors":null,"start":"17:00:00","end":"20:30:00"}],"weekschema":[{"days":{"monday":{"is_open":false},"tuesday":{"is_open":true,"hours":[{"start":"17:00:00","end":"20:30:00"}]},"wednesday":{"is_open":false},"thursday":{"is_open":true,"hours":[{"start":"17:00:00","end":"20:30:00"}]},"friday":{"is_open":false},"saturday":{"is_open":false},"sunday":{"is_open":false}},"translations":{"fr":["lundi, mercredi, vendredi, samedi et dimanche: ferm\u00e9","mardi et jeudi: de 17:00 \u00e0 20:30"],"nl":["maandag, woensdag, vrijdag, zaterdag en zondag: gesloten","dinsdag en donderdag: van 17:00 tot 20:30"],"en":["monday, wednesday, friday, saturday and sunday: closed","tuesday and thursday: from 17:00 to 20:30"]},"date_start":"2020-10-13","date_end":"2022-12-29","is_also_by_appointment":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[15],"translations":{"fr":["Sourd\/malentendant"],"nl":["Doof\/slechthorend"],"en":["Deaf\/hard of hearing"]}},"tags":[],"accessibilities":{"list":[257],"translations":{"fr":["Am\u00e9nagements pour personnes sourdes et malentendantes"],"nl":["Voorzieningen voor dove en slechthorende personen"],"en":["Facilities for deaf and hearing-impaired people"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-09-30T01:09:00+02:00","published_at":"2020-10-13T12:49:04+02:00","backoffice_id":225632,"import_origin":null,"sub_type":"other","show_in_agenda":true,"ranking":0.13527147064909},{"id":525100,"date_start":"2022-08-03","date_end":"2022-11-09","date_next":"2022-10-05","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":84,"translations":{"fr":"Divers","nl":"Varia","en":"Various"}},"others":{}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Bike Experience","shortdescr":"Un \u00e9v\u00e9nement chaleureux o\u00f9 l'on apprend \u00e0 rouler \u00e0 v\u00e9lo en ville !","longdescr":"Chez Bike Experience, on aime surtout la convivialit\u00e9 ! C'est pourquoi, nous vous invitons \u00e0 en apprendre plus sur la conduite en tant que cycliste en terminant par un moment agr\u00e9able, autour d'un verre.\r\nAu programme :\r\nNous commencerons par un rafra\u00eechissement du code de la route en tant que cycliste, que nous mettrons en pratique lors d'une balade \u00e0 v\u00e9lo (possibilit\u00e9 de se voir pr\u00eater un v\u00e9lo, sur demande). Lors de ce tour, vous pourrez vous familiariser \u00e0 l'utilisation du v\u00e9lo et am\u00e9liorer votre confiance en vous gr\u00e2ce \u00e0 une meilleure connaissance de la route.\r\nPour terminer, nous partagerons un verre entre cyclistes, formateur\u00b7rices et coaches lors d'un afterwork fun et amusant. Le moment id\u00e9al pour rencontrer de nouveaux cyclistes comme vous\u2026\r\nEntr\u00e9e GRATUITE et inscription OBLIGATOIRE via notre site web. Pr\u00e9voyez votre sourire, une gourde et \u00e9quipez-vous en cons\u00e9quence.\r\nL'\u00e9v\u00e9nement est accessible \u00e0 toute personne d\u00e9sireuse d'apprendre \u00e0 se d\u00e9placer \u00e0 v\u00e9lo en ville avec plus de s\u00e9r\u00e9nit\u00e9.\r\nNous avons h\u00e2te de vous accueillir nombreux\u00b7ses.","performers":null,"boxoffice_url":null,"website":"https:\/\/bikeexperience.brussels\/","email":"info@bikeexperience.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.525100"},"nl":{"name":"Bike Experience","shortdescr":"Een gezellig evenement waar we leren fietsen in het verkeer !","longdescr":"Bij Bike Experience koppelen we graag het aangename aan het nuttige! Daarom nodigen we je graag uit om meer te leren over hoe je veilig door de stad kan fietsen en sluiten we af met een glaasje samen.\r\nHet programma:\r\nEerst frissen we even de verkeersregels voor fietsers op en dan springen we allen samen op de fiets voor een fietstocht in de stad (je kan een fiets lenen van ons op aanvraag). Tijdens dit ritje zal je wat kunnen wennen aan de fiets en bouw je aan je zelfvertrouwen door de theorie in de praktijk te brengen. Om af te sluiten, nemen we even de tijd om met z'n alle ervaringen uit te wisselen tijdens een drankje. Het perfecte moment om nieuwe fietsers zoals jij te ontmoeten... \r\nGRATIS toegang, maar met VERPLICHTE inschrijving via onze website. Breng je goed humeur en een waterfles mee en zorg voor gepaste fietskledij. \r\nIedereen die wil leren hoe je veiliger door de stad kan fietsen, is welkom.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.525100"},"en":{"name":"Bike Experience","shortdescr":"A welcoming event where we learn how to bike in the traffic !","longdescr":"At Bike Experience, we love friendliness above all! That's why we are inviting you to learn more about navigating the streets as a cyclist and finish up with a pleasant time over a drink together. \r\nOn the agenda:\r\nWe will start with a reminder of the traffic rules as a cyclist, which we will put into practice during a bike ride (bike loan available on request). On this ride you will learn how to use the bike and you will increase your confidence through better knowledge of the road. Finally, we will share a drink with cyclists, trainers and coaches in a fun and entertaining after work session. The perfect time to meet new cyclists like yourself... \r\nFREE entry and COMPULSORY registration via our website. Bring your smile, a bottle and dress yourself accordingly. \r\nThe event is open to anyone who wants to learn how to get around town by bike with more peace of mind. \r\nWe look forward to welcoming many of you!","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.525100"},"de":{"name":"Afterworks Bike Experience","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.525100"},"it":{"name":"Afterworks Bike Experience","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.525100"},"sp":{"name":"Afterworks Bike Experience","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.525100"},"pt":{"name":"Afterworks Bike Experience","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.525100"},"cn":{"name":"Afterworks Bike Experience","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.525100"}},"place":{"id":276270,"translations":{"fr":{"name":"Circularium","address_street_name":"Chauss\u0