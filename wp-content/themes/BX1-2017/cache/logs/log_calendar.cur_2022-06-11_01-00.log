-28T11:35:05+02:00","published_at":"2022-03-28T11:15:06+02:00","backoffice_id":250336,"import_origin":null,"sub_type":"misc","show_in_agenda":true,"ranking":1.2599210498949},{"id":530800,"date_start":"2022-06-30","date_end":"2022-06-30","date_next":"2022-06-30","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Porte de Louvain: tr\u00e9sors cach\u00e9s","shortdescr":"Autour de la Porte de Louvain, aujourd\u2019hui place Madou, se trouvent quelques vestiges d\u2019un Saint-Josse m\u00e9morable : qui sait que, dans les entrelacs de ces rues, une cit\u00e9 d\u2019artistes a vu \u00e9clore plusieurs talents de l\u2019histoire de l\u2019art belge ?","longdescr":"Autour de la Porte de Louvain, aujourd\u2019hui place Madou, se trouvent quelques vestiges d\u2019un Saint-Josse m\u00e9morable : qui sait que, dans les entrelacs de ces rues, une cit\u00e9 d\u2019artistes a vu \u00e9clore plusieurs talents de l\u2019histoire de l\u2019art belge ? Que l\u2019Art nouveau y est aussi pr\u00e9sent dans des \u00e9glises devenues orthodoxes ? Que l\u2019on trouve encore des traces d\u2019une p\u00e9riode cin\u00e9matographique prosp\u00e8re ? Une dose d\u2019histoire agr\u00e9ment\u00e9e d\u2019une pinc\u00e9e d\u2019histoire de l\u2019art, beaucoup de curiosit\u00e9 et l'\u0153il aux aguets, tournez et vous obtiendrez une belle balade d\u2019\u00e9t\u00e9 !","performers":null,"boxoffice_url":null,"website":"http:\/\/www.arau.org","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/5