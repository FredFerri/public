25","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":true,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-06-24T14:22:02+02:00","published_at":"2023-12-18T16:39:37+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":291078,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.2360815978543417,"languages":{"spoken":["en","nl","fr"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[42,36],"translations":{"de":["Malerei","Museen & Kunstzentren"],"pt":[null,null],"en":["Painting","Museums and art centers"],"it":["Pittura","Musei e centri artistici"],"cn":[null,null],"fr":["Peinture","Mus\u00e9es et art centers"],"sp":["Pintura","Museos y centros de arte"],"nl":["Schilderkunst","Musea en kunstcentra"]}}},"translations":{"de":{"name":"Magritte\u00b7Folon","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/fine-arts-museum.be\/en\/exhibitions\/magrittefolon","email":"info@fine-arts-museum.be","phone_contact":"+32 2 508 32 11","phone_booking":"+32 2 508 32 32","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50005450"},"pt":{"name":"Magritte\u00b7Folon","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/fine-arts-museum.be\/fr\/expositions\/magrittefolon","email":"info@fine-arts-museum.be","phone_contact":"+32 2 508 32 11","phone_booking":"+32 2 508 32 32","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50005450"},"en":{"name":"Magritte\u00b7Folon","shortdescr":"The Dream Factory\n\nAs Brussels celebrates the 100th anniversary of surrealism, some of Ren\u00e9 Magritte's works will be traveling and gracing the walls of other exhibitions and museums. The Magritte Museum is taking advantage of this period to create a dialogue between the fascinating world of Ren\u00e9 Magritte (1898-1967) and the poetic creations of Jean-Michel Folon (1934-2005).","longdescr":"Magritte\u00b7Folon is more than an exhibition, it\u2019s a dreamlike encounter and a fruitful dialogue between two unique worlds of imagination.\n\nIn 1954, Jean-Michel Folon was 20 years old. He discovered The Enchanted Domain, the series of murals Magritte had just painted for the Knokke casino. It was a revelation: \"I thought: \u2018One can really do anything in painting. Even invent mysteries.\u2019 That was when I encountered art\", he wrote in 1999.\n\nAlthough the two artists never met, many similarities exist between their visual worlds. Folon considered Magritte, the master of Belgian surrealism and 36 years his senior, \"one of the fathers\" of his generation.\n\nBy opening the paths of mystery in painting, Magritte laid the foundations for Folon's art, which would never cease to explore life\u2019s poetry. This exhibition, held at the very heart of the Mus\u00e9e Magritte, brings together the works of these two major Belgian artists, showcasing the connections in their imagination.\n\nA Magritte Museum exhibition in partnership with the Folon Foundation.\n\nCredit: Jean-Michel Folon, Le r\u00eave \u00e9veill\u00e9, (1971) Mus\u00e9es royaux des Beaux-Arts de Belgique, Brussels \/ photo: J. Geleyns - Art Photography","performers":null,"boxoffice_url":null,"website":"https:\/\/fine-arts-museum.be\/en\/exhibitions\/magrittefolon","email":"info@fine-arts-museum.be","phone_contact":"+32 2 508 32 11","phone_booking":"+32 2 508 32 32","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50005450"},"it":{"name":"Magritte\u00b7Folon","shortdescr":"La produzione poetica\nMentre Bruxelles celebra i 100 anni del Surrealismo, alcune opere di Ren\u00e9 Magritte saranno in viaggio e onoreranno con la loro presenza esposizioni urbane ed extra-urbane. Il Mus\u00e9e Magritte approfitta di questo periodo per immaginare un dialogo tra l'affascinante mondo di Ren\u00e9 Magritte (1898-1967) e le creazioni poetiche di Jean-Michel Folon (1934-2005).","longdescr":"La produzione poetica\nMentre Bruxelles celebra i 100 anni del Surrealismo, alcune opere di Ren\u00e9 Magritte saranno in viaggio e onoreranno con la loro presenza esposizioni urbane ed extra-urbane. Il Mus\u00e9e Magritte approfitta di questo periodo per immaginare un dialogo tra l'affascinante mondo di Ren\u00e9 Magritte (1898-1967) e le creazioni poetiche di Jean-Michel Folon (1934-2005).\nMagritte-Folon non \u00e8 una semplice mostra, ma un incontro onirico e un dialogo fecondo tra due immaginari distinti.\nNel 1954, a 20 anni, Jean-Michel Folon scopre Domaine enchant\u00e9, la serie di murales che Magritte ha appena dipinto per il casin\u00f2 di Knokke. \u00c8 una rivelazione: \"Ho pensato: con la pittura si pu\u00f2 fare davvero tutto. Anche inventare dei misteri. Questo \u00e8 stato il mio incontro con l'arte\", scrive nel 1999.\nAnche se i due artisti non si sono mai incontrati, esiste un\u2019autentica connessione tra i loro mondi. Folon considera il maestro del surrealismo belga, di 36 anni pi\u00f9 anziano, \"uno dei padri\" della sua generazione.\nAprendo le vie del mistero in pittura, Magritte getta le basi dell'arte di Folon, che non avrebbe mai smesso di esplorare i percorsi poetici. La mostra, allestita proprio al Mus\u00e9e Magritte, esalta le opere dei due grandi artisti belgi, con i legami e i linguaggi che li caratterizzano. L\u2019esposizione al Mus\u00e9e Magritte \u00e8 stata realizzata in collaborazione con la Fondazione Folon.\nCredito: Jean-Michel Folon,\u202fLe r\u00eave \u00e9veill\u00e9, (1971) Mus\u00e9es royaux des Beaux-Arts de Belgique, Bruxelles\/foto: J. Geleyns - Art Photography","performers":null,"boxoffice_url":null,"website":"https:\/\/fine-arts-museum.be\/en\/exhibitions\/magrittefolon","email":"info@fine-arts-museum.be","phone_contact":"+32 2 508 32 11","phone_booking":"+32 2 508 32 32","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50005450"},"cn":{"name":"Magritte\u00b7Folon","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/fine-arts-museum.be\/fr\/expositions\/magrittefolon","email":"info@fine-arts-museum.be","phone_contact":"+32 2 508 32 11","phone_booking":"+32 2 508 32 32","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50005450"},"fr":{"name":"Magritte\u00b7Folon","shortdescr":"La fabrique po\u00e9tique\n\nTandis que Bruxelles c\u00e9l\u00e8bre les 100 ans du surr\u00e9alisme, quelques \u0153uvres de Ren\u00e9 Magritte voyageront et honoreront de leur pr\u00e9sence des expositions intra et extra-muros. Le Mus\u00e9e Magritte profite de cette p\u00e9riode pour imaginer un dialogue entre l'univers fascinant de Ren\u00e9 Magritte (1898-1967) et les cr\u00e9ations po\u00e9tiques de Jean-Michel Folon (1934-2005).\n","longdescr":"Magritte\u00b7Folon est plus qu\u2019une exposition : une rencontre onirique et un dialogue f\u00e9cond nou\u00e9 entre deux imaginaires particuliers.\n\nEn 1954, Jean-Michel Folon a 20 ans. Il d\u00e9couvre le Domaine enchant\u00e9, la s\u00e9rie de peintures murales que Magritte vient de r\u00e9aliser pour le casino de Knokke. C\u2019est la r\u00e9v\u00e9lation : \u00ab j\u2019ai pens\u00e9 : \u2018On peut vraiment tout faire en peinture. M\u00eame inventer des myst\u00e8res.\u2019 Voil\u00e0 ma rencontre avec l\u2019art \u00bb, \u00e9crit-il en 1999.\n\nBien que les deux artistes ne se soient jamais rencontr\u00e9s, les connexions sont r\u00e9elles entre leurs univers. Folon consid\u00e8re le ma\u00eetre du surr\u00e9alisme belge, de 36 ans son ain\u00e9, comme \u00ab l\u2019un des p\u00e8res \u00bb de sa g\u00e9n\u00e9ration.\n\nEn ouvrant les chemins du myst\u00e8re en peinture, Magritte porte en germe l\u2019art de Folon, qui n\u2019aura de cesse d\u2019explorer les voies de la po\u00e9sie. Cette exposition, tenue au sein m\u00eame du Mus\u00e9e Magritte, met en r\u00e9sonance les \u0153uvres de ces deux artistes belges majeurs, leurs liens et leurs langages. Une exposition du Mus\u00e9e Magritte en partenariat avec la Fondation Folon.\n\nCr\u00e9dit\u202f: Jean-Michel Folon,\u202fLe r\u00eave \u00e9veill\u00e9, (1971) Mus\u00e9es royaux des Beaux-Arts de Belgique, Bruxelles \/ photo : J. Geleyns - Art Photography","performers":null,"boxoffice_url":null,"website":"https:\/\/fine-arts-museum.be\/fr\/expositions\/magrittefolon","email":"info@fine-arts-museum.be","phone_contact":"+32 2 508 32 11","phone_booking":"+32 2 508 32 32","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50005450"},"sp":{"name":"Magritte\u00b7Folon","shortdescr":"La fabrique po\u00e9tique\nCon motivo de la celebraci\u00f3n en Bruselas del centenario del surrealismo, algunas de las obras de Ren\u00e9 Magritte se mover\u00e1n y formar\u00e1n parte de exposiciones dentro y fuera de la ciudad. El Museo Magritte aprovecha este periodo para crear un di\u00e1logo entre el fascinante universo de Ren\u00e9 Magritte (1898-1967) y las creaciones po\u00e9ticas de Jean-Michel Folon (1934-2005).","longdescr":"La fabrique po\u00e9tique\nCon motivo de la celebraci\u00f3n en Bruselas del centenario del surrealismo, algunas de las obras de Ren\u00e9 Magritte se mover\u00e1n y formar\u00e1n parte de exposiciones dentro y fuera de la ciudad. El Museo Magritte aprovecha este periodo para crear un di\u00e1logo entre el fascinante universo de Ren\u00e9 Magritte (1898-1967) y las creaciones po\u00e9ticas de Jean-Michel Folon (1934-2005).\nMagritte-Folon es m\u00e1s que una exposici\u00f3n: es un encuentro on\u00edrico y un di\u00e1logo f\u00e9rtil entre dos imaginaciones especiales.\nEn 1954, Jean-Michel Folon ten\u00eda 20 a\u00f1os. Descubri\u00f3 Domaine enchant\u00e9, la serie de murales que Magritte acababa de pintar para el casino de Knokke. Fue una revelaci\u00f3n: \u00abPens\u00e9: \u201cCon la pintura se puede hacer cualquier cosa; incluso inventar misterios\u201d. Ese fue mi encuentro con el arte\u00bb, escribi\u00f3 en 1999.\nAunque los dos artistas no llegaron a conocerse, existe una conexi\u00f3n real entre sus mundos. Folon considera al maestro del surrealismo belga, 36 a\u00f1os mayor que \u00e9l, \u00abuno de los padres\u00bb de su generaci\u00f3n.\nAl abrir las v\u00edas del misterio en la pintura, Magritte sent\u00f3 las bases del arte de Folon, que nunca dejar\u00eda de explorar los caminos de la poes\u00eda. Esta exposici\u00f3n, celebrada en el Museo Magritte, re\u00fane las obras de estos dos grandes artistas belgas, sus v\u00ednculos y sus lenguajes. Exposici\u00f3n del Museo Magritte en colaboraci\u00f3n con la Fondation Folon.\nCr\u00e9ditos: Jean-Michel Folon,\u202fLe r\u00eave \u00e9veill\u00e9, (1971) - Museos Reales de Bellas Artes de B\u00e9lgica, Bruselas \/ foto: J. Geleyns - Art Photography","performers":null,"boxoffice_url":null,"website":"https:\/\/fine-arts-museum.be\/en\/exhibitions\/magrittefolon","email":"info@fine-arts-museum.be","phone_contact":"+32 2 508 32 11","phone_booking":"+32 2 508 32 32","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50005450"},"nl":{"name":"Magritte\u00b7Folon","shortdescr":"De po\u00ebziefabriek\n\nBrussel viert de 100ste verjaardag van het surrealisme, en hierdoor zullen enkele werken van Ren\u00e9 Magritte intra en extra muros reizen om in andere tentoonstellingen te pronken. Het Magritte Museum maakt van deze gelegenheid gebruik om een dialoog te cre\u00ebren tussen het fascinerende universum van Ren\u00e9 Magritte (1898-1967) en de po\u00ebtische creaties van Jean-Michel Folon (1934-2005).","longdescr":"Magritte\u00b7Folon is meer dan een tentoonstelling. Het is een droomachtige ontmoeting en een vruchtbare dialoog tussen twee bijzondere beeldende werelden.\n\nIn 1954, op 20-jarige leeftijd, ontdekte Jean-Michel Folon Domaine enchant\u00e9, de reeks muurschilderingen die Magritte had gemaakt voor het casino van Knokke. Het is een openbaring: \"Ik dacht: \u2018Men kan waarlijk alles doen in de schilderkunst. Zelfs mysteries bedenken.' Dit was mijn ontmoeting met de kunst,\" schrijft hij in 1999.\n\nHoewel de twee kunstenaars elkaar nooit hebben ontmoet, heeft Folon zijn hele carri\u00e8re lang geweten hoeveel hij verschuldigd was aan de 36 jaar oudere meester van het Belgische surrealisme, die hij beschouwde als \"een van de vaders van mijn generatie\".\n\nMagritte, die in de schilderkunst de deuren van het mysterie opende, legde de basis voor de kunst van Folon, die nooit zal ophouden de paden van de po\u00ebzie te verkennen. Deze tentoonstelling, die plaatsvindt in het hart van het Magritte Museum, vergelijkt de werken van deze twee grote Belgische kunstenaars, hun raakvlakken en hun kunsttalen.\n\nEen tentoonstelling van het Magritte Museum in samenwerking met de Stichting Folon.\n\nCredit: Jean-Michel Folon, Le r\u00eave \u00e9veill\u00e9, (1971) Mus\u00e9es royaux des Beaux-Arts de Belgique, Brussels \/ photo: J. Geleyns - Art Photography","performers":null,"boxoffice_url":null,"website":"https:\/\/fine-arts-museum.be\/nl\/tentoonstellingen\/magrittefolon","email":"info@fine-arts-museum.be","phone_contact":"+32 2 508 32 11","phone_booking":"+32 2 508 32 32","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50005450"}},"place":{"id":246650,"translations":{"de":{"name":"Mus\u00e9e Magritte Museum","address_street_name":"Place Royale","address_street_number":null,"address_street_box":null,"email":"info@fine-arts-museum.be","website":"http:\/\/www.fine-arts-museum.be\/","phone_contact":"+32 2 508 32 11","phone_booking":"+32 2 508 33 33","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Royale","address_line2":"1000 Bruxelles","description_web":null,"description_print":"22\/06\/2022\r\nDas Magritte-Museum begeistert auf 2500 m\u00b2 Ausstellungsfl\u00e4che mit der umfangreichsten Magritte-Sammlung der Welt: Zu sehen gibt es mehr als 200 Werke des ber\u00fchmten belgischen Surrealisten Ren\u00e9 Magritte, darunter \u00d6lgem\u00e4lde, Zeichnungen, Skulpturen und bemalte Objekte ebenso wie Werbeplakate, Musikpartituren, Fotos und Filme von Magritte selbst.\r\n\r\nDie gro\u00dfen Meisterwerke Magrittes: Die ausgestellten Arbeiten, darunter die gro\u00dfen Meisterwerke des K\u00fcnstlers, wie \u201eDie Herrschaft des Lichts\" (L\u2019Empire de Lumi\u00e8res), \u201eDie R\u00fcckkehr\" (Le Retour), \u201eDie Suche nach der Wahrheit\" (La Recherche de la v\u00e9rit\u00e9), \u201eHimmelsvogel\" (L\u2019Oiseau de Ciel) und \u201eDie Domaine von Arnheim\" (Le Domaine d\u2019Arnheim) sind hier versammelt. Sie stammen gr\u00f6\u00dftenteils aus Verm\u00e4chtnissen und Neuerwerbungen des Museums der Sch\u00f6nen K\u00fcnste, die durch private Leihgaben erg\u00e4nzt wurden. Das Magritte-Museum gew\u00e4hrt einen tiefen Einblick in das k\u00fcnstlerische Werk Magrittes und genie\u00dft eine weltweite Anerkennung.\r\n\r\nBr\u00fcsseler Museumsattraktion: Das Museum, das sich im H\u00f4tel Althenloh - einem Teil der K\u00f6niglichen Museen der Sch\u00f6nen K\u00fcnste - befindet, erweist sich als echter Publikumsmagnet - in weniger als einem Jahr empfing es mehr als 500 000 Besucher.\r\n\r\nDas Magritte-Museum ist ganz sicher eine der kulturellen Attraktionen Br\u00fcssels. Nicht umsonst erhielt es 2012 den Publikumspreis als bestes Br\u00fcsseler Museum!","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Mus\u00e9e Magritte Museum","address_street_name":"Place Royale","address_street_number":null,"address_street_box":null,"email":"info@fine-arts-museum.be","website":"http:\/\/www.fine-arts-museum.be\/","phone_contact":"+32 2 508 32 11","phone_booking":"+32 2 508 33 33","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Royale","address_line2":"1000 Bruxelles","description_web":null,"description_print":"22\/06\/2022\r\nO Museu Magritte abriu as suas portas no dia 2 de junho de 2009 num edif\u00edcio de 2500 m\u00b2 da propriedade dos Museus Reais das Belas Artes da B\u00e9lgica.\r\nMultidisciplinar, esta cole\u00e7\u00e3o \u00e9 a mais rica do mundo e comporta mais de 200 obras compostas de \u00f3leos em tela, guaches, desenhos, esculturas e objetos pintados, mas tamb\u00e9m de cartazes publicit\u00e1rios, partituras musicais, fotos vintage e filmes realizados pelo pr\u00f3prio Magritte.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Mus\u00e9e Magritte Museum","address_street_name":"Koningsplein","address_street_number":null,"address_street_box":null,"email":"info@fine-arts-museum.be","website":"http:\/\/www.fine-arts-museum.be\/","phone_contact":"+32 2 508 32 11","phone_booking":"+32 2 508 33 33","address_zip":"1000","address_city":"Brussels","address_line1":"Koningsplein","address_line2":"1000 Brussels","description_web":"The Mus\u00e9e Magritte Museum, located in the heart of Brussels, brings together the world's largest collection of the renowned surrealist artist Ren\u00e9 Magritte: 230 works and archives are displayed. The multidisciplinary space houses paintings, gouaches, drawings, sculptures, and painted objects, as well as advertising posters, musical scores, photographs and films. The Museum also has the most important collection from the artist\u2019s \"vache\" period.\r\nThe selection of works exhibited in the Royal Museums of Fine Arts of Belgium is constantly expanding with a changing selection of external loans. With the support of Belgian and foreign museums as well as private collectors, works are being made available that have previously never been exhibited. The visitor can thus discover many treasures that are still in private possession.\r\nThe Mus\u00e9e Magritte Museum has already received 8 nominations and prizes. Every year more than 300,000 visitors come here for all over the world to discover the life and the works of Ren\u00e9 Magritte.\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Mus\u00e9e Magritte Museum","address_street_name":"Place Royale","address_street_number":null,"address_street_box":null,"email":"info@fine-arts-museum.be","website":"http:\/\/www.fine-arts-museum.be\/","phone_contact":"+32 2 508 32 11","phone_booking":"+32 2 508 33 33","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Royale","address_line2":"1000 Bruxelles","description_web":"Situato nel cuore di Bruxelles, il Mus\u00e9e Magritte Museum ospita la pi\u00f9 grande collezione al mondo di opere del grande artista belga, con un\u2019esposizione di 230 opere e archivi. Lo spazio multidisciplinare riunisce dipinti, gouache, disegni, sculture, oggetti dipinti, oltre a manifesti pubblicitari, spartiti musicali, fotografie e film. Il Museo ospita inoltre la pi\u00f9 importante collezione di opere del periodo \"vache\" (vacche) dell'artista.\nIl Mus\u00e9e Magritte Museum vanta un allestimento dinamico: le opere in mostra nei 2.500 m\u00b2 di spazio espositivo cambiano regolarmente, grazie alla fiducia di collezionisti privati e istituzioni pubbliche che acconsentono a prestiti di opere a lungo termine. La ricchezza delle collezioni dei Mus\u00e9es royaux des Beaux-Arts de Belgique permette di creare innumerevoli dialoghi anche con altri artisti.\nIl Mus\u00e9e Magritte Museum ha gi\u00e0 ottenuto otto nomination e riconoscimenti. Ogni anno, oltre 300.000 visitatori provenienti da tutto il mondo vengono a conoscere la vita e l'opera di Ren\u00e9 Magritte.","description_print":"22\/06\/2022\r\nIl Museo Magritte di Bruxelles ospita la pi\u00f9 ampia collezione al mondo di opere di Ren\u00e9 Magritte, il celebre pittore surrealista.\r\n\r\nAperto il 2 giugno 2009, ospitato nell'Hotel Althenloh un edificio appartenente ai Musei Reali delle Belle Arti, il museo \u00e8 un centro di riferimento mondiale per lo studio e la conoscenza dell'artista.\r\n\r\nLe opere esposte, tra cui i pi\u00f9 grandi capolavori del pittore, provengono principalmente da lasciti, da acquisti dei Musei reali delle Belle Arti e da prestiti privati.\r\n\r\nLa collezione conta pi\u00f9 di 200 opere tra cui oli su tela, gouache, sculture e di oggetti dipinti ma anche manifesti pubblicitari, spartiti musicali, foto e film realizzati dallo stesso Magritte, maestro del surrealismo.\r\n","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Mus\u00e9e Magritte Museum","address_street_name":"Place Royale","address_street_number":null,"address_street_box":null,"email":"info@fine-arts-museum.be","website":"http:\/\/www.fine-arts-museum.be\/","phone_contact":"+32 2 508 32 11","phone_booking":"+32 2 508 33 33","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Royale","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Mus\u00e9e Magritte Museum","address_street_name":"Place Royale","address_street_number":null,"address_street_box":null,"email":"info@fine-arts-museum.be","website":"http:\/\/www.fine-arts-museum.be\/","phone_contact":"+32 2 508 32 11","phone_booking":"+32 2 508 33 33","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Royale","address_line2":"1000 Bruxelles","description_web":"Le Mus\u00e9e Magritte Museum, situ\u00e9 au c\u0153ur de Bruxelles, rassemble la plus importante collection au monde de l\u2019incontournable artiste belge, Ren\u00e9 Magritte : 230 \u0153uvres et archives y sont pr\u00e9sent\u00e9es. L\u2019espace multidisciplinaire r\u00e9unit \u00e0 la fois des tableaux, des gouaches, des dessins, des sculptures, des objets peints, mais aussi des affiches publicitaires, des partitions de musique, des photographies et des films. Le Mus\u00e9e contient \u00e9galement la collection la plus importante de la p\u00e9riode \u00ab vache \u00bb de l\u2019artiste.\r\nL'accrochage du Mus\u00e9e Magritte Museum est con\u00e7u de mani\u00e8re dynamique : les \u0153uvres expos\u00e9es dans les 2.500 m\u00b2 du lieu changent r\u00e9guli\u00e8rement gr\u00e2ce \u00e0 la confiance des collectionneurs priv\u00e9s et des institutions publiques qui pr\u00eatent des \u0153uvres \u00e0 long terme au Mus\u00e9e. La richesse des collections des Mus\u00e9es royaux des Beaux-Arts de Belgique permet de cr\u00e9er de nombreux dialogues avec d'autres artistes.\r\nLe Mus\u00e9e Magritte Museum a d\u00e9j\u00e0 remport\u00e9 huit nominations et r\u00e9compenses. Chaque ann\u00e9e, plus de 300.000 visiteurs venus du monde entier y d\u00e9couvrent la vie et l'\u0153uvre de Ren\u00e9 Magritte.\r\n\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Museo Magritte","address_street_name":"Place Royale","address_street_number":null,"address_street_box":null,"email":"info@fine-arts-museum.be","website":"http:\/\/www.fine-arts-museum.be\/","phone_contact":"+32 2 508 32 11","phone_booking":"+32 2 508 33 33","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Royale","address_line2":"1000 Bruxelles","description_web":"El Museo Magritte, situado en el coraz\u00f3n de Bruselas, alberga la mayor colecci\u00f3n del mundo de obras del gran artista belga Ren\u00e9 Magritte: se exponen 230 obras y archivos. El espacio multidisciplinar re\u00fane pinturas, aguadas, dibujos, esculturas y objetos pintados, as\u00ed como carteles publicitarios, partituras musicales, fotograf\u00edas y pel\u00edculas. El museo tambi\u00e9n alberga la colecci\u00f3n m\u00e1s importante del periodo \"\u00abvache\u00bb del artista.\nEl Museo Magritte est\u00e1 concebido para ser din\u00e1mico: las obras expuestas en los 2.500 m\u00b2 de exposici\u00f3n cambian peri\u00f3dicamente gracias a la confianza de coleccionistas privados e instituciones p\u00fablicas que prestan obras al museo a largo plazo. La riqueza de las colecciones de los Reales Museos de Bellas Artes de B\u00e9lgica permite crear numerosos di\u00e1logos con otros artistas.\nEl Museo Magritte ha obtenido ya ocho nominaciones y premios. Cada a\u00f1o, m\u00e1s de 300.000 visitantes de todo el mundo descubren la vida y obra de Ren\u00e9 Magritte.","description_print":"22\/06\/2022\r\nUbicado en la Place Royale de Bruselas, el Museo Magritte Museum presenta las obras del pintor belga Ren\u00e9 Magritte, un artista prol\u00edfico y maestro del surrealismo.\r\n\r\nEn el barrio de los museos de Bruselas, te esperan m\u00e1s de 200 obras del pintor surrealista belga Ren\u00e9 Magritte, en el Hotel Altenloh, un antiguo edificio neocl\u00e1sico que data de finales del s. XVIII.\r\n\r\nLa excepcional colecci\u00f3n del museo est\u00e1 compuesta de \u00f3leos, gouaches, dibujos, esculturas y objetos pintados, pero tambi\u00e9n carteles publicitarios, partituras de m\u00fasica, fotograf\u00edas Vintage y pel\u00edculas realizadas por el propio Magritte.\r\n\r\nLas obras presentadas, como la del Imperio de las Luces, provienen principalmente de legados y compras de los Museos Reales de Bellas Artes de B\u00e9lgica, completados por pr\u00e9stamos privados.\r\n","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Mus\u00e9e Magritte Museum","address_street_name":"Koningsplein","address_street_number":null,"address_street_box":null,"email":"info@fine-arts-museum.be","website":"http:\/\/www.fine-arts-museum.be\/","phone_contact":"+32 2 508 32 11","phone_booking":"+32 2 508 33 33","address_zip":"1000","address_city":"Brussel","address_line1":"Koningsplein","address_line2":"1000 Brussel","description_web":"Het Mus\u00e9e Magritte Museum, in het hart van Brussel, is met zijn meer dan 230 werken en archiefstukken de belangrijkste verzameling ter wereld van de Belgische kunstenaar Ren\u00e9 Magritte. De multidisplinaire opstelling toont zijn schilderijen, \r\ngouaches, tekeningen, beelden, beschilderde objecten, maar ook zijn publicitaire affiches, muziekpartituren, foto\u2019s en films. Het Museum beschikt eveneens over de belangrijkste collectie werken uit zijn \"vache\"-periode.\r\n\r\nDe tentoongestelde selectie werken uit de Koninklijke Musea voor Schone Kunsten van Belgi\u00eb wordt steeds uitgebreid met een wisselende presentatie van externe bruiklenen. Belgische en buitenlandse musea en priv\u00e9verzamelaars steunen dit museumproject en stellen hun vaak nog nooit eerder getoonde werken ter beschikking. De bezoeker kan daardoor tal van juweeltjes ontdekken die nog steeds in priv\u00e9bezit zijn.\r\nHet Mus\u00e9e Magritte Museum sleepte reeds 8 nominaties en prijzen in de wacht. Jaarlijks komen meer dan 300.000 bezoekers over de vloer, die genieten van 2.500 m\u00b2 expositieruimte.\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[16],"translations":{"de":["K\u00f6nigliches Viertel"],"pt":[null],"en":["Royal"],"it":["Quartiere reale"],"cn":[null],"fr":["Quartier Royal"],"sp":["Quartier Royal \u2014Barrio de la Corte\u2014"],"nl":["Koninklijke wijk"]}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":null,"facebook_id":null,"backoffice_id":8873,"location":{"lat":50.8424508,"lon":4.3592446},"region":"brussels","last_updated_at":"2024-05-29T15:53:33+02:00","published_at":"2013-10-19T01:24:53+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":488,"translations":{"de":{"name":"Mus\u00e9es Royaux des Beaux-Arts de Belgique","address_street_name":"Rue de la R\u00e9gence","address_street_number":"3","address_street_box":null,"email":"info@fine-arts-museum.be","website":"http:\/\/www.fine-arts-museum.be","phone_contact":"+32 2 508 32 11","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la R\u00e9gence, 3","address_line2":"1000 Bruxelles","description_web":"Die Mus\u00e9es Royaux des Beaux-Arts de Belgique \u2013 6 Museen, 7 Jahrhunderte der sch\u00f6nen K\u00fcnste, 20 000 Kunstwerke und Kunstgenuss vom Feinsten:\r\n\r\n\u2022\tIm Mus\u00e9e Magritte gibt es die weltweit gr\u00f6\u00dfte Sammlung von Werken des gro\u00dfen belgischen Surrealisten Ren\u00e9 Magritte zu entdecken\r\n\r\n\u2022\tIm Mus\u00e9e Fin-de-Si\u00e8cle erwartet den Besucher mit K\u00fcnstlern wie Khnopff, Spilliaert, Horta, Rodin, Gauguin, Mucha und Bonnard das besondere Fin-de-Si\u00e8cle-Ambiente, das um 1900 in Br\u00fcssel herrschte. Mehr als 30 K\u00fcnstler \u2013 vom Impressionismus \u00fcber den Jugendstil, von den sch\u00f6nen K\u00fcnsten bis zur Oper.\r\n\r\n\u2022\tIm Mus\u00e9e Old Master gibt es Meisterwerke aus der Epoche des 15. Jahrhunderts bis hin zum 18. Jahrhundert zu sehen, unter anderem mit der weltweit gr\u00f6\u00dften Bruegel-Sammlung, verschiedenen Werken von Rubens, van der Weyden und Jordaens. \r\n\r\n\u2022\tDas Mus\u00e9e Modern Art zeigt eine Auswahl von Meisterwerken des 20. Jahrhunderts, darunter Broodthaers, Fabre, David, Panamarenko, Alechinsky.\r\n\r\n\u2022\tDie beiden Kunstatelier-Museen Mus\u00e9e Wiertz und Meunier in Ixelles geben einen faszinierenden Einblick in die Welt dieser beiden K\u00fcnstler.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Mus\u00e9es Royaux des Beaux-Arts de Belgique","address_street_name":"Rue de la R\u00e9gence","address_street_number":"3","address_street_box":null,"email":"info@fine-arts-museum.be","website":"http:\/\/www.fine-arts-museum.be","phone_contact":"+32 2 508 32 11","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la R\u00e9gence, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Royal Museums of Fine Arts of Belgium","address_street_name":"rue de la R\u00e9gence","address_street_number":"3","address_street_box":null,"email":"info@fine-arts-museum.be","website":"http:\/\/www.fine-arts-museum.be","phone_contact":"+32 2 508 32 11","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"rue de la R\u00e9gence, 3","address_line2":"1000 Brussels","description_web":"The Royal Museums of Fine Arts of Belgium assemble six different museums: the Oldmasters Museum, Modern Museum, Meunier Museum, Wiertz Museum, Magritte Museum and the Fin-de-Si\u00e8cle Museum.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Museo Reale delle Belle Arti del Belgio","address_street_name":"Rue de la R\u00e9gence","address_street_number":"3","address_street_box":null,"email":"info@fine-arts-museum.be","website":"http:\/\/www.fine-arts-museum.be\/","phone_contact":"+32 2 508 32 11","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la R\u00e9gence, 3","address_line2":"1000 Bruxelles","description_web":"I Musei Reali delle Belle Arti del Belgio sono sei musei di Bruxelles: l'Oldmasters Museum, il Mus\u00e9e Modern, il Meunier Museum, il Wiertz Museum, il Magritte Museum ed il Fin-de-si\u00e8cle Museum.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Mus\u00e9es Royaux des Bea