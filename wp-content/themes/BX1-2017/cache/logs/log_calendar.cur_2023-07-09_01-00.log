earing"],"de":["Schulen","Kinder 3-6 Jahre","Kinder 6-9 Jahre","Kinder 9-12 Jahre","Lehrkr\u00e4fte","Familie","Jugendliche 12-15 Jahre","LGTBQIA","Jugendliche 15-18 Jahre","Senioren","Geh\u00f6rlose\/H\u00f6rbehinderte"],"it":["Scuole","Bambini 3-6 anni","Bambini 6-9 anni","Bambini 9-12 anni","Insegnanti","Famiglie","Ragazzi 12-15 anni","LGTBQIA","Ragazzi 15-18 anni","Anziani","Non udenti\/ipoudenti"],"sp":["Escuelas","Ni\u00f1os de 3 a 6 a\u00f1os","Ni\u00f1os de 6 a 9 a\u00f1os","Ni\u00f1os de 9 a 12 a\u00f1os","Profesores","Familias","J\u00f3venes de 12 a 15 a\u00f1os","LGTBQIA","J\u00f3venes de 15 a 18 a\u00f1os","Personas de la tercera edad","Personas sordas o con problemas de audici\u00f3n"],"pt":[null,null,null,null,null,null,null,null,null,null,null],"cn":[null,null,null,null,null,null,null,null,null,null,null]}},"opening":{"day":"2023-06-13","start":"18:30:00","timestamp":"2023-06-13T18:30:00+02:00","end":"21:30:00","is_only_by_appointment":false},"tags":["kids","annee_art_nouveau"],"is_part_of":"Ann\u00e9e Art Nouveau","accessibilities":{"list":[255,265,266],"translations":{"fr":["Accessible","WC adapt\u00e9","Brussels Health Safety Label"],"nl":["Toegankelijk","Aangepast toilet","Brussels Health Safety Label"],"en":["Accessible","Adapted toilet","Brussels Health Safety Label"],"de":["Barrierefrei","Barrierefreies WC","Brussels Health Safety Label"],"it":["Accessibile","WC idoneo","Brussels Health Safety Label"],"sp":["Habilitado","Ba\u00f1os adaptados","Brussels Health Safety Label"],"pt":[null,null,null],"cn":[null,null,null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2023-07-08T02:38:09+02:00","published_at":"2022-11-15T08:33:09+01:00","backoffice_id":265586,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.25984142030594},{"id":555594,"date_start":"2023-05-27","date_end":"2023-09-24","date_next":"2023-07-08","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":true,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung","it":"Esposizioni","sp":"Exhibici\u00f3n","pt":null,"cn":null}},"others":{"list":[36,37],"translations":{"fr":["Mus\u00e9es et art centers","Arts audiovisuels"],"nl":["Musea en kunstcentra","Audiovisuele kunst"],"en":["Museums and art centers","Audiovisual art"],"de":["Museen & Kunstzentren","Audiovisuelle K\u00fcnste"],"it":["Musei e centri artistici","Arti audiovisive"],"sp":["Museos y centros de arte","Artes audiovisuales"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Trevor Mathison - 'From Signal To Decay: Volume 4'","shortdescr":"Comment le son se d\u00e9place-t-il dans l'espace ? Cette question forme le point d\u00e9part pour la s\u00e9rie From Signal to Decay de Mathison dont la quatri\u00e8me partie sera pr\u00e9sent\u00e9e sur nos deux \u00e9tages.","longdescr":"so\u0253\u0279\u0250 pr\u00e9sente From Signal To Decay : Volume 4, la premi\u00e8re exposition individuelle du compositeur et artiste audiovisuel britannique Trevor Mathison en Belgique.\r\n\r\nMathison est l\u2019un des membres fondateurs du l\u00e9gendaire collectif artistique multim\u00e9dia Black Audio Film Collective o\u00f9 il a jou\u00e9 un r\u00f4le essentiel en d\u00e9veloppant un langage sonore combinant des \u00e9l\u00e9ments de dub, de musique concr\u00e8te et industrielle. Parall\u00e8lement \u00e0 ces activit\u00e9s, il a \u00e9galement produit une \u0153uvre puissante \u00e0 titre individuel.\r\n\r\nPour so\u0253\u0279\u0250, Mathison pr\u00e9sente un ensemble unique d\u2019\u0153uvres pour la plupart r\u00e9centes explorant divers m\u00e9dias et techniques. Dans l\u2019exposition, il se concentre sur les fa\u00e7ons dont le son voyage dans l\u2019espace puis se d\u00e9sint\u00e8gre, tout en associant \u00e0 ce processus une multiplicit\u00e9 de strates sociopolitiques sp\u00e9cifiques au site.\r\n\r\nLors d\u2019une visite r\u00e9alis\u00e9e au d\u00e9but de l\u2019ann\u00e9e, Mathison s\u2019est lanc\u00e9 dans une investigation sonore du b\u00e2timent so\u0253\u0279\u0250, r\u00e9alisant de nombreux enregistrements dans ses espaces ainsi que dans le quartier. Ancien entrep\u00f4t de m\u00fbrissement de bananes construit dans les ann\u00e9es 1960, la fonction originale du b\u00e2timent so\u0253\u0279\u0250 est \u00e9troitement li\u00e9e au commerce et \u00e0 la distribution de ce produit \u00e0 l\u2019\u00e9chelle mondiale. Jusqu\u2019au d\u00e9but du 20e si\u00e8cle, ce commerce se situait principalement dans le quartier d\u2019so\u0253\u0279\u0250, o\u00f9 les bananes \u00e9taient import\u00e9es du Congo. Les \u00e9chos de cette activit\u00e9 persistent dans le tissu urbain bruxellois, notamment \u00e0 travers des r\u00e9f\u00e9rences visuelles sur les b\u00e2timents. Les routes commerciales de la banane se sont ensuite progressivement d\u00e9plac\u00e9es vers l\u2019Am\u00e9rique latine. Chose \u00e9tonnante, ce n\u2019est qu\u2019alors que le b\u00e2timent so\u0253\u0279\u0250 est devenu un entrep\u00f4t de stockage de ces fruits.\r\n\r\nargos vous propose de \u00ab payer ce que vous pouvez\u00bb : on vous invite \u00e0 r\u00e9fl\u00e9chir \u00e0 ce qu'il vous convient et \u00e0 contribuer selon vos moyens financiers. (contribution sugg\u00e9r\u00e9e: 8\u20ac)","performers":null,"boxoffice_url":null,"website":"https:\/\/www.argosarts.org\/event\/trevor-mathison-from-signal-to-decay-volume-4","email":"info@argosarts.org","phone_contact":null,"phone_booking":"+32 2 229 00 03","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.555594"},"nl":{"name":"Trevor Mathison - 'From Signal To Decay: Volume 4'","shortdescr":"Hoe beweegt geluid zich door de ruimte? En hoe krijgen klanken dan een andere politieke gelaagdheid? Deze vragen liggen aan de basis van Mathison's serie From Signal to Decay, waarvan het vierde luik zich straks door het hele \u24d0\u24e1\u24d6\u24de\u24e2 gebouw ontvouwt.","longdescr":"argos stelt voor From Signal To Decay: Volume 4, de Britse componist en audiovisuele kunstenaar Trevor Mathison\u2019s eerste solo tentoonstelling in Belgi\u00eb.\r\n\r\nMathison is een stichtend lid van het legendarische multimediale kunstinitiatief Black Audio Film Collective, waarin hij een centrale rol speelde door een sonische taal in te zetten dat elementen uit dub, concrete en industri\u00eble muziek gebruikte. Parallel met deze activiteiten ontwikkelde hij ook een krachtig oeuvre als individueel kunstenaar.\r\n\r\nVoor argos presenteert Mathison een unieke configuratie van voornamelijk nieuwe werken, uitgevoerd in verschillende media. In de tentoonstelling focust hij zich op de manier waarop geluid zich door de ruimte beweegt en achtereenvolgens uiteenvalt, terwijl hij aan dit proces verschillende sociaal-politieke en aan de locatie specifieke lagen toevoegt.\r\n\r\nTijdens zijn bezoek eerder dit jaar, startte Mathison een geluidsonderzoek van het argos gebouw, waarbij hij meerdere opnames van het gebouw maakte, en van de omliggende wijk. Als voormalig pakhuis voor het rijpen van bananen, gebouwd in de jaren 1960, is de oorspronkelijke functie van het gebouw nauw verbonden aan de wereldwijde handel en distributie van deze producten. Tot het begin van de 20e eeuw vond deze handel vooral plaats in de omgeving van argos, waar bananen uit Congo werden ingevoerd. Sporen van deze activiteit zijn vandaag nog steeds aanwezig in het stedelijk weefsel van Brussel, bijvoorbeeld door visuele verwijzingen op gebouwen. Desondanks verschoven de handelsroutes voor bananen geleidelijk aan naar Latijns-Amerika. Opmerkelijk genoeg werd het gebouw argos net in die periode als opslagplaats voor dit fruit opgericht.\r\n\r\nargos hanteert een pay what you can-systeem : bezoekers betalen de toegangsprijs die het best past bij hun huidige financi\u00eble situatie. (suggestieprijs: 8 \u20ac)","performers":null,"boxoffice_url":null,"website":"https:\/\/www.argosarts.org\/event\/trevor-mathison-from-signal-to-decay-volume-4","email":"info@argosarts.org","phone_contact":null,"phone_booking":"+32 2 229 00 03","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.555594"},"en":{"name":"Trevor Mathison - 'From Signal To Decay: Volume 4'","shortdescr":"How does sound move through space? And how does it get layered politically and sonically through this process? These questions lie at the heart of Mathison's series From Signal to Decay of which the fourth iteration unfolds throughout our building.","longdescr":"\uff41\uff52\uff47\uff4f\uff53 presents From Signal To Decay: Volume 4, British composer and audiovisual artist Trevor Mathison\u2019s first solo-exhibition in Belgium. Mathison is a founding member of the legendary multimedia arts initiative Black Audio Film Collective, for which he is pivotal in establishing a sonic language that incorporates elements of dub, musique concr\u00e8te, and industrial music. Alongside these activities, he also produced a vibrant body of work as an individual artist.\r\n\r\nFor \uff41\uff52\uff47\uff4f\uff53, Mathison presents a unique constellation of mostly new works in a variety of media. In the exhibition, he focuses on the ways in which sound travels through space and consecutively disintegrates, while adding a variety of site-specific socio-political layers to this process.\r\n\r\nDuring a visit earlier this year, Mathison embarked on a sonic investigation of the \uff41\uff52\uff47\uff4f\uff53 building, producing multiple recordings of its premises as well as of its surrounding neighbourhood. As a former banana ripening warehouse built in the 1960s, the original function of the \uff41\uff52\uff47\uff4f\uff53 building is intricately entwined with the global trade and distribution of this produce. Up until the early 20th century, this trade was predominantly situated in the neighbourhood surrounding \uff41\uff52\uff47\uff4f\uff53, where bananas were imported from Congo. Echoes of this activity persist across Brussels\u2019 urban fabric, through visual references on buildings for example. Gradually, however, the banana trade routes shifted towards Latin America. Remarkably, it is only then that the \uff41\uff52\uff47\uff4f\uff53 building was established as a warehouse housing these fruits.\r\n\r\nargos applies the pay what you can-system: visitors are asked to pay according to their own financial situation. (suggested donation: 8\u20ac)","performers":null,"boxoffice_url":null,"website":"https:\/\/www.argosarts.org\/event\/trevor-mathison-from-signal-to-decay-volume-4","email":"info@argosarts.org","phone_contact":null,"phone_booking":"+32 2 229 00 03","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.555594"},"de":{"name":"Trevor Mathison - 'From Signal To Decay: Volume 4'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.argosarts.org\/event\/trevor-mathison-from-signal-to-decay-volume-4","email":"info@argosarts.org","phone_contact":null,"phone_booking":"+32 2 229 00 03","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.555594"},"it":{"name":"Trevor Mathison - 'From Signal To Decay: Volume 4'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.argosarts.org\/event\/trevor-mathison-from-signal-to-decay-volume-4","email":"info@argosarts.org","phone_contact":null,"phone_booking":"+32 2 229 00 03","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.555594"},"sp":{"name":"Trevor Mathison - 'From Signal To Decay: Volume 4'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.argosarts.org\/event\/trevor-mathison-from-signal-to-decay-volume-4","email":"info@argosarts.org","phone_contact":null,"phone_booking":"+32 2 229 00 03","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.555594"},"pt":{"name":"Trevor Mathison - 'From Signal To Decay: Volume 4'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.argosarts.org\/event\/trevor-mathison-from-signal-to-decay-volume-4","email":"info@argosarts.org","phone_contact":null,"phone_booking":"+32 2 229 00 03","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.555594"},"cn":{"name":"Trevor Mathison - 'From Signal To Decay: Volume 4'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.argosarts.org\/event\/trevor-mathison-from-signal-to-decay-volume-4","email":"info@argosarts.org","phone_contact":null,"phone_booking":"+32 2 229 00 03","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.555594"}},"place":{"id":228372,"translations":{"fr":{"name":"argos centre for audiovisuals arts","address_street_name":"Rue du Chantier","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Chantier, 13","address_line2":"1000 Bruxelles","description_web":"Fond\u00e9 en 1989 \u00e0 Bruxelles, argos est un lieu ressource pour la pr\u00e9sentation, la production et le d\u00e9veloppement des arts audiovisuels critiques, ainsi que pour leur distribution, conservation et restauration.\r\n\r\nargos consid\u00e8re l\u2019audiovisuel comme un moyen des plus pertinents pour regarder et comprendre le monde de mani\u00e8re ouverte et int\u00e9gr\u00e9e. Soutenant les voix alternatives dans la soci\u00e9t\u00e9, il favorise le dialogue avec un large \u00e9ventail de partenaires institutionnels ou non, tant \u00e0 Bruxelles qu\u2019ailleurs. argis recherche sans cesse de nouvelles fa\u00e7ons d'impliquer et d\u2019associer les publics les plus larges.\r\n\r\nargos  con\u00e7oit des expositions et programmations, distribue les \u0153uvres audiovisuelles les plus contemporaines et critiques; sa mission par ailleurs constitue, conserve et fait conna\u00eetre un tr\u00e8s important fonds de films et de vid\u00e9os d\u2019artistes. Il comporte \u00e9galement une m\u00e9diath\u00e8que unique en son genre, ouverte aux professionnels et au grand public. Celle-ci inclut une tr\u00e8s large s\u00e9lection de publications et les \u0153uvres audiovisuelles de la collection. De plus, ARGOS d\u00e9veloppe des projets de recherche in\u00e9dits pour pallier les lacunes importantes dans l'histoire de l'art, questionnant les relations entre culture et soci\u00e9t\u00e9.\r\n\r\n\u00c0 travers ces multiples activit\u00e9s, argis a pour objectif de permettre une meilleure compr\u00e9hension du pass\u00e9 et du pr\u00e9sent des arts audiovisuels tout en fournissant les outils pour imaginer et fa\u00e7onner collectivement leur avenir.","description_print":"","booking_url":null,"sort_order":"ARGOS, CENTRE FOR ART & MEDIA","virtual_visit":null},"nl":{"name":"argos centre for audiovisuals arts","address_street_name":"Werfstraat","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Brussel","address_line1":"Werfstraat, 13","address_line2":"1000 Brussel","description_web":"argos werd opgericht in 1989 in Brussel en is een instituut, en bron, voor de studie, productie en vooruitgang van kritische audiovisuele kunsten, evenals de distributie, het behoud en de restauratie ervan.\r\n\r\nargos beschouwt het audiovisuele als een belangrijk middel om op meer open en ge\u00efntegreerde manieren de wereld te bekijken en te begrijpen. We ondersteunen een veelheid aan stemmen in de samenleving en gaan in dialoog met een breed scala aan institutionele en niet-institutionele partners, zowel in Brussel als daarbuiten. Zo willen we een steeds ruimer en \u200b\u200bmeer divers publiek bij onze activiteiten betrekken.\r\n\r\n\u249c\u24ad\u24a2\u24aa\u24ae maakt tentoonstellingen en programma's, distribueert audiovisuele werken en bouwt, beheert en ontsluit een prominente collectie van kunstenaarfilms en -video's. We hebben ook een unieke mediatheek met een ruime selectie van publicaties en de audiovisuele werken van de collectie, die zowel voor professionals als het algemene publiek toegankelijk is. Daarnaast ontwikkelen we originele onderzoeksprojecten met betrekking tot vooraanstaande hiaten in de kunstgeschiedenis en de relatie ervan tot cultuur en maatschappij.\r\n\r\nVia deze verschillende activiteiten wil argos het verleden en het heden van de audiovisuele kunsten beter doorgronden, en ook instrumenten bieden om collectief hun toekomst in te beelden en opnieuw vorm te geven.","description_print":"","booking_url":null,"sort_order":"ARGOS, CENTRE FOR ART & MEDIA","virtual_visit":null},"en":{"name":"argos centre for audiovisuals arts","address_street_name":"Werfstraat\/ Rue du Chantier","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Brussels","address_line1":"Werfstraat\/ Rue du Chantier, 13","address_line2":"1000 Brussels","description_web":"Founded in 1989 in Brussels, argos is an institution and resource for the presentation, production, and study of critical audiovisual arts, as well as for its distribution, conservation and restoration. argos considers the audiovisual as a primary means of looking at and understanding the world in more open and integrated ways. Supporting a multiplicity of voices in society, it fosters dialogue with a broad range of institutional and non-institutional partners, both in Brussels and beyond, and seeks new ways to engage diverse audiences. \r\n\r\nargos makes exhibitions and programmes, distributes moving image works, and builds, preserves, and discloses a prominent collection of artist films and videos. It also houses a unique media library containing a broad selection of publications, as well as the audiovisual works of the collection, which is open to both professionals and the general public. Additionally, it develops original research projects relating to significant gaps in art history and its relationship to culture and society. Through these various activities, argos aims to more fully understand the past and present of audiovisual arts, as well as provide tools to collectively imagine and shape its futures.\r\n","description_print":"","booking_url":null,"sort_order":"ARGOS, CENTRE FOR ART & MEDIA","virtual_visit":null},"de":{"name":"ARGOS centre for audivisual arts","address_street_name":"Rue du Chantier","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Chantier, 13","address_line2":"1000 Bruxelles","description_web":"Das Kunstzentrum Argos wurde 1989 mit dem Ziel gegr\u00fcndet, audiovisuelle Kunstformen zu f\u00f6rdern. Heute gilt das Argos, das in der N\u00e4he des Kanals im Br\u00fcsseler Stadtzentrum niedergelassen ist, als Referenz f\u00fcr diese Kunstformen. Das Programm des Hauses ist vielf\u00e4ltig und reicht von audiovisuellen und visuellen Ausstellungen \u00fcber Film- und Videovorf\u00fchrungen bis hin zu Konferenzen und Perfomances.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"ARGOS centre for audivisual arts","address_street_name":"Rue du Chantier","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Chantier, 13","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"ARGOS centre for audivisual arts","address_street_name":"Rue du Chantier","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Chantier, 13","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"ARGOS centre for audivisual arts","address_street_name":"Rue du Chantier","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Chantier, 13","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"ARGOS centre for audivisual arts","address_street_name":"Rue du Chantier","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Chantier, 13","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":[],"zones":{"list":[19],"translations":{"fr":["Centre