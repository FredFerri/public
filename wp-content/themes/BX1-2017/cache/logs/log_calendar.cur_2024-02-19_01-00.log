-expo.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50002010"},"nl":{"name":"Atlantis - The Immersive Odyssey","shortdescr":"Laat je onderdompelen in de wereld van Atlantis - The Immersive Odyssey! Ervaar de magie met onze meeslepende LED-ruimte, VR-zone voor meerdere gebruikers en interactieve dialogen met Zeus. Boek nu voor een buitengewoon avontuur! ","longdescr":"Duik in een mythische wereld in het hart van Brussel! Onze meeslepende tentoonstelling biedt een boeiende ervaring met een LED-ruimte van 150m\u00b2, een VR-zone voor meerdere gebruikers, interactieve dialoog met Zeus via AI, en nog veel meer. Een onvergetelijk avontuur wacht op je in een spectaculaire mythologische omgeving. Reserveer nu je plek voor een buitengewone ervaring! ","performers":null,"boxoffice_url":null,"website":"https:\/\/www.atlantis-expo.com\/index.php?lang=en","email":"info@atlantis-expo.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50002010"}},"place":{"id":50001018,"translations":{"de":{"name":"Atlantis Expo","address_street_name":"Rue du Mail","address_street_number":"50","address_street_box":"Floor -1","email":"info@atlantis-expo.com","website":"www.atlantis-expo.com","phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue du Mail, 50 \/ Floor -1","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Atlantis Expo","address_street_name":"Rue du Mail","address_street_number":"50","address_street_box":"Floor -1","email":"info@atlantis-expo.com","website":"www.atlantis-expo.com","phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue du Mail, 50 \/ Floor -1","address_line2":"1050 Ixelles","description_web":null,"desc