nt de mutualiser du mat\u00e9riel de brassage, des comp\u00e9tences, un brewpub et une sandwicherie. \r\nC\u00e9dric d'Agalmalt, guide et passionn\u00e9 propose des ateliers ludiques et amusants qui permettent aux participants.es d'acqu\u00e9rir une meilleure connaissance du monde brassicole.\u00a0\r\n\r\nVisites, d\u00e9gustations sur r\u00e9servations.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"CoHop","address_street_name":"Chauss\u00e9e de wavre","address_street_number":"950","address_street_box":null,"email":"gestion@cohop.be","website":"https:\/\/cohop.be\/","phone_contact":"+32 2 742 02 26","phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Chauss\u00e9e de wavre, 950","address_line2":"1040 Etterbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"CoHop","address_street_name":"Chauss\u00e9e de wavre","address_street_number":"950","address_street_box":null,"email":"gestion@cohop.be","website":"https:\/\/cohop.be\/","phone_contact":"+32 2 742 02 26","phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Chauss\u00e9e de wavre, 950","address_line2":"1040 Etterbeek","description_web":"CoHop, de eerste co\u00f6peratieve microbrouwerij in Brussel, is een gedeelde, ecologisch verantwoorde brouwerij die ambachtelijke bieren aanbiedt met een positieve maatschappelijke impact. Het doel is het delen van een plek en meer bepaald het delen van brouwmateriaal, vaardigheden, een brewpub en een broodjeszaak. \r\nC\u00e9dric d'Agalmalt, gids en liefhebber, biedt leuke en onderhoudende workshops aan die de deelnemers een beter inzicht geven in de wereld van het brouwen. \r\n\r\nBezoeken en proeverijen op reservering.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[],"translatio