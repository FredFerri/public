blication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":295798,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"festival","ranking":0.5227579585747102,"languages":{"spoken":["fr"],"subtitles":["en"]},"categories":{"main":{"id":118,"translations":{"de":"Festival","pt":null,"en":"Festival","it":"Festival","cn":null,"fr":"Festival","sp":"Festival","nl":"Festival"}},"others":{"list":[119],"translations":{"de":["Kino"],"pt":[null],"en":["Cinema  "],"it":["Cinema"],"cn":[null],"fr":["Cin\u00e9ma"],"sp":["Cine"],"nl":["Cinema"]}}},"translations":{"de":{"name":"Festival du Film Scientifique de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/ffsbxl.be","email":"equipeffsb@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50007989"},"pt":{"name":"Festival du Film Scientifique de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/ffsbxl.be","email":"equipeffsb@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50007989"},"en":{"name":"Festival du Film Scientifique de Bruxelles","shortdescr":null,"longdescr":"The Festival du Film Scientifique de Bruxelles is a free cultural event during which recent and sometimes exclusive scientific documentaries and films are screened for all to enjoy! It is organised by students from the Cercle des Sciences ASBL at the Universit\u00e9 Libre de Bruxelles, and has been since 2011.\n\nThrough this event, we aim to raise awareness of a wide range of scientific themes, from physics and geography to psychology and technology. The screenings take place during the day and in the evening, for both primary and secondary schools and the general public. The documentaries are also often accompanied by speakers who can provide additional explanations and answer viewers' questions. For more information, see our programme on https:\/\/ffsbxl.be. ","performers":null,"boxoffice_url":null,"website":"https:\/\/ffsbxl.be","email":"equipeffsb@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50007989"},"it":{"name":"Festival du Film Scientifique de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/ffsbxl.be","email":"equipeffsb@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50007989"},"cn":{"name":"Festival du Film Scientifique de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/ffsbxl.be","email":"equipeffsb@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50007989"},"fr":{"name":"Festival du Film Scientifique de Bruxelles","shortdescr":"Tous les soirs, le Festival propose une vari\u00e9t\u00e9 de documentaires scientifiques r\u00e9cents et parfois exclusifs. Les diffusions sont r\u00e9guli\u00e8rement accompagn\u00e9es d'interventions d'expert.e.s, afin de compl\u00e9ter les propos des documentaires et de r\u00e9pondre aux questions du public, tout en restant accessible et compr\u00e9hensible \u00e0 chacun et chacune, quelle que soit sa formation.","longdescr":"Le Festival du Film Scientifique de Bruxelles est un \u00e9v\u00e9nement culturel gratuit durant lequel des diffusions de documentaires et films scientifiques r\u00e9cents et parfois exclusifs sont propos\u00e9s \u00e0 toutes et \u00e0 tous ! Celui-ci est organis\u00e9 par des \u00e9tudiant\u00b7e\u00b7s faisant partie de l\u2019ASBL Cercle des Sciences de l\u2019Universit\u00e9 Libre de Bruxelles et ce depuis 2011.\n\n\u00c0 travers cet \u00e9v\u00e9nement, nous cherchons \u00e0 sensibiliser le monde \u00e0 de nombreuses th\u00e9matiques scientifiques, celles-ci allant de la physique \u00e0 la g\u00e9ographie, tout en passant par la psychologie et la technologie. Les projections ont lieu en journ\u00e9e et en soir\u00e9e, \u00e0 la fois pour les \u00e9coles primaires et secondaires et le public. Les documentaires sont \u00e9galement souvent accompagn\u00e9s d\u2019intervenant\u00b7e\u00b7s pouvant fournir des explications compl\u00e9mentaires et r\u00e9pondre aux questions des spectateur\u00b7trice\u00b7s. Pour plus d\u2019informations, retrouvez notre programme sur https:\/\/ffsbxl.be. ","performers":null,"boxoffice_url":null,"website":"https:\/\/ffsbxl.be","email":"equipeffsb@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50007989"},"sp":{"name":"Festival du Film Scientifique de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/ffsbxl.be","email":"equipeffsb@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50007989"},"nl":{"name":"Festival du Film Scientifique de Bruxelles","shortdescr":null,"longdescr":"Le Festival du Film Scientifique de Bruxelles is een gratis cultureel evenement waarbij recente en soms exclusieve wetenschappelijke documentaires en films worden vertoond waar iedereen van kan genieten! Het wordt georganiseerd door studenten van de Cercle des Sciences ASBL aan de Universit\u00e9 Libre de Bruxelles, en dat al sinds 2011.\n\nMet dit evenement willen we het bewustzijn vergroten voor een breed scala aan wetenschappelijke thema's, van natuurkunde en geografie tot psychologie en technologie. De vertoningen vinden overdag en 's avonds plaats, zowel voor basis- en middelbare scholen als voor het brede publiek. De documentaires worden vaak ook begeleid door sprekers die aanvullende uitleg kunnen geven en vragen van kijkers kunnen beantwoorden. Voor meer informatie, zie ons programma on https:\/\/ffsbxl.be.","performers":null,"boxoffice_url":null,"website":"https:\/\/ffsbxl.be","email":"equipeffsb@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50007989"}},"place":{"id":279852,"translations":{"de":{"name":"Universit\u00e9 Libre de Bruxelles - B\u00e2timent S","address_street_name":"Avenue Jeanne","address_street_number":"44","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Jeanne, 44","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Universit\u00e9 Libre de Bruxelles - B\u00e2timent S","address_street_name":"Avenue Jeanne","address_street_number":"44","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Jeanne, 44","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Universit\u00e9 Libre de Bruxelles - B\u00e2timent S","address_street_name":"Avenue Jeanne","address_street_number":"44","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Jeanne, 44","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Universit\u00e9 Libre de Bruxelles - B\u00e2timent S","address_street_name":"Avenue Jeanne","address_street_number":"44","address_street_box":null,"email":null,"website":null,"pho