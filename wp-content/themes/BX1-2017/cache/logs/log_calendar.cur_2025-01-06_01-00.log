ublished_at":"2024-12-03T15:59:43+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":313011,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"theatre","ranking":1,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":49,"translations":{"de":"Theater","pt":null,"en":"Theatre","it":"Teatro","cn":null,"fr":"Th\u00e9\u00e2tre","sp":"Teatro","nl":"Theater"}},"others":{"list":[54],"translations":{"de":["One Man Show & Comedy"],"pt":[null],"en":["One man show and comedy"],"it":["One man Show e comicit\u00e0"],"cn":[null],"fr":["One man Show et humour"],"sp":["Espect\u00e1culo unipersonal y humor"],"nl":["Onemanshow en humor"]}}},"translations":{"de":{"name":"Harmonie Rouffiange: Hyper","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/fourire.be\/","email":"reservations@fourire.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700004194"},"pt":{"name":"Harmonie Rouffiange: Hyper","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/fourire.be\/","email":"reservations@fourire.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700004194"},"en":{"name":"Harmonie Rouffiange: Hyper","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/fourire.be\/","email":"reservations@fourire.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700004194"},"it":{"name":"Harmonie Rouffiange: Hyper","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/fourire.be\/","email":"reservations@fourire.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700004194"},"cn":{"name":"Harmonie Rouffiange: Hyper","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/fourire.be\/","email":"reservations@fourire.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700004194"},"fr":{"name":"Harmonie Rouffiange: Hyper","shortdescr":"\"Hyper.Je suis Hyper. Hypersensible. Hyper solaire. Hyper lunaire. Hyper. Je suis Hyper. Hyperactive. Hyper complex\u00e9e.   Hyper ext\u00e9nu\u00e9e. Hyper en col\u00e8re. Hyper nerveuse. Hyper d\u00e9\u00e7ue. Hyper triste. Hyper chiante. Hyper contr\u00f4lante.\nHyper. Je suis Hyper. Hyper \u00e0 c\u00f4t\u00e9. Hyper en retard...\n\u00catre Hyper...\u00e7a fait vraiment chier.\"","longdescr":"\"Hyper.Je suis Hyper. Hypersensible. Hyper solaire. Hyper lunaire. Hyper. Je suis Hyper. Hyperactive. Hyper complex\u00e9e.   Hyper ext\u00e9nu\u00e9e. Hyper en col\u00e8re. Hyper nerveuse. Hyper d\u00e9\u00e7ue. Hyper triste. Hyper chiante. Hyper contr\u00f4lante.\nHyper. Je suis Hyper. Hyper \u00e0 c\u00f4t\u00e9. Hyper en retard...\n\u00catre Hyper...\u00e7a fait vraiment chier.\"\nApr\u00e8s le succ\u00e8s de son premier spectacle Surr\u00e9Artiste, Harmonie revient avec son second Spectacle Hyper.\nToujours avec humour, \u00e9motions et charg\u00e9 de personnages hauts en couleur. Un musicien entoure \u00e9galement la com\u00e9dienne afin de nous connecter \u00e0 la th\u00e9matique de l'hypersensibilit\u00e9.\nSi vous avez envie de vous y retrouver ou de mieux vivre votre sensibilit\u00e9 ou celle de votre entourage, ce spectacle est fait pour vous. \nEt pour ceux qui se reconnaissent moins dans cette th\u00e9matique, ou les moins, voir hypo sensible \"sensipppp\", Harmonie aborde aussi des sujets comme l'enseignement ou l'\u00e9tat de notre monde actuel avec  la m\u00eame sinc\u00e9rit\u00e9 et g\u00e9n\u00e9rosit\u00e9 qui la caract\u00e9risent sur sc\u00e8ne.\n\nEcrit et interpr\u00e9t\u00e9 par Harmonie sous le regard complice d'Am\u00e9lie Segers \nMusique et arrangements: Michel Lauricella\nR\u00e9gie: Beno\u00eet Neefs\nPhoto: Igor Mar\u00e9chal","performers":"Ecrit et interpr\u00e9t\u00e9 par Harmonie sous le regard complice d'Am\u00e9lie Segers \nMusique et arrangements: Michel Lauricella\nR\u00e9gie: Beno\u00eet Neefs\nPhoto: Igor Mar\u00e9chal","boxoffice_url":null,"website":"https:\/\/fourire.be\/","email":"reservations@fourire.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700004194"},"sp":{"name":"Harmonie Rouffiange: Hyper","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/fourire.be\/","email":"reservations@fourire.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700004194"},"nl":{"name":"Harmonie Rouffiange: Hyper","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/fourire.be\/","email":"reservations@fourire.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700004194"}},"place":{"id":249081,"translations":{"de":{"name":"Fou Rire","address_street_name":"Avenue des Grenadiers","address_street_number":"48","address_street_box":null,"email":"info@fourire.be","website":"http:\/\/www.fourire.be","phone_contact":"+32 483 59 92 29","phone_booking":"+32 70 66 06 01","address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue des Grenadiers, 48","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Fou Rire","address_street_name":"Avenue des Grenadiers","address_street_number":"48","address_street_box":null,"email":"info@fourire.be","website":"http:\/\/www.fourire.be","ph