on et Roger Deldime ont pass\u00e9 la main \u00e0 Cali Kroonen, mais soyez certains que ce lieu accueille toujours le meilleur de la cr\u00e9ation belge ou \u00e9trang\u00e8re, pour un public qui va des tout-petits aux ados. Attention, les s\u00e9ances (\u00e0 des prix tr\u00e8s d\u00e9mocratiques) se remplissent tr\u00e8s vite. Mieux vaut s\u2019y prendre \u00e0 l\u2019avance.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Th\u00e9\u00e2tre La montagne magique","address_street_name":"Broekstraat","address_street_number":"57","address_street_box":null,"email":"info@montagnemagique.be","website":"http:\/\/www.theatremontagnemagique.be","phone_contact":"+32 2 210 15 90","phone_booking":"+32 2 210 15 90","address_zip":"1000","address_city":"Brussel","address_line1":"Broekstraat, 57","address_line2":"1000 Brussel","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Th\u00e9\u00e2tre La montagne magique","address_street_name":"Rue du Marais","address_street_number":"57","address_street_box":null,"email":"info@montagnemagique.be","website":"http:\/\/www.theatremontagnemagique.be","phone_contact":"+32 2 210 15 90","phone_booking":"+32 2 210 15 90","address_zip":"1000","address_city":"Brussels","address_line1":"Rue du Marais, 57","address_line2":"1000 Brussels","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Kindertheater - Th\u00e9\u00e2tre La montagne magique","address_street_name":"Rue du Marais","address_street_number":"57","address_street_box":null,"email":"info@montagnemagique.be","website":"http:\/\/www.theatremontagnemagique.be","phone_contact":"+32 2 210 15 90","phone_booking":"+32 2 210 15 90","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Marais, 57","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":