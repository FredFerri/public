_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":3952,"location":{"lat":50.80189257,"lon":4.39256459},"last_updated_at":"2022-10-10T10:25:09+02:00","published_at":"2013-10-19T01:16:49+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/2ef7eda71655b5ac788f7fc7b5e28d7bc3ae334f.jpg","width":1181,"height":1772,"ratio":0.67,"oEmbed_height":1772,"oEmbed_width":1181,"translations":{"de":{"title":"les trois petitscochons","copyright":"Th\u00e9\u00e2tre Royal du Peruchet"},"pt":{"title":"les trois petitscochons","copyright":"Th\u00e9\u00e2tre Royal du Peruchet"},"en":{"title":"les trois petitscochons","copyright":"Th\u00e9\u00e2tre Royal du Peruchet"},"it":{"title":"les trois petitscochons","copyright":"Th\u00e9\u00e2tre Royal du Peruchet"},"cn":{"title":"les trois petitscochons","copyright":"Th\u00e9\u00e2tre Royal du Peruchet"},"fr":{"title":"les trois petitscochons","copyright":"Th\u00e9\u00e2tre Royal du Peruchet"},"sp":{"title":"les trois petitscochons","copyright":"Th\u00e9\u00e2tre Royal du Peruchet"},"nl":{"title":"les trois petitscochons","copyright":"Th\u00e9\u00e2tre Royal du Peruchet"}}},{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/a84326fdc4d04bdbc33521d262b4dd52c31ad1e1.jpg","width":3456,"height":4608,"ratio":0.75,"oEmbed_height":4608,"oEmbed_width":3456,"translations":{"de":{"title":"GrandM\u00e9chantLoup","copyright":"Th\u00e9\u00e2tre Royal du Peruchet"},"pt":{"title":"GrandM\u00e9chantLoup","copyright":"Th\u00e9\u00e2tre Royal du Peruchet"},"en":{"title":"GrandM\u00e9chantLoup","copyright":"Th\u00e9\u00e2tre Royal du Peruchet"},"it":{"title":"GrandM\u00e9chantLoup","copyright":"Th\u00e9\u00e2tre Royal du Peruchet"},"cn":{"title":"GrandM\u00e9chantLoup","copyright":"Th\u00e9\u00e2tre Royal du Peruchet"},"fr":{"title":"GrandM\u00e9chantLoup","copyright":"Th\u00e9