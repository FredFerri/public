tart":"10:30:00","end":"18:00:00"}]},"wednesday":{"is_open":true,"hours":[{"start":"10:30:00","end":"18:00:00"}]},"thursday":{"is_open":true,"hours":[{"start":"10:30:00","end":"18:00:00"}]},"friday":{"is_open":true,"hours":[{"start":"10:30:00","end":"18:00:00"}]},"saturday":{"is_open":true,"hours":[{"start":"10:30:00","end":"18:00:00"}]},"sunday":{"is_open":true,"hours":[{"start":"10:30:00","end":"18:00:00"}]}},"translations":{"fr":["lundi: ferm\u00e9","mardi, mercredi, jeudi, vendredi, samedi et dimanche: de 10:30 \u00e0 18:00"],"nl":["maandag: gesloten","dinsdag, woensdag, donderdag, vrijdag, zaterdag en zondag: van 10:30 tot 18:00"],"en":["monday: closed","tuesday, wednesday, thursday, friday, saturday and sunday: from 10:30 to 18:00"],"de":["monday: closed","tuesday, wednesday, thursday, friday, saturday and sunday: from 10:30 to 18:00"],"it":["monday: closed","tuesday, wednesday, thursday, friday, saturday and sunday: from 10:30 to 18:00"],"sp":["monday: closed","tuesday, wednesday, thursday, friday, saturday and sunday: from 10:30 to 18:00"],"pt":["monday: closed","tuesday, wednesday, thursday, friday, saturday and sunday: from 10:30 to 18:00"],"cn":["monday: closed","tuesday, wednesday, thursday, friday, saturday and sunday: from 10:30 to 18:00"]},"date_start":"2022-11-18","date_end":"2023-02-12","is_also_by_appointment":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"},"de":{"name":"Normal"},"it":{"name":"Normal"},"sp":{"name":"Normal"},"pt":{"name":"Normal"},"cn":{"name":"Normal"}},"value":0}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"opening":{"day":"2022-11-17","start":"19:00:00","timestamp":"2022-11-17T19:00:00+01:00","end":"22:30:00","is_only_by_appointment":false},"tags":[],"accessibilities":{"list":[255,256,257,263,265],"translations":{"fr":["Accessible","Am\u00e9nagements pour les personnes aveugles et malvoyantes","Am\u00e9nagements pour personnes sourdes et malentendantes","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9"],"nl":["Toegankelijk","Voorzieningen voor blinde en slechtziende personen","Voorzieningen voor dove en slechthorende personen","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet"],"en":["Accessible","Facilities for blind and partially-sighted persons","Facilities for deaf and hearing-impaired people","Accessible to pedestrians with mobility aids","Adapted toilet"],"de":["Barrierefrei","Anpassungen f\u00fcr blinde und sehbehinderte Menschen","Anpassungen f\u00fcr geh\u00f6rlose und h\u00f6rgesch\u00e4digte Menschen.","Barrierefrei f\u00fcr Fu\u00dfg\u00e4nger mit Gehhilfe","Barrierefreies WC"],"it":[null,null,null,null,null],"sp":[null,null,null,null,null],"pt":[null,null,null,null,null],"cn":[null,null,null,null,null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2023-01-02T01:09:10+01:00","published_at":"2022-10-24T17:33:10+02:00","backoffice_id":264643,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.28433931599528},{"id":545309,"date_start":"2022-11-24","date_end":"2023-03-19","date_next":"2023-01-03","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung","it":null,"sp":null,"pt":null,"cn":null}},"others":{"list":[36,46],"translations":{"fr":["Mus\u00e9es et art centers","Pluridisciplinaire"],"nl":["Musea en kunstcentra","Multidisciplinair"],"en":["Museums and art centers","Multidisciplinary"],"de":["Museen & Kunstzentren","Multidisziplin\u00e4r"],"it":[null,null],"sp":[null,null],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"PHOTO | BRUT BXL Jean-Marie Massou","shortdescr":"PHOTO | BRUT BXL est coordonn\u00e9 par le Centre d\u2019Art Brut et Contemporain La \u00ab S \u00bb Grand Atelier (Vielsalm) en collaboration avec Bruno Decharme, collectionneur et fondateur de abcd-art brut \u00e0 Paris, et 4 organisations partenaires bas\u00e9es \u00e0 Bruxelles : la CENTRALE for contemporary art, Le Botanique , le Art et marges mus\u00e9e et La Tiny Gallery.","longdescr":"Le ART ET MARGES MUS\u00c9E propose une exposition monographique de JEAN-MARIE MASSOU (1950-2020). V\u00e9ritable figure de l'art brut, il a creus\u00e9 pendant plus de trois d\u00e9cennies des gouffres gigantesques et des galeries souterraines \u00e0 la seule force de ses bras pour cr\u00e9er ce qu'il nomme \u00ab Le Temple \u00bb. Dans le m\u00eame temps, il enregistrait des centaines de messages et de r\u00eaves pr\u00e9monitoires sur K7s audio, r\u00e9alisait des centaines de dessins et collages, gravait pierres et rochers tout autour de sa propri\u00e9t\u00e9 isol\u00e9e en pleine for\u00eat dans le Lot. Il appelait cela sa \u00ab mission \u00bb. \u00ab La Mission universelle \u00bb qui vise \u00e0 \u00ab pr\u00e9venir l'humanit\u00e9 que le monde va \u00e0 sa perte, qu'il s'agit de prot\u00e9ger ceux qui restent \u00bb.\r\n\r\nCommissariat : Matthieu Morin (La Belle Brute), Anne-Fran\u00e7oise Rouche (La \u00ab S \u00bb Grand Atelier) et Tatiana Veress (Art et marges mus\u00e9e).\r\n\r\nLe mus\u00e9e pr\u00e9sente \u00e9galement deux projets collaboratifs issus de rencontres entre artistes brut\u00b7es et artistes contemporain\u00b7es articul\u00e9s autour du m\u00e9dium photographique. Ces projets sont mis en sc\u00e8ne par le photographe bruxellois Vincen Beeckman :\r\n\r\nPHOTO | BRUT BXL\r\nSI TU N\u2019VIENS PAS J\u2019TE SCALPE\r\nVINCEN BEECKMAN & LA DEVINI\u00c8RE\r\n24.11.2022 - 15.01.2023\r\nDes photos, des textes, des vid\u00e9os, des captations sonores, des installations\u2026 constituent cette exposition issue du travail men\u00e9 depuis plus de huit ans par le photographe Vincen Beeckman en collaboration avec les r\u00e9sident\u00b7es de La Devini\u00e8re.\r\nCe projet, initi\u00e9 par La \u00ab S \u00bb Grand Atelier, a pour cadre une ancienne ferme pr\u00e8s de Charleroi, La Devini\u00e8re, un lieu de psychoth\u00e9rapie institutionnelle, mais avant tout un lieu de vie, de libert\u00e9 et de confiance r\u00e9ciproque entre r\u00e9sident\u00b7es et soignant\u00b7es.\r\n\r\nCommissariat : Vincen Beeckman et Anne-Fran\u00e7oise Rouche (La \u00ab S \u00bb Grand Atelier)\r\n\r\nPHOTO | BRUT BXL\r\nPARTENAIRES PARTICULIERS\r\nVINCEN BEECKMAN\r\n25.01.2023 - 19.03.2023\r\nRencontres particuli\u00e8res et approches performatives autour du m\u00e9dium photographique. Pour cette seconde exposition qu\u2019il sc\u00e9nographie \u00e0 l\u2019\u00e9tage du Art et marges mus\u00e9e, Vincen Beeckman fait la part belle aux rencontres entre auteur\u00b7ices d\u2019art brut et artistes contemporain\u00b7es. En r\u00e9sidence \u00e0 La \u00ab S \u00bb Grand Atelier depuis plusieurs ann\u00e9es, Vincen Beeckman est le t\u00e9moin privil\u00e9gi\u00e9 de la vie quotidienne en atelier mais aussi des chantiers collaboratifs qui s\u2019y d\u00e9ploient r\u00e9guli\u00e8rement. Anne-Fran\u00e7oise Rouche a par ailleurs choisi de montrer une s\u00e9lection d\u2019\u0153uvres issues de l\u2019atelier Blu Cammello \u00e0 Livourne o\u00f9 l\u2019artiste visuel Riccardo Bargellini s\u2019implique dans des cocr\u00e9ations avec ses participant\u00b7es. Ces pratiques collaboratives font \u00e9cho \u00e0 celles men\u00e9es \u00e0 La \u00ab S \u00bb Grand Atelier.\r\n\r\nCommissariat : Vincen Beeckman et Anne-Fran\u00e7oise Rouche (La \u00ab S \u00bb Grand Atelier)","performers":"Jean-Marie Massou","boxoffice_url":null,"website":"http:\/\/www.artetmarges.be","email":"info@artetmarges.be","phone_contact":"+32 2 533 94 90","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.545309"},"nl":{"name":"PHOTO | BRUT BXL Jean-Marie Massou","shortdescr":"PHOTO | BRUT BXL wordt geco\u00f6rdineerd door het Centre d'Art Brut et Contemporain La \u201cS\u201d Grand Atelier (Vielsalm) in samenwerking met Bruno Decharme, verzamelaar en oprichter van abcd-art brut in Parijs, en 4 Brusselse partnerorganisaties: CENTRALE for contemporary art, Botanique, Art et marges museum en Tiny Gallery.","longdescr":"Het ART ET MARGES MUSEUM brengt een monografische tentoonstelling van JEAN-MARIE MASSOU (1950-2020). Jean-Marie Massou, een echte art brut-figuur, groef meer dan drie decennia lang met de kracht van zijn armen gigantische kloven en ondergrondse galerijen om te cre\u00ebren wat hij \"Le Temple\" noemde. Tegelijkertijd nam hij honderden boodschappen en voorgevoelige dromen op op geluidsbanden, maakte honderden tekeningen en collages, en kerfde stenen en rotsen rondom zijn ge\u00efsoleerde eigendom midden in het bos in de Lot. Hij noemde dit zijn \"missie\". \"De universele missie\", die erop gericht is \"de mensheid te waarschuwen dat de wereld naar de ondergang gaat, dat het zaak is degenen die overblijven te beschermen\".\r\n\r\nCuratoren: Matthieu Morin (La Belle Brute), Anne-Fran\u00e7oise Rouche (La \"S\" Grand Atelier) en Tatiana Veress (Art et marges museum).\r\n\r\nHet museum toont ook twee samenwerkingsprojecten die voortvloeien uit ontmoetingen tussen outsider kunstenaars en hedendaagse kunstenaars rond het medium fotografie. De opstelling van deze projecten werd verzorgd door de Brusselse fotograaf Vincen Beeckman:\r\n\r\nPHOTO | BRUT BXL\r\nSI TU N\u2019VIENS PAS J\u2019TE SCALPE\r\nVINCEN BEECKMAN & LA DEVINI\u00c8RE\r\n24.11.2022 - 15.01.2023\r\nFoto's, teksten, video's, geluidsopnames, installaties... vormen samen deze tentoonstelling, die het resultaat is van het werk dat fotograaf Vincen Beeckman iets meer dan acht jaar geleden ondernam in samenwerking met de bewoners van La Devini\u00e8re.\r\nDit project, een initiatief van La \"S\" Grand Atelier, speelt zich af in een oude boerderij in de buurt van Charleroi, La Devini\u00e8re, een plaats van institutionele psychotherapie, maar vooral een plaats van leven, vrijheid en wederzijds vertrouwen tussen bewoners en verzorgers.\r\n\r\nCuratoren: Vincen Beeckman en Anne-Fran\u00e7oise Rouche (La \u00ab S \u00bb Grand Atelier).\r\n\r\nPHOTO | BRUT BXL\r\nPARTENAIRES PARTICULIERS\r\nVINCEN BEECKMAN\r\n25.01.2023 - 19.03.2023\r\nBijzondere ontmoetingen en performatieve aanpak rond het fotografische medium. Voor deze tweede tentoonstelling, die hij heeft ontworpen op de verdieping van het ART ET MARGES MUSEUM, geeft Vincen Beeckman voorrang aan ontmoetingen tussen art brut-auteurs en hedendaagse kunstenaars. Vincen Beeckman is al enkele jaren in residentie bij La \"S\" Grand Atelier en is een bevoorrechte getuige van het dagelijkse leven in het atelier, maar ook van de samenwerkingsprojecten die er regelmatig plaatsvinden. Anne-Fran\u00e7oise Rouche heeft ook gekozen om een selectie werken te tonen uit de werkplaats Blu Cammello in Livorno, waar beeldend kunstenaar Riccardo Bargellini co-creaties uitvoert met zijn deelnemers. Deze samenwerkingspraktijken komen overeen met die van La \"S\" Grand Atelier.\r\n\r\nCuratoren: Vincen Beeckman en Anne-Fran\u00e7oise Rouche (La \u00ab S \u00bb Grand Atelier)","performers":"Jean-Marie Massou","boxoffice_url":null,"website":"http:\/\/www.artetmarges.be","email":"info@artetmarges.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.545309"},"en":{"name":"PHOTO | BRUT BXL Jean-Marie Massou","shortdescr":"PHOTO | BRUT BXL is coordinated by the Centre d'Art Brut et Contemporain La \u00ab S \u00bb Grand Atelier in collaboration with Bruno Decharme, collector and founder of abcd-art brut in Paris, and 4 partner organisations based in Brussels: CENTRALE for contemporary art, Botanique , Art et marges museum and Tiny Gallery.","longdescr":"The ART ET MARGES MUSEUM presents a monographic exhibition of JEAN-MARIE MASSOU (1950-2020). Jean-Marie Massou, a true figure of art brut, dug gigantic chasms and underground galleries for more than three decades with the strength of his arms to create what he called \"The Temple\". At the same time, he recorded hundreds of messages and premonitory dreams on audio tapes, made hundreds of drawings and collages, carved stones and rocks all around his isolated property in the middle of the forest in the Lot. He called this his \"mission\". \"The universal mission\" which aims to \"warn humanity that the world is going to its ruin, that it is a matter of protecting those who remain\".\r\n\r\nCurators: Matthieu Morin (La Belle Brute), Anne-Fran\u00e7oise Rouche (La \"S\" Grand Atelier) and Tatiana Veress (Art et marges museum).\r\n\r\nThe museum also presents two collaborative projects resulting from encounters between outsider artists and contemporary artists based on the photographic medium. These projects are directed by Brussels-based photographer Vincen Beeckman:\r\n\r\nPHOTO | BRUT BXL\r\nSI TU N\u2019VIENS PAS J\u2019TE SCALPE\r\nVINCEN BEECKMAN & LA DEVINI\u00c8RE\r\n24.11.2022 - 15.01.2023\r\nPhotos, texts, videos, sound recordings, installations... make up this exhibition resulting from the work undertaken a little over eight years ago by photographer Vincen Beeckman in collaboration with the residents of La Devini\u00e8re.\r\nThis project, initiated by La \" S \" Grand Atelier, takes place in an old farm near Charleroi, La Devini\u00e8re, a place of institutional psychotherapy, but above all a place of life, freedom and mutual trust between residents and caregivers.\r\n\r\nCurators: Vincen Beeckman and Anne-Fran\u00e7oise Rouche (La \u00ab S \u00bb Grand Atelier)\r\n\r\nPHOTO | BRUT BXL\r\nPARTENAIRES PARTICULIERS\r\nVINCEN BEECKMAN\r\n25.01.2023 - 19.03.2023\r\nEncounters and performative approaches around the photographic medium. For this second exhibition, which he has designed on the ART ET MARGES MUSEUM first floor, Vincen Beeckman has given pride of place to encounters between authors of art brut and contemporary artists. In residence at La \"S\" Grand Atelier for several years, Vincen Beeckman is the privileged witness of the daily life in the studio but also of the collaborative projects that regularly take place there. Anne-Fran\u00e7oise Rouche has also chosen to show a selection of works from the Blu Cammello workshop in Livorno, where visual artist Riccardo Bargellini is involved in co-creations with his participants. These collaborative practices echo those carried out at La \"S\" Grand Atelier.\r\n\r\nCurators: Vincen Beeckman and Anne-Fran\u00e7oise Rouche (La \u00ab S \u00bb Grand Atelier)","performers":"Jean-Marie Massou","boxoffice_url":null,"website":"http:\/\/www.artetmarges.be","email":"info@artetmarges.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.545309"},"de":{"name":"PHOTO | BRUT BXL Jean-Marie Massou","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.545309"},"it":{"name":"PHOTO | BRUT BXL Jean-Marie Massou","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.545309"},"sp":{"name":"PHOTO | BRUT BXL Jean-Marie Massou","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.545309"},"pt":{"name":"PHOTO | BRUT BXL Jean-Marie Massou","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.545309"},"cn":{"name":"PHOTO | BRUT BXL Jean-Marie Massou","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.545309"}},"place":{"id":738,"translations":{"fr":{"name":"Art et marges mus\u00e9e","address_street_name":"Rue Haute","address_street_number":"314","address_street_box":null,"email":"info@artetmarges.be","website":"http:\/\/www.artetmarges.be","phone_contact":"+32 2 533 94 90","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Haute, 314","address_line2":"1000 Bruxelles","description_web":"Situ\u00e9 au c\u0153ur de Bruxelles, le Art et marges mus\u00e9e, mus\u00e9e d\u2019art brut - contemporain - outsider art, questionne l\u2019art et ses fronti\u00e8res. Sa collection s\u2019est constitu\u00e9e d\u00e8s le milieu des ann\u00e9es 80 aupr\u00e8s d\u2019artistes autodidactes, d\u2019ateliers artistiques pour personnes porteuses d\u2019un handicap mental ou d\u2019ateliers en milieu psychiatrique. Elle se compose aujourd\u2019hui de plus de 4000 \u0153uvres internationales produites en dehors des sentiers fr\u00e9quent\u00e9s de l\u2019art. Ses expositions temporaires, au rythme de deux \u00e0 trois par an, m\u00ealent artistes de part et d\u2019autre de la marge et questionnent l\u2019art et sa d\u00e9finition-m\u00eame. ","description_print":"Mus\u00e9e d'art outsider","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Art & marges museum","address_street_name":"Hoogstraat","address_street_number":"314","address_street_box":null,"email":"info@artetmarges.be","website":"http:\/\/www.artetmarges.be","phone_contact":"+32 2 533 94 90","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Hoogstraat, 314","address_line2":"1000 Brussel","description_web":"Outsiderkunst museum. Sinds zijn oprichting in 1984 en de eerste tentoonstelling in 1986, verdedigt de vzw Art en Marge - het huidige art )&( marges museum - kunstenaars die uit de boot van het offici\u00eble culturele circuit vallen. Die autodidactische kunstenaars worden \u201coutsiders\u201d genoemd en werken alleen of in creatieve workshops voor zieke of gehandicapte personen. Naast de permanente verzameling, zorgen tijdelijke tentoonstellingen voor een dynamische dialoog met de werken van professionele kunstenaars die actief zijn in het offici\u00eble culturele milieu, om de grenzen van de in- en outsiderkunst af te tasten. art )&( marges museum is geen ghettomuseum maar een plaats van uitwisseling, een ruimte waarin de individualiteit hoogtij viert en waarin alles in het werk gesteld wordt om ervoor te zorgen dat alle doelgroepen zich thuis voelen.\r\n\r\nOpen op vrijdag, zaterdag en zondag tussen 11.00 en 17.30 uur, alleen op afspraak.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Art & marges museum","address_street_name":"Rue Haute","address_street_number":"314","address_street_box":null,"email":"info@artetmarges.be","website":"http:\/\/www.artetmarges.be","phone_contact":"+32 2 533 94 90","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue Haute, 314","address_line2":"1000 Brussels","description_web":"Museum of outsider art. Since its founding in 1984 and the first exhibition of 1986, Art & Marge \u2013 now the \u2018art )&( marges [margins] museum\u2019 \u2013 promotes artists outside the mainstream. These self-taught artists, often called \u201coutsider artists\u201d, work either individually or in creative workshops in institutions for people who are mentally unwell or who are mentally challenged. In addition to the permanent collection,  temporary exhibitions will establish a dynamic dialogue with paintings by professional artists from the mainstream who are active in their cultural surroundings \u2013 the boundary between \u2018insider\u2019 and \u2018outsider\u2019 art?   The \u2018Art & Marges\u2019 museum is not a ghetto museum but a venue for exchange, where individuality is of prime importance and where all efforts are made to make all target groups feel at home.\r\n\r\nOpen Fridays, Saturdays and Sundays between 11.00 am and 5.30 pm by appointment only.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Mus\u00e9e Art et marges","address_street_name":"Rue Haute","address_street_number":"314","address_street_box":null,"email":"info@artetmarges.be","website":"http:\/\/www.artetmarges.be","phone_contact":"+32 2 533 94 90","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Haute, 314","address_line2":"1000 Bruxelles","description_web":"Art brut - Outsider Art - Zeitgen\u00f6ssische Kunst\r\n\r\nDas Museum Art et Marges zeigt eine Sammlung, die seit den 1980er-Jahren kontinuierlich w\u00e4chst. Dabei handelt es sich um Kunst abseits des Mainstreams, die einen Blick auf die autodidaktischen K\u00fcnslter wirft, Kunstateliers f\u00fcr Menschen mit geistiger Behinderung oder in Psychiatrien. \r\nIn den Ausstellungen mischen sich K\u00fcnstler diesseits und jenseits der Grenze des \"Au\u00dfenseitertums\" (engl. Begriff \"Art Outsider\"), die die Kunst und deren Beschr\u00e4nkungen hinterfragt.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Mus\u00e9e Art et marges","address_street_name":"Rue Haute","address_street_number":"314","address_street_box":null,"email":"info@artetmarges.be","website":"http:\/\/www.artetmarges.be","phone_contact":"+32 2 533 94 90","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Haute, 314","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Museo Art)&(Marges","address_street_name":"Rue Haute","address_street_number":"314","address_street_box":null,"email":"info@artetmarges.be","website":"http:\/\/www.artetmarges.be","phone_contact":"+32 2 533 94 90","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Haute, 314","address_line2":"1000 Bruxelles","description_web":"Desde su creaci\u00f3n, el Centro de Investigaci\u00f3n y Difusi\u00f3n del arte outsider Art en Marge (que se convirti\u00f3 posteriormente en el museo Art)&Marges) aboga por los artistas que no forman parte del circuito cultural oficial. Los conocidos actualmente como \u00aboutsiders\u00bb (ver glosario) son creadores autodidactas que trabajan solos o en talleres creativos para personas psicol\u00f3gicamente vulnerables o con alguna discapacidad mental. Algunos son internos de residencias para discapacitados mentales, hospitales psiqui\u00e1tricos, y otros son trabajadores o extrabajadores de una amplia gama de profesiones: fot\u00f3grafos, anticuarios, zapateros, m\u00fasicos...","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Art et marges mus\u00e9e","address_street_name":"Rue Haute","address_street_number":"314","address_street_box":null,"email":"info@artetmarges.be","website":"http:\/\/www.artetmarges.be","phone_contact":"+32 2 533 94 90","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Haute, 314","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Art et marges mus\u00e9e","address_street_name":"Rue Haute","address_street_number":"314","address_street_box":null,"email":"info@artetmarges.be","website":"http:\/\/www.artetmarges.be","phone_contact":"+32 2 533 94 90","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","ad