au Moulin d'Evere","copyright":null},"en":{"title":"Yoga au Moulin d'Evere","copyright":null}}}],"dates":[{"day":"2022-10-08","doors":null,"start":"15:00:00","end":"16:30:00","is_soldout":true,"is_canceled":false},{"day":"2022-11-19","doors":null,"start":"15:00:00","end":"16:30:00","is_soldout":true,"is_canceled":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-09-15T16:05:05+02:00","published_at":"2022-03-02T16:19:33+01:00","backoffice_id":248714,"import_origin":null,"sub_type":"sport","show_in_agenda":true,"ranking":0.19920634085785},{"id":531214,"date_start":"2022-04-08","date_end":"2022-12-24","date_next":"2022-10-08","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{"list":[258],"translations":{"fr":["Quartiers"],"nl":["Wijken"],"en":["Neighbourhoods"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Visite guid\u00e9e du Logis-Flor\u00e9al \u2013 Les compagnons vous accueillent","shortdescr":"Parcourir Le Logis et Flor\u00e9al, le plus grand ensemble de cit\u00e9s-jardins en Belgique, c\u2019est se retrouver plong\u00e9 dans l\u2019atmosph\u00e8re d\u2019un village anglais \u00e0 quelques kilom\u00e8tres \u00e0 peine du centre de Bruxelles.","longdescr":"Des ruelles qui serpentent, des maisons style cottage entour\u00e9es d\u2019une v\u00e9g\u00e9tation abondante, un labyrinthe de sentiers qui passent entre les jardins, un site class\u00e9 au patrimoine\u2026 Le Logis et Flor\u00e9al, c\u2019est tout \u00e7a mais c\u2019est bien plus encore.\r\nCette visite, r\u00e9alis\u00e9e par une guide-conf\u00e9renci\u00e8re qui y habite depuis plus de 25 ans, sera l\u2019occasion d\u2019\u00e9voquer tout un pan de l\u2019histoire architecturale et sociale de la Belgique du 20\u00e8 si\u00e8cle mais aussi la vie d\u2019aujourd\u2019hui dans les cit\u00e9s-jardins. Faites une promenade et imaginez-vous en vacances !\r\n\r\nUne initiative des Compagnons du Quartier Flor\u00e9al \r\nen partenariat avec la Soci\u00e9t\u00e9 Coop\u00e9rative Le Logis-Flor\u00e9al\r\n\r\nR\u00e9servation pas n\u00e9cessaire.","performers":null,"boxoffice_url":null,"website":null,"email":"lescompagnonsdefloreal@hotmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.531214"},"nl":{"name":"Geleide wandeling in Le Logis-Flor\u00e9al \u2013 Op stap met les compagnons","shortdescr":"Wandelen door Le Logis en Flor\u00e9al, het grootste tuinwijkencomplex van Belgi\u00eb, is als wandelen door een Engels dorp op slechts enkele kilometers van het centrum van Brussel.","longdescr":"Kronkelige steegjes, huizen in cottagestijl omringd door een weelderige bloemenpracht, een doolhof van paden tussen de tuinen, geklasseerd erfgoed... Le Logis-Flor\u00e9al is dit allemaal en nog veel meer.\r\nDit bezoek, onder leiding van een deskundige gids die er al meer dan 25 jaar leeft, is d\u00e9 gelegenheid om een heel stuk van de architecturale en sociale geschiedenis van Belgi\u00eb in de 20e eeuw op te roepen, evenals het leven in de tuinwijken vandaag. Wandel mee en waan je even op vakantie !\r\n\r\nEen initiatief van les Compagnons du Quartier Flor\u00e9al \r\nin samenwerking met sociale huisvestingsmaatschappij Le Logis-Flor\u00e9al\r\n\r\nReserveren is niet nodig.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.lelogisfloreal.be\/100eme\/visitor-centor\/","email":"lescompagnonsdefloreal@hotmail.com","phone_contact":null,"phone_booking":null,"agenda_u