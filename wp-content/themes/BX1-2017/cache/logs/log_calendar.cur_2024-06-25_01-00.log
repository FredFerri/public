la poste d\u00e8s r\u00e9ception du virement.\n\nLoisirs et Sant\u00e9 organise des cours de sports dans diff\u00e9rentes communes de Bruxelles. Consultez le programme complet (yoga, gymnastique dynamique, aquagym, Qi Gong, Ta\u00efji Quan) dans notre brochure semestrielle l\u2019Echomutualiste Familles ou sur le site de Solidaris Brabant www.solidaris-brabant.be\/fr\/loisirs-et-sante\n","performers":null,"boxoffice_url":null,"website":"http:\/\/www.solidaris-brabant.be\/fr\/loisirs.sante","email":"loisirs.sante@solidaris.be","phone_contact":"+32 2 546 15 70","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50003448"},"sp":{"name":"Yoga \u00e0 Schaerbeek","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.solidaris-brabant.be\/fr\/loisirs.sante","email":"loisirs.sante@solidaris.be","phone_contact":"+32 2 546 15 70","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50003448"},"nl":{"name":"Yoga \u00e0 Schaerbeek","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.solidaris-brabant.be\/fr\/loisirs.sante","email":"loisirs.sante@solidaris.be","phone_contact":"+32 2 546 15 70","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50003448"}},"place":{"id":50000675,"translations":{"de":{"name":"Centre Santosha","address_street_name":"Rue Ernest Cambier ","address_street_number":"151","address_street_box":null,"email":"sacademie.asbl@solidaris.be","website":"www.solidaris-brabant.be\/fr\/sacademie","phone_contact":"+32 2 546 14 94","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Rue Ernest Cambier , 151","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Centre Santosha","address_street_name