0+02:00","end":"21:30:00","is_only_by_appointment":true},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-05-06T10:35:04+02:00","published_at":"2022-05-04T16:15:27+02:00","backoffice_id":253054,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.34199518933534},{"id":383411,"date_start":"2018-01-01","date_end":"2022-12-31","date_next":"2022-05-18","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{"list":[103],"translations":{"fr":["Centre historique"],"nl":["Historisch centrum"],"en":["Historical Centre"]}}},"languages":{"spoken":["nl","en","fr"],"subtitles":[]},"translations":{"fr":{"name":"Visite guid\u00e9e H\u00f4tel de Ville de Bruxelles","shortdescr":"L\u2019H\u00f4tel de Ville de Bruxelles est assur\u00e9ment un des plus beaux du pays ! Et m\u00eame sur le plan international, peu de villes peuvent se targuer de disposer d\u2019un h\u00f4tel de ville aussi majestueux et ancien ! Son \u00e2ge et sa grandeur architecturale en font un site incontournable de Bruxelles, \u00e0 ne manquer sous aucun pr\u00e9texte !","longdescr":"Cet \u00e9difice, b\u00e2ti au 15e si\u00e8cle en style gothique, est sublim\u00e9 par le d\u00e9cor qu\u2019offre cette Grand-Place, souvent qualifi\u00e9e de plus belle au monde... \r\n\r\nSavez-vous pourquoi l\u2019aile situ\u00e9e \u00e0 droite de la tour est moins longue que celle situ\u00e9e \u00e0 gauche, et pourquoi l\u2019entr\u00e9e est dissym\u00e9trique ? Simplement parce que l\u2019\u00e9difice a \u00e9t\u00e9 construit en plusieurs phases au cours du 15e si\u00e8cle... savez-vous que le b\u00e2timent conserve des parties originelles, mais qu\u2019il comporte \u00e9galement beaucoup d\u2019ajouts et d\u2019\u00e9l\u00e9ments restaur\u00e9s ? \r\n\r\nVous l\u2019aurez compris, une visite guid\u00e9e s\u2019impose si vous souhaitez tout savoir sur ce b\u00e2timent, centre n\u00e9vralgique de la vie politique et administrative depuis plus de 600 ans, et qui l\u2019est encore aujourd\u2019hui ! \r\n\r\nEn compagnie d\u2019un guide, vous en apprendrez davantage sur le contexte des diff\u00e9rentes \u00e9poques de construction du b\u00e2timent, en observant la fa\u00e7ade principale donnant sur la Grand-Place et la cour int\u00e9rieure. Vous p\u00e9n\u00e9trerez ensuite \u00e0 l\u2019int\u00e9rieur de l\u2019H\u00f4tel de Ville, pour y admirer les diff\u00e9rentes salles et galeries (salle du Conseil communal, salle du Coll\u00e8ge dite salle Maximilienne, salle des Mariages, salle Gothique, galerie des Portraits, galerie Grang\u00e9, etc.), et par la m\u00eame occasion toutes les d\u00e9corations et \u0153uvres d\u2019art qu\u2019elles contiennent. \r\n\r\nPour admirer ce chef-d'\u0153uvre, achetez votre ticket en ligne ou rendez-vous dans l\u2019un de nos bureaux de tourisme (BIP, 2-4 rue Royale ou celui situ\u00e9 au rez-de-chauss\u00e9e de l\u2019H\u00f4tel de Ville, Grand-Place, du c\u00f4t\u00e9 droit quand vous faites face au b\u00e2timent). Pour information, les tickets sont disponibles uniquement 5 jours avant la date de la visite. \r\n\r\nTous les mercredis : \r\n13h : fran\u00e7ais \r\n14h : anglais \r\n15h : n\u00e9erlandais \r\n \r\nTous les dimanches : \r\n10h : anglais \r\n11h : n\u00e9erlandais \r\n12h : fran\u00e7ais \r\n14h : fran\u00e7ais \r\n15h : anglais \r\n16h : anglais \r\n\r\nException : pas de visites lors de grands \u00e9v\u00e9nements organis\u00e9s \u00e0 l\u2019H\u00f4tel de Ville. \r\nDurant le Tapis de Fleurs et Flowertime (ao\u00fbt), l\u2019horaire des visites est adapt\u00e9. Veuillez prendre contact avec les organisateurs de ces deux \u00e9v\u00e9nements : karel.goethals@flowercarpet.be \r\n\r\nInscription : \r\nTickets en vente en ligne \r\n\r\nTarif : 8 \u20ac \r\nEnfants de moins de 12 ans : gratuit accompagn\u00e9 d'un adulte ayant son ticket d'entr\u00e9e. \r\n\r\nD\u00e9tails pratiques : d\u00e9part de la visite dans la cour int\u00e9rieure ; dur\u00e9e 55 min. \r\nR\u00e9servation GROUPE PRIVE : envoyez un mail avec la date et l\u2019heure souhait\u00e9e pour votre visite \u00e0 l\u2019adresse boxoffice@visit.brussels","performers":null,"boxoffice_url":"http:\/\/agenda.brussels\/fr\/383411\/visite-guidee-hotel-de-ville-de-bruxelles\/shop","website":"http:\/\/visit.brussels","email":"boxoffice@visit.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/383411.html"},"nl":{"name":"Rondleiding Stadhuis van Brussel","shortdescr":"Het Brusselse stadhuis is ontegensprekelijk een van de mooiste van ons land! Wereldwijd zijn er maar weinig steden die kunnen uitpakken met een majestueus en roemrijk stadhuis van dit formaat. De historische en architecturale grandeur maken van dit monument een absolute must-see in Brussel!","longdescr":"Het gebouw werd in de 15e eeuw opgetrokken in gotische stijl en is een van de pronkstukken op de Brusselse Grote Markt. Wist je trouwens dat de Grote Markt meer dan eens wordt genoemd als mooiste plein ter wereld?\r\nBenieuwd om te weten waarom de toren en de ingang van het stadhuis niet mooi in het midden staan? En waarom de rechtervleugel van het gebouw korter is dan de linkervleugel? Voor het antwoord moeten we teruggaan naar 15e eeuw en het feit dat het bouwwerk in verschillende fasen is tot stand gekomen. Je vindt er vandaag nog heel wat originele elementen in combinatie met latere toevoegingen en gerestaureerde onderdelen.\r\nEen rondleiding met gids is d\u00e9 ideale manier om dit monument te ontdekken, dat ook vandaag nog dienstdoet als stadhuis. Duik in meer dan 600 jaar geschiedenis van het kloppende hart van het Brusselse politieke en administratieve leven.\r\nOnder de vleugels van een gids verneem je alles over de verschillende bouwperiodes en hun context. Alleen al de voorgevel van het gebouw aan de Grote Markt en de binnenplaats lezen als een open geschiedenisboek. Daarna gaat het richting de vele zalen en galerijen van het stadhuis waar je ogen en oren te kort komt om de prachtige decoraties en kunstwerken te bewonderen. Enkele haltes zijn: de Gemeenteraadszaal, Maximiliaanzaal (ook Collegezaal genoemd), Trouwzaal, Gotische zaal, portrettengalerij, de Grang\u00e9galerij en ga zo maar door.\r\nKlaar om dit meesterwerk in zijn volle glorie te aanschouwen? Reserveer dan je toegangsticket online of ga naar een van balies van onze toeristische dienst (BIP, Koningsstraat 2-4 of de balie op de benedenverdieping van het stadhuis, op de Grote Markt, aan de rechterzijde van het gebouw). Ter info: de tickets zijn pas vijf dagen voor de datum van je bezoek beschikbaar.\r\n\r\nHet Stadhuis is open voor het publiek op de volgende dagen (rondleidingen voor individuele bezoekers) op vaste data: \r\n\r\nElke woensdag: \r\n13u: in het Frans \r\n14u: in het Engels \r\n15u: in het Nederlands \r\n\r\nElke zondag: \r\n10u: in het Engels\r\n11u: in het  Nederlands\r\n12u: in het Frans \r\n14u: in het Frans \r\n15u: in het Engels \r\n16u: in het Engels \r\n\r\nUitzondering: geen rondleidingen tijdens grote evenementen in verband met het Stadhuis. \r\nTijdens het Bloementapijt en Flowertime in augustus wordt de uurregeling van de rondleidingen aangepast. Gelieve contact op te nemen met de organisatoren van deze evenementen:  karel.goethals@flowercarpet.be\r\n\r\nInschrijven: \r\nTickets oline te koop enkel beschikbaar 5 dagen voor de gewenste datum\r\n\r\nPrijs: \u20ac 8 euro\r\nKinderen (< 12 jaar) mogen gratis binnen onder begeleiding van een volwassene. \r\n\r\nPraktische informatie: vertrek van de rondleiding op de binnenkoer ; De rondleiding duurt 55 min. \r\nGroep reservatie: stuur een email met de gewenste datum en uur voor uw rondleiding naar: boxoffice@visit.brussels\r\n\r\nOPGELET :\r\n- De toegang aan het Stadhuis is onderworpen aan het Covid Safe Ticket. Vergeet niet uw toegangsticket, uw ID en uw Covid Safe Ticket mee te nemen.\r\n- Het dragen van een mondmasker is verplicht.","performers":null,"boxoffice_url":"http:\/\/agenda.brussels\/nl\/383411\/rondleiding-stadhuis-van-brussel\/shop","website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/383411.html"},"en":{"name":"Guided tour City Hall of Brussels, inner rooms","shortdescr":"The City of Brussels Town Hall is without doubt one of most beautiful in the country! Even internationally, few cities can boast such a majestic and ancient town hall! Its age and architectural grandeur make it an unmissable site in Brussels!","longdescr":"This Gothic-style edifice built in the 15th century, is sublimated by the decor of the Grand-Place, often described as the most beautiful square in the world... \r\n\r\nDo you know why the wing on the right of the tower is shorter than the one on the left, and why the entrance is asymmetrical? It' s simply due to the fact that the building was built in several phases during the 15th century... did you know that the building still has some original features, but that it also has many additions and restored elements? \r\n\r\nAs you can see, a guided tour is essential if you want to know everything there is to know about this building, which has been the nerve centre of political and administrative life for more than 600 years, and still is to this day! \r\n\r\nIn the company of a guide, you'll learn more about the context of the different periods of construction of the building, by observing the main fa\u00e7ade overlooking the Grand-Place and the inner courtyard. Then you\u2019ll step inside the Town Hall to marvel at its various rooms and galleries (Council Chamber, College Chamber, Wedding Chamber, Gothic Chamber, Portrait Gallery, Grang\u00e9 Gallery, etc.), and all the decorations and works of art they contain. \r\n\r\nTo admire this masterpiece, buy your ticket online or head to one of our tourist offices (BIP, 2-4 rue Royale or the one on the ground floor of the Town Hall itself, on the Grand-Place, on its right-hand side when you face the building). Be advised, tickets are only available 5 days before your visit. \r\n\r\nEvery Wednesday: \r\n13:00: French \r\n14:00: English \r\n15:00: Dutch \r\n \r\nEvery Sunday: \r\n10:00: English \r\n11:00: Dutch \r\n12:00: French \r\n14:00: French \r\n15:00: English \r\n16:00: English \r\n\r\nException: There are no visits when the Town Hall is hosting major events. \r\n\r\nThe schedule of visits changes during the Flower Carpet and Flowertime (August). Please contact the organisers of these two events: karel.goethals@flowercarpet.be \r\n\r\nPlan your visit: \r\nTickets on sale online \r\n\r\nPrice: \u20ac8 \r\nChildren under 12 years old: free when they\u2019re accompanied by a paying adult. \r\n\r\nPractical information: the visit begins in the interior courtyard and lasts 55 minutes. \r\nBooking for a PRIVATE GROUP: send an email to boxoffice@visit.brussels mentioning the date and time slot you wish to book.","performers":null,"boxoffice_url":"http:\/\/agenda.brussels\/en\/383411\/guided-tour-city-hall-of-brussels-inner-rooms\/shop","website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/383411.html"},"de":{"name":"F\u00fchrung durch das Br\u00fcsseler Rathaus","shortdescr":"Ein Muss f\u00fcr Br\u00fcssel-Besucher ist die Besichtigung des Br\u00fcsseler Rathauses, das als architektonisches Meisterwerk und Symbol der politischen Macht das Herzst\u00fcck des ber\u00fchmten Grand-Place bildet.","longdescr":"Das im 15. Jahrhundert im gotischen Stil errichtete Geb\u00e4ude f\u00fcgt sich perfekt in die prunkvolle Kulisse des Grand-Place ein, der gemeinhin als einer der sch\u00f6nsten Pl\u00e4tze der Welt gilt...  \r\n\r\nWissen Sie, weshalb der Fl\u00fcgel auf der rechten Seite des Turms k\u00fcrzer ist als der auf der linken Seite und warum der Eingang asymmetrisch ist? Ganz einfach: Weil das Geb\u00e4ude im 15. Jahrhundert in mehreren Phasen errichtet wurde... Wussten Sie, dass das Geb\u00e4ude heute sowohl Originalelemente als auch neuere Erg\u00e4nzungen und restaurierte Teile umfasst? \r\n\r\nWenn Sie mehr \u00fcber diesen Prunkbau erfahren m\u00f6chten, der seit mehr als 600 Jahren den Mittelpunkt des politischen und administrativen Lebens der Stadt bildet, sollten Sie unbedingt eine F\u00fchrung durch das Br\u00fcsseler Rathaus buchen!  \r\n\r\nIn Begleitung eines Fremdenf\u00fchrers erfahren Sie mehr \u00fcber die historischen Hintergr\u00fcnde und die verschiedenen architektonischen Stilrichtungen des Geb\u00e4udes. Besondere Beachtung findet die Hauptfassade mit Blick auf den Grand-Place und den Innenhof. Anschlie\u00dfend geht es weiter in das Innere des Rathauses, wo Sie die verschiedenen S\u00e4le und Galerien (Saal des Gemeinderats, Saal des Kollegiums, genannt Maximiliansaal, Hochzeitssaal, Gotischer Saal, Portr\u00e4tgalerie, Galerie Grang\u00e9 usw.) sowie die darin verwahrten Kunstwerke und Dekorationen bewundern k\u00f6nnen.  \r\n\r\nTickets erhalten Sie entweder online oder in einem unserer Touristenb\u00fcros (BIP, 2-4 Rue Royale oder im Erdgeschoss des Rathauses, Grand-Place, auf der rechten Seite mit Blick auf das Geb\u00e4ude). Bitte beachten Sie: Die Tickets sind erst 5 Tage vor dem Besuchstermin erh\u00e4ltlich.  \r\n\r\nJeden Mittwoch:  \r\n\r\n13 Uhr: Franz\u00f6sisch  \r\n14 Uhr: Englisch  \r\n15 Uhr: Niederl\u00e4ndisch  \r\n\r\nJeden Sonntag:  \r\n\r\n10 Uhr: Englisch  \r\n11 Uhr: Niederl\u00e4ndisch  \r\n12 Uhr: Franz\u00f6sisch  \r\n14 Uhr: Franz\u00f6sisch  \r\n15 Uhr: Englisch  \r\n16 Uhr: Englisch  \r\n\r\nAusnahme: Keine Besichtigungen bei Gro\u00dfveranstaltungen im Rathaus.  \r\n\r\nW\u00e4hrend des Blumenteppichs und Flowertime (August) werden die Besuchszeiten angepasst. Bitte nehmen Sie Kontakt mit den Organisatoren dieser beiden Veranstaltungen auf: karel.goethals@flowercarpet.be \r\n\r\n  \r\n\r\nAnmeldung:  \r\nOnline-Ticketverkauf  \r\n\r\nEintrittspreis: 8 \u20ac  \r\n\r\nKinder unter 12 Jahren: kostenlos in Begleitung eines Erwachsenen mit Eintrittskarte.  \r\n\r\nPraktische Infos: Start der Besichtigung im Innenhof; Dauer 55 Min.  \r\n\r\nReservierung f\u00fcr PRIVATE GRUPPE: Senden Sie eine E-Mail mit gew\u00fcnschtem Termin und Uhrzeit f\u00fcr Ihren Besuch an boxoffice@visit.brussels \r\n\r\nWelche Sicherheits- und Hygienema\u00dfnahmen gelten im Rahmen der Besichtigung?  \r\n\r\nUm die Sicherheit aller Anwesenden zu gew\u00e4hrleisten, erfolgt die Besichtigung nur in eine Gangrichtung. Ein F\u00fchrer (dessen Anweisungen Sie bitte befolgen) begleitet Sie auf dem gesamten Rundgang. W\u00e4hrend des Besuchs sind maximal 25 Personen zugelassen. Das Geb\u00e4ude ist am Eingang mit Spendern f\u00fcr Desinfektionsmittel ausgestattet.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/383411.html"},"it":{"name":"Visite guidate del municipio di Bruxelles","shortdescr":"The City of Brussels Town Hall attracts the interest of the many passers-by who are curious to have a look inside this magnificent monument.","longdescr":"L'H\u00f4tel de Ville, ovvero il municipio, di Bruxelles richiama l'attenzione di numerosi passanti, che tentano sempre di gettare uno sguardo al suo interno.  \r\n\r\nFortunatamente, questo capolavoro dell'architettura, e sede dell'amministrazione comunale ormai da sei secoli a questa parte, \u00e8 accessibile a chiunque desideri visitarlo. L'edificio accoglie infatti i visitatori nei giorni di apertura al pubblico, ovvero il mercoled\u00ec pomeriggio e la domenica. \r\n\r\nNel corso della visita, potrete constatare come gli interni siano stati elaborati con la stessa cura destinata al suo aspetto esteriore. Niente \u00e8 stato lasciato al caso. Dipinti, sculture e arazzi provenienti dalle collezioni del Museo della citt\u00e0 di Bruxelles decorano i muri di questo edificio prestigioso \r\ned evocano episodi diversi della storia del Belgio e della sua capitale.  \r\n\r\nAll'interno di questa grandiosa opera architettonica, avrete la possibilit\u00e0 di saperne di pi\u00f9 sulla sua storia, sulla sua funzione politica e sui suoi meravigliosi spazi. Potrete ad esempio vedere in prima persona le numerose e ricche boiserie della sala gotica e dell'anticamera del gabinetto del sindaco.  \r\n\r\nAnche se il punto forte rimane sempre e comunque la sala ufficiale, ancora oggi utilizzata dal sindaco e dagli assessori. La torre e il balcone sono gli unici spazi non accessibili al pubblico (per motivi di sicurezza). \r\n\r\nPer ammirarne tutte le stupende sale, non dovete fare altro che recarvi all'ufficio del turismo di visit.brussels, situato proprio all'interno dell'H\u00f4tel de Ville.  \r\n\r\nIscrizione:\r\nI biglietti sono in vendita online disponibile solo 5 giorni prima della data\r\n\r\n Il Municipio \u00e8 aperto al pubblico e pu\u00f2 essere visitato : \r\n Tutti i mercoled\u00ec : \r\n13h: francese \r\n14h: inglese\r\n15h: olandese\r\n\r\nTutte le domeniche : \r\n10h: olandese\r\n11h: inglese\r\n12h: francese\r\n14h: francese\r\n15h: inglese\r\n16h: inglese\r\n\r\nTariffe : \r\nAdulto: 7 \u20ac euro\r\nBambini di meno di 12 anni: gratuito\r\n\r\nDettagli pratici: partenza della visita il cortile interno); durata 55 minuti. \r\n\r\nPrenotazione per gruppi privati: potete enviare una email con la data e l'ora desiderata per la vostra visita all'indirizzo siguiente: boxoffice@visit.brussels\r\n\r\nAttenzione: non ci sono visita durante i principali eventi legati al municipio.\r\n\r\nDurante il tappeto di fiori e Flowertime (agosto), l'orario delle visite \u00e8 adattato. Per maggior informazioni \u00e9 suggerito informasi presso gli organizzatori di questi due avvenimenti: karel.goethals@flowercarpet.be","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/383411.html"},"sp":{"name":"Visita guiada al Ayuntamiento de Bruselas","shortdescr":"El Ayuntamiento de Bruselas despierta el inter\u00e9s de numerosos transe\u00fantes que desean poder echar un vistazo al interior de este monumento.","longdescr":"El Ayuntamiento de Bruselas despierta el inter\u00e9s de numerosos transe\u00fantes que desean poder echar un vistazo al interior de este monumento.  \r\n\r\nAfortunadamente, esta obra de arte arquitect\u00f3nica est\u00e1 abierta para los curiosos que deseen entrar a la que ha sido la sede del poder municipal de esta ciudad desde hace seis siglos. Este edificio est\u00e1 abierto para los visitantes durante los d\u00edas de apertura al p\u00fablico, los mi\u00e9rcoles por la tarde y los domingos. \r\n\r\nDurante la visita podr\u00e1n contemplar c\u00f3mo la arquitectura interior se dise\u00f1\u00f3 con tanto esmero como la exterior. Se cuid\u00f3 hasta el \u00faltimo detalle. Las pinturas, esculturas y tapices de las colecciones del museo de la ciudad de Bruselas decoran las paredes de este prestigioso edificio. \r\nLas diferentes obras evocan diversos periodos de la historia de la naci\u00f3n, as\u00ed como de la ciudad de Bruselas.  \r\n\r\nSi visita este suntuoso edificio, podr\u00e1 conocer mejor su historia, su funci\u00f3n p\u00fablica, y descubrir al mismo tiempo sus grandiosos espacios. Tendr\u00e1 la oportunidad de contemplar los numerosos adornos de madera esculpidos en la sala g\u00f3tica y en la antesala del despacho del alcalde.  \r\n\r\nSin embargo, el colof\u00f3n llega con la entrada a la sala oficial, que siguen utilizando actualmente el alcalde y los concejales. Por desgracia, la torre y el balc\u00f3n son los \u00fanicos lugares que no pueden visitarse por razones de seguridad. \r\n\r\nPara admirar estas salas, acuda a la tienda de la oficina de turismo visit.brussels situada en el ayuntamiento.  \r\n\r\nVenta de billetes:\r\nLos billetes solo est\u00e1n en venta en linea disponible solo 5 d\u00edas antes de la fecha\r\n\r\nEl Ayuntamiento de la ciudad est\u00e1 abierto al p\u00fablico y puede visitarse de manera individual con cita previa en las siguientes fechas:\r\n\r\nTodos los mi\u00e9rcoles:\r\n13:00 en franc\u00e9s\r\n14:00 en ingl\u00e9s\r\n15:00 en neerland\u00e9s\r\n\r\nTodos los domingos:\r\n10:00 en ingl\u00e9s \r\n11:00 en neerland\u00e9s\r\n12:00 en franc\u00e9s\r\n14:00 en franc\u00e9s\r\n15:00 en ingl\u00e9s\r\n16:00 en ingl\u00e9s\r\n\r\nPrecios:\r\nAdultos: 7\u20ac\r\nNi\u00f1os menores de 12 a\u00f1os : gratis\r\n\r\nInformaci\u00f3n pr\u00e1ctica: Comienzo de la visita en el patio. La visita dura 55 minutos.\r\n\r\nReserva para grupos: env\u00eda un correo con la fecha y hora que prefieras para tu visita guiada a boxoffice@visit.brussels\r\n\r\nExcepci\u00f3n: No hay visitas guiadas posibles durante los grandes eventos relacionados con el Ayuntamiento. Los horarios de visita est\u00e1n adaptados para la alfombra floral y los eventos florales de agosto. Por favor, contacta con el organizador de estos dos eventos en este caso: karel.goethals@flowercarpet.be","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/383411.html"},"pt":{"name":"Visite guid\u00e9e H\u00f4tel de Ville de Bruxelles","shortdescr":null,"longdescr":"A C\u00e2mara Municipal de Bruxelas desperta o interesse de in\u00fameros transeuntes que querem dar uma olhada no interior deste monumento. \r\nSorte a sua, pois esta obra-prima arquitetural est\u00e1 aberta ao p\u00fablico que deseja conhecer esta sede do poder municipal h\u00e1 seis s\u00e9culos. O edif\u00edcio acolhe visitantes em dias abertos ao p\u00fablico em geral, nomeadamente nas quartas-feiras e aos domingos. \r\nDurante a visita, poder\u00e1 constatar que a arquitetura interior foi projetada t\u00e3o cuidadosamente como a exterior. Nada foi deixado ao acaso. Pinturas, esculturas e tape\u00e7arias provenientes das cole\u00e7\u00f5es do Museu da Cidade de Bruxelas decoram as paredes deste edif\u00edcio prestigioso. \r\nEstas diferentes obras de arte evocam diversos epis\u00f3dios da Hist\u00f3ria da Na\u00e7\u00e3o, bem como da pr\u00f3pria Bruxelas.  \r\nDurante a sua visita a este suntuoso edif\u00edcio, poder\u00e1 aprender mais sobre a sua hist\u00f3ria, a sua fun\u00e7\u00e3o pol\u00edtica, e conhecer os seus espa\u00e7os grandiosos. Ter\u00e1 oportunidade de descobrir as numerosas e ricas pe\u00e7as de madeira entalhada do sal\u00e3o g\u00f3tico e da antec\u00e2mara do gabinete do presidente da c\u00e2mara.  \r\nMas o mais espetacular continua a ser o sal\u00e3o oficial, ainda hoje utilizado pelo presidente da c\u00e2mara e os seus vereadores. A torre e a varanda s\u00e3o os \u00fanicos espa\u00e7os que n\u00e3o podem ser visitados. Infelizmente, estes j\u00e1 n\u00e3o est\u00e3o acess\u00edveis por raz\u00f5es de seguran\u00e7a. \r\nPara admirar todas estas salas, venha para a loja do posto de turismo visit.brussels, situada dentro da C\u00e2mara Municipal.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/383411.html"},"cn":{"name":"Visite guid\u00e9e H\u00f4tel de Ville de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/383411.html"}},"place":{"id":475,"translations":{"fr":{"name":"H\u00f4tel de Ville de Bruxelles","address_street_name":"Grand-Place","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.bruxelles.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"\u00c9l\u00e9gant b\u00e2timent datant du 15\u00e8me si\u00e8cle, l\u2019H\u00f4tel de Ville de Bruxelles se situe au c\u0153ur du centre historique, sur la somptueuse Grand-Place.\r\nSouvent consid\u00e9r\u00e9 comme la pi\u00e8ce ma\u00eetresse de la plus belle place du monde, il est probablement l\u2019un des plus beaux \u00e9difices du pays et \u00e9videmment l\u2019un des monuments \u00e0 ne pas manquer lors de votre s\u00e9jour \u00e0 Bruxelles. Sa splendide tour se dresse tel un rep\u00e8re aussi bien pour les curieux d\u2019un jour que les belges de passage dans le centre de la capitale.\r\nUn r\u00e9gal pour les yeux\r\nParticuli\u00e8rement imposant par ses dimensions, ses remarquables d\u00e9cors sculpt\u00e9s et sa fa\u00e7ade asym\u00e9trique, il attire rapidement les regards. En vous promenant devant ce prestigieux b\u00e2timent, peut-\u00eatre que vous apercevrez aux balcons de jeunes mari\u00e9s c\u00e9l\u00e9brer leur union.\r\nL\u2019int\u00e9rieur de l\u2019H\u00f4tel de Ville vaut \u00e9galement le d\u00e9tour. Il attise la curiosit\u00e9 de ceux qui souhaitent d\u00e9couvrir la disposition et l\u2019am\u00e9nagement des diff\u00e9rentes salles de ce chef-d\u2019\u0153uvre architectural. Des visites guid\u00e9es de l\u2019H\u00f4tel de Ville de Bruxelles sont r\u00e9guli\u00e8rement organis\u00e9es afin de d\u00e9couvrir la richesse de cet int\u00e9rieur qui ne cesse d\u2019\u00e9blouir les visiteurs.\r\nL\u2019\u00e9volution d\u2019un b\u00e2timent singulier\r\nSa construction s'\u00e9tale sur une longue p\u00e9riode et voit d\u00e9filer plusieurs architectes. \u00c0 l\u2019origine, l\u2019\u00e9difice ne comptait qu\u2019un beffroi et la partie gauche qui elle est rest\u00e9e identique jusqu\u2019\u00e0 aujourd\u2019hui. Le beffroi, quant \u00e0 lui, est par contre rapidement remplac\u00e9 par la tour actuelle lorsque les maisons des diff\u00e9rentes corporations de m\u00e9tiers s\u2019installent sur la place. Une aile suppl\u00e9mentaire est \u00e9galement ajout\u00e9e sur la droite pour inclure au mieux ces immeubles dans cet incomparable d\u00e9cor.\r\nAu sommet de la nouvelle tour, haute de plus de 90m, la fl\u00e8che est couronn\u00e9e de l\u2019archange Saint-Michel, grand Patron de la ville de Bruxelles. Cette statue en cuivre dor\u00e9 sert en r\u00e9alit\u00e9 de girouette. Si les vents vous sont favorables, vous aurez l\u2019occasion de pouvoir admirer convenablement la mani\u00e8re dont cet embl\u00e8me vient \u00e0 bout du dragon !\r\nActuellement, ce joyau du patrimoine bruxellois abrite l\u2019office du Tourisme.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Stadhuis Brussel","address_street_name":"Grote Markt","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.brussel.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Grote Markt","address_line2":"1000 Brussel","description_web":"Het elegante stadhuis van Brussel dateert uit de 15de eeuw en ligt in het historische hart van de stad, op de prachtige Grote Markt. \r\n\r\nHet wordt vaak beschouwd als het absolute pronkstuk van het mooiste plein ter wereld en is wellicht een van de mooiste gebouwen van het land. Het is dan ook een niet te missen monument tijdens je bezoek aan Brussel. Zijn prachtige toren is een herkenningspunt voor zowel de dagjestoeristen als de Belgen die door het stadscentrum kuieren. \r\nEen lust voor het oog \r\nNiet alleen de indrukwekkende afmetingen van het gebouw, maar ook de opmerkelijke gebeeldhouwde ornamenten en de asymmetrische gevel trekken meteen de aandacht. En terwijl je dit prestigieuze gebouw voorbij wandelt, word je misschien toegewuifd door een pasgetrouwd stel op het balkon ... \r\nHet interieur van het stadhuis is eveneens een omweg waard. Wie wil, kan een blik werpen op de indeling en de inrichting van de verschillende zalen van dit architecturale meesterwerk. Er worden regelmatig rondleidingen in het Brussels stadhuis georganiseerd om de rijkdom van het interieur aan de bezoekers te tonen. \r\nEvolutie van een uniek gebouw \r\nHet gebouw werd over een lange periode ontworpen door verschillende architecten. Oorspronkelijk bestond het enkel uit een belfort en het linkerdeel, dat ongewijzigd is gebleven. Het belfort daarentegen werd al snel vervangen door de huidige toren, toen de huizen van de verschillende gilden zich op de grote markt begonnen te vestigen. Aan de rechterkant werd een extra vleugel bijgebouwd, om deze gebouwen beter in dit unieke decor op te nemen. \r\nBovenaan de meer dan 90 meter hoge, nieuwe toren, werd de torenspits bekroond met aartsengel Micha\u00ebl, de beschermheilige van de stad Brussel. Het standbeeld in verguld koper doet in werkelijkheid dienst als windwijzer. Bij gunstige wind kan je zelfs zien hoe dit embleem de draak velt! \r\nMomenteel is de toeristische dienst ondergebracht in dit pronkstuk van het Brusselse erfgoed. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Brussels Town Hall","address_street_name":"Grand-Place","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.bruxelles.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Grand-Place","address_line2":"1000 Brussels","description_web":"An elegant building dating back to the 15th century, the City of Brussels Town Hall is located in the heart of the historical centre, on the sumptuous Grand-Place.\r\nOften considered to be the centrepiece of the most beautiful square in the world, it is undoubtedly one of the most stunning buildings in Belgium and definitely one of the unmissable highlights of your stay in Brussels. Its splendid tower stands as a landmark both for day-trippers and Belgians passing through the centre of the capital.\r\n\r\nA feast for the eyes\r\nParticularly imposing due to its size, its remarkable sculpted decorations and its asymmetrical facade, it quickly catches the eye. Walking in front of this prestigious building, you might spot newlyweds celebrating their union on the balconies.\r\nThe Town Hall's interior is also well worth a visit. It attracts the curiosity of those who want to know more about the layout and arrangement of the different rooms of this architectural masterpiece. Guided tours of the City of Brussels Town Hall are regularly organised and let you discover the richness of this interior which never fails to dazzle its visitors.\r\n\r\nThe evolution of a unique building\r\nIts construction was spread out over a long period of time and is the work of several architects. Originally, the building had only a belfry and the left part of the building has remained the same until today. The belfry, on the other hand, was quickly replaced by the current tower when the houses of the various trade guilds moved into the square. An additional wing was also added on the right to better incorporate these buildings into this exceptional setting.\r\nAt the top of the new tower, more than 90m high, the spire is crowned with the Archangel Saint-Michel, the patron saint of the City of Brussels. This gilded copper statue is actually used as a weather vane. If the winds blow the right way, you can admire the city's hero as he defeats the dragon!\r\nThis jewel of Brussels' architectural heritage currently houses the Tourist Office.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Rathaus Br\u00fcssel","address_street_name":"Grand-Place","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.brussel.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"Das Br\u00fcsseler Rathaus ist ein elegantes Bauwerk aus dem 15. Jahrhundert, gelegen auf dem pr\u00e4chtigen Grand-Place im Herzen des historischen Stadtzentrums. \r\n\r\nEs gilt als das architektonische Meisterwerk eines der sch\u00f6nsten Pl\u00e4tze der Welt und z\u00e4hlt dar\u00fcber hinaus zu den wahrscheinlich eindrucksvollsten Bauwerken Belgiens, das Sie bei Ihrem Besuch in Br\u00fcssel unbedingt besichtigen sollten. Zu verfehlen ist es kaum, denn sein majest\u00e4tischer Turm ragt hoch in den Br\u00fcsseler Himmel hinein.  \r\n\r\nEin Augenschmaus \r\n\r\nInsbesondere seine imposanten Dimensionen, seine bemerkenswerten skulpturalen Verzierungen und seine asymmetrische Fassade fallen sofort ins Auge. Und wenn man Gl\u00fcck hat, kann man auf dem majest\u00e4tischen Balkon einen Blick auf ein frischgebackenes Brautpaar erhaschen. \r\n\r\nAuch das Innere des Rathauses ist einen Besuch wert, denn die Aufteilung und die Anordnung der verschiedenen S\u00e4le dieses architektonischen Meisterwerks sind absolut sehenswert. Es finden regelm\u00e4\u00dfig F\u00fchrungen durch das Br\u00fcsseler Rathaus statt, die spannende Einblicke in die Reicht\u00fcmer des Interieurs gew\u00e4hren, das die Besucher immer wieder aufs Neue begeistert. \r\n\r\nDie Entstehung eines einzigartigen Geb\u00e4udes \r\n\r\nDer Bau des Rathauses erstreckte sich \u00fcber einen relativ langen Zeitraum und war das Werk mehrerer Architekten. Urspr\u00fcnglich bestand das Geb\u00e4ude nur aus einem Glockenturm und dem bis heute unver\u00e4nderten linken Geb\u00e4udefl\u00fcgel. Der Glockenturm hingegen wurde schon bald durch den heutigen Turm ersetzt, als sich die H\u00e4user der verschiedenen Handwerksz\u00fcnfte am Grand-Place niederlie\u00dfen. Um das Geb\u00e4ude noch harmonischer in das Stadtbild einzuf\u00fcgen, wurde ein zus\u00e4tzlicher Fl\u00fcgel auf der rechten Seite hinzugef\u00fcgt. \r\n\r\nAn der Spitze des neuen, mehr als 90 m hohen Turms  thront der Erzengel Michael, der Schutzpatron der Stadt Br\u00fcssel. Die vergoldete Kupferstatue dient eigentlich als Wetterfigur \u2013 und wenn der Wind g\u00fcnstig steht, k\u00f6nnen Sie beobachten, wie die die Engelsfigur den Drachen besiegt! \r\n\r\nDerzeit beherbergt dieses Kleinod des Br\u00fcsseler Architekturerbes das Tourismusb\u00fcro.  ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Municipio di Bruxelles","address_street_name":"Grand-Place","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.bruxelles.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"Elegante edificio risalente al 15\u00b0 secolo, il municipio di Bruxelles si trova nel cuore del centro storico, nella sontuosa Grand-Place. \r\n\r\nSpesso considerato come l\u2019elemento centrale della piazza pi\u00f9 bella del mondo, \u00e8 probabilmente uno degli edifici pi\u00f9 belli del paese e sicuramente uno dei monumenti da non perdere quando si visita Bruxelles. La sua splendida torre funge da punto di riferimento sia per i turisti che per i belgi di passaggio nel centro della capitale. \r\n\r\nUna festa per gli occhi \r\n\r\nParticolarmente imponente per le sue dimensioni, le sue stupende decorazioni scolpite e la sua facciata asimmetrica, cattura rapidamente l\u2019attenzione. Passeggiando davanti a tale edificio prestigioso, \u00e8 possibile scorgere sui balconi gli sposi novelli intenti a festeggiare il loro matrimonio. \r\n\r\nVale la pena visitare anche gli interni del municipio. Suscitano la curiosit\u00e0 di chi desidera scoprire la disposizione e l\u2019arredamento delle varie sale di questo capolavoro architettonico. Vengono periodicamente organizzate visite guidate al municipio di Bruxelles durante le quali \u00e8 possibile ammirare la ricchezza degli interni che non smettono mai di affascinare i visitatori. \r\n\r\nL\u2019evoluzione di un edificio eccezionale \r\n\r\nLa sua costruzione avviene nel corso di un lungo periodo di tempo e vede l\u2019avvicendarsi di vari architetti. In origine, l\u2019edificio comprendeva solo una torre campanaria e la parte sinistra, rimasta identica fino ai nostri giorni. La torre campanaria \u00e8 stata invece sostituita rapidamente dalla torre attuale quando le case delle varie corporazioni sono state trasferite nella piazza. \u00c8 stata peraltro aggiunta un\u2019altra ala sulla destra per accogliere al meglio tali edifici in questa cornice dalla bellezza incomparabile. \r\n\r\nIn cima alla nuova torre, alta pi\u00f9 di 90 m, la guglia \u00e8 coronata da San Michele arcangelo, santo patrono della citt\u00e0 di Bruxelles. Tale raffigurazione in rame dorato funge in realt\u00e0 da segnavento. Se il vento soffia nella direzione giusta, avrete modo di ammirare per bene l\u2019eroe della citt\u00e0 che sconfigge il drago! \r\n\r\nQuesto gioiello del patrimonio di Bruxelles ospita attualmente l\u2019ufficio del Turismo. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Ayuntamiento de Bruselas","address_street_name":"Grand-Place","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.brussel.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"El elegante edificio del siglo XV del ayuntamiento de Bruselas se encuentra en el coraz\u00f3n del centro hist\u00f3rico de la ciudad, en la suntuosa Grand-Place. \r\n\r\nConsiderado a menudo como la pieza clave de la plaza m\u00e1s bella del mundo es probablemente uno de los edificios m\u00e1s hermosos del pa\u00eds y evidentemente uno de los monumentos que no debes perderte en tu visita a Bruselas. Su espl\u00e9ndida torre se alza como punto de referencia, tanto para los visitantes del d\u00eda como para los belgas que pasan por el centro de la capital. \r\n\r\nUn regalo para la vista \r\n\r\nEste monumento, imponente por sus dimensiones, sus adornos esculpidos y su fachada asim\u00e9trica, llama r\u00e1pidamente la atenci\u00f3n de los transe\u00fantes. No es extra\u00f1o que al pasear delante de este prestigioso edificio veas en los balcones a alguna pareja de reci\u00e9n casados celebrando su enlace en los balcones. \r\n\r\nEl interior del ayuntamiento tambi\u00e9n merece una visita. Despierta la curiosidad de quienes desean descubrir la disposici\u00f3n y dise\u00f1o de las salas de esta obra maestra arquitect\u00f3nica. Se organizan con regularidad visitas guiadas al ayuntamiento para descubrir la riqueza de su interior que fascina a los visitantes. \r\n\r\nLa evoluci\u00f3n de un edificio singular \r\n\r\nSu construcci\u00f3n abarc\u00f3 un largo periodo y cont\u00f3 con la direcci\u00f3n de varios arquitectos. En un principio, el edificio \u00fanicamente contaba con un campanario y la parte izquierda que se ha conservado intacta hasta el d\u00eda de hoy. El campanario fue r\u00e1pidamente sustituido por la torre actual, cuando las casas de los diferentes gremios se instalaron en la plaza. Asimismo, se a\u00f1adi\u00f3 un ala adicional en la parte derecha para integrar mejor los nuevos edificios en este incomparable decorado. \r\n\r\nEn la cima de la nueva torre, de m\u00e1s de 90 m de altura, el arc\u00e1ngel San Miguel, patr\u00f3n de la ciudad de Bruselas, corona la aguja. Esta estatua de cobre dorado sirve de veleta. Si el viento sopla a su favor, tendr\u00e1s la ocasi\u00f3n de admirar de la mejor forma \u00a1c\u00f3mo San Miguel vence al drag\u00f3n! \r\n\r\nActualmente, esta joya del patrimonio bruselense alberga la oficina de turismo. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"C\u00e2mara Municipal de Bruxelas","address_street_name":"Grand-Place","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.bruxelles.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"O edif\u00edcio da C\u00e2mara Municipal de Bruxelas \u00e9 uma obra de arte da arquitetura civil g\u00f3tica do s\u00e9culo XV. No s\u00e9culo XVIII, foi-lhe adicionada uma ala de estilo cl\u00e1ssico. As in\u00fameras salas competem entre si em aparato. S\u00e3o notavelmente ornamentadas por tape\u00e7arias excecionais que evocam epis\u00f3dios locais e nacionais da hist\u00f3ria belga. Exposi\u00e7\u00f5es ocupam pontualmente os espa\u00e7os.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"H\u00f4tel de Ville de Bruxelles","address_street_name":"Grand-Place","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.bruxelles.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[13],"translations":{"fr":["Centre historique"],"nl":["Historisch centrum"],"en":["Historical Centre"]}},"zones":{"list":[19],"translations":{"fr":["Centre"],"nl":["Centrum"],"en":["Centre"]}},"neca":null,"facebook_id":null,"backoffice_id":112,"location":{"lat":50.8466937,"lon":4.35252339},"region":"brussels","last_updated_at":"2022-05-16T01:06:42+02:00","published_at":"2013-10-19T01:13:17+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":250604,"translations":{"fr":{"name":"vi