ivat-livemont-le-maitre-decorateur\/","email":"info@provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":"+32 2 502 73 55","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50006694"},"it":{"name":"Privat Livemont \u2013 le ma\u00eetre d\u00e9corateur","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.provelo.org\/events\/privat-livemont-le-maitre-decorateur\/","email":"info@provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":"+32 2 502 73 55","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50006694"},"cn":{"name":"Privat Livemont \u2013 le ma\u00eetre d\u00e9corateur","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.provelo.org\/events\/privat-livemont-le-maitre-decorateur\/","email":"info@provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":"+32 2 502 73 55","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50006694"},"fr":{"name":"Privat Livemont \u2013 le ma\u00eetre d\u00e9corateur","shortdescr":"L\u2019art nouveau ne se limite pas \u00e0 l\u2019architecture et touche toutes les disciplines artistiques. Peintre d\u00e9coratif de formation, Privat Livemont s\u2019installe \u00e0 Schaerbeek apr\u00e8s avoir parfait sa formation \u00e0 Paris et est engag\u00e9 comme professeur de dessin et de peinture d\u00e9corative \u00e0 l\u2019\u00e9cole industrielle.","longdescr":"Niveau : interm\u00e9diaire\nDistance : 28km\nL\u2019art nouveau ne se limite pas \u00e0 l\u2019architecture et touche toutes les disciplines artistiques. Peintre d\u00e9coratif de formation, Privat Livemont s\u2019installe \u00e0 Schaerbeek apr\u00e8s avoir parfait sa formation \u00e0 Paris et est engag\u00e9 comme professeur de dessin et de peinture d\u00e9corative \u00e0 l\u2019\u00e9cole industrielle. Il y retrouve ses camarades de classe Paul de Saintenoy et Adolphe Crespin et y c\u00f4toie Paul Hankar et Joseph Diongre. A cette \u00e9poque, l\u2019urbanisation galopante de Schaerbeek lui offre un terrain de choix pour y exercer son art. Passant de la d\u00e9coration int\u00e9rieure \u00e0 la peinture sur toile, de l\u2019affiche au sgraffite, Privat Livemont n\u2019aura de cesse de d\u00e9ployer son art m\u00ealant v\u00e9g\u00e9taux stylis\u00e9s et figure f\u00e9minines \u00e0 la longue chevelure. Sautez en selle pour partir \u00e0 la recherche de ses nombreuses r\u00e9alisations dans la commune de Schaerbeek.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.provelo.org\/events\/privat-livemont-le-maitre-decorateur\/","email":"info@provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":"+32 2 502 73 55","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50006694"},"sp":{"name":"Privat Livemont \u2013 le ma\u00eetre d\u00e9corateur","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.provelo.org\/events\/privat-livemont-le-maitre-decorateur\/","email":"info@provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":"+32 2 502 73 55","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50006694"},"nl":{"name":"Privat Livemont \u2013 le ma\u00eetre d\u00e9corateur","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.provelo.org\/events\/privat-livemont-le-maitre-decorateur\/","email":"info@provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":"+32 2 502 73 55","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50006694"}},"place":{"id":280345,"translations":{"de":{"name":"Rue de Dublin ","address_street_name":"Rue de Dublin","address_street_number":"19","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de Dublin, 19","address_line2":"1050 Ixell