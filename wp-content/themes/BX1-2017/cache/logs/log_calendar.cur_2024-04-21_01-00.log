start":"08:00:00","end":"21:00:00"}]},"saturday":{"is_open":true,"hours":[{"start":"08:00:00","end":"21:00:00"}]},"sunday":{"is_open":true,"hours":[{"start":"08:00:00","end":"21:00:00"}]}},"translations":{"en":["monday, tuesday, wednesday, thursday, friday, saturday and sunday: from 08:00 to 21:00"],"fr":["lundi, mardi, mercredi, jeudi, vendredi, samedi et dimanche: de 08:00 \u00e0 21:00"],"nl":["maandag, dinsdag, woensdag, donderdag, vrijdag, zaterdag en zondag: van 08:00 tot 21:00"]},"date_start":"2024-04-20","date_end":"2024-06-23","is_also_by_appointment":false}],"date_exceptions":[],"closing_days":[],"child_events":[],"parent_events":[],"accessibilities":{"list":[255],"translations":{"de":["Barrierefrei"],"pt":[null],"en":["Accessible"],"it":["Accessibile"],"cn":[null],"fr":["Accessible"],"sp":["Habilitado"],"nl":["Toegankelijk"]}},"visit_profile":{"list":[337],"translations":{"de":["Highlight"],"pt":[null],"en":["Highlight"],"it":["Highlight"],"cn":[null],"fr":["Highlight"],"sp":["Highlight"],"nl":["Highlight"]}},"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":["exterior"],"opening":{"day":"2024-04-20","end":"18:30:00","start":"14:30:00","timestamp":"2024-04-20T14:30:00"}},{"id":50008516,"date_start":"2024-04-14","date_end":"2024-05-26","date_next":"2024-04-20","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-04-20T02:01:56+02:00","published_at":"2024-03-16T01:03:24+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":296698,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.28543716208189446,"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[38,36],"translations":{"de":["Skulptur","Museen & Kunstzentren"],"pt":[null,null],"en":["Sculpture","Museums and art centers"],"it":["Scultura","Musei e centri artistici"],"cn":[null,null],"fr":["Sculpture","Mus\u00e9es et art centers"],"sp":["Escultura","Museos y centros de arte"],"nl":["Beeldhouwkunst","Musea en kunstcentra"]}}},"translations":{"de":{"name":"Earth, mirror of the soul. Ceramics by Antoine de Vinck (1924-1992)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.discoverkraainem.be\/main-fr","email":"discoverkraainem@gmail.com","phone_contact":"+32 477 64 91 18","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50008516"},"pt":{"name":"Earth, mirror of the soul. Ceramics by Antoine de Vinck (1924-1992)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.discoverkraainem.be\/main-fr","email":"discoverkraainem@gmail.com","phone_contact":"+32 477 64 91 18","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50008516"},"en":{"name":"Earth, mirror of the soul. Ceramics by Antoine de Vinck (1924-1992)","shortdescr":"1. Discovering clay. Design and beauty in everyday objects  \n2. From intention to realisation: the importance of drawing   \n3. Witnesses of a sacred presence\n4. Standing bodies. Man between heaven and earth  ","longdescr":"The ceramist-sculptor Antoine de Vinck lived and worked in Kraainem for 30 years, from 1954 to 1984. He raised the art of ceramics to a level that saw him recognised as a master both nationally and internationally. The Discover Kraainem non-profit-making association and the municipality of Kraainem are joining forces to organise a tribute exhibition marking the 100th anniversary of his birth.\nAntoine de Vinck became a potter and remained one all his life, striving for perfect mastery of the ceramic technique. His preferred medium was stoneware, fired in a wood-fired kiln at 1250\u00b0 - 1280\u00b0 C. But he was also an authentic sculptor: animals, objects bearing witness to a sacred presence and inviting meditation or contemplation and anthropomorphic figures both of great simplicity and highly expressive. Like the English sculptor Henry Moore, whom he greatly admired, he drew on civilisations far removed in time and space. He drew inspiration from tradition and introduced it into modern adventurousness.\nMore than 70 works by the artist - ceramics, often of imposing size, as well as drawings - will be on show, from museums and private collections. Some of them have never before been seen by  the public, not even in photographs.\n","performers":null,"boxoffice_url":null,"website":"https:\/\/www.discoverkraainem.be\/main-eng","email":"discoverkraainem@gmail.com","phone_contact":"+32 477 64 91 18","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50008516"},"it":{"name":"Earth, mirror of the soul. Ceramics by Antoine de Vinck (1924-1992)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.discoverkraainem.be\/main-fr","email":"discoverkraainem@gmail.com","phone_contact":"+32 477 64 91 18","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50008516"},"cn":{"name":"Earth, mirror of the soul. Ceramics by Antoine de Vinck (1924-1992)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.discoverkraainem.be\/main-fr","email":"discoverkraainem@gmail.com","phone_contact":"+32 477 64 91 18","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50008516"},"fr":{"name":"La terre, miroir de l'\u00e2me. C\u00e9ramiques d'Antoine de Vinck (1924-1992)","shortdescr":"1. Apprivoiser l'argile. Design et beaut\u00e9 des objets du quotidien\n2. De l'intention \u00e0 la r\u00e9alisation: l'importance du dessin\n3. Pr\u00e9sence du sacr\u00e9\n4. Corps debout. L'\u00eatre humain entre ciel et terre","longdescr":"Le c\u00e9ramiste-sculpteur Antoine de Vinck a v\u00e9cu et travaill\u00e9 \u00e0 Kraainem de 1954 \u00e0 1984. L'asbl Discover Kraainem et la commune  de Kraainem lui rendent hommage \u00e0 l'occasion du centenaire de sa naissance. Il a hiss\u00e9 la c\u00e9ramique \u00e0 un niveau qui l'a fait reconna\u00eetre comme un ma\u00eetre en Belgique et \u00e0 l'\u00e9tranger. Sa pr\u00e9f\u00e9rence allait au gr\u00e8s cuit au four \u00e0 bois.  Il est d'une part potier et designer, mais d'autre part sculpteur d'animaux, de pi\u00e8ces invitant \u00e0 la m\u00e9ditation ou \u00e0 la contemplation et de figures anthropomorphes d'un grand d\u00e9pouillement mais tr\u00e8s expressives. Comme le sculpteur Henry Moore qu'il admirait, il puise \u00e0 des civilisations \u00e9loign\u00e9es dans le temps ou l'espace. Son oeuvre est sous-tendue par une r\u00e9flexion li\u00e9e aux grands questionnements de l'humanit\u00e9.\nPlus de 70 oeuvres de l'artiste - des c\u00e9ramiques, souvent de taille imposante, et des dessins - ont \u00e9t\u00e9  r\u00e9unies, issues de mus\u00e9es ou de collections priv\u00e9es. Certaines pi\u00e8ces n'ont jamais \u00e9t\u00e9 montr\u00e9es au public, m\u00eame pas en photo.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.discoverkraainem.be\/main-fr","email":"discoverkraainem@gmail.com","phone_contact":"+32 477 64 91 18","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50008516"},"sp":{"name":"Earth, mirror of the soul. Ceramics by Antoine de Vinck (1924-1992)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.discoverkraainem.be\/main-fr","email":"discoverkraainem@gmail.com","phone_contact":"+32 477 64 91 18","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50008516"},"nl":{"name":"Aarde als spiegel van de ziel. Keramiekkunstwerken van Antoine de Vinck (1924-1992)","shortdescr":"1. Klei ontdekken. Mooie en functionele gebruiksvoorwerpen\n2. Van opzet naar realisatie: het belang van de tekening\n3. Het sacrale alomtegenwoordig\n4. Rechtopstaande lichamen. De mesn tussen hemel en aarde","longdescr":"Antoine de Vinck, beeldhouwer en keramist, leefde en werkte in Kraainem van 1954 tot 1984. Vzw Discover Kraainem en de gemeente Kraainem slaan de handen in elkaar om hem hulde te brengen ter gelegenheid van de 100ste verjaardag van zijn geboorte. Hij tilde de keramiek naar een niveau dat hem nationale en internationale erkenning opleverde. Hij had een voorkeur voor steengoed, gebakken in een houtgestookte oven. Hij was zowel pottenbakker en designer als volwaardig beeldhouwer van dieren, voorwerpen die uitnodigen tot meditatie en contemplatie en antropomorfe figuren. Zoals de Engelse beeldhouwer Henry Moore die hij bewonderde put hij in beschavingen die ver verwijderd zijn in tijd en ruimte. Zijn werk is gebaseerd op reflectie en sluit aan bij de existenti\u00eble vragen van de mens.\nMeer dan 70 kunstwerken van Antoine de Vinck werden bijeengebracht - keramiek en tekeningen - uit musea of priv\u00e9verzamelingen. Sommige stukken werden nooit eerder getoond.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.discoverkraainem.be\/main-nl","email":"discoverkraainem@gmail.com","phone_contact":"+32 477 64 91 18","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50008516"}},"place":{"id":50001351,"translations":{"de":{"name":"Ch\u00e2teau Jourdain","address_street_name":"Av. Dezangr\u00e9\/chemin du Ch\u00e2teau ","add