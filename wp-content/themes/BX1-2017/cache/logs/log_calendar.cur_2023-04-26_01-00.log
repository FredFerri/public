closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen","it":"Visite guidate","sp":"Visitas guiadas","pt":null,"cn":null}},"others":{"list":[112],"translations":{"fr":["Insolite"],"nl":["Ongewoon"],"en":["Unusual"],"de":["Ausgefallenes"],"it":["Insolito"],"sp":["Ins\u00f3lito"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Balade guid\u00e9e Si t\u2019y danses \u2013 Pour commencer, tout en perception","shortdescr":"D\u00e9couvrez l\u2019histoire de la danse de mani\u00e8re ludique et interactive et visitez des lieux insolites de Bruxelles gr\u00e2ce \u00e0 l\u2019application mobile Si t\u2019y danses-balades urbaines !","longdescr":"\u00c0 chaque \u00e9tape du parcours, une citation sur la danse appara\u00eet sur smartphone, r\u00e9v\u00e9lant une dimension po\u00e9tique, politique ou sociale de cet art du mouvement. Apr\u00e8s avoir positionn\u00e9 la citation en r\u00e9alit\u00e9 augment\u00e9e dans l\u2019espace qui les entoure, les participant.es ont acc\u00e8s \u00e0 un bonus li\u00e9 : vid\u00e9os d\u2019archives, invitations \u00e0 danser, explorations guid\u00e9es, cr\u00e9ations et anecdotes historiques\u2026\r\n\r\nSi les balades peuvent s\u2019effectuer, \u00e0 tout moment et en toute autonomie, une balade guid\u00e9e est organis\u00e9e \u00e0 l\u2019occasion de Danses en f\u00eate afin de vivre l\u2019exp\u00e9rience ensemble et en mouvement. \r\n\r\nLa balade, Pour commencer, tout en perception se compose principalement d\u2019explorations guid\u00e9es qui mettent en \u00e9veil les sens afin d\u2019aborder l\u2019espace urbain de mani\u00e8re sensible. D\u2019une dur\u00e9e d\u2019environ 1h15, elle va de la rue de Flandre \u00e0 la Place de la Monnaie, en passant par l\u2019\u00e9glise du B\u00e9guinage et explore les quartiers des Quais.\r\n\r\nGratuit sur r\u00e9servation : https:\/\/forms.gle\/2PrZ9cEhcLUKTP568","performers":"Florence Corin & Anne Golaz","boxoffice_url":null,"website":"https:\/\/contredanse.org\/event\/si-ty-danses-balade-guidee\/","email":"anne@contredanse.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.555545"},"nl":{"name":"Balade guid\u00e9e Si t\u2019y danses \u2013 Pour commencer, tout en perception","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/contredanse.org\/event\/si-ty-danses-balade-guidee\/","email":"anne@contredanse.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.555545"},"en":{"name":"Balade guid\u00e9e Si t\u2019y danses \u2013 Pour commencer, tout en perception","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/contredanse.org\/event\/si-ty-danses-balade-guidee\/","email":"anne@contredanse.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.555545"},"de":{"name":"Balade guid\u00e9e Si t\u2019y danses \u2013 Pour commencer, tout en perception","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/contredanse.org\/event\/si-ty-danses-balade-guidee\/","email":"anne@contredanse.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.555545"},"it":{"name":"Balade guid\u00e9e Si t\u2019y danses \u2013 Pour commencer, tout en perception","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/contredanse.org\/event\/si-ty-danses-balade-guidee\/","email":"anne@contredanse.org","phone_contact":null,"phone_booking":null,"agenda_url"