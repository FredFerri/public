:{"is_open":true,"hours":[{"start":"14:00:00","end":"18:00:00"}]}},"translations":{"en":["monday and tuesday: closed","wednesday, thursday, friday, saturday and sunday: from 14:00 to 18:00"],"fr":["lundi et mardi: ferm\u00e9","mercredi, jeudi, vendredi, samedi et dimanche: de 14:00 \u00e0 18:00"],"nl":["maandag en dinsdag: gesloten","woensdag, donderdag, vrijdag, zaterdag en zondag: van 14:00 tot 18:00"]},"date_start":"2023-09-28","date_end":"2023-11-12","is_also_by_appointment":false}],"date_exceptions":[],"closing_days":[],"child_events":[],"parent_events":[],"accessibilities":{"list":[261],"translations":{"de":["Barrierefreier Parkplatz"],"pt":[null],"en":["Accessible parking"],"it":["Parcheggio accessibile"],"cn":[null],"fr":["Parking accessible"],"sp":["Estacionamiento habilitado"],"nl":["Toegankelijke parking"]}},"recurring":[],"targets":{"list":[11],"translations":{"de":["Familie"],"pt":[null],"en":["Family"],"it":["Famiglie"],"cn":[null],"fr":["Famille"],"sp":["Familias"],"nl":["Familie"]}},"educational_targets":{"list":[],"translations":{}},"tags":["kids"],"opening":{"day":"2023-09-27","end":"21:00:00","start":"18:00:00","timestamp":"2023-09-27T18:00:00"}},{"id":50000958,"date_start":"2023-09-10","date_end":"2023-12-31","date_next":"2023-10-25","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":true,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2023-10-23T02:03:40+02:00","published_at":"2023-08-14T08:25:55+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":283183,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.2606056641783871,"languages":{"spoken":["nl","fr","en"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[39,36],"translations":{"de":["Fotografie","Museen & Kunstzentren"],"pt":[null,null],"en":["Photography","Museums and art centers"],"it":["Fotografia","Musei e centri artistici"],"cn":[null,null],"fr":["Photographie","Mus\u00e9es et art centers"],"sp":["Fotograf\u00eda","Museos y centros de arte"],"nl":["Fotografie","Musea en kunstcentra"]}}},"translations":{"de":{"name":"Forever. \"The best day of my life\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/tinygallery.photo","email":"olivier@tinygallery.brussels","phone_contact":"+32 475 27 95 56","phone_booking":"+32 475 27 95 56","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50000958"},"pt":{"name":"Forever. \"The best day of my life\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/tinygallery.photo","email":"olivier@tinygallery.brussels","phone_contact":"+32 475 27 95 56","phone_booking":"+32 475 27 95 56","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50000958"},"en":{"name":"Forever. \"The best day of my life\"  \"A close-up of Love and Marriage\" Amateur Photography","shortdescr":"Marriage has been the popular subject for professional and amateur photographers since the 1900s. This exhibition presents contemporary  artists, along with professional photographers, and historical images from 10 countries. On the borderline of Art Brut, the exhibition explores the emotional journey amidst vibrant joy and melancholic sadness, and is a gateway to family memories and legends.","longdescr":"The Tiny Gallery, a small museum of amateur photography, welcomes thirteen contemporary artists of ten nationalities around their passion for ancient techniques. Since the earliest days of photography, amateurs have used these historic techniques, such as salted paper, cyanotype, or albumen, to document daily life. The exhibition \"Forever, a Close-Up of Love and Marriage\" raises a new question: what is the place and destiny of amateur photographers in a wedding? At the time of selfies and massive sharing by hashtags, the wedding photo has this special quality; it is the one that remains and that we print and enlarge.\n\nFor this project, Olivier Guyaux, curator and collector, has extended his historical collection by collecting original wedding photos from Belgium, France, the former Yugoslavia, Ukraine, and the United States. The artists, for their part, made their own contribution to their personal approach. The Tiny Gallery is a research laboratory on the border of the intimate: a subject, the quest, and the encounter with an archive...\n\nAesthetic, instantaneous, kitsch, and inclusive, the wide international itinerary is enriched by images collected by the artists in a family approach that is part of deep intimacy. They are particularly thanked here.\nThe creations were made as part of the old processes and workshops of the Tiny Gallery during the years 2022\u20132023.","performers":null,"boxoffice_url":null,"website":"http:\/\/tinygallery.photo","email":"olivier@tinygallery.brussels","phone_contact":"+32 475 27 95 56","phone_booking":"+32 475 27 95 56","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50000958"},"it":{"name":"Forever. \"The best day of my life\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/tinygallery.photo","email":"olivier@tinygallery.brussels","phone_contact":"+32 475 27 95 56","phone_booking":"+32 475 27 95 56","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50000958"},"cn":{"name":"Forever. \"The best day of my life\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/tinygallery.photo","email":"olivier@tinygallery.brussels","phone_contact":"+32 475 27 95 56","phone_booking":"+32 475 27 95 56","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50000958"},"fr":{"name":"Forever. \"A close-up of Love and Marriage\" Amateur Photography","shortdescr":"Le mariage est le sujet populaire pour les photographes professionnels et amateurs depuis les ann\u00e9es 1900. Artistes contemporains, photographes professionnels et images historiques de 10 pays se croisent et se r\u00e9pondent. A la fronti\u00e8re de l\u2019Art Brut, c'est un voyage \u00e9motionnel entre la joie color\u00e9e et la tristesse m\u00e9lancolique; c\u2019est aussi une porte ouverte aux souvenirs et l\u00e9gendes familiales.","longdescr":"La Tiny Gallery, le petit mus\u00e9e de la photographie amateur, accueille treize artistes contemporains de dix nationalit\u00e9s autour de leur passion pour les techniques anciennes. Depuis les premiers jours de la photographie, les amateurs utilisent ces techniques historiques, telles que le papier sal\u00e9, le cyanotype ou l'albumine, pour documenter la vie quotidienne. L'exposition \"FOREVER, a close-up of Love and Marriage\" pose une nouvelle question: quelle est la place et la destin\u00e9e des photographes amateurs dans un mariage ? A l'heure des selfies et des partages massifs par hashtags, la photo de mariage a ceci de sp\u00e9cial, c\u2019est celle qui reste, que l'on imprime et agrandit.\n\nPour ce projet, Olivier Guyaux, curateur et collectionneur, a \u00e9tendu sa collection historique en recueillant des clich\u00e9s de mariage originaux provenant de Belgique, France, ex-Yougoslavie, Ukraine ou encore des \u00c9tats-Unis. Les artistes ont, quant \u00e0 eux, apport\u00e9 une contribution propre \u00e0 leur d\u00e9marche personnelle. La Tiny Gallery est un laboratoire de recherches \u00e0 la fronti\u00e8re de l\u2019intime : un sujet, la qu\u00eate et la rencontre d\u2019une archive\u2026\n\nEsth\u00e9tique, instantan\u00e9, kitsch, inclusif, le large parcours international s\u2019enrichit des images collect\u00e9es par les artistes dans une d\u00e9marche familiale qui s\u2019inscrit dans l\u2019intime profond. Qu\u2019ils en soient ici particuli\u00e8rement remerci\u00e9s. \nLes cr\u00e9ations ont \u00e9t\u00e9 r\u00e9alis\u00e9es dans le cadre des ateliers proc\u00e9d\u00e9s anciens et rencontres de la Tiny Gallery durant l\u2019ann\u00e9e 2022-2023.\n","performers":"Doroth\u00e9e Wycart, Andrea Csepregi, Cecilia Bel\u00e9n Sandoval, Monya Ghabantani, Ben Money-Kyrle, Beatri Narbutait, Petermfriess, Yves Goethals, Candice De Turck, and Olivier Guyaux (Collection and Curation)","boxoffice_url":null,"website":"http:\/\/tinygallery.photo","email":"olivier@tinygallery.brussels","phone_contact":"+32 475 27 95 56","phone_booking":"+32 475 27 95 56","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50000958"},"sp":{"name":"Forever. \"The best day of my life\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/tinygallery.photo","email":"olivier@tinygallery.brussels","phone_contact":"+32 475 27 95 56","phone_booking":"+32 475 27 95 56","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50000958"},"nl":{"name":"Forever. \"The best day of my life\"  \"A close-up of Love and Marriage\" Amateur Photography","shortdescr":"Het huwelijk is sinds de jaren 1900 het populaire onderwerp voor professionele en amateurfotografen. De tentoonstelling toont hedendaagse kunstenaars, samen met professionele fotografen, en vintage beelden uit 10 landen. Op de grens van Art Brut verkent de tentoonstelling de emotionele reis te midden van levendige vreugde en melancholische droefheid,  een toegangspoort tot familieherinneringen.","longdescr":"De Tiny Gallery, het kleine museum voor amateurfotografie, verwelkomt dertien hedendaagse kunstenaars van tien nationaliteiten rond hun passie voor oude technieken. Sinds de begindagen van de fotografie hebben amateurs deze historische technieken, zoals gezouten papier, cyanotypie of albumine, gebruikt om het dagelijks leven vast te leggen. De tentoonstelling \"FOREVER, een close-up van liefde en huwelijk\" roept een nieuwe vraag op: wat is de plaats en het lot van amateurfotografen op een bruiloft? Ten tijde van selfies en massaal delen via hashtags, heeft de trouwfoto dit speciale, het is degene die overblijft, die we afdrukken en vergroten.\n\nVoor dit project heeft Olivier Guyaux, curator en verzamelaar, zijn historische collectie uitgebreid met originele trouwfoto's uit Belgi\u00eb, Frankrijk, voormalig Joegoslavi\u00eb, Oekra\u00efne en de Verenigde Staten. De kunstenaars droegen op hun beurt bij aan hun persoonlijke aanpak. De Tiny Gallery is een onderzoekslaboratorium op de grens van het intieme: een onderwerp, de zoektocht en de ontmoeting met een archief...\n\nEsthetisch, onmiddellijk, kitsch, inclusief, de brede internationale route wordt verrijkt met beelden die door de kunstenaars zijn verzameld in een familiale benadering die deel uitmaakt van diepe intimiteit. Ze worden hier bijzonder bedankt.\nDe creaties zijn gemaakt als onderdeel van de oude processen en ontmoetingsworkshops van de Tiny Gallery gedurende het jaar 2022-2023.","performers":null,"boxoffice_url":null,"website":"http:\/\/tinygallery.photo","email":"olivier@tinygallery.brussels","phone_contact":"+32 475 27 95 56","phone_booking":"+32 475 27 95 56","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50000958"}},"place":{"id":275243,"translations":{"de":{"name":"TinyGallery Brussels","address_street_name":"Rue de la Cuve","address_street_number":"26","address_street_box":null,"email":"ogc@ogc.be","website":"http:\/\/www.tinygallery.photo","phone_contact":"+32 475 27 95 56","phone_booking":"+32 472 27 95 56","address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de la Cuve, 26","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"TinyGallery Brussels","address_street_name":"Rue de la Cuve","address_street_number":"26","address_street_box":null,"email":"ogc@ogc.be","website":"http:\/\/www.tinygallery.photo","phone_contact":"+32 475 27 95 56","phone_booking":"+32 472 27 95 56","address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de la Cuve, 26","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"TinyGallery Brussels","address_street_name":"Rue de la Cuve","address_street_number":"26","address_street_box":null,"email":"ogc@ogc.be","website":"http:\/\/www.tinygallery.photo","phone_contact":"+32 475 27 95 56","phone_booking":"+32 472 27 95 56","address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de la Cuve, 26","address_line2":"1050 Ixelles","description_web":"TinyGallery - Small museum of amateur photography - wishes to preserve amateur photography and pay tribute to the anonymous artists who authored them.\r\n\r\nWhether produced intentionally or accidentally, amateur photography fascinates us with its spontaneous creations. Magical, raw moments are captured, allowing us an intimate insight into the lives of strangers who lived over a century ago. In a nod to the vanity of the ephemeral, these benevolent ghosts, who have long been protected by the shadows of the past, surprise us with their proximity. Battered and bruised albums scattered over flea markets surrender to us defencelessly, bearing witness to a time when photography was not considered dangerous. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"TinyGallery Brussels","address_street_name":"Rue de la Cuve","address_street_number":"26","address_street_box":null,"email":"ogc@ogc.be","website":"http:\/\/www.tinygallery.photo","phone_contact":"+32 475 27 95 56","phone_booking":"+32 472 27 95 56","address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de la Cuve, 26","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"TinyGallery Brussels","address_street_name":"Rue de la Cuve","address_street_number":"26","address_street_box":null,"email":"ogc@ogc.be","website":"http:\/\/www.tinygallery.photo","phone_contact":"+32 475 27 95 56","phone_booking":"+32 472 27 95 56","address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de la Cuve, 26","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"fr":{"name":"TinyGallery Brussels","address_street_name":"Rue de la Cuve","address_street_number":"26","address_street_box":null,"email":"ogc@ogc.be","website":"http:\/\/www.tinygallery.photo","phone_contact":"+32 475 27 95 56","phone_booking":"+32 472 27 95 56","address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de la Cuve, 26","address_line2":"1050 Ixelles","description_web":"La TinyGallery - Petit mus\u00e9e de la photographie amateur - veut conserver la photographie amateur et rendre hommage \u00e0 leurs auteurs, ces artistes anonymes.\r\n\r\nIntentionnelle ou accidentelle, la photographie amateur nous fascine par ses cr\u00e9ations spontan\u00e9es. Instants magiques et bruts o\u00f9 nous entrons dans l\u2019intimit\u00e9 de ces inconnus \u00e0 plus d\u2019un si\u00e8cle de distance. Clins d'oeil \u00e0 la vanit\u00e9 de l'\u00e9ph\u00e9m\u00e8re, ces fant\u00f4mes bienveillants longtemps prot\u00e9g\u00e9s dans l\u2019ombre des albums nous surprennent par leur proximit\u00e9. Albums d\u00e9piaut\u00e9s, dispers\u00e9s, brocant\u00e9s, se livrant et sans d\u00e9fenses, ils sont les t\u00e9moins d\u2019un temps o\u00f9 la photographie n'\u00e9tait pas consid\u00e9r\u00e9e comme dangereuse. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"TinyGallery Brussels","address_street_name":"Rue de la Cuve","address_street_number":"26","address_street_box":null,"email":"ogc@ogc.be","website":"http:\/\/www.tinygallery.photo","phone_contact":"+32 475 27 95 56","phone_booking":"+32 472 27 95 56","address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de la Cuve, 26","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"TinyGallery Brussels","address_street_name":"Kuipstraat","address_street_number":"26","address_street_box":null,"email":"ogc@ogc.be","website":"http:\/\/www.tinygallery.photo","phone_contact":"+32 475 27 95 56","phone_booking":"+32 472 27 95 56","address_zip":"1050","address_city":"Ixelles","address_line1":"Kuipstraat, 26","address_line2":"1050 Ixelles","description_web":"TinyGallery - Klein museum voor amateurfotografie - wil de amateurfotografie conserveren en hulde brengen aan hun auteurs, deze anonieme kunstenaars.\r\n\r\nAmateurfotografie fascineert ons door de spontane creaties. Ze ontstaan doelbewust of ongewild, die magische en authentieke fragmenten van de intimiteit van onbekenden die meer dan een eeuw geleden leefden. Een knipoog naar de ijdelheid van het kortstondige, welwillende geesten die lang beschermd waren in de schaduw van vergeten albums. Ze verrassen ons met hun nabijheid, intieme albums die weerloos opengerukt eindigden op de rommelmarkt, stille getuigen van een tijd waarin fotografie niet als gevaarlijk werd beschouwd. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[5],"translations":{"de":["Flagey"],"pt":[null],"en":["Flagey"],"it":["Flagey"],"cn":[null],"fr":["Flagey"],"sp":["Flagey"],"nl":["Flagey"]}},"zones":{"list":[21],"translations":{"de":["S\u00fcden"],"pt":[null],"en":["South"],"it":["Sud"],"cn":[null],"fr":["Sud"],"sp":["Sur"],"