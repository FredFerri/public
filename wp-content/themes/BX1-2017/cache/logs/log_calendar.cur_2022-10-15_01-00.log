ate_next":"2022-10-15","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert","de":"Konzert"}},"others":{"list":[2],"translations":{"fr":["Classique"],"nl":["Klassiek"],"en":["Classical"],"de":["Klassisch"]}}},"languages":{"spoken":["fr","en"],"subtitles":[]},"translations":{"fr":{"name":"Cesar Franck - 200th Anniversary Celebration","shortdescr":null,"longdescr":"Nous ne pouvions pas passer sous silence le 200e anniversaire de notre cher compositeur belge, C\u00e9sar Franck. Nous vous avons concoct\u00e9 un programme comprenant sa c\u00e9l\u00e8bre sonate pour violon transcrite pour le violoncelle ainsi que des \u0153uvres de Debussy pour un apr\u00e8s-midi franco-belge plut\u00f4t r\u00eaveur.\r\n\r\nPROGRAMME\r\n\r\nC. Debussy : Sonate pour violoncelle et piano\r\nVashti Hunter, violoncelle \/ Muhiddin Durruoglu, piano\r\n\r\nC. Debussy |Quatuor M\u00e9nestrels et Sarabande\r\nChiara Samatanga, Vashti Hunter, Jens Peter Maintz, Natania Hoffman, violoncelles\r\n\r\nC. Franck | M\u00e9lancolie \r\nNatania Hoffman, violoncelle \/ Muhiddin Durruoglu, piano\r\n\r\nC. Franck | Sonate pour violon et piano en la majeur\r\nJens Peter Maintz, violoncelle \/ Muhiddin Durruoglu, piano","performers":"Vashti Hunter (violoncelliste)\r\nMuhiddin Durruoglu (pianiste)\r\nChiara Samatanga (violoncelliste)\r\nJens Peter Maintz (violoncelliste)\r\nNatania Hoffman (violoncelliste)","boxoffice_url":null,"website":"http:\/\/www.brusselscellofestival.com","email":"info@belgiumcellosociety.com","phone_contact":"+32 456 14 80 42","phone_booking":"+32 456 14 80 42","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.539548"},"nl":{"name":"Cesar Franck - 200th Anniversary Celebration","shortdescr":null,"longdescr":"We konden de speciale 200ste verjaardag van onze geliefde Belgische componist, C\u00e9sar Franck, dit jaar niet over het hoofd zien - we hebben een programma samengesteld met zijn beroemde vioolsonate getranscribeerd voor de cello naast werken van Debussy voor een nogal dromerige Frans-Belgische middag.\r\n\r\nPROGRAMMA\r\n\r\nC. Debussy | Sonate voor cello en piano\r\nVashti Hunter, cello \/ Muhiddin Durruoglu, piano\r\n\r\nC. Debussy | Kwartet Minstrelen en Sarabande\r\nChiara Samatanga, Vashti Hunter, Jens Peter Maintz, Natania Hoffman, cello's\r\n\r\nC. Franck | M\u00e9lancolie \r\nNatania Hoffman, cello \/ Muhiddin Durruoglu, piano\r\n\r\nC. Franck | Sonate voor viool en piano in A groot\r\nJens Peter Maintz, cello \/ Muhiddin Durruoglu, piano","performers":"Vashti Hunter (cellist)\r\nMuhiddin Durruoglu (pianist)\r\nChiara Samatanga (cellist)\r\nJens Peter Maintz (cellist)\r\nNatania Hoffman (cellist)","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.539548"},"en":{"name":"Cesar Franck - 200th Anniversary Celebration","shortdescr":null,"longdescr":"We could not overlook this year\u2019s special 200th anniversary of our beloved Belgian composer, C\u00e9sar Franck \u2013 we have curated a programme featuring his famous Violin sonata transcribed for the cello alongside works by Debussy for a rather dreamy Frano-Belgian afternoon.\r\n\r\nPROGRAMME\r\n\r\nC. Debussy | Sonata for Cello and Piano\r\nVashti Hunter, cello \/ Muhiddin Durruoglu, piano\r\n\r\nC. Debussy |Quartet Minstrels and Sarabande\r\nChiara Samatanga, Vashti Hunter, Jens Peter Maintz, Natania Hoffman, cellos\r\n\r\nC. Franck | M\u00e9lancolie \r\nNatania Hoffman, cello \/ Muhiddin Durruoglu, piano\r\n\r\nC. Franck | Sonata for Violin and Piano in A major\r\nJens Peter Maintz, cello \/ Muhiddin Durruoglu, piano","performers":"Vashti Hunter (cellist)\r\nMuhiddin Durruoglu (pianist)\r\nChiara Samatanga (cellist)\r\nJens Peter Maintz (cellist)\r\nNatania Hoffman (cellist)","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.539548"},"de":{"name":"Cesar Franck - 200th Anniversary Celebration","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.539548"},"it":{"name":"Cesar Franck - 200th Anniversary Celebration","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.539548"},"sp":{"name":"Cesar Franck - 200th Anniversary Celebration","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.539548"},"pt":{"name":"Cesar Franck - 200th Anniversary Celebration","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.539548"},"cn":{"name":"Cesar Franck - 200th Anniversary Celebration","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.539548"}},"place":{"id":266947,"translations":{"fr":{"name":"Koninklijk Conservatorium van Brussel vzw","address_street_name":"Rue de la R\u00e9gence","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.kcb.be\/","phone_contact":"+32 2 213 41 10","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la R\u00e9gence","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Koninklijk Conservatorium van Brussel vzw","address_street_name":"Regentschapsstraat","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.kcb.be\/","phone_contact":"+32 2 213 41 10","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Regentschapsstraat","address_line2":"1000 Brussel","description_web":"Het Koninklijk Conservatorium Brussel (KCB) kent een lange traditie. De Vlaamse afdeling maakt thans deel uit van de Erasmushogeschool Brussel. Oorspronkelijk een Franstalig opleidingsinstituut, werd de instelling in 1967 taalkundig gesplitst. De Nederlandstalige en Franstalige afdeling delen hetzelfde gebouw en een aantal professoren. In de praktijk is het Brusselse conservatorium een smeltkroes van culturen en talen. Voor oude (voornamelijk barok) instrumenten heeft het conservatorium een wereldreputatie opgebouwd.\r\nHet KCB programmeert regelmatig concerten waarbij de studenten podiumkansen krijgen om hen vertrouwd te maken met het concertgebeuren in al zijn facetten. Wanneer zij er klaar voor zijn kunnen ze dan uitzwermen naar podia buiten... Daarvoor wordt samengewerkt met de verschillende Brusselse muziekorganisatoren waaronder Flagey, Ars Musica, Het Paleis voor Schone Kunsten van Brussel, het Muziekinstrumentenmuseum en anderen.  \r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Koninklijk Conservatorium van Brussel vzw","address_street_name":"Regentschapsstraat","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.kcb.be\/","phone_contact":"+32 2 213 41 10","phone_booking":null,"address_zip":"1000","address_city":