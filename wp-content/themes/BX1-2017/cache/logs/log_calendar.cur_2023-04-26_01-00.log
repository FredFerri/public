nceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen","it":"Visite guidate","sp":"Visitas guiadas","pt":null,"cn":null}},"others":{"list":[253],"translations":{"fr":["Visites guid\u00e9es d\u2019int\u00e9rieurs"],"nl":["Interieur rondleidingen"],"en":["Interior guided tours"],"de":["F\u00fchrungen durch Innenr\u00e4ume"],"it":["Visite guidate all\u2019interno"],"sp":["Visitas guiadas en espacios interiores"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Visite guid\u00e9e de l'h\u00f4tel de ville de Saint-Gilles","shortdescr":null,"longdescr":"Inaugur\u00e9 en 1904, cet h\u00f4tel de ville est un des plus beaux de notre capitale. Con\u00e7u dans l\u2019ambiance optimiste de la Belle Epoque, il a fait appel aux meilleurs artistes pour \r\nillustrer la conviction que les progr\u00e8s de l\u2019humanit\u00e9 se feront par l\u2019Art, la Science, l\u2019Education, la D\u00e9mocratie, le Travail\u2026. Quel programme ! Et quelle r\u00e9ussite artistique ! Notre parcours int\u00e9rieur et ext\u00e9rieur vous en donnera les cl\u00e9s et vous emm\u00e8nera de \r\nsurprise en surprise !\r\n\r\nINSCRIPTION OBLIGATOIRE\u00a0:\r\n- Par courrier postal (rue des Moineaux, 17-19 \u2013 1000 Bruxelles)\r\n  A notre accueil (Rue du Midi 118 \u2013 1000 Bruxelles, ouvert du lundi au vendredi de 8h30 \u00e0 15h)\r\n- Par e-mail (sacademie.asbl@solidaris.be)\r\n\r\nY mentionner :\r\nnom, pr\u00e9nom, adresse, date de naissance, n\u00b0 de gsm,\r\nl'activit\u00e9 choisie, n\u00b0 de membre S\u2019Acad\u00e9mie (ou n\u00b0 de mutuelle) ou demande d'affiliation.\r\n\r\nIl n'y a pas d'inscription par t\u00e9l\u00e9phone, mais l'asbl est joignable au 02 546 14 94 pour toute information.\r\nUne confirmation d'inscription vous parviendra par voie postale avec les modalit\u00e9s de paiement.\r\nUn courrier avec les informations pratiques vous sera envoy\u00e9 quelques jours avant l'activit\u00e9.\r\n\r\nLes activit\u00e9s sont r\u00e9serv\u00e9es aux membres de S'Acad\u00e9mie asbl:\r\n- Membres de Solidaris Brabant  : AFFILIATION gratuite\r\n- Non-Solidaris  : 50 \u20ac par ann\u00e9e acad\u00e9mique\r\n- AFFILIATION possible sur simple demande pour les personnes de plus de 50 ans, pensionn\u00e9es ou non. \r\n\r\nLes conditions g\u00e9n\u00e9rales sous lesquelles sont organis\u00e9es les activit\u00e9s sont disponibles sur le site www.fmsb.be\/fr\/sacademie. Vous inscrire implique que vous en ayez pris connaissance.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.fmsb.be\/fr\/sacademie","email":"sacademie.asbl@solidaris.be","phone_contact":"+32 2 546 14 94","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.550056"},"nl":{"name":"Visite guid\u00e9e de l'h\u00f4tel de ville de Saint-Gilles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.fmsb.be\/fr\/sacademie","email":"sacademie.asbl@solidaris.be","phone_contact":"+32 2 546 14 94","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.550056"},"en":{"name":"Visite guid\u00e9e de l'h\u00f4tel de ville de Saint-Gilles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.fmsb.be\/fr\/sacademie","email":"sacademie.asbl@solidaris.be","phone_contact":"+32 2 546 14 94","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.550056"},"de":{"name":"Visite guid\u00e9e de l'h\u00f4tel de ville de Saint-Gilles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.fmsb.be\/fr\/sacademie","email":"sacademie.asbl@solidaris.be","phone_contact":"+32 2 546 14 94","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.