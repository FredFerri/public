,"phone_booking":"+32 2 548 26 10","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50008025"},"en":{"name":"Louise Combier en concert","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/bibliotheques.bruxelles.be\/agenda\/louise-combier-en-concert","email":"bp1@brucity.education","phone_contact":"+32 2 548 26 10","phone_booking":"+32 2 548 26 10","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50008025"},"it":{"name":"Louise Combier en concert","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/bibliotheques.bruxelles.be\/agenda\/louise-combier-en-concert","email":"bp1@brucity.education","phone_contact":"+32 2 548 26 10","phone_booking":"+32 2 548 26 10","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50008025"},"cn":{"name":"Louise Combier en concert","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/bibliotheques.bruxelles.be\/agenda\/louise-combier-en-concert","email":"bp1@brucity.education","phone_contact":"+32 2 548 26 10","phone_booking":"+32 2 548 26 10","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50008025"},"fr":{"name":"Louise Combier en concert","shortdescr":"Louise Combier propose un registre musical aussi (\u00e9)mouvant qu'authentique, couleurs pop et chanson fran\u00e7aise.","longdescr":"Autrice et compositrice, elle s\u2019accompagne avec une singuli\u00e8re \u00e9l\u00e9gance \u00e0 son clavier, aux sonorit\u00e9s moelleuses et satur\u00e9es.\nUn registre qui saisit d\u00e8s les premiers mots gr\u00e2ce \u00e0 des textes instinctifs et po\u00e9tiques \u00e0 la fois.\nLaur\u00e9ate du Prix C\u00e9cile Pollet 2023, Louise sortira le 22 mars 2024 son tout dernier titre \u00ab Nuits cin\u00e9matiques \u00bb, marquant une \u00e9volution artistique \u00ab pop \u00bb notable \u00e0 d\u00e9couvrir sur toutes les plateformes sans mod\u00e9ration aucune !\nApr\u00e8s ses tr\u00e8s remarqu\u00e9es prestations dans \u00ab The Voice \u00bb, et avoir assur\u00e9 les premi\u00e8res parties de Marc Lavoine, Louise Combier sillonne d\u00e9sormais les routes de France avec une tourn\u00e9e nationale d\u00e9but\u00e9e en septembre 2023, en passant par Monaco, la Suisse et la Belgique...et la biblioth\u00e8que des Riches Claires","performers":"Louise Combier","boxoffice_url":null,"website":"https:\/\/bibliotheques.bruxelles.be\/agenda\/louise-combier-en-concert","email":"bp1@brucity.education","phone_contact":"+32 2 548 26 10","phone_booking":"+32 2 548 26 10","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50008025"},"sp":{"name":"Louise Combier en concert","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/bibliotheques.bruxelles.be\/agenda\/louise-combier-en-concert","email":"bp1@brucity.education","phone_contact":"+32 2 548 26 10","phone_booking":"+32 2 548 26 10","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50008025"},"nl":{"name":"Louise Combier en concert","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/bibliotheques.bruxelles.be\/agenda\/louise-combier-en-concert","email":"bp1@brucity.education","phone_contact":"+32 2 548 26 10","phone_booking":"+32 2 548 26 10","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50008025"}},"place":{"id":270068,"translations":{"de":{"name":"Biblioth\u00e8que des Riches Claires","address_street_name":"rue des Riches Claires","address_street_number":"24","address_street_box":null,"email":null,"website":"http:\/\/www.lasemainenumerique.be\/_Bibliotheque-des-Riches-Claires_.html","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"rue des Riches Claires, 24","address_line2":"1000 Bruxelles","description_web":null,"description_prin