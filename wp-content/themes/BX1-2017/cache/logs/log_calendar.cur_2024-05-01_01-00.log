/visit.brussels\/cn\/visitors\/agenda\/event-detail.530588"},"fr":{"name":"2 Balades audio-guid\u00e9es \u00e0 travers les cit\u00e9s jardins Le Logis et Flor\u00e9al \u00e0 Watermael-Boitsfort","shortdescr":"Smarphone \u00e0 la main laissez vous guider par les sons et les images dans les rues et les venelles de ces deux cit\u00e9s jardins magnifiquement pr\u00e9serv\u00e9es","longdescr":"Une immersion passionnante, tant\u00f4t \u00e9mouvante tant\u00f4t dr\u00f4le dans l'histoire sociale des ann\u00e9es 20, avec ses utopies et ses d\u00e9ceptions.\r\n\r\nAccessible 7j\/7, 24h\/24\r\n\r\nPour acc\u00e9der aux balades:\r\nSuivez les liens suivants:\r\nLe Logis: https:\/\/izi.travel\/fr\/ccff-cite-jardin-le-logis\/fr\r\nFlor\u00e9al:https:\/\/izi.travel\/fr\/c387-cite-jardin-floreal\/fr\r\nOu\r\nT\u00e9l\u00e9chargez gratuitement  IZI.TRAVEL puis recherchez Le Logis ou Flor\u00e9al et t\u00e9l\u00e9chargez la balade.\r\nOu\r\nScannez les QR codes de l'affiche\r\n\r\nIl est conseill\u00e9 de t\u00e9l\u00e9charger les balades \u00e0 l'avance pour ne pas avoir de probl\u00e8me de connexion \r\n\r\n\r\nD\u00e9part de la balade Le Logis: Maison Communale de Watermael-Boitsfort\r\nD\u00e9part de la balade Flor\u00e9al: Fer \u00e0 Cheval, av. des Archiducs\r\n\r\n","performers":null,"boxoffice_url":null,"website":"https:\/\/watermael-boitsfort.be\/fr\/vivre-a-watermael-boitsfort\/decouvrir-autrement\/balades-audio-cites-jardins?set_language=fr","email":"tilia@wb1170.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.530588"},"sp":{"name":"2 Balades audio-guid\u00e9es \u00e0 travers les cit\u00e9s jardins Le logis et Flor\u00e9al \u00e0 Watermael-Boitsfort","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/watermael-boitsfort.be\/fr\/vivre-a-watermael-boitsfort\/decouvrir-autrement\/balades-audio-cites-jardins?set_language=fr","email":"tilia@wb1170.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.530588"},"nl":{"name":"2 Smartphone rondleidingen door de tuinwijken Le Logis en Flor\u00e9al","shortdescr":"De bezoeker volgt via Smartphone een uitgestippelde route en kan luisteren naar verhalen geillustreerd met muziek en beelden uit de tijd.","longdescr":"Een fascinerende onderdompeling, soms ontroerend, soms grappig in de sociale geschiedenis van jaren 20 van vorige eeuw, met zijn utopie\u00ebn en teleurstellingen.\r\n\r\nToegankelijk 7d\/7, 24u\/24.\r\n\r\nGratis te downloaden  IZI.TRAVEL , zoekwoord Le Logis of Flor\u00e9al waarna het bestand gedownload kan worden.\r\nOf\r\nVolgtde link:\r\nLe Logis: https:\/\/izi.travel\/nl\/\/ccff-tuinwijk-le-logis\/nl\r\nFlor\u00e9al: https:\/\/izi.travel\/fr\/c387-tuinwijk-floreal\/nl\r\n","performers":null,"boxoffice_url":null,"website":"https:\/\/watermaal-bosvoorde.be\/nl\/leven-te-watermaal-bosvoorde\/ontdek-watermaal-bosvoorde-anders\/rondleiding-met-audiogids-door-de-tuinwijk-floreal?set_language=nl","email":"tilia@wb1170.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.530588"}},"place":{"last_updated_at":"2023-09-14T10:35:33+02:00","published_at":"2016-06-08T17:24:44+02:00","id":266021,"translations":{"de":{"name":"Die Gartenst\u00e4dte \u201eLe Logis et Flor\u00e9al\"","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":"info@lelogisfloreal.be","website":"https:\/\/www.lelogisfloreal.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1170","address_city":"Watermael-Boitsfort","address_line1":"Die Gartenst\u00e4dte \u201eLe Logis et Flor\u00e9al\"","address_line2":"1170 Watermael-Boitsfort","description_web":"Die Gartenst\u00e4dte (ein britisches Konzept aus dem fr\u00fchen 20. Jahrhundert) wurden angelegt, um den Arbeitern ein angenehmeres und naturnahes Wohnumfeld zu bieten. Die beiden Gartenst\u00e4dte Le Logis und Flor\u00e9al zeigen sich im Fr\u00fchling in ihrem sch\u00f6nsten Gewand, dann wenn die japanischen Kirschb\u00e4ume am Stra\u00dfenrand in voller Bl\u00fcte stehen. Dahinter erblickt man kleine H\u00e4uschen mit schmucken Vorg\u00e4rten \u2013 eine echte Bilderbuch-Kulisse, die schon zahlreiche Filmemacher inspiriert haben.","description_print":"Die Gartenst\u00e4dte (ein britisches Konzept aus dem fr\u00fchen 20. Jahrhundert) wurden angelegt, um den Arbeitern ein angenehmeres und naturnahes Wohnumfeld zu bieten. Die beiden Gartenst\u00e4dte Le Logis und Flor\u00e9al zeigen sich im Fr\u00fchling in ihrem sch\u00f6nsten Gewand, dann wenn die japanischen Kirschb\u00e4ume am Stra\u00dfenrand in voller Bl\u00fcte stehen. Dahinter erblickt man kleine H\u00e4uschen mit schmucken Vorg\u00e4rten \u2013 eine echte Bilderbuch-Kulisse, die schon zahlreiche Filmemacher inspiriert haben.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Les cit\u00e9s-jardins Le Logis et Flor\u00e9al","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":"info@lelogisfloreal.be","website":"https:\/\/www.lelogisfloreal.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1170","address_city":"Watermael-Boitsfort","address_line1":"Les cit\u00e9s-jardins Le Logis et Flor\u00e9al","address_line2":"1170 Watermael-Boitsfort","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Le Logis and Flor\u00e9al Garden Cities","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":"info@lelogisfloreal.be","website":"https:\/\/www.lelogisfloreal.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1170","address_city":"Watermael-Boitsfort","address_line1":"Le Logis and Flor\u00e9al Garden Cities","address_line2":"1170 Watermael-Boitsfort","description_web":"The garden cities of Le Logis and Flor\u00e9al are without a doubt the crowning jewels of Belgium\u2019s garden cities. The two cities, whose construction began in 1922, were designed as one large estate but on behalf of two separate cooperatives. Le Logis housed the employees of the Caisse G\u00e9n\u00e9rale d\u2019Epargne et de Retraite (GGER - General Pensions and Savings Fund) and civil servants. Flor\u00e9al was built a year later at the initiative of typesetter workers. Listed since 1999, this village in the city comprises 1,500 properties with a host of public facilities and shops, over 80 hectares! \r\n\r\nThe houses are characterised by a rough, grey rendering. The whole garden city is admired for its flourishing vegetation, including its hundreds of Japanese cherry trees, orchards, wisteria, jasmines, etc. Spring is the perfect season to stroll around it, and why not have a picnic?","description_print":"Garden cities (a British concept from the early 20th century) were intended for housing the working classes with the aim of giving them a fulfilling environment in which to live and stay in touch with nature. These two cities are made up of small one-family houses on streets and with gardens planted with flowers and trees. The best time to go there is when the Japanese cherry trees are in blossom.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Les cit\u00e9s jardins Le Logis et Flor\u00e9al","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":"info@lelogisfloreal.be","website":"https:\/\/www.lelogisfloreal.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1170","address_city":"Watermael-Boitsfort","address_line1":"Les cit\u00e9s jardins Le Logis et Flor\u00e9al","address_line2":"1170 Watermael-Boitsfort","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Les cit\u00e9s-jardins Le Logis et Flor\u00e9al","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":"info@lelogisfloreal.be","website":"https:\/\/www.lelogisfloreal.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1170","address_city":"Watermael-Boitsfort","address_line1":"Les cit\u00e9s-jardins Le Logis et Flor\u00e9al","address_line2":"1170 Watermael-Boitsfort","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Les cit\u00e9s-jardins Le Logis et Flor\u00e9al","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":"info@lelogisfloreal.be","website":"https:\/\/www.lelogisfloreal.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1170","address_city":"Watermael-Boitsfort","address_line1":"Les cit\u00e9s-jardins Le Logis et Flor\u00e9al","address_line2":"1170 Watermael-Boitsfort","description_web":"Les cit\u00e9s-jardins le Logis et Flor\u00e9al constituent sans aucun doute le fleuron des cit\u00e9s-jardins belges. Les deux cit\u00e9s, dont la construction est entam\u00e9e en 1922, sont con\u00e7ues comme un seul grand ensemble mais pour le compte de deux coop\u00e9ratives distinctes. Le Logis regroupe des employ\u00e9s de la Caisse g\u00e9n\u00e9rale d'Epargne et de Retraite (CGER) et des fonctionnaires. Le Flor\u00e9al na\u00eet un an plus tard \u00e0 l'initiative d'ouvriers typographes. Class\u00e9 depuis 1999, ce village dans la ville est compos\u00e9 de quelque 1.500 habitations int\u00e9grant une s\u00e9rie d'\u00e9quipements publics et de magasins, sur 80 hectares\u202f! \r\n\r\nLes maisons sont caract\u00e9ris\u00e9es par cet enduit rugueux, de couleur grise. L\u2019ensemble est appr\u00e9ci\u00e9 pour sa v\u00e9g\u00e9tation abondante, entre autres ses centaines de cerisiers du Japon, ses vergers, glycines, jasmins, etc. Le printemps est \u00e9videmment la parfaite saison pour aller s\u2019y balader, et pourquoi pas y pique-niquer\u202f! ","description_print":"Les cit\u00e9s jardins (concept britannique du d\u00e9but du 20\u00e8me si\u00e8cle) \u00e9taient destin\u00e9es au logement de la classe ouvri\u00e8re et tenaient \u00e0 offrir un cadre de vie \u00e9panouissant et un contact avec la nature. Ces deux cit\u00e9s se composent de petites maisons unifamiliales dont les rues et les jardins sont fleuris et arbor\u00e9s. La floraison des cerisiers du Japon est un moment id\u00e9al pour les visiter.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Las ciudades jard\u00edn Le Logis y Flor\u00e9al","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":"info@lelogisfloreal.be","website":"https:\/\/www.lelogisfloreal.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1170","address_city":"Watermael-Boitsfort","address_line1":"Las ciudades jard\u00edn Le Logis y Flor\u00e9al","address_line2":"1170 Watermael-Boitsfort","description_web":"Las ciudades jard\u00edn(un concepto de la primera mitad del s.XX) estaban destinadas para casas de la clase obrera con el prop\u00f3sito de darles un ambiente satisfactorio en el que vivir y establecerse en contacto con la naturaleza. Estas dos ciudades constan de peque\u00f1as casas familiares con jardines con flores y \u00e1rboles en las calles. El mejor momento para ir all\u00ed es cuando los cerezos japoneses est\u00e1n floreciendo.","description_print":"Las ciudades jard\u00edn(un concepto de la primera mitad del s.XX) estaban destinadas para casas de la clase obrera con el prop\u00f3sito de darles un ambiente satisfactorio en el que vivir y establecerse en contacto con la naturaleza. Estas dos ciudades constan de peque\u00f1as casas familiares con jardines con flores y \u00e1rboles en las calles. El mejor momento para ir all\u00ed es cuando los cerezos japoneses est\u00e1n floreciendo.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"De tuinwijken Le Logis en Flor\u00e9al","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":"info@lelogisfloreal.be","website":"https:\/\/www.lelogisfloreal.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1170","address_city":"Watermaal-Bosvoorde","address_line1":"De tuinwijken Le Logis en Flor\u00e9al","address_line2":"1170 Watermaal-Bosvoorde","description_web":"De tuinwijken Le Logis en Flor\u00e9al zijn ongetwijfeld de parel onder de Belgische tuinwijken. De bouw van de twee woonwijken begon in 1922. Ze werden ontworpen als \u00e9\u00e9n groot complex, maar in opdracht van twee afzonderlijke co\u00f6peraties. Le Logis verenigde werknemers van de Algemene Spaar- en Lijfrentekas (ASLK) maar ook ambtenaren. Flor\u00e9al kwam er een jaar later op initiatief van arbeiders uit de sector van de boekdrukkunst. Dit dorp in de stad is sinds 1999 geklasseerd en beslaat ongeveer 1.500 woningen, een aantal openbare voorzieningen en winkels. En dat op een oppervlakte van 80 hectare!\r\nDe huizen herken je aan het typische ruwe, grijze pleisterwerk. Het complex wordt gewaardeerd om zijn weelderige natuur, met onder meer honderden Japanse kerselaars, boomgaarden, blauweregens en jasmijnen. Uiteraard is de lente het ideale moment voor een wandeling\u2026 en een picknick, waarom niet?","description_print":"Tuinwijken (een Brits concept uit het begin van de 20ste eeuw) waren wijken met arbeiderswoningen die de arbeiders een aangename woonomgeving in contact met de natuur moesten bieden. Deze twee tuinwijken bestaan uit  kleine eensgezinswoningen met fleurig tuinen; de periode waarin de Japanse kerselaars bloeien is het ideale moment om ze te bezoeken.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[21],"translations":{"de":["S\u00fcden"],"pt":[null],"en":["South"],"it":["Sud"],"cn":[null],"fr":["Sud"],"sp":["Sur"],"nl":["Zuid"]}},"neca":null,"facebook_id":null,"backoffice_id":26021,"location":{"lat":50.80690949,"lon":4.42199262},"region":"brussels","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"last_updated_at":"2022-03-31T04:20:02+02:00","published_at":"2022-03-30T09:40:35+02:00","id":278084,"translations":{"de":{"name":"Espace M\u00e9moire de Watermael-Boitsfort","address_street_name":"Dr\u00e8ve du Duc","address_street_number":"2","address_street_box":null,"email":"tilia@wb1170.brussels","website":"https:\/\/www.watermael-boitsfort.be\/fr\/vivre-a-watermael-boitsfort\/culture\/associations","phone_contact":null,"phone_booking":null,"address_zip":"1170","address_city":"Watermael-Boitsfort","address_line1":"Dr\u00e8ve du Duc, 2","address_line2":"1170 Watermael-Boitsfort","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Espace M\u00e9moire de Watermael-Boitsfort","address_street_name":"Dr\u00e8ve du Duc","address_street_number":"2","address_street_box":null,"email":"tilia@wb1170.brussels","website":"https:\/\/www.watermael-boitsfort.be\/fr\/vivre-a-watermael-boitsfort\/culture\/associations","phone_contact":null,"phone_booking":null,"address_zip":"1170","address_city":"Watermael-Boitsfort","address_line1":"Dr\u00e8ve du Duc, 2","address_line2":"1170 Watermael-Boitsfort","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Espace M\u00e9moire de Watermael-Boitsfort","address_street_name":"Dr\u00e8ve du Duc","address_street_number":"2","address_street_box":null,"email":"tilia@wb1170.brussels","website":"https:\/\/www.watermael-boitsfort.be\/fr\/vivre-a-watermael-boitsfort\/culture\/associations","phone_contact":null,"phone_booking":null,"address_zip":"1170","address_city":"Watermael-Boitsfort","address_line1":"Dr\u0