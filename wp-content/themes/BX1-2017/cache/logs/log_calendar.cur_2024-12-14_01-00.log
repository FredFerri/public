t":"2024-12-13T01:01:50+01:00","published_at":"2024-12-11T10:05:22+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":314169,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"other","ranking":0.3889111187328203,"languages":{"spoken":["en","nl","fr"],"subtitles":[]},"categories":{"main":{"id":90,"translations":{"de":"Animationen","pt":null,"en":"Animations","it":"Animazioni","cn":null,"fr":"Animations","sp":"Animaciones","nl":"Animaties"}},"others":{"list":[99],"translations":{"de":["Gastronomie"],"pt":[null],"en":["Gastronomy"],"it":["Cucina"],"cn":[null],"fr":["Gastronomie"],"sp":["Gastronom\u00eda"],"nl":["Gastronomie"]}}},"translations":{"de":{"name":"Altitude 25","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/altitude25.be\/","email":"book@thehotel.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700004511"},"pt":{"name":"Altitude 25","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/altitude25.be\/","email":"book@thehotel.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700004511"},"en":{"name":"Altitude 25","shortdescr":"Visit Altitude 25, a pop-up bar on the 25th floor of The Hotel Brussels. Enjoy amazing views of the city, a cozy winter atmosphere, delicious drinks, and tasty bites. A perfect spot to relax and see Brussels from above!","longdescr":"Altitude 25 \u2013 a pop-up bar on the 25th floor of The Hotel Brussels \u2013 offers an elevated experience that blends stunning city views with a cozy, winter-inspired ambiance. Designed as an escape above the bustling city, Altitude 25 invites guests to unwind in a stylish setting, sip champagne, and enjoy a selection of refined bites. This unique, high-rise venue brings a touch of seasonal warmth and elegance to the heart of Brussels, making it the ideal destination for those looking to experience the city from a new perspective.","performers":null,"boxoffice_url":null,"website":"https:\/\/altitude25.be\/","email":"book@thehotel.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700004511"},"it":{"name":"Altitude 25","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/altitude25.be\/","email":"book@thehotel.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700004511"},"cn":{"name":"Altitude 25","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/altitude25.be\/","email":"book@thehotel.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700004511"},"fr":{"name":"Altitude 25","shortdescr":"Visitez Altitude 25, un bar \u00e9ph\u00e9m\u00e8re au 25e \u00e9tage de The Hotel Brussels. Profitez d'une vue incroyable sur la ville, d'une ambiance hivernale chaleureuse, de d\u00e9licieux cocktails et de savoureuses bouch\u00e9es. Un endroit parfait pour se d\u00e9tendre et admirer Bruxelles d'en haut !","longdescr":"Altitude 25 \u2013 un bar \u00e9ph\u00e9m\u00e8re situ\u00e9 au 25e \u00e9tage de The Hotel Brussels \u2013 offre une exp\u00e9rience en altitude qui allie des vues imprenables sur la ville \u00e0 une ambiance chaleureuse et inspir\u00e9e de l\u2019hiver. Con\u00e7u comme un refuge au-dessus de l\u2019agitation urbaine, Altitude 25 invite ses visiteurs \u00e0 se d\u00e9tendre dans un cadre \u00e9l\u00e9gant, \u00e0 savourer du champagne et \u00e0 d\u00e9guster une s\u00e9lection de mets raffin\u00e9s. Ce lieu unique en hauteur apporte une touche de chaleur et d\u2019\u00e9l\u00e9gance saisonni\u00e8res au c\u0153ur de Bruxelles, en faisant une destination id\u00e9ale pour ceux qui souhaitent d\u00e9couvrir la ville sous un nouvel angle.","performers":null,"boxoffice_url":null,"website":"https:\/\/altitude25.be\/","email":"book@thehotel.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700004511"},"sp":{"name":"Altitude 25","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/altitude25.be\/","email":"book@thehotel.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700004511"},"nl":{"name":"Altitude 25","shortdescr":"Bezoek Altitude 25, een pop-upbar op de 25e verdieping van The Hotel Brussels. Geniet van een prachtig uitzicht over de stad, een gezellige winterse sfeer, heerlijke drankjes en smakelijke hapjes. De perfecte plek om te ontspannen en Brussel van bovenaf te bekijken!","longdescr":"Altitude 25 \u2013 een pop-up bar op de 25e verdieping van The Hotel Brussels \u2013 biedt een verheven ervaring die adembenemende stadsgezichten combineert met een knusse, winterse sfeer. Ontworpen als een toevluchtsoord boven de bruisende stad, nodigt Altitude 25 gasten uit om te ontspannen in een stijlvolle setting, champagne te nippen en te genieten van een selectie verfijnde hapjes. Deze unieke locatie op grote hoogte brengt een vleugje seizoensgebonden warmte en elegantie naar het hart van Brussel, waardoor het de ideale bestemming is voor wie de stad vanuit een nieuw perspectief wil ervaren.","performers":null,"boxoffice_url":null,"website":"https:\/\/altitude25.be\/","email":"book@thehotel.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700004511"}},"place":{"id":50000410,"translations":{"de":{"name":"The Hotel Brussels","address_street_name":"Boulevard de Waterloo","address_street_number":"38","address_street_box":null,