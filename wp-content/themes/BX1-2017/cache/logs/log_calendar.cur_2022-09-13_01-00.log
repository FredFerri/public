97 18","phone_booking":null,"address_zip":"1081","address_city":"Koekelberg","address_line1":"Dapperenstraat, 2","address_line2":"1081 Koekelberg","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Etage Tropical","address_street_name":"Dapperenstraat","address_street_number":"2","address_street_box":null,"email":"info@etagetropical.be","website":"http:\/\/www.etagetropical.be","phone_contact":"+32 473 80 97 18","phone_booking":null,"address_zip":"1081","address_city":"Koekelberg","address_line1":"Dapperenstraat, 2","address_line2":"1081 Koekelberg","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":null,"facebook_id":null,"backoffice_id":36710,"location":{"lat":50.82478486,"lon":4.27373361},"region":"brussels","last_updated_at":"2022-08-10T18:35:16+02:00","published_at":"2021-06-16T14:42:06+02:00","import_origin":null,"external_id":null,"is_in_address_book":false,"is_in_vb_export":false,"resto_ranking":0},"media":[{"type":"poster","link":"https:\/\/agendabrussels.imgix.net\/bd2cb6002a65cd136c15b1b439bbbeeb355396d3.jpg","width":1241,"height":1749,"ratio":0.71,"translations":{"fr":{"title":"Salsa, Bachata, Ladystyling!","copyright":null},"nl":{"title":"Salsa, Bachata, Ladystyling!","copyright":null},"en":{"title":"Salsa, Bachata, Ladystyling!","copyright":null}}}],"dates":[{"day":"2022-09-13","doors":null,"start":"19:00:00","end":"22:00:00"},{"day":"2022-10-03","doors":null,"start":"19:00:00","end":"22:00:00"},{"day":"2022-10-11","doors":null,"start":"19:00:00","end":"22:00:00"}],"recurring":[{"day":"monday","occurences":{"is_first":true,"is_second":false,"is_third":false,"is_fourth":false,"is_last":false},"time_start":"19:00:00","time_end":"22:00:00","translations":{"fr":"Ouvert le premier lundi du mois de 19:00 \u00e0 22:00","nl":"Open op de eerste maandag van de maand van 19:00 tot 22:00","en":"Open the first monday of the month from 19:00 to 22:00"}},{"day":"tuesday","occurences":{"is_first":false,"is_second":true,"is_third":false,"is_fourth":false,"is_last":false},"time_start":"19:00:00","time_end":"22:00:00","translations":{"fr":"Ouvert le deuxi\u00e8me mardi du mois de 19:00 \u00e0 22:00","nl":"Open op de tweede dinsdag van de maand van 19:00 tot 22:00","en":"Open the second tuesday of the month from 19:00 to 22:00"}}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":80}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-08-10T18:35:17+02:00","published_at":"2022-07-13T09:06:59+02:00","backoffice_id":258312,"import_origin":null,"sub_type":"sport","show_in_agenda":true,"ranking":0.28114422176725},{"id":536325,"date_start":"2022-06-18","date_end":"2022-09-25","date_next":"2022-09-13","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[36,37],"translations":{"fr":["Mus\u00e9es et art centers","Arts audiovisuels"],"nl":["Musea en kunstcentra","Audiovisuele kunst"],"en":["Museums and art centers","Audiovisual art"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Presse, libert\u00e9 fragile ?","shortdescr":"Ces derni\u00e8res ann\u00e9es, la presse libre et ind\u00e9pendante - \u00e9l\u00e9ment essentiel de toute d\u00e9mocratie - est mise sous pression dans un nombre croissant de pays. \r\nDans ce contexte, G\u00e9opolis a d\u00e9cid\u00e9 de d\u00e9dier son nouveau cycle d\u2019expositions \u00e0 la libert\u00e9 de la presse \u00e0 travers le monde, avec le travail de plusieurs photographes.","longdescr":"Ces derni\u00e8res ann\u00e9es, la presse libre et ind\u00e9pendante - \u00e9l\u00e9ment essentiel de toute d\u00e9mocratie - est mise sous pression dans un nombre croissant de pays.\r\nPlus de 85 % de la population mondiale a constat\u00e9 une diminution de la libert\u00e9 de la presse dans son pays au cours des cinq derni\u00e8res ann\u00e9es. Et la tendance se poursuit dans le monde entier. M\u00eame au sein de l'UE de nouvelles r\u00e9glementations visent \u00e0 restreindre la libert\u00e9 d'expression, et des journalistes sont de plus en plus menac\u00e9s, parfois m\u00eame assassin\u00e9s. La guerre en Ukraine a encore aggrav\u00e9 cette situation d\u00e9j\u00e0 difficile.\r\n\r\nDans ce contexte, G\u00e9opolis a d\u00e9cid\u00e9 de d\u00e9dier son nouveau cycle d\u2019expositions \u00e0 la libert\u00e9 de la presse \u00e0 travers le monde. \r\n\r\nLes diff\u00e9rentes expositions :\r\n\u2022En-GAJE \u2013 Une exposition avec des t\u00e9moignages des journalistes en exil \u00e0 Bruxelles, avec des photos de Fr\u00e9deric Moreau de Bellaing. \r\n\u2022Lam Yik Fei \u2013 Manifestations \u00e0 Hong Kong (Hong Kong protests)\r\n\u2022Nicole Kramm - Balles contre pierres (Balas contra piedras)\r\n\u2022Asger Ladefoged \u2013 Le soul\u00e8vement au Belarus (Uprising in Belarus)\r\n\r\nCe cycle d\u2019expositions pr\u00e9sente \u00e9galement des textes et le classement mondial de la libert\u00e9 de la presse issus des travaux de Reporters sans fronti\u00e8res (RSF).\r\n\r\nUne petite s\u00e9lection de l'exposition est \u00e9galement visible sur les vitres de notre caf\u00e9-radio L'Ascenseur (Place de L\u2019Ep\u00e9e 1). \r\n\r\n\u00c9v\u00e9nements : \r\n\u2022Jeudi 16 juin \u00e0 18h30 \u00e0 L\u2019Ascenseur (Place de L\u2019Ep\u00e9e 1): Plateau radio en pr\u00e9sence de Josine Kaz\u00e9 et Val\u00e9ry Muco (Burundi) journalistes exil\u00e9s \u00e0 Bruxelles. (En collaboration avec En-GAJE). \r\n\u2022Samedi 18 juin de 15h30 \u00e0 18h \u00e0 G\u00e9opolis (Rue des Tanneurs 58a) : Vernissage et visite de l\u2019exposition. En pr\u00e9sence de journalistes en exil \u00e0 Bruxelles. \r\n\u2022Jeudi 23 juin \u00e0 18h30 \u00e0 L\u2019Ascenseur (Place de L\u2019Ep\u00e9e 1).  The Presse, a Fragile Freedom? Public radio show with Lailuma Sadid (Afghanistan) and Omeyma Masoud (Palestine) (EN). (En collaboration avec En-GAJE)","performers":null,"boxoffice_url":null,"website":"http:\/\/geopolis.brussels","email":"contact@geopolis.brussels","phone_contact":"+32 485 63 13 89","phone_booking":"+32 485 63 13 89","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.536325"},"nl":{"name":"De pers, fragiele vrijheid?","shortdescr":"De afgelopen jaren is de vrije en onafhankelijke pers, essentieel element van elke democratie, in steeds meer landen onder druk komen te staan. \r\nIn deze context heeft G\u00e9opolis besloten een tentoonstelling te presenteren over persvrijheid wereldwijd, met het werk van verschillende fotografen.","longdescr":"De afgelopen jaren is de vrije en onafhankelijke pers, essentieel element van elke democratie, in steeds meer landen onder druk komen te staan.\r\nMeer dan 85% van de wereldbevolking heeft in de afgelopen vijf jaar de persvrijheid in hun land zien afnemen, en de neerwaartse trend zet zich voort. Ook binnen de EU worden nieuwe wetten en beleidsmaatregelen ge\u00efntroduceerd om de (online) vrijheid van meningsuiting in te perken. Journalisten worden steeds meer bedreigd, soms zelf vermoord. De oorlog in Oekra\u00efne heeft deze situatie alleen maar verergerd. \r\n\r\nIn deze context besloot G\u00e9opolis deze tentoonstelling te presenteren over de staat van persvrijheid wereldwijd. \r\n\r\nEen tentoonstelling met het werk van:\r\n\u2022        En-GAJE - Een tentoonstelling met getuigenissen van journalisten in ballingschap in Brussel. Met foto\u2019s van Fr\u00e9d\u00e9ric Moreau de Bellaing\r\n\u2022        Lam Yik Fei \u2013 Protesten in Hong Kong (Hong Kong protests)\r\n\u2022        Nicole Kramm \u2013 Kogels tegen stenen (Balas contra piedras)\r\n\u2022        Asger Ladefoged \u2013 De opstand in Wit-Rusland (Uprising in Belarus)\r\n\r\nDe tentoonstelling presenteert eveneens teksten en de World Press Freedom Index van Verslaggevers Zonder Grenzen (Reporters Sans Fronti\u00e8res, RSF). \r\n\r\nEen kleine selectie van de tentoonstelling is eveneens te zien op de ramen van ons radio-caf\u00e9 L\u2019Ascenseur (Place de L\u2019Ep\u00e9e 1). \r\n\r\nEvenementen: \r\n\u2022Donderdag 16 juin om 18u30 bij L\u2019Ascenseur (Zwaardplein 1) : Plateau radio en pr\u00e9sence de Josine Kaz\u00e9 et Val\u00e9ry Muco (Burundi) journalistes exil\u00e9s \u00e0 Bruxelles (FR). (In samenwerking met En-GAJE). \r\n\u2022Zaterdag 18 juni van 15u30 tot 18u bij G\u00e9opolis (Huidevettersstraat 58a) : Opening en bezoek van de tentoonstelling, in aanwezigheid van journalisten in ballingschap in Brussel. \r\n\u2022Donderdag 23 juni om 18u30 bij L\u2019Ascenseur (Zwaardplein 1).  The Presse, a Fragile Freedom? Public radio show with Lailuma Sadid (Afghanistan) and Omeyma Masoud (Palestine) (EN). (In samenwerking met En-GAJE)","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.536325"},"en":{"name":"Press, a Fragile Freedom?","shortdescr":"In recent years, the free and independent press - an essential element of any democracy - has come under pressure in an increasing number of countries. In this context, G\u00e9opolis has decided to present an exhibition about press freedom worldwide, including various exhibitions.","longdescr":"In recent years, the free and independent press - an essential element of any democracy - has come under pressure in an increasing number of countries.\r\nMore than 85% of the world's population has seen a decline in press freedom in their country over the past five years. And the negative trend continues worldwide, with new regulations aiming to restrict freedom of expression, and journalists increasingly being threatened, sometimes even murdered, even within the EU. The war in Ukraine has further worsened this already difficult situation.\r\n\r\nIn this context, G\u00e9opolis has decided to present an exhibition about press freedom worldwide, including various exhibitions: \r\n\r\n\u2022En-GAJE - An exhibition with testimonies of journalists in exile in Brussels, with photos by Fr\u00e9deric Moreau de Bellaing. \r\n\u2022Lam Yik Fei - Hong Kong protests\r\n\u2022Nicole Kramm - Bullets against stones (Balas contra piedras)\r\n\u2022Asger Ladefoged \u2013 Belarus uprisings \r\n\r\nThis series of exhibitions also presents texts and the World Press Freedom Index of Reporters Without Borders (RSF).\r\n\r\nA small selection of the exhibition is also visible at our radio-caf\u00e9 L'Ascenseur (Place de L\u2019Ep\u00e9e 1). \r\n\r\nEvents: \r\n\u2022Saturday 18 June 15:30-18h at G\u00e9opolis (Rue des Tanneurs 58a) : Opening and visits of the exhibitions, in presence of journalists in exile in Brussels. \r\n\u2022Thursday 23 June at 18:30 at L\u2019Ascenseur (Place de L\u2019Ep\u00e9e 1).  The Presse, a Fragile Freedom? Public radio show with Lailuma Sadid (Afghanistan) and Omeyma Masoud (Palestine) (EN). (In samenwerking met En-GAJE)","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.536325"},"de":{"name":"Presse, libert\u00e9 fragile ?","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.536325"},"it":{"name":"Presse, libert\u00e9 fragile ?","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.536325"},"sp":{"name":"Presse, libert\u00e9 fragile ?","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.536325"},"pt":{"name":"Presse, libert\u00e9 fragile ?","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.536325"},"cn":{"name":"Presse, libert\u00e9 fragile ?","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.536325"}},"place":{"id":269816,"translations":{"fr":{"name":"G\u00e9opolis","address_street_name":"Rue des Tanneurs","address_street_number":"58-60","address_street_box":null,"email":"contact@geopolis.brussels","website":"http:\/\/geopolis.brussels","phone_contact":"+32 485 32 85 90","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Tanneurs, 58-60","address_line2":"1000 Bruxelles","description_web":"G\u00e9opolis est parrain\u00e9 par le photoreporter de guerre Laurent Van der Stockt, et port\u00e9 par trois militants associatifs, passionn\u00e9s de g\u00e9opolitique. Ce nouvel espace culturel d\u00e9di\u00e9 au photo-reportage d\u2019actualit\u00e9 et d\u2019histoire est install\u00e9 au c\u0153ur de Bruxelles (aux Ateliers des Tanneurs) et propose des cycles d\u2019expositions th\u00e9matiques et une programmation \u00e9v\u00e9nementielle tourn\u00e9e vers le grand public et notamment les jeunes.  \r\n","description_print":"","booking_url":null,"sort_orde