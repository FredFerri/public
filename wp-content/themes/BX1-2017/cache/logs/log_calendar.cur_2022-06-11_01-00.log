rt":"2021-05-11","date_end":"2023-12-31","is_also_by_appointment":false}],"prices":[{"translations":{"fr":{"name":"Cat\u00e9gorie 1"},"nl":{"name":"Categorie 1"},"en":{"name":"Category 1"}},"value":39},{"translations":{"fr":{"name":"Cat\u00e9gorie 2"},"nl":{"name":"Categorie 2"},"en":{"name":"Category 2"}},"value":59},{"translations":{"fr":{"name":"Cat\u00e9gorie 3"},"nl":{"name":"Categorie 3"},"en":{"name":"Category 3"}},"value":69}],"child_events":[],"parent_events":[],"targets":{"list":[11],"translations":{"fr":["Famille"],"nl":["Familie"],"en":["Family"]}},"visit_profile":{"list":[320],"translations":{"fr":["Classique"],"nl":["Klassiek"],"en":["Classic"]}},"tags":["exterior","kids"],"accessibilities":{"list":[263],"translations":{"fr":["Accessible aux pi\u00e9tons appareill\u00e9s"],"nl":["Toegankelijk voor voetgangers met hulpmiddelen"],"en":["Accessible to pedestrians with mobility aids"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-06-10T01:06:04+02:00","published_at":"2021-05-11T15:08:10+02:00","backoffice_id":231439,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.1011946522289},{"id":526008,"date_start":"2022-01-26","date_end":"2023-01-26","date_next":"2022-06-10","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[36,40],"translations":{"fr":["Mus\u00e9es et art centers","Arts graphiques"],"nl":["Musea en kunstcentra","Grafische kunst, vormgeving"],"en":["Museums and art centers","Graphic art"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"The World of Banksy - Brussels","shortdescr":"THE WORLD OF BANKSY - BRUSSELS\r\nExposition Banksy avec reconstitutions grandeur nature des \u0153uvres de l'artiste de Bristol. Un parcours g\u00e9ographique \u00e0 travers les villes du monde entier o\u00f9 Banksy a peint ses \u0153uvres les plus embl\u00e9matiques. Une invitation \u00e0 d\u00e9couvrir sous un nouvel angle le street-artiste le plus myst\u00e9rieux du moment. Accessible et conseill\u00e9e \u00e0 toutes et tous !","longdescr":"The World of Banksy \u2013 Bruxelles est une exposition qui rassemble le plus grand nombre d\u2019\u0153uvres murales grandeur nature du street artiste de Bristol. Ces \u0153uvres reconstitu\u00e9es ainsi que d\u2019autres pi\u00e8ces relatant la riche carri\u00e8re de Banksy ont \u00e9t\u00e9 install\u00e9es dans les locaux mythiques d\u2019une ancienne maison de tissus au 28 rue de Laeken.\r\n\r\nL\u2019exposition a pour vocation de pr\u00e9senter Banksy et son approche originale \u00e0 travers les \u0153uvres murales qu\u2019il a peintes dans les rues du monde entier. Les visiteurs d\u00e9couvriront le ma\u00eetre du street art dans une exp\u00e9rience compl\u00e8te et immersive qui donne un nouveau souffle aux \u0153uvres - presque toutes disparues - de Banksy.\r\n\r\nL'exposition est ouverte tous les jours de la semaine de 10h \u00e0 19h (derni\u00e8re entr\u00e9e \u00e0 18h15). Renseignements : info@theworldofbanksy.be - 02\/649.49.83","performers":"Banksy","boxoffice_url":null,"website":"https:\/\/theworldofbanksy.be","email":"info@theworldofbanksy.be","phone_contact":null,"phone_booking":"+32 2 649 49 83","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/526008.html"},"nl":{"name":"The World of Banksy - Brussels","shortdescr":"THE WORLD OF BANKSY - BRUSSELS\r\nTentoonstelling met levensgrote reconstructies van de werken van de streetartist uit Bristol. Een geografische reis door de steden over de hele wereld waar Banksy zijn meest emblematische werken heeft geschilderd. Een uitnodiging om de meest mysterieuze straatartiest van het moment vanuit een nieuwe invalshoek te ontdekken. Toegankelijk en aanbevolen voor iedereen!","longdescr":"The World of Banksy - Brussels is een tentoonstelling die het grootste aantal levensgrote muurschilderingen van de street-artist uit Bristol samenbrengt. Deze gereconstrueerde werken en andere stukken uit Banksy's rijke carri\u00e8re zijn ge\u00efnstalleerd in het mythische pand van een voormalig stoffenhuis in de Lakenstraat 28 (1000 Brussel).\r\n\r\nDe tentoonstelling wil Banksy en zijn originele aanpak voorstellen aan de hand van de muurschilderingen die hij in de straten van de wereld heeft aangebracht. Bezoekers ontdekken de meester van de street art in een complete en meeslepende ervaring die nieuw leven blaast in Banksy's - bijna volledig verloren gegane - werken.\r\n\r\nDe tentoonstelling is alle dagen van de week toegankelijk van 10 tot 19 uur (laatste toegang om 18.15 uur). Voor meer informatie kunt u contact opnemen met: info@theworldofbanksy.be - 02\/649.49.83","performers":"Banksy","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/526008.html"},"en":{"name":"The World of Banksy - Brussels","shortdescr":"THE WORLD OF BANKSY - BRUSSELS\r\nBanksy exhibition with life-size reconstructions by the Bristol-based artist. A geographical journey through the cities around the world where Banksy has painted his most emblematic murals. An invitation to discover the most mysterious street artist of the moment from a new angle. Easy access and recommended for everyone!","longdescr":"The World of Banksy - Brussels is an exhibition that brings together the largest number of life-size murals by the Bristol-based street artist. These reconstructed works and other pieces of Banksy's rich career have been installed in the mythical premises of a former fabric house at 28 rue de Laeken (1000 BRUSSELS).\r\n\r\nThe exhibition aims to present Banksy and his original approach through the murals he has painted in the streets of the world. Visitors will discover the master of street art in a complete and immersive experience that breathes new life into Banksy's - almost entirely lost - creations.\r\n\r\nThe exhibition is open every day of the week from 10am to 7pm (last entry at 6.15pm). For more information, please contact: info@theworldofbanksy.be - 02\/649.49.83","performers":"Banksy","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/526008.html"},"de":{"name":"The World of Banksy - Brussels","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/526008.html"},"it":{"name":"The World of Banksy - Brussels","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/526008.html"},"sp":{"name":"The World of Banksy - Brussels","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/526008.html"},"pt":{"name":"The World of Banksy - Brussels","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/526008.html"},"cn":{"name":"The World of Banksy - Brussels","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/526008.html"}},"place":{"id":277623,"translations":{"fr":{"name":"THE WORLD OF BANKSY","address_street_name":"Rue de Laeken","address_street_nu