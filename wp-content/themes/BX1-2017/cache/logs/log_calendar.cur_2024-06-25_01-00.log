en op de stad en de wijk.  Als een van de belangrijkste plekken in de Brusselse underground-geschiedenis combineert het een KUNSTENCENTRUM met twee sociale integratieprojecten, BAR RECYCLART en RECYCLART FABRIK (werkplaats voor hout-, metaal- en infrastructuurwerk).\r\n\r\nMet het kunstencentrum verbindt Recyclart kunst met de stedelijke context waar het deel van uitmaakt. De stad dient als inspiratiebron voor de artistieke activiteiten, maar ook omgekeerd zet Recyclart haar artistieke programma in als katalysator, om zo diezelfde stedelijke context toegankelijker en leefbaarder te maken.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":"RECYCLARTBXL","region":"brussels","backoffice_id":973,"location":{"lat":50.84757339,"lon":4.32864108},"last_updated_at":"2023-09-19T16:52:47+02:00","published_at":"2013-10-19T01:13:57+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"poster","link":"https:\/\/agendabrussels2.imgix.net\/1315d6951f5a5fbb7252ecf685e31c83ba54eaf6.jpg","width":2000,"height":2864,"ratio":0.7,"oEmbed_height":2864,"oEmbed_width":2000,"translations":{"de":{"title":"Recyclart Holidays 2024","copyright":null},"pt":{"title":"Recyclart Holidays 2024","copyright":null},"en":{"title":"Recyclart Holidays 2024","copyright":null},"it":{"title":"Recyclart Holidays 2024","copyright":null},"cn":{"title":"Recyclart Holidays 2024","copyright":null},"fr":{"title":"Recyclart Holidays 2024","copyright":null},"sp":{"title":"Recyclart Holidays 2024","copyright":null},"nl":{"title":"Recyclart Holidays 2024","copyright":null}}}],"dates":[{"day":"2024-06-26","doors":null,"start":"12:00:00","end":"22:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-06-27","doors":null,"start":"12:00:00","end":"23:59:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-06-28",