0:00:00","end":"17:00:00"},{"day":"2023-11-28","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2023-11-29","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2023-11-30","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2023-12-01","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2023-12-02","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2023-12-04","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2023-12-05","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2023-12-06","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2023-12-07","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2023-12-08","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2023-12-09","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2023-12-11","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2023-12-12","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2023-12-13","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2023-12-14","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2023-12-15","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2023-12-16","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2023-12-18","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2023-12-19","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2023-12-20","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2023-12-21","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2023-12-22","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2023-12-23","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2023-12-25","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2023-12-26","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2023-12-27","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2023-12-28","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2023-12-29","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2023-12-30","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2024-01-01","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2024-01-02","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2024-01-03","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2024-01-04","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2024-01-05","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2024-01-06","doors":null,"start":"10:00:00","end":"17:00:00"}],"weekschema":[{"days":{"monday":{"is_open":true,"hours":[{"start":"10:00:00","end":"17:00:00"}]},"tuesday":{"is_open":true,"hours":[{"start":"10:00:00","end":"17:00:00"}]},"wednesday":{"is_open":true,"hours":[{"start":"10:00:00","end":"17:00:00"}]},"thursday":{"is_open":true,"hours":[{"start":"10:00:00","end":"17:00:00"}]},"friday":{"is_open":true,"hours":[{"start":"10:00:00","end":"17:00:00"}]},"saturday":{"is_open":true,"hours":[{"start":"10:00:00","end":"17:00:00"}]},"sunday":{"is_open":false}},"translations":{"fr":["lundi, mardi, mercredi, jeudi, vendredi et samedi: de 10:00 \u00e0 17:00","dimanche: ferm\u00e9"],"nl":["maandag, dinsdag, woensdag, donderdag, vrijdag en zaterdag: van 10:00 tot 17:00","zondag: gesloten"],"en":["monday, tuesday, wednesday, thursday, friday and saturday: from 10:00 to 17:00","sunday: closed"]},"date_start":"2021-04-22","date_end":"2024-01-06","is_also_by_appointment":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":35}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-25T01:06:01+02:00","published_at":"2021-04-22T12:53:46+02:00","backoffice_id":230880,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.2006711459696},{"id":532270,"date_start":"2022-05-10","date_end":"2023-01-22","date_next":"2022-10-25","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung"}},"others":{"list":[36,46],"translations":{"fr":["Mus\u00e9es et art centers","Pluridisciplinaire"],"nl":["Musea en kunstcentra","Multidisciplinair"],"en":["Museums and art centers","Multidisciplinary"],"de":["Museen & Kunstzentren","Multidisziplin\u00e4r"]}}},"languages":{"spoken":["nl","fr","en","de"],"subtitles":[]},"translations":{"fr":{"name":"Expo \"Royals & Trains\"","shortdescr":"Une chance unique de d\u00e9couvrir le lien particulier qui unit la famille royale belge au monde ferroviaire.","longdescr":"De la construction de la premi\u00e8re ligne ferroviaire en 1835 \u00e0 aujourd\u2019hui, la famille royale belge a toujours eu une relation privil\u00e9gi\u00e9e avec les trains, et a montr\u00e9 un soutien sans faille au d\u00e9veloppement des chemins de fer en Belgique et en Europe.\r\n\r\nCette exposition temporaire vous permettra de d\u00e9couvrir le riche pass\u00e9 ferroviaire de la famille royale belge au travers de documents et d\u2019objets d\u2019\u00e9poque provenant de nos archives et de celles du Palais Royal. Exceptionnellement, cinq voitures royales seront pr\u00e9sent\u00e9es pour la premi\u00e8re fois \u00e0 Train World.\r\n\r\nHeures d'ouverture: Ouvert du mardi au dimanche de 10h \u00e0 17h (derni\u00e8re entr\u00e9e \u00e0 15h30), ferm\u00e9 les lundis.\r\n\r\nEn savoir plus: https:\/\/www.trainworld.be\/fr\/expo-royals-trains","performers":null,"boxoffice_url":null,"website":"https:\/\/www.trainworld.be\/fr\/expo-royals-trains","email":"info@trainworld.be","phone_contact":"+32 2 224 74 37","phone_booking":"+32 2 224 75 88","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.532270"},"nl":{"name":"Expo \"Royals & Trains\"","shortdescr":"Een uitzonderlijke kans om meer te weten te komen over de speciale band tussen de Belgische koninklijke familie en de spoorwegen.","longdescr":"De Belgische koninklijke familie heeft altijd al een speciale band gehad met treinen. Vanaf de aanleg van de eerste spoorlijn in 1835 tot op vandaag heeft ze de ontwikkeling van de Belgische \u00e9n Europese spoorwegen steeds gesteund.\r\n\r\nJe ontdekt tijdens deze tijdelijke expo het rijke spoorwegverleden van de Belgische koninklijke familie aan de hand van niet eerder getoonde historische documenten en stukken uit onze archieven, en die van het Koninklijk Paleis. De tentoonstelling brengt uitzonderlijk vijf koninklijke rijtuigen samen in Train World, waarvan de meeste voor het eerst publiekelijk tentoongesteld zijn.\r\n\r\nOpeningsuren: Open van dinsdag t.e.m. zondag, van 10 tot 17 uur (laatste toegang om 15u30), gesloten op maandag\r\n\r\nMeer info: https:\/\/www.trainworld.be\/nl\/expo-royals-trains","performers":null,"boxoffice_url":null,"website":"https:\/\/www.trainworld.be\/nl\/expo-royals-trains","email":"info@trainworld.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.532270"},"en":{"name":"Expo \"Royals & Trains\"","shortdescr":"A unique opportunity to discover the special bond between the Belgian royal family and the railway world.","longdescr":"From the construction of the first rail line in 1835 to the present day, the Belgian royal family has always had a special relationship with trains and shown unwavering support for expanding the railway network in Belgium and in Europe. \r\n\r\nThis temporary exhibition lets you discover the rich railway heritage of the Belgian royal family through documents and period objects from our archives and those of the Royal Palace. Exceptionally, five royal coaches, most never shown in public, will be unveiled for the first time at Train World.\r\n\r\nOpening hours: Open from Tueday to Sunday, from 10am to 5pm (last entry at 3.30pm), closed on Mondays\r\n\r\nMore info: https:\/\/www.trainworld.be\/en\/exhibition-royals-trains","performers":null,"boxoffice_url":null,"website":"https:\/\/www.trainworld.be\/en\/exhibition-royals-trains","email":"info@trainworld.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.532270"},"de":{"name":"Expo \"Royals & Trains\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.532270"},"it":{"name":"Expo \"Royals & Trains\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.532270"},"sp":{"name":"Expo \"Royals & Trains\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.532270"},"pt":{"name":"Expo \"Royals & Trains\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.532270"},"cn":{"name":"Expo \"Royals & Trains\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.532270"}},"place":{"id":252663,"translations":{"fr":{"name":"Train World","address_street_name":"Place Princesse Elisabeth","address_street_number":null,"address_street_box":null,"email":"info@trainworld.be","website":"http:\/\/www.trainworld.be","phone_contact":"+32 2 224 74 98","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Place Princesse Elisabeth","address_line2":"1030 Schaerbeek","description_web":"Train World est une exp\u00e9rience ferroviaire unique qui vous emm\u00e8ne des toutes premi\u00e8res locomotives \u00e0 vapeur aux trains \u00e0 grande vitesse flamboyants ! C'est un univers qui fait appel \u00e0 tous les sens pour appr\u00e9hender les multiples dimensions du chemin de fer. Une visite \u00e0 Train World est une sortie active et surprenante. Vous pouvez vous promener parmi les locomotives, prendre place dans des trains centenaires, visiter une maison de chemin de fer et traverser un v\u00e9ritable pont ferroviaire. Vous ferez m\u00eame l'exp\u00e9rience de la conduite d'un train !","description_print":"Vitrine du pass\u00e9, du pr\u00e9sent et du futur sur le monde ferroviaire, Train World est le nom du nouveau mus\u00e9e des chemins de fer, actuellement en construction pr\u00e8s de la gare de Schaerbeek. Il abritera les pi\u00e8ces les plus pr\u00e9cieuses du patrimoine historique.Train World rendra hommage \u00e0 la riche histoire du train, mais d\u00e9montrera aussi que les chemins de fer n'ont pas fini de jouer un r\u00f4le important dans le d\u00e9veloppement de notre pays.","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Train World","address_street_name":"Prinses Elisabethplein","address_street_number":null,"address_street_box":null,"email":"info@trainworld.be","website":"http:\/\/www.trainworld.be","phone_contact":"+32 2 224 74 98","phone_booking":null,"address_zip":"1030","address_city":"Schaarbeek","address_line1":"Prinses Elisabethplein","address_line2":"1030 Schaarbeek","description_web":"Train World is een unieke spoorervaring die je van de allereerste stoomlocomotieven tot de flitsende hogesnelheidstreinen brengt! Het is een universum dat een beroep doet op alle zintuigen om de vele verschillende dimensies van de spoorwegen te kunnen bevatten. Een bezoek aan Train World is een actieve en verrassende uitstap. Je wandelt tussen locomotieven, neemt plaats in treinen van 100 jaar oud, bezoekt een spoorweghuisje en loopt over een echte spoorwegbrug. Je ervaart zelfs hoe het voelt om een trein te besturen!","description_print":"Train World is sinds september 2015 het uitstalraam voor de spoorwegen van gisteren, vandaag en morgen in Brussel. De site bevindt zich in Schaarbeek, op nauwelijks 10 minuten met de trein vanuit Brussel-Centraal (bij de Grote Markt). \r\n\r\nDe mooiste stukken uit de collectie historische locomotieven en rijtuigen van de Belgische spoorwegen zijn er te bewonderen, maar daarnaast wordt er ook de belangrijke rol van de trein in de mobiliteit van vandaag en de toekomst ge\u00efllustreerd. Train World is meer dan een museum: het is een belevingscentrum. Een originele scenografie \u2013 ontworpen door kunstenaar Fran\u00e7ois Schuiten - zorgt voor een ervaring waarbij je kan kijken, luisteren, aanraken en verrast worden door de boeiende verhalen uit de wereld van de trein.\r\n\r\n22-10-2019> 15-03-2020 : Tentoonstelling: Paul Delvaux, de man die van treinen hield \r\n\r\nPaul Delvaux (1897-1994) schilderde een meesterlijk oeuvre bijeen, met als inspiratiebron de wereld van de spoorwegen. Zijn surrealistische werken gaan moeiteloos op in de adembenemende scenografie van Train World. Als vanzelf ontstaat een boeiende dialoog.\r\n\r\nDeze expo is h\u00e9t uitgelezen moment om de artistieke evolutie van deze spoorwegliefhebber te ontdekken in een magische setting: van tekeningen, aquarellen en schilderijen uit de jaren 1920 tot monumentale werken uit de jaren 1970, maar ook persoonlijke objecten van de artiest voegen verrassende accenten toe. Dat de schilder in 1984 tot erestationschef van Louvain-la-Neuve werd benoemd, is veelbetekenend.\r\n\r\n","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Train World","address_street_name":"Place Princesse Elisabeth","address_street_number":null,"address_street_box":null,"email":"info@trainworld.be","website":"http:\/\/www.trainworld.be","phone_contact":"+32 2 224 74 98","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Place Princesse Elisabeth","address_line2":"1030 Schaerbeek","description_web":"Train World is a unique railway experience that takes you from the very first steam locomotives to the flashing high-speed trains! It is a universe that appeals to all the senses in order to grasp the many different dimensions of the railways. A visit to Train World is an active and surprising outing. You can walk among locomotives, take a seat in 100-year-old trains, visit a railway house and walk across a real railway bridge. You will even experience how it feels to drive a train!\r\n\r\n\r\n","description_print":"Train World, the showcase for the railways of yesterday, today and tomorrow, is a must-see tourist attraction in Brussels. The site is located a few minutes by train from Brussels Central station (near the Grand Place)\r\nHere you will be able to admire the loveliest pieces from the collection of historical locomotives and carriages from the Belgian railways, but it will also illustrate the significant role of the train in the mobility of today and in future. Train World is more than a museum: it will be an experience centre. An original scenography \u2013 designed by artist Fran\u00e7ois Schuiten \u2013 will provide an experience in which the audience can look, listen, touch and be surprised by scintillating stories from the world of trains.\r\nThe site comprises the renovated Schaerbeek station, where the ticket office is located, and a new 8,000 m\u00b2 building. A restaurant and a book & gift shop in the station completes the offering. It will also be possible to have a picnic: a restored carriage will be available in the transit area from the station to the new building for this purpose.\r\n","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Train World","address_street_name":"Place Princesse Elisabeth","address_street_number":null,"address_street_box":null,"email":"info@trainworld.be","website":"http:\/\/www.trainworld.be","phone_contact":"+32 2 224 74 98","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Place Princesse Elisabeth","address_line2":"1030 Schaerbeek","description_web":"N\u00e4chste Haltestelle Train World... kleine und gro\u00dfe Eisenbahnfreunde erwartet in Br\u00fcssel ein neues \u201eMekka\": In dem historischen Geb\u00e4ude des ehemaligen Bahnhofs von Schaerbeek erwartet Sie das spektakul\u00e4re Eisenbahnmuseum Train World, dessen Szenographie aus der Feder des belgischen Comic-K\u00fcnstlers Fran\u00e7ois Schuiten stammt.\r\n\r\nSch\u00e4tze aus der Welt der Eisenbahn: Von der \u00e4ltesten Dampflokomotive Belgiens \u00fcber prunkvolle k\u00f6nigliche Wagons bis hin zu den modernen Hochgeschwindigkeitsz\u00fcgen - Train World f\u00fchrt die Besucher durch die belgische Eisenbahngeschichte. Neben historischem und technischem Wissen gibt es auch Anekdoten und Kuriosit\u00e4ten aus der Welt der Eisenbahn zu entdecken. Wie ist eine Schiene aufgebaut, wie schnell fuhren die ersten Dampfloks, wie reisten einst die K\u00f6nige? Antworten auf all diese Fragen geben die Erkl\u00e4rungstafeln, die auch auf Deutsch zur Verf\u00fcgung stehen, sowie die kostenlosen Audioguides (ebenfalls auf Deutsch).\r\n\r\nFahrsimulator: Sie haben schon immer davon getr\u00e4umt, Lokomotivf\u00fchrer zu werden? Dann nehmen Sie Platz im F\u00fchrerstand des Fahrsimulators und begeben sich auf eine Reise durch die Eisenbahngeschichte.\r\n\r\nLeibliches Wohl:\r\n\r\nIn der Brasserie \"RN Express\", die in dem historischen Bahnhofsgeb\u00e4ude untergebracht ist, gibt es Speisen und Getr\u00e4nke. Tiefblaue W\u00e4nde, gl\u00e4serne Kugellampen und Holzmobiliar sorgen f\u00fcr ein besonderes Ambiente.\r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Train World","address_street_name":"Place Princesse Elisabeth","address_street_number":null,"address_street_box":null,"email":"info@trainworld.be","website":"http:\/\/www.trainworld.be","phone_contact":"+32 2 224 74 98","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Place Princesse Elisabeth","address_line2":"1030 Schaerbeek","description_web":"Train World. Il museo nazionale del treno aprir\u00e0 le porte alla stazione di Schaerbeek.\r\nTesori del mondo ferroviario\r\nTrain World custodir\u00e0 numerosi tesori: la pi\u00f9 antica locomotiva conservata in Belgio, la \u201cpaese di Waes\u201d, o la locomotive a vapore carenata \u201ctipo 12\u201d che aveva stabilito un record di velocit\u00e0 nel 1939.\r\n\r\nSimulatore di guida\r\n\r\nAvete sempre avuto voglia di guidare un treno ? Train World vi sistema in un simulatore di guida! Nel posto dell\u2019autista, potrete osservare i cambi dell\u2019ambiente lungo le linee ferroviarie nel corso degli anni.\r\n\r\nScuole e famiglie\r\n\r\nI vostri bambini potranno approfittare di un\u2019offerta specifica che mette l\u2019accanto sia sul aspetto educativo che divertente. Potranno approfittare di un spazio giochi originale.\r\n\r\nSala eventi\r\n\r\nTrain World entra in stazione e Bruxelles si dota di un nuovo luogo per eventi! Con 550 m\u00b2, la magnifica sala degli sportelli della stazione di Schaerbeek, risalendo al 1913, offrir\u00e0 un quadro unico per eventi. Sar\u00e0 dotata di un\u2019installazione audiovisuale moderna. \r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Train World","address_street_name":"Place Princesse Elisabeth","address_street_number":null,"address_street_box":null,"email":"info@trainworld.be","website":"http:\/\/www.trainworld.be","phone_contact":"+32 2 224 74 98","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Place Princesse Elisabeth","address_line2":"1030 Schaerbeek","description_web":"Train World, la nueva atracci\u00f3n tur\u00edstica de Bruselas.\r\n\r\nTrain World es un escaparate para los ferrocarriles de ayer, hoy y ma\u00f1ana, es la nueva atracci\u00f3n tur\u00edstica de Bruselas. El lugar est\u00e1 situado a pocos minutos en tren de la Estaci\u00f3n Central de Bruselas (cerca de la Grand Place).\r\n\r\nAqu\u00ed tendr\u00e1s la oportunidad de admirar las piezas m\u00e1s encantadoras de la colecci\u00f3n de trenes y vagones hist\u00f3ricos de los ferrocarriles belgas, pero tambi\u00e9n ilustra el importante papel del tren en la movilidad de hoy en d\u00eda y el futuro. Train World es m\u00e1s que un museo: es un centro en el que podr\u00e1s vivir nuevas experiencias. Con una escenograf\u00eda original \u2013 dise\u00f1ada por el artista Fran\u00e7ois Schuiten \u2013 te ofrece una experiencia en la que puedes mirar, escuchar, tocar y sorprenderte con incre\u00edbles historias del mundo de los trenes.\r\nEl lugar, junto con las primeras v\u00edas ferroviarias del continente europeo, incluye la Estaci\u00f3n Schaerbeek renovada donde se encuentra la taquilla y un nuevo edificio de 8.000 m\u00b2. La antigua estaci\u00f3n, construida en 1887, es una las obras maestras de la arquitectura ferroviaria belga y es patrimonio hist\u00f3rico. Y para completar la oferta encontrar\u00e1s un restaurante y una tienda de regalos en la estaci\u00f3n.\r\n\r\nAlgo para todo el mundo\r\n\r\n\u00a1Hay mucho que descubrir en Train World! Por ejemplo, puedes ver el tren de vapor m\u00e1s antiguo preservado en B\u00e9lgica, la \u201cPays de Waes\u201d. O el tren de vapor simplificado \u201cType 12\u201d, que obtuvo el r\u00e9cord de velocidad en 1939. Puedes admirar el esplendor de los aut\u00e9nticos carruajes reales o pasear en el Trans-Europe Express (TEE) de acero inoxidable \u2013 el predecesor del tren de alta velocidad \u2013 que una vez cruz\u00f3 Europa. \u00bfTe gustar\u00eda conducir un tren? Entonces prueba suerte en uno de los simuladores de tren\u2026 o estudia los cambios que han sufrido los ferrocarriles de ayer y hoy desde una cabina de conductor.\r\n\r\nTambi\u00e9n hay cientos de objetos del mundo de los trenes, tales como uniformes, pinturas o modelos de trenes y estaciones, junto con una abundante cantidad de fotos y fragmentos de pel\u00edculas. Tambi\u00e9n cabe destacar la presencia de una aut\u00e9ntica \u201ccasa de guardabarreras\u201d que ha sido incluida en el nuevo edificio. Est\u00e1 amueblada al estilo de los a\u00f1os 50 y el \u00e1tico tiene un paisaje lleno de trenes en miniatura. \r\nColegios y familias con ni\u00f1os peque\u00f1os pueden disfrutar de ofertas espec\u00edficas, con especial atenci\u00f3n en el aspecto educativo relacionado con los juegos. Los ni\u00f1os pueden disfrutar en el \u201ctren de escalada\u201d, un tren de vapor medio enterrado.\r\n\r\nGracias a la cooperaci\u00f3n con los constructores de tren, la tecnolog\u00eda moderna y el desarrollo futuro tambi\u00e9n est\u00e1n en oferta. Ejemplo de esto son las tres cabinas de tren a tama\u00f1o real de los trenes m\u00e1s modernos.\r\n\r\n\r\n","description_print":"Train World es un escaparate para los ferrocarriles de ayer, hoy y ma\u00f1ana, es la nueva atracci\u00f3n tur\u00edstica de Bruselas. El lugar est\u00e1 situado a pocos minutos en tren de la Estaci\u00f3n Central de Bruselas (cerca de la Grand Place).\r\n\r\nAqu\u00ed tendr\u00e1s la oportunidad de admirar las piezas m\u00e1s encantadoras de la colecci\u00f3n de trenes y vagones hist\u00f3ricos de los ferrocarriles belgas, pero tambi\u00e9n ilustra el importante papel del tren en la movilidad de hoy en d\u00eda y el futuro. Train World es m\u00e1s que un museo: es un centro en el que podr\u00e1s vivir nuevas experiencias. Con una escenograf\u00eda original \u2013 dise\u00f1ada por el artista Fran\u00e7ois Schuiten \u2013 te ofrece una experiencia en la que puedes mirar, escuchar, tocar y sorprenderte con incre\u00edbles historias del mundo de los trenes.\r\nEl lugar, junto con las primeras v\u00edas ferroviarias del continente europeo, incluye la Estaci\u00f3n Schaerbeek renovada donde se encuentra la taquilla y un nuevo edificio de 8.000 m\u00b2. La antigua estaci\u00f3n, construida en 1887, es una las obras maestras de la arquitectura ferroviaria belga y es patrimonio hist\u00f3rico. Y para completar la oferta encontrar\u00e1s un restaurante y una tienda de regalos en la estaci\u00f3n.\r\n\r\nAlgo para todo el mundo\r\n\r\n\u00a1Hay mucho que descubrir en Train World! Por ejemplo, puedes ver el tren de vapor m\u00e1s antiguo preservado en B\u00e9lgica, la \u201cPays de Waes\u201d. O el tren de vapor simplificado \u201cType 12\u201d, que obtuvo el r\u00e9cord de velocidad en 1939. Puedes admirar el esplendor de los aut\u00e9nticos carruajes reales o pasear en el Trans-Europe Express (TEE) de acero inoxidable \u2013 el predecesor del tren de alta velocidad \u2013 que una vez cruz\u00f3 Europa. \u00bfTe gustar\u00eda conducir un tren? Entonces prueba suerte en uno de los simuladores de tren\u2026 o estudia los cambios que han sufrido los ferrocarriles de ayer y hoy desde una cabina de conductor.\r\n\r\nTambi\u00e9n hay cientos de objetos del mundo de los trenes, tales como uniformes, pinturas o modelos de trenes y estaciones, junto con una abundante cantidad de fotos y fragmentos de pel\u00edculas. Tambi\u00e9n cabe destacar la presencia de una aut\u00e9ntica \u201ccasa de guardabarreras\u201d que ha sido incluida en el nuevo edificio. Est\u00e1 amueblada al estilo de los a\u00f1os 50 y el \u00e1tico tiene un paisaje lleno de trenes en miniatura. \r\nColegios y familias con ni\u00f1os peque\u00f1os pueden disfrutar de ofertas espec\u00edficas, con especial atenci\u00f3n en el aspecto educativo relacionado con los juegos. Los ni\u00f1os pueden disfrutar en el \u201ctren de escalada\u201d, un tren de vapor medio enterrado.\r\n\r\nGracias a la cooperaci\u00f3n con los constructores de tren, la tecnolog\u00eda moderna y el desarrollo futuro tambi\u00e9n est\u00e1n en oferta. Ejemplo de esto son las tres cabinas de tren a tama\u00f1o real de los trenes m\u00e1s modernos.\r\n\r\nTrain World will exceptionally be completely closed to the public from Monday 14 October to Monday 21 October 2019 and from Monday 16 March to Tuesday 17 March 2020 because of the assembly and dismantling of our exhibition dedicated to Paul Delvaux.\r\n\r\n","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Train World","address_street_name":"Place Princesse Elisabeth","address_street_number":null,"address_street_box":null,"email":"info@trainworld.be","website":"http:\/\/www.trainworld.be","phone_contact":"+32 2 224 74 98","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Place Princesse Elisabeth","address_line2":"1030 Schaerbeek","description_web":"Train World, o novo polo de atra\u00e7\u00e3o de Bruxelas\r\nTrain World, a montra dos caminhos de ferro de ontem, de hoje e de amanh\u00e3, \u00e9 a nova atra\u00e7\u00e3o tur\u00edstica de Bruxelas desde setembro de 2015. O local situa-se em Schaerbeek, a alguns minutos de comboio da Esta\u00e7\u00e3o Central (pr\u00f3ximo da Grand-Place).\r\nN\u00e3o est\u00e3o a\u00ed expostas apenas as pe\u00e7as mais belas da cole\u00e7\u00e3o de locomotivas e de ve\u00edculos hist\u00f3ricos dos caminhos de ferro belgas, mas tamb\u00e9m \u00e9 ilustrado o papel importante do comboio na mobilidade atual e do futuro. Train World \u00e9 mais do que um museu, trata-se de um centro de interpreta\u00e7\u00e3o. A cenografia original \u2013 desenvolvida pelo artista Fran\u00e7ois Schuiten- cria uma experi\u00eancia interativa durante a qual o p\u00fablico pode olhar, ouvir, tocar e deixar-se surpreender por hist\u00f3rias apaixonantes do mundo ferrovi\u00e1rio.\r\nO local, situado ao longo do tra\u00e7ado da primeira linha de caminhos de ferro do continente europeu (Bruxelas\u2013Mechelen, 1835), inclui a esta\u00e7\u00e3o renovada de Schaerbeek, onde se encontra a bilheteira, e uma constru\u00e7\u00e3o nova de 8000 m\u00b2. Note-se que a esta\u00e7\u00e3o, constru\u00edda em 1887, \u00e9 um dos baluartes da arquitetura ferrovi\u00e1ria belga e um monumento classificado. Um estabelecimento de hoteleira e restaura\u00e7\u00e3o situado na esta\u00e7\u00e3o completa a oferta de Train World.\r\nUma oferta muito diversificada destinada a todo o mundo\r\nTrain World aloja in\u00fameros tesouros a descobrir. Por exemplo, \u00e9 poss\u00edvel a\u00ed admirar a locomotiva a vapor mais antiga mantida na B\u00e9lgica, a \u201cPa\u00eds de Waes\u201d. Ou ainda a locomotiva a vapor de carenagem \u201ctipo 12\u201d, que estabeleceu um novo recorde de velocidade em 1939. Tamb\u00e9m \u00e9 poss\u00edvel contemplar aut\u00eanticos e sumptuosos ve\u00edculos reais ou penetrar um dos ve\u00edculos TEE inox, antecessor dos comboios de grande velocidade, que percorriam a Europa na \u00e9poca. Com vontade de assumir o comando de um comboio?\r\nPoder\u00e1 experiment\u00e1-lo, num simulador de condu\u00e7\u00e3o. No lugar do condutor, poder\u00e1 observar as mudan\u00e7as no ambiente das linhas ao longo dos anos.\r\nTrain World apresenta igualmente centenas de objetos do mundo ferrovi\u00e1rio, como uniformes, pinturas ou maquetas de comboios e de esta\u00e7\u00f5es, assim como in\u00fameras fotos e videoclipes. A notar igualmente: a apresenta\u00e7\u00e3o de uma aut\u00eantica casinha de guarda das passagens de n\u00edvel, retomada na nova constru\u00e7\u00e3o de Train World. Estar\u00e1 mobilada com uma decora\u00e7\u00e3o dos anos 50. No s\u00f3t\u00e3o, ser\u00e3o expostos comboios miniatura.\r\nAs escolas e as fam\u00edlias com crian\u00e7as pequenas poder\u00e3o aproveitar uma oferta espec\u00edfica que acentua tanto o aspeto educativo como o l\u00fadico. As crian\u00e7as poder\u00e3o dar espa\u00e7o \u00e0 sua alegria num espa\u00e7o de jogos, como m\u00ednimo, original, especialmente concebido para elas: uma locomotiva a vapor que emerge do solo.\r\nGra\u00e7as \u00e0 colabora\u00e7\u00e3o com os construtores de comboios, as tecnologias modernas e os desenvolvimentos futuros ser\u00e3o tamb\u00e9m abordados. Desse modo, o p\u00fablico poder\u00e1 admirar, por exemplo, tr\u00eas comboios de \u00faltima gera\u00e7\u00e3o.\r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Train World","address_street_name":"Place Princesse Elisabeth","address_street_number":null,"address_street_box":null,"email":"info@trainworld.be","website":"http:\/\/www.trainworld.be","phone_contact":"+32 2 224 74 98","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Place Princesse Elisabeth","address_line2":"1030 Schaerbeek","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":[],"zones":{"list":[20],"translations":{"fr":["Nord"],"nl":["Noord"],"en":["North"]}},"neca":null,"facebook_id":null,"backoffice_id":14733,"location":{"lat":50.87762766,"lon":4.37866751},"region":"brussels","last_updated_at":"2022-10-24T01:08:34+02:00","published_at":"2013-10-19T01:54:59+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":252663,"translations":{"fr":{"name":"Train World","address_street_name":"Place Princesse Elisabeth","address_street_number":null,"address_street_box":null,"email":"info@trainworld.be","website":"http:\/\/www.trainworld.be","phone_contact":"+32 2 224 74 98","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Place Princesse Elisabeth","address_line2":"1030 Schaerbeek","description_web":"Train World est une exp\u00e9rience ferroviaire unique qui vous emm\u00e8ne des toutes premi\u00e8res locomotives \u00e0 vapeur aux trains \u00e0 grande vitesse flamboyants ! C'est un univers qui fait appel \u00e0 tous les sens pour appr\u00e9hender les multiples dimensions du chemin de fer. Une visite \u00e0 Train World est une sortie active et surprenante. Vous pouvez vous promener parmi les locomotives, prendre place dans des trains centenaires, visiter une maison de chemin de fer et traverser un v\u00e9ritable pont ferroviaire. Vous ferez m\u00eame l'exp\u00e9rience de la conduite d'un train !","description_print":"Vitrine du pass\u00e9, du pr\u00e9sent et du futur sur le monde ferroviaire, Train World est le nom du nouveau mus\u00e9e des chemins de fer, actuellement en construction pr\u00e8s de la gare de Schaerbeek. Il abritera les pi\u00e8ces les plus pr\u00e9cieuses du patrimoine historique.Train World rendra hommage \u00e0 la riche histoire du train, mais d\u00e9montrera aussi que les chemins de fer n'ont pas fini de jouer un r\u00f4le important dans le d\u00e9veloppement de notre pays.","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Train World","address_street_name":"Prinses Elisabethplein","address_street_number":null,"address_street_box":null,"email":"info@trainworld.be","website":"http:\/\/www.trainworld.be","phone_contact":"+32 2 224 74 98","phone_booking":null,"address_zip":"1030","address_city":"Schaarbeek","address_line1":"Prinses Elisabethplein","address_line2":"1030 Schaarbeek","description_web":"Train World is een unieke spoorervaring die je van de allereerste stoomlocomotieven tot de flitsende hogesnelheidstreinen brengt! Het is een universum dat een beroep doet op alle zintuigen om de vele verschillende dimensies van de spoorwegen te kunnen bevatten. Een bezoek aan Train World is een actieve en verrassende uitstap. Je wandelt tussen locomotieven, neemt plaats in treinen van 100 jaar oud, bezoekt een spoorweghuisje en loopt over een echte spoorwegbrug. Je ervaart zelfs hoe het voelt om een trein te besturen!","description_print":"Train World is sinds september 2015 het uitstalraam voor de spoorwegen van gisteren, vandaag en morgen in Brussel. De site bevindt zich in Schaarbeek, op nauwelijks 10 minuten met de trein vanuit Brussel-Centraal (bij de Grote Markt). \r\n\r\nDe mooiste stukken uit de collectie historische locomotieven en rijtuigen van de Belgische spoorwegen zijn er te bewonderen, maar daarnaast wordt er ook de belangrijke rol van de trein in de mobiliteit van vandaag en de toekomst ge\u00efllustreerd. Train World is meer dan een museum: het is een belevingscentrum. Een originele scenografie \u2013 ontworpen door kunstenaar Fran\u00e7ois Schuiten - zorgt voor een ervaring waarbij je kan kijken, luisteren, aanraken en verrast worden door de boeiende verhalen uit de wereld van de trein.\r\n\r\n22-10-2019> 15-03-2020 : Tentoonstelling: Paul Delvaux, de man die van treinen hield \r\n\r\nPaul Delvaux (1897-1994) schilderde een meesterlijk oeuvre bijeen, met als inspiratiebron de wereld van de spoorwegen. Zijn surrealistische werken gaan moeiteloos op in de adembenemende scenografie van Train World. Als vanzelf ontstaat een boeiende dialoog.\r\n\r\nDeze expo is h\u00e9t uitgelezen moment om de artistieke evolutie van deze spoorwegliefhebber te ontdekken in een magische setting: van tekeningen, aquarellen en schilderijen uit de jaren 1920 tot monumentale werken uit de jaren 1970, maar ook persoonlijke objecten van de artiest voegen verrassende accenten toe. Dat de schilder in 1984 tot erestationschef van Louvain-la-Neuve werd benoemd, is veelbetekenend.\r\n\r\n","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Train World","address_street_name":"Place Princesse Elisabeth","address_street_number":null,"address_street_box":null,"email":"info@trainworld.be","website":"http:\/\/www.trainworld.be","phone_contact":"+32 2 224 74 98","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Place Princesse Elisabeth","address_line2":"1030 Schaerbeek","description_web":"Train World is a unique railway experience that takes you from the very first steam locomotives to the flashing high-speed trains! It is a universe that appeals to all the senses in order to grasp the many different dimensions of the railways. A visit to Train World is an active and surprising outing. You can walk among locomotives, take a seat in 100-year-old trains, visit a railway house and walk across a real railway bridge. You will even experience how it feels to drive a train!\r\n\r\n\r\n","description_print":"Train World, the showcase for the railways of yesterday, today and tomorrow, is a must-see tourist attraction in Brussels. The site is located a few minutes by train from Brussels Central station (near the Grand Place)\r\nHere you will be able to admire the loveliest pieces from the collection of historical locomotives and carriages from the Belgian railways, but it will also illustrate the significant role of the train in the mobility of today and in future. Train World is more than a museum: it will be an experience centre. An original scenography \u2013 designed by artist Fran\u00e7ois Schuiten \u2013 will provide an experience in which the audience can look, listen, touch and be surprised by scintillating stories from the world of trains.\r\nThe site comprises the renovated Schaerbeek station, where the ticket office is located, and a new 8,000 m\u00b2 building. A restaurant and a book & gift shop in the station completes the offering. It will also be possible to have a picnic: a restored carriage will be available in the transit area from the station to the new building for this purpose.\r\n","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Train World","address_street_name":"Place Princesse Elisabeth","address_street_number":null,"address_street_box":null,"email":"info@trainworld.be","website":"http:\/\/www.trainworld.be","phone_contact":"+32 2 224 74 98","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Place Princesse Elisabeth","address_line2":"1030 Schaerbeek","description_web":"N\u00e4chste Haltestelle Train World... kleine und gro\u00dfe Eisenbahnfreunde erwartet in Br\u00fcssel ein neues \u201eMekka\": In dem historischen Geb\u00e4ude des ehemaligen Bahnhofs von Schaerbeek erwartet Sie das spektakul\u00e4re Eisenbahnmuseum Train World, dessen Szenographie aus der Feder des belgischen Comic-K\u00fcnstlers Fran\u00e7ois Schuiten stammt.\r\n\r\nSch\u00e4tze aus der Welt der Eisenbahn: Von der \u00e4ltesten Dampflokomotive Belgiens \u00fcber prunkvolle k\u00f6nigliche Wagons bis hin zu den modernen Hochgeschwindigkeitsz\u00fcgen - Train World f\u00fchrt die Besucher durch die belgische Eisenbahngeschichte. Neben historischem und technischem Wissen gibt es auch Anekdoten und Kuriosit\u00e4ten aus der Welt der Eisenbahn zu entdecken. Wie ist eine Schiene aufgebaut, wie schnell fuhren die ersten Dampfloks, wie reisten einst die K\u00f6nige? Antworten auf all diese Fragen geben die Erkl\u00e4rungstafeln, die auch auf Deutsch zur Verf\u00fcgung stehen, sowie die kostenlosen Audioguides (ebenfalls auf Deutsch).\r\n\r\nFahrsimulator: Sie haben schon immer davon getr\u00e4umt, Lokomotivf\u00fchrer zu werden? Dann nehmen Sie Platz im F\u00fchrerstand des Fahrsimulators und begeben sich auf eine Reise durch die Eisenbahngeschichte.\r\n\r\nLeibliches Wohl:\r\n\r\nIn der Brasserie \"RN Express\", die in dem historischen Bahnhofsgeb\u00e4ude untergebracht ist, gibt es Speisen und Getr\u00e4nke. Tiefblaue W\u00e4nde, gl\u00e4serne Kugellampen und Holzmobiliar sorgen f\u00fcr ein besonderes Ambiente.\r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Train World","address_street_name":"Place Princesse Elisabeth","address_street_number":null,"address_street_box":null,"email":"info@trainworld.be","website":"http:\/\/www.trainworld.be","phone_contact":"+32 2 224 74 98","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Place Princesse Elisabeth","address_line2":"1030 Schaerbeek","description_web":"Train World. Il museo nazionale del treno aprir\u00e0 le porte alla stazione di Schaerbeek.\r\nTesori del mondo ferroviario\r\nTrain World custodir\u00e0 numerosi tesori: la pi\u00f9 antica locomotiva conservata in Belgio, la \u201cpaese di Waes\u201d, o la locomotive a vapore carenata \u201ctipo 12\u201d che aveva stabilito un record di velocit\u00e0 nel 1939.\r\n\r\nSimulatore di guida\r\n\r\nAvete sempre avuto voglia di guidare un treno ? Train World vi sistema in un simulatore di guida! Nel posto dell\u2019autista, potrete osservare i cambi dell\u2019ambiente lungo le linee ferroviarie nel corso degli anni.\r\n\r\nScuole e famiglie\r\n\r\nI vostri bambini potranno approfittare di un\u2019offerta specifica che mette l\u2019accanto sia sul aspetto educativo che divertente. Potranno approfittare di un spazio giochi originale.\r\n\r\nSala eventi\r\n\r\nTrain World entra in stazione e Bruxelles si dota di un nuovo luogo per eventi! Con 550 m\u00b2, la magnifica sala degli sportelli della stazione di Schaerbeek, risalendo al 1913, offrir\u00e0 un quadro unico per eventi. Sar\u00e0 dotata di un\u2019installazione audiovisuale moderna. \r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Train World","address_street_name":"Place Princesse Elisabeth","address_street_number":null,"address_street_box":null,"email":"info@trainworld.be","website":"http:\/\/www.trainworld.be","phone_contact":"+32 2 224 74 98","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Place Princesse Elisabeth","address_line2":"1030 Schaerbeek","description_web":"Train World, la nueva atracci\u00f3n tur\u00edstica de Bruselas.\r\n\r\nTrain World es un escaparate para los ferrocarriles de ayer, hoy y ma\u00f1ana, es la nueva atracci\u00f3n tur\u00edstica de Bruselas. El lugar est\u00e1 situado a pocos minutos en tren de la Estaci\u00f3n Central de Bruselas (cerca de la Grand Place).\r\n\r\nAqu\u00ed tendr\u00e1s la oportunidad de admirar las piezas m\u00e1s encantadoras de la colecci\u00f3n de trenes y vagones hist\u00f3ricos de los ferrocarriles belgas, pero tambi\u00e9n ilustra el importante papel del tren en la movilidad de hoy en d\u00eda y el futuro. Train World es m\u00e1s que un museo: es un centro en el que podr\u00e1s vivir nuevas experiencias. Con una escenograf\u00eda original \u2013 dise\u00f1ada por el artista Fran\u00e7ois Schuiten \u2013 te ofrece una experiencia en la que puedes mirar, escuchar, tocar y sorprenderte con incre\u00edbles historias del mundo de los trenes.\r\nEl lugar, junto con las primeras v\u00edas ferroviarias del continente europeo, incluye la Estaci\u00f3n Schaerbeek renovada donde se encuentra la taquilla y un nuevo edificio de 8.000 m\u00b2. La antigua estaci\u00f3n, construida en 1887, es una las obras maestras de la arquitectura ferroviaria belga y es patrimonio hist\u00f3rico. Y para completar la oferta encontrar\u00e1s un restaurante y una tienda de regalos en la estaci\u00f3n.\r\n\r\nAlgo para todo el mundo\r\n\r\n\u00a1Hay mucho que descubrir en Train World! Por ejemplo, puedes ver el tren de vapor m\u00e1s antiguo preservado en B\u00e9lgica, la \u201cPays de Waes\u201d. O el tren de vapor simplificado \u201cType 12\u201d, que obtuvo el r\u00e9cord de velocidad en 1939. Puedes admirar el esplendor de los aut\u00e9nticos carruajes reales o pasear en el Trans-Europe Express (TEE) de acero inoxidable \u2013 el predecesor del tren de alta velocidad \u2013 que una vez cruz\u00f3 Europa. \u00bfTe gustar\u00eda conducir un tren? Entonces prueba suerte en uno de los simuladores de tren\u2026 o estudia los cambios que han sufrido los ferrocarriles de ayer y hoy desde una cabina de conductor.\r\n\r\nTambi\u00e9n hay cientos de objetos del mundo de los trenes, tales como uniformes, pinturas o modelos de trenes y estaciones, junto con una abundante cantidad de fotos y fragmentos de pel\u00edculas. Tambi\u00e9n cabe destacar la presencia de una aut\u00e9ntica \u201ccasa de guardabarreras\u201d que ha sido incluida en el nuevo edificio. Est\u00e1 amueblada al estilo de los a\u00f1os 50 y el \u00e1tico tiene un paisaje lleno de trenes en miniatura. \r\nColegios y familias con ni\u00f1os peque\u00f1os pueden disfrutar de ofertas espec\u00edficas, con especial atenci\u00f3n en el aspecto educativo relacionado con los juegos. Los ni\u00f1os pueden disfrutar en el \u201ctren de escalada\u201d, un tren de vapor medio enterrado.\r\n\r\nGracias a la cooperaci\u00f3n con los constructores de tren, la tecnolog\u00eda moderna y el desarrollo futuro tambi\u00e9n est\u00e1n en oferta. Ejemplo de esto son las tres cabinas de tren a tama\u00f1o real de los trenes m\u00e1s modernos.\r\n\r\n\r\n","description_print":"Train World es un escaparate para los ferrocarriles de ayer, hoy y ma\u00f1ana, es la nueva atracci\u00f3n tur\u00edstica de Bruselas. El lugar est\u00e1 situado a pocos minutos en tren de la Estaci\u00f3n Central de Bruselas (cerca de la Grand Place).\r\n\r\nAqu\u00ed tendr\u00e1s la oportunidad de admirar las piezas m\u00e1s encantadoras de la colecci\u00f3n de trenes y vagones hist\u00f3ricos de los ferrocarriles belgas, pero tambi\u00e9n ilustra el importante papel del tren en la movilidad de hoy en d\u00eda y el futuro. Train World es m\u00e1s que un museo: es un centro en el que podr\u00e1s vivir nuevas experiencias. Con una escenograf\u00eda original \u2013 dise\u00f1ada por el artista Fran\u00e7ois Schuiten \u2013 te ofrece una experiencia en la que puedes mirar, escuchar, tocar y sorprenderte con incre\u00edbles historias del mundo de los trenes.\r\nEl lugar, junto con las primeras v\u00edas ferroviarias del continente europeo, incluye la Estaci\u00f3n Schaerbeek renovada donde se encuentra la taquilla y un nuevo edificio de 8.000 m\u00b2. La antigua estaci\u00f3n, construida en 1887, es una las obras maestras de la arquitectura ferroviaria belga y es patrimonio hist\u00f3rico. Y para completar la oferta encontrar\u00e1s un restaurante y una tienda de regalos en la estaci\u00f3n.\r\n\r\nAlgo para todo el mundo\r\n\r\n\u00a1Hay mucho que descubrir en Train World! Por ejemplo, puedes ver el tren de vapor m\u00e1s antiguo preservado en B\u00e9lgica, la \u201cPays de Waes\u201d. O el tren de vapor simplificado \u201cType 12\u201d, que obtuvo el r\u00e9cord de velocidad en 1939. Puedes admirar el esplendor de los aut\u00e9nticos carruajes reales o pasear en el Trans-Europe Express (TEE) de acero inoxidable \u2013 el predecesor del tren de alta velocidad \u2013 que una vez cruz\u00f3 Europa. \u00bfTe gustar\u00eda conducir un tren? Entonces prueba suerte en uno de los simuladores de tren\u2026 o estudia los cambios que han sufrido los ferrocarriles de ayer y hoy desde una cabina de conductor.\r\n\r\nTambi\u00e9n hay cientos de objetos del mundo de los trenes, tales como uniformes, pinturas o modelos de trenes y estaciones, junto con una abundante cantidad de fotos y fragmentos de pel\u00edculas. Tambi\u00e9n cabe destacar la presencia de una aut\u00e9ntica \u201ccasa de guardabarreras\u201d que ha sido incluida en el nuevo edificio. Est\u00e1 amueblada al estilo de los a\u00f1os 50 y el \u00e1tico tiene un paisaje lleno de trenes en miniatura. \r\nColegios y familias con ni\u00f1os peque\u00f1os pueden disfrutar de ofertas espec\u00edficas, con especial atenci\u00f3n en el aspecto educativo relacionado con los juegos. Los ni\u00f1os pueden disfrutar en el \u201ctren de escalada\u201d, un tren de vapor medio enterrado.\r\n\r\nGracias a la cooperaci\u00f3n con los constructores de tren, la tecnolog\u00eda moderna y el desarrollo futuro tambi\u00e9n est\u00e1n en oferta. Ejemplo de esto son las tres cabinas de tren a tama\u00f1o real de los trenes m\u00e1s modernos.\r\n\r\nTrain World will exceptionally be completely closed to the public from Monday 14 October to Monday 21 October 2019 and from Monday 16 March to Tuesday 17 March 2020 because of the assembly and dismantling of our exhibition dedicated to Paul Delvaux.\r\n\r\n","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Train World","address_street_name":"Place Princesse Elisabeth","address_street_number":null,"address_street_box":null,"email":"info@trainworld.be","website":"http:\/\/www.trainworld.be","phone_contact":"+32 2 224 74 98","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Place Princesse Elisabeth","address_line2":"1030 Schaerbeek","description_web":"Train World, o novo polo de atra\u00e7\u00e3o de Bruxelas\r\nTrain World, a montra dos caminhos de ferro de ontem, de hoje e de amanh\u00e3, \u00e9 a nova atra\u00e7\u00e3o tur\u00edstica de Bruxelas desde setembro de 2015. O local situa-se em Schaerbeek, a alguns minutos de comboio da Esta\u00e7\u00e3o Central (pr\u00f3ximo da Grand-Place).\r\nN\u00e3o est\u00e3o a\u00ed expostas apenas as pe\u00e7as mais belas da cole\u00e7\u00e3o de locomotivas e de ve\u00edculos hist\u00f3ricos dos caminhos de ferro belgas, mas tamb\u00e9m \u00e9 ilustrado o papel importante do comboio na mobilidade atual e do futuro. Train World \u00e9 mais do que um museu, trata-se de um centro de interpreta\u00e7\u00e3o. A cenografia original \u2013 desenvolvida pelo artista Fran\u00e7ois Schuiten- cria uma experi\u00eancia interativa durante a qual o p\u00fablico pode olhar, ouvir, tocar e deixar-se surpreender por hist\u00f3rias apaixonantes do mundo ferrovi\u00e1rio.\r\nO local, situado ao longo do tra\u00e7ado da primeira linha de caminhos de ferro do continente europeu (Bruxelas\u2013Mechelen, 1835), inclui a esta\u00e7\u00e3o renovada de Schaerbeek, onde se encontra a bilheteira, e uma constru\u00e7\u00e3o nova de 8000 m\u00b2. Note-se que a esta\u00e7\u00e3o, constru\u00edda em 1887, \u00e9 um dos baluartes da arquitetura ferrovi\u00e1ria belga e um monumento classificado. Um estabelecimento de hoteleira e restaura\u00e7\u00e3o situado na esta\u00e7\u00e3o completa a oferta de Train World.\r\nUma oferta muito diversificada destinada a todo o mundo\r\nTrain World aloja in\u00fameros tesouros a descobrir. Por exemplo, \u00e9 poss\u00edvel a\u00ed admirar a locomotiva a vapor mais antiga mantida na B\u00e9lgica, a \u201cPa\u00eds de Waes\u201d. Ou ainda a locomotiva a vapor de carenagem \u201ctipo 12\u201d, que estabeleceu um novo recorde de velocidade em 1939. Tamb\u00e9m \u00e9 poss\u00edvel contemplar aut\u00eanticos e sumptuosos ve\u00edculos reais ou penetrar um dos ve\u00edculos TEE inox, antecessor dos comboios de grande velocidade, que percorriam a Europa na \u00e9poca. Com vontade de assumir o comando de um comboio?\r\nPoder\u00e1 experiment\u00e1-lo, num simulador de condu\u00e7\u00e3o. No lugar do condutor, poder\u00e1 observar as mudan\u00e7as no ambiente das linhas ao longo dos anos.\r\nTrain World apresenta igualmente centenas de objetos do mundo ferrovi\u00e1rio, como uniformes, pinturas ou maquetas de comboios e de esta\u00e7\u00f5es, assim como in\u00fameras fotos e videoclipes. A notar igualmente: a apresenta\u00e7\u00e3o de uma aut\u00eantica casinha de guarda das passagens de n\u00edvel, retomada na nova constru\u00e7\u00e3o de Train World. Estar\u00e1 mobilada com uma decora\u00e7\u00e3o dos anos 50. No s\u00f3t\u00e3o, ser\u00e3o expostos comboios miniatura.\r\nAs escolas e as fam\u00edlias com crian\u00e7as pequenas poder\u00e3o aproveitar uma oferta espec\u00edfica que acentua tanto o aspeto educativo como o l\u00fadico. As crian\u00e7as poder\u00e3o dar espa\u00e7o \u00e0 sua alegria num espa\u00e7o de jogos, como m\u00ednimo, original, especialmente concebido para elas: uma locomotiva a vapor que emerge do solo.\r\nGra\u00e7as \u00e0 colabora\u00e7\u00e3o com os construtores de comboios, as tecnologias modernas e os desenvolvimentos futuros ser\u00e3o tamb\u00e9m abordados. Desse modo, o p\u00fablico poder\u00e1 admirar, por exemplo, tr\u00eas comboios de \u00faltima gera\u00e7\u00e3o.\r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Train World","address_street_name":"Place Princesse Elisabeth","address_street_number":null,"address_street_box":null,"email":"info@trainworld.be","website":"http:\/\/www.trainworld.be","phone_contact":"+32 2 224 74 98","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Place Princesse Elisabeth","address_line2":"1030 Schaerbeek","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":null,"facebook_id":null,"backoffice_id":14733,"location":{"lat":50.87762766,"lon":4.37866751},"region":"brussels","last_updated_at":"2022-10-24T01:08:35+02:00","published_at":"2013-10-19T01:54:59+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/37a09a36ed7b4d67648728d5c2e03341c90ccc6f.jpg","width":595,"height":842,"ratio":0.71,"translations":{"fr":{"title":"Expo \"Royals & Trains\"","copyright":null},"nl":{"title":"Expo \"Royals & Trains\"","copyright":null},"en":{"title":"Expo \"Royals & Trains\"","copyright":null}}},{"type":"video","link":"https:\/\/www.youtube.com\/watch?v=G-NUVM5CyVE","oEmbed_title":"Expo \"Royals & Trains\" - Een unieke kans om de koninklijke treinen te ontdekken!","oEmbed_author_name":"Train World","oEmbed_author_url":"https:\/\/www.youtube.com\/channel\/UCY-STWe1lKemDbpZw4XuZyA","oEmbed_type":"video","oEmbed_height":200,"oEmbed_width":356,"oEmbed_version":"1.0","oEmbed_provider_name":"YouTube","oEmbed_provider_url":"https:\/\/www.youtube.com\/","oEmbed_thumbnail_height":360,"oEmbed_thumbnail_width":480,"oEmbed_thumbnail_url":"https:\/\/i.ytimg.com\/vi\/G-NUVM5CyVE\/hqdefault.jpg","oEmbed_html":"<ifr