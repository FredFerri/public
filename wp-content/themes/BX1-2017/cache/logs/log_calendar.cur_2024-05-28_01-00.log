nscience de son corps, lib\u00e9rer son imaginaire, vivre une exp\u00e9rience de cr\u00e9ation collective, \u00e9laborer et exprimer son point de vue, \u00eatre ouvert \u00e0 d'autres visions du monde, \u00eatre \u00e0 la fois observateur, cr\u00e9ateur et acteur.\r\nDe 15h \u00e0 16h les mercredis \u00e0 partir du 20\/9 jusqu\u2019au 5\/6 \r\nAvec Alice de Marchi\r\nLocal Th\u00e9\u00e2tre Prix : 275 euros\r\n","performers":"Avec Alice de Marchi","boxoffice_url":null,"website":"https:\/\/www.wolubilis.be\/a-faire\/eveil-au-theatre-5-6-ans-2023-2024-105\/","email":"secretariat.atl@woluwe1200.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.559316"},"sp":{"name":"\u00c9veil au Th\u00e9\u00e2tre","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.wolubilis.be\/a-faire\/eveil-au-theatre-5-6-ans-2023-2024-105\/","email":"secretariat.atl@woluwe1200.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.559316"},"nl":{"name":"\u00c9veil au Th\u00e9\u00e2tre","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.wolubilis.be\/a-faire\/eveil-au-theatre-5-6-ans-2023-2024-105\/","email":"secretariat.atl@woluwe1200.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.559316"}},"place":{"last_updated_at":"2022-10-18T11:25:22+02:00","published_at":"2013-10-19T01:13:39+02:00","id":220532,"translations":{"de":{"name":"Centre Culturel Wolubilis","address_street_name":"Cours Paul-Henri Spaak","address_street_number":"1","address_street_box":null,"email":"secretariat.atl@woluwe1200.be","website":"http:\/\/www.wolubilis.be","phone_contact":"+32 2 761 60 29","phone_booking":"+32 2 761 60 30","address_zip":"1200","address_city":"Woluwe-Saint-Lambert","add