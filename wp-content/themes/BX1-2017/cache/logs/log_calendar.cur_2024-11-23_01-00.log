210.be\/saisons\/saison-24-25\/ostentation\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50012031"},"pt":{"name":"Ostentation de Sophia Rodriguez","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/atelier210.be\/saisons\/saison-24-25\/ostentation\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50012031"},"en":{"name":"Ostentation de Sophia Rodriguez","shortdescr":"In Ostentation the body wants to become an image, while at the same time breaking this identification. By researching the different layers of the meaning that female bodies generate in social and physical capitalist-oriented spaces, Ostentation works through the images projected upon us, as well as the ones we create ourselves.","longdescr":"In Ostentation the body wants to become an image, while at the same time breaking this identification. By researching the different layers of the meaning that female bodies generate in social and physical capitalist-oriented spaces, Ostentation works through the images projected upon us, as well as the ones we create ourselves. These two directions of projection are sometimes in consensus, sometimes in conflict and mostly somewhere in between. The performance space folds and unfolds, generating meaning only to absorb it again, digging for deeper layers and maybe stacking them for higher truths. The audience becomes part of a playful game that dissolves the boundaries between being and (re)presenting.","performers":null,"boxoffice_url":null,"website":"https:\/\/atelier210.be\/saisons\/saison-24-25\/ostentation\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50012031"},"it":{"name":"Ostentation de Sophia Rodriguez","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/atelier210.be\/saisons\/saison-24-25\/ostentation\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50012031"},"cn":{"name":"Ostentation de Sophia Rodriguez","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/atelier210.be\/saisons\/saison-24-25\/ostentation\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50012031"},"fr":{"name":"Ostentation de Sophia Rodriguez","shortdescr":"Dans Ostentation, le corps aspire \u00e0 devenir une image tout en d\u00e9construisant cette identification. En explorant les multiples strates de signification que les corps f\u00e9minins engendrent dans les sph\u00e8res sociales et physiques influenc\u00e9es par le capitalisme, Ostentation interroge les repr\u00e9sentations qui nous sont projet\u00e9es ainsi que celles que nous construisons nous-m\u00eames.","longdescr":"Dans Ostentation, le corps aspire \u00e0 devenir une image tout en d\u00e9construisant cette identification. En explorant les multiples strates de signification que les corps f\u00e9minins engendrent dans les sph\u00e8res sociales et physiques influenc\u00e9es par le capitalisme, Ostentation interroge les repr\u00e9sentations qui nous sont projet\u00e9es ainsi que celles que nous construisons nous-m\u00eames. Ces deux directions de projection peuvent tant\u00f4t converger, tant\u00f4t entrer en conflit, mais le plus souvent se situent quelque part entre les deux. L'espace de la performance se plie et se d\u00e9ploie, g\u00e9n\u00e9rant du sens uniquement pour mieux l'absorber \u00e0 nouveau, creusant toujours plus profond\u00e9ment pour r\u00e9v\u00e9ler des v\u00e9rit\u00e9s peut-\u00eatre plus essentielles. Le public devient ainsi partie prenante d'un jeu ludique qui efface les fronti\u00e8res entre l'\u00eatre et la (re)pr\u00e9sentation.\n\nConcept & direction : Sophia Rodriguez \u00b7 Conceptual partners : Julia Reist & Vincent Focquet \u00b7 Assistant director: Vincent Focquet \u00b7 Performance : Sophia Rodriguez \u00b7 Scenography & costumes : Sophia Rodriguez \u00b7 Music: Thomas Proksch \u00b7 Light design: Valentin Boucq \u00b7 Dramaturgy: Jonas Rutgeers \u00b7 Collaborators: Oneka von Schrader \u00b7 Vocal advice: Lester Arias \u00b7 Photo: Leontien Allemeersch \u00b7 Production: Kunstenwerkplaats \u00b7 Special thanks to Tempus-Fugit, Volksroom, ARP \u00b7 With the support of the Vlaamse Gemeenschapscommissie ","performers":"Concept & direction : Sophia Rodriguez \u00b7 Conceptual partners : Julia Reist & Vincent Focquet \u00b7 Assistant director: Vincent Focquet \u00b7 Performance : Sophia Rodriguez \u00b7 Scenography & costumes : Sophia Rodriguez \u00b7 Music: Thomas Proksch \u00b7 Light design: Valentin Boucq \u00b7 Dramaturgy: Jonas Rutgeers \u00b7 Collaborators: Oneka von Schrader \u00b7 Vocal advice: Lester Arias \u00b7 Photo: Leontien Allemeersch","boxoffice_url":null,"website":"https:\/\/atelier210.be\/saisons\/saison-24-25\/ostentation\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50012031"},"sp":{"name":"Ostentation de Sophia Rodriguez","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/atelier210.be\/saisons\/saison-24-25\/ostentation\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50012031"},"nl":{"name":"Ostentation de Sophia Rodriguez","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/atelier210.be\/saisons\/saison-24-25\/ostentation\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50012031"}},"place":{"id":241923,"translations":