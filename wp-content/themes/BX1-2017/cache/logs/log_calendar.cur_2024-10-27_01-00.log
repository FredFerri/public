ll,"is_part_of":null,"sub_type":"misc","ranking":0.7778222374656406,"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"categories":{"main":{"id":84,"translations":{"de":"Verschiedenes","pt":null,"en":"Various","it":"Varie","cn":null,"fr":"Divers","sp":"Varios","nl":"Varia"}},"others":{"list":[87],"translations":{"de":["Jahrm\u00e4rkte & Feste"],"pt":[null],"en":["Charity fairs and festivities"],"it":["Kermesse e celebrazioni"],"cn":[null],"fr":["Kermesses et festivit\u00e9s"],"sp":["Fiestas populares y festividades"],"nl":["Kermissen en feestelijkhheden"]}}},"translations":{"de":{"name":"Foire d'Halloween","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/tour-taxis.com\/fr\/event\/halloween-a-tourtaxis\/","email":"communication@tour-taxis.com","phone_contact":"+32 2 882 10 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700002050"},"pt":{"name":"Foire d'Halloween","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/tour-taxis.com\/fr\/event\/halloween-a-tourtaxis\/","email":"communication@tour-taxis.com","phone_contact":"+32 2 882 10 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700002050"},"en":{"name":"Halloween Fair","shortdescr":"From October 18 to November 3, the Tour & Taxis site transforms for Halloween! Come experience a unique moment in a spellbinding atmosphere, where fun, thrills, and surprises await you.\nEnjoy a funfair with carousels and rides, children's entertainment, and many more surprises to discover!","longdescr":"From October 18th to November 3rd, 2024\n\nThis year, Tour & Taxis transforms to bring you a truly unique Halloween celebration! For 17 days, dive into a magical and terrifying world filled with witches, giant pumpkins, and enchanting decorations.\n\nWhat\u2019s in store:\n\nGrand Funfair: For the first time, Tour & Taxis hosts a spectacular funfair featuring all the best attractions: bumper cars, carousel, archery, casino, and the famous haunted house. Thrill-seekers will love the V-Max! Whether you\u2019re looking for adrenaline-pumping rides or just fun, there\u2019s something for all ages!\nChildren\u2019s activities: Enjoy creative and fun activities like face painting, pumpkin carving workshops, and many more surprises to discover.\nContests: Join our competitions, including the one for the scariest costume, and stand a chance to win exciting prizes.\nGourmet delights: Treat yourself to a variety of sweet and savory snacks, including the famous Vandermeulen fries, croustillons, doughnuts, and other tasty treats.\nPractical information:\n\nFree entry with some activities at affordable prices.\nOpening hours:\nChildren\u2019s activities from 2:00 PM to 6:00 PM daily\nFunfair open from 2:00 PM to 10:00 PM every day\nDon\u2019t miss this unique opportunity to celebrate Halloween at Tour & Taxis for an experience full of thrills, magic, and entertainment for the whole family!","performers":null,"boxoffice_url":null,"website":"https:\/\/tour-taxis.com\/event\/halloween-to-tourtaxis\/","email":"communication@tour-taxis.com","phone_contact":"+32 2 882 10 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700002050"},"it":{"name":"Foire d'Halloween","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/tour-taxis.com\/fr\/event\/halloween-a-tourtaxis\/","email":"communication@tour-taxis.com","phone_contact":"+32 2 882 10 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700002050"},"cn":{"name":"Foire d'Halloween","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/tour-taxis.com\/fr\/event\/halloween-a-tourtaxis\/","email":"communication@tour-taxis.com","phone_contact":"+32 2 882 10 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700002050"},"fr":{"name":"Foire d'Halloween","shortdescr":"Du 18 octobre au 3 novembre, tout le site de Tour & Taxis se m\u00e9tamorphose pour Halloween ! Venez vivre un moment unique dans une ambiance ensorcelante, o\u00f9 f\u00eate, frissons et surprises vous attendent.\nRetrouvez une f\u00eate foraine avec ses carrousels et man\u00e8ges, des animations pour enfants et bien d'autres surprises \u00e0 d\u00e9couvrir !","longdescr":"Cette ann\u00e9e, Tour & Taxis se m\u00e9tamorphose pour vous offrir une c\u00e9l\u00e9bration d\u2019Halloween in\u00e9dite\u202f! Pendant 17 jours, plongez dans un univers magique et terrifiant, peupl\u00e9 de sorci\u00e8res, de citrouilles g\u00e9antes, et de d\u00e9cors ensorcelants.\n\nAu programme :\n\nUne grande f\u00eate foraine : Tour & Taxis accueille pour la premi\u00e8re fois une f\u00eate foraine spectaculaire avec toutes les attractions phares\u202f: auto-tamponneuses, carrousel, tir \u00e0 l\u2019arc, casino, et la fameuse maison hant\u00e9e. Les amateurs de sensations fortes seront ravis avec le V-Max\u202f! Que vous soyez en qu\u00eate d\u2019adr\u00e9naline ou de moments de divertissement, il y en a pour tous les \u00e2ges\u202f!\n\nDes animations pour enfants : Des activit\u00e9s cr\u00e9atives et ludiques comme le grimage, des ateliers de sculpture de citrouille, et bien d\u2019autres surprises \u00e0 d\u00e9couvrir.\n\nDes concours : Participez \u00e0 nos concours, notamment celui du costume le plus effrayant pour tenter de remporter des prix.\n\nDes d\u00e9lices gourmands : R\u00e9galez-vous avec une vari\u00e9t\u00e9 de sp\u00e9cialit\u00e9s sucr\u00e9es et sal\u00e9es, dont les c\u00e9l\u00e8bres frites Vandermeulen, des croustillons, beignets, et autres friandises.\n\nInformations pratiques :\n\nEntr\u00e9e gratuite avec certaines activit\u00e9s payantes \u00e0 petits prix.\n\nHoraires :\n\nDu 18 octobre au 3 novembre !\n\u2013 Animations pour les plus jeunes de 14h00 \u00e0 18h00 tous les jours\n\u2013 F\u00eate foraine ouverte de 14h00 \u00e0 22h00 chaque jour\n\nNe manquez pas cette occasion unique de c\u00e9l\u00e9brer Halloween \u00e0 Tour & Taxis pour une exp\u00e9rience remplie de frissons, de magie, et de divertissement pour toute la famille\u202f!","performers":null,"boxoffice_url":null,"website":"https:\/\/tour-taxis.com\/fr\/event\/halloween-a-tourtaxis\/","email":"communication@tour-taxis.com","phone_contact":"+32 2 882 10 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700002050"},"sp":{"name":"Foire d'Halloween","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/tour-taxis.com\/fr\/event\/halloween-a-tourtaxis\/","email":"communication@tour-taxis.com","phone_contact":"+32 2 882 10 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700002050"},"nl":{"name":"Halloween Foor","shortdescr":"Van 18 oktober tot 3 november verandert Tour & Taxis in een Halloween-bestemming!\nErvaar de betoverende sfeer met een kermis, attracties en activiteiten voor jong en oud. Bereid je voor op spannende momenten en onvergetelijke ervaringen met het gezin.","longdescr":"Van 18 oktober tot 3 november 2024 Dit jaar transformeert Tour & Taxis om je een uniek Halloweenfeest te bieden!\nDuik 17 dagen lang in een magische en angstaanjagende wereld vol heksen, reuzenpompoenen en betoverende decoraties. Wat is er te doen?\n\nGrote kermis: Voor het eerst organiseert Tour & Taxis een spectaculaire kermis met alle beste attracties: botsauto\u2019s, draaimolen, boogschieten, casino en het beroemde spookhuis.\nSensatiezoekers zullen dol zijn op de V-Max! Of je nu op zoek bent naar adrenalineverhogende attracties of gewoon plezier, er is voor elk wat wils!\nActiviteiten voor kinderen: Geniet van creatieve en leuke activiteiten zoals schminken, workshops pompoensnijden en nog veel meer verrassingen om te ontdekken.\nWedstrijden: Doe mee aan onze wedstrijden, waaronder die voor het engste kostuum, en maak kans op spannende prijzen.\nLekkers voor fijnproevers: Trakteer jezelf op een verscheidenheid aan zoete en hartige snacks, waaronder de beroemde Vandermeulen frietjes, croustillons, donuts en andere smakelijke traktaties.\nPraktische informatie:\n\nGratis toegang met een aantal activiteiten tegen betaalbare prijzen.\nOpeningstijden:\nKinderactiviteiten dagelijks van 14.00 tot 18.00 uur\nKermis elke dag geopend van 14.00 tot 22.00 uur\nMis deze unieke kans niet om Halloween te vieren bij Tour & Taxis voor een ervaring vol spanning, magie en entertainment voor het hele gezin!","performers":null,"boxoffice_url":null,"website":"https:\/\/tour-taxis.com\/nl\/event\/halloween-aan-tourtaxis\/","email":"communication@tour-taxis.com","phone_contact":"+32 2 882 10 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700002050"}},"place":{"id":222762,"translations":{"de":{"name":"Tour & Taxis","address_street_name":"Avenue du Port","address_street_number":"86c","address_street_box":null,"email":null,"website":"http:\/\/www.tour-taxis.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue du Port, 86c","address_line2":"1000 Bruxelles","description_web":"Die ehemalige Logistikplattform mit Zolldepot Tour & Taxis, die Anfang des 20. Jahrhunderts erbaut und intensiv genutzt wurde, bietet eine ganze Reihe eindrucksvoller Geb\u00e4ude von hoher architektonischer Qualit\u00e4t: Entrep\u00f4t Royal, Sheds, H\u00f4tel des Douanes, H\u00f4tel de la Poste und Gare Maritime. Unter Ber\u00fccksichtigungen der urspr\u00fcnglichen Architektur und des besonderen historischen Wertes erhielt das Geb\u00e4ude nun eine zeitgem\u00e4\u00dfe Neuinterpretation und erf\u00fcllt inzwischen mehrere Aufgaben: Ausstellungen, Veranstaltungen, Arbeitsbereiche, Gesch\u00e4ftsr\u00e4ume, Dienstleistungen...\r\n\r\nDie Gr\u00fcnfl\u00e4chen und der sich entwickelnde Park als Orte der Entspannung und Unterhaltung sind zentrale Elemente des neuen Konzepts.\r\n\r\nDas industrielle Erbe von Tour & Taxis k\u00f6nnen Sie auch \u00fcber die App mit Audio-Guide, Karte und Fotos entdecken. Laden Sie die kostenlose App \u00fcber den folgenden Link herunter: www.tt-app.be\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Tour & Taxis","address_street_name":"Avenue du Port","address_street_number":"86c","address_street_box":null,"email":null,"website":"http:\/\/www.tour-taxis.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue du Port, 86c","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Tour & Taxis","address_street_name":"Avenue du Port","address_street_number":"86c","address_street_box":null,"email":null,"website":"http:\/\/www.tour-taxis.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Avenue du Port, 86c","address_line2":"1000 Brussels","description_web":"The historical logistics platform of Tour & Taxis presents a number of buildings of exceptional size and architectural value: the Royal Depot, the Sheds, the H\u00f4tel des Douanes, the H\u00f4tel de la Poste and the Gare Maritime. A modern interpretation is given to the historic buildings on the Tour & Taxis site, with great respect for their authenticity and heritage value.\r\nThe site is ideally located on the tourist routes, between the Brussels old city centre and other tourist attactions such as the Atomium.\r\nThe green areas and the evolutionary park are central features and an inherent part of the philosophy behind the Tour & Taxis development.\r\nTour & Taxis is becoming a reinvented neighbourhood with residences, culture, offices and public services all in one, creating a positive alternative for people looking for new experiences. The Sheds welcome different major events including antique and art fairs.\r\nWith eateries, bars and activities on the site, there\u2019s something to suit everyone\u2019s taste.\r\n\r\nTour & Taxis offers you the chance to discover the industrial heritage of this unique site using our App, which comprises of an audio guide working together with historic photos. You can download our App for free at: www.tt-app.be","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Tour & Taxis","address_street_name":"Avenue du Port","address_street_number":"86c","address_street_box":null,"email":null,"website":"http:\/\/www.tour-taxis.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue du Port, 86c","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Tour & Taxis","address_street_name":"Avenue du Port","address_street_number":"86c","address_street_box":null,"email":null,"website":"http:\/\/www.tour-taxis.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue du Port, 86c","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Tour & Taxis","address_street_name":"Avenue du Port","address_street_number":"86c","address_street_box":null,"email":null,"website":"http:\/\/www.tour-taxis.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue du Port, 86c","address_line2":"1000 Bruxelles","description_web":"L\u2019ancienne plateforme logistique de Tour & Taxis datant du d\u00e9but du 20\u00e8me si\u00e8cle offre des immeubles d\u2019envergure et d\u2019une haute qualit\u00e9 architecturale : l\u2019Entrep\u00f4t Royal, les Sheds, l\u2019H\u00f4tel des Douanes, l\u2019H\u00f4tel de la Poste et la Gare Maritime. Tout en respectant leur authenticit\u00e9 et leur valeur historique, une r\u00e9interpr\u00e9tation contemporaine est donn\u00e9e \u00e0 ces immeubles h\u00e9rit\u00e9s du si\u00e8cle pass\u00e9. Ils connaissent d\u00e9sormais des affectations multiples : expositions, \u00e9v\u00e9nements, espaces de travail, espaces commerciaux, services...\r\nLe site est id\u00e9alement situ\u00e9 sur le parcours touristique bruxellois, entre la vieille ville (Grand-Place, Manneken Pis \u2026) et d\u2019autres attractions touristiques telles que l\u2019Atomium.\r\nLes espaces verts et le parc \u00e9volutif sont des \u00e9l\u00e9ments centraux et inh\u00e9rents \u00e0 la philosophie de d\u00e9veloppement. Ils offrent des lieux de d\u00e9tente et de divertissement.\r\nTour & Taxis devient donc un quartier multifonctionnel r\u00e9invent\u00e9 avec des logements, de la culture, des espaces de travail, cr\u00e9ant une alternative positive pour les visiteurs \u00e0 la recherche de nouvelles exp\u00e9riences.\r\nDans un cadre inspirant, les Sheds accueillent des \u00e9v\u00e9nements incontournables et attirent de nombreux visiteurs.\r\nGr\u00e2ce aux diff\u00e9rents restaurants, bars et activit\u00e9s sur le site, il y a toujours une exp\u00e9rience \u00e0 vivre.\r\n\r\nT&T vous propose de d\u00e9couvrir l\u2019h\u00e9ritage industriel du site \u00e0 l\u2019aide de l\u2019App avec audio-guide, plan et photos. T\u00e9l\u00e9chargez l\u2019App gratuitement via le lien suivant : www.tt-app.be\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Tour & Taxis","address_street_name":"Avenue du Port","address_street_number":"86c","address_street_box":null,"email":null,"website":"http:\/\/www.tour-taxis.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue du Port, 86c","address_line2":"1000 Bruxelles","description_web":"La hist\u00f3rica plataforma log\u00edstica de Tour & Taxis presenta un n\u00famero de edificios de gran envergadura y valor arquitect\u00f3nico: Royal Depot, Sheds, H\u00f4tel des Douanes, H\u00f4tel de la Poste y Gare Maritime. Se le da una interpretaci\u00f3n moderna a los edifcios hist\u00f3ricos de Tour & Taxis, respetando su autenticidad y valor patrimonial.\r\nEl lugar est\u00e1 idealmente localizado en las rutas tur\u00edsticas, entre la parte antigua de la ciudad y otros lugares de inter\u00e9s tur\u00edstico tales como el Atomium.\r\nLas zonas verdes y el parque, que est\u00e1 en constante evoluci\u00f3n, son las principales caracter\u00edsticas y una parte inherente de la filosof\u00eda que hay detr\u00e1s del desarrollo de Tour & Taxis.\r\nTour & Taxis se est\u00e1 convirtiendo en un nuevo vecindario con residencias, cultura, oficinas y servicios p\u00fablicos todo en uno, creando una alternativa positiva para aquella gente que busca nuevas experiencias. El edificio Sheds acoge diferentes eventos de gran envergadura, incluyendo ferias de arte y antig\u00fcedades.\r\n\u00a1En los restaurantes, bares y actividades que hay en el lugar encontrar\u00e1s cosas para todos los gustos!\r\n\r\nTour & Taxis te ofrece la oportunidad de descubrir el patrimonio industrial de este lugar \u00fanico usando nuestra aplicaci\u00f3n, que incluye una audiogu\u00eda junto con fotos hist\u00f3ricas. Puedes descargar la aplicaci\u00f3n de manera gratuita aqu\u00ed: www.tt-app.be\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Tour & Taxis","address_street_name":"Havenlaan","address_street_number":"86c","address_street_box":null,"email":null,"website":"http:\/\/www.tour-taxis.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Havenlaan, 86c","address_line2":"1000 Brussel","description_web":"Het voormalige logistieke platform van Tour & Taxis uit de vroege jaren van de 20e eeuw  bestaat uit gebouwen met hoge architectonische kwaliteit: het Koninklijk Pakhuis, de Sheds, het H\u00f4tel des Douanes, het H\u00f4tel de la Poste en de Gare Maritime zijn stuk voor stuk erfgoedparels.  Dit patrimonium kreeg met respect  voor historische waarde en oog voor authenticiteit een nieuwe eigentijdse invulling met  tentoonstellingen, evenementen, kantoren, coworking, retail, services ...\r\nDe site sluit nauw aan bij het toeristisch parcours tussen het historische stadscentrum (Grote Markt, Manneken Pis ...) en andere bezienswaardigheden zoals het Atomium. Het bevindt zich ook op wandelafstand van het toekomstige nieuwe museum voor moderne en hedendaagse kunst.\r\nDe groene ruimtes en het moderne park bieden ruimte aan ontspanning en vrijetijdsactiviteiten.\r\nTour & Taxis wordt een vooruitstrevende participatieve wijk met woningen, cultuur, workspaces, food hall \u2026 die een uitvalsbasis vormt voor de bezoekers op zoek naar nieuwe ervaringen. Zo vinden er in de Sheds uiteenlopende topbeurzen plaats. Dankzij die grote diversiteit aan activiteiten, restaurants, bars en talloze andere activiteiten op de site valt er steeds iets te beleven.\r\n\r\nTour&Taxis biedt u de mogelijkheid om het industrieel patrimonium van de site te ontdekken aan de hand van een App met audio-guide en foto\u2019s. U kunt de App gratis downloaden op: www.tt-app.be\r\n \r\n ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[8],"translations":{"de":["Kanal-Viertel"],"pt":[null],"en":["Canal"],"it":["Canal"],"cn":[null],"fr":["Canal"],"sp":["Canal"],"nl":["Kanaalwijk"]}},"zones":{"list":[20],"translations":{"de":["Norden"],"pt":[null],"en":["North"],"it":["Nord"],"cn":[null],"fr":["Nord"],"sp":["Norte"],"nl":["Noord"]}},"neca":null,"facebook_id":null,"backoffice_id":658,"location":{"lat":50.86573978,"lon":4.3509828},"region":"brussels","last_updated_at":"2023-10-02T11:55:29+02:00","published_at":"2013-10-19T01:13:42+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":262737,"translations":{"de":{"name":"Tour & Taxis Venues","address_street_name":"Avenue du Port","address_street_number":"86 c","address_street_box":null,"email":"welcome@tour-taxis.com","website":"http:\/\/www.tour-taxis.com\/meet-and-organise\/","phone_contact":"+32 2 421 50 02","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue du Port, 86 c","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Tour & Taxis Venues","address_street_name":"Avenue du Port","address_street_number":"86 c","address_street_box":null,"email":"welcome@tour-taxis.com","website":"http:\/\/www.tour-taxis.com\/meet-and-organise\/","phone_contact":"+32 2 421 50 02","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue du Port, 86 c","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Tour & Taxis Venues","address_street_name":"Avenue du Port","address_street_number":"86 c","address_street_box":null,"email":"welcome@tour-taxis.com","website":"http:\/\/www.tour-taxis.com\/meet-and-organise\/","phone_contact":"+32 2 421 50 02","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Avenue du Port, 86 c","address_line2":"1000 Brussels","description_web":"BRUSSELS' EVENT HUB - WHERE INTERACTION IS PARAMOUNT AND WHERE STORIES ARE CREATED\r\nThis industrial heritage site where ironworks once facilitated the transportation of goods, now promises exciting new horizons. Tour & Taxis is a complete makeover of late 19th- early 20th century shipping and customs warehouses and goods train station. Its offer of multiple upscale adjacent event spaces \u2013 each with their different atmosphere, being for 2 or for 10.000 guests \u2013 includes Maison de la Poste, The Sheds, Produits Dangereux, Gare Maritime, Place de la Musique and Quai aux Poissons. \r\n\r\nCongresses, conferences, meetings, trainings, receptions and dinners, exhibitions and fairs, festivals, product launches and other events besides\u2026 memorable events happen here! \r\n\r\nTour & Taxis aim is to provide a safe environment that is as welcoming as it is committed to sustainability, inclusivity, and accessibility. The huge multi-purpose pedestrian area is designed for the future, but with the charm of the past \u2013 a heritage to be claimed by many future generations.  \r\n\r\nView our Covid-19 measures: https:\/\/tour-taxis.com\/meet-and-organise\/covid-19-measures\/ ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":"https:\/\/www.youtube.com\/watch?v=YMTYGKDXuow","visit_url":null},"it":{"name":"Tour & Taxis Venues","address_street_name":"Avenue du Port","address_street_number":"86 c","address_street_box":null,"email":"welcome@tour-taxis.com","website":"http:\/\/www.tour-taxis.com\/meet-and-organise\/","phone_contact":"+32 2 421 50 02","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue du Port, 86 c","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Tour & Taxis Venues","address_street_name":"Avenue du Port","address_street_number":"86 c","address_street_box":null,"email":"welcome@tour-taxis.com","website":"http:\/\/www.tour-taxis.com\/meet-and-organise\/","phone_contact":"+32 2 421 50 02","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue du Port, 86 c","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Tour & Taxis Venues ","address_street_name":"Avenue du Port","address_street_number":"86 c","address_street_box":null,"email":"welcome@tour-taxis.com","website":"http:\/\/www.tour-taxis.com\/meet-and-organise\/","phone_contact":"+32 2 421 50 02","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue du Port, 86 c","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":"https:\/\/www.youtube.com\/watch?v=YMTYGKDXuow","visit_url":null},"sp":{"name":"Tour & Taxis Venues","address_street_name":"Avenue du Port","address_street_number":"86 c","address_street_box":null,"email":"welcome@tour-taxis.com","website":"http:\/\/www.tour-taxis.com\/meet-and-organise\/","phone_contact":"+32 2 421 50 02","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue du Port, 86 c","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Tour & Taxis Venues","address_street_name":"Havenlaan","address_street_number":"86 c","address_street_box":null,"email":"welcome@tour-taxis.com","website":"http:\/\/www.tour-taxis.com\/meet-and-organise\/","phone_contact":"+32 2 421 50 02","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Havenlaan, 86 c","address_line2":"1000 Brussel","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":"https:\/\/www.youtube.com\/watch?v=YMTYGKDXuow","visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":22737,"location