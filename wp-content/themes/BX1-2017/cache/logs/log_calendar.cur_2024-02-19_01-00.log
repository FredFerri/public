l_visit":null,"visit_url":null},"sp":{"name":"Wiels - Centro de arte contempor\u00e1neo","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+ 32 (0)2-340.00.50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":"Fue el amante de la cerveza L\u00e9on Wielemans quien le pidi\u00f3 a su amigo, el arquitecto Adrien Blomme, dise\u00f1ar y construir los nuevos edificios para su cervecer\u00eda en Forest. Se convirti\u00f3 en el monumento m\u00e1s importante de arqueolog\u00eda industrial en estilo art d\u00e9co, y ahora alberga Wiels, un laboratorio internacional para la creaci\u00f3n y difusi\u00f3n de arte contempor\u00e1neo. Poniendo el foco en las artes visuales, pero garantizando una particular atenci\u00f3n en el cruce y las interacciones con otras disciplinas, el centro pretende mostrar el arte contempor\u00e1neo en todos sus sentidos y ofrecer un di\u00e1logo permanente con su desarrollo y los debates m\u00e1s recientes del mundo del arte.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Wiels - Centrum voor hedendaagse kunst","address_street_name":"Van Volxemlaan","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+ 32 (0)2-340.00.50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Van Volxemlaan, 354","address_line2":"1190 Forest","description_web":"Wiels is een toonaangevend internationaal platform voor de creatie en presentatie van hedendaagse kunst. Het centrum ontwikkelt een programma van tijdelijke activiteiten, zonder een permanente collectie uit te bouwen. Wiels organiseert zes tot acht grote tentoonstellingen per jaar die de evoluties in hedendaagse kunst op de voet volgen. Daarnaast loopt er een residentie en educatief programma en worden er lezingen, films, performances, debatten, ontmoetingen georganiseerd. Het kunstcentrum heeft een shop, een caf\u00e9 en een dakterras met een indrukwekkend uitzicht over de stad. ","description_print":null,"booking_url":null,"sort_order":"WIELS - CONTEMPORARY ART CENTRE","virtual_visit":null,"visit_url":null}},"neca":"art_center","facebook_id":"https:\/\/www.facebook.com\/WielsBrussels","region":"brussels","backoffice_id":195,"location":{"lat":50.82467444,"lon":4.32636558},"last_updated_at":"2023-05-02T15:20:32+02:00","published_at":"2013-10-19T01:13:21+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/7bdc650bcc10d1c506436bba851b1179e9bd2030.JPG","width":2374,"height":1583,"ratio":1.5,"oEmbed_height":1583,"oEmbed_width":2374,"translations":{"de":{"title":"Nocturnes","copyright":"Camille Schang"},"pt":{"title":"Nocturnes","copyright":"Camille Schang"},"en":{"title":"Nocturnes","copyright":"Camille Schang"},"it":{"title":"Nocturnes","copyright":"Camille Schang"},"cn":{"title":"Nocturnes","copyright":"Camille Schang"},"fr":{"title":"Nocturnes","copyright":"Camille Schang"},"sp":{"title":"Nocturnes","copyright":"Camille Schang"},"nl":{"title":"Nocturnes","copyright":"Camille Schang"}}}],"dates":[{"day":"2024-02-07","doors":null,"start":"18:00:00","end":"21:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-03-06","doors":null,"start":"18:00:00","end":"21:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-04-03","doors":null,"start":"18:00:00","end":"21:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-05-01","doors":null,"start":"18:00:00","end":"21:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-07-03","doo