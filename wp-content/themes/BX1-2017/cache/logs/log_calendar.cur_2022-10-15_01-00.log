acebook_id":null,"backoffice_id":39452,"location":{"lat":50.81995643,"lon":4.39044418},"region":"brussels","last_updated_at":"2022-10-11T05:05:40+02:00","published_at":"2022-10-02T14:56:33+02:00","import_origin":null,"external_id":null,"is_in_address_book":false,"is_in_vb_export":false,"resto_ranking":0},"media":[],"dates":[{"day":"2022-10-16","doors":null,"start":"11:00:00","end":"12:00:00","is_soldout":false,"is_canceled":false},{"day":"2022-10-16","doors":null,"start":"15:00:00","end":"16:00:00","is_soldout":false,"is_canceled":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"visit_profile":{"list":[328],"translations":{"fr":["Vert & durable"],"nl":["Groen & duurzaam"],"en":["Green & sustainable"],"de":["Gr\u00fcn & nachhaltig"]}},"tags":["exterior"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-11T05:05:41+02:00","published_at":"2022-10-03T10:27:42+02:00","backoffice_id":262925,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":1},{"id":541720,"date_start":"2022-10-16","date_end":"2022-10-16","date_next":"2022-10-16","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen"}},"others":{"list":[251],"translations":{"fr":["Art Contemporain "],"nl":["Hedendaagse Kunst"],"en":["Contemporary Art"],"de":["Zeitgen\u00f6ssische Kunst "]}}},"languages":{"spoken":["nl","fr"],"subtitles":[]},"translations":{"fr":{"name":"Explore1190 - Street art \u00e0 Forest","shortdescr":"P\u00e9dalez avec nous le long de notre parcours de street-art \u00e0 Forest ! Nous partons \u00e0 v\u00e9lo du parc Marconi dans le haut de Forest jusqu'\u00e0 la gare de Forest-Midi. En chemin, nous nous arr\u00eaterons devant diff\u00e9rents oeuvres de street-art \u00e0 Forest.","longdescr":"Le street-art prend son essor dans toutes les grandes villes, et il n'en va pas autrement dans la commune de Forest. Depuis 2017, dans le cadre de projets de d\u00e9veloppement de quartiers durables, les artistes de rue ont \u00e9galement de plus en plus souvent la possibilit\u00e9 d'\u00e9gayer un quartier, souvent avec une peinture murale ou une installation qui refl\u00e8te l'atmosph\u00e8re du quartier. Nous avons d\u00e9velopp\u00e9 un parcours le long de diff\u00e9rents oeuvres que vous pourrez d\u00e9couvrir lors de cette visite guid\u00e9e \u00e0 v\u00e9lo le dimanche 16 octobre.\r\n\r\n    D\u00e9part 14:00 Parc Marconi (Chauss\u00e9e d'Alsemberg 296, 1190 Forest)\r\n    Fin 17:00: Gare de Forest-Midi\r\n    La visite est gratuite et organis\u00e9e en coop\u00e9ration avec la commune de Forest.\r\n    Langue: Nederlands\/Fran\u00e7ais\r\n    Inscriptions: info@cactus.brussels","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.541720"},"nl":{"name":"Explore1190 - Street art in Vorst","shortdescr":"Fiets mee langs ons street-art parcours in Vorst! We fietsen van het Marconipark in Hoog-Vorst  naar beneden tot aan het station Vorst-Zuid. Onderweg houden we halt bij verschillende street-art parels in de gemeente Vorst.","longdescr":"Ontdek street art in Vorst met de fiets!\r\n\r\nIn alle grote steden neemt street art een grote vlucht vooruit, dat is in de Brusselse gemeente Vorst niet anders. Sinds 2017 krijgen straatkunstenaars in het kader van duurzame wijkontwikkelingsprojecten ook steeds vaker de kans om een buurt op te fleuren, vaak met een muurschildering of installatie die de sfeer van de wijk weergeeft. Wij ontwikkelden een parcours langs verschillende werken dat je tijdens het laatste weekend van november kan ontdekken!\r\n\r\nPraktisch: \r\n\r\n    Start 14:00: Marconipark (Alsembergsesteenweg 296, 1190 Vorst)\r\n    Einde 17:00: station Vorst-Zuid\r\n    De tours zijn gratis en georganiseerd i.s.m. de gemeente Vorst. \r\n    Gidstaal: Nederlands\/Frans\r\n    Inschrijven: info@cactus.brussels","performers":null,"boxoffice_url":null,"website":"http:\/\/www.cactus.brussels","email":"info@cactus.brussels","phone_contact":null,"phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.541720"},"en":{"name":"Explore1190 - Street art in Vorst","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.541720"},"de":{"name":"Explore1190 - Street art in Vorst","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.541720"},"it":{"name":"Explore1190 - Street art in Vorst","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.541720"},"sp":{"name":"Explore1190 - Street art in Vorst","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.541720"},"pt":{"name":"Explore1190 - Street art in Vorst","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.541720"},"cn":{"na