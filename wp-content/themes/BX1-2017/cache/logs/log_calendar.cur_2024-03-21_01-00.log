you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-03-07T10:30:06+01:00","published_at":"2023-11-24T12:20:14+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":289387,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"festival","ranking":0.6933612743506347,"languages":{"spoken":["en","fr","nl"],"subtitles":[]},"categories":{"main":{"id":118,"translations":{"de":"Festival","pt":null,"en":"Festival","it":"Festival","cn":null,"fr":"Festival","sp":"Festival","nl":"Festival"}},"others":{"list":[126],"translations":{"de":["Zeitgen\u00f6ssische Musik"],"pt":[null],"en":["Contemporary music"],"it":["Musica contemporanea"],"cn":[null],"fr":["Musique Contemporaine"],"sp":["M\u00fasica contempor\u00e1nea"],"nl":["Hedendaagse Muziek"]}}},"translations":{"de":{"name":"Listen Festival 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.listenfestival.be\/","email":"info@listenfestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50004708"},"pt":{"name":"Listen Festival 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.listenfestival.be\/","email":"info@listenfestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50004708"},"en":{"name":"Listen Festival 2024","shortdescr":"Listen Festival 2024 will take place all-over the city of Brussels from Tuesday 26th until Sunday 31st of March 2024. During the course of 6 days and nights, the festival will be exploring the major music hot-spots and some unique off-locations with a captivating programme. ","longdescr":"Listen Festival 2024 will take place all-over the city of Brussels from Tuesday 26th until Sunday 31st of March 2024. For its upcoming edition, Listen has once again assembled a unique combination of cutting-edge local and international artists in collaboration with a variety of local curators. During the course of 6 days and nights, the festival will be exploring the major music hot-spots and some unique off-locations with a captivating programme. The majority of the events for Listen 2024 have now been announced with more events and activities to follow shortly. \n\nListen continues with its proven recipe of working with the most exciting curators and venues and drawing influence from all angles of Brussels\u2019 music scene. The first curators for this year's edition include the likes of Botanique, Flagey, Bozar, La Cabane,  Not Your Techno, Spek, Gay Haze, Local Slang, Breaxx, AliA, Le Motel, Mo Mamba, Sono Ventura Records, Soulful Sessions, Magma and many more.\n\nListen takes pride in being an eclectic festival, showcasing the diversity of the electronic music scene with concerts and club nights spanning from Hip-hop to House and from Techno to all-round global sounds. By bringing together collectives, labels and curators, Listen is connecting the dots regardless of musical style and orientation. Artists for Listen 2024 include: Marina Herlop, Nala Sinephro, AliA B2B Le Motel, Bitter Babe, CJ Bolland B2B Nosedrip, VTSS, LSDXOXO, George Riley, Deli Girls, Hector Oaks, Emily Jeanne, Crystalmess, Ikonika, Blck Mamba, Lefto Early Bird \u2018live\u2019, dBridge, Lefto Early Bird, Donia, Bona L\u00e9a, DC Salas and many more. ","performers":null,"boxoffice_url":null,"website":"https:\/\/www.listenfestival.be\/","email":"info@listenfestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50004708"},"it":{"name":"Listen Festival 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.listenfestival.be\/","email":"info@listenfestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50004708"},"cn":{"name":"Listen Festival 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.listenfestival.be\/","email":"info@listenfestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50004708"},"fr":{"name":"Listen Festival 2024","shortdescr":"Listen Festival 2024 se d\u00e9roulera du mardi 26 au dimanche 31 mars 2024 \u00e0 Bruxelles. Pendant six jours et six nuits, le festival explorera les principaux points chauds de la musique et quelques lieux uniques hors des sentiers battus avec un programme passionnant.\n","longdescr":"Listen Festival 2024 se d\u00e9roulera du mardi 26 au dimanche 31 mars 2024 \u00e0 Bruxelles. Pour l'\u00e9dition de l'ann\u00e9e prochaine, Listen a une fois de plus rassembl\u00e9 une combinaison unique des meilleurs artistes locaux et internationaux en collaboration avec une vari\u00e9t\u00e9 de curateurs locaux. Pendant six jours et six nuits, le festival explorera les principaux points chauds de la musique et quelques lieux uniques hors des sentiers battus avec un programme passionnant.\n\nComme chaque ann\u00e9e, Listen continue de travailler avec les commissaires et les lieux les plus int\u00e9ressants et, en tant que festival, s'inspire de tous les coins de la sc\u00e8ne musicale bruxelloise. Les premiers curateurs de l'\u00e9dition de cette ann\u00e9e sont Botanique, Flagey, Bozar, La Cabane, Not Your Techno, Spek, Gay Haze, Local Slang, Breaxx, AliA, Le Motel, Mo Mamba, Sono Ventura Records, Soulful Sessions, Magma et bien d'autres encore.\n\nListen est fier d'\u00eatre un festival \u00e9clectique, mettant en valeur la diversit\u00e9 de la sc\u00e8ne musicale \u00e9lectronique avec des concerts et des soir\u00e9es club allant du Hip-hop \u00e0 la House et de la Techno aux sons globaux. En r\u00e9unissant des collectifs, des labels et des curateurs, Listen fait le lien entre plusieurs styles musicaux. Parmi les premiers artistes annonc\u00e9s pour Listen 2024, on trouve : Marina Herlop, Nala Sinephro, AliA B2B Le Motel, Bitter Babe, CJ Bolland B2B Nosedrip, VTSS, LSDXOXO, George Riley, Deli Girls, Hector Oaks, Emily Jeanne, Crystalmess, Ikonika, Blck Mamba, Lefto Early Bird 'live', dBridge, Lefto Early Bird, Donia, Bona L\u00e9a, DC Salas et bien d'autres encore.\n\n\n","performers":null,"boxoffice_url":null,"website":"https:\/\/www.listenfestival.be\/","email":"info@listenfestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50004708"},"sp":{"name":"Listen Festival 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.listenfestival.be\/","email":"info@listenfestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50004708"},"nl":{"name":"Listen Festival 2024","shortdescr":"Listen Festival 2024 vindt plaats van dinsdag 26 tot en met zondag 31 maart 2024 verspreid over heel Brussel. Gedurende 6 dagen en nachten zal het festival de belangrijkste muziek hot-spots en een aantal unieke off-locaties verkennen met een boeiend programma. \n","longdescr":"Listen Festival 2024 vindt plaats van dinsdag 26 tot en met zondag 31 maart 2024 verspreid over heel Brussel. Voor de editie van volgend jaar heeft Listen opnieuw een unieke combinatie samengesteld van de beste lokale en internationale artiesten in samenwerking met een verscheidenheid aan lokale curatoren. Gedurende 6 dagen en nachten zal het festival de belangrijkste muziek hot-spots en een aantal unieke off-locaties verkennen met een boeiend programma. De eerste namen en events voor Listen 2024 zijn nu aangekondigd en meer evenementen en activiteiten volgen binnenkort.\n\nZoals elk jaar blijft Listen werken met de meest opwindende curatoren en locaties en haalt het als festival  inspiratie uit alle hoeken van de Brusselse muziekscene. De eerste curatoren voor de editie van dit jaar zijn onder andere Botanique, Flagey, Bozar, La Cabane, Not Your Techno, Spek, Gay Haze, Local Slang, Breaxx, AliA, Le Motel, Mo Mamba, Sono Ventura Records, Soulful Sessions, Magma en nog veel meer.\n\nListen is er trots op een eclectisch festival te zijn, dat de diversiteit van de elektronische muziekscene laat zien met concerten en clubnachten die vari\u00ebren van Hip-hop tot House en van Techno tot allround global sounds. Door collectieven, labels en curatoren samen te brengen, verbindt Listen verscheidene muzikale stijlen. Bij de eerste aankondiging van artiesten voor Listen 2024 vinden we onder andere: Marina Herlop, Nala Sinephro, AliA B2B Le Motel, Bitter Babe, CJ Bolland B2B Nosedrip, VTSS, LSDXOXO, George Riley, Deli Girls, Hector Oaks, Emily Jeanne, Crystalmess, Ikonika, Blck Mamba, Lefto Early Bird 'live', dBridge, Lefto Early Bird, Donia, Bona L\u00e9a, DC Salas en nog veel meer.\n","performers":null,"boxoffice_url":null,"website":"https:\/\/www.listenfestival.be\/","email":"info@listenfestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50004708"}},"place":{"id":245448,"translations":{"de":{"name":"Divers lieux \u00e0 Bruxelles","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Divers lieux \u00e0 Bruxelles","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Divers lieux \u00e0 Bruxelles","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone