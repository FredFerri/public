t":null}},"neca":null,"facebook_id":null,"backoffice_id":9493,"location":{"lat":50.84352692,"lon":4.34863877},"region":"brussels","last_updated_at":"2022-10-11T02:36:25+02:00","published_at":"2013-10-19T01:26:14+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":false,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/7db67eaac88602bc21b21db8ccf9e116fbc9eb3e.jpg","width":1024,"height":616,"ratio":1.66,"translations":{"fr":{"title":"Rencontre avec Zainab Fasiki","copyright":null},"nl":{"title":"Rencontre avec Zainab Fasiki","copyright":null},"en":{"title":"Rencontre avec Zainab Fasiki","copyright":null}}},{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/19dba68fc4c43db1ab0e05f2f6d3c2268dc72f2c.jpg","width":2504,"height":3534,"ratio":0.71,"translations":{"fr":{"title":"Rencontre avec Zainab Fasiki","copyright":null},"nl":{"title":"Rencontre avec Zainab Fasiki","copyright":null},"en":{"title":"Rencontre avec Zainab Fasiki","copyright":null}}}],"dates":[{"day":"2022-10-25","doors":"19:00:00","start":"20:00:00","end":null,"is_soldout":false,"is_canceled":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":{"list":[255,256,259,263,265,266],"translations":{"fr":["Accessible","Am\u00e9nagements pour les personnes aveugles et malvoyantes","Chien d'assistance","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9","Brussels Health Safety Label"],"nl":["Toegankelijk","Voorzieningen voor blinde en slechtziende personen","Assistentiehonden","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet","Brussels Health Safety Label"],"en":["Accessible","Facilities for blind and partially-sighted persons","Assistance dogs","Accessible to pedestrians with mobility aids","Adapted toilet","Brussels Health Safety Label"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-11T02:36:25+02:00","published_at":"2022-07-12T16:01:52+02:00","backoffice_id":258291,"import_origin":null,"sub_type":"misc","show_in_agenda":true,"ranking":1.2599210498949},{"id":540679,"date_start":"2022-10-25","date_end":"2022-11-06","date_next":"2022-10-25","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung"}},"others":{"list":[24,27],"translations":{"fr":["Galeries d'art","Photographie"],"nl":["Galeries","Fotografie"],"en":["Art Galleries","Photography"],"de":["Kunstgalerien","Fotografie"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"House of Souls","shortdescr":"House of Souls est une exposition photographique et immersive sur le deuil p\u00e9rinatal, une exploration intime du parcours de femmes et d\u2019hommes confront\u00e9s \u00e0 une fausse couche ou \u00e0 une mort in ut\u00e9ro. En cr\u00e9ant une alc\u00f4ve o\u00f9 la photographie sert de tremplin \u00e0 la circulation de leurs paroles, je nous invite toutes et tous \u00e0 nous confronter \u00e0 la r\u00e9alit\u00e9 de ces \u00e9v\u00e8nements.","longdescr":"Depuis que je suis tr\u00e8s jeune, je suis comme envo\u00fbt\u00e9e par les ventres. Cette r\u00e9gion cach\u00e9e derri\u00e8re le nombril, cet espace central du corps, o\u00f9 tout commence. \r\nLe ventre, l\u2019image de la vie par excellence, o\u00f9 la vie appara\u00eet, parfois miraculeusement, puis grandit ou disparait. \r\n\r\nPour les femmes et aussi pour les hommes, le ventre, le sacral, repr\u00e9sente l\u2019\u00e9nergie vitale. C\u2019est le lieu des \u00e9motions qu\u2019on montre, crie, d\u00e9voile, garde enfouies. Certains l\u2019appellent le \u00ab deuxi\u00e8me cerveau \u00bb : reflet de nous-m\u00eames, de notre histoire pass\u00e9e, de nos blessures. Il d\u00e9tient la m\u00e9moire du corps, de ce corps, de notre corps. Un esprit peut oublier mais notre corps n\u2019oublie jamais. Ce ventre est pour moi comme l\u2019encre ind\u00e9l\u00e9bile de notre vie, de notre pass\u00e9, de nos blessures, de nos forces. C\u2019est un v\u00e9ritable miroir de ce que nous sommes, voulons \u00eatre. \r\n\r\nNotre maison de l\u2019\u00e2me.\r\n\r\nJe pense depuis plusieurs ann\u00e9es \u00e0 cr\u00e9er un projet photographique autour de ce que j\u2019appelle \u201cHouse of Souls\u201d - la maison des \u00e2mes. Il y a quelques mois, l\u2019appel de ces ventres est venu me rattraper d\u2019une fa\u00e7on visc\u00e9rale alors que j\u2019ai fait une fausse couche. La sensation primaire de vie s\u2019est confront\u00e9e pour la premi\u00e8re fois brutalement \u00e0 celle de la mort. Dans un bout de moi, quelque chose s\u2019est rompu. Quelque chose qui, je le sens intimement, me suivra pour toujours. Tr\u00e8s vite, des questions sont venues me chambouler ; elles sont intimement li\u00e9es \u00e0 l\u2019envie de donner vie \u00e0 ce projet d\u2019exposition.","performers":"un projet de Rose Denis & de l'asbl Loup avec l'aide de Nastasja Saerens, Charlotte Cristin, Ayrton Heymans, Guillaume Jacquart, Hugo Corson","boxoffice_url":null,"website":"http:\/\/www.seaofclouds.be\/houseofsouls","email":"loupasbl@gmail.com","phone_contact":null,"phone_booking":"+32 483 32 17 66","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.540679"},"nl":{"name":"House of Souls","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"rosedenis.pro@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.540679"},"en":{"name":"House of Souls","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"em