cept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen","it":"Visite guidate","sp":"Visitas guiadas","pt":null,"cn":null}},"others":{}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Un quartier Art D\u00e9co \u00e0 \u00e0 Anderlecht","shortdescr":null,"longdescr":"Le quartier du Meir \u00e0 Anderlecht est la plus grande op\u00e9ration urbanistique qu\u2019ait connue Anderlecht, depuis la cr\u00e9ation du quartier de Cureghem \u00e0 la fin du 19e si\u00e8cle. D\u00e9cid\u00e9 peu avant la premi\u00e8re guerre mondiale, l\u2019am\u00e9nagement de ce nouveau quartier r\u00e9sidentiel se fera essentiellement dans l\u2019entre-deux guerres. Imagin\u00e9 autour d\u2019un large rond-point et d\u2019un parc, le parc Astrid, et destin\u00e9 \u00e0 la classe moyenne il forme un ensemble architectural extr\u00eamement coh\u00e9rent et bien conserv\u00e9 o\u00f9 pr\u00e9domine le style Art D\u00e9co. La maison individuelle s\u2019y retrouve sous toutes ses formes et l\u2019immeuble \u00e0 appartements ponctue les rues de ce quartier vert et a\u00e9r\u00e9. Les fa\u00e7ades aux d\u00e9cors ornement\u00e9s offrent un beau panorama des diff\u00e9rentes tendances de l\u2019architecture Art D\u00e9co. Cette visite est l\u2019occasion de d\u00e9couvrir les richesses insoup\u00e7onn\u00e9es d\u2019un quartier m\u00e9connu qui accueille pourtant des r\u00e9alisations d\u2019architectes tels qu\u2019Antoine Courtens, Fernand Brunfaut ou encore L\u00e9on Sneyers.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.arau.org","email":"info@arau.org","phone_contact":null,"phone_booking":nu