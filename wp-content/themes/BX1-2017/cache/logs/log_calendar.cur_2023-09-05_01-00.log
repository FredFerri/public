/event-detail.50000953"},"pt":{"name":"Les arbres comme joyeux compagnons","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/famefestival.be\/fr\/fame-event\/arbres-compagnons\/","email":"info@famefestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50000953"},"en":{"name":"Les arbres comme joyeux compagnons","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/famefestival.be\/fr\/fame-event\/arbres-compagnons\/","email":"info@famefestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50000953"},"it":{"name":"Les arbres comme joyeux compagnons","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/famefestival.be\/fr\/fame-event\/arbres-compagnons\/","email":"info@famefestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50000953"},"cn":{"name":"Les arbres comme joyeux compagnons","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/famefestival.be\/fr\/fame-event\/arbres-compagnons\/","email":"info@famefestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50000953"},"fr":{"name":"Les arbres comme joyeux compagnons","shortdescr":"Une rencontre avec des arbres majestueux dans la For\u00eat de Soignes, un lieu o\u00f9 les arbres sont chez eux depuis l'\u00e8re glaciaire.","longdescr":"Chaque minute, nous inspirons et expirons plusieurs fois. C\u2019est le mouvement le plus naturel que nous fassions, \u00e0 tel point que nous l\u2019oublions. Nous oublions aussi que si nous pouvons respirer, c\u2019est gr\u00e2ce aux arbres de cette plan\u00e8te. L\u2019oxyg\u00e8ne est le d\u00e9chet naturel des arbres, et notre d\u00e9chet naturel \u2013 le dioxyde de carbone \u2013 nourrit les arbres. Les arbres sont \u00e9galement la solution la plus naturelle au changement climatique. En bref, nous vivons dans une relation de d\u00e9pendance continue avec les arbres. Au cours de cette promenade, nous rencontrerons certains des arbres de la for\u00eat de Sonian, non pas en tant que fournisseurs de bois ou d\u2019oxyg\u00e8ne, mais en tant que sages cr\u00e9atures vivantes et ma\u00eetres enseignants qu\u2019ils sont.","performers":"Ana\u00efs Berck","boxoffice_url":null,"website":"https:\/\/famefestival.be\/fr\/fame-event\/arbres-compagnons\/","email":"info@famefestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50000953"},"sp":{"name":"Les arbres comme joyeux compagnons","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/famefestival.be\/fr\/fame-event\/arbres-compagnons\/","email":"info@famefestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50000953"},"nl":{"name":"Bomen als vreugdevolle metgezellen","shortdescr":"Een ontmoeting met majestueuze bomen in het Zoni\u00ebnwoud, een plek waar bomen al sinds de Ijstijd helemaal thuis zijn.","longdescr":"Elke minuut ademen we meerdere keren in en uit. Het is de meest natuurlijke beweging die we maken, zozeer zelfs dat we het vergeten. We vergeten ook dat we kunnen ademen dankzij de bomen op deze planeet. Zuurstof is het natuurlijke afval van bomen en ons natuurlijke afval \u2013 koolstofdioxide \u2013 voedt de bomen. Bomen zijn ook de meest natuurlijke oplossing voor klimaatverandering. Kortom, we leven in een relatie van voortdurende afhankelijkheid met de bomen. Tijdens deze wandeling ontmoeten we een aantal bomen in het Zoni\u00ebnwoud, niet als leveranciers van hout of zuurstof, maar als de wijze levende wezens en meester-leraren die ze zijn.","performers":null,"boxoffice_url":null,"website":"https:\/\/famefestival.be\/fr\/fame-event\/arbres-compagnons\/","email":"info@famefestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50000953"}},"place":{"id":267513,"translations":{"de":{"name":"Boitsfort, For\u00eat de Soignes","address_street_name":"Au croisement de la dr\u00e8ve des Tumuli et de la dr\u00e8ve des Comtes","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.srfb.be","phone_contact":"+32 81 62 74 06","phone_booking":null,"address_zip":"1170","address_city":"Watermael-Boitsfort","address_line1":"Au croisement de la dr\u00e8ve des Tumuli et de la dr\u00e8ve des Comtes","address_line2":"1170 Watermael-Boitsfort","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Boitsfort, For\u00eat de Soignes","address_street_name":"Au croisement de la dr\u00e8ve des Tumuli et de la dr\u00e8ve des Comtes","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.srfb.be","phone_contact":"+32 81 62 74 06","phone_booking":null,"address_zip":"1170","address_city":"Watermael-Boitsfort","address_line1":"Au croisement de la dr\u00e8ve des Tumuli et de la dr\u00e8ve des Comtes","address_line2":"1170 Watermael-Boitsfort","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Boitsfort, For\u00eat de Soignes","address_street_name":"Au croisement de la dr\u00e8ve des Tumuli et de la dr\u00e8ve des Comtes","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.srfb.be","phone_contact":"+32 81 62 74 06","phone_booking":null,"address_zip":"1170","address_city":"Watermael-Boitsfort","address_line1":"Au croisement de la dr\u00e8ve des Tumuli et de la dr\u00e8ve des Comtes","address_line2":"1170 Wat