day, friday and saturday: from 12:00 to 18:00","sunday: from 14:00 to 18:00"]},"date_start":"2022-09-16","date_end":"2022-11-13","is_also_by_appointment":true}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"opening":{"day":"2022-09-15","start":"18:00:00","timestamp":"2022-09-15T18:00:00+02:00","end":"21:00:00","is_only_by_appointment":true},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-24T01:36:27+02:00","published_at":"2022-09-06T10:11:34+02:00","backoffice_id":261072,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.25687154396614},{"id":539426,"date_start":"2022-10-26","date_end":"2023-03-01","date_next":"2022-10-26","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater"}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"],"de":["Theater"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"La grande \u00e9vasion","shortdescr":"Confiez-nous vos histoires, nous leur donnerons une seconde vie !","longdescr":"Qui n\u2019a jamais r\u00eav\u00e9 de s\u2019\u00e9vader, loin des soucis professionnels, des tracas familiaux, des traditions ou tout simplement du train-train quotidien ? Que ce soit le temps de vacances, \u00e0 l\u2019occasion d\u2019une ann\u00e9e sabbatique, d\u2019une exp\u00e9rience professionnelle \u00e0 l\u2019\u00e9tranger ou tout simplement au d\u00e9but d\u2019une nouvelle vie, pour gagner son ind\u00e9pendance, voler de ses propres ailes, retrouver un \u00eatre aim\u00e9, d\u00e9couvrir de nouvelles cultures, \u00e9chapper \u00e0 un danger\u2026 Voil\u00e0 de tr\u00e8s nombreuses raisons de s\u2019\u00e9vader, au propre comme au figur\u00e9.\r\n\r\nC\u2019est ce que vous propose de faire le groupe Vice Versa dans son spectacle au cours duquel il invite le public \u00e0 raconter une histoire personnellement v\u00e9cue.\r\n\r\nNos acteur.trice.s s\u2019emparent de l\u2019histoire et la rejouent, s\u2019attardant sur un aspect en particulier, nous faisant revivre certaines \u00e9motions, parfois cach\u00e9es, ou encore proposant une interpr\u00e9tation insoup\u00e7onn\u00e9e\u2026 Sans jugement et avec bienveillance, nous \u00e9coutons, accueillons, et jouons toutes les histoires que vous souhaitez partager avec nous, celles que vous racontez volontiers aux d\u00eeners entre amis, tout comme celles enfouies au plus profond...","performers":"Sandra Ruete, C\u00e9lie Rigaudi\u00e8re, Claudia Onnen, Louise M\u00e9trich, Tanya Wittal-D\u00fcerkop, Virginia Nucera, Renaud Genard","boxoffice_url":null,"website":"https:\/\/www.improviste.be\/La-grande-evasion.html","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.539426"},"nl":{"name":"La grande \u00e9vasion","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.539426"},"en":{"name":"La grande \u00e9vasion","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.539426"},"de":{"name":"La grande \u00e9vasion","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.