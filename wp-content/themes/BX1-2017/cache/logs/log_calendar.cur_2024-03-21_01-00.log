eatre","ranking":0.7728038897744273,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":49,"translations":{"de":"Theater","pt":null,"en":"Theatre","it":"Teatro","cn":null,"fr":"Th\u00e9\u00e2tre","sp":"Teatro","nl":"Theater"}},"others":{"list":[50],"translations":{"de":["Theater"],"pt":[null],"en":["Theatre"],"it":["Teatro"],"cn":[null],"fr":["Th\u00e9\u00e2tre"],"sp":["Teatro"],"nl":["Theater"]}}},"translations":{"de":{"name":"Marie & Woyzeck","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatre-martyrs.be","email":"billetterie@theatre-martyrs.be","phone_contact":null,"phone_booking":"+32 2 223 32 08","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.558499"},"pt":{"name":"Marie & Woyzeck","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatre-martyrs.be","email":"billetterie@theatre-martyrs.be","phone_contact":null,"phone_booking":"+32 2 223 32 08","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.558499"},"en":{"name":"Marie & Woyzeck","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatre-martyrs.be","email":"billetterie@theatre-martyrs.be","phone_contact":null,"phone_booking":"+32 2 223 32 08","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.558499"},"it":{"name":"Marie & Woyzeck","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatre-martyrs.be","email":"billetterie@theatre-martyrs.be","phone_contact":null,"phone_booking":"+32 2 223 32 08","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.558499"},"cn":{"name":"Marie & Woyzeck","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatre-martyrs.be","email":"billetterie@theatre-martyrs.be","phone_contact":null,"phone_booking":"+32 2 223 32 08","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.558499"},"fr":{"name":"Marie & Woyzeck","shortdescr":"Voyez-vous, nous les gens du commun, \u00e7a n'a pas de vertu, mais si j'avais de l'argent, et un costume. Et si je savais parler comme il faut, pour s\u00fbr que je voudrais \u00eatre vertueux.","longdescr":"L\u2019histoire du Woyzeck de B\u00fcchner est simple, efficace et gla\u00e7ante : un jeune soldat se porte \u00e0 la fois volontaire pour \u00eatre cobaye aupr\u00e8s d\u2019un m\u00e9decin contre de l\u2019argent et, comme subalterne de son capitaine de garnison, sombre dans la folie et poignarde sa femme.\r\n\u2028Avec Marie et Woyzeck, Pauline d\u2019Ollone s\u2019inspire de ce classique inachev\u00e9 du dix-neuvi\u00e8me si\u00e8cle, d\u00e9pla\u00e7ant l\u2019action de la caserne d\u2019hier \u00e0 l\u2019entrep\u00f4t de la grande distribution d\u2019aujourd\u2019hui, pour interroger nos syst\u00e8mes de production actuels et les maux qui en d\u00e9coulent, abrutissant les \u00e9gar\u00e9s de l\u2019existence qui s\u2019y enr\u00f4lent pour subsister.\r\nElle s\u2019en empare sans rien lui \u00f4ter de sa r\u00e9alit\u00e9 diffract\u00e9e. \u00c0 la n\u00e9gativit\u00e9 de la marchandisation de l\u2019\u00eatre humain consid\u00e9r\u00e9 comme une ressource \u00e0 optimiser, elle oppose le feu cr\u00e9ateur de la musique et de la po\u00e9sie : toujours plus de beaut\u00e9, toujours plus de r\u00eave et d\u2019humanit\u00e9, toujours plus de sororit\u00e9 et de fraternit\u00e9.\r\nElle l\u2019enrichit d\u2019un proc\u00e8s, celui du meurtre de Marie, du f\u00e9minicide commis par Woyzeck, instruisant deux questions : La violence d\u2019un homme est-elle aveugle \u00e0 tout autre choix que celui \u00ab d\u2019user \u00bb et donc de tuer ce qu\u2019il consid\u00e8re comme sa propri\u00e9t\u00e9 ? Ou bien n\u2019est-elle que la cons\u00e9quence de la petite graine qui a patiemment pouss\u00e9, arros\u00e9e qu\u2019elle \u00e9tait chaque jour par une id\u00e9ologie patriarcale, capitaliste et sexiste ?","performers":"texte Georg B\u00fcchner, Pauline d\u2019Ollone | jeu Pierange Buondelmonte, Sarah Defrise, Marie Denys, Liesbeth Kiebooms, Ga\u00ebtan Lejeune, Gabriel Govea Ramos, Naaman Sluchin | chant Sarah Defrise | assistanat \u00e0 la mise en sc\u00e8ne Delphine Peraya | adaptation & mise en sc\u00e8ne Pauline d\u2019Ollone","boxoffice_url":null,"website":"http:\/\/www.theatre-martyrs.be","email":"billetterie@theatre-martyrs.be","phone_contact":null,"phone_booking":"+32 2 223 32 08","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.558499"},"sp":{"name":"Marie & Woyzeck","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatre-martyrs.be","email":"billetterie@theatre-martyrs.be","phone_contact":null,"phone_booking":"+32 2 223 32 08","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.558499"},"nl":{"name":"Marie & Woyzeck","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatre-martyrs.be","email":"billetterie@theatre-martyrs.be","phone_contact":null,"phone_booking":"+32 2 223 32 08","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.558499"}},"place":{"id":231711,"translations":{"de":{"name":"Th\u00e9\u00e2tre des Martyrs","address_street_name":"Place des Martyrs","address_street_number":"22","address_street_box":null,"email":"billetterie@theatre-martyrs.be","website":"http:\/\/www.theatre-martyrs.be","phone_contact":"+32 2 223 32 08","phone_booking":"+32 2 223 32 08","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Martyrs, 22","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Th\u00e9\u00e2tre des Martyrs","address_street_name":"Place des Martyrs","address_street_number":"22"