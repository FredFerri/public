_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{"list":[258],"translations":{"fr":["Quartiers"],"nl":["Wijken"],"en":["Neighbourhoods"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Tour du samedi - D\u00e9couvrez les incontournables et les sentiers moins battus de Bruxelles \u00e0 v\u00e9lo!","shortdescr":"D\u00e9couvrez les incontournables de Bruxelles et les sentiers moins battus de la ville \u00e0 v\u00e9lo","longdescr":"Cette visite guid\u00e9e \u00e0 v\u00e9lo est l\u2019introduction id\u00e9ale \u00e0 Bruxelles, \u00e0 son histoire et \u00e0 ses nombreux quartiers. Un m\u00e9lange id\u00e9al entre les incontournables tels que le quartier des Marolles, le March\u00e9 aux Poissons, le Palais de Justice,... et les sentiers moins battus. Pendant ce tour, nos guides vous offrent une vue surprenante sur la ville et sa diversit\u00e9.\r\nLes tours du samedi se font en petits groupes de maximum 13 personnes pour garder une ambiance conviviale! \u00c0 mi-parcours, les v\u00e9los sont mis de c\u00f4t\u00e9 pour une pause dans un caf\u00e9 sympathique ou sur une terrasse.\r\nD\u00e9couvrez Bruxelles \u00e0 v\u00e9lo et laissez-vous surprendre !\r\n\r\nPrix :\r\n\u2022 20 \u20ac avec son v\u00e9lo\r\n\u2022 28 \u20ac avec un v\u00e9lo classique incl.\r\n\u2022 41 \u20ac e-bike incl.\r\n\r\nTous les samedi (3,5h)\r\n10h00 : en Fran\u00e7ais et en Anglais\r\n14h00 : en N\u00e9erlandais","performers":null,"boxoffice_url":null,"website":"https:\/\/cactus.brussels\/tours-du-weekend","email":"info@cactus.brussels","phone_contact":null,"phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/524206.html"},"nl":{"name":"Zaterdagtour - Ontdek de highlights en minder betreden paden van Brussel met de fiets!","shortdescr":null,"longdescr":"Deze gegidste fietstocht is een ideale kennismaking met Brussel, haar geschiedenis en haar vele wijken. Onze gidsen maken van deze fietstocht een ideale mix tussen highlights als de Marollen, de Vismarkt, het Justitiepaleis, \u2026 en de minder betreden paden van de stad en bieden je een verrassende kijk op de stad en haar veelzijdigheid.\r\nWe gaan op stap met relatief kleine groepen van max. 13 personen om het aangenaam en gezellig te houden! Halverwege de tour gaan de fietsen even aan de kant voor een pauze in een gezellig caf\u00e9 of op een terrasje.\r\nOntdek Brussel met de fiets en laat je verrassen!\r\nPrijs:\r\n\u2022 20 \u20ac eigen fiets\r\n\u2022 28 \u20ac klassieke fiets\r\n\u2022 41 \u20ac e-bike\r\nElke zaterdag (3,5u)\r\n\u2022 10u00 : in het Frans en Engels\r\n\u2022 14u00: in het Nederlands","performers":null,"boxoffice_url":null,"website":"https:\/\/cactus.brussels\/weekendtours","email":null,"phone_contact":"+32 497 19 07 14","phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/524206.html"},"en":{"name":"Saturday tour - Brussels highlights and hidden gems","shortdescr":null,"longdescr":"A fascinating introduction to Brussels and its diversity of neighbourhoods. Our guides take you as part of a small group (max. 13 pers.) along some of the city\u2019s highlights, surprising hidden gems and along its diversity of neighbourhoods.\r\n\r\nGet a surprising view on the city and enjoy the perfect mix between the city\u2019s highlights such as les Marolles, the Fish Market, the Courthouse and less obvious places and areas. \r\n\r\nWe put the bicycles aside at the halfway point to take a small break in a cosy bar or on one of the many terraces.\r\n\r\nSaturdays at 10am: English and French tours and at 2pm: Dutch tours\r\nDuration: 3,5h (small pause incl.)\r\n\r\nPrices:\r\nwith your own bike: \u20ac20 p.p.\r\nwith a bike from us: \u20ac28  p.p.\r\nwith an e-bike from us: \u20ac41 p.p.\r\n\r\nMeeting point in the city center of Brussels Grand Hospice - Bike Hub","performers":null,"boxoffice_url":null,"website":"https:\/\/cactus.brussels\/weekend-tours","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/524206.html"},"de":{"name":"Tour du Weekend - Bruxelles, les incontournables et les sentiers moins battus","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/524206.html"},"it":{"name":"Tour du Weekend - Bruxelles, les incontournables et les sentiers moins battus","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/524206.html"},"sp":{"name":"Tour du Weekend - Bruxelles, les incontournables et les sentiers moins battus","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/524206.html"},"pt":{"name":"Tour du Weekend - Bruxelles, les incontournables et les sentiers moins battus","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/524206.html"},"cn":{"name":"Tour du Weekend - Bruxelles, les incontournables et les sentiers moins battus","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/524206.html"}},"place":{"id":276966,"translations":{"fr":{"name":"Grand Hospice","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"hospice@pali-pali.com","website":"http:\/\/grand-hospice.brussels","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 7","address_line2":"1000 Bruxelles","description_web":"Projet d\u2019occupation temporaire du site de l'Hospice Pacheco. Rejoignez-nous du lundi au dimanche pour profiter de ce petit havre de paix en plein centre de Bruxelles.\r\nLe projet, g\u00e9r\u00e9 par PaliPali, prend place jusqu\u2019en d\u00e9cembre 2023. Pour faire vivre ce petit oasis de verdure, Pali Pali s\u2019est associ\u00e9 \u00e0 Jardin afin de g\u00e9rer la guinguette du site. L\u2019id\u00e9e est de mettre \u00e0 disposition des \u00e9quipements pour l\u2019ensemble du quartier selon deux principes : cr\u00e9er du lien et vivre ensemble.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Grand Hospice","address_street_name":"Grootgodshuisstraat","address_street_number":"7","address_street_box":null,"email":"hospice@pali-pali.com","website":"http:\/\/grand-hospice.brussels","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Grootgodshuisstraat, 7","address_line2":"1000 Brussel","description_web":"In afwachting van de grote renovatie die nodig is om een complex van wooneenheden en gemeenschapsdiensten te cre\u00ebren, heeft het Brusselse OCMW beslist het Hospice Pacheco ter beschikking te stellen voor een vernieuwend project met een sterke sociale en culturele ori\u00ebntatie.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Grand Hospice","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"hospice@pali-pali.com","website":"http:\/\/grand-hospice.brussels","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue du Grand Hospice, 7","address_line2":"1000 Brussels","description