fr":{"name":"Demandeurs d'emploi"},"nl":{"name":"Werkzoekenden"},"en":{"name":"Job seekers"},"de":{"name":"Arbeitsuchende"},"it":{"name":"Disoccupati"},"sp":{"name":"Desempleados"},"pt":{"name":"Demandeurs d'emploi"},"cn":{"name":"Demandeurs d'emploi"}},"value":8},{"translations":{"fr":{"name":"Article 27"},"nl":{"name":"Artikel 27"},"en":{"name":"Article 27"},"de":{"name":"Article 27"},"it":{"name":"Article 27"},"sp":{"name":"Article 27"},"pt":{"name":"Article 27"},"cn":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-02-20T09:05:16+01:00","published_at":"2023-02-20T08:45:00+01:00","backoffice_id":272018,"import_origin":null,"sub_type":"concert","show_in_agenda":true,"ranking":1.2599210498949},{"id":552893,"date_start":"2023-03-25","date_end":"2023-03-25","date_next":"2023-03-25","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert","de":"Konzert","it":"Concerti","sp":"Concierto","pt":null,"cn":null}},"others":{"list":[4,7],"translations":{"fr":["Pop, rock, jazz\u2026","Pop, Rock"],"nl":["Pop, rock, jazz\u2026","Pop, Rock"],"en":["Pop, rock, jazz\u2026","Pop, Rock"],"de":["Pop, Rock, Jazz...","Pop, Rock"],"it":["Pop, rock, jazz\u2026","Pop, Rock"],"sp":["Pop, rock, jazz\u2026","Pop, rock"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["es","pt","nl","fr"],"subtitles":[]},"translations":{"fr":{"name":"Spring Music & Wine Festival","shortdescr":"Le printemps arrive et nous voulons le c\u00e9l\u00e9brer avec un festival unique qui associe de jeunes artistes europ\u00e9ens aux meilleurs vins et tapas de la p\u00e9ninsule ib\u00e9rique. A ne pas  manquer ! - MUSIQUE - DEGUSTATION VINS","longdescr":"Ce partenariat entre From de Roots & Le Baixu a pour but de cr\u00e9er un nouveau concept de festival \u00e0 Bruxelles o\u00f9 nous voulons vous faire d\u00e9couvrir des artistes \u00e9mergents dans un lieu authentique de Bruxelles compl\u00e9t\u00e9 par d'incroyables vins ib\u00e9riques ! D\u00e9j\u00e0 convaincu ?","performers":"MEWHY, im.pulse, The Marzial Art","boxoffice_url":null,"website":"https:\/\/www.facebook.com\/Fromderoots","email":"info@lebaixu.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.552893"},"nl":{"name":"Spring Music & Wine Festival","shortdescr":"Deze samenwerking tussen From de Roots & Le Baixu is bedoeld om een nieuw concept van festival in Brussel te cre\u00ebren waarbij we je opkomende artiesten willen laten ontdekken in een authentieke locatie in Brussel aangevuld met geweldige Iberische wijnen! Al overtuigd?","longdescr":"- MUZIEK -\r\nDoe mee aan dit internationale Spring Fest waar we jonge Europese talenten zullen ontdekken - Portugal, Itali\u00eb & Belgi\u00eb.\r\n\/\/MEWHY\/\/\r\nOp 26-jarige leeftijd is Gilles Verhaegen, auteur, componist, performer en producer die optreedt onder de naam MEWHY, de rijzende ster van de popmuziek in Belgi\u00eb. MEWHY, bekroond op de \"Belgische muziekweek\" 2023, is ook een bijzonder innemende persoonlijkheid vanwege zijn gevoeligheid, zijn nieuwsgierigheid en zijn oprechtheid, die hij overbrengt in de teksten die hij schrijft en de muziek die hij componeert.\r\nhttps:\/\/www.facebook.com\/mewhyofficial\/ \r\nhttps:\/\/www.instagram.com\/mewhyofficial\/\r\nopen.spotify.com\/artist\/2haudpnLQ5Kjt6fplURp31\r\n\/\/im.pulse\/\/\r\nMiguel Baptista Alves, im.pulse, is een Portugees die in Brussel woont en houdt van elektronische muziek: van French House tot Disco, van Zuid-Amerikaans tot Afrikaans, van Jungle tot Break Beat of zelfs Jazz en Ambient. Als ontdekkingsreiziger en muziekliefhebber probeert hij graag nieuwe geluiden uit en zoekt hij naar nieuwe combinaties.\r\nhttps:\/\/www.instagram.com\/im_pulse_live\/ \r\nhttps:\/\/www.youtube.com\/channel\/UC1RYjQFvCh-IyeS6LXIzLAg \r\nhttps:\/\/www.facebook.com\/im.pulse.livee \r\n\/\/De Marzial Art\/\/\r\nThe Marzial Art is een recent opgerichte post-pandemische Italiaanse band, waarvan de muzikanten afkomstig zijn uit verschillende eerdere projecten van de Brusselse rockscene, zoals Tortilla Flat, en allemaal verzameld door de zwaartekracht artistieke aantrekkingskracht van de hoofdzangeres, Marzia, vandaar de naam.\r\n \r\n- ETEN & DRINKEN -\r\nWe hebben voor u de beste en unieke wijnselectie van het Iberisch schiereiland voorbereid die u tijdens dit evenement kunt ontdekken en genieten! Ook bieren en frisdranken zullen beschikbaar zijn.\r\nEen selectie van de meest representatieve Spaanse Tapas zal beschikbaar zijn zodat u de volledige Wijn & Tapas ervaring kunt hebben en u naar het schiereiland kunt vliegen.\r\n \r\n- OPENINGSTIJDEN -\r\n25 maart 2023 van 19:30 tot 00:00 uur.\r\nOm te profiteren van een exclusieve ervaring is het sterk aanbevolen om uw tickets online te reserveren.\r\n \r\n- VEILIGHEIDSMAATREGELEN -\r\n- Online reservering beschikbaar en sterk aanbevolen. \r\n- Mogelijkheid om te komen zonder reservering, de receptie agent zal u laten weten of toegang mogelijk is volgens de toegestane meter. Prijs 8 euro incl. glas wijn.\r\n- Betaling per kaart of contant.\r\n- Beheer van de bezoekersstroom door onze receptie- en veiligheidsagenten.","performers":"MEWHY, im.pulse, The Marzial Art","boxoffice_url":null,"website":"https:\/\/www.facebook.com\/Fromderoots","email":"info@lebaixu.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.552893"},"en":{"name":"Spring Music & Wine Festival","shortdescr":"Spring is coming and we want to celebrate it with a unique festival that combines young European artists with the best wines and tapas from the Iberian Peninsula. Not to be missed! MUSIC & WINE TASTING","longdescr":"This partnership between From de Roots & Le Baixu is meant to create a new concept of festival in Brussels where we want to make you discover emerging artists in an authentic venue in Brussels supplemented by amazing  Iberian wines!\r\nAlready convinced?","performers":"MEWHY, im.pulse, The Marzial Art","boxoffice_url":null,"website":"https:\/\/www.facebook.com\/Fromderoots","email":"info@lebaixu.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.552893"},"de":{"name":"Spring Music & Wine Festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.facebook.com\/Fromderoots","email":"info@lebaixu.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.552893"},"it":{"name":"Spring Music & Wine Festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.facebook.com\/Fromderoots","email":"info@lebaixu.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.552893"},"sp":{"name":"Spring Music & Wine Festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.facebook.com\/Fromderoots","email":"info@lebaixu.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.552893"},"pt":{"name":"Spring Music & Wine Festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.facebook.com\/Fromderoots","email":"info@lebaixu.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.552893"},"cn":{"name":"Spring Music & Wine Festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.facebook.com\/Fromderoots","email":"info@lebaixu.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.552893"}},"place":{"id":279109,"translations":{"fr":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"info@lebaixu.be","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard, 3","address_line2":"1000 Bruxelles","description_web":"Un lieu atypique et chaleureux dans le quartier de Tour & Taxis \u00e0 Bruxelles pour assister \u00e0 des concerts, des expositions, des projections ou des conf\u00e9rences, ou pour y organiser vos \u00e9v\u00e8nements priv\u00e9s.\r\nUn projet d\u00e9di\u00e9 au \u00ab beau \u00bb sous toutes ses coutures, dont les maitres-mots sont qualit\u00e9, \u00e9changes et rencontres.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Le Baixu","address_street_name":"Picardstraat","address_street_number":"3","address_street_box":null,"email":"info@lebaixu.be","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Picardstraat, 3","address_line2":"1000 Brussel","description_web":"De naam \"Baixu\" betekent \"mooi\" in de taal van de Pataxos indianen die in de zuidelijke staat Bahia (Brazili\u00eb) wonen. Dit woord staat voor de ambitie van het project en de kwaliteit van de culturele evenementen, maar ook voor de verbondenheid van de initiatiefnemers met de Braziliaanse cultuur. \r\nLe Baixu is ondergebracht in een voormalig industrieel gebouw in het hart van de trendy Brusselse Tour & Taxis wijk. Een atypische en warme plek bedoeld voor concerten, tentoonstellingen, filmvertoningen en conferenties en waar je ook priv\u00e9 evenementen kan organiseren. Het is een volledig uitgeruste, multidisciplinaire culturele ruimte met een oppervlakte van 150 m2, gewijd aan de \"schoonheid\" in al haar vormen. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"info@lebaixu.be","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue Picard, 3","address_line2":"1000 Brussels","description_web":"The name \u201cBaixu\u201d means \u201cbeautiful\u201d in the native language of the Patax\u00f3 peoples, indigenous to the south of the state of Bahia in Brazil. This word represents both the ambition of the project and the quality of the cultural events presented, as well as the founders\u2019 attachment to Brazilian culture. Baisu is a quaint and welcoming space in the Tour & Taxis neighborhood in Brussels, which hosts concerts, expositions, screenings, or conferences \u2013 or where you can organise your private event.\r\nA project dedicated to \u201cbeauty\u201d in all its forms, where the keywords are quality, exchange and interaction.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"info@lebaixu.be","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard, 3","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":n