ccurences":{"is_first":true,"is_second":true,"is_third":true,"is_fourth":true,"is_last":true},"time_start":"18:00:00","time_end":"23:59:00","translations":{"fr":"Ouvert les premier, deuxi\u00e8me, troisi\u00e8me, quatri\u00e8me et dernier vendredis du mois de 18:00 \u00e0 23:59","nl":"Open op de eerste, tweede, derde, vierde en laatste vrijdags van de maand van 18:00 tot 23:59","en":"Open the first, second, third, fourth and last fridays of the month from 18:00 to 23:59"}},{"day":"saturday","occurences":{"is_first":true,"is_second":true,"is_third":true,"is_fourth":true,"is_last":true},"time_start":"00:00:00","time_end":"04:00:00","translations":{"fr":"Ouvert les premier, deuxi\u00e8me, troisi\u00e8me, quatri\u00e8me et dernier samedis du mois de 00:00 \u00e0 04:00","nl":"Open op de eerste, tweede, derde, vierde en laatste zaterdags van de maand van 00:00 tot 04:00","en":"Open the first, second, third, fourth and last saturdays of the month from 00:00 to 04:00"}},{"day":"saturday","occurences":{"is_first":true,"is_second":true,"is_third":true,"is_fourth":true,"is_last":true},"time_start":"18:00:00","time_end":"23:59:00","translations":{"fr":"Ouvert les premier, deuxi\u00e8me, troisi\u00e8me, quatri\u00e8me et dernier samedis du mois de 18:00 \u00e0 23:59","nl":"Open op de eerste, tweede, derde, vierde en laatste zaterdags van de maand van 18:00 tot 23:59","en":"Open the first, second, third, fourth and last saturdays of the month from 18:00 to 23:59"}},{"day":"sunday","occurences":{"is_first":true,"is_second":true,"is_third":true,"is_fourth":true,"is_last":true},"time_start":"00:00:00","time_end":"04:00:00","translations":{"fr":"Ouvert les premier, deuxi\u00e8me, troisi\u00e8me, quatri\u00e8me et dernier dimanches du mois de 00:00 \u00e0 04:00","nl":"Open op de eerste, tweede, derde, vierde en laatste zondags van de maand van 00:00 tot 04:00","en":"Open the first, second, third, fourth and last sundays of the month from 00:00 to 04:00"}},{"day":"sunday","occurences":{"is_first":true,"is_second":true,"is_third":true,"is_fourth":true,"is_last":true},"time_start":"18:00:00","time_end":"23:59:00","translations":{"fr":"Ouvert les premier, deuxi\u00e8me, troisi\u00e8me, quatri\u00e8me et dernier dimanches du mois de 18:00 \u00e0 23:59","nl":"Open op de eerste, tweede, derde, vierde en laatste zondags van de maand van 18:00 tot 23:59","en":"Open the first, second, third, fourth and last sundays of the month from 18:00 to 23:59"}}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[11,12,10],"translations":{"fr":["Famille","LGTBQIA","Seniors"],"nl":["Familie","LGTBQIA","Senioren"],"en":["Family","LGTBQIA","Seniors"]}},"tags":["kids"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-05-18T01:08:16+02:00","published_at":"2022-03-29T16:23:50+02:00","backoffice_id":250514,"import_origin":null,"sub_type":"concert","show_in_agenda":true,"ranking":0.21993316063422},{"id":529079,"date_start":"2022-03-25","date_end":"2022-06-26","date_next":"2022-05-18","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[36,48],"translations":{"fr":["Mus\u00e9es et art centers","Architecture"],"nl":["Musea en kunstcentra","Architectuur"],"en":["Museums and art centers","Architecture "]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Le Logis-Flor\u00e9al \u2014 un projet coop\u00e9ratif","shortdescr":"Il y a 100 ans, les premi\u00e8res cit\u00e9s-jardins font leur apparition en Belgique. Un si\u00e8cle plus tard, la question se pose de savoir si leur philosophie de vie collective et coop\u00e9rative est susceptible d\u2019apporter des solutions \u00e0 la crise actuelle du logement. A partir d\u2019une exposition et d\u2019un colloque, le CIVA souhaite ouvrir la question.","longdescr":"\u00c0 la fin de la Premi\u00e8re Guerre mondiale, une crise du logement fait rage en Belgique. La p\u00e9nurie de mat\u00e9riaux fait exploser les co\u00fbts de construction, la raret\u00e9 des terrains \u00e0 b\u00e2tir alimente la sp\u00e9culation, et la reconstruction apr\u00e8s les bombardements est douloureusement lente. Une situation qui ne fait qu'aggraver les conditions de vie d\u00e9j\u00e0 mis\u00e9rables de la classe ouvri\u00e8re, pouss\u00e9e par l'exode rural vers les villes depuis la moiti\u00e9 du XIX\u00e8me si\u00e8cle.\r\n\r\n\u00c0 la recherche de solutions, une partie des pouvoirs publics ainsi que les architectes de l'avant-garde moderniste belge proposent le mod\u00e8le de la cit\u00e9-jardin : un quartier d\u2019habitations dans un espace vert situ\u00e9 \u00e0 la p\u00e9riph\u00e9rie des villes. Le mod\u00e8le pr\u00e9sente de nombreux avantages : le terrain \u00e0 b\u00e2tir est moins cher, l'utilisation de mat\u00e9riaux modernes tels que le b\u00e9ton ainsi que la standardisation contribuent \u00e0 r\u00e9duire les co\u00fbts et \u00e0 acc\u00e9l\u00e9rer le processus de construction.\r\n\r\nCertaines de ces cit\u00e9s-jardins des ann\u00e9es 1920 vont privil\u00e9gier le mod\u00e8le \u00e9conomique et socio-culturel de l\u2019habitat coop\u00e9ratif : chaque r\u00e9sident est locataire de son logement mais co-propri\u00e9taire de l\u2019ensemble de la cit\u00e9-jardin. Un mod\u00e8le qui implique non seulement la cr\u00e9ation de nombre d\u2019espaces de vie et d\u2019\u00e9quipements collectifs, mais aussi un \u00e9quilibre entre l'individuel et le collectif, le priv\u00e9 et le public, l'unit\u00e9 et la diversit\u00e9.  \r\n\r\nAujourd\u2019hui, la question du logement collectif est \u00e0 nouveau \u00e0 l\u2019ordre du jour. Avec une exposition, consacr\u00e9e principalement \u00e0 la cit\u00e9-jardin Le Logis-Flor\u00e9al, et un colloque avec des invit\u00e9s belges et internationaux, le CIVA met non seulement les cit\u00e9s-jardins coop\u00e9ratives dans une perspective historique, mais examine \u00e9galement la pertinence du mod\u00e8le pour r\u00e9pondre aux d\u00e9fis actuels en mati\u00e8re d'architecture, d'urbanisme, de paysage et de mod\u00e8le socio-\u00e9conomique et culturel.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.civa.brussels\/en\/exhibitions-events\/expo-le-logis-floreal-co-operative-project","email":"info@civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/529079.html"},"nl":{"name":"Le Logis-Flor\u00e9al \u2014 een co\u00f6peratief project","shortdescr":"Exact 100 jaar geleden duiken in Belgi\u00eb de eerste tuinwijken op. Een eeuw later rijst de vraag of hun filosofie van collectief en co\u00f6peratief wonen oplossingen kan aanreiken voor de huidige huisvestingscrisis. Met een tentoonstelling en een colloquium geeft CIVA een aanzet tot antwoord.","longdescr":"Aan het einde van de Eerste Wereldoorlog woedt in Belgi\u00eb een huisvestingscrisis. Door het tekort aan materialen schieten de kosten de hoogte in, de schaarste aan bouwgrond voedt de speculatie en de wederopbouw na de bombardementen loopt tergend traag. De leefomstandigheden van de arbeidersklasse worden steeds schrijnender. De plattelandsvlucht aan het midden van de 19de eeuw had hen al naar de steden gedreven, waar ze onder erbarmelijke omstandigheden in de sloppenwijken leefden.\r\n\r\nZoekend naar oplossingen stellen bepaalde beleidsmakers en architecten uit de Belgische modernistische avant-garde het tuinwijkmodel voor: een groene woon- en leefplek aan de rand van de stad. Het model heeft heel wat voordelen: de bouwgrond is er goedkoper, standaardisatie en het gebruik van moderne materialen zoals beton drukken de bouwkost. Bouwen gaat voortaan dus ook een pak sneller.\r\n\r\nEen deel van de tuinwijken uit de jaren \u201820 staat het economisch en sociaal-cultureel model van co\u00f6peratief wonen voor: elke bewoner huurt de eigen woning maar is tegelijk mede-eigenaar van de tuinwijk in haar globaliteit. Het idee impliceert niet enkel het cre\u00ebren van voldoende collectieve ruimte maar houdt ook een evenwicht in tussen het individuele en het collectieve, priv\u00e9 en publiek, eenheid en verscheidenheid.  \r\n\r\nHet idee van collectief wonen lijkt de laatste tijd terug van weggeweest. Met een tentoonstelling, die focust op de tuinwijk Le Logis-Flor\u00e9al, en een colloquium met Belgische en internationale gasten plaatst CIVA de co\u00f6peratieve tuinwijken niet enkel in een historisch perspectief. Het onderzoekt ook de relevantie van het model voor de huidige uitdagingen op het vlak van architectuur, stadsplanning en landschap, en of het kan inspireren als socio-economisch en cultureel project.","performers":null,"boxoffice_url":null,"website":null,"email":"info@civa.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/529079.html"},"en":{"name":"Le Logis-Flor\u00e9al \u2014 a co-operative project","shortdescr":"The first \"garden cities\" appeared in Belgium about a hundred years ago. We now ask ourselves, a century later, whether their philosophy based upon collective and cooperative living is likely to provide solutions to the current housing crisis. CIVA intends to address this question by means of an exhibition and a symposium.","longdescr":"At the end of the First World War, a housing crisis was raging in Belgium. The shortage of materials caused construction costs to soar, the scarcity of building land fuelled speculation, and reconstruction after the bombing was painfully slow. This situation only aggravated the working classes\u2019 already miserable living conditions, driven by the rural exodus to the cities which began in the mid-19th century.\r\n\r\nWhile searching for solutions, some of the public authorities and the architects of the Belgian modernist avant-garde proposed the \"garden city\" model: a housing estate in a green area on the city\u2019s outskirts. The model had many advantages: the building land was cheaper, and the use of standardisation and modern materials like concrete helped to reduce costs and speed up the construction process.\r\n\r\nSome of these garden cities of the 1920s favoured the economic and socio-cultural model of cooperative housing: each resident was a tenant in his or her own home but co-owner of the entire garden city. This model implies not only the creation of a number of living spaces and collective facilities, but also a balance between the individual and the collective, the private and the public, unity and diversity.  \r\n\r\nToday, the issue of collective housing is once again on the agenda. The exhibition, which is mainly devoted to \"Le Logis-Flor\u00e9al\", and a colloquium with Belgian and international guests places the cooperative garden city in a historical perspective and examines the model's relevance with regards to today's challenges in terms of architecture, urbanism, landscape, and contemporary socio-economic and cultural contexts.","performers":null,"boxoffice_url":null,"website":null,"email":"info@civa.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/529079.html"},"de":{"name":"Le Logis-Flor\u00e9al \u2014 un projet coop\u00e9ratif","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/529079.html"},"it":{"name":"Le Logis-Flor\u00e9al \u2014 un projet coop\u00e9ratif","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/529079.html"},"sp":{"name":"Le Logis-Flor\u00e9al \u2014 un projet coop\u00e9ratif","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/529079.html"},"pt":{"name":"Le Logis-Flor\u00e9al \u2014 un projet coop\u00e9ratif","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/529079.html"},"cn":{"name":"Le Logis-Flor\u00e9al \u2014 un projet coop\u00e9ratif","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/529079.html"}},"place":{"id":235577,"translations":{"fr":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"CIVA est un muse\u0301e, un centre d'archives, une bibliothe\u0300que et un lieu de rencontre pour les amateurs d'architecture, d'architecture paysage\u0300re, d'e\u0301cosyste\u0300mes urbains et d'histoire a\u0300 Bruxelles. Tout au long de l'anne\u0301e, vous pouvez vous y rendre pour des expositions temporaires, des confe\u0301rences, des de\u0301bats, des visites guide\u0301es, des lancements de livres et des activite\u0301s pour les enfants. Les activite\u0301s se trouvent a\u0300 Ixelles, pre\u0300s de la Place Flagey et au centre de Bruxelles, a\u0300 KANAL - Centre Pompidou.\r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"CIVA","address_street_name":"Kluisstraat","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"Kluisstraat","address_line2":"1050 Elsene","description_web":"CIVA is een museum, een archiefcentrum, een bibliotheek en een ontmoetingsplek voor liefhebbers van architectuur, landschapsarchitectuur, stadsecosystemen en geschiedenis in Brussel. Het hele jaar door kan je er terecht voor tijdelijke tentoonstellingen, lezingen, debatten, rondleidingen, book launches en kinderactiviteiten. De activiteiten vind je in Elsene, vlakbij het Flageyplein en in Brussel-centrum, in KANAL \u2013 Centre Pompidou.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"CIVA is a museum, an archive center, a library and a meeting place for lovers of architecture, landscape architecture, urban ecosystems and history in Brussels. Throughout the year, CIVA organizes temporary exhibitions, lectures, debates, guided tours, book launches and activities for children. The activities are organized in Ixelles, near Place Flagey and in the center of Brussels, in KANAL - Centre Pompidou.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"Das Architekturzentrum CIVA, das 2016 auf Betreiben der Region Br\u00fcssel-Hauptstadt ins Leben gerufen wurde, vereint in einer einzigen Struktur Ressourcen, Wissen und Know-how verschiedener Br\u00fcsseler Vereine aus dem Bereich Kultur, Architektur, St\u00e4dteplanung, Landschaftsarchitektur und Forschungen zum \u00d6kosystem: die Archive f\u00fcr moderne Architektur, die Bibliothek Ren\u00e9 Pech\u00e8re, der Architekturfonds und das Centre Paul Duvigneaud.\r\nMit ihrem kulturellen Projekt tr\u00e4gt die Fondation CIA zur Entwicklung einer architektonischen, landschaftsarchitektonischen und st\u00e4dteplanerischen Kultur bei, die sich mit den Herausforderungen der Gegenwart auseinandersetzt. Schwerpunkt ist Br\u00fcssel. \r\n\r\nDie Fondation CIVA bietet eine ganze Reihe von Aktivit\u00e4ten und Angeboten: Ausstellungen, Konferenzen, Orte des Austauschs und der Debatten, p\u00e4dagogische Aktivit\u00e4ten, Archiveinblicke und Bibliotheken mit knapp 40.000 Werken und Zeitschriften zu den Themen Architektur, St\u00e4dteplanung, Stadtgeschichte, Landschaften, G\u00e4rten und urbane \u00d6kosysteme.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"Creado en 2016 por iniciativa de la Regi\u00f3n Bruselas-Capital, el CIVA re\u00fane una \u00fanica estructura de recursos, conocimiento y aprendizaje de varias asociaciones culturales activas en Bruselas en los campos de la arquitectura, urbanismo, paisajes y el estudio de ecosistemas: los Archivos de Arquitectura Moderna, la Biblioteca Ren\u00e9 Pech\u00e8re, los Fondos para la arquitectura, el Centro Paul Duvigneaud y el CIVA asbl, ahora disuelto.\r\nA trav\u00e9s de este proyecto cultural, la Fundaci\u00f3n CIVA contribuye al desarrollo del paisaje arquitect\u00f3nico y la cultura urbana como base para afrontar desaf\u00edos contempor\u00e1neos, poniendo especial \u00e9nfasis en Bruselas.\r\nSiempre tiene \u00e9xito a la hora de cumplir sus objetivos y tratar con un p\u00fablico amplio (adultos y ni\u00f1os, estudiantes, investigadores, arquitectos, paisajistas, amantes de la naturaleza, pol\u00edticos, etc), la fundaci\u00f3n CIVA organiza numerosos eventos y actividades en diferentes lugares, incluyendo exhibiciones permanentes y temporales, conferencias, debates y actividades educativas. Tambi\u00e9n dispone archivos excepcionales abiertos para todos los p\u00fablicos (documentos de arquitectos y paisajistas: planos, bocetos, modelos, muebles, etc.) y librer\u00edas que contienen casi 40.000 obras y peri\u00f3dicos de arquitectura, urbanismo, la historia de los pueblos y ciudades, paisajes, jardines y ecolog\u00eda urbana.\r\nEstas actividades y materiales est\u00e1n dise\u00f1ados para despertar la curiosidad y el inter\u00e9s de todo nuestro entorno, ya sea un hecho hist\u00f3rico o una construcci\u00f3n.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[5],"translations":{"fr":["Flagey"],"nl":["Flagey"],"en":["Flagey"]}},"zones":{"list":[21],"translations":{"fr":["Sud"],"nl":["Zuid"],"en":["South"]}},"neca":null,"facebook_id":null,"backoffice_id":1436,"location":{"lat":50.82873218,"lon":4.36569034},"region":"brussels","last_updated_at":"2022-05-18T01:35:22+02:00","published_at":"2013-10-19T01:14:20+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":235577,"translations":{"fr":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"CIVA est un muse\u0301e, un centre d'archives, une bibliothe\u0300que et un lieu de rencontre pour les amateurs d'architecture, d'architecture paysage\u0300re, d'e\u0301cosyste\u0300mes urbains et d'histoire a\u0300 Bruxelles. Tout au long de l'anne\u0301e, vous pouvez vous y rendre pour des expositions tempora