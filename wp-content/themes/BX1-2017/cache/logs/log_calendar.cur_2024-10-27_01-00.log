Claires","address_street_name":"Rijkeklarenstraat","address_street_number":"24","address_street_box":null,"email":"accueil@lesrichesclaires.be","website":"http:\/\/www.lesrichesclaires.be","phone_contact":"+32 2 548 25 80","phone_booking":"+32 2 548 25 80","address_zip":"1000","address_city":"Brussel","address_line1":"Rijkeklarenstraat, 24","address_line2":"1000 Brussel","description_web":"Riches-Claires is een cultureel centrum open voor alle disciplines van de podiumkunsten, gelegen op slechts een steenworp afstand van het Sint-Goriksplein en de Beurs. De plaats definieert zich als een lanceerplatform voor jonge kunstenaars terwijl gevestigde waarden er kunnen experimenteren. Met haar originele en toegankelijke programmering wil de instelling zijn traditie aan humoristisch theater  bestendigen terwijl het ook ruimte wil verstrekken voor expressie in hedendaagse dans, muziek en film.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[13,3],"translations":{"de":["Historisches Stadtzentrum","Dansaert\/Sainte-Catherine"],"pt":[null,null],"en":["Historical Centre","Dansaert\/Sainte-Catherine"],"it":["Centro storico","Dansaert\/Sainte-Catherine"],"cn":[null,null],"fr":["Centre historique","Dansaert\/Sainte-Catherine"],"sp":["Centro hist\u00f3rico","Dansaert\/Sainte-Catherine"],"nl":["Historisch centrum","Dansaertwijk\/Sint-Katelijne"]}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":null,"facebook_id":null,"backoffice_id":177,"location":{"lat":50.8468815,"lon":4.34636789},"region":"brussels","last_updated_at":"2023-09-19T16:27:11+02:00","published_at":"2013-10-19T01:13:20+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":1085,"translations":{"de":{"name":"Les Riches-Claires","address_street_name":"