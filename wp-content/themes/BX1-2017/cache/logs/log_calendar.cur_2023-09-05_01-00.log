rbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2023-09-04T02:01:21+02:00","published_at":"2023-04-24T12:25:16+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":275967,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.21129929348218257,"languages":{"spoken":["en","fr","nl"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[46,36],"translations":{"de":["Multidisziplin\u00e4r","Museen & Kunstzentren"],"pt":[null,null],"en":["Multidisciplinary","Museums and art centers"],"it":["Multidisciplinare","Musei e centri artistici"],"cn":[null,null],"fr":["Pluridisciplinaire","Mus\u00e9es et art centers"],"sp":["Multidisciplinar","Museos y centros de arte"],"nl":["Multidisciplinair","Musea en kunstcentra"]}}},"translations":{"de":{"name":"Cross-ing Way-s","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/mmrk.be\/","email":"musea@basilicakoekelberg.be","phone_contact":null,"phone_booking":"+32 2 421 16 79","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.555967"},"pt":{"name":"Cross-ing Way-s","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/mmrk.be\/","email":"musea@basilicakoekelberg.be","phone_contact":null,"phone_booking":"+32 2 421 16 79","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.555967"},"en":{"name":"Cross-ing Way-s","shortdescr":"CROSS-ING WAY-S - Stations of life. About grief, death and hope.\r\nWith the exhibition CROSS-ING WAY-S at Koekelberg Basilica, artist and curator Denys Shantar offers an innovative and contemporary take on the Cross Way. Featuring works by Elena Subach, Lina Van Hulle, Daniel C. Muller, Ute Resch, Klaus Verscheure, Erzs\u00e9bet Baerveldt, Nikita Kadan, Sergey Bratkov and Johan Creten, among others.","longdescr":"The tradition of the Cross Way started as a\r\npilgrimage destination in Jerusalem, from where\r\nit is believed to have been Pontius Pilates\u2019\r\nresidence to the final stage of the Calvary.\r\nThe depiction of Jesus on his last day on earth\r\nas a human became an essential part of most\r\nWestern Catholic churches in the 19th century.\r\nSome churches add the resurrection as an\r\nunofficial 15th station.\r\nCROSS-ING WAY-S is a very personal and\r\nintimate journey. We can decide for ourselves\r\nwho we are. Are we the spectators?\r\nThe mother who sees her struggling child?\r\nAre we Simon or Veronica who lend a\r\nhelping hand?\r\nOr are we Jesus himself?\r\nNo matter who we choose to be,\r\nwe all await a resurrection; in the end\r\nwe \u201care the salt of the earth\u201d.\r\nDenys Shantar gives a fresh and current view\r\non the Cross Way and the museum\u2019s collection:\r\ninviting contemporary artists like Elena Subach,\r\nLina Van Hulle, Daniel C. Muller, Ute Resch, Klaus\r\nVerscheure, tying in unique pieces from collections\r\nof MimDo Ittre, Sint-Andrieskerk Antwerpen,\r\nSint-Agatha Kloostererfgoed The Netherlands,\r\nSint-Lucas Archive Brussels, Transit Gallery\r\nMechelen, as well as private collectors,\r\nto create an immersive experience through\r\nsorrow, death and hope.","performers":"Swiss-Ukrainian artist and curator Denys Shantar","boxoffice_url":null,"website":"https:\/\/mmrk.be\/","email":"musea@basilicakoekelberg.be","phone_contact":null,"phone_booking":"+32 2 421 16 79","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.555967"},"it":{"name":"Cross-ing Way-s","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/mmrk.be\/","email":"musea@basilicakoekelberg.be","phone_contact":null,"phone_booking":"+32 2 421 16 79","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.555967"},"cn":{"name":"Cross-ing Way-s","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/mmrk.be\/","email":"musea@basilicakoekelberg.be","phone_contact":null,"phone_booking":"+32 2 421 16 79","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.555967"},"fr":{"name":"Cross-ing Way-s","shortdescr":"CROSS-ING WAY-S -Chemin de croix de la vie. Avec l'exposition CROSS-ING WAY-S \u00e0 la basilique de Koekelberg, curateur Shantar propose une vision innovante et contemporaine du chemin de croix. Avec des \u0153uvres d'Elena Subach, Lina Van Hulle, Daniel C. Muller, Ute Resch, Klaus Verscheure, Erzs\u00e9bet Baerveldt, Nikita Kadan, Sergey Bratkov, Johan Creten.","longdescr":"La tradition du Chemin de Croix a commenc\u00e9\r\ncomme une destination de p\u00e8lerinage en\r\nJ\u00e9rusalem, partant de la pr\u00e9tendue r\u00e9sidence\r\nofficielle de Ponce Pilate vers le mont Calvaire.\r\nAu 19i\u00e8me si\u00e8cle la repr\u00e9sentation de la derni\u00e8re\r\njourn\u00e9e de J\u00e9sus sur terre en tant qu\u2019homme,\r\nconstituait une partie importante des \u00e9glises\r\ncatholiques occidentales.Certaines \u00e9glises\r\ny ont ajout\u00e9 une 15i\u00e8me station non officielle.\r\nCROSS-ING WAY-S est un voyage tr\u00e8s personnel\r\net intime. Nous d\u00e9cidons qui nous sommes.\r\nSommes-nous les spectateurs ?\r\nLa m\u00e8re qui voit son enfant en difficult\u00e9?\r\nSommes-nous Simon ou Veronica qui\r\ndonnent un coup de main ?\r\nOu sommes-nous J\u00e9sus m\u00eame ?\r\nPeu importe avec qui nous nous identifions,\r\nnous attendons tous une r\u00e9surrection;\r\nparce que nous \u00ab sommes le sel de la terre \u00bb.\r\nDenys Shantar nous offre une vision actuelle\r\nsur le Chemin de Croix et la collection du mus\u00e9e,\r\nen invitant des artistes contemporains comme\r\nElena Subach, Lina Van Hulle, Daniel C. Muller,\r\nUte Resch, Klaus Verscheure, et en entrela\u00e7ant\r\ndes pi\u00e8ces uniques des collections de MimDo\r\nIttre, de l\u2019\u00e9glise Sint-Andries Antwerpen,\r\nSint-Agatha Kloostererfgoed des Pays-Bas,\r\nde l\u2019Archive Saint-Luc Bruxelles, Transit Gallery\r\nMechelen et des collections particuli\u00e8res,\r\npour cr\u00e9er une exp\u00e9rience immersive \u00e0 travers\r\nle chagrin, la mort et l\u2019esp\u00e9rance.","performers":"Le curateur et artiste suisse-ukrainien Denys Shantar","boxoffice_url":null,"website":"https:\/\/mmrk.be\/","email":"musea@basilicakoekelberg.be","phone_contact":null,"phone_booking":"+32 2 421 16 79","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.555967"},"sp":{"name":"Cross-ing Way-s","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/mmrk.be\/","email":"musea@basilicakoekelberg.be","phone_contact":null,"phone_booking":"+32 2 421 16 79","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.555967"},"nl":{"name":"Cross-ing Way-s","shortdescr":"CROSS-ING WAY-S - Kruisweg van het leven. Over verdriet, dood en hoop.\r\nMet de tentoonstelling CROSS-ING WAY-S in de Basiliek van Koekelberg biedt curator Shantar een vernieuwende en hedendaagse kijk op de Kruisweg. Met werken van o.a. Elena Subach, Lina Van Hulle, Daniel C. Muller, Ute Resch, Klaus Verscheure, Erzs\u00e9bet Baerveldt, Nikita Kadan, Sergey Bratkov, Johan Creten.","longdescr":"De traditie van de Kruisweg begon als een\r\nbedevaart in Jerusalem, van de plaats waarvan\r\nwordt aangenomen dat het de ambtswoning van\r\nPontius Pilatus was tot aan de laatste statie op de\r\nCalvarieberg. In de 19e eeuw werd de laatste dag\r\nvan Jezus als mens op aarde, als een belangrijk\r\nelement in veel Westerse Katholieke kerken.\r\nIn sommige kerken werd de verrijzenis\r\ntoegevoegd, als een niet-offici\u00eble 15e statie.\r\nCROSS-ING WAY-S is een heel persoonlijke\r\nen intiem te beleven reis. We kunnen zelf\r\nbeslissen wie we zijn.\r\nZijn we toeschouwers?\r\nDe moeder die haar kind ziet worstelen?\r\nZijn we Simon of Veronica die een helpende\r\nhand toesteken?\r\nOf zijn we de lijdende Jezus zelf?\r\nHet maakt niet uit wie we kiezen te zijn,\r\nwe verwachten allen een wederopstanding;\r\nuiteindelijk zijn we \u201chet zout der aarde\u201d.\r\nDenys Shantar biedt een vernieuwende en\r\nhedendaagse kijk op de Kruisweg en op de\r\ncollectie van het museum, door hedendaagse\r\nkunstenaars als Elena Subach, Lina Van Hulle,\r\nDaniel C. Muller, Ute Resch, Klaus Verscheure uit\r\nte nodigen en hun werken te verweven met unieke\r\nstukken uit de collecties van het MimDo Ittre, de\r\nSint-Andrieskerk Antwerpen, van het Sint-Agatha\r\nKloostererfgoed Nederland, van Archief Sint-\r\nLucas Brussel, van Transit Gallery Mechelen en uit\r\nparticuliere collecties. De bezoeker wordt volledig\r\nondergedompeld in verdriet, dood en hoop.","performers":"Zwitsers-Oekra\u00efense kunstenaar en curator Denys Shantar","boxoffice_url":null,"website":"https:\/\/mmrk.be\/","email":"musea@basilicakoekelberg.be","phone_contact":null,"phone_booking":"+32 2 421 16 79","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.555967"}},"place":{"id":246228,"translations":{"de":{"name":"Mus\u00e9e d'Art religieux moderne - Basilique de Koekelberg","address_street_name":"Parvis de la Basilique","address_street_number":"1","address_street_box":null,"email":"musea@basilicakoekelberg.be","website":"https:\/\/mmrk.be","phone_contact":"+32 2 421 16 79","phone_booking":null,"address_zip":"1083","address_city":"Ganshoren","address_line1":"Parvis de la Basilique, 1","address_line2":"1083 Ganshoren","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Mus\u00e9e d'Art religieux moderne - Basilique de Koekelberg","address_street_name":"Parvis de la Basilique","address_street_number":"1","address_street_box":null,"email":"musea@basilicakoekelberg.be","website":"https:\/\/mmrk.be","phone_contact":"+32 2 421 16 79","phone_booking":null,"address_zip":"1083","address_city":"Ganshoren","address_line1":"Parvis de la Basilique, 1","address_line2":"1083 Ganshoren","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Mus\u00e9e d'Art religieux moderne - Basilique de Koekelberg","address_street_name":"Parvis de la Basilique","address_street_number":"1","address_street_box":null,"email":"musea@basilicakoekelberg.be","website":"https:\/\/mmrk.be","phone_contact":"+32 2 421 16 79","phone_booking":null,"address_zip":"1083","address_city":"Ganshoren","address_line1":"Parvis de la Basilique, 1","address_line2":"1083 Ganshoren","description_web":"Koekelberg Basilica is home to the Museum of Modern Religious Art (MMRK).\r\n \r\nThe MMRK's extensive collection consists mainly of 20th-century paintings, sculptures and drawings with a religious or spiritual theme, realised by artists from Belgium, neighbouring countries, Poland, Armenia and the US. The collection grew out of the leading international collection built up by the West Flemish priest Jan Gekhiere before and after World War II. In 2007, the collection found shelter in the dome of Koekelberg Basilica. Since 2015, a modern scenography offers a renewed view of the collection.\r\n \r\nAlthough the museum is located in the National Basilica of Koekelberg, both are separate institutions. The MMRK is not focused on a religious mission. It focuses on modern and contemporary art with a particular inspiration, drawn from an ancient tradition, of and for people today. The MMRK stands for dialogue and diversity of forms of expression, allowing attention to be paid to \"encounter\" and \"openness of mind\". From the observation that religious words, images, symbols and rituals derive their power from their impact and from the fact that a religious story creates space for connection with a \"we\".\r\n \r\nEye-catchers of the collection include works by Servaes, a Christ statue in bronze by Permeke, two lithographs from Rouault's Miserere, the Crucified by Gustave Van de Woestijne, 7 original lithographs by Manessier depicting the Easter theme, 31 etchings by Joan Miro and a painting by Genevi\u00e8ve Asse and much more.\r\n \r\nvzw Friends of the Museum of Modern Religious Art\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Mus\u00e9e d'Art religieux moderne - Basilique de Koekelberg","address_street_name":"Parvis de la Basilique","address_street_number":"1","address_street_box":null,"email":"musea@basilicakoekelberg.be","website":"https:\/\/mmrk.be","phone_contact":"+32 2 421 16 79","phone_booking":null,"address_zip":"1083","address_city":"Ganshoren","address_line1":"Parvis de la Basilique, 1","address_line2":"1083 Ganshoren","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Mus\u00e9e d'Art religieux moderne - Basilique de Koekelberg","address_street_name":"Parvis de la Basilique","address_street_number":"1","address_street_box":null,"email":"musea@basilicakoekelberg.be","website":"https:\/\/mmrk.be","phone_contact":"+32 2 421 16 79","phone_booking":null,"address_zip":"1083","address_city":"Ganshoren","address_line1":"Parvis de la Basilique, 1","address_line2":"1083 Ganshoren","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"fr":{"name":"Mus\u00e9e d'Art religieux moderne - Basilique de Koekelberg","address_street_name":"Parvis de la Basilique","address_street_number":"1","address_street_box":null,"email":"musea@basilicakoekelberg.be","website":"https:\/\/mmrk.be","phone_contact":"+32 2 421 16 79","phone_booking":null,"address_zip":"1083","address_city":"Ganshoren","address_line1":"Parvis de la Basilique, 1","address_line2":"1083 Ganshoren","description_web":"La Basilique de Koekelberg accueille le Mus\u00e9e d'art religieux moderne (MMRK).\r\n \r\nLa vaste collection du MMRK se compose principalement de peintures, de sculptures et de dessins du XXe si\u00e8cle ayant un th\u00e8me religieux ou spirituel et r\u00e9alis\u00e9s par des artistes de Belgique, des pays voisins, de Pologne, d'Arm\u00e9nie et des \u00c9tats-Unis. La collection s'est d\u00e9velopp\u00e9e \u00e0 partir de la collection internationale de premier plan constitu\u00e9e par le pr\u00eatre de Flandre occidentale Jan Gekhiere avant et apr\u00e8s la Seconde Guerre mondiale. En 2007, la collection a trouv\u00e9 refuge dans le d\u00f4me de la basilique de Koekelberg. Depuis 2015, une sc\u00e9nographie moderne offre une vision renouvel\u00e9e de la collection.\r\n \r\nBien que le mus\u00e9e soit situ\u00e9 dans la Basilique nationale de Koekelberg, les deux institutions sont distinctes. Le MMRK n'est pas ax\u00e9 sur une mission religieuse. Il se concentre sur l'art moderne et contemporain avec une inspiration particuli\u00e8re, tir\u00e9e d'une tradition ancienne, de et pour les gens d'aujourd'hui. Le MMRK pr\u00f4ne le dialogue et la diversit\u00e9 des formes d'expression, ce qui permet de pr\u00eater attention \u00e0 la \"rencontre\" et \u00e0 \"l'ouverture d'esprit\". Le MMRK part du constat que les mots, les images, les symboles et les rituels religieux tirent leur force de leur impact et du fait qu'une histoire religieuse cr\u00e9e un espace de connexion avec un \"nous\".\r\n \r\nLa collection comprend des \u0153uvres de Servaes, une statue du Christ en bronze de Permeke, deux lithographies du Miserere de Rouault, le Crucifi\u00e9 de Gustave Van de Woestijne, 7 lithographies originales de Manessier sur le th\u00e8me de P\u00e2ques, 31 gravures de Joan Miro, une peinture de Genevi\u00e8ve Asse et bien d'autres choses encore. \r\n\r\nasbl Amis du Mus\u00e9e d'art moderne religieux\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Mus\u00e9e d'Art religieux moderne - Basilique de Koekelberg","address_street_name":"Parvis de la Basilique","address_street_number":"1","address_street_box":null,"email":"musea@basilicakoekelberg.be","website":"https:\/\/mmrk.be","phone_contact":"+32 2 421 16 79","phone_booking":null,"address_zip":"1083","address_city":"Ganshoren","address_line1":"Parvis de la Basilique, 1","address_line2":"1083 Ganshoren","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Museum Moderne Religieuze Kunst - Basiliek van Koekelberg","address_street_name":"Basiliekvoorplein","address_street_number":"1","address_street_box":null,"email":"musea@basilicakoekelberg.be","website":"https:\/\/mmrk.be","phone_contact":"+32 2 421 16 79","phone_booking":null,"address_zip":"1083","address_city":"Ganshoren","address_line1":"Basiliekvoorplein, 1","address_line2":"1083 Ganshoren","description_web":"De basiliek van Koekelberg biedt onderdak aan het Museum van Moderne Religieuze Kunst (MMRK).\r\n \r\nDe uitgebreide collectie van het MMRK bestaat hoofdzakelijk uit 20ste-eeuwse schilderijen, beeldhouwwerken en tekeningen met een religieus of spiritueel thema, gerealiseerd door kunstenaars uit Belgi\u00eb, uit de buurlanden, Polen, Armeni\u00eb en de VS. De collectie ontstond uit de toonaangevende internationale verzameling die de West-Vlaamse priester Jan Gekhiere voor en na de Tweede Wereldoorlog had opgebouwd. In 2007 vond de collectie onderdak in de koepel van de basiliek van Koekelberg. Sinds 2015 biedt een moderne scenografie een vernieuwde kijk op de collectie.\r\n \r\nHoewel het museum gevestigd is in de Nationale Basiliek van Koekelberg zijn beiden afzonderlijke instellingen. Het MMRK is niet gericht op een religieuze missie. Ze richt zich op moderne en hedendaagse kunst met een bepaalde inspiratie, afkomstig uit een oude traditie, van en voor de mens van nu. Het MMRK staat voor dialoog en diversiteit van uitdrukkingsvormen, waardoor aandacht kan worden besteed aan \"ontmoeting\" en \"openheid van geest\". Vanuit de constatering dat religieuze woorden, beelden, symbolen en rituelen hun kracht ontlenen aan hun impact en aan het feit dat een religieus verhaal ruimte schept voor verbinding met een \"wij\".\r\n \r\nBlikvangers van de collectie zijn onder andere werken van Servaes, een Christusbeeld in brons van Permeke, twee litho's uit Rouault\u2019s Miserere, de gekruisigde van Gustave Van de Woestijne, 7 originele litho's van Manessier die het Paasthema vertolken, 31 etsen van Joan Miro en een schilderij van Genevi\u00e8ve Asse en veel meer.\r\n \r\nvzw Vrienden van het Museum Moderne Religieuze Kunst\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[20],"translations":{"de":["Norden"],"pt":[null],"en":["North"],"it":["Nord"],"cn":[null],"fr":["Nord"],"sp":["Norte"],"nl":["Noord"]}},"neca":null,"facebook_id":null,"backoffice_id":8466,"location":{"lat":50.86730512,"lon":4.31613925},"region":"brussels","last_updated_at":"2023-08-14T16:41:27+02:00","published_at":"2013-10-19T01:24:12+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":246228,"translations":{"de":{"name":"Mus\u00e9e d'Art religieux moderne - Basilique de Koekelberg","address_street_name":"Parvis de la Basilique","address_street_number":"1","address_street_box":null,"email":"musea@basilicakoekelberg.be","website":"https:\/\/mmrk.be","phone_contact":"+32 2 421 16 79","phone_booking":null,"address_zip":"1083","address_city":"Ganshoren","address_line1":"Parvis de la Basilique, 1","address_line2":"1083 Ganshoren","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Mus\u00e9e d'Art religieux moderne - Basilique de Koekelberg","address_street_name":"Parvis de la Basilique","address_street_number":"1","address_street_box":null,"email":"musea@basilicakoekelberg.be","website":"https:\/\/mmrk.be","phone_contact":"+32 2 421 16 79","phone_booking":null,"address_zip":"1083","address_city":"Ganshoren","address_line1":"Parvis de la Basilique, 1","address_line2":"1083 Ganshoren","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Mus\u00e9e d'Art religieux moderne - Basilique de Koekelberg","address_street_name":"Parvis de la Basilique","address_street_number":"1","address_street_box":null,"email":"musea@basilicakoekelberg.be","website":"https:\/\/mmrk.be","phone_contact":"+32 2 421 16 79","phone_booking":null,"address_zip":"1083","address_city":"Ganshoren","address_line1":"Parvis de la Basilique, 1","address_line2":"1083 Ganshoren","description_web":"Koekelberg Basilica is home to the Museum of Modern Religious Art (MMRK).\r\n \r\nThe MMRK's extensive collection consists mainly of 20th-century paintings, sculptures and drawings with a religious or spiritual theme, realised by artists from Belgium, neighbouring countries, Poland, Armenia and the US. The collection grew out of the leading international collection built up by the West Flemish priest Jan Gekhiere before and after World War II. In 2007, the collection found shelter in the dome of Koekelberg Basilica. Since 2015, a modern scenography offers a renewed view of the collection.\r\n \r\nAlthough the museum is located in the National Basilica of Koekelberg, both are separate institutions. The MMRK is not focused on a religious mission. It focuses on modern and contemporary art with a particular inspiration, drawn from an ancient tradition, of and for people today. The MMRK stands for dialogue and diversity of forms of expression, allowing attention to be paid to \"encounter\" and \"openness of mind\". From the observation that religious words, images, symbols and rituals derive their power from their impact and from the fact that a religious story creates space for connection with a \"we\".\r\n \r\nEye-catchers of the collection include works by Servaes, a Christ statue in bronze by Permeke, two lithographs from Rouault's Miserere, the Crucified by Gustave Van de Woestijne, 7 original lithographs by Manessier depicting the Easter theme, 31 etchings by Joan Miro and a painting by Genevi\u00e8ve Asse and much more.\r\n \r\nvzw Friends of the Museum of Modern Religious Art\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Mus\u00e9e d'Art religieux moderne - Basilique de Koekelberg","address_street_name":"Parvis de la Basilique","address_street_number":"1","address_street_box":null,"email":"musea@basilicakoekelberg.be","website":"https:\/\/mmrk.be","phone_contact":"+32 2 421 16 79","phone_booking":null,"address_zip":"1083","address_city":"Ganshoren","address_line1":"Parvis de la Basilique, 1","address_line2":"1083 Ganshoren","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Mus\u00e9e d'Art religieux moderne - Basilique de Koekelberg","address_street_name":"Parvis de la Basilique","address_street_number":"1","address_street_box":null,"email":"musea@basilicakoekelberg.be","website":"https:\/\/mmrk.be","phone_contact":"+32 2 421 16 79","phone_booking":null,"address_zip":"1083","address_city":"Ganshoren","address_line1":"Parvis de la Basilique, 1","address_line2":"1083 Ganshoren","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"fr":{"name":"Mus\u00e9e d'Art religieux moderne - Basilique de Koekelberg","address_street_name":"Parvis de la Basilique","address_street_number":"1","address_street_box":null,"email":"musea@basilicakoekelberg.be","website":"https:\/\/mmrk.be","phone_contact":"+32 2 421 16 79","phone_booking":null,"address_zip":"1083","address_city":"Ganshoren","address_line1":"Parvis de la Basilique, 1","address_line2":"1083 Ganshoren","description_web":"La Basilique de Koekelberg accueille le Mus\u00e9e d'art religieux moderne (MMRK).\r\n \r\nLa vaste collection du MMRK se compose principalement de peintures, de sculptures et de dessins du XXe si\u00e8cle ayant un th\u00e8me religieux ou spirituel et r\u00e9alis\u00e9s par des artistes de Belgique, des pays voisins, de Pologne, d'Arm\u00e9nie et des \u00c9tats-Unis. La collection s'est d\u00e9velopp\u00e9e \u00e0 partir de la collection internationale de premier plan constitu\u00e9e par le pr\u00eatre de Flandre occidentale Jan Gekhiere avant et apr\u00e8s la Seconde Guerre mondiale. En 2007, la collection a trouv\u00e9 refuge dans le d\u00f4me de la basilique de Koekelberg. Depuis 2015, une sc\u00e9nographie moderne offre une vision renouvel\u00e9e de la collection.\r\n \r\nBien que le mus\u00e9e soit situ\u00e9 dans la Basilique nationale de Koekelberg, les deux institutions sont distinctes. Le MMRK n'est pas ax\u00e9 sur une mission religieuse. Il se concentre sur l'art moderne et contemporain avec une inspiration particuli\u00e8re, tir\u00e9e d'une tradition ancienne, de et pour les gens d'aujourd'hui. Le MMRK pr\u00f4ne le dialogue et la diversit\u00e9 des formes d'expression, ce qui permet de pr\u00eater attention \u00e0 la \"rencontre\" et \u00e0 \"l'ouverture d'esprit\". Le MMRK part du constat que les mots, les images, les symboles et les rituels religieux tirent leur force de leur impact et du fait qu'une histoire religieuse cr\u00e9e un espace de connexion avec un \"nous\".\r\n \r\nLa collection comprend des \u0153uvres de Servaes, une statue du Christ en bronze de Permeke, deux lithographies du Miserere de Rouault, le Crucifi\u00e9 de Gustave Van de Woestijne, 7 lithographies originales de Manessier sur le th\u00e8me de P\u00e2ques, 31 gravures de Joan Miro, une peinture de Genevi\u00e8ve Asse et bien d'autres choses encore. \r\n\r\nasbl Amis du Mus\u00e9e d'art moderne religieux\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Mus\u00e9e d'Art religieux moderne - Basilique de Koekelberg","address_street_name":"Parvis de la Basilique","address_street_number":"1","address_street_box":null,"email":"musea@basilicakoekelberg.be","website":"https:\/\/mmrk.be","phone_contact":"+32 2 421 16 79","phone_booking":null,"address_zip":"1083","address_city":"Ganshoren","address_line1":"Parvis de la Basilique, 1","address_line2":"1083 Ganshoren","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Museum Moderne Religieuze Kunst - Basiliek van Koekelberg","address_street_name":"Basiliekvoorplein","address_street_number":"1","address_street_box":null,"email":"musea@basilicakoekelberg.be","website":"https:\/\/mmrk.be","phone_contact":"+32 2 421 16 79","phone_booking":null,"address_zip":"1083","address_city":"Ganshoren","address_line1":"Basiliekvoorplein, 1","address_line2":"1083 Ganshoren","description_web":"De basiliek van Koekelberg biedt onderdak aan het Museum van Moderne Religieuze Kunst (MMRK).\r\n \r\nDe uitgebreide collectie van het MMRK bestaat hoofdzakelijk uit 20ste-eeuwse schilderijen, beeldhouwwerken en tekeningen met een religieus of spiritueel thema, gerealiseerd door kunstenaars uit Belgi\u00eb, uit de buurlanden, Polen, Armeni\u00eb en de VS. De collectie ontstond uit de toonaangevende internationale verzameling die de West-Vlaamse priester Jan Gekhiere voor en na de Tweede Wereldoorlog had opgebouwd. In 2007 vond de collectie onderdak in de koepel van de basiliek van Koekelberg. Sinds 2015 biedt een moderne scenografie een vernieuwde kijk op de collectie.\r\n \r\nHoewel het museum gevestigd is in de Nationale Basiliek van Koekelberg zijn beiden afzonderlijke instellingen. Het MMRK is niet gericht op een religieuze missie. Ze richt zich op moderne en hedendaagse kunst met een bepaalde inspiratie, afkomstig uit een oude traditie, van en voor de mens van nu. Het MMRK staat voor dialoog en diversiteit van uitdrukkingsvormen, waardoor aandacht kan worden besteed aan \"ontmoeting\" en \"openheid van geest\". Vanuit de constatering dat religieuze woorden, beelden, symbolen en rituelen hun kracht ontlenen aan hun impact en aan het feit dat een religieus verhaal ruimte schept voor verbinding met een \"wij\".\r\n \r\nBlikvangers van de collectie zijn onder andere werken van Servaes, een Christusbeeld in brons van Permeke, twee litho's uit Rouault\u2019s Miserere, de gekruisigde van Gustave Van de Woestijne, 7 originele litho's van Manessier die het Paasthema vertolken, 31 etsen van Joan Miro en een schilderij van Genevi\u00e8ve Asse en veel meer.\r\n \r\nvzw Vrienden van het Museum Moderne Religieuze Kunst\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":8466,"location":{"lat":50.86730512,"lon":4.31613925},"last_updated_at":"2023-08-14T16:41:27+02:00","published_at":"2013-10-19T01:24:12+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"poster","link":"https:\/\/agendabrussels2.imgix.net\/a13fcf30fed74530471156d8ae4a1f3bb412c9b7.jpg","width":2500,"height":3535,"ratio":0.71,"oEmbed_height":3535,"oEmbed_width":2500,"translations":{"de":{"title":"Cross-ing Way-s","copyright":null},"pt":{"title":"Cross-ing Way-s","copyright":null},"en":{"title":"Cross-ing Way-s","copyright":null},"it":{"title":"Cross-ing Way-s","copyright":null},"cn":{"title":"Cross-ing Way-s","copyright":null},"fr":{"title":"Cross-ing Way-s","copyright":null},"sp":{"title":"Cross-ing Way-s","copyright":null},"nl":{"title":"Cross-ing Way-s","copyright"