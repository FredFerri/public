ast_updated_at":"2024-11-22T01:00:55+01:00","published_at":"2024-10-31T12:47:15+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":310815,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"other","ranking":0.311765953881872,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{}},"translations":{"de":{"name":"\"Encuentro de sue\u00f1os\" by Nathalie Saey & Sydney Fruy","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.instagram.com\/27.conceptgallery\/","email":"martine.l-l@alexisfilms.com","phone_contact":"+32 473 96 17 18","phone_booking":"+32 473 96 17 18","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700003239"},"pt":{"name":"\"Encuentro de sue\u00f1os\" by Nathalie Saey & Sydney Fruy","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.instagram.com\/27.conceptgallery\/","email":"martine.l-l@alexisfilms.com","phone_contact":"+32 473 96 17 18","phone_booking":"+32 473 96 17 18","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700003239"},"en":{"name":"\"Encuentro de sue\u00f1os\" by Nathalie Saey & Sydney Fruy","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.instagram.com\/27.conceptgallery\/","email":"martine.l-l@alexisfilms.com","phone_contact":"+32 473 96 17 18","phone_booking":"+32 473 96 17 18","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700003239"},"it":{"name":"\"Encuentro de sue\u00f1os\" by Nathalie Saey & Sydney Fruy","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.instagram.com\/27.conceptgallery\/","email":"martine.l-l@alexisfilms.com","phone_contact":"+32 473 96 17 18","phone_booking":"+32 473 96 17 18","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700003239"},"cn":{"name":"\"Encuentro de sue\u00f1os\" by Nathalie Saey & Sydney Fruy","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.instagram.com\/27.conceptgallery\/","email":"martine.l-l@alexisfilms.com","phone_contact":"+32 473 96 17 18","phone_booking":"+32 473 96 17 18","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700003239"},"fr":{"name":"\"Encuentro de sue\u00f1os\" by Nathalie Saey & Sydney Fruy","shortdescr":"Nathalie Saey, artiste peintre \u00e0 la sensibilit\u00e9 vibrante, unit son chemin avec celui du jeune artiste-designer-plasticien Sydney Fruy, passionn\u00e9 par la m\u00e9tamorphose du m\u00e9tal.\u200b\n\u00c0 travers une exposition commune, Nathalie et Sydney ouvrent les portes de deux univers po\u00e9tiques distincts, o\u00f9 la peinture et le m\u00e9tal se croisent pour raconter des histoires uniques.","longdescr":"\"Encuentro de sue\u00f1os\" by Nathalie Saey & Sydney Fruy\n\nChers amis, amateurs d'art et esprits curieux,\n\nLes Murmures de l'Art\n\nNathalie Saey, artiste peintre \u00e0 la sensibilit\u00e9 vibrante, unit son chemin avec celui du jeune artiste-designer-plasticien Sydney Fruy, passionn\u00e9 par la m\u00e9tamorphose du m\u00e9tal.\u200b\n\n\u00c0 travers une exposition commune, Nathalie et Sydney ouvrent les portes de deux univers po\u00e9tiques distincts, o\u00f9 la peinture et le m\u00e9tal se croisent pour raconter des histoires uniques. Leurs \u0153uvres r\u00e9centes, v\u00e9ritables cadeaux artistiques, enrichissent l\u2019exp\u00e9rience et nous plongent dans un monde o\u00f9 la peinture, le m\u00e9tal et la po\u00e9sie s\u2019entrelacent avec \u00e9l\u00e9gance.\n\nLes \u0153uvres de Nathalie et Sydney invitent les spectateurs \u00e0 parcourir des mondes imaginaires o\u00f9 l\u2019\u00e9motion et la beaut\u00e9 se rencontrent, tout en refl\u00e9tant leur vision commune de l\u2019art.\n\nIntitul\u00e9e \"Encuentro de sue\u00f1os\", l\u2019exposition \u00e9voque la rencontre des r\u00eaves. Quel lien avec l\u2019Espagne ?  Pour Nathalie et Sydney, l\u2019Espagne est un r\u00e9servoir d\u2019\u00e9motions et de souvenirs intenses. Nathalie, oscillant entre l\u2019\u00e9clat chaleureux de l\u2019Andalousie et l\u2019\u00e9nergie bouillonnante de Bruxelles, laisse \u00e9clater son humour et sa po\u00e9sie dans des toiles XXL. Ses peintures, v\u00e9ritables invitations au voyage, s'animent d'une palette de couleurs vibrantes et de nuances d\u00e9licates, insufflant tendresse et innocence de l\u2019enfance. Avec espi\u00e8glerie, chaque nuance chuchote une r\u00eaverie, \u00e9clairant ses \u0153uvres d\u2019un dynamisme f\u00e9minin et d\u2019un optimisme rayonnant qui r\u00e9veille l'enfant cach\u00e9 en chacun de nous.\n\nDe son c\u00f4t\u00e9, Sydney s\u2019inspire de la beaut\u00e9 sauvage de Formentera. Dans son univers, le m\u00e9tal prend vie, chaque courbe et surface polie exprimant mouvement et impact. Fascin\u00e9 par la lumi\u00e8re, il explore sans fin les possibilit\u00e9s de ce mat\u00e9riau, transformant la mati\u00e8re brute en \u0153uvres d\u2019art captivantes. Avec pr\u00e9cision et puret\u00e9, Sydney nous invite \u00e0 d\u00e9couvrir la magie du quotidien et la po\u00e9sie des formes, en harmonie avec son environnement.\n\nDu jeudi 31 octobre au lundi 2 d\u00e9cembre \u00e0 la Gallery Twenty Seven, un \u00e9crin d\u00e9di\u00e9 \u00e0 la cr\u00e9ation belge contemporaine, au c\u0153ur vibrant de Bruxelles, 27, Rue de Suisse - 1060 Saint-Gilles.\n\n\u00c0 tr\u00e8s bient\u00f4t,\n\nTWENTY SEVEN \u2728 Votre destination artistique \u00e0 Bruxelles !","performers":"\"Encuentro de sue\u00f1os\" by Nathalie Saey & Sydney Fruy \n","boxoffice_url":null,"website":"https:\/\/www.instagram.com\/27.conceptgallery\/","email":"martine.l-l@alexisfilms.com","phone_contact":"+32 473 96 17 18","phone_booking":"+32 473 96 17 18","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700003239"},"sp":{"name":"\"Encuentro de sue\u00f1os\" by Nathalie Saey & Sydney Fruy","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.instagram.com\/27.conceptgallery\/","email":"martine.l-l@alexisfilms.com","phone_contact":"+32 473 96 17 18","phone_booking":"+32 473 96 17 18","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700003239"},"nl":{"name":"\"Encuentro de sue\u00f1os\" by Nathalie Saey & Sydney Fruy","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.instagram.com\/27.conceptgallery\/","email":"martine.l-l@alexisfilms.com","phone_contact":"+32 473 96 17 18","phone_booking":"+32 473 96 17 18","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700003239"}},"place":{"id":50002493,"translations":{"de":{"name":"Twenty Seven Concept Gallery","address_street_name":"Rue de Suisse","address_street_number":"27","address_street_box":null,"email":"martine.l-l@alexisfilms.com","website":"https:\/\/www.instagram.com\/27.conceptgallery\/","phone_contact":"+32 473 96 17 18","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue de Suisse, 27","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Twenty Seven Concept Gallery","address_street_name":"Rue de Suisse","address_street_number":"27","address_street_box":null,"email":"martine.l-l@alexisfilms.com","website":"https:\/\/www.instagram.com\/27.conceptgallery\/","phone_contact":"+32 473 96 17 18","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":