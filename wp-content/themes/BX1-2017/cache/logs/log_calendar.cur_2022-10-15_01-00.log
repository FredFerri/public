slations":{}},"tags":[],"accessibilities":{"list":[255,263,265],"translations":{"fr":["Accessible","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9"],"nl":["Toegankelijk","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet"],"en":["Accessible","Accessible to pedestrians with mobility aids","Adapted toilet"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-11T01:36:29+02:00","published_at":"2022-10-03T15:43:03+02:00","backoffice_id":262980,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":1.5874010519682},{"id":541151,"date_start":"2022-10-30","date_end":"2022-10-30","date_next":"2022-10-30","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen"}},"others":{"list":[109],"translations":{"fr":["Espaces verts"],"nl":["Groene zones"],"en":["Green spaces"],"de":["Gr\u00fcnfl\u00e4chen"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Dimanche \u00e0 v\u00e9lo - Dieweg, Uccle","shortdescr":"Les derniers dimanches du mois, nous vous invitons \u00e0 explorer une nouvelle partie de la ville et de la p\u00e9riph\u00e9rie de Bruxelles \u00e0 v\u00e9lo. Un(e) de nos guides pr\u00e9pare un trajet relaxant d'environ 25 km. L\u2019id\u00e9al pour des conversations et rencontres agr\u00e9ables avec d'autres Bruxellois \u00e0 v\u00e9lo. En octobre nous allons \u00e0 la d\u00e9couverte du Dieweg \u00e0 Uccle.","longdescr":"Les derniers dimanches du mois, vous pouvez explorer une partie de la ville et de la p\u00e9riph\u00e9rie de Bruxelles \u00e0 v\u00e9lo. Chaque mois, un(e) de nos guides pr\u00e9pare un tour \u00e0 v\u00e9lo relaxant et l\u00e9g\u00e8rement sportif d'environ 25 km. Id\u00e9al pour les cyclistes d\u00e9butants ou pour des conversations et rencontres agr\u00e9ables avec d'autres bruxellois \u00e0 v\u00e9lo.\r\n\r\nLe d\u00e9part est \u00e0 10h00 et nous serons de retour au Grand Hospice autour de 13h.\r\n\r\nS\u2019inscrire est obligatoire. Vous pouvez envoyer un mail \u00e0 info@cactus.brussels.\r\n\r\n#Brussel\u00e0v\u00e9lo","performers":null,"boxoffice_url":null,"website":"http:\/\/www.cactus.brussels","email":"info@cactus.brussels","phone_contact":null,"phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.541151"},"nl":{"name":"Dimanche \u00e0 v\u00e9lo - Dieweg, Ukkel","shortdescr":"De laatste zondag van elke maand nodigen we je uit om een nieuw deel van de stad en de Brusselse rand te verkennen met de fiets. Een van onze gidsen stippelt een leuke route van zo'n 25 km uit. Ideaal voor gezellige gesprekken en ontmoetingen met andere Brusselse fietsers. In oktober ontdekken we de Dieweg in Ukkel.","longdescr":"De laatste zondag van de maand kan je met Cactus op ontdekking door Brussel en de Brusselse rand. Elke maand bereidt \u00e9\u00e9n van onze gidsen een ontspannende, licht sportieve fietstocht van zo\u2019n 25 km voor. Ideaal voor beginnende fietsers en een gezellige babbels en ontmoetingen met andere Brusselse op de fiets.\r\n\r\nWe vertrekken om 10u00 en zijn omstreek 13u terug aan de Grand Hospice.\r\n\r\nInschrijven is verplicht en kan door een bericht te sturen naar info@cactus.brussels.\r\n\r\n#Brussel\u00e0v\u00e9lo","performers":null,"boxoffice_url":null,"website":"http:\/\/www.cactus.brussels","email":"info@cactus.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.541151"},"en":{"name":"Dimanche \u00e0 v\u00e9lo - Dieweg, Ukkel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.541151"},"de":{"name":"Dimanche \u00e0 v\u00e9lo - Dieweg, Ukkel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.541151"},"it":{"name":"Dimanche \u00e0 v\u00e9lo - Dieweg, Ukkel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.541151"},"sp":{"name":"Dimanche \u00e0 v\u00e9lo - Dieweg, Ukkel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.541151"},"pt":{"name":"Dimanche \u00e0 v\u00e9lo - Dieweg, Ukkel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.541151"},"cn":{"name":"Dimanche \u00e0 v\u00e9lo - Dieweg, Ukkel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.541151"}},"place":{"id":276966,"translations":{"fr":{"name":"Grand Hospice","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"hospice@pali-pali.com","website":"http:\/\/grand-hospice.brussels","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 7","address_line2":"1000 Bruxelles","description_web":"Projet d\u2019occupation temporaire du site de l'Hospice Pacheco. Rejoignez-nous du lundi au dimanche pour profiter de ce petit havre de paix en plein centre de Bruxelles.\r\nLe projet, g\u00e9r\u00e9 par PaliPali, prend place jusqu\u2019en d\u00e9cembre 2023. Pour faire vivre ce petit oasis de verdure, Pali Pali s\u2019est associ\u00e9 \u00e0 Jardin afin de g\u00e9rer la guinguette du site. L\u2019id\u00e9e est de mettre \u00e0 disposition des \u00e9quipements pour l\u2019ensemble du quartier selon deux principes : cr\u00e9er du lien et vivre ensemble.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Grand Hospice","address_street_name":"Grootgodshuisstraat","address_street_number":"7","address_street_box":null,"email":"hospice@pali-pali.com","website":"http:\/\/grand-hospice.brussels","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Grootgodshuisstraat, 7","address_line2":"1000 Brussel","description_web":"In afwachting van de grote renovatie die nodig is om een complex van wooneenheden en gemeenschapsdiensten te cre\u00ebren, heeft het Brusselse OCMW beslist het Hospice Pacheco ter beschikking te stellen voor een vernieuwend project met een sterke sociale en culturele ori\u00ebntatie.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Grand Hospice","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"hospice@pali-pali.com","website":"http:\/\/grand-hospice.brussels","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue du Grand Hospice, 7","address_line2":"1000 Brussels","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Grand Hospice","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":nul