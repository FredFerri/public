prices":[],"date_exceptions":[],"closing_days":[],"child_events":[],"parent_events":[],"accessibilities":[],"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[]},{"id":5700000361,"date_start":"2024-09-27","date_end":"2024-09-27","date_next":"2024-09-27","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-08-31T02:00:04+02:00","published_at":"2024-08-23T09:31:44+02:00","publication_state":"published","date_embargo":"2024-08-31","show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":306205,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"misc","ranking":1,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":84,"translations":{"de":"Verschiedenes","pt":null,"en":"Various","it":"Varie","cn":null,"fr":"Divers","sp":"Varios","nl":"Varia"}},"others":{"list":[260],"translations":{"de":["Conversations with authors"],"pt":[null],"en":["Conversations with authors"],"it":["Conversations with authors"],"cn":[null],"fr":["Rencontres"],"sp":["Conversations with authors"],"nl":["Meet-and-greets"]}}},"translations":{"de":{"name":"Regularisation, The Only Solution","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/famefestival.be","email":"info@famefestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700000361"},"pt":{"name":"Regularisation, The Only Solution","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/famefestival.be","email":"info@famefestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700000361"},"en":{"name":"Regularisation, The Only Solution","shortdescr":"Choir and discussion followed by a meal to highlight the political demands of undocumented migrants in Belgium.","longdescr":"Join les Voix de la R\u00e9gularisation for a discussion led by women from the Comit\u00e9 des Femmes Sans Papiers, followed by a concert by the undocumented women's choir. The event will highlight the political demands of undocumented migrants in Belgium and demand the immediate regularisation of their immigration status. In the face of the rise of the far right and the tightening of migration policies in Europe, the discussion will address global borders and the systemic oppression and violence experienced by those seeking a better life. Together, we will imagine a borderless future where migration is recognised as a natural part of society. Following the discussion, the women's choir of the Comit\u00e9 de Femmes Sans Papiers will perform songs of protest and hope, calling for a new world where migrants can live in peace and dignity.","performers":null,"boxoffice_url":null,"website":"http:\/\/famefestival.be","email":"info@famefestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700000361"},"it":{"name":"Regularisation, The Only Solution","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/famefestival.be","email":"info@famefestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700000361"},"cn":{"name":"Regularisation, The Only Solution","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/famefestival.be","email":"info@famefestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700000361"},"fr":{"name":"Une Seule Solution, la R\u00e9gularisation","shortdescr":"Chorale et discussion suivies d\u2019un repas pour mettre en lumi\u00e8re les revendications politiques des migrants sans papiers en Belgique.","longdescr":"Rejoignez les Voix de la R\u00e9gularisation pour une discussion anim\u00e9e par les femmes du Comit\u00e9 des Femmes Sans Papiers, suivi d\u2019un concert de la chorale de femmes sans papiers. Cet \u00e9v\u00e9nement mettra en lumi\u00e8re les revendications politiques des migrants sans papiers en Belgique, exigeant la r\u00e9gularisation imm\u00e9diate de leur statut migratoire. Face \u00e0 la mont\u00e9e de l'extr\u00eame droite et au durcissement des politiques migratoires en Europe, la discussion d\u00e9noncera les violences et l'oppression syst\u00e9mique inflig\u00e9es par les fronti\u00e8res \u00e0 ceux qui cherchent une meilleure vie. Nous imaginerons ensemble un avenir sans fronti\u00e8res, o\u00f9 la migration est reconnue comme une partie naturelle de la soci\u00e9t\u00e9. Suivant la discussion, le ch\u0153ur des femmes du Comit\u00e9 de Femmes Sans Papiers interpr\u00e9tera des chants de proteste et d'espoir, appelant \u00e0 un monde nouveau o\u00f9 les migrants vivent en paix et dignit\u00e9.","performers":"Comit\u00e9 des Femmes Sans Papiers","boxoffice_url":null,"website":"http:\/\/famefestival.be","email":"info@famefestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700000361"},"sp":{"name":"Regularisation, The Only Solution","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/famefestival.be","email":"info@famefestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700000361"},"nl":{"name":"E\u00e9n Oplossing, Regularisatie","shortdescr":"Koor en discussie gevolgd door een maaltijd om de politieke eisen van migranten zonder papieren in Belgi\u00eb onder de aandacht te brengen.","longdescr":"Kom naar de Voix de la R\u00e9gularisation voor een gesprek geleid door vrouwen van het Comit\u00e9 des Femmes Sans Papiers, gevolgd door een concert van het vrouwenkoor zonder papieren. Het evenement zal de aandacht vestigen op de politieke eisen van migranten zonder papieren in Belgi\u00eb voor onmiddellijke regularisatie van hun immigratiestatus. \nIn het licht van de opkomst van extreemrechts en de verharding van het migratiebeleid in Europa, zal de bespreking het geweld en de systematische onderdrukking aan de kaak stellen die de grenzen berokkenen aan mensen die op zoek zijn naar een beter leven. Samen zullen we ons een toekomst zonder grenzen voorstellen, waarin migratie wordt erkend als een natuurlijk onderdeel van de samenleving. Na de discussie zal het vrouwenkoor van het Comit\u00e9 de Femmes Sans Papiers protest- en hoopliederen brengen, waarin wordt opgeroepen tot een nieuwe wereld waarin migranten in vrede en waardigheid kunnen leven.","performers":null,"boxoffice_url":null,"website":"http:\/\/famefestival.be","email":"info@famefestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700000361"}},"place":{"id":50002227,"translations":{"de":{"name":"Espace Magh","address_street_name":"Rue du Poin\u00e7on","address_street_number":"17","address_street_box":null,"email":"info@espacemagh.be","website":"www.espacemagh.be","phone_contact":"+32 2 274 05 10","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Poin\u00e7on, 17","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Espace Magh","address_street_name":"Rue du Poin\u00e7on","address_street_number":"17","address_street_box":null,"email":"info@espacemagh.be","website":"www.espacemagh.be","phone_contact":"+32