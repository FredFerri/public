days":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":74,"translations":{"fr":"Sport","nl":"Sport","en":"Sport","de":"Sport","it":"Sport","sp":"Deporte","pt":null,"cn":null}},"others":{"list":[160,76],"translations":{"fr":["Manifestation sportive","Athl\u00e9tisme et Cyclisme"],"nl":["Sportmanifestatie","Atletiek en wielrennen"],"en":["Sporting event","Athletics and cycling"],"de":["Sportveranstaltung","Leichtathletik & Radfahren"],"it":["Manifestazioni sportive","Atletica e ciclismo"],"sp":["Evento deportivo","Atletismo y ciclismo"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"hey! telecom Roller Bike Parade","shortdescr":"La hey! telecom Roller Bike Parade revient pour une nouvelle \u00e9dition en 2023 ! Encadr\u00e9 par nos staffeurs exp\u00e9riment\u00e9s, venez d\u00e9couvrir Bruxelles tout en roulant au rythme des platines de nos Dj\u2019s !","longdescr":"Envie de rouler sur les grands boulevards ou les petites rues de Bruxelles en rollers, skateboard, ou v\u00e9lo, le tout sans aucune voiture autour de vous ? Alors, rejoignez la hey! telecom Roller Bike Parade tous les vendredis de l'\u00e9t\u00e9 \u00e0 Bruxelles !\r\n\r\nLa hey! telecom Roller Bike Parade est un concept ludique et original qui invite les participants \u00e0 venir en roller, v\u00e9lo, skateboard, monowheel, longboard ou encore trottinette \u00e9lectrique pour envahir les rues de la ville durant une soir\u00e9e.\r\n\r\nDeux parcours sont pr\u00e9vus lors de chaque parade : l\u2019un pour les d\u00e9butants (environ 5 km) et l\u2019autre pour les plus sportifs d\u2019entre vous (environ 15km). Entre amis, en famille ou seul, la parade c\u2019est pour tout le monde!\r\n\r\nDans tous les cas, il est conseill\u00e9 de s\u2019\u00e9quiper de protections de s\u00e9curit\u00e9 (casque, genouill\u00e8res, etc.) ainsi que de quoi vous r\u00e9hydrater durant la parade.\r\n\r\nLa hey! telecom Roller Bike Parade, c\u2019est du fun, du sport et c\u2019est gratuit ! \r\n\r\n\/!\\ Annulation possible en cas d\u2019intemp\u00e9ries \/!\\ \r\n\r\nEn cas d\u2019intemp\u00e9ries et\/ou pour des raisons de s\u00e9curit\u00e9, l\u2019organisation peut annuler la parade.\r\n\r\nA 13h, le jour m\u00eame de la parade, nous vous avertirons quant \u00e0 la faisabilit\u00e9 de la parade sur la page Facebook, Instagram ou le site internet de l'\u00e9v\u00e9nement. \r\n\r\nN\u2019oubliez donc pas d\u2019y jeter un \u0153il afin d\u2019avoir la certitude que la parade se fera!\r\n\r\nLieu de d\u00e9part : Place Poelaert\r\nRassemblement : 19h\r\nHeure de d\u00e9part : 20h\r\nQuand : tous les vendredis de l'\u00e9tendu 16 juin au 22 septembre\r\nEntr\u00e9e : Gratuit\r\n\r\nSite web :  https:\/\/rollerbikeparade.be\r\nFacebook : https:\/\/www.facebook.com\/heytelecomRollerBikeParade\r\nInstagram : https:\/\/www.instagram.com\/rollerbikeparade\/","performers":null,"boxoffice_url":null,"website":null,"email":"gold@beegroupe.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.558496"},"nl":{"name":"hey! telecom Roller Bike Parade","shortdescr":"De hey! telecom Roller Bike Parade is terug voor een nieuwe editie in 2023! Kom onder begeleiding van onze ervaren medewerkers Brussel ontdekken op het ritme van de draaitafels van onze DJ's!","longdescr":"Wil jij op skeelers, skateboard of fiets over de grote boulevards of smalle straatjes van Brussel rollen, zonder ook maar \u00e9\u00e9n auto in het zicht? Doe dan mee met de hey! telecom Roller Bike Parade elke vrijdag in de zomer in Brussel !\r\n\r\nDe hey! telecom Roller Bike Parade is een leuk en origineel concept dat deelnemers uitnodigt om voor \u00e9\u00e9n avond de straten van jouw stad in te trekken op skeelers, fietsen, skateboards, monowheels, longboards of elektrische scooters.\r\n\r\nVoor elke parade zijn twee routes gepland: een voor beginners (ongeveer 5 km) en de andere voor de sportievelingen onder jullie (ongeveer 15 km). Met vrienden, familie of alleen, de parade is voor iedereen!\r\nIn alle gevallen is het een goed idee om je eigen veiligheidsuitrusting mee te nemen (helm, kniebeschermers, etc.) en iets om je te herbronnen tijdens de parade.\r\nDe hey! telecom Roller Bike Parade is leuk, sportief en gratis! \r\n\r\n\/Annulering mogelijk bij slecht weer!\\\r\n\r\nBij slecht weer en\/of om veiligheidsredenen kunnen de organisatoren de parade afgelasten.\r\nOm 13.00 uur op de dag van de parade laten we je op de Facebookpagina, Instagram of website van het evenement weten of de parade haalbaar is. \r\nVergeet dus niet om te kijken of de parade doorgaat!\r\n\r\nVertrekpunt : Poelaertplaats\r\nVerzameltijd : 19u\r\nStarttijd : 20u\r\nWanneer : elke vrijdag in de zomer\r\nToegang: Gratis\r\n\r\nWebsite : https:\/\/rollerbikeparade.be\r\nFacebook : https:\/\/www.facebook.com\/heytelecomRollerBikeParade\r\nInstagram : https:\/\/www.instagram.com\/rollerbikeparade\/","performers":null,"boxoffice_url":null,"website":null,"email":"gold@beegroupe.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.558496"},"en":{"name":"hey! telecom Roller Bike Parade","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"gold@beegroupe.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.558496"},"de":{"name":"hey! telecom Roller Bike Parade","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"gold@beegroupe.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.558496"},"it":{"name":"hey! telecom Roller Bike Parade","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"gold@beegroupe.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.558496"},"sp":{"name":"hey! telecom Roller Bike Parade","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"gold@beegroupe.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.558496"},"pt":{"name":"hey! telecom Roller Bike Parade","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"gold@beegroupe.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.558496"},"cn":{"name":"hey! telecom Roller Bike Parade","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"gold@beegroupe.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.558496"}},"place":{"id":238555,"translations":{"fr":{"name":"Place Poelaert","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Poelaert","address_line2":"1000 Bruxelles","description_web":"Entre les Marolles tr\u00e8s populaires, et l'\u00e9l\u00e9gant quartier Louise, se trouve la place Poelaert. C'est le meilleur spot pour avoir une vue panoramique \u00e0 couper le souffle sur la ville. \u00c0 l'horizon se profilent des joyaux du patrimoine bruxellois comme la basilique de Koekelberg et l'Atomium ; \u00e0 admirer sans mod\u00e9ration, et particuli\u00e8rement au coucher du soleil. Vous n'avez pas le vertige ? Depuis 2019, la grande roue \" The View \" vous emm\u00e8ne \u00e0 cent m\u00e8tres de haut pour admirer la capitale belge, tandis que l'ascenseur (gratuit), tout en verre, vous fait plonger dans les Marolles pour encore plus de plaisir en ville.\r\n\r\nAvec ses 750 m2, la place Poelaert est \u00e9galement la plus grande place de la capitale. Elle doit son nom \u00e0 Joseph Poelaert, l'architecte du monumental palais de justice, construit au 19\u00e8me si\u00e8cle, qui tr\u00f4ne sur cette place ; et l\u2019\u00e9chafaudage qui le soutient depuis des ann\u00e9es fait d\u00e9sormais partie de la m\u00e9moire collective.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Poelaertplein","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Poelaertplein","address_line2":"1000 Brussel","description_web":"Tussen de volkse Marollen en de elegante Louizawijk ligt het Poelaertplein. Hier moet je zijn voor een prachtig panoramisch uitzicht over de (beneden)stad. Aan de horizon prijken architecturale erfgoedparels zoals de Basiliek van Koekelberg en het Atomium. Vooral bij zonsondergang is het hier volop genieten van een eindeloze hemel. Geen hoogtevrees? Sinds 2019 staat hier het reuzenrad \u2018The View\u2019 en kan je de Belgische hoofdstad bewonderen vanop maar liefst honderd meter hoogte! Nadien kan je gratis de glazen lift nemen en de Marollen induiken voor meer stadsplezier.\r\n\r\nHet Poelaertplein is met een oppervlakte van 750 m\u00b2 ook het grootste plein van de hoofdstad. Het werd vernoemd naar Joseph Poelaert, de architect van het justitiepaleis. Dat is het monumentale gerechtsgebouw dat je op dit plein ziet, een mastodont uit de 19de eeuw. De steigers waarin het justitiepaleis sinds jaar en dag verpakt is, maken ondertussen deel uit van het collectieve geheugen.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Place Poelaert","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Place Poelaert","address_line2":"1000 Brussels","description_web":"Between the popular Marolles district and the elegant Louise neighbourhood lies the place Poelaert. This is the place to go for a superb panoramic view of the lower part of the city. On the horizon are architectural heritage gems such as the Basilica of Koekelberg and the Atomium. Sunset in particular is a great time to enjoy the seemingly endless sky. Not afraid of heights? Since 2019, the giant Ferris wheel 'The View' has taken up residence here and you can admire the Belgian capital from a height of no less than one hundred metres! Afterwards, take the free glass lift and dive into the Marolles for more urban fun.\r\n\r\nPlace Poelaert, with its 750m\u00b2 surface area, is also the largest square in the capital. It was named after Joseph Poelaert, the architect of the Palace of Justice, which is the monumental courthouse you see on this square, a mastodon from the 19th century. The scaffolding surrounding the courthouse has become part of the public's collective memory.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Place Poelaert","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Poelaert","address_line2":"1000 Bruxelles","description_web":"Bei dem Place Poelaert, der sich 63 Meter \u00fcber der Br\u00fcsseler Unterstadt befindet, handelt es sich um den Vorplatz des beeindruckenden Br\u00fcsseler Justizpalasts. Ein Fahrstuhl ist die schnellste Verbindung zwischen Ober- und Unterstadt. Der Platz misst 155 m x 50 m, d. h. knapp 8 hat - damit ist der Place Poelaert der gr\u00f6\u00dfte Platz Br\u00fcssels.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Place Poelaert","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Poelaert","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Place Poelaert","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Poelaert","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Place Poelaert","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Poelaert","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Place Poelaert","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Poelaert","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[2],"translations":{"fr":["Marolles"],"nl":["Marollen"],"en":["Marolles"],"de":["Marollen"],"it":["Marolles"],"sp":["Marolles"],"pt":[null],"cn":[null]}},"zones":{"list":[19],"translations":{"fr":["Centre"],"nl":["Centrum"],"en":["Centre"],"de":["Zentrum"],"it":["Centro"],"sp":["Centro"],"pt":[