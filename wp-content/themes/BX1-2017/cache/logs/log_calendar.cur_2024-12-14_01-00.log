antasque bestiaire","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700002126"},"sp":{"name":"Vernissage David Peeters","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700002126"},"nl":{"name":"Vernissage David Peeters","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700002126"}},"place":{"id":332,"translations":{"de":{"name":"Maison de la Francit\u00e9","address_street_name":"Rue Joseph II","address_street_number":"18","address_street_box":null,"email":"mdlf@maisondelafrancite.be","website":"http:\/\/www.maisondelafrancite.be","phone_contact":"+32 2 219 49 33","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Joseph II, 18","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Maison de la Francit\u00e9","address_street_name":"Rue Joseph II","address_street_number":"18","address_street_box":null,"email":"mdlf@maisondelafrancite.be","website":"http:\/\/www.maisondelafrancite.be","phone_contact":"+32 2 219 49 33","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Joseph II, 18","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Maison de la Francit\u00e9","address_street_name":"Rue Joseph II","address_street_number":"18","address_street_box":null,"email":"mdlf@maisondelafrancite.be","website":"http:\/\/