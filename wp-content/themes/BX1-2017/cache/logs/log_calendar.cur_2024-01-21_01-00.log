e archief van de architect, een verzameling plannen van zijn gebouwen en de bibliotheek zijn op afspraak toegankelijk voor het publiek. De reservatie van een tijdsblok online is verplicht. Laatste toegang mogelijk om 16u45.\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":4331,"location":{"lat":50.82416798,"lon":4.35553156},"last_updated_at":"2023-09-21T14:32:58+02:00","published_at":"2013-10-19T01:17:16+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"video","link":"https:\/\/www.youtube.com\/watch?v=bK2P-t4GwaQ&list=PLyl6oz7qkVtn6E4e5obBZ3PZpxpLCk1zP","width":267,"height":200,"ratio":null,"oEmbed_title":"TRAILER : \ud835\udc7d\ud835\udc8a\ud835\udc84\ud835\udc95\ud835\udc90\ud835\udc93 \ud835\udc6f\ud835\udc90\ud835\udc93\ud835\udc95\ud835\udc82 \ud835\udc97\ud835\udc86\ud835\udc93\ud835\udc94\ud835\udc96\ud835\udc94 \ud835\udc68\ud835\udc93\ud835\udc95 \ud835\udc8f\ud835\udc90\ud835\udc96\ud835\udc97\ud835\udc86\ud835\udc82\ud835\udc96 - \ud835\udc6f\ud835\udc90\ud835\udc93\ud835\udc95\ud835\udc82'\ud835\udc94 \ud835\udc97\ud835\udc90\ud835\udc84\ud835\udc82\ud835\udc83\ud835\udc96\ud835\udc8d\ud835\udc82\ud835\udc93\ud835\udc9a","oEmbed_author_name":"Horta Museum","oEmbed_author_url":"https:\/\/www.youtube.com\/@horta_museum","oEmbed_type":"video","oEmbed_height":200,"oEmbed_width":267,"oEmbed_version":"1.0","oEmbed_provider_name":"YouTube","oEmbed_provider_url":"https:\/\/www.youtube.com\/","oEmbed_thumbnail_height":360,"oEmbed_thumbnail_width":480,"oEmbed_thumbnail_url":"https:\/\/i.ytimg.com\/vi\/bK2P-t4GwaQ\/hqdefault.jpg","oEmbed_html":"<iframe width=\"267\" height=\"200\" src=\"https:\/\/www.youtube.com\/embed\/bK2P-t4GwaQ?feature=oembed\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-pi