t\u00f4mes\":  https:\/\/www.facebook.com\/events\/1164902181190658\n","longdescr":"L'effaceur transforme le graffiti. Il le triture, le chatouille, le dissout, le malaxe, le d\u00e9construit...\nM\u00eame s'il n'est plus lisible, il est rare qu'aucune trace ou spectre ne subsiste.\nParadoxalement, si le nettoyeur a souvent plus de temps, d'outils et de techniques \u00e0 disposition que l'auteur du graffiti, son r\u00e9sultat est moins ma\u00eetris\u00e9, plus al\u00e9atoire.\nCette collaboration involontaire mais pr\u00e9visible de ces deux \u00e9nergies peut donner un r\u00e9sultat doux et subtil de deux moments d'intervention non coordonn\u00e9s.","performers":"Fais le trottoir ASBL","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50010422"},"sp":{"name":"Visite guid\u00e9e - effa\u00e7age et graffiti","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50010422"},"nl":{"name":"Effa\u00e7age et graffiti","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50010422"}},"place":{"id":245448,"translations":{"de":{"name":"Divers lieux \u00e0 Bruxelles","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Divers lieux \u00e0 Bruxelles","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Divers lieux \u00e0 Bruxelles","address_street_name":null,"add