me":"Category 2"}},"value":59},{"translations":{"fr":{"name":"Cat\u00e9gorie 3"},"nl":{"name":"Categorie 3"},"en":{"name":"Category 3"}},"value":69}],"child_events":[],"parent_events":[],"targets":{"list":[11],"translations":{"fr":["Famille"],"nl":["Familie"],"en":["Family"]}},"visit_profile":{"list":[320],"translations":{"fr":["Classique"],"nl":["Klassiek"],"en":["Classical"]}},"tags":["exterior","kids"],"accessibilities":{"list":[263],"translations":{"fr":["Accessible aux pi\u00e9tons appareill\u00e9s"],"nl":["Toegankelijk voor voetgangers met hulpmiddelen"],"en":["Accessible to pedestrians with mobility aids"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-09-12T01:06:19+02:00","published_at":"2021-05-11T15:08:10+02:00","backoffice_id":231439,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.1011946522289},{"id":540809,"date_start":"2022-09-13","date_end":"2022-09-13","date_next":"2022-09-13","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[36,41],"translations":{"fr":["Mus\u00e9es et art centers","Installation, performance"],"nl":["Musea en kunstcentra","Installatie, performance"],"en":["Museums and art centers","Installation, performance"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Visite guid\u00e9e : EXPO 'CURIOSA' avec Cecilia Paredes","shortdescr":"VISITE\u00a0EXCEPTIONELLE\u00a0\u2018CURIOSA - Charles Quint, D\u00fcrer et le tr\u00e9sor des Azt\u00e8ques' avec Cecilia Paredes","longdescr":"Lorsque le peintre Albrecht D\u00fcrer arrive \u00e0 Bruxelles en 1520, il d\u00e9couvre une ville en plein essor. Dans son carnet de voyage, il laisse un t\u00e9moignage \u00e9tonnant : il a vu au Palais du Coudenberg un tr\u00e9sor venu du \u00ab Nouveau Pays de l\u2019Or \u00bb, exp\u00e9di\u00e9 depuis le Mexique par Hern\u00e1n Cort\u00e9s.\r\n\r\nCes objets tant pr\u00e9cieux que surprenants ont impressionn\u00e9 ses contemporains, stimul\u00e9 l\u2019imaginaire et fait naitre des l\u00e9gendes. Cette exposition multi sensorielle retrace la d\u00e9couverte de ces richesses et leurs destin\u00e9es \u00e0 l\u2019\u00e9poque du r\u00e8gne de l\u2019empereur Charles Quint. Une immersion th\u00e9matique dans les souterrains de la place Royale mise en \u0153uvre dans le sillage du 500e anniversaire du voyage de D\u00fcrer aux Pays-Bas.\r\n\r\nInt\u00e9ress\u00e9 par une visite ?\r\nLe 13\/09 \u00e0 18h par Cecilia Paredes (commissaire\u00a0de l\u2019exposition)\r\nLe 21\/09 \u00e0 18h par Sabrina Montiel-Soto (artiste)\r\nR\u00e9servation par info@coudenberg.brussels\r\n\r\nInfos pratiques\u00a0:\r\nAdresse\u00a0: Place Royale 10, 1000 Bruxelles\r\nPrix : normal\/individuel | 10 \u20ac. Senior (+65) | 8\u20ac. R\u00e9duit | 5\u20ac\u00a0Entr\u00e9e gratuite jusqu\u2019\u00e0 18 ans\u00a0\r\n\r\nL'expo est ouverte\u00a0jusqu'au\u00a02 octobre 2022.\r\n\r\nUne initiative d\u2019Urban en collaboration avec les\u00a0Mus\u00e9es royaux des Beaux-Arts\u00a0et le\u00a0Palais du Coudenberg. Commissariat scientifique : V\u00e9ronique B\u00fccken \/ Cecilia Paredes. Interventions artistiques : Sabrina Montiel-Soto.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.coudenberg.brussels","email":"info@coudenberg.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.540809"},"nl":{"name":"Geleid bezoek: 'CURIOSA' met Cecilia Paredes","shortdescr":"GELEID BEZOEK\u00a0\u2018CURIOSA - Keizer Karel, D\u00fcrer en de schat van de Azteken'\u00a0met Cecilia Paredes (FR)","longdescr":"Toen de schilder Albrecht D\u00fcrer in 1520 in Brussel aankwam, ontdekte hij er een stad in volle bloei. In zijn reisdagboek laat hij een verbazingwekkende getuigenis achter: hij zag in het Coudenbergpaleis een schat uit het \"Nieuwe Land van Goud\", verzonden vanuit Mexico door Hern\u00e1n Cort\u00e9s.\r\n\r\nDeze kostbare en opmerkelijke voorwerpen maakten een diepe indruk op zijn tijdgenoten, prikkelden de verbeelding en deden legendes ontstaan. Deze multisensorische tentoonstelling doet het verhaal van de ontdekking van deze rijkdommen en hun lot tijdens het bewind van keizer Karel. Een thematische onderdompeling in de ondergrondse gangen van het Koningsplein, georganiseerd in het kader van de 500ste verjaardag van D\u00fcrers reis naar de Nederlanden.\r\n\r\nGe\u00efnteresseerd in een geleid bezoek?\r\nOp 13\/09 om 18u door Cecilia Paredes, \u00e9\u00e9n van de curatoren\r\nOp 21\/09 om 18u door Sabrina Montiel-Soto, de artieste\r\nReserveren via info@coudenberg.brussels\r\n\r\nOpgelet: het bezoek is enkel in het Frans.\u00a0\r\n\r\n\r\nPraktische informatie:\r\nAdres: Koningsplein 10 1000 Brussel\r\nTarieven: Normaal\/individueel | \u20ac 10. senior (+ 65) | \u20ac 8.\u00a0Kortingstarief | \u20ac 5. Gratis toegang tot 18 jaar\u00a0\r\nDe expo loopt nog tot 2 oktober 2022.\r\n\r\nEen initiatief van Urban in samenwerking met de\u00a0Koninklijke Musea voor Schone Kunsten\u00a0en het\u00a0Coudenbergpaleis. Wetenschappelijk curator: V\u00e9ronique B\u00fccken \/ Cecilia Paredes. Artistieke interventies: Sabrina Montiel-Soto.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.coudenberg.brussels","email":"info@coudenberg.brussels","phone_contact":"+32 2 500 45 54","phone_booking":"+32 2 500 45 54","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.540809"},"en":{"name":"Guided tour: EXPO 'Curiosa' with Cecilia Paredes","shortdescr":"GUIDED TOUR '\u2018CURIOSA \u2013 Charles V, D\u00fcrer and the Aztec treasure' with Cecilia Paredes (FR)","longdescr":"When the painter Albrecht D\u00fcrer arrived in Brussels in 1520, he encountered a flourishing city. In his travel diary, he left an astonishing testimony: he had seen, in the Coudenberg Palace, a treasure from the 'New Land of Gold', sent from Mexico by Hern\u00e1n Cort\u00e9s.\r\n\r\nThese precious and stunning objects impressed his contemporaries, stimulated the imagination and gave rise to legends. This multi-sensory exhibition retraces the discovery of these riches and their fate during the reign of Emperor Charles V. A themed immersion in the underground passages of place Royale, as part of the 500th anniversary of D\u00fcrer's journey to the Netherlands.\r\n\r\nInterested in a guided tour?\r\nOn 13\/09 at 18h with Cecilia Paredes, one of the curators\r\nOn 21\/09 at 18h with Sabrina Montiel-Soto, the artist\r\nReservations via info@coudenberg.brussels\r\n\r\nNote: the tour will be in french only.\r\n\r\nPractical information:\r\nPrice: regular ticket - \u20ac10. Groups of 15+ people and seniors (+65 years) - \u20ac8. Concessions - \u20ac5\r\nUnder 18s accompanied with their parents - free.\r\n\r\nAn initiative of Urban in collaboration with the Royal Museums of Fine Arts and the Coudenberg Palace. Scientific curators: V\u00e9ronique B\u00fccken \/ Cecilia Paredes. Artistic contributions: Sabrina Montiel-Soto.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.coudenberg.brussels","email":"info@coudenberg.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.540809"},"de":{"name":"Geleid bezoek: 'CURIOSA' met Cecilia Paredes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.540809"},"it":{"name":"Geleid bezoek: 'CURIOSA' met Cecilia Paredes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.540809"},"sp":{"name":"Geleid bezoek: 'CURIOSA' met Cecilia Paredes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.540809"},"pt":{"name":"Geleid bezoek: 'CURIOSA' met Cecilia Paredes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.540809"},"cn":{"name":"Geleid bezoek: 'CURIOSA' met Cecilia Paredes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.540809"}},"place":{"id":258195,"translations":{"fr":{"name":"Palais du Coudenberg","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@coudenberg.brussels","website":"http:\/\/www.coudenberg.brussels","phone_contact":"+32 2 500 45 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"Autrefois, l\u2019impressionnant palais du Coudenberg dominait la ville de Bruxelles. Charles Quint et d\u2019autres souverains parmi les plus puissants que l\u2019Europe ait connus ont habit\u00e9 cette r\u00e9sidence princi\u00e8re du 12e au 18e si\u00e8cle, jusqu\u2019\u00e0 ce qu\u2019un terrible incendie la d\u00e9truise \u00e0 jamais. Les ruines de ce palais ont disparu pendant de nombreuses ann\u00e9es dans les sous-sols. Aujourd\u2019hui, ces vestiges forment un site arch\u00e9ologique enchanteur constitu\u00e9 d\u2019un r\u00e9seau de salles et de passages souterrains.\r\n \r\nAu cours de votre visite, vous d\u00e9couvrirez les b\u00e2timents principaux du palais et vous fl\u00e2nerez dans la rue Isabelle, qui est aujourd\u2019hui souterraine. Dans le mus\u00e9e du Coudenberg, qui est abrit\u00e9 dans l\u2019h\u00f4tel d\u2019Hoogstraeten, sont expos\u00e9es les plus belles d\u00e9couvertes arch\u00e9ologiques effectu\u00e9es lors des diff\u00e9rentes campagnes de fouilles men\u00e9es sur le site du Coudenberg\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Coudenbergpaleis","address_street_name":"Paleizenplein","address_street_number":"7","address_street_box":null,"email":"info@coudenberg.brussels","website":"http:\/\/www.coudenberg.brussels","phone_contact":"+32 2 500 45 54","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Paleizenplein, 7","address_line2":"1000 Brussel","description_web":"Ooit werd Brussel gedomineerd door het reusachtige Coudenbergpaleis. Keizer Karel en het kruim van de Europese adel verbleven er tussen de twaalfde en de achttiende eeuw. Tot het noodlot toesloeg en een brand het prachtige gebouw verwoestte. Vele resten bleven echter intact en verdwenen ... onder de grond. Nu is het een betoverende archeologische site, een netwerk van gewelfde gangen, zalen en verborgen kamers.\r\n \r\nTijdens een bezoek ontdek je de hoofdgebouwen van het paleis en flaneer je door de Isabellastraat, die nu onder de grond ligt! In het museum van de Coudenberg, dat in het bovengrondse Hof van Hoogstraeten ondergebracht is, kan je de mooiste archeologische voorwerpen bewonderen die in de loop van de verschillende opgravingswerken op de Coudenbergsite werden ontdekt.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Coudenberg Palace","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@coudenberg.brussels","website":"http:\/\/www.coudenberg.brussels","phone_contact":"+32 2 500 45 54","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Place des Palais, 7","address_line2":"1000 Brussels","description_web":"Once upon a time, the Coudenberg Palace towered over the city of Brussels. Charles V and many other of the most powerful rulers ever to reign in Europe made this princely residence their home between the 12th and 18th centuries, until it was consumed by a terrible fire.  Every trace of this prestigious palace simply disappeared underground for many years. Today, however, these ruins constitute a fascinating archeological site incorporating a network of underground passages and chambers.\r\n \r\nWhen you visit it you can explore the principal buildings of the palace and enjoy a stroll along the Rue Isabelle, which is now underground.  In the Coudenberg Museum, located in Hoogstraeten House, the finest of the archeological discoveries made during the various excavations of the Coudenberg site are displayed.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Coudenberg Palast","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@coudenberg.brussels","website":"http:\/\/www.coudenberg.brussels","phone_contact":"+32 2 500 45 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"Ein unterirdischer Parcours, in dessen Verlauf Sie die \u00dcberreste des Palastes von Charles V. entdecken k\u00f6nnen. Seit dem Mittelalter \u00fcberragt eine f\u00fcrstliche Residenz auf dem Coudenberg die Stadt Br\u00fcssel. Das architektonische Ensemble, das sich seit dem 12. Jahrhundert immer wieder weiterentwickelt hat, gilt als einer der sch\u00f6nsten Pal\u00e4ste Europas und eine der wichtigsten Residenzen von Karl V. Dieses prestigetr\u00e4chtige Geb\u00e4ude wurde bei einem Brand im Februar 1731 schwer besch\u00e4digt. Vierzig Jahre sp\u00e4ter wurden die Ruinen des Palasts dem Erdboden gleichgemacht, um Platz f\u00fcr den Place Royale zu machen. Die \u00dcberreste dieses Geb\u00e4udes bilden heute die arch\u00e4ologische St\u00e4tte des Coudenberg. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Coudenberg Palazzo","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@coudenberg.brussels","website":"http:\/\/www.coudenberg.brussels","phone_contact":"+32 2 500 45 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"\"Il sito archeologico di Coudenberg vi svela un percorso sotterraneo e un museo dedicati a Carlo V sulla Place de Palais a Bruxelles.\tSito Archeologico di Coudenbergl sito...\"\r\n\r\nIl sito archeologico di Coudenberg vi svela un percorso sotterraneo e un museo dedicati a Carlo V sulla Place de Palais a Bruxelles.\r\n\r\nSito Archeologico di Coudenberg\r\n\r\nl sito riunisce vestigia dell'antico palazzo di Bruxelles, della residenza di Hoogstraeten e della Rue Isabelle. Un'affascinante passeggiata che vi conduce sotto il pav\u00e9 della place Royale, alla scoperta dei resti del Palazzo di Coudenberg che fu una delle residenze principali di Carlo V. \u00a0\r\n\r\nMuseo del Coudenberg\r\nil museo vi invita a scoprire un'esposizione permanente di oggetti trovati durante gli scavi effettuati sul sito negli ultimi 25 anni. potete combinare la vostra visita con quella del Museo BELvue.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Coudenberg Palacio","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@coudenberg.brussels","website":"http:\/\/www.coudenberg.brussels","phone_contact":"+32 2 500 45 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"En el emplazamiento arqueol\u00f3gico de Coudenberg encontrar\u00e1s un recorrido subterr\u00e1neo y un museo dedicado al Palacio Carlos V, en la Place des Palais de Bruselas....\r\n\r\nEn el emplazamiento arqueol\u00f3gico de Coudenberg encontrar\u00e1s un recorrido subterr\u00e1neo y un museo dedicado al Palacio Carlos V, en la Place des Palais de Bruselas.\r\n\r\nEl emplazamiento arqueol\u00f3gico Coudenberg\r\n\r\nEl emplazamiento arqueol\u00f3gico Coudenberg est\u00e1 compuesto de vestigios del antiguo Palacio de Bruselas, del Hotel Hoogstraeten y de la Rue Isabelle.\u00a0Este fascinante paseo te llevar\u00e1 a descubrir los <b>vestigios del Palacio Coudenberg<\/b>, que fue una de las residencias de Carlos V.\r\n\r\nMuseo Coudenberg\r\n\r\nInstalado en los vestigios del antiguo Hotel de Hoogstraeten, el Museo Coudenberg  te invita a descubrir una <b>exposici\u00f3n permanente<\/b> de objetos hallados durante las distintas <b>excavaciones arqueol\u00f3gicas<\/b> realizadas los \u00faltimos 25 a\u00f1os.\u00a0Podr\u00e1s combinar tu visita del Coudenberg con la del Museo BELvue.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Palais du Coudenberg","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@coudenberg.brussels","website":"http:\/\/www.coudenberg.brussels","phone_contact":"+32 2 500 45 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Palais du Coudenberg","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@coudenberg.