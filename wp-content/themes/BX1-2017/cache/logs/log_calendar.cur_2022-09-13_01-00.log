9:05:06+02:00","published_at":"2013-10-19T01:37:57+02:00","import_origin":null,"external_id":null,"is_in_address_book":false,"is_in_vb_export":false,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/1ab2716f9873b01f7e50d5f6d21faa20daa92b55.jpg","width":719,"height":903,"ratio":0.8,"translations":{"fr":{"title":"10 i\u00e8me Festival d'orgue du grand B\u00e9guinage: Moniek BRIFFOZ","copyright":null},"nl":{"title":"10 i\u00e8me Festival d'orgue du grand B\u00e9guinage: Moniek BRIFFOZ","copyright":null},"en":{"title":"10 i\u00e8me Festival d'orgue du grand B\u00e9guinage: Moniek BRIFFOZ","copyright":null}}}],"dates":[{"day":"2022-09-29","doors":null,"start":"18:00:00","end":null,"is_soldout":false,"is_canceled":false},{"day":"2022-09-29","doors":null,"start":"18:00:00","end":"19:00:00","is_soldout":false,"is_canceled":false}],"prices":[],"child_events":[],"parent_events":[538404],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-08-23T19:05:06+02:00","published_at":"2022-08-23T10:17:36+02:00","backoffice_id":260130,"import_origin":null,"sub_type":"concert","show_in_agenda":true,"ranking":1},{"id":538995,"date_start":"2022-09-29","date_end":"2022-10-20","date_next":"2022-09-29","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[36,46],"translations":{"fr":["Mus\u00e9es et art centers","Pluridisciplinaire"],"nl":["Musea en kunstcentra","Multidisciplinair"],"en":["Museums and art centers","Multidisciplinary"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"After Five","shortdescr":"Dans le cadre de l\u2019exposition \u00ab Couleur\/Lumi\u00e8re\u00bb, la Maison des Arts et l\u2019Estaminet vous accueillent deux soir\u00e9es durant lesquelles vous pourrez d\u00e9couvrir l\u2019expo et profiter d\u2019un concert.","longdescr":"Dans le cadre de l\u2019exposition \u00ab Couleur\/Lumi\u00e8re\u00bb, la Maison des Arts et l\u2019Estaminet vous accueillent deux soir\u00e9es durant lesquelles vous pourrez d\u00e9couvrir l\u2019expo et profiter d\u2019un concert.\r\n\r\nJeudi 29.09\r\n\r\nInfos prochainement disponibles concernant le concert.\r\n\r\nJeudi 20.10\r\n\r\nInfos prochainement disponibles concernant le concert.\r\n\r\nLe 20.10, les \u00e9tudiants de l\u2019ISPG, futurs enseignants en sciences, pr\u00e9senteront des exp\u00e9riences simples afin de mieux comprendre les ph\u00e9nom\u00e8nes optiques utilis\u00e9s par les artistes.\r\n\r\nPhoto: Florian Payen","performers":null,"boxoffice_url":null,"website":"http:\/\/lamaisondesarts.be\/after-five-2\/","email":"info@lamaisondesarts.be","phone_contact":"+32 2 240 34 99","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.538995"},"nl":{"name":"After Five","shortdescr":"In het kader van de tentoonstelling \u2018Kleur\/Licht\u2019 verwelkomen La Maison des Arts en het Estaminet je op twee nocturnes om de tentoonstelling te ontdekken en te genieten van een concert.","longdescr":"In het kader van de tentoonstelling \u2018Kleur\/Licht\u2019 verwelkomen La Maison des Arts en het Estaminet je op twee nocturnes om de tentoonstelling te ontdekken en te genieten van een concert.\r\n\r\nDonderdag 29.09\r\n\r\nInformatie over het concert zal binnenkort beschikbaar zijn.\r\n\r\nDonderdag 20.10\r\n\r\nInformatie over het concert zal binnenkort beschikbaar zijn.\r\nOp 20.10 presenteren de studenten van ISPG, toekomstige leerkrachten in de wetenschappen, eenvoudige proefjes om meer inzicht te scheppen in de optische fenomenen waarop de kunstenaars zich beroepen.\r\n\r\nFoto: Florian Payen","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.538995"},"en":{"name":"After Five","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.538995"},"de":{"name":"After Five","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.538995"},"it":{"name":"After Five","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.538995"},"sp":{"name":"After Five","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.538995"},"pt":{"name":"After Five","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.538995"},"cn":{"name":"After Five","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.538995"}},"place":{"id":222932,"translations":{"fr":{"name":"Maison des Arts","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 147","address_line2":"1030 Schaerbeek","description_web":"La Maison des Arts, anim\u00e9e par le Service Culture fran\u00e7aise de la Commune de Schaerbeek, est un espace singulier dont les activit\u00e9s sont principalement ax\u00e9es sur la cr\u00e9ation contemporaine dans le domaine des arts plastiques avec un important programme de m\u00e9diation permettant l\u2019acc\u00e8s de l\u2019art contemporain \u00e0 tous.\r\n\r\nLa MA conna\u00eet une riche activit\u00e9 artistique depuis les ann\u00e9es \u201950, \u00e9poque \u00e0 laquelle la commune rach\u00e8te le b\u00e2timent. En 2005, elle se voit prendre un premier tournant en proposant aux artistes de travailler in situ, afin d\u2019\u00e9tablir une r\u00e9elle coh\u00e9rence entre l\u2019\u0153uvre et la Maison.\r\nEt finalement, c\u2019est en 2016 que la Commune de Schaerbeek d\u00e9cide de la positionner dans le domaine des arts plastiques, contemporains et num\u00e9riques comme un lieu de cr\u00e9ation, de diffusion et de rayonnement culturel.\r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Huis der Kunsten","address_street_name":"Haachtsesteenweg","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaarbeek","address_line1":"Haachtsesteenweg, 147","address_line2":"1030 Schaarbeek","description_web":"La Maison des Arts, geanimeerd door de dienst Franstalige Cultuur van de gemeente Schaarbeek, is een heel bijzondere plek. De activiteiten zijn vooral gericht op hedendaagse creativiteit in de plastische kunsten.\r\n\r\nIn La Maison des Arts heerst reeds sedert 1950 ( datum waarop de gemeente het huis aankocht) een ruime artistieke activiteit. In 2005 is er een belangrijke ontwikkeling : het voorstel aan de kunstenaars om ter plaatse te werken, teneinde een echte samenhang te bereiken tussen het werk en het Huis. Uiteindelijk beslist de Gemeente Schaarbeek er een echte broeikast van te maken in het domein van de beeldende kunsten, een bron van schepping, verspreiding en culturele uitstraling.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Maison des Arts","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 147","address_line2":"1030 Schaerbeek","description_web":"The MdA is run and staffed by the Francophone Cultural Service of Schaerbeek Council and is a unique place whose activities are mainly concerned with the creation of works of contemporary art with a significant partnership programme that promotes access for all to contemporary art.\r\n\r\nThe MdA has hosted a rich programme of artistic activities since the 1950s when the building was purchased by Schaerbeek Council. In 2005, the MdA began a programme of inviting artists to work in building, to build more coherence between their works of art and the MdA.\r\n\r\nMost recently, in 2016, Schaerbeek Council decided to position the MdA as a centre for the creation, diffusion and promotion of culture, contemporary two-dimensional, three-dimensional and digital art.\r\nThe MdA\u2019s educational and social approach aims to promoting equality of access to art and its introduction to new audiences.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Maison des Arts","address_street_name":"Chauss\u00e9e de Haecht","address_stree