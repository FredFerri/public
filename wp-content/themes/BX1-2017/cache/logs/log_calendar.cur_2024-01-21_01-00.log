ht":null},"sp":{"title":"Macondo Trio","copyright":null},"nl":{"title":"Macondo Trio","copyright":null}}}],"dates":[{"day":"2024-01-21","doors":"16:00:00","start":"20:00:00","end":"23:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false}],"prices":[],"date_exceptions":[],"closing_days":[],"child_events":[],"parent_events":[],"accessibilities":[],"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[]},{"id":50006100,"date_start":"2024-01-21","date_end":"2024-01-21","date_next":"2024-01-21","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-01-16T09:00:07+01:00","published_at":"2024-01-16T08:56:48+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":292464,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"misc","ranking":1.2599210498948732,"languages":{"spoken":["fr","en","nl"],"subtitles":[]},"categories":{"main":{"id":84,"translations":{"de":"Verschiedenes","pt":null,"en":"Various","it":"Varie","cn":null,"fr":"Divers","sp":"Varios","nl":"Varia"}},"others":{}},"translations":{"de":{"name":"MultiMemo Dissemination Conference and Holocaust Commemoration Event","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/ceji.org\/multimemo-couple-dun-evenement-de-commemoration-des-genocides-de-la-2eme-guerre-mondiale\/","email":"Ceji@ceji.org","phone_contact":"+ 32 (0)2 \u2013 344 34 44","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50006100"},"pt":{"name":"MultiMemo Dissemination Conference and Holocaust Commemoration Event","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/ceji.org\/multimemo-couple-dun-evenement-de-commemoration-des-genocides-de-la-2eme-guerre-mondiale\/","email":"Ceji@ceji.org","phone_contact":"+ 32 (0)2 \u2013 344 34 44","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50006100"},"en":{"name":"MultiMemo Dissemination Conference and Holocaust Commemoration Event","shortdescr":"We are pleased to invite you to the MultiMemo Dissemination Conference and Holocaust Commemoration Event.\n\u2018Echoes of Remembrance\u2019 \u2013 A Journey through Memories. A joint artistic Holocaust commemoration event","longdescr":"This event is organized by CEJI \u2013 A Jewish Contribution to an Inclusive Europe, in partnership with the Jewish Museum of Belgium, as part of the European project MultiMemo \u2013 Multidirectional Memory: Remembering for Social Justice.\n\nThe MultiMemo project\nThe MultiMemo project proposes an intersectional approach to remembrance \u2013 one that underscores the relevance of memory for social justice and the need to face contemporary challenges related to human rights violations, military conflicts and violence, social exclusion, and the migration crisis.\n\nDrawing from the concept of \u2018multidirectional memory\u2019, the project initiates a variety of forms of active remembrance in the public spheres across several European countries \u2013 a remembrance that does not exist in a social vacuum. Instead, it highlights the need to stand up to contemporary practices of violence and exclusion.\n\nThe MultiMemo dissemination conference and commemoration event\nThe first MultiMemo dissemination conference and commemoration event aims to promote a new language of commemoration through a multidirectional approach to Holocaust remembrance based on the four principles of inclusivity, sustainability, the rescuing of memory, and epistemic justice through arts, academia, urbanism, activism, and policy making.","performers":"Dr. Alexandra Janus \u2013 FUNDACJA ZAPOMNIANE, Magdalena Rubenfeld- FESTIVALT, Dr. Frederek Musall \u2013 Hochschule fur J\u00fcdische Studien Heidelberg, Johanan Seynave \u2013 Bnai Brith Europe, Bre uwin, Naomi, Solenne \u2013 Flemish African House, Hady-Salom\u00e9 Dahan \u2013 Slam Poet Artist, Vilmos Csik\u00f3s father and son \u2013 musicians, Shoshana Walfish & C\u00e9line Gaza","boxoffice_url":null,"website":"https:\/\/ceji.org\/multimemo-dissemination-conference-and-holocaust-commemoration-event\/","email":"Ceji@ceji.org","phone_contact":"+ 32 (0)2 \u2013 344 34 44","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50006100"},"it":{"name":"MultiMemo Dissemination Conference and Holocaust Commemoration Event","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/ceji.org\/multimemo-couple-dun-evenement-de-commemoration-des-genocides-de-la-2eme-guerre-mondiale\/","email":"Ceji@ceji.org","phone_contact":"+ 32 (0)2 \u2013 344 34 44","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50006100"},"cn":{"name":"MultiMemo Dissemination Conference and Holocaust Commemoration Event","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/ceji.org\/multimemo-couple-dun-evenement-de-commemoration-des-genocides-de-la-2eme-guerre-mondiale\/","email":"Ceji@ceji.org","phone_contact":"+ 32 (0)2 \u2013 344 34 44","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50006100"},"fr":{"name":"Conf\u00e9rence de diss\u00e9mination du projet MultiMemo, coupl\u00e9 d\u2019un \u00e9v\u00e9nement de comm\u00e9moration des g\u00e9nocides de la 2\u00e8me guerre mondiale","shortdescr":"Nous avons le plaisir de vous inviter \u00e0 la conf\u00e9rence de diss\u00e9mination du projet MultiMemo, coupl\u00e9 d\u2019un \u00e9v\u00e9nement de comm\u00e9moration des g\u00e9nocides de la 2\u00e8me guerre mondiale. \n\u2018Echos de comm\u00e9moration\u2019 \u2013 Un voyage \u00e0 travers les m\u00e9moires. Un \u00e9v\u00e9nement artistique de comm\u00e9moration des g\u00e9nocides de la 2\u00e8me guerre mondiale.","longdescr":"Cet \u00e9v\u00e9nement est organis\u00e9 par le CEJI \u2013 Une contribution juive \u00e0 une Europe inclusive, en partenariat avec le Mus\u00e9e Juif de Belgique, dans le cadre du projet europ\u00e9en MultiMemo \u2013 Multidirectional Memory: Remembering for Social Justice.  \n\nLe projet MultiMemo \nLe projet MultiMemo propose une approche intersectionnelle de la comm\u00e9moration. Approche qui souligne la pertinence de la m\u00e9moire pour la justice sociale et la n\u00e9cessit\u00e9 de relever les d\u00e9fis contemporains li\u00e9s aux violations des droits humains, aux conflits militaires et \u00e0 la violence, \u00e0 l\u2019exclusion sociale et \u00e0 la crise migratoire. \n\nS\u2019inspirant du concept de \u201cm\u00e9moire multidirectionnelle\u201d, le projet initie diverses formes de comm\u00e9moration active dans les sph\u00e8res publiques, une comm\u00e9moration qui n\u2019existe pas dans un vide social. Au contraire, il souligne la n\u00e9cessit\u00e9 de s\u2019opposer aux pratiques contemporaines de violence et d\u2019exclusion. \n\nLa conf\u00e9rence de diss\u00e9mination du projet et l\u2019\u00e9v\u00e9nement de comm\u00e9moration \nCe premier \u00e9v\u00e9nement de diss\u00e9mination du projet MultiMemo vise \u00e0 promouvoir un nouveau langage de comm\u00e9moration par le biais d\u2019une approche multidirectionnelle de la m\u00e9moire des g\u00e9nocides de la 2\u00e8me guerre mondiale. Cette approche est bas\u00e9e sur les quatre principes d\u2019inclusivit\u00e9, de d\u00e9veloppement durable, de sauvegarde de la m\u00e9moire et de justice \u00e9pist\u00e9mique. Elle est mise en pratique via les arts, le monde acad\u00e9mique, l\u2019urbanisme, l\u2019activisme et l\u2019\u00e9laboration de politiques. ","performers":"Dr. Alexandra Janus \u2013 FUNDACJA ZAPOMNIANE, Magdalena Rubenfeld- FESTIVALT, Dr. Frederek Musall \u2013 Hochschule fur J\u00fcdische Studien Heidelberg, Johanan Seynave \u2013 Bnai Brith Europe, Bre uwin, Naomi, Solenne \u2013 Maison Flamande-Africaine, Hady-Salom\u00e9 Dahan- Artiste po\u00e8te slameuse, Vilmos Csik\u00f3s p\u00e8re et fils \u2013 musiciens, Shoshana Walfish, et C\u00e9line Gaza","boxoffice_url":null,"website":"https:\/\/ceji.org\/multimemo-couple-dun-evenement-de-commemoration-des-genocides-de-la-2eme-guerre-mondiale\/","email":"Ceji@ceji.org","phone_contact":"+ 32 (0)2 \u2013 344 34 44","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50006100"},"sp":{"name":"MultiMemo Dissemination Conference and Holocaust Commemoration Event","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/ceji.org\/multimemo-couple-dun-evenement-de-commemoration-des-genocides-de-la-2eme-guerre-mondiale\/","email":"Ceji@ceji.org","phone_contact":"+ 32 (0)2 \u2013 344 34 44","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50006100"},"nl":{"name":"Graag nodigen we u uit voor de MultiMemo Conferentie en het Holocaust Herdenkingsevenement","shortdescr":"Graag nodigen we u uit voor de MultiMemo Conferentie en het Holocaust Herdenkingsevenement.\n\u2018Echo\u2019s van herinneringen\u2019 \u2013 Een reis doorheen herdenking. Een gezamenlijk artistiek Holocaust Herdenkingsmoment ","longdescr":"Dit evenement wordt georganiseerd door CEJI \u2013 A Jewish Contribution to an inclusive Europe \u2013 in samenwerking met het Joods Museum van Belgi\u00eb, als onderdeel van het Europees project MultiMemo \u2013 Multidirectional Memory: Herinneren voor Sociale Rechtvaardigheid.  \n\nHet MultiMemo project \nHet MultiMemo project stelt een intersectionele benadering van herinnering voor \u2013 een benadering die de relevantie van herdenking voor sociale rechtvaardigheid benadrukt. Het project beklemtoont ook de noodzaak om hedendaagse uitdagingen zoals mensenrechtenschendingen, militaire conflicten en geweld, sociale uitsluiting en de migratiecrisis, aan te gaan.  \n\nOp basis van het concept van \u2018multidirectionele herinnering\u2019 initieert het project een verscheidenheid aan vormen van actieve herinnering in de publieke sfeer van verschillende Europese landen \u2013 een herinnering\/herdenking dat niet in een sociaal vacu\u00fcm bestaat. In plaats daarvan benadrukt het de noodzaak om op te staan tegen hedendaagse praktijken van geweld en uitsluiting. \n\nDe MultiMemo-disseminatieconferentie en het herdenkingsevenement  \nDe eerste MultiMemo conferentie en herdenking promoten een nieuwe herdenkingstaal door middel van een multidirectionele benadering van holocaustherdenking. Deze benadering is gebaseerd op vier principes namelijk inclusiviteit, duurzaamheid, herinneringseducatie en epistemologische rechtvaardigheid door middel van kunst, de academische wereld, urbanisme, activisme en beleidsvorming. ","performers":"Dr. Alexandra Janus \u2013 FUNDACJA ZAPOMNIANE, Magdalena Rubenfeld- FESTIVALT, Dr. Frederek Musall \u2013 Hochschule fur J\u00fcdische Studien Heidelberg, Johanan Seynave \u2013 Bnai Brith Europe, Bre uwin, Naomi, Solenne \u2013 Flemish African House, Hady-Salom\u00e9 Dahan \u2013 Slam Poet Artist, Shoshana Walfish & C\u00e9line Gaza ","boxoffice_url":null,"website":"https:\/\/ceji.org\/multimemo-conferentie-en-het-holocaust-herdenkingsevenement\/","email":"Ceji@ceji.org","phone_contact":"+ 32 (0)2 \u2013 344 34 44","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50006100"}},"place":{"id":209899,"translations":{"de":{"name":"Mus\u00e9e Juif de Belgique","address_street_name":"Rue des Minimes","address_street_number":"21","address_street_box":null,"email":"info@mjb-jmb.org","website":"http:\/\/www.mjb-jmb.org","phone_contact":"+ 32 (0)2 512 19 63","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Minimes, 21","address_line2":"1000 Bruxelles","description_web":"Das J\u00fcdische Museum Belgiens im Sablon-Viertel wirft anhand von Ausstellungen und Aktivit\u00e4ten einen Blick auf die j\u00fcdische Geschichte und Kultur. \r\n\r\nAls lebendiger und dynamischer Ort der Kultur und der Kunst m\u00f6chte das Museum Wissen und Verst\u00e4ndnis f\u00fcr die Geschichte des j\u00fcdischen Glaubens und der Kulturen vermitteln. \r\n\r\nDie drei wichtigsten Missionen sind hierbei die Bewahrung des j\u00fcdischen Kulturguts in Belgien, Wechselausstellungen zu aktuellen Themen sowie Konferenzen, Konzerte, Workshops und Literaturabende.\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Mus\u00e9e Juif de Belgique","address_street_name":"Rue des Minimes","address_street_number":"21","address_street_box":null,"email":"info@mjb-jmb.org","website":"http:\/\/www.mjb-jmb.org","phone_contact":"+ 32 (0)2 512 19 63","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Minimes, 21","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Jewish Museum of Belgium","address_street_name":"Rue des Minimes","address_street_number":"21","address_street_box":null,"email":"info@mjb-jmb.org","website":"http:\/\/www.mjb-jmb.org","phone_contact":"+ 32 (0)2 512 19 63","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Minimes, 21","address_line2":"1000 Bruxelles","description_web":"Located in the Sablon district of Brussels, the Jewish Museum of Belgium takes a fresh look at Jewish history and culture through exhibitions and activities focusing on sharing, discovery and accessibility for all sectors of the public. \r\n \r\nFirmly anchored in the present day, it is an artistic and cultural place that is lively, dynamic and multidisciplinary, led by a team that values openness, boldness and modernity, and whose goal is to promote a knowledge and understanding of Jewish history, religion and culture.\r\n \r\nThrough its three principal missions, namely the preservation of Jewish heritage in Belgium, temporary exhibitions reflecting topical subjects and educational activities for school groups, the team is gradually constructing the public face of the New Museum that will open its doors by 2025.\r\n \r\nPending the start of work, visitors can discover a selection of the permanent collection as well as several temporary exhibitions in two buildings covering a total area of five floors. At the same time, the Museum organises a wide range of activities such as conferences, concerts, workshops and literary evenings.","description_print":null,"booking_url":"https:\/\/ticket.visit.brussels\/en\/209899\/Musee-Juif-de-Belgique\/shop","sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Mus\u00e9e Juif de Belgique","address_street_name":"Rue des Minimes","address_street_number":"21","address_street_box":null,"email":"info@mjb-jmb.org","website":"http:\/\/www.mjb-jmb.org","phone_contact":"+ 32 (0)2 512 19 63","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Minimes, 21","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Mus\u00e9e Juif de Belgique","address_street_name":"Rue des Minimes","address_street_number":"21","address_street_box":null,"email":"info@mjb-jmb.org","website":"http:\/\/www.mjb-jmb.org","phone_contact":"+ 32 (0)2 512 19 63","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Minimes, 21","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Mus\u00e9e Juif de Belgique","address_street_name":"Rue des Minimes","address_street_number":"21","address_street_box":null,"email":"info@mjb-jmb.org","website":"http:\/\/www.mjb-jmb.org","phone_contact":"+ 32 (0)2 512 19 63","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Minimes, 21","address_line2":"1000 Bruxelles","description_web":"Situ\u00e9 \u00e0 Bruxelles, dans le quartier du Sablon, le Mus\u00e9e Juif de Belgique porte un regard novateur sur l\u2019histoire et la culture juive \u00e0 travers des expositions et des activit\u00e9s tourn\u00e9es vers le partage, la d\u00e9couverte et l\u2019accessibilit\u00e9 \u00e0 tous les publics. \r\n \r\nR\u00e9solument ancr\u00e9 dans le pr\u00e9sent, c\u2019est un lieu culturel et artistique vivant, dynamique, pluridisciplinaire, emmen\u00e9 par une \u00e9quipe qui porte haut les valeurs d\u2019ouverture avec audace et modernit\u00e9 dont l\u2019objectif est de promouvoir la connaissance et la compr\u00e9hension de l\u2019histoire, de la religion et des cultures juives.\r\n \r\nA travers ses trois missions principales que sont la conservation du patrimoine juif de Belgique, les expositions temporaires en \u00e9cho \u00e0 des sujets d\u2019actualit\u00e9 et les activit\u00e9s \u00e9ducatives \u00e0 destination des publics scolaires, l\u2019\u00e9quipe construit progressivement le visage du Nouveau Mus\u00e9e qui verra le jour d\u2019ici 2025.\r\n \r\nEn attendant le d\u00e9but des travaux les visiteurs peuvent d\u00e9couvrir, sur deux b\u00e2timents et cinq \u00e9tages, une s\u00e9lection de la collection permanente, et plusieurs expositions temporaires. En parall\u00e8le, le Mus\u00e9e organise pl\u00e9thore d\u2019activit\u00e9s comme des conf\u00e9rences, concerts, ateliers, soir\u00e9es litt\u00e9raires.","description_print":null,"booking_url":"https:\/\/ticket.visit.brussels\/fr\/209899\/Musee-Juif-de-Belgique\/shop","sort_order":"Jewish Museum of Belgium","virtual_visit":null,"visit_url":null},"sp":{"name":"Mus\u00e9e Juif de Belgique","address_street_name":"Rue des Minimes","address_street_number":"21","address_street_box":null,"email":"info@mjb-jmb.org","website":"http:\/\/www.mjb-jmb.org","phone_contact":"+ 32 (0)2 512 19 63","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Minimes, 21","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Joods Museum van Belgi\u00eb","address_street_name":"Minimenstraat","address_street_number":"21","address_street_box":null,"email":"info@mjb-jmb.org","website":"http:\/\/www.mjb-jmb.org\/?lang=nl","phone_contact":"+ 32 (0)2 512 19 63","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Minimenstraat, 21","address_line2":"1000 Bruxelles","description_web":"Het Joods Museum van Belgi\u00eb, gelegen in de Brusselse Zavelwijk, biedt een vernieuwende kijk op de joodse geschiedenis en cultuur aan de hand van tentoonstellingen en activiteiten die gericht zijn op uitwisseling, kennismaking en toegankelijkheid voor alle mogelijke doelgroepen. \r\n \r\nDoor zijn stevige verankering in het heden is het Museum een levendige, dynamische en multidisciplinaire culturele en artistieke locatie, die wordt gedragen door een team dat de waarden van openheid op doortastende en eigentijdse wijze uitdraagt, met de bedoeling om kennis en inzicht in de joodse geschiedenis, godsdienst en culturen te bevorderen.\r\n \r\nVia zijn drie hoofdopdrachten - het behoud van het Belgische joodse erfgoed, tijdelijke tentoonstellingen die aansluiten bij actuele onderwerpen en educatieve activiteiten voor scholen - bouwt het team geleidelijk aan het gezicht uit van het Nieuwe Museum dat tegen 2025 tot stand zal komen.\r\n \r\nIn afwachting van de werken kunnen de bezoekers verspreid over twee gebouwen en vijf verdiepingen kennismaken met een selectie van de permanente collectie en enkele tijdelijke tentoonstellingen. Tegelijk organiseert het Museum een ruime keuze aan activiteiten, zoals lezingen, concerten, workshops en literaire avonden.","description_print":null,"booking_url":"https:\/\/ticket.visit.brussels\/nl\/209899\/Musee-Juif-de-Belgique\/shop","sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[16,2],"translations":{"de":["K\u00f6nigliches Viertel","Marollen"],"pt":[null,null],"en":["Royal","Marolles"],"it":["Quartiere reale","Marolles"],"cn":[null,null],"fr":["Quartier Royal","Marolles"],"sp":["Quartier Royal \u2014Barrio de la Corte\u2014","Marolles"],"nl":["Koninklijke wijk","Marollen"]}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":"art_center","facebook_id":null,"backoffice_id":469,"location":{"lat":50.84076639,"lon":4.35336797},"region":"brussels","last_updated_at":"2023-10-25T09:28:08+02:00","published_at":"2013-10-19T01:13:33+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":50001049,"translations":{"de":{"name":"CEJI - A Jewish Contribution to an Inclusive Europe","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":"Ceji@ceji.org","website":"https:\/\/ceji.org\/","phone_contact":"+ 32 (0)2 \u2013 344 34 44","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"CEJI - A Jewish Contribution to an Inclusive Europe","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"CEJI - A Jewish Contribution to an Inclusive