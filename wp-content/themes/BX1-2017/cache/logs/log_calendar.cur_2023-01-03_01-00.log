losed","wednesday, thursday, friday and saturday: from 12:00 to 18:00","sunday: from 14:00 to 18:00"],"cn":["monday and tuesday: closed","wednesday, thursday, friday and saturday: from 12:00 to 18:00","sunday: from 14:00 to 18:00"]},"date_start":"2022-11-18","date_end":"2023-01-13","is_also_by_appointment":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"opening":{"day":"2022-11-17","start":"18:00:00","timestamp":"2022-11-17T18:00:00+01:00","end":"20:00:00","is_only_by_appointment":true},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-01-02T01:35:27+01:00","published_at":"2022-11-04T19:22:44+01:00","backoffice_id":265191,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.25984142030594},{"id":546225,"date_start":"2022-11-24","date_end":"2023-03-19","date_next":"2023-01-04","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung","it":null,"sp":null,"pt":null,"cn":null}},"others":{"list":[36,39],"translations":{"fr":["Mus\u00e9es et art centers","Photographie"],"nl":["Musea en kunstcentra","Fotografie"],"en":["Museums and art centers","Photography"],"de":["Museen & Kunstzentren","Fotografie"],"it":[null,null],"sp":[null,null],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Illusory Love - Portraits hyperr\u00e9alistes IA Tirages argentiques en Van Dijke","shortdescr":"Sommes-nous pr\u00eats \u00e0 \u00e9prouver des sentiments d'amour et de compassion face \u00e0 la repr\u00e9sentation d'une personne qui n'a jamais exist\u00e9 ? Les portraits hyperr\u00e9alistes g\u00e9n\u00e9r\u00e9s \u00e0 l'aide de l'intelligence artificielle peuvent-ils \u00eatre consid\u00e9r\u00e9s comme de l'art brut ?","longdescr":"Pour cette deuxi\u00e8me exposition consacr\u00e9e aux images g\u00e9n\u00e9r\u00e9es par la description textuelle, la Tiny Gallery interroge notre cr\u00e9dulit\u00e9 face aux images. Jusqu'\u00e0 pr\u00e9sent, la photographie \u00e9tait la repr\u00e9sentation volontaire d'une situation ou d'un moment r\u00e9el. Ce n'est plus le cas..Les artistes entrent ici dans un vrai d\u00e9bat, et tirent la sonnette d'alarme. Pour eux, le geste photographique est identique au monde r\u00e9el. La stylisation, l'\u00e9clairage, l'attitude et l'expression du mod\u00e8le sont toutes d\u00e9termin\u00e9es et dispos\u00e9es dans le texte et sont donc intentionnelles et contr\u00f4l\u00e9es. L'impression selon des proc\u00e9d\u00e9s anciens r\u00e9alise l'illusion et fait oublier la machine. Nous devons \u00eatre prudents.","performers":"Olivier Guyaux; Zhu Dan; Petermfriess.","boxoffice_url":null,"website":"https:\/\/www.tinygallery.photo","email":"olivier@tinygallery.brussels","phone_contact":"+32 475 27 95 56","phone_booking":"+32 475 27 95 56","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.546225"},"nl":{"name":"Illusory Love - IA hyperrealistische portretten Van Dijke zilverdrukken","shortdescr":"Zijn we klaar om gevoelens van liefde en mededogen te ervaren wanneer we worden geconfronteerd met een afbeelding van een persoon die nooit heeft bestaan? Kunnen hyperrealistische portretten die met behulp van kunstmatige intelligentie zijn gemaakt, worden beschouwd als art brut?","longdescr":"Voor deze tweede tentoonstelling gewijd aan afbeeldingen die worden gegenereerd door tekstuele beschrijving, stelt de Tiny Gallery onze goedgelovigheid in vraag wanneer we worden geconfronteerd met afbeeldingen. Tot nu toe was fotografie de vrijwillige weergave van een werkelijke situatie of moment. Dit is niet meer het geval. De kunstenaars gaan hier een heus debat aan en luiden de noodklok. Voor hen is het fotografische gebaar identiek aan de echte wereld. De stilering, belichting, houding en expressie van het model zijn allemaal bepaald en gerangschikt in de tekst en zijn daarom opzettelijk en gecontroleerd. Afdrukken met behulp van oude processen vervult de illusie en leidt ertoe dat de machine wordt vergeten. We moeten voorzichtig zijn.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.546225"},"en":{"name":"Illusory Love - AI hyperrealist portraits Van Dijke silver prints","shortdescr":"Are we ready to experience feelings of love and compassion when faced with a depiction of a person who has never existed? Can hyperrealist portraits generated with the help of artificial intelligence be considered art brut?","longdescr":"For this second exhibition dedicated to images generated by textual description, the Tiny Gallery questions our credulity when faced with images. Up to now, photography has been the voluntary representation of a real situation or moment. This is no longer the case. The artists are entering into a real debate here, and is sounding the alarm. For them, the photographic gesture is identical to the real world. The stylisation, lighting, attitude and expression of the model are all determined and arranged in the text and are therefore intentional and controlled. Printing using old processes fulfils the illusion, and leads to the machine being forgotten. We must be careful.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.546225"},"de":{"name":"Illusory Love - Portraits hyperr\u00e9alistes IA Tirages argentiques en Van Dijke","shortdescr":null,"longdescr":null,"performers":n