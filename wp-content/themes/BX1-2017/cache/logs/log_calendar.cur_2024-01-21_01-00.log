email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50000191"},"fr":{"name":"Tempus","shortdescr":"Le temps se joue de nos histoires","longdescr":"Le temps qui passe. Celui apr\u00e8s lequel nous courons, celui qui lasse, celui qui casse, celui qui fait de nos vies des aventures passionnantes. Comment le temps influe-t-il sur la vie des personnages ? Sur leurs relations ? Sur les valeurs auxquelles ils croient ? Comment \u00e9voluent les personnages lorsque le contexte social, \u00e9conomique, politique, culturel... change au fil du temps ? Qu\u2019est-ce qui bouge ? Qu\u2019est-ce qui reste ? Les personnages vont-ils rire ou pleurer ? Pour le savoir, il faut improviser ! Tous les genres sont permis dans cette pi\u00e8ce de th\u00e9\u00e2tre improvis\u00e9e : com\u00e9die, drame, romance, fresque historique\u2026 Un voyage au gr\u00e9 du temps, tout en sinc\u00e9rit\u00e9. ","performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Tempus","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50000191"},"sp":{"name":"Tempus","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Tempus","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50000191"},"nl":{"name":"Tempus","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Tempus","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50000191"}},"place":{"id":270611,"translations":{"de":{"name":"Th\u00e9\u00e2tre l\u2019Improviste ","address_street_name":"Rue de Fierlant","address_street_number":"120","address_stre