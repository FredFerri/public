idays":true,"is_closed_on_school_holidays":true,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-02-18T01:02:55+01:00","published_at":"2023-11-16T16:19:17+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":289006,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.3968502629920499,"languages":{"spoken":["fr","en"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[27,24],"translations":{"de":["Fotografie","Kunstgalerien"],"pt":[null,null],"en":["Photography","Art Galleries"],"it":["Fotografia","Gallerie d'arte"],"cn":[null,null],"fr":["Photographie","Galeries d'art"],"sp":["Fotograf\u00eda","Galer\u00edas de arte"],"nl":["Fotografie","Galeries"]}}},"translations":{"de":{"name":"Photo Brussels Festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.thepalmbeach.be","email":"sandrineviumasia@thepalmbeach.be","phone_contact":"+32 474 86 42 45","phone_booking":"+32 474 86 42 45","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50004472"},"pt":{"name":"Photo Brussels Festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.thepalmbeach.be","email":"sandrineviumasia@thepalmbeach.be","phone_contact":"+32 474 86 42 45","phone_booking":"+32 474 86 42 45","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50004472"},"en":{"name":"Photo Brussels Festival","shortdescr":"\"Les fleurs\" by FRANCE DUBOIS is about the unheard conversation for human between 2  trees in Brussels, cherry and magnolia. FRANCE DUBOIS followed their evolution for years and years now. It makes the artist think of the way human being grow as well . France uses only a polaroid camera and then scanned the photo and printed them on a high quality cotton paper. A must see!","longdescr":"Two trees blooming in turn, in a silent conversation imperceptible to humans, markers of everything that happens, disappears and returns. Nothing lasts, everything repeats itself, France Dubois seems to tell us, as she observes the same magnolia and cherry trees blossom year after year, in a gesture that is not static, but marks a cyclical rebirth that only spring allows.\nFaced with these two trees watching each other blossom in a wordless dialogue of love, we find ourselves dreaming of being a flower in the midst of the chaos of the world around us. The language of flowers alone conveys this promise of eternal recommencement, and shows walkers, strollers and spectators how sweet it can be to forget oneself for a moment, and perhaps dream of the possibility of being just a flower.\nThe photographer witnesses the passage of time, reminding us through her series without beginning or end that everything is temporary, light and uncertain, and that the apparent fragility of nature conceals only a cycle that repeats itself indefinitely. Like love, like flowers,\nlike the seasons.e ","performers":"The Palm Beach art gallery is pleased to participate at the Photo Brussels Festival for the second year.  FRANCE DUBOIS will be shown with her work \"Les fleurs\". \nA solo show!!!! ","boxoffice_url":null,"website":"http:\/\/www.thepalmbeach.be","email":"sandrineviumasia@thepalmbeach.be","phone_contact":"+32 474 86 42 45","phone_booking":"+32 474 86 42 45","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50004472"},"it":{"name":"Photo Brussels Festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.thepalmbeach.be","email":"sandrineviumasia@thepalmbeach.be","phone_contact":"+32 474 86 42 45","phone_booking":"+32 474 86 42 45","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50004472"},"cn":{"name":"Photo Brussels Festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.thepalmbeach.be","email":"sandrineviumasia@thepalmbeach.be","phone_contact":"+32 474 86 42 45","phone_booking":"+32 474 86 42 45","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50004472"},"fr":{"name":"Photo Brussels Festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.thepalmbeach.be","email":"sandrineviumasia@thepalmbeach.be","phone_contact":"+32 474 86 42 45","phone_booking":"+32 474 86 42 45","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50004472"},"sp":{"name":"Photo Brussels Festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.thepalmbeach.be","email":"sandrineviumasia@thepalmbeach.be","phone_contact":"+32 474 86 42 45","phone_booking":"+32 474 86 42 45","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50004472"},"nl":{"name":"Photo Brussels Festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.thepalmbeach.be","email":"sandrineviumasia@thepalmbeach.be","phone_contact":"+32 474 86 42 45","phone_booking":"+32 474 86 42 45","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50004472"}},"place":{"id":265910,"translations":{"de":{"name":"The Palm Beach","address_street_name":"Rue Meyerbeer","address_street_number":"61","address_street_box":null,"email":"sandrineviumasia@me.com","website":"http:\/\/www.thepalmbeach.be","phone_contact":"+32 474 86 42 45","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Rue Meyerbeer, 61","address_line2":"1190 Forest","des