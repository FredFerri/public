d":295303,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"tour","ranking":0.7937005259840998,"languages":{"spoken":["nl","fr","en"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{"list":[104],"translations":{"de":["Jugendstil, Art d\u00e9co"],"pt":[null],"en":["Art Nouveau, Art D\u00e9co"],"it":["Art Nouveau, Art D\u00e9co"],"cn":[null],"fr":["Art Nouveau, Art D\u00e9co"],"sp":["Art nouveau, art d\u00e9co"],"nl":["Art nouveau, art deco"]}}},"translations":{"de":{"name":"BANAD Festival - Guided tour of the Cohn-Donnay house - De ultieme hallucinatie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/banad.brussels","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50007647"},"pt":{"name":"BANAD Festival - Guided tour of the Cohn-Donnay house - De ultieme hallucinatie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/banad.brussels","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50007647"},"en":{"name":"BANAD Festival - Guided tour of the Cohn-Donnay house - De ultieme hallucinatie","shortdescr":"As part of the BANAD Festival, come and discover the H\u00f4tel Cohn-Donnay, transformed by Paul Hamesse in 1904. ","longdescr":"In 1904, the architect Paul Hamesse, a former employee of Paul Hankar, was engaged by the family Cohn Donnay to transform and remodel this building from the year 1830. He modified the neoclassical fa\u00e7ade by adding a bow-window which matches the geometrical style of the house front. Inside the house, the architect combined different elements in the style of the Glasgow School, the Vienna Secession and partly even from Art Deco. Nowadays, you will find the caf\u00e9-restaurant \u201cDe Ultieme Hallucinatie\u201d in the building which kept most of the decor from 1904.","performers":null,"boxoffice_url":null,"website":"https:\/\/banad.brussels","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50007647"},"it":{"name":"BANAD Festival - Guided tour of the Cohn-Donnay house - De ultieme hallucinatie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/banad.brussels","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50007647"},"cn":{"name":"BANAD Festival - Guided tour of the Cohn-Donnay house - De ultieme hallucinatie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/banad.brussels","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50007647"},"fr":{"name":"BANAD Festival - Visite guid\u00e9e de l'h\u00f4tel Cohn-Donnay - De ultieme hallucinatie","shortdescr":"Dans le cadre du BANAD Festival, venez d\u00e9couvrir l'h\u00f4tel Cohn-Donnay, transform\u00e9 par Paul Hamesse en 1904. ","longdescr":"En 1904, l'architecte Paul Hamesse, ancien collaborateur de Paul Hankar, fut charg\u00e9 par la famille Cohn-Donnay de transformer et r\u00e9am\u00e9nager cet immeuble datant de 1830. Il modifia la fa\u00e7ade n\u00e9oclassique en ajoutant un bow-window au graphisme g\u00e9om\u00e9trique. \u00c0 l'int\u00e9rieur, l'architecte allia les diff\u00e9rentes tendances de l'Art nouveau. On retrouve des \u00e9l\u00e9ments emprunt\u00e9s \u00e0 l'\u00e9cole de Glasgow, \u00e0 la S\u00e9cession viennoise et certains motifs annoncent d\u00e9j\u00e0 l'Art d\u00e9co. Aujourd'hui brasserie restaurant \u00ab De Ultieme Hallucinatie \u00bb, le b\u00e2timent a conserv\u00e9 la plupart de ses d\u00e9cors de 1904.","performers":"Explore.Brussels asbl-vzw ","boxoffice_url":null,"website":"https:\/\/banad.brussels","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50007647"},"sp":{"name":"BANAD Festival - Guided tour of the Cohn-Donnay house - De ultieme hallucinatie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/banad.brussels","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50007647"},"nl":{"name":"BANAD Festival - Rondleiding van de Cohn-Donnay huis - De ultieme hallucinatie","shortdescr":"Kom in het kader van het BANAD Festival het H\u00f4tel Cohn-Donnay ontdekken, dat in 1904 door Paul Hamesse werd verbouwd. ","longdescr":"\nZATERDAG 23 en ZONDAG 24 \nMAART 2024\n\nMeeting Point \n\n\n Koningsstraat 316, 1210 Sint-Joost-Ten-Noode\n\n\n\n\nIn 1904 krijgt de architect Paul Hamesse, de vroegere medewerker van Paul Hankar, de opdracht van de familie Cohn-Donnay om dit gebouw uit 1830 te transformeren en herin te richten. Hij wijzigt de neoclassicistische fa\u00e7ade door een bow-window in geometrische stijl toe te voegen. In het interieur mengt de architect de verschillende tendensen van de art nouveau. We vinden geleende elementen terug van de school van Glasgow, de Weense Secession en verschillende motieven die we reeds art deco kunnen noemen. Vandaag is dit het caf\u00e9-restaurant \"De Ultieme Hallucinatie\". De decors in het huis zijn grotendeels bewaard gebleven.","performers":null,"boxoffice_url":null,"website":"https:\/\/banad.brussels","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50007647"}},"place":{"id":277813,"translations":{"de":{"name":"H\u00f4tel Cohn-Donnay ","address_street_name":"Rue Royale , 1210 Saint-Josse-ten-Noode","address_street_number":"316","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Royale , 1210 Saint-Josse-ten-Noode, 316","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"H\u00f4tel Cohn-Donnay ","address_street_name":"Rue Royale , 1210 Saint-Josse-ten-Noode","address_street_number":"316","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Royale , 1210 Saint-Josse-ten-Noode, 316","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"H\u00f4tel Cohn-Donnay ","address_street_name":"Rue Royale , 1210 Saint-Josse-ten-Noode","address_street_number":"316","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Royale , 1210 Saint-Josse-ten-Noode, 316","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"H\u00f4tel Cohn-Donnay ","address_street_name":"Rue Royale , 1210 Saint-Josse-ten-Noode","address_street_number":"316","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1210","address_city":"S