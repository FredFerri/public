:\/\/bxl.art-nft.gallery","email":"hello@art-nft.gallery","phone_contact":"+32 478 29 20 43","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50008581"},"cn":{"name":"Pictural Fantasies : Poetic Surrealism","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/bxl.art-nft.gallery","email":"hello@art-nft.gallery","phone_contact":"+32 478 29 20 43","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50008581"},"fr":{"name":"Fantaisies Picturales : le Surr\u00e9alisme Po\u00e9tique","shortdescr":"L'artiste Anne de Decker trouve dans la peinture une th\u00e9rapie, une expression de sa cr\u00e9ativit\u00e9 en musique.\nSes tableaux lumineux et joyeux, empreints de po\u00e9sie et de fantaisie, captent l'attention par leurs couleurs vives et leurs touches surr\u00e9alistes. Son univers pictural est un m\u00e9lange d'influences, de Mondrian \u00e0 Klimt, avec une subtile harmonie entre formes g\u00e9om\u00e9triques et courbes g\u00e9n\u00e9reuses.","longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/bxl.art-nft.gallery","email":"hello@art-nft.gallery","phone_contact":"+32 478 29 20 43","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50008581"},"sp":{"name":"Pictural Fantasies : Poetic Surrealism","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/bxl.art-nft.gallery","email":"hello@art-nft.gallery","phone_contact":"+32 478 29 20 43","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50008581"},"nl":{"name":"Picturale fantasie\u00ebn : Po\u00ebtisch surrealisme","shortdescr":"Kunstenares Anne de Decker vindt schilderen een therapie, een uiting van haar creativiteit in muziek.\nHaar heldere, vrolijke schilderijen, doordrenkt met po\u00ebzie en fantasie, vallen op door hun heldere kleuren