m\/gilbard.e.s","email":"info@gilbard.be","phone_contact":"+32 471 92 61 04","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50012983"},"en":{"name":"Bruxelles en Vacances Gilbardises 2024","shortdescr":"From 27\/04\/2024 to 03\/11\/2024, 4th edition of the project \u2018Bruxelles en Vacances, Gilbardises 2024\u2019. This involves the weekly activation and animation of the community square located in front of the Gibard premises, Rue de Liverpool 77 in Anderlecht. ","longdescr":"From 27\/04\/2024 to 03\/11\/2024, 4th edition of the project \u2018Bruxelles en Vacances, Gilbardises 2024\u2019. This involves the weekly activation and animation of the community square located in front of the Gibard premises, Rue de Liverpool 77 in Anderlecht: \n- Temporary installation of street furniture every Friday from 1.30pm to 6pm;\n- Regular organisation of participatory workshops on the street: fun and creative workshops, cultural micro\ncultural events ;\n- Cooking workshops for young people; \n- Exhibitions in the SAS;\n- Guided tours and explanations of the materials barter service;\n- Organisation of a neighbourhood party for the car-free day on 22 September 2024, on the Lemmens-Liverpool-Cuylits-Odon micro-neighbourhood, in front of the Gilbard premises Gilbard and the Plaine de Liverpool park.","performers":"Collectif Gilbard & friends","boxoffice_url":null,"website":"http:\/\/instagram.com\/gilbard.e.s","email":"info@gilbard.be","phone_contact":"+32 471 92 61 04","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50012983"},"it":{"name":"Bruxelles en Vacances Gilbardises 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/instagram.com\/gilbard.e.s","email":"info@gilbard.be","phone_contact":"+32 471 92 61 04","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50012983"},"cn":{"name":"Bruxelles en Vacances Gilbardises 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/instagram.com\/gilbard.e.s","email":"info@gilbard.be","phone_contact":"+32 471 92 61 04","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50012983"},"fr":{"name":"Bruxelles en Vacances Gilbardises 2024","shortdescr":"Du 27\/04\/2024 au 03\/11\/2024, 4em \u00e9dition du projet \u201cBruxelles en Vacances, Gilbardises 2024\u201d. Il s\u2019agit de l\u2019activation et animation hebdomadaire du parvis associatif situ\u00e9 devant les locaux de Gibard, Rue de liverpool 77 \u00e0 Anderlecht. ","longdescr":"Du 27\/04\/2024 au 03\/11\/2024, 4em \u00e9dition du projet \u201cBruxelles en Vacances, Gilbardises 2024\u201d. Il s\u2019agit de l\u2019activation et animation hebdomadaire du parvis associatif situ\u00e9 devant les locaux de Gibard, Rue de liverpool 77 \u00e0 Anderlecht : \n- Installation temporaire de mobilier urbain, tous les vendredis de 13h30 \u00e0 18h ;\n- Organisation r\u00e9guli\u00e8re d'ateliers participatifs sur la rue : ateliers ludiques et cr\u00e9atifs, micro\n\u00e9v\u00e9nement culturels ;\n- Ateliers cuisine pour les jeunes ; \n- Expositions dans le SAS ;\n- Visites guid\u00e9es et explications du service de troc de mat\u00e9riaux ;\n- Organisation d\u2019une f\u00eate de quartier pour la journ\u00e9e sans voiture le 22 septembre 2024, sur\nla voie publique dans le micro-quartier Lemmens-Liverpool-Cuylits-Odon, devant les locaux\nde Gilbard et le parc de la plaine de Liverpool.","performers":"Collectif Gilbard & friends","boxoffice_url":null,"website":"http:\/\/instagram.com\/gilbard.e.s","email":"info@gilbard.be","phone_contact":"+32 471 92 61 04","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50012983"},"sp":{"name":"Bruxelles en Vacances Gilbardises 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/instagram.com\/gilbard.e.s","email":"info@gilbard.be","phone_contact":"+32 471 92 61 04","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50012983"},"nl":{"name":"Bruxelles en Vacances Gilbardises 2024","shortdescr":"Van 27\/04\/2024 tot 03\/11\/2024, 4e editie van het project \u201cBruxelles en Vacances, Gilbardises 2024\u201d. Het gaat om de wekelijkse activering en animatie van het buurtplein voor de lokalen van Gibard, Liverpoolstraat 77 in Anderlecht. ","longdescr":"Van 27\/04\/2024 tot 03\/11\/2024, 4e editie van het project \u201cBruxelles en Vacances, Gilbardises 2024\u201d. Het gaat om de wekelijkse activering en animatie van het buurtplein voor de lokalen van Gibard, Liverpoolstraat 77 in Anderlecht: \n- Tijdelijke installatie van straatmeubilair elke vrijdag van 13u30 tot 18u;\n- Regelmatige organisatie van participatieve workshops op straat: ludieke en creatieve workshops, culturele micro\nculturele micro-evenementen;\n- Kookworkshops voor jongeren; \n- Tentoonstellingen in de SAS;\n- Rondleidingen en uitleg over de materialen ruilhandel;\n- Organisatie van een buurtfeest voor de autovrije dag op 22 september 2024, op de de microwijk Lemmens-Liverpool-Cuylits-Odon, voor de lokalen van Gilbard en de Gilbard en het park Plaine de Liverpool.","performers":"Collectif Gilbard & friends","boxoffice_url":null,"website":"http:\/\/instagram.com\/gilbard.e.s","email":"info@gilbard.be","phone_contact":"+32 471 92 61 04","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50012983"}},"place":{"id":50001053,"translations":{"de":{"name":"Gilbard","address_street_name":"Rue de Liverpool","address_street_number":"77","address_street_box":null,"email":"info@gilbard.be","website":"http:\/\/Gilbard.be","phone_contact":"+32 471 92 61 04","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de Liverpool, 77","address_line2":"