inte-Agathe\n","performers":"Renaud De Heyn\n","boxoffice_url":null,"website":"https:\/\/archipel19.be\/evenement\/les-zezelles-de-bruxelles\/","email":"c.poinas@culturebruxellesno.be","phone_contact":"+32 478 90 41 99","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50001634"},"sp":{"name":"Les Zinopin\u00e9es - Lisi\u00e8res par Renaud De Heyn","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/archipel19.be\/evenement\/les-zezelles-de-bruxelles\/","email":"c.poinas@culturebruxellesno.be","phone_contact":"+32 478 90 41 99","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50001634"},"nl":{"name":"Les Zinopin\u00e9es - Lisi\u00e8res par Renaud De Heyn","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/archipel19.be\/evenement\/les-zezelles-de-bruxelles\/","email":"c.poinas@culturebruxellesno.be","phone_contact":"+32 478 90 41 99","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50001634"}},"place":{"id":50000470,"translations":{"de":{"name":"Zavelenberg","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1082","address_city":"Berchem-Sainte-Agathe","address_line1":"Zavelenberg","address_line2":"1082 Berchem-Sainte-Agathe","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Zavelenberg","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1082","address_city":"Berchem-Sainte-Agathe","address_line1":"Zavelenberg","address_line2":"1082 Berchem-Sainte-Agathe","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtua