P5hypElu1MGpDS9YA-EQng","oEmbed_type":"video","oEmbed_height":200,"oEmbed_width":356,"oEmbed_version":"1.0","oEmbed_provider_name":"YouTube","oEmbed_provider_url":"https:\/\/www.youtube.com\/","oEmbed_thumbnail_height":360,"oEmbed_thumbnail_width":480,"oEmbed_thumbnail_url":"https:\/\/i.ytimg.com\/vi\/eFuoxTTJ2UY\/hqdefault.jpg","oEmbed_html":"<iframe width=\"356\" height=\"200\" src=\"https:\/\/www.youtube.com\/embed\/eFuoxTTJ2UY?feature=oembed\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" allowfullscreen><\/iframe>","translations":{"fr":{"title":"Trailer Poema para los Muertos - Gedicht voor de doden\/Po\u00e8me pour les morts"},"nl":{"title":"Trailer Poema para los Muertos - Gedicht voor de doden\/Po\u00e8me pour les morts"},"en":{"title":"Trailer Poema para los Muertos - Gedicht voor de doden\/Po\u00e8me pour les morts"}}}],"dates":[{"day":"2022-06-11","doors":null,"start":"20:00:00","end":"21:30:00","is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":25}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-04-04T13:05:14+02:00","published_at":"2022-04-04T12:42:57+02:00","backoffice_id":250822,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":1.2599210498949},{"id":531786,"date_start":"2022-06-11","date_end":"2022-06-25","date_next":"2022-06-11","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Les Cycles des artisans","shortdescr":"Une apr\u00e8s-midi de pratique du v\u00e9lo et de rencontres autour de l\u2019artisanat ? La r\u00e9gion bruxelloise regorge d\u2019initiatives mettant \u00e0 l\u2019honneur le savoir-vivre et le savoir-faire d\u2019artisans et cr\u00e9ateur. Les \u00ab Cycles des artisans \u00bb vous invitent \u00e0 venir les d\u00e9couvrir.","longdescr":"11 juin : Ferronnerie \u2013 Rencontre avec Louise Brodsky\nSamedi 11 juin, sautez en selle et entrez dans le monde passionnant de la ferronnerie. Tout en prenant en compte le riche pass\u00e9 artisanal bruxellois en arpentant le centre-ville, rencontrez ensuite Louise Brodsky, une passionn\u00e9e d'Art nouveau et une artiste accomplie pratiquant autant la ferronnerie d\u2019Art que le dessin et le design. Cette rencontre sera l\u2019occasion d\u2019un beau dialogue entre pass\u00e9 et pr\u00e9sent. Le reste de la visite comporte d\u2019autres surprises\n18 juin : Textile \u2013 Rencontre avec No\u00e9mie Lemeur\nBruxelles et le textile c\u2019est une longue histoire d\u2019amour qui remonte aux origines de la ville. Des tapisseries qui ont fait la richesse de la ville aux \u0153uvres design, plus contemporaines, de No\u00e9mie Lemeur, vous deviendrez incollable sur le sujet. Vous ne serez pas en reste car d\u2019autres surprises viendront compl\u00e9ter cette apr\u00e8s-midi !\n25 juin : Lutherie \u2013 Rencontre avec Catherine Janssens\nSuivez le guide et la musique ! Enfourchez votre fid\u00e8le destrier pour vous rendre du cot\u00e9 de Schaerbeek ou une rencontre avec Catherine Janssens, Luthi\u00e8re et violoniste suivi d\u2019une visite de son atelier vous fera entrer dans le monde fascinant de la confection d\u2019instruments de musique. Comme les autres dates, d\u2019autres surprises jalonneront votre parcours","performers":null,"boxoffice_url":null,"website":"http:\/\/www.provelo.org","email":"info@provelo.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/531786.html"},"nl":{"name":"Les Cycles des artisans","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/531786.html"},"en":{"name":"Les Cycles des artisans","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/531786.html"},"de":{"name":"Les Cycles des artisans","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/531786.html"},"it":{"name":"Les Cycles des artisans","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/531786.html"},"sp":{"name":"Les Cycles des artisans","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/531786.html"},"pt":{"name":"Les Cycles des artisans","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/531786.html"},"cn":{"name":"Les Cycles des artisans","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/531786.html"}},"place":{"id":228485,"translations":{"fr":{"name":"Pro Velo","address_street_name":"Rue de Londres","address_street_number":"15","address_street_box":null,"email":"info@provelo.org","website":"http:\/\/www.provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de Londres, 15","address_line2":"1050 Ixelles","description_web":"Pro V\u00e9lo est une association au guidon fermement dirig\u00e9 en faveur des cyclistes bruxellois. Elle propose des promenades guid\u00e9es sur deux roues en fran\u00e7ais, n\u00e9erlandais et anglais. Une id\u00e9e sympathique qui permet d\u2019appr\u00e9cier la petite reine ET les richesses multiples de l\u2019environnement bruxellois. Il n\u2019y a plus qu\u2019\u00e0 baisser la t\u00eate pour avoir l\u2019air d\u2019un coureur! Mais non, ce serait dommage, levez les yeux et appr\u00e9ciez le paysage...\r\nLangues: allemand - anglais - espagnol - fran\u00e7ais - n\u00e9erlandais - portugais","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Pro Velo","address_street_name":"Londenstraat","address_street_number":"15","address_street_box":null,"email":"info@provelo.org","website":"http:\/\/www.provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"Londenstraat, 15","address_line2":"1050 Elsene","description_web":"De vzw Pro V\u00e9lo streeft naar meer mobiliteit voor de Brusselse fietsers en organiseert gegidste fietstochten in het Nederlands, Frans en Engels. Kortom, een fijn idee voor wie graag met de haren in de wind de stad afschuimt.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Pro Velo","address_street_name":"Rue de Londres","address_street_number":"15","address_street_box":null,"email":"info@provelo.org","website":"http:\/\/www.provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de Londres, 15","addre