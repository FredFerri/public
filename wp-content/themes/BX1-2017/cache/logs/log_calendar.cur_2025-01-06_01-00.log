ps:\/\/www.lentrela.be\/evenement\/change\/","email":"info@lentrela.be","phone_contact":"+32 2 241 15 83","phone_booking":"+32 2 241 15 83","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700004979"},"pt":{"name":"Change !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lentrela.be\/evenement\/change\/","email":"info@lentrela.be","phone_contact":"+32 2 241 15 83","phone_booking":"+32 2 241 15 83","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700004979"},"en":{"name":"Change !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lentrela.be\/evenement\/change\/","email":"info@lentrela.be","phone_contact":"+32 2 241 15 83","phone_booking":"+32 2 241 15 83","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700004979"},"it":{"name":"Change !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lentrela.be\/evenement\/change\/","email":"info@lentrela.be","phone_contact":"+32 2 241 15 83","phone_booking":"+32 2 241 15 83","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700004979"},"cn":{"name":"Change !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lentrela.be\/evenement\/change\/","email":"info@lentrela.be","phone_contact":"+32 2 241 15 83","phone_booking":"+32 2 241 15 83","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700004979"},"fr":{"name":"Change !","shortdescr":"Une symphonie de protestation qui r\u00e9sonne comme une d\u00e9claration musicale de guerre ! \n\nElsa de Lacerda, violon et Mathieu Idmtal piano, deux artistes, arm\u00e9s de leurs instruments, pr\u00eats \u00e0 d\u00e9clencher une r\u00e9volution musicale. ","longdescr":"Une symphonie de protestation qui r\u00e9sonne comme une d\u00e9claration musicale de guerre ! \n\nElsa de Lacerda, violon et Mathieu Idmtal piano, deux artistes, arm\u00e9s de leurs instruments, pr\u00eats \u00e0 d\u00e9clencher une r\u00e9volution musicale. \n\nIls ont fouill\u00e9 dans l\u2019histoire r\u00e9cente de l\u2019humanit\u00e9 pour d\u00e9nicher des m\u00e9lodies qui ont agi comme des dynamites sonores, des d\u00e9tonateurs de changement soci\u00e9tal, le tout piment\u00e9 par des cartes blanches \u00e0 des compositeurs d\u2019aujourd\u2019hui, feu vert \u00e0 une v\u00e9ritable cr\u00e9ation musicale rebelle !\n\nElsa de Lacerda Setas : violon, Mathieu Idmtal : piano\nMusiques de G. Grisi, F. Fiorini ; A. Jesupret, H. Noben\u2026\n\nOrganis\u00e9 par l\u2019Acad\u00e9mie d\u2019Evere en collaboration avec L\u2019Entrela\u2019 ","performers":"Elsa de Lacerda Setas : violon, Mathieu Idmtal : piano\nMusiques de G. Grisi, F. Fiorini ; A. Jesupret, H. Noben\u2026","boxoffice_url":null,"website":"https:\/\/www.lentrela.be\/evenement\/change\/","email":"info@lentrela.be","phone_contact":"+32 2 241 15 83","phone_booking":"+32 2 241 15 83","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700004979"},"sp":{"name":"Change !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lentrela.be\/evenement\/change\/","email":"info@lentrela.be","phone_contact":"+32 2 241 15 83","phone_booking":"+32 2 241 15 83","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700004979"},"nl":{"name":"Change !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lentrela.be\/evenement\/change\/","email":"info@lentrela.be","phone_contact":"+32 2 241 15 83","phone_booking":"+32 2 241 15 83","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700004979"}},"place":{"id":237040,"translations":{"de":{"name":"Espace Toots","address_street_name":"Rue Edouard Stuckens","address_street_number":"125","address_street_box":null,