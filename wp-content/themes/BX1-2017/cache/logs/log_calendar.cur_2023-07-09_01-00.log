alse,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung","it":"Esposizioni","sp":"Exhibici\u00f3n","pt":null,"cn":null}},"others":{"list":[36,43],"translations":{"fr":["Mus\u00e9es et art centers","Arts D\u00e9coratifs"],"nl":["Musea en kunstcentra","Decoratieve kunsten"],"en":["Museums and art centers","Decorative art"],"de":["Museen & Kunstzentren","Dekorative K\u00fcnste"],"it":["Musei e centri artistici","Arti decorative"],"sp":["Museos y centros de arte","Artes decorativas"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Un printemps, un relieur: Nathalie Berjon \u00e0 la Wittockiana","shortdescr":"La Wittockiana pr\u00e9sente le travail de Nathalie Berjon dans le cadre d'une s\u00e9rie d'expositions intitul\u00e9e \"Un printemps, un.e relieur.se\".","longdescr":"La Wittockiana pr\u00e9sente le travail de Nathalie Berjon dans le cadre d'une s\u00e9rie d'expositions intitul\u00e9e \"Un printemps, un.e relieur.se\".\r\nPour cette suite de reliures composites, Nathalie Berjon a travaill\u00e9 principalement autour du mat\u00e9riau et d'alliages innovants entre des mat\u00e9riaux peu usuels pour l'art de la reliure. Les r\u00e9sines epoxy s'associent au tissu de verre transparent ou encore au carbone et \u00e0 l'aluminium. Ces associations assurent \u00e0 la reliure solidit\u00e9 et maniabilit\u00e9 du livre, sans toutefois entraver la possibilit\u00e9 de d\u00e9cor.","performers":"Nathalie Berjon","boxoffice_url":null,"website":"http:\/\/www.wittockiana.org","email":"info@wittockiana.org","phone_contact":"+32 2 770 53 33","phone_booking":"+32 2 770 53 33","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.558513"},"nl":{"name":"Een lente, een boekbinder: Nathalie Berjon in de Wittockiana","shortdescr":"La Wittockiana presenteert het werk van Nathalie Berjon in het kader van een reeks tentoonstellingen onder de titel \"Een lente, een boekbinder\".","longdescr":"La Wittockiana presenteert het werk van Nathalie Berjon in het kader van een reeks tentoonstellingen onder de titel \"Een lente, een boekbinder\".\r\nVoor deze reeks samengestelde boekbanden heeft Nathalie Berjon voornamelijk gewerkt met materialen en innovatieve combinaties van materialen die gewoonlijk niet in boekbanden worden gebruikt. Epoxyharsen worden gecombineerd met transparant glasweefsel of koolstof en aluminium. Deze combinaties zorgen ervoor dat de binding stevig en gemakkelijk te hanteren is, zonder de mogelijkheid van decoratie in de weg te staan.","performers":"Nathalie Berjon","boxoffice_url":null,"website":"http:\/\/www.wittockiana.org","email":"info@wittockiana.org","phone_contact":"+32 2 770 53 33","phone_booking":"+32 2 770 53 33","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.558513"},"en":{"name":"A spring, a bookbinder: Nathalie Berjon in the Wittockiana","shortdescr":"La Wittockiana presents the work of Nathalie Berjon as part of a series of exhibitions entitled \"A spring, a bookbinder\".","longdescr":"La Wittockiana presents the work of Nathalie Berjon as part of a series of exhibitions entitled \"A spring, a bookbinder\".\r\nFor this series of composite bindings, Nathalie Berjon has worked mainly on materials and innovative combinations of materials not commonly used in bookbinding. Epoxy resins are combined with transparent glass cloth or carbon and aluminium. These combinations ensure that the binding is solid and easy to handle, without hindering the possibility of decoration.","performers":"Nathalie Berjon","boxoffice_url":null,"website":"http:\/\/www.wittockiana.org","email":"info@wittockiana.org","phone_contact":"+32 2 770 53 33","phone_booking":"+32 2 770 53 33","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.558513"},"de":{"name":"Un printemps, un relieur: Nathalie Berjon \u00e0 la Wittockiana","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wittockiana.org","email":"info@wittockiana.org","phone_contact":"+32 2 770 53 33","phone_booking":"+32 2 770 53 33","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.558513"},"it":{"name":"Un printemps, un relieur: Nathalie Berjon \u00e0 la Wittockiana","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wittockiana.org","email":"info@wittockiana.org","phone_contact":"+32 2 770 53 33","phone_booking":"+32 2 770 53 33","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.558513"},"sp":{"name":"Un printemps, un relieur: Nathalie Berjon \u00e0 la Wittockiana","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wittockiana.org","email":"info@wittockiana.org","phone_contact":"+32 2 770 53 33","phone_booking":"+32 2 770 53 33","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.558513"},"pt":{"name":"Un printemps, un relieur: Nathalie Berjon \u00e0 la Wittockiana","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wittockiana.org","email":"info@wittockiana.org","phone_contact":"+32 2 770 53 33","phone_booking":"+32 2 770 53 33","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.558513"},"cn":{"name":"Un printemps, un relieur: Nathalie Berjon \u00e0 la Wittockiana","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wittockiana.org","email":"info@wittockiana.org","phone_contact":"+32 2 770 53 33","phone_booking":"+32 2 770 53 33","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.558513"}},"place":{"id":142,"translations":{"fr":{"name":"Wittockiana : Mus\u00e9e des Arts du livre et de la Reliure","address_street_name":"Rue du Bemel","address_street_number":"23","address_street_box":null,"email":"info@wit