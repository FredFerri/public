phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Divers lieux \u00e0 Bruxelles","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Divers lieux \u00e0 Bruxelles","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Divers lieux \u00e0 Bruxelles","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[11],"translations":{"fr":["Quartier universitaire (Cimeti\u00e8re d\u2019Ixelles)"],"nl":["Universiteitswijk (Kerkhof van Elsene)"],"en":["University district (Cimeti\u00e8re d\u2019Ixelles)"]}},"zones":{"list":[21],"translations":{"fr":["Sud"],"nl":["Zuid"],"en":["South"]}},"neca":null,"facebook_id":null,"backoffice_id":7718,"location":{"lat":50.8139308,"lon":4.38454078},"region":"brussels","last_updated_at":"2022-06-20T14:35:03+02:00","published_at":"2013-10-19T01:22:45+02:00","import_origin":null,"external_id":null,"is_in_address_book":false,"is_in_vb_export":false,"resto_ranking":0},"organizer":{"id":230104,"translations":{"fr":{"name":"Centre Tch\u00e8que","address_street_name":"Avenue Adolphe Buyl","address_street_number":"150 152","address_street_box":null,"email":"ccbrussels@czech.cz","website":"https:\/\/brussels.czechcentres.cz\/fr\/?locale=fr","phone_contact":"+32 2 641 89 47","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Adolphe Buyl, 150 152","address_line2":"1050 Ixelles","description_web":"En Belgique, le Centre tch\u00e8que a \u00e9t\u00e9 fond\u00e9 en 1997. Depuis, il propose de nombreux \u00e9v\u00e9nements culturels organis\u00e9s avec des partenaires belges, tch\u00e8ques et \u00e9trangers. Nous sommes, entre autres, actifs dans les domaines des arts plastiques, du film, de la musique, du th\u00e9\u00e2tre, des sciences, de l\u2019architecture et du design. Nous comptons, dans nos partenaires des institutions europ\u00e9ennes aussi bien que des centres culturels, communes, th\u00e9\u00e2tres, festivals et les universit\u00e9s bruxellois(es). Nous participons donc de mani\u00e8re r\u00e9currente \u00e0 la bouillonnante vie culturelle belge.\r\n\r\nLe Centre tch\u00e8que \u00e0 Bruxelles est situ\u00e9, comme son nom l\u2019indique, \u00e0 Bruxelles. Toutefois, nous sommes actifs dans le reste de la Belgique que ce soit en Wallonie ou en Flandre et par extension, dans le Grand-Duch\u00e9 du Luxembourg.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Tsjechisch Centrum","address_street_name":"Adolphe Buyllaan","address_street_number":"150 152","address_street_box":null,"email":"ccbrussels@czech.cz","website":"https:\/\/brussels.czechcentres.cz\/nl\/?locale=nl","phone_contact":"+32 2 641 89 47","phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"Adolphe Buyllaan, 150 152","address_line2":"1050 Elsene","description_web":"De Tsjechische centra, een gesubsidieerde organisatie van het Ministerie van Buitenlandse Zaken van Tsjechi\u00eb, zijn het kerninstrument van de publieksdiplomatie van de buitenlandpolitiek van Tsjechi\u00eb en versterken de goede naam van Tsjechi\u00eb in de wereld. Als culturele instelling zijn ze lid van het netwerk van buitenlandse, Europese culturele instellingen \u2013 EUNIC. Ze presenteren ons land binnen een breed scala van culturele en sociale gebieden: van kunst tot creatieve industrie tot promotie van successen van de Tsjechische wetenschap en innovaties. Ze houden zich bezig met onderwijs van het Tsjechisch in het buitenland. Ze sluiten zich aan bij internationale projecten en dienen als platform voor ontwikkeling van de internationale culturele dialoog. Momenteel zijn er in het buitenland op drie continenten in totaal 26 locaties actief \u2013 naast de Tsjechische centra beheren ze eveneens het Tsjechische huis in Moskou, Jeruzalem en Bratislava.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Centre Tch\u00e8que","address_street_name":"Avenue Adolphe Buyllaan","address_street_number":"150 152","address_street_box":null,"email":"ccbrussels@czech.cz","website":"https:\/\/brussels.czechcentres.cz\/en\/?locale=en","phone_contact":"+32 2 641 89 47","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Adolphe Buyllaan, 150 152","address_line2":"1050 Ixelles","description_web":"In Belgium, the Czech Centre was founded in 1997. Since then, it has offered numerous cultural events organised with Belgian, Czech and foreign partners. We are active in the fields of visual arts, film, music, theatre, science, architecture and design. Our partners include European institutions as well as cultural centres, municipalities, theatres, festivals, and universities in Brussels. We are therefore a regular participant in the vibrant Belgian cultural life.\r\n\r\nThe Czech Centre Brussels is located, as its name suggests, in Brussels. However, we are active in the rest of Belgium, whether in Wallonia or Flanders and, by extension, in the Grand Duchy of Luxembourg.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Centre Tch\u00e8que","address_street_name":"Avenue Adolphe Buyl","address_street_number":"150 152","address_street_box":null,"email":"ccbrussels@czech.cz","website":"https:\/\/brussels.czechcentres.cz\/fr\/?locale=fr","phone_contact":"+32 2 641 89 47","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Adolphe Buyl, 150 152","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"nam