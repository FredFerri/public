public","last_updated_at":"2023-03-21T12:05:12+01:00","published_at":"2023-03-21T11:48:59+01:00","backoffice_id":273864,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":1.2599210498949},{"id":550688,"date_start":"2023-03-29","date_end":"2023-03-29","date_next":"2023-03-29","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":true,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater","it":"Teatro","sp":"Teatro","pt":null,"cn":null}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"],"de":["Theater"],"it":["Teatro"],"sp":["Teatro"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"\u00c0 la poursuite de l\u2019oie sauvage (Agora Theater)","shortdescr":"C'est l'histoire\r\nd'une petite fille qui entame un voyage pour retrouver l'oie qu\u2019elle avait surprise au village.","longdescr":"Elle se rend vite compte qu\u2019elle n\u2019est pas la seule \u00e0 chercher quelque chose : le propri\u00e9taire d'un man\u00e8ge parisien cherche son \u00e9l\u00e9phant blanc, le p\u00e8re cherche sa fille et l'histoire se cherche elle-m\u00eame ! \u00c0 travers les p\u00e9r\u00e9grinations de celle-ci, nous rencontrerons une foule d\u2019animaux, sauvages et sages, comme le lion \u00e9tendu \u00e0 c\u00f4t\u00e9 de l'agneau ou le serpent rus\u00e9 qui siffle le mal \u00e0 l'oreille de tous. Nous ferons m\u00eame la connaissance de P\u00e9gase qui connait chaque pays et que seuls les po\u00e8tes et les enfants peuvent monter.\r\nUn spectacle \u00e9tonnant et bariol\u00e9 pour \u00e9veiller le d\u00e9sir d\u2019explo- rer et de comprendre le monde.","performers":"Avec Sascha Bauer, Matthias Weiland et Nikita Zolotar. Mise en sc\u00e8ne : Catharina Gadelha et Ania Michaelis. Texte d\u2019apr\u00e8s \u201cLes sages animaux\u201d de Hannah Arendt. Musique : Wellington Barros. Sc\u00e9nographie : C\u00e9line Leuchter. Costumes : Djuna Reiner. R\u00e9gie lumi\u00e8re et son : Clemens H\u00f6rlbacher.","boxoffice_url":null,"website":"http:\/\/www.theatremontagnemagique.be","email":"info@montagnemagique.be","phone_contact":null,"phone_booking":"+32 2 210 15 90","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.550688"},"nl":{"name":"\u00c0 la poursuite de l\u2019oie sauvage (Agora Theater)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatremontagnemagique.be","email":"info@montagnemagique.be","phone_contact":null,"phone_booking":"+32 2 210 15 90","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.550688"},"en":{"name":"\u00c0 la poursuite de l\u2019oie sauvage (Agora Theater)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatremontagnemagique.be","email":"info@montagnemagique.be","phone_contact":null,"phone_booking":"+32 2 210 15 90","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.550688"},"de":{"name":"\u00c0 la poursuite de l\u2019oie sauvage (Agora Theater)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatremontagnemagique.be","email":"info@montagnemagique.be","phone_contact":null,"phone_booking":"+32 2 210 15 90","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.550688"},"it":{"name":"\u00c0 la poursuite de l\u2019oie sauvage (Agora Theater)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatremontagnemagique.be","email":"info@montagnemagique.be","phone_contact":null,"phone_booking":"+32 2 210 15 90","agenda_url":"https:\/\/visit.brussels\/it\/vi