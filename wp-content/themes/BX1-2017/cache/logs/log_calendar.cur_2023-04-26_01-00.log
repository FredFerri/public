":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":84,"translations":{"fr":"Divers","nl":"Varia","en":"Various","de":"Verschiedenes","it":"Varie","sp":"Varios","pt":null,"cn":null}},"others":{"list":[85],"translations":{"fr":["Portes ouvertes"],"nl":["Opendeurdag"],"en":["Open door"],"de":["Tag der offenen T\u00fcr"],"it":["Porte aperte"],"sp":["Puertas abiertas"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Fermentons \u00e0 la maison","shortdescr":null,"longdescr":"La choucroute, le yaourt, le pain au levain ou encore les cornichons sont des aliments ferment\u00e9s, processus de conservation ancestral qui revient au go\u00fbt du jour. Il s\u2019agit d\u2019aliments \u201cvivants\u201d qui ont l\u2019avantage de se bonifier en saveurs et en \u00e9l\u00e9ments nutritifs gr\u00e2ce \u00e0 ce processus magique.\r\nSi vous d\u00e9sirez percer tous les myst\u00e8res de la fermentation et d\u00e9guster quelques bi\u00e8res et produits ferment\u00e9s, nous vous souhaitons la bienvenue \u00e0 la prochaine soir\u00e9e Comme \u00e0 La Maison qui aura lieu le 28 avril.\r\nLe West Homebrew Club \u2013 des brasseurs amateurs de Bruxelles Nord-Ouest f\u00e9rus de bi\u00e8re mais \u00e9galement de fermentation sous toutes ses formes \u2013 pr\u00e9sentera son asbl et r\u00e9v\u00e8lera les arcanes du brassage avant de proposer une d\u00e9gustation de produits ferment\u00e9s bruxellois comme du pain, des pickles et de la limonade au houblon.\r\nAu programme \u00e9galement : atelier fermentation pour r\u00e9aliser ses pickles faits maison et d\u00e9couverte de bi\u00e8res locales. Le tout dans un ambiance conviviale et musicale avec le pianiste Raphael Roy-Campoamor.","performers":"avec le West Homebrew Club (pour la fermentation), Raphael Roy-Campoamor (piano), Tipsy Tribe (pour la bar),","boxoffice_url":null,"website":"http:\/\/www.archipel19.be","email":"info@archipel19.be","phone_contact":"+32 2 469 26 75","phone_booking":"+32 2 469 26 75","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.553906"},"nl":{"name":"Fermentons \u00e0 la maison","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.archipel19.be","email":"info@archipel19.be","phone_contact":"+32 2 469 26 75","phone_booking":"+32 2 469 26 75","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.553906"},"en":{"name":"Fermentons \u00e0 la maison","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.archipel19.be","email":"info@archipel19.be","phone_contact":"+32 2 469 26 75","phone_booking":"+32 2 469 26 75","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.553906"},"de":{"name":"Fermentons \u00e0 la maison","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.archipel19.be","email":"info@archipel19.be","phone_contact":"+32 2 469 26 75","phone_booking":"+32 2 469 26 75","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.553906"},"it":{"name":"Fermentons \u00e0 la maison","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.archipel19.be","email":"info@archipel19.be","phone_contact":"+32 2 469 26 75","phone_booking":"+32 2 469 26 75","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.553906"},"sp":{"name":"Fermentons \u00e0 la maison","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.archipel19.be","email":"info@archipel19.be","phone_contact":"+32 2 469 26 75","phone_booking":"+32 2 469 26 75","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.553906"},"pt":{"name":"Fermentons \u00e0 la maison","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.archipel19.be","email":"info@archipel19.be","pho