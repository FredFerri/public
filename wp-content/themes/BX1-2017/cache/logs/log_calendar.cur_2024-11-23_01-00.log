"translations":{"de":{"name":"Kindly","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.aubizou.be","email":"reservation@aubizou.be","phone_contact":"+32 474 10 75 76","phone_booking":"+32 474 10 75 76","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50012323"},"pt":{"name":"Kindly","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.aubizou.be","email":"reservation@aubizou.be","phone_contact":"+32 474 10 75 76","phone_booking":"+32 474 10 75 76","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50012323"},"en":{"name":"Kindly","shortdescr":"\"GENTIMENT\" is a journey to the heart of a sensitive soul, who wonders whether kindness really is the key to survival.From age 14.","longdescr":"\"Gentiment\", a one-man show that explores the intricacies of kindness and hypocrisy with humour and subtlety. Get ready for a journey to the heart of a sensitive soul, who wonders whether kindness really is the key to survival. It's a question that resonates with us all, because who hasn't doubted the sincerity behind a smile?\nThe show explores the contrasts of everyday life, highlighting the irony and complexity of our social and human interactions. From age 14.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.aubizou.be","email":"reservation@aubizou.be","phone_contact":"+32 474 10 75 76","phone_booking":"+32 474 10 75 76","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50012323"},"it":{"name":"Kindly","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.aubizou.be","email":"reservation@aubizou.be","phone_contact":"+32 474 10 75 76","phone_booking":"+32 474 10 75 76","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50012323"},"cn":{"name":"Kindly","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.aubizou.be","email":"reservation@aubizou.be","phone_contact":"+32 474 10 75 76","phone_booking":"+32 474 10 75 76","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50012323"},"fr":{"name":"Gentiment","shortdescr":"\u00ab GENTIMENT \u00bb Un voyage au c\u0153ur d'une \u00e2me sensible, qui se demande si la gentillesse est vraiment la cl\u00e9 de la survie. \u00c0 partir de 14 ans.","longdescr":"\"Gentiment\", un seul en sc\u00e8ne qui explore avec humour et subtilit\u00e9 les m\u00e9andres de la gentillesse et de l'hypocrisie. Pr\u00e9parez-vous \u00e0 un voyage au c\u0153ur d'une \u00e2me sensible, qui se demande si la gentillesse est vraiment la cl\u00e9 de la survie. R\u00e9sonnant ainsi en chacun d'entre nous, car qui n'a jamais dout\u00e9 de la sinc\u00e9rit\u00e9 derri\u00e8re un sourire ?\nLe spectacle explore les contrastes de la vie quotidienne, soulignant l'ironie, la complexit\u00e9 de nos interactions sociales et humaines. Spectacle 1h15. Ouverture de la salle jusqu'\u00e0 23h. ","performers":"Par la Cie DisMoiOui. Avec Estelle Beugin. Mise en sc\u00e8ne Alberto Garc\u00eda Sanchez. (Plusieurs prix dont un Moli\u00e8re). ","boxoffice_url":null,"website":"http:\/\/www.aubizou.be","email":"reservation@aubizou.be","phone_contact":"+32 474 10 75 76","phone_booking":"+32 474 10 75 76","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50012323"},"sp":{"name":"Kindly","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.aubizou.be","email":"reservation@aubizou.be","phone_contact":"+32 474 10 75 76","phone_booking":"+32 474 10 75 76","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50012323"},"nl":{"name":"Vriendelijk","shortdescr":"\"GENTIMENT\" is een reis naar het hart van een gevoelige ziel, die zich afvraagt of vriendelijkheid echt de sleutel tot overleven is. Vanaf 14 jaar.","longdescr":"\"Gentiment\", een one-man show die met humor en subtiliteit de fijne kneepjes van vriendelijkheid en hypocrisie verkent. Bereid je voor op een reis naar het hart van een gevoelige ziel, die zich afvraagt of vriendelijkheid echt de sleutel tot overleven is. Het is een vraag die ons allemaal raakt, want wie heeft er nog nooit getwijfeld aan de oprechtheid achter een glimlach?\nDe show verkent de contrasten van het dagelijks leven en benadrukt de ironie en complexiteit van onze sociale en menselijke interacties. Vanaf 14 jaar.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.aubizou.be","email":"reservation@aubizou.be","phone_contact":"+32 474 10 75 76","phone_booking":"+32 474 10 75 76","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50012323"}},"place":{"id":247078,"translations":{"de":{"name":"Au B'izou","address_street_name":"Rue de la Promenade","address_street_number":"13","address_street_box":null,"email":"reservation@aubizou.be","website":"http:\/\/www.aubizou.be\/","phone_contact":"+32 474 10 75 76","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de la Promenade, 13","address_line2":"1070 Anderlecht","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Au B'izou","address_street_name":"Rue de la Promenade","address_street_number":"13","address_street_box":null,"email":"reservation@aubizou.be","website":"http:\/\/www.aubizou.be\/","phone_contact":"+32 474 10 75 76","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de la Promenade, 13","address_line2":"1070 Anderlecht","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Au B'izou","address_street_name":"Rue de la Promenade","address_street_number":"13","address_street_box":null,"email":"reservation@aubizou.be","website":"http:\/\/www.aubizou.be\/","phone_contact":"+32 474 10 75 76","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de la Promenade, 13","address_line2":"1070 Anderlecht","description_web":"\u2018Au B\u2019Izou\u2019 is the theatre for everyone. (It\u2019s an opportunity to discover artists, to abandon your TV and go out, laugh, be moved, reflect and return). The former workshop for upholstering armchairs has been transformed into a welcoming space. Jean busies himself behind the console and Izou writes songs. At \u2018Au B\u2019Izou\u2019, you are at Jean and Izou\u2019s; in other words, you are at home.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Au B'izou","address_street_name":"Rue de la Promenade","address_street_number":"13","address_street_box":null,"email":"reservation@aubizou.be","website":"http:\/\/www.aubizou.be\/","phone_contact":"+32 474 10 75 76","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de la Promenade, 13","address_line2":"1070 Anderlecht","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Au B'izou","address_street_name":"Rue de la Promenade","address_street_number":"13","address_street_box":null,"email":"reservation@aubizou.be","website":"http:\/\/www.aubizou.be\/","phone_contact":"+32 474 10 75 76","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de la Promenade, 13","address_line2":"1070 Anderlecht","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Au B'izou","address_street_name":"Rue de la Promenade","address_street_number":"13","address_street_box":null,"email":"reservation@aubizou.be","website":"http:\/\/www.aubizou.be\/","phone_contact":"+32 474 10 75 76","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de la Promenade, 13","address_line2":"1070 Anderlecht","description_web":"Le B\u2019Izou est le th\u00e9\u00e2tre de toutes les proximit\u00e9s. (C\u2019est l\u2019occasion de d\u00e9couvrir des artistes, de laisser la t\u00e9l\u00e9 pour sortir, rire, s\u2019\u00e9mouvoir, r\u00e9fl\u00e9chir, revenir). L\u2019ancien atelier de garnissage de fauteuils s\u2019est transform\u00e9 en un espace chaleureux. Jean s\u2019affaire derri\u00e8re la console, Izou \u00e9crit des chansons. Au B\u2019Izou vous \u00eates chez Jean et Izou, autant dire vous \u00eates chez vous.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Au B'izou","address_street_name":"Rue de la Promenade","address_street_number":"13","address_street_box":null,"email":"reservation@aubizou.be","website":"http:\/\/www.aubizou.be\/","phone_contact":"+32 474 10 75 76","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de la Promenade, 13","address_line2":"1070 Anderlecht","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Au B'izou","address_street_name":"Wandelingstraat","address_street_number":"13","address_street_box":null,"email":"reservation@aubizou.be","website":"http:\/\/www.aubizou.be\/","phone_contact":"+32 474 10 75 76","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Wandelingstraat, 13","address_line2":"1070 Anderlecht","description_web":"De B\u2019Izou is een theater van uitersten. Het is een theater waar je, nadat je de stekker uit de televisie hebt getrokken, naartoe gaat om artiesten te ontdekken, om de bloemen buiten te zetten, om te lachen, te huilen en met verstomming te worden geslagen. Dit oude atelier van meubelstoffeerders werd omgetoverd in een warme theaterplek. Jean zit er achter de toetsen, Izou schrijft er de liedjes. Je bent er thuis, ook al ben je eigenlijk op bezoek bij Jean en Izou. Komt dat zien!","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[21],"translations":{"de":["S\u00fcden"],"pt":[null],"en":["South"],"it":["Sud"],"cn":[null],"fr":["Sud"],"sp":["Sur"],"nl":["Zuid"]}},"neca":null,"facebook_id":null,"backoffice_id":9284,"location":{"lat":50.82589161,"lon":4.29772179},"region":"brussels","last_updated_at":"2024-08-19T15:42:08+02:00","published_at":"2013-10-19T01:25:47+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":247078,"translations":{"de":{"name":"Au B'izou","address_street_name":"Rue de la Promenade","address_street_number":"13","address_street_box":null,"email":"reservation@aubizou.be","website":"http:\/\/www.aubizou.be\/","phone_contact":"+32 474 10 75 76","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de la Promenade, 13","address_line2":"1070 Anderlecht","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Au B'izou","address_street_name":"Rue de la Promenade","address_street_number":"13","address_street_box":null,"email":"reservation@aubizou.be","website":"http:\/\/www.aubizou.be\/","phone_contact":"+32 474 10 75 76","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de la Promenade, 13","address_line2":"1070 Anderlecht","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Au B'izou","address_street_name":"Rue de la Promenade","address_street_number":"13","address_street_box":null,"email":"reservation@aubizou.be","website":"http:\/\/www.aubizou.be\/","phone_contact":"+32 474 10 75 76","phone_booking":null,"addr