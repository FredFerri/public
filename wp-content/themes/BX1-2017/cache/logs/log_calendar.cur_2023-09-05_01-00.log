gathe \u00e0 Koekelberg, territoires d\u2019exploration du Centre Culturel, o\u00f9 se d\u00e9ploie au gr\u00e9 des vents son action culturelle. \r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Archipel 19 Centre culturel Berchem-Sainte-Agathe et Koekelberg. ","address_street_name":"Place de l'Eglise","address_street_number":"15","address_street_box":null,"email":"info@archipel19.be","website":"http:\/\/www.archipel19.be","phone_contact":"+32 2 469 26 75","phone_booking":null,"address_zip":"1082","address_city":"Berchem-Sainte-Agathe","address_line1":"Place de l'Eglise, 15","address_line2":"1082 Berchem-Sainte-Agathe","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Archipel 19 Centre culturel Berchem-Sainte-Agathe et Koekelberg. ","address_street_name":"Kerkplein","address_street_number":"15","address_street_box":null,"email":"info@archipel19.be","website":"http:\/\/www.archipel19.be","phone_contact":"+32 2 469 26 75","phone_booking":null,"address_zip":"1082","address_city":"Berchem-Sainte-Agathe","address_line1":"Kerkplein, 15","address_line2":"1082 Berchem-Sainte-Agathe","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":1607,"location":{"lat":50.86093968,"lon":4.29193376},"last_updated_at":"2022-10-11T09:42:03+02:00","published_at":"2013-10-19T01:14:29+02:00","is_in_address_book":true,"is_in_vb_export":false,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/3942b2ece56f4a4c5f1be8a305051bd575674243.jpg","width":3508,"height":5649,"ratio":0,"oEmbed_height":5649,"oEmbed_width":3508,"translations":{"de":{"title":"L'Agora au parc Victoria ","copyright":"Caroline Vermeulen "},"pt":{"title":"L'Agora au parc Victoria ","copyright":"Caroline Verme