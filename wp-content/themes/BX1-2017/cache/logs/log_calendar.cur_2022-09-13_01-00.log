u00e9veloppement durable, des penser \u00e0 des alternatives pour demain, le tout dans une ambiance festive et familiale. C\u2019est une opportunit\u00e9 unique de red\u00e9couvrir le coeur de la capitale sous un autre jour, et de se rassembler en famille ou entre amis dans un cadre champ\u00eatre et original. Autour d\u2019un pique-nique g\u00e9ant, la rencontre entre artistes, acteurs du changement et de la mobilit\u00e9 douce se fait naturellement, la nature dans les yeux et le soleil dans le coeur.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.539034"},"nl":{"name":"Bucolic Brussels 2022","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.539034"},"en":{"name":"Bucolic Brussels 2022","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.539034"},"de":{"name":"Bucolic Brussels 2022","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.539034"},"it":{"name":"Bucolic Brussels 2022","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.539034"},"sp":{"name":"Bucolic Brussels 2022","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/age