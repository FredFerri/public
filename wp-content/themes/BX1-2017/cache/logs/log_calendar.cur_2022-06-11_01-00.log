ppointment":false}],"date_exceptions":[{"day":"2022-05-26","start":"10:00:00","end":"18:00:00"},{"day":"2022-05-27","start":"10:00:00","end":"18:00:00"},{"day":"2022-07-21","start":"10:00:00","end":"18:00:00"},{"day":"2022-08-15","start":"10:00:00","end":"18:00:00"}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"visit_profile":{"list":[337,327],"translations":{"fr":["Highlight","Art contemporain"],"nl":["Highlight","Hedendaagse kunst"],"en":["Highlight","Contemporary art"]}},"tags":[],"accessibilities":{"list":[255,257,261,263,265],"translations":{"fr":["Accessible","Am\u00e9nagements pour personnes sourdes et malentendantes","Parking accessible","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9"],"nl":["Toegankelijk","Voorzieningen voor dove en slechthorende personen","Toegankelijke parking","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet"],"en":["Accessible","Facilities for deaf and hearing-impaired people","Accessible parking","Accessible to pedestrians with mobility aids","Adapted toilet"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-06-10T01:07:31+02:00","published_at":"2021-11-26T09:30:57+01:00","backoffice_id":243527,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.2547308482414},{"id":532369,"date_start":"2022-05-06","date_end":"2022-08-28","date_next":"2022-06-10","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":true,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[36,48],"translations":{"fr":["Mus\u00e9es et art centers","Architecture"],"nl":["Musea en kunstcentra","Architectuur"],"en":["Museums and art centers","Architecture "]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Sick Architecture","shortdescr":"Il existe des rapports e\u0301troits entre architecture et maladie. Le discours architectural se fraie toujours un chemin a\u0300 travers les the\u0301ories du corps et de l\u2019esprit, faisant de l\u2019architecte une sorte de me\u0301decin et du client un patient. Avec \u00ab Sick Architecture \u00bb le CIVA et curatrice invit\u00e9e Beatriz Colomina mettent en lumie\u0300re une the\u0301matique plus actuelle que jamais.","longdescr":"La sante\u0301 serait le but premier de l\u2019architecte, comme Vitruve le soulignait de\u0301ja\u0300 au premier sie\u0300cle avant Je\u0301sus-Christ. Pourtant, l\u2019architecture est souvent aussi perc\u0327ue comme cause de maladie \u2013 depuis l\u2019usage de mate\u0301riaux toxiques dans la construction jusqu\u2019au syndrome du ba\u0302timent malsain. L\u2019architecture elle-me\u0302me est tombe\u0301e malade.\r\n\r\nA chaque e\u0301poque et a\u0300 chaque affliction correspond une architecture spe\u0301cifique. L\u2019e\u0301poque des maladies bacte\u0301riennes, de la tuberculose en particulier, a donne\u0301 naissance a\u0300 l\u2019architecture moderne dans les premie\u0300res de\u0301cennies du XXe sie\u0300cle, a\u0300 des ba\u0302timents blancs de\u0301tache\u0301s du \u00ab sol humide ou\u0300 couve la maladie \u00bb, comme le disait Le Corbusier. Durant l\u2019apre\u0300s-guerre, l\u2019attention s\u2019est de\u0301place\u0301e vers les proble\u0300mes psychologiques. L\u2019architecte a souvent e\u0301te\u0301 vu comme une sorte de psy, et la maison pas seulement comme un dispositif me\u0301dical de pre\u0301vention de la maladie, mais aussi comme un espace procurant un confort psychologique ou, comme le disait Richard Neutra, de \u00ab sante\u0301 nerveuse \u00bb. Le XXIe sie\u0300cle est l\u2019a\u0302ge des troubles neurologiques, avec la de\u0301pression, le trouble de\u0301ficitaire de l\u2019attention, les troubles bipolaires, le syndrome du burn-out, les allergies et l\u2019hypersensibilite\u0301 environnementale comme facteurs de\u0301finissant l\u2019expe\u0301rience contemporaine de l\u2019architecture et de l\u2019environnement ba\u0302ti.\r\n\r\nEn attendant, les pande\u0301mies sont de retour. L\u2019e\u0301pide\u0301mie de COVID-19 est en train de refac\u0327onner comple\u0300tement l\u2019architecture et l\u2019urbanisme. Le virus a mis en e\u0301vidence les injustices structurelles en matie\u0300re de race, de classe et de genre, provoquant un appel a\u0300 la transformation sociale et peut-e\u0302tre a\u0300 une re\u0301volution architecturale.\r\n\r\nL\u2019exposition e\u0301largit le cadre historique et conceptuel des discussions, avec des e\u0301le\u0301ments d\u2019analyse qui couvrent un spectre allant de l\u2019architecture historique de la quarantaine a\u0300 Ellis Island et a\u0300 l\u2019ancien lazaret de Venise jusqu\u2019a\u0300 l\u2019architecture moderne d\u2019Aino et Alvar Aalto et d\u2019Henri Lacoste, en passant par les expe\u0301rimentations d\u2019Hans Hollein et de la Coop Himmelb(l)au dans les anne\u0301es 1960. Enfin, \u00ab Sick Architecture \u00bb s\u2019attardera sur les re\u0301alisations de figures contemporaines de l\u2019architecture (51N4E, Elizabeth Diller, architecten jan de vylder inge vinck, Andre\u0301s Jaque) et les propositions et \u0153uvres d\u2019artistes tels que Sammy Baloji, Mohammed Bourouissa, Vivian Caccuri, Goldin+Senneby et Ahmet O\u0308g\u0306u\u0308t.\r\n\r\nL\u2019exposition s\u2019accompagne d\u2019une se\u0301rie de publications en ligne sur e-flux Architecture, dont la premie\u0300re partie est parue en 2020 et dont la seconde partie parai\u0302tra au moment de l\u2019ouverture de l\u2019exposition en mai. Y contribuent, les auteurs suivants :  Gideon Boie, Edna Bonhomme, David Gissen, Brooke Holmes, Fabiola Lopez-Duran, Elizabeth Povinelli, Meredith TenHoor et Mark Wigley, ainsi que de nombreux doctorants de la Princeton University qui participent depuis 2019 aux se\u0301minaires de Beatriz Colomina consacre\u0301s aux liens entre architecture et maladie.\r\n\r\nLe 6 mai, les \u00ab Sick Architecture Talks \u00bb auront lieu de 14 a\u0300 21 heures au CIVA, avec des expose\u0301s de plus de 20 architectes, artistes, e\u0301crivains et scientifiques. L\u2019e\u0301ve\u0300nement, anime\u0301 par le re\u0301dacteur en chef adjoint d\u2019e-flux Architecture, Nick Axel, sera e\u0301galement diffuse\u0301 en direct sur e-flux Live.\r\n\r\nContributions \u00e0 l'exposition : 51N4E, Aino & Alvar Aalto, An Tairan, Andrea Bagnato, Sammy Baloji, Franco Basaglia, Eug\u00e8ne Beaudouin \/ Marcel Lods, Victoria Bergbauer, Anna Bokov, Mohamed Bourouissa, Angela Brown \/ Jorge Gonz\u00e1lez, Ibiayi Briggs, Gaston Brunfaut, Holly Bushman, Victoria Bugge \u00d8ye, Burokade Architects, Vivian Caccuri, Susana Cal\u00f2 \/ Godofredo Pereira, Center for Independent Living, Coop Himmelb(l)au, Simon De Nys-Ketels, Marie de Testa, architecten jan de vylder inge vinck \/ Gideon Boie \/ Filip Dujardin, Elizabeth Diller, dRMM, Clemens Finkelstein, Dante Furioso, Ignacio G. Gal\u00e1n, Goldin+Senneby, Paul Hankar, Josef Hoffmann, Hans Hollein, Victor Horta, Lydia Inber, Stanislas Jasinski, Andr\u00e9s Jaque, Charles Jencks, Angelika Joseph, Rebecca Kellawan, Maggie Keswick Jencks, Henri Lacoste, Le Corbusier, Fabiola Lopez Duran \/ Ana-Maria Tavares, Iv\u00e1n L\u00f3pez Munuera, Miralles Tagliabue EMBT, Jacques Moeschal, L\u00e1szl\u00f3 Moholy-Nagy, Jean Mouigneau, Richard Neutra, Ahmet \u00d6\u011f\u00fct, Kara Plaxa, Michel Polak, Philippe Rahm, Jean Saidman, Guillermo S\u00e1nchez Arsuaga, Alexandra Sastrawati, Giuseppina Scavuzzo, Shivani Shedde, Ren\u00e9 Schoentjes, Maxwell Smith-Holmes, Nicole Sonolet, Iason Stathatos, Meredith TenHoor, Mies van der Rohe, Jeremy Lee Wolin, VOET, Chenchen Yan, Zhongguo Jianzhu","performers":"Beatriz Colomina (curatrice invit\u00e9e, Princeton University), Silvia Franceschini (commissaire, CIVA), Nikolaus Hirsch (directeur artistique, CIVA), Minne De Meyer Engelbeen (assistente-curatrice, CIVA), OFFICE Kersten Geers David Van Severen & Richard Venlet (sc\u00e9nographie)","boxoffice_url":null,"website":"http:\/\/www.civa.brussels","email":"info@civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/532369.html"},"nl":{"name":"Sick Architecture","shortdescr":"Architectuur en ziekte zijn sterk verweven. Het architectuurdiscours maakt gebruik van theoriee\u0308n over lichaam en geest, waarbij de architect wordt gezien als een soort dokter en de opdrachtgever als patie\u0308nt. Met Sick Architecture belichten CIVA en gastcuratrice Beatriz Colomina een onderwerp dat sinds de uitbraak van de coronapandemie sterk op het voorplan trad.","longdescr":"Gezondheid moet het hoger doel zijn van de architect, zoals Vitruvius het al in de eerste eeuw voor Christus vooropstelde. Toch geeft architectuur ook vaak aanleiding tot ziekte: van giftige bouwmaterialen tot binnenlucht die zo slecht is van kwaliteit dat ze tot het sickbuildingsyndroom leidt. Dan is de architectuur zelf ziek.\r\n\r\nElk tijdperk heeft zijn kenmerkende aandoeningen en elke aandoening heeft haar architectuur. Het tijdperk van de bacterie\u0308le ziekten, en meer specifiek tuberculose, leidde in de eerste decennia van de 20ste eeuw tot de moderne architectuur: witte gebouwen die losstonden van de \u2018vochtige grond waarin ziekte broedt\u2019, zoals Le Corbusier het uitdrukte. In de naoorlogse jaren verschoof de aandacht naar psychologische problemen. De architect werd vaak gezien als een soort psychiater: de woning was niet alleen een medisch hulpmiddel dat ziekte kon voorkomen maar ook een manier om psychologisch comfort te bieden of, zoals Richard Neutra het uitdrukte, \u2018gezonde zenuwen\u2019. De 21ste eeuw is het tijdperk van de neurologische aandoeningen: depressie, ADHD, borderline persoonlijkheidsstoornis, overspannenheid, allergie en overgevoeligheid voor bepaalde stoffen bepalen vandaag mee de architectuur en de bebouwde omgeving.\r\n\r\nEn ook de pandemiee\u0308n zijn terug. De impact van covid-19 op architectuur en stedenbouw is gigantisch. Het virus legt de structurele ongelijkheid op basis van ras, klasse en geslacht bloot. Het noopt tot een shift in de maatschappij en misschien zelfs tot een revolutie in de architectuur. De tentoonstelling, die het debat van een breder historisch en conceptueel kader voorziet, behandelt uiteenlopende onderwerpen: van de historische quarantaine-architectuur van Ellis Island en het oude lazzaretto in Venetie\u0308 tot de moderne architectuur van Aino en Alvar Aalto en Henri Lacoste; niet alleen de experimenten uit de jaren 1960 van Hans Hollein en Coop Himmelb(l)au maar ook het hedendaagse werk van architecten als 51N4E, Elizabeth Diller, architecten jan de vylder inge vinck, Andre\u0301s Jaque en kunstenaars als Sammy Baloji, Mohammed Bourouissa, Vivian Caccuri, Goldin+Senneby en Ahmet O\u0308g\u0306u\u0308t.\r\n\r\nBij de tentoonstelling hoort een reeks online essays die worden gepubliceerd op e-flux Architecture. Een eerste reeks werd gepubliceerd in 2020. Het tweede deel verschijnt in mei, wanneer de tentoonstelling opent. De essays zijn geschreven door auteurs als Gideon Boie, Edna Bonhomme, David Gissen, Brooke Holmes, Fabiola Lopez-Duran, Elizabeth Povinelli, Meredith TenHoor en Mark Wigley. Ook zijn er bijdragen van een aantal doctoraatstudenten verbonden aan Princeton University die sinds 2019 deelnemen aan Beatriz Colomina\u2019s seminars over architectuur en ziekte.\r\n\r\nTijdens het evenement Sick Architecture Talks, dat plaatsvindt op 6 mei van 14:00 tot 21:00 in CIVA, delen meer dan 20 architecten, kunstenaars, schrijvers en wetenschappers hun inzichten. De Sick Architecture Talks worden gemodereerd door Nick Axel, adjunct-hoofdredacteur van e-flux Architecture, en live gestreamd op e-flux Live.\r\n\r\nBijdragen aan de tentoonstelling van: 51N4E, Aino & Alvar Aalto, An Tairan, Andrea Bagnato, Sammy Baloji, Franco Basaglia, Eug\u00e8ne Beaudouin \/ Marcel Lods, Victoria Bergbauer, Anna Bokov, Mohamed Bourouissa, Angela Brown \/ Jorge Gonz\u00e1lez, Ibiayi Briggs, Gaston Brunfaut, Holly Bushman, Victoria Bugge \u00d8ye, Burokade Architects, Vivian Caccuri, Susana Cal\u00f2 \/ Godofredo Pereira, Center for Independent Living, Coop Himmelb(l)au, Simon De Nys-Ketels, Marie de Testa, architecten jan de vylder inge vinck \/ Gideon Boie \/ Filip Dujardin, Elizabeth Diller, dRMM, Clemens Finkelstein, Dante Furioso, Ignacio G. Gal\u00e1n, Goldin+Senneby, Paul Hankar, Josef Hoffmann, Hans Hollein, Victor Horta, Lydia Inber, Stanislas Jasinski, Andr\u00e9s Jaque, Charles Jencks, Angelika Joseph, Rebecca Kellawan, Maggie Keswick Jencks, Henri Lacoste, Le Corbusier, Fabiola Lopez Duran \/ Ana-Maria Tavares, Iv\u00e1n L\u00f3pez Munuera, Miralles Tagliabue EMBT, Jacques Moeschal, L\u00e1szl\u00f3 Moholy-Nagy, Jean Mouigneau, Richard Neutra, Ahmet \u00d6\u011f\u00fct, Kara Plaxa, Michel Polak, Philippe Rahm, Jean Saidman, Guillermo S\u00e1nchez Arsuaga, Alexandra Sastrawati, Giuseppina Scavuzzo, Shivani Shedde, Ren\u00e9 Schoentjes, Maxwell Smith-Holmes, Nicole Sonolet, Iason Stathatos, Meredith TenHoor, Mies van der Rohe, Jeremy Lee Wolin, VOET, Chenchen Yan, Zhongguo Jianzhu","performers":"Beatriz Colomina (gastcurator, Princeton University), Silvia Franceschini (curator, CIVA), Nikolaus Hirsch (artistiek directeur, CIVA), Minne De Meyer Engelbeen (assistent-curatrice, CIVA), OFFICE Kersten Geers David Van Severen & Richard Venlet (tentoonstellingsarchitectuur)","boxoffice_url":null,"website":"http:\/\/www.civa.brussels","email":"info@civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":"+32 2 642 24 50","agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/532369.html"},"en":{"name":"Sick Architecture","shortdescr":"Architecture and sickness are tightly intertwined. Architectural discourse always weaves itself through theories of body and brain, constructing the architect as a kind of doctor and the client as patient. With Sick Architecture, CIVA and guest curator Beatriz Colomina (Princeton University) highlight a topic that has shaped our lives since the outbreak of the COVID-19 pandemic.","longdescr":"Health is supposed to be the main goal of the architect, as Vitruvius already insisted in the first century BC. Yet architecture is also often the cause of illness, from toxic building materials to sick building syndrome. Architecture itself has become sick.\r\n\r\nEvery age has its signature afflictions, and each affliction has its architecture. The age of bacterial diseases, particularly tuberculosis, gave birth to modern architecture in the early decades of the 20th century, to white buildings detached from the \u201chumid ground where disease breeds,\u201d as Le Corbusier put it. In the postwar years, attention shifted to psychological problems. The architect was often seen as a kind of shrink; the house not just a medical device for the prevention of disease, but for providing psychological comfort, or as Richard Neutra put it, \u201cnervous health\u201d. The twenty-first century is the age of neurological disorders, with depression, ADHD, borderline personality disorders, burnout syndrome, allergies, and \u201cenvironmental hypersensitivity\u201d defining the contemporary experience of architecture and the built environment.\r\n\r\nMeanwhile, pandemics have returned. COVID-19 is completely reshaping architecture and urbanism. The virus has exposed the structural inequities of race, class, and gender, provoking a call for social transformation and perhaps an architectural revolution. The exhibition offers a wider historical and conceptual frame for such conversations, with materials ranging from the historic quarantine architecture at Ellis Island and the old lazzaretto in Venice to modern architecture by Aino and Alvar Aalto and Henri Lacoste, 1960\u2019s experiments by Hans Hollein and Coop Himmelb(l)au, as well as contemporary work by architects 51N4E, Elizabeth Diller, architecten jan de vylder inge vinck, Andre\u0301s Jaque, artists Sammy Baloji, Mohammed Bourouissa, Vivian Caccuri, Goldin+Senneby and Ahmet O\u0308g\u0306u\u0308t.\r\n\r\nThe exhibition is accompanied by an online publication series on e-flux Architecture whose first part was published in 2020 and whose second part will be published to coincide with the opening of the exhibition in May 2022. The essays include authors such as Gideon Boie, Edna Bonhomme, David Gissen, Brooke Holmes, Fabiola Lopez-Duran, Elizabeth Povinelli, Meredith TenHoor and Mark Wigley, as well as numerous Ph.D. students from Princeton University who have participated in Beatriz Colomina \u0301s seminars on architecture and illness since 2019.\r\n\r\nOn May 6 from 2:00pm to 9:00pm at CIVA, Sick Architecture Talks will feature presentations by more than 20 architects, artists, writers, and scientists. Moderated by e-flux Architecture Deputy Editor Nick Axel, the all-day event will also be livestreamed on e-flux Live.\r\n\r\nContributions exhibition: 51N4E, Aino & Alvar Aalto, An Tairan, Andrea Bagnato, Sammy Baloji, Franco Basaglia, Eug\u00e8ne Beaudouin \/ Marcel Lods, Victoria Bergbauer, Anna Bokov, Mohamed Bourouissa, Angela Brown \/ Jorge Gonz\u00e1lez, Ibiayi Briggs, Gaston Brunfaut, Holly Bushman, Victoria Bugge \u00d8ye, Burokade Architects, Vivian Caccuri, Susana Cal\u00f2 \/ Godofredo Pereira, Center for Independent Living, Coop Himmelb(l)au, Simon De Nys-Ketels, Marie de Testa, architecten jan de vylder inge vinck \/ Gideon Boie \/ Filip Dujardin, Elizabeth Diller, dRMM, Clemens Finkelstein, Dante Furioso, Ignacio G. Gal\u00e1n, Goldin+Senneby, Paul Hankar, Josef Hoffmann, Hans Hollein, Victor Horta, Lydia Inber, Stanislas Jasinski, Andr\u00e9s Jaque, Charles Jencks, Angelika Joseph, Rebecca Kellawan, Maggie Keswick Jencks, Henri Lacoste, Le Corbusier, Fabiola Lopez Duran \/ Ana-Maria Tavares, Iv\u00e1n L\u00f3pez Munuera, Miralles Tagliabue EMBT, Jacques Moeschal, L\u00e1szl\u00f3 Moholy-Nagy, Jean Mouigneau, Richard Neutra, Ahmet \u00d6\u011f\u00fct, Kara Plaxa, Michel Polak, Philippe Rahm, Jean Saidman, Guillermo S\u00e1nchez Arsuaga, Alexandra Sastrawati, Giuseppina Scavuzzo, Shivani Shedde, Ren\u00e9 Schoentjes, Maxwell Smith-Holmes, Nicole Sonolet, Iason Stathatos, Meredith TenHoor, Mies van der Rohe, Jeremy Lee Wolin, VOET, Chenchen Yan, Zhongguo Jianzhu","performers":"Beatriz Colomina (guest curator, Princeton University), Silvia Franceschini (curator, CIVA), Nikolaus Hirsch (artistic director, CIVA), Minne De Meyer Engelbeen (assistant-curator, CIVA), OFFICE Kersten Geers David Van Severen & Richard Venlet (scenography)","boxoffice_url":null,"website":"http:\/\/www.civa.brussels","email":"info@civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/532369.html"},"de":{"name":"Sick Architecture","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/532369.html"},"it":{"name":"Sick Architecture","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/532369.html"},"sp":{"name":"Sick Architecture","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/532369.html"},"pt":{"name":"Sick Architecture","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/532369.html"},"cn":{"name":"Sick Architecture","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/532369.html"}},"place":{"id":235577,"translations":{"fr":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"CIVA est un muse\u0301e, un centre d'archives, une bibliothe\u0300que et un lieu de rencontre pour les amateurs d'architecture, d'architecture paysage\u0300re, d'e\u0301cosyste\u0300mes urbains et d'histoire a\u0300 Bruxelles. Tout au long de l'anne\u0301e, vous pouvez vous y rendre pour des expositions temporaires, des confe\u0301rences, des de\u0301bats, des visites guide\u0301es, des lancements de livres et des activite\u0301s pour les enfants. Les activite\u0301s se trouvent a\u0300 Ixelles, pre\u0300s de la Place Flagey et au centre de Bruxelles, a\u0300 KANAL - Centre Pompidou.\r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"CIVA","address_street_name":"Kluisstraat","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"Kluisstraat","address_line2":"1050 Elsene","description_web":"CIVA is een museum, een archiefcentrum, een bibliotheek en een ontmoetingsplek voor liefhebbers van architectuur, landschapsarchitectuur, stadsecosystemen en geschiedenis in Brussel. Het hele jaar door kan je er terecht voor tijdelijke tentoonstellingen, lezingen, debatten, rondleidingen, book launches en kinderactiviteiten. De activiteiten vind je in Elsene, vlakbij het Flageyplein en in Brussel-centrum, in KANAL \u2013 Centre Pompidou.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"CIVA is a museum, an archive center, a library and a meeting place for lovers of architecture, landscape architecture, urban ecosystems and history in Brussels. Throughout the year, CIVA organizes temporary exhibitions, lectures, debates, guided tours, book launches and activities for children. The activities are organized in Ixelles, near Place Flagey and in the center of Brussels, in KANAL - Centre Pompidou.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"Das Architekturzentrum CIVA, das 2016 auf Betreiben der Region Br\u00fcssel-Hauptstadt ins Leben gerufen wurde, vereint in einer einzigen Struktur Ressourcen, Wissen und Know-how verschiedener Br\u00fcsseler Vereine aus dem Bereich Kultur, Architektur, St\u00e4dteplanung, Landschaftsarchitektur und Forschungen zum \u00d6kosystem: die Archive f\u00fcr moderne Architektur, die Bibliothek Ren\u00e9 Pech\u00e8re, der Architekturfonds und das Centre Paul Duvigneaud.\r\nMit ihrem kulturellen Projekt tr\u00e4gt die Fondation CIA zur Entwicklung einer architektonischen, landschaftsarchitektonischen und st\u00e4dteplanerischen Kultur bei, die sich mit den Herausforderungen der Gegenwart auseinandersetzt. Schwerpunkt ist Br\u00fcssel. \r\n\r\nDie Fondation CIVA bietet eine ganze Reihe von Aktivit\u00e4ten und Angeboten: Ausstellungen, Konferenzen, Orte des Austauschs und der Debatten, p\u00e4dagogische Aktivit\u00e4ten, Archiveinblicke und Bibliotheken mit knapp 40.000 Werken und Zeitschriften zu den Themen Architektur, St\u00e4dteplanung, Stadtgeschichte, Landschaften, G\u00e4rten und urbane \u00d6kosysteme.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"Creado en 2016 por iniciativa de la Regi\u00f3n Bruselas-Capital, el CIVA re\u00fane una \u00fanica estructura de recursos, conocimiento y aprendizaje de varias asociaciones culturales activas en Bruselas en los campos de la arquitectura, urbanismo, paisajes y el estudio de ecosistemas: los Archivos de Arquitectura Moderna, la Biblioteca Ren\u00e9 Pech\u00e8re, los Fondos para la arquitectura, el Centro Paul Duvigneaud y el CIVA asbl, ahora disuelto.\r\nA trav\u00e9s de este proyecto cultural, la Fundaci\u00f3n CIVA contribuye al desarrollo del paisaje arquitect\u00f3nico y la cultura urbana como base para afrontar desaf\u00edos contempor\u00e1neos, poniendo especial \u00e9nfasis en Bruselas.\r\nSiempre tiene \u00e9xito a la hora de cumplir sus objetivos y tratar con un p\u00fablico amplio (adultos y ni\u00f1os, estudiantes, investigadores, arquitectos, paisajistas, amantes de la naturaleza, pol\u00edticos, etc), la fundaci\u00f3n CIVA organiza numerosos eventos y actividades en diferentes lugares, incluyendo exhibiciones permanentes y temporales, conferencias, debates y actividades educativas. Tambi\u00e9n dispone archivos excepcionales abiertos para todos los p\u00fablicos (documentos de arquitectos y paisajistas: planos, bocetos, modelos, muebles, etc.) y librer\u00edas que contienen casi 40.000 obras y peri\u00f3dicos de arquitectura, urbanismo, la historia de los pueblos y ciudades, paisajes, jardines y ecolog\u00eda urbana.\r\nEstas actividades y materiales est\u00e1n dise\u00f1ados para despertar la curiosidad y el inter\u00e9s de todo nuestro entorno, ya sea un hecho hist\u00f3rico o una construcci\u00f3n.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[5],"translations":{"fr":["Flagey"],"nl":["Flagey"],"en":["Flagey"]}},"zones":{"list":[21],"translations":{"fr":["Sud"],"nl":["Zuid"],"en":["South"]}},"neca":null,"facebook_id":null,"backoffice_id":1436,"location":{"lat":50.82873218,"lon":4.36569034},"region":"brussels","last_updated_at":"2022-06-10T01:07:57+02:00","published_at":"2013-10-19T01:14:20+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":235577,"translations":{"fr":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"CIVA est un muse\u0301e, un centre d'archives, une bibliothe\u0300que et un lieu de rencontre pour les amateurs d'architecture, d'architecture paysage\u0300re, d'e\u0301cosyste\u0300mes urbains et d'histoire a\u0300 Bruxelles. Tout au long de l'anne\u0301e, vous pouvez vous y rendre pour des expositions temporaires, des confe\u0301rences, des de\u0301bats, des visites guide\u0301es, des lancements de livres et des activite\u0301s pour les enfants. Les activite\u0301s se trouvent a\u0300 Ixelles, pre\u0300s de la Place Flagey et au centre de Bruxelles, a\u0300 KANAL - Centre Pompidou.\r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"CIVA","address_street_name":"Kluisstraat","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"Kluisstraat","address_line2":"1050 Elsene","description_web":"CIVA is een museum, een archiefcentrum, een bibliotheek en een ontmoetingsplek voor liefhebbers van architectuur, landschapsarchitectuur, stadsecosystemen en geschiedenis in Brussel. Het hele jaar door kan je er terecht voor tijdelijke tentoonstellingen, lezingen, debatten, rondleidingen, book launches en kinderactiviteiten. De activiteiten vind je in Elsene, vlakbij het Flageyplein en in Brussel-centrum, in KANAL \u2013 Centre Pompidou.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"CIVA is a museum, an archive center, a library and a meeting place for lovers of architecture, landscape architecture, urban ecosystems and history in Brussels. Throughout the year, CIVA organizes temporary exhibitions, lectures, debates, guided tours, book launches and activities for children. The activities are organized in Ixelles, near Place Flagey and in the center of Brussels, in KANAL - Centre Pompidou.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"Das Architekturzentrum CIVA, das 2016 auf Betreiben der Region Br\u00fcssel-Hauptstadt ins Leben gerufen wurde, vereint in einer einzigen Struktur Ressourcen, Wissen und Know-how verschiedener Br\u00fcsseler Vereine aus dem Bereich Kultur, Architektur, St\u00e4dteplanung, Landschaftsarchitektur und Forschungen zum \u00d6kosystem: die Archive f\u00fcr moderne Architektur, die Bibliothek Ren\u00e9 Pech\u00e8re, der Architekturfonds und das Centre Paul Duvigneaud.\r\nMit ihrem kulturellen Projekt tr\u00e4gt die Fondation CIA zur Entwicklung einer architektonischen, landschaftsarchitektonischen und st\u00e4dteplanerischen Kultur bei, die sich mit den Herausforderungen der Gegenwart auseinandersetzt. Schwerpunkt ist Br\u00fcssel. \r\n\r\nDie Fondation CIVA bietet eine ganze Reihe von Aktivit\u00e4ten und Angeboten: Ausstellungen, Konferenzen, Orte des Austauschs und der Debatten, p\u00e4dagogische Aktivit\u00e4ten, Archiveinblicke und Bibliotheken mit knapp 40.000 Werken und Zeitschriften zu den Themen Architektur, St\u00e4dteplanung, Stadtgeschichte, Landschaften, G\u00e4rten und urbane \u00d6kosysteme.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"Creado en 2016 por iniciativa de la Regi\u00f3n Bruselas-Capital, e