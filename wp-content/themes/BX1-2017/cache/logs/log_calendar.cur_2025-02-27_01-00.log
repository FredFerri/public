.\r\n\r\nThe MdA has hosted a rich programme of artistic activities since the 1950s when the building was purchased by Schaerbeek Council. In 2005, the MdA began a programme of inviting artists to work in building, to build more coherence between their works of art and the MdA.\r\n\r\nMost recently, in 2016, Schaerbeek Council decided to position the MdA as a centre for the creation, diffusion and promotion of culture, contemporary two-dimensional, three-dimensional and digital art.\r\nThe MdA\u2019s educational and social approach aims to promoting equality of access to art and its introduction to new audiences.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Maison des Arts","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 147","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Maison des Arts","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 147","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Maison des Arts","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisonde