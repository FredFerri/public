art_of":null,"sub_type":"concert","ranking":1.2599210498948732,"languages":{"spoken":["fr","en","nl"],"subtitles":[]},"categories":{"main":{"id":1,"translations":{"de":"Konzert","pt":null,"en":"Concert","it":"Concerti","cn":null,"fr":"Concert","sp":"Concierto","nl":"Concert"}},"others":{"list":[11,4],"translations":{"de":["Hiphop, Rnb, Rap","Pop, Rock, Jazz..."],"pt":[null,null],"en":["Hip hop, rnb, rap","Pop, rock, jazz\u2026"],"it":["Hip hop, rnb, rap","Pop, rock, jazz\u2026"],"cn":[null,null],"fr":["Hip hop, rnb, rap","Pop, rock, jazz\u2026"],"sp":["Hip hop, R&B, rap","Pop, rock, jazz\u2026"],"nl":["Hip hop, r&b, rap","Pop, rock, jazz\u2026"]}}},"translations":{"de":{"name":"Cakes da killa","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/pilar.brussels\/nl\/events\/cakes-da-killa","email":"Pilar@vub.be","phone_contact":"+32 2 629 23 29","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50002388"},"pt":{"name":"Cakes da killa","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/pilar.brussels\/nl\/events\/cakes-da-killa","email":"Pilar@vub.be","phone_contact":"+32 2 629 23 29","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50002388"},"en":{"name":"Cakes da Killa","shortdescr":null,"longdescr":"Cakes da Killa is a leading figure in New York's queer hip-hop scene. His sharp flow and fearless presentation quickly propelled him to the top. Cakes musical journey began as a coincidence, where he began recording rap videos purely for fun, but fate had other plans in store for him. When he released his mixtape called \"The Eulogy,\" he quickly became a sensation and received praise from influential sources such as Pitchfork and Anthony Fantano. In 2022, Cakes Da Killa finally released his long-awaited second album \"Svengali\" under the Young Art Records label, owned by TOKiMONSTA. Combining powerful rap with uplifting dance beats, this album brings the unbeatable night culture of New York City to the rest of the world. \"Svengali\" is a cinematic experience that follows a love affair from first contact to breakup, with all the highs and lows of romance and attraction in between. \"Svengali\" brings back the raging, rave-to-dawn energy, opting instead for beats from producer Sam Katz that offer subtler moods, as well as a jazz influence that connects Cakes to the early days of queer culture that emerged in New York jazz clubs and the sonically ambitious jazz lovers who pioneered house music. So, let's not miss this opportunity to dance and connect with the party poet from dancing distance. ","performers":"Cakes da killa, TBA","boxoffice_url":null,"website":"https:\/\/pilar.brussels\/nl\/events\/cakes-da-killa","email":"Pilar@vub.be","phone_contact":"+32 2 629 23 29","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50002388"},"it":{"name":"Cakes da killa","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/pilar.brussels\/nl\/events\/cakes-da-killa","email":"Pilar@vub.be","phone_contact":"+32 2 629 23 29","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50002388"},"cn":{"name":"Cakes da killa","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/pilar.brussels\/nl\/events\/cakes-da-killa","email":"Pilar@vub.be","phone_contact":"+32 2 629 23 29","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50002388"},"fr":{"name":"Cakes da Killa","shortdescr":null,"longdescr":"Cakes da Killa est une figure de proue de la sc\u00e8ne hip-hop queer de New York. Son flow incisif et sa pr\u00e9sentation intr\u00e9pide l'ont rapidement propuls\u00e9 au sommet. Le parcours musical de Cakes a commenc\u00e9 par une co\u00efncidence, lorsqu'il a commenc\u00e9 \u00e0 enregistrer des vid\u00e9os de rap uniquement pour s'amuser, mais le destin avait d'autres plans en r\u00e9serve pour lui. Lorsqu'il a sorti sa mixtape intitul\u00e9e \"The Eulogy\", il est rapidement devenu une sensation et a re\u00e7u des \u00e9loges de sources influentes telles que Pitchfork et Anthony Fantano. En 2022, Cakes Da Killa a finalement sorti son deuxi\u00e8me album tant attendu, \"Svengali\", sous le label Young Art Records, propri\u00e9t\u00e9 de TOKiMONSTA. Alliant un rap puissant \u00e0 des rythmes de danse entra\u00eenants, cet album fait d\u00e9couvrir au reste du monde la culture nocturne imbattable de la ville de New York. \"Svengali\" est une exp\u00e9rience cin\u00e9matographique qui suit une histoire d'amour du premier contact \u00e0 la rupture, avec tous les hauts et les bas de la romance et de l'attirance entre les deux. \"Svengali\" renonce \u00e0 l'\u00e9nergie rageuse des raves et de l'aube, pr\u00e9f\u00e9rant les rythmes du producteur Sam Katz qui offrent des ambiances plus subtiles, ainsi qu'une influence jazz qui relie Cakes aux premiers jours de la culture queer qui a \u00e9merg\u00e9 dans les clubs de jazz new-yorkais et aux amateurs de jazz ambitieux sur le plan sonore qui ont \u00e9t\u00e9 les pionniers de la musique house. Ne manquons donc pas cette occasion de danser et de nous connecter avec le po\u00e8te de la f\u00eate \u00e0 distance. ","performers":"Cakes da killa, TBA","boxoffice_url":null,"website":"https:\/\/pilar.brussels\/nl\/events\/cakes-da-killa","email":"Pilar@vub.be","phone_contact":"+32 2 629 23 29","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50002388"},"sp":{"name":"Cakes da killa","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/pilar.brussels\/nl\/events\/cakes-da-killa","email":"Pilar@vub.be","phone_contact":"+32 2 629 23 29","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50002388"},"nl":{"name":"Cakes da Killa","shortdescr":null,"longdescr":"Cakes da Killa is een vooraanstaande figuur in de queer hip-hop scene in New York. Zijn scherpe flow en onbevreesde presentatie zorgden dat hij snel naar de top werd geduwd. Cakes muzikale reis begon als een toevalligheid, waarbij hij rapvideo's begon op te nemen puur voor de lol, maar het lot had andere plannen voor hem in petto. Toen hij zijn mixtape genaamd \"The Eulogy\" uitbracht, werd hij al snel een sensatie en kreeg hij lof van invloedrijke bronnen zoals Pitchfork en Anthony Fantano. In 2022 bracht Cakes Da Killa eindelijk zijn langverwachte tweede album \"Svengali\" uit onder het label Young Art Records, dat eigendom is van TOKiMONSTA. Dit album combineert krachtige rap met opzwepende dancebeats en brengt de onverslaanbare nachtcultuur van New York City naar de rest van de wereld. \"Svengali\" is een filmische ervaring die een liefdesaffaire volgt vanaf het eerste contact tot het uiteenvallen, met alle hoogte- en dieptepunten van romantiek en aantrekkingskracht daartussenin. \"Svengali\" brengt de razende, rave-tot-dageraad energie terug en kiest in plaats daarvan voor beats van producer Sam Katz die subtielere stemmingen bieden, evenals een jazz-invloed die Cakes verbindt met de begindagen van de queer cultuur die ontstond in New Yorkse jazzclubs en de sonisch ambitieuze jazzliefhebbers die housemuziek pionierden. Dus, laten we deze kans niet missen om te dansen en ons te verbinden met de feestdichter vanop dansafstand. ","performers":"Cakes da killa, TBA","boxoffice_url":null,"website":"https:\/\/pilar.brussels\/nl\/events\/cakes-da-killa","email":"Pilar@vub.be","phone_contact":"+32 2 629 23 29","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50002388"}},"place":{"id":273547,"translations":{"de":{"name":"Pilar ","address_street_name":"Triomflaan, VUB  Ingang 6","address_street_number":null,"address_street_box":null,"email":"pilar@vub.be","website":"https:\/\/pilar.brussels\/en","phone_contact":"+32 2 629 23 25","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Triomflaan, VUB  Ingang 6","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Pilar ","address_street_name":"Triomflaan, VUB  Ingang 6","address_street_number":null,"address_street_box":null,"email":"pilar@vub.be","website":"https:\/\/pilar.brussels\/en","phone_contact":"+32 2 629 23 25","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Triomflaan, VUB  Ingang 6","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Pilar","address_street_name":"Triomflaan, VUB  Ingang 6","address_street_number":null,"address_street_box":null,"email":"pilar@vub.be","website":"https:\/\/pilar.brussels\/en","phone_contact":"+32 2 629 23 25","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Triomflaan, VUB  Ingang 6","address_line2":"1050 Ixelles","description_web":"The legendary Kultuurkaffee opened in 1981 and was a place of encounters and discoveries for generations of students until it was demolished in 2015 to make way for a new cultural site. For four and a half years Kultuurkaffee has been operating as a nomadic cultural organization, collaborating with various venues in the capital. Now they are back on the VUB campus, but under a new name: Pilar. Pilar is an open, artistic laboratory in Brussels, a pillar of support for and by young people, a place for cross-fertilisation between art, science and entrepreneurship. Pilar's new space includes a concert and event hall, exhibition areas and a sustainable caf\u00e9 capable of hosting events.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Pilar ","address_street_name":"Triomflaan, VUB  Ingang 6","address_street_number":null,"address_street_box":null,"email":"pilar@vub.be","website":"https:\/\/pilar.brussels\/en","phone_contact":"+32 2 629 23 25","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Triomflaan, VUB  Ingang 6","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Pilar ","address_street_name":"Triomflaan, VUB  Ingang 6","address_street_number":null,"address_street_box":null,"email":"pilar@vub.be","website":"https:\/\/pilar.brussels\/en","phone_contact":"+32 2 629 23 25","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Triomflaan, VUB  Ingang 6","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"fr":{"name":"Pilar ","address_street_name":"Triomflaan, VUB  Ingang 6","address_street_number":null,"address_street_box":null,"email":"pilar@vub.be","website":"https:\/\/pilar.brussels\/en","phone_contact":"+32 2 629 23 25","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Triomflaan, VUB  Ingang 6","address_line2":"1050 Ixelles","description_web":"Le l\u00e9gendaire Kultuurkaffee, ouvert en 1981, et lieu de rencontres et d\u00e9couvertes pour plusieurs g\u00e9n\u00e9rations d'\u00e9tudiants, a \u00e9t\u00e9 d\u00e9molie au cours de 2015 pour faire place \u00e0 un nouveau lieu culturel. Depuis, Kultuurkaffee a fonctionn\u00e9 comme organisation culturelle nomade dans divers endroits de la capitale.  Apr\u00e8s 4,5 ans d'errance KultuurKaffee est maintenant de retour sur le campus de la VUB \u00e0 Etterbeek, mais sous un nouveau nom : Pilar. Pilar sera un laboratoire ouvert et artistique \u00e0 Bruxelles, un pilier de soutien pour et par les jeunes. \r\nLes nouvelles salles de Pilar comprennent une salle de concert et d'\u00e9v\u00e9nements, et des zones d'exposition, ainsi qu'un caf\u00e9 durable riche en \u00e9v\u00e9nements. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Pilar ","address_street_name":"Triomflaan, VUB  Ingang 6","address_street_number":null,"address_street_box":null,"email":"pilar@vub.be","website":"https:\/\/pilar.brussels\/en","phone_contact":"+32 2 629 23 25","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Triomflaan, VUB  Ingang 6","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Pilar ","address_street_name":"Triomflaan, VUB  Ingang 6","address_street_number":null,"address_street_box":null,"email":"pilar@vub.be","website":"https:\/\/pilar.brussels\/nl","phone_contact":"+32 2 629 23 25","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Triomflaan, VUB  Ingang 6","address_line2":"1050 Ixelles","description_web":"Sinds de opening in 1981 stond KultuurKaffee gekend als de ontmoetingsplek voor vele generaties studenten, een waar begrip in het Brusselse cultuurleven. In 2015 werd KultuurKaffee afgebroken en startten de bouwwerken van een nieuwe cultuurtoren. Deze zijn nu klaar. Daarmee landt KultuurKaffee na 4,5 jaar omzwervingen als nomadische kunstenorganisatie in Brussel terug op de VUB-campus in Etterbeek, maar wel onder een nieuwe naam: Pilar. Pilar is een open, artistiek laboratorium in Brussel. Een steunzuil voor en door jongeren. Een huis waarin de kruisbestuiving tussen kunst en wetenschap en ook cultureel ondernemerschap een plaats krijgt. \r\n\r\nDe focus van Pilars werking is tweeledig. Enerzijds blijft Pilar een presentatieplek waar ontluikende en vernieuwende kunstenaars, maar ook gevestigde waarden een podium krijgen. Nog meer dan vroeger komen daarbij verschillende disciplines aan bod en zoekt de werking de grenzen tussen deze disciplines op. Anderzijds werkt Pilar laagdrempelige formats uit om jongeren in alle aspecten van de werking te betrekken en toekomstdenkers en -doeners met ondernemende ambities te ondersteunen.\r\n\r\nDe nieuwe vertrekken van Pilar omvatten onder meer een concert\/eventzaal en exporuimtes en zal ook een duurzame caf\u00e9werking en evenementrijk eetcaf\u00e9 omvatten. \r\n\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[22],"translations":{"de":["Osten"],"pt":[null],"en":["East"],"it":["Est"],"cn":[null],"fr":["Est"],"sp":["Este"],"nl":["Oost"]}},"neca":null,"facebook_id":null,"backoffice_id":33547,"location":{"lat":50.84720202,"lon":4.38749088},"region":"brussels","last_updated_at":"2021-11-10T13:58:24+01:00","published_at":"2019-05-21T16:26:47+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":273547,"translations":{"de":{"name":"Pilar ","address_street_name":"Triomflaan, VUB  Ingang 6","address_street_number":null,"address_street_box":null,"email":"pilar@vub.be","website":"https:\/\/pilar.brussels\/en","phone_contact":"+32 2 629 23 25","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Triomflaan, VUB  Ingang 6","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Pilar ","address_street_name":"Triomflaan, VUB  Ingang 6","address_street_number":null,"address_street_box":null,"email":"pilar@vub.be","website":"https:\/\/pilar.brussels\/en","phone_contact":"+32 2 629 23 25","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Triomflaan, VUB  Ingang 6","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Pilar","addres