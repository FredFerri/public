c","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":309143,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"concert","ranking":1.2599210498948732,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":1,"translations":{"de":"Konzert","pt":null,"en":"Concert","it":"Concerti","cn":null,"fr":"Concert","sp":"Concierto","nl":"Concert"}},"others":{"list":[7,4],"translations":{"de":["Pop, Rock","Pop, Rock, Jazz..."],"pt":[null,null],"en":["Pop, Rock","Pop, rock, jazz\u2026"],"it":["Pop, Rock","Pop, rock, jazz\u2026"],"cn":[null,null],"fr":["Pop, Rock","Pop, rock, jazz\u2026"],"sp":["Pop, rock","Pop, rock, jazz\u2026"],"nl":["Pop, Rock","Pop, rock, jazz\u2026"]}}},"translations":{"de":{"name":"La Nuit Positive - contre le VIH","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lanuitpositive.be","email":"30ans@exaequo.be","phone_contact":"+32 2 736 28 61","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700002173"},"pt":{"name":"La Nuit Positive - contre le VIH","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lanuitpositive.be","email":"30ans@exaequo.be","phone_contact":"+32 2 736 28 61","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700002173"},"en":{"name":"La Nuit Positive - contre le VIH","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lanuitpositive.be","email":"30ans@exaequo.be","phone_contact":"+32 2 736 28 61","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700002173"},"it":{"name":"La Nuit Positive - contre le VIH","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lanuitpositive.be","email":"30ans@exaequo.be","phone_contact":"+32 2 736 28 61","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700002173"},"cn":{"name":"La Nuit Positive - contre le VIH","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lanuitpositive.be","email":"30ans@exaequo.be","phone_contact":"+32 2 736 28 61","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700002173"},"fr":{"name":"La Nuit Positive - contre le VIH","shortdescr":"Grand concert caritatif r\u00e9coltant des fonds pour la lutte contre le VIH et contre les discriminations faites aux personnes vivant avec le VIH en Belgique. \n\nOrganis\u00e9 par Ex Aequo : association de lutte contre le VIH et c\u00e9l\u00e9brant cette ann\u00e9e ses 30ans de combat.\n\nTous ensemble faisons reculer l\u2019\u00e9pid\u00e9mie !","longdescr":"L\u2019association Ex Aequo, acteur majeur dans la lutte contre le VIH en Belgique, organise un concert caritatif exceptionnel, La Nuit Positive, pour c\u00e9l\u00e9brer ses 30 ans de combat contre le virus et les discriminations li\u00e9es \u00e0 cette maladie. Cet \u00e9v\u00e9nement unique se tiendra le 15 d\u00e9cembre dans la Salle de la Madeleine, avec pour objectif de lever des fonds pour soutenir les initiatives de pr\u00e9vention, de sensibilisation et de soutien aux personnes vivant avec le VIH. Les billets sont en vente sur le site de la Madeleine. \n\nSous le parrainage bienveillant de Mustii, ce concert r\u00e9unira un large \u00e9ventail de talents belges et suisses qui, ensemble, mettront leur voix et leur art au service de la cause. Parmi les artistes qui monteront sur sc\u00e8ne, le public aura l\u2019opportunit\u00e9 de d\u00e9couvrir des performances de :\nColt\nGustaph\nDoowy\nEssyla\nGabriel Seize\nMarie Warnant\nKarin Clerq\nAlexandre Houard\nLadiva Live\nCatherine D\u2019oex\nNino Uncut\nEt la participation exceptionnelle de la chorale Sing Out Brussels.\nLe concert sera anim\u00e9 par des pr\u00e9sentateurs de renom, Edna Sorgelsen, r\u00e9v\u00e9l\u00e9e par Drag Race Belgique (Saison 1), et Cyprien de BX1. \n\nTous les b\u00e9n\u00e9fices de cet \u00e9v\u00e9nement seront revers\u00e9s aux projets d\u2019Ex Aequo visant \u00e0 am\u00e9liorer la qualit\u00e9 de vie des personnes vivant avec le VIH et \u00e0 continuer \u00e0 promouvoir la pr\u00e9vention.\n\nLe concert sera suivi d'une after party \u00e0 la soir\u00e9e Flash, o\u00f9 des performances seront offertes par Alvilda (gagnante de Drag Race Belgique, Saison 2), La Veuve, Edna Sorgelsen, Clarika, Lilly Taxiss, Chrystal Von Roederer, Gabanna, Sugar Love et Dorow. Ce moment festif et color\u00e9 prolongera la soir\u00e9e sous le signe de la solidarit\u00e9 et de la c\u00e9l\u00e9bration de la diversit\u00e9.","performers":"Sous le parrainage de Mustii et avec la pr\u00e9sence exeptionnelle de: \nColt, Gustaph, Doowy, Essyla, Gabriel Seize, Marie Warnant, Karin Clerq, Alexandre Houard, Ladiva Live, Catherine D\u2019oex, Nino Uncut et la chorale Sing Out Brussels. \n\nPr\u00e9sent\u00e9 par Edna Sorgelsen et Cyprien\n\n","boxoffice_url":null,"website":"http:\/\/www.lanuitpositive.be","email":"30ans@exaequo.be","phone_contact":"+32 2 736 28 61","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700002173"},"sp":{"name":"La Nuit Positive - contre le VIH","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lanuitpositive.be","email":"30ans@exaequo.be","phone_contact":"+32 2 736 28 61","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700002173"},"nl":{"name":"La Nuit Positive - contre le VIH","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lanuitpositive.be","email":"30ans@exaequo.be","phone_contact":"+32 2 736 28 61","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700002173"}},"place":{"id":4614,"translations":{"de":{"name":"La Madeleine","address_street_name":"Rue Duquesnoy","address_street_number":"14","address_street_box":null,"email":"info@la-madeleine.be","website":"www.la-madeleine.be","phone_contact":"+32 2 658 48 61","phone_booking":"+32 70 66 06 01","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Duquesnoy, 14","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"La Madeleine","address_street_name":"Rue Duquesnoy","address_street_number":"14","address_street_box":null,"email":"info@la-madeleine.be","website":"www.la-madeleine.be","phone_contact":"+32 2 658 48 61","phone_booking":"+32 70 66 06 01","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Duquesnoy, 14","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"La Madeleine","address_street_name":"Rue Duquesnoy","address_street_number":"14","address_street_box":null,"email":"info@la-madeleine.be","website":"www.la-madeleine.be","phone_contact":"+32 2 658 48 61","phone_booking":"+32 70 66 06 01","address_zip":"1000","address_city":"Brussels","address_line1":"Rue Duquesnoy, 14","address_line2":"1000 Brussels","description_web":"The facade of La Madeleine is the only surviving part of the large covered market built in 1847 on the plans of the architect J-P Cluysenaar and inaugurated in 1848. It was the first covered market in Brussels, with the exception of the small flower market designed a short time previously by the same architect in the Galeries Saint-Hubert. It was also one of Brussels\u2019 first large metal constructions.\r\nThe Madeleine market was destroyed in 1957 and gave way to the festival hall of the City of Brussels. The cut stone fa\u00e7ade, whose elevation is inspired by the Loggia dei Lanzi in the Piazza della Signoria in Florence, was kept as the front of a new building.\r\nFor fifty years, the hall welcomed a host of festive and cultural events of all kinds. The venue is also known to the public for its receptions. It is notably where, for a long time, the city\u2019s officials would gather for their annual dance, the Bal des Fonctionnaires.\r\nAfter being operated for several years by the Casino of Brussels, the City of Brussels has officially entrusted the management of the Salle de la Madeleine to Brussels Expo.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"La Madeleine","address_street_name":"Rue Duquesnoy","address_street_number":"14","address_street_box":null,"email":"info@la-madeleine.be","website":"www.la-madeleine.be","phone_contact":"+32 2 658 48 61","phone_booking":"+32 70 66 06 01","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Duquesnoy, 14","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"La Madeleine","address_street_name":"Rue Duquesnoy","address_street_number":"14","address_street_box":null,"email":"info@la-madeleine.be","website":"www.la-madeleine.be","phone_contact":"+32 2 658 48 61","phone_booking":"+32 70 66 06 01","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Duquesnoy, 14","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"La Madeleine","address_street_name":"Rue Duquesnoy","address_street_number":"14","address_street_box":null,"email":"info@la-madeleine.be","website":"www.la-madeleine.be","phone_contact":"+32 2 658 48 61","phone_booking":"+32 70 66 06 01","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Duquesnoy, 14","address_line2":"1000 Bruxelles","description_web":"La fa\u00e7ade de La Madeleine est le seul \u00e9l\u00e9ment conserv\u00e9 du vaste march\u00e9 couvert construit d\u00e8s 1847 sur les plans de l\u2019Architecte J-P Cluysenaar et inaugur\u00e9 en 1848. Il constituait le premier march\u00e9 couvert de Bruxelles, \u00e0 l\u2019exception du petit march\u00e9 aux fleurs, con\u00e7u juste avant par le m\u00eame architecte dans les Galeries Saint-Hubert. C\u2019\u00e9tait aussi \u00e0 Bruxelles, l\u2019une des premi\u00e8res constructions importantes en m\u00e9tal.\r\nLe march\u00e9 de la Madeleine fut d\u00e9truit en 1957 et c\u00e9da la place \u00e0 la salle des f\u00eates de la Ville de Bruxelles. La fa\u00e7ade en pierres de taille, dont l\u2019\u00e9l\u00e9vation est inspir\u00e9e par la Loggia dei Lanzi de la Piazza della Signoria \u00e0 Florence, a \u00e9t\u00e9 conserv\u00e9e en devanture d\u2019un nouveau b\u00e2timent.\r\nDurant une cinquantaine d\u2019ann\u00e9es, la salle accueillit une multitude d\u2019\u00e9v\u00e8nements festifs et culturels en tout genre. La salle est \u00e9galement connue du public pour ses soir\u00e9es, telles que le Bal des Fonctionnaires qu\u2019elle a longtemps abrit\u00e9. \r\nApr\u00e8s une exploitation de plusieurs ann\u00e9es par le Casino de Bruxelles, la Ville de Bruxelles a officiellement confi\u00e9 la gestion de la Salle de la Madeleine \u00e0 Brussels Expo.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"La Madeleine","address_street_name":"Rue Duquesnoy","address_street_number":"14","address_street_box":null,"email":"info@la-madeleine.be","website":"www.la-madeleine.be","phone_contact":"+32 2 658 48 61","phone_booking":"+32 70 66 06 01","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Duquesnoy, 14","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"La Madeleine","address_street_name":"Duquesnoystraat","address_street_number":"14","address_street_box":null,"email":"info@la-madeleine.be","website":"www.la-madeleine.be","phone_contact":"+32 2 658 48 61","phone_booking":"+32 70 66 06 01","address_zip":"1000","address_city":"Brussel","address_line1":"Duquesnoystraat, 14","address_line2":"1000 Brussel","description_web":"De gevel van La Madeleine is het enige element dat overblijft van de grote overdekte markt die in 1847 werd opgetrokken naar een ontwerp van architect J-P Cluysenaar en officieel in gebruik genomen in 1848. Het was de enige overdekte markt in Brussel, naast de kleine bloemenmarkt in de Sint-Hubertusgalerij die kort voordien door dezelfde architect was ontworpen. De markt was ook \u00e9\u00e9n van de eerste grote constructies in metaal.\r\nDe markt van La Madeleine werd in 1957 afgebroken om plaats te maken voor de feestzaal van de Stad Brussel. De hardstenen gevel, ge\u00efnspireerd op de Loggia dei Lanzi de la Piazza della Signoria in Firenze, bleef bewaard als voorgevel voor een nieuw gebouw.\r\nGedurende ongeveer vijftig jaar vonden er in de zaal talrijke feestelijke en culturele evenementen van uiteenlopende aard plaats. Ze was bij het grote publiek ook bekend voor de feesten die er regelmatig plaatsvonden, zoals het Bal van de Ambtenaren dat er jarenlang een onderkomen vond.\r\nNa meerdere jaren exploitatie door het Casino van Brussel heeft de Stad Brussel het beheer van La Madeleine nu officieel toegewezen aan Brussels Expo.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[13],"translations":{"de":["Historisches Stadtzentrum"],"pt":[null],"en":["Historical Centre"],"it":["Centro storico"],"cn":[null],"fr":["Centre historique"],"sp":["Centro hist\u00f3rico"],"nl":["Historisch centrum"]}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centr