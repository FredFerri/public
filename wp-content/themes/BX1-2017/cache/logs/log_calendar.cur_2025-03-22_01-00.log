ranslations":{"de":{"name":"Banksy Museum","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/www.visit.brussels\/de\/besucher\/veranstaltungskalender\/event-detail\/book-tickets.Banksy-Museum.5700007271","website":"https:\/\/banksymuseum.be","email":"info@theworldofbanksy.be","phone_contact":"+32 2 649 49 83","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700007271"},"pt":{"name":"Banksy Museum","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/www.visit.brussels\/en\/visitors\/agenda\/event-detail\/book-tickets.Banksy-Museum.5700007271","website":"https:\/\/banksymuseum.be","email":"info@theworldofbanksy.be","phone_contact":"+32 2 649 49 83","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700007271"},"en":{"name":"Banksy Museum","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/www.ticketing.brussels\/en\/tickets\/event-details.Musee-Banksy.7f6e4590-1ff7-496c-b81e-8fcf49b70e29","website":"https:\/\/banksymuseum.be","email":"info@theworldofbanksy.be","phone_contact":"+32 2 649 49 83","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700007271"},"it":{"name":"Banksy Museum","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/www.visit.brussels\/it\/visitatori\/agenda\/event-detail\/book-tickets.Banksy-Museum.5700007271","website":"https:\/\/banksymuseum.be","email":"info@theworldofbanksy.be","phone_contact":"+32 2 649 49 83","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700007271"},"cn":{"name":"Banksy Museum","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/www.visit.brussels\/en\/visitors\/agenda\/event-detail\/book-tickets.Banksy-Museum.5700007271","website":"https:\/\/banksymuseum.be","email":"info@theworldofbanksy.be","phone_contact":"+32 2 649 49 83","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700007271"},"fr":{"name":"Mus\u00e9e Banksy","shortdescr":"Visitez le Mus\u00e9e Banksy de fa\u00e7on permanente en plein c\u0153ur de Bruxelles. D\u00e9couvrez plus de 120 \u0153uvres du street artiste britannique le plus connu et le plus \u00e9nigmatique.\nDans un cadre parfaitement adapt\u00e9 \u00e0 l\u2019atmosph\u00e8re du street art, une sc\u00e9nographie urbaine vous emm\u00e8nera de ville en ville, pour vous faire d\u00e9couvrir les \u0153uvres iconiques et celles moins connues de ce street artiste toujours anonyme.","longdescr":"\nLA PLUS GRANDE EXPOSITION IMMERSIVE CONSACR\u00c9E \u00c0 BANKSY\n\nLe Mus\u00e9e Banksy de Bruxelles pr\u00e9sente une exposition qui rassemble le plus grand nombre d\u2019\u0153uvres murales grandeur nature du street artiste de Bristol. Ces \u0153uvres reconstitu\u00e9es ainsi que d\u2019autres pi\u00e8ces relatant la riche carri\u00e8re de Banksy ont \u00e9t\u00e9 install\u00e9es dans les locaux mythiques d\u2019une ancienne maison de tissus au c\u0153ur de la ville de Bruxelles. La Place De Brouck\u00e8re et la Place Sainte Catherine se trouvent \u00e0 un jet de pierre du mus\u00e9e. Il est donc facilement accessible, \u00e0 pied, en transport en commun ou en voiture\n\nBanksy est sans aucun doute le street artiste le plus c\u00e9l\u00e8bre et le plus controvers\u00e9 du moment. Le Mus\u00e9e Banksy a pour vocation de pr\u00e9senter Banksy et son approche originale \u00e0 travers les \u0153uvres murales qu\u2019il a peintes dans les rues du monde entier. Il n\u2019\u00e9tait pas question pour l\u2019\u00e9quipe des commissaires de l\u2019exposition de mettre Banksy sous cadre. Les visiteurs d\u00e9couvriront le ma\u00eetre du street art dans une exp\u00e9rience compl\u00e8te et immersive. Le Mus\u00e9e Banksy donne un nouveau souffle aux cr\u00e9ations de l\u2019artiste, car beaucoup d\u2019entre elles ont disparu.\n\nUne \u00e9quipe d\u2019artistes de rue internationaux (aussi anonymes que Banksy) a re\u00e7u les cl\u00e9s de ce lieu magique et l\u2019a transform\u00e9 en un voyage plein de surprises. Ils vous guideront \u00e0 travers le monde en un seul endroit. Ne manquez pas cette exposition ! L\u2019exposition pr\u00e9sente \u00e9galement des reproductions de certains de ses travaux d\u2019atelier, ainsi que des \u00e9l\u00e9ments visuels anim\u00e9s et des vid\u00e9os !!\n\nLes \u0153uvres que Bansky nous propose sont le seul moyen d\u2019appr\u00e9hender son univers.\n\nElles donnent mati\u00e8re \u00e0 r\u00e9flexion et font ressortir le caract\u00e8re ironique et provocateur de l\u2019artiste. Banksy est un citoyen du monde, un humaniste, un d\u00e9fenseur des causes humanitaires, un activiste, un artiviste, un non-conformiste. L\u2019ironie, la provocation et le sens de l\u2019humour sont toujours pr\u00e9sents dans ses cr\u00e9ations.\n\nNous sommes \u00e9galement touch\u00e9s par sa sensibilit\u00e9 lorsqu\u2019il aborde des sujets difficiles comme l\u2019enfance victime des guerres, les migrants, la pauvret\u00e9\u2026).\n\nIl ne donne aucune chance aux exc\u00e8s du consum\u00e9risme, aux dictatures des grandes entreprises. Et s\u2019il peut faire preuve de d\u00e9licatesse, la force de son message reste intacte.","performers":null,"boxoffice_url":"https:\/\/www.ticketing.brussels\/fr\/tickets\/event-details.Musee-Banksy.7f6e4590-1ff7-496c-b81e-8fcf49b70e29","website":"https:\/\/banksymuseum.be","email":"info@theworldofbanksy.be","phone_contact":"+32 2 649 49 83","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700007271"},"sp":{"name":"Banksy Museum","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/www.visit.brussels\/es\/visitantes\/agenda\/event-detail\/book-tickets.Banksy-Museum.5700007271","website":"https:\/\/banksymuseum.be","email":"info@theworldofbanksy.be","phone_contact":"+32 2 649 49 83","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700007271"},"nl":{"name":"Banksy Museum","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/www.ticketing.brussels\/nl\/tickets\/event-details.Musee-Banksy.7f6e4590-1ff7-496c-b81e-8fcf49b70e29","website":"https:\/\/banksymuseum.be","email":"info@theworldofbanksy.be","phone_contact":"+32 2 649 49 83","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700007271"}},"place":{"id":277623,"translations":{"de":{"name":"Mus\u00e9e Banksy Museum","address_street_name":"Rue de Laeken","address_street_number":"28","address_street_box":"1000","email":"info@theworldofbanksy.be","website":"https:\/\/theworldofbanksy.be","phone_contact":"+32 2 649 49 83","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Laeken, 28 \/ 1000","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Mus\u00e9e Banksy Museum","address_street_name":"Rue de Laeken","address_street_number":"28","address_street_box":"1000","email":"info@theworldofbanksy.be","website":"https:\/\/theworldofbanksy.be","phone_contact":"+32 2 649 49 83","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Laeken, 28 \/ 1000","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Mus\u00e9e Banksy Museum","address_street_name":"Lakensestraat","address_street_number":"28","address_street_box":"1000","email":"info@theworldofbanksy.be","website":"https:\/\/theworldofbanksy.be\/en\/","phone_contact":"+32 2 649 49 83","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Lakensestraat, 28 \/ 1000",