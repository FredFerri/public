e_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.558081"},"it":{"name":"En attendant Bojangles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatrelepublic.be","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.558081"},"cn":{"name":"En attendant Bojangles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatrelepublic.be","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.558081"},"fr":{"name":"En attendant Bojangles","shortdescr":null,"longdescr":"Que la folie est contagieuse quand elle est heureuse !\r\nVoici donc une pi\u00e8ce d\u00e9concertante, po\u00e9tique et folle, qui met les sens, sens dessus dessous.\r\n\r\nSous le regard \u00e9merveill\u00e9 de leur fils, ils dansent sur \u00abMr Bojangles\u00bb de Nina Simone. Leur amour est magique, vertigineux, une f\u00eate perp\u00e9tuelle. Chez eux, il n\u2019y a de place que pour le plaisir, la fantaisie et les amis. \r\nCelle qui donne le ton, qui m\u00e8ne le bal, c\u2019est la m\u00e8re, feu follet impr\u00e9visible et extravagant. C\u2019est elle qui n\u2019a de cesse de les entra\u00eener dans un tourbillon de po\u00e9sie et de chim\u00e8res. \r\nUn jour, pourtant, elle va trop loin. Et p\u00e8re et fils feront tout pour \u00e9viter l\u2019in\u00e9luctable, pour que la f\u00eate continue, co\u00fbte que co\u00fbte. \r\n\r\nL\u2019amour fou n\u2019a jamais si bien port\u00e9 son nom.\r\n__________\r\n\r\nD'apr\u00e8s le roman d'Olivier Bourdeaut \/ Adaptation et mise en sc\u00e8ne : Victoire Berger-Perrin \/ Avec : Charlie Dupont, Tania Garbarski et J\u00e9r\u00e9mie Petrus\r\n__________\r\n\r\nUNE PRODUCTION DU TH\u00c9\u00c2TRE LE PUBLIC. AVEC LE SOUTIEN DU TAX SHELTER DE L\u2019\u00c9TAT F\u00c9D\u00c9RAL BELGE VIA BESIDE ET DE LA COMMUNAUT\u00c9 FRAN\u00c7AISE.\r\n\r\n","performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatrelepublic.be","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.558081"},"sp":{"name":"En attendant Bojangles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatrelepublic.be","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.558081"},"nl":{"name":"En attendant Bojangles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatrelepublic.be","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.558081"}},"place":{"id":224476,"translations":{"de":{"name":"Th\u00e9\u00e2tre Le Public","address_street_name":"Rue Braemt","address_street_number":"64 70","address_street_box":null,"email":"contact@theatrelepublic.be","website":"http:\/\/www.theatrelepublic.be","phone_contact":"+32 2 724 24 44","phone_booking":"+32 2 724 24 44","address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Braemt, 64 70","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Th\u00e9\u00e2tre Le Public","address_street_name":"Rue Braemt","address_street_number":"64 70","address_street_box":null,"email":"contact@theatrelepublic.be","website":"http:\/\/www.theatrelepublic.be","phone_contact":"+32 2 724 24 44","phone_booking":"+32 2 724 24 44","address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","addres