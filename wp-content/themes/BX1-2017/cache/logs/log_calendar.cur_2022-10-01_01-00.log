":"Begeleide rondleidingen","en":"Guided tours"}},"others":{"list":[249],"translations":{"fr":["Les incontournables "],"nl":["Highlights"],"en":["Highlights"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Promenade guid\u00e9e au Parlement Europ\u00e9en (gratuite)","shortdescr":"Cette promenade vous fera d\u00e9couvrir lefonctionnement et l'architecture du Parlement europ\u00e9en ainsi que la diversit\u00e9 des b\u00e2timents bordant l'h\u00e9miclycle tels que les jardins Wiertz, le parc L\u00e9opold, La Biblioth\u00e8que Solvay et la Maison de l'histoire europ\u00e9enne.","longdescr":"Cette promenade vous fera d\u00e9couvrir lefonctionnement et l'architecture du Parlement europ\u00e9en ainsi que la diversit\u00e9 des b\u00e2timents bordant l'h\u00e9miclycle tels que les jardins Wiertz, le parc L\u00e9opold, La Biblioth\u00e8que Solvay et la Maison de l'histoire europ\u00e9enne.\nCes visites gratuites ont lieu tous les dimanches du 17 avril au 30 octobre 2022 et les r\u00e9servations se font directement sur le site du Parlement Europ\u00e9en.\nVisites en N\u00e9erlandais \u00e0 10h, en fran\u00e7ais \u00e0 11h, en anglais \u00e0 12h et 15h, et en allemand \u00e0 14h.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.arkadia.be","email":"info@arkadia.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.533658"},"nl":{"name":"Promenade guid\u00e9e au Parlement Europ\u00e9en (gratuite)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.arkadia.be","email":"info@arkadia.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.533658"},"en":{"name":"Promenade guid\u00e9e au Parlement Europ\u00e9en (gratuite)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.arkadia.be","email":"info@arkadia.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.533658"},"de":{"name":"Promenade guid\u00e9e au Parlement Europ\u00e9en (gratuite)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.533658"},"it":{"name":"Promenade guid\u00e9e au Parlement Europ\u00e9en (gratuite)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.533658"},"sp":{"name":"Promenade guid\u00e9e au Parlement Europ\u00e9en (gratuite)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.533658"},"pt":{"name":"Promenade guid\u00e9e au Parlement Europ\u00e9en (gratuite)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.533658"},"cn":{"name":"Promenade guid\u00e9e au Parlement Europ\u00e9en (gratuite)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.533658"}},"place":{"id":266898,"translations":{"fr":{"name":"Station Europe","address_street_name":"Place du Luxembourg","address_street_number":"100","address_street_box":null,"email":"visit@europarl.europa.eu","website":"http:\/\/www.europarl.europa.eu\/visiting\/fr\/brussels\/station-europe","phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Place du Luxembourg, 100","address_line2":"1050 Ixelles","description_web":"FERMEE AUX VISITEURS JUSQU'A NOUVEL ORDRE.\r\nLa Station Europe, situ\u00e9e sur la tr\u00e8s anim\u00e9e place du Luxembourg, est le point de d\u00e9part id\u00e9al pour d\u00e9couvrir l'Europe \u00e0 Bruxelles. \r\nLog\u00e9e dans l\u2019ancienne gare de Bruxelles-Luxembourg, la Station Europe fait le lien entre le pass\u00e9 de cet emplacement, et son r\u00f4le moderne de foyer de la d\u00e9mocratie europ\u00e9enne.\r\n* Gratuit\r\n* Disponible en 24 langues\r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Station Europa","address_street_name":"Luxemburgplein","address_street_number":"100","address_street_box":null,"email":"visit@europarl.europa.eu","website":"https:\/\/visiting.europarl.europa.eu\/nl\/visitor-offer\/brussels\/station-europe","phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"Luxemburgplein, 100","address_line2":"1050 Elsene","description_web":"VOORLOPIG GESLOTEN VOOR BEZOEKERS\r\nStation Europa ligt op het bruisende Luxemburgplein. Het is het ideale vertrekpunt voor je Europese tocht in Brussel. \r\nStation Europa is ondergebracht in het voormalige stationsgebouw van Brussel-Luxemburg. Het legt perfect de link tussen verleden en heden.\r\nHier zie je het Europees Parlement tot leven komen aan de hand van augmented reality. Duik bij de touchscreentafels in de geschiedenis van het Europees Parlement.  Treed in de voetsporen van je favoriete, inspirerende persoonlijkheden. Diorama's werpen zelfs een blik in het verleden en tonen je het Europees Parlement in verschillende periodes. \r\nStation Europa is ook de ideale toegangspoort tot Brussel. Want visit.brussels geeft je er een voorsmaakje van het beste wat Brussel heeft te bieden. \r\nJe bent meer dan welkom!   \r\n* gratis\r\n * in 24 talen \r\n\r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Station Europe","address_street_name":"Place du Luxembourg","address_street_number":"100","address_street_box":null,"email":"visit@europarl.europa.eu","website":"http:\/\/www.europarl.europa.eu\/visiting\/en\/brussels\/station-europe","phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Place du Luxembourg, 100","address_line2":"1050 Ixelles","description_web":"CLOSED TO VISITORS UNTIL FURTHER NOTICE.\r\nStation Europe, on the very lively place du Luxembourg, is the ideal starting point for seeing Europe in Brussels.\r\nHoused in the original Brussels-Luxembourg train station building, Station Europe is the perfect bridge between the area\u2019s past and its modern role as the home of European democracy.\r\n* Free\r\n* Available in 24 languages\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Station Europe","address_street_name":"Place du Luxembourg","address_street_number":"100","address_street_box":null,"email":"visit@europarl.europa.eu","website":"http:\/\/www.europarl.europa.eu\/visiting\/fr\/brussels\/station-europe","phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Place du Luxembourg, 100","address_line2":"1050 Ixelles","description_web":"\u201eStation Europe\u201c ist der ideale Ausgangspunkt f\u00fcr Besucher, die sich einen spannenden und fundierten Einblick \u00fcber das Thema Europa in Br\u00fcssel verschaffen m\u00f6chten. Untergebracht ist \u201eStation Europe\u201c in dem ehemaligen Bahnhof Bruxelles-Luxembourg, direkt an dem belebten Place du Luxembourg. Die Mitarbeiter der Br\u00fcsseler Tourismusagentur visit.brussels stehen Besuchern mit Tipps und Informationen \u00fcber das Europ\u00e4ische Parlament im Speziellen und die Stadt Br\u00fcssel im Allgemeinen zur Verf\u00fcgung.\r\nVerschiedene interaktive Angebote geben dem Besucher eine kleine Einstimmung auf das, was ihn im EU-Viertel erwartet: So wird das EU-Parlament anhand eines \u201eAugmented Reality\u201c-Modells des Campus zum Leben erweckt. Nehmen Sie an den Touchscreen-Tischen Platz, tauchen Sie ein in die Geschichte des EU-Parlaments oder gehen Sie auf Tuchf\u00fchlung mit den historischen Pers\u00f6nlichkeiten, die hier eine zentrale Rolle gespielt haben. Anhand von Dioramen treten Sie eine spannende Reise in die Vergangenheit an und k\u00f6nnen das Europ\u00e4ische Parlament aus unterschiedlichen Blickwinkeln und zu verschiedenen Zeitpunkten seines Bestehens betrachten. \r\nDar\u00fcber hinaus ist \u201eStation Europe\u201c eine erste Anlaufstation f\u00fcr Besucher in Br\u00fcssel, denn visit.brussels pr\u00e4sentiert hier eine Auswahl der besten Sehensw\u00fcrdigkeiten und Attraktionen der belgischen Hauptstadt, insbesondere auch im Hinblick auf andere europ\u00e4ische Institutionen und das EU-Viertel insgesamt.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Station Europe","address_street_name":"Place du Luxembourg","address_street_number":"100","address_street_box":null,"email":"visit@europarl.europa.eu","website":"http:\/\/www.europarl.europa.eu\/visiting\/fr\/brussels\/station-europe","phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Place du Luxembourg, 100","address_line2":"1050 Ixelles","description_web":"Station Europe, sulla vivace Place du Luxembourg, \u00e8 il punto di partenza ideale per vedere l\u2019Europa a Bruxelles.. Il centro di accoglienza del Parlamento Europeo \u00e8 ricco di strumenti interattivi e ha di che stuzzicare la curiosit\u00e0 a tutte le et\u00e0. Personale cordiale \u00e8 a disposizione per mostrarvi tutto quello che c\u2019\u00e8 da fare al Parlamento Europeo e a Bruxelles stessa.. \r\n \r\nSituato nella palazzina originale della stazione Bruxelles-Lussemburgo, Station Europe collega perfettamente il passato di quest\u2019area, come Quartiere Leopold, e il suo ruolo moderno come casa della democrazia europea. \r\n  \r\nGuardate come il Parlamento Europeo diventa realt\u00e0 attraverso un modello del campus in 3D. Si pu\u00f2 anche guardare al passato attraverso riproduzioni in scala visibili da uno spioncino e vedere il Parlamento Europeo da diverse prospettive in momenti diversi della sua esistenza.   \r\nStation Europe \u00e8 anche una porta aperta su Bruxelles con visit.brussels a portata di mano per dare un assaggio di tutto ci\u00f2 che c\u2019\u00e8 da fare nella capitale belga. \r\n  \r\nUn caloroso benvenuto vi aspetta!\r\n  \r\n* Gratuito\r\n* Disponibile in 24 lingue\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Estaci\u00f3n Europa","address_street_name":"Place du Luxembourg","address_street_number":"100","address_street_box":null,"email":"visit@europarl.europa.eu","website":"http:\/\/www.europarl.europa.eu\/visiting\/en\/brussels\/station-europe","phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Place du Luxembourg, 100","address_line2":"1050 Ixelles","description_web":"La estaci\u00f3n Europa (\u201cStation Europe\u201d) est\u00e1 situada en la animada plaza de Luxemburgo y es el punto de partida ideal para ver Europa en Bruselas. Este punto de bienvenida del Parlamento Europeo est\u00e1 lleno de herramientas interactivas y tiene algo para despertar la curiosidad de todas las edades. El amable personal tambi\u00e9n est\u00e1 disponible para mostrarle no solo todo lo que hay que hacer en el Parlamento Europeo sino tambi\u00e9n en la propia Bruselas.\r\n  \r\nUbicada en el edificio original de la estaci\u00f3n de tren de Bruselas-Luxemburgo, la estaci\u00f3n Europa (\u201cStation Europe\u201d) une perfectamente el pasado de la zona cuando solo era el Barrio Leopold, con su papel moderno como hogar de la democracia europea.\r\n\r\nVea c\u00f3mo el Parlamento Europeo cobra vida con una maqueta del campus. Incluso puede mirar al pasado con dioramas de mirilla y ver el Parlamento Europeo desde diferentes \u00e1ngulos, en diferentes momentos de su vida.\r\n  \r\nLa estaci\u00f3n Europa es tambi\u00e9n su puerta de entrada a Bruselas ya que la oficina de turismo de visit.brussels se encuentra tambi\u00e9n all\u00ed para darle una idea de todo lo que hay que hacer en la capital belga. \u00a1Le espera una c\u00e1lida bienvenida!\r\n  \r\n* Gratuito\r\n* Disponible en 24 idiomas\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Station Europe","address_street_name":"Place du Luxembourg","address_street_number":"100","address_street_box":null,"email":"visit@europarl.europa.eu","website":"http:\/\/www.europarl.europa.eu\/visiting\/fr\/brussels\/station-europe","phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Place du Luxembourg, 100","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Station Europe","address_street_name":"Place du Luxembourg","address_street_number":"100","address_street_box":null,"email":"visit@europarl.europa.eu","website":"http:\/\/www.europarl.europa.eu\/visiting\/fr\/brussels\/station-europe","phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Place du Luxembourg, 100","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[9],"translations":{"fr":["Quartier europ\u00e9en"],"nl":["Europese wijk"],"en":["European Quarter"]}},"zones":[],"neca":null,"facebook_id":null,"backoffice_id":26898,"location":{"lat":50.83914868,"lon":4.3736068},"region":"brussels","last_updated_at":"2022-09-26T01:36:04+02:00","published_at":"2016-12-14T09:03:56+01:00","import_origin":null,"external_id":null,"is_in_address_book":false,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":276946,"translations":{"fr":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":"Depuis 1983, Arkadia explore les richesses du patrimoine belge et bruxellois et d\u00e9veloppe de nombreux projets culturels sp\u00e9cialement \u00e0 Bruxelles, entre architecture, urbanisme, culture, arts plastiques et id\u00e9ologie depuis le Moyen \u00c2ge jusqu\u2019\u00e0 nos jours. Voir et comprendre la ville et son d\u00e9veloppement architectural, approcher la cr\u00e9ation artistique et lui donner un sens, telles sont les activit\u00e9s que l'ASBL veut partager avec le public. Sp\u00e9cialistes du patrimoine  architectural et de l'art contemporain, ils font d\u00e9couvrir la ville \u00e0 travers des visites guid\u00e9es et des conf\u00e9rences en plusieurs langues.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Arkadia","address_street_name":"Naamsestraat","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be\/nl","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Naamsestraat, 10","address_line2":"1000 Brussel","description_web":"Sinds 1983 verkent Arkadia de rijkdom van het Belgische en Brusselse erfgoed en ontwikkelt talrijke culturele projecten, vooral in Brussel, tussen architectuur, stedenbouw, cultuur, plastische kunsten en ideologie, van de Middeleeuwen tot vandaag. De stad en haar architecturale ontwikkeling zien en begrijpen, de artistieke creatie benaderen en er een betekenis aan geven, dat zijn de activiteiten die de VZW met het publiek wil delen. Zij zijn gespecialiseerd in architectonisch erfgoed en hedendaagse kunst en laten de stad zien door middel van rondleidingen en lezingen in verschillende talen.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be\/en","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue de Namur, 10","address_line2":"1000 Brussels","description_web":"Since 1983, Arkadia has been exploring the richness of Belgium's and Brussels' heritage and developing numerous cultural projects especially in Brussels, between architecture, urbanism, culture, plastic arts and ideology from the Middle Ages to the present day. Seeing and understanding the city and its architectural development, approaching artistic creation and giving it meaning, these are the activities that the ASBL wants to share with the public. Specialists in architectural heritage and contemporary art, they show the city through guided tours and lectures in several languages.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":null,"facebook_id":null,"backoffice_id":36946,"location":{"lat":50.84145283,"lon":4.35976257},"region":"brussels","last_updated_at":"2022-09-26T01:36:04+02:00","published_at":"2021-07-23T14:48:31+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/explore-12ec702f682312739fdd7f76b40d824d0e2b8b52.jpg","width":906,"height":509,"ratio":1.78,"translations":{"fr":{"title":"Promenade guid\u00e9e au Parlement Europ\u00e9en (gratuite)","copyright":null},"nl":{"title":"Promenade guid\u00e9e au Parlement Europ\u00e9en (gratuite)","copyright":null},"en":{"title":"Promenade guid\u00e9e au Parlement Europ\u00e9en (gratuite)","copyright":null}}}],"dates":[{"day":"2022-09-25","doors":null,"start":"10:00:00","end":"11:30:00","is_soldout":false,"is_canceled":false},{"day":"2022-10-02","doors":null,"start":"10:00:00","end":"11:30:00","is_soldout":false,"is_canceled":false},{"day":"2022-10-09","doors":null,"start":"10:00:00","end":"11:30:00","is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":0}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-09-26T01:36:04+02:00","published_at":"2022-09-16T03:30:06+02:00","backoffice_id":253658,"import_origin":"explore","sub_type":"other","show_in_agenda":true,"ranking":0.40548013303823},{"id":541835,"date_start":"2022-09-18","date_end":"2022-12-11","date_next":"2022-10-02","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert"}},"others":{"list":[2],"translations":{"fr":["Classique"],"nl":["Klassiek"],"en":["Classical"]}}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Nouvelle Saison 2022-2023  Concerts Escapades","shortdescr":"Apr\u00e8s un petit repos estival, nous avons finalis\u00e9 durant l\u2019\u00e9t\u00e9 le programme de la nouvelle saison, jusqu\u2019\u00e0 la fin de l\u2019ann\u00e9e : \r\nEn septembre, nouvelle salle, nouveau d\u00e9cor, nouvelle saison \u201cEscapades\u201d \u00e0 la Tricoterie.  \r\nLa Tricoterie, l\u2019endroit Saint-Gillois o\u00f9 l\u2019on fabrique des liens sera notre nouveau repaire pour vous pr\u00e9senter quatre concerts de septembre \u00e0 d\u00e9cembre :","longdescr":"Concerts Escapades est une r\u00e9gie du CRIT de l\u2019ASBL l\u2019\u00c9quipe qui organise des concerts de musique classique, en collaboration avec \u201cMusic Project For Brussels\u201d et la prison de Forest.\r\nLe 18 septembre \u00e0 20H30, le premier concert, Lubimov+, nom de l\u2019exceptionnel pianiste russe qui a poursuivi son jeu malgr\u00e9 la police lors d\u2019un concert \u00e0 Moscou le 13 avril dernier. Il nous jouera sans a priori des pi\u00e8ces de Silvestrov compositeur ukrainien, Arvo Part l\u2019estonien, Schubert et Haydn les autrichiens. \r\nNous continuerons avec Joy+ le 16 octobre, avec Yu Sheng Jiang, formant un groupe de jazz avec deux autres acolytes ainsi que le quatuor \u00e0 cordes portugais Quiron.\r\nLe 13 novembre, Belgo+, place aux compositeurs belges Lekeu et Ysaye. \r\nEnfin, le 11 d\u00e9cembre, le concert O+, qui console l\u2019\u00e2me, chasse la m\u00e9lancolie par le rem\u00e8de du oud, du th\u00e9orbe et luth avec Sofie Vanden Eynde et Saad Mahmoud Jawad.","performers":"Concert LUBIMOV+ : Alexei Lubimov (piano) 18 sept\r\nConcert JOY+ : Yusheng Jiang (bass), David Yih-Shiou Sung (Piano), Gionata Giardana (drums), Quiron Quatuor (string quartet) 16 oct\/okt\r\nConcert BELGO+ : Kristie Su (violon), Yu-Fen Chang 13 nov\r\nConcert \u00d4+ : Sofie Vanden Eynde (lute,theorbe) Saad Mahmood Jawad (oud), Vladimir Gorlinsky (new work), Aftab Darvishi (new work), Golden Oldies 11 dec","boxoffice_url":null,"website":"https:\/\/www.mpfb.org\/home.php","email":"crit.escapade@gmail.com","phone_contact":"+32 2 537 96 69","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.541835"},"nl":{"name":"Nieuw seizoen 2022-2023 Concerts Escapades","shortdescr":"Na een korte zomerstop hebben wij de laatste hand gelegd aan het programma voor de eerste maanden van het nieuwe seizoen: \r\nIn september, nieuwe zaal, nieuw scene, een nieuw seizoen \u201cEscapades\u201d bij La Tricoterie.  \r\nLa Tricoterie, de plaats in Sint-Gillis waar verbinding gebeurt, wordt onze nieuwe ontmoetingsplaats om van september tot december vier concerten voor te stellen:","longdescr":"Concerts Escapades is een concertmanagement van het CRIT van de VZW l'\u00c9quipe dat klassieke muziekconcerten organiseert in samenwerking met \"Music Project For Brussels\" en de gevangenis van Vorst.\r\nOp 18 december om 20.30 uur is het eerste concert, Lubimov+, genoemd naar de uitzonderlijke Russische pianist die ondanks de politie doorging met spelen tijdens een concert in Moskou op 13 april. Hij zal stukken spelen van de Oekra\u00efense componist Silvestrov, de Estse Arvo Part, de \u2018Oostenrijkers\u2019 Schubert en Haydn.\r\nWe gaan verder met Joy+ op 16 oktober, met Yusheng Jiang, die met twee acolieten een jazztrio vormt , en het Portugese strijkkwartet Quiron.\r\nOp 13 november staan de Belgische componisten Lekeu en Ysaye op het programma van Belgo+. \r\nOp 11 december ten slotte, het O+ concert, dat de ziel troost en de melancholie verdrijft met de remedie van de oud, de theorbe en de luit met Sofie Vanden Eynde en Saad Mahmoud Jawad.","performers":"Concert LUBIMOV+ : Alexei Lubimov (piano) 18 sept\r\nConcert JOY+ : Yusheng Jiang (bass), David Yih-Shiou Sung (Piano), Gionata Giardana (drums), Quiron Quatuor (string quartet) 16 oct\/okt\r\nConcert BELGO+ : Kristie Su (violon), Yu-Fen Chang 13 nov\r\nConcert \u00d4+ : Sofie Vanden Eynde (lute,theorbe) Saad Mahmood Jawad (oud), Vladimir Gorlinsky (new work), Aftab Darvishi (new work), Golden Oldies 11 dec","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.541835"},"en":{"name":"New Season 2022-2023 Concerts Escapades","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.541835"},"de":{"name":"Nouvelle Saison 2022_2023  Concerts Escapades","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.541835"},"it":{"name":"Nouvelle Saison 2022_2023  Concerts Escapades","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.541835"},"sp":{"name":"Nouvelle Saison 2022_2023  Concerts Escapades","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.541835"},"pt":{"name":"Nouvelle Saison 2022_2023  Concerts Escapades","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.541835"},"cn":{"name":"Nouvelle Saison 2022_2023  Concerts Escapades","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.541835"}},"place":{"id":252101,"translations":{"fr":{"name":"La Tricoterie - Fabrique de liens","address_street_name":"Rue Th\u00e9odore Verhaegen","address_street_number":"158","address_street_box":null,"email":"joelle@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+32 2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Th\u00e9odore Verhaegen, 158","address_line2":"1060 Saint-Gilles","description_web":"La Tricoterie se d\u00e9finit comme un lieu pluridisciplinaire avec 4 axes d'activit\u00e9s: l'\u00e9v\u00e9nementiel, le culturel, la formation et les initiatives \u00abcitoyennes \u00bb. Les activit\u00e9s sont de deux types. D'une part, les productions propres, qui constituent la saison, avec la programmation d'artistes associ\u00e9s, un march\u00e9 bio, des soir\u00e9es th\u00e9matiques ou encore des animations de quartier. D'autre part, le lieu est un outil mis \u00e0 disposition d'organisations externes et d'entreprises. Une foule de f\u00eates tr\u00e8s int\u00e9ressantes y ont lieu ! ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"La Tricoterie - Contactenfabriek","address_street_name":"Th\u00e9odore Verhaegenstraat","address_street_number":"158","address_street_box":null,"email":"joelle@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+32 2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Sint-Gillis","address_line1":"Th\u00e9odore Verhaegenstraat, 158","address_line2":"1060 Sint-Gillis","description_web":"La Tricoterie is een project met een welomlijnde filosofie, die blijkt uit de zelfgekozen naam (van tricoter, breien) waarmee verwijst wordt naar het smeden van banden om de strijd tegen de ontrafeling van het sociale weefsel aan te gaan. Opgezet als een \u00abContacten Fabriek\u00bb en een ontmoetingsplaats waar verschillende disciplines en publieken elkaar ontmoeten. Naast een culturele programmering (concerten, voorstellingen, expos\u2026) en socioculturele activiteiten die sociale cohesie beogen (debatten, conferenties, intergenerationele ateliers, caf\u00e9-filo\u2026) staan de ruimtes ook open voor verhuur aan externe organisaties en bedrijven. Tal van superleuke feestjes vinden er plaats, alsook een wekelijkse biomarkt, een repaircaf\u00e9 en een alternatieve geschenkenmarkt om maar enkele van de activiteiten te noemen die de duurzame levensvisie van de plek weerspiegelen.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"La Tricoterie - Link factory","address_street_name":"Rue Th\u00e9odore Verhaegen","address_street_number":"158","address_street_box":null,"email":"joelle@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+32 2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Th\u00e9odore Verhaegen, 158","address_line2":"1060 Saint-Gilles","description_web":"La Tricoterie is above all a civil, cultural, sustainable and innovative project. Their cultural programme featuring performances, shows, exhibitions and so on goes hand in hand with a \u201ccivil\u201d programme of debates, conferences, inter-generational workshops, philosophical caf\u00e9 etc ... The place can be rented for events and there are plenty of really great parties! ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"La Tricoterie","address_street_name":"Rue Th\u00e9odore Verhaegen","address_street_number":"158","address_street_box":null,"email":"joelle@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+32 2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Th\u00e9odore Verhaegen, 158","address_line2":"1060 Saint-Gilles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"La Tricoterie","address_street_name":"Rue Th\u00e9odore Verhaegen","address_street_number":"158","address_street_box":null,"email":"joelle@tricoterie.be","webs