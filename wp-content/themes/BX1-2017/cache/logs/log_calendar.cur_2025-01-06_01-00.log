ll],"en":["Highlight"],"it":["Highlight"],"cn":[null],"fr":["Highlight"],"sp":["Highlight"],"nl":["Highlight"]}},"recurring":[],"targets":{"list":[11,10,19,12,16],"translations":{"de":["Familie","Senioren","Lehrkr\u00e4fte","LGTBQIA","Schulen"],"pt":[null,null,null,null,null],"en":["Family","Seniors","Teachers","LGTBQIA","Schools"],"it":["Famiglie","Anziani","Insegnanti","LGTBQIA","Scuole"],"cn":[null,null,null,null,null],"fr":["Famille","Seniors","Enseignants","LGTBQIA","Ecoles"],"sp":["Familias","Personas de la tercera edad","Profesores","LGTBQIA","Escuelas"],"nl":["Familie","Senioren","Leerkrachten","LGTBQIA","Scholen"]}},"educational_targets":{"list":[],"translations":{}},"tags":["major_event","kids"]},{"id":5700003842,"date_start":"2025-01-23","date_end":"2025-04-06","date_next":"2025-01-23","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-11-29T10:07:04+01:00","published_at":"2024-11-22T13:28:53+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":312271,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"other","ranking":0.30010006671856176,"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[41,36],"translations":{"de":["Installation, Performance","Museen & Kunstzentren"],"pt":[null,null],"en":["Installation, performance","Museums and art centers"],"it":["Installazioni, performance","Musei e centri artistici"],"cn":[null,null],"fr":["Installation, performance","Mus\u00e9es et art centers"],"sp":["Instalaci\u00f3n, performance","Museos y centros de arte"],"nl":["Installatie, performance","Musea en kunstcentra"]}}},"translations":{"de":{"name":"Hollow and Broken: A State of the World by G\u00fcls\u00fcn Karamustafa","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.la-loge.be","email":"info@la-loge.be","phone_contact":"+32 2 644 42 48","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700003842"},"pt":{"name":"Hollow and Broken: A State of the World by G\u00fcls\u00fcn Karamustafa","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.la-loge.be","email":"info@la-loge.be","phone_contact":"+32 2 644 42 48","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700003842"},"en":{"name":"G\u00fcls\u00fcn Karamustafa - 'Hollow and Broken: A State of the World'","shortdescr":"La Loge presents 'Hollow and Broken: A State of the World' by one of Turkey's most influential artists, G\u00fcls\u00fcn Karamustafa. This solo exhibition in Brussels follows her installation for the T\u00fcrkiye Pavillion at the 60th International Art Exhibition - La Biennale di Venezia in 2024.","longdescr":"The exhibition is organized in partnership with Moussem Nomadic Arts Centre as part of the festival Moussem Cities: Istanbul, and in collaboration with B\u00fcroSar\u0131gedik \n\nG\u00fcls\u00fcn Karamustafa is a Turkish visual artist and filmmaker born in 1946 in Ankara, who lives and works in Istanbul and Berlin. Through her art practice, spanning the course of over fifty years, she focuses on such topics as the modernisation of Turkey, uprooting and memory, migration, locality, identity, cultural difference and gender from an array of perspectives. Within her works, which stem from both personal and historic narratives, she champions the use of disparate materials and methods. Through media as diverse as painting, installation, photography, video and performance, she calls into question historical injustices in the social and political fields.\n\nKaramustafa has participated in numerous international biennials, including Istanbul, TR; S\u00e3o Paulo, BR; Gwangju, KR; Kyiv, UA; Singapore, SG; Havana, CU; Thessaloniki, GR; Sevilla, ES. She has presented solo exhibitions at major institutions and galleries worldwide, including Salt Beyo\u011flu and Salt Galata, Istanbul, TR; Hamburger Bahnhof \u2013 Museum f\u00fcr Gegenwart, Berlin, DE; Van Abbemuseum, Eindhoven, NL; IVAM Institut Valenci\u00e0 d\u2019Art Modern, Valencia, ES; EMST National Museum of Contemporary Art Athens, GR; Kunstmuseum Bonn, Bonn, DE; Lunds Konsthall, Lunds, SE; Salzburger Kunstverein, Salzburg, AT; Kunsthalle Fridericianum, Kassel, DE; Museum Villa Stuck, Munich, DE, among others.\n\nHer works have been included in the permanent collections of Centre Pompidou, Paris, FR; Tate Modern, London, GB; Solomon R. Guggenheim Museum, New York, US; Museum of Contemporary Art Chicago, Chicago, US; Mus\u00e9e d\u2019Art Moderne, Paris, FR; Van Abbemuseum, Eindhoven, NL; Hamburger Bahnhof \u2013 Museum f\u00fcr Gegenwart, Berlin, DE; Ludwig Museum, Cologne, DE; MUMOK, Vienna, AT; Wien Museum, Vienna, AT; Warsaw Museum of Modern Art, Warsaw, PL; EMST National Museum of Contemporary Art Athens, Athens, GR; Istanbul Modern Art Museum and Arter, Istanbul, TR.\n\nShe received the Roswitha Haftmann Prize in 2021 and Prince Claus Award in 2014.\n\n","performers":"G\u00fcls\u00fcn Karamustafa","boxoffice_url":null,"website":"http:\/\/www.la-loge.be","email":"info@la-loge.be","phone_contact":"+32 2 644 42 48","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700003842"},"it":{"name":"Hollow and Broken: A State of the World by G\u00fcls\u00fcn Karamustafa","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.la-loge.be","email":"info@la-loge.be","phone_contact":"+32 2 644 42 48","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700003842"},"cn":{"name":"Hollow and Broken: A State of the World by G\u00fcls\u00fcn Karamustafa","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.la-loge.be","email":"info@la-loge.be","phone_contact":"+32 2 644 42 48","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700003842"},"fr":{"name":"G\u00fcls\u00fcn Karamustafa - 'Hollow and Broken: A State of the World'","shortdescr":"La Loge pr\u00e9sente 'Hollow and Broken: A State of the World' par l'une des artistes les plus influentes de Turquie, G\u00fcls\u00fcn Karamustafa. Son exposition \u00e0 La Loge, du 23 janvier au 6 avril 2025, fait suite \u00e0 celle du Pavillon turc \u00e0 la 60eme Exposition International - La Biennale di Venezia 2024.","longdescr":"L'exposition est organis\u00e9e en partenariat avec Moussem Nomadic Art Center dans le cadre du festival Moussem Cities: Istanbul, et en collaboration avec B\u00fcroSar\u0131gedik.\n\nG\u00fcls\u00fcn Karamustafa est une artiste visuelle et cin\u00e9aste turque, n\u00e9e en 1946, qui vit et travaille \u00e0 Istanbul et \u00e0 Berlin. \u00c0 travers sa pratique artistique, qui s'\u00e9tend sur plus de cinquante ans, Karamustafa aborde de diff\u00e9rentes mani\u00e8res des th\u00e8mes tels que la modernisation de la Turquie, le d\u00e9racinement et la m\u00e9moire, la migration, la localit\u00e9, l'identit\u00e9, la diff\u00e9rence culturelle et le genre. Dans ses \u0153uvres, qui s'inspirent \u00e0 la fois de r\u00e9cits personnels et historiques, elle s'appuie sur l'utilisation de mat\u00e9riaux et de m\u00e9thodes vari\u00e9s. \u00c0 travers des m\u00e9diums aussi divers que la peinture, l'installation, la photographie, la vid\u00e9o et la performance, elle interroge les injustices historiques dans les domaines social et politique.","performers":"G\u00fcls\u00fcn Karamustafa","boxoffice_url":null,"website":"http:\/\/www.la-loge.be","email":"info@la-loge.be","phone_contact":"+32 2 644 42 48","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700003842"},"sp":{"name":"Hollow and Broken: A State of the World by G\u00fcls\u00fcn Karamustafa","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.la-loge.be","email":"info@la-loge.be","phone_contact":"+32 2 644 42 48","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700003842"},"nl":{"name":"G\u00fcls\u00fcn Karamustafa - 'Hollow and Broken: A State of the World'","shortdescr":"La Loge presenteert 'Hollow and Broken: A State of the World' van een van de meest invloedrijke kunstenaars van Turkije, G\u00fcls\u00fcn Karamustafa. Haar tentoonstelling bij La Loge van 23 januari tot 6 april volgt die van het Turkse paviljoen op de 60e Internationale Kunst Tentoonstelling \u2013 La Biennale di Venezia in 2024.","longdescr":"De tentoonstelling is georganiseerd in partnerschap met het Moussem Nomadic Art Center als onderdeel van het festival Moussem Cities: Istanbul, en in samenwerking met B\u00fcroSar\u0131gedik.\n\nG\u00fcls\u00fcn Karamustafa is een Turkse beeldende kunstenares en filmmaker, geboren in 1946, die woont en werkt in Istanbul en Berlijn. In haar artistieke praktijk, die zich over meer dan vijftig jaar uitstrekt, behandelt Karamustafa vanuit verschillende perspectieven onderwerpen zoals de modernisering van Turkije, ontworteling en herinnering, migratie, lokaliteit, identiteit, culturele diversiteit en gender. Haar werken, die voortkomen uit zowel persoonlijke als historische verhalen, kenmerken zich door het gebruik van uiteenlopende materialen en methoden. Aan de hand van diverse media, zoals schilderkunst, installaties, fotografie, video en performance, bevraagt zij historische onrechtvaardigheden op sociaal en politiek vlak.\n","performers":"G\u00fcls\u00fcn Karamustafa","boxoffice_url":null,"website":"http:\/\/www.la-loge.be","email":"info@la-loge.be","phone_contact":"+32 2 644 42 48","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700003842"}},"place":{"id":238201,"translations":{"de":{"name":"La Loge","address_street_name":"Rue de l'Ermitage","address_street_number":"86","address_street_box":null,"email":"info@la-loge.be","website":"http:\/\/www.la-loge.be","phone_contact":"+32 2 644 42 48","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage, 86","address_line2":"1050 Ixelles","description_web":"La Loge ist ein Ort, der sich der zeitgen\u00f6ssischen Kunst, der Architektur und der Theori widmet und von dem Architekten Philippe Rotthier gegr\u00fcndet wurde. Ziel ist die Ausarbeitung einer hochwertigen Programmgestaltung mit konkreten und kritischen Projekten, die angesichts des gegenw\u00e4rtigen kulturellen Kontexts von Belang sind. Architekten, K\u00fcnstler, Ausstellungskommissare und kulturelle Akteure sind eingeladen, ihre Vorschl\u00e4ge und die spezifischen Aspekte aus ihrer Arbeit einzubringen.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"La Loge","address_street_name":"Rue de l'Ermitage","address_street_number":"86","address_street_box":null,"email":"info@la-loge.be","website":"http:\/\/www.la-loge.be","phone_contact":"+32 2 644 42 48","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage, 86","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"La Loge","address_street_name":"Rue de l'Ermitage","address_street_number":"86","address_street_box":null,"email":"info@la-loge.be","website":"http:\/\/www.la-loge.be","phone_contact":"+32 2 644 42 48","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage, 86","address_line2":"1050 Ixelles","description_web":"La Loge is a Brussels-based space dedicated to contemporary art, architecture and theory founded by architect Philippe Rotthier. Its aim is to develop a high-quality program that plays a critical role in today\u2019s cultural conversations through specific and precise projects. Architects, artists, curators and cultural agents are invited to develop propositions in which they seek out the characteristic and the peculiar within their practices.\r\nLa Loge is a space where ideas, discussion and presentation coexist. Public formats vary depending on the project; from exhibitions, symposiums, screenings, lectures, and performances to events\u2019 series. Its identity is drawn from the architectural gem that houses it, as well as from the commitment and concerns of its founders. La Loge values engagement of thought and feels particularly interested in exploring questions of space, habitat and use. The small-scale format of La Loge contributes to a context where intimate and direct conversations with its audience and the diversity of protagonists it invites can be initiated and sustained.\r\n\r\n","description_print":null,"booking_url":null,"sort_order":"LOGE","virtual_visit":null,"visit_url":null},"it":{"name":"La Loge","address_street_name":"Rue de l'Ermitage","address_street_number":"86","address_street_box":null,"email":"info@la-loge.be","website":"http:\/\/www.la-loge.be","phone_contact":"+32 2 644 42 48","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage, 86","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"La Loge","address_street_name":"Rue de l'Ermitage","address_street_number":"86","address_street_box":null,"email":"info@la-loge.be","website":"http:\/\/www.la-loge.be","phone_contact":"+32 2 644 42 48","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage, 86","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"La Loge","address_street_name":"Rue de l'Ermitage","address_street_number":"86","address_street_box":null,"email":"info@la-loge.be","website":"http:\/\/www.la-loge.be","phone_contact":"+32 2 644 42 48","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage, 86","address_line2":"1050 Ixelles","description_web":"La Loge est un espace d\u00e9di\u00e9 \u00e0 l\u2019art contemporain, l\u2019architecture et la th\u00e9orie, initi\u00e9e par l\u2019architecte Philippe Rotthier. Son objectif est de d\u00e9velopper une programmation de qualit\u00e9 \u00e0 travers des projets pr\u00e9cis et critiques, qui font sens au sein des enjeux culturels actuels. Architectes, artistes, commissaires d\u2019expositions et acteurs culturels sont invit\u00e9s \u00e0 y articuler des propositions qui explorent les aspects sp\u00e9cifiques de leur pratique.\r\nLa Loge est un lieu o\u00f9 coexistent les id\u00e9es, la discussion et la pr\u00e9sentation.\r\nChaque projet est d\u00e9velopp\u00e9 selon une formule de pr\u00e9sentation qui lui est propre, allant de l\u2019exposition au s\u00e9minaire, de la projection \u00e0 la conf\u00e9rence, de la performance \u00e0 la s\u00e9rie d\u2019\u00e9v\u00e9nements.\r\nLa Loge puise son identit\u00e9 dans le joyau architectural qui l\u2019abrite ainsi que dans l\u2019engagement et les pr\u00e9occupations de ses fondateurs. La Loge valorise une pens\u00e9e engag\u00e9e et s\u2019int\u00e9resse en particulier \u00e0 des -questions d\u2019espace, d\u2019habitat et d\u2019usage. La structure d\u2019envergure relativement r\u00e9duite de La Loge g\u00e9n\u00e8re un contexte qui permet d\u2019engager et de poursuivre un dialogue direct et intime, tant avec son public qu\u2019avec la diversit\u00e9 d\u2019intervenants qui y sont invit\u00e9s.\r\n ","description_print":null,"booking_url":null,"sort_order":"La Loge","virtual_visit":null,"visit_url":null},"sp":{"name":"La Loge","address_street_name":"Rue de l'Ermitage","address_street_number":"86","address_street_box":null,"email":"info@la-loge.be","website":"http:\/\/www.la-loge.be","phone_contact":"+32 2 644 42 48","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage, 86","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"La Loge","address_street_name":"Kluisstraat","address_street_number":"86","address_street_box":null,"email":"info@la-loge.be","website":"http:\/\/www.la-loge.be","phone_contact":"+32 2 644 42 48","phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"Kluisstraat, 86","address_line2":"1050 Elsene","description_web":"La Loge is een Brusselse ruimte opgericht door architect Philippe Rotthier en gewijd aan hedendaagse kunst, architectuur en theorie. Het doel is een hoogwaardig programma te ontwikkelen dat een cruciale rol speelt in het hedendaagse culturele debat door middel van concrete en punctuele projecten. Architecten, kunstenaars, curatoren en andere culturele spelers  worden uitgenodigd om voorstellen in te dienen waarin ze op zoek gaan naar het karakteristieke en bijzondere in hun praktijk.\r\nLa Loge is een ruimte waar idee\u00ebn, dialoog en presentatie samengaan. Publieksformaten vari\u00ebren afhankelijk van het project. Dat kan gaan van tentoonstellingen, symposia, filmprojecties, lezingen tot performances of een evenementenreeks. De identiteit van La Loge is geankerd in het architectonisch juweeltje waarin het is  gevestigd maar ook in de toewijding en interesses van de oprichters. La Loge waardeert intellectueel engagement en is in het bijzonder ge\u00efnteresseerd in de verkenning van vragen rond ruimte, habitat en gebruik.\r\nDe kleinschalige vorm van La Loge draagt bij tot een context waarin er plaats is voor intieme, directe gesprekken tussen het publiek en erg diverse gesprekspartners.\r\n \r\n","description_print":null,"booking_url":null,"sort_order":"LOGE","virtual_visit":null,"visit_url":null}},"districts":{"list":[5],"translations":{"de":["Flagey"],"pt":[null],"en":["Flagey"],"it":["Flagey"],"cn":[null],"fr":["Flagey"],"sp":["Flagey"],"nl":["Flagey"]}},"zones":{"list":[21],"translations":{"de":["S\u00fcden"],"pt":[null],"en":["South"],"it":["Sud"],"cn":[null],"fr":["Sud"],"sp":["Sur"],"nl":["Zuid"]}},"neca":"art_center","facebook_id":null,"backoffice_id":1942,"location":{"lat":50.82845961,"lon":4.36564707},"region":"brussels","last_updated_at":"2024-11-22T09:38:46+01:00","published_at":"2013-10-19T01:14:46+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":238201,"translations":{"de":{"name":"La Loge","address_street_name":"Rue de l'Ermitage","address_street_number":"86","address_street_box":null,"email":"info@la-loge.be","website":"http:\/\/www.la-loge.be","phone_contact":"+32 2 644 42 48","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage, 86","address_line2":"1050 Ixelles","description_web":"La Loge ist ein Ort, der sich der zeitgen\u00f6ssischen Kunst, der Architektur und der Theori widmet und von dem Architekten Philippe Rotthier gegr\u00fcndet wurde. Ziel ist die Ausarbeitung einer hochwertigen Programmgestaltung mit konkreten und kritischen Projekten, die angesichts des gegenw\u00e4rtigen kulturellen Kontexts von Belang sind. Architekten, K\u00fcnstler, Ausstellungskommissare und kulturelle Akteure sind eingeladen, ihre Vorschl\u00e4ge und die spezifischen Aspekte aus ihrer Arbeit einzubringen.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"La Loge","address_street_name":"Rue de l'Ermitage","address_street_number":"86","address_street_box":null,"email":"info@la-loge.be","website":"http:\/\/www.la-loge.be","phone_contact":"+32 2 644 42 48","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage, 86","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"La Loge","address_street_name":"Rue de l'Ermitage","address_street_number":"86","address_street_box":null,"email":"info@la-loge.be","website":"http:\/\/www.la-loge.be","phone_contact":"+32 2 644 42 48","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage, 86","address_line2":"1050 Ixelles","description_web":"La Loge is a Brussels-based space dedicated to contemporary art, architecture and theory founded by architect Philippe Rotthier. Its aim is to develop a high-quality program that plays a critical role in today\u2019s cultural conversations through specific and precise projects. Architects, artists, curators and cultural agents are invited to develop propositions in which they seek out the characteristic and the peculiar within their practices.\r\nLa Loge is a space where ideas, discussion and presentation coexist. Public formats vary depending on the project; from exhibitions, symposiums, screenings, lectures, and performances to events\u2019 series. Its identity is drawn from the architectural gem that houses it, as well as from the commitment and concerns of its founders. La Loge values engagement of thought and feels particularly interested in exploring questions of space, habitat and use. The small-scale format of La Loge contributes to a co