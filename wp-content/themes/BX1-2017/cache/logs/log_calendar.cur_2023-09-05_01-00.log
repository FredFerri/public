oking":"+32 2 502 73 55","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.561632"},"pt":{"name":"Bruxelles sous les projecteurs","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.provelo.org\/services\/tourisme-et-loisirs\/","email":"info@provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":"+32 2 502 73 55","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.561632"},"en":{"name":"Bruxelles sous les projecteurs","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.provelo.org\/services\/tourisme-et-loisirs\/","email":"info@provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":"+32 2 502 73 55","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.561632"},"it":{"name":"Bruxelles sous les projecteurs","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.provelo.org\/services\/tourisme-et-loisirs\/","email":"info@provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":"+32 2 502 73 55","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.561632"},"cn":{"name":"Bruxelles sous les projecteurs","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.provelo.org\/services\/tourisme-et-loisirs\/","email":"info@provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":"+32 2 502 73 55","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.561632"},"fr":{"name":"Bruxelles sous les projecteurs","shortdescr":"Bruxelles fait son cin\u00e9ma ! P\u00e9dalez \u00e0 travers la ville \u00e0 la recherche des diff\u00e9rents d\u00e9cors qui ont servi au tournage de films belges ou international.","longdescr":"Bruxelles fait son cin\u00e9ma ! P\u00e9dalez \u00e0 travers la ville \u00e0 la recherche des diff\u00e9rents d\u00e9cors qui ont servi au tournage de films belges ou international. Que la capitale soit le lieu de l\u2019histoire ou offre une ambiance permettant d\u2019illustrer un autre lieu ou une \u00e9poque particuli\u00e8re, elle est le th\u00e9\u00e2tre de nombreuses sc\u00e8nes de films. De \u00ab Dikkenek \u00bb \u00e0 \u00ab the Danish Girl \u00bb, des \u00ab Barons \u00bb \u00e0 \u00ab Cloclo \u00bb, retrouvez les d\u00e9cors de nombreuses \u0153uvres cin\u00e9matographiques \u00e0 travers la ville.\r\n\r\nCette balade est r\u00e9alis\u00e9e en partenariat avec Surimpressions, la revue belge mensuelle de cin\u00e9ma. Chaque participant \u00e0 la balade recevra un magazine ainsi qu\u2019un code promotionnel pour s\u2019y abonner.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.provelo.org\/services\/tourisme-et-loisirs\/","email":"info@provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":"+32 2 502 73 55","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.561632"},"sp":{"name":"Bruxelles sous les projecteurs","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.provelo.org\/services\/tourisme-et-loisirs\/","email":"info@provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":"+32 2 502 73 55","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.561632"},"nl":{"name":"Bruxelles sous les projecteurs","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.provelo.org\/services\/tourisme-et-loisirs\/","email":"info@provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":"+32 2 502 73 55","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.561632"}},"place":{"id":280319,"translations":{"de":{"name":"Pro Velo","address_street_name":"Rue de Dublin","address_street_number":"19","address_street_box":null,"email":"info@provelo.org","website":"http:\/\/www.provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de Dublin, 19","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Pro Velo","address_street_name":"Rue de Dublin","address_street_number":"19","address_street_box":null,"email":"info@provelo.org","website":"http:\/\/www.provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de Dublin, 19","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Pro Velo","address_street_name":"Rue de Dublin","address_street_number":"19","address_street_box":null,"email":"info@provelo.org","website":"http:\/\/www.provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de Dublin, 19","address_line2":"1050 Ixelles","description_web":"Cycling for all\r\nIn order to develop and facilitate the use of the bicycle in Belgium, Pro Velo has been supporting individuals, governments, schools and companies since 1992. Our services are aimed at making cycling accessible to everyone through personal support. This way, Pro Velo contributes to a better quality of life!","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Pro Velo","address_street_name":"Rue de Dublin","address_street_number":"19","address_street_box":null,"email":"info@provelo.org","website":"http:\/\/www.provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de Dublin, 19","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Pro Velo","address_street_name":"Rue de Dublin","address_street_number":"19","address_street_box":null,"email":"info@provelo.org","website":"http:\/\/www.provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de Dublin, 19","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"fr":{"name":"Pro Velo","address_street_name":"Rue de Dublin","address_street_number":"19","address_street_box":null,"email":"info@provelo.org","website":"http:\/\/www.provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de Dublin, 19","address_line2":"1050 Ixelles","description_web":"Le v\u00e9lo accessible \u00e0 toutes et tous\r\nPour d\u00e9velopper et faciliter la pratique du v\u00e9lo en Belgique, Pro Velo  soutient les particuliers, les pouvoirs publics, les \u00e9coles et les entreprises depuis 1992.  Notre offre de services vise \u00e0 rendre le v\u00e9lo accessible \u00e0 tous et toutes au travers d\u2019un accompagnement personnalis\u00e9. Pro Velo contribue ainsi \u00e0 une meilleure qualit\u00e9 de vie !","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Pro Velo","address_street_name":"Rue de Dublin","address_street_number":"19","address_street_box":null,"email":"info@provelo.org","website":"http:\/\/www.provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de Dublin, 19","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Pro Velo","address_street_name":"Dublinstraat","address_street_number":"19","address_street_box":null,"email":"info@provelo.org","website":"http:\/\/www.provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Dublinstraat, 19","address_line2":"1050 Ixelles","description_web":"Fietsen voor iedereen\r\nOm het gebruik van de fiets in Belgi\u00eb te ontwikkelen en te vergemakkelijken steunt Pro Velo sinds 1992 particulieren, overheden, scholen en bedrijven. Onze diensten zijn erop gericht de fiets voor iedereen toegankelijk te maken door middel van persoonlijke ondersteuning. Pro Velo draagt bij tot een betere levenskwaliteit!","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[4],"translations":{"de":["Matonge\/Saint-Boniface"],"pt":[null],"en":["Matonge\/Saint-Boniface"],"it":["Matonge\/Saint-Boniface"],"cn":[null],"fr":["Matonge\/Saint-Boniface"],"sp":["Matong\u00e9\/Saint-Boniface"],"nl":["Matonge\/Sint-Bonifatius"]}},"zones":{"list":[21],"translations":{"de":["S\u00fcden"],"pt":[null],"en":["South"],"it":["Sud"],"cn":[null],"fr":["Sud"],"sp":["Sur"],"nl":["Zuid"]}},"neca":null,"facebook_id":null,"backoffice_id":40319,"location":{"lat":50.83710821,"lon":4.36720312},"region":"brussels","last_updated_at":"2023-05-26T03:51:14+02:00","published_at":"2023-04-18T08:26:19+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":false,"resto_ranking":0},"organizer":{"id":228485,"translations":{"de":{"name":"Pro Velo","address_street_name":"Rue de Londres ","address_street_number":"15","address_street_box":null,"email":"info@provelo.org","website":"http:\/\/www.provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de Londres , 15","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Pro Velo","address_street_name":"Rue de Londres ","address_street_number":"15","address_street_box":null,"email":"info@provelo.org","website":"http:\/\/www.provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de Londres , 15","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Pro Velo","address_street_name":"Rue de Londres ","address_street_number":"15","address_street_box":null,"email":"info@provelo.org","website":"http:\/\/www.provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de Londres , 15","address_line2":"1050 Ixelles","description_web":"The Pro Velo non-profit association aims to improve mobility for cyclists in Brussels. It organises guided bicycle tours in Dutch, French, and English. A pleasant and active way of exploring the city with neither windscreen nor roof in your way, giving you a completely unimpeded view.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Pro Velo","address_street_name":"Rue de Londres ","address_street_number":"15","address_street_box":null,"email":"info@provelo.org","website":"http:\/\/www.provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de Londres , 15","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Pro Velo","address_street_name":"Rue de Londres ","address_street_number":"15","address_street_box":null,"email":"info@provelo.org","website":"http:\/\/www.provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de Londres , 15","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"fr":{"name":"Pro Velo","address_street_name":"Rue de Londres ","address_street_number":"15","address_street_box":null,"email":"info@provelo.org","website":"http:\/\/www.provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de Londres , 15","address_line2":"1050 Ixelles","description_web":"Pro V\u00e9lo est une association au guidon fermement dirig\u00e9 en faveur des cyclistes bruxellois. Elle propose des promenades guid\u00e9es sur deux roues en fran\u00e7ais, n\u00e9erlandais et anglais. Une id\u00e9e sympathique qui permet d\u2019appr\u00e9cier la petite reine ET les richesses multiples de l\u2019environnement bruxellois. Il n\u2019y a plus qu\u2019\u00e0 baisser la t\u00eate pour avoir l\u2019air d\u2019un coureur! Mais non, ce serait dommage, levez les yeux et appr\u00e9ciez le paysage...\r\nLangues: allemand - anglais - espagnol - fran\u00e7ais - n\u00e9erlandais - portugais","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Pro Velo","address_street_name":"Rue de Londres ","address_street_number":"15","address_street_box":null,"email":"info@provelo.org","website":"http:\/\/www.provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de Londres , 15","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Pro Velo","address_street_name":"Londenstraat","address_street_number":"15","address_street_box":null,"email":"info@provelo.org","website":"http:\/\/www.provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Londenstraat, 15","address_line2":"1050 Ixelles","description_web":"De vzw Pro V\u00e9lo streeft naar meer mobiliteit voor de Brusselse fietsers en organiseert gegidste fietstochten in het Nederlands, Frans en Engels. Kortom, een fijn idee voor wie graag met de haren in de wind de stad afsch