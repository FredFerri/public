online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-10-02T17:52:02+02:00","published_at":"2024-10-02T17:50:09+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":308856,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"concert","ranking":1,"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"categories":{"main":{"id":1,"translations":{"de":"Konzert","pt":null,"en":"Concert","it":"Concerti","cn":null,"fr":"Concert","sp":"Concierto","nl":"Concert"}},"others":{"list":[6,4],"translations":{"de":["Worldmusic, Folk & Country","Pop, Rock, Jazz..."],"pt":[null,null],"en":["Worldmusic, Folk & Country","Pop, rock, jazz\u2026"],"it":["Worldmusic, Folk e Country","Pop, rock, jazz\u2026"],"cn":[null,null],"fr":["Worldmusic, Folk & Country","Pop, rock, jazz\u2026"],"sp":["Worldmusic, folk y country","Pop, rock, jazz\u2026"],"nl":["Worldmusic, Folk & Country","Pop, rock, jazz\u2026"]}}},"translations":{"de":{"name":"D\u00eda de Muertos: Poetic and musical stroll at the cemetery","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/muziekpublique.be\/concerts\/20241031_diademuertos\/","email":"info@muziekpublique.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700002027"},"pt":{"name":"D\u00eda de Muertos: Poetic and musical stroll at the cemetery","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/muziekpublique.be\/concerts\/20241031_diademuertos\/","email":"info@muziekpublique.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700002027"},"en":{"name":"D\u00eda de Muertos: Poetic and musical stroll at the cemetery","shortdescr":"D\u00eda de Muertos has been celebrated in Brussels since 2018. For a whole week, the Marolles district is filled with colors as we come together to commemorate those who have passed. This annual event is based on a universal yet increasingly forgotten gesture in modern societies: honoring our deceased. ","longdescr":"Through song, crafts, words, gestures, and a beautiful altar, D\u00eda de Muertos offers a time and space to remember our loved ones, share memories, reinvent rituals, and take care of our dead.\n\nWhether you\u2019re coming solo, with loved ones, or even new faces, this event provides a modern-day approach to processing loss and finding peace. Open to everyone, D\u00eda de Muertos is a vibrant, cultural experience that invites reflection without the boundaries of religion.\n\nThis year, as festival partners, we\u2019re inviting you to join us at dusk for a special musical walk through Saint-Gilles Cemetery. Imagine the moonlight casting shadows, candles flickering along the paths, and melodies rising softly into the night. Eight musicians from across the globe will be performing funeral songs in their native language. A moving tribute to death that reflects a rich variety of traditions. Expect to hear Tibetan, Spanish, Portuguese, and other songs, each accompanied by traditional acoustic instruments.\n\nAnd don\u2019t worry, this isn\u2019t Halloween. We\u2019re here to remember and honor, not to frighten!","performers":null,"boxoffice_url":null,"website":"https:\/\/muziekpublique.be\/concerts\/20241031_diademuertos\/","email":"info@muziekpublique.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700002027"},"it":{"name":"D\u00eda de Muertos: Poetic and musical stroll at the cemetery","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/muziekpublique.be\/concerts\/20241031_diademuertos\/","email":"info@muziekpublique.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700002027"},"cn":{"name":"D\u00eda de Muertos: Poetic and musical stroll at the cemetery","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/muziekpublique.be\/concerts\/20241031_diademuertos\/","email":"info@muziekpublique.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700002027"},"fr":{"name":"D\u00eda de Muertos: Balade po\u00e9tico-musicale au cimeti\u00e8re","shortdescr":"D\u00eda de Muertos existe \u00e0 Bruxelles depuis 2018. Pendant une semaine, le quartier des Marolles se pare de couleurs et comm\u00e9more les disparu\u00b7es. Cet \u00e9v\u00e9nement annuel se fonde sur un geste universel pourtant de plus en plus oubli\u00e9 de nos soci\u00e9t\u00e9s contemporaines : celui d\u2019honorer nos d\u00e9funt\u00b7es.","longdescr":"Par le chant, le bricolage, les mots, les gestes, un autel magnifique et \u00e9mouvant, D\u00eda de Muertos offre un espace et un temps pour se rem\u00e9morer les \u00eatres aim\u00e9s, se raconter des souvenirs, r\u00e9inventer des rituels, prendre soin de ses morts\u2026 En solo, en famille, entre amis ou entre inconnus, le public trouve dans D\u00eda de Muertos un cadre contemporain pour penser\/panser ses morts. L\u2019\u00e9v\u00e9nement qui se veut sans confession est ouvert \u00e0 tous et toutes dans un \u00e9change culturel r\u00e9jouissant et impertinent.\n\nEn tant que partenaires du festival, cette ann\u00e9e, \u00e0 la tomb\u00e9e du jour, nous vous convions \u00e0 une promenade musicale dans le cimeti\u00e8re de Saint-Gilles. Un clair de lune, la lueur des bougies qui scintillent le long des all\u00e9es et des notes de musique qui s\u2019\u00e9l\u00e8vent dans la nuit. Tout au long de cette d\u00e9ambulation, huit musicien\u00b7ne\u00b7s venus des quatre coins du monde interpr\u00e9teront des chants fun\u00e9raires dans leurs langues d\u2019origine. Un hommage musical \u00e0 la mort, riche de diverses traditions. Vous pourrez \u00e9couter des chants en tib\u00e9tain, espagnol, portugais et bien d\u2019autres, accompagn\u00e9s d\u2019instruments acoustiques traditionnels.\n\nN\u2019oubliez pas, ce n\u2019est pas Halloween, nous ne sommes pas l\u00e0 pour vous effrayer.","performers":null,"boxoffice_url":null,"website":"https:\/\/muziekpublique.be\/concerts\/20241031_diademuertos\/","email":"info@muziekpublique.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700002027"},"sp":{"name":"D\u00eda de Muertos: Poetic and musical stroll at the cemetery","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/muziekpublique.be\/concerts\/20241031_diademuertos\/","email":"info@muziekpublique.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700002027"},"nl":{"name":"D\u00eda de Muertos: Po\u00ebtisch-muzikale wandeling op het kerkhof","shortdescr":"Al 6 jaar wordt de Dia de Muertos in Brussel gevierd, een uniek, hybride en kleurrijk festival, met de Mexicaanse dodenviering als uitgangspunt. De opzet? Terug aanknopen met een universeel gebaar dat in onze hedendaagse samenleving naar de achtergrond verdwijnt: het eren van onze dierbare overledenen.","longdescr":"Via zang, muziek, verhalen, gebaren of vergeten ambachten wordt samen met het publiek tijd en ruimte gecre\u00eberd om ook buiten een religieuze context waardig met de dood om te gaan: herinneringen ophalen, rituelen opnieuw uitvinden, verbinden met nabestaanden\u2026\n\nWe zijn bijzonder verheugd om u als partner van het festival bij zonsondergang te mogen uitnodigen voor een wandeling in het oude gedeelte van de begraafplaats van Sint-Gillis, dat extra belicht wordt door het maanlicht en de kaarsen die langs de paden worden aangestoken. Tijdens deze wandeling zullen muzikanten uit alle hoeken van de wereld begrafenisliederen ten gehore brengen in hun oorspronkelijke taal, en zo een muzikaal eerbetoon aan de dood bieden, rijk aan diverse tradities. Je kunt luisteren naar liedjes in het Tibetaans, Spaans, Portugees, enz., begeleid door traditionele akoestische instrumenten.\n\nOnthoud: het is geen Halloween, we zijn hier niet om je bang te maken.","performers":null,"boxoffice_url":null,"website":"https:\/\/muziekpublique.be\/concerts\/20241031_diademuertos\/","email":"info@muziekpublique.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700002027"}},"place":{"id":50002475,"translations":{"de":{"name":"Cimeti\u00e8re de Saint-Gilles","address_street_name":"72 Avenue du Silence, 1180 Uccle","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"72 Avenue du Silence, 1180 Uccle","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Cimeti\u00e8re de Saint-Gilles","address_street_name":"72 Avenue du Silence, 1180 Uccle","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"72 Avenue du Silence, 1180 Uccle","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Cimeti\u00e8re de Saint-Gilles","address_street_name":"72 Avenue du Silence, 1180 Uccle","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"72 Avenue du Silence, 1180 Uccle","address_line2":"1180 Uccle","description_web":null,"desc