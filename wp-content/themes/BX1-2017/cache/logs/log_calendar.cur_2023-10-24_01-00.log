n_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"fr":{"name":"Galerie Alienor Prouvost","address_street_name":"Rue Washington","address_street_number":"64","address_street_box":null,"email":"ap@alienorprouvost.com","website":"http:\/\/www.alienorprouvost.com","phone_contact":"+32 2 347 18 49","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Washington, 64","address_line2":"1050 Ixelles","description_web":"Apr\u00e8s quelques ann\u00e9es \u00e0 travailler dans l\u2019art moderne \u00e0 Paris, Ali\u00e9nor Prouvost d\u00e9cide de r\u00e9aliser son r\u00eave et de fonder sa galerie au c\u0153ur de la capitale europ\u00e9enne. En mars 2019, elle ouvre les portes du 64, rue Washington dans le quartier du Ch\u00e2telain.\r\n\r\nLa galerie Ali\u00e9nor Prouvost explore principalement les mouvements de l\u2019apr\u00e8s-guerre mais s\u2019int\u00e9resse aussi beaucoup \u00e0 l\u2019Art contemporain.\r\nElle a pour but de d\u00e9mocratiser l\u2019Art, le diffuser et le rendre accessible aupr\u00e8s du plus grand nombre. Elle pr\u00e9sente ainsi, pour les artistes d\u2019apr\u00e8s-guerre, souvent des \u0153uvres sur papier pour permettre aux jeunes collectionneurs de retrouver d\u2019une exposition \u00e0 l\u2019autre les m\u00eames gammes de prix ; de 25 euros \u00e0 15 000 euros. Pour les artistes d\u00e9j\u00e0 tr\u00e8s c\u00f4t\u00e9s, elle travaille \u00e9galement en courtage et essaye de rechercher pour vous l\u2019\u0153uvre la plus proche de vos souhaits.\r\n\r\nLa galerie collabore uniquement en direct avec les artistes, les ayants droit d\u2019artistes ou des fondations pour proposer un contenu toujours exclusif et unique. Gr\u00e2ce \u00e0 ces partenariats, la galerie s\u2019engage sur le long terme \u00e0 contribuer au rayonnement de leurs \u0153uvres. Attach\u00e9e \u00e0 une vision actuelle de son r\u00f4le, elle participe \u00e0 repenser l\u2019histoire de l\u2019art, aiguiser les regards \u2013 et ce \u00e0 destination de tous et toutes.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Galerie Alienor Prouvost","address_street_name":"Rue Washington","address_street_number":"64","address_street_box":null,"email":"ap@alienorprouvost.com","website":"http:\/\/www.alienorprouvost.com","phone_contact":"+32 2 347 18 49","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Washington, 64","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Galerie Alienor Prouvost","address_street_name":"Rue Washington","address_street_number":"64","address_street_box":null,"email":"ap@alienorprouvost.com","website":"http:\/\/www.alienorprouvost.com","phone_contact":"+32 2 347 18 49","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Washington, 64","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[6],"translations":{"de":["Chatelain\/Bailli"],"pt":[null],"en":["Chatelain\/Bailli"],"it":["Chatelain\/Bailli"],"cn":[null],"fr":["Chatelain\/Bailli"],"sp":["Ch\u00e2telain\/Bailli"],"nl":["Kasteleinswijk\/Baljuw"]}},"zones":{"list":[21],"translations":{"de":["S\u00fcden"],"pt":[null],"en":["South"],"it":["Sud"],"cn":[null],"fr":["Sud"],"sp":["Sur"],"nl":["Zuid"]}},"neca":null,"facebook_id":null,"backoffice_id":36427,"location":{"lat":50.82414519,"lon":4.36349286},"region":"brussels","last_updated_at":"2023-01-19T09:51:43+01:00","published_at":"2021-03-26T07:46:51+01:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":false,"resto_ranking":0},"organizer":{"id":276427,"translations":{"de":{"name":"Galerie Alienor Prouvost","address_street_name":"Rue Washington","address_street_number":"64","address_s