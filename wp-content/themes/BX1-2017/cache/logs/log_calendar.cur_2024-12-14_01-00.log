e_id":312378,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"tour","ranking":1.2599210498948732,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{}},"translations":{"de":{"name":"Art Pops - Belfius Art Gallery","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/art-pops-belfius-art-gallery","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":"+32 2 319 45 60","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700003903"},"pt":{"name":"Art Pops - Belfius Art Gallery","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/art-pops-belfius-art-gallery","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":"+32 2 319 45 60","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700003903"},"en":{"name":"Art Pops - Belfius Art Gallery","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/art-pops-belfius-art-gallery","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":"+32 2 319 45 60","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700003903"},"it":{"name":"Art Pops - Belfius Art Gallery","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/art-pops-belfius-art-gallery","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":"+32 2 319 45 60","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700003903"},"cn":{"name":"Art Pops - Belfius Art Gallery","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/art-pops-belfius-art-gallery","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":"+32 2 319 45 60","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700003903"},"fr":{"name":"Art Pops - Belfius Art Gallery","shortdescr":"Nouvelle exposition, nouvelles \u00e9motions. Art Pops vous invite \u00e0 une immersion artistique surprenante au c\u0153ur de la Belfius Art Gallery. ","longdescr":"Nouvelle exposition, nouvelles \u00e9motions. Art Pops vous invite \u00e0 une immersion artistique surprenante au c\u0153ur de la Belfius Art Gallery. Oubliez la visite classique et vivez l'art plus intens\u00e9ment !\n\u00c9coutez, sentez, touchez\u2026 et ressentez une connexion encore plus forte avec chaque \u0153uvre.\n\nPlongez dans des installations \u00e9clatantes de couleurs et vibrantes d'\u00e9nergie, qui vous invitent \u00e0 c\u00e9l\u00e9brer l\u2019expression artistique dans toutes ses textures. Sentir l\u2019invisible, flotter dans un nuage, humer l\u2019art, voyager \u00e0 travers l\u2019imaginaire\u2026 Art Pops n\u2019est pas une simple exposition : c\u2019est un voyage sensoriel et une rencontre personnelle avec l\u2019art.\n\nL\u2019exposition vous invite \u00e0 explorer les pouvoirs extraordinaires de l\u2019art \u00e0 travers une s\u00e9lection d\u2019\u0153uvres qui au-del\u00e0 de la toile expriment le pouvoir de la musique gr\u00e2ce \u00e0 une cr\u00e9ation originale de Jasper Steverlinck, la civilisation des odeurs dans les oeuvres majestueuses de Peter de Cupere ainsi que le langage du toucher et du tactile et l\u2019empire du go\u00fbt au travers entre autres des \u0153uvres de Stefan Peters, Aur\u00e9lie Gravas, Lionel Est\u00e8ve, Louise Delanghe, Warre Mulder, Kristof Santy r\u00e9cemment accueillies au sein de la de la Belfius Art Collection.\n\nVivez l\u2019inattendu et explorez l\u2019art \u00e0 travers tous vos sens !\n\nSi vous participez \u00e0 une visite Arkadia merci de ne pas vous inscrire sur le site de Belfius. Votre place sera automatiquement r\u00e9serv\u00e9e. Veuillez arriver 10 min en avance car il y a un contr\u00f4le d'identit\u00e9 \u00e0 l'entr\u00e9e (ne pas oublier sa carte d'identit\u00e9). Vous retrouverez le guide apr\u00e8s le contr\u00f4le \u00e0 la borne \"point de rencontre\".\n\nBelfius demande \u00e0 chaque visiteur une contribution de 5 euros \u00e0 r\u00e9gler sur place en soutien aux actions Viva for Life (en faveur des enfants et leurs familles vivant sous le seuil de pauvret\u00e9) et JEZ! (en faveur d'organisations intervenant aupr\u00e8s des jeunes). Cette participation est facultative pour les clients Belfius munis de leur carte de banque ou de l\u2019app Belfius Mobile.\n\nLa Belfius Art Gallery se situe au c\u0153ur de Bruxelles, au 32e \u00e9tage de la Tour Belfius.","performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/art-pops-belfius-art-gallery","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":"+32 2 319 45 60","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700003903"},"sp":{"name":"Art Pops - Belfius Art Gallery","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/art-pops-belfius-art-gallery","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":"+32 2 319 45 60","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700003903"},"nl":{"name":"Art Pops - Belfius Art Gallery","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/art-pops-belfius-art-gallery","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":"+32 2 319 45 60","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700003903"}},"place":{"id":266601,"translations":{"de":{"name":"Belfius Art Gallery","address_street_name":"Place Charles Rogier","address_street_number":"11","address_street_box":null,"email":"artcollection@belfius.be","website":"http:\/\/www.belfius-art-collection.be","phone_contact":null,"phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Place Charles Rogier, 11","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Belfius Art Gallery","address_street_name":"Place Charles Rogier","address_street_number":"11","address_street_box":null,"email":"artcollection@belfius.be","website":"http:\/\/www.belfius-art-collection.be","phone_contact":null,"phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Place Charles Rogier, 11","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Belfius Art Gallery","address_street_name":"Place Charles Rogier","address_street_number":"11","address_street_box":null,"email":"artcollection@belfius.be","website":"http:\/\/www.belfius-art-collection.be","phone_contact":null,"phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Place Charles Rogier, 11","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Belfius Art Gallery","address_street_name":"Place Charles Rogier","address_street_number":"11","address_street_box":null,"email":"artcollection@belfius.be","website":"http:\/\/www.belfius-art-collection.be","phone_contact":null,"phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Place Charles Rogier, 11","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Belfius Art Gallery","address_street_name":"Place Charles Rogier","address_street_number":"11","address_street_box":null,"email":"artcollection@belfius.be","website":"http:\/\/www.belfius-art-collection.be","phone_contact":null,"phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Place Charles Rogier, 11","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Belfius Art Gallery","address_street_name":"Place Charles Rogier","address_street_number":"11","address_street_box":null,"email":"artcollection@belfius.be","website":"http:\/\/www.belfius-art-collection.be","phone_contact":null,"phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Place Charles Rogier, 11","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"La collection Belfius est la plus grande collection d\u2019art belge du pays. La collection compte plus de 4 300 \u0153uvres d\u2019art et r\u00e9sulte de la fusion des collections du Cr\u00e9dit communal de Belgique, de Paribas Banque Belgique et de BACOB Banque.\r\n\r\nApr\u00e8s la Deuxi\u00e8me Guerre Mondiale, tant le Cr\u00e9dit communal que Paribas Belgique ont commenc\u00e9 \u00e0 acqu\u00e9rir des \u0153uvres de grande valeur li\u00e9es \u00e0 l\u2019h\u00e9ritage national belge, afin d\u2019\u00e9viter qu\u2019elles ne disparaissent \u00e0 l\u2019\u00e9tranger. D\u00e8s le d\u00e9but, le Cr\u00e9dit communal a mis l\u2019accent sur l\u2019art belge \u00e0 partir de 1860, tandis que Paribas se concentrait principalement sur des \u0153uvres du 16e au 18e si\u00e8cle et sur l\u2019art contemporain. BACOB banque a commenc\u00e9 sa collection en 1980 et s\u2019est exclusivement consacr\u00e9e \u00e0 l\u2019art contemporain belge. Aujourd\u2019hui, la collection couvre pr\u00e8s de cinq si\u00e8cles.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Belfius Art Gallery","address_street_name":"Place Charles Rogier","address_street_number":"11","address_street_box":null,"email":"artcollection@belfius.be","website":"http:\/\/www.belfius-art-collection.be","phone_contact":null,"phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Place Charles Rogier, 11","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Belfius Art Gallery","address_street_name":"Charles Rogierplein","address_street_number":"11","address_street_box":null,"email":"artcollection@belfius.be","website":"http:\/\/www.belfius-art-collection.be","phone_contact":null,"phone_booking":null,"address_zip":"1210","address_city":"Sint-Joost-Ten-Node","address_line1":"Charles Rogierplein, 11","address_line2":"1210 Sint-Joost-Ten-Node","description_web":"De Belfius-kunstcollectie is de grootste verzameling van Belgische kunst van het land en omvat meer dan 4300 werken, het gevolg van de samensmelting van de kunstverzamelingen van het Gemeentekrediet, Paribas Bank Belgi\u00eb en BACOB Bank.\r\n\r\nZowel het Gemeentekrediet als Paribas Belgi\u00eb begonnen na de Tweede Wereldoorlog met het verzamelen van waardevolle kunstwerken uit het nationaal erfgoed om te vermijden dat ze naar het buitenland verdwenen. Het Gemeentekrediet legde van in het begin het accent op Belgische kunst vanaf 1860, terwijl Paribas Belgi\u00eb kunst uit de 16de tot de 18de eeuw en moderne kunst kocht. BACOB bank begon zijn verzameling in 1980 en legde zich uitsluitend toe op Belgische hedendaagse kunst. Vandaag bestrijkt de collectie werken uit bijna vijf eeuwen.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[15],"translations":{"de":["Rogier"],"pt":[null],"en":["Rogier"],"it":["Rogier"],"cn":[null],"fr":["Rogier"],"sp":["Rogier"],"nl":["Rogier"]}},"zones":{"list":[20],"translations":{"de":["Norden"],"pt":[null],"en":["North"],"it":["Nord"],"cn":[null],"fr":["Nord"],"sp":["Norte"],"nl":["Noord"]}},"neca":null,"facebook_id":null,"backoffice_id":26601,"location":{"lat":50.8565062,"lon":4.3594062},"region":"brussels","last_updated_at":"2024-06-06T16:33:40+02:00","published_at":"2016-10-14T09:55:01+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":276946,"translations":{"de":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be\/en","phone_contact":"+32 2 319 45 60","phone_booking":null,"addre