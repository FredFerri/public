ongdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lejardindemasoeur.be","email":"info@lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700004460"},"it":{"name":"Barnab\u00e9 \u2013 Solitaire Collectif","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lejardindemasoeur.be","email":"info@lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700004460"},"cn":{"name":"Barnab\u00e9 \u2013 Solitaire Collectif","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lejardindemasoeur.be","email":"info@lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700004460"},"fr":{"name":"Barnab\u00e9 \u2013 Solitaire Collectif","shortdescr":"\u201cSolitaire Collectif\u201d, un joli oxymore qui rassemble bien des artistes. On \u00e9crit, on cr\u00e9e, souvent seul, on fait le vide, on se lib\u00e8re de maux en mots, de note en note. Mais tout cela n\u2019a pas de sens si ce n\u2019est pas partag\u00e9. Barnab\u00e9, solitaire dans l\u2019\u00e2me, s\u2019est entour\u00e9 plus que jamais, et il en va de m\u00eame sur sc\u00e8ne, au Jardin de ma S\u0153ur...","longdescr":"\u201cSolitaire collectif\u201d, un joli oxymore qui rassemble bien des artistes. On \u00e9crit, on cr\u00e9e, souvent seul, on fait le vide, on se lib\u00e8re de maux en mots, de note en note. Mais tout cela n\u2019a pas de sens si ce n\u2019est pas partag\u00e9. Chaque musicien, chaque interpr\u00e8te, arrangeur, r\u00e9gisseur, ajoute son grain de sel, de sable, de folie. Et voil\u00e0 que l\u2019histoire la plus personnelle du monde prend des allures de troupe. Pour son troisi\u00e8me album, Barnab\u00e9, solitaire dans l\u2019\u00e2me, s\u2019est entour\u00e9 plus que jamais, et il en va de m\u00eame sur sc\u00e8ne, au Jardin de ma S\u0153ur... \u00ab\u00a0De la chanson \u00e0 texte artisanale, empreinte de classicisme mais faite et offerte avec c\u0153ur, par un artiste passeur d\u2019\u00e9motions et profond\u00e9ment amoureux des mots. Faites-vous du bien, d\u00e9couvrez Barnab\u00e9. \u00bb","performers":"Barnab\u00e9 (chant, guitare, paroles, musiques); Aur\u00e9lie Goudaer (violon); Stany Mannaert (accord\u00e9on); Pascal Chardome (piano, guitares); Line Adam (arrangements)","boxoffice_url":null,"website":"https:\/\/www.lejardindemasoeur.be","email":"info@lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700004460"},"sp":{"name":"Barnab\u00e9 \u2013 Solitaire Collectif","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lejardindemasoeur.be","email":"info@lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700004460"},"nl":{"name":"Barnab\u00e9 \u2013 Solitaire Collectif","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lejardindemasoeur.be","email":"info@lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700004460"}},"place":{"id":220283,"translations":{"de":{"name":"Le Jardin de ma Soeur","address_street_name":"Rue du Grand Hospice","address_street_number":"54","address_street_box":null,"email":"info@lejardindemasoeur.be","website":"http:\/\/www.lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 54","address_line2":"1000 Bruxelles","description_web":"Dieses malerische Caf\u00e9-Theater, das 1994 in der N\u00e4he des alten \"Grand B\u00e9guinage de Bruxelles\" er\u00f6ffnet wurde, \u00fcberrascht durch seine \u00fcberaus kleinen R\u00e4umlichkeiten. Doch daf\u00fcr ist das Programm ist umso \"gr\u00f6\u00dfer\". Reservierung empfohlen!","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Le Jardin de ma Soeur","address_street_name":"Rue du Grand Hospice","address_street_number":"54","address_street_box":null,"email":"info@lejardindemasoeur.be","website":"http:\/\/www.lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 54","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Le Jardin de ma Soeur","address_street_name":"Grootgodshuisstraat","address_street_number":"54","address_street_box":null,"email":"info@lejardindemasoeur.be","website":"http:\/\/www.lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","address_zip":"1000","address_city":"Brussels","address_line1":"Grootgodshuisstraat, 54","address_line2":"1000 Brussels","description_web":"The desire to present theater amongst people; as if a performance is nothing but a conversation, in a place somewhere in between the large halls and the streets, half living room, half pub, in a warm ambiance where one can sip a glass while watching a performance. That's cafe-theater \"Le Jardin de ma Soeur\", at the edge of the ancient \"Grand B\u00e9guinage de Bruxelles\", alongside one of the quays of the old port of Brussels where the spirit of the dock workers lingers and where one can still feel the presence of the beguines with their long black robes.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Le Jardin de ma Soeur","address_street_name":"Rue du Grand Hospice","address_street_number":"54","address_street_box":null,"email":"info@lejardindemasoeur.be","website":"http:\/\/www.lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 54","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Le Jardin de ma Soeur","address_street_name":"Rue du Grand Hospice","address_street_number":"54","address_street_box":null,"email":"info@lejardindemasoeur.be","website":"http:\/\/www.lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 54","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Le Jardin de ma Soeur","address_street_name":"Rue du Grand Hospice","address_street_number":"54","address_street_box":null,"email":"info@lejardindemasoeur.be","website":"http:\/\/www.lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 54","address_line2":"1000 Bruxelles","description_web":"Le Jardin de ma S\u0153ur est situ\u00e9 au coin d'une rue du pittoresque March\u00e9 aux poissons, \u00e0 proximit\u00e9 de l\u2019ancien Grand B\u00e9guinage de Bruxelles. On peut difficilement imaginer un nom plus familier. Pourtant, cet endroit n'a pas vol\u00e9 son nom. Vous obtenez exactement ce que vous attendez : une soir\u00e9e sans pr\u00e9tention, pleine de divertissements et de moments partag\u00e9s. Vous vous y sentez comme dans votre salon. Vous oubliez imm\u00e9diatement tous vos soucis et riez, chantez et profitez du spectacle avec les autres participants. Sp\u00e9cialement pour les amateurs de chanson fran\u00e7aise et de th\u00e9\u00e2tre.  \u202f \r\nPensez \u00e0 r\u00e9server votre place !\r\n ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Le Jardin de ma Soeur","address_street_name":"Rue du Grand Hospice","address_street_number":"54","address_street_box":null,"email":"info@lejardindemasoeur.be","website":"http:\/\/www.lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 54","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Le Jardin de ma Soeur","address_street_name":"Grootgodshuisstraat","address_street_number":"54","address_street_box":null,"email":"info@lejardindemasoeur.be","website":"http:\/\/www.lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","address_zip":"1000","address_city":"Brussel","address_line1":"Grootgodshuisstraat, 54","address_line2":"1000 Brussel","description_web":"Op een straathoek aan de pittoreske Vismarkt ligt Le Jardin de ma Soeur. Een familialere naam kan je haast niet bedenken. Toch heeft deze plek haar naam niet gestolen. Je krijgt exact wat je er zou verwachten: een pretentieloze avond vol vertier en gedeelde momenten. Hier waan je je in een gezellige en veilige woonkamer. Je vergeet er meteen al je zorgen en lacht, zingt en geniet met de andere aanwezigen. Vooral voor liefhebbers van het Franse chanson en verhaaltheater.    \u202f\u202f\u202f ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url"