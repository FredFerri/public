8559371553193,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":49,"translations":{"de":"Theater","pt":null,"en":"Theatre","it":"Teatro","cn":null,"fr":"Th\u00e9\u00e2tre","sp":"Teatro","nl":"Theater"}},"others":{"list":[51],"translations":{"de":["Kabarett"],"pt":[null],"en":["Cabaret"],"it":["Cabaret"],"cn":[null],"fr":["Caf\u00e9 th\u00e9\u00e2tre"],"sp":["Caf\u00e9 teatro"],"nl":["Cabaret"]}}},"translations":{"de":{"name":"ABRACA D'IMPRO - Pi\u00e8ce de th\u00e9\u00e2tre Improvis\u00e9e pour enfants","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.letrac.be\/calendrier","email":"info@letrac.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700002472"},"pt":{"name":"ABRACA D'IMPRO - Pi\u00e8ce de th\u00e9\u00e2tre Improvis\u00e9e pour enfants","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.letrac.be\/calendrier","email":"info@letrac.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700002472"},"en":{"name":"ABRACA D'IMPRO - Pi\u00e8ce de th\u00e9\u00e2tre Improvis\u00e9e pour enfants","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.letrac.be\/calendrier","email":"info@letrac.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700002472"},"it":{"name":"ABRACA D'IMPRO - Pi\u00e8ce de th\u00e9\u00e2tre Improvis\u00e9e pour enfants","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.letrac.be\/calendrier","email":"info@letrac.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700002472"},"cn":{"name":"ABRACA D'IMPRO - Pi\u00e8ce de th\u00e9\u00e2tre Improvis\u00e9e pour enfants","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.letrac.be\/calendrier","email":"info@letrac.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700002472"},"fr":{"name":"ABRACA D'IMPRO - Pi\u00e8ce de th\u00e9\u00e2tre Improvis\u00e9e pour enfants","shortdescr":"Plongez dans le monde incroyable d'ABRACA D'IMPRO pour une aventure o\u00f9 vos id\u00e9es animent des histoires magiques. Apportez des personnages, des lieux et des objets sur sc\u00e8ne et regardez-les prendre vie gr\u00e2ce \u00e0 l'improvisation. Id\u00e9al pour les enfants d\u00e8s 3 ans, ce spectacle captivant transforme l'imagination en r\u00e9alit\u00e9.","longdescr":"ABRACA D'IMPRO \n\nAttention, les enfants ! Deux personnages farfelus d\u00e9barquent sur sc\u00e8ne pour vous raconter une histoire... Mais Oups ! Ils ont perdu le fil !\n\nPas de panique, ils ont besoin de vous pour inventer une nouvelle histoire pleine de malices ! Vos id\u00e9es seront les cl\u00e9s de cette aventure. Des personnages rigolos, des lieux incroyables, des objets myst\u00e9rieux... tout ce que vous imaginez sera dessin\u00e9 sur des petits papiers, puis m\u00e9lang\u00e9 dans un chapeau enchant\u00e9. \n\nEt Hop ! Avec un peu de magie et beaucoup de rires, ABRACA D'IMPRO fait appara\u00eetre une histoire unique, n\u00e9e de votre imagination ! \n\nPr\u00e9parez-vous \u00e0 vivre des aventures extraordinaires avec des personnages hauts en couleurs, des rebondissements et plein d'\u00e9motions. C'est un spectacle pour tous les enfants (\u00e0 partir de 3 ans), o\u00f9 l'imagination est reine et la magie de l'impro sera toujours au rendez-vous !\nViens partager tes id\u00e9es et cr\u00e9er une histoire magique avec nous ! \n\nTh\u00e9\u00e2tre d'improvisation pour Petits (de 3 \u00e0 6 ans) et leurs Grands (les parents)\n\nSpectacle de la Troupe 100 Histoires\nAvec Agathe Mortelecq, Arnaud Van Parys, Vincent Doms et Elodie Vraiment\n\n--------------\n\nINFORMATIONS PRATIQUES : \n\nLieu : Le TRAC\n110, rue Albert Meunier- Auderghem\n\nHeure : Spectacle \u00e0 11h15\nDur\u00e9e : 45 minutes\n\nIl est possible de :\n- boire un verre sur place avant\/pendant le spectacle\n- manger apr\u00e8s le spectacle (uniquement sur r\u00e9servation)\n\nTARIFS\nSur r\u00e9servation : 10\u20ac\/personne\nSur place : 12\u20ac\/personne\n(Place offerte au parent accompagnant minimum 3 enfants)\n\nR\u00c9SERVATIONS (vivement conseill\u00e9es)\nvia le lien du Trac : https:\/\/forms.gle\/kknRTzCRJyQj8BbC7\n\nLe Trac est un Caf\u00e9-Th\u00e9\u00e2tre et propose des D\u00eeners-Spectacles\/Lunch-Spectacles.\nPensez \u00e0 bien r\u00e9server.\nPar cons\u00e9quent, veuillez noter que les r\u00e9servations qui ne comprennent pas de repas ne peuvent pas \u00eatre prioritaires. En cas d'annulation, nous vous informerons -\u00e9videmment- par e-mail ou SMS.\n\nPensez \u00e0 r\u00e9server : https:\/\/forms.gle\/kknRTzCRJyQj8BbC7 \n\n------------------\n\nDATES DE LA SAISON :\n-Spectacle \u00e0 11h15-\n\n2024\n28 septembre 2024\n\u206026 octobre 2024\n30 novembre 2024\n21 d\u00e9cembre 2024\n\n2025\n25 janvier 2025\n\u2060\u206022 f\u00e9vrier 2025\n29 mars 2025\n26 avril 2025\n\u2060\u206031 mai 2025\n28 juin 2025\n\n---------------------\n\nPLAN DE TABLE\nNoter que nous \u00e9tablissons un pan de table pour chacun de nos spectacles.\n\nVoici comment nous vous installons en salle :\n* Ceux qui mangent sont \u00e0 table\n* Nous vous r\u00e9servons une table, en salle \n* Ceux qui ne mangent pas n\u2019auront pas forc\u00e9ment de table\n* Ceux qui viennent seuls feront des rencontres pendant la soir\u00e9e\n* Et tout ceux qui ne r\u00e9servent pas comptent bien trop sur la chance \n","performers":"La Troupe 100 Histoires","boxoffice_url":null,"website":"http:\/\/www.letrac.be\/calendrier","email":"info@letrac.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700002472"},"sp":{"name":"ABRACA D'IMPRO - Pi\u00e8ce de th\u00e9\u00e2tre Improvis\u00e9e pour enfants","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.letrac.be\/calendrier","email":"info@letrac.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700002472"},"nl":{"name":"ABRACA D'IMPRO - Pi\u00e8ce de th\u00e9\u00e2tre Improvis\u00e9e pour enfants","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.letrac.be\/calendrier","email":"info@letrac.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700002472"}},"place":{"id":258588,"translations":{"de":{"name":"Arret Culture a.s.b.l.","address_street_name":"Rue Albert Meunier","address_street_number":"110","address_street_box":null,"email":null,"website":null,"phone_contact":"+32 498 52 51 77","phone_booking":null,"address_zip":"1160","address_city":"Auderghem","address_line1":"Rue Albert Meunier, 110","address_line2":"1160 Auderghem","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Arret Culture a.s.b.l.","address_street_name":"Rue Albert Meunier","address_street_number":"110","address_street_box":null,"email":null,"website":null,"phone_contact":"+32 498 52 51 77","phone_booking":null,"address_zip":"1160","address_city":"Auderghem","address_line1":"Rue Albert Meunier, 110","address_line2":"1160 Auderghem","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Arret Culture a.s.b.l.","address_street_name":"Rue Albert Meunier","address_street_number":"110","address_street_box":null,"email":null,"website":null,"phone_contact":"+32 498 52 51 77","phone_booking":null,"address_zip":"