1040 Etterbeek","description_web":"CoHop, de eerste co\u00f6peratieve microbrouwerij in Brussel, is een gedeelde, ecologisch verantwoorde brouwerij die ambachtelijke bieren aanbiedt met een positieve maatschappelijke impact. Het doel is het delen van een plek en meer bepaald het delen van brouwmateriaal, vaardigheden, een brewpub en een broodjeszaak. \r\nC\u00e9dric d'Agalmalt, gids en liefhebber, biedt leuke en onderhoudende workshops aan die de deelnemers een beter inzicht geven in de wereld van het brouwen. \r\n\r\nBezoeken en proeverijen op reservering.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":39485,"location":{"lat":50.82550329,"lon":4.39868042},"last_updated_at":"2023-09-14T10:45:37+02:00","published_at":"2022-10-07T14:08:56+02:00","is_in_address_book":false,"is_in_vb_export":false,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"poster","link":"https:\/\/agendabrussels2.imgix.net\/67cb839e0604855ae715ab3411a841db64a6242e.png","width":1637,"height":1158,"ratio":1,"oEmbed_height":1158,"oEmbed_width":1637,"translations":{"de":{"title":"Affiche Quiz Musical","copyright":"MiandaPhotography"},"pt":{"title":"Affiche Quiz Musical","copyright":"MiandaPhotography"},"en":{"title":"Affiche Quiz Musical","copyright":"MiandaPhotography"},"it":{"title":"Affiche Quiz Musical","copyright":"MiandaPhotography"},"cn":{"title":"Affiche Quiz Musical","copyright":"MiandaPhotography"},"fr":{"title":"Affiche Quiz Musical","copyright":"MiandaPhotography"},"sp":{"title":"Affiche Quiz Musical","copyright":"MiandaPhotography"},"nl":{"title":"Affiche Quiz Musical","copyright":"MiandaPhotography"}}}],"dates":[{"day":"2023-09-20","doors":"17:00:00","start":"20:00:00","end":"22:00:00","is_soldout":false,"is_canceled":false},{"day":"2023-10-18","doors":"17:00:00","start":"20:00:00","end":"22:00:00","is_soldout":false,"is_canceled":false},{"day":"2023-11-2