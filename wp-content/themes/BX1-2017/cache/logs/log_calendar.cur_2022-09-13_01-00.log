n":true,"hours":[{"start":"09:00:00","end":"16:00:00"}]},"wednesday":{"is_open":true,"hours":[{"start":"09:00:00","end":"16:00:00"}]},"thursday":{"is_open":true,"hours":[{"start":"09:00:00","end":"16:00:00"}]},"friday":{"is_open":true,"hours":[{"start":"09:00:00","end":"16:00:00"}]},"saturday":{"is_open":true,"hours":[{"start":"11:00:00","end":"17:00:00"}]},"sunday":{"is_open":true,"hours":[{"start":"11:00:00","end":"17:00:00"}]}},"translations":{"fr":["lundi: ferm\u00e9","mardi, mercredi, jeudi et vendredi: de 09:00 \u00e0 16:00","samedi et dimanche: de 11:00 \u00e0 17:00"],"nl":["maandag: gesloten","dinsdag, woensdag, donderdag en vrijdag: van 09:00 tot 16:00","zaterdag en zondag: van 11:00 tot 17:00"],"en":["monday: closed","tuesday, wednesday, thursday and friday: from 09:00 to 16:00","saturday and sunday: from 11:00 to 17:00"]},"date_start":"2022-09-17","date_end":"2022-11-06","is_also_by_appointment":false}],"prices":[{"translations":{"fr":{"name":"Cat\u00e9gorie 1"},"nl":{"name":"Categorie 1"},"en":{"name":"Category 1"}},"value":65},{"translations":{"fr":{"name":"Cat\u00e9gorie 2"},"nl":{"name":"Categorie 2"},"en":{"name":"Category 2"}},"value":90},{"translations":{"fr":{"name":"Cat\u00e9gorie 3"},"nl":{"name":"Categorie 3"},"en":{"name":"Category 3"}},"value":70},{"translations":{"fr":{"name":"Cat\u00e9gorie 4"},"nl":{"name":"Categorie 4"},"en":{"name":"Category 4"}},"value":135}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-08-10T17:36:03+02:00","published_at":"2022-07-27T14:49:28+02:00","backoffice_id":258988,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.33974515584373},{"id":540247,"date_start":"2022-09-08","date_end":"2022-10-09","date_next":"2022-09-17","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[36,41],"translations":{"fr":["Mus\u00e9es et art centers","Installation, performance"],"nl":["Musea en kunstcentra","Installatie, performance"],"en":["Museums and art centers","Installation, performance"]}}},"languages":{"spoken":["en","fr"],"subtitles":[]},"translations":{"fr":{"name":"A box is a box is a box","shortdescr":"Triphas\u00e9 pr\u00e9sente \u00ab A box is a box is a box \u00bb, une installation vid\u00e9o n\u00e9e d\u2019une collaboration entre les artistes Harold Lechien, Frizbee Ceramics et Gabriel Ren\u00e9 Franjou.","longdescr":"Les g\u00e9ants de la vente en ligne exercent une mainmise sur le commerce contemporain. Outre le nombre consid\u00e9rable de produits qui sont livr\u00e9s chaque jour, une partie importante des objets demeurent ignor\u00e9s ou d\u00e9laiss\u00e9s. \r\nLes invendus sont parfois d\u00e9truits, et le taux de retour sur les ventes avoisine les 20%. Les entreprises d\u2019e-commerce font donc appel \u00e0 d\u2019autres, sp\u00e9cialis\u00e9es en liquidation d\u2019inventaire, pour remettre en circulation ces produits sous forme de lots plus ou moins al\u00e9atoires. \r\n\r\n\u00c0 travers une installation vid\u00e9o, \u201cA box is a box is a box\u201d  invite les visiteurs \u00e0 assister \u00e0 l\u2019exposition-unboxing de ces palettes randomis\u00e9es : un cha\u00eenon suppl\u00e9mentaire s\u2019immisce dans la logique de circulation abstraite des biens et propose au spectateur une exp\u00e9rience mat\u00e9rielle et sensible.\r\n\r\nHarold Lechien (1995) est un artiste pluridisciplinaire qui vit et travaille \u00e0 Bruxelles. De mani\u00e8re physique ou par le prisme des nouveaux m\u00e9dias, Harold Lechien s\u2019att\u00e8le \u00e0 d\u00e9tourner les marchandises commerciales, les logiques promotionnelles 2.0 et la novlangue qui les accompagne. R\u00e9guli\u00e8rement expos\u00e9 en Belgique et \u00e0 l\u2019\u00e9tranger depuis 2016, son travail pose un regard singulier sur la circulation des \u00e9motions qui surgissent face \u00e0 la production et \u00e0 la r\u00e9ception affective des images et des produits industriels. A mi-chemin entre le design industriel et la sc\u00e9nographie commerciale, son \u0153uvre se d\u00e9ploie par l\u2019objet, l\u2019image et la vid\u00e9o au sein d\u2019installations polymorphes et modulaires, o\u00f9 strat\u00e9gie marketing et cr\u00e9ation contemporaine se r\u00e9pondent.\r\n\r\nLisa Egio et Elliot Kervyn mettent en commun leurs connaissances en architecture et anthropologie ainsi que leur implication via \u00ab Frizbee ceramics \u00bb, leur marque de vaisselle, pour \u00e9tablir une r\u00e9flexion critique sur les syst\u00e8mes de production et de distribution. Ils produisent et exp\u00e9dient des objets utilitaires au quotidien. Dans leurs installations contextuelles, ils questionnent surtout la hi\u00e9rarchie des symboles et des th\u00e8mes sociaux comme le syst\u00e8me du marketing, l\u2019in\u00e9galit\u00e9 sociale, le gaspillage, la malbouffe, etc\u2026\r\n\r\nLisa Egio (\u00b01990, FR) et Elliot Kervyn (\u00b01989, BE) vivent et travaillent entre Bruxelles et Londres. Kervyn \u00e9tudia entre 2007 et 2012 \u00e0 L\u2019acad\u00e9mie Rietveld \u00e0 Amsterdam, \u00e0 l\u2019ULB \u00e0 Bruxelles (en anthropologie) et enfin \u00e0 La Cambre (en \u00ab Espace urbain \u00bb). Egio termina son bachelier en architecture \u00e0 Marseille et \u00e9tudia ensuite entre 2012 et 2017 \u00e9galement \u201cEspace urbain\u201d \u00e0 La Cambre. De 2019 \u00e0 2020 ils suivirent un post-graduat au Coll\u00e8ge Royal des Arts \u00e0 Londres. \r\n\r\nGabriel Ren\u00e9 Franjou (1996) est artiste, auteur et travailleur culturel vivant \u00e0 Bruxelles. Il \u00e9tudie l'\u00e9motion dans les r\u00e9seaux num\u00e9riques et organiques, o\u00f9 la connectivit\u00e9 est un moteur cr\u00e9atif et critique\r\n\r\nLes artistes sont les deuxi\u00e8mes invit\u00e9s \u00e0 exposer et curater dans \u00ab L\u2019espace Triphas\u00e9\u00bb, espace d\u2019exposition de 170 m2 au c\u0153ur des Ateliers Triphas\u00e9.\r\n\r\nTriphas\u00e9 est un espace qui soutient la recherche des artistes \u00e9mergents. Le projet voit le jour en 2021, dans un b\u00e2timent industriel de 900m2 aux abords du centre-ville de Bruxelles, \u00e0 Anderlecht. Antoinette d\u2019Ansembourg et Alice Pandolfo fondent tout d\u2019abord les Ateliers Triphas\u00e9, et invitent annuellement une dizaine d\u2019artistes plasticiens \u00e0 les occuper.\r\n\r\n L\u2019Espace Triphas\u00e9, lieu d\u2019exposition et laboratoire d\u2019exp\u00e9rimentations est inaugur\u00e9 six mois plus tard avec l\u2019exposition collective \u201cPlease Talk Louder\u201d et ensuite Aquaturf pour aujourd\u2019hui pr\u00e9senter sa troisi\u00e8me exposition, \u201cA box is a box is a box\u201d.\r\nTriphas\u00e9 est un projet foisonnant qui permet aux artistes d\u2019\u00e9tendre leurs pratiques sans contraintes, tout en favorisant les rencontres et les \u00e9changes avec le public.","performers":"Frizbee Ceramics, Harold Lechien, Gabriel Ren\u00e9 Franjou","boxoffice_url":null,"website":"https:\/\/www.instagram.com\/espace.triphase\/","email":"ateliertriphase@gmail.com","phone_contact":"+32 477 47 95 40","phone_booking":"+32 477 47 95 40","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.540247"},"nl":{"name":"A box is a box is a box","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.540247"},"en":{"name":"A box is a box is a box","shortdescr":"Triphas\u00e9 presents \"A box is a box is a box\", a video installation born of a collaboration between Harold Lechien, Frizbee Ceramics and Gabriel Ren\u00e9 Franjou.","longdescr":"The main players in online sales enjoy a stranglehold on contemporary commerce. Alongside the considerable quantity of products delivered every day, a large part of their catalog remains ignored or abandoned. \r\nUnsold items are sometimes destroyed, and the return rate on sales nears 20%. E-commerce companies call upon others, specialized in inventory clearance, to repackage and resell these articles in more or less random batches.\r\n\r\nThrough a video installation, \u201cA box is a box ix a box\u201d  invites visitors to an unboxing-exhibition of these randomized boxes: an additional link infiltrates the abstract logic of how goods circulate and offers a material and sensitive experience.\r\n\r\nHarold Lechien (1995) is a multidisciplinary artist and musician who lives and works in Brussels. Trough sculpture or through the prism of new media, Harold Lechien strives to distort commercial goods, promotional logic and the language that accompanies them. Regularly exhibited in Belgium and abroad since 2018, his work takes a singular look at the circulation of emotions that emerge from the production and affective reception of images and industrial products. Halfway between design and commercial scenography, his work is deployed through the object, image and video within polymorphous and modular installations, where marketing strategy and contemporary creation meet.\r\n\r\nLisa Egio and Elliot Kervyn live and work between Brussels and London. First trained in anthropology and architecture, from 2019 to 2020 they followed a postgraduate in sculpture at the Royal College of Arts in London. Since 2017 they have been manufacturing porcelain tableware casted from plastic objects under the name \"Frizbee ceramics\". Egio and Kervyn produce contextual installations that become laboratories for experimentation. With humor and self derision they critically examine structures of object manufacture and consumption. With a particular interest in the loss of control over production techniques and processes, as well as commercial and psychological patterns that channel the consumption of material and abstract objects.\r\n\r\nGabriel Ren\u00e9 Franjou (1996) is an artist, author and cultural worker based in Brussels. He studies emotion in digital and organic networks, in which connectivity is a creative and critical engine.\r\n\r\nThe artists are the second to be invited to curate and occupy the \" Espace Triphas\u00e9\", an exhibition space of 170 m2 in the heart of Triphas\u00e9.\r\n\r\nTriphas\u00e9 is a space supporting emerging artists\u2019 research. The project was born in a 900m2 industrial building in Anderlecht, on the outskirts of downtown Brussels, in 2021. Antoinette d\u00b4Ansembourg and Alice Pandolfo first founded the Ateliers Triphas\u00e9 and invited ten visual artists per year to occupy them.\r\n\r\n\u201cEspace Triphas\u00e9\u201d, an exhibition space and experimental laboratory, was inaugurated six months later with the group exhibition \"Please Talk Louder\" and then Aquaturf, which is now presenting its third exhibition, \"A box is a box is a box\".\r\nTriphas\u00e9 is a place allowing artists to meld their theories, intelligence, opinions, determinations; it\u2019s about moving forward together, freely, through a common force.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.540247"},"de":{"name":"A box is a box is a box","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.540247"},"it":{"name":"A box is a box is a box","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact"