22-06-11","date_next":"2022-06-10","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre"}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Le dernier salut","shortdescr":"Les trois com\u00e9diens permanents du Th\u00e9\u00e2tre National prennent leur retraite et font une sortie de sc\u00e8ne absolument g\u00e9niale. La nuit tomb\u00e9e, ils vous emm\u00e8neront, munis de casques audio et de lanternes, au-del\u00e0 des murs du th\u00e9\u00e2tre, pour un dernier parcours dr\u00f4le et po\u00e9tique.","longdescr":"Au fil d\u2019une balade insolite, vous \u00e9couterez les textes qui les ont marqu\u00e9s, partagerez leurs souvenirs et r\u00e9flexions. Un spectacle qu\u2019on a suivi le sourire aux l\u00e8vres, le c\u0153ur d\u00e9bordant d\u2019\u00e9motions.\r\n\r\nAu soir de leur carri\u00e8re, trois com\u00e9diens refusent d\u2019abdiquer devant l\u2019obsolescence programm\u00e9e. Face \u00e0 la retraite qui sonne le glas d\u2019une vie de th\u00e9\u00e2tre, le trio d\u00e9clare la r\u00e9volution, fusse-t-elle g\u00e9riatrique ! Les voil\u00e0 donc p\u00e9rim\u00e9s ? Trop vieux pour dire l\u2019amour, la mort, l\u2019espoir, pour servir Pr\u00e9vert, Rostand ou Shakespeare ? En r\u00e9ponse \u00e0 une telle ineptie, ils proposent d\u2019embarquer le public dans une cavalcade urbaine et po\u00e9tique. On nie leur place, on la leur d\u00e9robe\u2026 Qu\u2019\u00e0 cela ne tienne, de la rue ils feront une sc\u00e8ne, des ruelles les d\u00e9cors pour crier leur amour du m\u00e9tier et se jouer du temps qui passe vite, trop vite.\r\nCR\u00c9ATION SONORE Maxime Glaude R\u00c9GIE G\u00c9N\u00c9RALE Joachim Pochet R\u00c9GIE SON Pawel Wnuczynski R\u00c9GIE PLATEAU (ART2WORK) Klaudia Snarska, David Regnier CR\u00c9ATION STUDIO Th\u00e9\u00e2tre National Wallonie-Bruxelles PHOTO \u00a9Maud Faivre\r\n\r\nPRODUCTION Th\u00e9\u00e2tre National Wallonie-Bruxelles AIDE Cie Victor B CONSTRUCTION D\u00c9CORS ET COSTUMES Ateliers du Th\u00e9\u00e2tre National Wallonie-Bruxelles, Atelier Construction de Quai 41 \u2013 Guy Carbonnelle PEINTURES ET PORTRAITS DES COM\u00c9DIENS Sylvain Bouder RECHERCHES PHOTOGRAPHIQUES C\u00e9cile Michel","performers":"De Nicolas Buysse \u2013 Cie Les Bo\u00eetes \u00e0 Id\u00e9es CONCEPTION, \u00c9CRITURE ET MISE EN SC\u00c8NE Nicolas Buysse DRAMATURGIE Jean-Michel Fr\u00e8re SC\u00c9NOGRAPHIE Ditte van Brempt AVEC Jean-Pierre Baudson, Alfredo Ca\u00f1avate, Patrick Donnay","boxoffice_url":null,"website":"https:\/\/www.wolubilis.be\/a-voir\/le-dernier-salut\/","email":null,"phone_contact":"+32 2 761 60 30","phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/533791.html"},"nl":{"name":"Le dernier salut","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/533791.html"},"en":{"name":"Le dernier salut","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/533791.html"},"de":{"name":"Le dernier salut","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/533791.html"},"it":{"name":"Le dernier salut","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"ph