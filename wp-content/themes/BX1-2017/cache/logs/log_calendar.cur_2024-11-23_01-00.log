ame":"Rue des Tanneurs","address_street_number":"65","address_street_box":null,"email":"archives@brucity.be","website":"http:\/\/archives.bruxelles.be","phone_contact":"+32 2 279 53 20","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Tanneurs, 65","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Archives de la Ville de Bruxelles","address_street_name":"Rue des Tanneurs","address_street_number":"65","address_street_box":null,"email":"archives@brucity.be","website":"http:\/\/archives.bruxelles.be","phone_contact":"+32 2 279 53 20","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Tanneurs, 65","address_line2":"1000 Bruxelles","description_web":"Le Service des Archives a constitu\u00e9 une biblioth\u00e8que scientifique qui compte quelque 25.000 volumes, principalement d\u2019int\u00e9r\u00eat historique, urbain et bruxellois sans omettre les ouvrages de r\u00e9f\u00e9rence \u00e0 caract\u00e8re encyclop\u00e9dique et les revues scientifiques historiques et professionnelles.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Archives de la Ville de Bruxelles","address_street_name":"Rue des Tanneurs","address_street_number":"65","address_street_box":null,"email":"archives@brucity.be","website":"http:\/\/archives.bruxelles.be","phone_contact":"+32 2 279 53 20","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Tanneurs, 65","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Archief van de Stad Brussel","address_street_name":"Huidevettersstraat","address_street_number":"65","address_street_box":null,"email":"archieven@brucity.be","website":"http:\/\/archieven.brussel.be","phone_contact":"+32 2 279 53 20","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Huidevettersstraat, 65","address_line2":"1000 Brussel","description_web":"De Archiefdienst heeft een wetenschappelijke bibliotheek opgebouwd van ongeveer 25.000 volumes, hoofdzakelijk over geschiedenis, stedenbouwkunde en Brussel. Daarnaast bevinden er zich encyclopedische referentiewerken en historisch-wetenschappelijke en vaktijdschriften.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[2],"translations":{"de":["Marollen"],"pt":[null],"en":["Marolles"],"it":["Marolles"],"cn":[null],"fr":["Marolles"],"sp":["Marolles"],"nl":["Marollen"]}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":null,"facebook_id":null,"backoffice_id":475,"location":{"lat":50.83949952,"lon":4.34607287},"region":"brussels","last_updated_at":"2024-09-24T10:23:23+02:00","published_at":"2013-10-19T01:13:34+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":242977,"translations":{"de":{"name":"Bruxella 1238","address_street_name":"Rue de la Bourse","address_street_number":null,"address_street_box":null,"email":"contact@boursebeurs.be","website":"https:\/\/www.boursebeurs.be\/fr\/bruxella-1238","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Bourse","address_line2":"1000 Bruxelles","description_web":"Am Fu\u00dfe der Br\u00fcsseler B\u00f6rse verbirgt sich eine kleine, aber ganz erstaunliche arch\u00e4ologische St\u00e4tte, die auch f\u00fcr die \u00d6ffentlichkeit zug\u00e4nglich ist. Es handelt sich um die Ruinen des Franziskanerordens, der in Br\u00fcssel ab 1238 erbaut wurde. Hier befindet sich auch das Grab des Herzogs Johann I. von Brabant. Das Fundament und verschiedene andere \u00dcberreste geben einen faszinierenden Einblick in einen weniger bekannten Teil der Br\u00fcsseler Stadtgschichte.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Bruxella 1238","address_street_name":"Rue de la Bourse","address_street_number":null,"address_street_box":null,"email":"contact@boursebeurs.be","website":"https:\/\/www.boursebeurs.be\/fr\/bruxella-1238","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Bourse","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Bruxella 1238","address_street_name":"Beursstraat","address_street_number":null,"address_street_box":null,"email":"contact@boursebeurs.be","website":"https:\/\/www.boursebeurs.be\/en\/bruxella-1238","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Beursstraat","address_line2":"1000 Brussels","description_web":"Next to the stock exchange building, in the heart of Brussels, is a fascinating little archaeological site.  It contains the remains of the Franciscan monastery founded in Brussels in 1238 and the tomb of Duke John I of Brabant.  The foundations and various other objects offer a glimpse of an unknown side of the history of Brussels, and at the same time give a good idea of the different aspects of an archaeological dig.","description_print":null,"booking_url":"https:\/\/www.ticketing.brussels\/en\/tickets\/event-details.Bruxella-1238.4e2fe0b8-72e4-44c0-abcc-d72a3b0c5618","sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Bruxella 1238","address_street_name":"Rue de la Bourse","address_street_number":null,"address_street_box":null,"email":"contact@boursebeurs.be","website":"https:\/\/www.boursebeurs.be\/fr\/bruxella-1238","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Bourse","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Bruxella 1238","address_street_name":"Rue de la Bourse","address_street_number":null,"address_street_box":null,"email":"contact@boursebeurs.be","website":"https:\/\/www.boursebeurs.be\/fr\/bruxella-1238","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Bourse","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Bruxella 1238","address_street_name":"Rue de la Bourse","address_street_number":null,"address_street_box":null,"email":"contact@boursebeurs.be","website":"https:\/\/www.boursebeurs.be\/fr\/bruxella-1238","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Bourse","address_line2":"1000 Bruxelles","description_web":"Au pied de la Bourse, se cache un \u00e9tonnant petit site arch\u00e9ologique ouvert au public, au coeur de Bruxelles, celui-ci pr\u00e9sente les vestiges du Couvent de l'ordre franciscain \u00e9rig\u00e9 \u00e0 Bruxelles d\u00e8s 1238. On y trouve notamment le tombeau du Duc Jean Ier de Brabant. Les fondations et un mat\u00e9riel diversifi\u00e9 permettent de faire revivre un pan m\u00e9connu de l'histoire de Bruxelles, tout en laissant percevoir diff\u00e9rents aspects de la r\u00e9alit\u00e9 du m\u00e9tier d'arch\u00e9ologue.","description_print":null,"booking_url":"https:\/\/www.ticketing.brussels\/fr\/tickets\/event-details.Bruxella-1238.4e2fe0b8-72e4-44c0-abcc-d72a3b0c5618","sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Bruxella 1238","address_street_name":"Rue de la Bourse","address_street_number":null,"address_street_box":null,"email":"contact@boursebeurs.be","website":"https:\/\/www.boursebeurs.be\/fr\/bruxella-1238","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Bourse","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Bruxella 1238","address_street_name":"Beursstraat","address_street_number":null,"address_street_box":null,"email":"contact@boursebeurs.be","website":"https:\/\/www.boursebeurs.be\/nl\/bruxella-1238","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Beursstraat","address_line2":"1000 Brussel","description_web":"Aan de voet van de Beurs verbergt er zich een fascinerende archeologische site in het centrum van Brussel die de bezoekers een kijk geeft op de resten van het franciscaans klooster dat in Brussel vanaf 1238 werd opgericht. We vinden er ondermeer het graf van Hertog Jan I van Brabant. De funderingen en allerlei ander materiaal laten ons toe om een ongekend stukje uit de geschiedenis van Brussel te laten herleven en ons tegelijkertijd een goed beeld te geven van de verschillende aspecten van het beroep van archeoloog.","description_print":null,"booking_url":"https:\/\/www.ticketing.brussels\/nl\/tickets\/event-details.Bruxella-1238.4e2fe0b8-72e4-44c0-abcc-d72a3b0c5618","sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":5373,"location":{"lat":50.8480633,"lon":4.3508541},"last_updated_at":"2024-09-11T10:29:20+02:00","published_at":"2013-10-19T01:18:35+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/c07894a065195631513fb7622c8dfd5b3ef8cfdf.png",