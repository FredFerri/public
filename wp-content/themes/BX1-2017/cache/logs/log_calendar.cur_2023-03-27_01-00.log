light"],"nl":["Highlight"],"en":["Highlight"],"de":["Highlight"],"it":["Highlight"],"sp":["Highlight"],"pt":[null],"cn":[null]}},"tags":["kids","annee_art_nouveau"],"is_part_of":"Ann\u00e9e Art Nouveau","accessibilities":{"list":[252,257,259,263],"translations":{"fr":["Accessible aux personnes ayant des difficult\u00e9s de compr\u00e9hension","Am\u00e9nagements pour personnes sourdes et malentendantes","Chien d'assistance","Accessible aux pi\u00e9tons appareill\u00e9s"],"nl":["Toegankelijk voor mensen met een verstandelijke beperking","Voorzieningen voor dove en slechthorende personen","Assistentiehonden","Toegankelijk voor voetgangers met hulpmiddelen"],"en":["Accessible to people with intellectual disabilities","Facilities for deaf and hearing-impaired people","Assistance dogs","Accessible to pedestrians with mobility aids"],"de":["Barrierefrei f\u00fcr Menschen mit Verst\u00e4ndnisschwierigkeiten","Anpassungen f\u00fcr geh\u00f6rlose und h\u00f6rgesch\u00e4digte Menschen.","Assistenzhund","Barrierefrei f\u00fcr Fu\u00dfg\u00e4nger mit Gehhilfe"],"it":["Accessibile alle persone con difficolt\u00e0 di comprensione","Disposizioni per persone non udenti e ipoudenti","Cane guida","Accessibile ai pedoni con supporti"],"sp":["Habilitado para personas con dificultades de comprensi\u00f3n","Equipos para personas sordas y con problemas de audici\u00f3n","Perros gu\u00eda","Habilitado para peatones con aud\u00edfonos"],"pt":[null,null,null,null],"cn":[null,null,null,null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2023-03-26T03:35:15+02:00","published_at":"2022-09-30T15:50:42+02:00","backoffice_id":262867,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.23404631038832},{"id":545340,"date_start":"2022-11-18","date_end":"2023-05-01","date_next":"2023-03-26","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung","it":"Esposizioni","sp":"Exhibici\u00f3n","pt":null,"cn":null}},"others":{"list":[36,42],"translations":{"fr":["Mus\u00e9es et art centers","Peinture"],"nl":["Musea en kunstcentra","Schilderkunst"],"en":["Museums and art centers","Painting"],"de":["Museen & Kunstzentren","Malerei"],"it":["Musei e centri artistici","Pittura"],"sp":["Museos y centros de arte","Pintura"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Le Canal d'Obolensky","shortdescr":"La Fonderie vous invite pour une promenade immersive \u00e0 la (re)d\u00e9couverte du canal de Bruxelles, d\u00e9peint par un artiste phare de la sc\u00e8ne belge : Alexandre Obolensky. Une invitation \u00e0 prendre un temps d\u2019arr\u00eat, \u00e0 la fl\u00e2nerie et \u00e0 la contemplation.","longdescr":"La fonderie a le plaisir de vous annoncer l\u2019ouverture de sa nouvelle exposition \u00e9v\u00e9nement \u00ab Le Canal d\u2019Obolensky \u00bb du 18 novembre 2022 jusqu\u2019au 1er Mai 2023. Nous invitons nos publics pour une promenade immersive \u00e0 la (re)d\u00e9couverte du canal de Bruxelles, d\u00e9peint par un artiste phare de la sc\u00e8ne belge : Alexandre Obolensky. Une invitation \u00e0 prendre un temps d\u2019arr\u00eat, \u00e0 la fl\u00e2nerie et \u00e0 la contemplation.\r\n\r\nConnu comme peintre de d\u00e9cors de th\u00e9\u00e2tre, op\u00e9ra, ballet et exposition, Alexandre Obolensky (Bruxelles, 1952-2018) a \u00e9galement d\u00e9velopp\u00e9 une \u0153uvre personnelle autour du canal de Bruxelles.  \r\n\r\nL\u2019exposition invite \u00e0 une balade sensible et contemplative, \u00e0 la d\u00e9couverte d\u2019une s\u00e9rie de peintures troublantes par leur r\u00e9alisme, qui nous exposent un canal pluriel capt\u00e9 par l\u2019\u0153il de l\u2019artiste et interpr\u00e9t\u00e9 selon sa technique picturale. Au fil des lumi\u00e8res et des paysages, le canal se m\u00e9tamorphose. Les \u0153uvres sont des appels \u00e0 s\u2019arr\u00eater, \u00e0 observer et \u00e0 questionner notre regard, notre perception de ce canal inscrit dans le paysage bruxellois, mais encore souvent m\u00e9connu.  \r\n\r\nAu travers du regard de l\u2019artiste, cette promenade libre invite aussi \u00e0 la d\u00e9couverte de son processus du cr\u00e9ation. Photographier puis d\u00e9-photographier par la peinture, telle \u00e9tait la mani\u00e8re de proc\u00e9der d\u2019Obolensky. Du choix de l\u2019angle de vue \u00e0 la transposition picturale par le quadrillage, l\u2019exposition fait d\u00e9couvrir les diff\u00e9rentes \u00e9tapes d\u2019une technique pr\u00e9cise et rigoureuse. \r\n\r\nL\u2019exposition s\u2019adresse \u00e0 un large public, aux amateurs d\u2019art comme aux observateurs curieux, petits et grands, gr\u00e2ce \u00e0 l\u2019int\u00e9gration de dispositifs interactifs dans le parcours du visiteur. \r\n\r\nUn catalogue de l\u2019exposition est \u00e9galement propos\u00e9 pour poursuivre la balade de chez soi ou dans les pas de l\u2019artiste le long du canal.  \r\n\r\nPour ceux qui veulent en savoir plus sur l\u2019artiste est \u00e9galement disponible l\u2019ouvrage Alexandre Obolensky, r\u00e9trospective sur sa carri\u00e8re de peintre de d\u00e9cors et sur son travail personnel. Illustr\u00e9 de nombreuses photographies et accompagn\u00e9 de t\u00e9moignages d\u2019observateurs et de collaborateurs privil\u00e9gi\u00e9s, il retrace une vie de peinture, un m\u00e9tier unique et particulier entre op\u00e9ras, th\u00e9\u00e2tres, grandes expositions et travail intime.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.lafonderie.be","email":"info@lafonderie.be","phone_contact":"+32 2 410 99 50","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.545340"},"nl":{"name":"Het Kanaal van Obolensky","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lafonderie.be","email":"info@lafonderie.be","phone_contact":"+32 2 410 99 50","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.545340"},"en":{"name":"Le Canal d'Obolensky","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lafonderie.be","email":"info@lafonderie.be","phone_contact":"+32 2 410 99 50","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.545340"},"de":{"name":"Le Canal d'Obolensky","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lafonderie.be","email":"info@lafonderie.be","phone_contact":"+32 2 410 99 50","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.545340"},"it":{"name":"Le Canal d'Obolensky","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lafonderie.be","email":"info@lafonderie.be","phone_contact":"+32 2 410 99 50","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.545340"},"sp":{"name":"Le Canal d'Obolensky","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lafonderie.be","email":"info@lafonderie.be","phone_contact":"+32 2 410 99 50","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.545340"},"pt":{"name":"Le Canal d'Obolensky","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lafonderie.be","email":"info@lafonderie.be","phone_contact":"+32 2 410 99 50","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.545340"},"cn":{"name":"Le Canal d'Obolensky","shortdescr":null,"longde