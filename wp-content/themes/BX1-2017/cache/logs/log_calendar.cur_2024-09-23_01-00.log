role.be\/produit\/creatures\/","email":"info@theatredelaparole.be","phone_contact":"+32 2 736 69 50","phone_booking":"+32 2 736 69 50","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700000839"},"it":{"name":"Cr\u00e9atures","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatredelaparole.be\/produit\/creatures\/","email":"info@theatredelaparole.be","phone_contact":"+32 2 736 69 50","phone_booking":"+32 2 736 69 50","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700000839"},"cn":{"name":"Cr\u00e9atures","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatredelaparole.be\/produit\/creatures\/","email":"info@theatredelaparole.be","phone_contact":"+32 2 736 69 50","phone_booking":"+32 2 736 69 50","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700000839"},"fr":{"name":"Cr\u00e9atures","shortdescr":"Un conte gestuel et musical, post-binaire et merveilleux o\u00f9 paroles et violoncelle s\u2019entrem\u00ealent, o\u00f9 les monstres ne sont pas celleux qu\u2019on croit et o\u00f9 l\u2019adelphit\u00e9 est reine.\n\u00ab cr\u00e9atures \u00bb est une \u0153uvre collaboratrice, cr\u00e9\u00e9e avec une attention \u00e0 ne pas reproduire les rapports de dominations quels qu\u2019ils soient, tout en gardant la dimension merveilleuse.\n","longdescr":"Un royaume.\nDeux naissances, gr\u00e2ce \u00e0 une cr\u00e9ature marine qui a offert son coeur.\nDeux vies, une ligne commune, puis une marque ind\u00e9l\u00e9bile qui changera tout.\nDes rencontres merveilleuses, hypnotisantes et effrayantes.\nEt pour chaque personnage, une fin pas classique.\nC\u2019est l\u2019histoire d\u2019un roi, qui peine sous l\u2019h\u00e9ritage de ses anc\u00eatres.\nC\u2019est l\u2019histoire d\u2019une reine qui d\u00e9couvre qu\u2019\u00eatre m\u00e8re ne lui suffit pas.\nC\u2019est l\u2019histoire d\u2019une dame qui sait.\nC\u2019est l\u2019histoire d\u2019une servante qui n\u2019en a jamais \u00e9t\u00e9 une.\nC\u2019est l\u2019histoire d\u2019un.e monstre.sse qui sait bien ce que son coeur permettra.\nC\u2019est l\u2019histoire de jumeauxjumelles qui ne choisiront pas entre il et elle.\nC\u2019est l\u2019histoire d\u2019un chiot n\u00e9 d\u2019un chien enceint.\nC\u2019est l\u2019histoire d\u2019une source magique qui dit la v\u00e9rit\u00e9.\nC\u2019est l\u2019histoire d\u2019une princesse qui voulait vivre avec sa dragonne.\nC\u2019est l\u2019histoire d\u2019un roi qui boit.\nC\u2019est l\u2019histoire d\u2019une biche sans qui la renaissance n\u2019aurait pas lieu.\nC\u2019est l\u2019histoire de deux \u00eatres finalement diff\u00e9rents et li\u00e9s pour l\u2019\u00e9ternit\u00e9.\nDans ce conte merveilleux revisit\u00e9 depuis la renaissance italienne, les monstres ne sont pas celleux qu\u2019on croit, l\u2019adelphit\u00e9 est reine, le violoncelle conte et les mots chantent.","performers":"Ecriture et jeu : \u00e9criture et oralit\u00e9, interpr\u00e9tation Julie Boitte \/Musicien : composition et interpr\u00e9tation Corentin Dellicour\/ Aide \u00e0 l\u2019\u00e9criture, Dessin du fond de sc\u00e8ne et graphisme : Camille Pier\/ Mise en sc\u00e8ne : \n","boxoffice_url":null,"website":"https:\/\/www.theatredelaparole.be\/produit\/creatures\/","email":"info@theatredelaparole.be","phone_contact":"+32 2 736 69 50","phone_booking":"+32 2 736 69 50","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700000839"},"sp":{"name":"Cr\u00e9atures","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatredelaparole.be\/produit\/creatures\/","email":"info@theatredelaparole.be","phone_contact":"+32 2 736 69 50","phone_booking":"+32 2 736 69 50","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700000839"},"nl":{"name":"Cr\u00e9atures","shortdescr":null,"longdescr":null,"performers"