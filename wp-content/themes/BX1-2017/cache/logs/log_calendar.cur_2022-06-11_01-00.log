st toilet"],"en":["Accessible to people with intellectual disabilities","Accessible","Facilities for blind and partially-sighted persons","Accessible to pedestrians with mobility aids","Adapted toilet"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-05-23T10:35:05+02:00","published_at":"2022-04-20T16:03:02+02:00","backoffice_id":252272,"import_origin":null,"sub_type":"festival","show_in_agenda":true,"ranking":1.2599210498949},{"id":535497,"date_start":"2022-06-17","date_end":"2022-09-05","date_next":"2022-06-17","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":true,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[36,43],"translations":{"fr":["Mus\u00e9es et art centers","Arts D\u00e9coratifs"],"nl":["Musea en kunstcentra","Decoratieve kunsten"],"en":["Museums and art centers","Decorative art"]}}},"languages":{"spoken":["fr","en","es"],"subtitles":[]},"translations":{"fr":{"name":"Intimate Metaphysics","shortdescr":"Nous sommes plus que ravis de vous pr\u00e9senter le SOLO SHOW de l'artiste italien Edo Piantadosi.\r\n\r\n\u00ab Intimate Metaphysics \u00bb est une enqu\u00eate photographique po\u00e9tique et m\u00e9taphysique sur les formes de l'eau.\r\n\"Intimate Metaphysics\" is a poetic and metaphysical photographic investigation about water shapes.","longdescr":"Chers amis, nous sommes plus que ravis de vous pr\u00e9senter le SOLO SHOW de l'artiste italien Edo Piantadosi.\r\n\r\n\u00ab Intimate Metaphysics \u00bb est une enqu\u00eate photographique po\u00e9tique et m\u00e9taphysique sur les formes de l'eau.\r\nDes exp\u00e9riences visuelles uniques de moments qui ne se r\u00e9p\u00e8tent jamais...\r\n\r\nPiantadosi pr\u00e9sente le r\u00e9sultat de plus de quinze ans d'investigation et d'exploration de l'eau sous toutes ses formes, \u00e9tudiant sa gen\u00e8se et sa nature physique, la ramenant \u00e0 son essence dans ses images et les sortant de leur contexte pour les rendre abstraites.\r\n\r\nNous serons ravis de votre visite.","performers":"Edo Piantadosi, photographe italien","boxoffice_url":null,"website":"http:\/\/www.noonconsulting.art\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/535497.html"},"nl":{"name":"Intimate Metaphysics","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/535497.html"},"en":{"name":"Intimate Metaphysics","shortdescr":"We are more than\u00a0glad to present you the SOLO SHOW of the Italian artist Edo Piantadosi.\r\n\r\n\"Intimate Metaphysics\" is a poetic and metaphysical photographic investigation about water shapes.","longdescr":"Dear friends, we are more than\u00a0glad to present you the SOLO SHOW of the Italian artist Edo Piantadosi.\r\n\r\n\"Intimate Metaphysics\" is a poetic and metaphysical photographic investigation about water shapes.\r\nUnique visual experiences of moments that are never repeated...\r\n\r\nPiantadosi presents the result of more than fifteen years of investigation and exploration of the water in all its forms, studying its genesis and physical nature, stripping it back to its essence in his images and removing them\u00a0from their context to make them seem abstract.\r\n\r\nWe will be delighted to have your visit.","performers":"Edo Piantadosi, Italian Photographer","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/535497.html"},"de":{"name":"Intimate Metaphysics","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"w