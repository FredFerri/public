b_type":"festival","ranking":1.2599210498948732,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":118,"translations":{"de":"Festival","pt":null,"en":"Festival","it":"Festival","cn":null,"fr":"Festival","sp":"Festival","nl":"Festival"}},"others":{}},"translations":{"de":{"name":"Les Equinoxes Festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/equinoxesfestival.be\/fr\/","email":"info@equinoxesfestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700005828"},"pt":{"name":"Les Equinoxes Festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/equinoxesfestival.be\/fr\/","email":"info@equinoxesfestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700005828"},"en":{"name":"Les Equinoxes Festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/equinoxesfestival.be\/fr\/","email":"info@equinoxesfestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700005828"},"it":{"name":"Les Equinoxes Festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/equinoxesfestival.be\/fr\/","email":"info@equinoxesfestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700005828"},"cn":{"name":"Les Equinoxes Festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/equinoxesfestival.be\/fr\/","email":"info@equinoxesfestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700005828"},"fr":{"name":"Les Equinoxes Festival","shortdescr":"Le samedi 22 mars 2025 de 11:30 \u00e0 02:00 , Les \u00c9quinoxes Festival investit La Tricoterie pour une journ\u00e9e engag\u00e9e et festive. Ce festival met en avant le f\u00e9minisme, l\u2019inclusivit\u00e9, la durabilit\u00e9 et l\u2019accessibilit\u00e9 \u00e0 travers des concerts, animations interactives et un podcast en direct. Avec un tarif conscient, il accueille tou\u00b7te\u00b7s dans une ambiance conviviale pour c\u00e9l\u00e9brer l\u2019\u00e9quinoxe de printemps.","longdescr":"Le Festival Les \u00c9quinoxes 2025, pr\u00e9vu le 22 mars \u00e0 La Tricoterie \u00e0 Bruxelles, propose une programmation riche et diversifi\u00e9e. L'\u00e9v\u00e9nement d\u00e9butera \u00e0 midi avec un enregistrement en direct du podcast \"Sororit\u00e9s\" de Rokia Bamba, accueillant les invit\u00e9es sp\u00e9ciales Rokhaya Diallo et Sarah L\u00e9l\u00e9 pour une discussion sur leurs parcours et l'afrof\u00e9minisme. Ensuite, les drag queens Edna Sorgelsen et Susan from Grindr offriront une lecture de contes pour enfants et adolescents, abordant des th\u00e8mes tels que l'identit\u00e9, la famille et l'amour, dans une ambiance bienveillante. La journ\u00e9e se poursuivra avec des performances musicales, notamment du groupe Turkish Kebap, qui fusionne des influences de la musique turque psych\u00e9d\u00e9lique des ann\u00e9es 70 avec des sonorit\u00e9s contemporaines. L'humoriste Sarah L\u00e9l\u00e9, d'origine camerounaise, pr\u00e9sentera \u00e9galement son stand-up incisif, explorant avec humour les questions de race, de culture et d'identit\u00e9. Enfin, RaQL, une DJ bruxelloise aux influences afro-lusophones, m\u00ealant rythmes tropicaux et sonorit\u00e9s \u00e9lectroniques, cl\u00f4turera la soir\u00e9e. Le festival met un point d'honneur \u00e0 l'inclusivit\u00e9, \u00e0 l'accessibilit\u00e9 et \u00e0 la durabilit\u00e9, offrant une plateforme aux femmes artistes et aux minorit\u00e9s de genre.","performers":null,"boxoffice_url":null,"website":"https:\/\/equinoxesfestival.be\/fr\/","email":"info@equinoxesfestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700005828"},"sp":{"name":"Les Equinoxes Festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/equinoxesfestival.be\/fr\/","email":"info@equinoxesfestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700005828"},"nl":{"name":"Les Equinoxes Festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/equinoxesfestival.be\/fr\/","email":"info@equinoxesfestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700005828"}},"place":{"id":252101,"translations":{"de":{"name":"La Tricoterie","address_street_name":"Rue Th\u00e9odore Verhaegen","address_street_number":"158","address_street_box":null,"email":"charlotte@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+ 32 (0)2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Th\u00e9odore Verhaegen, 158","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"La Tricoterie - Fabrique de liens","address_street_name":"Rue Th\u00e9odore Verhaegen","address_street_number":"158","address_street_box":null,"email":"charlotte@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+ 32 (0)2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Th\u00e9odore Verhaegen, 158","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"La Tricoterie - Link factory","address_street_name":"Rue Th\u00e9odore Verhaegen","address_street_number":"158","address_street_box":null,"email":"charlotte@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+ 32 (0)2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Th\u00e9odore Verhaegen, 158","address_line2":"1060 Saint-Gilles","description_web":"La Tricoterie is above all a civil, cultural, sustainable and innovative project. Their cultural programme featuring performances, shows, exhibitions and so on goes hand in hand with a \u201ccivil\u201d programme of debates, conferences, inter-generational workshops, philosophical caf\u00e9 etc ... The place can be rented for events and there are plenty of really great parties! ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"La Tricoterie","address_street_name":"Rue Th\u00e9odore Verhaegen","address_street_number":"158","address_street_box":null,"email":"charlotte@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+ 32 (0)2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Th\u00e9odore Verhaegen, 158","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"La Tricoterie - Fabrique de liens","address_street_name":"Rue Th\u00e9odore Verhaegen","address_street_number":"158","address_street_box":null,"email":"charlotte@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+ 32 (0)2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Th\u00e9odore Verhaegen, 158","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"La Tricoterie - Fabrique de liens","address_street_name":"Rue Th\u00e9odore Verhaegen","address_street_number":"158","address_street_box":null,"email":"charlotte@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+ 32 (0)2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Th\u00e9odore Verhaegen, 158","address_line2":"1060 Saint-Gilles","description_web":"La Tricoterie est un projet culturel fond\u00e9 en 2010 par une poign\u00e9e de citoyen\u00b7nes et situ\u00e9 dans une ancienne usine restaur\u00e9e avec des mat\u00e9riaux \u00e9cologiques. La Tricoterie propose une programmation culturelle tr\u00e8s diversifi\u00e9e et centr\u00e9e sur la rencontre entre les diff\u00e9rents publics et le m\u00e9lange des activit\u00e9s culturelles.\r\n\r\nPassez la porte et d\u00e9couvrez :\r\n- Des spectacles de th\u00e9\u00e2tre, de danse, de cirque...\r\n- Des concerts, des soir\u00e9es, des sc\u00e8nes ouvertes, des jam sessions, une chorale d'un soir...\r\n- Des ateliers z\u00e9ro d\u00e9chet, peinture, c\u00e9ramique, \u0153nologie, danse...\r\n- Des projections de films, conf\u00e9rences, d\u00e9bats...\r\n- Des couscous \"s\u00e9pharabes\", des soir\u00e9es jeux de soci\u00e9t\u00e9, des activit\u00e9s pour enfants...\r\n- Des march\u00e9s des cr\u00e9ateur\u00b7rices, des vide-dressings, des march\u00e9s de No\u00ebl durables...\r\n\r\nUn petit creux ? La Triciterie vous propose un brunch tous les dimanches et un concept \"live cooking\" tous les vendredis soirs. Tous les plats sont 100% artisanaux, et pr\u00e9par\u00e9s sur place par l'\u00e9quipe avec des ingr\u00e9dients bio, locaux et de saison.\r\n\r\nEnvie d'organiser votre \u00e9v\u00e9nement chez vous ? La Tricoterie met ses salles \u00e0 disposition pour tout type d'\u00e9v\u00e9nement priv\u00e9 ou professionnel et propose \u00e9galement un service traiteur, que ce soit dans ses murs ou \u00e0 l'ext\u00e9rieur. Rendez-vous sur www.tricoterie.be pour en savoir plus !\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"La Tricoterie","address_street_name":"Rue Th\u00e9odore Verhaegen","address_street_number":"158","address_street_box":null,"email":"charlotte@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+ 32 (0)2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Th\u00e9odore Verhaegen, 158","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"La Tricoterie - Contactenfabriek","address_street_name":"Th\u00e9odore Verhaegenstraat","address_street_number":"158","address_street_box":null,"email":"charlotte@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+ 32 (0)2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Sint-Gillis","address_line1":"Th\u00e9odore Verhaegenstraat, 158","address_line2":"1060 Sint-Gillis","description_web":"La Tricoterie is een project met een welomlijnde filosofie, die blijkt uit de zelfgekozen naam (van tricoter, breien) waarmee verwijst wordt naar het smeden van banden om de strijd tegen de ontrafeling van het sociale weefsel aan te gaan. Opgezet als een \u00abContacten Fabriek\u00bb en een ontmoetingsplaats waar verschillende disciplines en publieken elkaar ontmoeten. Naast een culturele programmering (concerten, voorstellingen, expos\u2026) en socioculturele activiteiten die sociale cohesie beogen (debatten, conferenties, intergenerationele ateliers, caf\u00e9-filo\u2026) staan de ruimtes ook open voor verhuur aan externe organisaties en bedrijven. Tal van superleuke feestjes vinden er plaats, alsook een wekelijkse biomarkt, een repaircaf\u00e9 en een alternatieve geschenkenmarkt om maar enkele van de activiteiten te noemen die de duurzame levensvisie van de plek weerspiegelen.","description_print":null,"booking_url":