],"date_exceptions":[],"closing_days":[],"child_events":[],"parent_events":[],"accessibilities":[],"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[]},{"id":5700002958,"date_start":"2024-11-22","date_end":"2024-11-24","date_next":"2024-11-22","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-11-13T18:07:05+01:00","published_at":"2024-10-24T12:52:11+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":310424,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"theatre","ranking":0.8735804647362989,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":49,"translations":{"de":"Theater","pt":null,"en":"Theatre","it":"Teatro","cn":null,"fr":"Th\u00e9\u00e2tre","sp":"Teatro","nl":"Theater"}},"others":{}},"translations":{"de":{"name":"Qui a tu\u00e9 Patrice Lumumba ?","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.magicland-theatre.com","email":"johanne@magicland-theatre.com","phone_contact":"+32 495 26 18 71","phone_booking":"+32 495 26 18 71","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700002958"},"pt":{"name":"Qui a tu\u00e9 Patrice Lumumba ?","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.magicland-theatre.com","email":"johanne@magicland-theatre.com","phone_contact":"+32 495 26 18 71","phone_booking":"+32 495 26 18 71","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700002958"},"en":{"name":"Qui a tu\u00e9 Patrice Lumumba ?","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.magicland-theatre.com","email":"johanne@magicland-theatre.com","phone_contact":"+32 495 26 18 71","phone_booking":"+32 495 26 18 71","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700002958"},"it":{"name":"Qui a tu\u00e9 Patrice Lumumba ?","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.magicland-theatre.com","email":"johanne@magicland-theatre.com","phone_contact":"+32 495 26 18 71","phone_booking":"+32 495 26 18 71","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700002958"},"cn":{"name":"Qui a tu\u00e9 Patrice Lumumba ?","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.magicland-theatre.com","email":"johanne@magicland-theatre.com","phone_contact":"+32 495 26 18 71","phone_booking":"+32 495 26 18 71","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700002958"},"fr":{"name":"Qui a tu\u00e9 Patrice Lumumba ?","shortdescr":null,"longdescr":"Une cr\u00e9ation de la Clinique juridique Rosa Parks pour les droits humains et du Magic land th\u00e9\u00e2tre\nAvec le soutien du Fonds recherche-cr\u00e9ation de l\u2019UCLouvain culture \n \nQui a tu\u00e9 Patrice Lumumba ? est une pi\u00e8ce de th\u00e9\u00e2tre qui met en sc\u00e8ne un jury d\u2019assises fictif charg\u00e9 de faire le point sur les responsabilit\u00e9s dans l\u2019assassinat de Patrice Lumumba. Et aborder cette question juridique est une opportunit\u00e9 pour raconter et questionner l\u2019Histoire coloniale de la Belgique au Congo.\n\nC\u2019est un projet artistique et p\u00e9dagogique qui s\u2019inscrit au c\u0153ur du travail de la Clinique juridique Rosa Parks pour les droits humains.\n\nCe sont ainsi les \u00e9tudiant\u00b7es de Master en droit de l\u2019UCLouvain qui ont r\u00e9alis\u00e9 les recherches n\u00e9cessaires \u00e0 l\u2019\u00e9criture du texte th\u00e9\u00e2tral et ce sont eux et elles qui assurent en partie la promotion du spectacle.\n \nPour ce faire, ils et elles sont all\u00e9.e.s \u00e0 la rencontre des chercheur\u00b7ses et sp\u00e9cialistes des diff\u00e9rents domaines : historien\u00b7nes, juristes, sp\u00e9cialistes des relations Belgique- RDC, \u00e9conomistes\u2026 ainsi que les diff\u00e9rentes associations qui \u0153uvrent en mati\u00e8re de d\u00e9colonisation.\n \nLe texte a ensuite \u00e9t\u00e9 \u00e9crit par Claire-Marie Lievens. L\u2019objet final est un spectacle d\u2019une heure trente sous forme d\u2019un jury d\u2019assises ; le ton est r\u00e9aliste, concret et parfois teint\u00e9 d\u2019humour. Il s \u2018agit donc d\u2019un spectacle tout public (et d\u2019utilit\u00e9 publique !), compr\u00e9hensible par toutes et tous. La richesse des dialogues humains entre douze personnes d\u2019horizons diff\u00e9rents permet en effet d\u2019aborder l\u2019histoire coloniale (et l\u2019assassinat de Patrice Lumumba) en faisant apparaitre une multiplicit\u00e9 de points de vue, et d\u2019\u0153uvrer par l\u00e0 m\u00eame pour une soci\u00e9t\u00e9 plus \u00e9galitaire, moins discriminante, plus juste.\n \nConna\u00eetre son Histoire pour ne pas r\u00e9p\u00e9ter les erreurs du pass\u00e9, \nComprendre et avancer,\npour que demain soit plus juste, plus lumineux.\n \nEcriture (et coordination du projet) : Claire-Marie Lievens\nMise en sc\u00e8ne et sc\u00e9nographie : Claire-Marie Lievens et Patrick Chaboud\nAssistanat : Clara Huwart\n \nSur une initiative de Cyril Wintjens. \nDistribution :\n\nNoel Yerl\u00e8s, Alain Geerinckx, Mpela Biembongo, Rapha\u00ebl Van Steenberghe, Hoonaz Ghojallu, Uriel Abogso, Elisabeth De Schutter, Hinde Louati, Ben Kamuntu, Jessica Fanhan, Clara Huwart et Palmina Da Siena. \n \nComit\u00e9 de lecture et de recherche :\nSylvie Sarolea, Rapha\u00ebl Van Steenberghe, Uriel Abogso, Elisabeth De Schutter, Ange-Marie Nguadi Pombo, Cyril Wintjens, Patient Muhri et Olivier Shukuru de l\u2019Universit\u00e9 de Bukavu (RDC), Cherif Diallo, Oumar Diallo, Nyemba Godlive, Victoria Vandermeersch pour le Placet, B\u00e9reng\u00e8re Piret, Olivier Luminet, Jacques Mbokani, Christian Chiza et Bernard Mouffe.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.magicland-theatre.com","email":"johanne@magicland-theatre.com","phone_contact":"+32 495 26 18 71","phone_booking":"+32 495 26 18 71","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700002958"},"sp":{"name":"Qui a tu\u00e9 Patrice Lumumba ?","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.magicland-theatre.com","email":"johanne@magicland-theatre.com","phone_contact":"+32 495 26 18 71","phone_booking":"+32 495 26 18 71","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700002958"},"nl":{"name":"Qui a tu\u00e9 Patrice Lumumba ?","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.magicland-theatre.com","email":"johanne@magicland-theatre.com","phone_contact":"+32 495 26 18 71","phone_booking":"+32 495 26 18 71","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700002958"}},"place":{"id":224842,"translations":{"de":{"name":"Magic Land Th\u00e9\u00e2tre","address_street_name":"Rue d'Hoogvorst","address_street_number":"8-14","address_street_box":null,"email":"info@magicland-theatre.com","website":"http:\/\/www.magicland-theatre.com","phone_contact":"+32 2 245 50 64","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Rue d'Hoogvorst, 8-14","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Magic Land Th\u00e9\u00e2tre","address_street_name":"Rue d'Hoogvorst","address_street_number":"8-14","address_street_box":null,"email":"info@magicland-theatre.com","website":"http:\/\/www.magicland-theatre.com","phone_contact":"+32 2 245 50 64","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Rue d'Hoogvorst, 8-14","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Magic Land Th\u00e9\u00e2tre","address_street_name":"Rue d'Hoogvorst","address_street_number":"8-14","address_street_box":null,"email":"info@magicland-theatre.com","website":"http:\/\/www.magicland-theatre.com","phone_contact":"+32 2 245 50 64","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Rue d'Hoogvorst, 8-14","address_line2":"1030 Schaerbeek","description_web":"The Magic Land Th\u00e9\u00e2tre was born out of a collective dream in the 1970s. It now has its\r\nactive, around fifty creations, several international tours and participation regular at most major Belgian cultural events. His multiple exp\u00e9riences artistic works carried out on so many fronts have allowed him to forge a style so particular, far removed off the beaten track of classical theater. If we had to classify the \"Magic land\" in a category \" popular theater \"is undoubtedly the adjective which would suit best even if Patrick Chaboud its founder prefers to speak of a theater of exchanges, meetings, surprises, debates, emotions and forcing anger sometimes too. At the Magic land theater, the scenic barriers conventional have long since been abolished in order to build bridges between genders, heater, dance, music, circus, humor. The Magic Land Theater is ultimately, above all, a living theater, a theater in perpetual \"reinvention\" to better ward off ideas black.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Magic Land Th\u00e9\u00e2tre","address_street_name":"Rue d'Hoogvorst","address_street_number":"8-14