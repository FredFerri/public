u au sein d\u2019un quartier m\u00e9ritant le d\u00e9tour.\nDurant cette visite, l\u2019ARAU vous invite \u00e0 d\u00e9couvrir lamaison Durieu de l\u2019architecte Jacques Dupuis !","performers":null,"boxoffice_url":null,"website":"http:\/\/www.arau.org","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/530999.html"},"nl":{"name":"Une maison bruxelloise : la maison Durieu","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.arau.org","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/530999.html"},"en":{"name":"Une maison bruxelloise : la maison Durieu","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.arau.org","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/530999.html"},"de":{"name":"Une maison bruxelloise : la maison Durieu","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/530999.html"},"it":{"name":"Une maison bruxelloise : la maison Durieu","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/530999.html"},"sp":{"name":"Une maison bruxelloise : la maison Durieu","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/530999.html"},"pt":{"name":"Une maison bruxelloise : la maison Durieu","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_b