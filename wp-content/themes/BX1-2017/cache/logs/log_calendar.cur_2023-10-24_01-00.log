tdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/accjm.be\/","email":"jp.brouhon@brutele.be","phone_contact":"+32 2 230 62 71","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.557354"},"pt":{"name":"Ballon Rouge","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/accjm.be\/","email":"jp.brouhon@brutele.be","phone_contact":"+32 2 230 62 71","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.557354"},"en":{"name":"Red Balloon","shortdescr":"Special action conducted by shops decorated with red balloons in the European Quarter Jean Monnet","longdescr":"Every second Tuesday of the month (except August), the shops in the European quarter take part in the \"Red Balloon\" activity organized by the ACCJM by offering a unique surprise to their clients. Imagine a prize discount, a tapas or wine tasting, a raffle prize, an umbrella, chocolates...and so much more! To not miss this opportunity, look for the red balloons decorating the storefronts of the participating shops. At the end of the day, these balloons will be released, providing the finder with a coupon as a gift in each of the participating shops.","performers":"Casa Italiana, Sabores de Espa\u00f1a, Th\u00e9 14, Centho Shop, Le Coin du Diable, Brasserie Berlaymont, Meet Meat, H\u00f4tel NH Brussels EU Berlaymont, Opticiens Vanderdonckt, Yann Culinary, Ann\u00e9es Lumi\u00e8re, AKT, D\u00e9bora Velasquez, Neuhaus Brussels Schuman, Era Chatelain, James Joyce, Jardin du Sommelier","boxoffice_url":null,"website":"https:\/\/accjm.be\/","email":"jp.brouhon@brutele.be","phone_contact":"+32 2 230 62 71","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.557354"},"it":{"name":"Ballon Rouge","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/accjm.be\/","email":"jp.brouhon@brutele.be","phone_contact":"+32 2 230 62 71","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.557354"},"cn":{"name":"Ballon Rouge","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/accjm.be\/","email":"jp.brouhon@brutele.be","phone_contact":"+32 2 230 62 71","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.557354"},"fr":{"name":"Ballon Rouge","shortdescr":"Action sp\u00e9ciale men\u00e9e par des commerces d\u00e9cor\u00e9s de ballons rouges dans le quartier europ\u00e9en Jean Monnet","longdescr":"Chaque deuxi\u00e8me mardi du mois (sauf en ao\u00fbt), les commerces du quartier europ\u00e9en participent \u00e0 l'action \"Ballon Rouge\" de l'ACCJM en proposant une surprise unique \u00e0 leur client\u00e8le. Imaginez une remise de prix, une d\u00e9gustation de tapas ou de vin, un lot de tombola, un parapluie, des pralines... et bien plus encore ! Pour ne pas manquer cette occasion, cherchez les ballons rouges qui orneront les devantures des commerces participants. En fin de journ\u00e9e, ces ballons seront l\u00e2ch\u00e9s, offrant \u00e0 qui les trouvera un bon pour un cadeau dans chacun des commerces participants.","performers":"Casa Italiana, Sabores de Espa\u00f1a, Th\u00e9 14, Centho Shop, Le Coin du Diable, Brasserie Berlaymont, Meet Meat, H\u00f4tel NH Brussels EU Berlaymont, Opticiens Vanderdonckt, Yann Culinary, Ann\u00e9es Lumi\u00e8re, AKT, D\u00e9bora Velasquez, Neuhaus Brussels Schuman, Era Chatelain, James Joyce, Jardin du Sommelier","boxoffice_url":null,"website":"https:\/\/accjm.be\/","email":"jp.brouhon@brutele.be","phone_contact":"+32 2 230 62 71","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.557354"},"sp":{"name":"Ballon Rouge","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/accjm.be\/","email":"jp.brouhon@brutele.be","phone_contact":"+32 2 230 62 71","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.557354"},"nl":{"name":"Rode Ballon","shortdescr":"Speciale actie uitgevoerd door winkels versierde met rode ballonnen in de Europese wijk Jean Monnet","longdescr":"Elke tweede dinsdag van de maand (behalve in augustus), nemen de winkels van de Europese wijk deel aan de actie \"Rood Ballon\" van ACCJM door een unieke verrassing voor te stellen aan hun cli\u00ebnteel. Stel u voor een prijskorting, een proevertje van tapas of wijn, een tombola lot, een paraplu, pralines,... en nog zo veel meer!  Om deze occasie niet te missen, zoek de rode ballonnen  die de etalages van de deelnemende winkels zullen sieren. Op het einde van de dag, zullen deze ballonnen opgelaten worden, de vinder ervan zal een bon voor een cadeau  aangeboden krijgen in elk van de deelnemende winkels.","performers":"Casa Italiana, Sabores de Espa\u00f1a, Th\u00e9 14, Centho Shop, Le Coin du Diable, Brasserie Berlaymont, Meet Meat, H\u00f4tel NH Brussels EU Berlaymont, Opticiens Vanderdonckt, Yann Culinary, Ann\u00e9es Lumi\u00e8re, AKT, D\u00e9bora Velasquez, Neuhaus Brussels Schuman, Era Chatelain, James Joyce, Jardin du Sommelier","boxoffice_url":null,"website":"https:\/\/accjm.be\/","email":"jp.brouhon@brutele.be","phone_contact":"+32 2 230 62 71","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.557354"}},"place":{"id":274462,"translations":{"de":{"name":"association des commer\u00e7ants du carrefour Jean Monnet","address_street_name":"Rue Archim\u00e8de","address_street_number":"14","address_street_box":null,"email":"jp.brouhon@brutele.be","website":null,"phone_contact":"+32 478 55 04 66","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Archim\u00e8de, 14","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"vir