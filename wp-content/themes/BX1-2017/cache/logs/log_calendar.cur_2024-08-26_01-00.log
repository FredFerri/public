escr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.kunstkot.be\/expo","email":"info@kunstkot.be","phone_contact":"+32 495 79 39 22","phone_booking":"+32 495 79 39 22","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50011551"},"en":{"name":"Photography exhibition Silver\/ Street","shortdescr":"Street Photography Students and Analog Photography Students exhibit their work together. On display all summer in GC Elzenhof, free to visit community center. ","longdescr":"Come and discover the revealing masterpieces of the streets! \n\n\n After intensive training in both street and analog photography over the past three months, our talented students proudly display their most inspiring works.\n\nImmerse yourself in the world of authentic images captured on photographic paper, and experience the power of every click of the shutter. From vivid street scenes to the subtle nuances of analog photography, this exhibition promises a journey through emotion and imagination.\n\n Admission is free to all who share a passion for photography. Come and be enchanted by the creativity of our emerging photographers. We'll see you there!\n\nSLUITINGSDAGEN ZOMERPERIODE \u2022 SUMMER CLOSING DAYS \u2022 JOURS DE FERMETURE ESTIVALE\n11.07 & 12.07        Feest Vlaamse Gemeenschap \n20.07 - 04.08      Zomersluiting\/fermeture estivale\/summer closure\n15.08 & 16.08       Hemelvaart","performers":"Le photographe Sander de Wilde organise une exposition pr\u00e9sentant les travaux de ses \u00e9tudiants en photographie.","boxoffice_url":null,"website":"https:\/\/www.kunstkot.be\/expo","email":"info@kunstkot.be","phone_contact":"+32 495 79 39 22","phone_booking":"+32 495 79 39 22","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50011551"},"it":{"name":"Photography exhibition Silver\/ Street","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.kunstkot.be\/expo","email":"info@kunstkot.be","phone_contact":"+32 495 79 39 22","phone_booking":"+32 495 79 39 22","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50011551"},"cn":{"name":"Photography exhibition Silver\/ Street","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.kunstkot.be\/expo","email":"info@kunstkot.be","phone_contact":"+32 495 79 39 22","phone_booking":"+32 495 79 39 22","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50011551"},"fr":{"name":"Expo Photo Rue\/Argent","shortdescr":"Les \u00e9tudiants en photographie de rue et les \u00e9tudiants en photographie analogique exposent leurs travaux ensemble. Exposition tout l'\u00e9t\u00e9 au GC Elzenhof, centre communautaire dont la visite est gratuite. ","longdescr":"Entrez et d\u00e9couvrez les chefs-d'\u0153uvre r\u00e9v\u00e9lateurs des rues ! \n\n\n Apr\u00e8s une formation intensive \u00e0 la photographie de rue et \u00e0 la photographie analogique au cours des trois derniers mois, nos \u00e9tudiants talentueux exposent fi\u00e8rement leurs \u0153uvres les plus inspirantes.\n\n\n\nPlongez dans le monde des images authentiques captur\u00e9es sur papier photographique et d\u00e9couvrez le pouvoir de chaque clic de l'obturateur. Des sc\u00e8nes de rue saisissantes aux nuances subtiles de la photographie analogique, cette exposition promet un voyage \u00e0 travers l'\u00e9motion et l'imagination.\n\n\n L'entr\u00e9e est gratuite pour tous ceux qui partagent la passion de la photographie. Venez vous laisser s\u00e9duire par la cr\u00e9ativit\u00e9 de nos photographes \u00e9mergents. Nous vous attendons !\n\nSLUITINGSDAGEN ZOMERPERIODE \u2022 SUMMER CLOSING DAYS \u2022 JOURS DE FERMETURE ESTIVALE\n11.07 & 12.07        Feest Vlaamse Gemeenschap \n20.07 - 04.08      Zomersluiting\/fermeture estivale\/summer closure\n15.08 & 16.08       Hemelvaart\n","performers":"Photographer Sander de Wilde hosts an exhibition featuring the work of his photography students","boxoffice_url":null,"website":"https:\/\/www.kunstkot.be\/expo","email":"info@kunstkot.be","phone_contact":"+32 495 79 39 22","phone_booking":"+32 495 79 39 22","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50011551"},"sp":{"name":"Photography exhibition Silver\/ Street","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.kunstkot.be\/expo","email":"info@kunstkot.be","phone_contact":"+32 495 79 39 22","phone_booking":"+32 495 79 39 22","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50011551"},"nl":{"name":"Fotografie expositie Silver\/Street","shortdescr":"De Studenten Straatfotografie \u00e9n de studenten analoge fotografie exposeren samen hun werk. Bijna e hele zomer te bezichtigen in GC Elzenhof, gratis te bezoeken gemeenschapscentrum.      (Zomersluiting 20.07-04.08)","longdescr":"Kom en ontdek de meesterwerken van de studenten fotografie. \n\n Na een intensieve training in zowel straat- als analoge fotografie gedurende de afgelopen drie maanden, tonen onze getalenteerde studenten met trots hun meest inspirerende werken.\n\n\nDompel jezelf onder in de wereld van de fotografie. Van levendige straatsc\u00e8nes tot de subtiele nuances van analoge fotografie, deze tentoonstelling laat je zien welk niveau de studenten in slechts enkele maanden kunnen bereiken.\n\n Toegang is gratis voor iedereen die een passie voor fotografie deelt. Kom en laat je betoveren door de creativiteit van onze opkomende fotografen. We zien je daar!\n\nSLUITINGSDAGEN ZOMERPERIODE \u2022 SUMMER CLOSING DAYS \u2022 JOURS DE FERMETURE ESTIVALE\n11.07 & 12.07        Feest Vlaamse Gemeenschap \n20.07 - 04.08      Zomersluiting\/fermeture estivale\/summer closure\n15.08 & 16.08       Hemelvaart","performers":"Fotograaf Sander de Wilde organiseert een expositie met het werk van zijn studenten fotografie","boxoffice_url":null,"website":"https:\/\/www.kunstkot.be\/expo","email":"info@kunstkot.be","phone_contact":"+32 495 79 39 22","phone_booking":"+32 495 79 39 22","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50011551"}},"place":{"id":2597,"translations":{"de":{"name":"GC Elzenhof","address_street_name":"Avenue de la Couronne","address_street_number":"12","address_street_box":null,"email":"elzenhof@vgc.be","website":"http:\/\/www.gcelzenhof.be","phone_contact":"+32 2 648 20 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue de la Couronne, 12","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"GC Elzenhof","address_street_name":"Avenue de la Couronne","address_street_number":"12","address_street_box":null,"email":"elzenhof@vgc.be","website":"http:\/\/www.gcelzenhof.be","phone_contact":"+32 2 648 20 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue de la Couronne, 12","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"GC Elzenhof","address_street_name":"Avenue de la Couronne","address_street_number":"12","address_street_box":null,"email":"elzenhof@vgc.be","website":"http:\/\/www.gcelzenhof.be","phone_contact":"+32 2 648 20 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue de la Couronne, 12","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"GC Elzenhof","address_street_name":"Avenue de la Couronne","address_street_number":"12","address_street_box":null,"email":"elzenhof@vgc.be","website":"http:\/\/www.gcelzenhof.be","phone_contact":"+32 2 648 20 30","phone_booking":null,"address_zip":"1050","address_city":"Ixell