\u00e9clatante de la lumi\u00e8re et des couleurs, et la profondeur des ombres de la solitude.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.galerielaforestdivonne.com\/fr\/accueil\/","email":"brussels@galerielaforestdivonne.com","phone_contact":"+32 2 544 16 73","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700004264"},"sp":{"name":"Patrice Giorda - 'Le Paradis Perdu'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.galerielaforestdivonne.com\/fr\/accueil\/","email":"brussels@galerielaforestdivonne.com","phone_contact":"+32 2 544 16 73","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700004264"},"nl":{"name":"Patrice Giorda - 'Le Paradis Perdu'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.galerielaforestdivonne.com\/fr\/accueil\/","email":"brussels@galerielaforestdivonne.com","phone_contact":"+32 2 544 16 73","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700004264"}},"place":{"id":266540,"translations":{"de":{"name":"Galerie La Forest Divonne","address_street_name":"Avenue Louise","address_street_number":"130","address_street_box":null,"email":"brussels@galerielaforestdivonne.com","website":"http:\/\/www.galerielaforestdivonne.com","phone_contact":"+ 32 (0) 25 44 16 73","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue Louise, 130","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Galerie La Forest Divonne","address_street_name":"Avenue Louise","address_street_number":"130","address_street_box":null,"email":"brussels@galerielaforestdivonne.com","website":"http:\/\/www.galerielaforestdivonne.com","phone_contact":"+ 32 (0) 25 44 16 73"