ne_contact":"+32 2 376 46 45","phone_booking":"+32 2 376 46 45","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50002897"},"pt":{"name":"L'enfant qui est n\u00e9 deux fois","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/roseraie.org\/enfant-ne-deux-fois","email":"secretariat@roseraie.org","phone_contact":"+32 2 376 46 45","phone_booking":"+32 2 376 46 45","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50002897"},"en":{"name":"L'enfant qui est n\u00e9 deux fois","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/roseraie.org\/enfant-ne-deux-fois","email":"secretariat@roseraie.org","phone_contact":"+32 2 376 46 45","phone_booking":"+32 2 376 46 45","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50002897"},"it":{"name":"L'enfant qui est n\u00e9 deux fois","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/roseraie.org\/enfant-ne-deux-fois","email":"secretariat@roseraie.org","phone_contact":"+32 2 376 46 45","phone_booking":"+32 2 376 46 45","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50002897"},"cn":{"name":"L'enfant qui est n\u00e9 deux fois","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/roseraie.org\/enfant-ne-deux-fois","email":"secretariat@roseraie.org","phone_contact":"+32 2 376 46 45","phone_booking":"+32 2 376 46 45","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50002897"},"fr":{"name":"L'enfant qui est n\u00e9 deux fois","shortdescr":"Un cheminement initiatique qui se veut \u00e0 la fois terrible, cruel, mais aussi lib\u00e9rateur, ludique et dr\u00f4le.","longdescr":"Une petite \u00e2me s\u2019envole... Elle se doit de faire un grand voyage. Sur le dos d\u2019animaux, elle va vivre un \u00e9tonnant p\u00e9riple a\u00e9rien, terrien et aquatique \u00e0 la recherche d\u2019un corps \u00e0 habiter.\n\nSeule sur sc\u00e8ne avec pour tout d\u00e9cor la lumi\u00e8re et quelques planches \u00e9parpill\u00e9es, M\u00e9lancolie Motte propose d'\u00e9voquer avec po\u00e9sie, musicalit\u00e9 et douceur une th\u00e9matique sans \u00e2ge \u00e0 laquelle le jeune public est souvent confront\u00e9 d'une mani\u00e8re ou d'une autre : le cycle implacable de la vie et de la mort. ","performers":"Cr\u00e9ation et interpr\u00e9tation M\u00e9lancolie Motte. Mise en sc\u00e8ne Julie Nayer, Caroline Corn\u00e9lis. Cr\u00e9ation sonore Antonin De Bemels. Cr\u00e9ation lumi\u00e8res Jocelyn Asciak. Regard ext\u00e9rieur Heidi Folliet. Conception d\u00e9cor Idiot Productions. Production Le Non Dit asbl. Collaboration artistique Cimarra, Compagnie Nyash.\u200b ","boxoffice_url":null,"website":"https:\/\/roseraie.org\/enfant-ne-deux-fois","email":"secretariat@roseraie.org","phone_contact":"+32 2 376 46 45","phone_booking":"+32 2 376 46 45","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50002897"},"sp":{"name":"L'enfant qui est n\u00e9 deux fois","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/roseraie.org\/enfant-ne-deux-fois","email":"secretariat@roseraie.org","phone_contact":"+32 2 376 46 45","phone_booking":"+32 2 376 46 45","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50002897"},"nl":{"name":"L'enfant qui est n\u00e9 deux fois","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/roseraie.org\/enfant-ne-deux-fois","email":"secretariat@roseraie.org","phone_contact":"+32 2 376 46 45","phone_booking":"+32 2 376 46 45","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50002897"}},"place":{"id":231528,"translations":{"de":{"name":"La Roseraie","address_street_name":"Chauss\u00e9e d'Alsemberg","address_street_number":"1299","address_street_box":null,"email":"s