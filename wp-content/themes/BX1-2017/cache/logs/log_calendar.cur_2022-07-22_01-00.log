17:00","saturday and sunday: from 11:00 to 18:00"]},"date_start":"2022-04-28","date_end":"2022-08-07","is_also_by_appointment":false}],"prices":[{"translations":{"fr":{"name":"Article 27"},"nl":{"name":"Artikel 27"},"en":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"visit_profile":{"list":[337],"translations":{"fr":["Highlight"],"nl":["Highlight"],"en":["Highlight"]}},"tags":[],"accessibilities":{"list":[252,255,256,257,259,261,263,265],"translations":{"fr":["Accessible aux personnes ayant des difficult\u00e9s de compr\u00e9hension","Accessible","Am\u00e9nagements pour les personnes aveugles et malvoyantes","Am\u00e9nagements pour personnes sourdes et malentendantes","Chien d'assistance","Parking accessible","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9"],"nl":["Toegankelijk voor mensen met een verstandelijke beperking","Toegankelijk","Voorzieningen voor blinde en slechtziende personen","Voorzieningen voor dove en slechthorende personen","Assistentiehonden","Toegankelijke parking","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet"],"en":["Accessible to people with intellectual disabilities","Accessible","Facilities for blind and partially-sighted persons","Facilities for deaf and hearing-impaired people","Assistance dogs","Accessible parking","Accessible to pedestrians with mobility aids","Adapted toilet"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-07-21T01:35:49+02:00","published_at":"2022-01-27T08:04:35+01:00","backoffice_id":246257,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.33974515584373},{"id":536140,"date_start":"2022-07-07","date_end":"2022-08-27","date_next":"2022-07-21","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre"}},"others":{"list":[55],"translations":{"fr":["Th\u00e9\u00e2tre de marionnettes"],"nl":["Poppentheater"],"en":["Puppet show"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Faust, Op\u00e9ra comique d'apr\u00e8s Charles Gounod","shortdescr":"Au cr\u00e9puscule d\u2019une vie consacr\u00e9e \u00e0 la science, le Docteur Faust se laisse tenter par le Deuvel (Diable). Faust retrouve sa jeunesse afin de s\u00e9duire la belle \"mokske\" Marguerite, mais le Deuvel joue les trouble-f\u00eate...\r\nLes grands airs de l'Op\u00e9ra de Gounod (\"Ah, je ris...\") sont au rendez-vous, en fran\u00e7ais et en brusseleir.","longdescr":"Comment Toone en est-il arriv\u00e9 \u00e0 Gounod ? Au temps o\u00f9 La Monnaie, maintenant\r\nOp\u00e9ra National, disposait de privil\u00e8ges \u00e9crasants par rapport aux autres\r\nth\u00e9\u00e2tres de Bruxelles, T\u00f4\u00f4ne-Dufeys (une autre dynastie de marionnettistes) se\r\nrendait r\u00e9guli\u00e8rement \u00e0 l\u2019Op\u00e9ra pour y copier le plus fid\u00e8lement possible ces\r\ngrands spectacles inaccessibles pour le peuple des Marolles et les pr\u00e9senter\r\nensuite dans son th\u00e9\u00e2tre. Les marionnettes traditionnelles \u00e9taient alors le seul\r\nmoyen d\u2019\u00e9ducation populaire d\u2019un public toujours pr\u00eat \u00e0 s\u2019enthousiasmer pour\r\nles plus grandes oeuvres. Toone VII \u00e0 son tour se pencha sur l\u2019op\u00e9ra de Gounod\r\npour en faire une adaptation parodique.\r\n\u00ab ... Tandis que le docteur Faust boit une derni\u00e8re gueuze dans l\u2019espoir d\u2019une\r\nmort subite, un inqui\u00e9tant personnage, le \u201cDeuvel\u201d, vient lui proposer des\r\npaquets de billets de mille et une belle \u201cmokske\u201d au doux nom de\r\nMarguerite, en \u00e9change de son \u00e2me. On fait un tour \u00e0 la foire du midi, on\r\npasse (en coulisses) une nuit enchanteresse et... c\u2019est le coup de foudre. Avec\r\nune cons\u00e9quence pour Marguerite : \u201cDes robes qui vont devenir trop courtes\r\npar devant\u201d... \r\nQuiconque s\u2019aventure dans le vaste univers que repr\u00e9sente ce sujet comprendra,\r\n\u00e0 travers l\u2019humour, le sentiment de paix int\u00e9rieure qui l\u2019anime.\r\nOn devine ais\u00e9ment ce que peuvent donner des m\u00e9lodies telles que Salut,\r\ndemeure chaste et pure ou Anges purs, anges radieux accommod\u00e9es \u00e0 la\r\nsauce bruxelloise... \u00bb (La Lanterne)\r\nFid\u00e8le \u00e0 la tradition, Toone fait toutes les voix et n\u2019h\u00e9site pas \u00e0 pousser le grand\r\nair des bijoux \u00e0 l\u2019\u00e9gal de notre c\u00e9l\u00e8bre Castafiore.\r\nLes d\u00e9cors et costumes de Raymond Renard donnent \u00e0 Marguerite toutes les\r\nraisons de se voir si belle en ce miroir.","performers":"Interpr\u00e8te principal: Nicolas G\u00e9al - TOONE VIII.\r\nAdaptation de Victor Jos\u00e9 G\u00e9al - TOONE VII.\r\nD\u00e9cors & Costumes de Raymond Renard.","boxoffice_url":null,"website":"http:\/\/www.toone.be","email":"woltje@skynet.be","phone_contact":null,"phone_booking":"+32 2 513 54 86","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/536140.html"},"nl":{"name":"Faust, Komische Opera naar Charles Gounod","shortdescr":"In de schemering van een leven gewijd aan de wetenschap, sluit dokter Faust een pact met de \u00ab\u00a0Deuvel\u00a0\u00bb (Duivel). Faust zal zijn jeugd terugkrijgen om de mooie \"mokske\" Marguerite te verleiden, maar de Deuvel speelt de spelbreker...\r\nDe grote aria's van Gounods Opera (\"Ah, je ris...\") zijn er, in het Frans en in het Brusseleir.","longdescr":"Nederlandstalig publiek zal ook genieten van de parodieversie van dit meesterwerk door de Koninklijke Schouwburg van Toone.","performers":"Hoofdartiest: Nicolas G\u00e9al - TOONE VIII.\r\nAangepast door Victor Jos\u00e9 G\u00e9al - TOONE VII.\r\nSets & Kostuums door Raymond Renard.","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/536140.html"},"en":{"name":"Faust, based on Charles Gounod's Op\u00e9ra comique","shortdescr":"In his twilight years, after a life dedicated to science, Doctor Faust looks backwards\u2026 The \u00ab\u00a0Deuvel\u00a0\u00bb (Devil) jumps in, offering him his youth back, in exchange of slavery in the life beyond. Faust gives in for the love of \u00ab\u00a0mokske\u00a0\u00bb (miss) Marguerite, but the Devil will not make things easy for them\u2026 Charles Gounod's op\u00e9ra main arias are interpreted with a parodic \u00ab\u00a0brusseleir\u00a0\u00bb touch.","longdescr":"No need to speak French to appreciate the unique character of this masterpiece in the parodic version given by Toone puppetry theater.","performers":"Main interprete: Nicolas G\u00e9al - TOONE VIII.\r\nAdaptation by Victor Jos\u00e9 G\u00e9al - TOONE VII.\r\nDecors & Costumes by Raymond Renard.","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/536140.html"},"de":{"name":"Faust","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/536140.html"},"it":{"name":"Faust","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/536140.html"},"sp":{"name":"Faust","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/536140.html"},"pt":{"name":"Faust","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/536140.html"},"cn":{"name":"Faust","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/536140.html"}},"place":{"id":231143,"translations":{"fr":{"name":"Th\u00e9\u00e2tre Royal de Toone","address_street_name":"Rue du March\u00e9 aux Herbes - Entr\u00e9e : Impasse Sainte P\u00e9tronille","address_street_number":"66","address_street_box":null,"email":"woltje@skynet.be","website":"http:\/\/www.toone.be","phone_contact":"+32 2 511 71 37","phone_booking":"+32 2 513 54 86","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du March\u00e9 aux Herbes - Entr\u00e9e : Impasse Sainte P\u00e9tronille, 66","address_line2":"1000 Bruxelles","description_web":"Le Th\u00e9\u00e2tre Royal de Toone: un th\u00e9\u00e2tre original et authentique, impr\u00e9gn\u00e9 d\u2019histoire et de culture bruxelloise !\r\nId\u00e9alement situ\u00e9 \u00e0 c\u00f4t\u00e9 de la Grand-Place, dans une maison v\u00e9n\u00e9rable datant de 1696, le Th\u00e9\u00e2tre Royal de Toone poursuit la tradition s\u00e9culaire du th\u00e9\u00e2tre populaire de marionnettes depuis 1830. \r\nLa programmation est bas\u00e9e sur les grands classiques du th\u00e9\u00e2tre tels que \u00ab Les Trois Mousquetaires \u00bb d\u2019apr\u00e8s Alexandre Dumas ou encore \u00ab Rom\u00e9o et Juliette \u00bb d\u2019apr\u00e8s William Shakespeare.\r\nActuellement, le mus\u00e9e permanent de Toone situ\u00e9 au premier \u00e9tage du b\u00e2timent principal se visite gratuitement pendant l\u2019entracte.\r\nL\u2019estaminet folklorique au rez-de-chauss\u00e9e est ouvert tous les jours de 12h00 \u00e0 24h00, sauf le lundi (jour de fermeture).\r\nC\u2019est  un estaminet tricentenaire o\u00f9, dans une ambiance authentique de briques roses espagnoles, poutres noircies et sol dall\u00e9, vous pourrez appr\u00e9cier quelques bi\u00e8res, dont la c\u00e9l\u00e8bre gueuze. \r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Koninklijk Poppentheater Toone","address_street_name":"Grasmarkt - Ingang: Impasse Sainte P\u00e9tronille","address_street_number":"66","address_street_box":null,"email":"woltje@skynet.be","website":"http:\/\/www.toone.be","phone_contact":"+32 2 511 71 37","phone_booking":"+32 2 513 54 86","address_zip":"1000","address_city":"Brussel","address_line1":"Grasmarkt - Ingang: Impasse Sainte P\u00e9tronille, 66","address_line2":"1000 Brussel","description_web":"Traditioneel marionettentheater Brusselse folklore - Typisch Staminee.\r\nMuseum van Toone: Gratis toegang voor het publiek tijdens de pauze.\r\nHet Koninklijk Theater Toone in Brussel is een origineel en authentiek poppentheater dat doorspekt is van Brusselse geschiedenis en cultuur! \r\nHet Koninklijk Theater Toone zet sinds 1830 de eeuwenoude traditie van het volkse Theater voort.\r\nDe programmatie is gebaseerd op grote toneelklassiekers zoals \"Cyrano de Bergerac\" van Edmond Rostand, \"De Drie Musketiers\" van Alexandre Dumas, \"Romeo en Julia\" van William Shakespeare en \"Tijl Uilenspiegel\" van Charles De Coster. \r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Th\u00e9\u00e2tre Royal de Toone","address_street_name":"Rue du March\u00e9 aux Herbes","address_street_number":"66","address_street_box":null,"email":"woltje@skynet.be","website":"http:\/\/www.toone.be","phone_contact":"+32 2 511 71 37","phone_booking":"+32 2 513 54 86","address_zip":"1000","address_city":"Brussels","address_line1":"Rue du March\u00e9 aux Herbes, 66","address_line2":"1000 Brussels","description_web":"During the Spanish occupation of the Netherlands all theaters were closed to prevent the actors from raising satirical pieces against the Spanish rulers. As a result, doll shows came into play: it was easier to tolerate the fierce dialogues when pronounced by lifeless dolls. About 1830 Antoine \"Toone\" Genty opened  a puppet theater, then in the Marolles. More than 180 years later, this popular entertainment has grown into a Royal Puppet Theater. After Genty, his (unrelated) successors would also be called Toone (Antoine).\r\nThe classics are performed in the local Brussels dialect with wooden puppets (the so-called poechenel), sometimes in Dutch or in French. The puppet theater and museum has been located near the Grand Place for four decades. The theater is located on the upper floors of the building, on the ground floor there is a pub. The museum contains old dolls, including 19th century specimens.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Marionettentheater - Th\u00e9\u00e2tre Royal de Toone","address_street_name":"Rue du March\u00e9 aux Herbes","address_street_number":"66","address_street_box":null,"email":"woltje@skynet.be","website":"http:\/\/www.toone.be","phone_contact":"+32 2 511 71 37","phone_booking":"+32 2 513 54 86","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du March\u00e9 aux Herbes, 66","address_line2":"1000 Bruxelles","description_web":"W\u00e4hrend der spanischen Besetzung der Niederlande wurden zwangsweise s\u00e4mtliche Theater geschlossen, um Kritik - in Form von satirischen St\u00fccken - an den spanischen Herrschern zu unterbinden. Die Br\u00fcsseler haben alsdann die Schauspieler durch Marionetten (\"Poechenelles\" in Br\u00fcsseler Mundart) ersetzt, die in illegalen Theatern auftragen. \r\nAnfang des 19. Jahrhunderts z\u00e4hlten die Br\u00fcsseler Marionettentheater zu den beliebtesten Vergn\u00fcgungen f\u00fcr Erwachsene, denn sie boten eine enorme Freiheit, ben\u00f6tigen nur wenig finanzielle Mittel und konnten \u00fcberall aufgef\u00fchrt werden. Ihr Repertoire ist bis heute sehr vielf\u00e4ltig und reicht von volkst\u00fcmlichen Legenden \u00fcber Rittergeschichten bis hin zu religi\u00f6sen oder historischen St\u00fccken, die sehr frei interpretiert werden. \r\nSeit der Gr\u00fcndung des Theaters im Marollenviertel ist nun bereits die 9. Puppenspielergeneration der Toone-Dynastie am Werk. Der jeweils neue Toone (Br\u00fcsseler Kosename f\u00fcr \"Antoine\", so der Vorname des Gr\u00fcnders) muss sowohl von seinem Vorg\u00e4nger als auch von dem Publikum angenommen werden - und so ist es nicht unbedingt der jeweilige Sohn, der die Nachfolge antritt. \r\nDie Klassiker werden in Br\u00fcsseler Mundart und manchmal auch auf Niederl\u00e4ndisch oder Franz\u00f6sisch aufgef\u00fchrt. \r\nDas Th\u00e9\u00e2tre de Toone birgt auch ein urige Schenke und ein Marionettenmuseum.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Teatro Reale di Toone VII","address_street_name":"Rue du March\u00e9 aux Herbes","address_street_number":"66","address_street_box":null,"email":"woltje@skynet.be","website":"http:\/\/www.toone.be","phone_contact":"+32 2 511 71 37","phone_booking":"+32 2 513 54 86","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du March\u00e9 aux Herbes, 66","address_line2":"1000 Bruxelles","description_web":"Traditional Brussels\u2019 puppet theater & museum - Typical caf\u00e9\r\nBordering the Impasses Schuddeveld and Sainte-P\u00e9tronille, you will find one of the favourite places of Brussels citizens: Le th\u00e9\u00e2tre de Toone.\r\nTheater Toone is simultaneously a typical estaminet with its Spanish pink brick walls, blackened beams and tiled floor, a puppet theatre in the attic, with its wooden benches, festooned, multicoloured cushions nailed into the raw wood planks and a puppet museum. There, we find the characters who retired from the stage, these Toone heroes of the past and fetish characters of fellow puppeteers from around the world.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Teatro Real Toone VII","address_street_name":"Rue du March\u00e9 aux Herbes","address_street_number":"66","address_street_box":null,"email":"woltje@skynet.be","website":"http:\/\/www.toone.be","phone_contact":"+32 2 511 71 37","phone_booking":"+32 2 513 54 86","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du March\u00e9 aux Herbes, 66","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Th\u00e9\u00e2tre Royal de Toone","address_street_name":"Rue du March\u00e9 aux Herbes - Entr\u00e9e : Impasse Sainte P\u00e9tronille","address_street_number":"66","address_street_box":null,"email":"woltje@skynet.be","website":"http:\/\/www.toone.be","phone_contact":"+32 2 511 71 37","phone_booking":"+32 2 513 54 86","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du March\u00e9 aux Herbes - Entr\u00e9e : Impasse Sainte P\u00e9tronille, 66","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Th\u00e9\u00e2tre Royal de Toone","address_street_name":"Rue du March\u00e9 aux Herbes - Entr\u00e9e : Impasse Sainte P\u00e9tronille","address_street_number":"66","address_street_box":null,"email":"woltje@skynet.be","website":"http:\/\/www.toone.be","phone_contact":"+32 2 511 71 37","phone_booking":"+32 2 513 54 86","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du March\u00e9 aux Herbes - Entr\u00e9e : Impasse Sainte P\u00e9tronille, 66","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":[],"zones":[],"neca":null,"facebook_id":null,"backoffice_id":913,"location":{"lat":null,"lon":null},"region":"brussels","last_updated_at":"2022-07-17T01:35:27+02:00","published_at":"2013-10-19T01:13:54+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":231143,"translations":{"fr":{"name":"Th\u00e9\u00e2tre Royal de Toone","address_street_name":"Rue du March\u00e9 aux Herbes - Entr\u00e9e : Impasse Sainte P\u00e9tronille","address_street_number":"66","address_street_box":null,"email":"woltje@skynet.be","website":"http:\/\/www.toone.be","phone_contact":"+32 2 511 71 37","phone_booking":"+32 2 513 54 86","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du March\u00e9 aux Herbes - Entr\u00e9e : Impasse Sainte P\u00e9tronille, 66","address_line2":"1000 Bruxelles","description_web":"Le Th\u00e9\u00e2tre Royal de Toone: un th\u00e9\u00e2tre original et authentique, impr\u00e9gn\u00e9 d\u2019histoire et de culture bruxelloise !\r\nId\u00e9alement situ\u00e9 \u00e0 c\u00f4t\u00e9 de la Grand-Place, dans une maison v\u00e9n\u00e9rable datant de 1696, le Th\u00e9\u00e2tre Royal de Toone poursuit la tradition s\u00e9culaire du th\u00e9\u00e2tre populaire de marionnettes depuis 1830. \r\nLa programmation est bas\u00e9e sur les grands classiques du th\u00e9\u00e2tre tels que \u00ab Les Trois Mousquetaires \u00bb d\u2019apr\u00e8s Alexandre Dumas ou encore \u00ab Rom\u00e9o et Juliette \u00bb d\u2019apr\u00e8s William Shakespeare.\r\nActuellement, le mus\u00e9e permanent de Toone situ\u00e9 au premier \u00e9tage du b\u00e2timent principal se visite gratuitement pendant l\u2019entracte.\r\nL\u2019estaminet folklorique au rez-de-chauss\u00e9e est ouvert tous les jours de 12h00 \u00e0 24h00, sauf le lundi (jour de fermeture).\r\nC\u2019est  un estaminet tricentenaire o\u00f9, dans une ambiance authentique de briques roses espagnoles, poutres noircies et sol dall\u00e9, vous pourrez appr\u00e9cier quelques bi\u00e8res, dont la c\u00e9l\u00e8bre gueuze. \r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Koninklijk Poppentheater Toone","address_street_name":"Grasmarkt - Ingang: Impasse Sainte P\u00e9tronille","address_street_number":"66","address_street_box":null,"email":"woltje@skynet.be","website":"http:\/\/www.toone.be","phone_contact":"+32 2 511 71 37","phone_booking":"+32 2 513 54 86","address_zip":"1000","address_city":"Brussel","address_line1":"Grasmarkt - Ingang: Impasse Sainte P\u00e9tronille, 66","address_line2":"1000 Brussel","description_web":"Traditioneel marionettentheater Brusselse folklore - Typisch Staminee.\r\nMuseum van Toone: Gratis toegang voor het publiek tijdens de pauze.\r\nHet Koninklijk Theater Toone in Brussel is een origineel en authentiek poppentheater dat doorspekt is van Brusselse geschiedenis en cultuur! \r\nHet Koninklijk Theater Toone zet sinds 1830 de eeuwenoude traditie van het volkse Theater voort.\r\nDe programmatie is gebaseerd op grote toneelklassiekers zoals \"Cyrano de Bergerac\" van Edmond Rostand, \"De Drie Musketiers\" van Alexandre Dumas, \"Romeo en Julia\" van William Shakespeare en \"Tijl Uilenspiegel\" van Charles De Coster. \r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Th\u00e9\u00e2tre Royal de Toone","address_street_name":"Rue du March\u00e9 aux Herbes","address_street_number":"66","address_street_box":null,"email":"woltje@skynet.be","website":"http:\/\/www.toone.be","phone_contact":"+32 2 511 71 37","phone_booking":"+32 2 513 54 86","address_zip":"1000","address_city":"Brussels","address_line1":"Rue du March\u00e9 aux Herbes, 66","address_line2":"1000 Brussels","description_web":"During the Spanish occupation of the Netherlands all theaters were closed to prevent the actors from raising satirical pieces against the Spanish rulers. As a result, doll shows came into play: it was easier to tolerate the fierce dialogues when pronounced by lifeless dolls. About 1830 Antoine \"Toone\" Genty opened  a puppet theater, then in the Marolles. More than 180 years later, this popular entertainment 