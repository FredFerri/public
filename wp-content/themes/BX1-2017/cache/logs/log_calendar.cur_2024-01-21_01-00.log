,4],"translations":{"de":["Worldmusic, Folk & Country","Pop, Rock, Jazz..."],"pt":[null,null],"en":["Worldmusic, Folk & Country","Pop, rock, jazz\u2026"],"it":["Worldmusic, Folk e Country","Pop, rock, jazz\u2026"],"cn":[null,null],"fr":["Worldmusic, Folk & Country","Pop, rock, jazz\u2026"],"sp":["Worldmusic, folk y country","Pop, rock, jazz\u2026"],"nl":["Worldmusic, Folk & Country","Pop, rock, jazz\u2026"]}}},"translations":{"de":{"name":"Shane McGowan & Dave Munnelly: High-energy Irish Folk","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/muziekpublique.be\/","email":"info@muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50005253"},"pt":{"name":"Shane McGowan & Dave Munnelly: High-energy Irish Folk","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/muziekpublique.be\/","email":"info@muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50005253"},"en":{"name":"Shane McGowan & Dave Munnelly: High-energy Irish Folk","shortdescr":"A virtuoso of the diatonic accordion, David Munnelly is one of the pillars of the \u201cAccordion Samurai\u201d project. His colorful and energetic playing has allowed him to tour around the world alongside artists such as The Chieftains, De Danann, Gerry O\u2019Connor and Arty McGlynn. ","longdescr":"Becoming addicted to the accordion at a young age, he quickly mastered his own style, following in the footsteps of his Irish grandparents but exceeding by far their influence. Today he is among the greatest accordionists of this genre.\n\nIn this new duo, he is joined by a partner, just as virtuoso and inventive as him: guitarist Shane McGowan (not to be confused with the singer of the group The Pogues). Son of a famous flautist, McGowan grew up in a family of musicians. As a teenager, he discovered the guitar, for which he developed a real passion. In 2010, he joined Munnelly\u2019s group and also appeared with Lunasa and Dolores Keane. By adding influences from bluegrass, swing and ragtime to traditional Irish folk, Munnelly and McGowan mix their own compositions, from which pure musicality comes out.","performers":"Dave Munnelly: accordion\nShane McGowan: guitar, voice\n","boxoffice_url":null,"website":"https:\/\/muziekpublique.be\/","email":"info@muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50005253"},"it":{"name":"Shane McGowan & Dave Munnelly: High-energy Irish Folk","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/muziekpublique.be\/","email":"info@muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50005253"},"cn":{"name":"Shane McGowan & Dave Munnelly: High-energy Irish Folk","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/muziekpublique.be\/","email":"info@muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50005253"},"fr":{"name":"Shane McGowan & Dave Munnelly: High-energy Irish Folk","shortdescr":"Virtuose de l\u2019accord\u00e9on diatonique, David Munnelly est l\u2019un des piliers du projet Accordion Samurai. Son jeu color\u00e9 et \u00e9nergique lui a permis de tourner dans le monde entier aux c\u00f4t\u00e9s d\u2019artistes tels que The Chieftains, De Danann, Gerry O\u2019Connor et Arty McGlynn.","longdescr":"Devenu accro \u00e0 l\u2019accord\u00e9on d\u00e8s son plus jeune \u00e2ge, il a rapidement ma\u00eetris\u00e9 son propre style, dans la lign\u00e9e de ses grands-parents irlandais mais d\u00e9passant de loin leur influence. Il compte aujourd\u2019hui parmi les plus grands accord\u00e9onistes du genre. \nDans ce nouveau duo, il est rejoint par un partenaire tout aussi virtuose et inventif que lui : le guitariste Shane McGowan (\u00e0 ne pas confondre avec le chanteur du groupe The Pogues). Fils d\u2019un c\u00e9l\u00e8bre fl\u00fbtiste, McGowan a grandi au sein d\u2019une famille de musiciens. A l\u2019adolescence, il d\u00e9couvre la guitare, pour laquelle il d\u00e9veloppe une v\u00e9ritable passion. En 2010, il rejoint le groupe de Munnelly et appara\u00eet \u00e9galement avec Lunasa ou Dolores Keane. En ajoutant au folk irlandais traditionnel des influences du bluegrass, du swing et du ragtime, Munnelly et McGowan y m\u00ealent leurs propres compositions, desquelles s\u2019\u00e9chappe une pure musicalit\u00e9.","performers":"Dave Munnelly : accord\u00e9on\nShane McGowan : guitare, chant","boxoffice_url":null,"website":"https:\/\/muziekpublique.be\/","email":"info@muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50005253"},"sp":{"name":"Shane McGowan & Dave Munnelly: High-energy Irish Folk","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/muziekpublique.be\/","email":"info@muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50005253"},"nl":{"name":"Shane McGowan & Dave Munnelly: High-energy Irish Folk","shortdescr":"David Munnelly is als virtuoos op de diatonische accordeon \u00e9\u00e9n van de vaste waarden van supergroep Accordion Samurai. Dankzij zijn kleurrijke en energieke spel toerde hij de wereld rond met artiesten als The Chieftains, De Danann, Gerry O\u2019Connor en Arty McGlynn. ","longdescr":"David Munnelly raakte op jonge leeftijd verslingerd aan de accordeon en maakte zich een eigen stijl meester, schatplichtig aan zijn Ierse grootouders maar hun invloed ver overtreffend. Vandaag wordt hij tot de allerbeste accordeonspelers gerekend. Hij neemt met gitarist Shane McGowan (niet te verwarren met de leadzanger van The Pogues) een even virtuoos en inventief partner mee. McGowan groeide op in een Ierse muzikantenfamilie als zoon van een bekende fluitist. In zijn tienerjaren ontdekte hij echter de gitaar, wat zijn grote liefde bleek te zijn. In 2010 trad hij toe tot Munnelly\u2019s band, maar was ook te zien bij Lunasa of Dolores Keane. Munnelly en McGowan mixen traditionele Ierse folk met invloeden uit bluegrass, swing en ragtime tot eigen composities waar de muzikaliteit van af spat.","performers":"Dave Munnelly: accordeon\nShane McGowan: gitaar, zang\n","boxoffice_url":null,"website":"https:\/\/muziekpublique.be\/","email":"info@muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50005253"}},"place":{"id":238099,"translations":{"de":{"name":"Muziekpublique","address_street_name":"Galerie de la Porte de Namur","address_street_number":"3","address_street_box":null,"email":"info@muziekpublique.be","website":"http:\/\/www.muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":"+32 2 217 26 00","address_zip":"1050","address_city":"Ixelles","address_line1":"Galerie de la Porte de Namur, 3","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Muziekpublique","address_street_name":"Galerie de la Porte de Namur","address_street_number":"3","address_street_box":null,"email":"info@muziekpublique.be","website":"http:\/\/www.muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":"+32 2 217 26 00","address_zip":"1050","address_city":"Ixelles","address_line1":"Galerie de la Porte de Namur, 3","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Muziekpublique","address_street_name":"Galerie de la Porte de Namur","address_street_number":"3","address_street_box":null,"email":"info@muziekpublique.be","website":"http:\/\/www.muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":"+32 2 217 26 00","address_zip":"1050","address_city":"Ixelles","address_line1":"Galerie de la Porte de Namur, 3","address_line2":"1050 Ixelles","description_web":"Muziekpublique, keeps music and dance traditions alive and kicking in Brussels through an ambitious programme of concerts, courses, and projects. A year-round concert programme, featuring Belgian and international artists, forms the core of the foundation\u2019s activities. From the contemplative to the madly festive concerts take place indoors,  in the small Moli\u00e8re Theatre, in the arcade at the Porte de Namur and outdoors, around the city and throughout the year.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Muziekpublique","address_street_name":"Galerie de la Porte de Namur","address_street_number":"3","address_street_box":null,"email":"info@muziekpublique.be","website":"http:\/\/www.muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":"+32 2 217 26 00","address_zip":"1050","address_city":"Ixelles","address_line1":"Galerie de la Porte de Namur, 3","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Muziekpublique","address_street_name":"Galerie de la Porte de Namur","address_street_number":"3","address_street_box":null,"email":"info@muziekpublique.be","website":"http:\/\/www.muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":"+32 2 217 26 00","address_zip":"1050","address_city":"Ixelles","address_line1":"Galerie de la Porte de Namur, 3","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"fr":{"name":"Muziekpublique","address_street_name":"Galerie de la Porte de Namur","address_street_number":"3","address_street_box":null,"email":"info@muziekpublique.be","website":"http:\/\/www.muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":"+32 2 217 26 00","address_zip":"1050","address_city":"Ixelles","address_line1":"Galerie de la Porte de Namur, 3","address_line2":"1050 Ixelles","description_web":"Muziekpublique est le centre des musiques traditionnelles du monde de Bruxelles. Etablie dans le Th\u00e9\u00e2tre Moli\u00e8re au c\u0153ur du quartier africain, l\u2019asbl organise plus de 100 concerts par an et deux festivals (Hide & Seek Festival etc.). Par ailleurs Muziekpublique propose aussi 50 cours de musique et de danse du monde, comptant plus de 600 \u00e9l\u00e8ves. Ensuite, l\u2019asbl d\u00e9veloppe certains artistes et projets via son label, qui est aussi une agence de booking et de management. La musique traditionnelle a donc trouv\u00e9 un endroit id\u00e9al o\u00f9 se d\u00e9velopper et les artistes y constituent un r\u00e9seau vivant et dynamique cr\u00e9ant des liens de qualit\u00e9 avec le public. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Muziekpublique","address_street_name":"Galerie de la Porte de Namur","address_street_number":"3","address_street_box":null,"email":"info@muziekpublique.be","website":"http:\/\/www.muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":"+32 2 217 26 00","address_zip":"1050","address_city":"Ixelles","address_line1":"Galerie de la Porte de Namur, 3","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Muziekpublique","address_street_name":"Galerij van de Naamsepoort ","address_street_number":"3","address_street_box":null,"email":"info@muziekpublique.be","website":"