 avec lui \u2013 sur nos \u00ab r\u00e9flexes induits \u00bb et la place de la \u00ab diversit\u00e9 \u00bb dans notre soci\u00e9t\u00e9. C\u2019est un spectacle participatif !","performers":"Fr\u00e9d\u00e9ric Lubansu","boxoffice_url":null,"website":"http:\/\/www.senghor.be","email":"info@senghor.be","phone_contact":null,"phone_booking":"+32 2 230 31 40","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.544144"},"nl":{"name":"Du blanc au noir","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.544144"},"en":{"name":"Du blanc au noir","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.544144"},"de":{"name":"Du blanc au noir","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.544144"},"it":{"name":"Du blanc au noir","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.544144"},"sp":{"name":"Du blanc au noir","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.544144"},"pt":{"name":"Du blanc au noir","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.544144"