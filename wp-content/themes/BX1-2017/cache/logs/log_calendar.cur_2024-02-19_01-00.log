one_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50000154"},"pt":{"name":"Bruxelles Avenue, la Com\u00e9die Musicale improvis\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Bruxelles-Avenue-la-Comedie-Musicale-improvisee","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50000154"},"en":{"name":"Bruxelles Avenue, la Com\u00e9die Musicale improvis\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Bruxelles-Avenue-la-Comedie-Musicale-improvisee","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50000154"},"it":{"name":"Bruxelles Avenue, la Com\u00e9die Musicale improvis\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Bruxelles-Avenue-la-Comedie-Musicale-improvisee","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50000154"},"cn":{"name":"Bruxelles Avenue, la Com\u00e9die Musicale improvis\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Bruxelles-Avenue-la-Comedie-Musicale-improvisee","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50000154"},"fr":{"name":"Bruxelles Avenue, la Com\u00e9die Musicale improvis\u00e9e","shortdescr":"Aller simple pour Broadway, sans billet d\u2019avion !","longdescr":"La compagnie Crescendo s\u2019aventure sur les arp\u00e8ges de la surprise, les notes de l\u2019\u00e9motion, l\u2019illusion des harmonies. Six com\u00e9dien.ne.s et un musicien improvisent ensemble pendant une heure et quart pour proposer au public une com\u00e9die musicale improvis\u00e9e dans la tradition de Broadway. Musique, chant et danse se m\u00ealent au th\u00e9\u00e2tre pour mettre en mouvement des histoires extraordinaires, touchantes ou dr\u00f4les, mais toujours sinc\u00e8res. Au milieu de l\u2019actualit\u00e9 anxiog\u00e8ne, Crescendo offre une parenth\u00e8se de joie, de l\u00e9g\u00e8ret\u00e9 et de f\u00e9\u00e9rie \u00e0 son public en cr\u00e9ant un monde o\u00f9 tout est possible, dans lequel le h\u00e9ros peut, litt\u00e9ralement ou symboliquement, terrasser les dragons et \u00e9carter les montagnes. Une heure et quart d\u2019accords majeurs et de premier degr\u00e9 assum\u00e9, un v\u00e9ritable \u201cmorceau de sucre qui aide la m\u00e9decine \u00e0 couler et nous rend la vie plus gaie\u201d ! Tant\u00f4t rythm\u00e9s, doux ou \u00e9piques, la musique et le chant emm\u00e8nent le public dans un univers cadenc\u00e9 qui vous mettra le coeur en musique.","performers":"Compagnie Crescendo","boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Bruxelles-Avenue-la-Comedie-Musicale-improvisee","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50000154"},"sp":{"name":"Bruxelles Avenue, la Com\u00e9die Musicale improvis\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Bruxelles-Avenue-la-Comedie-Musicale-improvisee","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50000154"},"nl":{"name":"Bruxelles Avenue, la Com\u00e9die Musicale improvis\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Bruxelles-Avenue-la-Comedie-Musicale-improvisee","email":"info@improviste.be","phone