ooking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700003332"},"pt":{"name":"Celles qui veillent, un conte musical d'Anne Borl\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/ccbruegel.be\/programme\/celles-qui-veillent\/","email":"reservation@dimanchesduconte.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700003332"},"en":{"name":"Celles qui veillent, un conte musical d'Anne Borl\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/ccbruegel.be\/programme\/celles-qui-veillent\/","email":"reservation@dimanchesduconte.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700003332"},"it":{"name":"Celles qui veillent, un conte musical d'Anne Borl\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/ccbruegel.be\/programme\/celles-qui-veillent\/","email":"reservation@dimanchesduconte.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700003332"},"cn":{"name":"Celles qui veillent, un conte musical d'Anne Borl\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/ccbruegel.be\/programme\/celles-qui-veillent\/","email":"reservation@dimanchesduconte.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700003332"},"fr":{"name":"Celles qui veillent, un conte musical d'Anne Borl\u00e9e","shortdescr":" Celles qui veillent est un r\u00e9cit cont\u00e9 et chant\u00e9, accompagn\u00e9 \u00e0 la harpe. Cr\u00e9\u00e9 \u00e0 partir de faits historiques, le r\u00e9cit nous fait revivre les proc\u00e8s et les ex\u00e9cutions des femmes dites \"sorci\u00e8res\" dans les campagnes belges au XVIIe si\u00e8cle. ","longdescr":"Elle est sortie de la for\u00eat dans la brume du matin, ses yeux \u00e9taient secs. Secs de la poussi\u00e8re des chemins tant parcourus, secs de la fum\u00e9e des trop nombreux b\u00fbchers. Mais elle \u00e9tait d\u00e9termin\u00e9e. Le fil de la transmission ne sera pas rompu. Elle y veillera. Elles y veilleront. \n\nCelles qui veillent est un r\u00e9cit cont\u00e9 et chant\u00e9, accompagn\u00e9 \u00e0 la harpe. Cr\u00e9\u00e9 \u00e0 partir de faits historiques, le r\u00e9cit nous fait revivre les proc\u00e8s et les ex\u00e9cutions des femmes dites \"sorci\u00e8res\" dans les campagnes belges au XVIIe si\u00e8cle.\n\nDimanche 24 novembre \u00e0 18h \nDur\u00e9e : 1h + 30 minutes d'\u00e9change \nPour adultes et adolescents (14 ans et +) \nInfos et r\u00e9servations : https:\/\/ccbruegel.be\/programme\/celles-qui-veillent\/\n","performers":"Anne Borl\u00e9e (conteuse et musicienne)","boxoffice_url":null,"website":"https:\/\/ccbruegel.be\/programme\/celles-qui-veillent\/","email":"reservation@dimanchesduconte.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700003332"},"sp":{"name":"Celles qui veillent, un conte musical d'Anne Borl\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/ccbruegel.be\/programme\/celles-qui-veillent\/","email":"reservation@dimanchesduconte.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700003332"},"nl":{"name":"Celles qui veillent, un conte musical d'Anne Borl\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/ccbruegel.be\/programme\/celles-qui-veillent\/","email":"reservation@dimanchesduconte.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700003332"}},"place":{