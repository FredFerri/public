enda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50001321"},"cn":{"name":"Jazz'Navour","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lafleurenpapierdore.be\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50001321"},"fr":{"name":"Jazz'Navour","shortdescr":null,"longdescr":"Dans le cadre des Jacqueries (la f\u00eate du quartier Saint-Jacques, situ\u00e9 au c\u0153ur de Bruxelles), la Fleur en Papier Dor\u00e9 vous propose en concert le  groupe Jazz'navour. \n\nJazz'navour est n\u00e9 en 2019, regroupant un trio de jazz compos\u00e9 au clavier par Rosario Randazzo, \u00e0 la contrebasse de Jean Marie Fossoul et\u00a0\u00e0 la batterie d'Angelo\u00a0Crisci.\nLes ch\u0153urs sont assur\u00e9s par Ir\u00e8ne Batinic\u00a0et le chant par Pascal Priarolo.\nCette formation donne aux musiques originales un renouveau plus jazzy tout en conservant\u00a0la sensibilit\u00e9 des textes","performers":"Clavier: Rosario Randazzo\nContrebasse: Jean Marie fossoul\nBatterie: Angelo\u00a0Crisci\nChoeurs: Ir\u00e8ne Batinic\nChant par Pascal Priarolo","boxoffice_url":null,"website":"https:\/\/lafleurenpapierdore.be\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50001321"},"sp":{"name":"Jazz'Navour","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lafleurenpapierdore.be\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50001321"},"nl":{"name":"Jazz'Navour","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lafleurenpapierdore.be\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50001321"}},"place":{"id":245306,"translations":{"de":{"name":"La Fleur en Papier Dor\u00e9","address_street_name":"Rue des Alexiens","address_street_number":"55","address_street_box":null,"email":"cafe@lafleurenpapierdore.be","website":"http:\/\/www.goudblommekeinpapier.be\/","phone_contact":"+32 2 511 16 59","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Alexiens, 55","address_line2":"1000 Bruxelles","description_web":"Das Caf\u00e9 \u201eLa Fleur en Papier Dor\u00e9\" (dt. Die Blume aus Goldpapier) ist ein Caf\u00e9 mit illustrer Vergangenheit, denn hier trafen sich die gro\u00dfen belgischen Surrealisten des 20. Jahrhunderts: Ren\u00e9 Magritte, Louis Scutenaire, Marcel Mari\u00ebn... Bis heute gilt das Caf\u00e9 als einschl\u00e4giges K\u00fcnstler- und Literaten-Caf\u00e9, das sich seine ganz besondere Atmosph\u00e4re bewahrt hat. Zahlreiche Veranstaltungen finden hier statt: Poesie, Literatur, Musik, Konferenzen...","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"La Fleur en Papier Dor\u00e9","address_street_name":"Rue des Alexiens","address_street_number":"55","address_street_box":null,"email":"cafe@lafleurenpapierdore.be","website":"http:\/\/www.goudblommekeinpapier.be\/","phone_contact":"+32 2 511 16 59","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Alexiens, 55","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"La Fleur en Papier Dor\u00e9","address_street_name":"Rue des Alexiens","address_street_number":"55","address_street_box":null,"email":"cafe@lafleurenpapierdore.be","website":"http:\/\/www.goudblommekeinpapier.be\/","phone_contact":"+32 2 511 16 59","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Alexiens, 55","address_line2":"1000 Bruxelles","description_web":"The Gilt Paper Flower, a listed building since 1997, has for decades been a meeting place for locals and tourists alike, whether curious about or fascinated by the history of this 17th-century building. An estaminet for a long time under the premonitory name of Caf\u00e9 des artistes, the Flower soon became what it is famous for today: the place where artists, particularly the Surrealists (Marcel Mari\u00ebn, Ren\u00e9 Magritte, Louis Scutenaire, etc.) and the Cobras (Dotremont, Alechinski, etc.), met in an infernal flea market setting.\r\n\r\nOpen Monday to Sunday from 8am to midnight, La Fleur en Papier Dor\u00e9 offers a range of local produce (including Verschueren saison, beers from the De Ranke brewery, and Stouterik on draught from Brasseries de la Senne), which can be enjoyed with a portion of cheese or sausage. Since its reopening in May 2023, The Gilt Paper Flower has closed its kitchen to concentrate on its role as a caf\u00e9. \r\n\r\nThe venue also has two rooms where the public can enjoy a programme of lectures, concerts, poetry and literature...\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"La Fleur en Papier Dor\u00e9","address_street_name":"Rue des Alexiens","address_street_number":"55","address_street_box":null,"email":"cafe@lafleurenpapierdore.be","website":"http:\/\/www.goudblommekeinpapier.be\/","phone_contact":"+32 2 511 16 59","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Alexiens, 55","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"La Fleur en Papier Dor\u00e9","address_street_name":"Rue des Alexiens","address_street_number":"55","address_street_box":null,"email":"cafe@lafleurenpapierdore.be","website":"http:\/\/www.goudblommekeinpapier.be\/","phone_contact":"+32 2 511 16 59","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Alexiens, 55","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"fr":{"name":"La Fleur en Papier Dor\u00e9","address_street_name":"Rue des Alexiens","address_street_number":"55","address_street_box":null,"email":"cafe@lafleurenpapierdore.be","website":"http:\/\/www.goudblommekeinpapier.be\/","phone_contact":"+32 2 511 16 59","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Alexiens, 55","address_line2":"1000 Bruxelles","description_web":"La Fleur en papier dor\u00e9, class\u00e9e en 1997, est depuis des d\u00e9cennies un point de visite et de rencontre pour les Bruxellois, Bruxelloises et touristes, curieux ou passionn\u00e9s par l'histoire de cet immeuble datant du  17e si\u00e8cle. Estaminet pr\u00e9c\u00e9demment connu sous le nom pr\u00e9monitoire de Caf\u00e9 des artistes, La Fleur deviendra vite ce pour quoi elle est c\u00e9l\u00e8bre aujourd\u2019hui : le lieu o\u00f9 les artistes, et particuli\u00e8rement les surr\u00e9alistes (Marcel Mari\u00ebn, Ren\u00e9 Magritte, Louis Scutenaire, etc.) et les CoBrA (Dotremont, Alechinski, etc.), se r\u00e9unissaient dans un d\u00e9cor de brocante infernale.\r\n\r\nOuverte du lundi au dimanche de 8h \u00e0 Minuit, La Fleur en Papier Dor\u00e9 propose une s\u00e9rie de produits locaux (tel que la saison Verschueren, des bi\u00e8res de la brasserie De Ranke, ou encore la Stouterik en f\u00fbt des Brasseries de la Senne) que l'on peut d\u00e9guster avec une portion de fromage ou de saucisson. Depuis sa rouverte en mai 2023, La Fleur en Papier Dor\u00e9 a ferm\u00e9 sa cuisine pour se  concentrer sur son r\u00f4le de caf\u00e9. \r\n\r\nLe lieu dispose aussi de deux salles o\u00f9 le public peut assister \u00e0 un programme de conf\u00e9rences, concerts, po\u00e9sie et litt\u00e9rature...","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"La Fleur en Papier Dor\u00e9","address_street_name":"Rue des Alexiens","address_street_number":"55","address_street_box":null,"email":"cafe@lafleurenpapierdore.be","website":"http:\/\/www.goudblommekeinpapier.be\/","phone_contact":"+32 2 511 16 59","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Alexiens, 55","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Het Goudblommeke in Papier","address_street_name":"Cellebroersstraat","address_street_number":"55","address_street_box":null,"email":"cafe@lafleurenpapierdore.be","website":"http:\/\/www.hetgoudblommekeinpapier.be","phone_contact":"+32 2 511 16 59","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Cellebroersstraat, 55","address_line2":"1000 Bruxelles","description_web":"Het Goudblommeke in Papier, een beschermd monument sinds 1997; Is al tientallen jaren een populaire ontmoetingsplaats voor de lokale bevolking en toeristen die nieuwsgierig of gefascineerd zijn door de geschiedenis van dit 17e-eeuwse gebouw. Het blommeke, lange tijd een estaminet onder de voorgevoelige naam Caf\u00e9 des artistes, werd al snel waar het vandaag de dag beroemd om is: de plek waar kunstenaars, met name de surrealisten (Marcel Mari\u00ebn, Ren\u00e9 Magritte, Louis Scutenaire, enz.) en de Cobra's (Dotremont, Alechinski, enz.), elkaar ontmoetten in een helse rommelmarktsetting.\n\nHet Goudblommeke in Papier  is open van maandag t\/m zondag van 8 uur 's ochtends tot middernacht. Ze biedt een assortiment van streekproducten (waaronder Verschueren Saison, bieren van brouwerij De Ranke en Stouterik van het vat van Brasseries de la Senne), die kunnen worden genuttigd met een portie kaas of worst. Sinds de heropening in mei 2023 heeft Het Goudblommeke in Papier de keuken gesloten om zich te concentreren op zijn rol als caf\u00e9. \n\nDe locatie heeft ook twee zalen waar het publiek kan genieten van een programma van lezingen, concerten, po\u00ebzie en literatuur...\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":"","facebook_id":null,"backoffice_id":7579,"location":{"lat":50.84280503,"lon":4.35073812},"region":"brussels","last_updated_at":"2023-08-17T12:17:28+02:00","published_at":"2013-10-19T01:22:25+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":245306,"translations":{"de":{"name":"La Fleur en Papier Dor\u00e9","address_street_name":"Rue des Alexiens","address_street_number":"55","address_street_box":null,"email":"cafe@lafleurenpapierdore.be","website":"http:\/\/www.goudblommekeinpapier.be\/","phone_contact":"+32 2 511 16 59","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Alexiens, 55","address_line2":"1000 Bruxelles","description_web":"Das Caf\u00e9 \u201eLa Fleur en Papier Dor\u00e9\" (dt. Die Blume aus Goldpapier) ist ein Caf\u00e9 mit illustrer Vergangenheit, denn hier trafen sich die gro\u00dfen belgischen Surrealisten des 20. Jahrhunderts: Ren\u00e9 Magritte, Louis Scutenaire, Marcel Mari\u00ebn... Bis heute gilt das Caf\u00e9 als einschl\u00e4giges K\u00fcnstler- und Literaten-Caf\u00e9, das sich seine ganz besondere Atmosph\u00e4re bewahrt hat. Zahlreiche Veranstaltungen finden hier statt: Poesie, Literatur, Musik, Konferenzen...","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"La Fleur en Papier Dor\u00e9","address_street_name":"Rue des Alexiens","address_street_number":"55","address_street_box":null,"email":"cafe@lafleurenpapierdore.be","website":"http:\/\/www.goudblommekeinpapier.be\/","phone_contact":"+32 2 511 16 59","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Alexiens, 55","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"La Fleur en Papier Dor\u00e9","address_street_name":"Rue des Alexiens","address_street_number":"55","address_street_box":null,"email":"cafe@lafleurenpapierdore.be","website":"http:\/\/www.goudblommekeinpapier.be\/","phone_contact":"+32 2 511 16 59","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Alexiens, 55","address_line2":"1000 Bruxelles","description_web":"The Gilt Paper Flower, a listed building since 1997, has for decades been a meeting place for locals and tourists alike, whether curious about or fascinated by the history of this 17th-century building. An estaminet for a long time under the premonitory name of Caf\u00e9 des artistes, the Flower soon became what it is famous for today: the place where artists, particularly the Surrealists (Marcel Mari\u00ebn, Ren\u00e9 Magritte, Louis Scutenaire, etc.) and the Cobras (Dotremont, Alechinski, etc.), met in an infernal flea market setting.\r\n\r\nOpen Monday to Sunday from 8am to midnight, La Fleur en Papier Dor\u00e9 offers a range of local produce (including Verschueren saison, beers from the De Ranke brewery, and Stouterik on draught from Brasseries de la Senne), which can be enjoyed with a portion of cheese or sausage. Since its reopening in May 2023, The Gilt Paper Flower has closed its kitchen to concentrate on its role as a caf\u00e9. \r\n\r\nThe venue also has two rooms where the public can enjoy a programme of lectures, concerts, poetry and literature...\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"La Fleur en Papier Dor\u00e9","address_street_name":"Rue des Alexiens","address_street_number":"55","a