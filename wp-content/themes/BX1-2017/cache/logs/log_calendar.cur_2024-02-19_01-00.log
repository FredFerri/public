2-28T10:49:47+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":291554,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.23112042478354491,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[28,24],"translations":{"de":["Grafische K\u00fcnste","Kunstgalerien"],"pt":[null,null],"en":["Graphic art","Art Galleries"],"it":["Arti grafiche","Gallerie d'arte"],"cn":[null,null],"fr":["Arts graphiques","Galeries d'art"],"sp":["Artes gr\u00e1ficas","Galer\u00edas de arte"],"nl":["Grafische kunst, vormgeving","Galeries"]}}},"translations":{"de":{"name":"1000 Little Troublemakers - Boris Pramatarov et Sophie Ung - Illustration, dessin, s\u00e9rigraphie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/tandemm.be\/expositions\/","email":"hello@tandemm.be","phone_contact":"+32 2 353 02 61","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50005678"},"pt":{"name":"1000 Little Troublemakers - Boris Pramatarov et Sophie Ung - Illustration, dessin, s\u00e9rigraphie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/tandemm.be\/expositions\/","email":"hello@tandemm.be","phone_contact":"+32 2 353 02 61","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50005678"},"en":{"name":"1000 Little Troublemakers - Boris Pramatarov et Sophie Ung - Illustration, dessin, s\u00e9rigraphie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/tandemm.be\/expositions\/","email":"hello@tandemm.be","phone_contact":"+32 2 353 02 61","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50005678"},"it":{"name":"1000 Little Troublemakers - Boris Pramatarov et Sophie Ung - Illustration, dessin, s\u00e9rigraphie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/tandemm.be\/expositions\/","email":"hello@tandemm.be","phone_contact":"+32 2 353 02 61","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50005678"},"cn":{"name":"1000 Little Troublemakers - Boris Pramatarov et Sophie Ung - Illustration, dessin, s\u00e9rigraphie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/tandemm.be\/expositions\/","email":"hello@tandemm.be","phone_contact":"+32 2 353 02 61","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50005678"},"fr":{"name":"1000 Little Troublemakers - Boris Pramatarov et Sophie Ung - Illustration, dessin, s\u00e9rigraphie","shortdescr":"\u00c0 travers une s\u00e9rie d'illustrations, les deux artistes d\u00e9voilent \"1000 little troublemakers\" qui font partie int\u00e9grante de leur processus de cr\u00e9ation. L'accumulation passionn\u00e9 d'objets, jouets anciens, robots, coquillages, papiers parfum\u00e9s, photos ... et tant d'autres tr\u00e9sors personnels devient ainsi le reflet de leur psych\u00e9 profonde aux yeux du monde.","longdescr":"Jouets anciens, robots, coquillages, lettres d\u2019amour, papiers parfum\u00e9s, souvenirs, photos et tant d\u2019autres tr\u00e9sors personnels\u2026\nCes objets font partie de nos vies. Nous les accumulons avec passion. Ils nous captivent, nous envo\u00fbtent, et nous remplissent de nostalgie et d\u2019\u00e9motions parfois contradictoires.\nNous ne saurions nous en s\u00e9parer, car chacun d\u2019eux porte en lui un fragment de notre \u00eatre. \n\nParcours\n\nBoris Pramatarov et Sophie Ung sont des artistes Bruxellois anim\u00e9s par les m\u00eames passions. Ils cr\u00e9ent illustrations, dessins, tatouages, peintures ainsi que des livres d\u2019artistes. Leurs travaux sont une fusion de leurs go\u00fbt respectifs, sur des sujets tels que le souvenir, l\u2019existence ou le questionnement identitaire.\n\nSophie Ung est une illustratrice originaire de Lille. Apr\u00e8s l\u2019obtention de son DNAP (option design d\u2019espace) aux Beaux Arts de Valenciennes en 2011, elle part \u00e0 Bruxelles pour suivre les cours d\u2019Anne Qu\u00e9vy, professeur des ateliers d\u2019illustration \u00e0 l\u2019acad\u00e9mie royale des Beaux Arts de Bruxelles. Elle cr\u00e9e des illustrations na\u00efves et color\u00e9es, remplies de motifs et de souvenirs de son enfance. \n\nBoris Pramatarov est un artiste visuel originaire de Sofia. Il est titulaire d\u2019une licence en livre et design graphique de l\u2019 Acad\u00e9mie nationale des arts de Sofia et d\u2019une ma\u00eetrise en arts graphiques de l\u2019 Acad\u00e9mie royale des beaux-arts de Gand. . Il se sp\u00e9cialise en illustration \u00e0 Duksung Women University \u00e0 S\u00e9oul (KR) et \u00e0 Sint-Lucas School of Arts \u00e0 Gand. Il cr\u00e9e des illustrations \u00ab ultra \u00bb d\u00e9taill\u00e9es en noir et blanc. Chaque pi\u00e8ce \u00e9voque un souvenir, suscite une \u00e9motion, devenant ainsi le reflet de notre psych\u00e9 profonde aux yeux du monde.\nIls nous r\u00e9confortent et nous offrent une \u00e9chappatoire \u00e0 la solitude qui, parfois, nous assaille.\nA travers une s\u00e9rie d\u2019illustrations, Boris et Sophie d\u00e9voilent des petits troublemakers qui font partie int\u00e9grante de leur processus de cr\u00e9ation.","performers":"Boris Pramatarov (artiste visuel et tatoueur) ; Sophie Ung (illustratrice et tatoueuse)","boxoffice_url":null,"website":"http:\/\/tandemm.be\/expositions\/","email":"hello@tandemm.be","phone_contact":"+32 2 353 02 61","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50005678"},"sp":{"name":"1000 Little Troublemakers - Boris Pramatarov et Sophie Ung - Illustration, dessin, s\u00e9rigraphie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/tandemm.be\/expositions\/","email":"hello@tandemm.be","phone_contact":"+32 2 353 02 61","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50005678"},"nl":{"name":"1000 Little Troublemakers - Boris Pramatarov et Sophie Ung - Illustration, dessin, s\u00e9rigraphie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/tandemm.be\/expositions\/","email":"hello@tandemm.be","phone_contact":"+32 2 353 02 61","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50005678"}},"place":{"id":276391,"translations":{"de":{"name":"Tandemm","address_street_name":"chauss\u00e9e de Boondael","address_street_number":"293","address_street_box":null,"email":"laurence@tandemm.be","website":"http:\/\/www.tandemm.be","phone_contact":"+32 2 478 31 00","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"chauss\u00e9e de Boondael, 293","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Tandemm","address_street_name":"chauss\u00e9e de Boondael","address_street_number":"293","address_street_box":null,"email":"laurence@tandemm.be","website":"http:\/\/www.tandemm.be","phone_contact":"+32 2 478 31 00","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"chauss\u00e9e de Boondael, 293","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Tandemm","address_street_name":"chauss\u00e9e de Boondael","address_street_number":"293","address_street_box":null,"