ldout":false,"last_updated_at":"2024-12-17T14:52:03+01:00","published_at":"2024-12-17T14:45:53+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":314584,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"other","ranking":0.5848035476425733,"languages":{"spoken":["fr","nl"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{}},"translations":{"de":{"name":"How soon is now?","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lamaisondesarts.be\/","email":"info@lamaisondesarts.be","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 99","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700004720"},"pt":{"name":"How soon is now?","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lamaisondesarts.be\/","email":"info@lamaisondesarts.be","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 99","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700004720"},"en":{"name":"How soon is now?","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lamaisondesarts.be\/","email":"info@lamaisondesarts.be","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 99","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700004720"},"it":{"name":"How soon is now?","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lamaisondesarts.be\/","email":"info@lamaisondesarts.be","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 99","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700004720"},"cn":{"name":"How soon is now?","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lamaisondesarts.be\/","email":"info@lamaisondesarts.be","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 99","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700004720"},"fr":{"name":"How soon is now?","shortdescr":"14 jeunes artistes bruxellois croisent pass\u00e9 et pr\u00e9sent","longdescr":"\nLa curatrice Eline Dewit a r\u00e9uni 14 jeunes artistes et designers vivant \u00e0 Bruxelles. Navigant entre leurs histoires personnelles et les influences de leur ville adoptive, ils transmettent un pr\u00e9sent vibrant et en perp\u00e9tuel mouvement.  La Maison des Arts devient pour 10 jours un laboratoire d\u2019exp\u00e9rimentation et de libert\u00e9, croisant le d\u00e9cor et les disciplines artistiques.\n\nCette exposition explore la symbiose cr\u00e9ative entre pass\u00e9 et pr\u00e9sent, o\u00f9 le savoir-faire historique et le langage visuel prennent un nouveau sens aux c\u00f4t\u00e9s des m\u00e9dias et de la technologie. Le r\u00e9sultat est un dialogue riche entre ancien et moderne, le patrimoine servant de source d\u2019inspiration et de r\u00e9invention.\n\nDans un sens plus large, \u00ab How Soon is now? \u00bb joue avec la nature insaisissable du temps, puisque le \u00ab maintenant \u00bb est toujours en train de se produire mais s\u2019\u00e9chappe d\u00e8s qu\u2019on le reconna\u00eet. Cela nous rappelle que le moment pr\u00e9sent est perp\u00e9tuellement \u00e9ph\u00e9m\u00e8re, avan\u00e7ant constamment et d\u00e9fiant notre capacit\u00e9 \u00e0 le saisir.\n\nLes artistes de cette exposition, qui ne sont pas originaires de Bruxelles mais y habitent, naviguent entre leur h\u00e9ritage personnel et les influences de leur ville adoptive. Ils m\u00ealent ce qu\u2019ils apportent \u00e0 ce qu\u2019ils d\u00e9couvrent ici, capturant ainsi un pr\u00e9sent vibrant et en perp\u00e9tuel mouvement.\n\nCommissaire: Eline DEWIT\n\nArtistes :  C\u00e9leste Buyle, Emma Caers, Eline Dewit, Helena G., Lukas Gallon, Thomas Joostens, Aline Kesteman, Nicolas Peeters, Laure Robenek, Jacob Schoolmeester, Oscar Smith, Jeff Vander Veken & L\u00e9a Ware\n\n \n\n \n\nVernissage : 17\/01 \u2013 18 :00> 21 :00\nExposition 18\/01 > 26\/01\/25 \u2013 ferm\u00e9 le lundi\nGratuit","performers":null,"boxoffice_url":null,"website":"https:\/\/lamaisondesarts.be\/","email":"info@lamaisondesarts.be","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 99","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700004720"},"sp":{"name":"How soon is now?","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lamaisondesarts.be\/","email":"info@lamaisondesarts.be","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 99","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700004720"},"nl":{"name":"How soon is now?","shortdescr":"14 jonge Brusselse kunstenaars kruisen verleden en heden","longdescr":"\nDe curator Eline Dewit heeft 14 jonge kunstenaars en ontwerpers uit Brussel verzameld. Tussen hun persoonlijke verhalen en de invloeden van hun geadopteerde stad, brengen zij een levendig heden dat voortdurend in beweging is. Het Huis van de Kunsten wordt gedurende 10 dagen een laboratorium voor experimenten en vrijheid, waarin decor en kunstdisciplines elkaar kruisen.\n\nDeze tentoonstelling verkent de creatieve symbiose tussen verleden en heden, waar historisch vakmanschap en beeldtaal een nieuwe betekenis krijgen naast media en technologie. Het resultaat is een rijke dialoog tussen oud en nieuw, waarbij erfgoed fungeert als bron van inspiratie en heruitvinding.\n\nIn bredere zin speelt \u201cHow soon is now?\u201d met de ongrijpbare aard van tijd, aangezien \u201cnu\u201d altijd gebeurt, maar ook wegglipt zodra we het herkennen. Het herinnert ons eraan hoe het huidige moment voortdurend vluchtig is, steeds verder beweegt en moeilijk vast te houden is.\n\nDe kunstenaars in deze tentoonstelling, die oorspronkelijk niet uit Brussel komen maar de stad wel als hun thuis hebben gemaakt, navigeren tussen hun persoonlijke erfgoed en de invloeden van hun nieuwe stad. Ze vermengen wat ze meenemen met wat ze hier ontdekken en vangen zo een levendig en voortdurend veranderend nu.\n\n \n\nCourator: Eline DEWIT\n\nArtists :  C\u00e9leste Buyle, Emma Caers, Eline Dewit, Helena G., Lukas Gallon, Thomas Joostens, Aline Kesteman, Nicolas Peeters, Laure Robenek, Jacob Schoolmeester, Oscar Smith, Jeff Vander Veken & L\u00e9a Ware\n\n \n\n \n\nOpening : 17\/01 \u2013 18 :00> 21 :00\nTentoonstelling 18\/01 > 26\/01\/25 \u2013 gesloten op maandag\nGratis","performers":null,"boxoffice_url":null,"website":"https:\/\/lamaisondesarts.be\/","email":"info@lamaisondesarts.be","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 99","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700004720"}},"place":{"id":222932,"translations":{"de":{"name":"Maison des Arts","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 147","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Maison des Arts","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 147","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Maison des Arts","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 147","address_line2":"1030 Schaerbeek","description_web":"The MdA is run and staffed by the Francophone Cultural Service of Schaerbeek Council and is a unique place whose activities are mainly concerned with the creation of works of contemporary art with a significant partnership programme that promotes access for all to contemporary art.\r\n\r\nThe MdA has hosted a rich programme of artistic activities since the 1950s when the building was purchased by Schaerbeek Council. In 2005, the MdA began a programme of inviting artists to work in building, to build more coherence between their works of art and the MdA.\r\n\r\nMost recently, in 2016, Schaerbeek Council decided to position the MdA as a centre for the creation, diffusion and promotion of culture, contemporary two-dimensional, three-dimensional and digital art.\r\nThe MdA\u2019s educational and social approach aims to promoting equality of access to art and its introduction to new audiences.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Maison des Arts","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 147","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Maison des Arts","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 147","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Maison des Arts","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 147","address_line2":"1030 Schaerbeek","description_web":"La Maison des Arts, anim\u00e9e par le Service Culture fran\u00e7aise de la Commune de Schaerbeek, est un espace singulier dont les activit\u00e9s sont principalement ax\u00e9es sur la cr\u00e9ation contemporaine dans le domaine des arts plastiques avec un important programme de m\u00e9diation permettant l\u2019acc\u00e8s de l\u2019art contemporain \u00e0 tous.\r\n\r\nLa MA conna\u00eet une riche activit\u00e9 artistique depuis les ann\u00e9es \u201950, \u00e9poque \u00e0 laquelle la commune rach\u00e8te le b\u00e2timent. En 2005, elle se voit prendre un premier tournant en proposant aux artistes de travailler in situ, afin d\u2019\u00e9tablir une r\u00e9elle coh\u00e9rence entre l\u2019\u0153uvre et la Maison.\r\nEt finalement, c\u2019est en 2016 que la Commune de Schaerbeek d\u00e9cide de la positionner dans le domaine des arts plastiques, contemporains et num\u00e9riques comme un lieu de cr\u00e9ation, de diffusion et de rayonnement culturel.\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Maison des Arts","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 147","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Huis der Kunsten","address_street_name":"Haachtsesteenweg","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaarbeek","address_line1":"Haachtsesteenweg, 147","address_line2":"1030 Schaarbeek","description_web":"La Maison des Arts, geanimeerd door de dienst Franstalige Cultuur van de gemeente Schaarbeek, is een heel bijzondere plek. De activiteiten zijn vooral gericht op hedendaagse creativiteit in de plastische kunsten.\r\n\r\nIn La Maison des Arts heerst reeds sedert 1950 ( datum waarop de gemeente het huis aankocht) een ruime artistieke activiteit. In 2005 is er een belangrijke ontwikkeling : het voorstel aan de kunstenaars om ter plaatse te werken, teneinde een echte samenhang te bereiken tussen het werk en het Huis. Uiteindelijk beslist de Gemeente Schaarbeek er een echte broeikast van te maken in het domein van de beeldende kunsten, een bron van schepping, verspreiding en culturele uitstraling.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[20],"translations