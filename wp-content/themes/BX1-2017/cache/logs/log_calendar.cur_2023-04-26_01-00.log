translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen","it":"Visite guidate","sp":"Visitas guiadas","pt":null,"cn":null}},"others":{"list":[105],"translations":{"fr":["Gastronomie"],"nl":["Gastronomie"],"en":["Gastronomy"],"de":["Gastronomie"],"it":["Cucina"],"sp":["Gastronom\u00eda"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Visitez une ferme urbaine souterraine de 3.000m2.","shortdescr":"D\u00e9couvrez 3.000 m2 d'agriculture urbaine souterraine dans les mythiques Caves de Cureghem, au coeur de Bruxelles.","longdescr":"Venez d\u00e9couvrir en famille ou entre amis les magnifiques Caves de Cureghem et la ferme urbaine qu'elle abrite. Les caves s'\u00e9tendent sur environ 10.000 m\u00b2.\r\n\r\nQue comprend la visite ?\r\n- La visite comprend une projection vid\u00e9o et un parcours guid\u00e9 dans toutes les \u00e9tapes de production des champignons exotiques sur base dr\u00eaches de bi\u00e8re.\r\n- Notre guide vous fera d\u00e9couvrir tous les secrets des fabuleux champignons asiatiques cultiv\u00e9s par la jeune \u00e9quipe.\r\n- Vous d\u00e9couvrirez \u00e9galement une culture verticale de micropousses et herbes aromatiques !\r\n- INCLU : Repartez avec un sachet de 300g d'un m\u00e9lange de nos champignons frais, de quoi pr\u00e9parer une belle po\u00eal\u00e9e de champignons pour deux personnes !\r\n\r\nEst-ce possible d'acheter sur place ?\r\nOui ! Vous aurez \u00e9galement l'occasion d'acheter nos produits directement de la fourche \u00e0 la fourchette... plus local on ne peut pas ! Nous sommes munis d'un terminal bancontact.\r\n\r\nComment se rendre sur place ?\r\nRendez-vous \u00e0 l'adresse suivante: 24, bte 26, Rue Ropsy Chaudron, 1070 Anderlecht.\r\nTransports publics: Metro 2, 6 arr\u00eat : Clemenceau \/ Delacroix\r\nAcc\u00e8s PMR: Oui\r\n\r\nPour ne rien louper, vous recevrez lors de votre r\u00e9servation un mail de confirmation avec un plan d'acc\u00e8s \u00e0 nos locaux, ainsi qu'une notification de rappel quelques jours avant la visite.","performers":null,"boxoffice_url":null,"website":"https:\/\/eclo.farm\/fr\/visites\/","email":"info@eclo.farm","phone_contact":"+32 496 20 38 46","phone_booking":"+32 496 20 38 46","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.538345"},"nl":{"name":"Visitez une ferme urbaine souterraine de 3.000m2.","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/eclo.farm\/fr\/visites\/","email":"info@eclo.farm","phone_contact":"+32 496 20 38 46","phone_booking":"+32 496 20 38 46","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.538345"},"en":{"name":"Visitez une ferme urbaine souterraine de 3.000m2.","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/eclo.farm\/fr\/visites\/","email":"info@eclo.farm","phone_contact":"+32 496 20 38 46","phone_booking":"+32 496 20 38 46","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.538345"},"de":{"name":"Visitez une ferme urbaine souterraine de 3.000m2.","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/eclo.farm\/fr\/visites\/","email":"info@eclo.farm","phone_contact":"+32 496 20 38 46","phone_booking":"+32 496 20 38 46","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.538345"},"it":{"name":"Visitez une ferme urbaine souterraine de 3.000m2.","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/eclo.farm\/fr\/visites\/","email":"info@eclo.farm","phone_contact":"+32 496 20 38 46","phone_booking":"+32 496 20 38 46","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.538345"},"sp":{"name":"Visitez une ferme urbaine souterraine de 3.000m2.","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\