se,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung","it":"Esposizioni","sp":"Exhibici\u00f3n","pt":null,"cn":null}},"others":{"list":[36,40],"translations":{"fr":["Mus\u00e9es et art centers","Arts graphiques"],"nl":["Musea en kunstcentra","Grafische kunst, vormgeving"],"en":["Museums and art centers","Graphic art"],"de":["Museen & Kunstzentren","Grafische K\u00fcnste"],"it":["Musei e centri artistici","Arti grafiche"],"sp":["Museos y centros de arte","Artes gr\u00e1ficas"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","el","en"],"subtitles":[]},"translations":{"fr":{"name":"\"Par chance nous sommes en vie\" - MedexMuseum feat Lina Manousogiannaki","shortdescr":"Cette exposition a \u00e9t\u00e9 r\u00e9alis\u00e9e par le Mus\u00e9e \u00e9ph\u00e9m\u00e8re de l'exil en collaboration avec Lina Manousogiannaki. Ses connaissances en histoire, histoire de l'art et en arch\u00e9ologie nous guident dans le labyrinthe de la mythologie grecque. Lina exposera aussi quelques unes de ses \u0153uvres.","longdescr":"#\u03b1\u03c0\u03bf \u03c4\u03c5\u03c7\u03b7 \u03b6\u03bf\u03c5\u03bc\u03b5 \/ Par chance, nous sommes en vie.\r\n\r\nDans le labyrinthe de notre quotidien, les belles rencontres et le sens de l'humour nous font surmonter les \u00e9preuves et les monstres qui nous m\u00e8nent la vie dure.\r\n\r\nQuand la mythologie grecque envahit le MedexMuseum, \u00e7a donne un monde un peu fou. Un Luna Park o\u00f9 se racontent des histoires vieilles comme le monde, d'un ton sarcastique, comme il est d'usage de commenter les news au kafeneio du coin. On ferme les yeux et on s'imagine \u00e0 la terrasse d'un caf\u00e9 grec inond\u00e9 de soleil, o\u00f9 le temps passe sans que rien ne se passe ou ne change, et o\u00f9 on se dit qu'en l'\u00e9tat actuel des choses, c'est bien par chance que nous sommes vivants.\r\n\r\nVERNISSAGE \/ EXHIBITION OPENING \r\nJeudi - Thursday 13.04 (18h-22h)\r\nEntr\u00e9e gratuite - Free entrance\r\n\r\nPlus d'infos sur la page de l'\u00e9v\u00e8nement = https:\/\/fb.me\/e\/2kiHoOSy6","performers":"MedexMuseum ; Lina Manousogiannaki","boxoffice_url":null,"website":"https:\/\/fb.me\/e\/2kiHoOSy6","email":"medexmuseum@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.555070"},"nl":{"name":"\"Par chance nous sommes en vie\" - MedexMuseum feat Lina Manousogiannaki","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/fb.me\/e\/2kiHoOSy6","email":"medexmuseum@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.555070"},"en":{"name":"\"Par chance nous sommes en vie\" - MedexMuseum feat Lina Manousogiannaki","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/fb.me\/e\/2kiHoOSy6","email":"medexmuseum@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.555070"},"de":{"name":"EXPO \"Par chance nous sommes en vie\" #\u03b1\u03c0\u03bf \u03c4\u03c5\u03c7\u03b7 \u03b6\u03bf\u03c5\u03bc\u03b5 - MedexMuseum feat Lina Manousogiannaki","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/fb.me\/e\/2kiHoOSy6","email":"medexmuseum@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.555070"},"it":{"name":"EXPO \"Par chance nous sommes en vie\" #\u03b1\u03c0\u03bf \u03c4\u03c5\u03c7\u03b7 \u03b6\u03bf\u03c5\u03bc\u03b5 - MedexMuseum feat Lina Manousogiannaki","shortdescr":null,"longdescr":null,"per