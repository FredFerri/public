ed":false,"is_soldout":false,"categories":{"main":{"id":118,"translations":{"fr":"Festival","nl":"Festival","en":"Festival"}},"others":{}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"FAME","shortdescr":null,"longdescr":"FAME (Festival where Arts Meet Empowerment), c'est un nouveau festival des arts de la sc\u00e8ne sur Bruxelles ! L'id\u00e9e, c\u2019est de cr\u00e9er un dialogue entre les arts et les f\u00e9minismes, en promouvant les cr\u00e9ations d\u2019artistes femmes et issu\u00b7es des minorit\u00e9s de genre.\r\nCes nouveaux imaginaires sont \u00e0 d\u00e9couvrir \u00e0 travers des spectacles, performances, ateliers, rencontres, projections\u2026 Et beaucoup d\u2019autres coquineries.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.famefestival.be","email":"ticket@famefestival.be","phone_contact":null,"phone_booking":"+32 474 30 96 81","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.537724"},"nl":{"name":"FAME","shortdescr":null,"longdescr":"FAME (Festival where Arts Meet Empowerment) is een nieuwe podiumkunstenfestival op Brussel! Het idee is om een dialoog tot stand te brengen tussen kunst en feminism, en de creaties van vrouwelijke kunstenaars en kunstenaars uit genderminderheden promoten.\r\nDeze nieuwe denkbeeldige moeten ontdek worden via voorstellingen, optredens, workshops, ontmoetingen, screenings\u2026 En vele andere geintjes.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.537724"},"en":{"name":"FAME","shortdescr":null,"longdescr":"FAME (Festival where Arts Meet Empowerment) is a new performing arts festival in Brussels! The idea is to create a dialogue between the arts and feminisms, as well as to encourage the creations of female and gender minority artists.\r\nThese new narratives are to be approached through shows, performances, workshops, meetings, screenings\u2026 And many other shenanigans.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.537724"},"de":{"name":"FAME","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.537724"},"it":{"name":"FAME","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.537724"},"sp":{"name":"FAME","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.537724"},"pt":{"name":"FAME","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.537724"},"cn":{"name":"FAME","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.537724"}},"place":{"id":1085,"translations":{"fr":{"name":"Les Riches-Claires","address_street_name":"Rue des Riches Claires","address_street_number":"24","address_street_box":null,"email":"accueil@lesrichesclaires.be","website":"http:\/\/www.lesrichesclaires.be","phone_contact":"+32 2 548 25 80","phone_booking":"+32 2 548 25 80","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Riches Claires, 24","address_line2":"1000 Bruxelles","description_web":"Le centre culturel Les Riches-Claires est ouvert \u00e0 toutes les disciplines des arts de la sc\u00e8ne, situ\u00e9 \u00e0 deux pas de la Place Saint-G\u00e9ry et de la Bourse. Le lieu se d\u00e9finit comme une rampe de lancement pour les jeunes artistes tout en permettant aux compagnies confirm\u00e9es de tenter de nouvelles exp\u00e9riences. Par sa programmation, originale et accessible, les Riches-Claires cherchent \u00e0 perp\u00e9tuer sa tradition de sc\u00e8ne th\u00e9\u00e2trale privil\u00e9giant l'humour, tout en offrant un espace d\u2019expression \u00e0 la danse contemporaine, la musique et le cin\u00e9ma.\r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Les Riches-Claires","address_street_name":"Rijkeklarenstraat","address_street_number":"24","address_street_box":null,"email":"accueil@lesrichesclaires.be","website":"http:\/\/www.lesrichesclaires.be","phone_contact":"+32 2 548 25 80","phone_booking":"+32 2 548 25 80","address_zip":"1000","address_city":"Brussel","address_line1":"Rijkeklarenstraat, 24","address_line2":"1000 Brussel","description_web":"Riches-Claires is een cultureel centrum open voor alle disciplines van de podiumkunsten, gelegen op slechts een steenworp afstand van het Sint-Goriksplein en de Beurs. De plaats definieert zich als een lanceerplatform voor jonge kunstenaars terwijl gevestigde waarden er kunnen experimenteren. Met haar originele en toegankelijke programmering wil de instelling zijn traditie aan humoristisch theater  bestendigen terwijl het ook ruimte wil verstrekken voor expressie in hedendaagse dans, muziek en film.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Les Riches-Claires","address_street_name":"Rue des Riches Claires","address_street_number":"24","address_street_box":null,"email":"accueil@lesrichesclaires.be","website":"http:\/\/www.lesrichesclaires.be","phone_contact":"+32 2 548 25 80","phone_booking":"+32 2 548 25 80","address_zip":"1000"