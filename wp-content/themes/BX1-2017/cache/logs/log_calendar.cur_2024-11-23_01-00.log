 trouv\u00e9 asile ailleurs. Lieu de cr\u00e9ation, de production et de diffusion, l\u2019Espace Magh propose une programmation ouverte, contemporaine et pluridisciplinaire, ainsi que des ateliers et des stages. Ce programme a pour but de contribuer au rayonnement des expressions multiculturelles, artistiques, intellectuelles et litt\u00e9raires.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Centre culturel Espace Magh asbl","address_street_name":"Rue du Poin\u00e7on","address_street_number":null,"address_street_box":null,"email":"info@espacemagh.be","website":"http:\/\/www.espacemagh.be","phone_contact":"+32 2 274 05 10","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Poin\u00e7on","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Centre culturel Espace Magh asbl","address_street_name":"Priemstraat","address_street_number":null,"address_street_box":null,"email":"info@espacemagh.be","website":"http:\/\/www.espacemagh.be","phone_contact":"+32 2 274 05 10","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Priemstraat","address_line2":"1000 Brussel","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":9493,"location":{"lat":50.84352692,"lon":4.34863877},"last_updated_at":"2023-02-15T17:26:53+01:00","published_at":"2013-10-19T01:26:14+02:00","is_in_address_book":true,"is_in_vb_export":false,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/4c2310686e688564f3ac9d89914e8c0320043afb.png","width":2630,"height":1758,"ratio":1.5,"oEmbed_height":1758,"oEmbed_width":2630,"translations":{"de":{"title