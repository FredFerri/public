cept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert","de":"Konzert","it":"Concerti","sp":"Concierto","pt":null,"cn":null}},"others":{"list":[3],"translations":{"fr":["Musique Contemporaine"],"nl":["Hedendaagse Muziek"],"en":["Contemporary music"],"de":["Zeitgen\u00f6ssische Musik"],"it":["Musica contemporanea"],"sp":["M\u00fasica contempor\u00e1nea"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Go\u00fbter du Karreveld : Des Anches passent - Bal des familles","shortdescr":"Les Jeunesses Musicales de Bruxelles vous convient \u00e0 un rendez-vous musical familial dans le cadre exceptionnel du Ch\u00e2teau du Karreveld ! Le temps d\u2019un apr\u00e8s-midi, familles, amis et artistes se retrouvent pour faire et \u00e9couter de la musique ensemble.","longdescr":"Les Jeunesses Musicales de Bruxelles vous convient \u00e0 un rendez-vous musical familial dans le cadre exceptionnel du Ch\u00e2teau du Karreveld ! Le temps d\u2019un apr\u00e8s-midi, familles, amis et artistes se retrouvent pour faire et \u00e9couter de la musique ensemble.\r\n\r\nRaquel et Marc, \u00ab f\u00eal\u00e9s \u00bb de tradition et de cr\u00e9ation, nous font d\u00e9couvrir avec amour et humour une musique traditionnelle d\u00e9poussi\u00e9r\u00e9e, quelques chansons, perles rares et en perdition, ainsi que l\u2019 \u201c\u00e2me\u201d et le \u201cventre\u201d de divers instruments, fruits d\u2019un patient collectage r\u00e9alis\u00e9 en Wallonie. Une invitation \u00e0 visiter avec tendresse et humilit\u00e9 les chaumi\u00e8res de nos grands-parents.\r\n\r\nRaquel et Marc mettent \u00e0 l\u2019honneur ce r\u00e9pertoire wallon, et plus largement europ\u00e9en, au travers d\u2019instruments munis d\u2019anches, aussi vari\u00e9s que la bombarde, l\u2019accord\u00e9on, la cornemuse, la guimbarde\u2026, compl\u00e9t\u00e9s de la voix et du violon trompette, sans anche, mais qui font partie int\u00e9grante de la musique traditionnelle.\r\n\r\nRejoints pour l\u2019occasion par leur comparse Fr\u00e9d\u00e9ric, le trio vous initiera aux danses traditionnelles wallonnes lors d\u2019un bal des familles endiabl\u00e9 !","performers":"Raquel\r\nMarc","boxoffice_url":null,"website":"https:\/\/www.jeunessesmusicales.be\/bruxelles\/des-anches-passent-chateau-du-karreveld\/","email":"jmbxl@jeunessesmusicales.be","phone_contact":"+32 2 897 01 70","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.543932"},"nl":{"name":"Go\u00fbter du Karreveld : Des Anches passent - Bal des familles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.jeunessesmusicales.be\/bruxelles\/des-anches-passent-chateau-du-karreveld\/","email":"jmbxl@jeunessesmusicales.be","phone_contact":"+32 2 897 01 70","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.543932"},"en":{"name":"Go\u00fbter du Karreveld : Des Anches passent - Bal des familles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.jeunessesmusicales.be\/bruxelles\/des-anches-passent-chateau-du-karreveld\/","email":"jmbxl@jeunessesmusicales.be","phone_contact":"+32 2 897 01 70","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.543932"},"de":{"name":"Go\u00fbter du Karreveld : Des Anches passent - Bal des familles \u00e0 partir de 5 ans","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.jeunessesmusicales.be\/bruxelles\/des-anches-passent-chateau-du-karreveld\/","email":"jmbxl@jeunessesmusicales.be","phone_contact":"+32 2 897 01 70","phone_booking":null,"age