nt":false,"backoffice_id":317938,"facebook_link":null,"import_origin":null,"is_part_of":"Art Deco 2025","sub_type":"tour","ranking":0.7937005259840998,"languages":{"spoken":["nl","en","fr"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{"list":[253],"translations":{"de":["F\u00fchrungen durch Innenr\u00e4ume"],"pt":[null],"en":["Interior guided tours"],"it":["Visite guidate all\u2019interno"],"cn":[null],"fr":["Visites guid\u00e9es d\u2019int\u00e9rieurs"],"sp":["Visitas guiadas en espacios interiores"],"nl":["Interieur rondleidingen"]}}},"translations":{"de":{"name":"BANAD Festival - Guided tour of the Danckaert Mansion","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700006411"},"pt":{"name":"BANAD Festival - Guided tour of the Danckaert Mansion","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700006411"},"en":{"name":"BANAD Festival - Danckaert Mansion","shortdescr":null,"longdescr":"This attached Art Deco villa designed by the architect Jean-Baptiste Dewin in 1922 for the industrialist Jean Danckaert, bears witness to the way of life of a member of the industrialist Brussels bourgeoisie between the two World Wars. On the street side, the property is divided into three parts: on the left there is an attached house, in the middle a rose garden, and on the right a garage. This first cooperative project between J.B. Dewin and the Ateliers De Coene has kept its original decoration in terms of woodwork, fittings, locks, fireplaces, stained glass windows and sinks. Today the Danckaert Villa and part of its garden, listed in 2016, houses the Design Maniera Gallery.\n\nArch. Jean-Baptiste DEWIN, 1922","performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/en\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700006411"},"it":{"name":"BANAD Festival - Guided tour of the Danckaert Mansion","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700006411"},"cn":{"name":"BANAD Festival - Guided tour of the Danckaert Mansion","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700006411"},"fr":{"name":"BANAD Festival - H\u00f4tel Danckaert","shortdescr":null,"longdescr":"Villa trois fa\u00e7ades de style Art D\u00e9co con\u00e7ue par l'architecte Jean-Baptiste Dewin en 1922 pour l'industriel Jean Danckaert. T\u00e9moignage remarquable de l'habitat d\u00e9stin\u00e9 \u00e0 une bourgeoisie bruxelloise et industrielle de l'entre-deux-guerres, cette grande propri\u00e9t\u00e9 se d\u00e9veloppe \u00e0 front de rue en trois s\u00e9quences originales : \u00e0 gauche une maison trois fa\u00e7ades, au centre un jardin pourvu d'une roseraie et \u00e0 droite un garage. Premier travail de collaboration entre J-B Dewin et les Ateliers De Coene, cet h\u00f4tel de ma\u00eetre a conserv\u00e9 son d\u00e9cor d'origine avec boiseries, quincailleries, serrurerie, chemin\u00e9es, vitraux et \u00e9viers. Class\u00e9e depuis 2016, La villa Danckaert, ainsi qu'une partie de son jardin, accueille aujourd'hui la galerie Design Maniera.\n\nArch. Jean-Baptiste DEWIN, 1922","performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700006411"},"sp":{"name":"BANAD Festival - Guided tour of the Danckaert Mansion","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700006411"},"nl":{"name":"BANAD Festival - Danckaert Herenhuis","shortdescr":null,"longdescr":"Villa uit 1922 in art-decostijl ontworpen voor de industrieel Jean Danckaert door architect Jean-Baptiste Dewin, die hierbij voor het eerst samenwerkte met de Ateliers De Coene. Vanaf de straatkant bekeken, treffen we links een statige driegevelvilla, in het midden een rozentuin en rechts een garage aan. De villa illustreert perfect de woonvoorkeuren van de Brusselse bourgeoisie uit het interbellum en heeft zijn originele decoratie weten te bewaren; de houten lambriseringen, het verfijnde ijzerwerk, de schouwen, glas-in-loodramen en wastafels zijn allemaal authentiek gebleven. Vandaag heeft in de woning, die sinds 2016 samen met een deel van de tuin beschermd is, de galerie Design Maniera haar intrek genomen.\n\nArch. Jean-Baptiste DEWIN, 1922","performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/nl\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700006411"}},"place":{"i