32 2 609 55 61","phone_booking":"+32 2 609 55 61","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700006768"},"nl":{"name":"Kinderen in oorlogsgebieden","shortdescr":"De tentoonstelling \"Kinderen in oorlgsgebieden\" in het MigratieMuseumMigration nodigt bezoekers uit om van 15 maart tot 30 april aangrijpende foto's te ontdekken die de realiteit van kinderen in conflictgebieden illustreren.\n","longdescr":"De tentoonstelling \"Kinderen in oorlgsgebieden\" in het MigratieMuseumMigration nodigt bezoekers uit om van 15 maart tot 30 april aangrijpende foto's te ontdekken die de realiteit van kinderen in conflictgebieden illustreren.\n\nDeze tentoonstelling toont het werk van gerenommeerde fotografen zoals Areej Shaheen, Doaa Al-Baz, Fadi Badwan, Haneen Salem, Mohammad Asad, Mahmoud Abu Hamda, Rojin Ferho en Franky Verdickt.\n\nVoor meer informatie of om uw bezoek te reserveren, kunt u contact opnemen met het museum via e-mail op res.museum@foyer.be of telefonisch op +32 2 609 55 61.\n\n\n","performers":"Fotografen:\nAreej Shaheen, Doaa Al-Baz,Fadi Badwan, Haneen Salem, Mohammad Asad\nMahmoud Abu Hamda, Rojin Ferho, Franky Verdickt","boxoffice_url":null,"website":"https:\/\/mmm.brussels\/","email":"res.museum@foyer.be","phone_contact":"+32 2 609 55 61","phone_booking":"+32 2 609 55 61","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700006768"}},"place":{"id":274307,"translations":{"de":{"name":"MigratieMuseumMigration","address_street_name":"rue des ateliers","address_street_number":"17","address_street_box":null,"email":"museum@foyer.be","website":"http:\/\/www.migratiemuseummigration.be","phone_contact":"+32 2 609 55 61","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue des ateliers, 17","address_line2":"1080 Molenbeek-Saint-Jean","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"nam