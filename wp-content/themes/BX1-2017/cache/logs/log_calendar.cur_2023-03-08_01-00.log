:"00:00:00","end":null},{"day":"2023-06-21","doors":null,"start":"00:00:00","end":null},{"day":"2023-06-22","doors":null,"start":"00:00:00","end":null},{"day":"2023-06-23","doors":null,"start":"00:00:00","end":null},{"day":"2023-06-24","doors":null,"start":"00:00:00","end":null},{"day":"2023-06-25","doors":null,"start":"00:00:00","end":null},{"day":"2023-06-26","doors":null,"start":"00:00:00","end":null},{"day":"2023-06-27","doors":null,"start":"00:00:00","end":null},{"day":"2023-06-28","doors":null,"start":"00:00:00","end":null},{"day":"2023-06-29","doors":null,"start":"00:00:00","end":null},{"day":"2023-06-30","doors":null,"start":"00:00:00","end":null}],"weekschema":[{"days":{"monday":{"is_open":false},"tuesday":{"is_open":false},"wednesday":{"is_open":false},"thursday":{"is_open":false},"friday":{"is_open":false},"saturday":{"is_open":false},"sunday":{"is_open":false}},"translations":{"fr":["lundi, mardi, mercredi, jeudi, vendredi, samedi et dimanche: ferm\u00e9"],"nl":["maandag, dinsdag, woensdag, donderdag, vrijdag, zaterdag en zondag: gesloten"],"en":["monday, tuesday, wednesday, thursday, friday, saturday and sunday: closed"],"de":["monday, tuesday, wednesday, thursday, friday, saturday and sunday: closed"],"it":["monday, tuesday, wednesday, thursday, friday, saturday and sunday: closed"],"sp":["monday, tuesday, wednesday, thursday, friday, saturday and sunday: closed"],"pt":["monday, tuesday, wednesday, thursday, friday, saturday and sunday: closed"],"cn":["monday, tuesday, wednesday, thursday, friday, saturday and sunday: closed"]},"date_start":"2022-12-22","date_end":"2023-06-30","is_also_by_appointment":false}],"prices":[{"translations":{"fr":{"name":"Groupe"},"nl":{"name":"Groep"},"en":{"name":"Group"},"de":{"name":"Gruppe"},"it":{"name":"Gruppi"},"sp":{"name":"Grupo"},"pt":{"name":"Groupe"},"cn":{"name":"Groupe"}},"value":85}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":{"list":[252,263,266],"translations":{"fr":["Accessible aux personnes ayant des difficult\u00e9s de compr\u00e9hension","Accessible aux pi\u00e9tons appareill\u00e9s","Brussels Health Safety Label"],"nl":["Toegankelijk voor mensen met een verstandelijke beperking","Toegankelijk voor voetgangers met hulpmiddelen","Brussels Health Safety Label"],"en":["Accessible to people with intellectual disabilities","Accessible to pedestrians with mobility aids","Brussels Health Safety Label"],"de":["Barrierefrei f\u00fcr Menschen mit Verst\u00e4ndnisschwierigkeiten","Barrierefrei f\u00fcr Fu\u00dfg\u00e4nger mit Gehhilfe","Brussels Health Safety Label"],"it":["Accessibile alle persone con difficolt\u00e0 di comprensione","Accessibile ai pedoni con supporti","Brussels Health Safety Label"],"sp":["Habilitado para personas con dificultades de comprensi\u00f3n","Habilitado para peatones con aud\u00edfonos","Brussels Health Safety Label"],"pt":[null,null,null],"cn":[null,null,null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2023-03-07T02:35:10+01:00","published_at":"2022-12-22T13:55:27+01:00","backoffice_id":267984,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.21915874168444},{"id":545251,"date_start":"2022-12-15","date_end":"2023-06-30","date_next":"2023-03-07","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung","it":"Esposizioni","sp":"Exhibici\u00f3n","pt":null,"cn":null}},"others":{"list":[36,46],"translations":{"fr":["Mus\u00e9es et art centers","Pluridisciplinaire"],"nl":["Musea en kunstcentra","Multidisciplinair"],"en":["Museums and art centers","Multidisciplinary"],"de":["Museen & Kunstzentren","Multidisziplin\u00e4r"],"it":["Musei e centri artistici","Multidisciplinare"],"sp":["Museos y centros de arte","Multidisciplinar"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"175 - Galeries Royales Saint-Hubert","shortdescr":"Les Galeries Royales Saint-Hubert f\u00eatent leurs 175 ans !","longdescr":"L\u2019occasion d\u2019une exLes Galeries Royales Saint-Hubert f\u00eatent leurs 175 ans. position retra\u00e7ant son histoire, sa gen\u00e8se, son implication dans la ville et dans la vie de Bruxelles et de la Belgique, \u00e0 travers ses th\u00e9\u00e2tres, son cin\u00e9ma, ses restaurants et caf\u00e9s, ses commerces et ses habitants. Quelque 150 documents, plans, photos, r\u00e9centes et anciennes, \u0153uvres d\u2019art, tous li\u00e9s \u00e0 son implantation centrale dans la capitale. Vous pourrez d\u00e9couvrir \u00e9galement tous les projets \u00e0 venir des Galeries, tant urbanistiques que patrimoniaux, dans le c\u0153ur de Bruxelles et \u00e0 l\u2019\u00e9tranger\u00a0!","performers":null,"boxoffice_url":null,"website":"https:\/\/forms.gle\/6UAwUTs4SxhL8Zo98","email":"ldo@grsh.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.545251"},"nl":{"name":"175 - Galeries Royales Saint-Hubert","shortdescr":"De Koninklijke Sint-Hubertusgalerijen vieren hun 175-jarig bestaan!","longdescr":"Dit is de ideale gelegenheid om een tentoonstelling te organiseren over de geschiedenis en het ontstaan van deze plek, maar ook de invloed die de galerijen hadden op de stad en het leven in Brussel en Belgi\u00eb, dankzij de bioscoop, de talrijke theaters, restaurants en caf\u00e9s, maar ook de handelszaken en de bewoners. Ontdek meer dan 150 documenten, plannen, (recente en oude) foto\u2019s, kunstwerken, met als rode draad de centrale ligging in de hoofdstad. Daarnaast kan u ook alle toekomstige stedenbouwkundige en erfgoedprojecten voor de Galerijen ontdekken, zowel in het hartje van Brussel als ver daar buiten!\r\nThe Galeries Royales Saint-Hubert are celebrating their 175th anniversary. The perfect time for an exhibition dedicated to its history, its origins, its relationship with the city and the life of Brussels and of Belgium, thanks to its theatres, its cinema, its restaurants and caf\u00e9s, its shops and its residents. Some 150 documents, plans, photos, from the modern day and times gone by, as well as works of art, all connected to its central location in the capital. You will also be able to find out more about all the plans that the Galeries have to look forward to, including projects relating to urban planning and heritage, right in the heart of Brussels as well as abroad","performers":null,"boxoffice_url":null,"website":"https:\/\/forms.gle\/6UAwUTs4SxhL8Zo98","email":"ldo@grsh.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.545251"},"en":{"name":"175 - Galeries Royales Saint-Hubert","shortdescr":"The Galeries Royales Saint-Hubert are celebrating their 175th anniversary!","longdescr":"The perfect time for an exhibition dedicated to its history, its origins, its relationship with the city and the life of Brussels and of Belgium, thanks to its theatres, its cinema, its restaurants and caf\u00e9s, its shops and its residents. Some 150 documents, plans, photos, from the modern day and times gone by, as well as works of art, all connected to its central location in the capital. You will also be able to find out more about all the plans that the Galeries have to look forward to, including projects relating to urban planning and heritage, right in the heart of Brussels as well as abroad","performers":null,"boxoffice_url":null,"website":"https:\/\/forms.gle\/6UAwUTs4SxhL8Zo98","email":"ldo@grsh.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.545251"},"de":{"name":"175 - Galeries Royales Saint-Hubert","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/forms.gle\/6UAwUTs4SxhL8Zo98","email":"ldo@grsh.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.545251"},"it":{"name":"175 - Galeries Royales Saint-Hubert","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/forms.gle\/6UAwUTs4SxhL8Zo98","email":"ldo@grsh.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.545251"},"sp":{"name":"175 - Galeries Royales Saint-Hubert","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/forms.gle\/6UAwUTs4SxhL8Zo98","email":"ldo@grsh.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.545251"},"pt":{"name":"175 - Galeries Royales Saint-Hubert","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/forms.gle\/6UAwUTs4SxhL8Zo98","email":"ldo@grsh.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.545251"},"cn":{"name":"175 - Galeries Royales Saint-Hubert","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/forms.gle\/6UAwUTs4SxhL8Zo98","email":"ldo@grsh.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.545251"}},"place":{"id":250994,"translations":{"fr":{"name":"Cin\u00e9ma Galeries","address_street_name":"Galerie de la Reine","address_street_number":"26","address_street_box":null,"email":null,"website":"http:\/\/www.galeries.be\/","phone_contact":"+32 2 514 74 98","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Galerie de la Reine, 26","address_line2":"1000 Bruxelles","description_web":"Le lieu est compos\u00e9 de deux salles de cin\u00e9ma, d\u2019une grande salle d\u2019exposition de 1000 m2, et d\u2019un bar.\r\nConstruit en 1939 par l\u2019architecte Paul Bonduelle, le cin\u00e9ma est class\u00e9 comme monument depuis 1993 en raison de sa valeur historique et artistique; le style du cin\u00e9ma se situe entre l\u2019Art d\u00e9co et le Modernisme et se distingue par une d\u00e9coration subtilement m\u00e9diterran\u00e9enne et romane. Depuis, le CINEMA GALERIES a pris des initiatives afin de d\u00e9velopper et d\u2019am\u00e9liorer la qualit\u00e9 de ce lieu exceptionnel. La r\u00e9novation du cin\u00e9ma initi\u00e9e il y a trois ans est maintenant termin\u00e9e. Dans les salles, le changement du syst\u00e8me son offre une meilleure exp\u00e9rience acoustique.\r\n\r\nLieu consacr\u00e9 aux films d'auteurs, Cinema Galeries propose \u00e9galement un large programme d'expositions d\u00e9di\u00e9 au cin\u00e9ma ind\u00e9pendant et \u00e0 l'art contemporain. De nombreux artistes contemporains comme Eric Baudelaire, Amos Gitai, David Lynch, ... ont \u00e9t\u00e9 invit\u00e9s \u00e0 pr\u00e9senter leur travail, toujours en relation avec le cin\u00e9ma. L'une des missions les plus importantes de CINEMA GALERIES est de soutenir le jeune film belge. Dans le cadre de son partenariat avec KissKissBankBank, le cin\u00e9ma permet \u00e0 son public de d\u00e9couvrir de nouveaux projets.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Cinema Galeries","address_street_name":"Koninginnegalerij","address_street_number":"26","address_street_box":null,"email":null,"website":"http:\/\/www.galeries.be\/","phone_contact":"+32 2 514 74 98","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Koninginnegalerij, 26","address_line2":"1000 Brussel","description_web":"CINEMA GALERIES is een plaats gewijd aan \u2018cinema in al zijn vormen\u2019 in de Koninklijke Sint-Hubertusgalerijen en bestaat uit twee cinemazalen, een expositieruimte van 1000m2 en een nieuwe bar. \r\nCINEMA GALERIES is een unieke plek in het historisch centrum, gebouwd in 1939 door de architect Paul Bonduelle en geklasseerd als monument sinds 1993 wegens zijn historische en artistieke waarde. De stijl van de cinema bevindt zich tussen Art Deco en Modernisme en onderscheidt zich door een unieke decoratie. De unieke zaal met 600 plaatsen is in 1973 omgevormd door de architect Danlee waardoor er ook een tweede zaal op de eerste verdieping werd toegevoegd. \r\nSindsdien heeft CINEMA GALERIES initiatieven genomen om de kwaliteit van deze uitzonderlijke plaats te verbeteren. \r\nDe renovatie van de bioscoop werd drie jaar geleden ingeleid en is nu voltooid. In de filmzalen is het geluidssysteem veranderd met een betere geluidservaring als gevolg. \r\n\r\nCinema Galeries biedt een breed programma aan festivals en tentoonstellingen gewijd aan de onafhankelijke film en hedendaagse kunst. Veel hedendaagse artiesten als Eric Baudelaire, Amos Gitai, David Lynch, ... werden uitgenodigd om hun werk te presenteren, altijd in relatie tot film. Ook het ondersteunen van de jonge Belgische film is een belangrijke missie van CINEMA GALERIES. In het kader van het partnerschap met KissKissBankBank geeft de bioscoop zijn publiek  de kans om nieuwe projecten te ontdekken.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Cinema Galeries","address_street_name":"Galerie de la Reine","address_street_number":"26","address_street_box":null,"email":null,"website":"http:\/\/www.galeries.be\/","phone_contact":"+32 2 514 74 98","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Galerie de la Reine, 26","address_line2":"1000 Brussels","description_web":"An emblematic venue for creative movies and festivals, CINEMA GALERIES also offers a wide programme of exhibitions dedicated to independent cinema and contemporary art. Many contemporary artists like Eric Baudelaire, Amos Gitai, David Lynch, etc. have been invited to present work related to cinema. Another important mission of CINEMA GALERIES is to support young Belgian film-making. The cinema's audience gets the chance to discover new projects thanks to its partnership with KissKissBankBank.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Cinema Galeries","address_street_name":"Galerie de la Reine","address_street_number":"26","address_street_box":null,"email":null,"website":"http:\/\/www.galeries.be\/","phone_contact":"+32 2 514 74 98","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Galerie de la Reine, 26","address_line2":"1000 Bruxelles","description_web":"Das CINEMA GALERIES besteht aus zwei Kinos\u00e4len, einem gro\u00dfen Ausstellungsraum von 1000 m2 und einer Bar.\r\nDas 1939 von dem Architekten Paul Bonduelle erbaute Kino steht seit 1993 wegen seines historischen und k\u00fcnstlerischen Wertes unter Denkmalschutz; der Stil des Kinos liegt zwischen Art-d\u00e9co und Modernismus und zeichnet sich durch eine subtile mediterrane und romanische Dekoration aus. Seitdem hat das CINEMA GALERIES verschiedene Initiativen ergriffen, um die Qualit\u00e4t dieses Filmkunsttempels weiterzuentwickeln. Die vor drei Jahren in Angriff genommene Renovierung des Kinos ist inzwischen abgeschlossen. In den Kinos\u00e4len bietet das neue Soundsystem ein besseres akustisches Erlebnis.\r\n\r\nCinema Galeries ist ein Ort, der sich voll und ganz den Autorenfilmen verschrieben hat und bietet dar\u00fcber hinaus vielf\u00e4ltige Ausstellungen, die dem unabh\u00e4ngigen Kino und der zeitgen\u00f6ssischen Kunst gewidmet sind. Viele zeitgen\u00f6ssische K\u00fcnstler wie Eric Baudelaire, Amos Gitai, David Lynch, ... haben hier bereits ihre Werke pr\u00e4sentiert, die stets in Verbindung mit dem Kino stehen. Eine der wichtigsten Aufgaben des CINEMA GALERIES ist die F\u00f6rderung junger belgischer Filme. Im Rahmen der Partnerschaft mit der KissKissBankBank erm\u00f6glicht das Kino seinem Publikum, neue Projekte zu entdecken.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Cinema Galeries","address_street_name":"Galerie de la Reine","address_street_number":"26","address_street_box":null,"email":null,"website":"http:\/\/www.galeries.be\/","phone_contact":"+32 2 514 74 98","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Galerie de la Reine, 26","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Cinema Galeries","address_street_name":"Galerie de la Reine","address_street_number":"26","address_street_box":null,"email":null,"website":"http:\/\/www.galeries.be\/","phone_contact":"+32 2 514 74 98","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Galerie de la Reine, 26","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Cin\u00e9ma Galeries","address_street_name":"Galerie de la Reine","address_street_number":"26","address_street_box":null,"email":null,"website":"http:\/\/www.galeries.be\/","phone_contact":"+32 2 514 74 98","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Galerie de la Reine, 26","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Cin\u00e9ma Galeries","address_street_name":"Galerie de la Reine","address_street_number":"26","address_street_box":null,"email":null,"website":"http:\/\/www.galeries.be\/","phone_contact":"+32 2 514 74 98","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Galerie de la Reine, 26","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[13],"translations":{"fr":["Centre historique"],"nl":["Historisch centrum"],"en":["Historical Centre"],"de":["Historisches Stadtzentrum"],"it":["Centro storico"],"sp":["Centro hist\u00f3rico"],"pt":[null],"cn":[null]}},"zones":{"list":[19],"translations":{"fr":["Centre"],"nl":["Centrum"],"en":["Centre"],"de":["Zentrum"],"it":["Centro"],"sp":["Centro"],"pt":[null],"cn":[null]}},"neca":null,"facebook_id":null,"backoffice_id":13088,"location":{"lat":50.84744224,"lon":4.35461261},"region":"brussels","last_updated_at":"2023-03-07T02:35:10+01:00","published_at":"2013-10-19T01:35:51+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":246324,"translations":{"fr":{"name":"Galeries Royales Saint-Hubert","address_street_name":"Galerie du Roi","address_street_number":"5","address_street_box":null,"email":null,"website":"https:\/\/www.grsh.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Galerie du Roi, 5","address_line2":"1000 Bruxelles","description_web":"Initi\u00e9 par l\u2019architecte Jean-Pierre Cluysenaer, le projet grandiose des Galeries royales prit corps dans les ann\u00e9es 1830. Les travaux, commenc\u00e9s en 1846, furent presque termin\u00e9s pour l\u2019inauguration officielle du 20 juin 1847. \r\n\r\nLa galerie combinait magasins, salles de spectacles, caf\u00e9s, restaurants et appartements. Lieu de promenade \u00e0 la mode, les Galeries royales Saint-Hubert ont, d\u00e8s le d\u00e9part, attir\u00e9 un large public s\u00e9duit par ses enseignes de luxe, ses \u00e9l\u00e9gants caf\u00e9s et ses lieux de culture. Notons, entre autres, le Th\u00e9\u00e2tre du Vaudeville et le Cin\u00e9ma des Galeries ou la Taverne du Passage, appel\u00e9e jusqu\u2019en 1892 Caf\u00e9 des Arts et lieu de rendez-vous des peintres et des \u00e9crivains de l\u2019\u00e9poque. La colonie de r\u00e9fugi\u00e9s fran\u00e7ais, comme Victor Hugo, Alexandre Dumas, Edgar Quinet et d\u2019autres, s\u2019y rassemblaient. Ainsi, les peintres surr\u00e9alistes ou les artistes du groupe Cobra furent des assidus du lieu. \r\n\r\nEnfin, une plaque comm\u00e9morative rappelle la premi\u00e8re repr\u00e9sentation du cin\u00e9matographe des Fr\u00e8res Lumi\u00e8re, le 1er mars 1896, dans l\u2019ancienne salle des d\u00e9p\u00eaches du quotidien La Chronique (au-dessus de la p\u00e2tisserie Meert, Galerie du Roi).","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Koninklijke Sint-Hubertusgalerijen","address_street_name":"Koningsgalerij","address_street_number":"5","address_street_box":null,"email":null,"website":"https:\/\/www.grsh.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Koningsgalerij, 5","address_line2":"1000 Brussel","description_web":"Het grandioze project van de Koninklijke Galerijen werd reeds vanaf de jaren 1830 voorbereid door architect Jean-Pierre Cluysenaer. De eigenlijke bouw begon in 1846 en was bijna voltooid bij de offici\u00eble opening op 20 juni 1847.\r\n\r\nDe galerijen combineerden winkels, spektakelzalen, caf\u00e9s, restaurants en appartementen op de verdiepingen. De modieuze promenade trok van meet af aan een talrijk publiek dat aangelokt werd door de luxewinkels, de elegante caf\u00e9s en culturele attractiepolen. We vermelden onder andere het La Chronique (boven banketbakkerij Meert in de Koningsgalerij).","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Galeries Royales Saint-Hubert","address_street_name":"Galerie du Roi","address_street_number":"5","address_street_box":null,"email":null,"website":"https:\/\/www.grsh.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Galerie du Roi, 5","address_line2":"1000 Brussels","description_web":"Initiated by the architect Jean-Pierre Cluysenaer, the spectacular Galeries Royales project took shape in the 1830's. The works, begun in 1846, were almost completed in time for the official opening on 20 June 1847. \r\n\r\nThe gallery included shops, auditoriums, cafe\u0301s, restaurants and apartments. The place to be seen for the fashionable, right away, the Royal Galleries of Saint Hubert drew a wide audience, attracted by its luxury brands, elegant cafe\u0301s and cultural spaces. These included the The\u0301a\u0302tre du Vaudeville, the Cine\u0301ma des Galeries and the Taverne du Passage, called the Cafe\u0301 des Arts until 1892 and the meeting place for painters and writers of the time. The colony of French refugees, like Victor Hugo, Alexandre Dumas, Edgar Quinet and others, would also gather there. The Surrealist painters and artists from the Cobra group were regulars at the venue. \r\n\r\nA commemorative plaque recalls the first showing of the Lumie\u0300re brothers\u2019 motion picture camera on 1 March 1896, in the former dispatch room of the La Chronique daily newspaper (above Pa\u0302tisserie Meert, Galerie du Roi).","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Galeries Royales Saint-Hubert","address_street_name":"Galerie du Roi","address_street_number":"5","address_street_box":null,"email":null,"website":"https:\/\/www.grsh.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Galerie du Roi, 5","address_line2":"1000 Bruxelles","description_web":"Die majest\u00e4tischen 200 Meter langen, denkmalgesch\u00fctzten Galeries Royales Saint-Hubert wurden 1847 von dem Architekten Cluysenaer im Stile der florentinischen Renaissance erbaut und bergen unter ihrem prachtvollen Glasdach eine in Br\u00fcssel einmalige Mischung aus Kultur und Luxusboutiquen.\r\n\r\nK\u00f6niglich Flanieren: Es handelt sich um eine der sch\u00f6nsten \u00fcberdachten Galerien Europas. Seit 1850 sind sie beliebter Ort zum Flanieren und Treffpunkt von K\u00fcnstlern und Intellektuellen jeglicher Couleur. Die Galeries Royales Saint-Hubert setzen sich aus drei Teilen zusammen: der \u201eGalerie de la Reine\" (Galerie der K\u00f6nigin), der \u201eGalerie du Roi\" (Galerie des K\u00f6nigs) und der \u201eGalerie du Prince\" (Galerie des Prinzen).\r\n\r\nEdelboutiquen, Traditionsgesch\u00e4fte, Caf\u00e9s und Kultur: Es herrscht eine geruhsame Atmosph\u00e4re, perfekt f\u00fcr einen ausgedehnten Schaufensterbummel entlang der gediegenen Boutiquen. Denn hier gibt es keine Ladenketten, sondern fast ausschlie\u00dflich spezialisierte Boutiquen.\r\n\r\nSchmuck und Traditionshandwerk: Sie suchen ein sch\u00f6nes Schmuckst\u00fcck? Das Angebot der in den Galeries Royales Saint-Hubert ans\u00e4ssigen Juweliere reicht von Modeschmuck bis Haute Couture..., aber auch heute selten gewordene Gewerbe wie Schneidwaren-, Handschuh- oder Hut- und Regenschirml\u00e4den haben hier ihre Nische gefunden.\r\n\r\nMode & Design: Neben diesen Traditionsgesch\u00e4ften haben sich exquisite Modeboutiquen, ber\u00fchmte Lederwarenh\u00e4ndler, belgische und internationale Stylisten und Designer, die gro\u00dfen Namen der belgischen Chocolatiers, erstklassige Restaurants, ein Designhotel und sogar ein Theater und ein Kino in den Sankt-Hubertus-Galerien niedergelassen.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Gallerie Reali Saint-Hubert","address_street_name":"Galerie du Roi","address_street_number":"5","address_street_box":null,"email":null,"website":"https:\/\/www.grsh.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Galerie du Roi, 5","address_line2":"1000 Bruxelles","description_web":"Duecento metri di vetrate classificate nel centro di Bruxelles, sono le Gallerie Reali saint-Hubert.\u00a0Boutique, ristoranti e cinema.. al vostro servizio!\u00a0...\r\n\r\nDuecento metri di vetrate classificate nel centro di Bruxelles, sono le Gallerie Reali saint-Hubert.\u00a0\r\nBoutique, ristoranti e cinema.. al vostro servizio!\u00a0\r\n\r\nLe Galeries Royales Saint-Hubert sono divise in 3 passaggi: la Galerie de la Reine, la\u00a0Galerie du Roi\u00a0e laGalerie des Princes. Un tempo nominate il \"Parapluie de Bruxelles\"- l'ombrello di Bruxelles- le Gallerie sono opera dell'architetto Cluysenaer che le disegn\u00f2 nel 1837.\r\n\r\nLe Gallerie sono oggi uno dei luoghi preferiti dai brussellesi e dai turisti. A pochi passi dalla celebre Grand-Place di Bruxelles,, tra boutique e ristoranti, sono pi\u00f9 di 6 milioni all'anno le persone che qui vengono a passeggiare, sotto le splendide vetrate. \u00a0Sapevate che\u00a0? Una volta l'ingresso alle Gallerie era a pagamento. 25 centesimi di franchi belgi il gioved\u00ec e la domenica, 10 centesimi di franchi belgi gli altri giorni. Oggi chiaramente sono gratuite! \u00a0\r\n\r\nLe Gallerie Reali di oggi Gli anni passano ma nelle Gallerie c'\u00e8 sempre un'atmosfera piacevole e tranquilla! Una breve passeggiata per scoprire i vari negozi specializzati della capitale: grandi marchi, stilisti d'alta moda, ma anche oggetti di arte antiche o moderne, una guanteria, un negozio di cappelli e di ombrelli, bigiotteria e librerie, cioccolaterie famose, ristoranti, un cinema e un\u00a0teatro\r\n\r\nFatevi dunque affascinare dalle pi\u00f9 belle gallerie coperte d'Europa, le Gallerie Reali di Saint-Hubert.\u00a0\r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Galer\u00edas Reales Saint Hubert","address_street_name":"Galerie du Roi","address_street_number":"5","address_street_box":null,"email":null,"website":"https:\/\/www.grsh.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Galerie du Roi, 5","address_line2":"1000 Bruxelles","description_web":"Las Galer\u00edas Reales de Saint Hubert son 200 m de vidrieras declaradas monumento, construidas por el arquitecto Cluysenaer en 1847.\u00a0...\r\n\r\nUn poco de historia sobre las galer\u00edas\u00a0\r\n\r\nLas Galer\u00edas Reales Saint Hubert est\u00e1n divididas en tres tramos: la Galer\u00eda de la Reina, la Galer\u00eda del Rey y la Galer\u00eda de los Pr\u00edncipes. Bautizadas, en el pasado, con el nombre de \u00abParaguas de Bruselas\u00bb, son obra del arquitecto Cluyseaner, que las imagin\u00f3 en 1837.Las Galer\u00edas son uno de los lugares preferidos de los bruselenses y de los turistas. En las proximidades de la conocida\u00a0Grand Place de Bruselas, en el centro de la capital, entre las tiendas y los restaurantes, se pasean m\u00e1s de 6 millones de personas al a\u00f1o bajo la espl\u00e9ndida vidriera que las protege del clima belga.\r\n\r\nLo sab\u00edas?\r\n\r\nAnta\u00f1o, el acceso a las galer\u00edas era de pago. Veinticinco c\u00e9ntimos el jueves y el domingo, diez c\u00e9ntimos los dem\u00e1s d\u00edas de la semana. Por supuesto, no es lo que ocurre hoy d\u00eda, pues puedes disfrutar de las galer\u00edas gratuitamente.\r\n\r\nLas Galer\u00edas Reales actuales\r\n\r\nLos a\u00f1os pasan, pero contin\u00faa existiendo una atm\u00f3sfera apacible en las Galer\u00edas Reales. Te podr\u00e1s pasear en busca de los distintos comercios especializados en la capital europea.\r\n\r\nLas galer\u00edas han reunido para ti las grandes marcas y las tiendas punteras: estilistas de alta costura, tiendas de antig\u00fcedades y de objetos contempor\u00e1neos, una tienda de guantes, una cuchiller\u00eda, una tienda de sombreros y de paraguas, joyer\u00edas, librer\u00edas, chocolater\u00edas, restaurantes, un cine y un teatro. \u00a0D\u00e9jate encandilar por las mejores galer\u00edas cubiertas de Europa, las Galer\u00edas Reales Saint Hubert de Bruselas.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Galerias Reais Saint-Hubert","address_street_name":"Galerie du Roi","address_street_number":"5","address_street_box":null,"email":null,"website":"https:\/\/www.grsh.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Galerie du Roi, 5","address_line2":"1000 Bruxelles","description_web":"Iniciado pelo arquiteto Jean-Pierre Cluysenaer, o grandioso projeto das Galerias Reais ganhou forma nos anos 1830. Os trabalhos, iniciados em 1846, estavam praticamente acabados aquando da inaugura\u00e7\u00e3o oficial, em 20 de junho de 1847. A galeria combinava lojas, salas de espet\u00e1culos, caf\u00e9s, restaurantes e apartamentos.Local de passeios de moda, as Galerias Reais Saint-Hubert t\u00eam, desde o in\u00edcio, atirado a aten\u00e7\u00e3o de um grande p\u00fablico, seduzido pelas marcas de luxo e pelos seus elegantes caf\u00e9s e lugares de cultura. Note-se, entre outros, o Teatro de Vaudeville e o Cinema das Galerias, ou ainda a Taverne du Passage, denominada at\u00e9 1892 como Caf\u00e9 des Arts e local de encontros de pintores e de escritores da \u00e9poca. A col\u00f3nia de refugiados franceses, como Victor Hugo, Alexandre Dumas, Edgar Quinet e outros refugiava-se a\u00ed. Como tal, os pintores surrealistas e os artistas do grupo Cobra foram clientes ass\u00edduos do local. Enfim, uma placa comemorativa evoca a primeira representa\u00e7\u00e3o do cinemat\u00f3grafo dos irm\u00e3os Lumi\u00e8re, de 1 de mar\u00e7o de 1896, na antiga sala de not\u00edcias do jornal quotidiano La Chronique (por cima da pastelaria Meert, Galeria do Rei). Hoje em dia, o Museu das Letras e Manuscritos est\u00e1 instalado na Galeria do Rei e homenageia os maiores homens e mulheres da arte, da hist\u00f3ria, da m\u00fasica, das letras e das ci\u00eancias.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Galeries Royales Saint-Hubert","address_street_name":"Galerie du Roi","address_street_number":"5","address_street_box":null,"email":null,"website":"https:\/\/www.grsh.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Galerie du Roi, 5","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":null,"facebook_id":null,"backoffice_id":8560,"location":{"lat":50.84793189,"lon":4.35528851},"region":"brussels","last_updated_at":"2023-03-07T02:35:10+01:00","published_at":"2013-10-19T01:24:21+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"media":[{"type":"poster","link":"https:\/\/agendabrussels.imgix.net\/84c35f1ddb3d5e2389a77db7997263e93a6ee55c.jpg","width":1123,"height":1587,"ratio":0.71,"translations":{"fr":{"title":"175 - Galeries Royales Saint-Hubert","copyright":null},"nl":{"title":"175 - Galeries Royales Saint-Hubert","copyright":null},"en":{"title":"175 - Galeries Royales Saint-Hubert","copyright":null},"de":{"title":"175 - Galeries Royales Saint-Hubert","copyright":null},"it":{"title":"175 - Galeries Royales Saint-Hubert","copyright":null},"sp":{"title":"175 - Galeries Royales Saint-Hubert","copyright":null},"pt":{"title":"175 - Galeries Royales Saint-Hubert","copyright":null},"cn":{"title":"175 - Galeries Royales Saint-Hubert","copyright":null}}},{"type":"poster","link":"https:\/\/agendabrussels.imgix.net\/379e208befc9bd1e876c2a19df6e95c53104e5e2.jpg","width":1996,"height":3000,"ratio":0.67,"translations":{"fr":{"title":"175 - Galeries Royales Saint-Hubert","copyright":null},"nl":{"title":"175 - Galeries Royales Saint-Hubert","copyright":null},"en":{"title":"175 - Galeries Royales Saint-Hubert","copyright":null},"de":{"title":"175 - Galeries Royales Saint-Hubert","copyright":null},"it":{"title":"175 - Galeries Royales Saint-Hubert","copyright":null},"sp":{