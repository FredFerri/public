s":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater"}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"],"de":["Theater"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"In solidum","shortdescr":"\"Nous voulons raconter une histoire qui ne pourrait arriver qu\u2019aujourd\u2019hui, pr\u00e9cis\u00e9ment \u00e0 notre \u00e9poque. Une histoire qui nous concerne.\"","longdescr":"Et\u00e9 2017, cinq amis d\u2019enfance s\u2019introduisent dans une villa de vacances du Sud de la France. Ils y vivent une semaine de folie, port\u00e9s par l\u2019euphorie d\u2019\u00eatre r\u00e9unis, inspir\u00e9s, intouchables. Ils sont sympas, touchants\u2026 En partant, pourtant, ils mettent le feu \u00e0 la piscine et ses alentours\u2026\r\n\r\nUn an plus tard, ils sont jug\u00e9s pour leur connerie: 122.475 \u20ac de dommages et int\u00e9r\u00eats \u00e0 verser in solidum \u00e0 la propri\u00e9taire de la villa. In Solidum : tous coupables et tous ensemble.\r\n\r\nPour payer leur dette, ces pieds nickel\u00e9s y vont de l\u2019arnaque 2.0 : escroquerie virtuelle, arnaque \u00e0 la nig\u00e9riane, pillage des c\u0153urs \u00e0 prendre sur les sites de rencontre, chantages divers\u2026 Une vraie start-up de self-made men en cybercriminalit\u00e9. Avec ses codes, ses principes tr\u00e8s Wall Street\u2026\r\n\r\nUn pi\u00e8ce de th\u00e9\u00e2tre r\u00e9compens\u00e9e par le label I.M.P.A.C.T \r\nUn spectacle du Collectif Solidum produit par Ravie ASBL, avec le soutien du LookIN\u2019OUT, du BAMP, des Riches-Claires\r\n\r\n-----------___---___--___--------------\r\n\u00e0 partir de 14 ans - Dur\u00e9e: 60 min\r\n\r\nS\u00e9ance scolaire \u00e0 14h. Infos et r\u00e9servations: Renaud VANDERNOOT : rvandernoot@ccjette.be","performers":"\u00c9criture \/ mise en sc\u00e8ne \/ interpr\u00e9tation: Siam DE MUYLDER Siam DE MUYLDER, Mano\u00ebl DUPONT, Arthur GOLDBERG, Habib BEN TANFOUS, J\u00e9r\u00e9my LAMBLOT , L\u00e9opold TERLINDEN \r\nParticipation en alternance: Amber KEMP et Marie VAN PUYVELDE\r\nCr\u00e9ation vid\u00e9o: Thomas PLISSART\r\nCr\u00e9ation sonore et musicale: Hugo MARIE et Rafa\u00ebl BOU\u00c9\r\nCr\u00e9ation lumi\u00e8re: Nicolas GHION","boxoffice_url":null,"website":"http:\/\/www.ccjette.be","email":"info@ccjette.be","phone_contact":"+32 2 426 64 39","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.544786"},"nl":{"name":"In solidum","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.544786"},"en":{"name":"In solidum","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.544786"},"de":{"name":"In solidum","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.544786"},"it":{"name":"In solidum","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.544786"},"sp":{"name":"In solidum","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.544786"},"pt":{"name":"In solidum","