,"hours":[{"start":"12:00:00","end":"18:00:00"}]},"tuesday":{"is_open":true,"hours":[{"start":"12:00:00","end":"18:00:00"}]},"wednesday":{"is_open":true,"hours":[{"start":"12:00:00","end":"18:00:00"}]},"thursday":{"is_open":true,"hours":[{"start":"12:00:00","end":"18:00:00"}]},"friday":{"is_open":true,"hours":[{"start":"12:00:00","end":"18:00:00"}]},"saturday":{"is_open":false},"sunday":{"is_open":false}},"translations":{"en":["monday, tuesday, wednesday, thursday and friday: from 12:00 to 18:00","saturday and sunday: closed"],"fr":["lundi, mardi, mercredi, jeudi et vendredi: de 12:00 \u00e0 18:00","samedi et dimanche: ferm\u00e9"],"nl":["maandag, dinsdag, woensdag, donderdag en vrijdag: van 12:00 tot 18:00","zaterdag en zondag: gesloten"]},"date_start":"2024-03-09","date_end":"2024-06-07","is_also_by_appointment":false}],"date_exceptions":[{"day":"2024-03-09","start":"12:00:00","end":"18:00:00"},{"day":"2024-03-16","start":"12:00:00","end":"18:00:00"},{"day":"2024-03-21","start":"18:00:00","end":"20:00:00"},{"day":"2024-03-23","start":"12:00:00","end":"18:00:00"},{"day":"2024-03-30","start":"12:00:00","end":"18:00:00"},{"day":"2024-04-18","start":"18:00:00","end":"20:00:00"},{"day":"2024-04-27","start":"12:00:00","end":"18:00:00"},{"day":"2024-05-04","start":"12:00:00","end":"18:00:00"},{"day":"2024-05-11","start":"12:00:00","end":"18:00:00"},{"day":"2024-05-16","start":"18:00:00","end":"20:00:00"},{"day":"2024-05-18","start":"12:00:00","end":"18:00:00"},{"day":"2024-05-25","start":"12:00:00","end":"18:00:00"},{"day":"2024-06-01","start":"12:00:00","end":"18:00:00"}],"closing_days":["2024-03-31","2024-04-01","2024-04-02","2024-04-03","2024-04-04","2024-04-05","2024-04-06","2024-04-07","2024-04-08","2024-04-09","2024-04-10","2024-04-11","2024-04-12","2024-04-13","2024-04-14","2024-04-15"],"child_events":[],"parent_events":[],"accessibilities":[],"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[]},{"id":50008143,"date_start":"2024-03-01","date_end":"2024-05-31","date_next":"2024-03-20","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-03-20T01:02:23+01:00","published_at":"2024-03-06T15:57:01+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":true,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":296031,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.22151546799151525,"languages":{"spoken":["nl","fr","en"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[38,36],"translations":{"de":["Skulptur","Museen & Kunstzentren"],"pt":[null,null],"en":["Sculpture","Museums and art centers"],"it":["Scultura","Musei e centri artistici"],"cn":[null,null],"fr":["Sculpture","Mus\u00e9es et art centers"],"sp":["Escultura","Museos y centros de arte"],"nl":["Beeldhouwkunst","Musea en kunstcentra"]}}},"translations":{"de":{"name":"Sculptures walk - Folon. A journey in Brussels","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50008143"},"pt":{"name":"Sculptures walk - Folon. A journey in Brussels","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50008143"},"en":{"name":"Sculptures walk - Folon. A journey in Brussels","shortdescr":"A walk around Brussels featuring Folon\u2019s finest sculptures.\n\nFrom 1 March to 31 May, a walking route featuring Folon\u2019s most beautiful sculptures\n- around 20 in total - will be set out in the centre of Brussels. An outdoor exhibition in\nthe Belgian capital\u2019s iconic locations: Galeries Royales Saint-Hubert, Mont des Arts,\nPlace Royale and the Square du Petit Sablon.","longdescr":"GALERIES ROYALES SAINT-HUBERT\nJean-Michel Folon, All\u00e9e des Pens\u00e9es, 10 bronze sculptures, 1996-1999.\n\nThe Pens\u00e9es made up a significant part of Folon\u2019s sculptural work. He created several\ndozens of them. Consisting of the same anonymous body, the Pens\u00e9es each have\ndifferent heads made from a varied collection of objects. This combination of an\nobject and a body creates a whole new item, which is irrational and original,\nstimulating and playful. The Pens\u00e9es are more meaningful when displayed together\nrather than individually. These All\u00e9es de Pens\u00e9es were inspired by the avenue of\nsphinxes that Folon had admired at Karnak in Egypt. They left a deep impression on\nhim. They blend perfectly into the regular architectural rhythm of the Galeries Royales\nSaint-Hubert. The masterpiece of the architect Jean-Pierre Cluysenaar, these arcades\nare amongst the oldest of their type in the world (1847).\n\nIn a nice touch, the Deuxi\u00e8me Pens\u00e9e, which features a fork, stands in front of\nL\u2019Ogenblik restaurant where Folon liked to eat when in Brussels.\n\nMONT DES ARTS\nJean-Michel Folon, Partir, bronze, 2002.\n\nFolon was always obsessed with the concept of leaving. On his 21st birthday, in 1955,\nhe left the family home and headed for the outskirts of Paris to try his luck in France.\nThroughout his career, he was his own person, defied classification and espoused the\nmaxim \u201clife is a journey\u201d.\nAn incitement to travel, this bronze suitcase overlooks the Mont des Arts, where it\nenhances the symmetry of the garden created in 1957 by the Belgian landscape\ngardener Ren\u00e9 P\u00e9ch\u00e8re and channels the view towards the Lower Town and the\nmagnificent Gothic tower of Brussels Town Hall.\n\nPLACE ROYALE, CLOSE TO THE MUSEE MAGRITTE\nJean-Michel Folon, L\u2019Envol, 1996, bronze.\n\nIn one of the neo-Classical arcades of the Place Royale stands L\u2019Envol. This\nmonumental sculpture by Jean-Michel Folon represents his iconic little man, a kind of\n\u2018man in the street\u2019 that everyone can identify with. He is gazing at the sky and the\nMus\u00e9e Magritte. The museum is now, in fact, the venue for an exhibition that creates\na dialogue between works by Magritte and Folon. Magritte was 36 years older than\nFolon, and although they never actually met, he certainly influenced Folon, showing\nhim the way to imagination and mystery in art.\n\nSQUARE DU PETIT SABLON\nThe Square du Petit Sablon is a gem in Brussels\u2019 crown. This neo-Renaissance-style\ngarden is adorned with statues created by the leading Belgian artists of the 19th\ncentury. Far from spoiling the layout, five Folon sculptures add extra appeal. In 1995,\na few years after he had started creating statues, Folon decided to put his work on\npublic display. He chose this square, a place that he loved, at the heart of his\nhometown.\n\nJean-Michel Folon, Je me souviens, 2003, bronze.\nThis is one of Folon\u2019s most popular sculptures. What he created was not merely a\nstatue, but an installation with which the public could interact. This work is Folon\u2019s\ntribute to the great Italian journalist Indro Montanelli (1909-2001).\n\nJean-Michel Folon, Femme-oiseau, 1993, bronze.\nFolon told the story of how he had fallen in love with a tiny prehistoric Cycladic statue\nthat he went to view in its display case every time he visited the Metropolitan Museum\nin New York. Frontal and hieratic, this bird-headed woman is the artist\u2019s tribute to the\nfaraway ancient Greek idol.\n\nJean-Michel Folon, Chat, 1996, bronze.\nLike many artists, Folon was a cat lover. He owned lots of them and took them\neverywhere with him. He rendered this big tom cat, asleep in the shade of a big tree,\nwith an aura of serenity and reassurance. Despite its size, the sculpture was not\ndesigned to be monumental. It lies curled up on the grass, as a cat would naturally\ndo.\n\nJean-Michel Folon, L\u2019Amour fou, 1993, bronze.\nL\u2019amour fou is one of Folon\u2019s first sculptures. He carved it from a thin wooden beam\nand then cast it in bronze. Its name reflects the heart-shaped face that sits atop it,\nevoking a powerful sense of poetry.\n\nJean-Michel Folon, Oiseau, 1993, bronze.\n\u201cIf I were not the man depicted in my images, I'd like to be the bird. I've always wanted\nto take to the sky, move, fly away and converse with the wind\u201d Folon said.\nIn around 1990, Jean-Michel Folon picked up a broom handle and carved a bird\u2019s\nhead into it with a kitchen knife. From that moment on, he never stopped sculpting.\nThis bird is the result of that first foray into sculpture.","performers":"Jean-Michel Folon.","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50008143"},"it":{"name":"Sculptures walk - Folon. A journey in Brussels","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50008143"},"cn":{"name":"Sculptures walk - Folon. A journey in Brussels","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50008143"},"fr":{"name":"Sculptures walk - Folon. A journey in Brussels","shortdescr":"Un parcours des plus belles sculptures de Folon \u00e0 travers Bruxelles.\n\nDu 1er mars au 31 mai, un parcours des plus belles sculptures de Folon, une vingtaine\nau total, est pr\u00e9sent\u00e9 dans le centre-ville de Bruxelles. Une exposition \u00e0 ciel ouvert\ndans des lieux iconiques de la capitale belge : Galeries Royales Saint-Hubert, Mont\ndes Arts, place Royale et square du Petit Sablon.","longdescr":"GALERIES ROYALES SAINT-HUBERT\nJean-Michel Folon, All\u00e9e des Pens\u00e9es, 10 sculptures en bronze, 1996-1999.\n\nLes Pens\u00e9es occupent une grande place dans la cr\u00e9ation sculpturale de Folon, qui en\na con\u00e7u plusieurs dizaines. Arborant toutes le m\u00eame corps anonyme, les Pens\u00e9es\npr\u00e9sentent des t\u00eates chaque fois diff\u00e9rentes, qui d\u00e9clinent une collection d\u2019objets\nh\u00e9t\u00e9roclites. Cette association d\u2019un objet et d\u2019un corps m\u00e8ne \u00e0 la cr\u00e9ation d\u2019une\nnouvelle entit\u00e9, irrationnelle et in\u00e9dite, stimulante et ludique. Plus\nqu\u2019individuellement, les Pens\u00e9es font sens quand elles sont r\u00e9unies. Ces All\u00e9es de\nPens\u00e9es s\u2019inspirent directement des enfilades de sphinx que l\u2019artiste avait admir\u00e9es \u00e0\nKarnak en \u00c9gypte et qui l\u2019avaient fortement marqu\u00e9. Elles s\u2019inscrivent parfaitement\ndans le rythme r\u00e9gulier des Galeries royales Saint-Hubert, chef-d\u2019oeuvre de\nl'architecte Jean-Pierre Cluysenaar, parmi les plus anciennes galeries de ce type au\nmonde (1847).\n\nPetit clin d\u2019oeil, la Deuxi\u00e8me Pens\u00e9e, qui figure une fourchette, se trouve devant\nL\u2019Ogenblik o\u00f9 Folon aimait d\u00eener lors de ses venues \u00e0 Bruxelles.\n\nMONT DES ARTS\nJean-Michel Folon, Partir, bronze, 2002.\n\nL\u2019id\u00e9e du d\u00e9part a toujours hant\u00e9 Jean-Michel Folon. Le jour de ses 21 ans, en 1955,\nle jeune artiste quitte le domicile familial pour rejoindre les environs de Paris et tenter\nsa chance en France. Tout au long de sa carri\u00e8re, il a v\u00e9cu en homme libre, a \u00e9chapp\u00e9\n\u00e0 toute classification et a fait sienne la formule selon laquelle \u00ab la vie est un voyage \u00bb.\nDominant le parterre du Mont des Arts, cette valise en bronze, tout invitant au voyage,\nexalte la stricte sym\u00e9trie du jardin con\u00e7u paysagiste belge Ren\u00e9 P\u00e9ch\u00e8re en 1957 et\ncanalise la perspective vers le bas de la ville et la splendide tour gothique de l\u2019H\u00f4tel\nde Ville de Bruxelles.\n\nPLACE ROYALE, PR\u00c8S DU MUSEE MAGRITTE\nJean-Michel Folon, L\u2019Envol, 1996, bronze.\n\nDans l\u2019une des arcades n\u00e9oclassiques de la place Royale, prend place L\u2019Envol, une\nsculpture monumentale de Jean-Michel Folon, qui pr\u00e9sente son personnage\nembl\u00e9matique, sorte de Monsieur-Tout-le-Monde, auquel chacun peut s\u2019identifier. Il\ncontemple le ciel et le Mus\u00e9e Magritte. En ce moment s\u2019y tient en effet une exposition\nqui met en dialogue des oeuvres de Magritte et de Folon. De 36 ans son ain\u00e9 et bien\nqu\u2019ils ne se soient jamais rencontr\u00e9s, Magritte a marqu\u00e9 Folon, en lui montrant la voie\nvers l\u2019imaginaire et le myst\u00e8re en art.\n\nSQUARE DU PETIT SABLON\nLe square du Petit Sablon constitue l\u2019un des bijoux paysagers du centre de Bruxelles.\nCe jardin de style n\u00e9o-renaissance est orn\u00e9 de sculptures dues aux plus grands artistes\nbelges du 19e si\u00e8cle. Cinq sculptures de Jean-Michel Folon, loin d\u2019en d\u00e9faire\nl\u2019ordonnancement, lui donnent un suppl\u00e9ment d\u2019\u00e2me. En 1995, alors qu\u2019il s\u2019est lanc\u00e9\ndans la statuaire depuis quelques ann\u00e9es, Folon veut montrer ce travail au public. Il\nchoisit ce square, qu\u2019il aimait, au coeur de sa ville natale.\n\nJean-Michel Folon, Je me souviens, 2003, bronze.\nVoil\u00e0 l\u2019une des sculptures de Folon pr\u00e9f\u00e9r\u00e9es du public. L\u2019artiste d\u00e9passe le cadre\nd\u2019une simple statue pour concevoir une v\u00e9ritable installation dans laquelle les visiteurs\nsont partie prenante. Cette oeuvre est un hommage de Folon au grand journaliste\nitalien Indro Montanelli (1909-2001).\n\nJean-Michel Folon, Femme-oiseau, 1993, bronze.\nFolon racontait qu\u2019il \u00e9tait tomb\u00e9 amoureux d\u2019une petite sculpture pr\u00e9historique des\nCyclades, qu\u2019il venait voir dans sa vitrine chaque fois qu\u2019il visitait le Metropolitan\nMuseum \u00e0 New York. Frontale et hi\u00e9ratique, cette femme \u00e0 t\u00eate d\u2019oiseau est un\nhommage de l\u2019artiste \u00e0 la lointaine et antique idole grecque.\n\nJean-Michel Folon, Chat, 1996, bronze.\nAmoureux des chats comme beaucoup d\u2019artistes et d\u2019\u00e9crivains \u2013 il en a eu beaucoup\nqu\u2019il trimballait partout\u2013, Folon repr\u00e9sente ce gros matou avec une aura rassurante et\napaisante, \u00e0 l\u2019ombre d\u2019un grand arbre. Loin de toute monumentalit\u00e9 malgr\u00e9 ses\ndimensions, la sculpture est pos\u00e9e directement sur l\u2019herbe, comme un f\u00e9lin s\u2019y\ninstallerait naturellement.\n\nJean-Michel Folon, L\u2019Amour fou, 1993, bronze.\nL\u2019amour fou est l\u2019une des premi\u00e8res sculptures de Folon, qu\u2019il taille dans une mince\npoutre en bois avant de la transposer en bronze. Son nom r\u00e9sonne avec le visage en\nforme de coeur qui la couronne, g\u00e9n\u00e9rant un intense sentiment po\u00e9tique.\n\nJean-Michel Folon, Oiseau, 1993, bronze.\n\u00ab Si je n\u2019\u00e9tais pas l\u2019homme repr\u00e9sent\u00e9 dans mes images, j\u2019aimerais \u00eatre l\u2019oiseau. J\u2019ai\ntoujours envie de m\u2019envoler, de bouger, de partir dialoguer avec le vent \u00bb, dit Folon.\nVers 1990, prenant un manche de brosse et un petit couteau de cuisine, Jean-Michel\nFolon y taille une t\u00eate d\u2019oiseau. \u00c0 partir de ce moment-l\u00e0, il ne s\u2019arr\u00eate plus de\nsculpter. Cet oiseau est issu de ce premier geste sculpteur.","performers":"Jean-Michel Folon.","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50008143"},"sp":{"name":"Sculptures walk - Folon. A journey in Brussels","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50008143"},"nl":{"name":"Sculptures walk - Folon. A journey in Brussels","shortdescr":"Van 1 maart tot 31 mei zijn een twintigtal van Folons mooiste sculpturen te zien zijn\nlangs een wandelroute door de Brusselse binnenstad. Die openluchttentoonstelling vindt\nplaats op enkele van de meest iconische locaties van de Belgische hoofdstad: de Koninklijke\nSint-Hubertusgalerijen, de Kunstberg, het Koningsplein en de Kleine Zavel.","longdescr":"KONINKLIJKE SINT-HUBERTUSGALERIJEN\nJean-Michel Folon, All\u00e9e des Pens\u00e9es, 10 bronzen beelden, 1996-1999.\n\nDe Pens\u00e9es nemen een belangrijke plaats in Folons sculpturale oeuvre in; hij maakte er\ntientallen exemplaren van. Ze hebben allemaal hetzelfde anonieme lichaam maar telkens\nmet een ander hoofd \u2013 variaties uit een verzameling heterogene gebruiksvoorwerpen. Door\neen lichaam met een object te associ\u00ebren, cre\u00eberde Folon een nieuwe entiteit \u2013 irrationeel\nen verrassend, stimulerend en speels. De betekenis van die Pens\u00e9es komt pas echt tot uiting\nwanneer ze bij elkaar staan. Voor die All\u00e9es de Pens\u00e9es putte Folon inspiratie uit de rijen\nsfinxen die hij in Karnak (Egypte) had bewonderd en die veel indruk op hem hadden\ngemaakt. Ze passen perfect in de regelmatige plattegrond van de Koninklijke Sint-\nHubertusgalerijen. Dat meesterwerk van architect Jean-Pierre Cluysenaar is een van de\noudste winkelgalerijen van dat type ter wereld (1847).\n\nDe Deuxi\u00e8me Pens\u00e9e, in de vorm van een vork, staat voor L\u2019Ogenblik. Een knipoog naar het\nfeit dat Folon bij zijn bezoeken aan Brussel graag in dat restaurant dineerde.\n\nKUNSTBERG\nJean-Michel Folon, Partir, brons, 2002.\n\nHet vertrek van een vertrouwde plek is iets wat Jean-Michel Folon altijd heeft\nbeziggehouden. In 1955 ruilde hij op zijn 21ste de vertrouwde gezinswoning in voor de\nbuitenwijken van Parijs om in Frankrijk zijn geluk te beproeven. Zijn hele carri\u00e8re lang leefde\nhij als een vrij man, die in geen enkel vakje wilde passen en wiens motto luidde: \u201cHet leven\nis een reis.\u201d\n\nAls een uitnodiging om te reizen kijkt deze bronzen reiskoffer uit over de bloemperken van\nde Kunstberg. Hij benadrukt de symmetrie van de in 1957 door de Belgische\nlandschapsarchitect Ren\u00e9 P\u00e9ch\u00e8re ontworpen tuin, die het perspectief op het lagergelegen\ndeel van de stad en op de prachtige gotische toren van het Brusselse stadhuis in de verf zet.\n\nKONINGSPLEIN, VLAKBIJ HET MAGRITTE MUSEUM\nL\u2019Envol, brons, 1996.\n\nIn een van de neoklassieke arcades van het Koningsplein staat L\u2019Envol, een monumentale\nsculptuur van Jean-Michel Folon. Ze neemt de gedaante aan van zijn iconische blauwe\nmannetje, een soort Jan met de pet, met wie iedereen zich kan identificeren. Het personage\nkijkt omhoog naar de hemel en naar het Magritte Museum, waar momenteel een\ntentoonstelling met werk van Magritte en Folon te zien is. Hoewel hij 36 jaar ouder was en\nFolon nooit ontmoet heeft, drukte Magritte zijn stempel op Folon en zette hij hem op het\npad van het imaginaire en het mysterie in de kunst.\n\nKLEINE ZAVEL\nDe Kleine Zavelsquare is een van de pareltjes van de Brusselse binnenstad. De tuin in\nneorenaissancestijl is versierd met standbeelden van enkele van de grootste Belgische\nkunstenaars uit de 19de eeuw. De vijf sculpturen van Jean-Michel Folon verstoren geenszins\nde compositie van de tuin; ze zorgen zelfs voor extra cachet. In 1995, toen hij al enkele jaren\nactief was als beeldhouwer, koos Folon de Kleine Zavel om er zijn werk aan het publiek\ntonen. Dat plein in het hart van zijn geboortestad was hem bijzonder dierbaar.\nIn samenwerking met Leefmilieu Brussel.\n\nJean-Michel Folon, Je me souviens, brons, 2003.\nDat is een van Folons populairste sculpturen. Het is meer dan zomaar een standbeeld; het\nis een ware installatie waarin bezoekers een actieve rol kunnen spelen. Dat werk is een\neerbetoon van Folon aan de grote Italiaanse journalist Indro Montanelli (1909-2001).\n\nJean-Michel Folon, Femme-oiseau, brons, 1993.\nFolon vertelde dat hij op slag verliefd was geworden op een klein prehistorisch beeld uit de\nCycladencultuur in het Metropolitan Museum te New York. Telkens als hij het museum\nbezocht, zocht hij het beeldje op. De frontaal opgestelde, strenge vrouwenfiguur met vogelkop is een eerbetoon van Folon aan dat oud-Griekse afgodsbeeld uit lang vervlogen\ntijden.\n\nJean-Michel Folon, Chat, brons, 1996.\nZoals veel kunstenaars en schrijvers was Folon een kattenliefhebber; hij had er veel en hij\nnam ze overal mee. Zijn grote kat beeldt hij uit met een geruststellende, rustgevende\nuitstraling op het grasperk geplaatst, in de schaduw van een grote boom \u2013 een plek die een\nkat van nature zou kiezen. Ondanks zijn omvang is het beeld allesbehalve monumentaal.\n\nJean-Michel Folon, L\u2019Amour fou, brons, 1993.\nL\u2019amour fou is een van Folons vroegste sculpturen. Het ontstond eerst als houtsnijwerk uit\neen slanke houten balk en later werd er deze bronzen versie van gegoten. De titel verwijst\nnaar het hartvormige gezicht dat een intens po\u00ebtisch gevoel opwekt.\n\nJean-Michel Folon, Oiseau, brons, 1993.\n\u201cAls ik niet de man was die op mijn afbeeldingen staat afgebeeld, dan zou ik graag de vogel\nzijn. Ik wil altijd vliegen, bewegen, in dialoog gaan met de wind\u201d, zei Folon.\nRond 1990 sneed Jean-Michel Folon met een keukenmes een vogelkop uit een\nborstelhandvat. Daarna hield hij niet meer op met beeldhouwen. Deze vogel is het resultaat\nvan die eerste inspiratie als beeldhouwer.","performers":"Jean-Michel Folon.","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50008143"}},"place":{"id":50001285,"translations":{"de":{"name":"Galeries Royales Saint-Hubert","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":"https:\/\/www.grsh.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Galeries Royales Saint-Hubert","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Galeries Royales Saint-Hubert","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":"https:\/\/www.grsh.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Galeries Royales Saint-Hubert","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Galeries Royales Saint-Hubert","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":"https:\/\/www.grsh.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Galeries Royales Saint-Hubert","address_line2":"1000 Brussels","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Galeries Royales Saint-Hubert","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":"https:\/\/www.grsh.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line