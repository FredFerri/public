ate_next":"2022-11-26","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater"}},"others":{"list":[51],"translations":{"fr":["Caf\u00e9 th\u00e9\u00e2tre"],"nl":["Cabaret"],"en":["Cabaret"],"de":["Kabarett"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"COURAGE(S) - Spectacle D'improvisation d'Alexandre Valancin et ses invit\u00e9.e.s de coeur","shortdescr":null,"longdescr":"* COURAGE(S) *\r\n\r\n\"La vulnerabilit\u00e9, ce n'est pas une question de r\u00e9ussite ou d'\u00e9chec. \r\nC'est avoir le courage de se pr\u00e9senter quand bien m\u00eame on ne contr\u00f4le pas l'issue des choses.\" (Brene Brown)\r\n\r\nPendant cette soir\u00e9e, Alex invite 3 ami.e.s com\u00e9diens \u00e0 s'inspirer de VOS courages pour en faire des tranches de vie des personnages. \r\n\r\nAvant le spectacle, vous transmetterez (anonymement) deux types de situations qui serviront d'inspiration. Celles o\u00f9 vous avez d\u00fb faire preuve de courage, et celles o\u00f9 vous avez \u00e9t\u00e9 admiratifs du courage d'autres personnes. Et ce, que ce soit des petits courages quotidiens, aux plus difficiles que la vie peut r\u00e9server !\r\n\r\n\r\nSpectacle d'Alexandre Valentin et ses Ch\u00e8res invit\u00e9.e.s","performers":"Alexandre Valancin et ses courageu.x.ses invit\u00e9.e.s !","boxoffice_url":null,"website":"http:\/\/www.letrac.be\/reservation","email":"info@letrac.be","phone_contact":"+32 470 50 04 75","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.540595"},"nl":{"name":"COURAGE(S) - Spectacle D'improvisation d'Alexandre Valancin et ses invit\u00e9.e.s de coeur","shortdesc