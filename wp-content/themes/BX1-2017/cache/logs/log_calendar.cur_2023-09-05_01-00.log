permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2023-08-30T09:00:04+02:00","published_at":"2023-08-30T08:47:11+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":284190,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.6933612743506347,"languages":{"spoken":["en","fr","es","it","pl"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{}},"translations":{"de":{"name":"Midsummer Nights`s Dream: Finissage","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.napiorkowska.pl","email":"galeria@napiorkowska.pl","phone_contact":"+32 495 71 89 88","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50001492"},"pt":{"name":"Midsummer Nights`s Dream: Finissage","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.napiorkowska.pl","email":"galeria@napiorkowska.pl","phone_contact":"+32 495 71 89 88","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50001492"},"en":{"name":"Midsummer Nights`s Dream: Finissage","shortdescr":"MIDSUMMER NIGHT DREAM \nMarta Garbaczewska \nPaintings and linocuts \nGallery of Katarzyna Napi\u00f3rkowska Brussels, Mont des Arts 8 \nFinissage 6\/9\/2023 at 8 pm \n\nExhibition A Midsummer Night\u2019s Dream presents the work of Marta Garbaczewska, an award-winning artist who graduated from the Academy of Fine Arts in Gda\u0144sk.\n","longdescr":"MIDSUMMER NIGHT DREAM \nMarta Garbaczewska \nPaintings and linocuts \nGallery of Katarzyna Napi\u00f3rkowska Brussels, Mont des Arts 8 \n\nFinissage 6\/9\/2023 at 8 pm \n\nExhibition A Midsummer Night\u2019s Dream presents the work of Marta Garbaczewska, an award-winning artist who graduated from the Academy of Fine Arts in Gda\u0144sk. \n\nMarta Garbaczewska\u2019s work covers two strands. On the one hand, it is the world of nature, which the author shows in an extraordinary profusion, emphasizing its vital power. The artist\u2019s vision draws from the romantic vision created by Caspar David Friedrich, and at the same time reflects the impressionistic nature of nature subjected to many cycles of change, known, among others, from the works of Claude Monet. However, more importantly, apart from that, the artist also marks the human presence. Man is part of the ecosystem after all. Human presence remains the second motive in Garbaczewska`s art and the theme of \u201csharing\u201d the territory becomes the basic theme. This topic is urgent in the face of the challenges related to the climate crisis, which often puts man in opposition to the components of the surrounding nature. It is worth noting the practices used by the artist, who uses, among others, recycled materials \u2013 old canvases or scraps of materials. In addition to floral motifs, the artist also tackles the subject of eroticism, referring to the world of the senses in a highly subtle way. \nThe exhibition features also a spectacular, large panorama previously shown at the Pomeranian Dukes\u2019 Castle in Szczecin. \n","performers":"Marta Garbaczewska \nJustyna Napiorkowska, PhD\n","boxoffice_url":null,"website":"http:\/\/www.napiorkowska.pl","email":"galeria@napiorkowska.pl","phone_contact":"+32 495 71 89 88","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50001492"},"it":{"name":"Midsummer Nights`s Dream: Finissage","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.napiorkowska.pl","email":"galeria@napiorkowska.pl","phone_contact":"+32 495 71 89 88","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50001492"},"cn":{"name":"Midsummer Nights`s Dream: Finissage","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.napiorkowska.pl","email":"galeria@napiorkowska.pl","phone_contact":"+32 495 71 89 88","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50001492"},"fr":{"name":"Midsummer Nights`s Dream: Finissage","shortdescr":"R\u00caVE D'UNE NUIT D'\u00c9T\u00c9 \/ MIDSUMMER NIGHT\u015a DREAM\nMarta Garbaczewska\nPeintures et linogravures\nGalerie de Katarzyna Napi\u00f3rkowska Bruxelles, Mont des Arts 8\nFinissage le 9\/06\/2023 \u00e0 20h\n\nL'exposition Le Songe d'une nuit d'\u00e9t\u00e9 pr\u00e9sente le travail de Marta Garbaczewska, une artiste prim\u00e9e dipl\u00f4m\u00e9e de l'Acad\u00e9mie des Beaux-Arts de Gda\u0144sk.\n","longdescr":"SONGE D`UNE NUIT D`ETE \nMarta Garbaczewska \nTableaux et linogravures \nGalerie de Katarzyna Napi\u00f3rkowska - Bruxelles \nMont des Arts 8, Bruxelles \n\nFinissage: 6\/9\/2023 \u00e0 20h \n\nMarta Gorbaczewska est une artiste polonaise, dipl\u00f4m\u00e9e de l\u2019Acad\u00e9mie des Beaux-Arts de Gda\u0144sk. Son oeuvre repr\u00e9sente deux volets. D\u2019une part, c\u2019est le monde de la nature, que la peintre montre dans une profusion extraordinaire, soulignant la puissance vitale de la nature. En m\u00eame temps, elle puise dans la vision romantique cr\u00e9\u00e9e par Caspar David Friedrich, et refl\u00e8te en m\u00eame temps la nature impressionniste de la nature soumise \u00e0 de nombreux cycles de changement, connus, entre autres, des oeuvres de Claude Monet. Or, l\u2019artiste marque aussi la pr\u00e9sence humaine. L\u2019homme fait partie de l\u2019\u00e9cosyst\u00e8me apr\u00e8s tout. Le th\u00e8me du \u00ab partage \u00bb du territoire devient fondamental. Ce sujet est d\u2019une grande actualit\u00e9 face aux enjeux li\u00e9s \u00e0 la crise climatique, qui met bien souvent l\u2019homme en opposition avec les composantes de la nature environnante. Il convient de noter les pratiques utilis\u00e9es par l\u2019artiste, qui dans ses \u0153uvres utilise, entre autres, des mat\u00e9riaux usag\u00e9s \u2013 toiles anciennes et les \u00e9l\u00e9ments recycl\u00e9s. Outre les motifs floraux, l\u2019artiste aborde \u00e9galement le sujet de l\u2019\u00e9rotisme, faisant r\u00e9f\u00e9rence au monde des sens de mani\u00e8re extr\u00eamement subtile.\nDurant son exposition, un immense panorama pr\u00e9c\u00e9demment expos\u00e9 au ch\u00e2teau des ducs de Pom\u00e9ranie \u00e0 Szczecin est \u00e9galement pr\u00e9sent\u00e9e. \n","performers":"Marta Garbaczewska \nJustyna Napiorkowska, PhD\n","boxoffice_url":null,"website":"http:\/\/www.napiorkowska.pl","email":"galeria@napiorkowska.pl","phone_contact":"+32 495 71 89 88","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50001492"},"sp":{"name":"Midsummer Nights`s Dream: Finissage","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.napiorkowska.pl","email":"galeria@napiorkowska.pl","phone_contact":"+32 495 71 89 88","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50001492"},"nl":{"name":"Midsummer Nights`s Dream: Finissage","shortdescr":"MIDZOMER NACHTDROOM \/ MIDSUMMER NIGHT\u015a DREAM\nMarta Garbaczewska\nSchilderijen en linosneden\nGalerij van Katarzyna Napi\u00f3rkowska Brussel, Kunstberg 8\nFinissage 6\/9\/2023 om 20.00 uur\n\nTentoonstelling A Midsummer Night\u2019s Dream presenteert het werk van Marta Garbaczewska, een bekroonde kunstenaar die afstudeerde aan de Academie voor Schone Kunsten in Gda\u0144sk.","longdescr":"MIDZOMER NACHT DROOM \nMarta Garbaczewska \nSchilderijen en linosneden \nGalerij van Katarzyna Napi\u00f3rkowska Brussel, Kunstberg 8 \nFinissage 6\/9\/2023 om 20u \n\nMidsummer Night's Dream presenteert het werk van Marta Garbaczewska, een bekroonde kunstenares die afstudeerde aan de Academie voor Schone Kunsten in Gda\u0144sk. Op de tentoonstelling is onder andere een spectaculair, groot panorama te zien dat eerder te zien was in het kasteel van de hertogen van Pommeren in Szczecin. Het werk van Marta Garbaczewska omvat twee onderdelen. Aan de ene kant is het de wereld van de natuur, die de auteur in een buitengewone overvloed laat zien en de vitale kracht ervan benadrukt. De visie van de kunstenaar is gebaseerd op de romantische visie van Caspar David Friedrich en weerspiegelt tegelijkertijd de impressionistische aard van de natuur die onderhevig is aan vele cycli van verandering, onder andere bekend uit het werk van Claude Monet. Maar belangrijker nog, daarnaast markeert de kunstenaar ook de menselijke aanwezigheid. De mens maakt immers deel uit van het ecosysteem. Menselijke aanwezigheid blijft het tweede motief in de kunst van Garbaczewska en het thema van het 'delen' van het territorium wordt het basisthema. Dit onderwerp is urgent in het licht van de uitdagingen in verband met de klimaatcrisis, die de mens vaak tegenover de componenten van de omringende natuur plaatst. Het is vermeldenswaard de praktijken van de kunstenaar, die onder meer gerecycleerde materialen gebruikt - oude doeken of stukjes materiaal. Naast bloemmotieven behandelt de kunstenaar ook het onderwerp erotiek, waarbij hij op zeer subtiele wijze verwijst naar de wereld van de zintuigen. \n\n","performers":"Marta Garbaczewska \nJustyna Napiorkowska, PhD\n","boxoffice_url":null,"website":"http:\/\/www.napiorkowska.pl","email":"galeria@napiorkowska.pl","phone_contact":"+32 495 71 89 88","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50001492"}},"place":{"id":251322,"translations":{"de":{"name":"Galerie Katarzyna Napi\u00f3rkowska","address_street_name":"Mont des Arts","address_street_number":"8","address_street_box":null,"email":null,"website":"htt