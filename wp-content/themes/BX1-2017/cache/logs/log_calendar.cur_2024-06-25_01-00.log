ovelo.org","phone_contact":"+32 2 502 73 55","phone_booking":"+32 2 502 73 55","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50010790"},"pt":{"name":"Les dieux de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.provelo.org\/events\/les-dieux-de-bruxelles-2\/","email":"info@provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":"+32 2 502 73 55","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50010790"},"en":{"name":"Les dieux de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.provelo.org\/events\/les-dieux-de-bruxelles-2\/","email":"info@provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":"+32 2 502 73 55","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50010790"},"it":{"name":"Les dieux de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.provelo.org\/events\/les-dieux-de-bruxelles-2\/","email":"info@provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":"+32 2 502 73 55","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50010790"},"cn":{"name":"Les dieux de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.provelo.org\/events\/les-dieux-de-bruxelles-2\/","email":"info@provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":"+32 2 502 73 55","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50010790"},"fr":{"name":"Les dieux de Bruxelles","shortdescr":"Sautez en selle et partez explorer les diff\u00e9rentes facettes spirituelles et sacr\u00e9es de Bruxelles. ","longdescr":"Niveau : interm\u00e9diaire - Distance : 19 km.\n\nATTENTION : il n'est pas possible de louer de v\u00e9lo pour cette balade.\n\nSautez en selle et partez explorer les diff\u00e9rentes facettes spirituelles et sacr\u00e9es de Bruxelles. Cette randonn\u00e9e urbaine vous emm\u00e8nera au-del\u00e0 des fronti\u00e8res des grandes religions, \u00e0 la rencontre de communaut\u00e9s \u00e9tablies, connues ou m\u00e9connues, parfois mal comprises ou diabolis\u00e9es, chacune riche de ses propres croyances et pratiques. De la m\u00e9ditation tranquille des bouddhistes aux rituels solennels des francs-ma\u00e7ons, en passant par les chants des \u00e9vang\u00e9liques ou d'autres cultes plus discrets ou myst\u00e9rieux, chaque \u00e9tape vous plonge dans un univers diff\u00e9rent. Une invitation \u00e0 d\u00e9couvrir la riche tapisserie sprirituelle de Bruxelles, qui fait de la ville non seulement un centre politique europ\u00e9en, mais aussi un carrefour de rencontres spirituelles moins conventionnelles.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.provelo.org\/events\/les-dieux-de-bruxelles-2\/","email":"info@provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":"+32 2 502 73 55","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50010790"},"sp":{"name":"Les dieux de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.provelo.org\/events\/les-dieux-de-bruxelles-2\/","email":"info@provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":"+32 2 502 73 55","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50010790"},"nl":{"name":"Les dieux de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.provelo.org\/events\/les-dieux-de-bruxelles-2\/","email":"info@provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":"+32 2 502 73 55","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50010790"}},"place":{"id":280345,"translations":{"de":{"name":"Rue de Dublin ","address_street_name":"Rue de Dublin","address_street_number":"19","address_street_b