2022-07-08T10:05:13+02:00","published_at":"2022-07-08T09:22:43+02:00","backoffice_id":258075,"import_origin":null,"sub_type":"festival","show_in_agenda":true,"ranking":2},{"id":535955,"date_start":"2022-08-28","date_end":"2022-08-28","date_next":"2022-08-28","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{"list":[112],"translations":{"fr":["Insolite"],"nl":["Ongewoon"],"en":["Unusual"]}}},"languages":{"spoken":["en","fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Dimanche \u00e0 v\u00e9lo - Grimbergen","shortdescr":"Profitez du r\u00e9veil silencieux de la ville le dimanche matin. D\u00e9couvrez le plaisir du v\u00e9lo \u00e0 Bruxelles et les endroits surprenants de la ville et de sa p\u00e9riph\u00e9rie.","longdescr":"FR\/ Profitez du r\u00e9veil silencieux de la ville le dimanche matin. Une agr\u00e9able promenade \u00e0 v\u00e9lo, id\u00e9ale pour une petite dose d'exercice et pour rencontrer d'autres Bruxellois \u00e0 v\u00e9lo ! Nous nous rendons \u00e0 v\u00e9lo \u00e0 Grimbergen o\u00f9 nous nous arr\u00eatons au Tommen- et au Liermolen. Nos guides traceront un parcours agr\u00e9able d'environ 20 km. Vers midi, nous arrivons aux moulins \u00e0 eau de Grimbergen et profitons de l'endroit avec un pique-nique - auberge espagnole. Vers 13 heures, il est possible de retourner au centre \u00e0 v\u00e9lo avec l'un de nos guides.","performers":null,"boxoffice_url":null,"website":"https:\/\/cactus.brussels\/brussel-velo\/zondag-a-velo","email":"info@cactus.brussels","phone_contact":null,"phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/535955.html"},"nl":{"name":"Dimanche \u00e0 v\u00e9lo - Grimbergen","shortdescr":"Geniet mee van de nog stille ontwakende stad op zondagochtend. Ontdek het fietsen in Brussel en verrassende plekken in de stad en de rand.","longdescr":"Geniet mee van de nog stille ontwakende stad op zondagochtend. Een gezellige fietstocht, ideaal voor een gezonde dosis beweging en ontmoetingen met andere Brusselaars op de fiets! We fietsen naar Grimbergen waar we stoppen aan de Tommen- en Liermolen. Onze gidsen stippelen een leuke route uit van zo\u2019n 20km. Tegen de middag komen we aan de Grimbergse watermolens en genieten we van de plek met een picknick - auberge espagnol. Rond 13u kan je met \u00e9\u00e9n van onze gidsen terugfietsen richting het centrum.","performers":null,"boxoffice_url":null,"website":"https:\/\/cactus.brussels\/brussel-velo\/zondag-a-velo","email":"info@cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/535955.html"},"en":{"name":"Dimanche \u00e0 v\u00e9lo - Grimbergen","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/535955.html"},"de":{"name":"Dimanche \u00e0 v\u00e9lo - Grimbergen","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/535955.html"},"it":{"name":"Dimanche \u00e0 v\u00e9lo - Grimbergen","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/535955.html"},"sp":{"name":"Dimanche \u00e0 v\u00e9lo - Grimbergen","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/535955.html"},"pt":{"name":"Dimanche \u00e0 v\u00e9lo - Grimbergen","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/535955.html"},"cn":{"name":"Dimanche \u00e0 v\u00e9lo - Grimbergen","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/535955.html"}},"place":{"id":276966,"translations":{"fr":{"name":"Grand Hospice","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"hospice@pali-pali.com","website":"http:\/\/grand-hospice.brussels","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 7","address_line2":"1000 Bruxelles","description_web":"Projet d\u2019occupation temporaire du site de l'Hospice Pacheco. Rejoignez-nous du lundi au dimanche pour profiter de ce petit havre de paix en plein centre de Bruxelles.\r\nLe projet, g\u00e9r\u00e9 par PaliPali, prend place jusqu\u2019en d\u00e9cembre 2023. Pour faire vivre ce petit oasis de verdure, Pali Pali s\u2019est associ\u00e9 \u00e0 Jardin afin de g\u00e9rer la guinguette du site. L\u2019id\u00e9e est de mettre \u00e0 disposition des \u00e9quipements pour l\u2019ensemble du quartier selon deux principes : cr\u00e9er du lien et vivre ensemble.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Grand Hospice","address_street_name":"Grootgodshuisstraat","address_street_number":"7","address_street_box":null,"email":"hospice@pali-pali.com","website":"http:\/\/grand-hospice.brussels","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Grootgodshuisstraat, 7","address_line2":"1000 Brussel","description_web":"In afwachting van de grote renovatie die nodig is om een complex van wooneenheden en gemeenschapsdiensten te cre\u00ebren, heeft het Brusselse OCMW beslist het Hospice Pacheco ter beschikking te stellen voor een vernieuwend project met een sterke sociale en culturele ori\u00ebntatie.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Grand Hospice","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"hospice@pali-pali.com","website":"http:\/\/grand-hospice.brussels","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue du Grand Hospice, 7","address_line2":"1000 Brussels","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Grand Hospice","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"hospice@pali-pali.com","website":"http:\/\/grand-hospice.brussels","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 7","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Grand Hospice","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"hospice@pali-pali.com","website":"http:\/\/grand-hospice.brussels","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 7","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Grand Hospice","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"hospice@p