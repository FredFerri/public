1\/08 - Molkky 2 (deadline pour s'inscrire: 08 aout \u00e0 12h)\r\n28\/08 - Beach Volley 2 (deadline pour s'inscrire: 15 aout \u00e0 12h)\r\n\r\nDATE LIMITE pour s'inscrire: 2 semaines avant le tournoi (deadline le dimanche \u00e0 23h)\r\n\r\nINSCRIPTION","performers":null,"boxoffice_url":null,"website":"https:\/\/www.see-u.brussels\/","email":"see-u@pali-pali.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/535783.html"},"nl":{"name":"Tournois des sportifs du dimanche","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/535783.html"},"en":{"name":"Tournois des sportifs du dimanche","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/535783.html"},"de":{"name":"Tournois des sportifs du dimanche","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/535783.html"},"it":{"name":"Tournois des sportifs du dimanche","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/535783.html"},"sp":{"name":"Tournois des sportifs du dimanche","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/535783.html"},"pt":{"name":"Tournois des sportifs du dimanche","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/535783.html"},"cn":{"name":"Tournois des sportifs du dimanche","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/535783.html"}},"place":{"id":273506,"translations":{"fr":{"name":"See U","address_street_name":"Rue Fritz Toussaint","address_street_number":"8","address_street_box":"1050","email":"contact@see-u.brussels","website":"https:\/\/www.see-u.brussels\/","phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Fritz Toussaint, 8\/1050","address_line2":"1050 Ixelles","description_web":"Inscrit dans une d\u00e9marche d\u2019occupation temporaire, See U accueille depuis le printemps 2019 plus de cinquante porteurs de projets pour faire vivre et revivre ce lieu historique unique et lui apporter une nouvelle lumi\u00e8re. Les projets qui animent le site s\u2019inscrivent dans une logique de d\u00e9couverte, sous l\u2019angle d\u2019un avenir social et durable. L\u2019objectif est que See U fasse r\u00e9f\u00e9rence \u00e0 l\u2019occupation finale du site et devienne ainsi une invitation \u00e0 d\u00e9couvrir le projet d\u00e9finitif Usquare.brussels.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"See U","address_street_name":"Fritz Toussaintstraat","address_street_number":"8","address_street_box":"1050","email":"contact@see-u.brussels","website":"https:\/\/www.see-u.brussels\/","phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"Fritz Toussaintstraat, 8\/1050","address_line2":"1050 Elsene","description_web":"See U is het programma voor de nieuwe tijdelijke bezetting van de voormalige Fritz Toussaintkazerne in Elsene, volledig in het teken van duurzame ontwikkeling.\r\nSee U verwelkomt een veertigtal projecten om deze unieke historische site nieuw leven in te blazen. Deze projecten vertrekken vanuit het perspectief van een sociale en duurzame toekomst. De bedoeling is dat See U een uitnodiging wordt om het definitieve project Usquare.brussels te ontdekken.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"See U","address_street_name":"Rue Fritz Toussaint","address_street_number":"8","address_street_box":"1050","email":"contact@see-u.brussels","website":"https:\/\/www.see-u.brussels\/","phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Fritz Toussaint, 8\/1050","address_line2":"1050 Ixelles","description_web":"As part of a temporary occupation approach, See U has welcomed more than fifty project leaders since spring 2019 to breathe new life into this unique historical site. The projects that animate the former Fritz Toussaint barracks in Ixelles are part of a discovery process, in line with the perspective of a social and sustainable future. See U is an invitation to discover the final Usquare.brussels project.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"See U","address_street_name":"Rue Fritz Toussaint","address_street_number":"8","address_street_box":"1050","email":"contact@see-u.brussels","website":"https:\/\/www.see-u.brussels\/","phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Fritz Toussaint, 8\/1050","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"See U","address_street_name":"Rue Fritz Toussaint","address_street_number":"8","address_street_box":"1050","email":"contact@see-u.brussels","website":"https:\/\/www.see-u.brussels\/","phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Fritz Toussaint, 8\/105