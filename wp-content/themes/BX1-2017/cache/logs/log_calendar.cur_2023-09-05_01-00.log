date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":265392,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"tour","ranking":0.1340655829969691,"languages":{"spoken":["fr","en","de","es"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{}},"translations":{"de":{"name":"Le City Tour de Bruxelles le plus complet","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.brussels-city-tours.com\/","email":"info@brussels-city-tours.com","phone_contact":"+32 2 513 77 44","phone_booking":"+32 2 513 77 44","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.545392"},"pt":{"name":"Le City Tour de Bruxelles le plus complet","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.brussels-city-tours.com\/","email":"info@brussels-city-tours.com","phone_contact":"+32 2 513 77 44","phone_booking":"+32 2 513 77 44","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.545392"},"en":{"name":"Half-day City Tour of Brussels","shortdescr":"This is a great way to discover Brussels. This tour will be an eye-opener that helps you understand Belgium and to see its links with European history. We advise you to take this excursion upon your arrival in Belgium.","longdescr":"See all the sights of Brussels in a half-day tour on a bus and walking tour. Discover the tourist sites with a multilingual guide. Your visit begins with a walk through the historic heart of medieval Brussels. Discover the amazing town hall located on the Grand Place and learn about the city's rich heritage. Then, hop aboard a luxury coach to see the city's top sights; you will pass in front of the colossal cathedral of Saint-Michel and Gudule. Marvel at the lavish buildings of the European Quarter and glimpse the majestic exterior of the Royal Residence. On the Heysel district you will discover the Atomium; and embrace the cosmopolitan culture of the Japanese Tower and the Chinese Pavilion.","performers":null,"boxoffice_url":"http:\/\/ticket.visit.brussels\/en\/545392\/half-day-city-tour-of-brussels\/shop","website":"http:\/\/www.brussels-city-tours.com\/","email":"info@brussels-city-tours.com","phone_contact":"+32 2 513 77 44","phone_booking":"+32 2 513 77 44","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.545392"},"it":{"name":"Le City Tour de Bruxelles le plus complet","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.brussels-city-tours.com\/","email":"info@brussels-city-tours.com","phone_contact":"+32 2 513 77 44","phone_booking":"+32 2 513 77 44","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.545392"},"cn":{"name":"Le City Tour de Bruxelles le plus complet","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.brussels-city-tours.com\/","email":"info@brussels-city-tours.com","phone_contact":"+32 2 513 77 44","phone_booking":"+32 2 513 77 44","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.545392"},"fr":{"name":"Excursion d'une demi-journ\u00e9e \u00e0 Bruxelles","shortdescr":"Cette excursion est un excellent moyen de d\u00e9couvrir Bruxelles. Elle vous ouvrira les yeux et vous aidera \u00e0 comprendre la Belgique et \u00e0 voir nos liens avec l'histoire europ\u00e9enne. Nous vous conseillons de faire cette excursion d\u00e8s votre arriv\u00e9e en Belgique.","longdescr":"D\u00e9couvrez tous les sites touristiques de Bruxelles en une matin\u00e9e lors d'une visite en bus et \u00e0 pied. Partez \u00e0 sa d\u00e9couverte avec un guide multilingues. Votre visite commence avec une promenade dans le c\u0153ur historique de Bruxelles m\u00e9di\u00e9vale. D\u00e9couvrez l\u2019\u00e9tonnant h\u00f4tel de ville situ\u00e9 sur la Grand Place et \u00e9coutez les t\u00e9moignages de votre guide sur le riche patrimoine de la ville. Ensuite, montez \u00e0 bord d\u2019un autocar de luxe pour visiter les sites les plus attrayants de la ville; passez devant la colossale cath\u00e9drale Saint-Michel et Gudule. \u00c9merveillez-vous des somptueux b\u00e2timents du quartier europ\u00e9en et apercevez l\u2019ext\u00e9rieur majestueux de la R\u00e9sidence royale. Sur le plateau du Heysel vous allez d\u00e9couvrir l'Atomium; et embrasser la culture cosmopolite de la tour japonaise et du pavillon chinois.","performers":null,"boxoffice_url":"http:\/\/ticket.visit.brussels\/fr\/545392\/excursion-d-une-demi-journee-a-bruxelles\/shop","website":"http:\/\/www.brussels-city-tours.com\/","email":"info@brussels-city-tours.com","phone_contact":"+32 2 513 77 44","phone_booking":"+32 2 513 77 44","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.545392"},"sp":{"name":"Le City Tour de Bruxelles le plus complet","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.brussels-city-tours.com\/","email":"info@brussels-city-tours.com","phone_contact":"+32 2 513 77 44","phone_booking":"+32 2 513 77 44","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.545392"},"nl":{"name":"Halfdaagse stadstour van Brussel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"http:\/\/ticket.visit.brussels\/nl\/545392\/halfdaagse-stadstour-van-brussel\/shop","website":"http:\/\/www.brussels-city-tours.com\/","email":"info@brussels-city-tours.com","phone_contact":"+32 2 513 77 44","phone_booking":"+32 2 513 77 44","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.545392"}},"place":{"id":251867,"translations":{"de":{"name":"Brussels City Tours","address_street_name":"Rue du Marc