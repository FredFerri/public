updated_at":"2023-06-16T11:35:21+02:00","published_at":"2023-06-16T11:24:51+02:00","backoffice_id":279743,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":1.2599210498949},{"id":559986,"date_start":"2023-07-29","date_end":"2023-07-29","date_next":"2023-07-29","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen","it":"Visite guidate","sp":"Visitas guiadas","pt":null,"cn":null}},"others":{"list":[104],"translations":{"fr":["Art Nouveau, Art D\u00e9co"],"nl":["Art nouveau, art deco"],"en":["Art Nouveau, Art D\u00e9co"],"de":["Jugendstil, Art d\u00e9co"],"it":["Art Nouveau, Art D\u00e9co"],"sp":["Art nouveau, art d\u00e9co"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Symbolisme, Id\u00e9alisme et Art Nouveau au Mus\u00e9e Fin-de-Si\u00e8cle","shortdescr":"Exceptionnel carrefour des arts et avant-gardes depuis les expositions du Groupe Les XX et La Libre Esth\u00e9tique, Bruxelles \"Fin de si\u00e8cle\" \u00e9tablit aussi une convergence entre le Symbolisme, sa variante l'Id\u00e9alisme et l'Art nouveau.","longdescr":"L'art total, depuis l'op\u00e9ra de Wagner, est un concept qui stimule les cr\u00e9ateurs, qu'ils soient artistes peintres, compositeurs, architectes et \u00e9crivains. Khnopff, par exemple, est peintre, sculpteur, cr\u00e9ateur de d\u00e9cors et de costumes, illustrateur de livres, adepte de la photographie et inventeur de sa propre maison \"Temple du Moi\". Si les symbolistes se tournent davantage vers l'exclusivit\u00e9 et l'int\u00e9riorit\u00e9, l'Art nouveau aspire, en th\u00e9orie, \u00e0 une pratique plus \"sociale\", introduisant la beaut\u00e9 dans les quotidiens. L'exceptionnelle collection Gillion Crowet brasse ces courants et confronte les cr\u00e9ations bruxelloises de Horta, Khnopff, Wolfers ou Delville aux exemples internationaux de Daum, Majorelle, Lalique ou Mucha.","performers":"Symbolisme, Id\u00e9alisme et Art Nouveau au Mus\u00e9e Fin-de-Si\u00e8cle \r\nVisite guid\u00e9e pour adultes par Muriel De Groef","boxoffice_url":null,"website":"http:\/\/www.fine-arts-museum.be","email":"info@fine-arts-museum.be","phone_contact":null,"phone_booking":"+32 2 508 33 33","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.559986"},"nl":{"name":"Symbolisme, Id\u00e9alisme et Art Nouveau au Mus\u00e9e Fin-de-Si\u00e8cle","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.fine-arts-museum.be","email":"info@fine-arts-museum.be","phone_contact":null,"phone_booking":"+32 2 508 33 33","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.559986"},"en":{"name":"Symbolisme, Id\u00e9alisme et Art Nouveau au Mus\u00e9e Fin-de-Si\u00e8cle","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.fine-arts-museum.be","email":"info@fine-arts-museum.be","phone_contact":null,"phone_booking":"+32 2 508 33 33","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.559986"},"de":{"name":"Symbolisme, Id\u00e9alisme et Art Nouveau au Mus\u00e9e Fin-de-Si\u00e8cle","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.fine-arts-museum.be","email":"info@fine-arts-museum.be","phone_contact":null,"phone_booking":"+32 2 508 33 33","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.559986"},"it":{"name":"Symbolisme, Id\u00e9alisme et Art Nouveau au Mus\u00e9e Fin-de-Si\u00e8cle","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/ww