e27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-05-20T02:00:53+02:00","published_at":"2024-04-11T12:03:16+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":298240,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.2832581674713524,"languages":{"spoken":["en","nl","fr"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[46,36],"translations":{"de":["Multidisziplin\u00e4r","Museen & Kunstzentren"],"pt":[null,null],"en":["Multidisciplinary","Museums and art centers"],"it":["Multidisciplinare","Musei e centri artistici"],"cn":[null,null],"fr":["Pluridisciplinaire","Mus\u00e9es et art centers"],"sp":["Multidisciplinar","Museos y centros de arte"],"nl":["Multidisciplinair","Musea en kunstcentra"]}}},"translations":{"de":{"name":"Exposition immersive Mers & Oc\u00e9ans","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/talk-cec.com\/","email":"talk.cec@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50009537"},"pt":{"name":"Exposition immersive Mers & Oc\u00e9ans","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/talk-cec.com\/","email":"talk.cec@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50009537"},"en":{"name":"Exposition immersive Mers & Oc\u00e9ans","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/talk-cec.com\/","email":"talk.cec@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50009537"},"it":{"name":"Exposition immersive Mers & Oc\u00e9ans","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/talk-cec.com\/","email":"talk.cec@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50009537"},"cn":{"name":"Exposition immersive Mers & Oc\u00e9ans","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/talk-cec.com\/","email":"talk.cec@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50009537"},"fr":{"name":"Exposition immersive Mers & Oc\u00e9ans","shortdescr":"\u00c0 l'occasion de son premier anniversaire, Talk C.E.C, nouvel espace de Cr\u00e9ation d\u2019Exp\u00e9riences Culturelles, c\u00e9l\u00e8bre une ann\u00e9e de d\u00e9couvertes et d'engagements artistiques ! Nich\u00e9 au sein de l\u2019ancienne manufacture de porcelaine Demeuldre, nous vous donnons rendez-vous du 12 avril au 7 juillet \u00e0 venir (re)d\u00e9couvrir l\u2019exposition \u00e9volutive et immersive Mers & Oc\u00e9ans. ","longdescr":"\u00c0 l'occasion de son premier anniversaire, Talk C.E.C, nouvel espace de Cr\u00e9ation d\u2019Exp\u00e9riences Culturelles, c\u00e9l\u00e8bre une ann\u00e9e de d\u00e9couvertes et d'engagements artistiques ! Nich\u00e9 au sein de l\u2019ancienne manufacture de porcelaine Demeuldre, nous vous donnons rendez-vous du 12 avril au 7 juillet \u00e0 venir (re)d\u00e9couvrir l\u2019exposition \u00e9volutive et immersive Mers & Oc\u00e9ans. \n\nDe nouveaux artistes prennent part \u00e0 cette aventure, avec une volont\u00e9 de mettre en valeur le patrimoine architectural de notre lieu afin de cr\u00e9er une symbiose parfaite entre l'exposition et son environnement. En explorant chaque niveau, chaque couloir et chaque salle, vous \u00eates plong\u00e9 dans un dialogue constant entre l'art, la science, et l\u2019histoire du lieu,  cr\u00e9ant ainsi une exp\u00e9rience in\u00e9dite se d\u00e9roulant dans 3.500 m\u00e8tres carr\u00e9s. \n\nIl fallait bien un endroit aussi embl\u00e9matique que l\u2019ancienne manufacture de porcelaine Maison Demeuldre et ses 3500 m2 pour se mesurer \u00e0 un th\u00e8me d\u2019une telle envergure ! L\u2019exposition biennale Mers & Oc\u00e9ans a \u00e9t\u00e9 pens\u00e9e pour refl\u00e9ter l'\u00e9volution constante de notre compr\u00e9hension de l\u2019environnement et de ses enjeux. Imagin\u00e9e comme un laboratoire d\u2019id\u00e9es, au total ce sont 60 artistes et des  scientifiques du monde entier qui ont contribu\u00e9 \u00e0 la r\u00e9ussite de ce projet ambitieux. Chaque pi\u00e8ce offre une exp\u00e9rience unique et immersive. Au programme : fresques murales, exp\u00e9riences visuelles et sonores, installations, \u00e9v\u00e9nements sc\u00e9niques et conf\u00e9rences avec le public rythmeront ce v\u00e9ritable voyage dans les profondeurs marines. Sans plus attendre,  ach\u00e8te tes billets maintenant pour Mers & Oc\u00e9ans \u00e0 Ixelles !\n","performers":"Mister Copy, Olivier Coisne, Naga, Aero, Yves Gaumetou, Kaf\u00e9 Kors\u00e9, Bungleced, Christian Clauwers, Sylvain Wavrant, Letizia Artioli, Wall Street Colors, etc.\n","boxoffice_url":null,"website":"https:\/\/talk-cec.com\/","email":"talk.cec@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50009537"},"sp":{"name":"Exposition immersive Mers & Oc\u00e9ans","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/talk-cec.com\/","email":"talk.cec@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50009537"},"nl":{"name":"Exposition immersive Mers & Oc\u00e9ans","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/talk-cec.com\/","email":"talk.cec@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50009537"}},"place":{"last_updated_at":"2023-05-09T11:19:54+02:00","published_at":"2022-03-22T18:55:46+01:00","id":278034,"translations":{"de":{"name":"TALK C.E.C","address_street_name":"Chauss\u00e9e de Wavre","address_street_number":"141-143","address_street_box":null,"email":null,"website":"https:\/\/talk-gallery.com\/","phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Chauss\u00e9e de Wavre, 141-143","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"TALK C.E.C","address_street_name":"Chauss\u00e9e de Wavre","address_street_number":"141-143","address_street_box":null,"email":null,"website":"https:\/\/talk-gallery.com\/","phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Chauss\u00e9e de Wavre, 141-143","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"TALK C.E.C","address_street_name":"Chauss\u00e9e de Wavre","address_street_number":"141-143","address_street_box":null,"email":null,"website":"https:\/\/talk-gallery.com\/","phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Chauss\u00e9e de Wavre, 141-143","address_line2":"1050 Ixelles","description_web":"Talk C.E.C. (Cultural Experiences Creators), is taking the Demeuldre Establishments, a former porcelain factory dating from 1830, into a