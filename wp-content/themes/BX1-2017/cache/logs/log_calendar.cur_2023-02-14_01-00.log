ions":{"fr":{"name":"Jeunes"},"nl":{"name":"Jongeren"},"en":{"name":"Young people"},"de":{"name":"Jugendliche"},"it":{"name":"Ragazzi"},"sp":{"name":"J\u00f3venes"},"pt":{"name":"Jeunes"},"cn":{"name":"Jeunes"}},"value":10},{"translations":{"fr":{"name":"Etudiants"},"nl":{"name":"Studenten"},"en":{"name":"Students"},"de":{"name":"Studierende"},"it":{"name":"Studenti"},"sp":{"name":"Estudiantes"},"pt":{"name":"Etudiants"},"cn":{"name":"Etudiants"}},"value":10},{"translations":{"fr":{"name":"Pr\u00e9vente"},"nl":{"name":"Voorverkoop"},"en":{"name":"Presale"},"de":{"name":"Vorverkauf"},"it":{"name":"Prevendita"},"sp":{"name":"Preventa"},"pt":{"name":"Pr\u00e9vente"},"cn":{"name":"Pr\u00e9vente"}},"value":13},{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"},"de":{"name":"Normal"},"it":{"name":"Normale"},"sp":{"name":"Normal"},"pt":{"name":"Normal"},"cn":{"name":"Normal"}},"value":15}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":{"list":[255,259,263],"translations":{"fr":["Accessible","Chien d'assistance","Accessible aux pi\u00e9tons appareill\u00e9s"],"nl":["Toegankelijk","Assistentiehonden","Toegankelijk voor voetgangers met hulpmiddelen"],"en":["Accessible","Assistance dogs","Accessible to pedestrians with mobility aids"],"de":["Barrierefrei","Assistenzhund","Barrierefrei f\u00fcr Fu\u00dfg\u00e4nger mit Gehhilfe"],"it":["Accessibile","Cane guida","Accessibile ai pedoni con supporti"],"sp":["Habilitado","Perros gu\u00eda","Habilitado para peatones con aud\u00edfonos"],"pt":[null,null,null],"cn":[null,null,null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2023-02-10T18:05:48+01:00","published_at":"2022-08-23T14:40:05+02:00","backoffice_id":260185,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":0.18616131324212},{"id":549979,"date_start":"2023-01-28","date_end":"2023-03-04","date_next":"2023-03-04","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen","it":"Visite guidate","sp":"Visitas guiadas","pt":null,"cn":null}},"others":{"list":[253],"translations":{"fr":["Visites guid\u00e9es d\u2019int\u00e9rieurs"],"nl":["Interieur rondleidingen"],"en":["Interior guided tours"],"de":["F\u00fchrungen durch Innenr\u00e4ume"],"it":["Visite guidate all\u2019interno"],"sp":["Visitas guiadas en espacios interiores"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Palais de justice de Bruxelles","shortdescr":"Le Palais de justice est un cas \u00e0 part, un v\u00e9ritable \u201cmonument\u201d, dans tous les sens du terme, du patrimoine bruxellois... Gigantesque, ce colosse est plus grand que la basilique Saint-Pierre de Rome !","longdescr":"Le Palais de justice est un cas \u00e0 part, un v\u00e9ritable \u201cmonument\u201d, dans tous les sens du terme, du patrimoine bruxellois... Gigantesque, ce colosse est plus grand que la basilique Saint-Pierre de Rome ! Au moment de la construction du b\u00e2timent, l\u2019intention est claire : tout est fait pour impressionner, depuis l\u2019ext\u00e9rieur comme \u00e0 l\u2019int\u00e9rieur. Lieu symbolique, porteur d\u2019une lourde histoire, le palais de justice est \u00e9rig\u00e9 sur l\u2019ancien \u201cMont des Potences\u201d, o\u00f9 l\u2019on ex\u00e9cutait les condamn\u00e9s au Moyen \u00c2ge. La l\u00e9gende raconte qu\u2019au 16e si\u00e8cle, le c\u00e9l\u00e8bre m\u00e9decin V\u00e9sale allait y d\u00e9rober les cadavres la nuit pour \u00e9tudier le corps humain\u2026\r\n\r\nC\u2019est un des monuments les plus impressionnants de Bruxelles qui offre \u00e0 ses c\u00f4t\u00e9s un panorama \u00e9poustouflant sur le bas de la ville. Il est l\u2019\u0153uvre de Joseph Poelart, qui remporte le concours international mis en place par le gouvernement belge en 1860. L\u2019inauguration du palais aura lieu le 15 octobre 1883, 4 ans apr\u00e8s la mort de son architecte.\r\n\r\nAdul\u00e9 par certains, d\u00e9cri\u00e9 par d\u2019autres, cet ouvrage pharaonique compte 40.000 m\u00b2 de surface exploitable ; sa coupole culmine \u00e0 plus de 100 m\u00e8tres de hauteur et il contient plus de 250 locaux dont 27 salles d\u2019audience impressionnantes !\r\nLa visite du Palais de justice vous permettra d\u2019en savoir plus sur son histoire truculente, mais aussi sur l\u2019architecture du b\u00e2timent, sur les \u0153uvres d\u2019art qu\u2019il renferme ou encore sur le syst\u00e8me judiciaire belge. Les visites en fran\u00e7ais sont assur\u00e9es par Arkadia et les visites en n\u00e9erlandais et en anglais par Korei Guides Tours.\r\n\r\nPrix \u00e9tudiant (-26 ans) sur demande \u00e0 info@arkadia.be : 10\u20ac le mercredi et 13\u20ac le samedi\r\n\r\nRemarques importantes :\r\n\r\nLes r\u00e9servations ne peuvent se faire qu'en ligne \u00e0 l'avance. Nous demandons aux visteurs d'arriver 15 min en avance pour passer le contr\u00f4le de s\u00e9curit\u00e9. Les retardataires ne pouront plus rejoindre le groupe.\r\n\r\nContr\u00f4le de s\u00e9curit\u00e9 : les objets tranchants tels que couteaux, compas, etc. sont interdits.\r\nLe b\u00e2timent a un acc\u00e8s limit\u00e9 pour les participants \u00e0 mobilit\u00e9 r\u00e9duite. Veuillez contacter info@arkadia.be \u00e0 l'avance pour voir ce qui est possible.\r\n\r\nLes photos sont autoris\u00e9es sauf dans les salles d'audience quand une audience est en cours.\r\n\r\nEn collaboration avec Urban.brussels \u2013 Service Public F\u00e9d\u00e9ral Justice \u2013 R\u00e9gie des B\u00e2timents","performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/palais-de-justice-de-bruxelles","email":"info@arkadia.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.549979"},"nl":{"name":"Palais de justice de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/palais-de-justice-de-bruxelles","email":"info@arkadia.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.549979"},"en":{"name":"Palais de justice de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/palais-de-justice-de-bruxelles","email":"info@arkadia.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.549979"},"de":{"name":"Cloner ce contenu Palais de justice de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/palais-de-justice-de-bruxelles","email":"info@arkadia.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.549979"},"it":{"name":"Cloner ce contenu Palais de justice de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/palais-de-justice-de-bruxelles","email":"info@arkadia.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.549979"},"sp":{"name":"Cloner ce contenu Palais de justice de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/palais-de-justice-de-bruxelles","email":"info@arkadia.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.549979"},"pt":{"name":"Cloner ce contenu Palais de justice de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/palais-de-justice-de-bruxelles","email":"info@arkadia.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.549979"},"cn":{"name":"Cloner ce contenu Palais de justice de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/palais-de-justice-de-bruxelles","email":"info@arkadia.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.549979"}},"place":{"id":232780,"translations":{"fr":{"name":"Le Palais de Justice de Bruxelles","address_street_name":"Place Poelaert","address_street_number":"1","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Poelaert, 1","address_line2":"1000 Bruxelles","description_web":"On est (presque) pris d\u2019un vertige face \u00e0 cette gigantesque b\u00e2tisse. Tout est fait pour impressionner, \u00e0 l\u2019ext\u00e9rieur comme \u00e0 l\u2019int\u00e9rieur. Lieu symbolique et porteur d\u2019une lourde histoire, le Palais de Justice est \u00e9rig\u00e9 sur le (bien nomm\u00e9) Mont des Potences o\u00f9 l\u2019on ex\u00e9cutait les condamn\u00e9s au Moyen- Age.\u202fLa l\u00e9gende raconte qu\u2019au XVI\u00e8me si\u00e8cle, le c\u00e9l\u00e8bre m\u00e9decin V\u00e9sale allait y d\u00e9rober les cadavres la nuit pour \u00e9tudier le corps humain\u2026 \r\n\r\nC\u2019est un des monuments les plus impressionnants de Bruxelles qui offre \u00e0 ses c\u00f4t\u00e9s un panorama \u00e9poustouflant sur le bas de la ville. \r\n\r\nUn peu d\u2019histoire \r\n\r\nEn mars 1860, (sous L\u00e9opold Ier), le gouvernement belge organise un concours international pour la construction d\u2019un nouveau palais de justice \u00e0 Bruxelles. \r\nLe jury ne retient aucun des projets pr\u00e9sent\u00e9s et le dossier est confi\u00e9 \u00e0 l\u2019architecte de la Ville de Bruxelles (qui faisait partie du jury !). \r\n\r\nLe projet de Joseph Poelaert est pharaonique : faire la synth\u00e8se de l'histoire de l'humanit\u00e9 dans l'architecture de ce seul b\u00e2timent. La construction qui d\u00e9bute finalement en octobre 1866 prendra 17 ans. \r\n\r\nElle entra\u00eene le sacrifice d\u2019une partie des Marolles, le quartier populaire du bas de la ville, \u00e0 coup d\u2019expropriations \u00e0 prix d\u00e9risoires, d\u2019expulsions et de d\u00e9molitions. \r\n\r\nL\u2019inauguration (sous L\u00e9opold II) aura lieu le 15 octobre 1883, sans que l\u2019architecte de ce colosse n\u2019ait pu voir son oeuvre achev\u00e9e. Epuis\u00e9 et devenu fou, il meurt quatre ans avant la fin des travaux. \r\n\r\nLe \u00ab Skieven architek \u00bb et \u00ab Le grand encrier \u00bb\u2026 \r\n\r\nLe monument ne laisse personne indiff\u00e9rent. Il est ador\u00e9 par certains et moqu\u00e9 par d\u2019autres. \r\n\r\nPour la r\u00e9alisation du projet, Poelaert b\u00e9n\u00e9ficie d\u2019une tr\u00e8s grande libert\u00e9, tant artistique que financi\u00e8re, ce qui va provoquer un m\u00e9contentement populaire, politique et culturel. \r\n\r\nNaissent des expressions savoureuses comme \u00ab Rotten \u00bb et \u00ab Skieven architek \u00bb (architecte pourri ou tordu) qui deviendra le nom d\u2019un caf\u00e9 de la Place du Jeu de Balle au c\u0153ur des Marolles. \r\n\r\nVictor Horta qualifiera le b\u00e2timent de \u00ab \u2026 Masse \u00e9crasante couronn\u00e9e par une cloche \u00e0 fromage \u00bb. Freud en fait un bel \u00e9loge \u00ab Au sommet d\u2019une colline rapide se dresse un b\u00e2timent massif, avec des colonnes si belles que l\u2019ensemble \u00e9voque un palais royal assyrien ou une illustration de Gustave Dor\u00e9 \u00bb. Victor Hugo le baptisera \u00ab le grand encrier \u00bb . \r\n\r\nLe plus grand palais (de justice) du monde\u2026 \r\n\r\nDe style classique gr\u00e9co romain, plus grand que la Basilique St Pierre \u00e0 Rome, il est (encore \u00e0 ce jour) le plus grand palais de Justice du monde : \r\n\r\n40.000 m2 \r\n\r\nune coupole qui culmine \u00e0 100 m\u00e8tres de haut \r\n\r\nune salle des pas perdus pharaonique \r\n\r\nplus de 250 locaux, dont 27 impressionnantes salles d\u2019audience \u2026 \r\n\r\n\u00ab Une architecture cyclop\u00e9enne, r\u00eav\u00e9e par des mains n\u2019ayant pas conscience de l\u2019\u00e9chelle humaine \u00bb (Victor Horta) ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Het Brusselse Justitiepaleis","address_street_name":"Poelaertplein","address_street_number":"1","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Poelaertplein, 1","address_line2":"1000 Brussel","description_web":"Wie voor dit gigantische gebouw staat, kan gaan duizelen. Alles is gedaan om indruk te maken, zowel binnen als buiten. Het Justitiepaleis, een symbolische plek met een zware geschiedenis, is gebouwd op de (toepasselijk genaamde) Galgenberg, waar veroordeelde middeleeuwers werden terechtgesteld. Volgens de legende ging de beroemde 16e-eeuwse dokter Vesalius er 's nachts lijken stelen, zodat hij het menselijk lichaam kon bestuderen... \r\n\r\nHet is een van de indrukwekkendste monumenten in Brussel en biedt een adembenemend uitzicht op de benedenstad. \r\n\r\nEen beetje geschiedenis \r\nIn maart 1860 (onder Leopold I) hield de Belgische regering een internationale wedstrijd voor de bouw van een nieuw justitiepaleis in Brussel. De jury weigerde alle ingediende projecten en het project werd toevertrouwd aan de architect van de Stad Brussel (die deel uitmaakte van de jury!). \r\n\r\nHet project van Joseph Poelaert was megalomaan: de geschiedenis van de hele mensheid synthetiseren in de architectuur van \u00e9\u00e9n enkel gebouw. De bouw, die uiteindelijk van start ging in oktober 1866, duurde 17 jaar. Het leidde tot de opoffering van een deel van de Marollen, de volkswijk in het lagere gedeelte van de stad. Bewoners kregen te maken met onteigeningen tegen belachelijk lage prijzen, uitzettingen en afbraak. De inhuldiging (onder Leopold II) vond plaats op 15 oktober 1883, maar de architect heeft het niet kunnen meemaken. Uitgeput en tot waanzin gedreven stierf hij vier jaar voor de voltooiing van zijn meesterwerk. \r\n\r\nDe \"Skieven Architek\" en \"De Grote Inktpot\"... \r\nHet monument liet niemand onverschillig. Het werd door sommigen aanbeden en door anderen bespot. Poelaert genoot tijdens het hele project een enorme artistieke en financi\u00eble vrijheid, wat voor onvrede zorgde in de politiek, de cultuur en bij het volk. Er werden een aantal charmante uitdrukkingen bedacht, zoals 'Rotten' en 'Skieven architek' (verdraaide architect), dat de naam werd van een caf\u00e9 op het Vossenplein in het hart van de Marollen. \r\n\r\nVictor Horta beschreef het gebouw als \"... een verpletterende massa bekroond met een kaasstolp\". Freud was er vol lof over: \"Op de top van een steile heuvel staat een massief gebouw, met zuilen die zo mooi zijn dat het geheel doet denken aan een Assyrisch koninklijk paleis of een illustratie van Gustave Dor\u00e9\". Victor Hugo doopte het \"De Grote Inktpot\". \r\n\r\nHet Justitiepaleis, gebouwd in de klassieke Grieks-Romeinse stijl en groter dan de Sint-Pietersbasiliek in Rome, is (tot op heden) het grootste gerechtsgebouw ter wereld: \r\n40.000 vierkante meter \r\neen koepel die tot 100 meter hoog reikt \r\neen kolossale vestibule \r\nmeer dan 250 zalen, waaronder 27 indrukwekkende rechtszalen... \r\n\r\n\"Een cyclopische architectuur, bedacht door handen die geen weet hebben van de menselijke maat\" (Victor Horta) ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Brussels' Palace of Justice","address_street_name":"Place Poelaert","address_street_number":"1","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Place Poelaert, 1","address_line2":"1000 Brussels","description_web":"Standing in front of this gigantic building leaves you (almost) dizzy. Everything is done to impress, both inside and out. It's a symbolic place with a long history, built on the (rather aptly named) Mont des Potences, meaning Gallows Hill, where condemned men were executed in the Middle Ages.\u202fLegend has it that in the 16th century, the famous doctor Vesalius went there at night to steal corpses so that he could study the human body\u2026 \r\n\r\nIt\u2019s one of the most impressive monuments in Brussels, which also offers a breathtaking panoramic view of lower Brussels. \r\n\r\nA little history \r\nIn March 1860 (under Leopold I), the Belgian government organised an international competition for the construction of a new courthouse in Brussels. The jury did not select any of the projects presented and the project was instead entrusted to the architect of the City of Brussels (who was on the jury!). Joseph Poelaert's project was colossal: to synthesise the history of humanity in the architecture of a single building. The construction, which finally began in October 1866, took 17 years. It led to the sacrificing of part of the Marolles, the working-class district in the lower part of the city, through expropriations at derisory prices, evictions and demolitions. The inauguration (under Leopold II) was held on 15 October 1883, without the architect of this colossus having seen his work completed. Exhausted and driven mad, he died four years before the work was completed. \r\n\r\nThe \u201cSkieven architek\u201d and \u201cThe Great Inkwell\u201d\u2026 \r\nThe monument left no one indifferent. It was adored by some and mocked by others. Poelaert was granted tremendous artistic and financial freedom throughout the project, which led to popular, political and cultural discontent. A number of charming expressions were coined, such as 'Rotten' and 'Skieven architek' (twisted architect), with the latter being adopted as the name of a caf\u00e9 on Place du Jeu de Balle in the heart of the Marolles. Victor Horta described the building as \"... a crushing mass crowned by a cheese bell\". Freud praised it highly: \"At the top of a steep hill stands a massive building, with columns so beautiful that the whole evokes an Assyrian royal palace or an illustration by Gustave Dor\u00e9\". Victor Hugo christened it \"The Great Inkwell\". \r\n\r\nBuilt in the classical Greco-Roman style and larger than Saint Peter's Basilica in Rome, it is (still to this day) the largest palace of justice in the world: \r\n40,000m\u00b2 \r\na dome that reaches a height of 100 metres \r\na colossal vestibule \r\nover 250 rooms, including 27 impressive courtrooms\u2026\r\n \r\n\"A cyclopean architecture, dreamed up by hands unaware of the human scale\" (Victor Horta) ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Der Br\u00fcsseler Justizpalast","address_street_name":"Pl. Poelaert","address_street_number":"1","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Pl. Poelaert, 1","address_line2":"1000 Bruxelles","description_web":"Der Br\u00fcsseler Justizpalast z\u00e4hlt zu den bemerkenswertesten und gleichzeitig bombastischsten europ\u00e4ischen Monumenten des 19. Jh. und ist in Europa noch heute der gr\u00f6\u00dfte seiner Art.\r\n\r\nMajest\u00e4tische Dimensionen: Die L\u00e4ngs- und die Querachse des Bauwerks messen 160 bzw. 150 Meter. Die Gesamtfl\u00e4che bel\u00e4uft sich auf 26 000 m\u00b2 mit acht Innenh\u00f6fen. Dominiert wird das imposante Rechteck von einer massiven Kuppel (24 000 Tonnen) in einer H\u00f6he von 142 Metern. Architektonisch herrscht der griechisch-r\u00f6mische Stil vor. Die belgischen K\u00f6nige Leopold I. und Leopold II. wollten mit diesem symboltr\u00e4chtigen Bauwerk hoch \u00fcber der Stadt zwischen Ober- und Unterstadt ein Zeichen f\u00fcr den damals noch jungen,1830 gegr\u00fcndeten belgischen Staat setzen.\r\n\r\nEin architektonisches Mammutprojekt: Mit dem Bau wurde der Architekt Joseph Poelaert beauftragt. Von der Grundsteinlegung 1866 bis zur Einweihung 1883 vergingen ganze 17 Jahre, sie fand im Jahr 1883, bereits einige Jahre nach dem Tode Poelaerts, statt.\r\n\r\nGestern & heute: Gesellschaftlich sorgte der Bau des Kolosses seinerzeit f\u00fcr Unmut, da gro\u00dfe Teile des volkst\u00fcmlichen Marollenviertels dem Justizpalast weichen mussten - und auch heute ist er nicht unumstritten: Seit Mitte der 80er Jahre ist die Kuppel von Bauger\u00fcsten umgeben, von denen aus Sicherungs- und Restaurierungsarbeiten durchgef\u00fchrt werden.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Palazzo di Giustizia di Bruxelles","address_street_name":"pl. Poelaert","address_street_number":"1","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"pl. Poelaert, 1","address_line2":"1000 Bruxelles","description_web":"Costruito tra il 1866 ed il 1883 dall'architetto Poelaert, maestoso simbolo della potenza della giustizia, \u00e8 il pi\u00f9 grande edificio eretto nel XIX secolo in Occidente.\u00a0...\r\n\"Costruito tra il 1866 ed il 1883 dall'architetto Poelaert, maestoso simbolo della potenza della giustizia, \u00e8 il pi\u00f9 grande edificio eretto nel XIX secolo in Occidente.Su una superficie di 26.000 m\u00b2, 27 sale d'udienza, 245 sale...ispirazione di stile classico greco-romano. \r\nDa vedere: la sala dei Pas-Perdus sovrastata da una grandiosa cupola che si erge a 100 m dal suolo, le gallerie del primo piano, il panorama (dalla terrazza) sulla citt\u00e0 bassa e sul quartiere di Marolles\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"El Palacio de Justicia de Bruselas","address_street_name":"pl. Poelaert","address_street_number":"1","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"pl. Poelaert, 1","address_line2":"1000 Bruxelles","description_web":"Construido entre 1866 y 1883 por Poelaert, este majestuoso s\u00edmbolo de la justicia, constituy\u00f3 la mayor construcci\u00f3n del s. XIX en Occidente....\r\nVisita: \r\nSus 26.000 m de superficie, 27 salas de audiencia, 245 salas...\r\nEl estilo grecorromano cl\u00e1sico \r\nLa sala Pas-Perdus con una grandiosa c\u00fapula a 100 m de altura\r\nLas galer\u00edas de la primera planta\r\nEl mirador que hay en la plaza, con vistas a la parte baja de la ciudad \r\nEl ascensor acristalado que te llevar\u00e1 al Barrio de Les Marolles\r\nEl mirador de noche\r\n\r\nRecuerda que, por la noche, el Palacio de Justicia se ilumina ofreciendo una imagen evocadora.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Le Palais de Justice de Bruxelles","address_street_name":"Place Poelaert","address_street_number":"1","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Poelaert, 1","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Le Palais de Justice de Bruxelles","address_street_name":"Place Poelaert","address_street_number":"1","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Poelaert, 1","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[2],"translations":{"fr":["Marolles"],"nl":["Marollen"],"en":["Marolles"],"de":["Marollen"],"it":["Marolles"],"sp":["Marolles"],"pt":[null],"cn":[null]}},"zones":{"list":[19],"translations":{"fr":["Centre"],"nl":["Centrum"],"en":["Centre"],"de":["Zentrum"],"it":["Centro"],"sp":["Centro"],"pt":[null],"cn":[null]}},"neca":null,"facebook_id":null,"backoffice_id":1128,"location":{"lat":50.83701292,"lon":4.35210879},"region":"brussels","last_updated_at":"2023-02-12T03:08:14+01:00","published_at":"2013-10-19T01:14:04+02:00","import_origin":null,"external_id":null,"is_in_address_book":false,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":1487,"translations":{"fr":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"http:\/\/www.arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Arkadia","address_street_name":"Naamsestraat","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"http:\/\/www.arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Naamsestraat, 10","address_line2":"1000 Brussel","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Arkadia","address_street_name":"rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"http:\/\/www.arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"rue de Namur, 10","address_line2":"1000 Brussels","description_web":"As specialists in architectural heritage and contemporary art, we make the public (re)discover the city through guided tours and conferences in several languages. \r\n\r\nOur activities :\r\nGuided tours by foot, bus and metro - Educational projects - Exceptional interior visit- Team Building \r\n\r\nArkadia offers a wide selection of guided tours, under different forms: \r\n* For individual, we propose an annual programmation (almost only in French), which will make you take a new and attentive look on the city of Brussels. \r\n* For groups we offer a series of fun and original activities, around history, architecture, art and in exceptional interiors. \r\n* For schools and children, we offer thematic, educational and entertaining tours and stages. \r\n\r\nOur expertise : Our team is made up of 60 guides, historians and art historians. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"http:\/\/www.arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"http:\/\/www.arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":nu