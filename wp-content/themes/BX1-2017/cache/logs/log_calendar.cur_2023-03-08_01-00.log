03-25","date_end":"2023-03-26","date_next":"2023-03-25","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":84,"translations":{"fr":"Divers","nl":"Varia","en":"Various","de":"Verschiedenes","it":"Varie","sp":"Varios","pt":null,"cn":null}},"others":{}},"languages":{"spoken":["fr","nl","en","de"],"subtitles":[]},"translations":{"fr":{"name":"Foire d'objets Art nouveau & Art D\u00e9co et salon des restaurateurs du patrimoine","shortdescr":"8e \u00e9dition de la Foire d'objets Art nouveau et Art D\u00e9co dans le cadre d'un superbe complexe scolaire Art nouveau construit par Henri Jacobs.","longdescr":"La foire sera doubl\u00e9e d'un salon de restaurateurs du patrimoine et, le dimanche, d'une journ\u00e9e d'expertises assur\u00e9es par Jean-Jacques Wattel et Art Research Paris. Des associations de sensibilisation au patrimoine bruxellois seront \u00e9galement pr\u00e9sentes durant les deux jours. Environ cinquante collectionneurs et marchands pr\u00e9senteront \u00e0 la vente des objets, petits meubles, livres, affiches\u2026 Des techniques telles que le verre, l'orf\u00e8vrerie, l'\u00e9dition et la c\u00e9ramique seront particuli\u00e8rement bien repr\u00e9sent\u00e9es","performers":"Dans le cadre du Brussels Art nouveau & Art D\u00e9co Festival - BANAD","boxoffice_url":null,"website":"http:\/\/www.banad.brussels","email":"cecile8968@hotmail.com","phone_contact":"+32 478 22 92 28","phone_booking":"+32 478 22 92 28","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.545955"},"nl":{"name":"Art nouveau & art-decovoorwerpen en erfgoedrestaurateursbeurs","shortdescr":"8ste editie van de Objectenbeurs Art nouveau en Art Deco plaats. Het schouwtoneel is een prachtig schoolgebouw in art-nouveaustijl, gebouwd door Henri Jacobs.","longdescr":"De beurs wordt gecombineerd met een vakbeurs voor erfgoedrestaurateurs en op zondag met een expertisedag, georganiseerd door Jean-Jacques Wattel van Art Research (Parijs). Die twee dagen zullen er ook organisaties zijn die het Brussels erfgoed belichten. Zo'n vijftig verzamelaars en handelaars verkopen er objecten, kleine meubels, boeken, affiches enz. Vooral technieken zoals glasblazen, de edelsmeedkunst, boekbinderij en pottenbakken zullen er goed vertegenwoordigd zijn.","performers":"In het kader van het Brussels Art Nouveau & Art Deco Festival - BANAD","boxoffice_url":null,"website":"http:\/\/www.banad.brussels","email":"cecile8968@hotmail.com","phone_contact":"+32 478 22 92 28","phone_booking":"+32 478 22 92 28","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.545955"},"en":{"name":"Art Nouveau and Art Deco Antiques fair","shortdescr":"8th Art Nouveau and Art Deco Collectors' and Valuation Fair will be held in the superb surroundings of an Art Nouveau school designed by Henri Jacobs and built between 1907 and 1922.","longdescr":"The Fair will consist of around 50 collectors and dealers with ornaments, small pieces of furniture, glassware, silverware, ceramics, books and posters on display and for sale, plus restoration experts who will be demonstrating their skills, plus, on the Sunday only, free valuations by Jean-Jacques Wattel of Art Research (Paris). Also present, on both days, will be representatives of Brussels heritage associations.","performers":"As part of the Brussels Art Nouveau & Art Deco Festival - BANAD","boxoffice_url":null,"website":"http:\/\/www.banad.brussels","email":"cecile8968@hotmail.com","phone_contact":"+32 478 22 92 28","phone_booking":"+32 478 22 92 28","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.545955"},"de":{"name":"Foire d'objets Art nouveau & Art D\u00e9co et salon des restaurateurs du patrimoine","shortdescr":null,"longdescr":null,"performe