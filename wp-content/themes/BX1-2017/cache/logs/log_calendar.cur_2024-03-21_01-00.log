et des couleurs. Nous jouerons avec les \u00e9paisseurs, les espaces et les mati\u00e8res. Cette technique simple \u00e0 r\u00e9aliser permettra de mettre en pratique votre cr\u00e9ativit\u00e9 et votre sensibilit\u00e9 au cours de projets personnels et collectifs. Cet atelier est ouvert \u00e0 tous, aux d\u00e9butants comme aux initi\u00e9s.\r\nAvec Isabelle Carpentier\r\n\r\nUn dimanche par mois de 10h30 \u00e0 16H30\r\n\r\nD\u00e8s le 15\/10, 12\/11, 3\/12, 14\/1, 11\/2, 17\/3, 7\/4, 12\/5\r\n\r\nLocal Couture","performers":"Avec Isabelle Carpentier","boxoffice_url":null,"website":"https:\/\/www.wolubilis.be\/a-faire\/creation-de-mosaiques-les-dimanches-en-eclats-2023-2024-126\/","email":"secretariat.atl@woluwe1200.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.559302"},"sp":{"name":"Cr\u00e9ation de Mosa\u00efques - Les Dimanches en eclats","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.wolubilis.be\/a-faire\/creation-de-mosaiques-les-dimanches-en-eclats-2023-2024-126\/","email":"secretariat.atl@woluwe1200.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.559302"},"nl":{"name":"Cr\u00e9ation de Mosa\u00efques - Les Dimanches en eclats","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.wolubilis.be\/a-faire\/creation-de-mosaiques-les-dimanches-en-eclats-2023-2024-126\/","email":"secretariat.atl@woluwe1200.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.559302"}},"place":{"id":220532,"translations":{"de":{"name":"Centre Culturel Wolubilis","address_street_name":"Cours Paul-Henri Spaak","address_street_number":"1","address_street_box":null,"email":"secretariat.atl@woluwe1200.be","website":"http:\/\/www.wolubilis.b