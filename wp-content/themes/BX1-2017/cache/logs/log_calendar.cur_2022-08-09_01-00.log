22-05-17T09:05:05+02:00","published_at":"2013-10-19T01:13:45+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":false,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/7403b139beaa4be751c3de44de06f2c9c7bb41c2.jpg","width":1500,"height":1000,"ratio":1.5,"translations":{"fr":{"title":"Stage ADOS [+12 ans]","copyright":null},"nl":{"title":"Stage ADOS [+12 ans]","copyright":null},"en":{"title":"Stage ADOS [+12 ans]","copyright":null}}}],"dates":[{"day":"2022-08-22","doors":null,"start":"10:00:00","end":"16:00:00","is_soldout":false,"is_canceled":false},{"day":"2022-08-23","doors":null,"start":"10:00:00","end":"16:00:00","is_soldout":false,"is_canceled":false},{"day":"2022-08-24","doors":null,"start":"10:00:00","end":"16:00:00","is_soldout":false,"is_canceled":false},{"day":"2022-08-25","doors":null,"start":"10:00:00","end":"16:00:00","is_soldout":false,"is_canceled":false},{"day":"2022-08-26","doors":null,"start":"10:00:00","end":"16:00:00","is_soldout":false,"is_canceled":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-05-17T09:05:05+02:00","published_at":"2022-05-17T08:59:09+02:00","backoffice_id":253800,"import_origin":null,"sub_type":"other","show_in_agenda":true,"ranking":0.65863375600835},{"id":538147,"date_start":"2022-08-23","date_end":"2022-08-23","date_next":"2022-08-23","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{"list":[104],"translations":{"fr":["Art Nouveau, Art D\u00e9co"],"nl":["Art nouveau, art deco"],"en":["Art Nouveau, Art D\u00e9co"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Hide & Seek 2022: Guided Tour - Un quartier turc truff\u00e9 d\u2019art nouveau","shortdescr":"Hide & Seek Festival 2022: Traditional music in unexpected places in Brussels","longdescr":"La chauss\u00e9e d\u2019Haecht \u00e0 Schaerbeek est l\u2019\u00e9picentre de la communaut\u00e9 turque \u00e0 Bruxelles. Leurs restaurants sont principalement situ\u00e9s dans la partie proche du botanique. Ici, au-del\u00e0 de l\u2019avenue Rogier et pr\u00e8s de la maison communale de Schaerbeek, se trouvent principalement des petits commerces de proximit\u00e9. Mais ce quartier rec\u00e8le aussi les t\u00e9moins silencieux de la grandeur que Schaerbeek a voulu assumer \u00e0 la fin du 19e et au d\u00e9but du 20e si\u00e8cle : de larges avenues, et le premier grand h\u00f4tel particulier de Victor Horta, la Maison Autrique (1893). L\u2019architecte de l\u2019\u00e9cole Henri Jacobs et Gustave Strauven ont livr\u00e9 de beaux b\u00e2timents Art nouveau. Mais ici et l\u00e0, vous trouverez \u00e9galement des vestiges du simple village qu\u2019\u00e9tait autrefois Schaerbeek.\r\n\r\n\r\nPRATIQUE: Ces visites guid\u00e9es sont organis\u00e9es par Brukselbinnenstebuiten. Les visites guid\u00e9es sont organis\u00e9es \u00e0 l\u2019ext\u00e9rieur, se concentrent sur le quartier alentour d\u2019un lieu du programme et sont donn\u00e9es fran\u00e7ais ou en n\u00e9erlandais\/anglais. Elles d\u00e9marrent \u00e0 16h30, et se terminent \u00e0 18h. Ceci veut dire qu\u2019elles sont facilement combinables avec la premi\u00e8re s\u00e9ance du concert du m\u00eame endroit. Par facilit\u00e9 d\u2019organisation, nous vendons les places pour ces deux \u00e9v\u00e9nements s\u00e9par\u00e9ment.\r\n\r\nREMARQUE: Cette visite guid\u00e9e est organis\u00e9e juste avant le concert d\u2019Amel Sediri & Moufadhel Adhoum \u00e0 la maison Autrique. Cliquez ici pour acheter les tickets pour ce concert afin d\u2019encha\u00eener les deux activit\u00e9s:\r\n-Session 6.30pm: https:\/\/miniurl.be\/r-45f3\r\n-Session 8.30pm: https:\/\/miniurl.be\/r-45f4\r\n\r\nDans le cadre de Hide & Seek 2022","performers":"organis\u00e9es par Brukselbinnenstebuiten","boxoffice_url":null,"website":"http:\/\/www.muziekpublique.be","email":"info@muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":"+32 2 217 26 00","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/538147.html"},"nl":{"name":"Hide & Seek 2022: Guided Tour - Een Turkse buurt vol art nouveau","shortdescr":"Hide & Seek Festival 2022: Traditional music in unexpected places in Brussels","longdescr":"De Haachtsesteenweg in Schaarbeek vormt het epicentrum van de Turkse gemeenschap in Brussel. Hun eethuizen bevinden zich vooral in het gedeelte richting Kruidtuin. Hier, voorbij de Rogierlaan en dichter naar het Schaarbeekse gemeentehuis toe, zijn vooral kleinere buurtwinkels gevestigd. In deze wijk bevinden zich ook de stille getuigen van de grandeur die Schaarbeek zich eind 19de en begin 20-ste eeuw wou aanmeten: brede lanen, en het eerste grote herenhuis van Victor, Maison Autrique (1893). Schoolarchitect Henri Jacobs en Gustave Strauven leverden prachtige panden in art nouveau af. Hier en daar tref je echter nog overblijfselen aan van het eenvoudige dorp dat Schaarbeek eertijds was.\r\n\r\nPRAKTISCH: De rondleidingen worden buiten georganiseerd en richten zich op de buurt rond een programmalocatie. Je kan de rondleiding in het Frans of Nederlands en Engels volgen. Ze beginnen om 16.30 uur en eindigen om 18.00 uur. Zo kunnen ze dus gemakkelijk gecombineerd worden met de eerste sessie van het concert op dezelfde plaats. Om organisatorische redenen verkopen wij de tickets voor deze twee evenementen afzonderlijk.\r\n\r\nOPMERKING: Deze rondleiding wordt vlak voor het concert van Amel Sediri & Moufadhel Adhoum in het Autriquehuis georganiseerd. Klik hier om tickets voor dit concert te kopen en zo de twee activiteiten te combineren:\r\n-Session 6.30pm: https:\/\/miniurl.be\/r-45f3\r\n-Session 8.30pm: https:\/\/miniurl.be\/r-45f4\r\n\r\nIn het kader van Hide & Seek 2022","performers":"organis\u00e9es par Brukselbinnenstebuiten","boxoffice_url":null,"website":"http:\/\/www.muziekpublique.be","email":"info@muziekpublique.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/538147.html"},"en":{"name":"Hide & Seek 2022: Guided Tour - A Turkish quarter full of art nouveau","shortdescr":"Hide & Seek Festival 2022: Traditional music in unexpected places in Brussels","longdescr":"This guided tour is organized right before a concert in the Autrique House. \r\nIf you want to combine the tour + the concert, you can buy the tickets right here:\r\n-Session 6.30pm: https:\/\/miniurl.be\/r-45f3\r\n-Session 8.30pm: https:\/\/miniurl.be\/r-45f4\r\n\r\nAs part of Hide & Seek 2022","performers":"organized by Brukselbinnenstebuiten","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/538147.html"},"de":{"name":"Visite Guid\u00e9e: Un quartier turc truff\u00e9 d\u2019art nouveau","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/538147.html"},"it":{"name":"Visite Guid\u00e9e: Un quartier turc truff\u00e9 d\u2019art nouveau","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/538147.html"},"sp":{"name":"Visite Guid\u00e9e: Un quartier turc truff\u00e9 d\u2019art nouveau","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/538147.html"},"pt":{"name":"Visite Guid\u00e9e: Un quartier turc truff\u00e9 d\u2019art nouveau","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/538147.html"},"cn":{"name":"Visite Guid\u00e9e: Un quartier turc truff\u00e9 d\u2019art nouveau","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/538147.html"}},"place":{"id":241931,"translations":{"fr":{"name":"Maison Autrique","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"http:\/\/www.autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":"La Maison Autrique (Horta 1893) est un jalon important de l'Art Nouveau. Elle a fait l'objet d'une restauration exemplaire. Ouverte au public, elle permet \u00e0 chacun de mieux saisir l'int\u00e9r\u00eat historique et esth\u00e9tique des vieilles demeures bruxelloises. Lors de votre visite, vous d\u00e9couvrirez des espaces d'exposition, une petite librairie th\u00e9matique et une sc\u00e9nographie originale sign\u00e9e Beno\u00eet Peeters et Fran\u00e7ois Schuiten. La maison accueille des petits concerts, des expositions temporaires et des ateliers pour enfants. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Autrique Huis","address_street_name":"Haachtsesteenweg","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"http:\/\/www.autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaarbeek","address_line1":"Haachtsesteenweg, 266","address_line2":"1030 Schaarbeek","description_web":"Het Autrique Huis is het eerste markante gebouw van Victor Horta. Het werd in 1893 gebouwd en is nog steeds een voornaam element in het architectonisch patrimonium van Brussel. Het huis werd op uitmuntende wijze gerestaureerd en is open voor het publiek. Het huis is een belangrijke maatstaf van de Art Nouveau : men vindt er reeds elementen terug die de architect en zijn zoektocht kenmerken. De manier waarop de ruimte ingedeeld is, staat garant voor verrassingen : Fran\u00e7ois Schuiten en Beno\u00eet Peeters hebben een originele enscenering opgezet, waarbij het huis van de kelder tot de zolder ingericht werd. Zodoende wordt het huis een soort van eerbetoon aan de Brusselse priv\u00e9-architectuur, terwijl het ook de verbeelding aanspreekt. Het huis organiseert intieme concerten, tentoonstellingen en workshops voor kinderen.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Autrique House","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"http:\/\/www.autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":"Maison Autrique is the very first striking building Victor Horta designed. It was built in 1893 and it's a major part of Brussels' architectural patrimonium. It underwent an exemplary restoration and is now open to the public. This house is an important Art Nouveau touchstone: we can already see elements that form a part of the continual explorations of the architect. It's interior division is full of surprises: Fran\u00e7ois Schuiten and Beno\u00eet Peeters have staged an original scenography, from the cellar to the attic. The house has thus become a sort of tribute to Brussels' private architecture, while at the same time tickling the imagination. The house hosts intimate concerts, temporary exhibitions and workshops for children.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Maison Autrique","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"http:\/\/www.autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":"Als erstes bedeutendes Bauwerk des Jugendstil-Architekten Victor Horta bildet das Maison Autrique ein wichtiges Element des Br\u00fcsseler Architekturerbes.\r\n\r\nEin Meilenstein der Br\u00fcsseler Architekturgeschichte: Denn das Geb\u00e4ude aus dem Jahr 1893 stellt eine wesentliche Etappe in der Entwicklung der gr\u00f6\u00dften belgischen Architekten dar. Durch das Geb\u00e4ude f\u00fchrt eine Szenographie, die von den beiden belgischen Comic-Gr\u00f6\u00dfen Fran\u00e7ois Schuiten und Beno\u00eet Peeter konzipiert wurde. Zugrundeliegende Idee war es, aus diesem Geb\u00e4ude eine Art \"Haus der H\u00e4user\" zu machen, eine Huldigung an die Br\u00fcsseler Architektur und zugleich ein Tor zum Imagin\u00e4ren.\r\n\r\nDas Maison Autrique bietet regelm\u00e4\u00dfig Ausstellungen rund um verschiedene Themen: das 19. Jahrhundert in Br\u00fcssel, Comic oder Jugenstil. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Maison Autrique","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"http:\/\/www.autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Casa Autrique","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"http:\/\/www.autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":"La casa Autrique, obra fundacional de Victor Horta, ha sido completamente renovada, con una puesta en escena imaginaria realizada por los guionistas y dibujantes Schuiten y Peeters. Al entrar, te sumerges en una atm\u00f3sfera \u00fanica.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Maison Autrique","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"http:\/\/www.autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Maison Autrique","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"http:\/\/www.autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":[],"zones":{"list":[20],"translations":{"fr":["Nord"],"nl":["Noord"],"en":["North"]}},"neca":null,"facebook_id":null,"backoffice_id":4383,"location":{"lat":50.86325398,"lon":4.37313664},"region":"brussels","last_updated_at":"2022-07-28T17:35:06+02:00","published_at":"2013-10-19T01:17:19+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":238099,"translations":{"fr":{"name":"Muziekpublique","address_street_name":"Galerie de la Porte de Namur","address_street_number":"3","address_street_box":null,"email":"info@muziekpublique.be","website":"http:\/\/www.muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":"+32 2 217 26 00","address_zip":"1050","address_city":"Ixelles","address_line1":"Galerie de la Porte de Namur, 3","address_line2":"1050 Ixelles","description_web":"Muziekpublique est le centre des musiques traditionnelles du monde de Bruxelles. Etablie dans le Th\u00e9\u00e2tre Moli\u00e8re au c\u0153ur du quartier africain, l\u2019asbl organise plus de 100 concerts par an et deux festivals (Hide & Seek Festival etc.). Par ailleurs Muziekpublique propose aussi 50 cours de musique et de danse du monde, comptant plus de 600 \u00e9l\u00e8ves. Ensuite, l\u2019asbl d\u00e9veloppe certains artistes et projets via son label, qui est aussi une agence de booking et de management. La musique traditionnelle a donc trouv\u00e9 un endroit id\u00e9al o\u00f9 se d\u00e9velopper et les artistes y constituent un r\u00e9seau vivant et dynamique cr\u00e9ant des liens de qualit\u00e9 avec le public. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Muziekpublique","address_street_name":"Galerij van de Naamsepoort","address_street_number":"3","address_street_box":null,"email":"info@muziekpublique.be","website":"http:\/\/www.muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":"+32 2 217 26 00","address_zip":"1050","address_city":"Elsene","address_line1":"Galerij van de Naamsepoort, 3","address_line2":"1050 Elsene","description_web":"Muziekpublique verspreidt en promoot muziek- en danstradities via een ambitieus programma van concerten, cursussen en projecten. Een jaarrond concertprogramma met Belgische en internationale artiesten vormt de kern van de activiteiten van de organisatie. Van contemplatieve tot feestelijke concerten vinden het hele jaar door plaats in het prachtige Moli\u00e8re Theater, aan de Naamsepoort, maar ook op verschillende plaatsen de hoofdstad.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Muziekpublique","address_street_name":"Galerie de la Porte de Namur","address_street_number":"3","address_street_box":null,"email":"info@muziekpublique.be","website":"http:\/\/www.muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":"+32 2 217 26 00","address_zip":"1050","address_city":"Ixelles","address_line1":"Galerie de la Porte de Namur, 3","address_line2":"1050 Ixelles","description_web":"Muziekpublique, keeps music and dance traditions alive and kicking in Brussels through an ambitious programme of concerts, courses, and projects. A year-round concert programme, featuring Belgian and international artists, forms the core of the foundation\u2019s activities. From the contemplative to the madly festive concerts take place indoors,  in the small Moli\u00e8re Theatre, in the arcade at the Porte de Namur and outdoors, around the city and throughout the year.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Muziekpublique","address_street_name":"Galerie de la Porte de Namur","address_street_number":"3","address_street_box":null,"email":"info@muziekpublique.be","website":"http:\/\/www.muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":"+32 2 217 26 00","address_zip":"1050","address_city":"Ixelles","address_line1":"Galerie de la Porte de Namur, 3","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it