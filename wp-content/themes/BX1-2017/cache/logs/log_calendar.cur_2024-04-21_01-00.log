"is_soldout":false,"last_updated_at":"2024-04-20T02:01:45+02:00","published_at":"2023-06-01T10:52:32+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":278356,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"theatre","ranking":0.5453180111445977,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":49,"translations":{"de":"Theater","pt":null,"en":"Theatre","it":"Teatro","cn":null,"fr":"Th\u00e9\u00e2tre","sp":"Teatro","nl":"Theater"}},"others":{"list":[50],"translations":{"de":["Theater"],"pt":[null],"en":["Theatre"],"it":["Teatro"],"cn":[null],"fr":["Th\u00e9\u00e2tre"],"sp":["Teatro"],"nl":["Theater"]}}},"translations":{"de":{"name":"Kontainer Kats","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatrelepublic.be","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.558356"},"pt":{"name":"Kontainer Kats","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatrelepublic.be","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.558356"},"en":{"name":"Kontainer Kats","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatrelepublic.be","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.558356"},"it":{"name":"Kontainer Kats","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatrelepublic.be","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.558356"},"cn":{"name":"Kontainer Kats","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatrelepublic.be","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.558356"},"fr":{"name":"Kontainer Kats","shortdescr":null,"longdescr":"Les Kat\u2019s c\u2019est une bande de filles hors-la-loi, une bande de bras cass\u00e9s un tantinet foireuses, un brin immorales, qui braquent une banque. Cinq femmes au bout du rouleau qui font un casse. Parce que faut prendre le bl\u00e9 l\u00e0 o\u00f9 il est : dans les banques. Mais elles se retrouvent dans une planque avec les diam\u2019s et\u2026 une otage enceinte. Pour se sortir de ce gu\u00eapier faudra choisir, le chacun pour soi ou l\u2019entraide. Reste \u00e0 voir. \r\nL\u2019argent ne faisant pas le bonheur des pauvres, elles manquent d\u2019exp\u00e9rience et n\u2019en touchent pas une en mati\u00e8re de hold-up. Faudra faire preuve de pas mal de sang-froid et d\u2019une solide dose d\u2019humour et d\u2019audace, pour se tirer d\u2019affaire.\r\n\r\nUn huis clos fa\u00e7on \u00ab Reservoir dogs \u00bb de Tarantino, \u00e7a vous parle ?\r\n\r\nRemake d\u2019une version pr\u00e9sent\u00e9e au Public en 1998, revoici les Kat\u2019s. Une nouvelle bande de com\u00e9diennes se r\u00e9approprie le texte de Val\u00e9rie Lema\u00eetre et se lance dans l\u2019aventure d\u2019un braquage\u2026 \u00e0 la sauce belge. \r\n\r\nElles sont sans foi ni loi, craquantes, dr\u00f4les et punchies. Retrouvez avec bonheur les kat\u2019s dans une distribution au poil, pour tous les publics.\r\n__________\r\n\r\nDe Val\u00e9rie Lema\u00eetre \/ Mise en sc\u00e8ne : Val\u00e9rie Lema\u00eetre \/ Avec : Morgiane El Boubsi, Jeanne Kacenelenbogen, Sh\u00e9rine Seyad, Chlo\u00e9 Struvay\r\n__________\r\n\r\nUNE PRODUCTION DU TH\u00c9\u00c2TRE LE PUBLIC. AVEC LE SOUTIEN DU TAX SHELTER DE L\u2019\u00c9TAT F\u00c9D\u00c9RAL BELGE VIA BESIDE ET DE LA COMMUNAUT\u00c9 FRAN\u00c7AISE.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatrelepublic.be","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.558356"},"sp":{"name":"Kontainer Kats","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatrelepublic.be","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.558356"},"nl":{"name":"Kontainer Kats","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatrelepublic.be","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.558356"}},"place":{"id":224476,"translations":{"de":{"name":"Th\u00e9\u00e2tre Le Public","address_street_name":"Rue Braemt","address_street_number":"64 70","address_street_box":null,"email":"contact@theatrelepublic.be","website":"http:\/\/www.theatrelepublic.be","phone_contact":"+32 2 724 24 44","phone_booking":"+32 2 724 24 44","address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Braemt, 64 70","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Th\u00e9\u00e2tre Le Public","address_street_name":"Rue Braemt","address_street_number":"64 70","address_street_box":null,"email":"contact@theatrelepublic.be","website":"http:\/\/www.theatrelepublic.be","phone_contact":"+32 2 724 24 44","phone_booking":"+32 2 724 24 44","address_zip":"1210","address_city":"Saint-Josse-Ten-Noode"