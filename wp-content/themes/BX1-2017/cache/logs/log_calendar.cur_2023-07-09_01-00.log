7"}},"value":1.25}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-06-09T16:05:07+02:00","published_at":"2023-06-09T15:20:24+02:00","backoffice_id":279186,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":1},{"id":560513,"date_start":"2023-07-15","date_end":"2023-07-16","date_next":"2023-07-15","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":90,"translations":{"fr":"Animations","nl":"Animaties","en":"Animations","de":"Animationen","it":"Animazioni","sp":"Animaciones","pt":null,"cn":null}},"others":{}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Weekend jeux de soci\u00e9t\u00e9 SUMMER XL","shortdescr":"Le 3e week-end de juillet, le MedexMuseum se transforme en une ar\u00e8ne de jeux de soci\u00e9t\u00e9s con\u00e7us et pr\u00e9sent\u00e9s par des acteurs du jeu bruxellois.","longdescr":"Samedi 15.07 \u00e0 18:30 \u00b7 soir\u00e9e cobaye & prototypes \r\nVenez tester des jeux \u00e0 peine sortis du chapeau de leurs cr\u00e9ateurs et leur donner des retours sur cette exp\u00e9rience de jeu en avant-premi\u00e8re.\r\n\r\nDimanche 16.07 de 13:00 \u00e0 19:00 \u00b7 pr\u00e9sentation des jeux par leurs cr\u00e9ateurs et \u00e9diteurs. Des jeux pour toute la famille, \u00e0 jouer \u00e0 plusieurs.\r\n\r\nAvec : Joseph La Marca \u00b7 Schmeta Games \u00b7 Le Tour d'Afrique \u00b7 Patrick Beukeleirs \u00b7 inPatience\r\n\r\n\u00b7\u2206\u00b7\u2206\u00b7\u2206\u00b7\r\n\r\nen partenariat avec Tanju Goban du centre bruxellois d'action interculturelle (CBAI).\r\n\r\nDans le cadre de la Kermesse des Jeux du Monde  organis\u00e9e par le MedexMuseum, avec le soutien de la commune d'Ixelles (SUMMER XL)\r\n\r\nPlus d'infos sur la page de l'\u00e9v\u00e8nement : https:\/\/fb.me\/e\/2A9ACiwwa \r\n\r\nParticipation gratuite\r\nRue Longue-vie 34A (1050) Ixelles\r\nArr\u00eat de m\u00e9tro Porte de Namur (ligne 2 et 6)","performers":null,"boxoffice_url":null,"website":"https:\/\/fb.me\/e\/2A9ACiwwa","email":"medexmuseum@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.560513"},"nl":{"name":"Weekend jeux de soci\u00e9t\u00e9 SUMMER XL","shortdescr":"Tijdens het 3de weekend van juli wordt het MedexMuseum omgetoverd tot een arena voor bordspellen ontworpen en gepresenteerd door spelers uit de Brusselse spelscene.","longdescr":"Zaterdag 15.07 om 18:30 - proefkonijn & prototypes-avond \r\nKom games uitproberen die net uit de hoed van hun makers komen en geef ze je feedback op deze preview-spelervaring.\r\n\r\nZondag 16.07 van 13.00 tot 19.00 uur - presentatie van de spellen door hun makers en uitgevers. Games voor het hele gezin om samen te spelen.\r\n\r\nMet : Joseph La Marca - Schmeta Games - Le Tour d'Afrique - Patrick Beukeleirs - inPatience\r\n\r\n-\u2206-\u2206-\u2206-\r\n\r\nIn samenwerking met Tanju Goban van het Centre bruxellois d'action interculturelle (CBAI).\r\n\r\nIn het kader van de Kermesse des Jeux du Monde georganiseerd door het MedexMuseum, met de steun van de gemeente Elsene (ZOMER XL).\r\n\r\nMeer info op de evenementpagina: https:\/\/fb.me\/e\/2A9ACiwwa \r\n\r\nDeelname is gratis\r\nRue Longuevie 34A (1050) Elsene\r\nMetrohalte Porte de Namur (lijnen 2 en 6)","performers":null,"boxoffice_url":null,"website":"https:\/\/fb.me\/e\/2A9ACiwwa","email":"medexmuseum@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.560513"},"en":{"name":"Weekend jeux de soci\u00e9t\u00e9 SUMMER XL","shortdescr":"The 3rd weekend of July, MedexMuseum will turn into a board-game arena designed and presented by Brussels' games scene.","longdescr":"Saturday 15.07 at 18:30 - guinea pig & prototypes evening \r\nCome and try out games that have just come out of their creators' hats and give them your feedback on this preview gaming experience.\r\n\r\nSunday 16.07 from 13:00 to 19:00 - presentation of the games by their creators and publishers. Games for all the family to play together.\r\n\r\nWith : Joseph La Marca - Schmeta Games - Le Tour d'Afrique - Patrick Beukeleirs - inPatience\r\n\r\n-\u2206-\u2206-\u2206-\r\n\r\nIn partnership with Tanju Goban from the Centre bruxellois d'action interculturelle (CBAI).\r\n\r\nAs part of the Kermesse des Jeux du Monde organised by the MedexMuseum, with the support of the commune of Ixelles (SUMMER XL).\r\n\r\nMore info on the event page: https:\/\/fb.me\/e\/2A9ACiwwa \r\n\r\nParticipation is free of charge\r\nRue Longue-vie 34A (1050) Ixelles\r\nPorte de Namur metro stop (lines 2 and 6)","performers":null,"boxoffice_url":null,"website":"https:\/\/fb.me\/e\/2A9ACiwwa","email":"medexmuseum@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.560513"},"de":{"name":"Weekend jeux de soci\u00e9t\u00e9 SUMMER XL","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/fb.me\/e\/2A9ACiwwa","email":"medexmuseum@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.560513"},"it":{"name":"Weekend jeux de soci\u00e9t\u00e9 SUMMER XL","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/fb.me\/e\/2A9ACiwwa","email":"medexmuseum@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.560513"},"sp":{"name":"Weekend jeux de soci\u00e9t\u00e9 SUMMER XL","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/fb.me\/e\/2A9ACiwwa","email":"medexmuseum@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.560513"},"pt":{"name":"Weekend jeux de soci\u00e9t\u00e9 SUMMER XL","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/fb.me\/e\/2A9ACiwwa","email":"medexmuseum@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.560513"},"cn":{"name":"Weekend jeux de soci\u00e9t\u00e9 SUMMER XL","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/fb.me\/e\/2A9ACiwwa","email":"medexmuseum@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.560513"}},"place":{"id":265418,"translations":{"fr":{"name":"Medex (Mus\u00e9e \u00e9ph\u00e9m\u00e8re de l'exil)","address_street_name":"Rue Longue Vie","address_street_number":"34A","address_street_box":null,"email":"medexmuseum@gmail.com","website":"http:\/\/www.medexmuseum.com","phone_contact":"+32 488 50 60 42","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Longue Vie, 34A","address_line2":"1050 Ixelles","description_web":"Un mus\u00e9e qui n\u2019en est pas un, un mus\u00e9e valise qui porte une vision de la culture dans diff\u00e9rents endroits le temps d\u2019une exposition, d\u2019une performance ou d\u2019un \u00e9v\u00e9nement. \r\n\r\nLe Medex est un mus\u00e9e itin\u00e9rant, en d\u00e9placement, fait pour porter l'attention sur la th\u00e9matique de la migration et ses enjeux. Il est bas\u00e9 actuellement dans un ancien CARWASH \u00e0 Ixelles dans le quartier Matong\u00e9.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Medex (Mus\u00e9e \u00e9ph\u00e9m\u00e8re de l'exil)","address_street_name":"Lang-Levenst