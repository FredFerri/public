:"2022-10-16","date_end":"2022-10-16","date_next":"2022-10-16","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":74,"translations":{"fr":"Sport","nl":"Sport","en":"Sport","de":"Sport"}},"others":{"list":[159,164],"translations":{"fr":["Activit\u00e9 sportive","Fitness, gymnastique, danse et sports de combats"],"nl":["Sportieve activiteit","Fitness, gymnastiek, dans en vechtsport"],"en":["Sporting activity","Fitness, gymnastics, dance and combat sports"],"de":["Sportliche Aktivit\u00e4t","Fitness, Gymnastik, Tanz & Kampfsportarten"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Prime Sport Coaching","shortdescr":"D\u00e9couverte et initiation du Personal training!","longdescr":"Lucas et Gauthier vous proposent des s\u00e9ances de coaching sportif en Personal training avec un programme fait sur mesure (1 \u00e0 4 personnes) et en Group Training pour profiter de l\u2019effet de meute (5 \u00e0 8 personnes).","performers":"Prime Sport Coaching","boxoffice_url":null,"website":"http:\/\/www.drohme.be","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.543662"},"nl":{"name":"Prime Sport Coaching","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.543662"},"en":{"name":"Prime Sport Coaching","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.543662"},"de":{"name":"Prime Sport Coaching","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.543662"},"it":{"name":"Prime Sport Coaching","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.543662"},"sp":{"name":"Prime Sport Coaching","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.543662"},"pt":{"name":"Prime Sport Coaching","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.543662"},"cn":{"name":"Prime Sport Coaching","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.543662"}},"place":{"id":266534,"translations":{"fr":{"name":"Hippodrome de Boitsfort","address_street_name":"Chauss\u00e9e de La Hulpe","address_street_number":"53 55","address_street_box":null,"email":null,"website":"http:\/\/www.drohme.be","phone_contact":null,"phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Chauss\u00e9e de La Hulpe, 53 55","address_line2":"1180 Uccle","description_web":"L'hippodrome de Boitsfort est un parc de loisirs pour tous, au c\u0153ur de la nature et aux portes de la for\u00eat de Soignes. Au programme\u00a0: activit\u00e9s sportives, de d\u00e9tente, culturelles, p\u00e9dagogiques\u00a0; et d\u00e9couverte de la nature et du patrimoine architectural du site. Son concept, unique en Europe, est familial, interg\u00e9n\u00e9rationnel et tourn\u00e9 vers la nature. Apr\u00e8s avoir connu l\u2019\u00e2ge d\u2019or aux XIXe et XXe si\u00e8cles puis le d\u00e9clin \u00e0 partir des ann\u00e9es 1980, l\u2019Hippodrome rena\u00eet.\r\n\r\nBalade guid\u00e9e, accrobranche, golf, frisbee, spectacle \u00e0 la Petite Tribune... Reprenez des forces au Club House, avec une vue imprenable sur le green, ou au restaurant Le Pesage, dans un d\u00e9cor imagin\u00e9 par l\u2019architecte d\u2019int\u00e9rieur Lionel Jadot. Pour les enfants, une plaine de jeux \u00e9co-construite de 9400 m\u00b2\u00a0: labyrinthe, balan\u00e7oire g\u00e9ante, trampoline, tour d\u2019observation\u2026 Ainsi qu\u2019un point de vue unique \u00e0 360\u00b0 sur la for\u00eat de Soignes et sur Bruxelles.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Hippodroom van Bosvoorde","address_street_name":"Terhulpensesteenweg","address_street_number":"53 55","address_street_box":null,"email":null,"website":"http:\/\/www.drohme.be","phone_contact":null,"phone_booking":null,"address_zip":"1180","address_city":"Ukkel","address_line1":"Terhulpensesteenweg, 53 55","address_line2":"1180 Ukkel","description_web":"De vroegere renbaan van Bosvoorde ligt op het grondgebied van de gemeente Ukkel. Het is een recreatiepark midden in de natuur en vormt de poort van het Zoni\u00ebnwoud. Je kan er bijzonder veel doen. Er is namelijk plaats voor sport, ontspanning, cultuur en educatie. Ga er zeker eens op ontdekking in de natuur. Maar neem ook een kijkje in het gebouw. In de 19e en 20e eeuw trok de renbaan veel volk. Maar in de jaren tachtig kwam het verval. Nu is de Hippodroom weer springlevend, ook al zijn er geen paardenrennen meer.\r\n\r\nJe kan er deelnemen aan rondleidingen, een partijtje golf spelen, boomklimmen of naar een van de vele voorstellingen of feesten. In het Club House kom je weer op krachten en geniet je van het zicht op de green. Er is ook de mooie Pesage ontworpen door binnenhuisarchitect Lionel Jadot. Voor de kinderen is er een ecologische speeltuin van 9400 m\u00b2 met labyrint, reuzenschommel, trampoline, uitkijktoren... en een uniek 360\u00b0 uitzicht op het Zoni\u00ebnwoud en Brussel.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Boitsfort Hippodrome","address_street_name":"Chauss\u00e9e de La Hulpe","address_street_number":"53 55","address_street_box":null,"email":null,"website":"http:\/\/www.drohme.be","phone_contact":null,"phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Chauss\u00e9e de La Hulpe, 53 55","address_line2":"1180 Uccle","description_web":"Boitsfort hippodrome is today a leisure park that\u2019s open to all, in the heart of nature by the Sonian Forest. It offers sporting, cultural, relaxation and pedagogical activities, along with opportunities to discover nature and the site\u2019s architectural heritage. Its concept, unique in Europe, is family-oriented, intergenerational and focused on nature. After a golden age in the 19th and 20th centuries and then a decline in the 1980s, the Hippodrome has been reborn.\r\n\r\nGuided walks, tree climbing, golf, frisbee, shows at the Petite Tribune... Recharge your batteries at the Club House, with a breathtaking view of the green, or at the Jardin du Pesage, in a setting designed by interior architect Lionel Jadot. For children, there's a 9,400m\u00b2 ecologically-built playground with a labyrinth, a giant swing, a trampoline, an observation tower... and a unique 360\u00b0 view of the Sonian Forest and Brussels.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Hippodrome de Boitsfort","address_street_name":"Chauss\u00e9e de La Hulpe","address_street_number":"53 55","address_street_box":null,"email":null,"website":"http:\/\/www.drohme.be","phone_contact":null,"phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Chauss\u00e9e de La Hulpe, 53 55","address_line2":"1180 Uccle","description_web":"DROHME wie droom (Niederl\u00e4ndisch f\u00fcr Traum), aber auch wie drome, \u201edie Bewegung\u201c im Griechischen. Bei dem DROHME Park handelt es sich um die ehemalige Pferderennbahn von Boitsfort, die zu einem Naherholungsgebiet mit Freizeitangebot umgestaltet wurde \u2013 mitten in der Natur, am Rande des Waldes For\u00eat de Soignes. Auf dem Programm stehen sportliche, entspannende, kulturelle und p\u00e4dagogische Aktivit\u00e4ten sowie die Entdeckung der Natur und des architektonischen Erbes der Anlage. Das Konzept, das in Europa einzigartig ist, ist familienfreundlich, generationen\u00fcbergreifend und naturorientiert. Nachdem das Hippodrom im 19. und 20. Jahrhundert sein goldenes Zeitalter erlebt hatte und ab den 1980er-Jahren im Niedergang begriffen war, kann es nun wieder auf eine rosige Zukunft blicken!\r\n\r\nGef\u00fchrte Spazierg\u00e4nge, Hochseilgarten, Golf, Frisbee, Darbietungen in der Petite Tribune... Leckereien im Club House mit einem Blick ins Gr\u00fcne oder im Jardin du Pesage, der von dem Innenarchitekten Lionel Jadot gestaltet wurde. F\u00fcr Kinder gibt es einen 9400 m\u00b2 gro\u00dfen Natur- und Abenteuerspielplatz: Labyrinth, Riesenschaukel, Trampolin, Aussichtsturm... mit 360\u00b0-Ausblick auf den For\u00eat de Soignes und Br\u00fcssel.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Hippodrome de Boitsfort","address_street_name":"Chauss\u00e9e de La Hulpe","address_street_number":"53 55","address_street_box":null,"email":null,"website":"http:\/\/www.drohme.be","phone_contact":null,"phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Chauss\u00e9e de La Hulpe, 53 55","address_line2":"1180 Uccle","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Hippodrome de Boitsfort","address_street_name":"Chauss\u00e9e de La Hulpe","address_street_number":"53 55","address_street_box":null,"email":null,"website":"http:\/\/www.drohme.be","phone_contact":null,"phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Chauss\u00e9e de La Hulpe, 53 55","address_line2":"1180 Uccle","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Hippodrome de Boitsfort","address_street_name":"Chauss\u00e9e de La Hulpe","address_street_number":"53 55","address_street_box":null,"email":null,"website":"http:\/\/www.drohme.be","phone_contact":null,"phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Chauss\u00e9e de La Hulpe, 53 55","address_line2":"1180 Uccle","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Hippodrome de Boitsfort","address_street_name":"Chauss\u00e9e de La Hulpe","address_street_number":"53 55","address_street_box":null,"email":null,"website":"http:\/\/www.drohme.be","phone_contact":null,"phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Chauss\u00e9e de La Hulpe, 53 55","address_line2":"1180 Uccle","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":[],"zones":{"list":[21],"translations":{"fr":["Sud"],"nl":["Zuid"],"en":["South"]}},"neca":null,"facebook_id":null,"backoffice_id":26534,"location":{"lat":50.79681453,"lon":4.39647355},"region":"brussels","last_updated_at":"2022-10-11T06:35:06+02:00","published_at":"2016-10-05T10:02:02+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":false,"resto_ranking":0},"organizer":{"id":266534,"translations":{"fr":{"name":"Hippodrome de Boitsfort","address_street_name":"Chauss\u00e9e de La Hulpe","address_street_number":"53 55","address_street_box":null,"email":null,"website":"