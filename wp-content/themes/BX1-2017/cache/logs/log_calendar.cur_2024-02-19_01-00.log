null,"boxoffice_url":null,"website":"http:\/\/www.wolubilis.be","email":"secretariat.atl@woluwe1200.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.559319"},"it":{"name":"Couture les mercredis","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wolubilis.be","email":"secretariat.atl@woluwe1200.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.559319"},"cn":{"name":"Couture les mercredis","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wolubilis.be","email":"secretariat.atl@woluwe1200.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.559319"},"fr":{"name":"Couture les mercredis","shortdescr":"Couture les mercredis - 2023\/2024 - 110\r\nAtelier Couture | Rue Lola Bobesco 11, 2e \u00e9tage - 1200 Woluwe Saint Lambert | Voir la carte","longdescr":"Cet atelier hebdomadaire vous invitera \u00e0 explorer les techniques de confection, d'assemblage ou de retouche que ce soit dans le domaine de l'habillement, de l'accessoire ou encore de l'ameublement. Et une fois que vous serez en confiance, pourquoi pas aborder la couture de mani\u00e8re cr\u00e9ative seul.e ou en groupe ?Vous serez amener \u00e0 apprendre \u00e0 utiliser ou perfectionner l'utilisation d'une machine \u00e0 coudre, \u00e0 lire et \u00e0 modifier des patrons, \u00e0 choisir le tissu ad\u00e9quat ainsi qu'\u00e0 ma\u00eetriser de nombreuses finitions telles que la pose d'un biais, de passepoils, de parmenture, de doublure, de fermeture \u00e0 glissi\u00e8re, etc. Tout au long de l'ann\u00e9e Joan sera \u00e0 votre \u00e9coute et vous aideront \u00e0 mettre en forme vos projets dans les r\u00e8gles de la couture pour d\u00e9butants ou initi\u00e9s.\r\n\r\nMat\u00e9riel \u00e0 apporter :Papier patron transparent (V\u00e9ritas), une latte ou une \u00e9querre, une pochette d'aiguilles \u00e0 coudre, une bo\u00eete d'\u00e9pingles, une bobine de fil \u00e0 b\u00e2tir, deux craies tailleur (une blanche et une de couleur), une paire de ciseaux pour papier, une paire de ciseaux pour tissu, un m\u00e8tre ruban, du papier collant, un bic de couleur.\r\n\r\nAvec l\u2019aimable participation de Bernina\r\n\r\nPar Joan De Rijck\r\n\r\nD\u00e8s le 20 septembre, les mercredis de 09:30 \u00e0 12:00 jusqu\u2019au 5\/6","performers":"Par Joan De Rijck","boxoffice_url":null,"website":"http:\/\/www.wolubilis.be","email":"secretariat.atl@woluwe1200.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.559319"},"sp":{"name":"Couture les mercredis","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wolubilis.be","email":"secretariat.atl@woluwe1200.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.559319"},"nl":{"name":"Couture les mercredis","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wolubilis.be","email":"secretariat.atl@woluwe1200.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.559319"}},"place":{"id":220532,"translations":{"de":{"name":"Centre Culturel Wolubilis","address_street_name":"Cours Paul-Henri Spaak","address_street_number":"1","address_street_box":null,"email":"secretariat.atl@woluwe1200.be","website":"http:\/\/www.wolubilis.be","phone_contact":"+32 2 761 60 29","phone_booking":"+32 2 761 60 30","address_zip":"1200","address_city":"Woluwe-Saint-Lambert","address_line1":"Cours Paul-Henri Spaak, 1","address_line2":"1200 Woluwe-Saint-Lambert","description_web":null,"description_print":null,"boo