s"],"pt":[null,null,null],"cn":[null,null,null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2023-03-19T02:37:16+01:00","published_at":"2022-07-13T10:34:17+02:00","backoffice_id":258345,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.14189834119704},{"id":546818,"date_start":"2022-12-10","date_end":"2023-07-07","date_next":"2023-07-07","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater","it":"Teatro","sp":"Teatro","pt":null,"cn":null}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"],"de":["Theater"],"it":["Teatro"],"sp":["Teatro"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"RACONTE MOI TON R\u00caVE - Spectacle pour enfants (\u00e0 partir de 5 ans) et leurs parents","shortdescr":"La magie de d\u00e9cembre, c'est surtout le 10 !\r\nUn moment ludique, de partage et de cr\u00e9ativit\u00e9 !\r\nUn spectacle familial. Des contes que nous improvisons \u00e0 partir de vos dessins","longdescr":"\" IMPRO CONTES \"\r\n\r\nLes com\u00e9dien.ne.s invitent vos enfants \u00e0 partager\/dessiner leurs r\u00eaves, ceux-ci serviront par la suite de base aux histoires improvis\u00e9es.\r\nAdress\u00e9 aux enfants de 5 \u00e0 11 ans, ce spectacle am\u00e8ne les enfants au travers d'univers o\u00f9 tout est possible et o\u00f9 toutes les histoires seront racont\u00e9es et jou\u00e9es sur base de leurs id\u00e9es.\r\nVenez les d\u00e9couvrir!\r\n\r\nCe spectacle est propos\u00e9 par l'\u00e9quipe des Laconiques Anonymes, une \u00e9quipe qui s'entraine \u00e0 Bruxelles et se produit r\u00e9guli\u00e8rement sur les sc\u00e8nes de Bruxelles et Wallonie, notamment dans le cadre du championnat adulte de la FBIA.\r\n\r\n\r\n-------`\r\nINFOS PRATIQUES\r\nLieu : Le TRAC\r\nAdresse : 110, rue Albert Meunier- Auderghem\r\nSpectacle \u00e0 11h\r\nR\u00c9SERVATIONS (vivement conseill\u00e9es)\r\nvia le lien du Trac : https:\/\/www.letrac.be\/reservations\r\nTARIFS\r\n- Sur r\u00e9servation : 7\u20ac\/personne \r\n- Sur place : 8\u20ac\/personne\r\nPlace offerte au parent accompagnant minimum 3 enfants \r\nPlaces offertes pour les enfants jusque 5 ans","performers":"L'\u00e9quipe des Laconiques Anonymes !\r\n\r\nAvec : Fanny, Vincent, Zo\u00e9, Bruno, St\u00e9phanie, S\u00e9bastien, Genevi\u00e8ve, Denis, Ga\u00eblle, Jimmy, Giselle, Martin, Patricia, Alex et Laureen","boxoffice_url":null,"website":null,"email":"info@letrac.be","phone_contact":"+32 470 50 04 75","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.546818"},"nl":{"name":"RACONTE MOI TON R\u00caVE - Spectacle pour enfants (\u00e0 partir de 5 ans) et leurs parents","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"info@letrac.be","phone_contact":"+32 470 50 04 75","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.546818"},"en":{"name":"RACONTE MOI TON R\u00caVE - Spectacle pour enfants (\u00e0 partir de 5 ans) et leurs parents","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"info@letrac.be","phone_contact":"+32 470 50 04 75","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.546818"},"de":{"name":"RACONTE MOI TON R\u00caVE - Spectacle pour enfants (\u00e0 partir de 5 ans) et leurs parents","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"info@letrac.be","phone_contact":"+32 470 50 04 75","phone_booking":null,"agenda_url":"https:\