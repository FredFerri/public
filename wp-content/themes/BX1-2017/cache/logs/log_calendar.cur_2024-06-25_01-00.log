e":"tour","ranking":0.15396304049941917,"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{"list":[108],"translations":{"de":["Folklore"],"pt":[null],"en":["Folklore"],"it":["Folklore"],"cn":[null],"fr":["Folklore"],"sp":["Folclore"],"nl":["Folklore"]}}},"translations":{"de":{"name":"Anderlecht : m\u00e9moire des B\u00e9guines, Saint-Guidon et Erasme","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.itineraires.be\/","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50008884"},"pt":{"name":"Anderlecht : m\u00e9moire des B\u00e9guines, Saint-Guidon et Erasme","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.itineraires.be\/","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50008884"},"en":{"name":"Anderlecht : m\u00e9moire des B\u00e9guines, Saint-Guidon et Erasme","shortdescr":null,"longdescr":"When dear old Guy first set foot in Broeck, sauntering around the Rinck, which would later become known as Place de la Vaillance, little could he have imagined that his devotees would end up building him a magnificent colle- giate church.. Or that crowds would bend over this trapezoidal tomb. That his life story would be re-enacted based on suppositions and guesswork, in- trigued as we all are by tombstones of uncertain origin. How could he have envisaged that the Beguines would pay homage to his humble lifestyle by the city gates, or that one of the world\u2019s most renowned Humanists would come to re-emerge from the shadows of the collegiate church that still bears his name today? No doubt this little sacristan from Laken was truly full of surprises! He even made it his task to bless the animals\u2026 enough to make Saint Hubert, the patron saint of hunters, green with envy. Only Peter has the key to the mystery.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.itineraires.be\/","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50008884"},"it":{"name":"Anderlecht : m\u00e9moire des B\u00e9guines, Saint-Guidon et Erasme","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.itineraires.be\/","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50008884"},"cn":{"name":"Anderlecht : m\u00e9moire des B\u00e9guines, Saint-Guidon et Erasme","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.itineraires.be\/","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50008884"},"fr":{"name":"Anderlecht : m\u00e9moire des B\u00e9guines, Saint-Guidon et Erasme","shortdescr":null,"longdescr":"Quand notre cher Guidon a foul\u00e9 du pied les berges du Broeck, caracolant le long du Rinck  de la future Vaillance, pouvait-il s'imaginer que son culte donnerait naissance \u00e0 une coll\u00e9giale superbe ? Que d'aucun se pencherait sur cette s\u00e9pulture trap\u00e9zo\u00efdale ? Que l'on referait son histoire \u00e0 coup de suppositions, intrigu\u00e9s que nous sommes tous par ces pierres aux origines incertaines? Imaginait-il aussi que de gentes b\u00e9guines participeraient \u00e0 cette vie rurale aux portes de la ville ou qu'un Humaniste des plus r\u00e9put\u00e9s se ressourcerait \u00e0 l'ombre de la coll\u00e9giale qui porte encore et toujours son nom? Ah ! Ce petit sacristain de Laeken a vraiment plus d'un tour dans son sac ! Au point de concourir aux b\u00e9n\u00e9dictions d'animaux\u2026 quitte \u00e0 rendre jaloux Hubert. Seul Pierre aura la clef du myst\u00e8re.\n","performers":null,"boxoffice_url":null,"website":"https:\/\/www.itineraires.be\/","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50008884"},"sp":{"name":"Anderlecht : m\u00e9moire des B\u00e9guines, Saint-Guidon et Erasme","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.itineraires.be\/","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50008884"},"nl":{"name":"Anderlecht : m\u00e9moire des B\u00e9guines, Saint-Guidon et Erasme","shortdescr":null,"longdescr":"Toen die goeie Guido langs de beemden van het Broeck dartelde en langs de Rinck zwierf, waar later het Dapperheidsplein zou worden aangelegd, kon hij zich vast niet voorstellen dat zijn verering aanleiding zou geven tot de bouw van een prachtige collegiale kerk! Noch dat zijn trapeziumvormig graf zo druk zou worden bezocht! Of dat zijn legende bol zou staan van de hypotheses, omdat de onzekere oorsprong van die stenen ons nu eenmaal intrigeert ... Had hij zich ooit kunnen indenken dat liefelijke begijnen deel zouden gaan uitmaken van het landelijke leven aan de poorten van de stad? Of dat een van de beroemdste Humanisten zou komen herbronnen in de schaduw van de collegiale kerk die tot op vandaag zijn naam draagt? Tja, die kleine koster van Laken heeft heel wat teweeggebracht! Hij ging zelfs dieren zegenen! Sint-Hubertus werd er zowaar jaloers van! Alleen Sint-Pieter zal later een eindoordeel kunnen vellen ...","performers":null,"boxoffice_url":null,"website":"https:\/\/www.itineraires.be\/","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50008884"}},"place":{"id":278807,"translations":{"de":{"name":"B\u00e9guinage d'Anderlecht","address_street_name":"Rue du Chapelain","address_street_number":"8","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue du Chapelain, 8","address_line2":"1070 Anderlecht","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"B\u00e9guinage d'Anderlecht","address_street_name":"Rue du Chapelain","address_street_number":"8","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue du Chapelain, 8","address_line2":"1070 Anderlecht","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"B\u00e9guinage d'Anderlecht","address_street_name":"Rue du Chapelain","address_street_number":"8","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue du Chapelain, 8","address_line2":"1070 Anderlecht","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"B\u00e9guinage d'Anderlecht","address_street_name":"Rue du C