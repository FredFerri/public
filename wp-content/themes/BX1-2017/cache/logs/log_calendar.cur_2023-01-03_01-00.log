heater"],"it":[null],"sp":[null],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Bingo Kids","shortdescr":"Bingo Kids, le spectacle d\u2019impro qui fait rire petits et grands, mais pas toujours au m\u00eame moment !","longdescr":"Le concept phare de la compagnie cr\u00e9\u00e9 il y a plus de 10 ans est \u00e0 pr\u00e9sent d\u00e9clin\u00e9 pour les enfants. Une vraie partie de Bingo pour le public, avec les grilles, les tirages de num\u00e9ros, un cadeau pour le gagnant, mais \u00e9galement un vrai spectacle d\u2019impro ! Les tirages sont le pr\u00e9texte \u00e0 une petite interview d\u2019une personne du public pour lancer les impros. Le tout dans la plus d\u00e9licieuse convivialit\u00e9 gr\u00e2ce aux joyeux drilles que sont Andr\u00e9-Marie, Hubert, Liliane, Ren\u00e9, Genevi\u00e8ve et Maurice.","performers":"Dominique Pattuelli, Na\u00efma Ostrowski, Nicolas Baras, Gilles Delvaulx, Philippe Rasse, Gregory Bracco","boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Bingo-Kids.html","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.538963"},"nl":{"name":"Bingo Kids","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.538963"},"en":{"name":"Bingo Kids","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.538963"},"de":{"name":"Bingo Kids","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.538963"},"it":{"name":"Bi