ite":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700003892"},"cn":{"name":"Expo Prix D\u00e9couverte de Rouge-Clo\u00eetre 2024-2025","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700003892"},"fr":{"name":"Expo Prix D\u00e9couverte de Rouge-Clo\u00eetre 2024-2025","shortdescr":"Le \u00ab Prix D\u00e9couverte de Rouge-Clo\u00eetre \u00bb souhaite promouvoir des talents artistiques qui n\u2019ont pas encore la place qu\u2019ils m\u00e9ritent sur la sc\u00e8ne culturelle belge. Ce concours d'art contemporain, soutenu par la COCOF et la F\u00e9d\u00e9ration Wallonie-Bruxelles, vise \u00e0 r\u00e9v\u00e9ler des artistes prometteurs en leur offrant l\u2019espace et les moyens de pr\u00e9senter leur travail au public.","longdescr":"Le \u00ab Prix D\u00e9couverte de Rouge-Clo\u00eetre \u00bb souhaite promouvoir des talents artistiques qui n\u2019ont pas encore la place qu\u2019ils m\u00e9ritent sur la sc\u00e8ne culturelle belge. Ce concours d'art contemporain, soutenu par la COCOF et la F\u00e9d\u00e9ration Wallonie-Bruxelles, vise \u00e0 r\u00e9v\u00e9ler des artistes prometteurs en leur offrant l\u2019espace et les moyens de pr\u00e9senter leur travail au public. Parmi les 162 candidats inscrits \u00e0 cette 15\u00e8me \u00e9dition, les membres du jury ont retenu six artistes, dont ils ont visit\u00e9 les ateliers pour examiner plus en profondeur le travail de chacun. Ces visites, qui constituent la marque sp\u00e9cifique du concours, ont permis de d\u00e9finir un laur\u00e9at final qui exposera individuellement au Centre d\u2019Art en 2025, un an apr\u00e8s l\u2019exposition collective.\n\u00c0 l'occasion de cette exposition o\u00f9 se m\u00ealent peinture, gravure, broderie et dessin, d\u00e9couvrez le travail singulier de : Jamel Barbach, Cl\u00e9mence Godier, \u00c9lise Leboutte, C\u00e9line Pinckers, Laurent Poisson, Jason Toussaint.","performers":"Jamel Barbach, Cl\u00e9mence Godier, \u00c9lise Leboutte, C\u00e9line Pinckers, Laurent Poisson, Jason Toussaint.","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700003892"},"sp":{"name":"Expo Prix D\u00e9couverte de Rouge-Clo\u00eetre 2024-2025","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700003892"},"nl":{"name":"Expo Prix D\u00e9couverte de Rouge-Clo\u00eetre 2024-2025","shortdescr":"De \u00abOntdekkingsprijs van het Rood Klooster\u00bb bedoeld om artistiek talent te promoten dat nog niet zijn rechtmatige plaats heeft verworven in het Belgisch cultuurgebeuren. Deze wedstrijd, met de steun van COCOF en F\u00e9d\u00e9ration Wallonie-Bruxelles, wil veelbelovende kunstenaars onder de aandacht brengen door hun de ruimte en middelen te geven om hun werk aan het publiek te tonen.","longdescr":"De \u00abOntdekkingsprijs van het Rood Klooster\u00bb is een tweejaarlijkse wedstrijd voor hedendaagse kunst, bedoeld om artistiek talent te promoten dat nog niet zijn rechtmatige plaats heeft verworven in het Belgisch cultuurgebeuren. Deze wedstrijd, met de steun van COCOF en F\u00e9d\u00e9ration Wallonie-Bruxelles, wil veelbelovende kunstenaars onder de aandacht brengen door hun de ruimte en middelen te geven om hun werk aan het publiek te tonen. Uit de 162 kandidaten die voor deze 15de editie waren ingeschreven, selecteerde de jury zes kunstenaars voor een bezoek aan hun atelier en een grondig onderzoek van hun oeuvre. Aan de hand van dezebezoeken \u2013 het handelsmerk van de wedstrijd \u2013 kon een eindlaureaat worden gekozen die in 2025 een individuele expo krijgt in hetKunstcentrum, een jaar na de collectieve tentoonstelling van de hiergepresenteerde zes kandidaten.\nOntdek in deze tentoonstelling, die een combinatie is van schilderen, graveren, borduren en tekenen, het unieke werk van : Jamel Barbach, Cl\u00e9mence Godier, \u00c9lise Leboutte, C\u00e9line Pinckers, Laurent Poisson en Jason Toussaint.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700003892"}},"place":{"id":1353,"translations":{"de":{"name":"Centre d'Art de Rouge-Clo\u00eetre","address_street_name":"Rue du Rouge-Clo\u00eetre","address_street_number":"4","address_street_box":null,"email":"info@rouge-cloitre.be","website":"http:\/\/www.rouge-cloitre.be","phone_contact":"+32 2 660 55 97","phone_booking":null,"address_zip":"1160","address_city":"Auderghem","address_line1":"Rue du Rouge-Clo\u00eetre, 4","address_line2":"1160 Auderghem","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Centre d'Art de Rouge-Clo\u00eetre","address_street_name":"Rue du Rouge-Clo\u00eetre","address_street_number":"4","address_street_box":null,"email":"info@rouge-cloitre.be","website":"http:\/\/www.rouge-cloitre.be","phone_contact":"+32 2 660 55 97","phone_booking":null,"address_zip":"1160","address_city":"Auderghem","address_line1":"Rue du Rouge-Clo\u00eetre, 4","address_line2":"1160 Auderghem","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Red Cloister Art Centre","address_street_name":"Rue du Rouge-Clo\u00eetre","address_street_number":"4","address_street_box":null,"email":"info@rouge-cloitre.be","website":"http:\/\/www.rouge-cloitre.be","phone_contact":"+32 2 660 55 97","phone_booking":null,"address_zip":"1160","address_city":"Auderghem","addr