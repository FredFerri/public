lusionbrussels.be\/","phone_contact":"+32 2 828 16 00","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du March\u00e9 aux Fromages, 22","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Illusion Brussels","address_street_name":"Rue du March\u00e9 aux Fromages","address_street_number":"22","address_street_box":null,"email":"info@illusionbrussels.be","website":"https:\/\/illusionbrussels.be\/","phone_contact":"+32 2 828 16 00","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du March\u00e9 aux Fromages, 22","address_line2":"1000 Bruxelles","description_web":"Entrez dans le monde fascinant des illusions o\u00f9 tous vos sens seront chamboul\u00e9s ; ce monde est capable de troubler les plus t\u00e9m\u00e9raires d\u2019entre vous tout en vous cultivant\u2026 Rendez-nous visite, vous ne serez pas d\u00e9\u00e7u. Sachez seulement que rien n\u2019est v\u00e9ritablement comme il semble l\u2019\u00eatre, surtout ICI !\n\n\u00cates-vous pr\u00eat pour une aventure qui d\u00e9passe bien au-del\u00e0 tout ce que vous auriez pu imaginer ? Visitez le Mus\u00e9e des illusions \u00e0 Bruxelles pour vivre une exp\u00e9rience intrigante, visuelle, sensorielle et \u00e9ducative avec nos \u00e9tonnantes illusions.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Illusion Brussels","address_street_name":"Rue du March\u00e9 aux Fromages","address_street_number":"22","address_street_box":null,"email":"info@illusionbrussels.be","website":"https:\/\/illusionbrussels.be\/","phone_contact":"+32 2 828 16 00","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du March\u00e9 aux Fromages, 22","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,