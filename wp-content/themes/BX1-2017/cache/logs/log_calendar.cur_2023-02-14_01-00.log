d":false},{"day":"2023-02-18","doors":"19:45:00","start":"20:00:00","end":null,"is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"},"de":{"name":"Normal"},"it":{"name":"Normale"},"sp":{"name":"Normal"},"pt":{"name":"Normal"},"cn":{"name":"Normal"}},"value":16},{"translations":{"fr":{"name":"Seniors"},"nl":{"name":"Senioren"},"en":{"name":"Seniors"},"de":{"name":"Senioren"},"it":{"name":"Anziani"},"sp":{"name":"Mayores"},"pt":{"name":"Seniors"},"cn":{"name":"Seniors"}},"value":14},{"translations":{"fr":{"name":"Jeunes"},"nl":{"name":"Jongeren"},"en":{"name":"Young people"},"de":{"name":"Jugendliche"},"it":{"name":"Ragazzi"},"sp":{"name":"J\u00f3venes"},"pt":{"name":"Jeunes"},"cn":{"name":"Jeunes"}},"value":10},{"translations":{"fr":{"name":"Demandeurs d'emploi"},"nl":{"name":"Werkzoekenden"},"en":{"name":"Job seekers"},"de":{"name":"Arbeitsuchende"},"it":{"name":"Disoccupati"},"sp":{"name":"Desempleados"},"pt":{"name":"Demandeurs d'emploi"},"cn":{"name":"Demandeurs d'emploi"}},"value":10},{"translations":{"fr":{"name":"Article 27"},"nl":{"name":"Artikel 27"},"en":{"name":"Article 27"},"de":{"name":"Article 27"},"it":{"name":"Article 27"},"sp":{"name":"Article 27"},"pt":{"name":"Article 27"},"cn":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-02-11T09:06:26+01:00","published_at":"2022-11-29T14:38:50+01:00","backoffice_id":266370,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":0.7937005259841},{"id":550873,"date_start":"2023-02-17","date_end":"2023-02-18","date_next":"2023-02-17","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":57,"translations":{"fr":"Clubbing","nl":"Clubbing","en":"Clubbing","de":"Clubbing","it":"Locali notturni","sp":"Ir de discoteca","pt":null,"cn":null}},"others":{}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"C12 x Cabaret Mademoiselle: Furie #2 Silver Edition Clubbing - Performances - Drag","shortdescr":"C12 x Cabaret Mademoiselle: Furie #2 Silver Edition Clubbing - Performances - Drag","longdescr":"Clubbing \u2013 Performances \u2013 Drag\r\nFurie #2 \u2013 An intense, acid, furious night, where performances redefine the codes of clubbing. Iconic creatures from the Brussels drag scene burst into C12\u2019s space of the new generation on rabid beats, between hypnotic trance and awakened rave.\r\nFurie #2 \u2013 Une nuit intense, acide, furieuse, o\u00f9 les performances red\u00e9finissent les codes du clubbing. Des cr\u00e9atures iconiques de la sc\u00e8ne drag bruxelloise \u00e9clatent l\u2019espace du C12 nouvelle g\u00e9n\u00e9ration sur des beats enrag\u00e9s, entre transe hypnotique et rave \u00e9veill\u00e9e.\r\n\r\nPERFORMERS\r\ntbc\r\nDJs\r\nOpening : Gigi The Bastard (https:\/\/www.instagram.com\/majormathilde\/)\r\nSecond part : Yojhan (https:\/\/www.instagram.com\/yoj.han.cm\/)\r\nThird part Vera Moro (https:\/\/www.instagram.com\/veramor.o\/)\r\n\r\nGood to know\r\n\u2594\u2594\u2594\r\nDoors open: 23h\r\n\u2014\u2014\u2014\u2014\u2014\u2014\r\nAge limit : + 21\r\n\u2014\u2014\u2014\u2014\u2014\u2014\r\nIn = In \/\/ Out = Out\r\n\u2014\u2014\u2014\u2014\u2014\u2014\r\nFor all kinds of people.\r\n\r\nTickets\r\n\u2594\u2594\u2594\r\nLimited amount of presale tickets : https:\/\/c12space.com\/presale-tickets\/\r\nDoor sale starts at 23h.\r\nLockers : 2\u20ac\r\nToilets : Free\r\n\r\nAddress\r\n\u2594\u2594\u2594\u2594\r\n116 rue marche aux herbes\r\n1000 Brussels\r\n\r\n\ufeff\r\nWhat we stand for\r\n\u2594\u2594\u2594\r\nC12 is a pluridisciplinary space where art & clubbing collide. It\u2019s a place where freedom, diversity, creativity and alternative cultures are protected from the outside world and its norms and restrictions. By doing this, we wish to establish a place owned by artists, musicians and every individual who comes through our door.\r\n\r\nNO!\r\n\u2014\u2014-\r\nIn order to protect our space, we will not tolerate any discriminating comportment (racism, sexism, homophobia, \u2026), shaming, violence, consumption of drugs and any kind of intrusive behaviour, even in its most passive form.\r\n\r\nRESPECT!\r\n\u2014\u2014\u2014\u2014-\r\nBetween these walls, we look out for each other and respect and tolerance are key. Everyone among us is treated equally, regardless of who they are, where they come from and what they do. The space belongs to everyone and to no group or no community in particular.\r\n\r\nIN OR NOT?\r\n\u2014\u2014\u2014\u2014-\r\nC12 is a private space and reserves the right to decide which visitors are allowed to enter. Represented by our door staff, we reserve the right to deny entry to every person deemed unable to respect the values connected to the project.\r\n\r\nNEED HELP?\r\n\u2014\u2014\u2014\u2014-\r\nC12\u2019s staff has been trained to act against any disputative situation or behavior. We have a help desk located near the entrance of the main room, where you can talk to a staff member any time of the night. We have staff present on the dance floor and in every corner of the club, functioning as our eyes and ears. We encourage anyone who witnesses a violation of the rules to contact a C12 staff member. In case of indictment, C12 reserves the right to contact the authorities. Respect yourself, the audience, the artists and the staff, stay hydrated and have a pleasant time.\r\nWe wish you an incredible night of clubbing.","performers":"Performers : \r\nCabaret Mademoiselle \r\nDjs :\r\nGigi The Bastard\r\nYojhan\r\nVera Moro","boxoffice_url":null,"webs