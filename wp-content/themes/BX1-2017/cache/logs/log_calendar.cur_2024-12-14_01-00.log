 de Justice, qu\u2019il ne r\u00e9ussit pas \u00e0 achever avant sa mort, les Minimes et l\u2019\u00e9glise du m\u00eame nom, le quartier de la Samaritaine, souvent en r\u00e9volte, la plaque qui rappelle V\u00e9sale et \"ses\" pendus, le quartier de Breughel, les maisons et \u00e9coles construites par Horta, la cit\u00e9 phalanst\u00e9rienne Reine Astrid, l\u2019\u00e9glise de la Chapelle\u2026 Quartier trop souvent n\u00e9glig\u00e9, il renferme pourtant le c\u0153ur battant de l'histoire de Bruxelles.\n","performers":null,"boxoffice_url":null,"website":"https:\/\/www.itineraires.be\/","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50008871"},"sp":{"name":"Les Ketjes de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.itineraires.be\/","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50008871"},"nl":{"name":"Les Ketjes de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.itineraires.be\/","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50008871"}},"place":{"id":244781,"translations":{"de":{"name":"Ascenseur des Marolles","address_street_name":"Rue de l'Ep\u00e9e","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de l'Ep\u00e9e","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Ascenseur des Marolles","address_st