nen","Assistentiehonden","Toegankelijke parking","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet","Brussels Health Safety Label"],"en":["Accessible to people with intellectual disabilities","Accessible","Facilities for deaf and hearing-impaired people","Assistance dogs","Accessible parking","Accessible to pedestrians with mobility aids","Adapted toilet","Brussels Health Safety Label"],"de":["Barrierefrei f\u00fcr Menschen mit Verst\u00e4ndnisschwierigkeiten","Barrierefrei","Anpassungen f\u00fcr geh\u00f6rlose und h\u00f6rgesch\u00e4digte Menschen.","Assistenzhund","Barrierefreier Parkplatz","Barrierefrei f\u00fcr Fu\u00dfg\u00e4nger mit Gehhilfe","Barrierefreies WC","Brussels Health Safety Label"],"it":[null,null,null,null,null,null,null,null],"sp":[null,null,null,null,null,null,null,null],"pt":[null,null,null,null,null,null,null,null],"cn":[null,null,null,null,null,null,null,null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2023-01-02T09:35:22+01:00","published_at":"2023-01-02T09:32:55+01:00","backoffice_id":268169,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.28543716208189},{"id":545895,"date_start":"2022-11-23","date_end":"2023-01-08","date_next":"2023-01-02","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":84,"translations":{"fr":"Divers","nl":"Varia","en":"Various","de":"Verschiedenes","it":null,"sp":null,"pt":null,"cn":null}},"others":{}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Brussels by Lights","shortdescr":"Du 23.11 au 08.01, d\u00e9couvrez Brussels by Lights et ses installations surprenantes faites de formes g\u00e9om\u00e9triques suspendues et d\u2019autres \u0153uvres lumineuses. Un parcours intimiste vous attend dans le charmant quartier Chartreux, agr\u00e9ment\u00e9 par des fresques phosphorescentes de graphistes belges qui se sont empar\u00e9s des vitrines de certains commerces vides.","longdescr":"Du 23.11 au 08.01, d\u00e9couvrez Brussels by Lights et ses installations surprenantes faites de formes g\u00e9om\u00e9triques suspendues et d\u2019autres \u0153uvres lumineuses. Un parcours intimiste vous attend dans le charmant quartier Chartreux, agr\u00e9ment\u00e9 par des fresques phosphorescentes de graphistes belges qui se sont empar\u00e9s des vitrines de certains commerces vides.\r\n\r\nDepuis 2013, la Ville de Bruxelles illumine de plus en plus de rues et d\u2019art\u00e8res commer\u00e7antes de la capitale. Cette ann\u00e9e, il y en a 160 dont 8 nouvelles. Cette extension est justifi\u00e9e par le souhait assidu de soutenir les activit\u00e9s commerciales des quartiers de la Ville qui sont d\u2019ailleurs partie prenante des d\u00e9cisions au sujet des illuminations qui\u00a0les\u00a0concernent.\r\n\r\nHoraires : tous les jours de 17h00 \u00e0 01h00.","performers":null,"boxoffice_url":null,"website":"http:\/\/brusselsbylights.be\/","email":"info@bmeo.be","phone_contact":"+32 2 318 64 70","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.545895"},"nl":{"name":"Brussels by Lights","shortdescr":"Ontdek van 23 november tot 8 januari Brussels by Lights en zijn verrassende installaties van hangende geometrische vormen en andere lichtwerken. Er wacht je een intieme rondleiding door de charmante Kartuizerwijk, met fosforescerende fresco's van Belgische grafische kunstenaars die de etalages van enkele leegstaande winkels hebben overgenomen.","longdescr":"Ontdek van 23 november tot 8 januari Brussels by Lights en zijn verrassende installaties van hangende geometrische vormen en andere lichtwerken. Er wacht je een intieme rondleiding door de charmante Kartuizerwijk, met fosforescerende fresco's van Belgische grafische kunstenaars die de etalages van enkele leegstaande winkels hebben overgenomen.\r\n\r\nSinds 2013 zorgt de Stad Brussel voor feestelijke verlichting in steeds meer grote en kleine winkelstraten van de hoofdstad. Dit jaar, voor de tiende editie, zullen het er 160 zijn, waaronder 8 nieuwe. De uitbreiding sluit aan bij de inspanningen om de commerci\u00eble activiteiten in de stadswijken te ondersteunen. De betrokken wijken beslissen ook mee over de verlichting ter plaatse.\r\n\r\nOpeningstijden: dagelijks van 17.00\u00a0tot\u00a001.00\u00a0uur.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.545895"},"en":{"name":"Brussels by Lights","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.545895"},"de":{"name":"Brussels by Lights","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.545895"},"it":{"name":"Brussels by Lights","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.545895"},"sp":{"name":"Brussels by Lights","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.545895"},"pt":{"name":"Brussels by Lights","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/v