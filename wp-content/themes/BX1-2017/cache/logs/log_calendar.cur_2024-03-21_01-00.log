Art Nouveau, Art D\u00e9co"],"cn":[null],"fr":["Art Nouveau, Art D\u00e9co"],"sp":["Art nouveau, art d\u00e9co"],"nl":["Art nouveau, art deco"]}}},"translations":{"de":{"name":"BANAD Festival - Guided tour of the former Colpaert studio","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/banad.brussels","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50007656"},"pt":{"name":"BANAD Festival - Guided tour of the former Colpaert studio","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/banad.brussels","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50007656"},"en":{"name":"BANAD Festival - Guided tour of the former Colpaert studio","shortdescr":"As part of the BANAD Festival, come and discover the former studios of glass painter Florent-Prosper Colpaert, built in 1929 in the Art Deco style. ","longdescr":"The former studio of the painter and stained-glass glazier Florent-Prosper Colpaert, was designed in the Art Deco style by the architect Adolphe Deboodt and built in 1929. In the early 1990s, it was restored and modernised by the architects De Smet and Whalley. An impressive stairwell with a glass ceiling leads to the glazier's house upstairs. Many original fixtures and fittings have survived, including several pieces of furniture designed by the architect Albert Van Huffel, some stained-glass windows and some tools. Today the building is used as offices by the architects Pierre Accarain and Marc Bouillot.","performers":null,"boxoffice_url":null,"website":"https:\/\/banad.brussels","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50007656"},"it":{"name":"BANAD Festival - Guided tour of the former Colpaert studio","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/banad.brussels","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50007656"},"cn":{"name":"BANAD Festival - Guided tour of the former Colpaert studio","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/banad.brussels","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50007656"},"fr":{"name":"BANAD Festival - Visite guid\u00e9e des anciens ateliers Colpaert","shortdescr":"Dans le cadre du BANAD Festival, venez d\u00e9couvrir les anciens ateliers du peintre-verrier Florent-Prosper Colpaert, de style Art D\u00e9co, construit en 1929. ","longdescr":"Les anciens ateliers du peintre-verrier Florent-Prosper Colpaert, de style Art D\u00e9co, ont \u00e9t\u00e9 construits par l'architecte Adolphe Deboodt en 1929. L'ensemble a \u00e9t\u00e9 r\u00e9nov\u00e9 et modernis\u00e9 par les architectes De Smet et Whalley au d\u00e9but des ann\u00e9es 1990. Son impressionnante cage d'escalier sous lanterneau m\u00e8ne au logement du verrier \u00e0 l'\u00e9tage. De nombreux \u00e9l\u00e9ments d'origine subsistent dont plusieurs pi\u00e8ces de mobilier de l'architecte Albert Van Huffel, des vitraux et quincaillerie. Il abrite aujourd'hui le bureau des architectes Pierre Accarain et Marc Bouillot.","performers":"Explore.Brussels asbl-vzw","boxoffice_url":null,"website":"https:\/\/banad.brussels","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50007656"},"sp":{"name":"BANAD Festival - Guided tour of the former Colpaert studio","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/banad.brussels","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50007656"},"nl":{"name":"BANAD Festival - Rondleiding in de voormalige ateliers Colpaert","shortdescr":"Ontdek in het kader van het BANAD Festival de voormalige ateliers van glasschilder Florent-Prosper Colpaert, gebouwd in 1929 in art-decostijl. ","longdescr":"\nDe voormalige ateliers van schilder-glasblazer Florent-Prosper Colpaert, in art deco stijl, werden in 1929 gebouwd door architect Adolphe Deboodt. Het geheel werd aan het begin van de jaren 1990 gerenoveerd en gemoderniseerd door architecten De Smet en Whalley. Het indrukwekkende trappenhuis onder een lichtkoepeltje brengt u naar de woning van de glasblazer op de eerste verdieping. Er zijn nog talloze oorspronkelijke elementen te bewonderen, zoals meubels van architect Albert Van Huffel, glas-in-loodramen en ijzerbeslag. Vandaag is het kantoor van architecten Pierre Accarain en Marc Bouillot er ondergebracht.","performers":null,"boxoffice_url":null,"website":"https:\/\/banad.brussels","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50007656"}},"place":{"id":271562,"translations":{"de":{"name":"Anciens ateliers Colpaert","address_street_name":"Rue Monrose","address_street_number":"33","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Rue Monrose, 33","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Anciens ateliers Colpaert","address_street_name":"Rue Monrose","address_street_number":"33","address_street_box":null,"email":nul