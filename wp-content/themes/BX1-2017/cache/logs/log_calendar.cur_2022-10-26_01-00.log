:35:58+02:00","published_at":"2022-09-30T15:50:10+02:00","backoffice_id":262868,"import_origin":null,"sub_type":"party","show_in_agenda":true,"ranking":0.22397695245558},{"id":540957,"date_start":"2022-09-12","date_end":"2022-12-12","date_next":"2022-10-25","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":true,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung"}},"others":{"list":[36,46],"translations":{"fr":["Mus\u00e9es et art centers","Pluridisciplinaire"],"nl":["Musea en kunstcentra","Multidisciplinair"],"en":["Museums and art centers","Multidisciplinary"],"de":["Museen & Kunstzentren","Multidisziplin\u00e4r"]}}},"languages":{"spoken":["fr","en"],"subtitles":[]},"translations":{"fr":{"name":"Imagine Cultures","shortdescr":"Imagine Cultures : une r\u00e9trospective sur la vie culturelle du campus de l\u2019ULB  \r\n\r\nDu 12 septembre au 12 d\u00e9cembre 2022, le campus du Solbosch f\u00eate ses cent ans : c\u2019est l\u2019occasion de se souvenir des initiatives artistiques qui y ont vu le jour, et d\u2019imaginer celles de demain !","longdescr":"Imagine Cultures : une r\u00e9trospective sur la vie culturelle du campus de l\u2019ULB  \r\n\r\nDu 12 septembre au 12 d\u00e9cembre 2022, le campus du Solbosch f\u00eate ses cent ans : c\u2019est l\u2019occasion de se souvenir des initiatives artistiques qui y ont vu le jour, et d\u2019imaginer celles de demain ! \u201cImagine Cultures\u201d propose un parcours d\u2019exposition, des visites guid\u00e9es et une programmation gratuite d\u2019arts vivants.  \r\n\r\nL\u2019exposition\u202fretrace les \u00e9v\u00e9nements qui ont fa\u00e7onn\u00e9 et inspir\u00e9 des g\u00e9n\u00e9rations d\u2019\u00e9tudiant\u00b7es. Du concert de Patti Smith \u00e0 l\u2019amphith\u00e9\u00e2tre Paul-Emile Janson aux cr\u00e9ations th\u00e9\u00e2trales universitaires en passant par la collection d\u2019art moderne et contemporain de l\u2019ULB, \u201cImagine Cultures\u201d tisse des liens entre les cultures pass\u00e9es et futures.  \r\n\r\nL\u2019\u201cImagine Festival\u201d, enti\u00e8rement programm\u00e9 par les \u00e9tudiant\u00b7es, se d\u00e9roulera du 12\/09 au 07\/10 est d\u00e9di\u00e9 \u00e0 la dynamique actuelle et engag\u00e9e de l\u2019ULB. \r\n\r\nImpr\u00e9gnez-vous de cette \u00e9bullition cr\u00e9ative, artistique et sociale sur le campus du Solbosch du 12\/09 au 12\/12. \r\n\r\nToutes les informations sur www.ulb.be\/centenaire","performers":null,"boxoffice_url":null,"website":"http:\/\/www.ulb.be\/centenaire","email":"Culture@ulb.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.540957"},"nl":{"name":"Imagine Cultures","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.540957"},"en":{"name":"Imagine Cultures","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.540957"},"de":{"name":"Imagine Cultures","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.540957"},"it":{"name":"Imagine Cultures","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.540957"},"sp":{"name":"