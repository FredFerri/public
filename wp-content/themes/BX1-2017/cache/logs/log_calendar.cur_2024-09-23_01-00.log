reet_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+ 32 (0)2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+ 32 (0)2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"CIVA is a museum, an archive center, a library and a meeting place for lovers of architecture, landscape architecture, urban ecosystems and history in Brussels. Throughout the year, CIVA organizes temporary exhibitions, lectures, debates, guided tours, book launches and activities for children. The activities are organized in Ixelles, near Place Flagey and in the center of Brussels, in KANAL - Centre Pompidou.","description_print":null,"booking_url":null,"sort_order":"CIVA","virtual_visit":null,"visit_url":null},"it":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+ 32 (0)2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+ 32 (0)2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+ 32 (0)2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"CIVA est un muse\u0301e, un centre d'archives, une bibliothe\u0300que et un lieu de rencontre pour les amateurs d'architecture, d'architecture paysage\u0300re, d'e\u0301cosyste\u0300mes urbains et d'histoire a\u0300 Bruxelles. Tout au long de l'anne\u0301e, vous pouvez vous y rendre pour des expositions temporaires, des confe\u0301rences, des de\u0301bats, des visites guide\u0301es, des lancements de livres et des activite\u0301s pour les enfants. Les activite\u0301s se trouvent a\u0300 Ixelles, pre\u0300s de la Place Flagey et au centre de Bruxelles, a\u0300 KANAL - Centre Pompidou.\r\n\r\n","description_print":null,"booking_url":null,"sort_order":"CIVA","virtual_visit":null,"visit_url":null},"sp":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+ 32 (0)2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"Creado en 2016 por iniciativa de la Regi\u00f3n Bruselas-Capital, el CIVA re\u00fane una \u00fanica estructura de recursos, conocimiento y aprendizaje de varias asociaciones culturales activas en Bruselas en los campos de la arquitectura, urbanismo, paisajes y el estudio de ecosistemas: los Archivos de Arquitectura Moderna, la Biblioteca Ren\u00e9 Pech\u00e8re, los Fondos para la arquitectura, el Centro Paul Duvigneaud y el CIVA asbl, ahora disuelto.\r\nA trav\u00e9s de este proyecto cultural, la Fundaci\u00f3n CIVA contribuye al desarrollo del paisaje arquitect\u00f3nico y la cultura urbana como base para afrontar desaf\u00edos contempor\u00e1neos, poniendo especial \u00e9nfasis en Bruselas.\r\nSiempre tiene \u00e9xito a la hora de cumplir sus objetivos y tratar con un p\u00fablico amplio (adultos y ni\u00f1os, estudiantes, investigadores, arquitectos, paisajistas, amantes de la naturaleza, pol\u00edticos, etc), la fundaci\u00f3n CIVA organiza numerosos eventos y actividades en diferentes lugares, incluyendo exhibiciones permanentes y temporales, conferencias, debates y actividades educativas. Tambi\u00e9n dispone archivos excepcionales abiertos para todos los p\u00fablicos (documentos de arquitectos y paisajistas: planos, bocetos, modelos, muebles, etc.) y librer\u00edas que contienen casi 40.000 obras y peri\u00f3dicos de arquitectura, urbanismo, la historia de los pueblos y ciudades, paisajes, jardines y ecolog\u00eda urbana.\r\nEstas actividades y materiales est\u00e1n dise\u00f1ados para despertar la curiosidad y el inter\u00e9s de todo nuestro entorno, ya sea un hecho hist\u00f3rico o una construcci\u00f3n.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"CIVA","address_street_name":"Kluisstraat","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+ 32 (0)2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"Kluisstraat","address_line2":"1050 Elsene","description_web":"CIVA is een museum, een archiefcentrum, een bibliotheek en een ontmoetingsplek voor liefhebbers van architectuur, landschapsarchitectuur, stadsecosystemen en geschiedenis in Brussel. Het hele jaar door kan je er terecht voor tijdelijke tentoonstellingen, lezingen, debatten, rondleidingen, book launches en kinderactiviteiten. De activiteiten vind je in Elsene, vlakbij het Flageyplein en in Brussel-centrum, in KANAL \u2013 Centre Pompidou.","description_print":null,"booking_url":null,"sort_order":"CIVA","virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":1436,"location":{"lat":50.82873218,"lon":4.36569034},"last_updated_at":"2024-03-19T12:49:53+01:00","published_at":"2013-10-19T01:14:20+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/967c48e0b8537d15a4584dadbf98420146405aae.jpg","width":4133,"height":1969,"ratio":2.1,"oEmbed_height":1969,"oEmbed_width":4133,"translations":{"de":{"title":"Sta. Jasinski \/ Projet de centralisation de l'administration minist\u00e9rielle, Bruxelles. 1929-1930","copyright":"CIVA Collections, Brussels"},"pt":{"title":"Sta. Jasinski \/ Projet de centralisation de l'administration minist\u00e9rielle, Bruxelles. 1929-1930","copyright":"CIVA Collections, Brussels"},"en":{"title":"Sta. Jasinski \/ Projet de centralisation de l'administration minist\u00e9rielle, Bruxelles. 1929-1930","copyright":"CIVA Collections, Brussels"},"it":{"title":"Sta. Jasinski \/ Projet de centralisation de l'administration minist\u00e9rielle, Bruxelles. 1929-1930","copyright":"CIVA Collections, Brussels"},"cn":{"title":"Sta. Jasinski \/ Projet de centralisation de l'administration minist\u00e9rielle, Bruxelles. 1929-1930","copyright":"CIVA Collections, Brussels"},"fr":{"title":"Sta. Jasinski \/ Projet de centralisation de l'administration minist\u00e9rielle, Bruxelles. 1929-1930","copyright":"CIVA Collections, Brussels"},"sp":{"title":"Sta. Jasinski \/ Projet de centralisation de l'administration minist\u00