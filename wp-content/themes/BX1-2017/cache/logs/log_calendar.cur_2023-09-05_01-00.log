n_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":276036,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"theatre","ranking":1,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":49,"translations":{"de":"Theater","pt":null,"en":"Theatre","it":"Teatro","cn":null,"fr":"Th\u00e9\u00e2tre","sp":"Teatro","nl":"Theater"}},"others":{"list":[50],"translations":{"de":["Theater"],"pt":[null],"en":["Theatre"],"it":["Teatro"],"cn":[null],"fr":["Th\u00e9\u00e2tre"],"sp":["Teatro"],"nl":["Theater"]}}},"translations":{"de":{"name":"Girls and Boys","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.bruxellons.be","email":"info@bruxellons.net","phone_contact":"+32 2 724 24 24","phone_booking":"+32 2 724 24 24","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.556036"},"pt":{"name":"Girls and Boys","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.bruxellons.be","email":"info@bruxellons.net","phone_contact":"+32 2 724 24 24","phone_booking":"+32 2 724 24 24","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.556036"},"en":{"name":"Girls and Boys","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.bruxellons.be","email":"info@bruxellons.net","phone_contact":"+32 2 724 24 24","phone_booking":"+32 2 724 24 24","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.556036"},"it":{"name":"Girls and Boys","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.bruxellons.be","email":"info@bruxellons.net","phone_contact":"+32 2 724 24 24","phone_booking":"+32 2 724 24 24","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.556036"},"cn":{"name":"Girls and Boys","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.bruxellons.be","email":"info@bruxellons.net","phone_contact":"+32 2 724 24 24","phone_booking":"+32 2 724 24 24","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.556036"},"fr":{"name":"Girls and Boys","shortdescr":"Entre humour cinglant, confessions douloureuses et retours sur les petits bonheurs, une vie trac\u00e9e par la plume explosive de Dennis Kelly\r\n\r\n\u00abEt pourtant, je continue \u00e0 croire que le th\u00e9\u00e2tre peut changer le monde [\u2026] et que l\u2019auteur doit, plus que tout, s\u2019acharner \u00e0 t\u00e2tonner vers la v\u00e9rit\u00e9.\u00bb Denis Kelly","longdescr":"Girls and boys, c\u2019est une exp\u00e9dition dans les m\u00e9andres de la m\u00e9moire mettant peu \u00e0 peu \u00e0 jour comment un quotidien s\u2019\u00e9caille, se fissure par petits coups d\u2019\u00e9clats et finalement, explose. Le texte de Dennis Kelly est construit comme un puzzle, et ce n\u2019est que petit \u00e0 petit que se construit l\u2019image, faite ici des travers et m\u00e9faits d\u2019une soci\u00e9t\u00e9 machiste et capitaliste, o\u00f9 se d\u00e9pose l\u2019histoire intime d\u2019une femme d\u2019aujourd\u2019hui.\r\n\r\n\u00abJ\u2019ai rencontr\u00e9 mon mari dans la file d\u2019embarquement d\u2019un vol Easyjet\u2026 et je dois dire que cet homme m\u2019a tout de suite d\u00e9plu\u00bb\r\n\r\n\u00c7a s\u2019est pass\u00e9 exactement comme \u00e7a : au premier regard, il lui d\u00e9plaisait, au second, elle \u00e9tait conquise. Il suffit d\u2019une rencontre pour faire basculer une vie et d\u2019un geste pour la faire d\u00e9railler compl\u00e8tement. Une femme se fait l\u2019enqu\u00eatrice de sa propre vie, \u00e9gr\u00e9nant ses r\u00e9ussites professionnelles comme ses souffrances priv\u00e9es, elle se laisse peu \u00e0 peu rattraper par les instantan\u00e9s de sa vie de maman\u2026 Quand l\u2019ironie s\u2019estompe, le drame se diffuse dans la voix comme de l\u2019encre sur un buvard et l\u2019histoire qui commen\u00e7ait comme un stand-up et s\u2019\u00e9tait poursuivie en thriller, aboutit sans d\u00e9tour possible \u00e0 la trag\u00e9die.","performers":"De: Dennis Kelly\r\nMise en sc\u00e8ne: Jean-Baptiste Delcourt\r\nAvec: France Bastoen","boxoffice_url":null,"website":"http:\/\/www.bruxellons.be","email":"info@bruxellons.net","phone_contact":"+32 2 724 24 24","phone_booking":"+32 2 724 24 24","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.556036"},"sp":{"name":"Girls and Boys","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.bruxellons.be","email":"info@bruxellons.net","phone_contact":"+32 2 724 24 24","phone_booking":"+32 2 724 24 24","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.556036"},"nl":{"name":"Girls and Boys","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.bruxellons.be","email":"info@bruxellons.net","phone_contact":"+32 2 724 24 24","phone_booking":"+32 2 724 24 24","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.556036"}},"place":{"id":236436,"translations":{"de":{"name":"Festival Bruxellons! Au Ch\u00e2teau du Karreveld","address_street_name":"Avenue Jean de la Hoese","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.bruxellons.be","phone_contact":"+32 2 762 95 02","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Avenue Jean de la Hoese","address_line2":"1080 Molenbeek-Saint-Jean","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Festival Bruxellons! Au Ch\u00e2teau du Karreveld","address_street_name":"Avenue Jean de la Hoese","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.bruxellons.be","phone_contact":