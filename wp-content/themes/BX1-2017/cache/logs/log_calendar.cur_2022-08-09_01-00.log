:00:00","end":"18:00:00"}]},"sunday":{"is_open":true,"hours":[{"start":"10:00:00","end":"18:00:00"}]}},"translations":{"fr":["lundi, mardi, mercredi, jeudi, vendredi, samedi et dimanche: de 10:00 \u00e0 18:00"],"nl":["maandag, dinsdag, woensdag, donderdag, vrijdag, zaterdag en zondag: van 10:00 tot 18:00"],"en":["monday, tuesday, wednesday, thursday, friday, saturday and sunday: from 10:00 to 18:00"]},"date_start":"2022-04-28","date_end":"2022-08-29","is_also_by_appointment":false}],"date_exceptions":[{"day":"2022-04-28","start":"10:00:00","end":"20:00:00"}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"opening":{"day":"2022-04-28","start":"18:00:00","timestamp":"2022-04-28T18:00:00+02:00","end":"20:00:00","is_only_by_appointment":false},"tags":[],"accessibilities":{"list":[255,259,265,266],"translations":{"fr":["Accessible","Chien d'assistance","WC adapt\u00e9","Brussels Health Safety Label"],"nl":["Toegankelijk","Assistentiehonden","Aangepast toilet","Brussels Health Safety Label"],"en":["Accessible","Assistance dogs","Adapted toilet","Brussels Health Safety Label"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-08-08T01:08:37+02:00","published_at":"2022-04-25T10:01:07+02:00","backoffice_id":252381,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.25265977409643},{"id":537233,"date_start":"2022-07-01","date_end":"2022-09-17","date_next":"2022-08-08","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[36,41],"translations":{"fr":["Mus\u00e9es et art centers","Installation, performance"],"nl":["Musea en kunstcentra","Installatie, performance"],"en":["Museums and art centers","Installation, performance"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Une Maison d\u2019Edition Algolitt\u00e9raire 0.01","shortdescr":"Ana\u00efs Berck repr\u00e9sente une collaboration entre des \u00eatres humains, des algorithmes et des arbres. En tant que collectif, ils ouvrent un espace dans lequel l\u2019intelligence humaine est explor\u00e9e en compagnie de l\u2019intelligence v\u00e9g\u00e9tale et de l\u2019intelligence artificielle.","longdescr":"\u201cWe need acts of restoration, not only for polluted waters and degraded lands, but also for our relationship to the world. We need to restore honor to the way we live, so that when we walk through the world we don\u2019t have to avert our eyes with shame, so that we can hold our heads up high and receive the respectful acknowledgment of the rest of the earth\u2019s beings.\u201d\r\nRobin Wall Kimmerer, Braiding Sweetgrass, Milkweed Editions, 2013\r\n\r\nAna\u00efs Berck repr\u00e9sente une collaboration entre des \u00eatres humains, des algorithmes et des arbres. En tant que collectif, ils ouvrent un espace dans lequel l\u2019intelligence humaine est explor\u00e9e en compagnie de l\u2019intelligence v\u00e9g\u00e9tale et de l\u2019intelligence artificielle.\r\n\r\nCette ann\u00e9e, Ana\u00efs Berck \u00e9tudie l\u2019id\u00e9e d\u2019une \"Maison d\u2019\u00e9dition algolitt\u00e9raire\" dans laquelle les auteurs sont des algorithmes, pr\u00e9sent\u00e9s avec leurs contextes et leurs codes, et dans laquelle le contenu des livres sont les arbres et la nature.\r\nCette recherche en compagnie de pr\u00e9sences plus qu\u2019humaines am\u00e8ne Ana\u00efs Berck vers les territoires hautement charg\u00e9s \u00e0 l\u2019intersection de la botanique, du computationalisme et de l\u2019\u00e9dition. Les implications de l\u2019id\u00e9ologie occidentale, la force centrifuge de l\u2019archivisme et de l\u2019extractivisme y sont mises en \u00e9vidence.\r\n\r\nVous \u00eates les bienvenu.e.s \u00e0 l\u2019ouverture de l\u2019installation dans la vitrine de Constant le jeudi 30 juin 2022 \u00e0 partir de 18h00.\r\n\r\nCette installation constitue un premier moment public dans cette recherche dans laquelle nous esp\u00e9rons formuler un d\u00e9but de r\u00e9ponse \u00e0 des questions telles que : qui et quoi est exclu, rendu invisible ou exploit\u00e9 dans les repr\u00e9sentations, discours, outils et pratiques existants ? Comment pouvons-nous restaurer leurs pr\u00e9sences dans les histoires et les r\u00e9cits ? Comment pouvons-nous nous gu\u00e9rir et nous transformer nous-m\u00eames, nos outils, nos pratiques, nos relations au monde, nos h\u00e9ritages ? Comment pouvons-nous aider \u00e0 d\u00e9stabiliser la force centrifuge dans la botanique, l\u2019informatique et l\u2019\u00e9dition ? Comment rendre visibles les livres, les bases de donn\u00e9es, les algorithmes en tant qu\u2019objets de doutes et comment aller au-del\u00e0 de leurs formes \u00e9tablies ?\r\n\r\nDans cette installation, Ana\u00efs Berck est repr\u00e9sent\u00e9e par les humains An Mertens, Brendan Howell, Gijs de Heij, Guillaume Slizewicz ; par les arbres et les plantes dont les esprits vivent dans la collection d\u2019herbiers du Jardin Botanique de Meise ; et par un large ensemble d\u2019algorithmes de scraping, d\u2019analyse et de g\u00e9n\u00e9ration.\r\n\r\nDans le cadre de la vitrine, Ana\u00efs Berck organisera un atelier le 9 septembre 2022 pour discuter des id\u00e9es, outils, mat\u00e9riaux autour de l\u2019installation.\r\n\r\nCette recherche est soutenue par FRArt (https:\/\/art-recherche.be).\r\n\r\nPS : \u00cates-vous engag\u00e9.e.s dans ces questions et avez-vous une certaine exp\u00e9rience de la programmation ? Ana\u00efs Berck est \u00e0 la recherche de nouveaux.elles collaborateur.ices ! Pour plus d\u2019informations, veuillez envoyer un mail \u00e0 anais@anaisberck.be.","performers":"Ana\u00efs Berck (collective artistique)","boxoffice_url":null,"website":"http:\/\/www.constantvzw.org","email":"info@constantvzw.org","phone_contact":"+32 2 539 24 67","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.537233"},"nl":{"name":"Een Algoliteraire Uitgeverij 0.01","shortdescr":"Ana\u00efs Berck staat voor een samenwerking tussen mensen, algoritmes en bomen. Als collectief openen ze een ruimte waarin menselijke intelligentie wordt verkend in gezelschap van plantaardige intelligentie en artifici\u00eble intelligentie.","longdescr":"\u201cWe need acts of restoration, not only for polluted waters and degraded lands, but also for our relationship to the world. We need to restore honor to the way we live, so that when we walk through the world we don\u2019t have to avert our eyes with shame, so that we can hold our heads up high and receive the respectful acknowledgment of the rest of the earth\u2019s beings.\u201d\r\nRobin Wall Kimmerer, Braiding Sweetgrass, Milkweed Editions, 2013\r\n\r\nAna\u00efs Berck staat voor een samenwerking tussen mensen, algoritmes en bomen. Als collectief openen ze een ruimte waarin menselijke intelligentie wordt verkend in gezelschap van plantaardige intelligentie en artifici\u00eble intelligentie.\r\n\r\nDit jaar onderzoekt Ana\u00efs Berck het idee van \u2019Een Algoliteraire Uitgeverij\u2019 waarin de auteurs algoritmes zijn, gepresenteerd met hun contexten en codes; en waarin de inhoud van de boeken wordt bepaald door bomen en de natuur. Dit onderzoek in gezelschap van meer-dan-menselijke wezens brengt Ana\u00efs Berck naar explosieve territoria waar plantkunde, technologie en de uitgeverswereld elkaar raken. Daar worden de implicaties van de Westerse ideologie, de middelpuntzoekende kracht van archivisme en extractivisme op scherp gesteld.\r\n\r\nJe bent van harte welkom op de opening van de installatie in de vitrine van Constant op donderdag 30 juni 2022 vanaf 18u00.\r\n\r\nDeze installatie vormt een eerste publiek moment in dit onderzoek, waarmee we een begin van een antwoord proberen formuleren op vragen als: wie en wat wordt uitgesloten, onzichtbaar gemaakt of uitgebuit in de bestaande representaties, gereedschappen en praktijken? Hoe kunnen we hun aanwezigheid in geschiedenissen en vertellingen herstellen? Hoe kunnen we onszelf, onze gereedschappen, onze praktijken, onze relaties met de wereld en ons nalatenschap helen en transformeren? Hoe kunnen we de middelpuntvliedende kracht in de botanica, de informatica en de uitgeverij helpen destabiliseren? Hoe kunnen we boeken, databases, algoritmes zichtbaar maken als objecten van twijfel en uitstijgen boven hun gestandaardiseerde formats?\r\n\r\nIn deze installatie wordt Ana\u00efs Berck vertegenwoordigd door de mensen An Mertens, Brendan Howell, Gijs de Heij, Guillaume Slizewicz; door de bomen en planten waarvan de geesten leven in de herbariumcollectie van de Botanische Tuin van Meise; en door een groot aantal scrape-, analyse- en generatieve algoritmes.\r\n\r\nIn het kader van de vitrine organiseert Ana\u00efs Berck op 9 september 22 een workshop, rond de idee\u00ebn, tools en materialen van de installatie.\r\n\r\nDit onderzoek wordt mogelijk gemaakt door FRArt (https:\/\/art-recherche.be)\r\n\r\nPS: Voel je je gedreven door dezelfde vragen en heb je programmeerervaring? Ana\u00efs Berck lanceert een open oproep voor medewerkers: https:\/\/www.anaisberck.be\/oproep-tot-deelname\/","performers":"Ana\u00efs Berck (kunst collectief)","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.537233"},"en":{"name":"An Algoliterary Publishing House 0.01","shortdescr":"Ana\u00efs Berck stands for a collaboration between people, algorithms and trees. As a collective, they open a space in which human intelligence is explored in company of plant intelligence and artificial intelligence.","longdescr":"\u201cWe need acts of restoration, not only for polluted waters and degraded lands, but also for our relationship to the world. We need to restore honor to the way we live, so that when we walk through the world we don\u2019t have to avert our eyes with shame, so that we can hold our heads up high and receive the respectful acknowledgment of the rest of the earth\u2019s beings.\u201d\r\nRobin Wall Kimmerer, Braiding Sweetgrass, Milkweed Editions, 2013\r\n\r\nAna\u00efs Berck stands for a collaboration between people, algorithms and trees. As a collective, they open a space in which human intelligence is explored in company of plant intelligence and artificial intelligence.\r\n\r\nThis year Ana\u00efs Berck researches the idea of \u2019An Algoliterary Publishing House\u2019 in which the authors are algorithms, presented with their contexts and codes; and in which the content of the books seeds with trees and nature. This research in company of more-than-human presences brings Ana\u00efs Berck to highly charged territories at the intersection of botany, computationalism and publishing. There, the implications of Western ideology, the centrifugal force of archivism and extractivism are brought into focus.\r\n\r\nYou are welcome to join us at the opening of the installation in the window of Constant on Thursday 30 June 2022 from 18:00 on.\r\n\r\nThis installation constitutes a first public moment in this research in which we hope to formulate a beginning of an answer to questions such as: Who and what is excluded, made invisible or exploited in the existent representations, discourses, tools and practises? How can we restore their presences in histories and storytelling? How can we heal and transform ourselves, our tools, our practises, our relationships to the world, our legacies? How can we help to destabilize the centrifugal force in botany, computation and publishing? How can we make books, databases, algorithms visible as objects of doubts and how to go beyond their established forms?\r\n\r\nIn this installation Ana\u00efs Berck is represented by the humans An Mertens, Brendan Howell, Gijs de Heij, Guillaume Slizewicz; by the trees and plants whose spirits live in the herbarium collection of the Botanical Garde of Meise; and by a large set of scraping, analysing and generating algorithms.\r\n\r\nIn the framework of the window Ana\u00efs Berck will organise a workshop on 9 September 2022 to discuss the ideas, tools, materials around the installation.\r\n\r\nThis research is supported by FRArt (https:\/\/art-recherche.be)\r\n\r\nPS: Are you engaged with these questions and do you have some programming experience? Ana\u00efs Berck is looking for new collaborators! Please email for more information to anais@anaisberck.be.","performers":"Ana\u00efs Berck (artistic collective)","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.537233"},"de":{"name":"Une Maison d\u2019Edition Algolitt\u00e9raire 0.01","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.537233"},"it":{"name":"Une Maison d\u2019Edition Algolitt\u00e9raire 0.01","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.537233"},"sp":{"name":"Une Maison d\u2019Edition Algolitt\u00e9raire 0.01","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.537233"},"pt":{"name":"Une Maison d\u2019Edition Algolitt\u00e9raire 0.01","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.537233"},"cn":{"name":"Une Maison d\u2019Edition Algolitt\u00e9raire 0.01","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.537233"}},"place":{"id":243917,"translations":{"fr":{"name":"Constant asbl","address_street_name":"Rue du Fort","address_street_number":"5","address_street_box":null,"email":"info@constantvzw.org","website":"http:\/\/www.constantvzw.org","phone_contact":"+32 2 539 24 67","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue du Fort, 5","address_line2":"1060 Saint-Gilles","description_web":"Constant est une association sans but lucratif bas\u00e9e \u00e0 Bruxelles, active depuis 1997 dans les domaines de l\u2019art et des m\u00e9dias.\r\nConstant est un atelier interdisciplinaire qui se concentre sur la culture et l\u2019\u00e9thique du web. La pratique artistique de Constant est inspir\u00e9e par la fa\u00e7on avec laquelle les infrastructures technologiques, les \u00e9changes de donn\u00e9es et les logiciels d\u00e9terminent nos vies quotidiennes. Quelques chantiers importants sont le logiciel libre, les alternatives au copyright et le (cyber)f\u00e9minisme.\r\nDe fa\u00e7on r\u00e9guli\u00e8re Constant organise des ateliers, des print-parties, des balades, des performances, des lectures et des rencontres \u2018Verbindingen\/Jonctions\u2019 pour un public qui aime l\u2019exp\u00e9rimentation, la discussion et des \u00e9changes de toutes sortes.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Constant vzw","address_street_name":"Fortstraat","address_street_number":"5","address_street_box":null,"email":"info@constantvzw.org","website":"http:\/\/www.constantvzw.org","phone_contact":"+32 2 539 24 67","phone_booking":null,"address_zip":"1060","address_city":"Sint-Gillis","address_line1":"Fortstraat, 5","address_line2":"1060 Sint-Gillis","description_web":"Constant is een vereniging zonder winstoogmerk werkzaam in het gebied tussen kunst en media.\r\nHet is een interdisciplinaire werkplaats die zich bezighoudt met de cultuur en ethiek van het web. De artistieke praktijk van Constant wordt ge\u00efnspireerd door de manier waarop technologische infrastructuren, data-uitwisseling en software ons dagelijkse leven bepalen. Belangrijke werkterreinen zijn vrije software, alternatieven op auteursrecht en (cyber)feminisme.\r\nConstant organiseert regelmatig workshops, print-parties, wandelingen en \u2018Verbindingen\/Jonctions\u2019-bijeenkomsten voor een publiek dat houdt van experimenten, discussies en uitwisselingen allerhande.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Constant","address_street_name":"Rue du Fort","address_street_number":"5","address_street_box":null,"email":"info@constantvzw.org","website":"http:\/\/www.constantvzw.org","phone_contact":"+32 2 539 24 67","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue du Fort, 5","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Constant asbl","address_street_name":"Rue du Fort","address_street_number":"5","address_street_box":null,"email":"info@constantvzw.org","website":"http:\/\/www.constantvzw.org","phone_contact":"+32 2 539 24 67","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue du Fort, 5","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Constant asbl","address_street_name":"Rue du Fort","addre