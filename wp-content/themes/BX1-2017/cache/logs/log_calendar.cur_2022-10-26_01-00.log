 de passer aux aveux \u2026 \u00bb \r\n\r\n\r\n Spectacle d'improvisation (tout public) jou\u00e9 par : \r\n- Vincent Doms \r\n- Laurie Andrieu \r\n- Bertrand Daine","performers":"Vincent Doms, \r\nBertrand Daine, \r\nS\u00e9verine De Witte, \r\nLaurie Andrieu","boxoffice_url":null,"website":"http:\/\/www.letrac.be\/reservation","email":"info@letrac.be","phone_contact":"+32 470 50 04 75","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.540418"},"nl":{"name":"* Confidences * - Spectacle d'improvisation de V. Doms, B. Daine, S. De Witte & L. Andrieu","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.540418"},"en":{"name":"* Confidences * - Spectacle d'improvisation de V. Doms, B. Daine, S. De Witte & L. Andrieu","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.540418"},"de":{"name":"CONFIDENCES - Spectacle d'improvisation de V. Doms, B. Daine & L. Andrieu","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.540418"},"it":{"name":"CONFIDENCES - Spectacle d'improvisation de V. Doms, B. Daine & L. Andrieu","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.540418"},"sp":{"name":"CONFIDENCES - Spectacle d'improvisation de V. Doms, B. Daine & L. Andrieu","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_cont