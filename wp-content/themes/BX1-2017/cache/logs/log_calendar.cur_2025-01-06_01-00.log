5700002147,"date_start":"2025-01-14","date_end":"2025-02-13","date_next":"2025-01-14","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-10-04T12:07:03+02:00","published_at":"2024-10-04T12:06:02+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":309071,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"other","ranking":0.31833136784577337,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{}},"translations":{"de":{"name":"Vernissage de Pierre Moreau","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.maisondelafrancite.be\/?s=0000&p=536","email":"secretariat@maisondelafrancite.be","phone_contact":"+32 2 219 49 33","phone_booking":"+32 2 219 49 33","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700002147"},"pt":{"name":"Vernissage de Pierre Moreau","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.maisondelafrancite.be\/?s=0000&p=536","email":"secretariat@maisondelafrancite.be","phone_contact":"+32 2 219 49 33","phone_booking":"+32 2 219 49 33","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700002147"},"en":{"name":"Vernissage de Pierre Moreau","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.maisondelafrancite.be\/?s=0000&p=536","email":"secretariat@maisondelafrancite.be","phone_contact":"+32 2 219 49 33","phone_booking":"+32 2 219 49 33","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700002147"},"it":{"name":"Vernissage de Pierre Moreau","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.maisondelafrancite.be\/?s=0000&p=536","email":"secretariat@maisondelafrancite.be","phone_contact":"+32 2 219 49 33","phone_booking":"+32 2 219 49 33","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700002147"},"cn":{"name":"Vernissage de Pierre Moreau","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.maisondelafrancite.be\/?s=0000&p=536","email":"secretariat@maisondelafrancite.be","phone_contact":"+32 2 219 49 33","phone_booking":"+32 2 219 49 33","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700002147"},"fr":{"name":"Vernissage de Pierre Moreau","shortdescr":"PIERRE MOREAU\nFor\u00eats ador\u00e9es et arbres secrets\nInformations compl\u00e9mentaires\nVernissage : mardi 14 janvier 2025 \u00e0 partir de 18h","longdescr":"En 2009 l\u2019a.s.b.l. \"L\u2019Abri aux ifs\" accueille Hubert Nyssen (\u00e9crivain et fondateur de la c\u00e9l\u00e8bre maison d\u2019\u00e9dition Actes Sud \u00bb venu pr\u00e9senter son ouvrage \u00ab Le Nom de l\u2019Arbre \u00bb et propose \u00e0 Pierre Moreau d\u2019accompagner cette \"Causerie au coin du feu\" d\u2019une exposition d\u2019une dizaine de portraits photographiques d\u2019arbres. Ce fut l\u00e0 les premi\u00e8res photographies de paysages expos\u00e9es par Pierre Moreau.\n\nDepuis toujours, l'arbre est le symbole universel des cycles de la vie, de la force du vivant, du temps long, du lien de la terre avec le ciel et le cosmos.\n\nIncapable de d\u00e9placer son sujet dans son studio pour l\u2019\u00e9clairer comme il le veut, Pierre Moreau sort ses \u00e9clairages de studio et attends la tomb\u00e9 de la nuit pour \u00e9clairer chaque arbre choisi. Tr\u00e8s vite, il ressent le besoin d\u2019introduire une r\u00e9f\u00e9rence d\u2019\u00e9chelle animale ou humaine pour exprimer toute la majest\u00e9 de ces g\u00e9ants. \n\n- - - - -\n\nL\u2019art de Pierre Moreau est \u00e0 la fois po\u00e9sie et photographie. De sa longue pratique dans la mode et la publicit\u00e9, il a acquis une ma\u00eetrise technique hors du commun. De la rencontre avec des artistes comme Olivier Strebelle, il a aiguis\u00e9 la perception po\u00e9tique des formes, des mouvements, des lumi\u00e8res dans l'\u0153uvre du sculpteur.\n\nAujourd\u2019hui, comme livr\u00e9 \u00e0 lui-m\u00eame, on serait tent\u00e9 d\u2019\u00e9crire \"d\u00e9livr\u00e9\" \u00e0 lui-m\u00eame, Moreau explore la dimension po\u00e9tique de son regard. Qu\u2019il le porte sur les friches industrielles tagu\u00e9es, \u00e0 la lisi\u00e8re matinale des for\u00eats ou dans le soleil si particulier de Saint-Idesbald, sur les rivages dunaires de la mer du Nord, l\u2019objectif de Moreau capte, au moment de la prise de vue, l\u2019\u00e9motion esth\u00e9tique essentielle. Usant ensuite de toute la palette de la technologie num\u00e9rique, l\u2019artiste d\u00e9ploie un univers esth\u00e9tique qui nous trouble parce qu\u2019il est \u00e0 la fois ce que l\u2019il a vu et ce que le c\u0153ur a ressenti.\n\nDans chacune de ses photos, le spectateur reconna\u00eet une musique, un souvenir, un sentiment qui lui semblent familiers et pourtant r\u00e9v\u00e9l\u00e9s \u00e0 nouveau. N\u2019est-ce pas cela la po\u00e9sie ? Une \u00e9motion dans laquelle nous nous lovons comme dans le cercle familier de sentiments que nous croyions oubli\u00e9s et qui, pour surgir \u00e0 nouveau, ne demandaient qu\u2019\u00e0 \u00eatre sollicit\u00e9s ?\n\nL\u2019art photographique de Moreau est de l\u2019ordre du paysage po\u00e9tique : on le contemple \u00e0 jamais sans parvenir \u00e0 en \u00e9puiser les variations, les ciels, les saisons.\n\n\n                                                                                 Edmond Morrel (Espace-livres.be)","performers":"Pierre Moreau","boxoffice_url":null,"website":"https:\/\/www.maisondelafrancite.be\/?s=0000&p=536","email":"secretariat@maisondelafrancite.be","phone_contact":"+32 2 219 49 33","phone_booking":"+32 2 219 49 33","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700002147"},"sp":{"name":"Vernissage de Pierre Moreau","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.maisondelafrancite.be\/?s=0000&p=536","email":"secretariat@maisondelafrancite.be","phone_contact":"+32 2 219 49 33","phone_booking":"+32 2 219 49 33","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700002147"},"nl":{"name":"Vernissage de Pierre Moreau","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.maisondelafrancite.be\/?s=0000&p=536","email":"secretariat@maisondelafrancite.be","phone_contact":"+32 2 219 49 33","phone_booking":"+32 2 219 49 33","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700002147"}},"place":{"id":332,"translations":{"de":{"name":"Maison de la Francit\u00e9","address_street_name":"Rue Joseph II","address_street_number":"18","address_street_box":null,"email":"mdlf@maisondelafrancite.be","website":"http:\/\/www.maisondelafrancite.be","phone_contact":"+32 2 219 49 33","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Joseph II, 18","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Maison de la Francit\u00e9","address_street_name":"Rue Joseph II","address_street_number":"18","address_street_box":null,"email":"mdlf@maisondelafrancite.be","website":"http:\/\/www.maisondelafrancite.be","phone_contact":"+32 2 219 49 33","phone_booking":null,"address_zip":"1000