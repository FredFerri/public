Personas sordas o con problemas de audici\u00f3n","LGTBQIA","Personas de la tercera edad","J\u00f3venes de 15 a 18 a\u00f1os","Profesores","Escuelas"],"nl":["Familie","Doof\/slechthorend","LGTBQIA","Senioren","Jongeren 15-18 j.","Leerkrachten","Scholen"]}},"educational_targets":{"list":[],"translations":{}},"tags":["kids"],"opening":{"day":"2024-11-14","end":"21:00:00","start":"18:00:00","timestamp":"2024-11-14T18:00:00"}},{"id":50011013,"date_start":"2024-09-12","date_end":"2024-11-30","date_next":"2024-11-22","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-11-22T01:00:47+01:00","published_at":"2024-05-29T12:29:47+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":300734,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"tour","ranking":0.2924017738212866,"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{"list":[251],"translations":{"de":["Zeitgen\u00f6ssische Kunst "],"pt":[null],"en":["Contemporary Art"],"it":["Arte contemporanea "],"cn":[null],"fr":["Art Contemporain "],"sp":["Arte contempor\u00e1neo "],"nl":["Hedendaagse Kunst"]}}},"translations":{"de":{"name":"Emmanuelle Castellan \"Spektrum\" : visites guid\u00e9es","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/fondationdentreprisehermes.org","email":"laverriere@hermes.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50011013"},"pt":{"name":"Emmanuelle Castellan \"Spektrum\" : visites guid\u00e9es","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/fondationdentreprisehermes.org","email":"laverriere@hermes.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50011013"},"en":{"name":"Guided tour  \u00ab Esperluette \u00bb","shortdescr":null,"longdescr":"\u201cSpektrum\u201d, Joel Riff\u2019s fifth exhibition as curator at La Verriere, reveals the paintings of Emmanuelle Castellan. The show fans out across the exhibition space, revealing the unseen, creating backdrops and screens. Constructed as much by addition as by subtraction, her pictorial script superimposes layers and their erasures.\nSurfaces remain, floating between loose and stretched canvases, whilst their very epidermis has been cut away to better carry the second dimension into the third. From panel to phantom, from appearance to scale, from filter to memory, the polysemy of the spectrum multiplies access to a gracious production, striving to welcome that which beckons. Mastery is achieved through the freedom to receive. This is evidenced by compositions that allow themselves to be surprised in their latency.\n\nA certain passivity allows things to emanate, sometimes slowly, away from any dogmatism. The hanging allows for an ambitious deployment of the canvases within the volume of the Foundation\u2019s Brussels space, propelling the amplitude of new paintings to an unprecedented scale. Their association with the painters Norbert Schwontkowski (1949-2013) and Walter Swennen (b. 1946) creates a clear filiation, completed by the ceramics of Johannes Nagel (b. 1979), the mirrors of Dagobert Peche (1887-1923) and the words of Muriel Pic (b. 1974).\n\nThis impetus takes shape outside France \u2013 where the artist was born and teaches \u2013 and Germany \u2013 where she is based. The programme thus resumes its series of first solo presentations in Brussels, giving Emmanuelle Castellan\u2019s painting an unprecedented scope.","performers":"A guide is present every day to allow direct interaction with the public. Guided tours, without registration. \n- In French or English from Tuesday to Friday at 12:30 p.m. and Saturday at 3 p.m.;\n- In Dutch only on Tuesdays, at 12:30 p.m.\n","boxoffice_url":null,"website":"http:\/\/fondationdentreprisehermes.org","email":"laverriere@hermes.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50011013"},"it":{"name":"Emmanuelle Castellan \"Spektrum\" : visites guid\u00e9es","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/fondationdentreprisehermes.org","email":"laverriere@hermes.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50011013"},"cn":{"name":"Emmanuelle Castellan \"Spektrum\" : visites guid\u00e9es","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/fondationdentreprisehermes.org","email":"laverriere@hermes.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50011013"},"fr":{"name":"Visite guid\u00e9e \u00ab Esperluette \u00bb","shortdescr":"Con\u00e7u comme une exp\u00e9rience visuelle, l\u2019exposition \u00abEsperluette\u00bb peut se vivre gr\u00e2ce \u00e0 un m\u00e9diateur culturel qui propose au public  des visites comment\u00e9es sans r\u00e9servation.","longdescr":"Sixi\u00e8me exposition de Jo\u00ebl Riff en tant que commissaire de La Verri\u00e8re, \u00abEsperluette\u00bb affirme la dynamique collaborative en jeu dans la production d\u2019H\u00e9l\u00e8ne Bertin. Ses formes naissent de rencontres. L\u2019artiste cultive un app\u00e9tit d\u2019apprentissage par l\u2019exp\u00e9rience partag\u00e9e, fa\u00e7onnant les choses \u00e0 plusieurs. Chaque \u0153uvre d\u00e9coule de conversations durant lesquelles faire et \u00e9changer fonctionnent de concert. Avec une grande attention port\u00e9e aux origines des mat\u00e9riaux et des gestes, l\u2019artiste conforte depuis une dizaine d\u2018ann\u00e9es une vaste recherche sculpturale qui ne vient jamais seule, ni de nulle part.\nL\u2019esperluette \u00ab&\u00bb est ce caract\u00e8re typographique qui majore la conjonction de coordination \u00abet\u00bb au point d\u2019en fusionner les deux lettres. Elle aurait \u00e9t\u00e9 une lettre \u00e0 part enti\u00e8re de l\u2019alphabet fran\u00e7ais et rel\u00e8ve aujourd\u2019hui davantage d\u2019une fantaisie visuelle et lexicale attestant par sa ligature le lien fondamental entre deux personnes. Le glyphe r\u00e9sume ainsi la m\u00e9thode de travail d\u2019H\u00e9l\u00e8ne Bertin aussi bien que la relation \u00e0 construire entre une artiste et un commissaire.\nDe mani\u00e8re g\u00e9n\u00e9rale, il r\u00e9capitule les enjeux du solo augment\u00e9 dont le format rythme le programme de La Verri\u00e8re depuis bient\u00f4t deux ans.\nL\u2019accrochage \u00e0 Bruxelles rendra public le fruit d\u2019un an de r\u00e9sidence \u00e0 la Villa M\u00e9dicis, \u00e0 Rome, o\u00f9 H\u00e9l\u00e8ne Bertin (n\u00e9e en 1989) est actuellement pensionnaire. La Fondation d\u2019entreprise Herm\u00e8s active ainsi une circulation europ\u00e9enne de l\u2019Italie\n\u00e0 la Belgique dans le cadre d\u2019une coop\u00e9ration institutionnelle in\u00e9dite. Pour l\u2019occasion, l\u2019artiste \u00e9veille des collaborations avec la charpenti\u00e8re marine Anne Blan\u00e8s (n\u00e9e en 1981), la cultivatrice de fleurs Aline Cado (n\u00e9e en 1992), la compositrice Marion Cousin (n\u00e9e en 1983), la poti\u00e8re Caroline Nussbaumer (n\u00e9e en 1979) et la teinturi\u00e8re v\u00e9g\u00e9tale Lola Verstrepen (n\u00e9e en 1993), sans emp\u00eacher d\u2019autres intuitions de surgir d\u2019ici l\u2019inauguration de l\u2019exposition. Il s\u2019agit pour H\u00e9l\u00e8ne Bertin d\u2019une premi\u00e8re monographie en Belgique, et \u00e0 l\u2019\u00e9tranger tout simplement.","performers":"Un m\u00e9diateur est pr\u00e9sent chaque jour pour permettre une interaction directe avec le public.Visites comment\u00e9es, sans inscription. \n- En fran\u00e7ais ou en anglais du mardi au vendredi \u00e0 12h30 et le samedi \u00e0 15h ;\n- En n\u00e9erlandais uniquement les mardis, \u00e0 12h30.\n\n","boxoffice_url":null,"website":"http:\/\/fondationdentreprisehermes.org","email":"laverriere@hermes.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50011013"},"sp":{"name":"Emmanuelle Castellan \"Spektrum\" : visites guid\u00e9es","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/fondationdentreprisehermes.org","email":"laverriere@hermes.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50011013"},"nl":{"name":"Rondleiding \u00ab Esperluette \u00bb","shortdescr":"Conceptualized as a visual journey, \"Spektrum\" can be experienced  with a guide who can offer you a visit without reservations. ","longdescr":"\u2018Spektrum\u2019, de vijfde tentoonstelling van Jo\u00ebl Riff als curator bij La Verri\u00e8re, richt de schijnwerpers op het oeuvre van Emmanuelle Castellan. De expo waaiert uit over de hele ruimte van La Verri\u00e8re, waarbij ze het ongeziene zichtbaar maakt tegen de achtergrond van nieuw gecre\u00eberde decors. Castellans schilderkunstige praktijk draait om toevoegen \u00e9n weghalen, ze bouwt lagen op en wist ze weer uit. Wat overblijft zijn oppervlakken, zwevend tussen losse en opgespannen doeken, terwijl hun opperlaag is weggesneden om de tweede dimensie beter te laten overgaan in de derde.\n\nVan paneel tot schimmig beeld, van verschijning tot schaal, van filter tot herinnering; door de veelzijdigheid van het spectrum zijn er verschillende manieren om haar gracieuze creaties te benaderen. Meesterschap wordt hier bereikt door de vrijheid om te ontvangen, waarbij composities zelf versteld staan van hun inherente potentieel. Een zekere passiviteit laat ruimte voor ontwikkeling, soms langzaam, weg van rigide dogmatisme.\n\nDe opstelling van de werken maakt een gedurfde interactie mogelijk tussen de doeken en de ruimte van de Fondation d\u2019entreprise Herm\u00e8s in Brussel, waardoor de nieuwe schilderijen tot ongekende proporties worden opgeschaald. Uit de dialoog met werken van Norbert Schwontkowski (1949-2013) en Walter Swennen (1946) komt een duidelijke verwantschap naar voren, aangevuld met het keramiek van Johannes Nagel (1979), de spiegels van Dagobert Peche (1887-1923) en de woorden van Muriel Pic (1974). En dat allemaal buiten de landsgrenzen van Frankrijk waar de kunstenares geboren werd en nog steeds lesgeeft, of in Duitsland, waar ze nu woont en werkt. Voor Emmanuelle Castellan is dit haar eerste solotentoonstelling in Brussel en daarmee maakt deze expo deel uit van een langere reeks eerste solo\u2019s in La Verri\u00e8re.\n\n","performers":null,"boxoffice_url":null,"website":"http:\/\/fondationdentreprisehermes.org","email":"laverriere@hermes.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50011013"}},"place":{"id":236592,"translations":{"de":{"name":"La Verri\u00e8re","address_street_name":"Boulevard de Waterloo","address_street_number":"50","address_street_box":null,"email":"laverriere.mediation@ext.hermes.com","website":"http:\/\/www.fondationdentreprisehermes.org","phone_contact":"+ 32 (0)2-511.20.62","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Boulevard de Waterloo, 50","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"La Verri\u00e8re","address_street_name":"Boulevard de Waterloo","address_street_number":"50","address_street_box":null,"email":"laverriere.mediation@ext.hermes.com","website":"http:\/\/www.fondationdentreprisehermes.org","phone_contact":"+ 32 (0)2-511.20.62","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Boulevard de Waterloo, 50","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"La Verri\u00e8re","address_street_name":"Waterloolaan","address_street_number":"50","address_street_box":null,"email":"laverriere.mediation@ext.hermes.com","website":"http:\/\/www.fondationdentreprisehermes.org\/fr","phone_contact":"+32 2 511 20 62","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Waterloolaan, 50","address_line2":"1000 Brussels","description_web":"\u201cThe Fondation d\u2019entreprise Herm\u00e8s has provided long-term support for the visual arts through a programme of exhibitions conceived by curators attentive to both France\u2019s contemporary art scene and the presentation of work by French artists abroad, whether they are at the start of their careers or more established figures. Unfolding across the Foundation\u2019s four dedicated spaces in Europe and Asia, these exhibitions often feature new work and constitute broad artistic gestures that the public are invited to discover.\n \nLa Verri\u00e8re in Brussels, curated by Jo\u00ebl Riff, is a place that play host to projects specially conceived by invited artists. The Foundation closely accompanies every step of the creative process, and supports the development of original approaches and artistic gestures, from their production stages through to their presentation to the public.\u201d\n","description_print":null,"booking_url":null,"sort_order":"VERRI\u00c8RE","virtual_visit":null,"visit_url":null},"it":{"name":"La Verri\u00e8re","address_street_name":"Boulevard de Waterloo","address_street_number":"50","address_street_box":null,"email":"laverriere.mediation@ext.hermes.com","website":"http:\/\/www.fondationdentreprisehermes.org","phone_contact":"+ 32 (0)2-511.20.62","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Boulevard de Waterloo, 50","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"La Verri\u00e8re","address_street_name":"Boulevard de Waterloo","address_street_number":"50","address_street_box":null,"email":"laverriere.mediation@ext.hermes.com","website":"http:\/\/www.fondationdentreprisehermes.org","phone_contact":"+ 32 (0)2-511.20.62","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Boulevard de Waterloo, 50","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"La Verri\u00e8re","address_street_name":"Boulevard de Waterloo","address_street_number":"50","address_street_box":null,"email":"laverriere.mediation@ext.hermes.com","website":"http:\/\/www.fondationdentreprisehermes.org","phone_contact":"+ 32 (0)2-511.20.62","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Boulevard de Waterloo, 50","address_line2":"1000 Bruxelles","description_web":"\"La Fondation d'entreprise Herm\u00e8s soutient durablement les arts visuels \u00e0 travers un programme d'expositions con\u00e7ues par des commissaires attentifs \u00e0 la fois \u00e0 la sc\u00e8ne artistique contemporaine fran\u00e7aise et \u00e0 la pr\u00e9sentation d'\u0153uvres d'artistes fran\u00e7ais \u00e0 l'\u00e9tranger, qu'ils soient en d\u00e9but de carri\u00e8re ou plus confirm\u00e9s. D\u00e9ploy\u00e9es dans les quatre espaces d\u00e9di\u00e9s de la Fondation en Europe et en Asie, ces expositions pr\u00e9sentent souvent des \u0153uvres in\u00e9dites et constituent des gestes artistiques d'envergure que le public est invit\u00e9 \u00e0 d\u00e9couvrir.\n \nLa Verri\u00e8re \u00e0 Bruxelles, sous le commissariat de Jo\u00ebl Riff, est un lieu qui accueille des projets sp\u00e9cialement con\u00e7us par les artistes invit\u00e9s. La Fondation accompagne de pr\u00e8s toutes les \u00e9tapes du processus de cr\u00e9ation et soutient le d\u00e9veloppement de d\u00e9marches et de gestes artistiques originaux, depuis leur production jusqu'\u00e0 leur pr\u00e9sentation au public\".\n","description_print":null,"booking_url":null,"sort_order":"VERRI\u00c8RE","virtual_visit":null,"visit_url":null},"sp":{"name":"La Verri\u00e8re","address_street_name":"Boulevard de Waterloo","address_street_number":"50","address_street_box":null,"email":"laverriere.mediation@ext.hermes.com","website":"http:\/\/www.fondationdentreprisehermes.org","phone_contact":"+ 32 (0)2-511.20.62","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Boulevard de Waterloo, 50","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"La Verri\u00e8re","address_street_name":"Waterloolaan","address_street_number":"50","address_street_box":null,"email":"laverriere.mediation@ext.hermes.com","website":"http:\/\/www.fondationdentreprisehermes.org","phone_contact":"+ 32 (0)2-511.20.62","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Waterloolaan, 50","address_line2":"1000 Brussel","description_web":"De Verri\u00e8re-Herm\u00e8s die in 2000 werd opgericht, maakt deel uit van het internationale netwerk van galerijen van de Fondation d\u2019entreprise Herm\u00e8s. Deze Stichting steunt projecten die een echo vormen van het universum van het huis Herm\u00e8s: opwaardering voor ambachtelijke kennis en steun aan creativiteit, betrokkenheid bij onderwijs en bij het milieu. De Stichting ontwikkelt haar eigen programma's: tentoonstellingen en artiestenresidenties voor de plastische kunsten, Prix Emile Herm\u00e8s voor design, knowhow-academie, oproepen voor projecten rond biodiversiteit. In het raam van haar mecenaat produceert en promoot la Verri\u00e8re elk jaar vier expo\u2019s van hedendaagse kunst, gekoppeld aan designpresentaties. Voor elke tentoonstelling wordt een kleine catalogus gepubliceerd","description_print":null,"booking_url":null,"sort_order":"VERRI\u00c8RE","virtual_visit":null,"visit_url":null}},"districts":{"list":[10],"translations":{"de":["Louise"],"pt":[null],"en":["Louise"],"it":["Louise"],"cn":[null],"fr":["Louise"],"sp":["Louise"],"nl":["Louiza"]}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":"art_center","facebook_id":null,"backoffice_id":1572,"location":{"lat":50.8369255,"lon":4.3564729},"region":"brussels","last_updated_at":"2024-08-23T09:06:51+02:00","published_at":"2013-10-19T01:14:27+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":236592,"translations":{"de":{"name":"La Verri\u00e8re","address_street_name":"Boulevard de Waterloo","address_street_number":"50","address_street_box":null,"email":"laverriere.mediation@ext.hermes.com","website":"http:\/\/www.fondationdentreprisehermes.org","phone_contact":"+ 32 (0)2-511.20.62","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Boulevard de Waterloo, 50","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"La Verri\u00e8re","address_street_name":"Boulevard de Waterloo","address_street_number":