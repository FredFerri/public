4,7],"translations":{"fr":["Pop, rock, jazz\u2026","Pop, Rock"],"nl":["Pop, rock, jazz\u2026","Pop, Rock"],"en":["Pop, rock, jazz\u2026","Pop, Rock"],"de":["Pop, Rock, Jazz...","Pop, Rock"],"it":["Pop, rock, jazz\u2026","Pop, Rock"],"sp":["Pop, rock, jazz\u2026","Pop, rock"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Ways Around 2023 | DAY 1","shortdescr":"Le Ways Around festival revient pour un round #2.\r\nLe nouveau festival alternatif bruxellois se tiendra les 31 mars, 1 et 2 avril 2023 dans trois nouveaux lieux incontournables de Bruxelles: Le Lac, La Vall\u00e9e et Le Cirque Royal.","longdescr":"Le line-up du premier jour du Ways Around festival promet de transformer Le Lac en v\u00e9ritable fournaise. En ouverture, c\u2019est un groupe 100% f\u00e9minin et endiabl\u00e9 qui ouvrira les trois jours de festivit\u00e9s : MADAM. Montera ensuite sur sc\u00e8ne le collectif bruxellois THOT, un des fers de lance du post-rock industriel en Belgique.\r\nLa t\u00eate d\u2019affiche de cette premi\u00e8re soir\u00e9e finira de mettre le feu au public : The St. Pierre Snake Invasion. Venu de Bristol (Angleterre), le quintet fait partie des groupes qui ont propuls\u00e9 le post-punk\/rock anglais sur le devant de la sc\u00e8ne, au m\u00eame titre que IDLES. Justement, il est \u00e0 relever que le chanteur de The Saint Pierre Snake Invasion a un side project avec des membres de IDLES sous le nom de \u00ab The Plainviews \u00bb.\r\n\r\nInfos et tickets sur www.waysaround.be","performers":"Madam; Thot ; The St. Pierre Snake Invasion","boxoffice_url":null,"website":"http:\/\/www.waysaround.be","email":"jesus@waysaround.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.553524"},"nl":{"name":"Ways Around 2023 | DAY 1","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.waysaround.be","