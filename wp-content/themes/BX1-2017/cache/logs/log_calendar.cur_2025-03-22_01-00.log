":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":308658,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"other","ranking":0.239821067139974,"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exposici\u00f3n","nl":"Tentoonstellingen"}},"others":{}},"translations":{"de":{"name":"Pre-architectures","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700001896"},"pt":{"name":"Pre-architectures","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700001896"},"en":{"name":"Pre-architectures","shortdescr":"Envision a world without architecture, a world-tecture without arche, the latter meaning not only beginning or origin, but also the authority to arrange and subordinate persons, objects, and processes into an identifiable power structure.","longdescr":"Envision a world without architecture, a world-tecture without arche, the latter meaning not only beginning or origin, but also the authority to arrange and subordinate persons, objects, and processes into an identifiable power structure.\n\nPre-architecture is not simply \"not architecture\"\u2013it is what architecture could have become, but ultimately disavowed. The same unfulfilled potentialities haunt not only the distant past but also architecture's anxious present in a time of environmental crisis, energetic transformation and related social challenges.\n\nWith the participation of a transdisciplinary field of architects, artists, sociologists and archeologists, the exhibition pre-architectures critically unveils how the study of prehistory might uncover not only causes of modernity\u2019s present crisis, but also signs of architecture\u2019s future past. Referring to the beginnings of human habitat and the \u201cbirth\u201d of design, the exhibition speculates about the cultural, social, economic and political foundations of spatial organization.\n\nWith works by: Kader Attia, Mariana Castillo Deball, Jacques Gillet, Hans Hollein, Frederick Kiesler, Gianni Pettena, Ettore Sottsass, Anton Vidokle & Pelin Tan, Paulo Tavares, David Wengrow & Eyal Weizman with Forensic Architecture","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700001896"},"it":{"name":"Pre-architectures","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700001896"},"cn":{"name":"Pre-architectures","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700001896"},"fr":{"name":"Pre-architectures","shortdescr":"Imaginez un monde sans architecture, une -tecture mondiale sans arche \u2013 arche dans le sens de d\u00e9but ou d\u2019origine, mais aussi d\u2019autorit\u00e9 qui organise et subordonne les personnes, les objets et les processus dans une structure de pouvoir identifiable.       \n\n","longdescr":"Imaginez un monde sans architecture, une -tecture mondiale sans arche \u2013 arche dans le sens de d\u00e9but ou d\u2019origine, mais aussi d\u2019autorit\u00e9 qui organise et subordonne les personnes, les objets et les processus dans une structure de pouvoir identifiable.       \n\nLa pr\u00e9-architecture n\u2019est pas simplement la \u00ab non-architecture \u00bb, c\u2019est ce que l\u2019architecture aurait pu devenir, mais qui a finalement \u00e9t\u00e9 d\u00e9savou\u00e9. Les m\u00eames potentialit\u00e9s inaccomplies hantent le lointain pass\u00e9 et le pr\u00e9sent angoissant de l\u2019architecture \u00e0 une \u00e9poque de crise environnementale, de transformation \u00e9nerg\u00e9tique et de d\u00e9fis sociaux.\n\nAvec la participation d\u2019une \u00e9quipe transdisciplinaire d\u2019architectes, d\u2019artistes, de sociologues et d\u2019arch\u00e9ologues, l\u2019exposition pre-architectures d\u00e9voile de fa\u00e7on critique la mani\u00e8re dont l\u2019\u00e9tude de la pr\u00e9histoire pourrait mettre au jour les causes de la crise actuelle de la modernit\u00e9, et les signes du futur pass\u00e9 de l\u2019architecture. Faisant r\u00e9f\u00e9rence aux d\u00e9buts de l\u2019habitat humain et \u00e0 la \u00ab naissance \u00bb du design, l\u2019exposition pr\u00e9sume des fondements culturels, sociaux, \u00e9conomiques et politiques de l\u2019organisation de l\u2019espace.\n\nAvec des \u0153uvres de : Kader Attia, Mariana Castillo Deball, Jacques Gillet, Hans Hollein, Frederick Kiesler, Gianni Pettena, Ettore Sottsass, Anton Vidokle & Pelin Tan, Paulo Tavares, David Wengrow & Eyal Weizman avec Forensic Architecture.  ","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700001896"},"sp":{"name":"Pre-architectures","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700001896"},"nl":{"name":"Pre-architectures","shortdescr":"Stel je een wereld voor zonder architectuur, een wereld-tectuur zonder arche, waarbij dat laatste niet alleen begin of oorsprong betekent, maar ook de autoriteit om personen, objecten en processen te schikken in en ondergeschikt te maken aan een identificeerbare machtsstructuur.","longdescr":"Stel je een wereld voor zonder architectuur, een wereld-tectuur zonder arche, waarbij dat laatste niet alleen begin of oorsprong betekent, maar ook de autoriteit om personen, objecten en processen te schikken in en ondergeschikt te maken aan een identificeerbare machtsstructuur.\n\nPre-architectuur is niet simpelweg \u201cgeen architectuur\u201d \u2013 het is wat architectuur had kunnen worden, maar uiteindelijk niet werd. Dezelfde onvervulde mogelijkheden spoken niet alleen door het verre verleden, maar ook door het onzekere heden van de architectuur met zijn milieucrisis, energietransitie en daarmee gepaard gaande maatschappelijke uitdagingen.\n\nMet medewerking van een transdisciplinair veld van architecten, kunstenaars, sociologen en archeologen, onthult de tentoonstelling pre-architectures op kritische wijze hoe de studie van de prehistorie niet alleen oorzaken van de huidige crisis van de moderniteit kan blootleggen, maar ook sporen van het toekomstig verleden van de architectuur. Verwijzend naar de oorsprong van de menselijke habitat en de \u201cgeboorte\u201d van ontwerp en vormgeving, speculeert de tentoonstelling over de culturele, sociale, economische en politieke fundamenten van de ruimtelijke organisatie.\n\nMet werken van Kader Attia, Mariana Castillo Deball, Jacques Gillet, Hans Hollein, Frederick Kiesler, Gianni Pettena, Ettore Sottsass, Anton Vidokle & Pelin Tan, Paulo Tavares, David Wengrow & Eyal Weizman met Forensic Architecture. ","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700001896"}},"place":{"id":235577,"translations":{"de":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+ 32 (0)2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"Das Architekturzentrum CIVA, das 2016 auf Betreiben der Region Br\u00fcssel-Hauptstadt ins Leben gerufen wurde, vereint in einer einzigen Struktur Ressourcen, Wissen und Know-how verschiedener Br\u00fcsseler Vereine aus dem Bereich Kultur, Architektur, St\u00e4dteplanung, Landschaftsarchitektur und Forschungen zum \u00d6kosystem: die Archive f\u00fcr moderne Architektur, die Bibliothek Ren\u00e9 Pech\u00e8re, der Architekturfonds und das Centre Paul Duvigneaud.\r\nMit ihrem kulturellen Projekt tr\u00e4gt die Fondation CIA zur Entwicklung einer architektonischen, landschaftsarchitektonischen und st\u00e4dteplanerischen Kultur bei, die sich mit den Herausforderungen der Gegenwart auseinandersetzt. Schwerpunkt ist Br\u00fcssel. \r\n\r\nDie Fondation CIVA bietet eine ganze Reihe von Aktivit\u00e4ten und Angeboten: Ausstellungen, Konferenzen, Orte des Austauschs und der Debatten, p\u00e4dagogische Aktivit\u00e4ten, Archiveinblicke und Bibliotheken mit knapp 40.000 Werken und Zeitschriften zu den Themen Architektur, St\u00e4dteplanung, Stadtgeschichte, Landschaften, G\u00e4rten und urbane \u00d6kosysteme.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+ 32 (0)2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+ 32 (0)2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"CIVA is a museum, an archive center, a library and a meeting place for lovers of architecture, landscape architecture, urban ecosystems and history in Brussels. Throughout the year, CIVA organizes temporary exhibitions, lectures, debates, guided tours, book launches and activities for children. The activities are organized in Ixelles, near Place Flagey and in the center of Brussels, in KANAL - Centre Pompidou.","description_print":null,"booking_url":null,"sort_order":"CIVA","virtual_visit":null,"visit_url":null},"it":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+ 32 (0)2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+ 32 (0)2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+ 32 (0)2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"CIVA est un muse\u0301e, un centre d'archives, une bibliothe\u0300que et un lieu de rencontre pour les amateurs d'architecture, d'architecture paysage\u0300re, d'e\u0301cosyste\u0300mes urbains et d'histoire a\u0300 Bruxelles. Tout au long de l'anne\u0301e, vous pouvez vous y rendre pour des expositions temporaires, des confe\u0301rences, des de\u0301bats, des visites guide\u0301es, des lancements de livres et des activite\u0301s pour les enfants. Les activite\u0301s se trouvent a\u0300 Ixelles, pre\u0300s de la Place Flagey et au centre de Bruxelles, a\u0300 KANAL - Centre Pompidou.\r\n\r\n","description_print":null,"booking_url":null,"sort_order":"CIVA","virtual_visit":null,"visit_url":null},"sp":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+ 32 (0)2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"Creado en 2016 por iniciativa de la Regi\u00f3n Bruselas-Capital, el CIVA re\u00fane una \u00fanica estructura de recursos, conocimiento y aprendizaje de varias asociaciones culturales activas en Bruselas en los campos de la arquitectura, urbanismo, paisajes y el estudio de ecosistemas: los Archivos de Arquitectura Moderna, la Biblioteca Ren\u00e9 Pech\u00e8re, los Fondos para la arquitectura, el Centro Paul Duvigneaud y el CIVA asbl, ahora disuelto.\r\nA trav\u00e9s de este proyecto cultural, la Fundaci\u00f3n CIVA contribuye al desarrollo del paisaje arquitect\u00f3nico y la cultura urbana como base para afrontar desaf\u00edos contempor\u00e1neos, poniendo especial \u00e9nfasis en Bruselas.\r\nSiempre tiene \u00e9xito a la hora de cumplir sus objetivos y tratar con un p\u00fablico amplio (adultos y ni\u00f1os, estudiantes, investigadores, arquitectos, paisajistas, amantes de la naturaleza, pol\u00edticos, etc), la fundaci\u00f3n CIVA organiza numerosos eventos y actividades en diferentes lugares, incluyendo exhibiciones permanentes y temporales, conferencias, debates y actividades educativas. Tambi\u00e9n dispone archivos excepcionales abiertos para todos los p\u00fablicos (documentos de arquitectos y paisajistas: planos, bocetos, modelos, muebles, etc.) y librer\u00edas que contienen casi 40.000 obras y peri\u00f3dicos de arquitectura, urbanismo, la historia de los pueblos y ciudades, paisajes, jardines y ecolog\u00eda urbana.\r\nEstas actividades y materiales est\u00e1n dise\u00f1ados para despertar la curiosidad y el inter\u00e9s de todo nuestro entorno, ya sea un hecho hist\u00f3rico o una construcci\u00f3n.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"CIVA","address_street_name":"Kluisstraat","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+ 32 (0)2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"Kluisstraat","address_line2":"1050 Elsene","description_web":"CIVA is een museum, een archiefcentrum, een bibliotheek en een ontmoetingsplek voor liefhebbers van architectuur, landschapsarchitectuur, stadsecosystemen en geschiedenis in Brussel. Het hele jaar door kan je er terecht voor tijdelijke tentoonstellingen, lezingen, debatten, rondleidingen, book launches en kinderactiviteiten. De activiteiten vind je in Elsene, vlakbij het Flageyplein en in Brussel-centrum, in KANAL \u2013 Centre Pompidou.","description_print":null,"booking_url":null,"sort_order":"CIVA","virtual_visit":null,"visit_url":null}},"districts":{"list":[5],"translations":{"