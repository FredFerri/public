 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700006494"},"it":{"name":"BANAD Festival - Guided tour of the Ajoux House","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700006494"},"cn":{"name":"BANAD Festival - Guided tour of the Ajoux House","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700006494"},"fr":{"name":"BANAD Festival - Maison Ajoux","shortdescr":null,"longdescr":"Situ\u00e9e dans le quartier des fleurs \u00e0 Schaerbeek, cette belle villa \u00e0 trois fa\u00e7ades de style Art d\u00e9co tardif est dessin\u00e9e par l'architecte Ren\u00e9 Ajoux, en 1935. Sa conception tr\u00e8s originale est \u00e9tablie sur la forme du cercle que l'on retrouve aussi bien dans la forme des pi\u00e8ces que de nombreux \u00e9l\u00e9ments de la maison (luminaires, cage d'escalier, etc). \n\nArch. Ren\u00e9 AJOUX, 1935","performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700006494"},"sp":{"name":"BANAD Festival - Guided tour of the Ajoux House","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700006494"},"nl":{"name":"BANAD F