Wallonie, notamment dans le cadre du championnat adulte de la FBIA.\r\n\r\n\r\n-------`\r\nINFOS PRATIQUES\r\nLieu : Le TRAC\r\nAdresse : 110, rue Albert Meunier- Auderghem\r\nSpectacle \u00e0 11h\r\nR\u00c9SERVATIONS (vivement conseill\u00e9es)\r\nvia le lien du Trac : https:\/\/www.letrac.be\/reservations\r\nTARIFS\r\n- Sur r\u00e9servation : 7\u20ac\/personne \r\n- Sur place : 8\u20ac\/personne\r\nPlace offerte au parent accompagnant minimum 3 enfants \r\nPlaces offertes pour les enfants jusque 5 ans","performers":"L'\u00e9quipe des Laconiques Anonymes !\r\n\r\nAvec : Fanny, Vincent, Zo\u00e9, Bruno, St\u00e9phanie, S\u00e9bastien, Genevi\u00e8ve, Denis, Ga\u00eblle, Jimmy, Giselle, Martin, Patricia, Alex et Laureen","boxoffice_url":null,"website":null,"email":"info@letrac.be","phone_contact":"+32 470 50 04 75","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.546818"},"nl":{"name":"RACONTE MOI TON R\u00caVE - Spectacle pour enfants (\u00e0 partir de 5 ans) et leurs parents","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.546818"},"en":{"name":"RACONTE MOI TON R\u00caVE - Spectacle pour enfants (\u00e0 partir de 5 ans) et leurs parents","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.546818"},"de":{"name":"RACONTE MOI TON R\u00caVE - Spectacle pour enfants (\u00e0 partir de 5 ans) et leurs parents","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.546818"},"it":{"name":"RACONTE MOI TON R\u00caVE - Spectacle pour enfa