}},"educational_targets":{"list":[],"translations":{}},"tags":[]},{"id":5700000973,"date_start":"2024-09-28","date_end":"2024-09-29","date_next":"2024-09-28","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-09-05T12:07:05+02:00","published_at":"2024-09-05T12:06:30+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":307229,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"tour","ranking":1.4422495703074083,"languages":{"spoken":["en","fr","nl"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{}},"translations":{"de":{"name":"Guided Tour of the Notre-Dame des Champs School - BBN 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/fr\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700000973"},"pt":{"name":"Guided Tour of the Notre-Dame des Champs School - BBN 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/fr\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700000973"},"en":{"name":"Guided Tour of the Notre-Dame des Champs School - BBN 2024","shortdescr":null,"longdescr":"Founded in 1817, the Congregation of the Dames de Marie was dedicated to the education of young girls. The number of students kept growing in the course of nearly 90 years and, having moved repeatedly, in 1908 the Congregation finally acquired a plot of land of 3 hectares on what is today Rue Edith Cavell, with a view to constructing a school complex. Built in the middle of fields (as indicated by the names found in the surrounding area: Langeveld, Bosveldweg, Longchamp\u2026), the new school provided a healthy environment, calm and serenity, all conducive to quality education. The building comprised 200 rooms, including dormitories which were later turned into classrooms. With its long corridors and walkways, podiums and theatres, the former chapel which is now a multimedia centre, and its hundred-year-old trees, this is a living architectural ensemble which bears witness to an enlightened pedagogical concept. \n\nThe visits are accessible to wheelchair users (access through the entrance at 44, Rue Zeecrabbe).","performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/en\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700000973"},"it":{"name":"Guided Tour of the Notre-Dame des Champs School - BBN 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/fr\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700000973"},"cn":{"name":"Guided Tour of the Notre-Dame des Champs School - BBN 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/fr\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700000973"},"fr":{"name":"Visite Guid\u00e9e de l'\u00c9cole Notre-Dame des Champs - BBN 2024","shortdescr":null,"longdescr":"Fond\u00e9e en 1817, la congr\u00e9gation des Dames de Marie a pour vocation l'\u00e9ducation des jeunes filles. En pr\u00e8s de 90 ans, sa population d'\u00e9coli\u00e8res ne cessa d'augmenter et, de d\u00e9m\u00e9nagements en d\u00e9m\u00e9nagements, la communaut\u00e9 finit par acqu\u00e9rir, en 1908, un terrain de 3 hectares sur l'actuelle rue \u00c9dith Cavell, en vue d'y \u00e9riger un complexe scolaire. Construite au milieu des champs (Langeveld, Bosveldweg, Longchamp, ...), la nouvelle \u00e9cole offre la salubrit\u00e9, le calme et la s\u00e9r\u00e9nit\u00e9 propices \u00e0 des \u00e9tudes de qualit\u00e9. Ce b\u00e2timent compte alors 200 pi\u00e8ces, dont des dortoirs qui seront plus tard transform\u00e9s en salles de classe. Avec ses longs couloirs et ses coursives, ses estrades et ses salles de th\u00e9\u00e2tre, son ancienne chapelle reconvertie en centre multim\u00e9dia et ses arbres centenaires, voil\u00e0 un ensemble architectural encore bien vivant qui atteste d'une conception \u00e9clair\u00e9e de la p\u00e9dagogie. \n\nCes visites sont accessibles aux personnes en fauteuil roulant (acc\u00e8s via l'entr\u00e9e du n\u00b044 de la rue Zeecrabbe).","performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/fr\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700000973"},"sp":{"name":"Guided Tour of the Notre-Dame des Champs School - BBN 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/fr\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700000973"},"nl":{"name":"Rondleiding van het Notre-Dame des Champs School - BBN 2024","shortdescr":null,"longdescr":"De congregatie van de Dames de Marie werd gesticht in 1817 en richtte zich op het onderwijs voor jonge meisjes. Over een periode van bijna negentig jaar groeide het aantal leerlingen gestaag en na vele verhuizingen kon de gemeenschap uiteindelijk in 1908 een terrein van 3 hectare aankopen met het oog op de bouw van een scholencomplex. De straatnamen (Langeveld, Bosveldweg, Longchamp, \u2026) herinneren nog aan het landelijke karakter dat de omgeving toen had. De gezonde buitenlucht, de rust en de sereniteit moesten allemaal bijdragen aan de kwaliteit van het onderwijs. Initieel bestond het gebouw uit maar liefst 200 ruimtes, met daarbij ook slaapzalen die later zouden worden omgevormd tot klaslokalen. Tot op de dag van vandaag vormen de lange gangen en gaanderijen, de podia en theaterzalen, de voormalige kapel - nu een multimediaruimte - en de honderdjarige bomen een levend architecturaal geheel en dragen ze een heldere pedagogische visie uit. \n\nDe bezoeken zijn toegankelijk voor rolstoelgebruikers (toegang via de ingang ter hoogte van de Zeecrabbestraat nr. 44). \n","performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/nl\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700000973"}},"place":{"id":204134,"translations":{"de":{"name":"Arau - Atelier de Recherche et d'Action Urbaines","address_street_name":"Rue du Midi","address_street_number":"165","address_street_box":null,"email":"info@arau.org","website":"http:\/\/www.arau.org","phone_contact":"+32 2 219 33 45","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Midi, 165","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Arau - Atelier de Recherche et d'Action Urbaines","address_street_name":"Rue du Midi","address_street_number":"165","address_street_box":null,"email":"info@arau.org","website":"http:\/\/www.arau.org","phone_contact":"+32 2 219 33 45","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Midi, 165","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Arau - Atelier de Recherche et d'Action Urbaines","address_street_name":"Rue du Midi","address_street_number":"165","address_street_box":null,"email":"info@arau.org","website":"http:\/\/www.arau.org","phone_contact":"+32 2 219 33 45","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue du Midi, 165","address_line2":"1000 Brussels","description_web":"Understanding Brussels to better defend it!\r\nARAU was founded in 1969, in a context of \u2018Brusselsisation\u2019 and the exodus of Brussels residents to the periphery. The challenge at the time, which is still relevant today, was to defend and promote the inhabited city and a quality of life for all the inhabitants of Brussels. This led to major protests against demolition projects on the one hand and the development of counter-projects on the other, with a view to urban renewal and improving the living environment.\r\nThe ARAU intends, through its action to raise awareness and inform the population, to provide the public with the necessary tools to monitor the evolution of the city. This action takes the form of the publication of analyses and studies, the organisation of conferences and workshops, press releases, etc., as well as guided tours.\r\nThese tours, which are pioneering in the Brussels region and have been organised since 1977, aim to enhance the city and its assets, and to develop a critical view of its transformations, which includes the preservation and maintenance of its heritage.\r\nOver the years, the ARAU has developed a rich catalogue of guided tours on various themes: \u201cUnmissable Brussels\u201d, \u201cArchitecture\u201d, \u201cBrussels in Districts\u201d, \u201cThe City in Transformation\u201d, \u201cSummer Journey\u201d, \u201cA Brussels House\u201d, \u201cBrussels: City of Trams\u201d, \u201cSocial Brussels\u201d, which can be discovered during public tours or in the form of private, customised tours.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Arau - Atelier de Recherche et d'Action Urbaines","address_street_name":"Rue du Midi","address_street_number":"165","address_street_box":null,"email":"info@arau.org","website":"http:\/\/www.arau.org","phone_contact":"+32 2 219 33 45","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Midi, 165","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Arau - Atelier de Recherche et d'Action Urbaines","address_street_name":"Rue du Midi","address_street_number":"165","address_street_box":null,"email":"info@arau.org","website":"http:\/\/www.arau.org","phone_contact":"+32 2 219 33 45","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Midi, 165","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"ARAU - Atelier de Recherche et d'Action Urbaines","address_street_name":"Rue du Midi","address_street_number":"165","address_street_box":null,"email":"info@arau.org","website":"http:\/\/www.arau.org","phone_contact":"+32 2 219 33 45","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Midi, 165","address_line2":"1000 Bruxelles","description_web":"Comprendre Bruxelles pour mieux la d\u00e9fendre !\r\nL\u2019ARAU a \u00e9t\u00e9 fond\u00e9 en 1969, dans un contexte de \u00ab bruxellisation \u00bb et d\u2019exode des Bruxellois vers la p\u00e9riph\u00e9rie. L\u2019enjeu \u00e0 l\u2019\u00e9poque, toujours d\u2019actualit\u00e9 : d\u00e9fendre et promouvoir la ville habit\u00e9e et une qualit\u00e9 de vie pour tous les Bruxellois, ce qui s\u2019est traduit par d\u2019importantes contestations de projets de d\u00e9molition d\u2019une part et le d\u00e9veloppement de contre-projets d\u2019autre part, dans une optique de r\u00e9novation urbaine et d\u2019am\u00e9lioration du cadre de vie.\r\nL\u2019ARAU entend, par son action de sensibilisation et d\u2019information de la population, mettre \u00e0 disposition du public les outils n\u00e9cessaires pour suivre l\u2019\u00e9volution de la ville. Cette action se mat\u00e9rialise \u00e0 travers la publication d\u2019analyses et d\u2019\u00e9tudes, l\u2019organisation de colloques et d\u2019ateliers, des communiqu\u00e9s de presse, \u2026ainsi que de visites guid\u00e9es.\r\nCes visites, pionni\u00e8res en r\u00e9gion bruxelloise et organis\u00e9es depuis 1977, visent \u00e0 revaloriser la ville et ses atouts, \u00e0 d\u00e9velopper un regard critique sur ses transformations, ce qui passe par la sauvegarde et l\u2019entretien de son patrimoine.\r\nAu fil de toutes ces ann\u00e9es, l\u2019ARAU a d\u00e9velopp\u00e9 un riche catalogue de visites guid\u00e9es se d\u00e9clinant en diverses th\u00e9matiques : \u00ab Bruxelles incontournable \u00bb, \u00ab Architecture \u00bb, \u00ab Bruxelles en quartiers \u00bb, \u00ab La ville en transformation \u00bb, \u00ab Parcours d\u2019\u00e9t\u00e9 \u00bb, \u00ab Une maison bruxelloise \u00bb, \u00ab Bruxelles : ville de trams \u00bb, \u00ab Bruxelles sociale \u00bb, qu\u2019il est possible de d\u00e9couvrir lors de tours publics ou sous forme de visites priv\u00e9es, personnalisables.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Arau - Atelier de Recherche et d'Action Urbaines","address_street_name":"Rue du Midi","address_street_number":"165","address_street_box":null,"email":"info@arau.org","website":"http:\/\/www.arau.org","phone_contact":"+32 2 219 33 45","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Midi, 165","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Arau - Atelier de Recherche et d'Action Urbaines","address_street_name":"Zuidstraat","address_street_number":"165","address_street_box":null,"email":"info@arau.org","website":"http:\/\/www.arau.org","phone_contact":"+32 2 219 33 45","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Zuidstraat, 165","address_line2":"1000 Brussel","description_web":"Brussel begrijpen om het beter te kunnen verdedigen!\r\nHet ARAU werd opgericht in 1969, in een context van \u201cBrusselisering\u201d en de uittocht van de Brusselaars naar de rand. De uitdaging van die tijd, die ook vandaag nog actueel is, bestond erin de bewoonde stad en de levenskwaliteit van alle Brusselaars te verdedigen en te bevorderen. Dat leidde tot grote protesten tegen afbraakprojecten enerzijds en de ontwikkeling van tegenprojecten anderzijds, met het oog op stadsvernieuwing en verbetering van de leefomgeving.\r\nHet ARAU wil met zijn bewustmakings- en voorlichtingsactie de bevolking de nodige instrumenten aanreiken om de evolutie van de stad te volgen. Deze actie neemt de vorm aan van de publicatie van analyses en studies, de organisatie van conferenties en workshops, perscommuniqu\u00e9s, enz. en rondleidingen.\r\nDeze rondleidingen, die baanbrekend zijn in het Brusselse Gewest en al sinds 1977 worden georganiseerd, hebben tot doel de stad en haar troeven tot hun recht te laten komen en een kritische kijk te ontwikkelen op haar transformaties, die ook het behoud en de instandhouding van haar erfgoed inhouden.\r\nIn de loop der jaren heeft het ARAU een rijke catalogus van rondleidingen over verschillende thema\u2019s samengesteld: \u201cOnmisbaar Brussel\u201d, \u201cArchitectuur\u201d, \u201cBrussel in wijken\u201d, \u201cDe stad in transformatie\u201d, \u201cZomerreis\u201d, \u201cEen Brussels huis\u201d, \u201cBrussel: stad van de trams\u201d, \u201cSociaal Brussel\u201d, die tijdens openbare rondleidingen of in de vorm van priv\u00e9rondleidingen op maat kunnen worden ontdekt.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":null,"facebook_id":null,"backoffice_id":422,"location":{"lat":50.84343195,"lon":4.34634563},"region":"brussels","last_updated_at":"2024-04-18T16:00:05+02:00","published_at":"2013-10-19T01:13:31+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":240214,"translations":{"de":{"name":"Explore.brussels","address_street_name":"avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"http:\/\/www.explore.brussels\/","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"avenue Brugmann, 405","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Explore.brussels","address_street_name":"avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"http:\/\/www.explore.brussels\/","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"avenue Brugmann, 405","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Explore.Brussels","address_street_name":"avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"http:\/\/www.explore.brussels\/","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"avenue Brugmann, 405","address_line2":"1180 Uccle","description_web":"Explore.Brussels is a network of associations that organize top-quality guided tours in the Brussels-Capital Region. \r\nIts membre associations are ARAU, Pro Velo, Brussels Chatterguides and Arkadia. La Fonderie (in 2020) & Korei (in 2021) joined the network as a partner association.\r\n\r\nDiscover UNESCO\u2019s heritage, Art nouveau, Victoria Horta, Magritte, Herg\u00e9, Street art, Europe, beer, chocolate, or visit buildings built in Art Nouveau, Art Deco or neoclassical style that are usually closed for public visits. Tours are available for individual visitors and groups, and organized in a classical, exceptional or completely new way. Besides walking tours, visits can be organized by bike, bus or boat.\r\n\r\nExplore.Brussels organizes the Brussels Art Nouveau & Art Deco (BANAD) Festival and Brussels Biennale \u2013 Neoclassic (BBN), Brussels Biennale of Eclectic Architecture (BBEA) as well as other projects such as the visits of Art Nouveau Mansions, the formation of tour guides, the owners club and the friends club. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Explore.brussels","address_street_name":"avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brus