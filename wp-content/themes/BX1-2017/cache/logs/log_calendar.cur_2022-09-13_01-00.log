,"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Concert \"Plus Brel la Vie\"","shortdescr":null,"longdescr":"\u00a0 \u00a0 A intervalles plus ou moins r\u00e9guliers, Beno\u00eet Malev\u00e9 troque son r\u00f4le d'organisateur de concerts\u00a0avec celui de chanteur-passionn\u00e9 par l'immense Jacques Brel dont il se plait \u00e0 revisiter avec une\u00a0originalit\u00e9 propre, entre sinc\u00e9rit\u00e9 et \u00e9motion, une \u0153uvre magistrale et jamais \u00e9gal\u00e9e.\u00a0Et pour entretenir la magie br\u00e9lienne sur sc\u00e8ne, navigant entre grands succ\u00e8s et petites p\u00e9pites \u00e0\u00a0(re)d\u00e9couvrir, notre homme a le don de bien s'entourer !\r\nAinsi, pour rendre la vie plus Brel, il est accompagn\u00e9\u00a0de Philippe Decock, pianiste de Maurane ayant orchestr\u00e9 et r\u00e9alis\u00e9 son album\u00a0posthume consacr\u00e9 justement au Grand Jacques dont la chanteuse \u00e9tait une interpr\u00e8te incroyable !\u00a0\r\n\r\nUn rendez-vous comme on les aime, sans aucun doute !","performers":"Beno\u00eet Malev\u00e9 (chanteur)\r\n Phillipe Decock (pianiste)","boxoffice_url":null,"website":"https:\/\/www.facebook.com\/MaisondesVoyageursReizigershuis1070\/","email":"solidariteinternationale@anderlecht.brussels","phone_contact":"+32 2 436 67 01","phone_booking":"+32 2 436 67 01","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.541067"},"nl":{"name":"\"Plus Brel la Vie\" Concert","shortdescr":null,"longdescr":"Op min of meer regelmatige tijdstippen wisselt Beno\u00eet Malev\u00e9 zijn rol van concertorganisator af met die van zanger - gepassioneerd door de grote Jacques Brel, wiens meesterlijke werk hij graag herneemt met zijn eigen originaliteit, tussen oprechtheid en ontroering.\u00a0En om de Brelian magie op het podium te behouden, laverend tussen grote hits en kleine nuggets die (her)ontdekt moeten worden, heeft onze man de gave om zichzelf goed te omringen!\r\nDus, om het leven meer Brel te maken, wordt hij begeleid door Philippe Decock, Maurane's pianist die haar postume album, opgedragen aan de Grote Jacques, orkestreerde en produceerde, van wie de zangeres een ongelooflijke vertolker was!\u00a0\r\n\r\nEen rendez-vous zoals wij ze graag hebben, zonder enige twijfel!","performers":"Beno\u00eet Malev\u00e9 (zanger)\r\n Phillipe Decock (pianist)","boxoffice_url":null,"website":null,"email":null,"phone_contact":"+32 490 47 74 51","phone_booking":"+32 490 47 74 51","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.541067"},"en":{"name":"Concert \"Plus Brel la Vie\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.541067"},"de":{"name":"Concert \"Plus Brel la Vie\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.541067"},"it":{"name":"Concert \"Plus Brel la Vie\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.541067"},"sp":{"name":"Concert \"Plus Brel la Vie\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.541067"},"pt":{"name":"Concert \"Plus Brel la Vie\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.541067"},"cn":{"name":"Concert \"Plus Brel la Vie\"","shortdescr":null,"longdesc