oir.com","phone_contact":"+32 488 98 70 33","phone_booking":null,"address_zip":"1060","address_city":"Sint-Gillis","address_line1":"Jean Volderslaan","address_line2":"1060 Sint-Gillis","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":25511,"location":{"lat":50.83156097,"lon":4.34346347},"last_updated_at":"2023-10-25T09:28:08+02:00","published_at":"2016-03-07T20:08:51+01:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/7291412ea9628c65c5098465cf3aa3b0ca9852f1.jpg","width":1080,"height":1080,"ratio":1,"oEmbed_height":1080,"oEmbed_width":1080,"translations":{"de":{"title":"Effa\u00e7age et graffiti","copyright":null},"pt":{"title":"Effa\u00e7age et graffiti","copyright":null},"en":{"title":"Effa\u00e7age et graffiti","copyright":null},"it":{"title":"Effa\u00e7age et graffiti","copyright":null},"cn":{"title":"Effa\u00e7age et graffiti","copyright":null},"fr":{"title":"Effa\u00e7age et graffiti","copyright":null},"sp":{"title":"Effa\u00e7age et graffiti","copyright":null},"nl":{"title":"Effa\u00e7age et graffiti","copyright":null}}}],"dates":[{"day":"2024-05-16","doors":null,"start":"19:00:00","end":"20:30:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-05-19","doors":null,"start":"14:00:00","end":"15:30:00","end_night_life":null,"is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"de":{"name":"Normal"},"en":{"name":"Normal"},"it":{"name":"Normale"},"fr":{"name":"Normal"},"sp":{"name":"Normal"},"nl":{"name":"Normaal"}},"value":12}],"date_exceptions":[],"closing_days":[],"child_events":[],"parent_events":[],"accessibilities":[],"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":["exterior"]},{"id":50012260,"date_start":"2024-09-29","date_end":"2025-06-29","date_next":"2025-06-29","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-09-27T17:07:57+02:00","published_at":"2024-08-22T12:48:51+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":303628,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"festival","ranking":0.19398127563103507,"languages":{"spoken":["nl","en","fr"],"subtitles":[]},"categories":{"main":{"id":118,"translations":{"de":"Festival","pt":null,"en":"Festival","it":"Festival","cn":null,"fr":"Festival","sp":"Festival","nl":"Festival"}},"others":{"list":[121],"translations":{"de":["Klassisch"],"pt":[null],"en":["Classical  "],"it":["Classica"],"cn":[null],"fr":["Classique"],"sp":["Cl\u00e1sica"],"nl":["Klassiek"]}}},"translations":{"de":{"name":"Saison 2024-2025","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.tricoterie.be\/fr\/agenda\/l-agenda-culturel\/?id_mot=53&lang+fr","email":"crit.escapade@gmail.com","phone_contact":"+32 2 537 96 69","phone_booking":"+32 2 537 96 69","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50012260"},"pt":{"name":"Saison 2024-2025","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.tricoterie.be\/fr\/agenda\/l-agenda-culturel\/?id_mot=53&lang+fr","email":"crit.escapade@gmail.com","phone_contact":"+32 2 537 96 69","phone_booking":"+32 2 537 96 69","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50012260"},"en":{"name":"season 2024-2025 Concerts Escapades","shortdescr":"The new 2024-2025 season opens with brilliant artists from the Far East to the West and beyond. J.S. Bach opens the ball and Sakamoto closes it with electro-pop sounds. Between these great names in classical music, the way of women and women's voices will be in the spotlight.","longdescr":"The new season of Concerts Escapades 2024-2025 kicks off on 29\/09 with a host of great and brilliant artists. From the Far East to the West, via the cosmos, we'll be setting the bar high. J.S. Bach opens the ball and Sakamoto closes it with electro-pop sounds. Between these great names in classical music, female voices will have the greatest share. \nFrom the best-known composers and performers to the lesser-known, quality, sharing and surprises will be the keywords of the season.\n\n - 29\/09 at 18h00 : BACH ONLY BACH \/ Artyom Dervoed - Guitar and Aleksey Shadrin - Cello\nWithin the little world of classical guitar, Artyom Dervoed is one of the biggest planets. In the slightly bigger world of the cello Shadrin is a new star, known in Belgium because of being part of the winners of the Queen Elisabeth Competition. In the concert they devote themselves to the one and only composer coming from outer-space, the UFO of music: JS BACH\n\n- On 20\/10 at 6.00pm at the \"Musique Femmes Festival\", \u00c9lisabeth Jacquet de La Guerre, Barbara Strozzi and Galina Ustvolskaya. We'll be showcasing a range of female composers from different eras - baroque, classical and contemporary. Our selection for you: \u00c9lisabeth Jacquet de La Guerre for the baroque period, Barbara Strozzi for the classical period, and Galina Ustvolskaya for the contemporary period. In the Baroque period, women composers were more represented than in the Classical or Romantic periods. It was not until the end of the Second World War that women became a little more present, especially in the former USSR. \n\n- 24\/11 at 6.00pm - From Hit to Sublime or Not The Quiron Quartet ensemble will be playing Bach, Pachelbel, Albinoni and Bart\u00f3k (6th Quartet). Exploring a particular theme: \"From Hit to Sublime or Not\". This programme is the result of a collaboration with inmates from Brussels prisons. Taking part in Concerts Escapades, one of them suggested classical music, but these were such well-known hits that music lovers might consider them to be in bad taste. Admittedly, these are melodies that everyone knows, but which continue to appeal. B\u00e9la Bart\u00f3k's 6th Quartet, for example, was unanimously acclaimed... A true delight for classical music lovers. \n\n- 15\/12 at 6.00pm - RYUICHI SAKAMOTO Music for piano and electro. The Japanese composer, famous for his film scores such as Furyo and The Last Emperor, invites you to his last concert of 2024. This composer of multiple inspirations, from Debussy to the Rolling Stones, via electronic and ethnic music, offers you a unique musical journey. On the programme: contemporary classical, a little dance, a little techno, and a Japanese pop singer. Songs on offer include Amor, Merry Christmas, Mr. Lawrence, Sheltering Sky, Bolerish, Happy End, Aqua, as well as tracks from her latest album, such as \"Done before dying \/ While dying.\" With performers including Yu-Fen Chang, Jean-Philippe Collard-Neven and Alex Tambu. Please note: sushi platters will be available to enjoy after the concert!\n","performers":"- Artyom Dervoed (Guitar) and Aleksey Shadrin (Cello)\n- Katja Katanova (Violon), Cl\u00e9mence Schiltz (Viola da gamba), Pablo Lascano (Harpsichord) and Maria Goncharenko (Soprano)\n- Edgar Gomes (Violon), Ricardo Vieira (Violon), Jos\u00e9 Miguel Freitas (Alto) and Maria Nabeiro (Cello)\n- Yu-Fen Chang (Piano), Jean-Phillipe Collard-Neven (Piano) and Alex Tambu (Piano)","boxoffice_url":null,"website":"https:\/\/www.tricoterie.be\/fr\/ancien-site\/en-149\/activities\/?lang=en","email":"crit.escapade@gmail.com","phone_contact":"+32 2 537 96 69","phone_booking":"+32 2 537 96 69","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50012260"},"it":{"name":"Saison 2024-2025","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.tricoterie.be\/fr\/agenda\/l-agenda-culturel\/?id_mot=53&lang+fr","email":"crit.escapade@gmail.com","phone_contact":"+32 2 537 96 69","phone_booking":"+32 2 537 96 69","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50012260"},"cn":{"name":"Saison 2024-2025","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.tricoterie.be\/fr\/agenda\/l-agenda-culturel\/?id_mot=53&lang+fr","email":"crit.escapade@gmail.com","phone_contact":"+32 2 537 96 69","phone_booking":"+32 2 537 96 69","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50012260"},"fr":{"name":"Saison 2024-2025 Concerts Escapades","shortdescr":"La nouvelle saison des Concerts Escapades 2024-2025 d\u00e9marre le 29\/09 avec une pl\u00e9iade de grands et brillants artistes. De l'Extr\u00eame-Orient \u00e0 l'Occident, en passant par le cosmos, nous mettrons la barre haute. J.S. Bach ouvre le bal et Sakamoto le cl\u00f4t. Entre ces grands noms de la musique classique, la voie des femmes ainsi que leurs voix seront mises \u00e0 l'honneur. ","longdescr":"La nouvelle saison des Concerts Escapades 2024-2025 d\u00e9marre le 29\/09 avec une pl\u00e9iade de grands et brillants artistes. De l'Extr\u00eame-Orient \u00e0 l'Occident, en passant par le cosmos, nous mettrons la barre haute. J.S. Bach ouvre le bal et Sakamoto le cl\u00f4t avec des sons \u00e9lectro-pop. Entre ces grands noms de la musique classique, la voie des femmes ainsi que leurs voix seront mises \u00e0 l'honneur. \nDes compositeurs et interpr\u00e8tes les plus connus aux moins connus, qualit\u00e9, partage et surprises seront les ma\u00eetres mots de la saison.\n\n- 29\/09 \u00e0 18h00 : BACH ONLY BACH \/ Artyom Dervoed - Guitare et Aleksey Shadrin - Violoncelle. Dans le petit monde de la guitare classique, Artyom Dervoed est l'un des plus grands noms. Dans le monde un peu plus vaste du violoncelle, Aleksey Shadrin est un nom en devenir, connu en Belgique puisqu'il a \u00e9t\u00e9 l'un des laur\u00e9ats du Concours Reine Elisabeth 2022. Dans ce concert, ils se consacrent \u00e0 l'\u0153uvre du seul compositeur venu du cosmos, l'OVNI de la musique : JS BACH. \n\n- Le 20\/10 \u00e0 18h00 au \u201cMusique Femmes Festival\u201d, \u00c9lisabeth Jacquet de La Guerre, Barbara Strozzi et Galina Ustvolskaya. Au fil des diff\u00e9rentes \u00e9poques - baroque, classique et contemporaine - nous vous proposons de mettre diff\u00e9rentes compositrices \u00e0 l'honneur. Notre s\u00e9lection pour vous : \u00c9lisabeth Jacquet de La Guerre pour la p\u00e9riode baroque, Barbara Strozzi pour la p\u00e9riode classique, et enfin Galina Ustvolskaya pour la p\u00e9riode contemporaine. \u00c0 l'\u00e9poque baroque, les femmes compositrices \u00e9taient plus repr\u00e9sent\u00e9es qu'\u00e0 l'\u00e9poque classique ou romantique. Il faut attendre la fin de la Seconde Guerre mondiale pour que les femmes deviennent un peu plus pr\u00e9sentes, surtout en ex-URSS. \n\n- le 24\/11 \u00e0 18h00 - From Hit to Sublime or Not L\u2019ensemble Quatuor Quiron jouera Bach, Pachelbel, Albinoni et Bart\u00f3k (6e Quatuor). Exploration d'une th\u00e9matique particuli\u00e8re : \"Du bon go\u00fbt aux incontournables.\" Cette programmation est n\u00e9e d\u2019une collaboration avec des d\u00e9tenus de prisons bruxelloises. Participant \u00e0 Concerts Escapades, l'un d'entre eux a propos\u00e9 de la musique classique, mais il s'agissait de tubes tellement connus que les m\u00e9lomanes peuvent les consid\u00e9rer comme \u00e9tant de mauvais go\u00fbt. Certes, ce sont des m\u00e9lodies que tout le monde conna\u00eet, mais qui continuent d'attirer. Par exemple, le 6e Quatuor de B\u00e9la Bart\u00f3k a aussi fait l'unanimit\u00e9\u2026 Un vrai d\u00e9lice pour les amateurs de musique classique. \n\n- Le 15\/12 \u00e0 18h00 - RYUICHI SAKAMOTO Musique pour piano et \u00e9lectro. Le compositeur japonais, c\u00e9l\u00e8bre notamment pour ses musiques de films comme Furyo ou Le Dernier Empereur, aurait aim\u00e9 vous inviter \u00e0 son dernier concert de l'ann\u00e9e 2024. Ce compositeur aux inspirations multiples, de Debussy aux Rolling Stones, en passant par la musique \u00e9lectronique (TELEX\/YMO) et ethnique, vous propose un voyage musical unique. Au programme : du classique contemporain, un peu de danse, de techno, et une chanteuse pop japonaise. Les titres propos\u00e9s incluent Amor, Merry Christmas, Mr. Lawrence, Sheltering Sky, Bolerish, Happy End, Aqua, ainsi que des morceaux de son dernier album, comme \"Fait avant de mourir \/ En mourant.\" Avec des interpr\u00e8tes tels que Yu-Fen Chang, Jean-Philippe Collard-Neven et Alex Tambu. Attention : des plateaux de sushi seront \u00e0 d\u00e9guster apr\u00e8s le concert !","performers":"- Artyom Dervoed (Guitare) and Aleksey Shadrin (Cello)\n- Katja Katanova (Violon), Cl\u00e9mence Schiltz (Viola da gamba), Pablo Lascano (Clavecin) and Maria Goncharenko (Soprano)\n- Edgar Gomes (Violon), Ricardo Vieira (Violon), Jos\u00e9 Miguel Freitas (Alto) and Maria Nabeiro (Cello)\n- Yu-Fen Chang (Piano), Jean-Phillipe Collard-Neven (Piano) and Alex Tambu (Piano)","boxoffice_url":null,"website":"https:\/\/www.tricoterie.be\/fr\/agenda\/l-agenda-culturel\/?id_mot=53&lang+fr","email":"crit.escapade@gmail.com","phone_contact":"+32 2 537 96 69","phone_booking":"+32 2 537 96 69","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50012260"},"sp":{"name":"Saison 2024-2025","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.tricoterie.be\/fr\/agenda\/l-agenda-culturel\/?id_mot=53&lang+fr","email":"crit.escapade@gmail.com","phone_contact":"+32 2 537 96 69","phone_booking":"+32 2 537 96 69","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50012260"},"nl":{"name":"seizoen 2024-2025 Concerts Escapades","shortdescr":"Het nieuwe seizoen Concerts Escapades 2024-2025 begint op 29\/09 met een reeks verbazende en briljante artiesten. Van het Verre Oosten tot het Westen, via de kosmos, leggen we de lat heel hoog. J.S. Bach opent het bal en Sakamoto sluit het af. Tussen deze grote namen in de klassieke muziek staan vrouwenstemmen in de schijnwerpers. ","longdescr":"Het nieuwe seizoen Concerts Escapades 2024-2025 begint op 29\/09 met een reeks verbazingwekkende en briljante artiesten. Van het Verre Oosten tot het Westen, via de kosmos, leggen we de lat heel hoog. J.S. Bach opent het bal en Sakamoto sluit het af met elektro-pop geluiden. Tussen deze grote namen in de klassieke muziek staan vrouwenstemmen in de schijnwerpers. \nVan de bekendste componisten en artiesten tot de minder bekende, zijn  kwaliteit, delen en verrassen de sleutelwoorden van het seizoen. \n\n- 29\/09 om 18.00 uur: BACH ONLY BACH \/ Artyom Dervoed - Gitaar en Aleksey Shadrin - Cello In de kleine wereld van de klassieke gitaar is Artyom Dervoed een van de grootste namen. In de iets grotere wereld van de cello is Aleksey Shadrin een opkomende naam, bekend in Belgi\u00eb sinds hij een van de winnaars was van de Koningin Elisabethwedstrijd van 2022. In dit concert wijden ze zich aan het werk van de enige componist die uit de ruimte kwam, de UFO van de muziek: JS BACH. \n\n- Op 20\/10 om 18.00 uur op het \"Musique Femmes Festival\", \u00c9lisabeth Jacquet de La Guerre, Barbara Strozzi en Galina Ustvolskaya. We laten een reeks vrouwelijke componisten uit verschillende tijdperken horen - barok, klassiek en hedendaags. Onze selectie voor jou: \u00c9lisabeth Jacquet de La Guerre voor de barokperiode, Barbara Strozzi voor de klassieke periode en Galina Ustvolskaya voor de hedendaagse periode. In de barok waren vrouwelijke componisten beter vertegenwoordigd dan in de klassieke of romantische periode. Pas aan het einde van de Tweede Wereldoorlog werden vrouwen wat meer aanwezig, vooral in de voormalige USSR. \n\n- 24\/11 om 18.00 uur - From Hit to Sublime or Not Het Quiron Quartet speelt Bach, Pachelbel, Albinoni en Bart\u00f3k (6e kwartet). Het verkennen van een bepaald thema: \"From Hit to Sublime or Not\". Dit programma is het resultaat van een samenwerking met gedetineerden uit Brusselse gevangenissen. In het kader van Concerts Escapades stelde een van hen klassieke muziek voor, maar dit waren zulke bekende hits dat muziekliefhebbers ze misschien als smakeloos zouden beschouwen. Toegegeven, het zijn melodie\u00ebn die iedereen kent, maar die blijven aanspreken. Het 6e kwartet van B\u00e9la Bart\u00f3k werd bijvoorbeeld unaniem geprezen... Een waar genot voor liefhebbers van klassieke muziek. \n\n- 15\/12 om 18u00 - RYUICHI SAKAMOTO Muziek voor piano en elektro. De Japanse componist, beroemd om zijn filmmuziek zoals Furyo en The Last Emperor, nodigt je uit voor zijn laatste concert van 2024. Deze veelzijdige componist, van Debussy tot de Rolling Stones, via elektronische en etnische muziek, biedt je een unieke muzikale reis. Op het programma: hedendaags klassiek, een beetje dance, een beetje techno en een Japanse popzangeres. Nummers op het programma zijn onder andere Amor, Merry Christmas, Mr. Lawrence, Sheltering Sky, Bolerish, Happy End, Aqua, maar ook nummers van haar laatste album, zoals \"Done before dying \/ While dying\". Met artiesten als Yu-Fen Chang, Jean-Philippe Collard-Neven en Alex Tambu. Let op: er zijn sushischotels beschikbaar na het concert!","performers":"- Artyom Dervoed (Gitaar) en Aleksey Sjadrin (Cello)\n- Katja Katanova (Viool), Cl\u00e9mence Schiltz (Viola da gamba), Pablo Lascano (Klavecimbel) en Maria Goncharenko (Sopraan)\n- Edgar Gomes (viool), Ricardo Vieira (viool), Jos\u00e9 Miguel Freitas (altviool) en Maria Nabeiro (cello)\n- Yu-Fen Chang (piano), Jean-Phillipe Collard-Neven (piano) en Alex Tambu (piano)","boxoffice_url":null,"website":"https:\/\/www.tricoterie.be\/fr\/ancien-site\/nl-150\/activiteiten\/?lang=nl","email":"crit.escapade@gmail.com","phone_contact":"+32 2 537 96 69","phone_booking":"+32 2 537 96 69","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50012260"}},"place":{"id":252101,"translations":{"de":{"name":"La Tricoterie","address_street_name":"Rue Th\u00e9odore Verhaegen","address_street_number":"158","address_street_box":null,"email":"charlotte@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+ 32 (0)2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Th\u00e9odore Verhaegen, 158","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"La Tricoterie - Fabrique de liens","address_street_name":"Rue Th\u00e9odore Verhaegen","address_street_number":"158","address_street_box":null,"email":"charlotte@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+ 32 (0)2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Th\u00e9odore Verhaegen, 158","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"La Tricoterie - Link factory","address_street_name":"Rue Th\u00e9odore Verhaegen","address_street_number":"158","address_street_box":null,"email":"charlotte@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+ 32 (0)2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Th\u00e9odore Verhaegen, 158","address_line2":"1060 Saint-Gilles","description_web":"La Tricoterie is above all a civil, cultural, sustainable and innovative project. Their cultural programme featuring performances, shows, exhibitions and so on goes hand in hand with a \u201ccivil\u201d programme of debates, conferences, inter-generational workshops, philosophical caf\u00e9 etc ... The place can be rented for events and there are plenty of really great parties! ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"La Tricoterie","address_street_name":"Rue Th\u00e9odore Verhaegen","address_street_number":"158","address_street_box":null,"email":"charlotte@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+ 32 (0)2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Th\u00e9odore Verhaegen, 158","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"La Tricoterie - Fabrique de liens","address_street_name":"Rue Th\u00e9odore Verhaegen","address_street_number":"158","address_street_box":null,"email":"charlotte@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+ 32 (0)2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Th\u00e9odore Verhaegen, 158","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"La Tricoterie - Fabrique de liens","address_street_name":"Rue Th\u00e9odore Verhaegen","address_street_number":"158","address_street_box":null,"email":"charlotte@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+ 32 (0)2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Th\u00e9odore Verhaegen, 158","address_line2":"1060 Saint-Gilles","description_web":"La Tricoterie est un projet culturel fond\u00e9 en 2010 par une poign\u00e9e de citoyen\u00b7nes et situ\u00e9 dans une ancienne usine restaur\u00e9e avec des mat\u00e9riaux \u00e9cologiques. La Tricoterie propose une programmation culturelle tr\u00e8s diversifi\u00e9e et centr\u00e9e sur la rencontre entre les diff\u00e9rents publics et le m\u00e9lange des activit\u00e9s culturelles.\r\n\r\nPassez la porte et d\u00e9couvrez :\r\n- Des spectacles de th\u00e9\u00e2tre, de danse, de cirque...\r\n- Des concerts, des soir\u00e9es, des sc\u00e8nes ouvertes, des jam sessions, une chorale d'un soir...\r\n- Des ateliers z\u00e9ro d\u00e9chet, peinture, c\u00e9ramique, \u0153nologie, danse...\r\n- Des projections de films, conf\u00e9rences, d\u00e9bats...\r\n- Des couscous \"s\u00e9pharabes\", des soir\u00e9es jeux de soci\u00e9t\u00e9, des activit\u00e9s pour enfants...\r\n- Des march\u00e9s des cr\u00e9ateur\u00b7rices, des vide-dressings, des march\u00e9s de No\u00ebl durables...\r\n\r\nUn petit creux ? La Triciterie vous propose un brunch tous les dimanches et un concept \"live cooking\" tous les vendredis soirs. Tous les plats sont 100% artisanaux, et pr\u00e9par\u00e9s sur place par l'\u00e9quipe avec des ingr\u00e9dients bio, locaux et de saison.\r\n\r\nEnvie d'organiser votre \u00e9v\u00e9nement chez vous ? La Tricoterie met ses salles \u00e0 disposition pour tout type d'\u00e9v\u00e9nement priv\u00e9 ou professionnel et propose \u00e9galement un service traiteur, que ce soit dans ses murs ou \u00e0 l'ext\u00e9rieur. Rendez-vous sur www.tricoterie.be pour en savoir plus !\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"La Tricoterie","address_street_name":"Rue Th\u00e9odore Verhaegen","address_street_number":"158","address_street_box":null,"email":"charlotte@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+ 32 (0)2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Th\u00e9odore Verhaegen, 158","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"La Tricoterie - Contactenfabriek","address_street_name":"Th\u00e9odore Verhaegenstraat","address_street_number":"158","address_street_box":null,"email":"charlotte@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+ 32 (0)2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Sint-Gillis","address_line1":"Th\u00e9odore Verhaegenstraat, 158","address_line2":"1060 Sint-Gillis","description_web":"La Tricoterie is een project met een welomlijnde filosofie, die blijkt uit de zelfgekozen naam (van tricoter, breien) waarmee verwijst wordt naar het smeden van banden om de strijd tegen de ontrafeling van het sociale weefsel aan te gaan. Opgezet als een \u00abContacten Fabriek\u00bb en een ontmoetingsplaats waar verschillende disciplines en publieken elkaar ontmoeten. Naast een culturele programmering (concerten, voorstellingen, expos\u2026) en socioculturele activiteiten die sociale cohesie beogen (debatten, conferenties, intergenerationele ateliers, caf\u00e9-filo\u2026) staan de ruimtes ook open voor verhuur aan externe organisaties en bedrijven. Tal van superleuke feestjes vinden er plaats, alsook een wekelijkse biomarkt, een repaircaf\u00e9 en een alternatieve geschenkenmarkt om maar enkele van de activiteiten te noemen die de duurzame levensvisie van de plek weerspiegelen.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[7],"translations":{"de":["Saint-Gilles Zentrum"],"pt":[null],"en":["Saint-Gilles Centre"],"it":["Saint-Gilles Centre"],"cn":[null],"fr":["Saint-Gilles Centre"],"sp":["Saint-Gilles Centre"],"nl":["Sint-Gillis centrum"]}},"zones":{"list":[21],"translations":{"de":["S\u00fcden"],"pt":[null],"en":["South"],"it":["Sud"],"cn":[null],"fr":["Sud"],"sp":["Sur"],"nl":["Zuid"]}},"neca":null,"facebook_id":null,"backoffice_id":14176,"location":{"lat":50.83028735,"lon":4.33675871},"region":"brussels",