\/visit.brussels\/en\/visitors\/agenda\/event-detail.50002931"},"it":{"name":"Enrique Karabitian \"Obras\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.wolubilis.be\/a-voir\/enrique-karabitian-obras\/","email":"cultur@woluwe1200.be","phone_contact":"+32 2 761 27 98","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50002931"},"cn":{"name":"Enrique Karabitian \"Obras\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.wolubilis.be\/a-voir\/enrique-karabitian-obras\/","email":"cultur@woluwe1200.be","phone_contact":"+32 2 761 27 98","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50002931"},"fr":{"name":"Enrique Karabitian \"Obras\"","shortdescr":"Pour cette rentr\u00e9e 2023, La M\u00e9diatine vous invite \u00e0 d\u00e9couvrir l\u2019oeuvre  sculpturale, picturale et graphique d\u2019Enrique Karabitian.\n\nL\u2019artiste sera pr\u00e9sent tous les vendredis.","longdescr":"Enrique Karabitian a un parcours artistique atypique. G\u00e9ologue de formation, c\u2019est sa pratique professionnelle qui le pousse \u00e0 manipuler, \u00e0 travailler la terre jusqu\u2019\u00e0 cr\u00e9er des silhouettes humaines brutes et intenses dont la forme n\u2019est pas sans nous rappeler que l\u2019homme et la nature sont intimement li\u00e9s. \n\nLe corps humain est \u00e9galement pr\u00e9sent dans les grands fusains, les peintures \u00e0 l\u2019huile et autres pastels que l\u2019artiste r\u00e9alise. Ce ne sont pourtant pas les contours d\u2019une silhouette qu\u2019il esquisse c\u2019est plut\u00f4t la force int\u00e9rieure qui se d\u00e9gage de tout \u00eatre vivant qu\u2019Enrique Karabitian fait jaillir sur la page et sur la toile.\n \nCette m\u00eame intensit\u00e9, se d\u00e9gage de ses marines, paysages et autres natures mortes travaill\u00e9s dans des couleurs de terre, par transparence et glacis, et quelque fois rehauss\u00e9s de touches vives ou \u00e9dulcor\u00e9es qui illuminent le sujet et calment sa temp\u00e9tuosit\u00e9. \n\n\n","performers":"Service de la Culture de Woluwe-Saint-Lambert\n","boxoffice_url":null,"website":"https:\/\/www.wolubilis.be\/a-voir\/enrique-karabitian-obras\/","email":"cultur@woluwe1200.be","phone_contact":"+32 2 761 27 98","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50002931"},"sp":{"name":"Enrique Karabitian \"Obras\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.wolubilis.be\/a-voir\/enrique-karabitian-obras\/","email":"cultur@woluwe1200.be","phone_contact":"+32 2 761 27 98","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50002931"},"nl":{"name":"Enrique Karabitian \"Obras\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.wolubilis.be\/a-voir\/enrique-karabitian-obras\/","email":"cultur@woluwe1200.be","phone_contact":"+32 2 761 27 98","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50002931"}},"place":{"id":50000631,"translations":{"de":{"name":"La M\u00e9diatine","address_street_name":"All\u00e9e Pierre Levie","address_street_number":"1","address_street_box":null,"email":"cultur@woluwe1200.be","website":"https:\/\/www.wolubilis.be\/type\/a-voir\/expositions\/","phone_contact":"+32 2 761 27 98","phone_booking":null,"address_zip":"1200","address_city":"Woluwe-Saint-Lambert","address_line1":"All\u00e9e Pierre Levie, 1","address_line2":"1200 Woluwe-Saint-Lambert","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"La M\u00e9diatine","address_street_name":"All\u00e9e Pierre Levie","address_street_number":"1","address_street_box":null,"email":"cultur@woluwe1200.be","website":"https:\/\/www.wolubil