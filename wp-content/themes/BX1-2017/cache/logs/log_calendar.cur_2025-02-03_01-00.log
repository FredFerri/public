/pt\/visitors\/agenda\/event-detail.50010396"},"en":{"name":"Visite guid\u00e9e Street Art & BD : Les murs qui parlent","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/les-murs-qui-parlent-street-art-et-bd-a-bruxelles\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50010396"},"it":{"name":"Visite guid\u00e9e Street Art & BD : Les murs qui parlent","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/les-murs-qui-parlent-street-art-et-bd-a-bruxelles\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50010396"},"cn":{"name":"Visite guid\u00e9e Street Art & BD : Les murs qui parlent","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/les-murs-qui-parlent-street-art-et-bd-a-bruxelles\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50010396"},"fr":{"name":"Visite guid\u00e9e Street Art & BD : Les murs qui parlent","shortdescr":"Provocateur, censur\u00e9, d\u00e9cri\u00e9, ill\u00e9gal, mais toujours vrai et proche l\u2019Humain. Le Street Art a bien des choses \u00e0 dire...","longdescr":"Provocateur, censur\u00e9, d\u00e9cri\u00e9, ill\u00e9gal, mais toujours vrai et proche l\u2019Humain. Le Street Art a bien des choses \u00e0 dire...\n\nDes plus grandes fresques officielles aux petites interventions discr\u00e8tes, des grands artistes internationnaux aux jeunes bruxellois qui veulent s\u2019exprimer, Bruxelles est LA ville o\u00f9 l\u2019on s\u2019exprime sur les murs ! Mais sait-on r\u00e9ellement ce qui se cache derri\u00e8re ces \u0153uvres ?\n\nLors de cette balade, on vous emm\u00e8ne sur les traces des artistes qui ont fa\u00e7onn\u00e9 les rues de Bruxelles avec leurs bombes, leurs pinceaux, leurs stickers, et avec bien d'autres instruments beaucoup plus inattendus !\n\nPourquoi telle \u0153uvre ? Qu\u2019est-ce qu\u2019elle veut dire ? Pourquoi s\u2019\u00eatre mis au street art ?... Nous r\u00e9pondons \u00e0 toutes ces questions, et \u00e0 bien d\u2019autres !\n\nQuelques lieux o\u00f9 nous vous emmenons :\n- La fresque de Bonom sur le b\u00e2timent des Brigittines\n- Le \"Manneken-Peace\" sur le mur du Mus\u00e9e de sa garde-robe\n- L\u2019intervention de Mr Doodle \u00e0 la rue de l\u2019\u00c9clipse\n- Quelques fresques BD\n- De myst\u00e9rieuses statuettes cach\u00e9es\n- Et bien d\u2019autres\u2026","performers":"Une visite guid\u00e9e originale de la compagnie Brussels By Foot","boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/les-murs-qui-parlent-street-art-et-bd-a-bruxelles\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50010396"},"sp":{"name":"Visite guid\u00e9e Street Art & BD : Les murs qui parlent","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/les-murs-qui-parlent-street-art-et-bd-a-bruxelles\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50010396"},"nl":{"name":"Visite guid\u00e9e Street Art & BD : Les murs qui parlent","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/les-murs-qui-parlent-street-art-et-bd-a-bruxelles\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50010396"}},"place":{"id":242159,"translations":{"de":{"name":"Place de la Chapelle","address_street_name":"Place de la Chapelle","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Chapelle","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Place de la Chapelle","address_street_name":"Place de la Chapelle","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Chapelle","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Place de la Chapelle","address_street_name":"Place de la Chapelle","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Place de la Chapelle","address_line2":"1000 Brussels","description_web":"Although it is no longer configured like a typical square, place de la Chapelle remains one of the principal points of exchange between several of Brussels' major districts: the chic Sablon to the east, the hip-hop square des Ursulines to the west, the Marolles and the antique shops of rue Blaes to the south and Boulevard de l'Empereur to the north, where you can see one of the last vestiges of Brussels' first city walls. With the imposing Roman-Gothic Chapel Church (whose first stones were laid way back in 1210) on one side, admire the square's small and large restaurants, including some that are typical of Brussels. This hub of activity and exchange is also a great starting point for exploring the Marolles or the Sablon, given its decentralised location. It is also served by several buses. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Place de la Chapelle","address_street_name":"Place de la Chapelle","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Chapelle","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Place de la Chapelle","address_street_name":"Place de la Chapelle","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Chapelle","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Place de la Chapelle","address_street_name":"Place de la Chapelle","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Chapelle","address_line2":"1000 Bruxelles","description_web":"Si elle n\u2019a plus vraiment la configuration d\u2019une place classique, la place de Chapelle reste tr\u00e8s certainement un des points d\u2019\u00e9changes principaux entre plusieurs quartiers importants \u00e0 Bruxelles\u202f: le Sablon chic \u00e0 l\u2019est, le square hip hop des Ursulines \u00e0 l\u2019ouest, les Marolles et les antiquaires de la rue Blaes au sud et le boulevard de l\u2019Empereur au nord avec l\u2019un des derniers vestiges de la premi\u00e8re enceinte de Bruxelles. Occup\u00e9e par l\u2019imposante \u00e9glise romano-gothique de Notre Dame de la Chapelle (dont les premi\u00e8res pierres datent de 1210) sur l\u2019un de ses abords, vous appr\u00e9cierez les petits et grands restaurants, dont certains typiquement bruxellois. Carrefour d\u2019\u00e9changes, c\u2019est aussi un point de d\u00e9part astucieux car d\u00e9centralis\u00e9 si vous voulez explorez les Marolles ou le Sablon. Elle est desservie par plusieurs bus. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Place de la Chapelle","address_street_name":"Place de la Chapelle","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Chapelle","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Kapelleplein","address_street_name":"Kapellemarkt","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Kapellemarkt","address_line2":"1000 Brussel","description_web":"Het Ursulinenplein, in de buurt van de imposante Kapellekerk, is the place to be als je houdt van urban- en hiphopcultuur. Je vindt er namelijk het grootste skatepark van het stadscentrum. De bowl wordt voortdurend beschilderd. Het is echt een evoluerend fresco. Hier kom je voornamelijk skaters, rolschaatsers en BMX'ers tegen. Je hoeft geen volleerd rider te zijn om je hier te begeven. De plek staat open voor iedereen, ook voor beginners. Ga er zeker eens langs voor de sfeer. Vaak is er ook een DJ aan het werk. Het Ursulinenplein kwam er in de jaren vijftig. Toen werd het eerste deel van de ondergrondse spoorverbinding tussen het noorden en het zuiden van de hoofdstad afgewerkt. In het station Brussel-Kapellekerk, ten zuiden van het plein, zijn er vaak expo\u2019s, performances, concerten en filmvertoningen. Een must voor de fans van hiphopcultuur.   ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[2],"translations":{"de":["Marollen"],"pt":[null],"en":["Marolles"],"it":["Marolles"],"cn":[null],"fr":["Marolles"],"sp":["Marolles"],"nl":["Marollen"]}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":null,"facebook_id":null,"backoffice_id":4598,"location":{"lat":50.84127592,"lon":4.35131627},"region":"brussels","last_updated_at":"2022-07-07T09:45:45+02:00","published_at":"2013-10-19T01:17:34+02:00","import_origin":null,"external_id":null,"is_in_address_book":false,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":50001075,"translations":{"de":{"name":"Brussels By Foot","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":"info@brusselsbyfoot.com","website":"https:\/\/brusselsbyfoot.be\/sur-les-traces-de-karl-marx\/","phone_contact":"+32 472 39 82 17","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Brussels By Foot","address_line2":"1000 Bruxelles","description_web":"Brussels By Foot is a small company offering unusual guided tours of Brussels. They create themed tours to help you discover Brussels from very special, sometimes surprising angles... All passionate Brusseleirs, they take you through the streets and alleys of Brussels and show you the city as they know it, as they love it.\n\nUrban legends, social struggles, crime scenes, Art Nouveau, or other themes, join us and discover Brussels as you've never seen it before!\n\nThe tours are available on registration via the website, but private tours for groups can also be arranged on 