:"17:00:00"},{"day":"2022-07-20","doors":null,"start":"14:30:00","end":"17:00:00"},{"day":"2022-07-23","doors":null,"start":"14:30:00","end":"17:00:00"},{"day":"2022-07-24","doors":null,"start":"14:30:00","end":"17:00:00"},{"day":"2022-07-27","doors":null,"start":"14:30:00","end":"17:00:00"}],"weekschema":[{"days":{"monday":{"is_open":false},"tuesday":{"is_open":false},"wednesday":{"is_open":true,"hours":[{"start":"14:30:00","end":"17:00:00"}]},"thursday":{"is_open":false},"friday":{"is_open":false},"saturday":{"is_open":true,"hours":[{"start":"14:30:00","end":"17:00:00"}]},"sunday":{"is_open":true,"hours":[{"start":"14:30:00","end":"17:00:00"}]}},"translations":{"fr":["lundi, mardi, jeudi et vendredi: ferm\u00e9","mercredi, samedi et dimanche: de 14:30 \u00e0 17:00"],"nl":["maandag, dinsdag, donderdag en vrijdag: gesloten","woensdag, zaterdag en zondag: van 14:30 tot 17:00"],"en":["monday, tuesday, thursday and friday: closed","wednesday, saturday and sunday: from 14:30 to 17:00"]},"date_start":"2021-09-15","date_end":"2022-07-29","is_also_by_appointment":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":9},{"translations":{"fr":{"name":"Article 27"},"nl":{"name":"Artikel 27"},"en":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[],"targets":{"list":[16,11,19,3,4,5],"translations":{"fr":["Ecoles","Famille","Enseignants","Enfants 3-6 ans","Enfants 6-9 ans","Enfants 9-12 ans"],"nl":["Scholen","Familie","Leerkrachten","Kinderen 3-6 j.","Kinderen 6-9 j.","Kinderen 9-12 j."],"en":["Schools","Family","Teachers","Children 3-6 yr.","Children 6-9 yr.","Children 9-12 yr."]}},"educational_targets":{"list":[2,4,5,6],"translations":{"fr":["Primaire","6 - 8 ans","8 - 10 ans","10 - 12 ans"],"nl":["Lagere school","6 - 8 jaar","8 - 10 jaar","10 - 12 jaar"],"en":["Primary school","6 - 8 years","8 - 10 years","10 - 12 years"]}},"visit_profile":{"list":[331],"translations":{"fr":["Enfants"],"nl":["Kinderen"],"en":["Kids"]}},"tags":["kids"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-06-09T01:08:53+02:00","published_at":"2014-09-02T16:33:11+02:00","backoffice_id":59827,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.18458693499862},{"id":530407,"date_start":"2022-06-11","date_end":"2022-06-11","date_next":"2022-06-11","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert"}},"others":{"list":[4,8],"translations":{"fr":["Pop, rock, jazz\u2026","Chanson"],"nl":["Pop, rock, jazz\u2026","Chanson"],"en":["Pop, rock, jazz\u2026","Song"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Dance with pride","shortdescr":"La communaut\u00e9 LGBTQI+ s\u2019est tr\u00e8s t\u00f4t appropri\u00e9 la danse comme moyen de revendication et d\u2019\u00e9mancipation. L\u2019\u00e9volution depuis la discr\u00e9tion des lieux ferm\u00e9s jusqu\u2019\u00e0 la libert\u00e9 dans l\u2019espace public sera illustr\u00e9e gr\u00e2ce \u00e0 des archives audiovisuelles film\u00e9es \u00e0 Bruxelles dans les ann\u00e9es 70 et 90, et bien s\u00fbr des chansons qui ont toutes un lien avec la th\u00e9matique de la danse ou de l\u2019\u00e9mancipation.","longdescr":"The LGBTQI + community very early on adopted dance as a means of advocacy and emancipation. In the closed spaces of bars and nightclubs, this community could express itself in safe places, where everyone was free to be themselves, and by choosing their dance partners regardless of their gender. The most famous example is undoubtedly the culture of voguing, developed by the Latin and black American LGBTQI + community and which inspired Madonna to her hit \u201cVogue\u201d in the early 90s, the film \u201cParis is burning\u201d, and more recently the series \u201cPose\u201d currently airing on Netflix. \r\n\r\nIn Brussels, at the same time, gay and lesbian bars were also spaces of freedom and security, places of celebration, of seduction, of pride, through music and dance\u2026 until daylight. where the community took to the streets to claim their place in the public space, on the occasion of the first Brussels Pride in 1995. \r\n\r\nSince then, the LGBTQI + community has come a long way and Belgium is recognized as one of the most progressive countries in the world while Brussels is unmistakably gay-friendly. Yet today, being yourself in public space still sometimes poses a risk. The duality has not disappeared and some prefer or still need the security of confined spaces. \r\n\r\nSing Out Brussels! (The Fabulous Queer Choir) will illustrate this debate and this path towards emancipation and freedom through the dance theme. Our thread is based on audiovisual archives filmed in Brussels in the 1970s and 1990s. The evolution from the discretion of closed places to freedom in the public space will be illustrated in songs that all have a link with the theme of dance or emancipation.","performers":"Sing Out Brussels! (The Fabulous Queer Choir)","boxoffice_url":null,"website":"http:\/\/www.singout.brussels","email":"singoutbrussels@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/530407.html"},"nl":{"name":"Dance with pride","shortdescr":"De LGBTQI+-gemeenschap heeft zich al heel vroeg de dans toege\u00ebigend als middel tot protest en emancipatie. De evolutie van de discretie van gesloten plaatsen naar vrijheid in de publieke ruimte zal worden ge\u00efllustreerd met audiovisuele archieven gefilmd in Brussel in de jaren 1970 en 1990, en natuurlijk nummers die allemaal een link hebben met het thema van dans of emancipatie.","longdescr":"De LGBTQI+-gemeenschap heeft zich al heel vroeg de dans toege\u00ebigend als middel tot protest en emancipatie. In de gesloten ruimtes van bars en nachtclubs kon deze gemeenschap zich uitdrukken op veilige plaatsen, waar iedereen vrij was om zichzelf te zijn, en door hun danspartners te kiezen, onafhankelijk van hun geslacht. Het bekendste voorbeeld is de voguing-cultuur, ontwikkeld door de LGBTQI+-gemeenschap in de VS, Latino en zwart, die begin jaren negentig de inspiratie vormde voor Madonna\u2019s hit \u201cVogue\u201d, de film \u201cParis is Burning\u201d, en meer recent de Netflix-serie \u201cPose\u201d.  \r\n\r\nIn Brussel waren de bars voor lesbiennes en homo\u2019s in diezelfde periode ook ruimtes van vrijheid en veiligheid, plaatsen van feest, verlokking en fierheid, door middel van muziek en dans\u2026 tot de dag waarop de gemeenschap de straat opging om haar plaats in de publieke ruimte op te eisen, ter gelegenheid van de eerste Brussels Pride in 1995. \r\n\r\nSindsdien heeft de LGBTQI+-gemeenschap een lange weg afgelegd en wordt Belgi\u00eb erkend als een van de meest progressieve landen ter wereld. Toch is het vandaag de dag nog steeds een risico om jezelf te zijn in de openbare ruimte van Brussel. \r\n\r\nSing Out Brussels! (The Fabulous Queer Choir) zal dit debat en deze weg naar emancipatie en vrijheid illustreren aan de hand van het dans thema. Onze rode draad is gebaseerd op audiovisuele archieven gefilmd in Brussel in de jaren 1970 en 1990. De evolutie van de discretie van gesloten plaatsen naar vrijheid in de publieke ruimte zal worden ge\u00efllustreerd in liederen die allemaal een link hebben met het thema van dans of emancipatie.","performers":"Sing Out Brussels! (The Fabulous Queer Choir)","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/530407.html"},"en":{"name":"Dance with pride","shortdescr":"The LGBTQI+ community appropriated dance as a means of protest and emancipation very early on. The evolution from the discretion of closed places to freedom in the public space will be illustrated with audiovisual archives filmed in Brussels in the 1970s and 1990s, and of course with songs that all have a link with the theme of dance or emancipation.","longdescr":"The LGBTQI + community very early on adopted dance as a means of advocacy and emancipation. In the closed spaces of bars and nightclubs, this community could express itself in safe places, where everyone was free to be themselves, and by choosing their dance partners regardless of their gender. The most famous example is undoubtedly the culture of voguing, developed by the Latin and black American LGBTQI + community and which inspired Madonna to her hit \u201cVogue\u201d in the early 90s, the film \u201cParis is burning\u201d, and more recently the series \u201cPose\u201d currently airing on Netflix. \r\n\r\nIn Brussels, at the same time, gay and lesbian bars were also spaces of freedom and security, places of celebration, of seduction, of pride, through music and dance\u2026 until daylight. where the community took to the streets to claim their place in the public space, on the occasion of the first Brussels Pride in 1995. \r\n\r\nSince then, the LGBTQI + community has come a long way and Belgium is recognized as one of the most progressive countries in the world while Brussels is unmistakably gay-friendly. Yet today, being yourself in public space still sometimes poses a risk. The duality has not disappeared and some prefer or still need the security of confined spaces. \r\n\r\nSing Out Brussels! (The Fabulous Queer Choir) will illustrate this debate and this path towards emancipation and freedom through the dance theme. Our thread is based on audiovisual archives filmed in Brussels in the 1970s and 1990s. The evolution from the discretion of closed places to freedom in the public space will be illustrated in songs that all have a link with the theme of dance or emancipation.","performers":"Sing Out Brussels! (The Fabulous Queer Choir)","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/530407.html"},"de":{"name":"Dance with pride","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/530407.html"},"it":{"name":"Dance with pride","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/530407.html"},"sp":{"name":"Dance with pride","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/530407.html"},"pt":{"name":"Dance with pride","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/530407.html"},"cn":{"name":"Dance with pride","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/530407.html"}},"place":{"id":7929,"translations":{"fr":{"name":"Centre Culturel d'Uccle","address_street_name":"Rue Rouge","address_street_number":"47","address_street_box":null,"email":"reservation@ccu.be","website":"http:\/\/www.ccu.be","phone_contact":"+32 2 374 64 84","phone_booking":"+32 2 374 64 84","address_zip":"1180","address_city":"Uccle","address_line1":"Rue Rouge, 47","address_line2":"1180 Uccle","description_web":"Le Centre culturel d\u2019Uccle est contemporain de l\u2019Atomium. Con\u00e7u pour se trouver dans un \u00e9crin de verdure, face au Parc de Wolvendael, la premi\u00e8re pierre fut pos\u00e9e le 30 novembre 1957. Le Centre Culturel et Artistique d\u2019Uccle fut inaugur\u00e9 le 5 octobre 1958.\r\nLe CCU est une \u0153uvre de l\u2019architecte L\u00e9on Stynen, qui avait aussi con\u00e7u les casinos de Knokke, Blankenberge et Ostende.\r\nCe nouveau Centre Culturel permit aux soci\u00e9t\u00e9s et associations int\u00e9ress\u00e9es d\u2019organiser des bals, des conf\u00e9rences, des concerts, des projections de films, des d\u00e9bats et toutes autres manifestations culturelles et artistiques (ballets, concerts, expositions, r\u00e9ceptions, \u2026). Il proposait aussi des repr\u00e9sentations th\u00e9\u00e2trales, un cycle de conf\u00e9rences et des spectacles musicaux.\r\nL'ensemble du b\u00e2timent abrite principalement un hall d\u2019entr\u00e9e donnant acc\u00e8s \u00e0 une grande Salle de Spectacle de 800 fauteuils, un Grand Foyer pouvant accueillir jusqu'\u00e0 400 personnes assises, ainsi qu'un Petit Foyer pouvant contenir 120 personnes.\r\nPlus de cinquante ans apr\u00e8s sa cr\u00e9ation, le Centre Culturel d\u2019Uccle r\u00e9nov\u00e9 a un look \u00e0 la fois contemporain et chaleureux. Pleinement actif, il r\u00e9pond aux d\u00e9fis culturels de son si\u00e8cle en accueillant les plus grands noms du th\u00e9\u00e2tre, de la danse, de la chanson et de la musique ainsi que des artistes et des conf\u00e9renciers de renom. Il s\u2019est constamment modernis\u00e9 pour offrir \u00e0 son public une vie culturelle de qualit\u00e9 au c\u0153ur de la commune d\u2019Uccle.\r\nDirig\u00e9 par une \u00e9quipe dynamique, le CCU met tout en \u0153uvre pour fid\u00e9liser sa client\u00e8le et conqu\u00e9rir sans cesse un public nouveau.\r\nLe Centre Culturel d\u2019Uccle en quelques chiffres, c\u2019est\u2026\r\n-\tUn des plus grands centres culturels \u00e0 Bruxelles et ses environs\r\n-\tUn rendez-vous des professionnels du spectacle\r\n-\t4 espaces bien distincts (Hall, Grand Foyer, Petit Foyer, Salle de Spectacle)\r\n-\tUne salle de spectacle de 800 places\r\n-\tUn gradin r\u00e9tractable de 172 places\r\n-\t200 activit\u00e9s par an\r\n-\t600 artistes par saison\r\n-\t60.000 spectateurs par an\r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"CC Ukkel","address_street_name":"Rodestraat","address_street_number":"47","address_street_box":null,"email":"info@ccu.be","website":"http:\/\/www.ccu.be","phone_contact":"+32 2 374 64 84","phone_booking":"+32 2 374 64 84","address_zip":"1180","address_city":"Ukkel","address_line1":"Rodestraat, 47","address_line2":"1180 Ukkel","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Centre Culturel d'Uccle","address_street_name":"Rue Rouge","address_street_number":"47","address_street_box":null,"email":"reservation@ccu.be","website":"http:\/\/www.ccu.be","phone_contact":"+32 2 374 64 84","phone_booking":"+32 2 374 64 84","address_zip":"1180","address_city":"Uccle","address_line1":"Rue Rouge, 47","address_line2":"1180 Uccle","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Centre Culturel d'Uccle","address_street_name":"Rue Rouge","address_street_number":"47","address_street_box":null,"email":"reservation@ccu.be","website":"http:\/\/www.ccu.be","phone_contact":"+32 2 374 64 84","phone_booking":"+32 2 374 64 84","address_zip":"1180","address_city":"Uccle","address_line1":"Rue Rouge, 47","address_line2":"1180 Uccle","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Centre Culturel d'Uccle","address_street_name":"Rue Rouge","address_street_number":"47","address_street_box":null,"email":"reservation@ccu.be","website":"http:\/\/www.ccu.be","phone_contact":"+32 2 374 64 84","phone_booking":"+32 2 374 64 84","address_zip":"1180","addr