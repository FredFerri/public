vents":[],"parent_events":[],"targets":{"list":[11,8,19,16,10],"translations":{"fr":["Famille","Jeunes 15-18 ans","Enseignants","Ecoles","Seniors"],"nl":["Familie","Jongeren 15-18 j.","Leerkrachten","Scholen","Senioren"],"en":["Family","Youth 15-18  yr.","Teachers","Schools","Seniors"]}},"tags":["kids"],"accessibilities":{"list":[255,259,261,263,265,266],"translations":{"fr":["Accessible","Chien d'assistance","Parking accessible","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9","Brussels Health Safety Label"],"nl":["Toegankelijk","Assistentiehonden","Toegankelijke parking","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet","Brussels Health Safety Label"],"en":["Accessible","Assistance dogs","Accessible parking","Accessible to pedestrians with mobility aids","Adapted toilet","Brussels Health Safety Label"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-06-10T01:37:02+02:00","published_at":"2022-05-23T09:17:26+02:00","backoffice_id":254116,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.28543716208189},{"id":512749,"date_start":"2022-05-13","date_end":"2022-06-25","date_next":"2022-06-10","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre"}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Bella figura","shortdescr":null,"longdescr":"Boris n\u2019a rien trouv\u00e9 de mieux que d\u2019emmener sa maitresse dans un restaurant recommand\u00e9 par sa femme. Ils se disputent et en faisant marche arri\u00e8re, il renverse Yvonne, la belle-m\u00e8re de la meilleure amie de sa femme (vous me suivez ?). En partant d\u2019une situation anecdotique, se d\u00e9roule le fil d\u2019une tragicom\u00e9die de la bonne convenance. Faire \u00ab bonne figure \u00bb est le dernier rempart, mais tr\u00e8s vite les \u00e9motions l\u2019emportent sur la biens\u00e9ance et la soir\u00e9e tourne au carnage.\r\n\r\nYasmina Reza prend un malin plaisir \u00e0 faire tomber les masques et personne ne sortira indemne d\u2019un jeu social et amoureux \u00e0 la cruaut\u00e9 ordinaire. C\u2019est tragique, impitoyable et on rit aux \u00e9clats. Reza l\u2019inclassable, pose un regard lucide sur les faiblesses et l\u2019hypocrisie de nos soci\u00e9t\u00e9s bourgeoises, et, sans concession, se plait \u00e0 traquer le drame des \u00eatres sous le vernis de la bonne convenance.\r\n\r\napr\u00e8s avoir mis en sc\u00e8ne avec grand succ\u00e8s Le Dieu du carnage, Michel Kacenelenbogen remet le couvert et d\u00e9couvre sous cette Bella Figura, une com\u00e9die faussement l\u00e9g\u00e8re et hautement explosive.\r\n\r\nUne production du Th\u00e9\u00e2tre Le Public. Avec le soutien du Tax Shelter de L\u2019\u00c9tat F\u00e9d\u00e9ral Belge via Belga Films Fund et de la Communaut\u00e9 Fran\u00e7aise.","performers":"De Yasmina Reza | Mise en sc\u00e8ne Michel Kacenelenbogen | Avec Janine Godinas, Nicolas Buysse, Jeanne Kacenelenbogen, Michelangelo Marchese, Nicole Oliver | Assistante \u00e0 la mise en sc\u00e8ne H\u00e9l\u00e8ne Catsaras | Sc\u00e9nographie Renata Gorka | Costumes B\u00e9a Pendesini | Lumi\u00e8re Laurent Kaye | Musique originale Pascal Charpentier","boxoffice_url":null,"website":"http:\/\/www.theatrelepublic.be","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 80 09 44 44","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/512749.html"},"nl":{"name":"Bella figura","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/512749.html"},"en":{"name":"Bella figura","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/512749.html"},"de":{"name":"Bella figura","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/512749.html"},"it":{"name":"Bella figura","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/512749.html"},"sp":{"name":"Bella figura","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/512749.html"},"pt":{"name":"Bella figura","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/512749.html"},"cn":{"name":"Bella figura","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/512749.html"}},"place":{"id":224476,"translations":{"fr":{"name":"Th\u00e9\u00e2tre Le Public","address_street_name":"Rue Braemt","address_street_number":"64 70","address_street_box":null,"email":"contact@theatrelepublic.be","website":"http:\/\/www.theatrelepublic.be","phone_contact":"+32 2 724 24 44","phone_booking":"+32 2 724 24 44","address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Braemt, 64 70","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"Install\u00e9 dans les anciennes brasseries Aerts de Saint-Josse depuis 1994, le Th\u00e9\u00e2tre Le Public a la volont\u00e9 de proposer un th\u00e9\u00e2tre de qualit\u00e9 en pr\u00e9sentant des \u0153uvres contemporaines autant que les grands textes du r\u00e9pertoire. Une large place est faite aux auteurs, acteurs et artistes de Belgique dans ce th\u00e9\u00e2tre qui se compose de trois salles de spectacle et de deux restaurants.\r\nN\u00e9 de la passion, de la volont\u00e9 et des r\u00eaves un peu fous de deux artistes, Patricia Ide et Michel Kacenelenbogen, le Th\u00e9\u00e2tre Le Public est un lieu o\u00f9 se m\u00ealent diff\u00e9rentes familles th\u00e9\u00e2trales. Un lieu o\u00f9 s\u2019invente une relation chaleureuse entre les acteurs et les spectateurs.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Th\u00e9\u00e2tre Le Public","address_street_name":"Braemtstraat","address_street_number":"64 70","address_street_box":null,"email":"info@theatrelepublic.be","website":"http:\/\/www.theatrelepublic.be","phone_contact":"+32 2 724 24 44","phone_booking":"+32 2 724 24 44","address_zip":"1210","address_city":"Sint-Joost-Ten-Node","address_line1":"Braemtstraat, 64 70","address_line2":"1210 Sint-Joost-Ten-Node","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Th\u00e9\u00e2tre Le Public","address_street_name":"Rue Braemt","address_street_number":"64 70","address_street_box":null,"email":"contact@theatrelepublic.be","website":"http:\/\/www.theatrelepublic.be","phone_contact":"+32 2 724 24 44","phone_booking":"+32 2 724 24 44","address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Braemt, 64 70","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Th\u00e9\u00e2tre Le Public","address_stree