ssibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-10T11:38:17+02:00","published_at":"2021-11-27T13:47:07+01:00","backoffice_id":243551,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.1360618895014},{"id":508844,"date_start":"2022-10-30","date_end":"2022-10-30","date_next":"2022-10-30","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert","de":"Konzert"}},"others":{"list":[4,7],"translations":{"fr":["Pop, rock, jazz\u2026","Pop, Rock"],"nl":["Pop, rock, jazz\u2026","Pop, Rock"],"en":["Pop, rock, jazz\u2026","Pop, Rock"],"de":["Pop, Rock, Jazz...","Pop, Rock"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"I Like Trains - Delwood","shortdescr":"Un nouvel album apr\u00e8s 8 ann\u00e9es d'absence.","longdescr":"Apr\u00e8s huit ans d\u2019absence, les anglais de Leeds reviennent sur le devant de la sc\u00e8ne avec \u00ab Kompromat \u00bb, un nouvel album qui raconte encore et toujours l\u2019Angleterre en souffrance. I Like Trains, qu\u2019on \u00e9crivait il y a quelques ann\u00e9es iLiKETRAiNS, propose ici un disque rageur, un coup de poing, un bilan. Un opus construit comme un album et non pas comme une suite d\u00e9cousue de titres \u00e0 l\u2019emporte-pi\u00e8ce. V\u00e9ritable recueil de chansons nerveuses, m\u00e9lancolique et urgentes. La bande men\u00e9e par David Martin m\u00e9lange ici aussi bien les univers de The Fall que de Joy Division \u00e0 un rock plus m\u00e9lodique fa\u00e7on Interpol. Le r\u00e9sultat est tout simplement brillant.\r\n\r\nDELWOOD\r\nEntreprise de menuiserie alternative fond\u00e9e d\u00e9but 2019 par les fr\u00e8res Dubois (Frank Shinobi, Ta\u00effun, ensemble dans Coastline Truckers), Delwood cr\u00e9e des pi\u00e8ces uniques \u00e0 partir d\u2019essences diverses plant\u00e9es dans les ann\u00e9es 90-2000 : Do Make Say Think, Tortoise, Dead Man Ray, Archive, Motorpsycho, Modest Mouse, From Monument to Masses... autant de mat\u00e9riaux propices \u00e0 un upcycling cr\u00e9atif par cet ensemblier indie rock charpent\u00e9 par les sonorit\u00e9s distinctes de deux guitares basses.\r\n\r\nCin\u00e9matique, la musique de Delwood est celle de 4 artisans en qu\u00eate de sens, aimant \u00e0 s\u2019engouffrer dans des for\u00eats obscures. Au fil de l\u2019avanc\u00e9e se taillent des instrumentaux \u00e9volutifs sur lesquels viennent se poser des chants aux textes fouill\u00e9s. De la masse s\u2019\u00e9chappe tant\u00f4t une touche jazzy, tant\u00f4t des ambiances psych\u00e9d\u00e9liques rendues par un travail de sampling et de nappes de clavier sculpt\u00e9es.\r\n\r\nDelwood, de la fine \u00e9b\u00e9nisterie pour un 1er album \u00e9ponyme enregistr\u00e9 en avril 2021 par John Roo (le visage de \u2018Laurent\u2019, le 3e It Anita), produit de main de ma\u00eetre par Boris Gronemberger (frontman de River into lake, batteur de Castus, vu dans Girls in Hawa\u00ef, Fran\u00e7oiz Breut...). S\u2019y expriment \u00e9galement les talents de Cl\u00e9ment Dechambre (The Brums \u2013 sax et clarinette basse) et Damien Chierici (Dan San \u2013 violon). 10 titres pour une 22e sortie pour le label li\u00e9geois Honest House (Mambo, Frank Shinobi, Ta\u00effun, Beno\u00eet Lizen, It It Anita...), parue le 5 novembre 2021.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.botanique.be","email":"info@botanique.be","phone_contact":"+32 2 218 37 32","phone_booking":"+32 2 218 37 32","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.508844"},"nl":{"name":"I Like Trains - Delwood","shortdescr":"Britse post-punkers doen wars van trends hun eigen donkere ding.","longdescr":"Na acht jaar afwezigheid keren de Britten van I Like Trains terug met 'Kompromat', een album waarop de band uit Leeds een verhaal vertelt over een noodlijdend Verenigd Koninkrijk. De groep (vroeger bekend als iLIKETRAiNS) uit haar woede in een plaat die voelt als een mokerslag, opgebouwd als een coherent werk en niet gewoon als een selectie singles. Met nerveuze, melancholische en urgente nummers verenigen David Martin en co invloeden van The Fall, Joy Division en meer melodieuze rock als die van Interpol. Ze zijn altijd te donker en te eigenzinnig geweest om echt hip te zijn, maar dat is ook hier weer de sterkte van deze unieke band; ze doen gewoon hun eigen intense ding en dat kunnen we alleen maar toejuichen.\r\n\r\nDELWOOD\r\nDelwood is een vierkoppige band uit ons land, opgebouwd rond de broertjes Dubois en hun verstrengelde basgitaren. Aangevuld met drummer, synths en electronica doet de groep denken aan acts als Dead Man Ray, Tortoise en Archive. Hun meest recente album werd gemixt door John Roo (It It Anita) en geproducet door Boris Gronemberger (River Into Lake).","performers":null,"boxoffice_url":null,"website":"https:\/\/botanique.be\/fr\/concert\/i-trains-i-reporte-2022","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.508844"},"en":{"name":"I Like Trains - Delwood","shortdescr":"A new album after 8 years of absence.","longdescr":"Over 10 years on from their beginnings, through their re-telling of some of western history\u2019s most idiosyncratically bleak tales of human interest, to their realisation of humanity lying prostrate at the hands of environmental and technological factors far greater than us, I LIKE TRAINS have been transfixed by the art of survival. A group who stood apart from the crowd even as their adopted home of Leeds enjoyed its hype boom and bust years during the mid-noughties. Under the microscope of the wider media during its \u2018New Yorkshire\u2019 era, they have never really been fashionable: too surly, too bleak, too stubborn to follow the pre-meditated narrative placed on them by their critics and peers. They have not cared for escapism even as they voyage through an age of it; their albums have confronted head-on fears that most people choose to switch off, turn over and click away from, prolonging and intensifying reality\u2019s inevitable impact.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.508844"},"de":{"name":"I Like Trains","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.508844"},"it":{"name":"I Like Trains","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.508844"},"sp":{"name":"I Like Trains","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.508844"},"pt":{"name":"I Like Trains","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.508844"},"cn":{"name":"I Like Trains","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.508844"}},"place":{"id":11,"translations":{"fr":{"name":"Botanique","address_street_name":"Rue Royale","address_street_number":"236","address_street_box":null,"email":"info@botanique.be","website":"http:\/\/www.botanique.be","phone_contact":"+32 2 218 37 32","phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Royale, 236","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"L\u2019\u00e9l\u00e9gant Centre Culturel de la Communaut\u00e9 fran\u00e7aise est joliment situ\u00e9 dans les anciens jardins botaniques pr\u00e8s de la petite ceinture de Bruxelles. Vous pouvez assister \u00e0 des concerts dans les espaces intimes \u00e0 l\u2019ambiance chaleureuse, dont  les plus connus sont l\u2019Orangerie, la Rotonde, le Mus\u00e9e et le Witloof Bar. \r\n\r\n","description_print":"","booking_url":null,"sort_order":"BOTANIQUE","virtual_visit":null},"nl":{"name":"Botanique","address_street_name":"Koningsstraat","address_street_number":"236","address_street_box":null,"email":"info@botanique.be","website":"http:\/\/www.botanique.be","phone_contact":"+32 2 218 37 32","phone_booking":null,"address_zip":"1210","address_city":"Sint-Joost-Ten-Node","address_line1":"Koningsstraat, 236","address_line2":"1210 Sint-Joost-Ten-Node","description_web":"In de voormalige botanische tuinen aan de kleine ring, thans het klassevolle cultuurcentrum van de Franse Gemeenschap, is het goed toeven. Concerten vinden er plaats op een unieke locatie, in sfeervolle en intieme ruimtes. De kwalitatieve eclectische programmatie staat zeer open voor nieuwe trends.","description_print":"","booking_url":null,"sort_order":"BOTANIQUE","virtual_visit":null},"en":{"name":"Botanique","address_street_name":"Rue Royale","address_street_number":"236","address_street_box":null,"email":"info@botanique.be","website":"http:\/\/www.botanique.be","phone_contact":"+32 2 218 37 32","phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Royale, 236","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"The former botanical gardens provide the unique location for the stylish cultural centre of the French community and are a great place to relax. Concerts are held in the intimate surroundings of its eight spaces and multipurpose halls, of which the most famous are the Orangerie, the Rotonde, the Museum, and the Witloof Bar.\r\n","description_print":"","booking_url":null,"sort_order":"BOTANIQUE","virtual_visit":null},"de":{"name":"Botanique","address_street_name":"Rue Royale","address_street_number":"236","address_street_box":null,"email":"info@botanique.be","website":"http:\/\/www.botanique.be","phone_contact":"+32 2 218 37 32","phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Royale, 236","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"Le Botanique z\u00e4hlt ohne Zweifel zu den sch\u00f6nsten und spektakul\u00e4rsten Veranstaltungsorten Br\u00fcssels. Das von 1826 bis 1829 von der \u201eSoci\u00e9t\u00e9 Royale d'Horticulture\u201c erbaute, ehemalige Gew\u00e4chshaus im neoklassizistischen Stil mit Eisen- und Glasarchitektur beherbergt seit 1984 einen hochkar\u00e4tigen Veranstaltungsort.\r\n\r\nInmitten des botanischen Gartens von Saint-Josse-ten-Noode, einer der 19 Br\u00fcsseler Gemeinden, w\u00e4chst und gedeiht heute ein quicklebendiger Ort der Kultur, der vor allem f\u00fcr Musikveranstaltungen, als Galerie und Caf\u00e9 genutzt wird. H\u00f6hepunkt des Jahres bildet im Fr\u00fchling das Musikfestival \u201eLes Nuits Botaniques\".","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Botanique","address_street_name":"Rue Royale","address_street_number":"236","address_street_box":null,"email":"info@botanique.be","website":"http:\/\/www.botanique.be","phone_contact":"+32 2 218 37 32","phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Royale, 236","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"Questo grande edificio, che doveva ospitare le collezioni di un precedente giardino botanico, \u00e8 stato costruito fra il 1826 ed il 1829. L'artista-arredatore Pierre-Fran\u00e7ois Gineste diresse i lavori secondo progetto dell'architetto Tilman-Fran\u00e7ois Suys. Rispettando la struttura tradizionale degli aranceti, ha immaginato un'imponente cupola rotonda centrale, affiancata da due ali ciascuna delle quali terminante in un padiglione leggermente sporgente. Grazie alla sua regolarit\u00e0 e semplicit\u00e0, la costruzione illustra perfettamente i principi dello stile neoclassico. Alle vetrate che riempiono gli spazi tra le colonne della sala circolare e che coprono il portico delimitato dal colonnato stesso, si aggiungono le serre adiacenti alle ali laterali. Inizialmente si era pensato di organizzare feste all'interno di questo ambiente magico, e a questo scopo venne allestita una grande sala fra l'aranceto orientale e la sala rotonda, ma questa diventer\u00e0 poi la sala degli erbari dal 1870. Fino al 1939, l'edificio verr\u00e0 utilizzato per il suo scopo originale. Riacquistato dallo Stato nel 1970, il locale diventer\u00e0 il Centro Culturale della Federazione Vallonia-Bruxelles e verr\u00e0 inaugurato come tale nel 1984. Oggi ospita numerosi eventi culturali dedicati all'arte contemporanea e vi si svolgono festival, tra i quali il famoso Nuits du Botanique, che hanno contribuito ad affermare la sua reputazione. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Botanique","address_street_name":"Rue Royale","address_street_number":"236","address_street_box":null,"email":"info@botanique.be","website":"http:\/\/www.botanique.be","phone_contact":"+32 2 218 37 32","phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Royale, 236","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"Este enorme edificio, pensado para albergar las colecciones de un antiguo jard\u00edn bot\u00e1nico, fue construido entre 1826 y 1829. El artista-decorador Pierre-Fran\u00e7ois Gineste dirigi\u00f3 las obras a partir de los planos del arquitecto Tilman-Fran\u00e7ois Suys. Respetando la estructura tradicional de los invernaderos de naranjas, imagin\u00f3 una imponente rotonda central con c\u00fapula flanqueada por dos pasillos que terminaban en un pabell\u00f3n ligeramente en relieve. Gracias a su regularidad y simplicidad, la elevaci\u00f3n ilustra a la perfecci\u00f3n los principios del estilo neocl\u00e1sico. Las vidrieras situadas en los intercolumnios de la rotonda y que cubren el p\u00f3rtico delimitado por esta misma columnata se suman a los invernaderos adosados a los pasillos laterales. Pronto se pens\u00f3 en organizar fiestas en este lugar m\u00e1gico, para lo cual se acondicion\u00f3 una sala entre el invernadero de naranjas oriental y la rotonda, pero a partir de 1870 se convirti\u00f3 en la sala de los herbarios. Hasta 1939 cumpli\u00f3 las funciones teniendo en cuenta su vocaci\u00f3n inicial. Recomprado por el Estado en 1970, el lugar se convirti\u00f3 en el centro cultural de la Federaci\u00f3n Valonia-Bruselas y se inaugur\u00f3 como tal en 1984. A d\u00eda de hoy este lugar alberga numerosas manifestaciones culturales dedicadas a la creaci\u00f3n contempor\u00e1nea y se ha vuelto prestigioso por los festivales que se celebran en \u00e9l, tales como las \u00abNoches del bot\u00e1nico\u00bb. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Botanique","address_street_name":"Rue Royale","address_street_number":"236","address_street_box":null,"email":"info@botanique.be","website":"http:\/\/www.botanique.be","phone_contact":"+32 2 218 37 32","phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Royale, 236","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Botanique","address_street_name":"Rue Royale","address_street_number":"236","address_street_box":null,"email":"info@botanique.be","website":"http:\/\/www.botanique.be","phone_contact":"+32 2 218 37 32","phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Royale, 236","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[15],"translations":{"fr":["Rogier"],"nl":["Rogier"],"en":["Rogier"]}},"zones":{"list":[20],"translations":{"fr":["Nord"],"nl":["Noord"],"en":["North"]}},"neca":"art_center","facebook_id":null,"backoffice_id":5,"location":{"lat":50.85461438,"lon":4.36620044},"region":"brussels","last_updated_at":"2022-10-11T02:05:18+02:00","published_at":"2013-10-19T01:13:13+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":11,"translations":{"fr":{"name":"Botanique","address_street_name":"Rue Royale","address_street_number":"236","address_street_box":null,"email":"info@botanique.be","website":"http:\/\/www.botanique.be","phone_contact":"+32 2 218 37 32","phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Royale, 236","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"L\u2019\u00e9l\u00e9gant Centre Culturel de la Communaut\u00e9 fran\u00e7aise est joliment situ\u00e9 dans les anciens jardins botaniques pr\u00e8s de la petite ceinture de Bruxelles. Vous pouvez assister \u00e0 des concerts dans les espaces intimes \u00e0 l\u2019ambiance chaleureuse, dont  les plus connus sont l\u2019Orangerie, la Rotonde, le Mus\u00e9e et le Witloof Bar. \r\n\r\n","description_print":"","booking_url":null,"sort_order":"BOTANIQUE","virtual_visit":null},"nl":{"name":"Botanique","address_street_name":"Koningsstraat","address_street_number":"236","address_street_box":null,"email":"info@botanique.be","website":"http:\/\/www.botanique.be","phone_contact":"+32 2 218 37 32","phone_booking":null,"address_zip":"1210","address_city":"Sint-Joost-Ten-Node","address_line1":"Koningsstraat, 236","address_line2":"1210 Sint-Joost-Ten-Node","description_web":"In de voormalige botanische tuinen aan de kleine ring, thans het klassevolle cultuurcentrum van de Franse Gemeenschap, is het goed toeven. Concerten vinden er plaats op een unieke locatie, in sfeervolle en intieme ruimtes. De kwalitatieve eclectische programmatie staat zeer open voor nieuwe trends.","description_print":"","booking_url":null,"sort_order":"BOTANIQUE","virtual_visit":null},"en":{"name":"Botanique","address_street_name":"Rue Royale","address_street_number":"236","address_street_box":null,"email":"info@botanique.be","website":"http:\/\/www.botanique.be","phone_contact":"+32 2 218 37 32","phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Royale, 236","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"The former botanical gardens provide the unique location for the stylish cultural centre of the French community and are a great place to relax. Concerts are held in the intimate surroundings of its eight spaces and multipurpose halls, of which the most famous are the Orangerie, the Rotonde, the Museum, and the Witloof Bar.\r\n","description_print":"","booking_url":null,"sort_order":"BOTANIQUE","virtual_visit":null},"de":{"name":"Botanique","address_street_name":"Rue Royale","address_street_number":"236","address_street_box":null,"email":"info@botanique.be","website":"http:\/\/www.botanique.be","phone_contact":"+32 2 218 37 32","phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Royale, 236","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"Le Botanique z\u00e4hlt ohne Zweifel zu den sch\u00f6nsten und spektakul\u00e4rsten Veranstaltungsorten Br\u00fcssels. Das von 1826 bis 1829 von der \u201eSoci\u00e9t\u00e9 Royale d'Horticulture\u201c erbaute, ehemalige Gew\u00e4chshaus im neoklassizistischen Stil mit Eisen- und Glasarchitektur beherbergt seit 1984 einen hochkar\u00e4tigen Veranstaltungsort.\r\n\r\nInmitten des botanischen Gartens von Saint-Josse-ten-Noode, einer der 19 Br\u00fcsseler Gemeinden, w\u00e4chst und gedeiht heute ein quicklebendiger Ort der Kultur, der vor allem f\u00fcr Musikveranstaltungen, als Galerie und Caf\u00e9 genutzt wird. H\u00f6hepunkt des Jahres bildet im Fr\u00fchling das Musikfestival \u201eLes Nuits Botaniques\".","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Botanique","address_street_name":"Rue Royale","address_street_number":"236","address_street_box":null,"email":"info@botanique.be","website":"http:\/\/www.botanique.be","phone_contact":"+32 2 218 37 32","phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Royale, 236","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"Questo grande edificio, che doveva ospitare le collezioni di un precedente giardino botanico, \u00e8 stato costruito fra il 1826 ed il 1829. L'artista-arredatore Pierre-Fran\u00e7ois Gineste diresse i lavori secondo progetto dell'architetto Tilman-Fran\u00e7ois Suys. Rispettando la struttura tradizionale degli aranceti, ha immaginato un'imponente cupola rotonda centrale, affiancata da due ali ciascuna delle quali terminante in un padiglione leggermente sporgente. Grazie alla sua regolarit\u00e0 e semplicit\u00e0, la costruzione illustra perfettamente i principi dello stile neoclassico. Alle vetrate che riempiono gli spazi tra le colonne della sala circolare e che coprono il portico delimitato dal colonnato stesso, si aggiungono le serre adiacenti alle ali laterali. Inizialmente si era pensato di organizzare feste all'interno di questo ambiente magico, e a questo scopo venne allestita una grande sala fra l'aranceto orientale e la sala rotonda, ma questa diventer\u00e0 poi la sala degli erbari dal 1870. Fino al 1939, l'edificio verr\u00e0 utilizzato per il suo scopo originale. Riacquistato dallo Stato nel 1970, il locale diventer\u00e0 il Centro Culturale della Federazione Vallonia-Bruxelles e verr\u00e0 inaugurato come tale nel 1984. Oggi ospita numerosi eventi culturali dedicati all'arte contemporanea e vi si svolgono festival, tra i quali il famoso Nuits du Botanique, che hanno contribuito ad affermare la sua reputazione. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Botanique","address_street_name":"Rue Royale","address_street_number":"236","address_street_box":null,"email":"info@botanique.be","website":"http:\/\/www.botanique.be","phone_contact":"+32 2 218 37 32","phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Royale, 236","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"Este enorme edificio, pensado para albergar las colecciones de un antiguo jard\u00edn bot\u00e1nico, fue construido entre 1826 y 1829. El artista-decorador Pierre-Fran\u00e7ois Gineste dirigi\u00f3 las obras a partir de los planos del arquitecto Tilman-Fran\u00e7ois Suys. Respetando la estructura tradicional de los invernaderos de naranjas, imagin\u00f3 una imponente rotonda central con c\u00fapula flanqueada por dos pasillos que terminaban en un pabell\u00f3n ligeramente en relieve. Gracias a su regularidad y simplicidad, la elevaci\u00f3n ilustra a la perfecci\u00f3n los principios del estilo neocl\u00e1sico. Las vidrieras situadas en los intercolumnios de la rotonda y que cubren el p\u00f3rtico delimitado por esta misma columnata se suman a los invernaderos adosados a los pasillos laterales. Pronto se pens\u00f3 en organizar fiestas en este lugar m\u00e1gico, para lo cual se acondicion\u00f3 una sala entre el invernadero de naranjas oriental y la rotonda, pero a partir de 1870 se convirti\u00f3 en la sala de los herbarios. Hasta 1939 cumpli\u00f3 las funciones teniendo en cuenta su vocaci\u00f3n inicial. Recomprado por el Estado en 1970, el lugar se convirti\u00f3 en el centro cultural de la Federaci\u00f3n Valonia-Bruselas y se inaugur\u00f3 como tal en 1984. A d\u00eda de hoy este lugar alberga numerosas manifestaciones culturales dedicadas a la creaci\u00f3n contempor\u00e1nea y se ha vuelto prestigioso por los festivales que se celebran en \u00e9l, tales como las \u00abNoches del bot\u00e1nico\u00bb. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Botanique","address_street_name":"Rue Royale","address_street_number":"236","address_street_box":null,"email":"info@botanique.be","website":"http:\/\/www.botanique.be","phone_contact":"+32 2 218 37 32","phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Royale, 236","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Botanique","address_street_name":"Rue Royale","address_street_number":"236","address_street_box":null,"email":"info@botanique.be","website":"http:\/\/www.botanique.be","phone_contact":"+32 2 218 37 32","phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Royale, 236","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":"art_center","facebook_id":null,"backoffice_id":5,"location":{"lat":50.85461438,"lon":4.36620044},"region":"brussels","last_updated_at":"2022-10-11T02:05:18+02:00","published_at":"2013-10-19T01:13:13+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/7f7