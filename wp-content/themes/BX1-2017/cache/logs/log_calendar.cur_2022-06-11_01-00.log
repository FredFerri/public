false,"is_canceled":false},{"day":"2022-04-02","doors":"10:30:00","start":"10:30:00","end":"14:30:00","is_soldout":false,"is_canceled":false},{"day":"2022-05-07","doors":null,"start":"10:30:00","end":"14:30:00","is_soldout":true,"is_canceled":false},{"day":"2022-06-04","doors":null,"start":"10:30:00","end":"14:30:00","is_soldout":false,"is_canceled":false},{"day":"2022-07-02","doors":null,"start":"10:30:00","end":"14:30:00","is_soldout":true,"is_canceled":false},{"day":"2022-08-06","doors":null,"start":"10:30:00","end":"14:30:00","is_soldout":false,"is_canceled":false},{"day":"2022-09-10","doors":null,"start":"10:30:00","end":"14:30:00","is_soldout":false,"is_canceled":false},{"day":"2022-10-01","doors":null,"start":"10:30:00","end":"14:30:00","is_soldout":false,"is_canceled":false},{"day":"2022-11-05","doors":null,"start":"10:30:00","end":"14:30:00","is_soldout":false,"is_canceled":false},{"day":"2022-12-03","doors":null,"start":"10:30:00","end":"14:30:00","is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":65}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"visit_profile":{"list":[323],"translations":{"fr":["Gastronomie"],"nl":["Gastronomie"],"en":["Gastronomy"]}},"tags":["exterior"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-06-08T18:05:06+02:00","published_at":"2021-09-07T17:12:07+02:00","backoffice_id":238572,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.13269424171239},{"id":533274,"date_start":"2022-06-05","date_end":"2022-09-04","date_next":"2022-07-03","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre"}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"En route !","shortdescr":"Une route, une voiture et quelques heures \u00e0 y passer. Une bulle d\u2019intimit\u00e9 de quelques m\u00e8tres cubes. Dans ce road trip improvis\u00e9, c\u2019est vous qui choisissez le d\u00e9part, la destination et la raison du trajet. Les personnages se baladent dans leur relation : ce qu\u2019ils n\u2019ont jamais os\u00e9 se dire, ce qui leur reste en travers de la gorge, ce qu\u2019ils ont toujours r\u00eav\u00e9 d\u2019assouvir. Attachez vos ceintures !","longdescr":"L'\u00e9t\u00e9 \u00e9tant la saison des d\u00e9parts en tout genre, l'Improviste vous propose de voyager les dimanches \u00e0 18h30 (et le samedi 25 juin \u00e0 19h) avec \"En route !\". \r\n\r\nUn road trip \u00e0 destination de leur relation\r\n\r\nUne route, une voiture et quelques heures \u00e0 y passer. Une situation si simple et pourtant si particuli\u00e8re. Dans quels autres contextes avons-nous l\u2019occasion de nous enfermer dans une bulle d\u2019intimit\u00e9 de quelques m\u00e8tres cubes, le regard \u00e0 l\u2019horizon et les pens\u00e9es en voyage ? C\u2019est dans ce cadre si banal et pourtant si fort que les 2 personnages vont \u00e9voluer.\r\nDans ce road trip th\u00e9\u00e2tral improvis\u00e9 entre humour et \u00e9motion, c\u2019est vous qui choisissez le d\u00e9part, la destination et la raison du trajet.\r\nEntre une pompe \u00e0 essence, un jeu de route et un pique-nique aux sandwichs en triangle, les personnages se baladent dans leur relation. Ce qu\u2019ils n\u2019ont jamais os\u00e9 se dire. Ce qui leur reste en travers de la gorge depuis toutes ces ann\u00e9es. Ce qu\u2019ils ont toujours r\u00eav\u00e9 d\u2019assouvir. Attachez vos ceintures !\r\n\r\nAvec en alternance :  Dominique Pattuelli, Marie-Pierre Thomas, Patrick Spadrille et Gilles Delvaulx","performers":"Dominique Pattuelli, Marie-Pierre Thomas, Patrick Spadrille et Gilles Delvaulx","boxoffice_url":null,"website":"https:\/\/www.improviste.be\/En-route.html","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/533274.html"},"nl":{"name":"En route !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/533274.html"},"en":{"name":"En route !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/533274.html"},"de":{"name":"En route !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/533274.html"},"it":{"name":"En route !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/533274.html"},"sp":{"name":"En route !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/533274.html"},"pt":{"name":"En route !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/533274.html"},"cn":{"name":"En route !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https: