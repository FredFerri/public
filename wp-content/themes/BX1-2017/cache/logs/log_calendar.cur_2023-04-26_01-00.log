rs":null,"start":"14:30:00","end":"17:00:00","is_soldout":false,"is_canceled":false},{"day":"2023-07-08","doors":null,"start":"14:30:00","end":"17:00:00","is_soldout":false,"is_canceled":false},{"day":"2023-07-22","doors":null,"start":"14:30:00","end":"17:00:00","is_soldout":false,"is_canceled":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":["exterior"],"accessibilities":{"list":[255,257],"translations":{"fr":["Accessible","Am\u00e9nagements pour personnes sourdes et malentendantes"],"nl":["Toegankelijk","Voorzieningen voor dove en slechthorende personen"],"en":["Accessible","Facilities for deaf and hearing-impaired people"],"de":["Barrierefrei","Anpassungen f\u00fcr geh\u00f6rlose und h\u00f6rgesch\u00e4digte Menschen."],"it":["Accessibile","Disposizioni per persone non udenti e ipoudenti"],"sp":["Habilitado","Equipos para personas sordas y con problemas de audici\u00f3n"],"pt":[null,null],"cn":[null,null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2023-04-16T02:36:35+02:00","published_at":"2023-03-14T09:45:17+01:00","backoffice_id":273332,"import_origin":null,"sub_type":"other","show_in_agenda":true,"ranking":0.15959586353904},{"id":551944,"date_start":"2023-02-17","date_end":"2023-12-31","date_next":"2023-04-29","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":true,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":90,"translations":{"fr":"Animations","nl":"Animaties","en":"Animations","de":"Animationen","it":"Animazioni","sp":"Animaciones","pt":null,"cn":null}},"others":{"list":[99],"translations":{"fr":["Gastronomie"],"nl":["Gastronomie"],"en":["Gastronomy"],"de":["Gastronomie"],"it":["Cucina"],"sp":["Gastronom\u00eda"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr","en"],"subtitles":[]},"translations":{"fr":{"name":"Incroyable experience dans un avion (sans ailes)","shortdescr":"Venez vivre une exp\u00e9rience hors du commun dans un ancien Avion de ligne recycl\u00e9 en salle \u00e9v\u00e8nementielle. Exp\u00e9rience visuelle, gustative et humaine avec un \u00e9quipage aux petits soins.","longdescr":"Cette offre est un forfait particuli\u00e8rement qualitatif cumulant le repas gastronomique 5 services, 3 verres de vins par personne, les caf\u00e9s\/infusions et une s\u00e9ance de 15 minutes au simulateur de vol situ\u00e9 dans le cockpit. Seule le montage vid\u00e9o est en option.\r\n\r\n Le repas se d\u00e9roule \u00e0 bord de l\u2019avion Flylounge qui est \u00e9quip\u00e9 de 6 tables pour 2 \u00e0 6 personnes. Une premi\u00e8re mondiale avec le soutien de la R\u00e9gion de Bruxelles-Capitale et de visit.brussels. Le simulateur de vol est accessible en passant la porte du cockpit.\r\n\r\nPr\u00eat pour partager une exp\u00e9rience inoubliable entre amis? Ne ratez pas cette offre particuli\u00e8rement originale dans un ancien Airbus A319. Lumi\u00e8re l\u00e9g\u00e8rement tamis\u00e9e, ambiance sonore, service premi\u00e8re classe... De quoi combler les plus exigeants et vous faire oublier la morosit\u00e9 ambiante en survolant la terre \u00e0 39.000ft!","performers":"Alain Loiseau, fondateur du Flylounge, concept unique au monde","boxoffice_url":null,"website":"https:\/\/www.flylounge.com","email":"contact@flylounge.com","phone_contact":"+32 2 318 00 47","phone_booking":"+32 2 318 00 47","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.551944"},"nl":{"name":"Ongelooflijke ervaring in een vliegtuig (zonder vleugels)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.flylounge.com","email":"contact@flylounge.com","phone_contact":"+32 2 318 00 47","phone_booking":"+32 2 318 00 47","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.551944"},"en":{"name":"Incredible experience in a plane (without wings)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.flylounge.com","email":"contact@flylounge.com","phone_contact":"+32 2 318 00 47","phone_booking":"+32 2 318 00 47","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.551944"},"de":{"name":"Incroyable experience dans un avion (sans ailes)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.flylounge.com","email":"contact@flylounge.com","phone_contact":"+32 2 318 00 47","phone_booking":"+32 2 318 00 47","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.551944"},"it":{"name":"Incroyable experience dans un avion (sans ailes) Repas gastronomique + forfait vin + simulateur de vol","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.flylounge.com","email":"contact@flylounge.com","phone_contact":"+32 2 318 00 47","phone_booking":"+32 2 318 00 47","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.551944"},"sp":{"name":"Incroyable experience dans un avion (sans ailes) Repas gastronomique + forfait vin + simulateur de vol","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.flylounge.com","email":"contact@flylounge.com","phone_contact":"+32 2 318 00 47","phone_booking":"+32 2 318 00 47","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.551944"},"pt":{"name":"Incroyable experience dans un avion (sans ailes) Repas gastronomique + forfait vin + simulateur de vol","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.flylounge.com","email":"contact@flylounge.com","phone_contact":"+32 2 318 00 47","phone_booking":"+32 2 318 00 47","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.551944"},"cn":{"name":"Incroyable experience dans un avion (sans ailes) Repas gastronomique + forfait vin + simulateur de vol","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.flylounge.com","email":"contact@flylounge.com","phone_contact":"+32 2 318 00 47","phone_booking":"+32 2 318 00 47","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.551944"}},"place":{"id":278012,"translations":{"fr":{"name":"Flylounge","address_street_name":"Rue du Commerce","address_street_number":"65","address_street_box":null,"email":"contact@flylounge.com","website":"https:\/\/www.flylounge.com","phone_contact":"+32 2 318 00 47","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Commerce, 65","address_line2":"1000 Bruxelles","description_web":"Embarquez sans attendre \u00e0 bord de l\u2019incroyable avion restaurant gastronomique de l'espace \u00e9v\u00e9nementiel Flylounge ! \r\n\r\nCette nouvelle exp\u00e9rience allie originalit\u00e9 de la salle, accueil chaleureux de l\u2019\u00e9quipage et d\u00e9licieux voyage culinaire. Elle est ponctu\u00e9e d\u2019animations comme des annonces passager, une visite cockpit avec option pilotage pour les plus t\u00e9m\u00e9raires, une pr\u00e9sentation du chef Daniel Dupuis et de la gen\u00e8se du flylounge\u2026\r\n\r\nLes mercredis, jeudis et vendredis soir, le chef vous propose un d\u00e9licieux repas gastronomique d\u00e9clin\u00e9 en 2 amuses bouches et 3 plats. \r\nLes samedis soir on passe \u00e0 3 amuses bouches et 3 plats avec menu particuli\u00e8rement exceptionnel puisqu\u2019il reprend ses recettes utilis\u00e9es lorsqu\u2019il travaillait pour le palais royal. Un bonheur pour tous les gastronomes curieux de se mettre dans la peau d\u2019un Roi ou d\u2019une Reine en mission protocolaire.\r\nBienvenue \u00e0 bord !\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Flylounge","address_street_name":"Handelsstraat","address_street_number":"65","address_street_box":null,"email":"contact@flylounge.com","website":"https:\/\/www.flylounge.com","phone_contact":"+32 2 318 00 47","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Handelsstraat, 65","address_line2":"1000 Brussel","description_web":"Kom aan boord van het ongelooflijke gastronomische restaurantvliegtuig van de Flylounge evenementenruimte! \r\n\r\nDeze nieuwe ervaring combineert de originaliteit van de kamer, een warm welkom van de bemanning en een heerlijke culinaire reis. Het wordt doorspekt met animaties zoals aankondigingen van passagiers, een bezoek aan de cockpit met een pilootoptie voor de durvers, een presentatie van chef Daniel Dupuis en het ontstaan van de Flylounge...\r\n\r\nOp woensdag-, donderdag- en vrijdagavond stelt de chef een heerlijke gastronomische maaltijd voor met 2 voorgerechten en 3 gangen. \r\nOp zaterdagavond wordt het menu uitgebreid tot 3 voorgerechten en 3 gangen, met een bijzonder uitzonderlijk menu, omdat het de recepten gebruikt die hij gebruikte toen hij voor het koninklijk paleis werkte. Een genot voor alle gastronomen die in de huid kruipen van een koning of koningin op een formele missie.\r\nWelkom aan boord!\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Flylounge","address_street_name":"Rue du Commerce","address_street_number":"65","address_street_box":null,"email":"contact@flylounge.com","website":"https:\/\/www.flylounge.com","phone_contact":"+32 2 318 00 47","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue du Commerce, 65","address_line2":"1000 Brussels","description_web":"Come aboard the incredible gourmet restaurant plane of the Flylounge event space! \r\n\r\nThis new experience combines the originality of the room, a warm welcome from the crew and a delicious culinary journey. It is punctuated by animations such as passenger announcements, a cockpit visit with a piloting option for the most daring, a presentation of the chef Daniel Dupuis and the genesis of the flylounge...\r\n\r\nOn Wednesday, Thursday and Friday evenings, the chef offers a delicious gastronomic meal with 2 appetizers and 3 courses. \r\nOn Saturday evenings, the menu is extended to 3 appetizers and 3 courses, with a particularly exceptional menu, as it uses the recipes he used when he worked for the royal palace. A delight for all gastronomes curious to put themselves in the shoes of a King or Queen on a ceremonial mission.\r\nWelcome aboard!\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Flylounge","address_street_name":"Rue du Commerce","address_street_number":"65","address_street_box":null,"email":"contact@flylounge.com","website":"https:\/\/www.flylounge.com","phone_contact":"+32 2 318 00 47","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Commerce, 65","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Flylounge","address_street_name":"Rue du Commerce","address_street_number":"65","address_street_box":null,"email":"contact@flylounge.com","website":"https:\/\/www.flylounge.com","phone_contact":"+32 2 318 00 47","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Commerce, 65","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Flylounge","address_street_name":"Rue du Commerce","address_street_number":"65","address_street_box":null,"email":"contact@flylounge.com","website":"https:\/\/www.flylounge.com","phone_contact":"+32 2 318 00 47","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Commerce, 65","address_line2":"1000 Bruxelles","description_web":"","description_pri