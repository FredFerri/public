n":"Various"}},"others":{}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Rencontre avec Madame Ke\u00efta","shortdescr":null,"longdescr":"L'Occupation de sans papiers \u201cL\u2019hospitali\u00e8re\u201d \u00e0 Saint-Gilles permettra aux enfants de discuter des questions de transmission et de f\u00eate, avec une femme de traditions, descendante de Soundjata Ke\u00efta, roi du Mandingue.\r\n\r\nTh\u00e9matique : Syst\u00e8mes d'exploitations \r\nParcours : Apprendre - R\u00eaver","performers":"Madame Ke\u00efta","boxoffice_url":null,"website":"https:\/\/www.famefestival.be","email":"ticket@famefestival.be","phone_contact":null,"phone_booking":"+32 474 30 96 81","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.538091"},"nl":{"name":"Rencontre avec Madame Ke\u00efta","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"info@famefestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.538091"},"en":{"name":"Rencontre avec Madame Ke\u00efta","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.538091"},"de":{"name":"Rencontre avec Madame Ke\u00efta","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.538091"},"it":{"name":"Rencontre avec Madame Ke\u00efta","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.538091"},"sp":{"name":"Rencontre avec Madame Ke\u00efta","shortdescr":null,"longdescr":null,"performers"