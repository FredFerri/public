is_soldout":false,"last_updated_at":"2024-11-29T15:37:05+01:00","published_at":"2024-11-29T15:33:40+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":312820,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"brocante","ranking":1.2599210498948732,"languages":{"spoken":["fr","en","nl"],"subtitles":[]},"categories":{"main":{"id":71,"translations":{"de":"M\u00e4rkte & Flohm\u00e4rkte","pt":null,"en":"Markets and bric-a-brac stores","it":"Mercati e antiquariato","cn":null,"fr":"March\u00e9s & brocantes","sp":"Mercados y mercadillos","nl":"Markten & brocante"}},"others":{}},"translations":{"de":{"name":"Oriental christmas market","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.facebook.com\/events\/566103749700952","email":"commentpeutonetrepersan@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700004102"},"pt":{"name":"Oriental christmas market","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.facebook.com\/events\/566103749700952","email":"commentpeutonetrepersan@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700004102"},"en":{"name":"Oriental christmas market","shortdescr":"Exhibitors will be selling jewelry, ceramics, clothing and textile creations, handbags, tote bags, illustrations and photos, as well as various decorative objects and accessories. All made in Iran, Syria, Lebanon or Palestine, and mostly by hand! You'll also find tea, pastries and other Oriental delights.","longdescr":"With : Golobolbol Persian Webshop (Iran), Ramy (Lebanon), Christina (Lebanon), Niknaz(Iran), Golnaz & Sepideh(Iran), Nasim(Iran) ,Saraa(Syria), Rashin(Iran), Mobina(Iran), Maryam(Iran), Saly(Iran),Roya(Iran), Nadine(Lebanon),Palettes of Palestine(Gaza) and Istudio.\nDelicious Syrian and Afghan table d'h\u00f4te by Thuraya and Niloo and Persian cakes by Afsaneh.\nOur market will take place in the large downstairs hall.\n\nBONUS- Workshop \u201cDive into the Mystery of Red: A Journey to the Heart of Persian Culture\u201d\n\nWhat if a color could tell the story of a civilization? Red, the universal symbol of passion and life, invites us to explore its thousand facets in the Persian universe. This workshop takes you on a journey in the footsteps of this vibrant hue, at the crossroads of art and tradition. From prehistoric Iran to the sumptuous carpets and festivities of today, each shade reveals a shred of mystery and symbolism.\nCreate your own \u201cRouge d'Iran\u201d, inspired by ancestral motifs and rituals.\nWith this unique object, give free rein to your creativity while forging an intimate link with a fascinating culture. When you leave, you'll take home not only a personal work of art, but also a piece of Iran's glowing soul.\n\nJoin us for an unforgettable artistic and symbolic adventure. The workshop will be led by Nikoo from 2pm to 4pm.\nWorkshop free of charge, but booking required by message or email\ncommentpeutonetrepersan@gmail.com\nIn collaboration with Istudio.\n\nThere will also be printed paintings of children from Gaza to support justice and show our solidarity.\nThe project is a collaboration between Palettes of Palestine and the HOPE Foundation www.HOPE-foundation.nl","performers":"Come and do your Christmas shopping at our oriental bazaar on Saturday December 14th from 12pm to 8pm at the GC Pianofabriek.","boxoffice_url":null,"website":"https:\/\/www.facebook.com\/events\/566103749700952","email":"commentpeutonetrepersan@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700004102"},"it":{"name":"Oriental christmas market","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.facebook.com\/events\/566103749700952","email":"commentpeutonetrepersan@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700004102"},"cn":{"name":"Oriental christmas market","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.facebook.com\/events\/566103749700952","email":"commentpeutonetrepersan@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700004102"},"fr":{"name":"March\u00e9 de no\u00ebl oriental","shortdescr":"Des exposants vous proposeront des bijoux, des c\u00e9ramiques, des v\u00eatements et cr\u00e9ations textiles , des sacs \u00e0 main, des tote bags, des illustrations et photos, ou encore divers objets de d\u00e9co et accessoires. Tout a \u00e9t\u00e9 fait en Iran, en Syrie, au Liban ou en Palestine et le plus souvent faits \u00e0 la main ! Vous trouverez aussi du th\u00e9, des p\u00e2tisseries et autres d\u00e9lices d\u2019Orient.","longdescr":"Avec : Golobolbol Persian Webshop (Iran), Ramy (Liban), Christina (Liban), Niknaz(Iran), Golnaz et Sepideh(Iran), Nasim(Iran), Saraa(Syrie), Rashin(Iran), Mobina(Iran), Roya(Iran), Saly(Iran) Maryam(Iran), Nadine(Liban),Palettes of Palestine(Gaza) et Istudio.\nD\u00e9licieuses tables d\u2019h\u00f4te syrienne et afghane par Thuraya et Niloo et petits g\u00e2teaux persans d\u2019Afsaneh.\nNotre march\u00e9 aura lieu dans la grande salle du bas.\n\nBONUS- Atelier \"Plongez dans le Myst\u00e8re du Rouge : Un Voyage au C\u0153ur de la Culture Persane\"\nEt si une couleur pouvait raconter l\u2019histoire d\u2019une civilisation ? Le rouge, symbole universel de passion et de vie, nous invite \u00e0 explorer ses mille facettes dans l\u2019univers persan. Cet atelier vous emm\u00e8ne sur les traces de cette teinte vibrante, au croisement de l\u2019art et des traditions. De l\u2019Iran pr\u00e9historique aux tapis somptueux et aux festivit\u00e9s d\u2019aujourd\u2019hui, chaque nuance r\u00e9v\u00e8le une parcelle de myst\u00e8re et de symbolisme.\nCr\u00e9ez votre propre \"Rouge d\u2019Iran\", inspir\u00e9 des motifs et des rituels ancestraux.\n\u00c0 travers cet objet unique, laissez libre cours \u00e0 votre cr\u00e9ativit\u00e9 tout en tissant un lien intime avec une culture fascinante. En repartant, vous emporterez non seulement une \u0153uvre personnelle mais aussi une part de l\u2019\u00e2me rougeoyante de l\u2019Iran.\nRejoignez-nous pour une aventure artistique et symbolique inoubliable. L'atelier sera anim\u00e9 par Nikoo de 14h \u00e0 16h.\nAtelier gratuit mais r\u00e9servation n\u00e9cessaire par message ou email\ncommentpeutonetrepersan@gmail.com\nEn collaboration avec Istudio.\n\nIl y aura \u00e9galement des peintures imprim\u00e9es d'enfants de Gaza pour soutenir la justice et montrer notre solidarit\u00e9.\nLe projet est une collaboration entre Palettes of Palestine et la fondation HOPE www.HOPE-foundation.nl\n\nOriginal artwork in the background by Naimepakniyat","performers":"Venez faire vos courses de No\u00ebl \u00e0 notre bazar oriental le samedi 14 d\u00e9cembre de 12h \u00e0 20h au GC Pianofabriek","boxoffice_url":null,"website":"https:\/\/www.facebook.com\/events\/566103749700952","email":"commentpeutonetrepersan@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700004102"},"sp":{"name":"Oriental christmas market","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.facebook.com\/events\/566103749700952","email":"commentpeutonetrepersan@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700004102"},"nl":{"name":"Oosterse kerstmarkt","shortdescr":"Exposanten verkopen sieraden, keramiek, kleding en textielcreaties, handtassen, draagtassen, illustraties en foto's, maar ook diverse decoratieve artikelen en accessoires. Alles is gemaakt in Iran, Syri\u00eb, Libanon of Palestina, en het meeste is handgemaakt! Je vindt er ook thee, gebak en andere Oosterse lekkernijen.","longdescr":"Met : Golobolbol Persian Webshop (Iran), Ramy (Libanon), Christina (Libanon), Niknaz(Iran), Golnaz & Sepideh(Iran), Nasim(Iran),Saly(Iran),Saraa(Syri\u00eb), Rashin(Iran), Mobina(Iran), Roya(Iran), Maryam(Iran), Nadine(Libanon),Palettes of Palestine(Gaza) en Istudio.\nHeerlijke Syrische en Afghaanse table d'h\u00f4te van Thuraya en Niloo en Perzische taarten van Afsaneh.\nOnze markt vindt plaats in de grote zaal beneden.\n\nBONUS- Workshop \u201cDuik in het mysterie van rood: een reis naar het hart van de Perzische cultuur\u201d.\n\nWat als een kleur het verhaal van een beschaving kan vertellen? Rood, het universele symbool van passie en leven, nodigt ons uit om de duizend facetten ervan in de Perzische wereld te verkennen. Deze workshop neemt je mee op een reis in de voetsporen van deze levendige tint, op het kruispunt van kunst en traditie. Van het prehistorische Iran tot de weelderige tapijten en festiviteiten van vandaag, elke tint onthult een stukje mysterie en symboliek.\nCre\u00eber je eigen \u201cRouge d'Iran\u201d, ge\u00efnspireerd door voorouderlijke motieven en rituelen.\nMet dit unieke object laat je je creativiteit de vrije loop terwijl je een intieme band smeedt met een fascinerende cultuur. Als je vertrekt, neem je niet alleen een persoonlijk kunstwerk mee, maar ook een stukje van de gloeiende ziel van Iran.\n\nGa met ons mee op een onvergetelijk artistiek en symbolisch avontuur. De workshop wordt geleid door Nikoo van 14.00 tot 16.00 uur.\nDe workshop is gratis, maar reserveren is verplicht via bericht of e-mail\ncommentpeutonetrepersan@gmail.com\nIn samenwerking met Istudio.\n\n\nEr zullen ook geprinte schilderijen van kinderen uit Gaza zijn om gerechtigheid te steunen en onze solidariteit te tonen.\nHet project is een samenwerking tussen Palettes of Palestine en de HOPE Foundation www.HOPE-foundation.nl","performers":"Kom je kerstinkopen doen op onze ori\u00ebntaalse bazaar op zaterdag 14 december van 12 tot 20 uur in de GC Pianofabriek.\n","boxoffice_url":null,"website":"https:\/\/www.facebook.com\/events\/566103749700952","email":"commentpeutonetrepersan@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700004102"}},"place":{"id":276067,"translations":{"de":{"name":"Pianofabriek","address_street_name":"Rue du Fort","address_street_number":"35","address_street_box":null,"email":"info@pianofabriek.be","website":"http:\/\/www.pianofabriek.be","phone_contact":"+32 2 541 01 70","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue du Fort, 35","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Pianofabriek","address_street_name":"Rue du Fort","address_street_number":"35","address_street_box":null,"email":"info@pianofabriek.be","website":"http:\/\/www.pianofabriek.be","phone_contact":"+32 2 541 01 70","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue du Fort, 35","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"GC Pianofabriek","address_street_name":"Rue du Fort","address_street_number":"35","address_street_box":null,"email":"info@pianofabriek.be","website":"http:\/\/www.pianofabriek.be","phone_contact":"+32 2 541 01 70","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue du Fort, 35","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null