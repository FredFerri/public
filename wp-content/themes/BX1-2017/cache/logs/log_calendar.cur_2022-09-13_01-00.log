rue,"ranking":0.13992727562026},{"id":505907,"date_start":"2020-10-01","date_end":"2022-12-21","date_next":"2022-12-21","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":true,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":74,"translations":{"fr":"Sport","nl":"Sport","en":"Sport"}},"others":{"list":[159,163],"translations":{"fr":["Activit\u00e9 sportive","Natation et sports nautiques"],"nl":["Sportieve activiteit","Zwemmen en watersport"],"en":["Sporting activity","Swimming and water sports"]}}},"languages":{"spoken":["nl","fr","en"],"subtitles":[]},"translations":{"fr":{"name":"Faire du kayak pour un canal plus propre","shortdescr":"Vous cherchez une chouette activit\u00e9 pour d\u00e9couvrir Bruxelles ? Ou vous voudriez faire une bonne action ? Ou lancer un d\u00e9fi \u00e0 votre famille et vos amis ? Rejoingez-nous pour une p\u00eache au plastique en kayak sur le canal.","longdescr":"Vous cherchez une chouette activit\u00e9 pour d\u00e9couvrir Bruxelles ? Ou vous voudriez faire une bonne action ? Ou lancer un d\u00e9fi \u00e0 votre famille et vos amis ? Rejoingez-nous pour une p\u00eache au plastique en kayak sur le canal. Nous vous accompagnerons pour expliquer notre action et les solutions que nous proposons pour rem\u00e9dier aux probl\u00e8mes des d\u00e9chets, la mauvaise qualit\u00e9 de l'eau et le manque de biodiversit\u00e9 et nature dans le canal.\r\n\r\nEnvoyez-nous un message via Facebook, via le formulaire de contact du site web ou via e-mail \u00e0 info@canalitup.org.\r\n\r\nGr\u00e2ce au soutien de la Ville de Bruxelles, nous organisons des sorties un jour par semaine.\r\nContrat de R\u00e9novation urbaine \"Citro\u00ebn-Vergote\"\r\n\r\n#FallFishingAction","performers":"Canal It Up","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.505907"},"nl":{"name":"Kajakken voor een proper kanaal","shortdescr":"Ben je op zoek naar een leuke activiteit om je eigen stad te ontdekken? Of wil je een goede daad verrichten? Kan je familie en vrienden overtuigen? Kom samen met ons per kajak vissen naar afval in het kanaal in het centrum van Brussel.","longdescr":"Ben je op zoek naar een leuke activiteit om je eigen stad te ontdekken? Of wil je een goede daad verrichten? Kan je familie en vrienden overtuigen? Kom samen met ons per kajak vissen naar afval in het kanaal in het centrum van Brussel. We begeleiden je en leggen uit waarom we dit doen en welke oplossingen we voorstellen om de problemen van afval, slechte waterkwaliteit en gebrek aan natuur echt op te lossen.\r\n\r\nStuur ons een bericht via onze facebookpagina, via onze website www.canalitup.org of email ons op info@canalitup.org om jouw vaartocht vast te leggen.\r\n\r\nMet de hulp van de Stad Brussel worden de trips \u00e9\u00e9n keer per week georganiseerd.\r\nStadsvernieuwingscontract \u201cCitro\u00ebn-Vergote\u201d\r\n\r\n#FallFishingAction","performers":"Canal It Up","boxoffice_url":null,"website":"http:\/\/www.canalitup.org","email":"Info@canalitup.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.505907"},"en":{"name":"Kayaking for a clean canal","shortdescr":"Are you looking for a nice activity to explore your own city? Or do you want to do a good deed? Or to challenge family and friends? Come and join us in our kayaks to fish for trash in the canal of Brussels.","longdescr":"Are you looking for a nice activity to explore your own city? Or do you want to do a good deed? Or to challenge family and friends? Come and join us in our kayaks to fish for trash in the canal of Brussels. We will accompany you to explain why we do this and which solutions we propose to really tackle the problems of trash, bad water quality and lack of biodiversity and nature in the canal.\r\n\r\nSend us a message on facebook, through our website www.canalitup.org or email us at info@canalitup.org.\r\n\r\nWith the help of the City of Brussels, trips will be organised once a week.\r\nStadsvernieuwingscontract \u201cCitro\u00ebn-Vergote\u201d\r\n\r\n#FallFishingAction","performers":"Canal It Up","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.505907"},"de":{"name":"Kajakken voor een proper kanaal","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.505907"},"it":{"name":"Kajakken voor een proper kanaal","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.505907"},"sp":{"name":"Kajakken voor een proper kanaal","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.505907"},"pt":{"name":"Kajakken voor een proper kanaal","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.505907"},"cn":{"name":"Kajakken voor een proper kanaal","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.505907"}},"place":{"id":275323,"translations":{"fr":{"name":"Quai 