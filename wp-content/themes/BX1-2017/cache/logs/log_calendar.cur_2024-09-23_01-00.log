published_at":"2023-10-19T13:08:47+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":287419,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"tour","ranking":0.17099759466766973,"languages":{"spoken":["fr","en"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{"list":[113],"translations":{"de":["Industrielle Geschichte"],"pt":[null],"en":["Industrial History"],"it":["Storia industriale"],"cn":[null],"fr":["Histoire Industrielle"],"sp":["Historia industrial"],"nl":["Industri\u00eble geschiedenis"]}}},"translations":{"de":{"name":"Brussels Beer: A Travel through Time","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/agalmalt.com","email":"hello@agalmalt.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50003536"},"pt":{"name":"Brussels Beer: A Travel through Time","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/agalmalt.com","email":"hello@agalmalt.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50003536"},"en":{"name":"Brussels Beer: A Travel through Time","shortdescr":"A unique timetravel into beer history, its techniques and flavors during an exclusive beer and cultural activity!","longdescr":"In Belgium we\u2019re pretty proud of our beer legacy, and Brussels makes no exception to that. We have a flourishing past with here and there testimonies and stories, that await to be told. But do we know precisely what does Brussels have to offer beer-wise? How does time influence brewing technique, our taste expectations? Can we taste beer past? Is it possible to imagine beer future?\nJoin us for an exclusive time travel, and experience on-site the evolution of brewing \u2013 and its major consequences \u2013 at the core of Brussels beer culture.\nFor beer sceptics and enthusiasts only.\n","performers":"Agalmalt","boxoffice_url":null,"website":"https:\/\/agalmalt.com","email":"hello@agalmalt.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50003536"},"it":{"name":"Brussels Beer: A Travel through Time","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/agalmalt.com","email":"hello@agalmalt.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50003536"},"cn":{"name":"Brussels Beer: A Travel through Time","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/agalmalt.com","email":"hello@agalmalt.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50003536"},"fr":{"name":"Brussels Beer: A Travel through Time","shortdescr":"Un voyage unique dans l'Histoire de la bi\u00e8re, ses techniques et ses saveurs, dans une activit\u00e9 culturelle et brassicole exclusive!","longdescr":"Nous sommes assez fiers en Belgique de notre h\u00e9ritage brassicole, et Bruxelles ne fait pas exception. Nous pouvons trouver ci et l\u00e0 les traces florissantes de notre pass\u00e9, et ses histoires tardent \u00e0 \u00eatre racont\u00e9es. Mais que savons-nous pr\u00e9cis\u00e9ment de ce que Bruxelles a \u00e0 offrir en termes de bi\u00e8re et de brasseries ? Quelle est l\u2019influence de l\u2019Histoire sur la technologie brassicole, ou nos attentes gustatives ? Est-ce encore possible de go\u00fbter la bi\u00e8re du pass\u00e9 ? Est-ce possible d\u2019imaginer ce \u00e0 quoi ressemblera la bi\u00e8re dans le futur ?\nVenez avec nous pour un voyage dans le temps exclusif, et vivez sur site l\u2019\u00e9volution du brassage \u2013 et ses cons\u00e9quences fondamentales \u2013 au c\u0153ur de Bruxelles-qui-brasse.\nPour curieux et sceptiques uniquement.","performers":"Agalmalt","boxoffice_url":null,"website":"https:\/\/agalmalt.com","email":"hello@agalmalt.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50003536"},"sp":{"name":"Brussels Beer: A Travel through Time","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/agalmalt.com","email":"hello@agalmalt.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50003536"},"nl":{"name":"Brussels Beer: A Travel through Time","shortdescr":null,"longdescr":null,"performers":"Agalmalt","boxoffice_url":null,"website":"https:\/\/agalmalt.com","email":"hello@agalmalt.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50003536"}},"place":{"id":235618,"translations":{"de":{"name":"Brauerei Cantillon - Br\u00fcsseler Gueuze-Museum","address_street_name":"Rue Gheude","address_street_number":"56","address_street_box":null,"email":"info@cantillon.be","website":"http:\/\/www.cantillon.be","phone_contact":"+32 2 521 49 28","phone_booking":"+32 2 520 28 91","address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue Gheude, 56","address_line2":"1070 Anderlecht","description_web":"Brauerei Cantillon - belgisches Bier mit Michelin-Stern! Die Brauerei Cantillon ist die einzige noch aktive Brauerei in Br\u00fcssel, die f\u00fcr die \u00d6ffentlichkeit zug\u00e4nglich ist. \r\nVerborgen in einem etwas weniger touristischen Viertel betreibt die Brauerei Cantillon seit 1978 auch das Br\u00fcsseler Gueuze-Museum, das die Besonderheiten der spontang\u00e4rigen belgischen Biere Gueze, Lambic und artverwandten Biere in Szene setzt.  \r\n\r\nVon Oktober bis Ende M\u00e4rz kann man den Braumeistern der Brauerei Cantillon bei ihrer Arbeit \u00fcber die Schulter blicken und die verschiedenen Etappen des Brauprozesses verfolgen: Vom Brausaal \u00fcber den Kesselsaal, den Kornspeicher, das K\u00fchlbecken, die unterschiedlichen Etappen der Bierf\u00e4sser, die Abf\u00fcllung und bis hin zum Keller.\r\n\r\nDie Brauerei, in der Braumeister Jean-Pierre van Roy die Familientradition fortsetzt, darf sich sogar mit einem Stern des Gourmetf\u00fchrers Michelin schm\u00fccken.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Brasserie Cantillon - Mus\u00e9e bruxellois de la Gueuze","address_street_name":"Rue Gheude","address_street_number":"56","address_street_box":null,"email":"info@cantillon.be","website":"http:\/\/www.cantillon.be","phone_contact":"+32 2 521 49 28","phone_booking":"+32 2 520 28 91","address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue Gheude, 56","address_line2":"1070 Anderlecht","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Cantillon Brewery - Brussels Museum of the Gueuze","address_street_name":"Gheudestraat","address_street_number":"56","address_street_box":null,"email":"info@cantillon.be","website":"https:\/\/www.cantillon.be\/?lang=fr","phone_contact":"+32 2 521 49 28","phone_booking":"+32 2 520 28 91","address_zip":"1070","address_city":"Anderlecht","address_line1":"Gheudestraat, 56","address_line2":"1070 Anderlecht","description_web":"This family brewery where Lambic, Gueuze, Faro and Kriek are made and where nothing has changed since 1900 when it was founded, welcomes you and invites you to discover a fabulous world. Beers, tools and brewing process are still the same as in the beginning. Red copper containers, barrels, some of them more than 100 years old, and walls of bottles constitute the scenery for your visit.\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Brasserie Cantillon - Mus\u00e9e bruxellois de la Gueuze","address_street_name":"Rue Gheude","address_street_number":"56","address_street_box":null,"email":"info@cantillon.be","website":"http:\/\/www.cantillon.be","phone_contact":"+32 2 521 49 28","phone_booking":"+32 2 520 28 91","address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue Gheude, 56","address_line2":"1070 Anderlecht","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Brasserie Cantillon - Mus\u00e9e bruxellois de la Gueuze","address_street_name":"Rue Gheude","address_street_number":"56","address_street_box":null,"email":"info@cantillon.be","website":"http:\/\/www.cantillon.be","phone_contact":"+32 2 521 49 28","phone_booking":"+32 2 520 28 91","address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue Gheude, 56","address_line2":"1070 Anderlecht","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Brasserie Cantillon - Mus\u00e9e bruxellois de la Gueuze","address_street_name":"Rue Gheude","address_street_number":"56","address_street_box":null,"email":"info@cantillon.be","website":"http:\/\/www.cantillon.be","phone_contact":"+32 2 521 49 28","phone_booking":"+32 2 520 28 91","address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue Gheude, 56","address_line2":"1070 Anderlecht","description_web":"Perdu dans un quartier moins touristique, le Mus\u00e9e bruxellois de la Gueuze pr\u00e9sente un patrimoine \"vivant\" car toujours en activit\u00e9, dans son contexte technique, \u00e9conomique et historique. D'octobre \u00e0 fin mars, \u00e0 la brasserie \"Cantillon\", on peut assister aux diverses \u00e9tapes de la fabrication de la gueuze et du lambic. Le public parcourra avec plaisir les diff\u00e9rentes salles : salle de brassage, salle des cuves de cuisson, greniers \u00e0 grains, bac refroidissoir, salle de futailles des tonneaux, lieu d'assemblage, lieu de nettoyage des f\u00fbts, bloc d'embouteillage et enfin, la cave.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Brasserie Cantillon - Mus\u00e9e bruxellois de la Gueuze","address_street_name":"Rue Gheude","address_street_number":"56","address_street_box":null,"email":"info@cantillon.be","website":"http:\/\/www.cantillon.be","phone_contact":"+32 2 521 49 28","phone_booking":"+32 2 520 28 91","address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue Gheude, 56","address_line2":"1070 Anderlecht","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Brouwerij Cantillon - Brussels Museum van de Geuze","address_street_name":"Gheudestraat","address_street_number":"56","address_street_box":null,"email":"info@cantillon.be","website":"http:\/\/www.cantillon.be","phone_contact":"+32 2 521 49 28","phone_booking":"+32 2 520 28 91","address_zip":"1070","address_city":"Anderlecht","address_line1":"Gheudestraat, 56","address_line2":"1070 Anderlecht","description_web":"In een minder toeristische buurt stelt het Brussels Museum van de Geuze een \"levend\" erfgoed voor, in zijn technische, economische en historische context. Van oktober tot eind maart kan men in deze actieve brouwerij \"Cantillon\" in levende lijve de verschillende fasen van het brouwen van geuze en lambic meemaken. Aan de bezoekers worden de verschillende stadia uitgelegd aan de hand van de opeenvolgende ruimtes: de brouwerszaal, de zaal met de gistkuipen, de graanzolders, de koelbakken, de opslagplaats voor de houten vaten, de werkplaats voor het op fles trekken en natuurlijk de kelder voor het bewaren van de flessen.",