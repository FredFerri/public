_type":"theatre","show_in_agenda":true,"ranking":0.15396304049942},{"id":547518,"date_start":"2023-02-03","date_end":"2023-04-21","date_next":"2023-04-21","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen","it":"Visite guidate","sp":"Visitas guiadas","pt":null,"cn":null}},"others":{"list":[104],"translations":{"fr":["Art Nouveau, Art D\u00e9co"],"nl":["Art nouveau, art deco"],"en":["Art Nouveau, Art D\u00e9co"],"de":["Jugendstil, Art d\u00e9co"],"it":["Art Nouveau, Art D\u00e9co"],"sp":["Art nouveau, art d\u00e9co"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Dans les coulisses de la r\u00e9novation de l'h\u00f4tel Solvay","shortdescr":"Cette ann\u00e9e, le propri\u00e9taire de l'h\u00f4tel Solvay a lanc\u00e9 la r\u00e9novation compl\u00e8te de la fa\u00e7ade c\u00f4t\u00e9 rue qui n\u00e9cessitait une restauration au niveau des ch\u00e2ssis, des vitres, de la ferronnerie et des poutres de soutien. Une occasion de d\u00e9couvrir le plus prestigieux des h\u00f4tels de ma\u00eetre Art nouveau, con\u00e7u par Victor Horta, sous un autre prisme.","longdescr":"De 1894 \u00e0 1898, Victor Horta construit pour Armand Solvay, le fils du c\u00e9l\u00e8bre industriel Ernest Solvay, le plus prestigieux des h\u00f4tels de ma\u00eetre Art nouveau \u00e0 Bruxelles. Construction majeure du ma\u00eetre de l'Art nouveau Victor Horta, il a la chance d'avoir conserv\u00e9 tous ses \u00e9l\u00e9ments d'origine : mobilier, luminaires, tentures et objets d'art de l'\u00e9poque.\r\nCette ann\u00e9e, le propri\u00e9taire de l'h\u00f4tel Solvay a lanc\u00e9 la r\u00e9novation compl\u00e8te de la fa\u00e7ade c\u00f4t\u00e9 rue qui n\u00e9cessitait une restauration au niveau des ch\u00e2ssis, des vitres, de la ferronnerie et des poutres de soutien. Outre la visite de l'h\u00f4tel de ma\u00eetre, notre guide vous expliquera les d\u00e9tails surprenants de cette r\u00e9novation. La fa\u00e7ade sera donc couverte d'une b\u00e2che !\r\nClass\u00e9 au patrimoine mondial de l'UNESCO, c'est un \u00e9crin unique, o\u00f9 la notion d'art total prend ici tout son sens.\r\n\r\nVisite \u00e0 partir de 16 ans.","performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/dans-les-coulisses-de-la-r-novation-de-lh-tel-solvay","email":"info@arkadia.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.547518"},"nl":{"name":"Dans les coulisses de la r\u00e9novation de l'h\u00f4tel Solvay","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/dans-les-coulisses-de-la-r-novation-de-lh-tel-solvay","email":"info@arkadia.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.547518"},"en":{"name":"Dans les coulisses de la r\u00e9novation de l'h\u00f4tel Solvay","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/dans-les-coulisses-de-la-r-novation-de-lh-tel-solvay","email":"info@arkadia.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.547518"},"de":{"name":"Dans les coulisses de la r\u00e9novation de l'h\u00f4tel Solvay","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/dans-les-coulisses-de-la-r-novation-de-lh-tel-solvay","email":"info@arkadia.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.bru