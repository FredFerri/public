me partie, trois improvisations de 12 minutes, inspir\u00e9es de la premi\u00e8re partie, prendront vie sous vos yeux.\r\nUn cocktail de cr\u00e9ations instantan\u00e9es qui vous \u00e9tonnera encore et toujours par sa spontan\u00e9it\u00e9!\r\nN\u2019attendez plus, plut\u00f4t que de passer une soir\u00e9e boring venez plut\u00f4t voir un spectacle BORING !","performers":"La Boring Team","boxoffice_url":null,"website":"http:\/\/www.letrac.be\/reservations","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/530593.html"},"nl":{"name":"The Boring Show ) Spectacle d'improvisation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/530593.html"},"en":{"name":"The Boring Show ) Spectacle d'improvisation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/530593.html"},"de":{"name":"The Boring Show ) Spectacle d'improvisation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/530593.html"},"it":{"name":"The Boring Show ) Spectacle d'improvisation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/530593.html"},"sp":{"name":"The Boring Show ) Spectacle d'improvisation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/530593.html"},"pt":{"name":"The Boring Show ) Spectacle 