nd":"18:00:00"},{"day":"2022-09-11","doors":null,"start":"11:00:00","end":"18:00:00"},{"day":"2022-09-16","doors":null,"start":"11:00:00","end":"18:00:00"},{"day":"2022-09-17","doors":null,"start":"11:00:00","end":"18:00:00"},{"day":"2022-09-18","doors":null,"start":"11:00:00","end":"18:00:00"}],"weekschema":[{"days":{"monday":{"is_open":false},"tuesday":{"is_open":false},"wednesday":{"is_open":false},"thursday":{"is_open":false},"friday":{"is_open":true,"hours":[{"start":"11:00:00","end":"18:00:00"}]},"saturday":{"is_open":true,"hours":[{"start":"11:00:00","end":"18:00:00"}]},"sunday":{"is_open":true,"hours":[{"start":"11:00:00","end":"18:00:00"}]}},"translations":{"fr":["lundi, mardi, mercredi et jeudi: ferm\u00e9","vendredi, samedi et dimanche: de 11:00 \u00e0 18:00"],"nl":["maandag, dinsdag, woensdag en donderdag: gesloten","vrijdag, zaterdag en zondag: van 11:00 tot 18:00"],"en":["monday, tuesday, wednesday and thursday: closed","friday, saturday and sunday: from 11:00 to 18:00"]},"date_start":"2022-08-26","date_end":"2022-09-18","is_also_by_appointment":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":0}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"opening":{"day":"2022-08-26","start":"18:00:00","timestamp":"2022-08-26T18:00:00+02:00","end":"22:00:00","is_only_by_appointment":false},"tags":[],"accessibilities":{"list":[252,255,259,261,263,265,266],"translations":{"fr":["Accessible aux personnes ayant des difficult\u00e9s de compr\u00e9hension","Accessible","Chien d'assistance","Parking accessible","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9","Brussels Health Safety Label"],"nl":["Toegankelijk voor mensen met een verstandelijke beperking","Toegankelijk","Assistentiehonden","Toegankelijke parking","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet","Brussels Health Safety Label"],"en":["Accessible to people with intellectual disabilities","Accessible","Assistance dogs","Accessible parking","Accessible to pedestrians with mobility aids","Adapted toilet","Brussels Health Safety Label"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-09-12T01:35:46+02:00","published_at":"2022-07-15T12:02:05+02:00","backoffice_id":258534,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.34668063717532},{"id":541132,"date_start":"2022-09-16","date_end":"2022-10-09","date_next":"2022-09-16","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[36,39],"translations":{"fr":["Mus\u00e9es et art centers","Photographie"],"nl":["Musea en kunstcentra","Fotografie"],"en":["Museums and art centers","Photography"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Toutankhamon.be.verse","shortdescr":"Et si le tr\u00e9sor de Toutankhamon avait \u00e9t\u00e9 d\u00e9couvert en Belgique ?\r\nUne interpr\u00e9tation onirique de l'univers de Toutankhamon dans le Metaverse.\r\nDes images g\u00e9n\u00e9r\u00e9es par l'exp\u00e9rience de l'intelligence artificielle face \u00e0 d'authentiques transparents d'archives en verre.","longdescr":"Sujet toujours passionnant, l'\u00e9gyptologie a une longue tradition en Belgique. Dans cette exposition, des monuments et des sites embl\u00e9matiques du patrimoine belge servent d'\u00e9l\u00e9ments de construction pour une interpr\u00e9tation onirique du cosmos \u00e9ternel de Toutankhamon dans le Metaverse. Un int\u00e9ressant vis-\u00e0-vis des failles analogiques\/num\u00e9riques et des croisements spatio-temporels imagin\u00e9s. En outre, l'exposition fonctionne comme une interrogation sur la cr\u00e9ativit\u00e9 humaine et artificielle.\r\n\r\nTinyGallery, un lieu d\u00e9di\u00e9 principalement \u00e0 la photographie, est aussi un lieu qui permet une intersection avec l'imagerie exp\u00e9rimentale. L'anniversaire de l'ouverture du tombeau de Toutankhamon en 1922 est l'occasion de sortir des archives des photographies de l'\u00c9gypte prises dans les ann\u00e9es 1920 et de les interconnecter avec des images g\u00e9n\u00e9r\u00e9es par l'intelligence artificielle. Les photos d'archives, qui ont \u00e9t\u00e9 d\u00e9couvertes dans un grenier en Belgique, sont accompagn\u00e9es de descriptions textuelles produites \u00e0 l'\u00e9poque. Ces descriptions textuelles servent de base \u00e0 une histoire fictive intitul\u00e9e \"Et si, dans le Metaverse, Toutankhamon avait \u00e9t\u00e9 roi de Belgique ?","performers":"Petermfriess; Zhu Dan; commissariat archives Olivier Guyaux","boxoffice_url":null,"website":"http:\/\/www.tinygallery.photo","email":"olivier@tinygallery.brussels","phone_contact":"+32 475 27 95 56","phone_booking":"+32 475 27 95 56","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.541132"},"nl":{"name":"Toutankhamon.be.verse","shortdescr":"Wat als de schat van Toetanchamon in Belgi\u00eb was ontdekt?\r\nEen droomachtige interpretatie van Toetanchamons universum in de Metaverse.\r\nArtificial Intelligence Experience-gegenereerde beelden tegenover authentieke archivale glazen transparanten.","longdescr":"Egyptologie, altijd een fascinerend onderwerp, heeft een lange traditie in Belgi\u00eb. In deze tentoonstelling fungeren monumenten en emblematische Belgische erfgoedsites als bouwstenen voor een dromerige interpretatie van de eeuwige kosmos van Toetanchamon in de Metaverse. Een interessante vis-\u00e0-vis van analoge\/digitale gebreken en ingebeelde spatio-temporele kruisingen. Daarnaast fungeert de tentoonstelling als een ondervraging van menselijke en kunstmatige creativiteit.\r\n\r\nTinyGallery, een plek die in de eerste plaats gewijd is aan fotografie, is ook een plek die een kruising met experimenteel beeldmateriaal mogelijk maakt. De verjaardag van de opening van de graftombe van Toetanchamon in 1922 is een gelegenheid om foto's van Egypte uit de jaren twintig van de vorige eeuw uit de archieven te halen en ze te verbinden met beelden die met behulp van kunstmatige intelligentie zijn gegenereerd. De archieffoto's, die werden ontdekt op een zolder in Belgi\u00eb, gaan vergezeld van tekstuele beschrijvingen uit die tijd. De tekstuele beschrijvingen dienen als basis voor een fictief verhaal \"Wat als, in de Metaverse, Toetanchamon koning van Belgi\u00eb was geweest?","performers":"Petermfriess; Zhu Dan;  archive curator Olivier Guyaux","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.541132"},"en":{"name":"Toutankhamon.be.verse","shortdescr":"What if Tutankhamun's treasure had been discovered in Belgium?\r\nA dreamlike interpretation of Tutankhamun's universe in the Metaverse.\r\nArtificial Intelligence Experience-generated images faced with authentic archival glass transparencies.","longdescr":"Always a fascinating subject, Egyptology has a long tradition in Belgium. In this exhibition, monuments and emblematic Belgian heritage sites function as the building blocks for a dreamlike interpretation of the eternal cosmos of Tutankhamun in the Metaverse. An interesting vis-\u00e0-vis of analogue\/digital flaws and imagined spatio-temporal crossings. In addition, the exhibition functions as an interrogation of human and artificial creativity.\r\n\r\nTinyGallery, a place dedicated primarily to photography, is also a place which allows for an intersection with experimental imagery. The anniversary of the opening of Tutankhamun's tomb in 1922 is an opportunity to take photographs of Egypt taken in the 1920s out of the archives and interconnect them with images generated using artificial intelligence. The archival photos, which where discovered in an attic in Belgium, are accompanied by textual description produced at the time. The textual descriptions serve as the basis for a fictional story \u201cWhat if, in the Metaverse, Tutankhamun had been King of Belgium?","performers":"Petermfriess; Zhu Dan; archive curator Olivier Guyaux","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.541132"},"de":{"name":"Toutankhamon.be.verse","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.541132"},"it":{"name":"Toutankhamon.be.verse","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.541132"},"sp":{"name":"Toutankhamon.be.verse","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.541132"},"pt":{"name":"Toutankhamon.be.verse","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.541132"},"cn":{"name":"Toutankhamon.be.verse","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.541132"}},"place":{"id":275243,"translations":{"fr":{"name":"TinyGallery Brussels","address_street_name":"de la Cuv