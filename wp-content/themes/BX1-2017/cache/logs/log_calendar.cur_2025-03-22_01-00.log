0.7937005259840998,"languages":{"spoken":["en","nl","fr"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{"list":[253],"translations":{"de":["F\u00fchrungen durch Innenr\u00e4ume"],"pt":[null],"en":["Interior guided tours"],"it":["Visite guidate all\u2019interno"],"cn":[null],"fr":["Visites guid\u00e9es d\u2019int\u00e9rieurs"],"sp":["Visitas guiadas en espacios interiores"],"nl":["Interieur rondleidingen"]}}},"translations":{"de":{"name":"BANAD Festival - Guided tour of the Otlet Mansion","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700006155"},"pt":{"name":"BANAD Festival - Guided tour of the Otlet Mansion","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700006155"},"en":{"name":"BANAD Festival - Otlet Mansion","shortdescr":null,"longdescr":"This building, with its startlingly unusual asymmetric Art Nouveau fa\u00e7ade, was constructed between 1894 and 1897 to the design of the architect Octave Van Rysselberghe. The interior is laid out around a stairwell which provides access to the various rooms, each separated from one another by several steps. Henry van de Velde was involved in the interior decoration. The house was commissioned by Paul Otlet, a visionary Renaissance man who was simultaneously a writer, businessman, lawyer, socialist politician and pacifist.\n\nArch. Octave VAN RYSSELBERGHE, 1896 - 1898","performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/en\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700006155"},"it":{"name":"BANAD Festival - Guided tour of the Otlet Mansion","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700006155"},"cn":{"name":"BANAD Festival - Guided tour of the Otlet Mansion","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700006155"},"fr":{"name":"BANAD Festival - H\u00f4tel Otlet","shortdescr":null,"longdescr":"\nEntre 1894 et 1897, l'architecte Octave Van Rysselberghe r\u00e9alisa cet h\u00f4tel \u00e0 la fa\u00e7ade Art nouveau \u00e9tonnante, compos\u00e9e d'\u00e9l\u00e9ments asym\u00e9triques. L'int\u00e9rieur s'articule autour d'une cage d'escalier qui donne acc\u00e8s aux diff\u00e9rentes pi\u00e8ces, la plupart s\u00e9par\u00e9es entre elles par quelques marches. Henry van de Velde collabora \u00e0 la d\u00e9coration int\u00e9rieure. Le commanditaire, Paul Otlet, \u00e9tait un homme visionnaire et multiple, \u00e0 la fois auteur, entrepreneur, juriste et activiste belge, socialiste et pacifiste.\n\nArch. Octave VAN RYSSELBERGHE, 1896 - 1898","performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700006155"},"sp":{"name":"BANAD Festival - Guided tour of the Otlet Mansion","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700006155"},"nl":{"name":"BANAD Festival - Otlet Herenhuis","shortdescr":null,"longdescr":"Architect Octave Van Rysselberghe bouwde dit herenhuis met een verbluffende art-nouveaugevel met asymmetrische elementen tussen 1894 en 1897. Het interieur bouwdt zich op rond een trappenhuis dat toegang geeft tot de verschillende kamers. De meeste worden van elkaar gescheiden met een paar treden. Henry van de Velde werkte mee aan de binneninrichting. Opdrachtgever Paul Otlet was een visionaire, veelzijdige man die bekendstond als schrijver, ondernemer, jurist, Belgisch activist, socialist en pacifist.\n\nArch. Octave VAN RYSSELBERGHE, 1896 - 1898","performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/nl\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700006155"}},"place":{"id":50002873,"translations":{"de":{"name":"H\u00f4tel Otlet","address_street_name":"Rue de Florence","address_street_number":"13","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Florence, 13","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"H\u00f4tel Otlet","address_street_name":"Rue de Florence","address_street_number":"13","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Florence, 13","