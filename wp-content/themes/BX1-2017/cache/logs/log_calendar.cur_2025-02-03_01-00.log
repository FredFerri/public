phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700005922"},"pt":{"name":"La R\u00e9sistance \u00e0 Woluwe-Saint-Lambert","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.bruxellesbavard.be\/fr\/visites-pour-individuels\/","email":"info@bruxellesbavard.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700005922"},"en":{"name":"La R\u00e9sistance \u00e0 Woluwe-Saint-Lambert","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.bruxellesbavard.be\/fr\/visites-pour-individuels\/","email":"info@bruxellesbavard.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700005922"},"it":{"name":"La R\u00e9sistance \u00e0 Woluwe-Saint-Lambert","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.bruxellesbavard.be\/fr\/visites-pour-individuels\/","email":"info@bruxellesbavard.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700005922"},"cn":{"name":"La R\u00e9sistance \u00e0 Woluwe-Saint-Lambert","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.bruxellesbavard.be\/fr\/visites-pour-individuels\/","email":"info@bruxellesbavard.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700005922"},"fr":{"name":"La R\u00e9sistance \u00e0 Woluwe-Saint-Lambert","shortdescr":null,"longdescr":"Le 3 septembre 1944, les Belges de la brigade Piron et les Welsh Guards de l\u2019arm\u00e9e britannique lib\u00e9raient Bruxelles de l'occupant allemand.\n\nPendant les 4 ann\u00e9es d'occupation, les Nazis \u00e9dictent les lois, choisit ses nouvelles victimes : Juifs, communistes, francs-ma\u00e7ons, Roms, syndicalistes, journalistes, avocats...\n\nDans tout le pays, des femmes et des hommes rejettent cette oppression et d\u00e9cident de r\u00e9sister. Presse clandestine, sabotages, r\u00e9seaux d\u2019\u00e9vasion, h\u00e9bergement, ils ont investi les moyens qu\u2019ils avaient \u00e0 leur disposition dans un but commun: la lib\u00e9ration du pays.\n\nLa commune de Woluwe-Saint-Lambert a \u00e9galement \u00e9t\u00e9 marqu\u00e9e par ces combattants de l\u2019ombre. Des panneaux comm\u00e9moratifs, des noms de rue et des monuments en t\u00e9moignent. Vous d\u00e9couvrirez ces r\u00e9cits de lutte et de courage durant cette visite guid\u00e9e.\n\nCette visite guid\u00e9e est organis\u00e9e en collaboration avec le Mus\u00e9e des R\u00e9sistances, dans le cadre du 80e anniversaire de la Lib\u00e9ration de Bruxelles et de la capitulation allemande.\nDeux autres visites sont organis\u00e9es : le 26 janvier \u00e0 Ixelles et le 6 avril \u00e0 Anderlecht.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.bruxellesbavard.be\/fr\/visites-pour-individuels\/","email":"info@bruxellesbavard.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700005922"},"sp":{"name":"La R\u00e9sistance \u00e0 Woluwe-Saint-Lambert","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.bruxellesbavard.be\/fr\/visites-pour-individuels\/","email":"info@bruxellesbavard.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700005922"},"nl":{"name":"La R\u00e9sistance \u00e0 Woluwe-Saint-Lambert","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.bruxellesbavard.be\/fr\/visites-pour-individuels\/","email":"info@bruxellesbavard.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visit