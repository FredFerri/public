d":283697,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"tour","ranking":1.2599210498948732,"languages":{"spoken":["fr","en","nl"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{"list":[109],"translations":{"de":["Gr\u00fcnfl\u00e4chen"],"pt":[null],"en":["Green spaces"],"it":["Spazi verdi"],"cn":[null],"fr":["Espaces verts"],"sp":["Espacios verdes:"],"nl":["Groene zones"]}}},"translations":{"de":{"name":"GARDEN TALES","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/gardentales.brussels","email":"info@civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50001149"},"pt":{"name":"GARDEN TALES","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/gardentales.brussels","email":"info@civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50001149"},"en":{"name":"GARDEN TALES","shortdescr":"Garden Tales is a unique and free event that allows you to discover the secrets of Brussels' private gardens and rediscover the parks from a fresh perspective.","longdescr":"Garden Tales is a free annual event offering visits to private and public gardens in Brussels. In partnership with Natagora and Provelo.\n\nSunday September 24 marks the end of summer, so open the gates, climb the stairs to the rooftops, meet enthusiasts and discover Brussels from the angle of its gardens, whether private or public.\nBecause vegetation is good everywhere, this last day of the Garden Tales 2023 festival offers a range of places to enjoy it, and annouces the Month of Nature organized by Bruxelles Environnement.","performers":null,"boxoffice_url":null,"website":"http:\/\/gardentales.brussels","email":"info@civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50001149"},"it":{"name":"GARDEN TALES","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/gardentales.brussels","email":"info@civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50001149"},"cn":{"name":"GARDEN TALES","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/gardentales.brussels","email":"info@civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50001149"},"fr":{"name":"GARDEN TALES","shortdescr":"Garden Tales est un \u00e9v\u00e9nement unique et gratuit qui vous propose de d\u00e9couvrir les secrets des jardins priv\u00e9s bruxellois et de red\u00e9couvrir les parcs avec un nouveau regard","longdescr":"Garden Tales est un \u00e9v\u00e9nement annuel gratuit qui vous propose de visiter des jardins priv\u00e9s et publics \u00e0 Bruxelles. En partenariat avec Natagora et Provelo.\n\nDimanche 24 septembre marque la fin de l\u2019\u00e9t\u00e9, poussez les portillons, montez les escaliers vers les toits, rencontrez des passionn\u00e9s et d\u00e9couvrez Bruxelles sous l\u2019angle de ses jardins, qu\u2019ils soient priv\u00e9s ou publics.\nParce que la v\u00e9g\u00e9tation fait du bien partout, cette derni\u00e8re journ\u00e9e du festival Garden Tales 2023 offre un panel de lieux pour s\u2019en d\u00e9lecter, et permet d\u2019annoncer Le Mois de la Nature organis\u00e9 par Bruxelles Environnement.\n","performers":null,"boxoffice_url":null,"website":"http:\/\/gardentales.brussels","email":"info@civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50001149"},"sp":{"name":"GARDEN TALES","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/gardentales.brussels","email":"info@civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50001149"},"nl":{"name":"GARDEN TALES","shortdescr":"Garden Tales is een uniek en gratis evenement dat je uitnodigt de geheimen van Brusselse priv\u00e9tuinen te verkennen en stadsparken met een vernieuwde blik te herontdekken","longdescr":"Garden Tales is een jaarlijks gratis evenement in samenwerking met Natagora en Provelo dat bezoeken aan priv\u00e9- en openbare tuinen in Brussel organiseert. \n\nZondag 24 september luidt het einde van de zomer in, duw de poorten open, klim de trappen op naar de toppen van de daken, ontmoet andere natuurliefhebbers et ontdek Brussel van haar groenste kant. Deze laatste dag van Garden Tales luidt de Maand van de Natuur in, georganiseerd door Leefmilieu Brussel.","performers":null,"boxoffice_url":null,"website":"http:\/\/gardentales.brussels","email":"info@civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50001149"}},"place":{"id":235577,"translations":{"de":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+ 32 (0)2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"Das Architekturzentrum CIVA, das 2016 auf Betreiben der Region Br\u00fcssel-Hauptstadt ins Leben gerufen wurde, vereint in einer einzigen Struktur Ressourcen, Wissen und Know-how verschiedener Br\u00fcsseler Vereine aus dem Bereich Kultur, Architektur, St\u00e4dteplanung, Landschaftsarchitektur und Forschungen zum \u00d6kosystem: die Archive f\u00fcr moderne Architektur, die Bibliothek Ren\u00e9 Pech\u00e8re, der Architekturfonds und das Centre Paul Duvigneaud.\r\nMit ihrem kulturellen Projekt tr\u00e4gt die Fondation CIA zur Entwicklung einer architektonischen, landschaftsarchitektonischen und st\u00e4dteplanerischen Kultur bei, die sich mit den Herausforderungen der Gegenwart auseinandersetzt. Schwerpunkt ist Br\u00fcssel. \r\n\r\nDie Fondation CIVA bietet eine ganze Reihe von Aktivit\u00e4ten und Angeboten: Ausstellungen, Konferenzen, Orte des Austauschs und der Debatten, p\u00e4dagogische Aktivit\u00e4ten, Archiveinblicke und Bibliotheken mit knapp 40.000 Werken und Zeitschriften zu den Themen Architektur, St\u00e4dteplanung, Stadtgeschichte, Landschaften, G\u00e4rten und urbane \u00d6kosysteme.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+ 32 (0)2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+ 32 (0)2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"CIVA is a museum, an archive center, a library and a meeting place for lovers of architecture, landscape architecture, urban ecosystems and history in Brussels. Throughout the year, CIVA organizes temporary exhibitions, lectures, debates, guided tours, book launches and activities for children. The activities are organized in Ixelles, near Place Flagey and in the center of Brussels, in KANAL - Centre Pompidou.","description_print":null,"booking_url":null,"sort_order":"CIVA","virtual_visit":null},"it":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+ 32 (0)2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+ 32 (0)2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"fr":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+ 32 (0)2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"CIVA est un muse\u0301e, un centre d'archives, une bibliothe\u0300que et un lieu de rencontre pour les amateurs d'architecture, d'architecture paysage\u0300re, d'e\u0301cosyste\u0300mes urbains et d'histoire a\u0300 Bruxelles. Tout au long de l'anne\u0301e, vous pouvez vous y rendre pour des expositions temporaires, des confe\u0301rences, des de\u0301bats, des visites guide\u0301es, des lancements de livres et des activite\u0301s pour les enfants. Les activite\u0301s se trouvent a\u0300 Ixelles, pre\u0300s de la Place Flagey et au centre de Bruxelles, a\u0300 KANAL - Centre Pompidou.\r\n\r\n","description_print":null,"booking_url":null,"sort_order":"CIVA","virtual_visit":null},"sp":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+ 32 (0)2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"Creado en 2016 por iniciativa de la Regi\u00f3n Bruselas-Capital, el CIVA re\u00fane una \u00fanica estructura de recursos, conocimiento y aprendizaje de varias asociaciones culturales activas en Bruselas en los campos de la arquitectura, urbanismo, paisajes y el estudio de ecosistemas: los Archivos de Arquitectura Moderna, la Biblioteca Ren\u00e9 Pech\u00e8re, los Fondos para la arquitectura, el Centro Paul Duvigneaud y el CIVA asbl, ahora disuelto.\r\nA trav\u00e9s de este proyecto cultural, la Fundaci\u00f3n CIVA contribuye al desarrollo del paisaje arquitect\u00f3nico y la cultura urbana como base para afrontar desaf\u00edos contempor\u00e1neos, poniendo especial \u00e9nfasis en Bruselas.\r\nSiempre tiene \u00e9xito a la hora de cumplir sus objetivos y tratar con un p\u00fablico amplio (adultos y ni\u00f1os, estudiantes, investigadores, arquitectos, paisajistas, amantes de la naturaleza, pol\u00edticos, etc), la fundaci\u00f3n CIVA organiza numerosos eventos y actividades en diferentes lugares, incluyendo exhibiciones permanentes y temporales, conferencias, debates y actividades educativas. Tambi\u00e9n dispone archivos excepcionales abiertos para todos los p\u00fablicos (documentos de arquitectos y paisajistas: planos, bocetos, modelos, muebles, etc.) y librer\u00edas que contienen casi 40.000 obras y peri\u00f3dicos de arquitectura, urbanismo, la historia de los pueblos y ciudades, paisajes, jardines y ecolog\u00eda urbana.\r\nEstas actividades y materiales est\u00e1n dise\u00f1ados para despertar la curiosidad y el inter\u00e9s de todo nuestro entorno, ya sea un hecho hist\u00f3rico o una construcci\u00f3n.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"CIVA","address_street_name":"Kluisstraat","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+ 32 (0)2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Kluisstraat","address_line2":"1050 Ixelles","description_web":"CIVA is een museum, een archiefcentrum, een bibliotheek en een ontmoetingsplek voor liefhebbers van architectuur, landschapsarchitectuur, stadsecosystemen en geschiedenis in Brussel. Het hele jaar door kan je er terecht voor tijdelijke tentoonstellingen, lezingen, debatten, rondleidingen, book launches en kinderactiviteiten. De activiteiten vind je in Elsene, vlakbij het Flageyplein en in Brussel-centrum, in KANAL \u2013 Centre Pompidou.","description_print":null,"booking_url":null,"sort_order":"CIVA","virtual_visit":null}},"districts":{"list":[5],"translations":{"de":["Flagey"],"pt":[null],"en":["Flagey"],"it":["Flagey"],"cn":[null],"fr":["Flagey"],"sp":["Flagey"],"nl":["Flagey"]}},"zones":{"list":[21],"translations":{"de":["S\u00fcden"],"pt":[null],"en":["South"],"it":["Sud"],"cn":[null],"fr":["Sud"],"sp":["Sur"],"nl":["Zuid"]}},"neca":"art_center","facebook_id":null,"backoffice_id":1436,"location":{"lat":50.82873218,"lon":4.36569034},"region":"brussels","last_updated_at":"2023-03-08T15:48:41+01:00","published_at":"2013-10-19T01:14:20+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":235577,"translations":{"de":{"name":"CIVA","add