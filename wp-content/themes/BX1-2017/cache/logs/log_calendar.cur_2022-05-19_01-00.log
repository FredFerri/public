lle, avec ta boma et ton bompa et m\u00eame les kets sont les bienvenus ! Tu dois pas avoir les poepers d'attraper la kiekebich, y aura du chauffage ! Tu pourras boire une bonne drache, m\u00eame deux ! Tu vas tomber de ta chaise de rire tellement on va raconter des carabistouilles et des zieverderaa ! Tu vas voir les meilleurs sketches de Monique & Suske et de Madame De Paeauw & Monsieur Peeters, plus des in\u00e9dits par-dessus le march\u00e9 ! C'est d\u00e9j\u00e0 bon ou t'en veux encore ?\r\n\r\nPrix: 25\u20ac, s\u00e9nior: 22\u20ac, \u00e9tudiant\/enfant\/sans emploi: 12.5\u20ac","performers":"Fran\u00e7ois de Paeuw et Maxime Thierry","boxoffice_url":null,"website":"http:\/\/www.fourire.be","email":"reservations@fourire.be","phone_contact":"+32 483 59 92 29","phone_booking":"+32 483 59 92 29","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/530420.html"},"nl":{"name":"Homenuzel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"info@fourire.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/530420.html"},"en":{"name":"Homenuzel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"info@fourire.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/530420.html"},"de":{"name":"Homenuzel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/530420.html"},"it":{"name":"Homenuzel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/530420.html"},"sp":{"name":"Homenuzel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_