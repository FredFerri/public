atische rondleidingen om u Brussel te laten ontdekken vanuit heel bijzondere en soms verrassende invalshoeken... Als gepassioneerde Brusselaars nemen ze je mee door de straten en steegjes van Brussel en tonen ze je de stad zoals zij die kennen, zoals zij ervan houden.\n\nStadslegendes, sociale strubbelingen, misdaadsc\u00e8nes, Art Nouveau of andere thema's, ga met ze mee en ontdek Brussel zoals je het nog nooit hebt gezien!\n\nDe rondleidingen zijn beschikbaar op inschrijving via de website, maar op verzoek kunnen er ook priv\u00e9rondleidingen voor groepen worden geregeld. Als onderdeel van deze priv\u00e9-ervaringen kunt u de rondleiding combineren met een chocoladeproeverij, een goed gebrouwen aperitief of een maaltijd in een authentiek Brussels etablissement.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":41819,"location":{"lat":50.8477202,"lon":4.3548659},"last_updated_at":"2024-10-16T12:31:41+02:00","published_at":"2024-01-20T21:02:59+01:00","is_in_address_book":true,"is_in_vb_export":false,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[],"dates":[{"day":"2024-12-15","doors":"14:00:00","start":"14:00:00","end":"16:30:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2025-02-02","doors":"14:00:00","start":"14:00:00","end":"16:30:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2025-03-23","doors":"14:00:00","start":"14:00:00","end":"16:30:00","end_night_life":null,"is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"de":{"name":"Kinder"},"en":{"name":"Children"},"it":{"name":"Bambini"},"fr":{"name":"Enfants"},"sp":{"name":"Ni\u00f1os"},"nl":{"name":"Kinderen"}},"value":15.5},{"translations":{"de":{"name":"Jugendliche"},"en":{"name":"Youth"},"it":{"name":"Ragazzi"},"fr":{"name":"Jeunes"},"sp":{"name":"J\u00f3venes"},"nl":{"name":"Jongeren"}},"value":15.5},