"is_canceled":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-04-25T10:35:06+02:00","published_at":"2022-04-25T10:07:28+02:00","backoffice_id":252419,"import_origin":null,"sub_type":"brocante","show_in_agenda":true,"ranking":1},{"id":532503,"date_start":"2022-05-21","date_end":"2022-05-21","date_next":"2022-05-21","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":true,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert"}},"others":{"list":[4,6],"translations":{"fr":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"],"nl":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"],"en":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"African Drums (SN\/RW\/RDC\/GN)","shortdescr":"Kuumba asbl & Muziekpublique","longdescr":"Aucun instrument n\u2019est plus \u00e9troitement associ\u00e9 au continent africain que les diff\u00e9rents types de tambours et de percussions. Les tambours jouent un r\u00f4le important dans tous les aspects de la vie africaine, qu\u2019ils soient physiques, \u00e9motionnels ou spirituels. Les tambours africains sont jou\u00e9s pour communiquer, c\u00e9l\u00e9brer, pleurer et inspirer. Ils sont jou\u00e9s en temps de paix et de guerre, de plantation et de r\u00e9colte, de naissance et de mort. Lors de cette rencontre, nous pr\u00e9senterons quatre groupes diff\u00e9rents issus d\u2019autant de pays ou de traditions. L\u2019Afrique de l\u2019Ouest est repr\u00e9sent\u00e9e par le joueur de djemb\u00e9 Moustafa Badji du S\u00e9n\u00e9gal et les percussionnistes de Cadence Mandingue qui perp\u00e9tuent la tradition de Mamady Keita. Fuyara, quant \u00e0 lui, laisse les tambours oblongs congolais et les mbonda parler. Le groupe spectaculaire Abahizi vient du Rwanda. Ils jouent de l\u2019ingoma, des tambours recouverts de peau d\u2019animal avec des hauteurs de son diff\u00e9rentes. Attendez-vous \u00e0 des danses surprenantes !","performers":"Moustafa Badji (S\u00e9n\u00e9gal)\r\nCadence Mandingue (Guinea Conakry\/Be)\r\nFuyara (DRC Congo)\r\nAbahizi (Rwanda)","boxoffice_url":null,"website":"http:\/\/www.muziekpublique.be","email":"info@muziekpublique.be","phone_contact":null,"phone_booking":"+32 2 217 26 00","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/532503.html"},"nl":{"name":"African Drums (SN\/RW\/RDC\/GN)","shortdescr":"Kuumba asbl & Muziekpublique","longdescr":"Geen instrumenten zijn nauwer verweven met het Afrikaanse continent dan de verschillende soorten trommels en percussie. Drums spelen een belangrijke rol in elk aspect van het Afrikaanse leven, inclusief het fysieke, emotionele en spirituele. Afrikaanse trommels worden bespeeld om te communiceren, te vieren, te rouwen en te inspireren. Ze worden gespeeld in tijden van vrede en oorlog, planten en oogsten, geboorte en dood. Tijdens deze meeting presenteren we vier verschillende bands uit evenveel landen of tradities. West-Afrika wordt vertegenwoordigd door djembespeler Moustafa Badji uit Senegal en de percussionistes van Cadence Mandingue die de traditie van Mamady Keita voortzetten. Fuyara laten de Congolese langwerpige trommels, de mbonda spreken. Uit Rwanda komt de spectaculaire groep Abahizi. Deze trommelaars bespelen de ingoma, met dierenvel bespannen trommels met verschillende toonhoogte. Verwacht je aan verrassende dansen.","performers":"Moustafa Badji (Senegal)\r\nCadence Mandingue (Guinea Conakry\/Be)\r\nFuyara (DRC Congo)\r\nAbahizi (Rwanda)","boxoffice_url":null,"website":"http:\/\/www.muziekpublique.be","email":"info@muziekpublique.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/532503.html"},"en":{"name":"African Drums (SN\/RW\/RDC\/GN)","shortdescr":"Kuumba asbl & Muziekpublique","longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/532503.html"},"de":{"name":"African Drums (SN\/RW\/RDC\/GN)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/532503.html"},"it":{"name":"African Drums (SN\/RW\/RDC\/GN)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/532503.html"},"sp":{"name":"African Drums (SN\/RW\/RDC\/GN)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/532503.html"},"pt":{"name":"African Drums (SN\/RW\/RDC\/GN)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/532503.html"},"cn":{"name":"African Drums (SN\/RW\/RDC\/GN)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/532503.html"}},"place":{"id":238099,"translations":{"fr":{"name":"Muziekpublique","address_street_name":"Galerie de la Porte de Namur","address_street_number":"3","address_street_box":null,"email":"info@muziekpublique.be","website":"http:\/\/www.muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":"+32 2 217 26 00","address_zip":"1050","address_city":"Ixelles","address_line1":"Galerie de la Porte de Namur, 3","address_line2":"1050 Ixelles","description_web":"Muziekpublique est le centre des musiques traditionnelles du monde de Bruxelles. Etablie dans le Th\u00e9\u00e2tre Moli\u00e8re au c\u0153ur du quartier africain, l\u2019asbl organise plus de 100 concerts par an et deux festivals (Hide & Seek Festival etc.). Par ailleurs Muziekpublique propose aussi 50 cours de musique et de danse du monde, comptant plus de 600 \u00e9l\u00e8ves. Ensuite, l\u2019asbl d\u00e9veloppe certains artistes et projets via son label, qui est aussi une agence de booking et de management. La musique traditionnelle a donc trouv\u00e9 un endroit id\u00e9al o\u00f9 se d\u00e9velopper et les artistes y constituent un r\u00e9seau vivant et dynamique cr\u00e9ant des liens de qualit\u00e9 avec le public. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Muziekpublique","address_street_name":"Galerij van de Naamsepoort","address_street_number":"3","address_street_box":null,"email":"info@muziekpublique.be","website":"http:\/\/www.muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":"+32 2 217 26 00","address_zip":"1050","address_city":"Elsene","address_line1":"Galerij van de Naamsepoort, 3","address_line2":"1050 Elsene","description_web":"Muziekpublique verspreidt en promoot muziek- en danstradities via een ambitieus programma van concerten, cursussen en projecten. Een jaarrond concertprogramma met Belgische en internationale artiesten vormt de kern van de activiteiten van de organisatie. Van contemplatieve tot feestelijke concerten vinden het hele jaar door plaats in het prachtige Moli\u00e8re Theater, aan de Naamsepoort, maar ook op verschillende plaatsen de hoofdstad.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Muziekpublique","address_street_name":"Galerie de la Porte de Namur","address_street_number":"3","address_street_box":null,"email":"info@muziekpublique.be","website":"http:\/\/www.muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":"+32 2 217 26 00","address_zip":"1050","address_city":"Ixelles","address_line1":"Galerie de la Porte de Namur, 3","address_line2":"1050 Ixelles","description_web":"Muziekpublique, keeps music and dance traditions alive and kicking in Brussels through an ambitious programme of concerts, courses, and projects. A year-round concert programme, featuring Belgian and international artists, forms the core of the foundation\u2019s activities. From the contemplative to the madly festive concerts take place indoors,  in the small Moli\u00e8re Theatre, in the arcade at the Porte de Namur and outdoors, around the city and throughout the year.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Muziekpublique","address_street_name":"Galerie de la Porte de Namur","address_street_number":"3","address_street_box":null,"email":"info@muziekpublique.be","website":"http:\/\/www.muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":"+32 2 217 26 00","address_zip":"1050","address_city":"Ixelles","address_line1":"Galerie de la Porte de Namur, 3","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Muziekpublique","address_street_name":"Galerie de la Porte de Namur","address_street_number":"3","address_street_box":null,"email":"info@muziekpublique.be","website":"http:\/\/www.muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":"+32 2 217 26 00","address_zip":"1050","address_city":"Ixelles","address_line1":"Galerie de la Porte de Namur, 3","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Muziekpublique","address_street_name":"Galer