:false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre"}},"others":{"list":[53],"translations":{"fr":["Contes"],"nl":["Verteltheater"],"en":["Tales"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"ma Soeur, mon Amour","shortdescr":"Cantique \u00e9lectro-gouine\r\nadultes \u2013 80 min","longdescr":"\"Deux femmes qui se tiennent la main, \u00e7a n\u2019a rien qui peut g\u00eaner la morale. L\u00e0 o\u00f9 le doute s\u2019installe, c\u2019est que ce geste se fasse dans un couvent\u2026\"\r\n\r\nLes cloches sonnent. S\u0153ur Sardine et S\u0153ur Casta vous invitent dans leur chapelle fleurie o\u00f9 vibrent les c\u0153urs candides des nonnes lesbiennes. Un lieu r\u00eav\u00e9, hors du monde, d\u00e9barrass\u00e9 des artifices d\u2019une \u00e9glise d\u00e9cadente et patriarcale, o\u00f9 les univers de S\u0153ur Sourire, Hildegarde von Bingen ou de Sister Act, se m\u00ealent \u00e0 celle de Coriandre, s\u0153ur lesbienne am\u00e9ricaine rentr\u00e9e dans le couvent des S\u0153urs du C\u0153ur Immacul\u00e9 de Marie, \u00e0 Hollywood dans les ann\u00e9es \u201960.\r\n\r\nLeurs voix silenci\u00e9es s\u2019\u00e9l\u00e8vent d\u2019amour et oscillent entre les rires et la col\u00e8re.\r\n\r\nLa tension du Couvent de la b\u00eate sacr\u00e9e de Norifumi Suzuki s\u2019entrechoque avec les paillettes scintillantes d\u2019Entre tinieblas d\u2019Almodovar. L\u2019innocence d\u2019une Jeannette de Bruno Dumont r\u00e9sonne avec le G\u00e9nie Lesbien d\u2019Alice Coffin. \r\nParce que les histoires lesbiennes sont aussi universelles que les histoires h\u00e9t\u00e9rosexuelles. AINSI SOIENT ELLES ! \r\n\r\nUne performance de la voix et de la parole, inspir\u00e9e de r\u00e9cits de vie de religieuses pleines de gr\u00e2ce et d\u2019audace \u00e0 travers les si\u00e8cles et les si\u00e8cles\u2026","performers":"Conception, r\u00e9cit : Aline La Sardine\r\nMusique : Casta\r\nAccompagnement artistique : Myriam Pellicane\r\nCostumes \u2013 Sc\u00e9nographie : Aline H\u00e9magi Fernande La Sardine, Moni Wespi, Elodie Demange, Myriam Pellicane et M\u00f3nica Mart\u00ed Aguiar\r\nSon et Lumi\u00e8res : Alice Dussart, Nathalie Thys\r\nSoutien et conseils : Carine Demange\r\nProduction Dimanches Du Conte","boxoffice_url":null,"website":"http:\/\/www.dimanchesduconte.be","email":"info@dimanchesduconte.be","phone_contact":"+32 488 51 28 60","phone_booking":"+32 488 51 28 60","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/528543.html"},"nl":{"name":"ma Soeur, mon Amour","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/528543.html"},"en":{"name":"ma Soeur, mon Amour","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/528543.html"},"de":{"name":"ma Soeur, mon Amour","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/528543.html"},"it":{"name":"ma Soeur, mon Amour","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/528543.html"},"sp":{"name":"ma Soeur, mon Amour","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/528543.html"},"pt":{"name":"ma Soeur, mon Amour","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"w