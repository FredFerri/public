it\u00e9, tendresse et lucidit\u00e9 se r\u00e9pondent. Musicienne, autrice-compositrice-interpr\u00e8te et com\u00e9dienne, la sc\u00e8ne et la musique font partie de sa vie depuis toujours. Avec ce projet, elle creuse un sillon encore plus personnel o\u00f9 elle fait la part belle aux claviers, aux cordes et aux basses groovy. Avec sa voix claire, elle aime capter l\u2019\u00e9ph\u00e9m\u00e8re, l\u2019instant fragile et les lignes de failles.\n__________\n\nDe Shabo \/ Avec : B\u00e9n\u00e9dicte Chabot \/ Basse, voix : Daniel Vincke \/ Guitares : Fran\u00e7ois Willemaers et C\u00e9dric Van Caillie\n","performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/retrouvailles-ete-2024","email":null,"phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50011603"},"sp":{"name":"Optimiste","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/retrouvailles-ete-2024","email":null,"phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50011603"},"nl":{"name":"Optimiste","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/retrouvailles-ete-2024","email":null,"phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50011603"}},"place":{"id":224476,"translations":{"de":{"name":"Th\u00e9\u00e2tre Le Public","address_street_name":"Rue Braemt","address_street_number":"64 70","address_street_box":null,"email":"contact@theatrelepublic.be","website":"http:\/\/www.theatrelepublic.be","phone_contact":"+32 2 724 24 44","phone_booking":"+32 2 724 24 44","address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Braemt, 64 70","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":n