"},"en":{"name":"Young"}},"value":10},{"translations":{"fr":{"name":"Pr\u00e9vente"},"nl":{"name":"Voorverkoop"},"en":{"name":"Presale"}},"value":13}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":{"list":[255,263],"translations":{"fr":["Accessible","Accessible aux pi\u00e9tons appareill\u00e9s"],"nl":["Toegankelijk","Toegankelijk voor voetgangers met hulpmiddelen"],"en":["Accessible","Accessible to pedestrians with mobility aids"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-04-07T01:35:45+02:00","published_at":"2022-03-30T12:14:23+02:00","backoffice_id":250530,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":0.34199518933534},{"id":527251,"date_start":"2022-05-24","date_end":"2022-05-24","date_next":"2022-05-24","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":84,"translations":{"fr":"Divers","nl":"Varia","en":"Various"}},"others":{}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Bruges et Damme \u00e0 v\u00e9lo!","shortdescr":"Les Mardis Curieux de S'Acad\u00e9mie asbl sont des visites guid\u00e9es \u00e0 Bruxelles, souvent en ext\u00e9rieur, pour d\u00e9couvrir la ville d'un autre point de vue: architectural, folklorique, industriel, etc...\u00a0","longdescr":"D\u00e9part de Bruxelles-central vers 9h en train pour Bruges ! \r\nA la gare brugeoise, nous r\u00e9cup\u00e9rons nos v\u00e9los et nous mettons en route \u00e0 2 roues pour Damme, le long des canaux brugeois en mode tranquille (env. 10km). Vers midi, \r\nnous prendrons le repas (3 services) au restaurant. Nous visiterons Damme \u00e0 pied\r\navec notre guide \u00e0 la d\u00e9couverte de son centre historique : la maison \u00ab la Grande Etoile \u00bb et l\u2019h\u00f4tel de ville, le pittoresque Haringmarkt (march\u00e9 au hareng) en passant par l\u2019\u00e9cluse de la Lieve. Nous continuons ensuite vers l\u2019\u00e9glise de style gothique Notre-Dame et l\u2019h\u00f4pital St.-Jean. Retour ensuite \u00e0 la gare de Bruges pour la restitution des v\u00e9los. Retour libre en train \u00e0 Bruxelles. \r\nLe prix comprend la balade \u00e0 v\u00e9lo, la location des v\u00e9los, le repas boissons comprises et la visite guid\u00e9e de l\u2019apr\u00e8s-midi mais pas le transport A\/R. Il est n\u00e9cessaire de savoir rouler \u00e0 v\u00e9lo dans la rue pour participer \u00e0 cette journ\u00e9e.\r\n\r\nLe Covid Safe Ticket est obligatoire pour le repas de midi.\r\n\r\nINSCRIPTION OBLIGATOIRE\u00a0:\r\n- Par courrier postal (rue des Moineaux, 17-19 \u2013 1000 Bruxelles)\r\nA notre accueil (Rue du Midi 118 \u2013 1000 Bruxelles, ouvert du lundi au vendredi de 8h30 \u00e0 12h)\r\n- Par e-mail (sacademie@fmsb.be)\r\n- Par fax (02 546 14 32)\r\n\r\nY mentionner :\r\nnom, pr\u00e9nom, adresse, date de naissance, n\u00b0 de gsm,\r\nl'activit\u00e9 choisie, n\u00b0 de membre S\u2019Acad\u00e9mie (ou n\u00b0 de mutuelle) ou demande d'affiliation.\r\n\r\nIl n'y a pas d'inscription par t\u00e9l\u00e9phone, mais l'asbl est joignable au 02 546 14 94 pour toute information.\r\nUne confirmation d'inscription vous parviendra par voie postale avec les modalit\u00e9s de paiement.\r\nUn courrier avec les informations pratiques vous sera envoy\u00e9 quelques jours avant l'activit\u00e9.\r\n\r\nLes activit\u00e9s sont r\u00e9serv\u00e9es aux membres de S'Acad\u00e9mie asbl:\r\n- Membres F\u00e9d\u00e9ration des Mutualit\u00e9s Socialistes du Brabant  : AFFILIATION gratuite\r\n- Non-FMSB  : 50 \u20ac par ann\u00e9e acad\u00e9mique\r\n- AFFILIATION possible sur simple demande pour les personnes de plus de 50 ans, pensionn\u00e9es ou non. \r\n\r\nLes conditions g\u00e9n\u00e9rales sous lesquelles sont organis\u00e9es les activit\u00e9s sont disponibles sur le site www.fmsb.be\/seniorsacademie. Vous inscrire implique que vous en ayez pris connaissance.\r\n\r\nLes informations pr\u00e9cises quant au d\u00e9part et au d\u00e9roulement de la journ\u00e9e vous seront communiqu\u00e9es lors de la confirmation d'inscription.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.fmsb.be\/fr\/sacademie","email":"sacademie@fmsb.be","phone_contact":null,"phone_booking":"+32 2 546 14 94","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/527251.html"},"nl":{"name":"Bruges et Damme \u00e0 v\u00e9lo!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/527251.html"},"en":{"name":"Bruges et Damme \u00e0 v\u00e9lo!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/527251.html"},"de":{"name":"Bruges et Damme \u00e0 v\u00e9lo!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/527251.html"},"it":{"name":"Bruges et Damme \u00e0 v\u00e9lo!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/527251.html"},"sp":{"name":"Bruges et Damme \u00e0 v\u00e9lo!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/527251.html"},"pt":{"name":"Bruges et Damme \u00e0 v\u00e9lo!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/527251.html"},"cn":{"name":"Bruges et Damme \u00e0 v\u00e9lo!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/527251.html"}},"place":{"id":271660,"translations":{"fr":{"name":"S\u2019Acad\u00e9mie asbl","address_street_name":"Rue du Midi","address_street_number":"118","address_street_box":null,"email":"sacademie@fmsb.be","website":"http:\/\/www.fmsb.be\/","phone_contact":"+32 2 546 14 94","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Midi, 118","address_line2":"1000 Bruxelles","description_web":"Vous \u00eates \u00e0 la retraite depuis peu ou en passe de l'\u00eatre? Vous voulez maintenir une vie sociale active et \u00e9panouissante? S'Acad\u00e9mie vous propose son large \u00e9ventail d'activit\u00e9s \u00e0 vocation \"sant\u00e9 et bien-\u00eatre\"!\r\n\r\nActivit\u00e9s: Conf\u00e9rences, ateliers divers (informatique, cuisine, danse, m\u00e9ditation, cours de gym douce,...), visites culturelles, marches et balades, voyages, cours de psorts, un gala de fin d'ann\u00e9e. Le tout \u00e0 un prix d\u00e9mocratique.\r\n\r\nComment participer: deux brochures semestrielles sont \u00e9dit\u00e9es par an: une pr\u00e9sente les activit\u00e9s pr\u00e9vues de septembre \u00e0 janvier, et une autre de f\u00e9vrier \u00e0 juin. Le programme est accessible sur le site internet : www.fmsb.be (F\u00e9d\u00e9ration des Mutualit\u00e9s Socialistes du Brabant)\r\n\r\nINSCRIPTIONS\r\nPar courrier postal (rue des Moineaux, 17-19 \u2013 1000 Bruxelles)\r\nA notre accueil (Rue du Midi 118 \u2013 1000 Bruxelles, ouvert du lundi au vendredi de 8h30 \u00e0 12h)\r\nPar e-mail (sacademie@fmsb.be)\r\nPar fax (02 546 14 32)\r\n\r\nY mentionner :\r\nnom, pr\u00e9nom, adresse, date de naissance, n\u00b0 de gsm,\r\nl'activit\u00e9 choisie, n\u00b0 de membre S\u2019Acad\u00e9mie (ou n\u00b0 de mutuelle) ou demande d'affiliation.\r\n\r\nIl n'y a pas d'inscription par t\u00e9l\u00e9phone, mais l'asbl est joignable au 02 546 14 94 pour toute information.\r\nUne confirmation d'inscription vous parviendra par voie postale avec les modalit\u00e9s de paiement.\r\nUn courrier avec les informations pratiques vous sera envoy\u00e9 quelques jours avant l'activit\u00e9.\r\n\r\nLes conditions g\u00e9n\u00e9rales sous lesquelles sont organis\u00e9es les activit\u00e9s sont disponibles sur le site www.fmsb.be\/seniorsacademie. Vous inscrire implique que vous en ayez pris connaissance.\r\n\r\nLes activit\u00e9s sont r\u00e9serv\u00e9es aux membres:\r\nMembres FMSB  : AFFILIATION gratuite\r\nNon-FMSB  : 50 \u20ac par ann\u00e9e acad\u00e9mique\r\nPublic: personnes de plus de 50 ans, pensionn\u00e9es ou non","description_print":"Vous \u00eates \u00e0 la retraite depuis peu ou en passe de l'\u00eatre? Vous voulez maintenir une vie sociale active et \u00e9panouissante? S'Acad\u00e9mie vous propose son large \u00e9ventail d'activit\u00e9s \u00e0 vocation \"sant\u00e9 et bien-\u00eatre\"!\r\n\r\nActivit\u00e9s: Conf\u00e9rences, ateliers divers (informatique, cuisine, danse, m\u00e9ditation, cours de gym douce,...), visites culturelles, marches et balades, voyages, cours de psorts, un gala de fin d'ann\u00e9e. Le tout \u00e0 un prix d\u00e9mocratique.\r\n\r\nComment participer: deux brochures semestrielles sont \u00e9dit\u00e9es par an: une pr\u00e9sente les activit\u00e9s pr\u00e9vues de septembre \u00e0 janvier, et une autre de f\u00e9vrier \u00e0 juin. Le programme est accessible sur le site internet : www.fmsb.be (F\u00e9d\u00e9ration des Mutualit\u00e9s Socialistes du Brabant)\r\n\r\nINSCRIPTIONS\r\nPar courrier postal (rue des Moineaux, 17-19 \u2013 1000 Bruxelles)\r\nA notre accueil (Rue du Midi 118 \u2013 1000 Bruxelles, ouvert du lundi au vendredi de 8h30 \u00e0 12h)\r\nPar e-mail (sacademie@fmsb.be)\r\nPar fax (02 546 14 32)\r\n\r\nY mentionner :\r\nnom, pr\u00e9nom, adresse, date de naissance, n\u00b0 de gsm,\r\nl'activit\u00e9 choisie, n\u00b0 de membre S\u2019Acad\u00e9mie (ou n\u00b0 de mutuelle) ou demande d'affiliation.\r\n\r\nIl n'y a pas d'inscription par t\u00e9l\u00e9phone, mais l'asbl est joignable au 02 546 14 94 pour toute information.\r\nUne confirmation d'inscription vous parviendra par voie postale avec les modalit\u00e9s de paiement.\r\nUn courrier avec les informations pratiques vous sera envoy\u00e9 quelques jours avant l'activit\u00e9.\r\n\r\nLes conditions g\u00e9n\u00e9rales sous lesquelles sont organis\u00e9es les activit\u00e9s sont disponibles sur le site www.fmsb.be\/seniorsacademie. Vous inscrire implique que vous en ayez pris connaissance.\r\n\r\nLes activit\u00e9s sont r\u00e9serv\u00e9es aux membres:\r\nMembres FMSB  : AFFILIATION gratuite\r\nNon-FMSB  : 50 \u20ac par ann\u00e9e acad\u00e9mique\r\nPublic: personnes de plus de 50 ans, pensionn\u00e9es ou non\r\n","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"S\u2019Acad\u00e9mie asbl","address_street_name":"Zuidstraat","address_street_number":"118","address_street_box":null,"email":"sacademie@fmsb.be","website":"http:\/\/www.fmsb.be\/","phone_contact":"+32 2 546 14 94","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Zuidstraat, 118","address_line2":"1000 Brussel","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"S\u2019Acad\u00e9mie asbl","address_street_name":"Rue du Midi","address_street_number":"118","address_street_box":null,"email":"sacademie@fmsb.be","website":"http:\/\/www.fmsb.be\/","phone_contact":"+32 2 546 14 94","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue du Midi, 118","address_line2":"1000 Brussels","description_web":"","description_print"