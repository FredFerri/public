s-brussels.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700004470"},"en":{"name":"Le Quatuor TAURUS aux Concerts de Midi.","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lunchconcerts-brussels.be\/","email":"info@lunchconcerts-brussels.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700004470"},"it":{"name":"Le Quatuor TAURUS aux Concerts de Midi.","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lunchconcerts-brussels.be\/","email":"info@lunchconcerts-brussels.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700004470"},"cn":{"name":"Le Quatuor TAURUS aux Concerts de Midi.","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lunchconcerts-brussels.be\/","email":"info@lunchconcerts-brussels.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700004470"},"fr":{"name":"Le Quatuor TAURUS aux Concerts de Midi.","shortdescr":null,"longdescr":"Le quatuor \u00e0 cordes TAURUS cl\u00f4ture l'ann\u00e9e 2024 aux Concerts de Midi. Wietse BEELS, Liesbeth BAELUS, Vincent HEPP et Martijn VINK joueront le Quatuor du compositeur belge Frederik Van Rossum ainsi que le splendide quatuor de Gabriel FAURE, d\u00e9c\u00e9d\u00e9 il y a 100 ans... Des moments magiques en perspective!\nVoici le programme complet donn\u00e9 par le Quatuor \u00e0 cordes TAURUS:\nGabriel FAUR\u00c9 (1845-1924) \nQuatuor \u00e0 cordes en mi mineur opus 121 \nAllegro moderato  - Andante - Finale: Allegro \n\nFrederik Van Rossum (1939) \nQuatuor op.14 (1967) \nAllegro  - Andante  - Adagio - Finale \n\n","performers":"Taurus strijkkwartet: Wietse BEELS, violon, Liesbeth BAELUS, violon, Vincent HEPP, alto, Martijn VINK, violoncelle.","boxoffice_url":null,"website":"https:\/\/www.lunchconcerts-brussels.be\/","email":"info@lunchconcerts-brussels.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700004470"},"sp":{"name":"Le Quatuor TAURUS aux Concerts de Midi.","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lunchconcerts-brussels.be\/","email":"info@lunchconcerts-brussels.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700004470"},"nl":{"name":"Het TAURUS strijkkwartet in de Middagconcerten.","shortdescr":null,"longdescr":"Het Taurus strijkkwartet sluit 2024 af in de Middagconcerten.  Wietse BEELS, Liesbeth BAELUS, Vincent HEPP et Martijn VINK zullen het kwartet van Belgisch componist Frederik Van Rossum spelen, alsmede het prachtig strijkkwartet van Gabriel FAURE, net 100 jaar geleden overleden. Magische momenten op komst !\nDit is het volledig programma dat het TAURUS strijkkwartet zal uitvoeren:\nGabriel FAUR\u00c9 (1845-1924)\nQuatuor \u00e0 cordes en mi mineur opus 121\nAllegro moderato  - Andante - Finale: Allegro\n\nFrederik Van Rossum (1939)\nQuatuor op.14 (1967)\nAllegro  - Andante  - Adagio - Finale\n\n","performers":"Quatuor Taurus: Wietse BEELS, viool, Liesbeth BAELUS, viool, Vincent HEPP, altviool, Martijn VINK, cello.","boxoffice_url":null,"website":"https:\/\/lunchconcerts-brussels.be\/nl\/","email":"info@lunchconcerts-brussels.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700004470"}},"place":{"id":100473,"translations":{"de":{"name":"MIM - Musikinstrumente-Museum (MRAH)","address_street_name":"Rue Montagne de la Cour","address_street_number":"2","address_street_box":null,"email":"info@mim.be","website":"http:\/\/www.mim.be","phone_contact":"+32 2 545 01 30","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Montagne de la Cour, 2","address_line2":"1000 Bruxelles","description_web":"Das Br\u00fcsseler Musikinstrumente-Museum mit 1200 ausgestellten Musikinstrumenten und vielf\u00e4ltigen Sammlungen (mit insgesamt 8000 Instrumenten!), untergebracht in einem bemerkenswerten Jugendstilgeb\u00e4ude, ist ein Paradies f\u00fcr Musikinteressierte.\r\n\r\nMusikgeschichte und Jugendstilarchitektur: Das Musikinstrumente-Museum befindet sich in den ehemaligen Geb\u00e4uden des \u201eOld England\u201c-Kaufhauses und gilt als eines der herausragenden Beispiele f\u00fcr die Br\u00fcsseler Jugendstilarchitektur.\r\n\r\nMusikalische Welt- und Zeitreise: Auf vier Ebenen pr\u00e4sentiert das Museum Musikinstrumente aus verschiedenen Kulturkreisen und Epochen \u2013 und so begibt sich der Besucher auf eine musikalische Welt- und Zeitreise. Die Ausstellungsgestaltung verkn\u00fcpft gekonnt klangliche und visuelle Dimensionen.\r\n\r\nKulinarischer H\u00f6hepunkt, im wahrsten Sinne des Wortes, ist das Restaurant im 6. Stock mit Dachterrasse.\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"MIM - Museu dos Instrumentos Musicais","address_street_name":"Rue Montagne de la Cour","address_street_number":"2","address_street_box":null,"email":"info@mim.be","website":"http:\/\/www.mim.be","phone_contact":"+32 2 545 01 30","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Montagne de la Cour, 2","address_line2":"1000 Bruxelles","description_web":"Todo o mundo admira a cole\u00e7\u00e3o do Museu dos Instrumentos Musicais, que pertence ao conjunto dos Museus Reais de Arte e da Hist\u00f3ria. Este museu assenta no cora\u00e7\u00e3o dos velhos edif\u00edcios Old England, um dos edif\u00edcios mais belos de estilo Art Nouveau de Bruxelas, datando de 1899. Este museu \u00e9 um dos mais ricos do mundo: cerca de 1200 instrumentos encontram-se a\u00ed expostos. Consta da programa\u00e7\u00e3o de interessantes anima\u00e7\u00f5es e in\u00fameros concertos.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"MIM - Musical Instruments Museum (MRAH)","address_street_name":"Hofberg","address_street_number":"2","address_street_box":null,"email":"info@mim.be","website":"http:\/\/www.mim.be","phone_contact":"+32 2 545 01 30","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Brussels","address_line1":"Hofberg, 2","address_line2":"1000 Brussels","description_web":"As soon as it opened at the end of the 19th century, the luxurious Old England department store earned an excellent reputation for its highly distinctive building. The entrance to the building is a jewel of the Art Nouveau style, while the rest is in perfect harmony with the neoclassical ensemble on the Place Royale, and just around the corner from the Grand-Place and Central Station, no less! \r\nWith a wealth of some 9.000 instruments, some 1.200 of which are on permanent exhibit, the museum's reputation is mainly built on its extraordinary collections.\r\nOnce inside, you'll embark on a true tour of the musical world. After your visit, the instruments and their history will no longer hold any secrets: from the viola da gamba from the Court of Brussels to the 20th century theremin, and even including the African kora!\r\nThe mim is nothing other than a place to experience music. A visitor's guidance system allows you to explore the thematic tours to the tune of the melodious sound of the instruments presented.\r\nA program packed with concerts, demonstrations and workshops for the young and the not so young makes the mim experience even better.\r\nThe mim has its own concert hall, specialized library, museum shop, workshop for restauration and conservation of musical instruments and is crowned by a restaurant with panoramic view over Brussels.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Museo degli Strumenti Musicali","address_street_name":"Rue Montagne de la Cour","address_street_number":"2","address_street_box":null,"email":"info@mim.be","website":"http:\/\/www.mim.be","phone_contact":"+32 2 545 01 30","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Montagne de la Cour, 2","address_line2":"1000 Bruxelles","description_web":"Il MIM presenta una collezione di strumenti musicali di fama internazionale e une larga gamma di attivit\u00e0 in collegamento con questa collezione a un pubblico largo e...\r\n\r\nIl MIM presenta una collezione di strumenti musicali di fama internazionale e une larga gamma di attivit\u00e0 in collegamento con questa collezione a un pubblico largo e diversificato dal Belgio e dall'estero. Presenta un'ampio panorama della musica antica, moderna, popolare e tradizionale.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"MIM - Mus\u00e9e des instruments de musique (MRAH)","address_street_name":"Rue Montagne de la Cour","address_street_number":"2","address_street_box":null,"email":"info@mim.be","website":"http:\/\/www.mim.be","phone_contact":"+32 2 545 01 30","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Montagne de la Cour, 2","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"MIM - Mus\u00e9e des instruments de musique (MRAH)","address_street_name":"Rue Montagne de la Cour","address_street_number":"2","address_street_box":null,"email":"info@mim.be","website":"http:\/\/www.mim.be","phone_contact":"+32 2 545 01 30","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Montagne de la Cour, 2","address_line2":"1000 Bruxelles","description_web":"Le monde entier admire la collection du Mus\u00e9e des instruments de musique qui fait partie du groupement des Mus\u00e9es Royaux d\u2019Art et d\u2019Histoire. Ce Mus\u00e9e est camp\u00e9 au c\u0153ur des anciens b\u00e2timents Old England, un des plus beaux b\u00e2timents de style Art Nouveau de Bruxelles, datant de 1899. Ce mus\u00e9e est l\u2019un des plus riches au monde : quelques 1.200 instruments y sont expos\u00e9s. D\u2019int\u00e9ressantes animations et de nombreux concerts y sont programm\u00e9s.","description_print":null,"booking_url":null,"sort_order":"MIM","virtual_visit":null,"visit_url":null},"sp":{"name":"El MIM, Museo de Instrumentos de M\u00fasica","address_street_name":"Rue Montagne de la Cour","address_street_number":"2","address_street_box":null,"email":"info@mim.be","website":"http:\/\/www.mim.be","phone_contact":"+32 2 545 01 30","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Montagne de la Cour, 2","address_line2":"1000 Bruxelles","description_web":"El Museo MIM te invita a contemplar y escuchar 1.200 instrumentos de m\u00fasica en un edificio Art Nouveau de Bruselas. \r\n\r\nEl Museo de Instrumentos de M\u00fasica, que forma parte de los Museos Reales de Arte e Historia, abre sus puertas en las proximidades de la Place Royale, en el Mont des Arts, el barrio de los museos de Bruselas. \r\n\r\nEl MIM se encuentra en los antiguos almacenes de Art Nouveau, Old England, un aut\u00e9ntico tesoro arquitect\u00f3nico de finales del s. XIX.\r\n\r\nEl MIM debe su reputaci\u00f3n, sobre todo, a sus extraordinarias colecciones. Ven a dar la vuelta al mundo musical a trav\u00e9s de sus 1.200 piezas distribuidas por las 4 plantas de la exposici\u00f3n.\r\n\r\n\r\nComo es de suponer, el MIM es el lugar ideal para disfrutar de la m\u00fasica. Un sistema de cascos con infrarrojos permite explorar los recorridos tem\u00e1ticos al tiempo que se escucha el sonido melodioso de los instrumentos que se presentan.\r\n   \r\nEl MIM tambi\u00e9n es\u2026\r\n\r\n- Una sala de conciertos\r\n- Un espacio para talleres\r\n- Un Museumshop\r\n- Una biblioteca especializada\r\n- Y un restaurante con terraza, con unas vistas \u00fanicas al centro hist\u00f3rico de la capital europea\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"MIM - Muziekinstrumentenmuseum (KMKG)","address_street_name":"Hofberg","address_street_number":"2","address_street_box":null,"email":"info@mim.be","website":"http:\/\/www.mim.be","phone_contact":"+32 2 545 01 30","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Brussel","address_line1":"Hofberg, 2","address_line2":"1000 Brussel","description_web":"Het Muziekinstrumentenmuseum (MIM) bewaart een onschatbare collectie van muzikaal erfgoed en presenteert ze op een schitterende manier. Het MIM beschikt daarvoor over veel troeven. De intu\u00eftieve presentatie is aantrekkelijk en klantvriendelijk. De collectie huist bovendien in een schitterend gerestaureerd art-nouveaupand. Het MIM presenteert een honderdtal middagconcerten per jaar en biedt een waaier aan groepsactiviteiten.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[16],"translations":{"de":["K\u00f6nigliches Viertel"],"pt":[null],"en":["Royal"],"it":["Quartiere reale"],"cn":[null],"fr":["Quartier Royal"],"sp":["Quartier Royal \u2014Barrio de la Corte\u2014"],"nl":["Koninklijke wijk"]}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":null,"facebook_id":null,"backoffice_id":359,"location":{"lat":50.8427438,"lon":4.3590245},"region":"brussels","last_updated_at":"2024-08-22T15:56:07+02:00","published_at":"201