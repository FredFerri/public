end":"2022-06-25","date_next":"2022-06-25","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{"list":[109],"translations":{"fr":["Espaces verts"],"nl":["Groene zones"],"en":["Green spaces"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Balade nature \u00e0 la d\u00e9couverte du jardin Hap","shortdescr":null,"longdescr":"A l'occasion de la Ducasse de printemps organis\u00e9e le 25 juin prochain sur diff\u00e9rents sites de la commune, nous vous proposons une balade nature \u00e0 la d\u00e9couverte de la richesse du jardin Jean-F\u00e9lix Hap, un \u00e9crin de verdure ressour\u00e7ant et apaisant accueillant une faune et une flore exceptionnelles ! \r\nTrois d\u00e9parts sont possibles : 14h - 15h - 16h\r\nInscription souhait\u00e9e via etterbeek.durable@etterbeek.brussels ou au 02\/627.27.85.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.etterbeek.be","email":"etterbeek.durable@etterbeek.brussels","phone_contact":"+32 2 627 27 85","phone_booking":"+32 2 627 27 85","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/531801.html"},"nl":{"name":"Balade nature \u00e0 la d\u00e9couverte du jardin Hap","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"etterbeek.durable@etterbeek.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/531801.html"},"en":{"name":"Balade nature \u00e0 la d\u00e9couverte du jardin Hap","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"etterbeek.durable@etterbeek.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/531801.html"},"de":{"name":"Balade nature \u00e0 la d\u00e9couverte du jardin Hap","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/531801.html"},"it":{"name":"Balade nature \u00e0 la d\u00e9couverte du jardin Hap","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/531801.html"},"sp":{"name":"Balade nature \u00e0 la d\u00e9couverte du jardin Hap","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/531801.html"},"pt":{"name":"Balade nature \u00e0 la d\u00e9couverte du jardin Hap","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/531801.html"},"cn":{"name":"Balade nature \u00e0 la d\u00e9couverte du jardin Hap","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/531801.html"}},"place":{"id":236089,"translations":{"fr":{"name":"Jardin Jean-F\u00e9lix Hap","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Jardin Jean-F\u00e9lix Hap","address_line2":"1040 Etterbeek","description_web":"Le jardin Jean-F\u00e9lix Hap est probablement le plus beau parc d\u2019Etterbeek, avec ses arbres majestueux, ses grandes pelouses et ses chemins serpentants. Il porte le nom du dernier propri\u00e9taire de ce domaine familial, h\u00e9rit\u00e9 de g\u00e9n\u00e9ration en g\u00e9n\u00e9ration.\r\n\r\nFaites un tour du c\u00f4t\u00e9 de l\u2019Orangerie, d\u00e9couvrez les ruines du ch\u00e2teau de style Renaissance flamande et admirez la maison n\u00e9o-classique de Fran\u00e7ois-Louis Hap. Le parc poss\u00e8de aussi un espace \u00e9cologique didactique, qui promeut la biodiversit\u00e9.\r\n\r\nNon loin du parc se dresse la Maison Cauchie, un joyau de l\u2019Art nouveau \u00e0 visiter. \u00c0 deux pas, rendez-vous au parc L\u00e9opold ou au Cinquantenaire, o\u00f9 vous promener mais aussi visiter Autoworld et les mus\u00e9es Art & Histoire ainsi que de l\u2019Arm\u00e9e & de l\u2019Histoire Militaire.\r\n\r\nPour une pause gourmande, direction le Pain Quotidien.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Jean-Felix Haptuin","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Jean-Felix Haptuin","address_line2":"1040 Etterbeek","description_web":"Dit is wellicht het mooiste park van Etterbeek. Dat komt door de majestueuze bomen, de grote grasperken en de kronkelende paden in het park. Jean-Felix Hap was de laatste eigenaar van dit familiebezit dat van generatie op generatie werd doorgegeven.\r\n\r\nNeem een kijkje in de Orangerie, ontdek de ru\u00efnes van het Vlaamse renaissancekasteel en bewonder het neoclassicistische huis van Fran\u00e7ois-Louis Hap. Het park heeft ook een educatieve ecologische ruimte, die de biodiversiteit bevordert.\r\n\r\nNiet ver van het park ligt het Cauchiehuis, een echte art-nouveauparel. Op korte loopafstand ben je in het Leopoldpark of het Jubelpark. Daar kan je een langere wandeling maken en een bezoek brengen aan Autoworld, de Koniklijke Musea voor Kunst & Geschiedenis en het Legermuseum.\r\n\r\nHonger? Wat dacht je van de Pain Quotidien, vlakbij?","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Jean-Felix Hap Park","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Jean-Felix Hap Park","address_line2":"1040 Etterbeek","description_web":"Jean-F\u00e9lix Hap Park is probably the most beautiful park in Etterbeek, with its majestic trees, large lawns and winding paths. It bears the name of the last owner of this family estate, which was passed down from generation to generation.\r\n\r\nGo for a walk around the Orangery, discover the ruins of the Flemish Renaissance castle and admire the neo-classical house of Fran\u00e7ois-Louis Hap. The park also has an educational ecological area, which promotes biodiversity.\r\n\r\nNot far from the park lies Cauchie House, a must-visit Art Nouveau gem. Just a stone's throw away, head to Leopold Park or Cinquantenaire Park, where you can go for a stroll or visit Autoworld, the Art & History Museum or the Royal Museum of the Armed Forces and Military History.\r\n\r\nFor a sweet treat, head to Le Pain Quotidien.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Jardin Jean-F\u00e9lix Hap","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Jardin Jean-F\u00e9lix Hap","address_line2":"1040 Etterbeek","description_web":"Der Jardin Jean-F\u00e9lix Hap mit seinen majest\u00e4tischen B\u00e4umen, gro\u00dfen Rasenfl\u00e4chen und verschlungenen Wegen ist der wohl sch\u00f6nste Park der Gemeinde Etterbeek. Benannt wurde er nach dem letzten Besitzer dieses Familienanwesens, das von Generation zu Generation weitervererbt wurde.\r\n\r\nBegeben Sie sich auf einen Spaziergang durch die Orangerie, entdecken Sie die Ruinen des Schlosses im Stil der fl\u00e4mischen Renaissance und bewundern Sie das neoklassizistische Wohnhaus von Fran\u00e7ois-Louis Hap. Der Park verf\u00fcgt auch \u00fcber einen kleinen Lehrgarten mit hoher Artenvielfalt.\r\n\r\nNicht weit vom Park entfernt befindet sich das atemberaubende Jugendstilhaus Maison Cauchie, das besichtigt werden kann. Auch bis zum Parc L\u00e9opold und dem Parc Cinquantenaire ist es nicht weit. Hier k\u00f6nnen Sie entweder Ihren Spaziergang fortsetzen oder die dort niedergelassenen Museen besichtigen: Autoworld, das Museum f\u00fcr Kunst & Geschichte und das Museum f\u00fcr Armee und Milit\u00e4rgeschichte.\r\n\r\nSt\u00e4rken k\u00f6nnen Sie sich anschlie\u00dfend bei Pain Quotidien.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Jardin Jean-F\u00e9lix Hap","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Jardin Jean-F\u00e9lix Hap","address_line2":"1040 Etterbeek","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Jardin Jean-F\u00e9lix Hap","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Jardin Jean-F\u00e9lix Hap","address_line2":"1040 Etterbeek","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Jardin Jean-F\u00e9lix Hap","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":nul