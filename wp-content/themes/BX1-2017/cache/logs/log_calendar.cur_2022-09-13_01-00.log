d":"17:00:00"},{"day":"2022-10-16","doors":null,"start":"14:00:00","end":"17:00:00"}],"recurring":[{"day":"saturday","occurences":{"is_first":true,"is_second":true,"is_third":true,"is_fourth":true,"is_last":true},"time_start":"14:00:00","time_end":"17:00:00","translations":{"fr":"Ouvert les premier, deuxi\u00e8me, troisi\u00e8me, quatri\u00e8me et dernier samedis du mois de 14:00 \u00e0 17:00","nl":"Open op de eerste, tweede, derde, vierde en laatste zaterdags van de maand van 14:00 tot 17:00","en":"Open the first, second, third, fourth and last saturdays of the month from 14:00 to 17:00"}},{"day":"sunday","occurences":{"is_first":true,"is_second":true,"is_third":true,"is_fourth":true,"is_last":true},"time_start":"14:00:00","time_end":"17:00:00","translations":{"fr":"Ouvert les premier, deuxi\u00e8me, troisi\u00e8me, quatri\u00e8me et dernier dimanches du mois de 14:00 \u00e0 17:00","nl":"Open op de eerste, tweede, derde, vierde en laatste zondags van de maand van 14:00 tot 17:00","en":"Open the first, second, third, fourth and last sundays of the month from 14:00 to 17:00"}}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":10}],"child_events":[],"parent_events":[],"targets":{"list":[4,5,11,7,8],"translations":{"fr":["Enfants 6-9 ans","Enfants 9-12 ans","Famille","Jeunes 12-15 ans","Jeunes 15-18 ans"],"nl":["Kinderen 6-9 j.","Kinderen 9-12 j.","Familie","Jongeren 12-15 j.","Jongeren 15-18 j."],"en":["Children 6-9 yr.","Children 9-12 yr.","Family","Youth 12-15  yr.","Youth 15-18  yr."]}},"tags":["kids"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-09-12T01:09:23+02:00","published_at":"2022-09-09T13:55:15+02:00","backoffice_id":261459,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.3568829277518},{"id":535906,"date_start":"2022-08-01","date_end":"2022-09-17","date_next":"2022-09-17","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre"}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Normal!","shortdescr":"Unique comme tout le monde, diff\u00e9rent comme personne!\r\nNormal! est un spectacle sur la diff\u00e9rence, le courage, la tol\u00e9rance et ce qui fait de nous des humains.","longdescr":"Karen De Paduwa nous y raconte avec humour et \u00e9motion, certaines histoires de sa vie de \u00abpremi\u00e8re com\u00e9dienne handicap\u00e9e de Belgique.\u00bb.\r\nCe spectacle mordant, d\u00e9lirant et sensible se veut lever les barri\u00e8res entre les gens dits \u00abnormaux\u00bb et les \u00abmutants\u00bb (nains, g\u00e9ants, porteurs de trisomie 21...) qui peuvent devenir les \u00ab Super-H\u00e9ros \u00bb de nos vies \u00e0 tous.\r\n\r\nKaren de Paduwa pr\u00e9f\u00e8re le m\u00e9gaphone au poing lev\u00e9 pour parler de la diff\u00e9rence mais le titre du spectacle ne laisse pas planer le doute: \u00ab Normal!\u00bb, avec un point d\u2019exclamation s\u2019il vous pla\u00eet. Dans son spectacle, \u00e9motion rime avec humour tout au long de cette partition men\u00e9e tambour battant.\r\nPour Karen, une formule choc d\u00e9crit bien sa carri\u00e8re exemplaire: \u00abUnique comme tout le monde, diff\u00e9rente comme personne\u00bb. C\u2019est ainsi qu\u2019elle souhaite \u00eatre vue, dans chaque pi\u00e8ce, chaque r\u00f4le, chaque r\u00e9plique, non pas en com\u00e9dienne naine, mais en com\u00e9dienne tout court! Elle est \u00e0 deux doigts d\u2019y r\u00e9ussir, mais peut-\u00eatre faudrait-il pour y \u00eatre tout \u00e0 fait que son r\u00eave intime et un peu fou se r\u00e9alise enfin: celui de jouer un des grands r\u00f4les du r\u00e9pertoire, la Roxanne de Cyrano ou la Juliette de Shakespeare. Elle s\u2019y sent parfaitement pr\u00eate. A bon entendeur\u2026\r\n\r\n\u00abQue Thierry Janssen ait \u00e9crit sp\u00e9cialement pour moi, me touche particuli\u00e8rement. Parce que cette diff\u00e9rence, j\u2019en ai fait une force ! Le besoin de partager mon exp\u00e9rience tant personnelle que professionnelle est vital.\u00bb\r\nKaren de Paduwa","performers":"ONE-WOMAN SHOW DE THIERRY JANSSEN\r\nMise en sc\u00e8ne: Gauthier Bourgois \u25aa Avec: Karen De Paduwa","boxoffice_url":"https:\/\/shop.utick.be\/?pos=FESTIVALBRUXELLONS&module=CATALOGUE&lg=FR","website":"http:\/\/www.bruxellons.be","email":"info@bruxellons.net","phone_contact":null,"phone_booking":"+32 2 724 24 24","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.535906"},"nl":{"name":"Normal!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/shop.utick.be\/?pos=FESTIVALBRUXELLONS&module=CATALOGUE&lg=NL","website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.535906"},"en":{"name":"Normal!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/shop.utick.be\/?pos=FESTIVALBRUXELLONS&module=CATALOGUE&lg=EN","website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.535906"},"de":{"name":"Normal!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.535906"},"it":{"name":"Normal!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/