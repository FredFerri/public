,{"day":"2023-04-21","doors":null,"start":"00:00:00","end":null},{"day":"2023-04-22","doors":null,"start":"00:00:00","end":null},{"day":"2023-04-23","doors":null,"start":"00:00:00","end":null},{"day":"2023-04-24","doors":null,"start":"00:00:00","end":null},{"day":"2023-04-25","doors":null,"start":"00:00:00","end":null},{"day":"2023-04-26","doors":null,"start":"00:00:00","end":null},{"day":"2023-04-27","doors":null,"start":"00:00:00","end":null}],"prices":[],"child_events":[555393,555389,555392,555394,555391,555387],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":["major_event"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-04-25T03:06:13+02:00","published_at":"2023-04-13T14:16:08+02:00","backoffice_id":275373,"import_origin":null,"sub_type":"festival","show_in_agenda":true,"ranking":0.5},{"id":554379,"date_start":"2023-04-13","date_end":"2023-04-30","date_next":"2023-04-25","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":118,"translations":{"fr":"Festival","nl":"Festival","en":"Festival","de":"Festival","it":"Festival","sp":"Festival","pt":null,"cn":null}},"others":{"list":[123],"translations":{"fr":["Worldmusic, Folk & Country"],"nl":["Worldmusic, Folk & Country"],"en":["Worldmusic, Folk & Country"],"de":["Worldmusic, Folk & Country"],"it":["Worldmusic, Folk e Country"],"sp":["Worldmusic, folk y country"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr","el"],"subtitles":[]},"translations":{"fr":{"name":"Le Greek Club - La Gr\u00e8ce se raconte","shortdescr":"Au mois d'avril, on fait escale en Gr\u00e8ce au MedexMuseum. Chaque mois, l'\u00e9quipe du Mus\u00e9e \u00e9ph\u00e9m\u00e8re de l'exil met \u00e0 l'honneur l'une des 183 communaut\u00e9s de Bruxelles \u00e0 travers une s\u00e9rie d'\u00e9v\u00e8nements artistiques, culturels et culinaires.","longdescr":"A partir de mi-avril, on fait escale en Gr\u00e8ce pour une s\u00e9rie d'\u00e9v\u00e8nements musicaux, po\u00e9tiques et artistiques co-cr\u00e9\u00e9s avec des Grecs, artistes et non-artistes, qui habitent \u00e0 Bruxelles. \r\n\r\nConcerts, banquet philosophique et performatif, atelier cuisine, initiation aux chants traditionnels... ne manquez pas l'une de ces occasions de voguer sur la douceur de vivre \u00e0 la grecque !","performers":"Panos Gourgiotis ; Giouli (voix) ; Asimina Karamperopoulou (voix) ; Antonis Moutselos (violon) ; Renaud Dardenne (guitare)","boxoffice_url":null,"website":"http:\/\/www.medexmuseum.com\/183-assiettes\/","email":"medexmuseum@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.554379"},"nl":{"name":"Le Greek Club - La Gr\u00e8ce se raconte","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.medexmuseum.com\/183-assiettes\/","email":"medexmuseum@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.554379"},"en":{"name":"Le Greek Club - La Gr\u00e8ce se raconte","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.medexmuseum.com\/183-assiettes\/","email":"medexmuseum@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.554379"},"de":{"name":"Le Greek Club @MedexMuseum","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.medexmuseum.com\/183-assiettes\/","email":"medexmuseum@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.554379"},"it":{"name":"Le Greek Club @MedexMuseum","shortdes