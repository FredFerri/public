on bompa et m\u00eame les kets sont les bienvenus ! Tu dois pas avoir les poepers d'attraper la kiekebich, y aura du chauffage !\nTu pourras boire une bonne drache, m\u00eame deux !\nTu vas tomber de ta chaise de rire tellement on va raconter des carabistouilles et des zieverderaa !\nTu vas voir les meilleurs sketches de Monique & Suske et de Madame De Paeauw &\nMonsieur Peeters, plus des in\u00e9dits par-dessus le march\u00e9 !\nC'est d\u00e9j\u00e0 bon ou t'en veux encore ?","performers":"Fran\u00e7oise de Paeuw et Maxime Thierry","boxoffice_url":"https:\/\/www.visit.brussels\/fr\/visiteurs\/agenda\/event-detail\/book-tickets.Home-nuzel.5700005460","website":"https:\/\/fourire.be\/","email":"reservations@fourire.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700005460"},"sp":{"name":"Home nuzel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/www.visit.brussels\/es\/visitantes\/agenda\/event-detail\/book-tickets.Home-nuzel.5700005460","website":"https:\/\/fourire.be\/","email":"reservations@fourire.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700005460"},"nl":{"name":"Home nuzel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/www.visit.brussels\/nl\/bezoekers\/agenda\/event-detail\/book-tickets.Home-nuzel.5700005460","website":"https:\/\/fourire.be\/","email":"reservations@fourire.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700005460"}},"place":{"id":249081,"translations":{"de":{"name":"Fou Rire","address_street_name":"Avenue des Grenadiers","address_street_number":"48","address_street_box":null,"email":"info@fourire.be","website":"http:\/\/www.fourire.be","phone_contact":"+32 483 59 92 29","phone_booking":"+32 70 66 06 01","address_zip":"1050","address_city":"Ixelles","addr