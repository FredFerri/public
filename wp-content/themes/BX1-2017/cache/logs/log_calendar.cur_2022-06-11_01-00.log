022-03-07","doors":null,"start":"16:15:00","end":"17:15:00"},{"day":"2022-03-14","doors":null,"start":"17:15:00","end":"18:15:00"},{"day":"2022-04-04","doors":null,"start":"16:15:00","end":"17:15:00"},{"day":"2022-04-11","doors":null,"start":"17:15:00","end":"18:15:00"},{"day":"2022-05-02","doors":null,"start":"16:15:00","end":"17:15:00"},{"day":"2022-05-09","doors":null,"start":"17:15:00","end":"18:15:00"},{"day":"2022-06-06","doors":null,"start":"16:15:00","end":"17:15:00"},{"day":"2022-06-13","doors":null,"start":"17:15:00","end":"18:15:00"}],"recurring":[{"day":"monday","occurences":{"is_first":true,"is_second":false,"is_third":false,"is_fourth":false,"is_last":false},"time_start":"16:15:00","time_end":"17:15:00","translations":{"fr":"Ouvert le premier lundi du mois de 16:15 \u00e0 17:15","nl":"Open op de eerste maandag van de maand van 16:15 tot 17:15","en":"Open the first monday of the month from 16:15 to 17:15"}},{"day":"monday","occurences":{"is_first":false,"is_second":true,"is_third":false,"is_fourth":false,"is_last":false},"time_start":"17:15:00","time_end":"18:15:00","translations":{"fr":"Ouvert le deuxi\u00e8me lundi du mois de 17:15 \u00e0 18:15","nl":"Open op de tweede maandag van de maand van 17:15 tot 18:15","en":"Open the second monday of the month from 17:15 to 18:15"}}],"prices":[{"translations":{"fr":{"name":"Senior"},"nl":{"name":"Senioren"},"en":{"name":"Senior"}},"value":4}],"child_events":[],"parent_events":[],"targets":{"list":[10],"translations":{"fr":["Seniors"],"nl":["Senioren"],"en":["Seniors"]}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-06-07T01:07:42+02:00","published_at":"2022-03-02T11:45:31+01:00","backoffice_id":248686,"import_origin":null,"sub_type":"sport","show_in_agenda":true,"ranking":0.14971359717807},{"id":535572,"date_start":"2022-06-14","date_end":"2022-06-14","date_next":"2022-06-14","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{}},"languages":{"spoken":["nl","fr"],"subtitles":[]},"translations":{"fr":{"name":"Les sources du Geleytsbeek","shortdescr":null,"longdescr":"Pour cette nouvelle activit\u00e9 \u2018Retour aux sources\u2019, nous vous invitons \u00e0 parcourir la vall\u00e9e du Geleytsbeek \u00e0 Uccle. Le Geleytsbeek prend sa source dans le parc Fond\u2019Roy. Il s\u2019\u00e9coule ensuite sur 3 kilom\u00e8tres, sur la commune d\u2019Uccle, o\u00f9 il re\u00e7oit les eaux du Groelstbeek, avant de se jeter dans le Zwartebeek, un affluent de la Senne. De tr\u00e8s nombreuses sources alimentent ce ruisseau aux eaux limpides, pour certaines am\u00e9nag\u00e9es. Venez les d\u00e9couvrir avec nous au cours d\u2019une promenade guid\u00e9e de 5 km. Lors de la visite, nous inaugurerons \u00e9galement la version \u2018smartphone\u2019 de la promenade, disponible via l\u2019application \u2018patrimoine\u2019. \r\n\r\nRendez-vous: plaine du Bourdon, au croisement de la chauss\u00e9e de Saint-Job et de la chauss\u00e9e d\u2019Alsemberg \u00e0 Uccle.\r\nRetour: retour en bus jusqu\u2019\u00e0 la plaine du Bourdon au d\u00e9part de l\u2019arr\u00eat De Wansijn (bus 60). NB: possibilit\u00e9 de quitter le groupe \u00e0 cet endroit.\r\n\r\nCo\u00fbt: 3 \u20ac \u00e0 verser sur le compte de Coordination Senne: IBAN BE21 0014 5041 2203\r\nInscription: n\u00e9cessaire via le formulaire d'inscription > https:\/\/docs.google.com\/forms\/d\/e\/1FAIpQLSfPELmcBK1v3z8L1JigusiYm43xfPzOvvoHG-AaZW_qrOhPJA\/viewform","performers":null,"boxoffice_url":null,"website":"http:\/\/www.coordinationsenne.be","email":"contact@coordinationsenne.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/535572.html"},"nl":{"name":"De bronnen van de Geleytsbeek","shortdescr":null,"longdescr":"Voor deze nieuwe activiteit in de reeks \u2018Terug naar de bron\u2019 nodigen we u uit om de vallei van de Geleytsbeek in Ukkel te verkennen. De Geleytsbeek ontspringt in het Vronerodepark. Ze stroomt vervolgens 3 kilometer door de gemeente Ukkel, waar ze het water van de Groelstbeek ontvangt, alvorens uit te monden in de Zwartebeek, een zijrivier van de Zenne. Deze kristalheldere beek wordt gevoed door talrijke bronnen, waarvan er enkele zijn ingericht. Kom ze met ons ontdekken tijdens een gegidste wandeling van 5 km. Tijdens het bezoek zal ook de smartphone-versie van de wandeling worden ingehuldigd, beschikbaar via de applicatie 'erfgoed'. \r\n\r\nVertrek: Horzelplein, aan het kruispunt van de Sint-Jobsesteenweg en de Steenweg op Alsemberg in Ukkel.\r\nAankomst: terug met de bus naar het Horzelplein vanaf halte De Wansijn (bus 60). NB: het is mogelijk de groep op dit punt te verlaten.\r\nPrijs: \u20ac 3 te betalen op de rekening van Co\u00f6rdinatie Zenne: IBAN BE21 0014 5041 2203\r\nInschrijven: is nodig en kan via het inschrijvingsformulier > https:\/\/docs.google.com\/forms\/d\/e\/1FAIpQLSfPELmcBK1v3z8L1JigusiYm43xfPzOvvoHG-AaZW_qrOhPJA\/viewform","performers":null,"boxoffice_url":null,"website":"http:\/\/www.coordinatiezenne.be","email":"contact@coordinationsenne.be","phone_contact":"+32 2 206 12 07","phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/535572.html"},"en":{"name":"De bronnen van de Geleytsbeek","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/535572.html"},"de":{"name":"De bronnen van de Geleytsbeek","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"ph