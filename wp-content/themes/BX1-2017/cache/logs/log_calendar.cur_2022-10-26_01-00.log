ame":"Jongeren"},"en":{"name":"Young people"}},"value":7.5},{"translations":{"fr":{"name":"Enfants"},"nl":{"name":"Kinderen"},"en":{"name":"Children"}},"value":0}],"child_events":[],"parent_events":[],"targets":{"list":[11,10,12,8,7,19,16,5,4],"translations":{"fr":["Famille","Seniors","LGTBQIA","Jeunes 15-18 ans","Jeunes 12-15 ans","Enseignants","Ecoles","Enfants 9-12 ans","Enfants 6-9 ans"],"nl":["Familie","Senioren","LGTBQIA","Jongeren 15-18 j.","Jongeren 12-15 j.","Leerkrachten","Scholen","Kinderen 9-12 j.","Kinderen 6-9 j."],"en":["Family","Seniors","LGTBQIA","Youth 15-18  yr.","Youth 12-15  yr.","Teachers","Schools","Children 9-12 yr.","Children 6-9 yr."]}},"visit_profile":{"list":[323],"translations":{"fr":["Gastronomie"],"nl":["Gastronomie"],"en":["Gastronomy"],"de":["Gastronomie"]}},"tags":["kids"],"is_part_of":"Staycation","accessibilities":{"list":[255,259,263],"translations":{"fr":["Accessible","Chien d'assistance","Accessible aux pi\u00e9tons appareill\u00e9s"],"nl":["Toegankelijk","Assistentiehonden","Toegankelijk voor voetgangers met hulpmiddelen"],"en":["Accessible","Assistance dogs","Accessible to pedestrians with mobility aids"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-10T17:36:03+02:00","published_at":"2022-07-13T10:34:17+02:00","backoffice_id":258345,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.18087189905544},{"id":540191,"date_start":"2022-09-09","date_end":"2023-01-05","date_next":"2023-01-05","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater"}},"others":{"list":[51],"translations":{"fr":["Caf\u00e9 th\u00e9\u00e2tre"],"nl":["Cabaret"],"en":["Cabaret"],"de":["Kabarett"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"AND...CUT ! - Spectacle D'improvisation de Catherine Lembr\u00e9e & Alexandre Valancin \u2702\ufe0f","shortdescr":null,"longdescr":"\" AND...CUT !  \"\r\nQu'est ce qu'il se cache derri\u00e8re nos histoires improvis\u00e9es ?\r\n\r\nPour une soir\u00e9e, laissez vous immerger dans l'univers d'une metteuse en sc\u00e8ne proposant au public et aux com\u00e9diennes de lui faire confiance pour proposer une histoire dans un style qui lui est cher.\r\n\r\nLe ou la metteur.euse en sc\u00e8ne, ainsi que le.la r\u00e9gisseur.euse accompagnera les com\u00e9dien.nes par petite touche, proposant mises en sc\u00e8nes formant une grande histoire de 2*40 min.\r\n\r\nEt le pari suppl\u00e9mentaire : certain.nes com\u00e9dien.nes ne se connaissent pas ou n'ont jamais jou\u00e9 ensemble !\r\n\r\n\r\n\r\nAvec Alexandre Valentin & Catherine Lembr\u00e9e\r\n\r\n-------\r\n\r\nINFOS PRATIQUES\r\n\r\nLieu : Le TRAC\r\nAdresse : 110, rue Albert Meunier- Auderghem\r\n\r\nSpectacle \u00e0 20h15\r\nIl est possible de manger et\/ou boire un verre sur place avant le spectacle, pensez donc \u00e0 venir plus t\u00f4t! (Derni\u00e8re commande de restauration \u00e0 19h55!)\r\n\r\nR\u00c9SERVATIONS (vivement conseill\u00e9es)\r\nvia le lien du Trac : https:\/\/www.letrac.be\/reservations\r\n\r\nTARIFS\r\n- Sur r\u00e9servation : 10\u20ac\/\u00e9tudiant & 13\u20ac\/adulte\r\n- Sur place : 15\u20ac\/personne","performers":"Alexandre Valancin, Catherin Lembr\u00e9e et des invit\u00e9.e.s MAGIQUES !","boxoffice_url":null,"website":"http:\/\/www.letrac.be\/reservation","email":"info@letrac.be","phone_contact":"+32 470 50 04 75","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.540191"},"nl":{"name":"AND...CUT ! - Spectacle D'improvisation de Catherine Lembr\u00e9e & Alexandre Valancin \u2702\ufe0f","shortdescr":null,"longdescr":null,"performers":null,"boxof