art centers"],"it":["Fotografia","Musei e centri artistici"],"cn":[null,null],"fr":["Photographie","Mus\u00e9es et art centers"],"sp":["Fotograf\u00eda","Museos y centros de arte"],"nl":["Fotografie","Musea en kunstcentra"]}}},"translations":{"de":{"name":"Matou et les chiens","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700006088"},"pt":{"name":"Matou et les chiens","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700006088"},"en":{"name":"Matou et les chiens","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700006088"},"it":{"name":"Matou et les chiens","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700006088"},"cn":{"name":"Matou et les chiens","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700006088"},"fr":{"name":"Matou et les chiens","shortdescr":null,"longdescr":"Premi\u00e8re \u00e9tape du projet participatif Verso-Recto, fruit d\u2019une collaboration \u00e9troite entre le mus\u00e9e et le photographe Vincen Beeckman, l\u2019exposition met en lumi\u00e8re des fragments de vie issus du parc de Woluwe, \u00e0 travers des instantan\u00e9s du quotidien et des cr\u00e9ations originales.\nCette \u00ab balise \u00bb inaugurale r\u00e9unit les archives photographiques de Marc, surnomm\u00e9 \u00ab Matou \u00bb, figure embl\u00e9matique du Wolu Sports Park, et propose une exploration artistique autour des chiens crois\u00e9s dans le parc.\nCe volet associe les photographies in\u00e9dites de Vincen, les oeuvres de Zo\u00e9 Peray et Roxanne Daguet, d\u2019Anna Marguier et Sarah Juin \u2013 \u00e9tudiantes de la section \u00ab Design du livre et du papier \u00bb de l\u2019ENSAV La Cambre \u2013, ainsi que les cr\u00e9ations de Dominique Jacqmain, artiste b\u00e9d\u00e9iste.\nCe dialogue entre pass\u00e9 et pr\u00e9sent, humains et animaux, t\u00e9moigne de la diversit\u00e9 et de la richesse des rencontres qui animent ce projet depuis ses d\u00e9buts.","performers":"Vincen Beeckman, 'Matou', Zo\u00e9 Peray, Roxanne Daguet, Anna Marguier, Sarah Juin, Dominique Jacqmain","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700006088"},"sp":{"name":"Matou et les chiens","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700006088"},"nl":{"name":"Matou et les chiens","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700006088"}},"place":{"id":142,"translations":{"de":{"name":"Wittockiana: Msueum f\u00fcr Buch- und Buchbindekunst","address_street_name":"Rue du Bemel","address_street_number":"23","address_street_box":null,"email":"info@wittockiana.org","website":"http:\/\/www.wittockiana.org","phone_contact":"+32 2 770 53 33","phone_booking":null,"address_zip":"1150","address_city":"Woluwe-Saint-Pierre","address_line1":"Rue du Bemel, 23","addres