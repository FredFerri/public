ticle27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre"}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Moli\u00e8re ou presque","shortdescr":"Pi\u00e8ce de th\u00e9\u00e2tre inspir\u00e9e de l\u2019\u0153uvre de Moli\u00e8re, jou\u00e9e par les participants de l\u2019atelier th\u00e9\u00e2tre seniors d\u2019Ixelles. L\u2019atelier est organis\u00e9 par INTI Th\u00e9\u00e2tre.","longdescr":"Moli\u00e8re ou presque, c\u2019est travailler un auteur classique et voil\u00e0 bien une aire de jeu encore jamais explor\u00e9e par l\u2019atelier s\u00e9nior. \r\nMoli\u00e8re ou presque, c\u2019est une aventure qui d\u00e9bute en 2019, s\u2019interrompt longtemps pour cause COVID pour mieux renaitre durant l\u2019ann\u00e9e comm\u00e9morative de la naissance de Jean Baptiste Poquelin. \r\nMoli\u00e8re ou presque, c\u2019est prendre l\u2019essence de l\u2019auteur, en faire un condens\u00e9, un best of. \r\nMoli\u00e8re ou presque, c\u2019est, dans l\u2019id\u00e9e d\u2019une d\u00e9marche documentaire, partager les liens intimes qui ont pu ou n\u2019ont pas pu se tisser avec les pi\u00e8ces de ce r\u00e9pertoire. \r\nMoli\u00e8re ou presque m\u00eale donc le classique au contemporain, la versification au langage ordinaire, le verbe et l\u2019image \u00e0 la musique de Lully. \r\nMoli\u00e8re ou presque, c\u2019est l\u2019enthousiasme th\u00e9\u00e2trale des seniors qui rajeunit la vitalit\u00e9 d\u2019un auteur jeune de 400 ans. \r\n\r\nLa pi\u00e8ce est le r\u00e9sultat de l\u2019atelier th\u00e9\u00e2tre seniors d\u2019Ixelles, men\u00e9 par INTI Th\u00e9\u00e2tre.","performers":"Participants de l'atelier th\u00e9\u00e2tre senior d'Ixelles, accompagn\u00e9 par INTI Th\u00e9\u00e2tre","boxoffice_url":null,"website":"https:\/\/culture.ixelles.be\/","email":"culture@ixelles.brussels","phone_contact":null,"phone_booking":"+32 2 515 64 63","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/534029.html"},"nl":{"name":"Moli\u00e8re ou presque","shortdescr":"Dit toneelstuk is ge\u00efnspireerd op het werk van Moli\u00e8re en wordt opgevoerd door de deelnemers van de toneelworkshop voor senioren in Elsene. De workshop wordt georganiseerd door INTI Th\u00e9\u00e2tre.","longdescr":"Dit toneelstuk is ge\u00efnspireerd op het werk van Moli\u00e8re en wordt opgevoerd door de deelnemers van de toneelworkshop voor senioren in Elsene. De workshop wordt georganiseerd door INTI Th\u00e9\u00e2tre.","performers":"Deelnemers van de toneelworkshop voor senioren van Elsene, begeleid door INTI Th\u00e9\u00e2tre","boxoffice_url":null,"website":"https:\/\/cultuur.elsene.be\/nl\/","email":"cultuur@elsene.brussels","phone_contact":null,"phone_booking":"+32 2 515 64 63","agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/534029.html"},"en":{"name":"Moli\u00e8re ou presque","shortdescr":"A play inspired by Moli\u00e8re's work, performed by the participants of the Ixelles senior theatre workshop. The workshop is organised by INTI Th\u00e9\u00e2tre.","longdescr":"A play inspired by Moli\u00e8re's work, performed by the participants of the Ixelles senior theatre workshop. The workshop is organised by INTI Th\u00e9\u00e2tre.","performers":"Participants of the Ixelles senior theatre workshop, accompanied by INTI Th\u00e9\u00e2tre","boxoffice_url":null,"website":"https:\/\/culture.ixelles.be\/en\/","email":"culture@ixelles.brussels","phone_contact":null,"phone_booking":"+32 2 515 64 63","agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/534029.html"},"de":{"name":"Moli\u00e8re ou presque","shortdescr":null,"longdescr":null