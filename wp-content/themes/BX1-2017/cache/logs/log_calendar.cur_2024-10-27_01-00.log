on_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"MoMuse - Mus\u00e9e communal de Molenbeek Saint-Jean","address_street_name":"rue Mommaerts ","address_street_number":"2A  ","address_street_box":null,"email":"momuse@molenbeek.irisnet.be","website":"http:\/\/www.momuse.be","phone_contact":"+32 2 412 08 12","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue Mommaerts , 2A  ","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"Une commune, c\u2019est avant tout une histoire. Et celle de Molenbeek est loin d\u2019\u00eatre anodine. Le MoMuse est une vitrine du patrimoine historique de la commune, depuis ses origines jusqu\u2019\u00e0 aujourd\u2019hui, avec un accent tout particulier mis sur les XIXe et XXe si\u00e8cles. Le mus\u00e9e permettra aux visiteurs de comprendre l\u2019\u00e9volution de ce petit territoire de quelques 6km2, ayant d\u2019abord connu un d\u00e9veloppement rural durant de nombreux si\u00e8cles, puis une industrialisation intense \u00e0 partir des ann\u00e9es 1840, suivie d\u2019une d\u00e9sindustrialisation non sans cons\u00e9quences, et enfin, \u00e0 l\u2019aube des ann\u00e9es 1960, une croissance urbanistique intense. Autant d\u2019\u00e9v\u00e9nements qui ont profond\u00e9ment modifi\u00e9 les modes de vie et l\u2019essence m\u00eame de la commune.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"MoMuse - Mus\u00e9e communal de Molenbeek Saint-Jean","address_street_name":"rue Mommaerts ","address_street_number":"2A  ","address_street_box":null,"email":"momuse@molenbeek.irisnet.be","website":"http:\/\/www.momuse.be","phone_contact":"+32 2 412 08 12","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue Mommaerts , 2A  ","address_line2":"1080 Molenbeek-Saint-Jean","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"MoMuse - Gemeentelijk Museum van Sint-Jans Molenbeek","address_street_name":"Mommaertsstraat ","address_street_number":"2A  ","address_street_box":null,"email":"momuse@molenbeek.irisnet.be","website":"http:\/\/www.momuse.be","phone_contact":"+32 2 412 08 12","phone_booking":null,"address_zip":"1080","address_city":"Sint-Jans-Molenbeek","address_line1":"Mommaertsstraat , 2A  ","address_line2":"1080 Sint-Jans-Molenbeek","description_web":"De geschiedenis van de gemeente Sint-Jans-Molenbeek is verre van triviaal. Het MoMuse exposeert het historische erfgoed van de gemeente, vanaf zijn ontstaan tot nu, met speciale nadruk op de negentiende en twintigste eeuw. De bezoekers zullen de evolutie doorlopen van dit kleine grondgebied van ongeveer 6 km2, die begint met een eeuwenlange plattelandsontwikkeling, dan een intense industrialisatie vanaf de jaren 1840, gevolgd door een afbouw van de industrialisatie die niet zonder gevolgen is gebleven, en tenslotte, aan het begin van de jaren zestig, een intense stedelijke groei. Al deze gebeurtenissen hebben de levenswijze en de essentie zelve van de gemeente grondig veranderd.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":30182,"location":{"lat":50.85738825,"lon":4.33784505},"last_updated_at":"2023-10-25T09:28:08+02:00","published_at":"2017-10-16T15:14:36+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/38eceb49a01577a4b27aa54313f58621e8db0c52.png","width":2481,"height":1890,"ratio":1.31,"oEmbed_height":1890,"oEmbed_width":2481,"translations":{"de":{"title":"MoMuse - Mus\u00e9e Communal de Molenbeek Saint-Jean","copyright":null},"pt":{"title":"MoMuse - Mus\u00e9e Communal d