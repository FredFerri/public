s\/en\/visitors\/agenda\/event-detail.5700000261"},"it":{"name":"Mari\u00e9s sur le tarmac","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/fourire.be\/","email":"reservations@fourire.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700000261"},"cn":{"name":"Mari\u00e9s sur le tarmac","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/fourire.be\/","email":"reservations@fourire.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700000261"},"fr":{"name":"Mari\u00e9s sur le tarmac","shortdescr":"Fr\u00e9d\u00e9ric et Marie ne se connaissent pas, ils se rencontrent dans l\u2019\u00e9mission \"Mari\u00e9s sur le tarmac\". Des tests scientifiques les reconnaissent compatibles \u00e0 85%.\n\nIls doivent se marier sur le tarmac d'un a\u00e9roport pour ensuite partir en voyage de noces. Fr\u00e9d\u00e9ric refuse cependant de prendre l'avion \u00e0 cause d\u2019une empreinte carbone bien trop \u00e9lev\u00e9e, mais notre homme a une solution...\n\n\n","longdescr":"Fr\u00e9d\u00e9ric et Marie ne se connaissent pas, ils se rencontrent dans l\u2019\u00e9mission \"Mari\u00e9s sur le tarmac\". Des tests scientifiques les reconnaissent compatibles \u00e0 85%.\nIls doivent se marier sur le tarmac d'un a\u00e9roport pour ensuite partir en voyage de noces. Fr\u00e9d\u00e9ric refuse cependant de prendre l'avion \u00e0 cause d\u2019une empreinte carbone bien trop \u00e9lev\u00e9e, mais notre homme a une solution : ils voyageront en p\u00e9niche. Le soir de la nuit de noces, un \u00e9v\u00e9nement inattendu va bouleverser Fr\u00e9d\u00e9ric et sa perception de la vie : il va rencontrer GunterPauli, le p\u00e8re de \"l\u2019\u00e9conomie bleue\". Il s\u2019en suivra une crise entre Fr\u00e9d\u00e9ric qui change subitement de comportement et Marie, compl\u00e8tement perdue face \u00e0 la nouvelle mission de vie de son mari.\n\nDeux semaines plus tard, l\u2019\u00e9mission doit faire le point sur l'exp\u00e9rience amoureuse de chacun des deux \u00e9poux.Sont-ils r\u00e9ellement compatibles ?\n\n\n","performers":"J\u00e9rome Hauptman\nAnthony Figueiredo","boxoffice_url":null,"website":"https:\/\/fourire.be\/","email":"reservations@fourire.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700000261"},"sp":{"name":"Mari\u00e9s sur le tarmac","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/fourire.be\/","email":"reservations@fourire.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700000261"},"nl":{"name":"Mari\u00e9s sur le tarmac","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/fourire.be\/","email":"reservations@fourire.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700000261"}},"place":{"id":249081,"translations":{"de":{"name":"Fou Rire","address_street_name":"Avenue des Grenadiers","address_street_number":"48","address_street_box":null,"email":"info@fourire.be","website":"http:\/\/www.fourire.be","phone_contact":"+32 483 59 92 29","phone_booking":"+32 70 66 06 01","address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue des Grenadiers, 48","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Fou Rire","address_street_name":"Avenue des Grenadiers","address_street_number":"48","address_street_box":null,"email":"info@fourire.be","website":"http:\/\/www.fourire.be","phone_contact":"+32 483 59 92 29","phone_booking":"+32 70 66 06 01","address_zip":"1050","address_city":"Ixelles","address_l