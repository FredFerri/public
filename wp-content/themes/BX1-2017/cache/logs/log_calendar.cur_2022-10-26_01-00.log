,"end":"18:00:00"},{"day":"2022-11-13","doors":null,"start":"13:00:00","end":"18:00:00"},{"day":"2022-11-17","doors":null,"start":"13:00:00","end":"18:00:00"},{"day":"2022-11-18","doors":null,"start":"13:00:00","end":"18:00:00"},{"day":"2022-11-19","doors":null,"start":"13:00:00","end":"18:00:00"},{"day":"2022-11-20","doors":null,"start":"13:00:00","end":"18:00:00"},{"day":"2022-11-24","doors":null,"start":"13:00:00","end":"18:00:00"},{"day":"2022-11-25","doors":null,"start":"13:00:00","end":"18:00:00"},{"day":"2022-11-26","doors":null,"start":"13:00:00","end":"18:00:00"},{"day":"2022-11-27","doors":null,"start":"13:00:00","end":"18:00:00"},{"day":"2022-12-01","doors":null,"start":"13:00:00","end":"18:00:00"},{"day":"2022-12-02","doors":null,"start":"13:00:00","end":"18:00:00"},{"day":"2022-12-03","doors":null,"start":"13:00:00","end":"18:00:00"},{"day":"2022-12-04","doors":null,"start":"13:00:00","end":"18:00:00"}],"weekschema":[{"days":{"monday":{"is_open":false},"tuesday":{"is_open":false},"wednesday":{"is_open":false},"thursday":{"is_open":true,"hours":[{"start":"13:00:00","end":"18:00:00"}]},"friday":{"is_open":true,"hours":[{"start":"13:00:00","end":"18:00:00"}]},"saturday":{"is_open":true,"hours":[{"start":"13:00:00","end":"18:00:00"}]},"sunday":{"is_open":true,"hours":[{"start":"13:00:00","end":"18:00:00"}]}},"translations":{"fr":["lundi, mardi et mercredi: ferm\u00e9","jeudi, vendredi, samedi et dimanche: de 13:00 \u00e0 18:00"],"nl":["maandag, dinsdag en woensdag: gesloten","donderdag, vrijdag, zaterdag en zondag: van 13:00 tot 18:00"],"en":["monday, tuesday and wednesday: closed","thursday, friday, saturday and sunday: from 13:00 to 18:00"]},"date_start":"2022-09-08","date_end":"2022-12-04","is_also_by_appointment":false}],"date_exceptions":[{"day":"2022-09-08","start":"11:00:00","end":"19:00:00"},{"day":"2022-09-09","start":"10:00:00","end":"19:00:00"},{"day":"2022-09-10","start":"11:00:00","end":"19:00:00"},{"day":"2022-09-11","start":"11:00:00","end":"19:00:00"},{"day":"2022-09-17","start":"10:00:00","end":"18:00:00"},{"day":"2022-09-18","start":"10:00:00","end":"18:00:00"},{"day":"2022-10-22","start":"13:00:00","end":"23:59:00"}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"opening":{"day":"2022-09-07","start":"16:00:00","timestamp":"2022-09-07T16:00:00+02:00","end":"21:00:00","is_only_by_appointment":false},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-24T01:35:56+02:00","published_at":"2022-07-12T13:14:37+02:00","backoffice_id":258271,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.28325816747135},{"id":540955,"date_start":"2022-09-08","date_end":"2022-10-30","date_next":"2022-10-27","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung"}},"others":{"list":[24,26],"translations":{"fr":["Galeries d'art","Sculpture"],"nl":["Galeries","Beeldhouwkunst"],"en":["Art Galleries","Sculpture"],"de":["Kunstgalerien","Skulptur"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Philippe Denis - \u00ab Sculptures 1960 - 1970\u00a0\u00bb","shortdescr":"La Schiller Art Gallery en collaboration avec la famille de l'artiste pr\u00e9sentera pour la premi\u00e8re fois \u00e0 Bruxelles une r\u00e9trospective des sculptures de l'artiste Philippe Denis (1912-1978).","longdescr":"Schiller Art Gallery d\u00e9fend et valorise l'art belge du XX si\u00e8cle en pr\u00e9sentant au public, aux marchands et collectionneurs des oeuvres de qualit\u00e9.\r\n\r\nLa Schiller Art Gallery en collaboration avec la famille de l'artiste pr\u00e9sentera pour la premi\u00e8re fois \u00e0 Bruxelles une r\u00e9trospective des sculptures de l'artiste Philippe Denis (1912-1978). Cette exposition riche d'une vingtaine d'oeuvres et de dessins datant des ann\u00e9es 60\/70 valorisera le travail exceptionnel de cet artiste de l'apr\u00e8s-guerre. Pour l'occasion, un catalogue sera publi\u00e9 retra\u00e7ant le parcours de Philippe Denis.","performers":"Philippe Denis","boxoffice_url":null,"website":"http:\/\/www.facebook.com\/schiller.gallery\/","email":"gregverdonck@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.540955"},"nl":{"name":"Philippe Denis - \u00ab Sculptures 1960 - 1970\u00a0\u00bb","shortdescr":"Voor de 1ste maal wordt er in Brussel een uitzonderlijke retrospectieve gehouden van de werken van Philippe Denis. Deze tentoonstelling komt tot stand dankzij de mederwerking van de familie met Schiller Art Gallery.","longdescr":"Schiller Art Gallery laat sinds meer dan 10 jaar het grote publiek kennismaken met moderne Belgische kunst uit de jaren 20 tot en met 70.\r\n\r\nVoor de 1ste maal wordt er in Brussel een uitzonderlijke retrospectieve gehouden van de werken van Philippe Denis. Deze tentoonstelling komt tot stand dankzij de mederwerking van de familie met Schiller Art Gallery.\r\n\r\nDeze uitdagende tentoonstelling neemt bezoekers mee in de wereld van deze Belgische beeldhouwer. Zo kan men zijn werken herbewonderen of ontdekken. De meeste ervan werden gemaakt tussen 1960 \u2013 1970 periode waarin Philippe Denis van stijl veranderde in een meer moderne \/ abstracte wijze tot uitting kwam. Er zullen dan ook verschillende tekeningen en beelden aanwezig zijn.\r\n\r\nPhilippe Denis stond open voor voortdurende vernieuwing en voor experimenten met uiteenlopend materiaal. Door zijn eerdere ondervindingen bewerkte hij zijn beelden met passie en werden ze zowel in koper, messing, staal of ijzer gekenmerkt door de mooie lijnen om deze door te geven aan zijn publiek. Philippe Denis schaafde uren aan zijn gipsen modellen, totdat hij de meest elegante vorm bereikte. Men mag het beschouwer als een \u00ab oeuvre \u00bb naar vrijheid en spontaniteiten.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.540955"},"en":{"name":"Philippe Denis - \u00ab Sculptures 1960 - 1970\u00a0\u00bb","shortdescr":"Schiller Art Gallery in collaboration with the artist's estate will present for the first time in Brussels  a retrospective of the sculptures of the sculptor Philippe Denis (1912-1978).","longdescr":"Schiller Art Gallery promotes 20th century Belgian art by presenting quality works to the public, dealers and collectors.\r\n\r\nSchiller Art Gallery in collaboration with the artist's estate will present for the first time in Brussels, a retrospective of the sculptures of the sculptor Philippe Denis (1912-1978). This exhibition of around twenty works and drawings dating from the 60s and 70s will highlight the exceptional work of this post-war artist. For the occasion, a catalog will be published.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.540955"},"de":{"name":"Philippe Denis - \u00ab Sculptures 1960 - 1970\u00a0\u00bb","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.540955"},"it":{"name":"Philippe Denis - \u00ab Sculptures 1960 - 1970\u00a0\u00bb","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.540955"},