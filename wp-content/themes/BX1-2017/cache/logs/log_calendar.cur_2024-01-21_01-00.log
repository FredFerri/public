ebsite":"http:\/\/www.cafe-roskam.be","email":"roskambrussels@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50006091"},"en":{"name":"Macondo Trio","shortdescr":null,"longdescr":"MACONDO takes the audience to a place where time is relative, where cycles intertwine and melodies remain anchored in bodies and minds. Musicians come together to share, dialogue and connect. The fusion of energies is transmitted through captivating grooves, repetitive motifs and boundless improvisations. History repeats itself, and is never the same. And things take on their full meaning when the listener, open-minded and attentive, lets himself be carried away by the surging wave of music.\n\n\n","performers":null,"boxoffice_url":null,"website":"http:\/\/www.cafe-roskam.be","email":"roskambrussels@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50006091"},"it":{"name":"Macondo Trio","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.cafe-roskam.be","email":"roskambrussels@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50006091"},"cn":{"name":"Macondo Trio","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.cafe-roskam.be","email":"roskambrussels@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50006091"},"fr":{"name":"Macondo Trio","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.cafe-roskam.be","email":"roskambrussels@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50006091"},"sp":{"name":"Macondo Trio","shortdescr":null,"longdescr":null,"performers":nul