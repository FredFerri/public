,"Anziani","Scuole"],"sp":["Ni\u00f1os de 6 a 9 a\u00f1os","Ni\u00f1os de 9 a 12 a\u00f1os","Familias","J\u00f3venes de 12 a 15 a\u00f1os","J\u00f3venes de 15 a 18 a\u00f1os","Personas de la tercera edad","Escuelas"],"pt":[null,null,null,null,null,null,null],"cn":[null,null,null,null,null,null,null]}},"tags":["kids"],"accessibilities":{"list":[255,261],"translations":{"fr":["Accessible","Parking accessible"],"nl":["Toegankelijk","Toegankelijke parking"],"en":["Accessible","Accessible parking"],"de":["Barrierefrei","Barrierefreier Parkplatz"],"it":["Accessibile","Parcheggio accessibile"],"sp":["Habilitado","Estacionamiento habilitado"],"pt":[null,null],"cn":[null,null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2023-03-07T14:35:10+01:00","published_at":"2023-02-17T09:10:53+01:00","backoffice_id":271893,"import_origin":null,"sub_type":"concert","show_in_agenda":true,"ranking":1.2599210498949},{"id":552818,"date_start":"2023-03-09","date_end":"2023-03-09","date_next":"2023-03-09","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":true,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung","it":"Esposizioni","sp":"Exhibici\u00f3n","pt":null,"cn":null}},"others":{"list":[24,32],"translations":{"fr":["Galeries d'art","Design"],"nl":["Galeries","Design"],"en":["Art Galleries","Design"],"de":["Kunstgalerien","Design"],"it":["Gallerie d'arte","Design"],"sp":["Galer\u00edas de arte","Dise\u00f1o"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Table ronde \"Futuro gentile\", avec Michele De Lucchi. Italian Design Day 2023","shortdescr":"L'Ambassade d'Italie, l'Institut Culturel Italien de Bruxelles, l'Italian Trade Agency et le CID grand Hornu s'associent pour organiser une table ronde autour de la vision du futur de Michele De Lucchi","longdescr":"L'Ambassade d'Italie, l'Institut Culturel Italien de Bruxelles, l'Italian Trade Agency et le CID grand Hornu s'associent pour organiser une table ronde autour de la vision du futur de Michele De Lucchi. Celle-ci se veut optimiste et bienveillante la co-cr\u00e9ation, la transversalit\u00e9, la complicit\u00e9 entre artisanat et technologies de pointe, entre la nature et les hommes, entre les intelligences humaine et artificielle rendent notre Terre habitable et notre futur d\u00e9sirable. Michele De Lucchi a voulu s\u2019entourer de sp\u00e9cialistes de disciplines les plus diverses pour discuter, apprendre, s\u2019enrichir mutuellement des exp\u00e9riences d\u2019un chef cuisinier, un physicien et une sp\u00e9cialiste en sant\u00e9 publique. \r\nL'\u00e9v\u00e9nement s'inscrit dans le cadre des expositions Futuro Gentile du CID et Fare Luce.\r\n\r\nAvec Michele De Lucchi, designer et artiste\r\nSang Hoon Degeimbre, chef et fondateur du restaurant L\u2019Air du Temps\r\nAndrea Campoleoni, chercheur en physique \u00e0 l'Unimversit\u00e8 de Mons\r\nFanny Brunin, chercheuse en sant\u00e9 publique\r\nMod\u00e9r\u00e9 par Marie Pok, directrice du CID-centre d\u2019innovation au Grand-Hornu\r\n\r\nLa table ronde aura lieu en fran\u00e7ais.\r\nR\u00e9s\u00e9rvation obligatoire >>>\r\n\r\nArchitecte, designer et artiste, Michele De Lucchi (1951) a \u00e9t\u00e9 l'un des protagonistes d'Alchimia et de Memphis et responsable d'Olivetti Design (1988-2002). Il a con\u00e7u la lampe la plus vendue au monde, la Tolomeo, \u00e9dit\u00e9e par Artemide, remportant le prix Compasso d'Oro en 1987. Il a cr\u00e9\u00e9 des meubles pour les entreprises italiennes et europ\u00e9ennes les plus connues et r\u00e9alis\u00e9 des projets architecturaux dans le monde entier, notamment des bureaux, des b\u00e2timents culturels, industriels et r\u00e9sidentiels. Parall\u00e8lement, il maintient une pratique artisanale \u00e0 travers son atelier exp\u00e9rimental, Produzione Privata. Depuis 2004, il sculpte des maquettes en bois, recherchant l'essentialit\u00e9 de la forme architecturale, une source d'inspiration pour ses projets professionnels.\r\n\r\nD\u2019origine cor\u00e9enne, les pieds ancr\u00e9s dans le terroir belge mais citoyen du monde, Sang Hoon Degeimbre est le fondateur et chef du restaurant doublement \u00e9toil\u00e9 L\u2019Air du Temps. Petit, il voulait \u00eatre pharmacien. Apr\u00e8s \u00eatre pass\u00e9 par la boucherie-charcuterie, son attirance pour la nourriture lui fait choisir la voie de la restauration, avant d'aborder la cuisine par le m\u00e9tier de sommelier qu'il exercera plusieurs ann\u00e9es avant d'ouvrir L'Air du temps en 1997. Le Guide Michelin lui d\u00e9cerne une premi\u00e8re \u00e9toile en 2000 et une seconde en 2008. En 2013, on lui d\u00e9cerne le titre d\u2019Officier du M\u00e9rite Wallon. Cette m\u00eame ann\u00e9e, Sang Hoon parfait son r\u00eave en installant L\u2019Air du Temps dans une ferme entour\u00e9e de cinq hectares de jardin potager. Avec l\u2019aide de son meilleur ami et jardinier en chef Benoit, ils cultivent leurs l\u00e9gumes, leurs plantes et leurs herbes aromatiques. Sang Hoon questionne une cuisine qui se veut respectueuse de l\u2019humain et de la terre. Depuis 2015, il lance le concept de restaurants SAN : deux \u00e9tablissements \u00e0 Bruxelles et un \u00e0 Gand voient le jour et proposent une cuisine urbaine cr\u00e9ative et de saison.\r\n\r\nAncien \u00e9l\u00e8ve de la Scuola Normale Superiore de Pise, Andrea Campoleoni a obtenu son doctorat en physique en 2009. Il a ensuite \u00e9t\u00e9 chercheur postdoctoral \u00e0 l'Institut Max Planck pour la Physique Gravitationnelle de Potsdam (Allemagne), \u00e0 l'Universit\u00e9 Libre de Bruxelles et \u00e0 l'ETH Zurich (Suisse). Depuis 2018, il est chercheur qualifi\u00e9 du FNRS rattach\u00e9 \u00e0 l'Universit\u00e9 de Mons. Ses recherches explorent diverses facettes de la th\u00e9orie de la gravitation d'Einstein, depuis ses relations avec la m\u00e9canique quantique jusqu'au r\u00e9cent d\u00e9veloppement de l'astronomie des ondes gravitationnelles.\r\n\r\nFanny Brunin a termin\u00e9 son master en sciences de la sant\u00e9 publique \u00e0 l\u2019ESP (\u00e9cole de sant\u00e9 publique) de l\u2019ULB en septembre 2020. Elle travaille actuellement comme technologue de laboratoire, assistante de cours et chercheuse au centre de recherche en sant\u00e9 environnementale et sant\u00e9 au travail de l\u2019ULB. Elle est laur\u00e9ate du HERA Award Sustainable Health 2021.\r\n\r\nJournaliste ind\u00e9pendante depuis 1998, Marie Pok a collabor\u00e9 \u00e0 diff\u00e9rents magazines sp\u00e9cialis\u00e9s en art, design et architecture et est r\u00e9dactrice en chef de la Libre essentielle IMMO depuis 2010. Elle a contribu\u00e9 \u00e0 de nombreux catalogues et ouvrages collectifs et publi\u00e9 plusieurs monographies d\u2019architectes belges. En 2006, elle a co-fond\u00e9 le festival Design September dont elle a assur\u00e9 la direction artistique jusqu\u2019en 2011. Depuis 2012, elle est directrice du CID-centre d\u2019innovation au Grand-Hornu. En 2020, elle est nomm\u00e9e membre du Conseil de Fondation Plateforme 10 \u00e0 Lausanne.","performers":"Avec Michele De Lucchi, designer et artiste\r\nSang Hoon Degeimbre, chef et fondateur du restaurant L\u2019Air du Temps\r\nAndrea Campoleoni, chercheur en physique \u00e0 l'Unimversit\u00e8 de Mons\r\nFanny Brunin, chercheuse en sant\u00e9 publique\r\nMod\u00e9r\u00e9 par Marie Pok, directrice du CID-centre d\u2019innovation au Grand-Hornu","boxoffice_url":null,"website":"http:\/\/www.iicbruxelles.esteri.it","email":"iicbruxelles@esteri.it","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.552818"},"nl":{"name":"Table ronde \"Futuro gentile\", avec Michele De Lucchi. Italian Design Day 2023","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.iicbruxelles.esteri.it","email":"iicbruxelles@esteri.it","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.552818"},"en":{"name":"\u201cFuturo gentile\" round table, with Michele De Lucchi. Italian Design Day 2023","shortdescr":"The Italian Embassy, the Italian Cultural Institute of Brussels, the Italian Trade Agency and the CID Grand Hornu are joining forces to organise a round table on Michele De Lucchi's vision of the future","longdescr":"The Italian Embassy, the Italian Cultural Institute of Brussels, the Italian Trade Agency and the CID Grand Hornu are joining forces to organise a round table on Michele De Lucchi's vision of the future. This vision is optimistic and benevolent: co-creation, transversality, complicity between crafts and advanced technologies, between nature and man, between human and artificial intelligence, all of which make our Earth habitable and our future desirable. Michele De Lucchi wanted to surround himself with specialists from the most diverse disciplines in order to discuss, learn and mutually enrich the experiences of a chef, a physicist and a public health specialist. \r\nThe event is part of the CID's Futuro Gentile and Fare Luce exhibitions.\r\n\r\nWith Michele De Lucchi, designer and artist\r\nSang Hoon Degeimbre, chef and founder of the restaurant L'Air du Temps\r\nAndrea Campoleoni, researcher in physics at the University of Mons\r\nFanny Brunin, public health researcher\r\nModerated by Marie Pok, director of the CID innovation centre in Grand-Hornu\r\n\r\nThe round table will be held in French.\r\n\r\nArchitect, designer and artist, Michele De Lucchi (1951) was one of the protagonists of Alchimia and Memphis and head of Olivetti Design (1988-2002). He designed the best-selling lamp in the world, the Tolomeo, published by Artemide, winning the Compasso d'Oro prize in 1987. He has designed furniture for the most famous Italian and European companies and has carried out architectural projects all over the world, including offices, cultural, industrial and residential buildings. At the same time, he maintains a craft practice through his experimental workshop, Produzione Privata. Since 2004, he has been sculpting wooden models, seeking the essentiality of architectural form, a source of inspiration for his professional projects.\r\n\r\nOf Korean origin, with his roots in Belgium but a citizen of the world, Sang Hoon Degeimbre is the founder and chef of the two-starred restaurant L'Air du Temps. As a child, he wanted to be a pharmacist. After working in a butcher's shop, his attraction for food led him to choose the path of the restaurant business, before taking up the profession of sommelier, which he practised for several years before opening L'Air du Temps in 1997. The Michelin Guide awarded him a first star in 2000 and a second in 2008. In 2013, he was awarded the title of Officier du M\u00e9rite Wallon. That same year, Sang Hoon made his dream come true by setting up L'Air du Temps on a farm surrounded by five hectares of vegetable garden. With the help of his best friend and head gardener Benoit, they cultivate their vegetables, plants and aromatic herbs. Sang Hoon questions a cuisine that wants to be respectful of humans and the earth. Since 2015, he has launched the SAN restaurant concept: two establishments in Brussels and one in Ghent have been opened, offering creative, seasonal urban cuisine.\r\n\r\nAn alumnus of the Scuola Normale Superiore in Pisa, Andrea Campoleoni obtained his PhD in physics in 2009. He was then a postdoctoral researcher at the Max Planck Institute for Gravitational Physics in Potsdam (Germany), the Universit\u00e9 Libre de Bruxelles and ETH Zurich (Switzerland). Since 2018, he is an FNRS qualified researcher attached to the University of Mons. His research explores various facets of Einstein's theory of gravitation, from its relationship with quantum mechanics to the recent development of gravitational wave astronomy.\r\n\r\nFanny Brunin completed her master's degree in public health sciences at the ESP (School of Public Health) of the ULB in September 2020. She is currently working as a laboratory technologist, lecturer and researcher at the ULB Research Centre for Environmental and Occupational Health. She is a laureate of the HERA Award Sustainable Health 2021.\r\n\r\nA freelance journalist since 1998, Marie Pok has contributed to various magazines specialising in art, design and architecture and has been editor-in-chief of the Libre essentielle IMMO since 2010. She has contributed to numerous catalogues and collective works and published several monographs on Belgian architects. In 2006, she co-founded the Design September festival and was its artistic director until 2011. Since 2012, she has been the director of the CID Innovation Centre in Grand-Hornu. In 2020, she was appointed member of the Board of the Plateforme 10 Foundation in Lausanne.","performers":"With Michele De Lucchi, designer and artist\r\nSang Hoon Degeimbre, chef and founder of the restaurant L'Air du Temps\r\nAndrea Campoleoni, researcher in physics at the University of Mons\r\nFanny Brunin, public health researcher\r\nModerated by Marie Pok, director of the CID innovation centre in Grand-Hornu","boxoffice_url":null,"website":"http:\/\/www.iicbruxelles.esteri.it","email":"iicbruxelles@esteri.it","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.552818"},"de":{"name":"Table ronde \"Futuro gentile\", avec Michele De Lucchi. Italian Design Day 2023","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.iicbruxelles.esteri.it","email":"iicbruxelles@esteri.it","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.552818"},"it":{"name":"Table ronde \"Futuro gentile\", avec Michele De Lucchi. Italian Design Day 2023","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.iicbruxelles.esteri.it","email":"iicbruxelles@esteri.it","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.552818"},"sp":{"name":"Table ronde \"Futuro gentile\", avec Michele De Lucchi. Italian Design Day 2023","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.iicbruxelles.esteri.it","email":"iicbruxelles@esteri.it","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.552818"},"pt":{"name":"Table ronde \"Futuro gentile\", avec Michele De Lucchi. Italian Design Day 2023","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.iicbruxelles.esteri.it","email":"iicbruxelles@esteri.it","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.552818"},"cn":{"name":"Table ronde \"Futuro gentile\", avec Michele De Lucchi. Italian Design Day 2023","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.iicbruxelles.esteri.it","email":"iicbruxelles@esteri.it","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.552818"}},"place":{"id":99,"translations":{"fr":{"name":"Istituto Italiano di Cultura","address_street_name":"Rue de Livourne","address_street_number":"38","address_street_box":null,"email":"iicbruxelles@esteri.it","website":"http:\/\/www.iicbruxelles.esteri.it","phone_contact":"+32 2 533 27 20","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Livourne, 38","address_line2":"1000 Bruxelles","description_web":"L'Is