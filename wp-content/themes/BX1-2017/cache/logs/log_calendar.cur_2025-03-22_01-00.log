e9n\u00e9rosit\u00e9 du jeu propre au th\u00e9\u00e2tre populaire et de la force d'expression du jeu masqu\u00e9, les spectacles du Th\u00e9\u00e2tre CreaNova (tout public et jeune public ) abordent des th\u00e9matiques vari\u00e9es telles que le f\u00e9minicide, la migration, le r\u00e9chauffement climatique, la guerre, la tol\u00e9rance, la maternit\u00e9.\n\nLa compagnie a l'objectif de questionner non seulement la place de l\u2019individu dans nos soci\u00e9t\u00e9s mais aussi les difficult\u00e9s rencontr\u00e9es par les plus d\u00e9munis dans leur combat quotidien pour sauvegarder leur droit \u00e0 la vie.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Th\u00e9\u00e2tre CreaNova","address_street_name":"rue de la victoire ","address_street_number":"96","address_street_box":"1060","email":"adm@theatrecreanova.be","website":"http:\/\/theatrecreanova.be","phone_contact":"+32 490 25 97 76","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"rue de la victoire , 96 \/ 1060","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Th\u00e9\u00e2tre CreaNova","address_street_name":"rue de la victoire ","address_street_number":"96","address_street_box":"1060","email":"adm@theatrecreanova.be","website":"http:\/\/theatrecreanova.be","phone_contact":"+32 490 25 97 76","phone_booking":null,"address_zip":"1060","address_city":"Sint-Gillis","address_line1":"rue de la victoire , 96 \/ 1060","address_line2":"1060 Sint-Gillis","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[7],"translations":{"de":["Saint-Gilles Zentrum"],"pt":[null],"en":["Saint-Gilles Centre"],"it":["Saint-Gilles Centre"],"cn":[null],"fr":["Saint-Gilles Centre"],"sp":["Saint-Gilles Centre"],"nl