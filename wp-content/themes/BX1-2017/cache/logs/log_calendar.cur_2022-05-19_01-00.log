-03T11:44:58+02:00","backoffice_id":252969,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.34199518933534},{"id":519019,"date_start":"2021-10-07","date_end":"2022-05-26","date_next":"2022-05-19","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre"}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"A Table !","shortdescr":"Au d\u00e9but du spectacle, le menu est annonc\u00e9 aux spectateurs et aux com\u00e9diens qui n\u2019en ont pas connaissance. Qui seront les personnages r\u00e9unis autour de la table ? \u00c0 quelle occasion seront-ils r\u00e9unis ? C\u2019est \u00e0 vous de d\u00e9cider !\r\nD\u00e9marrant de cette impulsion du public et sans concertation ni canevas, les com\u00e9diens vont improviser une vraie sc\u00e8ne de repas pendant 1h15.","longdescr":"C\u2019est \u00e0 un repas bien r\u00e9el auquel va assister le public.\r\nAu d\u00e9but du spectacle, le menu est annonc\u00e9 aux spectateurs et aux com\u00e9diens qui n\u2019en ont pas connaissance. Qui seront les personnages r\u00e9unis autour de la table ? \u00c0 quelle occasion seront-ils r\u00e9unis ? Un repas d\u2019affaire, un d\u00eener de Saint Valentin, un festin de retrouvailles d\u2019amis d\u2019enfance, un pique-nique en famille... C\u2019est aux spectateurs de proposer.\r\n\r\nD\u00e9marrant de cette impulsion du public et sans concertation ni canevas, les com\u00e9diens vont improviser une sc\u00e8ne de repas pendant 1h15.\r\n\u00c0 partir d\u2019une situation toute simple que tout le monde a d\u00e9j\u00e0 v\u00e9cu, les com\u00e9diens vont cr\u00e9er une v\u00e9ritable histoire pouvant, selon les soir\u00e9es, aller d\u2019une com\u00e9die haute en couleur, \u00e0 un drame poignant en passant par un thriller haletant.\r\n\r\nChaque saison, gr\u00e2ce \u00e0 la g\u00e9n\u00e9rosit\u00e9 des com\u00e9diens jouant b\u00e9n\u00e9volement ce spectacle, la moiti\u00e9 des recettes de ce spectacle permet de soutenir une association. Cette ann\u00e9e, il s\u2019agit de l\u2019ASBL forestoise \"A.P.R.E.S. ASBL\" qui se consacre \u00e0 la r\u00e9insertion socio-professionnelle des ex-d\u00e9tenu.e.s.\r\nPlus d\u2019infos : www.apresasbl.be\r\n\r\nEn venant assister \u00e0 ce spectacle, vous faites donc \u00e9galement une bonne action !","performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/A-Table.html","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/519019.html"},"nl":{"name":"A Table !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/519019.html"},"en":{"name":"A Table !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/519019.html"},"de":{"name":"A Table !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/519019.html"},"it":{"name":"A Table !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/519019.html"},"sp":{"name":"A Table !","shortdescr":null,"longdescr"