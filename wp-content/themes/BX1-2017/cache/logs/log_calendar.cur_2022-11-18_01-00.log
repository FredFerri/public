r":{"name":"Association du Patrimoine Artistique asbl","address_street_name":"Rue Charles Hanssens","address_street_number":"7","address_street_box":null,"email":"info@associationdupatrimoineartistique.be","website":"http:\/\/www.associationdupatrimoineartistique.be","phone_contact":"+32 2 512 34 21","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Charles Hanssens, 7","address_line2":"1000 Bruxelles","description_web":"Fond\u00e9e en 1979, l\u2019Association s\u2019est donn\u00e9 pour mission de promouvoir la protection, la restauration et la mise en valeur du patrimoine artistique en Belgique, c\u2019est-\u00e0-dire dans ses trois r\u00e9gions, Bruxelles, la Flandre et la Wallonie.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Association du Patrimoine Artistique asbl","address_street_name":"Charles Hanssensstraat","address_street_number":"7","address_street_box":null,"email":"info@associationdupatrimoineartistique.be","website":"http:\/\/www.associationdupatrimoineartistique.be","phone_contact":"+32 2 512 34 21","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Charles Hanssensstraat, 7","address_line2":"1000 Brussel","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Association du Patrimoine Artistique asbl","address_street_name":"Rue Charles Hanssens","address_street_number":"7","address_street_box":null,"email":"info@associationdupatrimoineartistique.be","website":"http:\/\/www.associationdupatrimoineartistique.be","phone_contact":"+32 2 512 34 21","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue Charles Hanssens, 7","address_line2":"1000 Brussels","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Association du Patrimoine Artistique asbl","address_street_name":"Rue