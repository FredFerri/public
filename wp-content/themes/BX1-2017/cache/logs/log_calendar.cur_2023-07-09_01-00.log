day, wednesday, thursday, friday and saturday: from 11:00 to 18:00"],"sp":["monday and sunday: closed","tuesday, wednesday, thursday, friday and saturday: from 11:00 to 18:00"],"pt":["monday and sunday: closed","tuesday, wednesday, thursday, friday and saturday: from 11:00 to 18:00"],"cn":["monday and sunday: closed","tuesday, wednesday, thursday, friday and saturday: from 11:00 to 18:00"]},"date_start":"2023-05-25","date_end":"2023-07-20","is_also_by_appointment":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"opening":{"day":"2023-05-25","start":"17:00:00","timestamp":"2023-05-25T17:00:00+02:00","end":"21:00:00","is_only_by_appointment":false},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-07-08T03:08:12+02:00","published_at":"2023-04-17T16:09:03+02:00","backoffice_id":275536,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.32737967507804},{"id":554662,"date_start":"2023-06-17","date_end":"2023-07-15","date_next":"2023-07-08","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":true,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen","it":"Visite guidate","sp":"Visitas guiadas","pt":null,"cn":null}},"others":{"list":[108],"translations":{"fr":["Folklore"],"nl":["Folklore"],"en":["Folklore"],"de":["Folklore"],"it":["Folklore"],"sp":["Folclore"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Bruegel et ses Marolles","shortdescr":"Au travers d\u2019un itin\u00e9raire p\u00e9destre, d\u00e9couvrez les Marolles du XVI\u00e8 si\u00e8cle\u2026 et plus sp\u00e9cifiquement autour de ce personnage embl\u00e9matique de notre culture artistique : Bruegel","longdescr":"Au travers d\u2019un itin\u00e9raire p\u00e9destre, d\u00e9couvrez les Marolles du XVI\u00e8 si\u00e8cle\u2026 et plus sp\u00e9cifiquement autour de ce personnage embl\u00e9matique de notre culture artistique : Bruegel\r\nPieter Bruegel, qui habite alors \u00e0 Anvers, tombe amoureux de la fille de son ma\u00eetre Pieter Coecke van Aelst. Pour autoriser le mariage, sa future belle-m\u00e8re met comme condition de voir le couple vivre \u00e0 Bruxelles. Quelque mois apr\u00e8s leurs fian\u00e7ailles, c\u2019est en l\u2019\u00e9glise Notre-Dame de la chapelle dans les Marolles que leur union est officielle.Les jeunes \u00e9poux s\u2019\u00e9tablissent dans ce quartier chic, appel\u00e9 aujourd\u2019hui le quartier Bruegel, et fr\u00e9quent\u00e9 \u00e0 l\u2019\u00e9poque par l\u2019\u00e9lite et les artistes.T\u00e9moin d\u2019une p\u00e9riode trouble avec une situation politique et religieuse instable, Bruegel est contemporain de Charles Quint, de son fils successeur, du Duc D\u2019Albe et assistera \u00e0 l\u2019ex\u00e9cution des comtes d\u2019Egmont et Hornes. Il vivra \u00e0 Bruxelles jusqu\u2019\u00e0 sa mort en 1569 o\u00f9 il sera enseveli dans la m\u00eame \u00e9glise qui l\u2019avait sacr\u00e9 au mariage.\r\n\r\nVisite guid\u00e9e priv\u00e9e, organis\u00e9e sur mesure et \u00e0 la demande","performers":null,"boxoffice_url":null,"website":"http:\/\/www.itineraires.be","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.554662"},"nl":{"name":"Bruegel en zijn Marollen","shortdescr":"Via een wandeling ontdekt u de Marollen van de 16e eeuw... en meer bepaald rond deze emblematische figuur van onze artistieke cultuur: Bruegel","longdescr":"Pieter Bruegel, die vervolgens in Antwerpen woont, wordt verliefd op de dochter van zijn meester Pieter Coecke van Aelst.\r\nOm het huwelijk mogelijk te maken, maakt haar toekomstige schoonmoeder het een voorwaarde om het paar in Brussel te zien wonen. Enkele maanden na hun verloving is het in de kerk Notre-Dame van de kapel in de Marollen officieel dat hun vakbond officieel is.\r\nBruegel is getuige van een turbulente periode met een onstabiele politieke en religieuze situatie en is hedendaags met Charles V, zijn opvolger, Duke D'Albe, en zal de uitvoering van de graven van Egmont en Hornes ondersteunen.\r\nHij zal in Brussel wonen tot zijn dood in 1569, wanneer hij zal worden begraven in dezelfde kerk die hem tot huwelijk had ingewijd.\r\n\r\nPriv\u00e9bezoek, georganiseerd op aanvraag en op maat","performers":null,"boxoffice_url":null,"website":"http:\/\/www.itineraires.be","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.554662"},"en":{"name":"Bruegel and his Marolles","shortdescr":"Through a pedestrian itinerary, discover the Marolles of the 16th century... and more specifically around this emblematic character of our artistic culture: Bruegel","longdescr":"Through this walking tour, discover the Marolles of the 16th century... and more specifically this emblematic character of our artistic culture : Bruegel.\r\nPierre Bruegel, who lived in Antwerp, fell in love with the daughter of his master Pieter Coecke van Aelst. To allow the marriage, her future mother-in-law put the condition to see the couple live in Brussels. Some months after their engagement, it is in the church\r\nNotre-Dame de la Chapelle in the Marolles that their union is made offi cial. Witness of a troubled political and religious period, Bruegel is contemporary with Charles V, his successor Philip the Second, the Duke D\u2019Albe, and will witness the execution of the\r\nCounts of Egmont and Hornes.\r\n\r\nPrivate visit, organized on demand","performers":null,"boxoffice_url":null,"website":"http:\/\/www.itineraires.be","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.554662"},"de":{"name":"Bruegel et ses Marolles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.itineraires.be","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.554662"},"it":{"name":"Bruegel et ses Marolles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.itineraires.be","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.554662"},"sp":{"name":"Bruegel y sus Marolles","shortdescr":null,"longdescr":"Con este recorrido a pie descubrir\u00e1s el barrio de Marolles del siglo XVI y conocer\u00e1s m\u00e1s concretamente todo lo que rodea a este personaje clave de nuestra cultura art\u00edstica. Pieter Bruegel, que viv\u00eda entonces en Amberes, se enamor\u00f3 de la hija de su maestro Pieter Coecke van Aelst. Su futura suegra puso como condici\u00f3n para casarse que la pareja viviera en Bruselas. Unos meses despu\u00e9s de haberse prometido, su uni\u00f3n se hizo oficial en la iglesia de Notre-Dame de la Chapelle, en Marolles. La joven pareja se instal\u00f3 en este barrio elegante, conocido hoy como el barrio de Bruegel, frecuentado en la \u00e9poca por la \u00e9lite y los artistas. Bruegel fue testigo de una \u00e9poca agitada en la que la situaci\u00f3n pol\u00edtica y religiosa era cuanto menos inestable; fue contempor\u00e1neo de Carlos V, de su hijo (y sucesor) Felipe II y del duque de Alba; adem\u00e1s, tambi\u00e9n presenci\u00f3 la ejecuci\u00f3n de los condes de Egmont y de Horn. Bruegel vivi\u00f3 en Bruselas hasta su muerte en 1569, cuando fue enterrado en la misma iglesia de la Chapelle en la que se cas\u00f3.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.itineraires.be","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.554662"},"pt":{"name":"Bruegel et ses Marolles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.itineraires.be","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.554662"},"cn":{"name":"Bruegel et ses Marolles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.itineraires.be","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.554662"}},"place":{"id":248402,"translations":{"fr":{"name":"Entr\u00e9e principale de l'Eglise de la Chapelle","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Entr\u00e9e principale de l'Eglise de la Chapelle","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Hoofdingang Kapellekerk","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Hoofdingang Kapellekerk","address_line2":"1000 Brussel","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Entr\u00e9e 