,"ranking":0.15647795590281},{"id":535759,"date_start":"2022-06-19","date_end":"2022-06-19","date_next":"2022-06-19","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":90,"translations":{"fr":"Animations","nl":"Animaties","en":"Animations"}},"others":{"list":[97],"translations":{"fr":["Parc et centre r\u00e9cr\u00e9atifs"],"nl":["Recreatiedomein of centrum"],"en":["Park and recreational centre"]}}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Rouge-Clo\u00eetre en F\u00eate 2022","shortdescr":"Pour son onzi\u00e8me anniversaire, le Rouge-Clo\u00eetre est \u00e0 nouveau en f\u00eate!","longdescr":"Le dimanche 19 juin, tous ceux qui font le quotidien de ce prestigieux site se mobilisent pour vous proposer une belle s\u00e9rie d\u2019activit\u00e9s. Art, nature, histoire, spectacles, musique, d\u00e9tente gourmande: tous les ingr\u00e9dients sont r\u00e9unis pour passer ensemble une magnifique journ\u00e9e !\r\n\r\nON STAGE\r\n\r\n13.00 & 14.30 : LES VENTHOUSIASTES ET LES ENSEMBLES DE JAZZ (Fanfare)\r\n\r\n13.45 : LES \u00c9L\u00c8VES DE L\u2019ACAD\u00c9MIE D\u2019AUDERGHEM (D\u00e9clamation et musique de chambre)\r\n\r\n15.00 : ZILBANUM ET LES ENCHANTEUSES (Chorale dirig\u00e9e par Fr\u00e9d\u00e9rique Rochette)\r\n\r\n17.00 : MATISSA (Percussions)\r\n\r\nEntr\u00e9e gratuite\r\n\r\nPas d\u2019acc\u00e8s v\u00e9hicules, sauf pour les personnes \u00e0 mobilit\u00e9 r\u00e9duite. Parking disponible pr\u00e8s de l\u2019ADEPS.\r\n\r\nwww.rouge-cloitre.be\r\n\r\nUne organisation de : urban.brussels, Rouge-Clo\u00eetre, la r\u00e9gion de Bruxelles-Capitale, la commune d'Auderghem, Bruxelles-Environnement et le Syndicat d'initiative et Cercle d'histoire d'Auderghem.","performers":"Les Venthousiastes, Zilbanum, Matissa.","boxoffice_url":null,"website":"http:\/\/www.rouge-cloitre.be\/","email":"info@rouge-cloitre.be","phone_contact":"+32 2 660 55 97","phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/535759.html"},"nl":{"name":"Het Rood Klooster-Feest 2022","shortdescr":"Het is opnieuw feest in het Rood Klooster! Deze keer vieren we de elfde verjaardag.","longdescr":"Al diegenen die deel uitmaken van het dagelijkse leven op deze prachtige site hebben de handen in elkaar geslagen om een mooie waaier van activiteiten aan te bieden op zondag 19 juni. Kunst, natuur, geschiedenis, voorstellingen, muziek, proeverijen: alle ingredi\u00ebnten zijn aanwezig om er een leuke dag van te maken !\r\n\r\nON STAGE\r\n\r\n13.00 & 14.30 : LES VENTHOUSIASTES ET LES ENSEMBLES DE JAZZ (Fanfare)\r\n\r\n13.45 : STUDENTEN VAN DE ACADEMIE VAN OUDERGEM (Voordracht en kamermuziek)\r\n\r\n15.00 : ZILBANUM ET LES ENCHANTEUSES (Koor onder leiding van Fr\u00e9d\u00e9rique Rochette)\r\n\r\n17.00 : MATISSA (Slagwerk)\r\n\r\nGratis toegang\r\n\r\nGeen toegang voor voertuigen, behalve voor mensen met een beperkte mobiliteit. Parking mogelijk vlakbij het ADEPS.\r\n\r\nwww.rouge-cloitre.be\r\n\r\nEen organisatie van: urban.brussels, Rood Klooster, het Brussels Hoofdstedelijk Gewest, de gemeente Oudergem, Leefmilieu Brussel en het Syndicat d'initiative et Cercle d'histoire d'Auderghem.","performers":"Les Venthousiastes, Zilbanum, Matissa.","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/535759.html"},"en":{"name":"Rouge-Clo\u00eetre en F\u00eate 2022","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/535759.html"},"de":{"name":"Rouge-Clo\u00eetre en F\u00eate","shortdescr":null,"longdescr":null,"performers":null,"boxoffic