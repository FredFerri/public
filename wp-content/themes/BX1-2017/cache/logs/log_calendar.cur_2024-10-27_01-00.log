g: van 11:00 tot 18:00"]},"date_start":"2024-10-11","date_end":"2025-02-16","is_also_by_appointment":false}],"date_exceptions":[],"closing_days":["2024-11-01","2024-11-11","2025-01-01"],"child_events":[],"parent_events":[],"accessibilities":{"list":[255,261,263,265],"translations":{"de":["Barrierefrei","Barrierefreier Parkplatz","Barrierefrei f\u00fcr Fu\u00dfg\u00e4nger mit Gehhilfe","Barrierefreies WC"],"pt":[null,null,null,null],"en":["Accessible","Accessible parking","Accessible to pedestrians with mobility aids","Adapted toilet"],"it":["Accessibile","Parcheggio accessibile","Accessibile ai pedoni con supporti","WC idoneo"],"cn":[null,null,null,null],"fr":["Accessible","Parking accessible","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9"],"sp":["Habilitado","Estacionamiento habilitado","Habilitado para peatones con aud\u00edfonos","Ba\u00f1os adaptados"],"nl":["Toegankelijk","Toegankelijke parking","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet"]}},"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[]},{"id":50011834,"date_start":"2024-09-13","date_end":"2025-05-30","date_next":"2024-10-26","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-10-26T03:03:05+02:00","published_at":"2024-06-25T12:46:03+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":302803,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.24871131731971627,"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{}},"translations":{"de":{"name":"Smooth as velvet - Textiles take over the walls at the Horta Museum","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.hortamuseum.be","email":"info@hortamuseum.be","phone_contact":"+32 2 543 04 91","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50011834"},"pt":{"name":"Smooth as velvet - Textiles take over the walls at the Horta Museum","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.hortamuseum.be","email":"info@hortamuseum.be","phone_contact":"+32 2 543 04 91","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50011834"},"en":{"name":"Smooth as velvet - Textiles take over the walls at the Horta Museum","shortdescr":"The Horta Museum has invited five artists to dress the walls of the house ; their creations will be on display from 13 September 24 to 30 May 25. Following the successful Pushing Back the Walls exhibition held in 2022, it is now velvet\u2019s turn to take centre stage as it decorates this famous home. L Carmona, F & P Fockedey, E Peroi and M Van Hoe were all given full creative freedom for this project","longdescr":"\nFabric will be the key feature of this exhibition. This choice echoes Horta\u2019s marked fondness for textiles, especially silk, which was hung in several of the houses he designed. This is also a profoundly architectural choice ; the great nineteenth-century theoretician saw textiles as the very source of all architecture, the matrix from which all ornamentation originates \u2026\n\nHere, velvet provides the central theme for this new venture. This textile is often used for furnishing, and was particularly favoured by Horta ; in this case, however, it is given a different mission, serving other purposes...\n Boudoir > \u00c9lise Peroi\nFamily room > Marc Van Hoe\nBreakfast room > Flore & Pauline Fockedey\nKitchen > Louisa Carmona\n\nOther areas in the house, such as the smoking room, the bedroom and the dressing room, will also be decorated with velvet. In this way, visitors will be introduced to the creative worlds of the guest artists and artisans, through an evocative and informative display ...\n\nThis selection was made by the Horta Museum\u2019s Artistic Committee, comprising Marie Pok, Pascale Mussard, Caroline Mierop, Benjamin Zurstrassen and Francis Carpentier.\n\n","performers":"Artists: Louisa Carmona, Flore & Pauline Fockedey, Elise Peroi and Marc Van Hoe\nProducer or\/and Craftsman: the velvet manufacturers Van Neder, Kortrijk (BE) and Florence & Martine Moulis, who create sabre-cut velvets , Arles (FR)","boxoffice_url":null,"website":"http:\/\/www.hortamuseum.be","email":"info@hortamuseum.be","phone_contact":"+32 2 543 04 91","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50011834"},"it":{"name":"Smooth as velvet - Textiles take over the walls at the Horta Museum","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.hortamuseum.be","email":"info@hortamuseum.be","phone_contact":"+32 2 543 04 91","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50011834"},"cn":{"name":"Smooth as velvet - Textiles take over the walls at the Horta Museum","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.hortamuseum.be","email":"info@hortamuseum.be","phone_contact":"+32 2 543 04 91","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50011834"},"fr":{"name":"Comme sur du velours Le textile s\u2019empare des murs du Mus\u00e9e Horta","shortdescr":"Du 13 septembre 2024 au 30 mai 2025, le Mus\u00e9e Horta invite cinq cr\u00e9ateurs \u00e0 investir les murs de la maison. Apr\u00e8s le succ\u00e8s de l'exposition Reculer les murs en 2022, c'est au tour du velours d'\u00eatre mis en lumi\u00e8re sur les murs de la c\u00e9l\u00e8bre maison. Louisa Carmona, Flore et Pauline Fockedey, Elise Peroi et Marc Van Hoe ont re\u00e7u carte blanche.","longdescr":"Une \u0153uvre in\u00e9dite pour chaque artiste est cr\u00e9\u00e9e pour prendre place dans une pi\u00e8ce de la maison. C\u2019est le textile qui sera la mati\u00e8re cl\u00e9 de cette exposition. Un choix qui entre en \u00e9cho avec le go\u00fbt prononc\u00e9 de Horta pour le tissu, principalement la soie qui sera tendue dans nombre des maisons qu\u2019il dessina. Un choix aussi profond\u00e9ment architectural : le grand th\u00e9oricien du XIX\u00e8me si\u00e8cle voyait le textile comme la source m\u00eame de toute architecture, comme la matrice \u00e0 partir de laquelle les ornements sont n\u00e9s\u2026\n\nC\u2019est ici le velours qui sera le fil conducteur de cette nouvelle exp\u00e9rience. Un textile souvent utilis\u00e9 pour l\u2019ameublement ; particuli\u00e8rement par Horta mais qui sera ici d\u00e9tourn\u00e9, utilis\u00e9 \u00e0 d\u2019autres fins\n Le boudoir de Madame > \u00c9lise Peroi\nLe salon de famille > Marc Van Hoe\nLa breakfast room > Flore et Pauline Fockedey\nLa cuisine et la buanderie > Louisa Carmona\n\nD\u2019autres espaces de la maison, comme le fumoir, la chambre ou le dressing seront aussi habill\u00e9s pour initier les visiteurs aux univers des artistes et artisans invit\u00e9s dans une mise en sc\u00e8ne \u00e9vocatrice.\n\nLe comit\u00e9 artistique du Mus\u00e9e Horta, compos\u00e9 de Marie Pok, Pascale Mussard, Caroline Mierop, Benjamin Zurstrassen et Francis Carpentier sont \u00e0 l\u2019origine de cette s\u00e9lection.\n\n","performers":"Artistes: Louisa Carmona, Flore & Pauline Fockedey, Elise Peroi etMarc Van Hoe\nProducteur ou\/et artisan: la manufacture de velours Van Neder, Courtrai (BE) et Florence & Martine Moulis, sabreuses de velours , Arles (FR)","boxoffice_url":null,"website":"http:\/\/www.hortamuseum.be","email":"info@hortamuseum.be","phone_contact":"+32 2 543 04 91","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50011834"},"sp":{"name":"Smooth as velvet - Textiles take over the walls at the Horta Museum","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.hortamuseum.be","email":"info@hortamuseum.be","phone_contact":"+32 2 543 04 91","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50011834"},"nl":{"name":"Als op fluweel Textiel verovert de muren van het Hortamuseum","shortdescr":"Van 13 september 2024 tot 30 mei 2025 nodigt het Hortamuseum vijf ontwerpers uit om de muren van het huis opnieuw vorm te geven. Na het succes van de tentoonstelling Het Terugduwen van de muren in 2022 is het nu de beurt aan fluweel om op de muren van het beroemde huis in de kijker te worden gezet. Louisa Carmona, Flore en Pauline Fockedey, Elise Peroi en Marc Van Hoe kregen carte blanche.","longdescr":"\nElke kunstenaar maakt een nieuwe ongeziene creatie die zijn plaats in een kamer in het huis krijgt. Textiel wordt het belangrijkste materiaal van deze tentoonstelling. Een keuze die Horta's uitgesproken smaak voor stof weerspiegelt, voornamelijk zijde die in tal van huizen die hij ontwierp werd gebruikt. Bovendien is het een zeer architecturale keuze: de grote 19e-eeuwse theoreticus zag textiel als de bron van alle architectuur, als de gietvorm waaruit ornamenten ontstaan...\n\nIn deze nieuwe ervaring staat fluweel centraal. Een textiel dat vaak wordt gebruikt voor meubels, vooral door Horta, maar dat hier zal worden heruitgevonden en gebruikt voor andere doeleinden...\n Boudoir > \u00c9lise Peroi\nFamiliesalon > Marc Van Hoe\nBreakfast room en dienstkamer > Flore en Pauline Fockedey\nKeuken > Louisa Carmona\n\nAndere delen van het huis, zoals de rookkamer, de slaapkamer en de dressing, worden ook aangekleed om bezoekers kennis te laten maken met de wereld van de gastkunstenaars en -vaklieden in een suggestieve en educatieve omgeving...\n\nDeze selectie werd samengesteld door het artistiek comit\u00e9 van het Hortamuseum, bestaande uit Marie Pok, Pascale Mussard, Caroline Mierop, Benjamin Zurstrassen en Francis Carpentier.\n\n","performers":"Kunstenaars: Louisa Carmona, Flore & Pauline Fockedey, Elise Peroi and Marc Van Hoe\nProducent en\/of ambachtsman: de fluweelfabriek Van Neder, Kortrijk (BE) en Florence & Martine Moulis, caffawerkers, Arles (FR)\n","boxoffice_url":null,"website":"http:\/\/www.hortamuseum.be","email":"info@hortamuseum.be","phone_contact":"+32 2 543 04 91","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50011834"}},"place":{"id":241873,"translations":{"de":{"name":"Horta-Museum","address_street_name":"Rue Am\u00e9ricaine","address_street_number":"27","address_street_box":null,"email":"info@hortamuseum.be","website":"http:\/\/www.hortamuseum.be","phone_contact":"+32 2 543 04 90","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Am\u00e9ricaine, 27","address_line2":"1060 Saint-Gilles","description_web":"Die Geb\u00e4ude des heutigen Horta-Museum, das zum UNESCO-Weltkulturerbe z\u00e4hlt, wurde 1898 von dem ber\u00fchmten belgischen Jugendstilarchitekten Victor Horta auf zwei Parzellen der Br\u00fcsseler Rue Am\u00e9ricaine als Wohnhaus und Atelier erbaut. \r\n\r\nVon Arabesken und Licht: Der Jugendstilpionier erfand einen auf der Arabeske beruhenden Stil und revolutionierte den traditionellen Grundriss des b\u00fcrgerlichen Hauses. Mit der Konzeption eines Oberlichtes, das sich \u00fcber einem gro\u00dfr\u00e4umigen Treppenhaus befindet, brach er mit der Struktur des Hauses mit Bel-Etage und drei aneinander anschlie\u00dfenden, eher dunklen Zimmern. Au\u00dferdem nutzte er alle M\u00f6glichkeiten seines handwerklichen K\u00f6nnens und der Verwendung von industriellen Materialien wie Eisen, Gusseisen und Glas. \r\n\r\nHortas Anspruch war es, Kunst und Innenausstattung zu einem Gesamtkunstwerk zusammenzuf\u00fcgen, das das t\u00e4gliche Leben zu einer \u00e4sthetischen Erfahrung machte. Ganz sicher einer der Jugendstilh\u00f6hepunkte in Br\u00fcssel.\r\n\r\nDas Museum beherbergt gleichzeitig ein Forschungszentrum \u00fcber Victor Horta und den Jugendstil. Die pers\u00f6nlichen Archive Hortas, die Pl\u00e4ne seiner Bauten und die Bibliothek sind nach Vereinbarung zug\u00e4nglich.\r\n\r\nLetzter Einlass 17 Uhr.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Museu Horta","address_street_name":"Rue Am\u00e9ricaine","address_street_number":"27","address_street_box":null,"email":"info@hortamuseum.be","website":"http:\/\/www.hortamuseum.be","phone_contact":"+32 2 543 04 90","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Am\u00e9ricaine, 27","address_line2":"1060 Saint-Gilles","description_web":"Este museu reflete na perfei\u00e7\u00e3o o g\u00e9nio de Horta. Defendia uma arte total, que levou ao extremo: cada conceito de planeamento, cada pe\u00e7a de mob\u00edlia, cada detalhe de ilumina\u00e7\u00e3o foi pensado minuciosamente pelo arquiteto para atingir o equil\u00edbrio e a perfei\u00e7\u00e3o, tanto do ponto de vista da est\u00e9tica como do espa\u00e7o.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Museum Horta","address_street_name":"Rue Am\u00e9ricaine","address_street_number":"27","address_street_box":null,"email":"info@hortamuseum.be","website":"http:\/\/www.hortamuseum.be","phone_contact":"+32 2 543 04 90","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Am\u00e9ricaine, 27","address_line2":"1060 Saint-Gilles","description_web":"The Horta Museum is housed in the house and studio of the architect Victor Horta (1861-1947). Both buildings were built from 1898 to 1901 and are typical of the height of Art Nouveau. The interior of the house has been largely preserved: mosaics, stained-glass windows, furniture, wall paintings form a harmonious whole that shows subtlety down to the smallest detail. The museum is also a centre for research on Victor Horta and Art Nouveau. The architect's personal archive, a collection of plans of his buildings and the library are accessible to the public by appointment. Reservation of a time slot online is mandatory. Last access at 16:45.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Museo Horta","address_street_name":"Rue Am\u00e9ricaine","address_street_number":"27","address_street_box":null,"email":"info@hortamuseum.be","website":"http:\/\/www.hortamuseum.be","phone_contact":"+32 2 543 04 90","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Am\u00e9ricaine, 27","address_line2":"1060 Saint-Gilles","description_web":"Il Museo Horta ha sede nella casa privata e nello studio dell'architetto Victor Horta (1861-1947). Costruiti tra il 1898 e il 1901, i due edifici sono caratteristici dell'apice dell'Art Nouveau. La casa ha conservato gran parte del suo arredamento interno: mosaici, vetrate, mobili e pitture murali compongono un insieme armonico e raffinato nei minimi dettagli. Il museo \u00e8 anche un centro di ricerca su Victor Horta e Art Nouveau. Gli archivi personali dell'architetto, una collezione dei progetti dei suoi edifici e la biblioteca sono accessibili al pubblico su appuntamento.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Mus\u00e9e Horta","address_street_name":"Rue Am\u00e9ricaine","address_street_number":"27","address_street_box":null,"email":"info@hortamuseum.be","website":"http:\/\/www.hortamuseum.be","phone_contact":"+32 2 543 04 90","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Am\u00e9ricaine, 27","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Mus\u00e9e Horta","address_street_name":"Rue Am\u00e9ricaine","address_street_number":"27","address_street_box":null,"email":"info@hortamuseum.be","website":"http:\/\/www.hortamuseum.be","phone_contact":"+32 2 543 04 90","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Am\u00e9ricaine, 27","address_line2":"1060 Saint-Gilles","description_web":"Le Mus\u00e9e Horta est install\u00e9 dans la maison et l'atelier de l'architecte Victor Horta (1861-1947). Les deux b\u00e2timents ont \u00e9t\u00e9 construits entre 1898 et 1901 et sont typiques de l'apog\u00e9e de l'Art nouveau. L'int\u00e9rieur de la maison a \u00e9t\u00e9 largement pr\u00e9serv\u00e9 : mosa\u00efques, vitraux, mobilier, peintures murales forment un ensemble harmonieux qui fait preuve de subtilit\u00e9 jusque dans les moindres d\u00e9tails. Le mus\u00e9e est \u00e9galement un centre de recherche sur Victor Horta et l'Art nouveau. Les archives personnelles de l'architecte, une collection de plans de ses b\u00e2timents et la biblioth\u00e8que sont accessibles au public sur rendez-vous. La r\u00e9servation d\u2019une plage d\u2019horaire en ligne est obligatoire. Dernier acc\u00e8s \u00e0 16h45.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Museo Horta","address_street_name":"Rue Am\u00e9ricaine","address_street_number":"27","address_street_box":null,"email":"info@hortamuseum.be","website":"http:\/\/www.hortamuseum.be","phone_contact":"+32 2 543 04 90","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Am\u00e9ricaine, 27","address_line2":"1060 Saint-Gilles","description_web":"El Museo Horta se cre\u00f3 en el domicilio particular y el taller del arquitecto Victor Horta (1861-1947). Los dos edificios, construidos entre 1898 y 1901, son caracter\u00edsticos del apogeo del art nouveau. La casa ha conservado en gran parte su decoraci\u00f3n interior: mosaicos, vidrieras, mobiliario y murales forman un conjunto armonioso y refinado hasta el m\u00e1s m\u00ednimo detalle. El museo es tambi\u00e9n un centro de investigaci\u00f3n sobre Victor Horta y el art nouveau. Los archivos personales del arquitecto, una colecci\u00f3n de planos de sus edificios y la biblioteca est\u00e1n abiertos al p\u00fablico con cita previa.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Hortamuseum","address_street_name":"Amerikastraat","address_street_number":"27","address_street_box":null,"email":"info@hortamuseum.be","website":"http:\/\/www.hortamuseum.be","phone_contact":"+32 2 543 04 90","phone_booking":null,"address_zip":"1060","address_city":"Sint-Gillis","address_line1":"Amerikastraat, 27","address_line2":"1060 Sint-Gillis","description_web":"Het Hortamuseum is gevestigd in het eigen huis en het atelier van architect Victor Horta (1861-1947). Deze gebouwen werden door de architect opgetrokken tussen 1898 en 1901 op het hoogtepunt van de art nouveau. Een groot deel van de interieurdecoratie bleef bewaard; de mosa\u00efeken, de glasramen, het meubilair, de muurschilderingen vormen een harmonisch en tot in het kleinste detail verzorgd geheel. Het museum is ook een onderzoekscentrum voor Victor Horta en de Art Nouveau. Het persoonlijke archief van de architect, een verzameling plannen van zijn gebouwen en de bibliotheek zijn op afspraak toegankelijk voor het publiek. De reservatie van een tijdsblok online is verplicht. Laatste toegang mogelijk om 16u45.\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"vi