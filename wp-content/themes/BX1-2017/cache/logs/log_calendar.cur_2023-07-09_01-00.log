ries diverses \u2026 mais que se cache-t-il derri\u00e8re tout \u00e7a ? Pourquoi cet \u00e9clectisme, ces allusions \u00e0 la mythologie antique ou la franc-ma\u00e7onnerie, sur une place de march\u00e9 ?\r\nVisite Guid\u00e9e Bruxelles vous propose de poser Un Autre Regard sur la Grand-Place, celui de son interpr\u00e9tation symbolique : pourquoi les constructeurs, et plus tard ses r\u00e9novateurs ont-ils b\u00e2ti \u00ab \u00e7\u00e0-comme \u00e7a-l\u00e0-\u00e0 l\u2019\u00e9poque \u00bb ? Quelle image voulaient-ils v\u00e9hiculer, quels messages voulaient-ils faire passer ? \u2026 une visite s\u00e9rieuse. Sans se prendre au s\u00e9rieux.\r\nLe tourisme. Autrement.\r\nEn compagnie d'un guide bruxellois.","performers":"Vincent Beckers, guide touristique et r\u00e9gional","boxoffice_url":null,"website":"http:\/\/www.visiteguideebruxelles.be","email":"info@visiteguideebruxelles.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.549963"},"nl":{"name":"Les symboles de la Grand-Place de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.visiteguideebruxelles.be","email":"info@visiteguideebruxelles.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.549963"},"en":{"name":"Les symboles de la Grand-Place de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.visiteguideebruxelles.be","email":"info@visiteguideebruxelles.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.549963"},"de":{"name":"Les symboles de la Grand-Place de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.visiteguideebruxelles.be","email":"info@visiteguideebruxelles.be","phone_contact":null,"phone_booking":null,"agenda_url":"