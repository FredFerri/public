ed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2023-10-23T02:03:56+02:00","published_at":"2023-09-04T11:47:19+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":284682,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.2696559088937193,"languages":{"spoken":["en","fr","nl"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[40,36],"translations":{"de":["Grafische K\u00fcnste","Museen & Kunstzentren"],"pt":[null,null],"en":["Graphic art","Museums and art centers"],"it":["Arti grafiche","Musei e centri artistici"],"cn":[null,null],"fr":["Arts graphiques","Mus\u00e9es et art centers"],"sp":["Artes gr\u00e1ficas","Museos y centros de arte"],"nl":["Grafische kunst, vormgeving","Musea en kunstcentra"]}}},"translations":{"de":{"name":"In the Eye of the Storm : Modernisme en Ukraine, 1900-1930s","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/fine-arts-museum.be\/fr\/expositions\/in-the-eye-of-the-storm","email":"info@fine-arts-museum.be","phone_contact":"+32 2 508 32 11","phone_booking":"+32 2 508 32 11","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50001746"},"pt":{"name":"In the Eye of the Storm : Modernisme en Ukraine, 1900-1930s","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/fine-arts-museum.be\/fr\/expositions\/in-the-eye-of-the-storm","email":"info@fine-arts-museum.be","phone_contact":"+32 2 508 32 11","phone_booking":"+32 2 508 32 11","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50001746"},"en":{"name":"In the Eye of the Storm: Modernism in Ukraine, 1900-1930s","shortdescr":"Highlighting a range of artistic styles and diverse cultural identities, In the Eye of the Storm features over sixty works, most of which are on loan from the National Art Museum of Ukraine (NAMU) and the Museum of Theatre, Music and Cinema of Ukraine to safeguard them during the ongoing Russian invasion of Ukraine.","longdescr":"Discover the modernist art in Ukraine between 1900 and the 1930s...\n\nThe Modernist movement in Ukraine developed against a backdrop of collapsing empires, the First World War, the struggle for independence and the creation of Soviet Ukraine. Despite these profound upheavals, the first decades of the twentieth century saw bold artistic experimentations and a real flowering of art, literature and theatre in Ukraine.\nHighlighting a range of artistic styles and diverse cultural identities, In the Eye of the Storm features over sixty works, most of which are on loan from the National Art Museum of Ukraine (NAMU) and the Museum of Theatre, Music and Cinema of Ukraine to safeguard them during the ongoing Russian invasion of Ukraine.\n\nThe exhibition brings together works by artists such as Kazymyr Malevych, Alexandra Exter and \nEl Lissitzky, as well as by lesser-known figures, including Oleksandr Bohomazov, Sarah Shor and Mykhailo Boichuk, all of whom have left an indelible mark on the country's art and culture. \n\n\nOrganised by the Museo Nacional Thyssen-Bornemisza, Madrid, Ludwig Museum, Cologne, the Royal Museums of Fine Arts of Belgium, Brussels, the Belvedere Museum, Vienna and the Royal Academy of Arts, London, in partnership with the National Art Museum of Ukraine.\n\nCurators: Konstantin Akinsha (freelance art historian and curator), Katia Denysova (art historian and doctoral candidate at the Courtauld Institute of Art, London), Olena Kashuba-Volvach (Curator of 19th and early 20th-Century Art, NAMU) & Francisca Vandepitte (Senior Curator of the Modern Art collection, Royal Museums of Fine Arts of Belgium). \n\nFree admission with a ticket for the permanent collection\n\n","performers":"Organised by the Museo Nacional Thyssen-Bornemisza, Madrid, Ludwig Museum, Cologne, the Royal Museums of Fine Arts of Belgium, Brussels, the Belvedere Museum, Vienna and the Royal Academy of Arts, London, in partnership with the National Art Museum of Ukraine.","boxoffice_url":null,"website":"https:\/\/fine-arts-museum.be\/en\/exhibitions\/in-the-eye-of-the-storm","email":"info@fine-arts-museum.be","phone_contact":"+32 2 508 32 11","phone_booking":"+32 2 508 32 11","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50001746"},"it":{"name":"In the Eye of the Storm : Modernisme en Ukraine, 1900-1930s","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/fine-arts-museum.be\/fr\/expositions\/in-the-eye-of-the-storm","email":"info@fine-arts-museum.be","phone_contact":"+32 2 508 32 11","phone_booking":"+32 2 508 32 11","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50001746"},"cn":{"name":"In the Eye of the Storm : Modernisme en Ukraine, 1900-1930s","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/fine-arts-museum.be\/fr\/expositions\/in-the-eye-of-the-storm","email":"info@fine-arts-museum.be","phone_contact":"+32 2 508 32 11","phone_booking":"+32 2 508 32 11","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50001746"},"fr":{"name":"In the Eye of the Storm: Modernism in Ukraine, 1900-1930s","shortdescr":"Mettant en lumi\u00e8re un \u00e9ventail de styles artistiques et d'identit\u00e9s culturelles diverses, In the Eye of the Storm pr\u00e9sente plus de soixante \u0153uvres, dont la plupart ont \u00e9t\u00e9 pr\u00eat\u00e9es par le Mus\u00e9e national d'art d'Ukraine (NAMU) et le Mus\u00e9e du th\u00e9\u00e2tre, de la musique et du cin\u00e9ma d'Ukraine afin de les sauvegarder durant l\u2019invasion russe actuellement en cours en Ukraine.\n","longdescr":"\u00c0 la d\u00e9couverte de l'art moderniste r\u00e9alis\u00e9 en Ukraine entre 1900 et les ann\u00e9es 1930\u2026\n\nLe mouvement moderniste en Ukraine s'est d\u00e9velopp\u00e9 sur fond d'effondrement des empires, de Premi\u00e8re Guerre mondiale, de lutte pour l'ind\u00e9pendance et de cr\u00e9ation de l'Ukraine sovi\u00e9tique. \nMalgr\u00e9 ces profonds bouleversements, les premi\u00e8res d\u00e9cennies du XXe si\u00e8cle ont \u00e9t\u00e9 le th\u00e9\u00e2tre d'exp\u00e9rimentations artistiques audacieuses et d'un v\u00e9ritable \u00e9panouissement de l'art, de la litt\u00e9rature et du th\u00e9\u00e2tre en Ukraine.\n\nMettant en lumi\u00e8re un \u00e9ventail de styles artistiques et d'identit\u00e9s culturelles diverses, In the Eye of the Storm pr\u00e9sente plus de soixante \u0153uvres, dont la plupart ont \u00e9t\u00e9 pr\u00eat\u00e9es par le Mus\u00e9e national d'art d'Ukraine (NAMU) et le Mus\u00e9e du th\u00e9\u00e2tre, de la musique et du cin\u00e9ma d'Ukraine afin de les sauvegarder durant l\u2019invasion russe actuellement en cours en Ukraine. \nL'exposition rassemble des \u0153uvres d'artistes tels que Kazymyr Malevych, Alexandra Exter et El Lissitzky, ainsi que des figures moins connues, comme Oleksandr Bohomazov, Sarah Shor et Mykhailo Boichuk, qui ont toutes laiss\u00e9 une marque ind\u00e9l\u00e9bile sur l'art et la culture du pays.\n\nOrganis\u00e9 par le Museo Nacional Thyssen-Bornemisza, Madrid, le Museum Ludwig, Cologne, les Mus\u00e9es royaux des Beaux-Arts de Belgique, Bruxelles, le Mus\u00e9e du Belv\u00e9d\u00e8re, Vienne et la Royal Academy of Arts, Londres, en partenariat avec le Mus\u00e9e national d'art d'Ukraine.\n\nCommissaires : Konstantin Akinsha (historien de l'art et conservateur ind\u00e9pendant), Katia Denysova (historienne de l'art et doctorante au Courtauld Institute of Art, Londres), Olena Kashuba-Volvach (conservatrice de l'art du 19e et du d\u00e9but du 20e si\u00e8cle, NAMU) et Francisca Vandepitte (conservatrice de la collection d'art moderne, Mus\u00e9es royaux des Beaux-Arts de Belgique). \n\nAcc\u00e8s gratuit \u00e0 l'achat d'un billet pour la collection permanente des Mus\u00e9es.\n","performers":"Organis\u00e9 par le Museo Nacional Thyssen-Bornemisza, Madrid, le Museum Ludwig, Cologne, les Mus\u00e9es royaux des Beaux-Arts de Belgique, Bruxelles, le Mus\u00e9e du Belv\u00e9d\u00e8re, Vienne et la Royal Academy of Arts, Londres, en partenariat avec le Mus\u00e9e national d'art d'Ukraine.\n","boxoffice_url":null,"website":"https:\/\/fine-arts-museum.be\/fr\/expositions\/in-the-eye-of-the-storm","email":"info@fine-arts-museum.be","phone_contact":"+32 2 508 32 11","phone_booking":"+32 2 508 32 11","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50001746"},"sp":{"name":"In the Eye of the Storm : Modernisme en Ukraine, 1900-1930s","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/fine-arts-museum.be\/fr\/expositions\/in-the-eye-of-the-storm","email":"info@fine-arts-museum.be","phone_contact":"+32 2 508 32 11","phone_booking":"+32 2 508 32 11","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50001746"},"nl":{"name":"In the Eye of the Storm: Modernism in Ukraine, 1900-1930s","shortdescr":"In the Eye of the Storm belicht een scala aan artistieke stijlen en diverse culturele identiteiten en toont meer dan zestig werken, waarvan de meeste in bruikleen zijn gegeven door het National Art Museum of Ukraine (NAMU) en het Museum of Theatre, Music and Cinema of Ukraine om ze te beschermen tijdens de aanhoudende Russische invasie van Oekra\u00efne.","longdescr":"Ontdek de modernistische kunst in Oekra\u00efne tussen 1900 en de jaren 1930...\n\nDe modernistische beweging in Oekra\u00efne ontwikkelde zich tegen een achtergrond van ineenstortende keizerrijken, de Eerste Wereldoorlog, de strijd voor onafhankelijkheid en de oprichting van Sovjet-Oekra\u00efne. Ondanks deze ingrijpende omwentelingen waren er in de eerste decennia van de twintigste eeuw gedurfde artistieke experimenten en een ware bloei van kunst, literatuur en theater in Oekra\u00efne. \n\nIn the Eye of the Storm belicht een scala aan artistieke stijlen en diverse culturele identiteiten en toont meer dan zestig werken, waarvan de meeste in bruikleen zijn gegeven door het National Art Museum of Ukraine (NAMU) en het Museum of Theatre, Music and Cinema of Ukraine om ze te beschermen tijdens de aanhoudende Russische invasie van Oekra\u00efne.\n\nDe tentoonstelling brengt werken samen van kunstenaars als Kazymyr Malevych, Alexandra Exter en El Lissitzky, maar ook van minder bekende figuren als Oleksandr Bohomazov, Sarah Shor en Mykhailo Boichuk, die allemaal een onuitwisbare stempel hebben gedrukt op de kunst en cultuur van het land.\n\nGeorganiseerd door het Museo Nacional Thyssen-Bornemisza, Madrid, Ludwig Museum, Keulen, de Koninklijke Musea voor Schone Kunsten van Belgi\u00eb, Brussel, het Belvedere Museum, Wenen en de Royal Academy of Arts, Londen, in samenwerking met het Nationaal Kunstmuseum van Oekra\u00efne.\n\nCuratoren: Konstantin Akinsha (freelance kunsthistoricus en curator), Katia Denysova (kunsthistoricus en doctoraatskandidaat aan het Courtauld Institute of Art, Londen), Olena Kashuba-Volvach (Conservator 19e en vroeg 20e-eeuwse kunst, NAMU) & Francisca Vandepitte (Conservator van de collectie Moderne Kunst, Koninklijke Musea voor Schone Kunsten van Belgi\u00eb).\n\nTe bezoeken gratis met een ticket voor de permanente collectie","performers":"Georganiseerd door het Museo Nacional Thyssen-Bornemisza, Madrid, Ludwig Museum, Keulen, de Koninklijke Musea voor Schone Kunsten van Belgi\u00eb, Brussel, het Belvedere Museum, Wenen en de Royal Academy of Arts, Londen, in samenwerking met het Nationaal Kunstmuseum van Oekra\u00efne.\n","boxoffice_url":null,"website":"https:\/\/fine-arts-museum.be\/nl\/tentoonstellingen\/in-the-eye-of-the-storm","email":"info@fine-arts-museum.be","phone_contact":"+32 2 508 32 11","phone_booking":"+32 2 508 32 11","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50001746"}},"place":{"id":488,"translations":{"de":{"name":"Mus\u00e9es Royaux des Beaux-Arts de Belgique","address_street_name":"Rue de la R\u00e9gence","address_street_number":"3","address_street_box":null,"email":"info@fine-arts-museum.be","website":"http:\/\/www.fine-arts-museum.be","phone_contact":"+32 2 508 32 11","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la R\u00e9gence, 3","address_line2":"1000 Bruxelles","description_web":"Die Mus\u00e9es Royaux des Beaux-Arts de Belgique \u2013 6 Museen, 7 Jahrhunderte der sch\u00f6nen K\u00fcnste, 20 000 Kunstwerke und Kunstgenuss vom Feinsten:\r\n\r\n\u2022\tIm Mus\u00e9e Magritte gibt es die weltweit gr\u00f6\u00dfte Sammlung von Werken des gro\u00dfen belgischen Surrealisten Ren\u00e9 Magritte zu entdecken\r\n\r\n\u2022\tIm Mus\u00e9e Fin-de-Si\u00e8cle erwartet den Besucher mit K\u00fcnstlern wie Khnopff, Spilliaert, Horta, Rodin, Gauguin, Mucha und Bonnard das besondere Fin-de-Si\u00e8cle-Ambiente, das um 1900 in Br\u00fcssel herrschte. Mehr als 30 K\u00fcnstler \u2013 vom Impressionismus \u00fcber den Jugendstil, von den sch\u00f6nen K\u00fcnsten bis zur Oper.\r\n\r\n\u2022\tIm Mus\u00e9e Old Master gibt es Meisterwerke aus der Epoche des 15. Jahrhunderts bis hin zum 18. Jahrhundert zu sehen, unter anderem mit der weltweit gr\u00f6\u00dften Bruegel-Sammlung, verschiedenen Werken von Rubens, van der Weyden und Jordaens. \r\n\r\n\u2022\tDas Mus\u00e9e Modern Art zeigt eine Auswahl von Meisterwerken des 20. Jahrhunderts, darunter Broodthaers, Fabre, David, Panamarenko, Alechinsky.\r\n\r\n\u2022\tDie beiden Kunstatelier-Museen Mus\u00e9e Wiertz und Meunier in Ixelles geben einen faszinierenden Einblick in die Welt dieser beiden K\u00fcnstler.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Mus\u00e9es Royaux des Beaux-Arts de Belgique","address_street_name":"Rue de la R\u00e9gence","address_street_number":"3","address_street_box":null,"email":"info@fine-arts-museum.be","website":"http:\/\/www.fine-arts-museum.be","phone_contact":"+32 2 508 32 11","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la R\u00e9gence, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Royal Museums of Fine Arts of Belgium","address_street_name":"rue de la R\u00e9gence","address_street_number":"3","address_street_box":null,"email":"info@fine-arts-museum.be","website":"http:\/\/www.fine-arts-museum.be","phone_contact":"+32 2 508 32 11","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"rue de la R\u00e9gence, 3","address_line2":"1000 Bruxelles","description_web":"The Royal Museums of Fine Arts of Belgium assemble six different museums: the Oldmasters Museum, Modern Museum, Meunier Museum, Wiertz Museum, Magritte Museum and the Fin-de-Si\u00e8cle Museum.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Museo Reale delle Belle Arti del Belgio","address_street_name":"Rue de la R\u00e9gence","address_street_number":"3","address_street_box":null,"email":"info@fine-arts-museum.be","website":"http:\/\/www.fine-arts-museum.be\/","phone_contact":"+32 2 508 32 11","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la R\u00e9gence, 3","address_line2":"1000 Bruxelles","description_web":"I Musei Reali delle Belle Arti del Belgio sono sei musei di Bruxelles: l'Oldmasters Museum, il Mus\u00e9e Modern, il Meunier Museum, il Wiertz Museum, il Magritte