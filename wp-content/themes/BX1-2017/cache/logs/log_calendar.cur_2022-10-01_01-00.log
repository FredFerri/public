 van 10:00 tot 18:00"],"en":["monday: closed","tuesday, wednesday, thursday and friday: from 10:00 to 17:00","saturday and sunday: from 10:00 to 18:00"]},"date_start":"2022-09-16","date_end":"2023-03-05","is_also_by_appointment":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":10},{"translations":{"fr":{"name":"Article 27"},"nl":{"name":"Artikel 27"},"en":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"visit_profile":{"list":[337],"translations":{"fr":["Highlight"],"nl":["Highlight"],"en":["Highlight"]}},"tags":[],"accessibilities":{"list":[255,263],"translations":{"fr":["Accessible","Accessible aux pi\u00e9tons appareill\u00e9s"],"nl":["Toegankelijk","Toegankelijk voor voetgangers met hulpmiddelen"],"en":["Accessible","Accessible to pedestrians with mobility aids"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-09-30T01:07:54+02:00","published_at":"2022-09-05T13:26:32+02:00","backoffice_id":261022,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.28599248869989},{"id":538658,"date_start":"2022-09-24","date_end":"2022-12-18","date_next":"2022-09-30","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[36,37],"translations":{"fr":["Mus\u00e9es et art centers","Arts audiovisuels"],"nl":["Musea en kunstcentra","Audiovisuele kunst"],"en":["Museums and art centers","Audiovisual art"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"THE 1970s: _____","shortdescr":"Les pionniers du film et de la vid\u00e9o dans les ann\u00e9es 1970 en Belgique.","longdescr":"THE 1970s: _ met en \u00e9vidence une \u00e9poque particuli\u00e8rement prolifique pour la production artistique en Belgique, durant laquelle l\u2019exp\u00e9rimentation audiovisuelle s\u2019est acc\u00e9l\u00e9r\u00e9e. A partir de 1970, de nombreux artistes explorent pleinement les possibilit\u00e9s cr\u00e9atives et technologiques du cin\u00e9ma et de la vid\u00e9o. L\u2019exposition se positionne sur l\u2019axe g\u00e9oculturel Li\u00e8ge-Anvers en faisant quelques d\u00e9tours importants par Bruxelles, Namur, Alost et Knokke; marquant ainsi une p\u00e9riode au cours de laquelle de nombreux artistes d\u00e9veloppent de nouvelles m\u00e9thodes de production souvent collaboratives, immat\u00e9rielles et interdisciplinaires.\r\n\r\nTHE 1970s: _ est la premi\u00e8re manifestation publique d'un projet de recherche initi\u00e9 par argos en 2018. L'exposition pr\u00e9sente les r\u00e9sultats de ce projet en quatre grands th\u00e8mes : les moyens de production, les \u00e9v\u00e9nements, les collectifs d'artistes et l'interdisciplinarit\u00e9. Ces quatre chapitres sont explor\u00e9s au rez-de-chauss\u00e9e, tandis que l'\u00e9tage sup\u00e9rieur est d\u00e9di\u00e9 au potentiel utopique qu\u2019offre le m\u00e9dium vid\u00e9o. THE 1970s: _ reconstitue plusieurs installations phares de l'\u00e9poque et inclut une s\u00e9rie d'oeuvres num\u00e9ris\u00e9es, produites \u00e0 l'origine en U-matic, Sony Open Reel, 16 mm et Super 8.\r\n\r\ncommissaires:\r\n\r\nDagmar Dirkx avec Niels Van Tomme","performers":null,"boxoffice_url":null,"website":"http:\/\/www.argosarts.org","email":"info@argosarts.org","phone_contact":null,"phone_booking":"+32 2 229 00 03","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.538658"},"nl":{"name":"THE 1970s: _____","shortdescr":"Film en video pioniers in Belgi\u00eb.","longdescr":"THE 1970s: _ belicht een bijzonder rijke periode voor de artistieke productie in Belgi\u00eb, waarin steeds meer audiovisuele experimenten plaatsvonden. Vanaf 1970 gingen kunstenaars de creatieve en technologische mogelijkheden van video en film uitvoerig verkennen. De tentoonstelling speelt zich voornamelijk af op de geo-culturele as tussen Luik en Antwerpen, met belangrijke zijsprongen naar Brussel, Aalst, Namen en Knokke, en belicht een periode waarin kunstenaars nieuwe manieren van samenwerken opzoeken die hen toelaten om immateri\u00eble en interdisciplinaire kunstvormen te ontwikkelen.\r\n\r\nTHE 1970s: _ is de eerste publieke manifestatie van een langlopend onderzoeksproject dat argos in 2018 aanvatte. De tentoonstelling ontsluit de bevindingen van het onderzoek in vier thema's: productiemiddelen, evenementen, kunstenaarscollectieven en interdisciplinariteit. Deze vier hoofdstukken worden op de benedenverdieping uitgediept terwijl de bovenverdieping gewijd is aan het utopische potentieel van video en film. THE 1970s: _ reconstrueert een aantal belangrijke installaties uit die tijd, en presenteert een reeks gedigitaliseerde kunstwerken die oorspronkelijk op U-matic, Sony Open Reel, 16mm of Super 8 werden gedraaid.\r\n\r\ncuratoren:\r\n\r\nDagmar Dirkx met Niels Van Tomme","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.538658"},"en":{"name":"THE 1970s: _____","shortdescr":"Film and video pioneers in the 1970s in Belgium.","longdescr":"THE 1970s: _ highlights a remarkably prolific era of artistic production in Belgium that saw the acceleration of audiovisual experimentation. From 1970 onward, artists started fully exploring the creative and technological possibilities of video and film. Played out predominantly across the geo-cultural axis of Li\u00e8ge \u2013 Antwerp, with important digressions in Brussels, Aalst, Namur, and Knokke, it marks a period during which artists developed new forms of production that were often collaborative, immaterial, and interdisciplinary in nature.\r\n\r\nTHE 1970s: _ is the first public manifestation of a long-term research project argos launched in 2018. The exhibition divides the findings of this research into four main themes: means of production, events, artist collectives, and the interdisciplinary. These four chapters are explored on the ground floor, while the upper floor is dedicated to foregrounding the utopian potential of video and film. THE 1970s: _ recreates a selection of key installations from the era, while also presenting a series of digitised art works originally shot on U-matic, Sony Open Reel, 16mm, and Super 8.\r\n\r\ncurated by:\r\n\r\nDagmar Dirkx with Niels Van Tomme","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.538658"},"de":{"name":"The 1970s : video and film pioneers in Belgium","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.538658"},"it":{"name":"The 1970s : video and film pioneers in Belgium","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.538658"},"sp":{"name":"The 1970s : video and film pioneers in Belgium","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.538658"},"pt":{"name":"The 1970s : video and film pioneers in Belgium","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.538658"},"cn":{"name":"The 1970s : video and film pioneers in Belgium","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.538658"}},"place":{"id":228372,"translations":{"fr":{"name":"argos centre for audiovisuals arts","address_street_name":"Rue du Chantier","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Chantier, 13","address_line2":"1000 Bruxelles","description_web":"Fond\u00e9 en 1989 \u00e0 Bruxelles, argos est un lieu ressource pour la pr\u00e9sentation, la production et le d\u00e9veloppement des arts audiovisuels critiques, ainsi que pour leur distribution, conservation et restauration.\r\n\r\nargos consid\u00e8re l\u2019audiovisuel comme un moyen des plus pertinents pour regarder et comprendre le monde de mani\u00e8re ouverte et int\u00e9gr\u00e9e. Soutenant les voix alternatives dans la soci\u00e9t\u00e9, il favorise le dialogue avec un large \u00e9ventail de partenaires institutionnels ou non, tant \u00e0 Bruxelles qu\u2019ailleurs. argis recherche sans cesse de nouvelles fa\u00e7ons d'impliquer et d\u2019associer les publics les plus larges.\r\n\r\nargos  con\u00e7oit des expositions et programmations, distribue les \u0153uvres audiovisuelles les plus contemporaines et critiques; sa mission par ailleurs constitue, conserve et fait conna\u00eetre un tr\u00e8s important fonds de films et de vid\u00e9os d\u2019artistes. Il comporte \u00e9galement une m\u00e9diath\u00e8que unique en son genre, ouverte aux professionnels et au grand public. Celle-ci inclut une tr\u00e8s large s\u00e9lection de publications et les \u0153uvres audiovisuelles de la collection. De plus, ARGOS d\u00e9veloppe des projets de recherche in\u00e9dits pour pallier les lacunes importantes dans l'histoire de l'art, questionnant les relations entre culture et soci\u00e9t\u00e9.\r\n\r\n\u00c0 travers ces multiples activit\u00e9s, argis a pour objectif de permettre une meilleure compr\u00e9hension du pass\u00e9 et du pr\u00e9sent des arts audiovisuels tout en fournissant les outils pour imaginer et fa\u00e7onner collectivement leur avenir.","description_print":"","booking_url":null,"sort_order":"ARGOS, CENTRE FOR ART & MEDIA","virtual_visit":null},"nl":{"name":"argos centre for audiovisuals arts","address_street_name":"Werfstraat","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Brussel","address_line1":"Werfstraat, 13","address_line2":"1000 Brussel","description_web":"argos werd opgericht in 1989 in Brussel en is een instituut, en bron, voor de studie, productie en vooruitgang van kritische audiovisuele kunsten, evenals de distributie, het behoud en de restauratie ervan.\r\n\r\nargos beschouwt het audiovisuele als een belangrijk middel om op meer open en ge\u00efntegreerde manieren de wereld te bekijken en te begrijpen. We ondersteunen een veelheid aan stemmen in de samenleving en gaan in dialoog met een breed scala aan institutionele en niet-institutionele partners, zowel in Brussel als daarbuiten. Zo willen we een steeds ruimer en \u200b\u200bmeer divers publiek bij onze activiteiten betrekken.\r\n\r\n\u249c\u24ad\u24a2\u24aa\u24ae maakt tentoonstellingen en programma's, distribueert audiovisuele werken en bouwt, beheert en ontsluit een prominente collectie van kunstenaarfilms en -video's. We hebben ook een unieke mediatheek met een ruime selectie van publicaties en de audiovisuele werken van de collectie, die zowel voor professionals als het algemene publiek toegankelijk is. Daarnaast ontwikkelen we originele onderzoeksprojecten met betrekking tot vooraanstaande hiaten in de kunstgeschiedenis en de relatie ervan tot cultuur en maatschappij.\r\n\r\nVia deze verschillende activiteiten wil argos het verleden en het heden van de audiovisuele kunsten beter doorgronden, en ook instrumenten bieden om collectief hun toekomst in te beelden en opnieuw vorm te geven.","description_print":"","booking_url":null,"sort_order":"ARGOS, CENTRE FOR ART & MEDIA","virtual_visit":null},"en":{"name":"argos centre for audiovisuals arts","address_street_name":"Werfstraat\/ Rue du Chantier","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Brussels","address_line1":"Werfstraat\/ Rue du Chantier, 13","address_line2":"1000 Brussels","description_web":"Founded in 1989 in Brussels, argos is an institution and resource for the presentation, production, and study of critical audiovisual arts, as well as for its distribution, conservation and restoration. argos considers the audiovisual as a primary means of looking at and understanding the world in more open and integrated ways. Supporting a multiplicity of voices in society, it fosters dialogue with a broad range of institutional and non-institutional partners, both in Brussels and beyond, and seeks new ways to engage diverse audiences. \r\n\r\nargos makes exhibitions and programmes, distributes moving image works, and builds, preserves, and discloses a prominent collection of artist films and videos. It also houses a unique media library containing a broad selection of publications, as well as the audiovisual works of the collection, which is open to both professionals and the general public. Additionally, it develops original research projects relating to significant gaps in art history and its relationship to culture and society. Through these various activities, argos aims to more fully understand the past and present of audiovisual arts, as well as provide tools to collectively imagine and shape its futures.\r\n","description_print":"","booking_url":null,"sort_order":"ARGOS, CENTRE FOR ART & MEDIA","virtual_visit":null},"de":{"name":"ARGOS centre for audivisual arts","address_street_name":"Rue du Chantier","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Chantier, 13","address_line2":"1000 Bruxelles","description_web":"Das Kunstzentrum Argos wurde 1989 mit dem Ziel gegr\u00fcndet, audiovisuelle Kunstformen zu f\u00f6rdern. Heute gilt das Argos, das in der N\u00e4he des Kanals im Br\u00fcsseler Stadtzentrum niedergelassen ist, als Referenz f\u00fcr diese Kunstformen. Das Programm des Hauses ist vielf\u00e4ltig und reicht von audiovisuellen und visuellen Ausstellungen \u00fcber Film- und Videovorf\u00fchrungen bis hin zu Konferenzen und Perfomances.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"ARGOS centre for audivisual arts","address_street_name":"Rue du Chantier","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Chantier, 13","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"ARGOS centre for audivisual arts","address_street_name":"Rue du Chantier","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Chantier, 13","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"ARGOS centre for audivisual arts","address_street_name":"Rue du Chantier","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Chantier, 13","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"ARGOS centre for audivisual arts","address_street_name":"Rue du Chantier","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Chantier, 13","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":[],"zones":{"list":[19],"translations":{"fr":["Centre"],"nl":["Centrum"],"en":["Centre"]}},"neca":"art_center","facebook_id":null,"backoffice_id":769,"location":{"lat":50.85663153,"lon":4.34963277},"region":"brussels","last_updated_at":"2022-09-30T01:35:16+02:00","published_at":"2013-10-19T01:13:47+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":228372,"translations":{"fr":{"name":"argos centre for audiovisuals arts","address_street_name":"Rue du Chantier","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+3