how_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":265724,"facebook_link":null,"import_origin":null,"is_part_of":"Ann\u00e9e Art Nouveau","sub_type":"tour","ranking":0.14643004228082399,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{}},"translations":{"de":{"name":"Foundation Frison Horta \"A Living museum\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.foundation-frison-horta.be","email":"contact@foundation-frison-horta.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.545724"},"pt":{"name":"Foundation Frison Horta \"A Living museum\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.foundation-frison-horta.be","email":"contact@foundation-frison-horta.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.545724"},"en":{"name":"Foundation Frison Horta \"A Living museum\"","shortdescr":"Maison muse L'art Nouveau Victor Horta ","longdescr":"Foundation Frison Horta is an Active Cultural Bridge Between East & West Restoring, Preserving and Sustaining Rich Art & Craft of the By-Gone Era, in an Artistic Art-de-Vivre form. \u201cExcellence in Craftsmanship and M\u00e9tiers d\u2019Art\u201d. The Foundation Aims to Foster Greater Understanding and Appreciation of the Rich Heritage & Cultural Traditions of the East particularly of Indian Sub-continent In Europe and vice versa.\r\nFoundation Frison Horta is working Extensively in Restoring the image of Brussels with Art Nouveau as its National Identity to a Global Audience.\r\nMaison Frison is the Only one of a kind house of Victor Horta that was Constructed for Double Function Maurice Frison ( Lawyer of the Court of Belgium) office and living space. Foundation frison Has Continued the double function of Horta with Foundation museum activities and the living space making it a One of a kind in the world \u201cA Living Museum\u201d an Exceptional Unique Time capsule of 19th Century Total Art, Art Nouveau Gem of Victor Horta!\r\n\r\nEntry Fee: 35 Euros (Minimum 2 person)","performers":null,"boxoffice_url":null,"website":"http:\/\/www.foundation-frison-horta.be","email":"contact@foundation-frison-horta.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.545724"},"it":{"name":"Foundation Frison Horta \"A Living museum\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.foundation-frison-horta.be","email":"contact@foundation-frison-horta.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.545724"},"cn":{"name":"Foundation Frison Horta \"A Living museum\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.foundation-frison-horta.be","email":"contact@foundation-frison-horta.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.545724"},"fr":{"name":"Foundation Frison Horta \"A Living museum\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.foundation-frison-horta.be","email":"contact@foundation-frison-horta.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.545724"},"sp":{"name":"Foundation Frison Horta \"A Living museum\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.foundation-frison-horta.be","email":"contact@foundation-frison-horta.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.545724"},"nl":{"name":"Foundation Frison Horta \"A Living museum\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.foundation-frison-horta.be","email":"contact@foundation-frison-horta.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.545724"}},"place":{"id":271767,"translations":{"de":{"name":"Fondation Frison Horta ","address_street_name":"Lebeaustraat","address_street_number":"37","address_street_box":null,"email":"contact@foundation-frison-horta.be","website":"http:\/\/www.foundation-frison-horta.be","phone_contact":"+32 2 330 47 96","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Lebeaustraat, 37","address_line2":"1000 Bruxelles","description_web":"RESTAURIERUNG. BEWAHRUNG. TEILHABE. \r\nDie Stiftung Foundation Frison Horta ist Kultureinrichtung und Kunstzentrum in einem, sie ist ein lebendiges Museum und eine kulturelle Plattform, die die Geschichte des Br\u00fcsseler Kulturguts einem internationalen Publikum n\u00e4herbringt\u2026 und sie ist ein historischer Meilenstein, der die Arbeit von Horta mit Originalmobiliar, dekorativer Kunst, Wandgem\u00e4lden und Fresken in Szene setzt. Sie kooperiert mit anderen multidisziplin\u00e4ren Institutionen und Einrichtungen und geht einen k\u00fcnstlerischen Dialog \u00fcber die Bewahrung und Restaurierung der Geschichte und des Verm\u00e4chtnisses des Jugendstils ein und macht sie der \u00d6ffentlichkeit zug\u00e4nglich. Gleichzeitig dient sie als kultureller Br\u00fcckenschlag zwischen Ost und West und schafft als solcher ein gr\u00f6\u00dferes Verst\u00e4ndnis und ein ausgepr\u00e4gteres Bewusstsein f\u00fcr die reichen kulturellen Traditionen Indiens in Europa und umgekehrt.\r\n\r\nDie Stiftung befindet sich in der Rue Lebeau und wurde 1894 f\u00fcr Georges Frison, einen renommierten Anwalt, erbaut. Das Geb\u00e4ude wird eingefasst von anderen Anwesen im Stile der Neugotik und der Neorenaissance. Vorherrschend sind hier die Themen Natur und Licht, denn die Wandbilder und Fresken mit Motiven aus Flora und Fauna ziehen sich wie ein roter Faden durch das ganze Haus.\r\n\r\nHier offenbart sich eine faszinierende Mischung zwischen einem typischen Br\u00fcsseler Privathaus und dem unverwechselbaren und eleganten Stil von Victor Horta.\r\nDas Haus besticht mit diskreter Eleganz, fernab von jeglicher Extravaganz, und einem feinen Zusammenspiel der wei\u00dfen und blauen Steine.\r\n\r\nF\u00fchrung nur nach Vereinbarung\r\n35 Euro (F\u00fchrung+Exposition)","description_print":"RESTAURIERUNG. BEWAHRUNG. TEILHABE. \r\nDie Stiftung Foundation Frison Horta ist Kultureinrichtung und Kunstzentrum in einem, sie ist ein lebendiges Museum und eine kulturelle Plattform, die die Geschichte des Br\u00fcsseler Kulturguts einem internationalen Publikum n\u00e4herbringt\u2026 und sie ist ein historischer Meilenstein, der die Arbeit von Horta mit Originalmobiliar, dekorativer Kunst, Wandgem\u00e4lden und Fresken in Szene setzt. Sie kooperiert mit anderen multidisziplin\u00e4ren Institutionen und Einrichtungen und geht einen k\u00fcnstlerischen Dialog \u00fcber die Bewahrung und Restaurierung der Geschichte und des Verm\u00e4chtnisses des Jugendstils ein und macht sie der \u00d6ffentlichkeit zug\u00e4nglich. Gleichzeitig dient sie als kultureller Br\u00fcckenschlag zwischen Ost und West und schafft als solcher ein gr\u00f6\u00dferes Verst\u00e4ndnis und ein ausgepr\u00e4gteres Bewusstsein f\u00fcr die reichen kulturellen Traditionen Indiens in Europa und umgekehrt.\r\n\r\nDie Stiftung befindet sich in der Rue Lebeau und wurde 1894 f\u00fcr Georges Frison, einen renommierten Anwalt, erbaut. Das Geb\u00e4ude wird eingefasst von anderen Anwesen im Stile der Neugotik und der Neorenaissance. Vorherrschend sind hier die Themen Natur und Licht, denn die Wandbilder und Fresken mit Motiven aus Flora und Fauna ziehen sich wie ein roter Faden durch das ganze Haus.\r\n\r\nHier offenbart sich eine faszinierende Mischung zwischen einem typischen Br\u00fcsseler Privathaus und dem unverwechselbaren und eleganten Stil von Victor Horta.\r\nDas Haus besticht mit diskreter Eleganz, fernab von jeglicher Extravaganz, und einem feinen Zusammenspiel der wei\u00dfen und blauen Steine.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Fondation Frison Horta ","address_street_name":"Rue Lebeau","address_street_number":"37","address_street_box":null,"email":"contact@foundation-frison-horta.be","website":"http:\/\/www.foundation-frison-horta.be","phone_contact":"+32 2 330 47 96","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Lebeau, 37","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Foundation Frison Horta ","address_street_name":"Rue Lebeau","address_street_number":"37","address_street_box":null,"email":"contact@foundation-frison-horta.be","website":"http:\/\/www.foundation-frison-horta.be","phone_contact":"+32 2 330 47 96","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue Lebeau, 37","address_line2":"1000 Brussels","description_web":"RESTORATION. PRESERVATION. SHARING. \r\nFoundation Frison Horta is a cultural institution and centre for art. It\u2019s a living museum and an organic cultural platform that conveys the story of Brussels\u2019 heritage to a global audience. It is a historical landmark which showcases the work of Horta with original furniture, Art Deco, murals and frescoes. It engages with multidisciplinary institutions and bodies in an artistic dialogue on preserving, restoring and sharing the history and heritage of Art Nouveau while acting as a cultural bridge between east and west that fosters greater understanding and appreciation of the rich cultural traditions of India in Europe and vice versa.\r\n\r\nThe foundation sits in the middle of Rue Lebeau and was built in 1894 for Georges Frison, a renowned lawyer. It sits among Neo-Renaissance and Neo-Gothic mansions, looking like a Neo- Renaissance turret. It is a house of nature and light with murals and frescoes of flora and fauna that engulf the whole house.\r\n\r\nIt shows a fascinating play between the conventional Brussels private house and the bold and elegant style of Victor Horta. \r\nThe house stands out in a discreet way, far from extravagant. Everything is subtle, with the play of blue and white stones.\r\n\r\nGuided visit by appointment only\r\nEntry Fee: 35 Euros (Visit+Exposition)","description_print":"RESTORATION. PRESERVATION. SHARING. \r\nFoundation Frison Horta is a cultural institution and centre for art. It\u2019s a living museum and an organic cultural platform that conveys the story of Brussels\u2019 heritage to a global audience. It is a historical landmark which showcases the work of Horta with original furniture, Art Deco, murals and frescoes. It engages with multidisciplinary institutions and bodies in an artistic dialogue on preserving, restoring and sharing the history and heritage of Art Nouveau while acting as a cultural bridge between east and west that fosters greater understanding and appreciation of the rich cultural traditions of India in Europe and vice versa.\r\n\r\nThe foundation sits in the middle of Rue Lebeau and was built in 1894 for Georges Frison, a renowned lawyer. It sits among Neo-Renaissance and Neo-Gothic mansions, looking like a Neo- Renaissance turret. It is a house of nature and light with murals and frescoes of flora and fauna that engulf the whole house.\r\n\r\nIt shows a fascinating play between the conventional Brussels private house and the bold and elegant style of Victor Horta. \r\nThe house stands out in a discreet way, far from extravagant. Everything is subtle, with the play of blue and white stones.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Fondation Frison Horta ","address_street_name":"Rue Lebeau","address_street_number":"37","address_street_box":null,"email":"contact@foundation-frison-horta.be","website":"http:\/\/www.foundation-frison-horta.be","phone_contact":"+32 2 330 47 96","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Lebeau, 37","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Fondation Frison Horta ","address_street_name":"Rue Lebeau","address_street_number":"37","address_street_box":null,"email":"contact@foundation-frison-horta.be","website":"http:\/\/www.foundation-frison-horta.be","phone_contact":"+32 2 330 47 96","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Lebeau, 37","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Fondation Frison Horta  ","address_street_name":"Rue Lebeau","address_street_number":"37","address_street_box":null,"email":"contact@foundation-frison-horta.be","website":"http:\/\/www.foundation-frison-horta.be","phone_contact":"+32 2 330 47 96","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Lebeau, 37","address_line2":"1000 Bruxelles","description_web":"RESTAURATION. CONSERVATION. PARTAGE. \r\nFondation Frison Horta est une institution culturelle et un centre d'art. C'est un mus\u00e9e vivant et une plateforme culturelle organique qui conte l'histoire du patrimoine bruxellois \u00e0 un public mondial. C'est un point de rep\u00e8re historique qui pr\u00e9sente le travail de Horta avec des meubles originaux, art d\u00e9coratif, des peintures murales et des fresques. Il s\u2019engage aupr\u00e8s d\u2019institutions et d\u2019organismes pluridisciplinaires dans un dialogue artistique sur la conservation, la restauration et le partage de l\u2019histoire et du patrimoine de l\u2019Art nouveau tout en servant de pont culturel entre l\u2019Est et l\u2019Ouest, ce qui favorise une meilleure compr\u00e9hension et appr\u00e9ciation des riches traditions culturelles de l'Inde en Europe et vice versa.\r\n\r\nLa fondation se trouve au milieu de la rue Lebeau et a \u00e9t\u00e9 construite en 1894 pour Georges Frison, un avocat renomm\u00e9. Elle se dresse parmi les manoirs n\u00e9o-renaissance et n\u00e9o-gothique, ressemblant \u00e0 une tourelle n\u00e9o-renaissance. C'est une maison de la nature et de la lumi\u00e8re avec des peintures murales et des fresques de la flore et de la faune qui engloutissent toute la maison.\r\n\r\nCela illustre une pi\u00e8ce fascinante entre la maison priv\u00e9e bruxelloise classique et le style audacieux et \u00e9l\u00e9gant de Victor Horta. \r\nLa maison se distingue de mani\u00e8re discr\u00e8te, loin d'\u00eatre extravagante. Tout est subtil, avec le jeu des pierres bleues et blanches.\r\n\r\nVisite guid\u00e9e uniquement sur rendez-vous\r\nEntr\u00e9e: 35 Eur (visite + exposition)\r\n","description_print":"RESTAURATION. CONSERVATION. PARTAGE. \r\nFondation Frison Horta est une institution culturelle et un centre d'art. C'est un mus\u00e9e vivant et une plateforme culturelle organique qui conte l'histoire du patrimoine bruxellois \u00e0 un public mondial. C'est un point de rep\u00e8re historique qui pr\u00e9sente le travail de Horta avec des meubles originaux, art d\u00e9coratif, des peintures murales et des fresques. Il s\u2019engage aupr\u00e8s d\u2019institutions et d\u2019organismes pluridisciplinaires dans un dialogue artistique sur la conservation, la restauration et le partage de l\u2019histoire et du patrimoine de l\u2019Art nouveau tout en servant de pont culturel entre l\u2019Est et l\u2019Ouest, ce qui favorise une meilleure compr\u00e9hension et appr\u00e9ciation des riches traditions culturelles de l'Inde en Europe et vice versa.\r\n\r\nLa fondation se trouve au milieu de la rue Lebeau et a \u00e9t\u00e9 construite en 1894 pour Georges Frison, un avocat renomm\u00e9. Elle se dresse parmi les manoirs n\u00e9o-renaissance et n\u00e9o-gothique, ressemblant \u00e0 une tourelle n\u00e9o-renaissance. C'est une maison de la nature et de la lumi\u00e8re avec des peintures murales et des fresques de la flore et de la faune qui engloutissent toute la maison.\r\n\r\nCela illustre une pi\u00e8ce fascinante entre la maison priv\u00e9e bruxelloise classique et le style audacieux et \u00e9l\u00e9gant de Victor Horta. \r\nLa maison se distingue de mani\u00e8re discr\u00e8te, loin d'\u00eatre extravagante. Tout est subtil, avec le jeu des pierres bleues et blanches.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Fondation Frison Horta ","address_street_name":"Rue Lebeau","address_street_number":"37","address_street_box":null,"email":"contact@foundation-frison-horta.be","website":"http:\/\/www.foundation-frison-horta.be","phone_contact":"+32 2 330 47 96","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Lebeau, 37","address_line2":"1000 Bruxelles","description_web":"RESTAURACI\u00d3N. PRESERVACI\u00d3N. COMPARTICI\u00d3N.\r\nLa Fundaci\u00f3n Frison Horta es una instituci\u00f3n cultural y un centro de arte. Es un museo vivo y una plataforma cultural org\u00e1nica que transmite la historia del patrimonio cultural de Bruselas a una audiencia internacional. Es un hito hist\u00f3rico que exhibe el trabajo de Horta con mobiliario original, Art Deco, murales y frescos. Tambi\u00e9n colabora con instituciones y organismos multidisciplinarios, entablando un di\u00e1logo art\u00edstico sobre la preservaci\u00f3n, restauraci\u00f3n y compartici\u00f3n de la historia y el patrimonio del Art Nouveau mientras act\u00faa como puente cultural entre este y oeste, promoviendo as\u00ed la comprensi\u00f3n y la apreciaci\u00f3n de la riqueza de las tradiciones culturales de la India en Europa y viceversa.\r\n \r\nLa fundaci\u00f3n est\u00e1 situada en Rue Lebeau y fue construida en 1984 para Georges Frison, un renombrado abogado. Se sit\u00faa entre las mansiones neorrenacentistas y neog\u00f3ticas, parecida a una torre neorrenacentista. Es una casa natural y luminosa con murales y frescos de flora y fauna que envuelven toda la casa.\r\nSe nos muestra una obra fascinante que oscila entre una casa tradicional bruselense y el atrevido y elegante estilo de Victor Horta.\r\nLa casa destaca de manera discreta, lejos de lo extravagante. Todo es sutil, con un juego de piedras azules y blancas.\r\n\r\nVisita guiada s\u00f3lo con cita previa\r\nEntrada: 35 Eur (Visita+Exposici\u00f3n)","description_print":"RESTAURACI\u00d3N. PRESERVACI\u00d3N. COMPARTICI\u00d3N.\r\nLa Fundaci\u00f3n Frison Horta es una instituci\u00f3n cultural y un centro de arte. Es un museo vivo y una plataforma cultural org\u00e1nica que transmite la historia del patrimonio cultural de Bruselas a una audiencia internacional. Es un hito hist\u00f3rico que exhibe el trabajo de Horta con mobiliario original, Art Deco, murales y frescos. Tambi\u00e9n colabora con instituciones y organismos multidisciplinarios, entablando un di\u00e1logo art\u00edstico sobre la preservaci\u00f3n, restauraci\u00f3n y compartici\u00f3n de la historia y el patrimonio del Art Nouveau mientras act\u00faa como puente cultural entre este y oeste, promoviendo as\u00ed la comprensi\u00f3n y la apreciaci\u00f3n de la riqueza de las tradiciones culturales de la India en Europa y viceversa.\r\n \r\nLa fundaci\u00f3n est\u00e1 situada en Rue Lebeau y fue construida en 1984 para Georges Frison, un renombrado abogado. Se sit\u00faa entre las mansiones neorrenacentistas y neog\u00f3ticas, parecida a una torre neorrenacentista. Es una casa natural y luminosa con murales y frescos de flora y fauna que envuelven toda la casa.\r\nSe nos muestra una obra fascinante que oscila entre una casa tradicional bruselense y el atrevido y elegante estilo de Victor Horta.\r\nLa casa destaca de manera discreta, lejos de lo extravagante. Todo es sutil, con un juego de piedras azules y blancas.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Fondation Frison Horta ","address_street_name":"Lebeaustraat","address_street_number":"37","address_street_box":null,"email":"contact@foundation-frison-horta.be","website":"http:\/\/www.foundation-frison-horta.be","phone_contact":"+32 2 330 47 96","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Lebeaustraat, 37","address_line2":"1000 Brussel","description_web":"RESTAUREREN. BEHOUDEN. DELEN.\r\nStichting Frison Horta is een culturele instelling en kunstcentrum. Het is een \u2018levend\u2019 museum en een \u2018organisch\u2019 cultureel platform dat het verhaal van het Brusselse erfgoed overbrengt naar een wereldwijd publiek. Dit historische monument toont het werk van Horta met origineel meubilair, decoratieve kunst en fresco's. Het wil banden smeden met multidisciplinaire instellingen en een artistieke dialoog aangaan over het behouden, restaureren en delen van de geschiedenis en het erfgoed van de Art Nouveau. Het fungeert eveneens als een cultuurbrug tussen Oost en West en hoopt zo in Europa meer begrip en waardering te oogsten voor de rijke culturele tradities van India, en vice versa.\r\nDe stichting bevindt zich in een pand in de Lebeaustraat en werd in 1894 gebouwd voor Georges Frison, een gerenommeerd advocaat. Het gebouw bevindt zich tussen huizen in neorenaissancestijl en neogotische herenhuizen en ziet eruit als een neorenaissancetorentje. Het is een huis vol licht, met een natuurlijk karakter. De muurschilderingen van flora en fauna die overal in het huis te vinden zijn, maker er iets bijzonders van. \r\nDit Hortahuis houdt het midden tussen een klassiek Brussels priv\u00e9huis en een gebouw opgetrokken in de gedurfde en elegante stijl van Victor Horta.\r\nHet huis valt wel op, maar eerder op een discrete manier. Het is verre van extravagant. Met een spel van blauwe en witte stenen, krijgt het geheel een subtiele touch.\r\n\r\nGeleid bezoek enkel op afspraak\r\nToegang: 35 Eur (bezoek + tentoonstelling)","description_print":"RESTAUREREN. BEHOUDEN. DELEN.\r\nStichting Frison Horta is een culturele instelling en kunstcentrum. Het is een \u2018levend\u2019 museum en een \u2018organisch\u2019 cultureel platform dat het verhaal van het Brusselse erfgoed overbrengt naar een wereldwijd publiek. Dit historische monument toont het werk van Horta met origineel meubilair, decoratieve kunst en fresco's. Het wil banden smeden met multidisciplinaire instellingen en een artistieke dialoog aangaan over het behouden, restaureren en delen van de geschiedenis en het erfgoed van de Art Nouveau. Het fungeert eveneens als een cultuurbrug tussen Oost en West en hoopt zo in Europa meer begrip en waardering te oogsten voor de rijke culturele tradities van India, en vice versa.\r\nDe stichting bevindt zich in een pand in de Lebeaustraat en werd in 1894 gebouwd voor Georges Frison, een gerenommeerd advocaat. Het gebouw bevindt zich tussen huizen in neorenaissancestijl en neogotische herenhuizen en ziet eruit als een neorenaissancetorentje. Het is een huis vol licht, met een natuurlijk karakter. De muurschilderingen van flora en fauna die overal in het huis te vinden zijn, maker er iets bijzonders van. \r\nDit Hortahuis houdt het midden tussen een klassiek Brussels priv\u00e9huis en een gebouw opgetrokken in de gedurfde en elegante stijl van Victor Horta.\r\nHet huis valt wel op, maar eerder op een discrete manier. Het is verre van extravagant. Met een spel van blauwe en witte stenen, krijgt het geheel een subtiele touch.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":null,"facebook_id":null,"backoffice_id":31767,"location":{"lat":50.84254568,"lon":4.35402095},"region":"brussels","last_updated_at":"2023-01-23T14:09:11+01:00","published_at":"2018-08-21T10:28:33+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":271767,"translations":{"de":{"name":"Fondation Frison Horta ","address_street_name":"Lebeaustraat","address_street_number":"37","address_street_box":null,"email":"contact@foundation-frison-horta.be","website":"http:\/\/www.foundation-frison-horta.be","phone_contact":"+32 2 330 47 96","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Lebeaustraat, 37","address_line2":"1000 Bruxelles","description_web":"RESTAURIERUNG. BEWAHRUNG. TEILHABE. \r\nDie Stiftung Foundation Frison Horta ist Kultureinrichtung und Kunstzentrum in einem, sie ist ein lebendiges Museum und eine kulturelle Plattform, die die Geschichte des Br\u00fcsseler Kulturguts einem internationalen Publikum n\u00e4herbringt\u2026 und sie ist ein historischer Meilenstein, der die Arbeit von Horta mit Originalmobiliar, dekorativer Kunst, Wandgem\u00e4lden und Fresken in Szene setzt. Sie kooperiert mit anderen multidisziplin\u00e4ren Institutionen und Einrichtungen und geht einen k\u00fcnstlerischen Dialog \u00fcber die Bewahrung und Restaurierung der Geschichte und des Verm\u00e4chtnisses des Jugendstils ein und macht sie der \u00d6ffentlichkeit zug\u00e4nglich. Gleichzeitig dient sie als kultureller Br\u00fcckenschlag zwischen Ost und West und schafft als solcher ein gr\u00f6\u00dferes Verst\u00e4ndnis und ein ausgepr\u00e4gteres Bewusstsein f\u00fcr die reichen kulturellen Traditionen Indiens in Europa und umgekehrt.\r\n\r\nDie Stiftung befindet sich in der Rue Lebeau und wurde 1894 f\u00fcr Georges Frison, einen renommierten Anwalt, erbaut. Das Geb\u00e4ude wird eingefasst von anderen Anwesen im Stile der Neugotik und der Neorenaissance. Vorherrschend sind hier die Themen Natur und Licht, denn die Wandbilder und Fresken mit Motiven aus Flora und Fauna ziehen sich wie ein roter Faden durch das ganze Haus.\r\n\r\nHier offenbart sich eine faszinierende Mischung zwischen einem typischen Br\u00fcsseler Privathaus und dem unverwechselbaren und eleganten Stil von Victor Horta.\r\nDas Haus besticht mit diskreter Eleganz, fernab von jeglicher Extravaganz, und einem feinen Zusammenspiel der wei\u00dfen und blauen Steine.\r\n\r\nF\u00fchrung nur nach Vereinbarung\r\n35 Euro (F\u00fchrung+Exposition)","description_print":"RESTAURIERUNG. BEWAHRUNG. TEILHABE. \r\nDie Stiftung Foundation Frison Horta ist Kultureinrichtung und Kunstzentrum in einem, sie ist ein lebendiges Museum und eine kulturelle Plattform, die die Geschichte des Br\u00fcsseler Kulturguts einem internationalen Publikum n\u00e4herbringt\u2026 und sie ist ein historischer Meilenstein, der die Arbeit von Horta mit Originalmobiliar, dekorativer Kunst, Wandgem\u00e4lden und Fresken in Szene setzt. Sie kooperiert mit anderen multidisziplin\u00e4ren Institutionen und Einrichtungen und geht einen k\u00fcnstlerischen Dialog \u00fcber die Bewahrung und Restaurierung der Geschichte und des Verm\u00e4chtnisses des Jugendstils ein und macht sie der \u00d6ffentlichkeit zug\u00e4nglich. Gleichzeitig dient sie als kultureller Br\u00fcckenschlag zwischen Ost und West und schafft als solcher ein gr\u00f6\u00dferes Verst\u00e4ndnis und ein ausgepr\u00e4gteres Bewusstsein f\u00fcr die reichen kulturellen Traditionen Indiens in Europa und umgekehrt.\r\n\r\nDie Stiftung befindet sich in der Rue Lebeau und wurde 1894 f\u00fcr Georges Frison, einen renommierten Anwalt, erbaut. Das Geb\u00e4ude wird eingefasst von anderen Anwesen im Stile der Neugotik und der Neorenaissance. Vorherrschend sind hier die Themen Natur und Licht, denn die Wandbilder und Fresken mit Motiven aus Flora und Fauna ziehen sich wie ein roter Faden durch das ganze Haus.\r\n\r\nHier offenbart sich eine faszinierende Mischung zwischen einem typischen Br\u00fcsseler Privathaus und dem unverwechselbaren und eleganten Stil von Victor Horta.\r\nDas Haus besticht mit diskreter Eleganz, fernab von jeglicher Extravaganz, und einem feinen Zusammenspiel der wei\u00dfen und blauen Steine.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Fondation Frison Horta ","address_street_name":"Rue Lebeau","address_street_number":"37","address_street_box":null,"email":"contact@foundation-frison-horta.be","website":"http:\/\/www.foundation-frison-horta.be","phone_contact":"+32 2 330 47 96","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Lebeau, 37","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Foundation Frison Horta ","address_street_name":"Rue Lebeau","address_street_number":"37","address_street_box":null,"email":"contact@foundation-frison-horta.be","website":"http:\/\/www.foundation-frison-horta.be","phone_contact":"+32 2 330 47 96","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue Lebeau, 37","address_line2":"1000 Brussels","description_web":"RESTORATION. PRESERVATION. SHARING. \r\nFoundation Frison Horta is a cultural institution and centre for art. It\u2019s a living museum and an organic cultural platform that conveys the story of Brussels\u2019 heritage to a global audience. It is a historical landmark which showcases the work of Horta with original furniture, Art Deco, murals and frescoes. It engages with multidisciplinary institutions and bodies in an artistic dialogue on preserving, restoring and sharing the history and heritage of Art Nouveau while acting as a cultural bridge between east and west that fosters greater understanding and appreciation of the rich cultural traditions of India in Europe and vice versa.\r\n\r\nThe foundation sits in the middle of Rue Lebeau and was built in 1894 for Georges Frison, a renowned lawyer. It sits among Neo-Renaissance and Neo-Gothic mansions, looking like a Neo- Renaissance turret. It is a house of nature and light with murals and frescoes of flora and fauna that engulf the whole house.\r\n\r\nIt shows a fascinating play between the conventional Brussels private house and the bold and elegant style of Victor Horta. \r\nThe house stands out in a discreet way, far from extravagant. Everything is subtle, with the play of blue and white stones.\r\n\r\nGuided visit by appointment only\r\nEntry Fee: 35 Euros (Visit+Exposition)","description_print":"RESTORATION. PRESERVATION. SHARING. \r\nFoundation Frison Horta is a cultural institution and centre for art. It\u2019s a living museum and an organic cultural platform that conveys the story of Brussels\u2019 heritage to a global audience. It is a historical landmark which showcases the work of Horta with original furniture, Art Deco, murals and frescoes. It engages with multidisciplinary institutions and bodies in an artistic dialogue on preserving, restoring and sharing the history and heritage of Art Nouveau while acting as a cultural bridge between east and west that fosters greater understanding and appreciation of the rich cultural traditions of India in Europe and vice versa.\r\n\r\nThe foundation sits in the middle of Rue Lebeau and was built in 1894 for Georges Frison, a renowned lawyer. It sits among Neo-Renaissance and Neo-Gothic mansions, looking like a Neo- Renaissance turret. It is a house of nature and light with murals and frescoes of flora and fauna that engulf the whole house.\r\n\r\nIt shows a fascinating play between the conventional Brussels private house and the bold and elegant style of Victor Horta. \r\nThe house stands out in a discreet way, far from extravagant. Everything is subtle, with the play of blue and white stones.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Fondation Frison Horta ","address_street_name":"Rue Lebeau","address_street_number":"37","address_street_box":null,"email":"contact@foundation-frison-horta.be","website":"http:\/\/www.foundation-frison-horta.be","phone_contact":"+32 2 330 47 96","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Lebeau, 37","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Fondation Frison Horta ","address_street_name":"Rue Lebeau","address_street_number":"37","address_street_box":null,"email":"contact@foundation-frison-horta.be","website":"http:\/\/www.foundation-frison-horta.be","phone_contact":"+32 2 330 47 96","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Lebeau, 37","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Fondation Frison Horta  ","address_street_name":"Rue Lebeau","address_street_number":"37","address_street_box":null,"email":"contact@foundation-frison-horta.be","website":"http:\/\/www.foundation-frison-horta.be","phone_contact":"+32 2 330 47 96","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Lebeau, 37","address_line2":"1000 Bruxelles","description_web":"RESTAURATION. CONSERVATION. PARTAGE. \r\nFondation Frison Horta est une institution culturelle et un centre d'art. C'est un mus\u00e9e vivant et une plateforme culturelle organique qui conte l'histoire du patrimoine bruxellois \u00e0 un public mondial. C'est un point de rep\u00e8re historique qui pr\u00e9sente le travail de Horta avec des meubles originaux, art d\u00e9coratif, des peintures murales et des fresques. Il s\u2019engage aupr\u00e8s d\u2019institutions et d\u2019organismes pluridisciplinaires dans un dialogue artistique sur la conservation, la restauration et le partage de l\u2019histoire et du patrimoine de l\u2019Art nouveau tout en servant de pont culturel entre l\u2019Est et l\u2019Ouest, ce qui favorise une meilleure compr\u00e9hension et appr\u00e9ciation des riches traditions culturelles de l'Inde en Europe et vice versa.\r\n\r\nLa fondation se trouve au milieu de la rue Lebeau et a \u00e9t\u00e9 construite en 1894 pour Georges Frison, un avocat renomm\u00e9. Elle se dresse parmi les manoirs n\u00e9o-renaissance et n\u00e9o-gothique, ressemblant \u00e0 une tourelle n\u00e9o-renaissance. C'est une maison de la nature et de la lumi\u00e8re avec des peintures murales et des fresques de la flore et de la faune qui engloutissent toute la maison.\r\n\r\nCela illustre une pi\u00e8ce fascinante entre la maison priv\u00e9e bruxelloise classique et le style audacieux et \u00e9l\u00e9gant de Victor Horta. \r\nLa maison se distingue de mani\u00e8re discr\u00e8te, loin d'\u00eatre extravagante. Tout est subtil, avec le jeu des pierres bleues et blanches.\r\n\r\nVisite guid\u00e9e uniquement sur rendez-vous\r\nEntr\u00e9e: 35 Eur (visite + exposition)\r\n","description_print":"RESTAURATION. CONSERVATION. PARTAGE. \r\nFondation Frison Horta est une institution culturelle et un centre d'art. C'est un mus\u00e9e vivant et une plateforme culturelle organique qui conte l'histoire du patrimoine bruxellois \u00e0 un public mondial. C'est un point de rep\u00e8re historique qui pr\u00e9sente le travail de Horta avec des meubles originaux, art d\u00e9coratif, des peintures murales et des fresques. Il s\u2019engage aupr\u00e8s d\u2019institutions et d\u2019organismes pluridisciplinaires dans un dialogue artistique sur la conservation, la restauration et le partage de l\u2019histoire et du patrimoine de l\u2019Art nouveau tout en servant de pont culturel entre l\u2019Est et l\u2019Ouest, ce qui favorise une meilleure compr\u00e9hension et appr\u00e9ciation des riches traditions culturelles de l'Inde en Europe et vice versa.\r\n\r\nLa fondation se trouve au milieu de la rue Lebeau et a \u00e9t\u00e9 construite en 1894 pour Georges Frison, un avocat renomm\u00e9. Elle se dresse parmi les manoirs n\u00e9o-renaissance et n\u00e9o-gothique, ressemblant \u00e0 une tourelle n\u00e9o-renaissance. C'est une maison de la nature et de la lumi\u00e8re avec des peintures murales et des fresques de la flore et de la faune qui engloutissent toute la maison.\r\n\r\nCela illustre une pi\u00e8ce fascinante entre la maison priv\u00e9e bruxelloise classique et le style audacieux et \u00e9l\u00e9gant de Victor Horta. \r\nLa maison se distingue de mani\u00e8re discr\u00e8te, loin d'\u00eatre extravagante. Tout est subtil, avec le jeu des pierres bleues et blanches.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Fondation Frison Horta ","address_street_name":"Rue Lebeau","address_street_number":"37","address_street_box":null,"email":"contact@foundation-frison-horta.be","website":"http:\/\/www.foundation-frison-horta.be","phone_contact":"+32 2 330 47 96","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Lebeau, 37","address_line2":"1000 Bruxelles","description_web":"RESTAURACI\u00d3N. PRESERVACI\u00d3N. COMPARTICI\u00d3N.\r\nLa Fundaci\u00f3n Frison Horta es una instituci\u00f3n cultural y un centro de arte. Es un museo vivo y una plataforma cultural org\u00e1nica que transmite la historia del patrimonio cultural de Bruselas a una audiencia internacional. Es un hito hist\u00f3rico que exhibe el trabajo de Horta con mobiliario original, Art Deco, murales y frescos. Tambi\u00e9n colabora con instituciones y organismos multidisciplinarios, entablando un di\u00e1logo art\u00edstico sobre la preservaci\u00f3n, restauraci\u00f3n y compartici\u00f3n de la historia y el patrimonio del Art Nouveau mientras act\u00faa como puente cultural entre este y oeste, promoviendo as\u00ed la comprensi\u00f3n y la apreciaci\u00f3n de la riqueza de las tradiciones culturales de la India en Europa y viceversa.\r\n \r\nLa fundaci\u00f3n est\u00e1 situada en Rue Lebeau y fue construida en 1984 para Georges Frison, un renombrado abogado. Se sit\u00faa entre las mansiones neorrenacentistas y neog\u00f3ticas, parecida a una torre neorrenacentista. Es una casa natural y luminosa con murales y frescos de flora y fauna que envuelven toda la casa.\r\nSe nos muestra una obra fascinante que oscila entre una casa tradicional bruselense y el atrevido y elegante estilo de Victor Horta.\r\nLa casa destaca de manera discreta, lejos de lo extravagante. Todo es sutil, con un juego de piedras azules y blancas.\r\n\r\nVisita guiada s\u00f3lo con cita previa\r\nEntrada: 35 Eur (Visita+Exposici\u00f3n)","description_print":"RESTAURACI\u00d3N. PRESERVACI\u00d3N. COMPARTICI\u00d3N.\r\nLa Fundaci\u00f3n Frison Horta es una instituci\u00f3n cultural y un centro de arte. Es un museo vivo y una plataforma cultural org\u00e1nica que transmite la historia del patrimonio cultural de Bruselas a una audiencia internacional. Es un hito hist\u00f3rico que exhibe el trabajo de Horta con mobiliario original, Art Deco, murales y frescos. Tambi\u00e9n colabora con instituciones y organismos multidisciplinarios, entablando un di\u00e1logo art\u00edstico sobre la preservaci\u00f3n, restauraci\u00f3n y compartici\u00f3n de la historia y el patrimonio del Art Nouveau mientras act\u00faa como puente cultural entre este y oeste, promoviendo as\u00ed la comprensi\u00f3n y la apreciaci\u00f3n de la riqueza de las tradiciones culturales de la India en Europa y viceversa.\r\n \r\nLa fundaci\u00f3n est\u00e1 situada en Rue Lebeau y fue construida en 1984 para Georges Frison, un renombrado abogado. Se sit\u00faa entre las mansiones neorrenacentistas y neog\u00f3ticas, parecida a una torre neorrenacentista. Es una casa natural y luminosa con murales y frescos de flora y fauna que envuelven toda la casa.\r\nSe nos muestra una obra fascinante que oscila entre una casa tradicional bruselense y el atrevido y elegante estilo de Victor Horta.\r\nLa casa destaca de manera discreta, lejos de lo extravagante. Todo es sutil, con un juego de piedras azules y blancas.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Fondation Frison Horta ","address_street_name":"Lebeaustraat","address_street_number":"37","address_street_box":null,"email":"contact@foundation-frison-horta.be","website":"http:\/\/www.foundation-frison-horta.be","phone_contact":"+32 2 330 47 96","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Lebeaustraat, 37","address_line2":"1000 Brussel","description_web":"RESTAUREREN. BEHOUDEN. DELEN.\r\nStichting Frison Horta is een culturele instelling en kunstcentrum. Het is een \u2018levend\u2019 museum en een \u2018organisch\u2019 cultureel platform dat het verhaal van het Brusselse erfgoed overbrengt naar een wereldwijd publiek. Dit historische monument toont het werk van Horta met origineel meubilair, decoratieve kunst en fresco's. Het wil banden smeden met multidisciplinaire instellingen en een artistieke dialoog aangaan over het behouden, restaureren en delen van de geschiedenis en het erfgoed van de Art Nouveau. Het fungeert eveneens als een cultuurbrug tussen Oost en West en hoopt zo in Europa meer begrip en waardering te oogsten voor de rijke culturele tradities van India, en vice versa.\r\nDe stichting bevindt zich in een pand in de Lebeaustraat en werd in 1894 gebouwd voor Georges Frison, een gerenommeerd advocaat. Het gebouw bevindt zich tussen huizen in neorenaissancestijl en neogotische herenhuizen en ziet eruit als een neorenaissancetorentje. Het is een huis vol licht, met een natuurlijk karakter. De muurschilderingen van flora en fauna die overal in het huis te vinden zijn, maker er iets bijzonders van. \r\nDit Hortahuis houdt het midden tussen een klassiek Brussels priv\u00e9huis en een gebouw opgetrokken in de gedurfde en elegante stijl van Victor Horta.\r\nHet huis valt wel op, maar eerder op een discrete manier. Het is verre van extravagant. Met een spel van blauwe en witte stenen, krijgt het geheel een subtiele touch.\r\n\r\nGeleid bezoek enkel op afspraak\r\nToegang: 35 Eur (bezoek + tentoonstelling)","description_print":"RESTAUREREN. BEHOUDEN. DELEN.\r\nStichting Frison Horta is een culturele instelling en kunstcentrum. Het is een \u2018levend\u2019 museum en een \u2018organisch\u2019 cultureel platform dat het verhaal van het Brusselse erfgoed overbrengt naar een wereldwijd publiek. Dit historische monument toont het werk van Horta met origineel meubilair, decoratieve kunst en fresco's. Het wil banden smeden met multidisciplinaire instellingen en een artistieke dialoog aangaan over het behouden, restaureren en delen van de geschiedenis en het erfgoed van de Art Nouveau. Het fungeert eveneens als een cultuurbrug tussen Oost en West en hoopt zo in Europa meer begrip en waardering te oogsten voor de rijke culturele tradities van India, en vice versa.\r\nDe stichting bevindt zich in een pand in de Lebeaustraat en werd in 1894 gebouwd voor Georges Frison, een gerenommeerd advocaat. Het gebouw bevindt zich tussen huizen in neorenaissancestijl en neogotische herenhuizen en ziet eruit als een neorenaissancetorentje. Het is een huis vol licht, met een natuurlijk karakter. De muurschilderingen van flora en fauna die overal in het huis te vinden zijn, maker er iets bijzonders van. \r\nDit Hortahuis houdt het midden tussen een klassiek Brussels priv\u00e9huis en een gebouw opgetrokken in de gedurfde en elegante stijl van Victor Horta.\r\nHet huis valt wel op, maar eerder op een discrete manier. Het is verre van extravagant. Met een spel van blauwe en witte stenen, krijgt het geheel een subtiele touch.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":31767,"location":{"lat":50.84254568,"lon":4.35402095},"last_updated_at":"2023-01-23T14:09:11+01:00","published_at":"2018-08-21T10:28:33+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/0dc791cef74108e1b901d0a9fca02ee0d0a2b7a8.jpg","width":2042,"height":3542,"ratio":0.58,"oEmbed_height":3542,"oEmbed_width":2042,"translations":{"de":{"title":"Foundation Frison Horta \"A Living museum\"","copyright":null},"pt":{"title":"Foundation Frison Horta \"A Living museum\"","copyright":null},"en":{"title":"Foundation Frison Horta \"A Living museum\"","copyright":null},"it":{"title":"Foundation Frison Horta \"A Living museum\"","copyright":null},"cn":{"title":"Foundation Frison Horta \"A Living museum\"","copyright":null},"fr":{"title":"Foundation Frison Horta \"A Living museum\"","copyright":null},"sp":{"title":"Foundation Frison Horta \"A Living museum\"","copyright":null},"nl":{"title":"Foundation Frison Horta \"A Living museum\"","copyright":null}}}],"dates":[],"prices":[{"translations":{"de":{"name":"Normal"},"en":{"name":"Normal"},"it":{"name":"Normale"},"fr":{"name":"Normal"},"sp":{"name":"Normal"},"nl":{"name":"Normaal"}},"value":35}],"date_exceptions":[],"closing_days":[],"child_events":[],"parent_events":[],"accessibilities":[],"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":["annee_art_nouveau"]},{"id":50006762,"date_start":"2024-02-02","date_end":"2024-12-31","date_next":"2024-03-20","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays