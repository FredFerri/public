ueillir des \u00e9quipes jusqu'\u00e0 3 participants ! Le jeu est disponible en Fran\u00e7ais et en Anglais. 60 minutes = 8 manches, chacune avec sa propre r\u00e8gle 150% FUN","performers":null,"boxoffice_url":null,"website":"http:\/\/www.spacefungame.com","email":"info@spacefungame.com","phone_contact":"+32 2 720 01 23","phone_booking":"+32 2 720 01 23","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50006762"},"sp":{"name":"1 H Quiz Game 150% FUN : 2 persons","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.spacefungame.com","email":"info@spacefungame.com","phone_contact":"+32 2 720 01 23","phone_booking":"+32 2 720 01 23","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50006762"},"nl":{"name":"1 U Quiz Game 150% FUN : 2 personen","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.spacefungame.com","email":"info@spacefungame.com","phone_contact":"+32 2 720 01 23","phone_booking":"+32 2 720 01 23","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50006762"}},"place":{"last_updated_at":"2024-01-10T18:56:28+01:00","published_at":"2017-05-30T14:59:45+02:00","id":267946,"translations":{"de":{"name":"Space Fun Games","address_street_name":"Galerie Carrefour Shopping Saint Michel","address_street_number":null,"address_street_box":null,"email":"info@spacefungame.com","website":"http:\/\/www.spacefungame.com","phone_contact":"+32 2 720 01 23","phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Galerie Carrefour Shopping Saint Michel","address_line2":"1040 Etterbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Space Fun Games","address_street_name":"Galerie Carrefour Shopping Saint Michel","address_street_number":null,"address_street_box":null,"email":"info@spacefungame.com",