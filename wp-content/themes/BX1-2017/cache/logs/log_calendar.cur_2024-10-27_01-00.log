un stempel hebben gedrukt. Vlakbij het Stefaniaplein beschikt de galerie over twee verschillende, maar bijna tegenover elkaar liggende ruimtes: de hoofdgalerie bevindt zich in de Isidore Verheydenstraat en het bijgebouw in de Eendrachtsstraat. ","description_print":null,"booking_url":null,"sort_order":"Baronian ","virtual_visit":null,"visit_url":null}},"neca":"gallery","facebook_id":null,"region":"brussels","backoffice_id":1917,"location":{"lat":50.83305444,"lon":4.36110166},"last_updated_at":"2024-08-26T13:57:58+02:00","published_at":"2013-10-19T01:14:44+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/27b82f95cc58d53facd8a9c16582c4afb052710b.jpg","width":1212,"height":1500,"ratio":0.81,"oEmbed_height":1500,"oEmbed_width":1212,"translations":{"de":{"title":"Leen Voet - 'Heilig Graf, landschap en portret'","copyright":"Kristien Daem"},"pt":{"title":"Leen Voet - 'Heilig Graf, landschap en portret'","copyright":"Kristien Daem"},"en":{"title":"Leen Voet - 'Heilig Graf, landschap en portret'","copyright":"Kristien Daem"},"it":{"title":"Leen Voet - 'Heilig Graf, landschap en portret'","copyright":"Kristien Daem"},"cn":{"title":"Leen Voet - 'Heilig Graf, landschap en portret'","copyright":"Kristien Daem"},"fr":{"title":"Leen Voet - 'Heilig Graf, landschap en portret'","copyright":"Kristien Daem"},"sp":{"title":"Leen Voet - 'Heilig Graf, landschap en portret'","copyright":"Kristien Daem"},"nl":{"title":"Leen Voet - 'Heilig Graf, landschap en portret'","copyright":"Kristien Daem"}}}],"dates":[{"day":"2024-09-12","doors":null,"start":"11:00:00","end":"18:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-09-13","doors":null,"start":"11:00:00","end":"18:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-09-14","doors":null,"start":"14:00:00","end":"18:00:00","end_night_life":null,"