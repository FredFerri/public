t":[21],"translations":{"fr":["Sud"],"nl":["Zuid"],"en":["South"]}},"neca":null,"facebook_id":null,"backoffice_id":38763,"location":{"lat":50.83042787,"lon":4.31758035},"region":"brussels","last_updated_at":"2022-06-09T04:35:16+02:00","published_at":"2022-06-08T10:24:09+02:00","import_origin":null,"external_id":null,"is_in_address_book":false,"is_in_vb_export":false,"resto_ranking":0},"organizer":{"id":247123,"translations":{"fr":{"name":"Choux de Bruxelles","address_street_name":"rue Gustave Schildkecht","address_street_number":"33\/3","address_street_box":null,"email":"info@choux.net","website":"http:\/\/www.choux.net","phone_contact":"+32 2 538 94 55","phone_booking":null,"address_zip":"1020","address_city":"Laeken","address_line1":"rue Gustave Schildkecht, 33\/3","address_line2":"1020 Laeken","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Choux de Bruxelles","address_street_name":"Gustave Schildkechtstraat","address_street_number":"33\/3","address_street_box":null,"email":"info@choux.net","website":"http:\/\/www.choux.net","phone_contact":"+32 2 538 94 55","phone_booking":null,"address_zip":"1020","address_city":"Laken","address_line1":"Gustave Schildkechtstraat, 33\/3","address_line2":"1020 Laken","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Choux de Bruxelles","address_street_name":"rue Gustave Schildkecht","address_street_number":"33\/3","address_street_box":null,"email":"info@choux.net","website":"http:\/\/www.choux.net","phone_contact":"+32 2 538 94 55","phone_booking":null,"address_zip":"1020","address_city":"Laeken","address_line1":"rue Gustave Schildkecht, 33\/3","address_line2":"1020 Laeken","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Choux de Bruxelles","address_street_name":"rue Gustave Schildkecht","address_street_number":"33\/3","address_