ui vous fera gagner une pluie de cadeaux.\n\nR\u00e9servations obligatoires & tarifs par adresse mail \u00e0 expressdarouriasbl@gmail.com","performers":null,"boxoffice_url":null,"website":null,"email":"expressdarouriasbl@gmail.com","phone_contact":null,"phone_booking":"+32 470 69 35 15","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700005205"},"sp":{"name":"Soir\u00e9e Combo - SEXPLAY & 20 ans d'EVALUNA","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"expressdarouriasbl@gmail.com","phone_contact":null,"phone_booking":"+32 470 69 35 15","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700005205"},"nl":{"name":"Soir\u00e9e Combo - SEXPLAY & 20 ans d'EVALUNA","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"expressdarouriasbl@gmail.com","phone_contact":null,"phone_booking":"+32 470 69 35 15","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700005205"}},"place":{"id":67,"translations":{"de":{"name":"Petit Th\u00e9\u00e2tre Mercelis","address_street_name":"Rue Mercelis","address_street_number":"13","address_street_box":null,"email":"culture@ixelles.brussels","website":"https:\/\/culture.ixelles.be\/fr\/mercelis\/","phone_contact":"+32 2 515 64 63","phone_booking":"+32 2 515 64 63","address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Mercelis, 13","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Petit Th\u00e9\u00e2tre Mercelis","address_street_name":"Rue Mercelis","address_street_number":"13","address_street_box":null,"email":"culture@ixelles.brussels","website":"https:\/\/culture.ixelles.be\/fr\/mercelis\/","phone_contact":"+32 2 515 64 63","phone_booking":"+32 2 515 64 63","address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Mercelis, 13","addr