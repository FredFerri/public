,"date_end":"2025-05-11","date_next":"2025-02-22","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2025-01-29T09:37:02+01:00","published_at":"2025-01-28T13:53:32+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":317040,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"other","ranking":0.2936303671325454,"languages":{"spoken":["en","fr","nl"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{}},"translations":{"de":{"name":"Playground","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lamaisondesarts.be\/terrain-de-jeux\/","email":"info@lamaisondesarts.be","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 99","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700005900"},"pt":{"name":"Playground","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lamaisondesarts.be\/terrain-de-jeux\/","email":"info@lamaisondesarts.be","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 99","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700005900"},"en":{"name":"Playground","shortdescr":"Exhibition on the theme of games","longdescr":"For the duration of an exhibition, the Maison des Arts is transformed into a playground. This former bourgeois residence becomes a zone of action, bringing together eight artists whose relationship with play is at the heart of their practice. Here, play is seen as a tool to encourage exchange, interaction, fantasy, imagination, participation and cooperation. This playful relationship with creation engenders a kind of desacralization of art. Much more than a simple pastime associated with childhood, play acts here as a metaphor for sociability.\n\nCurator: Nancy Casielles\n\nWith : Denicolai & Provoost, David de Tscharner, Eva Evrard, Floris Hovers, Anna Mancuso, Anna Raimondo and Christophe Terlinden.\n\nOpening: 21.02.2025, 18:00 > 21:00\nExhibition: 22.02 > 11.05.2025\nClosed on 01.05\n\nPhoto copyright: Christophe Terlinden, La voisine, 2024 \/ based on an idea by Jean Glibert. Copyright: Fabrice Kada","performers":null,"boxoffice_url":null,"website":"https:\/\/lamaisondesarts.be\/terrain-de-jeux\/","email":"info@lamaisondesarts.be","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 99","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700005900"},"it":{"name":"Playground","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lamaisondesarts.be\/terrain-de-jeux\/","email":"info@lamaisondesarts.be","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 99","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700005900"},"cn":{"name":"Playground","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lamaisondesarts.be\/terrain-de-jeux\/","email":"info@lamaisondesarts.be","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 99","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700005900"},"fr":{"name":"Terrain de jeux","shortdescr":"Exposition sur la th\u00e9matique du jeu","longdescr":"\nLe temps d\u2019une exposition, la Maison des Arts se transforme en terrain de jeux. Cette ancienne demeure bourgeoise devient une zone d\u2019action r\u00e9unissant huit artistes dont le rapport au jeu s\u2019inscrit au c\u0153ur de la pratique. Le jeu est ici envisag\u00e9 comme un outil afin de favoriser l\u2019\u00e9change, l\u2019interaction, la fantaisie, l\u2019imagination, la participation et la coop\u00e9ration. Ce rapport ludique \u00e0 la cr\u00e9ation engendre une forme de d\u00e9sacralisation de l\u2019Art. Bien plus qu\u2019un simple loisir associ\u00e9 \u00e0 l\u2019enfance, le jeu agit ici comme une m\u00e9taphore de la sociabilit\u00e9.\n\nCuratrice: Nancy Casielles\n\nAvec : Denicolai & Provoost, David de Tscharner, Eva Evrard, Floris Hovers, Anna Mancuso, Anna Raimondo et Christophe Terlinden.\n\n \n\nVernissage: 21.02.2025, 18:00 > 21:00\nExposition: 22.02 > 11.05.2025\nFerm\u00e9 le 01.05\n\nCopyright photo: Christophe Terlinden, La voisine, 2024 \/ d\u2019apr\u00e8s une id\u00e9e de Jean Glibert. Copyright: Fabrice Kada","performers":null,"boxoffice_url":null,"website":"https:\/\/lamaisondesarts.be\/terrain-de-jeux\/","email":"info@lamaisondesarts.be","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 99","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700005900"},"sp":{"name":"Playground","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lamaisondesarts.be\/terrain-de-jeux\/","email":"info@lamaisondesarts.be","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 99","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700005900"},"nl":{"name":"Speelterrein","shortdescr":"Tentoonstelling over het thema spelen","longdescr":"\nE\u00e9n tentoonstelling lang wordt La Maison des Arts een speelterrein. Deze voormalige burgerwoning ontpopt zich tot een actieterrein. Het verenigt acht kunstenaars die spel centraal plaatsen in hun werk. Het wordt hier gebruikt als een instrument om uitwisselingen, interacties, de verbeelding, deelname en samenwerking te stimuleren. Die speelse vorm van cre\u00ebren leidt tot een soort van ontheiliging van kunst. Het spel wordt hier zoveel meer dan tijdverdrijf voor kinderen. Het wordt een metafoor voor gezelligheid.\n\nCurator: Nancy Casielles\n\nMet : Denicolai & Provoost, David de Tscharner, Eva Evrard, Floris Hovers, Anna Mancuso, Anna Raimondo et Christophe Terlinden.\n\n \n\nOpening: 21.02.2025, 18:00 > 21:00\nTentoonstelling: 22.02 > 11.05.2025\nGesloten op 01.05\n\nCopyright foto: Christophe Terlinden, La voisine, 2024 \/ naar een idee de Jean Glibert. Copyright: Fabrice Kada","performers":null,"boxoffice_url":null,"website":"https:\/\/lamaisondesarts.be\/terrain-de-jeux\/","email":"info@lamaisondesarts.be","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 99","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700005900"}},"place":{"id":222932,"translations":{"de":{"name":"Maison des Arts","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 147","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Maison des Arts","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 147","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Maison des Arts","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 147","address_line2":"1030 Schaerbeek","description_web":"The MdA is run and staffed by the Francophone Cultural Service of Schaerbeek Council and is a unique place whose activities are mainly concerned with the creation of works of contemporary art with a significant partnership programme that promotes access for all to contemporary art.\r\n\r\nThe MdA has hosted a rich programme of artistic activities since the 1950s when the building was purchased by Schaerbeek Council. In 2005, the MdA began a programme of inviting artists to work in building, to build more coherence between their works of art and the MdA.\r\n\r\nMost recently, in 2016, Schaerbeek Council decided to position the MdA as a centre for the creation, diffusion and promotion of culture, contemporary two-dimensional, three-dimensional and digital art.\r\nThe MdA\u2019s educational and social approach aims to promoting equality of access to art and its introduction to new audiences.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Maison des Arts","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 147","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Maison des Arts","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 147","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Maison des Arts","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 147","address_line2":"1030 Schaerbeek","description_web":"La Maison des Arts, anim\u00e9e par le Service Culture fran\u00e7aise de la Commune de Schaerbeek, est un espace singulier dont les activit\u00e9s sont principalement ax\u00e9es sur la cr\u00e9ation contemporaine dans le domaine des arts plastiques avec un important programme de m\u00e9diation permettant l\u2019acc\u00e8s de l\u2019art contemporain \u00e0 tous.\r\n\r\nLa MA conna\u00eet une riche activit\u00e9 artistique depuis les ann\u00e9es \u201950, \u00e9poque \u00e0 laquelle la commune rach\u00e8te le b\u00e2timent. En 2005, elle se voit prendre un premier tournant en proposant aux artistes de travailler in situ, afin d\u2019\u00e9tablir une r\u00e9elle coh\u00e9rence entre l\u2019\u0153uvre et la Maison.\r\nEt finalement, c\u2019est en 2016 que la Commune de Schaerbeek d\u00e9cide de la positionner dans le domaine des arts plastiques, contemporains et num\u00e9riques comme un lieu de cr\u00e9ation, de diffusion et de rayonnement culturel.\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Maison des Arts","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 147","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Huis der Kunsten","address_street_name":"Haachtsesteenweg","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaarbeek","address_line1":"Haachtsesteenweg, 147","address_line2":"1030 Schaarbeek","description_web":"La Maison des Arts, geanimeerd door de dienst Franstalige Cultuur van de gemeente Schaarbeek, is een heel bijzondere plek. De activiteiten zijn vooral gericht op hedendaagse creativiteit in de plastische kunsten.\r\n\r\nIn La Maison des Arts heerst reeds sedert 1950 ( datum waarop de gemeente het huis aankocht) een ruime artistieke activiteit. In 2005 is er een belangrijke ontwikkeling : het voorstel aan de kunstenaars om ter plaatse te werken, teneinde een echte samenhang te bereiken tussen het werk en het Huis. Uiteindelijk beslist de Gemeente Schaarbeek er een echte broeikast van te maken in het domein van de beeldende kunsten, een bron van schepping, verspreiding en culturele uitstraling.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[20],"translations":{"de":["Norden"],"pt":[null],"en":["North"],"it":["Nord"],"cn":[null],"fr":["Nord"],"sp":["Norte"],"nl":["Noord"]}},"neca":null,"facebook_id":null,"backoffice_id":663,"location":{"lat":50.85951067,"lon":4.37063079},"region":"brussels","last_updated_at":"2022-11-09T13: