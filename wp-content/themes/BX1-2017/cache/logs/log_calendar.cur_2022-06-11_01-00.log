":"2022-06-09T01:08:17+02:00","published_at":"2022-06-07T11:06:44+02:00","backoffice_id":255467,"import_origin":null,"sub_type":"other","show_in_agenda":true,"ranking":0.23017706561203},{"id":509486,"date_start":"2021-03-04","date_end":"2022-08-31","date_next":"2022-06-11","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{"list":[112],"translations":{"fr":["Insolite"],"nl":["Ongewoon"],"en":["Unusual"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Bruxelles : 1000 Ans de Luttes","shortdescr":"Revivez, le temps d\u2019une balade pittoresque dans les ruelles \u00e9troites des Marolles, les grandes luttes sociales qui ont fait de Bruxelles ce qu\u2019elle est aujourd\u2019hui.","longdescr":"- Visite guid\u00e9e \u00e0 prix libre : Payez, \u00e0 la fin du tour, le prix qui vous semble juste -\r\n\r\nRevivez les grandes luttes sociales qui ont transform\u00e9 la ville au fil des si\u00e8cles.\r\n\r\nNous vous pr\u00e9sentons, au cours d\u2019une balade ludique et instructive, quelques lieux embl\u00e9matiques d\u2019un quartier qui n\u2019a jamais courb\u00e9 l\u2019\u00e9chine face \u00e0 l\u2019oppresseur et face aux menaces de toutes natures. Laissez-nous vous montrer Bruxelles la Rebelle\u2026\r\n\r\nQU\u2019ALLEZ-VOUS D\u00c9COUVRIR ?\r\n\r\nLe tour \u201c1000 Ans de Luttes\u201c, qui sillonne le quartier des Marolles, vous fait d\u00e9couvrir, sur un ton ludique et amusant, les nombreuses luttes sociales qui y ont pris place ; Certaines tr\u00e8s anciennes, d\u2019autres plus r\u00e9centes\u2026\r\n\r\nLa visite passe par quelques lieux incontournables du quartier, mais vous ferez aussi la d\u00e9couverte de plusieurs ruelles et impasses moins connues.\r\n\r\nAu programme, entre autres\u2026\r\n\u2013 La Bataille des Marolles, de 1969\r\n\u2013 La Guerre des Matelas, de 1989\r\n\u2013 Le Palais de Justice, le chantier \u00e9ternel\r\n\u2013 Des anecdotes et des histoires croustillantes\r\n\u2013 La Place du Jeu de Balle et son March\u00e9 aux Puces quotidien\r\n\u2013 Des vues imprenables sur la ville\r\n\u2013 \u2026\r\n\r\nINFORMATIONS PRATIQUES\r\nTours r\u00e9guliers en fran\u00e7ais, anglais et n\u00e9erlandais :\r\nPrix  : Libre et conscient*\r\nDur\u00e9e : Environ 2 heures\r\nRendez-vous : Place de la Chapelle (sur les marches de l\u2019\u00c9glise), 1000 Bruxelles\r\nFin du tour : Place du Jeu de Balle\r\n\r\nTour priv\u00e9 sur demande en fran\u00e7ais, n\u00e9erlandais, anglais ou espagnol : info@brusselsbyfoot.com","performers":"Visitez le quartier le plus rebelle de Bruxelles !","boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/bruxelles-1000-ans-de-luttes\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/509486.html"},"nl":{"name":"Bruxelles : 1000 Ans de Luttes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/509486.html"},"en":{"name":"Bruxelles : 1000 Ans de Luttes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/509486.html"},"de":{"name":"Bruxelles : 1000 Ans de Luttes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/509486.html"},"it":{"name":"Br