,"doors":null,"start":"18:30:00","end":"22:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"de":{"name":"Normal"},"en":{"name":"Normal"},"it":{"name":"Normale"},"fr":{"name":"Normal"},"sp":{"name":"Normal"},"nl":{"name":"Normaal"}},"value":0}],"date_exceptions":[],"closing_days":[],"child_events":[],"parent_events":[],"accessibilities":[],"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[]},{"id":5700007399,"date_start":"2025-03-28","date_end":"2025-03-28","date_next":"2025-03-28","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2025-03-21T13:07:13+01:00","published_at":"2025-03-06T13:53:31+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":319476,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"other","ranking":1.2599210498948732,"languages":{"spoken":["fr","en","nl"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exposici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[39,36],"translations":{"de":["Fotografie","Museen & Kunstzentren"],"pt":[null,null],"en":["Photography","Museums and art centers"],"it":["Fotografia","Musei e centri artistici"],"cn":[null,null],"fr":["Photographie","Mus\u00e9es et art centers"],"sp":["Fotograf\u00eda","Museos y centros de arte"],"nl":["Fotografie","Musea en kunstcentra"]}}},"translations":{"de":{"name":"Exhibition Opening Party of \u2018Presence of the Past \u2013 a European Album\u2019","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/historia.europa.eu\/fr\/expositions-et-evenements\/evenements\/soiree-vernissage-exposition-passe-compose","email":"Historia-learning@europarl.europa.eu","phone_contact":"+32 2 283 12 20","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700007399"},"pt":{"name":"Exhibition Opening Party of \u2018Presence of the Past \u2013 a European Album\u2019","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/historia.europa.eu\/fr\/expositions-et-evenements\/evenements\/soiree-vernissage-exposition-passe-compose","email":"Historia-learning@europarl.europa.eu","phone_contact":"+32 2 283 12 20","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700007399"},"en":{"name":"Exhibition Opening Party of \u2018Presence of the Past \u2013 a European Album\u2019","shortdescr":"Join us for the exhibition opening party with a vibrant DJ performance, the chance to meet the talented photographers behind the exhibition, enjoy delicious drinks with friends, get creative in a photo collage workshop, contribute to a dynamic photo mosaic, and much more.\n","longdescr":"The exhibition showcases 21 documentary photography projects from across Europe, exploring the many ways Europeans connect with the past in their daily lives. From commemorating historical events to participating in re-enactments, from taking tourist selfies to degrading monuments, from digging up forgotten pasts to keeping private collections, come and discover the diverse and sometimes surprising ways people interact with history The exhibition also features works by photography students from La Cambre Art School, who challenge and expand the exhibition\u2019s narrative through their own perspectives.\n\nThe programme\n\n18.00 to 00.30: DJ Sets by BEA - Dance through time with a DJ set that samples decades of music, creating a groovy memory journey. Location: 1st floor, Fresco Room.\n\n18.00 to 00.30: Bar - Enjoy a free drink after cracking the \u201cLook & Sip\u201d game, with additional drinks available for purchase. Bar run by Chemistry and Botanics. - Location: 1st floor, between the Fresco and Graffiti rooms.\n\n18.00 to 00.30: Mosaic Photo Studio - Capture the moment and contribute to the bigger picture! Location: 1st floor, Graffiti Room\n\n18.00 to 00.30: Quiet Zone - Need a break from the hustle? Visit the Quiet Zone for a surprise activity.\nLocation: Ground floor, next to the shop | Cafeteria\n\n18.30 to 22.30: Meet the Photographers. Engage with the photographers and discuss their work in the exhibition. Sofia Yala, V\u00e9ronique Ellena, Petru\u021b C\u0103linescu, Hugo Passarello Luna, Jan Kempenaers, Elizar Veerman, Samuel Aranda & Marc Wilson will be present during the event. Location: Ground and 1st floors | Exhibition space\n\n19.00 to 22.00: \u2018Anachronic Landscapes\u2019 \u2013 Photo Collage Workshop. Blend eras, mix histories, and craft unique landscapes using archival images and different elements of some photographs from 'Presence of the Past'. Let your imagination reshape time! Workshop with Oiseaux Sans T\u00eate. Location: 1st floor, Fresco Room.\n\n20.00 to 21.00: Picture It! Get involved in a participatory photo project. Location: Ground floor, next to the bookshop | Cafeteria","performers":null,"boxoffice_url":null,"website":"https:\/\/historia.europa.eu\/en\/exhibitions-events\/events\/exhibition-opening-party-presence-of-the-past","email":"Historia-learning@europarl.europa.eu","phone_contact":"+32 2 283 12 20","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700007399"},"it":{"name":"Exhibition Opening Party of \u2018Presence of the Past \u2013 a European Album\u2019","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/historia.europa.eu\/fr\/expositions-et-evenements\/evenements\/soiree-vernissage-exposition-passe-compose","email":"Historia-learning@europarl.europa.eu","phone_contact":"+32 2 283 12 20","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700007399"},"cn":{"name":"Exhibition Opening Party of \u2018Presence of the Past \u2013 a European Album\u2019","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/historia.europa.eu\/fr\/expositions-et-evenements\/evenements\/soiree-vernissage-exposition-passe-compose","email":"Historia-learning@europarl.europa.eu","phone_contact":"+32 2 283 12 20","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700007399"},"fr":{"name":"Soir\u00e9e de vernissage de l'exposition \u00ab Pass\u00e9 compos\u00e9. Un album europ\u00e9en \u00bb","shortdescr":"Venez danser au rythme de DJ BEA, rencontrer quelques-unes et uns des photographes talentueux \u00e0 l'origine de l'exposition, profiter de d\u00e9licieux rafra\u00eechissements, participer \u00e0 un atelier de collage photo, ou encore contribuer \u00e0 cr\u00e9er une mosa\u00efque.","longdescr":"L'exposition pr\u00e9sente 21 projets de photographie documentaire provenant de toute l'Europe, explorant les nombreuses fa\u00e7ons dont les Europ\u00e9ennes et Europ\u00e9ens interagissent avec le pass\u00e9 au quotidien : de la comm\u00e9moration d'\u00e9v\u00e9nements historiques \u00e0 la participation \u00e0 des reconstitutions, de la prise de selfies touristiques \u00e0 la d\u00e9gradation de monuments, de l'exhumation d'un pass\u00e9 oubli\u00e9 \u00e0 la conservation de collections priv\u00e9es. L'exposition pr\u00e9sente \u00e9galement des \u0153uvres d'\u00e9tudiantes et \u00e9tudiants en photographie de l'\u00e9cole d'art de La Cambre, qui questionnent et \u00e9largissent le r\u00e9cit de l'exposition \u00e0 travers leurs propres perspectives.\n\nLe programme\n\n18h00 \u00e0 00h30 : DJ Sets by BEA. Dansez \u00e0 travers le temps avec un DJ set qui mixera des d\u00e9cennies musicales. Lieu : 1er \u00e9tage, salle Fresco\n\n18h00 \u00e0 00h30 : Bar. Profitez d'une boisson gratuite apr\u00e8s avoir r\u00e9ussi le jeu \u00ab Look & Sip \u00bb. Des boissons suppl\u00e9mentaires seront disponibles \u00e0 l'achat. Bar par Chemistry and Botanics. Lieu : 1er \u00e9tage, entre la salle avec les fresques et celle avec les graffiti.\n\n18h00 \u00e0 00h30 : Mosaic Studio Photo. Capturez le moment pr\u00e9sent et contribuez \u00e0 la mosa\u00efque collective ! Lieu : 1er \u00e9tage, salle avec les graffiti.\n\n18h00 \u00e0 00h30 : Coin Calme. Besoin d'une pause ? Rendez-vous dans le Coin Calme pour une activit\u00e9 surprise en toute tranquillit\u00e9. Lieu : Rez-de-chauss\u00e9e, \u00e0 c\u00f4t\u00e9 de la boutique | Caf\u00e9t\u00e9ria. 18h30 \u00e0 22h30 : Rencontre avec les photographes\n\nDiscutez avec les photographes de leur travail dans le cadre de l'exposition. Sofia Yala, V\u00e9ronique Ellena, Petru\u021b C\u0103linescu, Hugo Passarello Luna, Jan Kempenaers, Elizar Veerman, Samuel Aranda et Marc Wilson seront pr\u00e9sents lors de cet \u00e9v\u00e9nement. Lieu : Rez-de-chauss\u00e9e et 1er \u00e9tage | Espace d'exposition\n\n19h00 \u00e0 22h00 : 'Paysages anachroniques' \u2013 Atelier de collage photo. M\u00e9langez les \u00e9poques, les histoires et cr\u00e9ez des paysages uniques \u00e0 l'aide d'images d'archives et de diff\u00e9rents \u00e9l\u00e9ments de certaines photographies de \u00ab Pass\u00e9 compos\u00e9 \u00bb. Laissez votre imagination remodeler le temps ! Atelier avec Oiseaux Sans T\u00eate. Location: 1st floor, Fresco Room. 20h00 \u00e0 21h00 : Picture It! Participez \u00e0 un projet photographique participatif. Emplacement : Rez-de-chauss\u00e9e, \u00e0 c\u00f4t\u00e9 de la librairie | Caf\u00e9t\u00e9ria.\n\n20h00 \u00e0 21h00 : Picture It! Participez \u00e0 un projet photographique participatif. Emplacement : Rez-de-chauss\u00e9e, \u00e0 c\u00f4t\u00e9 de la librairie | Caf\u00e9t\u00e9ria.","performers":null,"boxoffice_url":null,"website":"https:\/\/historia.europa.eu\/fr\/expositions-et-evenements\/evenements\/soiree-vernissage-exposition-passe-compose","email":"Historia-learning@europarl.europa.eu","phone_contact":"+32 2 283 12 20","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700007399"},"sp":{"name":"Exhibition Opening Party of \u2018Presence of the Past \u2013 a European Album\u2019","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/historia.europa.eu\/fr\/expositions-et-evenements\/evenements\/soiree-vernissage-exposition-passe-compose","email":"Historia-learning@europarl.europa.eu","phone_contact":"+32 2 283 12 20","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700007399"},"nl":{"name":"Openingsfeest van \u2018Onvoltooid verleden. Een Europees album\u2019","shortdescr":"Kom naar het openingsfeest van de tentoonstelling met een bruisend optreden van een DJ, de kans om de getalenteerde fotografen achter de tentoonstelling te ontmoeten, te genieten van heerlijke drankjes met vrienden, creatief aan de slag te gaan in een fotocollageworkshop, bij te dragen aan een dynamisch fotomoza\u00efek en nog veel meer.","longdescr":"De tentoonstelling toont 21 documentaire fotoprojecten uit heel Europa, waarin de vele manieren worden onderzocht waarop Europeanen in hun dagelijks leven in contact komen met het verleden. Kom en ontdek hoe Europeanen zich op verschillende en soms verrassende manieren met geschiedenis bezighouden, van het herdenken van historische gebeurtenissen tot het deelnemen aan re-enactments, van het nemen van toeristische selfies tot het vernielen van monumenten, van het opgraven van vergeten verledens tot het bijhouden van priv\u00e9verzamelingen. De tentoonstelling bevat ook werk van fotografiestudenten van La Cambre Art School, die het verhaal van de tentoonstelling uitdagen en uitbreiden met hun eigen perspectieven.\n\nHet programma\n\n18.00 tot 00.30: DJ-sets door BEA. Dans door de tijd met een DJ-set die decennia aan muziek samplet en zo een groovy herinneringsreis cre\u00ebert. Locatie: 1e verdieping, Frescokamer\n\n18.00 tot 00.30: Bar. Geniet van een gratis drankje nadat je het \u201cLook & Sip\u201d spel hebt gekraakt, met extra drankjes die je kunt kopen. Bar door Chemistry and Botanics. Locatie: 1e verdieping, tussen de Fresco- en Graffitikamers. \n\n18.00 tot 00.30: Moza\u00efek fotostudio. Leg het moment vast en draag bij aan het grotere geheel! Locatie: 1e verdieping, Graffiti ruimte.\n\n18.00 tot 00.30: Rustige zone. Even weg uit de drukte? Bezoek de Rustige Zone voor een verrassingsactiviteit. Locatie: Begane grond, naast de boekwinkel | Cafetaria\n\n18.30 tot 22.30: Ontmoet de fotografen. Ontmoet de fotografen en bespreek hun werk in de tentoonstelling. Sofia Yala, V\u00e9ronique Ellena, Petru\u021b C\u0103linescu, Hugo Passarello Luna, Jan Kempenaers, Elizar Veerman, Samuel Aranda & Marc Wilson zullen aanwezig zijn tijdens het evenement. Locatie: Begane grond en 1e verdieping | Expositieruimte\n\n19.00 tot 22.00: 'Anachronic Landscapes' - Fotocollageworkshop. Meng tijdperken, vermeng geschiedenissen en cre\u00eber unieke landschappen met behulp van archiefbeelden en verschillende elementen van enkele foto's uit \u2018Onvoltooid verleden\u2019. Laat je verbeelding de tijd een nieuwe vorm geven! Fotocollageworkshop met Oiseaux Sans T\u00eate. Locatie: 1e verdieping, Frescokamer\n\n20.00 tot 21.00 uur: Picture It! Doe mee aan een participatief fotoproject. Locatie: Begane grond, naast de boekwinkel | Cafetaria.\n","performers":null,"boxoffice_url":null,"website":"https:\/\/historia.europa.eu\/nl\/tentoonstellingen-en-evenementen\/evenementen\/tentoonstelling-openingsfeest-onvoltooid-verleden","email":"Historia-learning@europarl.europa.eu","phone_contact":"+32 2 283 12 20","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700007399"}},"place":{"id":267078,"translations":{"de":{"name":"Haus der Europ\u00e4ischen Geschichte","address_street_name":"Rue Belliard","address_street_number":"135","address_street_box":null,"email":"historia-learning@europarl.europa.eu","website":"https:\/\/historia.europa.eu\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Belliard, 135","address_line2":"1000 Bruxelles","description_web":"Das Haus der Europ\u00e4ischen Geschichte, das in dem pr\u00e4chtigen, frisch renovierten Eastman-Geb\u00e4ude untergebracht ist, zeichnet die europ\u00e4ische Geschichte und die Zukunft Europas anhand von unz\u00e4hligen Ausstellungsst\u00fccken aus den 28 Mitgliedstaaten der EU nach. Der Eintritt ist frei.\nIn den 24 Amtssprachen der Europ\u00e4ischen Union offenbart es die Geschichte Europas \u2013 von den europ\u00e4ischen Mythen und Entdeckungen, \u00fcber das Chaos und die Kriegswirren bis hin zur allm\u00e4hlichen Entwicklung eines Zugeh\u00f6rigkeitsgef\u00fchls im Laufe des 20. Jahrhunderts. Dabei wird der Besucher angeregt, die Dinge zu hinterfragen und sowohl die Vergangenheit als auch die Zukunft zu betrachten und zu analysieren. Das Haus der Europ\u00e4ischen Geschichte bietet speziell zugeschnittene Programme f\u00fcr Schulen, Familien und Gruppen. Der Eintritt ist frei.\n\nDauerausstellung: Die Dauerausstellung l\u00e4sst die gro\u00dfen Ereignisse der europ\u00e4ischen Geschichte Revue passieren und legt dabei zun\u00e4chst einen Schwerpunkt auf die im 19. Jahrhundert vorherrschenden Ideen und \u00dcberzeugungen. N\u00e4chster thematischer Schwerpunkt sind die zerst\u00f6rerischen Kriege, die Europa ersch\u00fctterten, bevor die Ausstellung sich schlie\u00dflich der europ\u00e4ischen Einigung zuwendet, die den Europ\u00e4ern eine friedlichere Zukunft sichern sollte. Das Museum regt die Besucher zum Nachdenken an \u2013 \u00fcber das heutige Europa und seine Rolle in der Welt und die M\u00f6glichkeit jedes einzelnen Europ\u00e4ers, die Zukunft des Kontinents mitzugestalten.\n\nP\u00e4dagogische Angebote und Fortbildungen: Das Haus der europ\u00e4ischen Geschichte hat eine Reihe von p\u00e4dagogischen Angeboten ausgearbeitet, die die Besichtigung zu einem echten Erlebnis machen: interaktive Pr\u00e4sentationen, Ausstellungsgegenst\u00e4nde, Multimedia-Guides, Ausstellungen, Workshops und Seminare, die den Besucher dazu anregen, seine bisherige Wahrnehmung der europ\u00e4ischen Geschichte und ihren Einfluss auf die heutige Welt zu hinterfragen.\n\nEin herausragendes Bauwerk: Das Eastman-Geb\u00e4ude, das sich im Schatten der B\u00e4ume des majest\u00e4tischen Parc L\u00e9opold erhebt, ist eine Perle des Art D\u00e9co. Hier war bis vor Kurzem noch eine Zahnklinik f\u00fcr sozial benachteiligte Kinder untergebracht, jetzt wurde das Bauwerk bis ins letzte Detail restauriert. Besonders sch\u00f6n sind dabei die Wandfresken in Anlehnung an die Fabeln von Jean de la Fontaine, die nun wieder in altem Glanz erstrahlen. Und nach der Besichtigung laden die Parkb\u00e4nke des Parc L\u00e9opold zum Picknicken und Verweilen ein. ","description_print":"Das Haus der Europ\u00e4ischen Geschichte, das in dem pr\u00e4chtigen, frisch renovierten Eastman-Geb\u00e4ude untergebracht ist, zeichnet die europ\u00e4ische Geschichte und die Zukunft Europas anhand von unz\u00e4hligen Ausstellungsst\u00fccken aus den 28 Mitgliedstaaten der EU nach. Der Eintritt ist frei.\r\nIn den 24 Amtssprachen der Europ\u00e4ischen Union offenbart es die Geschichte Europas \u2013 von den europ\u00e4ischen Mythen und Entdeckungen, \u00fcber das Chaos und die Kriegswirren bis hin zur allm\u00e4hlichen Entwicklung eines Zugeh\u00f6rigkeitsgef\u00fchls im Laufe des 20. Jahrhunderts. Dabei wird der Besucher angeregt, die Dinge zu hinterfragen und sowohl die Vergangenheit als auch die Zukunft zu betrachten und zu analysieren. Das Haus der Europ\u00e4ischen Geschichte bietet speziell zugeschnittene Programme f\u00fcr Schulen, Familien und Gruppen. Der Eintritt ist frei.\r\n\r\nDauerausstellung: Die Dauerausstellung l\u00e4sst die gro\u00dfen Ereignisse der europ\u00e4ischen Geschichte Revue passieren und legt dabei zun\u00e4chst einen Schwerpunkt auf die im 19. Jahrhundert vorherrschenden Ideen und \u00dcberzeugungen. N\u00e4chster thematischer Schwerpunkt sind die zerst\u00f6rerischen Kriege, die Europa ersch\u00fctterten, bevor die Ausstellung sich schlie\u00dflich der europ\u00e4ischen Einigung zuwendet, die den Europ\u00e4ern eine friedlichere Zukunft sichern sollte. Das Museum regt die Besucher zum Nachdenken an \u2013 \u00fcber das heutige Europa und seine Rolle in der Welt und die M\u00f6glichkeit jedes einzelnen Europ\u00e4ers, die Zukunft des Kontinents mitzugestalten.\r\n\r\nP\u00e4dagogische Angebote und Fortbildungen: Das Haus der europ\u00e4ischen Geschichte hat eine Reihe von p\u00e4dagogischen Angeboten ausgearbeitet, die die Besichtigung zu einem echten Erlebnis machen: interaktive Pr\u00e4sentationen, Ausstellungsgegenst\u00e4nde, Multimedia-Guides, Ausstellungen, Workshops und Seminare, die den Besucher dazu anregen, seine bisherige Wahrnehmung der europ\u00e4ischen Geschichte und ihren Einfluss auf die heutige Welt zu hinterfragen.\r\n\r\nEin herausragendes Bauwerk: Das Eastman-Geb\u00e4ude, das sich im Schatten der B\u00e4ume des majest\u00e4tischen Parc L\u00e9opold erhebt, ist eine Perle des Art D\u00e9co. Hier war bis vor Kurzem noch eine Zahnklinik f\u00fcr sozial benachteiligte Kinder untergebracht, jetzt wurde das Bauwerk bis ins letzte Detail restauriert. Besonders sch\u00f6n sind dabei die Wandfresken in Anlehnung an die Fabeln von Jean de la Fontaine, die nun wieder in altem Glanz erstrahlen. Und nach der Besichtigung laden die Parkb\u00e4nke des Parc L\u00e9opold zum Picknicken und Verweilen ein. \r\n\r\n","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Maison de l'Histoire europ\u00e9enne","address_street_name":"Rue Belliard","address_street_number":"135","address_street_box":null,"email":"historia-learning@europarl.europa.eu","website":"https:\/\/historia.europa.eu\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Belliard, 135","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"House of European History","address_street_name":"Belliardstraat","address_street_number":"135","address_street_box":null,"email":"historia-learning@europarl.europa.eu","website":"https:\/\/historia.europa.eu\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Belliardstraat, 135","address_line2":"1000 Brussels","description_web":"Get ready for a journey like no other! \nThe permanent exhibition begins with the myth of the goddess Europa, exploring Europe\u2019s ancient roots and the continent\u2019s heritage of shared traditions, before Europe\u2019s dramatic journey towards modernity in the 19th century and rebuilding process following World War II. \n\nA multimedia guide in 24 languages gives you new ways to interact with the exhibition, while special activities and Family Discovery Spaces allow children to grasp the story of Europe.  \n\nLocated next to the European Parliament in a striking Art Deco building in Parc L\u00e9opold, the House of European History is an essential part of any tour of the city.\n* Free\n* Available in 24 languages\n* Book online: See practical information\n\n","description_print":"This free museum in the beautifully renovated Eastman building presents an overview of European history and its possible future, thanks to hundreds of objects from all 28 EU member states. The museum recounts all of Europe\u2019s history, in each of the EU\u2019s 24 official languages, from the early European myths and discoveries, to the chaos followed by a growing feeling of unity and belonging of the 20th century. It also encourages visitors to think about, question and debate Europe\u2019s future. The House of European History provides visits perfectly tailored for schools, families and groups.\r\n\r\nThe permanent exhibition: The exhibition guides visitors through key moments of European history. First come the convictions and beliefs of the 19th century - when Europe reached \u2018modernity\u2019 - followed by a period of destruction and war, before the exhibition ends with Europe\u2019s search for a new life and an increasingly united continent. The museum hopes to get visitors to reflect on today\u2019s Europe and contemplate how each European can help to build the Europe of tomorrow.\r\n\r\nEducation and learning: The House of European History has developed various educational programmes that guarantee a memorable experience thanks to interactive equipment, original and replica objects, presentations, multimedia, teaching materials, workshops and seminars. They encourage visitors to question and debate Europe\u2019s history and its consequences for the world today.\r\n\r\nAn extraordinary location: The Eastman building \u2013 which was once a dental clinic for disadvantaged children - is an Art Deco gem. The building - which was meticulously restored \u2013 houses, among other things, some beautiful wall paintings depicting the stories of French author Jean de La Fontaine, and lies in the ten hectare Leopold park. It\u2019s the perfect place for a picnic or a relaxing break on a bench.\r\n\r\n","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Casa della storia Europea","address_street_name":"Rue Belliard","address_street_number":"135","address_street_box":null,"email":"historia-learning@europarl.europa.eu","website":"https:\/\/historia.europa.eu\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Belliard, 135","address_line2":"1000 Bruxelles","description_web":"Questa mostra permanente vi guida attraverso momenti salienti della storia europea. Dalle convinzioni e credenze del XIX\u00b0 secolo - quando l\u2019Europa raggiunse la \u201cmodernit\u00e0\u201d - potrete seguire la storia attraverso la distruzione e la guerra, prima di vedere la ricerca per un\u2019esistenza nuova, pacifica e sempre pi\u00f9 all\u2019insegna dell\u2019unit\u00e0. Una guida multimediale vi offrir\u00e0 nuove modalit\u00e0 per interagire con la mostra, mentre attivit\u00e0 speciali consentono ai bambini di comprendere la storia d\u2019Europa.Un luogo straordinario per un museo straordinario: la palazzina Eastman - una volta clinica dentale per bambini disavvantaggiati - \u00e8 una gemma dell\u2019Art D\u00e9co. L\u2019edificio \u00e8 stato meticolosamente ristrutturato e annovera, tra i vari oggetti, splendidi affreschi raffiguranti i racconti dell\u2019autore francese Jean de la Fontaine. Si trova nel Parc Leopold, luogo ideale per un picnic o una passeggiata.\n\nLa prossima esposizione temporanea \u201cFalso per Vero: una storia di contraffazione e falsificazione\u201d aprir\u00e0 le porte il 24 Ottobre.\n\n* Gratuito\n* Disponibile in 24 lingue\n* Attualmente sono disponibili solo visite individuali. Prenotazione online: https:\/\/booking-visits.europarl.europa.eu\/it\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Maison de l'Histoire europ\u00e9enne","address_street_name":"Rue Belliard","address_street_number":"135","address_street_box":null,"email":"historia-learning@europarl.europa.eu","website":"https:\/\/historia.europa.eu\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Belliard, 135","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Maison de l'Histoire europ\u00e9enne","address_street_name":"Rue Belliard","address_street_number":"135","address_street_box":null,"email":"historia-learning@europarl.europa.eu","website":"https:\/\/historia.europa.eu\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Belliard, 135","address_line2":"1000 Bruxelles","description_web":"Pr\u00e9parez-vous \u00e0 un voyage pas comme les autres ! \n\nL'exposition permanente commence avec le mythe de la d\u00e9esse Europa, explore les racines anciennes de l'Europe et l'h\u00e9ritage des traditions communes du continent, avant le voyage spectaculaire de l'Europe vers la modernit\u00e9 au XIXe si\u00e8cle et le processus de reconstruction apr\u00e8s la Seconde Guerre mondiale. \n\nUn guide multim\u00e9dia en 24 langues vous offre de nouvelles fa\u00e7ons d'interagir avec l'exposition, tandis que des activit\u00e9s sp\u00e9ciales et des espaces de d\u00e9couverte en famille permettent aux enfants de saisir l'histoire de l'Europe.  \n\nSitu\u00e9e \u00e0 c\u00f4t\u00e9 du Parlement europ\u00e9en dans un \u00e9tonnant b\u00e2timent Art d\u00e9co du Parc L\u00e9opold, la Maison de l'histoire europ\u00e9enne est un \u00e9l\u00e9ment essentiel de toute visite de la ville.\n* Gratuit\n* Disponible en 24 langues\n* R\u00e9servation en ligne : voir informations pratiques\n\n\n","description_print":"Ce mus\u00e9e gratuit, install\u00e9 dans le magnifique b\u00e2timent Eastman r\u00e9nov\u00e9, retrace l\u2019histoire europ\u00e9enne. \r\nDes centaines de traces et d\u2019objets pour t\u00e9moigner des mythes europ\u00e9ens et des d\u00e9couvertes, jusqu'au chaos et au d\u00e9veloppement du sentiment d\u2019appartenance au cours du XX\u00e8me si\u00e8cle. Les visiteurs vont plonger dans le pass\u00e9 - et l\u2019avenir - de l\u2019Europe. La Maison de l\u2019histoire europ\u00e9enne propose des programmes sur mesure pour les \u00e9coles, les familles et les groupes.\r\n\r\nExposition permanente : Partez \u00e0 la d\u00e9couverte de l\u2019histoire europ\u00e9enne en vous arr\u00eatant d'abord sur les id\u00e9es et les convictions du XIXe si\u00e8cle, qui a marqu\u00e9 l'entr\u00e9e de l'Europe dans la modernit\u00e9. Puis penchez-vous sur la triste p\u00e9riode de guerre et de destruction et terminez par la recherche d'une vie meilleure dans une Europe toujours plus unifi\u00e9e. Le mus\u00e9e incite \u00e0 la r\u00e9flexion sur l'Europe d'aujourd'hui, et sur le r\u00f4le que tout Europ\u00e9en peut jouer pour modeler son avenir.\r\n\r\nEnseignement et formation : la Maison de l\u2019histoire europ\u00e9enne propose divers programmes de formation qui font de la visite une exp\u00e9rience captivante au fil des pr\u00e9sentations interactives, objets originaux et r\u00e9pliques, expositions, guides multim\u00e9dias, ressources p\u00e9dagogiques, ateliers et s\u00e9minaires. Ils incitent les visiteurs \u00e0 remettre en question leur conception de l'histoire europ\u00e9enne et son empreinte sur le monde contemporain.  \r\n\r\nUn site exceptionnel : le b\u00e2timent Eastman, qui abritait anciennement une clinique dentaire pour enfants d\u00e9favoris\u00e9s, est une perle de l\u2019Art D\u00e9co. Restaur\u00e9 jusque dans les moindres d\u00e9tails, le b\u00e2timent comprend notamment des fresques murales inspir\u00e9es des fables de La Fontaine. Il se dresse dans le majestueux Parc L\u00e9opold, au c\u0153ur du quartier europ\u00e9en de Bruxelles. Id\u00e9al pour un pique-nique ou une petite pause nature !\r\n\r\n","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Casa de la historia Europea","address_street_name":"Rue Belliard","address_street_number":"135","address_street_box":null,"email":"historia-learning@europarl.europa.eu","website":"https:\/\/historia.europa.eu\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Belliard, 135","address_line2":"1000 Bruxelles","description_web":"La exposici\u00f3n permanente le gu\u00eda a trav\u00e9s de momentos clave de la historia europea. Desde las convicciones y creencias del siglo XIX, cuando Europa alcanz\u00f3\nla \"modernidad\", puede seguir la historia a trav\u00e9s de la destrucci\u00f3n y la guerra,\nantes de llegar a la b\u00fasqueda de una vida nueva, pac\u00edfica y cada vez m\u00e1s unida.\nUna gu\u00eda multimedia le ofrece nuevas formas de interactuar con la exposici\u00f3n;\ntambi\u00e9n ofrece actividades especiales que permiten a los ni\u00f1os comprender la\nhistoria de Europa.\nUna ubicaci\u00f3n extraordinaria para un museo extraordinario: el edificio Eastman, que\nen el pasado fue una cl\u00ednica dental para ni\u00f1os desfavorecidos, es una joya Art Deco.\nEl edificio ha sido meticulosamente restaurado y alberga, entre otras cosas,\nhermosas pinturas murales que representan las historias del autor franc\u00e9s Jean de\nLa Fontaine. Se encuentra en el Parque Leopold, un lugar perfecto para un picnic o\nun paseo.\nLa pr\u00f3xima exposici\u00f3n temporal \u201cFalso de verdad: una historia de falsificaci\u00f3n y\nfalsificaci\u00f3n\u201d se inaugurar\u00e1 el 24 de octubre.\n* Gratuito\n* Disponible en 24 idiomas\n* Por el momento solo se permiten las visitas individuales. Reserve a trav\u00e9s del enlace:\nhttps:\/\/booking-visits.europarl.europa.eu\/en\n","description_print":"Este museo gratuito, instalado en el magn\u00edfico edificio restaurado Eastman, recuerda la historia europea y reflexiona su futuro a trav\u00e9s de cientos de objetos procedentes de los 28 pa\u00edses de la UE. En \u00e9l se presenta la historia de Europa en los 24 idiomas oficiales de la Uni\u00f3n Europea, desde los mitos europeos y los descubrimientos, hasta el caos y el desarrollo del sentimiento de pertenencia que se produjeron a lo largo del siglo XX; y se anima a los visitantes a reflexionar, a plantearse preguntas y a evocar el pasado y el futuro del Viejo Continente. La Casa de la Historia Europea tambi\u00e9n ofrece programas a medida para colegios, familias y grupos.\r\n\r\nExposici\u00f3n permanente: el visitante podr\u00e1 descubrir las l\u00edneas principales de la historia europea al detenerse, en primer lugar, en las ideas y convicciones que caracterizaron al siglo XIX, que marcan \u00abla entrada de Europa en la modernidad\u00bb, antes de pasar al per\u00edodo de guerra y destrucci\u00f3n, y de terminar con la cuesti\u00f3n de la b\u00fasqueda de una vida mejor en una Europa todav\u00eda m\u00e1s unificada. El museo promueve una reflexi\u00f3n sobre la Europa de hoy en d\u00eda y sobre el papel que todos los europeos pueden desempe\u00f1ar a la hora de dar forma al futuro de Europa.\r\n\r\nEnse\u00f1anza y formaci\u00f3n: la Casa de la Historia Europea ha elaborado diferentes programas de formaci\u00f3n que consiguen que la visita sea una experiencia muy interesante gracias al uso de presentaciones interactivas, objetos originales y r\u00e9plicas, exposiciones, gu\u00edas multimedia, recursos pedag\u00f3gicos, talleres y seminarios.  Todos estos recursos animan a los visitantes a replantearse sus ideas acerca de la historia europea y su huella en el mundo contempor\u00e1neo.  \r\n\r\nUn centro excepcional: el edificio Eastman, que antiguamente albergaba una cl\u00ednica dental para ni\u00f1os desfavorecidos, es una aut\u00e9ntica joya del estilo Art D\u00e9co. Restaurado hasta el m\u00e1s m\u00ednimo detalle, el edificio est\u00e1 compuesto principalmente por frescos murales inspirados en las f\u00e1bulas de Jean de La Fontaine, en los cuales se ha realizado un magn\u00edfico trabajo de restauraci\u00f3n. El museo se levanta sobre el sombreado Parc L\u00e9opold, que, con sus diez hect\u00e1reas de extensi\u00f3n,  constituye un enclave ideal para realizar un p\u00edcnic o una breve pausa en un banco.\r\n\r\n","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Huis van de Europese geschiedenis","address_street_name":"Belliardstraat","address_street_number":"135","address_street_box":null,"email":"historia-learning@europarl.europa.eu","website":"https:\/\/historia.europa.eu\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Belliardstraat, 135","address_line2":"1000 Brussel","description_web":"Bereid je voor op een reis als geen ander! \nDe permanente tentoonstelling begint met de mythe van de godin Europa en verkent de oude wortels van Europa en het erfgoed van gemeenschappelijke tradities, voordat Europa's dramatische reis naar moderniteit in de 19e eeuw en de wederopbouw na de Tweede Wereldoorlog begint. \n\nEen multimediagids in 24 talen biedt nieuwe manieren om met de tentoonstelling om te gaan, terwijl speciale activiteiten en ontdekkingsruimtes voor gezinnen kinderen in staat stellen het verhaal van Europa te begrijpen.  \n\nHet Huis van de Europese geschiedenis ligt naast het Europees Parlement in een opvallend art-decogebouw in het Leopoldpark en is een essentieel onderdeel van elk bezoek aan de stad.\n* gratis \n * in 24 talen \n * Online reserveren: zie praktische informatie","description_print":"Dit gratis museum in het prachtig gerenoveerde Eastmangebouw geeft een overzicht van de Europese geschiedenis \u00e9n toekomst, aan de hand van honderden objecten uit de 28 landen van de EU. In alle 24 offici\u00eble talen van de Europese Unie vertelt het het verhaal van Europa vanaf de Europese mythen en ontdekkingen tot de chaos en het samenhorigheidsgevoel van de twintigste eeuw en zet aan tot nadenken,  vragen stellen en praten over het Europese verleden en toekomst. Het Huis biedt programma\u2019s op maat voor scholen, gezinnen en groepen.\r\n\r\nPermanente tentoonstelling: deze voert de bezoeker langs de hoofdlijnen van de Europese geschiedenis, waarbij eerst en vooral de overtuigingen en denkbeelden van de negentiende eeuw aan bod komen, toen Europa toetrad tot de moderniteit, gevolgd door een periode van oorlog en vernieling om ten te eindigen naar de zoektocht naar een beter leven en een samenwerking die steeds hechter werd. Het museum zet aan tot reflectie over het Europa van vandaag en de wijze waarop elke Europeaan mee de toekomst van Europa kan vormgeven.\r\n\r\nOnderwijs en vorming: het Huis ontwikkelde diverse vormingsprogramma\u2019s die zorgen voor een beklijvende ervaring dankzij interactieve opstellingen, originele voorwerpen en replica\u2019s, tentoonstellingen, multimedia, leermiddelen, workshops en seminars. Zij zetten de bezoekers aan om vraagtekens te plaatsen bij de Europese geschiedenis en de gevolgen voor de wereld van vandaag.\r\n\r\nEen uitzonderlijke locatie: het Eastmangebouw - vroeger een tandheelkundige kliniek voor kansarme kinderen - is een art decopareltje. Het tot in de puntjes gerestaureerde gebouw bevat onder meer prachtig gerestaureerde muurschilderingen van de fabels van de Franse schrijver Jean de La Fontaine en is gelegen in het schaduwrijke, tien hectare grote Leopoldpark. Ideaal voor een picknick of wat uitblazen op een bankje.\r\n\r\n","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[9],"translations":{"de":["Europ\u00e4isches Viertel"],"pt":[null],"en":["European Quarter"],"it":["Quartiere europeo"],"cn":[null],"fr":["Quartier europ\u00e9en"],"sp":["Barrio Europeo"],"nl":["Europese wijk"]}},"zones":{"list":[22],"translations":{"de":["Osten"],"pt":[null],"en":["East"],"it":["Est"],"cn":[null],"fr":["Est"],"sp":["Este"],"nl":["Oost"]}},"neca":null,"facebook_id":null,"backoffice_id":27078,"location":{"lat":50.8393873,"lon":4.3786546},"region":"brussels","last_updated_at":"2024-12-03T09:49:58+01:00","published_at":"2017-02-02T16:24:49+01:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":267078,"translations":{"de":{"name":"Haus der Europ\u00e4ischen Geschichte","address_street_name":"Rue Belliard","address_street_number":"135","address_street_box":null,"email":"historia-learning@europarl.europa.eu","website":"https:\/\/historia.europa.eu\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Belliard, 135","address_line2":"1000 Bruxelles","description_web":"Das Haus der Europ\u00e4ischen Geschichte, das in dem pr\u00e4chtigen, frisch renovierten Eastman-Geb\u00e4ude untergebracht ist, zeichnet die europ\u00e4ische Geschichte und die Zukunft Europas anhand von unz\u00e4hligen Ausstellungsst\u00fccken aus den 28 Mitgliedstaaten der EU nach. Der Eintritt ist frei.\nIn den 24 Amtssprachen der Europ\u00e4ischen Union offenbart es die Geschichte Europas \u2013 von den europ\u00e4ischen Mythen und Entdeckungen, \u00fcber das Chaos und die Kriegswirren bis hin zur allm\u00e4hlichen Entwicklung eines Zugeh\u00f6rigkeitsgef\u00fchls im Laufe des 20. Jahrhunderts. Dabei wird der Besucher angeregt, die Dinge zu hinterfragen und sowohl die Vergangenheit als auch die Zukunft zu betrachten und zu analysieren. Das Haus der Europ\u00e4ischen Geschichte bietet speziell zugeschnittene Programme f\u00fcr Schulen, Familien und Gruppen. Der Eintritt ist frei.\n\nDauerausstellung: Die Dauerausstellung l\u00e4sst die gro\u00dfen Ereignisse der europ\u00e4ischen Geschichte Revue passieren und legt dabei zun\u00e4chst einen Schwerpunkt auf die im 19. Jahrhundert vorherrschenden Ideen und \u00dcberzeugungen. N\u00e4chster thematischer Schwerpunkt sind die zerst\u00f6rerischen Kriege, die Europa ersch\u00fctterten, bevor die Ausstellung sich schlie\u00dflich der europ\u00e4ischen Einigung zuwendet, die den Europ\u00e4ern eine friedlichere Zukunft sichern sollte. Das Museum regt die Besucher zum Nachdenken an \u2013 \u00fcber das heutige Europa und seine Rolle in der Welt und die M\u00f6glichkeit jedes einzelnen Europ\u00e4ers, die Zukunft des Kontinents mitzugestalten.\n\nP\u00e4dagogische Angebote und Fortbildungen: Das Haus der europ\u00e4ischen Geschichte hat eine Reihe von p\u00e4dagogischen Angeboten ausgearbeitet, die die Besichtigung zu einem echten Erlebnis machen: interaktive Pr\u00e4sentationen, Ausstellungsgegenst\u00e4nde, Multimedia-Guides, Ausstellungen, Workshops und Seminare, die den Besucher dazu anregen, seine bisherige Wahrnehmung der europ\u00e4ischen Geschichte und ihren Einfluss auf die heutige Welt zu hinterfragen.\n\nEin herausragendes Bauwerk: Das Eastman-Geb\u00e4ude, das sich im Schatten der B\u00e4ume des majest\u00e4tischen Parc L\u00e9opold erhebt, ist eine Perle des Art D\u00e9co. Hier war bis vor Kurzem noch eine Zahnklinik f\u00fcr sozial benachteiligte Kinder untergebracht, jetzt wurde das Bauwerk bis ins letzte Detail restauriert. Besonders sch\u00f6n sind dabei die Wandfresken in Anlehnung an die Fabeln von Jean de la Fontaine, die nun wieder in altem Glanz erstrahlen. Und nach der Besichtigung laden die Parkb\u00e4nke des Parc L\u00e9opold zum Picknicken und Verweilen ein. ","description_print":"Das Haus der Europ\u00e4ischen Geschichte, das in dem pr\u00e4chtigen, frisch renovierten Eastman-Geb\u00e4ude untergebracht ist, zeichnet die europ\u00e4ische Geschichte und die Zukunft Europas anhand von unz\u00e4hligen Ausstellungsst\u00fccken aus den 28 Mitgliedstaaten der EU nach. Der Eintritt ist frei.\r\nIn den 24 Amtssprachen der Europ\u00e4ischen Union offenbart es die Geschichte Europas \u2013 von den europ\u00e4ischen Mythen und Entdeckungen, \u00fcber das Chaos und die Kriegswirren bis hin zur allm\u00e4hlichen Entwicklung eines Zugeh\u00f6rigkeitsgef\u00fchls im Laufe des 20. Jahrhunderts. Dabei wird der Besucher angeregt, die Dinge zu hinterfragen und sowohl die Vergangenheit als auch die Zukunft zu betrachten und zu analysieren. Das Haus der Europ\u00e4ischen Geschichte bietet speziell zugeschnittene Programme f\u00fcr Schulen, Familien und Gruppen. Der Eintritt ist frei.\r\n\r\nDauerausstellung: Die Dauerausstellung l\u00e4sst die gro\u00dfen Ereignisse der europ\u00e4ischen Geschichte Revue passieren und legt dabei zun\u00e4chst einen Schwerpunkt auf die im 19. Jahrhundert vorherrschenden Ideen und \u00dcberzeugungen. N\u00e4chster thematischer Schwerpunkt sind die zerst\u00f6rerischen Kriege, die Europa ersch\u00fctterten, bevor die Ausstellung sich schlie\u00dflich der europ\u00e4ischen Einigung zuwendet, die den Europ\u00e4ern eine friedlichere Zukunft sichern sollte. Das Museum regt die Besucher zum Nachdenken an \u2013 \u00fcber das heutige Europa und seine Rolle in der Welt und die M\u00f6glichkeit jedes einzelnen Europ\u00e4ers, die Zukunft des Kontinents mitzugestalten.\r\n\r\nP\u00e4dagogische Angebote und Fortbildungen: Das Haus der europ\u00e4ischen Geschichte hat eine Reihe von p\u00e4dagogischen Angeboten ausgearbeitet, die die Besichtigung zu einem echten Erlebnis machen: interaktive Pr\u00e4sentationen, Ausstellungsgegenst\u00e4nde, Multimedia-Guides, Ausstellungen, Workshops und Seminare, die den Besucher dazu anregen, seine bisherige Wahrnehmung der europ\u00e4ischen Geschichte und ihren Einfluss auf die heutige Welt zu hinterfragen.\r\n\r\nEin herausragendes Bauwerk: Das Eastman-Geb\u00e4ude, das sich im Schatten der B\u00e4ume des majest\u00e4tischen Parc L\u00e9opold erhebt, ist eine Perle des Art D\u00e9co. Hier war bis vor Kurzem noch eine Zahnklinik f\u00fcr sozial benachteiligte Kinder untergebracht, jetzt wurde das Bauwerk bis ins letzte Detail restauriert. Besonders sch\u00f6n sind dabei die Wandfresken in Anlehnung an die Fabeln von Jean de la Fontaine, die nun wieder in altem Glanz erstrahlen. Und nach der Besichtigung laden die Parkb\u00e4nke des Parc L\u00e9opold zum Picknicken und Verweilen ein. \r\n\r\n","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Maison de l'Histoire europ\u00e9enne","address_street_name":"Rue Belliard","address_street_number":"135","address_street_box":null,"email":"historia-learning@europarl.europa.eu","website":"https:\/\/historia.europa.eu\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Belliard, 135","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"House of European History","address_street_name":"Belliardstraat","address_street_number":"135","address_street_box":null,"email":"historia-learning@europarl.europa.eu","website":"https:\/\/historia.europa.eu\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Belliardstraat, 135","address_line2":"1000 Brussels","description_web":"Get ready for a journey like no other! \nThe permanent exhibition begins with the myth of the goddess Europa, exploring Europe\u2019s ancient roots and the continent\u2019s heritage of shared traditions, before Europe\u2019s dramatic journey towards modernity in the 19th century and rebuilding process following World War II. \n\nA multimedia guide in 24 languages gives you new ways to interact with the exhibition, while special activities and Family Discovery Spaces allow children to grasp the story of Europe.  \n\nLocated next to the European Parliament in a striking Art Deco building in Parc L\u00e9opold, the House of European History is an essential part of any tour of the city.\n* Free\n* Available in 24 languages\n* Book online: See practical information\n\n","description_print":"This free museum in the beautifully renovated Eastman building presents an overview of European history and its possible future, thanks to hundreds of objects from all 28 EU member states. The museum recounts all of Europe\u2019s history, in each of the EU\u2019s 24 official languages, from the early European myths and discoveries, to the chaos followed by a growing feeling of unity and belonging of the 20th century. It also encourages visitors to think about, question and debate Europe\u2019s future. The House of European History provides visits perfectly tailored for schools, families and groups.\r\n\r\nThe permanent exhibition: The exhibition guides visitors through key moments of European history. First come the convictions and beliefs of the 19th century - when Europe reached \u2018modernity\u2019 - followed by a period of destruction and war, before the exhibition ends with Europe\u2019s search for a new life and an increasingly united continent. The museum hopes to get visitors to reflect on today\u2019s Europe and contemplate how each European can help to build the Europe of tomorrow.\r\n\r\nEducation and learning: The House of European History has developed various educational programmes that guarantee a memorable experience thanks to interactive equipment, original and replica objects, presentations, multimedia, teaching materials, workshops and seminars. They encourage visitors to question and debate Europe\u2019s history and its consequences for the world today.\r\n\r\nAn extraordinary location: The Eastman building \u2013 which was once a dental clinic for disadvantaged children - is an Art Deco gem. The building - which was meticulously restored \u2013 houses, among other things, some beautiful wall paintings depicting the stories of French author Jean de La Fontaine, and lies in the ten hectare Leopold park. It\u2019s the perfect place for a picnic or a relaxing break on a bench.\r\n\r\n","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Casa della storia Europea","address_street_name":"Rue Belliard","address_street_number":"135","address_street_box":null,"email":"historia-learning@europarl.europa.eu","website":"https:\/\/historia.europa.eu\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Belliard, 135","address_line2":"1000 Bruxelles","description_web":"Questa mostra permanente vi guida attraverso momenti salienti della storia europea. Dalle convinzioni e credenze del XIX\u00b0 secolo - quando l\u2019Europa raggiunse la \u201cmodernit\u00e0\u201d - potrete seguire la storia attraverso la distruzione e la guerra, prima di vedere la ricerca per un\u2019esistenza nuova, pacifica e sempre pi\u00f9 all\u2019insegna dell\u2019unit\u00e0. Una guida multimediale vi offrir\u00e0 nuove modalit\u00e0 per interagire con la mostra, mentre attivit\u00e0 speciali consentono ai bambini di comprendere la storia d\u2019Europa.Un luogo straordinario per un museo straordinario: la palazzina Eastman - una volta clinica dentale per bambini disavvantaggiati - \u00e8 una gemma dell\u2019Art D\u00e9co. L\u2019edificio \u00e8 stato meticolosamente ristrutturato e annovera, tra i vari oggetti, splendidi affreschi raffiguranti i racconti dell\u2019autore francese Jean de la Fontaine. Si trova nel Parc Leopold, luogo ideale per un picnic o una passeggiata.\n\nLa prossima esposizione temporanea \u201cFalso per Vero: una storia di contraffazione e falsificazione\u201d aprir\u00e0 le porte il 24 Ottobre.\n\n* Gratuito\n* Disponibile in 24 lingue\n* Attualmente sono disponibili solo visite individuali. Prenotazione online: https:\/\/booking-visits.europarl.europa.eu\/it\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Maison de l'Histoire europ\u00e9enne","address_street_name":"Rue Belliard","address_street_number":"135","address_street_box":null,"email":"historia-learning@europarl.europa.eu","website":"https:\/\/historia.europa.eu\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Belliard, 135","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Maison de l'Histoire europ\u00e9enne","address_street_name":"Rue Belliard","address_street_number":"135","address_street_box":null,"email":"historia-learning@europarl.europa.eu","website":"https:\/\/historia.europa.eu\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Belliard, 135","address_line2":"1000 Bruxelles","description_web":"Pr\u00e9parez-vous \u00e0 un voyage pas comme les autres ! \n\nL'exposition permanente commence avec le mythe de la d\u00e9esse Europa, explore les racines anciennes de l'Europe et l'h\u00e9ritage des traditions communes du continent, avant le voyage spectaculaire de l'Europe vers la modernit\u00e9 au XIXe si\u00e8cle et le processus de reconstruction apr\u00e8s la Seconde Guerre mondiale. \n\nUn guide multim\u00e9dia en 24 langues vous offre de nouvelles fa\u00e7ons d'interagir avec l'exposition, tandis que des activit\u00e9s sp\u00e9ciales et des espaces de d\u00e9couverte en famille permettent aux enfants de saisir l'histoire de l'Europe.  \n\nSitu\u00e9e \u00e0 c\u00f4t\u00e9 du Parlement europ\u00e9en dans un \u00e9tonnant b\u00e2timent Art d\u00e9co du Parc L\u00e9opold, la Maison de l'histoire europ\u00e9enne est un \u00e9l\u00e9ment essentiel de toute visite de la ville.\n* Gratuit\n* Disponible en 24 langues\n* R\u00e9servation en ligne : voir informations pratiques\n\n\n","description_print":"Ce mus\u00e9e gratuit, install\u00e9 dans le magnifique b\u00e2timent Eastman r\u00e9nov\u00e9, retrace l\u2019histoire europ\u00e9enne. \r\nDes centaines de traces et d\u2019objets pour t\u00e9moigner des mythes europ\u00e9ens et des d\u00e9couvertes, jusqu'au chaos et au d\u00e9veloppement du sentiment d\u2019appartenance au cours du XX\u00e8me si\u00e8cle. Les visiteurs vont plonger dans le pass\u00e9 - et l\u2019avenir - de l\u2019Europe. La Maison de l\u2019histoire europ\u00e9enne propose des programmes sur mesure pour les \u00e9coles, les familles et les groupes.\r\n\r\nExposition permanente : Partez \u00e0 la d\u00e9couverte de l\u2019histoire europ\u00e9enne en vous arr\u00eatant d'abord sur les id\u00e9es et les convictions du XIXe si\u00e8cle, qui a marqu\u00e9 l'entr\u00e9e de l'Europe dans la modernit\u00e9. Puis penchez-vous sur la triste p\u00e9riode de guerre et de destruction et terminez par la recherche d'une vie meilleure dans une Europe toujours plus unifi\u00e9e. Le mus\u00e9e incite \u00e0 la r\u00e9flexion sur l'Europe d'aujourd'hui, et sur le r\u00f4le que tout Europ\u00e9en peut jouer pour modeler son avenir.\r\n\r\nEnseignement et formation : la Maison de l\u2019histoire europ\u00e9enne propose divers programmes de formation qui font de la visite une exp\u00e9rience captivante au fil des pr\u00e9sentations interactives, objets originaux et r\u00e9pliques, expositions, guides multim\u00e9dias, ressources p\u00e9dagogiques, ateliers et s\u00e9minaires. Ils incitent les visiteurs \u00e0 remettre en question leur conception de l'histoire europ\u00e9enne et son empreinte sur le monde contemporain.  \r\n\r\nUn site exceptionnel : le b\u00e2timent Eastman, qui abritait anciennement une clinique dentaire pour enfants d\u00e9favoris\u00e9s, est une perle de l\u2019Art D\u00e9co. Restaur\u00e9 jusque dans les moindres d\u00e9tails, le b\u00e2timent comprend notamment des fresques murales inspir\u00e9es des fables de La Fontaine. Il se dresse dans le majestueux Parc L\u00e9opold, au c\u0153ur du quartier europ\u00e9en de Bruxelles. Id\u00e9al pour un pique-nique ou une petite pause nature !\r\n\r\n","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Casa de la historia Europea","address_street_name":"Rue Belliard","address_street_number":"135","address_street_box":null,"email":"historia-learning@europarl.europa.eu","website":"https:\/\/historia.europa.eu\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Belliard, 135","address_line2":"1000 Bruxelles","description_web":"La exposici\u00f3n permanente le gu\u00eda a trav\u00e9s de momentos clave de la historia europea. Desde las convicciones y creencias del siglo XIX, cuando Europa alcanz\u00f3\nla \"modernidad\", puede seguir la historia a trav\u00e9s de la destrucci\u00f3n y la guerra,\nantes de llegar a la b\u00fasqueda de una vida nueva, pac\u00edfica y cada vez m\u00e1s unida.\nUna gu\u00eda multimedia le ofrece nuevas formas de interactuar con la exposici\u00f3n;\ntambi\u00e9n ofrece actividades especiales que permiten a los ni\u00f1os comprender la\nhistoria de Europa.\nUna ubicaci\u00f3n extraordinaria para un museo extraordinario: el edificio Eastman, que\nen el pasado fue una cl\u00ednica dental para ni\u00f1os desfavorecidos, es una joya Art Deco.\nEl edificio ha sido meticulosamente restaurado y alberga, entre otras cosas,\nhermosas pinturas murales que representan las historias del autor franc\u00e9s Jean de\nLa Fontaine. Se encuentra en el Parque Leopold, un lugar perfecto para un picnic o\nun paseo.\nLa pr\u00f3xima exposici\u00f3n temporal \u201cFalso de verdad: una historia de falsificaci\u00f3n y\nfalsificaci\u00f3n\u201d se inaugurar\u00e1 el 24 de octubre.\n* Gratuito\n* Disponible en 24 idiomas\n* Por el momento solo se permiten las visitas individuales. Reserve a trav\u00e9s del enlace:\nhttps:\/\/booking-visits.europarl.europa.eu\/en\n","description_print":"Este museo gratuito, instalado en el magn\u00edfico edificio restaurado Eastman, recuerda la historia europea y reflexiona su futuro a trav\u00e9s de cientos de objetos procedentes de los 28 pa\u00edses de la UE. En \u00e9l se presenta la historia de Europa en los 24 idiomas oficiales de la Uni\u00f3n Europea, desde los mitos europeos y los descubrimientos, hasta el caos y el desarrollo del sentimiento de pertenencia que se produjeron a lo largo del siglo XX; y se anima a los visitantes a reflexionar, a plantearse preguntas y a evocar el pasado y el futuro del Viejo Continente. La Casa de la Historia Europea tambi\u00e9n ofrece programas a medida para colegios, familias y grupos.\r\n\r\nExposici\u00f3n permanente: el visitante podr\u00e1 descubrir las l\u00edneas principales de la historia europea al detenerse, en primer lugar, en las ideas y convicciones que caracterizaron al siglo XIX, que marcan \u00abla entrada de Europa en la modernidad\u00bb, antes de pasar al per\u00edodo de guerra y destrucci\u00f3n, y de terminar con la cuesti\u00f3n de la b\u00fasqueda de una vida mejor en una Europa todav\u00eda m\u00e1s unificada. El museo promueve una reflexi\u00f3n sobre la Europa de hoy en d\u00eda y sobre el papel que todos los europeos pueden desempe\u00f1ar a la hora de dar forma al futuro de Europa.\r\n\r\nEnse\u00f1anza y formaci\u00f3n: la Casa de la Historia Europea ha elaborado diferentes programas de formaci\u00f3n que consiguen que la visita sea una experiencia muy interesante gracias al uso de presentaciones interactivas, objetos originales y r\u00e9plicas, exposiciones, gu\u00edas multimedia, recursos pedag\u00f3gicos, talleres y seminarios.  Todos estos recursos animan a los visitantes a replantearse sus ideas acerca de la historia europea y su huella en el mundo contempor\u00e1neo.  \r\n\r\nUn centro excepcional: el edificio Eastman, que antiguamente albergaba una cl\u00ednica dental para ni\u00f1os desfavorecidos, es una aut\u00e9ntica joya del estilo Art D\u00e9co. Restaurado hasta el m\u00e1s m\u00ednimo detalle, el edificio est\u00e1 compuesto principalmente por frescos murales inspirados en las f\u00e1bulas de Jean de La Fontaine, en los cuales se ha realizado un magn\u00edfico trabajo de restauraci\u00f3n. El museo se levanta sobre el sombreado Parc L\u00e9opold, que, con sus diez hect\u00e1reas de extensi\u00f3n,  constituye un enclave ideal para realizar un p\u00edcnic o una breve pausa en un banco.\r\n\r\n","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Huis van de Europese geschiedenis","address_street_name":"Belliardstraat","address_street_number":"135","address_street_box":null,"email":"historia-learning@europarl.europa.eu","website":"https:\/\/historia.europa.eu\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Belliardstraat, 135","address_line2":"1000 Brussel","description_web":"Bereid je voor op een reis als geen ander! \nDe permanente tentoonstelling begint met de mythe van de godin Europa en verkent de oude wortels van Europa en het erfgoed van gemeenschappelijke tradities, voordat Europa's dramatische reis naar moderniteit in de 19e eeuw en de wederopbouw na de Tweede Wereldoorlog begint. \n\nEen multimediagids in 24 talen biedt nieuwe manieren om met de tentoonstelling om te gaan, terwijl speciale activiteiten en ontdekkingsruimtes voor gezinnen kinderen in staat stellen het verhaal van Europa te begrijpen.  \n\nHet Huis van de Europese geschiedenis ligt naast het Europees Parlement in een opvallend art-decogebouw in het Leopoldpark en is een essentieel onderdeel van elk bezoek aan de stad.\n* gratis \n * in 24 talen \n * Online reserveren: zie praktische informatie","description_print":"Dit gratis museum in het prachtig gerenoveerde Eastmangebouw geeft een overzicht van de Europese geschiedenis \u00e9n toekomst, aan de hand van honderden objecten uit de 28 landen van de EU. In alle 24 offici\u00eble talen van de Europese Unie vertelt het het verhaal van Europa vanaf de Europese mythen en ontdekkingen tot de chaos en het samenhorigheidsgevoel van de twintigste eeuw en zet aan tot nadenken,  vragen stellen en praten over het Europese verleden en toekomst. Het Huis biedt programma\u2019s op maat voor scholen, gezinnen en groepen.\r\n\r\nPermanente tentoonstelling: deze voert de bezoeker langs de hoofdlijnen van de Europese geschiedenis, waarbij eerst en vooral de overtuigingen en denkbeelden van de negentiende eeuw aan bod komen, toen Europa toetrad tot de moderniteit, gevolgd door een periode van oorlog en vernieling om ten te eindigen naar de zoektocht naar een beter leven en een samenwerking die steeds hechter werd. Het museum zet aan tot reflectie over het Europa van vandaag en de wijze waarop elke Europeaan mee de toekomst van Europa kan vormgeven.\r\n\r\nOnderwijs en vorming: het Huis ontwikkelde diverse vormingsprogramma\u2019s die zorgen voor een beklijvende ervaring dankzij interactieve opstellingen, originele voorwerpen en replica\u2019s, tentoonstellingen, multimedia, leermiddelen, workshops en seminars. Zij zetten de bezoekers aan om vraagtekens te plaatsen bij de Europese geschiedenis en de gevolgen voor de wereld van vandaag.\r\n\r\nEen uitzonderlijke locatie: het Eastmangebouw - vroeger een tandheelkundige kliniek voor kansarme kinderen - is een art decopareltje. Het tot in de puntjes gerestaureerde gebouw bevat onder meer prachtig gerestaureerde muurschilderingen van de fabels van de Franse schrijver Jean de La Fontaine en is gelegen in het schaduwrijke, tien hectare grote Leopoldpark. Ideaal voor een picknick of wat uitblazen op een bankje.\r\n\r\n","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":27078,"location":{"lat":50.8393873,"lon":4.3786546},"last_updated_at":"2024-12-03T09:49:58+01:00","published_at":"2017-02-02T16:24:49+01:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/c62ad273fec5ca11a099d5997ea361a7d65d166d.jpg","width":1814,"height":1100,"ratio":1.65,"oEmbed_height":1100,"oEmbed_width":1814,"translations":{"de":{"title":"Exhibition opening party","copyright":"House of European History"},"pt":{"title":"Exhibition opening party","copyright":"House of European History"},"en":{"title":"Exhibition opening party","copyright":"House of European History"},"it":{"title":"Exhibition opening party","copyright":"House of European History"},"cn":{"title":"Exhibition opening party","copyright":"House of European History"},"fr":{"title":"Soir\u00e9e d'ouverture de l'exposition","copyright":"Maison de l'histoire europ\u00e9enne"},"sp":{"title":"Exhibition opening party","copyright":"House of European History"},"nl":{"title":"Feestelijke opening tentoonstelling","copyright":"Feestelijke opening tentoonstelling"}}},{"type":"poster","link":"https:\/\/agendabrussels2.imgix.net\/9a3bddbac243bed21ecc0d65eb1fb41e92a7cf46.jpg","width":1200,"height":1200,"ratio":1,"oEmbed_height":1200,"oEmbed_width":1200,"translations":{"de":{"title":"Opening party poster","copyright":"House of European History"},"pt":{"title":"Opening party poster","copyright":"House of European History"},"en":{"title":"Opening party poster","copyright":"House of European History"},"it":{"title":"Opening party poster","copyright":"House of European History"},"cn":{"title":"Opening party poster","copyright":"House of European History"},"fr":{"title":"Affiche de la soir\u00e9e d'ouverture","copyright":"Maison de l'histoire europ\u00e9enne"},"sp":{"title":"Opening party poster","copyright":"House of European History"},"nl":{"title":"Poster openingsfeest","copyright":"Huis van de Europese geschiedenis"}}},{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/df28ba52ced1f6cc7700f84197d75975e07413e6.jpg","width":4928,"height":3285,"ratio":1.5,"oEmbed_height":3285,"oEmbed_width":4928,"translations":{"de":{"title":"Fables Room","copyright":"House of European History"},"pt":{"title":"Fables Room","copyright":"House of European History"},"en":{"title":"Fables Room","copyright":"House of European History"},"it":{"title":"Fables Room","copyright":"House of European History"},"cn":{"title":"Fables Room","copyright":"House of European History"},"fr":{"title":"Salle des fables","copyright":"Maison de l'histoire europ\u00e9enne"},"sp":{"title":"Fables Room","copyr