act":"+32 2 640 94 40","phone_booking":"+32 475 81 90 12","address_zip":"1040","address_city":"Etterbeek","address_line1":"Rue G\u00e9n\u00e9ral Capiaumont, 45\/47","address_line2":"1040 Etterbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Contraste - L'atelier de photographie","address_street_name":"Rue G\u00e9n\u00e9ral Capiaumont","address_street_number":"45\/47","address_street_box":null,"email":"info@photo-contraste.com","website":"http:\/\/www.photo-contraste.com","phone_contact":"+32 2 640 94 40","phone_booking":"+32 475 81 90 12","address_zip":"1040","address_city":"Etterbeek","address_line1":"Rue G\u00e9n\u00e9ral Capiaumont, 45\/47","address_line2":"1040 Etterbeek","description_web":"Contraste est un lieu d\u00e9di\u00e9 \u00e0 la photographie qui regroupe une galerie et une \u00e9cole.\r\n\r\nLa galerie de photographie Contraste,  accueille des artistes et des conf\u00e9rences ouvertes au public.\r\n\r\nDepuis 25 ans, Contraste enseigne la photographie au grand public. Mettre au point. Impressionner. D\u00e9velopper. R\u00e9v\u00e9ler. Ma\u00eetriser la technique. Eduquer l\u2019oeil. La mission de l\u2019atelier Contraste est d\u2019enseigner toutes les aptitudes n\u00e9cessaires \u00e0 une pratique photographique de qualit\u00e9. En partageant leurs exp\u00e9riences du m\u00e9tier et leur passion du m\u00e9dium, les professeurs, tous issus d\u2019\u00e9coles d\u2019art, initient aux bases et perfectionnements de la photographie. Contraste propose une approche de la photographie pour diff\u00e9rents publics de tous niveaux et \u00e2ges. Ateliers hebdos, stages de vacances, mais aussi des workshops courts, des formations sur mesure et des conf\u00e9rences.\r\n\r\nLa galerie pr\u00e9sente deux expositions par an .\r\n\r\n\r\n","description_print":"Contraste est un lieu d\u00e9di\u00e9 \u00e0 la photographie qui regroupe une galerie et une \u00e9cole.\r\n\r\nLa galerie de photographie Contraste,  accueille des artistes et des conf\u00e9rences ouvertes au public.\r\n\r\nDepuis 25 ans, Contraste enseigne la photographie au grand public. Mettre au point. Impressionner. D\u00e9velopper. R\u00e9v\u00e9ler. Ma\u00eetriser la technique. Eduquer l\u2019oeil. La mission de l\u2019atelier Contraste est d\u2019enseigner toutes les aptitudes n\u00e9cessaires \u00e0 une pratique photographique de qualit\u00e9. En partageant leurs exp\u00e9riences du m\u00e9tier et leur passion du m\u00e9dium, les professeurs, tous issus d\u2019\u00e9coles d\u2019art, initient aux bases et perfectionnements de la photographie. Contraste propose une approche de la photographie pour diff\u00e9rents publics de tous niveaux et \u00e2ges. Ateliers hebdos, stages de vacances, mais aussi des workshops courts, des formations sur mesure et des conf\u00e9rences.\r\n\r\nLa galerie pr\u00e9sente deux expositions par an .\r\n","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Contraste - L'atelier de photographie","address_street_name":"Rue G\u00e9n\u00e9ral Capiaumont","address_street_number":"45\/47","address_street_box":null,"email":"info@photo-contraste.com","website":"http:\/\/www.photo-contraste.com","phone_contact":"+32 2 640 94 40","phone_booking":"+32 475 81 90 12","address_zip":"1040","address_city":"Etterbeek","address_line1":"Rue G\u00e9n\u00e9ral Capiaumont, 45\/47","address_line2":"1040 Etterbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Contraste - L'atelier de photographie","address_street_name":"Generaal Capiaumontstraat","address_street_number":"45\/47","address_street_box":null,"email":"info@photo-contraste.com","website":"http:\/\/www.photo-contraste.com","phone_contact":"+32 2 640 94 40","phone_booking":"+32 475 81 90 12","address_zip":"1040","address_city":"Etterbeek","address_line1":"Generaal Capiaumontstraat, 45\/47","address_line2":"1040 Etterbeek","description_web":"Contraste is zowel een galerij als een school, gewijd aan fotografie.\r\n\r\nSedert 25 jaar geeft Contraste les aan een breed publiek. Scherpstellen. Belichten. Verwerken. Ontwikkelen. Onthullen. De techniek beheersen. Het oog trainen.\r\nDe missie van Atelier Contraste is het meegeven van alle nodige kennis om tot een kwalitatieve fotografische praktijk te komen. De lesgevers, allen afkomstig uit het artistiek onderwijs, delen hun ervaring en passie voor het medium. Ze onderwijzen zowel de basis van de fotografie als kennis voor gevorderden. Contraste richt zich tot een breed publiek met verschillende kennisniveaus en leeftijden, en organiseert wekelijkse cursussen, vakantiestages, korte workshops en lezingen.\r\n\r\nDe galerij stelt twee tentoonstellingen voor per jaar.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":1801,"location":{"lat":50.83126267,"lon":4.38384888},"last_updated_at":"2022-10-10T10:25:09+02:00","published_at":"2013-10-19T01:14:39+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"poster","link":"https:\/\/agendabrussels2.imgix.net\/e7d088c6247f751834fc94c776ed5c3020331b91.jpg","width":1080,"height":1920,"ratio":0.56,"oEmbed_height":1920,"oEmbed_width":1080,"translations":{"de":{"title":"Suzanne","copyright":"Pauline Caplet"},"pt":{"title":"Suzanne","copyright":"Pauline Caplet"},"en":{"title":"Suzanne","copyright":"Pauline Caplet"},"it":{"title":"Suzanne","copyright":"Pauline Caplet"},"cn":{"title":"Suzanne","copyright":"Pauline Caplet"},"fr":{"title":"Suzanne","copyright":"Pauline Caplet"},"sp":{"title":"Suzanne","copyright":"Pauline Caplet"},"nl":{"title":"Suzanne","copyright":"Pauline Caplet"}}}],"dates":[{"day":"2025-02-01","doors":null,"start":"14:00:00","end":"18:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2025-02-02","doors":null,"start":"14:00:00","end":"18:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false}],"prices":[],"date_exceptions":[],"closing_days":[],"child_events":[],"parent_events":[],"accessibilities":{"list":[265,255],"translations":{"de":["Barrierefreies WC","Barrierefrei"],"pt":[null,null],"en":["Adapted toilet","Accessible"],"it":["WC idoneo","Accessibile"],"cn":[null,null],"fr":["WC adapt\u00e9","Accessible"],"sp":["Ba\u00f1os adaptados","Habilitado"],"nl":["Aangepast toilet","Toegankelijk"]}},"recurring":[{"day":"sunday","occurences":{"is_last":false,"is_fourth":false,"is_third":false,"is_second":false,"is_first":true},"time_start":"14:00:00","time_end":"18:00:00","translations":{"fr":"Ouvert le premier, dimanche du mois de 14:00 \u00e0 18:00","nl":"Open op de eerste, zondag van de maand van 14:00 tot 18:00","en":"Open the first, sunday of the month from 14:00 to 18:00"}},{"day":"saturday","occurences":{"is_last":false,"is_fourth":false,"is_third":false,"is_second":false,"is_first":true},"time_start":"14:00:00","time_end":"18:00:00","translations":{"fr":"Ouvert le premier, samedi du mois de 14:00 \u00e0 18:00","nl":"Open op de eerste, zaterdag van de maand van 14:00 tot 18:00","en":"Open the first, saturday of the month from 14:00 to 18:00"}}],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[],"opening":{"day":"2025-01-24","end":"21:00:00","start":"18:00:00","timestamp":"2025-01-24T18:00:00"}},{"id":5700005414,"date_start":"2025-01-24","date_end":"2025-02-23","date_next":"2025-02-02","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2025-02-02T01:01:24+01:00","published_at":"2025-01-13T16:55:26+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":316154,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"other","ranking":0.40107239119071786,"languages":{"spoken":["fr","en"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[27,24],"translations":{"de":["Fotografie","Kunstgalerien"],"pt":[null,null],"en":["Photography","Art Galleries"],"it":["Fotografia","Gallerie d'arte"],"cn":[null,null],"fr":["Photographie","Galeries d'art"],"sp":["Fotograf\u00eda","Galer\u00edas de arte"],"nl":["Fotografie","Galeries"]}}},"translations":{"de":{"name":"Post Tourism by Ada Zieli\u0144ska","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.instagram.com\/lanombreuse\/","email":"lanombreuse@gmail.com","phone_contact":"+32 479 63 46 94","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700005414"},"pt":{"name":"Post Tourism by Ada Zieli\u0144ska","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.instagram.com\/lanombreuse\/","email":"lanombreuse@gmail.com","phone_contact":"+32 479 63 46 94","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700005414"},"en":{"name":"Post Tourism by Ada Zieli\u0144ska","shortdescr":"Since 2018, the artist has been playing the game of tomorrow's tourism, travelling and exploring climatic disasters to detect beauty in these desolate landscapes. Ada questions the human propensity to sink into darkness. It's a form of voyeurism in the face of catastrophe that is quite common in our Western societies.","longdescr":"As part of the ninth edition of the PhotoBrussels Festival, Ada Zieli\u0144ska is invited by La Nombreuse to present her Post Tourism series.\n\nSince 2018, the artist has been playing the game of tomorrow's tourism, travelling and exploring climatic disasters to detect beauty in these desolate landscapes. From forest fires in California to the great floods of Venice in 2019 and the eruption of a volcano in Iceland, Ada Zieli\u0144ska satisfies her curiosity for destruction - the leitmotif at the heart of the beginnings of her artistic practice. Ada questions the human propensity to sink into darkness. It's a form of voyeurism and fascination in the face of catastrophe that is quite common in our Western societies.\n\nThe title of the series, Post Tourism, echoes this phenomenon: that of dark tourism, a tourism which, far from seeking to heal or repair, feeds on the beauty of a ravaged landscape and raises the question of our collective fascination with destruction. These devastated landscapes become sites of contemplation for the artist, where we find ourselves, like spectators, outside the brutal reality. This voyeurism is a societal phenomenon that raises a question: how far can our curiosity about catastrophe go without confronting us with our own responsibility ?\n\nHis photographs are not simply archives of destruction, but a reflection on the fragile beauty of landscapes which, once transformed, become symbols of the end of a cycle. These disasters become a spectacle, an arena for emotional stimulation. \n\nAda Zieli\u0144ska invites us to reflect on the direction the world is taking and our role in this dynamic. Post Tourism is not simply a document of environmental devastation: it is a mirror held up to our times, a reflection on how we view and feel about disasters - and perhaps how indifferent we feel to the suffering of others. \n\nPost Tourism will be revealed in several dimensions at La Nombreuse. Combining installation and photography, the curators, in collaboration with the artist, have taken up the challenge of immersing the viewer sensorially in a sample of a catastrophe.","performers":"Ada Zieli\u0144ska (artist)\n","boxoffice_url":null,"website":"https:\/\/www.instagram.com\/lanombreuse\/","email":"lanombreuse@gmail.com","phone_contact":"+32 479 63 46 94","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700005414"},"it":{"name":"Post Tourism by Ada Zieli\u0144ska","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.instagram.com\/lanombreuse\/","email":"lanombreuse@gmail.com","phone_contact":"+32 479 63 46 94","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700005414"},"cn":{"name":"Post Tourism by Ada Zieli\u0144ska","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.instagram.com\/lanombreuse\/","email":"lanombreuse@gmail.com","phone_contact":"+32 479 63 46 94","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700005414"},"fr":{"name":"Post Tourism par Ada Zieli\u0144ska","shortdescr":"Depuis 2018 l\u2019artiste se pr\u00eate au jeu du tourisme de demain, elle voyage et explore les catastrophes climatiques pour y d\u00e9celer une beaut\u00e9 dans ces paysages de d\u00e9solation. Ada questionne la propension humaine \u00e0 sombrer vers l\u2019obscurit\u00e9. Une forme de voyeurisme de la catastrophe assum\u00e9e qui s\u2019av\u00e8re assez commune dans nos soci\u00e9t\u00e9s occidentales.","longdescr":"La Nombreuse invite Ada Zieli\u0144ska \u00e0 pr\u00e9senter sa s\u00e9rie Post Tourism pour la 9e \u00e9dition du PhotoBrussels Festival.\n\nDepuis 2018, l\u2019artiste se pr\u00eate au jeu du tourisme de demain, elle voyage et explore les catastrophes climatiques pour y d\u00e9celer une beaut\u00e9 dans ces paysages de d\u00e9solation. \nDes feux de for\u00eats en Californie, aux grandes inondations de Venise en 2019 en passant par l\u2019\u00e9ruption d\u2019un volcan en Islande, Ada Zieli\u0144ska satisfait sa curiosit\u00e9 pour la destruction - leitmotiv au c\u0153ur des d\u00e9buts de sa pratique artistique. Ada questionne la propension humaine \u00e0 sombrer vers l\u2019obscurit\u00e9. Une forme de voyeurisme et de fascination de la catastrophe assum\u00e9e qui s\u2019av\u00e8re assez commune dans nos soci\u00e9t\u00e9s occidentales.\n\nLe titre, Post Tourism, fait \u00e9cho \u00e0 ce ph\u00e9nom\u00e8ne : celui d'un \u00ab tourisme de catastrophe \u00bb, qui, loin de chercher \u00e0 gu\u00e9rir ou r\u00e9parer, se nourrit de beaut\u00e9 des paysages ravag\u00e9s et soul\u00e8ve la question de notre fascination collective pour la destruction. Ces environnements d\u00e9vast\u00e9s deviennent des sites de contemplation pour l\u2019artiste, o\u00f9 l\u2019on se retrouve, comme des spectateurs, \u00e0 l\u2019ext\u00e9rieur de la r\u00e9alit\u00e9 brutale. Ce voyeurisme est un ph\u00e9nom\u00e8ne soci\u00e9tal qui soul\u00e8ve une question : jusqu\u2019o\u00f9 notre curiosit\u00e9 pour la catastrophe peut-elle aller sans nous confronter \u00e0 notre propre responsabilit\u00e9 ?\n\nSes photographies ne sont pas simplement des archives de destruction, mais une r\u00e9flexion sur la beaut\u00e9 fragile des paysages qui, une fois transform\u00e9s, deviennent des symboles de la fin d\u2019un cycle. Ces catastrophes deviennent un spectacle, un terrain de stimulation \u00e9motionnelle. \n\nAda Zieli\u0144ska nous invite \u00e0 r\u00e9fl\u00e9chir sur la direction que prend le monde et notre r\u00f4le dans cette dynamique. Post Tourism ne documente pas uniquement les ravages environnementaux : c\u2019est un miroir tendu \u00e0 notre \u00e9poque, une r\u00e9flexion sur la mani\u00e8re dont nous regardons et ressentons les catastrophes \u2013 et peut-\u00eatre sur la mani\u00e8re dont nous nous sentons indiff\u00e9rents aux souffrances des autres. \n\nPost Tourism se r\u00e9v\u00e8lera sous plusieurs dimensions au sein de La Nombreuse. M\u00ealant installation et photographie, les curateurs en collaboration avec l'artiste ont relev\u00e9 le d\u00e9fi de plonger senssoriellement le spectateur\u00b7ice dans l\u2019\u00e9chantillon d\u2019une catastrophe.","performers":"Ada Zieli\u0144ska (artiste)\n","boxoffice_url":null,"website":"https:\/\/www.instagram.com\/lanombreuse\/","email":"lanombreuse@gmail.com","phone_contact":"+32 479 63 46 94","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700005414"},"sp":{"name":"Post Tourism by Ada Zieli\u0144ska","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.instagram.com\/lanombreuse\/","email":"lanombreuse@gmail.com","phone_contact":"+32 479 63 46 94","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700005414"},"nl":{"name":"Post Tourism van Ada Zieli\u0144ska","shortdescr":"Sinds 2018 speelt de kunstenaar het spel van het toerisme van morgen, door te reizen en klimaatrampen te verkennen om schoonheid te ontdekken in deze desolate landschappen. Ada stelt de menselijke neiging om weg te zinken in de duisternis in vraag. Het is een vorm van voyeurisme in het aangezicht van catastrofes die heel gewoon is in onze westerse samenlevingen.","longdescr":"La Nombreuse nodigt Ada Zieli\u0144ska uit om haar Post Tourism-serie te presenteren voor de 9e editie van het PhotoBrussels Festival.\n\nSinds 2018 speelt de kunstenaar het spel van het toerisme van morgen, door te reizen en klimatologische rampen te verkennen om schoonheid te ontdekken in deze desolate landschappen. \nVan bosbranden in Californi\u00eb tot de grote overstromingen van Veneti\u00eb in 2019 en de uitbarsting van een vulkaan in IJsland, Ada Zieli\u0144ska bevredigt haar nieuwsgierigheid naar vernietiging - het leidmotief in het begin van haar artistieke praktijk. Ada bevraagt de menselijke neiging om weg te zinken in de duisternis. Het is een vorm van voyeurisme en fascinatie voor catastrofes die heel gewoon is in onze westerse samenlevingen.\n\nDe titel van de serie, Post Tourism, weerspiegelt dit fenomeen: dat van het duistere toerisme, een toerisme dat, in plaats van te streven naar genezing of herstel, zich voedt met de schoonheid van een verwoest landschap en de vraag oproept naar onze collectieve fascinatie voor vernietiging. Deze verwoeste landschappen worden plekken van contemplatie voor de kunstenaar, waar we ons als toeschouwers buiten de wrede werkelijkheid bevinden. Dit voyeurisme is een maatschappelijk fenomeen dat een vraag oproept: hoe ver kan onze nieuwsgierigheid naar catastrofes gaan zonder ons te confronteren met onze eigen verantwoordelijkheid? Zijn foto's zijn niet simpelweg archieven van vernietiging, maar een reflectie op de fragiele schoonheid van landschappen die, eenmaal getransformeerd, symbolen worden van het einde van een cyclus. Deze rampen worden een spektakel, een arena voor emotionele stimulatie. Ada Zieli\u0144ska nodigt ons uit om na te denken over de richting die de wereld opgaat en onze rol in deze dynamiek. Post Tourism is niet alleen een document van de verwoesting van het milieu: het is een spiegel die onze tijd wordt voorgehouden, een reflectie over hoe we rampen zien en hoe we ons erbij voelen - en misschien hoe onverschillig we zijn tegenover het lijden van anderen. Post Tourism wordt in verschillende dimensies onthuld in La Nombreuse. Door een combinatie van installatie en fotografie zijn de curatoren, in samenwerking met de kunstenaar, de uitdaging aangegaan om de kijker zintuiglijk onder te dompelen in een voorbeeld van een catastrofe.","performers":"Ada Zielinska (kunstenaar)\n","boxoffice_url":null,"website":"https:\/\/www.instagram.com\/lanombreuse\/","email":"lanombreuse@gmail.com","phone_contact":"+32 479 63 46 94","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700005414"}},"place":{"id":277289,"translations":{"de":{"name":"La Nombreuse","address_street_name":"Rue du Fort","address_street_number":"42","address_street_box":null,"email":null,"website":"https:\/\/www.instagram.com\/lanombreuse\/","phone_contact":null,"phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue du Fort, 42","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"La Nombreuse","address_street_name":"Rue du Fort","address_street_number":"42","address_street_box":null,"email":null,"website":"https:\/\/www.instagram.com\/lanombreuse\/","phone_contact":null,"phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue du Fort, 42","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"La Nombreuse","address_street_name":"Rue du Fort","address_street_number":"42","address_street_box":null,"email":null,"website":"https:\/\/www.instagram.com\/lanombreuse\/","phone_contact":null,"phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue du Fort, 42","address_line2":"1060 Saint-Gilles","description_web":"Created in September 2020, La Nombreuse dedicates its time and energy to emerging contemporary photography by organising exhibitions, guided tours, workshops and conferences for a wide range of audiences. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"La Nombreuse","address_street_name":"Rue du Fort","address_street_number":"42","address_street_box":null,"email":null,"website":"https:\/\/www.instagram.com\/lanombreuse\/","phone_contact":null,"phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1"