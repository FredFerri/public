tps:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50008771"},"pt":{"name":"Les survivants invisibles de l\u2019Holocauste","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/mmm.brussels","email":"museum@foyer.be","phone_contact":"+32 2 609 55 61","phone_booking":"+32 2 609 55 61","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50008771"},"en":{"name":"Les survivants invisibles de l\u2019Holocauste","shortdescr":"The MigratieMuseumMigration, the Foyer and its Roma service invite you to the opening of the exhibition \"Invisible Holocaust Survivors - 80 years on, Brussels Roma grandchildren collected their testimonies in Romania\", to be held on International Roma Day, April 8 at 11am at Rue des Ateliers 17, Molenbeek.","longdescr":"The Migration MuseumMigration, Roma Service-Foyer invite you to the opening of the exhibition \"The invisible survivors of the Holocaust - 80 years later Brussels Roma grandchildren gathered their testimonies in Romania \", which will take place on International Roma Day on April 8 at 11:00 a.m. at Rue des Ateliers 17, Molenbeek. This event highlights a story and testimonies that are often unknown but of great importance.\nDuring this opening, you will have the chance to be immersed in a world of testimonies and memories through a poignant exhibition, where photos and videos tell the story of Holocaust survivors, their Brussels Roma grandchildren who collected their stories in Romania.\n\nThe program:\nIntroduction by the Secretary of State for Equal Opportunities.\nPresentation and tour by Costel Nastasie\nReception\n\nThe exhibition will be on display at the MigratieMuseumMigration from April 8 to May 4, 2024.","performers":null,"boxoffice_url":null,"website":"http:\/\/mmm.brussels","email":"museum@foyer.be","phone_contact":"+32 2 609 55 61","phone_booking":"+32 2 609 55 61","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50008771"},"it":{"name":"Les survivants invisibles de l\u2019Holocauste","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/mmm.brussels","email":"museum@foyer.be","phone_contact":"+32 2 609 55 61","phone_booking":"+32 2 609 55 61","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50008771"},"cn":{"name":"Les survivants invisibles de l\u2019Holocauste","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/mmm.brussels","email":"museum@foyer.be","phone_contact":"+32 2 609 55 61","phone_booking":"+32 2 609 55 61","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50008771"},"fr":{"name":"Les survivants invisibles de l\u2019Holocauste","shortdescr":"Le MigratieMuseumMigration, le Foyer et son service Rom vous invitent au vernissage de l\u2019exposition \"Les survivants invisibles de l\u2019Holocauste - 80 ans apr\u00e8s, les petits-enfants bruxellois roms ont r\u00e9colt\u00e9 leurs t\u00e9moignages en Roumanie\u201d, qui se tiendra lors de la journ\u00e9e internationale des Roms le 8 avril \u00e0 11h \u00e0 la Rue des Ateliers 17, \u00e0 Molenbeek.","longdescr":"Le MigratieMuseumMigration, le Foyer et son service Rom vous invitent au vernissage de l\u2019exposition \"Les survivants invisibles de l\u2019Holocauste - 80 ans apr\u00e8s, les petits-enfants bruxellois roms ont r\u00e9colt\u00e9 leurs t\u00e9moignages en Roumanie\u201d, qui se tiendra lors de la journ\u00e9e internationale des Roms le 8 avril \u00e0 11h \u00e0 la Rue des Ateliers 17, \u00e0 Molenbeek. Cet \u00e9v\u00e9nement met en lumi\u00e8re une histoire et des r\u00e9cits m\u00e9connus et d'une grande importance.\nLors de ce vernissage, vous aurez l'opportunit\u00e9 de plonger dans un univers de t\u00e9moignages et de souvenirs \u00e0 travers une exposition poignante, o\u00f9 les photos et vid\u00e9os racontent l'histoire de survivants de l'Holocauste, leurs descendants bruxellois roms ayant recueilli leurs r\u00e9cits en Roumanie.\n\nLe programme :\nIntroduction par la Secr\u00e9taire d\u2019\u00c9tat \u00e0 l\u2019\u00c9galit\u00e9 des Chances\nPr\u00e9sentation et visite guid\u00e9e par Costel Nastasie\nR\u00e9ception\n\nL\u2019exposition sera pr\u00e9sente au MigratieMuseumMigration du 8 avril au 4 mai 2024.","performers":"Costel Nastasie (Roma Dignity)\n","boxoffice_url":null,"website":"http:\/\/mmm.brussels","email":"museum@foyer.be","phone_contact":"+32 2 609 55 61","phone_booking":"+32 2 609 55 61","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50008771"},"sp":{"name":"Les survivants invisibles de l\u2019Holocauste","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/mmm.brussels","email":"museum@foyer.be","phone_contact":"+32 2 609 55 61","phone_booking":"+32 2 609 55 61","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50008771"},"nl":{"name":"Les survivants invisibles de l\u2019Holocauste","shortdescr":"Het MigratieMuseumMigration, Romadienst-Foyer nodigen u uit voor de opening van de tentoonstelling \"De onzichtbare overlevenden van de Holocaust - 80 jaar later verzamelden Brusselse Roma-kleinkinderen hun getuigenissen in Roemeni\u00eb \", die zal plaatsvinden op de Internationale Romadag op 8 april om 11.00 uur in Werkhuizenstraat 17, Molenbeek.","longdescr":"Het MigratieMuseumMigration, Romadienst-Foyer nodigen u uit voor de opening van de tentoonstelling \"De onzichtbare overlevenden van de Holocaust - 80 jaar later verzamelden Brusselse Roma-kleinkinderen hun getuigenissen in Roemeni\u00eb \", die zal plaatsvinden op de Internationale Romadag op 8 april om 11.00 uur in Werkhuizenstraat 17, Molenbeek. Dit evenement belicht een verhaal en getuigenissen die vaak onbekend zijn maar van groot belang.\nTijdens deze opening krijgt u de kans om ondergedompeld te worden in een wereld van getuigenissen en herinneringen via een aangrijpende tentoonstelling, waar foto's en video's het verhaal vertellen van Holocaustoverlevenden, hun Brusselse Roma-kleinkinderen die hun verhalen hebben verzameld in Roemeni\u00eb.\n\nHet programma:\nInleiding door de Staatssecretaris voor Gelijke Kansen\nPresentatie en rondleiding door Costel Nastasie\nReceptie\n\nDe tentoonstelling zal te zien zijn in het MigratieMuseumMigration van 8 april tot 4 mei 2024.","performers":null,"boxoffice_url":null,"website":"http:\/\/mmm.brussels","email":"museum@foyer.be","phone_contact":"+32 2 609 55 61","phone_booking":"+32 2 609 55 61","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50008771"}},"place":{"id":274307,"translations":{"de":{"name":"MigratieMuseumMigration","address_street_name":"rue des ateliers","address_street_number":"17","address_street_box":null,"email":"museum@foyer.be","website":"http:\/\/www.migratiemuseummigration.be","phone_contact":"+32 2 609 55 61","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue des ateliers, 17","address_line2":"1080 Molenbeek-Saint-Jean","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"MigratieMuseumMigration","address_street_name":"rue des ateliers","address_street_number":"17","address_street_box":null,"email":"museum@foyer.be","website":"http:\/\/www.migratiemuseummigration.be","phone_contact":"+32 2 609 55 61","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue des ateliers, 17","address_line2":"1080 Molenbeek-Saint-Jean","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"MigratieMuseumMigration","address_street_name":"rue des ateliers","address_street_number":"17","address_street_box":null,"email":"museum@foyer.be","website":"http:\/\/www.migratiemuseummigration.be","phone_contact":"+32 2 609 