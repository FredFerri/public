r"],"en":["Theatre"],"de":["Theater"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Lectures th\u00e9\u00e2trales par les Universit\u00e9s Populaires du Th\u00e9\u00e2tre","shortdescr":null,"longdescr":"\u00ab Vive l\u2019Ecole Moderne ! \u00bb\r\n\r\nPour leur deuxi\u00e8me ann\u00e9e de collaboration, les Universit\u00e9s Populaires du Th\u00e9\u00e2tre et le WHalll ont d\u00e9cid\u00e9 de proposer au public une trilogie qui vous permettra de d\u00e9couvrir trois grandes figures de p\u00e9dagogues qui ont invent\u00e9 l\u2019Ecole Moderne, parfois au p\u00e9ril de leur vie. En effet, deux de ces trois grands personnages (Janusz Korczak et Francisco Ferrer) sont morts pour leurs convictions et par amour de leurs \u00e9l\u00e8ves. Tous trois ont jet\u00e9 les bases de m\u00e9thodes p\u00e9dagogiques devenues aujourd\u2019hui universelles. \r\n\r\nAu programme:\r\n\r\n- Lundi 10\/10\/2022: Francisco Ferrer - Vive l\u2019Ecole Moderne !  \r\n- Lundi 7\/11\/2022: Korczak, la t\u00eate haute  \r\n- Lundi 23\/01\/2023: Les combats de C\u00e9lestin Freinet","performers":null,"boxoffice_url":null,"website":"http:\/\/www.whalll.be","email":"billetterie@whalll.be","phone_contact":"+32 2 435 59 99","phone_booking":"+32 2 435 59 99","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.539067"},"nl":{"name":"Lectures th\u00e9\u00e2trales par les Universit\u00e9s Populaires du Th\u00e9\u00e2tre","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.539067"},"en":{"name":"Lectures th\u00e9\u00e2trales par les Universit\u00e9s Populaires du Th\u00e9\u00e2tre","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/even