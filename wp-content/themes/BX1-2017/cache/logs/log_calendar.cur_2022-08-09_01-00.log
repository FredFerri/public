608.jpg","width":1000,"height":1414,"ratio":0.71,"translations":{"fr":{"title":"Bruce Ellison & The Jellodies","copyright":null},"nl":{"title":"Bruce Ellison & The Jellodies","copyright":null},"en":{"title":"Bruce Ellison & The Jellodies","copyright":null}}}],"dates":[{"day":"2022-07-30","doors":"18:45:00","start":"20:45:00","end":"22:45:00","is_soldout":false,"is_canceled":false},{"day":"2022-09-16","doors":"18:45:00","start":"20:45:00","end":"22:45:00","is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Cat\u00e9gorie 1"},"nl":{"name":"Categorie 1"},"en":{"name":"Category 1"}},"value":29.5},{"translations":{"fr":{"name":"Cat\u00e9gorie 2"},"nl":{"name":"Categorie 2"},"en":{"name":"Category 2"}},"value":24.5},{"translations":{"fr":{"name":"Etudiants"},"nl":{"name":"Studenten"},"en":{"name":"Students"}},"value":18.5},{"translations":{"fr":{"name":"Article 27"},"nl":{"name":"Artikel 27"},"en":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[476651],"targets":{"list":[7,8,11,10],"translations":{"fr":["Jeunes 12-15 ans","Jeunes 15-18 ans","Famille","Seniors"],"nl":["Jongeren 12-15 j.","Jongeren 15-18 j.","Familie","Senioren"],"en":["Youth 12-15  yr.","Youth 15-18  yr.","Family","Seniors"]}},"tags":["kids"],"accessibilities":{"list":[255,259,265,266],"translations":{"fr":["Accessible","Chien d'assistance","WC adapt\u00e9","Brussels Health Safety Label"],"nl":["Toegankelijk","Assistentiehonden","Aangepast toilet","Brussels Health Safety Label"],"en":["Accessible","Assistance dogs","Adapted toilet","Brussels Health Safety Label"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-08-08T10:05:15+02:00","published_at":"2022-06-13T17:34:24+02:00","backoffice_id":255883,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":0.34430603773932},{"id":535906,"date_start":"2022-08-01","date_end":"2022-09-17","date_next":"2022-09-17","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre"}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Normal!","shortdescr":"Unique comme tout le monde, diff\u00e9rent comme personne!\r\nNormal! est un spectacle sur la diff\u00e9rence, le courage, la tol\u00e9rance et ce qui fait de nous des humains.","longdescr":"Karen De Paduwa nous y raconte avec humour et \u00e9motion, certaines histoires de sa vie de \u00abpremi\u00e8re com\u00e9dienne handicap\u00e9e de Belgique.\u00bb.\r\nCe spectacle mordant, d\u00e9lirant et sensible se veut lever les barri\u00e8res entre les gens dits \u00abnormaux\u00bb et les \u00abmutants\u00bb (nains, g\u00e9ants, porteurs de trisomie 21...) qui peuvent devenir les \u00ab Super-H\u00e9ros \u00bb de nos vies \u00e0 tous.\r\n\r\nKaren de Paduwa pr\u00e9f\u00e8re le m\u00e9gaphone au poing lev\u00e9 pour parler de la diff\u00e9rence mais le titre du spectacle ne laisse pas planer le doute: \u00ab Normal!\u00bb, avec un point d\u2019exclamation s\u2019il vous pla\u00eet. Dans son spectacle, \u00e9motion rime avec humour tout au long de cette partition men\u00e9e tambour battant.\r\nPour Karen, une formule choc d\u00e9crit bien sa carri\u00e8re exemplaire: \u00abUnique comme tout le monde, diff\u00e9rente comme personne\u00bb. C\u2019est ainsi qu\u2019elle souhaite \u00eatre vue, dans chaque pi\u00e8ce, chaque r\u00f4le, chaque r\u00e9plique, non pas en com\u00e9dienne naine, mais en com\u00e9dienne tout court! Elle est \u00e0 deux doigts d\u2019y r\u00e9ussir, mais peut-\u00eatre faudrait-il pour y \u00eatre tout \u00e0 fait que son r\u00eave intime et un peu fou se r\u00e9alise enfin: celui de jouer un des grands r\u00f4les du r\u00e9pertoire, la Roxanne de Cyrano ou la Juliette de Shakespeare. Elle s\u2019y sent parfaitement pr\u00eate. A bon entendeur\u2026\r\n\r\n\u00abQue Thierry Janssen ait \u00e9crit sp\u00e9cialement pour moi, me touche particuli\u00e8rement. Parce que cette diff\u00e9rence, j\u2019en ai fait une force ! Le besoin de partager mon exp\u00e9rience tant personnelle que professionnelle est vital.\u00bb\r\nKaren de Paduwa","performers":"ONE-WOMAN SHOW DE THIERRY JANSSEN\r\nMise en sc\u00e8ne: Gauthier Bourgois \u25aa Avec: Karen De Paduwa","boxoffice_url":"https:\/\/shop.utick.be\/?pos=FESTIVALBRUXELLONS&module=CATALOGUE&lg=FR","website":"http:\/\/www.bruxellons.be","email":"info@bruxellons.net","phone_contact":null,"phone_booking":"+32 2 724 24 24","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.535906"},"nl":{"name":"Normal!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/shop.utick.be\/?pos=FESTIVALBRUXELLONS&module=CATALOGUE&lg=NL","website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.535906"},"en":{"name":"Normal!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/shop.utick.be\/?pos=FESTIVALBRUXELLONS&module=CATALOGUE&lg=EN","website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.535906"},"de":{"name":"Normal!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.535906"},"it":{"name":"Normal!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https