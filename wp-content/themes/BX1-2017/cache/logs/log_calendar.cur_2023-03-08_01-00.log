"end":"13:00:00","is_soldout":false,"is_canceled":false},{"day":"2023-03-21","doors":null,"start":"14:30:00","end":"16:00:00","is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"},"de":{"name":"Normal"},"it":{"name":"Normale"},"sp":{"name":"Normal"},"pt":{"name":"Normal"},"cn":{"name":"Normal"}},"value":5}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":["annee_art_nouveau"],"is_part_of":"Ann\u00e9e Art Nouveau","accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-03-04T04:05:13+01:00","published_at":"2023-03-04T03:30:50+01:00","backoffice_id":272843,"import_origin":"explore","sub_type":"other","show_in_agenda":true,"ranking":1},{"id":552664,"date_start":"2023-03-20","date_end":"2023-03-22","date_next":"2023-03-20","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater","it":"Teatro","sp":"Teatro","pt":null,"cn":null}},"others":{"list":[56],"translations":{"fr":["Mime et th\u00e9\u00e2tre de marionettes"],"nl":["Mime en bewegingstheater"],"en":["Mime and puppet theatre"],"de":["Pantomime & Puppentheater"],"it":["Mimo e teatro delle marionette"],"sp":["Pantomima y teatro de marionetas"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Les petites aventures","shortdescr":"\u00ab Les Petites Aventures \u00bb (60min) est un spectacle interactif tout public comprenant de la pantomime pure et du clownesque, des num\u00e9ros rigoureusement \u00e9crits et des moments d\u2019improvisation, du silence et des classiques de la musique classique\u2026","longdescr":"Pris dans l\u2019engrenage du travail \u00e0 temps plein, Ferdinand a \u00e9t\u00e9 contraint d\u2019abandonner ces deux activit\u00e9s qui donnaient pourtant un sens \u00e0 sa vie : la sc\u00e8ne et la musique classique. Mais, un jour, le destin vient bousculer brutalement son train-train quotidien\u2026\r\n\r\nFerdinand replongera compl\u00e8tement dans l\u2019univers du jeune r\u00eaveur qu\u2019il avait \u00e9t\u00e9. Il retrouvera ses deux passions qu\u2019il avait abandonn\u00e9 et pourra renouer avec elles en exploitant \u00e0 fond sa cr\u00e9ativit\u00e9. Il aura carte blanche ! Mais comment s\u2019y prendra-t-il apr\u00e8s tout ce temps et apr\u00e8s avoir v\u00e9cu une transmutation si brusque et profonde ? Ce qui est certain, c\u2019est qu\u2019il aura l\u2019occasion de se d\u00e9fouler avec son public avec humour, bienveillance, enfance, l\u00e9g\u00e8ret\u00e9 et po\u00e9sie le tout, dans un univers o\u00f9 l\u2019Invisible devient visible et o\u00f9 la musique d\u00e9passe la simple dimension auditive.\r\n\r\n\u00ab Les Petites Aventures \u00bb (60min) est un spectacle interactif tout public comprenant de la pantomime pure et du clownesque, des num\u00e9ros rigoureusement \u00e9crits et des moments d\u2019improvisation, du silence et des classiques de la musique classique\u2026\r\n\r\nPrix : 15\u20ac","performers":"De Nicolas Biebuyck\r\nMise en sc\u00e8ne de Nicolas Biebuyck \/ Regard ext\u00e9rieur de Lulu Derdou\r\nLumi\u00e8res: Romain De Wulf\r\nCie Mime Hic \/ Nicolas Biebuyck","boxoffice_url":null,"website":"http:\/\/www.lafluteenchantee.be","email":"la.flute.enchantee@skynet.be","phone_contact":null,"phone_booking":"+32 2 660 79 50","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.552664"},"nl":{"name":"Les petites aventures","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lafluteenchantee.be","email":"la.flute.enchantee@skynet.be","phone_co