t":"2024-05-28","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-05-19T02:01:27+02:00","published_at":"2023-06-01T10:52:37+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":278357,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"theatre","ranking":0.4694338677084348,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":49,"translations":{"de":"Theater","pt":null,"en":"Theatre","it":"Teatro","cn":null,"fr":"Th\u00e9\u00e2tre","sp":"Teatro","nl":"Theater"}},"others":{"list":[50],"translations":{"de":["Theater"],"pt":[null],"en":["Theatre"],"it":["Teatro"],"cn":[null],"fr":["Th\u00e9\u00e2tre"],"sp":["Teatro"],"nl":["Theater"]}}},"translations":{"de":{"name":"Comme en 14","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatrelepublic.be","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.558357"},"pt":{"name":"Comme en 14","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatrelepublic.be","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.558357"},"en":{"name":"Comme en 14","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatrelepublic.be","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.558357"},"it":{"name":"Comme en 14","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatrelepublic.be","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.558357"},"cn":{"name":"Comme en 14","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatrelepublic.be","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.558357"},"fr":{"name":"Comme en 14","shortdescr":null,"longdescr":"Hiver 1917. Un h\u00f4pital de campagne juste derri\u00e8re les lignes de front. Cent vingt-trois malades pour deux infirmi\u00e8res ! Les temps sont durs. Cependant, quatre femmes et un jeune gar\u00e7on, r\u00e9unis par les hasards de la guerre vont faire la f\u00eate malgr\u00e9 les urgences, les cris des bless\u00e9s et le bruit du canon.\r\nLa vie est plus forte que tout. Alors, \u00e0 la guerre comme \u00e0 la guerre, on fait ce qu\u2019il faut et on rit, on dit des b\u00eatises, on fume les derni\u00e8res cigarettes et on chante. Oui on chante ! Parce qu\u2019il faut bien chanter quand le canon tonne. Pour lui r\u00e9pondre qu\u2019on est vivantes. \r\n\r\nDes femmes dans la guerre qui soignent ceux qui repartiront sit\u00f4t r\u00e9par\u00e9s. Des femmes qui se heurtent : patriotisme ou pacifisme ? Subir ou r\u00e9sister ? Tenir ou plier ? \r\n\r\nUn spectacle lumineux, pourtant. Car toujours, on esp\u00e8re. Toujours on se bat contre la violence avec les outils de la r\u00e9sistance : r\u00e9parer, soulager, partager, ne pas faiblir, \u00eatre debout, r\u00e9sister \u00e0 la fatigue et \u00e0 la peur.\r\nEt on invente la vie qui doit \u00eatre plus forte que la mort, plus puissante que la destruction. Quand l\u2019une flanche, l\u2019autre la r\u00e9cup\u00e8re. Et c\u2019est de \u00e7a qu\u2019elles sont fortes.\r\n\r\nUn spectacle pour toute la famille, dr\u00f4le et tendre parce qu\u2019elles sont \u00e9patantes ces femmes bourr\u00e9es de l\u2019\u00e9nergie que provoquent l\u2019espoir et la volont\u00e9. Car cette guerre-ci sera la Der, c\u2019est s\u00fbr. Ce sera \u00ab la Der des Ders\u2026 \u00bb\r\n__________\r\n\r\nDe Dany Laurent \/ Mise en sc\u00e8ne : Patricia Ide et Serge Demoulin \/ Avec : Laurence D\u2019Amelio, Soazig De Staercke, Laure Godisiabois\r\n__________\r\n\r\nUNE PRODUCTION DU TH\u00c9\u00c2TRE LE PUBLIC. AVEC LE SOUTIEN DU TAX SHELTER DE L\u2019\u00c9TAT F\u00c9D\u00c9RAL BELGE VIA BESIDE ET DE LA COMMUNAUT\u00c9 FRAN\u00c7AISE.\r\n","performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatrelepublic.be","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.558357"},"sp":{"name":"Comme en 14","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatrelepublic.be","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.558357"},"nl":{"name":"Comme en 14","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatrelepublic.be","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.558357"}},"place":{"last_updated_at":"2022-10-10T10:25:09+02:00","published_at":"2013-10-19T01:13:43+02:00","id":224476,"translations":{"de":{"name":"Th\u00e9\u00e2tre Le Public","address_street_name":"Rue Braemt","address_street_number":"64 70","address_street_box":null,"email":"contact@theatrelepublic.be","website":"http:\/\/www.theatrelepublic.be","ph