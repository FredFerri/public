sit.brussels\/pt\/visitors\/agenda\/event-detail.5700004694"},"en":{"name":"Badi","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/www.visit.brussels\/en\/visitors\/agenda\/event-detail\/book-tickets.Badi.5700004694","website":"https:\/\/www.senghor.be\/project\/badi-le-rap-avec-les-enfants\/","email":"reservation@senghor.be","phone_contact":"+32 2 230 31 40","phone_booking":"+32 2 230 31 40","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700004694"},"it":{"name":"Badi","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/www.visit.brussels\/it\/visitatori\/agenda\/event-detail\/book-tickets.Badi.5700004694","website":"https:\/\/www.senghor.be\/project\/badi-le-rap-avec-les-enfants\/","email":"reservation@senghor.be","phone_contact":"+32 2 230 31 40","phone_booking":"+32 2 230 31 40","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700004694"},"cn":{"name":"Badi","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/www.visit.brussels\/en\/visitors\/agenda\/event-detail\/book-tickets.Badi.5700004694","website":"https:\/\/www.senghor.be\/project\/badi-le-rap-avec-les-enfants\/","email":"reservation@senghor.be","phone_contact":"+32 2 230 31 40","phone_booking":"+32 2 230 31 40","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700004694"},"fr":{"name":"Badi","shortdescr":"Le rap avec les enfants.","longdescr":"En tant que figure embl\u00e9matique de la sc\u00e8ne hip-hop belge, Badibanga Ndeka - dit Badi - interroge le monde et bouscule les modes. Dandy fac\u00e9tieux, l\u2019artiste n\u2019a clairement pas sa langue en poche... et c\u2019est tant mieux ! Du genre \u00e0 chanter ce qui se chuchote, \u00e0 dire tout haut les r\u00e9alit\u00e9s du prol\u00e9tariat, il sourit, mais ne se trompe pas.  Biberonn\u00e9 aux clips MTV et \u00e0 la rumba congolaise, l\u2019artiste s\u2019est b\u00e2ti une solide r\u00e9putation et a d\u00e9velopp\u00e9 un son bien \u00e0 lui. Un afro-rap synth\u00e9tique au travers duquel il explore avec une conscience aiguis\u00e9e son histoire familiale et celle de la R\u00e9publique D\u00e9mocratique du Congo. \nLoin des pol\u00e9miques, \u00e0 l\u2019\u00e9cart des statues, il d\u00e9boulonne les pr\u00e9jug\u00e9s, combat l\u2019ignorance via ses chansons et favorise le dialogue interculturel, tout en c\u00e9l\u00e9brant la musique comme un des moyens d\u2019expression les plus beaux et puissants. Fort de son engagement, de la tol\u00e9rance et du vivre ensemble, il propose un projet \u00e9ducatif unique en son genre, souhaitant ardemment partager sa musique et ses messages avec la jeunesse.","performers":"Par : Babi (Ndeka Badibanga)\nGuitare, Clavier : Youri Botteman\nPercussions : Amine Kanzi","boxoffice_url":"https:\/\/www.visit.brussels\/fr\/visiteurs\/agenda\/event-detail\/book-tickets.Badi.5700004694","website":"https:\/\/www.senghor.be\/project\/badi-le-rap-avec-les-enfants\/","email":"reservation@senghor.be","phone_contact":"+32 2 230 31 40","phone_booking":"+32 2 230 31 40","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700004694"},"sp":{"name":"Badi","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/www.visit.brussels\/es\/visitantes\/agenda\/event-detail\/book-tickets.Badi.5700004694","website":"https:\/\/www.senghor.be\/project\/badi-le-rap-avec-les-enfants\/","email":"reservation@senghor.be","phone_contact":"+32 2 230 31 40","phone_booking":"+32 2 230 31 40","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700004694"},"nl":{"name":"Badi","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/www.visit.brussels\/nl\/bezoekers\/agenda\/event-detail\/book-tickets.Badi.5700004694","website":"https:\/\/www.senghor.be\/project\/badi-le-rap-avec-les-enfants\/","email":"reservation@senghor.be","phone_contact":"+32 2 230 31 40","phone_booking":"+32 2 230 31 40","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700004694"}},"place":{"id":9360,"translations":{"de":{"name":"Centre Culturel d'Etterbeek - Le Senghor","address_street_name":"Chauss\u00e9e de Wavre","address_street_number":"366","address_street_box":null,"email":"info@senghor.be","website":"http:\/\/www.senghor.be","phone_contact":"+32 2 230 31 40","phone_booking":"+32 2 230 31 40","address_zip":"1040","address_city":"Etterbeek","address_line1":"Chauss\u00e9e de Wavre, 366","address_line2":"1040 Etterbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Centre Culturel d'Etterbeek - Le Senghor","address_street_name":"Chauss\u00e9e de Wavre","address_street_number":"366","address_street_box":null,"email":"info@senghor.be","website":"http:\/\/www.senghor.be","phone_contact":"+32 2 230 31 40","phone_booking":"+32 2 230 31 40","address_zip":"1040","address_city":"Etterbeek","address_line1":"Chauss\u00e9e de Wavre, 366","address_line2":"1040 Etterbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Le Senghor - Centre Culturel d\u2019Etterbeek","address_street_name":"Chauss\u00e9e de Wavre","address_street_number":"366","address_street_box":null,"email":"info@senghor.be","website":"http:\/\/www.senghor.be","phone_contact":"+32 2 230 31 40","phone_booking":"+32 2 230 31 40","address_zip":"1040","address_city":"Etterbeek","address_line1":"Chauss\u00e9e de Wavre, 366","address_line2":"1040 Etterbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Centre Culturel d'Etterbeek - Le Senghor","address_street_name":"Chauss\u00e9e de Wavre","address_street_number":"366","address_street_box":null,"email":"info@senghor.be","website":"http:\/\/www.sen