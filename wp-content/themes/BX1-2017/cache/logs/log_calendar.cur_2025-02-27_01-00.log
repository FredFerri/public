insi\nqu'une v\u00e9ritable exp\u00e9rience audiovisuelle gr\u00e2ce \u00e0 leur show lumi\u00e8re enti\u00e8rement\ncontr\u00f4l\u00e9 par ordinateur.\nEgo Ego :\nUne signature FrenchTouch m\u00ealant sons organiques et beat \u00e9lectro.\nDerni\u00e8re production des fr\u00e8res Chainis, Ego Ego explore et construit les fondations de sa musique sur des terres balis\u00e9es par les p\u00e8res fondateurs du genre (Justice, Breakbot, Daft Punk, S\u00e9bastian, Cassius).\nSur sc\u00e8ne, les fr\u00e8res d\u00e9ploient leurs talents de multi-instrumentistes pour offrir un show dynamique.","performers":"Royal Cobra : Jean & Emmanuel Prat (Synths)\n\nEgo Ego : Micka & Greg Chainis (Synths)","boxoffice_url":null,"website":null,"email":"jesuisroyalcobra@gmail.com","phone_contact":"+32 493 87 64 34","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700006946"},"sp":{"name":"Royal Cobra Release Party","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"jesuisroyalcobra@gmail.com","phone_contact":"+32 493 87 64 34","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700006946"},"nl":{"name":"Royal Cobra Release Party","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"jesuisroyalcobra@gmail.com","phone_contact":"+32 493 87 64 34","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700006946"}},"place":{"id":273212,"translations":{"de":{"name":"MOTOWN concerts","address_street_name":"Rue Andr\u00e9 Bertulot","address_street_number":null,"address_street_box":null,"email":"motown@creative-district.be","website":"www.instagram.com\/motown.concerts","phone_contact":"+32 2 514 33 41","phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Andr\u00e9 Bertulot","address_line2":"1210 Saint-Josse-Ten-Noode","descri