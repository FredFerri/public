l,null,null,null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2023-03-26T04:07:50+02:00","published_at":"2023-03-07T09:06:21+01:00","backoffice_id":272968,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.37810239113357},{"id":552482,"date_start":"2023-03-08","date_end":"2023-04-28","date_next":"2023-03-27","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung","it":"Esposizioni","sp":"Exhibici\u00f3n","pt":null,"cn":null}},"others":{"list":[36],"translations":{"fr":["Mus\u00e9es et art centers"],"nl":["Musea en kunstcentra"],"en":["Museums and art centers"],"de":["Museen & Kunstzentren"],"it":["Musei e centri artistici"],"sp":["Museos y centros de arte"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"364Elles\/Maternit\u00e9s","shortdescr":"2 expositions : \u201cBirth of a Mother\u201d de Julie Scheurweghs et \u201cD\u2019une histoire \u00e0 l\u2019autre\u201d, des t\u00e9moignages photographiques r\u00e9alis\u00e9s par le Centre Culturel autour de la grossesse et de la maternit\u00e9.","longdescr":"\"Birth of a Mother\"\r\nJulie Scheurweghs, photographe, s\u2019interroge sur l\u2019image de la femme. Toujours li\u00e9e aux \u00e9v\u00e9nements de sa propre vie, sa nouvelle s\u00e9rie porte sur le fait de devenir m\u00e8re. Pour \u201cBirth of a Mother\u201d, Julie Scheurweghs fait le choix de montrer explicitement la maternit\u00e9, sans l\u2019occulter ni la dramatiser, comme une \u00e9tape possible de la vie d\u2019une femme dans laquelle se cachent la transformation et la force. Son \u0153uvre offre diff\u00e9rentes perspectives sur ce que cela repr\u00e9sente d\u2019\u00eatre une femme, brisant ainsi les st\u00e9r\u00e9otypes et montrant que plusieurs identit\u00e9s peuvent \u00eatre associ\u00e9es. Elle remet en question notre vision rigide, guid\u00e9e par des clich\u00e9s reproduits \u00e0 l\u2019infini.\r\n\r\n\"D\u2019une histoire \u00e0 l\u2019autre\"\r\nC\u00e9line Bataille (charg\u00e9e de projet) et Paula Bouffioux (animatrice) du Centre Culturel ont rencontr\u00e9 et photographi\u00e9 des mamans schaerbeekoises et bruxelloises. Celles-ci ont partag\u00e9 leur v\u00e9cu d\u2019une ou de plusieurs grossesses et accouchements, ainsi que leur exp\u00e9rience de maternit\u00e9.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.culture1030.be\/","email":"info@culture1030.be","phone_contact":"+32 2 245 27 25","phone_booking":"+32 2 245 27 25","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.552482"},"nl":{"name":"364Elles\/Maternit\u00e9s","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.culture1030.be\/","email":"info@culture1030.be","phone_contact":"+32 2 245 27 25","phone_booking":"+32 2 245 27 25","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.552482"},"en":{"name":"364Elles\/Maternit\u00e9s","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.culture1030.be\/","email":"info@culture1030.be","phone_contact":"+32 2 245 27 25","phone_booking":"+32 2 245 27 25","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.552482"},"de":{"name":"364Elles\/Maternit\u00e9s","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.culture1030.be\/","email":"info@culture1030.be","phone_contact":"+32 2 245 27 25","phone_booking":"+32 2 245 27 25","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.552482"},"it":{"name":"364Elles\/Maternit\u00e9s","