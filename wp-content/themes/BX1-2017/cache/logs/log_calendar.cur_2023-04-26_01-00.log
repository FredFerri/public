obility aids"],"de":["Barrierefrei","Barrierefreier Parkplatz","Barrierefrei f\u00fcr Fu\u00dfg\u00e4nger mit Gehhilfe"],"it":["Accessibile","Parcheggio accessibile","Accessibile ai pedoni con supporti"],"sp":["Habilitado","Estacionamiento habilitado","Habilitado para peatones con aud\u00edfonos"],"pt":[null,null,null],"cn":[null,null,null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2023-04-23T02:37:25+02:00","published_at":"2021-03-04T11:38:13+01:00","backoffice_id":229509,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.10326933581408},{"id":509506,"date_start":"2021-03-06","date_end":"2025-12-31","date_next":"2023-04-29","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen","it":"Visite guidate","sp":"Visitas guiadas","pt":null,"cn":null}},"others":{"list":[104],"translations":{"fr":["Art Nouveau, Art D\u00e9co"],"nl":["Art nouveau, art deco"],"en":["Art Nouveau, Art D\u00e9co"],"de":["Jugendstil, Art d\u00e9co"],"it":["Art Nouveau, Art D\u00e9co"],"sp":["Art nouveau, art d\u00e9co"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Art Nouveau dans le Quartier des Squares","shortdescr":"On l\u2019appelle la \u201cgalerie de l\u2019Art Nouveau Bruxellois\u201d. D\u00e9couvrez un quartier qui a pris son essort en m\u00eame temps que le courant Art Nouveau, entre la fin du 19\u00e8me et le d\u00e9but du 20\u00e8me si\u00e8cle.","longdescr":"- Visite guid\u00e9e \u00e0 prix libre : payer en fin de tour le prix qui vous semble juste -\r\n\r\nConsid\u00e9r\u00e9 par beaucoup comme \u201cla galerie de l\u2019Art Nouveau bruxellois\u201c, le quartier Nord-Est rec\u00e8le bien des tr\u00e9sors architecturaux qui n\u2019attendent qu\u2019\u00e0 \u00eatre d\u00e9couverts. Alors, si l\u2019envie vous prend, laissez-vous entrainer sur les traces des grands architectes au cours d\u2019une balade dans ce quartier \u00e9clectique.\r\n\r\nD\u00e9couvrez les tr\u00e9sors cach\u00e9s de la ville, des fa\u00e7ades surprenantes, des d\u00e9tails stup\u00e9fiants qui font de l\u2019Art Nouveau un joyaux du patrimoine bruxellois.\r\n\r\nQU\u2019ALLEZ-VOUS D\u00c9COUVRIR ?\r\nLe tour \u201cArt Nouveau dans le quartier des Squares\u201d vous emm\u00e8ne au coeur des squares Marie Louise et Ambiorix, ainsi que dans les rues adja\u00e7antes et met en lumi\u00e8re de nombreuses maisons. Laissez-vous conter l\u2019Histoire des quartiers Nord-Est par le prisme de l\u2019architecture et de l\u2019urbanisme.\r\n\r\nVous ferez ainsi connaissance avec des architectes, connus et moins connus, qui ont marqu\u00e9 ce quartier.\r\n\r\nAu programme de la balade, entre autres\u2026\r\n\r\n\u2013 L\u2019H\u00f4tel Deprez \u2013 Van de Velde, de Victor Horta\r\n\u2013 L\u2019H\u00f4tel Van Eetevelde, de Victor Horta\r\n\u2013 La maison du peintre Georges L\u00e9onard de Saint-Cyr, de Gustave Strauven\r\n\u2013 La Maison Van Dijk, de Gustave Strauven\r\n\u2013 D\u2019autres oeuvres de Van Waesberghe, Victor Taelemans, Georges Hob\u00e9, et bien d\u2019autres\r\n\u2013 Mais aussi de nombreuses petites histoires et anecdotes !\r\n\r\n\r\n\r\nINFORMATIONS PRATIQUES\r\n\r\nTours r\u00e9guliers en fran\u00e7ais et en anglais :\r\nPrix  : Libre et conscient*\r\nDur\u00e9e : Environ 2 heures\r\nRendez-vous : Square Marie Louise (au bas du Square, au pied de la statue), 1000 Bruxelles\r\nFin de la visite : Square Marie Louise\r\n\r\nTour priv\u00e9 sur demande en fran\u00e7ais ou en anglais : info@brusselsbyfoot.com","performers":"Une visite guid\u00e9e originale de l'association de guides ind\u00e9penda