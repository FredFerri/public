:"18:00:00"}]},"sunday":{"is_open":true,"hours":[{"start":"10:00:00","end":"18:00:00"}]}},"translations":{"fr":["lundi: ferm\u00e9","mardi, mercredi, jeudi et vendredi: de 09:30 \u00e0 17:00","samedi et dimanche: de 10:00 \u00e0 18:00"],"nl":["maandag: gesloten","dinsdag, woensdag, donderdag en vrijdag: van 09:30 tot 17:00","zaterdag en zondag: van 10:00 tot 18:00"],"en":["monday: closed","tuesday, wednesday, thursday and friday: from 09:30 to 17:00","saturday and sunday: from 10:00 to 18:00"]},"date_start":"2021-10-13","date_end":"2022-08-07","is_also_by_appointment":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":13},{"translations":{"fr":{"name":"Enfants"},"nl":{"name":"Kinderen"},"en":{"name":"Children"}},"value":5},{"translations":{"fr":{"name":"Senior"},"nl":{"name":"Senioren"},"en":{"name":"Senior"}},"value":10}],"child_events":[],"parent_events":[],"targets":{"list":[16,11,19],"translations":{"fr":["Ecoles","Famille","Enseignants"],"nl":["Scholen","Familie","Leerkrachten"],"en":["Schools","Family","Teachers"]}},"visit_profile":{"list":[337],"translations":{"fr":["Highlight"],"nl":["Highlight"],"en":["Highlight"]}},"tags":["kids"],"accessibilities":{"list":[252,255,256,257,259,261,263,265],"translations":{"fr":["Accessible aux personnes ayant des difficult\u00e9s de compr\u00e9hension","Accessible","Am\u00e9nagements pour les personnes aveugles et malvoyantes","Am\u00e9nagements pour personnes sourdes et malentendantes","Chien d'assistance","Parking accessible","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9"],"nl":["Toegankelijk voor mensen met een verstandelijke beperking","Toegankelijk","Voorzieningen voor blinde en slechtziende personen","Voorzieningen voor dove en slechthorende personen","Assistentiehonden","Toegankelijke parking","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet"],"en":["Accessible to people with intellectual disabilities","Accessible","Facilities for blind and partially-sighted persons","Facilities for deaf and hearing-impaired people","Assistance dogs","Accessible parking","Accessible to pedestrians with mobility aids","Adapted toilet"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-05-18T01:07:28+02:00","published_at":"2021-10-13T15:51:59+02:00","backoffice_id":240976,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.23739028089647},{"id":529997,"date_start":"2022-04-02","date_end":"2022-08-31","date_next":"2022-05-18","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[36,46],"translations":{"fr":["Mus\u00e9es et art centers","Pluridisciplinaire"],"nl":["Musea en kunstcentra","Multidisciplinair"],"en":["Museums and art centers","Multidisciplinary"]}}},"languages":{"spoken":["fr","nl","en","de"],"subtitles":[]},"translations":{"fr":{"name":"Une grande Histoire de la Navigation","shortdescr":"Une exposition exceptionnelle, plus de 200 objets, pr\u00e8s de 30 maquettes, une visite immersive, des d\u00e9cors reconstitu\u00e9s. Remontez le temps pour d\u00e9couvrir cette incroyable aventure de l\u2019humanit\u00e9 que repr\u00e9sente la conqu\u00eate des espaces aquatiques. De la pirogue monoxyle du N\u00e9olithique au cargo voilier de NEOLINE d\u2019aujourd\u2019hui, naviguez sur les flots de l\u2019Histoire pour un voyage \u00e0 couper le souffle.","longdescr":"Les oc\u00e9ans, les mers, les fleuves et les rivi\u00e8res constituent plus de 70 % de la surface du globe. Il y a des milliers d\u2019ann\u00e9es, l\u2019Homme a voulu partir \u00e0 la conqu\u00eate de ces espaces jusque-l\u00e0 inaccessibles.\r\nAu fur et \u00e0 mesure des progr\u00e8s de l\u2019humanit\u00e9 et des \u00e9volutions techniques, des embarcations diverses et vari\u00e9es ont vu le jour afin de permette aux Hommes d\u2019assouvir leur soif de d\u00e9couverte. \r\nSur plus de 1500 m\u00b2, cette exposition conduit le visiteur sur le fil du temps avec des animations, des d\u00e9cors, des maquettes, des objets li\u00e9s \u00e0 la navigation.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.expo-navigationbruxelles.be","email":"reservation@xpo-concept.be","phone_contact":"+32 471 48 65 05","phone_booking":"+32 471 48 65 05","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/529997.html"},"nl":{"name":"Een groots verhaal over de navigatie","shortdescr":"Een uitzonderlijke tentoonstelling, meer dan 200 objecten, ruim 30 maquettes, een meeslepend bezoek, gereconstrueerde decors. Terugkeren in de tijd om dit ongelooflijk avontuur van de verovering van de rivieren, zee\u00ebn en oceanen te ontdekken. Van de boomstamkano uit het Neolithicum tot de zeilende vrachtschepen van vandaag, varen op de golven van de geschiedenis voor een adembenemende reis.","longdescr":"De oceanen, zee\u00ebn, stromen en rivieren vormen meer dan 70% van het aardoppervlak. Enkele duizenden jaren geleden vertrok de mens op verovering van deze tot dan toe onbereikbare en ontoegankelijke ruimtes. \r\nGaandeweg zagen, dankzij de vooruitgang en de technische evoluties, uiteenlopende en verschillende vaartuigen het levenslicht die het de mens mogelijk maakten om die ontdekkingshonger te stillen.\r\nIn een ruimte van 1 500m\u00b2 leidt deze tentoonstelling de bezoeker rond in de tijd met animaties, decors maquettes, en objecten.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.expo-navigatiebrussel.be","email":"info@xpo-concept.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/529997.html"},"en":{"name":"A great story of the navigation","shortdescr":"An exceptional exhibition, over 200 items, about 30 scale models, an immersive tour, recreated settings. Go back in time to discover this incredible adventure of humanity that the conquest of aquatic spaces represents. From the Neolithic\u2019s dugout canoe to today\u2019s sailing cargo ship from NEOLINE, sail on the streams of History for a breathtaking journey.","longdescr":"Oceans, seas, rivers and rivers make up more than 70% of the world\u2019s surface. Thousands of years ago, man wanted to conquer these previously inaccessible spaces. \r\nAs humanity\u2019s progress and technical developments have progressed, various and varied boats have been created to enable men to satisfy their thirst for discovery.\r\nCovering more than 1500 m\u00b2, this exhibition will lead the visitor over time. Animations, sets, dynamic legends will immerse them in the atmosphere of navigation.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/529997.html"},"de":{"name":"Une grande Histoire de la Navigation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/529997.html"},"it":{"name":"Une grande Histoire de la Navigation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/529997.html"},"sp":{"name":"Une grande Histoire de la Navigation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/529997.html"},"pt":{"name":"Une grande Histoire de la Navigation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"