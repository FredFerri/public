manche: ferm\u00e9"],"nl":["maandag, dinsdag, woensdag, donderdag en vrijdag: van 10:00 tot 16:00","zaterdag en zondag: gesloten"],"en":["monday, tuesday, wednesday, thursday and friday: from 10:00 to 16:00","saturday and sunday: closed"],"de":["monday, tuesday, wednesday, thursday and friday: from 10:00 to 16:00","saturday and sunday: closed"],"it":["monday, tuesday, wednesday, thursday and friday: from 10:00 to 16:00","saturday and sunday: closed"],"sp":["monday, tuesday, wednesday, thursday and friday: from 10:00 to 16:00","saturday and sunday: closed"],"pt":["monday, tuesday, wednesday, thursday and friday: from 10:00 to 16:00","saturday and sunday: closed"],"cn":["monday, tuesday, wednesday, thursday and friday: from 10:00 to 16:00","saturday and sunday: closed"]},"date_start":"2023-03-08","date_end":"2023-04-28","is_also_by_appointment":false}],"date_exceptions":[{"day":"2023-03-08","start":"18:00:00","end":"21:00:00"},{"day":"2023-04-08","start":"14:00:00","end":"16:00:00"},{"day":"2023-04-09","start":"14:00:00","end":"16:00:00"}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"opening":{"day":"2023-03-08","start":"18:00:00","timestamp":"2023-03-08T18:00:00+01:00","end":"21:00:00","is_only_by_appointment":false},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-04-25T03:06:09+02:00","published_at":"2023-02-24T12:30:36+01:00","backoffice_id":272482,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.33974515584373},{"id":555055,"date_start":"2023-04-21","date_end":"2023-05-17","date_next":"2023-04-25","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung","it":"Esposizioni","sp":"Exhibici\u00f3n","pt":null,"cn":null}},"others":{"list":[36,46],"translations":{"fr":["Mus\u00e9es et art centers","Pluridisciplinaire"],"nl":["Musea en kunstcentra","Multidisciplinair"],"en":["Museums and art centers","Multidisciplinary"],"de":["Museen & Kunstzentren","Multidisziplin\u00e4r"],"it":["Musei e centri artistici","Multidisciplinare"],"sp":["Museos y centros de arte","Multidisciplinar"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Franck Sarfati - Multipli*cities","shortdescr":"Le Parlement de la communaut\u00e9 flamande de Bruxelles, rue du Lombard 67, pr\u00e9sente deux projets de Franck Sarfati comprenant de grandes installations en porcelaine de Limoges.","longdescr":"Multipli*cities. 2 Projets. Archipels et Peaceful Megastructures.\r\nArchipels : Une tr\u00e8s grande installation de 487 sculptures en porcelaine de Limoges \u00e9maill\u00e9e [ 700 x 260 cm ], ainsi que diff\u00e9rentes d\u00e9clinaisons de plus petits formats, et d'autres sur papier Japon.\r\nPeaceful Megastructures : Une installation d\u2019une micro \/ giga\u00a0\/ m\u00e9galopole constitu\u00e9e de 238 sculptures en porcelaine de Limoges [ 215 x 113 cm ], ainsi que trois autres compositions de taille plus restreinte compos\u00e9es de 151 megastructures.\r\n\r\nIl y a 10 ans, dans son studio de cr\u00e9ation graphique, Franck Sarfati instaure, uniquement pour lui-m\u00eame, le \"Sculptural Friday\". D\u00e8s cet instant, il consacrera \r\nun jour par semaine \u00e0 cette passion qui deviendra rapidement un m\u00e9tier.\r\nQuelques ann\u00e9es plus tard, Franck Sarfati instaure chaque semaine la \"Scuptural Week\", tout son temps \u00e9tant d\u00e9sormais consacr\u00e9 \u00e0 la sculpture.\r\nC\u2019est le d\u00e9but d\u2019une carri\u00e8re enti\u00e8rement vou\u00e9e \u00e0 l\u2019art.","performers":"Le Parlement de la communaut\u00e9 flamande de Bruxelles; Franck Sarfati.","boxoffice_url":null,"website":"http:\/\/www.francksarfati.be","email":"vivafff@skynet.be","phone_contact":"+32 477 50 88 89","phone_booking":"+32 477 50 88 89","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.555055"},"nl":{"name":"Franck Sarfati - Multipli*cities","shortdescr":"De Raad van de Vlaamse Gemeenschapscommissie (Brussel Parlement), Lombardstraat 67, stelt twee projecten van Franck Sarfati voor waaronder grote Limoges-porselein installaties.","longdescr":"Multipli*cities. 2 Projecten. Archipels en Peaceful Megastructures.\r\nArchipels : Een grote installatie van 487 ge\u00ebmailleerde sculpturen van Limoges-porselein [ 700 x 260 cm ], evenals verschillende versies van kleinere formaten en andere op Japans papier.\r\nPeaceful Megastructures : de compositie van een micro \/ giga \/ megalopool bestaande uit 238 sculpturen [ 215 x 113 cm ], alsook verzamelingen van beperkter formaat bestaande uit 151 megastructuren.\r\n\r\nTien jaar geleden startte Franck Sarfati in zijn ontwerpstudio met \"Sculptural Friday\", een project puur voor zichzelf. Een dag per week gaf hij zich over aan zijn passie.\r\nJaren later veranderde die dag in een \"Sculptural Week\". Vanaf dan besteedde hij al zijn tijd aan zijn beeldhouwwerk.\r\nHet begin van een carri\u00e8re gewijd aan de kunst.","performers":"De Raad van de Vlaamse Gemeenschapscommissie (Brussel Parlement); Franck Sarfati.","boxoffice_url":null,"website":"http:\/\/www.francksarfati.be","email":"vivafff@skynet.be","phone_contact":"+32 477 50 88 89","phone_booking":"+32 477 50 88 89","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.555055"},"en":{"name":"Franck Sarfati - Multipli*cities","shortdescr":"The Brussels Parliament (flemish community), rue du Lombard 67, presents two projects by Franck Sarfati including large Limoges Porcelain installations.","longdescr":"Multipli*cities. 2 Projects. Archipelagos and Peaceful Megastructures.\r\nArchipelagos : A very large installation of  487 sculptures made of glazed Limoges porcelain [ 700 x 260 cm ], as well as various declinations of smaller sizes, and others on japanese paper.\r\nPeaceful Megastructures : a composition of a micro \/ giga \/ megacity consisting of 238 sculptures made of Limoges porcelain [ 215 x 113 cm ], as well as three other compositions of smaller size composed of 150 megastructures.\r\n\r\nTen years ago, in his creative graphic design studio, Franck Sarfati instituted the \"Sculptural Friday\" just for himself. From that moment on, he devoted one day a week to this passion which quickly became a profession.\r\nA few years later, Franck Sarfati instituted a weekly \"Sculptural Week\", with all his time now devoted to sculpture.\r\nThis was the beginning of a career entirely devoted to art.","performers":"The Brussels Parliament (flemish community); Franck Sarfati.","boxoffice_url":null,"website":"http:\/\/www.francksarfati.be","email":"vivafff@skynet.be","phone_contact":"+32 477 50 88 89","phone_booking":"+32 477 50 88 89","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.555055"},"de":{"name":"Franck Sarfati - Multipli*cities","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.francksarfati.be","email":"vivafff@skynet.be","phone_contact":"+32 477 50 88 89","phone_booking":"+32 477 50 88 89","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.555055"},"it":{"name":"Franck Sarfati - Multipli*cities","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.francksarfati.be","email":"vivafff@skynet.be","phone_contact":"+32 477 50 88 89","phone_booking":"+32 477 50 88 89","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.555055"},"sp":{"name":"Franck Sarfati - Multipli*cities","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\