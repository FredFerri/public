n nouveau regard","longdescr":"Le public est invit\u00e9 \u00e0 plusieurs reprises pendant le spectacle \u00e0 partager avec les com\u00e9dien.ne.s une histoire v\u00e9cue qui le \u00ab touche \u00bb. L\u2019id\u00e9e n\u2019est pas de rejouer la situation racont\u00e9e mais bien de proposer un \u00ab autre miroir \u00bb de ce qui a \u00e9t\u00e9 partag\u00e9.\r\n\r\nDe mani\u00e8re humoristique, l\u00e9g\u00e8re, intuitive, la troupe accentue ou simplifie certains traits des personnes devenues personnages, invente des parties d\u2019histoire inexistantes, projette la situation dans une autre \u00e9poque, un autre lieu pour faire voyager le public, lui faire prendre de la hauteur. Ce dispositif propose donc des versions sans doute non imagin\u00e9es et \u00e9tonnantes.","performers":"Fanny Forton, Renaud Aubecq, Marie Bodart, Audrey Delhaye, Sarah Heymans, Louise M\u00e9trich, S\u00e9bastien Gratoir","boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Improference-172.html","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.539250"},"nl":{"name":"Improference","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.539250"},"en":{"name":"Improference","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.539250"},"de":{"name":"Improference","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.539250"},"it":{"name":"Improference","shortdescr":null,"longdescr":null,"performers":nul