ree":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre"}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Ceci n'est pas un r\u00eave","shortdescr":"Le r\u00e9cit de l\u2019Histoire au f\u00e9minin, qui se d\u00e9ploie au c\u0153ur d\u2019une amiti\u00e9 fantasm\u00e9e entre les peintres surr\u00e9alistes Leonora Carrington et L\u00e9onor Fini.","longdescr":"Leonora Carrington et Leonor Fini se sont rencontr\u00e9es \u00e0 Saint-Martin-d\u2019Ard\u00e8che \u00e0 l\u2019aube de la Seconde Guerre mondiale. Auteures d\u2019\u0153uvres puissantes, les deux peintres partagent leur lutte acharn\u00e9e pour exister au c\u0153ur du mouvement surr\u00e9aliste trop connu comme \u00e9tant principalement masculin.\r\n\r\nDans une \u00e9poque violente et troubl\u00e9e, Ceci n\u2019est pas un r\u00eave commence \u00e0 cet endroit \u00e9trange, celui du \u00ab et si\u2026 \u00bb, inventant \u00e0 ces deux artistes une nouvelle relation s\u2019\u00e9panouissant sous le soleil de l\u2019Ard\u00e8che. Un mirage historique qui \u00e9merge dans les yeux d\u2019Alice, photographe reporter fatigu\u00e9e des impond\u00e9rables li\u00e9s \u00e0 la presse actuelle et qui, surprise par l\u2019intensit\u00e9 de cette rencontre onirique, se d\u00e9couvre elle-m\u00eame habit\u00e9e d\u2019un nouvel espace o\u00f9 chaque geste, chaque mot et chaque \u00e9change est source de fascination. Avec elle, nous plongeons petit \u00e0 petit dans cette amiti\u00e9 forte, sensuelle et fantasm\u00e9e, entre l\u2019extravagante Leonora Carrington et la fantaisiste Leonor Fini.\r\nUne r\u00e9\u00e9criture de l\u2019histoire r\u00e9v\u00e9lant deux phares du surr\u00e9alisme et interrogeant la fa\u00e7on dont la narration des \u00e9v\u00e8nements influence notre vision du monde. Ceci n\u2019est pas un r\u00eave nous entra\u00eene dans l\u2019exploration d\u2019un imaginaire empreint d\u2019un mouvement artistique et d\u2019une \u00e9poque douloureuse, au gr\u00e9 de la po\u00e9sie des \u0153uvres et de leur onirisme latent.","performers":"TEXTE Christine Delmotte-Weber JEU Ana Rodriguez (Leonora), Anne Sylvain (Alice), St\u00e9phanie Van Vyve (Leonor) MISE EN SC\u00c8NE Christine Delmotte-Weber","boxoffice_url":null,"website":"http:\/\/www.theatre-martyrs.be","email":"billetterie@theatre-martyrs.be","phone_contact":null,"phone_booking":"+32 2 223 32 08","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/522716.html"},"nl":{"name":"Ceci n'est pas un r\u00eave","shortdescr":"Het verhaal van de Geschiedenis tussen vrouwen, die zich ontvouwt mindenin een gefantaseerde vriendschap tussen de surrealistische schilderessen Leonora Carrington en L\u00e9onor Fini.","longdescr":"-","performers":"-","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/522716.html"},"en":{"name":"Ceci n'est pas un r\u00eave","shortdescr":"History with an \u2018F\u2019 as in \u2018female\u2019, which unfolds in the fantasized friendship between the surrealist painters Leonora Carrington and Leonor Fini.","longdescr":"-","performers":"-","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/522716.html"},"de":{"name":"Ceci n'est pas un r\u00eave","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/522716.html"},"it":{"name":"Ceci n'est pas un r\u00eave","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/522716.html"},"sp":{"name":"Ceci n'est pas un r\u00eave","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/522716.html"},"pt":{"name":"Ceci n'est pas un r\u00eave","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/522716.html"},"cn":{"name":"Ceci n'est pas un r\u00eave","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/522716.html"}},"place":{"id":231711,"translations":{"fr":{"name":"Th\u00e9\u00e2tre des Martyrs","address_street_name":"Place des Martyrs","address_street_number":"22","address_street_box":null,"email":"billetterie@theatre-martyrs.be","website":"http:\/\/www.theatre-martyrs.be","phone_contact":"+32 2 223 32 08","phone_booking":"+32 2 223 32 08","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Martyrs, 22","address_line2":"1000 Bruxelles","description_web":"Plac\u00e9 aujourd\u2019hui sous la direction artistique de Philippe Sireuil, le Th\u00e9\u00e2tre des Martyrs se d\u00e9finit aujourd\u2019hui comme un th\u00e9\u00e2tre mais pluriel, une sc\u00e8ne et des artistes.\r\nIl affirme ainsi le m\u00e9tissage des origines de cet art n\u00e9 \u00e0 c\u00f4t\u00e9 du forum grec ou sur le parvis de l\u2019\u00e9glise m\u00e9di\u00e9vale et dont il est l\u2019un des multiples h\u00e9ritiers, reprenant le t\u00e9moin de cet art qui, de tout temps, a rec\u00e9l\u00e9 toutes les peines et toutes les joies, tous les conflits et tous les d\u00e9bats de notre condition humaine, rires et larmes m\u00eal\u00e9s.\r\nIl comporte deux salles de spectacles : la grande salle, dite \u00e0 l\u2019italienne entre 255 (parterre) et 356 places (avec le balcon) et la petite salle destin\u00e9e \u00e0 des projets plus intimistes.","description_print":"Plac\u00e9 aujourd\u2019hui sous la direction artistique de Philippe Sireuil, le Th\u00e9\u00e2tre des Martyrs se d\u00e9finit aujourd\u2019hui comme un th\u00e9\u00e2tre mais pluriel, une sc\u00e8ne et des artistes.\r\nIl affirme ainsi le m\u00e9tissage des origines de cet art n\u00e9 \u00e0 c\u00f4t\u00e9 du forum grec ou sur le parvis de l\u2019\u00e9glise m\u00e9di\u00e9vale et dont il est l\u2019un des multiples h\u00e9ritiers, reprenant le t\u00e9moin de cet art qui, de tout temps, a rec\u00e9l\u00e9 toutes les peines et toutes les joies, tous les conflits et tous les d\u00e9bats de notre condition humaine, rires et larmes m\u00eal\u00e9s.\r\nIl comporte deux salles de spectacles : la grande salle, dite \u00e0 l\u2019italienne de 366 places, et la petite salle destin\u00e9e \u00e0 des projets plus intimistes.","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Th\u00e9\u00e2tre des Martyrs","address_street_name":"Martelaarsplein","address_street_number":"22","address_street_box":null,"email":"billetterie@theatre-martyrs.be","website":"http:\/\/www.theatre-martyrs.be","phone_contact":"+32 2 223 32 08","phone_booking":"+32 2 223 32 08","address_zip":"1000","address_city":"Brussel","address_line1":"Martelaarsplein, 22","address_line2":"1000 Brussel","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Th\u00e9\u00e2tre des Martyrs","address_street_name":"Place des Martyrs","address_street_number":"22","address_street_box":null,"email":"billetterie@theatre-martyrs.be","website":"http:\/\/www.theatre-martyrs.be","phone_contact":"+32 2 223 32 08","phone_booking":"+32 2 223 32 08","address_zip":"1000","address_city":"Brussels","address_line1":"Place des Martyrs, 22","address_line2":"1000 Brussels","description_web