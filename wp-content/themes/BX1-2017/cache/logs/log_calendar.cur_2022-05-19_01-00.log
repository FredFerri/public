lse,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{"list":[109],"translations":{"fr":["Espaces verts"],"nl":["Groene zones"],"en":["Green spaces"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Garden Tales \u2013 Ville verte","shortdescr":"Garden Tales est un \u00e9v\u00e9nement annuel gratuit qui vous propose de visiter des jardins priv\u00e9s et publics \u00e0 Bruxelles.","longdescr":"Ce samedi 21 mai, Garden Tales se d\u00e9cline sous le th\u00e8me Ville Verte. Venez d\u00e9couvrir quelques-uns de ces lieux qui font \u00e9voluer le paysage de Bruxelles depuis une centaine d\u2019ann\u00e9es vers une ville toujours plus en faveur de la nature et la biodiversit\u00e9, et leurs bienfaits sur l\u2019Humain.\r\n_\r\nD\u00e9couvrez tous les jardins sur le site web du CIVA.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.civa.brussels\/fr\/expos-events\/garden-tales","email":"info@civa.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/533453.html"},"nl":{"name":"Garden Tales \u2013 De groene stad","shortdescr":"Garden Tales is een jaarlijks evenement waarbij je gratis heel wat priv\u00e9- en publieke tuinen in Brussel kan bezoeken.","longdescr":"Op zaterdag 21 mei zet Garden Tales de groene stad in de kijker. Je ontdekt er een reeks plekken die het Brusselse landschap de afgelopen eeuw mee hebben vormgegeven als een stad die oog heeft voor natuur en biodiversiteit... en het welzijn van de mens!\r\n_\r\nOntdek alle tuinen op de CIVA-website.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.civa.brussels\/nl\/expo-events\/garden-tales","email":"info@civa.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/533453.html"},"en":{"name":"Garden Tales \u2013 Green city","shortdescr":"Garden Tales is a free yearly festival that turns the spotlight on private and public gardens in Brussels.","longdescr":"On Saturday 21 May, Garden Tales will take as its theme the \u2018Green City\u2019. Come and discover some of the places that have been changing the Brussels landscape over the past century, as the city becomes more and more in sync with nature and biodiversity and becomes aware of their benefits for humankind.\r\n_\r\nDiscover the full program on the CIVA-website.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.civa.brussels\/en\/exhibitions-events\/garden-tales","email":"info@civa.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/533453.html"},"de":{"name":"Garden Tales \u2013 Ville verte","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/533453.html"},"it":{"name":"Garden Tales \u2013 Ville verte","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/533453.html"},"sp":{"name":"Garden Tales \u2013 Ville verte","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/533453.html"},"pt":{"name":"Garden Tales \u2013 Ville verte","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/533453.html"},"cn":{"name":"Garden Tales \u2013 Ville verte","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/533453.html"}},"place":{"id":235577,"translations":{"fr":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"CIVA est un muse\u0301e, un centre d'archives, une bibliothe\u0300que et un lieu de rencontre pour les amateurs d'architecture, d'architecture paysage\u0300re, d'e\u0301cosyste\u0300mes urbains et d'histoire a\u0300 Bruxelles. Tout au long de l'anne\u0301e, vous pouvez vous y rendre pour des expositions temporaires, des confe\u0301rences, des de\u0301bats, des visites guide\u0301es, des lancements de livres et des activite\u0301s pour les enfants. Les activite\u0301s se trouvent a\u0300 Ixelles, pre\u0300s de la Place Flagey et au centre de Bruxelles, a\u0300 KANAL - Centre Pompidou.\r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"CIVA","address_street_name":"Kluisstraat","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"Kluisstraat","address_line2":"1050 Elsene","description_web":"CIVA is een museum, een archiefcentrum, een bibliotheek en een ontmoetingsplek voor liefhebbers van architectuur, landschapsarchitectuur, stadsecosystemen en geschiedenis in Brussel. Het hele jaar door kan je er terecht voor tijdelijke tentoonstellingen, lezingen, debatten, rondleidingen, book launches en kinderactiviteiten. De activiteiten vind je in Elsene, vlakbij het Flageyplein en in Brussel-centrum, in KANAL \u2013 Centre Pompidou.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"CIVA is a museum, an archive center, a library and a meeting place for lovers of architecture, landscape architecture, urban ecosystems and history in Brussels. Throughout the year, CIVA organizes temporary exhibitions, lectures, debates, guided tours, book launches and activities for children. The activities are organized in Ixelles, near Place Flagey and in the center of Brussels, in KANAL - Centre Pompidou.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"Das Architekturzentrum CIVA, das 2016 auf Betreiben der Region Br\u00fcssel-Hauptstadt ins Leben gerufen wurde, vereint in einer einzigen Struktur Ressourcen, Wissen und Know-how verschiedener Br\u00fcsseler Vereine aus dem Bereich Kultur, Architektur, St\u00e4dteplanung, Landschaftsarchitektur und Forschungen zum \u00d6kosystem: die Archive f\u00fcr moderne Architektur, die Bibliothek Ren\u00e9 Pech\u00e8re, der Architekturfonds und das Centre Paul Duvigneaud.\r\nMit ihrem kulturellen Projekt tr\u00e4gt die Fondation CIA zur Entwicklung einer architektonischen, landschaftsarchitektonischen und st\u00e4dteplanerischen Kultur bei, die sich mit den Herausforderungen der Gegenwart auseinandersetzt. Schwerpunkt ist Br\u00fcssel. \r\n\r\nDie Fondation CIVA bietet eine ganze Reihe von Aktivit\u00e4ten und Angeboten: Ausstellungen, Konferenzen, Orte des Austauschs und der Debatten, p\u00e4dagogische Aktivit\u00e4ten, Archiveinblicke und Bibliotheken mit knapp 40.000 Werken und Zeitschriften zu den Themen Architektur, St\u00e4dteplanung, Stadtgeschichte, Landschaften, G\u00e4rten und urbane \u00d6kosysteme.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"Creado en 2016 por iniciativa de la Regi\u00f3n Bruselas-Capital, el CIVA re\u00fane una \u00fanica estructura de recursos, conocimiento y aprendizaje de varias asociaciones culturales activas en Bruselas en los campos de la arquitectura, urbanismo, paisajes y el estudio de ecosistemas: los Archivos de Arquitectura Moderna, la Biblioteca Ren\u00e9 Pech\u00e8re, los Fondos para la arquitectura, el Centro Paul Duvigneaud y el CIVA asbl, ahora disuelto.\r\nA trav\u00e9s de este proyecto cultural, la Fundaci\u00f3n CIVA contribuye al desarrollo del paisaje arquitect\u00f3nico y la cultura urbana como base para afrontar desaf\u00edos contempor\u00e1neos, poniendo especial \u00e9nfasis en Bruselas.\r\nSiempre tiene \u00e9xito a la hora de cumplir sus objetivos y tratar con un p\u00fablico amplio (adultos y ni\u00f1os, estudiantes, investigadores, arquitectos, paisajistas, amantes de la naturaleza, pol\u00edticos, etc), la fundaci\u00f3n CIVA organiza numerosos eventos y actividades en diferentes lugares, incluyendo exhibiciones permanentes y temporales, conferencias, debates y actividades educativas. Tambi\u00e9n dispone archivos excepcionales abiertos para todos los p\u00fablicos (documentos de arquitectos y paisajistas: planos, bocetos, modelos, muebles, etc.) y librer\u00edas que contienen casi 40.000 obras y peri\u00f3dicos de arquitectura, urbanismo, la historia de los pueblos y ciudades, paisajes, jardines y ecolog\u00eda urbana.\r\nEstas actividades y materiales est\u00e1n dise\u00f1ados para despertar la curiosidad y el inter\u00e9s de todo nuestro entorno, ya sea un hecho hist\u00f3rico o una construcci\u00f3n.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[5],"translations":{"fr":["Flagey"],"nl":["Flagey"],"en":["Flagey"]}},"zones":{"list":[21],"translations":{"fr":["Sud"],"nl":["Zuid"],"en":["South"]}},"neca":null,"facebook_id":null,"backoffice_id":1436,"location":{"lat":50.82873218,"lon":4.36569034},"region":"brussels","last_updated_at":"2022-05-10T15:05:15+02:00","published_at":"2013-10-19T01:14:20+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":235577,"translations":{"fr":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"CIVA est un muse\u0301e, un centre d'archives, une bibliothe\u0300que et un lieu de rencontre pour les amateurs d'architecture, d'architecture paysage\u0300re, d'e\u0301cosyste\u0300mes urbains et d'histoire a\u0300 Bruxelles. Tout au long de l'anne\u0301e, vous pouvez vous y rendre pour des expositions temporaires, des confe\u0301rences, des de\u0301bats, des visites guide\u0301es, des lancements de livres et des activite\u0301s pour les enfants. Les activite\u0301s se trouvent a\u0300 Ixelles, pre\u0300s de la Place Flagey et au centre de Bruxelles, a\u0300 KANAL - Centre Pompidou.\r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"CIVA","address_street_name":"Kluisstraat","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"Kluisstraat","address_line2":"1050 Elsene","description_web":"CIVA is een museum, een archiefcentrum, een bibliotheek en een ontmoetingsplek voor liefhebbers van architectuur, landschapsarchitectuur, stadsecosystemen en geschiedenis in Brussel. Het hele jaar door kan je er terecht voor tijdelijke tentoonstellingen, lezingen, debatten, rondleidingen, book launches en kinderactiviteiten. De activiteiten vind je in Elsene, vlakbij het Flageyplein en in Brussel-centrum, in KANAL \u2013 Centre Pompidou.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"CIVA is a museum, an archive center, a library and a meeting place for lovers of architecture, landscape architecture, urban ecosystems and history in Brussels. Throughout the year, CIVA organizes temporary exhibitions, lectures, debates, guided tours, book launches and activities for children. The activities are organized in Ixelles, near Place Flagey and in the center of Brussels, in KANAL - Centre Pompidou.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"Das Architekturzentrum CIVA, das 2016 auf Betreiben der Region Br\u00fcssel-Hauptstadt ins Leben gerufen wurde, vereint in einer einzigen Struktur Ressourcen, Wissen und Know-how verschiedener Br\u00fcsseler Vereine aus dem Bereich Kultur, Architektur, St\u00e4dteplanung, Landschaftsarchitektur und Forschungen zum \u00d6kosystem: die Archive f\u00fcr moderne Architektur, die Bibliothek Ren\u00e9 Pech\u00e8re, der Architekturfonds und das Centre Paul Duvigneaud.\r\nMit ihrem kulturellen Projekt tr\u00e4gt die Fondation CIA zur Entwicklung einer architektonischen, landschaftsarchitektonischen und st\u00e4dteplanerischen Kultur bei, die sich mit den Herausforderungen der Gegenwart auseinandersetzt. Schwerpunkt ist Br\u00fcssel. \r\n\r\nDie Fondation CIVA bietet eine ganze Reihe von Aktivit\u00e4ten und Angeboten: Ausstellungen, Konferenzen, Orte des Austauschs und der Debatten, p\u00e4dagogische Aktivit\u00e4ten, Archiveinblicke und Bibliotheken mit knapp 40.000 Werken und Zeitschriften zu den Themen Architektur, St\u00e4dteplanung, Stadtgeschichte, Landschaften, G\u00e4rten und urbane \u00d6kosysteme.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"Creado en 2016 por iniciativa de la Regi\u00f3n Bruselas-Capital, el CIVA re\u00fane una \u00fanica estructura de recursos, conocimiento y aprendizaje de varias asociaciones culturales activas en Bruselas en los campos de la arquitectura, urbanismo, paisajes y el estudio de ecosistemas: los Archivos de Arquitectura Moderna, la Biblioteca Ren\u00e9 Pech\u00e8re, los Fondos para la arquitectura, el Centro Paul Duvigneaud y el CIVA asbl, ahora disuelto.\r\nA trav\u00e9s de este proyecto cultural, la Fundaci\u00f3n CIVA contribuye al desarrollo del paisaje arquitect\u00f3nico y la cultura urbana como base para afrontar desaf\u00edos contempor\u00e1neos, poniendo especial \u00e9nfasis en Bruselas.\r\nSiempre tiene \u00e9xito a la hora de cumplir sus objetivos y tratar con un p\u00fablico amplio (adultos y ni\u00f1os, estudiantes, investigadores, arquitectos, paisajistas, amantes de la naturaleza, pol\u00edticos, etc), la fundaci\u00f3n CIVA organiza numerosos eventos y actividades en diferentes lugares, incluyendo exhibiciones permanentes y temporales, conferencias, debates y actividades educativas. Tambi\u00e9n dispone archivos excepcionales abiertos para todos los p\u00fablicos (documentos de arquitectos y paisajistas: planos, bocetos, modelos, muebles, etc.) y librer\u00edas que contienen casi 40.000 obras y peri\u00f3dicos de arquitectura, urbanismo, la historia de los pueblos y ciudades, paisajes, jardines y ecolog\u00eda urbana.\r\nEstas actividades y materiales est\u00e1n dise\u00f1ados para despertar la curiosidad y el inter\u00e9s de todo nuestro entorno, ya sea un hecho hist\u00f3rico o una construcci\u00f3n.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virt