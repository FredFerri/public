02:07:37+01:00","published_at":"2021-06-16T12:32:30+02:00","backoffice_id":233441,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.10233859542617},{"id":545065,"date_start":"2023-03-09","date_end":"2023-03-12","date_next":"2023-03-09","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":70,"translations":{"fr":"Foire & salon","nl":"Beurzen & salons","en":"Fairs and shows","de":"Messe & Ausstellung","it":"Fiere ed esposizioni","sp":"Feria y exhibici\u00f3n","pt":null,"cn":null}},"others":{}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Collectible 2023 - Design Fair","shortdescr":"La foire internationale COLLECTIBLE, d\u00e9di\u00e9e au design de collection du 21e si\u00e8cle, revient pour une 6\u00e8me \u00e9dition du 9 au 12 mars 2022 \u00e0 Tour & Taxis \u00e0 Bruxelles. COLLECTIBLE r\u00e9unit des acteurs d\u2019exception, galeries, studios de design, architectes et des institutions.","longdescr":"La foire internationale COLLECTIBLE, d\u00e9di\u00e9e au design de collection du 21e si\u00e8cle, revient pour une 6\u00e8me \u00e9dition du 9 au 12 mars 2022 \u00e0 Tour & Taxis \u00e0 Bruxelles. COLLECTIBLE r\u00e9unit des acteurs d\u2019exception, galeries, studios de design, architectes et des institutions. Tout en conservant ses sections actuelles qui ont fait le succ\u00e8s de la foire jusqu'\u00e0 pr\u00e9sent (MAIN, BESPOKE et CURATED), COLLECTIBLE lance cette ann\u00e9e deux nouvelles sections; NEW GARDE, d\u00e9di\u00e9e aux galeries \u00e9mergentes et Architect \u21d4 Designer, de\u0301die\u0301e aux architectes et designers d\u2019inte\u0301rieur montrant des pie\u0300ces de mobilier re\u0301cemment de\u0301veloppe\u0301es.","performers":null,"boxoffice_url":null,"website":"https:\/\/collectible.design\/","email":"info@collectible.design","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.545065"},"nl":{"name":"Collectible 2023 - Design Fair","shortdescr":"COLLECTIBLE, de internationale beurs voor 21ste-eeuws collectible design, kondigt trots haar 6e editie aan die van 9 tot 12 maart 2023 in Tour & Taxis te Brussel zal plaatsvinden. COLLECTIBLE brengt een verfijnde selectie van gevestigde en opkomende galeries, ontwerpstudio's, en toonaangevende architecten samen.","longdescr":"COLLECTIBLE, de internationale beurs voor 21ste-eeuws collectible design, kondigt trots haar 6e editie aan die van 9 tot 12 maart 2023 in Tour & Taxis te Brussel zal plaatsvinden. COLLECTIBLE brengt een verfijnde selectie van gevestigde en opkomende galeries, ontwerpstudio's, en toonaangevende architecten samen. De MAIN, BESPOKE en CURATED secties vormen het hart van COLLECTIBLE. Speciaal voor deze zesde editie lanceert COLLECTIBLE twee nieuwe secties: NEW GARDE gewijd aan opkomende galeries; Architect \u21d4 Designer gewijd aan architecten en interieurontwerpers die graag hun recente meubelontwerpen willen tonen.","performers":null,"boxoffice_url":null,"website":"https:\/\/collectible.design\/","email":"info@collectible.design","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.545065"},"en":{"name":"Collectible 2023 - Design Fair","shortdescr":"The international fair COLLECTIBLE, dedicated to 21st century collectible design, returns for a 6th edition from 9 to 12 March 2022 at Tour & Taxis in Brussels. COLLECTIBLE features a refined selection of established and emerging galleries, design studios, independent editors and leading architects.","longdescr":"The international fair COLLECTIBLE, dedicated to 21st century collectible design, returns for a 6th edition from 9 to 12 March 2022 at Tour & Taxis in Brussels. COLLECTIBLE features a refined selection of established and emerging galleries, design studios, independent editors and leading architects. The MAIN, BESPOKE and CURATED sections form the heart of COLLECTIBLE. To mark its 6th edition, COLLECTIBLE launches two new sections: NEW GARDE dedicated to emerging galleries; and Architect \u21d4 Designer dedicated to architects and interior designers who wish to showcase furniture they recently developed.","performers":null,"boxoffice_url":null,"website":"https:\/\/collectible.design\/","email":"info@collectible.design","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.545065"},"de":{"name":"Collectible 2023 - Design Fair","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/collectible.design\/","email":"info@collectible.design","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.545065"},"it":{"name":"Collectible 2023 - Design Fair","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/collectible.design\/","email":"info@collectible.design","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.545065"},"sp":{"name":"Collectible 2023 - Design Fair","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/collectible.design\/","email":"info@collectible.design","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.545065"},"pt":{"name":"Collectible 2023 - Design Fair","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/collectible.design\/","email":"info@collectible.design","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.545065"},"cn":{"name":"Collectible 2023 - Design Fair","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/collectible.design\/","email":"info@collectible.design","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.545065"}},"place":{"id":222762,"translations":{"fr":{"name":"Tour & Taxis","address_street_name":"Avenue du Port","address_street_number":"86c","address_street_box":null,"email":null,"website":"http:\/\/www.tour-taxis.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue du Port, 86c","address_line2":"1000 Bruxelles","description_web":"L\u2019ancienne plateforme logistique de Tour & Taxis datant du d\u00e9but du 20\u00e8me si\u00e8cle offre des immeubles d\u2019envergure et d\u2019une haute qualit\u00e9 architecturale : l\u2019Entrep\u00f4t Royal, les Sheds, l\u2019H\u00f4tel des Douanes, l\u2019H\u00f4tel de la Poste et la Gare Maritime. Tout en respectant leur authenticit\u00e9 et leur valeur historique, une r\u00e9interpr\u00e9tation contemporaine est donn\u00e9e \u00e0 ces immeubles h\u00e9rit\u00e9s du si\u00e8cle pass\u00e9. Ils connaissent d\u00e9sormais des affectations multiples : expositions, \u00e9v\u00e9nements, espaces de travail, espaces commerciaux, services...\r\nLe site est id\u00e9alement situ\u00e9 sur le parcours touristique bruxellois, entre la vieille ville (Grand-Place, Manneken Pis \u2026) et d\u2019autres attractions touristiques telles que l\u2019Atomium.\r\nLes espaces verts et le parc \u00e9volutif sont des \u00e9l\u00e9ments centraux et inh\u00e9rents \u00e0 la philosophie de d\u00e9veloppement. Ils offrent des lieux de d\u00e9tente et de divertissement.\r\nTour & Taxis devient donc un quartier multifonctionnel r\u00e9invent\u00e9 avec des logements, de la culture, des espaces de travail, cr\u00e9ant une alternative positive pour les visiteurs \u00e0 la recherche de nouvelles exp\u00e9riences.\r\nDans un cadre inspirant, les Sheds accueillent des \u00e9v\u00e9nements incontournables et attirent de nombreux visiteurs.\r\nGr\u00e2ce aux diff\u00e9rents restaurants, bars et activit\u00e9s sur le site, il y a toujours une exp\u00e9rience \u00e0 vivre.\r\n\r\nT&T vous propose de d\u00e9couvrir l\u2019h\u00e9ritage industriel du site \u00e0 l\u2019aide de l\u2019App avec audio-guide, plan et photos. T\u00e9l\u00e9chargez l\u2019App gratuitement via le lien suivant : www.tt-app.be\r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Tour & Taxis","address_street_name":"Havenlaan","address_street_number":"86c","address_street_box":null,"email":null,"website":"http:\/\/www.tour-taxis.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Havenlaan, 86c","address_line2":"1000 Brussel","description_web":"Het voormalige logistieke platform van Tour & Taxis uit de vroege jaren van de 20e eeuw  bestaat uit gebouwen met hoge architectonische kwaliteit: het Koninklijk Pakhuis, de Sheds, het H\u00f4tel des Douanes, het H\u00f4tel de la Poste en de Gare Maritime zijn stuk voor stuk erfgoedparels.  Dit patrimonium kreeg met respect  voor historische waarde en oog voor authenticiteit een nieuwe eigentijdse invulling met  tentoonstellingen, evenementen, kantoren, coworking, retail, services ...\r\nDe site sluit nauw aan bij het toeristisch parcours tussen het historische stadscentrum (Grote Markt, Manneken Pis ...) en andere bezienswaardigheden zoals het Atomium. Het bevindt zich ook op wandelafstand van het toekomstige nieuwe museum voor moderne en hedendaagse kunst.\r\nDe groene ruimtes en het moderne park bieden ruimte aan ontspanning en vrijetijdsactiviteiten.\r\nTour & Taxis wordt een vooruitstrevende participatieve wijk met woningen, cultuur, workspaces, food hall \u2026 die een uitvalsbasis vormt voor de bezoekers op zoek naar nieuwe ervaringen. Zo vinden er in de Sheds uiteenlopende topbeurzen plaats. Dankzij die grote diversiteit aan activiteiten, restaurants, bars en talloze andere activiteiten op de site valt er steeds iets te beleven.\r\n\r\nTour&Taxis biedt u de mogelijkheid om het industrieel patrimonium van de site te ontdekken aan de hand van een App met audio-guide en foto\u2019s. U kunt de App gratis downloaden op: www.tt-app.be\r\n \r\n ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Tour & Taxis","address_street_name":"Avenue du Port","address_street_number":"86c","address_street_box":null,"email":null,"website":"http:\/\/www.tour-taxis.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Avenue du Port, 86c","address_line2":"1000 Brussels","description_web":"The historical logistics platform of Tour & Taxis presents a number of buildings of exceptional size and architectural value: the Royal Depot, the Sheds, the H\u00f4tel des Douanes, the H\u00f4tel de la Poste and the Gare Maritime. A modern interpretation is given to the historic buildings on the Tour & Taxis site, with great respect for their authenticity and heritage value.\r\nThe site is ideally located on the tourist routes, between the Brussels old city centre and other tourist attactions such as the Atomium.\r\nThe green areas and the evolutionary park are central features and an inherent part of the philosophy behind the Tour & Taxis development.\r\nTour & Taxis is becoming a reinvented neighbourhood with residences, culture, offices and public services all in one, creating a positive alternative for people looking for new experiences. The Sheds welcome different major events including antique and art fairs.\r\nWith eateries, bars and activities on the site, there\u2019s something to suit everyone\u2019s taste.\r\n\r\nTour & Taxis offers you the chance to discover the industrial heritage of this unique site using our App, which comprises of an audio guide working together with historic photos. You can download our App for free at: www.tt-app.be","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Tour & Taxis","address_street_name":"Avenue du Port","address_street_number":"86c","address_street_box":null,"email":null,"website":"http:\/\/www.tour-taxis.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue du Port, 86c","address_line2":"1000 Bruxelles","description_web":"Die ehemalige Logistikplattform mit Zolldepot Tour & Taxis, die Anfang des 20. Jahrhunderts erbaut und intensiv genutzt wurde, bietet eine ganze Reihe eindrucksvoller Geb\u00e4ude von hoher architektonischer Qualit\u00e4t: Entrep\u00f4t Royal, Sheds, H\u00f4tel des Douanes, H\u00f4tel de la Poste und Gare Maritime. Unter Ber\u00fccksichtigungen der urspr\u00fcnglichen Architektur und des besonderen historischen Wertes erhielt das Geb\u00e4ude nun eine zeitgem\u00e4\u00dfe Neuinterpretation und erf\u00fcllt inzwischen mehrere Aufgaben: Ausstellungen, Veranstaltungen, Arbeitsbereiche, Gesch\u00e4ftsr\u00e4ume, Dienstleistungen...\r\n\r\nDie Gr\u00fcnfl\u00e4chen und der sich entwickelnde Park als Orte der Entspannung und Unterhaltung sind zentrale Elemente des neuen Konzepts.\r\n\r\nDas industrielle Erbe von Tour & Taxis k\u00f6nnen Sie auch \u00fcber die App mit Audio-Guide, Karte und Fotos entdecken. Laden Sie die kostenlose App \u00fcber den folgenden Link herunter: www.tt-app.be\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Tour & Taxis","address_street_name":"Avenue du Port","address_street_number":"86c","address_street_box":null,"email":null,"website":"http:\/\/www.tour-taxis.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue du Port, 86c","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Tour & Taxis","address_street_name":"Avenue du Port","address_street_number":"86c","address_street_box":null,"email":null,"website":"http:\/\/www.tour-taxis.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue du Port, 86c","address_line2":"1000 Bruxelles","description_web":"La hist\u00f3rica plataforma log\u00edstica de Tour & Taxis presenta un n\u00famero de edificios de gran envergadura y valor arquitect\u00f3nico: Royal Depot, Sheds, H\u00f4tel des Douanes, H\u00f4tel de la Poste y Gare Maritime. Se le da una interpretaci\u00f3n moderna a los edifcios hist\u00f3ricos de Tour & Taxis, respetando su autenticidad y valor patrimonial.\r\nEl lugar est\u00e1 idealmente localizado en las rutas tur\u00edsticas, entre la parte antigua de la ciudad y otros lugares de inter\u00e9s tur\u00edstico tales como el Atomium.\r\nLas zonas verdes y el parque, que est\u00e1 en constante evoluci\u00f3n, son las principales caracter\u00edsticas y una parte inherente de la filosof\u00eda que hay detr\u00e1s del desarrollo de Tour & Taxis.\r\nTour & Taxis se est\u00e1 convirtiendo en un nuevo vecindario con residencias, cultura, oficinas y servicios p\u00fablicos todo en uno, creando una alternativa positiva para aquella gente que busca nuevas experiencias. El edificio Sheds acoge diferentes eventos de gran envergadura, incluyendo ferias de arte y antig\u00fcedades.\r\n\u00a1En los restaurantes, bares y actividades que hay en el lugar encontrar\u00e1s cosas para todos los gustos!\r\n\r\nTour & Taxis te ofrece la oportunidad de descubrir el patrimonio industrial de este lugar \u00fanico usando nuestra aplicaci\u00f3n, que incluye una audiogu\u00eda junto con fotos hist\u00f3ricas. Puedes descargar la aplicaci\u00f3n de manera gratuita aqu\u00ed: www.tt-app.be\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Tour & Taxis","address_street_name":"Avenue du Port","address_street_number":"86c","address_street_box":null,"email":null,"website":"http:\/\/www.tour-taxis.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue du Port, 86c","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Tour & Taxis","address_street_name":"Avenue du Port","address_street_number":"86c","address_street_box":null,"email":null,"website":"http:\/\/www.tour-taxis.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue du Port, 86c","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[8],"translations":{"fr":["Canal"],"nl":["Kanaalwijk"],"en":["Canal"],"de":["Kanal-Viertel"],"it":["Canal"],"sp":["Canal"],"pt":[null],"cn":[null]}},"zones":{"list":[20],"translations":{"fr":["Nord"],"nl":["Noord"],"en":["North"],"de":["Norden"],"it":["Nord"],"sp":["Norte"],"pt":[null],"cn":[null]}},"neca":null,"facebook_id":null,"backoffice_id":658,"location":{"lat":50.86573978,"lon":4.3509828},"region":"brussels","last_updated_at":"2023-02-27T14:35:10+01:00","published_at":"2013-10-19T01:13:42+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":271472,"translations":{"fr":{"name":"collectible","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":"info@collectible.design","website":"https:\/\/collectible.design\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"collectible","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"vi