22T11:05:59+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":291432,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.37982106198575216,"languages":{"spoken":["nl","en","fr"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[36],"translations":{"de":["Museen & Kunstzentren"],"pt":[null],"en":["Museums and art centers"],"it":["Musei e centri artistici"],"cn":[null],"fr":["Mus\u00e9es et art centers"],"sp":["Museos y centros de arte"],"nl":["Musea en kunstcentra"]}}},"translations":{"de":{"name":"Encore et Encore","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lamaisondesarts.be\/encore-et-encore\/","email":"info@lamaisondesarts.be","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 99","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50005615"},"pt":{"name":"Encore et Encore","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lamaisondesarts.be\/encore-et-encore\/","email":"info@lamaisondesarts.be","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 99","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50005615"},"en":{"name":"Encore et Encore","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lamaisondesarts.be\/encore-et-encore\/","email":"info@lamaisondesarts.be","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 99","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50005615"},"it":{"name":"Encore et Encore","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lamaisondesarts.be\/encore-et-encore\/","email":"info@lamaisondesarts.be","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 99","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50005615"},"cn":{"name":"Encore et Encore","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lamaisondesarts.be\/encore-et-encore\/","email":"info@lamaisondesarts.be","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 99","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50005615"},"fr":{"name":"Encore et Encore, Rituels d'artistes","shortdescr":"Rituels d'artistes","longdescr":"La Maison des Arts propose une exposition autour de la th\u00e9matique des rituels. Le rituel se lit ici non pas au sens religieux, m\u00eame si une dimension m\u00e9taphysique peut y \u00eatre associ\u00e9e, mais dans la r\u00e9p\u00e9tition d\u2019actions investies d\u2019un sens particulier et qui s\u2019inscrivent dans le temps.\n\nCette exposition interroge les pratiques artistiques associ\u00e9es \u00e0 des protocoles. Pourquoi certains artistes plasticiens cherchent-ils \u00e0 \u00abrefaire\u00bb, \u00e0 reprendre le m\u00eame geste ou le m\u00eame motif ? Quand et pourquoi d\u00e9bute un rituel artistique et o\u00f9 s\u2019arr\u00eate-t-il ?\n\nElle interroge aussi les pratiques de tout un chacun, tout \u00e0 fait personnelles ou reconnues de tous, comme par exemple gratter un billet de lotto toujours de fa\u00e7on identique pour conjurer le sort\u2026\n\nA travers les \u0153uvres d\u2019une dizaine d\u2019artistes qui cr\u00e9ent, au fil des jours ou des ann\u00e9es, en additionnant une \u0153uvre \u00e0 une autre, l\u2019exposition est l\u2019occasion de se rendre compte de nos propres rituels, gestes r\u00e9p\u00e9t\u00e9s, trajets, traditions, qu\u2019ils soient individuels ou collectifs, conscients ou non.\n\n\nJuan d\u2019OULTREMONT, Yves GOBART, Barbara IWEINS, C\u00f4me LEQUIN, Katherine LONGLY, C\u00e9cile HUPIN, Roman OPALKA, Laurent QUILLET, Sahar SA\u00c2DAOUI, Vincent SOLHEID, Marie VAN ELDER, Claude VIALLAT\n\n& L\u2019Heure atelier Asbl\n\n23.02.2024  05.05.2024\n\nHEURES D'OUVERTURE\nMardi au vendredi de 11h > 17h \/ Weekend de 11h > 18h\n\nVERNISSAGE\n23.02.24 \u2013 18:00 > 21:00\n\nCopyright: Barbara Iweins, Katalog (La cave)(d\u00e9tail). Courtesy of Le Hangar Bruxelles.\n","performers":null,"boxoffice_url":null,"website":"https:\/\/lamaisondesarts.be\/encore-et-encore\/","email":"info@lamaisondesarts.be","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 99","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50005615"},"sp":{"name":"Encore et Encore","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lamaisondesarts.be\/encore-et-encore\/","email":"info@lamaisondesarts.be","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 99","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50005615"},"nl":{"name":"Keer op keer, Rituelen van kunstenaars","shortdescr":"Rituelen van kunstenaars","longdescr":"La Maison des Arts organiseert een tentoonstelling over rituelen. Nee, we hebben het hier niet over religieuze rituelen, al is een metafysische insteek nooit uitgesloten. Het gaat om handelingen die een zekere betekenis hebben en die keer op keer worden herhaald.\n\nDe tentoonstelling belicht kunstvormen die verlopen volgens een protocol. Waarom willen sommige beeldende kunstenaars hun werk \u2018overdoen\u2019? Waarom herhalen ze gebaren of motieven? Waar en waarom begint een artistiek ritueel en waar stopt het?\n\nZe buigt zich ook over persoonlijke of daarentegen wijd verspreide gewoontes, zoals altijd op dezelfde manier over een krasbiljet gaan omdat dat geluk zou brengen \u2026\n\nDe werken van een tiental kunstenaars die dagen- of jarenlang het ene werk na het andere maken, doen ons stilstaan bij onze eigen rituelen, herhaalde gebaren, gewoontes en tradities, of die nu individueel of collectief, bewust of onbewust zijn.\n\n\nJuan d\u2019OULTREMONT, Yves GOBART, Barbara IWEINS, C\u00f4me LEQUIN, Katherine LONGLY, C\u00e9cile HUPIN, Roman OPALKA, Laurent QUILLET, Sahar SA\u00c2DAOUI, Vincent SOLHEID, Marie VAN ELDER, Claude VIALLAT\n\n& L\u2019Heure atelier Asbl\n\n23.02.2024  05.05.2024\n\nOPENINGSTIJDEN\nDinsdag to vrijdag: 11u > 17u \/ Week-end: 11u > 18u\n\nVERNISSAGE\n23.02.24 \u2013 18:00 > 21:00\n\nCopyright: Barbara Iweins, Katalog (La cave)(d\u00e9tail). Courtesy of Le Hangar Bruxelles.","performers":null,"boxoffice_url":null,"website":"https:\/\/lamaisondesarts.be\/encore-et-encore\/","email":"info@lamaisondesarts.be","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 99","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50005615"}},"place":{"id":222932,"translations":{"de":{"name":"Maison des Arts","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 147","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Maison des Arts","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 147","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Maison des Arts","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 147","address_line2":"1030 Schaerbeek","description_web":"The MdA is run and staffed by the Francophone Cultural Service of Schaerbeek Council and is a unique place whose activities are mainly concerned with the creation of works of contemporary art with a significant partnership programme that promotes access for all to contemporary art.\r\n\r\nThe MdA has hosted a rich programme of artistic activities since the 1950s when the building was purchased by Schaerbeek Council. In 2005, the MdA began a programme of inviting artists to work in building, to build more coherence between their works of art and the MdA.\r\n\r\nMost recently, in 2016, Schaerbeek Council decided to position the MdA as a centre for the creation, diffusion and promotion of culture, contemporary two-dimensional, three-dimensional and digital art.\r\nThe MdA\u2019s educational and social approach aims to promoting equality of access to art and its introduction to new audiences.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Maison des Arts","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 147","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Maison des Arts","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 147","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Maison des Arts","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 147","address_line2":"1030 Schaerbeek","description_web":"La Maison des Arts, anim\u00e9e par le Service Culture fran\u00e7aise de la Commune de Schaerbeek, est un espace singulier dont les activit\u00e9s sont principalement ax\u00e9es sur la cr\u00e9ation contemporaine dans le domaine des arts plastiques avec un important programme de m\u00e9diation permettant l\u2019acc\u00e8s de l\u2019art contemporain \u00e0 tous.\r\n\r\nLa MA conna\u00eet une riche activit\u00e9 artistique depuis les ann\u00e9es \u201950, \u00e9poque \u00e0 laquelle la commune rach\u00e8te le b\u00e2timent. En 2005, elle se voit prendre un premier tournant en proposant aux artistes de travailler in situ, afin d\u2019\u00e9tablir une r\u00e9elle coh\u00e9rence entre l\u2019\u0153uvre et la Maison.\r\nEt finalement, c\u2019est en 2016 que la Commune de Schaerbeek d\u00e9cide de la positionner dans le domaine des arts plastiques, contemporains et num\u00e9riques comme un lieu de cr\u00e9ation, de diffusion et de rayonnement culturel.\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Maison des Arts","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 147","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Huis der Kunsten","address_street_name":"Haachtsesteenweg","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaarbeek","address_line1":"Haachtsesteenweg, 147","address_line2":"1030 Schaarbeek","description_web":"La Maison des Arts, geanimeerd door de dienst Franstalige Cultuur van de gemeente Schaarbeek, is een heel bijzondere plek. De activiteiten zijn vooral gericht op hedendaagse creativiteit in de plastische kunsten.\r\n\r\nIn La Maison des Arts heerst reeds sedert 1950 ( datum waarop de gemeente het huis aankocht) een ruime artistieke activiteit. In 2005 is er een belangrijke ontwikkeling : het voorstel aan de kunstenaars om ter plaatse te werken, teneinde een echte samenhang te bereiken tussen het werk en het Huis. Uiteindelijk beslist de Gemeente Schaarbeek er een echte broeikast van te maken in het domein van de beeldende kunsten, een bron van schepping, verspreiding en culturele uitstraling.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[20],"translations":{"de":["Norden"],"pt":[null],"en":["North"],"it":["Nord"],"cn":[null],"fr":["Nord"],"sp":["Norte"],"nl":["Noord"]}},"neca":null,"facebook_id":null,"backof