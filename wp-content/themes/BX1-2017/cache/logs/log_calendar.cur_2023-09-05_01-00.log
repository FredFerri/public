sition-juif\/","email":"info@cclj.be","phone_contact":"+32 2 543 02 70","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50001671"},"pt":{"name":"Visite guid\u00e9e de l'exposition \"Juif?\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/cclj.be\/exposition-juif\/","email":"info@cclj.be","phone_contact":"+32 2 543 02 70","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50001671"},"en":{"name":"Visite guid\u00e9e de l'exposition \"Juif?\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/cclj.be\/exposition-juif\/","email":"info@cclj.be","phone_contact":"+32 2 543 02 70","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50001671"},"it":{"name":"Visite guid\u00e9e de l'exposition \"Juif?\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/cclj.be\/exposition-juif\/","email":"info@cclj.be","phone_contact":"+32 2 543 02 70","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50001671"},"cn":{"name":"Visite guid\u00e9e de l'exposition \"Juif?\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/cclj.be\/exposition-juif\/","email":"info@cclj.be","phone_contact":"+32 2 543 02 70","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50001671"},"fr":{"name":"Visite guid\u00e9e de l'exposition \"Juif?\"","shortdescr":"Visite guid\u00e9e de l'exposition p\u00e9dagogique \"Juif?\" sur l\u2019histoire des st\u00e9r\u00e9otypes et des pr\u00e9jug\u00e9s \u00e0 l\u2019encontre de la communaut\u00e9 juive, de l\u2019Empire Romain \u00e0 nos jours. A partir de 16 ans.\n","longdescr":"Visite interactive de l\u2019exposition p\u00e9dagogique \u201cJuif?\u201d sur les st\u00e9r\u00e9otypes antis\u00e9mites, de l\u2019antiquit\u00e9 \u00e0 nos jours. Conseill\u00e9e \u00e0 partir de 16 ans.\n\nLes Juifs sont-ils riches ? Contr\u00f4lent-ils le monde et les m\u00e9dias ? Sont-ils responsables de la pand\u00e9mie de Covid-19 ?\nCes st\u00e9r\u00e9otypes, vous les avez d\u00e9j\u00e0 entendus. Sachez qu\u2019ils ne datent pas d\u2019hier !\n\nL\u2019exposition \u201cJuif?\u201d est l\u00e0 pour nous le rappeler. Elle retrace l\u2019histoire des st\u00e9r\u00e9otypes et des pr\u00e9jug\u00e9s \u00e0 l\u2019encontre de la communaut\u00e9 juive, de l\u2019Empire Romain \u00e0 nos jours.\n\nTestez et approfondissez vos connaissances sur ce sujet aussi vaste que complexe \u00e0 travers des photos, des vid\u00e9os et des r\u00e9cits.\n\nL\u2019exposition est conseill\u00e9e \u00e0 un public \u00e2g\u00e9 de plus de 16 ans.\n\nChaque visite comprend une projection du film \"Masel Tov cocktail\" (30') de Mickey Paatzsch et Arkadij Khaet, 2020.\n\nVisites pour les groupes scolaires et associatifs sur rendez-vous.","performers":null,"boxoffice_url":null,"website":"https:\/\/cclj.be\/exposition-juif\/","email":"info@cclj.be","phone_contact":"+32 2 543 02 70","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50001671"},"sp":{"name":"Visite guid\u00e9e de l'exposition \"Juif?\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/cclj.be\/exposition-juif\/","email":"info@cclj.be","phone_contact":"+32 2 543 02 70","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50001671"},"nl":{"name":"Visite guid\u00e9e de l'exposition \"Juif?\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/cclj.be\/exposition-juif\/","email":"info@cclj.be","phone_contact":"+32 2 543 02 70","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50001671"}},"place":{"i