false},{"day":"2022-10-01","doors":null,"start":"13:00:00","end":"18:00:00","is_soldout":false,"is_canceled":false},{"day":"2022-10-07","doors":null,"start":"13:00:00","end":"18:00:00","is_soldout":false,"is_canceled":false},{"day":"2022-10-08","doors":null,"start":"13:00:00","end":"18:00:00","is_soldout":false,"is_canceled":false},{"day":"2022-10-14","doors":null,"start":"13:00:00","end":"20:00:00","is_soldout":false,"is_canceled":false},{"day":"2022-10-15","doors":null,"start":"13:00:00","end":"18:00:00","is_soldout":false,"is_canceled":false},{"day":"2022-10-21","doors":null,"start":"13:00:00","end":"18:00:00","is_soldout":false,"is_canceled":false},{"day":"2022-10-22","doors":null,"start":"13:00:00","end":"18:00:00","is_soldout":false,"is_canceled":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"opening":{"day":"2022-09-15","start":"20:00:00","timestamp":"2022-09-15T20:00:00+02:00","end":"22:00:00","is_only_by_appointment":true},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-09-25T02:05:06+02:00","published_at":"2022-09-08T15:24:31+02:00","backoffice_id":261362,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.30010006671856},{"id":539387,"date_start":"2022-09-16","date_end":"2022-10-22","date_next":"2022-09-30","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":true,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[24,25],"translations":{"fr":["Galeries d'art","Arts audiovisuels"],"nl":["Galeries","Audiovisuele kunst"],"en":["Art Galleries","Audiovisual art"]}}},"languages":{"spoken":["en","fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Suspended territories by Thibaut de Lestr\u00e9","shortdescr":"Thibaut de Lestr\u00e9 is exhibiting with us for the 1st time and we are thrilled about it. His work \"Suspended territories\" is a clever way to make us think about what's next. Come and see...","longdescr":"The photographs of the \u201cSuspended Territories\u201d series are intriguing images that open up an imaginary space to wander. At the edge of the surreal, the pictures of Thibaut de Lestr\u00e9 are activating and playing with subconscious perception.\r\nThe traces of our absence are sublimated in the images of the \u201cSuspended territories\u201d expo to offer a reflection map on our behavioral ambivalence in the Anthropocene era.\r\n\r\nThe AAA UNICUM image for example, where a picture of flattened can functions as a contemporary fossil, a variable territory for time and space scrutiny.\r\n\r\nTo be seen on September 15th until October 22nd. \r\nwww.thepalmbeach.be","performers":"Thibaut de Lestr\u00e9","boxoffice_url":null,"website":"http:\/\/www.thepalmbeach.be","email":"sandrineviumasia@thepalmbeach.com","phone_contact":"+32 474 86 42 45","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.539387"},"nl":{"name":"Suspended territories by Thibaut de Lestr\u00e9","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.539387"},"en":{"name":"Suspended territories by Thibaut de Lestr\u00e9","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.539387"},"de":{"name":"Suspended territories by Thibaut de Lestr\u00e9","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":