"sub_type":"concert","show_in_agenda":true,"ranking":1.2599210498949},{"id":538888,"date_start":"2022-08-17","date_end":"2022-08-17","date_next":"2022-08-17","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre"}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"L'\u00e9t\u00e9 spectaculaire - Gilgamesh","shortdescr":"Dis, comment on \u00e9crit \"Gilgamesh\" ?","longdescr":"Gilgamesh est le roi d\u2019Uruk, premi\u00e8re grande ville de l\u2019antiquit\u00e9, o\u00f9 serait n\u00e9e l\u2019\u00e9criture. Gilgamesh se croit tout puissant, fort et beau, mais en r\u00e9alit\u00e9 c\u2019est un tyran que le peuple craint. Sa rencontre avec Enkidu, son \u00e9gal en force, va l\u2019arr\u00eater dans ses habitudes \u00e9go\u00efstes. Enkidu plante la graine de l\u2019empathie et son amiti\u00e9 va ouvrir Gilgamesh au monde.\r\n\r\nLes aventures s\u2019encha\u00eenent jusqu\u2019au jour ou Enkidu meurt. Aveugl\u00e9 par le chagrin, Gilgamesh se lance dans la folle aventure de trouver le rem\u00e8de contre la mort et pour ce faire, il ira jusqu\u2019au \u201cbout du monde\u201d. Bredouille, il reviendra chez lui vieux, fatigu\u00e9, mais sage. Alors qu\u2019il a enfin accept\u00e9 la mort, il apprend \u00e0 \u00e9crire. S\u2019il n\u2019a pas trouv\u00e9 de rem\u00e8de contre la mort, il a compris que par l\u2019\u00e9criture la m\u00e9moire persiste.","performers":"Du Th\u00e9\u00e2tre Les Chardons. Avec Aurore Latour, J\u00e9r\u00f4me Nayer. Ecriture Juan Martinez, Aurore Latour, J\u00e9r\u00f4me Nayer. Mise en sc\u00e8ne Juan Martinez. Cr\u00e9ation lumi\u00e8re Arnault Lhoute. Sc\u00e9nographie C\u00e9cile Balate.","boxoffice_url":null,"website":"http:\/\/www.roseraie.org","email":"communication@roseraie.org","phone_contact":null,"phone_booking":"+32 2 376 46 45","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/538888.html"},"nl":{"name":"L'\u00e9t\u00e9 spectaculaire - Gilgamesh","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/538888.html"},"en":{"name":"L'\u00e9t\u00e9 spectaculaire - Gilgamesh","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/538888.html"},"de":{"name":"L'\u00e9t\u00e9 spectaculaire - Gilgamesh","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/538888.html"},"it":{"name":"L'\u00e9t\u00e9 spectaculaire - Gilgamesh","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/538888.html"},"sp":{"name":"L'\u00e9t\u00e9 spectaculaire - Gilgamesh","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/538888.html"},"pt":{"name":"L'\u00e9t\u00e9 spectaculaire - Gilgamesh","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/538888.html"},"cn":{"name":"L'\u00e9t\u00e9 spectaculaire - Gilgamesh","