tie verplicht","performers":null,"boxoffice_url":null,"website":"https:\/\/centrale.brussels\/nl\/events\/zondag-centrale-art-de-rien\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50004841"}},"place":{"id":243546,"translations":{"de":{"name":"CENTRALE for contemporary art","address_street_name":"Place Sainte-Catherine","address_street_number":"45","address_street_box":null,"email":"info@centrale.brussels","website":"http:\/\/www.centrale.brussels","phone_contact":"+32 2 279 64 44","phone_booking":"+32 2 279 64 57","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Sainte-Catherine, 45","address_line2":"1000 Bruxelles","description_web":"Die CENTRALE for Contemporary Art hat sich im Br\u00fcsseler Stadtzentrum in einem ehemaligen Elektrizit\u00e4tswerk niedergelassen. Hier wird eine engagierte und in jeder Hinsicht offene Vision der Kunst entwickelt und gepflegt, die im engen Austausch mit der Stadt und der Gesellschaft steht. In den verschiedenen R\u00e4umen und S\u00e4len finden regelm\u00e4\u00dfig Ausstellungen und andere multidisziplin\u00e4re Projekte mit namhaften K\u00fcnstlern und aufstrebenden jungen Talenten statt, die sowohl aus Br\u00fcssel als auch von ausw\u00e4rts stammen.","description_print":null,"booking_url":null,"sort_order":"CENTRALE FOR CONTEMPORARY ART","virtual_visit":null,"visit_url":null},"pt":{"name":"CENTRALE for contemporary art","address_street_name":"Place Sainte-Catherine","address_street_number":"45","address_street_box":null,"email":"info@centrale.brussels","website":"http:\/\/www.centrale.brussels","phone_contact":"+32 2 279 64 44","phone_booking":"+32 2 279 64 57","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Sainte-Catherine, 45","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"CE