+32 476 77 23 42","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700006107"},"it":{"name":"\"Vestigios\" - R\u00e9cital de chant flamenco","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.casaveronica.net","email":"info@casaveronica.net","phone_contact":null,"phone_booking":"+32 476 77 23 42","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700006107"},"cn":{"name":"\"Vestigios\" - R\u00e9cital de chant flamenco","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.casaveronica.net","email":"info@casaveronica.net","phone_contact":null,"phone_booking":"+32 476 77 23 42","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700006107"},"fr":{"name":"\"Vestigios\" - R\u00e9cital de chant flamenco","shortdescr":"Juan Torres et David Sanchez se r\u00e9unissent pour un r\u00e9cital intime de chant et guitare flamenco. ","longdescr":"Juan Torres\nN\u00e9 dans la r\u00e9gion d'Estr\u00e9madure et a grandi \u00e0 S\u00e9ville o\u00f9 il s'est form\u00e9 au chant flamenco avec des professeurs tels que Lebrijano, la famille Fern\u00e1ndez (Esperanza et son p\u00e8re Curro) et Paco Taranto, entre autres. C'est l\u00e0 qu'il commence \u00e0 pr\u00e9senter des spectacles dans la capitale s\u00e9villane, certains ax\u00e9s sur la danse. Une fois install\u00e9 \u00e0 Bruxelles, en plus de poursuivre ses activit\u00e9s flamenco, il a \u00e9t\u00e9 membre des groupes Oleando, Amalgama et Taha. Il continue de d\u00e9velopper ses propres projets et collabore avec des artistes flamenco de Belgique, de France, de Hongrie et d'Espagne.\n\nDavid S\u00e1nchez\nN\u00e9 et \u00e9lev\u00e9 \u00e0 S\u00e9ville, il se forme aupr\u00e8s des guitaristes Jos\u00e9 Luis Scott et Antonio Bonilla, \u00e0 l'\u00e9poque o\u00f9 ce dernier \u00e9tait professeur de guitare flamenco au conservatoire de Cordoue. David S\u00e1nchez Mart\u00edn commence \u00e0 se produire dans des clubs et des th\u00e9\u00e2tres, accompagnant le chant et la danse dans toute la r\u00e9gion andalouse. En 2014, il se produit \u00e0 la Philharmonie du Luxembourg dans un spectacle de danse flamenco. De m\u00eame, il a accompagn\u00e9 le chant dans plusieurs concours nationaux. Il r\u00e9side actuellement \u00e0 Bruxelles, o\u00f9 il combine son r\u00f4le de guitariste avec celui de compositeur et producteur de musique.","performers":"Juan Torres (chant); David Sanchez (guitare)","boxoffice_url":null,"website":"http:\/\/www.casaveronica.net","email":"info@casaveronica.net","phone_contact":null,"phone_booking":"+32 476 77 23 42","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700006107"},"sp":{"name":"\"Vestigios\" - R\u00e9cital de chant flamenco","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.casaveronica.net","email":"info@casaveronica.net","phone_contact":null,"phone_booking":"+32 476 77 23 42","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700006107"},"nl":{"name":"\"Vestigios\" - R\u00e9cital de chant flamenco","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.casaveronica.net","email":"info@casaveronica.net","phone_contact":null,"phone_booking":"+32 476 77 23 42","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700006107"}},"place":{"id":270059,"translations":{"de":{"name":"Casa Veronica","address_street_name":"Avenue Capart","address_street_number":null,"address_street_box":null,"email":"contact.casa.veronica@gmail.com","website":"http:\/\/www.casaveronica.net","phone_contact":"+32 476 77 23 42","phone_booking":"+32 476 77 23 42","address_zip":"1090","address_city":"Jette","address_line1":"Avenue Capart","address_line2":"1090 Jette","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,