cebook_link":null,"import_origin":null,"is_part_of":"Ann\u00e9e Art Nouveau","sub_type":"expo","ranking":0.17613661133226788,"languages":{"spoken":["en","nl","fr"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[48,36],"translations":{"de":["Architektur","Museen & Kunstzentren"],"pt":[null,null],"en":["Architecture ","Museums and art centers"],"it":["Architettura","Musei e centri artistici"],"cn":[null,null],"fr":["Architecture","Mus\u00e9es et art centers"],"sp":["Arquitectura","Museos y centros de arte"],"nl":["Architectuur","Musea en kunstcentra"]}}},"translations":{"de":{"name":"Victor Horta versus Art nouveau. Horta's vocabulary","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.hortamuseum.be","email":"info@hortamuseum.be","phone_contact":"+32 2 543 04 90","phone_booking":"+32 2 543 04 90","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.543092"},"pt":{"name":"Victor Horta versus Art nouveau. Horta's vocabulary","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.hortamuseum.be","email":"info@hortamuseum.be","phone_contact":"+32 2 543 04 90","phone_booking":"+32 2 543 04 90","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.543092"},"en":{"name":"Victor Horta versus Art nouveau. Horta's vocabulary","shortdescr":"To understand Horta from the inside by going off the beaten track. This is the aim of this exhibition: to understand his expression and vocabulary without any preconceived ideas...","longdescr":"In 1893, Victor Horta drew up the plans for the Tassel Hotel. For art historians, this date corresponds to the birth of Art Nouveau, a style that would spread throughout the Western world until 1914. Yet behind this term lies a multitude of architects and designers with a singular, personal and sometimes antithetical expression. Behind this title, the exhibition seeks to question Victor Horta's approach without any considerations of style or belonging to a movement.","performers":"Sponsors : Delen Bank, Baillet Latour Fund. \r\nCurator: Benjamin Zurstrassen Scenography: Aur\u00e9lie Ranalli. \r\nGuest artist: Fran\u00e7ois Schuiten. \r\nPartners: IRPA, Alice Laboratory, La Cambre Horta Faculty of Architecture, Institut Saint Luc secondaire Brussels\r\n","boxoffice_url":null,"website":"http:\/\/www.hortamuseum.be","email":"info@hortamuseum.be","phone_contact":"+32 2 543 04 90","phone_booking":"+32 2 543 04 90","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.543092"},"it":{"name":"Victor Horta versus Art nouveau. Horta's vocabulary","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.hortamuseum.be","email":"info@hortamuseum.be","phone_contact":"+32 2 543 04 90","phone_booking":"+32 2 543 04 90","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.543092"},"cn":{"name":"Victor Horta versus Art nouveau. Horta's vocabulary","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.hortamuseum.be","email":"info@hortamuseum.be","phone_contact":"+32 2 543 04 90","phone_booking":"+32 2 543 04 90","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.543092"},"fr":{"name":"Victor Horta versus Art nouveau. Horta's vocabulary","shortdescr":"Comprendre Horta de l'int\u00e9rieur en sortant des sentiers battus. Tel est l'objectif de cette exposition : comprendre son expression, son vocabulaire hors de toutes id\u00e9es pr\u00e9con\u00e7ues...","longdescr":"1893, Victor Horta dessine les plans de l\u2019h\u00f4tel Tassel. Pour les historiens de l\u2019art, cette date correspond \u00e0 la naissance de l\u2019Art nouveau, un style qui se diffusera dans  le monde occidental jusqu\u2019en 1914. Pourtant derri\u00e8re ce terme, se cache une multitude d\u2019architectes et de cr\u00e9ateurs \u00e0 l\u2019expression singuli\u00e8re, personnelle et, parfois, antith\u00e9tique. Derri\u00e8re ce titre, l\u2019exposition cherche \u00e0 interroger la mani\u00e8re de Victor Horta en dehors de toutes consid\u00e9rations de style ou d\u2019appartenance \u00e0 un mouvement. ","performers":"Sponsors : Banque Delen, Fonds Baillet Latour. Commissaire : Benjamin Zurstrassen  Sc\u00e9nographie : Aur\u00e9lie Ranalli. Artiste invit\u00e9 : Fran\u00e7ois Schuiten. Partenaires : IRPA, Laboratoire Alice, facult\u00e9s d'architecture La Cambre Horta, institut saint Luc secondaire Bruxelles \r\n\r\n\r\n","boxoffice_url":null,"website":"http:\/\/www.hortamuseum.be","email":"info@hortamuseum.be","phone_contact":"+32 2 543 04 90","phone_booking":"+32 2 543 04 90","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.543092"},"sp":{"name":"Victor Horta versus Art nouveau. Horta's vocabulary","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.hortamuseum.be","email":"info@hortamuseum.be","phone_contact":"+32 2 543 04 90","phone_booking":"+32 2 543 04 90","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.543092"},"nl":{"name":"Victor Horta versus Art nouveau. Horta's vocabulary","shortdescr":"Horta van binnenuit begrijpen door buiten de gebaande paden te gaan. Dat is het doel van deze tentoonstelling: zijn expressie en vocabulaire begrijpen zonder vooropgezette idee\u00ebn...","longdescr":"In 1893 tekende Victor Horta de plannen voor het Tassel Hotel. \r\nVoor kunsthistorici komt deze datum overeen met de geboorte van de art nouveau, een stijl die zich tot 1914 over de westerse wereld zou verspreiden.\r\nAchter deze term gaat echter een veelheid van architecten en ontwerpers schuil met een eigen, persoonlijke en soms tegengestelde expressie. Achter deze titel tracht de tentoonstelling de stijl van Victor Horta in vraag te stellen zonder overwegingen van stijl of het behoren tot een stroming.\r\n","performers":"Sponsors : Delen Bank, Fonds Baillet Latour. Curator: Benjamin Zurstrassen \r\nScenografie: Aur\u00e9lie Ranalli. \r\nGastartiest: Fran\u00e7ois Schuiten. \r\nPartners: KIK, Laboratoire Alice, architectuurfaculteit La Cambre Horta, Institut Saint Luc secondaire Brussel\r\n","boxoffice_url":null,"website":"http:\/\/www.hortamuseum.be","email":"info@hortamuseum.be","phone_contact":"+32 2 543 04 90","phone_booking":"+32 2 543 04 90","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.543092"}},"place":{"id":241873,"translations":{"de":{"name":"Horta-Museum","address_street_name":"Rue Am\u00e9ricaine","address_street_number":"27","address_street_box":null,"email":"info@hortamuseum.be","website":"http:\/\/www.hortamuseum.be","phone_contact":"+32 2 543 04 90","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Am\u00e9ricaine, 27","address_line2":"1060 Saint-Gilles","description_web":"Die Geb\u00e4ude des heutigen Horta-Museum, das zum UNESCO-Weltkulturerbe z\u00e4hlt, wurde 1898 von dem ber\u00fchmten belgischen Jugendstilarchitekten Victor Horta auf zwei Parzellen der Br\u00fcsseler Rue Am\u00e9ricaine als Wohnhaus und Atelier erbaut. \r\n\r\nVon Arabesken und Licht: Der Jugendstilpionier erfand einen auf der Arabeske beruhenden Stil und revolutionierte den traditionellen Grundriss des b\u00fcrgerlichen Hauses. Mit der Konzeption eines Oberlichtes, das sich \u00fcber einem gro\u00dfr\u00e4umigen Treppenhaus befindet, brach er mit der Struktur des Hauses mit Bel-Etage und drei aneinander anschlie\u00dfenden, eher dunklen Zimmern. Au\u00dferdem nutzte er alle M\u00f6glichkeiten seines handwerklichen K\u00f6nnens und der Verwendung von industriellen Materialien wie Eisen, Gusseisen und Glas. \r\n\r\nHortas Anspruch war es, Kunst und Innenausstattung zu einem Gesamtkunstwerk zusammenzuf\u00fcgen, das das t\u00e4gliche Leben zu einer \u00e4sthetischen Erfahrung machte. Ganz sicher einer der Jugendstilh\u00f6hepunkte in Br\u00fcssel.\r\n\r\nDas Museum beherbergt gleichzeitig ein Forschungszentrum \u00fcber Victor Horta und den Jugendstil. Die pers\u00f6nlichen Archive Hortas, die Pl\u00e4ne seiner Bauten und die Bibliothek sind nach Vereinbarung zug\u00e4nglich.\r\n\r\nLetzter Einlass 17 Uhr.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Museu Horta","address_street_name":"Rue Am\u00e9ricaine","address_street_number":"27","address_street_box":null,"email":"info@hortamuseum.be","website":"http:\/\/www.hortamuseum.be","phone_contact":"+32 2 543 04 90","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Am\u00e9ricaine, 27","address_line2":"1060 Saint-Gilles","description_web":"Este museu reflete na perfei\u00e7\u00e3o o g\u00e9nio de Horta. Defendia uma arte total, que levou ao extremo: cada conceito de planeamento, cada pe\u00e7a de mob\u00edlia, cada detalhe de ilumina\u00e7\u00e3o foi pensado minuciosamente pelo arquiteto para atingir o equil\u00edbrio e a perfei\u00e7\u00e3o, tanto do ponto de vista da est\u00e9tica como do espa\u00e7o.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Museum Horta","address_street_name":"Rue Am\u00e9ricaine","address_street_number":"27","address_street_box":null,"email":"info@hortamuseum.be","website":"http:\/\/www.hortamuseum.be","phone_contact":"+32 2 543 04 90","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Am\u00e9ricaine, 27","address_line2":"1060 Saint-Gilles","description_web":"The Horta Museum is housed in the house and studio of the architect Victor Horta (1861-1947). Both buildings were built from 1898 to 1901 and are typical of the height of Art Nouveau. The interior of the house has been largely preserved: mosaics, stained-glass windows, furniture, wall paintings form a harmonious whole that shows subtlety down to the smallest detail. The museum is also a centre for research on Victor Horta and Art Nouveau. The architect's personal archive, a collection of plans of his buildings and the library are accessible to the public by appointment. Reservation of a time slot online is mandatory. Last access at 16:45.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Museo Horta","address_street_name":"Rue Am\u00e9ricaine","address_street_number":"27","address_street_box":null,"email":"info@hortamuseum.be","website":"http:\/\/www.hortamuseum.be","phone_contact":"+32 2 543 04 90","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Am\u00e9ricaine, 27","address_line2":"1060 Saint-Gilles","description_web":"Il Museo Horta ha sede nella casa privata e nello studio dell'architetto Victor Horta (1861-1947). Costruiti tra il 1898 e il 1901, i due edifici sono caratteristici dell'apice dell'Art Nouveau. La casa ha conservato gran parte del suo arredamento interno: mosaici, vetrate, mobili e pitture murali compongono un insieme armonico e raffinato nei minimi dettagli. Il museo \u00e8 anche un centro di ricerca su Victor Horta e Art Nouveau. Gli archivi personali dell'architetto, una collezione dei progetti dei suoi edifici e la biblioteca sono accessibili al pubblico su appuntamento.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Mus\u00e9e Horta","address_street_name":"Rue Am\u00e9ricaine","address_street_number":"27","address_street_box":null,"email":"info@hortamuseum.be","website":"http:\/\/www.hortamuseum.be","phone_contact":"+32 2 543 04 90","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Am\u00e9ricaine, 27","address_li