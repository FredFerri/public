slations":{"de":["Parks & G\u00e4rten"],"pt":[null],"en":["Parks and gardens"],"it":["Parchi e giardini"],"cn":[null],"fr":["Parc et jardins"],"sp":["Parques y jardines"],"nl":["Parken en tuinen"]}}},"translations":{"de":{"name":"\u00d4 de Molenbeek","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"cultuurbeleid.1080@molenbeek.irisnet.be","phone_contact":"+32 2 412 06 32","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50000583"},"pt":{"name":"\u00d4 de Molenbeek","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"cultuurbeleid.1080@molenbeek.irisnet.be","phone_contact":"+32 2 412 06 32","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50000583"},"en":{"name":"\u00d4 de Molenbeek","shortdescr":"\u00d4 de Molenbeek, the street theater and family festival is coming down to Ninoofsepoortpark this year. This magical event offers fun for young and old alike. Be enchanted by clowns, a breathtaking circus performance, numerous activities for all ages and venture into a real soapbox race! ","longdescr":"Welcome to \u00d4 de Molenbeek, the enchanting street theater and family festival taking place this year at Ninoofsepoortpark . Get ready for an unforgettable day of fun and wonder specially designed for all ages. \u00d4 de Molenbeek promises an enchanting mix of magic, laughter and adventure that brings families together.\n\nDiscover the enchanting world of street theater as colorful clowns make you laugh with their pranks and antics. But that's just the beginning - the festival also presents a breathtaking circus performance that will amaze you. Admire talented performers who defy gravity and the limits of reality with their amazing stunts and tricks.\n\nLooking for adventure? Take on the challenge of our exciting soapbox race! Unleash your creativity as you design your own unique soapbox and compete with other enthusiastic participants. And there's even more adventure - challenge yourself with the electronic rodeo bull, test your skills and maintain your balance while taking on the mechanical challenge. And if that's not enough excitement, you can participate in the creative lab, where you can explore your artistic side through inspiring workshops.\n\nBut that's not all that \u00d4 de Molenbeek has to offer. For those seeking peace and inner balance, there are also calming yoga initiations. Let your mind and body unwind amidst the vibrant festival energy, with experienced yoga teachers guiding you through invigorating exercises and postures.\n\nEnjoy an array of culinary delights available at various food stalls, from savory treats to delectable sweets. And when thirst strikes, you can refresh yourself with a selection of beverages.\n\nThe youngest festival-goers will also have fun. There are inflatable jump sculptures to bounce and play on, and makeup artists will be on hand to transform little ones into their favorite characters.\n\nIn short, \u00d4 de Molenbeek promises a day of fun, excitement and discovery for the whole family. Whether you enjoy breathtaking performances, creative activities, challenging competitions or simply enjoying great food and drink, our festival has something for everyone. Join the festive atmosphere at Ninoofsepoortpark and create lasting memories that will last a lifetime.\n\n\n\n\n","performers":"De Nederlandstalige cultuurdienst van Sint-Jans-Molenbeek, De Vaartkapoen, Recyclart, WijkAntenndeDeQuartier (WAQ), SamenVoorMorgen, Leefmilieu Brussel, l'Ecluse, VGC, JES Brussel","boxoffice_url":null,"website":null,"email":"cultuurbeleid.1080@molenbeek.irisnet.be","phone_contact":"+32 2 412 06 32","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50000583"},"it":{"name":"\u00d4 de Molenbeek","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"cultuurbeleid.1080@molenbeek.irisnet.be","phone_contact":"+32 2 412 06 32","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50000583"},"cn":{"name":"\u00d4 de Molenbeek","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"cultuurbeleid.1080@molenbeek.irisnet.be","phone_contact":"+32 2 412 06 32","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50000583"},"fr":{"name":"\u00d4 de Molenbeek","shortdescr":"\u00d4 de Molenbeek, le festival de th\u00e9\u00e2tre de rue en famille s\u2019installe cette ann\u00e9e dans le parc de la Porte de Ninove. Cet \u00e9v\u00e9nement magique offre du plaisir pour les petits et les grands. Laissez-vous enchanter par les clowns, un spectacle de cirque \u00e0 couper le souffle, de nombreuses activit\u00e9s pour tous les \u00e2ges et lancez-vous dans une v\u00e9ritable course de caisses \u00e0 savon ! ","longdescr":"Bienvenue \u00e0 \u00d4 de Molenbeek, le festival de th\u00e9\u00e2tre de rue en famille qui se d\u00e9roulera cette ann\u00e9e dans le parc de la Porte de Ninove. Pr\u00e9parez-vous \u00e0 une journ\u00e9e inoubliable d'amusement et d'\u00e9merveillement sp\u00e9cialement con\u00e7ue pour tous les \u00e2ges. \u00d4 de Molenbeek promet un m\u00e9lange de magie, de rire et d'aventure qui r\u00e9unira les familles.\n\nD\u00e9couvrez le monde magique du th\u00e9\u00e2tre de rue, o\u00f9 des clowns color\u00e9s vous font rire avec leurs blagues et leurs pitreries. Mais ce n'est pas tout : le festival pr\u00e9sente \u00e9galement un spectacle de cirque \u00e0 couper le souffle. Admirez les artistes talentueux qui d\u00e9fient la gravit\u00e9 et les limites de la r\u00e9alit\u00e9 avec leurs cascades et leurs num\u00e9ros \u00e9poustouflants.\n\nEnvie d'aventure ? Relevez le d\u00e9fi de notre course de caisses \u00e0 savon palpitante ! Laissez libre cours \u00e0 votre cr\u00e9ativit\u00e9 en concevant votre propre caisse \u00e0 savon et en vous mesurant \u00e0 d'autres participants enthousiastes. Et il y a encore plus d'aventure - d\u00e9fiez-vous avec le taureau de rod\u00e9o \u00e9lectronique, testez vos comp\u00e9tences et maintenez votre \u00e9quilibre en relevant le d\u00e9fi m\u00e9canique. Et si cela ne suffit pas, vous pouvez participer \u00e0 l'atelier cr\u00e9atif, o\u00f9 vous pourrez explorer votre c\u00f4t\u00e9 artistique gr\u00e2ce \u00e0 des ateliers inspirants.\n\nMais ce n'est pas tout ce que \u00d4 de Molenbeek a \u00e0 offrir. Pour ceux qui recherchent la paix et l'\u00e9quilibre int\u00e9rieur, il y a aussi des initiations au yoga. Laissez votre corps et votre esprit se d\u00e9tendre au milieu de l'\u00e9nergie vibrante du festival, avec des professeurs de yoga exp\u00e9riment\u00e9s qui vous guident \u00e0 travers des exercices et des postures revigorants.\n\nSavourez un \u00e9ventail de d\u00e9lices culinaires disponibles dans divers stands de nourriture, des d\u00e9lices sal\u00e9s jusqu'aux sucreries d\u00e9licieuses. Et lorsque la soif se fait sentir, vous pouvez vous rafra\u00eechir avec une s\u00e9lection de boissons.\n\nLes plus jeunes festivaliers pourront \u00e9galement s'amuser. Des sculptures gonflables permettent de rebondir et de s'amuser, et des maquilleurs sont pr\u00e9sents pour transformer les petits en leurs personnages pr\u00e9f\u00e9r\u00e9s.\n\nEn r\u00e9sum\u00e9, \u00d4 de Molenbeek promet une journ\u00e9e de plaisir, d'excitation et de d\u00e9couverte pour toute la famille. Que vous aimiez les spectacles \u00e0 couper le souffle, les activit\u00e9s cr\u00e9atives, les concours ambitieux ou simplement la bonne ch\u00e8re et les boissons, notre festival a quelque chose \u00e0 offrir \u00e0 tout le monde. Rejoignez l'atmosph\u00e8re festive du parc de la Porte de Ninove et cr\u00e9ez des souvenirs inoubliables.\n\n\n\n\n","performers":"Le service de la culture n\u00e9erlandophone de Molenbeek-Saint-Jean, De Vaartkapoen, Recyclart, WijkAntenndeDeQuartier (WAQ), SamenVoorMorgen, Bruxelles Environnement, l'Ecluse, VGC, JES Brussel","boxoffice_url":null,"website":null,"email":"cultuurbeleid.1080@molenbeek.irisnet.be","phone_contact":"+32 2 412 06 32","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50000583"},"sp":{"name":"\u00d4 de Molenbeek","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"cultuurbeleid.1080@molenbeek.irisnet.be","phone_contact":"+32 2 412 06 32","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50000583"},"nl":{"name":"\u00d4 de Molenbeek","shortdescr":"\u00d4 de Molenbeek, het straattheater- en familliefestival strijkt dit jaar neer in het Ninoofsepoortpark. Dit magische evenement biedt plezier aan voor jong en oud. Laat je betoveren door clowns, een adembenemende circusvoorstelling, talrijke activiteiten voor alle leeftijden en waag je aan een echte zeepkistenrace! \n","longdescr":"Welkom bij \u00d4 de Molenbeek, h\u00e9t betoverende straattheater- en familiefestival dat dit jaar plaatsvindt in het Ninoofsepoortpark. Maak je klaar voor een onvergetelijke dag vol plezier en verwondering, speciaal ontworpen voor alle leeftijden. \u00d4 de Molenbeek belooft een betoverende mix van magie, gelach en avontuurlijke momenten die families samenbrengen.\n\nOntdek de betoverende wereld van straattheater terwijl kleurrijke clowns je aan het lachen maken met hun grappen en capriolen. Maar dat is nog maar het begin - het festival presenteert ook een adembenemende circusvoorstelling die je versteld zal doen staan. Bewonder getalenteerde artiesten die de zwaartekracht en de grenzen van de realiteit trotseren met hun verbazingwekkende stunts en kunsten.\n\nOp zoek naar avontuur? Neem de uitdaging aan van onze opwindende zeepkistenrace! Laat je creativiteit de vrije loop terwijl je je eigen unieke zeepkist ontwerpt en de competitie aangaat met andere enthousiaste deelnemers. En er is nog meer avontuur - daag jezelf uit met de elektronische rodeo stier, test je vaardigheden en behoud je evenwicht terwijl je de mechanische uitdaging aangaat. En als dat nog niet genoeg spanning biedt, kun je deelnemen aan het creatieve atelier, waar je je artistieke kant kunt verkennen via inspirerende workshops.\n\nMaar dat is nog niet alles wat \u00d4 de Molenbeek te bieden heeft. Voor degenen die op zoek zijn naar rust en innerlijke balans, zijn er ook kalmerende yoga-initiaties. Laat je geest en lichaam tot rust komen te midden van de bruisende festivalenergie, met ervaren yogadocenten die je begeleiden bij verkwikkende oefeningen en houdingen.\n\nGeniet van een scala aan culinaire hoogstandjes beschikbaar bij diverse eetkraampjes, van hartige lekkernijen tot verrukkelijke zoetigheden. En wanneer de dorst toeslaat, kun je jezelf verfrissen met een selectie drankjes.\n\nDe jongste festivalgangers zullen zich eveneens vermaken. Er zijn opblaasbare springsculpturen om op te stuiteren en te spelen, en grimeerartiesten staan klaar om de kleintjes om te toveren tot hun favoriete personages.\n\nKortom, \u00d4 de Molenbeek belooft een dag vol plezier, opwinding en ontdekkingen voor het hele gezin. Of je nu houdt van adembenemende optredens, creatieve activiteiten, uitdagende wedstrijden of gewoon genieten van lekker eten en drinken, ons festival heeft voor ieder wat wils. Sluit je aan bij de feestelijke sfeer in het Ninoofsepoortpark en cre\u00eber blijvende herinneringen die een leven lang meegaan.","performers":"De Nederlandstalige cultuurdienst van Sint-Jans-Molenbeek, De Vaartkapoen, Recyclart, WijkAntenndeDeQuartier (WAQ), SamenVoorMorgen, Leefmilieu Brussel, l'Ecluse, VGC, JES Brussel","boxoffice_url":null,"website":null,"email":"cultuurbeleid.1080@molenbeek.irisnet.be","phone_contact":"+32 2 412 06 32","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50000583"}},"place":{"id":276047,"translations":{"de":{"name":"Parc Porte de Ninove","address_street_name":"rue du Rectangle","address_street_number":"13","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue du Rectangle, 13","address_line2":"1080 Molenbeek-Saint-Jean","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Parc Porte de Ninove","address_street_name":"rue du Rectangle","address_street_number":"13","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue du Rectangle, 13","address_line2":"1080 Molenbeek-Saint-Jean","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Parc Porte de Ninove","address_street_name":"rue du Rectangle","address_street_number":"13","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue du Rectangle, 13","address_line2":"1080 Molenbeek-Saint-Jean","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Parc Porte de Ninove","address_street_name":"rue du Rectangle","address_street_number":"13","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue du Rectangle, 13","address_line2":"1080 Molenbeek-Saint-Jean","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Parc Porte de Ninove","address_street_name":"rue du Rectangle","address_street_number":"13","address_street_box":null,"email":null,"we