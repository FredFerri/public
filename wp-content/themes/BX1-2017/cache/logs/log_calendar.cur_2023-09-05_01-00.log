,"fr":["Espaces verts"],"sp":["Espacios verdes:"],"nl":["Groene zones"]}}},"translations":{"de":{"name":"Montre-moi tes bourgeons, et je te dirai qui tu es!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.scheutbos.be\/","email":"scheutbos@yahoo.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.488413"},"pt":{"name":"Montre-moi tes bourgeons, et je te dirai qui tu es!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.scheutbos.be\/","email":"scheutbos@yahoo.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.488413"},"en":{"name":"Montre-moi tes bourgeons, et je te dirai qui tu es!","shortdescr":"Guided tour in French","longdescr":"Guided tour in French","performers":null,"boxoffice_url":null,"website":"http:\/\/www.scheutbos.be\/","email":"scheutbos@yahoo.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.488413"},"it":{"name":"Montre-moi tes bourgeons, et je te dirai qui tu es!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.scheutbos.be\/","email":"scheutbos@yahoo.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.488413"},"cn":{"name":"Montre-moi tes bourgeons, et je te dirai qui tu es!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.scheutbos.be\/","email":"scheutbos@yahoo.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.488413"},"fr":{"name":"Montre-moi tes bourgeons, et je te dirai qui tu es!","shortdescr":"Reconna\u00eetre les arbres nus et, derri\u00e8re leur apparente dormance, d\u00e9couvrir leur vie en hiver. R\u00e9servation et masque obligatoires.","longdescr":"Quel est cet arbre ? Pas si simple, lorsqu\u2019il a perdu ses feuilles ! Heureusement, d\u2019autres indices (\u00e9corce, bourgeons, fruits, forme de son port) permettent de l\u2019identifier. Au cours de la promenade, nous jouerons les d\u00e9tectives \u00e0 la recherche de ces indices. Puis, nous d\u00e9couvrirons qu\u2019en secret, derri\u00e8re leur dormance, ils restent bien actifs et pr\u00e9parent d\u00e9j\u00e0 le retour des beaux jours.\r\nR\u00e9servation et masque obligatoires.","performers":"Guide: Hugo Hubert","boxoffice_url":null,"website":"http:\/\/www.scheutbos.be\/","email":"scheutbos@yahoo.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.488413"},"sp":{"name":"Montre-moi tes bourgeons, et je te dirai qui tu es!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.scheutbos.be\/","email":"scheutbos@yahoo.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.488413"},"nl":{"name":"Montre-moi tes bourgeons, et je te dirai qui tu es!","shortdescr":"Rondleiding in't Frans","longdescr":"Rondleiding in't Frans","performers":null,"boxoffice_url":null,"website":"http:\/\/www.scheutbos.be\/","email":"scheutbos@yahoo.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.488413"}},"place":{"id":250983,"translations":{"de":{"name":"Les Amis du Scheutbos","address_street_name":"Rue Scheutbosch","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.scheutbos.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Rue Scheutbosch","address_line2":"1080 Molenbeek-Saint-Jean","description_web":null,"description_print":null,"booking_url":null,"sort_orde