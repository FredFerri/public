ons":{"fr":{"name":"Article 27"},"nl":{"name":"Artikel 27"},"en":{"name":"Article 27"},"de":{"name":"Article 27"},"it":{"name":"Article 27"},"sp":{"name":"Article 27"},"pt":{"name":"Article 27"},"cn":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[],"targets":{"list":[4,11],"translations":{"fr":["Enfants 6-9 ans","Famille"],"nl":["Kinderen 6-9 j.","Familie"],"en":["Children 6-9 yr.","Family"],"de":["Kinder 6-9 Jahre","Familie"],"it":[null,null],"sp":[null,null],"pt":[null,null],"cn":[null,null]}},"tags":["kids"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-11-23T15:54:04+01:00","published_at":"2022-06-23T16:46:01+02:00","backoffice_id":257018,"import_origin":null,"sub_type":"concert","show_in_agenda":true,"ranking":1},{"id":539780,"date_start":"2022-09-21","date_end":"2023-01-18","date_next":"2023-01-18","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater","it":null,"sp":null,"pt":null,"cn":null}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"],"de":["Theater"],"it":[null],"sp":[null],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Tempus","shortdescr":"Le temps se joue de nos histoires.","longdescr":"Tempus fugit\u2026 Nous jouons avec le th\u00e8me du temps qui passe. Celui apr\u00e8s lequel nous courons, celui que nous trouvons long parfois, celui qui fait de nos vies des aventures passionnantes.\r\n\r\nComment le temps influe-t-il sur la vie des personnages ? Sur leurs relations ? Sur leur \u00e9tat de sant\u00e9 ? Sur les valeurs auxquelles ils croient ? Comment joue-t-il sur le contexte dans lequel ils \u00e9voluent : situation mat\u00e9rielle, sociale, \u00e9conomique, politique, \u00e9volution des mentalit\u00e9s\u2026 ? Qu\u2019est-ce qui bouge ? Qu\u2019est-ce qui reste ? Les personnages vont-ils rire ou pleurer ? Pour le savoir, il faut improviser !\r\n\r\nTous les genres sont permis dans cette pi\u00e8ce de th\u00e9\u00e2tre improvis\u00e9e : com\u00e9die, drame, romance, fresque historique, science fiction\u2026 Les com\u00e9dien.nes ne s\u2019interdisent rien, sauf le manque de sinc\u00e9rit\u00e9.","performers":"Sophie Hoyas, Philippe Verbeke, Alexandre Valancin, Sarah Maystadt, Laurent Van der Rest, Jesica de Salvador, Alexandra DucouxdeSh, Laurence Bodart","boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Tempus.html","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.539780"},"nl":{"name":"Tempus","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.539780"},"en":{"name":"Tempus","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.539780"},"de":{"name":"Tempus","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.539780"},"it":{"name":"Tempus","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.539780"},"sp":{"name":"Tempus","shortdescr":null,"l