":null,"website":"http:\/\/www.osamoelle.be","email":"communication@osamoelle.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50000807"},"pt":{"name":"Emma","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.osamoelle.be","email":"communication@osamoelle.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50000807"},"en":{"name":"Emma","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.osamoelle.be","email":"communication@osamoelle.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50000807"},"it":{"name":"Emma","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.osamoelle.be","email":"communication@osamoelle.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50000807"},"cn":{"name":"Emma","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.osamoelle.be","email":"communication@osamoelle.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50000807"},"fr":{"name":"Emma","shortdescr":"\u00ab Je m\u2019appelle Emma, j\u2019ai dix-sept ans et j\u2019ai d\u2019autres choses a me taper que Flaubert. Cette histoire est mon histoire. \u00bb\n\n\u200b\n\n","longdescr":"Gustave Flaubert s\u2019appelle Gustave. Gustave a \u00e9crit Madame Bovary \u00e0 une \u00e9poque genre Moyen-\u00e2ge.\n\nGustave est mort il y a tellement longtemps qu\u2019on ne sait m\u00eame plus tr\u00e8s bien quelle t\u00eate il avait, sauf que c\u2019\u00e9tait un gros moustachu. Il y a quelques mois, j\u2019ai relu Madame Bovary, ce roman que tant de personnes consid\u00e8rent comme responsable d\u2019avoir g\u00e2ch\u00e9 leur jeunesse.\n\nJe l\u2019ai lu. Ce fut le choc.\n\nDe toute \u00e9vidence, Flaubert n\u2019est pas cet ennemi \u00e0 abattre. Il devait m\u00eame aimer profond\u00e9ment ses futurs lecteurs pour vouloir leur offrir un style si pur, une \u00e9criture si limpide au service d\u2019un propos si visionnaire. A croire qu\u2019il avait des antennes dirig\u00e9es vers le futur\u2026\n\n\u200b\n\n\u00ab Je m\u2019appelle Emma, j\u2019ai dix-sept ans et j\u2019ai d\u2019autres choses a me taper que Flaubert. Cette histoire est mon histoire. \u00bb\n\n\u200b\n\nA partir de 12 ans\n\n \n\nDe Dominique Br\u00e9da\nAvec Julie Duroisin\nMise en sc\u00e8ne de Dominique Br\u00e9da\nAvec l\u2019aide de Laurence Adam\n\n\u200b\n\nProduction : Lato Sensu ASBL","performers":null,"boxoffice_url":null,"website":"http:\/\/www.osamoelle.be","email":"communication@osamoelle.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50000807"},"sp":{"name":"Emma","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.osamoelle.be","email":"communication@osamoelle.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50000807"},"nl":{"name":"Emma","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.osamoelle.be","email":"communication@osamoelle.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50000807"}},"place":{"id":1078,"translations":{"de":{"name":"L'Os \u00e0 Moelle","address_street_name":"Avenue Emile Max","address_street_number":"153","address_street_box":null,"email":"reservation@osamoelle.be","website":"http:\/\/www.osamoelle.be","phone_contact":"+32 487 22 50 22","phone_booking":"+32 487 22 50 22","address_zip":"1030","address_city":"Schaerbeek","