tions":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-06-21T09:05:17+02:00","published_at":"2023-06-21T08:39:02+02:00","backoffice_id":280072,"import_origin":null,"sub_type":"concert","show_in_agenda":true,"ranking":1.2599210498949},{"id":560383,"date_start":"2023-07-09","date_end":"2023-07-09","date_next":"2023-07-09","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":84,"translations":{"fr":"Divers","nl":"Varia","en":"Various","de":"Verschiedenes","it":"Varie","sp":"Varios","pt":null,"cn":null}},"others":{"list":[87],"translations":{"fr":["Kermesses et festivit\u00e9s"],"nl":["Kermissen en feestelijkhheden"],"en":["Charity fairs and festivities"],"de":["Jahrm\u00e4rkte & Feste"],"it":["Kermesse e celebrazioni"],"sp":["Fiestas populares y festividades"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["nl","fr"],"subtitles":[]},"translations":{"fr":{"name":"kwb Dialoog picknick","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.kwbeensgezind.be\/picknick\/","email":"kurt.borremans@kwb.be","phone_contact":"+32 496 56 73 93","phone_booking":"+32 496 56 73 93","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.560383"},"nl":{"name":"kwb Dialoog picknick","shortdescr":"Dialoogpicknick op 9 juli.. een lekker samen zijn","longdescr":"Kom jij naar de grote kwb-picknick op 9 juli?\r\nIn februari verzamelden 50 Vlamingen en Brusselaars tijdens een lekkere brunch om in gesprek te gaan met elkaar. Deze uitwisseling werd gesmaakt en de goesting was groot om verder te blijven praten en elkaar nog beter te leren kennen. Daarom nodigt kwb (i.s.m. met Vlaanderen) iedereen uit om inwoners van het andere gewest beter te leren kennen tijdens een gezamenlijke kwb-picknick op 9 juli van 12u tot 16u in Brussel (ParckFarm, Jubelfeestlaan in Sint-Jans-Molenbeek). (Bij regenweer wordt gezorgd voor een binnenlocatie.)\r\n\r\nNaast een lekkere picknick en toffe babbel zal er ook kwb-animatie voorzien worden.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.kwbeensgezind.be\/picknick\/","email":"kurt.borremans@kwb.be","phone_contact":"+32 496 56 73 93","phone_booking":"+32 496 56 73 93","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.560383"},"en":{"name":"kwb Dialoog picknick","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.kwbeensgezind.be\/picknick\/","email":"kurt.borremans@kwb.be","phone_contact":"+32 496 56 73 93","phone_booking":"+32 496 56 73 93","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.560383"},"de":{"name":"kwb Dialoog picknick","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.kwbeensgezind.be\/picknick\/","email":"kurt.borremans@kwb.be","phone_contact":"+32 496 56 73 93","phone_booking":"+32 496 56 73 93","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.560383"},"it":{"name":"kwb Dialoog picknick","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.kwbeensgezind.be\/picknick\/","email":"kurt.borremans@kwb.be","phone_contact":"+32 496 56 73 93","phone_booking":"+32 496 56 73 93","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.560383"},"sp":{"name":"kwb Dialoog picknick","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.kwbeensgezind.be\/picknick\/","email":"kurt.borremans@kwb.be","phone_contact":"+32 496 56 73 93","phone_booking":"+32 496 56 73 93","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.560383"},"pt":{"name":"kwb Dialoog picknick","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.kwbeensgezind.be\/picknick\/","email":"kurt.borremans@kwb.be","phone_contact":"+32 496 56 73 93","phone_booking":"+32 496 56 73 93","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.560383"},"cn":{"name":"kwb Dialoog picknick","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.kwbeensgezind.be\/picknick\/","email":"kurt.borremans@kwb.be","phone_contact":"+32 496 56 73 93","phone_booking":"+32 496 56 73 93","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.560383"}},"place":{"id":269852,"translations":{"fr":{"name":"Parckfarm Tour & Taxis","address_street_name":"Boulevard du Jubilee","address_street_number":"202","address_street_box":null,"email":"info@parckfarm.be","website":"http:\/\/www.parckfarm.be","phone_contact":"+32 489 02 68 18","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Boulevard du Jubilee, 202","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"Parckfarm occupe le site de Tour & Taxis et les friches ferroviaires qu\u2019a laiss\u00e9es l\u2019abandon de ce site. Depuis 2014, ce parc est un parc comestible o\u00f9 l\u2019agriculture urbaine est pratiqu\u00e9e et l\u2019alimentation durable est valoris\u00e9e. Gr\u00e2ce \u00e0 Parckfarm, les habitants se sont r\u00e9appropri\u00e9s cet espace vert. Avec ses neuf hectares de surface, l\u2019ensemble du parc est le plus grand du centre de Bruxelles.\r\n\r\nVous apercevrez un verger partag\u00e9, un potager, un compost de quartier, un poulailler, des ruches et un four \u00e0 pain. Les abeilles am\u00e9liorent la biodiversit\u00e9 du parc ; vous pouvez m\u00eame repartir avec votre pot de miel ! Faites une pause \u00e0 La Farmhouse, une serre disposant d\u2019une caf\u00e9t\u00e9ria o\u00f9 d\u00e9guster des plats v\u00e9g\u00e9tariens pr\u00e9par\u00e9s avec des produits d\u2019artisans et commer\u00e7ants locaux. Installez-vous dans le coin lecture et profitez des animations et des jeux de soci\u00e9t\u00e9 mis \u00e0 votre disposition, sans obligation de consommer !\r\n\r\nParticipez aux visites guid\u00e9es, activit\u00e9s et ateliers : jardinage, herboristerie, mise en pot du miel, fabrication du pain\u2026 Retrouvez un ob\u00e9lisque sur le th\u00e8me des droits de l\u2019homme et une plaine de jeux construite avec des mat\u00e9riaux r\u00e9cup\u00e9r\u00e9s de l\u2019ancien chemin de fer qui passait l\u00e0.\r\n\r\nNe manquez pas de faire un tour dans la Gare Maritime, ce march\u00e9 de cuisine de rue et lieu d\u2019\u00e9v\u00e8nements, d\u2019expositions et de boutiques, le tout empreint de verdure ! Si vous \u00eates f\u00e9ru de jeu vid\u00e9o, direction le Pixel Museum tout proche et si vous aimez la bi\u00e8re, rendez-vous dans les nombreuses brasseries du quartier.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Parckfarm Tour & Taxis","address_street_name":"Jubelfeestlaan","address_street_number":"202","address_street_box":null,"email":"info@parckfarm.be","website":"http:\/\/www.parckfarm.be","phone_contact":"+32 489 02 68 18","phone_booking":null,"address_zip":"1080","address_city":"Sint-Jans-Molenbeek","address_line1":"Jubelfeestlaan, 202","address_line2":"1080 Sint-Jans-Molenbeek","description_web":"Met zijn negen hectare is het Tour & Taxispark het grootste in het centrum van Brussel. Tot 2014 was dit een braakliggend spoorwegterrein. Nu wordt er zelfs aan standslandbouw gedaan en promoten ze er duurzame voeding. Dat gebeurt door Parckfarm. Dankzij dit initiatief zijn heel wat mensen betrokken bij deze groene ruimte.\r\n\r\nZo is er een gemeenschappelijke boomgaard, een moestuin, een buurtcompost, een kippenhok, bijenkorven en een broodoven. De bijen bevorderen de biodiversiteit van het park. Schaf er je zeker een potje honing aan. In de Farmhouse, een serre met een cafetaria, eet je vegetarische gerechten op basis van lokale producten. Er is een leeshoek en je kan er allerlei spelletjes spelen.\r\n\r\nDoe mee met een van de rondleidingen, activiteiten of workshops. Je kan er zelfs tuinieren of broodbakken. In het park staat ook een obelisk. Als je goed kijkt, zie je dat alle artikels uit de universele verklaring van de rechten van de mens erop staan. De speeltuin in het park is gebouwd met de materialen die zijn gewonnen uit de spoorlijn die er vroeger liep.\r\n\r\nWat je zeker niet mag missen is de Gare Maritime, een prachtige hal met een food market. Vlakbij ligt ook het Pixel Museum, een must voor gamers. Als je van bier houdt, moet je zeker een bezoek brengen aan een van de vele brouwerijen in de buurt.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Parckfarm Tour & Taxis","address_street_name":"Boulevard du Jubilee","address_street_number":"202","address_street_box":null,"email":"info@parckfarm.be","website":"http:\/\/www.parckfarm.be","phone_contact":"+32 489 02 68 18","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Boulevard du Jubilee, 202","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"Parckfarm is located at Tour & Taxis and the railway wasteland left by the abandonment of the site. Since 2014, this park has been an edible park where urban agriculture is practiced and sustainable food is promoted. Thanks to Parckfarm, inhabitants have reappropriated this green space. Covering nine hectares, the park is the largest in central Brussels.\r\n\r\nYou'll see a shared orchard, a vegetable garden, a neighbourhood compost, a chicken coop, beehives and a bread oven. The bees enhance the biodiversity of the park; you might even leave with a jar of fresh honey! Stop at La Farmhouse, a greenhouse with a cafeteria where you can enjoy vegetarian dishes prepared with products from local craftsmen and traders. Take a seat in the reading corner and enjoy the entertainment and board games available, without any obligation to eat!\r\n\r\nJoin guided tours, activities and workshops: gardening, herbalism, honey-potting, bread-making... Discover an obelisk dedicated to human rights and a playground built with materials salvaged from the old railway that used to run there.\r\n\r\nMake sure you visit the Gare Maritime, a street food market and venue for events, exhibitions and shops that's surrounded by greenery! If you're a video game fan, head for the nearby Pixel Museum and if you like beer, visit some of the area's numerous breweries.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Parckfarm Tour & Taxis","address_street_name":"Boulevard du Jubilee","address_street_number":"202","address_street_box":null,"email":"info@parckfarm.be","website":"http:\/\/www.parckfarm.be","phone_contact":"+32 489 02 68 18","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Boulevard du Jubilee, 202","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"Parckfarm z\u00e4hlt zu den spannenden Neuzug\u00e4ngen der Br\u00fcsseler Parklandschaft. Die Gr\u00fcnanlage erstreckt sich \u00fcber das Gel\u00e4nde von Tour & Taxis bis hin zu den stillgelegten Bahngleisen, die von der industriellen Vergangenheit des Standorts zeugen. Seit 2014 wird hier mit Begeisterung Urban Farming betrieben, wobei stets die Nachhaltigkeit im Mittelpunkt steht. Parckfarm hat die Gr\u00fcnfl\u00e4che in einen Treffpunkt f\u00fcr die Anwohner des Viertels verwandelt. Mit neun Hektar Fl\u00e4che handelt es sich hier um den gr\u00f6\u00dften Park des Br\u00fcsseler Stadtzentrums.\r\n\r\nEin Gemeinschaftsgarten, in dem Obst und Gem\u00fcse angebaut wird, ein Komposthaufen f\u00fcr die Anwohner, ein H\u00fchnerstall, Bienenst\u00f6cke mit angeschlossenem Honigverkauf und ein Brotofen vervollst\u00e4ndigen das Angebot. Kleine St\u00e4rkungen und Vegetarisches aus lokalen Produkten finden Sie im La Farmhouse, einem charmanten Gew\u00e4chshaus mit kleiner Cafeteria. Lassen Sie sich in der Leseecke nieder oder spielen Sie ein Gesellschaftsspiel \u2013 Verzehrzwang besteht nicht.\r\n\r\nVerschiedene F\u00fchrungen, Aktivit\u00e4ten und Workshops vertiefen die zentralen Themen: G\u00e4rtnern, Honigabf\u00fcllung, Kr\u00e4uterkunde, die Kunst des Brotbackens... Weitere Highlights sind der Obelisk zum Thema Menschenrechte und der Spielplatz, der aus historischen Eisenbahnmaterial gebaut wurde.\r\n\r\nDer benachbarte Gare Maritime lockt mit Food-Market, Veranstaltungen, Ausstellungen und Gesch\u00e4ften, w\u00e4hrend sich im Pixel Museum alles um die Welt der Videospiele dreht. Im Viertel rund um den Kanal sind zudem zahlreiche Brauereien ans\u00e4ssig.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Parc Tour & Taxis","address_street_name":"Boulevard du Jubilee","address_street_number":"202","address_street_box":null,"email":"info@parckfarm.be","website":"http:\/\/www.parckfarm.be","phone_contact":"+32 489 02 68 18","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Boulevard du Jubilee, 202","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Parc Tour & Taxis","address_street_name":"Boulevard du Jubilee","address_street_number":"202","address_street_box":null,"email":"info@parckfarm.be","website":"http:\/\/www.parckfarm.be","phone_contact":"+32 489 02 68 18","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Boulevard du Jubilee, 202","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Parc Tour & Taxis","ad