le pour adultes et grands adolescents","performers":"Conception et mise en sc\u00e8ne Beno\u00eet Verhaert\r\n\r\nCompositions musicales originales Gilles Masson avec la collaboration de Delphine Gardin\r\n\r\nInterpr\u00e9tation Delphine Gardin, Gilles Masson, Beno\u00eet Verhaert\r\n\r\nSc\u00e9nographie et costumes Pauline Mar\u00e9chal\r\n\r\nCr\u00e9ation lumi\u00e8res John Cooper\r\n\r\nProduction Le th\u00e9\u00e2tre de la Chute","boxoffice_url":null,"website":"http:\/\/www.osamoelle.be","email":"communication@osamoelle.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.538430"},"nl":{"name":"L'H\u00e9autontimoroum\u00e9nos","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.538430"},"en":{"name":"L'H\u00e9autontimoroum\u00e9nos","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.538430"},"de":{"name":"L'H\u00e9autontimoroum\u00e9nos","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.538430"},"it":{"name":"L'H\u00e9autontimoroum\u00e9nos","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.538430"},"sp":{"name":"L'H\u00e9autontimoroum\u00e9nos","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.538430"},"pt":{"name":"L'H\u00e9autontimoroum\u00e9nos","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.538430"},"cn":{"name":"L'H\u00e9autontimoroum\u00e9nos","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.538430"}},"place":{"id":1078,"translations":{"fr":{"name":"L'Os \u00e0 Moelle","address_street_name":"Avenue Emile Max","address_street_number":"153","address_street_box":null,"email":"reservation@osamoelle.be","website":"http:\/\/www.osamoelle.be","phone_contact":"+32 487 22 50 22","phone_booking":"+32 487 22 50 22","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Avenue Emile Max, 153","address_line2":"1030 Schaerbeek","description_web":"Bienvenue dans le plus ancien cabaret de Bruxelles !\u202fCela m\u00e9rite en soi un hommage. De plus, c\u2019est aussi la cave de la maison natale de notre fiert\u00e9 bruxelloise, Jacques Brel. Depuis les ann\u00e9es 60, de grandes stars sont pass\u00e9es par ici\u202f; pensez \u00e0 Toots Thielemans, Philippe Lafontaine, Barbara et Arno. D\u00e9sormais, vous pouvez venir ici chaque semaine pour profiter d'un solide programme allant du th\u00e9\u00e2tre d'improvisation, des spectacles de com\u00e9die et d'auteurs-compositeurs-interpr\u00e8tes aux soir\u00e9es de po\u00e9sie, au th\u00e9\u00e2tre de marionnettes et aux f\u00eates dans le style \u00ab\u202fann\u00e9es folles\u202f\u00bb. \r\n\r\n ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"L'Os \u00e0 Moelle","address_street_name":"Emile Maxlaan","address_street_number":"153","address_street_box":null,"email":"reservation@osamoelle.be","websit