alse},{"day":"2023-03-11","doors":null,"start":"13:30:00","end":"15:00:00","is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"},"de":{"name":"Normal"},"it":{"name":"Normale"},"sp":{"name":"Normal"},"pt":{"name":"Normal"},"cn":{"name":"Normal"}},"value":0}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-03-03T04:05:24+01:00","published_at":"2023-03-03T03:30:29+01:00","backoffice_id":272779,"import_origin":"explore","sub_type":"other","show_in_agenda":true,"ranking":2},{"id":550684,"date_start":"2023-03-11","date_end":"2023-03-11","date_next":"2023-03-11","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater","it":"Teatro","sp":"Teatro","pt":null,"cn":null}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"],"de":["Theater"],"it":["Teatro"],"sp":["Teatro"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Rencontre avec Michel B (Bob Th\u00e9\u00e2tre)","shortdescr":"Le Bob Th\u00e9\u00e2tre est de retour \u00e0 La montagne magique.\r\nCris de joie, cris d\u2019effroi !","longdescr":"\u00c0 la suite de la parution de son livre \u201cJe suis diff\u00e9rent et alors ?\u201d, dans lequel Michel B. nous parle de sa part d\u2019ombre, nous l\u2019avons invit\u00e9 \u00e0 s\u2019exprimer sur son parcours de vie.\r\nIl nous parlera de ce qu\u2019il a travers\u00e9. Quelle a \u00e9t\u00e9 son enfance ? Pourquoi en est-il arriv\u00e9 l\u00e0 ? Rare dans les m\u00e9dias, avare en interview, c\u2019est l\u2019occasion unique de rencontrer Michel B., personnage qui a marqu\u00e9 d\u2019horreur l\u2019histoire du fait divers. Nous vous attendons nombreux et nombreuses. Pour la s\u00e9curit\u00e9 du public, un dispositif discret mais efficace a \u00e9t\u00e9 pens\u00e9. Nous vous demanderons de respecter le protocole\r\nPour faire une bonne histoire, il faut un bon m\u00e9chant. L\u2019incomparable Denis Athimon endosse le r\u00f4le du plus terrible. Seul sur sc\u00e8ne, il nous livre une prestation \u00e9bouriffante,\r\n\u00e0 faire frissonner de plaisir les plus avertis.","performers":"Texte, mise en sc\u00e8ne et interpr\u00e9tation : Denis Athimon. Musique : Fran\u00e7ois Athimon. Lumi\u00e8re : Gwendal Malard.","boxoffice_url":null,"website":"http:\/\/www.theatremontagnemagique.be","email":"info@montagnemagique.be","phone_contact":null,"phone_booking":"+32 2 210 15 90","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.550684"},"nl":{"name":"Rencontre avec Michel B (Bob Th\u00e9\u00e2tre)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatremontagnemagique.be","email":"info@montagnemagique.be","phone_contact":null,"phone_booking":"+32 2 210 15 90","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.550684"},"en":{"name":"Rencontre avec Michel B (Bob Th\u00e9\u00e2tre)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatremontagnemagique.be","email":"info@montagnemagique.be","phone_contact":null,"phone_booking":"+32 2 210 15 90","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.550684"},"de":{"name":"Rencontre avec Michel B (Bob Th\u00e9\u00e2tre)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatremontagnemagique.be","email":"info@montagnemagique.be","phone_contact":n