entoonstellingen","en":"Exhibition","de":"Ausstellung","it":"Esposizioni","sp":"Exhibici\u00f3n","pt":null,"cn":null}},"others":{"list":[24,30],"translations":{"fr":["Galeries d'art","Peinture"],"nl":["Galeries","Schilderkunst"],"en":["Art Galleries","Painting"],"de":["Kunstgalerien","Malerei"],"it":["Gallerie d'arte","Pittura"],"sp":["Galer\u00edas de arte","Pintura"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","en"],"subtitles":[]},"translations":{"fr":{"name":"Vladimir Semenskiy: AGE OF WISDOM","shortdescr":"In-Gate Gallery a le plaisir de pr\u00e9senter Age of Wisdom, une exposition personnelle de Vladimir Semenskiy (n\u00e9 en 1968 \u00e0 Imantau, Kazakhstan), \u00e0 l\u2019affiche du 18 f\u00e9vrier au 8 avril 2023.","longdescr":"In-Gate Gallery a le plaisir de pr\u00e9senter Age of Wisdom, une exposition personnelle de Vladimir Semenskiy (n\u00e9 en 1968 \u00e0 Imantau, Kazakhstan), \u00e0 l\u2019affiche du 18 f\u00e9vrier au 8 avril 2023.\r\n\r\nPour sa premi\u00e8re exposition avec la galerie, l'artiste a s\u00e9lectionn\u00e9 ses \u0153uvres datant de 2020 \u00e0 2022 et a cr\u00e9\u00e9 une installation qui fait r\u00e9f\u00e9rence \u00e0 l'un des sujets pr\u00e9f\u00e9r\u00e9s de Vladimir Semenskiy : la nature humaine comme kal\u00e9idoscope de sentiments, d'\u00e9motions et d'\u00e9tats d\u2019\u00e2me, la vie comme un flux temporel et une s\u00e9quence de brefs moments qui ne se r\u00e9p\u00e8tent jamais. L'exposition r\u00e9unit des peintures \u00e0 l'huile sur toile et une collection de dessins sur papier.\r\nLa peinture de Vladimir Semenskiy balance entre l\u2019esquisse grand format et la peinture expressive, ses images ont une forme reconnaissable, tout en \u00e9tant remplies de mouvements et de mati\u00e8re color\u00e9e vitale et mobile.\r\nDes images surgissent et existent \u00e0 la limite du figuratif et de l'abstrait, au point de conversion des vibrations et de l'impulsion d'\u00e9nergie dans la forme mat\u00e9rielle et visible.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.ingategallery.com","email":"info@ingategallery.com","phone_contact":"+32 499 63 74 76","phone_booking":"+32 499 63 74 76","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.552023"},"nl":{"name":"Vladimir Semenskiy: AGE OF WISDOM","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.ingategallery.com","email":"info@ingategallery.com","phone_contact":"+32 499 63 74 76","phone_booking":"+32 499 63 74 76","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.552023"},"en":{"name":"Vladimir Semenskiy: AGE OF WISDOM","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.ingategallery.com","email":"info@ingategallery.com","phone_contact":"+32 499 63 74 76","phone_booking":"+32 499 63 74 76","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.552023"},"de":{"name":"Vladimir Semenskiy: AGE OF WISDOM","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.ingategallery.com","email":"info@ingategallery.com","phone_contact":"+32 499 63 74 76","phone_booking":"+32 499 63 74 76","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.552023"},"it":{"name":"Vladimir Semenskiy: AGE OF WISDOM","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.ingategallery.com","email":"info@ingategallery.com","phone_contact":"+32 499 63 74 76","phone_booking":"+32 499 63 74 76","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.552023"},"sp":{"name":"Vladimir Semenskiy: AGE OF WISDOM","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.ingategallery.com","email":"info@ingategallery.com","phone_contact":"+32 499 63 74 76","phone_booking":"+32 499 63 74 76","agenda_url":"https:\/\/visit.brussels\/sp