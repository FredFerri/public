t de rencontre o\u00f9 activit\u00e9s sociales et culturelles se multiplient \u00e0 l\u2019envie. Pour papoter autour d\u2019un verre, jouer \u00e0 la p\u00e9tanque entre amis, prendre un cours de yoga \u00ab super chill \u00bb ou profiter d\u2019une pause salutaire au vert, ce jardin fleuri aux beaux jours et par\u00e9 de lumi\u00e8res festives en hiver est un must-go !","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Grand Hospice","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"hospice@pali-pali.com","website":"http:\/\/grand-hospice.brussels","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 7","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Grand Hospice","address_street_name":"Grootgodshuisstraat","address_street_number":"7","address_street_box":null,"email":"hospice@pali-pali.com","website":"http:\/\/grand-hospice.brussels","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Grootgodshuisstraat, 7","address_line2":"1000 Brussel","description_web":"Een sfeervol met lampionnen verlicht buitencaf\u00e9 met een trendy bar in een groene stadsoase? Dat is het Grand Hospice, een van de nieuwe, bruisende hybride plekjes waar we graag vertoeven. De tuinen van het voormalige Pacheco-Instituut, een neoclassicistisch geheel met prachtige zuilengangen en een als erfgoed geklasseerd binnenpark, zijn omgetoverd tot een ontmoetingsplek waar plaats is voor tal van sociale en culturele activiteiten. Of je nu met vrienden wilt bijpraten met een glaasje erbij, petanque wilt spelen, een 'superchill' yogales volgen of gewoon even tot rust wilt komen in het groen: alles kan in deze prachtige bloementuin, die in de winter feestelijk verlicht wordt!","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":36966,"location":{"lat":50.85351136,"lon":4.35012167},"last_updated_at":"2024-05-30T15:27:30+02:00","published_at":"2021-07-27T16:19:21+02:00","is_in_address_book":true,"is_in_vb_export":false,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/219c75bde6f4ae19149c11136fe8e1c2f326526f.jpg","width":567,"height":822,"ratio":0.69,"oEmbed_height":822,"oEmbed_width":567,"translations":{"de":{"title":"expo D\u00e9mentale","copyright":"artiste St."},"pt":{"title":"expo D\u00e9mentale","copyright":"artiste St."},"en":{"title":"expo D\u00e9mentale","copyright":"artiste St."},"it":{"title":"expo D\u00e9mentale","copyright":"artiste St."},"cn":{"title":"expo D\u00e9mentale","copyright":"artiste St."},"fr":{"title":"expo D\u00e9mentale","copyright":"artiste St."},"sp":{"title":"expo D\u00e9mentale","copyright":"artiste St."},"nl":{"title":"expo D\u00e9mentale","copyright":"artiste St."}}}],"dates":[{"day":"2024-09-15","doors":"15:00:00","start":"15:00:00","end":"18:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false}],"prices":[],"date_exceptions":[],"closing_days":[],"child_events":[],"parent_events":[],"accessibilities":[],"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[]},{"id":50012052,"date_start":"2024-09-24","date_end":"2024-10-05","date_next":"2024-09-24","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-08-27T16:37:09+02:00","published_at":"2024-07-01T14:01:57+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":303284,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"theatre","ranking":0.5503212081491045,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":49,"translations":{"de":"Theater","pt":null,"en":"Theatre","it":"Teatro","cn":null,"fr":"Th\u00e9\u00e2tre","sp":"Teatro","nl":"Theater"}},"others":{}},"translations":{"de":{"name":"Croire aux Fauves","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.oceannord.org\/2024\/croire-aux-fauves\/","email":"billetterie@oceannord.org","phone_contact":"+32 2 216 75 55","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50012052"},"pt":{"name":"Croire aux Fauves","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.oceannord.org\/2024\/croire-aux-fauves\/","email":"billetterie@oceannord.org","phone_contact":"+32 2 216 75 55","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50012052"},"en":{"name":"Croire aux Fauves","shortdescr":"Croire aux fauves de Nastassja Martin ouvre des mondes possibles. Ce r\u00e9cit autobiographique, qui d\u00e9marre lors d\u2019un affrontement avec un ours au Kamchatka en 2015, permet de r\u00e9agencer ses liens au vivant et de faire une place \u00e0 la part d\u2019invisible et d\u2019irr\u00e9solu de notre monde.","longdescr":"Croire aux fauves de Nastassja Martin ouvre des mondes possibles. Ce r\u00e9cit autobiographique, qui d\u00e9marre lors d\u2019un affrontement avec un ours au Kamchatka en 2015, permet de r\u00e9agencer ses liens au vivant et de faire une place \u00e0 la part d\u2019invisible et d\u2019irr\u00e9solu de notre monde. Devenue femme-ours par la force des choses, l\u2019autrice va faire sienne l\u2019hybridit\u00e9 de son \u00eatre ; En tissant un dialogue salvateur entre la pluralit\u00e9 de nos mondes, elle fait de notre m\u00e9tamorphose individuelle et collective une urgente n\u00e9cessit\u00e9. Le spectacle suivra le cheminement du r\u00e9cit de Nastassja Martin, qui nous emm\u00e8ne dans un enchev\u00eatrement d\u2019histoires, de lieux, de temporalit\u00e9s et de croyances, jusqu\u2019\u00e0 faire de l\u2019incertitude une promesse de vie.","performers":"Adaptation Schieve Compagnie mise en sc\u00e8ne Olivier Boudon avec Elena Perez & Lise Wittamer Regard chor\u00e9graphique Natacha Nicora Cr\u00e9ation Vid\u00e9o Bruno Tracq Cr\u00e9ation sonore Loup Mormont Costumes Carine Duarte Lumi\u00e8res Marc Defrise Sc\u00e9nographie Marjolaine Guillaume Images Michel Boermans","boxoffice_url":null,"website":"https:\/\/www.oceannord.org\/2024\/croire-aux-fauves\/","email":"billetterie@oceannord.org","phone_contact":"+32 2 216 75 55","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50012052"},"it":{"name":"Croire aux Fauves","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.oceannord.org\/2024\/croire-aux-fauves\/","email":"billetterie@oceannord.org","phone_contact":"+32 2 216 75 55","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50012052"},"cn":{"name":"Croire aux Fauves","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.oceannord.org\/2024\/croire-aux-fauves\/","email":"billetterie@oceannord.org","phone_contact":"+32 2 216 75 55","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50012052"},"fr":{"name":"Croire aux Fauves","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.oceannord.org\/2024\/croire-aux-fauves\/","email":"billetterie@oceannord.org","pho