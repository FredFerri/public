brussels\/de\/visitors\/agenda\/event-detail.50000123"},"pt":{"name":"Pr\u00eate-moi ton r\u00eave","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Prete-Moi-Ton-Reve","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50000123"},"en":{"name":"Pr\u00eate-moi ton r\u00eave","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Prete-Moi-Ton-Reve","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50000123"},"it":{"name":"Pr\u00eate-moi ton r\u00eave","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Prete-Moi-Ton-Reve","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50000123"},"cn":{"name":"Pr\u00eate-moi ton r\u00eave","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Prete-Moi-Ton-Reve","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50000123"},"fr":{"name":"Pr\u00eate-moi ton r\u00eave","shortdescr":"R\u00eaver, tout \u00e9veill\u00e9s !","longdescr":"Twig, Splash et Scratch viennent tout droit de la Lune, le royaume des r\u00eaves !\n\nQuand les enfants terriens dorment, ils leur rendent visite et vivent ensemble plein d\u2019aventures ! Mais lorsque les enfants se r\u00e9veillent, souvent, ils ne se souviennent pas de leurs r\u00eaves, et jamais des trois petites cr\u00e9atures. Attrist\u00e9s de cela, Twig, Splash et Scratch d\u00e9cident de venir sur la Terre, avec leurs marionnettes, en pleine journ\u00e9e afin de pouvoir r\u00eaver avec les enfants tout \u00e9veill\u00e9s.\n\nDans ce spectacle interactif, les enfants sont r\u00e9unis autour de tables pour dessiner ensemble. Ces dessins seront ensuite projet\u00e9s sur sc\u00e8ne et serviront de d\u00e9cors aux histoires jou\u00e9es par les com\u00e9diens. Vos enfants d\u00e9couvriront avec \u00e9merveillement leurs dessins prendre vie pour une apr\u00e8s-midi qu\u2019ils ne sont pas pr\u00eats d\u2019oublier.","performers":"Troupe Lunaire","boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Prete-Moi-Ton-Reve","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50000123"},"sp":{"name":"Pr\u00eate-moi ton r\u00eave","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Prete-Moi-Ton-Reve","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50000123"},"nl":{"name":"Pr\u00eate-moi ton r\u00eave","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Prete-Moi-Ton-Reve","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50000123"}},"place":{"id":270611,"translations":{"de":{"name":"Th\u00e9\u00e2tre l\u2019Improviste ","address_street_name":"Rue de Fierlant","address_street_number":"120","address_street_box":null,"email":null,"website":"http:\/\/www.improviste.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Rue de Fierlant, 120","address_line2":"1190 Forest","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Th\u00e9\u00e2tre L'improviste","address_street_name":"Rue de Fierlant","address_street_number":"120","add