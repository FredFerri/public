unday: from 11:00 to 18:00"]},"date_start":"2022-09-09","date_end":"2023-01-08","is_also_by_appointment":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":10},{"translations":{"fr":{"name":"Enfants"},"nl":{"name":"Kinderen"},"en":{"name":"Children"}},"value":0},{"translations":{"fr":{"name":"Jeunes"},"nl":{"name":"Jongeren"},"en":{"name":"Young people"}},"value":0},{"translations":{"fr":{"name":"Etudiants"},"nl":{"name":"Studenten"},"en":{"name":"Students"}},"value":4},{"translations":{"fr":{"name":"Seniors"},"nl":{"name":"Senioren"},"en":{"name":"Seniors"}},"value":7},{"translations":{"fr":{"name":"Demandeurs d'emploi"},"nl":{"name":"Werkzoekenden"},"en":{"name":"Job seekers"}},"value":4},{"translations":{"fr":{"name":"Groupe"},"nl":{"name":"Groep"},"en":{"name":"Group"}},"value":7},{"translations":{"fr":{"name":"Article 27"},"nl":{"name":"Artikel 27"},"en":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"opening":{"day":"2022-09-08","start":"18:30:00","timestamp":"2022-09-08T18:30:00+02:00","end":"22:00:00","is_only_by_appointment":false},"visit_profile":{"list":[327,337],"translations":{"fr":["Art contemporain","Highlight"],"nl":["Hedendaagse kunst","Highlight"],"en":["Contemporary art","Highlight"],"de":["Zeitgen\u00f6ssische Kunst","Highlight"]}},"tags":[],"accessibilities":{"list":[255],"translations":{"fr":["Accessible"],"nl":["Toegankelijk"],"en":["Accessible"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-14T01:35:18+02:00","published_at":"2022-06-16T11:50:36+02:00","backoffice_id":256182,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.32006146360353},{"id":542458,"date_start":"2022-09-29","date_end":"2022-10-29","date_next":"2022-10-14","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung"}},"others":{"list":[24,26],"translations":{"fr":["Galeries d'art","Sculpture"],"nl":["Galeries","Beeldhouwkunst"],"en":["Art Galleries","Sculpture"],"de":["Kunstgalerien","Skulptur"]}}},"languages":{"spoken":["fr","en"],"subtitles":[]},"translations":{"fr":{"name":"Maxence de Bagneux - Homo Ceramus","shortdescr":"La galerie pr\u00e9sente les derni\u00e8res \u0153uvres de cet artiste fran\u00e7ais, c\u00e9ramiste de sculptures modulables.","longdescr":"Pour cette exposition, Maxence nous pr\u00e9sente neuf pi\u00e8ces dont cinq totems analogues \u00e0 une for\u00eat de silhouettes architectur\u00e9es, trois masques et une sculpture murale.\r\n\r\nCes sculptures, pens\u00e9es sp\u00e9cialement pour la galerie s\u2019assemblent et s\u2019empilent dans un jeu de construction. Les diff\u00e9rents modules sont tourn\u00e9s \u00e0 la main par l\u2019artiste et laissent apparaitre des profils myst\u00e9rieux. L\u2019\u0153il et la bouche en sont absents, le gr\u00e8s qui prend ici des allures de biscuit, comme une invitation \u00e0 la caresse en font des figures abstraites d\u2019une grande sensualit\u00e9. Il cr\u00e9e des mati\u00e8res sculpt\u00e9es modulables aux formes brutes et aux contours de velours, reflets de ses voyages et de son intuition. \r\n\r\n(Infos et prix sur demande: ap@alienorprouvost.com)","performers":"Maxence de Bagneux","boxoffice_url":null,"website":"http:\/\/www.alienorprouvost.com","email":"ap@alienorprouvost.com","phone_contact":"+32 2 347 18 49","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.542458"},"nl":{"name":"Maxence de Bagneux - Homo Ceramus","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.542458"},"en":{"name":"Maxence de Bagneux - Homo Ceramus","shortdescr":"The gallery is showing this French artist\u2019s most recent works. He is a ceramicist who makes modulable sculptures.","longdescr":"For this exhibition Maxence is presenting nine artworks, including five totems that are like a forest of architectural silhouettes, three masks and a wall sculpture. \r\n\r\nThese sculptures, which have been conceived specifically for the gallery, assemble and pile up in a play of construction. The artist has hand turned the different modules that allow mysterious profiles to appear. Eye and mouth are absent. The clay which here has taken on an appearance like biscuit, is like an invitation to caress and forms very sensual abstract figures. He creates modulable sculpted materials with rough forms and velvety contours, reflections of his travels and his intuition.\r\n\r\n(Info and prices upon request: ap@alienorprovost.com)","performers":"Maxence de Bagneux","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.542458"},"de":{"name":"Maxence de Bagneux - Homo Ceramus","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.542458"},"it":{"name":"Maxence de Bagneux - Homo Ceramus","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.542458"},"sp":{"name":"Maxence de Bagneux - Homo Ceramus","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":nul