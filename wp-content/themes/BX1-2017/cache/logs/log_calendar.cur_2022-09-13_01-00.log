":"18:00:00"}],"weekschema":[{"days":{"monday":{"is_open":true,"hours":[{"start":"09:00:00","end":"18:00:00"}]},"tuesday":{"is_open":true,"hours":[{"start":"09:00:00","end":"18:00:00"}]},"wednesday":{"is_open":false},"thursday":{"is_open":true,"hours":[{"start":"09:00:00","end":"18:00:00"}]},"friday":{"is_open":true,"hours":[{"start":"09:00:00","end":"18:00:00"}]},"saturday":{"is_open":false},"sunday":{"is_open":false}},"translations":{"fr":["lundi, mardi, jeudi et vendredi: de 09:00 \u00e0 18:00","mercredi, samedi et dimanche: ferm\u00e9"],"nl":["maandag, dinsdag, donderdag en vrijdag: van 09:00 tot 18:00","woensdag, zaterdag en zondag: gesloten"],"en":["monday, tuesday, thursday and friday: from 09:00 to 18:00","wednesday, saturday and sunday: closed"]},"date_start":"2022-09-01","date_end":"2022-09-30","is_also_by_appointment":true}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[4,5,11,7,8,12,10,15,19],"translations":{"fr":["Enfants 6-9 ans","Enfants 9-12 ans","Famille","Jeunes 12-15 ans","Jeunes 15-18 ans","LGTBQIA","Seniors","Sourd\/malentendant","Enseignants"],"nl":["Kinderen 6-9 j.","Kinderen 9-12 j.","Familie","Jongeren 12-15 j.","Jongeren 15-18 j.","LGTBQIA","Senioren","Doof\/slechthorend","Leerkrachten"],"en":["Children 6-9 yr.","Children 9-12 yr.","Family","Youth 12-15  yr.","Youth 15-18  yr.","LGTBQIA","Seniors","Deaf\/hard of hearing","Teachers"]}},"opening":{"day":"2022-09-01","start":"18:00:00","timestamp":"2022-09-01T18:00:00+02:00","end":"21:30:00","is_only_by_appointment":false},"tags":["kids"],"accessibilities":{"list":[255,263],"translations":{"fr":["Accessible","Accessible aux pi\u00e9tons appareill\u00e9s"],"nl":["Toegankelijk","Toegankelijk voor voetgangers met hulpmiddelen"],"en":["Accessible","Accessible to pedestrians with mobility aids"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-09-10T01:36:34+02:00","published_at":"2022-07-20T08:50:17+02:00","backoffice_id":258704,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.32182979486854},{"id":537104,"date_start":"2022-06-30","date_end":"2022-09-18","date_next":"2022-09-12","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[36,40],"translations":{"fr":["Mus\u00e9es et art centers","Arts graphiques"],"nl":["Musea en kunstcentra","Grafische kunst, vormgeving"],"en":["Museums and art centers","Graphic art"]}}},"languages":{"spoken":["en","fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"9\u00e8me Exposition Belgo-Cor\u00e9enne de la Bande Dessin\u00e9e \"ATYPICAL GAIT\"","shortdescr":"Le Centre Culturel Cor\u00e9en organise une 9\u00e8me \u00e9dition du Salon Belge de la Bande Dessin\u00e9e Cor\u00e9enne du 30 juin au 18 septembre 2022 dans les locaux du centre.","longdescr":"Cette exposition pr\u00e9sentera des styles vari\u00e9s et une expression unique selon chaque artiste. Les univers de chaque artiste sont traduits en dessins originaux, maquettes, vid\u00e9os, croquis, etc. Les visiteurs auront notamment le privil\u00e8ge de voir travailler l'artiste Thierry Van Hasselt dans l'atelier d'artiste install\u00e9 dans le hall d'exposition. Ainsi, les artistes invit\u00e9s \u00e0 cette exposition sont ceux qui d\u00e9passent le st\u00e9r\u00e9otype du genre BD, et travaillent de mani\u00e8re plus inventive. Si ces artistes travaillent avec des formes traditionnelles, ils tentent parfois de trouver et de mettre en \u0153uvre les moyens les plus appropri\u00e9s pour s'exprimer quels que soient les genres, comme la peinture, la po\u00e9sie ou l'animation.\r\n\r\nLe titre de cette exposition, \u00ab ATYPICAL GAIT (D\u00c9MARCHE ATYPIQUE) \u00bb, est un t\u00e9moignage des d\u00e9marches de ces artistes et entend montrer les diff\u00e9rentes formes d'expression des artistes. Leur acte cr\u00e9ateur, ou d\u00e9marche, ne peut \u00eatre d\u00e9fini comme une forme unique, ni discut\u00e9 s\u00e9par\u00e9ment. Les artistes ont plusieurs mains : une pour dessiner des bandes dessin\u00e9es, une pour faire de l'animation, une pour \u00e9crire des romans et des po\u00e8mes, une pour peindre, et une pour exprimer et compiler ces formes d'art dans leurs \u0153uvres.\r\n\r\nLa premi\u00e8re \u0153uvre s'intitule \u00ab Vivre \u00e0 FranDisco \u00bb, une collaboration entre les deux artistes, Thierry Van Hasselt et Marcel Schmitz. Thierry Van Hasselt est membre fondateur de Fr\u00e9mok et a exerc\u00e9 diverses activit\u00e9s telles que l'\u00e9dition, la sc\u00e9narisation et le graphisme. Avec Marcel Schmitz, Thierry Van Hasselt a r\u00e9alis\u00e9 \u00ab Vivre \u00e0 FranDisco \u00bb ; un processus de collaboration unique de deux artistes. Ils ont voyag\u00e9 ensemble dans diff\u00e9rentes villes. De cette exp\u00e9rience, Marcel a cr\u00e9\u00e9 une maquette architecturale d'une ville, qui a ensuite \u00e9t\u00e9 utilis\u00e9e par Thierry comme arri\u00e8re-plan pour son dessin anim\u00e9. Le d\u00e9veloppement de l'intrigue est aussi le fruit de conversations longues et imaginatives.\r\n\r\nLe second est l'univers de l'\u0153uvre d'Eric Lamb\u00e9, \u00ab Le Fils du Roi \u00bb. Et \u00ab Paysage apr\u00e8s la bataille \u00bb qu'Eric Lam Eric Lamb\u00e9 a collabor\u00e9 avec Philippe De Pierpont sera \u00e9galement pr\u00e9sent\u00e9. Eric Lamb\u00e9 a essay\u00e9 de rendre la bande dessin\u00e9e plus po\u00e9tique en utilisant le dessin, la peinture et la gravure. Dans \u00ab Le Fils du Roi \u00bb, on peut appr\u00e9cier les motifs repr\u00e9sent\u00e9s par d'innombrables traits de stylo noir et bleu, la composition de l'obscurit\u00e9 et de la lumi\u00e8re, l'atmosph\u00e8re et la temporalit\u00e9. Par ailleurs, \u00ab Paysage apr\u00e8s la bataille \u00bb, qui a remport\u00e9 le Fauve d'or au Festival international de la bande dessin\u00e9e d'Angoul\u00eame 2017, est dessin\u00e9 dans le style minimal propre \u00e0 l'auteur. L'expression po\u00e9tique, issue de la recomposition d'images et de textes fragment\u00e9s, plonge le lecteur dans les \u0153uvres de Lamb\u00e9.\r\n\r\nLe troisi\u00e8me est une \u0153uvre d'art qui reproduit le journal de dessins que l'artiste tient depuis dix ans dans un style bande dessin\u00e9e \u00e0 quatre colonnes, \u00ab Things I Want to Draw \u00bb de Gaheezy. L'\u0153uvre d\u00e9roule calmement le quotidien d'une artiste asiatique qui tente de survivre en tant qu'illustratrice et ses exp\u00e9riences tout en vivant en tant que membre d'une minorit\u00e9 sexuelle en Nouvelle-Z\u00e9lande. En tant qu'illustratrice, l'artiste n'a cess\u00e9 d'\u00e9crire des journaux intimes et de d\u00e9velopper ses comp\u00e9tences en utilisant le style de la bande dessin\u00e9e depuis dix ans. Dans le magazine de bandes dessin\u00e9es publi\u00e9 par le groupe cr\u00e9atif \"Hantas\", diff\u00e9rents styles de techniques d'artistes peuvent \u00eatre vus. Avec \u00ab Things I Want to Draw \u00bb, les visiteurs pourront continuer \u00e0 voir la libert\u00e9 de l'auteur de dessiner ce qu'elle veut et ses histoires encore \u00e0 raconter.\r\n\r\nQuatri\u00e8mement, nous avons les nombreuses \u0153uvres illustr\u00e9es de Lee Kyutae, telles que la bande dessin\u00e9e \u00ab Jaein \u00bb et l'animation \u00ab Here Winter \u00bb. L'artiste est dessinateur, illustrateur et directeur d'animation. Bas\u00e9 sur le concept d'image, l'artiste \u00e9tend son champ d'action \u00e0 divers genres tels que l'animation, la bande dessin\u00e9e et l'illustration, et il a remport\u00e9 de grands et petits prix pour son travail. Dans le monde de l'art, qui s'est \u00e9tendu des animations qui incarnent des images anim\u00e9es aux illustrations qui capturent des exp\u00e9riences et des moments, l'artiste utilise des mat\u00e9riaux simples tels que des stylos et des crayons de couleur pour transmettre un message chaleureux et beau. Ses dessins ont eu un \u00e9norme succ\u00e8s sur les r\u00e9seaux sociaux, et on lui a demand\u00e9 d'illustrer les paroles de BTS dans la s\u00e9rie graphique RELIX, Vol. 5 Butterfly, qui est devenu un best-seller.\r\n\r\nEnfin, il y a les \u0153uvres de l'artiste Shim Daesup, \u00ab Lucid Man \u00bb et \u00ab Les limites de la po\u00e9sie et de la folie \u00bb. L'artiste travaille dans plusieurs genres tels que la bande dessin\u00e9e, la peinture, la po\u00e9sie, l'animation, le graphisme 3D et le travail vid\u00e9o. Pour transmettre ce qu'il veut montrer, il r\u00e9unit tous les genres dans ses \u0153uvres, sans en omettre aucun. Une gamme d'\u00e9l\u00e9ments d\u00e9clencheurs sont plac\u00e9s dans le travail de l'artiste, et le sens de l'existence d'un individu se reproduit \u00e0 travers l'anxi\u00e9t\u00e9, la solitude, l'impulsion et la peur. L'artiste introduit divers genres tels que la bande dessin\u00e9e, la po\u00e9sie, la peinture et la vid\u00e9o dans ses \u0153uvres comme m\u00e9thode de reproduction ou mat\u00e9riau. \u00ab Lucid Man \u00bb traite de l'existence quotidienne d'un individu mais, en m\u00eame temps, la personne est consid\u00e9r\u00e9e comme inexistante, induisant ainsi malaise et curiosit\u00e9 et rendant les spectateurs conscients de leur propre existence. Ce travail est une collection de vid\u00e9os, de po\u00e8mes et de bandes dessin\u00e9es. \u00ab The boundaries of poetry and madness \u00bb est pr\u00e9sent\u00e9e \u00e0 travers des po\u00e8mes, des lettres et des bandes dessin\u00e9es.\r\n\r\nL'exposition est accessible librement sur r\u00e9servation du 30 juin au 18 septembre 2022 au Centre culturel cor\u00e9en. La r\u00e9servation est disponible en ligne et toutes les informations sont fournies sur le site officiel du Centre culturel cor\u00e9en \u00e0 Bruxelles.","performers":"Les \u0153uvres de 5 artistes seront pr\u00e9sent\u00e9es dans l'exposition, dont 3 cor\u00e9ens et 2 belges ; \u00ab Vivre \u00e0 FranDisco \u00bb de Thierry Van Hasselt & Marcel Schmitz, \u00ab Paysage apr\u00e8s la bataille \u00bb d'Eric Lamb\u00e9 & Philippe De Pierpont, \u00ab Homme transparent \u00bb de SHIM Daesup, \u00ab Things I want to draw \u00bb de Gaheezy, et \u00ab Jaein \u00bb de LEE Kyutae.","boxoffice_url":null,"website":"https:\/\/brussels.korean-culture.org\/fr\/650\/board\/442\/read\/116318","email":"info@kccbrussels.be","phone_contact":"+32 2 274 29 80","phone_booking":"+32 2 274 29 80","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.537104"},"nl":{"name":"9\u00e8me Exposition Belgo-Cor\u00e9enne de la Bande Dessin\u00e9e \"ATYPICAL GAIT\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.537104"},"en":{"name":"9\u00e8me Exposition Belgo-Cor\u00e9enne de la Bande Dessin\u00e9e \"ATYPICAL GAIT\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.537104"},"de":{"name":"9\u00e8me Exposition Belgo-Cor\u00e9enne de la Bande Dessin\u00e9e \"ATYPICAL GAIT\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.537104"},"it":{"name":"9\u00e8me Exposition Belgo-Cor\u00e9enne de la Bande Dessin\u00e9e \"ATYPICAL GAIT\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.537104"},"sp":{"name":"9\u00e8me Exposition Belgo-Cor\u00e9enne de la Bande Dessin\u00e9e \"ATYPICAL GAIT\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.537104"},"pt":{"name":"9\u00e8me Exposition Belgo-Cor\u00e9enne de la Bande Dessin\u00e9e \"ATYPICAL GAIT\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.537104"},"cn":{"name":"9\u00e8me Exposition Belgo-Cor\u00e9enne de la Bande Dessin\u00e9e \"ATYPICAL GAIT\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.537104"}},"place":{"id":252775,"translations":{"fr":{"name":"Centre Culturel Cor\u00e9en de Bruxelles","address_street_name":"Rue de la R\u00e9gence","address_street_number":"4","address_street_box":null,"email":"info@kccbrussels.be","website":"http:\/\/brussels.korean-culture.org\/","phone_contact":"+32 2 274 29 80","phone_booking":"+32 2 274 29 80","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la R\u00e9gence, 4","address_line2":"1000 Bruxelles","description_web":"Le but du centre culturel cor\u00e9en, situ\u00e9 au c\u0153ur de Bruxelles,  est de promouvoir la cooperation culturelle des echanges entre la Belgique et la Coree, et entre l\u2019Union Europeenne et la Coree, a travers diverses activit\u00e9s culturelles traditionnelles et contemporaines. \r\nLe centre dispose d'une infrastructure adapt\u00e9 \u00e0 sa mission avec une salle multifonctionnelle utilis\u00e9e pour la projection de films, spectacles, conf\u00e9rences et expositions; un sarangbang, espace o\u00f9 les visiteurs peuvent pratiquer la c\u00e9r\u00e9monie cor\u00e9enne du th\u00e9; une biblioth\u00e8que; une cuisine pour les cours hebdomadaires de cuisine cor\u00e9enne et le King Sejong Institute pour les cours de langue.\r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Koreaans Cultureel Centrum Brussel","address_street_name":"Regentschapsstraat","address_street_number":"4","address_street_box":null,"email":"info@kccbrussels.be","website":"http:\/\/brussels.korean-culture.org\/","phone_contact":"+32 2 274 29 80","phone_booking":"+32 2 274 29 80","address_zip":"1000","address_city":"Brussel","address_line1":"Regentschapsstraat, 4","address_line2":"1000 Brussel","description_web":"Het Koreaans Cultureel Centrum van de Koreaanse Ambassade van Korea in de Europese unie en Belgi\u00eb is gevestigd in het hart van Brussel, en wil de samenwerking en uitwisseling promoten tussen Belgi\u00eb, de Europese Unie en Korea door het organiseren van verschillende culturele activiteiten. Het centrum beschikt daarvoor over een aangepaste infrastructuur zoals een evenementenhal gebruikt voor de projectie van Koreaanse films, optredens, tentoonstellingen en lezingen; een Sarangbang waar bezoekers de traditionele Koreaanse theeceremonie kunnen meemaken; een bibliotheek; een keuken waar regelmatig Koreaanse kooklessen worden gehouden en het King Sejong Institute waar de taallessen worden georganiseerd.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Korean Cultural Center Brussels","address_street_name":"Rue de la R\u00e9gence","address_street_number":"4","address_street_box":null,"email":"info@kccbrussels.be","website":"http:\/\/brussels.korean-culture.org\/","phone_contact":"+32 2 274 29 80","phone_booking":"+32 2 274 29 80","address_zip":"1000","address_city":"Brussels","address_line1":"Rue de la R\u00e9gence, 4","address_line2":"1000 Brussels","description_web":"The Korean Cultural Center in Brussels is situated in the heart of Brussels, and strives to promote cultural exchanges between Korea & Belgium and Korea & the EU by diverse cultural activities.\r\nThe center disposes of an adapted infrastructure with an event hall used for screening original Korean cinema, shows, performances, exhibitions and conferences; a sarangbang where visitors can experience Korea's traditional tea ceremony; a library, a kitchen for the Korean cooking classes and the King Sejong Institute, where Korean language classes are held.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Centre Culturel Cor\u00e9en de Bruxelles","address_street_name":"Rue de la R\u00e9gence","address_street_number":"4","address_street_box":null,"email":"info@kccbrussels.be","website":"http:\/\/brussels.korean-culture.org\/","phone_contact":"+32 2 274 29 80","phone_booking":"+32 2 274 29 80","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la R\u00e9gence, 4","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Centre Culturel Cor\u00e9en de Bruxelles","address_street_name":"Rue de la R\u00e9gence","address_street_number":"4","address_street_box":null,"email":"info@kccbrussels.be","website":"http:\/\/brussels.korean-culture.org\/","phone_contact":"+32 2 274 29 80","phone_booking":"+32 2 274 29 80","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la R\u00e9gence, 4","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Centre Culturel Cor\u00e9en de Bruxelles","address_street_name":"Rue de la R\u00e9gence","address_street_number":"4","address_street_box":null,"email":"info@kccbrussels.be","website":"http:\/\/brussels.korean-culture.org\/","phone_contact":"+32 2 274 29 80","phone_bookin