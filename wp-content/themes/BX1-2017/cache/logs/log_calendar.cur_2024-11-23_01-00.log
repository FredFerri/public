enda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700003225"},"pt":{"name":"100 jaar Puccini: Concert 'IL BEL SOGNO DI PUCCINI'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700003225"},"en":{"name":"100 jaar Puccini: 'IL BEL SOGNO DI PUCCINI'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700003225"},"it":{"name":"100 jaar Puccini: Concert 'IL BEL SOGNO DI PUCCINI'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700003225"},"cn":{"name":"100 jaar Puccini: Concert 'IL BEL SOGNO DI PUCCINI'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700003225"},"fr":{"name":"100 jaar Puccini: 'IL BEL SOGNO DI PUCCINI'","shortdescr":"Concert \u00ab  IL BEL SOGNO DI PUCCINI \u00bb avec une courte introduction en NL\/FR. \nAu programme : musique de chambre de Puccini, des arias et des parties du Requiem, interpr\u00e9t\u00e9es dans un cadre intime.\n","longdescr":"Concert \u00ab  IL BEL SOGNO DI PUCCINI \u00bb avec une courte introduction en NL\/FR. \nAu programme : musique de chambre de Puccini, des arias et des parties du Requiem, interpr\u00e9t\u00e9es dans un cadre intime.\n\nCe concert fait partie d'un programme plus large autour du 100e anniversaire de l'enterrement de Puccini. Des ateliers cr\u00e9atifs sont \u00e9galement organis\u00e9s le 23\/11, une conf\u00e9rence le 25\/11 et un concert le 29\/11. \n\n","performers":"Quatuor \u00e0 cordes : Gillis Veldeman et Keren-Peta Lorier (violon), Ngoc Phung Ha (alto), Elke Wijnants (violoncelle), \u00c9milie Tack : mezzo-soprano, Jean-Philippe Collard-Neven : piano\nIntroduction par Wim Van Breuseghem, programmateur de Classiques \u00e0 l'Abbaye (Dieleghem, Jette)\n","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700003225"},"sp":{"name":"100 jaar Puccini: Concert 'IL BEL SOGNO DI PUCCINI'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700003225"},"nl":{"name":"100 jaar Puccini: 'IL BEL SOGNO DI PUCCINI'","shortdescr":"Concert \u2018IL BEL SOGNO DI PUCCINI\u2019 met korte inleiding in NL\/FR.\nOp het programma: kamermuziek van Puccini evenals aria\u2019s en delen uit het Requiem, uitgevoerd in een intieme setting.\n","longdescr":"Concert \u2018IL BEL SOGNO DI PUCCINI\u2019 met korte inleiding in NL\/FR.\nOp het programma: kamermuziek van Puccini evenals aria\u2019s en delen uit het Requiem, uitgevoerd in een intieme setting.\n\nDit concert kadert in een uitgebreider programma rond de 100ste verjaardag van de begrafenis van Puccini. Er zijn ook nog creatieve workshops op 23\/11, een lezing op 25\/11 en een concert op 29\/11. \n","performers":"Strijkkwartet: Gillis Veldeman en Keren-Peta Lorier (viool), Ngoc Phung Ha (altviool), Elke Wijnants (cello), \u00c9milie Tack: mezzosopraan, Jean-Philippe Collard-Neven: piano\nIntroductie door Wim Van Breuseghem, programmator voor Klassiek in de Abdij (Dieleghem, Jette)\n","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700003225"}},"place":{"id":753,"translations":{"de":{"name":"Mus\u00e9e Charlier","address_street_name":"Avenue des Arts","address_street_number":"16","address_street_box":null,"email":"info@charliermuseum.be","website":"http:\/\/www.charliermuseum.be","phone_contact":"+32 2 217 81 61","phone_booking":"+32 2 217 81 61","address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Avenue des Arts, 16","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"Das 1928 eingeweihte Museum ist wie ein Gem\u00e4lde der Epoche... man findet sich in der Zeit der La Libre Est\u00e9tique und der Groupe des 20 wieder. Die Sammlungen werden in den reich mit Mobiliar und historischen Dekorationsgegenst\u00e4nden (Louis XV, Louis XV und Empire) best\u00fcckten Salons ausgestellt.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Mus\u00e9e Charlier","address_street_name":"Avenue des Arts","address_street_number":"16","address_street_box":null,"email":"info@charliermuseum.be","website":"http:\/\/www.charliermuseum.be","phone_contact":"+32 2 217 81 61","phone_booking":"+32 2 217 81 61","address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Avenue des Arts, 16","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Charlier Museum","address_street_name":"Avenue des Arts","address_street_number":"16","address_street_box":null,"email":"info@charliermuseum.be","website":"http:\/\/www.charliermuseum.be","phone_contact":"+32 2 217 81 61","phone_booking":"+32 2 217 81 61","address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Avenue des Arts, 16","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"The museum is based in the private mansion, dating from the 19th century, of the sculptor Guillaume Charlier. It focuses on Belgian painting from the late 19th to the early 20th century. Its art exhibitions take place in a setting of lavish furnishings, with numerous decorative pieces from the Louis XV, Louis XVI, and Empire periods.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Mus\u00e9e Charlier","address_street_name":"Avenue des Arts","address_street_number":"16","address_street_box":null,"email":"info@charliermuseum.be","website":"http:\/\/www.charliermuseum.be","phone_contact":"+32 2 217 81 61","phone_booking":"+32 2 217 81 61","address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Avenue des Arts, 16","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Mus\u00e9e Charlier","address_street_name":"Avenue des Arts","address_street_number":"16","address_street_box":null,"email":"info@charliermuseum.be","website":"http:\/\/www.charliermuseum.be","phone_contact":"+32 2 217 81 61","phone_booking":"+32 2 217 81 61","address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Avenue des Arts, 16","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Mus\u00e9e Charlier","address_street_name":"Avenue des Arts","address_street_number":"16","address_street_box":null,"email":"info@charliermuseum.be","website":"http:\/\/www.charliermuseum.be","phone_contact":"+32 2 217 81 61","phone_booking":"+32 2 217 81 61","address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Avenue des Arts, 16","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"Le mus\u00e9e, inaugur\u00e9 en 1928, est comme un tableau d\u2019\u00e9poque\u2026 on se retrouve au temps de La Libre Esth\u00e9tique et du Groupe des 20. Les collections sont expos\u00e9es dans les salons, riches en mobilier et objets d\u2019art d\u00e9coratifs d\u2019\u00e9poque Louis XV, Louis XVI et Empire.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Museo Charlier","address_street_name":"Avenue des Arts","address_street_number":"16","address_street_box":null,"email":"info@charliermuseum.be","website":"http:\/\/www.charliermuseum.be","phone_contact":"+32 2 217 81 61","phone_booking":"+32 2 217 81 61","address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Avenue des Arts, 16","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"El Museo Charlier, una mansi\u00f3n del siglo XIX obra de Horta durante sus a\u00f1os de juventud, te sumergir\u00e1 en la atm\u00f3sfera de un lujoso sal\u00f3n de arte: la Belle Epoque te invita a so\u00f1ar, a pasear entre las esculturas de Charlier, Hager y Wouters, las pinturas de Smits, Fr\u00e9d\u00e9ric, Oleffe, Laermans, Van Strydonck, Ensor... Este ambiente \u00edntimo se completa con los muebles de los ebanistas Chapuis, Sen\u00e9, Nadal l'A\u00een\u00e9, numerosos objetos de arte decorativo de estilos Luis XIV, XV, XVI y estilo Imperio, tapices de Bruselas y Audenaerde, as\u00ed como excepcionales un excepcional sal\u00f3n chino. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Charliermuseum","address_street_name":"Kunstlaan","address_street_number":"16","address_street_box":null,"email":"info@charliermuseum.be","website":"http:\/\/www.charliermuseum.be","phone_contact":"+32 2 217 81 61","phone_booking":"+32 2 217 81 61","address_zip":"1210","address_city":"Sint-Joost-Ten-Node","address_line1":"Kunstlaan, 16","address_line2":"1210 Sint-Joost-Ten-Node","description_web":"Het museum, geopend in 1928, is gevestigd in het prive-herenhuis van de beeldhouwer Guillaume Charlier, dat dateert uit de 19e eeuw. Het richt zich op de Belgische schilderkunst van eind 19e tot begin 20e eeuw. De collecties worden getoond in de salons, rijkelijk voorzien van decoratieve stukken uit de Louis XV, Louis XVI en Empire periodes.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[9],"translations":{"de":["Europ\u00e4isches Viertel"],"pt":[null],"en":["European Quarter"],"it":["Quartiere europeo"],"cn":[null],"fr":["Quartier europ\u00e9en"],"sp":["Barrio Europeo"],"nl":["Europese wijk"]}},"zones":{"list":[22],"translations":{"de":["Osten"],"pt":[null],"en":["East"],"it":["Est"],"cn":[null],"fr":["Est"],"sp":["Este"],"nl":["Oost"]}},"neca":null,"facebook_id":null,"backoffice_id":152,"location":{"lat":50.84755959,"lon":4.36997724},"region":"brussels","last_updated_at":"2024-01-25T14:18:44+01:00","published_at":"2013-10-19T01:13:19+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":239082,"translations":{"de":{"name":"Dienst Nederlandse Cultuur van Schaarbeek","address_street_name":"Avenue Rodenbach","address_street_number":"29","address_street_box":null,"email":"nederlandse.cultuur@1030.be","website":null,"phone_contact":"+32 2 431 65 79","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Avenue Rodenbach, 29","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Dienst Nederlandse Cultuur van Schaarbeek","address_street_name":"Avenue Rodenbach","address_street_number":"29","address_street_box":null,"email":"nederlandse.cultuur@1030.be","website":null,"phone_contact":"+32 2 431 65 79","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Avenue Rodenbach, 29","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":nul