isciplinare","Musei e centri artistici"],"cn":[null,null],"fr":["Pluridisciplinaire","Mus\u00e9es et art centers"],"sp":["Multidisciplinar","Museos y centros de arte"],"nl":["Multidisciplinair","Musea en kunstcentra"]}}},"translations":{"de":{"name":"Expo \"Les Particules imaginaires\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.rouge-cloitre.be","email":"info@rouge-cloitre.be","phone_contact":"+32 2 660 55 97","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50011015"},"pt":{"name":"Expo \"Les Particules imaginaires\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.rouge-cloitre.be","email":"info@rouge-cloitre.be","phone_contact":"+32 2 660 55 97","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50011015"},"en":{"name":"Les Particules imaginaires","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.rouge-cloitre.be","email":"info@rouge-cloitre.be","phone_contact":"+32 2 660 55 97","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50011015"},"it":{"name":"Expo \"Les Particules imaginaires\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.rouge-cloitre.be","email":"info@rouge-cloitre.be","phone_contact":"+32 2 660 55 97","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50011015"},"cn":{"name":"Expo \"Les Particules imaginaires\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.rouge-cloitre.be","email":"info@rouge-cloitre.be","phone_contact":"+32 2 660 55 97","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50011015"},"fr":{"name":"Les Particules imaginaires","shortdescr":"Entre figuratif et abstraction, Martin Coiffier transforme des for\u00eats en tableaux d\u2019\u00e9nergie vive par le biais de la photographie, de la peinture et d\u2019installations. Virginie Jux et Nicolas Tourte l\u2019accompagnent dans son voyage onirique.","longdescr":"Martin Coiffier accompagn\u00e9 de Virginie Jux et de Nicolas Tourte. \nExposition \"Les Particules imaginaires\"\nMartin Coiffier (\u00b01973) na\u00eet en France, grandit en Espagne et vit depuis 20 ans en Belgique. Des racines multiples que l\u2019on compare volontiers aux nombreuses techniques qu\u2019il utilise dans sa pratique artistique. Une certaine multiplicit\u00e9 qui est \u00e0 retrouver \u00e9galement dans la plasticit\u00e9 de ses \u0153uvres et qu\u2019il associe \u00e0 une volont\u00e9 de \u00ab provoquer incessamment la d\u00e9multiplication des plans et des lectures \u00bb. Que son support de cr\u00e9ation soit plane ou courb\u00e9, compos\u00e9 d\u2019une unique surface ou de plusieurs niveaux, Martin Coiffier d\u00e9joue le sens de compr\u00e9hension du spectateur, amenant celui-ci \u00e0 s\u2019interroger sur la vraie nature de l\u2019\u0153uvre qu\u2019il a devant les yeux. Martin Coiffier est donc un artiste multidisciplinaire qui photographie, peint, dessine, sculpte, et r\u00e9alise des installations. Pour cette exposition intitul\u00e9e \u00ab Les Particules imaginaires \u00bb, il nous invite dans un espace entre ciel et terre, o\u00f9 les extr\u00e9mit\u00e9s se rejoignent pour ne former plus qu\u2019une seule r\u00e9alit\u00e9, un seul imaginaire. Pour ce faire, un d\u00e9placement s\u2019op\u00e8re : le vert de la for\u00eat rejoint le bleu du ciel. Un imaginaire que l\u2019artiste convoite, celui \u00ab qui nous maintient en vie \u00bb, dit-il, et \u00ab celui qui participe \u00e0 notre \u00e9quilibre \u00bb. C\u2019est ainsi que l\u2019artiste parle de \u00ab particules de pens\u00e9es \u00bb. \u00ab Elles se dressent depuis le sol (nos racines), et s\u2019\u00e9rigent vers le ciel \u00bb. \u00c0 l\u2019occasion de cette exposition, l\u2019artiste pr\u00e9sente des \u0153uvres monumentales de la s\u00e9rie \u00ab Under the Rainbow \u00bb, repr\u00e9sentant des vues de for\u00eats et r\u00e9alis\u00e9es au croisement de diverses techniques. Les visiteurs pourront \u00e9galement d\u00e9couvrir plusieurs \u0153uvres tridimensionnelles, sous la forme d\u2019installations a\u00e9riennes. Par ailleurs, certaines des pi\u00e8ces pr\u00e9sent\u00e9es seront r\u00e9alis\u00e9es sp\u00e9cifiquement pour l\u2019exposition, au d\u00e9part de la For\u00eat de Soignes environnant le site de Rouge-Clo\u00eetre. Enfin, deux autres artistes accompagnent Martin Coiffier : il s\u2019agit de Virginie Jux qui s\u2019int\u00e9resse au mouvement dans l\u2019\u00e9criture, et de Nicolas Tourte, qui questionne notre relation \u00e0 la r\u00e9alit\u00e9 et \u00e0 ses usages quotidiens. Une exposition sous le signe du vivant, comme une respiration en communion avec le site naturel de Rouge-Clo\u00eetre.","performers":"Martin Coiffier accompagn\u00e9 de Virginie Jux et de Nicolas Tourte.","boxoffice_url":null,"website":"http:\/\/www.rouge-cloitre.be","email":"info@rouge-cloitre.be","phone_contact":"+32 2 660 55 97","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50011015"},"sp":{"name":"Expo \"Les Particules imaginaires\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.rouge-cloitre.be","email":"info@rouge-cloitre.be","phone_contact":"+32 2 660 55 97","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50011015"},"nl":{"name":"Les Particules imaginaires","shortdescr":"Ergens tussen figuratief en abstract transformeert Martin Coiffier bossen in taferelen van levende energie door middel van fotografie, schilderkunst en installaties. Virginie Jux en Nicolas Tourte vergezellen hem op zijn droomachtige reis.","longdescr":"Martin Coiffier, samen met Virginie Jux en Nicolas Tourte.\nTentoonstelling \"Les Particules imaginaires\"\nMartin Coiffier (\u00b01973) werd geboren in Frankrijk, groeide op in Spanje en woont al 20 jaar in Belgi\u00eb. Zijn vele wortels weerspiegelen zich in de veelheid aan technieken die hij gebruikt in zijn kunst. Die veelvormigheid uit zich ook in de plasticiteit van  zijn werk. Zelf spreekt hij van een verlangen om 'voortdurend de vermenigvuldiging van vlakken en lezingen uit te lokken'. \nOf zijn creatieve medium nu plat of gebogen is, uit een enkel oppervlak bestaat of uit meerdere niveaus, Martin Coiffier stuurt het begrip van de kijker in de war, waardoor die de ware aard van het werk voor zijn ogen in twijfel trekt. Martin Coiffier is een multidisciplinair kunstenaar die fotografeert, schildert, tekent, beeldhouwt en installaties maakt. Voor deze tentoonstelling, getiteld 'Les Particules imaginaires', nodigt hij ons uit in een ruimte tussen hemel en aarde, waar de uitersten elkaar ontmoeten om \u00e9\u00e9n werkelijkheid en denkbeeldig universum te vormen. Hiertoe doet zich een verplaatsing voor waarbij het groen van het bos het blauw van de lucht ontmoet. Een denkbeeldige wereld die de kunstenaar opzoekt, 'die ons in leven houdt en bijdraagt aan ons evenwicht', zegt hij. In dat verband spreekt de kunstenaar van 'particules de pens\u00e9es' (gedachtedeeltjes). 'Ze rijzen op uit de grond (onze wortels) en reiken naar de hemel.'\nVoor deze tentoonstelling presenteert de kunstenaar monumentale werken uit de serie 'Under the Rainbow', met zichten van bossen waarbij hij gebruikmaakt van een breed scala aan technieken. Bezoekers kunnen ook een aantal driedimensionale werken ontdekken in de vorm van luchtinstallaties. Sommige stukken worden overigens speciaal voor de tentoonstelling gemaakt, vertrekkend van het Zoni\u00ebnwoud rond de site van het Rood Klooster. Tot slot begeleiden twee andere kunstenaars Martin Coiffier bij deze tentoonstelling. Virginie Jux is ge\u00efnteresseerd in beweging in het schrijven, terwijl Nicolas Tourte onze relatie met de werkelijkheid en het alledaagse gebruik ervan in vraag stelt. Een tentoonstelling, kortom, die in het teken staat van het leven, een frisse wind in harmonie met de natuurlijke omgeving van het Rood Klooster.","performers":"Martin Coiffier, samen met Virginie Jux en Nicolas Tourte.","boxoffice_url":null,"website":"http:\/\/www.rouge-cloitre.be","email":"info@rouge-cloitre.be","phone_contact":"+32 2 660 55 97","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50011015"}},"place":{"id":1353,"translations":{"de":{"name":"Centre d'Art de Rouge-Clo\u00eetre","address_street_name":"Rue du Rouge-Clo\u00eetre","address_street_number":"4","address_street_box":null,"email":"info@rouge-cloitre.be","website":"http:\/\/www.rouge-cloitre.be","phone_contact":"+32 2 660 55 97","phone_booking":null,"address_zip":"1160","address_city":"Auderghem","address_line1":"Rue du Rouge-Clo\u00eetre, 4","address_line2":"1160 Auderghem","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Centre d'Art de Rouge-Clo\u00eetre","address_street_name":"Rue du Rouge-Clo\u00eetre","address_street_number":"4","address_street_box":null,"email":"info@rouge-cloitre.be","website":"http:\/\/www.rouge-cloitre.be","phone_contact":"+32 2 660 55 97","phone_booking":null,"address_zip":"1160","address_city":"Auderghem","address_line1":"Rue du Rouge-Clo\u00eetre, 4","address_line2":"1160 Auderghem","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Red Cloister Art Centre","address_street_name":"Rue du Rouge-Clo\u00eetre","address_street_number":"4","address_street_box":null,"email":"info@rouge-cloitre.be","website":"http:\/\/www.rouge-cloitre.be","phone_contact":"+32 2 660 55 97","phone_booking":null,"address_zip":"1160"