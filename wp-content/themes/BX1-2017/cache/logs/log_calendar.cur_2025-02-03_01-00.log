partoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2025-02-02T01:01:51+01:00","published_at":"2024-12-04T10:09:01+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":313093,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"other","ranking":0.2811442217672498,"languages":{"spoken":["nl","fr","en"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[39,36],"translations":{"de":["Fotografie","Museen & Kunstzentren"],"pt":[null,null],"en":["Photography","Museums and art centers"],"it":["Fotografia","Musei e centri artistici"],"cn":[null,null],"fr":["Photographie","Mus\u00e9es et art centers"],"sp":["Fotograf\u00eda","Museos y centros de arte"],"nl":["Fotografie","Musea en kunstcentra"]}}},"translations":{"de":{"name":"STEREO Explorers & Tourists -Travel Photography 1880-1930","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/tinygallery.photo\/fr","email":"olivier@tinygallery.brussels","phone_contact":"+32 475 27 95 56","phone_booking":"+32 475 27 95 56","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700004231"},"pt":{"name":"STEREO Explorers & Tourists -Travel Photography 1880-1930","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/tinygallery.photo\/fr","email":"olivier@tinygallery.brussels","phone_contact":"+32 475 27 95 56","phone_booking":"+32 475 27 95 56","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700004231"},"en":{"name":"STEREO Explorers & Tourists -Travel Photography 1880-1930","shortdescr":"This exhibition immerses visitors in the golden age of travel photography through stereo plates and stereoscopes, offering a unique 3D experience. It showcases the technological achievement and highlights the work of amateur and exploratory photographers, both men and women, who documented landscapes, cultures, and historical moments around the world.","longdescr":"Amateur stereo photographers played a crucial role in popularizing and spreading three-dimensional photography. The increasing accessibility and affordability of the technology allowed many enthusiasts to experiment with stereo photography and share their creations with family and friends, enabling a wider audience to explore distant places from the comfort of their homes. Unlike professional photographs, which focused on grand expeditions or significant events, amateur photographers captured scenes of everyday life. These images provide invaluable historical records, offering a more intimate and personal view of the era. Today, they are used for educational and cultural purposes, preserving a snapshot of life at the turn of the century.","performers":"Olivier Guyaux; Alain Roch; Petermfriess; Laure Winants; Wout De Ridder","boxoffice_url":null,"website":"https:\/\/tinygallery.photo\/","email":"olivier@tinygallery.brussels","phone_contact":"+32 475 27 95 56","phone_booking":"+32 475 27 95 56","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700004231"},"it":{"name":"STEREO Explorers & Tourists -Travel Photography 1880-1930","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/tinygallery.photo\/fr","email":"olivier@tinygallery.brussels","phone_contact":"+32 475 27 95 56","phone_booking":"+32 475 27 95 56","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700004231"},"cn":{"name":"STEREO Explorers & Tourists -Travel Photography 1880-1930","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/tinygallery.photo\/fr","email":"olivier@tinygallery.brussels","phone_contact":"+32 475 27 95 56","phone_booking":"+32 475 27 95 56","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700004231"},"fr":{"name":"STEREO Explorateurs et touristes - Photographie de voyage 1880-1930","shortdescr":"L' exposition plonge les visiteurs dans l'\u00e2ge d'or de la photographie de voyage \u00e0 travers les plaques st\u00e9r\u00e9oscopiques et les st\u00e9r\u00e9oscopes, offrant une exp\u00e9rience 3D unique. Elle met en valeur les prouesses technologiques et met en lumi\u00e8re le travail des photographes amateurs et explorateurs, hommes et femmes, qui ont document\u00e9 des paysages et des cultures \u00e0 travers le monde.","longdescr":"Les photographes amateurs ont jou\u00e9 un r\u00f4le crucial dans la popularisation et la diffusion de la photographie tridimensionnelle. L'accessibilit\u00e9 et le prix de plus en plus abordables de cette technologie ont permis \u00e0 de nombreux passionn\u00e9s d'exp\u00e9rimenter la photographie st\u00e9r\u00e9o et de partager leurs cr\u00e9ations avec leur famille et leurs amis, permettant ainsi \u00e0 un public plus large d'explorer des lieux \u00e9loign\u00e9s dans le confort de leur foyer. Contrairement aux photographes professionnels, qui se concentraient sur les grandes exp\u00e9ditions ou les \u00e9v\u00e9nements marquants, les photographes amateurs capturaient des sc\u00e8nes de la vie quotidienne. Ces images constituent des documents historiques pr\u00e9cieux, offrant une vision plus intime et personnelle de l'\u00e9poque. ","performers":"Olivier Guyaux; Alain Roch; Petermfriess; Laure Winants; Wout De Ridder","boxoffice_url":null,"website":"https:\/\/tinygallery.photo\/fr","email":"olivier@tinygallery.brussels","phone_contact":"+32 475 27 95 56","phone_booking":"+32 475 27 95 56","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700004231"},"sp":{"name":"STEREO Explorers & Tourists -Travel Photography 1880-1930","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/tinygallery.photo\/fr","email":"olivier@tinygallery.brussels","phone_contact":"+32 475 27 95 56","phone_booking":"+32 475 27 95 56","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700004231"},"nl":{"name":"STEREO Ontdekkingsreizigers & Toeristen - Reisfotografie 1880-1930","shortdescr":"Deze tentoonstelling dompelt bezoekers onder in de gouden eeuw van reisfotografie via stereoplaten en stereoscopen, en biedt een unieke 3D-ervaring. Het toont de technologische prestatie en benadrukt het werk van amateur- en exploratieve fotografen, zowel mannen als vrouwen, die landschappen, culturen en historische momenten over de hele wereld documenteerden.","longdescr":"Amateur stereofotografen speelden een cruciale rol in het populariseren en verspreiden van driedimensionale fotografie. De toenemende toegankelijkheid en betaalbaarheid van de technologie stelde veel liefhebbers in staat om te experimenteren met stereofotografie en hun creaties te delen met familie en vrienden, waardoor een breder publiek verre oorden kon verkennen vanuit het comfort van hun huis.\n","performers":"Olivier Guyaux; Alain Roch; Petermfriess; Laure Winants; Wout De Ridder","boxoffice_url":null,"website":"https:\/\/tinygallery.photo\/nl","email":"olivier@tinygallery.brussels","phone_contact":"+32 475 27 95 56","phone_booking":"+32 475 27 95 56","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700004231"}},"place":{"id":275243,"translations":{"de":{"name":"TinyGallery Brussels","address_street_name":"Rue de la Cuve","address_street_number":"26","address_street_box":null,"email":"ogc@ogc.be","website":"http:\/\/www.tinygallery.photo","phone_contact":"+32 475 27 95 56","phone_booking":"+32 472 27 95 56","address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de la Cuve, 26","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"TinyGallery Brussels","address_street_name":"Rue de la Cuve","address_street_number":"26","address_street_box":null,"email":"ogc@ogc.be","website":"http:\/\/www.tinygallery.photo","phone_contact":"+32 475 27 95 56","phone_booking":"+32 472 27 95 56","address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de la Cuve, 26","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"TinyGallery Brussels","address_street_name":"Rue de la Cuve","address_street_number":"26","address_street_box":null,"email":"ogc@ogc.be","website":"http:\/\/www.tinygallery.photo","phone_contact":"+32 475 27 95 56","phone_booking":"+32 472 27 95 56","address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de la Cuve, 26","address_line2":"1050 Ixelles","description_web":"TinyGallery - Small museum of amateur photography - wishes to preserve amateur photography and pay tribute to the anonymous artists who authored them.\r\n\r\nWhether produced intentionally or accidentally, amateur photography fascinates us with its spontaneous creations. Magical, raw moments are captured, allowing us an intimate insight into the lives of strangers who lived over a century ago. In a nod to the vanity of the ephemeral, these benevolent ghosts, who have long been protected by the shadows of the past, surprise us with their proximity. Battered and bruised albums scattered over flea markets surrender to us defencelessly, bearing witness to a time when photography was not considered dangerous. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"TinyGallery Brussels","address_street_name":"Rue de la Cuve","address_street_number":"26","address_street_box":null,"email":"ogc@ogc.be","website":"http:\/\/www.tinygallery.photo","phone_contact":"+32 475 27 95 56","phone_booking":"+32 472 27 95 56","address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de la Cuve, 26","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"TinyGallery Brussels","address_street_name":"Rue de la Cuve","address_street_number":"26","address_street_box":null,"email":"ogc@ogc.be","website":"http:\/\/www.tinygallery.photo","phone_contact":"+32 475 27 95 56","phone_booking":"+32 472 27 95 56","address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de la Cuve, 26","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"TinyGallery Brussels","address_street_name":"Rue de la Cuve","address_street_number":"26","address_street_box":null,"email":"ogc@ogc.be","website":"http:\/\/www.tinygallery.photo","phone_contact":"+32 475 27 95 56","phone_booking":"+32 472 27 95 56","address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de la Cuve, 26","address_line2":"1050 Ixelles","description_web":"La TinyGallery - Petit mus\u00e9e de la photographie amateur - veut conserver la photographie amateur et rendre hommage \u00e0 leurs auteurs, ces artistes anonymes.\r\n\r\nIntentionnelle ou accidentelle, la photographie amateur nous fascine par ses cr\u00e9ations spontan\u00e9es. Instants magiques et bruts o\u00f9 nous entrons dans l\u2019intimit\u00e9 de ces inconnus \u00e0 plus d\u2019un si\u00e8cle de distance. Clins d'oeil \u00e0 la vanit\u00e9 de l'\u00e9ph\u00e9m\u00e8re, ces fant\u00f4mes bienveillants longtemps prot\u00e9g\u00e9s dans l\u2019ombre des albums nous surprennent par leur proximit\u00e9. Albums d\u00e9piaut\u00e9s, dispers\u00e9s, brocant\u00e9s, se livrant et sans d\u00e9fenses, ils sont les t\u00e9moins d\u2019un temps o\u00f9 la photographie n'\u00e9tait pas consid\u00e9r\u00e9e comme dangereuse. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"TinyGallery Brussels","address_street_name":"Rue de la Cuve","address_street_number":"26","address_street_box":null,"email":"ogc@ogc.be","website":"http:\/\/www.tinygallery.photo","phone_contact":"+32 475 27 95 56","phone_booking":"+32 472 27 95 56","address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de la Cuve, 26","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"TinyGallery Brussels","address_street_name":"Kuipstraat","address_street_number":"26","address_street_box":null,"email":"ogc@ogc.be","website":"http:\/\/www.tinygallery.photo","phone_contact":"+32 475 27 95 56","phone_booking":"+32 472 27 95 56","address_zip":"1050","address_city":"Elsene","address_line1":"Kuipstraat, 26","address_line2":"1050 Elsene","description_web":"TinyGallery - Klein museum voor amateurfotografie - wil de amateurfotografie conserveren en hulde brengen aan hun auteurs, deze anonieme kunstenaars.\r\n\r\nAmateurfotografie fascineert ons door de spontane creaties. Ze ontstaan doelbewust of ongewild, die magische en authentieke fragmenten van de intimiteit van onbekenden die meer dan een eeuw geleden leefden. Een knipoog naar de ijdelheid van het kortstondige, welwillende geesten die lang beschermd waren in de schaduw van vergeten albums. Ze verrassen ons met hun nabijheid, intieme albums die weerloos opengerukt eindigden op de rommelmarkt, stille getuigen van een tijd waarin fotografie niet als gevaarlijk werd beschouwd. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[5],"translations":{"de":["Flagey