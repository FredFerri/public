e":{"name":"L'Expo Clito - la seconde origine du monde","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/culture.ulb.be\/programmation\/actualites\/lexpo-clito-la-seconde-origine-du-monde","email":"culture@ulb.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50007605"},"pt":{"name":"L'Expo Clito - la seconde origine du monde","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/culture.ulb.be\/programmation\/actualites\/lexpo-clito-la-seconde-origine-du-monde","email":"culture@ulb.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50007605"},"en":{"name":"L'Expo Clito - la seconde origine du monde","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/culture.ulb.be\/programmation\/actualites\/lexpo-clito-la-seconde-origine-du-monde","email":"culture@ulb.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50007605"},"it":{"name":"L'Expo Clito - la seconde origine du monde","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/culture.ulb.be\/programmation\/actualites\/lexpo-clito-la-seconde-origine-du-monde","email":"culture@ulb.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50007605"},"cn":{"name":"L'Expo Clito - la seconde origine du monde","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/culture.ulb.be\/programmation\/actualites\/lexpo-clito-la-seconde-origine-du-monde","email":"culture@ulb.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50007605"},"fr":{"name":"L'Expo Clito - la seconde origine du monde","shortdescr":"L'Universit\u00e9 libre de Bruxelles (ULB) vous invite \u00e0 explorer le fascinant parcours de l'Expo Clito, une exposition d\u00e9di\u00e9e \u00e0 la d\u00e9couverte du clitoris, de son histoire et de sa repr\u00e9sentation \u00e0 travers les \u00e2ges. Du 9 mars au 7 juin 2024, venez parcourir une collection d'\u0153uvres contemporaines enrichie de perspectives scientifiques, de textes litt\u00e9raires et de discours f\u00e9ministes.","longdescr":"L\u2019Expo Clito a pour objectif de montrer le clitoris, son historique et sa repr\u00e9sentation \u00e0 travers les si\u00e8cles. Elle est un parcours d\u2019\u0153uvres contemporaines (peintures, dessins, sculptures, projections, installations, films d\u2019animations, films...) \u00e9tay\u00e9 par des r\u00e9flexions scientifiques avec des documents issus du domaine m\u00e9dical et de la sexologie, des textes litt\u00e9raires, des manifestes f\u00e9ministes.\n\nL'Universit\u00e9 libre de Bruxelles (ULB) vous invite \u00e0 explorer le fascinant parcours de l'Expo Clito, une exposition d\u00e9di\u00e9e \u00e0 la d\u00e9couverte du clitoris, de son histoire et de sa repr\u00e9sentation \u00e0 travers les \u00e2ges. Du 9 mars au 7 juin 2024, venez parcourir une collection d'\u0153uvres contemporaines enrichie de perspectives scientifiques, de textes litt\u00e9raires et de discours f\u00e9ministes.\n\nL'Expo Clito est une exp\u00e9rience \u00e0 la fois \u00e9ducative et ludique, convenant aux publics scolaires et universitaires, soutenue par des outils p\u00e9dagogiques fournis par le CAL et le GAMS Belgique, O'YES ASBL, l\u2019UNIGE, La R\u00e9serve pr\u00e9cieuse, l'ONF - l\u2019Office national du film du Canada, Iota Production, l'Acad\u00e9mie Royale de M\u00e9decine de Belgique, la Biblioth\u00e8que de l\u2019ULB, ERASME, Le Centre Maurice Chalumeau en sciences des sexualit\u00e9s de l'Universit\u00e9 de Gen\u00e8ve, Eva Luna, Arte et Squawk Productions, Kultur | lx, la RTBF, les Culottes Parlottes, le Cabinet Psycho-Sexo (avec Jana\u00efna Benoit, psychologue et sexologue clinicienne; Jo\u00eblle Winkel, kin\u00e9sith\u00e9rapeute sp\u00e9cialis\u00e9e en cha\u00eenes musculaires (G.D.S.), en p\u00e9rinatal et en r\u00e9\u00e9ducation p\u00e9rin\u00e9ale; Laurie Mertens; psychologue et sexologue clinicienne, Petra Cremer, Docteur en m\u00e9decine, gyn\u00e9cologue \u2013 obst\u00e9tricienne; Alexandra de Troz, psychologue et sexologue clinicienne).\nRejoignez-nous pour une plong\u00e9e artistique et \u00e9ducative dans le monde de la sexualit\u00e9 f\u00e9minine, o\u00f9 l'art rencontre la science et la soci\u00e9t\u00e9. Ne manquez pas cette occasion unique d'aborder un sujet \u00e0 la fois intime et universel \u00e0 l'Expo Clito \u00e0 l'ULB.\n\nSeront expos\u00e9\u00b7es : Sam Hil Atalanta, Tamina Beausoleil, Diane Bogaerts, Natacha de Locht, Cynthia Evers, Franca Franchi, Galia-Ganga, Catherine Geoffray, Isa Kaos, Rachel Labastie, Christian Mahy, Lori Malepart, Sara J\u00fadice de Menezes, A\u00efda Patricia Schweitzer, Val\u00e9rie Provost et l'atelier Culottes parlottes , Brigitte van de Kerchove, B\u00e9n\u00e9dicte Van Der Reydt, Catherine Vers\u00e9, Godfrey Williams-Okorodus.\n\nCommissaires scientifiques : Val\u00e9rie Piette et Laurence Rosier (ULB)\nCommissaires artistiques : Natacha de Locht et Brigitte van de Kerchove\n\nDu 9 mars 2024 au 7 juin 2024.\nDu mardi au vendredi de 12h \u00e0 18h.\nULB, Campus du Solbosch : Salle Allende, avenue Paul H\u00e9ger, b\u00e2timent F1, 2e niveau (1050 Bruxelles).\n\nNocturnes les jeudis 21 mars, 18 avril et 16 mai de 18 \u00e0 20 heures.\n\nPour plus d'informations : www.ulb.be\/expo-clito\nInformations et contacts : culture@ulb.be","performers":"Sam Hil Atalanta, Tamina Beausoleil, Diane Bogaerts, Natacha de Locht, Cynthia Evers, Franca Franchi, Galia Ganga, Catherine Geoffray, Isa Kaos, Rachel Labastie, Christian Mahy, Lori Mal\u00e9part-Traversy, Sara J\u00fadice de Menezes, A\u00efda Patricia Schweitzer, Val\u00e9rie Provost et le projet \"Culottes parlottes\", Brigitte van de Kerchove, B\u00e9n\u00e9dicte Vanderreydt, Catherine Vers\u00e9, Godfrey Williams-Okorodus","boxoffice_url":null,"website":"https:\/\/culture.ulb.be\/programmation\/actualites\/lexpo-clito-la-seconde-origine-du-monde","email":"culture@ulb.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50007605"},"sp":{"name":"L'Expo Clito - la seconde origine du monde","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/culture.ulb.be\/programmation\/actualites\/lexpo-clito-la-seconde-origine-du-monde","email":"culture@ulb.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50007605"},"nl":{"name":"L'Expo Clito - la seconde origine du monde","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/culture.ulb.be\/programmation\/actualites\/lexpo-clito-la-seconde-origine-du-monde","email":"culture@ulb.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50007605"}},"place":{"id":274179,"translations":{"de":{"name":"ULB Culture","address_street_name":"CP 166\/02 50 , avenue Franklin D. Roosevelt","address_street_number":null,"address_street_box":null,"email":"Culture@ulb.be","website":"http:\/\/www.ulb.be\/culture","phone_contact":"+32 2 650 37 65","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"CP 166\/02 50 , avenue Franklin D. Roosevelt","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"ULB Culture","address_street_name":"CP 166\/02 50 , avenue Franklin D. Roosevelt","address_street_number":null,"address_street_box":null,"email":"Culture@ulb.be","website":"http:\/\