12-15  yr.","Youth 15-18  yr.","LGTBQIA","Seniors"]}},"tags":["kids"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-07-28T17:35:05+02:00","published_at":"2022-07-05T15:56:26+02:00","backoffice_id":257832,"import_origin":null,"sub_type":"concert","show_in_agenda":true,"ranking":1.2599210498949},{"id":539350,"date_start":"2022-08-23","date_end":"2022-08-23","date_next":"2022-08-23","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{"list":[105],"translations":{"fr":["Gastronomie"],"nl":["Gastronomie"],"en":["Gastronomy"]}}},"languages":{"spoken":["fr","en"],"subtitles":[]},"translations":{"fr":{"name":"D\u00e9guster les bi\u00e8res de la Senne avec Once in Brussels","shortdescr":"Entre boire une bi\u00e8re et la d\u00e9guster, il y a un monde de diff\u00e9rences. Cette activit\u00e9 vous emm\u00e8ne dans l\u2019univers du go\u00fbt de la brasserie de la Senne.","longdescr":"Entre boire une bi\u00e8re et la d\u00e9guster, il y a un monde de diff\u00e9rences. Cette activit\u00e9 vous emm\u00e8ne dans l\u2019univers du go\u00fbt de la brasserie de la Senne. Guid\u00e9s par nos sp\u00e9cialistes, venez d\u00e9couvrir les techniques et le vocabulaire de la d\u00e9gustation, venez booster vos sens au travers d\u2019exercices sensoriels et venez titiller vos papilles avec des bi\u00e8res qui vous emm\u00e8nent sur des chemins moins connus. Les sessions de d\u00e9gustation de Once in Brussels s\u2019adressent \u00e0 tout le monde, que vous vous y connaissiez un peu ou pas du tout. Nous prendrons le temps avec vous de nous attaquer aux clich\u00e9s, de poser les bonnes questions et de r\u00e9pondre \u00e0 vos interrogations. Et si, finalement, tout le monde aimait la bi\u00e8re ?\r\nR\u00e9servation n\u00e9cessaire\r\nAlso available in English","performers":null,"boxoffice_url":null,"website":"https:\/\/onceinbrussels.be\/produit\/deguster-les-bieres-de-la-senne-avec-once-in-brussels\/","email":"melanie@onceinbrussels.be","phone_contact":null,"phone_booking":"+32 2 850 60 90","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.539350"},"nl":{"name":"D\u00e9guster les bi\u00e8res de la Senne avec Once in Brussels","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"melanie@onceinbrussels.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.539350"},"en":{"name":"D\u00e9guster les bi\u00e8res de la Senne avec Once in Brussels","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"melanie@onceinbrussels.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.539350"},"de":{"name":"D\u00e9guster les bi\u00e8res de la Senne avec Once in Brussels","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.539350"},"it":{"name":"D\u00e9guster les bi\u00e8res de la Senne avec Once in Brussels","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.539350"},"sp":{"name":"D\u00e9guster les bi\u00e8res de la Senne avec Once in Brussels","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_