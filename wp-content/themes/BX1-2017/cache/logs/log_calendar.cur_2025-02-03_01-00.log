nguages":{"spoken":["nl","en","fr"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{}},"translations":{"de":{"name":"Chromatic","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.instagram.com\/thevault.artgallery\/","email":"roxane.lerchs@thevaultgallery.com","phone_contact":"+32 2 245 24 78","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700003846"},"pt":{"name":"Chromatic","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.instagram.com\/thevault.artgallery\/","email":"roxane.lerchs@thevaultgallery.com","phone_contact":"+32 2 245 24 78","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700003846"},"en":{"name":"Chromatic","shortdescr":"The Chromatic exhibition celebrates color in all its forms. Paintings, sculptures, and materials engage in dialogue to offer a unique experience, where shades and textures awaken the senses and transform the gaze.","longdescr":"The Vault Art Gallery presents Chromatic, a group exhibition bringing together the gallery's permanent artists as well as new talents, including Jonty Hurwitz, Patrick Hughes, Lis Sam, Jean Paul Kala, H\u00e9l\u00e8ne Jacubowitz, Gr\u00e9gory Ba\u00f4o, Laurence Jenkell, Sylvain Piget, Didier Engels, Saloua Sarhiri, David Kracov, and many more. This exhibition offers a captivating exploration of the expressive and sensory power of color.\n\nInspired by Pop Art and Optical Art, Chromatic examines how color influences our perception, emotions, and understanding of shapes. Through a variety of works, ranging from painting to wall sculpture, the artists explore the play of shades, reflections, and textures to push visual boundaries and offer an immersive experience.\nChromatic draws on the historical legacy of color, used for centuries as a symbolic language and transformative tool. Each artwork revisits these influences with a contemporary approach, revealing color as a living, vibrant element capable of transforming space and capturing the imagination.\nThis exhibition invites the public to rediscover color as a timeless and innovative force, promising a unique visual immersion and a dialogue between artistic tradition and modernity.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.instagram.com\/thevault.artgallery\/","email":"roxane.lerchs@thevaultgallery.com","phone_contact":"+32 2 245 24 78","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700003846"},"it":{"name":"Chromatic","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.instagram.com\/thevault.artgallery\/","email":"roxane.lerchs@thevaultgallery.com","phone_contact":"+32 2 245 24 78","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700003846"},"cn":{"name":"Chromatic","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.instagram.com\/thevault.artgallery\/","email":"roxane.lerchs@thevaultgallery.com","phone_contact":"+32 2 245 24 78","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700003846"},"fr":{"name":"Chromatic","shortdescr":"L'exposition Chromatic c\u00e9l\u00e8bre la couleur sous toutes ses formes. Peintures, sculptures et mati\u00e8res dialoguent pour offrir une exp\u00e9rience unique, o\u00f9 nuances et textures \u00e9veillent les sens et transforment le regard.","longdescr":"The Vault Art Gallery pr\u00e9sente Chromatic, une exposition collective r\u00e9unissant les artistes permanents de la galerie ainsi que de nouvelles signatures, dont Jonty Hurwitz, Patrick Hughes, Lis Sam, Jean Paul Kala, H\u00e9l\u00e8ne Jacubowitz, Gr\u00e9gory Ba\u00f4o, Laurence Jenkell, Sylvain Piget, Didier Engels, Saloua Sarhiri, David Kracov et bien d\u2019autres. Cette exposition propose une exploration captivante de la puissance expressive et sensorielle de la couleur.\n\nInspir\u00e9e du Pop Art et de l'Optical Art, Chromatic examine la mani\u00e8re dont la couleur influence notre perception, nos \u00e9motions et notre compr\u00e9hension des formes. \u00c0 travers des \u0153uvres vari\u00e9es allant de la peinture \u00e0 la sculpture murale, les artistes explorent des jeux de nuances, de reflets et de textures pour repousser les limites visuelles et offrir une exp\u00e9rience immersive.\nChromatic s'appuie sur l'h\u00e9ritage historique de la couleur, utilis\u00e9e depuis des si\u00e8cles comme langage symbolique et outil de transformation. Chaque \u0153uvre revisite ces influences avec une approche contemporaine, r\u00e9v\u00e9lant la couleur comme un \u00e9l\u00e9ment vivant et vibrant, capable de transformer l'espace et de capter l'imaginaire.\nCette exposition invite le public \u00e0 red\u00e9couvrir la couleur comme une force intemporelle et innovante, promettant une immersion visuelle unique et un dialogue entre tradition artistique et modernit\u00e9.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.instagram.com\/thevault.artgallery\/","email":"roxane.lerchs@thevaultgallery.com","phone_contact":"+32 2 245 24 78","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700003846"},"sp":{"name":"Chromatic","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.instagram.com\/thevault.artgallery\/","email":"roxane.lerchs@thevaultgallery.com","phone_contact":"+32 2 245 24 78","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700003846"},"nl":{"name":"Chromatic","shortdescr":"De Chromatic-tentoonstelling viert kleur in al zijn vormen. Schilderijen, sculpturen en materialen komen in dialoog om een unieke ervaring te bieden, waarbij tinten en texturen de zintuigen prikkelen en de blik transformeren.\n","longdescr":"The Vault Art Gallery presenteert Chromatic, een groepsshow die de vaste kunstenaars van de galerie samenbrengt met nieuwe talenten, waaronder Jonty Hurwitz, Patrick Hughes, Lis Sam, Jean Paul Kala, H\u00e9l\u00e8ne Jacubowitz, Gr\u00e9gory Ba\u00f4o, Laurence Jenkell, Sylvain Piget, Didier Engels, Saloua Sarhiri, David Kracov en vele anderen. Deze tentoonstelling biedt een boeiende verkenning van de expressieve en sensorische kracht van kleur.\n\nGe\u00efnspireerd door Pop Art en Optical Art onderzoekt Chromatic hoe kleur onze perceptie, emoties en ons begrip van vormen be\u00efnvloedt. Door middel van diverse werken, van schilderkunst tot muurschilderingen, verkennen de kunstenaars het spel van tinten, reflecties en texturen om visuele grenzen te verleggen en een meeslepende ervaring te bieden.\nChromatic bouwt voort op de historische erfenis van kleur, die al eeuwenlang wordt gebruikt als symbolische taal en transformatiemiddel. Elk kunstwerk herinterpreteert deze invloeden op een hedendaagse manier en onthult kleur als een levendig, bruisend element dat ruimte kan transformeren en de verbeelding kan vangen.\nDeze tentoonstelling nodigt het publiek uit om kleur te herontdekken als een tijdloze en innovatieve kracht, met een belofte van unieke visuele onderdompeling en een dialoog tussen artistieke traditie en moderniteit.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.instagram.com\/thevault.artgallery\/","email":"roxane.lerchs@thevaultgallery.com","phone_contact":"+32 2 245 24 78","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700003846"}},"place":{"id":50001867,"translations":{"de":{"name":"The Vault Art Gallery","address_street_name":null,"address_street_number":"205","address_street_box":null,"email":"info