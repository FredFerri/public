anor","copyright":null},"en":{"title":"Nikanor","copyright":null}}}],"dates":[{"day":"2022-08-26","doors":"19:45:00","start":"20:00:00","end":"22:00:00","is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":10},{"translations":{"fr":{"name":"Enfants"},"nl":{"name":"Kinderen"},"en":{"name":"Children"}},"value":5},{"translations":{"fr":{"name":"Article 27"},"nl":{"name":"Artikel 27"},"en":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[],"targets":{"list":[11,10,8],"translations":{"fr":["Famille","Seniors","Jeunes 15-18 ans"],"nl":["Familie","Senioren","Jongeren 15-18 j."],"en":["Family","Seniors","Youth 15-18  yr."]}},"tags":["kids"],"accessibilities":{"list":[255,261,263,265],"translations":{"fr":["Accessible","Parking accessible","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9"],"nl":["Toegankelijk","Toegankelijke parking","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet"],"en":["Accessible","Accessible parking","Accessible to pedestrians with mobility aids","Adapted toilet"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-08-02T11:05:12+02:00","published_at":"2022-08-02T10:45:56+02:00","backoffice_id":259164,"import_origin":null,"sub_type":"concert","show_in_agenda":true,"ranking":1.2599210498949},{"id":537969,"date_start":"2022-08-26","date_end":"2022-08-26","date_next":"2022-08-26","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":true,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert"}},"others":{"list":[4,6],"translations":{"fr":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"],"nl":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"],"en":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Hide & Seek Festival 2022: Nawal (Comoro Islands)","shortdescr":null,"longdescr":"Hide & Seek Festival, traditional world music in unexpected places in Brussels: https:\/\/miniurl.be\/r-45et\r\n\r\nSession 6.30pm: https:\/\/miniurl.be\/r-45gk\r\nSession 8.30pm: https:\/\/miniurl.be\/r-45gl\r\n\r\nDepuis le tout premier Hide & Seek en 2016, nous convoitions certains lieux mythiques de la capitale plus que d\u2019autres afin de les ajouter \u00e0 notre programme. La franc-ma\u00e7onnerie \u00e9tant encore peu connue du grand public, nous avions \u00e0 c\u0153ur de proposer un jour un concert dans un temple franc-ma\u00e7onnique. Et cette ann\u00e9e ce r\u00eave devient r\u00e9alit\u00e9 puisque le Grand Orient de Belgique nous ouvre les portes du temple bleu de la rue de Laeken. Le ciel \u00e9toil\u00e9 de cet endroit r\u00e9serv\u00e9 habituellement aux initi\u00e9s vous surprendra certainement, tout comme les nombreux signes \u00e0 d\u00e9coder si habituels \u00e0 la culture franc-ma\u00e7onnique.\r\n\r\nDepuis le d\u00e9but aussi, nous avons \u00e0 c\u0153ur de cr\u00e9er des liens entre lieux et musique. Tant\u00f4t \u00e9vidents, tant\u00f4t totalement incongrus, cette rencontre n\u2019est pas laiss\u00e9e au hasard. Nous avons voulu ici inviter une musicienne franco-comorienne dont nous appr\u00e9cions beaucoup le travail. Nawal est multi-instrumentiste et compose des morceaux empreints de spiritualit\u00e9 m\u00e9tisse. Sa musique est r\u00e9solument acoustique, elle chante la beaut\u00e9 de l\u2019islam, r\u00e9cite des mantras bouddhistes, et m\u00e9lange ses racines soufies et africaines \u00e0 d\u2019autres \u00e9l\u00e9ments mystiques et \u00e0 divers instruments issus des \u00eeles Comores. Aujourd\u2019hui figure marquante des \u00celes Comores, sa voix et son univers font vibrer les publics de toutes les cultures d\u2019ici et d\u2019ailleurs.\r\n\r\nTickets en vente \u00e0 partir du mardi 12 juillet \u00e0 10h30!","performers":null,"boxoffice_url":null,"website":"http:\/\/www.muziekpublique.be","email":"info@muziekpublique.be","phone_contact":null,"phone_booking":"+32 2 217 26 00","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/537969.html"},"nl":{"name":"Hide & Seek Festival 2022: Nawal (Comoro Islands)","shortdescr":null,"longdescr":"Hide & Seek Festival, traditional world music in unexpected places in Brussels: https:\/\/miniurl.be\/r-45et\r\n\r\nSession 6.30pm: https:\/\/miniurl.be\/r-45gk\r\nSession 8.30pm: https:\/\/miniurl.be\/r-45gl\r\n\r\nSinds het allereerste Hide & Seek Festival in 2016 staan enkele mythische plekken in de hoofdstad vooraan op onze verlanglijst. Omdat het erfgoed van de vrijmetselarij relatief onbekend is, wilden we ooit een concert aanbieden in een vrijmetselaarstempel. En dit jaar wordt deze droom werkelijkheid dankzij het Grootoosten van Belgi\u00eb dat de deuren van de Blauwe Tempel in de Lakensestraat opent. De sterrenhemel van de tempel, die gewoonlijk is gereserveerd voor ingewijden, zal je zeker verrassen, net als de vele tekens en symbolen die zo gebruikelijk zijn in de vrijmetselarij.\r\n\r\nOok vanaf het begin proberen we verbanden te leggen tussen plekken en muziek. Soms voor de hand liggend, soms totaal ongerijmd, wordt de ontmoeting niet aan het toeval overgelaten. Met Nawal nodigen we een Comorische klasse muzikante uit in een huis dat heel lang exclusief toegankelijk was voor mannen. Ze is een multi-instrumentaliste en componeert stukken die doordrongen zijn van metisse-spiritualiteit. Haar muziek is resoluut akoestisch en laat zich inspireren door de po\u00ebzie van de islam. Ze reciteert boeddhistische mantra\u2019s en vermengt haar soefi- en Afrikaanse roots met andere mystieke elementen en verschillende instrumenten van de Comoren. Deze prominente figuur van de Comoren-eilanden brengt met haar krachtige stem en haar unieke universum het publiek steevast in vervoering met een boodschap van verbroedering en openheid.\r\n\r\nTickets te koop vanaf dinsdag 12 juli om 10u30!","performers":null,"boxoffice_url":null,"website":"http:\/\/www.muziekpublique.be","email":"info@muziekpublique.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/537969.html"},"en":{"name":"Hide & Seek Festival 2022: Nawal (Comoro Islands)","shortdescr":null,"longdescr":"Hide & Seek Festival, traditional world music in unexpected places in Brussels: https:\/\/miniurl.be\/r-45et\r\n\r\nSession 6.30pm: https:\/\/miniurl.be\/r-45gk\r\nSession 8.30pm: https:\/\/miniurl.be\/r-45gl\r\n\r\nEver since our first Hide & Seek Festival, in 2016, we crave for certain Brussels mythical locations, in order to add them to our program. Since freemasonry remains generally unknown to the general public, we longed to be able to propose a concert in a freemason temple. This year our dream came true, for the Grand Orient of Belgium will open the doors of the Blue Temple, in the Rue de Laeken, for us. This location\u2019s starry sky, usually reserved to insiders, will certainly surprise you, as will the numerous signs that are proper to the freemason culture.\r\n\r\nAlso ever since our beginning, we strive to create links between places and music. Sometimes obvious, sometimes totally incongruous, these encounters are not left to chance. Therefore, we have chosen to invite a French-Comorian musician whose work we greatly appreciate. Nawal plays several instruments, she composes an acoustic music imprinted with mestizo spirituality. She sings the beauty of Islam, she recites Buddhist mantras, she mixes her Sufi and African roots with other mystical elements and with various Comoro Island instruments. The voice and the universe of this prominent figure of the Comoro Islands makes audiences of all cultures, the world over, vibrate.\r\n\r\nTickets on sale from Tuesday 12 July at 10.30 am!","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/537969.html"},"de":{"name":"Hide & Seek Festival 2022: Nawal (Comoro Islands)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/537969.html"},"it":{"name":"Hide & Seek Festival 2022: Nawal (Comoro Islands)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/537969.html"},"sp":{"name":"Hide & Seek Festival 2022: Nawal (Comoro Islands)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/537969.html"},"pt":{"name":"Hide & Seek Festival 2022: Nawal (Comoro Islands)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/537969.html"},"cn":{"name":"Hide & Seek Festival 2022: Nawal (Comoro Islands)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/537969.html"}},"place":{"id":259564,"translations":{"fr":{"name":"Temples ma\u00e7onniques","address_street_name":"Rue de Laeken","address_street_number":"79","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Laeken, 79","address_line2":"1000 Bruxelles","description_web":null,"description_print":nu