ns":{"fr":["Jeux et quiz"],"nl":["Spel en quiz"],"en":["Games and quiz"],"de":["Spiele & Quiz"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"1er blind test d'Arc-en-Ciel asbl","shortdescr":"Arc-en-Ciel asbl vous invite \u00e0 son premier Blind Test caritatif, au profit de l'enfance et de la jeunesse d\u00e9favoris\u00e9es.","longdescr":"Le principe est simple : deviner le titre ou l\u2019auteur du morceau diffus\u00e9. Le blind test, qui signifie \u201ctest \u00e0 l\u2019aveugle\u201d, est un super jeu pour mettre \u00e0 l\u2019\u00e9preuve sa culture musicale entre amis, coll\u00e8gues ou famille.\r\nComposez vous-m\u00eame votre \u00e9quipe de 6 \u00e0 8 joueurs, \u00e9lisez un capitaine et envoyez un mail \u00e0 info@arc-en-ciel.be pour inscrire votre \u00e9quipe. Le prix est de 60\u20ac par table. Les grands gagnants de la soir\u00e9e repartiront avec un lot surprise. Mention sp\u00e9ciale pour les tables d\u00e9guis\u00e9es autour d\u2019un th\u00e8me.","performers":"2 animatrices habitu\u00e9es des blind tests : les Disco Sisters","boxoffice_url":null,"website":"https:\/\/www.facebook.com\/events\/466820401998156\/?active_tab=about","email":"info@arc-en-ciel.be","phone_contact":null,"phone_booking":"+32 2 675 73 11","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.544317"},"nl":{"name":"1er blind test d'Arc-en-Ciel asbl","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.544317"},"en":{"name":"1er blind test d'Arc-en-Ciel asbl","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.544317"},"de":{"name":"1er blind test d'Arc-en-Ciel asbl","shortdescr":null,"longdescr":null,"pe