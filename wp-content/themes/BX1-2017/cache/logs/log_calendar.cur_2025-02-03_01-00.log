book_link":null,"import_origin":null,"is_part_of":null,"sub_type":"other","ranking":0.30285343213869,"languages":{"spoken":["fr","de","en"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[30,24],"translations":{"de":["Malerei","Kunstgalerien"],"pt":[null,null],"en":["Painting","Art Galleries"],"it":["Pittura","Gallerie d'arte"],"cn":[null,null],"fr":["Peinture","Galeries d'art"],"sp":["Pintura","Galer\u00edas de arte"],"nl":["Schilderkunst","Galeries"]}}},"translations":{"de":{"name":"Skinned Light \u2014 LAGE EGAL Brussels","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lage-egal.net","email":"sonderlage@lage-egal.net","phone_contact":"+49 1731807226","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700005876"},"pt":{"name":"Skinned Light \u2014 LAGE EGAL Brussels","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lage-egal.net","email":"sonderlage@lage-egal.net","phone_contact":"+49 1731807226","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700005876"},"en":{"name":"Skinned Light \u2014 LAGE EGAL Brussels","shortdescr":"We are excited to unveil our new temporary exhibition space in Brussels with this duo show. Both challenge conventional forms of sculpture and wall installations, engaging in the transformation of materials. Through this dialogue, SKINNED LIGHT invites visitors to reflect on proximity, discovery, and the shared tensions between the artworks, creating a rich encounter between visual worlds.","longdescr":"We are excited to unveil our new temporary exhibition space in Brussels with a duo show featuring two remarkable artists: ULRIKE BUHL from Germany and FRANCK MILTGEN from Luxembourg. Both challenge conventional forms of sculpture and wall installations, engaging in the transformation of materials. Through this dialogue, SKINNED LIGHT invites visitors to reflect on proximity, discovery, and the shared tensions between the artworks, creating a rich encounter between visual worlds.\n\nThis first exhibition, titled SKINNED LIGHT, wants to explore the intersection of the tactile and ephemeral, peeling back layers to reveal light in its raw, vulnerable form. It symbolizes both the fragility and intensity of illumination and the process of artistic deconstruction and reconstruction.\n\nUlrike Buhl\u2019s innovative sculptures and installations blur the line between the natural and artificial, with organic, biomorphic forms evoking microorganisms or viral structures. Her works explore growth, decay, and the dynamic cycle of creation and destruction.\n\nFranck Miltgen\u2019s practice delves into materiality, layering vintage textiles, graffiti-like markings, and industrial materials. His art reveals hidden narratives, playing with notions of facade and perception, encouraging viewers to question what is concealed versus what is exposed.\n\n\u25b6\ufe0e LAGE EGAL GOES TO BRUSSELS\n\nLAGE EGAL CURATORIAL PROJECTS, founded by French artist and curator Pierre Granoux, established its current form in 2019 after several years of activity. Based in Berlin, the platform explores experimental exhibition formats in ever-changing spaces. As an independent art initiative, LAGE EGAL (\uff1d location no matter) goes beyond the traditional gallery model by fostering collaborative and innovative curatorial practices. It works with a diverse network of artists, curators, collectors, galleries, museums, and corporate art collections, creating opportunities for artistic experimentation and dynamic cultural exchange. Its name, a playful anagram, reflects the platform\u2019s evolving, nomadic approach.\n\nAfter a two-month residency at the Rivoli building in Brussels, we are excited to announce the opening of a new space at Rue Saint-Georges 5 in January 2025, continuing our commitment to innovative curatorial practices. Opening in Brussels was a natural progression, as both Brussels and Berlin are key international hubs with vibrant cultural scenes, offering proximity to major European cities and a thriving art community.","performers":"Ulrike Buhl (Berlin), Franck Miltgen (Luxembourg)","boxoffice_url":null,"website":"https:\/\/www.lage-egal.net","email":"sonderlage@lage-egal.net","phone_contact":"+49 1731807226","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700005876"},"it":{"name":"Skinned Light \u2014 LAGE EGAL Brussels","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lage-egal.net","email":"sonderlage@lage-egal.net","phone_contact":"+49 1731807226","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700005876"},"cn":{"name":"Skinned Light \u2014 LAGE EGAL Brussels","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lage-egal.net","email":"sonderlage@lage-egal.net","phone_contact":"+49 1731807226","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700005876"},"fr":{"name":"Skinned Light \u2014 LAGE EGAL Brussels","shortdescr":"Nous sommes ravis de pr\u00e9senter cette premi\u00e8re exposition dans notre nouvel espace temporaire \u00e0 Bruxelles, avec les artistes ULRIKE BUHL (Berlin) et FRANCK MILTGEN (Luxembourg). Leur travail explore les fronti\u00e8res entre le tactile et l\u2019\u00e9ph\u00e9m\u00e8re, d\u00e9voile la lumi\u00e8re dans sa forme brute et vuln\u00e9rable et rend visible les processus de d\u00e9construction et de reconstruction artistique.","longdescr":"SKINNED LIGHT \u2014 ULRIKE BUHL, FRANCK MILTGEN\nNous sommes ravis de pr\u00e9senter SKINNED LIGHT, premi\u00e8re exposition dans notre nouvel espace temporaire \u00e0 Bruxelles, avec les artistes ULRIKE BUHL (Berlin, Allemagne) et FRANCK MILTGEN (Luxembourg, Luxembourg). Leur travail explore les fronti\u00e8res entre le tactile et l\u2019\u00e9ph\u00e9m\u00e8re, d\u00e9voile la lumi\u00e8re dans sa forme brute et vuln\u00e9rable et rend visible les processus de d\u00e9construction et de reconstruction artistique.\n\nLes sculptures d'Ulrike Buhl m\u00ealent le naturel et l'artificiel, avec des formes organiques et biomorphiques. Ses \u0153uvres explorent la croissance, la d\u00e9composition et le cycle dynamique de la cr\u00e9ation et de la destruction.\n\nFranck Miltgen s'int\u00e9resse \u00e0 la mat\u00e9rialit\u00e9 en superposant peintures, graffitis et des mat\u00e9riaux industriels. Son travail r\u00e9v\u00e8le des r\u00e9cits cach\u00e9s, jouant avec les notions de fa\u00e7ade et de perception, ce qui est cach\u00e9 par rapport \u00e0 ce qui est expos\u00e9.\n\nLAGE EGAL GOES TO BRUSSELS \u25b6\ufe0e \n\nCr\u00e9\u00e9 par Pierre Granoux, LAGE EGAL est une galerie bas\u00e9e \u00e0 Berlin qui explore des formats d\u2019exposition exp\u00e9rimentaux et collaboratifs. Apr\u00e8s une r\u00e9sidence de deux mois au RIVOLI \u00e0 Bruxelles, nous ouvrons un nouvel espace pour un court semestre d\u00e9but 2025, au 5, Rue Saint-Georges \u00e0 Ixelles. Ce projet s\u2019inscrit dans notre approche nomade et innovante, connectant les sc\u00e8nes artistiques dynamiques de Bruxelles et Berlin.","performers":"Ulrike Buhl (Berlin), Franck Miltgen (Luxembourg)","boxoffice_url":null,"website":"https:\/\/www.lage-egal.net","email":"sonderlage@lage-egal.net","phone_contact":"+49 1731807226","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700005876"},"sp":{"name":"Skinned Light \u2014 LAGE EGAL Brussels","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lage-egal.net","email":"sonderlage@lage-egal.net","phone_contact":"+49 1731807226","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700005876"},"nl":{"name":"Skinned Light \u2014 LAGE EGAL Brussels","shortdescr":"We zijn verheugd om met deze duotentoonstelling onze nieuwe tijdelijke tentoonstellingsruimte in Brussel te onthullen. Beiden dagen conventionele vormen van beeldhouwkunst en muurinstallaties uit, waarbij ze zich bezighouden met de transformatie van materialen. ","longdescr":"We zijn verheugd om onze nieuwe tijdelijke tentoonstellingsruimte in Brussel te onthullen met een duotentoonstelling met twee opmerkelijke kunstenaars: ULRIKE BUHL uit Duitsland en FRANCK MILTGEN uit Luxemburg. Beiden dagen conventionele vormen van beeldhouwkunst en muurinstallaties uit en houden zich bezig met de transformatie van materialen. Door deze dialoog nodigt SKINNED LIGHT bezoekers uit om na te denken over nabijheid, ontdekking en de gedeelde spanningen tussen de kunstwerken, waardoor een rijke ontmoeting tussen visuele werelden ontstaat.\n\nDeze eerste tentoonstelling, getiteld SKINNED LIGHT, wil het raakvlak verkennen tussen het tactiele en het vergankelijke, waarbij lagen worden afgepeld om licht in zijn ruwe, kwetsbare vorm te onthullen. Het symboliseert zowel de kwetsbaarheid en intensiteit van verlichting als het proces van artistieke deconstructie en reconstructie.\n\nDe innovatieve sculpturen en installaties van Ulrike Buhl vervagen de grens tussen het natuurlijke en het kunstmatige, met organische, biomorfe vormen die doen denken aan micro-organismen of virale structuren. Haar werken verkennen groei, verval en de dynamische cyclus van creatie en vernietiging.\n\nFranck Miltgen verdiept zich in materialiteit door vintage textiel, graffiti-achtige markeringen en industri\u00eble materialen op elkaar te stapelen. Zijn kunst onthult verborgen verhalen, speelt met begrippen als fa\u00e7ade en perceptie en moedigt toeschouwers aan om zich af te vragen wat verborgen is versus wat zichtbaar is.\n\n\u25b6\ufe0e LAGE EGAL GAAT NAAR BRUSSEL\n\nLAGE EGAL CURATORIAL PROJECTS, opgericht door de Franse kunstenaar en curator Pierre Granoux, vestigde zijn huidige vorm in 2019 na enkele jaren van activiteit. Het platform is gevestigd in Berlijn en onderzoekt experimentele tentoonstellingsvormen in steeds wisselende ruimtes. Als onafhankelijk kunstinitiatief gaat LAGE EGAL (\uff1d location no matter) verder dan het traditionele galeriemodel door samenwerkende en innovatieve curatorpraktijken te stimuleren. Het werkt samen met een divers netwerk van kunstenaars, curatoren, verzamelaars, galeries, musea en bedrijfscollecties en cre\u00ebert zo mogelijkheden voor artistieke experimenten en dynamische culturele uitwisseling. De naam, een speels anagram, weerspiegelt de evoluerende, nomadische aanpak van het platform.\n\nNa een residentie van twee maanden in het Rivoli gebouw in Brussel, zijn we verheugd om de opening van een nieuwe ruimte aan te kondigen in de Rue Saint-Georges 5 in januari 2025, waar we ons blijven inzetten voor innovatieve curatori\u00eble praktijken. De opening in Brussel was een natuurlijke progressie, aangezien zowel Brussel als Berlijn belangrijke internationale knooppunten zijn met een levendige culturele sc\u00e8ne, die de nabijheid van grote Europese steden en een bloeiende kunstgemeenschap bieden.","performers":"Ulrike Buhl (Berlin), Franck Miltgen (Luxembourg)","boxoffice_url":null,"website":"https:\/\/www.lage-egal.net","email":"sonderlage@lage-egal.net","phone_contact":"+49 1731807226","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700005876"}},"place":{"id":50002835,"translations":{"de":{"name":"LAGE EGAL Curatorial Projects","address_street_name":"Rue Saint-Georges","address_street_number":"5","address_street_box":null,"email":"sonderlage@lage-egal.net","website":"www.lage-egal.net","phone_contact":"+491731807226","phone_booking":null,"address_zip":"1050","address_city