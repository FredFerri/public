ate_next":"2022-08-12","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre"}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"L'\u00e9t\u00e9 spectaculaire - Persilette","shortdescr":"\"Objets perdus, humanit\u00e9 retrouv\u00e9e, voil\u00e0 l\u2019antagonisme qui me titille \u00e0 ce jour.\"","longdescr":"A l\u2019heure du d\u00e9tachement affectif cr\u00e9\u00e9 par la multitude des \u00e9crans-interlocuteurs propos\u00e9s par le train soci\u00e9tal, le projet du Collectif H2Oz m\u2019interpelle.\r\n\r\nMr Taupe, le pr\u00e9pos\u00e9 au tri des objets perdus-trouv\u00e9s, les respecte et les soigne comme on devrait le faire avec tout \u00eatre humain. Madame Chat, sa coll\u00e8gue, n\u2019est jamais plus heureuse que quand un propri\u00e9taire retrouve son objet.\r\n\r\nPar le biais de ce duo, nous pourrons mettre en lumi\u00e8re le plaisir des joies partag\u00e9es mais aussi, comment quelqu\u2019un qui ne s\u2019occupe que de biens mat\u00e9riels va petit \u00e0 petit transf\u00e9rer ses attentions pr\u00e9cieuses vers les humains. \u2013 Val\u00e9rie Joyeux","performers":"Du Th\u00e9\u00e2tre OZ\r\nAvec No\u00e9 Trillet, Scarlett Schmitz\r\nSc\u00e9nographie No\u00eblle Deckmyn\r\nMise en sc\u00e8ne Val\u00e9rie Joyeux\r\nAide \u00e0 l\u2019\u00e9criture Noemi Tiberghien, Christian Dalimier\r\nRegard ext\u00e9rieur Collectif H2Oz\r\nConstruction Olivier Waterkeyn\r\nCr\u00e9ation sonore Pablo Heuson\r\nR\u00e9gie Arnault Lhoute","boxoffice_url":null,"website":"http:\/\/www.roseraie.org","email":"communication@roseraie.o