ress_book":false,"is_in_vb_export":false,"resto_ranking":0},"media":[{"type":"poster","link":"https:\/\/agendabrussels.imgix.net\/330d49b65c4006d1ac1dd2b5eb1e42b84603ff76.jpg","width":2160,"height":1080,"ratio":2,"translations":{"fr":{"title":"3rd Brussels Cello Festival : Closing Concert | Cellobration!","copyright":null},"nl":{"title":"3rd Brussels Cello Festival : Closing Concert | Cellobration!","copyright":null},"en":{"title":"3rd Brussels Cello Festival : Closing Concert | Cellobration!","copyright":null}}}],"dates":[{"day":"2022-10-16","doors":null,"start":"16:00:00","end":"18:00:00","is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":21},{"translations":{"fr":{"name":"Etudiants"},"nl":{"name":"Studenten"},"en":{"name":"Students"}},"value":9},{"translations":{"fr":{"name":"Seniors"},"nl":{"name":"Senioren"},"en":{"name":"Seniors"}},"value":18},{"translations":{"fr":{"name":"Article 27"},"nl":{"name":"Artikel 27"},"en":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-11T06:35:03+02:00","published_at":"2022-08-11T14:18:44+02:00","backoffice_id":259555,"import_origin":null,"sub_type":"concert","show_in_agenda":true,"ranking":1.2599210498949},{"id":543710,"date_start":"2022-10-16","date_end":"2022-10-16","date_next":"2022-10-16","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen"}},"others":{"list":[109],"translations":{"fr":["Espaces verts"],"nl":["Groene zones"],"en":["Green spaces"],"de":["Gr\u00fcnfl\u00e4chen"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"La For\u00eat de nos anc\u00eatres en cal\u00e8che pour personnes \u00e0 mobilit\u00e9 r\u00e9duite - Journ\u00e9e de la For\u00eat de Soignes.","shortdescr":"Lors de cettebalade en cal\u00e8che,sp\u00e9cialement adapt\u00e9e pour accueillir les personnes \u00e0 mobilit\u00e9 r\u00e9duite, vous d\u00e9couvrirez la For\u00eat de Soignes.","longdescr":"Lors de cette balade en cal\u00e8che,sp\u00e9cialement adapt\u00e9e pour accueillir les personnes \u00e0 mobilit\u00e9 r\u00e9duite, vous partirez sur les traces des premiers habitants de notre r\u00e9gion, qui v\u00e9curent ici \u00e0 la pr\u00e9histoire, il y a environ 6.000 ans. Ces agriculteurs du n\u00e9olithique ont install\u00e9 un vaste camp fortifi\u00e9 sur une colline dominant les Etangs de Boitsfort et des Enfants Noy\u00e9s. Sur ce site de la R\u00e9serve arch\u00e9ologique, vous d\u00e9couvrirez les vestiges de ce camp, ainsi que les deux tumuli tout proches. Votre guide animateur, vous racontera, outils pr\u00e9historiques \u00e0 la main, comment nos anc\u00eatres ont r\u00e9volutionn\u00e9 l\u2019humanit\u00e9 avec des inventions comme l\u2019agriculture, l\u2019\u00e9levage, l\u2019arc, la poterie, les premiers villages\u2026 et comparera la for\u00eat d\u2019antan avec celle que nous avons sous les yeux.\nVisite guid\u00e9e gratuite organis\u00e9e dans le cadre de la journ\u00e9e de la For\u00eat de Soignes. Places limit\u00e9s !\nIl est possible d'accueillir3 personnes en chaise roulanteavec les accompagnateurs.Merci de nous pr\u00e9venirsi c'est votre cas.\nBalade organis\u00e9e en collaboration avec Hyppy et CAP Patrimoine dans le cadre du programme \u00ab Tourisme vert pour tous \u00bb, avec le soutien de visit.brussels.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.bruxellesbavard.be","email":"info@bruxellesbavard.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.543710"},"nl":{"name":"La For\u00eat de nos anc\u00eatres en cal\u00e8che pour personnes \u00e0 mobilit\u00e9 r\u00e9duite - Journ\u00e9e de la For\u00eat de Soignes.","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.brusselbabbelt.be","email":"info@brusselbabbelt.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.543710"},"en":{"name":"La For\u00eat de nos anc\u00eatres en cal\u00e8che pour personnes \u00e0 mobilit\u00e9 r\u00e9duite - Journ\u00e9e de la For\u00eat de Soignes.","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.brusselschatterguides.be","email":"info@brusselschatterguides.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.543710"},"de":{"name":"La For\u00eat de nos anc\u00eatres en cal\u00e8che pour personnes \u00e0 mobilit\u00e9 r\u00e9duite - Journ\u00e9e de la For\u00eat de Soignes.","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.543710"},"it":{"name":"La For\u00eat de nos anc\u00eatres en cal\u00e8che pour personnes \u00e0 mobilit\u00e9 r\u00e9duite - Journ\u00e9e de la For\u00eat de Soignes.","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.543710"},"sp":{"name":"La For\u00eat de nos anc\u00eatres en cal\u00e8che pour personnes \u00e0 mobilit\u00e9 r\u00e9duite - Journ\u00e9e de la For\u00eat de Soignes.","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.543710"},"pt":{"name":"La For\u00eat de nos anc\u00eatres en cal\u00e8che pour personnes \u00e0 mobilit\u00e9 r\u00e9duite - Journ\u00e9e de la For\u00eat de Soignes.","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.543710"},"cn":{"name":"La For\u00eat de nos anc\u00eatres en cal\u00e8che pour personnes \u00e0 mobilit\u00e9 r\u00e9duite - Journ\u00e9e de la For\u00eat de Soignes.","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.543710"}},"place":{"id":266533,"translations":{"fr":{"name":"DROHME Park","address_street_name":"Chauss\u00e9e de La Hulpe","address_street_number":"53 a 55","address_street_box":null,"email":null,"website":"http:\/\/www.drohme.be","phone_contact":null,"phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Chauss\u00e9e de La Hulpe, 53 a 55","address_line2":"1180 Uccle","description_web":"Site embl\u00e9matique de 32 hectares, vert et arbor\u00e9 \u00e0 l\u2019or\u00e9e de la For\u00eat de Soignes, DROHME Park, initie une toute nouvelle g\u00e9n\u00e9ration de parc de loisirs actifs. Ce concept unique et pr\u00e9curseur, centr\u00e9 sur la nature propose plusieurs activit\u00e9s \u00e0 caract\u00e8re pluri-g\u00e9n\u00e9rationnel via 5 types d\u2019activit\u00e9s : nature, sport, culture, \u00e9ducation et d\u00e9tente. DROHME s\u2019ins\u00e8re tout naturellement dans l\u2019objectif de \u00ab Bruxelles, Ville durable \u00bb et en sera un acteur majeur.\r\n\r\nAutrefois lieu incontournable de la vie sportive et mondaine, lieu de rencontres, de d\u00e9tente et d\u2019activit\u00e9s \u00e9questres pour les Bruxellois, il entame en 1995 une p\u00e9riode de quasi-abandon et de d\u00e9gradation, perdant son prestige et toutes ses fonctions originelles.\r\n\r\nLe projet DROHME Park propose de lui rendre son attractivit\u00e9 d\u2019antan, sa fonction de porte d\u2019entr\u00e9e de la For\u00eat de Soignes, d\u2019espace de loisirs et de sport pour le grand public, de d\u00e9couverte de la nature et du patrimoine, tout en pr\u00e9servant son identit\u00e9 si particuli\u00e8re et insolite.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"DROHME Park","address_street_name":"Terhulpensesteenweg","address_street_number":"53 a 55","address_street_box":null,"email":null,"website":"http:\/\/www.drohme.be","phone_contact":null,"phone_booking":null,"address_zip":"1180","address_city":"Ukkel","address_line1":"Terhulpensesteenweg, 53 a 55","address_line2":"1180 Ukkel","description_web":"DROHME Park ontvouwt zich op een groen en bosrijk gebied van 32 hectare aan de rand van het Zoni\u00ebnwoud en is een nieuw soort domein voor actieve recreatie. Zijn uniek en baanbrekend natuurgebonden concept biedt verschillende activiteiten voor alle leeftijden aan met 5 verschillende thema\u2019s: natuur, sport, cultuur, educatie en ontspanning. DROHME sluit naadloos aan bij de doelstellingen van \u2018Brussel, duurzame stad\u2019 en zal er \u00e9\u00e9n van de belangrijkste spelers van zijn.\r\n\r\nDe hippodroom was lange tijd een epicentrum voor sport en ontmoetingen, een plek waar Brusselaars kwamen ontspannen of aan paardenactiviteiten deelnemen. Vanaf 1995 begon echter het verval, toen de site zo goed als verlaten werd en zo stilaan zijn prestige en al zijn oorspronkelijke functies verloor.\r\n\r\nHet project DROHME Park wil de hippodroom in zijn vroegere glorie herstellen: als toegangspoort tot het Zoni\u00ebnwoud, als sport- en ontspanningsruimte voor het grote publiek en als locatie voor ontdekking van milieu en erfgoed, zonder echter aan zijn bijzondere identiteit te raken.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"DROHME Park","address_street_name":"Chauss\u00e9e de La Hulpe","address_street_number":"53 a 55","address_street_box":null,"email":null,"website":"http:\/\/www.drohme.be","phone_contact":null,"phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Chauss\u00e9e de La Hulpe, 53 a 55","address_line2":"1180 Uccle","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"DROH!ME Melting Park","address_street_name":"Chauss\u00e9e de La Hulpe","address_street_number":"53 a 55","address_street_box":null,"email":null,"website":"http:\/\/www.drohme.be","phone_contact":null,"phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Chauss\u00e9e de La Hulpe, 53 a 55","address_line2":"1180 Uccle","description_web":"Der DROHME Park auf dem ehemaligen, 32 Hektar gro\u00dfen Gel\u00e4nde der Pferderennbahn am Rande des Br\u00fcsseler Stadtwaldes For\u00eat de Soignes, pr\u00e4sentiert sich als Vorl\u00e4ufer einen neuen Freizeitpark-Generation. Das innovative Konzept, bei dem die Natur im Mittelpunkt steht, bietet eine ganze Reihe generationen\u00fcbergreifender Aktivit\u00e4ten rund um 5 Themen: Natur, Sport, Kultur, Bildung und Entspannung. DROHME f\u00fcgt sich nahtlos in die ausgegebene Devise \u201eBr\u00fcssel, nachhaltige Stadt\u201c ein und wird in diesem Zusammenhang eine wichtige Rolle spielen.\r\n\r\nDas Gel\u00e4nde der Pferderennbahn, das einst die Br\u00fcsseler Hochburg des mond\u00e4nen Pferderennsports, Ort der Begegnung und der Kurzweil war, fiel ab 1995 in eine Art Dornr\u00f6schenschlaf. Und mit dem \u00e4u\u00dferlichen Verfall verlor der Ort auch sein Prestige, seine Anziehungskraft und seine urspr\u00fcngliche Funktion.\r\n\r\nDas Projekt DROHME Park hat es sich zum Ziel gesetzt, dem Ort seine urspr\u00fcngliche Attraktivit\u00e4t zur\u00fcckzuverleihen \u2013 als Naherholungsgebiet, Sport- und Freizeitst\u00e4tte f\u00fcr Jung und Alt im Zeichen von Natur und Kulturerbe bei gleichzeitiger Bewahrung der Identit\u00e4t des Ortes.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"DROH!ME Melting Park","address_street_name":"Chauss\u00e9e de La Hulpe","address_street_number":"53 a 55","address_street_box":null,"email":null,"website":"http:\/\/www.drohme.be","phone_contact":null,"phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Chauss\u00e9e de La Hulpe, 53 a 55","address_line2":"1180 Uccle","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"DROH!ME Melting Park","address_street_name":"Chauss\u00e9e de La Hulpe","address_street_number":"53 a 55","address_street_box":null,"email":null,"website":"http:\/\/www.drohme.be","phone_contact":null,"phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Chauss\u00e9e de La Hulpe, 53 a 55","address_line2":"1180 Uccle","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"DROHME Melting Park","address_street_name":"Chauss\u00e9e de La Hulpe","address_street_number":"53 a 55","address_street_box":null,"email":null,"website":"http:\/\/www.drohme.be","phone_contact":null,"phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Chauss\u00e9e de La Hulpe, 53 a 55","address_line2":"1180 Uccle","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"DROHME Melting Park","address_street_name":"Chauss\u00e9e de La Hulpe","address_street_number":"53 a 55","address_street_box":null,"email":null,"website":"http:\/\/www.drohme.be","phone_contact":null,"p