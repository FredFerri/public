0","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":292950,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"misc","ranking":0.2462115368990136,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":84,"translations":{"de":"Verschiedenes","pt":null,"en":"Various","it":"Varie","cn":null,"fr":"Divers","sp":"Varios","nl":"Varia"}},"others":{"list":[88],"translations":{"de":["Spiele & Quiz"],"pt":[null],"en":["Games and quiz"],"it":["Giochi e quiz"],"cn":[null],"fr":["Jeux et quiz"],"sp":["Juegos y concursos"],"nl":["Spel en quiz"]}}},"translations":{"de":{"name":"Jeux de soci\u00e9t\u00e9","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.tricoterie.be\/fr\/agenda\/l-agenda-culturel\/jeux-de-societe-2613?id_evenement=5936","email":"reservations@tricoterie.be","phone_contact":"+32 2 537 96 69","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50006413"},"pt":{"name":"Jeux de soci\u00e9t\u00e9","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.tricoterie.be\/fr\/agenda\/l-agenda-culturel\/jeux-de-societe-2613?id_evenement=5936","email":"reservations@tricoterie.be","phone_contact":"+32 2 537 96 69","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50006413"},"en":{"name":"Jeux de soci\u00e9t\u00e9","shortdescr":"Le jeu de soci\u00e9t\u00e9 n\u2019a jamais \u00e9t\u00e9 aussi en vogue que depuis ce cher COVID ! Le public a repris go\u00fbt \u00e0 s\u2019asseoir \u00e0 deux, en famille ou entre ami\u00b7es autour d\u2019un bon jeu.\n","longdescr":"Le jeu de soci\u00e9t\u00e9 n\u2019a jamais \u00e9t\u00e9 aussi en vogue que depuis ce cher COVID ! Le public a repris go\u00fbt \u00e0 s\u2019asseoir \u00e0 deux, en famille ou entre ami\u00b7es autour d\u2019un bon jeu.\n\nLa Tricoterie avait d\u00e9j\u00e0 d\u00e9velopp\u00e9 la mise \u00e0 disposition de jeux depuis quelques ann\u00e9es. Chaque lundi, nos animateur\u00b7rices passionn\u00e9\u00b7es de jeux se font un plaisir de vous conseiller, de vous expliquer les r\u00e8gles, voire m\u00eame de jouer avec vous si l\u2019occasion se pr\u00e9sente.\n\nAlors venez booster votre cr\u00e9ativit\u00e9 avec un Dixit, remuer vos m\u00e9ninges avec un Quarto, vous d\u00e9fier dans un 7 Wonders Duel, vous disputer des diamants avec un Splendor, ou encore stimuler votre esprit d\u2019\u00e9quipe avec un Captain Sonar !\n\nBref, n\u2019h\u00e9sitez pas \u00e0 venir retrouver nos jeux de soci\u00e9t\u00e9 et \u00e0 passer un moment ludique dans le Foyer de la Tricoterie !\n","performers":null,"boxoffice_url":null,"website":"https:\/\/www.tricoterie.be\/fr\/agenda\/l-agenda-culturel\/jeux-de-societe-2613?id_evenement=5936","email":"reservations@tricoterie.be","phone_contact":"+32 2 537 96 69","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50006413"},"it":{"name":"Jeux de soci\u00e9t\u00e9","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.tricoterie.be\/fr\/agenda\/l-agenda-culturel\/jeux-de-societe-2613?id_evenement=5936","email":"reservations@tricoterie.be","phone_contact":"+32 2 537 96 69","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50006413"},"cn":{"name":"Jeux de soci\u00e9t\u00e9","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.tricoterie.be\/fr\/agenda\/l-agenda-culturel\/jeux-de-societe-2613?id_evenement=5936","email":"reservations@tricoterie.be","phone_contact":"+32 2 537 96 69","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50006413"},"fr":{"name":"Jeux de soci\u00e9t\u00e9","shortdescr":null,"longdescr":null,"p