gets":{"list":[],"translations":{}},"tags":[],"accessibilities":{"list":[252],"translations":{"fr":["Accessible aux personnes ayant des difficult\u00e9s de compr\u00e9hension"],"nl":["Toegankelijk voor mensen met een verstandelijke beperking"],"en":["Accessible to people with intellectual disabilities"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-06-10T01:37:10+02:00","published_at":"2022-02-08T18:47:47+01:00","backoffice_id":247085,"import_origin":null,"sub_type":"sport","show_in_agenda":true,"ranking":0.19590677393903},{"id":535761,"date_start":"2022-06-16","date_end":"2022-06-16","date_next":"2022-06-16","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{"list":[112],"translations":{"fr":["Insolite"],"nl":["Ongewoon"],"en":["Unusual"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Balade fe\u0301ministes a\u0300 ve\u0301lo sur les statues","shortdescr":"Venez de\u0301couvrir les statues de femmes dans l'espace public bruxellois comme vous ne les avez jamais vues!","longdescr":"La collective Noms Peut-\u00eatre inaugure encore une fois une nouvelle balade f\u00e9ministe \u00e0 Bruxelles que nous vous proposons gratuitement !\r\nC'est \u00e0 v\u00e9lo que nous vous amenons d\u00e9couvrir des statues de Bruxelles pour mieux d\u00e9voiler les st\u00e9r\u00e9otypes sexistes et les diff\u00e9rences de traitement femmes*\/hommes qui peuplent les repr\u00e9sentations.\r\nAu fur et \u00e0 mesure de la balade, les statues deviennent autant d\u2019occasions d\u2019aborder des th\u00e8mes comme : le r\u00f4le des femmes dans la R\u00e9volution belge de 1830 ou la 1\u00e8re guerre mondiale, la repr\u00e9sentation de la nudit\u00e9 f\u00e9minine dans l\u2019art et le male gaze, la culture du viol dans la mythologie antique, etc\u2026\r\nLors de cette balade \u00e0 v\u00e9lo nous roulerons \u00e0 une vitesse mod\u00e9r\u00e9e et nous nous adapterons au rythme des participant\u00b7es.\r\nRejoignez nous avec votre v\u00e9lo vous approprier diff\u00e9remment la ville et les histoires qu\u2019elle contient !\r\nRendez-vous le jeudi 16 Juin \u00e0 16h. Le parcours durera environ 2h","performers":"Collective Noms Peut-e\u0302tre","boxoffice_url":null,"website":"https:\/\/fb.me\/e\/2Mwe07oxJ","email":"nomspeutetre@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/535761.html"},"nl":{"name":"Balade fe\u0301ministes a\u0300 ve\u0301lo sur les statues","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/535761.html"},"en":{"name":"Balade fe\u0301ministes a\u0300 ve\u0301lo sur les statues","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/535761.html"},"de":{"name":"Balade fe\u0301ministes a\u0300 ve\u0301lo sur les statues","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/535761.html"},"it":{"name":"Balade fe\u0301ministes a\u0300 ve\u0301lo sur les statues","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/535761.html"},"sp":{"name":"Balade fe\u0301ministes a\u0300 ve\u0301lo sur 