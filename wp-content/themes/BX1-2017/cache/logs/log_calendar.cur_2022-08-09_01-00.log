postmoderne abritant les diverses biblioth\u00e8ques des Sciences humaines en 1992-1993 et le b\u00e2timent R42 inaugur\u00e9 en 2010 qui ont contribu\u00e9 fortement \u00e0 la m\u00e9tamorphose du campus. Le R42 \u00e9tait destin\u00e9 \u00e0 accueillir la \u00ab Solvay Brussels School \u00bb. De nombreuses salles de s\u00e9minaires et certains auditoires ont \u00e9galement \u00e9t\u00e9 am\u00e9nag\u00e9s afin de palier au manque de place sur le campus. Toutes les facult\u00e9s y organisent dans les faits certains cours. Enfin, le grand hall moderne accueille de nombreux drinks. L'architecte et notre guide Arkadia vous feront d\u00e9couvrir les coulisses des ces 2 beaux projets.\nAvec le soutien de la F\u00e9d\u00e9ration Wallonie-Bruxelles, cellule.archi.","performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be","email":"info@arkadia.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/538873.html"},"nl":{"name":"Architecture contemporaine \u00e0 l'ULB \/ Visite avec expert","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/538873.html"},"en":{"name":"Architecture contemporaine \u00e0 l'ULB \/ Visite avec expert","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/538873.html"},"de":{"name":"Architecture contemporaine \u00e0 l'ULB \/ Visite avec expert","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/538873.html"},"it":{"name":"Architecture contemporaine \u00e0 l'ULB \/ Visite avec expert","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_ur