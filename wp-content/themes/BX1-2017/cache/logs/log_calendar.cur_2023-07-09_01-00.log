rte de cet esprit bruxellois que le monde entier nous envie.\r\n\r\nRendez-vous \u00e0 l'entr\u00e9e du parc du Petit Sablon\r\n(c\u00f4t\u00e9 \u00e9glise de Notre-Dame du Sablon).\r\nR\u00e9servation obligatoire. \r\nP.A.F. : 10\u20ac\r\n\r\n\u00a9 Emmanuel Codden","performers":"Une balade avec Philippe Baudot, conteur bruxellois qui r\u00e9enchante l'univers de la capitale, sans nostalgie ni folklorisme.","boxoffice_url":null,"website":"https:\/\/www.maisoncfc.be\/fr\/agenda\/1318-petites-balades-bruxelloises-23","email":"info@maisoncfc.be","phone_contact":"+32 2 227 34 03","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.557029"},"nl":{"name":"Petites balades bruxelloises - 2\/3 | Bruxelles, entre zwanze et myst\u00e8res","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.maisoncfc.be\/fr\/agenda\/1318-petites-balades-bruxelloises-23","email":"info@maisoncfc.be","phone_contact":"+32 2 227 34 03","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.557029"},"en":{"name":"Petites balades bruxelloises - 2\/3 | Bruxelles, entre zwanze et myst\u00e8res","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.maisoncfc.be\/fr\/agenda\/1318-petites-balades-bruxelloises-23","email":"info@maisoncfc.be","phone_contact":"+32 2 227 34 03","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.557029"},"de":{"name":"Petites balades bruxelloises - 2\/3 | Bruxelles, entre zwanze et myst\u00e8res","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.maisoncfc.be\/fr\/agenda\/1318-petites-balades-bruxelloises-23","email":"info@maisoncfc.be","phone_contact":"+32 2 227 34 03","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.557029"},"it":{"name":"Petites balades bruxelloises - 2\/3 | Bruxelles, entre zwanze et myst\u00e8res","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.maisoncfc.be\/fr\/agenda\/1318-petites-balades-bruxelloises-23","email":"info@maisoncfc.be","phone_contact":"+32 2 227 34 03","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.557029"},"sp":{"name":"Petites balades bruxelloises - 2\/3 | Bruxelles, entre zwanze et myst\u00e8res","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.maisoncfc.be\/fr\/agenda\/1318-petites-balades-bruxelloises-23","email":"info@maisoncfc.be","phone_contact":"+32 2 227 34 03","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.557029"},"pt":{"name":"Petites balades bruxelloises - 2\/3 | Bruxelles, entre zwanze et myst\u00e8res","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.maisoncfc.be\/fr\/agenda\/1318-petites-balades-bruxelloises-23","email":"info@maisoncfc.be","phone_contact":"+32 2 227 34 03","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.557029"},"cn":{"name":"Petites balades bruxelloises - 2\/3 | Bruxelles, entre zwanze et myst\u00e8res","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.maisoncfc.be\/fr\/agenda\/1318-petites-balades-bruxelloises-23","email":"info@maisoncfc.be","phone_contact":"+32 2 227 34 03","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.557029"}},"place":{"id":260227,"translations":{"fr":{"name":"Square du Petit Sablon","address_street_name":"Place du Petit Sablon","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place du Petit Sablon","address_line2":"1000 Bruxelles","description_web":"De style n\u00e9o-renaissance flamande, le jardin fleuri du square du Petit Sablon est un bijou architectural situ\u00e9 juste en face de l\u2019\u00e9glise Notre-Dame-au-Sablon. Dans ce mus\u00e9e en plein air, les diff\u00e9rentes corporations bruxelloises sont personnifi\u00e9es par 48 statues et dix autres repr\u00e9sentent les grands humanistes du XVIe si\u00e8cle\u00a0: Mercator, Ort\u00e9lius... La flore cache d\u2019autres symboles\u00a0: neuf massifs de buis taill\u00e9s repr\u00e9sentant les neuf provinces belges de cette \u00e9poque ainsi qu\u2019une couronne \u00e9voquant le royaume.\r\n\r\nAu fond du jardin est \u00e9rig\u00e9e une statue-fontaine en hommage aux comtes d\u2019Egmont et de Hornes, r\u00e9sistants d\u00e9capit\u00e9s au XVIe si\u00e8cle pendant la tyrannie espagnole. Pour finir, deux vol\u00e9es d\u2019escaliers aboutissent dans la rue aux Laines qui vous m\u00e8ne au Parc d\u2019Egmont.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Kleine Zavelsquare","address_street_name":"Place du Petit Sablon","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Place du Petit Sablon","address_line2":"1000 Brussel","description_web":"De Kleine Zavelsquare is een architecturaal juweeltje in Vlaamse neorenaissancestijl. Het parkje bevindt zich recht tegenover de Onze-Lieve-Vrouw-ter-Zavelkerk. In dit openluchtmuseum worden de verschillende Brusselse gilden verpersoonlijkt door 48 standbeelden. Er zijn ook 10 andere beelden die staan voor de grote humanisten van de 16e eeuw: Mercator, Ortelius... De bloemen en planten in het park staan ook bol van de symboliek. Wist je dat de gesnoeide buxussen de negen Belgische provincies uit die periode voorstellen ? De kroon is een verwijzing naar het koninkrijk.\r\n\r\nAchteraan vind je een standbeeld als eerbetoon aan de graven Egmont en Hoorn. Dat waren verzetsstrijders die in de 16e eeuw werden onthoofd tijdens de Spaanse onderdrukking. Neem nu de trappen naar de Wolstraat. Daar kan je naar het Egmontpark.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Square du Petit Sablon","address_street_name":"Place du Petit Sablon","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Place du Petit Sablon","address_line2":"1000 Brussels","description_web":"Designed in a Flemish neo-renaissance style, the flower garden of square du Petit Sablon is an architectural gem right opposite the Church of Our Lady of the Sablon. In Flemish neo-renaissance style, the flower garden of square du Petit Sablon is an architectural gem right opposite the Church of Our Lady of the Sablon. In this open-air museum, the various Brussels guilds of the day are personified by 48 statues and ten others represent the great humanists of the 16th century: Mercator, Ort\u00e9lius... The flora reveals yet more symbolism: nine clumps of carved boxwood representing the nine Belgian provinces of the era and a crown for the kingdom as a whole.\r\n\r\nAt the bottom of the garden stands a fountain-statue in honour of the Counts of Egmont and Hornes, resistance fighters who were beheaded in the 16th century during the tyrannical Spanish regime. Last but not least, two flights of stairs lead you to Rue aux Laines and on to Egmont Park.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Square du Petit Sablon","address_street_name":"Rue de la R\u00e9gence","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la R\u00e9gence","address_line2":"1000 Bruxelles","description_web":"Der Square du Petit Sablon im fl\u00e4mischen Neo-Renaissance-Stil, gleich gegen\u00fcber der Kirche Notre-Dame-au-Sablon, gilt es eines der architektonischen Kleinode der Br\u00fcsseler Innenstadt.\r\n\r\nMit seinen Monumenten und Skulpturen mutet der Petit Sablon fast wie ein Freilichtmuseum an: Den schmiedeeisernen Zaun zieren 48 majest\u00e4tische romanische S\u00e4ulen, auf denen ebenso viele Bronzestatuen prangen, die die Br\u00fcsseler Handwerksz\u00fcnfte verk\u00f6rpern. Die zehn Statuen im hinteren Teil des Gartens zeigen die gro\u00dfen belgischen Humanisten, von Mercator bis Ort\u00e9lius... Der symmetrische Platz besitzt eine gro\u00dfe Symbolkraft, die bis in die Pflanzenwelt hineinreicht: Die neun Buschformationen stehen f\u00fcr die damaligen neun belgischen Provinzen.\r\n\r\nDie zentralen Statuen stellen die Grafen von Egmont und von Hornes dar, die sich im 16. Jahrhundert der spanischen Tyrannenherrschaft entgegenstellten und schlie\u00dflich enthauptet wurden. Zwei Treppen f\u00fchren in die Rue aux Laines, von der aus Sie in den Parc d\u2019Egmont gelangen.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Square du Petit Sablon","address_street_name":"Place du Petit Sablon","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place du Petit Sablon","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Plaza del Petit Sablon","address_street_name":"Place du Petit Sablon","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place du Petit Sablon","address_line2":"1000 Bruxelles","description_web":"Inaugurada en 1890, la plaza est\u00e1 rodeada por una balaustrada de hierro forjado, decorada con 48 estatuillas de bronce que representan antiguos oficios practicados en Bruselas. Hay diez estatuas que decoran la parte posterior del parque, con la intenci\u00f3n de ilustrar el siglo XVI en B\u00e9lgica a trav\u00e9s c\u00e9lebres eruditos y humanistas, tales como Mercator, Abraham Ortelius, Louis Van Bodeghem o Rombaud Dodon\u00e9e, entre otros. En el centro, las estatuas del Conde Egmont y Hornes simbolizan la lucha contra la tiran\u00eda espa\u00f1ola del siglo XVI. El pedestal est\u00e1 decorado con los escudos de los dos se\u00f1ores.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Pra\u00e7a do Petit Sablon","address_street_name":"Place du Petit Sablon","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place du Petit Sablon","address_line2":"1000 Bruxelles","description_web":"Considerado uma das joias arquitet\u00f3nicas do centro de Bruxelas, o jardim florido de estilo renascentista flamengo da Pra\u00e7a do Petit Sablon foi decorado em cerca de 1890 ao longo do tra\u00e7ado da rua R\u00e9gence. Neste museu ao c\u00e9u aberto, as diferentes corpora\u00e7\u00f5es bruxelenses s\u00e3o representadas por 48 est\u00e1tuas de bronze. As est\u00e1tuas que ornamentam o fundo do jardim ilustram o s\u00e9culo XVI belga atrav\u00e9s dos seus grandes humanistas Mercator, Abraham Ort\u00e9lius, Louis Van Bodeghem e Rombaud Dodon\u00e9e, entre outros, num total de 10. As est\u00e1tuas que ornamentam o fundo do jardim ilustram o s\u00e9culo XVI belga atrav\u00e9s dos seus grandes humanistas Mercator, Abraham Ort\u00e9lius, Louis Van Bodeghem e Rombaud Dodon\u00e9e, entre outros, num total de 10. No centro, para simbolizar a luta contra a tirania espanhola do s\u00e9culo XVI, encontramos as est\u00e1tuas dos contes de Egmont e de Hornes Equipamentos: -Bancos Acessibilidade: a pra\u00e7a est\u00e1 acess\u00edvel a pessoas portadoras de defici\u00eancia.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Square du Petit Sablon","address_street_name":"Place du Petit Sablon","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place du Petit Sablon","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[16],"translations":{"fr":["Quartier Royal"],"nl":["Koninklijke wijk"],"en":["Royal"],"de":["K\u00f6nigliches Viertel"],"it":["Quartiere reale"],"sp":["Quartier Royal \u2014Barrio de la Corte\u2014"],"pt":[null],"cn":[null]}},"zones":{"list":[19],"translations":{"fr":["Centre"],"nl":["Centrum"],"en":["Centre"],"de":["Zentrum"],"it":["Centro"],"sp":["Centro"],"pt":[null],"cn":[null]}},"neca":null,"facebook_id":null,"backoffice_id":20227,"location":{"lat":50.83951455,"lon":4.35661018},"region":"brussels","last_updated_at":"2023-05-11T09:35:05+02:00","published_at":"2015-03-11T14:57:28+01:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":255457,"translations":{"fr":{"name":"CFC-Editions","address_street_name":"Place des Martyrs","address_street_number":"14","address_street_box":null,"email":null,"website":null,"phone_contact":"+32 2 227 34 00","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Martyrs, 14","address_line2":"1000 Bruxelles","description_web":"","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"CFC-Editions","address_street_name":"Martelaarsplein","address_street_number":"14","address_s