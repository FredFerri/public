Scholen","PBM","Leerkrachten","Senioren","Jongeren 15-18 j.","LGTBQIA","Familie"]}},"educational_targets":{"list":[],"translations":{}},"tags":["kids"],"opening":{"day":"2024-01-25","end":"20:30:00","start":"17:30:00","timestamp":"2024-01-25T17:30:00"}},{"id":50006312,"date_start":"2024-02-16","date_end":"2024-03-16","date_next":"2024-02-20","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-02-18T01:03:31+01:00","published_at":"2024-01-22T08:48:09+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":292833,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.3218297948685433,"languages":{"spoken":["fr","en"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[30,24],"translations":{"de":["Malerei","Kunstgalerien"],"pt":[null,null],"en":["Painting","Art Galleries"],"it":["Pittura","Gallerie d'arte"],"cn":[null,null],"fr":["Peinture","Galeries d'art"],"sp":["Pintura","Galer\u00edas de arte"],"nl":["Schilderkunst","Galeries"]}}},"translations":{"de":{"name":"Bananes, Crocs\u00ae and ceramics","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.mazelgalerie.com","email":"contact@mazelgalerie.com","phone_contact":"+32 2 850 29 28","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50006312"},"pt":{"name":"Bananes, Crocs\u00ae and ceramics","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.mazelgalerie.com","email":"contact@mazelgalerie.com","phone_contact":"+32 2 850 29 28","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50006312"},"en":{"name":"Bananes, Crocs\u00ae and ceramics","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.mazelgalerie.com","email":"contact@mazelgalerie.com","phone_contact":"+32 2 850 29 28","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50006312"},"it":{"name":"Bananes, Crocs\u00ae and ceramics","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.mazelgalerie.com","email":"contact@mazelgalerie.com","phone_contact":"+32 2 850 29 28","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50006312"},"cn":{"name":"Bananes, Crocs\u00ae and ceramics","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.mazelgalerie.com","email":"contact@mazelgalerie.com","phone_contact":"+32 2 850 29 28","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50006312"},"fr":{"name":"Bananes, Crocs\u00ae et c\u00e9ramiques","shortdescr":"Mazel Galerie consacre \u00e0 l\u2019artiste fran\u00e7ais David Bruce sa premi\u00e8re exposition personnelle en Belgique.\n\nSon univers peut \u00eatre consid\u00e9r\u00e9 comme d\u00e9cal\u00e9. C\u2019est son attirance pour les formes simples et les objets du quotidien qui cr\u00e9e ce d\u00e9calage avec notre soci\u00e9t\u00e9 toujours plus technologique et connect\u00e9e.","longdescr":"Il ne se soucie ni de l\u2019\u00e9chelle ni du r\u00e9alisme, seul l\u2019\u00e9nergie du moment et le plaisir de peindre pr\u00e9domine.\nCette insouciance apparente se retrouve dans ses c\u00e9ramiques, ce travail qu\u2019il a appris au contact d\u2019autres artistes dans l\u2019atelier collectif qu\u2019il partage \u00e0 Li\u00e8ge.\nIl ne faut ni rechercher une logique particuli\u00e8re qui relierait les formes et les objets entre eux, ni un lien entre une banane, les logos de Lacoste et BMW, des m\u00e9sanges ou un ballon de basket.\n\u00c0 l\u2019instar des artistes de la Figurations Libre tel que Robert Combas et Fran\u00e7ois Boisrond, qui \u00e0 leurs d\u00e9buts peignaient l\u2019accessible et le populaire au moyen d\u2019un art \u00ab signal\u00e9tique \u00bb en r\u00e9action \u00e0 l\u2019art minimal et conceptuel qui dominait dans les ann\u00e9es 70, David Bruce tente d\u2019apporter la fraicheur et l\u2019imm\u00e9diatet\u00e9 du street art \u00e0 l\u2019art plus institutionnel dit \u00ab contemporain \u00bb que certains se plaisent \u00e0 opposer sans rime ni raison.\nDans ce sens l\u2019artiste dit : \u00ab Ma palette est tout aussi restreinte que mes sujets : dix couleurs maximum. Une poign\u00e9e de couleurs franches que j\u2019emploie pour tout. Quand on d\u00e9marre dans la rue, tout doit aller vite. Cette notion d\u2019urgence m\u2019est rest\u00e9e. \u00bb\n\u00ab Bananes, Crocs\u00ae et c\u00e9ramiques \u00bb est comme ces films de s\u00e9rie B que l\u2019on aime sans trop savoir pourquoi et qui finissent par devenir culte aux yeux de tous, probablement parce qu\u2019ils ont une saveur, une couleur et une narration \u00e0 part.\nSi vous lui posez la question pourquoi Crocs\u00ae ? David Bruce r\u00e9pondrait certainement que c\u2019est tout simplement moche, mais tr\u00e8s agr\u00e9able \u00e0 porter et qu\u2019il ne quitte que tr\u00e8s rarement les siennes \u00e0 l\u2019atelier.\n\u00c0 travers ce nouvel ensemble d\u2019une quinzaine de toiles et d\u2019une dizaine de c\u00e9ramiques, l\u2019artiste d\u00e9voile un peu son intimit\u00e9 pour la premi\u00e8re fois. Il nous fait entrer dans son atelier et chez lui, nous pr\u00e9sente sa compagne Vanessa, et d\u00e9voile les choses qui l\u2019entourent et comptent au q