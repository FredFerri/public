\nNon-FMSB  : 50 \u20ac par ann\u00e9e acad\u00e9mique\r\nPublic: personnes de plus de 50 ans, pensionn\u00e9es ou non\r\n","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"S\u2019Acad\u00e9mie asbl","address_street_name":"Zuidstraat","address_street_number":"118","address_street_box":null,"email":"sacademie@fmsb.be","website":"http:\/\/www.fmsb.be\/","phone_contact":"+32 2 546 14 94","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Zuidstraat, 118","address_line2":"1000 Brussel","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"S\u2019Acad\u00e9mie asbl","address_street_name":"Rue du Midi","address_street_number":"118","address_street_box":null,"email":"sacademie@fmsb.be","website":"http:\/\/www.fmsb.be\/","phone_contact":"+32 2 546 14 94","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue du Midi, 118","address_line2":"1000 Brussels","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"S\u2019Acad\u00e9mie asbl","address_street_name":"Rue du Midi","address_street_number":"118","address_street_box":null,"email":"sacademie@fmsb.be","website":"http:\/\/www.fmsb.be\/","phone_contact":"+32 2 546 14 94","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Midi, 118","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"S\u2019Acad\u00e9mie asbl","address_street_name":"Rue du Midi","address_street_number":"118","address_street_box":null,"email":"sacademie@fmsb.be","website":"http:\/\/www.fmsb.be\/","phone_contact":"+32 2 546 14 94","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Midi, 118","address_line2":"1000 Bruxelles","description_web":"","description_print":"","boo