ww.toone.be","email":"woltje@skynet.be","phone_contact":"+32 2 511 71 37","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50001740"},"en":{"name":"Macbeth","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.toone.be","email":"woltje@skynet.be","phone_contact":"+32 2 511 71 37","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50001740"},"it":{"name":"Macbeth","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.toone.be","email":"woltje@skynet.be","phone_contact":"+32 2 511 71 37","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50001740"},"cn":{"name":"Macbeth","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.toone.be","email":"woltje@skynet.be","phone_contact":"+32 2 511 71 37","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50001740"},"fr":{"name":"Macbeth","shortdescr":"Parodie pour marionnettes, en bruxellois fran\u00e7ais.","longdescr":"Dans la s\u00e9rie des \u201cGrands classiques\u201d, Toone VIII - Nicolas G\u00e9al pr\u00e9sente\n\u201cMacbeth\u201d, sombre drame shakespearien de la fatalit\u00e9 et de l\u2019ambition devenu,\ngr\u00e2ce \u00e0 la malicieuse collaboration d\u2019Arthur et Elisabeth FAUQUEZ, une com\u00e9die\nbruxelloise o\u00f9 l\u2019imparable Woltje, le ketje de Bruxelles, trouve son mot \u00e0 dire.\nCr\u00e9\u00e9e en 1967, \u00e0 l\u2019occasion de la \u201cBritish Week in Brussels\u201d, \u201cMacbeth\u201d re\u00e7ut un\naccueil exceptionnel que confirme l\u2019anecdote suivante : un soir que Toone VII \u2013\nJos\u00e9 G\u00e9al, comme \u00e0 l\u2019accoutum\u00e9e, salue son public, son Excellence l\u2019ambassadeur\nde Grande-Bretagne lui glisse \u00e0 l\u2019oreille ces mots historiques : \u201cIt\u2019s the first time, I\nappreciate Shakespeare.\u201d En 1997, Toone VII fait appel au talent du regrett\u00e9\nRaymond Renard pour pr\u00e9senter une nouvelle sc\u00e9nographie de ce r\u00e9gicide\nbritannique. Le roi d\u2019Ecosse ne cache \u00e0 personne sa d\u00e9votion pour le\n\u201cbloempanch\u201d (boudin) et les frites de Madame Macbeth ! Tandis que la for\u00eat de\nBirnam en marche vers le ch\u00e2teau sera repr\u00e9sent\u00e9e par le traditionnel \u201cM\u00e2buum\u201d,\nle fameux Meyboom bruxellois, arbre plant\u00e9 chaque ann\u00e9e, la veille de la Saint-\nLaurent, au coin des rues du Marais et des Sables d\u2019apr\u00e8s une tradition s\u00e9culaire.\n\u201c... Toone a surtout respect\u00e9 l\u2019esprit de Shakespeare et sa cr\u00e9ation de Macbeth et\nde Lady Macbeth est remarquable, car ces marionnettes expriment avec\nvraisemblance le d\u00e9chirement de la conscience, la fascination du mal et la peur de\nla damnation.\u201d (C.B. La Cit\u00e9, 10-11-1969) Et comme l\u2019\u00e9crit Luc Honorez : \u201cToone\nsait raconter des histoires, il ne trahit pas, il pastiche.\u201d (Le Soir, 12-11-1969)","performers":null,"boxoffice_url":null,"website":"http:\/\/www.toone.be","email":"woltje@skynet.be","phone_contact":"+32 2 511 71 37","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50001740"},"sp":{"name":"Macbeth","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.toone.be","email":"woltje@skynet.be","phone_contact":"+32 2 511 71 37","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50001740"},"nl":{"name":"Macbeth","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.toone.be","email":"woltje@skynet.be","phone_contact":"+32 2 511 71 37","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50001740"}},"place":{"id":231143,"translations":{"de":{"name":"Marionettentheater - Th\u00e9\u00e2tre Royal de Toone","address_street_name":"Rue du March\u00e9 aux Herbes","address_street_number":"66","address_street_box":null,"email":"woltje@skynet.be","website":"http:\/\/www.toone.be","phone_contact":"+32 2 511 71 37","phone_booking":"+32 2 513 54 86","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du March\u00e9 aux Herbes, 66","address_line2":"1000 Bruxelles","description_web":"W\u00e4hrend der spanischen Besetzung der Niederlande wurden zwangsweise s\u00e4mtliche Theater geschlossen, um Kritik - in Form von satirischen St\u00fccken - an den spanischen Herrschern zu unterbinden. Die Br\u00fcsseler haben alsdann die Schauspieler durch Marionetten (\"Poechenelles\" in Br\u00fcsseler Mundart) ersetzt, die in illegalen Theatern auftragen. \r\nAnfang des 19. Jahrhunderts z\u00e4hlten die Br\u00fcsseler Marionettentheater zu den beliebtesten Vergn\u00fcgungen f\u00fcr Erwachsene, denn sie boten eine enorme Freiheit, ben\u00f6tigen nur wenig finanzielle Mittel und konnten \u00fcberall aufgef\u00fchrt werden. Ihr Repertoire ist bis heute sehr vielf\u00e4ltig und reicht von volkst\u00fcmlichen Legenden \u00fcber Rittergeschichten bis hin zu religi\u00f6sen oder historischen St\u00fccken, die sehr frei interpretiert werden. \r\nSeit der Gr\u00fcndung des Theaters im Marollenviertel ist nun bereits die 9. Puppenspielergeneration der Toone-Dynastie am Werk. Der jeweils neue Toone (Br\u00fcsseler Kosename f\u00fcr \"Antoine\", so der Vorname des Gr\u00fcnders) muss sowohl von seinem Vorg\u00e4nger als auch von dem Publikum angenommen werden - und so ist es nicht unbedingt der jeweilige Sohn, der die Nachfolge antritt. \r\nDie Klassiker werden in Br\u00fcsseler Mundart und manchmal auch auf Niederl\u00e4ndisch oder Franz\u00f6sisch aufgef\u00fchrt. \r\nDas Th\u00e9\u00e2tre de Toone birgt auch ein urige Schenke und ein Marionettenmuseum.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Th\u00e9\u00e2tre Royal de Toone","address_street_name":"Rue du March\u00e9 aux Herbes - Entr\u00e9e : Impasse Sainte P\u00e9tronille","address_street_number":"66","address_street_box":null,"email":"woltje@skynet.be","website":"http:\/\/www.toone.be","phone_contact":"+32 2 511 71 37","phone_booking":"+32 2 513 54 86","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du March\u00e9 aux Herbes - Entr\u00e9e : Impasse Sainte P\u00e9tronille, 66","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Th\u00e9\u00e2tre Royal de Toone","address_street_name":"Rue du March\u00e9 aux Herbes","address_street_number":"66","address_street_box":null,"email":"woltje@skynet.be","website":"http:\/\/www.toone.be","phone_contact":"+32 2 511 71 37","phone_booking":"+32 2 513 54 86","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du March\u00e9 aux Herbes, 66","address_line2":"1000 Bruxelles","description_web":"During the Spanish occupation of the Netherlands all theaters were closed to prevent the actors from raising satirical pieces against the Spanish rulers. As a result, doll shows came into play: it was easier to tolerate the fierce dialogues when pronounced by lifeless dolls. About 1830 Antoine \"Toone\" Genty opened  a puppet theater, then in the Marolles. More than 180 years later, this popular entertainment has grown into a Royal Puppet Theater. After Genty, his (unrelated) successors would also be called Toone (Antoine).\r\nThe classics are performed in the local Brussels dialect with wooden puppets (the so-called poechenel), sometimes in Dutch or in French. The puppet theater and museum has been located near the Grand Place for four decades. The theater is located on the upper floors of the building, on the ground floor there is a pub. The museum contains old dolls, including 19th century specimens.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Teatro Reale di Toone VII","address_street_name":"Rue du March\u00e9 aux Herbes","address_street_number":"66","address_street_box":null,"email":"woltje@skynet.be","website":"http:\/\/www.toone.be","phone_contact":"+32 2 511 71 37","phone_booking":"+32 2 513 54 86","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du March\u00e9 aux Herbes, 66","address_line2":"1000 Bruxelles","description_web":"Traditional Brussels\u2019 puppet theater & museum - Typical caf\u00e9\r\nBordering the Impasses Schuddeveld and Sainte-P\u00e9tronille, you will find one of the favourite places of Brussels citizens: Le th\u00e9\u00e2tre de Toone.\r\nTheater Toone is simultaneously a typical estaminet with its Spanish pink brick walls, blackened beams and tiled floor, a puppet theatre in the attic, with its wooden benches, festooned, multicoloured cushions nailed into the raw wood planks and a puppet museum. There, we find the characters who retired from the stage, these Toone heroes of the past and fetish characters of fellow puppeteers from around the world.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Th\u00e9\u00e2tre Royal de Toone","address_street_name":"Rue du March\u00e9 aux Herbes - Entr\u00e9e : Impasse Sainte P\u00e9tronille","address_street_number":"66","address_street_box":null,"email":"woltje@skynet.be","website":"http:\/\/www.toone.be","phone_contact":"+32 2 511 71 37","phone_booking":"+32 2 513 54 86","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du March\u00e9 aux Herbes - Entr\u00e9e : Impasse Sainte P\u00e9tronille, 66","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"fr":{"name":"Th\u00e9\u00e2tre Royal de Toone","address_street_name":"Rue du March\u00e9 aux Herbes - Entr\u00e9e : Impasse Sainte P\u00e9tronille","address_street_number":"66","address_street_box":null,"email":"woltje@skynet.be","website":"http:\/\/www.toone.be","phone_contact":"+32 2 511 71 37","phone_booking":"+32 2 513 54 86","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du March\u00e9 aux Herbes - Entr\u00e9e : Impasse Sainte P\u00e9tronille, 66","address_line2":"1000 Bruxelles","description_web":"Le Th\u00e9\u00e2tre Royal de Toone: un th\u00e9\u00e2tre original et authentique, impr\u00e9gn\u00e9 d\u2019histoire et de culture bruxelloise !\r\nId\u00e9alement situ\u00e9 \u00e0 c\u00f4t\u00e9 de la Grand-Place, dans une maison v\u00e9n\u00e9rable datant de 1696, le Th\u00e9\u00e2tre Royal de Toone poursuit la tradition s\u00e9culaire du th\u00e9\u00e2tre populaire de marionnettes depuis 1830. \r\nLa programmation est bas\u00e9e sur les grands classiques du th\u00e9\u00e2tre tels que \u00ab Les Trois Mousquetaires \u00bb d\u2019apr\u00e8s Alexandre Dumas ou encore \u00ab Rom\u00e9o et Juliette \u00bb d\u2019apr\u00e8s William Shakespeare.\r\nActuellement, le mus\u00e9e permanent de Toone situ\u00e9 au premier \u00e9tage du b\u00e2timent principal se visite gratuitement pendant l\u2019entracte.\r\nL\u2019estaminet folklorique au rez-de-chauss\u00e9e est ouvert tous les jours de 12h00 \u00e0 24h00, sauf le lundi (jour de fermeture).\r\nC\u2019est  un estaminet tricentenaire o\u00f9, dans une ambiance authentique de briques roses espagnoles, poutres noircies et sol dall\u00e9, vous pourrez appr\u00e9cier quelques bi\u00e8res, dont la c\u00e9l\u00e8bre gueuze. \r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Teatro Real Toone VII","address_street_name":"Rue du March\u00e9 aux Herbes","address_street_number":"66","address_street_box":null,"email":"woltje@skynet.be","website":"http:\/\/www.toone.be","phone_contact":"+32 2 511 71 37","phone_booking":"+32 2 513 54 86","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du March\u00e9 aux Herbes, 66","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Koninklijk Poppentheater Toone","address_street_name":"Grasmarkt - Ingang: Impasse Sainte P\u00e9tronille","address_street_number":"66","address_street_box":null,"email":"woltje@skynet.be","website":"http:\/\/www.toone.be","phone_contact":"+32 2 511 71 37","phone_booking":"+32 2 513 54 86","address_zip":"1000","address_city":"Bruxelles","address_line1":"Grasmarkt - Ingang: Impasse Sainte P\u00e9tronille, 66","address_line2":"1000 Bruxelles","description_web":"Traditioneel marionettentheater Brusselse folklore - Typisch Staminee.\r\nMuseum van Toone: Gratis toegang voor het publiek tijdens de pauze.\r\nHet Koninklijk Theater Toone in Brussel is een origineel en authentiek poppentheater dat doorspekt is van Brusselse geschiedenis en cultuur! \r\nHet Koninklijk Theater Toone zet sinds 1830 de eeuwenoude traditie van het volkse Theater voort.\r\nDe programmatie is gebaseerd op grote toneelklassiekers zoals \"Cyrano de Bergerac\" van Edmond Rostand, \"De Drie Musketiers\" van Alexandre Dumas, \"Romeo en Julia\" van William Shakespeare en \"Tijl Uilenspiegel\" van Charles De Coster. \r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[],"translations":{}},"zones":[],"neca":null,"facebook_id":null,"backoffice_id":913,"location":{"lat":50.8471135,"lon":4.3536487},"region":"brussels","last_updated_at":"2023-08-14T16:37:08+02:00","published_at":"2013-10-19T01:13:54+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":231143,"translations":{"de":{"name":"Marionettentheater - Th\u00e9\u00e2tre Royal de Toone","address_street_name":"Rue du March\u00e9 aux Herbes","address_street_number":"66","address_street_box":null,"email":"woltje