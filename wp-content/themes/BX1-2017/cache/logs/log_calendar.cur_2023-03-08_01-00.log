"title":"L\u2019Ecole Art D\u00e9co La Roue P21","copyright":null}}},{"type":"poster","link":"https:\/\/agendabrussels.imgix.net\/3b9639e39034eea772bf049d3e4c7691c59836cb.jpg","width":637,"height":1070,"ratio":0.6,"translations":{"fr":{"title":"L\u2019Ecole Art D\u00e9co La Roue P21","copyright":null},"nl":{"title":"L\u2019Ecole Art D\u00e9co La Roue P21","copyright":null},"en":{"title":"L\u2019Ecole Art D\u00e9co La Roue P21","copyright":null},"de":{"title":"L\u2019Ecole Art D\u00e9co La Roue P21","copyright":null},"it":{"title":"L\u2019Ecole Art D\u00e9co La Roue P21","copyright":null},"sp":{"title":"L\u2019Ecole Art D\u00e9co La Roue P21","copyright":null},"pt":{"title":"L\u2019Ecole Art D\u00e9co La Roue P21","copyright":null},"cn":{"title":"L\u2019Ecole Art D\u00e9co La Roue P21","copyright":null}}}],"dates":[{"day":"2023-03-11","doors":null,"start":"10:00:00","end":"18:00:00","is_soldout":false,"is_canceled":false},{"day":"2023-03-12","doors":null,"start":"10:00:00","end":"18:00:00","is_soldout":false,"is_canceled":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"visit_profile":{"list":[322],"translations":{"fr":["Art Nouveau & Art D\u00e9co"],"nl":["Art nouveau & art deco"],"en":["Art Nouveau &  Art D\u00e9co"],"de":["Jugendstil & Art d\u00e9co"],"it":["Art Nouveau e Art D\u00e9co"],"sp":["Art nouveau y art d\u00e9co"],"pt":[null],"cn":[null]}},"tags":["annee_art_nouveau"],"is_part_of":"Ann\u00e9e Art Nouveau","accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-02-22T10:35:07+01:00","published_at":"2023-02-21T16:52:18+01:00","backoffice_id":272258,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.7937005259841},{"id":544500,"date_start":"2023-03-11","date_end":"2023-03-26","date_next":"2023-03-11","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen","it":"Visite guidate","sp":"Visitas guiadas","pt":null,"cn":null}},"others":{"list":[104],"translations":{"fr":["Art Nouveau, Art D\u00e9co"],"nl":["Art nouveau, art deco"],"en":["Art Nouveau, Art D\u00e9co"],"de":["Jugendstil, Art d\u00e9co"],"it":["Art Nouveau, Art D\u00e9co"],"sp":["Art nouveau, art d\u00e9co"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Brussels Art Nouveau & Art Deco (BANAD) Festival 2023","shortdescr":"Le Brussels Art Nouveau & Art Deco (BANAD) Festival est un \u00e9v\u00e9nement exceptionnel mettant en valeur le patrimoine Art nouveau et Art d\u00e9co en R\u00e9gion de Bruxelles-Capitale.\r\nAu c\u0153ur du festival : les visites guid\u00e9es d'int\u00e9rieurs Art nouveau et Art d\u00e9co habituellement ferm\u00e9s au public.","longdescr":"Concept de l'\u00e9v\u00e9nement\r\n\r\nLe Brussels Art Nouveau & Art Deco (BANAD) Festival est un \u00e9v\u00e9nement exceptionnel mettant en valeur le patrimoine Art nouveau et Art d\u00e9co en R\u00e9gion de Bruxelles-Capitale. Il se tient chaque ann\u00e9e durant uniquement les week-ends de  mars. \r\n\r\nAu c\u0153ur du festival : les visites guid\u00e9es d'int\u00e9rieurs Art nouveau et Art d\u00e9co habituellement ferm\u00e9s au public. Une occasion unique de (re)d\u00e9couvrir ces joyaux de notre architecture !\r\n\r\nEn compl\u00e9ment, d'autres activit\u00e9s mettant en valeur le patrimoine Art nouveau et Art d\u00e9co sont organis\u00e9es : parcours (en ext\u00e9rieur) guid\u00e9s, concerts, conf\u00e9rences, \u00e9v\u00e9nements, activit\u00e9s pour les familles, foire aux objets d'\u00e9poque, activit\u00e9s pour les PMR, activit\u00e9s pour les \u00e9coles\u2026\r\n\r\nCe concept est unique en Europe !","performers":"Le BANAD Festival est organis\u00e9 par Explore.Brussels et ses associations membres : ARAU, Arkadia, Bruxelles Bavard et Pro Velo.","boxoffice_url":"https:\/\/shop.utick.be\/?pos=EXPBRU&module=CATALOGUE&lg=FR","website":"https:\/\/www.banad.brussels\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.544500"},"nl":{"name":"Brussels Art Nouveau & Art Deco (BANAD) Festival 2023","shortdescr":"Het Brussels Art Nouveau & Art Deco (BANAD) Festival is een uitzonderlijk evenement dat het art nouveau en art deco erfgoed in het Brussels Hoofdstedelijk Gewest in de kijker plaatst.\r\nCentraal tijdens het festival: geleide bezoeken aan art nouveau en art deco interieurs die gewoonlijk gesloten zijn voor het publiek.","longdescr":"Concept van het evenement\r\n\r\nHet Brussels Art Nouveau & Art Deco (BANAD) Festival is een uitzonderlijk evenement dat het art nouveau en art deco erfgoed in het Brussels Hoofdstedelijk Gewest in de kijker plaatst. Het vindt ieder jaar tijdens de weekends van maart plaats. \r\n\r\nCentraal tijdens het festival: geleide bezoeken aan art nouveau en art deco interieurs die gewoonlijk gesloten zijn voor het publiek. Kortom, een unieke kans om deze pareltjes van onze architectuur (opnieuw) te ontdekken!\r\n\r\nDaarnaast worden er nog andere activiteiten georganiseerd om het art nouveau en art deco erfgoed te belichten, zoals geleide parcours (buiten), concerten, conferenties, evenementen, gezinsactiviteiten, een beurs met voorwerpen uit dezelfde periode, activiteiten voor personen met een beperkte mobiliteit (PBM) en activiteiten voor scholen...\r\n\r\nDit concept is uniek in Europa!","performers":"Het BANAD Festival is een organisatie van Explore.Brussels en zijn netwerk van organisaties: ARAU, Arkadia, Brussel Babbelt en Pro Velo.","boxoffice_url":"https:\/\/shop.utick.be\/?pos=EXPBRU&module=CATALOGUE&lg=NL","website":"https:\/\/www.banad.brussels\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.544500"},"en":{"name":"Brussels Art Nouveau & Art Deco (BANAD) Festival 2023","shortdescr":"The Brussels Art Nouveau & Art Deco (BANAD) Festival is a special event that promotes the Art Nouveau and Art Deco heritage of the Brussels-Capital Region.\r\nWhat makes this festival so special are guided tours through Art Nouveau and Art Deco buildings that are normally not open for visitors.","longdescr":"Event Concept\r\n\r\nThe Brussels Art Nouveau & Art Deco (BANAD) Festival is a special event that promotes the Art Nouveau and Art Deco heritage of the Brussels-Capital Region. It takes place every year on the weekends of March. \r\n\r\nWhat makes this festival so special are guided tours through Art Nouveau and Art Deco buildings that are normally not open for visitors. A unique opportunity to (re) discover these hidden architectural gems!\r\n\r\nAs part of the Festival, we also offer other activities that spotlight the Art Nouveau and Art Deco heritage and complement the guided tours: walking tours as well as bike and bus tours; concerts; seminars; shows; activities for families; an antique market; activities for disabled people; and activities for schools...\r\n\r\nThe event concept is unique in Europe!","performers":"The BANAD Festival is organised by Explore.Brussels, a network of associations that organise guided tours: ARAU, Arkadia, Brussels Chatterguides and Pro Velo.","boxoffice_url":"https:\/\/shop.utick.be\/?pos=EXPBRU&module=CATALOGUE&lg=EN","website":"https:\/\/www.banad.brussels\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.544500"},"de":{"name":"Brussels Art Nouveau & Art Deco (BANAD) Festival 2023","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.544500"},"it":{"name":"Brussels Art Nouveau & Art Deco (BANAD) Festival 2023","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.544500"},"sp":{"name":"Brussels Art Nouveau & Art Deco (BANAD) Festival 2023","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.544500"},"pt":{"name":"Brussels Art Nouveau & Art Deco (BANAD) Festival 2023","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.544500"},"cn":{"name":"Brussels Art Nouveau & Art Deco (BANAD) Festival 2023","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.544500"}},"place":{"id":245448,"translations":{"fr":{"name":"Divers lieux \u00e0 Bruxelles","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_