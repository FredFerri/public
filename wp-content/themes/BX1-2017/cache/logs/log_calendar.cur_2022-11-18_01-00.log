ui, pour se prouver qu\u2019on peut encore s\u00e9duire... Se pr\u00e9senter comme on se mettrait en vente sur Amazon. Juger. Comparer. D\u00e9sirer. Aborder un.e inconnu.e dans la s\u00e9curit\u00e9 et la st\u00e9rilit\u00e9 virtuelle. Oser passer le pas de la rencontre r\u00e9elle. Prendre le risque de se confronter \u00e0 la r\u00e9alit\u00e9.\r\nClaire de Reuck et Patrick Spadrille d\u00e9cortiquent avec humour et sinc\u00e9rit\u00e9 les rouages de l\u2019amour 2.0. Ses fantasmes, ses d\u00e9sillusions, ses angoisses, ses excitations, ses \u00e9checs et ses charmantes surprises.","performers":"Patrick Spadrille, Claire de Reuck, Salom\u00e9 Corbo","boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Rencontres-com.html","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.539576"},"nl":{"name":"Rencontres.com","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.539576"},"en":{"name":"Rencontres.com","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.539576"},"de":{"name":"Rencontres.com","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.539576"},"it":{"name":"Rencontres.com","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.539576"},"sp":{"name":"Rencontres.com","shortdescr":null,"longdescr":null,"perfo