,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-11-15T11:50:38+01:00","published_at":"2024-10-28T14:36:54+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":310644,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"other","ranking":0.6933612743506347,"languages":{"spoken":["nl","en","fr"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[36],"translations":{"de":["Museen & Kunstzentren"],"pt":[null],"en":["Museums and art centers"],"it":["Musei e centri artistici"],"cn":[null],"fr":["Mus\u00e9es et art centers"],"sp":["Museos y centros de arte"],"nl":["Musea en kunstcentra"]}}},"translations":{"de":{"name":"BEL Prizes 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brussels-expertise-labels.be","email":"t.dc@bel-brussels.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700003125"},"pt":{"name":"BEL Prizes 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brussels-expertise-labels.be","email":"t.dc@bel-brussels.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700003125"},"en":{"name":"BEL Prizes 2024","shortdescr":"\"When Expertise meets art\", this ephemeral exhibition is intended to present the expertise of its members, as well as the convergence of know-how and art. In total, nearly 60 artistic\ncollaborations born from an exchange between a BEL member and an artist, a\ncreative studio, a designer, a school, etc., will be presented to the public during the\nexceptional BEL Prizes exhibition.","longdescr":"\"When Expertise meets art\", this ephemeral exhibition is intended to present the expertise of its members, as well as the convergence of know-how and art. In total, nearly 60 artistic\ncollaborations born from an exchange between a BEL member and an artist, a\ncreative studio, a designer, a school, etc., will be presented to the public during the\nexceptional BEL Prizes exhibition.\nThe exhibition immerses visitors in the fascinating world of Brussels expertise,\ncombining exceptional know-how and artistic creation (ceramists, painters,\nsculptors, visual artists, schools, architecture firms, engineers...). This staging is\nprimarily a rich human experience that embodies an openness to the world, a fusion\nbetween different worlds, magnifying reality, working towards uniqueness, and\nforging lasting bonds through the sharing of knowledge and visions. These\ncreations, mostly unprecedented, explore new techniques and perspectives of\nexpression, opening unsuspected horizons.\nThe unique creations that will be exhibited are the result of the work of duos of\ninnovative minds. Among the many works presented during this ephemeral\nexhibition, you will find creations marking the following artistic collaborations:\nAutoworld Brussels and Ever Meulen, Bayer & Bayer and Bruno Belva, Bodart\nOpticiens with INSA Strasbourg students Elena and Haimavati, Bouvy and CAD\nBrussels, Cachemire Coton Soie and Caroline Harrius, Charles Schambourg by\nNacarat and Marceline Leduc, Choux de Bruxelles and Sophie Hees & Barbara\nDeoniziuk, Comme chez Soi and Isabelle Ravet, Corica and Margaux Baert, and\nManook, De Coninck and Stefan De Jaeger, Delvaux and Ren\u00e9 Magritte, Diane von\nFu\u0308rstenberg and Andy Warhol, D\u2019Ieteren Luxury Performance and Augustin\nSagehomme, Direct Way Worldwide and Jean-Paul Gaultier, Dominique Rigo and\nLouis de Fabribeckers, Festi Rent and Atelier de la Nuagerie, Gallery Patrick &\nOndine Mestdagh and Olivier Tallec, Hall of Time and Philippe Geluck, Hotel Amigo\nand Roseline d\u2019Oreye, L\u2019Antichambre and Sozyone Gonzalez, Le Beau a une Adresse\nand Stefana McClure, Le Saint-Aulaye and Jo\u00eblle Pontseel, Lunetier Ludovic and\nMarcel Mari\u00ebn (homage), Maison Dandoy and L\u00e9a Maltese, Maison De Greef and\nPhilip Wittmann, Maison Degand and Bodenhorst, Marie\u2019s Corner and Jan Erika,\nMenssa and Charlotte de Lantsheere, Monsel and Jaune, Natan and Christophe\nCoppens, New Embert and Pierre Lallemand, Pierre Marcolini and Leo Luccioni, Rob\nThe Gourmets Market and Anne-Sophie d'Oultremont, Rouge Pivoine and Les Tables\nde Jos\u00e9phine, Serneels and V\u00e9ronique Paternoster, The Hotel and Louis Appelmans,\nToucan sur Mer and Sandrine Peten, Van Thienen and Mademoiselle Jo or even\nWolfers and Emmanuelle B\u00e9duneau.","performers":null,"boxoffice_url":null,"website":"https:\/\/brussels-expertise-labels.be","email":"t.dc@bel-brussels.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700003125"},"it":{"name":"BEL Prizes 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brussels-expertise-labels.be","email":"t.dc@bel-brussels.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700003125"},"cn":{"name":"BEL Prizes 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brussels-expertise-labels.be","email":"t.dc@bel-brussels.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700003125"},"fr":{"name":"BEL Prizes 2024","shortdescr":"\"When Expertise meets art\" , cette exposition \u00e9ph\u00e9m\u00e8re a le d\u00e9sir de pr\u00e9senter l\u2019expertise de ses membres, ainsi que la rencontre du savoir-faire et de l\u2019art. Au total, ce sont pr\u00e8s de 60\ncollaborations artistiques n\u00e9es d\u2019un \u00e9change entre un.e membre du BEL et un.e\nartiste, un studio de cr\u00e9ation, un.e designer, une \u00e9cole,\u2026qui seront pr\u00e9sent\u00e9es au\ngrand public.","longdescr":"\"When Expertise meets art\", cette exposition \u00e9ph\u00e9m\u00e8re a le d\u00e9sir de pr\u00e9senter l\u2019expertise de ses membres, ainsi que la rencontre du savoir-faire et de l\u2019art. Au total, ce sont pr\u00e8s de 60\ncollaborations artistiques n\u00e9es d\u2019un \u00e9change entre un.e membre du BEL et un.e\nartiste, un studio de cr\u00e9ation, un.e designer, une \u00e9cole,\u2026qui seront pr\u00e9sent\u00e9es au\ngrand public.\nL'exposition plonge les visiteurs.euses dans l'univers fascinant de l'expertise\nbruxelloise, alliant savoir-faire d'exception et cr\u00e9ation artistique (c\u00e9ramistes,\npeintres, sculpteur.e.s, plasticien.ne.s, \u00e9coles, bureaux d'architecture, ing\u00e9nieurs...).\nCette mise en sc\u00e8ne est avant tout une exp\u00e9rience humaine enrichissante qui\nincarne une ouverture sur le monde, une fusion entre des univers diff\u00e9rents,\nmagnifiant le r\u00e9el, oeuvrant \u00e0 la singularit\u00e9 et forgeant des liens durables gr\u00e2ce au\npartage de savoirs et de visions. Ces cr\u00e9ations, pour la plupart in\u00e9dites, explorent\nde nouvelles techniques et perspectives d'expression, ouvrant des horizons\ninsoup\u00e7onn\u00e9s.\nLes cr\u00e9ations in\u00e9dites qui seront expos\u00e9es sont le fruit du travail de duos d\u2019esprits\nnovateurs. Parmi les nombreuses oeuvres pr\u00e9sent\u00e9es durant cette exposition\n\u00e9ph\u00e9m\u00e8re, on trouvera des cr\u00e9ations marquant les collaborations artistiques\nsuivantes: Autoworld Brussels et Ever Meulen, Bayer & Bayer et Bruno Belva, Bodart\nOpticiens avec les \u00e9tudiantes d\u2019INSA Strasbourg Elena et Haimavati, Bouvy et le\nCAD Brussels, Cachemire Coton Soie et Caroline Harrius, Charles Schambourg by\nNacarat et Marceline Leduc, Choux de Bruxelles et Sophie Hees & Barbara\nDeoniziuk, Comme chez Soi et Isabelle Ravet, Corica et Margaux Baert, Cubex et\nManook, De Coninck et Stefan De Jaeger, Delvaux et Ren\u00e9 Magritte, Diane von\nFu\u0308rstenberg et Andy Warhol, D\u2019Ieteren Luxury Performance et Augustin\nSagehomme, Direct Way Worldwide et Jean-Paul Gaultier, Dominique Rigo et Louis\nde Fabribeckers, Festi Rent et l\u2019Atelier de la Nuagerie, Le Saint-Aulaye et Jo\u00eblle\nPontseel, Galerie Patrick & Ondine Mestdagh et Olivier Tallec, Hall of Time et\nPhilippe Geluck, Hotel Amigo et Roseline d\u2019Oreye, L\u2019Antichambre et Sozyone\nGonzalez, Le Beau a une Adresse et Stefana McClure, Lunetier Ludovic et Marcel\nMari\u00ebn (hommage), Maison Dandoy et L\u00e9a Maltese, Maison De Greef et Philip\nWittmann, Maison Degand et Bodenhorst, Marie\u2019s Corner et Jan Erika, Menssa et\nCharlotte de Lantsheere, Monsel et Jaune, Natan et Christophe Coppens, New\nEmbert et Pierre Lallemand, Pierre Marcolini et Leo Luccioni, Rob The Gourmets\nMarket et Anne-Sophie d'Oultremont, Rouge Pivoine et Les Tables de Jos\u00e9phine,\nSerneels et V\u00e9ronique Paternoster, The Hotel et Louis Appelmans, Toucan sur Mer\net Sandrine Peten, Van Thienen et Mademoiselle Jo ou encore Wolfers et\nEmmanuelle B\u00e9duneau.","performers":"Brussels Expertise Labels","boxoffice_url":null,"website":"https:\/\/brussels-expertise-labels.be","email":"t.dc@bel-brussels.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700003125"},"sp":{"name":"BEL Prizes 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brussels-expertise-labels.be","email":"t.dc@bel-brussels.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700003125"},"nl":{"name":"BEL Prizes 2024","shortdescr":"\"When Expertise meets art\", deze tijdelijke tentoonstelling heeft tot doel de expertise van haar leden te\npresenteren, evenals de ontmoeting van knowhow en kunst. In totaal zullen bijna 60\nartistieke samenwerkingen, ontstaan uit een uitwisseling tussen een BEL-lid en een\nkunstenaar, een creatieve studio, een ontwerper, een school, enz., aan het grote\npubliek worden voorgesteld. ","longdescr":"\"When Expertise meets art\", deze tijdelijke tentoonstelling heeft tot doel de expertise van haar leden te\npresenteren, evenals de ontmoeting van knowhow en kunst. In totaal zullen bijna 60\nartistieke samenwerkingen, ontstaan uit een uitwisseling tussen een BEL-lid en een\nkunstenaar, een creatieve studio, een ontwerper, een school, enz., aan het grote\npubliek worden voorgesteld. \nDe tentoonstelling dompelt de bezoekers onder in de fascinerende wereld van de\nBrusselse expertise en combineert uitzonderlijke knowhow en artistieke creatie\n(keramisten, schilders, beeldhouwers, beeldende kunstenaars, scholen,\narchitectenbureaus, ingenieurs...). Deze expo is bovenal een verrijkende menselijke\nervaring die een openheid naar de wereld belichaamt. Ze vormt een samensmelting\ntussen verschillende universums, die de realiteit uitvergroot, toewerkt naar\nsingulariteit en duurzame banden smeedt door kennis en visies te delen. Deze\ncreaties, waarvan de meeste uniek zijn, verkennen nieuwe technieken en\nuitdrukkingsperspectieven, waardoor onvermoede horizonten worden geopend.\nDe originele creaties die worden tentoongesteld zijn het werk van innovatieve duo\u2019s.\nOnder de vele werken die tijdens deze tijdelijke tentoonstelling worden\ngepresenteerd, vinden we creaties die de volgende artistieke samenwerkingen\nmarkeren: Autoworld Brussels en Ever Meulen, Bayer & Bayer en Bruno Belva,\nBodart Opticiens met INSA Straatsburg-studenten Elena en Haimavati, Bouvy en het\nCAD Brussels, Cachemire Coton Soie en Caroline Harrius, Charles Schambourg by\nNacarat en Marceline Leduc, Choux de Bruxelles en Sophie Hees & Barbara\nDeoniziuk, Comme chez Soi en Isabelle Ravet, Corica en Margaux Baert, Cubex en\nManook, De Coninck en Stefan De Jaeger, Delvaux en Ren\u00e9 Magritte, Diane von\nFu\u0308rstenberg en Andy Warhol, D'Ieteren Luxury Performance en Augustin\nSagehomme, Direct Way Worldwide en Jean-Paul Gaultier, Dominique Rigo en Louis\nde Fabribeckers, Festi Rent en l'Atelier de la Nuagerie, Galerij Patrick & Ondine\nMestdagh en Olivier Tallec, Hall of Time en Philippe Geluck, Hotel Amigo en Roseline\nd'Oreye, L'Antichambre en Sozyone Gonzalez, Le Beau a une Adresse en Stefana\nMcClure, Le Saint-Aulaye en Jo\u00eblle Pontseel, Lunetier Ludovic en Marcel Mauri\u00ebn\n(eerbetoon), Maison Dandoy en L\u00e9a Maltese, Maison De Greef en Philip Wittmann,\nMaison Degand en Bodenhorst, Marie's Corner en Jan Erika, Menssa en Charlotte\nde Lantsheere, Monsel en Jaune, Natan en Christophe Coppens, New Embert en\nPierre Lallemand, Pierre Marcolini en Leo Luccioni, Rob The Goumets Market en\nAnne-Sophie d'Oultremont, Rouge Pivoine en Les Tables de Jos\u00e9phine, Serneels en\nV\u00e9ronique Paternoster, The Hotel en Louis Appelmans, Toucan sur Mer en Sandrine\nPeten, Van Thienen en Mademoiselle Jo en ook nog Wolfers en Emmanuelle\nB\u00e9duneau.","performers":null,"boxoffice_url":null,"website":"https:\/\/brussels-expertise-labels.be","email":"t.dc@bel-brussels.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700003125"}},"place":{"id":50002582,"translations":{"de":{"name":"Autoworld Brussels","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":"https:\/\/www.autoworld.be\/en\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Autoworld Brussels","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Autoworld Brussels","address_street_name":null