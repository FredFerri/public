j."]}},"educational_targets":{"list":[],"translations":{}},"tags":["kids","annee_art_nouveau"],"opening":{"day":"2023-06-13","end":"21:30:00","is_only_by_appointment":false,"start":"18:30:00","timestamp":"2023-06-13T18:30:00"}},{"id":559307,"date_start":"2023-07-05","date_end":"2023-09-30","date_next":"2023-09-04","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2023-09-02T02:01:17+02:00","published_at":"2023-06-13T13:58:14+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":279307,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.2248221565113046,"languages":{"spoken":["fr","nl"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[48,36],"translations":{"de":["Architektur","Museen & Kunstzentren"],"pt":[null,null],"en":["Architecture ","Museums and art centers"],"it":["Architettura","Musei e centri artistici"],"cn":[null,null],"fr":["Architecture","Mus\u00e9es et art centers"],"sp":["Arquitectura","Museos y centros de arte"],"nl":["Architectuur","Musea en kunstcentra"]}}},"translations":{"de":{"name":"Inside Perspective","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/perspective.brussels\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.559307"},"pt":{"name":"Inside Perspective","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/perspective.brussels\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.559307"},"en":{"name":"Inside Perspective","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/perspective.brussels\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.559307"},"it":{"name":"Inside Perspective","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/perspective.brussels\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.559307"},"cn":{"name":"Inside Perspective","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/perspective.brussels\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.559307"},"fr":{"name":"Inside Perspective","shortdescr":"C\u2019est une premi\u00e8re ! L\u2019exposition \" Inside Perspective : Zoom sur nos m\u00e9tiers de la programmation urbaine \" vous invite \u00e0 d\u00e9couvrir de l\u2019int\u00e9rieur nos travaux et m\u00e9tiers \u00e0 travers sa programmation urbaine et les diff\u00e9rentes facettes du travail en \u00e9quipes.","longdescr":"C\u2019est une premi\u00e8re ! L\u2019exposition \" Inside Perspective : Zoom sur nos m\u00e9tiers de la programmation urbaine\" vous invite \u00e0 d\u00e9couvrir de l\u2019int\u00e9rieur nos travaux et m\u00e9tiers \u00e0 travers sa programmation urbaine et les diff\u00e9rentes facettes du travail en \u00e9quipes.\r\n\r\nPar un aper\u00e7u global de nos processus de travail, des outils de planification et au travers de plusieurs projets r\u00e9alis\u00e9s dans nos quartiers bruxellois, cette exposition  con\u00e7ue en interne souhaite mieux faire conna\u00eetre notre processus de travail de nos diff\u00e9rentes \u00e9quipes et des partenaires avec lesquels nous collaborons pour construire une R\u00e9gion en perp\u00e9tuelle \u00e9volution !\r\n\r\nAfin d\u2019offrir \u00e0 toutes et tous une vision compl\u00e8te et accessible de Perspective en tant qu'acteur central de la programmation urbaine, les \u00e9l\u00e9ments expos\u00e9s se basent sur notre processus de travail : petit passage en revue de l'analyse statistique et territoriale \u00e0 la programmation urbaine.\r\n\r\nEnvie de d\u00e9couvrir concr\u00e8tement comment votre quartier \u00e9volue ? La diff\u00e9rence entre un \u00ab CRU \u00bb et un \u00ab PAD \u00bb ? Ce qu\u2019est une occupation temporaire ou encore si Bruxelles est r\u00e9ellement l\u2019une des villes les plus vertes d\u2019Europe ? A travers des panneaux, maquettes, dessins, rendus, vid\u00e9os, cartes, interviews, photos, Perspective vous promet une plong\u00e9e au c\u0153ur de l\u2019am\u00e9nagement du territoire.\r\n\r\n- Vernissage le mardi 04.07 \u00e0 partir de 17:30.\r\n- Acc\u00e8s libre du lundi au vendredi de 8h30 \u00e0 16h30.","performers":null,"boxoffice_url":null,"website":"https:\/\/perspective.brussels\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.559307"},"sp":{"name":"Inside Perspective","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/perspective.brussels\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.559307"},"nl":{"name":"Inside Perspective","shortdescr":"Dit is een primeur! Kom naar de tentoonstelling \"Inside Perspective: Een kijkje op de beroepen van stedelijke programmering\" en ontdek van dichtbij wat wij doen, welke beroepen er zijn bij stedelijke programmering en welke facetten er verbonden zijn aan het werken in ons team!","longdescr":"Dit is een primeur! Kom naar de tentoonstelling \"Inside Perspective: Een kijkje op de beroepen van stedelijke programmering\" en ontdek van dichtbij wat wij doen, welke beroepen er zijn bij stedelijke programmering en welke facetten er verbonden zijn aan het werken in ons team!\r\n\r\nMet een overzicht van onze werkprocessen, planningstools en een aantal projecten die in onze Brusselse wijken zijn gerealiseerd, wil deze intern opgezette tentoonstelling een beter beeld schetsen van de werkprocessen met onze verschillende teams en de partners waarmee wij samen werken aan een Gewest dat voortdurend in ontwikkeling is!\r\n\r\nOm iedereen een zo volledig mogelijk beeld te geven van Perspective als centrale speler voor stedelijke programmering, vertrekt de tentoonstelling vanuit onze werkprocessen: een kort overzicht van de statistische en territoriale analyse bij stedelijke programmering.\r\n\r\nBenieuwd naar concrete veranderingen voor jouw buurt? Ken je het verschil tussen een \"SVC\" en een \"RPA\"? Tijdelijke bezetting, wat is dat? En is Brussel echt een van de groenste steden in Europa? Aan de hand van panelen, maquettes, (ontwerp)tekeningen, video's, kaarten, interviews en foto's dompelt Perspective je onder in de wereld van ruimtelijke ordening.\r\n\r\n- Opening op dinsdag 04.07 vanaf 17.30u.\r\n- Gratis toegang van maandag tot vrijdag, van 8.30 tot 16.30u.","performers":null,"boxoffice_url":null,"website":"https:\/\/perspective.brussels\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.559307"}},"place":{"id":275308,"translations":{"de":{"name":"perspective.brussels","address_street_name":"Rue de Namur 59  ","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur 59  ","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"so