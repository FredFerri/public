lse,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-09-21T02:01:57+02:00","published_at":"2024-08-27T15:37:08+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":306523,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"other","ranking":0.3236378653619318,"languages":{"spoken":["fr","nl"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[46,36],"translations":{"de":["Multidisziplin\u00e4r","Museen & Kunstzentren"],"pt":[null,null],"en":["Multidisciplinary","Museums and art centers"],"it":["Multidisciplinare","Musei e centri artistici"],"cn":[null,null],"fr":["Pluridisciplinaire","Mus\u00e9es et art centers"],"sp":["Multidisciplinar","Museos y centros de arte"],"nl":["Multidisciplinair","Musea en kunstcentra"]}}},"translations":{"de":{"name":"MoMuse - Mus\u00e9e Communal de Molenbeek Saint-Jean","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/momuse.be\/","email":"momuse@molenbeek.irisnet.be","phone_contact":"+32 2 412 08 12","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700000508"},"pt":{"name":"MoMuse - Mus\u00e9e Communal de Molenbeek Saint-Jean","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/momuse.be\/","email":"momuse@molenbeek.irisnet.be","phone_contact":"+32 2 412 08 12","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700000508"},"en":{"name":"MoMuse - Mus\u00e9e Communal de Molenbeek Saint-Jean","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/momuse.be\/","email":"momuse@molenbeek.irisnet.be","phone_contact":"+32 2 412 08 12","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700000508"},"it":{"name":"MoMuse - Mus\u00e9e Communal de Molenbeek Saint-Jean","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/momuse.be\/","email":"momuse@molenbeek.irisnet.be","phone_contact":"+32 2 412 08 12","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700000508"},"cn":{"name":"MoMuse - Mus\u00e9e Communal de Molenbeek Saint-Jean","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/momuse.be\/","email":"momuse@molenbeek.irisnet.be","phone_contact":"+32 2 412 08 12","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700000508"},"fr":{"name":"MoMuse - Mus\u00e9e Communal de Molenbeek Saint-Jean","shortdescr":"Du village issu du Moyen-\u00c2ge \u00e0 la ville d\u2019aujourd\u2019hui, le MoMuse propose un voyage haut en couleurs \u00e0 travers Molenbeek-Saint-Jean","longdescr":"Du village issu du Moyen-\u00c2ge \u00e0 la ville d\u2019aujourd\u2019hui, le MoMuse propose un voyage haut en couleurs \u00e0 travers Molenbeek-Saint-Jean. D\u00e9couvrez comment ont \u00e9volu\u00e9 le territoire et la population, les conditions de logement et l\u2019\u00e9conomie, l\u2019enseignement et les diff\u00e9rentes fa\u00e7ons de vivre ensemble. En bref, nous vous faisons vivre les petites histoires de la commune qui s\u2019imbriquent dans la Grande Histoire !\nCe qu\u2019on y d\u00e9couvre ? Tout un tas de choses !\nVous saviez que le p\u00e8re d\u2019Ang\u00e8le venait de Molenbeek ? Que les trams \u00e9taient tir\u00e9s par des chevaux ? Que des vestiges arch\u00e9ologiques ont \u00e9t\u00e9 retrouv\u00e9s dans la commune. \n\nCet automne, faites le plein d\u2019aventures au MoMuse, avec :\n-\tLes 22 septembre et 21 octobre : une balade litt\u00e9raire au c\u0153ur de Molenbeek\n-\tDu 27 septembre au 7 novembre : une exposition textile au mus\u00e9e : la Maille des Femmes\n-\tLes 2 ou 3 novembre : suivez une visite insolite au Cimeti\u00e8re Communal\n\nLe MoMuse ouvre ses portes \u00e0 toute personne souhaitant nous rendre visite, mais aussi des groupes (scolaire, ASBL, primo-arrivants, PMR,..), avec la possibilit\u00e9 d\u2019adapter la visite en fonction d\u2019une th\u00e9matique ou de son public.\n\nVous souhaitez r\u00e9server une visite guid\u00e9e du mus\u00e9e ? Rien de plus simple ! Contactez et retrouvez-nous par t\u00e9l\u00e9phone (02 412 08 12) ou par mail (momuse@molenbeek.irisnet.be).\nAcc\u00e8s facile par :\nEn m\u00e9tro\/tram :\n-\tComte de Fandre\n-\tRibaucourt\n-\t\u00c9tangs Noirs\nEn voiture :\n-\tParking Brunfaut \u2013 rue Fernand Brunfaut (gratuit)\n\nNous sommes ouverts mardi, mercredi et jeudi, de 12h00 \u00e0 17h00 et dimanche, de 13h00 \u00e0 18h00.\nPour plus d\u2019informations, n\u2019h\u00e9sitez pas \u00e0 vous rendre sur notre site : www.momuse.be. Suivez toutes nos incroyables aventures sur Instagram  et sur Facebook (MoMuse1080) !\n\n\u00c0 tr\u00e8s bient\u00f4t, au MoMuse !\n","performers":null,"boxoffice_url":null,"website":"https:\/\/momuse.be\/","email":"momuse@molenbeek.irisnet.be","phone_contact":"+32 2 412 08 12","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700000508"},"sp":{"name":"MoMuse - Mus\u00e9e Communal de Molenbeek Saint-Jean","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/momuse.be\/","email":"momuse@molenbeek.irisnet.be","phone_contact":"+32 2 412 08 12","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700000508"},"nl":{"name":"MoMuse - Mus\u00e9e Communal de Molenbeek Saint-Jean","shortdescr":"Van het dorp uit de middeleeuwen tot de stad van vandaag biedt MoMuse een kleurrijke reis door Sint-Jans-Molenbeek","longdescr":"Van het dorp uit de middeleeuwen tot de stad van vandaag biedt MoMuse een kleurrijke reis door Sint-Jans-Molenbeek. Ontdek hoe het grondgebied en zijn bevolking, de woonomstandigheden en de economie, het onderwijs en de verschillende manieren van samenleven evolueerden. Via kleine verhalen nemen we je mee in de Grotere Geschiedenis van de gemeente waarmee ze zijn verweven!\nWat ontdek je? Een heleboel dingen!\nWist je dat de vader van Ang\u00e8le uit Molenbeek kwam? Dat trams door paarden werden getrokken? Dat er archeologische resten zijn gevonden in de gemeente.\n\nDeze herfst kun je avonturen beleven in MoMuse, met :\n-\t22 september en 21 oktober: een literaire wandeling door het hart van Molenbeek\n-\tVan 27 september tot 7 november: een textieltentoonstelling in het museum: Vrouwenbreiwerk\n-\t2 of 3 november: een ongewone rondleiding op de Gemeentelijke Begraafplaats\n\nMoMuse opent zijn deuren voor iedereen die ons wil bezoeken, maar ook voor groepen (scholen, vzw's, nieuwkomers, personen met beperkte mobiliteit...), met de mogelijkheid om het bezoek aan te passen aan een bepaald thema of publiek.\n\nWil je een rondleiding door het museum boeken? Makkelijker kan het niet! Contacteer ons per telefoon (02 412 08 12) of per e-mail (momuse@molenbeek.irisnet.be).\nGemakkelijk bereikbaar:\nMet de metro\/tram :\n-\tGraaf van Vlaanderen\n-\tRibaucourt\n-\tZwarte Vijvers\nMet de wagen:\n-\tParking Brunfaut \u2013Fernand Brunfautstraat (gratis)\nWe zijn open op dinsdag, woensdag en donderdag van 12u00 tot 17u00 en op zondag van 13u00 tot 18u00.\n\nGa voor meer informatie naar onze website: www.momuse.be. Volg al onze ongelofelijke avonturen op Instagram en Facebook (MoMuse1080)!\n\nTot zeer binnenkort bij MoMuse!\n","performers":null,"boxoffice_url":null,"website":"https:\/\/momuse.be\/","email":"momuse@molenbeek.irisnet.be","phone_contact":"+32 2 412 08 12","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700000508"}},"place":{"id":270182,"translations":{"de":{"name":"MoMuse - Mus\u00e9e communal de Molenbeek Saint-Jean","address_street_name":"rue Mommaerts ","address_street_number":"2A  ","address_street_box":null,"email":"momuse@molenbeek.irisnet.be","website":"http:\/\/www.momuse.be","phone_contact":"+32 2 412 08 12","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue Mommaerts , 2A  ","address_line2":"1080 Molenbeek-Saint-Jean","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"MoMuse - Mus\u00e9e communal de Molenbeek Saint-Jean","address_street_name":"rue Mommaerts ","address_street_number":"2A  ","address_street_box":null,"email":"momuse@molenbeek.irisnet.be","website":"http:\/\/www.momuse.be","phone_contact":"+32 2 412 08 12","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue Mommaerts , 2A  ","address_line2":"1080 Molenbeek-Saint-Jean","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Municipal Museum of Molenbeek Saint-Jean","address_street_name":"rue Mommaerts ","address_street_number":"2A  ","address_street_box":null,"email":"momuse@molenbeek.irisnet.be","website":"http:\/\/www.momuse.be","phone_contact":"+32 2 412 08 12","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue Mommaerts , 2A  ","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"The MoMuse exhibits the historical heritage of Molenbeek, from its origins to the present day, with a special emphasis on the 19th and 20th centuries. This small territory of some 6km\u00b2, has evolved over many centuries. From humble rural beginnings, it experienced an intense industrialisation in the 1840s, followed by a deindustrialisation not without consequences, and finally, at the dawn of the 1960s, an intense urban growth. All these events have profoundly changed the way of life, and essence of the commune.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"MoMuse - Mus\u00e9e communal de Molenbeek Saint-Jean","address_street_name":"rue Mommaerts ","address_street_number":"2A  ","address_street_box":null,"email":"momuse@molenbeek.irisnet.be","website":"http:\/\/www.momuse.be","phone_contact":"+32 2 412 08 12","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue Mommaerts , 2A  ","address_line2":"1080 Molenbeek-Saint-Jean","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"MoMuse - Mus\u00e9e communal de Molenbeek Saint-Jean","address_street_name":"rue Mommaerts ","address_street_number":"2A  ","address_street_box":null,"email":"momuse@molenbeek.irisnet.be","website":"http:\/\/www.momuse.be","phone_contact":"+32 2 412 08 12","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue Mommaerts , 2A  ","address_line2":"1080 Molenbeek-Saint-Jean","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"MoMuse - Mus\u00e9e communal de Molenbeek Saint-Jean","address_street_name":"rue Mommaerts ","address_street_number":"2A  ","address_street_box":null,"email":"momuse@molenbeek.irisnet.be","website":"http:\/\/www.momuse.be","phone_contact":"+32 2 412 08 12","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue Mommaerts , 2A  ","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"Une commune, c\u2019est avant tout une histoire. Et celle de Molenbeek est loin d\u2019\u00eatre anodine. Le MoMuse est une vitrine du patrimoine historique de la commune, depuis ses origines jusqu\u2019\u00e0 aujourd\u2019hui, avec un accent tout particulier mis sur les XIXe et XXe si\u00e8cles. Le mus\u00e9e permettra aux visiteurs de comprendre l\u2019\u00e9volution de ce petit territoire de quelques 6km2, ayant d\u2019abord connu un d\u00e9veloppement rural durant de nombreux si\u00e8cles, puis une industrialisation intense \u00e0 partir des ann\u00e9es 1840, suivie d\u2019une d\u00e9sindustrialisation non sans cons\u00e9quences, et enfin, \u00e0 l\u2019aube des ann\u00e9es 1960, une croissance urbanistique intense. Autant d\u2019\u00e9v\u00e9nements qui ont profond\u00e9ment modifi\u00e9 les modes de vie et l\u2019essence m\u00eame de la commune.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"MoMuse - Mus\u00e9e communal de Molenbeek Saint-Jean","address_street_name":"rue Mommaerts ","address_street_number":"2A  ","address_street_box":null,"email":"momuse@molenbeek.irisnet.be","website":"http:\/\/www.momuse.be","phone_contact":"+32 2 412 08 12","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue Mommaerts , 2A  ","address_line2":"1080 Molenbeek-Saint-Jean","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"MoMuse - Gemeentelijk Museum van Sint-Jans Molenbeek","address_street_name":"Mommaertsstraat ","address_street_number":"2A  ","address_street_box":null,"email":"momuse@molenbeek.irisnet.be","website":"http:\/\/www.momuse.be","phone_contact":"+32 2 412 08 12","phone_booking":null,"address_zip":"1080","address_city":"Sint-Jans-Molenbeek","address_line1":"Mommaertsstraat , 2A  ","address_line2":"1080 Sint-Jans-Molenbeek","description_web":"De geschiedenis van de gemeente Sint-Jans-Molenbeek is verre van triviaal. Het MoMuse exposeert het historische erfgoed van de gemeente, vanaf zijn ontstaan tot nu, met speciale nadruk op de negentiende en twintigste eeuw. De bezoekers zullen de evolutie doorlopen van dit kleine grondgebied van ongeveer 6 km2, die begint met een eeuwenlange plattelandsontwikkeling, dan een intense industrialisatie vanaf de jaren 1840, gevolgd door een afbouw van de industrialisatie die niet zonder gevolgen is gebleven, en tenslotte, aan het begin van de jaren zestig, een intense stedelijke groei. Al deze gebeurtenissen hebben de levenswijze en de essentie zelve van de gemeente grondig veranderd.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[8],"translations":{"de":["Kanal-Viertel"],"pt":[null],"en":["Canal"],"it":["Canal"],"cn":[null],"fr":["Canal"],"sp":["Canal"],"nl":["Kanaalwijk"]}},"zones":{"list":[23],"translations":{"de":["Westen"],"pt":[null],"en":["West"],"it":["Ovest"],"cn":[null],"fr":["Ouest"],"sp":["Oeste"],"nl":["West"]}},"neca":null,"facebook_id":null,"backoffice_id":30182,"location":{"lat":50.85738825,"lon":4.33784505},"region":"brussels","last_updated_at":"2023-10-25T09:28:08+02:00","published_at":"2017-10-16T15:14:36+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":243578,"translations":{"de":{"name":"Maison des Cultures et de la coh\u00e9sion sociale de Molenbeek (MCCS)","address_street_name":"Rue Mommaerts","address_street_number":"4","address_street_box":null,"email":"culture.1080@molenbeek.irisnet.be","website":"http:\/\/www.lamaison1080hethuis.be","phone_contact":"+32 2 415 86 03","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Rue Mommaerts, 4","address_line2":"1080 Molenbeek-Saint-Jean","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Maison des Cultures et de la coh\u00e9sion sociale de Molenbeek (MCCS)","address_street_name":"Rue Mommaerts","address_street_number":"4","address_street_box":null,"email":"