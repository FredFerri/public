27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[24,27],"translations":{"fr":["Galeries d'art","Photographie"],"nl":["Galeries","Fotografie"],"en":["Art Galleries","Photography"]}}},"languages":{"spoken":["fr","en"],"subtitles":[]},"translations":{"fr":{"name":"Lancement du livre Paradis de Oriane Thomasson","shortdescr":"Lancement du livre Paradis de Oriane Thomasson au Tipi bookshop en pr\u00e9sence de l'artiste.","longdescr":"Nous avon le plaisir de vous inviter \u00e0 d\u00e9couvrir le livre Paradis d'Oriane Thomasson le 29 Septembre 2022 \u00e0 partir de 18h30 au Tipi bookshop.\r\nD\u00e9j\u00e0 en r\u00e9servation sur le site du Tipi:\r\nhttps:\/\/www.tipi-bookshop.be\/...\/paradis-by-oriane-thomasson\r\n\"Inspir\u00e9e par la notion de cabinet de curiosit\u00e9s \u2013 ou de la Wunderkammer, Oriane Thomasson a cr\u00e9\u00e9 Paradis, o\u00f9 la science et l'art, naturel et artificiel, se conjuguent pour produire une nouvelle fiction.\r\nCette collection est une mosa\u00efque de travaux photographiques et de documents d'archives.\r\nDes images qu'elle a r\u00e9alis\u00e9es lors de ses voyages en Extr\u00eame-Orient, avec des illustrations botaniques et min\u00e9ralogiques.\r\nEntre les images, il y a un texte fictif dans lequel le lecteur est conduit vers une terre inconnue, comme un explorateur d\u00e9couvrant des terres myst\u00e9rieuses et inconnues.\r\nParadis est une invitation \u00e0 red\u00e9couvrir la capacit\u00e9 de la nature \u00e0 nous faire imaginer, r\u00eaver et construire de nouvelles histoires.\"","performers":"Oriane Thomasson, tipi bookshop","boxoffice_url":null,"website":"http:\/\/tipi-bookshop.be","email":"ti