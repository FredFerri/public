sie van de plek weerspiegelen.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":14176,"location":{"lat":50.83028735,"lon":4.33675871},"is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/db5e9c8e45169f50e0287929f60ab0636a493d04.png","width":998,"height":1410,"ratio":0.71,"oEmbed_height":1410,"oEmbed_width":998,"translations":{"de":{"title":"Kundalini Yoga","copyright":null},"pt":{"title":"Kundalini Yoga","copyright":null},"en":{"title":"Kundalini Yoga","copyright":null},"it":{"title":"Kundalini Yoga","copyright":null},"cn":{"title":"Kundalini Yoga","copyright":null},"fr":{"title":"Kundalini Yoga","copyright":null},"sp":{"title":"Kundalini Yoga","copyright":null},"nl":{"title":"Kundalini Yoga","copyright":null}}}],"dates":[{"day":"2024-01-29","doors":null,"start":"18:45:00","end":"20:15:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-02-05","doors":null,"start":"18:45:00","end":"20:15:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-02-12","doors":null,"start":"18:45:00","end":"20:15:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-02-19","doors":null,"start":"18:45:00","end":"20:15:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-02-26","doors":null,"start":"18:45:00","end":"20:15:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-03-04","doors":null,"start":"18:45:00","end":"20:15:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-03-11","doors":null,"start":"18:45:00","end":"20:15:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-03-18","doors":null,"start":"18:45:00","end":"20:15:00","end_night_life":null,"is_soldout":f