0:00","end":null,"end_night_life":null,"is_soldout":false,"is_canceled":false}],"prices":[],"date_exceptions":[],"closing_days":[],"child_events":[],"parent_events":[],"accessibilities":[],"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[]},{"id":5700002769,"date_start":"2024-10-29","date_end":"2024-10-29","date_next":"2024-10-29","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-10-18T15:22:03+02:00","published_at":"2024-10-18T15:16:21+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":310054,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"other","ranking":1.2599210498948732,"languages":{"spoken":["en","nl","fr"],"subtitles":[]},"categories":{"main":{"id":90,"translations":{"de":"Animationen","pt":null,"en":"Animations","it":"Animazioni","cn":null,"fr":"Animations","sp":"Animaciones","nl":"Animaties"}},"others":{"list":[95],"translations":{"de":["Kulturerbe"],"pt":[null],"en":["Heritage"],"it":["Patrimonio culturale"],"cn":[null],"fr":["Patrimoine"],"sp":["Patrimonio"],"nl":["Erfgoed"]}}},"translations":{"de":{"name":"Journ\u00e9e familles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.trainworld.be\/fr\/journee-familles-2024","email":"info@trainworld.be","phone_contact":"+32 2 224 74 37","phone_booking":"+32 2 224 74 37","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700002769"},"pt":{"name":"Journ\u00e9e familles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.trainworld.be\/fr\/journee-familles-2024","email":"info@trainworld.be","phone_contact":"+32 2 224 74 37","phone_booking":"+32 2 224 74 37","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700002769"},"en":{"name":"Family day","shortdescr":"Family Day 2024\nOn Tuesday 29 October, we will host our family day again! We will provide plenty of fun activities for\nthe whole family. The perfect time to get to know Train World and guaranteed to be a fun outing for\nyoung and old alike.","longdescr":"Family Day 2024\nOn Tuesday 29 October, we will host our family day again! We will provide plenty of fun activities for\nthe whole family. The perfect time to get to know Train World and guaranteed to be a fun outing for\nyoung and old alike.\n\nWhat's on the agenda?\n\nRunning continuously from 10am to 5pm (last hunt starts at 3.30pm)\n\n\u00b7 Family activity \"The Sultan's diamond\"\nAvailable in Dutch, French and Flemish sign language and sign language for French speakers\n\u00b7 Family activity \"Draw me a train\" as part of our temporary exhibition. Through five playful\ntables, you will discover the work of artists like Andr\u00e9 Franquin, Fran\u00e7ois Schuiten and Paul\nDelvaux. During the visit you will be able to make your own SNCB-logo.\nAccessible to families with people with visual impairment using audio description.\n\u00b7 Take a photo with our Train World hosts at your favourite carriage or locomotive (new\nbuilding).\n\u00b7 Get made up during our make-up workshop (Large Ticket Hall)\nFrom 10 til 12 pm and from 1 til 3.3 am.\n\u00b7 Play installation for toddlers The Toddler Train (Hall 4)\nOngoing\n\u00b7 Craft workshop \"Make your own Train World badge\u201d (Hall 4)\nOngoing\nBespoke programme\n\u00b7 Reading nook for 4-10-year-olds (Hall 3, near the small hause)\nOur museum staff love reading aloud. Settle in, take a seat and dream away.\nDuration+- 15 minutes\nAt 11 am and 2.30 pm in Dutch\nAt 11.30 am and 3 pm in French\nIn collaboration with the Schaerbeek libraries.\n\u00b7 On a train journey with a mime (new building)\nA mime show lasts 30 minutes\n\nat 1.30 pm (hall 1), 1 pm (hall 2), 2.30 pm (hall 3), 3 pm (hall 4), 3.30pm (hall 2), 4 pm (hall 3)\nand 4.30 pm (hall 4).\nOur young visitors also receive a lovely souvenir at the end of the visit.\nAll activities are included in the museum entrance fee.\nAnd don't forget to share your best moments by tagging us and mentioning #TrainWorldFamily.\n\nPractical information\nWhen\nTuesday 29 October, from 10 am to 5 pm. Last admission: 3.30pm.\nFor whom?\nFor the whole family\nPrice\nStandard museum price\n","performers":null,"boxoffice_url":null,"website":"https:\/\/www.trainworld.be\/en\/family-day-2024","email":"info@trainworld.be","phone_contact":"+32 2 224 74 37","phone_booking":"+32 2 224 74 37","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700002769"},"it":{"name":"Journ\u00e9e familles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.trainworld.be\/fr\/journee-familles-2024","email":"info@trainworld.be","phone_contact":"+32 2 224 74 37","phone_booking":"+32 2 224 74 37","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700002769"},"cn":{"name":"Journ\u00e9e familles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.trainworld.be\/fr\/journee-familles-2024","email":"info@trainworld.be","phone_contact":"+32 2 224 74 37","phone_booking":"+32 2 224 74 37","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700002769"},"fr":{"name":"Journ\u00e9e familles","shortdescr":"Journ\u00e9e familles 2024\nLe mardi 29 octobre, c\u2019est la \"Journ\u00e9e Familles\" de Train World ! Venez d\u00e9couvrir notre fabuleux\nmus\u00e9e pendant cette journ\u00e9e remplie d'activit\u00e9s amusantes pour petits et grands. Ce sera un\nagr\u00e9able moment \u00e0 partager en famille.","longdescr":"Quel sera le programme ?\nActivit\u00e9s en continue de 10 \u00e0 17h00 (derni\u00e8re entr\u00e9e \u00e0 15h30)\u00a0\n\uf0b7 Jeu famille :\u00a0\"\u00c0 la recherche du diamant du sultan\"\ndisponible en fran\u00e7ais, n\u00e9erlandais, langue des signes FR\/NL de Belgique via votre\nsmartphone.\n\uf0b7 Parcours famille : \u00ab\u00a0dessine-moi un train\u00a0\u00bb con\u00e7u sp\u00e9cialement pour notre exposition. Gr\u00e2ce\n\u00e0 la d\u00e9couverte de cinq tables ludiques vous d\u00e9couvrez l\u2019\u0153uvre d\u2019artistes comme Andr\u00e9\nFranquin, Fran\u00e7ois Schuiten et Paul Delvaux. Un exemple d\u2019activit\u00e9 est la cr\u00e9ation de votre\npropre logo SNCB.\nAccessible pour les familles avec un membre en situation de handicap visuel gr\u00e2ce \u00e0\nl\u2019audiodescription.\n\uf0b7 Shooting photo avec nos Train World hosts \u00e0 c\u00f4t\u00e9 ta voiture ou ton locomotive pr\u00e9f\u00e9r\u00e9.e\n(nouveau b\u00e2timent).\n\uf0b7 Atelier de grimage (Salle des Pas Perdus)\nDe 10 \u00e0 12h et de 13 \u00e0 15h30.\n\uf0b7 Les plus petits sont invit\u00e9s \u00e0 monter \u00e0 bord de notre installation ludique Le Train des Petits\ndans hall 4.\nEn continu\n\uf0b7 Atelier bricolage\u00a0: Fabrique ton propre badge de Train World\u00a0(hall 4)\nEn continu\nActivit\u00e9s avec horaire sp\u00e9cifique\u00a0:\n\uf0b7 Coin lecture d\u2019histoires pour les enfants de 4 \u00e0 10 ans (hall 3, dans les environs de la maison)\no Dur\u00e9e +- 15 minutes.\n\u00c0 11h30 et 15h en fran\u00e7ais\n\u00c0 11h, et 14h30 en n\u00e9erlandais\nEn collaboration avec la biblioth\u00e8que de Schaerbeek.\n\uf0b7 Le mime qui voyage en train\u00a0(dans le nouveau b\u00e2timent)\nDur\u00e9e 30 minutes\n\u00e0 13h30 (hall 1),\u00a014h (hall 2), 14h30 (hall 3), 15h (hall 4), 15h30 (hall 2), 16h (hall 3) 16h30\n(hall 4).\nNos jeunes visiteurs recevront \u00e9galement une petite surprise \u00e0 la fin de leur visite !\n\nToutes les activit\u00e9s sont gratuites \u00e0 l\u2019achat du ticket d\u2019entr\u00e9e.\nPartagez vos plus beaux moments de la journ\u00e9e via le #TrainWorldFamily.\n\nInformations pratiques\nQuand ?\nMardi 29 octobre 2024, de 10h00 \u00e0 17h00. Derni\u00e8re entr\u00e9e \u00e0 15h30.\nPour qui ?\nPour toute la famille.\nPrix\nEntr\u00e9e au mus\u00e9e aux\u00a0tarifs habituels.\nR\u00e9servez vos tickets sur le\u00a0webshop\u00a0de Train World. ","performers":null,"boxoffice_url":null,"website":"https:\/\/www.trainworld.be\/fr\/journee-familles-2024","email":"info@trainworld.be","phone_contact":"+32 2 224 74 37","phone_booking":"+32 2 224 74 37","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700002769"},"sp":{"name":"Journ\u00e9e familles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.trainworld.be\/fr\/journee-familles-2024","email":"info@trainworld.be","phone_contact":"+32 2 224 74 37","phone_booking":"+32 2 224 74 37","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700002769"},"nl":{"name":"Familiedag","shortdescr":"Familiedag 2024\nOp dinsdag 29 oktober organiseren we weer onze familiedag! We voorzien tal van leuke activiteiten\nvoor het ganse gezin. Een uitgelezen moment om Train World te leren kennen en gegarandeerd een\nleuke uitstap voor jong en oud.","longdescr":"Familiedag 2024\nOp dinsdag 29 oktober organiseren we weer onze familiedag! We voorzien tal van leuke activiteiten\nvoor het ganse gezin. Een uitgelezen moment om Train World te leren kennen en gegarandeerd een\nleuke uitstap voor jong en oud.\nWat staat er allemaal op het programma?\nDoorlopend van 10u00 tot 17u00 (de laatste zoektocht start om 15u30)\n\uf0b7 Familieactiviteit \"Van schets tot trein\"\u00a0in het kader van onze tijdelijke tentoonstelling. Aan\nde hand van vijf speelse tafels ga je aan de slag met het werk van kunstenaars als Andr\u00e9\nFranquin, Fran\u00e7ois Schuiten en Paul Delvaux. Tijdens het bezoek maak je jouw eigen NMBS\nlogo.\nToegankelijk voor gezinnen met mensen met een visuele beperking dankzij audiodescriptie.\n\uf0b7 Familieactiviteit \"Op zoek naar de diamant van de sultan\"\nBeschikbaar in het Nederlands, Frans en Vlaamse gebarentaal en gebarentaal voor\nFranstaligen met je smartphone\n\uf0b7 Neem een foto met onze Train World hosts bij jouw favoriete rijtuig of locomotief\n(nieuwbouw).\n\uf0b7 Schminkworkshop (Grote Lokettenzaal).\nVan 10u tot 12u en van 13u tot 15u30.\n\uf0b7 Speelinstallatie voor de allerkleinsten: De Peutertrein\u00a0(hal 4)\n\uf0b7 Knutselatelier \u201cMaak je eigen badge van Train World\u201d (hal 4)\nDoorlopend\nSpecifiek programma\n\uf0b7 Voorleeshoek voor 4 tot 10-jarigen (hal 3, in de buurt van het huisje) \u00a0\nOnze museummedewerkers lezen graag voor. Kom af, zet je neer en droom weg.\nDuur +- 15 minuten\nOm 11u, en 14u30 in het Nederlands\nOm 11u30 en 15u in het Frans\nIn samenwerking met de bibliotheken van Schaarbeek.\n\uf0b7 Met mime op treinreis (in de nieuwbouw)\nElke 30 minuten is er een mimetoneel\nOm 13u30 (hal 1), 14u (hal 2), 14u30 (hal 3), 15u (hal 4), 15u30 (hal 2), 16u (hal 3), 16u30\n(hal 4).\n\nOnze jonge bezoekers krijgen op het einde van het bezoek ook nog een leuk aandenken mee.\nAlle activiteiten zijn inbegrepen in de toegangsprijs van het museum.\n\nEn vergeet niet je mooiste momenten te delen door ons te taggen en #TrainWorldFamily te\nvermelden.\u00a0\n\nPraktische informatie\nWanneer\nDinsdag 29 oktober 2024 van 10u00 tot 17u00. Laatste toegang om 15u30.\nVoor wie\nVoor de hele familie\nPrijs\nStandaard museumprijs\n","performers":null,"boxoffice_url":null,"website":"https:\/\/www.trainworld.be\/nl\/familiedag-2024","email":"info@trainworld.be","phone_contact":"+32 2 224 74 37","phone_booking":"+32 2 224 74 37","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700002769"}},"place":{"id":252663,"translations":{"de":{"name":"Train World","address_street_name":"Place Princesse Elisabeth","address_street_number":"5","address_street_box":null,"email":"info@trainworld.be","website":"http:\/\/www.trainworld.be","phone_contact":"+32 490 47 94 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Place Princesse Elisabeth, 5","address_line2":"1030 Schaerbeek","description_web":"N\u00e4chste Haltestelle Train World... kleine und gro\u00dfe Eisenbahnfreunde erwartet in Br\u00fcssel ein neues \u201eMekka\": In dem historischen Geb\u00e4ude des ehemaligen Bahnhofs von Schaerbeek erwartet Sie das spektakul\u00e4re Eisenbahnmuseum Train World, dessen Szenographie aus der Feder des belgischen Comic-K\u00fcnstlers Fran\u00e7ois Schuiten stammt.\r\n\r\nSch\u00e4tze aus der Welt der Eisenbahn: Von der \u00e4ltesten Dampflokomotive Belgiens \u00fcber prunkvolle k\u00f6nigliche Wagons bis hin zu den modernen Hochgeschwindigkeitsz\u00fcgen - Train World f\u00fchrt die Besucher durch die belgische Eisenbahngeschichte. Neben historischem und technischem Wissen gibt es auch Anekdoten und Kuriosit\u00e4ten aus der Welt der Eisenbahn zu entdecken. Wie ist eine Schiene aufgebaut, wie schnell fuhren die ersten Dampfloks, wie reisten einst die K\u00f6nige? Antworten auf all diese Fragen geben die Erkl\u00e4rungstafeln, die auch auf Deutsch zur Verf\u00fcgung stehen, sowie die kostenlosen Audioguides (ebenfalls auf Deutsch).\r\n\r\nFahrsimulator: Sie haben schon immer davon getr\u00e4umt, Lokomotivf\u00fchrer zu werden? Dann nehmen Sie Platz im F\u00fchrerstand des Fahrsimulators und begeben sich auf eine Reise durch die Eisenbahngeschichte.\r\n\r\nLeibliches Wohl:\r\n\r\nIn der Brasserie \"RN Express\", die in dem historischen Bahnhofsgeb\u00e4ude untergebracht ist, gibt es Speisen und Getr\u00e4nke. Tiefblaue W\u00e4nde, gl\u00e4serne Kugellampen und Holzmobiliar sorgen f\u00fcr ein besonderes Ambiente.\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Train World","address_street_name":"Place Princesse Elisabeth","address_street_number":"5","address_street_box":null,"email":"info@trainworld.be","website":"http:\/\/www.trainworld.be","phone_contact":"+32 490 47 94 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Place Princesse Elisabeth, 5","address_line2":"1030 Schaerbeek","description_web":"Train World, o novo polo de atra\u00e7\u00e3o de Bruxelas\r\nTrain World, a montra dos caminhos de ferro de ontem, de hoje e de amanh\u00e3, \u00e9 a nova atra\u00e7\u00e3o tur\u00edstica de Bruxelas desde setembro de 2015. O local situa-se em Schaerbeek, a alguns minutos de comboio da Esta\u00e7\u00e3o Central (pr\u00f3ximo da Grand-Place).\r\nN\u00e3o est\u00e3o a\u00ed expostas apenas as pe\u00e7as mais belas da cole\u00e7\u00e3o de locomotivas e de ve\u00edculos hist\u00f3ricos dos caminhos de ferro belgas, mas tamb\u00e9m \u00e9 ilustrado o papel importante do comboio na mobilidade atual e do futuro. Train World \u00e9 mais do que um museu, trata-se de um centro de interpreta\u00e7\u00e3o. A cenografia original \u2013 desenvolvida pelo artista Fran\u00e7ois Schuiten- cria uma experi\u00eancia interativa durante a qual o p\u00fablico pode olhar, ouvir, tocar e deixar-se surpreender por hist\u00f3rias apaixonantes do mundo ferrovi\u00e1rio.\r\nO local, situado ao longo do tra\u00e7ado da primeira linha de caminhos de ferro do continente europeu (Bruxelas\u2013Mechelen, 1835), inclui a esta\u00e7\u00e3o renovada de Schaerbeek, onde se encontra a bilheteira, e uma constru\u00e7\u00e3o nova de 8000 m\u00b2. Note-se que a esta\u00e7\u00e3o, constru\u00edda em 1887, \u00e9 um dos baluartes da arquitetura ferrovi\u00e1ria belga e um monumento classificado. Um estabelecimento de hoteleira e restaura\u00e7\u00e3o situado na esta\u00e7\u00e3o completa a oferta de Train World.\r\nUma oferta muito diversificada destinada a todo o mundo\r\nTrain World aloja in\u00fameros tesouros a descobrir. Por exemplo, \u00e9 poss\u00edvel a\u00ed admirar a locomotiva a vapor mais antiga mantida na B\u00e9lgica, a \u201cPa\u00eds de Waes\u201d. Ou ainda a locomotiva a vapor de carenagem \u201ctipo 12\u201d, que estabeleceu um novo recorde de velocidade em 1939. Tamb\u00e9m \u00e9 poss\u00edvel contemplar aut\u00eanticos e sumptuosos ve\u00edculos reais ou penetrar um dos ve\u00edculos TEE inox, antecessor dos comboios de grande velocidade, que percorriam a Europa na \u00e9poca. Com vontade de assumir o comando de um comboio?\r\nPoder\u00e1 experiment\u00e1-lo, num simulador de condu\u00e7\u00e3o. No lugar do condutor, poder\u00e1 observar as mudan\u00e7as no ambiente das linhas ao longo dos anos.\r\nTrain World apresenta igualmente centenas de objetos do mundo ferrovi\u00e1rio, como uniformes, pinturas ou maquetas de comboios e de esta\u00e7\u00f5es, assim como in\u00fameras fotos e videoclipes. A notar igualmente: a apresenta\u00e7\u00e3o de uma aut\u00eantica casinha de guarda das passagens de n\u00edvel, retomada na nova constru\u00e7\u00e3o de Train World. Estar\u00e1 mobilada com uma decora\u00e7\u00e3o dos anos 50. No s\u00f3t\u00e3o, ser\u00e3o expostos comboios miniatura.\r\nAs escolas e as fam\u00edlias com crian\u00e7as pequenas poder\u00e3o aproveitar uma oferta espec\u00edfica que acentua tanto o aspeto educativo como o l\u00fadico. As crian\u00e7as poder\u00e3o dar espa\u00e7o \u00e0 sua alegria num espa\u00e7o de jogos, como m\u00ednimo, original, especialmente concebido para elas: uma locomotiva a vapor que emerge do solo.\r\nGra\u00e7as \u00e0 colabora\u00e7\u00e3o com os construtores de comboios, as tecnologias modernas e os desenvolvimentos futuros ser\u00e3o tamb\u00e9m abordados. Desse modo, o p\u00fablico poder\u00e1 admirar, por exemplo, tr\u00eas comboios de \u00faltima gera\u00e7\u00e3o.\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Train World","address_street_name":"Prinses Elisabethplein","address_street_number":"5","address_street_box":null,"email":"b2b@trainworld.be","website":"http:\/\/www.trainworld.be","phone_contact":"+32 490 47 94 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Prinses Elisabethplein, 5","address_line2":"1030 Schaerbeek","description_web":"Train World is a unique railway experience that takes you from the very first steam locomotives to the flashing high-speed trains! It is a universe that appeals to all the senses in order to grasp the many different dimensions of the railways. A visit to Train World is an active and surprising outing. You can walk among locomotives, take a seat in 100-year-old trains, visit a railway house and walk across a real railway bridge. You will even experience how it feels to drive a train!\r\n\r\n\r\n","description_print":"Train World, the showcase for the railways of yesterday, today and tomorrow, is a must-see tourist attraction in Brussels. The site is located a few minutes by train from Brussels Central station (near the Grand Place)\r\nHere you will be able to admire the loveliest pieces from the collection of historical locomotives and carriages from the Belgian railways, but it will also illustrate the significant role of the train in the mobility of today and in future. Train World is more than a museum: it will be an experience centre. An original scenography \u2013 designed by artist Fran\u00e7ois Schuiten \u2013 will provide an experience in which the audience can look, listen, touch and be surprised by scintillating stories from the world of trains.\r\nThe site comprises the renovated Schaerbeek station, where the ticket office is located, and a new 8,000 m\u00b2 building. A restaurant and a book & gift shop in the station completes the offering. It will also be possible to have a picnic: a restored carriage will be available in the transit area from the station to the new building for this purpose.\r\n","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Train World","address_street_name":"Place Princesse Elisabeth","address_street_number":"5","address_street_box":null,"email":"info@trainworld.be","website":"http:\/\/www.trainworld.be","phone_contact":"+32 490 47 94 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Place Princesse Elisabeth, 5","address_line2":"1030 Schaerbeek","description_web":"Train World. Il museo nazionale del treno aprir\u00e0 le porte alla stazione di Schaerbeek.\r\nTesori del mondo ferroviario\r\nTrain World custodir\u00e0 numerosi tesori: la pi\u00f9 antica locomotiva conservata in Belgio, la \u201cpaese di Waes\u201d, o la locomotive a vapore carenata \u201ctipo 12\u201d che aveva stabilito un record di velocit\u00e0 nel 1939.\r\n\r\nSimulatore di guida\r\n\r\nAvete sempre avuto voglia di guidare un treno ? Train World vi sistema in un simulatore di guida! Nel posto dell\u2019autista, potrete osservare i cambi dell\u2019ambiente lungo le linee ferroviarie nel corso degli anni.\r\n\r\nScuole e famiglie\r\n\r\nI vostri bambini potranno approfittare di un\u2019offerta specifica che mette l\u2019accanto sia sul aspetto educativo che divertente. Potranno approfittare di un spazio giochi originale.\r\n\r\nSala eventi\r\n\r\nTrain World entra in stazione e Bruxelles si dota di un nuovo luogo per eventi! Con 550 m\u00b2, la magnifica sala degli sportelli della stazione di Schaerbeek, risalendo al 1913, offrir\u00e0 un quadro unico per eventi. Sar\u00e0 dotata di un\u2019installazione audiovisuale moderna. \r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Train World","address_street_name":"Place Princesse Elisabeth","address_street_number":"5","address_street_box":null,"email":"info@trainworld.be","website":"http:\/\/www.trainworld.be","phone_contact":"+32 490 47 94 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Place Princesse Elisabeth, 5","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Train World","address_street_name":"Place Princesse Elisabeth","address_street_number":"5","address_street_box":null,"email":"info@trainworld.be","website":"http:\/\/www.trainworld.be","phone_contact":"+32 490 47 94 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Place Princesse Elisabeth, 5","address_line2":"1030 Schaerbeek","description_web":"Train World est une exp\u00e9rience ferroviaire unique qui vous emm\u00e8ne des toutes premi\u00e8res locomotives \u00e0 vapeur aux trains \u00e0 grande vitesse flamboyants ! C'est un univers qui fait appel \u00e0 tous les sens pour appr\u00e9hender les multiples dimensions du chemin de fer. Une visite \u00e0 Train World est une sortie active et surprenante. Vous pouvez vous promener parmi les locomotives, prendre place dans des trains centenaires, visiter une maison de chemin de fer et traverser un v\u00e9ritable pont ferroviaire. Vous ferez m\u00eame l'exp\u00e9rience de la conduite d'un train !","description_print":"Vitrine du pass\u00e9, du pr\u00e9sent et du futur sur le monde ferroviaire, Train World est le nom du nouveau mus\u00e9e des chemins de fer, actuellement en construction pr\u00e8s de la gare de Schaerbeek. Il abritera les pi\u00e8ces les plus pr\u00e9cieuses du patrimoine historique.Train World rendra hommage \u00e0 la riche histoire du train, mais d\u00e9montrera aussi que les chemins de fer n'ont pas fini de jouer un r\u00f4le important dans le d\u00e9veloppement de notre pays.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Train World","address_street_name":"Place Princesse Elisabeth","address_street_number":"5","address_street_box":null,"email":"info@trainworld.be","website":"http:\/\/www.trainworld.be","phone_contact":"+32 490 47 94 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Place Princesse Elisabeth, 5","address_line2":"1030 Schaerbeek","description_web":"Train World, la nueva atracci\u00f3n tur\u00edstica de Bruselas.\r\n\r\nTrain World es un escaparate para los ferrocarriles de ayer, hoy y ma\u00f1ana, es la nueva atracci\u00f3n tur\u00edstica de Bruselas. El lugar est\u00e1 situado a pocos minutos en tren de la Estaci\u00f3n Central de Bruselas (cerca de la Grand Place).\r\n\r\nAqu\u00ed tendr\u00e1s la oportunidad de admirar las piezas m\u00e1s encantadoras de la colecci\u00f3n de trenes y vagones hist\u00f3ricos de los ferrocarriles belgas, pero tambi\u00e9n ilustra el importante papel del tren en la movilidad de hoy en d\u00eda y el futuro. Train World es m\u00e1s que un museo: es un centro en el que podr\u00e1s vivir nuevas experiencias. Con una escenograf\u00eda original \u2013 dise\u00f1ada por el artista Fran\u00e7ois Schuiten \u2013 te ofrece una experiencia en la que puedes mirar, escuchar, tocar y sorprenderte con incre\u00edbles historias del mundo de los trenes.\r\nEl lugar, junto con las primeras v\u00edas ferroviarias del continente europeo, incluye la Estaci\u00f3n Schaerbeek renovada donde se encuentra la taquilla y un nuevo edificio de 8.000 m\u00b2. La antigua estaci\u00f3n, construida en 1887, es una las obras maestras de la arquitectura ferroviaria belga y es patrimonio hist\u00f3rico. Y para completar la oferta encontrar\u00e1s un restaurante y una tienda de regalos en la estaci\u00f3n.\r\n\r\nAlgo para todo el mundo\r\n\r\n\u00a1Hay mucho que descubrir en Train World! Por ejemplo, puedes ver el tren de vapor m\u00e1s antiguo preservado en B\u00e9lgica, la \u201cPays de Waes\u201d. O el tren de vapor simplificado \u201cType 12\u201d, que obtuvo el r\u00e9cord de velocidad en 1939. Puedes admirar el esplendor de los aut\u00e9nticos carruajes reales o pasear en el Trans-Europe Express (TEE) de acero inoxidable \u2013 el predecesor del tren de alta velocidad \u2013 que una vez cruz\u00f3 Europa. \u00bfTe gustar\u00eda conducir un tren? Entonces prueba suerte en uno de los simuladores de tren\u2026 o estudia los cambios que han sufrido los ferrocarriles de ayer y hoy desde una cabina de conductor.\r\n\r\nTambi\u00e9n hay cientos de objetos del mundo de los trenes, tales como uniformes, pinturas o modelos de trenes y estaciones, junto con una abundante cantidad de fotos y fragmentos de pel\u00edculas. Tambi\u00e9n cabe destacar la presencia de una aut\u00e9ntica \u201ccasa de guardabarreras\u201d que ha sido incluida en el nuevo edificio. Est\u00e1 amueblada al estilo de los a\u00f1os 50 y el \u00e1tico tiene un paisaje lleno de trenes en miniatura. \r\nColegios y familias con ni\u00f1os peque\u00f1os pueden disfrutar de ofertas espec\u00edficas, con especial atenci\u00f3n en el aspecto educativo relacionado con los juegos. Los ni\u00f1os pueden disfrutar en el \u201ctren de escalada\u201d, un tren de vapor medio enterrado.\r\n\r\nGracias a la cooperaci\u00f3n con los constructores de tren, la tecnolog\u00eda moderna y el desarrollo futuro tambi\u00e9n est\u00e1n en oferta. Ejemplo de esto son las tres cabinas de tren a tama\u00f1o real de los trenes m\u00e1s modernos.\r\n\r\n\r\n","description_print":"Train World es un escaparate para los ferrocarriles de ayer, hoy y ma\u00f1ana, es la nueva atracci\u00f3n tur\u00edstica de Bruselas. El lugar est\u00e1 situado a pocos minutos en tren de la Estaci\u00f3n Central de Bruselas (cerca de la Grand Place).\r\n\r\nAqu\u00ed tendr\u00e1s la oportunidad de admirar las piezas m\u00e1s encantadoras de la colecci\u00f3n de trenes y vagones hist\u00f3ricos de los ferrocarriles belgas, pero tambi\u00e9n ilustra el importante papel del tren en la movilidad de hoy en d\u00eda y el futuro. Train World es m\u00e1s que un museo: es un centro en el que podr\u00e1s vivir nuevas experiencias. Con una escenograf\u00eda original \u2013 dise\u00f1ada por el artista Fran\u00e7ois Schuiten \u2013 te ofrece una experiencia en la que puedes mirar, escuchar, tocar y sorprenderte con incre\u00edbles historias del mundo de los trenes.\r\nEl lugar, junto con las primeras v\u00edas ferroviarias del continente europeo, incluye la Estaci\u00f3n Schaerbeek renovada donde se encuentra la taquilla y un nuevo edificio de 8.000 m\u00b2. La antigua estaci\u00f3n, construida en 1887, es una las obras maestras de la arquitectura ferroviaria belga y es patrimonio hist\u00f3rico. Y para completar la oferta encontrar\u00e1s un restaurante y una tienda de regalos en la estaci\u00f3n.\r\n\r\nAlgo para todo el mundo\r\n\r\n\u00a1Hay mucho que descubrir en Train World! Por ejemplo, puedes ver el tren de vapor m\u00e1s antiguo preservado en B\u00e9lgica, la \u201cPays de Waes\u201d. O el tren de vapor simplificado \u201cType 12\u201d, que obtuvo el r\u00e9cord de velocidad en 1939. Puedes admirar el esplendor de los aut\u00e9nticos carruajes reales o pasear en el Trans-Europe Express (TEE) de acero inoxidable \u2013 el predecesor del tren de alta velocidad \u2013 que una vez cruz\u00f3 Europa. \u00bfTe gustar\u00eda conducir un tren? Entonces prueba suerte en uno de los simuladores de tren\u2026 o estudia los cambios que han sufrido los ferrocarriles de ayer y hoy desde una cabina de conductor.\r\n\r\nTambi\u00e9n hay cientos de objetos del mundo de los trenes, tales como uniformes, pinturas o modelos de trenes y estaciones, junto con una abundante cantidad de fotos y fragmentos de pel\u00edculas. Tambi\u00e9n cabe destacar la presencia de una aut\u00e9ntica \u201ccasa de guardabarreras\u201d que ha sido incluida en el nuevo edificio. Est\u00e1 amueblada al estilo de los a\u00f1os 50 y el \u00e1tico tiene un paisaje lleno de trenes en miniatura. \r\nColegios y familias con ni\u00f1os peque\u00f1os pueden disfrutar de ofertas espec\u00edficas, con especial atenci\u00f3n en el aspecto educativo relacionado con los juegos. Los ni\u00f1os pueden disfrutar en el \u201ctren de escalada\u201d, un tren de vapor medio enterrado.\r\n\r\nGracias a la cooperaci\u00f3n con los constructores de tren, la tecnolog\u00eda moderna y el desarrollo futuro tambi\u00e9n est\u00e1n en oferta. Ejemplo de esto son las tres cabinas de tren a tama\u00f1o real de los trenes m\u00e1s modernos.\r\n\r\nTrain World will exceptionally be completely closed to the public from Monday 14 October to Monday 21 October 2019 and from Monday 16 March to Tuesday 17 March 2020 because of the assembly and dismantling of our exhibition dedicated to Paul Delvaux.\r\n\r\n","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Train World","address_street_name":"Prinses Elisabethplein","address_street_number":"5","address_street_box":null,"email":"b2b@trainworld.be","website":"http:\/\/www.trainworld.be","phone_contact":"+32 490 47 94 00","phone_booking":null,"address_zip":"1030","address_city":"Schaarbeek","address_line1":"Prinses Elisabethplein, 5","address_line2":"1030 Schaarbeek","description_web":"Train World is een unieke spoorervaring die je van de allereerste stoomlocomotieven tot de flitsende hogesnelheidstreinen brengt! Het is een universum dat een beroep doet op alle zintuigen om de vele verschillende dimensies van de spoorwegen te kunnen bevatten. Een bezoek aan Train World is een actieve en verrassende uitstap. Je wandelt tussen locomotieven, neemt plaats in treinen van 100 jaar oud, bezoekt een spoorweghuisje en loopt over een echte spoorwegbrug. Je ervaart zelfs hoe het voelt om een trein te besturen!","description_print":"Train World is sinds september 2015 het uitstalraam voor de spoorwegen van gisteren, vandaag en morgen in Brussel. De site bevindt zich in Schaarbeek, op nauwelijks 10 minuten met de trein vanuit Brussel-Centraal (bij de Grote Markt). \r\n\r\nDe mooiste stukken uit de collectie historische locomotieven en rijtuigen van de Belgische spoorwegen zijn er te bewonderen, maar daarnaast wordt er ook de belangrijke rol van de trein in de mobiliteit van vandaag en de toekomst ge\u00efllustreerd. Train World is meer dan een museum: het is een belevingscentrum. Een originele scenografie \u2013 ontworpen door kunstenaar Fran\u00e7ois Schuiten - zorgt voor een ervaring waarbij je kan kijken, luisteren, aanraken en verrast worden door de boeiende verhalen uit de wereld van de trein.\r\n\r\n22-10-2019> 15-03-2020 : Tentoonstelling: Paul Delvaux, de man die van treinen hield \r\n\r\nPaul Delvaux (1897-1994) schilderde een meesterlijk oeuvre bijeen, met als inspiratiebron de wereld van de spoorwegen. Zijn surrealistische werken gaan moeiteloos op in de adembenemende scenografie van Train World. Als vanzelf ontstaat een boeiende dialoog.\r\n\r\nDeze expo is h\u00e9t uitgelezen moment om de artistieke evolutie van deze spoorwegliefhebber te ontdekken in een magische setting: van tekeningen, aquarellen en schilderijen uit de jaren 1920 tot monumentale werken uit de jaren 1970, maar ook persoonlijke objecten van de artiest voegen verrassende accenten toe. Dat de schilder in 1984 tot erestationschef van Louvain-la-Neuve werd benoemd, is veelbetekenend.\r\n\r\n","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[20],"translations":{"de":["Norden"],"pt":[null],"en":["North"],"it":["Nord"],"cn":[null],"fr":["Nord"],"sp":["Norte"],"nl":["Noord"]}},"neca":null,"facebook_id":null,"backoffice_id":14733,"location":{"lat":50.877759,"lon":4.378947},"region":"brussels","last_updated_at":"2024-09-03T16:29:21+02:00","published_at":"2013-10-19T01:54:59+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":252663,"translations":{"de":{"name":"Train World","address_street_name":"Place Princesse Elisabeth","address_street_number":"5","address_street_box":null,"email":"info@trainworld.be","website":"http:\/\/www.trainworld.be","phone_contact":"+32 490 47 94 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Place Princesse Elisabeth, 5","address_line2":"1030 Schaerbeek","description_web":"N\u00e4chste Haltestelle Train World... kleine und gro\u00dfe Eisenbahnfreunde erwartet in Br\u00fcssel ein neues \u201eMekka\": In dem historischen Geb\u00e4ude des ehemaligen Bahnhofs von Schaerbeek erwartet Sie das spektakul\u00e4re Eisenbahnmuseum Train World, dessen Szenographie aus der Feder des belgischen Comic-K\u00fcnstlers Fran\u00e7ois Schuiten stammt.\r\n\r\nSch\u00e4tze aus der Welt der Eisenbahn: Von der \u00e4ltesten Dampflokomotive Belgiens \u00fcber prunkvolle k\u00f6nigliche Wagons bis hin zu den modernen Hochgeschwindigkeitsz\u00fcgen - Train World f\u00fchrt die Besucher durch die belgische Eisenbahngeschichte. Neben historischem und technischem Wissen gibt es auch Anekdoten und Kuriosit\u00e4ten aus der Welt der Eisenbahn zu entdecken. Wie ist eine Schiene aufgebaut, wie schnell fuhren die ersten Dampfloks, wie reisten einst die K\u00f6nige? Antworten auf all diese Fragen geben die Erkl\u00e4rungstafeln, die auch auf Deutsch zur Verf\u00fcgung stehen, sowie die kostenlosen Audioguides (ebenfalls auf Deutsch).\r\n\r\nFahrsimulator: Sie haben schon immer davon getr\u00e4umt, Lokomotivf\u00fchrer zu werden? Dann nehmen Sie Platz im F\u00fchrerstand des Fahrsimulators und begeben sich auf eine Reise durch die Eisenbahngeschichte.\r\n\r\nLeibliches Wohl:\r\n\r\nIn der Brasserie \"RN Express\", die in dem historischen Bahnhofsgeb\u00e4ude untergebracht ist, gibt es Speisen und Getr\u00e4nke. Tiefblaue W\u00e4nde, gl\u00e4serne Kugellampen und Holzmobiliar sorgen f\u00fcr ein besonderes Ambiente.\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Train World","address_street_name":"Place Princesse Elisabeth","address_street_number":"5","address_street_box":null,"email":"info@trainworld.be","website":"http:\/\/www.trainworld.be","phone_contact":"+32 490 47 94 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Place Princesse Elisabeth, 5","address_line2":"1030 Schaerbeek","description_web":"Train World, o novo polo de atra\u00e7\u00e3o de Bruxelas\r\nTrain World, a montra dos caminhos de ferro de ontem, de hoje e de amanh\u00e3, \u00e9 a nova atra\u00e7\u00e3o tur\u00edstica de Bruxelas desde setembro de 2015. O local situa-se em Schaerbeek, a alguns minutos de comboio da Esta\u00e7\u00e3o Central (pr\u00f3ximo da Grand-Place).\r\nN\u00e3o est\u00e3o a\u00ed expostas apenas as pe\u00e7as mais belas da cole\u00e7\u00e3o de locomotivas e de ve\u00edculos hist\u00f3ricos dos caminhos de ferro belgas, mas tamb\u00e9m \u00e9 ilustrado o papel importante do comboio na mobilidade atual e do futuro. Train World \u00e9 mais do que um museu, trata-se de um centro de interpreta\u00e7\u00e3o. A cenografia original \u2013 desenvolvida pelo artista Fran\u00e7ois Schuiten- cria uma experi\u00eancia interativa durante a qual o p\u00fablico pode olhar, ouvir, tocar e deixar-se surpreender por hist\u00f3rias apaixonantes do mundo ferrovi\u00e1rio.\r\nO local, situado ao longo do tra\u00e7ado da primeira linha de caminhos de ferro do continente europeu (Bruxelas\u2013Mechelen, 1835), inclui a esta\u00e7\u00e3o renovada de Schaerbeek, onde se encontra a bilheteira, e uma constru\u00e7\u00e3o nova de 8000 m\u00b2. Note-se que a esta\u00e7\u00e3o, constru\u00edda em 1887, \u00e9 um dos baluartes da arquitetura ferrovi\u00e1ria belga e um monumento classificado. Um estabelecimento de hoteleira e restaura\u00e7\u00e3o situado na esta\u00e7\u00e3o completa a oferta de Train World.\r\nUma oferta muito diversificada destinada a todo o mundo\r\nTrain World aloja in\u00fameros tesouros a descobrir. Por exemplo, \u00e9 poss\u00edvel a\u00ed admirar a locomotiva a vapor mais antiga mantida na B\u00e9lgica, a \u201cPa\u00eds de Waes\u201d. Ou ainda a locomotiva a vapor de carenagem \u201ctipo 12\u201d, que estabeleceu um novo recorde de velocidade em 1939. Tamb\u00e9m \u00e9 poss\u00edvel contemplar aut\u00eanticos e sumptuosos ve\u00edculos reais ou penetrar um dos ve\u00edculos TEE inox, antecessor dos comboios de grande velocidade, que percorriam a Europa na \u00e9poca. Com vontade de assumir o comando de um comboio?\r\nPoder\u00e1 experiment\u00e1-lo, num simulador de condu\u00e7\u00e3o. No lugar do condutor, poder\u00e1 observar as mudan\u00e7as no ambiente das linhas ao longo dos anos.\r\nTrain World apresenta igualmente centenas de objetos do mundo ferrovi\u00e1rio, como uniformes, pinturas ou maquetas de comboios e de esta\u00e7\u00f5es, assim como in\u00fameras fotos e videoclipes. A notar igualmente: a apresenta\u00e7\u00e3o de uma aut\u00eantica casinha de guarda das passagens de n\u00edvel, retomada na nova constru\u00e7\u00e3o de Train World. Estar\u00e1 mobilada com uma decora\u00e7\u00e3o dos anos 50. No s\u00f3t\u00e3o, ser\u00e3o expostos comboios miniatura.\r\nAs escolas e as fam\u00edlias com crian\u00e7as pequenas poder\u00e3o aproveitar uma oferta espec\u00edfica que acentua tanto o aspeto educativo como o l\u00fadico. As crian\u00e7as poder\u00e3o dar espa\u00e7o \u00e0 sua alegria num espa\u00e7o de jogos, como m\u00ednimo, original, especialmente concebido para elas: uma locomotiva a vapor que emerge do solo.\r\nGra\u00e7as \u00e0 colabora\u00e7\u00e3o com os construtores de comboios, as tecnologias modernas e os desenvolvimentos futuros ser\u00e3o tamb\u00e9m abordados. Desse modo, o p\u00fablico poder\u00e1 admirar, por exemplo, tr\u00eas comboios de \u00faltima gera\u00e7\u00e3o.\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Train World","address_street_name":"Prinses Elisabethplein","address_street_number":"5","address_street_box":null,"email":"b2b@trainworld.be","website":"http:\/\/www.trainworld.be","phone_contact":"+32 490 47 94 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Prinses Elisabethplein, 5","address_line2":"1030 Schaerbeek","description_web":"Train World is a unique railway experience that takes you from the very first steam locomotives to the flashing high-speed trains! It is a universe that appeals to all the senses in order to grasp the many different dimensions of the railways. A visit to Train World is an active and surprising outing. You can walk among locomotives, take a seat in 100-year-old trains, visit a railway house and walk across a real railway bridge. You will even experience how it feels to drive a train!\r\n\r\n\r\n","description_print":"Train World, the showcase for the railways of yesterday, today and tomorrow, is a must-see tourist attraction in Brussels. The site is located a few minutes by train from Brussels Central station (near the Grand Place)\r\nHere you will be able to admire the loveliest pieces from the collection of historical locomotives and carriages from the Belgian railways, but it will also illustrate the significant role of the train in the mobility of today and in future. Train World is more than a museum: it will be an experience centre. An original scenography \u2013 designed by artist Fran\u00e7ois Schuiten \u2013 will provide an experience in which the audience can look, listen, touch and be surprised by scintillating stories from the world of trains.\r\nThe site comprises the renovated Schaerbeek station, where the ticket office is located, and a new 8,000 m\u00b2 building. A restaurant and a book & gift shop in the station completes the offering. It will also be possible to have a picnic: a restored carriage will be available in the transit area from the station to the new building for this purpose.\r\n","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Train World","address_street_name":"Place Princesse Elisabeth","address_street_number":"5","address_street_box":null,"email":"info@trainworld.be","website":"http:\/\/www.trainworld.be","phone_contact":"+32 490 47 94 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Place Princesse Elisabeth, 5","address_line2":"1030 Schaerbeek","description_web":"Train World. Il museo nazionale del treno aprir\u00e0 le porte alla stazione di Schaerbeek.\r\nTesori del mondo ferroviario\r\nTrain World custodir\u00e0 numerosi tesori: la pi\u00f9 antica locomotiva conservata in Belgio, la \u201cpaese di Waes\u201d, o la locomotive a vapore carenata \u201ctipo 12\u201d che aveva stabilito un record di velocit\u00e0 nel 1939.\r\n\r\nSimulatore di guida\r\n\r\nAvete sempre avuto voglia di guidare un treno ? Train World vi sistema in un simulatore di guida! Nel posto dell\u2019autista, potrete osservare i cambi dell\u2019ambiente lungo le linee ferroviarie nel corso degli anni.\r\n\r\nScuole e famiglie\r\n\r\nI vostri bambini potranno approfittare di un\u2019offerta specifica che mette l\u2019accanto sia sul aspetto educativo che divertente. Potranno approfittare di un spazio giochi originale.\r\n\r\nSala eventi\r\n\r\nTrain World entra in stazione e Bruxelles si dota di un nuovo luogo per eventi! Con 550 m\u00b2, la magnifica sala degli sportelli della stazione di Schaerbeek, risalendo al 1913, offrir\u00e0 un quadro unico per eventi. Sar\u00e0 dotata di un\u2019installazione audiovisuale moderna. \r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Train World","address_street_name":"Place Princesse Elisabeth","address_street_number":"5","address_street_box":null,"email":"info@trainworld.be","website":"http:\/\/www.trainworld.be","phone_contact":"+32 490 47 94 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Place Princesse Elisabeth, 5","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Train World","address_street_name":"Place Princesse Elisabeth","address_street_number":"5","address_street_box":null,"email":"info@trainworld.be","website":"http:\/\/www.trainworld.be","phone_contact":"+32 490 47 94 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Place Princesse Elisabeth, 5","address_line2":"1030 Schaerbeek","description_web":"Train World est une exp\u00e9rience ferroviaire unique qui vous emm\u00e8ne des toutes premi\u00e8res locomotives \u00e0 vapeur aux trains \u00e0 grande vitesse flamboyants ! C'est un univers qui fait appel \u00e0 tous les sens pour appr\u00e9hender les multiples dimensions du chemin de fer. Une visite \u00e0 Train World est une sortie active et surprenante. Vous pouvez vous promener parmi les locomotives, prendre place dans des trains centenaires, visiter une maison de chemin de fer et traverser un v\u00e9ritable pont ferroviaire. Vous ferez m\u00eame l'exp\u00e9rience de la conduite d'un train !","description_print":"Vitrine du pass\u00e9, du pr\u00e9sent et du futur sur le monde ferroviaire, Train World est le nom du nouveau mus\u00e9e des chemins de fer, actuellement en construction pr\u00e8s de la gare de Schaerbeek. Il abritera les pi\u00e8ces les plus pr\u00e9cieuses du patrimoine historique.Train World rendra hommage \u00e0 la riche histoire du train, mais d\u00e9montrera aussi que les chemins de fer n'ont pas fini de jouer un r\u00f4le important dans le d\u00e9veloppement de notre pays.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Train World","address_street_name":"Place Princesse Elisabeth","address_street_number":"5","address_street_box":null,"email":"info@trainworld.be","website":"http:\/\/www.trainworld.be","phone_contact":"+32 490 47 94 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Place Princesse Elisabeth, 5","address_line2":"1030 Schaerbeek","description_web":"Train World, la nueva atracci\u00f3n tur\u00edstica de Bruselas.\r\n\r\nTrain World es un escaparate para los ferrocarriles de ayer, hoy y ma\u00f1ana, es la nueva atracci\u00f3n tur\u00edstica de Bruselas. El lugar est\u00e1 situado a pocos minutos en tren de la Estaci\u00f3n Central de Bruselas (cerca de la Grand Place).\r\n\r\nAqu\u00ed tendr\u00e1s la oportunidad de admirar las piezas m\u00e1s encantadoras de la colecci\u00f3n de trenes y vagones hist\u00f3ricos de los ferrocarriles belgas, pero tambi\u00e9n ilustra el importante papel del tren en la movilidad de hoy en d\u00eda y el futuro. Train World es m\u00e1s que un museo: es un centro en el que podr\u00e1s vivir nuevas experiencias. Con una escenograf\u00eda original \u2013 dise\u00f1ada por el artista Fran\u00e7ois Schuiten \u2013 te ofrece una experiencia en la que puedes mirar, escuchar, tocar y sorprenderte con incre\u00edbles historias del mundo de los trenes.\r\nEl lugar, junto con las primeras v\u00edas ferroviarias del continente europeo, incluye la Estaci\u00f3n Schaerbeek renovada donde se encuentra la taquilla y un nuevo edificio de 8.000 m\u00b2. La antigua estaci\u00f3n, construida en 1887, es una las obras maestras de la arquitectura ferroviaria belga y es patrimonio hist\u00f3rico. Y para completar la oferta encontrar\u00e1s un restaurante y una tienda de regalos en la estaci\u00f3n.\r\n\r\nAlgo para todo el mundo\r\n\r\n\u00a1Hay mucho que descubrir en Train World! Por ejemplo, puedes ver el tren de vapor m\u00e1s antiguo preservado en B\u00e9lgica, la \u201cPays de Waes\u201d. O el tren de vapor simplificado \u201cType 12\u201d, que obtuvo el r\u00e9cord de velocidad en 1939. Puedes admirar el esplendor de los aut\u00e9nticos carruajes reales o pasear en el Trans-Europe Express (TEE) de acero inoxidable \u2013 el predecesor del tren de alta velocidad \u2013 que una vez cruz\u00f3 Europa. \u00bfTe gustar\u00eda conducir un tren? Entonces prueba suerte en uno de los simuladores de tren\u2026 o estudia los cambios que han sufrido los ferrocarriles de ayer y hoy desde una cabina de conductor.\r\n\r\nTambi\u00e9n hay cientos de objetos del mundo de los trenes, tales como uniformes, pinturas o modelos de trenes y estaciones, junto con una abundante cantidad de fotos y fragmentos de pel\u00edculas. Tambi\u00e9n cabe destacar la presencia de una aut\u00e9ntica \u201ccasa de guardabarreras\u201d que ha sido incluida en el nuevo edificio. Est\u00e1 amueblada al estilo de los a\u00f1os 50 y el \u00e1tico tiene un paisaje lleno de trenes en miniatura. \r\nColegios y familias con ni\u00f1os peque\u00f1os pueden disfrutar de ofertas espec\u00edficas, con especial atenci\u00f3n en el aspecto educativo relacionado con los juegos. Los ni\u00f1os pueden disfrutar en el \u201ctren de escalada\u201d, un tren de vapor medio enterrado.\r\n\r\nGracias a la cooperaci\u00f3n con los constructores de tren, la tecnolog\u00eda moderna y el desarrollo futuro tambi\u00e9n est\u00e1n en oferta. Ejemplo de esto son las tres cabinas de tren a tama\u00f1o real de los trenes m\u00e1s modernos.\r\n\r\n\r\n","description_print":"Train World es un escaparate para los ferrocarriles de ayer, hoy y ma\u00f1ana, es la nueva atracci\u00f3n tur\u00edstica de Bruselas. El lugar est\u00e1 situado a pocos minutos en tren de la Estaci\u00f3n Central de Bruselas (cerca de la Grand Place).\r\n\r\nAqu\u00ed tendr\u00e1s la oportunidad de admirar las piezas m\u00e1s encantadoras de la colecci\u00f3n de trenes y vagones hist\u00f3ricos de los ferrocarriles belgas, pero tambi\u00e9n ilustra el importante papel del tren en la movilidad de hoy en d\u00eda y el futuro. Train World es m\u00e1s que un museo: es un centro en el que podr\u00e1s vivir nuevas experiencias. Con una escenograf\u00eda original \u2013 dise\u00f1ada por el artista Fran\u00e7ois Schuiten \u2013 te ofrece una experiencia en la que puedes mirar, escuchar, tocar y sorprenderte con incre\u00edbles historias del mundo de los trenes.\r\nEl lugar, junto con las primeras v\u00edas ferroviarias del continente europeo, incluye la Estaci\u00f3n Schaerbeek renovada donde se encuentra la taquilla y un nuevo edificio de 8.000 m\u00b2. La antigua estaci\u00f3n, construida en 1887, es una las obras maestras de la arquitectura ferroviaria belga y es patrimonio hist\u00f3rico. Y para completar la oferta encontrar\u00e1s un restaurante y una tienda de regalos en la estaci\u00f3n.\r\n\r\nAlgo para todo el mundo\r\n\r\n\u00a1Hay mucho que descubrir en Train World! Por ejemplo, puedes ver el tren de vapor m\u00e1s antiguo preservado en B\u00e9lgica, la \u201cPays de Waes\u201d. O el tren de vapor simplificado \u201cType 12\u201d, que obtuvo el r\u00e9cord de velocidad en 1939. Puedes admirar el esplendor de los aut\u00e9nticos carruajes reales o pasear en el Trans-Europe Express (TEE) de acero inoxidable \u2013 el predecesor del tren de alta velocidad \u2013 que una vez cruz\u00f3 Europa. \u00bfTe gustar\u00eda conducir un tren? Entonces prueba suerte en uno de los simuladores de tren\u2026 o estudia los cambios que han sufrido los ferrocarriles de ayer y hoy desde una cabina de conductor.\r\n\r\nTambi\u00e9n hay cientos de objetos del mundo de los trenes, tales como uniformes, pinturas o modelos de trenes y estaciones, junto con una abundante cantidad de fotos y fragmentos de pel\u00edculas. Tambi\u00e9n cabe destacar la presencia de una aut\u00e9ntica \u201ccasa de guardabarreras\u201d que ha sido incluida en el nuevo edificio. Est\u00e1 amueblada al estilo de los a\u00f1os 50 y el \u00e1tico tiene un paisaje lleno de trenes en miniatura. \r\nColegios y familias con ni\u00f1os peque\u00f1os pueden disfrutar de ofertas espec\u00edficas, con especial atenci\u00f3n en el aspecto educativo relacionado con los juegos. Los ni\u00f1os pueden disfrutar en el \u201ctren de escalada\u201d, un tren de vapor medio enterrado.\r\n\r\nGracias a la cooperaci\u00f3n con los constructores de tren, la tecnolog\u00eda moderna y el desarrollo futuro tambi\u00e9n est\u00e1n en oferta. Ejemplo de esto son las tres cabinas de tren a tama\u00f1o real de los trenes m\u00e1s modernos.\r\n\r\nTrain World will exceptionally be completely closed to the public from Monday 14 October to Monday 21 October 2019 and from Monday 16 March to Tuesday 17 March 2020 because of the assembly and dismantling of our exhibition dedicated to Paul Delvaux.\r\n\r\n","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Train World","address_street_name":"Prinses Elisabethplein","address_street_number":"5","address_street_box":null,"email":"b2b@trainworld.be","website":"http:\/\/www.trainworld.be","phone_contact":"+32 490 47 94 00","phone_booking":null,"address_zip":"1030","address_city":"Schaarbeek","address_line1":"Prinses Elisabethplein, 5","address_line2":"1030 Schaarbeek","description_web":"Train World is een unieke spoorervaring die je van de allereerste stoomlocomotieven tot de flitsende hogesnelheidstreinen brengt! Het is een universum dat een beroep doet op alle zintuigen om de vele verschillende dimensies van de spoorwegen te kunnen bevatten. Een bezoek aan Train World is een actieve en verrassende uitstap. Je wandelt tussen locomotieven, neemt plaats in treinen van 100 jaar oud, bezoekt een spoorweghuisje en loopt over een echte spoorwegbrug. Je ervaart zelfs hoe het voelt om een trein te besturen!","description_print":"Train World is sinds september 2015 het uitstalraam voor de spoorwegen van gisteren, vandaag en morgen in Brussel. De site bevindt zich in Schaarbeek, op nauwelijks 10 minuten met de trein vanuit Brussel-Centraal (bij de Grote Markt). \r\n\r\nDe mooiste stukken uit de collectie historische locomotieven en rijtuigen van de Belgische spoorwegen zijn er te bewonderen, maar daarnaast wordt er ook de belangrijke rol van de trein in de mobiliteit van vandaag en de toekomst ge\u00efllustreerd. Train World is meer dan een museum: het is een belevingscentrum. Een originele scenografie \u2013 ontworpen door kunstenaar Fran\u00e7ois Schuiten - zorgt voor een ervaring waarbij je kan kijken, luisteren, aanraken en verrast worden door de boeiende verhalen uit de wereld van de trein.\r\n\r\n22-10-2019> 15-03-2020 : Tentoonstelling: Paul Delvaux, de man die van treinen hield \r\n\r\nPaul Delvaux (1897-1994) schilderde een meesterlijk oeuvre bijeen, met als inspiratiebron de wereld van de spoorwegen. Zijn surrealistische werken gaan moeiteloos op in de adembenemende scenografie van Train World. Als vanzelf ontstaat een boeiende dialoog.\r\n\r\nDeze expo is h\u00e9t uitgelezen moment om de artistieke evolutie van deze spoorwegliefhebber te ontdekken in een magische setting: van tekeningen, aquarellen en schilderijen uit de jaren 1920 tot monumentale werken uit de jaren 1970, maar ook persoonlijke objecten van de artiest voegen verrassende accenten toe. Dat de schilder in 1984 tot erestationschef van Louvain-la-Neuve werd benoemd, is veelbetekenend.\r\n\r\n","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":14733,"location":{"lat":50.877759,"lon":4.378947},"last_updated_at":"2024-09-03T16:29:21+02:00","published_at":"2013-10-19T01:54:59+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/c60d0586873ab389fb032963a9bf8ee6433a952c.jpg","width":1728,"height":2160,"ratio":0.8,"oEmbed_height":2160,"oEmbed_width":1728,"translations":{"de":{"title":"Journ\u00e9e familles","copyright":null},"pt":{"title":"Journ\u00e9e familles","copyright":null},"en":{"title":"Journ\u00e9e familles","copyright":null},"it":{"title":"Journ\u00e9e familles","copyright":null},"cn":{"title":"Journ\u00e9e familles","copyright":null},"fr":{"title":"Journ\u00e9e familles","copyright":null},"sp":{"title":"Journ\u00e9e familles","copyright":null},"nl":{"title":"Journ\u00e9e familles","copyright":null}}},{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/1534d7ad91a81a0c0366d547a0cbc3668a632fd2.jpg","width":1536,"height":2048,"ratio":0.75,"oEmbed_height":2048,"oEmbed_width":1536,"translations":{"de":{"title":"Journ\u00e9e familles","copyright":null},"pt":{"title":"Journ\u00e9e familles","copyright":null},"en":{"title":"Journ\u00e9e familles","copyright":null},"it":{"title":"Journ\u00e9e familles","copyright":null},"cn":{"title":"Journ\u00e9e familles","copyright":null},"fr":{"title":"Journ\u00e9e familles","copyright":null},"sp":{"title":"Journ\u00e9e familles","copyright":null},"nl":{"title":"Journ\u00e9e familles","copyright":null}}},{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/085641f35dc9aa31760caae76431b7db1b674f04.jpg","width":3468,"height":4624,"ratio":0.75,"oEmbed_height":4624,"oEmbed_width":3468,"translations":{"de":{"title":"Journ\u00e9e familles","copyright":null},"pt":{"title":"Journ\u00e9e familles","copyright":null},"en":{"title":"Journ\u00e9e familles","copyright":null},"it":{"title":"Journ\u00e9e familles","copyright":null},"cn":{"title":"Journ\u00e9e familles","copyright":null},"fr":{"title":"Journ\u00e9e familles","copyright":null},"sp":{"title":"Journ\u00e9e familles","copyright":null},"nl":{"title":"Journ\u00e9e familles","copyright":null}}},{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/17a90aa947269f76b70639cdd4b47f07b4408bf7.jpg","width":1600,"height":1200,"ratio":1.33,"oEmbed_height":1200,"oEmbed_width":1600,"translations":{"de":{"title":"Journ\u00e9e familles","copyright":null},"pt":{"title":"Journ\u00e9e familles","copyright":null},"en":{"title":"Journ\u00e9e familles","copyright":null},"it":{"title":"Journ\u00e9e familles","copyright":null},"cn":{"title":"Journ\u00e9e familles","copyright":null},"fr":{"title":"Journ\u00e9e familles","copyright":null},"sp":{"title":"Journ\u00e9e familles","copyright":null},"nl":{"title":"Journ\u00e9e familles","copyright":null}}}],"dates":[{"day":"2024-10-29","doors":"10:00:00","start":"17:00:00","end":null,"end_night_life":null,"is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"de":{"name":"Normal"},"en":{"name":"Normal"},"it":{"name":"Normale"},"fr":{"name":"Normal"},"sp":{"name":"Normal"},"nl":{"name":"Normaal"}},"value":15},{"translations":{"de":{"name":"Kinder"},"en":{"name":"Children"},"it":{"name":"Bambini"},"fr":{"name":"Enfants"},"sp":{"name":"Ni\u00f1os"},"nl":{"name":"Kinderen"}},"value":5},{"translations":{"de":{"name":"Jugendliche"},"en":{"name":"Youth"},"it":{"name":"Ragazzi"},"fr":{"name":"Jeunes"},"sp":{"name":"J\u00f3venes"},"nl":{"name":"Jongeren"}},"value":11},{"translations":{"de":{"name":"Article 27"},"pt":{"name":"Article 27"},"en":{"name":"Article 27"},"it":{"name":"Article 27"},"cn":{"name":"Article 27"},"fr":{"name":"Article 27"},"sp":{"name":"Article 27"},"nl":{"name":"Artikel 27"}},"value":1.25}],"date_exceptions":[],"closing_days":[],"child_events":[],"parent_events":[],"accessibilities":{"list":[255,256,257,265,259],"translations":{"de":["Barrierefrei","Anpassungen f\u00fcr blinde und sehbehinderte Menschen","Anpassungen f\u00fcr geh\u00f6rlose und h\u00f6rgesch\u00e4digte Menschen.","Barrierefreies WC","Assistenzhund"],"pt":[null,null,null,null,null],"en":["Accessible","Facilities for blind and partially-sighted persons","Facilities for deaf and hearing-impaired people","Adapted toilet","Assistance dogs"],"it":["Accessibile","Disposizioni per persone non vedenti e ipovedenti","Disposizioni per persone non udenti e ipoudenti","WC idoneo","Cane guida"],"cn":[null,null,null,null,null],"fr":["Accessible","Am\u00e9nagements pour les personnes aveugles et malvoyantes","Am\u00e9nagements pour personnes sourdes et malentendantes","WC adapt\u00e9","Chien d'assistance"],"sp":["Habilitado","Equipos para personas con problemas de visi\u00f3n y audici\u00f3n","Equipos para personas sordas y con problemas de audici\u00f3n","Ba\u00f1os adaptados","Perros gu\u00eda"],"nl":["Toegankelijk","Voorzieningen voor blinde en slechtziende personen","Voorzieningen voor dove en slechthorende personen","Aangepast toilet","Assistentiehonden"]}},"recurring":[],"targets":{"list":[3,11,2,4,7,5,8],"translations":{"de":["Kinder 3-6 Jahre","Familie","Kinder 0-3 Jahre","Kinder 6-9 Jahre","Jugendliche 12-15 Jahre","Kinder 9-12 Jahre","Jugendliche 15-18 Jahre"],"pt":[null,null,null,null,null,null,null],"en":["Children 3-6 yr.","Family","Children 0-3 yr.","Children 6-9 yr.","Youth 12-15  yr.","Children 9-12 yr.","Youth 15-18  yr."],"it":["Bambini 3-6 anni","Famiglie","Bambini 0-3 anni","Bambini 6-9 anni","Ragazzi 12-15 anni","Bambini 9-12 anni","Ragazzi 15-18 anni"],"cn":[null,null,null,null,null,null,null],"fr":["Enfants 3-6 ans","Famille","Enfants 0-3 ans","Enfants 6-9 ans","Jeunes 12-15 ans","Enfants 9-12 ans","Jeunes 15-18 ans"],"sp":["Ni\u00f1os de 3 a 6 a\u00f1os","Familias","Ni\u00f1os de 0 a 3 a\u00f1os","Ni\u00f1os de 6 a 9 a\u00f1os","J\u00f3venes de 12 a 15 a\u00f1os","Ni\u00f1os de 9 a 12 a\u00f1os","J\u00f3venes de 15 a 18 a\u00f1os"],"nl":["Kinderen 3-6 j.","Familie","Kinderen 0-3 j.","Kinderen 6-9 j.","Jongeren 12-15 j.","Kinderen 9-12 j.","Jongeren 15-18 j."]}},"educational_targets":{"list":[],"translations":{}},"tags":["kids"]},{"id":5700003031,"date_start":"2024-10-29","date_end":"2024-10-29","date_next":"2024-10-29","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-10-25T14:52:05+02:00","published_at":"2024-10-25T14:46:13+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":310528,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"other","ranking":1.2599210498948732,"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"categories":{"main":{"id":90,"translations":{"de":"Animationen","pt":null,"en":"Animations","it":"Animazioni","cn":null,"fr":"Animations","sp":"Animaciones","nl":"Animaties"}},"others":{"list":[95],"translations":{"de":["Kulturerbe"],"pt":[null],"en":["Heritage"],"it":["Patrimonio culturale"],"cn":[null],"fr":["Patrimoine"],"sp":["Patrimonio"],"nl":["Erfgoed"]}}},"translations":{"de":{"name":"Journ\u00e9e familles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.trainworld.be\/fr\/journee-familles-2024","email":"info@trainworld.be","phone_contact":"+32 2 224 74 37","phone_booking":"+32 2 224 74 37","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700003031"},"pt":{"name":"Journ\u00e9e familles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.trainworld.be\/fr\/journee-familles-2024","email":"info@trainworld.be","phone_contact":"+32 2 224 74 37","phone_booking":"+32 2 224 74 37","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700003031"},"en":{"name":"Journ\u00e9e familles","shortdescr":"On Tuesday 29 October, we will host our family day again! We will provide plenty of fun activities for\nthe whole family. The perfect time to get to know Train World and guaranteed to be a fun outing for\nyoung and old alike.","longdescr":"Family Day 2024\nOn Tuesday 29 October, we will host our family day again! We will provide plenty of fun activities for\nthe whole family. The perfect time to get to know Train World and guaranteed to be a fun outing for\nyoung and old alike.\n\nWhat's on the agenda?\n\nRunning continuously from 10am to 5pm (last hunt starts at 3.30pm)\n\n\u00b7 Family activity \"The Sultan's diamond\"\nAvailable in Dutch, French and Flemish sign language and sign language for French speakers\n\u00b7 Family activity \"Draw me a train\" as part of our temporary exhibition. Through five playful\ntables, you will discover the work of artists like Andr\u00e9 Franquin, Fran\u00e7ois Schuiten and Paul\nDelvaux. During the visit you will be able to make your own SNCB-logo.\nAccessible to families with people with visual impairment using audio description.\n\u00b7 Take a photo with our Train World hosts at your favourite carriage or locomotive (new\nbuilding).\n\u00b7 Get made up during our make-up workshop (Large Ticket Hall)\nFrom 10 til 12 pm and from 1 til 3.3 am.\n\u00b7 Play installation for toddlers The Toddler Train (Hall 4)\nOngoing\n\u00b7 Craft workshop \"Make your own Train World badge\u201d (Hall 4)\nOngoing\nBespoke programme\n\u00b7 Reading nook for 4-10-year-olds (Hall 3, near the small hause)\nOur museum staff love reading aloud. Settle in, take a seat and dream away.\nDuration+- 15 minutes\nAt 11 am and 2.30 pm in Dutch\nAt 11.30 am and 3 pm in French\nIn collaboration with the Schaerbeek libraries.\n\u00b7 On a train journey with a mime (new building)\nA mime show lasts 30 minutes\n\nat 1.30 pm (hall 1), 1 pm (hall 2), 2.30 pm (hall 3), 3 pm (hall 4), 3.30pm (hall 2), 4 pm (hall 3)\nand 4.30 pm (hall 4).\nOur young visitors also receive a lovely souvenir at the end of the visit.\nAll activities are included in the museum entrance fee.\nAnd don't forget to share your best moments by tagging us and mentioning #TrainWorldFamily.","performers":"Train World","boxoffice_url":null,"website":"https:\/\/www.trainworld.be\/en\/family-day-2024","email":"info@trainworld.be","phone_contact":"+32 2 224 74 37","phone_booking":"+32 2 224 74 37","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700003031"},"it":{"name":"Journ\u00e9e familles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.trainworld.be\/fr\/journee-familles-2024","email":"info@trainworld.be","phone_contact":"+32 2 224 74 37","phone_booking":"+32 2 224 74 37","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700003031"},"cn":{"name":"Journ\u00e9e familles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.trainworld.be\/fr\/journee-familles-2024","email":"info@trainworld.be","phone_contact":"+32 2 224 74 37","phone_booking":"+32 2 224 74 37","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700003031"},"fr":{"name":"Journ\u00e9e familles","shortdescr":"Le mardi 29 octobre, c\u2019est la \"Journ\u00e9e Familles\" de Train World ! Venez d\u00e9couvrir notre fabuleux\nmus\u00e9e pendant cette journ\u00e9e remplie d'activit\u00e9s amusantes pour petits et grands. Ce sera un\nagr\u00e9able moment \u00e0 partager en famille.\n\n","longdescr":"Journ\u00e9e familles 2024\nLe mardi 29 octobre, c\u2019est la \"Journ\u00e9e Familles\" de Train World ! Venez d\u00e9couvrir notre fabuleux\nmus\u00e9e pendant cette journ\u00e9e remplie d'activit\u00e9s amusantes pour petits et grands. Ce sera un\nagr\u00e9able moment \u00e0 partager en famille.\nQuel sera le programme ?\nActivit\u00e9s en continue de 10 \u00e0 17h00 (derni\u00e8re entr\u00e9e \u00e0 15h30)\u00a0\n\uf0b7 Jeu famille :\u00a0\"\u00c0 la recherche du diamant du sultan\"\ndisponible en fran\u00e7ais, n\u00e9erlandais, langue des signes FR\/NL de Belgique via votre\nsmartphone.\n\uf0b7 Parcours famille : \u00ab\u00a0dessine-moi un train\u00a0\u00bb con\u00e7u sp\u00e9cialement pour notre exposition. Gr\u00e2ce\n\u00e0 la d\u00e9couverte de cinq tables ludiques vous d\u00e9couvrez l\u2019\u0153uvre d\u2019artistes comme Andr\u00e9\nFranquin, Fran\u00e7ois Schuiten et Paul Delvaux. Un exemple d\u2019activit\u00e9 est la cr\u00e9ation de votre\npropre logo SNCB.\nAccessible pour les familles avec un membre en situation de handicap visuel gr\u00e2ce \u00e0\nl\u2019audiodescription.\n\uf0b7 Shooting photo avec nos Train World hosts \u00e0 c\u00f4t\u00e9 ta voiture ou ton locomotive pr\u00e9f\u00e9r\u00e9.e\n(nouveau b\u00e2timent).\n\uf0b7 Atelier de grimage (Salle des Pas Perdus)\nDe 10 \u00e0 12h et de 13 \u00e0 15h30.\n\uf0b7 Les plus petits sont invit\u00e9s \u00e0 monter \u00e0 bord de notre installation ludique Le Train des Petits\ndans hall 4.\nEn continu\n\uf0b7 Atelier bricolage\u00a0: Fabrique ton propre badge de Train World\u00a0(hall 4)\nEn continu\nActivit\u00e9s avec horaire sp\u00e9cifique\u00a0:\n\uf0b7 Coin lecture d\u2019histoires pour les enfants de 4 \u00e0 10 ans (hall 3, dans les environs de la maison)\no Dur\u00e9e +- 15 minutes.\n\u00c0 11h30 et 15h en fran\u00e7ais\n\u00c0 11h, et 14h30 en n\u00e9erlandais\nEn collaboration avec la biblioth\u00e8que de Schaerbeek.\n\uf0b7 Le mime qui voyage en train\u00a0(dans le nouveau b\u00e2timent)\nDur\u00e9e 30 minutes\n\u00e0 13h30 (hall 1),\u00a014h (hall 2), 14h30 (hall 3), 15h (hall 4), 15h30 (hall 2), 16h (hall 3) 16h30\n(hall 4).\nNos jeunes visiteurs recevront \u00e9galement une petite surprise \u00e0 la fin de leur visite !\n\nToutes les activit\u00e9s sont gratuites \u00e0 l\u2019achat du ticket d\u2019entr\u00e9e.\nPartagez vos plus beaux moments de la journ\u00e9e via le #TrainWorldFamily.","performers":"Train World","boxoffice_url":null,"website":"https:\/\/www.trainworld.be\/fr\/journee-familles-2024","email":"info@trainworld.be","phone_contact":"+32 2 224 74 37","phone_booking":"+32 2 224 74 37","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700003031"},"sp":{"name":"Journ\u00e9e familles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.trainworld.be\/fr\/journee-familles-2024","email":"info@trainworld.be","phone_contact":"+32 2 224 74 37","phone_booking":"+32 2 224 74 37","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700003031"},"nl":{"name":"Journ\u00e9e familles","shortdescr":"Op dinsdag 29 oktober organiseren we weer onze familiedag! We voorzien tal van leuke activiteiten\nvoor het ganse gezin. Een uitgelezen moment om Train World te leren kennen en gegarandeerd een\nleuke uitstap voor jong en oud.","longdescr":"Familiedag 2024\nOp dinsdag 29 oktober organiseren we weer onze familiedag! We voorzien tal van leuke activiteiten\nvoor het ganse gezin. Een uitgelezen moment om Train World te leren kennen en gegarandeerd een\nleuke uitstap voor jong en oud.\nWat staat er allemaal op het programma?\nDoorlopend van 10u00 tot 17u00 (de laatste zoektocht start om 15u30)\n\uf0b7 Familieactiviteit \"Van schets tot trein\"\u00a0in het kader van onze tijdelijke tentoonstelling. Aan\nde hand van vijf speelse tafels ga je aan de slag met het werk van kunstenaars als Andr\u00e9\nFranquin, Fran\u00e7ois Schuiten en Paul Delvaux. Tijdens het bezoek maak je jouw eigen NMBS\nlogo.\nToegankelijk voor gezinnen met mensen met een visuele beperking dankzij audiodescriptie.\n\uf0b7 Familieactiviteit \"Op zoek naar de diamant van de sultan\"\nBeschikbaar in het Nederlands, Frans en Vlaamse gebarentaal en gebarentaal voor\nFranstaligen met je smartphone\n\uf0b7 Neem een foto met onze Train World hosts bij jouw favoriete rijtuig of locomotief\n(nieuwbouw).\n\uf0b7 Schminkworkshop (Grote Lokettenzaal).\nVan 10u tot 12u en van 13u tot 15u30.\n\uf0b7 Speelinstallatie voor de allerkleinsten: De Peutertrein\u00a0(hal 4)\n\uf0b7 Knutselatelier \u201cMaak je eigen badge van Train World\u201d (hal 4)\nDoorlopend\nSpecifiek programma\n\uf0b7 Voorleeshoek voor 4 tot 10-jarigen (hal 3, in de buurt van het huisje) \u00a0\nOnze museummedewerkers lezen graag voor. Kom af, zet je neer en droom weg.\nDuur +- 15 minuten\nOm 11u, en 14u30 in het Nederlands\nOm 11u30 en 15u in het Frans\nIn samenwerking met de bibliotheken van Schaarbeek.\n\uf0b7 Met mime op treinreis (in de nieuwbouw)\nElke 30 minuten is er een mimetoneel\nOm 13u30 (hal 1), 14u (hal 2), 14u30 (hal 3), 15u (hal 4), 15u30 (hal 2), 16u (hal 3), 16u30\n(hal 4).\n\nOnze jonge bezoekers krijgen op het einde van het bezoek ook nog een leuk aandenken mee.\nAlle activiteiten zijn inbegrepen in de toegangsprijs van het museum.\n\nEn vergeet niet je mooiste momenten te delen door ons te taggen en #TrainWorldFamily te\nvermelden.","performers":"Train World","boxoffice_url":null,"website":"https:\/\/www.trainworld.be\/nl\/familiedag-2024","email":"info@trainworld.be","phone_contact":"+32 2 224 74 37","phone_booking":"+32 2 224 74 37","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700003031"}},"place":{"id":252663,"translations":{"de":{"name":"Train World","address_street_name":"Place Princesse Elisabeth","address_street_number":"5","address_street_box":null,"email":"info@trainworld.be","website":"http:\/\/www.trainworld.be","phone_contact":"+32 490 47 94 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Place Princesse Elisabeth, 5","address_line2":"1030 Schaerbeek","description_web":"N\u00e4chste Haltestelle Train World... kleine und gro\u00dfe Eisenbahnfreunde erwartet in Br\u00fcssel ein neues \u201eMekka\": In dem historischen Geb\u00e4ude des ehemaligen Bahnhofs von Schaerbeek erwartet Sie das spektakul\u00e4re Eisenbahnmuseum Train World, dessen Szenographie aus der Feder des belgischen Comic-K\u00fcnstlers Fran\u00e7ois Schuiten stammt.\r\n\r\nSch\u00e4tze aus der Welt der Eisenbahn: Von der \u00e4ltesten Dampflokomotive Belgiens \u00fcber prunkvolle k\u00f6nigliche Wagons bis hin zu den modernen Hochgeschwindigkeitsz\u00fcgen - Train World f\u00fchrt die Besucher durch die belgische Eisenbahngeschichte. Neben historischem und technischem Wissen gibt es auch Anekdoten und Kuriosit\u00e4ten aus der Welt der Eisenbahn zu entdecken. Wie ist eine Schiene aufgebaut, wie schnell fuhren die ersten Dampfloks, wie reisten einst die K\u00f6nige? Antworten auf all diese Fragen geben die Erkl\u00e4rungstafeln, die auch auf Deutsch zur Verf\u00fcgung stehen, sowie die kostenlosen Audioguides (ebenfalls auf Deutsch).\r\n\r\nFahrsimulator: Sie haben schon immer davon getr\u00e4umt, Lokomotivf\u00fchrer zu werden? Dann nehmen Sie Platz im F\u00fchrerstand des Fahrsimulators und begeben sich auf eine Reise durch die Eisenbahngeschichte.\r\n\r\nLeibliches Wohl:\r\n\r\nIn der Brasserie \"RN Express\", die in dem historischen Bahnhofsgeb\u00e4ude untergebracht ist, gibt es Speisen und Getr\u00e4nke. Tiefblaue W\u00e4nde, gl\u00e4serne Kugellampen und Holzmobiliar sorgen f\u00fcr ein besonderes Ambiente.\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Train World","address_street_name":"Place Princesse Elisabeth","address_street_number":"5","address_street_box":null,"email":"info@trainworld.be","website":"http:\/\/www.trainworld.be","phone_contact":"+32 490 47 94 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Place Princesse Elisabeth, 5","address_line2":"1030 Schaerbeek","description_web":"Train World, o novo polo de atra\u00e7\u00e3o de Bruxelas\r\nTrain World, a montra dos caminhos de ferro de ontem, de hoje e de amanh\u00e3, \u00e9 a nova atra\u00e7\u00e3o tur\u00edstica de Bruxelas desde setembro de 2015. O local situa-se em Schaerbeek, a alguns minutos de comboio da Esta\u00e7\u00e3o Central (pr\u00f3ximo da Grand-Place).\r\nN\u00e3o est\u00e3o a\u00ed expostas apenas as pe\u00e7as mais belas da cole\u00e7\u00e3o de locomotivas e de ve\u00edculos hist\u00f3ricos dos caminhos de ferro belgas, mas tamb\u00e9m \u00e9 ilustrado o papel importante do comboio na mobilidade atual e do futuro. Train World \u00e9 mais do que um museu, trata-se de um centro de interpreta\u00e7\u00e3o. A cenografia original \u2013 desenvolvida pelo artista Fran\u00e7ois Schuiten- cria uma experi\u00eancia interativa durante a qual o p\u00fablico pode olhar, ouvir, tocar e deixar-se surpreender por hist\u00f3rias apaixonantes do mundo ferrovi\u00e1rio.\r\nO local, situado ao longo do tra\u00e7ado da primeira linha de caminhos de ferro do continente europeu (Bruxelas\u2013Mechelen, 1835), inclui a esta\u00e7\u00e3o renovada de Schaerbeek, onde se encontra a bilheteira, e uma constru\u00e7\u00e3o nova de 8000 m\u00b2. Note-se que a esta\u00e7\u00e3o, constru\u00edda em 1887, \u00e9 um dos baluartes da arquitetura ferrovi\u00e1ria belga e um monumento classificado. Um estabelecimento de hoteleira e restaura\u00e7\u00e3o situado na esta\u00e7\u00e3o completa a oferta de Train World.\r\nUma oferta muito diversificada destinada a todo o mundo\r\nTrain World aloja in\u00fameros tesouros a descobrir. Por exemplo, \u00e9 poss\u00edvel a\u00ed admirar a locomotiva a vapor mais antiga mantida na B\u00e9lgica, a \u201cPa\u00eds de Waes\u201d. Ou ainda a locomotiva a vapor de carenagem \u201ctipo 12\u201d, que estabeleceu um novo recorde de velocidade em 1939. Tamb\u00e9m \u00e9 poss\u00edvel contemplar aut\u00eanticos e sumptuosos ve\u00edculos reais ou penetrar um dos ve\u00edculos TEE inox, antecessor dos comboios de grande velocidade, que percorriam a Europa na \u00e9poca. Com vontade de assumir o comando de um comboio?\r\nPoder\u00e1 experiment\u00e1-lo, num simulador de condu\u00e7\u00e3o. No lugar do condutor, poder\u00e1 observar as mudan\u00e7as no ambiente das linhas ao longo dos anos.\r\nTrain World apresenta igualmente centenas de objetos do mundo ferrovi\u00e1rio, como uniformes, pinturas ou maquetas de comboios e de esta\u00e7\u00f5es, assim como in\u00fameras fotos e videoclipes. A notar igualmente: a apresenta\u00e7\u00e3o de uma aut\u00eantica casinha de guarda das passagens de n\u00edvel, retomada na nova constru\u00e7\u00e3o de Train World. Estar\u00e1 mobilada com uma decora\u00e7\u00e3o dos anos 50. No s\u00f3t\u00e3o, ser\u00e3o expostos comboios miniatura.\r\nAs escolas e as fam\u00edlias com crian\u00e7as pequenas poder\u00e3o aproveitar uma oferta espec\u00edfica que acentua tanto o aspeto educativo como o l\u00fadico. As crian\u00e7as poder\u00e3o dar espa\u00e7o \u00e0 sua alegria num espa\u00e7o de jogos, como m\u00ednimo, original, especialmente concebido para elas: uma locomotiva a vapor que emerge do solo.\r\nGra\u00e7as \u00e0 colabora\u00e7\u00e3o com os construtores de comboios, as tecnologias modernas e os desenvolvimentos futuros ser\u00e3o tamb\u00e9m abordados. Desse modo, o p\u00fablico poder\u00e1 admirar, por exemplo, tr\u00eas comboios de \u00faltima gera\u00e7\u00e3o.\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Train World","address_street_name":"Prinses Elisabethplein","address_street_number":"5","address_street_box":null,"email":"b2b@trainworld.be","website":"http:\/\/www.trainworld.be","phone_contact":"+32 490 47 94 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Prinses Elisabethplein, 5","address_line2":"1030 Schaerbeek","description_web":"Train World is a unique railway experience that takes you from the very first steam locomotives to the flashing high-speed trains! It is a universe that appeals to all the senses in order to grasp the many different dimensions of the railways. A visit to Train World is an active and surprising outing. You can walk among locomotives, take a seat in 100-year-old trains, visit a railway house and walk across a real railway bridge. You will even experience how it feels to drive a train!\r\n\r\n\r\n","description_print":"Train World, the showcase for the railways of yesterday, today and tomorrow, is a must-see tourist attraction in Brussels. The site is located a few minutes by train from Brussels Central station (near the Grand Place)\r\nHere you will be able to admire the loveliest pieces from the collection of historical locomotives and carriages from the Belgian railways, but it will also illustrate the significant role of the train in the mobility of today and in future. Train World is more than a museum: it will be an experience centre. An original scenography \u2013 designed by artist Fran\u00e7ois Schuiten \u2013 will provide an experience in which the audience can look, listen, touch and be surprised by scintillating stories from the world of trains.\r\nThe site comprises the renovated Schaerbeek station, where the ticket office is located, and a new 8,000 m\u00b2 building. A restaurant and a book & gift shop in the station completes the offering. It will also be possible to have a picnic: a restored carriage will be available in the transit area from the station to the new building for this purpose.\r\n","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Train World","address_street_name":"Place Princesse Elisabeth","address_street_number":"5","address_street_box":null,"email":"info@trainworld.be","website":"http:\/\/www.trainworld.be","phone_contact":"+32 490 47 94 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Place Princesse Elisabeth, 5","address_line2":"1030 Schaerbeek","description_web":"Train World. Il museo nazionale del treno aprir\u00e0 le porte alla stazione di Schaerbeek.\r\nTesori del mondo ferroviario\r\nTrain World custodir\u00e0 numerosi tesori: la pi\u00f9 antica locomotiva conservata in Belgio, la \u201cpaese di Waes\u201d, o la locomotive a vapore carenata \u201ctipo 12\u201d che aveva stabilito un record di velocit\u00e0 nel 1939.\r\n\r\nSimulatore di guida\r\n\r\nAvete sempre avuto voglia di guidare un treno ? Train World vi sistema in un simulatore di guida! Nel posto dell\u2019autista, potrete osservare i cambi dell\u2019ambiente lungo le linee ferroviarie nel corso degli anni.\r\n\r\nScuole e famiglie\r\n\r\nI vostri bambini potranno approfittare di un\u2019offerta specifica che mette l\u2019accanto sia sul aspetto educativo che divertente. Potranno approfittare di un spazio giochi originale.\r\n\r\nSala eventi\r\n\r\nTrain World entra in stazione e Bruxelles si dota di un nuovo luogo per eventi! Con 550 m\u00b2, la magnifica sala degli sportelli della stazione di Schaerbeek, risalendo al 1913, offrir\u00e0 un quadro unico per eventi. Sar\u00e0 dotata di un\u2019installazione audiovisuale moderna. \r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Train World","address_street_name":"Place Princesse Elisabeth","address_street_number":"5","address_street_box":null,"email":"info@trainworld.be","website":"http:\/\/www.trainworld.be","phone_contact":"+32 490 47 94 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Place Princesse Elisabeth, 5","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Train World","address_street_name":"Place Princesse Elisabeth","address_street_number":"5","address_street_box":null,"email":"info@trainworld.be","website":"http:\/\/www.trainworld.be","phone_contact":"+32 490 47 94 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Place Princesse Elisabeth, 5","address_line2":"1030 Schaerbeek","description_web":"Train World est une exp\u00e9rience ferroviaire unique qui vous emm\u00e8ne des toutes premi\u00e8res locomotives \u00e0 vapeur aux trains \u00e0 grande vitesse flamboyants ! C'est un univers qui fait appel \u00e0 tous les sens pour appr\u00e9hender les multiples dimensions du chemin de fer. Une visite \u00e0 Train World est une sortie active et surprenante. Vous pouvez vous promener parmi les locomotives, prendre place dans des trains centenaires, visiter une maison de chemin de fer et traverser un v\u00e9ritable pont ferroviaire. Vous ferez m\u00eame l'exp\u00e9rience de la conduite d'un train !","description_print":"Vitrine du pass\u00e9, du pr\u00e9sent et du futur sur le monde ferroviaire, Train World est le nom du nouveau mus\u00e9e des chemins de fer, actuellement en construction pr\u00e8s de la gare de Schaerbeek. Il abritera les pi\u00e8ces les plus pr\u00e9cieuses du patrimoine historique.Train World rendra hommage \u00e0 la riche histoire du train, mais d\u00e9montrera aussi que les chemins de fer n'ont pas fini de jouer un r\u00f4le important dans le d\u00e9veloppement de notre pays.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Train World","address_street_name":"Place Princesse Elisabeth","address_street_number":"5","address_street_box":null,"email":"info@trainworld.be","website":"http:\/\/www.trainworld.be","phone_contact":"+32 490 47 94 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Place Princesse Elisabeth, 5","address_line2":"1030 Schaerbeek","description_web":"Train World, la nueva atracci\u00f3n tur\u00edstica de Bruselas.\r\n\r\nTrain World es un escaparate para los ferrocarriles de ayer, hoy y ma\u00f1ana, es la nueva atracci\u00f3n tur\u00edstica de Bruselas. El lugar est\u00e1 situado a pocos minutos en tren de la Estaci\u00f3n Central de Bruselas (cerca de la Grand Place).\r\n\r\nAqu\u00ed tendr\u00e1s la oportunidad de admirar las piezas m\u00e1s encantadoras de la colecci\u00f3n de trenes y vagones hist\u00f3ricos de los ferrocarriles belgas, pero tambi\u00e9n ilustra el importante papel del tren en la movilidad de hoy en d\u00eda y el futuro. Train World es m\u00e1s que un museo: es un centro en el que podr\u00e1s vivir nuevas experiencias. Con una escenograf\u00eda original \u2013 dise\u00f1ada por el artista Fran\u00e7ois Schuiten \u2013 te ofrece una experiencia en la que puedes mirar, escuchar, tocar y sorprenderte con incre\u00edbles historias del mundo de los trenes.\r\nEl lugar, junto con las primeras v\u00edas ferroviarias del continente europeo, incluye la Estaci\u00f3n Schaerbeek renovada donde se encuentra la taquilla y un nuevo edificio de 8.000 m\u00b2. La antigua estaci\u00f3n, construida en 1887, es una las obras maestras de la arquitectura ferroviaria belga y es patrimonio hist\u00f3rico. Y para completar la oferta encontrar\u00e1s un restaurante y una tienda de regalos en la estaci\u00f3n.\r\n\r\nAlgo para todo el mundo\r\n\r\n\u00a1Hay mucho que descubrir en Train World! Por ejemplo, puedes ver el tren de vapor m\u00e1s antiguo preservado en B\u00e9lgica, la \u201cPays de Waes\u201d. O el tren de vapor simplificado \u201cType 12\u201d, que obtuvo el r\u00e9cord de velocidad en 1939. Puedes admirar el esplendor de los aut\u00e9nticos carruajes reales o pasear en el Trans-Europe Express (TEE) de acero inoxidable \u2013 el predecesor del tren de alta velocidad \u2013 que una vez cruz\u00f3 Europa. \u00bfTe gustar\u00eda conducir un tren? Entonces prueba suerte en uno de los simuladores de tren\u2026 o estudia los cambios que han sufrido los ferrocarriles de ayer y hoy desde una cabina de conductor.\r\n\r\nTambi\u00e9n hay cientos de objetos del mundo de los trenes, tales como uniformes, pinturas o modelos de trenes y estaciones, junto con una abundante cantidad de fotos y fragmentos de pel\u00edculas. Tambi\u00e9n cabe destacar la presencia de una aut\u00e9ntica \u201ccasa de guardabarreras\u201d que ha sido incluida en el nuevo edificio. Est\u00e1 amueblada al estilo de los a\u00f1os 50 y el \u00e1tico tiene un paisaje lleno de trenes en miniatura. \r\nColegios y familias con ni\u00f1os peque\u00f1os pueden disfrutar de ofertas espec\u00edficas, con especial atenci\u00f3n en el aspecto educativo relacionado con los juegos. Los ni\u00f1os pueden disfrutar en el \u201ctren de escalada\u201d, un tren de vapor medio enterrado.\r\n\r\nGracias a la cooperaci\u00f3n con los constructores de tren, la tecnolog\u00eda moderna y el desarrollo futuro tambi\u00e9n est\u00e1n en oferta. Ejemplo de esto son las tres cabinas de tren a tama\u00f1o real de los trenes m\u00e1s modernos.\r\n\r\n\r\n","description_print":"Train World es un escaparate para los ferrocarriles de ayer, hoy y ma\u00f1ana, es la nueva atracci\u00f3n tur\u00edstica de Bruselas. El lugar est\u00e1 situado a pocos minutos en tren de la Estaci\u00f3n Central de Bruselas (cerca de la Grand Place).\r\n\r\nAqu\u00ed tendr\u00e1s la oportunidad de admirar las piezas m\u00e1s encantadoras de la colecci\u00f3n de trenes y vagones hist\u00f3ricos de los ferrocarriles belgas, pero tambi\u00e9n ilustra el importante papel del tren en la movilidad de hoy en d\u00eda y el futuro. Train World es m\u00e1s que un museo: es un centro en el que podr\u00e1s vivir nuevas experiencias. Con una escenograf\u00eda original \u2013 dise\u00f1ada por el artista Fran\u00e7ois Schuiten \u2013 te ofrece una experiencia en la que puedes mirar, escuchar, tocar y sorprenderte con incre\u00edbles historias del mundo de los trenes.\r\nEl lugar, junto con las primeras v\u00edas ferroviarias del continente europeo, incluye la Estaci\u00f3n Schaerbeek renovada donde se encuentra la taquilla y un nuevo edificio de 8.000 m\u00b2. La antigua estaci\u00f3n, construida en 1887, es una las obras maestras de la arquitectura ferroviaria belga y es patrimonio hist\u00f3rico. Y para completar la oferta encontrar\u00e1s un restaurante y una tienda de regalos en la estaci\u00f3n.\r\n\r\nAlgo para todo el mundo\r\n\r\n\u00a1Hay mucho que descubrir en Train World! Por ejemplo, puedes ver el tren de vapor m\u00e1s antiguo preservado en B\u00e9lgica, la \u201cPays de Waes\u201d. O el tren de vapor simplificado \u201cType 12\u201d, que obtuvo el r\u00e9cord de velocidad en 1939. Puedes admirar el esplendor de los aut\u00e9nticos carruajes reales o pasear en el Trans-Europe Express (TEE) de acero inoxidable \u2013 el predecesor del tren de alta velocidad \u2013 que una vez cruz\u00f3 Europa. \u00bfTe gustar\u00eda conducir un tren? Entonces prueba suerte en uno de los simuladores de tren\u2026 o estudia los cambios que han sufrido los ferrocarriles de ayer y hoy desde una cabina de conductor.\r\n\r\nTambi\u00e9n hay cientos de objetos del mundo de los trenes, tales como uniformes, pinturas o modelos de trenes y estaciones, junto con una abundante cantidad de fotos y fragmentos de pel\u00edculas. Tambi\u00e9n cabe destacar la presencia de una aut\u00e9ntica \u201ccasa de guardabarreras\u201d que ha sido incluida en el nuevo edificio. Est\u00e1 amueblada al estilo de los a\u00f1os 50 y el \u00e1tico tiene un paisaje lleno de trenes en miniatura. \r\nColegios y familias con ni\u00f1os peque\u00f1os pueden disfrutar de ofertas espec\u00edficas, con especial atenci\u00f3n en el aspecto educativo relacionado con los juegos. Los ni\u00f1os pueden disfrutar en el \u201ctren de escalada\u201d, un tren de vapor medio enterrado.\r\n\r\nGracias a la cooperaci\u00f3n con los constructores de tren, la tecnolog\u00eda moderna y el desarrollo futuro tambi\u00e9n est\u00e1n en oferta. Ejemplo de esto son las tres cabinas de tren a tama\u00f1o real de los trenes m\u00e1s modernos.\r\n\r\nTrain World will exceptionally be completely closed to the public from Monday 14 October to Monday 21 October 2019 and from Monday 16 March to Tuesday 17 March 2020 because of the assembly and dismantling of our exhibition dedicated to Paul Delvaux.\r\n\r\n","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Train World","address_street_name":"Prinses Elisabethplein","address_street_number":"5","address_street_box":null,"email":"b2b@trainworld.be","website":"http:\/\/www.trainworld.be","phone_contact":"+32 490 47 94 00","phone_booking":null,"address_zip":"1030","address_city":"Schaarbeek","address_line1":"Prinses Elisabethplein, 5","address_line2":"1030 Schaarbeek","description_web":"Train World is een unieke spoorervaring die je van de allereerste stoomlocomotieven tot de flitsende hogesnelheidstreinen brengt! Het is een universum dat een beroep doet op alle zintuigen om de vele verschillende dimensies van de spoorwegen te kunnen bevatten. Een bezoek aan Train World is een actieve en verrassende uitstap. Je wandelt tussen locomotieven, neemt plaats in treinen van 100 jaar oud, bezoekt een spoorweghuisje en loopt over een echte spoorwegbrug. Je ervaart zelfs hoe het voelt om een trein te besturen!","description_print":"Train World is sinds september 2015 het uitstalraam voor de spoorwegen van gisteren, vandaag en morgen in Brussel. De site bevindt zich in Schaarbeek, op nauwelijks 10 minuten met de trein vanuit Brussel-Centraal (bij de Grote Markt). \r\n\r\nDe mooiste stukken uit de collectie historische locomotieven en rijtuigen van de Belgische spoorwegen zijn er te bewonderen, maar daarnaast wordt er ook de belangrijke rol van de trein in de mobiliteit van vandaag en de toekomst ge\u00efllustreerd. Train World is meer dan een museum: het is een belevingscentrum. Een originele scenografie \u2013 ontworpen door kunstenaar Fran\u00e7ois Schuiten - zorgt voor een ervaring waarbij je kan kijken, luisteren, aanraken en verrast worden door de boeiende verhalen uit de wereld van de trein.\r\n\r\n22-10-2019> 15-03-2020 : Tentoonstelling: Paul Delvaux, de man die van treinen hield \r\n\r\nPaul Delvaux (1897-1994) schilderde een meesterlijk oeuvre bijeen, met als inspiratiebron de wereld van de spoorwegen. Zijn surrealistische werken gaan moeiteloos op in de adembenemende scenografie van Train World. Als vanzelf ontstaat een boeiende dialoog.\r\n\r\nDeze expo is h\u00e9t uitgelezen moment om de artistieke evolutie van deze spoorwegliefhebber te ontdekken in een magische setting: van tekeningen, aquarellen en schilderijen uit de jaren 1920 tot monumentale werken uit de jaren 1970, maar ook persoonlijke objecten van de artiest voegen verrassende accenten toe. Dat de schilder in 1984 tot erestationschef van Louvain-la-Neuve werd benoemd, is veelbetekenend.\r\n\r\n","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[20],"translations":{"de":["Norden"],"pt":[null],"en":["North"],"it":["Nord"],"cn":[null],"fr":["Nord"],"sp":["Norte"],"nl":["Noord"]}},"neca":null,"facebook_id":null,"backoffice_id":14733,"location":{"lat":50.877759,"lon":4.378947},"region":"brussels","last_updated_at":"2024-09-03T16:29:21+02:00","published_at":"2013-10-19T01:54:59+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":252663,"translations":{"de":{"name":"Train World","address_street_name":"Place Princesse Elisabeth","address_street_number":"5","address_street_box":null,"email":"info@trainworld.be","website":"http:\/\/www.trainworld.be","phone_contact":"+32 490 47 94 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Place Princesse Elisabeth, 5","address_line2":"1030 Schaerbeek","description_web":"N\u00e4chste Haltestelle Train World... kleine und gro\u00dfe Eisenbahnfreunde erwartet in Br\u00fcssel ein neues \u201eMekka\": In dem historischen Geb\u00e4ude des ehemaligen Bahnhofs von Schaerbeek erwartet Sie das spektakul\u00e4re Eisenbahnmuseum Train World, dessen Szenographie aus der Feder des belgischen Comic-K\u00fcnstlers Fran\u00e7ois Schuiten stammt.\r\n\r\nSch\u00e4tze aus der Welt der Eisenbahn: Von der \u00e4ltesten Dampflokomotive Belgiens \u00fcber prunkvolle k\u00f6nigliche Wagons bis hin zu den modernen Hochgeschwindigkeitsz\u00fcgen - Train World f\u00fchrt die Besucher durch die belgische Eisenbahngeschichte. Neben historischem und technischem Wissen gibt es auch Anekdoten und Kuriosit\u00e4ten aus der Welt der Eisenbahn zu entdecken. Wie ist eine Schiene aufgebaut, wie schnell fuhren die ersten Dampfloks, wie reisten einst die K\u00f6nige? Antworten auf all diese Fragen geben die Erkl\u00e4rungstafeln, die auch auf Deutsch zur Verf\u00fcgung stehen, sowie die kostenlosen Audioguides (ebenfalls auf Deutsch).\r\n\r\nFahrsimulator: Sie haben schon immer davon getr\u00e4umt, Lokomotivf\u00fchrer zu werden? Dann nehmen Sie Platz im F\u00fchrerstand des Fahrsimulators und begeben sich auf eine Reise durch die Eisenbahngeschichte.\r\n\r\nLeibliches Wohl:\r\n\r\nIn der Brasserie \"RN Express\", die in dem historischen Bahnhofsgeb\u00e4ude untergebracht ist, gibt es Speisen und Getr\u00e4nke. Tiefblaue W\u00e4nde, gl\u00e4serne Kugellampen und Holzmobiliar sorgen f\u00fcr ein besonderes Ambiente.\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Train World","address_street_name":"Place Princesse Elisabeth","address_street_number":"5","address_street_box":null,"email":"info@trainworld.be","website":"http:\/\/www.trainworld.be","phone_contact":"+32 490 47 94 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Place Princesse Elisabeth, 5","address_line2":"1030 Schaerbeek","description_web":"Train World, o novo polo de atra\u00e7\u00e3o de Bruxelas\r\nTrain World, a montra dos caminhos de ferro de ontem, de hoje e de amanh\u00e3, \u00e9 a nova atra\u00e7\u00e3o tur\u00edstica de Bruxelas desde setembro de 2015. O local situa-se em Schaerbeek, a alguns minutos de comboio da Esta\u00e7\u00e3o Central (pr\u00f3ximo da Grand-Place).\r\nN\u00e3o est\u00e3o a\u00ed expostas apenas as pe\u00e7as mais belas da cole\u00e7\u00e3o de locomotivas e de ve\u00edculos hist\u00f3ricos dos caminhos de ferro belgas, mas tamb\u00e9m \u00e9 ilustrado o papel importante do comboio na mobilidade atual e do futuro. Train World \u00e9 mais do que um museu, trata-se de um centro de interpreta\u00e7\u00e3o. A cenografia original \u2013 desenvolvida pelo artista Fran\u00e7ois Schuiten- cria uma experi\u00eancia interativa durante a qual o p\u00fablico pode olhar, ouvir, tocar e deixar-se surpreender por hist\u00f3rias apaixonantes do mundo ferrovi\u00e1rio.\r\nO local, situado ao longo do tra\u00e7ado da primeira linha de caminhos de ferro do continente europeu (Bruxelas\u2013Mechelen, 1835), inclui a esta\u00e7\u00e3o renovada de Schaerbeek, onde se encontra a bilheteira, e uma constru\u00e7\u00e3o nova de 8000 m\u00b2. Note-se que a esta\u00e7\u00e3o, constru\u00edda em 1887, \u00e9 um dos baluartes da arquitetura ferrovi\u00e1ria belga e um monumento classificado. Um estabelecimento de hoteleira e restaura\u00e7\u00e3o situado na esta\u00e7\u00e3o completa a oferta de Train World.\r\nUma oferta muito diversificada destinada a todo o mundo\r\nTrain World aloja in\u00fameros tesouros a descobrir. Por exemplo, \u00e9 poss\u00edvel a\u00ed admirar a locomotiva a vapor mais antiga mantida na B\u00e9lgica, a \u201cPa\u00eds de Waes\u201d. Ou ainda a locomotiva a vapor de carenagem \u201ctipo 12\u201d, que estabeleceu um novo recorde de velocidade em 1939. Tamb\u00e9m \u00e9 poss\u00edvel contemplar aut\u00eanticos e sumptuosos ve\u00edculos reais ou penetrar um dos ve\u00edculos TEE inox, antecessor dos comboios de grande velocidade, que percorriam a Europa na \u00e9poca. Com vontade de assumir o comando de um comboio?\r\nPoder\u00e1 experiment\u00e1-lo, num simulador de condu\u00e7\u00e3o. No lugar do condutor, poder\u00e1 observar as mudan\u00e7as no ambiente das linhas ao longo dos anos.\r\nTrain World apresenta igualmente centenas de objetos do mundo ferrovi\u00e1rio, como uniformes, pinturas ou maquetas de comboios e de esta\u00e7\u00f5es, assim como in\u00fameras fotos e videoclipes. A notar igualmente: a apresenta\u00e7\u00e3o de uma aut\u00eantica casinha de guarda das passagens de n\u00edvel, retomada na nova constru\u00e7\u00e3o de Train World. Estar\u00e1 mobilada com uma decora\u00e7\u00e3o dos anos 50. No s\u00f3t\u00e3o, ser\u00e3o expostos comboios miniatura.\r\nAs escolas e as fam\u00edlias com crian\u00e7as pequenas poder\u00e3o aproveitar uma oferta espec\u00edfica que acentua tanto o aspeto educativo como o l\u00fadico. As crian\u00e7as poder\u00e3o dar espa\u00e7o \u00e0 sua alegria num espa\u00e7o de jogos, como m\u00ednimo, original, especialmente concebido para elas: uma locomotiva a vapor que emerge do solo.\r\nGra\u00e7as \u00e0 colabora\u00e7\u00e3o com os construtores de comboios, as tecnologias modernas e os desenvolvimentos futuros ser\u00e3o tamb\u00e9m abordados. Desse modo, o p\u00fablico poder\u00e1 admirar, por exemplo, tr\u00eas comboios de \u00faltima gera\u00e7\u00e3o.\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Train World","address_street_name":"Prinses Elisabethplein","address_street_number":"5","address_street_box":null,"email":"b2b@trainworld.be","website":"http:\/\/www.trainworld.be","phone_contact":"+32 490 47 94 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Prinses Elisabethplein, 5","address_line2":"1030 Schaerbeek","description_web":"Train World is a unique railway experience that takes you from the very first steam locomotives to the flashing high-speed trains! It is a universe that appeals to all the senses in order to grasp the many different dimensions of the railways. A visit to Train World is an active and surprising outing. You can walk among locomotives, take a seat in 100-year-old trains, visit a railway house and walk across a real railway bridge. You will even experience how it feels to drive a train!\r\n\r\n\r\n","description_print":"Train World, the showcase for the railways of yesterday, today and tomorrow, is a must-see tourist attraction in Brussels. The site is located a few minutes by train from Brussels Central station (near the Grand Place)\r\nHere you will be able to admire the loveliest pieces from the collection of historical locomotives and carriages from the Belgian railways, but it will also illustrate the significant role of the train in the mobility of today and in future. Train World is more than a museum: it will be an experience centre. An original scenography \u2013 designed by artist Fran\u00e7ois Schuiten \u2013 will provide an experience in which the audience can look, listen, touch and be surprised by scintillating stories from the world of trains.\r\nThe site comprises the renovated Schaerbeek station, where the ticket office is located, and a new 8,000 m\u00b2 building. A restaurant and a book & gift shop in the station completes the offering. It will also be possible to have a picnic: a restored carriage will be available in the transit area from the station to the new building for this purpose.\r\n","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Train World","address_street_name":"Place Princesse Elisabeth","address_street_number":"5","address_street_box":null,"email":"info@trainworld.be","website":"http:\/\/www.trainworld.be","phone_contact":"+32 490 47 94 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Place Princesse Elisabeth, 5","address_line2":"1030 Schaerbeek","description_web":"Train World. Il museo nazionale del treno aprir\u00e0 le porte alla stazione di Schaerbeek.\r\nTesori del mondo ferroviario\r\nTrain World custodir\u00e0 numerosi tesori: la pi\u00f9 antica locomotiva conservata in Belgio, la \u201cpaese di Waes\u201d, o la locomotive a vapore carenata \u201ctipo 12\u201d che aveva stabilito un record di velocit\u00e0 nel 1939.\r\n\r\nSimulatore di guida\r\n\r\nAvete sempre avuto voglia di guidare un treno ? Train World vi sistema in un simulatore di guida! Nel posto dell\u2019autista, potrete osservare i cambi dell\u2019ambiente lungo le linee ferroviarie nel corso degli anni.\r\n\r\nScuole e famiglie\r\n\r\nI vostri bambini potranno approfittare di un\u2019offerta specifica che mette l\u2019accanto sia sul aspetto educativo che divertente. Potranno approfittare di un spazio giochi originale.\r\n\r\nSala eventi\r\n\r\nTrain World entra in stazione e Bruxelles si dota di un nuovo luogo per eventi! Con 550 m\u00b2, la magnifica sala degli sportelli della stazione di Schaerbeek, risalendo al 1913, offrir\u00e0 un quadro unico per eventi. Sar\u00e0 dotata di un\u2019installazione audiovisuale moderna. \r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Train World","address_street_name":"Place Princesse Elisabeth","address_street_number":"5","address_street_box":null,"email":"info@trainworld.be","website":"http:\/\/www.trainworld.be","phone_contact":"+32 490 47 94 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Place Princesse Elisabeth, 5","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Train World","address_street_name":"Place Princesse Elisabeth","address_street_number":"5","address_street_box":null,"email":"info@trainworld.be","website":"http:\/\/www.trainworld.be","phone_contact":"+32 490 47 94 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Place Princesse Elisabeth, 5","address_line2":"1030 Schaerbeek","description_web":"Train World est une exp\u00e9rience ferroviaire unique qui vous emm\u00e8ne des toutes premi\u00e8res locomotives \u00e0 vapeur aux trains \u00e0 grande vitesse flamboyants ! C'est un univers qui fait appel \u00e0 tous les sens pour appr\u00e9hender les multiples dimensions du chemin de fer. Une visite \u00e0 Train World est une sortie active et surprenante. Vous pouvez vous promener parmi les locomotives, prendre place dans des trains centenaires, visiter une maison de chemin de fer et traverser un v\u00e9ritable pont ferroviaire. Vous ferez m\u00eame l'exp\u00e9rience de la conduite d'un train !","description_print":"Vitrine du pass\u00e9, du pr\u00e9sent et du futur sur le monde ferroviaire, Train World est le nom du nouveau mus\u00e9e des chemins de fer, actuellement en construction pr\u00e8s de la gare de Schaerbeek. Il abritera les pi\u00e8ces les plus pr\u00e9cieuses du patrimoine historique.Train World rendra hommage \u00e0 la riche histoire du train, mais d\u00e9montrera aussi que les chemins de fer n'ont pas fini de jouer un r\u00f4le important dans le d\u00e9veloppement de notre pays.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Train World","address_street_name":"Place Princesse Elisabeth","address_street_number":"5","address_street_box":null,"email":"info@trainworld.be","website":"http:\/\/www.trainworld.be","phone_contact":"+32 490 47 94 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Place Princesse Elisabeth, 5","address_line2":"1030 Schaerbeek","description_web":"Train World, la nueva atracci\u00f3n tur\u00edstica de Bruselas.\r\n\r\nTrain World es un escaparate para los ferrocarriles de ayer, hoy y ma\u00f1ana, es la nueva atracci\u00f3n tur\u00edstica de Bruselas. El lugar est\u00e1 situado a pocos minutos en tren de la Estaci\u00f3n Central de Bruselas (cerca de la Grand Place).\r\n\r\nAqu\u00ed tendr\u00e1s la oportunidad de admirar las piezas m\u00e1s encantadoras de la colecci\u00f3n de trenes y vagones hist\u00f3ricos de los ferrocarriles belgas, pero tambi\u00e9n ilustra el importante papel del tren en la movilidad de hoy en d\u00eda y el futuro. Train World es m\u00e1s que un museo: es un centro en el que podr\u00e1s vivir nuevas experiencias. Con una escenograf\u00eda original \u2013 dise\u00f1ada por el artista Fran\u00e7ois Schuiten \u2013 te ofrece una experiencia en la que puedes mirar, escuchar, tocar y sorprenderte con incre\u00edbles historias del mundo de los trenes.\r\nEl lugar, junto con las primeras v\u00edas ferroviarias del continente europeo, incluye la Estaci\u00f3n Schaerbeek renovada donde se encuentra la taquilla y un nuevo edificio de 8.000 m\u00b2. La antigua estaci\u00f3n, construida en 1887, es una las obras maestras de la arquitectura ferroviaria belga y es patrimonio hist\u00f3rico. Y para completar la oferta encontrar\u00e1s un restaurante y una tienda de regalos en la estaci\u00f3n.\r\n\r\nAlgo para todo el mundo\r\n\r\n\u00a1Hay mucho que descubrir en Train World! Por ejemplo, puedes ver el tren de vapor m\u00e1s antiguo preservado en B\u00e9lgica, la \u201cPays de Waes\u201d. O el tren de vapor simplificado \u201cType 12\u201d, que obtuvo el r\u00e9cord de velocidad en 1939. Puedes admirar el esplendor de los aut\u00e9nticos carruajes reales o pasear en el Trans-Europe Express (TEE) de acero inoxidable \u2013 el predecesor del tren de alta velocidad \u2013 que una vez cruz\u00f3 Europa. \u00bfTe gustar\u00eda conducir un tren? Entonces prueba suerte en uno de los simuladores de tren\u2026 o estudia los cambios que han sufrido los ferrocarriles de ayer y hoy desde una cabina de conductor.\r\n\r\nTambi\u00e9n hay cientos de objetos del mundo de los trenes, tales como uniformes, pinturas o modelos de trenes y estaciones, junto con una abundante cantidad de fotos y fragmentos de pel\u00edculas. Tambi\u00e9n cabe destacar la presencia de una aut\u00e9ntica \u201ccasa de guardabarreras\u201d que ha sido incluida en el nuevo edificio. Est\u00e1 amueblada al estilo de los a\u00f1os 50 y el \u00e1tico tiene un paisaje lleno de trenes en miniatura. \r\nColegios y familias con ni\u00f1os peque\u00f1os pueden disfrutar de ofertas espec\u00edficas, con especial atenci\u00f3n en el aspecto educativo relacionado con los juegos. Los ni\u00f1os pueden disfrutar en el \u201ctren de escalada\u201d, un tren de vapor medio enterrado.\r\n\r\nGracias a la cooperaci\u00f3n con los constructores de tren, la tecnolog\u00eda moderna y el desarrollo futuro tambi\u00e9n est\u00e1n en oferta. Ejemplo de esto son las tres cabinas de tren a tama\u00f1o real de los trenes m\u00e1s modernos.\r\n\r\n\r\n","description_print":"Train World es un escaparate para los ferrocarriles de ayer, hoy y ma\u00f1ana, es la nueva atracci\u00f3n tur\u00edstica de Bruselas. El lugar est\u00e1 situado a pocos minutos en tren de la Estaci\u00f3n Central de Bruselas (cerca de la Grand Place).\r\n\r\nAqu\u00ed tendr\u00e1s la oportunidad de admirar las piezas m\u00e1s encantadoras de la colecci\u00f3n de trenes y vagones hist\u00f3ricos de los ferrocarriles belgas, pero tambi\u00e9n ilustra el importante papel del tren en la movilidad de hoy en d\u00eda y el futuro. Train World es m\u00e1s que un museo: es un centro en el que podr\u00e1s vivir nuevas experiencias. Con una escenograf\u00eda original \u2013 dise\u00f1ada por el artista Fran\u00e7ois Schuiten \u2013 te ofrece una experiencia en la que puedes mirar, escuchar, tocar y sorprenderte con incre\u00edbles historias del mundo de los trenes.\r\nEl lugar, junto con las primeras v\u00edas ferroviarias del continente europeo, incluye la Estaci\u00f3n Schaerbeek renovada donde se encuentra la taquilla y un nuevo edificio de 8.000 m\u00b2. La antigua estaci\u00f3n, construida en 1887, es una las obras maestras de la arquitectura ferroviaria belga y es patrimonio hist\u00f3rico. Y para completar la oferta encontrar\u00e1s un restaurante y una tienda de regalos en la estaci\u00f3n.\r\n\r\nAlgo para todo el mundo\r\n\r\n\u00a1Hay mucho que descubrir en Train World! Por ejemplo, puedes ver el tren de vapor m\u00e1s antiguo preservado en B\u00e9lgica, la \u201cPays de Waes\u201d. O el tren de vapor simplificado \u201cType 12\u201d, que obtuvo el r\u00e9cord de velocidad en 1939. Puedes admirar el esplendor de los aut\u00e9nticos carruajes reales o pasear en el Trans-Europe Express (TEE) de acero inoxidable \u2013 el predecesor del tren de alta velocidad \u2013 que una vez cruz\u00f3 Europa. \u00bfTe gustar\u00eda conducir un tren? Entonces prueba suerte en uno de los simuladores de tren\u2026 o estudia los cambios que han sufrido los ferrocarriles de ayer y hoy desde una cabina de conductor.\r\n\r\nTambi\u00e9n hay cientos de objetos del mundo de los trenes, tales como uniformes, pinturas o modelos de trenes y estaciones, junto con una abundante cantidad de fotos y fragmentos de pel\u00edculas. Tambi\u00e9n cabe destacar la presencia de una aut\u00e9ntica \u201ccasa de guardabarreras\u201d que ha sido incluida en el nuevo edificio. Est\u00e1 amueblada al estilo de los a\u00f1os 50 y el \u00e1tico tiene un paisaje lleno de trenes en miniatura. \r\nColegios y familias con ni\u00f1os peque\u00f1os pueden disfrutar de ofertas espec\u00edficas, con especial atenci\u00f3n en el aspecto educativo relacionado con los juegos. Los ni\u00f1os pueden disfrutar en el \u201ctren de escalada\u201d, un tren de vapor medio enterrado.\r\n\r\nGracias a la cooperaci\u00f3n con los constructores de tren, la tecnolog\u00eda moderna y el desarrollo futuro tambi\u00e9n est\u00e1n en oferta. Ejemplo de esto son las tres cabinas de tren a tama\u00f1o real de los trenes m\u00e1s modernos.\r\n\r\nTrain World will exceptionally be completely closed to the public from Monday 14 October to Monday 21 October 2019 and from Monday 16 March to Tuesday 17 March 2020 because of the assembly and dismantling of our exhibition dedicated to Paul Delvaux.\r\n\r\n","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Train World","address_street_name":"Prinses Elisabethplein","address_street_number":"5","address_street_box":null,"email":"b2b@trainworld.be","website":"http:\/\/www.trainworld.be","phone_contact":"+32 490 47 94 00","phone_booking":null,"address_zip":"1030","address_city":"Schaarbeek","address_line1":"Prinses Elisabethplein, 5","address_line2":"1030 Schaarbeek","description_web":"Train World is een unieke spoorervaring die je van de allereerste stoomlocomotieven tot de flitsende hogesnelheidstreinen brengt! Het is een universum dat een beroep doet op alle zintuigen om de vele verschillende dimensies van de spoorwegen te kunnen bevatten. Een bezoek aan Train World is een actieve en verrassende uitstap. Je wandelt tussen locomotieven, neemt plaats in treinen van 100 jaar oud, bezoekt een spoorweghuisje en loopt over een echte spoorwegbrug. Je ervaart zelfs hoe het voelt om een trein te besturen!","description_print":"Train World is sinds september 2015 het uitstalraam voor de spoorwegen van gisteren, vandaag en morgen in Brussel. De site bevindt zich in Schaarbeek, op nauwelijks 10 minuten met de trein vanuit Brussel-Centraal (bij de Grote Markt). \r\n\r\nDe mooiste stukken uit de collectie historische locomotieven en rijtuigen van de Belgische spoorwegen zijn er te bewonderen, maar daarnaast wordt er ook de belangrijke rol van de trein in de mobiliteit van vandaag en de toekomst ge\u00efllustreerd. Train World is meer dan een museum: het is een belevingscentrum. Een originele scenografie \u2013 ontworpen door kunstenaar Fran\u00e7ois Schuiten - zorgt voor een ervaring waarbij je kan kijken, luisteren, aanraken en verrast worden door de boeiende verhalen uit de wereld van de trein.\r\n\r\n22-10-2019> 15-03-2020 : Tentoonstelling: Paul Delvaux, de man die van treinen hield \r\n\r\nPaul Delvaux (1897-1994) schilderde een meesterlijk oeuvre bijeen, met als inspiratiebron de wereld van de spoorwegen. Zijn surrealistische werken gaan moeiteloos op in de adembenemende scenografie van Train World. Als vanzelf ontstaat een boeiende dialoog.\r\n\r\nDeze expo is h\u00e9t uitgelezen moment om de artistieke evolutie van deze spoorwegliefhebber te ontdekken in een magische setting: van tekeningen, aquarellen en schilderijen uit de jaren 1920 tot monumentale werken uit de jaren 1970, maar ook persoonlijke objecten van de artiest voegen verrassende accenten toe. Dat de schilder in 1984 tot erestationschef van Louvain-la-Neuve werd benoemd, is veelbetekenend.\r\n\r\n","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":14733,"location":{"lat":50.877759,"lon":4.378947},"last_updated_at":"2024-09-03T16:29:21+02:00","published_at":"2013-10-19T01:54:59+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/989dca3e295b0571924abb6fd51735aab1e416f5.jpg","width":1536,"height":2048,"ratio":0.75,"oEmbed_height":2048,"oEmbed_width":1536,"translations":{"de":{"title":"Journ\u00e9e familles","copyright":null},"pt":{"title":"Journ\u00e9e familles","copyright":null},"en":{"title":"Journ\u00e9e familles","copyright":null},"it":{"title":"Journ\u00e9e familles","copyright":null},"cn":{"title":"Journ\u00e9e familles","copyright":null},"fr":{"title":"Journ\u00e9e familles","copyright":null},"sp":{"title":"Journ\u00e9e familles","copyright":null},"nl":{"title":"Journ\u00e9e familles","copyright":null}}},{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/8c0025a52e23db8470003a97f2429df4705105ae.jpg","width":1600,"height":1200,"ratio":1.33,"oEmbed_height":1200,"oEmbed_width":1600,"translations":{"de":{"title":"Journ\u00e9e familles","copyright":null},"pt":{"title":"Journ\u00e9e familles","copyright":null},"en":{"title":"Journ\u00e9e familles","copyright":null},"it":{"title":"Journ\u00e9e familles","copyright":null},"cn":{"title":"Journ\u00e9e familles","copyright":null},"fr":{"title":"Journ\u00e9e familles","copyright":null},"sp":{"title":"Journ\u00e9e familles","copyright":null},"nl":{"title":"Journ\u00e9e familles","copyright":null}}},{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/7acaebd8d09c91882e1d517bbfecedc0b829a798.jpg","width":1728,"height":2160,"ratio":0.8,"oEmbed_height":2160,"oEmbed_width":1728,"translations":{"de":{"title":"Journ\u00e9e familles","copyright":null},"pt":{"title":"Journ\u00e9e familles","copyright":null}