agram.com\/perspective_s_festival\/?hl=fr","email":"perspectives.festival@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50009631"},"en":{"name":"Perspective.s Festival","shortdescr":"Welcome to the Perspective(s) Festival, a festival dedicated to art and culture organized by students of the Master's in Cultural Management at ULB.\n\nFrom April 24th to May 4th, 2024, immerse yourself in a series of 10 events, ranging from film screenings to DJ sets, artistic performances, exhibitions, stand-up comedy, podcast, punk concerts, and musical shows.","longdescr":"Perspective(s) Festival invites you to transcend boundaries and immerse yourself in a realm where creativity knows no limits. Prepare to be captivated and inspired by the diversity of artistic expression that awaits !\n\nAt Maison des Arts, Avenue Jeanne 56 - 1050 Brussels\n\n+ Friday 3rd May at Pilar Box (VUB), Triomflaan, VUB  Entrance 6 , 1050 Brussels\nhttps:\/\/pilar.brussels\/nl\/events\/perspective-s-festival-presents-art-tech-music-event ","performers":null,"boxoffice_url":null,"website":"https:\/\/www.instagram.com\/perspective_s_festival\/?hl=fr","email":"perspectives.festival@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50009631"},"it":{"name":"Perspective.s Festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.instagram.com\/perspective_s_festival\/?hl=fr","email":"perspectives.festival@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50009631"},"cn":{"name":"Perspective.s Festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.instagram.com\/perspective_s_festival\/?hl=fr","email":"perspectives.festival@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50009631"},"fr":{"name":"Perspective.s Festival","shortdescr":"Bienvenue au Perspective.s Festival, un festival consacr\u00e9 \u00e0 l\u2019art et la culture et organis\u00e9 par les \u00e9tudiant.e.s du Master en Gestion Culturelle de l'ULB.\nDu 24 avril au 4 mai 2024, plongez dans une s\u00e9rie de 10 \u00e9v\u00e9nements in\u00e9dits, allant des projections en passant par les DJ sets, les performances artistiques, les expositions, le stand-up, jusqu'au concert punk, au podcast et au spectacle musical.","longdescr":"Perspective.s Festival vous invite \u00e0 transcender les fronti\u00e8res et \u00e0 vous immerger dans un monde o\u00f9 la cr\u00e9ativit\u00e9 ne conna\u00eet aucune limite. Pr\u00e9parez-vous \u00e0 \u00eatre \u00e9merveill\u00e9.e.s et inspir\u00e9.e.s par la diversit\u00e9 de la cr\u00e9ation artistique !\n\n\u00c0 la Maison des Arts, Avenue Jeanne 56 - 1050 Bruxelles\n\n+ Vendredi 3 mai \u00e0 Pilar Box (VUB) - Triomflaan, VUB  Entrance 6 , 1050 Bruxelles\nhttps:\/\/pilar.brussels\/nl\/events\/perspective-s-festival-presents-art-tech-music-event ","performers":null,"boxoffice_url":null,"website":"https:\/\/www.instagram.com\/perspective_s_festival\/?hl=fr","email":"perspectives.festival@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50009631"},"sp":{"name":"Perspective.s Festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.instagram.com\/perspective_s_festival\/?hl=fr","email":"perspectives.festival@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50009631"},"nl":{"name":"Perspective.s Festival","shortdescr":"Welkom op het Perspective(s) Festival, een festival gewijd aan kunst en cultuur georganiseerd door studenten van de Master in Cultureel Management aan de ULB.\n\nDuik van 24 april tot 4 mei 2024 in een avontuurlijke reeks van 10 evenementen, gaande van filmvertoningen en DJ-sets, tot artistieke performances, tentoonstellingen, muzikale shows, podcast, punkconcerten en stand-up comedy.","longdescr":"Het Perspective(s) Festival daagt je uit om voorbij de grenzen van een normatief festival te denken. Laat jezelf onderdompelen in een speeltuin van creativiteit, diversiteit en artistieke expressie waar inspiratie en betovering de plak zwaaien!\n\nIn het Huis der Kunsten, Jeanne-laan 56 - 1050 Brussel\n\n+ Vrijdag 3 mei bij Pilar Box (VUB) Triomflaan, VUB  Entrance 6 , 1050 Brussel\nhttps:\/\/pilar.brussels\/nl\/events\/perspective-s-festival-presents-art-tech-music-event ","performers":null,"boxoffice_url":null,"website":"https:\/\/www.instagram.com\/perspective_s_festival\/?hl=fr","email":"perspectives.festival@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50009631"}},"place":{"last_updated_at":"2024-04-15T17:49:27+02:00","published_at":"2024-04-15T17:49:27+02:00","id":50001516,"translations":{"de":{"name":"Universit\u00e9 Libre de Bruxelles","address_street_name":"Avenue Jeanne","address_street_number":"56","address_street_box":null,"email":"perspectives.festival@gmail.com","website":"https:\/\/www.instagram.com\/perspective_s_festival\/?hl=fr","phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Jeanne, 56","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Universit\u00e9 Libre de Bruxelles","address_street_name":"Avenue Jeanne","address_street_number":"56","address_street_box":null,"email":"perspectives.festival@gmail.com","website":"https:\/\/www.instagram.com\/perspective_s_festival\/?hl=fr","phone_contact":null,"phone_booking":null,"address_zip":"1050","address