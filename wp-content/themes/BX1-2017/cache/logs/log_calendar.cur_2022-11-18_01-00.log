","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.538635"},"en":{"name":"David Linx & Gr\u00e9gory Privat","shortdescr":"Gregory Privat and David Linx are presenting the latter's new album \"Be My Guest: The Duos Project\".","longdescr":"Gregory Privat and David Linx present a \"Jazz\" album but not only! Narration, poetry, songs, music... \r\nWith \" Be My Guest : The Duos Project \", we travel. In French, in Portuguese, in English, or also in Spanish. \r\nDavid Linx together with Gregory Privat on the piano, will propose us this evening to discover this fabulous album!","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.538635"},"de":{"name":"David Linx & Gr\u00e9gory Privat","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.538635"},"it":{"name":"David Linx & Gr\u00e9gory Privat","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.538635"},"sp":{"name":"David Linx & Gr\u00e9gory Privat","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.538635"},"pt":{"name":"David Linx & Gr\u00e9gory Privat","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-deta