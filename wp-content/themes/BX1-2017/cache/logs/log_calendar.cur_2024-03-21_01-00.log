ions":{}},"tags":["major_event","kids"]},{"id":50007332,"date_start":"2024-03-10","date_end":"2024-03-22","date_next":"2024-03-22","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-03-12T01:05:12+01:00","published_at":"2024-02-15T10:52:48+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":294601,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"theatre","ranking":0.5358322898371244,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":49,"translations":{"de":"Theater","pt":null,"en":"Theatre","it":"Teatro","cn":null,"fr":"Th\u00e9\u00e2tre","sp":"Teatro","nl":"Theater"}},"others":{"list":[50],"translations":{"de":["Theater"],"pt":[null],"en":["Theatre"],"it":["Teatro"],"cn":[null],"fr":["Th\u00e9\u00e2tre"],"sp":["Teatro"],"nl":["Theater"]}}},"translations":{"de":{"name":"Dans la mesure de l'impossible, lecture \/ d\u00e9bat - Infini Th\u00e9\u00e2tre","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.tricoterie.be\/","email":"info@infinitheatre.be","phone_contact":"+32 2 537 96 69","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50007332"},"pt":{"name":"Dans la mesure de l'impossible, lecture \/ d\u00e9bat - Infini Th\u00e9\u00e2tre","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.tricoterie.be\/","email":"info@infinitheatre.be","phone_contact":"+32 2 537 96 69","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50007332"},"en":{"name":"Dans la mesure de l'impossible, lecture \/ d\u00e9bat - Infini Th\u00e9\u00e2tre","shortdescr":"D\u2019envergure universelle, ce texte e\u0301mouvant, d\u2019une grande since\u0301rite\u0301, met l\u2019urgence a\u0300 distance, ce qui sans doute est la meilleure mani\u00e8re de la donner \u00e0 entendre.","longdescr":"Dans la mesure de l\u2019impossible te\u0301moigne d\u2019un monde qui co\u0302toie le chaos.\nTiago Rodrigues, l\u2019auteur, fils d\u2019une me\u0300re me\u0301decin et d\u2019un pe\u0300re journaliste, s\u2019est souvent demande\u0301 pourquoi il avait choisi de raconter le monde pluto\u0302t que de le sauver en agissant de manie\u0300re plus concre\u0300te.\nDominique Serron se pose souvent la me\u0302me question face a\u0300 l\u2019e\u0301phe\u0301me\u0300re des jeux du the\u0301a\u0302tre, a\u0300 ses incorrigibles grimaces et, par ailleurs, face a\u0300 projets de vie au plus proche de l\u2019essentiel. l\u2019intime besoin qu\u2019elle a d\u2019aider et d\u2019enraciner ses projets de vie au plus proche de l\u2019essentiel\nElle choisit ce texte avec son e\u0301quipe pour, une fois de plus, rapprocher fiction et re\u0301alite\u0301. Relier la salle et la sce\u0300ne par une proximite\u0301 n\u00e9cessaire, s\u2019ouvrir \u00e0 parler des autres. Une rencontre fertile, puisqu\u2019elle donner aussi lieu, \u00e0 des animations-d\u00e9bats, t\u00e9moignages, ateliers ou conf\u00e9rences\nPour construire cette pie\u0300ce, l\u2019auteur avait rencontre\u0301, a\u0300 Gene\u0300ve, des travailleurs de l\u2019humanitaire officiant pour le Comite\u0301 international de la Croix-Rouge ou pour Me\u0301decins sans frontie\u0300res. Pour autant, cela ne rele\u0300ve pas du the\u0301a\u0302tre documentaire mais d\u2019un the\u0301a\u0302tre documente\u0301, qui assume la mise en forme du re\u0301el. En menant une se\u0301rie d\u2019entretiens avec des personnes engage\u0301es dans l\u2019action humanitaire, Tiago Rodrigues en a tire\u0301 un projet intimiste mais universel qui rend compte des de\u0301sastres collectifs.\nOn y renifle l\u2019odeur de la mort, des choses impossibles a\u0300 s\u2019imaginer, a\u0300 voir, des choses presque impossible \u00e0 raconter. Et pourtant... D\u2019envergure universelle, ce texte e\u0301mouvant, d\u2019une grande since\u0301rite\u0301, met l\u2019urgence a\u0300 distance, ce qui sans doute est la meilleure mani\u00e8re de la donner \u00e0 entendre.\nDate & Heure : 10, 11 et 22\/03 \u00e0 20h30\nTarif : 15\u20ac I 12\u20ac I 7\u20ac (\u00e9tudiant en arts) I Art 27\nSalle : Boudoir ","performers":"Avec Florence Guillaume, Camille L\u00e9onard, F\u00e9lix vannoorenberghe et Laure Volgaire.\nMise en sc\u00e8ne : Dominique Serron\nLecture suivie d'un d\u00e9bat.\nUne production de l'Infini Th\u00e9\u00e2tre","boxoffice_url":null,"website":"https:\/\/www.tricoterie.be\/","email":"info@infinitheatre.be","phone_contact":"+32 2 537 96 69","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50007332"},"it":{"name":"Dans la mesure de l'impossible, lecture \/ d\u00e9bat - Infini Th\u00e9\u00e2tre","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.tricoterie.be\/","email":"info@infinitheatre.be","phone_contact":"+32 2 537 96 69","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50007332"},"cn":{"name":"Dans la mesure de l'impossible, lecture \/ d\u00e9bat - Infini Th\u00e9\u00e2tre","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.tricoterie.be\/","email":"info@infinitheatre.be","phone_contact":"+32 2 537 96 69","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50007332"},"fr":{"name":"Dans la mesure de l'impossible, lecture \/ d\u00e9bat - Infini Th\u00e9\u00e2tre","shortdescr":"D\u2019envergure universelle, ce texte e\u0301mouvant, d\u2019une grande since\u0301rite\u0301, met l\u2019urgence a\u0300 distance, ce qui sans doute est la meilleure mani\u00e8re de la donner \u00e0 entendre.","longdescr":"Dans la mesure de l\u2019impossible de Tiago Rodrigues - Lecture \/ D\u00e9bat\n15+ \/ 60\u2019 + d\u00e9bat\nP\u00e9riode de tourn\u00e9e : d\u00e8s mars 2024\n\nEn menant une s\u00e9rie d\u2019entretiens avec des travailleurs de l\u2019humanitaire officiant pour le Comit\u00e9 international de la Croix-Rouge ou M\u00e9decins sans fronti\u00e8re, Tiago Rodrigues a imagin\u00e9 un texte intimiste mais universel qui rend compte des d\u00e9sastres collectifs. Fils d\u2019une m\u00e8re m\u00e9decin et d\u2019un p\u00e8re journaliste, l\u2019auteur s\u2019est souvent demand\u00e9 pourquoi il avait choisi de raconter le monde plut\u00f4t que de le sauver en agissant de mani\u00e8re plus concr\u00e8te.\nFace \u00e0 l\u2019\u00e9ph\u00e9m\u00e8re des jeux du th\u00e9\u00e2tre et ses incorrigibles grimaces, que faire de l\u2019intime besoin d\u2019aider le monde ? De celui d\u2019enraciner ses projets au plus proche de l\u2019essentiel de la vie ?\nFinalement, le th\u00e9\u00e2tre ne pourrait-il pas vraiment sauver le monde ?\nApr\u00e8s la lecture du texte mis \u00e0 l\u2019honneur par une mise en jeu, l\u2019assembl\u00e9e d\u00e9bat des questions soulev\u00e9es par la pi\u00e8ce et ses contenus. Place aussi \u00e0 des t\u00e9moignages, des ateliers d\u2019\u00e9criture et\/ou d\u2019\u00e9loquence pour les jeunes et le tout public.\n\nExtrait\nBaptiste . \u2013 Je ne sais m\u00eame pas pourquoi je raconte cette histoire.\n\u00c7a ne servira a\u0300 rien pour votre spectacle. C\u2019est absolument impossible\nde montrer au public ce qui s\u2019est passe\u0301. Je veux dire : comment \u00e7a\ns\u2019est passe\u0301. Vous pouvez peut-\u00eatre reproduire ce qui s\u2019est passe\u0301,\nmais comment \u00e7a s\u2019est passe\u0301 ? \u00c7a c\u2019est invisible\u2026 il fallait y \u00eatre.\nVous pouvez peut-\u00eatre raconter l\u2019histoire au public, mais vous ne\npourrez pas montrer ce qui s\u2019est r\u00e9ellement passe\u0301. Il vous faudrait\nune ville enti\u00e8re compl\u00e9tement d\u00e9truite. \u00c7a ne peut pas \u00eatre un\nd\u00e9cor en carton avec un ou deux b\u00e2timents en ruines. Il vous\nfaudrait une ville enti\u00e8re en ruines, dans une des r\u00e9gions les plus\nimpossibles de tout l\u2019impossible. Il vous faudrait des explosions,\ndes fusillades en plein c\u0153ur d\u2019une bataille, dans une ville d\u00e9cim\u00e9e.\nIl vous faudrait cinq cent mille personnes \u2013 cinq cent mille\npersonnes prises en otage dans la bataille, parce que les deux\npuissances en guerre forcent les gens a\u0300 rester, personne ne peut\ndire qui est avec qui. Cinq cent mille personnes prises au pi\u00e8ge\ndans une ville d\u00e9truite au cours d\u2019une bataille sanglante,\nvous n\u2019avez pas le budget pour montrer \u00e7a. Vous pouvez\npeut-\u00eatre demander au public de l\u2019imaginer, mais\u2026 on ne peut\npas l\u2019imaginer. C\u2019est impossible \u00e0 imaginer. Impossible.\n\nTIAGO RODRIGUES, DANS LA MESURE DE L\u2019IMPOSSIBLE,\nLES SOLITAIRES INTEMPESTIFS, 2022, P. 34\n\nDate & Heure : 10, 11 et 22\/03 \u00e0 20h30\nTarif : 15\u20ac I 12\u20ac I 7\u20ac (\u00e9tudiant en arts) I Art 27\nSalle : Boudoir","performers":"Mise en sc\u00e8ne : Dominique Serron\nDistribution : L\u00e9opold Terlinden, Florence Guillaume, Camille L\u00e9onard, F\u00e9lix Vannoorenberghe et Laure Voglaire\nSon : Jean Fran\u00e7ois Lejeune","boxoffice_url":null,"website":"https:\/\/www.tricoterie.be\/","email":"info@infinitheatre.be","phone_contact":"+32 2 537 96 69","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50007332"},"sp":{"name":"Dans la mesure de l'impossible, lecture \/ d\u00e9bat - Infini Th\u00e9\u00e2tre","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.tricoterie.be\/","email":"info@infinitheatre.be","phone_contact":"+32 2 537 96 69","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50007332"},"nl":{"name":"Dans la mesure de l'impossible, lecture \/ d\u00e9bat - Infini Th\u00e9\u00e2tre","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.tricoterie.be\/","email":"info@infinitheatre.be","phone_contact":"+32 2 537 96 69","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50007332"}},"place":{"id":252101,"translations":{"de":{"name":"La Tricoterie","address_street_name":"Rue Th\u00e9odore Verhaegen","address_street_number":"158","address_street_box":null,"email":"charlotte@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+ 32 (0)2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Th\u00e9odore Verhaegen, 158","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"La Tricoterie - Fabrique de liens","address_street_name":"Rue Th\u00e9odore Verhaegen","address_street_number":"158","address_street_box":null,"email":"charlotte@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+ 32 (0)2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Th\u00e9odore Verhaegen, 158","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"La Tricoterie - Link factory","address_street_name":"Rue Th\u00e9odore Verhaegen","address_street_number":"158","address_street_box":null,"email":"charlotte@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+ 32 (0)2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Th\u00e9odore Verhaegen, 158","address_line2":"1060 Saint-Gilles","description_web":"La Tricoterie is above all a civil, cultural, sustainable and innovative project. Their cultural programme featuring performances, shows, exhibitions and so on goes hand in hand with a \u201ccivil\u201d programme of debates, conferences, inter-generational workshops, philosophical caf\u00e9 etc ... The place can be rented for events and there are plenty of really great parties! ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"La Tricoterie","address_street_name":"Rue Th\u00e9odore Verhaegen","address_street_number":"158","address_street_box":null,"email":"charlotte@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+ 32 (0)2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Th\u00e9odore Verhaegen, 158","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"La Tricoterie - Fabrique de liens","address_street_name":"Rue Th\u00e9odore Verhaegen","address_street_number":"158","address_street_box":null,"email":"charlotte@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+ 32 (0)2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Th\u00e9odore Verhaegen, 158","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"La Tricoterie - Fabrique de liens","address_street_name":"Rue Th\u00e9odore Verhaegen","address_street_number":"158","address_street_box":null,"email":"charlotte@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+ 32 (0)2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Th\u00e9odore Verhaegen, 158","address_line2":"1060 Saint-Gilles","description_web":"La Tricoterie est un projet culturel fond\u00e9 en 2010 par une poign\u00e9e de citoyen\u00b7nes et situ\u00e9 dans une ancienne usine restaur\u00e9e avec des mat\u00e9riaux \u00e9cologiques. La Tricoterie propose une programmation culturelle tr\u00e8s diversifi\u00e9e et centr\u00e9e sur la rencontre entre les diff\u00e9rents publics et le m\u00e9lange des activit\u00e9s culturelles.\r\n\r\nPassez la porte et d\u00e9couvrez :\r\n- Des spectacles de th\u00e9\u00e2tre, de danse, de cirque...\r\n- Des concerts, des soir\u00e9es, des sc\u00e8nes ouvertes, des jam sessions, une chorale d'un soir...\r\n- Des ateliers z\u00e9ro d\u00e9chet, peinture, c\u00e9ramique, \u0153nologie, danse...\r\n- Des projections de films, conf\u00e9rences, d\u00e9bats...\r\n- Des couscous \"s\u00e9pharabes\", des soir\u00e9es jeux de soci\u00e9t\u00e9, des activit\u00e9s pour enfants...\r\n- Des march\u00e9s des cr\u00e9ateur\u00b7rices, des vide-dressings, des march\u00e9s de No\u00ebl durables...\r\n\r\nUn petit creux ? La Triciterie vous propose un brunch tous les dimanches et un concept \"live cooking\" tous les vendredis soirs. Tous les plats sont 100% artisanaux, et pr\u00e9par\u00e9s sur place par l'\u00e9quipe avec des ingr\u00e9dients bio, locaux et de saison.\r\n\r\nEnvie d'organiser votre \u00e9v\u00e9nement chez vous ? La Tricoterie met ses salles \u00e0 disposition pour tout type d'\u00e9v\u00e9nement priv\u00e9 ou professionnel et propose \u00e9galement un service traiteur, que ce soit dans ses murs ou \u00e0 l'ext\u00e9rieur. Rendez-vous sur www.tricoterie.be pour en savoir plus !\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"La Tricoterie","address_street_name":"Rue Th\u00e9odore Verhaegen","address_street_number":"158","address_street_box":null,"email":"charlotte@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+ 32 (0)2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Th\u00e9odore Verhaegen, 158","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"La Tricoterie - Contactenfabriek","address_street_name":"Th\u00e9odore Verhaegenstraat","address_street_number":"158","address_street_box":null,"email":"charlotte@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+ 32 (0)2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Sint-Gillis","address_line1":"Th\u00e9odore Verhaegenstraat, 158","address_line2":"1060 Sint-Gillis","description_web":"La Tricoterie is een project met een welomlijnde filosofie, die blijkt uit de zelfgekozen naam (van tricoter, breien) waarmee verwijst wordt naar het smeden van banden om de strijd tegen de ontrafeling van het sociale weefsel aan te gaan. Opgezet als een \u00abContacten Fabriek\u00bb en een ontmoetingsplaats waar verschillende disciplines en publieken elkaar ontmoeten. Naast een culturele programmering (concerten, voorstellingen, expos\u2026) en socioculturele activiteiten die sociale cohesie beogen (debatten, conferenties, intergenerationele ateliers, caf\u00e9-filo\u2026) staan de ruimtes ook open voor verhuur aan externe organisaties en bedrijven. Tal van superleuke feestjes vinden er plaats, alsook een wekelijkse biomarkt, een repaircaf\u00e9 en een alternatieve geschenkenmarkt om maar enkele van de activiteiten te noemen die de duurzame levensvisie van de plek weerspiegelen.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[7],"translations":{"de":["Saint-Gilles Zentrum"],"pt":[null],"en":["Saint-Gilles Centre"],"it":["Saint-Gilles Centre"],"cn":[null],"fr":["Saint-Gilles Centre"],"sp":["Saint-Gilles Centre"],"nl":["Sint-Gillis