adtzentrum"],"pt":[null],"en":["Historical Centre"],"it":["Centro storico"],"cn":[null],"fr":["Centre historique"],"sp":["Centro hist\u00f3rico"],"nl":["Historisch centrum"]}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":null,"facebook_id":null,"backoffice_id":7718,"location":{"lat":50.84757712,"lon":4.35053903},"region":"brussels","last_updated_at":"2024-10-02T14:55:53+02:00","published_at":"2013-10-19T01:22:45+02:00","import_origin":null,"external_id":null,"is_in_address_book":false,"is_in_vb_export":false,"resto_ranking":0},"organizer":{"id":265511,"translations":{"de":{"name":"Fais le trottoir","address_street_name":"Avenue Jean Volders","address_street_number":null,"address_street_box":null,"email":"visitegraffiti@gmail.com","website":"http:\/\/www.faisletrottoir.com","phone_contact":"+32 488 98 70 33","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Avenue Jean Volders","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Fais le trottoir ","address_street_name":"Avenue Jean Volders","address_street_number":null,"address_street_box":null,"email":"visitegraffiti@gmail.com","website":"http:\/\/www.faisletrottoir.com","phone_contact":"+32 488 98 70 33","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Avenue Jean Volders","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Fais le trottoir ","address_street_name":"Avenue Jean Volders","address_street_number":null,"address_street_box":null,"email":"visitegraffiti@gmail.com","website":"http:\/\/www.faisletrottoir.com","phone_contact":"+32 488 98 70 33","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Avenue Jean Volders","address_line2":"1060 Saint-Gilles","description_web":"The team of \"Fais le trottoir\" brings together passionate graffiti practitioners who have been working for several years for a better (re)knowledge of this movement by acting at different levels: organization of guided tours for all ages, organization of events (KAT), documentary production, publication of fanzines, participation in debates-conferences, creation of frescoes, networking of actors on the scene ...\r\nFais le Trottoir offers different types of guided tours led by two people including an artist. During these walks, we decode the signatures, explain the history and the working techniques and the mechanisms specific to this movement.\r\nAlong the way, we discover tags, graffiti, stencils, collages, stickers, murals ...","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Fais le trottoir ","address_street_name":"Avenue Jean Volders","address_street_number":null,"address_street_box":null,"email":"visitegraffiti@gmail.com","website":"http:\/\/www.faisletrottoir.com","phone_contact":"+32 488 98 70 33","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Avenue Jean Volders","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Fais le trottoir","address_street_name":"Avenue Jean Volders","address_street_number":null,"address_street_box":null,"email":"visitegraffiti@gmail.com","website":"http:\/\/www.faisletrottoir.com","phone_contact":"+32 488 98 70 33","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Avenue Jean Volders","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"vis