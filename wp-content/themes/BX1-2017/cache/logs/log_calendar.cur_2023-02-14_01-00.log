_by_appointment":true},"tags":[],"accessibilities":{"list":[255,261],"translations":{"fr":["Accessible","Parking accessible"],"nl":["Toegankelijk","Toegankelijke parking"],"en":["Accessible","Accessible parking"],"de":["Barrierefrei","Barrierefreier Parkplatz"],"it":["Accessibile","Parcheggio accessibile"],"sp":["Habilitado","Estacionamiento habilitado"],"pt":[null,null],"cn":[null,null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2023-02-12T03:35:28+01:00","published_at":"2023-01-10T12:11:28+01:00","backoffice_id":268849,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.30285343213869},{"id":548414,"date_start":"2023-01-27","date_end":"2023-03-04","date_next":"2023-02-15","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung","it":"Esposizioni","sp":"Exhibici\u00f3n","pt":null,"cn":null}},"others":{"list":[24,30],"translations":{"fr":["Galeries d'art","Peinture"],"nl":["Galeries","Schilderkunst"],"en":["Art Galleries","Painting"],"de":["Kunstgalerien","Malerei"],"it":["Gallerie d'arte","Pittura"],"sp":["Galer\u00edas de arte","Pintura"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Leif \u00d6sterman","shortdescr":"Leif \u00d6sterman (Stockholm, 1963) . Pour cet artiste su\u00e9dois, refuser les conventions est un \u00e9tat d\u2019\u00e2me. Leif \u00d6sterman porte un regard lucide et d\u00e9sabus\u00e9 sur les progr\u00e8s technologiques et l'ali\u00e9nation qui en d\u00e9coule et cherche pour l'homme un nouvel \u00e9quilibre. Sa peinture spontan\u00e9e se nourrit d\u2019\u00e9cologie optimiste qui trouve ses racines au plus profond de la culture nordique.","longdescr":"Leif \u00d6sterman (Stockholm, 1963) , Pour cet artiste su\u00e9dois, refuser les conventions est un \u00e9tat d\u2019\u00e2me. Leif \u00d6sterman porte un regard lucide et d\u00e9sabus\u00e9 sur les progr\u00e8s technologiques et l'ali\u00e9nation qui en d\u00e9coule et cherche pour l'homme un nouvel \u00e9quilibre. Sa peinture spontan\u00e9e et d\u00e9complex\u00e9e se nourrit d\u2019\u00e9cologie optimiste qui trouve ses racines au plus profond de la culture nordique. Sa vision de la perspective est troublante, elle perturbe nos rep\u00e8res \u00e0 la fois d\u2019\u00e9chelle et de proportion. Le peintre renvoie en arri\u00e8re -plan ce qui logiquement devrait \u00eatre proche et ram\u00e8ne dans la proximit\u00e9 de l\u2019avant-plan ce qui est devrait \u00eatre dans le lointain. La d\u00e9marche de ce paysagiste passe \u00e9galement par l\u2019association mati\u00e8re\/couleur. D\u00e9s lors que le support est en bois, l'artiste cr\u00e9e de larges et g\u00e9n\u00e9reux emp\u00e2tements. Quand le support est une toile, la mati\u00e8re se fait alors moins g\u00e9n\u00e9reuse mais le geste du pinceau reste fougueux et les envol\u00e9es chromatiques audacieuses. Son dessin expressif s\u2019entrem\u00eale violemment avec la couleur jusqu\u2019 \u00e0 la limite de l\u2019identifiable. Certains \u00e9l\u00e9ments r\u00e9alistes dispers\u00e9s dans le paysage sont entrain\u00e9s non sans force, dans une d\u00e9bauche de mati\u00e8re, emport\u00e9s dans la tourmente d\u2019un tourbillon qui disloque  et nous entra\u00eene dans un processus \u00e9nergique, entre abstraction et figuration.  Vu de la mer, l\u2019artiste navigateur \u00e0 ses heures , nous offre un aper\u00e7u de la valeur lyrique des c\u00f4tes de la Baltique qui n\u2019ont rien perdu de leur aspect sauvage et de leur enchantement.","performers":"Leif \u00d6sterman","boxoffice_url":null,"website":"http:\/\/www.zedes-art-gallery.be","email":"zedes.art.gallery@gmail.com","phone_contact":"+32 475 52 62 58","phone_booking":"+32 2 646 00 04","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.548414"},"nl":{"name":"Leif \u00d6sterman","shortdescr":"Leif \u00d6sterman (Stockholm, 1963). Voor deze Zweedse kunstenaar is het weigeren van conventies een geestesgesteldheid. Leif \u00d6sterman werpt een lucide en gedesillusioneerde blik op de technologische vooruitgang en zoekt naar een nieuw evenwicht voor de mens. Zijn spontane en ongeremde schilderkunst voedt zich met een optimistische ecologie die diep geworteld is in de Scandinavische cultuur.","longdescr":"Leif \u00d6sterman (Stockholm, 1963)\r\nVoor deze Zweedse kunstenaar is het weigeren van conventies een geestesgesteldheid. Leif \u00d6sterman werpt een lucide en gedesillusioneerde blik op de technologische vooruitgang en zoekt naar een nieuw evenwicht voor de mens. Zijn spontane en ongeremde schilderkunst voedt zich met een optimistische ecologie die diep geworteld is in de Scandinavische cultuur. Zijn visie op perspectief is verontrustend, het verstoort onze referentiepunten van zowel schaal als proportie. Bij de aanpak van deze kunstenaar hoort ook de associatie van materiaal en kleur. Het gebaar van de borstel blijft vurig en de chromatische vluchten gedurfd. Zijn expressieve vormgeving is gewelddadig verweven met kleur tot aan de grens van het herkenbare.Vanuit de zee gezien, biedt de kunstenaar  zeiler in zijn vrije tijd ons een glimp van de lyrische waarde van de Baltische kusten die niets van hun wilde aspect en hun betovering hebben ingeboet.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.zedes-art-gallery.be","email":"zedes.art.gallery@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.548414"},"en":{"name":"Leif \u00d6sterman","shortdescr":"Leif \u00d6sterman( Stockholm, 1963)\r\nFor this Swedish artist, refusing conventions is a state of mind. Leif \u00d6sterman takes a lucid and disillusioned look at technological progress and the resulting alienation and so, he searches for a new equilibrium for the man. His spontaneous painting feeds on an optimistic ecology that is deeply rooted in Scandinavian culture.","longdescr":"Leif \u00d6sterman( Stockholm, 1963)\r\nFor this Swedish artist, refusing conventions is a state of mind. Leif \u00d6sterman takes a lucid and disillusioned look at technological progress and the resulting alienation and so, he searches for a new equilibrium for the man. His spontaneous painting feeds on an optimistic ecology that is deeply rooted in Scandinavian culture. His view of perspective is disturbing and distorting our reference points of both scale and proportion. The approach of this artist also includes the association of material and color. The gesture of the brush remains fiery and the chromatic flights daring. His expressive drawing is violenty interwined with color to the limit of the recognizable. Seen from the sea, the artist sailor in his spare time, offers us a glimpse of the lyrical value of the Baltic coasts that never lost their wild aspect also their enchantment.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.zedes-art-gallery.be","email":"zedes.art.gallery@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.548414"},"de":{"name":"Leif \u00d6sterman","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.zedes-art-gallery.be","email":"zedes.art.gallery@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.548414"},"it":{"name":"Leif \u00d6sterman","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.zedes-art-gallery.be","email":"zedes.art.gallery@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.548414"},"sp":{"name":"Leif \u00d6sterman","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.zedes-art-gallery.be","email":"zedes.art.gallery@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.548414"},"pt":{"name":"Leif \u00d6sterman","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.zedes-art-gallery.be","email":"zedes.art.gallery@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.548414"},"cn":{"name":"Leif \u00d6sterman","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.zedes-art-gallery.be","email":"zedes.art.gallery@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.548414"}},"place":{"id":260455,"translations":{"fr":{"name":"zedes art gallery","address_street_name":"Rue Paul Lauters","address_street_number":"36","address_street_box":null,"email":"zedes.art.gallery@gmail.com","website":"http:\/\/www.zedes-art-gallery.be","phone_contact":"+32 475 52 62 58","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Paul Lauters, 36","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"zedes art gallery","address_street_name":"Paul Lautersstraat","address_street_number":"36","address_street_box":null,"email":"zedes.art.gallery@gmail.com","website":"http:\/\/www.zedes-art-gallery.be","phone_contact":"+32 475 52 62 58","phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"Paul Lautersstraat, 36","address_line2":"1050 Elsene","description_web":null,"description_pri