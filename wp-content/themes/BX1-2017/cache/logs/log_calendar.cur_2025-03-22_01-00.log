box":null,"email":"contact@geopolis.brussels","website":"http:\/\/geopolis.brussels","phone_contact":"+32 485 32 85 90","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Tanneurs, 58-60","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"G\u00e9opolis - Centre du photojournalisme","address_street_name":"Rue des Tanneurs","address_street_number":"58-60","address_street_box":null,"email":"contact@geopolis.brussels","website":"http:\/\/geopolis.brussels","phone_contact":"+32 485 32 85 90","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Tanneurs, 58-60","address_line2":"1000 Bruxelles","description_web":"G\u00e9opolis est un mus\u00e9e bruxellois d\u00e9di\u00e9 au photojournalisme install\u00e9 dans l\u2019ancien Palais du Vin, un b\u00e2timent embl\u00e9matique du quartier des Marolles \u00e0 proximit\u00e9 de la grand place. \n\nG\u00e9opolis propose, tous les deux mois, des expositions photographiques temporaires d\u00e9di\u00e9es \u00e0 des th\u00e8mes d\u2019actualit\u00e9 ou d\u2019histoire.\nLe centre, parrain\u00e9 par le photographe franco-belge Laurent Van der Stockt, accueille des grands noms du photojournalisme international mais aussi de jeunes talents.\n\nOutre ses expositions G\u00e9opolis propose \u00e9galement des activit\u00e9s p\u00e9dagogiques diversifi\u00e9es et d\u00e9veloppe des outils \u00e9ducatifs en ligne en partenariat avec la Sonuma (les archives de la radio t\u00e9l\u00e9vision belge francophone).\n\nL\u2019\u00e9quipe de G\u00e9opolis coordonne aussi l\u2019antenne bruxelloise du m\u00e9dia Euradio (www.euradio.be) qui compte 17 antennes, en Belgique et en France.\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"G\u00e9opolis","address_street_name":"Rue des Tanneurs","address_street_number":"58-60","address_street_box":null,"email":"contact@geopolis.brussels","website":"http:\/\/geopolis.brussels","phone_contact":"+32 485 32 85 90","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Tanneurs, 58-60","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Geopolis","address_street_name":"Huidevettersstraat","address_street_number":"58-60","address_street_box":null,"email":"contact@geopolis.brussels","website":"http:\/\/geopolis.brussels","phone_contact":"+32 485 32 85 90","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Huidevettersstraat, 58-60","address_line2":"1000 Brussel","description_web":"G\u00e9opolis is een centrum voor fotojournalistiek en onderwijs opgericht in 2017 door een klein team met een passie voor geopolitiek. Door fototentoonstellingen en didactische tentoonstellingen te combineren met evenementen en een radioprogramma, beoogt ze actuele vraagstukken bespreekbaar te maken. Het centrum, gevestigd in de Ateliers des Tanneurs op een bijzondere en polyvalente locatie, organiseert tentoonstellingen over actuele en geschiedkundige thema\u2019s met werk van zowel gevestigde fotografen als jonge talenten.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[2],"translations":{"de":["Marollen"],"pt":[null],"en":["Marolles"],"it":["Marolles"],"cn":[null],"fr":["Marolles"],"sp":["Marolles"],"nl":["Marollen"]}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":null,"facebook_id":null,"backoffice_id":29816,"location":{"lat":50.8400185,"lon":4.3467134},"region":"brussels","last_updated_at":"2023-12-18T09:16:47+01:00","published_at":"2017-09-07T12