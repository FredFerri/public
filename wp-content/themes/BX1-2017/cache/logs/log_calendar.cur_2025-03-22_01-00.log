agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700005938"},"it":{"name":"La r\u00e9sistance, la libert\u00e9 et la citoyennet\u00e9 au travers des \u0153uvres de l'h\u00f4tel de Ville de Saint-Gilles (gratuit pour les Saint-Gillois)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.bruxellesbavard.be\/fr\/visites-pour-individuels\/","email":"info@bruxellesbavard.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700005938"},"cn":{"name":"La r\u00e9sistance, la libert\u00e9 et la citoyennet\u00e9 au travers des \u0153uvres de l'h\u00f4tel de Ville de Saint-Gilles (gratuit pour les Saint-Gillois)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.bruxellesbavard.be\/fr\/visites-pour-individuels\/","email":"info@bruxellesbavard.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700005938"},"fr":{"name":"La r\u00e9sistance, la libert\u00e9 et la citoyennet\u00e9 au travers des \u0153uvres de l'h\u00f4tel de Ville de Saint-Gilles (gratuit pour les Saint-Gillois)","shortdescr":null,"longdescr":"Pour d\u00e9corer son h\u00f4tel de Ville, la commune de Saint-Gilles a fait appel aux meilleurs peintres et sculpteurs bruxellois de l'\u00e9poque : Khnopff, Dillens, Lambeaux, Broerman...\n\nLeur mission : illustrer l\u2019optimisme et la volont\u00e9 de progr\u00e8s marquant ce d\u00e9but du XXe si\u00e8cle. Entre symbolisme et exaltation des valeurs la\u00efques, les peintures murales et les sculptures de cet \u00e9difice public traduisent la cr\u00e9ativit\u00e9 et la foi dans l\u2019humanit\u00e9.\n\nIci tout est symbole, mais aussi volont\u00e9 d'agir concr\u00e8tement pour des id\u00e9aux politiques et sociaux toujours d'actualit\u00e9 au XXIe si\u00e8cle: suffrage universel, solidarit\u00e9, \u00e9galit\u00e9 homme-femme, enseignement pour tous, etc. Bref un superbe panorama artistique de la Belle \u00c9poque autour de trois id\u00e9es : Libert\u00e9 - \u00c9galit\u00e9 - Fraternit\u00e9.\n\nCette visite est gratuite pour les habitants de Saint-Gilles.\nPour les non-r\u00e9sidents de Saint-Gilles, la visite est accessible \u00e0 14\u20ac par personne. Envoyez un mail \u00e0 info@bruxellesbavard.be pour vous inscrire.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.bruxellesbavard.be\/fr\/visites-pour-individuels\/","email":"info@bruxellesbavard.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700005938"},"sp":{"name":"La r\u00e9sistance, la libert\u00e9 et la citoyennet\u00e9 au travers des \u0153uvres de l'h\u00f4tel de Ville de Saint-Gilles (gratuit pour les Saint-Gillois)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.bruxellesbavard.be\/fr\/visites-pour-individuels\/","email":"info@bruxellesbavard.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700005938"},"nl":{"name":"La r\u00e9sistance, la libert\u00e9 et la citoyennet\u00e9 au travers des \u0153uvres de l'h\u00f4tel de Ville de Saint-Gilles (gratuit pour les Saint-Gillois)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.bruxellesbavard.be\/fr\/visites-pour-individuels\/","email":"info@bruxellesbavard.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700005938"}},"place":{"id":232838,"translations":{"de":{"name":"Place Van Meenen","address_street_name":"Place Maurice Van Meenen","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Place Maur