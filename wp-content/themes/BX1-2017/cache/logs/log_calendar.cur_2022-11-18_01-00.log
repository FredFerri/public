1],"translations":{"fr":["Accessible","Parking accessible"],"nl":["Toegankelijk","Toegankelijke parking"],"en":["Accessible","Accessible parking"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-11-14T09:05:21+01:00","published_at":"2022-11-14T08:44:06+01:00","backoffice_id":265517,"import_origin":null,"sub_type":"party","show_in_agenda":true,"ranking":1.2599210498949},{"id":542972,"date_start":"2022-11-18","date_end":"2022-11-18","date_next":"2022-11-18","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater"}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"],"de":["Theater"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Cerise sur le Ghetto - Sam Touzani","shortdescr":"L\u2019histoire d\u2019une vie aux accents de v\u00e9rit\u00e9 grin\u00e7ants racont\u00e9e par Sam Touzani, qui nous invite \u00e0 repenser le r\u00e9el \u00e0 partir de son histoire familiale. L'auteur est de retour avec l\u2019humour, la tendresse et l\u2019irr\u00e9v\u00e9rence qu\u2019on lui conna\u00eet\u2026","longdescr":"Le pouvoir de dire NON\r\n\r\nL\u2019histoire d\u2019une vie aux accents de v\u00e9rit\u00e9 grin\u00e7ants racont\u00e9e par Sam Touzani, qui nous invite \u00e0 repenser le r\u00e9el \u00e0 partir de son histoire familiale.\r\n\r\nLe r\u00e9cit traverse trois g\u00e9n\u00e9rations, des montagnes du Rif Marocain, o\u00f9 la mis\u00e8re est si \u00e9crasante que m\u00eame les enfants r\u00eavent de partir, jusqu\u2019au bitume de Molenbeek o\u00f9 le petit Sam verra le jour dans un deux pi\u00e8ces cuisine chauff\u00e9 au charbon.\r\n\r\nPlus tard, afin d\u2019\u00e9chapper au danger du communautarisme, c\u2019est de lui-m\u00eame qu\u2019il s\u2019exile. Le fils d\u2019immigr\u00e9s peut enfin commencer son dialogue int\u00e9rieur, entre sa culture d\u2019origine et sa culture d\u2019adoption, relier les rives souterraines de ses multiples identit\u00e9s sans les r\u00e9duire \u00e0 une seule...\r\n\r\nMais tout cela suffira-t-il \u00e0 le sortir du cercle infernal de la culpabilit\u00e9 ? Celle qui, dans le silence du d\u00e9ni, ronge tous ceux qui quittent leurs terres, leurs parents, leur langue pour partir loin, tr\u00e8s loin, l\u00e0 o\u00f9 il n\u2019y a plus de soleil.\r\n\r\nSam Touzani est de retour avec l\u2019humour, la tendresse et l\u2019irr\u00e9v\u00e9rence qu\u2019on lui conna\u00eet\u2026","performers":"Sam Touzani (Texte et jeu), Mathieu Gabriel (Musicien), Gennaro Pitisci assist\u00e9 de Ma\u00eft\u00e9 Renson (Mise en sc\u00e8ne & dramaturgie), Josse Derbaix & David Vernaillen (R\u00e9gie), Guillaume Nolevaux (Vid\u00e9os)","boxoffice_url":null,"website":"https:\/\/lejacquesfranck.be\/event\/cerise-sur-le-ghetto\/2022-11-18\/","email":"info@lejacquesfranck.be","phone_contact":null,"phone_booking":"+32 2 538 90 20","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.542972"},"nl":{"name":"Cerise sur le Ghetto - Sam Touzani","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.542972"},"en":{"name":"Cerise sur le Ghetto - Sam Touzani","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.542972"},"de":{"name":"Cerise sur le Ghetto - Sam Touzani","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"e