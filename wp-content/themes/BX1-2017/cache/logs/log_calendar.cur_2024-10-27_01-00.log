ons":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{}},"translations":{"de":{"name":"La maison Hannon","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/la-maison-hannon-0","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50006180"},"pt":{"name":"La maison Hannon","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/la-maison-hannon-0","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50006180"},"en":{"name":"La maison Hannon","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/la-maison-hannon-0","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50006180"},"it":{"name":"La maison Hannon","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/la-maison-hannon-0","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50006180"},"cn":{"name":"La maison Hannon","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/la-maison-hannon-0","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50006180"},"fr":{"name":"La maison Hannon","shortdescr":null,"longdescr":"La Maison Hannon est un des chefs-d\u2019\u0153uvre de l\u2019Art nouveau \u00e0 Bruxelles, unissant l\u2019art nouveau belge \u00e0 l\u2019art nouveau fran\u00e7ais, dans un univers symboliste et onirique. Construite sur l\u2019angle des avenues Brugmann et de la Jonction \u00e0 Saint-Gilles, elle est command\u00e9e par le couple Hannon dont elle porte le nom, \u00e0 leur ami architecte Jules Brunfaut en 1902. La maison refl\u00e8te les go\u00fbts de Marie pour la botanique et d\u2019\u00c9douard pour la po\u00e9sie, l\u2019Antiquit\u00e9 et la technologie. Les vastes fresques de Paul Baudouin (1844-1931), disciple du Fran\u00e7ais Puvis de Chavannes, se d\u00e9ploient telles des tapisseries dans la cage d\u2019escalier et la salle de r\u00e9ception. La maison est encore en r\u00e9novation mais vous aurez l'occasion de visiter les parties d\u00e9j\u00e0 restaur\u00e9es ainsi que l'exposition \u00ab Art(s) Nouveau(x) Belge(s) \u00bb qui pr\u00e9sente l\u2019art nouveau dans sa pluralit\u00e9, au travers d\u2019\u0153uvres diverses issues des plus grandes collections belges...\n\nLe prix de la visite comprend le ticket d'entr\u00e9e (14\u20ac). Ce montant permet de participer en partie aux travaux de restauration du lieu.\n\nLa visite guid\u00e9e dure 1h10 heure pour vister la maison et l'exposition.","performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/la-maison-hannon-0","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50006180"},"sp":{"name":"La maison Hannon","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/la-maison-hannon-0","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50006180"},"nl":{"name":"La maison Hannon","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/la-maison-hannon-0","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50006180"}},"place":{"id":244861,"translations":{"de":{"name":"Maison Hannon","address_street_name":"Avenue de la Jonction","address_street_number":"1","address_street_box":null,"email":"info@maisonhannon.be","website":"https:\/\/maisonhannon.be","phone_contact":null,"phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Avenue de la Jonction, 1","address_line2":"1060 Saint-Gilles","description_web":"Edouard Hannon, Ingenieur der Gesellschaft Solvay und einer der Vertreter der industriellen Bourgeoisie, erwarb 1902 ein Grundst\u00fcck an der Avenue Brugman und beauftragte den Architekten Jules Brunfaut mit dem Bau eines prachtvollen Herrenhauses im Jugendstil.\r\n\r\nJules Brunfaut z\u00e4hlte bis dato nicht zu den Jugendstil-Architekten. Er bediente sich dieses Stils lediglich, um seinem Freund und Gesch\u00e4ftspartner einen Gefallen zu tun. 1903, als sich der Jugendstil auch international durchgesetzt hatte, wagte er sich an neue Stilelemente heran: Ihm sind die Fenster im Tiffany-Stil zu verdanken. Und es wird deutlich, wer Brunfauts Vorbilder waren: Victor Horta und Octave van Rijsselberghe (der Architekt des H\u00f4tel Otlet und H\u00f4tel de Brouck\u00e8re).\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Maison Hannon","address_street_name":"Avenue de la Jonction","address_street_number":"1","address_street_box":null,"email":"info@maisonhannon.be","website":"https:\/\/maisonhannon.be","phone_contact":null,"phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Avenue de la Jonction, 1","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Maison Hannon","address_street_name":"Verbindingslaan","address_street_number":"1","address_street_box":null,"email":"info@maisonhannon.be","website":"https:\/\/maisonhannon.be","phone_contact":null,"phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Verbindingslaan, 1","address_line2":"1060 Saint-Gilles","description_web":"The Maison Hannon, on the corner of Avenue Brugmann and Avenue de la Jonction, was built in 1902, at the request of the couple Marie and \u00c9douard Hannon, by their friend, the architect Jules Brunfaut. Conceived as a symbolist and dreamlike universe, the house is one of the masterpieces of art nouveau in Brussels, a union of Belgian and French art of the time. \r\nJules Brunfaut, unfamiliar with the new style, was inspired by other architects' houses, such as those of Victor Horta (personal house, Tassel and Wessinger hotels), Ernest Bl\u00e9rot (personal house, now destroyed) and Octave Van Rysselbeghe and Henry Van de Velde (Otlet hotel). \r\nCombining the beaux-arts style with that of modernity, or art nouveau at that period, the Maison Hannon is a singular work, an intimate and personal house, bringing together the tastes and passions of its commissioners. \r\n\r\nThe Maison Hannon will open its doors to the public on June 1, 2023, as a house museum. ","description_print":null,"booking_url":"https:\/\/shop.utick.net\/?pos=AGENDABRUSSELS&module=ACTIVITYSERIEDETAILS&s=CBE1698C-529F-F03E-F17E-1F92247CBAF4&lg=EN","sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Maison Hannon","address_street_name":"Avenue de la Jonction","address_street_number":"1","address_street_box":null,"email":"info@maisonhannon.be","website":"https:\/\/maisonhannon.be","phone_contact":null,"phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Avenue de la Jonction, 1","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Maison Hannon","address_street_name":"Avenue de la Jonction","address_street_number":"1","address_street_box":null,"email":"info@maisonhannon.be","website":"https:\/\/maisonhannon.be","phone_contact":null,"phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Avenue de la Jonction, 1","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Maison Hannon","address_street_name":"Avenue de la Jonction","address_street_number":"1","address_street_box":null,"email":"info@maisonhannon.be","website":"https:\/\/maisonhannon.be","phone_contact":null,"phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Avenue de la Jonction, 1","address_line2":"1060 Saint-Gilles","description_web":"La Maison Hannon, \u00e0 l\u2019angle des avenues Brugmann et de la Jonction, a \u00e9t\u00e9 construite en 1902, \u00e0 la demande du couple Marie et \u00c9douard Hannon, par leur ami l\u2019architecte Jules Brunfaut. Con\u00e7ue comme univers symboliste et onirique, la maison est un des chefs-d\u2019\u0153uvre de l\u2019art nouveau \u00e0 Bruxelles, union de l\u2019art belge et de l\u2019art fran\u00e7ais de l\u2019\u00e9poque. \r\n\r\nJules Brunfaut, peu familier au style nouveau, s\u2019inspirera d\u2019autres maisons d\u2019architectes de l\u2019\u00e9poque, tel que celles de Victor Horta (maison personnelle, h\u00f4tels Tassel et Wessinger), d\u2019Ernest Bl\u00e9rot (maison personnelle, aujourd\u2019hui d\u00e9truite) et d\u2019Octave Van Rysselbeghe et Henry Van de Velde (h\u00f4tel Otlet). \r\n\r\nAlliant style beaux-arts \u00e0 celui de la modernit\u00e9, soit l\u2019art nouveau \u00e0 l\u2019\u00e9poque, la Maison Hannon est une \u0153uvre singuli\u00e8re, une maison intime et personnelle, r\u00e9unissant les go\u00fbts et passions de ses commanditaires. \r\n\r\nLa Maison Hannon ouvre ses portes au public le 1er juin 2023, en tant que maison-mus\u00e9e.\r\n","description_print":null,"booking_url":"https:\/\/shop.utick.net\/?pos=AGENDABRUSSELS&module=ACTIVITYSERIEDETAILS&s=CBE1698C-529F-F03E-F17E-1F92247CBAF4&lg=FR","sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Maison Hannon","address_street_name":"Avenue de la Jonction","address_street_number":"1","address_street_box":null,"email":"info@maisonhannon.be","website":"https:\/\/maisonhannon.be","phone_contact":null,"phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Avenue de la Jonction, 1","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Maison Hannon","address_street_name":"Verbindingslaan","address_street_number":"1","address_street_box":null,"email":"info@maisonhannon.be","website":"https:\/\/maisonhannon.be","phone_contact":null,"phone_booking":null,"address_zip":"1060","address_city":"Sint-Gillis","address_line1":"Verbindingslaan, 1","address_line2":"1060 Sint-Gillis","description_web":"Het Maison Hannon werd in 1902 gebouwd op de hoek van de Brugmannlaan en de Verbindingslaan in Sint-Gillis door de architect Jules Brunfaut op verzoek van het echtpaar Marie en \u00c9douard Hannon. Het huis, opgevat als een droomachtig, symbolistische omsloten wereld, is een van de meesterwerken van de Brusselse art nouveau, een vereniging van Belgische en Franse kunst uit die tijd.\r\n\r\nJules Brunfaut, onbekend met de nouveau-stijl, liet zich inspireren door de huizen van andere architecten uit die tijd, zoals die van Victor Horta (persoonlijk huis, hotels Tassel en Wessinger), Ernest Bl\u00e9rot (persoonlijk huis, nu vernietigd) en Octave Van Rysselbeghe en Henry Van de Velde (hotel Otlet). \r\nHet Maison Hannon combineert de Beaux-Arts stijl met die van de moderniteit, de toenmalige art nouveau, en is een uniek werk, een intiem en persoonlijk huis dat de smaak en de passies van zijn opdrachtgevers samenbrengt. \r\n\r\nHet Maison Hannon zal op 1 juni 2023 de deuren voor het publiek openen als huis-museum.","description_print":null,"booking_url":"https:\/\/shop.utick.net\/?pos=AGENDABRUSSELS&module=ACTIVITYSERIEDETAILS&s=CBE1698C-529F-F03E-F17E-1F92247CBAF4&lg=NL","sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[7,6],"translations":{"de":["Saint-Gilles Zentrum","Chatelain\/Bailli"],"pt":[null,null],"en":["Saint-Gilles Centre","Chatelain\/Bailli"],"it":["Saint-Gilles Centre","Chatelain\/Bailli"],"cn":[null,null],"fr":["Saint-Gilles Centre","Chatelain\/Bailli"],"sp":["Saint-Gilles Centre","Ch\u00e2telain\/Bailli"],"nl":["Sint-Gillis centrum","Kasteleinswijk\/Baljuw"]}},"zones":{"list":[21],"translations":{"de":["S\u00fcden"],"pt":[null],"en":["South"],"it":["Sud"],"cn":[null],"fr":["Sud"],"sp":["Sur"],"nl":["Zuid"]}},"neca":null,"facebook_id":null,"backoffice_id":7146,"location":{"lat":50.820883,"lon":4.3522286},"region":"brussels","last_updated_at":"2024-09-10T13:21:32+02:00","published_at":"2013-10-19T01:21:40+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":276946,"translations":{"de":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be\/en","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue de Namur, 10","address_line2":"1000 Brussels","description_web":"Since 1983, Arkadia has been exploring the richness of Belgium's and Brussels' heritage and developing numerous cultural projects especially in Brussels, between architecture, urbanism, culture, plastic arts and ideology from the Middle Ages to the present day. Seeing and understanding the city and its architectural development, approaching artistic creation and giving it meaning, these are the activities that the ASBL wants to share with the public. Specialists in architectural heritage and contemporary art, they show the city through guided tours and lectures in several languages.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":"Depuis 1983, Arkadia explore les richesses du patrimoine belge et bruxellois et d\u00e9veloppe de nombreux projets culturels sp\u00e9cialement \u00e0 Bruxelles, entre architecture, urbanisme, culture, arts plastiques et id\u00e9ologie depuis le Moyen \u00c2ge jusqu\u2019\u00e0 nos jours. Voir et comprendre la ville et son d\u00e9veloppement architectural, approcher la cr\u00e9ation artistique et lui donner un sens, telles sont les activit\u00e9s que l'ASBL veut partager avec le public. Sp\u00e9cialistes du patrimoine  architectural et de l'art contemporain, ils font d\u00e9couvrir la ville \u00e0 travers des visites guid\u00e9es et des conf\u00e9rences en plusieurs langues.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Arkadia","address_street_name":"Naamsestraat","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be\/nl","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Naamsestraat, 10","address_line2":"1000 Brussel","description_web":"Sinds 1983 verkent Arkadia de rijkdom van het Belgische en Brusselse erfgoed en ontwikkelt talrijke culturele projecten, vooral in Brussel, tussen architectuur, stedenbouw, cultuur, plastische kunsten en ideologie, van de Middeleeuwen tot vandaag. De stad en haar architecturale ontwikkeling zien en begrijpen, de artistieke creatie benaderen en er een betekenis aan geven, dat zijn de activiteiten die de VZW met het publiek wil delen. Zij zijn gespecialiseerd in architectonisch erfgoed en hedendaagse kunst en laten de stad zien door middel van rondleidingen en lezingen in verschillende talen.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":36946,"location":{"lat":50.84145283,"lon":4.35976257},"last_updated_at":"2023-06-08T12:25:28+02:00","published_at":"2021-07-23T14:48:31+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/e7a4aa6de24ec5f7a3dfa1b12816421d392048df.jpeg","width":3024,"height":4032,"ratio":0.75,"oEmbed_height":4032,"oEmbed_width":3024,"translations":{"de":{"title":"La maison Hannon","copyright":null},"pt":{"title":"La maison Hannon","copyright":null},"en":{"title":"La maison Hannon","copyright":null},"it":{"title":"La maison Hannon","copyright":null},"cn":{"title":"La maison Hannon","copyright":null},"fr":{"title":"La maison Hannon","copyright":null},"sp":{"title":"La maison Hannon","copyright":null},"nl":{"title":"La maison Hannon","copyright":null}}}],"dates":[{"day":"2024-03-31","doors