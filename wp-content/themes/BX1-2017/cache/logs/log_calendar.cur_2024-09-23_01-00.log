 geven van intelligentie en humor, zowel in de eigen voorstellingen als in de diverse en doordachte gastprogrammatie. \r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":5501,"location":{"lat":50.85310831,"lon":4.34614873},"last_updated_at":"2023-09-21T15:20:49+02:00","published_at":"2013-10-19T01:18:50+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/1726976415175-bronks-131adc522d25971801f48d62432b3cef667b6e6c.jpg","width":360,"height":298,"ratio":1.21,"oEmbed_height":298,"oEmbed_width":360,"translations":{"de":{"title":"The happy few","copyright":null},"pt":{"title":"The happy few","copyright":null},"en":{"title":"The happy few","copyright":null},"it":{"title":"The happy few","copyright":null},"cn":{"title":"The happy few","copyright":null},"fr":{"title":"The happy few","copyright":null},"sp":{"title":"The happy few","copyright":null},"nl":{"title":"The happy few","copyright":null}}}],"dates":[{"day":"2021-02-26","doors":null,"start":"20:00:00","end":null,"end_night_life":null,"is_soldout":true,"is_canceled":false},{"day":"2021-02-27","doors":null,"start":"20:00:00","end":null,"end_night_life":null,"is_soldout":true,"is_canceled":false},{"day":"2021-11-09","doors":null,"start":"20:00:00","end":null,"end_night_life":null,"is_soldout":true,"is_canceled":false},{"day":"2022-02-04","doors":null,"start":"20:00:00","end":null,"end_night_life":null,"is_soldout":true,"is_canceled":false},{"day":"2025-03-14","doors":null,"start":"20:00:00","end":null,"end_night_life":null,"is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"de":{"name":"<21 year"},"pt":{"name":"<21 year"},"en":{"name":"<21 year"},"it":{"name":"<21 year"},"cn":{"name":"<21 year"},"fr":{"name":"<21 ans"},"sp":{"name":"<21 year"},"nl"