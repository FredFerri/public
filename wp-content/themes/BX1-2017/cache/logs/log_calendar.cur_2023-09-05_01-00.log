nches,\nque ce soit votre premi\u00e8re fois sur sc\u00e8ne,\nque vous ayez un monologue interminable ou juste deux mots \u00e0 dire\nen solo ou \u00e0 plusieurs.\nQue vous ayez envie de slamer, chanter, improviser, parler, crier, danser, jongler, faire un num\u00e9ro de stand-up ou raconter votre derni\u00e8re balade en for\u00eat \u2026\nCe moment est pour vous.\n\nPr\u00e9c\u00e9d\u00e9 d\u2019un atelier d\u2019\u00e9criture, le m\u00eame jour \u00e0 16h.\nFacilit\u00e9 par la Voix des Sans Papiers.","performers":"Facilit\u00e9 par la Voix des Sans Papiers","boxoffice_url":null,"website":"https:\/\/famefestival.be\/fr\/fame-event\/cloture\/","email":"info@famefestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50000815"},"sp":{"name":"Cl\u00f4ture du FAME \u00b7 Sc\u00e8ne ouverte SLAM&BAM","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/famefestival.be\/fr\/fame-event\/cloture\/","email":"info@famefestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50000815"},"nl":{"name":"Cl\u00f4ture du FAME \u00b7 Sc\u00e8ne ouverte SLAM&BAM","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/famefestival.be\/fr\/fame-event\/cloture\/","email":"info@famefestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50000815"}},"place":{"id":279041,"translations":{"de":{"name":"FAME Festival","address_street_name":"Rue des Riches Claires","address_street_number":"24","address_street_box":null,"email":"ticket@famefestival.be","website":"http:\/\/www.famefestival.be","phone_contact":"+32 456 29 70 73","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Riches Claires, 24","address_line2":"1000 Bruxelles","description_web":null,"d