T16:52:56+02:00","published_at":"2023-09-25T08:55:08+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":286032,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"theatre","ranking":0.023921876373284433,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":49,"translations":{"de":"Theater","pt":null,"en":"Theatre","it":"Teatro","cn":null,"fr":"Th\u00e9\u00e2tre","sp":"Teatro","nl":"Theater"}},"others":{}},"translations":{"de":{"name":"Les Lundis en coulisse","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"leslundisencoulisse.be@gmail.com","phone_contact":"+32 471 59 23 45","phone_booking":"+32 471 59 23 45","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50002589"},"pt":{"name":"Les Lundis en coulisse","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"leslundisencoulisse.be@gmail.com","phone_contact":"+32 471 59 23 45","phone_booking":"+32 471 59 23 45","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50002589"},"en":{"name":"Les Lundis en coulisse","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"leslundisencoulisse.be@gmail.com","phone_contact":"+32 471 59 23 45","phone_booking":"+32 471 59 23 45","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50002589"},"it":{"name":"Les Lundis en coulisse","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"leslundisencoulisse.be@gmail.com","phone_contact":"+32 471 59 23 45","phone_booking":"+32 471 59 23 45","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50002589"},"cn":{"name":"Les Lundis en coulisse","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"leslundisencoulisse.be@gmail.com","phone_contact":"+32 471 59 23 45","phone_booking":"+32 471 59 23 45","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50002589"},"fr":{"name":"Les Lundis en coulisse","shortdescr":"Les Lundis en coulisse est une initiative de Silvia Berutti-Ronelt. Cette activit\u00e9 mensuelle est un moment de rencontre informel permettant de d\u00e9couvrir des textes dramatiques contemporains. Ces d\u00e9couvertes se passent par l'interm\u00e9diaire d'un.e passeur.euse.","longdescr":"Notre passeuse est St\u00e9phanie Manges, autrice et com\u00e9dienne, mais \u00e9galement cofondatrice de la Compagnie MAPS, des R\u00e9sidences d\u2019\u00c9criture Enfants Admis et de la compagnie La T\u00eate \u00e0 l\u2019Envers.\nElle nous propose la lecture ou l\u2019\u00e9coute de\u00a0:\n\uf0b7 Venir au monde d\u2019Anne-Marie OLIVIER (Qu\u00e9bec)\n\uf0b7 Le canap\u00e9 club, le chien et la serrure \u00e0 cinq points d\u2019Emilie LECONTE (France)\n\uf0b7 Et plus je suis inad\u00e9quate et plus je suis inad\u00e9quate de Liliane GOUGEON-MOISAN (Qu\u00e9bec)\n\n\u00c0 propos de ce choix de texte : \n\u00ab\u00a0Je suis partie en qu\u00eate de textes contemporains qui pr\u00e9sentent la maternit\u00e9\/parentalit\u00e9 comme des exp\u00e9riences valables, dignes d\u2019\u00eatre le sujet d\u2019une recherche, mati\u00e8re \u00e0 cr\u00e9ation artistique, \u00e0 tension dramatique. Des \u0153uvres mettant en sc\u00e8ne des m\u00e8res et p\u00e8res\nd\u00e9butant\u00b7e\u00b7s, qui me ressembleraient, loin de M\u00e9d\u00e9e c\u00f4t\u00e9 trag\u00e9die, ou de la m\u00e8re juive qui\n\u00e9maille les com\u00e9dies.\nAlors que la parentalit\u00e9 est consid\u00e9r\u00e9e comme de l\u2019ordre du domestique, comme un non-sujet par beaucoup d\u2019artistes et directeur\u00b7ice\u00b7s, voir comme totalement incompatible avec l\u2019acte de cr\u00e9er, je vous propose de nager \u00e0 contre-courant.\nPetite note qui a toute son importance\u00a0: On ne peut \u00e9videmment pas r\u00e9duire les textes choisis \u00e0 cette seule th\u00e9matique.\u00a0\u00bb\n\nSt\u00e9phanie Mangez","performers":null,"boxoffice_url":null,"website":null,"email":"leslundisencoulisse.be@gmail.com","phone_contact":"+32 471 59 23 45","phone_booking":"+32 471 59 23 45","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50002589"},"sp":{"name":"Les Lundis en coulisse","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"leslundisencoulisse.be@gmail.com","phone_contact":"+32 471 59 23 45","phone_booking":"+32 471 59 23 45","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50002589"},"nl":{"name":"Les Lundis en coulisse","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"leslundisencoulisse.be@gmail.com","phone_contact":"+32 471 59 23 45","phone_booking":"+32 471 59 23 45","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50002589"}},"place":{"id":277671,"translations":{"de":{"name":"SACD","address_street_name":"Rue du Prince Royal","address_street_number":"87","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue du Prince Royal, 87","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"SACD","address_street_name":"Rue du Prince Royal","address_street_number":"87","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue du Prince Royal, 87","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"SACD","address_stre