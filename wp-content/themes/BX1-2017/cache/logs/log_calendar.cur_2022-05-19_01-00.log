aces public et du Patrimoine de la ville de Bruxelles.\n4 places seront offertes pour les habitants de la ville de Bruxelles dans le Brusseleir de novembre.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.arkadia.be","email":"info@arkadia.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/528865.html"},"nl":{"name":"Les places bruxelloises: La place de Breughel l'Ancien et son banc \u00e0 palabres","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/528865.html"},"en":{"name":"Les places bruxelloises: La place de Breughel l'Ancien et son banc \u00e0 palabres","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/528865.html"},"de":{"name":"Les places bruxelloises: La place de Breughel l'Ancien et son banc \u00e0 palabres","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/528865.html"},"it":{"name":"Les places bruxelloises: La place de Breughel l'Ancien et son banc \u00e0 palabres","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/528865.html"},"sp":{"name":"Les places bruxelloises: La place de Breughel l'Ancien et son banc \u00e0 palabres","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/528865.html"},"pt":{"name":"Les places bruxelloises: La place de Breughel l'A