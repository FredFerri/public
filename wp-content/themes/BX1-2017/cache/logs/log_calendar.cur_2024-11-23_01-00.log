","address_city":"Schaerbeek","address_line1":"Avenue Emile Max, 153","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"L'Os \u00e0 Moelle","address_street_name":"Emile Maxlaan","address_street_number":"153","address_street_box":null,"email":"reservation@osamoelle.be","website":"http:\/\/www.osamoelle.be","phone_contact":"+32 487 22 50 22","phone_booking":"+32 487 22 50 22","address_zip":"1030","address_city":"Schaarbeek","address_line1":"Emile Maxlaan, 153","address_line2":"1030 Schaarbeek","description_web":"Welkom in het oudste cabarettheater van Brussel!\u202fDat op zich verdient al een pluim, en het is ook nog eens de charmante kelder van het geboortehuis van onze Brusselse trots Jacques Brel. Sinds de jaren 60 passeerden hier grote Franse sterren de revue, denk aan Toots Thielemans, Philippe Lafontaine, Barbara en Arno. Nu kan hier wekelijks komen genieten van een stevig programma gaande van improvisatietheater, comedy en singer-songwriteroptredens tot po\u00ebzieavonden, poppentheater en feestjes in \u2018roaring-twenties\u2019-stijl. \r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":"osamoellecabaret","region":"brussels","backoffice_id":176,"location":{"lat":50.85131869,"lon":4.39874268},"last_updated_at":"2022-10-10T10:25:09+02:00","published_at":"2013-10-19T01:13:20+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/a8a75feeb41de184b34e0ea6f5b6643ef40ff80d.png","width":1646,"height":874,"ratio":1.88,"oEmbed_height":874,"oEmbed_width":1646,"translations":{"de":{"title":"Quizz Night","copyright":null},"pt":{"title":"Quizz Night","copyright":null},"en":{"title":"Quizz Night","copyright":null},"it":{"title":"Quizz Night","copy