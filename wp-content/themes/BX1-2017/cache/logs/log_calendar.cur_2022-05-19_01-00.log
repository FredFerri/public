_start":"2022-05-28","date_end":"2022-05-28","date_next":"2022-05-28","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{"list":[105],"translations":{"fr":["Gastronomie"],"nl":["Gastronomie"],"en":["Gastronomy"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Bi\u00e8res et brasseries","shortdescr":"Sant\u00e9 et \u00e0 la v\u00f4tre ! Depuis 2016, la culture de la bi\u00e8re belge est inscrite au patrimoine de l\u2019Unesco !","longdescr":"Connaissez-vous la diff\u00e9rence entre une blanche et une pils ? Quelle est la particularit\u00e9 d\u2019un lambic ? Combien de brasseries compte la capitale ? Pourquoi utilise-t-on du houblon dans le processus de brassage ? Vous trouverez r\u00e9ponses \u00e0 toutes ces questions durant cette balade d\u00e9di\u00e9e au patrimoine brassicole bruxellois.\nInscrite depuis 2016 au patrimoine de l\u2019Unesco, la culture de la bi\u00e8re belge est bien pr\u00e9sente \u00e0 Bruxelles. En d\u00e9marrant de la maison des brasseurs sur la Grand Place, vous d\u00e9couvrirez autant les anciennes et nouvelles brasseries que les nombreux bars qui pars\u00e8ment encore le centre-ville. Cap ensuite sur le quartier du canal et ses anciennes brasseries industrielles pour rejoindre Cantillon. La visite de cette brasserie artisanale r\u00e9put\u00e9e pour sa production de lambic marque un autre temps fort de la balade. Trinquons \u00e0 la culture bruxelloise !\nUn suppl\u00e9ment de 4,5 \u20ac sera demand\u00e9 pour la visite de la brasserie.\nbalade \u00e0 v\u00e9lo","performers":null,"boxoffice_url":null,"website":"http:\/\/www.provelo.org","email":"info@provelo.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/531267.html"},"nl":{"name":"Bi\u00e8res et brasseries","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.provelo.org","email":"info@provelo.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/531267.html"},"en":{"name":"Beer and Breweries","shortdescr":"Do you know the difference between a white beer and a pilsner? The particularities of a lambic beer? How many breweries the Belgian capital still has? What hops are exactly used for in the brewing process?","longdescr":"Do you know the difference between a white beer and a pilsner? The particularities of a lambic beer? How many breweries the Belgian capital still has? What hops are exactly used for in the brewing process? All these questions, and many more, will be answered during this bike tour, dedicated to the remarkable brewing heritage of Brussels.Belgian beer culture, featured on UNESCO\u2019s World Heritage list since 2016, is amazingly vast, and well-present in Brussels.Starting from the Maison des Brasseurs on the Grand Place, we will discover both old and new breweries, as well as many of the infamous bars which dot the city centre. Afterward we head to the canal district, with its old industrial breweries, to reach the Brussels Gueuze Museum and the Cantillon brewery.\nBiking","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/531267.html"},"de":{"name":"Bi\u00e8res et brasseries","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/531267.html"},"it":{"name":"Bi\u00e8res et brasseries","shortdescr":null,"longdescr":null,"performers":null,"boxo