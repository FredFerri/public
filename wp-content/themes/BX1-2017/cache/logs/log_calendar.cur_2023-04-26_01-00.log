queer community.\n\nThe Whole New World puffy version of the Kiki Kiosk will be on view until 19 June. Until then, you can browse the selection from the archive of publications.\n\nCome and join the launch! To celebrate the opening, to join discussions about recent publications and collaborations, to hang out, to read fanzines, to gossip, or to do a little dance. Some of their cute team members will perform during the evening.\u00a0\n\n\u00a0","performers":null,"boxoffice_url":null,"website":"http:\/\/www.muntpunt.be","email":"info@muntpunt.be","phone_contact":null,"phone_booking":"+32 2 278 11 11","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.555561"},"en":{"name":"Launch Kiki Kiosk","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.muntpunt.be","email":"info@muntpunt.be","phone_contact":null,"phone_booking":"+32 2 278 11 11","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.555561"},"de":{"name":"Launch Kiki Kiosk","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.muntpunt.be","email":"info@muntpunt.be","phone_contact":null,"phone_booking":"+32 2 278 11 11","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.555561"},"it":{"name":"Launch Kiki Kiosk","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.muntpunt.be","email":"info@muntpunt.be","phone_contact":null,"phone_booking":"+32 2 278 11 11","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.555561"},"sp":{"name":"Launch Kiki Kiosk","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.muntpunt.be","email":"info@muntpunt.be","phone_contact":null,"phone_booking":"+32 2 278 11 11","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.555561"},"pt":{"name":"Launch Kiki Kiosk","shortdescr":null,"longdescr":null,"p