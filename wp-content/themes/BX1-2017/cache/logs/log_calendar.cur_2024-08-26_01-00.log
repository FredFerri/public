:false,"is_canceled":false},{"day":"2024-09-25","doors":null,"start":"00:00:00","end":null,"end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-09-26","doors":null,"start":"00:00:00","end":null,"end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-09-27","doors":null,"start":"00:00:00","end":null,"end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-09-28","doors":null,"start":"00:00:00","end":null,"end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-09-29","doors":null,"start":"00:00:00","end":null,"end_night_life":null,"is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"de":{"name":"Normal"},"en":{"name":"Normal"},"it":{"name":"Normale"},"fr":{"name":"Normal"},"sp":{"name":"Normal"},"nl":{"name":"Normaal"}},"value":49}],"date_exceptions":[],"closing_days":[],"child_events":[],"parent_events":[],"accessibilities":[],"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[]},{"id":50009557,"date_start":"2024-04-24","date_end":"2024-09-22","date_next":"2024-08-25","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":true,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-08-25T02:01:16+02:00","published_at":"2024-04-11T17:06:22+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":298260,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.2360815978543417,"languages":{"spoken":["en","fr","nl"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{}},"translations":{"de":{"name":"Simone Guillissen-Hoa","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/civa.brussels","email":"info@civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":"+32 2 642 24 50","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50009557"},"pt":{"name":"Simone Guillissen-Hoa","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/civa.brussels","email":"info@civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":"+32 2 642 24 50","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50009557"},"en":{"name":"Simone Guillissen-Hoa","shortdescr":"CIVA is pleased to present the first monographic exhibition honoring the life, work, and legacy of the Chinese-born Belgian architect Simone Guillissen-Hoa (1916\u201396).","longdescr":"CIVA is pleased to present the first monographic exhibition honoring the life, work, and legacy of the Chinese-born Belgian architect Simone Guillissen-Hoa (1916\u201396). A proponent of modernist architecture, Guillissen-Hoa was one of the first women to establish her own architecture firm in Belgium. Her career and personal life constantly defied the barriers and conventions of gender, race, and religion.\n\nHer life spanned the major events of the twentieth century, from the early onset of the Chinese Revolution to the resistance in occupied Belgium and through postwar reconstruction. In the 1950s, she was a member of the Soroptimist Association, a women\u2019s-rights advocacy organization, and in the 1970s, she became involved in the creation of the International Union of Women Architects.\n\nThe exhibition both records her architectural projects and, through a wide array of archival materials, presents her reflections on architecture, her battles and more broadly, her professional and private life. By delving into Guillissen-Hoa\u2019s artistic circle, comprised of figures such as L\u00e9on Spilliaert, Alfred Roth, Max Bill, Enrico Castellani, Tapta, Henry and Nele van de Velde, the exhibition explores the influences and collaborations that shaped her artistic and intellectual journey.\n\nA newly commissioned film by artists Eva Giolo and Aglaia Konrad is central to the exhibition, showcasing several of Guillissen-Hoa\u2019s buildings and the utilization, adaptation, and translation of modernist forms and concepts.\n\nWith works by: Max Bill, Enrico Castellani, Pierre Cordier, Jacques Dupuis, Eva Giolo and Aglaia Konrad, Mayou Iserentant, Alfred Roth, Josine Souweine, L\u00e9on Spilliaert, and Tapta.\n\nAn extensive public program on feminism and architecture is being developed in collaboration with Apolline Vranken (researcher in residence at CIVA, 2023\u201324). With talks by V\u00e9ronique Boone, Beatriz Colomina, Bianca Felicori, Florencia Fern\u00e1ndez Cardoso, Jane Hall, Sol P\u00e9rez Mart\u00ednez, Luc\u00eda C. P\u00e9rez Moreno, L\u00e9a-Catherine Szacka and many more. \n\nThe exhibition marks the occasion of the donation of the Fonds Simone Guillissen-Hoa to CIVA Collections, Brussels. Curators: Silvia Franceschini and Yaron Pesztat","performers":"With works by: Max Bill, Enrico Castellani, Pierre Cordier, Jacques Dupuis, Eva Giolo and Aglaia Konrad, Mayou Iserentant, Alfred Roth, Josine Souweine, L\u00e9on Spilliaert, and Tapta.\n\nPublic program with talks by V\u00e9ronique Boone, Beatriz Colomina, Bianca Felicori, Florencia Fern\u00e1ndez Cardoso, Jane Hall, Sol P\u00e9rez Mart\u00ednez, Luc\u00eda C. P\u00e9rez Moreno, L\u00e9a-Catherine Szacka and many more.","boxoffice_url":null,"website":"https:\/\/civa.brussels","email":"info@civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":"+32 2 642 24 50","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50009557"},"it":{"name":"Simone Guillissen-Hoa","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/civa.brussels","email":"info@civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":"+32 2 642 24 50","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50009557"},"cn":{"name":"Simone Guillissen-Hoa","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/civa.brussels","email":"info@civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":"+32 2 642 24 50","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50009557"},"fr":{"name":"Simone Guillissen-Hoa","shortdescr":"Le CIVA a le plaisir de pr\u00e9senter la premi\u00e8re exposition monographique consacr\u00e9e \u00e0 la vie, \u00e0 l'\u0153uvre et \u00e0 l'h\u00e9ritage de l'architecte belge d'origine chinoise Simone Guillissen-Hoa (1916-1996). ","longdescr":"Le CIVA a le plaisir de pr\u00e9senter la premi\u00e8re exposition monographique consacr\u00e9e \u00e0 la vie, \u00e0 l'\u0153uvre et \u00e0 l'h\u00e9ritage de l'architecte belge d'origine chinoise Simone Guillissen-Hoa (1916-1996). Promotrice de l'architecture moderniste, elle a \u00e9t\u00e9 l'une des premi\u00e8res femmes \u00e0 cr\u00e9er son propre bureau d'architecture en Belgique. Sa carri\u00e8re et sa vie personnelle ont constamment d\u00e9fi\u00e9 les limites et les conventions li\u00e9es au genre, aux origines et \u00e0 la religion.\n\nSa vie a travers\u00e9 les \u00e9v\u00e9nements majeurs du XXe si\u00e8cle, des pr\u00e9mices de la R\u00e9volution chinoise \u00e0 la Reconstruction d'apr\u00e8s-guerre, en passant par la R\u00e9sistance en Belgique occup\u00e9e. Dans les ann\u00e9es 1950, elle a \u00e9t\u00e9 membre de l'association Soroptimist, une organisation de d\u00e9fense des droits des femmes, et dans les ann\u00e9es 1970, elle a particip\u00e9 \u00e0 la cr\u00e9ation de l'Union Internationale des Femmes Architectes.\n\nL'exposition pr\u00e9sente tout \u00e0 la fois ses projets architecturaux, ses r\u00e9flexions sur l'architecture, ses combats, ainsi que sa vie professionnelle et priv\u00e9e, et ce, \u00e0 travers un large \u00e9ventail de documents d'archives. En p\u00e9n\u00e9trant dans le cercle artistique de Guillissen-Hoa, compos\u00e9 de personnalit\u00e9s telles que L\u00e9on Spilliaert, Alfred Roth, Max Bill, Enrico Castellani, Tapta, Henry et Nele van de Velde, l'exposition explore les influences et les collaborations qui ont fa\u00e7onn\u00e9 son parcours artistique et intellectuel.\n\nAu centre de l'exposition, un film r\u00e9alis\u00e9 sp\u00e9cialement par les artistes Eva Giolo et Aglaia Konrad, pr\u00e9sente plusieurs b\u00e2timents de Simone Guillissen-Hoa et met en \u00e9vidence la mani\u00e8re dont l'architecte utilise, adapte et traduit les \u00e9l\u00e9ments du langage moderniste.\n\nAvec des \u0153uvres de : Max Bill, Enrico Castellani, Pierre Cordier, Jacques Dupuis, Eva Giolo et Aglaia Konrad, Mayou Iserentant, Alfred Roth, Josine Souweine, L\u00e9on Spilliaert et Tapta.\n\nUn vaste programme public sur le f\u00e9minisme et l'architecture est d\u00e9velopp\u00e9 en collaboration avec Apolline Vranken (chercheuse en r\u00e9sidence au CIVA, 2023-24). Avec des conf\u00e9rences par V\u00e9ronique Boone, Beatriz Colomina, Bianca Felicori, Florencia Fern\u00e1ndez Cardoso, Jane Hall, Sol P\u00e9rez Mart\u00ednez, Luc\u00eda C. P\u00e9rez Moreno, L\u00e9a-Catherine Szacka et bien plus. \n\nL'exposition marque la donation du Fonds Simone Guillissen-Hoa aux Collections du CIVA, Bruxelles. Curateurs : Silvia Franceschini et Yaron Pesztat","performers":"Avec des \u0153uvres de: Max Bill, Enrico Castellani, Pierre Cordier, Jacques Dupuis, Eva Giolo et Aglaia Konrad, Mayou Iserentant, Alfred Roth, Josine Souweine, L\u00e9on Spilliaert et Tapta.\n\nUn programme public de conf\u00e9rences avec: V\u00e9ronique Boone, Beatriz Colomina, Bianca Felicori, Florencia Fern\u00e1ndez Cardoso, Jane Hall, Sol P\u00e9rez Mart\u00ednez, Luc\u00eda C. P\u00e9rez Moreno, L\u00e9a-Catherine Szacka et bien plus.","boxoffice_url":null,"website":"https:\/\/civa.brussels","email":"info@civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":"+32 2 642 24 50","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50009557"},"sp":{"name":"Simone Guillissen-Hoa","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/civa.brussels","email":"info@civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":"+32 2 642 24 50","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50009557"},"nl":{"name":"Simone Guillissen-Hoa","shortdescr":"CIVA is verheugd de eerste solotentoonstelling te presenteren die hulde brengt aan het leven, het werk en de nalatenschap van de in China geboren Belgische architecte Simone Guillissen-Hoa (1916-96).","longdescr":"CIVA is verheugd de eerste solotentoonstelling te presenteren die hulde brengt aan het leven, het werk en de nalatenschap van de in China geboren Belgische architecte Simone Guillissen-Hoa (1916-96). Deze voorvechtster van de modernistische architectuur was een van de eerste vrouwen die in Belgi\u00eb een eigen architectenbureau oprichtte. In haar carri\u00e8re en persoonlijke leven daagde ze onophoudelijk de barri\u00e8res en conventies van gender, ras en religie uit.\n\nHaar leven overspande de sleutelgebeurtenissen van de twintigste eeuw, van de eerste aanzetten tot de Chinese Revolutie tot het verzet in bezet Belgi\u00eb en de naoorlogse wederopbouw. In de jaren 1950 was ze lid van de Soroptimist Association, een organisatie die opkomt voor vrouwenrechten en in de jaren 1970 was ze betrokken bij de oprichting van de International Union of Women Architects.\n\nDe tentoonstelling belicht haar architecturale projecten en, aan de hand van een brede waaier aan archiefmateriaal, ook haar bespiegelingen over architectuur, de debatten en strijd die ze voerde, en meer in het algemeen haar professionele en private leven. Via een onderdompeling in Guillissen-Hoa\u2019s artistieke kring, waarin we figuren als L\u00e9on Spilliaert, Alfred Roth, Max Bill, Enrico Castellani, Tapta, Henry en Nele van de Velde aantreffen, verkent de tentoonstelling de invloeden en samenwerkingen die haar artistieke en intellectuele parcours vorm hebben gegeven.\n\nCentraal in de tentoonstelling staat een nieuwe film die de kunstenaressen Eva Giolo en Aglaia Konrad in opdracht maakten; hij toont verschillende realisaties van Guillissen-Hoa en hoe die de modernistische vormen en concepten hanteren, aanpassen en vertalen.\n\nMet werk van Max Bill, Enrico Castellani, Pierre Cordier, Jacques Dupuis, Eva Giolo & Aglaia Konrad, Mayou Iserentant, Alfred Roth, Josine Souweine, L\u00e9on Spilliaert en Tapta.\n\nIn samenwerking met Apolline Vranken, onderzoekster in residentie bij CIVA voor 2023-2024, wordt een uitgebreid publieksprogramma over feminisme en architectuur uitgewerkt. Met lezingen door V\u00e9ronique Boone, Beatriz Colomina, Bianca Felicori, Florencia Fern\u00e1ndez Cardoso, Jane Hall, Sol P\u00e9rez Mart\u00ednez, Luc\u00eda C. P\u00e9rez Moreno, L\u00e9a-Catherine Szacka en meer.  \n\nDe schenking van het Fonds Simone Guillissen-Hoa aan de CIVA-collecties in Brussel vormt de aanleiding tot deze tentoonstelling. Ze werd gecureerd door Silvia Franceschini en Yaron Pesztat.","performers":"Met werk van Max Bill, Enrico Castellani, Pierre Cordier, Jacques Dupuis, Eva Giolo & Aglaia Konrad, Mayou Iserentant, Alfred Roth, Josine Souweine, L\u00e9on Spilliaert en Tapta.\n\nPublieksprogramma met lezingen door V\u00e9ronique Boone, Beatriz Colomina, Bianca Felicori, Florencia Fern\u00e1ndez Cardoso, Jane Hall, Sol P\u00e9rez Mart\u00ednez, Luc\u00eda C. P\u00e9rez Moreno, L\u00e9a-Catherine Szacka en meer.  ","boxoffice_url":null,"website":"https:\/\/civa.brussels","email":"info@civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":"+32 2 642 24 50","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50009557"}},"place":{"id":235577,"translations":{"de":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+ 32 (0)2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"Das Architekturzentrum CIVA, das 2016 auf Betreiben der Region Br\u00fcssel-Hauptstadt ins Leben gerufen wurde, vereint in einer einzigen Struktur Ressourcen, Wissen und Know-how verschiedener Br\u00fcsseler Vereine aus dem Bereich Kultur, Architektur, St\u00e4dteplanung, Landschaftsarchitektur und Forschungen zum \u00d6kosystem: die Archive f\u00fcr moderne Architektur, die Bibliothek Ren\u00e9 Pech\u00e8re, der Architekturfonds und das Centre Paul Duvigneaud.\r\nMit ihrem kulturellen Projekt tr\u00e4gt die Fondation CIA zur Entwicklung einer architektonischen, landschaftsarchitektonischen und st\u00e4dteplanerischen Kultur bei, die sich mit den Herausforderungen der Gegenwart auseinandersetzt. Schwerpunkt ist Br\u00fcssel. \r\n\r\nDie Fondation CIVA bietet eine ganze Reihe von Aktivit\u00e4ten und Angeboten: Ausstellungen, Konferenzen, Orte des Austauschs und der Debatten, p\u00e4dagogische Aktivit\u00e4ten, Archiveinblicke und Bibliotheken mit knapp 40.000 Werken und Zeitschriften zu den Themen Architektur, St\u00e4dteplanung, Stadtgeschichte, Landschaften, G\u00e4rten und urbane \u00d6kosysteme.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+ 32 (0)2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+ 32 (0)2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"CIVA is a museum, an archive center, a library and a meeting place for lovers of architecture, landscape architecture, urban ecosystems and history in Brussels. Throughout the year, CIVA organizes temporary exhibitions, lectures, debates, guided tours, book launches and activities for children. The activities are organized in Ixelles, near Place Flagey and in the center of Brussels, in KANAL - Centre Pompidou.","description_print":null,"booking_url":null,"sort_order":"CIVA","virtual_visit":null,"visit_url":null},"it":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+ 32 (0)2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+ 32 (0)2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+ 32 (0)2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"CIVA est un muse\u0301e, un centre d'archives, une bibliothe\u0300que et un lieu de rencontre pour les amateurs d'architecture, d'architecture paysage\u0300re, d'e\u0301cosyste\u0300mes urbains et d'histoire a\u0300 Bruxelles. Tout au long de l'anne\u0301e, vous pouvez vous y rendre pour des expositions temporaires, des confe\u0301rences, des de\u0301bats, des visites guide\u0301es, des lancements de livres et des activite\u0301s pour les enfants. Les activite\u0301s se trouvent a\u0300 Ixelles, pre\u0300s de la Place Flagey et au centre de Bruxelles, a\u0300 KANAL - Centre Pompidou.\r\n\r\n","description_print":null,"booking_url":null,"sort_order":"CIVA","virtual_visit":null,"visit_url":null},"sp":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+ 32 (0)2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"Creado en 2016 por iniciativa de la Regi\u00f3n Bruselas-Capital, el CIVA re\u00fane una \u00fanica estructura de recursos, conocimiento y aprendizaje de varias asociaciones culturales activas en Bruselas en los campos de la arquitectura, urbanismo, paisajes y el estudio de ecosistemas: los Archivos de Arquitectura Moderna, la Biblioteca Ren\u00e9 Pech\u00e8re, los Fondos para la arquitectura, el Centro Paul Duvigneaud y el CIVA asbl, ahora disuelto.\r\nA trav\u00e9s de este proyecto cultural, la Fundaci\u00f3n CIVA contribuye al desarrollo del paisaje arquitect\u00f3nico y la cultura urbana como base para afrontar desaf\u00edos contempor\u00e1neos, poniendo especial \u00e9nfasis en Bruselas.\r\nSiempre tiene \u00e9xito a la hora de cumplir sus objetivos y tratar con un p\u00fablico amplio (adultos y ni\u00f1os, estudiantes, investigadores, arquitectos, paisajistas, amantes de la naturaleza, pol\u00edticos, etc), la fundaci\u00f3n CIVA organiza numerosos eventos y actividades en diferentes lugares, incluyendo exhibiciones permanentes y temporales, conferencias, debates y actividades educativas. Tambi\u00e9n dispone archivos excepcionales abiertos para todos los p\u00fablicos (documentos de arquitectos y paisajistas: planos, bocetos, modelos, muebles, etc.) y librer\u00edas que contienen casi 40.000 obras y peri\u00f3dicos de arquitectura, urbanismo, la historia de los pueblos y ciudades, paisajes, jardines y ecolog\u00eda urbana.\r\nEstas actividades y materiales est\u00e1n dise\u00f1ados para despertar la curiosidad y el inter\u00e9s de todo nuestro entorno, ya sea un hecho hist\u00f3rico o una construcci\u00f3n.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"CIVA","address_street_name":"Kluisstraat","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+ 32 (0)2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"Kluisstraat","address_line2":"1050 Elsene","description_web":"CIVA is een museum, een archiefcentrum, een bibliotheek en een ontmoetingsplek voor liefhebbers van architectuur, landschapsarchitectuur, stadsecosystemen en geschiedenis in Brussel. Het hele jaar door kan je er terecht voor tijdelijke tentoonstellingen, lezingen, debatten, rondleidingen, book launches en kinderactiviteiten. De activiteiten vind je in Elsene, vlakbij het Flageyplein en in Brussel-centrum, in KANAL \u2013 Centre Pompidou.","description_print":null,"booking_url":null,"sort_order":"CIVA","virtual_visit":null,"visit_url":null}},"districts":{"list":[5],"translations":{"de":["Flagey"],"pt":[null],"en":["Flagey"],"it":["Flagey"],"cn":[null],"fr":["Flagey"],"sp":["Flagey"],"nl":["Flagey"]}},"zones":{"list":[21],"translations":{"de":["S\u00fcden"],"pt":[null],"en":["South"],"it":["Sud"],"cn":[null],"fr":["Sud"],"sp":["Sur"],"nl":["Zuid"]}},"neca":null,"facebook_id":null,"backoffice_id":1436,"location":{"lat":50.82873218,"lon":4.36569034},"region":"brussels","last_updated_at":"2024-03-19T12:49:53+01:00","published_at":"2013-10-19T01:14:20+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":235577,"translations":{"de":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+ 32 (0)2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"Das Architekturzentrum CIVA, das 2016 auf Betreiben der Region Br\u00fcssel-Hauptstadt ins Leben gerufen wurde, vereint in einer einzigen Struktur Ressourcen, Wissen und Know-how verschiedener Br\u00fcsseler Vereine aus dem Bereich Kultur, Architektur, St\u00e4dteplanung, Landschaftsarchitektur und Forschungen zum \u00d6kosystem: die Archive f\u00fcr moderne Architektur, die Bibliothek Ren\u00e9 Pech\u00e8re, der Architekturfonds und das Centre Paul Duvigneaud.\r\nMit ihrem kulturellen Projekt tr\u00e4gt die Fondation CIA zur Entwicklung einer architektonischen, landschaftsarchitektonischen und st\u00e4dteplanerischen Kultur bei, die sich mit den Herausforderungen der Gegenwart auseinandersetzt. Schwerpunkt ist Br\u00fcssel. \r\n\r\nDie Fondation CIVA bietet eine ganze R