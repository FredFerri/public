"2022-09-15","doors":null,"start":"19:00:00","end":"20:30:00"},{"day":"2022-09-16","doors":null,"start":"19:00:00","end":"20:30:00"},{"day":"2022-09-17","doors":null,"start":"19:00:00","end":"20:30:00"}],"weekschema":[{"days":{"monday":{"is_open":false},"tuesday":{"is_open":false},"wednesday":{"is_open":false},"thursday":{"is_open":true,"hours":[{"start":"19:00:00","end":"20:30:00"}]},"friday":{"is_open":true,"hours":[{"start":"19:00:00","end":"20:30:00"}]},"saturday":{"is_open":true,"hours":[{"start":"19:00:00","end":"20:30:00"}]},"sunday":{"is_open":false}},"translations":{"fr":["lundi, mardi, mercredi et dimanche: ferm\u00e9","jeudi, vendredi et samedi: de 19:00 \u00e0 20:30"],"nl":["maandag, dinsdag, woensdag en zondag: gesloten","donderdag, vrijdag en zaterdag: van 19:00 tot 20:30"],"en":["monday, tuesday, wednesday and sunday: closed","thursday, friday and saturday: from 19:00 to 20:30"]},"date_start":"2022-09-15","date_end":"2022-09-17","is_also_by_appointment":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":20.3},{"translations":{"fr":{"name":"Pr\u00e9vente"},"nl":{"name":"Voorverkoop"},"en":{"name":"Presale"}},"value":17.3},{"translations":{"fr":{"name":"Seniors"},"nl":{"name":"Senioren"},"en":{"name":"Seniors"}},"value":15},{"translations":{"fr":{"name":"Etudiants"},"nl":{"name":"Studenten"},"en":{"name":"Students"}},"value":11.7},{"translations":{"fr":{"name":"Demandeurs d'emploi"},"nl":{"name":"Werkzoekenden"},"en":{"name":"Job seekers"}},"value":11.7},{"translations":{"fr":{"name":"Enfants"},"nl":{"name":"Kinderen"},"en":{"name":"Children"}},"value":9.4},{"translations":{"fr":{"name":"Article 27"},"nl":{"name":"Artikel 27"},"en":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":{"list":[255,265,266],"translations":{"fr":["Accessible","WC adapt\u00e9","Brussels Health Safety Label"],"nl":["Toegankelijk","Aangepast toilet","Brussels Health Safety Label"],"en":["Accessible","Adapted toilet","Brussels Health Safety Label"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-08-11T14:35:07+02:00","published_at":"2022-08-11T14:19:39+02:00","backoffice_id":259547,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":0.8735804647363},{"id":540287,"date_start":"2022-09-15","date_end":"2022-09-18","date_next":"2022-09-15","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[36,46],"translations":{"fr":["Mus\u00e9es et art centers","Pluridisciplinaire"],"nl":["Musea en kunstcentra","Multidisciplinair"],"en":["Museums and art centers","Multidisciplinary"]}}},"languages":{"spoken":["fr","en"],"subtitles":[]},"translations":{"fr":{"name":"Talk C.E.C x Heritage Days 2022","shortdescr":"Talk C.E.C, votre nouveau centre culturel europ\u00e9en, vous ouvre ses portes pour les Heritage Days 2022 ! \r\n4 jours exclusifs o\u00f9 vous d\u00e9couvrirez l'avanc\u00e9e des travaux avant l'ouverture officielle en avril 2023, mais aussi les tr\u00e9sors, les vestiges et la m\u00e9moire de l'ancienne manufacture de porcelaine Demeuldre, patrimoine class\u00e9 depuis 1990 !","longdescr":"\u00c0 l\u2019occasion des Journ\u00e9es du Patrimoine, en collaboration avec Heritage Days Urban Brussels, et avec le soutien de notre partenaire culturel WeArtXL, nous ouvrons exceptionnellement les portes de TALK C.E.C pour quatre jours d\u00e9di\u00e9s \u00e0 la Culture, \u00e0 l\u2019Art, et au Patrimoine.\r\n\r\nTalk C.E.C emm\u00e8ne l\u2019ancienne manufacture de Porcelaine datant de 1830 vers un nouveau cycle, avec la modernisation des infrastructures et des \u00e9quipements ainsi que la restauration et la valorisation de son patrimoine historique, architectural et artistique.\r\n\r\nTalk C.E.C (Creative European Center) est un lieu novateur multidisciplinaire qui r\u00e9partit ses activit\u00e9s en alliant culture et d\u00e9couverte, conscience \u00e9cologique et divertissement, rencontres et \u00e9changes, le tout sur 3 niveaux pour une surface totale de 3.500 m\u00e8tres carr\u00e9s, au c\u0153ur de la capitale europ\u00e9enne.\r\n\r\nAU PROGRAMME\r\n\r\nDe l\u2019art, de l\u2019art, de l\u2019art ! avec la s\u00e9lection d'\u0153uvres de la Talk Gallery. L\u2019exposition se tient dans la galerie principale de 55 m\u00e8tres de long, et accueille 14 artistes pour une curation \u00e9clectique mettant en avant de l\u2019art contemporain, du mobilier d\u2019art, ainsi que des productions r\u00e9alis\u00e9es in situ durant les r\u00e9sidences artistiques. \r\n \r\nOserez-vous marcher sur l'\u0153uvre monumentale sign\u00e9e Adrien Roubens ? L\u2019artiste belge s\u2019empare du sol d\u2019une surface de 300 m\u00e8tres carr\u00e9s, et compte ravir le public avec un travail portant sur l'abstraction, alliant formes g\u00e9om\u00e9triques et organiques dans une dynamique ondulatoire. \r\n\r\nDes rencontres et des \u00e9changes avec les artistes pr\u00e9sents. De nombreuses \u0153uvres ont \u00e9t\u00e9 produites sur place durant les r\u00e9sidences d\u2019artistes \u00e0 la Talk Residency. L\u2019occasion de discuter directement avec les artistes sur les \u0153uvres propos\u00e9es et ce qui les anime. \r\n\r\nL\u2019\u00e9merveillement par la red\u00e9couverte d\u2019un b\u00e2timent historique \u201cn\u00e9 avec la belgique\u201d, devenu le lieu incontournable de la vie culturelle ixelloise et bruxelloise. Apr\u00e8s une ann\u00e9e de fermeture, Talk C.E.C rouvre ses portes dans une ambiance festive : bar am\u00e9nag\u00e9 sp\u00e9cialement pour l\u2019occasion avec nos partenaires Duvel et Cohop, sessions musicales et activit\u00e9s pour les enfants.\r\n\r\nTalk Workshop, des ateliers encadr\u00e9s par des professionnels sur des th\u00e9matiques orient\u00e9es vers la transmission du Patrimoine et le d\u00e9veloppement de la cr\u00e9ativit\u00e9, pour le plaisir des petits comme des grands.\r\n\r\nATELIER VITRAIL \r\n\r\nQUAND : VENDREDI 16 SEPTEMBRE \u00c0 10H\r\n                SAMEDI 17 SEPTEMBRE \u00c0 10H\r\n\r\nDUR\u00c9E : 6H (Visite guid\u00e9e des \u00e9tages  - D\u00e9jeuner  - Atelier)\r\nD\u00e9jeuner inclus (veuillez nous faire part de toute intol\u00e9rance, allergie alimentaire, ou r\u00e9gime alimentaire sp\u00e9cial). \r\n\r\nO\u00d9: Dans les anciens appartements de la manufacture class\u00e9e au patrimoine belge. Deux pi\u00e8ces lumineuses dans un d\u00e9cor somptueux, orn\u00e9 d\u2019une chemin\u00e9e en bois sculpt\u00e9 pour un voyage dans le temps garanti. Cet espace est ferm\u00e9 au public. Nous l\u2019ouvrons exceptionnellement dans le cadre de l\u2019atelier. \r\n\r\n\r\nADRESSE : 141 Chauss\u00e9e de Wavre 1050, Ixelles\r\n\r\nPRIX PAR ADULTE : 295 euros\r\n\r\n\r\n6 personnes maximum par atelier\r\nGroupes : Nous contacter par mail talk.cec@gmail.com \r\n\r\nAge minimum 18 ans\r\nAdapt\u00e9 aux personnes malentendantes et \u00e0 mobilit\u00e9 r\u00e9duite.\r\nLes animaux ne sont pas admis.\r\n\r\n\r\nATELIER WOOD IT YOURSELF !\r\n\r\nQUAND : SAMEDI 17 SEPTEMBRE \u00c0 14H\r\n                DIMANCHE 18 SEPTEMBRE \u00c0 14H\r\n\r\nDUR\u00c9E : 3H (Visite guid\u00e9e des \u00e9tages - Atelier)\r\n\r\nD\u00e9roulement de l\u2019atelier : Pr\u00e9sentation de l\u2019artiste, choix des formes g\u00e9om\u00e9triques en bois d\u00e9coup\u00e9es au laser par notre partenaire InkutLab, composition, choix des couleurs, initiation au spray, colorisation du bois au spray, assemblage.   \r\n\r\nBoisson offerte \u00e0 volont\u00e9 (eau, th\u00e9, caf\u00e9, jus de fruit), pendant le temps de s\u00e9chage de la colle (15-20 min) une boisson vous est offerte (eau, th\u00e9, caf\u00e9, jus de fruit) \r\n\r\nO\u00d9: Dans la verri\u00e8re class\u00e9e de style Eiffel, ancien hall d\u2019exposition de la manufacture. Cet espace est ferm\u00e9 au public. Nous l\u2019ouvrons exceptionnellement dans le cadre de l\u2019atelier. \r\n\r\nPRIX PAR ADULTE : 35 euros\r\nPRIX PAR ENFANT (-12ans) : 20 euros\r\n\r\n20 personnes maximum par atelier\r\nGroupes : Nous contacter par mail talk.cec@gmail.com \r\n\r\nTous les mineurs de moins de 16 ans doivent \u00eatre accompagn\u00e9s.\r\nAdapt\u00e9 aux personnes malentendantes, malvoyantes et \u00e0 mobilit\u00e9 r\u00e9duite.\r\nLes animaux ne sont pas admis.\r\n\r\n\r\nSAVE THE DATE !\r\n\r\nLa Maison Demeuldre est un tr\u00e9sor cach\u00e9 dans l\u2019un des endroits les plus inattendus de la capitale. Rendez-vous du 15 au 18 septembre 2022 de 12h \u00e0 22h.\r\nUne visite en acc\u00e8s libre, anim\u00e9e par une \u00e9quipe bavarde et passionn\u00e9e de m\u00e9diateurs en Patrimoine pour perp\u00e9tuer l\u2019histoire de ce lieu d\u2019exception. Bonne visite chez Talk C.E.C ! \r\n\r\n\r\nINFOS PRATIQUES :\r\n\r\nAdresse : 143 Chauss\u00e9e de Wavre, 1050 Ixelles\r\nAccessibilit\u00e9 : Parking v\u00e9lo, adapt\u00e9 aux personnes \u00e0 mobilit\u00e9 r\u00e9duite\r\n\r\nM\u00e9tro Porte de Namur\r\nBus 38 et 95 Station Idalie","performers":null,"boxoffice_url":null,"website":"https:\/\/talk-cec.com\/","email":"talk.cec@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.540287"},"nl":{"name":"Talk C.E.C x Heritage Days 2022","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.540287"},"en":{"name":"Talk C.E.C x Heritage Days 2022","shortdescr":"Talk C.E.C, your new European cultural centre, opens its doors for Heritage Days 2022! \r\n4 exclusive days where you will discover the progress of the works before the official opening in April 2023, but also the treasures, vestiges and memory of the former Demeuldre porcelain factory, a listed heritage since 1990!","longdescr":"On the occasion of the Heritage Days, in collaboration with Heritage Days Urban Brussels, and with the support of our cultural partner WeArtXL, we are exceptionally opening the doors of TALK C.E.C for four days dedicated to Culture, Art and Heritage.\r\n\r\nTalk C.E.C is taking the former porcelain factory dating from 1830 into a new cycle, with the modernisation of its infrastructure and equipment as well as the restoration and enhancement of its historical, architectural and artistic heritage.\r\n\r\nTalk C.E.C. (Creative European Center) is an innovative multidisciplinary center that spreads its activities by combining culture and discovery, ecological awareness and entertainment, meetings and exchanges, all on 3 levels for a total surface of 3,500 square meters, in the heart of the European capital.\r\n\r\nON THE PROGRAMME\r\n\r\nArt, art, art! with the Talk Gallery's special selection of artworks. The exhibition takes place in the 55-metre long main gallery, and welcomes 14 artists for an eclectic curation featuring contemporary art, art furniture, as well as productions made in situ during the artistic residencies. \r\n \r\nWould you dare stepping on the monumental work by Adrien Roubens? The Belgian artist has taken over the floor of a 300 square metre area, and intends to delight the public with a work based on abstraction, combining geometric and organic forms in an undulating dynamic. \r\n\r\nMeetings and exchanges with the artists present. Many works were produced on site during the artists' residencies at the Talk Residency. An opportunity to discuss directly with the artists about the works proposed and what drives them. \r\n\r\nThe wonder of rediscovering a historic building \"born with Belgium\", which has become the place to be in the cultural life of Brussels. After a year of closure, Talk C.E.C. reopens its doors in a festive atmosphere: bar specially fitted out for the occasion with our partners Duvel and Cohop, musical sessions and activities for children.\r\n\r\n\r\nTalk Workshop, workshops supervised by professionals on themes oriented towards the transmission of heritage and the development of creativity, for the enjoyment of all generations.\r\n\r\nATELIER STAINED-ON-GLASS\r\n\r\nWHEN ? : FRIDAY SEPTEMBER 16TH (10AM-4PM)\r\n      SATURDAY SEPTEMBER 17TH (10AM-4PM)\r\n\r\nLENGTH: 6H (Private tours of the exclusive rooms  - Lunch - Workshop)\r\n\r\nWHERE ?: In the former appartments of the Belgian heritage factory. Two luminous rooms in a sumptuous decor, decorated with a carved wooden fireplace, for a guaranteed journey back in time. This space is closed to the public. \r\n\r\nWe open it exceptionally in the course of the workshop. \r\n\r\n\r\nADDRESS : 141 Chauss\u00e9e de Wavre 1050, Ixelles\r\n\r\nPRICE ADULTS : 295 euros\r\n\r\n\r\nMaximum 6 people per workshop\r\nGroups : Contact us by email talk.cec@gmail.com \r\n\r\nMinimum age 18 years\r\nSuitable for the hearing impaired and people with reduced mobility.\r\nAnimals are not allowed.\r\n\r\nATELIER WOOD IT YOURSELF !\r\n\r\nWHEN ? : SATURDAY SEPTEMBER 17TH (2PM-4PM)\r\n      SUNDAY SEPTEMBER 18TH (2PM-4PM)\r\n\r\nLENGTH: 3H (Private tours of the exclusive rooms  - Workshop)\r\n\r\nWHERE ?:In the listed Eiffel-style glass roof, the former exhibition hall of the factory. This space is closed to the public. We open it exceptionally within the framework of the workshop. \r\n\r\nADDRESS : 141 Chauss\u00e9e de Wavre 1050, Ixelles\r\n\r\nPRICE PER ADULT: 35 euros\r\nPRICE PER CHILD (-12 years): 20 euros\r\n\r\n20 people maximum per workshop\r\nGroups : Contact us by email talk.cec@gmail.com \r\n\r\nAll minors under the age of 16 must be accompanied.\r\nSuitable for the hearing impaired, visually impaired and people with reduced mobility.\r\nAnimals are not allowed.\r\n\r\n\r\nSAVE THE DATE !\r\n\r\nThe Maison Demeuldre is a hidden treasure in one of the most unexpected places in the capital. \r\nVisit from September 15th to 18th 2022 from 12pm to 10 pm.\r\nA free visit, led by a team of chatty and passionate heritage mediators to perpetuate the history of this exceptional place. \r\n\r\nEnjoy your visit to Talk C.E.C.! \r\n\r\n\r\nInfos : \r\nAddress : 143 Chauss\u00e9e de Wavre, 1050 Ixelles\r\nAccess : Bicycle parking, suitable for people with reduced mobility\r\n\r\nM\u00e9tro Porte de Namur\r\nBus 38 et 95 Station Idalie","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.540287"},"de":{"name":"Talk C.E.C x Heritage Days 2022","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.540287"},"it":{"name":"Talk C.E.C x Heritage Days 2022","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.540287"},"sp":{"name":"Talk C.E.C x Heritage Days 2022","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.540287"},"pt":{"name":"Talk C.E.C x Heritage Days 2022","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.540287"},"cn":{"name":"Talk C.E.C x Heritage Days 2022","shor