l_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung"}},"others":{"list":[24,26],"translations":{"fr":["Galeries d'art","Sculpture"],"nl":["Galeries","Beeldhouwkunst"],"en":["Art Galleries","Sculpture"],"de":["Kunstgalerien","Skulptur"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Philippe Denis - \u00ab Sculptures 1960 - 1970\u00a0\u00bb","shortdescr":"La Schiller Art Gallery en collaboration avec la famille de l'artiste pr\u00e9sentera pour la premi\u00e8re fois \u00e0 Bruxelles une r\u00e9trospective des sculptures de l'artiste Philippe Denis (1912-1978).","longdescr":"Schiller Art Gallery d\u00e9fend et valorise l'art belge du XX si\u00e8cle en pr\u00e9sentant au public, aux marchands et collectionneurs des oeuvres de qualit\u00e9.\r\n\r\nLa Schiller Art Gallery en collaboration avec la famille de l'artiste pr\u00e9sentera pour la premi\u00e8re fois \u00e0 Bruxelles une r\u00e9trospective des sculptures de l'artiste Philippe Denis (1912-1978). Cette exposition riche d'une vingtaine d'oeuvres et de dessins datant des ann\u00e9es 60\/70 valorisera le travail exceptionnel de cet artiste de l'apr\u00e8s-guerre. Pour l'occasion, un catalogue sera publi\u00e9 retra\u00e7ant le parcours de Philippe Denis.","performers":"Philippe Denis","boxoffice_url":null,"website":"http:\/\/www.facebook.com\/schiller.gallery\/","email":"gregverdonck@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.540955"},"nl":{"name":"Philippe Denis - \u00ab Sculptures 1960 - 1970\u00a0\u00bb","shortdescr":"Voor de 1ste maal wordt er in Brussel een uitzonderlijke retrospectieve gehouden van de werken van Philippe Denis. Deze tentoonstelling komt tot stand dankzij de mederwerking van de familie met Schiller Art Gallery.","longdescr":"Schiller Art Gallery laat sinds meer dan 10 jaar het grote publiek kennismaken met moderne Belgische kunst uit de jaren 20 tot en met 70.\r\n\r\nVoor de 1ste maal wordt er in Brussel een uitzonderlijke retrospectieve gehouden van de werken van Philippe Denis. Deze tentoonstelling komt tot stand dankzij de mederwerking van de familie met Schiller Art Gallery.\r\n\r\nDeze uitdagende tentoonstelling neemt bezoekers mee in de wereld van deze Belgische beeldhouwer. Zo kan men zijn werken herbewonderen of ontdekken. De meeste ervan werden gemaakt tussen 1960 \u2013 1970 periode waarin Philippe Denis van stijl veranderde in een meer moderne \/ abstracte wijze tot uitting kwam. Er zullen dan ook verschillende tekeningen en beelden aanwezig zijn.\r\n\r\nPhilippe Denis stond open voor voortdurende vernieuwing en voor experimenten met uiteenlopend materiaal. Door zijn eerdere ondervindingen bewerkte hij zijn beelden met passie en werden ze zowel in koper, messing, staal of ijzer gekenmerkt door de mooie lijnen om deze door te geven aan zijn publiek. Philippe Denis schaafde uren aan zijn gipsen modellen, totdat hij de meest elegante vorm bereikte. Men mag het beschouwer als een \u00ab oeuvre \u00bb naar vrijheid en spontaniteiten.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.540955"},"en":{"name":"Philippe Denis - \u00ab Sculptures 1960 - 1970\u00a0\u00bb","shortdescr":"Schiller Art Gallery in collaboration with the artist's estate will present for the first time in Brussels  a retrospective of the sculptures of the sculptor Philippe Denis (1912-1978).","longdescr":"Schiller Art Gallery promotes 20th century Belgian art by presenting quality works to the public, dealers and collectors.\r\n\r\nSchiller Art Gallery in collaboration with the artist's estate will present for the first time in Brussels, a retrospective of the sculptures of the sculptor Philippe Denis (1912-1978). This exhibition of around twenty works and drawings dating from the 60s and 70s will highlight the exceptional work of this post-war artist. For the occasion, a catalog will be published.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.540955"},"de":{"name":"Philippe Denis - \u00ab Sculptures 1960 - 1970\u00a0\u00bb","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.540955"},"it":{"name":"Philippe Denis - \u00ab Sculptures 1960 - 1970\u00a0\u00bb","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.540955"},"sp":{"name":"Philippe Denis - \u00ab Sculptures 1960 - 1970\u00a0\u00bb","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.540955"},"pt":{"name":"Philippe Denis - \u00ab Sculptures 1960 - 1970\u00a0\u00bb","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.540955"},"cn":{"name":"Philippe Denis - \u00ab Sculptures 1960 - 1970\u00a0\u00bb","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.540955"}},"plac