a\/event-detail.50012045"},"pt":{"name":"les images flottantes | Patrick CORILLON","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/theatre-martyrs.be\/spectacles\/les-images-flottantes\/","email":"billetterie@theatre-martyrs.be","phone_contact":null,"phone_booking":"+32 2 223 32 08","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50012045"},"en":{"name":"Les images flottantes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/theatre-martyrs.be\/spectacles\/les-images-flottantes\/","email":"billetterie@theatre-martyrs.be","phone_contact":null,"phone_booking":"+32 2 223 32 08","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50012045"},"it":{"name":"les images flottantes | Patrick CORILLON","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/theatre-martyrs.be\/spectacles\/les-images-flottantes\/","email":"billetterie@theatre-martyrs.be","phone_contact":null,"phone_booking":"+32 2 223 32 08","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50012045"},"cn":{"name":"les images flottantes | Patrick CORILLON","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/theatre-martyrs.be\/spectacles\/les-images-flottantes\/","email":"billetterie@theatre-martyrs.be","phone_contact":null,"phone_booking":"+32 2 223 32 08","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50012045"},"fr":{"name":"Les images flottantes","shortdescr":null,"longdescr":"les vies en soi - volet 5\n\n60 minutes pour rentrer dans le cadre\n\nDurant une heure, ce projet raconte l\u2019histoire d\u2019un petit gar\u00e7on transport\u00e9 dans le monde des images. Il apprendra, gr\u00e2ce \u00e0 un stage d\u2019initiation \u00e0 la peinture au Mus\u00e9e d\u2019Art moderne de la Ville de Paris, \u00e0 sortir de lui-m\u00eame et en quelque sorte \u00e0 sortir du cadre pour d\u00e9couvrir le monde. Tout part d\u2019un souvenir, mat\u00e9rialis\u00e9 par quelques \u00e9l\u00e9ments import\u00e9s dans la salle du mus\u00e9e : un lutrin et quatre bo\u00eetes enfermant de petits objets ayant une grande force symbolique. Dans l\u2019une de ces bo\u00eetes, quelques carr\u00e9s noirs sur lesquels sont plac\u00e9es des croix blanches.\nCes croix, semblables \u00e0 celles utilis\u00e9es pour marquer sur les sc\u00e8nes de th\u00e9\u00e2tre la position des com\u00e9diens ou des d\u00e9cors, deviennent un point d\u2019accroche que l\u2019artiste utilise pour capter le regard et d\u00e9marrer son r\u00e9cit. Les images flottantes \u2013 60 minutes pour rentrer dans le cadre propose une v\u00e9ritable d\u00e9claration d\u2019amour \u00e0 la peinture, \u00e0 travers les yeux d\u2019un enfant. La performance provoque un dialogue intime avec les \u0153uvres issues des collections mus\u00e9ales et intensifie de la sorte le regard port\u00e9 sur la peinture.\n\nProfitez de tarifs attractifs en combinant l\u2019achat de plusieurs volets des Vies en soi gra\u0302ce au Combo 3, 5 ou 7 !\n\nCOMBO 3 : Plein tarif 54 \u20ac | + 65 ans 45 \u20ac | \u2013 30 ans 33 \u20ac\n\nCOMBO 5 : Plein tarif 80 \u20ac | + 65 ans 65 \u20ac | \u2013 30 ans 50 \u20ac \n\nCOMBO 7 : Plein tarif 100 \u20ac | + 65 ans 80 \u20ac | \u2013 30 ans 65 \u20ac","performers":"\u00e9criture, sc\u00e9nographie et jeu Patrick Corillon\ncollaboration artistique Dominique Roodthooft\nassistance graphique Raoul Lhermitte\nassistance sc\u00e9nographique R\u00fcdiger Fl\u00f6rke\n\nproduction le corridor (Li\u00e8ge)\navec le soutien de la F\u00e9d\u00e9ration Wallonie-Bruxelles\/Service du Th\u00e9\u00e2tre et de la Wallonie\/Emploi","boxoffice_url":null,"website":"https:\/\/theatre-martyrs.be\/spectacles\/les-images-flottantes\/","email":"billetterie@theatre-martyrs.be","phone_contact":null,"phone_booking":"+32 2 223 32 08","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50012045"},"sp":{"name":"les images flottantes | Patrick CORILLON","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/theatre-martyrs.be\/spectacles\/les-images-flottantes\/","email":"billetterie@theatre-martyrs.be","phone_contact":null,"phone_booking":"+32 2 223 32 08","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50012045"},"nl":{"name":"Les images flottantes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/theatre-martyrs.be\/spectacles\/les-images-flottantes\/","email":"billetterie@theatre-martyrs.be","phone_contact":null,"phone_booking":"+32 2 223 32 08","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50012045"}},"place":{"id":231711,"translations":{"de":{"name":"Th\u00e9\u00e2tre des Martyrs","address_street_name":"Place des Martyrs","address_street_number":"22","address_street_box":null,"email":"billetterie@theatre-martyrs.be","website":"http:\/\/www.theatre-martyrs.be","phone_contact":"+32 2 223 32 08","phone_booking":"+32 2 223 32 08","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Martyrs, 22","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Th\u00e9\u00e2tre des Martyrs","address_street_name":"Place des Martyrs","address_street_number":"22","address_street_box":null,"email":"billetterie@theatre-martyrs.be","website":"http:\/\/www.theatre-martyrs.be","phone_contact":"+32 2 223 32 08","phone_booking":"+32 2 223 32 08","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Martyrs, 22","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Th\u00e9\u00e2tre des Martyrs","address_street_nam