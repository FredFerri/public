"],"it":[null,null],"sp":[null,null],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Stan Pollet et Pipou - Cru 2023","shortdescr":"On les aime ! Comme le vin ! Cela s'est encore plus affin\u00e9... Le Cru Stan et Pipou 2023 ! Depuis deux saisons, il a eu le temps d'arriver \u00e0 maturation ce cru-l\u00e0... Alors ils reviennent et on se d\u00e9lecte... On en reprend jusqu'\u00e0 l'ivresse... Et on se r\u00e9p\u00e8te... Cela fait bient\u00f4t 24 ans... Et ils avaient d\u00e9j\u00e0 de la bouteille\u2026","longdescr":"On les aime ! Comme le vin ! Cela s'est encore plus affin\u00e9... Le Cru Stan et Pipou 2023 ! Depuis deux saisons, il a eu le temps d'arriver \u00e0 maturation ce cru-l\u00e0... Alors ils reviennent et on se d\u00e9lecte... On en reprend jusqu'\u00e0 l'ivresse... Et on se r\u00e9p\u00e8te... Cela fait bient\u00f4t 24 ans... Et ils avaient d\u00e9j\u00e0 de la bouteille\u2026 Avec eux, on a un nez de fruits rouges et noirs d\u00e9licatement \u00e9pic\u00e9s. En bouche, ils montrent vraiment une tr\u00e8s belle mati\u00e8re, soyeuse. La structure est bien fondue. Ils nous feraient croire qu'ils sont bien mont\u00e9s. L'\u00e9quilibre est parfait, avec une petite note de fra\u00eecheur qui se manifeste en finale sur des ar\u00f4mes l\u00e9g\u00e8rement menthol\u00e9s. Jamais amers... C'est pas de la vinasse\u00a0! Ils seront bient\u00f4t class\u00e9s au patrimoine mondial de l'Unesco...  et d\u00e9j\u00e0 reconnus d'utilit\u00e9 publique.","performers":"Stan Pollet (chant, guitare, paroles et musique); Pipou (chant, kongas, paroles et musique)","boxoffice_url":null,"website":"http:\/\/www.lejardindemasoeur.be","email":"info@lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.539441"},"nl":{"name":"Stan Pollet et Pipou - Cru 2023","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.539441"},"en":{"name":"Stan Pollet et Pipou - Cru 2023","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.539441"},"de":{"name":"Stan Pollet et Pipou - Cru 2023","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.539441"},"it":{"name":"Stan Pollet et Pipou - Cru 2023","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.539441"},"sp":{"name":"Stan Pollet et Pipou - Cru 2023","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.539441"},"pt":{"name":"Stan Pollet et Pipou - Cru 2023","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.539441"},"cn":{"name":"Stan Pollet et Pipou - Cru 2023","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.539441"}},"place":{"id":220283,"translations":{"fr":{"name":"Le Jardin de ma Soeur","address_street_name":"A l'angle du quai au Bois \u00e0 Br\u00fbler et de la rue du Grand Hospice","address_street_number":null,"address_street_box":null,"email":"info@lejardindemasoeur.be","website":"http:\/\/www.lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","address_zip":"1000","address_city":"Bruxelles","address_line1":"A l'angle du quai au Bois \u00e0 Br\u00fbler et de la rue du Grand Hospice","address_line2":"1000 Bruxelles","description_web":"Le Jardin de ma S\u0153ur est situ\u00e9 au coin d'une rue du pittoresque March\u00e9 aux poissons, \u00e0 proximit\u00e9 de l\u2019ancien Grand B\u00e9guinage de Bruxelles. On peut difficilement imaginer un nom plus familier. Pourtant, cet endroit n'a pas vol\u00e9 son nom. Vous obtenez exactement ce que vous attendez : une soir\u00e9e sans pr\u00e9tention, pleine de divertissements et de moments partag\u00e9s. Vous vous y sentez comme dans votre salon. Vous oubliez imm\u00e9diatement tous vos soucis et riez, chantez et profitez du spectacle avec les autres participants. Sp\u00e9cialement pour les amateurs de chanson fran\u00e7aise et de th\u00e9\u00e2tre.  \u202f \r\nPensez \u00e0 r\u00e9server votre place !\r\n ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Le Jardin de ma Soeur","address_street_name":"Op de hoek van de Brandhoutkaai en de Grootgodshuisstraat","address_street_number":null,"address_street_box":null,"email":"info@lejardindemasoeur.be","website":"http:\/\/www.lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","address_zip":"1000","address_city":"Brussel","address_line1":"Op de hoek van de Brandhoutkaai en de Grootgodshuisstraat","address_line2":"1000 Brussel","description_web":"Op een straathoek aan de pittoreske Vismarkt ligt Le Jardin de ma Soeur. Een familialere naam kan je haast niet bedenken. Toch heeft deze plek haar naam niet gestolen. Je krijgt exact wat je er zou verwachten: een pretentieloze avond vol vertier en gedeelde momenten. Hier waan je je in een gezellige en veilige woonkamer. Je vergeet er meteen al je zorgen en lacht, zingt en geniet met de andere aanwezigen. Vooral voor liefhebbers van het Franse chanson en verhaaltheater.    \u202f\u202f\u202f ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Le Jardin de ma Soeur","address_street_name":"A l'angle du quai au Bois \u00e0 Br\u00fbler et de la rue du Grand Hospice","address_street_number":null,"address_street_box":null,"email":"info@lejardindemasoeur.be","website":"http:\/\/www.lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","address_zip":"1000","address_city":"Brussels","address_line1":"A l'angle du quai au Bois \u00e0 Br\u00fbler et de la rue du Grand Hospice","address_line2":"1000 Brussels","description_web":"The desire to present theater amongst people; as if a performance is nothing but a conversation, in a place somewhere in between the large halls and the streets, half living room, half pub, in a warm ambiance where one can sip a glass while watching a performance. That's cafe-theater \"Le Jardin de ma Soeur\", at the edge of the ancient \"Grand B\u00e9guinage de Bruxelles\", alongside one of the quays of the old port of Brussels where the spirit of the dock workers lingers and where one can still feel the presence of the beguines with their long black robes.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Le Jardin de ma Soeur","address_street_name":"A l'angle du quai au Bois \u00e0 Br\u00fbler et de la rue du Grand Hospice","address_street_number":null,"address_street_box":null,"email":"info@lejardindemasoeur.be","website":"http:\/\/www.lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","address_zip":"1000","address_city":"Bruxelles","address_line1":"A l'angle du quai au Bois \u00e0 Br\u00fbler et de la rue du Grand Hospice","address_line2":"1000 Bruxelles","description_web":"Dieses malerische Caf\u00e9-Theater, das 1994 in der N\u00e4he des alten \"Grand B\u00e9guinage de Bruxelles\" er\u00f6ffnet wurde, \u00fcberrascht durch seine \u00fcberaus kleinen R\u00e4umlichkeiten. Doch daf\u00fcr ist das Programm ist umso \"gr\u00f6\u00dfer\". Reservierung empfohlen!","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Le Jardin de ma Soeur","address_street_name":"A l'angle du quai au Bois \u00e0 Br\u00fbler et de la rue du Grand Hospice","address_street_number":null,"address_street_box":null,"email":"info@lejardindemasoeur.be","website":"http:\/\/www.lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","address_zip":"1000","address_city":"Bruxelles","address_line1":"A l'angle du quai au Bois \u00e0 Br\u00fbler et de la rue du Grand Hospice","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Le Jardin de ma Soeur","address_street_name":"A l'angle du quai au Bois \u00e0 Br\u00fbler et de la rue du Grand Hospice","address_street_number":null,"address_street_box":null,"email":"info@lejardindemasoeur.be","website":"http:\/\/www.lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","address_zip":"1000","address_city":"Bruxelles","address_line1":"A l'angle du quai au Bois \u00e0 Br\u00fbler et de la rue du Grand Hospice","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Le Jardin de ma Soeur","address_street_name":"A l'angle du quai au Bois \u00e0 Br\u00fbler et de la rue du Grand Hospice","address_street_number":null,"address_street_box":null,"email":"info@lejardindemasoeur.be","website":"http:\/\/www.lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","address_zip":"1000","address_city":"Bruxelles","ad