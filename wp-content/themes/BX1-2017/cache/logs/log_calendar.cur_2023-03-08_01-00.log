kelijk","Voorzieningen voor dove en slechthorende personen"],"en":["Accessible","Facilities for deaf and hearing-impaired people"],"de":["Barrierefrei","Anpassungen f\u00fcr geh\u00f6rlose und h\u00f6rgesch\u00e4digte Menschen."],"it":["Accessibile","Disposizioni per persone non udenti e ipoudenti"],"sp":["Habilitado","Equipos para personas sordas y con problemas de audici\u00f3n"],"pt":[null,null],"cn":[null,null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2023-02-18T07:05:19+01:00","published_at":"2023-01-31T11:36:31+01:00","backoffice_id":270653,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":1},{"id":540597,"date_start":"2023-03-14","date_end":"2023-03-18","date_next":"2023-03-14","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater","it":"Teatro","sp":"Teatro","pt":null,"cn":null}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"],"de":["Theater"],"it":["Teatro"],"sp":["Teatro"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Hello world | Maxime Arnould","shortdescr":"\u00ab Il ressemble \u00e0 quoi votre safe place ? *\u00bb","longdescr":"\u00ab Il ressemble \u00e0 quoi votre safe place ? *\u00bb\r\n\r\nHello world est une installation technologique autonome dans laquelle Maxime et un drone cohabitent. Bienvenu\u00b7es dans un monde programm\u00e9 qui r\u00e9pondrait \u00e0 nos \u00e9motions. \r\n\r\nAvec cette cr\u00e9ation, Maxime Arnould affronte sa peur des drones et leur double identit\u00e9, \u00e0 la fois armes de guerre et jouets, et il interroge \u00ab Comment la technologie peut-elle devenir un m\u00e9dium de projection et de cr\u00e9ation de nouveaux \u00e9cosyst\u00e8mes ? \u00bb. Dans une situation de crise telle que nous la vivons, il semble important de poser un nouveau regard sur les outils de surveillance qui composent le paysage contemporain (\u00e0 la maison ou \u00e0 l\u2019ext\u00e9rieur), mais aussi en r\u00e9fl\u00e9chissant \u00e0 des outils accessibles \u00e0 tous\u00b7tes pour lutter.\r\n\r\n\r\n\r\n*Un safe place peut-\u00eatre \u00e0 la fois un abri confortable, un lieu o\u00f9 se prot\u00e9ger ou un espace se\u0301curisant. Dans un contexte militant, il s'adresse \u00e0 des populations opprime\u0301es et discrimin\u00e9es du fait de leur genre, leurs origines, leur orientation sexuelle, leurs id\u00e9ologies politiques ou religieuses. En groupe ou pour soi, il permet \u00e0 chacun\u00b7es de se sentir libre de se reposer, s\u2019exprimer sans jugement, ni voir son expe\u0301rience nie\u0301e en vue de trouver des outils ou des perspectives de luttes.","performers":null,"boxoffice_url":null,"website":"https:\/\/balsamine.be\/balsa_post\/hello-world\/","email":"reservation@balsamine.be","phone_contact":"+32 2 735 64 68","phone_booking":"+32 2 735 64 68","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.540597"},"nl":{"name":"Hello world | Maxime Arnould","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/balsamine.be\/balsa_post\/hello-world\/","email":"relations.publiques@balsamine.be","phone_contact":"+32 2 735 64 68","phone_booking":"+32 2 735 64 68","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.540597"},"en":{"name":"Hello world | Maxime Arnould","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/balsamine.be\/balsa_post\/hello-world\/","email":"relations.publiques@balsamine.be","phone_contact":"+32 2 735 64 68","phone_booking":"+32 2 735 64 68","agenda_url":"https:\