ull],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"La m\u00e9tamorphose des cigognes","shortdescr":"L\u2019acteur et auteur Marc Arnaud nous livre les confessions d\u2019un homme qui se pr\u00e9pare pour une f\u00e9condation in vitro et pose un regard masculin sur la P.M.A.","longdescr":"Il interpr\u00e8te avec une folle \u00e9nergie tous les personnages crois\u00e9s au fil de ce parcours v\u00e9cu avec sa femme et nous fait nous tordre de rire.\r\n\r\nTout commence dans une salle de recueil de sperme. Un homme, face \u00e0 son gobelet est invit\u00e9 par l\u2019infirmier \u00e0 \u00ab enclencher le protocole \u00bb tandis que sa femme attend au bloc op\u00e9ratoire. Seul, face \u00e0 nous pendant une heure, il interroge son d\u00e9sir d\u2019\u00eatre p\u00e8re et son existence. Jamais scabreux, sensible tout en \u00e9tant dr\u00f4le, ce seul en sc\u00e8ne surprenant est \u00e0 d\u00e9couvrir sans h\u00e9siter. Un succ\u00e8s tant au Festival Off d\u2019Avignon qu\u2019\u00e0 Paris.","performers":"DE et AVEC Marc Arnaud MISE EN SC\u00c8NE Benjamin Guillard LUMI\u00c8RE Fran\u00e7ois Leneveu DIFFUSION ACME Diffusion REMERCIEMENT Isabelle Peracchi, Igor Mendjisky, Aurore Paris, Thibault Perrenoud, Jean Fran\u00e7ois Sivadier, Youssef Bouchikhi CO-PRODUCTION ACME, 964 PRODUCTIONS","boxoffice_url":null,"website":"https:\/\/www.wolubilis.be\/a-voir\/la-metamorphose-des-cigognes\/","email":"info@wolubilis.be","phone_contact":"+32 2 761 60 30","phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.542196"},"nl":{"name":"La m\u00e9tamorphose des cigognes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.542196"},"en":{"name":"La m\u00e9tamorphose des cigognes","shortdescr":null,"longdescr":null,"pe