ed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[24,30],"translations":{"fr":["Galeries d'art","Peinture"],"nl":["Galeries","Schilderkunst"],"en":["Art Galleries","Painting"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Soir\u00e9e immersive De l\u2019Abstraction comme expression symbolique d\u2019une aventure int\u00e9rieure","shortdescr":"Soir\u00e9e immersive De l\u2019Abstraction comme expression symbolique d\u2019une aventure int\u00e9rieure\r\nLa Maison commune a le plaisir d\u2019accueillir Zohra Hassani pour une soir\u00e9e immersive le 11 juin \u00e0 19h30. Venez vous immerger dans la s\u00e9rie New Talisman en pr\u00e9sence de l'artiste qui vous fera d\u00e9couvrir son univers spirituel.","longdescr":"Soir\u00e9e immersive De l\u2019Abstraction comme expression symbolique d\u2019une aventure int\u00e9rieure - Rencontre et partage avec l'artiste\u00a0Zohra Hassani\r\n\r\nLa Maison commune a le plaisir d\u2019accueillir Zohra Hassani pour une soir\u00e9e immersive le 11 juin \u00e0 19h30.\r\nVenez vous immerger dans la s\u00e9rie New Talisman en pr\u00e9sence de l'artiste qui vous fera d\u00e9couvrir son univers spirituel. Inspir\u00e9e par son h\u00e9ritage de la tradition mystique arabo-musulmane, d\u00e9couvrez comment l'artiste franco-alg\u00e9rienne se r\u00e9approprie la notion de talisman et cr\u00e9e ses propres formes d'expression symbolique. Un ouvrage qui vous fera voyager dans la pens\u00e9e arabe du XIVe si\u00e8cle \u00e0 notre \u00e9poque cosmopolite contemporaine.\r\n\r\nProgramme\r\nPr\u00e9sentation des toiles sous \u00e9clairage domestique \r\nDeuxi\u00e8me lecture des toiles sous \u00e9clairage UV. \r\nExplication de l\u2019art sacr\u00e9, le sens et ses symboles\r\nQ\/R et \u00e9change avec l\u2019artiste sur son travail\r\n\r\nEntr\u00e9e libre sur R\u00e9servation (R\u00e9servations: reservations@culturesetpublics.be)","performers":"Zohra Hassani","boxoffice_url":null,"website":"http:\/\/culturesetpublics.be\/","email":"reservations@culturesetpublics.be","phone_contact":"+32 2 380 38 18","phone_booking":"+32 2 380 38 18","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/533325.html"},"nl":{"name":"Soir\u00e9e immersive De l\u2019Abstraction comme expression symbolique d\u2019une aventure int\u00e9rieure","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/533325.html"},"en":{"name":"Soir\u00e9e immersive De l\u2019Abstraction comme expression symbolique d\u2019une aventure int\u00e9rieure","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/533325.html"},"de":{"name":"Soir\u00e9e immersive De l\u2019Abstraction comme expression d\u2019une aventure int\u00e9rieure","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/533325.html"},"it":{"name":"Soir\u00e9e immersive De l\u2019Abstraction comme expression d\u2019une aventure int\u00e9rieure","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/533325.html"},"sp":{"name":"Soir\u00e9e immersive De l\u2019Abstraction comme expression d\u2019une aventure int\u00e9rieure","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":