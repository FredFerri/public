te":"https:\/\/www.sprechendesteine.eu\/fr\/event","email":"sprechendesteine.bruessel@gmail.com","phone_contact":"+32 473 80 05 19","phone_booking":"+32 473 80 05 19","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700003076"},"fr":{"name":"La Bourse de Bruxelles - un petit joufflu \u00e0 la conqu\u00eate du monde","shortdescr":"La Bourse de Bruxelles - Un petit joufflu \u00e0 la conqu\u00eate du monde","longdescr":"La balade de 2 heures se divise en deux parties: \n\nLa Bourse de Bruxelles - Un petit joufflu \u00e0 la conqu\u00eate du monde\n\nDans la premi\u00e8re partie nous remontons aux origines: des d\u00e9buts des march\u00e9s dans les villes du Moyen-\u00c2ge, \u00e0 l'ascension des soci\u00e9t\u00e9s anonymes... \n\nDans la deuxi\u00e8me partie, nous d\u00e9chiffrons la symbolique du d\u00e9cor de cette Bourse qui se prend pour une op\u00e9ra. La richesse vient du travail. Mais qui travaille ici ?\nR\u00e9servation obligatoire! La visite n'a pas lieu, s'il n'y a pas d'inscrits.","performers":"Ute - guide","boxoffice_url":null,"website":"https:\/\/www.sprechendesteine.eu\/fr\/event","email":"sprechendesteine.bruessel@gmail.com","phone_contact":"+32 473 80 05 19","phone_booking":"+32 473 80 05 19","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700003076"},"sp":{"name":"La Bourse de Bruxelles - un petit joufflu \u00e0 la conqu\u00eate du monde","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.sprechendesteine.eu\/fr\/event","email":"sprechendesteine.bruessel@gmail.com","phone_contact":"+32 473 80 05 19","phone_booking":"+32 473 80 05 19","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700003076"},"nl":{"name":"La Bourse de Bruxelles - un petit joufflu \u00e0 la conqu\u00eate du monde","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.sprechendesteine.eu\/fr\/event","email":"sprec