ude Bolling - entre classique et jazz","copyright":null},"nl":{"title":"Claude Bolling - entre classique et jazz","copyright":null},"en":{"title":"Claude Bolling - entre classique et jazz","copyright":null}}}],"dates":[{"day":"2022-10-21","doors":"18:30:00","start":"19:30:00","end":null,"is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":25},{"translations":{"fr":{"name":"Enfants"},"nl":{"name":"Kinderen"},"en":{"name":"Children"}},"value":15},{"translations":{"fr":{"name":"Jeunes"},"nl":{"name":"Jongeren"},"en":{"name":"Young people"}},"value":15},{"translations":{"fr":{"name":"Etudiants"},"nl":{"name":"Studenten"},"en":{"name":"Students"}},"value":15},{"translations":{"fr":{"name":"Seniors"},"nl":{"name":"Senioren"},"en":{"name":"Seniors"}},"value":15},{"translations":{"fr":{"name":"Demandeurs d'emploi"},"nl":{"name":"Werkzoekenden"},"en":{"name":"Job seekers"}},"value":15},{"translations":{"fr":{"name":"Groupe"},"nl":{"name":"Groep"},"en":{"name":"Group"}},"value":15}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"visit_profile":{"list":[326],"translations":{"fr":["Jazz"],"nl":["Jazz"],"en":["Jazz"],"de":["Jazz"]}},"tags":[],"accessibilities":{"list":[252,256,257,259,263],"translations":{"fr":["Accessible aux personnes ayant des difficult\u00e9s de compr\u00e9hension","Am\u00e9nagements pour les personnes aveugles et malvoyantes","Am\u00e9nagements pour personnes sourdes et malentendantes","Chien d'assistance","Accessible aux pi\u00e9tons appareill\u00e9s"],"nl":["Toegankelijk voor mensen met een verstandelijke beperking","Voorzieningen voor blinde en slechtziende personen","Voorzieningen voor dove en slechthorende personen","Assistentiehonden","Toegankelijk voor voetgangers met hulpmiddelen"],"en":["Accessible to people with intellectual disabilities","Facilities for blind and partially-sighted persons","Facilities for deaf and hearing-impaired people","Assistance dogs","Accessible to pedestrians with mobility aids"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-11T03:36:13+02:00","published_at":"2022-09-26T11:58:07+02:00","backoffice_id":262595,"import_origin":null,"sub_type":"concert","show_in_agenda":true,"ranking":1.2599210498949},{"id":543481,"date_start":"2022-10-21","date_end":"2022-10-21","date_next":"2022-10-21","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert","de":"Konzert"}},"others":{"list":[2],"translations":{"fr":["Classique"],"nl":["Klassiek"],"en":["Classical"],"de":["Klassisch"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Abendlied","shortdescr":"Pr\u00e8s de 3 ans apr\u00e8s notre dernier concert, nous sommes ravis de nous produire \u00e0 nouveau devant un public ! Abendlied 2022 rassemble une partie du r\u00e9pertoire que nous pr\u00e9parions pour notre concert de mars 2020 et les World Choir Games 2020, avant l\u2019arriv\u00e9e de la Covid.\r\n\r\nRejoignez-nous pour ces deux concerts de reprise \u00e0 Bruxelles !","longdescr":"Pr\u00e8s de 3 ans apr\u00e8s notre dernier concert, nous sommes ravis de nous produire \u00e0 nouveau devant un public ! Abendlied 2022 rassemble une partie du r\u00e9pertoire que nous pr\u00e9parions pour notre concert de mars 2020 et les World Choir Games 2020, avant l\u2019arriv\u00e9e de la Covid.\r\n\r\nOutre le chef-d'\u0153uvre de Josef Rheinberger \"Abendlied\", qui donne son nom \u00e0 ce projet, nous interpr\u00e9terons un m\u00e9lange \u00e9clectique d'\u0153uvres de compositeurs anglais, \u00e9cossais, belges, norv\u00e9giens, finlandais, estoniens et espagnols. Ceci inclut deux nouvelles cr\u00e9ations par les membres du BCC Jan Moeyaert et Fraser Sharp, le majestueux \"Bring us, O Lord God\" de William H. Harris, chant\u00e9 aux fun\u00e9railles de la reine Elizabeth II, et l'envo\u00fbtant \"Ave Generosa\" d'Ola Gjeilo.\r\n\r\nRejoignez-nous pour ces deux concerts de reprise \u00e0 Bruxelles !","performers":"Helen Cassano and the Brussels Chamber Choir","boxoffice_url":null,"website":"http:\/\/www.brusselschamberchoir.be","email":"info@brusselschamberchoir.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.543481"},"nl":{"name":"Abendlied","shortdescr":"We zijn verheugd om, bijna 3 jaar na ons laatste concert, opnieuw voor een live publiek op te treden! Met Abendlied 2022 brengen we de muziek samen die we hadden voorbereid voor ons concert in maart 2020 \u00e9n voor de World Choir Games 2020.\r\n\r\nWe hopen u talrijk te mogen verwelkomen tijdens deze twee bijzondere reboot concerten in Brussel!","longdescr":"We zijn verheugd om, bijna 3 jaar na ons laatste concert, opnieuw voor een live publiek op te treden! Met Abendlied 2022 brengen we de muziek samen die we hadden voorbereid voor ons concert in maart 2020 \u00e9n voor de World Choir Games 2020.\r\n\r\nNaast \u201cAbendlied\u201d, het meesterwerk van Josef Rheinberger waarnaar de titel van het concert verwijst, brengen we een verscheidenheid aan werken van Engelse, Schotse, Belgische, Noorse, Finse, Estse en Spaanse componisten. Twee premi\u00e8res van huiscomponisten Jan Moeyaert en Fraser Sharp staan op het programma, alsook het majestueuze \u201cBring us, O Lord\u201d van William Harris, dat gezongen werd tijdens de begrafenis van de Britse Queen Elizabeth II, en het beklijvende \u201cAve Generosa\u201d van Ola Gjeilo.\r\n\r\nWe hopen u talrijk te mogen verwelkomen tijdens deze twee bijzondere reboot concerten in Brussel!","performers":"Helen Cassano and the Brussels Chamber Choir","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.543481"},"en":{"name":"Abendlied","shortdescr":"Nearly 3 years after our last concert, we are delighted to be performing for a live audience again! Abendlied 2022 brings together some of the music we were preparing for our March 2020 concert and the World Choir Games 2020 before Covid hit.\r\n\r\nPlease join us for these two special reboot concerts in Brussels!","longdescr":"Nearly 3 years after our last concert, we are delighted to be performing for a live audience again! Abendlied 2022 brings together some of the music we were preparing for our March 2020 concert and the World Choir Games 2020 before Covid hit.\r\n\r\nBesides Josef Rheinberger\u2019s masterpiece \u201cAbendlied\u201d, which gives its name to this project, we will perform an eclectic mix of works by English, Scottish, Belgian, Norwegian, Finnish, Estonian and Spanish composers. This includes two premieres by BCC members Jan Moeyaert and Fraser Sharp, William H. Harris\u2019 majestic \u201cBring us, O Lord God\u201d, sung at Queen Elizabeth II\u2019s funeral, and Ola Gjeilo\u2019s mesmerising \u201cAve Generosa\u201d.\r\n\r\nPlease join us for these two special reboot concerts in Brussels!","performers":"Helen Cassano and the Brussels Chamber Choir","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.543481"},"de":{"name":"Abendlied","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.543481"},"it":{"name":"Abendlied","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_