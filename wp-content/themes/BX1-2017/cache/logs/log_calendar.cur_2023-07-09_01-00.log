["fr","en"],"subtitles":[]},"translations":{"fr":{"name":"Picasso 50 ans apr\u00e8s... (1973-2023)","shortdescr":"Le 8 avril 2023 marquait le 50e anniversaire de la disparition de Pablo Picasso.\r\nAfin de rendre hommage \u00e0 celui que beaucoup consid\u00e8rent comme l\u2019inventeur de \u00ab l\u2019art moderne \u00bb nous avons convi\u00e9 une douzaine d\u2019artistes internationaux autour d\u2019une exposition collective.","longdescr":"Picasso, 50 ans apr\u00e8s... (1973-2023) questionnera le statut de l\u2019artiste aujourd\u2019hui.\r\nEst-il autant v\u00e9n\u00e9r\u00e9 par la jeune g\u00e9n\u00e9ration et son \u0153uvre influence t\u2019elle toujours la cr\u00e9ation artistique ? Les avanc\u00e9s r\u00e9centes du f\u00e9minisme vont-elles nous inciter \u00e0 consid\u00e9rer diff\u00e9remment \u00ab Le Maitre \u00bb ? La fameuse question, doit-on s\u00e9parer l\u2019homme de l\u2019artiste, doit-elle \u00eatre pos\u00e9e ?","performers":"Boris Anje (Anjel); Fran\u00e7ois Boisrond; Bordalo II; Brusk; Vincent Corpet; C215; Jillian Evelyn; Maike Freess; Gris1; Levalet; Darian Mederos; Laurina Paperina; Pantonio; Rero;   Stom500; Vuk Vidor","boxoffice_url":null,"website":"http:\/\/www.mazelgalerie.com","email":"contact@mazelgalerie.com","phone_contact":"+32 2 850 29 28","phone_booking":"+32 2 850 29 28","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.557617"},"nl":{"name":"Picasso 50 ans apr\u00e8s... (1973-2023)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.mazelgalerie.com","email":"contact@mazelgalerie.com","phone_contact":"+32 2 850 29 28","phone_booking":"+32 2 850 29 28","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.557617"},"en":{"name":"Picasso 50 years later... (1973-2023)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.mazelgalerie.com","email":"contact@mazelgalerie.com","phone_contact":"+32 2 8