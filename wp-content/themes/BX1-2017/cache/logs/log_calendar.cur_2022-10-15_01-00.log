on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen"}},"others":{"list":[109],"translations":{"fr":["Espaces verts"],"nl":["Groene zones"],"en":["Green spaces"],"de":["Gr\u00fcnfl\u00e4chen"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"D\u00e9couverte du jardin botanique Jean Massart","shortdescr":null,"longdescr":"Dans le cadre de la journ\u00e9e de la For\u00eat de Soignes, l\u2019ULB vous propose de d\u00e9couvrir les collections du jardin botanique Jean Massart.\r\n\r\nLe jardin botanique Jean Massart, qui souffle sa centi\u00e8me bougie cette ann\u00e9e, est situ\u00e9 \u00e0 c\u00f4t\u00e9 de la Porte d'Entr\u00e9e 'Rouge Clo\u00eetre' aux abords de la for\u00eat de Soignes.\r\n\r\n- Inscription obligatoire via notre site web. Merci de nous tenir au courant si vous devez annuler votre inscription afin de laisser de la place aux autres int\u00e9ress\u00e9s (nombre de places limit\u00e9s par guide).","performers":null,"boxoffice_url":null,"website":"https:\/\/sciences.brussels\/agenda\/journeeforetdesoignes\/","email":"jardmass@ulb.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.542363"},"nl":{"name":"D\u00e9couverte du jardin botanique Jean Massart","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.542363"},"en":{"name":"D\u00e9couverte du jardin botanique Jean Massart","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.542363"},"de":{"name":"D\u00e9couverte du jardin botanique Jean Massart","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.542363"},"it":{"name":"D\u00e9couverte du jardin botanique Jean Massart","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.542363"},"sp":{"name":"D\u00e9couverte du jardin botanique Jean Massart","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.542363"},"pt":{"name":"D\u00e9couverte du jardin botanique Jean Massart","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.542363"},"cn":{"name":"D\u00e9couverte du jardin botanique Jean Massart","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.542363"}},"place":{"id":106651,"translations":{"fr":{"name":"Jardin Jean Massart","address_street_name":"Chauss\u00e9e de Wavre","address_street_number":"1850","address_street_box":null,"email":"jardmass@ulb.be","website":"http:\/\/www.ulb.be\/actulb\/dds\/jmassart\/","phone_contact":"+32 2 650 91 65","phone_booking":null,"address_zip":"1160","address_city":"Auderghem","address_line1":"Chauss\u00e9e de Wavre, 1850","address_line2":"1160 Auderghem","description_web":"Du nom de son fondateur, le jardin botanique Jean Massart a \u00e9t\u00e9 cr\u00e9\u00e9 en 1922 par ce grand d\u00e9fenseur de la nature et professeur de botanique \u00e0 l\u2019Universit\u00e9 Libre de Bruxelles. Il est situ\u00e9 \u00e0 Auderghem, \u00e0 deux pas du Rouge-Clo\u00eetre, de la for\u00eat de Soignes et des parcs Seny, Ten Reuken et du Bergoje.\r\n\r\nCe Jardin botanique a \u00e9t\u00e9 dessin\u00e9 par l\u2019architecte paysagiste Jules Buyssens. Avec ses quelque 2000 esp\u00e8ces v\u00e9g\u00e9tales, il est l\u2019un des plus riches jardins botaniques de Belgique et un v\u00e9ritable mus\u00e9e vivant. Admirez-y les milliers de plantes indig\u00e8nes et exotiques dont les jardiniers, chercheurs et \u00e9tudiants prennent soin quotidiennement. Le jardin est en effet un laboratoire en plein air o\u00f9 est \u00e9tudi\u00e9e la fa\u00e7on dont les plantes peuvent rendre les villes plus saines et plus durables. Il est d\u2019ailleurs un mus\u00e9e de l\u2019Universit\u00e9 Libre de Bruxelles et fait partie du parcours des sciences, avec notamment le Mus\u00e9um de Zoologie.","description_print":"Cr\u00e9\u00e9 en 1922, le Jardin botanique Jean Massart est g\u00e9r\u00e9 par Bruxelles Environnement en collaboration avec l\u2019Universit\u00e9 Libre de Bruxelles.\r\nLe public peut y d\u00e9couvrir un v\u00e9ritable mus\u00e9e vivant de plein air comprenant plus  de 2000 esp\u00e8ces v\u00e9g\u00e9tales dont plusieurs centaines sont \u00e9tiquet\u00e9es.\r\nDestin\u00e9es \u00e0 la recherche, \u00e0 l\u2019enseignement universitaire et \u00e0 la vulgarisation,  les diverses collections qui le composent  se r\u00e9partissent sur 5 hectares en bordure de for\u00eat de Soignes.\r\n\r\nQue peut-on y voir ?\r\n\r\nDans la zone humide, \u00e9tang et marais abritent de nombreuses plantes typiques de notre r\u00e9gion.  \r\nUne collection impressionnante de plantes m\u00e9dicinales permet de rappeler l\u2019importance des plantes en th\u00e9rapeutique. Un verger regroupe d\u2019anciennes vari\u00e9t\u00e9s de pommiers et poiriers. L\u2019arboretum rassemble divers conif\u00e8res et d\u2019autres arbres non indig\u00e8nes.\r\nLes principales familles botaniques de plantes \u00e0 fleurs sont illustr\u00e9es dans le Jardin \u00e9volutif. Une collection de plantes cultiv\u00e9es rassemble plusieurs esp\u00e8ces domestiqu\u00e9es par l\u2019homme ainsi que leurs anc\u00eatres sauvages.\r\nEnfin, les plantes exotiques envahissantes et les plantes m\u00e9tallicoles, deux th\u00e9matiques \u00e9tudi\u00e9es au Laboratoire d\u2019Ecologie v\u00e9g\u00e9tale et Biog\u00e9ochimie, ont \u00e9galement leur parcelle de d\u00e9monstration.\r\n\r\nCe site particuli\u00e8rement riche et diversifi\u00e9 est class\u00e9 depuis 1997. \r\nIl est accessible gratuitement du lundi au vendredi de 9h00 \u00e0 17h00.\r\nDes visites guid\u00e9es sont propos\u00e9es tous les jeudis et 2\u00e8me samedi du mois (de mai \u00e0 fin octobre) ou sur rendez-vous pour les groupes (\u00e9coles, associations\u2026)\r\nhttp:\/\/www.ulb.ac.be\/musees\/jmassart \r\n","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Plantentuin Jean Massart","address_street_name":"Waversesteenweg","address_street_number":"1850","address_street_box":null,"email":"jardmass@ulb.be","website":"http:\/\/www.ulb.be\/actulb\/dds\/jmassart\/","phone_contact":"+32 2 650 91 65","phone_booking":null,"address_zip":"1160","address_city":"Oudergem","address_line1":"Waversesteenweg, 1850","address_line2":"1160 Oudergem","description_web":"Jean Massart was professor plantkunde aan de Universit\u00e9 Libre de Bruxelles. Hij was een fervent natuurliefhebber. In 1922 riep hij de tuin in Oudergem in het leven. De tuin ligt op een steenworp van het Roodklooster, het Zoni\u00ebnwoud en van het Seny-, het Tenreuken- en het Bergojepark.\r\n\r\nHet ontwerp komt van landschapsarchitect Jules Buyssens. Met ongeveer 2.000 plantensoorten is het een van de rijkste botanische tuinen van Belgi\u00eb. Hier waan je je in een levend museum. Elke dag worden de duizenden inheemse en exotische planten verzorgd door tuiniers, onderzoekers en studenten. De tuin is dan ook een openluchtlaboratorium. Hoe kunnen planten steden gezonder en duurzamer maken? Dat s de vraag waarover ze zich hier buigen. De tuin is ook een museum van de Universit\u00e9 Libre de Bruxelles en maakt deel uit van het wetenschapsparcours, samen met het Museum voor Dierkunde.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Jardin - Plantentuin Jean Massart","address_street_name":"Chauss\u00e9e de Wavre","address_street_number":"1850","address_street_box":null,"email":"jardmass@ulb.be","website":"http:\/\/www.ulb.be\/actulb\/dds\/jmassart\/","phone_contact":"+32 2 650 91 65","phone_booking":null,"address_zip":"1160","address_city":"Auderghem","address_line1":"Chauss\u00e9e de Wavre, 1850","address_line2":"1160 Auderghem","description_web":"Named after its founder, the Jean Massart Botanical Garden was created in 1922 by this great defender of nature and professor of botany at the ULB (Free University of Brussels). It's located in Auderghem, a stone's throw from Rouge-Clo\u00eetre, the Sonian Forest and the Seny, Ten Reuken and Bergoje parks.\r\n\r\nThis botanical garden was designed by landscape architect Jules Buyssens. With some 2,000 plant species, it's one of the richest botanical gardens in Belgium and a real living museum. Admire the thousands of native and exotic plants that the gardeners, researchers and students take care of every day. The garden is an open-air laboratory for studying how plants can make cities healthier and more sustainable. It's also a museum of ULB and is part of the science trail, together with the Museum of Zoology.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Botanischer Garten Jean Massart","address_street_name":"Chauss\u00e9e de Wavre","address_street_number":"1850","address_street_box":null,"email":"jardmass@ulb.be","website":"http:\/\/www.ulb.be\/actulb\/dds\/jmassart\/","phone_contact":"+32 2 650 91 65","phone_booking":null,"address_zip":"1160","address_city":"Auderghem","address_line1":"Chauss\u00e9e de Wavre, 1850","address_line2":"1160 Auderghem","description_web":"Der Botanische Garten Jean Massart wurde 1922 von dem gro\u00dfen Natursch\u00fctzer und Botanik-Professor an der Freien Universit\u00e4t Br\u00fcssel Jean Massart gegr\u00fcndet. Er befindet sich in Auderghem, ganz in der N\u00e4he der historischen Klosteranlage Rouge-Cl\u00f4itre, dem Soignes-Wald und den Parks Seny, Ten Reuken und Bergoje.\r\n\r\nAngelegt wurde der botanische Garten von dem Landschaftsarchitekten Jules Buyssens. Mit seinen rund 2000 Pflanzenarten z\u00e4hlt er zu den artenreichsten botanischen G\u00e4rten Belgiens. Bewundern k\u00f6nnen Sie sowohl einheimische als auch exotische Pflanzen, die hier von G\u00e4rtnern, Forschern und Studenten gehegt und gepflegt werden, denn der Garten dient als eine Art Freiluftlabor, in dem die positiven Effekte von Pflanzen in der Stadt erforscht wird. Zudem dient er als Museum der Freien Universit\u00e4t Br\u00fcssel und ist Teil des Wissenschaftsparcours, zu dem auch das Zoologische Museum geh\u00f6rt.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Jardin botanique Jean Massart (ULB)","address_street_name":"Chauss\u00e9e de Wavre","address_street_number":"1850","address_street_box":null,"email":"jardmass@ulb.be","website":"http:\/\/www.ulb.be\/actulb\/dds\/jmassart\/","phone_contact":"+32 2 650 91 65","phone_booking":null,"address_zip":"1160","address_city":"Auderghem","address_line1":"Chauss\u00e9e de Wavre, 1850","address_line2":"1160 Auderghem","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Jard\u00edn bot\u00e1nico Jean Massart (ULB)","address_street_name":"Chauss\u00e9e de Wavre","address_street_number":"1850","address_street_box":null,"email":"jardmass@ulb.be","website":"http:\/\/www.ulb.be\/actulb\/dds\/jmassart\/","phone_contact":"+32 2 650 91 65","phone_booking":null,"address_zip":"1160","address_city":"Auderghem","address_line1":"Chauss\u00e9e de Wavre, 1850","address_line2":"1160 Auderghem","description_web":"Las ex\u00f3ticas colecciones vivientes del jard\u00edn bot\u00e1nico, creado en 1922 por Jean Massart, fueron creadas para la investigaci\u00f3n, la ense\u00f1anza universitaria y la promoci\u00f3n cient\u00edfica.\r\nPosee casi 2000 especies vegetales localizadas en 5 hect\u00e1reas y divididas en diferentes jardines: el jard\u00edn medicinal y plantas arom\u00e1ticas, el jard\u00edn bot\u00e1nico experimental, el jard\u00edn de plantas cultivadas, un huerto, un invernadero y un \u00e1rea experimental. Tambi\u00e9n puedes encontrar dos colecciones asociadas a dos estudios llevados a cabo por la ULB: vegetaci\u00f3n metalofita y plantas invasivas.\r\nTambi\u00e9n hay una \u00e1rea h\u00fameda establecida como reserva natural e inclu\u00edda en la Red Natura 2000.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Jardin botanique Jean Massart","address_street_name":"Chauss\u00e9e de Wavre","address_street_number":"1850","address_street_box":null,"email":"jardmass@ulb.be","website":"http:\/\/www.ulb.be\/actulb\/dds\/jmassart\/","phone_contact":"+32 2 650 91 65","phone_booking":null,"address_zip":"1160","address_city":"Auderghem","address_line1":"Chauss\u00e9e de Wavre, 1850","address_line2":"1160 Auderghem","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Jardin botanique Jean Massart","address_street_name":"Chauss\u00e9e de Wavre","address_street_number":"1850","address_street_box":null,"email":"jardmass@ulb.be","website":"http:\/\/www.ulb.be\/actulb\/dds\/jmassart\/","phone_contact":"+32 2 650 91 65","phone_booking":null,"address_zip":"1160","address_city":"Auderghem","address_line1":"Chauss\u00e9e de Wavre, 1850","address_line2":"1160 Auderghem","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":[],"zones":{"list":[21],"translations":{"fr":["Sud"],"nl":["Zuid"],"en":["South"]}},"neca":null,"facebook_id":null,"backoffice_id":369,"location":{"lat":50.81302327,"lon":4.43829386},"region":"brussels","last_updated_at":"2022-10-11T06:06:26+02:00","published_at":"2013-10-19T01:13:28+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":106651,"translations":{"fr":{"name":"Jardin Jean Massart","address_street_name":"Chauss\u00e9e de Wavre","address_street_number":"1850","address_street_box":null,"email":"jardmass@ulb.be","website":"http:\/\/www.ulb.be\/actulb\/dds\/jmassart\/","phone_contact":"+32 2 650 91 65","phone_booking":null,"address_zip":"1160","address_city":"Auderghem","address_line1":"Chauss\u00e9e de Wavre, 1850","address_line2":"1160 Auderghem","description_web":"Du nom de son fondateur, le jardin botanique Jean Massart a \u00e9t\u00e9 cr\u00e9\u00e9 en 1922 par ce grand d\u00e9fenseur de la nature et professeur de botanique \u00e0 l\u2019Universit\u00e9 Libre de Bruxelles. Il est situ\u00e9 \u00e0 Auderghem, \u00e0 deux pas du Rouge-Clo\u00eetre, de la for\u00eat de Soignes et des parcs Seny, Ten Reuken et du Bergoje.\r\n\r\nCe Jardin botanique a \u00e9t\u00e9 dessin\u00e9 par l\u2019architecte paysagiste Jules Buyssens. Avec ses quelque 2000 esp\u00e8ces v\u00e9g\u00e9tales, il est l\u2019un des plus riches jardins botaniques de Belgique et un v\u00e9ritable mus\u00e9e vivant. Admirez-y les milliers de plantes indig\u00e8nes et exotiques dont les jardiniers, chercheurs et \u00e9tudiants prennent soin quotidiennement. Le jardin est en effet un laboratoire en plein air o\u00f9 est \u00e9tudi\u00e9e la fa\u00e7on dont les plantes peuvent rendre les villes plus saines et plus durables. Il est d\u2019ailleurs un mus\u00e9e de l\u2019Universit\u00e9 Libre de Bruxelles et fait partie du parcours des sciences, avec notamment le Mus\u00e9um de Zoologie.","description_print":"Cr\u00e9\u00e9 en 1922, le Jardin botanique Jean Massart est g\u00e9r\u00e9 par Bruxelles Environnement en collaboration avec l\u2019Universit\u00e9 Libre de Bruxelles.\r\nLe public peut y d\u00e9couvrir un v\u00e9ritable mus\u00e9e vivant de plein air comprenant plus  de 2000 esp\u00e8ces v\u00e9g\u00e9tales dont plusieurs centaines sont \u00e9tiquet\u00e9es.\r\nDestin\u00e9es \u00e0 la recherche, \u00e0 l\u2019enseignement universitaire et \u00e0 la vulgarisation,  les diverses collections qui le composent  se r\u00e9partissent sur 5 hectares en bordure de for\u00eat de Soignes.\r\n\r\nQue peut-on y voir ?\r\n\r\nDans la zone humide, \u00e9tang et marais abritent de nombreuses plantes typiques de notre r\u00e9gion.  \r\nUne collection impressionnante de plantes m\u00e9dicinales permet de rappeler l\u2019importance des plantes en th\u00e9rapeutique. Un verger regroupe d\u2019anciennes vari\u00e9t\u00e9s de pommiers et poiriers. L\u2019arboretum rassemble divers conif\u00e8res et d\u2019autres arbres non indig\u00e8nes.\r\nLes principales familles botaniques de plantes \u00e0 fleurs sont illustr\u00e9es dans le Jardin \u00e9volutif. Une collection de plantes cultiv\u00e9es rassemble plusieurs esp\u00e8ces domestiqu\u00e9es par l\u2019homme ainsi que leurs anc\u00eatres sauvages.\r\nEnfin, les plantes exotiques envahissantes et les plantes m\u00e9tallicoles, deux th\u00e9matiques \u00e9tudi\u00e9es au Laboratoire d\u2019Ecologie v\u00e9g\u00e9tale et Biog\u00e9ochimie, ont \u00e9galement leur parcelle de d\u00e9monstration.\r\n\r\nCe site particuli\u00e8rement riche et diversifi\u00e9 est class\u00e9 depuis 1997. \r\nIl est accessible gratuitement du lundi au vendredi de 9h00 \u00e0 17h00.\r\nDes visites guid\u00e9es sont propos\u00e9es tous les jeudis et 2\u00e8me samedi du mois (de mai \u00e0 fin octobre) ou sur rendez-vous pour les groupes (\u00e9coles, associations\u2026)\r\nhttp:\/\/www.ulb.ac.be\/musees\/jmassart \r\n","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Plantentuin Jean Massart","address_street_name":"Waversesteenweg","address_street_number":"1850","address_street_box":null,"email":"jardmass@ulb.be","website":"http:\/\/www.ulb.be\/actulb\/dds\/jmassart\/","phone_contact":"+32 2 650 91 65","phone_booking":null,"address_zip":"1160","address_city":"Oudergem","address_line1":"Waversesteenweg, 1850","address_line2":"1160 Oudergem","description_web":"Jean Massart was professor plantkunde aan de Universit\u00e9 Libre de Bruxelles. Hij was een fervent natuurliefhebber. In 1922 riep hij de tuin in Oudergem in het leven. De tuin ligt op een steenworp van het Roodklooster, het Zoni\u00ebnwoud en van het Seny-, het Tenreuken- en het Bergojepark.\r\n\r\nHet ontwerp komt van landschapsarchitect Jules Buyssens. Met ongeveer 2.000 plantensoorten is het een van de rijkste botanische tuinen van Belgi\u00eb. Hier waan je je in een levend museum. Elke dag worden de duizenden inheemse en exotische planten verzorgd door tuiniers, onderzoekers en studenten. De tuin is dan ook een openluchtlaboratorium. Hoe kunnen planten steden gezonder en duurzamer maken? Dat s de vraag waarover ze zich hier buigen. De tuin is ook een museum van de Universit\u00e9 Libre de Bruxelles en maakt deel uit van het wetenschapsparcours, samen met het Museum voor Dierkunde.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Jardin - Plantentuin Jean Massart","address_street_name":"Chauss\u00e9e de Wavre","address_street_number":"1850","address_street_box":null,"email":"jardmass@ulb.be","website":"http:\/\/www.ulb.be\/actulb\/dds\/jmassart\/","phone_contact":"+32 2 650 91 65","phone_booking":null,"address_zip":"1160","address_city":"Auderghem","address_line1":"Chauss\u00e9e de Wavre, 1850","address_line2":"1160 Auderghem","description_web":"Named after its founder, the Jean Massart Botanical Garden was created in 1922 by this great defender of nature and professor of botany at the ULB (Free University of Brussels). It's located in Auderghem, a stone's throw from Rouge-Clo\u00eetre, the Sonian Forest and the Seny, Ten Reuken and Bergoje parks.\r\n\r\nThis botanical garden was designed by landscape architect Jules Buyssens. With some 2,000 plant species, it's one of the richest botanical gardens in Belgium and a real living museum. Admire the thousands of native and exotic plants that the gardeners, researchers and students take care of every day. The garden is an open-air laboratory for studying how plants can make cities healthier and more sustainable. It's also a museum of ULB and is part of the science trail, together with the Museum of Zoology.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Botanischer Garten Jean Massart","address_street_name":"Chauss\u00e9e de Wavre","address_street_number":"1850","address_street_box":null,"email":"jardmass@ulb.be","website":"http:\/\/www.ulb.be\/actulb\/dds\/jmassart\/","phone_contact":"+32 2 650 91 65","phone_booking":null,"address_zip":"1160","address_city":"Auderghem","address_line1":"Chauss\u00e9e de Wavre, 1850","address_line2":"1160 Auderghem","description_web":"Der Botanische Garten Jean Massart wurde 1922 von dem gro\u00dfen Natursch\u00fctzer und Botanik-Professor an der Freien Universit\u00e4t Br\u00fcssel Jean Massart gegr\u00fcndet. Er befindet sich in Auderghem, ganz in der N\u00e4he der historischen Klosteranlage Rouge-Cl\u00f4itre, dem Soignes-Wald und den Parks Seny, Ten Reuken und Bergoje.\r\n\r\nAngelegt wurde der botanische Garten von dem Landschaftsarchitekten Jules Buyssens. Mit seinen rund 2000 Pflanzenarten z\u00e4hlt er zu den artenreichsten botanischen G\u00e4rten Belgiens. Bewundern k\u00f6nnen Sie sowohl einheimische als auch exotische Pflanzen, die hier von G\u00e4rtnern, Forschern und Studenten gehegt und gepflegt werden, denn der Garten dient als eine Art Freiluftlabor, in dem die positiven Effekte von Pflanzen in der Stadt erforscht wird. Zudem dient er als Museum der Freien Universit\u00e4t Br\u00fcssel und ist Teil des Wissenschaftsparcours, zu dem auch das Zoologische Museum geh\u00f6rt.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Jardin botanique Jean Massart (ULB)","address_street_name":"Chauss\u00e9e de Wavre","address_street_number":"1850","address_street_box":null,"email":"jardmass@ulb.be","website":"http:\/\/www.ulb.be\/actulb\/dds\/jmassart\/","phone_contact":"+32 2 650 91 65","phone_booking":null,"address_zip":"1160","address_city":"Auderghem","address_line1":"Chauss\u00e9e de Wavre, 1850","address_line2":"1160 Auderghem","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Jard\u00edn bot\u00e1nico Jean Massart (ULB)","address_street_name":"Chauss\u00e9e de Wavre","address_street_number":"1850","address_street_box":null,"email":"jardmass@ulb.be","website":"http:\/\/www.ulb.be\/actulb\/dds\/jmassart\/","phone_contact":"+32 2 650 91 65","phone_booking":null,"address_zip":"1160","address_city":"Auderghem","address_line1":"Chauss\u00e9e de Wavre, 1850","address_line2":"1160 Auderghem","description_web":"Las ex\u00f3ticas colecciones vivientes del jard\u00edn bot\u00e1nico, creado en 1922 por Jean Massart, fueron creadas para la investigaci\u00f3n, la ense\u00f1anza universitaria y la promoci\u00f3n cient\u00edfica.\r\nPosee casi 2000 especies vegetales localizadas en 5 hect\u00e1reas y divididas en diferentes jardines: el jard\u00edn medicinal y plantas arom\u00e1ticas, el jard\u00edn bot\u00e1nico experimental, el jard\u00edn de plantas cultivadas, un huerto, un invernadero y un \u00e1rea experimental. Tambi\u00e9n puedes encontrar dos colecciones asociadas a dos estudios llevados a cabo por la ULB: vegetaci\u00f3n metalofita y plantas invasivas.\r\nTambi\u00e9n hay una \u00e1rea h\u00fameda establecida como reserva natural e inclu\u00edda en la Red Natura 2000.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Jardin botanique Jean Massart","address_street_name":"Chauss\u00e9e de Wavre","address_street_number":"1850","address_street_box":null,"email":"jardmass@ulb.be","website":"http:\/\/www.ulb.be\/actulb\/dds\/jmassart\/","phone_contact":"+32 2 650 91 65","phone_booking":null,"address_zip":"1160","address_city":"Auderghem","address_line1":"Chauss\u00e9e de Wavre, 1850","address_line2":"1160 Auderghem","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Jardin botanique Jean Massart","address_street_name":"Chauss\u00e9e de Wavre","address_street_number":"1850","address_street_box":null,"email":"jardmass@ulb.be","website":"http:\/\/www.ulb.be\/actulb\/dds\/jmassart\/","phone_contact":"+32 2 650 91 65","phone_booking":null,"address_zip":"1160","address_city":"Auderghem","address_line1":"Chauss\u00e9e de Wavre, 1850","address_line2":"1160 Auderghem","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":null,"facebook_id":null,"backoffice_id":369,"location":{"lat":50.81302327,"lon":4.43829386},"region":"brussels","last_updated_at":"2022-10-11T06:06:26+02:00","published_at":"2013-10-19T01:13:28+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"media":[{"type":"poster","link":"https:\/\/agendabrussels.imgix.net\/d365909ad4974b8612af3c0c644ed766284985dc.jpg","width":700,"height":525,"ratio":1.33,"translations":{"fr":{"title":"D\u00e9couverte du jardin botanique Jean Massart","copyright":null},"nl":{"title":"D\u00e9couverte du jardin botanique Jean Massart","copyright":null},"en":{"title":"D\u00e9couverte du jardin botanique Jean Massart","copyright":null}}}],"dates":[{"day":"2022-10-16","doors":null,"start":"14:00:00","end":"16:00:00","is_soldout":false,"is_canceled":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[10,11],"translations":{"fr":["Seniors","Famille"],"nl":["Senioren","Familie"],"en":["Seniors","Family"]}},"visit_profile":{"list":[328],"translations":{"fr":["Vert & durable"],"nl":["Groen & duurzaam"],"en":["Green & sustainable"],"de":["Gr\u00fcn & nachhaltig"]}},"tags":["exterior","kids"],"accessibilities":{"list":[255,263],"translations":{"fr":["Accessible","Accessible aux pi\u00e9tons appareill\u00e9s"],"nl":["Toegankelijk","Toegankelijk voor voetgangers met hulpmiddelen"],"en":["Accessible","Accessible to pedestrians with mobility aids"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-11T06:06:26+02:00","published_at":"2022-09-21T11:29:59+02:00","backoffice_id":262363,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":1.2599210498949},{"id":543690,"date_start":"2022-10-16","date_end":"2022-10-16","date_next":"2022-10-16","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen"}},"others":{"list":[109],"translations":{"fr":["Espaces verts"],"nl":["Groene zones"],"en":["Green spaces"],"de":["Gr\u00fcnfl\u00e4chen"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"For\u00eat de Soignes: du parc Tournay-Solvay \u00e0 l\u2019ancien Hippodrome de Boitsfort","shortdescr":"Dans le cadre de la Journ\u00e9e de la For\u00eat, d\u00e9part depuis l'entr\u00e9e du parc c\u00f4t\u00e9 gare de Boitsfort.","longdescr":"Dans le cadre de la Journ\u00e9e de la For\u00eat de Soignes, d\u00e9part depuis l'entr\u00e9e du parc c\u00f4t\u00e9 gare de Boitsfort.\r\n\r\nParcours de 3 km en transition foresti\u00e8re entre deux sites am\u00e9nag\u00e9s l\u2019un pour le loisir et l\u2019autre pour la qui\u00e9tude dans une perspective paysag\u00e8re. Deux sites en lisi\u00e8re de for\u00eat aux destin\u00e9es diff\u00e9rentes qui pr\u00e9sentent de multiples facettes attrayantes. Nous passerons par un vallon humide qui a lui aussi de l\u2019int\u00e9r\u00eat.\r\n\r\nR\u00e9servations obligatoires","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.543690"},"nl":{"name":"For\u00eat de Soignes: du parc Tournay-Solvay \u00e0 l\u2019ancien Hippodrome de Boitsfort","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/tournesol-zonnebloem.be\/activites_gp\/ateliers-cours-visites\/visites-guidees-familiales\/","email":"info@tournesol-zonnebloem.be","phone_contact":"+32 2 675 37 30","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.543690"},"en":{"name":"For\u00eat de Soignes: du parc Tournay-Solvay \u00e0 l\u2019ancien Hippodrome de Boitsfort","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.543690"},"de":{"name":"For\u00eat de Soignes: du parc Tournay-Solvay \u00e0 l\u2019ancien Hippodrome de Boitsfort","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.543690"},"it":{"name":"For\u00eat de Soignes: du parc Tournay-Solvay \u00e0 l\u2019ancien Hippodrome de Boitsfort","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.543690"},"sp":{"name":"For\u00eat de Soignes: du parc Tournay-Solvay \u00e0 l\u2019ancien Hippodrome de Boitsfort","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.543690"},"pt":{"name":"For\u00eat de Soignes: du parc Tournay-Solvay \u00e0 l\u2019ancien Hippodrome de Boitsfort","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.543690"},"cn":{"name":"For\u00eat de Soignes: du parc Tournay-Solvay \u00e0 l\u2019ancien Hippodrome de Boitsfort","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.543690"}},"place":{"id":248018,"translations":{"fr":{"name":"Parc Tournay-Solvay","address_street_name":"Chauss\u00e9e de la Hultpe","address_street_number":"199","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1170","address_city":"Watermael-Boitsfort","address_line1":"Chauss\u00e9e de la Hultpe, 199","address_line2":"1170 Watermael-Boitsfort","description_web":"Du nom de Th\u00e9r\u00e8se Tournay-Solvay, fille d\u2019Alfred Solvay et veuve d\u2019\u00c9mile Tournay, ce parc, situ\u00e9 \u00e0 Watermael-Boitsfort, est l\u2019un des plus beaux de Bruxelles. Retrouvez des espaces vari\u00e9s et des d\u00e9nivel\u00e9s, deux \u00e9tangs dans la vall\u00e9e, une for\u00eat naturelle sur les pentes et un jardin \u00e0 l\u2019anglaise au sommet.\r\n\r\nC\u00f4t\u00e9 patrimoine, d\u00e9couvrez les ruines du ch\u00e2teau Solvay, d\u00e9truit lors d\u2019un incendie en 1982, d\u00e9sormais colonis\u00e9es par la v\u00e9g\u00e9tation. De style n\u00e9o-Renaissance flamand, il fut la propri\u00e9t\u00e9 d\u2019Alfred Solvay, le fr\u00e8re du c\u00e9l\u00e8bre industriel Ernest Solvay, et de sa famille. Les \u00e9curies du ch\u00e2teau sont occup\u00e9es par un centre d\u2019\u00e9ducation \u00e0 l\u2019environnement et \u00e0 l\u2019\u00e9cologie. Admirez la roseraie con\u00e7ue par Jules Buyssens et des sculptures, dont la r\u00e9plique de la T\u00eate olm\u00e8que n\u00b08, \u0153uvre de Ignacio P\u00e9rez Solorzano d\u00e9couverte au Mexique dans le village de San Lorenzo.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Tournay-Solvaypark","address_street_name":"Hulpensesteenweg","address_street_number":"199","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1170","address_city":"Watermaal-Bosvoorde","address_line1":"Hulpensesteenweg, 199","address_line2":"1170 Watermaal-Bosvoorde","description_web":"Dit park is genoemd naar Th\u00e9r\u00e8se Tournay-Solvay, een dochter van Alfred Solvay en weduwe van \u00c9mile Tournay. Het ligt in de gemeente Watermaal-Bosvoorde. Ga er zeker eens naartoe want het is een van de mooiste parken van Brussel. Heel opvallend is de verscheidenheid die je er aantreft. Er zijn verschillende hellingen, twee vijvers, een natuurlijk bos en ook nog eens een Engelse tuin.\r\n\r\nJe stoot er ook op de ru\u00efnes van het kasteel van Solvay. In 1982 werd het kasteel verwoest door een brand. Het is gebouwd in Vlaamse neorenaissancestijl en was eigendom van Alfred Solvay, de broer van de beroemde industrieel Ernest Solvay en zijn familie. In de stallen van het kasteel is nu een centrum voor milieu-educatie gevestigd. Wandel zeker eens door de rozentuin ontworpen door Jules Buyssens. Je vindt er heel wat beeldhouwwerken, waaronder de replica van het Olmechoofd n\u00b08, een werk van Ignacio P\u00e9rez Solorzano ontdekt in het Mexicaanse dorp San Lorenzo.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Tournay-Solvay Park","address_street_name":"Chauss\u00e9e de la Hultpe","address_street_number":"199","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1170","address_city":"Watermael-Boitsfort","address_line1":"Chauss\u00e9e de la Hultpe, 199","address_line2":"1170 Watermael-Boitsfort","description_web":"Named after Th\u00e9r\u00e8se Tournay-Solvay, daughter of Alfred Solvay and widow of \u00c9mile Tournay, this park, located in Watermael-Boitsfort, is one of the most beautiful in Brussels. There are a variety of spaces and slopes, two ponds in its valley, a natural forest on its slopes and an English garden at the top.\r\n\r\nAs for heritage, discover the ruins of Solvay castle, which was destroyed in a fire in 1982 and has now been overrun by vegetation. Built in the Flemish neo-Renaissance style, it was the property of Alfred Solvay, brother of the famous industrialist Ernest Solvay, and his family. The castle's stables are now occupied by a centre for environmental and ecological education. Admire the rose garden designed by Jules Buyssens and the sculptures, including the replica of the Olmec Head no 8, a work by Ignacio P\u00e9rez Solorzano which was discovered in the Mexican village of San Lorenzo.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Parc Tournay-Solvay","address_street_name":"Chauss\u00e9e de la Hultpe","address_street_number":"199","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1170","address_city":"Watermael-Boitsfort","address_line1":"Chauss\u00e9e de la Hultpe, 199","address_line2":"1170 Watermael-Boitsfort","description_web":"Dieser Park in Watermael-Boitsfort gilt als eine der sch\u00f6nsten Br\u00fcsseler Gr\u00fcnfl\u00e4chen. Benannt wurde er nach Th\u00e9r\u00e8se Tournay-Solvay, der Tochter von Alfred Solvay und Witwe von \u00c9mile Tournay. Der Park ist gepr\u00e4gt von abwechslungsreichen Fl\u00e4chen und H\u00f6henunterschieden, zwei Teichen im Tal, einem nat\u00fcrlichen Baumbestand an den H\u00e4ngen und einem Garten im englischen Stil auf der Anh\u00f6he.\r\n\r\nZu entdecken gibt es die Ruinen des Schlosses Solvay, das 1982 bei einem Brand zerst\u00f6rt wurde und nun allm\u00e4hlich \u00fcberwachsen wird. Das im fl\u00e4mischen Neorenaissance-Stil erbaute Schloss befand sich einst im Besitz von Alfred Solvay, dem Bruder des ber\u00fchmten Industriellen Ernest Solvay, und seiner Familie. In den Stallungen des Schlosses befindet sich ein Zentrum f\u00fcr Umweltbildung und \u00d6kologie. Bewundern Sie den von Jules Buyssens entworfenen Rosengarten und die verschiedenen Skulpturen, darunter die Nachbildung des Olmekenkopfes Nr. 8 - ein Werk von Ignacio P\u00e9rez Solorzano, das in Mexiko im Dorf San Lorenzo entdeckt wurde.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Parc Tournay-Solvay","address_street_name":"Chauss\u00e9e de la Hultpe","address_street_number":"199","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1170","address_city":"Watermael-Boitsfort","address_line1":"Chauss\u00e9e de la Hultpe, 199","address_line2":"1170 Watermael-Boitsfort","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Parc Tournay-Solvay","address_street_name":"Chauss\u00e9e de la Hultpe","address_street_number":"199","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":