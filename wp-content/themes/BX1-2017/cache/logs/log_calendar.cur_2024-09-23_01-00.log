ustation comment\u00e9e de quatre bi\u00e8res phares de la brasserie.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Brasserie de La Senne","address_street_name":" dr\u00e8ve Anna Boch ","address_street_number":"19-21","address_street_box":null,"email":"info@brasseriedelasenne.be","website":"https:\/\/www.brasseriedelasenne.be\/","phone_contact":"+32 2 465 07 51","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":" dr\u00e8ve Anna Boch , 19-21","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Brasserie de La Senne","address_street_name":" dr\u00e8ve Anna Boch ","address_street_number":"19-21","address_street_box":null,"email":"info@brasseriedelasenne.be","website":"https:\/\/www.brasseriedelasenne.be\/","phone_contact":"+32 2 465 07 51","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":" dr\u00e8ve Anna Boch , 19-21","address_line2":"1000 Brussel","description_web":"De Brasserie de la Senne, die aan de wieg staat van de heropleving van het ambachtelijke bier in Brussel, heeft zich ingespannen om goed gehopte bieren weer in de mode te brengen. Het gamma omvat ook bieren van gemengde gisting die in eiken vaten worden gebotteld en bieren die hergisten met lokale Brettanomyces-gisten.\r\nDe brouwerij van Senne biedt rondleidingen aan om de ambachtelijke brouwproductie beter te begrijpen. Het bezoek eindigt met een becommentarieerde degustatie van vier paradepaardjes van de brouwerij.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[8],"translations":{"de":["Kanal-Viertel"],"pt":[null],"en":["Canal"],"it":["Canal"],"cn":[null],"fr":["Canal"],"sp":["Canal"],"nl":["Kanaalwijk"]}},"zones":{"list":[20],"translations":{"de":["Norden"],"pt":[null