itors\/agenda\/event-detail.50007200"},"fr":{"name":"Visite guid\u00e9e graffiti - Autour du train","shortdescr":"Le graffiti le long des voies ferr\u00e9es et sur les trains est une pratique tr\u00e8s r\u00e9pandue en Belgique.\nCette balade est une plong\u00e9e dans cet univers sp\u00e9cifique du graffiti.","longdescr":"Fais le Trottoir propose diff\u00e9rents types de visites guid\u00e9es anim\u00e9es par deux personnes dont un artiste. Lors de ces ballades, nous d\u00e9codons les signatures, expliquons l'historique et les techniques de travail et les m\u00e9canismes propres \u00e0 ce mouvement.","performers":"Fais le trottoir ASBL","boxoffice_url":null,"website":"http:\/\/www.faisletrottoir.com","email":"visitegraffiti@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50007200"},"sp":{"name":"Visite guid\u00e9e graffiti - Autour du train","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.faisletrottoir.com","email":"visitegraffiti@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50007200"},"nl":{"name":"Visite guid\u00e9e graffiti - Autour du train","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.faisletrottoir.com","email":"visitegraffiti@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50007200"}},"place":{"id":265511,"translations":{"de":{"name":"Fais le trottoir","address_street_name":"Avenue Jean Volders","address_street_number":null,"address_street_box":null,"email":"visitegraffiti@gmail.com","website":"http:\/\/www.faisletrottoir.com","phone_contact":"+32 488 98 70 33","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Avenue Jean Volders","address_line2":"1060 Saint-Gilles","description_we