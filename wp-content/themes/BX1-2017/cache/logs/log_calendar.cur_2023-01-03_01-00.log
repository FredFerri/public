_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.548141"},"en":{"name":"Dinos Alive! Immersive Experience","shortdescr":"Don't miss it ! over 80 life-sized animated dinosaurs\r\nSee what it\u2019s like to stand in the shadows of the largest creatures to have walked the earth!","longdescr":"At Dinos Alive, you\u2019ll meet over 80 life-sized specimens from both famous and lesser-known species such as the T-Rex, Stegosaurus, Velociraptor, and Suchomimus.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.548141"},"de":{"name":"Dinos Alive! Immersive Experience","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.548141"},"it":{"name":"Dinos Alive! Immersive Experience","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.548141"},"sp":{"name":"Dinos Alive! Immersive Experience","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.548141"},"pt":{"name":"Dinos Alive! Immersive Experience","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.548141"},"cn":{"name":"Dinos Alive! Immersive Experience","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":n