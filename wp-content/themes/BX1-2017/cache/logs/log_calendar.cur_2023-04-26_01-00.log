_at":"2023-04-08T00:05:25+02:00","published_at":"2023-01-27T09:19:49+01:00","backoffice_id":270450,"import_origin":null,"sub_type":"concert","show_in_agenda":true,"ranking":1.2599210498949},{"id":555183,"date_start":"2023-04-29","date_end":"2023-04-29","date_next":"2023-04-29","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen","it":"Visite guidate","sp":"Visitas guiadas","pt":null,"cn":null}},"others":{"list":[251],"translations":{"fr":["Art Contemporain "],"nl":["Hedendaagse Kunst"],"en":["Contemporary Art"],"de":["Zeitgen\u00f6ssische Kunst "],"it":["Arte contemporanea "],"sp":["Arte contempor\u00e1neo "],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Un caf\u00e9 face aux oeuvres : Et si ce paysage \u00e9tait un jardin immense ?","shortdescr":"La Fondation Thalie propose un cycle in\u00e9dit de r\u00e9cits crois\u00e9s autour des \u0153uvres de la collection. Le temps d\u2019une matin\u00e9e, Un caf\u00e9 face aux \u0153uvres vous invite, par un accrochage exclusif, \u00e0 c\u00f4toyer la petite et la grande histoire de l\u2019art, \u00e0 d\u00e9couvrir les secrets de pratiques artistiques singuli\u00e8res ou m\u00e9connues.","longdescr":"La Fondation Thalie propose un cycle in\u00e9dit de r\u00e9cits crois\u00e9s autour des \u0153uvres de la collection. Le temps d\u2019une matin\u00e9e, Un caf\u00e9 face aux \u0153uvres vous invite, par un accrochage exclusif, \u00e0 c\u00f4toyer la petite et la grande histoire de l\u2019art, \u00e0 d\u00e9couvrir les secrets de pratiques artistiques singuli\u00e8res ou m\u00e9connues. Une exp\u00e9rience du sensible propre \u00e0 r\u00e9v\u00e9ler les jeux et les relations invisibles qu\u2019entretiennent les oeuvres entre elles et laisser libre court \u00e0 l\u2019interpr\u00e9tation de chacun.e,  passionn\u00e9.es d\u2019art.\r\n\r\nCette troisi\u00e8me rencontre explorera le th\u00e8me du paysage, si central dans la pratique d\u2019Eva Jospin. Le paysage n\u2019est pas synonyme de nature mais d\u00e9signe plut\u00f4t la nature investie par l\u2019homme. Et si, d\u00e8s lors, le paysage \u00e9tait un jardin immense ? Plusieurs artistes de la collection se sont pench\u00e9s sur ces th\u00e8mes.\r\n\r\n \r\n\r\n    Nicolas Floc\u2019h (France, 1970) d\u00e9veloppe, depuis une dizaine d\u2019ann\u00e9es, une production photographique li\u00e9e aux changements globaux et \u00e0 la d\u00e9finition de paysage sous-marin.\r\n    Elise Peroi (France, 1990), par le tissage et la performance, cr\u00e9e des jardins sculpturaux questionnant notre relation \u00e0 la nature.\r\n    Desire Moheb-Zandi (Allemagne, 1990) tisse des paysages stylis\u00e9s \u00e0 partir de mat\u00e9riaux trouv\u00e9s. Les rendus si color\u00e9s s\u2019accomplissent dans son invitation \u00e0 toucher d\u00e9licatement ses \u0153uvres.\r\n\r\n    Une lecture transversale abordera la question du paysage, du jardin, et leur lien avec les arts textiles. Saviez-vous que les tapis persans, remplis de motifs v\u00e9g\u00e9taux, sont en r\u00e9alit\u00e9s des jardins d\u2019hiver faits pour que l\u2019on puisse, qu\u2019importe le temps, habiter le paysage ? Michel Foucault envisage d\u2019ailleurs les tapis persans comme des \u00ab h\u00e9t\u00e9rotopies \u00bb, des lieux utopiques localis\u00e9s. Avez-vous par ailleurs entendu parler de ces nomades aborig\u00e8nes qui cr\u00e9ent le paysage en chantant et pour qui, d\u00e8s lors, rien n\u2019est plus grave que de chanter faux ? Par la lecture de Tim Ingold, nous chercherons enfin un lien entre la marche et le tissage.\r\n\r\nObjectifs :\r\n\r\n    (Re)d\u00e9couvrir des artistes, issus de la collection de la fondation. Tant de beaut\u00e9, de voyages potentiels ne demandent qu\u2019\u00e0 \u00eatre d\u00e9couverts.\r\n    Prendre part \u00e0 une m\u00e9diation orient\u00e9e sur l\u2019\u00e9change, le dialogue.\r\n    S\u2019approprier des th\u00e8mes centraux dans le travail d\u2019Eva Jospin en les confrontant \u00e0 d\u2019autres cultures, \u00e0 d\u2019autres concepts.\r\n\r\n \r\n\r\nTarif r\u00e9duit pour les \u00e9tudiants, enseignants, -26 ans, demandeurs d\u2019emploi et membres SMART","performers":"Val\u00e8re Gilles (charg\u00e9 de m\u00e9diation)","boxoffice_url":null,"website":"http:\/\/www.fondationthalie.org","email":"info@fondationthalie.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.555183"},"nl":{"name":"Un caf\u00e9 face aux oeuvres : Et si ce paysage \u00e9tait un jardin immense ?","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.fondationthalie.org","email":"info@fondationthalie.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.555183"},"en":{"name":"Un caf\u00e9 face aux oeuvres : Et si ce paysage \u00e9tait un jardin immense ?","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.fondationthalie.org","email":"info@fondationthalie.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.555183"},"de":{"name":"Un caf\u00e9 face aux oeuvres : Et si ce paysage \u00e9tait un jardin immense ?","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.fondationthalie.org","email":"info@fondationthalie.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.555183"},"it":{"name":"Un caf\u00e9 face 