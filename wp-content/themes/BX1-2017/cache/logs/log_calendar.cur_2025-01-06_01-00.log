.brussels\/pt\/visitors\/agenda\/event-detail.5700000411"},"en":{"name":"La reine Rouge","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700000411"},"it":{"name":"La reine Rouge","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700000411"},"cn":{"name":"La reine Rouge","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700000411"},"fr":{"name":"La reine Rouge","shortdescr":null,"longdescr":"De Val\u00e9riane DE MAERTELEIRE\n\nApr\u00e8s Coiffeuse d\u2019\u00e2mes, l\u2019autrice belge nous propose une magnifique com\u00e9die autour de notre reine \u00c9lisabeth qui, en 1958, en pleine guerre froide, accepte une invitation \u00e0 se rendre \u00e0 Moscou. Panique au palais et au sein du gouvernement. M\u00eame le jeune Roi Baudouin est mis \u00e0 contribution pour tenter de dissuader la Reine m\u00e8re de partir au pays des Soviets ! C\u2019est Jo Deseure qui incarnera cette reine \u00e0 la personnalit\u00e9 forte qui s\u2019amuse \u00e0 bousculer les conventions et les id\u00e9es re\u00e7ues. Jubilatoire !","performers":"Avec Lola Delcorps, Jo Deseure, Bruno Georis, R\u00e9my Thiebaut, Benoit Van Dorslaer, Anouchka Vingtier\nMise en sc\u00e8ne Val\u00e9riane De Maerteleire\nAssistanat Catherine Couchard\nSc\u00e9nographie Anne Guilleray\nLumi\u00e8res Xavier Lauwers\nVid\u00e9o Allan Beurms\nCr\u00e9ation sonore Lo\u00efc Magotteaux","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700000411"},"sp":{"name":"La reine Rouge","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700000411"},"nl":{"name":"La reine Rouge","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700000411"}},"place":{"id":331,"translations":{"de":{"name":"Th\u00e9\u00e2tre Royal du Parc","address_street_name":"Rue de la Loi","address_street_number":"3","address_street_box":null,"email":"info@theatreduparc.be","website":"http:\/\/www.theatreduparc.be","phone_contact":null,"phone_booking":"+32 2 505 30 30","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Loi, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Th\u00e9\u00e2tre Royal du Parc","address_street_name":"Rue de la Loi","address_street_number":"3","address_street_box":null,"email":"info@theatreduparc.be","website":"http:\/\/www.theatreduparc.be","phone_contact":null,"phone_booking":"+32 2 505 30 30","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Loi, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Th\u00e9\u00e2tre Royal du Parc","address_street_name":"Wetstraat","address_street_number":"3","address_street_box":null,"email":"info@theatreduparc.be","website":"http:\/\/www.theatreduparc.be","phone_contact":null,"phone_booking":"+32 2 505 30 30","address_zip":"1000","address_city":"Brussels","address_line1":"Wetstraat, 3","address_line2":"1000 Brussels","description_web":"The Th\u00e9\u00e2tre Royal du Parc is a theater built in 1782 on the edge of the Warandepark, in addition to the successful Vaux-Hall on the same site. After a turbulent history among the various occupiers, the theater today distinguishes itself by a program that alters classic and contemporary French-language creations, with a clear preference for comedy.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Th\u00e9\u00e2tre Royal du Parc","address_street_name":"Rue de la Loi","address_street_number":"3","address_street_box":null,"email":"info@theatreduparc.be","website":"http:\/\/www.theatreduparc.be","phone_contact":null,"phone_booking":"+32 2 505 30 30","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Loi, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Th\u00e9\u00e2tre Royal du Parc","address_street_name":"Rue de la Loi","address_street_number":"3","address_street_box":null,"email":"info@theatreduparc.be","website":"http:\/\/www.theatreduparc.be","phone_contact":null,"phone_booking":"+32 2 505 30 30","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Loi, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Th\u00e9\u00e2tre Royal du Parc","address_street_name":"Rue de la Loi","address_street_number":"3","address_street_box":null,"email":"info@theatreduparc.be","website":"http:\/\/www.theatreduparc.be","phone_contact":null,"phone_booking":"+32 2 505 30 30","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Loi, 3","address_line2":"1000 Bruxelles","description_web":"En 1782, les fr\u00e8res Bultos firent construire au Parc de Bruxelles un Vaux-Hall \u00e0 l'instar de ce qui se faisait alors avec succ\u00e8s \u00e0 Paris et \u00e0 Londres. Le public prit rapidement le chemin de ce carrefour consacr\u00e9 aux divertissements et encourag\u00e9s par ce succ\u00e8s, ils doubl\u00e8rent leur \u00e9tablissement d'un th\u00e9\u00e2tre. Apr\u00e8s une longue et turbulente histoire sous les diff\u00e9rentes occupation, le \"Parc\" se singularise  actuellement par un programme o\u00f9 alternent les classiques et les cr\u00e9ations contemporaines, dans des mises en sc\u00e8ne \u00e0 grand spectacle et en privil\u00e9giant les com\u00e9dies. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Th\u00e9\u00e2tre Royal du Parc","address_street_name":"Rue de la Loi","address_street_number":"3","address_street_box":null,"email":"info@theatreduparc.be","website":"http:\/\/www.theatreduparc.be","phone_contact":null,"phone_booking":"+32 2 505 30 30","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Loi, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Th\u00e9\u00e2tre Royal du Parc","address_street_name":"Wetstraat","address_street_number":"3","address_street_box":null,"email":"info@theatreduparc.be","website":"http:\/\/www.theatreduparc.be","phone_contact":null,"phone_booking":"+32 2 505 30 30","address_zip":"1000","address_city":"Brussel","address_line1":"Wetstraat, 3","address_line2":"1000 Brussel","description_web":"Het Th\u00e9\u00e2tre Royal du Parc is een schouwburg die in 1782 aan de rand van het Warandepark gebouwd werd als aanvulling van de eerder gebouwde succesvolle Vaux-Hall op dezelfde site. Na een woelige geschiedenis onder de diverse bezetters onderscheidt het theater zich vandaag de dag door een programmatie die klassieke en hedendaagse Franstalige creaties wisselt, met een duidelijke voorkeur voor comedie.","description_p