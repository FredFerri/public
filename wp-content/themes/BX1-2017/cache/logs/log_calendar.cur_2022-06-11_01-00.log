en":false}},"translations":{"fr":["lundi, mardi, mercredi, jeudi, vendredi et dimanche: ferm\u00e9","samedi: de 17:00 \u00e0 20:00"],"nl":["maandag, dinsdag, woensdag, donderdag, vrijdag en zondag: gesloten","zaterdag: van 17:00 tot 20:00"],"en":["monday, tuesday, wednesday, thursday, friday and sunday: closed","saturday: from 17:00 to 20:00"]},"date_start":"2022-04-15","date_end":"2022-06-30","is_also_by_appointment":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"opening":{"day":"2022-04-15","start":"17:00:00","timestamp":"2022-04-15T17:00:00+02:00","end":"20:00:00","is_only_by_appointment":false},"tags":["exterior"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-06-05T01:35:50+02:00","published_at":"2022-04-04T15:37:32+02:00","backoffice_id":250857,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.23505514316043},{"id":529072,"date_start":"2022-06-11","date_end":"2022-06-11","date_next":"2022-06-11","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":90,"translations":{"fr":"Animations","nl":"Animaties","en":"Animations"}},"others":{"list":[101],"translations":{"fr":["Folklore"],"nl":["Folklore"],"en":["Folklore"]}}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Patchwork","shortdescr":null,"longdescr":"Le festival Patchwork est l\u2019\u00e9v\u00e9nement festif, cr\u00e9atif et familial de fin de saison du Centre culturel d\u2019Evere. Concentr\u00e9 sur une apr\u00e8s-midi, il se pr\u00e9sente comme la vitrine des actions men\u00e9es toute l\u2019ann\u00e9e par L\u2019Entrela\u2019 et ses diff\u00e9rents p\u00f4les. \r\n\r\nAU PROGRAMME CETTE ANN\u00c9E, UNE S\u00c9RIE DE PERFORMANCES :\r\nMorning Song : Danse th\u00e9\u00e2tre\r\nL\u2019Aviatrice : Cirque a\u00e9rien\r\nJos\u00e9phine & Jo : Chanson fran\u00e7aise\r\nDon Mambo : Danse hip-hop\r\nVisite Potager & Handpan : D\u00e9couverte\r\n\r\nVous pouvez aussi assister \u00e0 toutes ces performances en vous inscrivant \u00e0 l\u2019une des balades compos\u00e9es (r\u00e9servation ci-dessous). D\u00e9part des balades \u00e0 13h, 13h15 et 13h30. Plus d\u2019infos par ici !\r\n\r\nTOUT AU LONG DE L\u2019APR\u00c8S-MIDI\u2026\r\nLes ateliers s\u2019exposent:\r\nExposition des oeuvres issues des ateliers cr\u00e9atifs de l\u2019ann\u00e9e dans le b\u00e2timent brun.\r\n\r\nParcours sonore:\r\n\u00c0 l\u2019entr\u00e9e du potager, venez vous \u00e9vader gr\u00e2ce aux sons, bruits et autres exp\u00e9riences sonores uniques.\r\n\r\nCoin lecture et jeux g\u00e9ants:\r\nLa biblioth\u00e8que vous offre un moment de d\u00e9tente et d\u2019\u00e9coute \u00e0 l\u2019ombre des arbres. \r\n\r\nGuinguette citoyenne:\r\nVenez d\u00e9couvrir les diff\u00e9rents stands des projets citoyens du quartier et go\u00fbter aux d\u00e9licieuses pr\u00e9parations sucr\u00e9es et sal\u00e9es faites pour l\u2019occasion. \r\n\r\nMais encore, des d\u00e9monstrations de Graffiti, de la peinture collective, un parcours v\u00e9lo pour enfants, etc !\r\n\r\nPOUR FINIR EN BEAUT\u00c9 !\r\nConcert The Brussels Balkan Orchestra \/\/ 17h30 \u203a 18h30\r\nLa musique traditionnelle bulgare, roumaine et grecque sera mise \u00e0 l\u2019honneur par une vingtaine de musiciens de talent et cl\u00f4turera le festival !","performers":null,"boxoffice_url":null,"website":"http:\/\/www.lentrela.be\/","email":"info@lentrela.be","phone_contact":"+32 2 241 15 83","phone_booking":"+32 2 241 15 83","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/529072.html"},"nl":{"name":"Patchwork","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/529072.html"},"en":{"name":"Patchwork","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/529072.html"},"de":{"name":"Patchwork","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/529072.html"},"it":{"name":"Patchwork","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/529072.html"},"sp":{"name":"Patchwork","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/529072.html"},"pt":{"name":"Patchwork","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/529072.html"},"cn":{"name":"Patchwork","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/529072.html"}},"place":{"id":277904,"translations":{"fr":{"name":"PCS de l\u00e0 haut","address_street_name":"Avenue Platon","address_street_number":"21","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1140","address_city":"Evere","address_line1":"Avenue Platon, 21","address_line2":"1140 Evere","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"PCS de l\u00e0 h