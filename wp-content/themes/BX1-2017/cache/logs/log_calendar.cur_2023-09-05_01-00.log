unt.be","email":"info@muntpunt.be","phone_contact":null,"phone_booking":"+32 2 278 11 11","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.401320"},"cn":{"name":"Muzikranten","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.muntpunt.be","email":"info@muntpunt.be","phone_contact":null,"phone_booking":"+32 2 278 11 11","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.401320"},"fr":{"name":"Muzikranten","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.muntpunt.be","email":"info@muntpunt.be","phone_contact":null,"phone_booking":"+32 2 278 11 11","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.401320"},"sp":{"name":"Muzikranten","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.muntpunt.be","email":"info@muntpunt.be","phone_contact":null,"phone_booking":"+32 2 278 11 11","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.401320"},"nl":{"name":"Expo: SunSud: Energiedelen met je buren","shortdescr":"SunSud deelt zonne-energie in een sociale woningblok en pakt energiearmoede aan.","longdescr":"Groene stroom delen met je buren? Het kan!\n\nEen groep sociale huurders testte het uit in Brussel. Deze tentoonstelling geeft de resultaten van dit proefproject weer.\n\nDruk de prijs van zonne-energie en deel zonnepanelen met je buurt. Zo moedig je groene stroomproductie aan en maak je hernieuwbare energie toegankelijk voor alle Brusselaars, waarvan 30% in (energie)armoede leeft.\n\nLaat je inspireren en start je eigen project op!\n\nMet SunSud pioniert een groep sociale huurders, aangespoord door City Mine(d), Energie Commune en eigenaar Zuiderhaard, als eerste deelproject in een sociale woonblok in Brussel.\nMaatwerk, vertrouwen en autonomie maakten het proefproject tot en succes. Op economisch en ecologisch vlak, maar vooral ook sociaal.\n\n\u00a0","performers":null,"boxoffice_url":null,"website":"http:\/\/www.muntpunt.be","email":"info@muntpunt.be","phone_contact":null,"phone_booking":"+32 2 278 11 11","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.401320"}},"place":{"id":276204,"translations":{"de":{"name":"Muntpunt,  Agora \u2013 Infohoek","address_street_name":"Place de la Monnaie","address_street_number":"6","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Monnaie, 6","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Muntpunt,  Agora \u2013 Infohoek","address_street_name":"Place de la Monnaie","address_street_number":"6","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Monnaie, 6","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Muntpunt,  Agora \u2013 Infohoek","address_street_name":"Place de la Monnaie","address_street_number":"6","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Monnaie, 6","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Muntpunt,  Agora \u2013 Infohoek","address_street_name":"Place de la Monnaie","address_street_number":"6","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Monnaie, 6","address_line2":"1000 Bruxelles","description_web":null,"descripti