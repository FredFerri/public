sitors\/agenda\/event-detail.50007385"},"it":{"name":"Salsa, bachata, kizomba party \/ danceorientation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/facebook.com\/events\/s\/danceorientation-sbk-fridays-b\/349120061404340\/","email":"info@etagetropical.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50007385"},"cn":{"name":"Salsa, bachata, kizomba party \/ danceorientation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/facebook.com\/events\/s\/danceorientation-sbk-fridays-b\/349120061404340\/","email":"info@etagetropical.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50007385"},"fr":{"name":"Salsa, bachata, kizomba party \/ danceorientation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/facebook.com\/events\/s\/danceorientation-sbk-fridays-b\/349120061404340\/","email":"info@etagetropical.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50007385"},"sp":{"name":"Salsa, bachata, kizomba party \/ danceorientation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/facebook.com\/events\/s\/danceorientation-sbk-fridays-b\/349120061404340\/","email":"info@etagetropical.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50007385"},"nl":{"name":"Salsa, bachata, kizomba party \/ danceorientation","shortdescr":"NIEUW ....\nE\u00e9n keer per maand op vrijdagavond...\nSalsa bachata en kizomba party met workshops\n\nTot snel in Koekelberg!!!","longdescr":"https:\/\/facebook.com\/events\/s\/danceorientation-sbk-fridays-b\/349120061404340\/\n\nOntdek een gloednieuw concept in het hart van Brussel: Salsa, Bachata, en Kizomba met Danceorientation.BXL! Maandelijks organiseren we een sprankelend evenement op vrijdag, compleet met getalenteerde artiesten, boeiende optredens, verrijkende workshops en een bruisende line-up van fantastische DJ's. Een onvergetelijke danservaring wacht op jou!\n\n LUXE LOCATIE     NIEUWE LOCATIE\nDapperenstraat 20 - 1081 Koekelberg (BXL)\nMetro: Simonis\nRuime parkeermogelijkheid\nGrote houten dansvloer\nBose muziekinstallatie\nWarm gevoel\nFantastische cocktails en drankjes\n\n WORKSHOPS, SHOWS & FEEST \n\n19u30-20u30: \u2605 Urban Kizomba (open niveau) door Victor\n 20u30-22u00: \u2605 Cubaanse Salsa (open niveau) door Mich\u00e8le\n\n22u00-03u30: Feesttijd met\n  DJ - Gozador\n  DJ - Bernard Campbell\n\nTICKETS\nFull Pass Slechts 10\u20ac, alles inbegrepen.\n\nALLEEN CONTANT GELD\n\nBetalingsgegevens:\nDoe een bankoverschrijving naar ons bankrekeningnummer om je reservering te bevestigen. Vergeet niet je volledige naam en ook je e-mailadres te vermelden voor de bevestiging van je betaling!\nVermelding: Volledige Naam + E-mailadres\nBank: BE92 0012 1904 0123\n\nDRESSCODE VALENTIJNS EDITIE\n   GLAMOUR ","performers":"ETAGE Tropical,\nMichelle Martens,\nDJ Gozador","boxoffice_url":null,"website":"https:\/\/facebook.com\/events\/s\/danceorientation-sbk-fridays-b\/349120061404340\/","email":"info@etagetropical.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50007385"}},"place":{"id":277958,"translations":{"de":{"name":"Campus Comenius","address_street_name":"Rue des Braves","address_street_number":"20","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1081","address_city":"Koekelberg","address_line1":"Rue des Braves, 20","address_line2":"1081 Koekelberg","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Campus Comenius","address_