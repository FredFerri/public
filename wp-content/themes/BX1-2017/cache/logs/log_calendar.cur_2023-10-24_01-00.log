:null,"sub_type":"tour","ranking":1,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{"list":[258],"translations":{"de":["Stadtteile"],"pt":[null],"en":["Neighbourhoods"],"it":["Quartieri"],"cn":[null],"fr":["Quartiers"],"sp":["Barrios"],"nl":["Wijken"]}}},"translations":{"de":{"name":"Transformation du centre-ville","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.arau.org\/fr\/","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50002190"},"pt":{"name":"Transformation du centre-ville","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.arau.org\/fr\/","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50002190"},"en":{"name":"Transformation du centre-ville","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.arau.org\/fr\/","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50002190"},"it":{"name":"Transformation du centre-ville","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.arau.org\/fr\/","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50002190"},"cn":{"name":"Transformation du centre-ville","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.arau.org\/fr\/","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50002190"},"fr":{"name":"Transformation du centre-ville","shortdescr":null,"longdescr":"La pi\u00e9tonnisation des boulevards du centre a fait couler beaucoup d\u2019encre depuis le lancement du projet en 2014, principalement autour des questions de mobilit\u00e9. Alors que les chantiers de r\u00e9am\u00e9nagement de l\u2019espace public entrent dans leur derni\u00e8re phase, des projets immobiliers de reconversion se multiplient dans le p\u00e9rim\u00e8tre. La Bourse se transforme en \u00ab Belgian Beer World \u00bb tandis que l\u2019ancien si\u00e8ge d\u2019Actiris devrait accueillir l\u2019enseigne \u00ab food \u00bb Eataly. Ces deux nouvelles \u00ab attractions \u00bb feront office de lien entre le tr\u00e8s touristique quartier de la Grand Place et les Quartiers Saint-G\u00e9ry et Sainte-Catherine eux aussi soumis \u00e0 une pression toujours plus grande de l\u2019\u00e9v\u00e9nementiel et de l\u2019horeca. La Ville de Bruxelles entend-elle limiter cette tendance, \u00e0 l\u2019\u0153uvre dans de nombreuses villes d\u2019Europe, ou, au contraire, l\u2019encourager ? Quels projets de r\u00e9novation sont-ils le plus \u00e0 m\u00eame de rencontrer les aspirations des habitants? \n\nDur\u00e9e: 2h","performers":null,"boxoffice_url":null,"website":"https:\/\/www.arau.org\/fr\/","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50002190"},"sp":{"name":"Transformation du centre-ville","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.arau.org\/fr\/","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50002190"},"nl":{"name":"Transformation du centre-ville","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.arau.org\/fr\/","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50002190"}},"place":{"id":50000541,"translations":{"de":{"name":"bourse","address_street_name":"Place de la Bourse","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Bourse","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"bourse","address_street_name":"Place de la Bourse","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Bourse","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"bourse","address_street_name":"Beursplein","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Beursplein","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"bourse","address_street_name":"Place de la Bourse","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Bourse","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"bourse","address_street_name":"Place de la Bourse","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Bourse","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"fr":{"name":"bourse","address_street_name":"Place de la Bourse","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Bourse","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"bourse","address_street_name":"Place de la Bourse","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Bourse","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"bourse","address_street_name":"Beursplein","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Beursplein","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[],"translations":{}},"zones":[],"neca":null,"facebook_id":null,"backoffice_id":41285,"location":{"lat":50.8485722,"lon":4.3495865},"region":"brussels","last_updated_at":"2023-09-14T14:58:40+02:00","published_at":"2023-09-14T14:58:40+02:00","import_origin":null,"external_id":null,"is_in_address_book":false,"is_in_vb_export":false,"resto_ranking":0},"organizer":{"id":204134,"translations":{"de":{"name":"Arau - Atelier de Recherche et d'Action Urbaines","address_street_name":"Rue du Midi","address_street_number":"165","address_street_box":null,"email":"info@arau.org","website":"http:\/\/www.arau.org","phone_contact":"+32 2 219 33 45","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Midi, 165","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Arau - Atelier de Recherche et d'Action Urbaines","address_street_name":"Rue du Midi","address_street_number":"165","address_street_box":null,"email":"info@arau.org","website":"http:\/\/www.arau.org","phone_contact":"+32 2 219 33 45","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Midi, 165","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Arau - Atelier de Recherche et d'Action Urbaines","address_street_name":"Rue du Midi","address_street_number":"165","address_street_box":null,"email":"info@arau.org","website":"http:\/\/www.arau.org","phone_contact":"+32 2 219 33 45","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Midi, 165","address_line2":"1000 Bruxelles","description_web":"Understanding Brussels to better defend it!\r\nARAU was founded in 1969, in a context of \u2018Brusselsisation\u2019 and the exodus of Brussels residents to the periphery. The challenge at the time, which is still relevant today, was to defend and promote the inhabited city and a quality of life for all the inhabitants of Brussels. This led to major protests against demolition projects on the one hand and the development of counter-projects on the other, with a view to urban renewal and improving the living environment.\r\nThe ARAU intends, through its action to raise awareness and inform the population, to provide the public with the necessary tools to monitor the evolution of the city. This action takes the form of the publication of analyses and studies, the organisation of conferences and workshops, press releases, etc., as well as guided tours.\r\nThese tours, which are pioneering in the Brussels region and have been organised since 1977, aim to enhance the city and its assets, and to develop a critical view of its transformations, which includes the preservation and maintenance of its heritage.\r\nOver the years, the ARAU has developed a rich catalogue of guided tours on various themes: \u201cUnmissable Brussels\u201d, \u201cArchitecture\u201d, \u201cBrussels in Districts\u201d, \u201cThe City in Transformation\u201d, \u201cSummer Journey\u201d, \u201cA Brussels House\u201d, \u201cBrussels: City of Trams\u201d, \u201cSocial Brussels\u201d, which can be discovered during public tours or in the form of private, customised tours.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Arau - Atelier de Recherche et d'Action Urbaines","address_street_name":"Rue du Midi","address_street_number":"165","address_street_box":null,"email":"info@arau.org","website":"http:\/\/www.arau.org","phone_contact":"+32 2 219 33 45","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Midi, 165","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Arau - Atelier de Recherche et d'Action Urbaines","address_street_name":"Rue du Midi","address_street_number":"165","address_street_box":null,"email":"info@arau.org","website":"http:\/\/www.arau.org","phone_contact":"+32 2 219 33 45","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Midi, 165","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"fr":{"name":"Arau - Atelier de Recherche et d'Action Urbaines","address_street_name":"Rue du Midi","address_street_number":"165","address_street_box":null,"email":"info@arau.org","website":"http:\/\/www.arau.org","phone_contact":"+32 2 219 33 45","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Midi, 165","address_line2":"1000 Bruxelles","description_web":"Comprendre Bruxelles pour mieux la d\u00e9fendre !\r\nL\u2019ARAU a \u00e9t\u00e9 fond\u00e9 en 1969, dans un contexte de \u00ab bruxellisation \u00bb et d\u2019exode des Bruxellois vers la p\u00e9riph\u00e9rie. L\u2019enjeu \u00e0 l\u2019\u00e9poque, toujours d\u2019actualit\u00e9 : d\u00e9fendre et promouvoir la ville habit\u00e9e et une qualit\u00e9 de vie pour tous les Bruxellois, ce qui s\u2019est traduit par d\u2019importantes contestations de projets de d\u00e9molition d\u2019une part et le d\u00e9veloppement de contre-projets d\u2019autre part, dans une optique de r\u00e9novation urbaine et d\u2019am\u00e9lioration du cadre de vie.\r\nL\u2019ARAU entend, par son action de sensibilisation et d\u2019information de la population, mettre \u00e0 disposition du public les outils n\u00e9cessaires pour suivre l\u2019\u00e9volution de la ville. Cette action se mat\u00e9rialise \u00e0 travers la publication d\u2019analyses et d\u2019\u00e9tudes, l\u2019organisation de colloques et d\u2019ateliers, des communiqu\u00e9s de presse, \u2026ainsi que de visites guid\u00e9es.\r\nCes visites, pionni\u00e8res en r\u00e9gion bruxelloise et organis\u00e9es depuis 1977, visent \u00e0 revaloriser la ville et ses atouts, \u00e0 d\u00e9velopper un regard critique sur ses transformations, ce qui passe par la sauvegarde et l\u2019entretien de son patrimoine.\r\nAu fil de toutes ces ann\u00e9es, l\u2019ARAU a d\u00e9velopp\u00e9 un riche catalogue de visites guid\u00e9es se d\u00e9clinant en diverses th\u00e9matiques : \u00ab Bruxelles incontournable \u00bb, \u00ab Architecture \u00bb, \u00ab Bruxelles en quartiers \u00bb, \u00ab La ville en transformation \u00bb, \u00ab Parcours d\u2019\u00e9t\u00e9 \u00bb, \u00ab Une maison bruxelloise \u00bb, \u00ab Bruxelles : ville de trams \u00bb, \u00ab Bruxelles sociale \u00bb, qu\u2019il est possible de d\u00e9couvrir lors de tours publics ou sous forme de visites priv\u00e9es, personnalisables.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Arau - Atelier de Recherche et d'Action Urbaines","address_street_name":"Rue du Midi","address_street_number":"165","address_street_box":null,"email":"info@arau.org","website":"http:\/\/www.arau.org","phone_contact":"+32 2 219 33 45","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Midi, 165","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Arau - Atelier de Recherche et d'Action Urbaines","address_street_name":"Zuidstraat","address_street_number":"165","address_street_box":null,"email":"info@arau.org","website":"http:\/\/www.arau.org","phone_contact":"+32 2 219 33 45","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Zuidstraat, 165","address_line2":"1000 Bruxelles","description_web":"Brussel begrijpen om het beter te kunnen verdedigen!\r\nHet ARAU werd opgericht in 1969, in een context van \u201cBrusselisering\u201d en de uittocht van de Brusselaars naar de rand. De uitdaging van die tijd, die ook vandaag nog actueel is, bestond erin de bewoonde stad en de levenskwaliteit van alle Brusselaars te verdedigen en te bevorderen. Dat leidde tot grote protesten tegen afbraakprojecten enerzijds en de ontwikkeling van tegenprojecten anderzijds, met het oog op stadsvernieuwing en verbetering van de leefomgeving.\r\nHet ARAU wil met zijn bewustmakings- en voorlichtingsactie de bevolking de nodige instrumenten aanreiken om de evolutie van de stad te volgen. Deze actie neemt de vorm aan van de publicatie van analyses en studies, de organisatie van conferenties en workshops, perscommuniqu\u00e9s, enz. en rondleidingen.\r\nDeze rondleidingen, die baanbrekend zijn in het Brusselse Gewest en al sinds 1977 worden georganiseerd, hebben tot doel de stad en haar troeven tot hun recht te laten komen en een kritische kijk te ontwikkelen op haar transformaties, die ook het behoud en de instandhouding van haar erfgoed inhouden.\r\nIn de loop der jaren heeft het ARAU een rijke catalogus van rondleidingen over verschillende thema\u2019s samengesteld: \u201cOnmisbaar Brussel\u201d, \u201cArchitectuur\u201d, \u201cBrussel in wijken\u201d, \u201cDe stad in transformatie\u201d, \u201cZomerreis\u201d, \u201cEen Brussels huis\u201d, \u201cBrussel: stad van de trams\u201d, \u201cSociaal Brussel\u201d, die tijdens openbare rondleidingen of in de vorm van priv\u00e9rondleidingen op maat kunnen worden ontdekt.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":422,"location":{"lat":50.84343195,"lon":4.34634563},"last_updated_at":"2023-05-31T10:38:13+02:00","published_at":"2013-10-19T01:13:31+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/1635b6eced1dfd4d13d1f7242675cb2acef47132.jpg","width":1000,"height":677,"ratio":1,"oEmbed_height":677,"oEmbed_width":1000,"translations":{"de":{"title":"Transformation du centre-ville","copyright":null},"pt":{"title":"Transformation du centre-ville","copyright":null},"en":{"title":"Transformation du centre-ville","copyright":null},"it":{"title":"Transformation du centre-ville","copyright":null},"cn":{"title":"Transformation du centre-ville","copyright":null},"fr":{"title":"Transformation du centre-ville","copyright":null},"sp":{"title":"Transformation du centre-ville","copyright":null},"nl":{"title":"Transformation du centre-ville","copyright":null}}}],"dates":[{"