2:00","import_origin":null,"external_id":null,"is_in_address_book":false,"is_in_vb_export":true,"resto_ranking":0},"media":[{"type":"poster","link":"https:\/\/agendabrussels.imgix.net\/ea76f027dd85e323603b8659f20ae1c8fd5dba69.png","width":1080,"height":1080,"ratio":1,"translations":{"fr":{"title":"Woo Dop","copyright":null},"nl":{"title":"Woo Dop","copyright":null},"en":{"title":"Woo Dop","copyright":null}}}],"dates":[{"day":"2022-11-22","doors":"19:00:00","start":"20:00:00","end":"21:15:00","is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":10},{"translations":{"fr":{"name":"Pr\u00e9vente"},"nl":{"name":"Voorverkoop"},"en":{"name":"Presale"}},"value":8}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-11-02T09:35:25+01:00","published_at":"2022-11-02T09:28:55+01:00","backoffice_id":265013,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":1},{"id":539408,"date_start":"2022-11-22","date_end":"2022-11-26","date_next":"2022-11-22","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater"}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"],"de":["Theater"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Nothingness","shortdescr":null,"longdescr":"Nothingness \u2013 \u00ab n\u00e9ant \u00bb \u2013 est un projet qui interroge notre rapport au vide, \u00e0 la non-existence, \u00e0 la page blanche.\r\n\r\nLe projet fait r\u00e9f\u00e9rence au vide, avec toutes les contradictions que celui-ci \u00e9veille en nous. Ce moment suspendu entre fin et recommencement : inertie, latence. Cet entre-deux o\u00f9 s\u2019entrecroisent le d\u00e9sespoir et l\u2019\u00e9lan cr\u00e9ateur. Maria Eugenia Lopez tente de saisir comment d\u2019une part la crainte du vide peut nourrir le besoin de garder toutes traces de ce qui nous \u00e9chappe, jusqu\u2019\u00e0 vouloir pr\u00e9voir l\u2019impr\u00e9visible, fixer l\u2019\u00e9ph\u00e9m\u00e8re et figer le mouvement, l\u2019\u00e9change, la transformation\u2026 la vie. Ou comment d\u2019autre part un pr\u00e9sent rompu, un arr\u00eat du film, un \u00e9cran blanc, peuvent aussi bien activer des \u00ab sentir \u00bb, des \u00ab se laisser affecter par \u00bb, des \u00ab faire \u00bb inattendus, susceptibles de g\u00e9n\u00e9rer une tout autre aventure sp\u00e9culative, une tout autre mani\u00e8re de se remettre au monde, une tout autre mani\u00e8re de cr\u00e9er, d\u2019exister : une toute nouvelle histoire.\r\n\r\nDans Nothingness, Maria Eugenia Lopez parle de la peur du vide, de ce qu\u2019il y a de terrifiant dans l\u2019id\u00e9e de tout perdre, de se perdre, de l\u2019obsession de figer ce qui par essence est en constante transformation. Ce projet est con\u00e7u comme un terrain neutre o\u00f9 les \u00e9v\u00e9nements \u00e9mergent et se transforment \u00e0 tout moment. Par le contraste et le basculement de situations, l\u2019autrice souhaite \u00e9voquer sur le plateau tout ce qui est de l\u2019ordre de l\u2019impr\u00e9visible et de l\u2019\u00e9ph\u00e9m\u00e8re, ce qui nous \u00e9chappe. Se livrer m\u00e9taphoriquement au vide. Ce projet est envisag\u00e9 comme un \u00e9loge du vide, avec toutes les contradictions qu\u2019il m\u2019\u00e9voque : l\u2019angoisse, l\u2019horreur mais aussi l\u2019extase, les envies d\u2019envol, d\u2019\u00e9quilibre, de chute, de calme absolu. Une page blanche.\r\n\r\n--------\r\n\r\nConception et mise en sc\u00e8ne : Maria Eugenia Lopez \/ Avec : Shantala P\u00e8pe, Louis Nam le Van Ho \/ Cr\u00e9ation musique : Guillaume Le Boisselier \/ Cr\u00e9ation lumi\u00e8re : Peter Maschke \/ Regard ext\u00e9rieur : Pascale Gigon \/ D\u00e9cor : Evelyne de Behr, Peter Maschke \/ Photos : Emmanuel Andr\u00e9e. \r\n\r\nUne cr\u00e9ation de Maria Eugenia Lopez, en coproduction avec Le Th\u00e9\u00e2tre de la Vie et Les Brigittines. Partenaires de r\u00e9sidence : Materiais Diversos \u2013 Lisbonne, La Briqueterie \u2013 Paris, Th\u00e9\u00e2tre Marni. Une cr\u00e9ation accompagn\u00e9e par : le Grand Studio. Avec le soutien de la F\u00e9d\u00e9ration Wallonie-Bruxelles \u2013 Service de la Danse.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatredelavie.be\/spectacle\/nothingness-2\/","email":"reservations@theatredelavie.be","phone_contact":"+32 2 219 11 86","phone_booking":"+32 489 15 15 51","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.539408"},"nl":{"name":"Nothingness","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.539408"},"en":{"name":"Nothingness","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.539408"},"de":{"name":"Nothingness","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.539408"},"it":{"name":"Nothingness","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-det