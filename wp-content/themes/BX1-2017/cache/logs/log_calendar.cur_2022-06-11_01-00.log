e":"Senior"}},"value":4}],"child_events":[],"parent_events":[],"targets":{"list":[10],"translations":{"fr":["Seniors"],"nl":["Senioren"],"en":["Seniors"]}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-06-08T01:35:22+02:00","published_at":"2022-03-03T13:07:28+01:00","backoffice_id":248934,"import_origin":null,"sub_type":"sport","show_in_agenda":true,"ranking":0.18862731254013},{"id":534638,"date_start":"2022-06-14","date_end":"2022-06-16","date_next":"2022-06-14","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":84,"translations":{"fr":"Divers","nl":"Varia","en":"Various"}},"others":{}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Atelier Action Climat","shortdescr":null,"longdescr":"\/\/\/\/   URGENCE CLIMATIQUE \\\\\\\\\r\nPour lutter et s\u2019adapter au changement climatique, le Plan Climat de la commune d'Anderlecht est en cours d\u2019\u00e9criture. Pourquoi ne pas rejoindre ce mouvement en nous aidant \u00e0 d\u00e9tailler ce Plan Climat ? \r\nDes initiatives ou projets citoyens en t\u00eate pour votre quartier ? Trouvons ensemble comment la Commune peut vous aider !\r\nVenez en discuter avec nous lors d\u2019un atelier (avec go\u00fbter\/sandwich) :\r\n- le mardi 14 juin de 13h30 \u00e0 16h\r\nou\r\n- le jeudi 16 juin de 18h30 \u00e0 21h\r\nO\u00f9 : \u00e0 l\u2019Espace 16 arts, rue Rossini 16 \u00e0 1070 Anderlecht. \r\nL'atelier est gratuit.\r\nInscrivez-vous avant le 7 juin \u00e0 climat@anderlecht.brussels avec la date choisie. Pour toute question n\u2019h\u00e9sitez pas \u00e0 appeler le 0490 477 380.","performers":null,"boxoffice_url":null,"website":null,"email":"climat@anderlecht.brussels","phone_contact":null,"phone_booking":"+32 490 47 73 80","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/534638.html"},"nl":{"name":"Klimaatactie workshop","shortdescr":null,"longdescr":"\/\/\/\/   KLIMAATNOODSITUATIE \\\\\\\\\r\n\r\nOm de klimaatverandering te bestrijden en zich eraan aan te passen, wordt momenteel gewerkt aan het klimaatplan van de gemeente van Anderlecht. Neem deel aan dit project door ons te helpen bij de uitwerking van dit klimaatplan.\r\nHebt u burgerinitiatieven of -projecten in gedachten voor uw buurt? Laten we samen uitzoeken hoe de gemeente u kan helpen!\r\nKom er met ons over praten tijdens participatieve workshops:\r\n-dinsdag 14 juni van 13.30 tot 16.00 uur, \r\nof \r\n-donderdag 16 juni van 18.30 tot 21.00 uur\r\nWaar : Espace 16 arts, Rossinistraat 16, 1070 Anderlecht. \r\nDe workshop is gratis.\r\nSchrijf u in voor 7 juni op klimaat@anderlecht.brussels. Als u vragen hebt, bel dan 0490 477 380.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/534638.html"},"en":{"name":"Atelier Action Climat","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/534638.html"},"de":{"name":"Atelier Action Climat","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/534638.html"},"it":{"name":"Atelier Action Climat","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/534638.html"},"sp":{"name":"Atelier Action Climat","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":nul