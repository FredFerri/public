e,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[36,41],"translations":{"fr":["Mus\u00e9es et art centers","Installation, performance"],"nl":["Musea en kunstcentra","Installatie, performance"],"en":["Museums and art centers","Installation, performance"]}}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"\u00c0 pieds joints","shortdescr":"Dans le cadre du Picture Festival, les autrices jeunesse Loren Capelli et Anne Herbauts pr\u00e9sentent leur installation \"\u00c0 pieds joints\"","longdescr":"Au c\u0153ur de cette proposition, il y a le livre, qui nous r\u00e9unit et que nous envisageons comme un organisme vivant, m\u00ealant connaissances et exp\u00e9riences sensibles. \r\nLoren\r\n\r\nMat\u00e9rialisation et d\u00e9mat\u00e9rialisation d\u2019une flaque : quand nous regardons une flaque, notre \u0153il r\u00e9unit tous ces niveaux en une image. Si nous devons photographier cette flaque, nous devrons choisir quel niveau capter.\r\n\u00c9crire avec le texte et l\u2019image, dans l\u2019album, c\u2019est \u00e9crire l\u2019ensemble de tous les niveaux narratifs en une \u00e9criture invisible, qui n\u2019existe pas r\u00e9ellement, mais qui op\u00e8re entre le texte et l\u2019image.\r\naNNe","performers":"Loren Capelli; Anne Herbauts","boxoffice_url":null,"website":"http:\/\/www.wittockiana.org","email":"info@wittockiana.org","phone_contact":"+32 2 770 53 33","phone_booking":"+32 2 770 53 33","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/529240.html"},"nl":{"name":"\u00c0 pieds joints","shortdescr":"In het kader van het Picture Festival presenteren de jeugdauteurs Loren Capelli en Anne Herbauts hun installatie \"\u00c0 pieds joints\"","longdescr":"De kern van dit voorstel is het boek, dat ons samenbrengt en dat wij zien als een levend organisme, waarin kennis en sensibele ervaringen samenvloeien. \r\nLoren\r\n\r\nMaterialisering en dematerialisering van een plas: wanneer wij naar een plas kijken, verzamelt ons oog al deze niveaus tot een beeld. Als we deze plas willen fotograferen, zullen we moeten kiezen welk niveau we willen vastleggen.\r\nSchrijven met tekst en beeld, in een album, betekent het geheel van alle narratieve niveaus opschrijven in een onzichtbaar schrift, dat niet echt bestaat, maar dat tussen de tekst en het beeld fungeert.\r\naNNe","performers":"Loren Capelli; Anne Herbauts","boxoffice_url":null,"website":"https:\/\/picturefestival.be","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/529240.html"},"en":{"name":"\u00c0 pieds joints","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/529240.html"},"de":{"name":"\u00c0 pieds joints","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/529240.html"},"it":{"name":"\u00c0 pieds joints","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/529240.html"},"sp":{"name":"\u00c0 pieds joints","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/529240.html"},"pt":{"name":"\u00c0 pieds joints","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/529240.html"},"cn":{"name":"\u00c0 pieds joints","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/529240.html"}},"place":{"id":142,"translations":{"fr":{"name":"Bibliotheca Wittockiana : Mus\u00e9e des Arts du livre et de la Reliure","address_street_name":"Rue du Bemel","address_street_number":"23","address_street_box":null,"email":"info@wittockiana.org","website":"http:\/\/www.wittockiana.org","phone_contact":"+32 2 770 53 33","phone_booking":null,"address_zip":"1150","address_city":"Woluwe-Saint-Pierre","address_line1":"Rue du Bemel, 23","address_line2":"1150 Woluwe-Saint-Pierre","description_web":"Fond\u00e9e en 1983 par Michel Wittock, bibliophile de renom, la Bibliotheca Wittockiana est \u00e0 la fois un mus\u00e9e du livre, une biblioth\u00e8que et une r\u00e9serve pr\u00e9cieuse de livres anciens, modernes et contemporains.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Bibliotheca Wittockiana - Museum van de Boekkunsten en de Boekband","address_street_name":"Bemelstraat","address_street_number":"23","address_street_box":null,"email":"info@wittockiana.org","website":"http:\/\/www.wittockiana.org","phone_contact":"+32 2 770 53 33","phone_booking":null,"address_zip":"1150","address_city":"Sint-Pieters-Woluwe","address_line1":"Bemelstraat, 23","address_line2":"1150 Sint-Pieters-Woluwe","description_web":"De Bibliotheca Wittockiana biedt onderdak aan een van de mooiste en meest prestigieuze boekbandcollecties ter wereld. In het leven geroepen door een enthousiaste boekenliefhebber, is het de enige instelling in zijn soort in Belgi\u00eb en het buitenland. De permanente collectie, die enkel op afspraak te bezichtigen is, bevat meer dan 3000 kunstbindingen van de 16de tot de 21ste eeuw. Wittockiana organiseert ongeveer vier tijdelijke tentoonstellingen per jaar over boekbinden en boekenkunsten.","description_print":"","booking_url":null,"sort_or