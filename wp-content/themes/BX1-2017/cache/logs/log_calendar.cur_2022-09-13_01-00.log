description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":null,"facebook_id":null,"backoffice_id":11602,"location":{"lat":50.85752696,"lon":4.34198971},"region":"brussels","last_updated_at":"2022-08-30T08:35:05+02:00","published_at":"2013-10-19T01:31:12+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":false,"resto_ranking":0},"media":[],"dates":[{"day":"2022-09-18","doors":null,"start":"14:00:00","end":"15:00:00","is_soldout":false,"is_canceled":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-08-30T08:35:05+02:00","published_at":"2022-08-30T08:09:30+02:00","backoffice_id":260611,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":2},{"id":540094,"date_start":"2022-09-18","date_end":"2022-09-18","date_next":"2022-09-18","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":90,"translations":{"fr":"Animations","nl":"Animaties","en":"Animations"}},"others":{"list":[95],"translations":{"fr":["Patrimoine"],"nl":["Erfgoed"],"en":["Heritage"]}}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Traces de colonisation","shortdescr":"Journ\u00e9es du Patrimoine","longdescr":"ATTENTION Mus\u00e9e Charlier seulement le :\r\nDimanche 18\/09\/2022\r\n\r\n10h > 17h.\r\nAccessible sans r\u00e9servation.\r\nNon accessible pour les chaises roulantes.\r\nGratuit.\r\n\r\nLe Mus\u00e9e Charlier souhaite entamer une r\u00e9flexion sur la d\u00e9colonisation de sa pr\u00e9sentation mus\u00e9ale. Ce processus est pr\u00e9c\u00e9d\u00e9 d\u2019une discussion, d\u2019un questionnement et d\u2019un r\u00e9examen des pi\u00e8ces de sa collection et des informations les concernant. L\u2019une des pi\u00e8ces les plus remarquables, le buste de Paul Panda Farnana jeune (plus tard ses \u00e9crits et discours, r\u00e9formistes et pacifistes, marqueront les premiers pas du nationalisme congolais) sculpt\u00e9 par Guillaume Charlier, est actuellement en pr\u00eat au MAS jusqu\u2019en octobre pour l\u2019exposition \u00c9coute. Dans un cadre g\u00e9n\u00e9ral de r\u00e9flexion sur l\u2019Art nouveau et la d\u00e9colonisation, Georgine Dibua Mbombo de l\u2019organisation Bakushinta animera un forum de discussion, dimanche \u00e0 15h.","performers":"Georgine Dibua Mbombo de l\u2019organisation Bakushinta.","boxoffice_url":null,"website":"http:\/\/www.charliermuseum.be","email":"info@charliermuseum.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.540094"},"nl":{"name":"Sporen van kolonisatie","shortdescr":"Open Monumentendagen","longdescr":"LET OP Charlier Museum ALLEEN MAAR op\r\nZondag 18\/09\/2022\r\n\r\n10u > 17u.\r\nToegankelijk zonder reservering.\r\nNiet toegankelijk voor rolstoelen.\r\nGratis.\r\n\r\nHet Museum Charlier wil een bezinning starten over de dekolonisatie van de museumcollecties. Het proces wordt voorafgegaan door een bespreking, een bevraging en een nieuw onderzoek van de museumstukken en de informatie die erover bestaat. Een van de meest opmerkelijke stukken, de buste van de jonge Paul Panda Farnana (later zouden zijn reformistische en pacifistische geschriften en redevoeringen de eerste stappen zetten in het Congolese nationalisme) van de hand van Guillaume Charlier, wordt tot oktober in bruikleen gegeven aan het MAS voor de tentoonstelling \u00c9coute. In een algemene bezinning over de art nouveau en de dekolonisatie zal Georgine Dibua Mbombo van de organisatie Bakushinta een discussieforum leiden op zondag om 15u.","performers":"Georgine Dibua Mbombo van de organisatie Bakushinta.","boxoffice_url":null,"website":"https:\/\/urban.brussels","email":"info@charliermuseum.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.540094"},"en":{"name":"Traces de colonisation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.540094"},"de":{"name":"Traces de colonisation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.540094"},"it":{"name":"Traces de colonisation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.540094"},"sp":{"name":"Traces de colonisation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.540094"},"pt":{"name":"Traces de colonisation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.540094"},"cn":{"name":"Traces de colonisation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.540094"}},"place":{"id":753,"translations":{"fr":{"name":"Mus\u00e9e Charlier","address_street_name":"Avenue des Arts","address_street_number":"16","address_street_box":null,"email":"info@charliermuseum.be","website":"http:\/\/www.charliermuseum.be","phone_contact":"+32 2 217 81 61","phone_booking":"+32 2 217 81 61","address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Avenue des Arts, 16","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"Le mus\u00e9e, inaugur\u00e9 en 1928, est comme un tableau d\u2019\u00e9poque\u2026 on se retrouve au temps de La Libre Esth\u00e9tique et du Groupe des 20. Les collections sont expos\u00e9es dans les salons, riches en mobilier et objets d\u2019art d\u00e9coratifs d\u2019\u00e9poque Louis XV, Louis XVI et Empire.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Charliermuseum","address_street_name":"Kunstlaan","address_street_number":"16","address_street_box":null,"email":"info@charliermuseum.be","website":"http:\/\/www.charliermuseum.be","phone_contact":"+32 2 217 81 61","phone_booking":"+32 2 217 81 61","address_zip":"1210","address_city":"Sint-Joost-Ten-Node","address_line1":"Kunstlaan, 16","address_line2":"1210 Sint-Joost-Ten-Node","description_web":"Het museum, geopend in 1928, is gevestigd in het prive-herenhuis van de beeldhouwer Guillaume Charlier, dat dateert uit de 19e eeuw. Het richt zich op de Belgische schilderkunst van eind 19e tot begin 20e eeuw. De collecties worden getoond in de salons, rijkelijk voorzien van decoratieve stukken uit de Louis XV, Louis XVI en Empire periodes.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Charlier Museum","address_street_name":"Avenue des Arts","address_street_number":"16","address_street_box":null,"email":"info@charliermuseum.be","website":"http:\/\/www.charliermuseum.be","phone_contact":"+32 2 217 81 61","phone_booking":"+32 2 217 81 61","address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Avenue des Arts, 16","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"The museum is based in the private mansion, dating from the 19th century, of the sculptor Guillaume Charlier. It focuses on Belgian painting from the late 19th to the early 20th century. Its art exhibitions take place in a setting of lavish furnishings, with numerous decorative pieces from the Louis XV, Louis XVI, and Empire periods.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Mus\u00e9e Charlier","address_street_name":"Avenue des Arts","address_street_number":"16","address_street_box":null,"email":"info@charliermuseum.be","website":"http:\/\/www.charliermuseum.be","phone_contact":"+32 2 217 81 61","phone_booking":"+32 2 217 81 61","address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Avenue des Arts, 16","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"Das 1928 eingeweihte Museum ist wie ein Gem\u00e4lde der Epoche... man findet sich in der Zeit der La Libre Est\u00e9tique und der Groupe des 20 wieder. Die Sammlungen werden in den reich mit Mobiliar und historischen Dekorationsgegenst\u00e4nden (Louis XV, Louis XV und Empire) best\u00fcckten Salons ausgestellt.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Mus\u00e9e Charlier","address_street_name":"Avenue des Arts","address_street_number":"16","address_street_box":null,"email":"info@charliermuseum.be","website":"http:\/\/www.charliermuseum.be","phone_contact":"+32 2 217 81 61","phone_booking":"+32 2 217 81 61","address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Avenue des Arts, 16","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Museo Charlier","address_street_name":"Avenue des Arts","address_street_number":"16","address_street_box":null,"email":"info@charliermuseum.be","website":"http:\/\/www.charliermuseum.be","phone_contact":"+32 2 217 81 61","phone_booking":"+32 2 217 81 61","address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Avenue des Arts, 16","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"El Museo Charlier, una mansi\u00f3n del siglo XIX obra de Horta durante sus a\u00f1os de juventud, te sumergir\u00e1 en la atm\u00f3sfera de un lujoso sal\u00f3n de arte: la Belle Epoque te invita a so\u00f1ar, a pasear entre las esculturas de Charlier, Hager y Wouters, las pinturas de Smits, Fr\u00e9d\u00e9ric, Oleffe, Laermans, Van Strydonck, Ensor... Este ambiente \u00edntimo se completa con los muebles de los ebanistas Chapuis, Sen\u00e9, Nadal l'A\u00een\u00e9, numerosos objetos de arte decorativo de estilos Luis XIV, XV, XVI y estilo Imperio, tapices de Bruselas y Audenaerde, as\u00ed como excepcionales un excepcional sal\u00f3n chino. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Mus\u00e9e Charlier","address_street_name":"Avenue des Arts","address_street_number":"16","address_street_box":null,"email":"info@charliermuseum.be","website":"http:\/\/www.charliermuseum.be","phone_contact":"+32 2 217 81 61","phone_booking":"+32 2 217 81 61","address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Avenue des Arts, 16","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Mus\u00e9e Charlier","address_street_name":"Avenue des Arts","address_street_number":"16","address_street_box":null,"email":"info@charliermuseum.be","website":"http:\/\/www.charliermuseum.be","phone_contact":"+32 2 217 81 61","phone_booking":"+32 2 217 81 61","address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Avenue des Arts, 16","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":[],"zones":{"list":[22