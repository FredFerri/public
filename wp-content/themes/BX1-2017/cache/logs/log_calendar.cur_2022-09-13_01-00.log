ointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":90,"translations":{"fr":"Animations","nl":"Animaties","en":"Animations"}},"others":{}},"languages":{"spoken":["nl","fr","en"],"subtitles":[]},"translations":{"fr":{"name":"Boekenverkoop","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.540582"},"nl":{"name":"Boekenverkoop","shortdescr":"Kom op Autoloze zondag naar de jaarlijkse boekenverkoop van Muntpunt. Trakteer jezelf op een karrenvracht boeken, cd\u2019s en dvd\u2019s voor spotprijzen. Met extra veel kinderboeken, thrillers en cd\u2019s.","longdescr":"Op de Boekenverkoop van Muntpunt koop je voor een prikje een nieuwe boeken-, muziek- of film collectie bij elkaar. Alle titels gaan de deur uit voor\u00a0\u20ac 1 of \u20ac 5. Zo maken we plaats in de Muntpuntrekken voor nieuwe materialen.\n\nTweedehands, maar daarom niet oud\nAlles wat je kan kopen is natuurlijk tweedehands, maar dat wil niet zeggen dat je enkel stoffige werken tegenkomt. Ook recente titels waarvan meerdere exemplaren beschikbaar waren in de bibliotheek, vinden hun weg naar de verkoop.\n\nPaspartoe-omruilvoordeel\nVlijtig Paspartoepunten gespaard? Dit is je kans om ze te verzilveren! Kom naar de Paspartoestand in Muntpunt, en geniet van dit interessante omruilvoordeel: voor 5 punten krijg je een jeton ter waarde van \u20ac 1. Deze kan je dan weer uitgeven op de boekenverkoop (maximum 5 jetons per persoon).\n\n\u00a0\n\nBook Sale\n\nJoin us on Car Free Sunday for Muntpunt's annual book sale. Treat yourself to a cartload of books, CDs and DVDs at bargain prices. With an extra lot of children's books, thrillers and CDs.\n\nBuy yourself a new book, music or film collection for next to nothing. All titles are sold for\u00a0\u20ac 1 or \u20ac 5. This way, we make room\u00a0for new titles on our shelves.\n\nSecond-hand, but not old\nOf course the titles for sale are\u00a0second-hand, but that doesn't mean you'll only find dusty old works!\u00a0Recent titles of which the library own multiples also find their way to the book sale.\n\nPaspartoe\nBeen saving a lot of Paspartoe points? This is your chance to redeem them! Come to the Paspartoe desk\u00a0in Muntpunt\u00a0and enjoy this interesting exchange benefit: for 5 points, you'll receive a token worth \u20ac 1. You can spend these tokens on the book sales (maximum 5 tokens per person).\n\n\u00a0\n\nVente de livres\n\nVenez \u00e0 la vente annuelle de livres de Muntpunt le Dimanche sans voiture. Obtenez un panier de livres, de CD et de DVD \u00e0 des prix avantageux. Avec beaucoup de livres pour enfants, des thrillers et des CD.\n\nAchetez-vous une nouvelle collection de livres, de musique ou de films pour presque rien. Tous les titres sont vendus au prix de 1 \u20ac ou 5 \u20ac, ce qui nous permet de faire de la place pour de nouveaux titres sur nos \u00e9tag\u00e8res.\n\nDe seconde main, mais pas vieux\nBien s\u00fbr, les titres mis en vente sont d'occasion, mais cela ne signifie pas que vous ne trouverez que de vieux ouvrages poussi\u00e9reux !\u00a0Des titres r\u00e9cents dont la biblioth\u00e8que poss\u00e8de plusieurs exemplaires se retrouvent \u00e9galement \u00e0 la vente de livres.\n\nPaspartoe\nVous avez \u00e9pargn\u00e9 beaucoup de points Paspartoe ? C'est l'occasion de les \u00e9changer ! Pr\u00e9sentez-vous au comptoir Paspartoe de Muntpunt et profitez de cet avantage d'\u00e9change int\u00e9ressant : pour 5 points, vous recevrez un jeton d'une valeur de 1 \u20ac que vous pourrez d\u00e9penser lors des ventes de livres (maximum 5 jetons par personne).","performers":null,"boxoffice_url":null,"website":"https:\/\/www.muntpunt.be\/boekenverkoop","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.540582"},"en":{"name":"Boekenverkoop","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.540582"},"de":{"name":"Boekenverkoop","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.540582"},"it":{"name":"Boekenverkoop","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.540582"},"sp":{"name":"Boekenverkoop","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.540582"},"pt":{"name":"Boekenverkoop","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.540582"},"cn":{"name":"Boekenverkoop","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.540582"}},"place":{"id":275830,"translations":{"fr":{"name":"Muntpunt,  Agora 0","address_street_name":"Munt 6","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Munt 6","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_vi