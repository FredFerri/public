address_line1":"Lieu de d\u00e9part: \u00e0 l\u2019angle de l\u2019avenue Fl\u00e9ron et de l\u2019avenue de la Verrerie","address_line2":"1190 Vorst","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[21],"translations":{"de":["S\u00fcden"],"pt":[null],"en":["South"],"it":["Sud"],"cn":[null],"fr":["Sud"],"sp":["Sur"],"nl":["Zuid"]}},"neca":null,"facebook_id":null,"backoffice_id":40443,"location":{"lat":50.79321809,"lon":4.32891921},"region":"brussels","last_updated_at":"2023-05-06T04:10:05+02:00","published_at":"2023-05-05T14:44:58+02:00","import_origin":null,"external_id":null,"is_in_address_book":false,"is_in_vb_export":false,"resto_ranking":0},"organizer":{"id":204134,"translations":{"de":{"name":"Arau - Atelier de Recherche et d'Action Urbaines","address_street_name":"Rue du Midi","address_street_number":"165","address_street_box":null,"email":"info@arau.org","website":"http:\/\/www.arau.org","phone_contact":"+32 2 219 33 45","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Midi, 165","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Arau - Atelier de Recherche et d'Action Urbaines","address_street_name":"Rue du Midi","address_street_number":"165","address_street_box":null,"email":"info@arau.org","website":"http:\/\/www.arau.org","phone_contact":"+32 2 219 33 45","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Midi, 165","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Arau - Atelier de Recherche et d'Action Urbaines","address_street_name":"Rue du Midi","address_street_number":"165","address_street_box":null,"email":"info@arau.org","website":"http:\/\/www.arau.org","phone_contact":"+32 2 219 33 45","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue du Midi, 165","address_line2":"1000 Brussels","description_web":"Understanding Brussels to better defend it!\r\nARAU was founded in 1969, in a context of \u2018Brusselsisation\u2019 and the exodus of Brussels residents to the periphery. The challenge at the time, which is still relevant today, was to defend and promote the inhabited city and a quality of life for all the inhabitants of Brussels. This led to major protests against demolition projects on the one hand and the development of counter-projects on the other, with a view to urban renewal and improving the living environment.\r\nThe ARAU intends, through its action to raise awareness and inform the population, to provide the public with the necessary tools to monitor the evolution of the city. This action takes the form of the publication of analyses and studies, the organisation of conferences and workshops, press releases, etc., as well as guided tours.\r\nThese tours, which are pioneering in the Brussels region and have been organised since 1977, aim to enhance the city and its assets, and to develop a critical view of its transformations, which includes the preservation and maintenance of its heritage.\r\nOver the years, the ARAU has developed a rich catalogue of guided tours on various themes: \u201cUnmissable Brussels\u201d, \u201cArchitecture\u201d, \u201cBrussels in Districts\u201d, \u201cThe City in Transformation\u201d, \u201cSummer Journey\u201d, \u201cA Brussels House\u201d, \u201cBrussels: City of Trams\u201d, \u201cSocial Brussels\u201d, which can be discovered during public tours or in the form of private, customised tours.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Arau - Atelier de Recherche et d'Action Urbaines","address_street_name":"Rue du Midi","address_street_number":"165","address_street_box":null,"email":"info@arau.org","website":"http:\/\/www.arau.org","phone_contact":"+32 2 219 33 45","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Midi, 165","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Arau - Atelier de Recherche et d'Action Urbaines","address_street_name":"Rue du Midi","address_street_number":"165","address_street_box":null,"email":"info@arau.org","website":"http:\/\/www.arau.org","phone_contact":"+32 2 219 33 45","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Midi, 165","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"ARAU - Atelier de Recherche et d'Action Urbaines","address_street_name":"Rue du Midi","address_street_number":"165","address_street_box":null,"email":"info@arau.org","website":"http:\/\/www.arau.org","phone_contact":"+32 2 219 33 45","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Midi, 165","address_line2":"1000 Bruxelles","description_web":"Comprendre Bruxelles pour mieux la d\u00e9fendre !\r\nL\u2019ARAU a \u00e9t\u00e9 fond\u00e9 en 1969, dans un contexte de \u00ab bruxellisation \u00bb et d\u2019exode des Bruxellois vers la p\u00e9riph\u00e9rie. L\u2019enjeu \u00e0 l\u2019\u00e9poque, toujours d\u2019actualit\u00e9 : d\u00e9fendre et promouvoir la ville habit\u00e9e et une qualit\u00e9 de vie pour tous les Bruxellois, ce qui s\u2019est traduit par d\u2019importantes contestations de projets de d\u00e9molition d\u2019une part et le d\u00e9veloppement de contre-projets d\u2019autre part, dans une optique de r\u00e9novation urbaine et d\u2019am\u00e9lioration du cadre de vie.\r\nL\u2019ARAU entend, par son action de sensibilisation et d\u2019information de la population, mettre \u00e0 disposition du public les outils n\u00e9cessaires pour suivre l\u2019\u00e9volution de la ville. Cette action se mat\u00e9rialise \u00e0 travers la publication d\u2019analyses et d\u2019\u00e9tudes, l\u2019organisation de colloques et d\u2019ateliers, des communiqu\u00e9s de presse, \u2026ainsi que de visites guid\u00e9es.\r\nCes visites, pionni\u00e8res en r\u00e9gion bruxelloise et organis\u00e9es depuis 1977, visent \u00e0 revaloriser la ville et ses atouts, \u00e0 d\u00e9velopper un regard critique sur ses transformations, ce qui passe par la sauvegarde et l\u2019entretien de son patrimoine.\r\nAu fil de toutes ces ann\u00e9es, l\u2019ARAU a d\u00e9velopp\u00e9 un riche catalogue de visites guid\u00e9es se d\u00e9clinant en diverses th\u00e9matiques : \u00ab Bruxelles incontournable \u00bb, \u00ab Architecture \u00bb, \u00ab Bruxelles en quartiers \u00bb, \u00ab La ville en transformation \u00bb, \u00ab Parcours d\u2019\u00e9t\u00e9 \u00bb, \u00ab Une maison bruxelloise \u00bb, \u00ab Bruxelles : ville de trams \u00bb, \u00ab Bruxelles sociale \u00bb, qu\u2019il est possible de d\u00e9couvrir lors de tours publics ou sous forme de visites priv\u00e9es, personnalisables.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Arau - Atelier de Recherche et d'Action Urbaines","address_street_name":"Rue du Midi","address_street_number":"165","address_street_box":null,"email":"info@arau.org","website":"http:\/\/www.arau.org","phone_contact":"+32 2 219 33 45","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Midi, 165","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Arau - Atelier de Recherche et d'Action Urbaines","address_street_name":"Zuidstraat","address_street_number":"165","address_street_box":null,"email":"info@arau.org","website":"http:\/\/www.arau.org","phone_contact":"+32 2 219 33 45","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Zuidstraat, 165","address_line2":"1000 Brussel","description_web":"Brussel begrijpen om het beter te kunnen verdedigen!\r\nHet ARAU werd opgericht in 1969, in een context van \u201cBrusselisering\u201d en de uittocht van de Brusselaars naar de rand. De uitdaging van die tijd, die ook vandaag nog actueel is, bestond erin de bewoonde stad en de levenskwaliteit van alle Brusselaars te verdedigen en te bevorderen. Dat leidde tot grote protesten tegen afbraakprojecten enerzijds en de ontwikkeling van tegenprojecten anderzijds, met het oog op stadsvernieuwing en verbetering van de leefomgeving.\r\nHet ARAU wil met zijn bewustmakings- en voorlichtingsactie de bevolking de nodige instrumenten aanreiken om de evolutie van de stad te volgen. Deze actie neemt de vorm aan van de publicatie van analyses en studies, de organisatie van conferenties en workshops, perscommuniqu\u00e9s, enz. en rondleidingen.\r\nDeze rondleidingen, die baanbrekend zijn in het Brusselse Gewest en al sinds 1977 worden georganiseerd, hebben tot doel de stad en haar troeven tot hun recht te laten komen en een kritische kijk te ontwikkelen op haar transformaties, die ook het behoud en de instandhouding van haar erfgoed inhouden.\r\nIn de loop der jaren heeft het ARAU een rijke catalogus van rondleidingen over verschillende thema\u2019s samengesteld: \u201cOnmisbaar Brussel\u201d, \u201cArchitectuur\u201d, \u201cBrussel in wijken\u201d, \u201cDe stad in transformatie\u201d, \u201cZomerreis\u201d, \u201cEen Brussels huis\u201d, \u201cBrussel: stad van de trams\u201d, \u201cSociaal Brussel\u201d, die tijdens openbare rondleidingen of in de vorm van priv\u00e9rondleidingen op maat kunnen worden ontdekt.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":422,"location":{"lat":50.84343195,"lon":4.34634563},"last_updated_at":"2024-10-29T08:58:17+01:00","published_at":"2013-10-19T01:13:31+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/5296c9ddc61bebe31c4d8d50e4a98b436b008067.jpg","width":4000,"height":3000,"ratio":1.33,"oEmbed_height":3000,"oEmbed_width":4000,"translations":{"de":{"title":"Forest-vert et Messidor : deux cit\u00e9s-jardins \u00e0 d\u00e9couvrir","copyright":null},"pt":{"title":"Forest-vert et Messidor : deux cit\u00e9s-jardins \u00e0 d\u00e9couvrir","copyright":null},"en":{"title":"Forest-vert et Messidor : deux cit\u00e9s-jardins \u00e0 d\u00e9couvrir","copyright":null},"it":{"title":"Forest-vert et Messidor : deux cit\u00e9s-jardins \u00e0 d\u00e9couvrir","copyright":null},"cn":{"title":"Forest-vert et Messidor : deux cit\u00e9s-jardins \u00e0 d\u00e9couvrir","copyright":null},"fr":{"title":"Forest-vert et Messidor : deux cit\u00e9s-jardins \u00e0 d\u00e9couvrir","copyright":null},"sp":{"title":"Forest-vert et Messidor : deux cit\u00e9s-jardins \u00e0 d\u00e9couvrir","copyright":null},"nl":{"title":"Forest-vert et Messidor : deux cit\u00e9s-jardins \u00e0 d\u00e9couvrir","copyright":null}}}],"dates":[{"day":"2024-11-23","doors":null,"start":"14:00:00","end":"16:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"de":{"name":"Normal"},"en":{"name":"Normal"},"it":{"name":"Normale"},"fr":{"name":"Normal"},"sp":{"name":"Normal"},"nl":{"name":"Normaal"}},"value":13},{"translations":{"de":{"name":"Jugendliche"},"en":{"name":"Youth"},"it":{"name":"Ragazzi"},"fr":{"name":"Jeunes"},"sp":{"name":"J\u00f3venes"},"nl":{"name":"Jongeren"}},"value":9},{"translations":{"de":{"name":"Senioren"},"en":{"name":"Seniors"},"it":{"name":"Anziani"},"fr":{"name":"Seniors"},"sp":{"name":"Mayores"},"nl":{"name":"Senioren"}},"value":9},{"translations":{"de":{"name":"Article 27"},"pt":{"name":"Article 27"},"en":{"name":"Article 27"},"it":{"name":"Article 27"},"cn":{"name":"Article 27"},"fr":{"name":"Article 27"},"sp":{"name":"Article 27"},"nl":{"name":"Artikel 27"}},"value":1.25}],"date_exceptions":[],"closing_days":[],"child_events":[],"parent_events":[],"accessibilities":[],"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":["exterior"]},{"id":5700003496,"date_start":"2024-11-23","date_end":"2024-11-24","date_next":"2024-11-23","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-11-12T13:52:03+01:00","published_at":"2024-11-12T08:49:49+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":311282,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"other","ranking":1,"languages":{"spoken":["es","en","it","fr"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[33,24],"translations":{"de":["Mode","Kunstgalerien"],"pt":[null,null],"en":["Fashion","Art Galleries"],"it":["Moda","Gallerie d'arte"],"cn":[null,null],"fr":["Mode","Galeries d'art"],"sp":["Moda","Galer\u00edas de arte"],"nl":["Mode","Galeries"]}}},"translations":{"de":{"name":"Jewels Exhibition","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/florencelanzmann.com","email":"florence.lanzmann@orange.fr","phone_contact":"0670846724","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700003496"},"pt":{"name":"Jewels Exhibition","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/florencelanzmann.com","email":"florence.lanzmann@orange.fr","phone_contact":"0670846724","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700003496"},"en":{"name":"Jewels Exhibition, archaeological pieces","shortdescr":"Creation of rare jewels, from antiquities and archaeological fragments : Egyptian amulets, Greco-Roman intaglios, coins, cameos, from prestigious European collections, whose authenticity, provenance and dating have been established. Each piece of jewelry has survived the centuries, and is unique and exclusive, at once antique and resolutely contemporary in form.","longdescr":"\nI make jewelry from antiques : Egyptian amulets, Greco-Roman intaglios, coins, cameos, from prestigious European collections, whose authenticity, provenance and dating have been established. Most come from ancient civilizations - Greece, Egypt, Babylon, Rome - and are all between a few centuries and three thousand years old. Each ring, pendant or bracelet is unique and exclusive, hand-mounted and created according to the rules of the art, with traditional know-how that preserves the integrity and beauty of these archaeological fragments from the mists of time.","performers":"\nFlorence Lanzmann","boxoffice_url":null,"website":"https:\/\/florencelanzmann.com","email":"florence.lanzmann@orange.fr","phone_contact":"0670846724","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700003496"},"it":{"name":"Jewels Exhibition","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/florencelanzmann.com","email":"florence.lanzmann@orange.fr","phone_contact":"0670846724","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700003496"},"cn":{"name":"Jewels Exhibition","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/florencelanzmann.com","email":"florence.lanzmann@orange.fr","phone_contact":"0670846724","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700003496"},"fr":{"name":"Exposition de bijoux uniques","shortdescr":"Cr\u00e9ation de bijoux rares, \u00e0 partir d'antiquit\u00e9s et de fragments arch\u00e9ologiques : des amulettes \u00e9gyptiennes, des intailles gr\u00e9co-romaines, des monnaies, des cam\u00e9es, issus de prestigieuses collections europ\u00e9ennes, dont l'authenticit\u00e9, la provenance et la datation sont \u00e9tablis. Chaque bijou a travers\u00e9 les si\u00e8cles, il est unique et exclusif, \u00e0 la fois antique et r\u00e9solument contemporain dans sa forme.","longdescr":"Je r\u00e9alise des bijoux \u00e0 partir d'antiquit\u00e9s : amulettes \u00e9gyptiennes, intailles gr\u00e9co-romaines, monnaies, cam\u00e9es, issus de prestigieuses collections europ\u00e9ennes, dont l'authenticit\u00e9, la provenance et la datation sont \u00e9tablis. La plupart proviennent de civilisations antiques, Gr\u00e8ce, Egypte, Babylone, Rome, et ont toutes entre quelque si\u00e8cles et trois mille ans. Chaque bague, pendentif, ou bracelet, est unique et exclusif, mont\u00e9 \u00e0 la main et cr\u00e9\u00e9 dans les r\u00e8gles de l'art, avec un savoir faire traditionnel, qui pr\u00e9serve l'int\u00e9grit\u00e9 et la beaut\u00e9 de ces fragments arch\u00e9ologiques issus de la nuit des temps.","performers":null,"boxoffice_url":null,"website":"https:\/\/florencelanzmann.com","email":"florence.lanzmann@orange.fr","phone_contact":"0670846724","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700003496"},"sp":{"name":"Jewels Exhibition","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/florencelanzmann.com","email":"florence.lanzmann@orange.fr","phone_contact":"0670846724","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700003496"},"nl":{"name":"Tentoonstelling van unieke sieraden","shortdescr":"Wij maken zeldzame sieraden van antiquiteiten en archeologische fragmenten: Egyptische amuletten, Grieks-Romeinse intaglio's, munten en cameo's uit prestigieuze Europese collecties, waarvan de authenticiteit, herkomst en datering zijn vastgesteld. Elk sieraad heeft de eeuwen overleefd en is uniek en exclusief, zowel antiek als resoluut hedendaags van vorm.","longdescr":"Ik maak sieraden van antiek: Egyptische amuletten, Grieks-Romeinse intaglio's, munten en camee\u00ebn uit prestigieuze Europese collecties, waarvan de authenticiteit, herkomst en datering zijn vastgesteld. De meeste komen uit oude beschavingen - Griekenland, Egypte, Babylon en Rome - en zijn allemaal tussen een paar eeuwen en drieduizend jaar oud. Elke ring, hanger of armband is uniek en exclusief, met de hand gemonteerd en gemaakt volgens de regels van de kunst, met behulp van traditionele knowhow die de integriteit en schoonheid van deze archeologische fragmenten uit de nevelen der tijd bewaart.","performers":null,"boxoffice_url":null,"website":"https:\/\/florencelanzmann.com","email":"florence.lanzmann@orange.fr","phone_contact":"0670846724","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700003496"}},"place":{"id":277289,"translations":{"de":{"name":"La Nombreuse","address_street_name":"Rue du Fort","address_street_number":"42","address_street_box":null,"email":null,"website":"https:\/\/www.instagram.com\/lanombreuse\/","phone_contact":null,"phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue du Fort, 42","address_line2":"1060 Saint-Gilles","description_web":null,"description_prin