/agenda\/event-detail.50005698"},"pt":{"name":"Shabo et Benji Lali - OPTIMISTE et OISEAU DE NUIT","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lejardindemasoeur.be\/","email":"lejardindemasoeur@skynet.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50005698"},"en":{"name":"Shabo et Benji Lali - OPTIMISTE et OISEAU DE NUIT","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lejardindemasoeur.be\/","email":"lejardindemasoeur@skynet.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50005698"},"it":{"name":"Shabo et Benji Lali - OPTIMISTE et OISEAU DE NUIT","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lejardindemasoeur.be\/","email":"lejardindemasoeur@skynet.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50005698"},"cn":{"name":"Shabo et Benji Lali - OPTIMISTE et OISEAU DE NUIT","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lejardindemasoeur.be\/","email":"lejardindemasoeur@skynet.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50005698"},"fr":{"name":"Shabo et Benji Lali - OPTIMISTE et OISEAU DE NUIT","shortdescr":"Shabo et Benji Lali partagent la sc\u00e8ne le temps d'un soir pour pr\u00e9senter leurs cr\u00e9ations : \"Optimisme\" et \"Oiseau de Nuit\"...","longdescr":"R\u00e9solument optimiste, Joyeusement m\u00e9lancolique, Shabo entrem\u00eale les genres pour partager une chanson fran\u00e7aise pop travers\u00e9e par la musique classique. Elle nous entra\u00eene dans un monde o\u00f9 humour et gravit\u00e9, tendresse et lucidit\u00e9 se r\u00e9pondent. Apr\u00e8s avoir tourn\u00e9 dans une formule aux sonorit\u00e9s acoustiques (contrebasse, guitare, violon), Benji Lali et Fran\u00e7ois Willemaers(fondateur du groupe Pop-Rok \u201c Va \u00e0 la plage\u201d) ont voulu se lancer dans une nouvelle aventure. Un \u00e9clectisme sonore au service de textes gorg\u00e9s d\u2019humour, de sensibilit\u00e9, tant\u00f4t r\u00e9alistes, tant\u00f4t imag\u00e9s, des chansons qui nous touchent par leur humanit\u00e9. Les deux artistes partageront la sc\u00e8ne au Jardin de ma S\u0153ur. \u2013 Concert \u00e0 20h45. \u00c9tablissement ouvert \u00e0 partir de 20h00-20h10.","performers":"Shabo (chant, guitare \u00e9lectrique, paroles, compositions); Benji Lali (chant, guitare, paroles, compositions); Fran\u00e7ois Willemaers (guitares, programmations \u00e9lectroniques); Daniel Vincke (Guitare, Bass)","boxoffice_url":null,"website":"https:\/\/www.lejardindemasoeur.be\/","email":"lejardindemasoeur@skynet.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50005698"},"sp":{"name":"Shabo et Benji Lali - OPTIMISTE et OISEAU DE NUIT","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lejardindemasoeur.be\/","email":"lejardindemasoeur@skynet.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50005698"},"nl":{"name":"Shabo et Benji Lali - OPTIMISTE et OISEAU DE NUIT","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lejardindemasoeur.be\/","email":"lejardindemasoeur@skynet.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50005698"}},"place":{"id":220283,"translations":{"de":{"n