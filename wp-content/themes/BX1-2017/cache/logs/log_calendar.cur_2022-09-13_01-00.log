"start":"14:00:00","end":"18:00:00"},{"day":"2024-01-06","doors":null,"start":"14:00:00","end":"18:00:00"}],"recurring":[{"day":"monday","occurences":{"is_first":true,"is_second":false,"is_third":false,"is_fourth":false,"is_last":false},"time_start":"15:00:00","time_end":"19:00:00","translations":{"fr":"Ouvert le premier lundi du mois de 15:00 \u00e0 19:00","nl":"Open op de eerste maandag van de maand van 15:00 tot 19:00","en":"Open the first monday of the month from 15:00 to 19:00"}},{"day":"wednesday","occurences":{"is_first":true,"is_second":true,"is_third":false,"is_fourth":false,"is_last":false},"time_start":"14:00:00","time_end":"18:00:00","translations":{"fr":"Ouvert les premier et deuxi\u00e8me mercredis du mois de 14:00 \u00e0 18:00","nl":"Open op de eerste en tweede woensdags van de maand van 14:00 tot 18:00","en":"Open the first and second wednesdays of the month from 14:00 to 18:00"}},{"day":"friday","occurences":{"is_first":true,"is_second":true,"is_third":true,"is_fourth":false,"is_last":false},"time_start":"14:00:00","time_end":"18:00:00","translations":{"fr":"Ouvert les premier, deuxi\u00e8me et troisi\u00e8me vendredis du mois de 14:00 \u00e0 18:00","nl":"Open op de eerste, tweede en derde vrijdags van de maand van 14:00 tot 18:00","en":"Open the first, second and third fridays of the month from 14:00 to 18:00"}},{"day":"saturday","occurences":{"is_first":true,"is_second":true,"is_third":true,"is_fourth":true,"is_last":false},"time_start":"14:00:00","time_end":"18:00:00","translations":{"fr":"Ouvert les premier, deuxi\u00e8me, troisi\u00e8me et quatri\u00e8me samedis du mois de 14:00 \u00e0 18:00","nl":"Open op de eerste, tweede, derde en vierde zaterdags van de maand van 14:00 tot 18:00","en":"Open the first, second, third and fourth saturdays of the month from 14:00 to 18:00"}},{"day":"sunday","occurences":{"is_first":true,"is_second":true,"is_third":true,"is_fourth":true,"is_last":true},"time_start":"09:00:00","time_end":"13:00:00","translations":{"fr":"Ouvert les premier, deuxi\u00e8me, troisi\u00e8me, quatri\u00e8me et dernier dimanches du mois de 09:00 \u00e0 13:00","nl":"Open op de eerste, tweede, derde, vierde en laatste zondags van de maand van 09:00 tot 13:00","en":"Open the first, second, third, fourth and last sundays of the month from 09:00 to 13:00"}}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":75},{"translations":{"fr":{"name":"Enfants"},"nl":{"name":"Kinderen"},"en":{"name":"Children"}},"value":45}],"child_events":[],"parent_events":[],"targets":{"list":[11,10,19,7,8,16],"translations":{"fr":["Famille","Seniors","Enseignants","Jeunes 12-15 ans","Jeunes 15-18 ans","Ecoles"],"nl":["Familie","Senioren","Leerkrachten","Jongeren 12-15 j.","Jongeren 15-18 j.","Scholen"],"en":["Family","Seniors","Teachers","Youth 12-15  yr.","Youth 15-18  yr.","Schools"]}},"tags":["kids"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-09-12T01:05:54+02:00","published_at":"2021-06-16T12:32:30+02:00","backoffice_id":233441,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.10233859542617},{"id":536415,"date_start":"2022-09-15","date_end":"2022-09-15","date_next":"2022-09-15","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert"}},"others":{"list":[4,7],"translations":{"fr":["Pop, rock, jazz\u2026","Pop, Rock"],"nl":["Pop, rock, jazz\u2026","Pop, Rock"],"en":["Pop, rock, jazz\u2026","Pop, Rock"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"And Also The Trees - The Ultimate Dreamers","shortdescr":"Le groupe britannique post-punk culte","longdescr":"And Also The Trees s'est form\u00e9 en 1980 dans la campagne du Worcestershire, en Angleterre, un environnement qui a \u00e9t\u00e9 pour le groupe de post-punk une source constante d'inspiration. R\u00e9put\u00e9s pour leurs performances live captivantes et leur style sans \u00e9quivalent de mandoline comme guitare \u00e9lectrique, ils d\u00e9livrent des textes po\u00e9tiques sur fond de jazz sombre. \u00c0 leurs d\u00e9buts, ils ont attir\u00e9 l'attention de Robert Smith qui les a invit\u00e9s \u00e0 tourner \u00e0 plusieurs reprises avec The Cure et qui, avec Lol Tolhurst, a supervis\u00e9 et produit leurs premiers enregistrements post-punk. Depuis lors, la formation n'a cess\u00e9 d'exister, avec quatorze albums \u00e0 son actif, de nombreuses tourn\u00e9es dans la plupart des pays europ\u00e9ens ainsi qu'aux \u00c9tats-Unis et au Japon, o\u00f9 elle est devenue un groupe culte. And Also The Trees a r\u00e9cemment r\u00e9\u00e9dit\u00e9 ce qui est peut-\u00eatre son album le plus populaire, \u00ab Virus Meadow \u00bb, paru en 1986 sur Reflex Records.\r\n\r\nTHE ULTIMATE DREAMERS\r\n\r\nThe Ultimate Dreamers sortent d'un tr\u00e8s long sommeil en 2021. Leurs sonorit\u00e9s froides et organiques s\u2019ajustent en des m\u00e9lodies m\u00e9lancoliques, souvent accrocheuses et parfois dissonantes, servant de trame musicale \u00e0 des th\u00e8mes domin\u00e9s par le r\u00eave, la d\u00e9tresse amoureuse et la critique sociale. C'est \u00e0 la fin 2020 que des enregistrements r\u00e9alis\u00e9s de fa\u00e7on artisanale entre 1987 et 1990, en pleine adolescence, remontent \u00e0 la surface et sont port\u00e9s aux oreilles de Dimitri, patron du label Wool-E Discs. Il propose imm\u00e9diatement d\u2019en faire un album. Apr\u00e8s s\u00e9lection et mastering, 11 titres sont assembl\u00e9s pour former \"Live Happily While Waiting For Death\" qui sort le 26 septembre 2021. La magie est de retour. The Ultimate Dreamers reprennent vie avec un nouveau line-up et un r\u00e9pertoire actualis\u00e9. Tout en encha\u00eenant les concerts, le quatuor pr\u00e9pare un nouvel EP qui sera pr\u00e9c\u00e9d\u00e9 par un single le 1er octobre 2022.","performers":"And Also The Trees; The Ultimate Dreamers","boxoffice_url":null,"website":"http:\/\/www.botanique.be","email":"info@botanique.be","phone_contact":"+32 2 218 37 32","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.536415"},"nl":{"name":"And Also The Trees - The Ultimate Dreamers","shortdescr":null,"longdescr":"And Also The Trees werd in 1980 opgericht op het platteland van Worcestershire, Engeland, een omgeving die een voortdurende bron van inspiratie is geweest voor de post-punk band. Bekend om hun meeslepende live-optredens en hun unieke stijl waarbij ze mandoline als elektrische gitaar gebruiken, brengen ze po\u00ebtische teksten tegen een achtergrond van donkere jazz. In hun begindagen trokken zij de aandacht van Robert Smith, die hen uitnodigde om verschillende keren met The Cure op tournee te gaan en die, samen met Lol Tolhurst, hun eerste post-punk opnamen overzag en produceerde. Sindsdien is de band blijven bestaan, heeft ze veertien albums uitgebracht en is AATT uitgebreid gaan toeren in de meeste Europese landen en ook in de VS en Japan, waar ze een cultband zijn geworden. And Also The Trees hebben onlangs hun misschien wel populairste album, 'Virus Meadow', dat in 1986 op Reflex Records verscheen, opnieuw uitgebracht.\r\n\r\nTHE ULTIMATE DREAMERS\r\n\r\nThe Ultimate Dreamers ontwaken in 2021 na een lange winterslaap. Nummers die initieel tussen 1987 en 1990 geschreven werden, verschenen eindelijk officieel en worden nu ook voorgesteld naast nieuwe muziek in een even nieuwe line-up. Verwacht koude, organische sounds met een melancholisch randje.","performers":"And Also The Trees; The Ultimate Dreamers","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.536415"},"en":{"name":"And Also The Trees - The Ultimate Dreamers","shortdescr":null,"longdescr":"'And Also The Trees' formed in 1980 in rural Worcestershire, England, an environment that has provided a constant source of inspiration. They are known for their captivating live performances, their unique style of mandolin like electric guitar, poetic lyrics, dark jazz rhythms and their carefully preserved independence. In their early years they caught the attention of Robert Smith who invited them to tour with The Cure on several occasions and he, along with Lol Tolhurst oversaw and produced their early \u2018post-punk\u2019 recordings. Since then they have been in continuous existence releasing thirteen studio albums, touring frequently in most European countries and visiting America and Japan where they have a cult following. They have recently re-issued what is perhaps their best known 1986 LP \u2018Virus Meadow\u2019 and will release a new album in September 2022.","performers":"And Also The Trees; The Ultimate Dreamers","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.536415"},"de":{"name":"And Also The Trees - The Ultimate Dreamers","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.536415"},"it":{"name":"And Also The Trees - The Ultimate Dreamers","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.536415"},"sp":{"name":"And Also The Trees - The Ultimate Dreamers","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.536415"},"pt":{"name":"And Also The Trees - The Ultimate Dreamers","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.536415"},"cn":{"name":"And Also The Trees - The Ultimate Dreamers","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.536415"}},"place":{"id":11,"translations":{"fr":{"name":"Botanique","address_street_name":"Rue Royale","address_street_number":"236","address_street_box":null,"email":"info@botanique.be","website":"http:\/\/www.botanique.be","phone_contact":"+32 2 218 37 32","phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Royale, 236","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"L\u2019\u00e9l\u00e9gant Centre Culturel de la Communaut\u00e9 fran\u00e7aise est joliment situ\u00e9 dans les anciens jardins botaniques pr\u00e8s de la petite ceinture de Bruxelles. Vous pouvez assister \u00e0 des concerts dans les espaces intimes \u00e0 l\u2019ambiance chaleureuse, dont  les plus connus sont l\u2019Orangerie, la Rotonde, le Mus\u00e9e et le Witloof Bar. \r\n\r\n","description_print":"","booking_url":null,"sort_order":"BOTANIQUE","virtual_visit":null},"nl":{"name":"Botanique","address_street_name":"Koningsstraat","address_street_number":"236","address_street_box":null,"email":"info@botanique.be","website":"http:\/\/www.botanique.be","phone_contact":"+32 2 218 37 32","phone_booking":null,"address_zip":"1210","address_city":"Sint-Joost-Ten-Node","address_line1":"Koningsstraat, 236","address_line2":"1210 Sint-Joost-Ten-Node","description_web":"In de voormalige botanische tuinen aan de kleine ring, thans het klassevolle cultuurcentrum van de Franse Gemeenschap, is het goed toeven. Concerten vinden er plaats op een unieke locatie, in sfeervolle en intieme ruimtes. De kwalitatieve eclectische programmatie staat zeer open voor nieuwe trends.","description_print":"","booking_url":null,"sort_order":"BOTANIQUE","virtual_visit":null},"en":{"name":"Botanique","address_street_name":"Rue Royale","address_street_number":"236","address_street_box":null,"email":"info@botanique.be","website":"http:\/\/www.botanique.be","phone_contact":"+32 2 218 37 32","phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Royale, 236","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"The former botanical gardens provide the unique location for the stylish cultural centre of the French community and are a great place to relax. Concerts are held in the intimate surroundings of its eight spaces and multipurpose halls, of which the most famous are the Orangerie, the Rotonde, the Museum, and the Witloof Bar.\r\n","description_print":"","booking_url":null,"sort_order":"BOTANIQUE","virtual_visit":null},"de":{"name":"Botanique","address_street_name":"Rue Royale","address_street_number":"236","address_street_box":null,"email":"info@botanique.be","website":"http:\/\/www.botanique.be","phone_contact":"+32 2 218 37 32","phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Royale, 236","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"Le Botanique z\u00e4hlt ohne Zweifel zu den sch\u00f6nsten und spektakul\u00e4rsten Veranstaltungsorten Br\u00fcssels. Das von 1826 bis 1829 von der \u201eSoci\u00e9t\u00e9 Royale d'Horticulture\u201c erbaute, ehemalige Gew\u00e4chshaus im neoklassizistischen Stil mit Eisen- und Glasarchitektur beherbergt seit 1984 einen hochkar\u00e4tigen Veranstaltungsort.\r\n\r\nInmitten des botanischen Gartens von Saint-Josse-ten-Noode, einer der 19 Br\u00fcsseler Gemeinden, w\u00e4chst und gedeiht heute ein quicklebendiger Ort der Kultur, der vor allem f\u00fcr Musikveranstaltungen, als Galerie und Caf\u00e9 genutzt wird. H\u00f6hepunkt des Jahres bildet im Fr\u00fchling das Musikfestival \u201eLes Nuits Botaniques\".","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Botanique","address_street_name":"Rue Royale","address_street_number":"236","address_street_box":null,"email":"info@botanique.be","website":"http:\/\/www.botanique.be","phone_contact":"+32 2 218 37 32","phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Royale, 236","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"Questo grande edificio, che doveva ospitare le collezioni di un precedente giardino botanico, \u00e8 stato costruito fra il 1826 ed il 1829. L'artista-arredatore Pierre-Fran\u00e7ois Gineste diresse i lavori secondo progetto dell'architetto Tilman-Fran\u00e7ois Suys. Rispettando la struttura tradizionale degli aranceti, ha immaginato un'imponente cupola rotonda centrale, affiancata da due ali ciascuna delle quali terminante in un padiglione leggermente sporgente. Grazie alla sua regolarit\u00e0 e semplicit\u00e0, la costruzione illustra perfettamente i principi dello stile neoclassico. Alle vetrate che riempiono gli spazi tra le colonne della sala circolare e che coprono il portico delimitato dal colonnato stesso, si aggiungono le serre adiacenti alle ali laterali. Inizialmente si era pensato di organizzare feste all'interno di questo ambiente magico, e a questo scopo venne allestita una grande sala fra l'aranceto orientale e la sala rotonda, ma questa diventer\u00e0 poi la sala degli erbari dal 1870. Fino al 1939, l'edificio verr\u00e0 utilizzato per il suo scopo originale. Riacquistato dallo Stato nel 1970, il locale diventer\u00e0 il Centro Culturale della Federazione Vallonia-Bruxelles e verr\u00e0 inaugurato come tale nel 1984. Oggi ospita numerosi eventi culturali dedicati all'arte contemporanea e vi si svolgono festival, tra i quali il famoso Nuits du Botanique, che hanno contribuito ad affermare la sua reputazione. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Botanique","address_street_name":"Rue Royale","address_street_number":"236","address_street_box":null,"email":"info@botanique.be","website":"http:\/\/www.botanique.be","phone_contact":"+32 2 218 37 32","phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Royale, 236","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"Este enorme edificio, pensado para albergar las colecciones de un antiguo jard\u00edn bot\u00e1nico, fue construido entre 1826 y 1829. El artista-decorador Pierre-Fran\u00e7ois Gineste dirigi\u00f3 las obras a partir de los planos del arquitecto Tilman-Fran\u00e7ois Suys. Respetando la estructura tradicional de los invernaderos de naranjas, imagin\u00f3 una imponente rotonda central con c\u00fapula flanqueada por dos pasillos que terminaban en un pabell\u00f3n ligeramente en relieve. Gracias a su regularidad y simplicidad, la elevaci\u00f3n ilustra a la perfecci\u00f3n los principios del estilo neocl\u00e1sico. Las vidrieras situadas en los intercolumnios de la rotonda y que cubren el p\u00f3rtico delimitado por esta misma columnata se suman a los invernaderos adosados a los pasillos laterales. Pronto se pens\u00f3 en organizar fiestas en este lugar m\u00e1gico, para lo cual se acondicion\u00f3 una sala entre el invernadero de naranjas oriental y la rotonda, pero a partir de 1870 se convirti\u00f3 en la sala de los herbarios. Hasta 1939 cumpli\u00f3 las funciones teniendo en cuenta su vocaci\u00f3n inicial. Recomprado por el Estado en 1970, el lugar se convirti\u00f3 en el centro cultural de la Federaci\u00f3n Valonia-Bruselas y se inaugur\u00f3 como tal en 1984. A d\u00eda de hoy este lugar alberga numerosas manifestaciones culturales dedicadas a la creaci\u00f3n contempor\u00e1nea y se ha vuelto prestigioso por los festivales que se celebran en \u00e9l, tales como las \u00abNoches del bot\u00e1nico\u00bb. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Botanique","address_street_name":"Rue Royale","address_street_number":"236","address_street_box":null,"email":"info@botanique.be","website":"http:\/\/www.botanique.be","phone_contact":"+32 2 218 37 32","phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Royale, 236","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Botanique","address_street_name":"Rue Royale","address_street_number":"236","address_street_box":null,"email":"info@botanique.be","website":"http:\/\/www.botanique.be","phone_contact":"+32 2 218 37 32","phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Royale, 236","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[15],"translations":{"fr":["Rogier"],"nl":["Rogier"],"en":["Rogier"]}},"zones":{"list":[20],"translations":{"fr":["Nord"],"nl":["Noord"],"en":["North"]}},"neca":"art_center","facebook_id":null,"backoffice_id":5,"location":{"lat":50.85461438,"lon":4.36620044},"region":"brussels","last_updated_at":"2022-08-10T22:05:43+02:00","published_at":"2013-10-19T01:13:13+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":11,"translations":{"fr":{"name":"Botanique","address_street_name":"Rue Royale","address_street_number":"236","address_street_box":null,"email":"info@botanique.be","website":"http:\/\/www.botanique.be",