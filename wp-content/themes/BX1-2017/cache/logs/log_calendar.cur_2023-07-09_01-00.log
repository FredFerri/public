:null},"it":{"title":"kwb Dialoog picknick ","copyright":null},"sp":{"title":"kwb Dialoog picknick ","copyright":null},"pt":{"title":"kwb Dialoog picknick ","copyright":null},"cn":{"title":"kwb Dialoog picknick ","copyright":null}}}],"dates":[{"day":"2023-07-09","doors":"11:45:00","start":"12:00:00","end":"16:00:00","is_soldout":false,"is_canceled":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[11,10],"translations":{"fr":["Famille","Seniors"],"nl":["Familie","Senioren"],"en":["Family","Seniors"],"de":["Familie","Senioren"],"it":["Famiglie","Anziani"],"sp":["Familias","Personas de la tercera edad"],"pt":[null,null],"cn":[null,null]}},"tags":["exterior","kids"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-06-26T12:05:23+02:00","published_at":"2023-06-26T11:57:46+02:00","backoffice_id":280383,"import_origin":null,"sub_type":"misc","show_in_agenda":true,"ranking":1.2599210498949},{"id":559973,"date_start":"2023-07-09","date_end":"2023-07-09","date_next":"2023-07-09","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen","it":"Visite guidate","sp":"Visitas guiadas","pt":null,"cn":null}},"others":{}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Visite guid\u00e9e en langue des signes francophone (LSF) | Magritte & Spilliaert","shortdescr":"Le dimanche 9 juillet 2023 \u00e0 15:00, nous organisons une visite guid\u00e9e en langue des signes pour les publics sourds et malentendants.","longdescr":"En 1953, il y a 70 ans, les Mus\u00e9es faisaient l\u2019acquisition du tableau Le retour, peint par Magritte au retour d\u2019un rapide aller-retour vers Carcassonne en France, invit\u00e9 par ses amis surr\u00e9alistes ayant propos\u00e9 au couple Magritte de les rejoindre pour retrouver un peu de s\u00e9r\u00e9nit\u00e9 pendant ces temps troubl\u00e9s et angoissants. Pas de chance! Georgette doit subir une op\u00e9ration urgente. \r\n\r\nAu retour de ce voyage pr\u00e9cipit\u00e9, Ren\u00e9 nous offre l\u2019apaisement, la s\u00e9r\u00e9nit\u00e9 et le myst\u00e8re de cet oiseau travers\u00e9 par les nuages et planant au-dessus de ce nid insolite et merveilleux, retrouv\u00e9 avec bonheur par l\u2019artiste surr\u00e9aliste.\r\n\r\nLe mus\u00e9e Magritte fait peau neuve! Entretemps, venez red\u00e9couvrir ses nombreuses \u0153uvres dans une nouvelle pr\u00e9sentation au -3 et -4 de la Place du Mus\u00e9e et (re)d\u00e9couvrir aussi son pr\u00e9d\u00e9cesseur, L\u00e9on Spilliaert, un artiste symboliste tout aussi myst\u00e9rieux!","performers":"Visite guid\u00e9e en langue des signes francophone (LSF)\r\nMagritte & Spilliaert\r\npar Fabienne Cauwe","boxoffice_url":null,"website":"http:\/\/www.fine-arts-museum.be","email":"info@fine-arts-museum.be","phone_contact":null,"phone_booking":"+32 2 508 33 33","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.559973"},"nl":{"name":"Visite guid\u00e9e en langue des signes francophone (LSF) | Magritte & Spilliaert","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.fine-arts-museum.be","email":"info@fine-arts-museum.be","phone_contact":null,"phone_booking":"+32 2 508 33 33","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.559973"},"en":{"name":"Visite guid\u00e9e en langue des signes francophone (LSF) | Magritte & Spilliaert","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.fine-arts-museum.be","email":"info@fine-arts-museum.be","phone_contact":null,"phone_booking":"+32 2 508 33 33","