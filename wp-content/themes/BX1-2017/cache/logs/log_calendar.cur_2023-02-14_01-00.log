1:00","backoffice_id":270882,"import_origin":null,"sub_type":"party","show_in_agenda":true,"ranking":0.7937005259841},{"id":550420,"date_start":"2023-02-18","date_end":"2023-03-05","date_next":"2023-02-18","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung","it":"Esposizioni","sp":"Exhibici\u00f3n","pt":null,"cn":null}},"others":{"list":[36,46],"translations":{"fr":["Mus\u00e9es et art centers","Pluridisciplinaire"],"nl":["Musea en kunstcentra","Multidisciplinair"],"en":["Museums and art centers","Multidisciplinary"],"de":["Museen & Kunstzentren","Multidisziplin\u00e4r"],"it":["Musei e centri artistici","Multidisciplinare"],"sp":["Museos y centros de arte","Multidisciplinar"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Carnaval en Folie !","shortdescr":"Le temps d\u2019un apr\u00e8s-midi, (re)vivez l\u2019aventure \u00ab Des Ailes pour Grandir \u00bb, l\u2019exposition ludique et interactive du Mus\u00e9e des Enfants : 5 salles \u00e0 d\u00e9couvrir, parents-enfants ensemble.","longdescr":"Le temps d\u2019un apr\u00e8s-midi, (re)vivez l\u2019aventure \u00ab Des Ailes pour Grandir \u00bb, l\u2019exposition ludique et interactive du Mus\u00e9e des Enfants : 5 salles \u00e0 d\u00e9couvrir, parents-enfants ensemble.\r\n\r\nF\u00eatons ensemble le retour du printemps en musique ! Deviens un chef d\u2019orchestre au th\u00e9\u00e2tre, fabrique ta machine \u00e0 musique avec Emile, raconte avec nous l\u2019histoire d\u2019un instrument enchant\u00e9, et cuisine une symphonie de biscuits ! \r\n\r\nOuvert tous les jours du 18\/02 au 05\/03 mars, de 14:30 \u00e0 17:00 \r\nSauf 27 et 28 f\u00e9vrier : event sp\u00e9cial \u00e9coles n\u00e9erlandophones.\r\n\r\nAttention : d\u00e9guisements fortement conseill\u00e9s !","performers":null,"boxoffice_url":null,"website":"http:\/\/www.museedesenfants.be","email":"info@childrenmuseum.be","phone_contact":null,"phone_booking":"+32 2 640 01 07","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.550420"},"nl":{"name":"Carnavalsgekte !","shortdescr":"(Her)beleef een middag lang het avontuur van \"Vleugels om te Groeien\", de ludieke en interactieve tentoonstelling van het Kindermuseum: 5 zalen om te ontdekken, ouders en kinderen samen.","longdescr":"(Her)beleef een middag lang het avontuur van \"Vleugels om te Groeien\", de ludieke en interactieve tentoonstelling van het Kindermuseum: 5 zalen om te ontdekken, ouders en kinderen samen.\r\n\r\nLaten we de terugkeer van de lente vieren met muziek! Word orkestleider in het theater, bouw je eigen muziekmachine met Emile, vertel ons het verhaal van een betoverd instrument en kook een symfonie van koekjes! \r\n\r\nDagelijks geopend van 18\/02 tot 05\/03 maart, van 14:30 tot 17:00 uur. \r\nBehalve 27 en 28 februari: speciaal evenement voor Nederlandstalige scholen.\r\n\r\nAttentie: vermommingen sterk aanbevolen!","performers":null,"boxoffice_url":null,"website":"http:\/\/www.kindermuseum.be","email":"info@childrenmuseum.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.550420"},"en":{"name":"Carnaval en Folie !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.museedesenfants.be","email":"info@childrenmuseum.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.550420"},"de":{"name":"Carnaval en Folie !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.museedesenfants.be","email":"info@childrenmuseum.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.550420"},"it":{"name":"Carnaval en Folie !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.museedesenfants.be","email":"info@childrenmuseum.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.550420"},"sp":{"name":"Carnaval en Folie !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.museedesenfants.be","email":"info@childrenmuseum.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.550420"},"pt":{"name":"Carnaval en Folie !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.museedesenfants.be","email":"info@childrenmuseum.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.550420"},"cn":{"name":"Carnaval en Folie !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.museedesenfants.be","email":"info@childrenmuseum.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.550420"}},"place":{"id":207541,"translations":{"fr":{"name":"Mus\u00e9e des Enfants","address_street_name":"Rue du Bourgmestre","address_street_number":"15","address_street_box":null,"email":"info@childrenmuseum.be","website":"http:\/\/www.museedesenfants.be","phone_contact":"+32 2 640 01 07","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue du Bourgmestre, 15","address_line2":"1050 Ixelles","description_web":"Le Mus\u00e9e des Enfants est pionnier en Europe. \r\nInstall\u00e9 dans une magnifique maison appartenant \u00e0 la commune d\u2019Ixelles, le mus\u00e9e dispose de 600m\u00b2 d\u2019exposition. Dans cet espace d\u2019\u00e9ducation par le jeu, pas d\u2019ordinateur ni de console vid\u00e9o, mais des d\u00e9cors, des jeux en bois et des mises en situation qui permettent \u00e0 l\u2019enfant de d\u00e9couvrir et d\u2019approfondir la connaissance de soi et du monde qui l\u2019entoure. Chaque exposition se veut participative et ludique, avec un accent important mis sur le dialogue parents-enfants. Il s'agit \u00e0 chaque fois d'une cr\u00e9ation et d'une r\u00e9alisation enti\u00e8rement originale de l\u2019\u00e9quipe du Mus\u00e9e des Enfants, conseill\u00e9e par de nombreux sp\u00e9cialistes tel que p\u00e9dopsychiatres et psychologues.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Kindermuseum","address_street_name":"Burgemeestersstraat","address_street_number":"15","address_street_box":null,"email":"info@childrenmuseum.be","website":"http:\/\/www.kindermuseum.be","phone_contact":"+32 2 640 01 07","phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"Burgemeestersstraat, 15","address_line2":"1050 Elsene","description_web":"Het Kindermuseum is een ware Europese pionnier. \r\nGevestigd in een prachtig herenhuis met een totale tentoonstellingsoppervlakte van 600 m\u00b2 illustreert het Kindermuseum door middel van haar tentoonstellingen en activiteiten de filosofie dat voor de vorming en ontwikkeling van een goede wereldori\u00ebntatie de participatieve en psychologische dimensie echt wezenlijk is. In deze ruimtes vind je nochtans geen virtuele, noch hoogtechnologische snufjes: het kind wordt in een herkenbare en re\u00eble spelsituatie geplaatst dankzij de decors en de houten spelletjes die de zelfkennis, de kennis van de ander en van de omringende wereld stimuleren. Het Museum biedt ludieke tentoonstellingen aan waarin de deelname en de dialoog volwassene\/ouder-kinderen een zeer belangrijke rol spelen.  Bij het creatieproces van elke tentoonstelling wordt de raad ingewonnen van  externe specialisten zoals kinderartsen, -psychiaters en -psychologen.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Children\u2019s Museum","address_street_name":"rue du Bourgmestre","address_street_number":"15","address_street_box":null,"email":"info@childrenmuseum.be","website":"http:\/\/www.museedesenfants.be","phone_contact":"+32 2 640 01 07","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"rue du Bourgmestre, 15","address_line2":"1050 Ixelles","description_web":"Pioneer in Europe, The Children\u2019s Museum is located in a beautiful mansion which offers a 600m2 exhibition spaces. In this educational environment, where playing has a key role, you won\u2019t find computers nor video games. Stage settings and scenery, wooden toys, workshops are but some examples of the different means the Museum has put in place to help children in the discovery of the world that surrounds them, as well as themselves. Every exhibition is an exclusive creation that benefits from the guidance of various external specialists in different areas of the educational work fields.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Mus\u00e9e des Enfants - das Br\u00fcsseler Kindermuseum","address_street_name":"Rue du Bourgmestre","address_street_number":"15","address_street_box":null,"email":"info@childrenmuseum.be","website":"http:\/\/www.museedesenfants.be","phone_contact":"+32 2 640 01 07","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue du Bourgmestre, 15","address_line2":"1050 Ixelles","description_web":"Das Br\u00fcsseler Kindermuseum pr\u00e4sentiert in seinem stattlichen Herrenhaus in der Gemeinde Ixelles wechselnde thematische Ausstellungen f\u00fcr wissbegierige Kinder. Auf den 600 m\u00b2 Ausstellungsfl\u00e4che gibt es ganz sicher weder Computer noch Spielekonsolen, daf\u00fcr aber Holzspiele und spannende Installationen, die die Neugierde anregen und den Entdeckergeist wecken. Das Konzept, das - in Zusammenarbeit mit Kinderpsychologen - von dem Kindermuseum selbst entwickelt wurde, legt ein besonderes Augenmerk auf den Dialog zwischen Eltern und Kindern.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Il Museo del Bambini di Bruxelles","address_street_name":"rue du Bourgmestre","address_street_number":"15","address_street_box":null,"email":"info@childrenmuseum.be","website":"http:\/\/www.museedesenfants.be","phone_contact":"+32 2 640 01 07","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"rue du Bourgmestre, 15","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"El Museo de los Ni\u00f1os de Bruselas","address_street_name":"rue du Bourgmestre","address_street_number":"15","address_street_box":null,"email":"info@childrenmuseum.be","website":"http:\/\/www.museedesenfants.be","phone_contact":"+32 2 640 01 07","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"rue du Bourgmestre, 15","address_line2":"1050 Ixelles","description_web":"Pionero en europa, el Museo de los Ni\u00f1os se sit\u00faa en una bella mansi\u00f3n que ofrece unos 600m\u00b2 de espacios de exhibici\u00f3n. En un ambiente educativo, donde jugar tiene un papel clave, no encontramos ni ordenadores ni videojuegos. Escenarios y decorados esc\u00e9nicos, mu\u00f1ecos de madera o talleres son s\u00f3lo algunas de la herramientas que el museo utiliza para ayudar a los ni\u00f1os a descubrir el mundo que les rodea, as\u00ed como a ellos mismos. Cada exhibici\u00f3n es una creaci\u00f3n exclusiva que se beneficia de la orientaci\u00f3n de varios especialistas de diferentes \u00e1reas de los campos del trabajo educativo.","description_print":"","booking_url":null,"sort_ord