ier210.be","phone_contact":"+32 2 732 25 98","phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Sint-Pieterssteenweg, 210","address_line2":"1040 Etterbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":null,"facebook_id":"163824988877","region":"brussels","backoffice_id":4376,"location":{"lat":50.83708517,"lon":4.39159259},"last_updated_at":"2023-09-21T14:58:58+02:00","published_at":"2013-10-19T01:17:19+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"poster","link":"https:\/\/agendabrussels2.imgix.net\/be7984af77abc5a852e02885cf4732fd9d28265c.png","width":1072,"height":1512,"ratio":0.71,"oEmbed_height":1512,"oEmbed_width":1072,"translations":{"de":{"title":"Blackout Session : Alan Vega et Martin Rev (1980) ","copyright":null},"pt":{"title":"Blackout Session : Alan Vega et Martin Rev (1980) ","copyright":null},"en":{"title":"Blackout Session : Alan Vega et Martin Rev (1980) ","copyright":null},"it":{"title":"Blackout Session : Alan Vega et Martin Rev (1980) ","copyright":null},"cn":{"title":"Blackout Session : Alan Vega et Martin Rev (1980) ","copyright":null},"fr":{"title":"Blackout Session : Alan Vega et Martin Rev (1980) ","copyright":null},"sp":{"title":"Blackout Session : Alan Vega et Martin Rev (1980) ","copyright":null},"nl":{"title":"Blackout Session : Alan Vega et Martin Rev (1980) ","copyright":null}}}],"dates":[{"day":"2024-03-26","doors":"19:30:00","start":"20:30:00","end":null,"end_night_life":null,"is_soldout":false,"is_canceled":false}],"prices":[],"date_exceptions":[],"closing_days":[],"child_events":[],"parent_events":[],"accessibilities":[],"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[]},{"id":50007180,"date_start":"2024-03-26","date_end":"2024-03-26","date_next":"2024-03-26","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":true,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-02-12T18:00:03+01:00","published_at":"2024-02-12T17:53:09+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":294387,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"misc","ranking":1.2599210498948732,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":84,"translations":{"de":"Verschiedenes","pt":null,"en":"Various","it":"Varie","cn":null,"fr":"Divers","sp":"Varios","nl":"Varia"}},"others":{"list":[89],"translations":{"de":["Literatur"],"pt":[null],"en":["Litterature "],"it":["Letteratura"],"cn":[null],"fr":["Litt\u00e9rature"],"sp":["Literatura"],"nl":["Literatuur"]}}},"translations":{"de":{"name":"Rencontre avec Neige Sinno","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.passaporta.be\/fr\/calendrier\/rencontre-avec-neige-sinno","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50007180"},"pt":{"name":"Rencontre avec Neige Sinno","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.passaporta.be\/fr\/calendrier\/rencontre-avec-neige-sinno","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50007180"},"en":{"name":"Rencontre avec Neige Sinno","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.passaporta.be\/fr\/calendrier\/rencontre-avec-neige-sinno","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50007180"},"it":{"name":"Rencontre avec Neige Sinno","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.passaporta.be\/fr\/calendrier\/rencontre-avec-neige-sinno","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50007180"},"cn":{"name":"Rencontre avec Neige Sinno","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.passaporta.be\/fr\/calendrier\/rencontre-avec-neige-sinno","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50007180"},"fr":{"name":"Rencontre avec Neige Sinno","shortdescr":"Avec \"Triste tigre\", impressionnant r\u00e9cit d'un inceste et de ses cons\u00e9quences, Neige Sinno a \u00e9crit un livre qui fera date. Apr\u00e8s notamment le Prix Femina, le prix litt\u00e9raire du Monde ou le prix des Inrockuptibles, elle re\u00e7oit le choix Goncourt de la Belgique. Soir\u00e9e exceptionnelle.","longdescr":"N\u00e9e en France, Neige Sinno vit aujourd\u2019hui au Mexique. A l\u2019occasion de la remise du Prix Goncourt de la Belgique \u00e0 \"Triste Tigre\", elle a accept\u00e9 de r\u00e9pondre par \u00e9cran interpos\u00e9 aux questions de l\u2019autrice Myriam Leroy. Son \u00e9diteur Fr\u00e9d\u00e9ric Boyer sera pr\u00e9sent sur sc\u00e8ne pour apporter le regard de la maison P.O.L., qui a \u00e9dit\u00e9 ce livre exceptionnel.\n\nDepuis 2016, la Belgique a son Choix Goncourt. \u00c9manation \u00ab \u00e0 l\u2019\u00e9tranger \u00bb du plus c\u00e9l\u00e8bre des prix litt\u00e9raires fran\u00e7ais, celui-ci est d\u00e9cern\u00e9 par des \u00e9tudiants et des \u00e9tudiantes d\u2019universit\u00e9s et hautes \u00e9coles francophones et n\u00e9erlandophones, sur base de la deuxi\u00e8me s\u00e9lection de l\u2019Acad\u00e9mie Goncourt. Cette ann\u00e9e, c\u2019est le livre \"Triste tigre\" de Neige Sinno qui a \u00e9t\u00e9 \u00e9lu au premier tour.\n\nNeige Sinno y raconte les viols qui lui ont \u00e9t\u00e9 inflig\u00e9s par son beau-p\u00e8re, de ses 7 \u00e0 ses 14 ans. Un r\u00e9cit d\u00e9chirant, sans pathos ni plainte. Neige Sinno nous y fait entrer dans la communaut\u00e9 de celles et ceux qui ont connu \u00ab\u202fl\u2019autre lieu\u202f\u00bb, celui de la nuit et du mal, qui ont pu s\u2019en extraire mais qui en sont \u00e0 jamais marqu\u00e9s, et se tiennent ainsi \u00e0 la fronti\u00e8re des t\u00e9n\u00e8bres et du jour. Nulle r\u00e9silience. Aucun oubli ni pardon. Juste tenter de tenir debout, \u00e9crire son r\u00e9cit comme une \u00ab\u202fpetite bombe artisanale qu\u2019on fait exploser tout seul chez soi, dans l\u2019intimit\u00e9 de la lecture. Elle a l\u2019intensit\u00e9 et la fragilit\u00e9 des choses con\u00e7ues dans la solitude et la col\u00e8re. Elle en a aussi la folle et ridicule ambition, qui est de faire voler ce monde en \u00e9clats.\u202f\u00bb\n\nApr\u00e8s une c\u00e9r\u00e9monie de remise de prix officielle \u00e0 l\u2019Ambassade de France en Belgique, Neige Sinno a accept\u00e9 de donner un entretien exceptionnel, depuis son jardin au Mexique. Elle sera accompagn\u00e9e, depuis Bruxelles, de son \u00e9diteur Fr\u00e9d\u00e9ric Boyer, et interrog\u00e9e par l\u2019autrice et journaliste Myriam Leroy (\"Les Yeux rouges\", \"Le Myst\u00e8re de la femme sans t\u00eate\").\n\nLe Choix Goncourt de la Belgique est une initiative conjointe de l\u2019Ambassade de France en Belgique, de la direction Europe de l\u2019Ouest de l\u2019Agence Universitaire de la Francophonie, de l\u2019Alliance fran\u00e7aise de Bruxelles-Europe et Passa Porta, avec le soutien de l\u2019Acad\u00e9mie Goncourt.\n\nOrg. Passa Porta en collaboration avec La Bellone","performers":null,"boxoffice_url":null,"website":"https:\/\/www.passaporta.be\/fr\/calendrier\/rencontre-avec-neige-sinno","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50007180"},"sp":{"name":"Rencontre avec Neige Sinno","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.passaporta.be\/fr\/calendrier\/rencontre-avec-neige-sinno","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50007180"},"nl":{"name":"Rencontre avec Neige Sinno","shortdescr":"Met \"Triste tigre\", een indrukwekkend verslag van incest en de gevolgen ervan, heeft Neige Sinno een baanbrekend boek geschreven. Na de Prix Femina, de Prix litt\u00e9raire du Monde en de Prix des Inrockuptibles, ontvangt ze nu ook de Prix Goncourt de la Belgique. Een uitzonderlijke avond.","longdescr":"Neige Sinno werd geboren in Frankrijk en woont nu in Mexico. Ter gelegenheid van de uitreiking van de Prix Goncourt de la Belgique voor \"Triste Tigre\", heeft ze ermee ingestemd om vragen van auteur Myriam Leroy te beantwoorden via een digitale verbinding. Haar uitgever Fr\u00e9d\u00e9ric Boyer zal op het podium aanwezig zijn om P.O.L., de uitgeverij van dit uitzonderlijke boek, te vertegenwoordigen.\n\nSinds 2016 heeft Belgi\u00eb zijn eigen \"Choix Goncourt\" Het is een \"buitenlands\" verlengstuk van de beroemdste literaire prijs van Frankrijk en wordt toegekend door studenten van Frans- en Nederlandstalige universiteiten en hogescholen, op basis van de tweede selectie van de Acad\u00e9mie Goncourt. Dit jaar werd het boek Triste tigre van Neige Sinno verkozen in de eerste ronde.\n\nNeige Sinno vertelt in het boek over de verkrachtingen door haar stiefvader, van haar zevende tot haar veertiende. Het is een hartverscheurend verslag, zonder pathos of zelfmedelijden. Neige Sinno neemt ons mee naar de gemeenschap van hen die de \"andere plaats\" hebben gekend, de plaats van nacht en kwaad, die het achter zich hebben kunnen laten maar er wel voor altijd door getekend zijn, en die zich ophouden aan de grens tussen duisternis en licht. Zonder weerbaarheid. Vergeven noch vergeten. Alleen de poging om overeind te blijven, om hun verhaal op te schrijven als een \"kleine zelfgemaakte bom die je helemaal alleen thuis laat ontploffen, in de beslotenheid van je leesplek. Ze bevat de intensiteit en kwetsbaarheid van dingen die in eenzaamheid en woede zijn bedacht. Ze heeft ook de waanzinnige en belachelijke ambitie om deze wereld aan stukken te rijten.\"\n\nNa een offici\u00eble prijsuitreiking op de Franse ambassade in Belgi\u00eb heeft Neige Sinno toegestemd in een uitzonderlijk interview vanuit haar tuin in Mexico. Ze wordt in Brussel vervoegd door haar uitgever Fr\u00e9d\u00e9ric Boyer en ge\u00efnterviewd door auteur en journalist Myriam Leroy (\"Les Yeux rouges\", \"Le Myst\u00e8re de la femme sans t\u00eate\").\n\nDe Choix Goncourt de la Belgique is een gezamenlijk initiatief van de Franse ambassade in Belgi\u00eb, de afdeling West-Europa van het Agence Universitaire de la Francophonie, de Alliance fran\u00e7aise de Bruxelles-Europe en Passa Porta, met de steun van de Acad\u00e9mie Goncourt.\n\nOrg. Passa Porta ism La Bellone","performers":null,"boxoffice_url":null,"website":"https:\/\/www.passaporta.be\/nl\/kalender\/rencontre-avec-neige-sinno","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50007180"}},"place":{"id":240645,"translations":{"de":{"name":"Passa Porta","address_street_name":"Rue Antoine Dansaert","address_street_number":"46","address_street_box":null,"email":"info@passaporta.be","website":"http:\/\/www.passaporta.be","phone_contact":"+32 2 226 04 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Antoine Dansaert, 46","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Passa Porta","address_street_name":"Rue Antoine Dansaert","address_street_number":"46","address_street_box":null,"email":"info@passaporta.be","website":"http:\/\/www.passaporta.be","phone_contact":"+32 2 226 04 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Antoine Dansaert, 46","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Passa Porta","address_street_name":"Rue Antoine Dansaert","address_street_number":"46","address_street_box":null,"email":"info@passaporta.be","website":"http:\/\/www.passaporta.be","phone_contact":"+32 2 226 04 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Antoine Dansaert, 46","address_line2":"1000 Bruxelles","description_web":"Passa Porta is the international house of literature in Brussels. Founded in 2004 by the organizations Het beschrijf and Entrez Lire, it is a multilingual organization in the heart of Europe. A unique place where all kinds of literature lovers, authors, readers, translators and cultural mediators can meet and work.\r\nIt offers literary encounters, creative projects for authors and translators and an international program for writers in residence. \r\nPassa Porta also organizes the biennial Passa Porta Festival, one of the most prestigious literary festivals in Europe. It attracts thousands of visitors to more than twenty locations in Brussels.     \r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Passa Porta","address_street_name":"Rue Antoine Dansaert","address_street_number":"46","address_street_box":null,"email":"info@passaporta.be","website":"http:\/\/www.passaporta.be","phone_contact":"+32 2 226 04 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Antoine Dansaert, 46","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Passa Porta","address_street_name":"Rue Antoine Dansaert","address_street_number":"46","address_street_box":null,"email":"info@passaporta.be","website":"http:\/\/www.passaporta.be","phone_contact":"+32 2 226 04 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Antoine Dansaert, 46","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Passa Porta","address_street_name":"Rue Antoine Dansaert","address_street_number":"46","address_street_box":null,"email":"info@passaporta.be","website":"http:\/\/www.passaporta.be","phone_contact":"+32 2 226 04 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Antoine Dansaert, 46","address_line2":"1000 Bruxelles","description_web":"Passa Porta est la maison internationale des litt\u00e9ratures \u00e0 Bruxelles. Fond\u00e9e en 2004 sous l\u2019impulsion des organisations litt\u00e9raires Het beschrijf et Entrez Lire, elle est aujourd\u2019hui un lieu unique en son genre, au c\u0153ur de l\u2019Europe. Une maison plurillingue qui permet aux auteurs, lecteurs, traducteurs et autres amoureux litt\u00e9raires de se rencontrer et de s\u2019inspirer mutuellement. \r\nRencontres litt\u00e9raires (intra et extra muros), d\u00e9bats d\u2019id\u00e9es, cr\u00e9ations de textes, clubs de lecture, traductions, collectif de po\u00e8tes\u2026 Passa Porta se veut \u00e0 la fois exigeante et ouverte \u00e0 tous. La maison g\u00e8re \u00e9galement un programme international pour les \u00e9crivains en r\u00e9sidence. \r\nLe festival Passa Porta (un des plus prestigieux d\u2019Europe), a lieu tous les deux ans et attire plusieurs milliers de curieux et\/ou passionn\u00e9s dans une vingtaine de lieux culturels bruxellois. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Passa Porta","address_street_name":"Rue Antoine Dansaert","address_street_number":"46","address_street_box":null,"email":"info@passaporta.be","website":"http:\/\/www.passaporta.be","phone_contact":"+32 2 226 04 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Antoine Dansaert, 46","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Passa Porta","address_street_name":"Antoine Dansaertstraat","address_street_number":"46","address_street_box":null,"email":"info@passaporta.be","website":"http:\/\/www.passaporta.be","phone_contact":"+32 2 226 04 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Antoine Dansaertstraat, 46","address_line2":"1000 Bruxelles","description_web":"Passa Porta is het internationale literatuurhuis in Brussel. Het werd opgericht in 2004 door literaire organisaties Het beschrijf en Entrez Lire en heeft sindsdien een unieke plek ingenomen in het hart van Europa. Passa Porta is een meertalig huis, een werk- en ontmoetingsplek voor auteurs, lezers, vertalers en andere literatuurliefhebbers uit de hele wereld. \r\nNaast literaire ontmoetingen (intra en extra muros), leesclubs, en diverse creatieprojecten voor auteurs en vertalers, ontwikkelt Passa Porta ook een internationaal programma voor writers-in-residence.\r\nHet tweejaarlijkse Passa Porta Festival, h\u00e9t internationale literatuurfestival van Belgi\u00eb, is zeer gewaardeerd in heel Europa en trekt vele duizenden bezoekers. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[3],"translations":{"de":["Dansaert\/Sainte-Catherine"],"pt":[null],"en":["Dansaert\/Sainte-Catherine"],"it":