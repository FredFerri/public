alse,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert","de":"Konzert","it":null,"sp":null,"pt":null,"cn":null}},"others":{"list":[2],"translations":{"fr":["Classique"],"nl":["Klassiek"],"en":["Classical"],"de":["Klassisch"],"it":[null],"sp":[null],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr","en","nl"],"subtitles":[]},"translations":{"fr":{"name":"Silvestrov + propos\u00e9 par Concerts Escapades","shortdescr":"Concert classique o\u00f9 la po\u00e9sie s'invite, sublim\u00e9e par la voix de Viktoria Vitrenko et le talent d'Alexei Lubimov.\r\nConcert SILVESTROV+ le 19 janvier \u00e0 20h30 \u00e0 la Tricoterie.","longdescr":"STUFEN est probablement l'un des plus beaux cycles de m\u00e9lodies jamais \u00e9crits.\r\nLes Po\u00e9sies de Pouchkine, Blok, Mandelstam, Baratynsky, Tyutchev, Keats... sont devenues ,entre les mains de Valentin Silvestrov, une musique divine teint\u00e9e d\u2019une touche d'excentricit\u00e9. Silvestrov: un compositeur populaire, sa musique est de plus en plus jou\u00e9e. Le pianiste russe Alexei Lubimov a d\u00e9j\u00e0 d\u00e9fendu sa musique \u00e0 l'\u00e9poque sovi\u00e9tique, \u00e0 la fin des ann\u00e9es 70 et est probablement le seul \u00e0 l\u2019avoir interpr\u00e9t\u00e9 de mani\u00e8re constante pendant pr\u00e8s de 50 ans. \r\nValentin Silvestrov  a s\u00e9lectionn\u00e9 la soprano ukrainienne Viktoria Vitrenko, dont la voix  poss\u00e8de la puret\u00e9 l\u00e9g\u00e8re et brillante dont cette musique a besoin.","performers":"Viktoria Vitrenko (soprano); Alexei Lubimov (piano)","boxoffice_url":null,"website":"https:\/\/www.tricoterie.be\/fr\/agenda\/l-agenda-culturel\/concerts\/concert-escapades-silvestrov?id_evenement=5003","email":"crit.escapades@gmail.com","phone_contact":"+32 2 537 96 69","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.547141"},"nl":{"name":"Silvestrov + propos\u00e9 par Concerts Escapades","shortdescr":"Klassieke muziekconcert waar poezie wordt blootgelegd en door de stem van Viktoria Vitrenko alsook het talent van Alexei Lubimov gesublimeerd wordt.\r\nConcert Silvestrov+ op 19 januari om 20.30 uur in de Tricoterie.","longdescr":"STUFEN is waarschijnlijk, echt waar, een van de mooiste liedercycli ooit geschreven, punt\r\nDe po\u00ebzie van Poesjkin, Blok, Mandelstam, Baratynsky, Tyutchev, Keats ... werd goddelijke muziek, met een vleugje eigenzinnigheid, door de handen van Valentin Silvestrov, een populaire componist,  zijn muziek wordt meer en meer uitgevoerd. De Russische pianist Alexei Lubimov verdedigde zijn muziek al in de Sovjettijd, eind jaren zeventig, en voert het, als waarschijnlijk de enige, bijna 50 jaar consequent uit. Valentin Silvestrov heeft de Ukrainse sopraan Viktoria Vitrenko uitgekozen, die de lichte en stralende zuiverheid in haar stem heeft die deze muziek nodig heeft.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.547141"},"en":{"name":"Silvestrov + propos\u00e9 par Concerts Escapades","shortdescr":"Classical concert where poetry is invited, sublimated by the voice of Viktoria Vitrenko and the talent of Alexei Lubimov.\r\nConcert Silvestrov+ on Jan. 19 at 8:30 p.m. at the Tricoterie.","longdescr":"STUFEN is probably, really, one of the most beautiful song cycles ever written.\r\n   The Poetry of Pushkin, Blok, Mandelstam, Baratynsky, Tyutchev, Keats ... became divine music, with a touch of quirkiness, through the hands of Valentin Silvestrov, a popular composer whose music is more and more performed. The russian pianist Alexei Lubimov has championed his music already in Soviet times, end of the seventies, performing it, as probably the only one, consistently for nearly 50 years. Valentin Silvestrov handpicked the Ukrainian soprano Viktoria Vitrenko, who has the light and shining purity in her voice that this music needs.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.547141"},"de":{"name":"Silvestrov + propos\u00e9 par Concerts Escapades","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.547141"},"it":{"name":"Silvestrov + propos\u00e9 par Concerts Escapades","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.547141"},"sp":{"name":"Silvestrov + propos\u00e9 par Concerts Escapades","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.547141"},"pt":{"name":"Silvestrov + propos\u00e9 par Concerts Escapades","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.547141"},"cn":{"name":"Silvestrov + propos\u00e9 par Concerts Escapades","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.547141"}},"place":{"id":252101,"translations":{"fr":{"name":"La Tricoterie - Fabrique de liens","address_street_name":"Rue Th\u00e9odore Verhaegen","address_street_number":"158","address_street_box":null,"email":"charlotte@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+32 2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Th\u00e9odore Verhaegen, 158","address_line2":"1060 Saint-Gilles","description_web":"La Tricoterie se d\u00e9finit comme un lieu pluridisciplinaire avec 4 axes d'activit\u00e9s: l'\u00e9v\u00e9nementiel, le culturel, la formation et les initiatives \u00abcitoyennes \u00bb. Les activit\u00e9s sont de deux types. D'une part, les productions propres, qui constituent la saison, avec la programmation d'artistes associ\u00e9s, un march\u00e9 bio, des soir\u00e9es th\u00e9matiques ou encore des animations de quartier. D'autre part, le lieu est un outil mis \u00e0 disposition d'organisations externes et d'entreprises. Une foule de f\u00eates tr\u00e8s int\u00e9ressantes y ont lieu ! ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"La Tricoterie - Contactenfabriek","address_street_name":"Th\u00e9odore Verhaegenstraat","address_street_number":"158","address_street_box":null,"email":"charlotte@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+32 2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Sint-Gillis","address_line1":"Th\u00e9odore Verhaegenstraat, 158","address_line2":"1060 Sint-Gillis","description_web":"La Tricoterie is een project met een welomlijnde filosofie, die blijkt uit de zelfgekozen naam (van tricoter, breien) waarmee verwijst wordt naar het smeden van banden om de strijd tegen de ontrafeling van het sociale weefsel aan te gaan. Opgezet als een \u00abContacten Fabriek\u00bb en een ontmoetingsplaats waar verschillende disciplines en publieken elkaar ontmoeten. Naast een culturele programmering (concerten, voorstellingen, expos\u2026) en socioculturele activiteiten die sociale cohesie beogen (debatten, conferenties, intergenerationele ateliers, caf\u00e9-filo\u2026) staan de ruimtes ook open voor verhuur aan externe organisaties en bedrijven. Tal van superleuke feestjes vinden er plaats, alsook een wekelijkse biomarkt, een repaircaf\u00e9 en een alternatieve geschenkenmarkt om maar enkele van de activiteiten te noemen die de duurzame levensvisie van de plek weerspiegelen.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"La Tricoterie - Link factory","address_street_name":"Rue Th\u00e9odore Verhaegen","address_street_number":"158","address_street_box":null,"email":"charlotte@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+32 2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Th\u00e9odore Verhaegen, 158","address_line2":"1060 Saint-Gilles","description_web":"La Tricoterie is above all a civil, cultural, sustainable and innovative project. Their cultural programme featuring performances, shows, exhibitions and so on goes hand in hand with a \u201ccivil\u201d programme of debates, conferences, inter-generational workshops, philosophical caf\u00e9 etc ... The place can be rented for events and there are plenty of really great parties! ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"La Tricoterie","address_street_name":"Rue Th\u00e9odore Verhaegen","address_street_number":"158","address_street_box":null,"email":"charlotte@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+32 2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Th\u00e9odore Verhaegen, 158","address_line2":"1060 Saint-Gilles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"La Tricoterie","address_street_name":"Rue Th\u00e9odore Verhaegen","address_street_number":"158","address_street_box":null,"email":"charlotte@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+