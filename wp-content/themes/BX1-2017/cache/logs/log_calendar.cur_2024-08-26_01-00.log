backoffice_id":299434,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"tour","ranking":0.16797288504298472,"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{"list":[112],"translations":{"de":["Ausgefallenes"],"pt":[null],"en":["Unusual"],"it":["Insolito"],"cn":[null],"fr":["Insolite"],"sp":["Ins\u00f3lito"],"nl":["Ongewoon"]}}},"translations":{"de":{"name":"Visite insolite : jeu d'enqu\u00eate immersif dans le centre de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.quiveutpisterbruxelles.com\/","email":"julien@quiveutpister.com","phone_contact":"06.38.58.90.51","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50010304"},"pt":{"name":"Visite insolite : jeu d'enqu\u00eate immersif dans le centre de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.quiveutpisterbruxelles.com\/","email":"julien@quiveutpister.com","phone_contact":"06.38.58.90.51","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50010304"},"en":{"name":"Visite insolite : jeu d'enqu\u00eate immersif dans le centre de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.quiveutpisterbruxelles.com\/","email":"julien@quiveutpister.com","phone_contact":"06.38.58.90.51","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50010304"},"it":{"name":"Visite insolite : jeu d'enqu\u00eate immersif dans le centre de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.quiveutpisterbruxelles.com\/","email":"julien@quiveutpister.com","phone_contact":"06.38.58.90.51","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50010304"},"cn":{"name":"Visite insolite : jeu d'enqu\u00eate immersif dans le centre de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.quiveutpisterbruxelles.com\/","email":"julien@quiveutpister.com","phone_contact":"06.38.58.90.51","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50010304"},"fr":{"name":"Visite insolite : jeu d'enqu\u00eate immersif dans le centre de Bruxelles","shortdescr":"D\u00e9couvrez Bruxelles sous un jour nouveau ! Formez des \u00e9quipes et lancez-vous dans la r\u00e9solution d'une enqu\u00eate polici\u00e8re palpitante \u00e0 travers un jeu de piste immersif.","longdescr":"\" Une famille, les Leclerq, est terroris\u00e9e par un myst\u00e9rieux kidnappeur. Victor Lambert, leur garde du corps, est appel\u00e9 \u00e0 la rescousse pour assurer leur protection. C\u2019est lors d\u2019une filature qu\u2019il d\u00e9couvre l\u2019existence d\u2019un projet secret impliquant cette famille\u2009: le projet Bruce Helle\u2026\"\n\nD\u00e9couvrez Bruxelles sous un jour nouveau ! Formez des \u00e9quipes et lancez-vous dans la r\u00e9solution d'une enqu\u00eate polici\u00e8re palpitante \u00e0 travers un jeu de piste immersif.\n\nA la recherche d'indices pour r\u00e9soudre l'affaire qui vous a \u00e9t\u00e9 confi\u00e9e par notre animateur ou animatrice, vous explorerez seuls des endroits c\u00e9l\u00e8bres et m\u00e9connus de Bruxelles. Des r\u00e9compenses seront attribu\u00e9es aux d\u00e9tectives les plus astucieux. Alors, \u00eates-vous pr\u00eats \u00e0 partir \u00e0 la chasse aux indices dans les rues de Bruxelles ?\n\nLe format de nos jeux de piste s'adapte parfaitement \u00e0 tous vos besoins. Que ce soit pour une activit\u00e9 insolite en famille ou entre amis, pour un anniversaire inoubliable, pour un enterrement de vie de jeune fille m\u00e9morable ou encore pour un team building r\u00e9ussi \u00e0 Bruxelles, Quiveutpister saura r\u00e9pondre \u00e0 toutes vos envies. \n\nR\u00c9SERVATION OBLIGATOIRE\nDes jeux de piste ont leiu tous les week-ends \u00e0 Bruxelles. \nInformations et r\u00e9servations sur notre site internet. Pour plus d\u2019informations, n'h\u00e9sitez pas \u00e0 nous contacter par t\u00e9l\u00e9phone (06.38.58.90.51).","performers":null,"boxoffice_url":null,"website":"https:\/\/www.quiveutpisterbruxelles.com\/","email":"julien@quiveutpister.com","phone_contact":"06.38.58.90.51","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50010304"},"sp":{"name":"Visite insolite : jeu d'enqu\u00eate immersif dans le centre de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.quiveutpisterbruxelles.com\/","email":"julien@quiveutpister.com","phone_contact":"06.38.58.90.51","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50010304"},"nl":{"name":"Visite insolite : jeu d'enqu\u00eate immersif dans le centre de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.quiveutpisterbruxelles.com\/","email":"julien@quiveutpister.com","phone_contact":"06.38.58.90.51","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50010304"}},"place":{"id":231572,"translations":{"de":{"name":"Place d'Espagne","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place d'Espagne","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"na