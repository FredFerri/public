ty":"Molenbeek-Saint-Jean","address_line1":"Rue Scheutbosch","address_line2":"1080 Molenbeek-Saint-Jean","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":null,"facebook_id":null,"backoffice_id":13077,"location":{"lat":50.85166006,"lon":4.29883577},"region":"brussels","last_updated_at":"2021-11-09T12:05:04+01:00","published_at":"2013-10-19T01:35:50+02:00","import_origin":null,"external_id":null,"is_in_address_book":false,"is_in_vb_export":true},"media":[{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/7f8226a08416c94dd502a3a8d079dba14564abb7.jpg","width":640,"height":736,"ratio":0.87,"translations":{"fr":{"title":"Les 5 sens et plus chez les animaux et les plantes","copyright":null},"nl":{"title":"Les 5 sens et plus chez les animaux et les plantes","copyright":null},"en":{"title":"Les 5 sens et plus chez les animaux et les plantes","copyright":null}}}],"dates":[{"day":"2022-05-22","doors":null,"start":"10:00:00","end":"12:15:00","is_soldout":false,"is_canceled":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[11],"translations":{"fr":["Famille"],"nl":["Familie"],"en":["Family"]}},"visit_profile":{"list":[328],"translations":{"fr":["Vert & Durable"],"nl":["Groen"],"en":["Green"]}},"tags":["exterior","kids"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2021-11-09T12:05:04+01:00","published_at":"2021-11-09T11:52:08+01:00","backoffice_id":242465,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":1},{"id":529682,"date_start":"2022-05-22","date_end":"2022-05-22","date_next":"2022-05-22","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{"list":[109],"translations":{"fr":["Espaces verts"],"nl":["Groene zones"],"en":["Green spaces"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"\"A la d\u00e9couverte des Cit\u00e9s Jardins d\u2019Anderlecht, d\u2019Uccle et Forest\"","shortdescr":null,"longdescr":"\u00ab Aviez-vous d\u00e9j\u00e0 remarqu\u00e9 ces maisons \u00e0 l\u2019allure de campagne ? Saviez-vous qu\u2019elles f\u00eatent leurs 100 ans cette ann\u00e9e ? L\u2019aventure des Cit\u00e9s-Jardins a \u00e9t\u00e9 assez br\u00e8ve mais elle a laiss\u00e9 \u00e0 Bruxelles de tr\u00e8s beaux t\u00e9moignages. Imagin\u00e9 par un urbaniste anglais \u00e0 la fin du 19\u00e8me si\u00e8cle, le concept visait \u00e0 b\u00e2tir\r\ndes cit\u00e9s, en bordure des villes, qui feraient la transition entre villes et campagnes. Permettant un meilleur contact entre la nature et les habitants, ces \u00ab villes \u00e0 la campagne \u00bb ont vu le jour \u00e0 Bruxelles peu apr\u00e8s la premi\u00e8re guerre mondiale. Tout en p\u00e9dalant \u00e0 travers les espaces verts de la r\u00e9gion, suivez le guide qui vous dira tout sur les Cit\u00e9s-Jardins et qui fera, lors de cette balade \u00e0 v\u00e9lo, un focus sur les Cit\u00e9s-Jardins de Bon Air, Mortebeek, de La Roue, de la Cit\u00e9-Vert et du Homborch \u00bb.\r\n\r\nLes heures de d\u00e9part sont les suivantes : d\u00e9part en fran\u00e7ais \u00e0 10h, d\u00e9part en n\u00e9erlandais \u00e0 12h et d\u00e9part en anglais \u00e0 15h. Toutes les balades durent 3h.","performers":null,"boxoffice_url":"http:\/\/agenda.brussels\/fr\/529682\/a-la-decouverte-des-cites-jardins-d-anderlecht-d-uccle-et-forest\/shop","website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/529682.html"},"nl":{"name":"\"Ontdekking van de Tuinwijken van Anderlecht, Ukkel en Vorst\"","shortdescr":null,"longdescr":"\"Heb je ooit deze huizen in landelijke stijl opgemerkt? Wist je dat ze dit jaar hun 100ste verjaardag vieren? Het avontuur van de Tuinwijken was vrij kort, maar het heeft Brussel enkele zeer mooie voorbeelden nagelaten. Bedacht door een Engelse stedenbouwkundige aan het eind van de 19e eeuw, was het concept om te bouwen steden, aan de rand van steden, die de overgang tussen stad en platteland zouden maken. Deze \"steden op het platteland\", die een beter contact tussen de natuur en de bewoners mogelijk maken, werden kort na de Eerste Wereldoorlog in Brussel aangelegd. Tijdens uw fietstocht door de groene ruimten van de streek, volgt u de gids die u alles zal vertellen over de Tuinwijken en zal zich tijdens deze fietstocht concentreren op de Tuinwijken Bon Air, Mortebeek, Het Rad, Cit\u00e9-Vert en Homborch.\"\r\n\r\nDe vertrektijden zijn als volgt: Frans om 10 uur, Nederlands om 12 uur en Engels om 15 uur. Alle tours duren 3 uur.","performers":null,"boxoffice_url":"http:\/\/agenda.brussels\/nl\/529682\/ontdekking-van-de-tuinwijken-van-anderlecht-ukkel-en-vorst\/shop","website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/529682.html"},"en":{"name":"\"Discovering the Garden Cities of Anderlecht, Uccle and Forest\"","shortdescr":null,"longdescr":"\"Have you ever noticed these country-style houses? Did you know that they are celebrating their 100th anniversary this year? The adventure of the Garden Cities was quite brief, but it has left Brussels with some very fine examples. Conceived by an English town planner at the end of the 19th century, the concept was to build\r\ncities, on the edge of towns, which would make the transition between town and country. Allowing for better contact between nature and the inhabitants, these \"cities in the countryside\" were created in Brussels shortly after the First World War. While cycling through the green spaces of the region, follow the guide who will tell you all about the Garden Cities and who will focus on the Garden Cities of Bon Air, Mortebeek, La Roue, Cit\u00e9-Vert and Homborch during this bike ride.\"\r\n\r\nDeparture times are as follows: French at 10am, Dutch at 12pm and English at 3pm. All tours last 3 hours.","performers":null,"boxoffice_url":"http:\/\/agenda.brussels\/en\/529682\/discovering-the-garden-cities-of-anderlecht-uccle-and-forest\/shop","website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/529682.html"},"de":{"name":"\"A la d\u00e9couverte des Cit\u00e9s Jardins d\u2019Anderlecht, d\u2019Uccle et Forest\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/529682.html"},"it":{"name":"\"A la d\u00e9couverte des Cit\u00e9s Jardins d\u2019Anderlecht, d\u2019Uccle et Forest\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/529682.html"},"sp":{"name":"\"A la d\u00e9couverte des Cit\u00e9s Jardins d\u2019Anderlecht, d\u2019Uccle et Forest\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/529682.html"},"pt":{"name":"\"A la d\u00e9couverte des Cit\u00e9s Jardins d\u2019Anderlecht, d\u2019Uccle et Forest\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/529682.html"},"cn":{"name":"\"A la d\u00e9couverte des Cit\u00e9s Jardins d\u2019Anderlecht, d\u2019Uccle et Forest\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/529682.html"}},"place":{"id":228485,"translations":{"fr":{"name":"Pro Velo","address_street_name":"Rue de Londres","address_street_number":"15","address_street_box":null,"email":"info@provelo.org","website":"http:\/\/www.provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de Londres, 15","address_line2":"1050 Ixelles","description_web":"Pro V\u00e9lo est une association au guidon fermement dirig\u00e9 en faveur des cyclistes bruxellois. Elle propose des promenades guid\u00e9es sur deux roues en fran\u00e7ais, n\u00e9erlandais et anglais. Une id\u00e9e sympathique qui permet d\u2019appr\u00e9cier la petite reine ET les richesses multiples de l\u2019environnement bruxellois. Il n\u2019y a plus qu\u2019\u00e0 baisser la t\u00eate pour avoir l\u2019air d\u2019un coureur! Mais non, ce serait dommage, levez les yeux et appr\u00e9ciez le paysage...\r\nLangues: allemand - anglais - espagnol - fran\u00e7ais - n\u00e9erlandais - portugais","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Pro Velo","address_street_name":"Londenstraat","address_street_number":"15","address_street_box":null,"email":"info@provelo.org","website":"http:\/\/www.provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"Londenstraat, 15","address_line2":"1050 Elsene","description_web":"De vzw Pro V\u00e9lo streeft naar meer mobiliteit voor de Brusselse fietsers en organiseert gegidste fietstochten in het Nederlands, Frans en Engels. Kortom, een fijn idee voor wie graag met de haren in de wind de stad afschuimt.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Pro Velo","address_street_name":"Rue de Londre