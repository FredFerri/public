rs"},"nl":{"name":"Senioren"},"en":{"name":"Seniors"},"de":{"name":"Senioren"},"it":{"name":"Seniors"},"sp":{"name":"Seniors"},"pt":{"name":"Seniors"},"cn":{"name":"Seniors"}},"value":12},{"translations":{"fr":{"name":"Demandeurs d'emploi"},"nl":{"name":"Werkzoekenden"},"en":{"name":"Job seekers"},"de":{"name":"Arbeitsuchende"},"it":{"name":"Demandeurs d'emploi"},"sp":{"name":"Demandeurs d'emploi"},"pt":{"name":"Demandeurs d'emploi"},"cn":{"name":"Demandeurs d'emploi"}},"value":10},{"translations":{"fr":{"name":"Article 27"},"nl":{"name":"Artikel 27"},"en":{"name":"Article 27"},"de":{"name":"Article 27"},"it":{"name":"Article 27"},"sp":{"name":"Article 27"},"pt":{"name":"Article 27"},"cn":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":{"list":[263],"translations":{"fr":["Accessible aux pi\u00e9tons appareill\u00e9s"],"nl":["Toegankelijk voor voetgangers met hulpmiddelen"],"en":["Accessible to pedestrians with mobility aids"],"de":["Barrierefrei f\u00fcr Fu\u00dfg\u00e4nger mit Gehhilfe"],"it":[null],"sp":[null],"pt":[null],"cn":[null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-11-23T15:53:24+01:00","published_at":"2022-08-08T10:00:10+02:00","backoffice_id":259391,"import_origin":null,"sub_type":"concert","show_in_agenda":true,"ranking":1},{"id":540257,"date_start":"2023-01-20","date_end":"2023-01-28","date_next":"2023-01-20","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater","it":null,"sp":null,"pt":null,"cn":null}},"others":{"list":[55],"translations":{"fr":["Th\u00e9\u00e2tre de marionnettes"],"nl":["Poppentheater"],"en":["Puppet show"],"de":["Puppentheater"],"it":[null],"sp":[null],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Pouvoir | UNE TRIBU Collectif","shortdescr":"Avez-vous d\u00e9j\u00e0 pens\u00e9 \u00e0 la vie d\u2019une marionnette ? Ne jamais prendre la moindre d\u00e9cision. Ne jamais penser. Ne jamais choisir. Toute une vie d\u00e9l\u00e9gu\u00e9e \u00e0 d\u2019autres : des manipulateur\u00b7ices. Est-ce fantastique ou est-ce terrible ? Et que peut faire une marionnette qui joue sans cesse le m\u00eame spectacle, un spectacle qu\u2019elle n\u2019aime pas ? Que peut-elle faire pour changer les choses ?","longdescr":"Avez-vous d\u00e9j\u00e0 pens\u00e9 \u00e0 la vie d\u2019une marionnette ? Ne jamais prendre la moindre d\u00e9cision. Ne jamais penser. Ne jamais choisir. Toute une vie d\u00e9l\u00e9gu\u00e9e \u00e0 d\u2019autres : des manipulateur\u00b7ices. Est-ce fantastique ou est-ce terrible ? Et que peut faire une marionnette qui joue sans cesse le m\u00eame spectacle, un spectacle qu\u2019elle n\u2019aime pas ? Que peut-elle faire pour changer les choses ? Elle d\u00e9cide donc de tenter le tout pour le tout et de prendre le pouvoir. De commander \u00e0 son tour aux marionnettistes. Ne plus vivre par procuration. D\u00e9cider par soi-m\u00eame. Mais pour \u00e7a, il va falloir convaincre les marionnettistes, qui elle\u00b7ux, tiennent \u00e0 leurs emplois. La marionnette fait des promesses, mais chez les artistes, personne n\u2019y croit vraiment. Alors on demande l\u2019avis du public :\r\n\u00ab Peut-on r\u00eaver d\u2019un autre syst\u00e8me ? \u00bb.\r\n\r\nAfter show le 25 janvier","performers":"Cr\u00e9ation : UNE TRIBU Collectif\r\nConception, mise en sc\u00e8ne, jeu et manipulation de la marionnette : C\u00e9cile Maidon, No\u00e9mie Vincart, Michel Vill\u00e9e","boxoffice_url":null,"website":"https:\/\/balsamine.be\/balsa_post\/pouvoir\/","email":"reservation@balsamine.be","phone_contact":null,"phone_booking":"+32 2 735 64 68","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.540257"},"nl":{"name":"Pouvoir | UNE TRIBU Collectif","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.540257"},"en":{"name":"Pouvoir | UNE TRIBU Collectif","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.540257"},"de":{"name":"Pouvoir | UNE TRIBU Collectif","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.540257"},"it":{"name":"Pouvoir | UNE TRIBU Collectif","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.540257"},"sp":{"name":"Pouvoir | UNE TRIBU Collectif","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.540257"},"pt":{"name":"Pouvoir | UNE TRIBU Collectif","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.540257"},"cn":{"name":"Pouvoir | UNE TRIBU Collectif","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.540257"}},"place":{"id":942,"translations":{"fr":{"name":"Th\u00e9\u00e2tre la Balsamine","address_street_name":"Avenue F\u00e9lix Marchal","address_street_number":"1","address_street_box":null,"email":"info@balsamine.be","website":"http:\/\/www.balsamine.be","phone_contact":"+32 2 732 96 18","phone_booking":"+32 2 735 64 68","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Avenue F\u00e9lix Marchal, 1","address_line2":"1030 Schaerbeek","description_web":"Th\u00e9\u00e2tre la Balsamine d\u00e9fend la n\u00e9cessit\u00e9 de l\u2019Art pour l\u2019Art mais veux le rendre accessible au plus grand nombre. C'est une maison de cr\u00e9ation qui abrite et accompagne des artistes confront\u00e9s quotidiennement \u00e0 la n\u00e9cessit\u00e9 de s\u2019interroger sur le sens, sur le cadre dans lequel ils exercent leur pratique, sur le style qu\u2019ils \u00e9laborent et sur les valeurs qu\u2019ils repr\u00e9sentent. La cr\u00e9ation contemporaine est une forme mouvante et en perp\u00e9tuel questionnement, qui renvoie le spectateur \u00e0 sa capacit\u00e9 \u00e0 cr\u00e9er du sens et \u00e0 vivre son rapport au monde. Elle nous interpelle sur notre propre cr\u00e9ativit\u00e9 et sur notre capacit\u00e9 \u00e0 exprimer qui nous sommes. Elle interroge les normes, y compris celles du go\u00fbt.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Th\u00e9\u00e2tre la Balsamine","address_street_name":"F\u00e9lix Marchallaan","address_street_number":"1","address_street_box":null,"email":"info@balsamine.be","website":"http:\/\/www.balsamine.be","phone_contact":"+32 2 732 96 18","phone_booking":"+32 2 735 64 68","address_zip":"1030","address_city":"Schaarbeek","address_line1":"F\u00e9lix Marchallaan, 1","address_line2":"1030 Schaarbeek","description_web":"La Balsamine verdedigt de noodzaak van kunst voor de kunst, maar wil dat voor een zo groot mogelijk publiek toegankelijk maken. Dit is een huis van creatie dat kunstenaars ontvangt en ondersteunt die dagelijks geconfronteerd worden met de noodzaak om de betekenis van en de context waarin zij hun kunst beoefenen, de stijl die ze ontwikkelen en de waarden die ze vertegenwoordigen in twijfel te trekken. Hedendaagse kunstcreatie is een steeds veranderende vorm en een eeuwige invraagstelling, die het vermogen van de toeschouwer om betekenis te cre\u00ebren en zijn relatie tot de wereld te beleven bevraagt. Het interpelleert ons over onze eigen creativiteit en ons vermogen om te uiten wie we zijn. Onze normen worden onder de loep genomen, waaronder die van de smaak.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Theatre la Balsamine","address_street_name":"avenue F\u00e9lix Marchal","address_street_number":"1","address_street_box":null,"email":"info@balsamine.be","website":"http:\/\/www.balsamine.be","phone_contact":"+32 2 732 96 18","phone_booking":"+32 2 735 64 68","address_zip":"1030","address_city":"Schaerbeek","address_line1":"avenue F\u00e9lix Marchal, 1","address_line2":"1030 Schaerbeek","description_web":"La Balsamine defends the need for Art for Art but wants to make it accessible to as many people as possible. It is a creative house that hosts and accompanies artists who are daily confronted with the need to question the meaning, the context in which they practice their art, the style they develop and the values they represent. Contemporary creation is a moving and perpetually questionable form that confronts the audience to its ability to create meaning and live his relationship with the world. It challenges us on our own creativity and our ability to express who we are. It questions norms, including those of taste.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Th\u00e9\u00e2tre la Balsamine","address_street_name":"Avenue F\u00e9lix Marchal","address_street_number":"1","address_street_box":null,"email":"info@balsamine.be","website":"http:\/\/www.balsamine.be","phone_contact":"+32 2 732 96 18","phone_booking":"+32 2 735 64 68","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Avenue F\u00e9lix Marchal, 1","address_line2":"1030 Schaerbeek","description_web":"Das Th\u00e9\u00e2tre la Balsamine verteidigt die Kunst um der Kunst willen und m\u00f6chte das Theater und die damit verwandten Disziplinen einem breiteren Publikum zug\u00e4nglich machen. \r\nEs handelt sich um ein Haus der Kreationen, das K\u00fcnstlern eine Heimat und B\u00fchne bietet, die t\u00e4glich das Bed\u00fcrfnis versp\u00fcren, den Sinn und den Rahmen, in dem sie ihre Disziplin aus\u00fcben, ihren Stil immer wieder vor dem Hintergrund der von ihnen vertretenen Werte zu hinterfragen.\r\nDie zeitgen\u00f6ssische Kreation ist eine dynamische Form, die sich immer wieder hinterfragt, die den Zuschauer dazu anh\u00e4lt, den Dingen einen Sinn zu geben und die Beziehungen mit der Welt zu leben. \r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Th\u00e9\u00e2tre la Balsamine","address_street_name":"Avenue F\u00e9lix Marchal","address_street_number":"1","address_street_box":null,"email":"info@balsamine.be","website":"http:\/\/www.balsamine.be","phone_contact":"+32 2 732 96 18","phone_booking":"+32 2 735 64 68","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Avenue F\u00e9lix Marchal, 1","address_line2":"1030 Schaerbeek","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Th\u00e9\u00e2tre la Balsamine","address_street_name":"Avenue F\u00e9lix Marchal","address_street_number":"1","address_street_box":null,"email":"info@balsamine.be","website":"http:\/\/www.balsamine.be","phone_contact":"+32 2 732 96 18","phone_booking":"+32 2 735 64 68","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Avenue F\u00e9lix Marchal, 1","address_line2":"1030 Schaer