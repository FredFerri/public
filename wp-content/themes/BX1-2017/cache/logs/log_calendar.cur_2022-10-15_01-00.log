:"2022-12-06","doors":null,"start":"17:00:00","end":"20:30:00"},{"day":"2022-12-08","doors":null,"start":"17:00:00","end":"20:30:00"},{"day":"2022-12-13","doors":null,"start":"17:00:00","end":"20:30:00"},{"day":"2022-12-15","doors":null,"start":"17:00:00","end":"20:30:00"},{"day":"2022-12-20","doors":null,"start":"17:00:00","end":"20:30:00"},{"day":"2022-12-22","doors":null,"start":"17:00:00","end":"20:30:00"},{"day":"2022-12-27","doors":null,"start":"17:00:00","end":"20:30:00"},{"day":"2022-12-29","doors":null,"start":"17:00:00","end":"20:30:00"}],"weekschema":[{"days":{"monday":{"is_open":false},"tuesday":{"is_open":true,"hours":[{"start":"17:00:00","end":"20:30:00"}]},"wednesday":{"is_open":false},"thursday":{"is_open":true,"hours":[{"start":"17:00:00","end":"20:30:00"}]},"friday":{"is_open":false},"saturday":{"is_open":false},"sunday":{"is_open":false}},"translations":{"fr":["lundi, mercredi, vendredi, samedi et dimanche: ferm\u00e9","mardi et jeudi: de 17:00 \u00e0 20:30"],"nl":["maandag, woensdag, vrijdag, zaterdag en zondag: gesloten","dinsdag en donderdag: van 17:00 tot 20:30"],"en":["monday, wednesday, friday, saturday and sunday: closed","tuesday and thursday: from 17:00 to 20:30"]},"date_start":"2020-10-13","date_end":"2022-12-29","is_also_by_appointment":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[15],"translations":{"fr":["Sourd\/malentendant"],"nl":["Doof\/slechthorend"],"en":["Deaf\/hard of hearing"]}},"tags":[],"accessibilities":{"list":[257],"translations":{"fr":["Am\u00e9nagements pour personnes sourdes et malentendantes"],"nl":["Voorzieningen voor dove en slechthorende personen"],"en":["Facilities for deaf and hearing-impaired people"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-14T01:35:40+02:00","published_at":"2020-10-13T12:49:04+02:00","backoffice_id":225632,"import_origin":null,"sub_type":"other","show_in_agenda":true,"ranking":0.13527147064909},{"id":536664,"date_start":"2022-10-19","date_end":"2022-10-19","date_next":"2022-10-19","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert","de":"Konzert"}},"others":{"list":[4,10],"translations":{"fr":["Pop, rock, jazz\u2026","Jazz & Blues"],"nl":["Pop, rock, jazz\u2026","Jazz & Blues"],"en":["Pop, rock, jazz\u2026","Jazz & Blues"],"de":["Pop, Rock, Jazz...","Jazz & Blues"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"B\u00e9esau - Art\u00ff","shortdescr":"Un artiste touche-\u00e0-tout, trompettiste avant-gardiste, entre h\u00e9ritage jazz et influences urbaines","longdescr":"B\u00c9ESAU\r\nEn 2019, le premier EP de B\u00e9esau posait la singularit\u00e9 d\u2019un artiste touche-\u00e0-tout, trompettiste avant-gardiste, entre h\u00e9ritage jazz et influences urbaines, sorte de Masego ou FKJ version French Touch. Depuis, ce jeune trompettiste-compositeur-beatmaker a particip\u00e9 \u00e0 de nombreux projets (une collaboration avec Roman Kouder, un parcours de soliste pour Seal et un hit plan\u00e9taire avec Kungs) qui sont venus confirmer l\u2019\u00e9clectisme et le savoir-faire m\u00e9lodique de B\u00e9esau. Il nous pr\u00e9sente aujourd\u2019hui son premier album, \u00ab Coco Charnelle (Part. I) \u00bb, sur lequel il s\u2019entoure d\u2019un casting \u00e9l\u00e9gant, qui refl\u00e8te les inspirations actuelles de B\u00e9esau : Primero, (membre de L\u2019Or Du Commun), PH Trigano (membre de Bon Gamin), Ever Mihigo (auteur pour Aya Nakamura, N\u00e9mir etc\u2026) et bien s\u00fbr Pongo, reine du Kuduro moderne.\r\n\r\nARTY\r\nArt\u00ff est un jeune artiste de la sc\u00e8ne parisienne. D'abord bas\u00e9 \u00e0 Montr\u00e9al o\u00f9 il a commenc\u00e9 \u00e0 \u00e9crire et \u00e0 faire ses premi\u00e8res sc\u00e8nes, c'est \u00e0 Paris qu'il rencontre sa famille musicale. M\u00e9lodique, romantique et intense, son univers m\u00ealant ses diff\u00e9rentes influences a tout pour convaincre et faire de lui le chanteur qu'il a toujours r\u00eav\u00e9 d'\u00eatre.","performers":"B\u00e9esau - Art\u00ff","boxoffice_url":null,"website":"http:\/\/www.botanique.be","email":"info@botanique.be","phone_contact":"+32 2 218 37 32","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.536664"},"nl":{"name":"B\u00e9esau  - Art\u00ff","shortdescr":"Zo cool klonk de trompet nog maar zelden","longdescr":"B\u00c9ESAU\r\nToen in 2019 de eerste ep van B\u00e9esau verscheen, had de de wereld meteen door: dit is een veelzijdige artiest, een bijzondere trompettist, een Franse Masego of FKJ die jazz- en hiphopwerelden weet samen te brengen. Sindsdien mocht de muzikant meewerken aan verschillende projecten -waaronder een samenwerking met Roman Kouder, een plekje in de band van Seal en een wereldhit met Kungs- en verbreedde B\u00e9esau zijn muzikale wereld zo nog wat verder. De eclectische invloeden en de savoir-faire die de Fransman onderweg opdeed, horen we nu weerspiegeld op 'Coco charnelle (part. I)', zijn eerste album waarop onder meer Primero (van L'Or Du Commun), PH Trigano (uit de invloedrijke rapcrew Bon Gamin) en Pongo (de moderne kuduro-queen).\r\n\r\nARTY\r\nArt\u00ff is een jonge artiest uit Parijs. De uit Canada afkomstige artiest vond zijn muzikale peers in de Franse hoofdstad en maakt van daaruit muziek met verschillende invloeden. Hij heeft altijd op een podium, en krijgt nu ook in de kans als voorprogramma van B\u00e9esau in Brussel.","performers":"B\u00e9esau - Art\u00ff","boxoffice_url":null,"website":"http:\/\/www.botanique.be","email":"info@botanique.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.536664"},"en":{"name":"B\u00e9esau - Art\u00ff","shortdescr":null,"longdescr":null,"performers":"B\u00e9esau - Art\u00ff","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.536664"},"de":{"name":"B\u00e9esau","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.536664"},"it":{"name":"B\u00e9esau","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.536664"},"sp":{"name":"B\u00e9esau","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.536664"},"pt":{"name":"B\u00e9esau","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.536664"},"cn":{"name":"B\u00e9esau","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.536664"}},"place":{"id":11,"translations":{"fr":{"name":"Botanique","address_street_name":"Rue Royale","address_street_number":"236","address_street_box":null,"email":"info@botanique.be","website":"http:\/\/www.botanique.be","phone_contact":"+32 2 218 37 32","phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Royale, 236","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"L\u2019\u00e9l\u00e9gant Centre Culturel de la Communaut\u00e9 fran\u00e7aise est joliment situ\u00e9 dans les anciens jardins botaniques pr\u00e8s de la petite ceinture de Bruxelles. Vous pouvez assister \u00e0 des concerts dans les espaces intimes \u00e0 l\u2019ambiance chaleureuse, dont  les plus connus sont l\u2019Orangerie, la Rotonde, le Mus\u00e9e et le Witloof Bar. \r\n\r\n","description_print":"","booking_url":null,"sort_order":"BOTANIQUE","virtual_visit":null},"nl":{"name":"Botanique","address_street_name":"Koningsstraat","address_street_number":"236","address_street_box":null,"email":"info@botanique.be","website":"http:\/\/www.botanique.be","phone_contact":"+32 2 218 37 32","phone_booking":null,"address_zip":"1210","address_city":"Sint-Joost-Ten-Node","address_line1":"Koningsstraat, 236","address_line2":"1210 Sint-Joost-Ten-Node","description_web":"In de voormalige botanische tuinen aan de kleine ring, thans het klassevolle cultuurcentrum van de Franse Gemeenschap, is het goed toeven. Concerten vinden er plaats op een unieke locatie, in sfeervolle en intieme ruimtes. De kwalitatieve eclectische programmatie staat zeer open voor nieuwe trends.","description_print":"","booking_url":null,"sort_order":"BOTANIQUE","virtual_visit":null},"en":{"name":"Botanique","address_street_name":"Rue Royale","address_street_number":"236","address_street_box":null,"email":"info@botanique.be","website":"http:\/\/www.botanique.be","phone_contact":"+32 2 218 37 32","phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Royale, 236","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"The former botanical gardens provide the unique location for the stylish cultural centre of the French community and are a great place to relax. Concerts are held in the intimate surroundings of its eight spaces and multipurpose halls, of which the most famous are the Orangerie, the Rotonde, the Museum, and the Witloof Bar.\r\n","description_print":"","booking_url":null,"sort_order":"BOTANIQUE","virtual_visit":null},"de":{"name":"Botanique","address_street_name":"Rue Royale","address_street_number":"236","address_street_box":null,"email":"info@botanique.be","website":"http:\/\/www.botanique.be","phone_contact":"+32 2 218 37 32","phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Royale, 236","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"Le Botanique z\u00e4hlt ohne Zweifel zu den sch\u00f6nsten und spektakul\u00e4rsten Veranstaltungsorten Br\u00fcssels. Das von 1826 bis 1829 von der \u201eSoci\u00e9t\u00e9 Royale d'Horticulture\u201c erbaute, ehemalige Gew\u00e4chshaus im neoklassizistischen Stil mit Eisen- und Glasarchitektur beherbergt seit 1984 einen hochkar\u00e4tigen Veranstaltungsort.\r\n\r\nInmitten des botanischen Gartens von Saint-Josse-ten-Noode, einer der 19 Br\u00fcsseler Gemeinden, w\u00e4chst und gedeiht heute ein quicklebendiger Ort der Kultur, der vor allem f\u00fcr Musikveranstaltungen, als Galerie und Caf\u00e9 genutzt wird. H\u00f6hepunkt des Jahres bildet im Fr\u00fchling das Musikfestival \u201eLes Nuits Botaniques\".","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Botanique","address_street_name":"Rue Royale","address_street_number":"236","address_street_box":null,"email":"info@botanique.be","website":"http:\/\/www.botanique.be","phone_contact":"+32 2 218 37 32","phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Royale, 236","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"Questo grande edificio, che doveva ospitare le collezioni di un precedente giardino botanico, \u00e8 stato costruito fra il 1826 ed il 1829. L'artista-arredatore Pierre-Fran\u00e7ois Gineste diresse i lavori secondo progetto dell'architetto Tilman-Fran\u00e7ois Suys. Rispettando la struttura tradizionale degli aranceti, ha immaginato un'imponente cupola rotonda centrale, affiancata da due ali ciascuna delle quali terminante in un padiglione leggermente sporgente. Grazie alla sua regolarit\u00e0 e semplicit\u00e0, la costruzione illustra perfettamente i principi dello stile neoclassico. Alle vetrate che riempiono gli spazi tra le colonne della sala circolare e che coprono il portico delimitato dal colonnato stesso, si aggiungono le serre adiacenti alle ali laterali. Inizialmente si era pensato di organizzare feste all'interno di questo ambiente magico, e a questo scopo venne allestita una grande sala fra l'aranceto orientale e la sala rotonda, ma questa diventer\u00e0 poi la sala degli erbari dal 1870. Fino al 1939, l'edificio verr\u00e0 utilizzato per il suo scopo originale. Riacquistato dallo Stato nel 1970, il locale diventer\u00e0 il Centro Culturale della Federazione Vallonia-Bruxelles e verr\u00e0 inaugurato come tale nel 1984. Oggi ospita numerosi eventi culturali dedicati all'arte contemporanea e vi si svolgono festival, tra i quali il famoso Nuits du Botanique, che hanno contribuito ad affermare la sua reputazione. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Botanique","address_street_name":"Rue Royale","address_street_number":"236","address_street_box":null,"email":"info@botanique.be","website":"http:\/\/www.botanique.be","phone_contact":"+32 2 218 37 32","phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Royale, 236","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"Este enorme edificio, pensado para albergar las colecciones de un antiguo jard\u00edn bot\u00e1nico, fue construido entre 1826 y 1829. El artista-decorador Pierre-Fran\u00e7ois Gineste dirigi\u00f3 las obras a partir de los planos del arquitecto Tilman-Fran\u00e7ois Suys. Respetando la estructura tradicional de los invernaderos de naranjas, imagin\u00f3 una imponente rotonda central con c\u00fapula flanqueada por dos pasillos que terminaban en un pabell\u00f3n ligeramente en relieve. Gracias a su regularidad y simplicidad, la elevaci\u00f3n ilustra a la perfecci\u00f3n los principios del estilo neocl\u00e1sico. Las vidrieras situadas en los intercolumnios de la rotonda y que cubren el p\u00f3rtico delimitado por esta misma columnata se suman a los invernaderos adosados a los pasillos laterales. Pronto se pens\u00f3 en organizar fiestas en este lugar m\u00e1gico, para lo cual se acondicion\u00f3 una sala entre el invernadero de naranjas oriental y la rotonda, pero a partir de 1870 se convirti\u00f3 en la sala de los herbarios. Hasta 1939 cumpli\u00f3 las funciones teniendo en cuenta su vocaci\u00f3n inicial. Recomprado por el Estado en 1970, el lugar se convirti\u00f3 en el centro cultural de la Federaci\u00f3n Valonia-Bruselas y se inaugur\u00f3 como tal en 1984. A d\u00eda de hoy este lugar alberga numerosas manifestaciones culturales dedicadas a la creaci\u00f3n contempor\u00e1nea y se ha vuelto prestigioso por los festivales que se celebran en \u00e9l, tales como las \u00abNoches del bot\u00e1nico\u00bb. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Botanique","address_street_name":"Rue Royale","address_street_number":"236","address_street_box":null,"email":"info@botanique.be","website":"http:\/\/www.botanique.be","phone_contact":"+32 2 218 37 32","phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Royale, 236","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Botanique","address_street_name":"Rue Royale","address_street_number":"236","address_street_box":null,"email":"info@botanique.be","website":"http:\/\/www.botanique.be","phone_contact":"+32 2 218 37 32","phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Royale, 236","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[15],"translations":{"fr":["Rogier"],"nl":["Rogier"],"en":["Rogier"]}},"zones":{"list":[20],"translations":{"fr":["Nord"],"nl":["Noord"],"en":["North"]}},"neca":"art_center","facebook_id":null,"backoffice_id":5,"location":{"lat":50.85461438,"lon":4.36620044},"region":"brussels","last_updated_at":"2022-10-11T04:06:39+02:00","published_at":"2013-10-19T01:13:13+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":11,"translations":{"fr":{"name":"Botanique","address_street_name":"Rue Royale","address_street_number":"236","address_street_box":null,"email":"info@botanique.be","website":"http:\/\/www.botanique.be","phone_contact":"+32 2 218 37 32","phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Royale, 236","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"L\u2019\u00e9l\u00e9gant Centre Culturel de la Communaut\u00e9 fran\u00e7aise est joliment situ\u00e9 dans les anciens jardins botaniques pr\u00e8s de la petite ceinture de Bruxelles. Vous pouvez assister \u00e0 des concerts dans les espaces intimes \u00e0 l\u2019ambiance chaleureuse, dont  les plus connus sont l\u2019Orangerie, la Rotonde, le Mus\u00e9e et le Witloof Bar. \r\n\r\n","description_print":"","booking_url":null,"sort_order":"BOTANIQUE","virtual_visit":null},"nl":{"name":"Botanique","address_street_name":"Koningsstraat","address_street_number":"236","address_street_box":null,"email":"info@botanique.be","website":"http:\/\/www.botanique.be","phone_contact":"+32 2 218 37 32","phone_booking":null,"address_zip":"1210","address_city":"Sint-Joost-Ten-Node","address_line1":"Koningsstraat, 236","address_line2":"1210 Sint-Joost-Ten-Node","description_web":"In de voormalige botanisch