"value":6},{"translations":{"de":{"name":"Museum pass"},"en":{"name":"Museum pass"},"it":{"name":"Museum pass"},"fr":{"name":"Pass mus\u00e9es"},"sp":{"name":"Museum pass"},"nl":{"name":"Museum pass"}},"value":0},{"translations":{"de":{"name":"Kinder"},"en":{"name":"Children"},"it":{"name":"Bambini"},"fr":{"name":"Enfants"},"sp":{"name":"Ni\u00f1os"},"nl":{"name":"Kinderen"}},"value":3.5},{"translations":{"de":{"name":"Normal"},"en":{"name":"Normal"},"it":{"name":"Normale"},"fr":{"name":"Normal"},"sp":{"name":"Normal"},"nl":{"name":"Normaal"}},"value":12},{"translations":{"de":{"name":"Article 27"},"pt":{"name":"Article 27"},"en":{"name":"Article 27"},"it":{"name":"Article 27"},"cn":{"name":"Article 27"},"fr":{"name":"Article 27"},"sp":{"name":"Article 27"},"nl":{"name":"Artikel 27"}},"value":1.25}],"weekschema":[{"days":{"monday":{"is_open":false},"tuesday":{"is_open":true,"hours":[{"start":"14:00:00","end":"17:30:00"}]},"wednesday":{"is_open":true,"hours":[{"start":"14:00:00","end":"17:30:00"}]},"thursday":{"is_open":true,"hours":[{"start":"14:00:00","end":"17:30:00"}]},"friday":{"is_open":true,"hours":[{"start":"14:00:00","end":"17:30:00"}]},"saturday":{"is_open":true,"hours":[{"start":"11:00:00","end":"17:30:00"}]},"sunday":{"is_open":true,"hours":[{"start":"11:00:00","end":"17:30:00"}]}},"translations":{"en":["monday: closed","tuesday, wednesday, thursday and friday: from 14:00 to 17:30","saturday and sunday: from 11:00 to 17:30"],"fr":["lundi: ferm\u00e9","mardi, mercredi, jeudi et vendredi: de 14:00 \u00e0 17:30","samedi et dimanche: de 11:00 \u00e0 17:30"],"nl":["maandag: gesloten","dinsdag, woensdag, donderdag en vrijdag: van 14:00 tot 17:30","zaterdag en zondag: van 11:00 tot 17:30"]},"date_start":"2024-09-13","date_end":"2025-05-30","is_also_by_appointment":false}],"date_exceptions":[],"closing_days":["2024-11-01","2024-11-11","2024-12-25","2025-01-01","2025-05-01"],"child_events":[],"parent_events":[],"accessibilities":[],"visit_profile":{"list":[337],"translations":{"de":["Highlight"],"pt":[null],"en":["Highlight"],"it":["Highlight"],"cn":[null],"fr":["Highlight"],"sp":["Highlight"],"nl":["Highlight"]}},"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[],"opening":{"day":"2024-09-12","end":"21:00:00","start":"18:30:00","timestamp":"2024-09-12T18:30:00"}},{"id":5700001346,"date_start":"2024-10-22","date_end":"2025-03-02","date_next":"2024-11-22","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-11-22T01:01:55+01:00","published_at":"2024-09-17T11:08:42+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":307868,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"other","ranking":0.2474488015799764,"languages":{"spoken":["en","nl","fr"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[36],"translations":{"de":["Museen & Kunstzentren"],"pt":[null],"en":["Museums and art centers"],"it":["Musei e centri artistici"],"cn":[null],"fr":["Mus\u00e9es et art centers"],"sp":["Museos y centros de arte"],"nl":["Musea en kunstcentra"]}}},"translations":{"de":{"name":"UNDER-GROUND: The revealed palace","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/coudenberg.brussels\/UNDER-GROUND","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700001346"},"pt":{"name":"UNDER-GROUND: The revealed palace","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/coudenberg.brussels\/UNDER-GROUND","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700001346"},"en":{"name":"UNDER-GROUND: The revealed palace","shortdescr":"Come and experience the rediscovery of the Coudenberg Palace, from the vanished palace to the underground trail under the Royal Square.  ","longdescr":"22.10.2024 > 02.03.2025\nDuring the night between 3 and 4 February 1731, a fire destroyed the Coudenberg Palace in Brussels. For 40 years it remained in ruins and was later hidden under the new royal quarter. The now subterranean remains lived on in people's memories and gave rise to urban legends. Mysterious corridors? Secret passages? Testimonies fed the myth of a hidden city until archaeologists uncovered them.\n\nCome and experience the rediscovery of the Coudenberg Palace, from the vanished palace to the underground trail under the Royal Square.  \n\nThe urban planning upheavals in Brussels of the early 20th century led to a kind of nostalgia for times gone by. A \u00ab Comit\u00e9 d\u2019\u00e9tudes du Vieux-Bruxelles \u00bb (Study Committee of Old Brussels) was set up and the architecture of the Middle Ages and the Renaissance rediscovered, while Art Nouveau and Art Deco buildings sprang up. Driven by Belgian archivist and historian Alphonse Wauters, archive documents were studied and the first reconstructions of vanished buildings appeared. Brussels began investigating its past as well as the corridors and cellars that presumably belonged to an underground palace.\n\nWith the emergence of urban archaeology in the 1980s, excavations were undertaken and the reality of the findings in the field were compared with what was on record. Surprised by the extent of the remains of this former palace, Brussels residents rediscovered their city and the international importance of its history.\n\nThe UNDER-GROUND route through the Coudenberg Palace takes you on a rediscovery tour, uncovered by urban archaeology and modern reconstruction techniques. Route included in the admission price. Bring your own headphones for a more comfortable visit. Free WIFI available.   \n\nBuy your ticket in the BELvue webshop\nMade possible in cooperation with our partners: urban.brussels, La Ville de Bruxelles, Visit Brussels, Beliris, Sonuma and the asbl Mont des Arts.","performers":null,"boxoffice_url":null,"website":"https:\/\/coudenberg.brussels\/UNDER-GROUND","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700001346"},"it":{"name":"UNDER-GROUND: The revealed palace","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/coudenberg.brussels\/UNDER-GROUND","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700001346"},"cn":{"name":"UNDER-GROUND: The revealed palace","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/coudenberg.brussels\/UNDER-GROUND","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700001346"},"fr":{"name":"UNDER-GROUND : Le palais r\u00e9v\u00e9l\u00e9","shortdescr":"Venez vivre la red\u00e9couverte du palais du Coudenberg, du palais disparu au circuit de visite des souterrains de la place Royale. ","longdescr":"22.10.2024 > 02.03.2025\nDans la nuit du 3 au 4 f\u00e9vrier 1731, le palais du Coudenberg \u00e0 Bruxelles est ravag\u00e9 par un incendie. Laiss\u00e9 \u00e0 l\u2019\u00e9tat de ruines pendant 40 ans puis dissimul\u00e9 sous le nouveau quartier royal. Les vestiges, d\u00e9sormais souterrains, vont subsister dans les m\u00e9moires et faire naitre des l\u00e9gendes urbaines. Des couloirs myst\u00e9rieux ? Des passages secrets ? Les t\u00e9moignages alimentent le mythe d\u2019une ville cach\u00e9e, jusqu\u2019\u00e0 ce que les arch\u00e9ologues nous les r\u00e9v\u00e8lent.     \n\nVenez vivre la red\u00e9couverte du palais du Coudenberg, du palais disparu au circuit de visite des souterrains de la place Royale. \n\nLes grands bouleversements urbanistiques du d\u00e9but du 20e si\u00e8cle \u00e0 Bruxelles font naitre une forme de nostalgie des temps anciens. Un \u00ab Comit\u00e9 d\u2019\u00e9tudes du Vieux-Bruxelles \u00bb se met en place, on red\u00e9couvre l\u2019architecture du Moyen \u00c2ge et de la Renaissance, alors que les b\u00e2timents Art Nouveau puis Art D\u00e9co sortent de terre. Sous l\u2019impulsion d\u2019Alphonse Wauters, historien et archiviste belge, les documents d\u2019archives sont \u00e9tudi\u00e9s et les premi\u00e8res reconstitutions de b\u00e2timents disparus voient le jour. Bruxelles se met \u00e0 explorer son pass\u00e9 et les couloirs et caves soup\u00e7onn\u00e9s d\u2019appartenir \u00e0 un palais souterrain.\n\nAvec la naissance de l\u2019arch\u00e9ologie urbaine dans les ann\u00e9es 80 du 20e si\u00e8cle, des fouilles vont \u00eatre entreprises et la r\u00e9alit\u00e9 des d\u00e9couvertes de terrain se confronter aux documents d\u2019archives. Surpris par l\u2019\u00e9tendue des vestiges de cet ancien palais, les Bruxellois red\u00e9couvrent leur ville et la port\u00e9e internationale de son histoire.\n\nLe parcours UNDER-GROUND vous emm\u00e8ne \u00e0 la red\u00e9couverte de ce palais r\u00e9v\u00e9l\u00e9 par l\u2019arch\u00e9ologie urbaine et les techniques de reconstitution actuelles. Parcours compris dans le prix d\u2019entr\u00e9e. Apportez votre propre casque\/\u00e9couteurs pour un meilleur confort de visite. WI-FI gratuit disponible.   \n\nAchetez votre billet via le webshop BELvue\nMerci \u00e0 nos partenaires: urban.brussels, La Ville de Bruxelles, Visit Brussels, Beliris, Sonuma et l'asbl Mont des Arts.","performers":null,"boxoffice_url":null,"website":"https:\/\/coudenberg.brussels\/UNDER-GROUND","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700001346"},"sp":{"name":"UNDER-GROUND: The revealed palace","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/coudenberg.brussels\/UNDER-GROUND","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700001346"},"nl":{"name":"UNDER-GROUND: Het onthulde paleis","shortdescr":"Kom en beleef de herontdekking van het Coudenbergpaleis, van het verdwenen paleis tot het ondergrondse parcours onder het Koningsplein. ","longdescr":"22.10.2024 > 02.03.2025\nIn de nacht van 3 op 4 februari 1731 werd het Coudenbergpaleis in Brussel door een brand verwoest. 40 jaar lang bleef het in puin liggen en later verborgen onder de nieuwe koninklijke wijk. De nu onderaardse overblijfselen leefden voort in het geheugen van de mensen en gaven aanleiding tot stadslegendes. Mysterieuze gangen? Geheime doorgangen? Getuigenissen voedden de mythe van een verborgen stad, totdat archeologen ze aan het licht brachten.  \n\nKom en beleef de herontdekking van het Coudenbergpaleis, van het verdwenen paleis tot het ondergrondse parcours onder het Koningsplein. \n\nDe stedenbouwkundige opschuddingen in Brussel van het begin van de 20e eeuw leidden tot een soort nostalgie naar vervlogen tijden. Er werd een \"Comit\u00e9 d\u2019\u00e9tudes du Vieux-Bruxelles\" (Studiecomit\u00e9 voor Oud-Brussel) opgericht en de architectuur van de Middeleeuwen en de Renaissance werd herontdekt, terwijl Art Nouveau en Art Deco gebouwen verrezen. Onder impuls van Belgisch historicus en archivaris Alphonse Wauters werden archiefdocumenten bestudeerd en verschenen de eerste reconstructies van verdwenen gebouwen. Brussel begon een onderzoek naar zijn verleden en de gangen en kelders die vermoedelijk tot een ondergronds paleis behoorden.\n\nMet het ontstaan van de stadsarcheologie in de jaren 80 van de 20e eeuw werden opgravingen ondernomen en de realiteit van de vondsten op het terrein vergeleken met archiefdocumenten. Verrast door de omvang van de overblijfselen van dit voormalige paleis, herontdekten de Brusselaars hun stad en het internationale belang van haar geschiedenis.\n\nDe UNDER-GROUND route door het Coudenbergpaleis neemt je mee op herontdekkingstocht, blootgelegd door de stadsarcheologie en moderne reconstructietechnieken. Route inbegrepen in de toegangsprijs. Neem je eigen koptelefoon mee voor een comfortabeler bezoek. Gratis WIFI beschikbaar. \n\nKoop je ticket in de BELvue webshop\nBedankt aan onze partners: urban.brussels, Stad Brussel, Visit Brussels, Beliris, Sonuma en de vzw Kunstberg.","performers":null,"boxoffice_url":null,"website":"https:\/\/coudenberg.brussels\/UNDER-GROUND","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700001346"}},"place":{"id":258195,"translations":{"de":{"name":"Coudenberg Palast","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@coudenberg.brussels","website":"http:\/\/www.coudenberg.brussels","phone_contact":"+32 2 500 45 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"Ein unterirdischer Parcours, in dessen Verlauf Sie die \u00dcberreste des Palastes von Charles V. entdecken k\u00f6nnen. Seit dem Mittelalter \u00fcberragt eine f\u00fcrstliche Residenz auf dem Coudenberg die Stadt Br\u00fcssel. Das architektonische Ensemble, das sich seit dem 12. Jahrhundert immer wieder weiterentwickelt hat, gilt als einer der sch\u00f6nsten Pal\u00e4ste Europas und eine der wichtigsten Residenzen von Karl V. Dieses prestigetr\u00e4chtige Geb\u00e4ude wurde bei einem Brand im Februar 1731 schwer besch\u00e4digt. Vierzig Jahre sp\u00e4ter wurden die Ruinen des Palasts dem Erdboden gleichgemacht, um Platz f\u00fcr den Place Royale zu machen. Die \u00dcberreste dieses Geb\u00e4udes bilden heute die arch\u00e4ologische St\u00e4tte des Coudenberg. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Palais du Coudenberg","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@coudenberg.brussels","website":"http:\/\/www.coudenberg.brussels","phone_contact":"+32 2 500 45 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Coudenberg Palace","address_street_name":"Paleizenplein","address_street_number":"7","address_street_box":null,"email":"info@coudenberg.brussels","website":"http:\/\/www.coudenberg.brussels","phone_contact":"+32 2 500 45 54","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Paleizenplein, 7","address_line2":"1000 Brussels","description_web":"Once upon a time, the Coudenberg Palace towered over the city of Brussels. Charles V and many other of the most powerful rulers ever to reign in Europe made this princely residence their home between the 12th and 18th centuries, until it was consumed by a terrible fire.  Every trace of this prestigious palace simply disappeared underground for many years. Today, however, these ruins constitute a fascinating archeological site incorporating a network of underground passages and chambers.\r\n \r\nWhen you visit it you can explore the principal buildings of the palace and enjoy a stroll along the Rue Isabelle, which is now underground.  In the Coudenberg Museum, located in Hoogstraeten House, the finest of the archeological discoveries made during the various excavations of the Coudenberg site are displayed.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Coudenberg Palazzo","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@coudenberg.brussels","website":"http:\/\/www.coudenberg.brussels","phone_contact":"+32 2 500 45 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"\"Il sito archeologico di Coudenberg vi svela un percorso sotterraneo e un museo dedicati a Carlo V sulla Place de Palais a Bruxelles.\tSito Archeologico di Coudenbergl sito...\"\r\n\r\nIl sito archeologico di Coudenberg vi svela un percorso sotterraneo e un museo dedicati a Carlo V sulla Place de Palais a Bruxelles.\r\n\r\nSito Archeologico di Coudenberg\r\n\r\nl sito riunisce vestigia dell'antico palazzo di Bruxelles, della residenza di Hoogstraeten e della Rue Isabelle. Un'affascinante passeggiata che vi conduce sotto il pav\u00e9 della place Royale, alla scoperta dei resti del Palazzo di Coudenberg che fu una delle residenze principali di Carlo V. \u00a0\r\n\r\nMuseo del Coudenberg\r\nil museo vi invita a scoprire un'esposizione permanente di oggetti trovati durante gli scavi effettuati sul sito negli ultimi 25 anni. potete combinare la vostra visita con quella del Museo BELvue.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Palais du Coudenberg","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@coudenberg.brussels","website":"http:\/\/www.coudenberg.brussels","phone_contact":"+32 2 500 45 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Palais du Coudenberg","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@coudenberg.brussels","website":"http:\/\/www.coudenberg.brussels","phone_contact":"+32 2 500 45 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"Autrefois, l\u2019impressionnant palais du Coudenberg dominait la ville de Bruxelles. Charles Quint et d\u2019autres souverains parmi les plus puissants que l\u2019Europe ait connus ont habit\u00e9 cette r\u00e9sidence princi\u00e8re du 12e au 18e si\u00e8cle, jusqu\u2019\u00e0 ce qu\u2019un terrible incendie la d\u00e9truise \u00e0 jamais. Les ruines de ce palais ont disparu pendant de nombreuses ann\u00e9es dans les sous-sols. Aujourd\u2019hui, ces vestiges forment un site arch\u00e9ologique enchanteur constitu\u00e9 d\u2019un r\u00e9seau de salles et de passages souterrains.\r\n \r\nAu cours de votre visite, vous d\u00e9couvrirez les b\u00e2timents principaux du palais et vous fl\u00e2nerez dans la rue Isabelle, qui est aujourd\u2019hui souterraine. Dans le mus\u00e9e du Coudenberg, qui est abrit\u00e9 dans l\u2019h\u00f4tel d\u2019Hoogstraeten, sont expos\u00e9es les plus belles d\u00e9couvertes arch\u00e9ologiques effectu\u00e9es lors des diff\u00e9rentes campagnes de fouilles men\u00e9es sur le site du Coudenberg\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Coudenberg Palacio","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@coudenberg.brussels","website":"http:\/\/www.coudenberg.brussels","phone_contact":"+32 2 500 45 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"En el emplazamiento arqueol\u00f3gico de Coudenberg encontrar\u00e1s un recorrido subterr\u00e1neo y un museo dedicado al Palacio Carlos V, en la Place des Palais de Bruselas....\r\n\r\nEn el emplazamiento arqueol\u00f3gico de Coudenberg encontrar\u00e1s un recorrido subterr\u00e1neo y un museo dedicado al Palacio Carlos V, en la Place des Palais de Bruselas.\r\n\r\nEl emplazamiento arqueol\u00f3gico Coudenberg\r\n\r\nEl emplazamiento arqueol\u00f3gico Coudenberg est\u00e1 compuesto de vestigios del antiguo Palacio de Bruselas, del Hotel Hoogstraeten y de la Rue Isabelle.\u00a0Este fascinante paseo te llevar\u00e1 a descubrir los vestigios del Palacio Coudenberg, que fue una de las residencias de Carlos V.\r\n\r\nMuseo Coudenberg\r\n\r\nInstalado en los vestigios del antiguo Hotel de Hoogstraeten, el Museo Coudenberg  te invita a descubrir una exposici\u00f3n permanente de objetos hallados durante las distintas excavaciones arqueol\u00f3gicas realizadas los \u00faltimos 25 a\u00f1os.\u00a0Podr\u00e1s combinar tu visita del Coudenberg con la del Museo BELvue.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Coudenbergpaleis","address_street_name":"Paleizenplein","address_street_number":"7","address_street_box":null,"email":"info@coudenberg.brussels","website":"http:\/\/www.coudenberg.brussels","phone_contact":"+32 2 500 45 54","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Paleizenplein, 7","address_line2":"1000 Brussel","description_web":"Ooit werd Brussel gedomineerd door het reusachtige Coudenbergpaleis. Keizer Karel en het kruim van de Europese adel verbleven er tussen de twaalfde en de achttiende eeuw. Tot het noodlot toesloeg en een brand het prachtige gebouw verwoestte. Vele resten bleven echter intact en verdwenen ... onder de grond. Nu is het een betoverende archeologische site, een netwerk van gewelfde gangen, zalen en verborgen kamers.\r\n \r\nTijdens een bezoek ontdek je de hoofdgebouwen van het paleis en flaneer je door de Isabellastraat, die nu onder de grond ligt! In het museum van de Coudenberg, dat in het bovengrondse Hof van Hoogstraeten ondergebracht is, kan je de mooiste archeologische voorwerpen bewonderen die in de loop van de verschillende opgravingswerken op de Coudenbergsite werden ontdekt.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[16],"translations":{"de":["K\u00f6nigliches Viertel"],"pt":[null],"en":["Royal"],"it":["Quartiere reale"],"cn":[null],"fr":["Quartier Royal"],"sp":["Quartier Royal \u2014Barrio de la Corte\u2014"],"nl":["Koninklijke wijk"]}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":null,"facebook_id":null,"backoffice_id":18195,"location":{"lat":50.8426107,"lon":4.3606882},"region":"brussels","last_updated_at":"2024-06-14T16:22:27+02:00","published_at":"2014-05-05T10:58:29+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":258195,"translations":{"de":{"name":"Coudenberg Palast","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@coudenberg.brussels","website":"http:\/\/www.coudenberg.brussels","phone_contact":"+32 2 500 45 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"Ein unterirdischer Parcours, in dessen Verlauf Sie die \u00dcberreste des Palastes von Charles V. entdecken k\u00f6nnen. Seit dem Mittelalter \u00fcberragt eine f\u00fcrstliche Residenz auf dem Coudenberg die Stadt Br\u00fcssel. Das architektonische Ensemble, das sich seit dem 12. Jahrhundert immer wieder