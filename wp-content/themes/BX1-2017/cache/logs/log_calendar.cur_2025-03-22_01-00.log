ongdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/culture.ulb.be","email":"culture@ulb.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700006661"},"it":{"name":"Man\u0153uvres et mutations \u2013 Le printemps de la Plaine","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/culture.ulb.be","email":"culture@ulb.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700006661"},"cn":{"name":"Man\u0153uvres et mutations \u2013 Le printemps de la Plaine","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/culture.ulb.be","email":"culture@ulb.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700006661"},"fr":{"name":"Man\u0153uvres et mutations \u2013 Le printemps de la Plaine","shortdescr":"\u00c0 l\u2019occasion des 50 ans du campus de la Plaine, ULB Culture vous invite \u00e0 d\u00e9couvrir Man\u0153uvres et mutations, une exposition en ext\u00e9rieur qui retrace l\u2019histoire fascinante de ce campus embl\u00e9matique. Pr\u00e9sent\u00e9e dans le cadre du Printemps de la Plaine, cette exposition propose un parcours immersif qui revient sur l\u2019origine, l\u2019\u00e9volution et les nombreux\u00b7ses acteurs et actrices ayant marqu\u00e9 la Plaine.","longdescr":"En 2025, le campus de la Plaine de l\u2019Universit\u00e9 libre de Bruxelles, situ\u00e9 sur la commune d\u2019Ixelles, c\u00e9l\u00e8bre son 50\u1d49 anniversaire avec une s\u00e9rie d\u2019activit\u00e9s. Sous l\u2019appellation \u00ab Le Printemps de la Plaine \u00bb, ce moment fort de la vie universitaire mettra \u00e0 l\u2019honneur l\u2019histoire, l\u2019\u00e9volution et l\u2019impact de ce campus embl\u00e9matique de l\u2019ULB \u00e0 travers une programmation vari\u00e9e m\u00ealant culture, conf\u00e9rences, festivit\u00e9s et d\u00e9couvertes.\n\n \n\nLe lancement des festivit\u00e9s aura lieu week-end du 28 et 29 mars. De nombreuses animations inviteront la communaut\u00e9 universitaire et le grand public \u00e0 red\u00e9couvrir ce campus sous un nouveau jour. De la Jefke, lieu incontournable du folklore \u00e9tudiant, aux figures scientifiques qui ont marqu\u00e9 l\u2019histoire de l\u2019ULB, cette c\u00e9l\u00e9bration mettra en lumi\u00e8re l\u2019identit\u00e9 unique de la Plaine et son impact au fil des d\u00e9cennies. Au programme : expositions, conf\u00e9rences, performances et moments conviviaux pour retracer cinq d\u00e9cennies d\u2019innovations architecturales, scientifiques et humaines.\n\n \n\nUne immersion dans l\u2019histoire du campus avec l\u2019exposition \u00ab Man\u0153uvres et mutations \u00bb\n\n \n\nParmi les temps forts du Printemps de la Plaine, l\u2019exposition en plein air \u00ab Man\u0153uvres et mutations \u00bb propose un voyage \u00e0 travers l\u2019histoire du campus. Accessible du 28 mars au 1er juin 2025, cette exposition immersive revient sur la naissance de la Plaine, son \u00e9volution architecturale et son r\u00f4le central dans la vie acad\u00e9mique, scientifique et estudiantine.\n\n \n\nLe vernissage aura lieu le 28 mars \u00e0 18h et marquera officiellement le lancement des festivit\u00e9s du Printemps de la Plaine.\n\nInscription via ce lien : https:\/\/forms.office.com\/e\/NMPaTVY9V1.\n\n \n\nUn week-end festif \u00e0 ne pas manquer\n\n \n\n \n\nLieu : campus de la Plaine, ULB\n\n\nDates cl\u00e9s :\n\n28 et 29 mars 2025 : Week-end festif d\u2019ouverture\n28 mars \u2013 1er juin 2025 : Exposition Man\u0153uvres et mutations\n \n\nPlus d\u2019infos : ulb.be\/50ansplaine","performers":"Olivier Markowitch, vice-Doyen de la Facult\u00e9 des Sciences \u2013 Commissaire g\u00e9n\u00e9ral de l\u2019exposition\nRenaud Bardez, directeur de la Biblioth\u00e8que des Sciences humaines Simone Veil\nSerge Jaumain, professeur d\u2019histoire contemporaine, ULB\nHubert Lionnez, professeur d\u2019architecture, ULB\nBeno\u00eet Moritz, professeur d\u2019architecture, ULB\nMarcelle Rabinowitz, doyenne de la Facult\u00e9 d'Architecture La Cambre Horta-ULB","boxoffice_url":null,"website":"https:\/\/culture.ulb.be","email":"culture@ulb.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700006661"},"sp":{"name":"Man\u0153uvres et mutations \u2013 Le printemps de la Plaine","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/culture.ulb.be","email":"culture@ulb.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700006661"},"nl":{"name":"Man\u0153uvres et mutations \u2013 Le printemps de la Plaine","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/culture.ulb.be","email":"culture@ulb.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700006661"}},"place":{"id":223791,"translations":{"de":{"name":"ULB - Campus de la Plaine","address_street_name":"bd. du Triomphe \/ bd. de la Plaine","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"bd. du Triomphe \/ bd. de la Plaine","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"ULB - Campus de la Plaine","address_street_name":"bd. du Triomphe \/ bd. de la Plaine","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"bd. du Triomphe \/ bd. de la Plaine","addres