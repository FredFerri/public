tegories":{"main":{"id":90,"translations":{"de":"Animationen","pt":null,"en":"Animations","it":"Animazioni","cn":null,"fr":"Animations","sp":"Animaciones","nl":"Animaties"}},"others":{}},"translations":{"de":{"name":"Matin de PAC \u2013 Isra\u00ebl-Palestine : Comment r\u00e9sister \u00e0 la propagande ?","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/miniurl.be\/r-5vf3","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700005303"},"pt":{"name":"Matin de PAC \u2013 Isra\u00ebl-Palestine : Comment r\u00e9sister \u00e0 la propagande ?","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/miniurl.be\/r-5vf3","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700005303"},"en":{"name":"Matin de PAC \u2013 Isra\u00ebl-Palestine : Comment r\u00e9sister \u00e0 la propagande ?","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/miniurl.be\/r-5vf3","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700005303"},"it":{"name":"Matin de PAC \u2013 Isra\u00ebl-Palestine : Comment r\u00e9sister \u00e0 la propagande ?","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/miniurl.be\/r-5vf3","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700005303"},"cn":{"name":"Matin de PAC \u2013 Isra\u00ebl-Palestine : Comment r\u00e9sister \u00e0 la propagande ?","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/miniurl.be\/r-5vf3","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700005303"},"fr":{"name":"Matin de PAC \u2013 Isra\u00ebl-Palestine : Comment r\u00e9sister \u00e0 la propagande ?","shortdescr":null,"longdescr":"La propagande permet de justifier l\u2019injustifiable.  Elle contribue \u00e0 faire passer un nettoyage ethnique pour un conflit. Elle invisibilise le non-respect du droit international et place les \u0153ill\u00e8res qui d\u00e9terminent le regard que nous portons face \u00e0 une situation d\u2019injustice flagrante.\nComment sortir de l\u2019engrenage qui entrave notre capacit\u00e9 \u00e0 d\u00e9finir qui est l\u2019oppresseur et qui est l\u2019opprim\u00e9 ?\n\nDe quelles armes disposons-nous face \u00e0 cette fabrique du consentement qui nous fait accepter l\u2019ambition des dirigeants isra\u00e9liens d\u2019effacer Gaza et ses habitant\u00b7es et d\u2019annexer la Cisjordanie?\n\nComment d\u00e9busquer les pi\u00e8ges d\u2019un discours qui semble rencontrer l\u2019adh\u00e9sion des m\u00e9dias en Occident ?\n\nCe sont les questions que nous poserons \u00e0 nos intervenant\u00b7es du jour, apr\u00e8s un atelier de d\u00e9construction participatif.","performers":"Anthony Bellanger, secr\u00e9taire g\u00e9n\u00e9ral de la F\u00e9d\u00e9ration internationale des journalistes\nRami ABOU Jamous journaliste palestinien\nEitan Bronstein Aparicio, citoyen isra\u00e9lien, fondateur de l\u2019organisation Zochrot qui sensibilise les Isra\u00e9liens au droit au retour des r\u00e9fugi\u00e9s palestiniens\nMarianne Blume, militante au sein de l\u2019Association Belgo-Palestinienne","boxoffice_url":null,"website":"https:\/\/miniurl.be\/r-5vf3","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700005303"},"sp":{"name":"Matin de PAC \u2013 Isra\u00ebl-Palestine : Comment r\u00e9sister \u00e0 la propagande ?","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/miniurl.be\/r-5vf3","email":null,"phone_contact"