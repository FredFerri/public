"ranking":0.21839511618407473,"languages":{"spoken":["fr","en","nl"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{"list":[250],"translations":{"de":["Surrealismus"],"pt":[null],"en":["Surrealism"],"it":["Surrealismo"],"cn":[null],"fr":["Surr\u00e9alisme"],"sp":["Surrealismo"],"nl":["Surrealisme"]}}},"translations":{"de":{"name":"In the tracks of Magritte","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.surlestracesdemagritte.be","email":"info@bmeo.be","phone_contact":"+32 2 318 64 70","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50000067"},"pt":{"name":"In the tracks of Magritte","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.surlestracesdemagritte.be","email":"info@bmeo.be","phone_contact":"+32 2 318 64 70","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50000067"},"en":{"name":"In the tracks of Magritte","shortdescr":"On the occasion of Ren\u00e9 Magritte's 125th birthday, the Magritte Foundation, the Magritte Museum and the City of Brussels invited street artist Julien de Casabianca to explore Magritte's work. From 30.06 to 07.01.24, eight monumental collages by the artist will be on display on 8 facades in Brussels. The iconic 'men in bowler hats' will accompany you from the Place De Brouck\u00e8re to the Place Royale.","longdescr":null,"performers":"The artist Julien de Casabianca, a master of his discipline, creates pop-up XXL collages on iconic fa\u00e7ades around the world. His work is respectful of the environment and poses no risk of damage to the fa\u00e7ades which support these temporary collages.","boxoffice_url":null,"website":"http:\/\/www.inthetracksofmagritte.be","email":"info@bmeo.be","phone_contact":"+32 2 318 64 70","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50000067"},"it":{"name":"In the tracks of Magritte","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.surlestracesdemagritte.be","email":"info@bmeo.be","phone_contact":"+32 2 318 64 70","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50000067"},"cn":{"name":"In the tracks of Magritte","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.surlestracesdemagritte.be","email":"info@bmeo.be","phone_contact":"+32 2 318 64 70","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50000067"},"fr":{"name":"Sur les traces de Magritte","shortdescr":"\u00c0 l'occasion du 125e anniversaire de la naissance de Ren\u00e9 Magritte, la Fondation Magritte, le Mus\u00e9e Magritte et la Ville de Bruxelles ont invit\u00e9 le street artiste Julien de Casabianca \u00e0 explorer l'\u0153uvre de Magritte. 8 collages monumentaux ornent autant de fa\u00e7ades de Bruxelles, du 30.06.23 au 07.01.24. Les iconiques \"hommes au chapeau melon\" vous guident de la place De Brouck\u00e8re \u00e0 la place Royale","longdescr":null,"performers":"L\u2019artiste Julien de Casabianca, ma\u00eetre dans sa discipline, r\u00e9alise des collages XXL \u00e9ph\u00e9m\u00e8res sur des fa\u00e7ades iconiques dans le monde entier. Son travail est respectueux de son environnement et ne repr\u00e9sente aucun risque de d\u00e9gradation pour les fa\u00e7ades qui supportent ces collages temporaires.","boxoffice_url":null,"website":"http:\/\/www.surlestracesdemagritte.be","email":"info@bmeo.be","phone_contact":"+32 2 318 64 70","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50000067"},"sp":{"name":"In the tracks of Magritte","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.surlestracesdemagritte.be","email":"info@bmeo.be","phone_contact":"+32 2 318 64 70","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50000067"},"nl":{"name":"In het spoor van Magritte","shortdescr":"Ter gelegenheid van de 125ste verjaardag van Ren\u00e9 Magritte nodigden de Stichting Magritte, het Magritte Museum en de Stad Brussel straatkunstenaar Julien de Casabianca uit om het werk van Magritte te verkennen. Van 30.06 tot 07.01.24 zijn 8 XXL collages van de kunstenaar te zien op 8 gevels in Brussel.\nDe iconische 'mannen met bolhoeden' begeleiden u van het De Brouck\u00e8replein tot het Koningsplein.","longdescr":null,"performers":"Kunstenaar Julien de Casabianca, een meester in zijn discipline, maakt tijdelijke XXL-collages op iconische gevels over de hele wereld. Zijn werk is gebaseerd op het respect voor de omgeving en vormt geen enkel risico op schade aan de gevels waarop deze tijdelijke collages aangebracht worden.","boxoffice_url":null,"website":"http:\/\/www.inhetspoorvanmargritte.be","email":"info@bmeo.be","phone_contact":"+32 2 318 64 70","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50000067"}},"place":{"id":236112,"translations":{"de":{"name":"Place de Brouck\u00e8re","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de Brouck\u00e8re","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Place de Brouck\u00e8re","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxel