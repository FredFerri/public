:4.36268486},"region":"brussels","last_updated_at":"2022-05-12T10:35:10+02:00","published_at":"2013-10-19T01:13:49+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/5e0a320e78ebbdef5207d1428db8a52d954afad8.jpg","width":2446,"height":1950,"ratio":1.25,"translations":{"fr":{"title":"Anderlecht : M\u00e9moire des B\u00e9guines, Saint Guidon et Erasme","copyright":"Maison Erasme"},"nl":{"title":"Anderlecht : M\u00e9moire des B\u00e9guines, Saint Guidon et Erasme","copyright":"Maison Erasme"},"en":{"title":"Anderlecht : M\u00e9moire des B\u00e9guines, Saint Guidon et Erasme","copyright":"Maison Erasme"}}}],"dates":[],"weekschema":[{"days":{"monday":{"is_open":false},"tuesday":{"is_open":false},"wednesday":{"is_open":false},"thursday":{"is_open":false},"friday":{"is_open":false},"saturday":{"is_open":false},"sunday":{"is_open":false}},"translations":{"fr":["lundi, mardi, mercredi, jeudi, vendredi, samedi et dimanche: ferm\u00e9"],"nl":["maandag, dinsdag, woensdag, donderdag, vrijdag, zaterdag en zondag: gesloten"],"en":["monday, tuesday, wednesday, thursday, friday, saturday and sunday: closed"]},"date_start":"2022-06-18","date_end":"2022-07-10","is_also_by_appointment":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":160}],"child_events":[],"parent_events":[532743],"targets":{"list":[],"translations":{}},"visit_profile":{"list":[320],"translations":{"fr":["Classique"],"nl":["Klassiek"],"en":["Classic"]}},"visit_content":{"list":[428],"values":["brussels-renaissance-festival"]},"tags":[],"accessibilities":{"list":[252,255,256,257,259,261,263],"translations":{"fr":["Accessible aux personnes ayant des difficult\u00e9s de compr\u00e9hension","Accessible","Am\u00e9nagements pour les personnes aveugles et malvoyantes","Am\u00e9nagements pour personnes sourdes et malentendantes","Chien d'assistance","Parking accessible","Accessible aux pi\u00e9tons appareill\u00e9s"],"nl":["Toegankelijk voor mensen met een verstandelijke beperking","Toegankelijk","Voorzieningen voor blinde en slechtziende personen","Voorzieningen voor dove en slechthorende personen","Assistentiehonden","Toegankelijke parking","Toegankelijk voor voetgangers met hulpmiddelen"],"en":["Accessible to people with intellectual disabilities","Accessible","Facilities for blind and partially-sighted persons","Facilities for deaf and hearing-impaired people","Assistance dogs","Accessible parking","Accessible to pedestrians with mobility aids"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-05-12T10:35:10+02:00","published_at":"2022-04-29T10:06:24+02:00","backoffice_id":252815,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.44303093598303},{"id":532816,"date_start":"2022-06-18","date_end":"2022-07-10","date_next":"2022-07-10","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Bruegel et ses Marolles","shortdescr":null,"longdescr":"Au travers d\u2019un itin\u00e9raire p\u00e9destre, d\u00e9couvrez les Marolles du XVIe si\u00e8cle\u2026 et plus sp\u00e9cifiquement autour de ce personnage embl\u00e9matique de notre culture artistique : Bruegel. Pieter Bruegel, qui habite alors \u00e0 Anvers, tombe amoureux de la fille de son ma\u00eetre Pieter Coecke van Aelst. Pour autoriser le mariage, sa future belle-m\u00e8re met comme condition de voir le couple vivre \u00e0 Bruxelles. Quelque mois apr\u00e8s leurs fian\u00e7ailles, c\u2019est en l\u2019\u00e9glise Notre-Dame de la Chapelle, dans les Marolles, que leur union devient officielle.Les jeunes \u00e9poux s\u2019\u00e9tablissent dans ce quartier chic, appel\u00e9 aujourd\u2019hui le quartier Bruegel, et fr\u00e9quent\u00e9 \u00e0 l\u2019\u00e9poque par l\u2019\u00e9lite et les artistes.T\u00e9moin d\u2019une p\u00e9riode trouble avec une situation politique et religieuse instable, Bruegel est contemporain de Charles Quint, de son fils et successeur, ou encore du du Duc D\u2019Albe ; il assistera \u00e0 l\u2019ex\u00e9cution des comtes d\u2019Egmont et de Hornes. Il vivra \u00e0 Bruxelles jusqu\u2019\u00e0 sa mort en 1569 o\u00f9 il sera enseveli dans la m\u00eame \u00e9glise qui l\u2019avait sacr\u00e9 au mariage.\r\n\r\nR\u00e9servation obligatoire et mise \u00e0 disposition d'un guide pendant 2h.","performers":null,"boxoffice_url":null,"website":null,"email":"info@itineraires.be","phone_contact":"+32 2 541 03 77","phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/532816.html"},"nl":{"name":"Bruegel en zijn Marollen","shortdescr":null,"longdescr":"Pieter Bruegel die in Antwerpen woonde, werd verliefd op de dochter van zijn meester Pieter Coecke van Aelst.. Haar toekomstige schoonmoeder wilde het paar zien wonen in Brussel als huwelijksvoorwaarde. Enkele maanden na hun verloving vond hun huwelijk officieel plaats in de Onze-Lieve-Vrouwe-ter-Kapellekerk in de Marollen. Bruegel is getuige van een turbulente periode met een onstabiele politiek en religieus regime. Hij heeft gewoond in Brussel tot aan zijn dood in 1569, hij wordt begraven in de Kapellekerk. \r\n\r\nReserveren is verplicht en een gids is beschikbaar voor 2 uur.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/532816.html"},"en":{"name":"Bruegel and his Marolles","shortdescr":null,"longdescr":"Discover the Marolles of the 16th century on this walking tour... and more specifically this emblematic character of our artistic culture: Bruegel. Pieter Bruegel, who lived in Antwerp, fell in love with the daughter of his master Pieter Coecke van Aelst. To allow the marriage, his future mother-in-law insisted that the couple live in Brussels. After a few months engaged, the couple made their union official in Chapel Church in the Marolles. A witness to a troubled political and religious period, Bruegel was a contemporary of Charles V, his successor Philip the Second, the Duke D\u2019Albe, and would witness the execution of the Counts of Egmont and Hornes. \r\n\r\nReservation is required for a 2 hours guided tour.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/532816.html"},"de":{"name":"Bruegel et ses Marolles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/532816.html"},"it":{"name":"Bruegel et ses Marolles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/532816.html"},"sp":{"name":"Bruegel y sus Marolles","shortdescr":null,"longdescr":"A trav\u00e9s de una ruta a pie, descubre Les Marolles del siglo XVI... y m\u00e1s concretamente en torno a este car\u00e1cter emblem\u00e1tico de nuestra cultura art\u00edstica: Bruegel. Pieter Bruegel, que entonces viv\u00eda en Amberes, se enamor\u00f3 de la hija de su amo, Pieter Coecke van Aelst. Para autorizar el matrimonio, su futura suegra pone como condici\u00f3n para que la pareja viva en Bruselas. Pocos meses despu\u00e9s de su compromiso, su uni\u00f3n se hizo oficial en la iglesia de Notre-Dame de la Chapelle, en Les Marolles, y la joven pareja se instal\u00f3 en este elegante barrio, hoy llamado Barrio de Bruegel, frecuentado entonces por la \u00e9lite y los artistas. Testigo de una \u00e9poca agitada con una situaci\u00f3n pol\u00edtica y religiosa inestable, Bruegel fue contempor\u00e1neo de Carlos V, su hijo y sucesor, y del duque de Alba; tambi\u00e9n fue testigo de la ejecuci\u00f3n de los condes de Egmont y Hornes. Vivi\u00f3 en Bruselas hasta su muerte en 1569, donde fue enterrado en la misma iglesia que lo consagr\u00f3 al casarse. \r\n\r\nEs necesario reservar y un gu\u00eda est\u00e1 disponible durante 2 horas.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/532816.html"},"pt":{"name":"Bruegel et ses Marolles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/532816.html"},"cn":{"name":"Bruegel et ses Marolles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/532816.html"}},"place":{"id":203657,"translations":{"fr":{"name":"Porte de Hal - MRAH","address_street_name":"Boulevard du Midi","address_street_number":"150","address_street_box":null,"email":"portedehal@mrah.be","website":"http:\/\/www.portedehal.be","phone_contact":"+32 2 534 15 18","phone_booking":"+32 2 533 34 51","address_zip":"1000","address_city":"Bruxelles","address_line1":"Boulevard du Midi, 150","address_line2":"1000 Bruxelles","description_web":"Ce monument f\u00e9erique, vieux de plus de 600 ans, constitue le t\u00e9moin le plus remarquable du pass\u00e9 m\u00e9di\u00e9val de la ville.\r\nDernier vestige de la seconde enceinte de Bruxelles, la porte de Hal accueille aujourd\u2019hui une belle collection d\u2019\u0153uvres et de multiples supports didactiques mettant en lumi\u00e8re son histoire et celle des fortifications bruxelloises. La fa\u00e7ade n\u00e9ogothique et la haute toiture ajout\u00e9es par l\u2019architecte Henry Beyaert au XIXe si\u00e8cle n\u2019ont rien enlev\u00e9 \u00e0 la splendeur des salles m\u00e9di\u00e9vales \u00e0 l\u2019int\u00e9rieur du b\u00e2timent. Au sommet de la tour, depuis le chemin de ronde cr\u00e9nel\u00e9, vous pourrez profiter d\u2019un spectaculaire panorama sur Bruxelles et sa r\u00e9gion. Une visite id\u00e9ale pour enfants et adultes.","description_print":"Ce monument f\u00e9\u00e9rique, vieux de plus de 600 ans, constitue le t\u00e9moin le plus remarquable du pass\u00e9 m\u00e9di\u00e9val de la ville. Dernier vestige de la seconde enceinte de Bruxelles, la porte de Hal accueille aujourd\u2019hui une belle collection d\u2019\u0153uvres et de multiples supports didactiques mettant en lumi\u00e8re son histoire et celle des fortifications bruxelloises. La fa\u00e7ade n\u00e9ogothique et la haute toiture ajout\u00e9es par l\u2019architecte Henry Beyaert au XIXe si\u00e8cle n\u2019ont rien enlev\u00e9 \u00e0 la splendeur des salles m\u00e9di\u00e9vales \u00e0 l\u2019int\u00e9rieur du b\u00e2timent. Au sommet de la tour, depuis le chemin de ronde cr\u00e9nel\u00e9, vous pourrez profiter d\u2019un spectaculaire panorama sur Bruxelles et sa r\u00e9gion. Une visite id\u00e9ale pour enfants et adultes.","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Hallepoort \u2013 KMKG","address_street_name":"Zuidlaan","address_street_number":"150","address_street_box":null,"email":"portedehal@mrah.be","website":"http:\/\/www.hallepoortmuseum.be","phone_contact":"+32 2 534 15 18","phone_booking":"+32 2 533 34 51","address_zip":"1000","address_city":"Brussel","address_line1":"Zuidlaan, 150","address_line2":"1000 Brussel","description_web":"De Hallepoort is een sprookjesachtig monument, meer dan 600 jaar oud en de meest opmerkelijke getuige van het middeleeuwse verleden van de stad Brussel.\r\nDe Hallepoort is het laatste overblijfsel van de tweede omwalling van Brussel. Vandaag vind je er een prachtige collectie kunstwerken en vele didactische hulpmiddelen rond de geschiedenis van de Brusselse omwallingen en de stedelijke ambachtsgilden.\r\nDe neogotische fa\u00e7ade en het hoge dak, toegevoegd door architect Henry Beyaert in de 19de eeuw hebben niets afgedaan aan de pracht van de middeleeuwse zalen binnenin het gebouw.\r\nBoven op de toren kan je genieten van een spectaculair panorama over Brussel en omgeving.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Halle Gate \u2013 RMAH","address_street_name":"Boulevard du Midi","address_street_number":"150","address_street_box":null,"email":"portedehal@mrah.be","website":"http:\/\/www.kmkg-mrah.be\/halle-gate","phone_contact":"+32 2 534 15 18","phone_booking":"+32 2 533 34 51","address_zip":"1000","address_city":"Brussels","address_line1":"Boulevard du Midi, 150","address_line2":"1000 Brussels","description_web":"This last preserved gate will catapult you centuries back. An interactive tour through the striking rooms of the 14th century city gate will reveal how Brussels defended itself against external attacks during the Middle Ages and present the role that townspeople played in defence of their city. Visitors will gain a better understanding of the medieval city and its impact on present-day metropolitan Brussels by trying on a piece of armour, checking out models and short films,  exploring multimedia activities or just simply admiring the beautiful selection of museum pieces.\r\nAnd, the changing temporary exhibits on past and current life in the city are always a great reason to return to the Halle Gate. Best of all, the crenellated walkway around the top of the monument offers a spectacular view of the sprawling capital.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Porte de Hal - K\u00f6nigliche Museen f\u00fcr Kunst und Geschichte","address_street_name":"Boulevard du Midi","address_street_number":"150","address_street_box":null,"email":"portedehal@mrah.be","website":"http:\/\/www.portedehal.be","phone_contact":"+32 2 534 15 18","phone_booking":"+32 2 533 34 51","address_zip":"1000","address_city":"Bruxelles","address_line1":"Boulevard du Midi, 150","address_line2":"1000 Bruxelles","description_web":"Das ehemalige Stadttor Porte de Hal ist einer der bemerkenswertesten Zeugen der mittelalterlichen Vergangenheit Br\u00fcssels: Es handelt sich um das einzige noch erhaltene Tor der sieben Stadttore der mittelalterlichen Festungsmauern.\r\n\r\nFestung mit bewegter Vergangenheit: Das heute wie eine verwunschene Burg anmutende Geb\u00e4ude blickt auf eine bewegte Geschichte zur\u00fcck und war mehrfach vom Abriss bedroht: Nach der milit\u00e4rischen Funktion bis zum Jahr 1564 folgten verschiedenste Arten der Nutzung - unter anderem als lutherische Kirche, als Kontrollstelle f\u00fcr die Wareneinfuhr und -ausfuhr, als Kornspeicher und als Archiv! \r\n\r\nDas Museum Porte de Hal: 1847 wird das Geb\u00e4ude erstmals als Museum genutzt, 1860 wird der Architekt Henri Beyaert offiziell mit dem Umbau beauftragt: Er nimmt tiefgreifende bauliche Ver\u00e4nderungen und Neuinterpretation im neogotischen Stil vor. Vorherrschend ist die romantische Vision eines mittelalterlichen Bauwerks mit T\u00fcrmchen, Zinnen, Scharten, Verzierungen und verschiedenen dekorativen Elementen. \r\n\r\nHeute verbirgt sich hinter der renovierten wei\u00dfen Fassade das Museum \u201eMus\u00e9e du Porte de Hal\" mit Sammlungen \u00fcber das mittelalterliche Br\u00fcssel und die Geschichte des Geb\u00e4udes, die naturgem\u00e4\u00df eng miteinander verkn\u00fcpft sind. \r\n\r\nBesonderer Tipp: Vom Turm aus haben Sie einen fantastischen Ausblick auf Br\u00fcssel. \r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Porte de Hal - Musei Reali d'Arte e Storia, Bruxelles","address_street_name":"Boulevard du Midi","address_street_number":"150","address_street_box":null,"email":"portedehal@mrah.be","website":"http:\/\/www.portedehal.be","phone_contact":"+32 2 534 15 18","phone_booking":"+32 2 533 34 51","address_zip":"1000","address_city":"Bruxelles","address_line1":"Boulevard du Midi, 150","address_line2":"1000 Bruxelles","description_web":"Edificio che risale a oltre 600 anni fa in stile neogotico ottimamente conservato, la Porte de hal \u00e8 il monumento pi\u00f9 importante del passato medievale della citt\u00e0.\r\n\r\n\r\n\r\n\r\n\r\n\r\nEdificio che risale a oltre 600 anni fa in stile neogotico ottimamente conservato, la Porte de hal \u00e8 il monumento pi\u00f9 importante del passato medievale della citt\u00e0.\u00a0Si tratta dell'unica porta fortificata della seconda cinta delle\u00a0mura Bruxelles.\r\n\r\nLa funzione di prigione la risparmi\u00f2 dalla demolizione delle porte del XVIII secolo. Tuttavia, nel 1869, l'architetto Beyaert realizz\u00f2 alcune modifiche alterandone l'aspetto iniziale che nulla tolgono allo splendore delle sale medievali interne.\u00a0Dall'alto della torre si gode un bel<b> panorama su Bruxelles.\u00a0\r\n\r\nLa Porte de Hal oggi accoglie una bella collezione di opere che, con l'aiuto di supporti didattici, mettono in luce la sua storia e quella delle fortificazioni brussellesi.\u00a0\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Puerta de Hal - MRAH","address_street_name":"Boulevard du Midi","address_street_number":"150","address_street_box":null,"email":"portedehal@mrah.be","website":"https:\/\/www.laguiadeviaje.com\/puerta-de-hal\/","phone_contact":"+32 2 534 15 18","phone_booking":"+32 2 533 34 51","address_zip":"1000","address_city":"Bruxelles","address_line1":"Boulevard du Midi, 150","address_line2":"1000 Bruxelles","description_web":"La Puerta de Hal, en los Museos Reales de Arte y de Historia, es un monumento de m\u00e1s de 600 a\u00f1os, que constituye el testigo m\u00e1s destacado del medievo en Bruselas.\u00a0\r\n\r\nLa Puerta de Hal, en los Museos Reales de Arte y de Historia, es un monumento de m\u00e1s de 600 a\u00f1os, que constituye el testigo m\u00e1s destacado del medievo en Bruselas.\r\n\r\n\u00daltimo vestigio de la segunda muralla de Bruselas, la Puerta de Hal, alberga a fecha de hoy una magn\u00edfica colecci\u00f3n de obras de arte y m\u00faltiples soportes did\u00e1cticos, que ponen de relieve su historia y la de las fortificaciones bruselenses.\u00a0\r\n\r\nLa fachada neog\u00f3tica y los altos techos a\u00f1adidos por el arquitecto Henry Beyaert en el s. XIX no han acabado con el esplendor de las salas medievales en el interior del edificio.\r\n\r\nEn lo alto de la torre, desde el camino de ronda almenado, podr\u00e1s disfrutar de unas vistas espectaculares de Bruselas y de su regi\u00f3n.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Porte de Hal - MRAH","address_street_name":"Boulevard du Midi","address_street_number":"150","address_street_box":null,"email":"portedehal@mrah.be","website":"http:\/\/www.portedehal.be","phone_contact":"+32 2 534 15 18","phone_booking":"+32 2 533 34 51","address_zip":"1000","address_city":"Bruxelles","address_line1":"Boulevard du Midi, 150","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Porte de Hal - MRAH","address_street_name":"Boulevard du Midi","address_street_number":"150","address_street_box":null,"email":"portedehal@mrah.be","website":"http:\/\/www.portedehal.be","phone_contact":"+32 2 534 15 18","phone_booking":"+32 2 533 34 51","address_zip":"1000","address_city":"Bruxelles","address_line1":"Boulevard du Midi, 150","address_line2":"1000 Bruxelles","description_web":"","descrip