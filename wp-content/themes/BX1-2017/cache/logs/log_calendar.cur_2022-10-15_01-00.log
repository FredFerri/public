en":["Accessible"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-14T11:05:06+02:00","published_at":"2022-10-14T10:48:10+02:00","backoffice_id":264144,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":1.2599210498949},{"id":542595,"date_start":"2022-10-21","date_end":"2022-10-21","date_next":"2022-10-21","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert","de":"Konzert"}},"others":{"list":[2],"translations":{"fr":["Classique"],"nl":["Klassiek"],"en":["Classical"],"de":["Klassisch"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Claude Bolling - entre classique et jazz","shortdescr":"4 solistes de renomm\u00e9e internationale qui sont \u00e9galement professeurs \u00e0 l'Acad\u00e9mie de Musique de Watermael-Boitsfort jouera les quatuors de Claude Bolling. Rejoignez-nous et voyez ce qui se passe quand des musiciens classiques essaient de jouer du jazz. Concert d\u00e9butera par Naomi Rofagha (16), finaliste du Young Belgian Talent.","longdescr":"Concert d'ouverture de la 10\u00e8me saison de CLAME!\r\nMa\u00eetres et jeunes talents r\u00e9unis pour des concerts d\u2019exception!\r\n\r\nNous sommes \u00e0 la 10\u00e8me saison de CLAME ! Nous sommes ravis et fiers de vous inviter \u00e0 partager ensemble une soir\u00e9e de musique et d\u2019art au Mus\u00e9e Charlier!\r\nNotre 10\u00e8me saison commencera par r\u00e9unir 4 solistes de renomm\u00e9e internationale qui sont \u00e9galement professeurs \u00e0 l'Acad\u00e9mie de Musique de Watermael-Boitsfort. Rejoignez-nous et voyez ce qui se passe quand des musiciens classiques essaient de jouer du jazz. Fran\u00e7oise Windal \u00e0 la fl\u00fbte, Natacha Save \u00e0 la contrebasse, Arthur Ros aux percussions et Merve Mersinligil au piano interpr\u00e9teront les quatuors de Claude Bolling. Ces quatuors sont sp\u00e9cialement compos\u00e9s pour les musiciens classiques qui oseront jouer du jazz, un style de musique compl\u00e8tement diff\u00e9rent de leur formation et de leurs habitudes. Donc les quatuors de Claude Bolling sont un m\u00e9lange r\u00e9ussit entre jazz et classique.\r\nNous nous r\u00e9jouissons de vous accueillir le 21 octobre 2022 au Mus\u00e9e Charlier, Avenue des Arts 16, 1210 Bruxelles (STIB \u2013MADOU). Le concert d\u00e9butera \u00e0 19h30 mais vous pourrez venir y d\u00e9guster un verre et d\u00e9couvrir le Mus\u00e9e \u00e0 partir de 18h30.\r\nCe moment musical d\u00e9butera par la prestation de Naomi Rofagha (16), finaliste du Young Belgian Talent. Naomi interpr\u00e9tera des \u0153uvres de Chopin et de Rachmaninov avant que nos ma\u00eetres musiciens n'entrent en sc\u00e8ne.\r\nN'h\u00e9sitez pas \u00e0 partager avec vos amis ! Le nombre de places \u00e9tant limit\u00e9, pensez \u00e0 r\u00e9server vos places!","performers":"Fran\u00e7oise Windal (flute); Natacha Save (contrebasse); Arthur Ros (percussion); Merve Mersinligil (piano); Naomi Rofagha (piano - jeune talent)","boxoffice_url":null,"website":"http:\/\/www.clame.be","email":"us@clame.be","phone_contact":"+32 484 57 10 83","phone_booking":"+32 484 57 10 83","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.542595"},"nl":{"name":"Claude Bolling - tussen klassiek en jazz","shortdescr":"4 internationaal vermaarde solisten die tevens professor zijn aan de Muziekacademie Watermaal-Bosvoorde spelen de kwartetten van Claude Bolling. Doe mee en kijk wat er gebeurt als klassieke muzikanten jazz proberen te spelen. Het concert gaat van start met Naomi Rofagha (16), finaliste van Jong Belgisch Talent.","longdescr":"Openingsconcert van het 10e seizoen van CLAME!\r\nMeesters en jonge talenten verzameld voor uitzonderlijke concerten!\r\n\r\nWe zijn in het 10e seizoen van CLAME! We zijn verheugd en trots U uit te nodigen voor een avond vol muziek en kunst in het Charlier Museum!\r\nOns 10e seizoen begint met het samenbrengen van 4 internationaal gerenommeerde solisten die ook les geven aan de Muziekacademie van Watermaal-Bosvoorde.\r\nDoe mee en kijk wat er gebeurt als klassieke muzikanten jazz proberen te spelen. Fran\u00e7oise Windal op fluit, Natacha Save op contrabas, Arthur Ros op percussie en Merve Mersinligil op piano spelen de kwartetten van Claude Bolling. Deze kwartetten zijn speciaal gecomponeerd voor klassieke musici die jazz durven spelen, een muziekstijl die totaal verschilt van hun opleiding en gewoontes.\r\nWe kijken ernaar uit U te verwelkomen op 21 oktober 2022 in het Charlier Museum, Kunstlaan 16, 1210 Brussel (MIVB \u2013 MADOU). Het concert begint om 19.30 uur maar je kunt vanaf 18.30 uur een drankje komen doen en het Museum ontdekken.\r\nDit muzikale moment begint met het optreden van Naomi Rofagha (16), finaliste van Jong Belgisch Talent. Naomi zal werken van Chopin en Rachmaninoff uitvoeren voordat onze meestermuzikanten het podium betreden.\r\nVoel je vrij om te delen met je vrienden! Het aantal plaatsen is beperkt, vergeet niet uw plaatsen te reserveren!","performers":"Fran\u00e7oise Windal (flute); Natacha Save (basse); Arthur Ros (percussion); Merve Mersinligil (piano); Naomi Rofagha (piano - jong talent)","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.542595"},"en":{"name":"Claude Bolling- in between Classic and Jazz","shortdescr":"4 internationally renowned soloists who are also professors at the Watermael-Boitsfort Music Academy will play Claude Bolling's quartets. Join us and see what happens when classical musicians try to play jazz. Concert will start with Naomi Rofagha (16), finalist of the Young Belgian Talent.","longdescr":"10th Season Opening Concert of CLAME!\r\nMasters and young talents together for exceptional concerts!\r\n\r\nIt is now the 10th season of CLAME! We are delighted and proud to invite you to share an evening of music and arts together to Mus\u00e9e Charlier!\r\nOur 10th season will start by joining together 4 internationally acclaimed soloists who are also professors at Watermael-Boitsfort Music Academy. Join us and see what happens if Classical Musicians try to play jazz. Fran\u00e7oise Windal in flute, Natacha Save in double base, Arthur Ros in percussion and Merve Mersinligil in piano will perform quartets of Claude Bolling. These quartets are specially composed for classical musicians who will dare to play jazz, a music style completely different to their training and habits.\r\nWe are looking forward to welcome you on 21st of October 2022 at Mus\u00e9e Charlier, Avenue des Arts 16, 1210 Brussels (STIB-MADOU). The concert will start at 7.30 pm but you can come and enjoy a relaxing drink and discover the museum from 6.30 pm on.\r\nThis musical moment will start with the performance of Naomi Rofagha (16), finalist of Young Belgian Talent. Naomi will perform works of Chopin and Rachmaninov before our master musicians will take the stage.\r\nFeel free to share with your friends! The number of places is limited; don't forget to reserve your places!","performers":"Fran\u00e7oise Windal (flute); Natacha Save (double base); Arthur Ros (percussion); Merve Mersinligil (piano); Naomi Rofagha (piano - joung talent)","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.542595"},"de":{"name":"Claude Bolling - entre classique et jazz","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.542595"},"it":{"name":"Claude Bolling - entre classique et jazz","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.542595"},"sp":{"name":"Claude Bolling - entre classique et jazz","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.542595"},"pt":{"name":"Claude Bolling - entre classique et jazz","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.542595"},"cn":{"name":"Claude Bolling - entre classique et jazz","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.542595"}},"place":{"id":753,"translations":{"fr":{"name":"Mus\u00e9e Charlier","address_street_name":"Avenue des Arts","address_street_number":"16","address_street_box":null,"email":"info@charliermuseum.be","website":"http:\/\/www.charliermuseum.be","phone_contact":"+32 2 217 81 61","phone_booking":"+32 2 217 81 61","address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Avenue des Arts, 16","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"Le mus\u00e9e, inaugur\u00e9 en 1928, est comme un tableau d\u2019\u00e9poque\u2026 on se retrouve au temps de La Libre Esth\u00e9tique et du Groupe des 20. Les collections sont expos\u00e9es dans les salons, riches en mobilier et objets d\u2019art d\u00e9coratifs d\u2019\u00e9poque Louis XV, Louis XVI et Empire.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Charliermuseum","address_street_name":"Kunstlaan","address_street_number":"16","address_street_box":null,"email":"info@charliermuseum.be","website":"http:\/\/www.charliermuseum.be","phone_contact":"+32 2 217 81 61","phone_booking":"+32 2 217 81 61","address_zip":"1210","address_city":"Sint-Joost-Ten-Node","address_line1":"Kunstlaan, 16","address_line2":"1210 Sint-Joost-Ten-Node","description_web":"Het museum, geopend in 1928, is gevestigd in het prive-herenhuis van de beeldhouwer Guillaume Charlier, dat dateert uit de 19e eeuw. Het richt zich op de Belgische schilderkunst van eind 19e tot begin 20e eeuw. De collecties worden getoond in de salons, rijkelijk voorzien van decoratieve stukken uit de Louis XV, Louis XVI en Empire periodes.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Charlier Museum","address_street_name":"Avenue des Arts","address_street_number":"16","address_street_box":null,"email":"info@charliermuseum.be","website":"http:\/\/www.charliermuseum.be","phone_contact":"+32 2 217 81 61","phone_booking":"+32 2 217 81 61","address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Avenue des Arts, 16","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"The museum is based in the private mansion, dating from the 19th century, of the sculptor Guillaume Charlier. It focuses on Belgian painting from the late 19th to the early 20th century. Its art exhibitions take place in a setting of lavish furnishings, with numerous decorative pieces from the Louis XV, Louis XVI, and Empire periods.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Mus\u00e9e Charlier","address_street_name":"Avenue des Arts","address_street_number":"16","address_street_box":null,"email":"info@charliermuseum.be","website":"http:\/\/www.charliermuseum.be","phone_contact":"+32 2 217 81 61","phone_booking":"+32 2 217 81 61","address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Avenue des Arts, 16","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"Das 1928 eingeweihte Museum ist wie ein Gem\u00e4lde der Epoche... man findet sich in der Zeit der La Libre Est\u00e9tique und der Groupe des 20 wieder. Die Sammlungen werden in den reich mit Mobiliar und historischen Dekorationsgegenst\u00e4nden (Louis XV, Louis XV und Empire) best\u00fcckten Salons ausgestellt.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Mus\u00e9e Charlier","address_street_name":"Avenue des Arts","address_street_number":"16","address_street_box":null,"email":"info@charliermuseum.be","website":"http:\/\/www.charliermuseum.be","phone_contact":"+32 2 217 81 61","phone_booking":"+32 2 217 81 61","address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Avenue des Arts, 16","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Museo Charlier","address_street_name":"Avenue des Arts","address_street_number":"16","address_street_box":null,"email":"info@charliermuseum.be","website":"http:\/\/www.charliermuseum.be","phone_contact":"+32 2 217 81 61","phone_booking":"+32 2 217 81 61","address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Avenue des Arts, 16","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"El Museo Charlier, una mansi\u00f3n del siglo XIX obra de Horta durante sus a\u00f1os de juventud, te sumergir\u00e1 en la atm\u00f3sfera de un lujoso sal\u00f3n de arte: la Belle Epoque te invita a so\u00f1ar, a pasear entre las esculturas de Charlier, Hager y Wouters, las pinturas de Smits, Fr\u00e9d\u00e9ric, Oleffe, Laermans, Van Strydonck, Ensor... Este ambiente \u00edntimo se completa con los muebles de los ebanistas Chapuis, Sen\u00e9, Nadal l'A\u00een\u00e9, numerosos objetos de arte decorativo de estilos Luis XIV, XV, XVI y estilo Imperio, tapices de Bruselas y Audenaerde, as\u00ed como excepcionales un excepcional sal\u00f3n chino. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Mus\u00e9e Charlier","address_street_name":"Avenue des Arts","address_street_number":"16","address_street_box":null,"email":"info@charliermuseum.be","website":"http:\/\/www.charliermuseum.be","phone_contact":"+32 2 217 81 61","phone_booking":"+32 2 217 81 61","address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Avenue des Arts, 16","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Mus\u00e9e Charlier","address_street_name":"Avenue des Arts","address_street_number":"16","address_street_box":null,"email":"info@charliermuseum.be","website":"http:\/\/www.charliermuseum.be","phone_contact":"+32 2 217 81 61","phone_booking":"+32 2 217 81 61","address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Avenue des Arts, 16","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":[],"zones":{"list":[22],"translations":{"fr":["Est"],"nl":["Oost"],"en":["East"]}},"neca":null,"facebook_id":null,"backoffice_id":152,"location":{"lat":50.84755959,"lon":4.36997724},"region":"brussels","last_updated_at":"2022-10-11T03:36:12+02:00","published_at":"2013-10-19T01:13:19+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":252302,"translations":{"fr":{"name":"CLAME asbl","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":"us@clame.be","website":"http:\/\/www.clame.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":