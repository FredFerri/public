.be","email":"info@lebaixu.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50001263"},"pt":{"name":"Victor Hugo Villena,  Recital de bandoneon","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lebaixu.be","email":"info@lebaixu.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50001263"},"en":{"name":"Victor Hugo Villena,  Recital de bandoneon","shortdescr":"Tangos, milongas and personal compositions by an Argentinian bandoneon virtuoso\nVictor Villena is an internationally renowned Argentine bandoneonist.","longdescr":"In 2012, together with Henri Demarquette, Nemanja Radulovic and Franc Braley, he formed the 'Arborescence' quartet, which performed in the ARTE1 programme 'Les Salons de Musique'. At the same time, he recorded his solo bandoneon album, Bandon\u00e9on Ecl\u00e9ctico, which was considered one of the best albums of 2013 in Argentina. Between 2013 and 2023, he toured with the singer Ute Lemper, performing at the Phillarmonie de Paris, the Frankfurt Opera House and the Albert Hall in London.in 2018, he played in a duet with the quitarist Emmanuel Rossfelder, notably at the FolleJourn\u00e9e in Nantes. In 2019, with violinist Sabrina Condello, he will produce the programme \"TangoParadiso\", which will be performed in prestigious venues in the Netherlands, Belgium, Italy and France.","performers":"Victor Hugo Villena  Laura Lahera guitariste Alenjandro Schawrz","boxoffice_url":null,"website":"http:\/\/www.lebaixu.be","email":"info@lebaixu.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50001263"},"it":{"name":"Victor Hugo Villena,  Recital de bandoneon","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lebaixu.be","email":"info@lebaixu.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50001263"},"cn":{"name":"Victor Hugo Villena,  Recital de bandoneon","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lebaixu.be","email":"info@lebaixu.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50001263"},"fr":{"name":"Victor Hugo Villena,  Recital de bandoneon","shortdescr":"Tangos, milongas et compositions personnelles d'un virtuose argentin du bandon\u00e9on.\n\nVictor Hugo Villena, bandon\u00e9oniste argentin reconnu sur la sc\u00e8ne internationale.","longdescr":"En 2012, il cr\u00e9e, avec Henri Demarquette, Nemanja Radulovic et Franc Braley le quatuor \u00ab Arborescence \u00bb qui s'adapte notamment dans l'\u00e9mission \u00ab Les Salons de Musique \u00bb de la cha\u00eene ARTE1. En m\u00eame temps, Il enregistre son album de Bandon\u00e9on solo: \u00ab Bandon\u00e9on Ecl\u00e9ctico\u00bb ,consid\u00e9r\u00e9 en Argentine parmi les meilleurs albums de l'ann\u00e9e 2013. Entre2013e t 2023 il est en tourn\u00e9e avec l'achanteuse Ute Lemper, se produit notamment \u00e0 la Phillarmonie de Paris, \u00e0 l'Op\u00e9ra de Francfort et \u00e0 l'Albert Hall \u00e0 Londres.E n 2018, je joue en duo avec le quitariste Emmanuel Rossfelder, notamment \u00e0 la \u00abFolleJourn\u00e9e\u00bb de Nantes. En 2019, il produit, avec la violoniste Sabrina Condello, le programme \u00abTangoParadiso\u00bb, se pr\u00e9sentant dans de prestigieuses salles aux Pays Bas, Belgique, Italie et en France.\n\nActuellement,il joue en trio de tango argentin \u00abCaf\u00e9Bruselas\u00bb, avec la chanteuse Laura Lahera et le guitariste Alenjandro Schawrz . Dans ce projeti et le trio de musiciens argentins est accompagn\u00e9 d'un couple de danseurs de Tango","performers":"Victor Hugo Villena  Laura Lahera guitariste Alenjandro Schawrz ","boxoffice_url":null,"website":"http:\/\/www.lebaixu.be","email":"info@lebaixu.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50001263"},"sp":{"name":"Victor Hugo Villena,  Recital de bandoneon","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lebaixu.be","email":"info@lebaixu.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50001263"},"nl":{"name":"Victor Hugo Villena,  Recital de bandoneon","shortdescr":"Tango's, milonga's en personlijke composities van een Argentijnse bandoneonvirtuoos\n\nVictor Villena est un bandon\u00e9oniste international bekende Argentijnse.","longdescr":"En 2012, vormde hij samen a rencontr\u00e9 Henri Demarquette, Nemanja Radulovic et Franc Braley het kwartet 'Arborescence', dat optrad in het ARTE1-programma 'Les Salons de Musique'. Tegelijkertijd nam hij zijn album de bandon\u00e9on solo Bandon\u00e9on Ecl\u00e9ctico op, dat werd beschouwd als een van de beste albums van 2013 in Argentini\u00eb. Tussen 2013 en 2023 toerde hij met de zangeres Ute Lemper en trad op in de Phillarmonie de Paris, de Opera van Frankfurt en de Albert Hall in Londen. En 2018, speelde hij in een duo rencontre le quitariste Emmanuel Rossfelder, rencontr\u00e9 name tijdens het FolleJourn\u00e9e \u00e0 Nantes. En 2019, zal hij samen a rencontr\u00e9 la violiste Sabrina Condello et le producteur du programme \"TangoParadiso\", dat zal worden uitgevoerd op prestigieuze locaties in Nederland, Belgi\u00eb, Itali\u00eb en Frankrijk.\nMomenteel speelt hij in het Argentijnse tangotrio Caf\u00e9Bruselas, met zangeres Laura Lahera en gitarist Alenjandro Schawrz. In dit project wordt het trio Argentijnse muzikanten begeleid door een stel tangodansers","performers":"Victor Hugo Villena  Laura Lahera guitariste Alenjandro Schawrz","boxoffice_url":null,"website":"http:\/\/www.lebaixu.be","email":"info@lebaixu.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50001263"}},"place":{"id":279109,"translations":{"de":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"info@lebaixu.be","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"info@lebaixu.be","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"info@lebaixu.be","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard, 3","address_line2":"1000 Bruxelles","description_web":"The name \u201cBaixu\u201d means \u201cbeautiful\u201d in the native language of the Patax\u00f3 peoples, indigenous to the south of the state of Bahia in Brazil. This word represents both the ambition of the project and the quality of the cultural events presented, as well as the founders\u2019 attachment to Brazilian culture. Baisu is a quaint and welcoming space in the Tour & Taxis neighborhood in Brussels, which hosts concerts, expositions, screenings, or conferences \u2013 or where you can organise your private event.\r\nA project dedicated to \u201cbeauty\u201d in all its forms, where the keywords are quality, exchange and interaction.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"info@lebaixu.be","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"info@lebaixu.be","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"fr":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"info@lebaixu.be","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard, 3","address_line2":"1000 Bruxelles","description_web":"Un lieu atypique et chaleureux dans le quartier de Tour & Taxis \u00e0 Bruxelles pour assister \u00e0 des concerts, des expositions, des projections ou des conf\u00e9rences, ou pour y organiser vos \u00e9v\u00e8nements priv\u00e9s.\r\nUn projet d\u00e9di\u00e9 au \u00ab beau \u00bb sous toutes ses coutures, dont les maitres-mots sont qualit\u00e9, \u00e9changes et rencontres.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_st