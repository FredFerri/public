ice_url":null,"website":"https:\/\/escaledunord.brussels\/event\/echos-du-rwanda\/","email":"info@escaledunord.net","phone_contact":"+32 496 94 43 18","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50005683"},"en":{"name":"\u00c9chos du Rwanda","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/escaledunord.brussels\/event\/echos-du-rwanda\/","email":"info@escaledunord.net","phone_contact":"+32 496 94 43 18","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50005683"},"it":{"name":"\u00c9chos du Rwanda","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/escaledunord.brussels\/event\/echos-du-rwanda\/","email":"info@escaledunord.net","phone_contact":"+32 496 94 43 18","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50005683"},"cn":{"name":"\u00c9chos du Rwanda","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/escaledunord.brussels\/event\/echos-du-rwanda\/","email":"info@escaledunord.net","phone_contact":"+32 496 94 43 18","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50005683"},"fr":{"name":"\u00c9chos du Rwanda","shortdescr":"\u00c0 l'occasion du 30\u00e8me anniversaire du g\u00e9nocide des Tutsis au Rwanda en 1994, le Centre culturel d'Anderlecht vous invite \u00e0 d\u00e9couvrir deux expositions simultan\u00e9es, une performance, une lecture publique, une conf\u00e9rence et des animations scolaires pour tenter de comprendre cette trag\u00e9die du 20\u00e8me si\u00e8cle.\n\nVernissage le mercredi 17 janvier \u00e0 19:00.","longdescr":"Cet \u00e9v\u00e9nement fait partie du cycle Devoir de M\u00e9moire du Centre culturel d'Anderlecht. Devoir de M\u00e9moire honore la m\u00e9moire des victimes et propose des pistes de r\u00e9flexion par le biais de regards d\u2019artistes.\n\nAu programme :\n\u2014 Exposition \"\u00c9chos du Rwanda\" de Munana Gatera\n\u2014 Exposition \"Rwanda 94 : Comprendre l'incompr\u00e9hensible\" de l'association Territoires de la M\u00e9moire\n\u2014 Lecture de t\u00e9moignages par Patricia Ksiezarczyk\n\u2014 Performance \"Rel\u00e8ve-toi et danse\" par Louisa de Groot, Chantal Iris Mukeshimana et Jean-Luc Vranken\n\u2014 Conf\u00e9rence \"Le r\u00f4le des st\u00e8les comm\u00e9moratives dans la sensibilisation sur le g\u00e9nocide\" par Ibuka M\u00e9moire et Justice\n\u2014 Ateliers scolaires \"On d\u00e9cortique les st\u00e9r\u00e9otypes !\" avec ArtiCulE asbl.\n\nProgramme complet et r\u00e9servations sur le site du Centre culturel : https:\/\/escaledunord.brussels\/event\/echos-du-rwanda\/","performers":null,"boxoffice_url":null,"website":"https:\/\/escaledunord.brussels\/event\/echos-du-rwanda\/","email":"info@escaledunord.net","phone_contact":"+32 496 94 43 18","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50005683"},"sp":{"name":"\u00c9chos du Rwanda","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/escaledunord.brussels\/event\/echos-du-rwanda\/","email":"info@escaledunord.net","phone_contact":"+32 496 94 43 18","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50005683"},"nl":{"name":"\u00c9chos du Rwanda","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/escaledunord.brussels\/event\/echos-du-rwanda\/","email":"info@escaledunord.net","phone_contact":"+32 496 94 43 18","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50005683"}},"place":{"id":276400,"translations":{"de":{"name":"Escale du Nord (Antenne Scheut)","address_street_name":"Avenue de Scheut","address_street_number":"147","address_street_box":null,"email":"info@escaledunord.brussels",