rue,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-12-09T09:18:20+01:00","published_at":"2024-10-04T09:03:34+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":308974,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"concert","ranking":0.7937005259840998,"languages":{"spoken":["fr","en","it"],"subtitles":[]},"categories":{"main":{"id":1,"translations":{"de":"Konzert","pt":null,"en":"Concert","it":"Concerti","cn":null,"fr":"Concert","sp":"Concierto","nl":"Concert"}},"others":{"list":[10,4],"translations":{"de":["Jazz & Blues","Pop, Rock, Jazz..."],"pt":[null,null],"en":["Jazz & Blues","Pop, rock, jazz\u2026"],"it":["Jazz e Blues","Pop, rock, jazz\u2026"],"cn":[null,null],"fr":["Jazz & Blues","Pop, rock, jazz\u2026"],"sp":["Jazz y blues","Pop, rock, jazz\u2026"],"nl":["Jazz & Blues","Pop, rock, jazz\u2026"]}}},"translations":{"de":{"name":"Belgian Italian Jazz Festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.tickettailor.com\/events\/jazzentertainment?","email":"italianjazzfestivalcl@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700002107"},"pt":{"name":"Belgian Italian Jazz Festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.tickettailor.com\/events\/jazzentertainment?","email":"italianjazzfestivalcl@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700002107"},"en":{"name":"Belgian Italian Jazz Festival","shortdescr":"Join the IV Belgian Italian Jazz Festival at Th\u00e9\u00e2tre Lumen in Brussels. Free entrance thanks to the support of Comites. Supported by the Italian Embassy, the Italian Cultural Institute, the Consulate General of Charleroi, and the Belgian-Italian Chamber of Commerce. Concerts with Emanuele Filippi, Armando Luongo, Cyrano Vatel Gypsy Jazz, and the Italian Orchestra.","longdescr":"Join us for the fourth edition of the Belgian Italian Jazz Festival, a free event thanks to the support of Comites. The festival will be held at the Th\u00e9\u00e2tre Lumen in Brussels on December 13 and 14, 2024, offering two days of jazz music by internationally renowned artists from Italy and Belgium.\n\nFriday, December 13, 2024\n7:00 PM: Emanuele Filippi will open the festival with an emotional solo piano concert.\n8:45 PM: Armando Luongo and his quintet will present their discographic project \"New Land\".\nSaturday, December 14, 2024\n7:00 PM: The Cyrano Vatel Gypsy Jazz trio will open the evening with a dynamic gypsy jazz performance.\n8:45 PM: The festival will close with the Italian Orchestra of Brussels, conducted by maestro Angelo Gregorio, celebrating its 10th anniversary with a special program.\nThis major cultural event is supported by the Italian Embassy in Brussels, the Italian Cultural Institute of Brussels, the Consulate General of Charleroi, and the Belgian-Italian Chamber of Commerce. The Belgian Italian Jazz Festival offers an unforgettable musical journey, exploring the best of Italian and Belgian jazz traditions.","performers":"13\/12\/24\nEmanuele Filippi (solo piano)\nArmando Luongo (drums)\nJean-Paul Esti\u00e8venart (trumpet)\nWajdi Riahi (piano)\nGiovanni Di Carlo (guitar)\nBasile Rahola (double bass)\n\n14\/12\/24\nCyrano Vatel (lead guitar)\nMauro Gregori (rhythm guitar)\nGabriele Pagliano (double bass)\nItalian Jazz Orchestra of Brussels (15 members):\nConducted by maestro Angelo Gregorio","boxoffice_url":null,"website":"https:\/\/www.tickettailor.com\/events\/jazzentertainment?","email":"italianjazzfestivalcl@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700002107"},"it":{"name":"Belgian Italian Jazz Festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.tickettailor.com\/events\/jazzentertainment?","email":"italianjazzfestivalcl@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700002107"},"cn":{"name":"Belgian Italian Jazz Festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.tickettailor.com\/events\/jazzentertainment?","email":"italianjazzfestivalcl@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700002107"},"fr":{"name":"Belgian Italian Jazz Festival","shortdescr":"IV edition du Belgian Italian Jazz Festival au Th\u00e9\u00e2tre Lumen de Bruxelles. Gratuits gr\u00e2ce au soutien des Comites. Soutenu par l'Ambassade d'Italie, l'Institut Italien de Culture, le Consulat G\u00e9n\u00e9ral de Charleroi et la Chambre de Commerce Belgo-Italienne. Concerts avec Emanuele Filippi, Armando Luongo, Cyrano Vatel Gypsy Jazz et l'Orchestre Italienne.","longdescr":"Participez \u00e0 la quatri\u00e8me \u00e9dition du Belgian Italian Jazz Festival, un \u00e9v\u00e9nement gratuit gr\u00e2ce au soutien des Comites. Le festival se tiendra au Th\u00e9\u00e2tre Lumen \u00e0 Bruxelles les 13 et 14 d\u00e9cembre 2024, offrant deux journ\u00e9es d\u00e9di\u00e9es aux sonorit\u00e9s jazz des artistes de renomm\u00e9e internationale venant d'Italie et de Belgique.\n\nVendredi 13 d\u00e9cembre 2024\n\n19h00 : Emanuele Filippi ouvrira le festival avec un concert \u00e9mouvant en solo au piano.\n20h45 : Armando Luongo et son quintet pr\u00e9senteront leur projet discographique \"New Land\".\nSamedi 14 d\u00e9cembre 2024\n\n19h00 : Le trio Cyrano Vatel Gypsy Jazz ouvrira la soir\u00e9e avec une performance dynamique de gypsy jazz.\n20h45 : Cl\u00f4ture du festival avec l'Orchestre Italienne de Bruxelles, dirig\u00e9e par le ma\u00eetre Angelo Gregorio, c\u00e9l\u00e9brant son 10e anniversaire avec un programme sp\u00e9cial.\nCet important \u00e9v\u00e9nement culturel est soutenu par l'Ambassade d'Italie \u00e0 Bruxelles, l'Institut Italien de Culture de Bruxelles, le Consulat G\u00e9n\u00e9ral de Charleroi et la Chambre de Commerce Belgo-Italienne. Le Belgian Italian Jazz Festival offre un voyage musical inoubliable, explorant le meilleur des traditions jazz italiennes et belges.","performers":"13\/12\/24\nEmanuele Filippi (solo piano)\nArmando Luongo (drums)\nJean-Paul Esti\u00e8venart (trumpet)\nWajdi Riahi (piano)\nGiovanni Di Carlo (guitar)\nBasile Rahola (double bass)\n\n14\/12\/24\nCyrano Vatel (lead guitar)\nMauro Gregori (rhythm guitar)\nGabriele Pagliano (double bass)\nItalian Jazz Orchestra of Brussels (15 members):\nConducted by maestro Angelo Gregorio","boxoffice_url":null,"website":"https:\/\/www.tickettailor.com\/events\/jazzentertainment?","email":"italianjazzfestivalcl@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700002107"},"sp":{"name":"Belgian Italian Jazz Festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.tickettailor.com\/events\/jazzentertainment?","email":"italianjazzfestivalcl@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700002107"},"nl":{"name":"Belgian Italian Jazz Festival","shortdescr":"Belgian Italian Jazz Festival in Th\u00e9\u00e2tre Lumen. Gratis evenementen, dankzij de steun van de Comites. Ondersteund door de Italiaanse Ambassade, het Cultureel Instituut, het Consulaat-Generaal van Charleroi en de Belgisch-Italiaanse Kamer van Koophandel. Concerten met Emanuele Filippi, Armando Luongo, Cyrano Vatel Gypsy Jazz en het Italiaans Orkest.","longdescr":"Neem deel aan de vierde editie van het Belgian Italian Jazz Festival, een gratis evenement dankzij de steun van de Comites. Het festival vindt plaats in het Th\u00e9\u00e2tre Lumen in Brussel op 13 en 14 december 2024, met twee dagen gewijd aan jazzmuziek van internationaal gerenommeerde artiesten uit Itali\u00eb en Belgi\u00eb.\n\nVrijdag 13 december 2024\n\n19:00: Emanuele Filippi opent het festival met een ontroerend solo pianoconcert.\n20:45: Armando Luongo en zijn kwintet presenteren hun muziekalbum \"New Land\".\nZaterdag 14 december 2024\n\n19:00: Het Cyrano Vatel Gypsy Jazz trio opent de avond met een dynamisch gypsy jazzoptreden.\n20:45: Afsluiting van het festival met het Italiaans Orkest van Brussel, onder leiding van maestro Angelo Gregorio, ter ere van hun 10-jarig jubileum met een speciaal programma.\nDit belangrijke culturele evenement wordt ondersteund door de Italiaanse Ambassade in Brussel, het Italiaans Cultureel Instituut in Brussel, het Consulaat-Generaal van Charleroi en de Belgisch-Italiaanse Kamer van Koophandel. Het Belgian Italian Jazz Festival biedt een onvergetelijke muzikale reis waarin de beste Italiaanse en Belgische jazztradities worden verkend.","performers":"13\/12\/24\nEmanuele Filippi (solo piano)\nArmando Luongo (drums)\nJean-Paul Esti\u00e8venart (trumpet)\nWajdi Riahi (piano)\nGiovanni Di Carlo (guitar)\nBasile Rahola (double bass)\n\n14\/12\/24\nCyrano Vatel (lead guitar)\nMauro Gregori (rhythm guitar)\nGabriele Pagliano (double bass)\nItalian Jazz Orchestra of Brussels (15 members):\nConducted by maestro Angelo Gregorio","boxoffice_url":null,"website":"https:\/\/www.tickettailor.com\/events\/jazzentertainment?","email":"italianjazzfestivalcl@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700002107"}},"place":{"id":257593,"translations":{"de":{"name":"Espace Lumen","address_street_name":"Chauss\u00e9e de Boondael","address_street_number":"36","address_street_box":null,"email":n