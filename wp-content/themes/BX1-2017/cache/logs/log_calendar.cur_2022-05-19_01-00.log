"import_origin":null,"sub_type":"misc","show_in_agenda":true,"ranking":0.14574684396522},{"id":528941,"date_start":"2022-04-21","date_end":"2022-06-09","date_next":"2022-06-09","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":118,"translations":{"fr":"Festival","nl":"Festival","en":"Festival"}},"others":{}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Nocturnes 2022","shortdescr":"Tous les jeudis soir du 21 avril au 9 juin, les Nocturnes vous ouvrent les yeux sur les tr\u00e9sors des mus\u00e9es et centres d\u2019art bruxellois.","longdescr":"Tous les jeudis soir du 21 avril au 9 juin, les Nocturnes vous ouvrent les yeux sur les tr\u00e9sors des mus\u00e9es et centres d\u2019art bruxellois.\r\n\r\nDe 17h \u00e0 22h, d\u00e9couvrez les expositions du moment et les collections de 63 lieux insolites gr\u00e2ce \u00e0 des visites guid\u00e9es in\u00e9dites, un acc\u00e8s aux coulisses et r\u00e9serves ou des ateliers artistiques sur mesure. Pour combiner les plaisirs, les Nocturnes s\u2019organisent toujours par quartier et proposent aussi des promenades extra-muros \u00e0 la d\u00e9couverte de notre ville.\r\n\r\nJuste envie d\u2019une visite libre ? Possible aussi ! Ce qu\u2019on veut, c\u2019est vous offrir une sortie culturelle \u00e0 l\u2019aise et sans complexe. D\u2019ailleurs on garde tout \u00e7a au tarif avantageux de 5 \u20ac (standard), ou 2,50 \u20ac (-26 ans) par mus\u00e9e.\r\n\r\nProgramme complet et r\u00e9servations sur nocturnes.brussels \u00e0 partir de fin mars.\r\n\r\nAvec le soutien de visit.brussels","performers":null,"boxoffice_url":null,"website":"http:\/\/www.nocturnes.brussels","email":"info@brusselsmuseums.be","phone_contact":"+32 2 512 77 80","phone_booking":"+32 2 512 77 80","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/528941.html"},"nl":{"name":"Nocturnes 2022","shortdescr":"Elke donderdagavond van 21 april tot en met 9 juni openen de Nocturnes jullie ogen voor de schatten van de Brusselse musea en kunstencentra!","longdescr":"Elke donderdagavond van 21 april tot en met 9 juni openen de Nocturnes jullie ogen voor de schatten van de Brusselse musea en kunstencentra!\r\n\r\nVan 17u tot 22u ontdek je de tijdelijke tentoonstellingen en de permanente collecties van 63 verschillende musea via originele rondleidingen, een blik achter de schermen of een bezoek aan de museumdepots en artistieke workshops op maat. Om alles nog makkelijker te maken, worden de Nocturnes opnieuw per wijk georganiseerd.\r\n\r\nDe extra-muros rondleidingen bieden je dan weer een uitgelezen kans om ook de buurt rond de musea beter te leren kennen!\r\n\r\nWil je gewoon de musea bezoeken zonder deel te nemen aan een activiteit? Dat kan zeker ook! De Nocturnes staan garant voor een fijn cultureel uitje zonder al te veel gedoe en aan een zeer aantrekkelijke prijs: 5 \u20ac (standaardprijs) of 2,50 \u20ac (-26) per museum.\r\n\r\nVoor het volledige programma en voor reservaties kan je terecht hier vanaf eind maart.\r\n\r\nMet de ondersteuning van visit.brussels.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/528941.html"},"en":{"name":"Nocturnes 2022","shortdescr":"Every Thursday evening from 21 April to 9 June, the Nocturnes will open your eyes to the treasures waiting for you in Brussels\u2019 museums and art centres.","longdescr":"Every Thursday evening from 21 April to 9 June, the Nocturnes will open your eyes to the treasures waiting for you in Brussels\u2019 museums and art centres.\r\n\r\nFrom 5pm to 10pm, thanks to original guided tours, behind the scenes visits, access to the museum reserves and tailor-made workshops, you\u2019ll see collections and current exhibitions through new eyes at 63 unusual places.\r\n\r\nOrganized by neighbourhood, the Nocturnes in museums are supplemented by extra-muros tours, so you can explore the city even further.\r\n\r\nWould you prefer a standard visit? That\u2019s possible, too! All we want is to offer you a relaxed and uncomplicated cultural outing. So, we\u2019re providing all options at the same advantageous rate of 5 \u20ac (standard), or 2,50 \u20ac (-26 years) per museum.\r\n\r\nFull programme and reservations at nocturnes.brussels from end March onwards.\r\n\r\nWith the support of visit.brussels.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/528941.html"},"de":{"name":"Nocturnes 2022","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/528941.html"},"it":{"name":"Nocturnes 2022","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/528941.html"},"sp":{"name":"Nocturnes 2022","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/528941.html"},"pt":{"name":"Nocturnes 2022","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/528941.html"},"cn":{"name":"Nocturnes 2022","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/ag