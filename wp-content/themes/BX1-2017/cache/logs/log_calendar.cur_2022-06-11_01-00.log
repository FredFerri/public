ior"},"nl":{"name":"Senioren"},"en":{"name":"Senior"}},"value":23},{"translations":{"fr":{"name":"Jeunes"},"nl":{"name":"Jongeren"},"en":{"name":"Young"}},"value":9},{"translations":{"fr":{"name":"Demandeurs d'emploi"},"nl":{"name":"Werkzoekenden"},"en":{"name":"Jobseekers"}},"value":10},{"translations":{"fr":{"name":"Article 27"},"nl":{"name":"Artikel 27"},"en":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-06-10T01:36:55+02:00","published_at":"2021-06-07T17:01:27+02:00","backoffice_id":232749,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":0.51471424920009},{"id":531706,"date_start":"2022-05-15","date_end":"2022-06-25","date_next":"2022-06-10","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[24,30],"translations":{"fr":["Galeries d'art","Peinture"],"nl":["Galeries","Schilderkunst"],"en":["Art Galleries","Painting"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Robert Suermondt - Trou dans le Miroir","shortdescr":"L\u2019exposition met en relation deux ensembles d\u2019oeuvres distinctes : \"Voisinages\" et \"G\u00e9om\u00e9tries\".\r\nPar son travail prot\u00e9iforme, son traitement picturale des images, par le jeu des identifications et des disruption qu\u2019il met en articulation, l\u2019artiste nous am\u00e8ne \u00e0 une r\u00e9flexion individuelle, philosophique fondamentale et essentielle.","longdescr":"Mich\u00e8le Schoonjans Gallery est fi\u00e8re de pr\u00e9senter une exposition des peintures r\u00e9centes de Robert Suermondt, sous le titre \u00ab\u00a0Trou dans le Miroir\u00a0\u00bb.\r\n\r\nDu 15 mai au 25 juin 2022, la galerie d\u00e9voile un solo-show avec une s\u00e9lection de peintures r\u00e9centes, de l\u2019artiste plasticien Robert Suermondt.\r\n\r\nL\u2019exposition met en relation deux ensembles d\u2019oeuvres distinctes.\r\n\r\nVoisinages\r\nLe premier corpus donne \u00e0 voir des vues de voies urbaines comme observ\u00e9es d\u2019en haut, anim\u00e9es par des automobiles. Du nom g\u00e9n\u00e9rique de \u00ab\u00a0Voisinages\u00a0\u00bb, c\u2019est la disposition de ces automobiles entre elles qui g\u00e9n\u00e8re une tension ainsi que leur adh\u00e9rence au fond de toile repr\u00e9sentant segments de routes, bandes et fl\u00e8ches de marquage, carrefours et plate-bandes, \u00e0 la facture apparent\u00e9e \u00e0 un r\u00e9alisme photographique. Ces voitures sont en effet peintes diff\u00e9remment, tant\u00f4t \u00e0 peine esquiss\u00e9es, fantomatiques, comme soustraites \u00e0 la peinture m\u00eame, tant\u00f4t marqu\u00e9es par traces \u00e9paisses, le plus souvent rapidement ex\u00e9cut\u00e9es. Leur caract\u00e8re particulier renvoie \u00e0 des r\u00e9gimes d\u2019image diverses et souvent contradictoires, puisqu\u2019elles peuvent relever parfois du comic, et sembler \u00e0 d\u2019autres moment au bord de la dislocation, entre grotesque et tragique.\r\nLa lecture de ces tableaux s\u2019inscrit ainsi comme un espace de n\u00e9gociation du regard, saisi de prime abord par cet apparentement \u00e0 la chose photographique tenue pour vrai et les obstacles rencontr\u00e9s dans l\u2019effort de saisir la peinture d\u2019un seul tenant.\r\n\r\nG\u00e9om\u00e9tries\r\nLa pr\u00e9sentation de ces toiles sera associ\u00e9e \u00e0 une autre s\u00e9rie de tableaux en noir et blanc, dont le point de vue perspectif peut se voir simultan\u00e9ment en plong\u00e9 ou contre-plong\u00e9, comme dans la prise de vue cin\u00e9matographique. Une alternance de lignes blanches et noires viennent mettre en espace un motif r\u00e9p\u00e9t\u00e9 et pourtant \u00e0 chaque fois unique, figurant un \u00e9cran concave ou convexe \u00e0 la profondeur trouble. Ici \u00e9galement, le tableau r\u00e9siste \u00e0 l\u2019unit\u00e9 comme totalisation du visible, puisque les appuis o\u00f9 l\u2019oeil croit trouver prise se d\u00e9robent en un jeu d\u2019esquives toujours recommenc\u00e9.\r\n\r\nPar son travail prot\u00e9iforme, son traitement pictural des images, par le jeu des identifications et des disruptions qu\u2019il met en articulation, l\u2019artiste nous invite \u00e0 une r\u00e9flexion individuelle, philosophique fondamentale et essentielle.","performers":"Robert Suermondt  \"Trou dans le Miroir\"","boxoffice_url":null,"website":"http:\/\/www.micheleschoonjansgallery.be","email":"info@msgallery.be","phone_contact":"+32 478 71 62 96","phone_booking":"+32 478 71 62 96","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/531706.html"},"nl":{"name":"Robert Suermondt - Trou dans le Miroir","shortdescr":"De tentoonstelling brengt twee verschillende reeksen schilderijen samen, namelijk de reeks \u201cNeighborhoods\u201d en de reeks \u201cGeometry\u201d.","longdescr":"Van 15 mei tot en met 25 juni 2022 presenteert de galerie een solotentoonstelling met een selectie van recente schilderijen van de kunstenaar Robert Suermondt.\r\n\r\nDe tentoonstelling brengt twee verschillende series schilderijen samen, de\u201cNeighborhoods\u201d en \u201cGeometry\u201d.\r\n\r\nNeighbourhoods\r\nDe eerste reeks welke werd samengebracht onder de verzamelnaam \u201cNeighbourhoods\u201d, brengen voornamelijk luchtfoto's van wijken en wegen met auto\u2019s in beeld. Vooral de rommelige rangschikking van de auto's wekt hier spanning op, maar ook de schijnbaar willekeurig geschilderde achtergrond van het doek draagt hier aan bij. Deze vertegenwoordigt de representatie van het wegdek, wegmarkeringen en pijlen, kruispunten en bloemperken, uitgevoerd in een stijl die verwant is aan fotografisch realisme. De auto's zijn allemaal verschillend geschilderd, soms tamelijk schetsmatig, alsof ze geen plaats in het schilderij kregen toebedeeld. Dan weer gemarkeerd door dikke schaduwen, alsof ze achteloos en snel werden toegevoegd. Het bijzondere karakter van deze werken laat zich identificeren met verschillende en vaak tegenstrijdige beelden, aangezien ze aan \u00e9\u00e9n kant vaak komisch overkomen, maar op andere momenten op de rand van dissociatie lijken te balanceren, tussen het groteske en tragische. De interpretatie van deze schilderijen vindt bijgevolg plaats in een ruimte die wordt waargenomen in een oogflits en die doet denken aan een fotografische ervaring. En zo wordt het er een die voor waar wordt gehouden, temeer door de problemen die men ondervindt bij pogingen het schilderij als in \u00e9\u00e9n geheel te vatten. Het oog wordt voortdurend afgeleid, kijkt overal en nergens heen en is nauwelijks in staat het onderwerp als \u00e9\u00e9n geheel te zien.\r\n\r\nGeometry\r\nVergelijkbaar met het monteren van scenes in een film, wordt de rangschikking van de \u201cNeighbourhood\u201d doeken onderbroken door een andere reeks werken van Robert Suermondt en die hij onder de noemer \u201cGeometry\" samenbracht. Het zijn zwart-wit schilderijen, waarvan de invalshoek van onze blik tegelijkertijd als een verzonken beeld of juist als het omgekeerde, duidelijker en meer aan de oppervlakte, kan worden gezien. Dit verschijnsel dat zich duidelijk in meer of mindere maten afspeelt aan de oppervlakte, herhaalt zich als een uniek patroon dat in de ruimte wordt geplaatst door afwisselend witte en zwarte lijnen. Daardoor ontstaat er een hol of bol scherm met vage diepte. Ook hier verzet het schilderij zich tegen eenduidigheid als een optelsom van het zichtbare, omdat de dragers waar het oog houvast in denkt te vinden, wegglippen in een spel van ontwijken dat zich almaar opnieuw herhaalt. \r\nDoor zijn veelzijdigheid, zijn picturale omgang van beelden, en het spel van identificaties en verstoringen dat hij met deze werken teweegbrengt, leidt de kunstenaar ons naar een individuele, fundamentele en wezenlijk filosofische verkenning.\r\n\r\nRobert Suermondt\r\nRobert Suermondt (Nederlander, Zwitser en Sloveen) werd in 1961 in Gen\u00e8ve geboren. Hij studeerde kunst aan de Ecole Sup\u00e9rieure d'Art Visuel (ESAV) in de mixed media workshops van Cherif en Silvie Defraoui, van 1983 tot 1988, gevolgd door een post-graduate opleiding aan de Rijksakademie in Amsterdam, van 1989 tot 1992. Hij woont al meer dan 30 jaar in Brussel, sinds 1986, en toont regelmatig zijn werk in groeps- en solotentoonstellingen.","performers":"Robert Suermondt \" Trou dans le Miroir\"","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/531706.html"},"en":{"name":"Robert Suermondt - Trou dans le Miroir","shortdescr":"The exhibition brings together two distinct set of work, \u201cNeighbourhoods and Geometries\u201d.","longdescr":"From 15 May to 25 June 2022, the gallery will present a solo show with a selection of recent paintings by the artist Robert Suermondt.\r\n\r\nThe exhibition brings together two distinct set of work, \u201cNeighbourhoods and Geometries\u201d.\r\n\r\nNeighbourhoods\r\nThe first body of work, under the generic name of \u201cNeighbourhoods\u201d, shows aerial views of cars on urban roads. It is the miscellaneous arrangement of these cars that generates tension, as well as their ad hoc grip to the canvas background, representing road layout, road markings and arrows, crossroads and flowerbeds, in a style akin to photographic realism. These cars are all painted differently, sometimes barely sketched, or in a ghostly manner, as if they are removed from the painting itself, sometimes marked by thick shadows, as if quickly executed. Their particular character identifies with various and often contradictory image processes, since they can sometimes be comical but at other times appear on the verge of dissociation, between grotesque and tragic.\r\n\r\nThe interpretation of these paintings is consequently a space negotiated by a flicker of the eye, caught at first glance by the similarity to the photographic experience, and the difficulties encountered in the effort to comprehend the painting in one piece. \r\nThe eye gets distracted, looks anywhere and everywhere, but can no longer appreciate the subject in its entirety.\r\n\r\nGeometry\r\nSimilar to a film shot, the arrangement of these canvases will be interspersed by a second body of work, named \u201cGeometries\u201d.  The perspective of this series made of black and white paintings,  can be viewed simultaneously plunged or counter-plunged. A repeated yet unique pattern is set in space by alternating black and white lines, creating a concave or convex screen with blurred depth. Here too, the painting resists unity as a summation of the visible, the supports where the eye thinks it can find a foothold disappear to play a game of dodge that endlessly repeats itself.\r\n\r\nThrough his multi-faceted work, his pictorial treatment of images, and the play of identifications and disruptions that he articulates, the artist leads us to an individual, fundamental and essential philosophical  exploration .\r\n\r\nRobert Suermondt (Dutch, Swiss and Slovenian) was born in Geneva in 1961. He studied art at the Ecole Sup\u00e9rieure d'Art Visuel (ESAV) in the mixed media workshops of Cherif and Silvie Defraoui, from 1983 to 1988, followed by a post-graduate course at the Rijksakademie in Amsterdam, from 1989 to 1992. Established in Brussel, since 1986, he has been regularly showing his work in group and solo exhibitions.","performers":"Robert Suermondt 'Trou dans le Miroir\"","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/531706.html"},"de":{"name":"Robert Suermondt - Trou dans le Miroir","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/531706.html"},"it":{"name":"Robert Suermondt - Trou dans le Miroir","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/531706.html"},"sp":{"name":"Robert Suermondt - Trou dans le Miroir","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/531706.html"},"pt":{"name":"Robert Suermondt - Trou dans le Miroir","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/531706.html"},"cn":{"name":"Robert Suermondt - Trou dans le Miroir","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/531706.html"}},"place":{"id":275036,"translations":{"fr":{"name":"Mich\u00e8le Schoonjans Gallery","address_street_name":"Chauss\u00e9e de Waterloo","address_street_number":"690","address_street_box":"Rivoli #25","email":"info@micheleschoonjansgallery.be","website":"http:\/\/www.micheleschoonjansgallery.be","phone_contact":"+32 478 71 62 96","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Chauss\u00e9e de Waterloo, 690\/Rivoli #25","address_line2":"1180 Uccle","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Mich\u00e8le Schoonjans Gallery",