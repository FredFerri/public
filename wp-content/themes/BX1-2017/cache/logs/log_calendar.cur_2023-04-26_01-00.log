,"en":{"name":"BeerSecret","address_street_name":"Rue Antoine Dansaert","address_street_number":"188","address_street_box":null,"email":"liselot@creatiefcaura.com","website":"http:\/\/www.beersecret.com","phone_contact":"+32 472 60 47 46","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue Antoine Dansaert, 188","address_line2":"1000 Brussels","description_web":"Take part in an interactive and tasty beer tour in historical Brussels, Ghent or Bruges. In a small group you will learn about the history of beer, immerse yourself in the brewing process and discover the reasons behind  Belgian beer\u2019s worldwide fame. Savour a mix of traditional and craft beers paired with  artisan chocolate and other local delicacies. With the right mix of knowledge and humour, a young, passionate guide will reveal tantalizing beer secrets and tell you all about the rich world of Belgian beers. Our promise: the guarantee that you\u2019ll go home with a new favorite beer style after this unique tour.\r\nSince Covid-19, Liselot also developed virtual brewery tours with food pairing : a way to taste Belgium from home and get a virtual guide in diverse breweries while learning lots of interesting tips and fun facts.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"BeerSecret","address_street_name":"Rue Antoine Dansaert","address_street_number":"188","address_street_box":null,"email":"liselot@creatiefcaura.com","website":"http:\/\/www.beersecret.com","phone_contact":"+32 472 60 47 46","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Antoine Dansaert, 188","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"BeerSecret","address_street_name":"Rue Antoine Dansaert","address_street_number":"188","address_street_box":null,"email":"liselot@creatiefcaura.com","website":"http:\/