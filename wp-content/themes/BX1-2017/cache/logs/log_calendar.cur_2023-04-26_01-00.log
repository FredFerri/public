"de":["H\u00f6rverst\u00e4rker","Assistenzhund","Barrierefrei f\u00fcr Fu\u00dfg\u00e4nger mit Gehhilfe"],"it":["Apparecchi acustici","Cane guida","Accessibile ai pedoni con supporti"],"sp":["Aparatos de amplificaci\u00f3n del sonido","Perros gu\u00eda","Habilitado para peatones con aud\u00edfonos"],"pt":[null,null,null],"cn":[null,null,null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2023-04-16T02:37:55+02:00","published_at":"2022-11-17T10:50:52+01:00","backoffice_id":265790,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.2547308482414},{"id":554415,"date_start":"2023-04-12","date_end":"2023-06-15","date_next":"2023-06-14","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater","it":"Teatro","sp":"Teatro","pt":null,"cn":null}},"others":{"list":[51],"translations":{"fr":["Caf\u00e9 th\u00e9\u00e2tre"],"nl":["Cabaret"],"en":["Cabaret"],"de":["Kabarett"],"it":["Cabaret"],"sp":["Caf\u00e9 teatro"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"La Malle - Spectacle d'impro des Poussins Masqu\u00e9s","shortdescr":null,"longdescr":"\" LA MALLE \"\r\n\r\n5 improvisateur\u00b7ices vont d\u00e9couvrir sur sc\u00e8ne ce qu'il y a dans \"La Malle\", \r\ns'en inspirer pour cr\u00e9er des personnages de toute sorte \r\net se laisser emporter au travers d'improvisations courtes, moyennes et longues.\r\nLe myst\u00e9rieux contenu de cette malle se d\u00e9voilera au fur et \u00e0 mesure du spectacle pour nourrir les improvisateur\u00b7ices et vous faire voyager deux fois 45 minutes.\r\n\r\nCe spectacle est propos\u00e9 par l'\u00e9quipe des Poussins Masqu\u00e9s, une \u00e9quipe qui s'entraine \u00e0 Bruxelles et se produit r\u00e9guli\u00e8rement sur les sc\u00e8nes de Bruxelles et Wallonie, notamment dans le cadre du championnat adulte de la FBIA.\r\n\r\n-------`\r\nINFOS PRATIQUES\r\nLieu : Le TRAC\r\nAdresse : 110, rue Albert Meunier- Auderghem\r\nSpectacle \u00e0 20h15\r\nIl est possible de manger et\/ou boire un verre sur place avant le spectacle, pensez donc \u00e0 venir plus t\u00f4t! (Derni\u00e8re commande de restauration \u00e0 19h55!)\r\nR\u00c9SERVATIONS (vivement conseill\u00e9es)\r\nvia le lien du Trac : https:\/\/www.letrac.be\/reservations\r\nTARIFS\r\n- Sur r\u00e9servation : 10\u20ac\/\u00e9tudiant & 13\u20ac\/adulte\r\n- Sur place : 15\u20ac\/personne","performers":"L'\u00e9quipe des Poussins Masqu\u00e9s","boxoffice_url":null,"website":"http:\/\/www.letrac.be\/reservation","email":"info@letrac.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.554415"},"nl":{"name":"La Malle - Spectacle d'impro des Poussins Masqu\u00e9s","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.letrac.be\/reservation","email":"info@letrac.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.554415"},"en":{"name":"La Malle - Spectacle d'impro des Poussins Masqu\u00e9s","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.letrac.be\/reservation","email":"info@letrac.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.554415"},"de":{"name":"La Malle - Spectacle d'impro des Poussins Masqu\u00e9s","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.letrac.be\/reservation","email":"info@letrac.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/