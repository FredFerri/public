8:00 and from 20:30 to 22:30"],"it":["monday, tuesday, wednesday and sunday: closed","thursday and friday: from 20:30 to 22:30","saturday: from 16:00 to 18:00 and from 20:30 to 22:30"],"sp":["monday, tuesday, wednesday and sunday: closed","thursday and friday: from 20:30 to 22:30","saturday: from 16:00 to 18:00 and from 20:30 to 22:30"],"pt":["monday, tuesday, wednesday and sunday: closed","thursday and friday: from 20:30 to 22:30","saturday: from 16:00 to 18:00 and from 20:30 to 22:30"],"cn":["monday, tuesday, wednesday and sunday: closed","thursday and friday: from 20:30 to 22:30","saturday: from 16:00 to 18:00 and from 20:30 to 22:30"]},"date_start":"2023-02-23","date_end":"2023-03-18","is_also_by_appointment":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"},"de":{"name":"Normal"},"it":{"name":"Normale"},"sp":{"name":"Normal"},"pt":{"name":"Normal"},"cn":{"name":"Normal"}},"value":15},{"translations":{"fr":{"name":"Enfants"},"nl":{"name":"Kinderen"},"en":{"name":"Children"},"de":{"name":"Kinder"},"it":{"name":"Bambini"},"sp":{"name":"Ni\u00f1os"},"pt":{"name":"Enfants"},"cn":{"name":"Enfants"}},"value":10},{"translations":{"fr":{"name":"Jeunes"},"nl":{"name":"Jongeren"},"en":{"name":"Young people"},"de":{"name":"Jugendliche"},"it":{"name":"Ragazzi"},"sp":{"name":"J\u00f3venes"},"pt":{"name":"Jeunes"},"cn":{"name":"Jeunes"}},"value":10},{"translations":{"fr":{"name":"Etudiants"},"nl":{"name":"Studenten"},"en":{"name":"Students"},"de":{"name":"Studierende"},"it":{"name":"Studenti"},"sp":{"name":"Estudiantes"},"pt":{"name":"Etudiants"},"cn":{"name":"Etudiants"}},"value":10},{"translations":{"fr":{"name":"Seniors"},"nl":{"name":"Senioren"},"en":{"name":"Seniors"},"de":{"name":"Senioren"},"it":{"name":"Anziani"},"sp":{"name":"Mayores"},"pt":{"name":"Seniors"},"cn":{"name":"Seniors"}},"value":10},{"translations":{"fr":{"name":"Article 27"},"nl":{"name":"Artikel 27"},"en":{"name":"Article 27"},"de":{"name":"Article 27"},"it":{"name":"Article 27"},"sp":{"name":"Article 27"},"pt":{"name":"Article 27"},"cn":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[],"targets":{"list":[11],"translations":{"fr":["Famille"],"nl":["Familie"],"en":["Family"],"de":["Familie"],"it":["Famiglie"],"sp":["Familias"],"pt":[null],"cn":[null]}},"tags":["kids"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-03-05T03:35:36+01:00","published_at":"2023-02-22T09:41:48+01:00","backoffice_id":272312,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":0.43679023236815},{"id":544153,"date_start":"2023-02-16","date_end":"2023-04-01","date_next":"2023-03-09","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung","it":"Esposizioni","sp":"Exhibici\u00f3n","pt":null,"cn":null}},"others":{"list":[36,39],"translations":{"fr":["Mus\u00e9es et art centers","Photographie"],"nl":["Musea en kunstcentra","Fotografie"],"en":["Museums and art centers","Photography"],"de":["Museen & Kunstzentren","Fotografie"],"it":["Musei e centri artistici","Fotografia"],"sp":["Museos y centros de arte","Fotograf\u00eda"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"L\u2019esprit de l'Art Nouveau, Photographies de Gilbert De Keyser","shortdescr":"Dans le cadre de l'ann\u00e9e Art Nouveau. Exploration des tr\u00e9sors de l'Art Nouveau de notre capitale, \u00e0 travers le regard de Gilbert De Keyser et une centaine de ses photographies.","longdescr":"Gilbert De Keyser (Bruxelles, 1925-2001), jeune photographe, s'est attach\u00e9 au rendu des rues de Bruxelles dans les ann\u00e9es 50, et des d\u00e9molitions qui se produisaient alors dans le patrimoine b\u00e2ti du 19e si\u00e8cle. Tr\u00e8s naturellement, il est pass\u00e9 du regard attrist\u00e9 et nostalgique sur la ville en mutation \u00e0 l'\u00e9vocation plus pr\u00e9cise des d\u00e9tails des pierres taill\u00e9es des maisons \u00e9clectiques et Art Nouveau menac\u00e9e de disparition. Il s'est finalement concentr\u00e9 sur ces derni\u00e8res avec une intensit\u00e9 exceptionnelle. L'exposition r\u00e9unira une centaine de ces images photographiques qui unissent les qualit\u00e9s \u00e0 la fois documentaires et artistiques. Certaines sont des tirages d\u2019\u00e9poque en noir & blanc, d\u2019autres des diapositives couleurs.\r\n\r\nCommissaire : Pierre Loze\r\nAvec catalogue 16,5 x 24 cm. Texte : P. Loze","performers":"Commissaire : Pierre Loze\r\nPhotographe : Gilbert De Keyser","boxoffice_url":null,"website":"http:\/\/www.associationdupatrimoineartistique.be","email":"as.pat.art@gmail.com","phone_contact":null,"phone_booking":"+32 2 512 34 21","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.544153"},"nl":{"name":"De geest van Art Nouveau, Foto's van Gilbert De Keyser","shortdescr":"Programmatie ART NOUVEAU 2023. Tentoonstellingen bij de Association du Patrimoine artistique vzw","longdescr":"Gilbert De Keyser (Brussel, 1925-2001), een jonge fotograaf, legde zich toe op het weergeven van de straten van Brussel in de jaren 1950, en de afbraak die toen plaatsvond in het gebouwde erfgoed van de 19e eeuw. Op een natuurlijke wijze, is hij, van een bedroefde en nostalgische blik op de veranderende stad over gestapt, naar een meer precieze evocatie van de details van de geslepen stenen van de eclectische en Art Nouveau-huizen die bedreigd werden te verdwijnen. Hij concentreerde zich uiteindelijk op deze laatsten, met uitzonderlijke intensiteit. De tentoonstelling zal een honderdtal van deze fotografische beelden samenbrengen, die zowel documentaire als artistieke kwaliteiten verenigen. Sommige zijn vintage zwart-wit prints, andere zijn dia's in kleur.\r\n\u2022Curator: Pierre Loze\r\n\u2022Met catalogus 16,5 x 24 cm. Tekst: P. Loze","performers":"Curator : Pierre Loze\r\nFotograaf : Gilbert De Keyser","boxoffice_url":null,"website":"http:\/\/www.associationdupatrimoineartistique.be","email":"as.pat.art@gmail.com","phone_contact":null,"phone_booking":"+32 2 512 34 21","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.544153"},"en":{"name":"The spirit of Art Nouveau, Photographs by Gilbert De Keyser","shortdescr":"As part of the Art Nouveau Year 2023. Exploration of Art Nouveau treasures in our capital, through Gilbert De Keyser's eyes and a hundred or so of his photographs.","longdescr":"As a young photographer, Gilbert De Keyser (Brussels, 1925-2001) focused on the streets of Brussels in the 1950s and the demolitions that were taking place against the 19th century-built heritage. He smoothly moved from a sad and nostalgic look at the changing city, to a more precise evocation of the details of the eclectic and Art Nouveau houses threatened with destruction. He finally focused with exceptional intensity on the latter aspect. The exhibition will bring together about a hundred of these photographic images that combine both documentary and artistic qualities. Some of them are period black & white prints, others are coloured slides.\r\n\r\nCurator: Pierre Loze\r\nWith catalogue 16,5 x 24 cm. Text: P. Loze","performers":"Curator : Pierre Loze\r\nPhotographer : Gilbert De Keyser","boxoffice_url":null,"website":"http:\/\/www.associationdupatrimoineartistique.be","email":"as.pat.art@gmail.com","phone_contact":null,"phone_booking":"+32 2 512 34 21","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.544153"},"de":{"name":"L\u2019esprit de l'Art nouveau, Gilbert De Keyser photographe","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":nul