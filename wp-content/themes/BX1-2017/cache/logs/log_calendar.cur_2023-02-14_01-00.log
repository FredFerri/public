[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Amarillys Gr\u00e9goire \u2013 Chant M\u00e9di\u00e9vaux et Baroques","shortdescr":"\u00abChants M\u00e9di\u00e9vaux et Baroques\u00bb : M\u00e9nestrels, trouv\u00e8res et troubadours, Caccini, Monteverdi\u2026 Amarillys Gr\u00e9goire nous invite au voyage \u00e0 travers les \u00e8res lointaines du moyen \u00e2ge et de la renaissance. Douceur et humour m\u00ealeront chants d\u2019amour, r\u00eaveurs et \u00e0 boire\u2026 Elle se produit en r\u00e9citals, dont elle pr\u00e9sente, explique et raconte les \u0153uvres \u00e0 la mani\u00e8re d\u2019une conversation avec le public...","longdescr":"\u00abChants M\u00e9di\u00e9vaux et Baroques\u00bb : M\u00e9nestrels, trouv\u00e8res et troubadours, Caccini, Monteverdi\u2026 Amarillys Gr\u00e9goire nous invite au voyage \u00e0 travers les \u00e8res lointaines du moyen \u00e2ge et de la renaissance. Douceur et humour m\u00ealeront chants d\u2019amour, r\u00eaveurs et \u00e0 boire dont elle nous contera aussi les histoires\u2026 Elle a fait sa carri\u00e8re en Europe \u00e0 Vienne, Salzburg, Linz, Prague, Brno, Bruxelles, Catane, Roskilde, S\u00e9ville, etc\u2026 Ses r\u00f4les les plus marquants sont, entre autres : Le Requiem de Verdi, La Traviata, La Reine de la Nuit, Lakm\u00e9... Actuellement, elle se produit en r\u00e9citals, dont elle pr\u00e9sente, explique et raconte les \u0153uvres \u00e0 la mani\u00e8re d\u2019une conversation avec le public...","performers":"Amarillys Gr\u00e9goire (interpr\u00e9tation)","boxoffice_url":null,"website":"http:\/\/www.lejardindemasoeur.be","email":"info@lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.548091"},"nl":{"name":"Amarillys Gr\u00e9goire \u2013 Chant M\u00e9di\u00e9vaux et Baroques","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/ww