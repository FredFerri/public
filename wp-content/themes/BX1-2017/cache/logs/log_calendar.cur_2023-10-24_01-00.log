chool_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2023-10-16T12:08:07+02:00","published_at":"2022-11-14T15:21:56+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":265572,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"festival","ranking":0.5665163349427048,"languages":{"spoken":["en","fr","nl"],"subtitles":[]},"categories":{"main":{"id":118,"translations":{"de":"Festival","pt":null,"en":"Festival","it":"Festival","cn":null,"fr":"Festival","sp":"Festival","nl":"Festival"}},"others":{"list":[119],"translations":{"de":["Kino"],"pt":[null],"en":["Cinema  "],"it":["Cinema"],"cn":[null],"fr":["Cin\u00e9ma"],"sp":["Cine"],"nl":["Cinema"]}}},"translations":{"de":{"name":"Filem'on Film Festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.filemon.be","email":"comfilemon@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.545572"},"pt":{"name":"Filem'on Film Festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.filemon.be","email":"comfilemon@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.545572"},"en":{"name":"Filem'on Film Festival","shortdescr":"Filem'On - the International Film Festival for Young Audiences - is entering its 17th edition, with a 10-day festival from 25 October to 4 November 2023. As every year, the festival presents a unique program to schools, families and associations in top cultural venues in Brussels.","longdescr":"More than 130 films, in all genres and formats, for audiences aged 2 to 16, are on the bill. There are Belgian, European and international competition sections, and many films are shown in the presence of the director or one of the actors. There are also plenty of fun workshops and cin\u00e9-concerts specially organized for children and young people. In this edition, as in the creation of film, there will be played with illusions. Illusions that fool you and make it appear that you are seeing something other than what is in reality. This includes optical illusions, but also critical looks that pierce through the illusions in our society. In this theme we also think of magic and tricks that make you want to solve riddles. An edition Filem'on film festival where nothing is what it seems and sharp eyes go on discovery!","performers":null,"boxoffice_url":null,"website":"http:\/\/www.filemon.be","email":"comfilemon@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.545572"},"it":{"name":"Filem'on Film Festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.filemon.be","email":"comfilemon@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.545572"},"cn":{"name":"Filem'on Film Festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.filemon.be","email":"comfilemon@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.545572"},"fr":{"name":"Filem'on Film Festival","shortdescr":" Filem'On - le festival international du cin\u00e9ma jeune public - entame sa 17e \u00e9dition, avec un festival de 10 jours du 25 octobre au 4 novembre 2023. Comme chaque ann\u00e9e, le festival pr\u00e9sente un programme unique aux \u00e9coles, aux familles et aux associations dans les meilleurs lieux culturels de Bruxelles.","longdescr":"Plus de 130 films, de tous genres et formats, destin\u00e9s \u00e0 un public de 2 \u00e0 16 ans, sont \u00e0 l'affiche. Il existe des sections de comp\u00e9tition belges, europ\u00e9ennes et internationales, et de nombreux films sont projet\u00e9s en pr\u00e9sence du r\u00e9alisateur ou d'un des acteurs. Il y a \u00e9galement de nombreux ateliers ludiques et des cin\u00e9-concerts sp\u00e9cialement organis\u00e9s pour les enfants et les jeunes. \r\nDans cette \u00e9dition, comme dans la cr\u00e9ation cin\u00e9matographique, on jouera avec les illusions. Des illusions qui vous trompent et vous donnent l'impression de voir autre chose que la r\u00e9alit\u00e9. Il s'agit d'illusions optiques, mais aussi de regards critiques qui percent les illusions de notre soci\u00e9t\u00e9. Dans le cadre de ce th\u00e8me, nous nous int\u00e9ressons \u00e9galement \u00e0 la magie et aux tours qui donnent envie de r\u00e9soudre des \u00e9nigmes. Une \u00e9dition du festival de cin\u00e9ma Filem'on o\u00f9 rien n'est ce qu'il semble \u00eatre et o\u00f9 les yeux aiguis\u00e9s explorent !","performers":null,"boxoffice_url":null,"website":"http:\/\/www.filemon.be","email":"comfilemon@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.545572"},"sp":{"name":"Filem'on Film Festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.filemon.be","email":"comfilemon@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.545572"},"nl":{"name":"Filem'on Filmfestival","shortdescr":"Filem\u2019On \u2013 het Internationaal Filmfestival voor Jong Publiek \u2013 viert de 17de editie, met een 11-daags festival van 25 oktober tot en met 4 november 2023. Zoals elk jaar stelt het Filem\u2019on filmfestival een uniek programma voor aan scholen, families en verenigingen in Brusselse culturele toplocaties. ","longdescr":"Het festival biedt een mix van meer dan 130 kortfilms, lange speelfilms en documentaires in alle genres en formaten, voor een publiek van 2 tot 16 jaar. Er zijn Belgische, Europese en internationale competitie-secties, en veel films worden getoond in aanwezigheid van de regisseur of een van de acteurs. Daarnaast zijn er ook tal van leuke workshops, filmstages en cin\u00e9-concerten speciaal georganiseerd voor kinderen en jongeren. In deze editie zal er, zoals bij het ontstaan van film, gespeeld worden met illusies. Illusies die je om de tuin leiden en het erop doen lijken dat je iets anders ziet dan wat er in de werkelijkheid is. Daarbij horen optische illusies, maar ook kritische blikken die doorheen de illusies in onze samenleving prikken. In dit thema denken we ook aan goochelen en trucs die je raadsels willen doen oplossen. Een editie Filem\u2019on filmfestival waar niets is wat het lijkt en scherpe ogen op ontdekking gaan!","performers":null,"boxoffice_url":null,"website":"http:\/\/www.filemon.be","email":"comfilemon@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.545572"}},"place":{"id":245448,"translations":{"de":{"name":"Divers lieux \u00e0 Bruxelles","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Divers lieux \u00e0 Bruxelles","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Divers lieux \u00e0 Bruxelles","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Divers lieux \u00e0 Bruxelles","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking