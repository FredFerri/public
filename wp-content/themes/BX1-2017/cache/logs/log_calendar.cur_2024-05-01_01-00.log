"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-04-30T02:01:41+02:00","published_at":"2024-04-02T16:34:14+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":297657,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.27421176687078685,"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[40,36],"translations":{"de":["Grafische K\u00fcnste","Museen & Kunstzentren"],"pt":[null,null],"en":["Graphic art","Museums and art centers"],"it":["Arti grafiche","Musei e centri artistici"],"cn":[null,null],"fr":["Arts graphiques","Mus\u00e9es et art centers"],"sp":["Artes gr\u00e1ficas","Museos y centros de arte"],"nl":["Grafische kunst, vormgeving","Musea en kunstcentra"]}}},"translations":{"de":{"name":"Va te faire Ma\u00eetre","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.mbfm.be","email":"info@mbfm.be","phone_contact":"+32 2 223 06 04","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50009125"},"pt":{"name":"Va te faire Ma\u00eetre","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.mbfm.be","email":"info@mbfm.be","phone_contact":"+32 2 223 06 04","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50009125"},"en":{"name":"Va te faire Ma\u00eetre","shortdescr":"60 original works by Belgian collage artist \u00c9melyne Duval will be put into perspective with objects from the museum\u2019s collection.","longdescr":"60 original works by Belgian collage artist \u00c9melyne Duval will be put into perspective with objects from the museum\u2019s collection.\n\n\u201cVa te faire Ma\u00eetre\u201d invites us on a whimsical journey in the world of contemporary art, at the heart of a didactic museum. Trough the realm of collage art, \u00c9melyne Duval masterfully reinterprets and recontextualises pre-existing images, breathing new life and meaning into them. Delve into this unique and captivating artistic exploration that seamlessly blends the past with the present.\n\nEach piece is meticulously crafted from a mosaic of ancient pictures and timeworn papers, each laden with its own captivating story.","performers":"\u00c9melyne Duval (contemporary artist)","boxoffice_url":null,"website":"http:\/\/www.mbfm.be","email":"info@mbfm.be","phone_contact":"+32 2 223 06 04","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50009125"},"it":{"name":"Va te faire Ma\u00eetre","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.mbfm.be","email":"info@mbfm.be","phone_contact":"+32 2 223 06 04","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50009125"},"cn":{"name":"Va te faire Ma\u00eetre","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.mbfm.be","email":"info@mbfm.be","phone_contact":"+32 2 223 06 04","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50009125"},"fr":{"name":"Va te faire Ma\u00eetre","shortdescr":"60 oeuvres originales de l\u2019artiste collagiste belge \u00c9melyne Duval seront mises en perspective avec des objets de la collection du Mus\u00e9e.\n\n","longdescr":"60 oeuvres originales de l\u2019artiste collagiste belge \u00c9melyne Duval seront mises en perspective avec des objets de la collection du Mus\u00e9e.\n\n\u00ab Va te faire Ma\u00eetre \u00bb propose une immersion parfois fantasque dans le monde de l\u2019art contemporain au sein d\u2019un mus\u00e9e didactique. Les collages, en tant qu\u2019expression artistique, permettent \u00e0 \u00c9melyne Duval de r\u00e9interpr\u00e9ter et recontextualiser des images pr\u00e9existantes pour en offrir de nouvelles lectures. Nous vous invitons chaleureusement \u00e0 d\u00e9couvrir cette exploration artistique aussi captivante qu\u2019unique.\n\nLe travail d\u2019\u00c9melyne Duval s\u2019appuie sur des images glan\u00e9es \u00e7\u00e0 et l\u00e0 d\u2019anciens documents r\u00e9cup\u00e9r\u00e9s et de vieux papiers charg\u00e9s d\u2019Histoires.","performers":"\u00c9melyne Duval (artiste contemporaine)\n","boxoffice_url":null,"website":"http:\/\/www.mbfm.be","email":"info@mbfm.be","phone_contact":"+32 2 223 06 04","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50009125"},"sp":{"name":"Va te faire Ma\u00eetre","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.mbfm.be","email":"info@mbfm.be","phone_contact":"+32 2 223 06 04","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50009125"},"nl":{"name":"Meester(s) Werken","shortdescr":"60 originele werken van de Belgische collagiste Emelyne Duval gaan een dialoog aan met voorwerpen uit de collectie van het museum.","longdescr":"60 originele werken van de Belgische collagiste Emelyne Duval gaan een dialoog aan met voorwerpen uit de prestigieuze collectie van het museum.\n\nAls een harmonieus evenwicht tussen traditie en vernieuwing, is \u201cMeester(s)werken\u201d een onderdompeling in de dikwijls fantastische wereld van de hedendaagse kunst en dit in een didactisch museum. De collages, als artistieke expressievorm laten Emelyne Duval toe om\nbestaande beelden te herinterpreteren en in een nieuwe context te plaatsen. Zo brengt ze een nieuwe, andere lezing van het getoonde tot leven.\nWe nodigen jullie van harte uit voor deze artistieke verkenningstocht, die even boeiend als uniek is.\n\nHet werk van Emelyne Duval berust op her en der gesprokkelde beelden, oude documenten of papieren doordrenkt van geschiedenis.","performers":"\u00c9melyne Duval (hedendaagse kunstenaar)","boxoffice_url":null,"website":"http:\/\/www.mbfm.be","email":"info@mbfm.be","phone_contact":"+32 2 223 06 04","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50009125"}},"place":{"last_updated_at":"2024-03-05T15:42:17+01:00","published_at":"2013-10-19T01:19:49+02:00","id":243784,"translations":{"de":{"name":"Belgisches Museum der Freimaurerei","address_street_name":"Rue de Laeken","address_street_number":"73","address_street_box":null,"email":"info@mbfm.be","website":"http:\/\/www.mbfm.be","phone_contact":"+32 2 223 06 04","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Laeken, 73","address_line2":"1000 Bruxelles","description_web":"Das Museum befindet sich in den Geb\u00e4uden des Grand Orient de Belgique, der \u00e4ltesten und gr\u00f6\u00dften Freimaurerloge Belgiens. Es birgt zahlreiche historische Sammlungen: Gem\u00e4lde, thematische Vitrinen mit Dokumenten, Schmuck, Geschirr und freimaurerischen Schriften.\n\n\nAu\u00dfergew\u00f6hnliche \u00d6ffnungszeiten:\nErster Sonntag im Monat: 13.00 - 17.00 Uhr freier Eintritt","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Museo Belga de la Francmasoner\u00eda","address_street_name":"Rue de Laeken","address_street_number":"73","address_street_box":null,"email":"info@mbfm.be","website":"http:\/\/www.mbfm.be","phone_contact":"+32 2 223 06 04","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Laeken, 73","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Belgian Museum of Freemasonry","address_street_name":"Rue de Laeken","address_street_number":"73","address_street_box":null,"email":"info@mbfm.be","website":"http:\/\/www.mbfm.be","phone_contact":"+32 2 223 06 04","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue de Laeken, 73","address_line2":"1000 Brussels","description_web":"Historic and thematic overview of the history of freemasonry in Belgium.\nThe Belgian Museum of Freemasonry is a gesture of openness, an invitation by an institution renowned for it\u2019s discretion and veiled in mystery, to get acquainted with its history. The museum, situated in an exquisitely restored neoclassical townhouse (house Dewez, late 18th century), presents artworks, ritual objects, jewellery, textiles, documents and books from the 18th century and on. They illustrate the origins, historic evolution, workings, ideas and present structures of freemasonry. \n\nExceptional opening:\nFirst Sunday of the month: 13.00 - 17.00 free admission","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Museo Belga della Massoneria","address_street_name":"Rue de Laeken","address_street_number":"73","address_street_box":null,"email":"info@mbfm.be","website":"http:\/\/www.mbfm.be","phone_contact":"+32 2 223 06 04","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Laeken, 73","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Mus\u00e9e Belge de la Franc-Ma\u00e7onnerie","address_street_name":"Rue de Laeken","address_street_number":"73","address_street_box":null,"email":"info@mbfm.be","website":"http:\/\/www.mbfm.be","phone_contact":"+32 2 223 06 04","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Laeken, 73","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Mus\u00e9e Belge de la Franc-Ma\u00e7onnerie","address_street_name":"Rue de Laeken","address_street_number":"73","address_street_box":null,"email":"info@mbfm.be","website":"http:\/\/www.mbfm.be","phone_contact":"+32 2 223 06 04","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Laeken, 73","address_line2":"1000 Bruxelles","description_web":"Aper\u00e7u historique et th\u00e9matique de la franc-ma\u00e7onnerie en Belgique.\nLe Mus\u00e9e Belge de la Franc-Ma\u00e7onnerie correspond \u00e0 une volont\u00e9 d\u2019ouverture de la part d\u2019une association entour\u00e9e de myst\u00e8re. Situ\u00e9 dans un b\u00e2timent n\u00e9oclassique (H\u00f4tel Dewez, fin 18\u00e8me si\u00e8cle), les visiteurs ont la possibilit\u00e9 de d\u00e9couvrir l\u2019histoire, la symbolique et les valeurs d\u00e9fendues par les francs\u2013ma\u00e7ons. Le mus\u00e9e pr\u00e9sente des objets d\u2019art, des d\u00e9corations, des bijoux, de la vaisselle, des documents et des livres datant du 18\u00e8me si\u00e8cle \u00e0 nos jours qui t\u00e9moignent de l\u2019\u00e9volution historique, du fonctionnement, des id\u00e9es et des structures de la franc-ma\u00e7onnerie.\n\n\nOuverture exceptionnelle:\nPremier dimanche du mois : 13.00 \u2013 17.00 entr\u00e9e gratuite","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Museo Belga de la Francmasoner\u00eda","address_street_name":"Rue de Laeken","address_street_number":"73","address_street_box":null,"email":"info@mbfm.be","website":"http:\/\/www.mbfm.be","phone_contact":"+32 2 223 06 04","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Laeken, 73","address_line2":"1000 Bruxelles","description_web":"El Museo Belga de la Francmasoner\u00eda responde a un deseo de apertura por parte de una asociaci\u00f3n conocida por su discreci\u00f3n. Intenta explicar el enfoque mas\u00f3nico a trav\u00e9s de vitrinas tem\u00e1ticas y did\u00e1cticas, con el fin de informar y estimular la reflexi\u00f3n. Las piezas presentadas \u2014decoraciones, joyas, vajillas, libros... desde el siglo XVIII hasta nuestros d\u00edas\u2014 son muestras, marcas de la memoria que ilustran la evoluci\u00f3n hist\u00f3rica, el funcionamiento, las ideas y las estructuras actuales de la francmasoner\u00eda. \n\nApertura excepcional:\nPrimer domingo de mes: 13.00 - 17.00 entrada gratuita","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Belgisch Museum van de Vrijmetselarij","address_street_name":"Lakensestraat","address_street_number":"73","address_street_box":null,"email":"info@mbfm.be","website":"http:\/\/www.mbfm.be","phone_contact":"+32 2 223 06 04","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Lakensestraat, 73","address_line2":"1000 Brussel","description_web":"Historisch en thematisch overzicht van de vrijmetselarij in Belgi\u00eb.\nHet Belgisch Museum van de Vrijmetselarij is een gebaar van openheid, een uitnodiging van een vereniging die bekend staat voor haar discretie, om haar geschiedenis beter te leren kennen. Het museum, gelegen in een prachtig gerestaureerd, neo-classicistisch gebouw (Huis Dewez, eind 18de eeuw), stelt ma\u00e7onnieke kunstwerken, gebruiksvoorwerpen, boeken en documenten van de 18de eeuw tot heden tentoon. Het zijn stille getuigen van de oorsprong, historische evolutie, de werking, de idee\u00ebn en de hedendaagse structuren van de vrijmetselarij.\n\n\nUitzonderlijke opening:\nEerste zondag van de maand: 13.00 - 17.00 uur gratis toegang","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[20],"translations":{"de":["Norden"],"pt":[null],"en":["North"],"it":["Nord"],"cn":[null],"fr":["Nord"],"sp":["Norte"],"nl":["Noord"]}},"neca":null,"facebook_id":null,"backoffice_id":6129,"location":{"lat":50.8743005,"lon":4.34745802},"region":"brussels","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"last_updated_at":"2024-03-05T15:42:17+01:00","published_at":"2013-10-19T01:19:49+02:00","id":243784,"translations":{"de":{"name":"Belgisches Museum der Freimaurerei","address_street_name":"Rue de Laeken","address_street_number":"73","address_street_box":null,"email":"info@mbfm.be","website":"http:\/\/www.mbfm.be","phone_contact":"+32 2 223 06 04","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Laeken, 73","address_line2":"1000 Bruxelles","description_web":"Das Museum befindet sich in den Geb\u00e4uden des Grand Orient de Belgique, der \u00e4ltesten und gr\u00f6\u00dften Freimaurerloge Belgiens. Es birgt zahlreiche historische Sammlungen: Gem\u00e4lde, thematische Vitrinen mit Dokumenten, Schmuck, Geschirr und freimaurerischen Schriften.\n\n\nAu\u00dfergew\u00f6hnliche \u00d6ffnungszeiten:\nErster Sonntag im Monat: 13.00 - 17.00 Uhr freier Eintritt","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Museo Belga de la Francmasoner\u00eda","address_street_name":"Rue de Laeken","address_street_number":"73","address_street_box":null,"email":"info@mbfm.be","website":"http:\/\/www.mbfm.be","phone_contact":"+32 2 223 06 04","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Laeken, 73","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Belgian Museum of Freemasonry","address_street_name":"Rue de Laek