l":"mariehelenechassagne@librairielimaginaire.be","phone_contact":"+32 479 05 20 40","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700002943"},"it":{"name":"Vernissage : KILLOFFER sait tout faire","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.librairielimaginaire.be\/","email":"mariehelenechassagne@librairielimaginaire.be","phone_contact":"+32 479 05 20 40","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700002943"},"cn":{"name":"Vernissage : KILLOFFER sait tout faire","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.librairielimaginaire.be\/","email":"mariehelenechassagne@librairielimaginaire.be","phone_contact":"+32 479 05 20 40","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700002943"},"fr":{"name":"Vernissage : KILLOFFER sait tout faire","shortdescr":"Premi\u00e8re exposition personnelle de l\u2019artiste Killoffer en Belgique. Elle pr\u00e9sente une quarantaine d\u2019\u0153uvres majeures et une s\u00e9lection d\u2019une centaine de dessins de petits formats. \u00c0 cette occasion, la librairie-galerie propose un ensemble de ses ouvrages et publie *Catharsis*, une s\u00e9rie de dessins initialement parus dans la revue *Mon Lapin Quotidien*.\n\n","longdescr":"Premi\u00e8re exposition personnelle de l\u2019artiste Killoffer en Belgique. Killoffer est l\u2019un des membres fondateurs de L\u2019Association, maison d\u2019\u00e9dition cr\u00e9\u00e9e en 1990, et du trimestriel *Mon Lapin Quotidien*. Il \u00e9volue dans l\u2019univers de la bande dessin\u00e9e, avec des albums d\u00e9sormais embl\u00e9matiques (*676 apparitions de Killoffer* ou, plus r\u00e9cemment, *Killoffer en chair et en fer*), que dans celui du dessin, comme en t\u00e9moigne son livre monographique *Charbons*, ou encore dans la presse avec ses illustrations publi\u00e9es dans Lib\u00e9ration et Le Monde. Souvent d\u00e9sopilant, Killoffer se met volontiers en sc\u00e8ne, \u00ab vaquant \u00e0 ses occupations d\u2019homme contemporain, entre son appartement, les servitudes quotidiennes et un penchant immod\u00e9r\u00e9 pour les exc\u00e8s en tous genres \u00bb.\nVernissage : KILLOFFER sait tout faire, le samedi 26 octobre \u00e0 18h \u00e0 l'Imaginaire, place du Jeu de Balle 30, \u00e0 Bruxelles.","performers":"Killoffer, dessinateur.","boxoffice_url":null,"website":"http:\/\/www.librairielimaginaire.be\/","email":"mariehelenechassagne@librairielimaginaire.be","phone_contact":"+32 479 05 20 40","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700002943"},"sp":{"name":"Vernissage : KILLOFFER sait tout faire","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.librairielimaginaire.be\/","email":"mariehelenechassagne@librairielimaginaire.be","phone_contact":"+32 479 05 20 40","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700002943"},"nl":{"name":"Vernissage : KILLOFFER sait tout faire","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.librairielimaginaire.be\/","email":"mariehelenechassagne@librairielimaginaire.be","phone_contact":"+32 479 05 20 40","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700002943"}},"place":{"id":50000894,"translations":{"de":{"name":"Librairie-Galerie L'Imaginaire","address_street_name":null,"address_street_number":"30","address_street_box":null,"email":"mariehelene.chassagne@gmail.com","website":"http:\/\/www.librairielimaginaire.be\/","phone_contact":"+32 479 05 20 40","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Librairie-Galerie L'Imaginaire","address_line2":"1000 Bruxelles","description_web":null,"descr