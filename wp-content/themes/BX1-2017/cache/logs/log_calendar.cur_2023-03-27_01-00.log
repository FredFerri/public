 Sub terra | Meet the Curator","copyright":null},"cn":{"title":"Expo Sub terra | Meet the Curator","copyright":null}}}],"dates":[{"day":"2023-03-12","doors":null,"start":"11:00:00","end":"12:30:00","is_soldout":false,"is_canceled":false},{"day":"2023-04-23","doors":null,"start":"11:00:00","end":"12:30:00","is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"},"de":{"name":"Normal"},"it":{"name":"Normale"},"sp":{"name":"Normal"},"pt":{"name":"Normal"},"cn":{"name":"Normal"}},"value":5}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-03-13T03:06:25+01:00","published_at":"2023-02-10T13:26:57+01:00","backoffice_id":271476,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.3624601243343},{"id":551526,"date_start":"2023-03-12","date_end":"2023-04-23","date_next":"2023-04-23","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen","it":"Visite guidate","sp":"Visitas guiadas","pt":null,"cn":null}},"others":{"list":[255],"translations":{"fr":["Visites d'expositions"],"nl":["Tentoonstelling"],"en":["Exhibition guided tours"],"de":["Besuche von Ausstellungen"],"it":["Visite a esposizioni"],"sp":["Visitas a las exposiciones"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Expo Sub terra | Family Sunday","shortdescr":"Visite guid\u00e9e sensorielle & Labo artistico-cr\u00e9atif dans le cadre de l'exposition SUB TERRA \u00e0 la Maison des Arts","longdescr":"Visite guid\u00e9e sensorielle & Labo artistico-cr\u00e9atif.\r\n\r\nD\u00e9couvrez les \u0153uvres au travers d\u2019histoires et de jeux.\r\nDans le labo r\u00e9parti en quatre zones, exp\u00e9rimentez, jouez, dessinez et repartez avec votre cr\u00e9ation.\r\n\r\n1. La Biblio o\u00f9 des livres seront \u00e0 votre disposition sur les th\u00e9matiques de l\u2019\u00e9cologie, la g\u00e9ologie, la faune, les contes et mythes.\r\n\r\n2. La Zone d\u00e9couverte o\u00f9 vous pourrez observer le monde v\u00e9g\u00e9tal et g\u00e9ologique.\r\n\r\n3. La Zone arch\u00e9o: fouillez et exhumez !\r\n\r\n4. Vie animale souterraine et terriers: Les\u00a0terriers\u00a0sont les logements les plus \u00e9labor\u00e9s que l\u2019on rencontre en for\u00eat, a quoi servent-ils\u00a0? Comment sont-ils construits\u00a0?\r\n\r\n\u00a0\r\n\r\nINFOS\r\n\r\n12.03 & 23.04  \r\n\r\n2 horaires possibles :\r\n15:00 -16:00 visite + 16:00-17:00 labo\r\n16:00-17:00 visite + 17:00-18:00 labo\r\n\r\nPour les enfants \u00e0 partir de 3 ans\r\n\r\n5 \u20ac\/pers ou 15 \u20ac\/famille (2 adultes & 2 enfants)\r\n\r\nInscription obligatoire\r\n\r\nEstaminet est ouvert et proposera un brunch sp\u00e9cialement pr\u00e9vu pour l\u2019occasion!\r\nQuand? De 11h-15h\r\nPrix: 17,5\u20ac (Brunch \u00e0 volont\u00e9, boissons non incluses)\r\nR\u00e9servation obligatoire: par mail \u00e0 info@estaminet1030.be \r\nPhoto: Corine Borgnet, Le dernier souper, 2019. Copyright: Atelierfind art1","performers":null,"boxoffice_url":null,"website":"http:\/\/lamaisondesarts.be\/family-sunday-sub-terra\/","email":"info@lamaisondesarts.be","phone_contact":null,"phone_booking":"+32 490 14 25 37","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.551526"},"nl":{"name":"Expo Sub terra | Family Sunday","shortdescr":"Zintuiglijke rondleiding & artistiek-creatief labo in het kader van de tentoonstelling SUB TERRA in la Maison des Arts","longdescr":"Zintuiglijke rondleiding & artistiek-creatief labo\r\n\r\nOntdek de kunstwerken aan de hand van verhalen en spelletjes.\r\nIn de vier zones van het labo ga je experimenteren, spelen en tekenen. Je creatie neem je daarna mee naar huis!\u00a0\r\n\r\n1. De Bibliotheek met boeken over ecologie, geologie, fauna, sprookjes en mythes.\r\n\r\n2. De Ontdekkingszone waar je de geologische en plantenwereld observeert.\r\n\r\n3. De Archeologische Zone: graaf op en ontdek!\r\n\r\n4. Holen en ander ondergronds dierenleven: holen zijn de meest uitgebreide woonplaatsen die je vindt in het bos. Waarvoor dienen ze? En hoe worden ze gebouwd?  \r\n\r\n\u00a0\r\n\r\nINFO\r\n\r\n12.03 & 23.04  \r\n\r\n2 mogelijke schema\u2019s :\r\n15:00 -16:00 bezoek + 16:00-17:00 labo\r\n16:00-17:00 bezoek + 17:00-18:00 labo\r\n\r\nVoor kinderen vanaf 3 jaar\r\n\r\n5 \u20ac\/pers of 15 \u20ac\/gezin (2 volwassenen & 2 kinderen)\r\n\r\nInscrijvingen verplicht\r\n\r\nL\u2019Estaminet is die dag open en houdt speciaal voor de gelegenheid een brunch!\r\nWanneer? 11:00 >15:00\r\nPrijs: 17,5\u20ac (Brunch \u00e0 volont\u00e9, dranken niet inbegrepen)\r\nReservatie verplicht per mail: info@estaminet1030.be\r\nFoto: Corine Borgnet, Le dernier souper, 2019. Copyright: Atelierfind art1","performers":null,"boxoffice_url":null,"website":"http:\/\/lamaisondesarts.be\/family-sunday-sub-terra\/","email":"info@lamaisondesarts.be","phone_contact":null,"phone_booking":"+32 490 14 25 37","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.551526"},"en":{"name":"Expo Sub terra | Family Sunday","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/lamaisondesarts.be\/family-sunday-sub-terra\/","email":"info@lamaisondesarts.be","phone_contact":null,"phone_booking":"+32 490 14 25 37","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.551526"},"de":{"name":"Expo Sub terra | Family Sunday","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,