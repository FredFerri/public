ys":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{"list":[109],"translations":{"fr":["Espaces verts"],"nl":["Groene zones"],"en":["Green spaces"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Garden Tales \u2013 Bon Air","shortdescr":"Garden Tales est un \u00e9v\u00e9nement annuel gratuit qui vous propose de visiter des jardins priv\u00e9s et publics \u00e0 Bruxelles.","longdescr":"Un impressionnant complexe de sept hectares de serres, d\u2019ateliers et de surfaces de culture comme lieu de l\u2019enseignement de l\u2019horticulture, telle est la vocation de ce site g\u00e9r\u00e9 par l\u2019Institut Redout\u00e9-Peiffer. Cette journ\u00e9e \u00e0 th\u00e8me sera l\u2019occasion de rencontres entre professionnels et amateurs.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.civa.brussels\/fr\/expos-events\/le-bon-air-une-pepiniere-de-jardiniers","email":"info@civa.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/534014.html"},"nl":{"name":"Garden Tales \u2013 Bon Air","shortdescr":"Garden Tales is een jaarlijks evenement waarbij je gratis heel wat priv\u00e9- en publieke tuinen in Brussel kan bezoeken.","longdescr":"Een indrukwekkend complex van zeven hectare aan serres, ateliers en teeltruimtes voor tuinbouweducatie, dat is het doel van deze site die wordt beheerd door het Institut Redout\u00e9-Peiffer. Op deze themadag kunnen professionele kwekers en hobbytuiniers elkaar ontmoeten.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/534014.html"},"en":{"name":"Garden Tales \u2013 B