rations blend introspection, fantasized memories of enigmatic landscapes, and works of art and craftsmanship imbued with strong mystical energy. This results in a mix of modesty and irony, meditative trances, and mysterious dissipations. Her work incorporates jazz energy (Eric Dolphy, Charles Mingus), colors drawn from the modern classical repertoire, as well as a contemporary jazz language.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.cafe-roskam.be","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700005091"},"it":{"name":"Laurence Cousseau 'Les Groseilles de Novembre'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.cafe-roskam.be","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700005091"},"cn":{"name":"Laurence Cousseau 'Les Groseilles de Novembre'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.cafe-roskam.be","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700005091"},"fr":{"name":"Laurence Cousseau 'Les Groseilles de Novembre'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.cafe-roskam.be","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700005091"},"sp":{"name":"Laurence Cousseau 'Les Groseilles de Novembre'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.cafe-roskam.be","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700005091"},"nl":{"name":"Laurence Cousseau 'Les Groseilles de Novembre'","shortdescr":null,"longdescr":null,"performe