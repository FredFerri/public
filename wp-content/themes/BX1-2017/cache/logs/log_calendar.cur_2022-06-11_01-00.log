d":false},{"day":"2022-06-15","doors":null,"start":"15:15:00","end":"15:00:00","is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":13}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-06-10T04:05:41+02:00","published_at":"2022-05-13T03:30:15+02:00","backoffice_id":253656,"import_origin":"explore","sub_type":"other","show_in_agenda":true,"ranking":1},{"id":533361,"date_start":"2022-06-15","date_end":"2022-06-15","date_next":"2022-06-15","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert"}},"others":{"list":[2],"translations":{"fr":["Classique"],"nl":["Klassiek"],"en":["Classical"]}}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Grand concert au profit des Ukrainiens","shortdescr":"Un programme vari\u00e9 sera propos\u00e9 par une quinzaine de musiciens qui se succ\u00e9deront ou joueront ensemble. Parmi eux, plusieurs artistes d\u2019origine russe et ukrainienne veulent montrer qu\u2019ensemble \u00ab Il y a tant de beaut\u00e9 \u00e0 sauver \u00bb, comme le proclame le titre de ce concert. Prix d\u2019entr\u00e9e \u00e0 partir de 25 \u20ac. R\u00e9servations : lejacquesfranck.be\/event\/listen\/2022-06-15","longdescr":"A l\u2018initiative d\u2019un groupe de citoyen et de musiciens soucieux de porter haut et fort un symbole de paix et d\u2019esp\u00e9rance au c\u0153ur de l\u2019Europe, un concert de musique classique sera donn\u00e9 le mercredi 15 juin \u00e0 20h00 \u00e0 l\u2019Abbaye de La Cambre (Ixelles).  L\u2019ensemble des b\u00e9n\u00e9fices sera vers\u00e9 au Consortium belge 12-12 pour les victimes de la guerre en Ukraine.\r\n\r\nUn programme vari\u00e9 sera propos\u00e9 par une quinzaine de musiciens de nationalit\u00e9s diff\u00e9rentes, qui se succ\u00e9deront ou joueront ensemble. Parmi eux, plusieurs artistes d\u2019origine russe et ukrainienne veulent montrer qu\u2019il est possible de se r\u00e9unir autour de la musique et qu\u2019ensemble \u00ab Il y a tant de beaut\u00e9 \u00e0 sauver \u00bb, comme le proclame le titre de ce concert. \r\nPrix d\u2019entr\u00e9e \u00e0 partir de 25 \u20ac. Un bar accueillera le public d\u00e8s 18h00 et apr\u00e8s le concert.\r\nInfo et r\u00e9servations : lejacquesfranck.be\/event\/listen\/2022-06-15 \r\nAvec le soutien de Musique 3, Flagey, Le Jacques Franck et Bruxelles Ville.","performers":"Les violonistes Philippe Graffin, Slatoslava Semsuk et Alexandra Cooreman, les violoncellistes Justus Grimm et Amy Norrington,  les pianistes Irina Lankova, Olivier Roberti,  Viktoriia Demkovska, Sofia Dubii, Christia Hudziy et Yaroslav Krushanivskyi, la soprano Ana Camelia Stefanescu, la hautbo\u00efste Khrystyna Korchynska, le Zenne Quartet, la chorale Eja Studiosi.","boxoffice_url":null,"website":"http:\/\/lejacquesfranck.be\/event\/listen\/2022-06-15","email":"jfdumont512@gmail.com","phone_contact":"+32 473 43 45 00","phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/533361.html"},"nl":{"name":"Groot concert ten voordele van Oekra\u00efners","shortdescr":"Een vijftiental gerenommeerde musici bieden een gevarieerd muzikaal programma. Onder hen zijn verschillende muzikanten van Russische en Oekra\u00efense afkomst die willen laten zien dat het mogelijk is om zich te verenigen rond muziek en dat er samen \"zo veel moois te redden is\" als de titel van dit concert.\r\nReservaties via lejacquesfranck.be\/event\/listen\/2022-06-15","longdescr":"Op initiatief van een groep burgers en musici, die een sterk signaal van vrede en hoop in het hart van Europa willen ontsteken zal op 15 juni om 20u in de Abdij van Ter Kameren in Elsene een klassiek concert worden georganiseerd waarvan de opbrengst integraal naar het consortium 12-12 zal gaan voor de oorlogsslachtoffers van de oorlog in Oekra\u00efne.\r\nEen vijftiental gerenommeerde musici van verschillende nationaliteiten bieden een gevarieerd muzikaal programma. Onder hen zijn verschillende muzikanten van Russische en Oekra\u00efense afkomst die willen laten zien dat het mogelijk is om zich te verenigen rond muziek en dat er samen \"zo veel moois te redden is\" als de titel van dit concert.\r\nDe ticketprijs bedraagt \u20ac25 en er zal een bar zijn voor en na het concert.\r\nReservaties via lejacquesfranck.be\/event\/listen\/2022-06-15\r\nMet de steun van Musique 3, Flagey, Le Jacques Franck en Bruxelles Ville.","performers":null,"boxoffice_url":null,"website":null,"email":"jfdumont512@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/533361.html"},"en":{"name":"Big concert for the benefit of Ukrainians","shortdescr":"About fifteen renowned musicians of various nationalities will offer a varied musical program. Among them are several musicians of Russian and Ukrainian origin who want to show that it is possible to unite around music and that together \"There is so much beauty to save\" as the title of this concert.\r\nInfo and reservations: lejacquesfranck.be\/event\/listen\/2022-06-15","longdescr":"On the initiative of a group of citizens and musicians anxious to carry loud and clear a symbol of peace and hope in the heart of Europe, a classical music concert will be given on Wednesday June 15 at 8 p.m. in the Abbey of La Cambre (Ixelles). All profits will be donated to the Belgian Consortium 12-12 for victims of the war in Ukraine.\r\n\r\nA varied program will be offered by about fifteen musicians of different nationalities, who will follow one another or play together. Among them, several artists of Russian and Ukrainian origin want to show that it is possible to come together around music and that together \"There is so much beauty to save\", as the title of this concert proclaims.\r\nEntry price from \u20ac25. A bar will welcome the public from 6 p.m. and after the concert.\r\nInfo and reservations: lejacquesfranck.be\/event\/listen\/2022-06-15\r\nWith the support of Musique 3, Flagey, Le Jacques Franck and Bruxelles Ville.","performers":null,"boxoffice_url":null,"website":null,"email":"jfdumont512@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/533361.html"},"de":{"name":"Grand concert au profit des Ukrainiens","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/533361.html"},"it":{"name":"Grand concert au profit des Ukrainiens","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/533361.html"},"sp":{"name":"Grand concert au profit des Ukrainiens","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/533361.html"},"pt":{"name":"Grand concert au profit des Ukrainiens","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/533361.html"},"cn":{"name":"Grand concert au profit des Ukrainiens","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/533361.html"}},"place":{"id":248797,"translations":{"fr":{"name":"Abbaye de la Cambre","address_street_name":"Abbaye de la Cambre","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Abbaye de la Cambre","address_line2":"1050 Ixelles","description_web":"Un bijou historique et architectural au c\u0153ur de la Ville. Cet endroit est tr\u00e8s appr\u00e9ci\u00e9 par les Bruxellois pour fl\u00e2ner, visiter ou passer des moments de d\u00e9tente, seul ou entre amis, dans les grands jardins qui bordent l'abbaye.\r\n\r\nCette abbaye fut fond\u00e9e en 1201 par une dame noble de Bruxelles appel\u00e9e Gis\u00e8le, et confi\u00e9e aux religieuses de l'Ordre de C\u00eeteaux. Les b\u00e2timents fortement endommag\u00e9s lors des guerres de religion, furent reconstruits au XVI\u00e8me si\u00e8cle et agrandis au XVIII\u00e8me si\u00e8cle. Seules certaines parties de l'\u00e9glise datent encore du XIV\u00e8me si\u00e8cle et appartiennent \u00e0 cette \u00e9poque de transition entre le gothique rayonnant et le flamboyant (Jardins).","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Ter Kamerenabdij","address_street_name":"Abdij ter Kameren","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"Abdij ter Kameren","address_line2":"1050 Elsene","description_web":"Vlakbij de vijvers van Elsene ligt de Abdij van Ter Kameren, een historisch en architectonisch pareltje in het centrum van de stad! Brusselaars komen er maar al te graag wandelen en ontspannen in de prachtige tuinen. \r\n\r\nDe abdij werd rond 1200 gesticht door Gisela, een adellijke dame uit Brussel. Zij wenste in het toenmalig dorp Elsene een cisterci\u00ebnzerklooster op te richten. Het is nog steeds een van de best bewaarde exemplaren in onze contreien. De gebouwen werden zwaar beschadigd tijdens de godsdienstoorlogen, maar werden in de 16de eeuw heropgebouwd en in de 18de eeuw uitgebreid. Enkele zeldzame delen van de kerk dateren nog uit de 14de eeuw en met name de overgangsperiode tussen de hoge en de flamboyante gotiek (tuinen).\r\n\r\nMomenteel herbergen de gebouwen het Nationaal Geografisch Instituut en de \u2018\u00c9cole nationale sup\u00e9rieure des arts visuels\u2019, beter bekend als \u2018La Cambre\u2019. \r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"La Cambre Abbey","address_street_name":"Abbaye de la Cambre","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Abbaye de la Cambre","address_line2":"1050 Ixelles","description_web":"A historical and architectural gem in the heart of the city. This place is loved by the people of Brussels, who come here to stroll, visit or enjoy a few moments of relaxation, alone or with friends, in the large gardens that border the abbey.\r\n\r\nThis abbey was founded in 1201 by a noble woman of Brussels named Gis\u00e8le, and was entrusted to the nuns of the Cistercian order. The buildings which were badly damaged during the Wars of Religion were rebuilt in the 16th century, and enlarged in the 18th century. Only certain parts of the church still date from the 14th century and belong to that transitional period between Gothic splendour and the flamboyant (Gardens).","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Abbaye de la Cambre","address_street_name":"Abbaye de la Cambre","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Abbaye de la Cambre","address_line2":"1050 Ixelles","description_web":"Die Abtei wurde 1201 von einer aus Br\u00fcssel stammenden Adligen namens Gis\u00e8le gegr\u00fcndet und den Nonnen des Ordens von C\u00eeteaux anvertraut. Die w\u00e4hrend der Religionskriege stark besch\u00e4digten Geb\u00e4ude wurden im 16. Jahrhundert wieder aufgebaut und im 18. Jahrhundert erweitert. Nur noch einige Partien der Kirche stammen aus dem 14. Jahrhundert und geh\u00f6ren zu dieser \u00dcbergangszeit zwischen der Rayonnantgotik und der Flamboyantgotik (G\u00e4rten).","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Abbaye de la Cambre","address_street_name":"Abbaye de la Cambre","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Abbaye de la Cambre","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Abbaye de la Cambre","address_street_name":"Abbaye de la Cambre","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Abbaye de la Cambre","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Abbaye de la Cambre","address_street_name":"Abbaye de la Cambre","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Abbaye de la Cambre","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Abbaye de la Cambre","address_street_name":"Abbaye de la Cambre","address_street_number":null,"