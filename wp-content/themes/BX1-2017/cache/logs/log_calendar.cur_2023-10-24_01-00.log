:30:00"},{"day":"2023-10-20","start":"20:00:00","end":"21:30:00"},{"day":"2023-10-21","start":"20:00:00","end":"21:30:00"},{"day":"2023-11-10","start":"20:00:00","end":"21:30:00"},{"day":"2023-11-11","start":"20:00:00","end":"21:30:00"}],"closing_days":[],"child_events":[],"parent_events":[],"accessibilities":[],"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[]},{"id":562466,"date_start":"2023-04-14","date_end":"2023-11-11","date_next":"2023-11-10","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":true,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2023-10-18T06:00:33+02:00","published_at":"2023-08-19T03:45:44+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":283559,"facebook_link":null,"import_origin":"bronks","is_part_of":null,"sub_type":"other","ranking":0.21129929348218257,"languages":{"spoken":["fr","en","nl"],"subtitles":[]},"categories":{"main":{"id":49,"translations":{"de":"Theater","pt":null,"en":"Theatre","it":"Teatro","cn":null,"fr":"Th\u00e9\u00e2tre","sp":"Teatro","nl":"Theater"}},"others":{"list":[50],"translations":{"de":["Theater"],"pt":[null],"en":["Theatre"],"it":["Teatro"],"cn":[null],"fr":["Th\u00e9\u00e2tre"],"sp":["Teatro"],"nl":["Theater"]}}},"translations":{"de":{"name":"Beating Choir\\Ch\u0153ur Battant","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.bronks.be","email":"info@bronks.be","phone_contact":null,"phone_booking":"+32 2 219 99 21","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.562466"},"pt":{"name":"Beating Choir\\Ch\u0153ur Battant","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.bronks.be","email":"info@bronks.be","phone_contact":null,"phone_booking":"+32 2 219 99 21","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.562466"},"en":{"name":"Beating Choir\\Ch\u0153ur Battant","shortdescr":"premi\u00e8re Belgium","longdescr":"Six performers take to the stage. \nThey come from different families, cities and countries.\u00a0Their youth is their uniting factor. \nThey introduce themselves.\u00a0 They express themselves. \nThey listen to the voices of hundreds of others. \nThey carry the sound of young people across the world. \n\n They are the ambassadors of their generation. Through movement and interaction, they explore the vulnerability and power of being young. \nHopeful and combative. \nPropelled, supported and carried by the soundscape of dozens of young voices from across the world, woven into one universal blanket of sound.\u00a0\u00a0 \n\n  Beating Choir\/Ch\u0153ur Battant  is a production by the Canadian Th\u00e9\u00e2tre Le Carrousel and the Belgian BRONKS young theatre. Three adolescents from Quebec engage in artistic exchange with three youngsters from Brussels. The performance is a follow-up to the online platform \u2018Creative in Solitude\u2019, founded by choreographer and director Zo\u00eb Demoustier during the pandemic, where young artists were able to share their feelings via artistic expression.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.bronks.be","email":"info@bronks.be","phone_contact":null,"phone_booking":"+32 2 219 99 21","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.562466"},"it":{"name":"Beating Choir\\Ch\u0153ur Battant","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.bronks.be","email":"info@bronks.be","phone_contact":null,"phone_booking":"+32 2 219 99 21","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.562466"},"cn":{"name":"Beating Choir\\Ch\u0153ur Battant","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.bronks.be","email":"info@bronks.be","phone_contact":null,"phone_booking":"+32 2 219 99 21","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.562466"},"fr":{"name":"Beating Choir\\Ch\u0153ur Battant","shortdescr":"premi\u00e8re Belgique","longdescr":"Six artistes se trouvent sur la sc\u00e8ne. \nIls viennent de familles, de villes et de pays diff\u00e9rents. Leur jeunesse est ce qui les unit. \nIls se pr\u00e9sentent. Ils s\u2019expriment. \nIls \u00e9coutent les voix de centaines d\u2019autres. \nIls portent la voix de jeunes du monde entier. \n\n Ils sont les ambassadeurs de leur g\u00e9n\u00e9ration. Par le mouvement et l'interaction, ils partent \u00e0 la recherche de la vuln\u00e9rabilit\u00e9 et de la force de la jeunesse. \nIls sont remplis d\u2019espoir, ils sont combatifs. \nIls sont propuls\u00e9s, soutenus et port\u00e9s par le paysage sonore de dizaines de voix d\u2019autres jeunes issus des quatre coins du monde. Le tout se tisse pour former un tapis sonore universel. \n\n  Beating Choir \/ Ch\u0153ur Battant \u00a0est une production du th\u00e9\u00e2tre canadien Le Carrousel et du th\u00e9\u00e2tre belge BRONKS pour jeune public. Trois jeunes Qu\u00e9b\u00e9cois ont particip\u00e9 \u00e0 un \u00e9change artistique avec trois jeunes Bruxellois. Ce spectacle fait suite \u00e0 la plateforme en ligne \u2018Creative in Solitude\u2019 cr\u00e9\u00e9e en temps de pand\u00e9mie par la chor\u00e9graphe et metteuse en sc\u00e8ne Zo\u00eb Demoustier. Cette plateforme permettait aux jeunes de partager leurs \u00e9motions en passant par l\u2019expression artistique.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.bronks.be","email":"info@bronks.be","phone_contact":null,"phone_booking":"+32 2 219 99 21","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.562466"},"sp":{"name":"Beating Choir\\Ch\u0153ur Battant","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.bronks.be","email":"info@bronks.be","phone_contact":null,"phone_booking":"+32 2 219 99 21","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.562466"},"nl":{"name":"Beating Choir\\Ch\u0153ur Battant","shortdescr":"Belgische premi\u00e8re","longdescr":"Zes performers staan op sc\u00e8ne. Afkomstig uit verschillende gezinnen, steden, landen, continenten. Hun jeugd is wat hen bindt. \n \nZe zoomen in. Ze zoomen uit. \nZe richten de blik naar binnen. Ze richten de blik naar buiten. \nZe spreken elkaar tegen. Ze versterken elkaar. \n \nZij zijn de ambassadeurs van hun generatie. Via beweging en interactie zoeken ze naar de kwetsbaarheid en de kracht in hun eigen jong zijn. Hoopvol en strijdvaardig. Voortgestuwd, gesteund en gedragen door de soundscape van tientallen stemmen van andere jongeren overal ter wereld, verweven tot een universeel geluidstapijt. \u00a0\u00a0 \n \n Beating Choir \/ Ch\u0153ur Battant  is een productie tussen het Canadese  Th\u00e9\u00e2tre Le Carrousel  en BRONKS. Drie jongeren uit Quebec gingen een artistieke uitwisseling aan met drie Brusselse jongeren. De voorstelling is een vervolg op het online platform  Creative in Solitude  dat choreografe en regisseur Zo\u00eb Demoustier tijdens de pandemie oprichtte en waar jongeren via een artistieke expressie hun gevoelens konden delen.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.bronks.be","email":"info@bronks.be","phone_contact":null,"phone_booking":"+32 2 219 99 21","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.562466"}},"place":{"id":243112,"translations":{"de":{"name":"BRONKS ","address_street_name":"Rue du March\u00e9 aux Porcs","address_street_number":"15-17","address_street_box":null,"email":"info@bronks.be","website":"http:\/\/www.bronks.be","phone_contact":"+32 2 219 99 21","phone_booking":"+32 2 219 99 21","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du March\u00e9 aux Porcs, 15-17","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"BRONKS ","address_street_name":"Rue du March\u00e9 aux Porcs","address_street_number":"15-17","address_street_box":null,"email":"info@bronks.be","website":"http:\/\/www.bronks.be","phone_contact":"+32 2 219 99 21","phone_booking":"+32 2 219 99 21","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du March\u00e9 aux Porcs, 15-17","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"BRONKS ","address_street_name":"Rue du March\u00e9 aux Porcs","address_street_number":"15-17","address_street_box":null,"email":"info@bronks.be","website":"http:\/\/www.bronks.be","phone_contact":"+32 2 219 99 21","phone_booking":"+32 2 219 99 21","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du March\u00e9 aux Porcs, 15-17","address_line2":"1000 Bruxelles","description_web":"BRONKS is Brussels\u2019 Dutch-language theatre for young audiences with own productions and a varied and well-considered choice of guest productions in which both beginners and established artists are asked to deal with relevant and provocative topics in a way that appeals to a young audience. BRONKS productions are appealing and relaxing, but also contrary and demanding. It is theatre that reflects on the world and provides means by which to understand it better. BRONKS has also an extensive educational operation and organises festivals and events to suit a variety of audience groups. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"BRONKS ","address_street_name":"Rue du March\u00e9 aux Porcs","address_street_number":"15-17","