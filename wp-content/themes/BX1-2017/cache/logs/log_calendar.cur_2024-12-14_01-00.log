:false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-11-25T08:22:07+01:00","published_at":"2024-11-25T08:17:59+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":312450,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"concert","ranking":1,"languages":{"spoken":["nl","en","fr","de"],"subtitles":[]},"categories":{"main":{"id":1,"translations":{"de":"Konzert","pt":null,"en":"Concert","it":"Concerti","cn":null,"fr":"Concert","sp":"Concierto","nl":"Concert"}},"others":{"list":[2],"translations":{"de":["Klassisch"],"pt":[null],"en":["Classical"],"it":["Classica"],"cn":[null],"fr":["Classique"],"sp":["Cl\u00e1sica"],"nl":["Klassiek"]}}},"translations":{"de":{"name":"Advenire with the Komorebi Consort","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/komorebi-consort.com\/fr\/advenire-sablon","email":"komorebi.consort@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700003928"},"pt":{"name":"Advenire with the Komorebi Consort","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/komorebi-consort.com\/fr\/advenire-sablon","email":"komorebi.consort@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700003928"},"en":{"name":"Advenire with the Komorebi Consort","shortdescr":"Join the Komorebi Consort for a musical feast at the Church Our Lady of Victories at the Sablon for a program based around the Advent cantatas \u201cMachet die Thore weit\u201d (GWV 1101\/27) by C. Graupner, \u201c\u00c4rgre dich, o Seele nicht\u201d (BWV 186a) and the \u201cFifth Brandenburg Concerto\u201d by J.S. Bach\u2019s  and other surprises!\nReservation and minimum contribution of 12 EUR encouraged.","longdescr":"Join the Komorebi Consort for a musical feast at the Church Our Lady of Victories at the Sablon (Brussels)! From \u201cMachet die Thore weit\u201d (GWV 1101\/27), a gripping cantata by C. Graupner, to J.S. Bach\u2019s \u201cFifth Brandenburg Concerto\u201d and \u201c\u00c4rgre dich, o Seele nicht\u201d (BWV 186a), the ensemble will present a programme that provides an enlivening respite from the frenzies of the festive season. Mulled wine not included, but the Christmas markets are only a short walk away \u2013 book your seats fast!\n\nReservation and minimum contribution of 12 EUR encouraged.","performers":"The Komorebi Consort are an ensemble specialising in early-modern music and instruments.\n\nOur team comprises instrumentalists, singers, and instrument-makers, most of whom were students at both of the Brussels conservatories.","boxoffice_url":null,"website":"https:\/\/komorebi-consort.com\/advenire-sablon","email":"komorebi.consort@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700003928"},"it":{"name":"Advenire with the Komorebi Consort","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/komorebi-consort.com\/fr\/advenire-sablon","email":"komorebi.consort@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700003928"},"cn":{"name":"Advenire with the Komorebi Consort","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/komorebi-consort.com\/fr\/advenire-sablon","email":"komorebi.consort@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700003928"},"fr":{"name":"Advenire avec le Komorebi Consort","shortdescr":"Rejoignez le Komorebi Consort pour une f\u00eate musicale \u00e0 l'\u00e9glise Notre-Dame des Victoires au Sablon \u00e0 Bruxelles. Au programme, les cantates du temps de l'Avent Machet die Thore weit (GWV 1101\/27) de C. Graupner, \u00c4rgre dich, o Seele nicht (BWV 186a) et le cinqui\u00e8me Concerto brandebourgeois de J.S. Bach et d'autres surprises !\nR\u00e9servation conseill\u00e9e, contribution minimum recommand\u00e9e de 12 EUR.","longdescr":"Rejoignez le Komorebi Consort pour une f\u00eate musicale \u00e0 l'\u00e9glise Notre-Dame des Victoires au Sablon, \u00e0 Bruxelles ! De la captivante cantate Machet die Thore weit (GWV 1101\/27) de C. Graupner au Cinqui\u00e8me Concerto brandebourgeois de J.S. Bach et \u00e0 \u00c4rgre dich, o Seele nicht (BWV 186a), l'ensemble propose un programme revigorant, une v\u00e9ritable pause dans la fr\u00e9n\u00e9sie de la fin d\u2019ann\u00e9e. Vin chaud non inclus, mais les march\u00e9s de No\u00ebl sont \u00e0 quelques pas \u2014 r\u00e9servez vite vos places !\n\nR\u00e9servation conseill\u00e9e, contribution minimum recommand\u00e9e de 12 EUR.","performers":"Le Komorebi Consort est un ensemble sp\u00e9cialis\u00e9 dans la musique ancienne et les instruments historiques.\n\nNotre \u00e9quipe se compose d'instrumentistes, de chanteurs et de facteurs d'instruments, dont la plupart ont \u00e9tudi\u00e9 aux conservatoires royaux de Bruxelles.","boxoffice_url":null,"website":"https:\/\/komorebi-consort.com\/fr\/advenire-sablon","email":"komorebi.consort@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700003928"},"sp":{"name":"Advenire with the Komorebi Consort","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/komorebi-consort.com\/fr\/advenire-sablon","email":"komorebi.consort@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700003928"},"nl":{"name":"Advenire met het Komorebi Consort","shortdescr":"Kom samen met Komorebi Consort naar de Onze-Lieve-Vrouw ter Zege op de Zavelkerk (Brussel) voor een muzikaal feest! \"Op het programma staan de adventscantates Machet die Thore weit (GWV 1101\/27) van C. Graupner, \u00c4rgre dich, o Seele nicht (BWV 186a), het Vijfde Brandenburgse Concerto van J.S. Bach en een paar verrassingen.\nReservatie en minimumbijdrage van 12 EUR aanbevolen.","longdescr":"Kom samen met Komorebi Consort naar de Onze-Lieve-Vrouw ter Zege op de Zavelkerk (Brussel) voor een muzikaal feest! Van \"Machet die Thore weit\" (GWV 1101\/27), een aangrijpende cantate van C. Graupner, tot J.S. Bachs \"Vijfde Brandenburgse Concerto\" en \"\u00c4rgre dich, o Seele nicht\" (BWV 186a), zal het ensemble een programma brengen dat een verfrissende ontsnapping biedt aan de drukte van de feestdagen. Gl\u00fchwein niet inbegrepen, maar de kerstmarkten zijn op wandelafstand - reserveer snel uw plaatsen!\n\nReservatie en minimumbijdrage van 12 EUR aanbevolen.","performers":"Het Komorebi Consort is een ensemble dat gespecialiseerd is in oude muziek en historische instrumenten.\nOns team bestaat uit instrumentalisten, zangers, en instrumentenbouwers, waarvan de meesten studeerden aan de beide Brusselse conservatoria.","boxoffice_url":null,"website":"https:\/\/komorebi-consort.com\/nl\/advenire-sablon","email":"komorebi.consort@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700003928"}},"place":{"id":50001095,"translations":{"de":{"name":"Eglise Notre Dame des Victoires au Sablon","address_street_name":"Rue des Sablons","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Sablons","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Eglise Notre Dame des Victoires au Sablon","add