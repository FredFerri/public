l,"publication_state":"public","last_updated_at":"2023-02-18T07:35:24+01:00","published_at":"2023-01-31T14:37:18+01:00","backoffice_id":270684,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":1.2599210498949},{"id":552813,"date_start":"2023-03-11","date_end":"2023-03-11","date_next":"2023-03-11","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen","it":"Visite guidate","sp":"Visitas guiadas","pt":null,"cn":null}},"others":{"list":[258],"translations":{"fr":["Quartiers"],"nl":["Wijken"],"en":["Neighbourhoods"],"de":["Stadtteile"],"it":["Quartieri"],"sp":["Barrios"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Rues Elles de Ganshoren - seconde \u00e9dition","shortdescr":"Rejoignez-nous le 11 mars pour l'inauguration de 8 plaques de rues au nom d'artistes femmes.","longdescr":"Le 11 mars, La Villa et le Service Culture Fran\u00e7aise de Ganshoren inaugurent 8 nouvelles plaques de rues comm\u00e9moratives, au nom de 8 artistes femmes pour lutter contre l\u2019invisibilisation f\u00e9minine et artistique de l\u2019espace public.\r\n\r\nLe 8 mars, c\u2019est la journ\u00e9e internationale de lutte pour les droits des femmes. C\u2019est aussi une belle occasion de se questionner collectivement sur les in\u00e9galit\u00e9s de repr\u00e9sentation entre les hommes et les femmes notamment dans la toponymie des rues bruxelloises. \r\n\r\nCe second parcours de Rues Elles, sera inaugur\u00e9 au cours d\u2019une balade festive accompagn\u00e9e par la fanfare Famba et par la com\u00e9dienne Adeline Vesse, le 11 mars \u00e0 13h au d\u00e9part de la place Reine Paola. Chaque plaque de rue sera pr\u00e9sent\u00e9e par une citoyenne.\r\n\r\nVisite Guid\u00e9e: \r\n\u2594\u2594\u2594\u2594\u2594\u2594\r\nD\u00e9part de la balade le samedi 11 Mars \u00e0 13h Place Reine Paola - 1083 Ganshoren\r\n\r\nBalade en autonomie:\r\n\u2594\u2594\u2594\u2594\u2594\u2594\u2594\u2594\u2594\u2594\r\nPour une promenade en toute autonomie, un plan papier de l\u2019itin\u00e9raire sera disponible \u00e0 partir du 8 mars \u00e0 La Villa et \u00e0 l\u2019administration communale.  Une version num\u00e9rique sera \u00e9galement en ligne sur lavillaculture.be\r\n\r\nEn collaboration avec le Service Culture Fran\u00e7aise de la commune de Ganshoren.","performers":"Adeline Vesse, com\u00e9dienne\r\nFanfare Famba","boxoffice_url":null,"website":"http:\/\/www.lavillaculture.be","email":"emilie@lavillaculture.be","phone_contact":"+32 2 420 37 27","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.552813"},"nl":{"name":"Rues Elles de Ganshoren - seconde \u00e9dition","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lavillaculture.be","email":"emilie@lavillaculture.be","phone_contact":"+32 2 420 37 27","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.552813"},"en":{"name":"Rues Elles de Ganshoren - seconde \u00e9dition","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lavillaculture.be","email":"emilie@lavillaculture.be","phone_contact":"+32 2 420 37 27","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.552813"},"de":{"name":"Rues Elles de Ganshoren - seconde \u00e9dition","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lavillaculture.be","email":"emilie@lavillaculture.be","phone_contact":"+32 2 420 37 27","phone_booking":null,"agenda_url":"https:\