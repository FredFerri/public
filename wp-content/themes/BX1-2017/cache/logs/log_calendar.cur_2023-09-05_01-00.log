nsi que des ateliers et des stages. Ce programme a pour but de contribuer au rayonnement des expressions multiculturelles, artistiques, intellectuelles et litt\u00e9raires.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Centre culturel Espace Magh asbl","address_street_name":"Rue du Poin\u00e7on","address_street_number":null,"address_street_box":null,"email":"info@espacemagh.be","website":"http:\/\/www.espacemagh.be","phone_contact":"+32 2 274 05 10","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Poin\u00e7on","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Centre culturel Espace Magh asbl","address_street_name":"Priemstraat","address_street_number":null,"address_street_box":null,"email":"info@espacemagh.be","website":"http:\/\/www.espacemagh.be","phone_contact":"+32 2 274 05 10","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Priemstraat","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":null,"facebook_id":null,"backoffice_id":9493,"location":{"lat":50.84352692,"lon":4.34863877},"region":"brussels","last_updated_at":"2023-02-15T17:26:53+01:00","published_at":"2013-10-19T01:26:14+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":false,"resto_ranking":0},"organizer":{"id":279041,"translations":{"de":{"name":"FAME Festival","address_street_name":"Rue des Riches Claires","address_street_number":"24","address_street_box":null,"email":"ticket@famefestival.be","website":"http:\/\/www.famefestival.be