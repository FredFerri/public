t":[252,255,256,258,263,265],"translations":{"fr":["Accessible aux personnes ayant des difficult\u00e9s de compr\u00e9hension","Accessible","Am\u00e9nagements pour les personnes aveugles et malvoyantes","Appareils d'amplification du son","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9"],"nl":["Toegankelijk voor mensen met een verstandelijke beperking","Toegankelijk","Voorzieningen voor blinde en slechtziende personen","Geluidsversterkende apparatuur","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet"],"en":["Accessible to people with intellectual disabilities","Accessible","Facilities for blind and partially-sighted persons","Sound-amplifying equipment","Accessible to pedestrians with mobility aids","Adapted toilet"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-08-10T21:05:55+02:00","published_at":"2022-07-13T11:29:49+02:00","backoffice_id":258351,"import_origin":null,"sub_type":"festival","show_in_agenda":true,"ranking":1},{"id":541025,"date_start":"2022-09-24","date_end":"2022-09-24","date_next":"2022-09-24","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":true,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert"}},"others":{"list":[4,6],"translations":{"fr":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"],"nl":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"],"en":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Queimada : Airboxes | Emily and Simon | A Contrabanda","shortdescr":"Bal folk","longdescr":"Rejoignez-nous \u00e0 la Queimada pour danser sur les airs folks de Emily & Simon et d\u2019Airboxes \u00e0 la Maison du Peuple de St-Gilles. Jamais dans\u00e9 le folk ? Aucun souci, la soir\u00e9e commence par une initiation \u00e0 la danse folklorique par \u2018FrisseFolk\u2019 pour mettre tout le monde dans le bain !\r\n\r\nOn ouvre la soir\u00e9e avec Emily et Simon, deux t\u00eates connues du trio Emily & the Simons. Emily Bowden est une violoniste anglaise qui cumule une sacr\u00e9e exp\u00e9rience du bal folk de l\u2019autre c\u00f4t\u00e9 de la Manche. Elle \u00e9crit de belles compositions allant des mazurkas sensuelles aux bourr\u00e9es \u00e9nergiques. A ses c\u00f4t\u00e9s, le guitariste Simon Laffineur, connu entre autres pour A Consommer de Pr\u00e9f\u00e9rence, Waar is Boris ? et Orbal, qui est r\u00e9cemment devenu professeur d\u2019ensemble balk folk \u00e0 l\u2019Acad\u00e9mie Muziekpublique. Tous deux promettent de mettre le feu \u00e0 la maison du peuple. Apr\u00e8s cette entr\u00e9e en mati\u00e8re et accompagn\u00e9 par les airs de cornemuse d\u2019A Contrabanda, un druide pr\u00e9parera la potion appel\u00e9e Queimada qui sera enflamm\u00e9e avant d\u2019\u00eatre distribu\u00e9e pour r\u00e9chauffer la piste de danse.\r\n\r\nAirboxes continuera le bal avec ses deux accord\u00e9ons, l\u2019un diatonique et l\u2019autre chromatique. Airboxes est le projet de Guus Herremans (Les Bottines Artistiques, La Lanterne\u2026) et Bert Leemans (EmBRUN, Elanor\u2026). Ces deux artistes en parfaite harmonie vous embarquent en alternant solos et interactions sonores, se compl\u00e9tant l\u2019un l\u2019autre dans un ensemble festif et dansant. Accompagn\u00e9s de fa\u00e7on exceptionnelle par Ward Dhoore, ils nous jouent leurs propres compositions avec cette association unique et pleine de souffle des accord\u00e9ons chromatique et diatonique compl\u00e9t\u00e9s par la guitare.","performers":"Emily Bowden : violon\r\nSimon Laffineur : guitare\r\n \r\n\r\nGuus Herremans : accord\u00e9on diatonique\r\nBert Leemans : accord\u00e9on chromatique\r\nWard Dhoore: gitaar\/guitare","boxoffice_url":null,"website":"http:\/\/www.muziekpublique.be","email":"info@muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":"+32 2 217 26 00","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.541025"},"nl":{"name":"Queimada : Airboxes | Emily and Simon | A Contrabanda","shortdescr":"Bal folk","longdescr":"Tijdens de Queimada kan je genieten van twee memorabele concerten in het Volkshuis van St-Gillis. Kom mee dansen op de muziek van Emily and Simon en Airboxes. Voor degene die de kneepjes van de folkdans nog willen leren, is er eerst een dansinitiatie door \u2018Frisse Folk\u2019.\r\n\r\nWe openen de avond met Emily and Simon, bekend van het trio Emily & the Simons. Emily Bowden is een Engelse violiste, die gepokt en gemazeld is in het bal folk circuit aan de andere kant van het kanaal. Ze schrijft prachtige composities gaande van sensuele mazurka\u2019s tot energieke bourr\u00e9es. Samen met gitarist Simon Laffineur, bekend van ondermeer A Consomer de Pr\u00e9f\u00e9rence, Waar is Boris ? en Orbal en sinds kort leraar folkbalensemble aan de Muziekpublique-academie, beloven ze het volkshuis in vuur en vlam te zetten. Na dit eerste bal bereidt een dru\u00efde de vriendschapsdrank Queimada op de tonen van doedelzakgroep A Contrabanda. Daarna nemen de unieke diatonische en chromatische accordeonisten van Airboxes het over. Airboxes is sfeervolle dansmuziek gebracht door Guus Herremans (Les Bottines Artistiques, La Lanterne, \u2026) en Bert Leemans (EmBRUN, Elanor, \u2026), twee muzikanten die perfect op elkaar zijn ingespeeld, met extra versterking van Ward Dhoore (gitaar). De klanken van hun instrumenten smelten samen bij alles wat ze spelen en nemen je mee naar een magische wereld. Airboxes speelt enkel eigen werk. Hun afwisselend intieme solo\u2019s en klankkleurijk samenspel zorgen voor een allesomvattend geheel.","performers":"Emily Bowden : viool\r\nSimon Laffineur : gitaar\r\n \r\n\r\nGuus Herremans : diatonische accordeon\r\nBert Leemans : chromatisch accordeon\r\nWard Dhoore: gitaar\/guitare","boxoffice_url":null,"website":"http:\/\/www.muziekpublique.be","email":"info@muziekpublique.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.541025"},"en":{"name":"Queimada : Airboxes | Emily and Simon | A Contrabanda","shortdescr":"Bal folk","longdescr":"Join us at the Queimada to dance on the folk tunes of Emily & Simon and of Airboxes at the Maison du Peuple in Saint-Gilles. For those who still want to learn the basics of folk dancing, there will first be an initiation given by Frisse Folk.\r\n\r\nWe will open the evening with Emily & Simon, known from the trio Emily & the Simons. Emily Bowden is an English violinist, who has accumulated an impressive amount of bal folk experience on the other side of the Channel. She writes beautiful compositions ranging from sensual mazurkas to energetic bourr\u00e9es. Together with guitarist Simon Laffineur, know from, among other things, A Consommer de Pr\u00e9f\u00e9rence, Waar is Boris? and Orbal. Simon has also recently become the teacher of balfolk ensemble at the Muziekpublique-academy. Guaranteed, both will set the Maison du Peuple on fire! After this first bal, a druid will prepare the friendship drink called Queimada, accompanied by the sounds of bagpipes from the band A Contrabanda. Afterwards the unique diatonic and chromatic accordions from Airboxes will take over. Airboxes is the project of Guus Herremans (Les Bottines Artistiques, La Lanterne, \u2026) and Bert Leemans (EmBRUN, Elanor, \u2026), two artists who play in perfect harmony, exceptionally accompanied by Ward Dhoore (guitar). The sounds of their instruments melt together in everything they play and will take you to a magic world. Airboxes only plays their own compositions. Their sometimes-intimate solos, sometimes-explosive playing will ensure for an all-inclusive balfolk.","performers":"Emily Bowden : violin\r\nSimon Laffineur : guitar\r\n \r\n\r\nGuus Herremans : diatonic accordion\r\nBert Leemans : chromatic accordion\r\nWard Dhoore: guitar","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.541025"},"de":{"name":"Queimada : Airboxes | Emily and Simon | A Contrabanda","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.541025"},"it":{"name":"Queimada : Airboxes | Emily and Simon | A Contrabanda","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.541025"},"sp":{"name":"Queimada : Airboxes | Emily and Simon | A Contrabanda","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.541025"},"pt":{"name":"Queimada : Airboxes | Emily and Simon | A Contrabanda","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.541025"},"cn":{"name":"Queimada : Airboxes | Emily and Simon | A Contrabanda","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.541025"}},"place":{"id":247243,"translations":{"fr":{"name":"Maison du Peuple de Saint-Gilles","address_street_name":"Parvis Saint-Gilles","address_street_number":"37 39","address_street_box":null,"email":null,"website":null,"phone_