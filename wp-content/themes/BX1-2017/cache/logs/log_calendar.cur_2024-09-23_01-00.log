+02:00","published_at":"2024-09-19T17:19:56+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":307834,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"other","ranking":0.3968502629920499,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[34,24],"translations":{"de":["Multidisziplin\u00e4r","Kunstgalerien"],"pt":[null,null],"en":["Multidisciplinary","Art Galleries"],"it":["Multidisciplinare","Gallerie d'arte"],"cn":[null,null],"fr":["Pluridisciplinaire","Galeries d'art"],"sp":["Multidisciplinar","Galer\u00edas de arte"],"nl":["Pluridisciplinair","Galeries"]}}},"translations":{"de":{"name":"Expo Congo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.b58.be\/invitations","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700001341"},"pt":{"name":"Expo Congo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.b58.be\/invitations","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700001341"},"en":{"name":"Congo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.b58.be\/invitations","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700001341"},"it":{"name":"Expo Congo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.b58.be\/invitations","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700001341"},"cn":{"name":"Expo Congo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.b58.be\/invitations","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700001341"},"fr":{"name":"Congo","shortdescr":"B58 Art Gallery ouvre ses portes \u00e0 Bruxelles avec l'exposition CONGO!\nUne galerie sp\u00e9cialis\u00e9e en art moderne et contemporain africain \u00e0 Bruxelles !\nSitu\u00e9e en plein c\u0153ur historique des Marolles, la B58 Art Gallery invite les amateurs d\u2019art \u00e0 d\u00e9couvrir la richesse et la diversit\u00e9 de la cr\u00e9ation artistique africaine lors du vernissage le 26 septembre.","longdescr":"L\u2019occasion de rencontrer les artistes, de d\u00e9couvrir les \u0153uvres de \"Aim\u00e9 Mpane, Freddy Tsimba, Bers Grandsinge, Beret, Aubin et Beau Disundi, Somi, Eddy Masumbuku, Nsimambote,  Yero \" et d\u2019\u00e9changer autour de l\u2019art contemporain africain.\nPourquoi venir ?\n\nUne collection unique: Des \u0153uvres d\u2019art africain moderne et contemporain s\u00e9lectionn\u00e9es avec soin. \nUn espace d\u00e9di\u00e9: Un lieu \u00e9l\u00e9gant et convivial pour d\u00e9couvrir et appr\u00e9cier l\u2019art africain.\nUn moment privil\u00e9gi\u00e9: Profitez d'un moment convivial pour discuter avec d'autres passionn\u00e9s d'art africain, de rencontrer les acteurs de la sc\u00e8ne artistique africaine et \u00e9changer avec eux.\nInauguration\u00a0:\n\nDate: Jeudi 26 septembre 2024.\nHeure: De 18h \u00e0 19h.\nLieu: 58 Place du Jeu de Balle.\nRSVP: Sur invitation uniquement. Pour recevoir votre invitation, merci de remplir le formulaire en ligne sur notre site web : https:\/\/www.b58.be\/invitations\nVernissage:\n\nDate: Jeudi 26 septembre 2024\nHeure: De 19h \u00e0 21h\nExposition:\n\nDate: Jeudi 27 septembre 2024 au 12 octobre\nHeure: De 11h \u00e0 17h suivant l'horaire de la galerie\n\nLa galerie propose une v\u00e9ritable immersion dans l'univers d'un collectionneur passionn\u00e9.\nLe programme des mois \u00e0 venir est riche et vari\u00e9 : expositions solo & collectives, conf\u00e9rences, \u00e9v\u00e9nements culturels et performances artistiques tout au long de l'ann\u00e9e.\n\nLa galerie aspire \u00e0 devenir un lieu de rencontre, de r\u00e9flexion et de d\u00e9couverte. Les th\u00e9matiques s'articuleront autour de l'art moderne et contemporain et plus sp\u00e9cifiquement d\u00e9di\u00e9 \u00e0 l'art africain.\n\nNous avons h\u00e2te de vous accueillir pour c\u00e9l\u00e9brer ensemble cette toute nouvelle aventure artistique\n","performers":"Beret (artiste peintre)\nAime Mpane Nsimambote (peinture sculpt\u00e9e)\nFreddy Tsimba (sculptures)\nBers Grandsinge (peintures)\nEddy Masumbuku (peintures)\nAubin Disundi (sculptures)\nBeau Disundi (sculptures)\nYero Art (dessin, string art, technique mixte, multidisciplinaire)\nSomi (peintures)","boxoffice_url":null,"website":"http:\/\/www.b58.be\/invitations","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700001341"},"sp":{"name":"Expo Congo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.b58.be\/invitations","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700001341"},"nl":{"name":"Congo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.b58.be\/invitations","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700001341"}},"place":{"id":50002418,"translations":{"de":{"name":"B58 ART GALLERY","address_street_name":"Place du Jeu de Balle","address_street_number":"58 Place du jeu de balle","address_street_box":"REZ","email":"b58