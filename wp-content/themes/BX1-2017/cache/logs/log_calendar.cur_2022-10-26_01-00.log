abrussels.imgix.net\/ccb8a70b9f8add6c15ddf08d39498ed5f1333e73.jpg","width":4959,"height":7015,"ratio":0.71,"translations":{"fr":{"title":"Halloween Party","copyright":null},"nl":{"title":"Halloween Party","copyright":null},"en":{"title":"Halloween Party","copyright":null}}}],"dates":[{"day":"2022-10-28","doors":"17:00:00","start":"17:00:00","end":null,"is_soldout":false,"is_canceled":false},{"day":"2022-10-28","doors":"17:00:00","start":"17:30:00","end":null,"is_soldout":false,"is_canceled":false},{"day":"2022-10-28","doors":"17:00:00","start":"18:00:00","end":null,"is_soldout":false,"is_canceled":false},{"day":"2022-10-28","doors":"17:00:00","start":"18:30:00","end":null,"is_soldout":false,"is_canceled":false},{"day":"2022-10-28","doors":"17:00:00","start":"19:00:00","end":"20:00:00","is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":0},{"translations":{"fr":{"name":"Article 27"},"nl":{"name":"Artikel 27"},"en":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[],"targets":{"list":[4,5,7,8,11],"translations":{"fr":["Enfants 6-9 ans","Enfants 9-12 ans","Jeunes 12-15 ans","Jeunes 15-18 ans","Famille"],"nl":["Kinderen 6-9 j.","Kinderen 9-12 j.","Jongeren 12-15 j.","Jongeren 15-18 j.","Familie"],"en":["Children 6-9 yr.","Children 9-12 yr.","Youth 12-15  yr.","Youth 15-18  yr.","Family"]}},"tags":["kids"],"accessibilities":{"list":[255,263,265],"translations":{"fr":["Accessible","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9"],"nl":["Toegankelijk","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet"],"en":["Accessible","Accessible to pedestrians with mobility aids","Adapted toilet"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-11T02:06:29+02:00","published_at":"2022-10-03T12:02:17+02:00","backoffice_id":262937,"import_origin":null,"sub_type":"other","show_in_agenda":true,"ranking":1.2599210498949},{"id":541062,"date_start":"2022-10-28","date_end":"2022-10-28","date_next":"2022-10-28","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":true,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert","de":"Konzert"}},"others":{"list":[4,6],"translations":{"fr":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"],"nl":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"],"en":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"],"de":["Pop, Rock, Jazz...","Worldmusic, Folk & Country"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Lia de Itamarac\u00e1 (Br\u00e9sil)","shortdescr":"La reine de la ciranda","longdescr":"Juste au-dessus de Recife, dans le Nord Est du Br\u00e9sil, se trouve la tr\u00e8s jolie \u00eele d\u2019Itamarac\u00e1. Sur cette \u00eele vit Lia de Itamarac\u00e1. Au port d\u2019Itamarac\u00e1 est n\u00e9e une tradition bien pr\u00e9cise : Les femmes des p\u00eacheurs chantaient et jouaient la Ciranda, un style traditionnel de la r\u00e9gion, en attendant que leurs maris rentrent avec leur prise. Mais revenons \u00e0 Lia de Itamarac\u00e1, car \u00e0 78 ans, elle est devenue l\u2019une des plus importantes voix de la ciranda ! Les rythmes de cette musique sont indissociables des influences musicales africaines qui se sont d\u00e9velopp\u00e9es dans le Nord du Br\u00e9sil. Pendant la p\u00e9riode coloniale, l\u2019\u00e9tat de Pernambuco \u00e9tait un centre majeur de la traite des esclaves et s\u2019est ainsi av\u00e9r\u00e9 \u00eatre un creuset culturel avec des influences des colonialistes portugais et hollandais, mais aussi des juifs anglais, des peuples autochtones et bien s\u00fbr des esclaves africains. Cela a cr\u00e9\u00e9 des styles de musique tr\u00e8s sp\u00e9cifiques qui se distinguent du reste du Br\u00e9sil. La ciranda traditionnelle est accompagn\u00e9e de percussions et d\u2019instruments \u00e0 vent. Les voix se font souvent en questions-r\u00e9ponses entre le chanteur principal et les choristes et danseurs. En 1977, Lia de Itamarac\u00e1 sort son premier album et devient la \u2018cirandeira\u2019 la plus importante du Br\u00e9sil. Ses cirandas ont \u00e9t\u00e9 chant\u00e9es par des stars telles que Gilberto Gil et elle a influenc\u00e9 des artistes tels que Chico Science & Na\u00e7\u00e3o Zumbi et Lenine. Lia a \u00e9t\u00e9 nomm\u00e9e patrimoine vivant de l\u2019\u00e9tat de Pernambuco. Pour ce concert, Lia quitte son \u00eele ch\u00e9rie et vient pr\u00e9senter sa culture et ses cirandas au public bruxellois.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.muziekpublique.be","email":"info@muziekpublique.be","phone_contact":null,"phone_booking":"+32 2 217 26 00","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.541062"},"nl":{"name":"Lia de Itamarac\u00e1 (Brazili\u00eb)","shortdescr":"Koningin van de ciranda","longdescr":"Voor de kust van Recife in het Noordoosten van Brazili\u00eb ligt het prachtige eiland Itamarac\u00e1. Op dat eiland woont Lia de Itamarac\u00e1. Op haar 78-jarige leeftijd is ze uitgegroeid tot \u00e9\u00e9n van de belangrijkste stemmen van de ciranda, een muziekstijl waarop men in een cirkel danst. De ritmes van de ciranda zijn onmiskenbaar van Afrikaanse oorsprong en ontwikkelden zich verder in het Noordoosten van Brazili\u00eb. Tijdens de koloniale periode was de staat Pernambuco een groot centrum van de slavenhandel en ontpopte zich zo tot een culturele smeltkroes met invloeden van de Portugese en Nederlandse kolonialisten, maar ook van Engelse Joden, inheemse volkeren en natuurlijk de Afrikaanse slaven. Hierdoor ontstonden zeer specifieke muziekstijlen die zich onderscheiden van de rest van Brazili\u00eb. De traditionele ciranda wordt begeleid door percussie en blazers. De zang is vaak vraag-en-antwoord tussen de lead-zanger en de achtergrondzangers en dansers. De ciranda\u2019s werden gezongen en gedanst terwijl de vrouwen van de vissers op het strand hun mannen opwachtten die terug thuiskwamen met de vangst. In 1977 bracht Lia de Itamarac\u00e1 haar eerste album uit en groeide ze uit tot de belangrijkste \u2018cirandeira\u2019 van Brazili\u00eb. Haar ciranda\u2019s werden al gezongen door sterren zoals Gilberto Gil en ze be\u00efnvloedde artiesten zoals Chico Science & Na\u00e7\u00e3o Zumbi en Lenine. Lia werd benoemd tot levend patrimonium van de staat Pernambuco. Voor dit concert verlaat Lia haar geliefde eiland en komt haar cultuur en haar ciranda\u2019s voorstellen aan een Brussels publiek.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.muziekpublique.be","email":"info@muziekpublique.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.541062"},"en":{"name":"Lia de Itamarac\u00e1 (Brazil)","shortdescr":"The Queen of the ciranda","longdescr":"Lia de Itamarac\u00e1 lives just up north of Recife, in The North-East of Brazil, on the gorgeous island of Itamarac\u00e1.  A particular tradition was born on the Itamarac\u00e1 port: while waiting for their husbands to come home with their catch, the fishermen\u2019s wives played and sang the Ciranda.  At 78, Lia de Itamarac\u00e1 has become one of the most important voices of the Ciranda, the traditional singing of the region.\r\n\r\nThis music is directly influenced by the African rhythms that developed in the North of Brazil.  During the Colonial period, the state of Pernambuco was a major slave trade center.  It became a cultural melting pot, with influences by the Portuguese and Dutch colonists, as well as the English Jews, the indigenous peoples and, of course, the African slaves.  This created specific styles of music, very different from the rest of Brazil.\r\n\r\nThe traditional Ciranda is accompanied by percussions and wind instruments.  The voices present themselves often in the question and answer format, between the lead singer and the chorus, the dancers.\r\n\r\nWhen Lia de Itamarac\u00e1\u2019s first album came out in 1977, she became Brazil\u2019s most important \u201ccirandeira\u201d.  Stars, such as Gilberto Gil, have sung her Cirandas.  She has influenced artists of the like of Chico Science & Na\u00e7\u00e3o Zumbi, Lenine \u2013 among others.  Lia has been named a Living Heritage of the state of Pernambuco.  For this concert, Lia leaves her dear island, in order to present her culture, her Cirandas to the Brussels public.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.541062"},"de":{"name":"Lia de Itamarac\u00e1 (Br\u00e9sil)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.541062"},"it":{"name":"Lia de Itamarac\u00e1 (Br\u00e9sil)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.541062"},"sp":{"name":"Lia de Itamarac\u00e1 (Br\u00e9sil)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.541062"},"pt":{"name":"Lia de Itamarac\u00e1 (Br\u00e9sil)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.541062"},"cn":{"name":"Lia de Itamarac\u00e1 (Br\u00e9sil)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.541062"}},"place":{"id":238099,"translations":{"fr":{"name":"Muziekpublique","address_street_name":"Galerie de la Porte de Namur","address_street_number":"3","address_street_box":null,"email":"info@muziekpublique.be","website":"http:\/\/www.muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":"+32 2 217 26 00","address_zip":"1050","address_city":"Ixelles","address_line1":"Galerie de la Porte de Namur, 3","address_line2":"1050 Ixelles","description_web":"Muziekpublique est le centre des musiques traditionnelles du monde de Bruxelles. Etablie dans le Th\u00e9\u00e2tre Moli\u00e8re au c\u0153ur du quartier africain, l\u2019asbl organise plus de 100 concerts par an et deux festivals (Hide & Seek Festival etc.). Par ailleurs Muziekpublique propose aussi 50 cours de musique et de danse du monde, comptant plus de 600 \u00e9l\u00e8ves. Ensuite, l\u2019asbl d\u00e9veloppe certains artistes et projets via son label, qui est aussi une agence de booking et de management. La musique traditionnelle a donc trouv\u00e9 un endroit id\u00e9al o\u00f9 se d\u00e9velopper et les artistes y constituent un r\u00e9seau vivant et dynamique cr\u00e9ant des liens de qualit\u00e9 avec le public. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Muziekpublique","address_street_name":"Galerij van de Naamsepoort","address_street_number":"3","address_street_box":null,"email":"info@muziekpublique.be","website":"http:\/\/www.muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":"+32 2 217 26 00","address_zip":"1050","address_city":"Elsene","address_line1":"Galerij van de Naamsepoort, 3","address_line2":"1050 Elsene","description_web":"Muziekpublique v