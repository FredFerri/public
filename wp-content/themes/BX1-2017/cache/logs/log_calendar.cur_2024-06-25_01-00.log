:"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50010884"},"fr":{"name":"Club des Japonautes","shortdescr":"Rencontre mensuelle entre passionn\u00e9s du Japon et de sa culture","longdescr":"Japonautes gourmets, \u00e0 table !\n\nVenez r\u00e9galer vos yeux et vos papilles avec l'art culinaire nippon qui est loin de se r\u00e9sumer aux sushi, sashimi et ramen !\n\nVendredi 28.06.2024 de 19h \u00e0 22h\n\nLa cuisine de Mariko-san deviendra peut-\u00eatre votre madeleine de Proust !\n\nPour vous surprendre, vous recevrez le lieu du rendez-vous et les informations compl\u00e9mentaires dans l\u2019e-mail de confirmation de votre inscription (tarif menu entre 45 \u20ac-60 \u20ac).\n\nPromis, ce sera une belle d\u00e9couverte !\n\nJ\u2019ai h\u00e2te de vous accueillir et de partager cette passion commune pour la cuisine japonaise.\n\nInscription obligatoire via QR code ou via Japontheway.com onglet Club des Japonautes\n\nPlaces limit\u00e9es","performers":"Adina Mazzoni-Cernus\nJapontheway.com","boxoffice_url":null,"website":"https:\/\/japontheway.com","email":"japontheway@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50010884"},"sp":{"name":"Club des Japonautes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/japontheway.com","email":"japontheway@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50010884"},"nl":{"name":"Club des Japonautes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/japontheway.com","email":"japontheway@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50010884"}},"place":{"id":50001750,"translations":{"de":{"name":"Japontheway.com","address_street_name":null,"address_street_number":null,"address_street_box":