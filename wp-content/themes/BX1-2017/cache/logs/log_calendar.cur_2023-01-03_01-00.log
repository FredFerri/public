:{"name":"Jeunes"},"sp":{"name":"Jeunes"},"pt":{"name":"Jeunes"},"cn":{"name":"Jeunes"}},"value":6},{"translations":{"fr":{"name":"Article 27"},"nl":{"name":"Artikel 27"},"en":{"name":"Article 27"},"de":{"name":"Article 27"},"it":{"name":"Article 27"},"sp":{"name":"Article 27"},"pt":{"name":"Article 27"},"cn":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-11-23T15:55:36+01:00","published_at":"2022-09-16T15:50:02+02:00","backoffice_id":262092,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":1.2599210498949},{"id":547631,"date_start":"2023-01-14","date_end":"2023-01-14","date_next":"2023-01-14","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":true,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert","de":"Konzert","it":null,"sp":null,"pt":null,"cn":null}},"others":{"list":[4,6],"translations":{"fr":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"],"nl":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"],"en":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"],"de":["Pop, Rock, Jazz...","Worldmusic, Folk & Country"],"it":[null,null],"sp":[null,null],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Hamid El Kasri & Gnawa Black Koyo (Morocco)","shortdescr":"Parade et soir\u00e9e gnawa - 10 ans Black Koyo","longdescr":"Le groupe gnawa bruxellois Black Koyo c\u00e9l\u00e8bre ses dix ans d\u2019existence ! A cette occasion, ils invitent le c\u00e9l\u00e8bre m\u2019allem Hamid el Kasri de Rabat \u00e0 les rejoindre pour un concert d\u2019anthologie.\r\n\r\nN\u00e9 \u00e0 Ksar el Kebir, Hamid el Kasri apprend la musique gnawa d\u00e8s son plus jeune \u00e2ge, guid\u00e9 par sa passion, son talent et les ma\u00eetres Alouane et Abdelwahid Stitou. Dot\u00e9 d\u2019une voix intense et profonde, Hamid s\u2019illustre \u00e9galement dans les projets fusions qui participeront \u00e0 sa renomm\u00e9e, notamment avec le pianiste australien Joe Zawinul ou le batteur marocain Karim Ziad.\r\n\r\nBlack Koyo est un groupe n\u00e9 \u00e0 Bruxelles il y a dix ans. Le groupe a \u00e9t\u00e9 constitu\u00e9 par Hicham Bilali, n\u00e9 \u00e0 F\u00e8s, ayant appris aupr\u00e8s du ma\u00eetre Hamid Dkaki. Constitu\u00e9 de musiciens, choristes et danseurs venant de Tanger, F\u00e8s et Casablanca install\u00e9s \u00e0 Bruxelles, Black Koyo fait la part belle \u00e0 la tradition du Nord du Maroc et \u00e0 son r\u00e9pertoire de tambours.\r\n\r\nLe concert sera l\u2019occasion d\u2019une rencontre entre Hamid el Kasri, Black Koyo et des invit\u00e9s surprise qui fusionneront avec cet ensemble in\u00e9dit.\r\n\r\nEn pr\u00e9lude au concert, une parade remontera la chauss\u00e9e de Wavre et emm\u00e8nera le public jusqu\u2019au Th\u00e9\u00e2tre Moli\u00e8re, dont les murs seront par\u00e9s d\u2019une exposition de photos prises par Dieter Telemans avec les Gnawa Black Koyo. Pour participer \u00e0 la parade, rendez-vous \u00e0 19H devant Kuumba (78 Chauss\u00e9e de Wavre)","performers":"- Hamid El Kasri (chant, guembri)\r\n- Hicham Bilali (chant, guembri)\r\n- Jalal Abantor, Marwan Abantor & Achraf Abantor (chant, tbal, qraqib)\r\n- Driss Filali, Mounim Lagnina, Ayoub Boufous, Abderrahmane Benjaafar, Amine Aabbou, Abdennour Dahou, Hanane Abdallah, Aziz Moustaid, Badr el Hernat, Souhaib Nekkashi (chant, qraqib)","boxoffice_url":null,"website":"http:\/\/www.muziekpublique.be","email":"info@muziekpublique.be","phone_contact":null,"phone_booking":"+32 2 217 26 00","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.547631"},"nl":{"name":"Hamid El Kasri & Gnawa Black Koyo (Morocco)","shortdescr":"Parade & 10 jaar Black Koyo","longdescr":"De Brusselse gnawa-groep Black Koyo viert zijn tiende verjaardag! Om dit te vieren, nodigen ze de beroemde m\u2019allem Hamid el Kasri uit Rabat uit voor een anthologieconcert.\r\n\r\nGeboren in Ksar el Kebir, leerde Hamid el Kasri al op jonge leeftijd Gnawa-muziek, geleid door zijn passie, zijn talent en de meesters Alouane en Abdelwahid Stitou. Begiftigd met een intense en diepe stem schittert Hamid ook in fusionprojecten die bijdragen aan zijn roem, in het bijzonder met de Australische pianist Joe Zawinul of de Marokkaanse drummer Karim Ziad.\r\n\r\nBlack Koyo is een groep die tien jaar geleden in Brussel het leven zag. De groep werd gevormd door Hicham Bilali, geboren in Fez, gevormd werd door meester Hamid Dkaki. Samengesteld uit muzikanten, zangers en dansers uit Tanger, Fez en Casablanca die in Brussel wonen, geeft Black Koyo een prominente plaats aan de traditie van Noord-Marokko en zijn trommelrepertoire.\r\n\r\nHet concert staat in het teken van een ontmoeting tussen Hamid el Kasri, Black Koyo en verrassingsgasten die zullen samenwerken met dit unieke ensemble.\r\n\r\nAls prelude op het concert trekt een parade de Waversesteenweg op en neemt het publiek mee naar het theater van Moli\u00e8re, waarvan de muren zullen worden opgesierd met een foto\u2019s die door Dieter Telemans genomen zijn van de Brusselse gnawa-gemeenschap, waaronder Gnawa Black Koyo. Om deel te nemen aan de parade, wij ontmoeten tegenover Kuumba om 19u (78 waversesteenweg) !","performers":"- Hamid El Kasri (chant, guembri)\r\n- Hicham Bilali (chant, guembri)\r\n- Jalal Abantor, Marwan Abantor & Achraf Abantor (chant, tbal, qraqib)\r\n- Driss Filali, Mounim Lagnina, Ayoub Boufous, Abderrahmane Benjaafar, Amine Aabbou, Abdennour Dahou, Hanane Abdallah, Aziz Moustaid, Badr el Hernat, Souhaib Nekkashi (chant, qraqib)","boxoffice_url":null,"website":"http:\/\/www.muziekpublique.be","email":"info@muziekpublique.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.547631"},"en":{"name":"Hamid El Kasri & Gnawa Black Koyo (Morocco)","shortdescr":"Parade & 10 years of Black Koyo","longdescr":"The Brussels gnawa group Black Koyo is celebrating 10 years of existence! To mark this occasion, they have invited the celebrated m\u2019allem Hamid el Kasri from Rabat to join them for an anthology concert.\r\n\r\nBorn in Ksar el Kebir, Hamid el Kasri started learning gnawa music from his earliest years, guided by his passion, his talent and the master-musicians Alouane and Abdelwahid Stitou. Endowed with an intense deep voice, Hamid also excels in fusion projects that have added to his renown, among others with the Australian pianist Joe Zawinul or the Moroccan drummer Karim Ziad.\r\n\r\nBlack Koyo is a group founded in Brussels ten years ago. The group was put together by Hicham Bilali, born in Fes, who studied with the master Hamid Dkaki. Made up of musicians, singers and dancers from Tangier, Fes and Casablanca who are based in Brussels, Black Koyo gives pride of place to the traditions of northern Morocco and its drumming repertoire.\r\n\r\nThis concert provides the opportunity for a meeting of Hamid el Kasri, Black Koyo and surprise guests who will blend together in this unprecedented gathering.\r\n\r\nAs a prelude to the concert, a parade will pass along the chauss\u00e9e de Wavre, bringing the public to the Th\u00e9\u00e2tre Moli\u00e8re, the walls of which will be decorated by an exhibition of photos taken by Dieter Telemans of Gnawa Black Koyo. If you want to join the parade, we will meet outside Kuumba (78 Chauss\u00e9e de Wavre)","performers":"- Hamid El Kasri (chant, guembri)\r\n- Hicham Bilali (chant, guembri)\r\n- Jalal Abantor, Marwan Abantor & Achraf Abantor (chant, tbal, qraqib)\r\n- Driss Filali, Mounim Lagnina, Ayoub Boufous, Abderrahmane Benjaafar, Amine Aabbou, Abdennour Dahou, Hanane Abdallah, Aziz Moustaid, Badr el Hernat, Souhaib Nekkashi (chant, qraqib)","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.547631"},"de":{"name":"Hamid El Kasri & Gnawa Black Koyo (Morocco)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.547631"},"it":{"name":"Hamid El Kasri & Gnawa Black Koyo (Morocco)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.547631"},"sp":{"name":"Hamid El Kasri & Gnawa Black Koyo (Morocco)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.547631"},"pt":{"name":"Hamid El Kasri & Gnawa Black Koyo (Morocco)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.547631"},"cn":{"name":"Hamid El Kasri & Gnawa Black Koyo (Morocco)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.547631"}},"place":{"id":238099,"translations":{"fr":{"name":"Muziekpublique","address_street_name":"Galerie de la Porte de Namur","address_street_number":"3","address_street_box":null,"email":"info@muziekpublique.be","website":"http:\/\/www.muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":"+32 2 217 26 00","address_zip":"1050","address_city":"Ixelles","address_line1":"Galerie de la Porte de Namur, 3","address_line2":"1050 Ixelles","description_web":"Muziekpublique est le centre des musiques traditionnelles du monde de Bruxelles. Etablie dans le Th\u00e9\u00e2tre Moli\u00e8re au c\u0153ur du quartier africain, l\u2019asbl organise plus de 100 concerts par an et deux festivals (Hide & Seek Festival etc.). Par ailleurs Muziekpublique propose aussi 50 cours de musique et de danse du monde, comptant plus de 600 \u00e9l\u00e8ves. Ensuite, l\u2019asbl d\u00e9veloppe certains artistes et projets via son label, qui est aussi une agence de booking et de management. La musique traditionnelle a donc trouv\u00e9 un endroit id\u00e9al o\u00f9 se d\u00e9velopper et les artistes y constituent un r\u00e9seau vivant et dynamique cr\u00e9ant des liens de qualit\u00e9 avec le public. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Muziekpublique","address_street_name":"Galerij van de Naamsepoort","address_street_number":"3","address_street_box":null,"email":"info@muziekpublique.be","website":"http:\/\/www.muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":"+32 2 217 26 00","address_zip":"1050","address_city":"Elsene","address_line1":"Galerij van de Naamsepoort, 3","address_line2":"1050 Elsene","description_web":"Muziekpublique verspreidt en promoot muziek- en danstradities via een ambitieus programma van concerten, cursussen en projecten. Een jaarrond concertprogramma met Belgische en internationale artiesten vormt de kern van de activiteiten van de organisatie. Van contemplatieve tot feestelijke concerten vinden het hele jaar door plaats in het prachtige Moli\u00e8re Theater, aan de Naamsepoort, maar ook op verschillende plaatsen de hoofdstad.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Muziekpublique","address_street_name":"Galerie de la Porte de Namur","address_street_number":"3","address_street_box":null,"email":"info@muziekpublique.be","website":"http:\/\/www.muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":"+32 2 217 26 00","address_zip":"1050","address_city":"Ixelles","address_line1":"Galerie de la Porte de Namur, 3","address_line2":"1050 Ixelles","description_web":"Muziekpublique, keeps music and dance traditions alive and kicking in Brussels through an ambitious programme of concerts, courses, and projects. A year-round concert programme, featuring Belgian and international artists, forms the core of the foundation\u2019s activities. From the contemplative to the madly festive concerts take place indoors,  in the small Moli\u00e8re Theatre, in the arcade at the Porte de Namur and outdoors, around the city and throughout the year.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Muziekpublique","address_street_name":"Galerie de la Porte de Namur","address_street_number":"3","address_street_box":null,"email":"info@muziekpublique.be","website":"http:\/\/www.muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":"+32 2 217 26 00","address_zip":"1050","address_city":"Ixelles","address_line1":"Galerie de la Porte de Namur, 3","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Muziekpublique","address_street_name":"Galerie de la Porte de Namur","address_street_number":"3","address_street_box":null,"email":"info@muziekpublique.be","website":"http:\/\/www.muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":"+32 2 217 26 00","address_zip":"1050","address_city":"Ixelles","address_line1":"Galerie de la Porte de Namur, 3","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Muziekpublique","address_street_name":"Galeri