met een verstandelijke beperking","Toegankelijk","Voorzieningen voor blinde en slechtziende personen","Voorzieningen voor dove en slechthorende personen","Assistentiehonden","Toegankelijke parking","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet"],"en":["Accessible to people with intellectual disabilities","Accessible","Facilities for blind and partially-sighted persons","Facilities for deaf and hearing-impaired people","Assistance dogs","Accessible parking","Accessible to pedestrians with mobility aids","Adapted toilet"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-07-21T01:35:45+02:00","published_at":"2021-10-13T15:51:59+02:00","backoffice_id":240976,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.23739028089647},{"id":528152,"date_start":"2022-03-23","date_end":"2022-08-21","date_next":"2022-07-21","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[36,46],"translations":{"fr":["Mus\u00e9es et art centers","Pluridisciplinaire"],"nl":["Musea en kunstcentra","Multidisciplinair"],"en":["Museums and art centers","Multidisciplinary"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Haute Tension","shortdescr":"Toute tentative de r\u00e9sistance sera inutile : la force d\u2019attraction produite par les \u0153uvres de HAUTE TENSION vous conduira directement au c\u0153ur du geste.","longdescr":"Toute tentative de r\u00e9sistance sera inutile : la force d\u2019attraction produite par les \u0153uvres de HAUTE TENSION vous conduira directement au c\u0153ur du geste.\r\nAux intersections des lignes et fils tendus, ne vous fiez pas \u00e0 la fragilit\u00e9 des mat\u00e9riaux mis en \u0153uvre mais attendez-vous \u00e0 d\u2019intenses d\u00e9charges propres \u00e0 augmenter vos pulsions printani\u00e8res.\r\n\r\nEn collaboration avec visit.brussels","performers":"Franco Bellucci, Heide De Bruyne, Eric Derochette, Cecile Franceus et Pol Jean.","boxoffice_url":null,"website":"http:\/\/www.artetmarges.be","email":"info@artetmarges.be","phone_contact":"+32 2 533 94 90","phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/528152.html"},"nl":{"name":"Hoogspanning","shortdescr":"Elke poging tot verzet zal nutteloos zijn: de aantrekkingskracht die uitgaat van de werken onder HOOGSPANNING neemt je meteen mee naar de kern van het gebaar.","longdescr":"Elke poging tot verzet zal nutteloos zijn: de aantrekkingskracht die uitgaat van de werken onder HOOGSPANNING neemt je meteen mee naar de kern van het gebaar.\r\nOp het kruispunt van lijnen en draden kan de broosheid van de gebruikte materialen je op het verkeerde been zetten; verwacht je aan een intense ontlading die je voorjaarsdrang enkel zal versterken.\r\n\r\nin samenwerking met visit.brussels","performers":"Franco Bellucci, Heide De Bruyne, Eric Derochette, Cecile Franceus en Pol Jean.","boxoffice_url":null,"website":"http:\/\/www.artetmarges.be","email":"info@artetmarges.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/528152.html"},"en":{"name":"High Voltage","shortdescr":"Any attempt to resist will be useless: the force of attraction produced by the works of HIGH VOLTAGE will lead you directly to the heart of the gesture.","longdescr":"Any attempt to resist will be useless: the force of attraction produced by the works of HIGH VOLTAGE will lead you directly to the heart of the gesture.\r\nAt the intersections of the lines and wires, don't trust the fragility of the materials used, but expect intense discharges that will increase your springtime impulses.\r\n\r\nIn collaboration with visit.brussels","performers":"Franco Bellucci, Heide De Bruyne, Eric Derochette, Cecile Franceus and Pol Jean.","boxoffice_url":null,"website":"http:\/\/www.artetmarges.be","email":"info@artetmarges.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/528152.html"},"de":{"name":"Haute Tension","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/528152.html"},"it":{"name":"Haute Tension","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/528152.html"},"sp":{"name":"Haute Tension","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/528152.html"},"pt":{"name":"Haute Tension","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/528152.html"},"cn":{"name":"Haute Tension","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/528152.html"}},"place":{"id":738,"translations":{"fr":{"name":"Art et marges mus\u00e9e","address_street_name":"Rue Haute","address_street_number":"314","address_street_box":null,"email":"info@artetmarges.be","website":"http:\/\/www.artetmarges.be","phone_contact":"+32 2 533 94 90","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Haute, 314","address_line2":"1000 Bruxelles","description_web":"Situ\u00e9 au c\u0153ur de Bruxelles, le Art et marges mus\u00e9e, mus\u00e9e d\u2019art brut - contemporain - outsider art, questionne l\u2019art et ses fronti\u00e8res. Sa collection s\u2019est constitu\u00e9e d\u00e8s le milieu des ann\u00e9es 80 aupr\u00e8s d\u2019artistes autodidactes, d\u2019ateliers artistiques pour personnes porteuses d\u2019un handicap mental ou d\u2019ateliers en milieu psychiatrique. Elle se compose aujourd\u2019hui de plus de 4000 \u0153uvres internationales produites en dehors des sentiers fr\u00e9quent\u00e9s de l\u2019art. Ses expositions temporaires, au rythme de deux \u00e0 trois par an, m\u00ealent artistes de part et d\u2019autre de la marge et questionnent l\u2019art et sa d\u00e9finition-m\u00eame. ","description_print":"Mus\u00e9e d'art outsider","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Art & marges museum","address_street_name":"Hoogstraat","address_street_number":"314","address_street_box":null,"email":"info@artetmarges.be","website":"http:\/\/www.artetmarges.be","phone_contact":"+32 2 533 94 90","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Hoogstraat, 314","address_line2":"1000 Brussel","description_web":"Outsiderkunst museum. Sinds zijn oprichting in 1984 en de eerste tentoonstelling in 1986, verdedigt de vzw Art en Marge - het huidige art )&( marges museum - kunstenaars die uit de boot van het offici\u00eble culturele circuit vallen. Die autodidactische kunstenaars worden \u201coutsiders\u201d genoemd en werken alleen of in creatieve workshops voor zieke of gehandicapte personen. Naast de permanente verzameling, zorgen tijdelijke tentoonstellingen voor een dynamische dialoog met de werken van professionele kunstenaars die actief zijn in het offici\u00eble culturele milieu, om de grenzen van de in- en outsiderkunst af te tasten. art )&( marges museum is geen ghettomuseum maar een plaats van uitwisseling, een ruimte waarin de individualiteit hoogtij viert en waarin alles in het werk gesteld wordt om ervoor te zorgen dat alle doelgroepen zich thuis voelen.\r\n\r\nOpen op vrijdag, zaterdag en zondag tussen 11.00 en 17.30 uur, alleen op afspraak.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Art & marges museum","address_street_name":"Rue Haute","address_street_number":"314","address_street_box":null,"email":"info@artetmarges.be","website":"http:\/\/www.artetmarges.be","phone_contact":"+32 2 533 94 90","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue Haute, 314","address_line2":"1000 Brussels","description_web":"Museum of outsider art. Since its founding in 1984 and the first exhibition of 1986, Art & Marge \u2013 now the \u2018art )&( marges [margins] museum\u2019 \u2013 promotes artists outside the mainstream. These self-taught artists, often called \u201coutsider artists\u201d, work either individually or in creative workshops in institutions for people who are mentally unwell or who are mentally challenged. In addition to the permanent collection,  temporary exhibitions will establish a dynamic dialogue with paintings by professional artists from the mainstream who are active in their cultural surroundings \u2013 the boundary between \u2018insider\u2019 and \u2018outsider\u2019 art?   The \u2018Art & Marges\u2019 museum is not a ghetto museum but a venue for exchange, where individuality is of prime importance and where all efforts are made to make all target groups feel at home.\r\n\r\nOpen Fridays, Saturdays and Sundays between 11.00 am and 5.30 pm by appointment only.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Mus\u00e9e Art et marges","address_street_name":"Rue Haute","address_street_number":"314","address_street_box":null,"email":"info@artetmarges.be","website":"http:\/\/www.artetmarges.be","phone_contact":"+32 2 533 94 90","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Haute, 314","address_line2":"1000 Bruxelles","description_web":"Art brut - Outsider Art - Zeitgen\u00f6ssische Kunst\r\n\r\nDas Museum Art et Marges zeigt eine Sammlung, die seit den 1980er-Jahren kontinuierlich w\u00e4chst. Dabei handelt es sich um Kunst abseits des Mainstreams, die einen Blick auf die autodidaktischen K\u00fcnslter wirft, Kunstateliers f\u00fcr Menschen mit geistiger Behinderung oder in Psychiatrien. \r\nIn den Ausstellungen mischen sich K\u00fcnstler diesseits und jenseits der Grenze des \"Au\u00dfenseitertums\" (engl. Begriff \"Art Outsider\"), die die Kunst und deren Beschr\u00e4nkungen hinterfragt.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Mus\u00e9e Art et marges","address_street_name":"Rue Haute","address_street_number":"314","address_street_box":null,"email":"info@artetmarges.be","website":"http:\/\/www.artetmarges.be","phone_contact":"+32 2 533 94 90","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Haute, 314","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Museo Art)&(Marges","address_street_name":"Rue Haute","address_street_number":"314","address_street_box":null,"email":"info@artetmarges.be","website":"http:\/\/www.artetmarges.be","phone_contact":"+32 2 533 94 90","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Haute, 314","address_line2":"1000 Bruxelles","description_web":"Desde su creaci\u00f3n, el Centro de Investigaci\u00f3n y Difusi\u00f3n del arte outsider Art en Marge (que se convirti\u00f3 posteriormente en el museo Art)&Marges) aboga por los artistas que no forman parte del circuito cultural oficial. Los conocidos actualmente como \u00aboutsiders\u00bb (ver glosario) son creadores autodidactas que trabajan solos o en talleres creativos para personas psicol\u00f3gicamente vulnerables o con alguna discapacidad mental. Algunos son internos de residencias para discapacitados mentales, hospitales psiqui\u00e1tricos, y otros son trabajadores o extrabajadores de una amplia gama de profesiones: fot\u00f3grafos, anticuarios, zapateros, m\u00fasicos...","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Art et marges mus\u00e9e","address_street_name":"Rue Haute","address_street_number":"314","address_street_box":null,"email":"info@artetmarges.be","website":"http:\/\/www.artetmarges.be","phone_contact":"+32 2 533 94 90","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Haute, 314","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Art et marges mus\u00e9e","address_street_name":"Rue Haute","address_street_number":"314","address_street_box":null,"email":"info@artetmarges.be","website":"http:\/\/www.artetmarges.be","phone_contact":"+32 2 533 94 90","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Haute, 314","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[2],"translations":{"fr":["Marolles"],"nl":["Marollen"],"en":["Marolles"]}},"zones":{"list":[19,21],"translations":{"fr":["Centre","Sud"],"nl":["Centrum","Zuid"],"en":["Centre","South"]}},"neca":null,"facebook_id":null,"backoffice_id":149,"location":{"lat":50.83472811,"lon":4.3463823},"region":"brussels","last_updated_at":"2022-07-21T01:35:32+02:00","published_at":"2013-10-19T01:13:19+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":738,"translations":{"fr":{"name":"Art et marges mus\u00e9e","address_street_name":"Rue Haute","address_street_number":"314","address_street_box"