isch erfgoed en hedendaagse kunst en laten de stad zien door middel van rondleidingen en lezingen in verschillende talen.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":36946,"location":{"lat":50.84145283,"lon":4.35976257},"last_updated_at":"2023-06-08T12:25:28+02:00","published_at":"2021-07-23T14:48:31+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/5ee3da22b80af5b51c42a34e2ae05a162471df07.jpg","width":5312,"height":2988,"ratio":1.78,"oEmbed_height":2988,"oEmbed_width":5312,"translations":{"de":{"title":"PARK TOUR : Visites gratuites du Parc Georges Henri","copyright":null},"pt":{"title":"PARK TOUR : Visites gratuites du Parc Georges Henri","copyright":null},"en":{"title":"PARK TOUR : Visites gratuites du Parc Georges Henri","copyright":null},"it":{"title":"PARK TOUR : Visites gratuites du Parc Georges Henri","copyright":null},"cn":{"title":"PARK TOUR : Visites gratuites du Parc Georges Henri","copyright":null},"fr":{"title":"PARK TOUR : Visites gratuites du Parc Georges Henri","copyright":null},"sp":{"title":"PARK TOUR : Visites gratuites du Parc Georges Henri","copyright":null},"nl":{"title":"PARK TOUR : Visites gratuites du Parc Georges Henri","copyright":null}}}],"dates":[{"day":"2024-05-12","doors":null,"start":"11:00:00","end":"12:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-05-26","doors":null,"start":"15:00:00","end":"16:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-06-23","doors":null,"start":"11:00:00","end":"12:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-08-04","doors":null,"start":"11:00:00","end":"12:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-08-