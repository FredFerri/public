 sollicite votre aide afin de retrouver son ami disparu\u2026 et les indices de votre qu\u00eate seront \u00e0 trouver dans la d\u00e9gustation des bi\u00e8res qui jalonneront votre parcours. Livret en main, vous arpentez les rues historiques du centre de Bruxelles. Une mani\u00e8re insolite, ludique, et gourmande de (re)d\u00e9couvrir la capitale Belge, ses monuments incontournables, ses fresques urbaines, le tout au gr\u00e9 des bi\u00e8res.","performers":"Un animateur est pr\u00e9sent pour vous expliquer le jeu et r\u00e9compenser les gagnants du jour!","boxoffice_url":null,"website":"https:\/\/beermyguest.be\/shop\/jeu-de-piste\/","email":"magali@beermyguest.be","phone_contact":"+32 476 78 56 25","phone_booking":"+32 476 78 56 25","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.511490"},"nl":{"name":"Jeu de Piste avec d\u00e9gustation bi\u00e8re!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.511490"},"en":{"name":"Jeu de Piste avec d\u00e9gustation bi\u00e8re!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.511490"},"de":{"name":"Jeu de Piste avec d\u00e9gustation bi\u00e8re!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.511490"},"it":{"name":"Jeu de Piste avec d\u00e9gustation bi\u00e8re!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.511490"},"sp":{"name