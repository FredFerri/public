"d340e1f7-976f-4d1e-ad89-15ffdd7622f8"},{"id":5700004193,"date_start":"2024-12-13","date_end":"2024-12-17","date_next":"2024-12-13","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-12-03T16:07:08+01:00","published_at":"2024-12-03T14:44:11+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":313010,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"other","ranking":0.7368062997280773,"languages":{"spoken":["fr","en","nl"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[26,24],"translations":{"de":["Skulptur","Kunstgalerien"],"pt":[null,null],"en":["Sculpture","Art Galleries"],"it":["Scultura","Gallerie d'arte"],"cn":[null,null],"fr":["Sculpture","Galeries d'art"],"sp":["Escultura","Galer\u00edas de arte"],"nl":["Beeldhouwkunst","Galeries"]}}},"translations":{"de":{"name":"Bonhams First African And Oceanic Art Auction In Brussels Including Selections From The Anne And Jacques Kerchache Collection","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.bonhams.com\/auction\/30573\/arts-of-africa-the-pacific-and-the-americas\/?page=2","email":"emilie.jolly@bonhams.com","phone_contact":"+","phone_booking":"+32 2 880 73 80","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700004193"},"pt":{"name":"Bonhams First African And Oceanic Art Auction In Brussels Including Selections From The Anne And Jacques Kerchache Collection","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.bonhams.com\/auction\/30573\/arts-of-africa-the-pacific-and-the-americas\/?page=2","email":"emilie.jolly@bonhams.com","phone_contact":"+","phone_booking":"+32 2 880 73 80","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700004193"},"en":{"name":"Bonhams African And Oceanic Art Auction","shortdescr":"We are really thrilled to organize this first auction of African and Oceanic Art in Brussels. In addition to masterpieces such the lizardman figure from the Paul Eluard and Andr\u00e9 Breton collection, we are delighted to present a selection of objects from the prestigious collection of Jacques Kerchache (1942-2001), some of them never seen on the market and most of them offered without reserve.\u201d","longdescr":"Born in Rouen in 1942, Jacques Kerchache opened his first art gallery in Paris aged 18 and visited West Africa for the first time at 21. He soon began displaying traditional West African art alongside artworks by European artists. Jacques Kerchache was also an artistic advisor and curator of exhibitions. He was an advocate of the Primitive Arts, promoting their entry into important French museum collections. It was under his initiative that the Pavillon des Sessions was created at the Louvre in 2001, as well as the mus\u00e9e du quai Branly in 2006. Jacques Kerchache also collaborated with the Fondation Cartier on many occasions, first on the thematic exhibitions \u00c0 visage d\u00e9couvert (1992) and \u00eatre nature (1998) as well as on the solo show of the Haitian artist Patrick Vilaire in R\u00e9flexion sur la mort (1997).\nHighlights from this selection include: \n\u2022\tA Mbembe Drum finial, exhibited in the prestigious 1987 exhibition Primitivism in 20th century art, MOMA in New York (estimate: \u20ac100,000-150,000) \n\u2022\tA Bembe seated figure, Democratic Republic of Congo, published in L\u2019Art Africain, Paris, 1988, Citadelles et Mazenod (estimate: \u20ac15,000-20,000)\n\u2022\tA group of 18 Fon Boccio figures featured in the Vaudou exhibition at Fondation Cartier in Paris in 2001 will be offered including a Fon Boccio Figure from Benin (estimate: \u20ac15,000-20,000). As early as the late sixties, Jacques Kerchache recognized the aesthetic potency and stunning originality of voodoo statuary and its forms. During his first trips to the birthplace of voodoo currently known as the Republic of Benin, the collector began to bring together what has become the most significant existing collection of African Fon boccio statuary. \n\u2022\tSeven impressive Igbo figures include one published in L\u2019Art Africain, Paris, 1988, Citadelles et Mazenod (estimate: \u20ac15,000-18,000).\n","performers":"Bonhams Cornette de Saint Cyr is pleased to announce its first African and Oceanic arts auction in Brussels on 17 December 2024. Sixty-two lots from the prestigious Anne and Jacques Kerchache collection of African and Oceanic Art will be offered at auction, most of them sold without reserve.","boxoffice_url":null,"website":"https:\/\/www.bonhams.com\/auction\/30573\/arts-of-africa-the-pacific-and-the-americas\/?page=2","email":"emilie.jolly@bonhams.com","phone_contact":"+","phone_booking":"+32 2 880 73 80","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700004193"},"it":{"name":"Bonhams First African And Oceanic Art Auction In Brussels Including Selections From The Anne And Jacques Kerchache Collection","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.bonhams.com\/auction\/30573\/arts-of-africa-the-pacific-and-the-americas\/?page=2","email":"emilie.jolly@bonhams.com","phone_contact":"+","phone_booking":"+32 2 880 73 80","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700004193"},"cn":{"name":"Bonhams First African And Oceanic Art Auction In Brussels Including Selections From The Anne And Jacques Kerchache Collection","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.bonhams.com\/auction\/30573\/arts-of-africa-the-pacific-and-the-americas\/?page=2","email":"emilie.jolly@bonhams.com","phone_contact":"+","phone_booking":"+32 2 880 73 80","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700004193"},"fr":{"name":"Vente d'art d'Afrique et d\u2019Oc\u00e9anie de Bonhams","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.bonhams.com\/auction\/30573\/arts-of-africa-the-pacific-and-the-americas\/?page=2","email":"emilie.jolly@bonhams.com","phone_contact":"+","phone_booking":"+32 2 880 73 80","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700004193"},"sp":{"name":"Bonhams First African And Oceanic Art Auction In Brussels Including Selections From The Anne And Jacques Kerchache Collection","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.bonhams.com\/auction\/30573\/arts-of-africa-the-pacific-and-the-americas\/?page=2","email":"emilie.jolly@bonhams.com","phone_contact":"+","phone_booking":"+32 2 880 73 80","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700004193"},"nl":{"name":"Bonhams veiling van Afrikaanse en Oceanische kunst","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.bonhams.com\/auction\/30573\/arts-of-africa-the-pacific-and-the-americas\/?page=2","email":"emilie.jolly@bonhams.com","phone_contact":"+","phone_booking":"+32 2 880 73 80","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700004193"}},"place":{"id":50001705,"translations":{"de":{"name":"Bonhams Cornette de Saint Cyr","address_street_name":"Chauss\u00e9e de Charleroi","address_street_number":"89","address_street_box":"1060","email":"bruxelles@bonhams-csc.com","website":"https:\/\/csc.bonhams