,"boxoffice_url":null,"website":"https:\/\/lepetitchapeaurondrouge.be\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50000673"},"pt":{"name":"Lisalou en concert","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lepetitchapeaurondrouge.be\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50000673"},"en":{"name":"Lisalou en concert","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lepetitchapeaurondrouge.be\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50000673"},"it":{"name":"Lisalou en concert","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lepetitchapeaurondrouge.be\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50000673"},"cn":{"name":"Lisalou en concert","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lepetitchapeaurondrouge.be\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50000673"},"fr":{"name":"Lisalou en concert","shortdescr":"Lisalou est une chanteuse belge, \u00e0 la fois singuli\u00e8re et compl\u00e8te. Ses qualit\u00e9s d'auteure-compositrice-interpr\u00e8te s\u2019allient \u00e0 celles de r\u00e9alisatrice de ses clips vid\u00e9os, styliste et cr\u00e9atrice de ses costumes, de ses maquillages et de ses chor\u00e9graphies.","longdescr":"Lisalou a imagin\u00e9 un premier EP, seule dans sa chambre, o\u00f9 elle a \u00e9galement compos\u00e9, enregistr\u00e9 et mix\u00e9 ses premiers morceaux. Elle d\u00e9finit son style comme \u00ab psych\u00e9-punk-pop \u00bb mais en r\u00e9alit\u00e9, Lisalou a d\u00e9j\u00e0 un univers bien \u00e0 elle qui s'inscrit dans la tendance actuelle d'un nouveau genre de la chanson fran\u00e7aise.\nElle va mettre en pratique ses qualit\u00e9s de r\u00e9alisatrice en r\u00e9alisant le clip \u00ab Magical Mess \u00bb de Machiavel en mars 2022.\nLisalou a d\u00e9j\u00e0 fait de belles sc\u00e8nes dont celle du Centre culturel de Gembloux, de Verviers, aux F\u00eates de Wallonie de Gr\u00e2ce-Hollogne, et le Cirque Royal en premi\u00e8re partie de Machiavel (\u00c9galement \u00e0 Gelbress\u00e9e, au Cabaret Chez \u00c9mile \u00e0 Walhain et \u00e0 la maison des jeunes Le Gu\u00e9 \u00e0 Woluw\u00e9). Son premier album de 10 titres intitul\u00e9 \u00ab Censure \u00bb est arrang\u00e9, mix\u00e9 et masteris\u00e9 par JDM Productions.","performers":"Lisalou","boxoffice_url":null,"website":"https:\/\/lepetitchapeaurondrouge.be\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50000673"},"sp":{"name":"Lisalou en concert","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lepetitchapeaurondrouge.be\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50000673"},"nl":{"name":"Lisalou en concert","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lepetitchapeaurondrouge.be\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50000673"}},"place":{"id":248422,"translations":{"de":{"name":"Le Petit Chapeau Rond Rouge","address_street_name":"Rue P\u00e8re Eudore Devroye","address_street_number":"12","address_street_box":null,"email":"info@lepetitchapeaurondrouge.be","website":"http:\/\/www.lepetitchapeaurondrouge.be","phone_contact":"+32 498 51 35 63","phone_booking":"+32 49