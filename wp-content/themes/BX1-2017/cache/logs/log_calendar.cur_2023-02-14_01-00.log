deo","oEmbed_version":"1.0","oEmbed_provider_name":"Dailymotion","oEmbed_provider_url":"https:\/\/www.dailymotion.com","oEmbed_title":"NewYear_2023_Concerts_Escapades_WithSilvestrov","oEmbed_description":"Happy New Year from Concerts Escapades, an alternative classical music production company.1st concert of the year: Silvestrov+, description below:STUFEN is probably, really, one of the most beautiful song cycles ever written.The Poetry of Pushkin, Blok, Mandelstam, Baratynsky, Tyutchev, Keats ... became divine music, with a touch of quirkiness, through the hands of Valentin Silvestrov, a popular composer whose music is more and more performed. The russian pianist Alexei Lubimov has championed his music already in Soviet times, end of the seventies, performing it, as probably the only one, consistently for nearly 50 years. Valentin Silvestrov handpicked the Ukrainian soprano Viktoria Vitrenko, who has the light and shining purity in her voice that this music needs.","oEmbed_author_name":"concerts escapades","oEmbed_author_url":"https:\/\/www.dailymotion.com\/concertsescapades","oEmbed_width":700,"oEmbed_height":393,"oEmbed_html":"<iframe frameborder=\"0\" width=\"700\" height=\"393\" src=\"https:\/\/www.dailymotion.com\/embed\/video\/x8gjgqn?pubtool=oembed\" allowfullscreen allow=\"autoplay\"><\/iframe>","oEmbed_thumbnail_url":"https:\/\/s2.dmcdn.net\/v\/UVGj_1ZhliMKQnbpD\/x240","oEmbed_thumbnail_width":427,"oEmbed_thumbnail_height":240,"translations":{"fr":{"title":"NewYear_2023_Concerts_Escapades_WithSilvestrov"},"nl":{"title":"NewYear_2023_Concerts_Escapades_WithSilvestrov"},"en":{"title":"NewYear_2023_Concerts_Escapades_WithSilvestrov"},"de":{"title":"NewYear_2023_Concerts_Escapades_WithSilvestrov"},"it":{"title":"NewYear_2023_Concerts_Escapades_WithSilvestrov"},"sp":{"title":"NewYear_2023_Concerts_Escapades_WithSilvestrov"},"pt":{"title":"NewYear_2023_Concerts_Escapades_WithSilvestrov"},"cn":{"title":"NewYear_2023_Concerts_Escapades_WithSilvestrov"}}},{"type":"