\u00e9rations.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Centre Culturel Jacques Franck","address_street_name":"Chauss\u00e9e de Waterloo","address_street_number":"94","address_street_box":null,"email":"info@lejacquesfranck.be","website":"http:\/\/www.lejacquesfranck.be","phone_contact":"+32 2 538 90 20","phone_booking":"+32 2 538 90 20","address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Chauss\u00e9e de Waterloo, 94","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"CC Jacques Franck","address_street_name":"Waterlose Steenweg","address_street_number":"94","address_street_box":null,"email":"info@lejacquesfranck.be","website":"http:\/\/www.lejacquesfranck.be","phone_contact":"+32 2 538 90 20","phone_booking":"+32 2 538 90 20","address_zip":"1060","address_city":"Sint-Gillis","address_line1":"Waterlose Steenweg, 94","address_line2":"1060 Sint-Gillis","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[7],"translations":{"de":["Saint-Gilles Zentrum"],"pt":[null],"en":["Saint-Gilles Centre"],"it":["Saint-Gilles Centre"],"cn":[null],"fr":["Saint-Gilles Centre"],"sp":["Saint-Gilles Centre"],"nl":["Sint-Gillis centrum"]}},"zones":{"list":[21],"translations":{"de":["S\u00fcden"],"pt":[null],"en":["South"],"it":["Sud"],"cn":[null],"fr":["Sud"],"sp":["Sur"],"nl":["Zuid"]}},"neca":null,"facebook_id":null,"backoffice_id":2,"location":{"lat":50.82934744,"lon":4.3446382},"region":"brussels","last_updated_at":"2023-09-19T15:45:28+02:00","published_at":"2013-10-19T01:13:13+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":false,"resto_ranking":0},"organizer":{"id":4,"translations":{"de":{"name":"Centre Culturel Jacques Franck","address_st