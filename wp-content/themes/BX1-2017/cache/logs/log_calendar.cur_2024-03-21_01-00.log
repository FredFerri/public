elibre.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50007955"},"it":{"name":"En roue libre, le festival du voyage \u00e0 v\u00e9lo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.enrouelibre.be","email":"info@enrouelibre.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50007955"},"cn":{"name":"En roue libre, le festival du voyage \u00e0 v\u00e9lo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.enrouelibre.be","email":"info@enrouelibre.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50007955"},"fr":{"name":"En roue libre, le festival du voyage \u00e0 v\u00e9lo","shortdescr":"Les 22 & 23 mars 2024, venez faire des d\u00e9couvertes et des rencontres, r\u00eaver et pr\u00e9parer votre prochain voyage \u00e0 v\u00e9lo ! ","longdescr":"En Roue Libre est un festival avec des films, des rencontres, des stands et des ateliers pratiques pour les cyclistes qui ont envie de partir en voyage \u00e0 v\u00e9lo ! Un programme complet qui s\u2019adresse tant aux passionn\u00e9\u00b7es qu\u2019aux d\u00e9butant\u00b7es. On s'y informe, on y fait des d\u00e9couvertes et des rencontres de voyageurs et voyageuses inspirantes dans une ambiance r\u00e9solument d\u00e9tendue & festive !\n\nCette 6\u00e8me \u00e9dition s\u2019ouvrira vendredi 22 mars avec un film pr\u00e9sentant la tourn\u00e9e \u00e0 v\u00e9lo de la chanteuse Roza qui viendra interpr\u00e9ter quelques chansons. La journ\u00e9e du samedi 23 mars, les projections s\u2019encha\u00eeneront avec des rencontres-t\u00e9moignages, des ateliers pratiques (m\u00e9canique, cuisine, s\u00e9rigraphie, outils cartographiques) mais aussi des stands d'associations de cyclo-randonn\u00e9e, une exposition de photographies, un espace pour confier ses souvenirs de voyage \u00e0 Madame Georgette.\n\nAlors, tous\u00b7tes \u00e0 vos v\u00e9los, direction la 6e \u00e9dition de ce festival !","performers":null,"boxoffice_url":null,"website":"http:\/\/www.enrouelibre.be","email":"info@enrouelibre.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50007955"},"sp":{"name":"En roue libre, le festival du voyage \u00e0 v\u00e9lo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.enrouelibre.be","email":"info@enrouelibre.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50007955"},"nl":{"name":"En roue libre, le festival du voyage \u00e0 v\u00e9lo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.enrouelibre.be","email":"info@enrouelibre.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50007955"}},"place":{"id":230253,"translations":{"de":{"name":"Maison Haute","address_street_name":"Place Antoine Gilson","address_street_number":"1","address_street_box":null,"email":"culture1170@wb.irisnet.be","website":"http:\/\/watermael-boitsfort.be\/fr\/commune\/services-communaux\/service-de-la-culture?set_language=fr","phone_contact":"+32 2 674 74 26","phone_booking":"+32 2 674 75 07","address_zip":"1170","address_city":"Watermael-Boitsfort","address_line1":"Place Antoine Gilson, 1","address_line2":"1170 Watermael-Boitsfort","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Maison Haute","address_street_name":"Place Antoine Gilson","address_street_number":"1","address_street_box":null,"email":"culture1170@wb.irisnet.be","website":"http:\/\/watermael-boitsfort.be\/fr\/commune\/services-communaux\/service-de-la-culture?s