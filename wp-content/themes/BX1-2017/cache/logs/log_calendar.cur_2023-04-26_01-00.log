 qu\u2019aucun roi n\u2019y a jamais mis les pieds ? Pourquoi, pourquoi, pourquoi \u2026 \u2753\r\nC\u2019est qu\u2019elle en rec\u00e8le des \u00e9l\u00e9ments myst\u00e9rieux, la Grand-Place de Bruxelles !\r\nInvitez-vous \u00e0 percer ses secrets : \u00e9sot\u00e9risme, symbolisme, alchimie et franc-ma\u00e7onnerie oeuvreront, tels autant de fils conducteurs dans cette visite hors du commun.\r\nAvec un guide bruxellois !","performers":"Vincent Beckers, guide touristique et r\u00e9gional","boxoffice_url":null,"website":"http:\/\/www.visiteguideebruxelles.be","email":"info@visiteguideebruxelles.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.549960"},"nl":{"name":"Les Myst\u00e8res de la Grand-Place","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.visiteguideebruxelles.be","email":"info@visiteguideebruxelles.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.549960"},"en":{"name":"Les Myst\u00e8res de la Grand-Place","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.visiteguideebruxelles.be","email":"info@visiteguideebruxelles.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.549960"},"de":{"name":"Les Myst\u00e8res de la Grand-Place","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.visiteguideebruxelles.be","email":"info@visiteguideebruxelles.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.549960"},"it":{"name":"Les Myst\u00e8res de la Grand-Place","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.visiteguideebruxelles.be","email":"info@visiteguideebruxelles.be","phone_contact":null,"phone_b