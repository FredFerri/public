scription_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Au-dessus des marches du Mont du Cinquantenaire","address_street_name":"Au-dessus des marches du Mont du Cinquantenaire, en face du num\u00e9ro 135 avenue des NervienAu-dessus des marches du Mont du Cinquantenaires, 1040 Bruxelles (proche de l\u2019arr\u00eat de bus \u00ab Gaulois \u00bb)","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Au-dessus des marches du Mont du Cinquantenaire, en face du num\u00e9ro 135 avenue des NervienAu-dessus des marches du Mont du Cinquantenaires, 1040 Bruxelles (proche de l\u2019arr\u00eat de bus \u00ab Gaulois \u00bb)","address_line2":"1040 Etterbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Au-dessus des marches du Mont du Cinquantenaire","address_street_name":"Au-dessus des marches du Mont du Cinquantenaire, en face du num\u00e9ro 135 avenue des NervienAu-dessus des marches du Mont du Cinquantenaires, 1040 Bruxelles (proche de l\u2019arr\u00eat de bus \u00ab Gaulois \u00bb)","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Au-dessus des marches du Mont du Cinquantenaire, en face du num\u00e9ro 135 avenue des NervienAu-dessus des marches du Mont du Cinquantenaires, 1040 Bruxelles (proche de l\u2019arr\u00eat de bus \u00ab Gaulois \u00bb)","address_line2":"1040 Etterbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":[],"zones":{"list":[22],"translations":{"fr":["Est"],"nl":["Oost"],"en":["East"],"de":["Osten"],"it":["Est"],"sp":["Este"],"pt":[null],"cn":[null]}},"neca":null,"facebook_id":null,"backoffice_id":40433,"location":{"lat":50.84626076,"lon":4.39728481},"region":"brussels","last_updated_at":"2023-06-16T11:35:20+02:00","published_at":"2023-05-04T14:59:50+02:00","import_origin":null,"external_id":null,"is_in_address_book":false,"is_in_vb_export":false,"resto_ranking":0},"organizer":{"id":204134,"translations":{"fr":{"name":"Arau - Atelier de Recherche et d'Action Urbaines","address_street_name":"Rue du Midi","address_street_number":"165","address_street_box":null,"email":"info@arau.org","website":"http:\/\/www.arau.org","phone_contact":"+32 2 219 33 45","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Midi, 165","address_line2":"1000 Bruxelles","description_web":"Comprendre Bruxelles pour mieux la d\u00e9fendre !\r\nL\u2019ARAU a \u00e9t\u00e9 fond\u00e9 en 1969, dans un contexte de \u00ab bruxellisation \u00bb et d\u2019exode des Bruxellois vers la p\u00e9riph\u00e9rie. L\u2019enjeu \u00e0 l\u2019\u00e9poque, toujours d\u2019actualit\u00e9 : d\u00e9fendre et promouvoir la ville habit\u00e9e et une qualit\u00e9 de vie pour tous les Bruxellois, ce qui s\u2019est traduit par d\u2019importantes contestations de projets de d\u00e9molition d\u2019une part et le d\u00e9veloppement de contre-projets d\u2019autre part, dans une optique de r\u00e9novation urbaine et d\u2019am\u00e9lioration du cadre de vie.\r\nL\u2019ARAU entend, par son action de sensibilisation et d\u2019information de la population, mettre \u00e0 disposition du public les outils n\u00e9cessaires pour suivre l\u2019\u00e9volution de la ville. Cette action se mat\u00e9rialise \u00e0 travers la publication d\u2019analyses et d\u2019\u00e9tudes, l\u2019organisation de colloques et d\u2019ateliers, des communiqu\u00e9s de presse, \u2026ainsi que de visites guid\u00e9es.\r\nCes visites, pionni\u00e8res en r\u00e9gion bruxelloise et organis\u00e9es depuis 1977, visent \u00e0 revaloriser la ville et ses atouts, \u00e0 d\u00e9velopper un regard critique sur ses transformations, ce qui passe par la sauvegarde et l\u2019entretien de son patrimoine.\r\nAu fil de toutes ces ann\u00e9es, l\u2019ARAU a d\u00e9velopp\u00e9 un riche catalogue de visites guid\u00e9es se d\u00e9clinant en diverses th\u00e9matiques : \u00ab Bruxelles incontournable \u00bb, \u00ab Architecture \u00bb, \u00ab Bruxelles en quartiers \u00bb, \u00ab La ville en transformation \u00bb, \u00ab Parcours d\u2019\u00e9t\u00e9 \u00bb, \u00ab Une maison bruxelloise \u00bb, \u00ab Bruxelles : ville de trams \u00bb, \u00ab Bruxelles sociale \u00bb, qu\u2019il est possible de d\u00e9couvrir lors de tours publics ou sous forme de visites priv\u00e9es, personnalisables.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Arau - Atelier de Recherche et d'Action Urbaines","address_street_name":"Zuidstraat","address_street_number":"165","address_street_box":null,"email":"info@arau.org","website":"http:\/\/www.arau.org","phone_contact":"+32 2 219 33 45","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Zuidstraat, 165","address_line2":"1000 Brussel","description_web":"Brussel begrijpen om het beter te kunnen verdedigen!\r\nHet ARAU werd opgericht in 1969, in een context van \u201cBrusselisering\u201d en de uittocht van de Brusselaars naar de rand. De uitdaging van die tijd, die ook vandaag nog actueel is, bestond erin de bewoonde stad en de levenskwaliteit van alle Brusselaars te verdedigen en te bevorderen. Dat leidde tot grote protesten tegen afbraakprojecten enerzijds en de ontwikkeling van tegenprojecten anderzijds, met het oog op stadsvernieuwing en verbetering van de leefomgeving.\r\nHet ARAU wil met zijn bewustmakings- en voorlichtingsactie de bevolking de nodige instrumenten aanreiken om de evolutie van de stad te volgen. Deze actie neemt de vorm aan van de publicatie van analyses en studies, de organisatie van conferenties en workshops, perscommuniqu\u00e9s, enz. en rondleidingen.\r\nDeze rondleidingen, die baanbrekend zijn in het Brusselse Gewest en al sinds 1977 worden georganiseerd, hebben tot doel de stad en haar troeven tot hun recht te laten komen en een kritische kijk te ontwikkelen op haar transformaties, die ook het behoud en de instandhouding van haar erfgoed inhouden.\r\nIn de loop der jaren heeft het ARAU een rijke catalogus van rondleidingen over verschillende thema\u2019s samengesteld: \u201cOnmisbaar Brussel\u201d, \u201cArchitectuur\u201d, \u201cBrussel in wijken\u201d, \u201cDe stad in transformatie\u201d, \u201cZomerreis\u201d, \u201cEen Brussels huis\u201d, \u201cBrussel: stad van de trams\u201d, \u201cSociaal Brussel\u201d, die tijdens openbare rondleidingen of in de vorm van priv\u00e9rondleidingen op maat kunnen worden ontdekt.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Arau - Atelier de Recherche et d'Action Urbaines","address_street_name":"Rue du Midi","address_street_number":"165","address_street_box":null,"email":"info@arau.org","website":"http:\/\/www.arau.org","phone_contact":"+32 2 219 33 45","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue du Midi, 165","address_line2":"1000 Brussels","description_web":"Understanding Brussels to better defend it!\r\nARAU was founded in 1969, in a context of \u2018Brusselsisation\u2019 and the exodus of Brussels residents to the periphery. The challenge at the time, which is still relevant today, was to defend and promote the inhabited city and a quality of life for all the inhabitants of Brussels. This led to major protests against demolition projects on the one hand and the development of counter-projects on the other, with a view to urban renewal and improving the living environment.\r\nThe ARAU intends, through its action to raise awareness and inform the population, to provide the public with the necessary tools to monitor the evolution of the city. This action takes the form of the publication of analyses and studies, the organisation of conferences and workshops, press releases, etc., as well as guided tours.\r\nThese tours, which are pioneering in the Brussels region and have been organised since 1977, aim to enhance the city and its assets, and to develop a critical view of its transformations, which includes the preservation and maintenance of its heritage.\r\nOver the years, the ARAU has developed a rich catalogue of guided tours on various themes: \u201cUnmissable Brussels\u201d, \u201cArchitecture\u201d, \u201cBrussels in Districts\u201d, \u201cThe City in Transformation\u201d, \u201cSummer Journey\u201d, \u201cA Brussels House\u201d, \u201cBrussels: City of Trams\u201d, \u201cSocial Brussels\u201d, which can be discovered during public tours or in the form of private, customised tours.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Arau - Atelier de Recherche et d'Action Urbaines","address_street_name":"Rue du Midi","address_street_number":"165","address_street_box":null,"email":"info@arau.org","website":"http:\/\/www.arau.org","phone_contact":"+32 2 219 33 45","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Midi, 165","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Arau - Atelier de Recherche et d'Action Urbaines","address_street_name":"Rue du Midi","address_street_number":"165","address_street_box":null,"email":"info@arau.org","website":"http:\/\/www.arau.org","phone_contact":"+32 2 219 33 45","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Midi, 165","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Arau - Atelier de Recherche et d'Action Urbaines","address_street_name":"Rue du Midi","address_street_number":"165","address_street_box":null,"email":"info@arau.org","website":"http:\/\/www.arau.org","phone_contact":"+32 2 219 33 45","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Midi, 165","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Arau - Atelier de Recherche et d'Action Urbaines","address_street_name":"Rue du Midi","address_street_number":"165","address_street_box":null,"email":"info@arau.org","website":"http:\/\/www.arau.org","phone_contact":"+32 2 219 33 45","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Midi, 165","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Arau - Atelier de Recherche et d'Action Urbaines","address_street_name":"Rue du Midi","address_street_number":"165","address_street_box":null,"email":"info@arau.org","website":"http:\/\/www.arau.org","phone_contact":"+32 2 219 33 45","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Midi, 165","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":null,"facebook_id":null,"backoffice_id":422,"location":{"lat":50.84343195,"lon":4.34634563},"region":"brussels","last_updated_at":"2023-06-16T11:35:20+02:00","published_at":"2013-10-19T01:13:31+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/f3d33d63b657e5918c0f8e76c7ad81d75d95012d.jpg","width":4000,"height":3000,"ratio":1.33,"translations":{"fr":{"title":"Etterbeek c\u00f4t\u00e9 village","copyright":null},"nl":{"title":"Etterbeek c\u00f4t\u00e9 village","copyright":null},"en":{"title":"Etterbeek c\u00f4t\u00e9 village","copyright":null},"de":{"title":"Etterbeek c\u00f4t\u00e9 village","copyright":null},"it":{"title":"Etterbeek c\u00f4t\u00e9 village","copyright":null},"sp":{"title":"Etterbeek c\u00f4t\u00e9 village","copyright":null},"pt":{"title":"Etterbeek c\u00f4t\u00e9 village","copyright":null},"cn":{"title":"Etterbeek c\u00f4t\u00e9 village","copyright":null}}}],"dates":[{"day":"2023-07-29","doors":null,"start":"14:00:00","end":"16:00:00","is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"},"de":{"name":"Normal"},"it":{"name":"Normale"},"sp":{"name":"Normal"},"pt":{"name":"Normal"},"cn":{"name":"Normal"}},"value":12},{"translations":{"fr":{"name":"Etudiants"},"nl":{"name":"Studenten"},"en":{"name":"Students"},"de":{"name":"Studierende"},"it":{"name":"Studenti"},"sp":{"name":"Estudiantes"},"pt":{"name":"Etudiants"},"cn":{"name":"Etudiants"}},"value":8},{"translations":{"fr":{"name":"Seniors"},"nl":{"name":"Senioren"},"en":{"name":"Seniors"},"de":{"name":"Senioren"},"it":{"name":"Anziani"},"sp":{"name":"Mayores"},"pt":{"name":"Seniors"},"cn":{"name":"Seniors"}},"value":8},{"translations":{"fr":{"name":"Article 27"},"nl":{"name":"Artikel 27"},"en":{"name":"Article 27"},"de":{"name":"Article 27"},"it":{"name":"Article 27"},"sp":{"name":"Article 27"},"pt":{"name":"Article 27"},"cn":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-06-16T11:35:20+02:00","published_at":"2023-06-16T11:25:04+02:00","backoffice_id":279745,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":1},{"id":561257,"date_start":"2023-07-29","date_end":"2023-07-30","date_next":"2023-07-29","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":57,"translations":{"fr":"Clubbing","nl":"Clubbing","en":"Clubbing","de":"Clubbing","it":"Locali notturni","sp":"Ir de discoteca","pt":null,"cn":null}},"others":{}},"languages":{"spoken":["en","fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"C12 Nite","shortdescr":null,"longdescr":"Good to know\r\n\u2594\u2594\u2594\r\nDoors open: 23h59\r\n\u2014\u2014\u2014\u2014\u2014\u2014\r\nAge limit : + 21\r\n\u2014\u2014\u2014\u2014\u2014\u2014\r\nIn = In \/\/ Out = Out\r\n\u2014\u2014\u2014\u2014\u2014\u2014\r\nFor all kinds of people.\r\n\r\nTickets\r\n\u2594\u2594\u2594\r\nhttps:\/\/c12space.com\/presale-tickets\/\r\nDoor sale starts at 23h59\r\nLockers : 2\u20ac\r\nToilets : Free\r\n\r\n\r\n\ufeff\r\nAddress\r\n\u2594\u2594\u2594\u2594\r\n116 rue marche aux herbes\r\n1000 Brussels\r\n\r\n\ufeff\r\nWhat we stand for\r\n\u2594\u2594\u2594\r\nC12 is a pluridisciplinary space where art & clubbing collide. It\u2019s a place where freedom, diversity, creativity and alternative cultures are protected from the outside world and its norms and restrictions. By doing this, we wish to establish a place owned by artists, musicians and every individual who comes through our door.\r\n\r\nNO!\r\n\u2014\u2014-\r\nIn order to protect our space, we will not tolerate any discriminating comportment (racism, sexism, homophobia, \u2026), shaming, violence, consumption of drugs and any kind of intrusive behaviour, even in its most passive form.\r\n\r\n\r\n\ufeff\r\nRESPECT!\r\n\u2014\u2014\u2014\u2014-\r\nBetween these walls, we look out for each other and respect and tolerance are key. Everyone among us is treated equally, regardless of who they are, where they come from and what they do. The space belongs to everyone and to no group or no community in particular.\r\n\r\nIN OR NOT?\r\n\u2014\u2014\u2014\u2014-\r\nC12 is a private space and reserves the right to decide which visitors are allowed to enter. Represented by our door staff, we reserve the right to deny entry to every person deemed unable to respect the values connected to the project.\r\n\r\nNEED HELP?\r\n\u2014\u2014\u2014\u2014-\r\nC12\u2019s staff has been trained to act against any disputative situation or behavior. We have a help desk located near the entrance of the main room, where you can talk to a staff member any time of the night. We have staff present on the dance floor and in every corner of the club, functioning as our eyes and ears. We encourage anyone who witnesses a violation of the rules to contact a C12 staff member. In case of indictment, C12 reserves the right to contact the authorities. Respect yourself, the audience, the artists and the staff, stay hydrated and have a pleasant time.\r\nWe wish you an incredible night of clubbing.","performers":"SAT 29.07.2023\r\n\u24b8\u2460\u2461 \r\nKahn\r\nMatho & Nidrev\r\nDJ Track\r\nBunzero & Mr Jo","boxoffice_url":null,"website":"https:\/\/c12space.com","email":"c12brussels@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.561257"},"nl":{"name":"C12 Nite","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/c12space.com","email":"c12brussels@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.561257"},"en":{"name":"C12 Nite","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/c12space.com","email":"c12brussels@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.561257"},"de":{"name":"C12 Nite","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/c12space.com","email":"c12brussels@gmail.co