s d'art"],"sp":["Fotograf\u00eda","Galer\u00edas de arte"],"nl":["Fotografie","Galeries"]}}},"translations":{"de":{"name":"\"Femmes du sud du Maroc\" de Ren\u00e9 Bertrand","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.espacemagh.be\/projects\/femmes-du-sud-du-maroc-de-rene-bertrand\/?pr=18004&gr=1&post=projects&sa=","email":"reservation@espacemagh.be","phone_contact":"+32 2 274 05 10","phone_booking":"+32 2 274 05 10","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50005035"},"pt":{"name":"\"Femmes du sud du Maroc\" de Ren\u00e9 Bertrand","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.espacemagh.be\/projects\/femmes-du-sud-du-maroc-de-rene-bertrand\/?pr=18004&gr=1&post=projects&sa=","email":"reservation@espacemagh.be","phone_contact":"+32 2 274 05 10","phone_booking":"+32 2 274 05 10","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50005035"},"en":{"name":"Femmes du Sud du Maroc de Ren\u00e9 Bertrand","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.espacemagh.be\/projects\/femmes-du-sud-du-maroc-de-rene-bertrand\/?pr=18004&gr=1&post=projects&sa=","email":"reservation@espacemagh.be","phone_contact":"+32 2 274 05 10","phone_booking":"+32 2 274 05 10","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50005035"},"it":{"name":"\"Femmes du sud du Maroc\" de Ren\u00e9 Bertrand","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.espacemagh.be\/projects\/femmes-du-sud-du-maroc-de-rene-bertrand\/?pr=18004&gr=1&post=projects&sa=","email":"reservation@espacemagh.be","phone_contact":"+32 2 274 05 10","phone_booking":"+32 2 274 05 10","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50005035"},"cn":{"name":"\"Femmes du sud du Maroc\" de Ren\u00e9 Bertrand","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.espacemagh.be\/projects\/femmes-du-sud-du-maroc-de-rene-bertrand\/?pr=18004&gr=1&post=projects&sa=","email":"reservation@espacemagh.be","phone_contact":"+32 2 274 05 10","phone_booking":"+32 2 274 05 10","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50005035"},"fr":{"name":"Femmes du Sud du Maroc de Ren\u00e9 Bertrand","shortdescr":"Durant plusieurs d\u00e9cennies, entre 1930 et 1967, le photographe fran\u00e7ais Ren\u00e9 Bertrand (1910-1979) a captur\u00e9 le sud du Maroc, la r\u00e9gion de Marrakech et le Haut-Atlas. ","longdescr":"Durant plusieurs d\u00e9cennies, entre 1930 et 1967, le photographe fran\u00e7ais Ren\u00e9 Bertrand (1910-1979) a captur\u00e9 le sud du Maroc, la r\u00e9gion de Marrakech et le Haut-Atlas. \n\nT\u00e9moin privil\u00e9gi\u00e9, il a photographi\u00e9, \u00e0 l\u2019aide de son appareil moyen format argentique, des sc\u00e8nes de vie et des coutumes aujourd\u2019hui quasiment disparues. Durant sa carri\u00e8re, il a focalis\u00e9 son int\u00e9r\u00eat sur les villes et sur les r\u00e9gions du Sud. Pratiquant une photographie dite documentaire, il nous a offert quelques traces incroyables de la richesse culturelle et de l\u2019histoire marocaine. \n\nSuite \u00e0 son d\u00e9c\u00e8s en 1979, son fils, Andr\u00e9 Bertrand a autoris\u00e9 la num\u00e9risation des films de son p\u00e8re et a offert une partie de sa collection \u00e0 la Maison de la Photographie de Marrakech.\n\nAujourd\u2019hui, sous la direction artistique du photographe bruxellois Bertrand Vandeloise, nous vous proposons de vous plonger dans ses fardes de n\u00e9gatifs et de d\u00e9couvrir une partie de sa collection priv\u00e9e jamais exploit\u00e9e \u00e0 ce jour.\n\nUne exposition \u00e0 l'initiative de Bertrand Vandeloise.\nCo-production : Espace Magh et Bertrand Vandeloise\nDirection artistique : Bertrand Vandeloise\nAvec l\u2019aimable autorisation de Monsieur Andr\u00e9 Bertrand","performers":null,"boxoffice_url":null,"website":"https:\/\/www.espacemagh.be\/projects\/femmes-du-sud-du-maroc-de-rene-bertrand\/?pr=18004&gr=1&post=projects&sa=","email":"reservation@espacemagh.be","phone_contact":"+32 2 274 05 10","phone_booking":"+32 2 274 05 10","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50005035"},"sp":{"name":"\"Femmes du sud du Maroc\" de Ren\u00e9 Bertrand","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.espacemagh.be\/projects\/femmes-du-sud-du-maroc-de-rene-bertrand\/?pr=18004&gr=1&post=projects&sa=","email":"reservation@espacemagh.be","phone_contact":"+32 2 274 05 10","phone_booking":"+32 2 274 05 10","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50005035"},"nl":{"name":"Femmes du Sud du Maroc de Ren\u00e9 Bertrand","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.espacemagh.be\/projects\/femmes-du-sud-du-maroc-de-rene-bertrand\/?pr=18004&gr=1&post=projects&sa=","email":"reservation@espacemagh.be","phone_contact":"+32 2 274 05 10","phone_booking":"+32 2 274 05 10","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50005035"}},"place":{"id":247296,"translations":{"de":{"name":"Centre culturel Espace Magh asbl","address_street_name":"Rue du Poin\u00e7on","address_street_number":null,"address_street_box":null,"email":"info@espacemagh.be","website":"http:\/\/www.espacemagh.be","phone_contact":"+32 2 274 05 10","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Poin\u00e7on","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Centre culturel Espace Magh asbl","address_street_name":"Rue du Poin\u00e7on","address_street_number":null,"address_street_box":null,"email":"info@espacema