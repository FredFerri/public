_box":null,"email":"info@ccbruegel.be","website":"http:\/\/www.ccbruegel.be","phone_contact":"+32 2 503 42 68","phone_booking":"+32 2 503 42 68","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Renards, 1 F","address_line2":"1000 Bruxelles","description_web":"Situ\u00e9 dans un b\u00e2timent consacr\u00e9 \u00e0 la culture depuis le d\u00e9but du XXe si\u00e8cle, notamment salle de projections cin\u00e9matographiques en 1911, le Centre Culturel Bruegel, cr\u00e9\u00e9 en 1982, occupe une place de choix dans l\u2019embl\u00e9matique quartier des Marolles, avec une d\u00e9clinaison d\u2019activit\u00e9s jouant avant tout la carte de la proximit\u00e9.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Centre Culturel Bruegel","address_street_name":"Rue des Renards","address_street_number":"1 F","address_street_box":null,"email":"info@ccbruegel.be","website":"http:\/\/www.ccbruegel.be","phone_contact":"+32 2 503 42 68","phone_booking":"+32 2 503 42 68","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Renards, 1 F","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"CC Bruegel","address_street_name":"Vossenstraat","address_street_number":"1 F","address_street_box":null,"email":"info@ccbruegel.be","website":"http:\/\/www.ccbruegel.be","phone_contact":"+32 2 503 42 68","phone_booking":"+32 2 503 42 68","address_zip":"1000","address_city":"Bruxelles","address_line1":"Vossenstraat, 1 F","address_line2":"1000 Bruxelles","description_web":"Gevestigd in een gebouw gewijd aan cultuur sinds het begin van de twintigste eeuw (in 1911 fungeerde het reeds als particuliere filmprojectiezaal), neemt het Cultureel Centrum Bruegel, opgericht in 1982, een bijzondere plaats in in de karakteristieke wijk van de Marollen. De activiteiten zijn er in de eerste plaats op gericht om de diverse bevolk