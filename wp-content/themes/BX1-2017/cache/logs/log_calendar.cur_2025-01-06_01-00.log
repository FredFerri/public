_at":"2024-12-10T10:56:01+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":313492,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"concert","ranking":1,"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"categories":{"main":{"id":1,"translations":{"de":"Konzert","pt":null,"en":"Concert","it":"Concerti","cn":null,"fr":"Concert","sp":"Concierto","nl":"Concert"}},"others":{"list":[2],"translations":{"de":["Klassisch"],"pt":[null],"en":["Classical"],"it":["Classica"],"cn":[null],"fr":["Classique"],"sp":["Cl\u00e1sica"],"nl":["Klassiek"]}}},"translations":{"de":{"name":"DAS HAUS presents Tamar Halperin \u2018GROUND\u2019","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.dashaus.be\/events\/ground","email":"dashausmuzik@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700004463"},"pt":{"name":"DAS HAUS presents Tamar Halperin \u2018GROUND\u2019","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.dashaus.be\/events\/ground","email":"dashausmuzik@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700004463"},"en":{"name":"DAS HAUS presents Tamar Halperin \u2018GROUND\u2019","shortdescr":"The radically cozy world of DAS HAUS starts the new year with exciting, contemporary soundscapes that transform into classical masterpieces. Internationally celebrated pianist and harpsichord player Tamar Halperin takes the stage for the world premiere of Ground: Toccata\u2019s & Ambients. A concert that will challenge, surprise and inspire \u2026\n","longdescr":"The radically cozy world of DAS HAUS starts the new year with exciting, contemporary soundscapes that transform into classical masterpieces. Internationally celebrated pianist and harpsichord player Tamar Halperin takes the stage for the world premiere of Ground: Toccata\u2019s & Ambients. A concert that will challenge, surprise and inspire\u2026\nImagine the rich rhythms, forms and techniques of famous composers like Bach, Frescobaldi, Purcell, Satie and Cage dismantled and reintroduced note by note, interwoven with contemporary minimal harmonies and jazz-inspired patterns. Tamar\u2019s \u201cconstruction site\u201d compositions\u2014layered with dissonances, atonal flirting and gradual revelations of the original composition\u2014take you on an auditory adventure where the familiar becomes a discovery. As Tamar masterfully navigates the harpsichord, the piano and the electronic keyboard she will be joined by electronic sound artist Doron Segal, creating an immersive sonic tapestry that invites listeners to zigzag through centuries and styles. Together, their energetic improvisations will shift the boundaries of tradition and innovation, revealing the connections that bridge time and genre.\nKeyboard virtuoso Tamar Halperin is known for her genre-defying performances and compositions. Using innovative techniques, she reimagines classical music for modern audiences. Her accolades include awards for classical piano performance, baroque harpsichord mastery, multi-keyboard jazz music and the prestigious Hessian Cultural Prize for fostering cultural bridges. Tamar\u2019s work is fuelled by love for classical music and a mission to make it resonate with the contemporary world.\nJazz pianist, composer and electronic musician Doron Segal brings a soulful, exploratory dimension to this performance. With roots in classical training and a career spanning Israeli conservatories to Berlin\u2019s vibrant music scene, Doron has collaborated with a diverse array of international artists, adding depth and texture to each project. \nThis DAS HAUS evening lets the harmony of centuries unfold in a funky, minimalist and dreamy way.","performers":"Tamar Halperin (piano, harpsichord, electronic keyboard); Doron Segal (electronic sound)","boxoffice_url":null,"website":"https:\/\/www.dashaus.be\/events\/ground","email":"dashausmuzik@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700004463"},"it":{"name":"DAS HAUS presents Tamar Halperin \u2018GROUND\u2019","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.dashaus.be\/events\/ground","email":"dashausmuzik@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700004463"},"cn":{"name":"DAS HAUS presents Tamar Halperin \u2018GROUND\u2019","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.dashaus.be\/events\/ground","email":"dashausmuzik@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700004463"},"fr":{"name":"DAS HAUS presents Tamar Halperin \u2018GROUND\u2019","shortdescr":"Le monde radicalement cosy de DAS HAUS commence la nouvelle ann\u00e9e avec des paysages sonores contemporains excitants qui se transforment en chefs-d'\u0153uvre classiques. La pianiste et claveciniste de renomm\u00e9e internationale Tamar Halperin monte sur sc\u00e8ne pour la premi\u00e8re mondiale de Ground: Toccata\u2019s & Ambients. Ce concert promet de d\u00e9fier, surprendre et inspirer.","longdescr":"Le monde radicalement cosy de DAS HAUS commence la nouvelle ann\u00e9e avec des paysages sonores contemporains excitants qui se transforment en chefs-d'\u0153uvre classiques. La pianiste et claveciniste de renomm\u00e9e internationale Tamar Halperin monte sur sc\u00e8ne pour la premi\u00e8re mondiale de Ground: Toccata\u2019s & Ambients. Ce concert promet de d\u00e9fier, surprendre et inspirer.\nImaginez les riches rythmes, formes et techniques de Bach, Frescobaldi, Purcell, Satie et Cage d\u00e9construits et r\u00e9introduits note par note, entrelac\u00e9s avec des harmonies minimalistes contemporaines et des motifs inspir\u00e9s du jazz. Les \u00ab compositions en chantier \u00bb de Tamar, superpos\u00e9es de dissonances, d'atonalit\u00e9 et de r\u00e9v\u00e9lations progressives, vous emm\u00e8nent dans une aventure auditive o\u00f9 le familier devient une d\u00e9couverte.\nTamar, avec une ma\u00eetrise incomparable du clavecin, du piano et du clavier \u00e9lectronique, sera accompagn\u00e9e par l\u2019artiste sonore \u00e9lectronique Doron Segal, cr\u00e9ant une tapisserie sonore immersive qui invite les auditeurs \u00e0 zigzaguer \u00e0 travers les si\u00e8cles et les styles. Ensemble, leurs improvisations dynamiques repoussent les limites de la tradition et de l'innovation, r\u00e9v\u00e9lant les connexions qui lient le temps et les genres.\nTamar Halperin, virtuose des claviers, est reconnue pour ses performances et compositions qui transcendent les genres. Gr\u00e2ce \u00e0 des techniques innovantes, elle r\u00e9invente la musique classique pour des publics contemporains. Ses nombreuses distinctions incluent des prix pour ses performances en piano classique, sa ma\u00eetrise du clavecin baroque, et ses explorations de la musique jazz multi-clavier.\nDoron Segal, pianiste de jazz, compositeur et musicien \u00e9lectronique, apporte une dimension exploratoire et empreinte d\u2019\u00e2me \u00e0 cette performance. Fort d\u2019une formation classique et d\u2019une carri\u00e8re allant des conservatoires isra\u00e9liens \u00e0 la sc\u00e8ne musicale vibrante de Berlin, il a collabor\u00e9 avec une grande vari\u00e9t\u00e9 d\u2019artistes internationaux, ajoutant profondeur et texture \u00e0 chaque projet.\nCette soir\u00e9e DAS HAUS d\u00e9ploie l'harmonie des si\u00e8cles pass\u00e9s dans une ambiance funky, minimaliste et onirique.","performers":"Tamar Halperin (piano, clavecin, clavier \u00e9lectronique); Doron Segal (tapisserie sonore)","boxoffice_url":null,"website":"https:\/\/www.dashaus.be\/events\/ground","email":"dashausmuzik@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700004463"},"sp":{"name":"DAS HAUS presents Tamar Halperin \u2018GROUND\u2019","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.dashaus.be\/events\/ground","email":"dashausmuzik@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700004463"},"nl":{"name":"DAS HAUS presents Tamar Halperin \u2018GROUND\u2019","shortdescr":"De radicaal gezellige wereld van DAS HAUS begint het nieuwe jaar met spannende, hedendaagse klanklandschappen die transformeren in klassieke meesterwerken. De internationaal gevierde pianiste en klaveciniste Tamar Halperin betreedt het DAS HAUS-podium voor de wereldpremi\u00e8re van Ground: Toccata\u2019s & Ambients- een concert dat uitdaagt, verrast en inspireert.","longdescr":"De radicaal gezellige wereld van DAS HAUS begint het nieuwe jaar met spannende, hedendaagse klanklandschappen die transformeren in klassieke meesterwerken. De internationaal gevierde pianiste en klaveciniste Tamar Halperin betreedt het DAS HAUS-podium voor de wereldpremi\u00e8re van Ground: Toccata\u2019s & Ambients- een concert dat uitdaagt, verrast en inspireert.\nStel je de rijke ritmes, vormen en technieken van beroemde componisten als Bach, Frescobaldi, Purcell, Satie en Cage voor, ontmanteld en noot voor noot opnieuw opgebouwd, verweven met hedendaagse minimalistische harmonie\u00ebn en jazz-ge\u00efnspireerde patronen. Tamar's \"werf\"-composities\u2014vol dissonanties, atonaal geflirt en geleidelijke onthullingen van het orgineel\u2014nemen je mee op een auditieve reis waar het bekende een ontdekking wordt.\nTerwijl Tamar meesterlijk het klavecimbel, de piano en het elektronische keyboard bespeelt, wordt ze vergezeld door de elektronische geluidskunstenaar Doron Segal. Samen cre\u00ebren ze een meeslepende muzikale weefstructuur die de luisteraars uitnodigt om door eeuwen en stijlen te zigzaggen. Hun energieke improvisaties verleggen de grenzen tussen traditie en innovatie en onthullen de verbindingen die tijd en genres overbruggen.\nKlaviervirtuoos Tamar Halperin staat bekend om haar genre-overstijgende optredens en composities. Met innovatieve technieken geeft ze klassieke muziek een moderne interpretatie. Haar onderscheidingen omvatten prijzen voor haar klassieke piano performances, meesterschap in barok clavecimbelspel, multi-keyboard jazzmuziek en de prestigieuze Hessische Cultuurprijs voor het bouwen van culturele bruggen. Tamar's werk wordt gedreven door haar liefde voor klassieke muziek en haar missie om deze relevant te maken voor de hedendaagse wereld.\nJazzpianist, componist en elektronisch muzikant Doron Segal voegt een soulvolle, onderzoekende dimensie toe aan deze voorstelling. Met wortels in klassieke training en een carri\u00e8re die zich uitstrekt van Isra\u00eblische conservatoria tot de bruisende muzieksc\u00e8ne van Berlijn, heeft Doron samengewerkt met een diverse reeks internationale artiesten, wat diepgang en textuur toevoegt aan elk project.\nDeze DAS HAUS-avond laat de harmonie uit vervlogen eeuwen op een funky, minimalistische en dromerige manier tot leven komen.","performers":"Tamar Halperin (piano, klavecimbel, elektronische keyboard); Doron Segal (elektronische geluid)","boxoffice_url":null,"website":"https:\/\/www.dashaus.be\/events\/ground","email":"dashausmuzik@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700004463"}},"place":{"id":277267,"translations":{"de":{"name":"Palazzo","address_street_name":"Th\u00e9odore Verhaegenstraat ","address_street_number":"190","address_street_box":null,"email":null,"website":null,"phone_co