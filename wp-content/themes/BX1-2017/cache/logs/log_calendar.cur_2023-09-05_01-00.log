une","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.uccle.be","email":"culture@uccle.brussels","phone_contact":"+32 2 605 15 30","phone_booking":"+32 2 605 15 30","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.559801"},"it":{"name":"Heritage Walks - Uccle Centre, berceau de la Commune","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.uccle.be","email":"culture@uccle.brussels","phone_contact":"+32 2 605 15 30","phone_booking":"+32 2 605 15 30","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.559801"},"cn":{"name":"Heritage Walks - Uccle Centre, berceau de la Commune","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.uccle.be","email":"culture@uccle.brussels","phone_contact":"+32 2 605 15 30","phone_booking":"+32 2 605 15 30","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.559801"},"fr":{"name":"Heritage Walks - Uccle Centre, berceau de la Commune","shortdescr":"Le Parvis Saint-Pierre est \u00e0 l\u2019origine de l\u2019existence de la commune. Depuis le Xiie si\u00e8cle, le hameau autour de l\u2019\u00e9glise s\u2019est d\u00e9velopp\u00e9 pour accueillir les diff\u00e9rentes institutions n\u00e9cessaires au fonctionnement de la commune.","longdescr":"Le Parvis Saint-Pierre est \u00e0 l\u2019origine de l\u2019existence de la commune. Depuis le Xiie si\u00e8cle, le hameau autour de l\u2019\u00e9glise s\u2019est d\u00e9velopp\u00e9 pour accueillir les diff\u00e9rentes institutions n\u00e9cessaires au fonctionnement de la commune. Par la suite, de l\u2019autre c\u00f4t\u00e9 de la chauss\u00e9e d\u2019Alsemberg, la place Vander Elst est a accueilli la Maison communale et un remarquable ensemble de maisons \u00e9clectiques. Les rues voisines r\u00e9servent quelques surprises.\r\n\r\nUne visite de Rdv Culturels, dans le cadre des Heritage Walks 2023 du Service de la Culture de la Commune d'Uccle.\r\n\r\nR\u00e9servation obligatoire :\r\nMail : culture@uccle.brussels\r\nTel : 02 605 15 30\r\nLe point de rendez-vous vous sera communiqu\u00e9 une fois que votre inscription sera confirm\u00e9e.","performers":"RDV Culturels\r\nService de la Culture de la Commune d'Uccle","boxoffice_url":null,"website":"http:\/\/www.uccle.be","email":"culture@uccle.brussels","phone_contact":"+32 2 605 15 30","phone_booking":"+32 2 605 15 30","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.559801"},"sp":{"name":"Heritage Walks - Uccle Centre, berceau de la Commune","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.uccle.be","email":"culture@uccle.brussels","phone_contact":"+32 2 605 15 30","phone_booking":"+32 2 605 15 30","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.559801"},"nl":{"name":"Heritage Walks - Uccle Centre, berceau de la Commune","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.uccle.be","email":"culture@uccle.brussels","phone_contact":"+32 2 605 15 30","phone_booking":"+32 2 605 15 30","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.559801"}},"place":{"id":259695,"translations":{"de":{"name":"Uccle Centre","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Uccle Centre","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Uccle Centre","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Uccle Centre","address_line2":"1180 Uccle"