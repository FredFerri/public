is_canceled":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-08-23T19:05:07+02:00","published_at":"2022-08-21T18:00:15+02:00","backoffice_id":260084,"import_origin":"muntpunt","sub_type":"other","show_in_agenda":true,"ranking":1},{"id":539484,"date_start":"2022-09-26","date_end":"2022-09-28","date_next":"2022-09-27","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":84,"translations":{"fr":"Divers","nl":"Varia","en":"Various"}},"others":{"list":[89],"translations":{"fr":["Litt\u00e9rature"],"nl":["Literatuur"],"en":["Litterature "]}}},"languages":{"spoken":["en","fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Festival de po\u00e9sie - Transpoesie 2022","shortdescr":"Transpoesie 2022 vous emm\u00e8ne pour la douzi\u00e8me fois cons\u00e9cutive faire un tour \u00e0 Bruxelles pour d\u00e9couvrir la diversit\u00e9 linguistique europ\u00e9enne \u00e0 travers la po\u00e9sie.","longdescr":"Le festival Transpoesie a pour but de c\u00e9l\u00e9brer la diversit\u00e9 linguistique europ\u00e9enne \u00e0 travers la po\u00e9sie. Lanc\u00e9 par le cluster EUNIC Brussels, ce festival fait partie de l'espace culturel de Bruxelles depuis maintenant 12 ans. Il commence tous les ans le 26 septembre, marquant ainsi la journ\u00e9e europ\u00e9enne des langues.\r\n\r\nCette ann\u00e9e, les organisateurs du festival ont d\u00e9cid\u00e9 de se concentrer sur deux th\u00e9matiques: \"L'ann\u00e9e europ\u00e9enne de la jeunesse\" et \"Po\u00e8tes de l'Europe noire\".\r\nLes artistes intervenant sur l'ann\u00e9e europ\u00e9enne de la jeunesse se produiront le premier jour (26 septembre 2022) au Jardin des Citoyens (Parlement Europ\u00e9en) et le second jour (27 septembre 2022) \u00e0 l'Institut culturel Italien de Bruxelles. Ils aborderont des sujets tels que la sant\u00e9 mentale, l'identit\u00e9, les voyages, les racines...\r\nL'\u00e9v\u00e9nement \"Po\u00e8tes de l'Europe Noire\" aura lieu le dernier jour (28 septembre 2022) \u00e0 Bozar. Cinq autrices et auteurs ayant particip\u00e9 \u00e0 l'anthologie de po\u00e9sie \"Kontinentaldrift. Das Schwarze Europa\" de l'auteur Fiston Mwanza Mujila seront mis \u00e0 l'honneur.\r\n\r\nPour plus d'informations, suivez-nous sur les r\u00e9seaux!\r\nFacebook \/ Instagram: @Transpoesie","performers":"Po\u00e8tes: Fiston Mwanza Mujila; Radna Fabias; Roger Robinson; Raquel Lima; Ubah Crisitina Ali Farah; Lemu\u00ebl de Graav; Dania O. Tausen; Iona Lee; Grug Muse; Sytse Jansma; Ieva Toleikyte; Anastasia Gavrilovici; Ana Svetel; Zuzanna Bartoszek; Beatriz Chivite; Dawn Watson; Veronika Gyengeov\u00e1; Abraham Guerrero Tenorio; Nini Eliashvili","boxoffice_url":null,"website":"http:\/\/www.transpoesie.eu\/","email":"eunicinbrussels@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.539484"},"nl":{"name":"Po\u00ebziefestival - Transpoesie 2022","shortdescr":"Transpoesie 2022 neemt u voor de twaalfde keer op rij mee voor een rondje Brussel om de Europese taaldiversiteit te ontdekken aan de hand van po\u00ebzie.","longdescr":"Het Transpoesie-festival wil de Europese taalverscheidenheid vieren door middel van po\u00ebzie. Het festival werd opgestart door de Brusselse cluster EUNIC en maakt nu al 12 jaar deel uit van de Brusselse culturele sc\u00e8ne. Het begint elk jaar op 26 september en markeert de Europese Dag van de Talen.\r\n\r\nDit jaar hebben de organisatoren van het festival besloten zich op twee thema's te concentreren: \"Het Europees jaar van de jeugd\" en \"Dichters van zwart Europa\".\r\nDe artiesten van het Europees Jaar van de jeugd zullen op de eerste dag (26 september 2022) optreden in de Burgertuin (Europees Parlement) en op de tweede dag (27 september 2022) in het Italiaans Cultureel Instituut in Brussel. Ze zullen onderwerpen aansnijden als geestelijke gezondheid, identiteit, reizen, wortels...\r\nHet evenement \"Dichters van zwart Europa\" vindt plaats op de laatste dag (28 september 2022) in Bozar. Vijf auteurs die meewerkten aan de po\u00ebziebloemlezing \"Kontinentaldrift. Das Schwarze Europa\" van de auteur Fiston Mwanza Mujila zal worden ge\u00eberd.\r\n\r\nVoor meer informatie, volg ons op:\r\nFacebook \/ Instagram: @Transpoesie","performers":"Dichters: Fiston Mwanza Mujila; Radna Fabias; Roger Robinson; Raquel Lima; Ubah Crisitina Ali Farah; Lemu\u00ebl de Graav; Dania O. Tausen; Iona Lee; Grug Muse; Sytse Jansma; Ieva Toleikyte; Anastasia Gavrilovici; Ana Svetel; Zuzanna Bartoszek; Beatriz Chivite; Dawn Watson; Veronika Gyengeov\u00e1; Abraham Guerrero Tenorio; Nini Eliashvili","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.539484"},"en":{"name":"Poetry festival - Transpoesie 2022","shortdescr":"Transpoesie 2022 takes you for the twelfth time in a row for a round in Brussels to discover the European linguistic diversity through poetry.","longdescr":"The Transpoesie festival aims to celebrate European linguistic diversity through poetry. Launched by the EUNIC Brussels cluster, the festival has been part of the Brussels cultural scene for 12 years now. It starts every year on 26 September, marking the European Day of Languages.\r\n\r\nThis year, the festival organisers have decided to focus on two themes: \"The European Year of Youth\" and \"Poets from Black Europe\".\r\nThe European Year of Youth artists will perform on the first day (26 September 2022) in the Citizens' Garden (European Parliament) and on the second day (27 September 2022) in the Italian Cultural Institute in Brussels. They will address topics such as mental health, identity, travel, roots...\r\nThe \"Poets from Black Europe\" event will take place on the last day (28 September 2022) at Bozar. Five authors who participated in the poetry anthology \"Kontinentaldrift. Das Schwarze Europa\" by the author Fiston Mwanza Mujila will be at the heart of the event.\r\n\r\nFor more information, follow us on:\r\nFacebook \/ Instagram: @Transpoesie","performers":"Poets: Fiston Mwanza Mujila; Radna Fabias; Roger Robinson; Raquel Lima; Ubah Crisitina Ali Farah; Lemu\u00ebl de Graav; Dania O. Tausen; Iona Lee; Grug Muse; Sytse Jansma; Ieva Toleikyte; Anastasia Gavrilovici; Ana Svetel; Zuzanna Bartoszek; Beatriz Chivite; Dawn Watson; Veronika Gyengeov\u00e1; Abraham Guerrero Tenorio; Nini Eliashvili","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.539484"},"de":{"name":"Transpoesie 2022","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.539484"},"it":{"name":"Transpoesie 2022","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.539484"},"sp":{"name":"Transpoesie 2022","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.539484"},"pt":{"name":"Transpoesie 2022","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda