ten en steegjes van Brussel en tonen ze je de stad zoals zij die kennen, zoals zij ervan houden.\n\nStadslegendes, sociale strubbelingen, misdaadsc\u00e8nes, Art Nouveau of andere thema's, ga met ze mee en ontdek Brussel zoals je het nog nooit hebt gezien!\n\nDe rondleidingen zijn beschikbaar op inschrijving via de website, maar op verzoek kunnen er ook priv\u00e9rondleidingen voor groepen worden geregeld. Als onderdeel van deze priv\u00e9-ervaringen kunt u de rondleiding combineren met een chocoladeproeverij, een goed gebrouwen aperitief of een maaltijd in een authentiek Brussels etablissement.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":41819,"location":{"lat":50.8477202,"lon":4.3548659},"last_updated_at":"2024-10-16T12:31:41+02:00","published_at":"2024-01-20T21:02:59+01:00","is_in_address_book":true,"is_in_vb_export":false,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/a67a0cc4f8c2cb5c2d6ccfbc8bc4f2aae0f90022.jpg","width":992,"height":744,"ratio":1.33,"oEmbed_height":744,"oEmbed_width":992,"translations":{"de":{"title":"Art Nouveau dans le Quartier des Squares","copyright":null},"pt":{"title":"Art Nouveau dans le Quartier des Squares","copyright":null},"en":{"title":"Art Nouveau dans le Quartier des Squares","copyright":null},"it":{"title":"Art Nouveau dans le Quartier des Squares","copyright":null},"cn":{"title":"Art Nouveau dans le Quartier des Squares","copyright":null},"fr":{"title":"Art Nouveau dans le Quartier des Squares","copyright":null},"sp":{"title":"Art Nouveau dans le Quartier des Squares","copyright":null},"nl":{"title":"Art Nouveau dans le Quartier des Squares","copyright":null}}},{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/6768e753e54694fc4e258365bbe66c0c6a3ab9b8.jpg","width":1440,"height":1920,"ratio":0.75,"oEmbed_height":192