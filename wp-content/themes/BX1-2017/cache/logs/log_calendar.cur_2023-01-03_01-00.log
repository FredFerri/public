_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater","it":null,"sp":null,"pt":null,"cn":null}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"],"de":["Theater"],"it":[null],"sp":[null],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"La mer","shortdescr":"D\u00e9couvrant ce bout de jardin, ce no man's\u2019 land entre abandon et paradis, les spectateur\u00b7rice\u00b7s deviennent comme Alice dans son pays des merveilles, se disant : Est-ce moi qui ai rapetiss\u00e9 ou est-ce le lieu qui a grandi ?","longdescr":"Et l\u00e0 o\u00f9 les enfants de 3 ans et plus verront un monde de grand\u00b7e\u00b7s \u2013 mais \u00e7a iels en ont l\u2019habitude, les adultes se trouveront \u00ab \u00e0 hauteur \u00bb d\u2019enfant pour entrevoir un instant, en une petite fulgurance, la rencontre inattendue entre un personnage de pl\u00e2tre, gardien du lieu, respirant la sagesse na\u00efve, et un voyageur, transportant son enthousiasme teint\u00e9 de maladresse.\r\nDe ce t\u00eate-\u00e0-t\u00eate dans un jardin redevenu sauvage, de cet improbable t\u00e9lescopage, apr\u00e8s l\u2019effroi, apr\u00e8s la d\u00e9couverte, na\u00eetra une amiti\u00e9 menant l\u2019aventure jusqu\u2019\u00e0 d\u00e9couvrir d\u2019entre les pots de fleurs ; les vagues, les temp\u00eates, les \u00eeles et ce que leur imagination fait de mieux : La mer.\r\n\r\n\u00c0 partir de 4 ans.","performers":"Cr\u00e9ation collective| Mise en sc\u00e8ne: Pierre Richards| Musique: Philippe Morino |R\u00e9gie: Luc Jouniaux, Serge Bodart|Photographies: Antoinette Chaudron| Graphisme: Karl Autrique| Diffusion: Mademoiselle Jeanne |Com\u00e9diens: Yann-Ga\u00ebl Monfort, Philippe L\u00e9onard|Eclairages: Luc Jouniaux|R\u00e9alisation d\u00e9cors: Guy Carbonnelle - Quai 41","boxoffice_url":null,"website":"http:\/\/www.pierredelune.be","email":"info@wolubilis.be","phone_contact":"+32 2 761 60 30","phone_booking":"+32 2 218 79 35","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.542659"},"nl":{"name":"La mer","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wolubilis.be","email":"contact@pierredelune.be","phone_contact":"+32 2 218 79 35","phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.542659"},"en":{"name":"La mer","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.542659"},"de":{"name":"La mer","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.542659"},"it":{"name":"La mer","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.542659"},"sp":{"name":"La mer","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.542659"},"pt":{"name":"La mer","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.542659"},"cn":{"name":"La mer","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null