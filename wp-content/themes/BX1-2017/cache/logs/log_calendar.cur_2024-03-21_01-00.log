_city":"Brussels","address_line1":"Wetstraat, 3","address_line2":"1000 Brussels","description_web":"The Th\u00e9\u00e2tre Royal du Parc is a theater built in 1782 on the edge of the Warandepark, in addition to the successful Vaux-Hall on the same site. After a turbulent history among the various occupiers, the theater today distinguishes itself by a program that alters classic and contemporary French-language creations, with a clear preference for comedy.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Th\u00e9\u00e2tre Royal du Parc","address_street_name":"Rue de la Loi","address_street_number":"3","address_street_box":null,"email":"info@theatreduparc.be","website":"http:\/\/www.theatreduparc.be","phone_contact":null,"phone_booking":"+32 2 505 30 30","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Loi, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Th\u00e9\u00e2tre Royal du Parc","address_street_name":"Rue de la Loi","address_street_number":"3","address_street_box":null,"email":"info@theatreduparc.be","website":"http:\/\/www.theatreduparc.be","phone_contact":null,"phone_booking":"+32 2 505 30 30","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Loi, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Th\u00e9\u00e2tre Royal du Parc","address_street_name":"Rue de la Loi","address_street_number":"3","address_street_box":null,"email":"info@theatreduparc.be","website":"http:\/\/www.theatreduparc.be","phone_contact":null,"phone_booking":"+32 2 505 30 30","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Loi, 3","address_line2":"1000 Bruxelles","description_web":"En 1782, les fr\u00e8res Bultos firent construire au Parc de Bruxelles un Vaux-Hall \u00e0 l'instar de ce qui se faisait alors avec succ\u00e8s \u00e0 Paris et \u00e0 Londres. Le public prit rapidement le chemin de ce carrefour consacr\u00e9 aux divertissements et encourag\u00e9s par ce succ\u00e8s, ils doubl\u00e8rent leur \u00e9tablissement d'un th\u00e9\u00e2tre. Apr\u00e8s une longue et turbulente histoire sous les diff\u00e9rentes occupation, le \"Parc\" se singularise  actuellement par un programme o\u00f9 alternent les classiques et les cr\u00e9ations contemporaines, dans des mises en sc\u00e8ne \u00e0 grand spectacle et en privil\u00e9giant les com\u00e9dies. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Th\u00e9\u00e2tre Royal du Parc","address_street_name":"Rue de la Loi","address_street_number":"3","address_street_box":null,"email":"info@theatreduparc.be","website":"http:\/\/www.theatreduparc.be","phone_contact":null,"phone_booking":"+32 2 505 30 30","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Loi, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Th\u00e9\u00e2tre Royal du Parc","address_street_name":"Wetstraat","address_street_number":"3","address_street_box":null,"email":"info@theatreduparc.be","website":"http:\/\/www.theatreduparc.be","phone_contact":null,"phone_booking":"+32 2 505 30 30","address_zip":"1000","address_city":"Brussel","address_line1":"Wetstraat, 3","address_line2":"1000 Brussel","description_web":"Het Th\u00e9\u00e2tre Royal du Parc is een schouwburg die in 1782 aan de rand van het Warandepark gebouwd werd als aanvulling van de eerder gebouwde succesvolle Vaux-Hall op dezelfde site. Na een woelige geschiedenis onder de diverse bezetters onderscheidt het theater zich vandaag de dag door een programmatie die klassieke en hedendaagse Franstalige creaties wisselt, met een duidelijke voorkeur voor comedie.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":86,"location":{"lat":50.8457665,"lon":4.3656493},"last_updated_at":"2023-10-25T09:28:08+02:00","published_at":"2013-10-19T01:13:16+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/7c658c1ade184fcb8c789ab690eda7038a0af337.jpg","width":768,"height":1111,"ratio":0,"oEmbed_height":1111,"oEmbed_width":768,"translations":{"de":{"title":"Le Misanthrope ","copyright":null},"pt":{"title":"Le Misanthrope ","copyright":null},"en":{"title":"Le Misanthrope ","copyright":null},"it":{"title":"Le Misanthrope ","copyright":null},"cn":{"title":"Le Misanthrope ","copyright":null},"fr":{"title":"Le Misanthrope ","copyright":null},"sp":{"title":"Le Misanthrope ","copyright":null},"nl":{"title":"Le Misanthrope ","copyright":null}}}],"dates":[{"day":"2024-03-07","doors":null,"start":"19:00:00","end":"23:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-03-08","doors":null,"start":"19:00:00","end":"23:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-03-09","doors":null,"start":"19:00:00","end":"23:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-03-10","doors":null,"start":"14:00:00","end":"18:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-03-12","doors":null,"start":"19:00:00","end":"23:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-03-13","doors":null,"start":"19:00:00","end":"23:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-03-14","doors":null,"start":"19:00:00","end":"23:00:00","end_night_life":null,"is_soldout":fal