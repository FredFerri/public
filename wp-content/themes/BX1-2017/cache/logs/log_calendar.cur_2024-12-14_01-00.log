enda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700004531"},"en":{"name":"Visites guid\u00e9es de l'Atelier du Faux","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/wittockiana.org\/visites-guidees-atelier-du-faux\/","email":"info@wittockiana.org","phone_contact":"+32 2 770 53 33","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700004531"},"it":{"name":"Visites guid\u00e9es de l'Atelier du Faux","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/wittockiana.org\/visites-guidees-atelier-du-faux\/","email":"info@wittockiana.org","phone_contact":"+32 2 770 53 33","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700004531"},"cn":{"name":"Visites guid\u00e9es de l'Atelier du Faux","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/wittockiana.org\/visites-guidees-atelier-du-faux\/","email":"info@wittockiana.org","phone_contact":"+32 2 770 53 33","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700004531"},"fr":{"name":"Visites guid\u00e9es de l'Atelier du Faux","shortdescr":"Chaque samedi \u00e0 14:30, la Wittockiana vous offre une visite guid\u00e9e \u00e0 prix r\u00e9duit de l'exposition 'L'Atelier du Faux'  ! \nFalsifications, plagiats et canulars vous plongeront dans des univers insoup\u00e7onn\u00e9s. On vous attend ! \nLe prix est de 5\u20ac + prix d'entr\u00e9e.\n\n","longdescr":"Connaissez-vous l\u2019histoire du faux Le Soir du 1943, cas de r\u00e9sistance \u00e9ditoriale en plein milieu de la Seconde Guerre Mondiale ?\nSaviez-vous que les canulars et les fake news n\u2019ont pas attendu les r\u00e9seaux sociaux pour se propager ?\nEt comme tout le monde, vous vous \u00eates certainement d\u00e9j\u00e0 pos\u00e9 la question de la place \u00e0 la cr\u00e9ativit\u00e9 \u00e0 l\u2019\u00e9poque de l\u2019intelligence artificielle\u2026\nPour en savoir plus encore, suivez nos visites guid\u00e9es de l\u2019Atelier du Faux, chaque samedi \u00e0 14:30. Le prix est de 5\u20ac + prix d'entr\u00e9e.\n","performers":null,"boxoffice_url":null,"website":"https:\/\/wittockiana.org\/visites-guidees-atelier-du-faux\/","email":"info@wittockiana.org","phone_contact":"+32 2 770 53 33","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700004531"},"sp":{"name":"Visites guid\u00e9es de l'Atelier du Faux","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/wittockiana.org\/visites-guidees-atelier-du-faux\/","email":"info@wittockiana.org","phone_contact":"+32 2 770 53 33","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700004531"},"nl":{"name":"Visites guid\u00e9es de l'Atelier du Faux","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/wittockiana.org\/visites-guidees-atelier-du-faux\/","email":"info@wittockiana.org","phone_contact":"+32 2 770 53 33","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700004531"}},"place":{"id":142,"translations":{"de":{"name":"Wittockiana: Msueum f\u00fcr Buch- und Buchbindekunst","address_street_name":"Rue du Bemel","address_street_number":"23","address_street_box":null,"email":"info@wittockiana.org","website":"http:\/\/www.wittockiana.org","phone_contact":"+32 2 770 53 33","phone_booking":null,"address_zip":"1150","address_city":"Woluwe-Saint-Pierre","address_line1":"Rue du Bemel, 23","address_line2":"1150 Woluwe-Saint-Pierre","description_web":"Die Wittockiana wurde 1983 von dem renommierten Buchkenners Michel Wittock gegr\u00fcndet und ist sowohl Buchmuseum als auch Bibliothek und Archiv f\u00fcr kostbare historische, moderne und zeitgen\u00f6ssische B\u00fccher.","description_print"