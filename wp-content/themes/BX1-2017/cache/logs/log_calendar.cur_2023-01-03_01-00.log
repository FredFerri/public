","end":"21:00:00","is_only_by_appointment":false},"tags":["kids"],"accessibilities":{"list":[255,261,263,265],"translations":{"fr":["Accessible","Parking accessible","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9"],"nl":["Toegankelijk","Toegankelijke parking","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet"],"en":["Accessible","Accessible parking","Accessible to pedestrians with mobility aids","Adapted toilet"],"de":["Barrierefrei","Barrierefreier Parkplatz","Barrierefrei f\u00fcr Fu\u00dfg\u00e4nger mit Gehhilfe","Barrierefreies WC"],"it":[null,null,null,null],"sp":[null,null,null,null],"pt":[null,null,null,null],"cn":[null,null,null,null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2023-01-02T01:35:44+01:00","published_at":"2022-11-15T15:49:28+01:00","backoffice_id":265641,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.39280048793632},{"id":547447,"date_start":"2022-12-21","date_end":"2023-01-14","date_next":"2023-01-04","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung","it":null,"sp":null,"pt":null,"cn":null}},"others":{"list":[36,45],"translations":{"fr":["Mus\u00e9es et art centers","Mode"],"nl":["Musea en kunstcentra","Mode"],"en":["Museums and art centers","Fashion"],"de":["Museen & Kunstzentren","Mode"],"it":[null,null],"sp":[null,null],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Ukrainian Fashion and Art Week","shortdescr":"Des stylistes Ukrainiennes pr\u00e9senteront leurs collections de v\u00eatements ce mercredi 21 d\u00e9cembre 2022 \u00e0 18h30 lors d'un d\u00e9fil\u00e9 de mode.\r\n\r\nDes tableaux de plusieurs artistes Ukrainiens seront \u00e9galement expos\u00e9s ainsi que des c\u00e9ramiques peintes de Kosiv (inscrites sur la liste du patrimoine culturel immat\u00e9riel de l'UNESCO).","longdescr":"Deux stylistes Ukrainiennes de haut vol originaires d'Ivano-Frankivsk pr\u00e9senteront leurs collections de v\u00eatements aux motifs \u00e9thiques. Un d\u00e9fil\u00e9 de mode aura lieu ce mercredi 21 d\u00e9cembre 2022 \u00e0 18h30.\r\n\r\nDes tableaux de plusieurs artistes Ukrainiens seront \u00e9galement expos\u00e9s pendant toute la dur\u00e9e de l'\u00e9v\u00e8nement, ainsi que des c\u00e9ramiques peintes de Kosiv (inscrites sur la liste du patrimoine culturel immat\u00e9riel de l'UNESCO).\r\n\r\n D\u00e8s le 28 d\u00e9cembre 2022, deux nouveaux artistes Ukrainiens exposeront leurs \u0153uvres : Wladzia Hrechkosii & Dana Yakymchuk (plus d'infos prochainement). \r\nDeux ateliers vous permettant de mieux appr\u00e9hender les techniques artistiques traditionnelles Ukrainiennes seront \u00e9galement organis\u00e9s le 29 d\u00e9cembre 2022 et le 4 janvier 2023.","performers":"Cet \u00e9v\u00e8nement a \u00e9t\u00e9 mis sur pieds par Oksana kovalchuk (Sarmatia) avec l\u2019appui de Promote Ukraine.\r\nNoms des artistes : Lyubov  Chernikova (styliste), Oksana Beylakh (styliste et artiste peintre), Wladzia Hrechkosii (peintre), Dana Yakymchuk (peintre), Marta Pitchuk (peintre), Mykhailo Deinega (peintre) et Michael Jiliak (peintre)","boxoffice_url":null,"website":"https:\/\/www.montdepiete.be\/ukrainian-fashion-and-art-week","email":"info@montdepiete.be","phone_contact":"+32 2 512 13 85","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.547447"},"nl":{"name":"Ukrainian Fashion and Art Week","shortdescr":"Oekra\u00efense ontwerpsters presenteren hun kleding collecties. Een modeshow zal plaatsvinden op woensdag 21 december 2022 om 18u30.\r\nSchilderijen van verschillende Oekra\u00efense kunstenaars zullen worden tentoongesteld, evenals beschilderde keramiek uit Kosiv (opgenomen in UNESCO's lijst van immaterieel cultureel erfgoed).","longdescr":"Twee Oekra\u00efense topontwerpsters uit Ivano-Frankivsk presenteren hun kleding collectie s met etnische motieven. Een modeshow zal plaatsvinden op woensdag 21 december 2022 om 18u30.\r\nTijdens het evenement zullen ook schilderijen van verschillende Oekra\u00efense kunstenaars te zien zijn, evenals beschilderde keramiek uit Kosiv (opgenomen in UNESCO's lijst van immaterieel cultureel erfgoed).\r\nVanaf 28 december 2022 zullen twee nieuwe Oekra\u00efense kunstenaars hun werken tentoonstellen: Wladzia Hrechkosii & Dana Yakymchuk (meer info binnenkort).\r\nOp 29 december 2022 en op 4 januari 2023 worden ook twee workshops georganiseerd om meer te weten te komen over traditioneel Oekra\u00efense artistieke technieken.","performers":"Dit evenement is opgezet door Oksana kovalchuk (Sarmatia) met de steun van Promote Ukraine.\r\nNamen van de kunstenaars: Lyubov Chernikova (styliste), Oksana Beylakh (styliste en kunstenares), Wladzia Hrechkosii (kunstenaar), Dana Yakymchuk (kunstenaar), Marta Pitchuk (kunstenares), Mykhailo Deinega (kunstenaar) en Michael Jiliak (kunstenaar).","boxoffice_url":null,"website":"https:\/\/www.bergvanbarmhartigheid.be\/nl\/ukrainian-fashion-and-art-week","email":"info@montdepiete.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.547447"},"en":{"name":"Ukrainian Fashion and Art Week","shortdescr":"Ukrainian fashion designers will present their collections of clothes. A fashion show will take place on 21th of December from 6.30 PM.\r\nPaintings by a few Ukrainian artists will be displayed together with Kosiv painted ceramics (inscribed in the UNESCO Intangible Cultural Heritage Lists).","longdescr":null,"performers":"This event was set up by Oksana kovalchuk (Sarmatia) with the support of Promote Ukraine.\r\nNames of the artists: Lyubov Chernikova (stylist), Oksana Beylakh (stylist and painter), Wladzia Hrechkosii (painter),Dana Yakymchuk (painter), Marta Pitchuk (painter), Mykhailo Deinega (painter) and Michael Jiliak (painter)","boxoffice_url":null,"website":null,"email":"info@montdepiete.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.547447"},"de":{"name":"Ukrainian Fashion and Art Week","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.547447"},"it":{"name":"Ukrainian Fashion and Art Week","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.547447"},"sp":{"name":"Ukrainian Fashion and Art Week","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.547447"},"pt":{"name":"Ukrainian Fashion and Art Week","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.547447"},"cn":{"name":"Ukrainian Fashion and Art Week","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.547447"}},"place":{"id":221323,"translations":{"fr":{"name":"Mont de Pi\u00e9t\u00e9 (Caisse Publique de Pr\u00eats)","address_street_name":"Rue Saint-Ghislain","address_street_number":"1923","address_street_bo