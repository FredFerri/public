,"published_at":"2025-01-02T11:56:13+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":315468,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"theatre","ranking":0.18616131324212123,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":49,"translations":{"de":"Theater","pt":null,"en":"Theatre","it":"Teatro","cn":null,"fr":"Th\u00e9\u00e2tre","sp":"Teatro","nl":"Theater"}},"others":{"list":[52],"translations":{"de":["Musiktheater"],"pt":[null],"en":["Musical theatre"],"it":["Teatro musicale"],"cn":[null],"fr":["Th\u00e9\u00e2tre musical"],"sp":["Teatro musical"],"nl":["Muziektheater"]}}},"translations":{"de":{"name":"Bruxelles Avenue - la Com\u00e9die Musicale Improvis\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.facebook.com\/compagniecrescendo\/","email":"clembree@protonmail.com","phone_contact":null,"phone_booking":"+32 473 81 53 45","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700005018"},"pt":{"name":"Bruxelles Avenue - la Com\u00e9die Musicale Improvis\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.facebook.com\/compagniecrescendo\/","email":"clembree@protonmail.com","phone_contact":null,"phone_booking":"+32 473 81 53 45","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700005018"},"en":{"name":"Bruxelles Avenue - la Com\u00e9die Musicale Improvis\u00e9e","shortdescr":"Bruxelles Avenue : une com\u00e9die musicale totalement improvis\u00e9e !\n\nPr\u00e9parez-vous \u00e0 vivre un moment unique ! Avec Bruxelles Avenue, la compagnie Crescendo vous embarque dans une aventure musicale o\u00f9 tout \u2013 des chansons aux chor\u00e9graphies en passant par l\u2019histoire \u2013 est invent\u00e9 en direct. \n","longdescr":"Sur sc\u00e8ne, cinq com\u00e9diens et deux musiciens se lancent avec brio sur les arp\u00e8ges de la surprise, les notes de l\u2019\u00e9motion, et les harmonies inattendues. \nPendant 1h15, vous serez t\u00e9moin d'une v\u00e9ritable com\u00e9die musicale improvis\u00e9e, \u00e0 la mani\u00e8re de Broadway, m\u00ealant musique, chant, danse, et th\u00e9\u00e2tre pour des histoires aussi extraordinaires que sinc\u00e8res.\n\nLe public choisit ! Vous d\u00e9cidez du lieu, du h\u00e9ros ou de l'h\u00e9ro\u00efne et de son r\u00eave, et nos artistes improvisent son histoire sous vos yeux, avec humour, \u00e9nergie, et \u00e9motion. Que ce soit dr\u00f4le, touchant ou surprenant, chaque spectacle est un moment inoubliable !\n\nRires, musique, tendresse et \u00e9motions garantis ! Venez passer une soir\u00e9e magique en notre compagnie, et laissez-vous surprendre par la spontan\u00e9it\u00e9 et la cr\u00e9ativit\u00e9 d'une com\u00e9die musicale 100 % improvis\u00e9e !\n\nNe manquez pas ce rendez-vous exceptionnel !\n","performers":"Com\u00e9dien.ne.s : Amandine Everaert, Adrien Hoppe, Jesica de Salvador, Catherine Lembr\u00e9e, Paul Simon, Hugo Mezine, Sullyvan G\u00e9rard, Gabrielle de Patoul, Sophie Oyas, Sacha Lochet, Alexandra Ducoux, Sarah Maystadt\n\nMusiciens : Christian Verlent (batterie), Michel Desbois (piano)","boxoffice_url":null,"website":"https:\/\/www.facebook.com\/compagniecrescendo\/","email":"clembree@protonmail.com","phone_contact":null,"phone_booking":"+32 473 81 53 45","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700005018"},"it":{"name":"Bruxelles Avenue - la Com\u00e9die Musicale Improvis\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.facebook.com\/compagniecrescendo\/","email":"clembree@protonmail.com","phone_contact":null,"phone_booking":"+32 473 81 53 45","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700005018"},"cn":{"name":"Bruxelles Avenue - la Com\u00e9die Musicale Improvis\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.facebook.com\/compagniecrescendo\/","email":"clembree@protonmail.com","phone_contact":null,"phone_booking":"+32 473 81 53 45","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700005018"},"fr":{"name":"Bruxelles Avenue - la Com\u00e9die Musicale Improvis\u00e9e","shortdescr":"Bruxelles Avenue : une com\u00e9die musicale totalement improvis\u00e9e !\n\nPr\u00e9parez-vous \u00e0 vivre un moment unique ! Avec Bruxelles Avenue, la compagnie Crescendo vous embarque dans une aventure musicale o\u00f9 tout \u2013 des chansons aux chor\u00e9graphies en passant par l\u2019histoire \u2013 est invent\u00e9 en direct. \n","longdescr":"Sur sc\u00e8ne, cinq com\u00e9diens et deux musiciens se lancent avec brio sur les arp\u00e8ges de la surprise, les notes de l\u2019\u00e9motion, et les harmonies inattendues. \nPendant 1h15, vous serez t\u00e9moin d'une v\u00e9ritable com\u00e9die musicale improvis\u00e9e, \u00e0 la mani\u00e8re de Broadway, m\u00ealant musique, chant, danse, et th\u00e9\u00e2tre pour des histoires aussi extraordinaires que sinc\u00e8res.\n\nLe public choisit ! Vous d\u00e9cidez du lieu, du h\u00e9ros ou de l'h\u00e9ro\u00efne et de son r\u00eave, et nos artistes improvisent son histoire sous vos yeux, avec humour, \u00e9nergie, et \u00e9motion. Que ce soit dr\u00f4le, touchant ou surprenant, chaque spectacle est un moment inoubliable !\n\nRires, musique, tendresse et \u00e9motions garantis ! Venez passer une soir\u00e9e magique en notre compagnie, et laissez-vous surprendre par la spontan\u00e9it\u00e9 et la cr\u00e9ativit\u00e9 d'une com\u00e9die musicale 100 % improvis\u00e9e !\n\nNe manquez pas ce rendez-vous exceptionnel !\n","performers":"Com\u00e9dien.ne.s : Amandine Everaert, Adrien Hoppe, Jesica de Salvador, Catherine Lembr\u00e9e, Paul Simon, Hugo Mezine, Sullyvan G\u00e9rard, Gabrielle de Patoul, Sophie Oyas, Sacha Lochet, Alexandra Ducoux, Sarah Maystadt\n\nMusiciens : Christian Verlent (batterie), Michel Desbois (piano)","boxoffice_url":null,"website":"https:\/\/www.facebook.com\/compagniecrescendo\/","email":"clembree@protonmail.com","phone_contact":null,"phone_booking":"+32 473 81 53 45","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700005018"},"sp":{"name":"Bruxelles Avenue - la Com\u00e9die Musicale Improvis\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.facebook.com\/compagniecrescendo\/","email":"clembree@protonmail.com","phone_contact":null,"phone_booking":"+32 473 81 53 45","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700005018"},"nl":{"name":"Bruxelles Avenue - la Com\u00e9die Musicale Improvis\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.facebook.com\/compagniecrescendo\/","email":"clembree@protonmail.com","phone_contact":null,"phone_booking":"+32 473 81 53 45","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700005018"}},"place":{"id":50001601,"translations":{"de":{"name":"La Compagnie Crescendo","address_street_name":null,"address_street_number":"20","address_street_box":null,"email":"clembree@protonmail.com","website":"https:\/\/www.facebook.com\/compagniecrescendo\/","phone_contact":null,"phone_booking":"+32 473 81 53 45","address_zip":"1000","address_city":"Bruxelles","address_line1":"La Compagnie Crescendo","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"La Compagnie Crescendo","address_street_name":null,"address_street_number":"20","address_street_box":null,"email":"clembree@protonmail.com","website":"https:\/\/www.facebook.com\/compagniecrescendo\/","phone_contact":null,"phone_booking":"+32 473 81