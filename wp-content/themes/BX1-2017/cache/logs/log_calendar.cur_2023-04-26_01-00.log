":null,"start":"10:30:00","end":"18:00:00"},{"day":"2023-05-14","doors":null,"start":"10:30:00","end":"18:00:00"}],"weekschema":[{"days":{"monday":{"is_open":false},"tuesday":{"is_open":false},"wednesday":{"is_open":true,"hours":[{"start":"10:30:00","end":"18:00:00"}]},"thursday":{"is_open":true,"hours":[{"start":"10:30:00","end":"18:00:00"}]},"friday":{"is_open":true,"hours":[{"start":"10:30:00","end":"18:00:00"}]},"saturday":{"is_open":true,"hours":[{"start":"10:30:00","end":"18:00:00"}]},"sunday":{"is_open":true,"hours":[{"start":"10:30:00","end":"18:00:00"}]}},"translations":{"fr":["lundi et mardi: ferm\u00e9","mercredi, jeudi, vendredi, samedi et dimanche: de 10:30 \u00e0 18:00"],"nl":["maandag en dinsdag: gesloten","woensdag, donderdag, vrijdag, zaterdag en zondag: van 10:30 tot 18:00"],"en":["monday and tuesday: closed","wednesday, thursday, friday, saturday and sunday: from 10:30 to 18:00"],"de":["monday and tuesday: closed","wednesday, thursday, friday, saturday and sunday: from 10:30 to 18:00"],"it":["monday and tuesday: closed","wednesday, thursday, friday, saturday and sunday: from 10:30 to 18:00"],"sp":["monday and tuesday: closed","wednesday, thursday, friday, saturday and sunday: from 10:30 to 18:00"],"pt":["monday and tuesday: closed","wednesday, thursday, friday, saturday and sunday: from 10:30 to 18:00"],"cn":["monday and tuesday: closed","wednesday, thursday, friday, saturday and sunday: from 10:30 to 18:00"]},"date_start":"2023-04-07","date_end":"2023-05-14","is_also_by_appointment":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"opening":{"day":"2023-04-06","start":"18:00:00","timestamp":"2023-04-06T18:00:00+02:00","end":"21:00:00","is_only_by_appointment":false},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-04-24T03:06:47+02:00","published_at":"2023-03-10T14:53:12+01:00","backoffice_id":273180,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.2974441746295},{"id":544635,"date_start":"2023-04-14","date_end":"2023-09-24","date_next":"2023-04-26","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung","it":"Esposizioni","sp":"Exhibici\u00f3n","pt":null,"cn":null}},"others":{"list":[36,37],"translations":{"fr":["Mus\u00e9es et art centers","Arts audiovisuels"],"nl":["Musea en kunstcentra","Audiovisuele kunst"],"en":["Museums and art centers","Audiovisual art"],"de":["Museen & Kunstzentren","Audiovisuelle K\u00fcnste"],"it":["Musei e centri artistici","Arti audiovisive"],"sp":["Museos y centros de arte","Artes audiovisuales"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"The Artwork As A Living System","shortdescr":"Dans le domaine des arts num\u00e9riques , Christa Sommerer et Laurent Mignonneau sont consid\u00e9r\u00e9s comme les pionniers de l'\"art de l'interface\". En 2023, iMAL accueillera une r\u00e9trospective consacr\u00e9e \u00e0 ces artistes influents : The Artwork As A Living System.","longdescr":"Dans le domaine des arts m\u00e9diatiques, Christa Sommerer et Laurent Mignonneau sont consid\u00e9r\u00e9s comme les pionniers de \"l'art de l'interface\". Ce couple d'artistes franco-autrichien s'inspire des syst\u00e8mes, tels que nous les connaissons dans la nature, pour d\u00e9velopper leurs installations interactives et visuellement spectaculaires. Depuis le d\u00e9but des ann\u00e9es 1990, ils travaillent avec les techniques les plus avanc\u00e9es, comme l'algorithme ou l'intelligence artificielle, tout en nous rapprochant des secrets de ce que nous appelons \"la vie\".\r\n\r\nEn 2023, iMAL consacre une exposition r\u00e9trospective \u00e0 ces artistes influents : The Artwork As A Living System.\r\n\r\nL'exposition est le fruit d'une coproduction avec le ZKM, Karlsruhe (DE) et le O\u00d6 Landes-Kultur, Linz (A).","performers":"Christa Sommerer & Laurent Mignonneau","boxoffice_url":null,"website":"http:\/\/www.imal.org","email":"info@imal.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.544635"},"nl":{"name":"The Artwork As A Living System","shortdescr":"In de mediakunst worden Christa Sommerer en Laurent Mignonneau beschouwd als pioniers van de \"Art of Interface\". In 2023 zal iMAL een overzichtstentoonstelling wijden aan deze invloedrijke kunstenaars: The Artwork As A Living System.","longdescr":"In de mediakunst worden Christa Sommerer en Laurent Mignonneau beschouwd als pioniers van de \"Art of Interface\". Dit Oostenrijks-Franse kunstenaarskoppel laat zich bij het ontwikkelen van hun interactieve en visueel spectulaire installaties inspireren door systemen, zoals we deze kennen uit de natuur. Al sinds het begin van de jaren negentig werken zij met de meest geavanceerde technieken, zoals het algoritme of artificiele intellligentie, maar brengen ons tegelijk dichterbij de geheimen van wat wij 'leven' noemen.\r\n\r\nIn 2023 wijdt iMAL een overzichtstentoonstelling aan deze invloedrijke kunstenaars: The Artwork As A Living System.\r\n\r\nDe tentoonstelling kwam tot stand als co-productie met ZKM, Karlsruhe (DE) en het O\u00d6 Landes-Kultur, Linz (A).","performers":"Christa Sommerer & Laurent Mignonneau","boxoffice_url":null,"website":"http:\/\/www.imal.org","email":"info@imal.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.544635"},"en":{"name":"The Artwork As A Living System","shortdescr":"In media art, Christa Sommerer and Laurent Mignonneau are regarded as pioneers of the \u201cArt of Interface.\u201d In 2023 iMAL will welcome a retrospective dedicated to these influencial artists: The Artwork as a Living System.","longdescr":"In media art, Christa Sommerer and Laurent Mignonneau are considered pioneers of the \"Art of Interface\". This Austrian-French artist couple takes inspiration from systems, as we know them from nature, when developing their interactive and visually spectacular installations. Since the early 1990s, they have been working with the most advanced techniques, such as the algorithm or artificial intelligence, while bringing us closer to the secrets of what we call \"life\".\r\n\r\nIn 2023, iMAL dedicates a retrospective exhibition to these influential artists: The Artwork As A Living System.\r\n\r\nThe exhibition is a co-production with ZKM, Karlsruhe (DE) and the O\u00d6 Landes-Kultur, Linz (A).","performers":"Christa Sommerer & Laurent Mignonneau","boxoffice_url":null,"website":"http:\/\/www.imal.org","email":"info@imal.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.544635"},"de":{"name":"The Artwork As A Living System","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.imal.org","email":"info@imal.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.544635"},"it":{"name":"The Artwork As A Living System","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.imal.org","email":"info@imal.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.544635"},"sp":{"name":"The Artwork As A Living System","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.imal.org","email":"info@imal.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.544635"},"pt":{"name":"The Artwork As A Living System","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.imal.org","email":"info@imal.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.544635"},"cn":{"name":"The Artwork As A Living System","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.imal.org","email":"info@imal.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.544635"}},"place":{"id":240068,"translations":{"fr":{"name":"iMAL, Center for Digital Cultures and Technology","address_street_name":"Quai des Charbonnages","address_street_number":null,"address_street_box":null,"email":"info@imal.org","website":"http:\/\/www.imal.org","phone_contact":"+32 2 410 30 93","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Quai des Charbonnages","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"iMAL est un centre d\u2019art de\u0301die\u0301 aux cultures et technologies nume\u0301riques, situe\u0301 dans le centre de Bruxelles et reconnu internationalement. Sa position de pionnier dans le domaine depuis plus de 20 ans est renforce\u0301e par l\u2019ouverture de son nouveau lieu, qui comprend entre autres un grand espace d\u2019exposition, un FabLab de pointe et agrandi, et une bibliothe\u0300que du nume\u0301rique.\r\nL\u2019objectif d\u2019iMAL est de soutenir les pratiques artistiques et cre\u0301atives en lien avec les nouvelles technologies, en accueillant des expositions, confe\u0301rences et performances. iMAL soutient les artistes dans leur recherche, expe\u0301rimentation et production mais iMAL est e\u0301galement un centre de re\u0301flexion ou\u0300 l\u2019on investigue et de\u0301bat des enjeux pre\u0301sents et futurs de la socie\u0301te\u0301 technologique, en favorisant les croisements entre art, science et technologie.\r\nAvec ses activite\u0301s e\u0301ducatives et de me\u0301diation, iMAL vise a\u0300 e\u0301manciper tous les publics, et permettre aux futures ge\u0301ne\u0301rations de fac\u0327onner les cultures nume\u0301riques de demain. Le FabLab cre\u0301atif d\u2019iMAL encourage l\u2019inclusion sociale dans la communaute\u0301 locale de Molenbeek et du Canal, ainsi que l\u2019innovation vers un de\u0301veloppement plus durable.","description_print":"","booking_url":null,"sort_order":"IMAL, CENTER FOR DIGITAL CULTURES AND TECHNOLOGY","virtual_visit":null},"nl":{"name":"iMAL, Center for Digital Cultures and Technology","address_street_name":"Koolmijnenkaai","address_street_number":null,"address_street_box":null,"email":"info@imal.org","website":"http:\/\/www.imal.org","phone_contact":"+32 2 410 30 93","phone_booking":null,"address_zip":"1080","address_city":"Sint-Jans-Molenbeek","address_line1":"Koolmijnenkaai","address_line2":"1080 Sint-Jans-Molenbeek","description_web":"iMAL is een kunstencentrum voor digitale cultuur en technologie, in het centrum van Brussel. Onze internationale positie als pionier in dit veld sinds 1999 werd in 2020 nog versterkt met de opening van een nieuw gebouw met een grotere expositieruimte, een uitgebreid Fablab, een digitale bibliotheek en meer.\r\nAls organisatie ondersteunen we artistieke en creatieve praktijken die (digitale) technologie als medium gebruiken. Naast het begeleiden van artiesten bij het experimenteren, onderzoeken en ontwerpen, organiseren wij ook tentoonstellingen, conferenties, performances. Verder proberen we het publieke debat en de kritische reflectie rond de huidige en toekomstige uitdagingen van onze technologische samenleving op gang te brengen en te ondersteunen door de kruisbestuiving tussen kunst, wetenschap en technologie te stimuleren.\r\nMet onze brede waaier aan activiteiten en een uitgebreid educatief programma is ons doel om iedereen met een interesse in de kunsten en technologie te inspireren om actief deel uit te maken van digitale cultuur. Ons Fablab werkt op haar beurt rond verschillende sociale en innovatieve projecten die bijdragen tot een duurzame ontwikkeling binnen de lokale gemeenschap in Molenbeek.","description_print":"","booking_url":null,"sort_order":"IMAL, CENTER FOR DIGITAL CULTURES AND TECHNOLOGY","virtual_visit":null},"en":{"name":"iMAL, Center for Digital Cultures and Technology","address_street_name":"Quai des Charbonnages","address_street_number":null,"address_street_box":null,"email":"info@imal.org","website":"http:\/\/www.imal.org","phone_contact":"+32 2 410 30 93","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Quai des Charbonnages","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"iMAL is an art center for digital cultures and technology, located in the center of Brussels. Our international position as pioneer in this field since 20+ years was reinforced in 2020 with the opening of our new venue, including a large exhibition space, an expanded state-of-the-art Fablab, a digital library and more.\r\nWe support artistic and creative practices using (digital) technologies as their medium. Next to providing support for artists in their experimentation-, research- and production processes, iMAL is hosting art exhibitions, conferences, performances. Furthermore we also facilitates critical reflection, research and debates around the current and future challenges of our technological society, by stimulating cross-pollinations between art and technology.\r\nWith our wide range of activities and elaborated mediation program, we aim to empower people and inspire the next generations to actively participate in today and future digital cultures. Our Fablab encourages social inclusion and innovation towards sustainable development within the local community of Molenbeek.","description_print":"","booking_url":null,"sort_order":"IMAL, CENTER FOR DIGITAL CULTURES AND TECHNOLOGY","virtual_visit":null},"de":{"name":"iMAL, Center for Digital Cultures and Technology","address_street_name":"Quai des Charbonnages","address_street_number":null,"address_street_box":null,"email":"info@imal.org","website":"http:\/\/www.imal.org","phone_contact":"+32 2 410 30 93","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Quai des Charbonnages","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"iMAL ist ein international anerkanntes Kunstzentrum im Br\u00fcsseler Stadtzentrum, das den digitalen Kulturen und Technologien gewidmet ist. Sein Status als Vorreiter auf diesem Gebiet seit mehr als 20 Jahren wird durch die Er\u00f6ffnung des neuen Standorts weiter gest\u00e4rkt. Das iMAL umfasst einen gro\u00dfen Ausstellungsraum, ein hochmodernes und erweitertes FabLab und eine digitale Bibliothek.","description_print":"","booking_url":null,"sort_order":"IMAL, CENTER FOR DIGITAL CULTURES AND TECHNOLOGY","virtual_visit":null},"it":{"name":"iMAL, Center for Digital Cultures and Technology","address_street_name":"Quai des Charbonnages","address_street_number":null,"address_street_box":null,"email":"info@imal.org","website":"http:\/\/www.imal.org","phone_contact":"+32 2 410 30 93","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Quai des Charbonnages","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"iMAL, Center for Digital Cultures and Technology","address_street_name":"Quai des Charbonnages","address_street_number":null,"address_street_box":null,"email":"info@imal.org","website":"http:\/\/www.imal.org","phone_contact":"+32 2 410 30 93","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Quai des Charbonnages","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"iMAL, Center for Digital Cultures and Technology","address_street_name":"Quai des Charbonnages","address_street_number":null,"address_street_box":null,"email":"info@imal.org","website":"http:\/\/www.imal.org","phone_contact":"+32 2 410 30 93","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Quai des Charbonnages","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"iMAL, Center for Digital Cultures and Technology","address_street_name":"Quai des Charbonnages","address_street_number":null,"address_street_box":null,"email":"info@imal.org","website":"http:\/\/www.imal.org","phone_contact":"+32 2 410 30 93","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Quai des Charbonnages","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":[],"zones":{"list":[23],"translations":{"fr":["Ouest"],"nl":["West"],"en":["West"],"de":["Westen"],"it":["Ovest"],"sp":["Oeste"],"pt":[null],"cn":[null]}},"neca":"art_center","facebook_id":null,"backoffice_id":2724,"location":{"lat":50.85475543,"lon":4.34206481},"region":"brussels","last_updated_at":"2023-04-24T02:36:14+02:00","published_at":"2013-10-19T01:15:29+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":240068,"translations":{"fr":{"name":"iMAL, Center for Digital Cultures and Technology","address_street_name":"Quai des Charbonnages","address_street_number":null,"address_street_box":null,"email":"info@imal.org","website":"http:\/\/www.imal.org","phone_contact":"+32 2 410 30 93","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Quai des Charbonnages","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"iMAL est un centre d\u2019art de\u0301die\u0301 aux cultures et technologies nume\u0301riques, situe\u0301 dans le centre de Bruxelles et reconnu internationalement. Sa position de pionnier dans le domaine depuis plus de 20 ans est renforce\u0301e par l\u2019ouverture de son nouveau lieu, qui comprend entre autres un grand espace d\u2019exposition, un FabLab de pointe et agrandi, et une bibliothe\u0300que du nume\u0301rique.\r\nL\u2019objectif d\u2019iMAL est de soutenir les pratiques artistiques et cre\u0301atives en lien avec les nouvelles technologies, en accueillant des expositions, confe\u0301rences et performances. iMAL soutient les artistes dans leur recherche, expe\u0301rimentation et production mais iMAL est e\u0301galement un centre de re\u0301flexion ou\u0300 l\u2019on investigue et de\u0301bat des enjeux pre\u0301sents et futurs de la socie\u0301te\u0301 technologique, en favorisant les croisements entre art, science et technologie.\r\nAvec ses activite\u0301s e\u0301ducatives et de me\u0301diation, iMAL vise a\u0300 e\u0301manciper tous les publics, et permettre aux futures ge\u0301ne\u0301rations de fac\u0327onner les cultures nume\u0301riques de demain. Le FabLab cre\u0301atif d\u2019iMAL encourage l\u2019inclusion sociale dans la communaute\u0301 locale de Molenbeek et du Canal, ainsi que l\u2019innovation vers un de\u0301veloppement plus durable.","description_print":"","booking_url":null,"sort_order":"IMAL, CENTER FOR DIGITAL CULTURES AND TECHNOLOGY","virtual_visit":null},"nl":{"name":"iMAL, Center for Digital Cultures and Technology","address_street_name":"Koolmijnenkaai","address_street_number":null,"address_street_box":null,"email":"info@imal.org","website":"http:\/\/www.imal.org","phone_contact":"+32 2 410 30 93","phone_booking":null,"address_zip":"1080","address_city":"Sint-Jans-Molenbeek","address_line1":"Koolmijnenkaai","address_line2":"1080 Sint-Jans-Molenbeek","description_web":"iMAL is een kunstencentrum voor digitale cultuur en technologie, in het centrum van Brussel. Onze internationale positie als pionier in dit veld sinds 1999 werd in 2020 nog versterkt met de opening van een nieuw gebouw met een grotere expositieruimte, een uitgebreid Fablab, een digitale bibliotheek en meer.\r\nAls organisatie ondersteunen we artistieke en creatieve praktijken die (digitale) technologie als medium gebruiken. Naast het begeleiden van artiesten bij het experimenteren, onderzoeken en ontwerpen, organiseren wij ook tentoonstellingen, conferenties, performances. Verder proberen we het publieke debat en de kritische reflectie rond de huidige en toekomstige uitdagingen van onze technologische samenleving op gang te brengen en te ondersteunen door de kruisbestuiving tussen kunst, wetenschap en technologie te stimuleren.\r\nMet onze brede waaier aan activiteiten en een uitgebreid educatief programma is ons doel om iedereen met een interesse in de kunsten en technologie te inspireren om actief deel uit te maken van digitale cultuur. Ons Fablab werkt op haar beurt rond verschillende sociale en innovatieve projecten die bijdragen tot een duurzame ontwikkeling binnen de lokale gemeenschap in Molenbeek.","description_print":"","booking_url":null,"sort_order":"IMAL, CENTER FOR DIGITAL CULTURES AND TECHNOLOGY","virtual_visit":null},"en":{"name":"iMAL, Center for Digital Cultures and Technology","address_street_name":"Quai des Charbonnages","address_street_number":null,"address_street_box":null,"email":"info@imal.org","website":"http:\/\/www.imal.org","phone_contact":"+32 2 410 30 93","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Quai des Charbonnages","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"iMAL is an art center for digital cultures and technology, located in the center of Brussels. Our international position as pioneer in this field since 20+ years was reinforced in 2020 with the opening of our new venue, including a large exhibition space, an expanded state-of-the-art Fablab, a digital library and more.\r\nWe support artistic and creative practices using (digital) technologies as their medium. Next to providing support for artists in their experimentation-, research- and production processes, iMAL is hosting art exhibitions, conferences, performances. Furthermore we also facilitates critical reflection, research and debates around the current and future challenges of our technological society, by stimulating cross-pollinations between art and technology.\r\nWith our wide range of activities and elaborated mediation program, we aim to empower people and inspire the next generations to actively participate in today and future digital cultures. Our Fablab encourages social inclusion and innovation towards sustainable development within the local community of Molenbeek.","description_print":"","booking_url":null,"sort_order":"IMAL, CENTER FOR DIGITAL CULTURES AND TECHNOLOGY","virtual_visit":null},"de":{"name":"iMAL, Center for Digital Cultures and Technology","address_street_name":"Quai des Charbonnages","address_street_number":null,"address_street_box":null,"email":"info@imal.org","website":"http:\/\/www.imal.org","phone_contact":"+32 2 410 30 93","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Quai des Charbonnages","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"iMAL ist ein international anerkanntes Kunstzentrum im Br\u00fcsseler Stadtzentrum, das den digitalen Kulturen und Technologien gewidmet ist. Sein Status als Vorreiter auf diesem Gebiet seit mehr als 20 Jahren wird durch die Er\u00f6ffnung des neuen Standorts weiter gest\u00e4rkt. Das iMAL umfasst einen gro\u00dfen Ausstellungsraum, ein hochmodernes und erweitertes FabLab und eine digitale Bibliothek.","description_print":"","booking_url":null,"sort_order":"IMAL, CENTER FOR DIGITAL CULTURES AND TECHNOLOGY","virtual_visit":null},"it":{"name":"iMAL, Center for Digital Cultures and Technology","address_street_name":"Quai des Charbonnages","address_street_number":null,"address_street_box":null,"email":"info@imal.org","website":"http:\/\/www.imal.org","phone_contact":"+32 2 410 30 93","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Quai des Charbonnages","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"iMAL, Center for Digital Cultures and Technology","address_street_name":"Quai des Charbonnages","address_street_number":null,"address_street_box":null,"email":"info@imal.org","website":"http:\/\/www.imal.org","phone_contact":"+32 2 410 30 93","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Quai des Charbonnages","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"iMAL, Center for Digital Cultures and Technology","address_street_name":"Quai des Charbonnages","address_street_number":null,"address_street_box":null,"email":"info@imal.org","website":"http:\/\/www.imal.org","phone_contact":"+32 2 410 30 93","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Quai des Charbonnages","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"iMAL, Center for Digital Cultures and Technology","address_street_name":"Quai des Charbonnages","address_street_number":null,"address_street_box":null,"email":"info@imal.org","website":"http:\/\/www.imal.org","phone_contact":"+32 2 410 30 93","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Quai des Charb