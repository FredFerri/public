ed_at":"2023-02-11T04:35:47+01:00","published_at":"2023-02-07T16:46:36+01:00","backoffice_id":271206,"import_origin":null,"sub_type":"concert","show_in_agenda":true,"ranking":1.2599210498949},{"id":552808,"date_start":"2023-03-17","date_end":"2023-03-17","date_next":"2023-03-17","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":84,"translations":{"fr":"Divers","nl":"Varia","en":"Various","de":"Verschiedenes","it":"Varie","sp":"Varios","pt":null,"cn":null}},"others":{"list":[88],"translations":{"fr":["Jeux et quiz"],"nl":["Spel en quiz"],"en":["Games and quiz"],"de":["Spiele & Quiz"],"it":["Giochi e quiz"],"sp":["Juegos y concursos"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr","it","en"],"subtitles":[]},"translations":{"fr":{"name":"SCOPA ! Tournoi et initiation au jeu de cartes le plus populaire d'Italie","shortdescr":"Avis aux amateurs des jeux de la table : le MedexMuseum organise un tournoi de scopa dans les r\u00e8gles de l\u2019art, c\u2019est-\u00e0-dire pour tuer le temps sans tuer son voisin. On joue gratuitement mais de vrais prix sont \u00e0 gagner !","longdescr":"La scopa est un des jeux de cartes les plus populaires en Italie, mais pas seulement. On la retrouve dans les caf\u00e9s alg\u00e9riens, tunisiens et espagnols et n\u2019ont de diff\u00e9rent que l\u2019accent avec lequel on s\u2019exclame \"CHKOP\", \"CHKOBBA\", \"ESCOBA\" ! \r\n\r\nLe tournoi se basera sur les r\u00e8gles traditionnelles de la scopa. Pour ceux qui n\u2019y ont jamais jou\u00e9, on vous expliquera tout avant de commencer le tournoi. \r\n\r\nOn jouera avec les cartes r\u00e9interpr\u00e9t\u00e9es par Matteo Falone dont vous pourrez d\u00e9couvrir l'univers graphique dans l'exposition inaugur\u00e9e la veille.\r\n\r\nApr\u00e8s avoir bien jou\u00e9 et bien bu, la soir\u00e9e continue sans retenue au rythme de la mazurka, pizzica, tarentella... et autres danses traditionnelles italiennes auxquelles on redonnera un coup de jeune, en pr\u00e9paration du concert d'elettro pizzica du lendemain.\r\n\r\nEntr\u00e9e gratuite\r\n\r\nPlus d'informations sur la page de l'\u00e9v\u00e8nement : https:\/\/fb.me\/e\/2r85UUALR","performers":null,"boxoffice_url":null,"website":"http:\/\/www.medexmuseum.com","email":"medexmuseum@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.552808"},"nl":{"name":"SCOPA ! Tournoi et initiation au jeu de cartes le plus populaire d'Italie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.medexmuseum.com","email":"medexmuseum@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.552808"},"en":{"name":"SCOPA ! Tournoi et initiation au jeu de cartes le plus populaire d'Italie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.medexmuseum.com","email":"medexmuseum@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.552808"},"de":{"name":"SCOPA ! Tournoi et initiation au jeu de cartes le plus populaire d'Italie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.medexmuseum.com","email":"medexmuseum@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.552808"},"it":{"name":"SCOPA ! Tournoi et initiation au jeu de cartes le plus populaire d'Italie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.medexmuseum.com","email":"medexmuseum@gmail.com","phone_contact":null,"phone_booking":null,"