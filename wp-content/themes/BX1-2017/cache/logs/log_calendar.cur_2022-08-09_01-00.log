50.83799952,"lon":4.36754042},"region":"brussels","last_updated_at":"2022-07-14T13:05:40+02:00","published_at":"2013-10-19T01:13:47+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/explore-f5cc997d6781f5e905b5a98281f197ae90776910.jpg","width":533,"height":356,"ratio":1.5,"translations":{"fr":{"title":"Nature en ville, une richesse \u00e0 pr\u00e9server","copyright":null},"nl":{"title":"Nature en ville, une richesse \u00e0 pr\u00e9server","copyright":null},"en":{"title":"Nature en ville, une richesse \u00e0 pr\u00e9server","copyright":null}}}],"dates":[{"day":"2022-08-28","doors":null,"start":"14:00:00","end":"16:00:00","is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":11}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"visit_profile":{"list":[328],"translations":{"fr":["Vert & durable"],"nl":["Groen & duurzaam"],"en":["Green & sustainable"]}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-07-14T13:05:40+02:00","published_at":"2022-04-09T03:30:11+02:00","backoffice_id":251271,"import_origin":"explore","sub_type":"other","show_in_agenda":true,"ranking":1.2599210498949},{"id":538872,"date_start":"2022-08-28","date_end":"2022-08-28","date_next":"2022-08-28","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Les Halles de Schaerbeek \/ Visite avec expert Myriam Dubois & Jean de Salle","shortdescr":"L'ancien march\u00e9 couvert Sainte-Marie fut construit en 1865 et d\u00e9truit par un incendie en 1898. Reconstruit dans les ann\u00e9es 1900 dans l'esprit Art nouveau en alliant m\u00e9tal, verre et pierre, le complexe n'a pas le succ\u00e8s escompt\u00e9 et est transform\u00e9 en entrep\u00f4t dans les ann\u00e9es 1920.","longdescr":"L'ancien march\u00e9 couvert Sainte-Marie fut construit en 1865 et d\u00e9truit par un incendie en 1898. Reconstruit dans les ann\u00e9es 1900 dans l'esprit Art nouveau en alliant m\u00e9tal, verre et pierre, le complexe n'a pas le succ\u00e8s escompt\u00e9 et est transform\u00e9 en entrep\u00f4t dans les ann\u00e9es 1920. C\u00e9d\u00e9 \u00e0 la Communaut\u00e9 fran\u00e7aise de Belgique en 1983, celle-ci en confie la r\u00e9novation aux architectes Jean de Salle et Miriam Dubois (COOPARCH-R.U.) et au bureau d'\u00e9tudes Ing\u00e9nieurs Associ\u00e9s. Ils entreprennent dans un premier temps la restauration g\u00e9n\u00e9rale et la consolidation des structures, et dans une deuxi\u00e8me phase, le r\u00e9am\u00e9nagement int\u00e9rieur, respectueux du b\u00e2ti originel (\u00e9quipement technique, isolation acoustique et thermique). Les deux architectes seront pr\u00e9sents \u00e0 la visite pour nous d\u00e9voiler les coulisses de cette restauration d'envergure !\nAvec le soutien de la F\u00e9d\u00e9ration Wallonie-Bruxelles, cellule.archi.","performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be","email":"info@arkadia.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/538872.html"},"nl":{"name":"Les Halles de Schaerbeek \/ Visite avec expert Myriam Dubois & Jean de Salle","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/538872.html"},"en":{"name":"Les Halles de Schaerbeek \/ Visite avec expert Myriam Dubois & Jean de Salle","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/538872.html"},"de":{"name":"Les Halles de Schaerbeek \/ Visite avec expert Myriam Dubois & Jean de Salle","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/538872.html"},"it":{"name":"Les Halles de Schaerbeek \/ Visite avec expert Myriam Dubois & Jean de Salle","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/538872.html"},"sp":{"name":"Les Halles de Schaerbeek \/ Visite avec expert Myriam Dubois & Jean de Salle","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/538872.html"},"pt":{"name":"Les Halles de Schaerbeek \/ Visite avec expert Myriam Dubois & Jean de Salle","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/538872.html"},"cn":{"name":"Les Halles de Schaerbeek \/ Visite avec expert Myriam Dubois & Jean de Salle","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/538872.html"}},"place":{"id":393,"translations":{"fr":{"name":"Halles de Schaerbeek","address_street_name":"Rue Royale Sainte-Marie","address_street_number":null,"address_street_box":null,"email":"info@halles.be","website":"http:\/\/www.halles.be","phone_contact":"+32 2 218 21 07","phone_booking":"+32 2 218 21 07","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Rue Royale Sainte-Marie","address_line2":"1030 Schaerbeek","description_web":"Lieu intempestif, Les Halles abritent leur ind\u00e9pendance au c\u0153ur de Bruxelles, capitale de l\u2019Europe, dans une structure de m\u00e9tal et de verre datant de 1901 et superbement r\u00e9nov\u00e9e.\r\nSes volumes sans \u00e9quivalent invitent aux f\u00eates, aux projets hors normes, aux aventures artistiques et humaines : depuis l\u2019origine, les Halles captent et cristallisent les mouvements de fond de l\u2019art et de la soci\u00e9t\u00e9, dans une alliance in\u00e9dite du savant et du populaire.\r\n\r\nElles offrent un espace id\u00e9al pour r\u00e9inventer les formes du spectacle, au-del\u00e0 de la classique partition entre cr\u00e9ateurs d\u2019un c\u00f4t\u00e9 et spectateurs de l\u2019autre. Bousculant les usages, Les Halles r\u00e9sonnent avec l\u2019envie de participation et d\u2019engagement, \u00e9gotiste ou collectif, qui caract\u00e9rise l\u2019\u00e9poque num\u00e9rique.\r\n\r\nOuvertes aux espoirs et aux bouleversements contemporains, du quartier jusqu\u2019au grand large du monde, elles cherchent \u00e0 retrouver le meilleur d\u2019une Europe toujours en qu\u00eate de son destin : l\u2019exploration de passions nouvelles,  la raison cherchant l\u2019aventure, la plus grande libert\u00e9 d\u2019allure.\r\n\r\n A c\u00f4t\u00e9 d\u2019une programmation traditionnelle, les Halles d\u00e9veloppent des temps atypiques sur de grands week-ends et engagent des projets qui sortent du champ strict du spectacle vivant. Les Halles, d\u2019autre part, lancent des productions propres, notamment avec les quatre compagnies associ\u00e9es au lieu.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Hallen van Schaarbeek","address_street_name":"Koninklijke Sint-Mariastraat","address_street_number":null,"address_street_box":null,"email":"info@halles.be","website":"http:\/\/www.halles.be","phone_contact":"+32 2 218 21 07","phone_booking":"+32 2 218 21 07","address_zip":"1030","address_city":"Schaarbeek","address_line1":"Koninklijke Sint-Mariastraat","address_line2":"1030 Schaarbeek","description_web":"Les Halles werken aan een multidisciplinair, hedendaags en internationaal artistiek project dat deze instelling een bijzondere plaats geeft binnen de hedendaagse creatieve sc\u00e8ne in Brussel.\r\nLes Halles vormen een buitengewone culturele plek, zowel door de ruimtes als door de artistieke voorstellen.die een kruising zijn tussen dans, circus, podiumkunsten en muzikale optredens. \r\n\r\nLes Halles dragen de hedendaagse creatieve sc\u00e8ne een warm hart toe. Les Halles proberen zinvolle, artistiek vernieuwende projecten tot stand te brengen. In die zin wordt de kunstenaars de mogelijkheid geboden hun tijd te nemen, te experimenteren en te zoeken.\r\n\r\nLes Halles slaan een brug tussen een communautair engagement en de creatieve sc\u00e8ne op Europees niveau. Ze spelen een essenti\u00eble rol in de confrontatie van verschillende culturen, talen en benaderingen in Brussel. De aanwezigheid van Europese projecten is een van de draagvlakken van les halles. Zowel voor de toeschouwers als voor de kunstenaars van bij ons pogen les Halles de Brusselse sc\u00e8ne open te trekken en het publiek kennis te laten maken met vernieuwende, artistieke bewegingen die zich elders hebben ontwikkeld.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Halles de Schaerbeek","address_street_name":"Rue Royale Sainte-Marie","address_street_number":null,"address_street_box":null,"email":"info@halles.be","website":"http:\/\/www.halles.be","phone_contact":"+32 2 218 21 07","phone_booking":"+32 2 218 21 07","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Rue Royale Sainte-Marie","address_line2":"1030 Schaerbeek","description_web":"Les Halles showcase their independence right in the heart of Brussels, the European capital, in a metal and glass structure dating back to 1901, which has been saved from destruction and wonderfully renovated. Its space is unrivalled and perfectly suited for celebrations, extraordinary projects, as well as both artistic and human adventures. Ever since their beginnings, Les Halles have captured and crystallised movements stemming right from the edges of art and society, in an unprecedented alliance of both learned and popular culture. \r\n\r\nIt is an ideal space to create new performative formats, going beyond the classic partition between creators and spectators. Unconcerned with the barriers separating disciplines, willing to shake up the norms, Les Halles resonate with a desire for participation and involvment, be it individually or collectively, thus characterising the digital age. \r\n\r\nOpen to contemporary hopes and upheavals spanning from the neighbourhood right out to the world at large, Les Halles keep on looking for what Europe, still on a quest for its own destiny, has to offer: exploration of new passions, reason seeking out adventure, the utmost freedom of style.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Halles de Schaerbeek","address_street_name":"Rue Royale Sainte-Marie","address_street_number":null,"address_street_box":null,"email":"info@halles.be","website":"http:\/\/www.halles.be","phone_contact":"+32 2 218 21 07","phone_booking":"+32 2 218 21 07","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Rue Royale Sainte-Marie","address_line2":"1030 Schaerbeek","description_web":"Les Halles de Schaerbeek haben sich Unabh\u00e4ngigkeit und Unkonventionalit\u00e4t auf die Fahnen geschrieben. Untergebracht ist dieser hohe Ort der Kultur in einer fantastisch renovierten Glas- und Metallstruktur aus dem Jahr 1901. Auf dem Programm stehen k\u00fcnstlerische und menschliche Abenteuer und Projekte abseits der Norm...\r\n\r\nHier werden immer wieder neue Formen der B\u00fchnenkunst erfunden, die \u00fcber die klassische Partition zwischen Kunst- und Theaterschaffenden auf der einen Seite und dem Publikum auf der anderen Seite hinausgehen. \r\n\r\nAuf dem Programm - zwischen dem Stadtviertel und der weiten Welt - steht nicht weniger und nicht mehr als das Beste eines Europas, das unabl\u00e4ssig auf der Suche nach seiner Zukunft ist - Erforschung neuer Leidenschaften, Vernunft auf der Suche nach dem Abenteuer, gr\u00f6\u00dfte stilistische Freiheit... Das alles mit Darbietungen, die aus dem Rahmen fallen, und Eigenproduktionen, die unter anderem von den vier Truppen der Halles de Schaerbeek auf die Beine gestellt werden.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Halles de Schaerbeek","address_street_name":"Rue Royale Sainte-Marie","address_street_number":null,"address_street_box":null,"email":"info@halles.be","website":"http:\/\/www.halles.be","phone_contact":"+32 2 218 21 07","phone_booking":"+32 2 218 21 07","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Rue Royale Sainte-Marie","address_line2":"1030 Schaerbeek","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Halles de Schaerbeek","address_street_name":"Rue Royale Sainte-Marie","address_street_number":null,"address_street_box":null,"email":"info@halles.be","website":"http:\/\/www.halles.be","phone_contact":"+32 2 218 21 07","phone_booking":"+32 2 218 21 07","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Rue Royale Sainte-Marie","address_line2":"1030 Schaerbeek","description_web":"Les Halles exhibe su independencia en el coraz\u00f3n de Bruselas, la capital europea, en una estructura de metal y vidrio que data de 1901, que se salv\u00f3 de la destrucci\u00f3n y se renov\u00f3 maravillosamente. Su espacio es incomparable y se adapta perfectamente a celebraciones, proyectos extraordinarios y aventuras tanto art\u00edsticas como humanas. Desde sus inicios, el centro Les Halles ha capturado y cristalizado movimientos provenientes de los l\u00edmites del arte y la sociedad, en una alianza sin precedentes de cultura tanto erudita como popular. \r\nEs un espacio ideal para crear nuevos formatos performativos, yendo m\u00e1s all\u00e1 de la partici\u00f3n cl\u00e1sica entre creadores y espectadores. Sin preocuparse por las barreras que separan las disciplinas, dispuesta a sacudir las normas, Les Halles resuena con un deseo de participaci\u00f3n e implicaci\u00f3n, ya sea de manera individual o colectiva, caracterizando as\u00ed la era digital.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Halles de Schaerbeek","address_street_name":"Rue Royale Sainte-Marie","address_street_number":null,"address_street_box":null,"email":"info@halles.be","website":"http:\/\/www.halles.be","phone_contact":"+32 2 218 21 07","phone_booking":"+32 2 218 21 07","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Rue Royale Sainte-Marie","address_line2":"1030 Schaerbeek","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Halles de Schaerbeek","address_street_name":"Rue Royale Sainte-Marie","address_street_number":null,"address_street_box":null,"email":"info@halles.be","website":"http:\/\/www.halles.be","phone_contact":"+32 2 218 21 07","phone_booking":"+32 2 218 21 07","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Rue Royale Sainte-Marie","address_line2":"1030 Schaerbeek","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":[],"zones":{"list":[20],"translations":{"fr":["Nord"],"nl":["Noord"],"en":["North"]}},"neca":null,"facebook_id":null,"backoffice_id":106,"location":{"lat":50.85994245,"lon":4.36947808},"region":"brussels","last_updated_at":"2022-07-25T10:35:10+02:00","published_at":"2013-10-19T01:13:17+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":276946,"translations":{"fr":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":"Depuis 1983, Arkadia explore les richesses du patrimoine belge et bruxellois et d\u00e9veloppe de nombreux projets culturels sp\u00e9cialement \u00e0 Bruxelles, entre architecture, urbanisme, culture, arts plastiques et id\u00e9ologie depuis le Moyen \u00c2ge jusqu\u2019\u00e0 nos jours. Voir et comprendre la ville et son d\u00e9veloppement architectural, approcher la cr\u00e9ation artistique et lui donner un sens, telles sont les activit\u00e9s que l'ASBL veut partager avec le public. Sp\u00e9cialistes du patrimoine  architectural et de l'art contemporain, ils font d\u00e9couvrir la ville \u00e0 travers des visites guid\u00e9es et des conf\u00e9rences en plusieurs langues.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Arkadia","address_street_name":"Naamsestraat","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be\/nl","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Naamsestraat, 10","address_line2":"1000 Brussel","description_web":"Sinds 1983 verkent Arkadia de rijkdom van het Belgische en Brusselse erfgoed en ontwikkelt talrijke culturele projecten, vooral in Brussel, tussen architectuur, stedenbouw, cultuur, plastische kunsten en ideologie, van de Middeleeuwen tot vandaag. De stad en haar architecturale ontwikkeling zien en begrijpen, de artistieke creatie benaderen en er een betekenis aan geven, dat zijn de activiteiten die de VZW met het publiek wil delen. Zij zijn gespecialiseerd in architectonisch erfgoed en hedendaagse kunst en laten de stad zien door middel van rondleidingen en lezingen in verschillende talen.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be\/en","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue de Namur, 10","address_line2":"1000 Brussels","description_web":"Since 1983, Arkadia has been exploring the richness of Belgium's and Brussels' heritage and developing numerous cultural projects especially in Brussels, between architecture, urbanism, culture, plastic arts and ideology from the Middle Ages to the present day. Seeing and understanding the city and its architectural development, approaching artistic creation and giving it meaning, these are the activities that the ASBL wants to share with the public. Specialists in architectural heritage and contemporary art, they show the city through guided tours and lectures in several languages.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Arkadia","a