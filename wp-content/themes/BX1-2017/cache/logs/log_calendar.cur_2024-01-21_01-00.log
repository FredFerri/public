false,"is_soldout":false,"last_updated_at":"2024-01-20T01:03:44+01:00","published_at":"2023-10-31T16:05:04+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":288095,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.28543716208189446,"languages":{"spoken":["nl","fr","en"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[42,36],"translations":{"de":["Malerei","Museen & Kunstzentren"],"pt":[null,null],"en":["Painting","Museums and art centers"],"it":["Pittura","Musei e centri artistici"],"cn":[null,null],"fr":["Peinture","Mus\u00e9es et art centers"],"sp":["Pintura","Museos y centros de arte"],"nl":["Schilderkunst","Musea en kunstcentra"]}}},"translations":{"de":{"name":"Being Human \u2013 \u00catre Humain","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/mmm.brussels","email":"museum@foyer.be","phone_contact":"+32 2 609 55 61","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50003946"},"pt":{"name":"Being Human \u2013 \u00catre Humain","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/mmm.brussels","email":"museum@foyer.be","phone_contact":"+32 2 609 55 61","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50003946"},"en":{"name":"Being Human","shortdescr":"From 22 November 2023 to 15 February 2024, the Brussels Migration Museum is hosting \"Being Human - The night sea is too big!\", an exhibition by Gonzalo Orqu\u00edn.\nThe exhibition, designed by Francesca Paci and inspired by Spanish painting, highlights the stories of migrants, focusing on arrivals by sea in Lampedusa, Italy. ","longdescr":"From November 22, 2023, to February 15, 2024, the Brussels Migration Museum hosts \u201cBeing Human \u2013 The sea at night is too big,\u201d an exhibition by artist Gonzalo Orqu\u00edn. This event is part of the Spanish presidency of the European Union, commissioned by the Spanish embassy in Belgium.\n\nThe exhibition, conceived by Francesca Paci and inspired by Spanish portraiture, sheds light on the stories and experiences of migrants, focusing on arrivals by sea in Lampedusa, Italy, and via Bihac, Bosnia. Orqu\u00edn\u2019s portraits aim to give a voice to these often overlooked individuals, fostering empathy and understanding.\n\nThe 16 works on display humanize migrants, offering names, faces, and stories, portraying their experiences with both stark realism and moments of hope. The exhibition also addresses the challenges faced by LGBTQI+ refugees.\n\nGonzalo Orqu\u00edn collaborated with several organizations, and a portion of the proceeds from artwork sales will be donated to these groups. Each painting is associated with a fictitious name, and the exhibition includes a documentary film that follows the artist\u2019s process.\n\nThe opening will be on the 22nd of November 2023 at 11AM at the Museum of Migration in Brussels. For more information, visit mmm.brussels or gonzaloorquin.com and use #BeingHuman to share.\n\nReservations: museum@foyer.be\n","performers":"Gonzalo Orqu\u00edn\nFrancesca Paci ","boxoffice_url":null,"website":"http:\/\/mmm.brussels","email":"museum@foyer.be","phone_contact":"+32 2 609 55 61","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50003946"},"it":{"name":"Being Human \u2013 \u00catre Humain","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/mmm.brussels","email":"museum@foyer.be","phone_contact":"+32 2 609 55 61","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50003946"},"cn":{"name":"Being Human \u2013 \u00catre Humain","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/mmm.brussels","email":"museum@foyer.be","phone_contact":"+32 2 609 55 61","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50003946"},"fr":{"name":"Being Human \u2013 \u00catre Humain","shortdescr":"Du 22 novembre 2023 au 15 f\u00e9vrier 2024, le Mus\u00e9e de la Migration de Bruxelles accueille \u201cBeing Human \u2013 La mer de nuit est trop grande !\u201d, une exposition de Gonzalo Orqu\u00edn.\nL\u2019exposition, con\u00e7ue par Francesca Paci et inspir\u00e9e par la peinture espagnole, met en lumi\u00e8re les histoires des migrants, en se concentrant sur les arriv\u00e9es par la mer \u00e0 Lampedusa, en Italie. \n\nR\u00e9servations : museum@foyer.be","longdescr":"The sea at night is too big! \u2013 La mer de nuit est trop grande !\n\nDu 22 novembre 2023 au 15 f\u00e9vrier 2024, le Mus\u00e9e de la Migration de Bruxelles accueille \u201cBeing Human \u2013 La mer de nuit est trop grande\u201d, une exposition de l\u2019artiste Gonzalo Orqu\u00edn. Cet \u00e9v\u00e9nement s\u2019inscrit dans le cadre de la pr\u00e9sidence espagnole de l\u2019Union europ\u00e9enne et a \u00e9t\u00e9 command\u00e9 par l\u2019ambassade d\u2019Espagne en Belgique.\n\nL\u2019exposition, con\u00e7ue par Francesca Paci et inspir\u00e9e par la peinture espagnole, met en lumi\u00e8re les histoires et les exp\u00e9riences des migrants, en se concentrant sur les arriv\u00e9es par la mer \u00e0 Lampedusa, en Italie, et via Bihac, en Bosnie. Les portraits d\u2019Orqu\u00edn visent \u00e0 donner une voix \u00e0 ces individus souvent n\u00e9glig\u00e9s, favorisant l\u2019empathie et la compr\u00e9hension.\n\nLes 16 \u0153uvres expos\u00e9es humanisent les migrants en offrant des noms, des visages et des r\u00e9cits, d\u00e9peignant leurs exp\u00e9riences avec un r\u00e9alisme saisissant et des moments d\u2019espoir. L\u2019exposition aborde \u00e9galement les d\u00e9fis auxquels sont confront\u00e9s les r\u00e9fugi\u00e9s LGBTQI+.\n\nGonzalo Orqu\u00edn a collabor\u00e9 avec plusieurs organisations, et une partie des recettes de la vente des \u0153uvres d\u2019art sera vers\u00e9e \u00e0 ces groupes. Chaque tableau est associ\u00e9 \u00e0 un nom fictif, et l\u2019exposition comprend un film documentaire qui suit le processus de l\u2019artiste.\n\nLe vernissage aura lieu le 22 novembre \u00e0 11h au Mus\u00e9e de la Migration de Bruxelles. Pour plus d\u2019informations, visitez mmm.brussels ou gonzaloorquin.com et utilisez le hashtag #BeingHuman pour partager.\n\nR\u00e9servations : museum@foyer.be","performers":"Gonzalo Orqu\u00edn\nFrancesca Paci \n","boxoffice_url":null,"website":"http:\/\/mmm.brussels","email":"museum@foyer.be","phone_contact":"+32 2 609 55 61","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50003946"},"sp":{"name":"Being Human \u2013 \u00catre Humain","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/mmm.brussels","email":"museum@foyer.be","phone_contact":"+32 2 609 55 61","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50003946"},"nl":{"name":"Being Human \u2013 Mens Zijn","shortdescr":"Van 22 november 2023 tot 15 februari 2024 loopt in het Brussels Migratie Museum de tentoonstelling \"Being Human -  De zee bij nacht is te groot!\" van Gonzalo Orqu\u00edn.\nDe tentoonstelling, ontworpen door Francesca Paci en ge\u00efnspireerd door Spaanse schilderkunst, belicht de verhalen van migranten, met de nadruk op aankomsten over zee in Lampedusa, Itali\u00eb. ","longdescr":"The sea at night is too big! \u2013 De zee bij nacht is te groot!\n\nVan 22 november 2023 tot 15 februari 2024 organiseert het Brussels Migratiemuseum \u201cBeing Human \u2013 De zee \u2018s nachts is te groot\u201d, een tentoonstelling van kunstenaar Gonzalo Orqu\u00edn. Dit evenement maakt deel uit van het Spaanse voorzitterschap van de Europese Unie en is opdracht gegeven door de Spaanse ambassade in Belgi\u00eb.\n\nDe tentoonstelling, bedacht door Francesca Paci en ge\u00efnspireerd door de Spaanse schilderkunst, belicht de verhalen en ervaringen van migranten, met een focus op aankomsten via de zee in Lampedusa, Itali\u00eb, en via Bihac, Bosni\u00eb. Orqu\u00edns portretten beogen een stem te geven aan deze vaak over het hoofd geziene individuen, en zo empathie en begrip te bevorderen.\n\nDe 16 tentoongestelde werken humaniseren migranten door namen, gezichten en verhalen te bieden, hun ervaringen te portretteren met zowel rauw realisme als momenten van hoop. De tentoonstelling behandelt ook de uitdagingen waarmee LGBTQI+ vluchtelingen te maken hebben.\n\nGonzalo Orqu\u00edn werkte samen met verschillende organisaties, en een deel van de opbrengst van de verkoop van kunstwerken zal aan deze groepen worden gedoneerd. Elke schilderij is geassocieerd met een fictieve naam, en de tentoonstelling omvat een documentaire film die het proces van de kunstenaar volgt.\n\nDe opening is op 22 november om 11u in het Migratiemuseum van Brussel. Voor meer informatie, bezoek mmm.brussels of gonzaloorquin.com en gebruik de hashtag #BeingHuman om te delen.\n\nInschrijvingen: museum@foyer.be","performers":"Gonzalo Orqu\u00edn\nFrancesca Paci ","boxoffice_url":null,"website":"http:\/\/mmm.brussels","email":"museum@foyer.be","phone_contact":"+32 2 609 55 61","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50003946"}},"place":{"id":274307,"translations":{"de":{"name":"MigratieMuseumMigration","address_street_name":"rue des ateliers","address_street_number":"17","address_street_box":null,"email":"museum@foyer.be","website":"http:\/\/www.migratiemuseummigration.be","phone_contact":"+32 2 609 55 61","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue des ateliers, 17","address_line2":"1080 Molenbeek-Saint-Jean","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"MigratieMuseumMigration","address_street_name":"rue des ateliers","address_street_number":"17","address_street_box":null,"email":"museum@foyer.be","website":"http:\/\/www.migratiemuseummigration.be","phone_contact":"+32 2 609 55 61","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue des ateliers, 17","address_line2":"1080 Molenbeek-Saint-Jean","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"MigratieMuseumMigration","address_street_name":"rue des ateliers","address_street_number":"17","address_street_box":null,"email":"museum@foyer.be","website":"http:\/\/www.migratiemuseummigration.be","phone_contact":"+32 2 609 55 61","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue des ateliers, 17","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"Today, more than 180 nationalities live together in Brussels. The MigratieMuseumMigration gives a permanent home to the stories of the first generation of guest workers, of the earliest inhabitants of the Petit-Cha\u0302teau, of the expats, the war refugees, the Europeans who move freely within the EU and many others. It is a warm environment where visitors can discover Brussels and the lives of others through memories and souvenirs. Above all, it is a museum with plenty of room to share your own story.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"MigratieMuseumMigration","address_street_name":"rue des ateliers","address_street_number":"17","address_street_box":null,"email":"museum@foyer.be","website":"http:\/\/www.migratiemuseummigration.be","phone_contact":"+32 2 609 55 61","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue des ateliers, 17","address_line2":"1080 Molenbeek-Saint-Jean","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"MigratieMuseumMigration","address_street_name":"rue des ateliers","address_street_number":"17","address_street_box":null,"email":"museum@foyer.be","website":"http:\/\/www.migratiemuseummigration.be","phone_contact":"+32 2 609 55 61","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue des ateliers, 17","address_line2":"1080 Molenbeek-Saint-Jean","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"MigratieMuseumMigration","address_street_name":"rue des ateliers","address_street_number":"17","address_street_box":null,"email":"museum@foyer.be","website":"http:\/\/www.migratiemuseummigration.be","phone_contact":"+32 2 609 55 61","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue des ateliers, 17","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"Aujourd'hui, plus de 180 nationalite\u0301s vivent ensemble a\u0300 Bruxelles. Le MigratieMuseumMigration raconte l\u2019histoire de la premie\u0300re ge\u0301ne\u0301ration de travailleurs immigre\u0301s invite\u0301s, des premiers arrivants au Petit Cha\u0302teau, des expatrie\u0301s, des re\u0301fugie\u0301s de guerre, des Europe\u0301ens qui se sont de\u0301place\u0301s librement au sein de l\u2019UE et de tous les autres. C\u2019est un muse\u0301e chaleureux ou\u0300 les visiteurs peuvent de\u0301couvrir la ville et la vie des autres a\u0300 travers des souvenirs, mais aussi, et avant tout, un lieu accueillant pour y partager sa propre histoire.","description_print":null,"booking_url":null,"sort_or