"],"pt":[null],"en":["Seniors"],"it":["Anziani"],"cn":[null],"fr":["Seniors"],"sp":["Personas de la tercera edad"],"nl":["Senioren"]}},"educational_targets":{"list":[],"translations":{}},"tags":[]},{"id":555844,"date_start":"2023-04-20","date_end":"2023-12-31","date_next":"2023-12-31","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":true,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2023-07-14T16:45:28+02:00","published_at":"2023-04-20T10:35:53+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":true,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":275844,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"tour","ranking":0.15749013123685915,"languages":{"spoken":["de","nl","fr","en"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{"list":[111],"translations":{"de":["Europa"],"pt":[null],"en":["Europe"],"it":["Europa"],"cn":[null],"fr":["Europe"],"sp":["Europa"],"nl":["Europa"]}}},"translations":{"de":{"name":"Bruxelles, capitale d'Europe","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.itineraires.be","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.555844"},"pt":{"name":"Bruxelles, capitale d'Europe","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.itineraires.be","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.555844"},"en":{"name":"Bruxelles, capitale d'Europe","shortdescr":"Brussels, the most beautiful gateway to Europe. Private guided tour of the European district, to discover the history, the evolution, the role of the institutions and the life of the district beyond the skyscrapers","longdescr":"Brussels, the most beautiful gateway to Europe. Tours and detours around the European Parliament will allow us to approach the history of the Berlaymont and its successive moves, to discover some architectural gems or the remains of the megalomaniac road projects of the 60s... From the Leopold district, a European city, to the Place Jourdan, we will present the implantation of Europe in the heart of the capital, its impact on the habitat and on the general aspect of the district. And to finish, you will know everything about \"Who does what, where and how?","performers":null,"boxoffice_url":null,"website":"http:\/\/www.itineraires.be","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.555844"},"it":{"name":"Bruxelles, capitale d'Europe","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.itineraires.be","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.555844"},"cn":{"name":"Bruxelles, capitale d'Europe","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.itineraires.be","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.555844"},"fr":{"name":"Bruxelles, capitale d'Europe","shortdescr":"Bruxelles, la plus belle porte d'entr\u00e9e pour l'Europe. Visite guid\u00e9e privative du quartier Europ\u00e9en, pour en d\u00e9couvrir l'histoire, l'\u00e9volution, le r\u00f4le des institutions et la vie du quartier au del\u00e0 des gratte-ciel","longdescr":"Bruxelles, la plus belle porte d'entr\u00e9e pour l'Europe. Tours et d\u00e9tours autour du Parlement europ\u00e9en nous permettront d'aborder l'histoire du Berlaymont et de ses d\u00e9m\u00e9nagements successifs, de d\u00e9couvrir quelques perles architecturales ou les vestiges des projets routiers m\u00e9galomanes des ann\u00e9es 60... Du quartier L\u00e9opold, cit\u00e9 europ\u00e9enne, \u00e0 la place Jourdan, nous vous pr\u00e9senterons l'implantation de l'Europe au c\u0153ur de la capitale, son impact sur l'habitat et sur l'aspect g\u00e9n\u00e9ral du quartier. Et pour finir vous saurez tout sur \u00ab Qui fait quoi, o\u00f9 et comment ? \u00bb.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.itineraires.be","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.555844"},"sp":{"name":"Bruxelles, capitale d'Europe","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.itineraires.be","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.555844"},"nl":{"name":"Bruxelles, capitale d'Europe","shortdescr":"Brussel, de mooiste toegangspoort tot Europa. Priv\u00e9rondleiding door de Europese wijk om de geschiedenis, de evolutie, de rol van de instellingen en het leven van de wijk achter de wolkenkrabbers te ontdekken.","longdescr":"Brussel, de mooiste toegangspoort tot Europa. Rondleidingen en omwegen rond het Europees Parlement laten ons toe de geschiedenis van het Berlaymont en zijn opeenvolgende verhuizingen te verkennen, enkele architecturale pareltjes te ontdekken of de overblijfselen van de megalomane wegenbouwprojecten van de jaren 1960... Van de Leopoldwijk, een Europese stad, tot het Jourdanplein, zullen we de vestiging van Europa in het hart van de hoofdstad en de impact ervan op de huisvesting en het algemene uitzicht van de wijk voorstellen. En tenslotte komt u alles te weten over \"Wie doet wat, waar en hoe?","performers":null,"boxoffice_url":null,"website":"http:\/\/www.itineraires.be","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.555844"}},"place":{"id":266898,"translations":{"de":{"name":"Station Europe","address_street_name":"Place du Luxembourg","address_street_number":"100","address_street_box":null,"email":"visit@europarl.europa.eu","website":"http:\/\/www.europarl.europa.eu\/visiting\/fr\/brussels\/station-europe","phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Place du Luxembourg, 100","address_line2":"1050 Ixelles","description_web":"\u201eStation Europe\u201c ist der ideale Ausgangspunkt f\u00fcr Besucher, die sich einen spannenden und fundierten Einblick \u00fcber das Thema Europa in Br\u00fcssel verschaffen m\u00f6chten. Untergebracht ist \u201eStation Europe\u201c in dem ehemaligen Bahnhof Bruxelles-Luxembourg, direkt an dem belebten Place du Luxembourg. Die Mitarbeiter der Br\u00fcsseler Tourismusagentur visit.brussels stehen Besuchern mit Tipps und Informationen \u00fcber das Europ\u00e4ische Parlament im Speziellen und die Stadt Br\u00fcssel im Allgemeinen zur Verf\u00fcgung.\r\nVerschiedene interaktive Angebote geben dem Besucher eine kleine Einstimmung auf das, was ihn im EU-Viertel erwartet: So wird das EU-Parlament anhand eines \u201eAugmented Reality\u201c-Modells des Campus zum Leben erweckt. Nehmen Sie an den Touchscreen-Tischen Platz, tauchen Sie ein in die Geschichte des EU-Parlaments oder gehen Sie auf Tuchf\u00fchlung mit den historischen Pers\u00f6nlichkeiten, die hier eine zentrale Rolle gespielt haben. Anhand von Dioramen treten Sie eine spannende Reise in die Vergangenheit an und k\u00f6nnen das Europ\u00e4ische Parlament aus unterschiedlichen Blickwinkeln und zu verschiedenen Zeitpunkten seines Bestehens betrachten. \r\nDar\u00fcber hinaus ist \u201eStation Europe\u201c eine erste Anlaufstation f\u00fcr Besucher in Br\u00fcssel, denn visit.brussels pr\u00e4sentiert hier eine Auswahl der besten Sehensw\u00fcrdigkeiten und Attraktionen der belgischen Hauptstadt, insbesondere auch im Hinblick auf andere europ\u00e4ische Institutionen und das EU-Viertel insgesamt.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Station Europe","address_street_name":"Place du Luxembourg","address_street_number":"100","address_street_box":null,"email":"visit@europarl.europa.eu","website":"http:\/\/www.europarl.europa.eu\/visiting\/fr\/brussels\/station-europe","phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Place du Luxembourg, 100","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Station Europe","address_street_name":"Place du Luxembourg ","address_street_number":"100","address_street_box":null,"email":"visit@europarl.europa.eu","website":"http:\/\/www.europarl.europa.eu\/visiting\/en\/brussels\/station-europe","phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Place du Luxembourg , 100","address_line2":"1050 Ixelles","description_web":"CLOSED TO VISITORS UNTIL FURTHER NOTICE.\r\nStation Europe, on the very lively place du Luxembourg, is the ideal starting point for seeing Europe in Brussels.\r\nHoused in the original Brussels-Luxembourg train station building, Station Europe is the perfect bridge between the area\u2019s past and its modern role as the home of European democracy.\r\n* Free\r\n* Available in 24 languages\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Station Europe","address_street_name":"Place du Luxembourg","address_street_number":"100","address_street_box":null,"email":"visit@europarl.europa.eu","website":"http:\/\/www.europarl.europa.eu\/visiting\/fr\/brussels\/station-europe","phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Place du Luxembourg, 100","address_line2":"1050 Ixelles","description_web":"Station Europe, sulla vivace Place du Luxembourg, \u00e8 il punto di partenza ideale per vedere l\u2019Europa a Bruxelles.. Il centro di accoglienza del Parlamento Europeo \u00e8 ricco di strumenti interattivi e ha di che stuzzicare la curiosit\u00e0 a tutte le et\u00e0. Personale cordiale \u00e8 a disposizione per mostrarvi tutto quello che c\u2019\u00e8 da fare al Parlamento Europeo e a Bruxelles stessa.. \r\n \r\nSituato nella palazzina originale della stazione Bruxelles-Lussemburgo, Station Europe collega perfettamente il passato di quest\u2019area, come Quartiere Leopold, e il suo ruolo moderno come casa della democrazia europea. \r\n  \r\nGuardate come il Parlamento Europeo diventa realt\u00e0 attraverso un modello del campus in 3D. Si pu\u00f2 anche guardare al passato attraverso riproduzioni in scala visibili da uno spioncino e vedere il Parlamento Europeo da diverse prospettive in momenti diversi della sua esistenza.   \r\nStation Europe \u00e8 anche una porta aperta su Bruxelles con visit.brussels a portata di mano per dare un assaggio di tutto ci\u00f2 che c\u2019\u00e8 da fare nella capitale belga. \r\n  \r\nUn caloroso benvenuto vi aspetta!\r\n  \r\n* Gratuito\r\n* Disponibile in 24 lingue\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Station Europe","address_street_name":"Place du Luxembourg","address_street_number":"100","address_street_box":null,"email":"visit@europarl.europa.eu","website":"http:\/\/www.europarl.europa.eu\/visiting\/fr\/brussels\/station-europe","phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Place du Luxembourg, 100","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"fr":{"name":"Station Europe","address_street_name":"Place du Luxembourg","address_street_number":"100","address_street_box":null,"email":"visit@europarl.europa.eu","website":"http:\/\/www.europarl.europa.eu\/visiting\/fr\/brussels\/station-europe","phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Place du Luxembourg, 100","address_line2":"1050 Ixelles","description_web":"FERMEE AUX VISITEURS JUSQU'A NOUVEL ORDRE.\r\nLa Station Europe, situ\u00e9e sur la tr\u00e8s anim\u00e9e place du Luxembourg, est le point de d\u00e9part id\u00e9al pour d\u00e9couvrir l'Europe \u00e0 Bruxelles. \r\nLog\u00e9e dans l\u2019ancienne gare de Bruxelles-Luxembourg, la Station Europe fait le lien entre le pass\u00e9 de cet emplacement, et son r\u00f4le moderne de foyer de la d\u00e9mocratie europ\u00e9enne.\r\n* Gratuit\r\n* Disponible en 24 langues\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Estaci\u00f3n Europa","address_street_name":"Place du Luxembourg ","address_street_number":"100","address_street_box":null,"email":"visit@europarl.europa.eu","website":"http:\/\/www.europarl.europa.eu\/visiting\/en\/brussels\/station-europe","phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Place du Luxembourg , 100","address_line2":"1050 Ixelles","description_web":"La estaci\u00f3n Europa (\u201cStation Europe\u201d) est\u00e1 situada en la animada plaza de Luxemburgo y es el punto de partida ideal para ver Europa en Bruselas. Este punto de bienvenida del Parlamento Europeo est\u00e1 lleno de herramientas interactivas y tiene algo para despertar la curiosidad de todas las edades. El amable personal tambi\u00e9n est\u00e1 disponible para mostrarle no solo todo lo que hay que hacer en el Parlamento Europeo sino tambi\u00e9n en la propia Bruselas.\r\n  \r\nUbicada en el edificio original de la estaci\u00f3n de tren de Bruselas-Luxemburgo, la estaci\u00f3n Europa (\u201cStation Europe\u201d) une perfectamente el pasado de la zona cuando solo era el Barrio Leopold, con su papel moderno como hogar de la democracia europea.\r\n\r\nVea c\u00f3mo el Parlamento Europeo cobra vida con una maqueta del campus. Incluso puede mirar al pasado con dioramas de mirilla y ver el Parlamento Europeo desde diferentes \u00e1ngulos, en diferentes momentos de su vida.\r\n  \r\nLa estaci\u00f3n Europa es tambi\u00e9n su puerta de entrada a Bruselas ya que la oficina de turismo de visit.brussels se encuentra tambi\u00e9n all\u00ed para darle una idea de todo lo que hay que hacer en la capital belga. \u00a1Le espera una c\u00e1lida bienvenida!\r\n  \r\n* Gratuito\r\n* Disponible en 24 idiomas\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Station Europa","address_street_name":"Luxemburgplein","address_street_number":"100","address_street_box":null,"email":"visit@europarl.europa.eu","website":"https:\/\/visiting.europarl.europa.eu\/nl\/visitor-offer\/brussels\/station-europe","phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Luxemburgplein, 100","address_line2":"1050 Ixelles","description_web":"VOORLOPIG GESLOTEN VOOR BEZOEKERS\r\nStation Europa ligt op het bruisende Luxemburgplein. Het is het ideale vertrekpunt voor je Europese tocht in Brussel. \r\nStation Europa is ondergebracht in het voormalige stationsgebouw van Brussel-Luxemburg. Het legt perfect de link tussen verleden en heden.\r\nHier zie je het Europees Parlement tot leven komen aan de hand van augmented reality. Duik bij de touchscreentafels in de geschiedenis van het Europees Parlement.  Treed in de voetsporen van je favoriete, inspirerende persoonlijkheden. Diorama's werpen zelfs een blik in het verleden en tonen je het Europees Parlement in verschillende periodes. \r\nStation Europa is ook de ideale toegangspoort tot Brussel. Want visit.brussels geeft je er een voorsmaakje van het beste wat Brussel heeft te bieden. \r\nJe bent meer dan welkom!   \r\n* gratis\r\n * in 24 talen \r\n\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[9],"translations":{"de":["Europ\u00e4isches Viertel"],"pt":[null],"en":["European Quarter"],"it":["Quartiere europeo"],"cn":[null],"fr":["Quartier europ\u00e9en"],"sp":["Barrio Europeo"],"nl":["Europese wijk"]}},"zones":[],"neca":null,"facebook_id":null,"backoffice_id":26898,"location":{"lat":50.83914868,"lon":4.3736068},"region":"brussels","last_updated_at":"2022-10-10T10:25:09+02:00","published_at":"2016-12-14T09:03:56+01:00","import_origin":null,"external_id":null,"is_in_address_book":false,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":230072,"translations":{"de":{"name":"Itin\u00e9raires","address_street_name":"Rue de l'Aqueduc","address_street_number":"171","address_street_box":null,"email":"info@itineraires.be","website":"http:\/\/www.itineraires.be","phone_contact":"+32 495 38 85 94","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Aqueduc, 171","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Itin\u00e9raires","address_street_name":"Rue de l'Aqueduc","address_street_number":"171","address_street_box":null,"email":"info@itineraires.be","website":"http:\/\/www.itineraires.be","phone_contact":"+32 495 38 85 94","phone_booking":null,"ad