"parent_events":[],"targets":{"list":[],"translations":{}},"opening":{"day":"2023-03-16","start":"18:00:00","timestamp":"2023-03-16T18:00:00+01:00","end":"21:00:00","is_only_by_appointment":false},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-03-26T04:07:47+02:00","published_at":"2023-03-10T13:35:57+01:00","backoffice_id":273168,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.3568829277518},{"id":551274,"date_start":"2023-03-09","date_end":"2023-05-06","date_next":"2023-03-28","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung","it":"Esposizioni","sp":"Exhibici\u00f3n","pt":null,"cn":null}},"others":{"list":[24,34],"translations":{"fr":["Galeries d'art","Pluridisciplinaire"],"nl":["Galeries","Pluridisciplinair"],"en":["Art Galleries","Multidisciplinary"],"de":["Kunstgalerien","Multidisziplin\u00e4r"],"it":["Gallerie d'arte","Multidisciplinare"],"sp":["Galer\u00edas de arte","Multidisciplinar"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","en"],"subtitles":[]},"translations":{"fr":{"name":"Dorota Buczkowska, Sandra Lecoq, Tatiana Wolska - '\u00c9cologies Intimes'","shortdescr":"Nous sommes ravies d\u2019annoncer Ecologies intimes, une exposition qui rassemble trois artistes femmes li\u00e9es par une amiti\u00e9 commune et des pratiques compl\u00e9mentaires : Tatiana Wolska, Dorota Buczkowska et Sandra Lecoq.","longdescr":"\u00ab Une bouteille en plastique, un drap jauni par le temps, une feuille de papier, une chute de carton, de bois, un ve\u0302tement de\u0301chire\u0301, les mate\u0301riaux qui fondent les pratiques artistiques de Tatiana Wolska (1977), Dorota Buczkowska (1971) et Sandra Lecoq (1972) appartiennent au quotidien. Les trois artistes s\u2019emploient a\u0300 transformer et a\u0300 sublimer le presque rien, la matie\u0300re invisible, voire inde\u0301sirable. Une e\u0301conomie de moyen est mise au service de re\u0301flexions plastiques, poe\u0301tiques et politiques ou\u0300 le territoire de l\u2019intime est explore\u0301 couche par couche, point par point, motif par motif. L\u2019intime est traduit visuellement au moyen de formes sensuelles et organiques, des corps enlace\u0301s, de superpositions, de profondeurs, de matie\u0300res textiles imbibe\u0301es d\u2019histoires anonymes, de myste\u0300res et de secrets. \u00bb \r\n- Julie Crenn","performers":null,"boxoffice_url":null,"website":"https:\/\/irenelaubgallery.com\/news_exhibitons\/ecologies-intimes\/","email":"info@irenelaubgallery.be","phone_contact":null,"phone_booking":"+32 2 647 55 16","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.551274"},"nl":{"name":"Dorota Buczkowska, Sandra Lecoq, Tatiana Wolska - '\u00c9cologies Intimes'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/irenelaubgallery.com\/news_exhibitons\/ecologies-intimes\/","email":"info@irenelaubgallery.be","phone_contact":null,"phone_booking":"+32 2 647 55 16","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.551274"},"en":{"name":"Dorota Buczkowska, Sandra Lecoq, Tatiana Wolska - '\u00c9cologies Intimes'","shortdescr":"We are delighted to announce Ecologies intimes, an exhibition that brings together three woman artists linked by a common friendship and complementary practices: Tatiana Wolska, Dorota Buczkowska and Sandra Lecoq.","longdescr":"\"A plastic bottle, a bed sheet yellowed by time, a sheet of paper, a scrap of cardboard or wood, a torn piece of clothing - the materials that form the basis of the artistic practices of Tatiana Wolska (1977), Dorota Buczkowska (1971) and Sandra Lecoq (1972) belong to the everyday. The three artists strive to transform and sublimate the almost nothing, the invisible, or even undesirable materials. Their economy of means is put at the service of visual, poetic and political reflections where the landscape of the intimate is explored layer by layer, point by point, texture by texture. The intimate is visually conveyed through sensual and organic forms, embracing bodies, superimpositions, depths and textile materials imbued with anonymous stories, mysteries and secrets. \u00bb\r\n - Julie Crenn","performers":null,"boxoffice_url":null,"website":"https:\/\/irenelaubgallery.com\/news_exhibitons\/ecologies-intimes\/","email":"info@irenelaubgallery.be","phone_contact":null,"phone_booking":"+32 2 647 55 16","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.551274"},"de":{"name":"Dorota Buczkowska, Sandra Lecoq, Tatiana Wolska - '\u00c9cologies Intimes'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/irenelaubgallery.com\/news_exhibitons\/ecologies-intimes\/","email":"info@irenelaubgallery.be","phone_contact":null,"phone_booking":"+32 2 647 55 16","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.551274"},"it":{"name":"Dorota Buczkowska, Sandra Lecoq, Tatiana Wolska - '\u00c9cologies Intimes'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/irenelaubgallery.com\/news_exhibitons\/ecologies-intimes\/","email":"info@irenelaubgallery.be","phone_contact":null,"phone_booking":"+32 2 647 55 16","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.551274"},"sp":{"name":"Dorota Buczkowska, Sandra Lecoq, Tatiana Wolska - '\u00c9cologies Intimes'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/irenelaubgallery.com\/news_exhibitons\/ecologies-intimes\/","email":"info@irenelaubgallery.be","phone_contact":null,"phone_booking":"+32 2 647 55 16","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.551274"},"pt":{"name":"Dorota Buczkowska, Sandra Lecoq, Tatiana Wolska - '\u00c9cologies Intimes'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/irenelaubgallery.com\/news_exhibitons\/ecologies-intimes\/","email":"info@irenelaubgallery.be","phone_contact":null,"phone_booking":"+32 2 647 55 16","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.551274"},"cn":{"name":"Dorota Buczkowska, Sandra Lecoq, Tatiana Wolska - '\u00c9cologies Intimes'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/irenelaubgallery.com\/news_exhibitons\/ecologies-intimes\/","email":"info@irenelaubgallery.be","phone_contact":null,"phone_booking":"+32 2 647 55 16","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.551274"}},"place":{"id":248003,"translations":{"fr":{"name":"Ir\u00e8ne Laub Gallery","address_street_name":"Rue Van Eyck","address_street_number":"29","address_street_box":null,"email":"info@irenelaubgallery.be","website":"http:\/\/www.irenelaubgallery.com","phone_contact":"+32 2 647 55 16","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Van Eyck, 29","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":"LAUB","virtual_visit":null},"nl":{"name":"Ir\u00e8ne Laub Gallery","address_street_name":"Van Eyckstraat","address_street_number":"29","address_street_box":null,"email":"info@irenelaubgallery.be","website":"http:\/\/www.irenelaubgallery.com","phone_contact":"+32 2 647 55 16","phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"Van Eyckstraat, 29","address_line2":"1050 Elsene","description_web":"","description_print":"","booking_url":null,"sort_order":"LAUB","virtual_visit":null},"en":{"name":"Ir\u00e8ne Laub Gallery","address_street_name":"Rue Van Eyck","address_street_number":"29","address_street_box":null,"email":"info@irenelaubgallery.be","website":"http:\/\/www.irenelaubgallery.com","phone_contact":"+32 2 647 55 16","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Van Eyck, 29","address_line2":"1050 Ixelles","description_web":"Since 2016, Ir\u00e8ne Laub Gallery exhibits established and emerging artists in Brussels and in a selection of international art fairs. Our represented artists are actively committed to questioning social, political and architectural spaces. They present a very diverse body of work \u2013 inculding installation, video, sculpture, painting and drawing \u2013 and display pure and powerful aesthetics. The gallery is intended as an adaptable experimentation space, allowing the artists to stretch the boundaries of their chosen discipline, either by testing and distorting the physical frame of the work itself, or by exploring its significance in the social sphere.\r\nIn 2018, the gallery moved to a new location and developed an ambitious exhibition programme, dedicated to further a productive dialogue between international artists, curators and institutions.\r\n","description_print":"","booking_url":null,"sort_order":"LAUB","virtual_visit":null},"de":{"name":"Ir\u00e8ne Laub Gallery","address_street_name":"Rue Van Eyck","address_street_number":"29","address_street_box":null,"email":"info@irenelaubgallery.be","website":"http:\/\/www.irenelaubgallery.com","phone_contact":"+32 2 647 55 16","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Van Eyck, 29","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Ir\u00e8ne Laub Gallery","address_street_name":"Rue Van Eyck","address_street_number":"29","address_street_box":null,"email":"info@irenelaubgallery.be","we