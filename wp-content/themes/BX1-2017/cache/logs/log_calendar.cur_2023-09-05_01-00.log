in de hoofdstad van Europa dat internationaal gerenommeerde operaproducties, dansvoorstellingen, concerten en recitals produceert en presenteert. De Munt beschikt over een eigen symfonieorkest, een koor, eigen ateliers en een gepassioneerde artistieke ploeg, waarmee het operahuis ijvert om elk seizoen weer een gevarieerd en vooruitstrevend programma te kunnen realiseren dat over de grenzen van genres, periodes en culturele verschillen heen durft te kijken. Bovendien organiseert de Munt ontmoetingen met kunstenaars, schrijvers en intellectuelen, die u uitnodigen om nieuwe paden te verkennen en uw horizon te verbreden.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":208,"location":{"lat":50.84996484,"lon":4.35348679},"last_updated_at":"2022-10-10T10:25:09+02:00","published_at":"2013-10-19T01:13:21+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"poster","link":"https:\/\/agendabrussels2.imgix.net\/99de73614a27228bb61d826585a189c26569b215.jpeg","width":1920,"height":1080,"ratio":1,"oEmbed_height":1080,"oEmbed_width":1920,"translations":{"de":{"title":"Casssandra Festival \u00e0 la Monnaie","copyright":null},"pt":{"title":"Casssandra Festival \u00e0 la Monnaie","copyright":null},"en":{"title":"Cassandra Festival at la Monnaie","copyright":null},"it":{"title":"Casssandra Festival \u00e0 la Monnaie","copyright":null},"cn":{"title":"Casssandra Festival \u00e0 la Monnaie","copyright":null},"fr":{"title":"Casssandra Festival \u00e0 la Monnaie","copyright":null},"sp":{"title":"Casssandra Festival \u00e0 la Monnaie","copyright":null},"nl":{"title":"Cassandra Festival bij de Munt","copyright":null}}}],"dates":[{"day":"2023-09-17","doors":null,"start":"00:00:00","end":null,"is_soldout":false,"is_canceled":false},{"day":"2023-09-18","doors":null,"start":"00:00:00","end":null,"is_soldout":false,