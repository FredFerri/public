koffice_id":291589,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.30571070873287987,"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[34,24],"translations":{"de":["Multidisziplin\u00e4r","Kunstgalerien"],"pt":[null,null],"en":["Multidisciplinary","Art Galleries"],"it":["Multidisciplinare","Gallerie d'arte"],"cn":[null,null],"fr":["Pluridisciplinaire","Galeries d'art"],"sp":["Multidisciplinar","Galer\u00edas de arte"],"nl":["Pluridisciplinair","Galeries"]}}},"translations":{"de":{"name":"Samuel Levy - Black Forest","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/micheleschoonjansgallery.be\/upcoming","email":"info@msgallery.be","phone_contact":"+32 478 71 62 96","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50005689"},"pt":{"name":"Samuel Levy - Black Forest","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/micheleschoonjansgallery.be\/upcoming","email":"info@msgallery.be","phone_contact":"+32 478 71 62 96","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50005689"},"en":{"name":"Samuel Levy - Black Forest","shortdescr":"The \u201cBlack Forest\u201d project embodies a commitment to forsake artifice, positioning itself authentically within nature. Black forms intertwine and contort like authentic natural organisms, advancing on paper or canvas in a proliferation reminiscent of flourishing nature.\n","longdescr":"Samuel Levy unveils his second exhibition, \u201cBlack Forest,\u201d at the Mich\u00e8le Schoonjans Gallery in Brussels, captivating audiences from January 14th to February 17th, 2024.\n\n\nFor years, artist Samuel Levy has dedicated himself to capturing the essence of our natural world through his \u201cInner Landscape\u2019 project. Rather than merely depicting nature as we see it, his objective is to reveal every cell and fragment that constitutes it. Initially, the viewer recognises organic and vegetal forms\u2014branches and leaves adorned in vibrant hues. Yet, as one delves deeper, these forms transport us into a universe transcending our ordinary perception of the world. Guided along lines and through matter, we plunge into the core of a nature that intricately reconnects us with ourselves.\n\nThe \u201cBlack Forest\u201d project embodies a commitment to forsake artifice, positioning itself authentically within nature. The profusion of colours takes a back seat, allowing drawing and material to take center stage. Black forms intertwine and contort like authentic natural organisms, advancing on paper or canvas in a proliferation reminiscent of flourishing nature.\n\nHowever, these black forests also symbolise nature ravaged by flames, nearly lifeless. Black and white fiercely clash against a vast blue backdrop. Branches shatter in some places, while in others, new forms flourish. Thus, within this chaos, we discern life\u2014unfolding without adhering to any predetermined pattern, unrestricted by rules.\n\nThe canvas becomes a spectacle of cells multiplying freely, each one seemingly absorbing us into this molten amalgamation, connecting us to the very life that resides within. \u201cBlack Forest\u201d authentically situates itself at the heart of nature. Black forms entwine and twist like genuine natural organisms, progressing on paper or canvas in a proliferation reminiscent of nature in full bloom.\n\nThis unique immersion awaits discovery at the Mich\u00e8le Schoonjans Gallery.\n","performers":"Samuel Levy (artist), Mich\u00e8le Schoonjans Gallery (gallery)","boxoffice_url":null,"website":"https:\/\/micheleschoonjansgallery.be\/upcoming","email":"info@msgallery.be","phone_contact":"+32 478 71 62 96","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50005689"},"it":{"name":"Samuel Levy - Black Forest","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/micheleschoonjansgallery.be\/upcoming","email":"info@msgallery.be","phone_contact":"+32 478 71 62 96","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50005689"},"cn":{"name":"Samuel Levy - Black Forest","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/micheleschoonjansgallery.be\/upcoming","email":"info@msgallery.be","phone_contact":"+32 478 71 62 96","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50005689"},"fr":{"name":"Samuel Levy - Black Forest","shortdescr":"Le projet \u201cBlack Forest\u201d met en avant la volont\u00e9 de ne plus recourir \u00e0 des artifices, se positionnant v\u00e9ritablement au c\u0153ur de la nature. Les formes noires s\u2019entrelacent et se tortillent comme de v\u00e9ritables organismes naturels, progressant sur le papier ou la toile dans une prolif\u00e9ration rappelant une nature fleurissante.","longdescr":"Du 14 janvier au 17 f\u00e9vrier 2024, la Mich\u00e8le Schoonjans Gallery pr\u00e9sente \u201cBlack Forest\u201d, marquant ainsi la deuxi\u00e8me exposition personnelle des \u0153uvres de Samuel Levy au sein de ses murs.\n\nPendant plusieurs ann\u00e9es, l\u2019artiste Samuel Levy s\u2019est efforc\u00e9 de retranscrire, \u00e0 travers son projet \u201cInner Landscape\u201d, la beaut\u00e9 de notre environnement naturel. L\u2019objectif n\u2019est pas de repr\u00e9senter la nature telle que nous la percevons, mais de nous montrer chaque cellule, chaque fragment qui la compose. D\u00e8s le premier regard, on discerne des formes organiques, v\u00e9g\u00e9tales, des branchages ou des feuilles aux couleurs foisonnantes. Progressivement, ces formes nous immergent au c\u0153ur d\u2019un univers qui transcende notre perception du monde qui nous entoure. Nous sommes comme happ\u00e9s au fil des lignes et de la mati\u00e8re, plongeant au c\u0153ur de cette nature qui nous reconnecte avec nous-m\u00eames.\n\nLe projet \u201cBlack Forest\u201d met en avant la volont\u00e9 de ne plus recourir \u00e0 des artifices, se positionnant v\u00e9ritablement au c\u0153ur de la nature. La profusion de couleurs est mise de c\u00f4t\u00e9 pour mettre l\u2019accent sur le dessin et la mati\u00e8re. Les formes noires s\u2019entrelacent et se tortillent comme de v\u00e9ritables organismes naturels, progressant sur le papier ou la toile dans une prolif\u00e9ration rappelant une nature fleurissante.\n\nCependant, ces for\u00eats noires sont aussi la retranscription d\u2019une nature ravag\u00e9e par les flammes, presque morte. Le noir et le blanc luttent avec ferveur sur un grand fond bleu. Les branches se cassent par endroits, tandis qu\u2019\u00e0 d\u2019autres endroits, de nouvelles formes apparaissent. On per\u00e7oit ainsi de la vie dans ce chaos, une vie qui prend forme sans suivre aucun sch\u00e9ma \u00e9tabli, aucune r\u00e8gle.\n\nNous sommes face \u00e0 un spectacle de cellules qui prolif\u00e8rent librement sur la toile, chaque cellule semblant nous absorber au sein de ce magma pour nous relier \u00e0 elles et nous plonger au coeur de cette vie qui nous habite.\n\n\u201cBlack Forest\u201d se place v\u00e9ritablement au c\u0153ur de la nature. Les formes noires s\u2019entrelacent et se tortillent comme de v\u00e9ritables organismes naturels, progressant sur le papier ou la toile dans une prolif\u00e9ration semblable \u00e0 une nature fleurissante.\n\nUne singuli\u00e8re immersion \u00e0 d\u00e9couvrir \u00e0 la Mich\u00e8le Schoonjans Gallery.\n","performers":"Samuel Levy (artiste plasticien),  Mich\u00e8le Schoonjans Gallery (galerie)","boxoffice_url":null,"website":"https:\/\/micheleschoonjansgallery.be\/upcoming","email":"info@msgallery.be","phone_contact":"+32 478 71 62 96","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50005689"},"sp":{"name":"Samuel Levy - Black Forest","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/micheleschoonjansgallery.be\/upcoming","email":"info@msgallery.be","phone_contact":"+32 478 71 62 96","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50005689"},"nl":{"name":"Samuel Levy - Black Forest","shortdescr":"\u201cBlack Forest\u201d bevindt zich werkelijk in het hart van de natuur. Zwarte vormen vlechten en kronkelen als echte natuurlijke organismen, voortbewegend op papier of doek in een voortwoekerende groei die doet denken aan een bloeiende natuur.","longdescr":"Onder de titel \u201cBlack Forest\u201d brengt Samuel Levy zijn tweede tentoonstelling in de Mich\u00e8le Schoonjans Gallery in Brussel. De tentoonstelling vindt plaats van 14 januari tot en met 17 februari 2024.\n\n\nVoor vele jaren heeft kunstenaar Samuel Levy zich ingezet om, via zijn project Inner Landscape, de schoonheid van onze natuurlijke omgeving over te brengen. Het doel is niet om de natuur weer te geven zoals wij die waarnemen, maar om ons elk celletje, elk fragment te tonen dat haar vormt. Bij het eerste gezicht onderscheiden we organische en plantaardige vormen, takken en bladeren in schitterende kleuren. Geleidelijk aan dompelen deze vormen ons onder in een universum dat onze perceptie van de wereld om ons heen overstijgt. We worden als het ware meegesleept door de lijnen en de materie, duikend in het hart van deze natuur die ons opnieuw verbindt met onszelf.\n\nHet project \u201cBlack Forest\u201d benadrukt de wens om geen gebruik meer te maken van kunstgrepen en plaatst zich werkelijk in het hart van de natuur. De overvloed aan kleuren wordt terzijde geschoven om de nadruk te leggen op tekenen en materiaal. Zwarte vormen vlechten en kronkelen als ware natuurlijke organismen, voortbewegend op papier of doek in een voortwoekerende groei vergelijkbaar met een bloeiende natuur.\n\nDesondanks zijn deze zwarte bossen ook een weergave van een door vlammen verwoeste, bijna dode natuur. Zwart en wit strijden met hartstocht op een groot blauw oppervlak. Takken breken op sommige plaatsen, terwijl op andere plekken nieuwe vormen opbloeien. Zo ontwaren we leven in deze chaos, een leven dat vorm krijgt zonder enig vast patroon, zonder regels te volgen.\n\nWe staan voor een schouwspel van cellen die vrijelijk op het doek woekeren, elke cel lijkt ons op te nemen in deze massa en ons te verbinden met dit leven dat in ons huist. \u201cBlack Forest\u201d bevindt zich werkelijk in het hart van de natuur. Zwarte vormen vlechten en kronkelen als echte natuurlijke organismen, voortbewegend op papier of doek in een voortwoekerende groei die doet denken aan een bloeiende natuur.\n\nU bent van harte welkom  om zelf het werkt van Samuel Levy te ontdekken in de Mich\u00e8le Schoonjans Gallery.\n","performers":"Samuel Levy (kunstenaar),  Mich\u00e8le Schoonjans Gallery (kunst galerij)","boxoffice_url":null,"website":"https:\/\/micheleschoonjansgallery.be\/upcoming","email":"info@msgallery.be","phone_contact":"+32 478 71 62 96","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50005689"}},"place":{"id":275036,"translations":{"de":{"name":"SchoonjanS&Vandenbussche Gallery ","address_street_name":"Chauss\u00e9e de Waterloo","address_street_number":"690","address_street_box":"Rivoli #25","email":"info@micheleschoonjansgallery.be","website":"http:\/\/www.micheleschoonjansgallery.be","phone_contact":"+32 478 71 62 96","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Chauss\u00e9e de Waterloo, 690 \/ Rivoli #25","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit"