Vizzavona","copyright":null},"cn":{"title":"Maison Vizzavona","copyright":null}}}],"dates":[{"day":"2023-03-12","doors":null,"start":"14:00:00","end":"16:00:00","is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"},"de":{"name":"Normal"},"it":{"name":"Normale"},"sp":{"name":"Normal"},"pt":{"name":"Normal"},"cn":{"name":"Normal"}},"value":18},{"translations":{"fr":{"name":"Enfants"},"nl":{"name":"Kinderen"},"en":{"name":"Children"},"de":{"name":"Kinder"},"it":{"name":"Bambini"},"sp":{"name":"Ni\u00f1os"},"pt":{"name":"Enfants"},"cn":{"name":"Enfants"}},"value":14}],"child_events":[],"parent_events":[],"targets":{"list":[11],"translations":{"fr":["Famille"],"nl":["Familie"],"en":["Family"],"de":["Familie"],"it":["Famiglie"],"sp":["Familias"],"pt":[null],"cn":[null]}},"visit_profile":{"list":[322],"translations":{"fr":["Art Nouveau & Art D\u00e9co"],"nl":["Art nouveau & art deco"],"en":["Art Nouveau &  Art D\u00e9co"],"de":["Jugendstil & Art d\u00e9co"],"it":["Art Nouveau e Art D\u00e9co"],"sp":["Art nouveau y art d\u00e9co"],"pt":[null],"cn":[null]}},"tags":["kids"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-02-18T07:06:37+01:00","published_at":"2023-01-02T08:45:34+01:00","backoffice_id":268220,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":1},{"id":546192,"date_start":"2023-03-12","date_end":"2023-03-26","date_next":"2023-03-12","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen","it":"Visite guidate","sp":"Visitas guiadas","pt":null,"cn":null}},"others":{"list":[104],"translations":{"fr":["Art Nouveau, Art D\u00e9co"],"nl":["Art nouveau, art deco"],"en":["Art Nouveau, Art D\u00e9co"],"de":["Jugendstil, Art d\u00e9co"],"it":["Art Nouveau, Art D\u00e9co"],"sp":["Art nouveau, art d\u00e9co"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Symbolisme, id\u00e9alisme et Art nouveau au Mus\u00e9e Fin-de-Si\u00e8cle: visites guid\u00e9es pour le public individuel","shortdescr":"Exceptionnel carrefour des arts et avant-gardes depuis les expositions du Groupe des XX et La Libre Esth\u00e9tique, Bruxelles \"Fin de si\u00e8cle\" \u00e9tablit aussi une convergence entre le Symbolisme, sa variante l'Id\u00e9alisme et l'Art nouveau.","longdescr":"L'art total, depuis l'op\u00e9ra de Wagner, est un concept qui stimule les cr\u00e9ateurs, qu'ils soient artistes peintres, compositeurs, architectes et \u00e9crivains. Khnopff, par exemple, est peintre, sculpteur, cr\u00e9ateur de d\u00e9cors et de costumes, illustrateur de livres, adepte de la photographie et inventeur de sa propre maison \"Temple du Moi\". Si les symbolistes se tournent davantage vers l'exclusivit\u00e9 et l'int\u00e9riorit\u00e9, l'Art nouveau aspire, en th\u00e9orie, \u00e0 une pratique plus \"sociale\", introduisant la beaut\u00e9 dans les quotidiens. L'exceptionnelle collection Gillion Crowet brasse ces courants et confronte les cr\u00e9ations bruxelloises de Horta, Khnopff, Wolfers ou Delville aux exemples internationaux de Daum, Majorelle, Lalique ou Mucha.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.fine-arts-museum.be","email":"reservation@fine-arts-museum.be","phone_contact":null,"phone_booking":"+32 2 508 33 33","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.546192"},"nl":{"name":"Symbolisme, Idealisme en Art Nouveau in het Fin-de-Si\u00e8cle Museum: Rondleiding voor individuele bezoekers","shortdescr":"Als uitzonderlijk kruispunt van kunst en avant-gardes sinds de tentoonstellingen van de Kunstkring Les XX en La Libre Esth\u00e9tique, brengt het Brussel van het \"Fin de si\u00e8cle\" ook een convergentie tot stand tussen het symbolisme, zijn variant het idealisme en de Art Nouveau.","longdescr":"Totale kunst is sinds de Wagners opera\u2019s een concept dat kunstenaars stimuleert, of het nu gaat om schilders, componisten, architecten of schrijvers. Zo is Fernand Khnopff zowel schilder, beeldhouwer, ontwerper van decors en kostuums, boekillustrator, bedreven in fotografie als uitvinder van zijn eigen huis \"Tempel van het ik\". Terwijl symbolisten zich meer richtten op exclusiviteit en innerlijkheid, streefde de Art Nouveau in theorie naar een meer \"sociale\" praktijk, die de schoonheid in het dagelijks leven introduceerde. De uitzonderlijke verzameling Gillion Crowet vermengt deze stromingen en confronteert de Brusselse creaties van Horta, Khnopff , Wolfers of Delville met internationale voorbeelden van Daum, Majorelle, Lalique of Mucha.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.fine-arts-museum.be","email":"reservation@fine-arts-museum.be","phone_contact":null,"phone_booking":"+32 2 508 33 33","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.546192"},"en":{"name":"Symbolisme, id\u00e9alisme et Art nouveau au Mus\u00e9e Fin-de-Si\u00e8cle: visites guid\u00e9es pour le public individuel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.fine-arts-museum.be","email":"reservation@fine-arts-museum.be","phone_contact":null,"phone_booking":"+32 2 508 33 33","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.546192"},"de":{"name":"Symbolisme , id\u00e9alisme et Art nouveau au Mus\u00e9e Fin-de-Si\u00e8cle Visites guid\u00e9es pour le public individuel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.fine-arts-museum.be","email":"reservation@fine-arts-museum.be","phone_contact":null,"phone_booking":"+32 2 508 33 33","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.546192"},"it":{"name":"Symbolisme , id\u00e9alisme et Art nouveau au Mus\u00e9e Fin-de-Si\u00e8cle Visites guid\u00e9es pour le public individuel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.fine-arts-museum.be","email":"reservation@fine-arts-museum.be","phone_contact":null,"phone_booking":"+32 2 508 33 33","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.546192"},"sp":{"name":"Symbolisme , id\u00e9alisme et Art nouveau au Mus\u00e9e Fin-de-Si\u00e8cle Visites guid\u00e9es pour le public individuel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.fine-arts-museum.be","email":"reservation@fine-arts-museum.be","phone_contact":null,"phone_booking":"+32 2 508 33 33","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.546192"},"pt":{"name":"Symbolisme , id\u00e9alisme et Art nouveau au Mus\u00e9e Fin-de-Si\u00e8cle Visites guid\u00e9es pour le public individuel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.fine-arts-museum.be","email":"reservation@fine-arts-museum.be","phone_contact":null,"phone_booking":"+32 2 508 33 33","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.546192"},"cn":{"name":"Symbolisme , id\u00e9alisme et Art nouveau au Mus\u00e9e Fin-de-Si\u00e8cle Visites guid\u00e9es pour le public individuel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.fine-arts-museum.be","email":"reservation@fine-arts-museum.be","phone_contact":null,"phone_booking":"+32 2 508 33 33","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.546192"}},"place":{"id":488,"translations":{"fr":{"name":"Mus\u00e9es Royaux des Beaux-Arts de Belgique","address_street_name":"Rue de la R\u00e9gence","address_street_number":"3","address_street_box":null,"email":"info@fine-arts-museum.be","website":"http:\/\/www.fine-arts-museum.be","phone_contact":"+32 2 508 32 11","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la R\u00e9gence, 3","address_line2":"1000 Bruxelles","description_web":"Les Mus\u00e9es Royaux des Beaux-Arts de Belgique sont constitu\u00e9s de six mus\u00e9es bruxellois: le Mus\u00e9e Oldmasters Museum, le Mus\u00e9e Modern Museum, le Mus\u00e9e Meunier Museum, le Mus\u00e9e Wiertz Museum, le Magritte Museum et le Mus\u00e9e fin-de-si\u00e8cle Museum.","description_print":"","booking_url":null,"sort_order":"Royal Museums of Fine Arts of Belgium","virtual_visit":null},"nl":{"name":"Koninklijke Musea voor Schone Kunsten van Belgi\u00eb","address_street_name":"Regentschapsstraat","address_street_number":"3","address_street_box":null,"email":"info@fine-arts-museum.be","website":"http:\/\/www.fine-arts-museum.be","phone_contact":"+32 2 508 32 11","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Regentschapsstraat, 3","address_line2":"1000 Brussel","description_web":"Onder de hoede van de Koninklijke Musea voor Schone Kunsten van Belgi\u00eb staan zes afzonderlijke musea: het Mus\u00e9e Oldmasters Museum, het Mus\u00e9e Modern Museum, het Mus\u00e9e Meunier Museum, het Mus\u00e9e Wiertz Museum, het Magritte Museum en het Mus\u00e9e fin-de-si\u00e8cle Museum.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Royal Museums of Fine Arts of Belgium","address_street_name":"rue de la R\u00e9gence","address_street_number":"3","address_street_box":null,"email":"info@fine-arts-museum.be","website":"http:\/\/www.fine-arts-museum.be","phone_contact":"+32 2 508 32 11","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"rue de la R\u00e9gence, 3","address_line2":"1000 Brussels","description_web":"The Royal Museums of Fine Arts of Belgium assemble six different museums: the Oldmasters Museum, Modern Museum, Meunier Museum, Wiertz Museum, Magritte Museum and the Fin-de-Si\u00e8cle Museum.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Mus\u00e9es Royaux des Beaux-Arts de Belgique","address_street_name":"Rue de la R\u00e9gence","address_street_number":"3","address_street_box":null,"email":"info@fine-arts-museum.be","website":"http:\/\/www.fine-arts-museum.be","phone_contact":"+32 2 508 32 11","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la R\u00e9gence, 3","address_line2":"1000 Bruxelles","description_web":"Die Mus\u00e9es Royaux des Beaux-Arts de Belgique \u2013 6 Museen, 7 Jahrhunderte der sch\u00f6nen K\u00fcnste, 20 000 Kunstwerke und Kunstgenuss vom Feinsten:\r\n\r\n\u2022\tIm Mus\u00e9e Magritte gibt es die weltweit gr\u00f6\u00dfte Sammlung von Werken des gro\u00dfen belgischen Surrealisten Ren\u00e9 Magritte zu entdecken\r\n\r\n\u2022\tIm Mus\u00e9e Fin-de-Si\u00e8cle erwartet den Besucher mit K\u00fcnstlern wie Khnopff, Spilliaert, Horta, Rodin, Gauguin, Mucha und Bonnard das besondere Fin-de-Si\u00e8cle-Ambiente, das um 1900 in Br\u00fcssel herrschte. Mehr als 30 K\u00fcnstler \u2013 vom Impressionismus \u00fcber den Jugendstil, von den sch\u00f6nen K\u00fcnsten bis zur Oper.\r\n\r\n\u2022\tIm Mus\u00e9e Old Master gibt es Meisterwerke aus der Epoche des 15. Jahrhunderts bis hin zum 18. Jahrhundert zu sehen, unter anderem mit der weltweit gr\u00f6\u00dften Bruegel-Sammlung, verschiedenen Werken von Rubens, van der Weyden und Jordaens. \r\n\r\n\u2022\tDas Mus\u00e9e Modern Art zeigt eine Auswahl von Meisterwerken des 20. Jahrhunderts, darunter Broodthaers, Fabre, David, Panamarenko, Alechinsky.\r\n\r\n\u2022\tDie beiden Kunstatelier-Museen Mus\u00e9e Wiertz und Meunier in Ixelles geben einen faszinierenden Einblick in die Welt dieser beiden K\u00fcnstler.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Museo Reale delle Belle Arti del Belgio","address_street_name":"Rue de la R\u00e9gence","address_street_number":"3","address_street_box":null,"email":"info@fine-arts-museum.be","website":"http:\/\/www.fine-arts-museum.be\/","phone_contact":"+32 2 508 32 11","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la R\u00e9gence, 3","address_line2":"1000 Bruxelles","description_web":"I Musei Reali delle Belle Arti del Belgio sono sei musei di Bruxelles: l'Oldmasters Museum, il Mus\u00e9e Modern, il Meunier Museum, il Wiertz Museum, il Magritte Museum ed il Fin-de-si\u00e8cle Museum.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Museos Reales de Bellas Artes de B\u00e9lgica","address_street_name":"rue de la R\u00e9gence","address_street_number":"3","address_street_box":null,"email":"info@fine-arts-museum.be","website":"http:\/\/www.fine-arts-museum.be","phone_contact":"+32 2 508 32 11","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"rue de la R\u00e9gence, 3","address_line2":"1000 Bruxelles","description_web":"Los Museos Reales de Bellas Artes de B\u00e9lgica son seis museos situados en Bruselas: el Museo de Arte Antiguo, el Museo de Arte Moderno, el Museo Meunier, el Museo Wiertz, el Museo Magritte y el Museo de Fin de Siglo.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Mus\u00e9es Royaux des Beaux-Arts de Belgique","address_street_name":"Rue de la R\u00e9gence","address_street_number":"3","address_street_box":null,"email":"info@fine-arts-museum.be","website":"http:\/\/www.fine-arts-museum.be","phone_contact":"+32 2 508 32 11","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la R\u00e9gence, 3","address_line2