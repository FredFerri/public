","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.scenocity.be","email":"contact@scenocity.be","phone_contact":"+32 473 27 20 91","phone_booking":"+32 2 732 47 73","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50000497"},"it":{"name":"Atelier face camera du mercredi Master Class","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.scenocity.be","email":"contact@scenocity.be","phone_contact":"+32 473 27 20 91","phone_booking":"+32 2 732 47 73","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50000497"},"cn":{"name":"Atelier face camera du mercredi Master Class","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.scenocity.be","email":"contact@scenocity.be","phone_contact":"+32 473 27 20 91","phone_booking":"+32 2 732 47 73","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50000497"},"fr":{"name":"Atelier face camera du mercredi Master Class","shortdescr":"Assister au Hollywood Master Class va vous donner un nouvel aper\u00e7u du jeu et des techniques pour \u00e9viter les blocages face \u00e0 la cam\u00e9ra. Cette approche pour un acteur, c\u2019est la diff\u00e9rence entre un musicien qui pratique la guitare dans sa chambre et un musicien qui joue un concert en direct devant un public.","longdescr":"L'atelier est anim\u00e9 par Philippe Cornette dont le film \"putain d'amendement\" r\u00e9alis\u00e9 avec les \u00e9l\u00e8ves Scenocity est en comp\u00e9tition au FIFE UNESCO, ZINEBI Bilbao, Festival Internacional De Cortormetrajes Vitafest Chili, Wallachia International Film Festival Bucarest, Paris Art and Movie Awards, Bristol Independent Film Festival, RIFF Rome Independent Film Festival Awards, Warsaw International Film Festival Poland.\nOn travaillera des textes originaux jamais jou\u00e9s auparavant. Vous aurez des feuilles de travail o\u00f9 vous serez oblig\u00e9s de trouver les couches d\u2019un personnage et ses rapports aux autres pour apprendre \u00e0 le jouer. Vous devrez cr\u00e9er une sc\u00e8ne originale qui sera tourn\u00e9e en qualit\u00e9 professionnelle. La feuille de travail vous oblige \u00e0 trouver une direction active pour chaque aspect du personnage.\nDans ce laboratoire, nous travaillerons par la pratique des s\u00e9quences originales comme \u00e7a doit se passer dans cet espace de jeu cin\u00e9matographique. Vous pr\u00e9parerez et filmerez jusqu'\u00e0 trois sc\u00e8nes qui serviront pour votre bande d\u00e9mo, une sc\u00e8ne de film, une sc\u00e8ne de s\u00e9rie TV, un monologue. Exploration du personnage de fiction, sa complexit\u00e9, sa gen\u00e8se, travail sur le personnage fictionnel dans toute sa diversit\u00e9.\nOn travaillera des textes originaux jamais jou\u00e9s auparavant. Vous aurez des feuilles de travail o\u00f9 vous serez oblig\u00e9s de trouver les couches d\u2019un personnage et ses rapports aux autres pour apprendre \u00e0 le jouer. Vous devrez cr\u00e9er une sc\u00e8ne originale qui sera tourn\u00e9e en qualit\u00e9 professionnelle. La feuille de travail vous oblige \u00e0 trouver une direction active pour chaque aspect du personnage.\nDans ce laboratoire, nous travaillerons par la pratique des s\u00e9quences originales comme \u00e7a doit se passer dans cet espace de jeu cin\u00e9matographique. Vous pr\u00e9parerez et filmerez jusqu'\u00e0 trois sc\u00e8nes qui serviront pour votre bande d\u00e9mo, une sc\u00e8ne de film, une sc\u00e8ne de s\u00e9rie TV, un monologue. Exploration du personnage de fiction, sa complexit\u00e9, sa gen\u00e8se, travail sur le personnage fictionnel dans toute sa diversit\u00e9.\n","performers":"Philippe Cornette(Cin\u00e9aste, acteur, auteur, metteur en sc\u00e8ne)","boxoffice_url":null,"website":"https:\/\/www.scenocity.be","email":"contact@scenocity.be","phone_contact":"+32 473 27 20 91","phone_booking":"+32 2 732 47 73","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50000497"},"sp":{"name":"Atelier face camera du mercredi Master Class","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.scenocity.be","email":"contact@scenocity.be","phone_contact":"+32 473 27 20 91","phone_booking":"+32 2 732 47 73","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50000497"},"nl":{"name":"Atelier face camera du mercredi Master Class","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.scenocity.be","email":"contact@scenocity.be","phone_contact":"+32 473 27 20 91","phone_booking":"+32 2 732 47 73","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50000497"}},"place":{"id":269799,"translations":{"de":{"name":"Salle paroissiale","address_street_name":"rue Jacques Hoton","address_street_number":"11","address_street_box":null,"email":null,"website":null,"phone_contact":"+32 2 771 63 75","phone_booking":"+32 2 771 63 75","address_zip":"1200","address_city":"Woluwe-Saint-Lambert","address_line1":"rue Jacques Hoton, 11","address_line2":"1200 Woluwe-Saint-Lambert","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Salle paroissiale Sainte Famille","address_street_name":"rue Jacques Hoton","address_street_number":"11","address_street_box":null,"email":null,"website":null,"phone_contact":"+32 2 771 63 75","phone_booking":"+32 2 771 63 75","address_zip":"1200","address_city":"Woluwe-Saint-Lambert","address_line1":"rue Jacques Hoton, 11","address_line2":"1200 Woluwe-Saint-Lambert","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Salle paroissiale","address_street_name":"rue Jacques Hoton","address_street_number":"11","address_street_box":null,"email":null,"website":null,"phone_contact":"+32 2 771 63 75","phone_