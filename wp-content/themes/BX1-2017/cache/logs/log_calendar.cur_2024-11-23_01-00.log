tion_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[],"translations":{}},"zones":[],"neca":null,"facebook_id":null,"backoffice_id":42025,"location":{"lat":50.8680161,"lon":4.3489281},"region":"brussels","last_updated_at":"2024-03-06T09:37:06+01:00","published_at":"2024-03-06T09:37:05+01:00","import_origin":null,"external_id":null,"is_in_address_book":false,"is_in_vb_export":false,"resto_ranking":0},"organizer":{"id":271542,"translations":{"de":{"name":"Once in Brussels","address_street_name":"Rue du Pannenhuis","address_street_number":"26","address_street_box":"1","email":"info@onceinbrussels.be","website":"http:\/\/www.onceinbrussels.be","phone_contact":"+32 2 850 60 90","phone_booking":null,"address_zip":"1020","address_city":"Laeken","address_line1":"Rue du Pannenhuis, 26 \/ 1","address_line2":"1020 Laeken","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Once in Brussels","address_street_name":"Rue du Pannenhuis","address_street_number":"26","address_street_box":"1","email":"info@onceinbrussels.be","website":"http:\/\/www.onceinbrussels.be","phone_contact":"+32 2 850 60 90","phone_booking":null,"address_zip":"1020","address_city":"Laeken","address_line1":"Rue du Pannenhuis, 26 \/ 1","address_line2":"1020 Laeken","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Once in Brussels","address_street_name":"Pannenhuisstraat","address_street_number":"26","address_street_box":"1","email":"info@onceinbrussels.be","website":"http:\/\/www.onceinbrussels.be","phone_contact":"+32 2 850 60 90","phone_booking":null,"address_zip":"1020","address_city":"Laeken","address_line1":"Pannenhuisstraat, 26 \/ 1","address_line2":"1020 Laeken","description_web":"Once in Brussels is an invitation to discover the capital from a different angle. They offer walks and treasure hunts where historical Brussels meets the world of gastronomes, chocolate lovers and beer drinkers!\r\nGuided tours that can be shared with friends, colleagues or family. Whatever the formula, the team goes out of its way to concoct a tailor-made programme for visitors and to provide a unique experience. They also offer a fixed schedule of activities, open to all, to enjoy the Brussels they are passionate about!","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Once in Brussels","address_street_name":"Rue du Pannenhuis","address_street_number":"26","address_street_box":"1","email":"info@onceinbrussels.be","website":"http:\/\/www.onceinbrussels.be","phone_contact":"+32 2 850 60 90","phone_booking":null,"address_zip":"1020","address_city":"Laeken","address_line1":"Rue du Pannenhuis, 26 \/ 1","address_line2":"1020 Laeken","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Once in Brussels","address_street_name":"Rue du Pannenhuis","address_street_number":"26","address_street_box":"1","email":"info@onceinbrussels.be","website":"http:\/\/www.onceinbrussels.be","phone_contact":"+32 2 850 60 90","phone_booking":null,"address_zip":"1020","address_city":"Laeken","address_line1":"Rue du Pannenhuis, 26 \/ 1","address_line2":"1020 Laeken","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Once in Brussels","address_street_name":"Rue du Pannenhuis","address_street_number":"26","address_street_box":"1","email":"info@onceinbrussels.be","website":"http:\/\/www.onceinbrussels.be","phone_contact":"+32 2 850 60 90","phone_booking":null,"address_zip":"1020","address_city":"Laeken","address_line1":"Rue du Pannenhuis, 26 \/ 1","address_line2":"1020 Laeken","description_web":"Once in Brussels c\u2019est une invitation \u00e0 d\u00e9couvrir la capitale sous un angle diff\u00e9rent. Ils proposent des balades et des jeux de piste o\u00f9 le Bruxelles historique rencontre celui des gastronomes, des amateurs de chocolat et des buveurs de bi\u00e8res !\nDes visites guid\u00e9es qui se partagent entre amis, entre coll\u00e8gues et en famille. Quelle que soit la formule, l\u2019\u00e9quipe se coupent en quatre pour concocter aux visiteurs un programme sur mesure et pour faire vivre une exp\u00e9rience unique. Ils proposent aussi un agenda d'activit\u00e9s fixes, ouvertes \u00e0 tous, pour profiter du Bruxelles qui les passionne !\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Once in Brussels","address_street_name":"Rue du Pannenhuis","address_street_number":"26","address_street_box":"1","email":"info@onceinbrussels.be","website":"http:\/\/www.onceinbrussels.be","phone_contact":"+32 2 850 60 90","phone_booking":null,"address_zip":"1020","address_city":"Laeken","address_line1":"Rue du Pannenhuis, 26 \/ 1","address_line2":"1020 Laeken","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Once in Brussels","address_street_name":"Pannenhuisstraat","address_street_number":"26","address_street_box":"1","email":"info@onceinbrussels.be","website":"http:\/\/www.onceinbrussels.be","phone_contact":"+32 2 850 60 90","phone_booking":null,"address_zip":"1020","address_city":"Laken","address_line1":"Pannenhuisstraat, 26 \/ 1","address_line2":"1020 Laken","description_web":"Once in Brussels is een uitnodiging om de hoofdstad vanuit een andere invalshoek te ontdekken. Zij bieden wandelingen en speurtochten aan waar historisch Brussel de wereld van gastronomen, chocoladeliefhebbers en bierdrinkers ontmoet!\r\nRondleidingen die kunnen worden gedeeld met vrienden, collega's of familie. Wat de formule ook is, het team stelt alles in het werk om vo