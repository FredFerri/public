me":"Il faut cultiver son jardin","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lesrichesclaires.be\/saison\/il-faut-cultiver-son-jardin\/","email":"diffusion@lesrichesclaires.be","phone_contact":"+32 2 548 25 80","phone_booking":"+32 2 548 25 80","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700001404"},"it":{"name":"Il faut cultiver son jardin","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lesrichesclaires.be\/saison\/il-faut-cultiver-son-jardin\/","email":"diffusion@lesrichesclaires.be","phone_contact":"+32 2 548 25 80","phone_booking":"+32 2 548 25 80","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700001404"},"cn":{"name":"Il faut cultiver son jardin","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lesrichesclaires.be\/saison\/il-faut-cultiver-son-jardin\/","email":"diffusion@lesrichesclaires.be","phone_contact":"+32 2 548 25 80","phone_booking":"+32 2 548 25 80","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700001404"},"fr":{"name":"Il faut cultiver son jardin","shortdescr":"Il faut cultiver son jardin interroge ce qui nous relie \u00e0 la nature \u00e0 travers le prisme des jardins. Un spectacle ludique, litt\u00e9raire, musical, avec comme ligne de fond : qu\u2019on ait la main verte ou qu\u2019on pr\u00e9f\u00e8re cultiver son talent, s\u2019enivrer des jardins de Colette ou de Zola, l'important est de cultiver son jardin.","longdescr":"\"Il faut cultiver son jardin \" interroge ce qui nous relie \u00e0 la nature, \u00e0 la terre qui nous nourrit, nous h\u00e9berge, jusqu\u2019\u00e0 notre derni\u00e8re demeure, six pieds sous elle. Le spectacle utilise divers langages : litt\u00e9rature, th\u00e9\u00e2tre, chansons, et fait m\u00eame participer le public. Christian Dalimier et Val\u00e9ry Bendjilali abordent ce sujet de mani\u00e8re ludique, jamais donneurs de le\u00e7on, pr\u00e9f\u00e9rant pratiquer l\u2019auto-d\u00e9rision. Avec comme ligne de fond : qu\u2019on ait la main verte ou qu\u2019on pr\u00e9f\u00e8re cultiver son talent, s\u2019enivrer des jardins de Colette ou de Zola, l'important est de cultiver son jardin.","performers":"Un projet de la compagnie La Superbe | De et par Christian Dalimier et Val\u00e9ry Bendjilali | \u0152il ext\u00e9rieur B\u00e9n\u00e9dicte Chabot","boxoffice_url":null,"website":"https:\/\/lesrichesclaires.be\/saison\/il-faut-cultiver-son-jardin\/","email":"diffusion@lesrichesclaires.be","phone_contact":"+32 2 548 25 80","phone_booking":"+32 2 548 25 80","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700001404"},"sp":{"name":"Il faut cultiver son jardin","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lesrichesclaires.be\/saison\/il-faut-cultiver-son-jardin\/","email":"diffusion@lesrichesclaires.be","phone_contact":"+32 2 548 25 80","phone_booking":"+32 2 548 25 80","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700001404"},"nl":{"name":"Il faut cultiver son jardin","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lesrichesclaires.be\/saison\/il-faut-cultiver-son-jardin\/","email":"diffusion@lesrichesclaires.be","phone_contact":"+32 2 548 25 80","phone_booking":"+32 2 548 25 80","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700001404"}},"place":{"id":1085,"translations":{"de":{"name":"Les Riches-Claires","address_street_name":"Rue des Riches Claires","address_street_number":"24","address_street_box":null,"email":"accueil@lesrichesclaires.be","website":"http:\/\/www.lesrichesclaires.be","phone_contact":"+32 2 548 25 80","phone_booking":"+32 2 548 25 80","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Riches Claires, 24","address_line2":"1000 Bruxelles"