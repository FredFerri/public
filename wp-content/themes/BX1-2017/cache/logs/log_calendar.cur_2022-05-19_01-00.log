"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"opening":{"day":"2022-04-28","start":"18:00:00","timestamp":"2022-04-28T18:00:00+02:00","end":"20:00:00","is_only_by_appointment":false},"tags":[],"accessibilities":{"list":[255,259,265,266],"translations":{"fr":["Accessible","Chien d'assistance","WC adapt\u00e9","Brussels Health Safety Label"],"nl":["Toegankelijk","Assistentiehonden","Aangepast toilet","Brussels Health Safety Label"],"en":["Accessible","Assistance dogs","Adapted toilet","Brussels Health Safety Label"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-05-18T01:07:15+02:00","published_at":"2022-04-25T10:01:07+02:00","backoffice_id":252381,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.25265977409643},{"id":530075,"date_start":"2022-03-15","date_end":"2022-11-15","date_next":"2022-05-18","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[36,43],"translations":{"fr":["Mus\u00e9es et art centers","Arts D\u00e9coratifs"],"nl":["Musea en kunstcentra","Decoratieve kunsten"],"en":["Museums and art centers","Decorative art"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Alchemia Medica - exposition temporaire","shortdescr":"Trouver l\u2019\u00e9lixir de vie qui gu\u00e9rit tous les maux et procure l\u2019immortalit\u00e9 a \u00e9t\u00e9 la finalit\u00e9 de l\u2019alchimie qui s\u2019est progressivement d\u00e9gag\u00e9e du charlatanisme pour \u00e9voluer vers un art de gu\u00e9rir scientifique et offrir des m\u00e9dicaments efficaces.","longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.museemedecine.be","email":"museemedecine@ulb.ac.be","phone_contact":"+32 2 555 34 31","phone_booking":"+32 2 555 34 31","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/530075.html"},"nl":{"name":"Alchemia Medica - tijdelijke expositie","shortdescr":"Het vinden van het levenselixer dat alle kwalen geneest en onsterfelijkheid verschaft, was het doel van de alchemie, die zich geleidelijk verwijderde van het charlatanisme om een wetenschappelijke geneeskunst te worden en doeltreffende geneesmiddelen aan te bieden.","longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/530075.html"},"en":{"name":"Alchemia Medica - temporary exhibition","shortdescr":"Finding the elixir of life that cures all ills and provides immortality was the goal of alchemy, which gradually moved away from charlatanism to become a scientific healing art and offer effective medicines.","longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/530075.html"},"de":{"name":"Alchemia Medica - exposition temporaire","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/530075.html"},"it":{"name":"Alchemia Medica - exposition temporaire","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/530075.html"},"sp":{"name":"Alchemia Medica - exposition temporaire","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/530075.html"},"pt":{"name":"Alchemia Medica - exposition temporaire","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/530075.html"},"cn":{"name":"Alchemia Medica - exposition temporaire","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/530075.html"}},"place":{"id":230242,"translations":{"fr":{"name":"Mus\u00e9e de la M\u00e9decine (ULB)","address_street_name":"Route de Lennik","address_street_number":"808","address_street_box":null,"email":"museemed@ulb.ac.be","website":"http:\/\/www.museemedecine.be\/","phone_contact":"+32 2 555 34 31","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Route de Lennik, 808","address_line2":"1070 Anderlecht","description_web":"Le Mus\u00e9e de la M\u00e9decine s\u2019adresse \u00e0 tous les passionn\u00e9s, experts ou simples curieux de la m\u00e9decine et de la pens\u00e9e m\u00e9dicale dans l\u2019art, l\u2019histoire et la litt\u00e9rature, de l\u2019Antiquit\u00e9 \u00e0 nos jours.\r\nLa proximit\u00e9 avec l\u2019h\u00f4pital Erasme permet au Mus\u00e9e de restituer ses objets en radiographies fascinantes, r\u00e9v\u00e9lant les secrets de leur composition, comme \u00ab l\u2019Ecorch\u00e9 \u00bb du Dr Auzoux, le nouveau chef-d\u2019\u0153uvre du mus\u00e9e!","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Geneeskundemuseum (ULB)","address_street_name":"Lennikse Baan","address_street_number":"808","address_street_box":null,"email":"museemed@ulb.ac.be","website":"http:\/\/www.museemedecine.be\/","phone_contact":"+32 2 555 34 31","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Lennikse Baan, 808","address_line2":"1070 Anderlecht","description_web":"Het Geneeskundemuseum is niet alleen een must voor experten, maar voor iedereen die geboeid is door of nieuwsgierig is naar geneeskunde. Het museum biedt een overzicht van de Oudheid tot vandaag en ook de invloed van geneeskunde op de kunsten, geschiedenis en literatuur komt aan bod. Dankzij de nabijheid van het Erasmusziekenhuis kon het museum ro\u0308ntgenfoto\u2019s maken van enkele van zijn voorwerpen, wat unieke beelden geeft van hun samenstelling. Een mooi voorbeeld hiervan is het anatomisch spiermodel van Dr Auzoux, het nieuwe topstuk van het museum!","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Mus\u00e9e de la M\u00e9decine (ULB)","address_street_name":"Route de Lennik","address_street_number":"808","address_street_box":null,"email":"museemed@ulb.ac.be","website":"http:\/\/www.museemedecine.be\/","phone_contact":"+32 2 555 34 31","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Route de Lennik, 808","address_line2":"1070 Anderlecht","description_web":"The Museum of Medicine is intended for all enthusiasts, experts or simply anyone interested in medicine and medical thinking featured in art, history and literature, from antiquity to the present day.\r\nIts proximity to Erasmus Hospital allows the museum to reconstruct its items in fascinating X-rays, revealing the secrets of their composition, such as the museum\u2019s latest masterpiece, Dr Auzoux\u2019s \"Ecorch\u00e9\"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Mus\u00e9e de la M\u00e9decine (ULB)","address_street_name":"Route de Lennik","address_street_number":"808","address_street_box":null,"email":"museemed@ulb.ac.be","website":"http:\/\/www.museemedecine.be\/","phone_contact":"+32 2 555 34 31","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Route de Lennik, 808","address_line2":"1070 Anderlecht","description_web":"Das Medizinmusem richtet sich an alle medizinisch interessierten Besucher. Theamtisch abgedeckt wird nicht nur die Medizin, sondern auch die medizinische Denkweise in Kunst, Geschichte und Literatur - von der Antike bis zur Gegenwart.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Mus\u00e9e de la M\u00e9decine (ULB)","address_street_name":"Route de Lennik","address_street_number":"808","address_street_box":null,"email":"museemed@ulb.ac.be","website":"http:\/\/www.museemedecine.be\/","phone_contact":"+32 2 555 34 31","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Route de Lennik, 808","address_line2":"1070 Anderlecht","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Museo de Medicina (ULB)","address_street_name":"Route de Lennik","address_street_number":"808","address_street_box":null,"email":"museemed@ulb.ac.be","website":"http:\/\/www.museemedecine.be\/","phone_contact":"+32 2 555 34 31","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Route de Lennik, 808","address_line2":"1070 Anderlecht","description_web":"El Museo de Medicina est\u00e1 destinado para todos los entusiastas, expertos o simplemente interesados en la medicina y el pensamiento m\u00e9dico representado en el arte, la historia y la literatura, desde la antig\u00fcedad hasta la actualidad.\r\nSu cercan\u00eda con el Hospital Erasmus permite al museo reconstruir sus art\u00edculos en fascinantes rayos X, revelando los secretos de su composici\u00f3n, por ejemplo, la \u00faltima obra maestra del museo, \"Ecorch\u00e9\" de Dr Auzoux.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Mus\u00e9e de la M\u00e9decine (ULB)","address_street_name":"Route de Lennik","address_street_number":"808","address_street_box":null,"email":