ns":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-06-01T17:05:05+02:00","published_at":"2022-05-24T09:37:59+02:00","backoffice_id":254366,"import_origin":null,"sub_type":"brocante","show_in_agenda":true,"ranking":1},{"id":533008,"date_start":"2022-06-18","date_end":"2022-06-18","date_next":"2022-06-18","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":71,"translations":{"fr":"March\u00e9s & brocantes","nl":"Markten & brocante","en":"Markets and bric-a-brac stores"}},"others":{}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Brocante Evere centre","shortdescr":"Bienvenue sur la page d\u2019information de la Brocante \u00ab Centre Evere \u00bb du 18 juin 2022 de 10h00 \u00e0 18h00 dans le cadre de la festivit\u00e9 \u00ab Evere En F\u00eate \u00bb organis\u00e9e par l\u2019administration communale d\u2019Evere. L\u2019organisation de cette grande Brocante annuelle a \u00e9t\u00e9 confi\u00e9 \u00e0 l\u2019asbl la Coh\u00e9sion Sociale d\u2019Evere \u2013 Actions Communautaires depuis 2017.","longdescr":"La grande brocante annuelle se d\u00e9roulera :\r\n- L\u2019avenue Notre Dame du n\u00b068 au n\u00b0135\r\n- L\u2019avenue H. Conscience du n\u00b0142 au n\u00b0240\r\n- Rue A. Vanden Bossche du n\u00b003 au n\u00b043\r\n- Rue E. Deknoop du n\u00b041 au n\u00b083\r\n- Rue A. De Brandt du n\u00b023 au n\u00b035\r\n\r\nAu-del\u00e0 d\u2019une brocante, cette grande festivit\u00e9 est un rassemblement convivial d\u2019everoises et d\u2019everois comprenant des animations pour toute la famille. Nous esperons vous y voir nombreuses et nombreux afin de c\u00e9l\u00e9brer ensemble le d\u00e9but de l\u2019\u00e9t\u00e9.\r\n\r\nSi vous souhaitez participer \u00e0 cette festivit\u00e9 en tant qu\u2019exposant brocanteur, vous avez l\u2019occasion de vous inscrire via le formulaire en ligne ou de vous rendre dans nos locaux du lundi au jeudi de 11h \u00e0 16h00, rue Georges De Lombaerde 21 \u00e0 1140 Evere.\r\n\r\nsous r\u00e9serve de disponibilit\u00e9, il est possible de se pr\u00e9senter le jour m\u00eame sans r\u00e9servation sous la condition de s\u2019acquitter sur place d'un montant de 30\u20ac (+10\u20ac de caution de propret\u00e9) pour un emplacement de 3mx2m. Dans ce cas, vous pouvez vous  pr\u00e9senter au croisement de l'avenue Notre-Dame et de la rue Vanden bossche (en passant par la rue Van Ruusbroeck) le 18\/06 \u00e0 09h00.\r\n\r\nINFO LINE : 02\/726.76.68 du lundi au jeudi de 10h30 \u00e0 17h00 (jusqu'au 14\/06 inclus)","performers":null,"boxoffice_url":null,"website":"http:\/\/csevere.be\/index.php\/brocante\/","email":null,"phone_contact":"+32 2 726 76 68","phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/533008.html"},"nl":{"name":"Rommelmarkt Evere centrum","shortdescr":"Welkom op de informatiepagina van de rommelmarkt \u201cEvere Centre\u201d van 18 juni 2022 van 10u tot 18u in het kader van \u201cEvere Feest\u201d georganiseerd door het gemeentebestuur van Evere. De organisatie van deze grote jaarlijkse rommelmarkt werd toevertrouwd aan de vzw La Coh\u00e9sion Sociale d\u2019Evere \u2013 Actions Communautaires sinds 2017.","longdescr":"De grote jaarlijkse rommelmarkt zal doorgaan :\r\n- Onze Lieve Vrouwlaan van nr 68 tot nr 135\r\n- Consciencelaan van nr 142 tot nr 240\r\n- Vanden Bosschestraat van nr 03 tot nr 43\r\n- Deknoopstraat van nr 41 tot nr 83\r\n- De Brandtstraat van nr 23 tot nr 35\r\n\r\nDeze rommelmarkt is een grote festiviteit en een gemoedelijk samenkomen van alle Everenaars met animaties voor het hele gezin. Wij hopen u er talrijk te mogen ontmoeten om samen het begin van de zomer te vieren.\r\n\r\nIndien u wenst deel te nemen aan dit feest als standhouder, kunt u zich inschrijven via het online-inschrijvingsformulier of naar ons bureel komen van maandag tot donderdag van 11u tot 16u, Georges De Lombaerdesraat 21 te 1140 Evere.","performers":null,"boxoffice_url":null,"website":null,"email":"info@evere.brussel","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/533008.html"},"en":{"name":"Brocante Evere centre","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/533008.html"},"de":{"name":"Brocante Evere centre","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/533008.html"},"it":{"name":"Brocante Evere centre","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/533008.html"},"sp":{"name":"Brocante Evere centre","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/533008.html"},"pt":{"name":"Brocante Evere centre","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/533008.html"},"cn":{"name":"Brocante Evere centre","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/533008.html"}},"place":{"id":206581,"translations":{"fr":{"name":"Administration communale d'Evere","ad