9rences","copyright":null},"nl":{"title":"Ars Musica - Piano exp\u00e9rimental: concerts et conf\u00e9rences","copyright":null},"en":{"title":"Ars Musica - Piano exp\u00e9rimental: concerts et conf\u00e9rences","copyright":null}}}],"dates":[{"day":"2022-11-26","doors":null,"start":"14:00:00","end":null,"is_soldout":false,"is_canceled":false},{"day":"2022-11-26","doors":null,"start":"15:30:00","end":null,"is_soldout":false,"is_canceled":false},{"day":"2022-11-26","doors":null,"start":"17:00:00","end":null,"is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Article 27"},"nl":{"name":"Artikel 27"},"en":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[538036],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":{"list":[252,255,256,259,261,263,265],"translations":{"fr":["Accessible aux personnes ayant des difficult\u00e9s de compr\u00e9hension","Accessible","Am\u00e9nagements pour les personnes aveugles et malvoyantes","Chien d'assistance","Parking accessible","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9"],"nl":["Toegankelijk voor mensen met een verstandelijke beperking","Toegankelijk","Voorzieningen voor blinde en slechtziende personen","Assistentiehonden","Toegankelijke parking","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet"],"en":["Accessible to people with intellectual disabilities","Accessible","Facilities for blind and partially-sighted persons","Assistance dogs","Accessible parking","Accessible to pedestrians with mobility aids","Adapted toilet"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-11-09T14:35:10+01:00","published_at":"2022-11-04T11:28:58+01:00","backoffice_id":265168,"import_origin":null,"sub_type":"concert","show_in_agenda":true,"ranking":1.2599210498949},{"id":541614,"date_start":"2022-11-26","date_end":"2022-11-26","date_next":"2022-11-26","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater"}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"],"de":["Theater"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Foxes","shortdescr":"Lily, qu\u2019on croyait douce, a p\u00e9t\u00e9 le nez de Mammouth.","longdescr":"Lily, qu\u2019on croyait douce, a p\u00e9t\u00e9 le nez de Mammouth.\r\n\r\nProsper danse tout seul, pour lui, tous les mercredis. Bambi a atteint la finale d\u2019une \u00e9mission t\u00e9l\u00e9vis\u00e9e de chant, puis s\u2019est enfuie. Herv\u00e9 s\u2019est r\u00e9fugi\u00e9 dans son casque de r\u00e9alit\u00e9 virtuelle\u2026 Toutes et tous, pour des raisons diff\u00e9rentes, ont quitt\u00e9 leur maison, leur \u00e9cole, leur quartier, et se retrouvent par hasard au m\u00eame endroit\u200a: un vieux dancing abandonn\u00e9.\r\n\r\nDans Foxes, quatre com\u00e9diens et com\u00e9diennes trentenaires se rem\u00e9morent les moments de liesse de leur enfance. Ensemble, ils imaginent ce qu\u2019aurait pu \u00eatre leur rencontre, vingt ans plus t\u00f4t. Sauvages et complices, ils mettent en sc\u00e8ne leurs r\u00eaves inutiles et essentiels, ils redonnent peu \u00e0 peu au vieux dancing sa raison d\u2019\u00eatre\u200a: un lieu de rencontre et de f\u00eate.\r\n\r\nApr\u00e8s Grou\u200a!, voici la nouvelle cr\u00e9ation de la Cie Renards. Avec elle, l\u2019amiti\u00e9 sauve, le rire se partage et l\u2019insouciance se joue de tout, m\u00eame des technologies les plus avanc\u00e9es. Un r\u00e9jouissant appel \u00e0 oser la rencontre pour croquer dans l\u2019avenir.","performers":"Cie Renards","boxoffice_url":null,"website":"https:\/\/lamontagnemagique.be\/foxes-2\/","email":"info@montagnemagique.be","phone_contact":null,"phone_booking":"+32 2 210 15 90","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.541614"},"nl":{"name":"Foxes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.541614"},"en":{"name":"Foxes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.541614"},"de":{"name":"Foxes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.541614"},"it":{"name":"Foxes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.541614"},"sp":{"name":"Foxes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.541614"},"pt":{"name":"Foxes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.541614"},"cn":{"name":"Foxes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.541614"}},"place":{"id":228012,"translations":{"fr":{"name":"Th\u00e9\u00e2tre La montagne m