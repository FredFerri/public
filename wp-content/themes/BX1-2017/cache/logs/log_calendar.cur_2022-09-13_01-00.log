356f0d0af45c9dda479193444a41ec889221.jpg","width":785,"height":350,"ratio":2.24,"translations":{"fr":{"title":"L'hippodrome de Boitsfort \/ visite avec expert Julie Scandolo","copyright":null},"nl":{"title":"L'hippodrome de Boitsfort \/ visite avec expert Julie Scandolo","copyright":null},"en":{"title":"L'hippodrome de Boitsfort \/ visite avec expert Julie Scandolo","copyright":null}}}],"dates":[{"day":"2022-09-24","doors":null,"start":"11:00:00","end":"12:30:00","is_soldout":false,"is_canceled":false},{"day":"2022-09-24","doors":null,"start":"14:00:00","end":"12:30:00","is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":15}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-09-09T04:05:38+02:00","published_at":"2022-09-09T03:30:15+02:00","backoffice_id":261420,"import_origin":"explore","sub_type":"other","show_in_agenda":true,"ranking":1.2599210498949},{"id":540813,"date_start":"2022-09-24","date_end":"2022-09-24","date_next":"2022-09-24","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert"}},"others":{"list":[2],"translations":{"fr":["Classique"],"nl":["Klassiek"],"en":["Classical"]}}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Bernard Foccroulle : \u00abDialogue entre peinture et musique\u00bb","shortdescr":"Bernard Foccroulle, musicien, compositeur et chef d\u2019orchestre belge, vient au BAIXU pour nous offrir un r\u00e9cital consacr\u00e9 au clavecin.","longdescr":"Il y jouera sur son propre clavecin, pour lequel Fabienne Verdier, qui s\u2019int\u00e9resse au lien entre lignes sonores et picturales (elle a \u00e9t\u00e9 artiste en r\u00e9sidence \u00e0 la c\u00e9l\u00e8bre Juilliard School de New York et a travaill\u00e9 avec de nombreux musiciens \u00e0 cette occasion), a r\u00e9alis\u00e9 pour cet instrument un ensemble exceptionnel de quatre peintures, ouvrant ainsi la voie \u00e0 de nouvelles rencontres entre peinture et musique.\r\nBernard Foccroulle a con\u00e7u un programme qui met en r\u00e9sonance des \u0153uvres anciennes et contemporaines avec les peintures de Fabienne Verdier. Chacun de ses tableaux sera confront\u00e9 \u00e0 un Contrepoint extrait de l\u2019Art de la Fugue de J.S. Bach.","performers":"Bernard Foccroulle","boxoffice_url":null,"website":"https:\/\/www.lebaixu.be","email":"info@lebaixu.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.540813"},"nl":{"name":"Bernard Foccroulle: \"Dialoog tussen schilderkunst en muziek\"","shortdescr":"Bernard Foccroulle, Belgisch musicus, componist en dirigent, komt naar de BAIXU om ons een recital te geven gewijd aan het klavecimbel.","longdescr":"Hij zal spelen op zijn eigen klavecimbel, waarvoor Fabienne Verdier, die ge\u00efnteresseerd is in het verband tussen klank en picturale lijnen (zij was artist-in-residence aan de beroemde Juilliard School in New York en werkte met vele musici), een uitzonderlijke set van vier schilderijen voor dit instrument heeft gemaakt, waardoor de weg wordt vrijgemaakt voor nieuwe ontmoetingen tussen schilderkunst en muziek.\r\nBernard Foccroulle heeft een programma samengesteld, dat oude en hedendaagse werken samenbrengt met de schilderijen van Fabienne Verdier. Elk van haar schilderijen zal geconfronteerd worden met een contrapunt uit J.S. Bachs Kunst van de Fuga.","performers":"Bernard Foccroulle","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.540813"},"en":{"name":"Bernard Foccroulle: \"Dialogue between painting and music\u201d","shortdescr":"Bernard Foccroulle, Belgian musician, composer and conductor, comes to the BAIXU to offer us a recital devoted to the harpsichord.","longdescr":"He will play on his own harpsichord, for which Fabienne Verdier, who is interested in the link between sound and pictorial lines (she was artist-in-residence at the famous Juilliard School in New York and worked with many musicians on that occasion), has created an exceptional set of four paintings for this instrument, thus opening the way to new encounters between painting and music.\r\nBernard Foccroulle has conceived a programme that brings together ancient and contemporary works with the paintings of Fabienne Verdier. Each of her paintings will be confronted with a counterpoint from J.S. Bach's Art of the Fugue.","performers":"Bernard Foccroulle","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.540813"},"de":{"name":"Bernard Foccroulle : \u00abDialogue entre peinture et musique\u00bb","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.540813"},"it":{"name":"Bernard Foccroulle : \u00abDialogue entre peinture et musique\u00bb","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.540813"},"sp":{"name":"Bernard Foccroulle : \u00abDialogue entre peinture et musique\u00bb","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,