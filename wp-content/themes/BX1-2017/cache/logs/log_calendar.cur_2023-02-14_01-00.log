ite":"http:\/\/www.deepinhouse.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Deep in House","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Deep in House","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.deepinhouse.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Deep in House","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":[],"zones":{"list":[22],"translations":{"fr":["Est"],"nl":["Oost"],"en":["East"],"de":["Osten"],"it":["Est"],"sp":["Este"],"pt":[null],"cn":[null]}},"neca":null,"facebook_id":"416457985055884","backoffice_id":18273,"location":{"lat":50.83187717,"lon":4.45691585},"region":"brussels","last_updated_at":"2023-02-11T09:06:01+01:00","published_at":"2014-05-13T10:01:58+02:00","import_origin":null,"external_id":null,"is_in_address_book":false,"is_in_vb_export":false,"resto_ranking":0},"organizer":{"id":270712,"translations":{"fr":{"name":"C12","address_street_name":"rue March\u00e9 aux Herbes","address_street_number":null,"address_street_box":null,"email":null,"website":"https:\/\/c12space.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"rue March\u00e9 aux Herbes","address_line2":"1000 Bruxelles","description_web":"C12 est une nouvelle plateforme multidisciplinaire du collectif Deep in House. Situ\u00e9e au c\u0153ur de Bruxelles, la C12 est nich\u00e9e dans les profondeurs de la Galerie Horta \u00e0 c\u00f4t\u00e9 de la Grand Place et de la Gare Centrale. C12 est un endroit s\u00fbr o\u00f9 la libert\u00e9, la diversit\u00e9, la cr\u00e9ativit\u00e9 et la culture alternative sont prot\u00e9g\u00e9es du monde ext\u00e9rieur restrictif et normatif. C'est un endroit s\u00fbr o\u00f9 la passion pour l'art et la musique sous toutes ses formes unit toutes les identit\u00e9s. Le projet comprendra des concerts, des installations artistiques, des vies, des soir\u00e9es club et le dernier mais non le moindre, un march\u00e9 local.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"C12","address_street_name":"rue March\u00e9 aux Herbes","address_street_number":null,"address_street_box":null,"email":null,"website":"https:\/\/c12space.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"rue March\u00e9 aux Herbes","address_line2":"1000 Brussel","description_web":"Sinds begin 2018 is Brussel een nieuwe club en multidisciplinaire projectruimte rijker en we kunnen ons het nachtleven zonder al niet meer voorstellen. C12 ligt verborgen onder het Centraal Station in wat voorheen bekend stond als de Hortagalerij. Aan het roer staat \u2018Deep in House\u2019, een technocollectief dat lang niet meer aan zijn proefstuk toe is. Naast stomende house- en technofeesten is er ook plaats voor concerten, tentoonstellingen en performance. C12 is een vrijplaats waar vrijheid, diversiteit, creativiteit en alternatieve cultuur beschermd en gevierd worden. Een absolute aanrader. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"C12","address_street_name":"rue March\u00e9 aux Herbes","address_street_number":null,"address_street_box":null,"email":null,"website":"https:\/\/c12space.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"rue March\u00e9 aux Herbes","address_line2":"1000 Brussels","description_web":"C12 is a new multidisciplinary platform run by the Deep in House collective. Located at the heart of Brussels, C12 is tucked in the depths of the Horta Gallery next to the Grand Place and the Central Station. C12 is a safe place where freedom, diversity, creativity and alternative culture are protected from the restrictive and normative outside world. It is a safe place where the passion for art & music in all its forms unites all identities. The project will include concerts, art installations, lives, club nights and last but by no means least, a local market.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"C12","address_street_name":"rue March\u00e9 aux Herbes","address_street_number":null,"address_street_box":null,"email":null,"website":"https:\/\/c12space.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"rue March\u00e9 aux Herbes","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"C12","address_street_name":"rue March\u00e9 aux Herbes","address_street_number":null,"address_street_box":null,"email":null,"website":"https:\/\/c12space.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"rue March\u00e9 aux Herbes","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"C12","address_street_name":"rue March\u00e9 aux Herbes","address_street_number":null,"address_street_box":null,"email":null,"website":"https:\/\/c12space.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"rue March\u00e9 aux Herbes","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"C12","address_street_name":"rue March\u00e9 aux Herbes","address_street_number":null,"address_street_box":null,"email":null,"website":"https:\/\/c12space.com","phone_contac