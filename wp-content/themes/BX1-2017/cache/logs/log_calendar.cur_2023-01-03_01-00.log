us difficiles que la vie peut r\u00e9server !\r\n\r\n\r\nSpectacle d'Alexandre Valentin et ses Ch\u00e8res invit\u00e9.e.s","performers":"Alexandre Valancin et ses courageu.x.ses invit\u00e9.e.s !","boxoffice_url":null,"website":"http:\/\/www.letrac.be\/reservation","email":"info@letrac.be","phone_contact":"+32 470 50 04 75","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.540595"},"nl":{"name":"COURAGE(S) - Spectacle D'improvisation d'Alexandre Valancin et ses invit\u00e9.e.s de coeur","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.540595"},"en":{"name":"COURAGE(S) - Spectacle D'improvisation d'Alexandre Valancin et ses invit\u00e9.e.s de coeur","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.540595"},"de":{"name":"COURAGE(S) - Spectacle D'improvisation d'Alexandre Valancin et ses invit\u00e9.e.s de coeur","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.540595"},"it":{"name":"COURAGE(S) - Spectacle D'improvisation d'Alexandre Valancin et ses invit\u00e9.e.s de coeur","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.540595"},"sp":{"name":"COURAGE(S) - Spectacle D'improvisation d'Alexandre Valancin et ses invit\u00e9.e.s de coeur","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":nul