\/visitors\/agenda\/event-detail.5700002826"},"it":{"name":"Forest-vert et Messidor : deux cit\u00e9s-jardins \u00e0 d\u00e9couvrir","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.arau.org\/","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700002826"},"cn":{"name":"Forest-vert et Messidor : deux cit\u00e9s-jardins \u00e0 d\u00e9couvrir","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.arau.org\/","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700002826"},"fr":{"name":"Forest-vert et Messidor : deux cit\u00e9s-jardins \u00e0 d\u00e9couvrir","shortdescr":null,"longdescr":"Commune au pass\u00e9 industriel, Forest s\u2019est tr\u00e8s t\u00f4t int\u00e9ress\u00e9e \u00e0 la question du logement ouvrier. En 1922 est ainsi cr\u00e9\u00e9e une magnifique cit\u00e9-jardin au nom \u00e9vocateur : Forest-Vert, ensemble mixte socialement compos\u00e9 de petits immeubles collectifs et de maisons individuelles de style Art D\u00e9co, entour\u00e9s de venelles, de placettes et de jardins. Con\u00e7ue en 1952 pour accueillir les employ\u00e9s du minist\u00e8re des finances, la cit\u00e9-jardin Messidor t\u00e9moigne quant \u00e0 elle d\u2019une phase plus r\u00e9cente dans la conception et l\u2019implantation du logement modeste \u00e0 Bruxelles. Le nom de ses rues \u00e9voque le monde viticole, ce qui lui conf\u00e8re des airs m\u00e9ridionaux. Cette visite vous m\u00e8nera \u00e0 travers ces deux ensembles urbanistiques aux qualit\u00e9s patrimoniales et paysag\u00e8res m\u00e9connues, vous permettant ainsi d\u2019explorer deux \u00e9poques de la riche histoire du logement modeste \u00e0 Bruxelles.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.arau.org\/","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700002826"},"sp":{"name":"Forest-vert et Messidor : deux cit\u00e9s-jardins \u00e0 d\u00e9couvrir","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.arau.org\/","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700002826"},"nl":{"name":"Forest-vert et Messidor : deux cit\u00e9s-jardins \u00e0 d\u00e9couvrir","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.arau.org\/","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700002826"}},"place":{"id":280443,"translations":{"de":{"name":"\u00c0 l\u2019angle de l\u2019avenue Fl\u00e9ron et de l\u2019avenue de la Verrerie","address_street_name":"Lieu de d\u00e9part: \u00e0 l\u2019angle de l\u2019avenue Fl\u00e9ron et de l\u2019avenue de la Verrerie","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Lieu de d\u00e9part: \u00e0 l\u2019angle de l\u2019avenue Fl\u00e9ron et de l\u2019avenue de la Verrerie","address_line2":"1190 Forest","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"\u00c0 l\u2019angle de l\u2019avenue Fl\u00e9ron et de l\u2019avenue de la Verrerie","address_street_name":"Lieu de d\u00e9part: \u00e0 l\u2019angle de l\u2019avenue Fl\u00e9ron et de l\u2019avenue de la Verrerie","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Lieu de d\u00e9part: \u00e0 l\u20