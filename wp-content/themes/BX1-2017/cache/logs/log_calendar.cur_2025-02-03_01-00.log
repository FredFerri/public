tions":{}},"tags":[],"elloha_id":"90eddd34-0aee-41e2-9f20-d4ae206867b5"},{"id":5700004608,"date_start":"2025-02-14","date_end":"2025-02-16","date_next":"2025-02-14","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-12-15T12:07:05+01:00","published_at":"2024-12-15T11:55:31+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":314358,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"concert","ranking":0.8735804647362989,"languages":{"spoken":["nl","en","fr"],"subtitles":[]},"categories":{"main":{"id":1,"translations":{"de":"Konzert","pt":null,"en":"Concert","it":"Concerti","cn":null,"fr":"Concert","sp":"Concierto","nl":"Concert"}},"others":{"list":[2],"translations":{"de":["Klassisch"],"pt":[null],"en":["Classical"],"it":["Classica"],"cn":[null],"fr":["Classique"],"sp":["Cl\u00e1sica"],"nl":["Klassiek"]}}},"translations":{"de":{"name":"Love, sorrow & desire","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/koinoniaorchestra.eu\/","email":"koinoniaorchestraofeurope@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700004608"},"pt":{"name":"Love, sorrow & desire","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/koinoniaorchestra.eu\/","email":"koinoniaorchestraofeurope@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700004608"},"en":{"name":"Love, sorrow & desire","shortdescr":"Bring the person(s) you love on the exploration of Love, Sorrow and Desire. \nA classical proposed by Koinonia, Orchestra of Europe. \nBeginning with Wagner\u2019s passionate Prelude and Liebestod, moving through the melancholy of Mahler\u2019s Adagietto from Symphony No. 5, exploring his Songs of a Wayfarer, and finally the warmth and peace of love that Wagner brings to life in his Siegfried Idyll","longdescr":"Love, Sorrow and Desire, the search for meaning.\nBeginning with Wagner\u2019s passionate Prelude and Liebestod from Tristan and Isolde, telling us of unfulfilled desires and tragic loves; moving through the melancholic beauty of Mahler\u2019s Adagietto, from the Symphony no.5; exploring the introspective world of Mahler through his Songs of a Wayfarer, and finally arriving at the warmth, peace, and almost domestic kind of love that Wagner brings to life in his Siegfried Idyll.\nFebruary 14th & 16th at Full Circle, home to a diverse community of people who contribute to positive change, a platform to connect good ideas, with the power to carry them out. Venue\u2019s doors open one hour before! \n","performers":null,"boxoffice_url":null,"website":"https:\/\/koinoniaorchestra.eu\/","email":"koinoniaorchestraofeurope@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700004608"},"it":{"name":"Love, sorrow & desire","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/koinoniaorchestra.eu\/","email":"koinoniaorchestraofeurope@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700004608"},"cn":{"name":"Love, sorrow & desire","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/koinoniaorchestra.eu\/","email":"koinoniaorchestraofeurope@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700004608"},"fr":{"name":"Love, sorrow & desire","shortdescr":"Emmenez les personnes que vous aimez dans l'exploration de l'Amour, du Chagrin et du D\u00e9sir. \nUn concert classique propos\u00e9 par Koinonia, Orchestre d'Europe.\n\nEn commencant par le passionn\u00e9 Prelude et Liebestod de Wagner, passant par la m\u00e9lancolie de l'Adagietto de Mahler, extrait de la Symphonie n\u00b0 5, ses \"Songs of a Wayfarer\", et enfin la chaleuse amour de Wagner dans son Idylle de Siegfried.","longdescr":"Love, Sorrow and Desire, exploration de l'Amour, du Chagrin et du D\u00e9sir\n\nCommencant par le passionn\u00e9 Pr\u00e9lude et Liebestod de Wagner, extraits de Tristan et Isolde, nous racontant des d\u00e9sirs inassouvis et des amours tragiques ; passant par la beaut\u00e9 m\u00e9lancolique de l'Adagietto de Mahler, extrait de la Symphonie n\u00b0 5 ; explorant le monde introspectif de Mahler \u00e0 travers ses Chants du p\u00e8lerin, et enfin arrivant \u00e0 la paisible et chaleureuse amour que Wagner fait revivre dans son Idylle de Siegfried.\nLes 14 et 16 f\u00e9vrier \u00e0 Full Circle, un lieu qui accueille une communaut\u00e9 diverse de personnes contribuant au changement positif, une plateforme pour connecter de bonnes id\u00e9es avec le pouvoir de les r\u00e9aliser. Les portes de la salle s\u2019ouvrent une heure avant !","performers":"Kris Belligh\nWouter Versavel\nMarcello Masi","boxoffice_url":null,"website":"https:\/\/koinoniaorchestra.eu\/","email":"koinoniaorchestraofeurope@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700004608"},"sp":{"name":"Love, sorrow & desire","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/koinoniaorchestra.eu\/","email":"koinoniaorchestraofeurope@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700004608"},"nl":{"name":"Love, sorrow & 