":null,"sp":null,"pt":null,"cn":null}},"others":{"list":[24,34],"translations":{"fr":["Galeries d'art","Pluridisciplinaire"],"nl":["Galeries","Pluridisciplinair"],"en":["Art Galleries","Multidisciplinary"],"de":["Kunstgalerien","Multidisziplin\u00e4r"],"it":[null,null],"sp":[null,null],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Solstice Divers","shortdescr":"La photographe Yseult D et l'auteur St\u00e9phane Maton-Vann ont r\u00e9uni trois \u00ab artistes \u00bb singuliers et g\u00e9n\u00e9reux : Jo Charlton, une artiste peintre, Morgane Deffense une c\u00e9ramiste et Timpermann une cr\u00e9atrice de bijoux.\r\nAfin de vous permettre de jolis coups de c\u0153ur, le Studio 84 a particuli\u00e8rement veill\u00e9 \u00e0\r\nce que cet Art soit abordable...","longdescr":null,"performers":"Jo Charlton (Peintre), Morgane Deffense (C\u00e9ramiste), Timperman (Bijoux), Yseult D. (Photographie), St\u00e9phane Maton-Vann (Auteur)","boxoffice_url":null,"website":"https:\/\/www.facebook.com\/studio84bxl\/","email":"studio84.bxl@gmail.com","phone_contact":"+32 475 85 03 57","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.545191"},"nl":{"name":"Solstice Divers","shortdescr":"Fotografe Yseult D en auteur St\u00e9phane Maton-Vann hebben drie bijzondere en genereuze \"kunstenaars\" samengebracht: Jo Charlton, een schilderes, Morgane Deffense, een keramiste en Timpermann, een juwelenontwerpster.\r\nOm het u naar de zin te maken, heeft Studio 84 ervoor gezorgd dat deze kunst betaalbaar is.\r\ndat deze kunst betaalbaar is...","longdescr":null,"performers":"Jo Charlton (Schilder), Morgane Deffense (Keramist), Timperman (Juwelen), Yseult D. (Fotografie), St\u00e9phane Maton-Vann (Auteur).","boxoffice_url":null,"website":null,"email":"yseult2006@yahoo.fr","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.545191"},"en":{"name":"Solstice Divers","shortdescr":"Photographer Yseult D and author St\u00e9phane Maton-Vann have brought together three singular and generous \"artists\": Jo Charlton, a painter, Morgane Deffense, a ceramist and Timpermann, a jewellery designer.\r\nIn order to allow you to have a good time, Studio 84 has taken particular care to ensure that this art is affordable.\r\nthat this Art is affordable...","longdescr":null,"performers":"Jo CharltonJ (Painter), Morgane Deffense (Ceramist), Timperman (Jewellery), Yseult D. (Photography), St\u00e9phane Maton-Vann (Author)","boxoffice_url":null,"website":null,"email":"yseult2006@yahoo.fr","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.545191"},"de":{"name":"Solstice Divers","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.545191"},"it":{"name":"Solstice Divers","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.545191"},"sp":{"name":"Solstice Divers","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.545191"},"pt":{"name":"Solstice Divers","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.545191"},"cn":{"name":"Solstice Divers","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"ag