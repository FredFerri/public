accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater","it":"Teatro","sp":"Teatro","pt":null,"cn":null}},"others":{"list":[51],"translations":{"fr":["Caf\u00e9 th\u00e9\u00e2tre"],"nl":["Cabaret"],"en":["Cabaret"],"de":["Kabarett"],"it":["Cabaret"],"sp":["Caf\u00e9 teatro"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"The Boring Show - Spectacle d'improvisation de la Boring Team","shortdescr":null,"longdescr":"* THE BORING SHOW *\r\nVous aurez le plaisir de d\u00e9couvrir un\u00b7e improvisateur\u00b7trice d'exception \u00e0 chaque spectacle en plus de vos quatre Boring pr\u00e9f\u00e9r\u00e9\u00b7es.\r\nLes invit\u00e9\u00b7es sont des ami\u00b7es de la Boring Team venant des meilleures troupes d'improvisation. Cette fois-ci nous accueillons Nicolas Barras de la compagnie TADAM.\r\nPour le reste, c'est votre recette pr\u00e9f\u00e9r\u00e9e : un spectacle enti\u00e8rement improvis\u00e9 en deux parties.\r\nEn premi\u00e8re partie, en \u00e9change des mots de d\u00e9part qui vous seront demand\u00e9s, la Boring cr\u00e9era des histoires incroyables.\r\nEn deuxi\u00e8me partie, trois improvisations de 12 minutes, inspir\u00e9es de la premi\u00e8re partie, prendront vie sous vos yeux.\r\nUn cocktail de cr\u00e9ations instantan\u00e9es qui vous \u00e9tonnera encore et toujours par sa spontan\u00e9it\u00e9!\r\nN\u2019attendez plus, plut\u00f4t que de passer une soir\u00e9e boring venez plut\u00f4t voir un spectacle BORING !\r\n\r\nImprovisateurs de l'\u00e9quipe :\r\nDavid Hassoun\r\nJulie Lahure\r\nKevin Lerat\r\nAgathe Mortelecq\r\n\r\nKatia Duchateau\r\nSoufiane Agram\r\nAnne Baudaux\r\nPierre Ghijselings\r\nNicolas Grandry\r\nC\u00e9line Gortz\r\nVincent Wilbert\r\n-------\r\nINFOS PRATIQUES\r\nLieu : Le TRAC\r\nAdresse : 110, rue Albert Meunier- Auderghem\r\nSpectacle \u00e0 20h15\r\nIl est possible de manger et\/ou boire un verre sur place avant le spectacle, pensez donc \u00e0 venir plus t\u00f4t! (Derni\u00e8re commande de restauration \u00e0 19h55!)\r\nR\u00c9SERVATIONS (Vivement conseill\u00e9es)\r\nvia le lien du Trac : https:\/\/www.letrac.be\/reservations\r\nTARIFS\r\nSur r\u00e9servation : 10\u20ac\/\u00e9tudiant & 13\u20ac\/adulte\r\nSur place : 15\u20ac\/personne","performers":"La Boring Team","boxoffice_url":null,"website":"http:\/\/www.letrac.be\/reservation","email":"info@letrac.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.554414"},"nl":{"name":"The Boring Show - Spectacle d'improvisation de la Boring Team","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.letrac.be\/reservation","email":"info@letrac.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.554414"},"en":{"name":"The Boring Show - Spectacle d'improvisation de la Boring Team","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.letrac.be\/reservation","email":"info@letrac.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.554414"},"de":{"name":"The Boring Show - Spectacle d'improvisation de la Boring Team","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.letrac.be\/reservation","email":"info@letrac.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.554414"},"it":{"name":"The Boring Show - Spectacle d'improvisation de la Boring Team","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url"