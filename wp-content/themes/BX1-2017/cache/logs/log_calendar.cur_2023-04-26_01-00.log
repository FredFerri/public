ne_contact":"+32 474 86 42 45","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Rue Meyerbeer, 61","address_line2":"1190 Forest","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":null,"facebook_id":null,"backoffice_id":25910,"location":{"lat":50.8146756,"lon":4.34391913},"region":"brussels","last_updated_at":"2023-04-18T08:35:05+02:00","published_at":"2016-05-17T09:27:10+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/41baed055a23fc6dfc480a3e714828e0d06cd2f9.png","width":1415,"height":2000,"ratio":0.71,"translations":{"fr":{"title":"April's spells d'Anton Horvatovic","copyright":"The Palm Beach"},"nl":{"title":"April's spells d'Anton Horvatovic","copyright":"The Palm Beach"},"en":{"title":"April's spells d'Anton Horvatovic","copyright":"The Palm Beach"},"de":{"title":"April's spells d'Anton Horvatovic","copyright":"The Palm Beach"},"it":{"title":"April's spells d'Anton Horvatovic","copyright":"The Palm Beach"},"sp":{"title":"April's spells d'Anton Horvatovic","copyright":"The Palm Beach"},"pt":{"title":"April's spells d'Anton Horvatovic","copyright":"The Palm Beach"},"cn":{"title":"April's spells d'Anton Horvatovic","copyright":"The Palm Beach"}}}],"dates":[{"day":"2023-04-27","doors":null,"start":"14:00:00","end":"18:00:00"},{"day":"2023-04-28","doors":null,"start":"14:00:00","end":"18:00:00"},{"day":"2023-04-29","doors":null,"start":"14:00:00","end":"18:00:00"},{"day":"2023-05-04","doors":null,"start":"14:00:00","end":"18:00:00"},{"day":"2023-05-05","doors":null,"start":"14:00:00","end":"18:00:00"},{"day":"2023-05-06","doors":null,"start":"14:00:00","end":"18:00:00"},{"day":"2023-05-11","doors":null,"start":"14:00:00","end":"18:00:00"},{"day":"2023-05-12","doors":null,"start":"14:00:00","end":"18:00:00"},{"day":"2023-05-13","doors":null,"start":"14:00:00","end":"18:00:00"},{"day":"2023-05-18","doors":null,"start":"14:00:00","end":"18:00:00"},{"day":"2023-05-19","doors":null,"start":"14:00:00","end":"18:00:00"},{"day":"2023-05-20","doors":null,"start":"14:00:00","end":"18:00:00"},{"day":"2023-05-25","doors":null,"start":"14:00:00","end":"18:00:00"},{"day":"2023-05-26","doors":null,"start":"14:00:00","end":"18:00:00"},{"day":"2023-05-27","doors":null,"start":"14:00:00","end":"18:00:00"}],"weekschema":[{"days":{"monday":{"is_open":false},"tuesday":{"is_open":false},"wednesday":{"is_open":false},"thursday":{"is_open":true,"hours":[{"start":"14:00:00","end":"18:00:00"}]},"friday":{"is_open":true,"hours":[{"start":"14:00:00","end":"18:00:00"}]},"saturday":{"is_open":true,"hours":[{"start":"14:00:00","end":"18:00:00"}]},"sunday":{"is_open":false}},"translations":{"fr":["lundi, mardi, mercredi et dimanche: ferm\u00e9","jeudi, vendredi et samedi: de 14:00 \u00e0 18:00"],"nl":["maandag, dinsdag, woensdag en zondag: gesloten","donderdag, vrijdag en zaterdag: van 14:00 tot 18:00"],"en":["monday, tuesday, wednesday and sunday: closed","thursday, friday and saturday: from 14:00 to 18:00"],"de":["monday, tuesday, wednesday and sunday: closed","thursday, friday and saturday: from 14:00 to 18:00"],"it":["monday, tuesday, wednesday and sunday: closed","thursday, friday and saturday: from 14:00 to 18:00"],"sp":["monday, tuesday, wednesday and sunday: closed","thursday, friday and saturday: from 14:00 to 18:00"],"pt":["monday, tuesday, wednesday and sunday: closed","thursday, friday and saturday: from 14:00 to 18:00"],"cn":["monday, tuesday, wednesday and sunday: closed","thursday, friday and saturday: from 14:00 to 18:00"]},"date_start":"2023-04-27","date_end":"2023-05-27","is_also_by_appointment":true}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"opening":{"day":"2023-04-22","start":"17:00:00","timestamp":"2023-04-22T17:00:00+02:00","end":"20:00:00","is_only_by_appointment":false},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-04-18T08:35:05+02:00","published_at":"2023-04-18T08:13:23+02:00","backoffice_id":275559,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.40107239119072},{"id":554921,"date_start":"2023-04-19","date_end":"2023-05-20","date_next":"2023-04-27","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung","it":"Esposizioni","sp":"Exhibici\u00f3n","pt":null,"cn":null}},"others":{"list":[24,29],"translations":{"fr":["Galeries d'art","Installation"],"nl":["Galeries","Installatiekunst"],"en":["Art Galleries","Installation"],"de":["Kunstgalerien","Installation"],"it":["Gallerie d'arte","Installazioni"],"sp":["Galer\u00edas de arte","Instalaci\u00f3n"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","en"],"subtitles":[]},"translations":{"fr":{"name":"Silberblick","shortdescr":"L'\u0153uvre n'existe que lorsqu'elle est vue. Lorsqu'elle est pr\u00e9sent\u00e9e au spectateur, elle commence simplement \u00e0 vivre, et c'est seulement \u00e0 ce moment-l\u00e0 que l'\u0153uvre d'art peut \u00eatre consid\u00e9r\u00e9e et reconnue dans son existence. Pourtant, nous voulons qu'elle existe, nous voulons la montrer, m\u00eame si elle n'est pas physiquement l\u00e0.\r\nComment pr\u00e9senter ce qui n'est pas pr\u00e9sent ?","longdescr":"Traversons, dit-on un jour ;\r\n-pour voir ce que nous devenons-\r\nIls travers\u00e8rent, car l'un d'entre eux \u00e9tait vraiment l'unique.\r\nComme cela est apparu, cela a d\u00fb \u00eatre fait ;\r\nPourtant, pour voir encore, plus personne ne pouvait.\r\n\r\nL'\u0153uvre n'existe que lorsqu'elle est vue. Lorsqu'elle est pr\u00e9sent\u00e9e au spectateur, elle commence simplement \u00e0 vivre, et c'est seulement \u00e0 ce moment-l\u00e0 que l'\u0153uvre d'art peut \u00eatre consid\u00e9r\u00e9e et reconnue dans son existence. Pourtant, nous voulons qu'elle existe, nous voulons la montrer, m\u00eame si elle n'est pas physiquement l\u00e0.\r\nComment fa\u00e7onner l'invisible ? Comment pr\u00e9senter ce qui n'est pas pr\u00e9sent ?\r\n\r\nLe mot allemand Silberblick - dans sa d\u00e9finition originale \"regard d'argent\" - est une expression pour le strabisme, un regard lat\u00e9ral \u00e9troit, utilis\u00e9 dans les portraits de la fin de la Renaissance. Nous souhaitons donner un nouveau sens \u00e0 ce mot. Nous proposons que le Silberblick soit un moyen de d\u00e9placer le regard sur ce qui est observ\u00e9.\r\nIl s'agit d'un mouvement de focalisation, d'un acte de zoom avant et arri\u00e8re sur la forme et l'identit\u00e9 d'une chose. Ce faisant, nous pouvons commencer \u00e0 observer ce qui se trouve \u00e0 l'int\u00e9rieur et \u00e0 l'ext\u00e9rieur de l'\u0153uvre ; nous commen\u00e7ons \u00e0 la comprendre en profondeur et \u00e0 s\u00e9parer sa forme de sa signification r\u00e9elle. Ce nouveau contexte, cette action m\u00eame, tisse un fil conducteur entre toutes les \u0153uvres de l'exposition.\r\nNous sommes int\u00e9ress\u00e9s par la \"repr\u00e9sentation\" de l'acte de cr\u00e9er, de faire et de d\u00e9ployer beaucoup d'efforts - pour un r\u00e9sultat invisible - o\u00f9 tout a \u00e9t\u00e9 fait mais n'a pas \u00e9t\u00e9 visualis\u00e9. Ce faisant, nous pensons que le concept, l'id\u00e9e qui a conduit \u00e0 la cr\u00e9ation peut encore exister, ind\u00e9pendamment de la pr\u00e9sence physique de l'\u0153uvre.\r\nEst-il possible de (re)fa\u00e7onner quelque chose pour lui donner une nouvelle existence ?\r\nNous ne souhaitons pas pr\u00e9senter la valeur et la quantit\u00e9 de travail que repr\u00e9sente la fabrication d'une \u0153uvre. C'est l\u00e0 notre source de modestie, un refus volontaire des pr\u00e9misses visuelles. Nous nous interrogeons cependant sur la quantit\u00e9 et la qualit\u00e9 du travail et sur la valeur de sa r\u00e9alisation.\r\nLorsque tout le travail est fait, mais que personne ne peut le voir, que reste-t-il ?\r\nNous examinons ici la place et l'importance de l'artiste, des galeristes - leur pr\u00e9sence - et la pr\u00e9sence de leurs id\u00e9es et de leurs actions. Mais qui fait quoi exactement, et est-ce important ? Une \u0153uvre ou une id\u00e9e appartient-elle \u00e0 quelqu'un en particulier, a-t-elle un propri\u00e9taire ?\r\n\r\nL'invitation d'un artiste \u00e0 l'exposition solo sugg\u00e8re une mise \u00e0 l'\u00e9cart de nos individualit\u00e9s. Nous d\u00e9cidons de prendre du recul par rapport \u00e0 ce qui a \u00e9t\u00e9 fait auparavant et, ensemble, nous (re)formons les id\u00e9es pass\u00e9es en une nouvelle existence. Alors que nos regards et nos id\u00e9es se croisent - \u00e0 travers et \u00e0 l'int\u00e9rieur de ce point de rencontre - nous cherchons \u00e0 d\u00e9ployer ces hypoth\u00e8ses. La pr\u00e9sence d'une nouvelle personne devient un Silberblick. C'est une nouvelle information, c'est ce qui change le regard. \r\nMaintenant nous traversons.\r\n \r\n\r\n\r\n- la galerie est une bo\u00eete\r\n- les galeristes sont les activateurs de l'exposition\r\n- les pi\u00e8ces peuvent \u00eatre pr\u00e9sent\u00e9es dans un ordre diff\u00e9rent\r\n- l'exposition n'est pas en place lorsqu'il n'y a personne","performers":"Mara Fortunatovic\r\ninvit\u00e9: Mat\u00e9 Kohout","boxoffice_url":null,"website":"http:\/\/www.archiraar.com","email":"info@archiraar.com","phone_contact":"+32 479 58 46 60","phone_booking":"+32 479 58 46 60","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.554921"},"nl":{"name":"Silberblick","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.archiraar.com","email":"info@archiraar.com","phone_contact":"+32 479 58 46 60","phone_booking":"+32 479 58 46 60","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.554921"},"en":{"name":"Silberblick","shortdescr":"The work exists, only when it's seen. When presented to the viewer it merely starts to live, and only then, the work of art can be considered and acknowledged in its existence. Yet, we want it to exist, wishing to show it, even if it is physically not there.\r\nHow to shape the invisible? How to present what is not present?","longdescr":"Let's cross, said once\u00a0;\r\n-to behold what we become-\r\ncross they did, for one truly was the one.\r\nAs appeared, it must have been done;\r\nyet to see anymore, no longer could none\r\n\r\nThe work exists, only when it's seen. When presented to the viewer it merely starts to live, and only then, the work of art can be considered and acknowledged in its existence. Yet, we want it to exist, wishing to show it, even if it is physically not there.\r\nHow to shape the invisible? How to present what is not present?\r\n\r\n The German word Silberblick -in its original definition \"silver gaze\"- stands as an expression for cross-eyes, a narrowed sideways glance, used in late-Renaissance portraits. We wish to create a new meaning for the word. We propose that Silberblick can be a way of shifting the gaze on what is being observed. It is a movement of focusing, an act of zooming in and zooming out on something's shape and identity. By doing so, we can start to observe what's inside and outside the work; we begin to understand it thoroughly and separate its form from its real meaning. This new context, this very action is aligning a common thread through all the works in the exhibition.\r\n\r\nWe are interested in \"portraying\" the act of creating, doing and making a lot of effort - for an invisible result - where everything was made but unvisualised. Doing so, we believe that the concept, the idea that led to creation can still exist, regardless of the work's physical presence. Is it possible to (re)shape something into a new existence?\r\nWe wish not to present the value and the amount of work that is put into making. This is our source of modesty, a desired refusal of visual premises. We do however question the quantity and quality of the work and the worth of making it.\r\nWhen all the work is done, but no one can see it - what remains?\r\n\r\nHereby we examine the place and importance of the artist, the gallerists - their presence- and the presence of their ideas and actions. But who is doing what exactly, and is that important? Does a work or its idea belong to someone specific, does it have an owner?\r\nThe invitation of a featured artist to the solo show suggests removal from our individualities. We decide to step back from what was done before, and together, we (re)form past ideas into a new existence. As our eyes and ideas cross - through, and within this meeting point - we aim to unfold these hypotheses. The presence of a new person becomes a Silberblick. It's a new information, it's what is changing the gaze. \r\nNow we cross. \r\n\r\n- the gallery is a box\r\n- the gallerists are the activator of the show\r\n- the pieces can be presented in a different order\r\n- the show is unset when no one is there","performers":"Mara Fortunatovic\r\nfeaturing: Mat\u00e9 Kohout","boxoffice_url":null,"website":"http:\/\/www.archiraar.com","email":"info@archiraar.com","phone_contact":"+32 479 58 46 60","phone_booking":"+32 479 58 46 60","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.554921"},"de":{"name":"Silberblick","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.archiraar.com","email":"info@archiraar.com","phone_contact":"+32 479 58 46 60","phone_booking":"+32 479 58 46 60","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.554921"},"it":{"name":"Silberblick","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.archiraar.com","email":"info@archiraar.com","phone_contact":"+32 479 58 46 60","phone_booking":"+32 479 58 46 60","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.554921"},"sp":{"name":"Silberblick","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.archiraar.com","email":"info@archiraar.com","phone_contact":"+32 479 58 46 60","phone_booking":"+32 479 58 46 60","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.554921"},"pt":{"name":"Silberblick","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.archiraar.com","email":"info@archiraar.com","phone_contact":"+32 479 58 46 60","phone_booking":"+32 479 58 46 60","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.554921"},"cn":{"name":"Silberblick","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.archiraar.com","email":"info@archiraar.com","phone_contact":"+32 479 58 46 60","phone_booking":"+32 479 58 46 60","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.554921"}},"place":{"id":259658,"translations":{"fr":{"name":"Archiraar Gallery - Black Cube","address_street_name":"Rue de la Tulipe","address_street_number":"35 A","address_street_box":null,"email":"archiraar@gmail.com","website":"http:\/\/www.archiraar.com","phone_contact":"+32 479 58 46 60","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de la Tulipe, 35 A","address_line2":"1050 Ixelles","description_web":"Fond\u00e9e en 2012 par l\u2019architecte Alexis Rastel, la galerie Archiraar repr\u00e9sente des artistes internationaux de la g\u00e9n\u00e9ration \u00e9mergente et collabore avec des commissaires d\u2019exposition. Dans un b\u00e2timent brutaliste \u00e0 Bruxelles, ses deux espaces compl\u00e9mentaires h\u00e9bergent des projets en r\u00e9sonance. Le white cube en est le laboratoire artistique, le black cube propose une approche plus domestique.","description_print":"La galerie Archiraar a \u00e9t\u00e9 fond\u00e9e en 2012 par Alexis Rastel. Architecte de formation, il joint sa pratique spatiale \u00e0 la recherche plastique. La galerie repr\u00e9sente des artistes de la g\u00e9n\u00e9ration \u00e9mergente et projette une collaboration \u00e0 long terme. Elle pr\u00e9sente des travaux de peintures, dessins, sculptures, photographies, vid\u00e9os et installations.\r\nLe White cube de la galerie a \u00e9t\u00e9 ouvert en 2013 \u00e0 Bruxelles. Id\u00e9ologie d\u2019un espace neutre, ce volume de 3x3x9 m\u00e8tres questionne la monstration artistique contemporaine. Le Black cube, ouvert en 2014, en est l\u2019espace compl\u00e9mentaire. Sa forme close conseille une approche intime \u00e0 l\u2019\u0153uvre. Avec des expositions personnelles, les artistes repr\u00e9sent\u00e9s par la galerie ont pratiqu\u00e9 parall\u00e8lement les deux lieux de 2013 \u00e0 2015.\r\n\u00c0 partir de 2016, la galerie croise la programmation des espaces et invite des commissaires et des artistes \u00e0 participer aux expositions collectives. \u00c9galement, la galerie publie des \u00e9ditions afin de promouvoir et de diffuser le travail des artistes. \u00c0 chaque exposition, Archiraar h\u00e9berge des projets artistiques en r\u00e9sonance.","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Archiraar Gallery - Black Cube","address_street_name":"Tulpstraat","address_street_number":"35 A","address_street_box":null,"email":"archiraar@gmail.com","website":"http:\/\/www.archiraar.com","phone_contact":"+32 479 58 46 60","phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"Tulpstraat, 35 A","address_line2":"1050 Elsene","description_web":"Opgericht in 2012 door architect Alexis Rastel, vertegenwoordigd Archiraar Gallery internationale kunstenaars van de opkomende generatie en werkt samen met curatoren. In een brutalistisch gebouw in Brussel herbergen de twee complementaire ruimtes echo\u00ebnde projecten. De witte kubus is het artistieke laboratorium, de zwarte kubus stelt een meer huiselijke aanpak voor. ","description_print":"Archiraar Gallery werd in 2012 opgericht door Alexis Rastel. Architect van opleiding, combineert hij ruimtelijke praktijk met kunstzinnig onderzoek. De Galerie vertegenwoordigt opkomende kunstenaars, en streeft naar langdurige samenwerkingen. Gepresenteerde werken gaan van schilderijen, tekeningen, beeldhouwwerken, foto\u2019s, video\u2019s tot installaties.\r\nDe White Cube van de Galerie, werd in 2013 geopend in Brussel. Volgens de ideologie van een neutrale plek, reflecteert de ruimte van 3x3x9 meter op onze gebruikelijke, contemporaine manier om kunst tentoon te stellen. De Black Cube, geopend in 2014, vult de White Cube aan als zijn complementaire ruimte. Zijn gesloten ruimte geeft een intieme ervaring van het getoonde werk. Tussen 2013 en 2015 hebben kunstenaars, met parallelle solo-exposities, hun werk in beide ruimten van de galerie getoond.\r\nVanaf 2016 zal de Galerie de programma\u2019s van beide ruimten combineren, en curators en kunstenaars uitnodigen om aan groepsexposities deel te nemen. Daarnaast komt de Galerie met publicaties om het werk van de kunstenaars te promoten en te verspreiden. Met elke expositie komt Archiraar met artistieke, aangrijpende projecten.","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Archiraar Gallery - Black Cube","address_street_name":"Rue de la Tulipe","address_street_number":"35 A","address_street_box":null,"email":"archiraar@gmail.com","website":"http:\/\/www.archiraar.com","phone_contact":"+32 479 58 46 60","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de la Tulipe, 35 A","address_line2":"1050 Ixelles","description_web":"Archiraar Gallery was founded in 2012 by Alexis Rastel. As an architect, he joins his spatial practice with artistic research. The Gallery represents artists from the upcoming generation and plans on long time collaborations. It shows paintings, drawings, sculptures, pictures, videos and installations.\r\nThe Gallery\u2019s White Cube was opened in Brussels in 2013. Ideology of a neutral space, this volume of 3x3x9 meters questions our contemporary habits of showing art. The Black Cube, opened in 2014, is its complementary space. Its enclosed space suggests an intimate perception of the work. Between 2013 and 2015, with parallel solo shows, artists represented by the gallery have shown in both spaces.\r\nStarting 2016, the Gallery will be intersecting the spaces\u2019 programs and inviting curators and artists to participate in group shows. In addition, the Gallery publishes and promotes artists\u2019 works. With each show, Archiraar houses resonating artistic projects.","description_print":"Archiraar Gallery was founded in 2012 by Alexis Rastel. As an architect, he joins his spatial practice with artistic research. The Gallery represents artists from the upcoming generation and plans on long time collaborations. It shows paintings, drawings, sculptures, pictures, videos and installations.\r\nThe Gallery\u2019s White Cube was opened in Brussels in 2013. Ideology of a neutral space, this volume of 3x3x9 meters questions our contemporary habits of showing art. The Black Cube, opened in 2014, is its complementary space. Its enclosed space suggests an intimate perception of the work. Between 2013 and 2015, with parallel solo shows, artists represented by the gallery have shown in both spaces.\r\nStarting 2016, the Gallery will be intersecting the spaces\u2019 programs and inviting curators and artists to participate in group shows. In addition, the Gallery publishes and promotes artists\u2019 works. With each show, Archiraar houses resonating artistic projects.","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Archiraar Gallery - Black Cube","address_street_name":"Rue de la Tulipe","address_street_number":"35 A","address_street_box":null,"email":"archiraar@gmail.com","website":"http:\/\/www.archiraar.com","phone_contact":"+32 479 58 46 60","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de la Tulipe, 35 A","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Archiraar Gallery - Black Cube","address_street_name":"Rue de la Tulipe","address_street_number":"35 A","address_street_box":null,"email":"archiraar@gmail.com","website":"http:\/\/www.archiraar.com","phone_contact":"+32 479 58 46 60","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de la Tulipe, 35 A","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Archiraar Gallery - Black Cube","address_street_name":"Rue de la Tulipe","address_street_number":"35 A","address_street_box":null,"email":"archiraar@gmail.com","website":"http:\/\/www.archiraar.com","phone_contact":"+32 479 58 46 60","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de la Tulipe, 35 A","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Archiraar Gallery - Black Cube","address_street_name":"Rue de la Tulipe","address_street_number":"35 A","address_street_box":null,"email":"archiraar@gmail.com","website":"http:\/\/www.archiraar.com","phone_contact":"+32 479 58 46 60","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de la Tulipe, 35 A","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Archira