","Enfants 9-12 ans"],"nl":["Kinderen 6-9 j.","Kinderen 9-12 j."],"en":["Children 6-9 yr.","Children 9-12 yr."],"de":["Kinder 6-9 Jahre","Kinder 9-12 Jahre"],"it":["Bambini 6-9 anni","Bambini 9-12 anni"],"sp":["Ni\u00f1os de 6 a 9 a\u00f1os","Ni\u00f1os de 9 a 12 a\u00f1os"],"pt":[null,null],"cn":[null,null]}},"tags":["kids"],"accessibilities":{"list":[255,265,266],"translations":{"fr":["Accessible","WC adapt\u00e9","Brussels Health Safety Label"],"nl":["Toegankelijk","Aangepast toilet","Brussels Health Safety Label"],"en":["Accessible","Adapted toilet","Brussels Health Safety Label"],"de":["Barrierefrei","Barrierefreies WC","Brussels Health Safety Label"],"it":["Accessibile","WC idoneo","Brussels Health Safety Label"],"sp":["Habilitado","Ba\u00f1os adaptados","Brussels Health Safety Label"],"pt":[null,null,null],"cn":[null,null,null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2023-02-11T06:35:19+01:00","published_at":"2022-08-10T11:58:08+02:00","backoffice_id":259462,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":0.27909200099982},{"id":549434,"date_start":"2023-02-05","date_end":"2023-08-06","date_next":"2023-03-05","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen","it":"Visite guidate","sp":"Visitas guiadas","pt":null,"cn":null}},"others":{"list":[103],"translations":{"fr":["Centre historique"],"nl":["Historisch centrum"],"en":["Historical Centre"],"de":["Historisches Zentrum"],"it":["Centro storico"],"sp":["Centro hist\u00f3rico"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Visiter le b\u00e9guinage d'Anderlecht restaur\u00e9","shortdescr":"D\u00e9couvrez ce patrimoine architectural exceptionnel \u00e0 Bruxelles","longdescr":"La restauration du plus petit b\u00e9guinage de Belgique s\u2019est achev\u00e9e en 2022. Avant l\u2019inauguration de son tout nouveau projet mus\u00e9al \u00e0 l\u2019automne 2023, le b\u00e9guinage d\u2019Anderlecht entrouvre ses portes au public pour certains \u00e9v\u00e9nements. Lors de ces jours d\u2019ouverture avec visites guid\u00e9es, vous pourrez d\u00e9couvrir le travail accompli pour rendre son allure d\u2019origine.\r\n\r\n14h : Visite guid\u00e9e combin\u00e9e du b\u00e9guinage et de la Maison d\u2019\u00c9rasme \u00ab Architecture & Histoire \u00bb\r\nD\u00e9part au B\u00e9guinage, la visite se poursuit \u00e0 14h45 \u00e0 la Maison d\u2019\u00c9rasme et dans ses jardins.\r\nDur\u00e9e : 1h30\r\nGratuit et sans r\u00e9servation !","performers":"Guide du mus\u00e9e","boxoffice_url":null,"website":"https:\/\/erasmushouse.museum\/2022\/09\/visiter-le-beguinage-restaure\/","email":"info@erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.549434"},"nl":{"name":"Bezoek het gerestaureerde begijnhof van Anderlecht","shortdescr":"Ontdek dit uitzonderlijk architecturaal erfgoed in Brussel","longdescr":"In 2022 is de restauratie van het kleinste Begijnhof van Belgi\u00eb dan eindelijk afgerond. Het Begijnhof van Anderlecht opent alvast eventjes, v\u00f3\u00f3r de offici\u00eble opening van zijn nieuw museaal project tegen de herfst 2023, zijn deuren voor het publiek.\r\nTijdens de heropening die gepaard zal gaan met rondleidingen, kunt u ontdekken wat voor een werk er werd verricht om aan dit uitzonderlijk architecturaal erfgoed \u2013 uniek in Europa \u2013 zijn oorspronkelijke allure terug te geven.\r\n\r\nRondleiding \u00abArchitectuur & Geschiedenis\u00bb om 14 uur\r\nVertrek in het Begijnhof, het bezoek wordt om 14.45 uur voortgezet in het Erasmushuis en haar tuinen\r\nGratis toegang zonder reservering (1u30, in het Frans)","performers":"Museumgids","boxoffice_url":null,"website":"https:\/\/erasmushouse.museum\/nl\/2022\/09\/bezoek-het-gerestaureerde-begijnhof\/","email":"info@erasmushouse.museum","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.549434"},"en":{"name":"Visit the restored Anderlecht beguinage","shortdescr":"Discover this extraordinary heritage site unique in Brussel","longdescr":"The restoration of the smallest beguinage in Belgium was completed in 2022. Before its brand-new museum project is inaugurated in autumn 2023, the Anderlecht beguinage is opening its doors to the public for a few events. These exceptional opening days will enable everyone to discover this entirely restored architectural jewel in a pristine state before its reallocation as a museum space.\r\nUpon the occasion of its re-opening, accompanied by guided tours, you will be able to discover the work done to restore its original appearance to this extraordinary heritage site unique in Europe.\r\n\r\nLocation: Rue du Chapelain, 8, 1070 Brussels\r\nGuided tour \u201cArchitecture & History\u201d at 2 p.m of the Beguinage and the Erasmus House (duration: 1:30, in french)\r\nDeparture at the Beguinage, the visit continues at 2:45 pm at the Erasmus House and its gardens.\r\nFree entrance without reservation.","performers":"Museum guide","boxoffice_url":null,"website":"https:\/\/erasmushouse.museum\/en\/2022\/09\/visit-the-restored-beguinage\/","email":"info@erasmushouse.museum","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.549434"},"de":{"name":"Visiter le b\u00e9guinage d'Anderlecht restaur\u00e9","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/erasmushouse.museum\/2022\/09\/visiter-le-beguinage-restaure\/","email":"info@erasmushouse.museum","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.549434"},"it":{"name":"Visiter le b\u00e9guinage d'Anderlecht restaur\u00e9","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/erasmushouse.museum\/2022\/09\/visiter-le-beguinage-restaure\/","email":"info@erasmushouse.museum","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.549434"},"sp":{"name":"Visiter le b\u00e9guinage d'Anderlecht restaur\u00e9","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/erasmushouse.museum\/2022\/09\/visiter-le-beguinage-restaure\/","email":"info@erasmushouse.museum","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.549434"},"pt":{"name":"Visiter le b\u00e9guinage d'Anderlecht restaur\u00e9","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/erasmushouse.museum\/2022\/09\/visiter-le-beguinage-restaure\/","email":"info@erasmushouse.museum","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.549434"},"cn":{"name":"Visiter le b\u00e9guinage d'Anderlecht restaur\u00e9","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/erasmushouse.museum\/2022\/09\/visiter-le-beguinage-restaure\/","email":"info@erasmushouse.museum","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.549434"}},"place":{"id":8600,"translations":{"fr":{"name":"Mus\u00e9es Maison d\u2019\u00c9rasme & B\u00e9guinage","address_street_name":"Rue de Formanoir","address_street_number":"31","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de Formanoir, 31","address_line2":"1070 Anderlecht","description_web":"La Maison d\u2019\u00c9rasme et le b\u00e9guinage, voisins de la coll\u00e9giale des Saints-Pierre-et-Guidon, constituent un ensemble historique remarquable au c\u0153ur de la commune d\u2019Anderlecht.  \r\nLa Maison d\u2019\u00c9rasme est une des plus anciennes demeures de la r\u00e9gion de Bruxelles. \u00c9rasme y r\u00e9sida de mai \u00e0 octobre 1521. On y d\u00e9couvre des sculptures, peintures et gravures de ma\u00eetres des 15e au 17e si\u00e8cles : Albrecht D\u00fcrer, Hugo Van der Goes, Cornelis Metsys... ainsi que des portraits d\u2019\u00c9rasme, inspir\u00e9s de Hans Holbein et de Quentin Metsys. Une riche collection de livres du 16e si\u00e8cle refl\u00e8te la pens\u00e9e d'\u00c9rasme, le \u00ab Prince des humanistes \u00bb. \r\nUn Jardin de plantes m\u00e9dicinales, dessin\u00e9 par le paysagiste Ren\u00e9 Pech\u00e8re, pr\u00e9sente une centaine de plantes connues du 16e si\u00e8cle. Au-del\u00e0, s\u2019\u00e9tend un Jardin philosophique qui abrite des \u0153uvres d\u2019artistes contemporains dont Marie-Jo Lafontaine et Bob Verschueren. \r\n\r\nLe b\u00e9guinage d\u2019Anderlecht est le plus petit b\u00e9guinage de Belgique. Fond\u00e9 en 1252, il se compose de deux ailes encadrant un jardin clos. Il accueillait des b\u00e9guines jusqu\u2019\u00e0 la R\u00e9volution fran\u00e7aise. Le b\u00e9guinage a subi une restauration approfondie et est d\u00e9sormais ouvert aux visiteurs. Un nouveau projet mus\u00e9al sera finalis\u00e9 \u00e0 l\u2019automne 2023. ","description_print":"21\/09\/2022\r\n\u00c9rasme a s\u00e9journ\u00e9 en 1521 dans cette maison gothique (1450-1515) qui rassemble \u00e0\r\nla fois une collection de peintures, gravures et scuptures (Albrecht Du\u0308rer, Joos Van\r\nCleve, Pieter Huys, Cornelis Metsys, Frans Francken le Jeune \u2026), une biblioth\u00e8que\r\nsp\u00e9cialis\u00e9e dans les \u00e9ditions princeps, c\u2019est-\u00e0-dire les premi\u00e8res \u00e9ditions d\u2019une \u0153uvre\r\nchez diff\u00e9rents imprimeurs, un Jardin philosophique et un Jardin de plantes\r\nm\u00e9dicinales. Le mus\u00e9e publie des livres et organise des conf\u00e9rences, des concerts,\r\ndes expositions d\u2019art contemporain et historiques, des activit\u00e9s p\u00e9dagogiques, des\r\nvisites guid\u00e9es pour groupes.\r\n\r\n","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Erasmushuis & Begijnhofmusea","address_street_name":"Formanoirstraat","address_street_number":"31","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Formanoirstraat, 31","address_line2":"1070 Anderlecht","description_web":"Het Erasmushuis, het begijnhof en de collegiale Sint-Pieter-en Sint-Guidokerk vormen een uitzonderlijk historisch geheel in het centrum van de gemeente Anderlecht. Het Erasmushuis is een van de oudste huizen in Brussel waar Erasmus verbleef van mei tot oktober 1521. In de verschillende vertrekken kun je schilderijen en prenten van de meesters uit de 15de tot de 17de eeuw ontdekken, zoals Albrecht D\u00fcrer, Hugo Van der Goes, Cornelis Metsys... alsook portretten van Erasmus naar het voorbeeld van Hans Holbein en Quentin Metsys. Een rijke collectie boeken uit de 16de eeuw vertegenwoordigt het gedachtegoed van deze bijzondere humanist.  \r\n\r\nAchter het huis bevindt zich een tuin met geneeskrachtige planten ontworpen door landschapsarchitect Ren\u00e9 Pech\u00e8re. Hier worden zo\u2019n honderd geneeskrachtige planten gekweekt die bekend waren bij de geneesheren uit de 16de eeuw. Daarachter bevindt zich een filosofische tuin met werken van hedendaagse kunstenaars, zoals Marie-Jo Lafontaine en Bob Verschueren.  \r\n\r\nHet begijnhof van Anderlecht is het kleinste van Belgi\u00eb. Het werd gesticht in 1252 en bestaat tegenwoordig uit twee vleugels rondom een ommuurde tuin met waterput. Hier vonden begijnen onderdak tot aan de Franse Revolutie. Na een grondige restauratie staat het begijnhof voortaan weer open voor bezoekers! Momenteel wordt een nieuw museumproject uitgewerkt dat tegen de herfst 2023 voltooid zou moeten zijn. \r\n","description_print":"21\/09\/2022\r\nIn 1521 verbleef Erasmus in dit gotische huis (1450-1515) waar zich niet alleen een collectie bevindt van schilderijen, prenten en beeldhouwwerken (Albrecht Du\u0308rer, Joos\r\nVan Cleve, Pieter Huys, Cornelis Metsys, Frans Francken de Jongere\u2026), maar ook een\r\nbibliotheek gespecialiseerd in \u2018editiones principes\u2019, dat wil zeggen de eerste uitgaven\r\nvan een werk bij verschillende drukkers. Verder bevindt zich buiten nog een Filosofische\r\ntuin en een tuin met Geneeskrachtige planten.\r\nDaarnaast publiceert het museum boeken en organiseert voordrachten, concerten,\r\ntentoonstellingen met een historisch thema en tentoonstellingen Hedendaagse kunst,\r\npedagogische activiteiten en rondleidingen voor groepen.","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Erasmus House & Beguinage Museums","address_street_name":"Rue de Formanoir","address_street_number":"31","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de Formanoir, 31","address_line2":"1070 Anderlecht","description_web":"The Erasmus House, beguinage, and collegiate church of Saints Peter and Guido form a magnificent historical ensemble, right in the heart of the commune. Erasmus House \u2013 in which the famous philosopher and scholar stayed from May to October 1521 \u2013 is one of the oldest Gothic houses in the Belgian capital. It hosts a sublime collection of paintings, prints and sculptures by 15th-17th century masters like Albrecht D\u00fcrer, Hugo Van der Goes, Cornelis Metsys\u2026 not to mention portraits of Erasmus inspired by Hans Holbein and Quentin Metsys. A rich collection of 16th century books is a nod to the singular humanist\u2019s thinking.  \r\n\r\nA medicinal plant garden \u2013 designed by landscape architect Ren\u00e9 Pech\u00e8re \u2013 presents around one hundred medicinal plants that were known to 16th century physicians. Beyond it stretches a philosophical garden that is home to the works of contemporary artists like Marie-Jo Lafontaine and Bob Verschueren. \r\n\r\nThe beguinage of Anderlecht is Belgium\u2019s smallest. Founded in 1252, today it consists of two wings framing an enclosed garden with its own well. It housed beguines right up until the French Revolution and has been completely and lovingly restored, meaning it could, once again, be re-opened to the public! A new museum project is currently in the pipeline and should be finalised in autumn 2023. ","description_print":"21\/09\/2022\r\nFor several months, this house, which looks like a cloister, was home to the brilliant 16th-century humanist. Works of art, engravings, books, and archives bear witness to life in that era. End your visit in the philosophical and medicinal garden.","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Mus\u00e9es Maison d\u2019\u00c9rasme & B\u00e9guinage","address_street_name":"Rue de Formanoir","address_street_number":"31","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de Formanoir, 31","address_line2":"1070 Anderlecht","description_web":"","description_print":"21\/09\/2022\r\nDas \u201eMaison d\u2019Erasme\u201c in der Br\u00fcsseler Gemeinde Anderlecht wurde Ende des 15. Jahrhunderts im Auftrag eines Stiftsherrn der nahegelegenen Stiftskirche St. Peter und St. Guido  im sp\u00e4tgotischen Stil errichtet.\r\n\r\nDas Haus beherbergte im Jahr 1521 den bedeutenden niederl\u00e4ndischen Gelehrten des Renaissance-Humanismus Erasmus von Rotterdam, der hier, fernab von den gro\u00dfen Machtzentren und den dort herrschenden Religionskriegen, die Ruhe und Abgeschiedenheit der Natur suchte.\r\n\r\nDas im Maison d\u2019Erasme untergebrachte Museum zeigt sowohl eine Gem\u00e4ldesammlung mit Werken von Holbein, Bosch und Metsys als auch eine reich mit alten B\u00fccherausgaben best\u00fcckte Bibliothek. Der umliegende Garten besteht aus einem \u201eJardin des Maladies\u201c \u2013 dem \u201eGarten der Krankheiten\u201c mit zahlreichen Heilpflanzen \u2013 und einem \u201eJardin philosophique\u201c \u2013 dem \u201ePhilosophischen Garten\u201c.","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Mus\u00e9es Maison d\u2019\u00c9rasme & B\u00e9guinage","address_street_name":"Rue de Formanoir","address_street_number":"31","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de Formanoir, 31","address_line2":"1070 Anderlecht","description_web":"","description_print":"21\/09\/2022\r\nLa Casa di Erasmo deve il suo nome e la sua fama ad Erasmo da Rotterdam, che vi soggiorn\u00f2 nel 1521. Divenuta un museo dedicato al grande umanista rinascimentale, \u00e8 luogo di esposizione di una collezione unica composta da opere d'arte - sculture e dipinti di maestri fiamminghi -, mobili e libri antichi, molti dei quali scritti dallo stesso Erasmo. Se la Casa di Erasmo \u00e8 una delle pi\u00f9 antiche di Bruxelles - costruita in tre fasi nel corso dei secoli XV e XVI -, nel 1932 \u00e8 stata oggetto di un restauro completo voluto, nello spirito del pi\u00f9 puro storicismo, da Daniel Van Damme, fondatore del museo, con l'aiuto dell'architetto Charles Van Elst, che costru\u00ec anche la casa di Maurice Car\u00eame.  Gli spazi interni sono stati poi riconvertiti in sale del museo. Queste sono state decorate (una stanza con le pareti completamente rivestite di sontuose pelli di Cordoba) ed arredate con mobili provenienti dall'antica collezione del Ministro Vandenpeereboom. Gli interni sono quindi ricostruzioni con lo scopo di dare ai visitatori un'idea di quello che poteva essere una residenza rinascimentale. Le ricostruzioni sono in parte basate su documenti storici (lo studio di Erasmo che d\u00e0 sul giardino) ed in parte su ritrovamenti archeologici quali lo splendido fregio affrescato del primo piano. Nella parte posteriore della casa, un ampio giardino ombreggiato da grandi alberi conserva alcuni resti archeologici dell'antico castello di Anderlecht, poeticamente abbinati a diverse installazioni di artisti contemporanei. ","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Mus\u00e9es Maison d\u2019\u00c9rasme & B\u00e9guinage","address_street_name":"Rue de Formanoir","address_street_number":"31","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de Formanoir, 31","address_line2":"1070 Anderlecht","description_web":"","description_print":"21\/09\/2022\r\nLa Casa de Erasmo debe su nombre y prestigio a la temporada que pas\u00f3 en ella Erasmo de R\u00f3terdam en 1521. Convertida en un museo dedicado a este gran humanista del Renacimiento, es el envoltorio de una colecci\u00f3n \u00fanica compuesta por obras de arte (esculturas y pinturas de maestros flamencos), muebles y libros antiguos, entre ellos numerosas ediciones erasmianas. Si la Casa de Erasmo es una de las m\u00e1s antiguas de Bruselas (construida en tres fases a lo largo de los siglos XV y XVI), a partir de 1932 fue objeto de una restauraci\u00f3n completa llevada a cabo, en el m\u00e1s puro historicismo, por Daniel Van Damme, fundador del museo, con la ayuda del arquitecto Charles Van Elst, que tambi\u00e9n construy\u00f3 la casa de Maurice Car\u00eame. Los espacios interiores se reorganizaron entonces en salas de museo que fueron decoradas (entre ellas, una sala con las paredes totalmente cubiertas por suntuosas pieles de C\u00f3rdoba) y amuebladas con mobiliario procedente de la antigua colecci\u00f3n del ministro Vandenpeereboom. El interior es, por tanto, una reproducci\u00f3n cuyo fin es dar a los visitantes la idea de lo que podr\u00eda haber sido una residencia en el Renacimiento, basada en parte en documentos hist\u00f3ricos (despacho de Erasmo frente al jard\u00edn) y en hallazgos arqueol\u00f3gicos como el maravilloso friso pintado al fresco del primer piso. Detr\u00e1s de la casa, un vasto jard\u00edn con grandes \u00e1rboles que le dan sombra conserva algunos restos arqueol\u00f3gicos del antiguo castillo de Anderlecht, los cuales se encuentran, po\u00e9ticamente, cerca de varias instalaciones de artistas contempor\u00e1neos. ","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Mus\u00e9es Maison d\u2019\u00c9rasme & B\u00e9guinage","address_street_name":"Rue de Formanoir","address_street_number":"31","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de Formanoir, 31","address_line2":"1070 Anderlecht","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Mus\u00e9es Maison d\u2019\u00c9rasme & B\u00e9guinage","address_street_name":"Rue de Formanoir","address_street_number":"31","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de Formanoir, 31","address_line2":"1070 Anderlecht","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":[],"zones":{"list":[21],"translations":{"fr":["Sud"],"nl":["Zuid"],"en":["South"],"de":["S\u00fcden"],"it":["Sud"],"sp":["Sur"],"pt":[null],"cn":[null]}},"neca":null,"facebook_id":null,"backoffice_id":327,"location":{"lat":50.83592263,"lon":4.3077579},"region":"brussels","last_updated_at":"2023-02-10T17:36:28+01:00","published_at":"2013-10-19T01:13:26+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":8600,"translations":{"fr":{"name":"Mus\u00e9es Maison d\u2019\u00c9rasme & B\u00e9guinage","address_street_name":"Rue de Formanoir","address_street_number":"31","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de Formanoir, 31","address_line2":"1070 Anderlecht","description_web":"La Maison d\u2019\u00c9rasme et le b\u00e9guinage, voisins de la coll\u00e9giale des Saints-Pierre-et-Guidon, constituent un ensemble historique remarquable au c\u0153ur de la commune d\u2019Anderlecht.  \r\nLa Maison d\u2019\u00c9rasme est une des plus anciennes demeures de la r\u00e9gion de Bruxelles. \u00c9rasme y r\u00e9sida de mai \u00e0 octobre 1521. On y d\u00e9couvre des sculptures, peintures et gravures de ma\u00eetres des 15e au 17e si\u00e8cles : Albrecht D\u00fcrer, Hugo Van der Goes, Cornelis Metsys... ainsi que des portraits d\u2019\u00c9rasme, inspir\u00e9s de Hans Holbein et de Quentin Metsys. Une riche collection de livres du 16e si\u00e8cle refl\u00e8te la pens\u00e9e d'\u00c9rasme, le \u00ab Prince des humanistes \u00bb. \r\nUn Jardin de plantes m\u00e9dicinales, dessin\u00e9 par le paysagiste Ren\u00e9 Pech\u00e8re, pr\u00e9sente une centaine de plantes connues du 16e si\u00e8cle. Au-del\u00e0, s\u2019\u00e9tend un Jardin philosophique qui abrite des \u0153uvres d\u2019artistes contemporains dont Marie-Jo Lafontaine et Bob Verschueren. \r\n\r\nLe b\u00e9guinage d\u2019Anderlecht est le plus petit b\u00e9guinage de Belgique. Fond\u00e9 en 1252, il se compose de deux ailes encadrant un jardin clos. Il accueillait des b\u00e9guines jusqu\u2019\u00e0 la R\u00e9volution fran\u00e7aise. Le b\u00e9guinage a subi une restauration approfondie et est d\u00e9sormais ouvert aux visiteurs. Un nouveau projet mus\u00e9al sera finalis\u00e9 \u00e0 l\u2019automne 2023. ","description_print":"21\/09\/2022\r\n\u00c9rasme a s\u00e9journ\u00e9 en 1521 dans cette maison gothique (1450-1515) qui rassemble \u00e0\r\nla fois une collection de peintures, gravures et scuptures (Albrecht Du\u0308rer, Joos Van\r\nCleve, Pieter Huys, Cornelis Metsys, Frans Francken le Jeune \u2026), une biblioth\u00e8que\r\nsp\u00e9cialis\u00e9e dans les \u00e9ditions princeps, c\u2019est-\u00e0-dire les premi\u00e8res \u00e9ditions d\u2019une \u0153uvre\r\nchez diff\u00e9rents imprimeurs, un Jardin philosophique et un Jardin de plantes\r\nm\u00e9dicinales. Le mus\u00e9e publie des livres et organise des conf\u00e9rences, des concerts,\r\ndes expositions d\u2019art contemporain et historiques, des activit\u00e9s p\u00e9dagogiques, des\r\nvisites guid\u00e9es pour groupes.\r\n\r\n","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Erasmushuis & Begijnhofmusea","address_street_name":"Formanoirstraat","address_street_number":"31","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Formanoirstraat, 31","address_line2":"1070 Anderlecht","description_web":"Het Erasmushuis, het begijnhof en de collegiale Sint-Pieter-en Sint-Guidokerk vormen een uitzonderlijk historisch geheel in het centrum van de gemeente Anderlecht. Het Erasmushuis is een van de oudste huizen in Brussel waar Erasmus verbleef van mei tot oktober 1521. In de verschillende vertrekken kun je schilderijen en prenten van de meesters uit de 15de tot de 17de eeuw ontdekken, zoals Albrecht D\u00fcrer, Hugo Van der Goes, Cornelis Metsys... alsook portretten van Erasmus naar het voorbeeld van Hans Holbein en Quentin Metsys. Een rijke collectie boeken uit de 16de eeuw vertegenwoordigt het gedachtegoed van deze bijzondere humanist.  \r\n\r\nAchter het huis bevindt zich een tuin met geneeskrachtige planten ontworpen door landschapsarchitect Ren\u00e9 Pech\u00e8re. Hier worden zo\u2019n honderd geneeskrachtige planten gekweekt die bekend waren bij de geneesheren uit de 16de eeuw. Daarachter bevindt zich een filosofische tuin met werken van hedendaagse kunstenaars, zoals Marie-Jo Lafontaine en Bob Verschueren.  \r\n\r\nHet begijnhof van Anderlecht is het kleinste van Belgi\u00eb. Het werd gesticht in 1252 en bestaat tegenwoordig uit twee vleugels rondom een ommuurde tuin met waterput. Hier vonden begijnen onderdak tot aan de Franse Revolutie. Na een grondige restauratie staat het begijnhof voortaan weer open voor bezoekers! Momenteel wordt een nieuw museumproject uitgewerkt dat tegen de herfst 2023 voltooid zou moeten zijn. \r\n","description_print":"21\/09\/2022\r\nIn 1521 verbleef Erasmus in dit gotische huis (1450-1515) waar zich niet alleen een collectie bevindt van schilderijen, prenten en beeldhouwwerken (Albrecht Du\u0308rer, Joos\r\nVan Cleve, Pieter Huys, Cornelis Metsys, Frans Francken de Jongere\u2026), maar ook een\r\nbibliotheek gespecialiseerd in \u2018editiones principes\u2019, dat wil zeggen de eerste uitgaven\r\nvan een werk bij verschillende drukkers. Verder bevindt zich buiten nog een Filosofische\r\ntuin en een tuin met Geneeskrachtige planten.\r\nDaarnaast publiceert het museum boeken en organiseert voordrachten, concerten,\r\ntentoonstellingen met een historisch thema en tentoonstellingen Hedendaagse kunst,\r\npedagogische activiteiten en rondleidingen voor groepen.","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Erasmus House & Beguinage Museums","address_street_name":"Rue de Formanoir","address_street_number":"31","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de Formanoir, 31","address_line2":"1070 Anderlecht","description_web":"The Erasmus House, beguinage, and collegiate church of Saints Peter and Guido form a magnificent historical ensemble, right in the heart of the commune. Erasmus House \u2013 in which the famous philosopher and scholar stayed from May to October 1521 \u2013 is one of the oldest Gothic houses in the Belgian capital. It hosts a sublime collection of paintings, prints and sculptures by 15th-17th century masters like Albrecht D\u00fcrer, Hugo Van der Goes, Cornelis Metsys\u2026 not to mention portraits of Erasmus inspired by Hans Holbein and Quentin Metsys. A rich collection of 16th century books is a nod to the singular humanist\u2019s thinking.  \r\n\r\nA medicinal plant garden \u2013 designed by landscape architect Ren\u00e9 Pech\u00e8re \u2013 presents around one hundred medicinal plants that were known to 16th century physicians. Beyond it stretches a philosophical garden that is home to the works of contemporary artists like Marie-Jo Lafontaine and Bob Verschueren. \r\n\r\nThe beguinage of Anderlecht is Belgium\u2019s smallest. Founded in 1252, today it consists of two wings framing an enclosed garden with its own well. It housed beguines right up until the French Revolution and has been completely and lovingly restored, meaning it could, once again, be re-opened to the public! A new museum project is currently in the pipeline and should be finalised in autumn 2023. ","description_print":"21\/09\/2022\r\nFor several months, this house, which looks like a cloister, was home to the brilliant 16th-century humanist. Works of art, engravings, books, and archives bear witness to life in that era. End your visit in the philosophical and medicinal garden.","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Mus\u00e9es Maison d\u2019\u00c9rasme & B\u00e9guinage","address_street_name":"Rue de Formanoir","address_street_number":"31","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de Formanoir, 31","address_line2":"1070 Anderlecht","description_web":"","description_print":"21\/09\/2022\r\nDas \u201eMaison d\u2019Erasme\u201c in der Br\u00fcsseler Gemeinde Anderlecht wurde Ende des 15. Jahrhunderts im Auftrag eines Stiftsherrn der nahegelegenen Stiftskirche St. Peter und St. Guido  im sp\u00e4tgotischen Stil errichtet.\r\n\r\nDas Haus beherbergte im Jahr 1521 den bedeutenden niederl\u00e4ndischen Gelehrten des Renaissance-Humanismus Erasmus von Rotterdam, der hier, fernab von den gro\u00dfen Machtzentren und den dort herrschenden Religionskriegen, die Ruhe und Abgeschiedenheit der Natur suchte.\r\n\r\nDas im Maison d\u2019Erasme untergebrachte Museum zeigt sowohl eine Gem\u00e4ldesammlung mit Werken von Holbein, Bosch und Metsys als auch eine reich mit alten B\u00fccherausgaben best\u00fcckte Bibliothek. Der umliegende Garten besteht aus einem \u201eJardin des Maladies\u201c \u2013 dem \u201eGarten der Krankheiten\u201c mit zahlreichen Heilpflanzen \u2013 und einem \u201eJardin philosophique\u201c \u2013 dem \u201ePhilosophischen Garten\u201c.","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Mus\u00e9es Maison d\u2019\u00c9rasme & B\u00e9guinage","address_street_name":"Rue de Formanoir","address_street_number":"31","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de Formanoir, 31","address_line2":"1070 Anderlecht","description_web":"","description_print":"21\/09\/2022\r\nLa Casa di Erasmo deve il suo nome e la sua fama ad Erasmo da Rotterdam, che vi soggiorn\u00f2 nel 1521. Divenuta un museo dedicato al grande umanista rinascimentale, \u00e8 luogo di esposizione di una collezione unica composta da opere d'arte - sculture e dipinti di maestri fiamminghi -, mobili e libri antichi, molti dei quali scritti dallo stesso Erasmo. Se la Casa di Erasmo \u00e8 una delle pi\u00f9 antiche di Bruxelles - costruita in tre fasi nel corso dei secoli XV e XVI -, nel 1932 \u00e8 stata oggetto di un restauro completo voluto, nello spirito del pi\u00f9 puro storicismo, da Daniel Van Damme, fondatore del museo, con l'aiuto dell'architetto Charles Van Elst, che costru\u00ec anche la casa di Maurice Car\u00eame.  Gli spazi interni sono stati poi riconvertiti in sale del museo. Queste sono state decorate (una stanza con le pareti completamente rivestite di sontuose pelli di Cordoba) ed arredate con mobili provenienti dall'antica collezione del Ministro Vandenpeereboom. Gli interni sono quindi ricostruzioni con lo scopo di dare ai visitatori un'idea di quello che poteva essere una residenza rinascimentale. Le ricostruzioni sono in parte basate su documenti storici (lo studio di Erasmo che d\u00e0 sul giardino) ed in parte su ritrovamenti archeologici quali lo splendido fregio affrescato del primo piano. Nella parte posteriore della casa, un ampio giardino ombreggiato da grandi alberi conserva alcuni resti archeologici dell'antico castello di Anderlecht, poeticamente abbinati a diverse installazioni di artisti contemporanei. ","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Mus\u00e9es Maison d\u2019\u00c9rasme & B\u00e9guinage","address_street_name":"Rue de Formanoir","address_street_number":"31","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de Formanoir, 31","address_line2":"1070 Anderlecht","description_web":"","description_print":"21\/09\/2022\r\nLa Casa de Erasmo debe su nombre y prestigio a la temporada que pas\u00f3 en ella Erasmo de R\u00f3terdam en 1521. Convertida en un museo dedicado a este gran humanista del Renacimiento, es el envoltorio de una colecci\u00f3n \u00fanica compuesta por obras de arte (esculturas y pinturas de maestros flamencos), muebles y libros antiguos, entre ellos numerosas ediciones erasmianas. Si la Casa de Erasmo es una de las m\u00e1s antiguas de Bruselas (construida en tres fases a lo largo de los siglos XV y XVI), a partir de 1932 fue objeto de una restauraci\u00f3n completa llevada a cabo, en el m\u00e1s puro historicismo, por Daniel Van Damme, fundador del museo, con la ayuda del arquitecto Charles Van Elst, que tambi\u00e9n construy\u00f3 la casa de Maurice Car\u00eame. Los espacios interiores se reorganizaron entonces en salas de museo que fueron decoradas (entre ellas, una sala con las paredes totalmente cubiertas por suntuosas pieles de C\u00f3rdoba) y amuebladas con mobiliario procedente de la antigua colecci\u00f3n del ministro Vandenpeereboom. El interior es, por tanto, una reproducci\u00f3n cuyo fin es dar a los visitantes la idea de lo que podr\u00eda haber sido una residencia en el Renacimiento, basada en parte en documentos hist\u00f3ricos (despacho de Erasmo frente al jard\u00edn) y en hallazgos arqueol\u00f3gicos como el maravilloso friso pintado al fresco del primer piso. Detr\u00e1s de la casa, un vasto jard\u00edn con grandes \u00e1rboles que le dan sombra conserva algunos restos arqueol\u00f3gicos del antiguo castillo de Anderlecht, los cuales se encuentran, po\u00e9ticamente, cerca de varias instalaciones de artistas contempor\u00e1neos. ","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Mus\u00e9es Maison d\u2019\u00c9rasme & B\u00e9guinage","address_street_name":"Rue de Formanoir","address_street_number":"31","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de Formanoir, 31","address_line2":"1070 Anderlecht","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Mus\u00e9es Maison d\u2019\u00c9rasme & B\u00e9guinage","address_street_name":"Rue de Formanoir","address_street_number":"31","address_street_box":null,"email":"info@erasmushouse.museum","website":"http:\/\/www.erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de Formanoir, 31","address_line2":"1070 Anderlecht","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":null,"facebook_id":null,"backoffice_id":327,"location":{"lat":50.83592263,"lon":4.3077579},"region":"brussels","last_updated_at":"2023-02-10T17:36:28+01:00","published_at":"2013-10-19T01:13:26+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"media":[{"type":"poster","link":"https:\/\/agendabrussels.imgix.net\/75c473564a6ff4e9cdcb5559096d64c8a796813e.jpg","width":945,"height":1181,"ratio":0.8,"translations":{"fr":{"title":"Visiter le b\u00e9guinage d'Anderlecht restaur\u00e9","copyright":null},"nl":{"title":"Visiter le b\u00e9guinage d'Anderlecht restaur\u00e9","copyright":nu