_event"]},{"id":5700003579,"date_start":"2024-11-16","date_end":"2024-11-24","date_next":"2024-11-23","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-11-18T15:37:57+01:00","published_at":"2024-11-12T20:21:47+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":311391,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"other","ranking":0.4807498567691361,"languages":{"spoken":["en","nl","fr"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[40,36],"translations":{"de":["Grafische K\u00fcnste","Museen & Kunstzentren"],"pt":[null,null],"en":["Graphic art","Museums and art centers"],"it":["Arti grafiche","Musei e centri artistici"],"cn":[null,null],"fr":["Arts graphiques","Mus\u00e9es et art centers"],"sp":["Artes gr\u00e1ficas","Museos y centros de arte"],"nl":["Grafische kunst, vormgeving","Musea en kunstcentra"]}}},"translations":{"de":{"name":"Not Comic","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/vroomspace.com\/not-comic","email":"info@vroomspace.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700003579"},"pt":{"name":"Not Comic","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/vroomspace.com\/not-comic","email":"info@vroomspace.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700003579"},"en":{"name":"Not Comic","shortdescr":"In Not Comic, Harrisson fills up the exhibition space with enlarged reproductions of the different pages that form the publication also entitled \"Not Comic\". \n","longdescr":"1 - Comic project\n\nNot Comic is a multi-layered, multi-track project revolving around the idea of the comic strip.\n\nThis comic is made with drawings that are not intended to be drawings for a comic.\nThis comic is built on a mathematical typographic grid.\nThis comic is based on Jack Kirby's comic-book panel system.\nEach page of this comic is a poster.\nThis comic is a specimen of a new typeface called Not Comic.\n\n2 - The font project\n\nThe Not Comic font is\n\na free, open-source font\na serious version of Comic Sans MS\nan alternative to Comic Sans MS\na font with inclusive glyphs\na collective font\na font that you can copy, modify, distribute, share, reproduce, communicate, reuse and adapt.\na font with multiple outputs to suit your needs.\n\nThe Not Comic font was created, designed, encoded and used by Harrisson, Olivier Bertrand, Louis Garrido, Roxanne Maillet, Enora Donniou and the Bye-Bye-Binary collective.\n\n\nAbout Harrisson:\nA product of the counter-cultures of sound and image, from a time when the digitalo-artistic graphic designer was not yet the proletarian of the future, graphic designer and typographer Harrisson is the sum total of over 20 years of visual experiments designed to give meaning to the world and to lives. An idealist who primarily fights the dark orders and lights of domination through images, his practice essentially seeks fulfillment through the magical play of signs and their teaching. He's an excellent channeler of ideas into images, a bodybuilder of the Swiss-style magnetic typographic grid, a long-distance poster runner and an obsessive illustration producer, as if his life depended on it.\n\n\n\n\n","performers":null,"boxoffice_url":null,"website":"https:\/\/vroomspace.com\/not-comic","email":"info@vroomspace.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700003579"},"it":{"name":"Not Comic","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/vroomspace.com\/not-comic","email":"info@vroomspace.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700003579"},"cn":{"name":"Not Comic","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/vroomspace.com\/not-comic","email":"info@vroomspace.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700003579"},"fr":{"name":"Not Comic","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/vroomspace.com\/not-comic","email":"info@vroomspace.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700003579"},"sp":{"name":"Not Comic","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/vroomspace.com\/not-comic","email":"info@vroomspace.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700003579"},"nl":{"name":"Not Comic","shortdescr":null,"longdescr":null,"performers":"Harisson","boxoffice_url":null,"website":"https:\/\/vroomspace.com\/not-comic","email":"info@vroomspace.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700003579"}},"place":{"id":280313,"translations":{"de":{"name":"VROOM","address_street_name":"Dokter De Meersmanstraat 19","address_street_number":"19","address_street_box":null,"email":"vroooom.space@gmail.com","website":"https:\/\/www.instagram.com\/vroom.space\/","phone_contact":null,"phone