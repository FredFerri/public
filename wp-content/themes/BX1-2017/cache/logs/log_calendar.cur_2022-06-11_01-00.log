ress_line2":"1050 Elsene","description_web":"KULT XL Ateliers, gelegen in de Leopoldwijk vlakbij het Europees Parlement, is een nieuw complex gewijd aan hedendaagse beeldende kunst in Elsene. KULT XL Ateliers bestaat uit een tentoonstellingshal en zeven kunstenaarsateliers.\r\nEr zullen tentoonstellingen van kunstenaars in residentie of van andere lokale kunstenaars worden georganiseerd, alsook activiteiten voor alle doelgroepen rond beeldende kunst.","description_print":"KULT XL Ateliers, gelegen in de Leopoldwijk vlakbij het Europees Parlement, is een nieuw complex gewijd aan hedendaagse beeldende kunst in Elsene. KULT XL Ateliers bestaat uit een tentoonstellingshal en zeven kunstenaarsateliers.\r\nEr zullen tentoonstellingen van kunstenaars in residentie of van andere lokale kunstenaars worden georganiseerd, alsook activiteiten voor alle doelgroepen rond beeldende kunst.\r\n\r\nVolg de actualiteit op Instagram @KULT.XL.ATELIERS en op Facebook www.facebook.om\/kultxlateliers","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"KULT XL Ateliers","address_street_name":"Rue Wiertz","address_street_number":"23","address_street_box":null,"email":"culture@ixelles.brussels","website":"https:\/\/culture.ixelles.be\/en\/kult-xl-ateliers\/","phone_contact":"+32 2 515 63 64","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Wiertz, 23","address_line2":"1050 Ixelles","description_web":"Located in the Leopold quarter near the European Parliament, KULT XL Ateliers is a new complex dedicated to contemporary visual arts in Ixelles, composed of an exhibition hall and seven artists' studios.\r\nExhibitions of artists in residence or other local artists will be organised there, as well as activities for all audiences around visual arts.","description_print":"Located in the Leopold quarter near the European Parliament, KULT XL Ateliers is a new complex dedicated to contemporary visual arts in Ixelles, composed of an exhibition hall and seven artists' studios.\r\nExhibitions of artists in residence or other local artists will be organised there, as well as activities for all audiences around visual arts.\r\n\r\nFollow the news on Instagram @KULT.XL.ATELIERS and on Facebook www.facebook.com\/kultxlateliers","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"KULT XL Ateliers","address_street_name":"Rue Wiertz","address_street_number":"23","address_street_box":null,"email":"culture@ixelles.brussels","website":"https:\/\/culture.ixelles.be\/fr\/kult-xl-ateliers\/","phone_contact":"+32 2 515 63 64","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Wiertz, 23","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"KULT XL Ateliers","address_street_name":"Rue Wiertz","address_street_number":"23","address_street_box":null,"email":"culture@ixelles.brussels","website":"https:\/\/culture.ixelles.be\/fr\/kult-xl-ateliers\/","phone_contact":"+32 2 515 63 64","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Wiertz, 23","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"KULT XL Ateliers","address_street_name":"Rue Wiertz","address_street_number":"23","address_street_box":null,"email":"culture@ixelles.brussels","website":"https:\/\/culture.ixelles.be\/fr\/kult-xl-ateliers\/","phone_contact":"+32 2 515 63 64","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Wiertz, 23","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"KULT XL Ateliers","address_street_name":"Rue Wiertz","address_street_number":"23","address_street_box":null,"email":"culture@ixelles.brussels","website":"https:\/\/culture