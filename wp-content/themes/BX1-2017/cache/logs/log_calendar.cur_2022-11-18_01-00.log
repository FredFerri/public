-11-27","date_next":"2022-11-17","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung"}},"others":{"list":[36,46],"translations":{"fr":["Mus\u00e9es et art centers","Pluridisciplinaire"],"nl":["Musea en kunstcentra","Multidisciplinair"],"en":["Museums and art centers","Multidisciplinary"],"de":["Museen & Kunstzentren","Multidisziplin\u00e4r"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"11 Years of Residencies. Fondation Carrefour des Arts","shortdescr":"Depuis 2011, la Fondation Carrefour des Arts accueille de jeunes artistes en r\u00e9sidence. Aujourd\u2019hui, elle pr\u00e9sente le travail de 36 d\u2019entre eux. Aux univers vari\u00e9s, iels rendent compte de la cr\u00e9ativit\u00e9 d\u00e9bordante de la jeune cr\u00e9ation en Belgique. La nature, l\u2019environnement, l\u2019avenir, le rapport \u00e0 l\u2019espace, au corps, sont autant de th\u00e8mes qui inspirent les artistes d\u2019aujourd\u2019hui.","longdescr":"Depuis 2011, la Fondation Carrefour des Arts accueille de jeunes artistes en r\u00e9sidence rue du Canal \u00e0 Bruxelles. Aujourd\u2019hui, elle est heureuse de pr\u00e9senter le travail de 36 artistes parmi les 49 \u00e0 qui elle a apport\u00e9 son soutien depuis 11 ans. Les \u0153uvres expos\u00e9es sont issues de la collection acquise au fil des ann\u00e9es par la Fondation aupr\u00e8s des artistes au moment de leur r\u00e9sidence, accompagn\u00e9es de pi\u00e8ces plus r\u00e9centes t\u00e9moignant de l\u2019\u00e9volution de leurs parcours artistiques depuis lors. Aux univers tr\u00e8s diff\u00e9rents et aux m\u00e9diums tout aussi vari\u00e9s, les \u0153uvres de ces artistes rendent compte de la cr\u00e9ativit\u00e9 d\u00e9bordante de la jeune cr\u00e9ation en Belgique. La nature, l\u2019environnement, l\u2019humain, l\u2019avenir de nos soci\u00e9t\u00e9s, le rapport \u00e0 l\u2019espace, au corps, \u00e0 l\u2019autre\u2026 sont autant de th\u00e8mes aux orientations infinies qui inspirent les artistes d\u2019aujourd\u2019hui et auxquels iels donnent de passionnantes interpr\u00e9tations.","performers":"Artistes expos\u00e9s : Becher, Belooussovitch, Bruaux, Capony, Cariba\u00ef, Cazalic, Chenut, Darcel, Delaville, Dufour, Dumortier, Fau, Favero-Longo, Freitas, G\u00e9rard, Guti\u00e9rrez Mu\u00f1oz, Pion, Leens, Leffler, Lerch, Lequin, Likin, Mennesson, Marciano, Maurcot, Mayer, Pastry, Peroi, Poisson, Roux, Sallustro, Sellenet, Tom\u00e0s, Van de Velde, Wen, Wery","boxoffice_url":null,"website":"http:\/\/www.carrefourdesarts.be\/","email":"info@carrefourdesarts.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.544711"},"nl":{"name":"11 Years of Residencies. Fondation Carrefour des Arts","shortdescr":"Sinds 2011 ontvangt de Stichting Carrefour des Arts jonge kunstenaars in residentie. Vandaag presenteert zij het werk van 36 kunstenaars. De gevarieerde werken  weerspiegelen de tomeloze creativiteit van jonge kunstenaars in Belgi\u00eb. De natuur, het milieu, de toekomst, de verhouding tot de ruimte, tot het lichaam, zijn allemaal onuitputtelijke thema's die de kunstenaars van vandaag inspireren.","longdescr":"Sinds 2011 ontvangt de Stichting Carrefour des Arts in de Vaartstraat in Brussel jonge kunstenaars in residentie. Vandaag presenteert zij met genoegen het werk van 36 van de 49 kunstenaars die zij de afgelopen 11 jaar heeft gesteund. De tentoongestelde werken zijn afkomstig uit de collectie die de stichting in de loop der jaren van de kunstenaars tijdens hun residentie heeft verworven, samen met meer recente stukken die getuigen van de ontwikkeling van hun artistieke parcours sindsdien. De werken van deze kunstenaars, met hun zeer uiteenlopende universums en even gevarieerde media, weerspiegelen de tomeloze creativiteit van jonge kunstenaars in Belgi\u00eb. De natuur, het milieu, de mens, de toekomst van onze samenlevingen, de verhouding tot de ruimte, tot het lichaam, tot de ander... zijn allemaal onuitputtelijke thema's die de kunstenaars van vandaag inspireren tot fascinerende interpretaties.","performers":"Tentoongestelde kunstenaars : Becher, Belooussovitch, Bruaux, Capony, Cariba\u00ef, Cazalic, Chenut, Darcel, Delaville, Dufour, Dumortier, Fau, Favero-Longo, Freitas, G\u00e9rard, Guti\u00e9rrez Mu\u00f1oz, Pion, Leens, Leffler, Lerch, Lequin, Likin, Mennesson, Marciano, Maurcot, Mayer, Pastry, Peroi, Poisson, Roux, Sallustro, Sellenet, Tom\u00e0s, Van de Velde, Wen, Wery","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.544711"},"en":{"name":"11 Years of Residencies. Fondation Carrefour des Arts","shortdescr":"Since 2011, the Carrefour des Arts Foundation has been hosting young artists in residence. Today, it presents the work of 36 artists of them. With diverse themes, the exhibition reflects the abundant creativity of young talent in Belgium. Nature, the environment, the future, the relationship to space, to the body, are all themes that have inspired today's artists.","longdescr":"Since 2011, the Carrefour des Arts Foundation has been hosting young artists in residence on rue du Canal in Brussels. Today, it is pleased to present the work of 36 artists from the 49 it has supported over the past 11 years. The exhibition includes work acquired by the Foundation over the years, from the artists at the time of their residency alongside more recent pieces as testament to their evolving careers. With diverse themes and equally varied mediums, the exhibition reflects the abundant creativity of young talent in Belgium. Nature, the environment, human beings, the future of our societies, the relationship to space, to the body and to each other... are all themes with infinite orientations that have inspired today's artists and to which they give fascinating interpretations.","performers":"Exhibited artists : Becher, Belooussovitch, Bruaux, Capony, Cariba\u00ef, Cazalic, Chenut, Darcel, Delaville, Dufour, Dumortier, Fau, Favero-Longo, Freitas, G\u00e9rard, Guti\u00e9rrez Mu\u00f1oz, Pion, Leens, Leffler, Lerch, Lequin, Likin, Mennesson, Marciano, Maurcot, Mayer, Pastry, Peroi, Poisson, Roux, Sallustro, Sellenet, Tom\u00e0s, Van de Velde, Wen, Wery","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.544711"},"de":{"name":"11 Years of Residencies. Fondation Carrefour des Arts","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.544711"},"it":{"name":"11 Years of Residencies. Fondation Carrefour des Arts","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.544711"},"sp":{"name":"11 Years of Residencies. Fondation Carrefour des Arts","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.544711"},"pt":{"name":"11 Years of Residencies. Fondation Carrefour des Arts","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.544711"},"cn":{"name":"11 Years of Residencies. Fondation Carrefour des Arts","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.544711"}},"place":{"id":251380,"translations":{"fr":{"name":"Espace Vanderborght","address_street_name":"Rue de l'Ecuyer","address_street_number":"50","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de l'Ecuyer, 50","address_line2":"1000 Bruxelles","description_web":"Propri\u00e9t\u00e9 de la Ville de Bruxelles, cet \u00e9difice \u00e0 la large vitrine se dresse en plein centre de Bruxelles, \u00e0 deux pas des c\u00e9l\u00e8bres Galeries royales Saint-Hubert et \u00e0 peine plus loin de la Grand-Place. Il occupe un espace impressionnant de 6 000 m\u00e8tres carr\u00e9s de surface utile, r\u00e9partis sur 5 \u00e9tages.\r\n\r\nConstruit au profit des \u00ab Nouveaux \u00c9tablissements Vanderborght Fr\u00e8res \u00bb, n\u00e9goce en mobilier (tapis, bibelots, mobilier de jardin, literie, etc.), l\u2019\u00e9difice est con\u00e7u par un tandem habitu\u00e9 \u00e0 travailler ensemble : les architectes Govaerts et Van Vaerenbergh, auteurs \u00e9galement de la maison d\u2019Alice et David van Buren \u2014 actuel mus\u00e9e van Buuren. Le chantier, entam\u00e9 en 1932, prend fin en 1935. De style moderniste, la conception de l\u2019immeuble est d\u00e9nu\u00e9e de tout ornement et privil\u00e9gie la fonction.\r\n\r\nRemarquable par ses larges vitrines permettant une grande visibilit\u00e9, chaque \u00e9tage est constitu\u00e9 d\u2019un grand un plateau de b\u00e9ton modulable, gr\u00e2ce \u00e0 un syst\u00e8me de cloisons coulissantes sur rail. Le b\u00e2timent se distingue encore par ses terrasses, lieu d\u2019exposition des meubles de jardin mais aussi de d\u00e9tente \u2014 on peut y prendre un th\u00e9 \u00e0 l\u2019\u00e9poque ! Le magasin tombe en faillite en 1980.\r\n\r\nLes Mus\u00e9es Royaux des Beaux-Arts ont envisag\u00e9 d\u2019y transf\u00e9rer leurs collections d\u2019art moderne et contemporain, mais le projet restera sans suite.\r\n\r\nLe lieu abrite aujourd\u2019hui de nombreuses expositions, principalement centr\u00e9es sur l\u2019art contemporain. Trois grands rendez-vous sont ainsi programm\u00e9s chaque ann\u00e9e :\r\n-\tCarte de Visite ARTopenKUNST en f\u00e9vrier, une expo d\u00e9di\u00e9e aux artistes amateurs et professionnels qui habitent ou travaillent sur la Ville de Bruxelles. Plus de 200 artistes envahissent tout le b\u00e2timent pendant un weekend. http:\/\/cartedevisite.brussels\/ \r\n-\tThe Independent en avril, une foire d\u2019art contemporain newyorkaise qui a pos\u00e9 ses valises \u00e0 Bruxelles. http:\/\/independenthq.com\/\r\n-\tStrokar en mai, une exposition d\u00e9di\u00e9e au Street Art et \u00e0 la photographie qui rassemble des artistes bruxellois et internationaux. http:\/\/strokar.be\/ \r\n\r\nPar ailleurs d\u2019autres expositions non r\u00e9currentes y trouvent place, ouvertes au plus grand nombre et proposant un prix tr\u00e8s accessible.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Vanderborghtgebouw","address_street_name":"Schildknaapsstraat","address_street_number":"50","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Schildknaapsstraat, 50","address_line2":"1000 Brussel","description_web":"Dit gebouw, dat eigendom is van de stad Brussel, ligt in het hartje van Brussel, op een steenworp van de beroemde Koninklijke Sint-Hubertusgalerijen en de Grote Markt. Het neemt een indrukwekkende 6.000 vierkante meter vloeroppervlak in beslag, verdeeld over 5 verdiepingen.\r\n\r\nIndertijd gebouwd voor een meubelhandelaar (tapijten, snuisterijen, tuinmeubelen, beddengoed, enz.), \"Nouveaux \u00c9tablissements Vanderborght Fr\u00e8res\", werd het gebouw ontworpen door een team dat gewend was om samen te werken: architecten Govaerts en Van Vaerenbergh, de ontwerpers van het huis van Alice en David van Buren - nu het van Buuren Museum. De bouwwerkzaamheden, die in 1932 begonnen, eindigden in 1935. Eigen aan de modernistische stijl is het ontwerp van het gebouw verstoken van ornamenten en benadrukt het de functie.\r\n\r\nElke verdieping bestaat uit een groot modulair betonnen plateau, dankzij een systeem van verschuifbare scheidingswanden op rails, met opmerkelijk grote ramen die een hoge zichtbaarheid mogelijk maken. Het gebouw kenmerkt zich ook nog door zijn terrassen, de plek waar het tuinmeubilair werd tentoongesteld en waar men ook kon ontspannen (indertijd kon je daar thee drinken). De winkel ging in 1980 failliet.\r\n\r\nDe Koninklijke Musea voor Schone Kunsten hebben overwogen om hun collecties moderne en hedendaagse kunst hierheen over te brengen, maar het project werd niet voortgezet.\r\n\r\nVandaag de dag worden er vele tentoonstellingen georganiseerd, voornamelijk gericht op hedendaagse kunst. Elk jaar staan er drie grote evenementen op het programma:\r\n- ARTopenKUNST in februari, een tentoonstelling gewijd aan amateur- en professionele kunstenaars die in de stad Brussel wonen of werken. Meer dan 200 kunstenaars vallen een weekend lang het hele gebouw binnen. http:\/\/cartedevisite.brussels\/ \r\n- The Independent in april, een New Yorkse beurs voor hedendaagse kunst die zich in Brussel heeft gevestigd. http:\/\/independenthq.com\/\r\n- Strokar in mei, een tentoonstelling gewijd aan Street Art en fotografie die Brussel en internationale kunstenaars samenbrengt. http:\/\/strokar.be\/ \r\n\r\nDaarnaast herbergt het gebouw nog vele andere, niet-wederkerende tentoonstellingen, die openstaan voor het grote publiek aan een zeer toegankelijke prijs.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Espace Vanderborght","address_street_name":"Rue de l'Ecuyer","address_street_number":"50","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue de l'Ecuyer, 50","address_line2":"1000 Brussels","description_web":"Owned by the City of Brussels, this building with a large shop window stands in the centre of Brussels, only a stone\u2019s throw from the Grand Place. It occupies an impressive 6,000 m\u00b2 of space spread over 5 stories.\r\n\r\nBuilt for the \u201cNouveaux \u00c9tablissements Vanderborght Fr\u00e8res\u201d, who traded in household products like carpets, knick-knacks, garden furniture, bedding, etc., the building was designed by architects Govaerts and Van Vaerenbergh, who were used to working together, having previously collaborated on the house of Alice and David van Buren, now the van Buren Museum. The building works, which began in 1932, were completed in 1935. Built in a modernist style, the building did away with ornamental elements, favouring function over appearance.\r\n\r\nWith remarkable large shop front windows that allow for greater visibility, each story is made up of one large concrete floorplan that can be easily modified thanks to a system of sliding partition walls on tracks. Other stand-out features of this building are its terraces, which served as exhibition spaces for the company\u2019s garden furniture back in the day, but also spots to relax and enjoy a cup of tea. The store went bankrupt in 1980.\r\n\r\nThe Royal Fine Arts Museums of Belgium once thought of moving their collections into the Vanderborght building, but the project never took off.\r\n\r\nThe venue today welcomes many exhibitions, mainly centred around contemporary art. Three major events are organised every year:\r\n-\tCarte de Visite ARTopenKUNST in February: an exhibition dedicated to amateur and professional artists living or working in the City of Brussels. More than 200 artists take over the building for a whole weekend. http:\/\/cartedevisite.brussels\/ \r\n-\tThe Independent in April: a contemporary art fair from New Year has set up shop in Brussels. http:\/\/independenthq.com\/\r\n-\tStrokar in May: an exhibition dedicated to street art and photography that gathers artists from Brussels and further afield. http:\/\/strokar.be\/ \r\n\r\nFurthermore, other, non-recurrent exhibitions also take place in the Vanderborght building and are open to all at a reasonable price.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Espace Vanderborght","address_street_name":"Rue de l'Ecuyer","address_street_number":"50","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de l'Ecuyer, 50","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Espace Vanderborght","address_street_name":"Rue de l'Ecuyer","address_street_number":"50","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de l'Ecuyer, 50","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Espace Vanderborght","address_street_name":"Rue de l'Ecuyer","address_street_number":"50","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de l'Ecuyer, 50","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Espace Vanderborght","address_street_name":"Rue de l'Ecuyer","address_street_number":"50","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de l'Ecuyer, 50","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Espace Vanderborght","address_street_name":"Rue de l'Ecuyer","address_street_number":"50","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de l'Ecuyer, 50","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":[],"zones":{"list":[19],"translations":{"fr":["Centre"],"nl":["Centrum"],"en":["Centre"]}},"neca":null,"facebook_id":null,"backoffice_id":13469,"location":{"lat":50.84878981,"lon":4.35576881},"region":"brussels","last_updated_at":"2022-11-17T02:06:35+01:00","published_at":"2013-10-19T01:37:09+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":252475,"translations":{"fr":{"name":"Fondation du Carrefour des Arts","address_street_name":"rue du Canal","address_street_number":"79","address_street_box":null,"email":null,"website":"http:\/\/www.carrefourdesarts.be\/","phone_contact":"+32 473 61 52 56","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"rue du Canal, 79","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Fondation du Carrefour des Arts","address_street_name":"Vaartstraat","address_street_number":"79","address_street_box":null,"email":null,"website":"http:\/\/www.carrefourdesarts.be\/","phone_contact":"+32 473 61 52 56","phone_bo