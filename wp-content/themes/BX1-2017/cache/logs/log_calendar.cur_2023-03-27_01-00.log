":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater","it":"Teatro","sp":"Teatro","pt":null,"cn":null}},"others":{"list":[52],"translations":{"fr":["Th\u00e9\u00e2tre musical"],"nl":["Muziektheater"],"en":["Musical theatre"],"de":["Musiktheater"],"it":["Teatro musicale"],"sp":["Teatro musical"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":["nl"]},"translations":{"fr":{"name":"Lecture-spectacle musicale Une ascension, de Stefan Hertmans","shortdescr":"Lecture-spectacle en musique \u00e0 la Maison Autrique du roman Une ascension","longdescr":"Stefan Hertmans sera pr\u00e9sent le 27 mars \u00e0 la lecture-spectacle musicale de son dernier roman, Une ascension (De opgang publi\u00e9 chez De Bezige Bij), \u00e0 la Maison Autrique.\r\n\r\nLa soir\u00e9e Port\u00e9es-Portraits d\u00e9butera par une rencontre avec l\u2019auteur \u00e0 19h, l\u2019occasion d'un moment de partage entre le public et Stefan Hertmans, qui introduira son roman et abordera son travail d\u2019\u00e9crivain. La lecture-spectacle bilingue d\u00e9butera \u00e0 20h15 et sera surtitr\u00e9e en n\u00e9erlandais et en fran\u00e7ais.\r\n\r\nLe texte est mis en voix par Genevi\u00e8ve Damas, lu par Youri Dirkx et accompagn\u00e9 au violon par Catherine Graindorge.\r\n\r\n\r\n\r\nAlors que Stefan Hertmans vend sa maison de Gand, para\u00eet le livre d\u2019un de ses anciens professeurs d\u2019universit\u00e9, qui r\u00e9v\u00e8le qu\u2019enfant, il a v\u00e9cu dans cette maison, et que son p\u00e8re \u00e9tait un mauvais Flamand, un collaborateur nazi. Hertmans connaissait ce fait troublant mais n\u2019avait jamais fait de recherches plus approfondies. Et c\u2019est le moment de le faire.\r\n\r\n\r\nVerre offert par la Compagnie Albertine \u00e0 la fin de la lecture, histoire de trinquer ensemble ! L'occasion de faire d\u00e9dicacer son livre par l'auteur.\r\n\r\n\r\n\r\nMaison Autrique, Chauss\u00e9e de Haecht 266, 1030 Schaerbeek\r\n reservations.compagniealbertine@gmail.com\r\nPrix : 8 euros \/ 5 euros (\u00e9tudiant.e.s)\r\n\r\n\r\n\r\nMaisons d'\u00e9ditions : De Bezige Bij (version originale n\u00e9erlandaise) et Gallimard (traduction fran\u00e7aise d'Isabelle Rosselin)","performers":"Mise en voix Genevi\u00e8ve Damas\r\nLecture, Youri Dirkx\r\nViolon, Catherine Graindorge","boxoffice_url":null,"website":"https:\/\/www.compagniealbertine.be\/portraits\/une-ascension\/","email":"reservations.compagniealbertine@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.551673"},"nl":{"name":"Lecture-spectacle musicale Une ascension, de Stefan Hertmans","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.compagniealbertine.be\/portraits\/une-ascension\/","email":"reservations.compagniealbertine@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.551673"},"en":{"name":"Lecture-spectacle musicale Une ascension, de Stefan Hertmans","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.compagniealbertine.be\/portraits\/une-ascension\/","email":"reservations.compagniealbertine@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.551673"},"de":{"name":"Lecture-spectacle musicale Une ascension, de Stefan Hertmans","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.compagniealbertine.be\/portraits\/une-ascension\/","email":"reservations.compagniealbertine@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.551673"},"it":{"name":"Lecture-spectacle musicale Une ascension, de Stefan Hertmans","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.compagniealbertine.be\/portraits\/une-ascension\/","email":"reservations.compagniealbertine@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.551673"},"sp":{"name":"Lecture-spectacle musicale Une ascension, de Stefan Hertmans","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.compagniealbertine.be\/portraits\/une-ascension\/","email":"reservations.compagniealbertine@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.551673"},"pt":{"name":"Lecture-spectacle musicale Une ascension, de Stefan Hertmans","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.compagniealbertine.be\/portraits\/une-ascension\/","email":"reservations.compagniealbertine@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.551673"},"cn":{"name":"Lecture-spectacle musicale Une ascension, de Stefan Hertmans","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.compagniealbertine.be\/portraits\/une-ascension\/","email":"reservations.compagniealbertine@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.551673"}},"place":{"id":241931,"translations":{"fr":{"name":"Maison Autrique","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"https:\/\/www.facebook.com\/maisonautrique\/","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":"La Maison Autrique (Horta 1893) est un jalon important de l'Art Nouveau. Elle a fait l'objet d'une restauration exemplaire. Ouverte au public, elle permet \u00e0 chacun de mieux saisir l'int\u00e9r\u00eat historique et esth\u00e9tique des vieilles demeures bruxelloises. Lors de votre visite, vous d\u00e9couvrirez des espaces d'exposition, une petite librairie th\u00e9matique et une sc\u00e9nographie originale sign\u00e9e Beno\u00eet Peeters et Fran\u00e7ois Schuiten. La maison accueille des petits concerts, des expositions temporaires et des ateliers pour enfants. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Autrique Huis","address_street_name":"Haachtsesteenweg","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"https:\/\/www.facebook.com\/maisonautrique\/","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaarbeek","address_line1":"Haachtsesteenweg, 266","address_line2":"1030 Schaarbeek","description_web":"Het Autrique Huis is het eerste markante gebouw van Victor Horta. Het werd in 1893 gebouwd en is nog steeds een voornaam element in het architectonisch patrimonium van Brussel. Het huis werd op uitmuntende wijze gerestaureerd en is open voor het publiek. Het huis is een belangrijke maatstaf van de Art Nouveau : men vindt er reeds elementen terug die de architect en zijn zoektocht kenmerken. De manier waarop de ruimte ingedeeld is, staat garant voor verrassingen : Fran\u00e7ois Schuiten en Beno\u00eet Peeters hebben een originele enscenering opgezet, waarbij het huis van de kelder tot de zolder ingericht werd. Zodoende wordt het huis een soort van eerbetoon aan de Brusselse priv\u00e9-architectuur, terwijl het ook de verbeelding aanspreekt. Het huis organiseert intieme concerten, tentoonstellingen en workshops voor kinderen.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Autrique House","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"https:\/\/www.facebook.com\/maisonautrique\/","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":"Maison Autrique is the very first striking building Victor Horta designed. It was built in 1893 and it's a major part of Brussels' architectural patrimonium. It underwent an exemplary restoration and is now open to the public. This house is an important Art Nouveau touchstone: we can already see elements that form a part of the continual explorations of the architect. It's interior division is full of surprises: Fran\u00e7ois Schuiten and Beno\u00eet Peeters have staged an original scenography, from the cellar to the attic. The house has thus become a sort of tribute to Brussels' private architecture, while at the same time tickling the imagination. The house hosts intimate concerts, temporary exhibitions and workshops for children.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Maison Autrique","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"https:\/\/www.facebook.com\/maisonautrique\/","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":"Als erstes bedeutendes Bauwerk des Jugendstil-Architekten Victor Horta bildet das Maison Autrique ein wichtiges Element des Br\u00fcsseler Architekturerbes.\r\n\r\nEin Meilenstein der Br\u00fcsseler Architekturgeschichte: Denn das Geb\u00e4ude aus dem Jahr 1893 stellt eine wesentliche Etappe in der Entwicklung der gr\u00f6\u00dften belgischen Architekten dar. Durch das Geb\u00e4ude f\u00fchrt eine Szenographie, die von den beiden belgischen Comic-Gr\u00f6\u00dfen Fran\u00e7ois Schuiten und Beno\u00eet Peeter konzipiert wurde. Zugrundeliegende Idee war es, aus diesem Geb\u00e4ude eine Art \"Haus der H\u00e4user\" zu machen, eine Huldigung an die Br\u00fcsseler Architektur und zugleich ein Tor zum Imagin\u00e4ren.\r\n\r\nDas Maison Autrique bietet regelm\u00e4\u00dfig Ausstellungen rund um verschiedene Themen: das 19. Jahrhundert in Br\u00fcssel, Comic oder Jugenstil. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Maison Autrique","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"http:\/\/www.autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Casa Autrique","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"http:\/\/www.autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":"La casa Autrique, obra fundacional de Victor Horta, ha sido completamente renovada, con una puesta en escena imaginaria realizada por los guionistas y dibujantes Schuiten y Peeters. Al entrar, te sumerges en una atm\u00f3sfera \u00fanica.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Maison Autrique","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"http:\/\/www.autrique.be","phone_contact":"+32 2 215 66 00","phone_