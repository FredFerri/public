ontact":"+32 2 548 25 80","phone_booking":"+32 2 548 25 80","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Riches Claires, 24","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"fr":{"name":"Les Riches-Claires","address_street_name":"Rue des Riches Claires","address_street_number":"24","address_street_box":null,"email":"accueil@lesrichesclaires.be","website":"http:\/\/www.lesrichesclaires.be","phone_contact":"+32 2 548 25 80","phone_booking":"+32 2 548 25 80","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Riches Claires, 24","address_line2":"1000 Bruxelles","description_web":"Le centre culturel Les Riches-Claires est ouvert \u00e0 toutes les disciplines des arts de la sc\u00e8ne, situ\u00e9 \u00e0 deux pas de la Place Saint-G\u00e9ry et de la Bourse. Le lieu se d\u00e9finit comme une rampe de lancement pour les jeunes artistes tout en permettant aux compagnies confirm\u00e9es de tenter de nouvelles exp\u00e9riences. Par sa programmation, originale et accessible, les Riches-Claires cherchent \u00e0 perp\u00e9tuer sa tradition de sc\u00e8ne th\u00e9\u00e2trale privil\u00e9giant l'humour, tout en offrant un espace d\u2019expression \u00e0 la danse contemporaine, la musique et le cin\u00e9ma.\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Les Riches-Claires","address_street_name":"Rue des Riches Claires","address_street_number":"24","address_street_box":null,"email":"accueil@lesrichesclaires.be","website":"http:\/\/www.lesrichesclaires.be","phone_contact":"+32 2 548 25 80","phone_booking":"+32 2 548 25 80","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Riches Claires, 24","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Les Riches-Claires","ad