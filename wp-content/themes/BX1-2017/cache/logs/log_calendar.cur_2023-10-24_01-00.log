ame":"Joyeux anniversaire quand m\u00eame","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Joyeux-anniversaire-quand-meme","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50000194"},"en":{"name":"Joyeux anniversaire quand m\u00eame","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Joyeux-anniversaire-quand-meme","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50000194"},"it":{"name":"Joyeux anniversaire quand m\u00eame","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Joyeux-anniversaire-quand-meme","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50000194"},"cn":{"name":"Joyeux anniversaire quand m\u00eame","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Joyeux-anniversaire-quand-meme","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50000194"},"fr":{"name":"Joyeux anniversaire quand m\u00eame","shortdescr":"Un anniversaire, c\u2019est forc\u00e9ment m\u00e9morable... Enfin, si on s\u2019en souvient !","longdescr":"Alex a eu un superbe anniversaire\u2026. Enfin pour ce qu\u2019il s\u2019en souvient. Trop d\u2019\u00e9motion, trop d\u2019alcool ou trop de fatigue, mais impossible de se rappeler de cette foutue soir\u00e9e.... Ah si, \u00e7a c\u2019est termin\u00e9 comme \u00e7a. Et juste avant, il s\u2019est pass\u00e9\u2026. Oh bordel ! Bon Bah, joyeux anniversaire quand m\u00eame ! A partir des \u00e9l\u00e9ments cl\u00e9s de la soir\u00e9e que vous allez nous donner, venez revivre une f\u00eate d\u2019anniversaire, entre moments l\u00e9gers, drames, conflits et grands moments d\u2019amour. Et comme on ne se souvient pas toujours des meilleures soir\u00e9es, nous allons vous raconter cet anniversaire \u00e0 l\u2019envers, selon le mod\u00e8le du film MEMENTO.... En commen\u00e7ant par les derni\u00e8res minutes de la soir\u00e9e. Puis les 5 minutes juste avant. Puis les 5 minutes encore avant. Puis 5 minutes encore encore avant... puis...Et ainsi de suite jusqu\u2019\u00e0 d\u00e9couvrir le d\u00e9but de la soir\u00e9e. Un spectacle d\u2019improvisation renversant qui va vous faire revivre vos meilleurs souvenirs d\u2019anniversaire.... m\u00eame ceux que vous auriez oubli\u00e9 !","performers":"Compagnie Les 4 saisons","boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Joyeux-anniversaire-quand-meme","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50000194"},"sp":{"name":"Joyeux anniversaire quand m\u00eame","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Joyeux-anniversaire-quand-meme","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50000194"},"nl":{"name":"Joyeux anniversaire quand m\u00eame","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Joyeux-anniversaire-quand-meme","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50000194"}},"place":{"id":270611,"translations":{"de":{"name":"Th\u00e9\u00e2tre l\u2019Improviste ","address_street_name":"Rue de Fierlant","address_street_number":"120","address_street_box":null,"email":null,"website":"http:\/\/www.improvi