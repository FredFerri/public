ess_street_box":null,"email":"info@arkadia.be","website":"http:\/\/www.arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Naamsestraat, 10","address_line2":"1000 Brussel","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Arkadia","address_street_name":"rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"http:\/\/www.arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"rue de Namur, 10","address_line2":"1000 Brussels","description_web":"As specialists in architectural heritage and contemporary art, we make the public (re)discover the city through guided tours and conferences in several languages. \r\n\r\nOur activities :\r\nGuided tours by foot, bus and metro - Educational projects - Exceptional interior visit- Team Building \r\n\r\nArkadia offers a wide selection of guided tours, under different forms: \r\n* For individual, we propose an annual programmation (almost only in French), which will make you take a new and attentive look on the city of Brussels. \r\n* For groups we offer a series of fun and original activities, around history, architecture, art and in exceptional interiors. \r\n* For schools and children, we offer thematic, educational and entertaining tours and stages. \r\n\r\nOur expertise : Our team is made up of 60 guides, historians and art historians. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"http:\/\/www.arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","