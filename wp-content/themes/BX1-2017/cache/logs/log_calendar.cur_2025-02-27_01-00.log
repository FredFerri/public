rtoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2025-02-25T01:00:52+01:00","published_at":"2024-09-09T14:42:13+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":301976,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.19351158547430664,"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{}},"translations":{"de":{"name":"Elliot Erwitt. A Retrospective.","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/expo-elliotterwitt.com\/bruxelles\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50011455"},"pt":{"name":"Elliot Erwitt. A Retrospective.","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/expo-elliotterwitt.com\/bruxelles\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50011455"},"en":{"name":"Elliot Erwitt. A Retrospective.","shortdescr":"After its resounding success in Paris and Lyon, the Elliott Erwitt exhibition is coming to Brussels for a limited time only. The program features 215 iconic shots of one of the most important photographers of all time.","longdescr":"One of the greatest figures in Photography is coming to Brussels! The exhibition, \"Elliott Erwitt. A Retrospective\" retraces the extraordinary career of a genius who knew how to combine humor and emotion like no other. More than 200 photographs of the biggest stars of the era are waiting to be discovered, along with a meeting between complete strangers, a trip to the four corners of the world, and above all, a peaceful moment of leisure. This iconic exhibition is not to be missed! Buy your tickets for \"Elliott Erwitt. A Retrospective\" in Brussels!","performers":null,"boxoffice_url":null,"website":"https:\/\/expo-elliotterwitt.com\/bruxelles\/en\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50011455"},"it":{"name":"Elliot Erwitt. A Retrospective.","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/expo-elliotterwitt.com\/bruxelles\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50011455"},"cn":{"name":"Elliot Erwitt. A Retrospective.","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/expo-elliotterwitt.com\/bruxelles\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50011455"},"fr":{"name":"Elliott Erwitt. Une R\u00e9trospective.","shortdescr":"Apr\u00e8s son succ\u00e8s retentissant \u00e0 Paris et Lyon, l\u2019exposition Elliott Erwitt. Une r\u00e9trospective pose ses valises \u00e0 Bruxelles pour une dur\u00e9e limit\u00e9e. Au programme, 215 clich\u00e9s iconiques  sur l\u2019un des photographes les plus importants de tous les temps.  \n","longdescr":"L\u2019une des plus grandes figures de la photographie d\u00e9barque \u00e0 Bruxelles ! L\u2019exposition, \u201cElliott Erwitt. Une r\u00e9trospective\u201d retrace la carri\u00e8re hors norme du g\u00e9nie qui savait conjuguer \u00e0 la perfection l\u2019humour et l\u2019\u00e9motion comme personne. En tout, plus de 200 photographies attendent les visiteurs pour un t\u00eate \u00e0 t\u00eate avec les plus grandes stars de l\u2019\u00e9poque, une rencontre avec de purs inconnus, un voyage aux quatre coins du monde mais avant tout un v\u00e9ritable moment de bonheur. Ind\u00e9niablement, l\u2019exposition iconique \u00e0 ne surtout pas manquer ! Sans plus attendre, ach\u00e8te tes billets pour Elliott Erwitt. Une r\u00e9trospective \u00e0 Bruxelles ! ","performers":null,"boxoffice_url":null,"website":"https:\/\/expo-elliotterwitt.com\/bruxelles\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50011455"},"sp":{"name":"Elliot Erwitt. A Retrospective.","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/expo-elliotterwitt.com\/bruxelles\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50011455"},"nl":{"name":"Elliott Erwitt: Een Retrospectief.","shortdescr":"Na het enorme succes in Parijs en Lyon komt de tentoonstelling \"Elliott Erwitt. Retrospective\" voor een beperkte tijd naar Brussel. Op het programma staan 215 iconische foto's van een van de belangrijkste fotografen ooit.\n","longdescr":"Een van de grootste namen in de fotografie komt naar Brussel! De tentoonstelling \u201cElliott Erwitt. Retrospective\u201d belicht de buitengewone carri\u00e8re van de meester die humor en emotie als geen ander weet te combineren. In totaal wachten meer dan 200 foto's op bezoekers voor een t\u00eate-\u00e0-t\u00eate met de grootste sterren van die tijd, ontmoetingen met onbekenden, een reis naar de verste uithoeken van de wereld, maar vooral een moment van geluk. Dit is zonder twijfel een iconische tentoonstelling die je niet mag missen! Koop vandaag nog je tickets voor Elliott Erwitt. Retrospective in Brussel!","performers":null,"boxoffice_url":null,"website":"https:\/\/expo-elliotterwitt.com\/bruxelles\/nl\/","email":null,"phon