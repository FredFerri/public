friday: from 10:00 to 18:00","saturday: from 12:00 to 18:00"],"de":["monday and sunday: closed","tuesday, wednesday, thursday and friday: from 10:00 to 18:00","saturday: from 12:00 to 18:00"],"it":["monday and sunday: closed","tuesday, wednesday, thursday and friday: from 10:00 to 18:00","saturday: from 12:00 to 18:00"],"sp":["monday and sunday: closed","tuesday, wednesday, thursday and friday: from 10:00 to 18:00","saturday: from 12:00 to 18:00"],"pt":["monday and sunday: closed","tuesday, wednesday, thursday and friday: from 10:00 to 18:00","saturday: from 12:00 to 18:00"],"cn":["monday and sunday: closed","tuesday, wednesday, thursday and friday: from 10:00 to 18:00","saturday: from 12:00 to 18:00"]},"date_start":"2023-01-12","date_end":"2023-02-25","is_also_by_appointment":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"opening":{"day":"2023-01-12","start":"18:00:00","timestamp":"2023-01-12T18:00:00+01:00","end":"21:00:00","is_only_by_appointment":false},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-02-12T03:35:34+01:00","published_at":"2023-01-06T17:44:33+01:00","backoffice_id":268458,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.35421952306087},{"id":546684,"date_start":"2023-01-12","date_end":"2023-03-04","date_next":"2023-02-14","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung","it":"Esposizioni","sp":"Exhibici\u00f3n","pt":null,"cn":null}},"others":{"list":[24,30],"translations":{"fr":["Galeries d'art","Peinture"],"nl":["Galeries","Schilderkunst"],"en":["Art Galleries","Painting"],"de":["Kunstgalerien","Malerei"],"it":["Gallerie d'arte","Pittura"],"sp":["Galer\u00edas de arte","Pintura"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Jean-Fran\u00e7ois Lacalmontie","shortdescr":null,"longdescr":"La galerie Baronian a le plaisir d'inaugurer la premi\u00e8re exposition personnelle de Jean-Fran\u00e7ois Lacalmontie \u00e0 Bruxelles, intitul\u00e9e Peintures. Apr\u00e8s un solo show \u00e0 la foire Art Brussels, le peintre fran\u00e7ais pr\u00e9sente une s\u00e9rie de peintures r\u00e9centes. Dans ses \u0153uvres, Lacalmontie nous montre de grands fonds blancs bord\u00e9s d'un cadre noir dans lequel s'enchev\u00eatrent des dessins noirs. Ici et l\u00e0, des collages sont int\u00e9gr\u00e9s, un oiseau color\u00e9 en origami, un ciel bleu, un nuage. Le processus de cr\u00e9ation de Lacalmontie est m\u00e9thodique. Dans plusieurs carnets, l'artiste laisse libre cours \u00e0 son imagination au fil des pages. Par un processus automatique, il se laisse aller et dessine toutes sortes de figures issues de son \"univers int\u00e9rieur\". Cet \u00e9tat de fantaisie donne ensuite lieu \u00e0 la s\u00e9lection de certains \"objets\" qui seront ensuite d\u00e9coup\u00e9s, agrandis, projet\u00e9s et finalement transpos\u00e9s sur la toile. Jean-Fran\u00e7ois Lacalmontie est un peintre de la vibration, sans aucun signe de pathos ou d'imm\u00e9diatet\u00e9. Ses \u0153uvres sont des id\u00e9es qu'il saisit, qui nous offrent une exp\u00e9rience de plong\u00e9e singuli\u00e8re. Chaque tableau est d'une \u00e9l\u00e9gance tr\u00e8s ma\u00eetris\u00e9e, qui nous trouble et nous laisse \u00e0 l'aff\u00fbt.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.baronian.eu","email":"info@baronian.eu","phone_contact":"+32 2 512 92 95","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.546684"},"nl":{"name":"Jean-Fran\u00e7ois Lacalmontie","shortdescr":null,"longdescr":"Galerie Baronian heeft het genoegen de eerste solotentoonstelling van Jean-Fran\u00e7ois Lacalmontie in Brussel in te huldigen, getiteld Peintures. Na een solotentoonstelling op Art Brussels presenteert de Franse schilder een reeks recente schilderijen. In zijn werken toont Lacalmontie ons grote witte achtergronden omzoomd door een zwart kader waarin zwarte tekeningen verstrengeld zijn. Hier en daar zijn collages ge\u00efntegreerd, een gekleurde vogel in origami, een blauwe lucht, een wolk. Lacalmontie's creatieve proces is methodisch. In een aantal schriften laat de kunstenaar zijn fantasie de vrije loop op de bladzijden. Via een automatisch proces laat hij zichzelf dwalen en tekent hij allerlei figuren die voortkomen uit zijn \"innerlijke universum\". Deze toestand van fantasie maakt vervolgens plaats voor de selectie van bepaalde \"voorwerpen\" die vervolgens worden uitgeknipt, vergroot, geprojecteerd en uiteindelijk op het doek gezet. Jean-Fran\u00e7ois Lacalmontie is een schilder van vibraties, zonder enig teken van pathos of directheid. Zijn werken zijn idee\u00ebn die hij aangrijpt, die ons een unieke duikervaring bieden. Elk schilderij is van een zeer beheerste elegantie, die ons verontrust en op het verkeerde been zet.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.baronian.eu","email":"info@baronian.eu","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.546684"},"en":{"name":"Jean-Fran\u00e7ois Lacalmontie","shortdescr":"Gallery Baronian is pleased to inaugurate Jean-Fran\u00e7ois Lacalmontie\u2019s first solo exhibition in Brussels, entitled Peintures. After a solo show at Art Brussels fair, the French painter presents a series of recent paintings.","longdescr":"Gallery Baronian is pleased to inaugurate Jean-Fran\u00e7ois Lacalmontie\u2019s first solo exhibition in Brussels, entitled Peintures. After a solo show at Art Brussels fair, the French painter presents a series of recent paintings. In his works, Lacalmontie shows us large white backgrounds bordered by a black frame in which black drawings are entangled. Here and there, collages are integrated, a colored bird in origami, a blue sky, a cloud. Lacalmontie\u2019s creative process is methodical. In a number of notebooks, the artist lets his imagination run wild on the pages. Through an automatic process, he lets himself wander and draws all sorts of figures springing from his \u201cinner universe\u201d. This state of fantasy then gives way to the selection of certain \u201cobjects\u201d which will then be cut out, enlarged, projected and finally transposed onto the canvas. Jean-Fran\u00e7ois Lacalmontie is a painter of vibration, without any sign of pathos or immediacy. His works are ideas that he grasps, that offer us a singular diving experience. Each painting is of a very mastered elegance, which troubles and leaves us on the lookout.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.baronian.eu","email":"info@baronian.eu","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.546684"},"de":{"name":"Jean-Fran\u00e7ois Lacalmontie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.baronian.eu","email":"info@baronian.eu","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.546684"},"it":{"name":"Jean-Fran\u00e7ois Lacalmontie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.baronian.eu","email":"info@baronian.eu","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.546684"},"sp":{"name":"Jean-Fran\u00e7ois Lacalmontie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.baronian.eu","email":"info@baronian.eu","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.546684"},"pt":{"name":"Jean-Fran\u00e7ois Lacalmontie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.baronian.eu","email":"info@baronian.eu","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.546684"},"cn":{"name":"Jean-Fran\u00e7ois Lacalmontie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.baronian.eu","email":"info@baronian.eu","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.546684"}},"place":{"id":238078,"translations":{"fr":{"name":"Baronian","address_street_name":"Rue Isidore Verheyden","address_street_number":"2","address_street_box":null,"email":"info@baronian.eu","website":"http:\/\/www.baronian.eu","phone_contact":"+32 2 512 92 95","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Isidore Verheyden, 2","address_line2":"1050 Ixelles","description_web":"Albert Baronian est l\u2019un des galeristes les plus embl\u00e9matiques de la capitale. Il a d\u00e9but\u00e9 ses activit\u00e9s dans les ann\u00e9es 70. La programmation de sa galerie refl\u00e8te ses gouts \u00e9clectiques et sensibles. Les artistes du mouvement de l\u2019arte povera comme Alighiero e Boetti ou Mario Merz y trouvent une vitrine belge pour valoriser leur travail. Gilbert & Georges, Tony Oursler, Bruno Serralongue, Robert Devriendt\u2026 Le programme de la galerie est consacr\u00e9 \u00e0 l\u2019art contemporain ainsi qu'aux mouvements artistiques et aux artistes importants qui ont marqu\u00e9 les quarante derni\u00e8res ann\u00e9es. Toute proche de la place St\u00e9phanie, la galerie compte deux espaces distincts mais se faisant quasiment face : la galerie principale est install\u00e9e dans la rue Isidore Verheyden et l\u2019annexe \u00e0 la rue de la Concorde. ","description_print":"","booking_url":null,"sort_order":"Baronian ","virtual_visit":null},"nl":{"name":"Baronian","address_street_name":"Isidore Verheydenstraat","address_street_number":"2","address_street_box":null,"email":"info@baronian.eu","website":"http:\/\/www.baronian.eu","phone_contact":"+32 2 512 92 95","phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"Isidore Verheydenstraat, 2","address_line2":"1050 Elsene","description_web":"Albert Baronian is een van de meest emblematische galerijhouders in de hoofdstad, met een carri\u00e8re die eind jaren 1970 begon. Het programma van zijn galerij weerspiegelt zijn eclectische en gevoelige smaak. Kunstenaars van de arte-poverabeweging zoals Alighiero e Boetti of Mario Merz vinden er een Belgische vitrine voor hun werk. Nu circuleren er namen als Gilbert & Georges, Tony Oursler, Bruno Serralongue, Robert Devriendt en vele anderen. Het programma van de galerij is daarmee zowel gewijd aan de hedendaagse kunst als aan de kunststromingen en kunstenaars die de laatste veertig jaar hun stempel hebben gedrukt. Vlakbij het Stefaniaplein beschikt de galerie over twee verschillende, maar bijna tegenover elkaar liggende ruimtes: de hoofdgalerie bevindt zich in de Isidore Verheydenstraat en het bijgebouw in de Eendrachtsstraat. ","description_print":"","booking_url":null,"sort_order":"Baronian ","virtual_visit":null},"en":{"name":"Baronian","address_street_name":"Rue Isidore Verheyden","address_street_number":"2","address_street_box":null,"email":"info@baronian.eu","website":"http:\/\/www.baronian.eu","phone_contact":"+32 2 512 92 95","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Isidore Verheyden, 2","address_line2":"1050 Ixelles","description_web":"Albert Baronian is one of the most emblematic gallery owners in the capital and began his activities in the 1970s. The programme of his gallery reflects his eclectic and sensitive tastes. Artists from the arte povera movement such as Alighiero e Boetti or Mario Merz are given a Belgian showcase for their work. Gilbert & Georges, Tony Oursler, Bruno Serralongue, Robert Devriendt... The gallery's programme is devoted to contemporary art as well as to important artistic movements and artists who have marked the last forty years. Close to place St\u00e9phanie, the gallery has two distinct, but almost opposite spaces: the main gallery is located in rue Isidore Verheyden and the annex in rue de la Concorde.  \r\nAlbert Baronian opened his first gallery in 1973 and immediately enjoyed international success thanks to the presentation of Arte Povera artists Alighiero e Boetti, Mario Merz, Giulio Paolini, Gilberto Zorio. Later, as the president of the Galleries\u2019 Association, the Brussels Art fair took a more international turn whilst under his direction. He sees the responsibility of the gallery as three folds: to work for the long term development of each artists\u2019 career, acting as a liaison to international galleries and museums as well as placing works in collections; to create an historical archive for each artist; and to act as an accessible public space in which the exhibitions become an exemplary gesture of the power of subjectivity to the audience at large. The program is dedicated to contemporary art as well as important artistic movements and artists that have defined the last forty years. \u00bb \r\n","description_print":"","booking_url":null,"sort_order":"Baronian ","virtual_visit":null},"de":{"name":"Baronian Xippas","address_street_name":"Rue Isidore Verheyden","address_street_number":"2","address_street_box":null,"email":"info@baronian.eu","website":"http:\/\/www.baronian.eu","phone_contact":"+32 2 512 92 95","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Isidore Verheyden, 2","address_line2":"1050 Ixelles","description_web":"","description_print":"","bookin