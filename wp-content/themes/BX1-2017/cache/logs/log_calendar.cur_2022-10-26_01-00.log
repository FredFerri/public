2022-11-11","start":"10:00:00","end":"12:00:00"}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[3,7,8,9],"translations":{"fr":["Secondaire","12 - 14 ans","14 - 16 ans","16 - 18 ans"],"nl":["Secundair onderwijs","12 - 14 jaar","14 - 16 jaar","16 - 18 jaar"],"en":["Secondary school","12 - 14 years","14 - 16 years","16 - 18 years"]}},"visit_profile":{"list":[322],"translations":{"fr":["Art Nouveau & Art D\u00e9co"],"nl":["Art nouveau & art deco"],"en":["Art Nouveau &  Art D\u00e9co"],"de":["Jugendstil & Art d\u00e9co"]}},"tags":[],"accessibilities":{"list":[255,263],"translations":{"fr":["Accessible","Accessible aux pi\u00e9tons appareill\u00e9s"],"nl":["Toegankelijk","Toegankelijk voor voetgangers met hulpmiddelen"],"en":["Accessible","Accessible to pedestrians with mobility aids"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-24T01:05:44+02:00","published_at":"2021-04-12T11:38:28+02:00","backoffice_id":230572,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.085803768349643},{"id":544245,"date_start":"2022-10-31","date_end":"2022-10-31","date_next":"2022-10-31","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":84,"translations":{"fr":"Divers","nl":"Varia","en":"Various","de":"Verschiedenes"}},"others":{"list":[89],"translations":{"fr":["Litt\u00e9rature"],"nl":["Literatuur"],"en":["Litterature "],"de":["Literatur"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Rencontre avec Safia Kessas et Camille Wernaers","shortdescr":"Nouvelle vague de f\u00e9minisme, #metoo, balance ton porc, ton bar\u2026\r\n\r\nO\u00f9 en sont les femmes aujourd\u2019hui ? Dans quels domaines s\u2019accomplissent-elles ? Quels combats doivent-elles encore mener ? Comment leur pr\u00e9sence est-elle per\u00e7ue dans certains m\u00e9tiers traditionnellement r\u00e9serv\u00e9s aux hommes ?","longdescr":"Pour r\u00e9pondre \u00e0 ces questions, le livre \u201cVictorieuses: 50 parcours de femmes d\u2019aujourd\u2019hui\u201d de Safia Kessas et Camille Wernaers, publi\u00e9 en septembre 2022 aux \u00e9ditions De Boeck Sup\u00e9rieur, met en lumi\u00e8re 50 femmes aux parcours tr\u00e8s diff\u00e9rents. L\u2019une est humoriste, l\u2019autre pompi\u00e8re, p\u00e2tissi\u00e8re, avocate ou pilote de chasse. Anonymes ou c\u00e9l\u00e8bres, de tous \u00e2ges et de toutes origines, elles ont en commun de s\u2019\u00eatre fray\u00e9 un chemin pour arriver l\u00e0 o\u00f9 on ne les attendait pas, avec courage, sensibilit\u00e9 et r\u00e9silience.\r\n\r\nD\u2019Agn\u00e8s Jaoui, actrice, \u00e0 Samia Orosemane, humoriste, en passant par Scarlette Le Corre, patronne de p\u00eache, Christine Vernay, vigneronne bio, ou \u00c9lise Tunstall, \u00e9b\u00e9niste, ce livre brosse le portrait de ces femmes d\u2019exception au parcours atypique dont elles sont sorties victorieuses et sur lequel elles acceptent de revenir, le temps d\u2019une conversation \u00e0 c\u0153ur ouvert, pour nous partager leurs r\u00eaves, leurs espoirs et leurs conseils.\r\n\r\n\u00c0 l\u2019occasion de la parution de ce nouvel ouvrage, Safia Kessas, Camille Wernaers ainsi que diff\u00e9rentes femmes victorieuses dont les portraits ont \u00e9t\u00e9 dress\u00e9s dans le livre, nous feront l\u2019honneur de leur pr\u00e9sence.","performers":"Safia Kessas\r\nCamille Wernaers","boxoffice_url":null,"website":"http:\/\/www.espacemagh.be","email":"reservation@espacemagh.be","phone_contact":"+32 2 274 05 10","phone_booking":"+32 2 274 05 10","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.544245"},"nl":{"name":"Rencontre avec Safia Kessas et Camille Wernaers","shortdescr":null