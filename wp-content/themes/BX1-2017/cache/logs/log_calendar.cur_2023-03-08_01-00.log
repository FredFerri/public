veau"],"is_part_of":"Ann\u00e9e Art Nouveau","accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-03-03T04:35:07+01:00","published_at":"2023-03-03T03:30:30+01:00","backoffice_id":272784,"import_origin":"explore","sub_type":"other","show_in_agenda":true,"ranking":0.7937005259841},{"id":544519,"date_start":"2023-03-05","date_end":"2023-03-19","date_next":"2023-03-18","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater","it":"Teatro","sp":"Teatro","pt":null,"cn":null}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"],"de":["Theater"],"it":["Teatro"],"sp":["Teatro"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Pi\u00e8ce de th\u00e9\u00e2tre \"Sous mes ailes\"","shortdescr":"\u00ab Sous mes ailes \u00bb est un conte futuriste, une pi\u00e8ce dystopique qui interroge l\u2019influence\r\nde la maternit\u00e9 sur la vie sociale et la vie personnelle des femmes, ainsi que l\u2019influence de la soci\u00e9t\u00e9 dans les vies quotidiennes des m\u00e8res.","longdescr":"Le ton de la pi\u00e8ce oscille entre suspens, humour et \u00e9motions. On y retrouve les m\u00e8res menant un combat quotidien dans une soci\u00e9t\u00e9 o\u00f9 \u00eatre m\u00e8re est devenue une mission impossible.\r\n\r\nSynopsis : V\u00e9ritables boucs \u00e9missaires d\u2019une soci\u00e9t\u00e9 r\u00e9gie par un pouvoir orwellien qui exerce un contr\u00f4le total et extr\u00eamement culpabilisant, les m\u00e8res de la pi\u00e8ce doivent r\u00e9pondre aux plus grandes attentes : mettre tout en \u0153uvre, seules, pour faire de leur prog\u00e9niture les tant attendus g\u00e9nies qui r\u00e9inventeront le monde. Pour cela, elles sont trac\u00e9es et r\u00e9f\u00e9renc\u00e9es selon leur niveau de r\u00e9ussite. Des statistiques sont \u00e9tablies. Combien de m\u00e8res exemplaires, de m\u00e8res col\u00e9riques, incapables, indignes, indiff\u00e9rentes. M\u00e8res trop. M\u00e8res pas assez. \r\n\r\nDans cette soci\u00e9t\u00e9 de surveillance g\u00e9n\u00e9ralis\u00e9e, con\u00e7ue pour an\u00e9antir les vell\u00e9it\u00e9s d\u2019initiative et de libert\u00e9, une jeune m\u00e8re, Maria, se d\u00e9bat pour offrir des temps de jeu et du r\u00eave \u00e0 son enfant.","performers":"Un spectacle \u00e9crit et mis en sc\u00e8ne par Carole Ventura\r\nCollaboration artistique : Luca Franceschi\r\nInterpr\u00e9t\u00e9 par : Luca Franceschi, Julie Marichal, Carole Ventura","boxoffice_url":null,"website":"https:\/\/www.theatrecreanova.be\/en-tourn%C3%A9e\/spectacle-theatre-lucafranceshi-caroleventura\/sous-mes-ailes\/","email":"adm@theatrecreanova.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.544519"},"nl":{"name":"Pi\u00e8ce de th\u00e9\u00e2tre \"Sous mes ailes\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrecreanova.be\/en-tourn%C3%A9e\/spectacle-theatre-lucafranceshi-caroleventura\/sous-mes-ailes\/","email":"adm@theatrecreanova.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.544519"},"en":{"name":"Pi\u00e8ce de th\u00e9\u00e2tre \"Sous mes ailes\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrecreanova.be\/en-tourn%C3%A9e\/spectacle-theatre-lucafranceshi-caroleventura\/sous-mes-ailes\/","email":"adm@theatrecreanova.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-de