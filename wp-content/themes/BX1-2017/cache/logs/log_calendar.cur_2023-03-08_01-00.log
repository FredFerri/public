cn":[null,null,null,null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2023-02-17T17:09:02+01:00","published_at":"2022-09-30T15:50:42+02:00","backoffice_id":262867,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.23404631038832},{"id":539148,"date_start":"2022-09-08","date_end":"2023-03-30","date_next":"2023-03-09","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater","it":"Teatro","sp":"Teatro","pt":null,"cn":null}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"],"de":["Theater"],"it":["Teatro"],"sp":["Teatro"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"A Table!","shortdescr":"Les estomacs se remplissent, les langues se d\u00e9lient","longdescr":"C\u2019est \u00e0 un repas bien r\u00e9el auquel va assister le public.\r\nAu d\u00e9but du spectacle, le menu est annonc\u00e9 aux spectateurs et aux com\u00e9diens qui n\u2019en ont pas connaissance. Qui seront les personnages r\u00e9unis autour de la table ? \u00c0 quelle occasion seront-ils r\u00e9unis ? Un repas d\u2019affaire, un d\u00eener de Saint Valentin, un festin de retrouvailles d\u2019amis d\u2019enfance, un pique-nique en famille...\r\nC\u2019est aux spectateurs de proposer.\r\nD\u00e9marrant de cette impulsion du public et sans concertation ni canevas, les com\u00e9diens vont improviser une sc\u00e8ne de repas pendant 1h15.\r\n\u00c0 partir d\u2019une situation toute simple que tout le monde a d\u00e9j\u00e0 v\u00e9cu, les com\u00e9diens vont cr\u00e9er une v\u00e9ritable histoire pouvant, selon les soir\u00e9es, aller d\u2019une com\u00e9die haute en couleur, \u00e0 un drame poignant en passant par un thriller haletant.\r\n\r\nChaque saison, gr\u00e2ce \u00e0 la g\u00e9n\u00e9rosit\u00e9 des com\u00e9diens jouant b\u00e9n\u00e9volement ce spectacle, la moiti\u00e9 des recettes de ce spectacle permet de soutenir une association. \r\nEn venant assister \u00e0 ce spectacle, vous faites donc \u00e9galement une bonne action !","performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/A-Table.html","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.539148"},"nl":{"name":"A Table!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/A-Table.html","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.539148"},"en":{"name":"A Table!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/A-Table.html","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.539148"},"de":{"name":"A Table!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/A-Table.html","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.539148"},"it":{"name":"A Table!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/A-Table.html","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.539148"},"sp":{"name":"A Table!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http