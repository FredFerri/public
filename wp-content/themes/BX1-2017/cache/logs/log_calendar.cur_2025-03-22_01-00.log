_of":null,"sub_type":"theatre","ranking":0.6133748537965212,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":49,"translations":{"de":"Theater","pt":null,"en":"Theatre","it":"Teatro","cn":null,"fr":"Th\u00e9\u00e2tre","sp":"Teatro","nl":"Theater"}},"others":{}},"translations":{"de":{"name":"Chers parents","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/www.visit.brussels\/de\/besucher\/veranstaltungskalender\/event-detail\/book-tickets.Chers-parents.5700005868","website":"http:\/\/www.trg.be","email":"info@trg.be","phone_contact":"+32 2 512 04 07","phone_booking":"+32 2 512 04 07","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700005868"},"pt":{"name":"Chers parents","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/www.visit.brussels\/en\/visitors\/agenda\/event-detail\/book-tickets.Chers-parents.5700005868","website":"http:\/\/www.trg.be","email":"info@trg.be","phone_contact":"+32 2 512 04 07","phone_booking":"+32 2 512 04 07","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700005868"},"en":{"name":"Chers parents","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/www.visit.brussels\/en\/visitors\/agenda\/event-detail\/book-tickets.Chers-parents.5700005868","website":"http:\/\/www.trg.be","email":"info@trg.be","phone_contact":"+32 2 512 04 07","phone_booking":"+32 2 512 04 07","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700005868"},"it":{"name":"Chers parents","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/www.visit.brussels\/it\/visitatori\/agenda\/event-detail\/book-tickets.Chers-parents.5700005868","website":"http:\/\/www.trg.be","email":"info@trg.be","phone_contact":"+32 2 512 04 07","phone_booking":"+32 2 512 04 07","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700005868"},"cn":{"name":"Chers parents","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/www.visit.brussels\/en\/visitors\/agenda\/event-detail\/book-tickets.Chers-parents.5700005868","website":"http:\/\/www.trg.be","email":"info@trg.be","phone_contact":"+32 2 512 04 07","phone_booking":"+32 2 512 04 07","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700005868"},"fr":{"name":"Chers parents","shortdescr":"\u00ab Chers Parents \u00bb est une com\u00e9die qui parle de la famille, d\u2019amour, d\u2019argent, de l\u2019instabilit\u00e9 des sentiments, de la part d\u2019ombre qui sommeille en chacun de nous et de ce que les parents doivent \u00e0 leurs enfants.","longdescr":"\"Chers parents\"\nUne com\u00e9die de Emmanuel & Armelle Patron\nPierre, Jules et Louise Gauthier s\u2019adorent et aiment profond\u00e9ment leurs parents. Alors, lorsque ces derniers leur demandent de venir les rejoindre d\u2019urgence, les trois enfants boulevers\u00e9s se pr\u00e9cipitent craignant le pire. Mais le pire n\u2019a pas lieu, du moins pas tout de suite, et la merveilleuse nouvelle que leur annoncent Jeanne et Vincent va faire voler en \u00e9clats la belle unit\u00e9 familiale\u2026 faisant ardemment souhaiter aux trois rejetons ce qu\u2019ils redoutaient le plus en arrivant quelques heures plus t\u00f4t ! \u00ab Chers Parents \u00bb est une com\u00e9die qui parle de la famille, d\u2019amour, d\u2019argent, de l\u2019instabilit\u00e9 des sentiments, de la part d\u2019ombre qui sommeille en chacun de nous et de ce que les parents doivent \u00e0 leurs enfants.\n\u00ab L\u2019\u00e9criture de la pi\u00e8ce est partie de cette phrase provocatrice : \u2018On ne vous donne rien parce qu'on vous aime.\u2019 \u00c9tant fr\u00e8re et s\u0153ur, l'amour pour notre famille nous a naturellement inspir\u00e9s... C\u2019est une catharsis pour les gens de voir des enfants basculer comme \u00e7a, de voir cette famille qui devient dingue. On le sait, ce qui nous fait rire, c\u20