heatre"],"it":["Teatro"],"cn":[null],"fr":["Th\u00e9\u00e2tre"],"sp":["Teatro"],"nl":["Theater"]}}},"translations":{"de":{"name":"Sous mes ailes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrecreanova.be\/programmation\/#sous-mes-ailes","email":"adm@theatrecreanova.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.561639"},"pt":{"name":"Sous mes ailes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrecreanova.be\/programmation\/#sous-mes-ailes","email":"adm@theatrecreanova.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.561639"},"en":{"name":"Sous mes ailes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrecreanova.be\/programmation\/#sous-mes-ailes","email":"adm@theatrecreanova.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.561639"},"it":{"name":"Sous mes ailes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrecreanova.be\/programmation\/#sous-mes-ailes","email":"adm@theatrecreanova.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.561639"},"cn":{"name":"Sous mes ailes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrecreanova.be\/programmation\/#sous-mes-ailes","email":"adm@theatrecreanova.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.561639"},"fr":{"name":"Sous mes ailes","shortdescr":"Conte dystopique sur la charge mentale des m\u00e8res","longdescr":"V\u00e9ritables boucs \u00e9missaires d\u2019une soci\u00e9t\u00e9 r\u00e9gie par un pouvoir orwellien qui exerce un contr\u00f4le total et extr\u00eamement culpabilisant, les m\u00e8res de la pi\u00e8ce doivent r\u00e9pondre aux plus grandes attentes : mettre tout en \u0153uvre, seules, pour faire de leur prog\u00e9niture les tant attendus g\u00e9nies qui r\u00e9inventeront le monde. Pour cela, elles sont trac\u00e9es et r\u00e9f\u00e9renc\u00e9es selon leur niveau de r\u00e9ussite. Des statistiques sont \u00e9tablies. Combien de m\u00e8res exemplaires, de m\u00e8res col\u00e9riques, incapables, indignes, indiff\u00e9rentes. M\u00e8res trop. M\u00e8res pas assez. \r\n\r\n \r\n\r\nDans cette soci\u00e9t\u00e9 de surveillance g\u00e9n\u00e9ralis\u00e9e, con\u00e7ue pour an\u00e9antir les vell\u00e9it\u00e9s d\u2019initiative et de libert\u00e9, une jeune m\u00e8re, Maria, se d\u00e9bat pour offrir des temps de jeu et du r\u00eave \u00e0 son enfant. \r\n\r\n \r\n\r\nMais le temps manque et la fatigue petit \u00e0 petit commence \u00e0 l\u2019envahir. Tel Sisyphe, elle gravit chaque matin la montagne du quotidien et se retrouve tragiquement chaque soir au pied de la m\u00eame montagne. Avant qu\u2019il ne soit trop tard, elle d\u00e9barque dans l\u2019\u00e2tre d\u2019une vieille nourrice \u00e0 qui il est pr\u00e9vu qu\u2019elle confie son enfant avant de rejoindre les autres m\u00e8res en fuite... ","performers":"Ecrit et mis en sc\u00e8ne par Carole Ventura  \r\nCollaboration artistique Luca Franceschi l Interpr\u00e9t\u00e9 par Luca Franceschi, Maximilien Le Meledo, Julie Marichal, Carole Ventura, \r\n\r\nAvec le soutien de F\u00e9d\u00e9ration Wallonie Bruxelles  - Un Futur pour la Culture, de la Commune de Saint Gilles, taxshelter.be, ING et du Tax-shelter du gouvernement f\u00e9d\u00e9ral belge.","boxoffice_url":null,"website":"https:\/\/www.theatrecreanova.be\/programmation\/#sous-mes-ailes","email":"adm@theatrecreanova.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.561639"},"sp":{"name":"Sous mes ailes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrecreanova.be\/programmation\/#sous-mes-ailes","email":"adm@theatrecreanova.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.561639"},"nl":{"name":"Sous mes ailes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrecreanova.be\/programmation\/#sous-mes-ailes","email":"adm@theatrecreanova.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.561639"}},"place":{"id":275475,"translations":{"de":{"name":"Th\u00e9\u00e2tre CreaNova","address_street_name":"rue de la victoire ","address_street_number":"96","address_street_box":"1060","email":"contact@creabxl.org","website":"http:\/\/www.creatheatrebruxelles.be","phone_contact":"+32 499 50 12 28","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"rue de la victoire , 96 \/ 1060","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Th\u00e9\u00e2tre CreaNova","address_street_name":"rue de la victoire ","address_street_number":"96","address_street_box":"1060","email":"contact@creabxl.org","website":"http:\/\/www.creatheatrebruxelles.be","phone_contact":"+32 499 50 12 28","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"rue de la victoire , 96 \/ 1060","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Th\u00e9\u00e2tre CreaNova","address_street_name":"rue de la victoire ","address_street_number":"96","address_street_box":"1060","email":"contact@creabxl.org","website":"http:\/\/www.creatheatrebruxelles.be"