xt":"2023-09-05","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2023-09-04T02:00:43+02:00","published_at":"2023-07-03T10:03:42+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":280973,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.30285343213869,"languages":{"spoken":["en","fr","nl"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[46,36],"translations":{"de":["Multidisziplin\u00e4r","Museen & Kunstzentren"],"pt":[null,null],"en":["Multidisciplinary","Museums and art centers"],"it":["Multidisciplinare","Musei e centri artistici"],"cn":[null,null],"fr":["Pluridisciplinaire","Mus\u00e9es et art centers"],"sp":["Multidisciplinar","Museos y centros de arte"],"nl":["Multidisciplinair","Musea en kunstcentra"]}}},"translations":{"de":{"name":"Parcours Manneken-Pis","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/museearmee.be","email":"info@warheritage.be","phone_contact":null,"phone_booking":"+ 32 (0)2 737 78 33","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.560973"},"pt":{"name":"Parcours Manneken-Pis","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/museearmee.be","email":"info@warheritage.be","phone_contact":null,"phone_booking":"+ 32 (0)2 737 78 33","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.560973"},"en":{"name":"Parcours Manneken-Pis","shortdescr":"Manneken-Pis at the Military Museum Brussels!","longdescr":"As part of its centenary celebrations on the Cinquantenaire site, the Royal Military Museum Brussels is welcoming Manneken-Pis to its collections.\r\n\r\nVisitors will be surprised by several figurines dressed in costumes from the personal wardrobe of the famous Brussels boy throughout the Museum.\r\n\r\nTo enhance the visitor experience, the education department has produced a visit booklet for the whole family. Young visitors can enjoy a fun game in front of each figurine, while adults learn more about our collection pieces through anecdotes. Moreover, a special surprise awaits those who successfully locate all the hidden Manneken-Pis figures within the Museum.\r\n\r\nVisitors will also have the opportunity to  enter a photo competition held during the exhibition, with chances to win exciting prizes.\r\n\r\nFree trail (included in the Museum admission), booklet upon request at the reception desk, bring your own pencil","performers":"In collaboration with the Museum of the City of Brussels and GardeRobe MannekenPis.","boxoffice_url":null,"website":"https:\/\/museearmee.be","email":"info@warheritage.be","phone_contact":null,"phone_booking":"+ 32 (0)2 737 78 33","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.560973"},"it":{"name":"Parcours Manneken-Pis","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/museearmee.be","email":"info@warheritage.be","phone_contact":null,"phone_booking":"+ 32 (0)2 737 78 33","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.560973"},"cn":{"name":"Parcours Manneken-Pis","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/museearmee.be","email":"info@warheritage.be","phone_contact":null,"phone_booking":"+ 32 (0)2 737 78 33","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.560973"},"fr":{"name":"Parcours Manneken-Pis","shortdescr":"Manneken-Pis au Mus\u00e9e de l'Arm\u00e9e","longdescr":"Dans le cadre du centenaire du Mus\u00e9e sur le site du Cinquantenaire, le Mus\u00e9e royal de l\u2019Arm\u00e9e accueille Manneken-Pis dans ses collections.\r\n\r\nPlusieurs statuettes v\u00eatues de costumes issus de la garde-robe personnelle du c\u00e9l\u00e8bre petit bruxellois surprendront les visiteurs dans l\u2019ensemble du Mus\u00e9e.\r\nPour rendre cette d\u00e9couverte encore plus agr\u00e9able, le service \u00e9ducatif a r\u00e9alis\u00e9 un livret de visite pour toute la famille : une \u00e9preuve attend les plus jeunes devant chaque statuette tandis que les adultes en apprendront plus sur la diversit\u00e9 de nos pi\u00e8ces de collections gr\u00e2ce \u00e0 des mises en contexte et des anecdotes. Une surprise attend ceux qui retrouveront tous les Manneken-Pis cach\u00e9s dans le Mus\u00e9e !\r\n\r\nUn concours de photo permettra aussi aux visiteurs de remporter plusieurs prix tout au long de l\u2019exposition.\r\n\r\nJeu parcours gratuit (inclus dans le prix d'entr\u00e9e au Mus\u00e9e), livret \u00e0 demander \u00e0 l'accueil, se munir d'un crayon.","performers":"En collaboration avec le Mus\u00e9e de la Ville de Bruxelles et GardeRobe MannekenPis","boxoffice_url":null,"website":"https:\/\/museearmee.be","email":"info@warheritage.be","phone_contact":null,"phone_booking":"+ 32 (0)2 737 78 33","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.560973"},"sp":{"name":"Parcours Manneken-Pis","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/museearmee.be","email":"info@warheritage.be","phone_contact":null,"phone_booking":"+ 32 (0)2 737 78 33","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.560973"},"nl":{"name":"Parcours Manneken-Pis","shortdescr":"Manneken Pis in het Legermuseum!","longdescr":"In het kader van de viering van het honderdjarig bestaan van het museum op de Jubelparksite, verwelkomt het Koninklijk Legermuseum Manneken Pis.\r\n\r\nDoorheen het hele museum worden bezoekers verrast door verschillende beeldjes, aangekleed met kostuumpjes uit de persoonlijke garderobe van het beroemde Brusselse jongetje.\r\nOm deze ontdekking nog aangenamer te maken, heeft de educatieve dienst een bezoekboekje voor het hele gezin samengesteld: bij elk beeldje wacht de jongste bezoekertjes een test, terwijl de grote mensen aan de hand van contextinformatie en anekdotes meer vernemen over de diversiteit van onze collectiestukken. Wie alle Manneken Pis-beeldjes in het museum vindt, wordt beloond met een verrassing!\r\n\r\nBezoekers kunnen ook deelnemen aan een fotowedstrijd waarmee ze gedurende de tentoonstelling prijzen kunnen winnen.\r\n\r\n Gratis parcours, inbegrepen in een ticket voor het Legermuseum, boekje te verkrijgen aan onze onthaaldesk, breng zelf een potlood of ander schrijfgerei mee!","performers":" Samenwerking met het Museum van de Stad Brussel en GardeRobe MannekenPis.","boxoffice_url":null,"website":"https:\/\/museearmee.be","email":"info@warheritage.be","phone_contact":null,"phone_booking":"+ 32 (0)2 737 78 33","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.560973"}},"place":{"id":555,"translations":{"de":{"name":"Mus\u00e9e Royal de l\u2019Arm\u00e9e (War Heritage Institute)","address_street_name":"Parc du Cinquantenaire","address_street_number":"3","address_street_box":null,"email":"info@warheritage.be","website":"http:\/\/www.warheritage.be","phone_contact":"+ 32 (0)2 737 78 33","phone_booking":"+ 32 (0)2 737 78 33","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Museu Real das For\u00e7as Armadas e da Hist\u00f3ria Militar","address_street_name":"Parc du Cinquantenaire","address_street_number":"3","address_street_box":null,"email":"info@warheritage.be","website":"http:\/\/www.warheritage.be","phone_contact":"+ 32 (0)2 737 78 33","phone_booking":"+ 32 (0)2 737 78 33","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 3","address_line2":"1000 Bruxelles","description_web":"Mais de dez s\u00e9culos de hist\u00f3ria e de t\u00e9cnicas militares passaram em revista por este museu. A\u00ed encontramos toda a pan\u00f3plia de guerra, da Idade M\u00e9dia \u00e0 \u00e9poca contempor\u00e2nea: armaduras medievais, armas de fogo, avi\u00f5es, carros blindados contempor\u00e2neos, uniformes e penteados militares\u2026\r\nDesde 1 de maio de 2017, o Museu Real das For\u00e7as Armadas e da Hist\u00f3ria Militar pertence ao War Heritage Institute, a nova institui\u00e7\u00e3o de refer\u00eancia para o patrim\u00f3nio militar e a mem\u00f3ria na B\u00e9lgica.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"War Heritage Institute (Royal Military Museum)","address_street_name":"Parc du Cinquantenaire","address_street_number":"3","address_street_box":null,"email":"info@warheritage.be","website":"http:\/\/www.warheritage.be","phone_contact":"+ 32 (0)2 737 78 33","phone_booking":"+ 32 (0)2 737 78 33","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 3","address_line2":"1000 Bruxelles","description_web":"Here you\u2019ll find medieval armour and souvenirs from the Napoleonic campaigns, as well as a hundred or so aircraft and armoured vehicles from the two Great Wars. A breathtaking panoramic view awaits you at the top of the Arcade.\r\n\r\nSince May 1, 2017 the Royal Military Museum is part of the War Heritage Institute, the new reference institution for military heritage and remembrance in Belgium. \r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Mus\u00e9e Royal de l\u2019Arm\u00e9e (War Heritage Institute)","address_street_name":"Parc du Cinquantenaire","address_street_number":"3","address_street_box":null,"email":"info@warheritage.be","website":"http:\/\/www.warheritage.be","phone_contact":"+ 32 (0)2 737 78 33","phone_booking":"+ 32 (0)2 737 78 33","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Mus\u00e9e Royal de l\u2019Arm\u00e9e (War Heritage Institute)","address_street_name":"Parc du Cinquantenaire","address_street_number":"3","address_street_box":null,"email":"info@warheritage.be","website":"http:\/\/www.warheritage.be","phone_contact":"+ 32 (0)2 737 78 33","phone_booking":"+ 32 (0)2 737 78 33","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"fr":{"name":"War Heritage Institute (Mus\u00e9e Royal de l\u2019Arm\u00e9e)","address_street_name":"Parc du Cinquantenaire","address_street_number":"3","address_street_box":null,"email":"info@warheritage.be","website":"http:\/\/www.warheritage.be","phone_contact":"+ 32 (0)2 737 78 33","phone_booking":"+ 32 (0)2 737 78 33","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 3","address_line2":"1000 Bruxelles","description_web":"Plus de dix si\u00e8cles d\u2019histoire et de techniques militaires sont pass\u00e9s en revue dans ce mus\u00e9e. On y trouve toute la panoplie de guerre, du Moyen \u00c2ge \u00e0 l\u2019\u00e9poque contemporaine: armures m\u00e9di\u00e9vales, armes \u00e0 feu, avions, blind\u00e9s contemporains, uniformes et coiffures militaires\u2026\r\n\r\nDepuis le 1er mai 2017, le Mus\u00e9e royal de l\u2019Arm\u00e9e appartient au War Heritage Institute, la nouvelle institution de r\u00e9f\u00e9rence pour le patrimoine militaire et la m\u00e9moire en Belgique. \r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Museo Real de la Armada e Historia militar (War Heritage Institute)","address_street_name":"Parc du Cinquantenaire","address_street_number":"3","address_street_box":null,"email":"info@warheritage.be","website":"http:\/\/www.warheritage.be","phone_contact":"+ 32 (0)2 737 78 33","phone_booking":"+ 32 (0)2 737 78 33","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 3","address_line2":"1000 Bruxelles","description_web":"El museo posee alrededor de 100.000 objetos(armas, uniformes, maquetas, documentos...), siendo as\u00ed unos de los museos militares m\u00e1s grandes del mundo. Encontrar\u00e1s: una secci\u00f3n de armas y armaduras de la Edad Media, una preciosa colecci\u00f3n del Imperio franc\u00e9s, la Armada belga desde 1831 a 1914 con vitrinas dedicadas al rey Leopoldo l y Leopoldo ll, el desarrollo de la tecnolog\u00eda armament\u00edstica(hacia la mitad del s.XX), la Primera y Segunda Guerra Mundial(uniformes, materiales fotos y documentos), veh\u00edculos armados y barcos de guerra. La secci\u00f3n \"a\u00e9rea\" del museo ofrece una gama completa de aviones, alrededor de 80 son expuestos.\u00a1Y no te pierdas nuestros juegos educativos para todas las \u00e9pocas!. \r\n\r\nLos centros de documentaci\u00f3n est\u00e1n abiertos al p\u00fablico.\r\n\r\nEspectacular vista panor\u00e1mica de la ciudad desde la galer\u00eda.\r\n\r\nLas exposiciones temporales pueden ser de varios temas.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"War Heritage Institute (Koninklijk Legermuseum)","address_street_name":"Jubelpark","address_street_number":"3","address_street_box":null,"email":"info@warheritage.be","website":"http:\/\/www.warheritage.be","phone_contact":"+ 32 (0)2 737 78 33","phone_booking":"+ 32 (0)2 737 78 33","address_zip":"1000","address_city":"Bruxelles","address_line1":"Jubelpark, 3","address_line2":"1000 Bruxelles","description_web":"Meer dan tien eeuwen militaire geschiedenis passeren de revue in dit museum. Je krijgt er een overzicht van de ingrijpende veranderingen die door de jaren heen hebben plaatsgegrepen op het gebied van bewapening en militaire technologie, van de middeleeuwen tot op heden: wapens, harnassen, pantsers, vliegtuigen, uniformen, \u2026\r\n\r\nSinds 1 mei 2017 is het Koninklijk Legermuseum onderdeel van het War Heritage Institute, de nieuwe instelling voor militair erfgoed en herinnering in Belgi\u00eb. \r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[9],"translations":{"de":["Europ\u00e4isches Viertel"],"pt":[null],"en":["European Quarter"],"it":["Quartiere europeo"],"cn":[null],"fr":["Quartier europ\u00e9en"],"sp":["Barrio Europeo"],"nl":["Europese wijk"]}},"zones":{"list":[22],"translations":{"de":["Osten"],"pt":[null],"en":["East"],"it":["Est"],"cn":[null],"fr":["Est"],"sp":["Este"],"nl":["Oost"]}},"neca":null,"facebook_id":null,"backoffice_id":127,"location":{"lat":50.84086428,"lon":4.39335612},"region":"brussels","last_updated_at":"2023-04-13T11:45:06+02:00","published_at":"2013-10-19T01:13:18+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":555,"translations":{"de":{"name":"Mus\u00e9e Royal de l\u2019Arm\u00e9e (War Heritage Institute)","address_street_name":"Parc du Cinquantenaire","address_street_number":"3","address_street_box":null,"email":"info@warheritage.be","website":"http:\/\/www.warheritage.be","phone_contact":"+ 32 (0)2 737 78 33","phone_booking":"+ 32 (0)2 737 78 33","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},