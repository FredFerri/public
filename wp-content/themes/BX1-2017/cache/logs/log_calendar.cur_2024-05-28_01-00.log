1er octobre 2023 (un abonnement par cours bien d\u00e9fini). \n\nPour y participer, il faut \u00eatre membre de notre association moyennant une cotisation annuelle de 50 \u20ac par an (except\u00e9 pour les membres de Solidaris Brabant).\n\nSeniors Acad\u00e9mie organise des cours de sports dans diff\u00e9rentes communes de Bruxelles. Consultez le programme complet (yoga, gymnastique douce, aquagym, Qi Gong, Ta\u00efji Quan) dans notre brochure semestrielle l\u2019Echomutualiste Seniors ou sur le site de Solidaris brabant www.solidaris-brabant.be\/fr\/sacademie. \n\nVoici \u00e9galement nos conditions g\u00e9n\u00e9rales","performers":null,"boxoffice_url":null,"website":"http:\/\/www.solidaris-brabant.be\/fr\/sacademie","email":"sacademie.asbl@solidaris.be","phone_contact":"+32 2 546 14 94","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50003287"},"sp":{"name":"Aquagym \u00e0 Schaerbeek","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.solidaris-brabant.be\/fr\/sacademie","email":"sacademie.asbl@solidaris.be","phone_contact":"+32 2 546 14 94","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50003287"},"nl":{"name":"Aquagym \u00e0 Schaerbeek","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.solidaris-brabant.be\/fr\/sacademie","email":"sacademie.asbl@solidaris.be","phone_contact":"+32 2 546 14 94","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50003287"}},"place":{"last_updated_at":"2024-04-24T11:40:52+02:00","published_at":"2013-10-19T01:14:01+02:00","id":232510,"translations":{"de":{"name":"Neptunium - Schwimmbad in Schaarbeek","address_street_name":"Rue de J\u00e9rusalem","address_street_number":"56","address_street_box":null,"email":null,"website":"https:\/\/www.1030.be\/fr\/content\/piscine-neptunium","phone_contact":"+32 2