 guide in this rich Belgian beer culture by organising beer & brewery tours in Ghent, Brussels & Bruges. Their tours are hosted by local and passionate beer guides, given with a personal approach. That makes them so unique. You can join one of the weekly shared group tours, or ask for a private tour with a guaranteed customised beer selection and storytelling.    ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"BeerSecret","address_street_name":"Rue Antoine Dansaert","address_street_number":"188","address_street_box":null,"email":"liselot@creatiefcaura.com","website":"http:\/\/www.beersecret.com","phone_contact":"+32 472 60 47 46","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Antoine Dansaert, 188","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"BeerSecret","address_street_name":"Rue Antoine Dansaert","address_street_number":"188","address_street_box":null,"email":"liselot@creatiefcaura.com","website":"http:\/\/www.beersecret.com","phone_contact":"+32 472 60 47 46","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Antoine Dansaert, 188","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"BeerSecret","address_street_name":"Rue Antoine Dansaert","address_street_number":"188","address_street_box":null,"email":"liselot@creatiefcaura.com","website":"http:\/\/www.beersecret.com","phone_contact":"+32 472 60 47 46","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Antoine Dansaert, 188","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"