e,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":303151,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"theatre","ranking":1,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":49,"translations":{"de":"Theater","pt":null,"en":"Theatre","it":"Teatro","cn":null,"fr":"Th\u00e9\u00e2tre","sp":"Teatro","nl":"Theater"}},"others":{"list":[50],"translations":{"de":["Theater"],"pt":[null],"en":["Theatre"],"it":["Teatro"],"cn":[null],"fr":["Th\u00e9\u00e2tre"],"sp":["Teatro"],"nl":["Theater"]}}},"translations":{"de":{"name":"versailles | Sofia BETZ","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/theatre-martyrs.be\/spectacles\/versailles\/","email":"billetterie@theatre-martyrs.be","phone_contact":null,"phone_booking":"+32 2 223 32 08","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50011997"},"pt":{"name":"versailles | Sofia BETZ","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/theatre-martyrs.be\/spectacles\/versailles\/","email":"billetterie@theatre-martyrs.be","phone_contact":null,"phone_booking":"+32 2 223 32 08","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50011997"},"en":{"name":"Versailles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/theatre-martyrs.be\/spectacles\/versailles\/","email":"billetterie@theatre-martyrs.be","phone_contact":null,"phone_booking":"+32 2 223 32 08","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50011997"},"it":{"name":"versailles | Sofia BETZ","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/theatre-martyrs.be\/spectacles\/versailles\/","email":"billetterie@theatre-martyrs.be","phone_contact":null,"phone_booking":"+32 2 223 32 08","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50011997"},"cn":{"name":"versailles | Sofia BETZ","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/theatre-martyrs.be\/spectacles\/versailles\/","email":"billetterie@theatre-martyrs.be","phone_contact":null,"phone_booking":"+32 2 223 32 08","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50011997"},"fr":{"name":"Versailles","shortdescr":null,"longdescr":"Emmenez-les manger une frite plut\u00f4t que de les guillotiner.\nFran\u00e7ois Ruffin, d\u00e9put\u00e9 fran\u00e7ais\n\n\u00c7a va \u00eatre chaud, baroque et dor\u00e9, mais peut-\u00eatre pas comme escompt\u00e9\u2026 Ce soir \u00e0 Versailles, se d\u00e9roule une f\u00eate \u00e0 laquelle toute la jet-set est convi\u00e9e. Sous les coups de sifflet de la cheffe des domestiques et sous les plateaux charg\u00e9s de nourriture, cela court dans tous les sens. Le champagne coule \u00e0 flot et les musiciens ont lou\u00e9 des costumes d\u2019\u00e9poque pour l\u2019\u00ab authenticit\u00e9 \u00bb. Jusque-l\u00e0 rien de surprenant : surconsommation et privil\u00e8ges sont au rendez-vous. Mais les musiciens se voient refuser par le vigile l\u2019acc\u00e8s au ch\u00e2teau. Comble de l\u2019entre-soi et de l\u2019intimit\u00e9, on exige que les artistes baroques restent confin\u00e9s sur le parking, autour d\u2019un micro, et que la musique soit retransmise de la sorte au ch\u00e2teau. Et pour couronner le tout, celles qu\u2019on appelle les bonnes ne sont pas autoris\u00e9es \u00e0 abreuver les artistes assoiff\u00e9s. Car ce soir, il fait particuli\u00e8rement chaud pour la saison. B\u00e2tie sur les mar\u00e9cages, Versailles est moite, pr\u00eate \u00e0 vaciller. Personne ne remarque les gouttes d\u2019or qui s\u2019\u00e9crasent sur le sol du parking\u2026\n\nChangement climatique et parfum de r\u00e9volution dialoguent entrent eux dans ce semi-op\u00e9ra \u00e0 la fois loufoque et politique, pour le plus grand plaisir de nos sens, y compris le sens critique. \u00c7a va d\u00e9m\u00e9nager sur ce parking, car Sofia Betz a choisi de donner la parole aux coulisses de la f\u00eate, \u00e0 la pr\u00e9carit\u00e9 et \u00e0 la servitude. Et si l\u2019assembl\u00e9e de grands bourgeois pr\u00e9f\u00e8re finalement entendre Titanic plut\u00f4t que Charpentier, c\u2019est sans doute parce que Les Plaisirs de Versailles du compositeur baroque raille une classe sans cervelle et sans conscience du peuple qui gronde.\nEt si ce soir c\u2019\u00e9tait le Grand Soir ?","performers":"texte Sofia Betz\njeu Julie Calbete (musicienne, soprano), Marie-Laure Coenjaerts (musicienne, mezzo-soprano), Catherine Di Biaso (musicienne), Romain Dayez (musicien, baryton), Laurie Degand (actrice), H\u00e9lo\u00efse Jadoul (actrice), Julien Rombaux (acteur)\ncr\u00e9ation sonore Lionel Vancauwenberghe\ncharg\u00e9e de production M\u00e9lanie Dumoulin\nmise en sc\u00e8ne Sofia Betz","boxoffice_url":null,"website":"https:\/\/theatre-martyrs.be\/spectacles\/versailles\/","email":"billetterie@theatre-martyrs.be","phone_contact":null,"phone_booking":"+32 2 223 32 08","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50011997"},"sp":{"name":"versailles | Sofia BETZ","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/theatre-martyrs.be\/spectacles\/versailles\/","email":"billetterie@theatre-martyrs.be","phone_contact":null,"phone_booking":"+32 2 223 32 08","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50011997"},"nl":{"name":"Versailles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/theatre-martyrs.be\/spectacles\/versailles\/","email":"billetterie@theatre-martyrs.be","phone_contact":null,"phone_booking":"+32 2 223 32 08","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50011997"}},"place":{"id":231711,"translations":{"de":{"name":"Th\u00e9\u00e2tre des Martyrs","address_stree