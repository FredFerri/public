anking":0},"media":[{"type":"poster","link":"https:\/\/agendabrussels.imgix.net\/290a110c20a2fca42cc753bc5bdb95a29126b694.jpg","width":2000,"height":2000,"ratio":1,"translations":{"fr":{"title":"Expo Sub terra | Jeudi Follow me","copyright":null},"nl":{"title":"Expo Sub terra | Jeudi Follow me","copyright":null},"en":{"title":"Expo Sub terra | Jeudi Follow me","copyright":null},"de":{"title":"Expo Sub terra | Jeudi Follow me","copyright":null},"it":{"title":"Expo Sub terra | Jeudi Follow me","copyright":null},"sp":{"title":"Expo Sub terra | Jeudi Follow me","copyright":null},"pt":{"title":"Expo Sub terra | Jeudi Follow me","copyright":null},"cn":{"title":"Expo Sub terra | Jeudi Follow me","copyright":null}}},{"type":"poster","link":"https:\/\/agendabrussels.imgix.net\/4bfe532db4a151cbd072d192fd65294afa9be764.jpg","width":1500,"height":2118,"ratio":0.71,"translations":{"fr":{"title":"Expo Sub terra | Jeudi Follow me","copyright":null},"nl":{"title":"Expo Sub terra | Jeudi Follow me","copyright":null},"en":{"title":"Expo Sub terra | Jeudi Follow me","copyright":null},"de":{"title":"Expo Sub terra | Jeudi Follow me","copyright":null},"it":{"title":"Expo Sub terra | Jeudi Follow me","copyright":null},"sp":{"title":"Expo Sub terra | Jeudi Follow me","copyright":null},"pt":{"title":"Expo Sub terra | Jeudi Follow me","copyright":null},"cn":{"title":"Expo Sub terra | Jeudi Follow me","copyright":null}}}],"dates":[{"day":"2023-03-02","doors":null,"start":"12:30:00","end":"13:30:00"},{"day":"2023-03-09","doors":null,"start":"12:30:00","end":"13:30:00"},{"day":"2023-03-16","doors":null,"start":"12:30:00","end":"13:30:00"},{"day":"2023-03-23","doors":null,"start":"12:30:00","end":"13:30:00"},{"day":"2023-04-06","doors":null,"start":"12:30:00","end":"13:30:00"},{"day":"2023-04-13","doors":null,"start":"12:30:00","end":"13:30:00"},{"day":"2023-04-20","doors":null,"start":"12:30:00","end":"13:30:00"},{"day":"2023-04-27","doors":null,"start":"12:30:00","end":"13:30:00"},{"day":"2023-05-04","doors":null,"start":"12:30:00","end":"13:30:00"},{"day":"2023-05-11","doors":null,"start":"12:30:00","end":"13:30:00"}],"recurring":[{"day":"thursday","occurences":{"is_first":true,"is_second":true,"is_third":true,"is_fourth":true,"is_last":false},"time_start":"12:30:00","time_end":"13:30:00","translations":{"fr":"Ouvert les premier, deuxi\u00e8me, troisi\u00e8me et quatri\u00e8me jeudis du mois de 12:30 \u00e0 13:30","nl":"Open op de eerste, tweede, derde en vierde donderdags van de maand van 12:30 tot 13:30","en":"Open the first, second, third and fourth thursdays of the month from 12:30 to 13:30","de":"Open the first, second, third and fourth thursdays of the month from 12:30 to 13:30","it":"Open the first, second, third and fourth thursdays of the month from 12:30 to 13:30","sp":"Open the first, second, third and fourth thursdays of the month from 12:30 to 13:30","pt":"Open the first, second, third and fourth thursdays of the month from 12:30 to 13:30","cn":"Open the first, second, third and fourth thursdays of the month from 12:30 to 13:30"}}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-04-21T03:36:55+02:00","published_at":"2023-02-10T13:26:16+01:00","backoffice_id":271498,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.30571070873288},{"id":553802,"date_start":"2023-04-27","date_end":"2023-07-07","date_next":"2023-04-27","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung","it":"Esposizioni","sp":"Exhibici\u00f3n","pt":null,"cn":null}},"others":{"list":[36,39],"translations":{"fr":["Mus\u00e9es et art centers","Photographie"],"nl":["Musea en kunstcentra","Fotografie"],"en":["Museums and art centers","Photography"],"de":["Museen & Kunstzentren","Fotografie"],"it":["Musei e centri artistici","Fotografia"],"sp":["Museos y centros de arte","Fotograf\u00eda"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"R\u00e9publique d\u00e9mocratique du Cobalt \/ R\u00e9cit photographique de Brieuc Debontridder","shortdescr":"R\u00e9publique d\u00e9mocratique du Cobalt \/\r\nR\u00e9cit photographique de Brieuc Debontridder.","longdescr":"Du 27.04.2023 au 07.07.2023.\r\n\r\nPrix d\u2019entr\u00e9e  : 5 \u20ac \/ 4 \u20ac\r\n\r\nQue se passe-t-il lorsqu\u2019un village doit \u00eatre d\u00e9plac\u00e9 pour permettre \u00e0 une mine de s\u2019\u00e9tendre ? \u00c0 travers une approche narrative et photographique, R\u00e9publique d\u00e9mocratique du Cobalt raconte la r\u00e9installation d\u2019un village dans le sud du Congo et nous emm\u00e8ne \u00e0 la rencontre des communaut\u00e9s, des creuseurs artisanaux et des employ\u00e9s de la mine. Au fil du r\u00e9cit, Brieuc Debontridder questionne ce secteur controvers\u00e9 au sein duquel il a travaill\u00e9 sept ans : quels sont les impacts directs et indirects des entreprises mini\u00e8res sur les populations et l\u2019environnement ? Est-il possible de les att\u00e9nuer et de croire en un mod\u00e8le d\u2019extraction responsable ou n\u2019est-ce qu\u2019une mani\u00e8re d\u2019adoucir un syst\u00e8me profond\u00e9ment destructeur ? Cette exposition est en lien avec le r\u00e9cit documentaire R\u00e9publique d\u00e9mocratique du Cobalt, Academia, 2022. \r\nDes images et des passages nous plongent au c\u0153ur des paradoxes miniers du Congo.\r\n\r\nActivit\u00e9s :\r\nVernissage 27.04.2023  -  18h-21h.\r\nConcert 21.05.2023.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.charliermuseum.be","email":"info@charliermuseum.be","phone_contact":"+32 2 217 81 61","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.553802"},"nl":{"name":"Democratische Republiek Kobalt \/ Fotoverhaal door Brieuc Debontridder","shortdescr":"Democratische Republiek Kobalt \/ Fotoverhaal door Brieuc Debontridder","longdescr":"Van 27.04.2023 au 07.07.2023.\r\n\r\nIngang prijzen : 5 \u20ac \/ 4 \u20ac\r\n\r\nWat gebeurt er als een dorp moet worden verplaatst om een mijn uit te breiden? Via een verhalende en fotografische benadering vertelt Democratic Republic of Cobalt het verhaal van de hervestiging van een dorp in Zuid-Congo en neemt ons mee naar de gemeenschappen, de ambachtelijke mijnwerkers en de mijnwerkers. Doorheen het verhaal stelt Brieuc Debontridder vragen bij deze controversi\u00eble sector waarin hij zeven jaar werkte: wat zijn de directe en indirecte gevolgen van mijnbouwbedrijven voor de bevolking en het milieu? Is het mogelijk deze te verzachten en te geloven in een verantwoord winningsmodel of is het slechts een manier om een diep destructief systeem te verzachten? Deze tentoonstelling sluit aan bij het documentaire verhaal R\u00e9publique d\u00e9mocratique du Cobalt, Academia, 2022. \r\nBeelden en passages dompelen ons onder in het hart van de paradoxen van de mijnbouw in Congo.\r\n \r\nActiviteiten : \r\nVernissage 27.04.2023  -  18h-21u.\r\nConcert 21.05.2023.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.charliermuseum.be","email":"info@charliermuseum.be","phone_contact":"+32 2 217 81 61","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.553802"},"en":{"name":"R\u00e9publique d\u00e9mocratique du Cobalt \/ R\u00e9cit photographique de Brieuc Debontridder","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.charliermuseum.be","email":"info@charliermuseum.be","phone_contact":"+32 2 217 81 61","phone_booki