ha_id":"fc8ef272-e06f-41da-95b4-5ca115c1d9bc"},{"id":5700007784,"date_start":"2025-03-30","date_end":"2025-03-30","date_next":"2025-03-30","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2025-03-19T21:52:01+01:00","published_at":"2025-03-18T13:21:06+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":320218,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"festival","ranking":1.2599210498948732,"languages":{"spoken":["fr","en"],"subtitles":[]},"categories":{"main":{"id":118,"translations":{"de":"Festival","pt":null,"en":"Festival","it":"Festival","cn":null,"fr":"Festival","sp":"Festival","nl":"Festival"}},"others":{"list":[119],"translations":{"de":["Kino"],"pt":[null],"en":["Cinema  "],"it":["Cinema"],"cn":[null],"fr":["Cin\u00e9ma"],"sp":["Cine"],"nl":["Cinema"]}}},"translations":{"de":{"name":"MasterClass - Filmmakers' dialogue","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/www.visit.brussels\/de\/besucher\/veranstaltungskalender\/event-detail\/book-tickets.MasterClass-Filmmakers-dialogue.5700007784","website":"https:\/\/www.festivalmillenium.org","email":"contact@festivalmillenium.org","phone_contact":"+32 2 245 60 95","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700007784"},"pt":{"name":"MasterClass - Filmmakers' dialogue","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/www.visit.brussels\/en\/visitors\/agenda\/event-detail\/book-tickets.MasterClass-Filmmakers-dialogue.5700007784","website":"https:\/\/www.festivalmillenium.org","email":"contact@festivalmillenium.org","phone_contact":"+32 2 245 60 95","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700007784"},"en":{"name":"MasterClass - Filmmakers' dialogue","shortdescr":"MasterClass","longdescr":"The Professional Dialogues are a space for reflection and experimentation\u2014a true creative laboratory where directors challenge their ideas, explore their doubts, and refine their concepts. This exclusive setting allows them to question the creative process, examine character development, and rethink documentary storytelling through discussion and analysis.\n\nZabou Breitman and Florent Vassault, co-directors of Le Gar\u00e7on, will share their approach to creating a fictional character and directing actors within a documentary framework. How can a protagonist be brought to life while preserving cinematic authenticity?\n\nJen Debauche, director of L\u2019ANCRE, will offer an immersion into the depths of the human mind through a cinematic odyssey. She will discuss the unique experience of crafting a character portrayed by Charlotte Rampling and the use of formal innovation in documentary filmmaking.\n\nDavid Mikulan, director of KIX, will explore how to depict a character undergoing a negative transformation. How can such an evolution be filmed? What ethical and narrative implications arise from this choice?\n\nAn exchange supported by SABAM, to challenge the boundaries between fiction and reality and reimagine the documentary form.","performers":"Zabou Breitman and Florent Vassault co-directors of the film Le Gar\u00e7on\n\nJen Debauche director of the film L'Ancre\n\nDavid Mikulan director of the film KIX","boxoffice_url":"https:\/\/www.visit.brussels\/en\/visitors\/agenda\/event-detail\/book-tickets.MasterClass-Filmmakers-dialogue.5700007784","website":"https:\/\/www.festivalmillenium.org","email":"contact@festivalmillenium.org","phone_contact":"+32 2 245 60 95","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700007784"},"it":{"name":"MasterClass - Filmmakers' dialogue","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/www.visit.brussels\/it\/visitatori\/agenda\/event-detail\/book-tickets.MasterClass-Filmmakers-dialogue.5700007784","website":"https:\/\/www.festivalmillenium.org","email":"contact@festivalmillenium.org","phone_contact":"+32 2 245 60 95","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700007784"},"cn":{"name":"MasterClass - Filmmakers' dialogue","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/www.visit.brussels\/en\/visitors\/agenda\/event-detail\/book-tickets.MasterClass-Filmmakers-dialogue.5700007784","website":"https:\/\/www.festivalmillenium.org","email":"contact@festivalmillenium.org","phone_contact":"+32 2 245 60 95","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700007784"},"fr":{"name":"MasterClass - Dialogue de cin\u00e9astes","shortdescr":"MasterClass ","longdescr":"Les Dialogues professionnels sont un espace privil\u00e9gi\u00e9 de r\u00e9flexion et d\u2019exp\u00e9rimentation, un v\u00e9ritable laboratoire o\u00f9 les r\u00e9alisateurs confrontent leurs id\u00e9es, explorent leurs doutes et affinent leurs concepts. Ce cadre unique leur permet de questionner le processus cr\u00e9atif, d\u2019interroger la construction des personnages et de repenser l\u2019\u00e9criture documentaire \u00e0 travers l\u2019\u00e9change et l\u2019analyse.\n\nZabou Breitman et Florent Vassault, co-r\u00e9alisateurs du film Le Gar\u00e7on, partageront leur approche de la cr\u00e9ation d\u2019un personnage fictif et de la direction des acteurs dans une dynamique propre au documentaire. Comment donner vie \u00e0 un protagoniste tout en pr\u00e9servant une v\u00e9rit\u00e9 cin\u00e9matographique ?\n\nJen Debauche, r\u00e9alisatrice de L\u2019ANCRE, proposera une immersion dans les profondeurs de l\u2019esprit humain \u00e0 travers une odyss\u00e9e cin\u00e9matographique. Son intervention reviendra sur l\u2019exp\u00e9rience unique de la cr\u00e9ation d\u2019un personnage interpr\u00e9t\u00e9 par Charlotte Rampling, et sur l\u2019innovation formelle au service du documentaire.\n\nDavid Mikulan, r\u00e9alisateur de KIX, questionnera la repr\u00e9sentation d\u2019un personnage dont l\u2019\u00e9volution suit une trajectoire n\u00e9gative. Comment filmer cette transformation ? Quelles sont les implications \u00e9thiques et narratives d\u2019un tel choix ?\n\nUn moment d\u2019\u00e9change soutenu par la SABAM, pour interroger les fronti\u00e8res entre fiction et r\u00e9alit\u00e9 et r\u00e9inventer les formes du documentaire contemporain.","performers":"Zabou Breitman et Florent Vassault co-r\u00e9alisateurs du film Le Gar\u00e7on\n\nJen Debauche r\u00e9alisatrice du film L'Ancre\n\nDavid Mikulan r\u00e9alisateur du film KIX\n\n","boxoffice_url":"https:\/\/www.visit.brussels\/fr\/visiteurs\/agenda\/event-detail\/book-tickets.MasterClass-Dialogue-de-cineastes.5700007784","website":"https:\/\/www.festivalmillenium.org","email":"contact@festivalmillenium.org","phone_contact":"+32 2 245 60 95","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700007784"},"sp":{"name":"MasterClass - Filmmakers' dialogue","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/www.visit.brussels\/es\/visitantes\/agenda\/event-detail\/book-tickets.MasterClass-Filmmakers-dialogue.5700007784","website":"https:\/\/www.festivalmillenium.org","email":"contact@festivalmillenium.org","phone_contact":"+32 2 245 60 95","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700007784"},"nl":{"name":"MasterClass - Filmmakers' dialogue","shortdescr":"MasterClass","longdescr":"The Professional Dialogues are a space for reflection and experimentation\u2014a true creative laboratory where directors challenge their ideas, explore their doubts, and refine their concepts. This exclusive setting allows them to question the creative process, examine character development, and rethink documentary storytelling through discussion and analysis.\n\nZabou Breitman and Florent Vassault, co-directors of Le Gar\u00e7on, will share their approach to creating a fictional character and directing actors within a documentary framework. How can a protagonist be brought to life while preserving cinematic authenticity?\n\nJen Debauche, director of L\u2019ANCRE, will offer an immersion into the depths of the human mind through a cinematic odyssey. She will discuss the unique experience of crafting a character portrayed by Charlotte Rampling and the use of formal innovation in documentary filmmaking.\n\nDavid Mikulan, director of KIX, will explore how to depict a character undergoing a negative transformation. How can such an evolution be filmed? What ethical and narrative implications arise from this choice?\n\nAn exchange supported by SABAM, to challenge the boundaries between fiction and reality and reimagine the documentary form.","performers":"Zabou Breitman en Florent Vassault co-regisseurs van de film Le Gar\u00e7on\n\nJen Debauche regisseur van de film L'Ancre\n\nDavid Mikulan regisseur van de film KIX","boxoffice_url":"https:\/\/www.visit.brussels\/nl\/bezoekers\/agenda\/event-detail\/book-tickets.MasterClass-Filmmakers-dialogue.5700007784","website":"https:\/\/www.festivalmillenium.org","email":"contact@festivalmillenium.org","phone_contact":"+32 2 245 60 95","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700007784"}},"place":{"id":235577,"translations":{"de":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+ 32 (0)2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"Das Architekturzentrum CIVA, das 2016 auf Betreiben der Region Br\u00fcssel-Hauptstadt ins Leben gerufen wurde, vereint in einer einzigen Struktur Ressourcen, Wissen und Know-how verschiedener Br\u00fcsseler Vereine aus dem Bereich Kultur, Architektur, St\u00e4dteplanung, Landschaftsarchitektur und Forschungen zum \u00d6kosystem: die Archive f\u00fcr moderne Architektur, die Bibliothek Ren\u00e9 Pech\u00e8re, der Architekturfonds und das Centre Paul Duvigneaud.\r\nMit ihrem kulturellen Projekt tr\u00e4gt die Fondation CIA zur Entwicklung einer architektonischen, landschaftsarchitektonischen und st\u00e4dteplanerischen Kultur bei, die sich mit den Herausforderungen der Gegenwart auseinandersetzt. Schwerpunkt ist Br\u00fcssel. \r\n\r\nDie Fondation CIVA bietet eine ganze Reihe von Aktivit\u00e4ten und Angeboten: Ausstellungen, Konferenzen, Orte des Austauschs und der Debatten, p\u00e4dagogische Aktivit\u00e4ten, Archiveinblicke und Bibliotheken mit knapp 40.000 Werken und Zeitschriften zu den Themen Architektur, St\u00e4dteplanung, Stadtgeschichte, Landschaften, G\u00e4rten und urbane \u00d6kosysteme.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+ 32 (0)2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+ 32 (0)2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"CIVA is a museum, an archive center, a library and a meeting place for lovers of architecture, landscape architecture, urban ecosystems and history in Brussels. Throughout the year, CIVA organizes temporary exhibitions, lectures, debates, guided tours, book launches and activities for children. The activities are organized in Ixelles, near Place Flagey and in the center of Brussels, in KANAL - Centre Pompidou.","description_print":null,"booking_url":null,"sort_order":"CIVA","virtual_visit":null,"visit_url":null},"it":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+ 32 (0)2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+ 32 (0)2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+ 32 (0)2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"CIVA est un muse\u0301e, un centre d'archives, une bibliothe\u0300que et un lieu de rencontre pour les amateurs d'architecture, d'architecture paysage\u0300re, d'e\u0301cosyste\u0300mes urbains et d'histoire a\u0300 Bruxelles. Tout au long de l'anne\u0301e, vous pouvez vous y rendre pour des expositions temporaires, des confe\u0301rences, des de\u0301bats, des visites guide\u0301es, des lancements de livres et des activite\u0301s pour les enfants. Les activite\u0301s se trouvent a\u0300 Ixelles, pre\u0300s de la Place Flagey et au centre de Bruxelles, a\u0300 KANAL - Centre Pompidou.\r\n\r\n","description_print":null,"booking_url":null,"sort_order":"CIVA","virtual_visit":null,"visit_url":null},"sp":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+ 32 (0)2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"Creado en 2016 por iniciativa de la Regi\u00f3n Bruselas-Capital, el CIVA re\u00fane una \u00fanica estructura de recursos, conocimiento y aprendizaje de varias asociaciones culturales activas en Bruselas en los campos de la arquitectura, urbanismo, paisajes y el estudio de ecosistemas: los Archivos de Arquitectura Moderna, la Biblioteca Ren\u00e9 Pech\u00e8re, los Fondos para la arquitectura, el Centro Paul Duvigneaud y el CIVA asbl, ahora disuelto.\r\nA trav\u00e9s de este proyecto cultural, la Fundaci\u00f3n CIVA contribuye al desarrollo del paisaje arquitect\u00f3nico y la cultura urbana como base para afrontar desaf\u00edos contempor\u00e1neos, poniendo especial \u00e9nfasis en Bruselas.\r\nSiempre tiene \u00e9xito a la hora de cumplir sus objetivos y tratar con un p\u00fablico amplio (adultos y ni\u00f1os, estudiantes, investigadores, arquitectos, paisajistas, amantes de la naturaleza, pol\u00edticos, etc), la fundaci\u00f3n CIVA organiza numerosos eventos y actividades en diferentes lugares, incluyendo exhibiciones permanentes y temporales, conferencias, debates y actividades educativas. Tambi\u00e9n dispone archivos excepcionales abiertos para todos los p\u00fablicos (documentos de arquitectos y paisajistas: planos, bocetos, modelos, muebles, etc.) y librer\u00edas que contienen casi 40.000 obras y peri\u00f3dicos de arquitectura, urbanismo, la historia de los pueblos y ciudades, paisajes, jardines y ecolog\u00eda urbana.\r\nEstas actividades y materiales est\u00e1n dise\u00f1ados para despertar la curiosidad y el inter\u00e9s de todo nuestro entorno, ya sea un hecho hist\u00f3rico o una construcci\u00f3n.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"CIVA","address_street_name":"Kluisstraat","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+ 32 (0)2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"Kluisstraat","address_line2":"1050 Elsene","description_web":"CIVA is een museum, een archiefcentrum, een bibliotheek en een ontmoetingsplek voor liefhebbers van architectuur, landschapsarchitectuur, stadsecosystemen en geschiedenis in Brussel. Het hele jaar door kan je er terecht voor tijdelijke tentoonstellingen, lezingen, debatten, rondleidingen, book launches en kinderactiviteiten. De activiteiten vind je in Elsene, vlakbij het Flageyplein en in Brussel-centrum, in KANAL \u2013 Centre Pompidou.","description_print":null,"booking_url":null,"sort_order":"CIVA","virtual_visit":null,"visit_url":null}},"districts":{"list":[5],"translations":{"de":["Flagey"],"pt":[null],"en":["Flagey"],"it":["Flagey"],"cn":[null],"fr":["Flagey"],"sp":["Flagey"],"nl":["Flagey"]}},"zones":{"list":[21],"tr