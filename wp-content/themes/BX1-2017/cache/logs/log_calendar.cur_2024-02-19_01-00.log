ieuse convivialit\u00e9 gr\u00e2ce aux savoureusement ringards personnages de pr\u00e9sentateurs de Bingo.\n\nSi \"Bingo kids\" est un spectacle pour enfants, les adultes ne sont pas en reste puisque, comme dans un dessin anim\u00e9 Pixar, les com\u00e9diens prennent soin de cr\u00e9er une double lecture pour que tout le monde passe un excellent moment.\n\nSpectacle pour enfants de 7 \u00e0 12 ans","performers":"La Compgnie Tadam","boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Bingo-Kids","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50000036"},"sp":{"name":"Bingo kids","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Bingo-Kids","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50000036"},"nl":{"name":"Bingo kids","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Bingo-Kids","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50000036"}},"place":{"id":270611,"translations":{"de":{"name":"Th\u00e9\u00e2tre l\u2019Improviste ","address_street_name":"Rue de Fierlant","address_street_number":"120","address_street_box":null,"email":null,"website":"http:\/\/www.improviste.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Rue de Fierlant, 120","address_line2":"1190 Forest","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Th\u00e9\u00e2tre L'improviste","address_street_name":"Rue de Fierlant","address_street_number":"120","address_street_box":null,"email":null,"website":"http:\/\/www.improviste.be\/","