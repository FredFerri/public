 biblioth\u00e8que, un lieu d'information et de rencontres. Laissez-vous inspirer par des livres, des histoires et des rencontres adapt\u00e9es \u00e0 la capitale. Apprenez tout sur le travail, les \u00e9tudes, et la vie \u00e0 Bruxelles et en Flandre. D\u00e9couvrez la richesse de l' offre culturelle n\u00e9erlandophone des organisations bruxelloises et flamandes.  ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Muntpunt","address_street_name":"Place de la Monnaie","address_street_number":"6","address_street_box":null,"email":"info@muntpunt.be","website":"http:\/\/www.muntpunt.be","phone_contact":"+32 2 278 11 11","phone_booking":"+32 2 278 11 11","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Monnaie, 6","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Muntpunt ","address_street_name":"Muntplein","address_street_number":"6","address_street_box":null,"email":"info@muntpunt.be","website":"http:\/\/www.muntpunt.be","phone_contact":"+32 2 278 11 11","phone_booking":"+32 2 278 11 11","address_zip":"1000","address_city":"Brussel","address_line1":"Muntplein, 6","address_line2":"1000 Brussel","description_web":"Muntpunt is een bibliotheek, informatiehuis, ontmoetingsplek en je venster op Brussel. Laat je inspireren door boeken, verhalen en ontmoetingen op maat van de hoofdstad. Kom meer te weten over wonen, werken, studeren, leven en beleven in Brussel en Vlaanderen. Ontdek het rijke Nederlandstalige culturele en vrijetijdsaanbod van Brusselse en Vlaamse organisaties.\r\n\r\nIn Muntpunt kan je meer dan alleen boeken, cd\u2019s en dvd\u2019s ontlenen. Je kan er ook terecht voor activiteiten, taalcursussen, infosessies, luisterboeken, strips, spelletjes, en nog veel meer. Er valt bijna dagelijks iets te beleven in Muntpunt, van voorlezen tot documentaires, van infosessies tot rondleidingen, voor jong en oud. De activiteiten sluiten aan bij de bibliotheekwerking of spelen in op actuele thema's, steeds met de Brusselse hoofdstedelijke context in het achterhoofd. De rode draad door de programmatie is de samenwerking met Vlaamse en Brusselse partnerorganisaties. \r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":13020,"location":{"lat":50.84996484,"lon":4.35348679},"last_updated_at":"2022-11-03T17:13:45+01:00","published_at":"2013-10-19T01:35:36+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/1721446874905-muntpunt-d8bf972bebd01d6ea0fbc7c545959890b3609b5c.jpg","width":2000,"height":1500,"ratio":1.33,"oEmbed_height":1500,"oEmbed_width":2000,"translations":{"de":{"title":"Muntpunt Schaakclub","copyright":null},"pt":{"title":"Muntpunt Schaakclub","copyright":null},"en":{"title":"Muntpunt Schaakclub","copyright":null},"it":{"title":"Muntpunt Schaakclub","copyright":null},"cn":{"title":"Muntpunt Schaakclub","copyright":null},"fr":{"title":"Muntpunt Schaakclub","copyright":null},"sp":{"title":"Muntpunt Schaakclub","copyright":null},"nl":{"title":"Muntpunt Schaakclub","copyright":null}}}],"dates":[{"day":"2024-08-28","doors":null,"start":"15:00:00","end":"18:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"de":{"name":"Normal"},"en":{"name":"Normal"},"it":{"name":"Normale"},"fr":{"name":"Normal"},"sp":{"name":"Normal"},"nl":{"name":"Normaal"}},"value":0}],"date_exceptions":[],"closing_days":[],"child_events":[],"parent_events":[],"accessibilities":[],"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[]},{"id":50009432,"date_start":"2024-06-07","date_end":"2024-08-31","date_next":"2024-08-28","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-08-25T02:00:45+02:00","published_at":"2024-04-09T12:26:46+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":298103,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.35962828892923354,"languages":{"spoken":["nl","fr","en"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[45,36],"translations":{"de":["Mode","Museen & Kunstzentren"],"pt":[null,null],"en":["Fashion","Museums and art centers"],"it":["Moda","Musei e centri artistici"],"cn":[null,null],"fr":["Mode","Mus\u00e9es et art centers"],"sp":["Moda","Museos y centros de arte"],"nl":["Mode","Musea en kunstcentra"]}}},"translations":{"de":{"name":"Fashion Moves","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/mad.brussels\/en\/agenda\/fashion-moves","email":"contact@mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50009432"},"pt":{"name":"Fashion Moves","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/mad.brussels\/en\/agenda\/fashion-moves","email":"contact@mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50009432"},"en":{"name":"Fashion Moves","shortdescr":"Things are moving this summer at MAD Brussels. With Fashion Moves, the Centre for Fashion and Design presents a fascinating exhibition on the multifaceted relationship between fashion and dance.","longdescr":"What does movement do to a piece of clothing? How does the fashion designer adapt to the demands of dance costume? To what extent do fashion and dance inspire each other? Dance and movement have always influenced fashion. For the exhibition Fashion Moves, MAD Brussels explores the interaction between the two worlds. From breathtaking creations dedicated to the stage to the latest trends emerging through social media, especially the influence of ballet and techno, or creations inspired by clubs and nightlife. Numerous creations and trends are reviewed in four different chapters.\n\nThe exhibition features the work of many renowned names such as Raf Simons, Glenn Martens, Marine Serre and Walter Van Beirendonck as well as emerging talents like Igor Dieryck, Marie Vandewiele, Stefan Kartchev, Jordy Arthur and many more.\n\nAN EXHIBITION WITH\nAlphonse Maitrepierre, Audrey Large, Billion Avenue, Bobby Jewels, Christophe Coppens, Clara Besnard, Cleo Chrome, Dries Van Noten, Eunji Oh, Falke, Flora Miranda, Florentina Leitner, Glenn Martens & Diesel, Igor Dieryck, Iris Van Herpen, Isabelle Lhoas, Jasmien Van Loo, Jean-Paul Lespagnard, Jeanne Friot, Jennifer Defays, Jordy Arthur, Komono, L\u0112O Official, Lila and John, Margiela for Reebok, Marie Vandewielde, Marine Serre, Mats Rombaut, Maxime Mathieu, Pieter Mulier, Raf Simons for Adidas, Riccardo Tisci, Romain Bichot, Salom\u00e9 Poloudenny, Sander Boss, Sarah De Geyter, Sarah Makharine, Sarah Mayer, Saul Nash, Skin Series, Stefan Kartchev, Stephanie D\u2019Heygere, Studio Elementaires, Theophile Blandet, Tuna Mess, Walter Van Beirondonck, Y\/Project for Fila, Yamuna Forzani, Yuma Labs \u2026 and the instititutions, artists and dance companies: La Monnaie \/ De Munt, (La) Horde, Ultima Vez, MEROL, Pierre Droulers, Rosas, Sidi Larbi Cherkaoui, Damien Jallet, Op\u00e9ra de Paris, Grand Th\u00e9\u00e2tre de Gen\u00e8ve, Ballet National de Marseille, Mette Ingvarsten, Arno Ferrera, Gilles Polet, Richard Siegal.\n\nThis exhibition was created with the support of the National Lottery. Thanks to the players of the National Lottery and the National Lottery.","performers":null,"boxoffice_url":null,"website":"https:\/\/mad.brussels\/en\/agenda\/fashion-moves","email":"contact@mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50009432"},"it":{"name":"Fashion Moves","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/mad.brussels\/en\/agenda\/fashion-moves","email":"contact@mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50009432"},"cn":{"name":"Fashion Moves","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/mad.brussels\/en\/agenda\/fashion-moves","email":"contact@mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50009432"},"fr":{"name":"Fashion Moves","shortdescr":"Les choses bougent cet \u00e9t\u00e9 au MAD Brussels. Avec Fashion Moves une exposition fascinante qui r\u00e9v\u00e8le les multiples facettes de la relation entre la mode et la danse.","longdescr":"Quelle est l'influence du mouvement sur un v\u00eatement ? Comment le\/la cr\u00e9ateurice de mode s'adapte-t-il\/elle aux exigences du costume de sc\u00e8ne? Dans quelle mesure la mode et la danse s'inspirent-elles mutuellement ? La danse et le mouvement ont toujours influenc\u00e9 la mode. Pour l'exposition Fashion Moves, MAD Brussels explore l'interaction entre ces deux mondes. Des cr\u00e9ations \u00e9poustouflantes d\u00e9di\u00e9es \u00e0 la sc\u00e8ne aux derni\u00e8res tendances \u00e9mergentes des r\u00e9seaux sociaux, en particulier l'influence du ballet et de la techno, ou des cr\u00e9ations inspir\u00e9es par les clubs et la vie nocturne. De nombreuses cr\u00e9ations et tendances sont pass\u00e9es en revue dans quatre chapitres diff\u00e9rents.\n\nL'exposition pr\u00e9sente le travail de grands noms tels que Raf Simons, Glenn Martens, Marine Serre et Walter Van Beirendonck, ainsi que des talents \u00e9mergents comme Igor Dieryck, Marie Vandewiele, Stefan Kartchev, Jordy Arthur et beaucoup d'autres.\n\nUNE EXPOSITION AVEC\nAlphonse Maitrepierre, Audrey Large, Billion Avenue, Bobby Jewels, Christophe Coppens, Clara Besnard, Cleo Chrome, Dries Van Noten, Eunji Oh, Falke, Flora Miranda, Florentina Leitner, Glenn Martens & Diesel, Igor Dieryck, Iris Van Herpen, Isabelle Lhoas, Jasmien Van Loo, Jean-Paul Lespagnard, Jeanne Friot, Jennifer Defays, Jordy Arthur, Komono, L\u0112O Official, Lila and John, Margiela for Reebok, Marie Vandewielde, Marine Serre, Mats Rombaut, Maxime Mathieu, Pieter Mulier, Raf Simons for Adidas, Riccardo Tisci, Romain Bichot, Salom\u00e9 Poloudenny, Sander Boss, Sarah De Geyter, Sarah Makharine, Sarah Mayer, Saul Nash, Skin Series, Stefan Kartchev, Stephanie D\u2019Heygere, Studio Elementaires, Theophile Blandet, Tuna Mess, Walter Van Beirondonck, Y\/Project for Fila, Yamuna Forzani, Yuma Labs \u2026 et les institutions, artistes et compagnies de danse: La Monnaie \/ De Munt, (La) Horde, Ultima Vez, MEROL, Pierre Droulers, Rosas, Sidi Larbi Cherkaoui, Damien Jallet, Op\u00e9ra de Paris, Grand Th\u00e9\u00e2tre de Gen\u00e8ve, Ballet National de Marseille, Mette Ingvarsten, Arno Ferrera, Gilles Polet, Richard Siegal.\n\nCette exposition a \u00e9t\u00e9 r\u00e9alis\u00e9e avec le soutien de La Loterie Nationale. MAD Brussels remercie les joueurs de la Loterie Nationale et la Loterie Nationale.\n\n","performers":null,"boxoffice_url":null,"website":"https:\/\/mad.brussels\/en\/agenda\/fashion-moves","email":"contact@mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50009432"},"sp":{"name":"Fashion Moves","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/mad.brussels\/en\/agenda\/fashion-moves","email":"contact@mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50009432"},"nl":{"name":"Fashion Moves","shortdescr":"Er beweegt wat deze zomer bij MAD Brussels. Het Centrum voor Mode en Design brengt met Fashion Moves een boeiende tentoonstelling over de veelzijdige relatie tussen mode en dans.","longdescr":"Wat doet beweging met een kledingstuk? Hoe past de modeontwerper zich aan aan de eisen van een danskostuum? In welke mate inspireren mode en dans elkaar? Dans en beweging hebben altijd al een invloed gehad op de mode. Voor de tentoonstelling Fashion Moves gaat MAD Brussels op zoek naar de interactie tussen beide werelden. Van adembenemende creaties gewijd aan de scene tot de nieuwste trends die ontstaan via social media, met name de invloed van ballet en techno, of creaties ge\u00efnspireerd door de clubs en het nachtleven. In vier verschillende hoofdstukken passeren tal van creaties en trends de revue.\n\nDe tentoonstelling toont het werk van vele bekende namen zoals Raf Simons, Glenn Martens, Marine Serre en Walter Van Beirendonck, maar ook opkomend talent zoals Igor Dieryck, Marie Vandewiele, Stefan Kartchev, Jordy Arthur en vele anderen.\n\nEEN TENTOONSTELLING MET\nAlphonse Maitrepierre, Audrey Large, Billion Avenue, Bobby Jewels, Christophe Coppens, Clara Besnard, Cleo Chrome, Dries Van Noten, Eunji Oh, Falke, Flora Miranda, Florentina Leitner, Glenn Martens & Diesel, Igor Dieryck, Iris Van Herpen, Isabelle Lhoas, Jasmien Van Loo, Jean-Paul Lespagnard, Jeanne Friot, Jennifer Defays, Jordy Arthur, Komono, L\u0112O Official, Lila and John, Margiela for Reebok, Marie Vandewielde, Marine Serre, Mats Rombaut, Maxime Mathieu, Pieter Mulier, Raf Simons for Adidas, Riccardo Tisci, Romain Bichot, Salom\u00e9 Poloudenny, Sander Boss, Sarah De Geyter, Sarah Makharine, Sarah Mayer, Saul Nash, Skin Series, Stefan Kartchev, Stephanie D\u2019Heygere, Studio Elementaires, Theophile Blandet, Tuna Mess, Walter Van Beirondonck, Y\/Project for Fila, Yamuna Forzani, Yuma Labs \u2026 en de instituten, kunstenaars en dansgezelschappen: La Monnaie \/ De Munt, (La) Horde, Ultima Vez, MEROL, Pierre Droulers, Rosas, Sidi Larbi Cherkaoui, Damien Jallet, Op\u00e9ra de Paris, Grand Th\u00e9\u00e2tre de Gen\u00e8ve, Ballet National de Marseille, Mette Ingvarsten, Arno Ferrera, Gilles Polet, Richard Siegal.\n\nDeze tentoonstelling kwam tot stand met de steun van de Nationale Loterij. MAD Brussels bedankt de spelers van de Nationale Loterij en de Nationale Loterij.","performers":null,"boxoffice_url":null,"website":"https:\/\/mad.brussels\/en\/agenda\/fashion-moves","email":"contact@mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50009432"}},"place":{"id":250516,"translations":{"de":{"name":"MAD Brussels","address_street_name":"Place du Nouveau March\u00e9 aux Grains","address_street_number":"10","address_street_box":null,"email":"contact@mad.brussels","website":"http:\/\/www.mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":"+32 2 880 85 62","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place du Nouveau March\u00e9 aux Grains, 10","address_line2":"1000 Bruxelles","description_web":"MAD Brussels ist eine Br\u00fcsseler Mode- und Designplattform, die sich der F\u00f6rderung, Unterst\u00fctzung und Begleitung der Br\u00fcsseler Modesch\u00f6pfer und Designern verschrieben hat, um sowohl landesweit als auch international ihre Reichweite zu erh\u00f6hen.\r\n\r\nDie Er\u00f6ffnung des neuen, komplett in Wei\u00df gehaltenen Geb\u00e4udes hat dem MAD Brussels noch einmal frischen Wind in den Segeln beschert. Hier befinden sich nicht nur Ressourcen f\u00fcr Vertreter der Kreativindustrie und damit zusammenh\u00e4ngenden Metiers, sondern auch vielf\u00e4ltig nutzbare Arbeitspl\u00e4tze und Orte der Begegnung. Modesch\u00f6pfer und Designer haben hier eine Anlaufstelle, gleichzeitig finden in den R\u00e4umen Ateliers, Workshops, Seminare, Ausstellungen, Modeschauen, Kunst-Performances statt\u2026\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"MAD Brussels","address_street_name":"Place du Nouveau March\u00e9 aux Grains","address_street_number":"10","address_street_box":null,"email":"contact@mad.brussels","website":"http:\/\/www.mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":"+32 2 880 85 62","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place du Nouveau March\u00e9 aux Grains, 10","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"MAD Brussels","address_street_name":"Nieuwe Graanmarkt","address_street_number":"10","address_street_box":null,"email":"contact@mad.brussels","website":"http:\/\/www.mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":"+32 2 880 85 62","address_zip":"1000","address_city":"Brussels","address_line1":"Nieuwe Graanmarkt, 10","address_line2":"1000 Brussels","description_web":"MAD Brussels is a Brussels\u2019 platform for gathering expertise from the city\u2019s Fashion and Design sectors. It aims to help with the promotion and development of Brussels stylists and designers and improve their exposure nationally and abroad.\r\n\r\nThe opening in April 2017 of their brand new, sparkling white headquarters marked something of a renaissance for the non-profit organisation, which can now multiply and combine its campaigns. It houses a ressource centre for professionals of the creative industries and related sectors, along with adaptable workspaces, meeting spaces, workshops, seminar rooms and a large space dedicated to public activities where multiple events are organised every year: exhibitions, fashion shows, artistic performances\u2026\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"MAD Brussels","address_street_name":"Place du Nouveau March\u00e9 aux Grains","address_street_number":"10","address_street_box":null,"email":"contact@mad.brussels","website":"http:\/\/www.mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":"+32 2 880 85 62","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place du Nouveau March\u00e9 aux Grains, 10","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"MAD Brussels","address_street_name":"Place du Nouveau March\u00e9 aux Grains","address_street_number":"10","address_street_box":null,"email":"contact@mad.brussels","website":"http:\/\/www.mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":"+32 2 880 85 62","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place du Nouveau March\u00e9 aux Grains, 10","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"MAD Brussels","address_street_name":"Place du Nouveau March\u00e9 aux Grains","address_street_number":"10","address_street_box":null,"email":"contact@mad.brussels","website":"http:\/\/www.mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":"+32 2 880 85 62","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place du Nouveau March\u00e9 aux Grains, 10","address_line2":"1000 Bruxelles","description_web":"MAD Brussels est la plateforme bruxelloise d\u2019expertise dans les secteurs de la Mode et du Design.   Elle s\u2019emploie \u00e0 renforcer la promotion, \u00e0 accompagner le d\u00e9veloppement des stylistes et designers bruxellois et \u00e0 accro\u00eetre leur rayonnement (inter )national.  \r\n\r\nL\u2019ouverture en avril 2017 du nouveau b\u00e2timent enti\u00e8rement blanc a marqu\u00e9 une renaissance pour l\u2019asbl, qui dans ce lieu unique multiplie et combine ses actions. Il h\u00e9berge le centre de ressources pour les professionnels des industries cr\u00e9atives aux fili\u00e8res de m\u00e9tiers d\u00e9riv\u00e9es, des espaces de travail polyvalents, lieux de rencontres, d\u2019accueil de cr\u00e9ateurs, d\u2019ateliers, de s\u00e9minaires, ainsi qu\u2019un grand espace d\u00e9di\u00e9 aux activit\u00e9s publiques o\u00f9 sont organis\u00e9es chaque ann\u00e9e de multiples \u00e9v\u00e8nements: expositions, d\u00e9fil\u00e9s, performances artistiques,\u2026\r\n\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"MAD Brussels","address_street_name":"Place du Nouveau March\u00e9 aux Grains","address_street_number":"10","address_street_box":null,"email":"contact@mad.brussels","website":"http:\/\/www.mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":"+32 2 880 85 62","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place du Nouveau March\u00e9 aux Grains, 10","address_line2":"1000 Bruxelles","description_web":"MAD Brussels es una plataforma de Bruselas que reune expertos del los sectores de la moda y el dise\u00f1o. Tiene como objetivo ayudar en la promoci\u00f3n y el desarrollo de los dise\u00f1adores y estilistas de Bruselas y mejorar su imagen nacional e internacional.\r\nLa apertura de su novedosa y chispeante sede en abril de 2017 marc\u00f3 algo as\u00ed como el renacimiento para la organizaci\u00f3n sin \u00e1nimo de lucro, que ahora puede multiplicar y combinar sus campa\u00f1as. Posee un centro de recursos para profesionales de industrias culturales y sectores relacionados, junto con espacios de trabajo adaptados, lugares de reuni\u00f3n, talleres, seminarios y un gran espacio dedicado a actividades p\u00fablicas donde se organizan diversos eventos cada a\u00f1o: exhibiciones, desfiles de moda, representaciones art\u00edsticas\u2026\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"MAD Brussels","address_street_name":"Nieuwe Graanmarkt","address_street_number":"10","address_street_box":null,"email":"contact@mad.brussels","website":"http:\/\/www.mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":"+32 2 880 85 62","address_zip":"1000","address_city":"Brussel","address_line1":"Nieuwe Graanmarkt, 10","address_line2":"1000 Brussel","description_web":"MAD Brussels is het Brussels kennisplatform voor de mode- en designsectoren.  Het zet zich in voor de promotie en begeleiding van Brusselse stylisten en ontwerpers en de vergroting van hun (inter)nationale uitstraling. \r\n\r\nDe opening van hun nieuwe, volledig witte gebouw in april 2017 betekende een belangrijke impuls voor de vzw die op die unieke plek zijn verschillende doelstellingen kan uitbreiden en combineren. Het gebouw herbergt het onderzoekscentrum voor professionals uit de creatieve sectoren en aanverwante beroepsgroepen, multifunctionele werkruimtes, ontmoetingsplekken, ontvangstruimtes voor ontwerpers, workshops en seminaries en daarbij ook nog een grote ruimte waarin elk jaar verschillende activiteiten voor het grote publiek plaatsvinden, zoals tentoonstellingen, modeshows of artistieke performances.  \r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[3],"translations":{"de":["Dansaert\/Sainte-Catherine"],"pt":[null],"en":["Dansaert\/Sainte-Catherine"],"it":["Dansaert\/Sainte-Catherine"],"cn":[null],"fr":["Dansa