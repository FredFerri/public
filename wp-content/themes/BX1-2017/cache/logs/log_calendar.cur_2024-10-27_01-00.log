\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700002654"},"en":{"name":"MIDGET! (Mocke + Claire Vailler) | Sortie d\u2019album","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/maisonpoeme.be\/evenement\/2024-midget\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700002654"},"it":{"name":"MIDGET! (Mocke + Claire Vailler) | Sortie d\u2019album","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/maisonpoeme.be\/evenement\/2024-midget\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700002654"},"cn":{"name":"MIDGET! (Mocke + Claire Vailler) | Sortie d\u2019album","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/maisonpoeme.be\/evenement\/2024-midget\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700002654"},"fr":{"name":"MIDGET! (Mocke + Claire Vailler) | Sortie d\u2019album","shortdescr":"Concert de sortie du 4e album de Midget!, Qui Parle OMbre","longdescr":"De l\u2019art qui se dilate, une \u00e9chapp\u00e9e flottante hors des formats de la chanson entre l\u2019\u00e9ther et les profondeurs. Assur\u00e9ment l\u2019\u0153uvre la plus aboutie du duo Mocke et Claire Vailler, Qui Parle Ombre est quatri\u00e8me album de Midget! entre synesth\u00e9sie spatio-temporelle, harmonies pop atonales et architectures gothiques. \n\nLes habitu\u00e9\u00b7es de FrancoFaune et des Midis po\u00e9sie ont d\u00e9j\u00e0 crois\u00e9 leur route \u00e0 plus d\u2019une reprise: lors des Fleurs du Slam, dont iels ont assur\u00e9 la partie musicale en \u201921, ou encore lors de cartes blanches au MIMA, autour de Mocke ou de Fran\u00e7oiz Breut.\n\nLeurs compositions tout en \u00e9chos et entrelacs rencontrent pour la premi\u00e8re fois une production ultra contemporaine, avec un mixage r\u00e9alis\u00e9 au Chili par le g\u00e9nial producteur allemand Atom \/ Senor Coconut.","performers":"Midget!; Mocke; Claire Vailler","boxoffice_url":null,"website":"https:\/\/maisonpoeme.be\/evenement\/2024-midget\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700002654"},"sp":{"name":"MIDGET! (Mocke + Claire Vailler) | Sortie d\u2019album","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/maisonpoeme.be\/evenement\/2024-midget\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700002654"},"nl":{"name":"MIDGET! (Mocke + Claire Vailler) | Sortie d\u2019album","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/maisonpoeme.be\/evenement\/2024-midget\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700002654"}},"place":{"id":278685,"translations":{"de":{"name":"Maison Po\u00e8me","address_street_name":"rue d'\u00c9cosse","address_street_number":"30","address_street_box":null,"email":"info@maisonpoeme.be","website":"http:\/\/www.maisonpoeme.be","phone_contact":null,"phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"rue d'\u00c9cosse, 30","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Maison Po\u00e8me","address_street_name":"rue d'\u00c9cosse","address_street_number":"30","address_street_box":null,"email":"info@maisonpoeme.be","website":"http:\/\/www.maisonpoeme.be","phone_contact":null,"phone_booki