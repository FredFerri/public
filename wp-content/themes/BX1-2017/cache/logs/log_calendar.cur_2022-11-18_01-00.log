me":"Article 27"},"nl":{"name":"Artikel 27"},"en":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[539149],"targets":{"list":[],"translations":{}},"visit_content":{"list":[360],"values":["cafe-theatre"]},"tags":[],"accessibilities":{"list":[255],"translations":{"fr":["Accessible"],"nl":["Toegankelijk"],"en":["Accessible"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-10T21:05:44+02:00","published_at":"2022-08-12T08:12:20+02:00","backoffice_id":259580,"import_origin":null,"sub_type":"concert","show_in_agenda":true,"ranking":1.2599210498949},{"id":540948,"date_start":"2022-11-26","date_end":"2022-11-26","date_next":"2022-11-26","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert","de":"Konzert"}},"others":{"list":[4,10],"translations":{"fr":["Pop, rock, jazz\u2026","Jazz & Blues"],"nl":["Pop, rock, jazz\u2026","Jazz & Blues"],"en":["Pop, rock, jazz\u2026","Jazz & Blues"],"de":["Pop, Rock, Jazz...","Jazz & Blues"]}}},"languages":{"spoken":["fr","en","nl"],"subtitles":[]},"translations":{"fr":{"name":"SOUL MEETING Eliott Knuets -Vincent Mardens -Jonathan Collin - Oscar Georges","shortdescr":"Un \u00e9v\u00e8nement unique - un quartet sp\u00e9cialement form\u00e9 pour C\u00f4t\u00e9 Village, le caf\u00e9 th\u00e9\u00e2tre de r\u00e9f\u00e9rence \u00e0 Uccle dans le cadre de Bruxelles Sur Sc\u00e8nes  avec \u00e0 l'honneur le guitariste Elliot Knuets , jeune star belge de la guitare (18 ans) entour\u00e9 par ses brillants ain\u00e9s  \r\nA Musical Meeting trough Generations. When young fellows are performing with their elder, the tenorist Vince \u201cCleanhead\u201d Mardens\u2026","longdescr":"Il n\u2019est pas si fr\u00e9quent que cela d\u2019assister \u00e0 l\u2019\u00e9closion d\u2019un jeune talent. Eliott commence l\u2019apprentissage de la guitare \u00e0 six ans. A huit ans, il entre \u00e0 l\u2019Acad\u00e9mie et il d\u00e9couvre le jazz. A 12 ans, il prend des cours priv\u00e9s avec Peter Hertmans, entre \u00e0 l\u2019Acad\u00e9mie de Waterloo o\u00f9 il a cours avec son oncle, le pianiste Olivier Collette. Il aura des stages avec Charles Loos, entre \u00e0 Kunsthumaniora Brussel et suit des cours avec Bert Cools. D\u00e8s ses 16 ans, il rejoint le Conservatoire de Bruxelles et a cours avec Fabien Degryse. A Bozar, il a l\u2019occasion de jammer avec Wynton Marsalis et, voici qu\u2019\u00e0 18 ans, il sort son premier album avec des complices exp\u00e9riment\u00e9s.\r\nA Musical Meeting trough Generations\r\n\r\n\r\nWhen young fellows are performing with their elder, the tenorist Vince \u201cCleanhead\u201d Mardens\u2026\r\n\r\n\r\nOld standards re-arranged with the fresh sound of this trio leaded by Eliott Knuets, the new Belgian star of the guitar!","performers":"Elliott Knuets. Guitare \r\nJonathan Collin, Contrebasse\r\nOscar Georges, Batterie\r\nVincent Mardens, Saxophone","boxoffice_url":null,"website":"http:\/\/www.cotevillage.be","email":"info@cotevillage.be","phone_contact":null,"phone_booking":"+32 2 346 78 38","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.540948"},"nl":{"name":"SOUL MEETING Eliott Knuets -Vincent Mardens -Jonathan Collin - Oscar Georges","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.540948"},"en":{"name":"SOUL MEETING Elliott Knuets -Vincent Mardens -Jonathan Collin - Oscar Georges","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.540948"},"de":{"name":"Vincent Mardens - Eliott Knuets 4tet","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.540948"},"it":{"name":"Vincent Mardens - Eliott Knuets 4tet","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.540948"},"sp":{"name":"Vincent Mardens - Eliott Knuets 4tet","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.540948"},"pt":{"name":"Vincent Mardens - Eliott Knuets 4tet","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.540948"},"cn":{"name":"Vincent Mardens - Eliott Knuets 4tet","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.540948"}},"place":{"id":233318,"translations":{"fr":{"name":"C\u00f4t\u00e9 Village","address_street_name":"Chauss\u00e9e de Waterloo","address_street_number":"717","address_street_box":"A","email":"info@cotevillage.be","website":"http:\/\/www.cotevillage.be","phone_contact":"+32 2 346 78 38","phone_booking":"+32 2 346 78 38","address_zip":"1180","address_city":"Uccle","address_line1":"Chauss\u00e9e de Waterloo, 717\/A","address_line2":"1180 Uccle","description_web":"C\u00f4t\u00e9 Village est le caf\u00e9-th\u00e9\u00e2tre par excellence d'Uccle depuis plus de 20 ans et peut maintenant se targuer d'une liste impressionnante d'invit\u00e9s. Un certain Adamo, Philip Catherine et Maurane ont donn\u00e9 le meilleur d'eux-m\u00eames ici. Souvenirs dor\u00e9s pour ceux qui \u00e9taient l\u00e0 \u00e0 l'\u00e9poque, en petit comit\u00e9. Mais C\u00f4t\u00e9 Village, c'est bien plus que cela. C'est l\u00e0 que naissent les artistes et humoristes de demain, gr\u00e2ce \u00e0 des stages et des formations intensives selon la c\u00e9l\u00e8bre m\u00e9thode de l\u2019Actors Studio\u00a9.  Ce lieu charismatique dot\u00e9 d\u2019une mission vous charmera \u00e0 coup s\u00fbr.        \r\n\r\n \r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"C\u00f4t\u00e9 Village","address_street_name":"Waterloose Steenweg","address_street_number":"717","address_street_box":"A","email":"info@cotevillage.be","website":"http:\/\/www.cotevillage.be","phone_contact":"+32 2 346 78 38","phone_booking":"+32 2 346 78 38","address_zip":"1180","address_city":"Ukkel","address_line1":"Waterloose Steenweg, 717\/A","address_line2":"1180 Ukkel","description_web":"C\u00f4t\u00e9 Village is al meer dan 20 jaar lang h\u00e9t Ukkelse theatercaf\u00e9 bij uitstek en kan ondertussen uitpakken met een indrukwekkende lijst aan gastoptredens. Grote sterren uit de Franse cultuur zoals Adamo, Philip Catherine en Maurane gaven hier ooit het beste van zichzelf. Gouden herinneringen voor wie er toen bij was, en petit comit\u00e9. C\u00f4t\u00e9 Village is echter meer dan dat. Hier worden de artiesten en humoristen van morgen geboren dankzij intensieve stages en opleidingen volgens de befaamde Actors Studio\u00a9-methode. Deze charismatische plek met een missie zal je zeker bekoren.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"C\u00f4t\u00e9 Village","address_street_name":"Chauss\u00e9e de Waterloo","address_street_number":"717","address_street_box":"A","email":"info@cotevillage.be","website":"http:\/\/www.cotevillage.be","phone_contact":"+32 2 346 78 38","phone_booking":"+32 2 346 78 38","address_zip":"1180","address_city":"Uccle","address_line1":"Chauss\u00e9e de Waterloo, 717\/A","address_line2":"1180 Uccle","description_web":" \u2018C\u00f4t\u00e9 Village\u2019, the landmark caf\u00e9 and theatre in Uccle is celebrating its 20th birthday\r\nTwenty years of \u2018evenings among friends\u2019, dedicated to helping local artists meet their audience (allowing them to wander freely through the art) and dedicated to welcoming artists of great calibre, with improbable duos such as Nilda Fernandez and Adamo or Arielle Dombasle and Philippe Katerine. Dedicated, too, to artists who have passed on, such as Georges Moustaki, Michel Delpech and Maurane.\r\nIt also aims to train the artists of tomorrow with the l\u2019\u00c9cole de Th\u00e9\u00e2tre M\u00e9thode Actors Studio\u00a9.\u2019","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"C\u00f4t\u00e9 Village","address_street_name":"Chauss\u00e9e de Waterloo","address_street_number":"717","address_street_box":"A","email":"info@cotevillage.be","website":"http:\/\/www.cotevillage.be","phone_contact":"+32 2 346 78 38","phone_booking":"+32 2 346 78 38","address_zip":"1180","address_city":"Uccle","address_line1":"Chauss\u00e9e de Waterloo, 717\/A","address_line2":"1180 Uccle","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"C\u00f4t\u00e9 Village","address_street_name":"Chauss\u00e9e de Waterloo","address_street_number":"717","address_street_box":"A","email":"info@cotevillage.be","website":"http:\/\/www.cotevillage.be","phone_contact":"+32 2 346 78 38","phone_booking":"+32 2 346 78 38","address_zip":"1180","address_city":"Uccle","address_line1":"Chauss\u00e9e de Waterloo, 717\/A","address_line2":"1180 Uccle","description_web":"","description_print":"","booking_ur