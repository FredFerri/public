00","is_soldout":false,"is_canceled":false},{"day":"2022-07-18","doors":"18:00:00","start":"20:15:00","end":"22:15:00","is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":15},{"translations":{"fr":{"name":"Enfants"},"nl":{"name":"Kinderen"},"en":{"name":"Children"}},"value":10},{"translations":{"fr":{"name":"Jeunes"},"nl":{"name":"Jongeren"},"en":{"name":"Young"}},"value":10},{"translations":{"fr":{"name":"Pr\u00e9vente"},"nl":{"name":"Voorverkoop"},"en":{"name":"Presale"}},"value":13}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":{"list":[255,263],"translations":{"fr":["Accessible","Accessible aux pi\u00e9tons appareill\u00e9s"],"nl":["Toegankelijk","Toegankelijk voor voetgangers met hulpmiddelen"],"en":["Accessible","Accessible to pedestrians with mobility aids"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-04-26T01:06:51+02:00","published_at":"2022-03-30T09:57:30+02:00","backoffice_id":250583,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":0.28011059397367},{"id":527073,"date_start":"2022-05-31","date_end":"2022-05-31","date_next":"2022-05-31","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre"}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Home (Morceaux de nature en ruine)","shortdescr":"\u201cHome\u201d est le terme qui d\u00e9signe une maison de retraite en Belgique. \u201cHome\u201d est un anglicisme qui signifie foyer, chez-soi.","longdescr":"Une table, trois chaises, une horloge, un fauteuil, une radio. C\u2019est une salle commune. Un espace pour \u00eatre ensemble, un espace o\u00f9 l\u2019on est seul. Il ne se passe rien. On attend le\u00b7la m\u00e9decin, un appel, ou une visite.\r\n\r\nChor\u00e9graphie po\u00e9tique dans un EHPAD comme un autre. Dans un dispositif \u00e9tonnant, de tr\u00e8s jeunes com\u00e9dien\u00b7ne\u00b7s incarnent nos a\u00een\u00e9\u00b7e\u00b7s avec d\u00e9licatesse et pertinence. Les corps se transforment dans un geste de pure th\u00e9\u00e2tralit\u00e9, sobre et respectueux de l\u2019enqu\u00eate qu\u2019\u00e0 men\u00e9e la metteuse en sc\u00e8ne dans ces lieux. Une premi\u00e8re \u0153uvre sans concession, qui fera rire et pleurer, tant, le r\u00e9el dans ce cas, nous touche dans notre condition d\u2019humain, inexorablement vieillissant.\r\n\r\nDans ce monde en vase clos, o\u00f9 le temps ne semble avoir de prise que sur les corps, trois r\u00e9sident\u00b7e\u00b7s affrontent les joies et les trag\u00e9dies de leur quotidien. Que faire quand les plantes vertes se transforment en for\u00eat de sapins, que la temp\u00eate arrache les murs et qu\u2019il n\u2019y a personne pour servir le prochain repas ? \u00c0 partir d\u2019une recherche documentaire men\u00e9e au sein d\u2019une maison de retraite m\u00e9dicalis\u00e9e \u00e0 Ixelles, trois jeunes acteur\u00b7rice\u00b7s nous restituent l\u2019inqui\u00e9tante \u00e9tranget\u00e9 propre \u00e0 ces lieux.","performers":"Avec les voix des r\u00e9sident\u00b7e\u00b7s du Home Malibran\r\nUn projet initi\u00e9 et mis en sc\u00e8ne par Magrit Coulon\r\nInterpr\u00e9tation : Carole Adolff, Ana\u00efs Aouat, Tom Geels\r\nDramaturgie : Bogdan Kikena","boxoffice_url":null,"website":"http:\/\/www.ccu.be","email":"reservation@ccu.be","phone_contact":null,"phone_booking":"+32 2 374 64 84","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/527073.html"},"nl":{"name":"Home (Morceaux de nature en ruine)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/527073.html"},"en":{"name":"Home (Morceaux de nature en ruine)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/527073.html"},"de":{"name":"Home (Morceaux de nature en ruine)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/527073.html"},"it":{"name":"Home (Morceaux de nature en ruine)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/527073.html"},"sp":{"name":"Home (Morceaux de nature en ruine)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/527073.html"},"pt":{"name":"Home (Morceaux de nature en ruine)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/527073.html"},"cn":{"name":"Home (Morceaux de nature en ruine)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/527073.html"}},"place":{"id":7929,"translations":{"fr":{"name":"Centre Culturel d'Uccle","address_street_name":"Rue Rouge","address_street_number":"47","address_street_box":null,"email":"reservation@ccu.be","website":"http:\/\/www.ccu.be","phone_contact":"+32 2 374 64 84","phone_booking":"+32 2 374 64 84","address_zip":"1180","address_city":"Uccle","address_line1":"Rue Rouge, 47","address_line2":"1180 Uccle","description_web":"Le Centre culturel d\u2019Uccle est contemporain de l\u2019Atomium. Con\u00e7u pour se trouver dans un \u00e9crin de verdure, face au Parc de Wolvendael, la premi\u00e8re pierre fut pos\u00e9e le 30 novembre 1957. Le Centre Culturel et Artistique d\u2019Uccle fut inaugur\u00e9 le 5 octobre 1958.\r\nLe CCU est une \u0153uvre de l\u2019architecte L\u00e9on Stynen, qui avait aussi con\u00e7u les casinos de Knokke, Blankenberge et Ostende.\r\nCe nouveau Centre Culturel permit aux soci\u00e9t\u00e9s et associations int\u00e9ress\u00e9es d\u2019organiser des bals, des conf\u00e9rences, des concerts, des projections de films, des d\u00e9bats et toutes autres manifestations culturelles et artistiques (ballets, concerts, expositions, r\u00e9ceptions, \u2026). Il proposait aussi des repr\u00e9sentations th\u00e9\u00e2trales, un cycle de conf\u00e9rences et des spectacles musicaux.\r\nL'ensemble du b\u00e2timent abrite principalement un hall d\u2019entr\u00e9e donnant acc\u00e8s \u00e0 une grande Salle de Spectacle de 800 fauteuils, un Grand Foyer pouvant accueillir jusqu'\u00e0 400 personnes assises, ainsi qu'un Petit Foyer pouvant contenir 120 personnes.\r\nPlus de cinquante ans apr\u00e8s sa cr\u00e9ation, le Centre Culturel d\u2019Uccle r\u00e9nov\u00e9 a un look \u00e0 la fois contemporain et chaleureux. Pleinement actif, il r\u00e9pond aux d\u00e9fis culturels de son si\u00e8cle en accueillant les plus grands noms du th\u00e9\u00e2tre, de la danse, de la chanson et de la musique ainsi que des artistes et des conf\u00e9renciers de renom. Il s\u2019est constamment modernis\u00e9 pour offrir \u00e0 son public une vie culturelle de qualit\u00e9 au c\u0153ur de la commune d\u2019Uccle.\r\nDirig\u00e9 par une \u00e9quipe dynamique, le CCU met tout en \u0153uvre pour fid\u00e9liser sa client\u00e8le et conqu\u00e9rir sans cesse un public nouveau.\r\nLe Centre Culturel d\u2019Uccle en quelques chiffres, c\u2019est\u2026\r\n-\tUn des plus grands centres culturels \u00e0 Bruxelles et ses environs\r\n-\tUn rendez-vous des professionnels du spectacle\r\n-\t4 espaces bien distincts (Hall, Grand Foyer, Petit Foyer, Salle de Spectacle)\r\n-\tUne salle de spectacle de 800 places\r\n-\tUn gradin r\u00e9tractable de 172 places\r\n-\t200 activit\u00e9s par an\r\n-\t600 artistes par saison\r\n-\t60.000 spectateurs par an\r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"CC Ukkel","address_street_name":"Rodestraat","address_street_number":"47","address_street_box":null,"email":"info@ccu.be","website":"http:\/\/www.ccu.be","phone_contact":"+32 2 374 64 84","phone_booking":"+32 2 374 64 84","address_zip":"1180","address_city":"Ukkel","address_line1":"Rodestraat, 47","address_line2":"1180 Ukkel","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Centre Culturel d'Uccle","address_street_name":"Rue Rouge","address_street_number":"47","address_street_box":null,"email":"reservation@ccu.be","website":"http:\/\/www.ccu.be","phone_contact":"+32 2 374 64 84","phone_booking":"+32 2 374 64 84","address_zip":"1180","address_city":"Uccle","address_line1":"Rue Rouge, 47","address_line2":"1180 Uccle","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Centre Culturel d'Uccle","address_street_name":"Rue Rouge","address_street_number":"47","address_street_box":null,"email":"reservation@ccu.be","website":"http:\/\/www.ccu.be","phone_contact":"+32 2 374 64 84","phone_booking":"+32 2 374 64 84","address_zip":"1180","address_city":"Uccle","address_line1":"Rue Rouge, 47","address_line2":"1180 Uccle","description_web":"","description_print":"","booking_url":n