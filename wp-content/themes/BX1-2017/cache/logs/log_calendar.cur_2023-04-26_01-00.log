ebsite":"http:\/\/www.enygma.be","email":"info@enygma.be","phone_contact":"+32 2 512 96 37","phone_booking":"+32 2 512 96 37","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.542796"},"nl":{"name":"Brussels By Puzzles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.enygma.be","email":"info@enygma.be","phone_contact":"+32 2 512 96 37","phone_booking":"+32 2 512 96 37","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.542796"},"en":{"name":"Brussels By Puzzles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.enygma.be","email":"info@enygma.be","phone_contact":"+32 2 512 96 37","phone_booking":"+32 2 512 96 37","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.542796"},"de":{"name":"Brussels By Puzzles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.enygma.be","email":"info@enygma.be","phone_contact":"+32 2 512 96 37","phone_booking":"+32 2 512 96 37","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.542796"},"it":{"name":"Brussels By Puzzles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.enygma.be","email":"info@enygma.be","phone_contact":"+32 2 512 96 37","phone_booking":"+32 2 512 96 37","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.542796"},"sp":{"name":"Brussels By Puzzles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.enygma.be","email":"info@enygma.be","phone_contact":"+32 2 512 96 37","phone_booking":"+32 2 512 96 37","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.542796"},"pt":{"name":"Brussels By Puzzles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.enygma.be","email":"info@enygma.be","phone_contact":"+32 2 512 96 37","phone_booking":"+32 2 512 96 37","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.542796"},"cn":{"name":"Brussels By Puzzles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.enygma.be","email":"info@enygma.be","phone_contact":"+32 2 512 96 37","phone_booking":"+32 2 512 96 37","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.542796"}},"place":{"id":265631,"translations":{"fr":{"name":"Enygma Partners sprl","address_street_name":"Place de l'Albertine","address_street_number":"3","address_street_box":null,"email":"info@enygma.be","website":"http:\/\/www.enygma.be","phone_contact":"+32 2 512 96 37","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de l'Albertine, 3","address_line2":"1000 Bruxelles","description_web":"","description_print":"Dans un jeu d\u2019\u00e9vasion, un groupe de personnes est enferm\u00e9e dans une pi\u00e8ce. Le but du jeu est de r\u00e9soudre une s\u00e9rie d\u2019\u00e9nigmes afin d\u2019en sortir avant la fin du temps imparti. Chaque pi\u00e8ce a un th\u00e8me et un d\u00e9cor particuliers.\r\nLes histoires choisies par Enygma entra\u00eenent les joueurs dans la litt\u00e9rature et le cin\u00e9ma. Elles mettent en sc\u00e8ne Phileas Fogg et son Tour du Monde en 80 jours, Sherlock Holmes et Moriarty ou encore un temple maya, r\u00e9f\u00e9rence au c\u00e9l\u00e8bre Indiana Jones et aux aventures de Tintin.\r\nUn jeu captivant pour un groupe de 3 \u00e0 6 aventuriers \u00e0 partir de 10 ans. \r\n","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Enygma Partners sprl","address_street_name":"Albertinaplein","address_street_number":"3","address_street_box":null,"email":"info@enygma.be","website":"http:\/\/www.enygma.be","phone_contact":"+32 2 512 96 37","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Albertinaplein, 3","address_line2":"1000 Brussel","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Enygma Partners sprl","address_street_name":"Place de L'Albertine","address_street_number":"3","address_street_box":null,"email":"info@enygma.be","website":"http:\/\/www.enygma.be","phone_contact":"+32 2 512 96 37","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Place de L'Albertine, 3","address_line2":"1000 Brussels","description_web":"Push the boundaries of mystery, enter a theatrical setting, search every nook and cranny, interact with your environment to find hidden objects and solve puzzles and progress in your chosen scenario. Armed only with your sense of observation and logic, surrounded by your team of faithful companions, come to the aid of the world-renowned detective, Sherlock Holmes, to thwart the evil plans of the infamous Professor Moriarty, join Phileas Fogg in his wild adventure around the world or in the Nautilus or dive into the Amazonian jungle to discover a lost ancient temple and try to break an ancestral Mayan curse. Beware, it's a race against the clock! You only have 60 minutes to accomplish your mission and escape...\r\n\r\nLocated at the bottom of Mont des Arts, in the very heart of Brussels, Enygma is an entertaining and unique experience that is located at the crossroads of interactive theater, treasure hunting, and role play.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Enygma Partners sprl","address_street_name":"Place de l'Albertine","address_street_number":"3","address_street_box":null,"email":"info@enygma.be","website":"http:\/\/www.enygma.be","phone_contact":"+32 2 512 96 37","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de l'Albertine, 3","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_vi