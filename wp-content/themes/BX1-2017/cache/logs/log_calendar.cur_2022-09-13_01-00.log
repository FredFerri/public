osed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre"}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Approchez! Approchez!","shortdescr":"La tradition continue\u2026\r\nDepuis 2010, Jack Cooper a cr\u00e9\u00e9 une v\u00e9ritable tradition avec ses spectacles dans la Chapelle du Karreveld abordant un genre passionnant de l\u2019illusionnisme : la magie de proximit\u00e9.","longdescr":"Jack Cooper y rel\u00e8ve le d\u00e9fi de pr\u00e9senter un spectacle entier dans un petit lieu o\u00f9 tous les spectateurs sont \u00e0 moins de deux m\u00e8tres de lui et ainsi l\u2019observent \u00e0 volont\u00e9, surveillent le moindre de ses gestes et bien souvent participent aux tours propos\u00e9s.\r\n\r\nLa plupart des magiciens, dont Jack Cooper, se produisent habituellement sur sc\u00e8ne, entour\u00e9s de nombreux effets : musique, lumi\u00e8res, fumig\u00e8nes, vid\u00e9o... Cela participe bien s\u00fbr au show. Mais soyons honn\u00eates, il s'agit bien souvent d'une ceinture de s\u00e9curit\u00e9 pour l'artiste. La fum\u00e9e aurait-elle cach\u00e9 quelque artifice ? Le son camouflerait-il quelque chose qu'il ne faut pas entendre ? Qui sait ? Et de toute fa\u00e7on, seule la magie du show importe. Mais ici, rien de tout cela. De par la proximit\u00e9, il s\u2019agit pour le magicien d\u2019un vrai saut dans le vide. Il est seul avec vous...\r\n\r\nL\u2019an dernier, Jack Copper vous a propos\u00e9 la reprise de son second spectacle de proximit\u00e9, \"Entre nous\". Vu le succ\u00e8s, il a d\u00fb rajouter sept repr\u00e9sentations. Cet \u00e9t\u00e9, il vous propose un best-off de son savoir-faire gratin\u00e9 de nombreuses nouveaut\u00e9.","performers":"MAGIE \/ MENTALISME DE JACK COOPER\r\nUne conception de Jack Cooper \u25aa Avec: Jack Cooper","boxoffice_url":"https:\/\/shop.utick.be\/?pos=FESTIVALBRUXELLONS&module=CATALOGUE&lg=FR","website":"http:\/\/www.bruxellons.be","email":"info@bruxellons.net","phone_contact":null,"phone_booking":"+32 2 724 24 24","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.535910"},"nl":{"name":"Approchez! Approchez!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/shop.utick.be\/?pos=FESTIVALBRUXELLONS&module=CATALOGUE&lg=NL","website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.535910"},"en":{"name":"Approchez! Approchez!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/shop.utick.be\/?pos=FESTIVALBRUXELLONS&module=CATALOGUE&lg=EN","website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.535910"},"de":{"name":"Approchez! Approchez!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.535910"},"it":{"name":"Approchez! Approchez!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.535910"},"sp":{"name":"Approchez! Approchez!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.535910"},"pt":{"name":"Approchez! Approchez!","shortdescr":null,"longdescr":null,"performers":null,"boxof