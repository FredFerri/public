,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.544444"}},"place":{"id":274529,"translations":{"fr":{"name":"El Caf\u00e9","address_street_name":"Avenue de la Couronne","address_street_number":"463","address_street_box":null,"email":"info@elcafe.be","website":"http:\/\/elcafe.be\/","phone_contact":"+32 2 640 07 79","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue de la Couronne, 463","address_line2":"1050 Ixelles","description_web":"Nous avons imagin\u00e9 le El Caf\u00e9 comme un lieu convivial, a\u00e9r\u00e9 et festif mariant une authentique cuisine TexMex \u00e0 de savoureux cocktails. Le quartier universitaire manquait d\u2019un endroit branch\u00e9 et d\u00e9contract\u00e9 o\u00f9 il fait bon se retrouver entre amis.\r\n\r\nNous sommes ouverts tous les jours de 12 h \u00e0 la fermeture. Notre cuisine vous sert non stop de midi \u00e0 23h. Profitez tous les jours de l\u2019HappyHour de 19h \u00e0 21h ainsi que d\u2019un parking s\u00e9curis\u00e9 avec voiturier au parking du Carrefour \u00e0 partir de 20h.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"El Caf\u00e9","address_street_name":"Avenue de la Couronne","address_street_number":"463","address_street_box":null,"email":"info@elcafe.be","website":"http:\/\/elcafe.be\/","phone_contact":"+32 2 640 07 79","phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"Avenue de la Couronne, 463","address_line2":"1050 Elsene","description_web":"El Caf\u00e9 is een vriendelijke, luchtige en feestelijke plek die authentieke tex-mexkeuken combineert met heerlijke cocktails. Een niet te missen locatie in de universiteitsbuurt. \r\nDagelijks geopend van 12 uur 's middags tot sluitingstijd. De keuken serveert non-stop van 12.00 tot 23.00 u. Elke dag happy hour van 19.00 tot 21.00 u. Verder is er eveneens een beveiligde parkeergelegenheid met valet aan de Carrefour-parking vanaf 20.00 uur.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"El Caf\u00e9","address_street_name":"Avenue de la Couronne","address_street_number":"463","address_street_box":null,"email":"info@elcafe.be","website":"http:\/\/elcafe.be\/","phone_contact":"+32 2 640 07 79","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue de la Couronne, 463","address_line2":"1050 Ixelles","description_web":"El Caf\u00e9 is a friendly, airy and festive place that combines authentic TexMex cuisine with delicious cocktails. It's an unmissable spot in the university district. It's open every day from noon to closing time and the kitchen serves you non-stop from noon to 23:00. Enjoy HappyHour every day from 19:00 to 21:00, as well as a secure car park with valet parking at the Carrefour car park from 20:00.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"El Caf\u00e9","address_street_name":"Avenue de la Couronne","address_street_number":"463","address_street_box":null,"email":"info@elcafe.be","website":"http:\/\/elcafe.be\/","phone_contact":"+32 2 640 07 79","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue de la Couronne, 463","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"El Caf\u00e9","address_street_name":"Avenue de la Couronne","address_street_number":"463","address_street_box":null,"email":"info@elcafe.be","website":"http:\/\/elcafe.be\/","phone_contact":"+32 2 640 07 79","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue de la Couronne, 463","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"