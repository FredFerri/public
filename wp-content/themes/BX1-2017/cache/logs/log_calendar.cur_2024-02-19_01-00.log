of":null,"sub_type":"theatre","ranking":0.16441413828869803,"languages":{"spoken":["en","fr"],"subtitles":[]},"categories":{"main":{"id":49,"translations":{"de":"Theater","pt":null,"en":"Theatre","it":"Teatro","cn":null,"fr":"Th\u00e9\u00e2tre","sp":"Teatro","nl":"Theater"}},"others":{}},"translations":{"de":{"name":"Atelier d\u2019initiation au th\u00e9\u00e2tre et au cin\u00e9ma le lundi soir","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.scenocity.be","email":"contact@scenocity.be","phone_contact":"+32 473 27 20 91","phone_booking":"+32 2 732 47 73","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50000505"},"pt":{"name":"Atelier d\u2019initiation au th\u00e9\u00e2tre et au cin\u00e9ma le lundi soir","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.scenocity.be","email":"contact@scenocity.be","phone_contact":"+32 473 27 20 91","phone_booking":"+32 2 732 47 73","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50000505"},"en":{"name":"Atelier d\u2019initiation au th\u00e9\u00e2tre et au cin\u00e9ma le lundi soir","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.scenocity.be","email":"contact@scenocity.be","phone_contact":"+32 473 27 20 91","phone_booking":"+32 2 732 47 73","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50000505"},"it":{"name":"Atelier d\u2019initiation au th\u00e9\u00e2tre et au cin\u00e9ma le lundi soir","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.scenocity.be","email":"contact@scenocity.be","phone_contact":"+32 473 27 20 91","phone_booking":"+32 2 732 47 73","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50000505"},"cn":{"name":"Atelier d\u2019initiation au th\u00e9\u00e2tre et au cin\u00e9ma le lundi soir","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.scenocity.be","email":"contact@scenocity.be","phone_contact":"+32 473 27 20 91","phone_booking":"+32 2 732 47 73","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50000505"},"fr":{"name":"Atelier d\u2019initiation au th\u00e9\u00e2tre et au cin\u00e9ma le lundi soir","shortdescr":"Ce cours d\u2019initiation au th\u00e9\u00e2tre et au cin\u00e9ma s\u2019adresse \u00e0 toute personne d\u00e9sireuse de d\u00e9couvrir le m\u00e9tier sp\u00e9cifique d\u2019acteur. Il est \u00e9galement ouvert aux metteurs en sc\u00e8ne et r\u00e9alisateurs qui d\u00e9sirent d\u00e9couvrir la direction d\u2019acteur.","longdescr":"L'animateur Philippe Cornette a pris ses \u00e9l\u00e8ves comme acteur dans son film \"Putain d'amendement\", qui est en comp\u00e9tition au FIFE Festival International de l'Espoir, ZINEBI Bilbao, RIFF Roma Independent Film Festival, Festival Internacional De Cortometrajes Vitafest Chili, Bristol Independent Film Festival, Paris Art & Movie Awards, Warsaw International Film Festival Poland.\nArticul\u00e9 sur trois cycles de 9 cours, cet atelier vise \u00e0 la d\u00e9couverte et l\u2019exploitation de l\u2019emploi ou des emplois des com\u00e9diens : \u00ab qu\u2019est-ce que je d\u00e9gage \u2013 quel type de personnage je peux jouer \u2013 quelles sont mes caract\u00e9ristiques propres- quelle image je projette de moi ? Pour quel genre de r\u00f4le puis-je \u00eatre cast\u00e9 ? \u00bb\nNous d\u00e9velopperons le corps physique et le corps \u00e9nerg\u00e9tique de l\u2019acteur, son charisme, la justification des mouvements, positions, poses et modulation de la voix.\nOn y travaillera :\nL\u2019imagination et la concentration \u2013 L\u2019entrainement \u2013 La relaxation -La respiration \u2013 Les 4 \u00e9l\u00e9ments \u2013 Le corps de l\u2019acteur -Le centre imaginaire -Le sens de la forme \u2013 Le sens du beau \u2013 L\u2019espace du tr\u00e9teau \u2013 L\u2019atmosph\u00e8re \u2013 Le tempo et le rythme.\nLes \u00e9tats et les gestes psychologiques \u2013 L\u2019eurythmie \u2013 La sensibilit\u00e9 \u2013 Au-del\u00e0 des limites du corps \u2013 Temps et espace imaginaire \u2013 L\u2019\u00e9mission de la voix et ses blocage \u2013 L\u2019espace vitale de l\u2019acteur \u2013 Les styles au th\u00e9\u00e2tre.\nL\u2019acteur et ses cinq sens \u2013 Le sens chorale \u2013 L\u2019imagination \u2013 Le corps imaginaire \u2013 La m\u00e9moire sensorielle \u2013 La m\u00e9moire sensitive \u2013 Le monde animal \u2013 Travail de sc\u00e8nes \u00e0 pr\u00e9senter.\n","performers":"Philippe Cornette (Cin\u00e9aste, acteur, auteur, metteur en sc\u00e8ne)","boxoffice_url":null,"website":"https:\/\/www.scenocity.be","email":"contact@scenocity.be","phone_contact":"+32 473 27 20 91","phone_booking":"+32 2 732 47 73","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50000505"},"sp":{"name":"Atelier d\u2019initiation au th\u00e9\u00e2tre et au cin\u00e9ma le lundi soir","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.scenocity.be","email":"contact@scenocity.be","phone_contact":"+32 473 27 20 91","phone_booking":"+32 2 732 47 73","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50000505"},"nl":{"name":"Atelier d\u2019initiation au th\u00e9\u00e2tre et au cin\u00e9ma le lundi soir","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.scenocity.be","email":"contact@scenocity.be","phone_contact":"+32 473 27 20 91","phone_booking":"+32 2 732 47 73","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50000505"}},"place":{"id":269799,"translations":{"de":{"name":"Salle paroissiale","address_street_name":"rue Jacques Hoton","address_street_number":"11","address_street_box":null,"email":null,"website":null,"phone_contact":"+32 2 771 63 75","phone_booking":"+32 2 771 63 75","ad