Teachers"]}},"educational_targets":{"list":[2,3],"translations":{"fr":["Primaire","Secondaire"],"nl":["Lagere school","Secundair onderwijs"],"en":["Primary school","Secondary school"]}},"tags":["kids"],"accessibilities":{"list":[255,259,263,265],"translations":{"fr":["Accessible","Chien d'assistance","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9"],"nl":["Toegankelijk","Assistentiehonden","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet"],"en":["Accessible","Assistance dogs","Accessible to pedestrians with mobility aids","Adapted toilet"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-09-11T01:07:10+02:00","published_at":"2021-09-01T13:05:55+02:00","backoffice_id":238227,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.11625202608258},{"id":531124,"date_start":"2022-01-01","date_end":"2025-01-01","date_next":"2022-09-13","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":true,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":90,"translations":{"fr":"Animations","nl":"Animaties","en":"Animations"}},"others":{"list":[99],"translations":{"fr":["Gastronomie"],"nl":["Gastronomie"],"en":["Gastronomy"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Table \u00e0 bord du Tram Experience","shortdescr":"Embarquez pour un voyage gastronomique unique \u00e0 travers Bruxelles !","longdescr":"Le Tram Experience f\u00eate ses 10 ans ! Tout au long de la derni\u00e8re d\u00e9cennie, nous avons eu la chance de partager cette exp\u00e9rience gastronomique hors-du-commun avec les amateurs de grande cuisine, de Bruxelles et d\u2019ailleurs. \r\nApr\u00e8s un relooking bien m\u00e9rit\u00e9 et un retour en fanfare en septembre dernier, le temps est venu de d\u00e9couvrir la nouvelle \u00e9dition du Tram Experience. \r\nAu rythme des saisons, chaque menu est l\u2019occasion pour nos chefs de vous pr\u00e9senter leur r\u00e9interpr\u00e9tation de la cuisine belge. De quoi ravir vos papilles ! Red\u00e9couvrez la gastronomie belge dans l\u2019atmosph\u00e8re unique et chaleureuse d\u2019un tram circulant \u00e0 travers Bruxelles. \r\nL\u2019incontournable Lionel Rigolet* nous fait, une nouvelle fois, le plaisir d\u2019\u00eatre le parrain du Tram Experience ! Sa rigueur et son expertise, en tant que chef du prestigieux Comme chez Soi, vous garantissent des menus savoureux \u00e0 l\u2019ex\u00e9cution parfaite.\r\nLes plats sont r\u00e9alis\u00e9s \u00e0 bord par notre chef traiteur, Thibault Granville - Taste Great.\r\nEn voiture !","performers":null,"boxoffice_url":null,"website":"http:\/\/www.tramexperience.be","email":"tramexperience@visit.brussels","phone_contact":"+32 2 513 89 40","phone_booking":"+32 2 513 89 40","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.531124"},"nl":{"name":"Tafel aan boord van de Tram Experience","shortdescr":"Ga mee op een unieke gastronomische reis door Brussel!","longdescr":"De Tram Experience viert zijn 10e verjaardag! Al tien jaar lang mogen we deze buitengewone gastronomische ervaring delen met liefhebbers van lekker eten uit Brussel en daarbuiten.\r\nNa een welverdiende make-over en een geweldige comeback afgelopen september, is de Tram Experience toe aan een nieuwe editie, klaar om ontdekt te worden!\r\nElk seizoensgebonden menu is voor onze chefs een gelegenheid om hun herinterpretaties van de Belgische keuken voor te stellen en je smaakpapillen stevig te verwennen. Je herontdekt de Belgische gastronomie en dat in de unieke en gezellige sfeer van een tram die door Brussel rolt.\r\nDe onnavolgbare Lionel Rigolet*, chef van het prestigieuze Comme chez Soi, vereert ons door opnieuw peetvader te zijn van de Tram Experience. Zijn precisie en deskundigheid garanderen je overheerlijke menu\u2019s die tot in de puntjes uitgewerkt zijn. Aan boord worden de gerechten bereid door onze chef-kok Thibault Granville van Taste Great.\r\nOpstappen maar!","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.531124"},"en":{"name":"Table on board the Tram Experience","shortdescr":"Embark on a unique gastronomic journey through Brussels!","longdescr":"After a well-deserved rest, the completely redesigned Tram Experience offers you a brand-new contemporary adventure through Belgian gastronomy.\r\nOriginality, heritage and tingling taste buds are on the menu!\r\nThis new season, Belgian cuisine is being reinvented by great chefs from all three of the country's regions. Come and (re)discover Belgian gastronomy in the unique and warm atmosphere of a tram as it travels through Brussels.\r\nChef Lionel Rigolet** is once again doing us the honour of being the Tram Experience's patron! His rigour and his expertise as a chef, at the head of the prestigious Comme chez Soi, enable us to propose menus with perfect execution.\r\nOur chef caterer Thibault Granville (Taste Great) prepares and finishes the recipes on board.\r\nAll aboard!","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.531124"},"de":{"name":"Tram Experience","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.531124"},"it":{"name":"Tram Experience","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.531124"},"sp":{"name":"Tram Experience","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.531124"},"pt":{"name":"Tram Experience","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.531124"},"cn":{"name":"Tram Experience","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.531124"}},"place":{"id":238555,"translations":{"fr":{"name":"Place Poelaert","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Poelaert","address_line2":"1000 Bruxelles","description_web":"Entre les Marolles tr\u00e8s populaires, et l'\u00e9l\u00e9gant quartier Louise, se trouve la place Poelaert. C'est le meilleur spot pour avoir une vue panoramique \u00e0 couper le souffle sur la ville. \u00c0 l'horizon se profilent des joyaux du patrimoine bruxellois comme la basilique de Koekelberg et l'Atomium ; \u00e0 admirer sans mod\u00e9ration, et particuli\u00e8rement au coucher du soleil. Vous n'avez pas le vertige ? Depuis 2019, la grande roue \" The View \" vous emm\u00e8ne \u00e0 cent m\u00e8tres de haut pour admirer la capitale belge, tandis que l'ascenseur (gratuit), tout en verre, vous fait plonger dans les Marolles pour encore plus de plaisir en ville.\r\n\r\nAvec ses 750 m2, la place Poelaert est \u00e9galement la plus grande place de la capitale. Elle doit son nom \u00e0 Joseph Poelaert, l'architecte du monumental palais de justice, construit au 19\u00e8me si\u00e8cle, qui tr\u00f4ne sur cette place ; et l\u2019\u00e9chafaudage qui le soutient depuis des ann\u00e9es fait d\u00e9sormais partie de la m\u00e9moire collective.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Poelaertplein","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Poelaertplein","address_line2":"1000 Brussel","description_web":"Tussen de volkse Marollen en de elegante Louizawijk ligt het Poelaertplein. Hier moet je zijn voor een prachtig panoramisch uitzicht over de (beneden)stad. Aan de horizon prijken architecturale erfgoedparels zoals de Basiliek van Koekelberg en het Atomium. Vooral bij zonsondergang is het hier volop genieten van een eindeloze hemel. Geen hoogtevrees? Sinds 2019 staat hier het reuzenrad \u2018The View\u2019 en kan je de Belgische hoofdstad bewonderen vanop maar liefst honderd meter hoogte! Nadien kan je gratis de glazen lift nemen en de Marollen induiken voor meer stadsplezier.\r\n\r\nHet Poelaertplein is met een oppervlakte van 750 m\u00b2 ook het grootste plein van de hoofdstad. Het werd vernoemd naar Joseph Poelaert, de architect van het justitiepaleis. Dat is het monumentale gerechtsgebouw dat je op dit plein ziet, een mastodont uit de 19de eeuw. De steigers waarin het justitiepaleis sinds jaar en dag verpakt is, maken ondertussen deel uit van het collectieve geheugen.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Place Poelaert","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Place Poelaert","address_line2":"1000 Brussels","description_web":"Between the popular Marolles district and the elegant Louise neighbourhood lies the place Poelaert. This is the place to go for a superb panoramic view of the lower part of the city. On the horizon are architectural heritage gems such as the Basilica of Koekelberg and the Atomium. Sunset in particular is a great time to enjoy the seemingly endless sky. Not afraid of heights? Since 2019, the giant Ferris wheel 'The View' has taken up residence here and you can admire the Belgian capital from a height of no less than one hundred metres! Afterwards, take the free glass lift and dive into the Marolles for more urban fun.\r\n\r\nPlace Poelaert, with its 750m\u00b2 surface area, is also the largest square in the capital. It was named after Joseph Poelaert, the architect of the Palace of Justice, which is the monumental courthouse you see on this square, a mastodon from the 19th century. The scaffolding surrounding the courthouse has become part of the public's collective memory.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Place Poelaert","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Poelaert","address_line2":"1000 Bruxelles","description_web":"Bei dem Place Poelaert, der sich 63 Meter \u00fcber der Br\u00fcsseler Unterstadt befindet, handelt es sich um den Vorplatz des beeindruckenden Br\u00fcsseler Justizpalasts. Ein Fahrstuhl ist die schnellste Verbindung zwischen Ober- und Unterstadt. Der Platz misst 155 m x 50 m, d. h. knapp 8 hat - damit ist der Place Poelaert der gr\u00f6\u00dfte Platz Br\u00fcssels.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Place Poelaert","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Poelaert","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Place Poelaert","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Poelaert","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Place Poelaert","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Poelaert","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Place Poelaert","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Poelaert","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[2],"translations":{"fr":["Marolles"],"nl":["Marollen"],"en":["Marolles"]}},"zones":{"list":[19],"translations":{"fr":["Centre"],"nl":["Centrum"],"en":["Centre"]}},"neca":null,"facebook_id":"109264419156670","backoffice_id":2016,"location":{"lat":50.83696471,"lon":4.35179017},"region":"brussels","last_updated_at":"2022-09-12T01:05:38+02:00","published_at":"2013-10-19T01:14:50+02:00","import_origin":null,"external_id":null,"is_in_address_book":false,"is_in_vb_export":false,"resto_ranking":0},"organizer":{"id":278418,"translations":{"fr":{"name":"Tram experience","a