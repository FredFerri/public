l,"boxoffice_url":null,"website":"http:\/\/lafluteenchantee.be\/jalousie-en-trois-mails\/","email":"la.flute.enchantee@skynet.be","phone_contact":"+32 2 660 79 50","phone_booking":"+32 2 660 79 50","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50000405"},"en":{"name":"Jalousie en trois mails","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/lafluteenchantee.be\/jalousie-en-trois-mails\/","email":"la.flute.enchantee@skynet.be","phone_contact":"+32 2 660 79 50","phone_booking":"+32 2 660 79 50","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50000405"},"it":{"name":"Jalousie en trois mails","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/lafluteenchantee.be\/jalousie-en-trois-mails\/","email":"la.flute.enchantee@skynet.be","phone_contact":"+32 2 660 79 50","phone_booking":"+32 2 660 79 50","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50000405"},"cn":{"name":"Jalousie en trois mails","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/lafluteenchantee.be\/jalousie-en-trois-mails\/","email":"la.flute.enchantee@skynet.be","phone_contact":"+32 2 660 79 50","phone_booking":"+32 2 660 79 50","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50000405"},"fr":{"name":"Jalousie en trois mails","shortdescr":null,"longdescr":"1 immeuble, 3 femmes pour 1 homme. Un immeuble de plus de 30 \u00e9tages o\u00f9 l'on se croise sans se conna\u00eetre. Trois femmes, trois g\u00e9n\u00e9rations : Helen, quinquag\u00e9naire \u00e9panouie, avocate c\u00e9l\u00e8bre et \u00e9pouse fid\u00e8le, Yana, de quinze ans sa cadette, architecte et femme fatale, Iris, jeune \u00e9tudiante adepte du bouddhisme. Sans le savoir, ces trois femmes partagent deux choses : le m\u00eame immeuble mais surtout \u2026 le m\u00eame homme ! Alors, quand elles l\u2019apprennent, chacune se lance avec ses armes dans une bataille pour garder \u00ab son homme \u00bb et c\u2019est par mail qu\u2019elles joutent ; \u00e9changes caustiques, piquants, dr\u00f4les o\u00f9 fusent des v\u00e9rit\u00e9s sur le couple, la fid\u00e9lit\u00e9, l\u2019amour, la s\u00e9duction et l\u2019\u00e2ge. Les sentiments s\u2019exacerbent. La haine c\u00f4toie la jalousie et la complicit\u00e9. Qui l\u2019emportera ? P\u00e9n\u00e9trez dans l\u2019immeuble et vous verrez par vous-m\u00eame ...","performers":"De Esther Vilar, traduit par Sacha Zilberfarb, Marc Laigner Mise en sc\u00e8ne de Jackie Pr\u00e9seau Avec Magali Brouart, Jessica Delore, Jackie Pr\u00e9seau","boxoffice_url":null,"website":"http:\/\/lafluteenchantee.be\/jalousie-en-trois-mails\/","email":"la.flute.enchantee@skynet.be","phone_contact":"+32 2 660 79 50","phone_booking":"+32 2 660 79 50","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50000405"},"sp":{"name":"Jalousie en trois mails","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/lafluteenchantee.be\/jalousie-en-trois-mails\/","email":"la.flute.enchantee@skynet.be","phone_contact":"+32 2 660 79 50","phone_booking":"+32 2 660 79 50","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50000405"},"nl":{"name":"Jalousie en trois mails","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/lafluteenchantee.be\/jalousie-en-trois-mails\/","email":"la.flute.enchantee@skynet.be","phone_contact":"+32 2 660 79 50","phone_booking":"+32 2 660 79 50","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50000405"}},"place":{"id":238674,"translations":{"de":{"name":"Th\u00e9\u00e2tre de La Fl\u00fbte Enchant\u00e9e","address_street_name":"Rue du Printemps","address_street_number":"18","address_street_box":null,"email":"la.flute.enchantee@skynet.be","website":"http:\/\/www.lafluteenchantee.be","phone_con