:{"name":"Sur un air d'op\u00e9ra","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.bruxellesbavard.be\/fr\/visites-pour-individuels","email":"info@bruxellesbavard.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50010925"},"cn":{"name":"Sur un air d'op\u00e9ra","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.bruxellesbavard.be\/fr\/visites-pour-individuels","email":"info@bruxellesbavard.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50010925"},"fr":{"name":"Sur un air d'op\u00e9ra","shortdescr":null,"longdescr":"\nDepuis ses origines, Bruxelles se partage entre le haut de la ville (les lieux de pouvoir r\u00e9serv\u00e9s aux \u00e9lites) et le bas de ville (les lieux de commerces, plus populaires). Cette visite vous emm\u00e8ne \u00e0 la d\u00e9couverte des points de vues cr\u00e9\u00e9s entre \"la ville haute\" et la \"ville basse\". Une politique urbanistique de cr\u00e9ation de points de vue qui ne doit rien au hasard et refl\u00e8te une certaine conception de la ville sous le r\u00e8gne de L\u00e9opold II, conforme \u00e0 sa vision de l'embellissement de la capitale.\n\nD\u00e9part : devant le Botanique (rue Royale 236).","performers":null,"boxoffice_url":null,"website":"https:\/\/www.bruxellesbavard.be\/fr\/visites-pour-individuels","email":"info@bruxellesbavard.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50010925"},"sp":{"name":"Sur un air d'op\u00e9ra","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.bruxellesbavard.be\/fr\/visites-pour-individuels","email":"info@bruxellesbavard.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50010925"},"nl":{"name":"Sur un air d'op\u00e9ra","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.bruxellesbavard.be\/fr\/visites-pour-individuels","email":"info@bruxellesbavard.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50010925"}},"place":{"last_updated_at":"2023-10-25T09:28:08+02:00","published_at":"2013-10-19T01:13:21+02:00","id":1491,"translations":{"de":{"name":"Bruxelles Bavard ","address_street_name":"Rue des Thuyas","address_street_number":"12","address_street_box":null,"email":"info@bruxellesbavard.be","website":"http:\/\/www.bruxellesbavard.be","phone_contact":"+32 2 673 18 35","phone_booking":null,"address_zip":"1170","address_city":"Watermael-Boitsfort","address_line1":"Rue des Thuyas, 12","address_line2":"1170 Watermael-Boitsfort","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Bruxelles Bavard ","address_street_name":"Rue des Thuyas","address_street_number":"12","address_street_box":null,"email":"info@bruxellesbavard.be","website":"http:\/\/www.bruxellesbavard.be","phone_contact":"+32 2 673 18 35","phone_booking":null,"address_zip":"1170","address_city":"Watermael-Boitsfort","address_line1":"Rue des Thuyas, 12","address_line2":"1170 Watermael-Boitsfort","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Brussels Chatterguides","address_street_name":"Rue des Thuyas","address_street_number":"12","address_street_box":null,"email":"info@brusselschatterguides.be","website":"http:\/\/www.brusselschatterguides.be","phone_contact":"+32 2 673 18 35","phone_booking":null,"address_zip":"1170","address_city":"Watermael-Boitsfort","address_line1":"Rue des Thuyas, 12","address_line2":"1170 Watermael-Boitsfort","description_web":"The Chatterguides : an irresi