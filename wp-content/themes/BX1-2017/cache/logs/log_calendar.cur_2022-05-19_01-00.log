n":true,"hours":[{"start":"07:00:00","end":"21:00:00"}]},"sunday":{"is_open":true,"hours":[{"start":"07:00:00","end":"21:00:00"}]}},"translations":{"fr":["lundi, mardi, mercredi, jeudi, vendredi, samedi et dimanche: de 07:00 \u00e0 21:00"],"nl":["maandag, dinsdag, woensdag, donderdag, vrijdag, zaterdag en zondag: van 07:00 tot 21:00"],"en":["monday, tuesday, wednesday, thursday, friday, saturday and sunday: from 07:00 to 21:00"]},"date_start":"2021-06-29","date_end":"2022-12-31","is_also_by_appointment":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":24}],"child_events":[],"parent_events":[],"targets":{"list":[19,11,12,10],"translations":{"fr":["Enseignants","Famille","LGTBQIA","Seniors"],"nl":["Leerkrachten","Familie","LGTBQIA","Senioren"],"en":["Teachers","Family","LGTBQIA","Seniors"]}},"educational_targets":{"list":[3],"translations":{"fr":["Secondaire"],"nl":["Secundair onderwijs"],"en":["Secondary school"]}},"tags":["exterior","kids"],"accessibilities":{"list":[266],"translations":{"fr":["Brussels Health Safety Label"],"nl":["Brussels Health Safety Label"],"en":["Brussels Health Safety Label"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-05-18T01:06:19+02:00","published_at":"2021-06-29T14:54:48+02:00","backoffice_id":234628,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.12197836292507},{"id":532480,"date_start":"2022-04-28","date_end":"2022-09-25","date_next":"2022-05-18","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[24,32],"translations":{"fr":["Galeries d'art","Design"],"nl":["Galeries","Design"],"en":["Art Galleries","Design"]}}},"languages":{"spoken":["nl","fr"],"subtitles":[]},"translations":{"fr":{"name":"Le modernisme Ludique. Ganshoren 1958.","shortdescr":"Au programme sont pr\u00e9vues de nombreuses d\u00e9couvertes autour de l\u2019architecture des ann\u00e9es 50. Le tout prendra place au travers des visites guid\u00e9es, des plans promenades, des vid\u00e9os\u2026 de quoi vous initier avec enthousiasme \u00e0 l\u2019esth\u00e9tique audacieuse et color\u00e9e du modernisme ludique !","longdescr":"ARCHistory, en collaboration avec les services Culture Franc\u0327aise et Ne\u0301erlandaise,  vous proposent de de\u0301couvrir un pavillon pop-up de\u0301die\u0301 a\u0300 l\u2019architecte ganshorenois Raoul J. Brunswyck (1924-1979). Cet illustre repr\u00e9sentant du modernisme ludique, connu sous le nom de style 58, a construit une cinquantaine d\u2019habitations a\u0300 Ganshoren. L\u2019exposition se tiendra au 31 avenue de Villegas, dans le hall raffine\u0301 du bureau de l\u2019architecte Brunswyck.","performers":"ARCHIstory, Urban, service de la culture fran\u00e7aise de Ganshoren, service de la culture n\u00e9erlandaise de Ganshoren","boxoffice_url":null,"website":"https:\/\/www.ganshoren.be\/agenda\/raoulbrunswyck\/","email":"info.brunswyck@ganshoren.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/532480.html"},"nl":{"name":"Het Speels Modernisme. Ganshoren 1958.","shortdescr":"Duik in de architectuur van de jaren vijftig aan de hand van een gevarieerd programma. Rondleidingen, wandelkaarten, video's... genoeg om enthousiast kennis te maken met de gedurfde en kleurrijke esthetiek van het speelse modernisme!","longdescr":"De erfgoedvereniging ARCHistory, in samenwerking met de diensten Nederlandse en Franse Cultuur nodigen je uit om een pop-up paviljoen te ontdekken, gewijd aan de Ganshorense architect Raoul J. Brunswyck (1924-1979). Brunswyck is een belangrijke vertegenwoordiger van het speelse modernisme, in de nasleep van de Expo 58, en bouwde in Ganshoren zo\u2019n 50-tal woningen. De expo loopt in de prachtige inkomhal van het voormalig architectenbureau van de vennoten Brunswyck en Odon Wathelet, waar sinds kort de gemeentelijke cultuurdiensten ondergebracht zijn.","performers":"ARCHIstory, Urban, Dienst franse cultuur van Ganshoren, Dienst nederlandse cultuur van Ganshoren","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/532480.html"},"en":{"name":"Le modernisme Ludique. Ganshoren 1958.","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/532480.html"},"de":{"name":"Exposition 'Le modernisme Ludique. Ganshoren 1958.\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/532480.html"},"it":{"name":"Exposition 'Le modernisme Ludique. Ganshoren 1958.\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/532480.html"},"sp":{"name":"Exposition 'Le modernisme Ludique. Ganshoren 1958.\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/532480.html"},"pt":{"name":"Exposition 'Le modernisme Ludique. Ganshoren 1958.\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/532480.html"},"cn":{"name":"Exposition 'Le 