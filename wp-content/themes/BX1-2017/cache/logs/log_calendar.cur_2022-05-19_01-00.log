":false,"is_only_by_appointment":true,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{"list":[105],"translations":{"fr":["Gastronomie"],"nl":["Gastronomie"],"en":["Gastronomy"]}}},"languages":{"spoken":["fr","en"],"subtitles":[]},"translations":{"fr":{"name":"Visites de la Fermenterie de l'Annexe","shortdescr":"Venez visiter une brasserie\/fermenterie o\u00f9 tradition et innovation font la part-belle au go\u00fbt.","longdescr":"La bi\u00e8re fait partie int\u00e9grante du patrimoine culturel belge, et Bruxelles ne fait pas exception \u00e0 l'affaire. Le secteur brassicole reprend du poil de la b\u00eate depuis quelques ann\u00e9es, et certaines se font fer de lance de l'innovation et du retour \u00e0 la tradition. Parmi celles-ci: l'Annexe. Venez d\u00e9couvrir leur histoire et ce qui fait de cette brasserie un lieu unique!\r\nEn plus: une d\u00e9gustation comment\u00e9e de bi\u00e8res et de ferments!","performers":"Cedric Jamar (guide)","boxoffice_url":null,"website":"http:\/\/www.agalmalt.com","email":"hello@agalmalt.com","phone_contact":null,"phone_booking":"+32 486 70 57 43","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/517605.html"},"nl":{"name":"Visites de la Fermenterie de l'Annexe","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/517605.html"},"en":{"name":"L'Annexe Brewery Tours","shortdescr":"Come to visit a craft brewery where tradition and innovation have one and only one purpose: taste.","longdescr":"Beer is part of our cultural legacy in Belgium, and Brussels takes its own share of it. The brewing industry is having its renewal for quite a while now, and some of them are part of the cutting edge of it. A blatant example of the perfect blending of innovation with tradition in beer: l'Annexe. Come and discover the story behind the legend, and find out what makes this place so unique! And after that: we'll share a flight together!","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/517605.html"},"de":{"name":"Visites de la Fermenterie de l'Annexe","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/517605.html"},"it":{"name":"Visites de la Fermenterie de l'Annexe","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/517605.html"},"sp":{"name":"Visites de la Fermenterie de l'Annexe","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/517605.html"},"pt":{"name":"Visites de la Fermenterie de l'Annexe","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/517605.html"},"cn":{"name":"Visites de la Fermenterie de l'Annexe","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/517605.html"}},"place":{"id":277098,"translations":{"fr":{"name":"Fermenterie l'Annexe","address_street_name":"Rue du M\u00e9tal","address_street_number":"19","address_street_box":null,"email":"info@lannexe.brussels","website":"http:\/\/www.lannexe.brussels\/","phone_con