s_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2023-10-02T02:03:28+02:00","published_at":"2023-08-17T14:53:56+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":283434,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"tour","ranking":0.23454855722982174,"languages":{"spoken":["nl","en","fr"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{"list":[112],"translations":{"de":["Ausgefallenes"],"pt":[null],"en":["Unusual"],"it":["Insolito"],"cn":[null],"fr":["Insolite"],"sp":["Ins\u00f3lito"],"nl":["Ongewoon"]}}},"translations":{"de":{"name":"First Sunday of the month: Sewer Museum","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/sewermuseum.brussels\/news\/premier-dimanche-du-mois-gratuit\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50001041"},"pt":{"name":"First Sunday of the month: Sewer Museum","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/sewermuseum.brussels\/news\/premier-dimanche-du-mois-gratuit\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50001041"},"en":{"name":"First Sunday of the month: Sewer Museum","shortdescr":"FREE ENTRANCE FIRST SUNDAY OF THE MONTH\n\nFree entrance on every first Sunday of the month! Explorer notebooks for the little ones and audio guides in which you play the leading role are available on demand at the reception.  Curious? Come and visit us!\n","longdescr":"PRACTICAL INFORMATION\n\nFree entrance on every first Sunday of the month! Explorer notebooks for the little ones and audio guides in which you play the leading role are available on demand at the reception.  Curious? Come and visit us!\n\nDates: 05.02, 05.03, 02.04, 07.05, 04.06, 02.07, 06.08, 03.09, 01.10, 05.11, 03.12\nFree admission\nWe recommend booking your visit for greater convenience. To book, see our website.\nDiscover also the first Sunday of the month at the Brussels City Museum, the Fashion & Lace Museum and the GardeRobe MannekenPis.","performers":null,"boxoffice_url":null,"website":"https:\/\/sewermuseum.brussels\/news\/premier-dimanche-du-mois-gratuit\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50001041"},"it":{"name":"First Sunday of the month: Sewer Museum","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/sewermuseum.brussels\/news\/premier-dimanche-du-mois-gratuit\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50001041"},"cn":{"name":"First Sunday of the month: Sewer Museum","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/sewermuseum.brussels\/news\/premier-dimanche-du-mois-gratuit\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50001041"},"fr":{"name":"Premier dimanche du mois: Mus\u00e9e des \u00e9gouts","shortdescr":"PREMIER DIMANCHE DU MOIS GRATUIT\n\nLe Mus\u00e9e vous ouvre gratuitement ses portes chaque premier dimanche du mois.\n\nPour vous accompagner dans sa d\u00e9couverte, le mus\u00e9e vous propose des visites guid\u00e9es gratuites. Des audioguides et le carnet d\u2019explorateur pour les plus petits sont disponibles \u00e0 l\u2019acceuil.","longdescr":"PREMIER DIMANCHE DU MOIS GRATUIT\n\nLe Mus\u00e9e vous ouvre gratuitement ses portes chaque premier dimanche du mois.\n\nPour vous accompagner dans sa d\u00e9couverte, le mus\u00e9e vous propose des visites guid\u00e9es gratuites. Des audioguides et le carnet d\u2019explorateur pour les plus petits sont disponibles \u00e0 l\u2019acceuil.\n\nINFORMATIONS PRATIQUES\n\nDates : 05.02, 05.03, 02.04, 07.05, 04.06, 02.07, 06.08, 03.09, 01.10, 05.11, 03.12\nLe mus\u00e9e est ferm\u00e9 le 01.01.23\nEntr\u00e9es et visites guid\u00e9es gratuites\nVisites guid\u00e9es \u00e0 14h\nLa r\u00e9servation de la visite guid\u00e9e est obligatoire car les places sont limit\u00e9es. Pour r\u00e9server, c\u2019est sur notre site.\nPour votre confort, nous vous recommandons de r\u00e9server votre visite via notre plateforme de r\u00e9servation.\nD\u00e9couvrez aussi les premiers dimanches du mois au Mus\u00e9e de la Ville de Bruxelles, Mus\u00e9e Mode & Dentelle et \u00e0 la GardeRobe MannekenPis.","performers":null,"boxoffice_url":null,"website":"https:\/\/sewermuseum.brussels\/news\/premier-dimanche-du-mois-gratuit\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50001041"},"sp":{"name":"First Sunday of the month: Sewer Museum","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/sewermuseum.brussels\/news\/premier-dimanche-du-mois-gratuit\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50001041"},"nl":{"name":"Eerste zondag van de maand: Riolenmuseum","shortdescr":"GRATIS TOEGANG EERSTE ZONDAG VAN DE MAAND\n\nElke eerste zondag van de maand opent het museum gratis de deuren. Om u door te collecties te begeleiden, biedt het museum ook gratis rondleidingen aan. Voor de kleinsten is er een ontdekkingsgids beschikbaar en we bieden ook een ludieke audiogids aan.","longdescr":"GRATIS TOEGANG EERSTE ZONDAG VAN DE MAAND\n\nElke eerste zondag van de maand opent het museum gratis de deuren. Om u door te collecties te begeleiden, biedt het museum ook gratis rondleidingen aan. Voor de kleinsten is er een ontdekkingsgids beschikbaar en we bieden ook een ludieke audiogids aan.\n\nPRAKTISCHE INFORMATIE\n\nData: 05.02, 05.03, 02.04, 07.05, 04.06, 02.07, 06.08, 03.09, 01.10, 05.11, 03.12.\nToegang en rondleiding zijn gratis\nRondleiding om 15u30\nReserveren voor de rondleiding is aanbevolen, want de plaatsen zijn beperkt. Om te reserveren, ga naar onze website.\nVoor uw gemak raden wij u aan uw bezoek te boeken via ons boekingsplatform.\nOntdek ook gratis de eerste zondag van de maand het Museum van de Stad Brussel, het Mode en Kant Museum en de GardeRobe MannekenPis.","performers":null,"boxoffice_url":null,"website":"https:\/\/sewermuseum.brussels\/news\/premier-dimanche-du-mois-gratuit\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50001041"}},"place":{"id":231869,"translations":{"de":{"name":"Kanalisationsmuseum (Mus\u00e9e des \u00c9gouts)","address_street_name":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museedesegouts.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_line2":"1000 Bruxelles","description_web":"Das Kanalisationsmuseum f\u00fchrt Sie hinab in die Unterwelten der Br\u00fcsseler Kanalisation. Entdecken Sie die Geheimnisse des faszinierenden, 400 Kilometer langen Labyrinths, das sich unter dem Br\u00fcsseler Stadtgebiet auftut. Tausende Kubikmeter Wasser flie\u00dfen t\u00e4glich durch die Br\u00fcsseler Abwasserkanalisation. Was mit ihnen geschieht, welche Wege sie nehmen, erfahren Sie im Kanalisationsmuseum - ein Museum mit vielen interessanten Details f\u00fcr Gro\u00df und Klein: Geschichtliches, Technisches und Am\u00fcsantes.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Mus\u00e9e des \u00c9gouts - Mus\u00e9es de la Ville de Bruxelles","address_street_name":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museedesegouts.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Sewers Museum ","address_street_name":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.sewermuseum.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_line2":"1000 Bruxelles","description_web":"Why not visit the Brussels sewers and the Sewers museum during your next excursion in Brussels. A visit of Brussels' sewerage network - led by experienced guides or ex-workers - is extraordinary, full of surprises, but above all fascinating. The sewers have become vital to our way of life, so much so that it's hard to imagine what it was like before they existed. A visit of the Sewers Museum (and a real sewer!) is therefore an amazing, unusual and thrilling experience.\r\nBrussels' first sewerage network came into use in the 17th century, but they were very limited and a large part of the city's waste still found its way into the river Senne. The river carried waste and carrion and regularly overflowed, or dried out in the summer, leaving behind less-than-pleasant smells.\r\nIt was partially due to this, that the government in the second half of the 19th century decided to completely transform the Senne and its neighbouring streets by building great boulevards to cover the insalubrious area. Between the two world wars a second transformation: a portion of the Senne was diverted and then covered over. The sewerage network improved and grew over the years, going from 45 km in 1847 to the 350 km that we have today.\r\n The entrance to the museum is housed in one of the toll pavilions that used to collect taxes on goods that entered the city.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Mus\u00e9e des \u00c9gouts - Mus\u00e9es de la Ville de Bruxelles","address_street_name":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museedesegouts.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Mus\u00e9e des \u00c9gouts - Mus\u00e9es de la Ville de Bruxelles","address_street_name":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museedesegouts.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"fr":{"name":"Mus\u00e9e des Egouts","address_street_name":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museedesegouts.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_line2":"1000 Bruxelles","description_web":"Au premier abord, on n\u2019y aurait pas pens\u00e9\u2026 Aller visiter les \u00e9gouts d\u2019une grande ville ? Mais en y r\u00e9fl\u00e9chissant un court instant, on per\u00e7oit vite l\u2019int\u00e9r\u00eat et les apprentissages potentiels ! Cet endroit qu\u2019aujourd\u2019hui on n\u2019imagine pas autrement qu\u2019enfoui\u2026 n\u2019a pas toujours exist\u00e9 sous cette forme, loin s\u2019en faut !\r\nC\u2019est au 17e si\u00e8cle que se met en place \u00e0 Bruxelles le premier r\u00e9seau d\u2019\u00e9gouts ; toutefois celui-ci reste \u00e9l\u00e9mentaire et bon nombre de d\u00e9chets terminent encore leur itin\u00e9raire dans le cours d\u2019eau bruxellois, la Senne. Celle-ci charrie d\u00e9tritus et charognes, et d\u00e9borde r\u00e9guli\u00e8rement en temps de pluie, ou s\u2019ass\u00e8che en \u00e9t\u00e9, laissant s\u2019\u00e9chapper des odeurs peu subtiles\u2026\r\nUn grand plan d\u2019assainissement est ex\u00e9cut\u00e9 dans la seconde moiti\u00e9 du 19e si\u00e8cle. On d\u00e9cide de vo\u00fbter la Senne et d\u2019\u00e9tablir de larges boulevards \u00e0 la place des ruelles insalubres. Durant l\u2019entre-deux-guerres, une deuxi\u00e8me entreprise de d\u00e9tournement et de vo\u00fbtement du cours d\u2019eau viendra renforcer l\u2019efficacit\u00e9 des premiers travaux.\r\nProgressivement, le r\u00e9seau des \u00e9gouts va se perfectionner et s\u2019agrandir : comptant 45 km en 1847, on d\u00e9nombre actuellement 350 km de d\u00e9dales souterrains, qui recueillent conjointement les eaux pluviales et les eaux us\u00e9es provenant de l\u2019activit\u00e9 humaine. \r\n\r\nAper\u00e7u de ce r\u00e9seau, explications sur son histoire et le travail des hommes qui l\u2019entretiennent, cycle de l\u2019eau, etc. : ce sont l\u00e0 quelques-unes des th\u00e9matiques qui vous y attendent ! Notez que l\u2019entr\u00e9e du mus\u00e9e si\u00e8ge dans un des deux \u00ab pavillons d\u2019octroi \u00bb, b\u00e2timents qui mat\u00e9rialisent la perception de la taxe sur tous les biens entrant dans la Ville au 19e si\u00e8cle.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Museo del Alcantarillado (Mus\u00e9e des Egouts)","address_street_name":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museedesegouts.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_line2":"1000 Bruxelles","description_web":"En un primer momento, a uno no se le pasar\u00eda por la cabeza... \u00bfIr a visitar las alcantarillas de una gran ciudad? Pero si te paras a pensarlo, \u00a1ver\u00e1s r\u00e1pidamente el potencial de aprendizaje y el inter\u00e9s! Este lugar que, actualmente, solo nos imaginamos bajo tierra no siempre lo ha estado, ni mucho menos. En el siglo XVII se cre\u00f3 el primer sistema de alcantarillado en Bruselas; sin embargo, segu\u00eda siendo b\u00e1sico y muchos residuos terminaban su recorrido en el r\u00edo de la ciudad, el Senne. Este r\u00edo, que llevaba basura y carro\u00f1a, se sol\u00eda desbordar normalmente en \u00e9poca de lluvias, o se secaba en verano, lo que hac\u00eda que desprendiera olores desagradables...\r\nEn la segunda mitad del siglo XIX se puso en marcha un importante plan de saneamiento.\r\nSe decidi\u00f3 recubrir el Senne y crear amplios bulevares en lugar de callejones insalubres. Durante el per\u00edodo de entreguerras, unas segundas obras de recubrimiento y desv\u00edo del agua reforzaron las primeras. Gradualmente, el sistema de alcantarillado se mejor\u00f3 y ampli\u00f3: de 45 km en 1847, actualmente hay 350 km de laberintos subterr\u00e1neos, que recogen conjuntamente el agua de lluvia y las aguas residuales de la ciudad. El museo se inaugur\u00f3 en 1988 como respuesta a una demanda creciente y ofrece visitas realizadas por el propio personal del Servicio de Alcantarillado. Gracias a este museo podr\u00e1s disfrutar de una perspectiva general de esta red, explicaciones sobre su historia y sobre la labor que desempe\u00f1an sus trabajadores, informaci\u00f3n sobre el ciclo hidrol\u00f3gico, etc. Cabe destacar que la entrada al museo se encuentra en uno de los dos Pavillons d\u2019octroi, los edificios donde se recaudaban los impuestos de todas las mercanc\u00edas que entraban en la ciudad en el siglo XIX.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Riolenmuseum","address_street_name":"Octrooipaviljoen, Anderlechtsepoort","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.riolenmuseum.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Octrooipaviljoen, Anderlechtsepoort","address_line2":"1000 Bruxelles","description_web":"Zet eens een bezoek aan de Brusselse riolen en het Riolenmuseum op het programma van een uitstap in Brussel! Apart, ongewoon en onverwacht, maar vooral interessant en allesbehalve saai is zo\u2019n afdaling in ondergronds Brussel, begeleid door ervaren stadsgidsen of (voormalige) rioolwerkers.\r\nRiolen zijn levensnoodzakelijk geworden voor onze manier van leven, vandaar dat we ons maar moeilijk kunnen voorstellen hoe het eraan toeging toen ze nog niet bestonden. Een bezoek aan het Riolenmuseum (en een echte riool!) is dan ook verrassend, ongewoon en ongemeen boeiend.\r\nIn de 17de eeuw werd in Brussel een eerste riolennet in gebruik genomen. Dat bleef nog erg beperkt en het overgrote deel van het afvalwater vond nog altijd zijn weg naar die ene Brusselse rivier, de Zenne. Die voerde dan ook een smurrie van afval, viezigheid en zelfs dierenkadavers de hele stad door. Als de Zenne bij overvloedige regen overstroomde of in volle zomer opdroogde in de zomer, zorgde dat natuurlijk voor weinig aangename geurtjes...\r\nGedeeltelijk omwille van die overlast besloot de overheid in de tweede helft van de 19de eeuw om een overwelving aan te brengen boven de Zenne en grote boulevards aan te leggen in plaats van de vieze en slordige steegjes. Later werd tussen de twee Wereldoorlogen nog een tweede keer ingegrepen: een deel van de Zenne werd verlegd en er werden nog meer overwelvingen aangebracht. \r\nLangzamerhand verbeterde en vergrootte het riolennet, van 45 km in 1847 naar de huidige 350 km riool, die zowel afval- als regenwater afvoert. \r\nNaast een bezoek aan de riolen zelf levert dit museum een schat aan boeiende en interessante informatie op over alle aspecten van riolen, rioolwater en de mensen die ze \u2013 vaak in gevaarlijke en altijd in onaangename omstandigheden - onderhouden. Leuk: de ingang van het museum is gehuisvest in een van de twee octrooipaviljoenen aan de Anderlechtse Poort, waar vroeger tol werd geheven op goederen die in de stad werden binnengebracht.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[21],"translations":{"de":["S\u00fcden"],"pt":[null],"en":["South"],"it":["Sud"],"cn":[null],"fr":["Sud"],"sp":["Sur"],"nl":["Zuid"]}},"neca":null,"facebook_id":null,"backoffice_id":989,"location":{"lat":50.82833819,"lon":4.31090786},"region":"brussels","last_updated_at":"2023-08-02T11:39:17+02:00","published_at":"2013-10-19T01:13:58+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":231869,"translations":{"de":{"name":"Kanalisationsmuseum (Mus\u00e9e des \u00c9gouts)","address_street_name":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museedesegouts.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_line2":"1000 Bruxelles","description_web":"Das Kanalisationsmuseum f\u00fchrt Sie hinab in die Unterwelten der Br\u00fcsseler Kanalisation. Entdecken Sie die Geheimnisse des faszinierenden, 400 Kilometer langen Labyrinths, das sich unter dem Br\u00fcsseler Stadtgebiet auftut. Tausende Kubikmeter Wasser flie\u00dfen t\u00e4glich durch die Br\u00fcsseler Abwasserkanalisation. Was mit ihnen geschieht, welche Wege sie nehmen, erfahren Sie im Kanalisationsmuseum - ein Museum mit vielen interessanten Details f\u00fcr Gro\u00df und Klein: Geschichtliches, Technisches und Am\u00fcsantes.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Mus\u00e9e des \u00c9gouts - Mus\u00e9es de la Ville de Bruxelles","address_street_name":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museedesegouts.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Sewers Museum ","address_street_name":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.sewermuseum.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_line2":"1000 Bruxelles","description_web":"Why not visit the Brussels sewers and the Sewers museum during your next excursion in Brussels. A visit of Brussels' sewerage network - led by experienced guides or ex-workers - is extraordinary, full of surprises, but above all fascinating. The sewers have become vital to our way of life, so much so that it's hard to imagine what it was like before they existed. A visit of the Sewers Museum (and a real sewer!) is therefore an amazing, unusual and thrilling experience.\r\nBrussels' first sewerage network came into use in the 17th century, but they were very limited and a large part of the city's waste still found its way into the river Senne. The river carried waste and carrion and regularly overflowed, or dried out in the summer, leaving behind less-than-pleasant smells.\r\nIt was partially due to this, that the government in the second half of the 19th century decided to completely transform the Senne and its neighbouring streets by building great boulevards to cover the insalubrious area. Between the two world wars a second transformation: a portion of the Senne was diverted and then covered over. The sewerage network improved and grew over the years, going from 45 km in 1847 to the 350 km that we have today.\r\n The entrance to the museum is housed in one of the toll pavilions that used to collect taxes on goods that entered the city.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Mus\u00e9e des \u00c9gouts - Mus\u00e9es de la Ville de Bruxelles","address_street_name":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museedesegouts.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Mus\u00e9e des \u00c9gouts - Mus\u00e9es de la Ville de Bruxelles","address_street_name":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museedesegouts.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"fr":{"name":"Mus\u00e9e des Egouts","address_street_name":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museedesegouts.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_line2":"1000 Bruxelles","description_web":"Au premier abord, on n\u2019y aurait pas pens\u00e9\u2026 Aller visiter les \u00e9gouts d\u2019une grande ville ? Mais en y r\u00e9fl\u00e9chissant un court instant, on per\u00e7oit vite l\u2019int\u00e9r\u00eat et les apprentissages potentiels ! Cet endroit qu\u2019aujourd\u2019hui on n\u2019imagine pas autrement qu\u2019enfoui\u2026 n\u2019a pas toujours exist\u00e9 sous cette forme, loin s\u2019en faut !\r\nC\u2019est au 17e si\u00e8cle que se met en place \u00e0 Bruxelles le premier r\u00e9seau d\u2019\u00e9gouts ; toutefois celui-ci reste \u00e9l\u00e9mentaire et bon nombre de d\u00e9chets terminent encore leur itin\u00e9raire dans le cours d\u2019eau bruxellois, la Senne. Celle-ci charrie d\u00e9tritus et charognes, et d\u00e9borde r\u00e9guli\u00e8rement en temps de pluie, ou s\u2019ass\u00e8che en \u00e9t\u00e9, laissant s\u2019\u00e9chapper des odeurs peu subtiles\u2026\r\nUn grand plan d\u2019assainissement est ex\u00e9cut\u00e9 dans la seconde moiti\u00e9 du 19e si\u00e8cle. On d\u00e9cide de vo\u00fbter la Senne et d\u2019\u00e9tablir de larges boulevards \u00e0 la place des ruelles insalubres. Durant l\u2019entre-deux-guerres, une deuxi\u00e8me entreprise de d\u00e9tournement et de vo\u00fbtement du cours d\u2019eau viendra renforcer l\u2019efficacit\u00e9 des premiers travaux.\r\nProgressivement, le r\u00e9seau des \u00e9gouts va se perfectionner et s\u2019agrandir : comptant 45 km en 1847, on d\u00e9nombre actuellement 350 km de d\u00e9dales souterrains, qui recueillent conjointement les eaux pluviales et les eaux us\u00e9es provenant de l\u2019activit\u00e9 humaine. \r\n\r\nAper\u00e7u de ce r\u00e9seau, explications sur son histoire et le travail des hommes qui l\u2019entretiennent, cycle de l\u2019eau, etc. : ce sont l\u00e0 quelques-unes des th\u00e9matiques qui vous y attendent ! Notez que l\u2019entr\u00e9e du mus\u00e9e si\u00e8ge dans un des deux \u00ab pavillons d\u2019octroi \u00bb, b\u00e2timents qui mat\u00e9rialisent la perception de la taxe sur tous les biens entrant dans la Ville au 19e si\u00e8cle.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Museo del Alcantarillado (Mus\u00e9e des Egouts)","address_street_name":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museedesegouts.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_line2":"1000 Bruxelles","description_web":"En un primer momento, a uno no se le pasar\u00eda por la cabeza... \u00bfIr a visitar las alcantarillas de una gran ciudad? Pero si te paras a pensarlo, \u00a1ver\u00e1s r\u00e1pidamente el potencial de aprendizaje y el inter\u00e9s! Este lugar que, actualmente, solo nos imaginamos bajo tierra no siempre lo ha estado, ni mucho menos. En el siglo XVII se cre\u00f3 el primer sistema de alcantarillado en Bruselas; sin embargo, segu\u00eda siendo b\u00e1sico y muchos residuos terminaban su recorrido en el r\u00edo de la ciudad, el Senne. Este r\u00edo, que llevaba basura y carro\u00f1a, se sol\u00eda desbordar normalmente en \u00e9poca de lluvias, o se secaba en verano, lo que hac\u00eda que desprendiera olores desagradables...\r\nEn la segunda mitad del siglo XIX se puso en marcha un importante plan de saneamiento.\r\nSe decidi\u00f3 recubrir el Senne y crear amplios bulevares en lugar de callejones insalubres. Durante el per\u00edodo de entreguerras, unas segundas obras de recubrimiento y desv\u00edo del agua reforzaron las primeras. Gradualmente, el sistema de alcantarillado se mejor\u00f3 y ampli\u00f3: de 45 km en 1847, actualmente hay 350 km de laberintos subterr\u00e1neos, que recogen conjuntamente el agua de lluvia y las aguas residuales de la ciudad. El museo se inaugur\u00f3 en 1988 como respuesta a una demanda creciente y ofrece visitas realizadas por el propio personal del Servicio de Alcantarillado. Gracias a este museo podr\u00e1s disfrutar de una perspectiva general de esta red, explicaciones sobre su historia y sobre la labor que desempe\u00f1an sus trabajadores, informaci\u00f3n sobre el ciclo hidrol\u00f3gico, etc. Cabe destacar que la entrada al museo se encuentra en uno de los dos Pavillons d\u2019octroi, los edificios donde se recaudaban los impuestos de todas las mercanc\u00edas que entraban en la ciudad en el siglo XIX.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Riolenmuseum","address_street_name":"Octrooipaviljoen, Anderlechtsepoort","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.riolenmuseum.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Octrooipaviljoen, Anderlechtsepoort","address_line2":"1000 Bruxelles","description_web":"Zet eens een bezoek aan de Brusselse riolen en het Riolenmuseum op het programma van een uitstap in Brussel! Apart, ongewoon en onverwacht, maar vooral interessant en allesbehalve saai is zo\u2019n afdaling in ondergronds Brussel, begeleid door ervaren stadsgidsen of (voormalige) rioolwerkers.\r\nRiolen zijn levensnoodzakelijk geworden voor onze manier van leven, vandaar dat we ons maar moeilijk kunnen voorstellen hoe het eraan toeging toen ze nog niet bestonden. Een bezoek aan het Riolenmuseum (en een echte riool!) is dan ook verrassend, ongewoon en ongemeen boeiend.\r\nIn de 17de eeuw werd in Brussel een eerste riolennet in gebruik genomen. Dat bleef nog erg beperkt en het overgrote deel van het afvalwater vond nog altijd zijn weg naar die ene Brusselse rivier, de Zenne. Die voerde dan ook een smurrie van afval, viezigheid en zelfs dierenkadavers de hele stad door. Als de Zenne bij overvloedige regen overstroomde of in volle zomer opdroogde in de zomer, zorgde dat natuurlijk voor weinig aangename geurtjes...\r\nGedeeltelijk omwille van die overlast besloot de overheid in de tweede helft van de 19de eeuw om een overwelving aan te brengen boven de Zenne en grote boulevards aan te leggen in plaats van de vieze en slordige steegjes. Later werd tussen de twee Wereldoorlogen nog een tweede keer ingegrepen: een deel van de Zenne werd verlegd en er werden nog meer overwelvingen aangebracht. \r\nLangzamerhand verbeterde en vergrootte het riolennet, van 45 km in 1847 naar de huidige 350 km riool, die zowel afval- als regenwater afvoert. \r\nNaast een bezoek aan de riolen zelf levert dit museum een schat aan boeiende en interessante informatie op over alle aspecten van riolen, rioolwater en de mensen die ze \u2013 vaak in gevaarlijke en altijd in onaangename omstandigheden - onderhouden. Leuk: de ingang van het museum is gehuisvest in een van de twee octrooipaviljoenen aan de Anderlechtse Poort, waar vroeger tol werd geheven op goederen die in de stad werden binnengebracht.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":989,"location":{"lat":50.82833819,"lon":4.31090786},"last_updated_at":"2023-08-02T11:39:17+02:00","published_at":"2013-10-19T01:13:58+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/5a824b97cf2e807e5f2664b7e63002d9a8cd08f8.jpg","width":5333,"height":3000,"ratio":1,"oEmbed_height":3000,"oEmbed_width":5333,"translations":{"de":{"title":"Sewer Museum","copyright":null},"pt":{"title":"Sewer Museum","copyright":null},"en":{"title":"Sewer Museum","copyright":null},"it":{"title":"Sewer Museum","copyright":null},"cn":{"title":"Sewer Museum","copyright":null},"fr":{"title":"Sewer Museum","copyright":null},"sp":{"title":"Sewer Museum","copyright":null},"nl":{"title":"Sewer Museum","copyright":null}}}],"dates":[{"day":"2023-09-03","doors":null,"start":"10:00:00","end":"17:00:00","is_soldout":false,"is_canceled":false},{"day":"2023-10-01","doors":null,"start":"10:00:00","end":"17:00:00","is_soldout":false,"is_canceled":false},{"day":"2023-11-05","doors":null,"start":"10:00:00","end":"17:00:00","is_soldout":false,"is_canceled":false},{"day":"2023-12-03","doors":null,"start":"10:00:00","end":"17:00:00","is_soldout":false,"is_canceled":false},{"day":"2024-01-07","doors":null,"start":"10:00:00","end":"17:00:00","is_soldout":false,"is_canceled":false},{"day":"2024-02-04","doors":null,"start":"10:00:00","end":"17:00:00","is_soldout":false,"is_canceled":false}],"prices":[],"date_exceptions":[],"closing_days":[],"child_events":[],"parent_events":[],"accessibilities":[],"recurring":[{"day":"sunday","occurences":{"is_fourth":false,"is_last":false,"is_first":true,"is_second":false,"is_third":false},"time_start":"10:00:00","time_end":"17:00:00","translations":{"fr":"Ouvert le premier, dimanche du mois de 10:00 \u00e0 17:00","nl":"Open op de eerste, zondag van de maand van 10:00 tot 17:00","en":"Open the first, sunday of the month from 10:00 to 17:00"}}],"targets":{"list":[8,10,11],"translations":{"de":["Jugendliche 15-18 Jahre","Senioren","Familie"],"pt":[null,null,null],"en":["Youth 15-18  yr.","Seniors","Family"],"it":["Ragazzi 15-18 anni","Anziani","Famiglie"],"cn":[null,null,null],"fr":["Jeunes 15-18 ans","Seniors","Famille"],"sp":["J\u00f3venes de 15 a 18 a\u00f1os","Personas de la tercera edad","Familias"],"nl":["Jongeren 15-18 j.","Senioren","Familie"]}},"educational_targets":{"list":[],"translations":{}},"tags":["kids"]},{"id":561640,"date_start":"2023-09-17","date_end":"2024-02-25","date_next":"2023-11-05","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2023-10-10T14:15:12+02:00","published_at":"2023-07-10T11:47:33+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":281640,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"theatre","ranking":0.23112042478354491,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":49,"translations":{"de":"Theater","pt":null,"en":"Theatre","it":"Teatro","cn":null,"fr":"Th\u00e9\u00e2tre","sp":"Teatro","nl":"Theater"}},"others":{"list":[50],"translations":{"de":["Theater"],"pt":[null],"en":["Theatre"],"it":["Teatro"],"cn":[null],"fr":["Th\u00e9\u00e2tre"],"sp":["Teatro"],"nl":["Theater"]}}},"translations":{"de":{"name":"Quelle aventure ?","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Quelle-aventure","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.561640"},"pt":{"name":"Quelle aventure ?","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Quelle-aventure","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.561640"},"en":{"name":"Quelle aventure ?","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Quelle-aventure","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.561640"},"it":{"name":"Quelle aventure ?","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Quelle-aventure","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.561640"},"cn":{"name":"Quelle aventure ?","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Quelle-aventure","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.561640"},"fr":{"name":"Quelle aventure ?","shortdescr":"Un conte musical avec du beatbox dedans","longdescr":"Cette aventure, Florian Jubin ne la conna\u00eet pas encore car ce sont les enfants qui vont d\u00e9cider de ses ingr\u00e9dients. Quels personnages y d\u00e9couvrirons-nous ? Quelles sont leurs qualit\u00e9s, leurs d\u00e9fauts\u2026 ? Qu\u2019est-ce qu\u2019ils aiment bien, qu\u2019est-ce qu\u2019ils n\u2019aiment pas du tout ?\n\nLe com\u00e9dien r\u00e9unira tous ces \u00e9l\u00e9ments pour faire vivre une folle aventure \u00e0 ces personnages. Tout le long du spectacle, les enfants seront amen\u00e9s \u00e0 faire des propositions \u00e0 Florian pour basculer l\u2019histoire dans une direction ou dans une autre. Quelle que soit la proposition, m\u00eame la plus surprenante, le com\u00e9dien en jouera pour le plus grand plaisir des enfants.\n\nCerise sur le g\u00e2teau, Florian accompagnera cette histoire de chansons improvis\u00e9es, de musiques enti\u00e8rement faites \u00e0 la bouche compos\u00e9es en live sous vos yeux, gr\u00e2ce \u00e0 sa dr\u00f4le de machine : la Loopstation.\n\nUn spectacle interactif et ludique, avec ce grain de folie dont Florian a le secret pour le plaisir des petits et des grands.\n\nSpectacle pour enfants de 4 \u00e0 12 ans\n\nTeaser : https:\/\/youtu.be\/WzAola-SjAs","performers":"Florian Jubin","boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Quelle-aventure","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.561640"},"sp":{"name":"Quelle aventure ?","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Quelle-aventure","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.561640"},"nl":{"name":"Quelle aventure ?","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Quelle-aventure","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.561640"}},"place":{"id":270611,"translations":{"de":{"name":"Th\u00e9\u00e2tre l\u2019Improviste ","address_street_name":"Rue de Fierlant","address_street_number":"120","address_street_box":null,"email":null,"website":"http:\/\/www.improviste.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1190","addre