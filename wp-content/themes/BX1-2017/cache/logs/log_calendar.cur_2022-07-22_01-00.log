"fr"],"subtitles":[]},"translations":{"fr":{"name":"L\u2019h\u00f4tel de ville de Saint-Gilles, lieu de vie, d\u2019art et de m\u00e9moire","shortdescr":"Construit en 1912, cet h\u00f4tel de ville est un des plus beaux de notre capitale.","longdescr":"Construit en 1912, cet h\u00f4tel de ville est un des plus beaux de notre capitale. Con\u00e7u dans l\u2019ambiance optimiste de la Belle Epoque, il a fait appel aux meilleurs artistes pour illustrer la conviction que les progr\u00e8s de l\u2019humanit\u00e9 se feront par l\u2019Art, la Science, l\u2019Education, la D\u00e9mocratie, le Travail\u2026. Quel programme ! Et quelle r\u00e9ussite artistique marqu\u00e9e par l\u2019Art nouveau ! Notre parcours int\u00e9rieur et ext\u00e9rieur vous en donnera les cl\u00e9s et vous emm\u00e8nera de surprise en surprise : d\u00e9cors, sculptures, fresques, d\u00e9tails poignants ou cocasses nous raconteront l\u2019espoir centenaire d\u2019un monde meilleur et nous incitera \u00e0 r\u00e9fl\u00e9chir \u00e0 la place de ces valeurs de progr\u00e8s pour le temps pr\u00e9sent et pour l\u2019avenir.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.bruxellesbavard.be","email":"info@bruxellesbavard.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/530400.html"},"nl":{"name":"L\u2019h\u00f4tel de ville de Saint-Gilles, lieu de vie, d\u2019art et de m\u00e9moire","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.brusselbabbelt.be","email":"info@brusselbabbelt.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/530400.html"},"en":{"name":"L\u2019h\u00f4tel de ville de Saint-Gilles, lieu de vie, d\u2019art et de m\u00e9moire","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.brusselschatterguides.be","email":"info@brusselschatterguides.be","phone_contact":null,"phone_booking":nu