:false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen"}},"others":{"list":[258],"translations":{"fr":["Quartiers"],"nl":["Wijken"],"en":["Neighbourhoods"],"de":["Stadtteile"]}}},"languages":{"spoken":["nl","fr","en"],"subtitles":[]},"translations":{"fr":{"name":"Les incontournables et les sentiers moins battus de Bruxelles \u00e0 v\u00e9lo!","shortdescr":"D\u00e9couvrez les incontournables de Bruxelles et les sentiers moins battus de la ville \u00e0 v\u00e9lo","longdescr":"Cette visite guid\u00e9e \u00e0 v\u00e9lo est l\u2019introduction id\u00e9ale \u00e0 Bruxelles, \u00e0 son histoire et \u00e0 ses nombreux quartiers. Un m\u00e9lange id\u00e9al entre les incontournables tels que le quartier des Marolles, le March\u00e9 aux Poissons, le Palais de Justice,... et les sentiers moins battus. Pendant ce tour, nos guides vous offrent une vue surprenante sur la ville et sa diversit\u00e9.\r\nLes tours du samedi se font en groupes relativement petit pour garder une ambiance conviviale! \u00c0 mi-parcours, les v\u00e9los sont mis de c\u00f4t\u00e9 pour une pause dans un caf\u00e9 sympathique ou sur une terrasse.\r\nD\u00e9couvrez Bruxelles \u00e0 v\u00e9lo et laissez-vous surprendre !\r\n\r\nPrix :\r\n\u2022 21 \u20ac avec votre propre v\u00e9lo\r\n\u2022 30 \u20ac avec un v\u00e9lo classique incl.\r\n\u2022 43 \u20ac e-bike incl.\r\n\r\nTous les samedi (3,5h)\r\n10h00 : en Fran\u00e7ais et en Anglais\r\n14h00 : en N\u00e9erlandais","performers":null,"boxoffice_url":null,"website":"https:\/\/cactus.brussels\/tours-du-weekend","email":"info@cactus.brussels","phone_contact":null,"phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.524206"},"nl":{"name":"De highlights en minder betreden paden van Brussel met de fiets","shortdescr":"Ontdek de highlights en de minder betreden paden van de Brussel met de fiets!","longdescr":"Deze gegidste fietstocht is een ideale kennismaking met Brussel, haar geschiedenis en haar vele wijken. Onze gidsen maken van deze fietstocht een ideale mix tussen highlights zoals de Marollen, de Vismarkt, het Justitiepaleis, \u2026 en de minder betreden paden van de stad. Ze bieden je een verrassende kijk op de stad en haar veelzijdigheid.\r\nWe gaan op stap met relatief kleine groepen om het aangenaam en gezellig te houden! Halverwege de tour gaan de fietsen even aan de kant voor een pauze in een gezellig caf\u00e9 of op een terrasje.\r\nOntdek Brussel met de fiets en laat je verrassen!\r\nPrijs:\r\n\u2022 21 \u20ac met je eigen fiets\r\n\u2022 30 \u20ac incl. klassieke fiets\r\n\u2022 43 \u20ac incl. e-bike\r\nElke zaterdag (3,5u)\r\n\u2022 10u00 : in het Frans en Engels\r\n\u2022 14u00: in het Nederlands","performers":null,"boxoffice_url":null,"website":"https:\/\/cactus.brussels\/weekendtours","email":null,"phone_contact":"+32 497 19 07 14","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.524206"},"en":{"name":"Brussels highlights and hidden gems by bike","shortdescr":null,"longdescr":"A fascinating introduction to Brussels and its diversity of neighbourhoods. Our guides take you as part of a small group along some of the city\u2019s highlights, surprising hidden gems and along its diversity of neighbourhoods.\r\n\r\nGet a surprising view on the city and enjoy the perfect mix between the city\u2019s highlights such as les Marolles, the Fish Market, the Courthouse and less obvious places and areas. \r\n\r\nWe put the bicycles aside at the halfway point to take a small break in a cosy bar or on one of the many terraces.\r\n\r\nSaturdays at 10am: English and French tours and at 2pm: Dutch tours\r\nDuration: 3,5h (small pause incl.)\r\n\r\nPrices:\r\nwith your own bike: \u20ac21 p.p.\r\nwith a bike from us: \u20ac30 p.p.\r\nwith an e-bike from us: \u20ac43  p.p.\r\n\r\nMeeting point in the city center of Brussels Grand Hospice - Bike Hub","performers":null,"boxoffice_url":null,"website":"https:\/\/cactus.brussels\/weekend-tours","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.524206"},"de":{"name":"Tour du Weekend - Bruxelles, les incontournables et les sentiers moins battus","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.524206"},"it":{"name":"Tour du Weekend - Bruxelles, les incontournables et les sentiers moins battus","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.524206"},"sp":{"name":"Tour du Weekend - Bruxelles, les incontournables et les sentiers moins battus","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.524206"},"pt":{"name":"Tour du Weekend - Bruxelles, les incontournables et les sentiers moins battus","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.524206"},"cn":{"name":"Tour du Weekend - Bruxelles, les incontournables et les sentiers moins battus","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.524206"}},"place":{"id":276966,"translations":{"fr":{"name":"Grand Hospice","address_stre