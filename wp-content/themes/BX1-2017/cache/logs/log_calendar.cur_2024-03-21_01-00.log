_contact":"+32 2 538 90 20","phone_booking":"+32 2 538 90 20","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50008425"},"pt":{"name":"Un monde en commun- No Sovereign Author & Vida Dena | Photographie \u00b7 Vid\u00e9o","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lejacquesfranck.be\/event\/un-monde-en-commun\/2024-03-29\/","email":"info@lejacquesfranck.be","phone_contact":"+32 2 538 90 20","phone_booking":"+32 2 538 90 20","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50008425"},"en":{"name":"Un monde en commun- No Sovereign Author & Vida Dena | Photographie \u00b7 Vid\u00e9o","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lejacquesfranck.be\/event\/un-monde-en-commun\/2024-03-29\/","email":"info@lejacquesfranck.be","phone_contact":"+32 2 538 90 20","phone_booking":"+32 2 538 90 20","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50008425"},"it":{"name":"Un monde en commun- No Sovereign Author & Vida Dena | Photographie \u00b7 Vid\u00e9o","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lejacquesfranck.be\/event\/un-monde-en-commun\/2024-03-29\/","email":"info@lejacquesfranck.be","phone_contact":"+32 2 538 90 20","phone_booking":"+32 2 538 90 20","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50008425"},"cn":{"name":"Un monde en commun- No Sovereign Author & Vida Dena | Photographie \u00b7 Vid\u00e9o","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lejacquesfranck.be\/event\/un-monde-en-commun\/2024-03-29\/","email":"info@lejacquesfranck.be","phone_contact":"+32 2 538 90 20","phone_booking":"+32 2 538 90 20","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50008425"},"fr":{"name":"Un monde en commun- No Sovereign Author & Vida Dena | Photographie \u00b7 Vid\u00e9o","shortdescr":"Cette exposition associe le duo de photographes No Sovereign Author (Maroussia Prignot et Valerio Alvarez) et la r\u00e9alisatrice Vida Dena. Des artistes qui ont en commun de travailler sur les migrations, en rendant visibles les personnes immigr\u00e9es, r\u00e9fugi\u00e9es, demandeuses d\u2019asile ou exil\u00e9es et en les invitant \u00e0 participer.","longdescr":"Entre 2015 et 2018, Maroussia Prignot et Valerio Alvarez se sont rendu\u00b7es r\u00e9guli\u00e8rement dans un centre Fedasil \u00e0 Jodoigne pour y mener des actions de cr\u00e9ation en collaboration avec celleux qu\u2019iels photographient. \u00c0 la s\u00e9rie Here, Waiting succ\u00e8de So Far So Good pour laquelle iels vont \u00e0 la rencontre de la famille Hachmi, l\u2019accompagnant dans son parcours administratif de demande d\u2019asile en Belgique. \u00c0 l\u2019instar de No Sovereign Author, Vida Dena m\u00e8ne un travail au long cours avec des familles primo-arrivantes inscrites au CPAS de Saint-Gilles. Elles racontent leur vie d\u2019ici et d\u2019avant, leurs histoires et leurs \u00e9motions, en mots et en dessins que Vida Dena transforme ensuite en films.\n\nDes parcours et des r\u00e9cits diff\u00e9rents pour des personnes qui ont toutes connu la migration. Elles qui doivent (re)cr\u00e9er tous les liens quand elles arrivent en Belgique : liens avec un territoire, avec les habitant\u00b7es, avec une culture\u2026 Des liens qui nous engagent toustes dans un monde en commun. ","performers":"No Sovereign Author (Maroussia Prignot et Valerio Alvarez) et la r\u00e9alisatrice Vida Dena.","boxoffice_url":null,"website":"https:\/\/lejacquesfranck.be\/event\/un-monde-en-commun\/2024-03-29\/","email":"info@lejacquesfranck.be","phone_contact":"+32 2 538 90 20","phone_booking":"+32 2 538 90 20","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50008425"},"sp":{"name":"Un monde en commun- No Sovereign Author & Vida Dena | Photographie \u00b7 Vid\u00e9o","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lejacquesfranck.be\/event\/un-monde-en-commun\/2024-03-29\/","email":"info@lejacquesfranck.be","phone_contact":"+32 2 538 90 20","phone_booking":"+32 2 538 90 20","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50008425"},"nl":{"name":"Un monde en commun- No Sovereign Author & Vida Dena | Photographie \u00b7 Vid\u00e9o","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lejacquesfranck.be\/event\/un-monde-en-commun\/2024-03-29\/","email":"info@lejacquesfranck.be","phone_contact":"+32 2 538 90 20","phone_booking":"+32 2 538 90 20","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50008425"}},"place":{"id":4,"translations":{"de":{"name":"Centre Culturel Jacques Franck","address_street_name":"Chauss\u00e9e de Waterloo","address_street_number":"94","address_street_box":null,"email":"info@lejacquesfranck.be","website":"http:\/\/www.lejacquesfranck.be","phone_contact":"+32 2 538 90 20","phone_booking":"+32 2 538 90 20","address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Chauss\u00e9e de Waterloo, 94","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Centre Culturel Jacques Franck","address_street_name":"Chauss\u00e9e de Waterloo","address_street_number":"94","address_street_box":null,"email":"info@lejacquesfranck.be","website":"http:\/\/www.lejacquesfranck.be","phone_contact":"+32 2 538 90 20","phone_booking":"+32 2 538 90 20","address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Chauss\u00e9e de Waterloo, 94","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Centre Culturel Jacques Franck","addre