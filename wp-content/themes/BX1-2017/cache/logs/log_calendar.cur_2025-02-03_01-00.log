 de tout temps, a rec\u00e9l\u00e9 toutes les peines et toutes les joies, tous les conflits et tous les d\u00e9bats de notre condition humaine, rires et larmes m\u00eal\u00e9s.\r\nIl comporte deux salles de spectacles : la grande salle, dite \u00e0 l\u2019italienne de 366 places, et la petite salle destin\u00e9e \u00e0 des projets plus intimistes.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Th\u00e9\u00e2tre des Martyrs","address_street_name":"Place des Martyrs","address_street_number":"22","address_street_box":null,"email":"billetterie@theatre-martyrs.be","website":"http:\/\/www.theatre-martyrs.be","phone_contact":"+32 2 223 32 08","phone_booking":"+32 2 223 32 08","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Martyrs, 22","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Th\u00e9\u00e2tre des Martyrs","address_street_name":"Martelaarsplein","address_street_number":"22","address_street_box":null,"email":"billetterie@theatre-martyrs.be","website":"http:\/\/www.theatre-martyrs.be","phone_contact":"+32 2 223 32 08","phone_booking":"+32 2 223 32 08","address_zip":"1000","address_city":"Brussel","address_line1":"Martelaarsplein, 22","address_line2":"1000 Brussel","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[13,3],"translations":{"de":["Historisches Stadtzentrum","Dansaert\/Sainte-Catherine"],"pt":[null,null],"en":["Historical Centre","Dansaert\/Sainte-Catherine"],"it":["Centro storico","Dansaert\/Sainte-Catherine"],"cn":[null,null],"fr":["Centre historique","Dansaert\/Sainte-Catherine"],"sp":["Centro hist\u00f3rico","Dansaert\/Sainte-Catherine"],"nl":["Historisch centrum","Dansaertwijk\/Sint-Katelijne"]}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["