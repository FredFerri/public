ub_type":"expo","show_in_agenda":true,"ranking":0.23017706561203},{"id":523527,"date_start":"2022-05-21","date_end":"2022-09-18","date_next":"2022-06-10","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[36,46],"translations":{"fr":["Mus\u00e9es et art centers","Pluridisciplinaire"],"nl":["Musea en kunstcentra","Multidisciplinair"],"en":["Museums and art centers","Multidisciplinary"]}}},"languages":{"spoken":["fr","nl","en","es"],"subtitles":[]},"translations":{"fr":{"name":"(UN)COMMON VALUES. Two Corporate Collections of Contemporary Art.","shortdescr":"Cette exposition c\u00e9l\u00e9brera le 50e anniversaire de la collection d'art BNB, dans sa salle des guichets, un joyau cach\u00e9 de l'architecture moderne.","longdescr":"En organisant conjointement l'exposition (UN)COMMON VALUES, les collections d'art contemporain de la Banque nationale de Belgique et de la Banco de Espa\u00f1a engagent un dialogue sur la valeur intrins\u00e8que de l'art, dans le contexte inhabituel des collections d'entreprise. Ensemble nous explorerons comment les oeuvres d'art illustrent les changements de la soci\u00e9t\u00e9, se font l'\u00e9cho des perceptions des g\u00e9n\u00e9rations et refl\u00e8tent le monde kal\u00e9idoscopique dans lequel nous vivons.","performers":"Collections d'art contemporain de la Banque nationale de Belgique et de la Banco de Espana","boxoffice_url":null,"website":"http:\/\/www.nbb-expo.be","email":"art@nbb.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/523527.html"},"nl":{"name":"(UN)COMMON VALUES. Two Corporate Collections of Contemporary Art.","shortdescr":"Deze tentoonstelling viert de 50ste verjaardag van de NBB kunstcollectie in haar lokettenzaal: een verborgen parel van modernistische architectuur","longdescr":"In de gezamenlijke tentoonstelling (UN)COMMON VALUES gaan de hedendaagse kunstcollecties van de Nationale Bank van Belgi\u00eb en de Banco de Espa\u00f1a de dialoog aan over de intrinsieke waarde van kunst, in de ongebruikelijke context van bedrijfscollecties. Samen onderzoeken we hoe kunstwerken veranderingen in de maatschappij weerspiegelen, de perceptie van generaties echo\u00ebn en onze caleidoscopische wereld omarmen.","performers":"Hedendaagse kunstcollecties van de Nationale Bank van Belgi\u00eb en de Banco de Espana","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/523527.html"},"en":{"name":"(UN)COMMON VALUES. Two Corporate Collections of Contemporary Art.","shortdescr":"This exhibition will celebrate the 50th anniversary of the NBB art collection, in the Counter Hall of the NBB in Brussels: a hidden gem of modernist architecture.","longdescr":"With the joint exhibition (UN)COMMON VALUES, the contemporary art collections of the National Bank of Belgium and the Banco de Espa\u00f1a will engage in a dialogue about the intrinsic value of art, in the uncommon context of corporate collections. \r\nTogether we will explore how the artworks reflect the changements of the society, mirror the perceptions of different generations and embrace the kaleidoscopic world we live in.","performers":"Contemporary Art Collections of the National Bank of Belgium and the Banco de Espana","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/523527.html"},"de":{"name":"(UN)COMMON VALUES. Two Corporate Collections of Contemporary Art.","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":nul