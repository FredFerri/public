l_visit":null,"visit_url":null},"fr":{"name":"Maison Cohen","address_street_name":"Avenue Franklin Roosevelt","address_street_number":"60","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Franklin Roosevelt, 60","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Maison Cohen","address_street_name":"Avenue Franklin Roosevelt","address_street_number":"60","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Franklin Roosevelt, 60","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Maison Cohen","address_street_name":"Franklin Rooseveltlaan","address_street_number":"60","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"Franklin Rooseveltlaan, 60","address_line2":"1050 Elsene","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[],"translations":{}},"zones":[],"neca":null,"facebook_id":null,"backoffice_id":43650,"location":{"lat":50.8105047,"lon":4.3828116},"region":"brussels","last_updated_at":"2025-02-10T12:05:47+01:00","published_at":"2025-02-10T12:05:47+01:00","import_origin":null,"external_id":null,"is_in_address_book":false,"is_in_vb_export":false,"resto_ranking":0},"organizer":{"id":267246,"translations":{"de":{"name":"Explore.brussels ","address_street_name":"Avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"https:\/\/www.explore.brussels\/fr","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Avenue Brugmann, 405","address_line2":"1180 Uccle","description_web":"Explore.Brussels ist ein Zusammenschluss von Vereinen, die qualitativ hochwertige Stadtf\u00fchrungen in der Region Br\u00fcssel-Hauptstadt organisieren.\r\nDie Mitgliedsvereine sind ARAU, Pro Velo, Brussels Chatterguides und Arkadia. Im Jahr 2020 hat sich La Fonderie als Partnerverein angeschlossen.\r\nEntdecken Sie das UNESCO-Weltkulturerbe, Jugendstilarchitektur, die Bauwerke von Victoria Horta, Gem\u00e4lde von Magritte, Comic-Kunst von Herg\u00e9, Streetart, Europa, Bier, Schokolade oder besichtigen Sie architektonische Perlen des Jugendstils, des Art-d\u00e9co oder des Neoklassizismus, die normalerweise nicht f\u00fcr die \u00d6ffentlichkeit zug\u00e4nglich sind. Die F\u00fchrungen werden sowohl f\u00fcr Einzelbesucher als auch f\u00fcr Gruppen angeboten und reichen von klassischen \u00fcber originelle bis hin zu vollkommen neuen Konzepten und Formaten. Neben Stadtf\u00fchrungen zu Fu\u00df sind auch Besichtigungen per Fahrrad, Bus oder Boot m\u00f6glich.\r\nExplore.Brussels organisiert unter anderem auch das Jugendstil- und Art-d\u00e9co-Festival BANAD, die Brussels Biennale - Neoclassic (BBN) sowie weitere Projekte, darunter die Ausbildung von Stadtf\u00fchrern, der \u201eVerein der Freunde\u201c und der \u201eVerein der Eigent\u00fcmer\u201c. \r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Explore.brussels ","address_street_name":"Avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"https:\/\/www.explore.brussels\/fr","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Avenue Brugmann, 405","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Explore.brussels ","address_street_name":"Avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"https:\/\/www.explore.brussels\/fr","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Avenue Brugmann, 405","address_line2":"1180 Uccle","description_web":"Explore.Brussels is a network of guided tour associations in Brussels. This organisation includes ARAU, Arkadia, Bruxelles Bavard, Pro Velo, La Fonderie and Korei. Events are organised in co-production with these 6 companies. Individual or group tours are available on foot, by bike, by bus and by boat.  Visitors discover UNESCO heritage, Magritte, art deco, chocolate and much more. Explore.Brussels also organises Brussels festivals and other large-scale projects.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Explore.brussels ","address_street_name":"Avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"https:\/\/www.explore.brussels\/fr","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Avenue Brugmann, 405","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Explore.brussels ","address_street_name":"Avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"https:\/\/www.explore.brussels\/fr","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Avenue Brugmann, 405","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_vis