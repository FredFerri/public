day":"2022-03-05","doors":null,"start":"15:00:00","end":"16:00:00"},{"day":"2022-04-02","doors":null,"start":"15:00:00","end":"16:00:00"},{"day":"2022-05-07","doors":null,"start":"15:00:00","end":"16:00:00"},{"day":"2022-06-04","doors":null,"start":"15:00:00","end":"16:00:00"}],"recurring":[{"day":"saturday","occurences":{"is_first":true,"is_second":false,"is_third":false,"is_fourth":false,"is_last":false},"time_start":"15:00:00","time_end":"16:00:00","translations":{"fr":"Ouvert le premier samedi du mois de 15:00 \u00e0 16:00","nl":"Open op de eerste zaterdag van de maand van 15:00 tot 16:00","en":"Open the first saturday of the month from 15:00 to 16:00"}}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":4}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-05-08T01:09:21+02:00","published_at":"2022-02-21T14:08:46+01:00","backoffice_id":248032,"import_origin":null,"sub_type":"sport","show_in_agenda":true,"ranking":0.15090455083303},{"id":528355,"date_start":"2022-03-06","date_end":"2022-07-03","date_next":"2022-06-05","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":true,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":90,"translations":{"fr":"Animations","nl":"Animaties","en":"Animations"}},"others":{}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"family day @ argos","shortdescr":"embrace your inner child","longdescr":"Tous les premiers dimanche du mois, c'est Family Day! Ce jour-l\u00e0, argos vous encourage \u00e0 venir visiter nos expos en famille. Invitez donc les cousins, la grand-m\u00e8re et tous les membres de votre famille choisie. On accueille les plus petits avec des ateliers et des visites guid\u00e9es adapt\u00e9es et en trois langues, et le bar s'adapte \u00e9galement: chacun et chacune y trouvera son compte! \r\n\r\nNotez d\u00e9j\u00e0 les prochaines dates dans vos agendas: le 5 juin, on transforme nos bo\u00eetes \u00e0 chaussures en diorama et le 3 juillet, on pr\u00e9voit un atelier podcast! \r\n\r\nPlus d'informations sur notre site!","performers":null,"boxoffice_url":null,"website":"http:\/\/www.argosarts.org","email":"info@argosarts.org","phone_contact":null,"phone_booking":"+32 2 229 00 03","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/528355.html"},"nl":{"name":"family day @ argos","shortdescr":"embrace your inner child","longdescr":"Elke eerste zondag van de maand is het Family Day. Dan moedigt argos je aan om met het hele gezin op bezoek te komen. Nodig dus gerust al je neefjes en je oma uit, en vergeet de leden van je 'gekozen familie' niet! Voor de kleinsten zijn er workshops en rondleidingen op kindermaat. Aan de bar is er voor ieder wat wils! \r\n\r\nNoteer alvast volgende data in je agenda: op 5 juni maken we kijkdozen en op 3 juli plannen we een heuse podcast workshop! \r\n\r\nMeer info op onze website","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/528355.html"},"en":{"name":"family day @ argos","shortdescr":"embrace your inner child","longdescr":"As of 2022, argos hosts family days every first Sunday of each month. Children, young people, parents, adults and non-parents are all welcome to visit our exhibition together.\r\n\r\nOn these occasions, our bar provides special treats that cater to all. Guides adapt their tours to kids and their families. Two playful, participatory workshops are programmed throughout the afternoon in English, French, and Dutch. Always linked to the current exhibitions, the activities are renewed each time, highlighting an artistic technique or an aspect of the exhibition.\r\n\r\nKeep an eye on our website for updates!","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/528355.html"},"de":{"name":"family day @ argos","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/528355.html"},"it":{"name":"family day @ argos","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/528355.html"},"sp":{"name":"family day @ argos","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/528355.html"},"pt":{"name":"family day @ argos","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/528355.html"},"cn":{"name":"family day @ argos","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/528355.html"}},"place":{"id":228372,"translations":{"fr":{"name":"argos centre for audiovisuals arts","address_street_name":"Rue du Chantier","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Chantier, 13","address_line2":"1000 Bruxelles","description_web":"Fond\u00e9 en 1989 \u00e0 Bruxelles, argos est un lieu ressource pour la pr\u00e9sentation, la production et le d\u00e9veloppement des arts audiovisuels critiques, ainsi que pour leur distribution, conservation et restauration.\r\n\r\nargos consid\u00e8re l\u2019audiovisuel comme un moyen des plus pertinents pour regarder et comprendre le monde de mani\u00e8re ouverte et int\u00e9gr\u00e9e. Soutenant les voix alternatives dans la soci\u00e9t\u00e9, il favorise le dialogue avec un large \u00e9ventail de partenaires institutionnels ou non, tant \u00e0 Bruxelles qu\u2019ailleurs. argis recherche sans cesse de nouvelles fa\u00e7ons d'impliquer et d\u2019associer les publics les plus larges.\r\n\r\nargos  con\u00e7oit des expositions et programmations, distribue les \u0153uvres audiovisuelles les plus contemporaines et critiques; sa mission par ailleurs constitue, conserve et fait conna\u00eetre un tr\u00e8s important fonds de films et de vid\u00e9os d\u2019artistes. Il comporte \u00e9galement une m\u00e9diath\u00e8que unique en son genre, ouverte aux professionnels et au grand public. Celle-ci inclut une tr\u00e8s large s\u00e9lection de publications et les \u0153uvres audiovisuelles de la collection. De plus, ARGOS d\u00e9veloppe des projets de recherche in\u00e9dits pour pallier les lacunes importantes dans l'histoire de l'art, questionnant les relations entre culture et soci\u00e9t\u00e9.\r\n\r\n\u00c0 travers ces multiples activit\u00e9s, argis a pour objectif de permettre une meilleure compr\u00e9hension du pass\u00e9 et du pr\u00e9sent des arts audiovisuels tout en fournissant les outils pour imaginer et fa\u00e7onner collectivement leur avenir.","description_print":"","booking_url":null,"sort_order":"ARGOS, CENTRE FOR ART & MEDIA","virtual_visit":null},"nl":{"name":"argos centre for audiovisuals arts","address_street_name":"Werfstraat","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Brussel","address_line1":"Werfstraat, 13","address_line2":"1000 Brussel","description_web":"argos werd opgericht in 1989 in Brussel en is een instituut, en bron, voor de studie, productie en vooruitgang van kritische audiovisuele kunsten, evenals de distributie, het behoud en de restauratie ervan.\r\n\r\nargos beschouwt het audiovisuele als een belangrijk middel om op meer open en ge\u00efntegreerde manieren de wereld te bekijken en te begrijpen. We ondersteunen een veelheid aan stemmen in de samenleving en gaan in dialoog met een breed scala aan institutionele en niet-institutionele partners, zowel in Brussel als daarbuiten. Zo willen we een steeds ruimer en \u200b\u200bmeer divers publiek bij onze activiteiten betrekken.\r\n\r\n\u249c\u24ad\u24a2\u24aa\u24ae maakt tentoonstellingen en programma's, distribueert audiovisuele werken en bouwt, beheert en ontsluit een prominente collectie van kunstenaarfilms en -video's. We hebben ook een unieke mediatheek met een ruime selectie van publicaties en de audiovisuele werken van de collectie, die zowel voor professionals als het algemene publiek toegankelijk is. Daarnaast ontwikkelen we originele onderzoeksprojecten met betrekking tot vooraanstaande hiaten in de kunstgeschiedenis en de relatie ervan tot cultuur en maatschappij.\r\n\r\nVia deze verschillende activiteiten wil argos het verleden en het heden van de audiovisuele kunsten beter doorgronden, en ook instrumenten bieden om collectief hun toekomst in te beelden en opnieuw vorm te geven.","description_print":"","booking_url":null,"sort_order":"ARGOS, CENTRE FOR ART & MEDIA","virtual_visit":null},"en":{"name":"argos centre for audiovisuals arts","address_street_name":"Werfstraat\/ Rue du Chantier","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Brussels","address_line1":"Werfstraat\/ Rue du Chantier, 13","address_line2":"1000 Brussels","description_web":"Founded in 1989 in Brussels, argos is an institution and resource for the presentation, production, and study of critical audiovisual arts, as well as for its distribution, conservation and restoration. argos considers the audiovisual as a primary means of looking at and understanding the world in more open and integrated ways. Supporting a multiplicity of voices in society, it fosters dialogue with a broad range of institutional and non-institutional partners, both in Brussels and beyond, and seeks new ways to engage diverse audiences. \r\n\r\nargos makes exhibitions and programmes, distributes moving image works, and builds, preserves, and discloses a prominent collection of artist films and videos. It also houses a unique media library containing a broad selection of publications, as well as the audiovisual works of the collection, which is open to both professionals and the general public. Additionally, it develops original research projects relating to significant gaps in art history and its relationship to culture and society. Through these various activities, argos aims to more fully understand the past and present of audiovisual arts, as well as provide tools to collectively imagine and shape its futures.\r\n","description_print":"","booking_url":null,"sort_order":"ARGOS, CENTRE FOR ART & MEDIA","virtual_visit":null},"de":{"name":"ARGOS centre for audivisual arts","address_street_name":"Rue du Chantier","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Chantier, 13","address_line2":"1000 Bruxelles","description_web":"Das Kunstzentrum Argos wurde 1989 mit dem Ziel gegr\u00fcndet, audiovisuelle Kunstformen zu f\u00f6rdern. Heute gilt das Argos, das in der N\u00e4he des Kanals im Br\u00fcsseler Stadtzentrum niedergelassen ist, als Referenz f\u00fcr diese Kunstformen. Das Programm des Hauses ist vielf\u00e4ltig und reicht von audiovisuellen und visuellen Ausstellungen \u00fcber Film- und Videovorf\u00fchrungen bis hin zu Konferenzen und Perfomances.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"ARGOS centre for audivisual arts","address_street_name":"Rue du Chantier","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Chantier, 13","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"ARGOS centre for audivisual arts","address_street_name":"Rue du Chantier","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Chantier, 13","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"ARGOS centre for audivisual arts","address_street_name":"Rue du Chantier","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Chantier, 13","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"ARGOS centre for audivisual arts","address_street_name":"Rue du Chantier","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Chantier, 13","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":[],"zones":{"list":[19],"translations":{"fr":["Centre"],"nl":["Centrum"],"en":["Centre"]}},"neca":"art_center","facebook_id":null,"backoffice_id":769,"location":{"lat":50.85663153,"lon":4.34963277},"region":"brussels","last_updated_at":"2022-05-10T16:35:10+02:00","published_at":"2013-10-19T01:13:47+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":228372,"translations":{"fr":{"name":"argos centre for audiovisuals arts","address_street_name":"Rue du Chantier","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Chantier, 13","address_line2":"1000 Bruxelles","description_web":"Fond\u00e9 en 1989 \u00e0 Bruxelles, argos est un lieu ressource pour la pr\u00e9sentation, la production et le d\u00e9veloppement des arts audiovisuels critiques, ainsi que pour leur distribution, conservation et restauration.\r\n\r\nargos consid\u00e8re l\u2019audiovisuel comme un moyen des plus pertinents pour regarder et comprendre le monde de mani\u00e8re ouverte et int\u00e9gr\u00e9e. Soutenant les voix alternatives dans la soci\u00e9t\u00e9, il favorise le dialogue avec un large \u00e9ventail de partenaires institutionnels ou non, tant \u00e0 Bruxelles qu\u2019ailleurs. argis recherche sans cesse de nouvelles fa\u00e7ons d'impliquer et d\u2019associer les publics les plus larges.\r\n\r\nargos  con\u00e7oit des expositions et programmations, distribue les \u0153uvres audiovisuelles les plus contemporaines et critiques; sa mission par ailleurs constitue, conserve et fait conna\u00eetre un tr\u00e8s important fonds de films et de vid\u00e9os d\u2019artistes. Il comporte \u00e9galement une m\u00e9diath\u00e8que unique en son genre, ouverte aux professionnels et au grand public. Celle-ci inclut une tr\u00e8s large s\u00e9lection de publications et les \u0153uvres audiovisuelles de la collection. De plus, ARGOS d\u00e9veloppe des projets de recherche in\u00e9dits pour pallier les lacunes importantes dans l'histoire de l'art, questionnant les relations entre culture et soci\u00e9t\u00e9.\r\n\r\n\u00c0 travers ces multiples activit\u00e9s, argis a pour objectif de permettre une meilleure compr\u00e9hension du pass\u00e9 et du pr\u00e9sent des arts audiovisuels tout en fournissant les outils pour imaginer et fa\u00e7onner collectivement leur avenir.","description_print":"","booking_url":null,"sort_order":"ARGOS, CENTRE FOR ART & MEDIA","virtual_visit":null},"nl":{"name":"argos centre for audiovisuals arts","address_street_name":"Werfstraat","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Brussel","address_line1":"Werfstraat, 13","address_line2":"1000 Brussel","description_web":"argos werd opgericht in 1989 in Brussel en is een instituut, en bron, voor de studie, productie en vooruitgang van kritische audiovisuele kunsten, evenals de distributie, het behoud en de restauratie ervan.\r\n\r\nargos beschouwt het audiovisuele als een belangrijk middel om op meer open en ge\u00efntegreerde manieren de wereld te bekijken en te begrijpen. We ondersteunen een veelheid aan stemmen in de samenleving en gaan in dialoog met een breed scala aan institutionele en niet-institutionele partners, zowel in Brussel als daarbuiten. Zo willen we een steeds ruimer en \u200b\u200bmeer divers publiek bij onze activiteiten betrekken.\r\n\r\n\u249c\u24ad\u24a2\u24aa\u24ae maakt tentoonstellingen en programma's, distribueert audiovisuele werken en bouwt, beheert en ontsluit een prominente collectie van kunstenaarfilms en -video's. We hebben ook een unieke mediatheek met een ruime selectie van publicaties en de audiovisuele werken van de collectie, die zowel voor professionals als het algemene publiek toegankelijk is. Daarnaast ontwikkelen we originele onderzoeksprojecten met betrekking tot vooraanstaande hiaten in de kunstgeschiedenis en de relatie ervan tot cultuur en maatschappij.\r\n\r\nVia deze verschillende activiteiten wil argos het verleden en het heden van de audiovisuele kunsten beter doorgronden, en ook instrumenten bieden om collectief hun toekomst in te beelden en opnieuw vorm te geven.","description_print":"","booking_url":null,"sort_order":"ARGOS, CENTRE FOR ART & MEDIA","virtual_visit":null},"en":{"name":"argos centre for audiovisuals arts","address_street_name":"Werfstraat\/ Rue du Chantier","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Brussels","address_line1":"Werfstraat\/ Rue du Chantier, 13","address_line2":"1000 Brussels","description_web":"Founded in 1989 in Brussels, argos is an institution and resource for the presentation, production, and study of critical audiovisual arts, as well as for its distribution, conservation and restoration. argos considers the audiovisual as a primary means of looking at and understanding the world in more open and integrated ways. Supporting a multiplicity of voices in society, it fosters dialogue with a broad range of institutional and non-institutional partners, both in Brussels and beyond, and seeks new ways to engage diverse audiences. \r\n\r\nargos makes exhibitions and programmes, distributes moving image works, and builds, preserves, and discloses a prominent collection of artist films and videos. It also houses a unique media library containing a broad selection of publications, as well as the audiovisual works of the collection, which is open to both professionals and the general public. Additionally, it develops original research projects relating to significant gaps in art history and its relationship to culture and society. Through these various activities, argos aims to more fully understand the past and present of audiovisual arts, as well as provide tools to collectively imagine and shape its futures.\r\n","description_print":"","booking_url":null,"sort_order":"ARGOS, CENTRE FOR ART & MEDIA","virtual_visit":null},"de":{"name":"ARGOS centre for audivisual arts","address_street_name":"Rue du Chantier","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+32 2 229 00 03","phone_booking":"+32 2 229 00 03","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Chantier, 13","address_line2":"1000 Bruxelles","description_web":"Das Kunstzentrum Argos wurde 1989 mit dem Ziel gegr\u00fcndet, audiovisuelle Kunstformen zu f\u00f6rdern. Heute gilt das Argos, das in der N\u00e4he des Kanals im Br\u00fcsseler Stadtzentrum niedergelassen ist, als Referenz f\u00fcr diese Kunstformen. Das Programm des Hauses ist vielf\u00e4ltig und reicht von audiovisuellen und visuellen Ausstellungen \u00fcber Film- und Videovorf\u00fchrungen bis hin zu Konferenzen und Perfomances.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"ARGOS centre for audivisual arts","address_street_name":"Rue du Chantier","address_street_number":"13","address_street_box":null,"email":"info@argosarts.org","website":"http:\/\/www.argosarts.org","phone_contact":"+