de":"Theater","pt":null,"en":"Theatre","it":"Teatro","cn":null,"fr":"Th\u00e9\u00e2tre","sp":"Teatro","nl":"Theater"}},"others":{"list":[50],"translations":{"de":["Theater"],"pt":[null],"en":["Theatre"],"it":["Teatro"],"cn":[null],"fr":["Th\u00e9\u00e2tre"],"sp":["Teatro"],"nl":["Theater"]}}},"translations":{"de":{"name":"Dys sur dys","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lejacquesfranck.be\/event\/dys-sur-dys\/2025-01-15\/","email":"info@lejacquesfranck.be","phone_contact":"+32 2 538 90 20","phone_booking":"+32 2 538 90 20","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700001528"},"pt":{"name":"Dys sur dys","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lejacquesfranck.be\/event\/dys-sur-dys\/2025-01-15\/","email":"info@lejacquesfranck.be","phone_contact":"+32 2 538 90 20","phone_booking":"+32 2 538 90 20","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700001528"},"en":{"name":"Dys sur dys","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lejacquesfranck.be\/event\/dys-sur-dys\/2025-01-15\/","email":"info@lejacquesfranck.be","phone_contact":"+32 2 538 90 20","phone_booking":"+32 2 538 90 20","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700001528"},"it":{"name":"Dys sur dys","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lejacquesfranck.be\/event\/dys-sur-dys\/2025-01-15\/","email":"info@lejacquesfranck.be","phone_contact":"+32 2 538 90 20","phone_booking":"+32 2 538 90 20","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700001528"},"cn":{"name":"Dys sur dys","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lejacquesfranck.be\/event\/dys-sur-dys\/2025-01-15\/","email":"info@lejacquesfranck.be","phone_contact":"+32 2 538 90 20","phone_booking":"+32 2 538 90 20","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700001528"},"fr":{"name":"Dys sur dys","shortdescr":"Au royaume des aveugles, le borgne est roi...\nOn pourrait croire que cet adage a \u00e9t\u00e9 \u00e9crit pour mon fr\u00e8re Louis, r\u00e9sident permanent d\u2019une fronti\u00e8re invisible, et pourtant bien pr\u00e9sente : celle qui d\u00e9termine la norme. ","longdescr":"Cet \u00e9tat d\u2019entre-deux, il est n\u00e9 avec, il le porte sur son visage qui vieillit, sur son corps qui a cess\u00e9 de grandir, dans son regard clair o\u00f9 brillent rudesse et gentillesse. Louis est dyspraxique. \nCe trouble, fr\u00e9quent, fait partie d\u2019une plus large famille dite des \u201cDYS\u201d : dyslexie, dyscalculie, dysphasie et dyspraxie. Cette derni\u00e8re est un trouble du d\u00e9veloppement de la coordination.\n\nDys sur dys c\u2019est l\u2019histoire de Pirlouit.\n\nPirlouit raconte son enfance, sa jeunesse, en traversant ses souvenirs li\u00e9s \u00e0 la diff\u00e9rence, aux \u00e9checs et aux joies. Il est accompagn\u00e9 par l\u2019Homme-Orchestre, acteur de tous les autres personnages du r\u00e9el et musicien de la B-O de sa vie, et par Fant\u00f4mette, une fant\u00f4me hors du commun qui, une fois-l\u00e0, ne le quittera plus. Ensemble, avec humour et po\u00e9sie, iels vont cr\u00e9er l\u2019univers de Pirlouit \u00e0 vue, un univers adapt\u00e9 \u00e0 la dyspraxie.\n\nPour cette premi\u00e8re mise en sc\u00e8ne, Fran\u00e7ois Gillerot s\u2019empare d\u2019un sujet personnel. En cr\u00e9ant Dys sur dys, l\u2019\u00e9quipe aborde le rapport \u00e0 la norme et \u00e0 la diff\u00e9rence, par le prisme sp\u00e9cifique de la dyspraxie. ","performers":"Mise en sc\u00e8ne : Fran\u00e7ois Gillerot\nCo-\u00e9criture : Fran\u00e7ois Gillerot, Arthur Oudar\nInterpr\u00e9tation : Lucile Charnier, Gaspard Dadelsen, Cl\u00e9ment Goethals\nCr\u00e9ation Lumi\u00e8re : Am\u00e9lie G\u00e9hin\nSc\u00e9nographie : Marie Menzaghi\nCr\u00e9ation Costumes : Marine Vanhaesendonck\nComposition musicale : Luc Bersier, Gaspard Dadelsen, No\u00e9 Gillerot\nR\u00e9gie g\u00e9n\u00e9rale : Benoit Guilbert\nCr\u00e9dits : \u00a9 Llywelyn Nys \u00a9 Aur\u00e9lie Clarembaux\n","boxoffice_url":null,"website":"https:\/\/lejacquesfranck.be\/event\/dys-sur-dys\/2025-01-15\/","email":"info@lejacquesfranck.be","phone_contact":"+32 2 538 90 20","phone_booking":"+32 2 538 90 20","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700001528"},"sp":{"name":"Dys sur dys","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lejacquesfranck.be\/event\/dys-sur-dys\/2025-01-15\/","email":"info@lejacquesfranck.be","phone_contact":"+32 2 538 90 20","phone_booking":"+32 2 538 90 20","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700001528"},"nl":{"name":"Dys sur dys","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lejacquesfranck.be\/event\/dys-sur-dys\/2025-01-15\/","email":"info@lejacquesfranck.be","phone_contact":"+32 2 538 90 20","phone_booking":"+32 2 538 90 20","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700001528"}},"place":{"id":4,"translations":{"de":{"name":"Centre Culturel Jacques Franck","address_street_name":"Chauss\u00e9e de Waterloo","address_street_number":"94","address_street_box":null,"email":"info@lejacquesfranck.be","website":"http:\/\/www.lejacquesfranck.be","phone_contact":"+32 2 538 90 20","phone_booking":"+32 2 538 90 20","address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Chauss\u00e9e de Waterloo, 94","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Centre Culturel Jacques Franck","address_street_name":"Chauss\u00e9e de Waterloo","address_street_number"