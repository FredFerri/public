cept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":true,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[24,30],"translations":{"fr":["Galeries d'art","Peinture"],"nl":["Galeries","Schilderkunst"],"en":["Art Galleries","Painting"]}}},"languages":{"spoken":["fr","en"],"subtitles":[]},"translations":{"fr":{"name":"Wiltja \u2013 Shelter - L\u2019abri - Art Aborig\u00e8ne Australie","shortdescr":"L\u2019exposition d'art Aborig\u00e8ne \"L'Abri\" \u00e0 Bruxelles rend hommage de fa\u00e7on exceptionnelle \u00e0 deux grands artistes t\u00e9moins vivants - Alec Baker (1932) et Angkuna Baker (1934) -, avec une exposition solo des \u0153uvres de ce couple l\u00e9gendaire.","longdescr":"Nous invitons au c\u0153ur du d\u00e9sert rouge Australien \u00e0 la d\u00e9couverte d\u2019un couple l\u00e9gendaire n\u00e9 au d\u00e9but des ann\u00e9es 1930.\r\nLe titre de l'exposition s\u00e9lectionn\u00e9 par les artistes fait r\u00e9f\u00e9rence aux wiltja (des abris mont\u00e9s manuellement) qui furent construits pr\u00e8s du ruisseau Iwantja au d\u00e9but de la communaut\u00e9 d'Indulkana, sur le site fondateur de l\u2019hibou indig\u00e8ne (Tjurki Tjukurpa), une histoire fondamentale du Temps du R\u00eave.\r\n\r\nDes a\u00een\u00e9s et grands initi\u00e9s comme Alec Baker (1932) et Angkuna Baker (1934) faisaient partie de ceux qui ont cr\u00e9\u00e9 cette communaut\u00e9 et ont jou\u00e9 un r\u00f4le central dans la cr\u00e9ation de nouveaux b\u00e2timents et services comme le centre d'art et l'\u00e9cole.\r\n\r\nL\u2019exposition \u00e0 Bruxelles rend hommage de fa\u00e7on exceptionnelle \u00e0 ces deux grands artistes t\u00e9moins vivants, avec une exposition solo ici en Europe des \u0153uvres de ce couple l\u00e9gendaire.\r\n\r\nCelle-ci est accompagn\u00e9e dans une autre partie de la galerie par une deuxi\u00e8me exposition des peintures de la jeune g\u00e9n\u00e9ration d\u2019Iwantja qui poursuit avec talent et puissance leur \u0153uvre. \r\n\r\nWiltja \u00e9voque l'abri, l'ombre, la s\u00e9curit\u00e9 et un endroit calme et paisible. Le titre fait \u00e9galement r\u00e9f\u00e9rence \u00e0 la fa\u00e7on dont le savoir des A\u00een\u00e9s d\u2019Iwantja, la culture, le Territoire Ancestral, ont \u00e9t\u00e9 un abri protecteur au fil du temps et durant les difficiles derni\u00e8res ann\u00e9es de la pand\u00e9mie de Covid-19.\r\n\r\nIwantja Arts est un centre d'art aborig\u00e8ne d\u00e9tenu et g\u00e9r\u00e9 par les Aborig\u00e8nes, dans le pays rocheux et d\u00e9sertique de la communaut\u00e9 d\u2019Indulkana sur les terres Anangu Pitjantjatjara Yankunytjatjara (APY) dans le nord-ouest recul\u00e9 de l'Australie du Sud.\r\n\r\nLe centre d'art a \u00e9t\u00e9 cr\u00e9\u00e9 au d\u00e9but des ann\u00e9es 1980 par les artistes et directeurs Alec Baker et Sadie Singer. Depuis Iwantja Arts soutient le cheminement artistique de ses 40 membres, principalement des artistes Yankunytjatjara, en leur offrant un acc\u00e8s au d\u00e9veloppement artistique. Iwantja Arts est r\u00e9put\u00e9 pour ses projets innovants et culturellement riches avec des r\u00e9sultats prestigieux qui c\u00e9l\u00e8brent la force culturelle et l'excellence artistique du peuple Anangu.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.aboriginalsignature.com\/wiltja-shelter-abri","email":"info@aboriginalsignature.com","phone_contact":"+32 475 55 08 54","phone_booking":"+32 475 55 08 54","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/532888.html"},"nl":{"name":"Wiltja \u2013 Shelter - L\u2019abri - Art Aborig\u00e8ne Australie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/532888.html"},"en":{"name":"Wiltja \u2013 Shelter - L\u2019abri - Art Aborig\u00e8ne Australie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/532888.html"},"de":{"name":"Exposition - Wiltja \u2013 Shelter - L\u2019abri - Art Aborig\u00e8ne Australie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/532888.html"},"it":{"name":"Exposition - Wiltja \u2013 Shelter - L\u2019abri - Art Aborig\u00e8ne Australie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/532888.html"},"sp":{"name":"Exposition - Wiltja \u2013 Shelter - L\u2019abri - Art Aborig\u00e8ne Australie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/532888.html"},"pt":{"name":"Exposition - Wiltja \u2013 Shelter - L\u2019abri - Art Aborig\u00e8ne Australie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/532888.html"},"cn":{"name":"Exposition - Wiltja \u2013 Shelter - L\u2019abri - Art Aborig\u00e8ne Australie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/532888.html"}},"place":{"id":259735,"translations":{"fr":{"name":"Aboriginal Signature Estrangin Gallery","address_street_name":"Rue Jules Besme","address_street_number":"101","address_street_box":null,"email":"info@aboriginalsignature.com","website":"http:\/\/www.aboriginalsignature.com","phone_contact":"+32 475 55 08 54","phone_booking":"+32 475 55 08 54","address_zip":"1081","address_city":"Koekelberg","address_line1":"Rue Jules Besme, 101","address_line2":"1081 Koekelberg","description_web":"La galerie Aboriginal Signature Estrangin est une des plus importantes galeries d\u2019art Aborig\u00e8ne contemporain en Europe, dont la d\u00e9marche est unique avec 7 expositions curatoriales par an \u00e0 Bruxelles dans son espace de 250 m2, situ\u00e9 dans le quartier de la basilique de Koekelberg. Elle repr\u00e9sente plus de 100 artistes indig\u00e8nes des plus significatifs d\u2019Australie \u00e0 la jeune g\u00e9n\u00e9ration, et est engag\u00e9e dans une d\u00e9marche \u00e9thique de partenariat avec eux et les 35 centres d\u2019art et communaut\u00e9s artistiques dans les d\u00e9serts les plus \u00e9loign\u00e9s du nord au sud de ce continent. Chaque ann\u00e9e le directeur de la galerie  se rend dans les territoires aborig\u00e8nes pour pr\u00e9parer les expositions avec les artistes et s\u00e9lectionner in-situ les \u0153uvres. Ce mouvement artistique lanc\u00e9 autour de 1971 \u00e0 Papunya s\u2019inscrit dans une dynamique mill\u00e9naire de transmission du savoir, de c\u00e9l\u00e9bration des lieux sacr\u00e9s, avec une expression picturale entre tradition et innovation. Il prend une amplitude de plus en plus importante dans le monde de l\u2019art, aupr\u00e8s des collectionneurs priv\u00e9s et des prestigieuses collections des plus grandes institutions en Europe, aux USA et en Australie.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Aboriginal Signature Estrangin Gallery","address_street_name":"Jules Besmestraat","address_street_number":"101","address_street_box":null,"email":"info@aboriginalsignature.com","website":"http:\/\/www.aboriginalsignature.com","phone_contact":"+32 475 55 08 54","phone_booking":"+32 475 55 08 54","address_zip":"1081","address_city":"Koekelberg","address_line1":"Jules Besmestraat, 101","address_line2":"1081 Koekelberg","description_web":"Aboriginal Signature Estrangin is een van Europa's meest toonaangevende hedendaagse Aboriginal kunstgalerijen. De aanpak is uniek: er worden 7 tentoonstellingen per jaar gecureerd in de 250m2 grote galerie (gelegen in de buurt van de Basiliek van Koekelberg). Ze vertegenwoordigt meer dan 100 autochtone kunstenaars, zowel gevestigd als opkomend talent, in een ethisch  partnerschap met hen en de 35 kunstcentra en gemeenschappen in de meest afgelegen van het Australisch continent. Elk jaar reist de directeur van de galerie naar de Aboriginalgebieden om samen met de kunstenaars tentoonstellingen voor te bereiden en ter plaatse werken te selecteren. Deze artistieke beweging, die rond 1971 in Papunya ontstond, maakt deel uit van een eeuwenoude dynamiek van kennisoverdracht en viering van heilige plaatsen, met een picturale expressie die traditie en vernieuwing combineert. Een beweging die aan belang wint in de kunstwereld, bij particuliere verzamelaars en in prestigieuze collecties van de grootste instellingen in Europa, de VS en Australi\u00eb.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Aboriginal Signature Estrangin Gallery","address_street_name":"Rue Jules Besme","address_street_number":"101","address_street_box":null,"email":"info@aboriginalsignature.com","website":"http:\/\/www.aboriginalsignature.com","phone_contact":"+32 475 55 08 54","phone_booking":"+32 475 55 08 54","address_zip":"1081","address_city":"Koekelberg","address_line1":"Rue Jules Besme, 101","address_line2":"1081 Koekelberg","description_web":"The Aboriginal Signature Estrangin gallery is one of the most important contemporary Aboriginal art galleries in Europe, whose approach is unique with 7 curatorial exhibitions per year in Brussels in its 250 m2 space, located in the basilica district of Koekelberg. The gallery represents more than 100 of Australia's most significant indigenous artists to the younger generation, and is committed to an ethical approach of partnership with them and the 35 art centers and artistic communities in the most remote deserts from the north to the south of this continent. Each year, the director of the gallery goes to the aboriginal territories to prepare the exhibitions with the artists and to select the works in situ. This artistic movement launched around 1971 in Papunya is part of a millennial dynamic of transmission of knowledge, of celebration of sacred places, with a pictorial expression between tradition and innovation. It is becoming increasingly important in the art world, with private collectors and prestigious collections from the largest institutions in Europe, the USA and Australia. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Aboriginal Signature - Estrangin Fine art","address_street_name":"Rue Jules Besme","address_street_number":"101","address_street_box":null,"email":"info@aboriginalsignature.com","website":"http:\/\/www.aboriginalsignature.com","phone_contact":"+32 475 55 08 54","phone_booking":"+32 475 55 08 54","address_zip":"1081","address_city":"Koekelberg","address_line1":"Rue Jules Besme, 101","address_line2":"1081 Koekelberg","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Aboriginal Signature - Estrangin Fine art","address_street_name":"Rue Jules Besme","address_street_number":"101","address_street_box":null,"email":"info@aboriginalsignature.com","website":"http:\/\/www.aboriginalsignature.com","phone_contact":"+32 475 55 08 54","phone_booking":"+32 475 55 08 54","address_zip":"1081","address_city":"Koekelberg","address_line1":"Rue Jules Besme, 101","address_line2