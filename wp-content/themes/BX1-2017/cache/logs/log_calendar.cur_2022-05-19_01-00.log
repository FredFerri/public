ment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[24,29],"translations":{"fr":["Galeries d'art","Installation"],"nl":["Galeries","Installatiekunst"],"en":["Art Galleries","Installation"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Au Passage","shortdescr":"La commune de Saint-Gilles, Simon Ruaut et le Lyc\u00e9e Int\u00e9gral Roger Lallemand ont le plaisir de vous inviter au lancement de la fresque \u00ab Au Passage \u00bb; une installation graphique et po\u00e9tique in-situ en collaboration avec des \u00e9tudiants du Lyc\u00e9e LIRL.","longdescr":"La commune de Saint-Gilles, Simon Ruaut et le Lyc\u00e9e Int\u00e9gral Roger Lallemand ont le plaisir de vous inviter au lancement de la fresque \u00ab Au Passage \u00bb; une installation graphique et po\u00e9tique in-situ en collaboration avec des \u00e9tudiants du Lyc\u00e9e LIRL.\r\nCette fresque en papier coll\u00e9 de plus de 16 m, invite \u00e0 la fl\u00e2nerie et ouvre sur de nouveaux horizons.\r\nCe projet a \u00e9t\u00e9 rendu possible gr\u00e2ce au soutien du service Culture et du service des Affaires N\u00e9erlandophones de Saint-Gilles.","performers":"La commune de Saint-Gilles, Simon Ruaut et le Lyc\u00e9e Int\u00e9gral Roger Lallemand","boxoffice_url":null,"website":"http:\/\/www.stgillesculture.brussels","email":"culture.1060@stgilles.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/530857.html"},"nl":{"name":"Au Passage","shortdescr":"De gemeente Sint-Gillis, Simon Ruaut en het Lyc\u00e9e Int\u00e9gral Roger Lallemand nodigen u graag uit voor de lancering van het fresco \"Au Passage\"; een grafische en po\u00ebtische in-situ installatie die vorm kreeg in samenwerking met leerlingen van het Lyc\u00e9e LIRL.","longdescr":"De gemeente Sint-Gillis, Simon Ruaut en het Lyc\u00e9e Int\u00e9gral Roger Lallemand nodigen u graag uit voor de lancering van het fresco \"Au Passage\"; een grafische en po\u00ebtische in-situ installatie die vorm kreeg in samenwerking met leerlingen van het Lyc\u00e9e LIRL.\r\nDit papieren fresco van meer dan 16 m lang nodigt uit tot een wandeling en opent nieuwe horizonten.\r\nHet project werd mogelijk gemaakt door de steun van de diensten Cultuur en Nederlandstalige Aangelegenheden van de gemeente Sint-Gillis.","performers":"De gemeente Sint-Gillis, Simon Ruaut en het Lyc\u00e9e Int\u00e9gral Roger Lallemand","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/530857.html"},"en":{"name":"Au Passage","shortdescr":"The municipality of Saint-Gilles, Simon Ruaut and the high school Int\u00e9gral Roger Lallemand are glad to invite you to the launch of the fresco \"Au Passage\"; a graphic and poetic installation in-situ in collaboration with students of the high school LIRL.","longdescr":"The municipality of Saint-Gilles, Simon Ruaut and the high school Int\u00e9gral Roger Lallemand are glad to invite you to the launch of the fresco \"Au Passage\"; a graphic and poetic installation in-situ in collaboration with students of the high school LIRL.\r\nThis wall fresco made of glue paper of more than 16m in length, invites you to stroll and opens up new horizons.\r\nThis project was made possible by the support of the municipal culture department and the municipal department for Dutch-language affairs of the town of Saint-Gilles.","performers":"The municipality of Saint-Gilles, Simon Ruaut and the high school Int\u00e9gral Roger Lallemand","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/530857.html"},"de":{"name":"Au Passage","shortdescr":null,"longdescr":null,"performers":null,"boxoff