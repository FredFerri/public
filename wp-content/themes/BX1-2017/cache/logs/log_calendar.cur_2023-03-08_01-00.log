ublished_at":"2023-01-26T12:24:52+01:00","backoffice_id":270431,"import_origin":null,"sub_type":"concert","show_in_agenda":true,"ranking":1.2599210498949},{"id":552407,"date_start":"2023-03-17","date_end":"2023-03-17","date_next":"2023-03-17","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater","it":"Teatro","sp":"Teatro","pt":null,"cn":null}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"],"de":["Theater"],"it":["Teatro"],"sp":["Teatro"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Un silence ordinaire","shortdescr":"Didier Poiteaux investit le trouble domaine de l\u2019alcoolisme avec sensibilit\u00e9 et d\u00e9licatesse.","longdescr":"Raconter les histoires des autres, c\u2019est aller vers l\u2019autre mais aussi tenter de se rapprocher de la sienne. Suivant la voie du th\u00e9\u00e2tre documentaire, Un silence ordinaire, nous propose de partager, dans une narration simple et sinc\u00e8re, des r\u00e9cits de vies li\u00e9s \u00e0 l\u2019alcoolisme. Symbole de convivialit\u00e9, de f\u00eate et de plaisir autant que signe de maladie, de rejet et d\u2019isolement, qu\u2019est-ce que l\u2019alcool nous d\u00e9voile de nous-m\u00eame et de notre soci\u00e9t\u00e9 ? Au-del\u00e0 de ces questions, le spectacle cherche comment briser un tabou, comment casser les murs qui enferment les non-dits ?","performers":"Conception, \u00e9criture et interpr\u00e9tation: \r\nDidier Poiteaux\r\n\r\nAssistante:\r\nJulie Marichal\r\n\r\nDramaturgie, mise en sc\u00e8ne:\r\nOlivier Lenel\r\n\r\nSc\u00e9nographie:\r\nMarilyne Grimmer","boxoffice_url":null,"website":"https:\/\/www.pierredelune.be","email":"contact@pierredelune.be","phone_contact":null,"phone_booking":"+32 2 469 26 75","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.552407"},"nl":{"name":"Un silence ordinaire","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.pierredelune.be","email":"contact@pierredelune.be","phone_contact":null,"phone_booking":"+32 2 469 26 75","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.552407"},"en":{"name":"Un silence ordinaire","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.pierredelune.be","email":"contact@pierredelune.be","phone_contact":null,"phone_booking":"+32 2 469 26 75","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.552407"},"de":{"name":"Un silence ordinaire","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.pierredelune.be","email":"contact@pierredelune.be","phone_contact":null,"phone_booking":"+32 2 469 26 75","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.552407"},"it":{"name":"Un silence ordinaire","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.pierredelune.be","email":"contact@pierredelune.be","phone_contact":null,"phone_booking":"+32 2 469 26 75","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.552407"},"sp":{"name":"Un silence ordinaire","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.pierredelune.be","email":"contact@pierredelune.be","phone_contact":null,"phone_booking":"+32 2 469 26 75","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.552407"},"pt":{"name":"Un silence ordinaire","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.pierredelune.be","e