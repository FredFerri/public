_not_major_event":false,"backoffice_id":303526,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"theatre","ranking":0.5108729549290354,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":49,"translations":{"de":"Theater","pt":null,"en":"Theatre","it":"Teatro","cn":null,"fr":"Th\u00e9\u00e2tre","sp":"Teatro","nl":"Theater"}},"others":{}},"translations":{"de":{"name":"Le Tartuffe","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50012199"},"pt":{"name":"Le Tartuffe","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50012199"},"en":{"name":"Le Tartuffe","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50012199"},"it":{"name":"Le Tartuffe","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50012199"},"cn":{"name":"Le Tartuffe","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50012199"},"fr":{"name":"Le Tartuffe","shortdescr":null,"longdescr":"Orgon (Laurent Capelluto) est persuad\u00e9 d\u2019avoir trouv\u00e9 en Tartuffe (Pietro Pizzuti) l\u2019\u00e2me s\u0153ur, le sauveur, le confident tant r\u00eav\u00e9. Totalement s\u00e9duit par le saint homme, il lui ouvre grand les portes de son logis et de son amiti\u00e9. Il impose ce directeur de conscience \u00e0 toute sa maisonn\u00e9e, et bient\u00f4t le voil\u00e0 de \u00ab cet homme enti\u00e8rement coiff\u00e9 \u00bb !\nMais Tartuffe est un mendiant, un usurpateur, un menteur infiniment s\u00e9duisant qui va tournebouler le cerveau du ma\u00eetre de maison pour tenter de mettre toute la famille \u00e0 ses pieds, la femme dans son lit, la fille \u00e0 son bras et l\u2019argent dans sa poche.\n\nLe Tartuffe est une histoire d\u2019abus de pouvoir. Celle d\u2019un patriarche autoritaire qui entend tout r\u00e9genter, et qui, par peur du monde tel qu\u2019il va, se r\u00e9fugie dans les bras d\u2019un beau parleur-tricheur-manipulateur. Quand l\u2019avenir est d\u00e9routant, il est plus facile pour certains en perte de rep\u00e8res, de se retourner vers d\u2019anciennes valeurs morales \u00ab ayant fait leurs preuves \u00bb, plut\u00f4t que de chercher \u00e0 inventer de nouvelles voies.\nHorrifi\u00e9, d\u00e9sar\u00e7onn\u00e9, l\u2019entourage ne veut pas se laisser \u00ab Tartuffier \u00bb. Or, quand le pouvoir est concentr\u00e9 dans les mains d\u2019un seul, il faut d\u00e9ployer des tr\u00e9sors d\u2019ing\u00e9niosit\u00e9 et de courage pour parvenir \u00e0 remettre un peu de raison dans la d\u00e9raison et l\u2019\u00e9glise au milieu du village.\n\nNotre monde est rempli de ces fameux pr\u00e9dicateurs, faux d\u00e9vots, faux bienveillants, vrais abuseurs, qui entendent r\u00e9genter le monde par cupidit\u00e9 et besoin de domination. Moli\u00e8re, l\u2019intemporel, n\u2019a rien perdu de son universalit\u00e9 ni de sa verve et avec beaucoup d\u2019humour nous incite une fois encore \u00e0 aiguiser notre libre arbitre.\n__________\n\nDe Moli\u00e8re \/ Mise en sc\u00e8ne : Michel Kacenelenbogen \/ Avec : Laurent Capelluto, Jonas Claessens, Lily Dupont, Emile Falk-Blin, Janine Godinas, Jeanne Kacenelenbogen, Simon Lombard, Pietro Pizzuti, R\u00e9al Siellez et Anne Sylvain \/ Assistante \u00e0 la mise en sc\u00e8ne : H\u00e9l\u00e8ne Catsaras \/ Sc\u00e9nographie : Renata Gorka \/ Costumes : Chandra Vellut \/ Lumi\u00e8re : Laurent Kaye \/ Musique originale : Pascal Charpentier\n__________\n\nUNE PRODUCTION DU TH\u00c9\u00c2TRE LE PUBLIC. AVEC L'AIDE DE LA F\u00c9D\u00c9RATION WALLONIE-BRUXELLES - DIRECTION DU TH\u00c9\u00c2TRE, ET LE SOUTIEN DU TAX SHELTER DE L\u2019\u00c9TAT F\u00c9D\u00c9RAL BELGE VIA BESIDE. ","performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50012199"},"sp":{"name":"Le Tartuffe","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50012199"},"nl":{"name":"Le Tartuffe","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50012199"}},"place":{"id":224476,"translations":{"de":{"name":"Th\u00e9\u00e2tre Le Public","address_street_name":"Rue Braemt","address_street_number":"64 70","address_street_box":null,"email":"contact@theatrelepublic.be","website":"http:\/\/www.theatrelepublic.be","phone_contact":"+32 2 724 24 44","phone_booking":"+32 2 724 2