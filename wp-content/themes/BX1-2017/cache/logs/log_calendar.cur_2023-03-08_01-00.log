ants tout \u00e9veill\u00e9s.\r\nPour cela, ils leur font dessiner des d\u00e9cors incroyables et les projettent sur sc\u00e8ne afin de jouer dedans.\r\n\u00ab Maintenant, ils se souviendront de nous ! \u00bb","performers":"M\u00e9lissa Motheu, Thierry Maerschalk, Hicham El Hamouri","boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Prete-Moi-Ton-Reve.html","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.539470"},"nl":{"name":"Pr\u00eate-moi ton r\u00eave","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Prete-Moi-Ton-Reve.html","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.539470"},"en":{"name":"Pr\u00eate-moi ton r\u00eave","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Prete-Moi-Ton-Reve.html","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.539470"},"de":{"name":"Pr\u00eate-moi ton r\u00eave","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Prete-Moi-Ton-Reve.html","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.539470"},"it":{"name":"Pr\u00eate-moi ton r\u00eave","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Prete-Moi-Ton-Reve.html","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.539470"},"sp":{"name":"Pr\u00eate-moi ton r\u00eave","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"webs