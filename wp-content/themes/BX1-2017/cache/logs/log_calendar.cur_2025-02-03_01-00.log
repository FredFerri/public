false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2025-01-30T08:54:29+01:00","published_at":"2025-01-29T16:54:22+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":317142,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"party","ranking":0.7937005259840998,"languages":{"spoken":["nl","fr","en"],"subtitles":[]},"categories":{"main":{"id":57,"translations":{"de":"Clubbing","pt":null,"en":"Clubbing","it":"Locali notturni","cn":null,"fr":"Clubbing","sp":"Ir de discoteca","nl":"Clubbing"}},"others":{}},"translations":{"de":{"name":"Kinky sneax","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.besneax.be\/belgian-sneakers-days\/belgian-sneakers-days-2025\/","email":"besneax@besneax.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700005980"},"pt":{"name":"Kinky sneax","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.besneax.be\/belgian-sneakers-days\/belgian-sneakers-days-2025\/","email":"besneax@besneax.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700005980"},"en":{"name":"Kinky sneax","shortdescr":"#BEsneax has initiated 100% sportswear parties in the capital of Europe. The association has developed the first events combining clubbing and cruising with a 100% sportswear strict dresscode to guarantee a unique atmosphere.","longdescr":"#BEsneax has initiated 100% sportswear parties in the capital of Europe. The association has developed the first events combining clubbing and cruising with a 100% sportswear strict dresscode to guarantee a unique atmosphere.\n\nIn addition to a bar and disco area entertained by renowned DJs, an equipped playroom (men \u2013 cis & trans \u2013 only in this sector) dedicated to pleasure with sniffing mat and slings is at your disposal.\n\nFor this edition during the Belgian Snealers Days, the famous brand Boxer Barcelona is our exclusive partner. Thanks to them, we\u2019re able to organize a photocall with the services of a professional photographer who will immortalize your arrival with your friends.\n\nThis year, the event will be held in a new location. Caf\u00e9 Barrio is one of the most beautiful clubs in Brussels with very high-quality sound equipment. Located in a vaulted brick cellar, it offers an exceptional atmosphere. Two of our partners organize their regular parties there, Cave and Fetish Project.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.besneax.be\/belgian-sneakers-days\/belgian-sneakers-days-2025\/","email":"besneax@besneax.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700005980"},"it":{"name":"Kinky sneax","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.besneax.be\/belgian-sneakers-days\/belgian-sneakers-days-2025\/","email":"besneax@besneax.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700005980"},"cn":{"name":"Kinky sneax","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.besneax.be\/belgian-sneakers-days\/belgian-sneakers-days-2025\/","email":"besneax@besneax.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700005980"},"fr":{"name":"Kinky sneax","shortdescr":"#BEsneax est \u00e0 l'origine des soir\u00e9es 100% sportswear dans la capitale de l'Europe. L'association a d\u00e9velopp\u00e9 les premiers \u00e9v\u00e9nements alliant clubbing et cruising avec un dresscode strict 100% sportswear pour garantir une ambiance unique.","longdescr":"#BEsneax est \u00e0 l\u2019origine des soir\u00e9es 100% sportswear dans la capitale de l\u2019Europe. L\u2019association a d\u00e9velopp\u00e9 les premiers \u00e9v\u00e9nements alliant clubbing et cruising avec un dresscode strict 100% sportswear pour garantir une ambiance unique.\n\nEn plus d\u2019un espace bar et discoth\u00e8que anim\u00e9 par des DJ de renom, une playroom \u00e9quip\u00e9e (hommes \u2013 cis & trans \u2013 uniquement dans cette zone) d\u00e9di\u00e9e au plaisir avec tapis \u00e0 sniff et slings mis \u00e0 votre disposition.\n\nPour cette \u00e9dition lors des Belgian Snealers Days, la c\u00e9l\u00e8bre marque Boxer Barcelona est notre partenaire exclusif. Gr\u00e2ce \u00e0 eux, nous sommes en mesure d\u2019organiser un photocall avec les services d\u2019un photographe professionnel qui immortalisera votre arriv\u00e9e avec vos amis.\n\nCette ann\u00e9e, l\u2019\u00e9v\u00e9nement se tiendra dans un nouveau lieu. Le Caf\u00e9 Barrio est l\u2019un des plus beaux clubs de Bruxelles avec un \u00e9quipement sonore de tr\u00e8s haute qualit\u00e9. Situ\u00e9 dans une cave vo\u00fbt\u00e9e en briques, il offre une ambiance exceptionnelle. Deux de nos partenaires y organisent leurs soir\u00e9es r\u00e9guli\u00e8res, Cave et Fetish Project.","performers":"DJ Card Mercier\nDJ Luis Roza\nDJ Gab Valerio","boxoffice_url":null,"website":"https:\/\/www.besneax.be\/belgian-sneakers-days\/belgian-sneakers-days-2025\/","email":"besneax@besneax.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700005980"},"sp":{"name":"Kinky sneax","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.besneax.be\/belgian-sneakers-days\/belgian-sneakers-days-2025\/","email":"besneax@besneax.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700005980"},"nl":{"name":"Kinky sneax","shortdescr":"#BEsneax heeft 100% sportswearparty's ge\u00efnitieerd in de hoofdstad van Europa. De vereniging heeft de eerste evenementen ontwikkeld die clubbing en cruising combineren met een strikte 100% sportsweardresscode om een \u200b\u200bunieke sfeer te garanderen.","longdescr":"#BEsneax heeft 100% sportswear-feesten in de hoofdstad van Europa ge\u00efnitieerd. De vereniging heeft de eerste evenementen ontwikkeld die clubbing en cruising combineren met een strikte 100% sportswear-dresscode om een \u200b\u200bunieke sfeer te garanderen.\n\nNaast een bar en discoruimte met gerenommeerde dj's, staat er een uitgeruste playroom (mannen - cis & trans - alleen in deze sector) tot uw beschikking, gewijd aan plezier met snuffelmat en slings.\n\nVoor deze editie tijdens de Belgian Snealers Days is het beroemde merk Boxer Barcelona onze exclusieve partner. Dankzij hen kunnen we een photocall organiseren met de diensten van een professionele fotograaf die uw aankomst met uw vrienden zal vereeuwigen.\n\nDit jaar wordt het evenement gehouden op een nieuwe locatie. Caf\u00e9 Barrio is een van de mooiste clubs in Brussel met zeer hoogwaardige geluidsapparatuur. Gelegen in een gewelfde bakstenen kelder, biedt het een uitzonderlijke sfeer. Twee van onze partners organiseren er hun vaste feesten, Cave en Fetish Project.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.besneax.be\/belgian-sneakers-days\/belgian-sneakers-days-2025\/","email":"besneax@besneax.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700005980"}},"place":{"id":50002530,"translations":{"de":{"name":"Barrio Caf\u00e9","address_street_name":"Place de la Chapelle","address_street_number":"6","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_