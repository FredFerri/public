esday, wednesday, thursday, friday, saturday and sunday: from 10:00 to 17:00"]},"date_start":"2023-02-14","date_end":"2023-06-10","is_also_by_appointment":false}],"prices":[{"translations":{"fr":{"name":"Article 27"},"nl":{"name":"Artikel 27"},"en":{"name":"Article 27"},"de":{"name":"Article 27"},"it":{"name":"Article 27"},"sp":{"name":"Article 27"},"pt":{"name":"Article 27"},"cn":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"visit_profile":{"list":[337],"translations":{"fr":["Highlight"],"nl":["Highlight"],"en":["Highlight"],"de":["Highlight"],"it":["Highlight"],"sp":["Highlight"],"pt":[null],"cn":[null]}},"tags":["annee_art_nouveau"],"is_part_of":"Ann\u00e9e Art Nouveau","accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-02-10T19:37:01+01:00","published_at":"2022-10-11T09:00:34+02:00","backoffice_id":263825,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.32548726473767},{"id":548874,"date_start":"2022-12-16","date_end":"2023-02-25","date_next":"2023-02-14","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung","it":"Esposizioni","sp":"Exhibici\u00f3n","pt":null,"cn":null}},"others":{"list":[36,44],"translations":{"fr":["Mus\u00e9es et art centers","Design"],"nl":["Musea en kunstcentra","Design"],"en":["Museums and art centers","Design"],"de":["Museen & Kunstzentren","Design"],"it":["Musei e centri artistici","Design"],"sp":["Museos y centros de arte","Dise\u00f1o"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Modern Craft #2 \u2014 The power of ceramics","shortdescr":null,"longdescr":"L'exposition pr\u00e9sente un ensemble de cr\u00e9ations contemporaines issues de techniques nouvelles et innovantes empruntant aux processus de fabrication artisanaux et industriels. Des designers et studios bruxellois tels que Studio BISKT, Sylvain Willenz et Frizbee Ceramics sont ainsi pr\u00e9sent\u00e9s au c\u00f4t\u00e9 de cr\u00e9ateur\u00b7ices tel\u00b7les que Ronan & Erwan Bouroullec et Hugo Meert.\r\n\r\nLes diff\u00e9rentes th\u00e9matiques pr\u00e9sentent chacune des particularit\u00e9s qui rendent le monde de la c\u00e9ramique contemporaine si int\u00e9ressant.  Des pi\u00e8ces uniques et de l'exp\u00e9rimentation avec divers mat\u00e9riaux, \u00e0 la production industrielle bas\u00e9e sur l'artisanat. La fabrication de ses propres outils et ressources est \u00e9galement en plein essor et a une grande influence sur les nouvelles m\u00e9thodes de production.\r\n\r\nUne approche de la c\u00e9ramique contemporaine, qui met l'accent sur l'aspect novateur de l'artisanat. Que se passe-t-il aujourd'hui ? Quelles sont les innovations que nous observons ? Quelle est l'influence sur l'industrie ? D\u00e9couvrez l'univers de la c\u00e9ramique \u00e0 partir du vendredi 16 d\u00e9cembre au MAD Brussels.","performers":null,"boxoffice_url":null,"website":"https:\/\/mad.brussels\/en\/agenda\/modern-craft-2-power-ceramics","email":"contact@mad.brussels","phone_contact":null,"phone_booking":"+32 2 880 85 62","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.548874"},"nl":{"name":"Modern Craft #2 \u2014 The power of ceramics","shortdescr":null,"longdescr":"De tentoonstelling brengt hedendaagse voorbeelden van nieuwe en innovatieve technieken en ambachtelijke en industri\u00eble materialen. Brusselse ontwerpers en ateliers als Studio BISKT, Sylvain Willenz en Frizbee Ceramics gaan in dialoog met makers als Ronan & Erwan Bouroullec en Hugo Meert.\r\n\r\nVerschillende hoofdstukken tonen verschillende aspecten die de wereld van de hedendaagse keramiek interessant maken. Van unieke stukken en experimenten met materialen tot industri\u00eble productie op basis van ambachten. Ook het maken van eigen gereedschap en middelen is in opkomst en heeft een grote invloed op nieuwe productiemethoden.\r\n\r\nEen visie op hedendaagse keramiek, waarbij vooral het innovatieve aspect van het vakmanschap wordt belicht. Wat gebeurt er vandaag de dag? Welke innovaties zien we? Wat is de invloed op de industrie? Ontdek de wereld van de keramiek vanaf vrijdag 16 december bij MAD Brussels.","performers":null,"boxoffice_url":null,"website":"https:\/\/mad.brussels\/en\/agenda\/modern-craft-2-power-ceramics","email":"contact@mad.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.548874"},"en":{"name":"Modern Craft #2 \u2014 The power of ceramics","shortdescr":null,"longdescr":"The exhibition brings together contemporary examples of new and innovative techniques using artisanal and industrial means. Brussels designers and studios such as Studio BISKT, Sylvain Willenz and Frizbee Ceramics will be in dialogue with creators such as Ronan & Erwan Bouroullec and Hugo Meert.\r\n\r\nDifferent chapters each show different aspects that make the world of contemporary ceramics so interesting. From unique pieces and experimentation with materials to industrial production based on crafts. Making your own tools and resources is also on the rise and has a big influence on new productions methods.\r\n\r\nA vision on contemporary ceramics, especially highlighting the innovative aspect of the craftsmanship. What is happening today? Which innovations do we see? What is the influence on the industry? Explore the world of ceramics from Friday 16 December at MAD Brussels.","performers":null,"boxoffice_url":null,"website":"https:\/\/mad.brussels\/en\/agenda\/modern-craft-2-power-ceramics","email":"contact@mad.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.548874"},"de":{"name":"Modern Craft #2 \u2014 The power of ceramics","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/mad.brussels\/en\/agenda\/modern-craft-2-power-ceramics","email":"contact@mad.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.548874"},"it":{"name":"Modern Craft #2 \u2014 The power of ceramics","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/mad.brussels\/en\/agenda\/modern-craft-2-power-ceramics","email":"contact@mad.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.548874"},"sp":{"name":"Modern Craft #2 \u2014 The power of ceramics","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/mad.brussels\/en\/agenda\/modern-craft-2-power-ceramics","email":"contact@mad.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.548874"},"pt":{"name":"Modern Craft #2 \u2014 The power of ceramics","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/mad.brussels\/en\/agenda\/modern-craft-2-power-ceramics","email":"contact@mad.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.548874"},"cn":{"name":"Modern Craft #2 \u2014 The power of ceramics","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/mad.brussels\/en\/agenda\/modern-craft-2-power-ceramics","email":"contact@mad.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.548874"}},"place":{"id":250516,"translations":{"fr":{"name":"MAD \u2013 Home of Creators","address_street_name":"Place du Nouveau March\u00e9 aux Grains","address_street_number":"10","address_street_box":null,"email":"contact@mad.brussels","website":"http:\/\/www.mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":"+32 2 880 85 62","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place du Nouveau March\u00e9 aux Grains, 10","address_line2":"1000 Bruxelles","description_web":"MAD Brussels est la plateforme bruxelloise d\u2019expertise dans les secteurs de la Mode et du Design.   Elle s\u2019emploie \u00e0 renforcer la promotion, \u00e0 accompagner le d\u00e9veloppement des stylistes et designers bruxellois et \u00e0 accro\u00eetre leur rayonnement (inter )national.  \r\n\r\nL\u2019ouverture en avril 2017 du nouveau b\u00e2timent enti\u00e8rement blanc a marqu\u00e9 une renaissance pour l\u2019asbl, qui dans ce lieu unique multiplie et combine ses actions. Il h\u00e9berge le centre de ressources pour les professionnels des industries cr\u00e9atives aux fili\u00e8res de m\u00e9tiers d\u00e9riv\u00e9es, des espaces de travail polyvalents, lieux de rencontres, d\u2019accueil de cr\u00e9ateurs, d\u2019ateliers, de s\u00e9minaires, ainsi qu\u2019un grand espace d\u00e9di\u00e9 aux activit\u00e9s publiques o\u00f9 sont organis\u00e9es chaque ann\u00e9e de multiples \u00e9v\u00e8nements: expositions, d\u00e9fil\u00e9s, performances artistiques,\u2026\r\n\r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"MAD \u2013 Home of Creators","address_street_name":"Nieuwe Graanmarkt","address_street_number":"10","address_street_box":null,"email":"contact@mad.brussels","website":"http:\/\/www.mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":"+32 2 880 85 62","address_zip":"1000","address_city":"Brussel","address_line1":"Nieuwe Graanmarkt, 10","address_line2":"1000 Brussel","description_web":"MAD Brussels is het Brussels kennisplatform voor de mode- en designsectoren.  Het zet zich in voor de promotie en begeleiding van Brusselse stylisten en ontwerpers en de vergroting van hun (inter)nationale uitstraling. \r\n\r\nDe opening van hun nieuwe, volledig witte gebouw in april 2017 betekende een belangrijke impuls voor de vzw die op die unieke plek zijn verschillende doelstellingen kan uitbreiden en combineren. Het gebouw herbergt het onderzoekscentrum voor professionals uit de creatieve sectoren en aanverwante beroepsgroepen, multifunctionele werkruimtes, ontmoetingsplekken, ontvangstruimtes voor ontwerpers, workshops en seminaries en daarbij ook nog een grote ruimte waarin elk jaar verschillende activiteiten voor het grote publiek plaatsvinden, zoals tentoonstellingen, modeshows of artistieke performances.  \r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"MAD \u2013 Home of Creators","address_street_name":"Place du Nouveau March\u00e9 aux Grains","address_street_number":"10","address_street_box":null,"email":"contact@mad.brussels","website":"http:\/\/www.mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":"+32 2 880 85 62","address_zip":"1000","address_city":"Brussels","address_line1":"Place du Nouveau March\u00e9 aux Grains, 10","address_line2":"1000 Brussels","description_web":"MAD Brussels is a Brussels\u2019 platform for gathering expertise from the city\u2019s Fashion and Design sectors. It aims to help with the promotion and development of Brussels stylists and designers and improve their exposure nationally and abroad.\r\n\r\nThe opening in April 2017 of their brand new, sparkling white headquarters marked something of a renaissance for the non-profit organisation, which can now multiply and combine its campaigns. It houses a ressource centre for professionals of the creative industries and related sectors, along with adaptable workspaces, meeting spaces, workshops, seminar rooms and a large space dedicated to public activities where multiple events are organised every year: exhibitions, fashion shows, artistic performances\u2026\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"MAD \u2013 Home of Creators","address_street_name":"Place du Nouveau March\u00e9 aux Grains","address_street_number":"10","address_street_box":null,"email":"contact@mad.brussels","website":"http:\/\/www.mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":"+32 2 880 85 62","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place du Nouveau March\u00e9 aux Grains, 10","address_line2":"1000 Bruxelles","description_web":"MAD Brussels ist eine Br\u00fcsseler Mode- und Designplattform, die sich der F\u00f6rderung, Unterst\u00fctzung und Begleitung der Br\u00fcsseler Modesch\u00f6pfer und Designern verschrieben hat, um sowohl landesweit als auch international ihre Reichweite zu erh\u00f6hen.\r\n\r\nDie Er\u00f6ffnung des neuen, komplett in Wei\u00df gehaltenen Geb\u00e4udes hat dem MAD Brussels noch einmal frischen Wind in den Segeln beschert. Hier befinden sich nicht nur Ressourcen f\u00fcr Vertreter der Kreativindustrie und damit zusammenh\u00e4ngenden Metiers, sondern auch vielf\u00e4ltig nutzbare Arbeitspl\u00e4tze und Orte der Begegnung. Modesch\u00f6pfer und Designer haben hier eine Anlaufstelle, gleichzeitig finden in den R\u00e4umen Ateliers, Workshops, Seminare, Ausstellungen, Modeschauen, Kunst-Performances statt\u2026\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"MAD \u2013 Home of Creators","address_street_name":"Place du Nouveau March\u00e9 aux Grains","address_street_number":"10","address_street_box":null,"email":"contact@mad.brussels","website":"http:\/\/www.mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":"+32 2 880 85 62","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place du Nouveau March\u00e9 aux Grains, 10","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"MAD \u2013 Home of Creators","address_street_name":"Place du Nouveau March\u00e9 aux Grains","address_street_number":"10","address_street_box":null,"email":"contact@mad.brussels","website":"http:\/\/www.mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":"+32 2 880 85 62","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place du Nouveau March\u00e9 aux Grains, 10","address_line2":"1000 Bruxelles","description_web":"MAD Brussels es una plataforma de Bruselas que reune expertos del los sectores de la moda y el dise\u00f1o. Tiene como objetivo ayudar en la promoci\u00f3n y el desarrollo de los dise\u00f1adores y estilistas de Bruselas y mejorar su imagen nacional e internacional.\r\nLa apertura de su novedosa y chispeante sede en abril de 2017 marc\u00f3 algo as\u00ed como el renacimiento para la organizaci\u00f3n sin \u00e1nimo de lucro, que ahora puede multiplicar y combinar sus campa\u00f1as. Posee un centro de recursos para profesionales de industrias culturales y sectores relacionados, junto con espacios de trabajo adaptados, lugares de reuni\u00f3n, talleres, seminarios y un gran espacio dedicado a actividades p\u00fablicas donde se organizan diversos eventos cada a\u00f1o: exhibiciones, desfiles de moda, representaciones art\u00edsticas\u2026\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"MAD \u2013 Home of Creators","address_street_name":"Place du Nouveau March\u00e9 aux Grains","address_street_number":"10","address_street_box":null,"email":"contact@mad.brussels","website":"http:\/\/www.mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":"+32 2 880 85 62","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place du Nouveau March\u00e9 aux Grains, 10","address_line2":"1000 Bruxelles","description_web":"","description_print":"","