","oEmbed_type":"video","oEmbed_height":200,"oEmbed_width":356,"oEmbed_version":"1.0","oEmbed_provider_name":"YouTube","oEmbed_provider_url":"https:\/\/www.youtube.com\/","oEmbed_thumbnail_height":360,"oEmbed_thumbnail_width":480,"oEmbed_thumbnail_url":"https:\/\/i.ytimg.com\/vi\/VHGK9fhlJJU\/hqdefault.jpg","oEmbed_html":"<iframe width=\"356\" height=\"200\" src=\"https:\/\/www.youtube.com\/embed\/VHGK9fhlJJU?feature=oembed\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" allowfullscreen><\/iframe>","translations":{"fr":{"title":"Visite Bruxelles, Grand-Place, maison de l'Etoile ... myst\u00e9rieuse !"},"nl":{"title":"Visite Bruxelles, Grand-Place, maison de l'Etoile ... myst\u00e9rieuse !"},"en":{"title":"Visite Bruxelles, Grand-Place, maison de l'Etoile ... myst\u00e9rieuse !"}}},{"type":"poster","link":"https:\/\/agendabrussels.imgix.net\/2dd6709ebce4fd489253833edb3fd5bfea127834.jpg","width":1080,"height":1920,"ratio":0.56,"translations":{"fr":{"title":"La Grand-Place de Bruxelles pour tout public","copyright":null},"nl":{"title":"La Grand-Place de Bruxelles pour tout public","copyright":null},"en":{"title":"La Grand-Place de Bruxelles pour tout public","copyright":null}}},{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/42168541d0f3898624bd2d00f8baa1f4563c5c1c.jpg","width":1441,"height":1080,"ratio":1.33,"translations":{"fr":{"title":"La Grand-Place de Bruxelles pour tout public","copyright":null},"nl":{"title":"La Grand-Place de Bruxelles pour tout public","copyright":null},"en":{"title":"La Grand-Place de Bruxelles pour tout public","copyright":null}}}],"dates":[{"day":"2022-05-22","doors":null,"start":"13:00:00","end":"14:30:00","is_soldout":false,"is_canceled":false},{"day":"2022-07-03","doors":null,"start":"13:00:00","end":"14:30:00","is_soldout":false,"is_canceled":false},{"day":"2022-08-28","doors":null,"start":"13:00:00","end":"14:30:00","is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":18}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":["exterior"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-07-18T17:05:13+02:00","published_at":"2022-03-03T11:57:25+01:00","backoffice_id":248907,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.23112042478354},{"id":538380,"date_start":"2022-07-01","date_end":"2022-08-31","date_next":"2022-08-31","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{"list":[255],"translations":{"fr":["Visites d'expositions"],"nl":["Tentoonstelling"],"en":["Exhibition guided tours"]}}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Viens t'a(mus\u00e9e) pendant les grandes vacances. Escale au Mus\u00e9e de l'Arm\u00e9e!","shortdescr":"Voil\u00e0 l'\u00e9t\u00e9, la p\u00e9riode des vacances bien m\u00e9rit\u00e9es. Pas besoin de partir tr\u00e8s loin pour s'offrir un peu de d\u00e9paysement. Le Mus\u00e9e de l'Arm\u00e9e et ses collections internationales feront voyager petits et grands autour du monde.","longdescr":"Pas besoin de lourdes valises, notre nouveau livret de jeu (distribu\u00e9 gratuitement au comptoir d'accueil) et un crayon suffisent pour cette aventure \u00e0 travers 10 si\u00e8cle d'histoire.\r\nEmbarquement imm\u00e9diat !\r\n\r\nDisponible en FR et en NL\r\n\r\nLe parcours fait appel \u00e0 la lecture et \u00e0 l'\u00e9criture mais les parents peuvent apporter un peu d'aide aux plus jeunes. Le parcours est aussi un chouette moyen de d\u00e9couvrir le mus\u00e9e pour les adolescents et les adultes.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.warheritage.be","email":"info@warheritage.be","phone_contact":null,"phone_booking":"+32 2 737 78 33","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/538380.html"},"nl":{"name":"Kom je amuse(ume)ren tijdens de grote vakantie! Op reis in het Legermuseum!","shortdescr":"De zomer is er eindelijk, met een welverdiende grote vakantie. En je hoeft niet ver te gaan om je toch op reis in het buitenland te voelen! Het Legermuseum en zijn internationale collecties laten groot en klein op reis gaan over heel de wereld.","longdescr":"Je hebt geen zware valiezen nodig, enkel ons nieuwe spelletjesboekje (gratis te verkrijgen aan onze onthaaldesk) en een potlood volstaan voor dit avontuur door tien eeuwen geschiedenis. Iedereen aan boord!\r\n\r\nBeschikbaar in NL en FR\r\n\r\nTijdens het parcours worden kinderen uitgenodigd om te lezen en te schrijven, maar ouders kunnen hier gerust even bij helpen indien nodig. Het parcours laat volwassenen bovendien toe om het museum en zijn uitgebreide zalen en collecties te ontdekken op een speelse manier!","performers":null,"boxoffice_url":null,"website":"http:\/\/www.warheritage.be","email":"info@warheritage.be","phone_contact":null,"phone_booking":"+32 2 737 78 33","agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/538380.html"},"en":{"name":"Come and have some fun during the summer hols. Stopover at the Royal Military Museum!","shortdescr":"Here comes summer, with its well-deserved holiday period. No need to travel far and wide to make a break. The Royal Military Museum and its international collections take both young and old on a trip around the world.","longdescr":"Don\u2019t pack heavy suitcases: our booklet (distributed free of charge at the reception desk) and a pencil are all you need for this adventure through 10 centuries of history. \r\nThe gate is open for boarding! \r\n \r\nAvailable in French and Dutch. \r\n\r\nThe trail requires reading and writing skills but the parents can help the little ones. The trail also provides both teenagers and adults with a unique opportunity of discovering the Museum\u2019s riches.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.warheritage.be","email":"info@warheritage.be","phone_contact":null,"phone_booking":"+32 2 737 78 33","agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/538380.html"},"de":{"name":"Viens t'a(mus\u00e9e) pendant les grandes vacances. Escale au Mus\u00e9e de l'Arm\u00e9e!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/538380.html"},"it":{"name":"Viens t'a(mus\u00e9e) pendant les grandes vacances. Escale au Mus\u00e9e de l'Arm\u00e9e!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/538380.html"},"sp":{"name":"Viens t'a(mus\u00e9e) pendant les grandes vacances. Escale au Mus\u00e9e de l'Arm\u00e9e!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/538380.html"},"pt":{"name":"Viens t'a(mus\u00e9e) pendant les grandes vacances. Escale au Mus\u00e9e de l'Arm\u00e9e!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/538380.html"},"cn":{"name":"Viens t'a(mus\u00e9e) pendant les grandes vacances. Escale au Mus\u00e9e de l'Arm\u00e9e!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/538380.html"}},"place":{"id":555,"translations":{"fr":{"name":"War Heritage Institute (Mus\u00e9e Royal de l\u2019Arm\u00e9e)","address_street_name":"Parc du Cinquantenaire","address_street_number":"3","address_street_box":null,"email":"info@warheritage.be","website":"http:\/\/www.warheritage.be","phone_contact":"+32 2 737 78 33","phone_booking":"+32 2 737 78 33","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 3","address_line2":"1000 Bruxelles","description_web":"Plus de dix si\u00e8cles d\u2019histoire et de techniques militaires sont pass\u00e9s en revue dans ce mus\u00e9e. On y trouve toute la panoplie de guerre, du Moyen \u00c2ge \u00e0 l\u2019\u00e9poque contemporaine: armures m\u00e9di\u00e9vales, armes \u00e0 feu, avions, blind\u00e9s contemporains, uniformes et coiffures militaires\u2026\r\n\r\nDepuis le 1er mai 2017, le Mus\u00e9e royal de l\u2019Arm\u00e9e appartient au War Heritage Institute, la nouvelle institution de r\u00e9f\u00e9rence pour le patrimoine militaire et la m\u00e9moire en Belgique. \r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"War Heritage Institute (Koninklijk Legermuseum)","address_street_name":"Jubelpark","address_street_number":"3","address_street_box":null,"email":"info@warheritage.be","website":"http:\/\/www.warheritage.be","phone_contact":"+32 2 737 78 33","phone_booking":"+32 2 737 78 33","address_zip":"1000","address_city":"Brussel","address_line1":"Jubelpark, 3","address_line2":"1000 Brussel","description_web":"Meer dan tien eeuwen militaire geschiedenis passeren de revue in dit museum. Je krijgt er een overzicht van de ingrijpende veranderingen die door de jaren heen hebben plaatsgegrepen op het gebied van bewapening en militaire technologie, van de middeleeuwen tot op heden: wapens, harnassen, pantsers, vliegtuigen, uniformen, \u2026\r\n\r\nSinds 1 mei 2017 is het Koninklijk Legermuseum onderdeel van het War Heritage Institute, de nieuwe instelling voor militair erfgoed en herinnering in Belgi\u00eb. \r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"War Heritage Institute (Royal Military Museum)","address_street_name":"Parc du Cinquantenaire","address_street_number":"3","address_street_box":null,"email":"info@warheritage.be","website":"http:\/\/www.warheritage.be","phone_contact":"+32 2 737 78 33","phone_booking":"+32 2 737 78 33","address_zip":"1000","address_city":"Brussels","address_line1":"Parc du Cinquantenaire, 3","address_line2":"1000 Brussels","description_web":"Here you\u2019ll find medieval armour and souvenirs from the Napoleonic campaigns, as well as a hundred or so aircraft and armoured vehicles from the two Great Wars. A breathtaking panoramic view awaits you at the top of the Arcade.\r\n\r\nSince May 1, 2017 the Royal Military Museum is part of the War Heritage Institute, the new reference institution for military heritage and remembrance in Belgium. \r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Mus\u00e9e Royal de l\u2019Arm\u00e9e (War Heritage Institute)","address_street_name":"Parc du Cinquantenaire","address_street_number":"3","address_street_box":null,"email":"info@warheritage.be","website":"http:\/\/www.warheritage.be","phone_contact":"+32 2 737 78 33","phone_booking":"+32 2 737 78 33","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 3","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Mus\u00e9e Royal de l\u2019Arm\u00e9e (War Heritage Institute)","address_street_name":"Parc du Cinquantenaire","address_street_number":"3","address_street_box":null,"email":"info@warheritage.be","website":"http:\/\/www.warheritage.be","phone_contact":"+32 2 737 78 33","phone_booking":"+32 2 737 78 33","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 3","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Museo Real de la Armada e Historia militar (War Heritage Institute)","address_street_name":"Parc du Cinquantenaire","address_street_number":"3","address_street_box":null,"email":"info@warheritage.be","website":"http:\/\/www.warheritage.be","phone_contact":"+32 2 737 78 33","phone_booking":"+32 2 737 78 33","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 3","address_line2":"1000 Bruxelles","description_web":"El museo posee alrededor de 100.000 objetos(armas, uniformes, maquetas, documentos...), siendo as\u00ed unos de los museos militares m\u00e1s grandes del mundo. Encontrar\u00e1s: una secci\u00f3n de armas y armaduras de la Edad Media, una preciosa colecci\u00f3n del Imperio franc\u00e9s, la Armada belga desde 1831 a 1914 con vitrinas dedicadas al rey Leopoldo l y Leopoldo ll, el desarrollo de la tecnolog\u00eda armament\u00edstica(hacia la mitad del s.XX), la Primera y Segunda Guerra Mundial(uniformes, materiales fotos y documentos), veh\u00edculos armados y barcos de guerra. La secci\u00f3n \"a\u00e9rea\" del museo ofrece una gama completa de aviones, alrededor de 80 son expuestos.\u00a1Y no te pierdas nuestros juegos educativos para todas las \u00e9pocas!. \r\n\r\nLos centros de documentaci\u00f3n est\u00e1n abiertos al p\u00fablico.\r\n\r\nEspectacular vista panor\u00e1mica de la ciudad desde la galer\u00eda.\r\n\r\nLas exposiciones temporales pueden ser de varios temas.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Museu Real das For\u00e7as Armadas e da Hist\u00f3ria Militar","address_street_name":"Parc du Cinquantenaire","address_street_number":"3","address_street_box":null,"email":"info@warheritage.be","website":"http:\/\/www.warheritage.be","phone_contact":"+32 2 737 78 33","phone_booking":"+32 2 737 78 33","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 3","address_line2":"1000 Bruxelles","description_web":"Mais de dez s\u00e9culos de hist\u00f3ria e de t\u00e9cnicas militares passaram em revista por este museu. A\u00ed encontramos toda a pan\u00f3plia de guerra, da Idade M\u00e9dia \u00e0 \u00e9poca contempor\u00e2nea: armaduras medievais, armas de fogo, avi\u00f5es, carros blindados contempor\u00e2neos, uniformes e penteados militares\u2026\r\nDesde 1 de maio de 2017, o Museu Real das For\u00e7as Armadas e da Hist\u00f3ria Militar pertence ao War Heritage Institute, a nova institui\u00e7\u00e3o de refer\u00eancia para o patrim\u00f3nio militar e a mem\u00f3ria na B\u00e9lgica.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Mus\u00e9e Royal de l\u2019Arm\u00e9e (War Heritage Institute)","address_street_name":"Parc du Cinquantenaire","address_street_number":"3","address_street_box":null,"email":"info@warheritage.be","website":"http:\/\/www.warheritage.be","phone_contact":"+32 2 737 78 33","phone_booking":"+32 2 737 78 33","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 3","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[9],"translations":{"fr":["Quartier europ\u00e9en"],"nl":["Europese wijk"],"en":["European Quarter"]}},"zones":{"list":[22],"translations":{"fr":["Est"],"nl":["Oost"],"en":["East"]}},"neca":null,"facebook_id":null,"backoffice_id":127,"location":{"lat":50.84086428,"lon":4.39335612},"region":"brussels","last_updated_at":"2022-07-18T01:08:15+02:00","published_at":"2013-10-19T01:13:18+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":