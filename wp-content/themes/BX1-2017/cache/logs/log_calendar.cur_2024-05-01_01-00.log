he sky blurs.","performers":"Diana Takacsova (*1992), a photographer from Slovakia living in Ostend, Belgium, will present her view of the Belgian coast of the North Sea. She mainly works on long-term, research-based projects. In her work, she explores themes related to identity, physical and emotional attachment to a place, migration, and the relationship of man to nature and the environment. (https:\/\/www.diatakacsova.com\/)","boxoffice_url":null,"website":null,"email":"cg.brussels@mzv.sk","phone_contact":"+32 488 33 10 21","phone_booking":"+32 488 33 10 21","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50009617"},"it":{"name":"Temporary views","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"cg.brussels@mzv.sk","phone_contact":"+32 488 33 10 21","phone_booking":"+32 488 33 10 21","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50009617"},"cn":{"name":"Temporary views","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"cg.brussels@mzv.sk","phone_contact":"+32 488 33 10 21","phone_booking":"+32 488 33 10 21","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50009617"},"fr":{"name":"Vues temporaires","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"cg.brussels@mzv.sk","phone_contact":"+32 488 33 10 21","phone_booking":"+32 488 33 10 21","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50009617"},"sp":{"name":"Temporary views","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"cg.brussels@mzv.sk","phone_contact":"+32 488 33 10 21","phone_booking":"+32 488 33 10 21","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50009617"},"nl":{"name":"Tijdelijke weergaven","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,