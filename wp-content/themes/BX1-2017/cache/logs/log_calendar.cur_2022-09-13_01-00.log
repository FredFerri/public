anking":0.12926263449024},{"id":537130,"date_start":"2022-07-08","date_end":"2023-03-05","date_next":"2022-10-02","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Kidorama : premier dimanche du mois","shortdescr":"Le Mus\u00e9e vous ouvre gratuitement ses portes chaque premier dimanche du mois.\r\n\r\nA 14h, notre guide vous emm\u00e8ne \u00e0 la d\u00e9couverte de l\u2019exposition Kidorama, 200 ans de mode enfantine.","longdescr":null,"performers":"Le Mus\u00e9e vous ouvre gratuitement ses portes chaque premier dimanche du mois.\r\nA 14h, notre guide vous emm\u00e8ne \u00e0 la d\u00e9couverte de l\u2019exposition Kidorama, 200 ans de mode enfantine.\r\nLa r\u00e9servation pour la visite guid\u00e9e est obligatoire via notre site web","boxoffice_url":null,"website":"http:\/\/www.museemodeetdentelle.brussels","email":"musea@brucity.be","phone_contact":null,"phone_booking":"+32 2 213 44 50","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.537130"},"nl":{"name":"Kidorama: eerste zondag van de maand","shortdescr":"Elke eerste zondag van de maand opent het museum gratis de deuren.","longdescr":null,"performers":"Elke eerste zondag van de maand opent het museum gratis de deuren.\r\nOm 15.30 uur neemt onze gids u mee voor een rondleiding door de tentoonstelling Kidorama, 200 jaar kindermode\r\nDe reservering voor de rondleiding is aanbevolen via ons website.","boxoffice_url":null,"website":"http:\/\/www.fashionandlacemuseum.brussels\/nl","email":"musea@brucity.be","phone_contact":null,"phone_booking":null,"ag