Enfants 0-3 ans","Enfants 3-6 ans","Famille"],"sp":["Ni\u00f1os de 0 a 3 a\u00f1os","Ni\u00f1os de 3 a 6 a\u00f1os","Familias"],"nl":["Kinderen 0-3 j.","Kinderen 3-6 j.","Familie"]}},"educational_targets":{"list":[],"translations":{}},"tags":["major_event","kids"]},{"id":50010174,"date_start":"2024-05-03","date_end":"2024-06-01","date_next":"2024-05-25","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-05-25T02:00:56+02:00","published_at":"2024-04-29T15:59:13+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":299209,"facebook_link":null,"import_origin":null,"is_part_of":"Brussels Pride","sub_type":"theatre","ranking":0.5848035476425733,"languages":{"spoken":["fr","nl"],"subtitles":[]},"categories":{"main":{"id":49,"translations":{"de":"Theater","pt":null,"en":"Theatre","it":"Teatro","cn":null,"fr":"Th\u00e9\u00e2tre","sp":"Teatro","nl":"Theater"}},"others":{"list":[50],"translations":{"de":["Theater"],"pt":[null],"en":["Theatre"],"it":["Teatro"],"cn":[null],"fr":["Th\u00e9\u00e2tre"],"sp":["Teatro"],"nl":["Theater"]}}},"translations":{"de":{"name":"CENDRILLON, CE MACHO ! LE REMIX - Brussels Pride Week 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.ttotheatre.com\/spectacle\/cendrillon-ce-macho\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50010174"},"pt":{"name":"CENDRILLON, CE MACHO ! LE REMIX - Brussels Pride Week 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.ttotheatre.com\/spectacle\/cendrillon-ce-macho\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50010174"},"en":{"name":"CENDRILLON, CE MACHO ! LE REMIX - Brussels Pride Week 2024","shortdescr":"Once again, it was a comedy ahead of its time. A comedy that rereads Perrault's fairy tale in an LGBTQIA+ way. Created 15 years ago, this comedy has become a TTO classic.","longdescr":"Once again, it was Cinderella, Ce Macho! a timeless show with a text rewritten for this 3.0 version. S\u00e9bastien Ministru's score has been polished and refurbished, Nathalie Uffner's direction meticulously revamped and the cast revamped from top to bottom!\n\nOnce upon a time, the story of Cinderella, a beautiful boy from the bottom rung of the ladder who - one evening at a ball - falls for the heir to the crown. The arrows fired by S\u00e9bastien Ministru at the stereotypes of the fairy tale have not finished being amusingly political.\n\nFinally, once again there's an irresistible playlist, flashy costumes and festive choreography that will make you want to dance, miss the coach, and go home well, well after midnight.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.ttotheatre.com\/spectacle\/cendrillon-ce-macho\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50010174"},"it":{"name":"CENDRILLON, CE MACHO ! LE REMIX - Brussels Pride Week 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.ttotheatre.com\/spectacle\/cendrillon-ce-macho\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50010174"},"cn":{"name":"CENDRILLON, CE MACHO ! LE REMIX - Brussels Pride Week 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.ttotheatre.com\/spectacle\/cendrillon-ce-macho\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50010174"},"fr":{"name":"CENDRILLON, CE MACHO ! LE REMIX - Brussels Pride Week 2024","shortdescr":"Il \u00e9tait une toute nouvelle fois une com\u00e9die en avance sur son \u00e9poque. Une com\u00e9die qui relit le conte de Perrault fa\u00e7on LGBTQIA+. Cr\u00e9\u00e9e il y a 15 ans, une com\u00e9die devenue un classique du TTO.","longdescr":"Il \u00e9tait une toute nouvelle fois Cendrillon, Ce Macho !, spectacle ind\u00e9modable port\u00e9 par un texte r\u00e9\u00e9crit \u00e0 l\u2019occasion de cette version 3.0. La partition de S\u00e9bastien Ministru est ripolin\u00e9e et remise \u00e0 neuf, la mise en sc\u00e8ne de Nathalie Uffner minutieusement relustr\u00e9e et le casting r\u00e9nov\u00e9 de la cave au grenier !\n\nIl sera toujours une fois l\u2019histoire de Cendrillon, beau gar\u00e7on du bas de l\u2019\u00e9chelle qui \u2013 un soir de bal \u2013 succombe \u00e0 l\u2019h\u00e9ritier de la couronne. Les fl\u00e8ches d\u00e9coch\u00e9es par S\u00e9bastien Ministru contre les st\u00e9r\u00e9otypes du conte de f\u00e9e n\u2019ont pas fini d\u2019\u00eatre dr\u00f4lement politiques.\n\nIl est enfin une toute nouvelle fois une playlist irr\u00e9sistible, des costumes flashy et des chor\u00e9graphies festives qui vous donneront envie de danser, de rater le carrosse, et de rentrer bien, bien apr\u00e8s minuit.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.ttotheatre.com\/spectacle\/cendrillon-ce-macho\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50010174"},"sp":{"name":"CENDRILLON, CE MACHO ! LE REMIX - Brussels Pride Week 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.ttotheatre.com\/spectacle\/cendrillon-ce-macho\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50010174"},"nl":{"name":"CENDRILLON, CE MACHO ! LE REMIX - Brussels Pride Week 2024","shortdescr":"Het was opnieuw een komedie die zijn tijd ver vooruit was. Een komedie die het sprookje van Perrault herleest op een LGBTQIA+ manier. Deze komedie werd 15 jaar geleden gemaakt en is een TTO-klassieker geworden.","longdescr":" Cendrillon, Ce Macho! een tijdloze voorstelling met een voor deze 3.0 versie herschreven tekst. De partituur van S\u00e9bastien Ministru is opgepoetst en opgefrist, de regie van Nathalie Uffner is minutieus vernieuwd en de cast is van top tot teen vernieuwd!\n\nEr was eens, het verhaal van Assepoester, een mooie jongen van de onderste sport van de ladder die - op een avond op een bal - valt voor de erfgenaam van de kroon. De pijlen die S\u00e9bastien Ministru afvuurt op de stereotypen van het sprookje zijn nog niet klaar met amusant politiek.\n\nTot slot is er opnieuw een onweerstaanbare afspeellijst, flitsende kostuums en feestelijke choreografie die ervoor zorgen dat je zin krijgt om te dansen, de koets te missen en ruim na middernacht naar huis te gaan.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.ttotheatre.com\/spectacle\/cendrillon-ce-macho\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50010174"}},"place":{"last_updated_at":"2023-10-25T09:28:08+02:00","published_at":"2013-10-19T01:13:46+02:00","id":227607,"translations":{"de":{"name":"TTO - Th\u00e9\u00e2tre de la Toison d'Or","address_street_name":"Galerie de la Toison d'Or","address_street_number":"396","address_street_box":null,"email":"info@ttotheatre.be","website":"http:\/\/www.ttotheatre.be","phone_contact":"+32 2 510 05 10","phone_booking":"+32 2 510 05 10","address_zip":"1050","address_city":"Ixelles","address_line1":"Galerie de la Toison d'Or, 396","address_line2":"1050 Ixelles","description_web":