ids en liefhebber, biedt leuke en onderhoudende workshops aan die de deelnemers een beter inzicht geven in de wereld van het brouwen. \r\n\r\nBezoeken en proeverijen op reservering.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[22],"translations":{"de":["Osten"],"pt":[null],"en":["East"],"it":["Est"],"cn":[null],"fr":["Est"],"sp":["Este"],"nl":["Oost"]}},"neca":null,"facebook_id":null,"backoffice_id":39485,"location":{"lat":50.82550329,"lon":4.39868042},"region":"brussels","last_updated_at":"2023-09-14T10:45:37+02:00","published_at":"2022-10-07T14:08:56+02:00","import_origin":null,"external_id":null,"is_in_address_book":false,"is_in_vb_export":false,"resto_ranking":0},"organizer":{"id":279485,"translations":{"de":{"name":"CoHop","address_street_name":"Chauss\u00e9e de wavre","address_street_number":"950","address_street_box":null,"email":"gestion@cohop.be","website":"https:\/\/cohop.be\/","phone_contact":"+32 2 742 02 26","phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Chauss\u00e9e de wavre, 950","address_line2":"1040 Etterbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"CoHop","address_street_name":"Chauss\u00e9e de wavre","address_street_number":"950","address_street_box":null,"email":"gestion@cohop.be","website":"https:\/\/cohop.be\/","phone_contact":"+32 2 742 02 26","phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Chauss\u00e9e de wavre, 950","address_line2":"1040 Etterbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"CoHop","address_street_name":"Chauss\u00e9e de wavre","address_street_number":"950","address_street_box":null,"email":"gestion@cohop.be","website":"https:\/\/cohop.be\/","p