,"accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":84,"translations":{"fr":"Divers","nl":"Varia","en":"Various","de":"Verschiedenes","it":"Varie","sp":"Varios","pt":null,"cn":null}},"others":{"list":[89],"translations":{"fr":["Litt\u00e9rature"],"nl":["Literatuur"],"en":["Litterature "],"de":["Literatur"],"it":["Letteratura"],"sp":["Literatura"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Rencontre litt\u00e9raire avec Fatiha Sa\u00efdi","shortdescr":"Psychop\u00e9dagogue de formation, femme politique belge (d\u00e9put\u00e9e bruxelloise, s\u00e9natrice, \u00e9chevine de 1999 \u00e0 2018), issue de la diversit\u00e9, Fatiha Sa\u00efdi vit en Belgique depuis l\u2019\u00e2ge de cinq ans. Militante associative, elle se mobilise autour de la d\u00e9fense des droits humains et plus particuli\u00e8rement ceux des femmes.","longdescr":"Psychop\u00e9dagogue de formation, femme politique belge (d\u00e9put\u00e9e bruxelloise, s\u00e9natrice, \u00e9chevine de 1999 \u00e0 2018), issue de la diversit\u00e9, Fatiha Sa\u00efdi vit en Belgique depuis l\u2019\u00e2ge de cinq ans. Militante associative, elle se mobilise autour de la d\u00e9fense des droits humains et plus particuli\u00e8rement ceux des femmes. Son livre \u201cLes fourmis pr\u00e9datrices\u201d a \u00e9t\u00e9 publi\u00e9 en d\u00e9cembre 2017 aux \u00e9ditions Bouregreg (Maroc). Elle a \u00e9galement \u00e9crit \u201c\u00c9chos de la m\u00e9moire sur les montagnes du Rif (La Crois\u00e9e des Chemins)\u201d et \u201cPar les liens forc\u00e9s du mariage\u201d (La Bo\u00eete \u00e0 Pandore, 2019). La rencontre sera\r\nanim\u00e9e par V\u00e9ronique Thyberghien, journaliste sur La Premi\u00e8re.\r\n\r\n\r\nLes \u00e9v\u00e8nements auront lieu \u00e0 l\u2018Espace Car\u00eame 1-7 rue du Chapelain, 1070 Anderlecht.\r\n\r\nParticipation gratuite, mais r\u00e9servation indispensable \u00e0 l\u2019accueil de l\u2019Espace Car\u00eame durant les heures d\u2019ouverture T\u00e9l 02\/526.83.30-40. Ou par mail emca.reservations@anderlecht.brussels\r\n\r\nA l\u2019initiative de Fabrice Cumps, Bourgmestre et Echevin de la culture, \u00e0 l\u2019initiative de J\u00e9r\u00e9mie Drouart, \u00c9chevin de l\u2019\u00c9galit\u00e9 des Chances et avec le soutien du Coll\u00e8ge Echevinal d\u2019Anderlecht, de la F\u00e9d\u00e9ration Wallonie-Bruxelles \u2014Direction G\u00e9n\u00e9rale de la Culture- Service G\u00e9n\u00e9ral des Lettres et du Livre et de la Commission Communautaire Fran\u00e7aise de la R\u00e9gion de Bruxelles-Capitale. E.R. : Marcel Vermeulen","performers":"Fatiha Saidi (Autrice et femme politique belge de 1999 \u00e0 2018)\r\nV\u00e9ronique Thyberghien (RTBF La Premi\u00e8re)","boxoffice_url":null,"website":"https:\/\/www.emca.be\/noustoutes","email":"emca.reservations@anderlecht.brussels","phone_contact":"+32 2 526 83 30","phone_booking":"+32 2 526 83 30","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.552729"},"nl":{"name":"Rencontre litt\u00e9raire avec Fatiha Sa\u00efdi","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.emca.be\/noustoutes","email":"emca.reservations@anderlecht.brussels","phone_contact":"+32 2 526 83 40","phone_booking":"+32 2 526 83 40","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.552729"},"en":{"name":"Rencontre litt\u00e9raire avec Fatiha Sa\u00efdi","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.emca.be\/noustoutes","email":"emca.reservations@anderlecht.brussels","phone_contact":"+32 2 526 83 30","phone_booking":"+32 2 526 83 30","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-