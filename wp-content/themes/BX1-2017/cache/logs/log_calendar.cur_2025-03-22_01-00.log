ll,"email":"info@explore.brussels","website":"https:\/\/www.explore.brussels\/fr","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Ukkel","address_line1":"Brugmannlaan, 405","address_line2":"1180 Ukkel","description_web":"Explore.Brussels is een netwerk van verenigingen voor geleide bezoeken in Brussel. Deze organisatie omvat ARAU, Arkadia, Bruxelles Bavard, Pro Velo, La Fonderie en Korei. De evenementen worden georganiseerd in coproductie met deze 6 bedrijven. Individuele of groepstochten zijn mogelijk te voet, per fiets, per bus en per boot.  Bezoekers ontdekken UNESCO erfgoed, Magritte, art deco, chocolade en nog veel meer. Explore.Brussels organiseert ook Brusselse festivals en andere grootschalige projecten.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":27246,"location":{"lat":50.80795462,"lon":4.34397082},"last_updated_at":"2024-05-29T15:24:29+02:00","published_at":"2017-02-27T10:05:49+01:00","is_in_address_book":false,"is_in_vb_export":false,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/a58e0375db79eb4a115ed54d27b0a341647d7f4a.jpg","width":1332,"height":1000,"ratio":1.33,"oEmbed_height":1000,"oEmbed_width":1332,"translations":{"de":{"title":"H\u00f4tel van Eetvelde","copyright":"\u00a9EB- Luc Viatour"},"pt":{"title":"H\u00f4tel van Eetvelde","copyright":"\u00a9EB- Luc Viatour"},"en":{"title":"H\u00f4tel van Eetvelde","copyright":"\u00a9EB- Luc Viatour"},"it":{"title":"H\u00f4tel van Eetvelde","copyright":"\u00a9EB- Luc Viatour"},"cn":{"title":"H\u00f4tel van Eetvelde","copyright":"\u00a9EB- Luc Viatour"},"fr":{"title":"H\u00f4tel van Eetvelde","copyright":"\u00a9EB- Luc Viatour"},"sp":{"title":"H\u00f4tel van Eetvelde","copyright":"\u00a9EB- Luc Viatour"},"nl":{"title":"H\u00f4tel van Eetvelde","copyright":"\u00a9