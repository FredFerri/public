false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":["exterior"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-02-28T16:05:03+01:00","published_at":"2022-02-28T15:56:34+01:00","backoffice_id":248527,"import_origin":null,"sub_type":"misc","show_in_agenda":true,"ranking":1},{"id":530277,"date_start":"2022-05-27","date_end":"2022-05-27","date_next":"2022-05-27","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre"}},"others":{"list":[54],"translations":{"fr":["One man Show et humour"],"nl":["Onemanshow en humor"],"en":["One man show and comedy"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Dave Parcoeur - Bouffon et Roi","shortdescr":"Dans une autre vie, il est entrepreneur dans diff\u00e9rents domaines, chaque journ\u00e9e est une aventure diff\u00e9rente. Du coup, il utilise ce qu\u2019il vit au quotidien pour alimenter ses sketchs.","longdescr":"Dans une autre vie, il est entrepreneur dans diff\u00e9rents domaines, chaque journ\u00e9e est une aventure diff\u00e9rente. Du coup, il utilise ce qu\u2019il vit au quotidien pour alimenter ses sketchs. Il est originaire du brabant-wallon, il habite \u00e0 Schaerbeek et a travaill\u00e9 en Flandre. Il s\u2019identifie comme un \u00ab vrai belge \u00bb et rencontre une panoplie de personnages qui se retrouvent sur sc\u00e8ne en plus du stand-up qu\u2019il pratique volontiers.\r\nPalmar\u00e8s :\r\nGrand prix du Festival de Remicourt 2016\r\nPrix du public Festival du rire de Remicourt 2016\r\nPremi\u00e8re partie de Pascal L\u00e9gitimus en avril 2016 au Centre Culturel d\u2019Arlon\r\nS\u00e9lectionn\u00e9 comme \u00abPoulain du Rire \u00bb \u2013 Festival du Rire de Rochefort en 2017, premi\u00e8re partie d\u2019Issa\r\nDoumbia et d\u2019Olivier de Benoist.\r\nFinaliste \u00e0 la sc\u00e8ne ouverte du Voo Rire (octobre 2017)\r\nFinaliste du festival du Rire (29 mars 2017) de Bastogne en avant-premi\u00e8re de Jarry.\r\nChroniqueur sur Pure FM dans l\u2019\u00e9mission hebdomadaire \u00ab Caf\u00e9 Comedy \u00bb \u2013 saison 2015-2016.","performers":"Dave Parcoeur","boxoffice_url":null,"website":"http:\/\/www.lepetitchapeaurondrouge.be","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/530277.html"},"nl":{"name":"Dave Parcoeur - Bouffon et Roi","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/530277.html"},"en":{"name":"Dave Parcoeur - Bouffon et Roi","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/530277.html"},"de":{"name":"Dave Parcoeur - Bouffon et Roi","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/530277.html"},"it":{"name":"Dave Parcoeur - Bouffon et Roi","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/530277.html"},"sp":{"name":"Dave Parcoeur - Bouffon et Roi","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/530277.html