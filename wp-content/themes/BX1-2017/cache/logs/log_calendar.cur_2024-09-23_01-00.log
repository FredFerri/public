ngdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/whalll.be\/evenement\/nach\/","email":"billetterie@whalll.be","phone_contact":"+32 2 435 59 99","phone_booking":"+32 2 435 59 99","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50007267"},"en":{"name":"Nach","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/whalll.be\/evenement\/nach\/","email":"billetterie@whalll.be","phone_contact":"+32 2 435 59 99","phone_booking":"+32 2 435 59 99","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50007267"},"it":{"name":"Nach","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/whalll.be\/evenement\/nach\/","email":"billetterie@whalll.be","phone_contact":"+32 2 435 59 99","phone_booking":"+32 2 435 59 99","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50007267"},"cn":{"name":"Nach","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/whalll.be\/evenement\/nach\/","email":"billetterie@whalll.be","phone_contact":"+32 2 435 59 99","phone_booking":"+32 2 435 59 99","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50007267"},"fr":{"name":"Nach","shortdescr":" Faire Peau Neuve. Se r\u00e9inventer. Oser. Se lib\u00e9rer. Exister. Voila d\u00e9j\u00e0 deux ans que je travaille sur Peau Neuve ce nouvel album que j\u2019ai \u00e9crit, compos\u00e9, arrang\u00e9, r\u00e9alis\u00e9 et produit.","longdescr":"Peau neuve\n\u201c Faire Peau Neuve. Se r\u00e9inventer. Oser. Se lib\u00e9rer. Exister. Voila d\u00e9j\u00e0 deux ans que je travaille sur Peau Neuve ce nouvel album que j\u2019ai \u00e9crit, compos\u00e9, arrang\u00e9, r\u00e9alis\u00e9 et produit.\n\nApr\u00e8s 3 albums dans une tr\u00e8s belle maison de disque, j\u2019ai d\u00e9cid\u00e9 de monter mon propre label Anna Chedid Publishing afin de me sentir la plus libre et cr\u00e9ative possible.\n\nCette autonomisation m\u2019a permis d\u2019aller au bout de ma vision artistique et de d\u00e9cliner l\u2019histoire de Peau Neuve sous plusieurs formes.\n\nPeau Neuve c\u2019est un album mais aussi un film musical, un livre et un spectacle.\n\nL\u2019aventure Peau Neuve me demande un investissement total, un engagement artistique, \u00e9motionnel, physique, cr\u00e9atif et intellectuel sans pareil et je me sens totalement align\u00e9e avec cette nouvelle mani\u00e8re de cr\u00e9er et de faire exister ma musique.\n\nPeau Neuve est, \u00e0 ce jour, le projet artistique le plus ambitieux de toute ma carri\u00e8re.\u201d Nach (Anna Chedid)\n\nCe r\u00eave de toujours qu\u2019elle r\u00e9alise enfin, nous aurons la chance de le vivre un peu aussi avec elle le soir o\u00f9 se f\u00eate justement la Chanson fran\u00e7aise, le 27 septembre\u2026","performers":null,"boxoffice_url":null,"website":"https:\/\/whalll.be\/evenement\/nach\/","email":"billetterie@whalll.be","phone_contact":"+32 2 435 59 99","phone_booking":"+32 2 435 59 99","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50007267"},"sp":{"name":"Nach","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/whalll.be\/evenement\/nach\/","email":"billetterie@whalll.be","phone_contact":"+32 2 435 59 99","phone_booking":"+32 2 435 59 99","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50007267"},"nl":{"name":"Nach","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/whalll.be\/evenement\/nach\/","email":"billetterie@whalll.be","phone_contact":"+32 2 435 59 99","phone_booking":"+32 2 435 59 99","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50007267"}},"place":{"last_updated_at":"2024-02-08T10:02:54+01:00","published_at":"2013-10-19T01:16:38+02:00","id":241270,"translations":{"de":{"name":"W:Halll - Centre culturel de Woluwe-Saint-Pierre