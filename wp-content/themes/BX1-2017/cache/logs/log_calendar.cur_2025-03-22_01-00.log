,{"id":5700006456,"date_start":"2025-03-29","date_end":"2025-03-30","date_next":"2025-03-29","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2025-02-10T16:07:07+01:00","published_at":"2025-02-10T14:37:40+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":317983,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"tour","ranking":1,"languages":{"spoken":["nl","en","fr"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{"list":[253],"translations":{"de":["F\u00fchrungen durch Innenr\u00e4ume"],"pt":[null],"en":["Interior guided tours"],"it":["Visite guidate all\u2019interno"],"cn":[null],"fr":["Visites guid\u00e9es d\u2019int\u00e9rieurs"],"sp":["Visitas guiadas en espacios interiores"],"nl":["Interieur rondleidingen"]}}},"translations":{"de":{"name":"BANAD Festival - Guided tour of the Cauchie House","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700006456"},"pt":{"name":"BANAD Festival - Guided tour of the Cauchie House","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700006456"},"en":{"name":"BANAD Festival - Cauchie House","shortdescr":null,"longdescr":"This house and studio, designed and built by Paul Cauchie for himself, is one of the most unusual Art Nouveau buildings in Brussels. Almost all the facade and some of the interior walls are covered in sgraffiti. Threatened with demolition, the house was listed in 1975. The restoration of the sgraffiti at a time when this technique had almost been forgotton served as a template for future restorations.\n\nArch. Paul CAUCHIE, 1904","performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/en\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700006456"},"it":{"name":"BANAD Festival - Guided tour of the Cauchie House","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700006456"},"cn":{"name":"BANAD Festival - Guided tour of the Cauchie House","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700006456"},"fr":{"name":"BANAD Festival - Maison Cauchie","shortdescr":null,"longdescr":"Cette maison-atelier construite en 1905 par et pour Paul Cauchie est une des \u0153uvres les plus originales de l'Art nouveau bruxellois. La quasi-totalit\u00e9 de la fa\u00e7ade et certains murs int\u00e9rieurs sont couverts de sgraffites. Menac\u00e9e de d\u00e9molition, la maison a \u00e9t\u00e9 class\u00e9e en 1975. La restauration des sgraffites, \u00e0 une \u00e9poque o\u00f9 l'on \u00e9tait plus gu\u00e8re familiaris\u00e9 avec cette technique, a constitu\u00e9 un mod\u00e8le.\n\nArch. Paul CAUCHIE, 1904","performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700006456"},"sp":{"name":"BANAD Festival - Guided tour of the Cauchie House","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700006456"},"nl":{"name":"BANAD Festival - Cauchiehuis","shortdescr":null,"longdescr":"Dit huis-atelier dat Paul Cauchie voor zichzelf bouwde, is een van de meest originele werken van de Brusselse art nouveau. Bijna de hele gevel en sommige binnenmuren zijn bekleed met sgraffito's. Het met afbraak bedreigde huis werd in 1975 geklasseerd. De restauratie van de sgraffito's, in een tijd waarin men amper nog met die techniek vertrouwd was, vormde een model.\n\nArch. Paul CAUCHIE, 1904","performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/nl\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700006456"}},"place":{"id":217690,"translations":{"de":{"name":"Maison Cauchie","address_street_name":"Rue des Francs","address_street_number":"5","address_street_box":null,"email":"info@cauchie.be","website":"http:\/\/www.cauchie.be","phone_contact":"+ 32 (0)473 64 26 97","phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Rue des Francs, 5","address_line2":"1040 Etterbeek","description_web":"Das Maison Cauchie kann mit Fug und Recht als eines der sch\u00f6nsten Beispiele des Br\u00fcsseler Jugendstils bezeichnet werden. Sowohl die prachtvollen Sgraffiti und Fassadenmalereien als auch die Architektur und das Interieur des Geb\u00e4udes sind absolut sehenswert. Besichtigungen sind nach Vereinbarung m\u00f6glich.\r\n\r\nPaul Cauchie und seine Frau Lina, die ersten Besitzer, verdienten ihren Lebensunterhalt als Dekorateure und Maler und fertigten anhand historischer Techniken pr\u00e4chtige Wandgem\u00e4lde und Sgrafitti an. Die meisten Br\u00fcsseler Beispiele dieser Kunstform stammen \u00fcbrigens aus der Feder dieses K\u00fcnstlerpaars. Und obwohl er eher Ambitionen als Dekorateur denn als Architekt hatte, war es Paul Cauchie pers\u00f6nlich, der sein 1905 fertiggestelltes Haus, entwarf.\r\n\r\nDie gesamte Fassade wurde prachtvoll mit Wandmalereien verziert und diente als Aush\u00e4ngeschild f\u00fcr das Unternehmen der beiden Dekorateure. Die Vorderseite des Hauses wird dabei durch drei T\u00fcren aufgeteilt: Die mittlere T\u00fcr f\u00fchrt hinab in die Kellerebene, die rechte T\u00fcr zum Hochparterre, w\u00e4hrend die dritte T\u00fcr nur dekorative Zwecke erf\u00fcllt. Auch das Interieur des Hauses wurde mit zahlreichen Sgraffiti geschm\u00fcckt. Dabei unterscheidet sich das Maison Cauchie von den Werken der Architekten Horta, Hankar, Bl\u00e9rot oder Strauven, die diese Epoche entscheidend gepr\u00e4gt haben. Die Formen dieses Bauwerks sind nicht, wie sonst in jener Epoche \u00fcblich, der Pflanzenwelt entlehnt, sondern orientieren sich strikt an der Geometrie.\r\n\r\nAls kleine Anekdote: Aufgrund der teils minderwertigen Baustoffe, die der damals noch mit bescheidenen finanziellen Mitteln ausgestattete Paul Cauchie verwenden musste, war das Bauwerk mit der Zeit bauf\u00e4llig geworden und war 1971 vom Abriss bedroht. Nur Proteste konnten dies verhindern. Seit 1975 steht das Maison Cauchie unter Denkmalschutz.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Maison Cauchie","address_street_name":"Rue des Francs","address_street_number":"5","address_street_box":null,"email":"info@cauchie.be","website":"http:\/\/www.cauchie.be","phone_contact":"+ 32 (0)473 64 26 97","phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Rue des Francs, 5","address_line2":"1040 Etterbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Cauchie House","address_street_name":"Frankenstraat","address_street_number":"5","address_street_box":null,"email":"info@cauchie.be","website":"http:\/\/www.cauchie.be","phone_contact":"+ 32 (0)473 64 26 97","phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Frankenstraat, 5","address_line2":"1040 Etterbeek","description_web":"The Cauchie House is one of the most exceptional Art Nouveau masterpieces in Brussels. Built in 1905, it was originally the home to Paul Cauchie and Caroline Voet, a couple of artists and decorators. The majestic sgraffito on the fa\u00e7ade and the opulent decorations of the bel-\u00e9tage served as a manifesto for their artistic skills. We invite you to join us for a guided tour to discover its history and unique artworks.\r\n\r\nOpen on the first weekend & the third Saturday of the month. \r\nIndividual guided tours, group guided tours, private and corporate events. \r\n","description_print":null,"booking_url":"http:\/\/ticket.visit.brussels\/en\/217690\/the-cauchie-house\/shop","sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Maison Cauchie","address_street_name":"Rue des Francs","address_street_number":"5","address_street_box":null,"email":"info@cauchie.be","website":"http:\/\/www.cauchie.be","phone_contact":"+ 32 (0)473 64 26 97","phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Rue des Francs, 5","address_line2":"1040 Etterbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Maison Cauchie","address_street_name":"Rue des Francs","address_street_number":"5","address_street_box":null,"email":"info@cauchie.be","website":"http:\/\/www.cauchie.be","phone_contact":"+ 32 (0)473 64 26 97","phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Rue des Francs, 5","address_line2":"1040 Etterbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Maison Cauchie","address_street_name":"Rue des Francs","address_street_number":"5","address_street_box":null,"email":"info@cauchie.be","website":"http:\/\/www.cauchie.be","phone_contact":"+ 32 (0)473 64 26 97","phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Rue des Francs, 5","address_line2":"1040 Etterbeek","description_web":"La Maison Cauchie, habitation personnelle et atelier du couple d\u2019artistes-d\u00e9corateurs form\u00e9 par Paul Cauchie et Caroline Voet, est un des joyaux de l\u2019Art nouveau bruxellois. Con\u00e7ue en 1905 comme un v\u00e9ritable manifeste de leur savoir-faire, au travers d'une impressionnante \u00ab fa\u00e7ade - affiche \u00bb orn\u00e9e de plusieurs panneaux de sgraffites et d'un bel \u00e9tage riche en propositions de d\u00e9coration int\u00e9rieure, cette maison vous ouvre ses portes pour vous partager son histoire et l'\u0153uvre de ses propri\u00e9taires. \r\n\r\nOuvert les premiers week-ends et le troisi\u00e8me samedi du mois.  Visites guid\u00e9es individuelles, visites guid\u00e9es de groupe, \u00e9v\u00e8nements priv\u00e9s et professionnels. \r\n","description_print":null,"booking_url":"http:\/\/ticket.visit.brussels\/fr\/217690\/la-maison-cauchie\/shop","sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"La casa Cauchie","address_street_name":"Rue des Francs","address_street_number":"5","address_street_box":null,"email":"info@cauchie.be","website":"http:\/\/www.cauchie.be","phone_contact":"+ 32 (0)473 64 26 97","phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Rue des Francs, 5","address_line2":"1040 Etterbeek","description_web":"Uno de los ejemplos m\u00e1s brillantes del Art Nouveau bruselense y, en concreto, del esgrafiado o pintura de fachada es la casa Cauchie. La fachada, la arquitectura y el interior de este edificio merecen sin duda alguna una visita. Es necesario reservar con antelaci\u00f3n.\r\n\r\nPaul Cauchie, el primer propietario, se dedicaba, junto con su mujer Lina, principalmente a la decoraci\u00f3n y a la pintura y, en concreto, a la creaci\u00f3n de estas pinturas murales basadas en una t\u00e9cnica ancestral. La mayor\u00eda de los ejemplos bruselenses son obra suya o de su mujer. Aunque fue m\u00e1s decorador que arquitecto, dise\u00f1\u00f3 su propia casa, que se termin\u00f3 en 1905.\r\n\r\nToda la fachada de la casa est\u00e1 ricamente decorada por estas pinturas puesto que... \u00a1serv\u00eda de publicidad para la empresa de esta pareja de decoradores! Adem\u00e1s, en la decoraci\u00f3n de su propia fechada Cauchie hizo alarde de su especialidad. La fachada del edificio est\u00e1 dividida por la presencia de tres puertas: la puerta central da acceso al nivel del s\u00f3tano, la de la derecha da acceso a la planta baja realzada, mientras que la tercera tiene una mera funci\u00f3n decorativa. El interior de la casa tambi\u00e9n est\u00e1 decorado con numerosos esgrafiados. \r\n\r\nPor \u00faltimo, destacamos que los materiales de construcci\u00f3n no siempre eran de buena calidad. El arquitecto, a sus 30 a\u00f1os, todav\u00eda no dispon\u00eda de medios suficientes. El edificio estuvo a punto de ser demolido en 1971 para albergar una nueva construcci\u00f3n. Finalmente, violentas protestas permitieron que el edificio fuese declarado edificio protegido en 1975. \r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Cauchiehuis","address_street_name":"Frankenstraat","address_street_number":"5","address_street_box":null,"email":"info@cauchie.be","website":"http:\/\/www.cauchie.be","phone_contact":"+ 32 (0)473 64 26 97","phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Frankenstraat, 5","address_line2":"1040 Etterbeek","description_web":"Het Cauchiehuis, het eigen woonhuis-atelier van het kunstenaarsduo Paul Cauchie en Caroline Voet, is een van de parels van de Brusselse Art Nouveau. Opgevat in 1905 als een visitekaartje van hun kunnen, met een indrukwekkende gevel-advertentie met meerdere sgraffito-panelen en een bel-etage vol decoratieve interieur-elementen, opent dit huis zijn deuren om zijn geschiedenis en het werk van zijn eigenaars met u te delen.\r\n\r\nElke maand open voor publiek, het eerste weekend en de derde zaterdag van de maand.\r\nBegeleide bezoeken, groepsbezoeken, private en professionele evenementen\r\n","description_print":null,"booking_url":"http:\/\/ticket.visit.brussels\/nl\/217690\/het-cauchiehuis\/shop","sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[9],"translations":{"de":["Europ\u00e4isches Viertel"],"pt":[null],"en":["European Quarter"],"it":["Quartiere europeo"],"cn":[null],"fr":["Quartier europ\u00e9en"],"sp":["Barrio Europeo"],"nl":["Europese wijk"]}},"zones":{"list":[22],"translations":{"de":["Osten"],"pt":[null],"en":["East"],"it":["Est"],"cn":[null],"fr":["Est"],"sp":["Este"],"nl":["Oost"]}},"neca":null,"facebook_id":null,"backoffice_id":550,"location":{"lat":50.8384019,"lon":4.3953583},"region":"brussels","last_updated_at":"2024-09-10T13:12:19+02:00","published_at":"2013-10-19T01:13:37+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":267246,"translations":{"de":{"name":"Explore.brussels ","address_street_name":"Avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"https:\/\/www.explore.brussels\/fr","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Avenue Brugmann, 405","address_line2":"1180 Uccle","description_web":"Explore.Brussels ist ein Zusammenschluss von Vereinen, die qualitativ hochwertige Stadtf\u00fchrungen in der Region Br\u00fcssel-Hauptstadt organisieren.\r\nDie Mitgliedsvereine sind ARAU, Pro Velo, Brussels Chatterguides und Arkadia. Im Jahr 2020 hat sich La Fonderie als Partnerverein angeschlossen.\r\nEntdecken Sie das UNESCO-Weltkulturerbe, Jugendstilarchitektur, die Bauwerke von Victoria Horta, Gem\u00e4lde von Magritte, Comic-Kunst von Herg\u00e9, Streetart, Europa, Bier, Schokolade oder besichtigen Sie architektonische Perlen des Jugendstils, des Art-d\u00e9co oder des Neoklassizismus, die normalerweise nicht f\u00fcr die \u00d6ffentlichkeit zug\u00e4nglich sind. Die F\u00fchrungen werden sowohl f\u00fcr Einzelbesucher als auch f\u00fcr Gruppen angeboten und reichen von klassischen \u00fcber originelle bis hin zu vollkommen neuen Konzepten und Formaten. Neben Stadtf\u00fchrungen zu Fu\u00df sind auch Besichtigungen per Fahrrad, Bus oder Boot m\u00f6glich.\r\nExplore.Brussels organisiert unter anderem auch das Jugendstil- und Art-d\u00e9co-Festival BANAD, die Brussels Biennale - Neoclassic (BBN) sowie weitere Projekte, darunter die Ausbildung von Stadtf\u00fchrern, der \u201eVerein der Freunde\u201c und der \u201eVerein der Eigent\u00fcmer\u201c. \r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Explore.brussels ","address_street_name":"Avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"https:\/\/www.explore.brussels\/fr","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Avenue Brugmann, 405","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Explore.brussels ","address_street_name":"Avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"https:\/\/www.explore.brussels\/fr","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Avenue Brugmann, 405","address_line2":"1180 Uccle","description_web":"Explore.Brussels is a network of guided tour associations in Brussels. This organisation includes ARAU, Arkadia, Bruxelles Bavard, Pro Velo, La Fonderie and Korei. Events are organised in co-production with these 6 companies. Individual or group tours are available on foot, by bike, by bus and by boat.  Visitors discover UNESCO heritage, Magritte, art deco, chocolate and much more. Explore.Brussels also organises Brussels festivals and other large-scale projects.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Explore.brussels ","address_street_name":"Avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"https:\/\/www.explore.brussels\/fr","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Avenue Brugmann, 405","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Explore.brussels ","address_street_name":"Avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"https:\/\/www.explore.brussels\/fr","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Avenue Brugmann, 405","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Explore.brussels ","address_street_name":"Avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"https:\/\/www.explore.brussels\/fr","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Avenue Brugmann, 405","address_line2":"1180 Uccle","description_web":"Explore.Brussels est un r\u00e9seau d'associations de visites guid\u00e9es \u00e0 Bruxelles. Cet organisme regroupe notamment ARAU, Arkadia, Bruxelles Bavard, Pro Velo, La Fonderie et Korei. les \u00e9v\u00e9nements sont organis\u00e9s en coproduction avec ces 6 entreprises  Les visites individuelles ou en groupe sont disponibles \u00e0 pied, \u00e0 v\u00e9lo, en car et en bateau.  Les visiteurs partent \u00e0 la d\u00e9couverte du patrimoine de l'UNESCO, de Magritte, de l'art d\u00e9co, du chocolat et bien plus encore. Explore.Brussels organise \u00e9galement des festivals bruxellois et d'autres projets de grande envergure.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Explore.brussels ","address_street_name":"Avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"https:\/\/www.explore.brussels\/fr","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Avenue Brugmann, 405","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Explore.brussels ","address_street_name":"Brugmannlaan","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"https:\/