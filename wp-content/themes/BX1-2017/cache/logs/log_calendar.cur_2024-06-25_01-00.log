5032025867,"languages":{"spoken":["fr","en","nl"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[32,24],"translations":{"de":["Design","Kunstgalerien"],"pt":[null,null],"en":["Design","Art Galleries"],"it":["Design","Gallerie d'arte"],"cn":[null,null],"fr":["Design","Galeries d'art"],"sp":["Dise\u00f1o","Galer\u00edas de arte"],"nl":["Design","Galeries"]}}},"translations":{"de":{"name":"Le jardin extraordinaire","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lapeaudelours.net\/","email":"info@lapeaudelours.net","phone_contact":"+32 493 24 87 53","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50010754"},"pt":{"name":"Le jardin extraordinaire","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lapeaudelours.net\/","email":"info@lapeaudelours.net","phone_contact":"+32 493 24 87 53","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50010754"},"en":{"name":"Le jardin extraordinaire","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lapeaudelours.net\/","email":"info@lapeaudelours.net","phone_contact":"+32 493 24 87 53","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50010754"},"it":{"name":"Le jardin extraordinaire","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lapeaudelours.net\/","email":"info@lapeaudelours.net","phone_contact":"+32 493 24 87 53","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50010754"},"cn":{"name":"Le jardin extraordinaire","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lapeaudelours.net\/","email":"info@lapeaudelours.net","phone_contact":"+32 493 24 87 53","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50010754"},"fr":{"name":"Le jardin extraordinaire","shortdescr":"La peau de l\u2019ours pr\u00e9sente Le jardin extraordinaire, une exposition personnelle du c\u00e9ramiste Fran\u00e7ois \nBauer.","longdescr":"L\u2019exposition explorera la relation entre le dessin et le design, entre l\u2019image et l\u2019objet. Les pi\u00e8ces de Bauer sont des assemblages de plans et de surfaces qui, une fois fusionn\u00e9s, deviennent de nouveaux supports sur lesquels l\u2019artiste fait cohabiter la ligne et la couleur. L\u2019artiste s'appuie sur un champ de recherche plastique \u00e9troitement li\u00e9 \u00e0 l\u2019histoire de l\u2019art et de l\u2019image.\nFran\u00e7ois Bauer, c\u00e9ramiste, vit et travaille \u00e0 Strasbourg. C\u2019est en 2017, apr\u00e8s des \u00e9tudes de graphisme et de design d\u2019objets que celui-ci se tourne vers la c\u00e9ramique. Le dessin, la couleur et le collage se trouvent au centre de sa pratique.","performers":null,"boxoffice_url":null,"website":"https:\/\/lapeaudelours.net\/","email":"info@lapeaudelours.net","phone_contact":"+32 493 24 87 53","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50010754"},"sp":{"name":"Le jardin extraordinaire","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lapeaudelours.net\/","email":"info@lapeaudelours.net","phone_contact":"+32 493 24 87 53","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50010754"},"nl":{"name":"Le jardin extraordinaire","shortdescr":"La peau de l\u2019ours presenteert Le jardin extraordinaire, een solotentoonstelling van keramist Fran\u00e7ois Bauer.","longdescr":"De tentoonstelling verkent de relatie tussen tekenen en ontwerpen, tussen beeld en object. Bauers werken zijn assemblages van vlakken en oppervlakken die, eenmaal gecombineerd, nieuwe dragers worden waarop de kunstenaar lijn en kleur samenbrengt. Bauer put uit een gebied van visueel onderzoek\ndat nauw verbonden is met de geschiedenis van de kunst en het beeld.\nFran\u00e7ois Bauer, keramist, woont en werkt in Straatsburg. Na een studie grafisch ontwerp en objectontwerp, richtte hij zich in 2017 op keramiek. Tekenen, kleur en collage staan centraal in zijn werk.","performers":null,"boxoffice_url":null,"website":"https:\/\/lapeaudelours.net\/","email":"info@lapeaudelours.net","phone_contact":"+32 493 24 87 53","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50010754"}},"place":{"id":50001736,"translations":{"de":{"name":"La peau de l'ours","address_street_name":"Rue Emile Claus","address_street_number":"55","address_street_box":null,"email":"info@lapeaudelours.net","website":"https:\/\/lapeaudelours.net\/","phone_contact":"+32 493 24 87 53","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Emile Claus, 55","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"La peau de l'ours","address_street_name":"Rue Emile Claus","address_street_number":"55","address_street_box":null,"email":"info@lapeaudelours.net","website":"https:\/\/lapeaudelours.net\/","phone_contact":"+32 493 24 87 53","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Emile Claus, 55","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"La peau de l'ours","address_street_name":"Emile Clausstraat","address_street_number":"55","address_street_box":null,"email":"info@lapeaudelours.net","website":"https:\/\/lapeaudelours.net\/","phone_contact":"+32 