targets":{"list":[],"translations":{}},"visit_profile":{"list":[324],"translations":{"fr":["Culture urbaine"],"nl":["Stadscultuur"],"en":["Urban culture"]}},"tags":[],"is_part_of":"Party.brussels","accessibilities":{"list":[255,261],"translations":{"fr":["Accessible","Parking accessible"],"nl":["Toegankelijk","Toegankelijke parking"],"en":["Accessible","Accessible parking"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-05-06T09:05:07+02:00","published_at":"2022-05-06T09:00:51+02:00","backoffice_id":253240,"import_origin":null,"sub_type":"party","show_in_agenda":true,"ranking":1},{"id":533459,"date_start":"2022-05-21","date_end":"2022-05-21","date_next":"2022-05-21","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":57,"translations":{"fr":"Clubbing","nl":"Clubbing","en":"Clubbing"}},"others":{}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Psst Mlle Deconstructing the Dancefloor \/\/ Rethink","shortdescr":"Deconstructing the Dance Floor is a series of events aiming at questioning the codes of nightlife and parties.\r\nIn this episode, we rethink the physical space and involve you in this process so you create the space in which you will move.","longdescr":null,"performers":"19:00 - 00:00 - Music\r\nLazza Gio (live) https:\/\/soundcloud.com\/lazza_gio\r\nSamar (dj set) https:\/\/soundcloud.com\/samar-merdessi\r\nDJ Abena (DJ set) https:\/\/soundcloud.com\/djabena","boxoffice_url":null,"website":"https:\/\/www.facebook.com\/events\/526329468987038","email":"psstmlle@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/533459.html"},"nl":{"name":"Psst Mlle Deconstructing the Dancefloor \/\/ Rethink","shortdescr":"Deconstructing the Dance Floor is a series of events aiming at questioning the codes of nightlife and parties.\r\nIn this episode, we rethink the physical space and involve you in this process so you create the space in which you will move.","longdescr":null,"performers":"19:00 - 00:00 - Music\r\nLazza Gio (live) https:\/\/soundcloud.com\/lazza_gio\r\nSamar (dj set) https:\/\/soundcloud.com\/samar-merdessi\r\nDJ Abena (DJ set) https:\/\/soundcloud.com\/djabena","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/533459.html"},"en":{"name":"Psst Mlle Deconstructing the Dancefloor \/\/ Rethink","shortdescr":"Deconstructing the Dance Floor is a series of events aiming at questioning the codes of nightlife and parties.\r\nIn this episode, we rethink the physical space and involve you in this process so you create the space in which you will move.","longdescr":"Deconstructing the Dance Floor is a series of events aiming at questioning the codes of nightlife and parties.\r\nIn this episode, we rethink the physical space and involve you in this process so you create the space in which you will move.\r\n13:00 - 19:00 - Collaborative scenography \/ building the space\r\nContribute to the creation of the ideal space you\u2019d like to dance in during the evening. You can call it a scenography workshop, but there won\u2019t be a teacher. Everyone can share their ideas and skills to create a space where they feel good for a party. Safety and inclusion will be central.\r\nSince we are at Atelier Triphas\u00e9, we asked the artists from the space to keep any material they would have thrown away otherwise, so we can use it for the scenography.\r\nThere will be snacks and soft drinks available.\r\nJoin us to build a DJ booth, a cosy chill zone or whatever you feel like.\r\nRegister via psstmlle@gmail.com\r\n19:00 - 00:00 - Music\r\nLazza Gio (live) https:\/\/soundcloud.com\/lazza_gio\r\nSamar (dj set) https:\/\/soundcloud.com\/samar-merdessi\r\nDJ Abena (DJ set) https:\/\/soundcloud.com\/djabena\r\nWe have 3 entry prices for the evening, please contribute how you can:\r\n- Regular ticket : 5 eur.\r\n- Supportive ticket : 7 eur.\r\n- Extra-supportive ticket : 10 eur.\r\n- If you're in a precarious situation and would like to attend, send us an email to psstmlle@gmail.com\r\nPsst Mlle is a pluridisciplinary intersectional feminist platform striving for more inclusion and representation of FINTA people (female, intersex, non-binary, transgender, agender).\r\nEveryone is welcome and required to respect and celebrate our values - consent, inclusion, benevolence.","performers":"19:00 - 00:00 - Music\r\nLazza Gio (live) https:\/\/soundcloud.com\/lazza_gio\r\nSamar (dj set) https:\/\/soundcloud.com\/samar-merdessi\r\nDJ Abena (DJ set) https:\/\/soundcloud.com\/djabena","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/533459.html"},"de":{"name":"Psst Mlle Deconstructing the Dancefloor \/\/ Rethink","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/533459.html"},"it":{"name":"Psst Mlle Deconstructing the Dancefloor \/\/ Rethink","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/533459.html"},"sp":{"name":"Psst Mlle Deconstructing the Dancefloor \/\/ Rethink","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/533459.html"},"pt":{"name":"Psst Mlle Deconstructing the Dancefloor \/\/ Rethink","shortdescr":