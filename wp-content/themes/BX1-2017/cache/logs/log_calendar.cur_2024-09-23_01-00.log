 vies bris\u00e9es, des naissances ou des brefs s\u00e9jours en ville.\n\nDiscr\u00e8tes, souvent en hauteur, nous passons devant sans plus les voir ou les lire. Elles sont pourtant le t\u00e9moin de notre histoire collective.\n\nNotre guide vous emm\u00e8ne \u00e0 la d\u00e9couverte des histoires qui se cachent\u2026 \u00e0 c\u00f4t\u00e9 de la plaque.\n\nQuand ? Samedi 31 ao\u00fbt \u00e0 10h (devant le BIP, place royale)\nPrix : 15\u20ac (10\u20ac pour les 6-12 ans)\nInfos et r\u00e9servations : info@91parallele.be","performers":null,"boxoffice_url":null,"website":"http:\/\/www.91parallele.be","email":"info@91parallele.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700001376"},"sp":{"name":"A c\u00f4t\u00e9 de la plaque","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.91parallele.be","email":"info@91parallele.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700001376"},"nl":{"name":"A c\u00f4t\u00e9 de la plaque","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.91parallele.be","email":"info@91parallele.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700001376"}},"place":{"id":243999,"translations":{"de":{"name":"Place Royale","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Royale","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Place Royale","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone