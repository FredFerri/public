e,"last_updated_at":"2023-08-25T08:15:04+02:00","published_at":"2023-08-25T08:05:06+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":true,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":283914,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"concert","ranking":1,"languages":{"spoken":["fr","nl"],"subtitles":[]},"categories":{"main":{"id":1,"translations":{"de":"Konzert","pt":null,"en":"Concert","it":"Concerti","cn":null,"fr":"Concert","sp":"Concierto","nl":"Concert"}},"others":{}},"translations":{"de":{"name":"Ik en den Theo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50001315"},"pt":{"name":"Ik en den Theo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50001315"},"en":{"name":"Ik en den Theo","shortdescr":null,"longdescr":"Ik en den Theo\/Moi et le Th\u00e9o look at the world through children's eyes. Piet Maris and Theophane Raballand ( both of Jaune Toujours) do their thing on accordion and drums... and with the audience. Depending on its composition Ik en den Theo\/Moi et le Th\u00e9o sing in Dutch or French, or in the best of worlds in both languages.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50001315"},"it":{"name":"Ik en den Theo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50001315"},"cn":{"name":"Ik en den Theo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50001315"},"fr":{"name":"Ik en den Theo","shortdescr":null,"longdescr":"Avec Moi et le Th\u00e9o\/Ik en den Theo vous (re) d\u00e9couvrez le monde \u00e0 travers les yeux des petits. Enfants, parents et grands-parents marchent comme des robots, jouent \u00e0 la chaise musicale, re\u00e7oivent un souffle \u00e9nergique de l\u2019oncle Jazz, jouent de l\u2019air guitar et m\u00eame plus. Bref, ils explorent les limites ext\u00e9rieures de leur fantaisie.\n\nEn fonction de la composition du public, Moi et le Th\u00e9o\/Ik en den Theo chantent en fran\u00e7ais, en n\u00e9erlandais ou, dans le meilleur des mondes, en deux langues.\n\nPiet Maris et Theophane Raballand (tous les deux de Jaune Toujours) font leur truc \u00e0 l\u2019accord\u00e9on, \u00e0 la batterie et aux percussions, mais surtout\u2026 avec le public, qui est sans cesse invit\u00e9 \u00e0 danser, \u00e0 chanter, \u00e0 sauter et \u00e0 imaginer.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50001315"},"sp":{"name":"Ik en den Theo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50001315"},"nl":{"name":"Ik en den Theo","shortdescr":null,"longdescr":"Bij Ik en den Theo \/ Moi et le Th\u00e9o (her)bekijk je de wereld door kinderogen. Kinderen, ouders en grootouders kunnen rondlopen als robots, stoelendansen, bezoek krijgen van nonkel Jazz, luchtgitaar spelen en nog veel meer... Kortom, ze verkennen de uiterste grenzen van hun fantasie.\n\nAfhankelijk van de samenstelling van het publiek zingen Ik en den Theo\/Moi et le Th\u00e9o in het Nederlands of in het Frans of, in de beste van alle werelden, in beide talen.\n\nPiet Maris en Theophane Raballand (allebei van Jaune Toujours) doen hun ding op accordeon en slagwerk ... en met het publiek, dat voortdurend wordt uitgedaagd om mee te zingen, dansen, springen en fantaseren.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50001315"}},"place":{"id":277347,"translations":{"de":{"name":"Place Van Meyel","address_street_name":"Place Van Meyel","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Place Van Meyel","address_line2":"1040 Etterbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Place Van Meyel","address_street_name":"Place Van Meyel","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Place Van Meyel","address_line2":"1040 Etterbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Place Van Meyel","address_street_name":"Place Van Meyel","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Place Van Meyel","address_line2":"1040 Etterbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Place Van Meyel","address_street_name":"Place Van Meyel","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_