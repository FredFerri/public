:"2023-01-03","doors":null,"start":"11:00:00","end":"18:00:00"},{"day":"2023-01-04","doors":null,"start":"11:00:00","end":"18:00:00"},{"day":"2023-01-05","doors":null,"start":"11:00:00","end":"18:00:00"},{"day":"2023-01-06","doors":null,"start":"11:00:00","end":"18:00:00"},{"day":"2023-01-07","doors":null,"start":"11:00:00","end":"18:00:00"},{"day":"2023-01-08","doors":null,"start":"11:00:00","end":"18:00:00"}],"weekschema":[{"days":{"monday":{"is_open":false},"tuesday":{"is_open":true,"hours":[{"start":"11:00:00","end":"18:00:00"}]},"wednesday":{"is_open":true,"hours":[{"start":"11:00:00","end":"18:00:00"}]},"thursday":{"is_open":true,"hours":[{"start":"11:00:00","end":"18:00:00"}]},"friday":{"is_open":true,"hours":[{"start":"11:00:00","end":"18:00:00"}]},"saturday":{"is_open":true,"hours":[{"start":"11:00:00","end":"18:00:00"}]},"sunday":{"is_open":true,"hours":[{"start":"11:00:00","end":"18:00:00"}]}},"translations":{"fr":["lundi: ferm\u00e9","mardi, mercredi, jeudi, vendredi, samedi et dimanche: de 11:00 \u00e0 18:00"],"nl":["maandag: gesloten","dinsdag, woensdag, donderdag, vrijdag, zaterdag en zondag: van 11:00 tot 18:00"],"en":["monday: closed","tuesday, wednesday, thursday, friday, saturday and sunday: from 11:00 to 18:00"]},"date_start":"2022-09-09","date_end":"2023-01-08","is_also_by_appointment":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":10},{"translations":{"fr":{"name":"Enfants"},"nl":{"name":"Kinderen"},"en":{"name":"Children"}},"value":0},{"translations":{"fr":{"name":"Jeunes"},"nl":{"name":"Jongeren"},"en":{"name":"Young people"}},"value":0},{"translations":{"fr":{"name":"Etudiants"},"nl":{"name":"Studenten"},"en":{"name":"Students"}},"value":4},{"translations":{"fr":{"name":"Seniors"},"nl":{"name":"Senioren"},"en":{"name":"Seniors"}},"value":7},{"translations":{"fr":{"name":"Demandeurs d'emploi"},"nl":{"name":"Werkzoekenden"},"en":{"name":"Job seekers"}},"value":4},{"translations":{"fr":{"name":"Groupe"},"nl":{"name":"Groep"},"en":{"name":"Group"}},"value":7},{"translations":{"fr":{"name":"Article 27"},"nl":{"name":"Artikel 27"},"en":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"opening":{"day":"2022-09-08","start":"18:30:00","timestamp":"2022-09-08T18:30:00+02:00","end":"22:00:00","is_only_by_appointment":false},"visit_profile":{"list":[327,337],"translations":{"fr":["Art contemporain","Highlight"],"nl":["Hedendaagse kunst","Highlight"],"en":["Contemporary art","Highlight"],"de":["Zeitgen\u00f6ssische Kunst","Highlight"]}},"tags":[],"accessibilities":{"list":[255],"translations":{"fr":["Accessible"],"nl":["Toegankelijk"],"en":["Accessible"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-24T01:09:06+02:00","published_at":"2022-06-16T11:50:36+02:00","backoffice_id":256182,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.32006146360353},{"id":540714,"date_start":"2022-10-14","date_end":"2023-02-12","date_next":"2022-10-25","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung"}},"others":{"list":[36,42],"translations":{"fr":["Mus\u00e9es et art centers","Peinture"],"nl":["Musea en kunstcentra","Schilderkunst"],"en":["Museums and art centers","Painting"],"de":["Museen & Kunstzentren","Malerei"]}}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Picasso & Abstraction","shortdescr":null,"longdescr":"Pour la premi\u00e8re fois, les \u00e9tapes qui ont rythm\u00e9 les liens entre l\u2019\u0153uvre de Picasso et l\u2019histoire de l\u2019art abstrait sont mis en lumi\u00e8re.\r\n\r\nDes premi\u00e8res exp\u00e9rimentations cubistes de 1907 r\u00e9alis\u00e9es en marge des Demoiselles d\u2019Avignon \u00e0 son \u0153uvre tardive parfois situ\u00e9e aux fronti\u00e8res de la peinture gestuelle, cette surprenante relation est pr\u00e9sent\u00e9e dans un parcours chronologique et th\u00e9matique subtil, o\u00f9 plus de cent vingt \u0153uvres exceptionnelles r\u00e9v\u00e8lent le mouvement de balancier que l\u2019artiste op\u00e8re au fil des d\u00e9cennies entre abstraction et figuration. \r\n\r\nAutre th\u00e8me majeur, intimement li\u00e9 \u00e0 la collection du Mus\u00e9e Picasso-Paris , est l\u2019atelier de l\u2019artiste, v\u00e9ritable laboratoire formel de l\u2019\u0153uvre, qui donne \u00e0 voir le processus cr\u00e9atif de Picasso \u00e0 travers diverses s\u00e9ries de dessins et estampes. \r\n\r\nL\u2019exposition, par sa th\u00e9matique pointue et novatrice, invite le spectateur \u00e0 appr\u00e9cier la cr\u00e9ativit\u00e9 extraordinaire de l\u2019artiste et sa capacit\u00e9 \u00e0 sans cesse se r\u00e9inventer.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.fine-arts-museum.be","email":"info@fine-arts-museum.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.540714"},"nl":{"name":"Picasso & Abstraction","shortdescr":null,"longdescr":"Voor de eerste keer wordt de relatie tussen Picasso\u2019s werk en de abstracte kunstgeschiedenis aan het licht gebracht. \r\n\r\nVan de eerste kubistische experimenten van 1907, uitgevoerd in de marge van Les Demoiselles d'Avignon, tot zijn latere werk op de grens van de action painting, deze verrassende relatie wordt getoond in een subtiele chronologisch en thematisch parcours. Meer dan honderdtwintig uitzonderlijke werken onthulden de slingerbeweging van de kunstenaar tussen de abstractie en het figuratieve. \r\n\r\nHet kunstenaarsatelier vormt een ander belangrijk thema in de tentoonstelling. Dit laboratorium van vormen toont het creatieproces van Picasso aan de hand van verschillende reeksen tekeningen en prenten, alsook hoe de kunstenaar werkt en nadenkt over de gekozen motieven. \r\n\r\nDe tentoonstelling illustreert de buitengewone creativiteit van Pablo Picasso en zijn vermogen om zichzelf voortdurend opnieuw uit te vinden.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.fine-arts-museum.be","email":"info@fine-arts-museum.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.540714"},"en":{"name":"Picasso & Abstraction","shortdescr":null,"longdescr":"For the first time, the major stages that marked the links between Picasso's work and the history of abstract art is brought to light.  \r\n\r\nFrom the first Cubist experiments of 1907, carried out on the fringes of Les Demoiselles d'Avignon, to his later work, which is sometimes situated on the borders of action painting, this surprising relationship is shown in a subtle chronological and thematic exhibition, where more than one hundred exceptional works reveal the artist's pendulum movement between abstraction and the figurative over the decades. \r\n\r\nAnother major theme of the exhibition is the artist's studio, a true formal laboratory, and shows Picasso's creative process through various series of drawings and prints, allowing the viewer to understand how he works and reflects on the representation of the chosen motifs. \r\n\r\nThe exhibition, with its sharp and innovative theme, invites the viewer to appreciate Pablo Picasso\u2019s extraordinary creativity and his ability to constantly reinvent himself.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.fine-arts-museum.be","email":"info@fine-arts-museum.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.540714"},"de":{"name":"Picasso & Abstraction","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.540714"},"it":{"name":"Picasso & Abstraction","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.540714"},"sp":{"name":"Picasso & Abstraction","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.540714"},"pt":{"name":"Picasso & Abstraction","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.540714"},"cn":{"name":"Picasso & Abstraction","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.540714"}},"place":{"id":488,"translations":{"fr":{"name":"Mus\u00e9es Royaux des Beaux-Arts de Belgique","address_street_name":"Rue de la R\u00e9gence","address_street_number":"3","address_street_box":null,"email":"info@fine-arts-museum.be","website":"http:\/\/www.fine-arts-museum.be","phone_contact":"+32 2 508 32 11","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la R\u00e9gence, 3","address_line2":"1000 Bruxelles","description_web":"Les Mus\u00e9es Royaux des Beaux-Arts de Belgique sont constitu\u00e9s de six mus\u00e9es bruxellois: le Mus\u00e9e Oldmasters Museum, le Mus\u00e9e Modern Museum, le Mus\u00e9e Meunier Museum, le Mus\u00e9e Wiertz Museum, le Magritte Museum et le Mus\u00e9e fin-