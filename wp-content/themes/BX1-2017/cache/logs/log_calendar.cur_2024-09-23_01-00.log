19importe quel dessin, le dessin de grand, de tr\u00e8s grand format !\nDe Long en Large pr\u00e9sentera en effet les travaux de grand et tr\u00e8s grand format d\u2019artistes belges et \u00e9trangers invit\u00e9s par le commissaire de l\u2019exposition, Philippe Marchal.","performers":"Avec des oeuvres de Michel ALLARD, Dominique ANGEL, Emmanuel BAYON, Myl\u00e8ne BESSON, Philippe BRIADE, Fabienne CHRISTYN, Maxime GOUGEON, Jeroen HOLLANDER, Skender HYSENI, Jack KEGUENNE, Dominique LARDEUX, Emilie MAGNAN, Dominique MEEUS et Cl\u00e9ment SUANEZ.","boxoffice_url":null,"website":"https:\/\/www.autonomie.brussels","email":"contact@artesio.art","phone_contact":"+32 470 57 40 62","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700001417"},"sp":{"name":"\"De Long en Large\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.autonomie.brussels","email":"contact@artesio.art","phone_contact":"+32 470 57 40 62","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700001417"},"nl":{"name":"\"De Long en Large\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.autonomie.brussels","email":"contact@artesio.art","phone_contact":"+32 470 57 40 62","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700001417"}},"place":{"id":50002405,"translations":{"de":{"name":"Centre d'arts pluriels 'AUTONOMIE","address_street_name":"Rue de l'Autonomie","address_street_number":"4","address_street_box":null,"email":"contact@artesio.art","website":"https:\/\/www.autonomie.brussels","phone_contact":"+32 470 57 40 62","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de l'Autonomie, 4","address_line2":"1070 Anderlecht","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"vi