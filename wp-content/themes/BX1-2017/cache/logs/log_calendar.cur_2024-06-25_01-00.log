eraie.org\/esprit-de-famille","email":"secretariat@roseraie.org","phone_contact":"+32 2 376 46 45","phone_booking":"+32 2 376 46 45","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50011312"},"it":{"name":"Nous animaux (Histoires publiques)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.roseraie.org\/esprit-de-famille","email":"secretariat@roseraie.org","phone_contact":"+32 2 376 46 45","phone_booking":"+32 2 376 46 45","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50011312"},"cn":{"name":"Nous animaux (Histoires publiques)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.roseraie.org\/esprit-de-famille","email":"secretariat@roseraie.org","phone_contact":"+32 2 376 46 45","phone_booking":"+32 2 376 46 45","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50011312"},"fr":{"name":"Nous animaux (Histoires publiques)","shortdescr":"Nous, animaux -librement inspir\u00e9 du livre Le Chez-Soi des Animaux de Vinciane Despret- est un spectacle en milieu naturel, qui nous fait voyager autour des notions d\u2019habitat et de territoire, de la hi\u00e9rarchie des esp\u00e8ces et de notre possible cohabitation. Quelle place pour chacun ? Quelle place pour chacun, ensemble ?  Spectacle \u00e0 partir de 8 ans. \n","longdescr":"Une femme est \u00e0 l\u2019or\u00e9e du bois. Habitante d\u2019un futur tout b\u00e9tonn\u00e9, sans couleurs et sans odeurs, elle a d\u00e9barqu\u00e9 dans notre 2024, pour retrouver le nom des choses disparues l\u00e0-bas, chez elle, plus tard. Au d\u00e9tour de cette rencontre, elle nous emm\u00e8ne faire une balade pas comme les autres : une plong\u00e9e au c\u0153ur du vivant. C\u2019est une invitation \u00e0 marcher (sans \u00e9craser ), \u00e0 \u00e9couter (un peu plus fort que d\u2019habitude), \u00e0 regarder ( plus loin que ce que l'\u0153il voit). \nAu bout du chemin, elle nous invite \u00e0 entrer chez elle. Enfin, chez elle...On se croit\nvite chez soi partout, n\u2019est-ce pas?...\n","performers":"Interpr\u00e9tation: Aurore Latour\nCollaboratrice artistique: Emmanuelle Bonmariage\nCr\u00e9ateur Son: Benjamin Pasternak\nMetteuse en sc\u00e8ne : Julie Marichal\n","boxoffice_url":null,"website":"https:\/\/www.roseraie.org\/esprit-de-famille","email":"secretariat@roseraie.org","phone_contact":"+32 2 376 46 45","phone_booking":"+32 2 376 46 45","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50011312"},"sp":{"name":"Nous animaux (Histoires publiques)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.roseraie.org\/esprit-de-famille","email":"secretariat@roseraie.org","phone_contact":"+32 2 376 46 45","phone_booking":"+32 2 376 46 45","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50011312"},"nl":{"name":"Nous animaux (Histoires publiques)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.roseraie.org\/esprit-de-famille","email":"secretariat@roseraie.org","phone_contact":"+32 2 376 46 45","phone_booking":"+32 2 376 46 45","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50011312"}},"place":{"id":231528,"translations":{"de":{"name":"La Roseraie","address_street_name":"Chauss\u00e9e d'Alsemberg","address_street_number":"1299","address_street_box":null,"email":"secretariat@roseraie.org","website":"http:\/\/www.roseraie.org","phone_contact":"+32 2 376 46 45","phone_booking":"+32 2 376 46 45","address_zip":"1180","address_city":"Uccle","address_line1":"Chauss\u00e9e d'Alsemberg, 1299","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"La Roseraie","address_street_name":"Chauss\u00e9e d'Alsemberg","address_street_number":"1299","address_stree