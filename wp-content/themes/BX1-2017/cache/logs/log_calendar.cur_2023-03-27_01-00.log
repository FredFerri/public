","date_end":"2023-03-29","date_next":"2023-03-29","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen","it":"Visite guidate","sp":"Visitas guiadas","pt":null,"cn":null}},"others":{"list":[112],"translations":{"fr":["Insolite"],"nl":["Ongewoon"],"en":["Unusual"],"de":["Ausgefallenes"],"it":["Insolito"],"sp":["Ins\u00f3lito"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Rencontre avec le Chat et visite du parc de Bruxelles","shortdescr":null,"longdescr":"De retour d\u2019une grande tourn\u00e9e europ\u00e9enne, le Chat vous attend, immobile et impatient, au Parc Royal, dans la ville pr\u00e9f\u00e9r\u00e9e de son ma\u00eetre.\r\nL\u2019endroit id\u00e9al pour f\u00eater ses 40 ans !\r\nIncontournable, le plus ancien parc public de la capitale, vous d\u00e9voilera son pass\u00e9, ses charmes et ses secrets. \r\nPour cet anniversaire bruxellois, deux nouvelles statues in\u00e9dites s\u2019ajoutent aux vingt qui ont d\u00e9j\u00e0 vu d\u00e9filer tant de promeneurs dans d\u2019autres lieux.\r\nL\u2019\u0153il alerte et l\u2019esprit amus\u00e9, nous vous proposons de les contempler, les caresser, les imiter ... tout en d\u00e9voilant des techniques et des anecdotes.","performers":null,"boxoffice_url":null,"website":"https:\/\/rdvculturels.be","email":"rdvculturelsbe@gmail.com","phone_contact":"+32 476 40 98 30","phone_booking":"+32 476 40 98 30","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.553864"},"nl":{"name":"Rencontre avec le Chat et visite du parc de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/rdvculturels.be","email":"rdvculturelsbe@gmail.com","phone_contact":"+32 476 40 98 30","phone_booking":"+32 476 40 98 30","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.553864"},"en":{"name":"Rencontre avec le Chat et visite du parc de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/rdvculturels.be","email":"rdvculturelsbe@gmail.com","phone_contact":"+32 476 40 98 30","phone_booking":"+32 476 40 98 30","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.553864"},"de":{"name":"Rencontre avec le Chat et visite du parc de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/rdvculturels.be","email":"rdvculturelsbe@gmail.com","phone_contact":"+32 476 40 98 30","phone_booking":"+32 476 40 98 30","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.553864"},"it":{"name":"Rencontre avec le Chat et visite du parc de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/rdvculturels.be","email":"rdvculturelsbe@gmail.com","phone_contact":"+32 476 40 98 30","phone_booking":"+32 476 40 98 30","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.553864"},"sp":{"name":"Rencontre avec le Chat et visite du parc de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/rdvculturels.be","email":"rdvculturelsbe@gmail.com","phone_contact":"+32 476 40 98 30","phone_booking":"+32 476 40 98 30","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.553864"},"pt":{"name":"Rencontre avec le Chat et visite du parc de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/rdvculturels.be","email":"rdvculturelsbe@gmail.com","phone_contact":"+32 476 40 98 30","phone_booking":"+32 476 40 98 30","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.553864"},"cn":{"name":"Rencontre avec le Chat et visite du parc de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/rdvculturels.be","email":"rdvculturelsbe@gmail.com","phone_contact":"+32 476 40 98 30","phone_booking":"+32 476 40 98 30","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.553864"}},"place":{"id":237417,"translations":{"fr":{"name":"Parc de Bruxelles \/ Parc Royal","address_street_name":"Place des Palais","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais","address_line2":"1000 Bruxelles","description_web":"Le parc de Bruxelles, auparavant appel\u00e9 \u00ab\u00a0Parc royal\u00a0\u00bb, est le plus ancien parc de la ville qui fut le premier \u00e0 \u00eatre public. Am\u00e9nag\u00e9 sur les ruines de celui des ducs de Bourgogne et des gouverneurs des Pays-Bas, il est situ\u00e9 entre le parlement F\u00e9d\u00e9ral \u2013 ou Palais de la Nation \u2013 et le palais Royal, symboles du pouvoir et de la royaut\u00e9. Ce parc est le t\u00e9moin des violents combats des Bruxellois lors de la r\u00e9volution de 1830.\r\n\r\nCon\u00e7u dans un style n\u00e9o-classique par l'architecte Guimard et le jardinier Zinner, il s\u2019ouvre sur le grand bassin pour ensuite vous offrir de larges all\u00e9es, des alignements sym\u00e9triques et des perspectives. Retrouvez des statues de la mythologie gr\u00e9co-romaine, le Vauxhall, un kiosque \u00e0 musique, le Th\u00e9\u00e2tre Royal du Parc, la Guinguette Royale ou encore le Kiosk Radio, un bar o\u00f9 danser sous les arbres\u00a0!","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Warandepark \/ Koninklijk Park","address_street_name":"Paleizenplein","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Paleizenplein","address_line2":"1000 Brussel","description_web":"Het Warandepark noemden ze vroeger \u2018Koninklijk Park\u2019. Het is het oudste park van de stad en het eerste dat openbaar werd gemaakt. Lang geleden werd het Warandepark gebouwd op de ru\u00efnes van het park van de hertogen van Bourgondi\u00eb en de gouverneurs van de Nederlanden. Nu vind je het tussen het Federaal Parlement (Paleis van de Natie) en het Koninklijk Paleis, symbolen van macht en koningschap. In dit park werd er hevig gevochten tijdens de revolutie van 1830.\r\n\r\nArchitect Guimard en de tuinman Zimmer ontwierpen het park in neo-klassieke stijl. Centraal ligt het grote dok. Vandaar vertrekken brede paden, symmetrische uitlijningen en perspectieven. Je vindt hier heel wat standbeelden uit de Grieks-Romeinse mythologie. Neem ook eens een kijkje in de Vauxhall, het Th\u00e9\u00e2tre Royal du Parc, de Guinguette Royale en Kiosk Radio, een radiostation met bar waar je kan dansen onder de bomen!","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Brussels Park","address_street_name":"Place des Palais","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Place des Palais","address_line2":"1000 Brussels","description_web":"Brussels Park, known for many years previously as the Royal Park, is the oldest park in the region which became a public park. Built on the ruins of the park of the Dukes of Burgundy and the Governors of the Spanish Netherlands, it stands proudly between the Federal Parliament and the Royal Palace, symbols of power and the monarchy. This spot, was once the site of fierce battles for the people of Brussels during the revolution in 1830.\r\n\r\nDesigned in a neo-classical style by architect Guimard and gardener Zinner, it opens onto the large pond and then offers you wide alleys, symmetrical alignments and stunning views. You'll find statues of Greco-Roman mythology, the Vauxhall, a bandstand, the Th\u00e9\u00e2tre Royal du Parc, the Guinguette Royale and even Kiosk Radio, a bar where you can dance beneath the trees!","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Parc de Bruxelles \/ Parc Royal","address_street_name":"Place des Palais","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais","address_line2":"1000 Bruxelles","description_web":"Der Parc de Bruxelles, ehemals \u201eParc Royal\u201c, ist der \u00e4lteste Park der Stadt und der erste, der f\u00fcr die \u00d6ffentlichkeit zug\u00e4nglich war. Er wurde einst auf den \u00dcberresten des Parks der Herz\u00f6ge von Burgund und der Gouverneure der Niederlande angelegt und befindet sich zwischen den beiden wichtigsten belgischen Machtzentren, d. h. dem Bundesparlament \u2013 oder Palast der Nation \u2013 und dem K\u00f6nigspalast. Der Park wurde im Zuge der Revolution im Jahr 1830 zum Schauplatz heftiger K\u00e4mpfe.\r\n\r\nEr wurde von dem Architekten Guimard und dem G\u00e4rtner Zinner im neoklassizistischen Stil angelegt und \u00f6ffnet sich zu einem gro\u00dfen Becken hin, wobei er dem Spazierg\u00e4nger mit seinen breiten Alleen und symmetrischen Fluchten sch\u00f6ne Perspektiven bietet. \u00dcber den Park verteilt finden Besucher Statuen aus der griechisch-r\u00f6mischen Mythologie, den historischen Veranstaltungsort Vauxhall, einen Musikpavillon, das Th\u00e9\u00e2tre Royal du Parc, das Park-Caf\u00e9 Guinguette Royale oder auch die kleine Holzh\u00fctte des Kiosk Radio mit eklektischer Musikauswahl und Erfrischungsgetr\u00e4nken!","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Parc de Bruxelles \/ Parc Royal","address_street_name":"Place des Palais","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Parque de Bruselas","address_street_name":"Place des Palais","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais","address_line2":"1000 Bruxelles","description_web":"Conocido como el \"Parque Real\" por muchos a\u00f1os, fue el primer parque p\u00fablico de Bruselas. Este enorme cuadril\u00e1tero sembrado de \u00e1rboles y orgulloso de situarse entre el Parlamento y el Palacio Real de Bruselas se extiende ante amplios caminos, sim\u00e9tricamente alineados y con sorprendentes perspectivas. En cuanto te abras camino atravesar\u00e1s amplios y frondosos claros, un escenario, un teatro, dos fuentes y varios quioscos que sirven refrescos. Y sin embargo, este lugar, que radia tranquilidad, una vez fue el lugar de feroces batallas por la gente de Bruselas que luch\u00f3 por su revoluci\u00f3n en 1830.\r\n\r\nEn 1770, todo el distrito  de la Corte(ahora Place Royale y el Parque de Bruselas) fue renovado. El arquitecto Guimard dibuj\u00f3 el plano para el nuevo parque. Fue aconsejado por el jardinero Zinner, a quien fue atribu\u00eddo el rol de Guimard de manera err\u00f3nea. Fue en este parque donde tuvieron lugar las primeras batallas entre los patriotas belgas y las tropas neerlandesas en 1830.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Parque de Bruxelas\/Parque Real","address_street_name":"Place des Palais","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais","address_line2":"1000 Bruxelles","description_web":"O parque de Bruxelas, antigamente denominado \u00abParque Real\u00bb foi o primeiro parque p\u00fablico de Bruxelas. Situa-se entre o Parlamento Federal e o Pal\u00e1cio Real. Oferece vias largas, alinhamentos sim\u00e9tricos e perspetivas surpreendentes. Encontramos a\u00ed clareiras de vegeta\u00e7\u00e3o, um coreto, um teatro, duas fontes e alguns quiosques de restaura\u00e7\u00e3o. O parque de Bruxelas respira agora serenidade, mas foi palco de combates violentos dos bruxelenses, que aqui lutaram pela sua revolu\u00e7\u00e3o em 1830. Na d\u00e9cada de 1770, todo o bairro da Corte foi transformado. O arquiteto Guimard desenhou o novo plano do parque. Foi assistido pelo jardineiro Zinner, a quem foi atribu\u00eddo erroneamente o papel de Guimard. Equipamentos : -Bancos -Fonte de \u00e1gua pot\u00e1vel -Parque infantil 7-12 anos -Quiosque -Sanit\u00e1rios Acessibilidade: h\u00e1 um degrau em cada entrada do parque. De seguida, \u00e9 relativamente f\u00e1cil para uma pessoa com mobilidade condicionada deslocar-se pelo parque. Alguns elementos do parque infantil foram especialmente adaptados para crian\u00e7as portadoras de defici\u00eancia.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Parc de Bruxelles \/ Parc Royal","address_street_name":"Place des Palais","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[16],"translations":{"fr":["Quartier Royal"],"nl":["Koninklijke wijk"],"en":["Royal"],"de":["K\u00f6nigliches Viertel"],"it":["Quartiere reale"],"sp":["Quartier Royal \u2014Barrio de la Corte\u2014"],"pt":[null],"cn":[null]}},"zones":{"list":[19],"translations":{"fr":["Centre"],"nl":["Centrum"],"en":["Centre"],"de":["Zentrum"],"it":["Centro"],"sp":["Centro"],"pt":[null],"cn":[null]}},"neca":null,"facebook_id":null,"backoffice_id":1764,"location":{"lat":50.84262397,"lon":4.36270506},"region":"brussels","last_updated_at":"2023-03-21T12:05:12+01:00","published_at":"2013-10-19T01:14:37+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":265990,"translations":{"fr":{"name":"Rendez-vous culturels in Belgium","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":"rdvculturelsbe@gmail.com","website":"https:\/\/rdvculturels.be","phone_contact":"+32 476 40 98 30","phone_booking":null,"address_zip":"1150","address_city":"Woluwe-Saint-Pierre","address_line1":"Rendez-vous culturels in Belgium","address_line2":"1150 Woluwe-Saint-Pierre","description_web":"Sept guides touristiques et culturel(le)s dipl\u00f4m\u00e9(e)s, multilingues : fran\u00e7ais, anglais, n\u00e9erlandais, espagnol\u2026  \r\nIls allient l\u2019Histoire, le patrimoine et l\u2019anecdote pour vous faire d\u00e9couvrir Bruxelles, d\u2019autres villes et des sites embl\u00e9matiques de Belgique.\r\nLeur but : vous pr\u00e9senter l\u2019Histoire, la vie quotidienne, les traditions folkloriques ou gastronomiques\u2026 sans oublier la joie de vivre et l\u2019humour. Visiter, c\u2019est aussi rencontrer ses habitants et ses traditions.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Rendez-vous culturels in Belgium","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":"rdvcultu