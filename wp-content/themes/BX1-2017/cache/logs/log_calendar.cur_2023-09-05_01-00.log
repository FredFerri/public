t_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2023-09-04T23:45:01+02:00","published_at":"2023-09-04T08:33:06+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":284652,"facebook_link":null,"import_origin":null,"is_part_of":"Ann\u00e9e Art Nouveau","sub_type":"expo","ranking":0.3375531905895819,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{}},"translations":{"de":{"name":"From Eclecticism to Art Nouveau: painter-decorator Victor Van Dyck, 1863-1943","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/associationdupatrimoineartistique.be\/actualites","email":"as.pat.art@gmail.com","phone_contact":"+32 2 512 34 21","phone_booking":"+32 2 512 34 21","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50001744"},"pt":{"name":"From Eclecticism to Art Nouveau: painter-decorator Victor Van Dyck, 1863-1943","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/associationdupatrimoineartistique.be\/actualites","email":"as.pat.art@gmail.com","phone_contact":"+32 2 512 34 21","phone_booking":"+32 2 512 34 21","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50001744"},"en":{"name":"From Eclecticism to Art Nouveau: painter-decorator Victor Van Dyck, 1863-1943","shortdescr":"From September 7 to October 28, 2023, discover the work of painter-decorator Victor Van Dyck. The analysis of his career and his mastery of several styles, materials and techniques shed light on the process of artistic transition that, between the end of the 19th and the beginning of the 20th centuries, led to the emergence and dissemination of Art Nouveau.","longdescr":"The exhibition displays more than 200 drawings, watercolours and paintings by Victor Van Dyck (1863-1943), conserved by his heirs. These decorative projects allow us to address several issues concerning the training of a decorative artist in Belgium, as well as his work, which included commissions for public places or performance venues (the decorations of caf\u00e9s and brasseries on the main boulevards of Brussels, as well as these executed for British theatres), private commissions (bourgeois houses), or official commissions (royal sedans for Leopold II and Albert I). This wide variety of projects will also allow the visitors to discover the very eclectic tastes of the time, which often mixed several different styles: Rococo, Moresque, Flemish neo-Renaissance, Art Nouveau.\n\nThe works presented by the Association constitute a rare and coherent ensemble that underlines the degree of artistic versatility that had to be demonstrated in this profession.\n\n\n","performers":"The Association du Patrimoine Artistique\u2019s exhibition \u201cFrom Eclecticism to Art Nouveau:\nVictor Van Dyck (1863-1943), painter-decorator\u201d aims at discovering the different facets of the decorative artist profession in the historical and cultural context of the time. Curated by Pierre Loze, it will be opened from the 7th of September to the 28th of October 2023.","boxoffice_url":null,"website":"https:\/\/associationdupatrimoineartistique.be\/actualites","email":"as.pat.art@gmail.com","phone_contact":"+32 2 512 34 21","phone_booking":"+32 2 512 34 21","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50001744"},"it":{"name":"From Eclecticism to Art Nouveau: painter-decorator Victor Van Dyck, 1863-1943","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/associationdupatrimoineartistique.be\/actualites","email":"as.pat.art@gmail.com","phone_contact":"+32 2 512 34 21","phone_booking":"+32 2 512 34 21","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50001744"},"cn":{"name":"From Eclecticism to Art Nouveau: painter-decorator Victor Van Dyck, 1863-1943","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/associationdupatrimoineartistique.be\/actualites","email":"as.pat.art@gmail.com","phone_contact":"+32 2 512 34 21","phone_booking":"+32 2 512 34 21","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50001744"},"fr":{"name":"DE L'\u00c9CLECTISME \u00c1 L'ART NOUVEAU: Victor Van Dyck, artiste d\u00e9corateur 1863-1943","shortdescr":"Du 7 septembre au 28 octobre 2023, d\u00e9couvrez l'oeuvre du peintre-d\u00e9corateur Victor Van Dyck. L'analyse de son parcours et de sa ma\u00eetrise de plusieurs styles, mat\u00e9riaux et techniques \u00e9claircissent le processus de transition artistique qui porte, entre la fin du XIX\u00e8me et le d\u00e9but du XX\u00e8me si\u00e8cles, \u00e0 l\u2019\u00e9closion et \u00e0 la diffusion de l\u2019Art nouveau.","longdescr":"Plus de 200 dessins, aquarelles et peintures de Victor Van Dyck (1863-1943), conserv\u00e9s par ses h\u00e9ritiers, sont pr\u00e9sent\u00e9s. Ces projets d\u00e9coratifs nous permettent d'aborder plusieurs th\u00e9matiques concernant la formation d\u2019un artiste d\u00e9corateur en Belgique, ainsi que son travail, qui comprenait des commandes pour des lieux publics ou de spectacle (la d\u00e9coration des caf\u00e9s et brasseries sur les grands boulevards bruxellois, celle des th\u00e9\u00e2tres anglais), des commandes priv\u00e9s (notamment des maison bourgeoises), ou publiques (berlines royales pour L\u00e9opold II et Albert I). Cette grande vari\u00e9t\u00e9 de projets nous fera \u00e9galement d\u00e9couvrir les go\u00fbts tr\u00e8s \u00e9clectiques de l'\u00e9poque, qui amalgamaient souvent plusieurs styles diff\u00e9rents : Louis XV, moresque, n\u00e9o-Renaissance flamande, Art nouveau.\n\nLes \u0153uvres pr\u00e9sent\u00e9es \u00e0 l'Association constituent un ensemble rare et coh\u00e9rent qui soulignent le degr\u00e9 de versatilit\u00e9 artistique dont il fallait faire preuve dans ce m\u00e9tier.","performers":"L\u2019exposition De l\u2019\u00c9clectisme \u00e0 l\u2019Art nouveau, Victor Van Dyck (1863-1943), peintre-d\u00e9corateur propose de d\u00e9couvrir les diff\u00e9rentes facettes du m\u00e9tier d\u2019artiste-d\u00e9corateur dans le contexte historique et culturel de l\u2019\u00e9poque. Cette exposition patrimoniale, dont le commisariat est assur\u00e9 par Pierre Loze, directeur scientifique de l\u2019association, est pr\u00e9sent\u00e9e du 7 septembre au 28 octobre 2023.","boxoffice_url":null,"website":"https:\/\/associationdupatrimoineartistique.be\/actualites","email":"as.pat.art@gmail.com","phone_contact":"+32 2 512 34 21","phone_booking":"+32 2 512 34 21","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50001744"},"sp":{"name":"From Eclecticism to Art Nouveau: painter-decorator Victor Van Dyck, 1863-1943","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/associationdupatrimoineartistique.be\/actualites","email":"as.pat.art@gmail.com","phone_contact":"+32 2 512 34 21","phone_booking":"+32 2 512 34 21","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50001744"},"nl":{"name":"Van Eclecticisme tot Art nouveau. Victor Van Dyck (1863-1943), kunstschilder-decorateur.","shortdescr":"Ontdek van 7 september tot 28 oktober 2023 het werk van schilder-decorateur Victor Van Dyck. De analyse van zijn carri\u00e8re en zijn beheersing van verschillende stijlen, materialen en technieken werpen licht op het proces van artistieke transitie dat tussen het einde van de 19e en het begin van de 20e eeuw leidde tot de opkomst en verspreiding van de Art Nouveau.","longdescr":"Bewaard door zijn erfgenamen, worden hier ruim 200 tekeningen, aquarellen en schilderijen van Victor Van Dyck (1863-1943) gepresenteerd. Het zijn decoratieve projecten die ons toelaten om verschillende thema's te bewandelen, zoals die rond de toenmalige opleiding van decoratieve kunstenaars in Belgi\u00eb. Maar ook andere, gelinkt aan het werk van Van Dijck, waaronder opdrachten voor openbare locaties, zoals concertzalen in Brussel (decoratie van caf\u00e9s en brasseries aan de grote boulevards), voor Engelse theaters en koninklijke sedans (voor Leopold II en Albert I), maar ook particuliere bestellingen (met name burgerlijke woningen). De grote verscheidenheid aan projecten laat ons ook toe, het kennismaken met de zeer eclectische smaak van die tijd, waarin vaak verschillende stijlen fusioneren: Lodewijk XV, Moresque, Vlaamse neorenaissance, Art Nouveau.\n\nDe werken die in onze Vereniging worden gepresenteerd, vormen een zeldzaam en samenhangend ensemble, dat het artistiek veelzijdig meesterschap onderstreept dat nodig was om dit beroep uit te voeren.","performers":"De tentoonstelling \"Van Eclecticisme tot Art nouveau\", over de kunstschilder-decorateur Victor Van Dyck laat u de verschillende facetten van zijn beroep ontdekken, in de historische en culturele context van zijn tijd. Deze tentoonstelling is samengesteld door Pierre Loze, de wetenschappelijk directeur van de vereniging, en wordt gepresenteerd van 7 september tot 28 oktober 2023.","boxoffice_url":null,"website":"https:\/\/associationdupatrimoineartistique.be\/actualites","email":"as.pat.art@gmail.com","phone_contact":"+32 2 512 34 21","phone_booking":"+32 2 512 34 21","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50001744"}},"place":{"id":243535,"translations":{"de":{"name":"Association du Patrimoine Artistique asbl","address_street_name":"Rue Charles Hanssens","address_street_number":"7","address_street_box":null,"email":