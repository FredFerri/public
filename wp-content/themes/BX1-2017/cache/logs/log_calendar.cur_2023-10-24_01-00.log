l,"booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"91\u00e8me parall\u00e8le","address_street_name":"Rue Gaucheret","address_street_number":"4","address_street_box":"B73","email":"info@91parallele.be","website":"https:\/\/91parallele.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Rue Gaucheret, 4 \/ B73","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"91\u00e8me parall\u00e8le","address_street_name":"Rue Gaucheret","address_street_number":"4","address_street_box":"B73","email":"info@91parallele.be","website":"https:\/\/91parallele.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Rue Gaucheret, 4 \/ B73","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"fr":{"name":"91\u00e8me parall\u00e8le","address_street_name":"Rue Gaucheret","address_street_number":"4","address_street_box":"B73","email":"info@91parallele.be","website":"https:\/\/91parallele.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Rue Gaucheret, 4 \/ B73","address_line2":"1030 Schaerbeek","description_web":"Avec les guides de 91eme parall\u00e8le, prenez de la hauteur, d\u00e9couvrez des territoires inconnus, embarquez dans des voyages au c\u0153ur de l\u2019Histoire, des l\u00e9gendes, de l\u2019architecture, de la musique... toujours avec ce petit point de vue d\u00e9cal\u00e9 qui fait leur marque de fabrique. Pourquoi 91\u00e8me parall\u00e8le ? Horizontalement, chaque h\u00e9misph\u00e8re terrestre est divis\u00e9 en cercles imaginaires reliant les lieux se trouvant sur une m\u00eame latitude. L\u2019\u00e9quateur est le point 0, les P\u00f4le nord et sud sont les 90eme parall\u00e8les.\nIl n'y a donc pas de 91eme parall\u00e8le...Un nom d'\u00e9quipe est un peu loufoque, un v\u00e9ritable petit clin d\u2019\u0153il au surr\u00e9alisme belge !\n\n\nVisites publiques et priv\u00e9es, pour petits et grands, jeunes et moins jeunes. Tous nos \"voyages\" sont repris dans l'agenda en ligne sur notre site internet.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"91\u00e8me parall\u00e8le","address_street_name":"Rue Gaucheret","address_street_number":"4","address_street_box":"B73","email":"info@91parallele.be","website":"https:\/\/91parallele.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Rue Gaucheret, 4 \/ B73","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"91\u00e8me parall\u00e8le","address_street_name":"Gaucheretstraat","address_street_number":"4","address_street_box":"B73","email":"info@91parallele.be","website":"https:\/\/91parallele.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Gaucheretstraat, 4 \/ B73","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":41178,"location":{"lat":50.8624095,"lon":4.3601281},"last_updated_at":"2023-09-05T10:40:01+02:00","published_at":"2023-08-28T11:27:17+02:00","is_in_address_book":true,"is_in_vb_export":false,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[],"dates":[{"day":"2023-10-29","doors":null,"start":"14:00:00","end":"16:00:00","is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"de":{"name":"Normal"},"en":{"name":"Normal"},"it":{"name":"Normale"},"fr":{"name":"Normal"},"sp":{"name":"Normal"},"nl":{"name":"Normaal"}},"value":15},{"