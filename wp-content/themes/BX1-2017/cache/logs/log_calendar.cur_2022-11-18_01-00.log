,"last_updated_at":"2022-11-09T04:35:05+01:00","published_at":"2022-11-08T17:51:21+01:00","backoffice_id":265348,"import_origin":null,"sub_type":"misc","show_in_agenda":true,"ranking":0.2974441746295},{"id":544181,"date_start":"2022-11-26","date_end":"2022-11-26","date_next":"2022-11-26","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert","de":"Konzert"}},"others":{"list":[2],"translations":{"fr":["Classique"],"nl":["Klassiek"],"en":["Classical"],"de":["Klassisch"]}}},"languages":{"spoken":["en","fr"],"subtitles":[]},"translations":{"fr":{"name":"ELIAS - Felix Mendehlsson","shortdescr":"ELIAS - Felix Mendehlsson\r\n\r\nBrussels Choral Society, Arti Vocali & Brussels Philharmonic Orchestra","longdescr":"Brussels Choral Society, Arti Vocali & Brussels Philharmonic Orchestra\r\n\r\nL\u2019oratorio de Felix Mendelssohn sur le proph\u00e8te Elias est un favori des ch\u0153urs et du public depuis que le compositeur lui-m\u00eame a dirig\u00e9 la premi\u00e8re (en anglais) au Festival de Birmingham en 1846.\r\n\r\nL\u2019oratorio se veut le portrait vivant d\u2019Elias. L\u2019\u0153uvre d\u00e9bute par Elias annon\u00e7ant une mal\u00e9diction apportant une s\u00e9cheresse sur les Isra\u00e9lites infid\u00e8les. Il les exhorte \u00e0 renoncer \u00e0 l\u2019adoration des idoles du dieu Baal, promu par le roi Achab et \u00e0 tourner leur foi vers le Seigneur. Le d\u00e9sespoir, la cruaut\u00e9, le soulagement et la mis\u00e9ricorde jouent tous leur r\u00f4le dans l\u2019histoire jusqu\u2019\u00e0 ce que la tourmente soit finalement r\u00e9solue.\r\n\r\nPour interpr\u00e9ter ce chef-d\u2019\u0153uvre, la Brussels Choral Society s\u2019associe \u00e0 Arti Vocali d\u2019Anvers et \u00e0 l\u2019Orchestre Philharmonique de Bruxelles, sous la baguette d\u2019Eric Delson.","performers":"Solistes:\r\nHendrickje van Kerckhove, soprano\r\nInez Carsauw, alto\r\nDenzil Delaere, t\u00e9nor\r\nRaimund Nolte, basse\r\n\r\nEric Delson, direction","boxoffice_url":null,"website":"https:\/\/www.bozar.be\/fr\/calendrier\/felix-mendelssohn-elias-op70","email":"communications@brusselschoralsociety.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.544181"},"nl":{"name":"ELIAS - Felix Mendehlsson","shortdescr":"ELIAS - Felix Mendehlsson\r\n\r\nBrussels Choral Society, Arti Vocali & Brussels Philharmonic Orchestra","longdescr":"Brussels Choral Society, Arti Vocali & Brussels Philharmonic Orchestra\r\nHet oratorium van Felix Mendelssohn over de profeet Elias is een favoriet bij koren en publiek sinds de componist zelf de premi\u00e8re (in het Engels) dirigeerde op het Birmingham Festival in 1846.\r\n\r\nHet oratorium is een levendig portret van Elias, die het stuk opent met een vloek die een droogte over de ongelovige Isra\u00eblieten brengt. Hij spoort hen aan om afstand te doen van de afgoderij van de god Ba\u00e4l, vereerd door koning Achab, en terug te keren naar de Heer. Wanhoop, wreedheid, opluchting en barmhartigheid spelen allemaal een rol in het verhaal totdat de rust eindelijk wederkeert.\r\n\r\nOm dit meesterwerk uit te voeren, zal de Brussels Choral Society onder leiding van Eric Delson de krachten bundelen met Arti Vocali uit Antwerpen en met het Brussels Philharmonic Orchestra.","performers":"Solisten:\r\nHendrickje van Kerckhove, sopraan\r\nInez Carsauw, alt\r\nDenzil Delaere, tenor\r\nRaimund Nolte, bas\r\n\r\nEric Delson, leiding","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.544181"},"en":{"name":"ELIAS - Felix Mendehlsson","shortdescr":"ELIAS - Felix Mendehlsson\r\n\r\nBrussels Choral Society, Arti Vocali & Brussels Philharmonic Orchestra","longdescr":"Brussels Choral Society, Arti Vocali & Brussels Philharmonic Orchestra\r\n\r\nFelix Mendelssohn\u2019s oratorio about the prophet Elias has remained a favourite of choirs and audiences ever since the composer himself conducted the premiere (in English) at the Birmingham Festival in 1846.\r\n\r\nThe oratorio is the vivid portrayal of Elias, who opens the piece with a curse bringing a drought upon the faithless Israelites. He urges them to renounce the idol worship of the god Baal, promoted by King Ahab, and to return to the Lord. Despair, cruelty, relief and mercy all play their part in the story until the turmoil is finally resolved.\r\n\r\nTo perform this masterpiece, the Brussels Choral Society will join forces with Arti Vocali from Antwerp and with the Brussels Philharmonic Orchestra, under the baton of Eric Delson.","performers":"Soloists:\r\nHendrickje van Kerckhove, soprano\r\nInez Carsauw, alto\r\nDenzil Delaere, tenor\r\nRaimund Nolte, bass\r\n\r\nEric Delson, conductor","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.544181"},"de":{"name":"ELIAS - Felix Mendehlsson","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.544181"},"it":{"name":"ELIAS - Felix Mendehlsson","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.544181"},"sp":{"name":"ELIAS - Felix Mendehlsson","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.544181"},"pt":{"name":"ELIAS - Felix Mendehlsson","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.544181"},"cn":{"name":"ELIAS - Felix Mendehlsson","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.544181"}},"place":{"id":63,"translations":{"fr":{"name":"Palais des Beaux-Arts - Bozar","address_street_name":"Rue Ravenstein","address_street_number":"23","address_street_box":null,"email":"info@bozar.be","website":"http:\/\/www.bozar.be","phone_contact":"+32 2 507 82 00","phone_booking":"+32 2 507 82 00","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Ravenstein, 23","address_line2":"1000 Bruxelles","description_web":"Lorsqu\u2019on parle de la culture en Belgique, on pense forc\u00e9ment au Palais des Beaux-Arts de Bruxelles. Qu\u2019il s\u2019agisse d\u2019expositions, de concerts, de th\u00e9\u00e2tre ou de cin\u00e9ma, de projets autour de la litt\u00e9rature et d\u2019architecture, BOZAR met toujours en avant l\u2019originalit\u00e9 et l\u2019innovation. Non seulement ils mettent un point d\u2019honneur \u00e0 la cr\u00e9ation, la qualit\u00e9 et la richesse du programme artistique, mais se pr\u00e9occupent surtout d\u2019offrir une exp\u00e9rience totale \u00e0 ses visiteurs.","description_print":"Lorsqu\u2019on parle de la culture en Belgique, on pense forc\u00e9ment au Palais des Beaux-Arts de Bruxelles. Qu\u2019il s\u2019agisse d\u2019expositions, de concerts, de th\u00e9\u00e2tre ou de cin\u00e9ma, de projets autour de la litt\u00e9rature et d\u2019architecture, BOZAR met toujours en avant l\u2019originalit\u00e9 et l\u2019innovation. Non seulement ils mettent un point d\u2019honneur \u00e0 la cr\u00e9ation, la qualit\u00e9 et la richesse du programme artistique, mais se pr\u00e9occupent surtout d\u2019offrir une exp\u00e9rience totale \u00e0 ses visiteurs.","booking_url":null,"sort_order":"Bozar","virtual_visit":null},"nl":{"name":"Paleis voor Schone Kunsten - Bozar","address_street_name":"Ravensteinstraat","address_street_number":"23","address_street_box":null,"email":"info@bozar.be","website":"http:\/\/www.bozar.be","phone_contact":"+32 2 507 82 00","phone_booking":"+32 2 507 82 00","address_zip":"1000","address_city":"Brussel","address_line1":"Ravensteinstraat, 23","address_line2":"1000 Brussel","description_web":"Als je in Belgi\u00eb over cultuur spreekt, dan kun je niet om het Paleis voor Schone Kunsten in Brussel heen. Of het nu gaat om tentoonstellingen, concerten, theater- en filmvoorstellingen, projecten rond literatuur en architectuur, steeds stelt Bozar originaliteit en vernieuwing voorop. Ze bewijzen dat ze de vinger aan de pols hebben met hun gevarieerd en uitgekiend programma. Niet alleen creatie, kwaliteit en een rijk artistiek aanbod draagt de zorg weg. Bij Bozar zijn ze bekommerd om de totaalervaring. Het imposante en tegelijk intieme gebouw - van de hand van Horta- heeft een bevreemdende schoonheid.","description_print":"Als je in Belgi\u00eb over cultuur spreekt, dan kun je niet om het Paleis voor Schone Kunsten in Brussel heen. Of het nu gaat om tentoonstellingen, concerten, theater- en filmvoorstellingen, projecten rond literatuur en architectuur, steeds stelt Bozar originaliteit en vernieuwing voorop. Ze bewijzen dat ze de vinger aan de pols hebben met hun gevarieerd en uitgekiend programma. Niet alleen creatie, kwaliteit en een rijk artistiek aanbod draagt de zorg weg. Bij Bozar zijn ze bekommerd om de totaalervaring. Het imposante en tegelijk intieme gebouw - van de hand van Horta- heeft een bevreemdende schoonheid.","booking_url":null,"sort_order":"Bozar","virtual_visit":null},"en":{"name":"Centre for Fine Arts - Bozar","address_street_name":"Rue Ravenstein","address_street_number":"23","address_street_box":null,"email":"info@bozar.be","website":"http:\/\/www.bozar.be","phone_contact":"+32 2 507 82 00","phone_booking":"+32 2 507 82 00","address_zip":"1000","address_city":"Brussels","address_line1":"Rue Ravenstein, 23","address_line2":"1000 Brussels","description_web":"It\u2019s impossible to talk about culture in Belgium without mentioning the Centre for Fine Arts located in Brussels. Whether it comes to exhibitions, concerts, theater performances, movies or projects concerning literature and architecture, BOZAR will always put originality and innovation first. They prove to keep a finger on the pulse with their varied and sophisticated programme. Besides emphasizing the importance of creation, quality and a rich artistic offering, BOZAR is especially concerned about the total experience of the visitors.","description_print":"It\u2019s impossible to talk about culture in Belgium without mentioning the Centre for Fine Arts located in Brussels. Whether it comes to exhibitions, concerts, theater performances, movies or projects concerning literature and architecture, BOZAR will always put originality and innovation first. They prove to keep a finger on the pulse with their varied and sophisticated programme. Besides emphasizing the importance of creation, quality and a rich artistic offering, BOZAR is especially concerned about the total experience of the visitors.","booking_url":null,"sort_order":"Bozar","virtual_visit":null},"de":{"name":"Palais des Beaux-Arts - Bozar","address_street_name":"Rue Ravenstein","address_street_number":"23","address_street_box":null,"email":"info@bozar.be","website":"http:\/\/www.bozar.be","phone_contact":"+32 2 507 82 00","phone_booking":"+32 2 507 82 00","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Ravenstein, 23","address_line2":"1000 Bruxelles","description_web":"Das Br\u00fcsseler BOZAR z\u00e4hlt zu den dynamischsten und hochkar\u00e4tigsten Kultur- und Kunstzentren der belgischen Kulturlandschaft. Das Art D\u00e9co-Meisterwerk aus der Feder Victor Hortas ist zudem einer der gro\u00dfen architektonischen Sch\u00e4tze Br\u00fcssels.\r\nKultur, Kultur und noch mehr Kultur! Auf mehr als 4 000 Quadratmetern gibt es Konzerte, Ausstellungen, Theater, Tanz, Literatur, Konferenzen und Filmvorf\u00fchrungen unter einem Dach zu sehen.\r\n\r\nF\u00fcr Musikinteressierte reicht das Angebot von Weltmusik \u00fcber Electronic DJs bis hin zum klassischen Symphonieorchester. Kunst- und Literaturliebhaber kommen mit zeitgen\u00f6ssischen, avantgardistischen und klassischen Kunst- und Gem\u00e4ldeausstellungen, der Fotobiennale Summer of Photography, mehrsprachigen Theaterinszenierungen, Brussels Short Film Festival, Book Clubs in franz\u00f6sischer und fl\u00e4mischer Version oder auch Architekturkonferenzen auf ihre Kosten.\r\n\r\nBOZAR-Brasserie:\r\nKulturinteressierte Genie\u00dfer k\u00f6nnen sich in der BOZAR-Brasserie von dem franz\u00f6sischen Chefkoch David Martin mit Men\u00fcs verw\u00f6hnen lassen, die dem kulturellen Angebot in nichts nachstehen. Die Brasserie ist Teil eines umfassenden Restaurierungs- und Renovierungsprogramms, sie wurde nach dem Vorbild der Original-Horta-Brasserie gestaltet. Von dem Gourmetf\u00fchrer Gault&Millau 2013 wurde sie \u00fcbrigens zur \u201eBrasserie des Jahres\" gew\u00e4hlt! \r\n\r\nBozar Caf\u00e9 Victor\r\nFr\u00fchst\u00fcck, Mittag- oder Abendessen vor oder nach dem Ausstellungs- oder Konzertbesuch k\u00f6nnen im Caf\u00e9 Victor eingenommen werden. Gro\u00dfe Fensterfronten, puristisches Design, edle Lederb\u00e4nke, spektakul\u00e4re Leuchten und feine Snacks und Speisen ergeben ein harmonisches Ensemble.\r\n","description_print":"","booking_url":null,"sort_order":"Bozar","virtual_visit":null},"it":{"name":"Palazzo delle Belle Arti - Bozar","address_street_name":"Rue Ravenstein","address_street_number":"23","address_street_box":null,"email":"info@bozar.be","website":"http:\/\/www.bozar.be","phone_contact":"+32 2 507 82 00","phone_booking":"+32 2 507 82 00","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Ravenstein, 23","address_line2":"1000 Bruxelles","description_web":"BOZAR il Palazzo delle Belle Arti, centro d'arte per eccellenza del panorama culturale belga, offre un programma internazionale nel cuore di Bruxelles.\r\n\r\nL'edificio \u00e8 un gioiello del patrimonio architettonico del Belgio. E' stato realizzato da Victor Horta in stile Art Nouveau nel 1920.\r\n\r\nIl Bozar \u00e8 un centro d'arte attivo e dinamico che accoglie ogni anno pi\u00f9 di un milione di visitatori: 4.000 m\u00b2 di spazi espositivi, una grandiosa sala concerti, una sala per musica da camera, due piccoli teatri, tre nuove sale multimediali, il BOZAR SHOP, la BOZAR BRASSERIE e la Cinemateca Reale, famosa in tutto il mondo per la sua collezione di grande valore.\r\n\r\n\r\nLa BOZAR BRASSERIE vi aspetta con il suo chef stellato David Martin. Prenotazioni, solo per telefono, al n\u00b0 +32 (0)2 503 00 00. Aperto 7 giorni su 7, dalle 12 alle 23.\r\n\r\nVisitate anche il BOZARSHOP: migliaia di libri d'arte, CD, DVD, idee regalo.\r\nSpazio giochi per i vostri bambini.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Palacio de las Bellas Artes - Bozar","address_street_name":"Rue Ravenstein","address_street_number":"23","address_street_box":null,"email":"info@bozar.be","website":"http:\/\/www.bozar.be","phone_contact":"+32 2 507 82 00","phone_booking":"+32 2 507 82 00","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Ravenstein, 23","address_line2":"1000 Bruxelles","description_web":"El Bozar, el Palacio de las Bellas Artes, es el centro de arte por excelencia del paisaje cultural belga. \r\n\r\nEl Palacio de las Bellas Artes de Bruselas ofrece un programa cultural y art\u00edstico. Es uno de los n\u00facleos art\u00edsticos m\u00e1s din\u00e1micos de B\u00e9lgica, con 1 mill\u00f3n de visitas al a\u00f1o. \r\n\r\nEn el programa: exposiciones, m\u00fasica, danza, teatro, cine, literatura o arquitectura para peque\u00f1os y no tan peque\u00f1os. \r\n\r\nEl edificio constituye una de las obras maestras del patrimonio arquitect\u00f3nico de B\u00e9lgica. \r\n\r\nEste Palacio Art D\u00e9co lo ide\u00f3 el arquitecto Victor Horta en 1920 e incluye:\r\n\r\n- M\u00e1s de 4.000 m\u00b2 espacios de exposici\u00f3n\r\n- La Sala Henry le B\u0153uf, es decir, una magn\u00edfica sala de conciertos\r\n- 1 sala de m\u00fasica de c\u00e1mara\r\n- 2 peque\u00f1os teatros y 3 nuevas salas multimedia\r\n- La Bozar Brasserie y la cocina innovadora del chef galardonado David Martin\r\n- La Cinemateca Real y su indiscutible colecci\u00f3n internacionalmente conocida\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Centro de Belas Artes \u2014 Bozar","address_street_name":"Rue Ravenstein","address_street_number":"23","address_street_box":null,"email":"info@bozar.be","website":"http:\/\/www.bozar.be","phone_contact":"+32 2 507 82 00","phone_booking":"+32 2 507 82 00","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Ravenstein, 23","address_line2":"1000 Bruxelles","description_web":"Ao falar da cultura belga, \u00e9 obrigat\u00f3rio mencionar o Pal\u00e1cio de Belas Artes de Bruxelas. Quer sejam exposi\u00e7\u00f5es, concertos, teatro, cinema ou projetos liter\u00e1rios e arquitet\u00f3nicos, BOZAR coloca sempre em primeira linha a originalidade e inova\u00e7\u00e3o. N\u00e3o s\u00f3 enfatiza a cria\u00e7\u00e3o, qualidade e riqueza do programa art\u00edstico, mas preocupa-se sobretudo em oferecer uma experi\u00eancia completa aos seus visitantes.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Palais des Beaux-Arts - Bozar","address_street_name":"Rue Ravenstein","address_street_number":"23","address_street_box":null,"email":"info@bozar.be","website":"http:\/\/www.bozar.be","phone_contact":"+32 2 507 82 00","phone_booking":"+32 2 507 82 00","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Ravenstein, 23","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[16],"translations":{"fr":["Quartier Royal"],"nl":["Koninklijke wijk"],"en":["Royal"]}},"zones":{"list":[19],"translations":{"fr":["Centre"],"nl":["Centrum"],"en":["Centre"]}},"neca":"art_center","facebook_id":null,"backoffice_id":13,"location":{"lat":50.8442214,"lon":4.35950594},"region":"brussels","last_updated_at":"2022-10-17T09:05:06+02:00","published_at":"2013-10-19T01:13:13+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":244123,"translations":{"fr":{"name":"BCS - Brussels Choral Society","address_street_name":"Rue des Aduatiques","address_street_number":"48","address_street_box":null,"email":null,"website":"http:\/\/www.brusselschoralsociety.com","phone_contact":null,"phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Rue des Aduatiques, 48","address_line2":"1040 Etterbeek","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"BCS - Brussels Choral Society","address_street_name":"Aduatukersstraat","address_street_number":"48","address_street_box":null,"email":null,"website":"http:\/\/www.brusselschoralsociety.com","phone_contact":null,"phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Aduatukersstraat, 48","address_line2":"1040 Etterbeek","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"BCS - Brussels Choral Society","address_street_name":"Rue des Aduatiques"