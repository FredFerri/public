":"17:00:00"},{"day":"2022-09-03","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2022-10-01","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2022-11-05","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2022-12-03","doors":null,"start":"10:00:00","end":"17:00:00"},{"day":"2023-01-07","doors":null,"start":"10:00:00","end":"17:00:00"}],"recurring":[{"day":"saturday","occurences":{"is_first":true,"is_second":false,"is_third":false,"is_fourth":false,"is_last":false},"time_start":"10:00:00","time_end":"17:00:00","translations":{"fr":"Ouvert le premier samedi du mois de 10:00 \u00e0 17:00","nl":"Open op de eerste zaterdag van de maand van 10:00 tot 17:00","en":"Open the first saturday of the month from 10:00 to 17:00"}}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":0},{"translations":{"fr":{"name":"Enfants"},"nl":{"name":"Kinderen"},"en":{"name":"Children"}},"value":0}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-11-08T14:35:04+01:00","published_at":"2021-10-11T16:30:18+02:00","backoffice_id":240858,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.12926263449024},{"id":518572,"date_start":"2021-10-02","date_end":"2023-09-09","date_next":"2022-12-03","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen"}},"others":{"list":[105],"translations":{"fr":["Gastronomie"],"nl":["Gastronomie"],"en":["Gastronomy"],"de":["Gastronomie"]}}},"languages":{"spoken":["fr","en"],"subtitles":[]},"translations":{"fr":{"name":"Discovery Coffee Tours","shortdescr":"Lors de ce Discovery Coffee Tour, vous go\u00fbterez diff\u00e9rentes m\u00e9thodes de pr\u00e9paration embl\u00e9matiques dans des lieux surprenants. Donn\u00e9 en FR & EN.","longdescr":"DISCOVERY COFFEE TOUR\r\n\r\nLors de ce Discovery Coffee Tour, vous go\u00fbterez diff\u00e9rentes m\u00e9thodes de pr\u00e9paration embl\u00e9matiques dans des lieux surprenants. \r\n\r\nCaf\u00e9 serr\u00e9, allong\u00e9, filtre, lact\u00e9, froid, fantaisie, traditionnel ou parfois exp\u00e9rimental\u2026 soyez pr\u00eat.e !\r\n\r\n- 6 lieux innovants (parfois un peu plus ou un peu moins selon le quartier)\r\n- 4h de conseils et de fun\r\n- 1 exp\u00e9rience de quartier unique autour des diff\u00e9rentes m\u00e9thodes de pr\u00e9paration du caf\u00e9\r\n\r\n\u00c0 la fin du Discovery Coffee Tour, vous en saurez un peu plus sur\r\n- le Caf\u00e9 de Sp\u00e9cialit\u00e9, ses terroirs et ses valeurs\r\n- comment go\u00fbter et appr\u00e9cier un bon caf\u00e9\r\n- o\u00f9 consommer dans votre quartier pr\u00e9f\u00e9r\u00e9\r\n- des m\u00e9thodes de pr\u00e9paration savoureuses\r\n- comment am\u00e9liorer votre caf\u00e9 chez vous\r\n\r\nPour qui ?\r\nLes Discovery Coffee Tours s\u2019adressent aux amateur.ices de caf\u00e9, mais aussi aux professionnel.les de l\u2019horeca et aux amateur.ices de th\u00e9 (surprise garantie) !\r\n\r\nLes Coffee Tours durent en moyenne 4h, se passent totalement en ext\u00e9rieur (bien s\u2019habiller en cons\u00e9quence!!) et ne se terminent pas au point de d\u00e9part. \r\n\r\nPlus d\u2019infos pratiques lors de la r\u00e9servation.\r\n\r\nD\u00e9couvrez, go\u00fbtez, appr\u00e9ciez\u2026 recommencez !","performers":null,"boxoffice_url":null,"website":"http:\/\/www.okcoffee.tips","email":"thomas@okcoffee.tips","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.518572"},"nl":{"name":"Discovery Coffee Tours","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.518572"},"en":{"name":"Discovery Coffee Tours","shortdescr":"During the Discovery Coffee Tours, you will experience iconic ways of making and drinking coffee in surprising locations. Hosted in FR & EN.","longdescr":"DISCOVERY COFFEE TOUR\r\n\r\nDuring the Discovery Coffee Tours, you will experience iconic ways of making and drinking coffee in surprising locations.\r\n\r\nShort, long, filter, milky, cold, fancy, traditional or sometimes experimental coffee... be prepared!\r\n\r\n- 6 innovative places (sometimes a little more or a little less depending on the neighborhood)\r\n- 4 hours of tips and fun\r\n- 1 unique neighborhood experience around the different methods of coffee preparation\r\n\r\nAt the end of the Discovery Coffee Tour, you'll know a little more about\r\n- Specialty coffee, its terroirs and its values\r\n- how to taste and appreciate a good coffee\r\n- where to drink in your favorite neighborhood\r\n- tasty preparation methods\r\n- how to improve your coffee at home\r\n\r\nWho is it for?\r\nThe Discovery Coffee Tours are aimed at coffee lovers, but also at horeca professionals and tea lovers (surprise guaranteed)!\r\n\r\nThe Coffee Tours last on average 4 hours, are totally outdoor (dress accordingly!!) and do not end at the starting point. \r\n\r\nMore practical information when you make your reservation.\r\n\r\nDiscover, taste, enjoy... repeat!","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.518572"},"de":{"name":"DISCOVER & TASTE Coffee Tour - Downtown Kanaal, Brussels","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.518572"},"it":{"name":"DISCOVER & TASTE Coffee Tour - Downtown Kanaal, Brussels","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.518572"},"sp":{"name":"DISCOVER & TASTE Coffee Tour - Downtown Kanaal, Brussels","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.518572"},"pt":{"name":"DISCOVER & TASTE Coffee Tour - Downtown Kanaal, Brussels","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.518572"},"cn":{"name":"DISCOVER & TASTE Coffee Tour - Downtown Kanaal, Brussels","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.518572"}},"place":{"id":279609,"translations":{"fr":{"name":"Bruxelles Centre","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Bruxelles Centre","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Bruxelles Centre","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Brux