ite":"https:\/\/www.pierredelune.be\/spectacles\/discussion-debat-autour-de-l-affaire-costalamone.html","email":"contact@pierredelune.be","phone_contact":"+32 2 218 79 35","phone_booking":"+32 2 218 79 35","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700004482"},"it":{"name":"Discussion \/ d\u00e9bat autour du spectacle \"L'affaire Costalamone\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.pierredelune.be\/spectacles\/discussion-debat-autour-de-l-affaire-costalamone.html","email":"contact@pierredelune.be","phone_contact":"+32 2 218 79 35","phone_booking":"+32 2 218 79 35","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700004482"},"cn":{"name":"Discussion \/ d\u00e9bat autour du spectacle \"L'affaire Costalamone\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.pierredelune.be\/spectacles\/discussion-debat-autour-de-l-affaire-costalamone.html","email":"contact@pierredelune.be","phone_contact":"+32 2 218 79 35","phone_booking":"+32 2 218 79 35","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700004482"},"fr":{"name":"Discussion \/ d\u00e9bat autour du spectacle \"L'affaire Costalamone\"","shortdescr":"Nous invitons les enseignant\u00b7e\u00b7s et futur\u00b7e\u00b7s enseignant\u00b7e\u00b7s \u00e0 d\u00e9couvrir le spectacle \"L\u2019affaire Costalamone\" et \u00e0 participer \u00e0 une discussion \/ d\u00e9bat autour de la th\u00e9matique de la violence. ","longdescr":"Quelles sont les origines de la violence dans notre soci\u00e9t\u00e9 ?  \nDans les \u00e9tablissements scolaires ? \nComment y faire face ? \nQuel r\u00f4le et responsabilit\u00e9 portons-nous devant les m\u00e9canismes de la violence ? \n \nCe sont certaines des questions que nous vous proposons de mettre en d\u00e9bat, en lien avec le spectacle L\u2019affaire Costalamone. \n \nL\u2019affaire Costalamone est une adaptation th\u00e9\u00e2trale du texte de Guillaume Gueraud, Je mourrai pas gibier : un r\u00e9cit fictionnel document\u00e9 qui relate comment, dans un village o\u00f9 deux clans s\u2019affrontent, des meurtres violents sont commis. \n \nNous vous proposons un espace de paroles et d\u2019\u00e9changes sur ce sujet sp\u00e9cialement destin\u00e9 aux enseignant\u00b7e\u00b7s. Il sera nourri par les points de vue \u00e9clair\u00e9s de diverses personnes ressources sp\u00e9cialistes de ces questions : avocats, criminologues, anthropologues, etc.","performers":"Inti Th\u00e9\u00e2tre \/ Intervenants \u00e0 venir.","boxoffice_url":null,"website":"https:\/\/www.pierredelune.be\/spectacles\/discussion-debat-autour-de-l-affaire-costalamone.html","email":"contact@pierredelune.be","phone_contact":"+32 2 218 79 35","phone_booking":"+32 2 218 79 35","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700004482"},"sp":{"name":"Discussion \/ d\u00e9bat autour du spectacle \"L'affaire Costalamone\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.pierredelune.be\/spectacles\/discussion-debat-autour-de-l-affaire-costalamone.html","email":"contact@pierredelune.be","phone_contact":"+32 2 218 79 35","phone_booking":"+32 2 218 79 35","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700004482"},"nl":{"name":"Discussion \/ d\u00e9bat autour du spectacle \"L'affaire Costalamone\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.pierredelune.be\/spectacles\/discussion-debat-autour-de-l-affaire-costalamone.html","email":"contact@pierredelune.be","phone_contact":"+32 2 218 79 35","phone_booking":"+32 2 218 79 35","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700004482"}},"place":{"id":50002707,"translations":{"de":{"name":"Centre Culturel Wolubilis \/ La Bissectine","address_street_name":"Place du Temps Lib