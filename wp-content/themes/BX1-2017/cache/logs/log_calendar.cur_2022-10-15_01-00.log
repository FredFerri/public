d":"18:00:00"}]},"saturday":{"is_open":true,"hours":[{"start":"10:00:00","end":"18:00:00"}]},"sunday":{"is_open":true,"hours":[{"start":"10:00:00","end":"18:00:00"}]}},"translations":{"fr":["lundi: ferm\u00e9","mardi, mercredi, jeudi, vendredi, samedi et dimanche: de 10:00 \u00e0 18:00"],"nl":["maandag: gesloten","dinsdag, woensdag, donderdag, vrijdag, zaterdag en zondag: van 10:00 tot 18:00"],"en":["monday: closed","tuesday, wednesday, thursday, friday, saturday and sunday: from 10:00 to 18:00"]},"date_start":"2022-05-27","date_end":"2023-03-05","is_also_by_appointment":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":12},{"translations":{"fr":{"name":"Enfants"},"nl":{"name":"Kinderen"},"en":{"name":"Children"}},"value":5},{"translations":{"fr":{"name":"Jeunes"},"nl":{"name":"Jongeren"},"en":{"name":"Young people"}},"value":9},{"translations":{"fr":{"name":"Seniors"},"nl":{"name":"Senioren"},"en":{"name":"Seniors"}},"value":9},{"translations":{"fr":{"name":"museumpassmus\u00e9es"},"nl":{"name":"museumpassmus\u00e9es"},"en":{"name":"museumpassmus\u00e9es"}},"value":0},{"translations":{"fr":{"name":"Article 27"},"nl":{"name":"Artikel 27"},"en":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"visit_profile":{"list":[321],"translations":{"fr":["Bande Dessin\u00e9e"],"nl":["Stripverhaal"],"en":["Comic strip"],"de":["Comic"]}},"tags":[],"accessibilities":{"list":[252,255,256,257,259,263,265],"translations":{"fr":["Accessible aux personnes ayant des difficult\u00e9s de compr\u00e9hension","Accessible","Am\u00e9nagements pour les personnes aveugles et malvoyantes","Am\u00e9nagements pour personnes sourdes et malentendantes","Chien d'assistance","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9"],"nl":["Toegankelijk voor mensen met een verstandelijke beperking","Toegankelijk","Voorzieningen voor blinde en slechtziende personen","Voorzieningen voor dove en slechthorende personen","Assistentiehonden","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet"],"en":["Accessible to people with intellectual disabilities","Accessible","Facilities for blind and partially-sighted persons","Facilities for deaf and hearing-impaired people","Assistance dogs","Accessible to pedestrians with mobility aids","Adapted toilet"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-14T01:08:30+02:00","published_at":"2022-05-17T12:21:04+02:00","backoffice_id":253834,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.30462661910109},{"id":541362,"date_start":"2022-09-16","date_end":"2022-10-22","date_next":"2022-10-14","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung"}},"others":{"list":[24,32],"translations":{"fr":["Galeries d'art","Design"],"nl":["Galeries","Design"],"en":["Art Galleries","Design"],"de":["Kunstgalerien","Design"]}}},"languages":{"spoken":["fr","en","nl"],"subtitles":[]},"translations":{"fr":{"name":"B-collective design event","shortdescr":"B-collective est une plateforme pour des talents belges.\r\nUne initiative pour r\u00e9unir des objets fascinants de jeunes designers,\r\nde mettre leur travail fascinant \u00e0 l'honneur.\r\nL'accent est mis sur les articles uniques et les s\u00e9ries limit\u00e9es.\r\nL'esth\u00e9tique sont prioritaires sur la fonctionnalit\u00e9.\r\nNous sommes heureux de partager ce talent belge \u00e9mergent avec le monde entier ...","longdescr":"B-collective est une plateforme de design bruxelloise fond\u00e9e par Sophie Laenen, architecte depuis 1992. La galerie est situ\u00e9e sur la Rue Rouppe au centre de Bruxelles, tout pr\u00e8s de la Grand-Place et du Sablon. Pour B-collective, tout a commenc\u00e9 avec le r\u00eave de \u00ab s\u2019\u00e9chapper un instant \u00bb du monde rigide de l\u2019entreprise d\u2019architecture et de rassembler des gens. En parlant avec des cr\u00e9ateurs, j'ai eu l'id\u00e9e de ne pas me concentrer sur des projets mais sur des personnes et des objets. Il est devenu clair qu'il y a un manque d'espace \u00e0 Bruxelles pour que les jeunes designers puissent exposer leur travail dans un environnement d\u00e9contract\u00e9. L'id\u00e9e de cr\u00e9er une plateforme pour les cr\u00e9atifs belges \u00e9tait devenue un fait. Le contexte et la langue ne jouent aucun r\u00f4le, un m\u00e9lange fascinant cr\u00e9e un dialogue int\u00e9ressant. Les nombreuses conversations avec les designers m'ont emmen\u00e9 dans toutes sortes d'histoires int\u00e9ressantes et j\u2019\u00e9sp\u00e8re que vous devenez \u00e9galement fascin\u00e9. Des histoires sur le recyclage, sur les diff\u00e9rentes mani\u00e8res de traiter les mat\u00e9riaux, sur les projets socio-\u00e9conomiques, sur la modulation, sur le fonctionnel \/ non fonctionnel ... et bien s\u00fbr sur la passion de cr\u00e9er!","performers":"cr\u00e9ateurs participants: Studio Fuho, CHHT en Axelle Vertommen, Timon Mattelaer,  i.s.m. architecten, Manon Clement, Louise Richard, Brukseilas, AMGS, Liesbet Lutin","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.541362"},"nl":{"name":"B-collective design event","shortdescr":"B-collective is een platform voor Belgisch talent.\r\nEen initiatief om fascinerende objecten van jonge ontwerpers bij elkaar te brengen,\r\nhun fascinerend werk in de kijker te zetten.\r\nDe focus ligt op unieke items en gelimiteerde series.\r\nDe esthetiek krijgt voorrang boven functionaliteit.\r\nWe zijn blij dit opkomend Belgisch talent te delen met de wereld\u2026","longdescr":"B-collectief is een Brussels designplatform opgericht door Sophie Laenen, architect sinds 1992. Het bevindt zich in de Rouppestraat in het centrum van Brussel op wandelafstand van de Grote Markt en de Zavel. Voor B-collectief begon het allemaal met de droom \u2018even te ontsnappen\u2019 uit de rigide wereld van het architectenbureau, en mensen bij elkaar te brengen. Door met jonge designers te praten over mogelijke samenwerkingen, kwam ik op het idee om niet op projecten maar op mensen en objecten te focussen. Het werd duidelijk dat er voor Brussel een tekort aan ruimte is voor jonge ontwerpers om hun werk te exposeren in een ongedwongen omgeving. Het idee om een platform te cre\u00ebren voor Belgische creatievelingen werd een feit. Achtergrond en taal spelen geen rol, een fascinerende mix zorgt voor een interessante dialoog. \r\nDe vele gesprekken met ontwerpers voerde me mee in allerlei interessante verhalen en misschien raken jullie ook gefascineerd. Verhalen over recycling, over verschillende manieren om materialen te behandelen, over sociaal-economische projecten, over moduleren, over functioneel \/ niet-functioneel ... en natuurlijk over de passie voor het maken!","performers":"deelnemende designers: Studio Fuho, CHHT en Axelle Vertommen, Timon Mattelaer,  i.s.m. architecten, Manon Clement, Louise Richard, Brukseilas, AMGS, Liesbet Lutin","boxoffice_url":null,"website":"http:\/\/www.b-collective.be","email":"info@b-collective.be","phone_contact":null,"phone_booking":"+32 476 39 71 37","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.541362"},"en":{"name":"B-collective design event","shortdescr":"B-collective is a platform for Belgian creatives.\r\nBringing their fascinating work to be seen.\r\nThe focus is on unique items and limited series.\r\nThe monumental form and aesthetics are given priority over functionality.\r\nExperiments with materials and techniques that lead to objects that surprises and moves.\r\nWe are happy sharing these upcoming talents who are proud to be Belgian\u2026","longdescr":"B-collective is a Brussels-based design initiative by Sophie Laenen, architect since 1992.\r\nIt is located in the Rouppestraat in the centre of Brussels on walking distance of the Grande Place and the Sablon. \r\nFor B-collective it all started with the dream \u2018escaping for a little while\u2019 from the rigid world of the architectural office, and bringing people together.\r\nTalking with designers about possible collaborations, brought me on the idea of bringing the focus not on projects but on people and objects.\r\nIt became clear that for Brussels there is a leak of space for young designers to exhibit their work in an unforced environment. The idea of creating a platform for Belgian creatives became a fact. \r\nOf course, background and language doesn\u2019t matter, a fascinating mixture brings interesting dialogue.\r\nVisiting and talking to al the designers brought me into all kind of interesting stories and maybe it will carry you along. \r\nStories about recycling, about treating materials in different ways, about social-economic projects, about modulating, about functional\/non-functional \u2026\r\nand of course, about the passion for making!","performers":"designers: Studio Fuho, CHHT en Axelle Vertommen, Timon Mattelaer,  i.s.m. architecten, Manon Clement, Louise Richard, Brukseilas, AMGS, Liesbet Lutin","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.541362"},"de":{"name":"B-collective design event","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.541362"},"it":{"name":"B-collective design event","shortdescr":null,"longdescr":null,"performers":nul