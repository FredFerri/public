z","Barrierefreies WC"],"it":["Parcheggio accessibile","WC idoneo"],"sp":["Estacionamiento habilitado","Ba\u00f1os adaptados"],"pt":[null,null],"cn":[null,null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2023-02-18T06:05:47+01:00","published_at":"2023-02-03T10:49:39+01:00","backoffice_id":270917,"import_origin":null,"sub_type":"other","show_in_agenda":true,"ranking":1.5874010519682},{"id":550686,"date_start":"2023-03-18","date_end":"2023-03-18","date_next":"2023-03-18","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater","it":"Teatro","sp":"Teatro","pt":null,"cn":null}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"],"de":["Theater"],"it":["Teatro"],"sp":["Teatro"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Tout\/rien (Cie Modo Grosso)","shortdescr":"Ici, dans l\u2019obscurit\u00e9, tout peut advenir, mais ce n\u2019est rien.","longdescr":"La sc\u00e8ne est intime. Le public s\u2019installe au plus pr\u00e8s du jongleur, \u00e0 moins qu\u2019il ne soit magicien ou alchimiste ? C\u2019est que son \u201cpetit cirque\u201d d\u2019objets \u2013 tricots, chainettes, pierres... \u2013 d\u00e9fie les lois de la gravit\u00e9 et se lib\u00e8re de celles du temps. Ainsi, les chainettes semblent s\u2019animer d\u2019une volont\u00e9 propre, les aimants d\u00e9vient le sens commun, le frottement de deux pierres nous emm\u00e8ne aux tr\u00e9fonds des myst\u00e8res de l\u2019univers. \u00c0 moins que ce ne soit nous qui flottions dans d\u2019autres temporalit\u00e9s.\r\nD\u2019une beaut\u00e9 fascinante, Tout\/rien arr\u00eate le temps qui passe, l\u2019\u00e9tire ou le tord, se joue de nos perceptions et brave l\u2019\u00e9vidence. Invisible et palpable, le rien est tout et vice versa, qui nous subjugue de bout en bout.","performers":"De et avec Alexis Rouvre. Conseil artistique : Jani Nuutinen. Musique : Lo\u00efc Bescond. Regard complice : Angela Malvasi. Conception et construction du gradin : Jean-Marc Billon et Jani Nuutinen (Circo Aereo). Construction sc\u00e9nographie : Sylvain Formatch\u00e9 et Alexis Rouvre. Conseil technique et r\u00e9gie g\u00e9n\u00e9rale : Hadrien Lefaure. Administration : Victoria Makosi.","boxoffice_url":null,"website":"http:\/\/www.theatremontagnemagique.be","email":"info@montagnemagique.be","phone_contact":null,"phone_booking":"+32 2 210 15 90","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.550686"},"nl":{"name":"Tout\/rien (Cie Modo Grosso)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatremontagnemagique.be","email":"info@montagnemagique.be","phone_contact":null,"phone_booking":"+32 2 210 15 90","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.550686"},"en":{"name":"Tout\/rien (Cie Modo Grosso)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatremontagnemagique.be","email":"info@montagnemagique.be","phone_contact":null,"phone_booking":"+32 2 210 15 90","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.550686"},"de":{"name":"Tout\/rien (Cie Modo Grosso)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatremontagnemagique.be","email":"info@montagnemagique.be","phone_contact":null,"phone_booking":"+32 2 210 15 90","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.550686"},"it":{"name":"Tout\/rien (Cie Modo Grosso)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_ur