 synth\u00e9s. Alan Vega et Martin Rev signent en 1980 leur deuxi\u00e8me album sous le nom \u00ab Suicide \u00bb. Leur musique est \u00e9lectronique et hypnotique, parfois dangereuse, parfois romantique. Le travail de Martin Rev sur les textures synth\u00e9tiques est innovant et catchy. Un projet \u00ab wave \u00bb pour le dancefloor qui n\u2019a pas pris une ride.\r\n\r\nStyle : synth pop minimal\r\nAnn\u00e9e : 1980\r\nDur\u00e9e : 40:12\r\nLabel : Ze\/Island\r\nPays : UK","performers":null,"boxoffice_url":null,"website":"https:\/\/atelier210.be\/saisons\/saison-23-24\/blackout-session-3\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.561046"},"sp":{"name":"Blackout Session : Alan Vega et Martin Rev (1980)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/atelier210.be\/saisons\/saison-23-24\/blackout-session-3\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.561046"},"nl":{"name":"Blackout Session : Alan Vega et Martin Rev (1980)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/atelier210.be\/saisons\/saison-23-24\/blackout-session-3\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.561046"}},"place":{"id":241923,"translations":{"de":{"name":"Atelier 210","address_street_name":"Chauss\u00e9e Saint-Pierre","address_street_number":"210","address_street_box":null,"email":"info@atelier210.be","website":"http:\/\/www.atelier210.be","phone_contact":"+32 2 732 25 98","phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Chauss\u00e9e Saint-Pierre, 210","address_line2":"1040 Etterbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"na