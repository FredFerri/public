t.brussels\/de\/visitors\/agenda\/event-detail.50008088"},"pt":{"name":"ET VOS CORPS SERONT CAILLASSES | Jo\u00eblle Sambi et L\u2019Arche Editeur","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/maisonpoeme.be\/evenement\/2024-joelle-sambi\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50008088"},"en":{"name":"ET VOS CORPS SERONT CAILLASSES | Jo\u00eblle Sambi et L\u2019Arche Editeur","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/maisonpoeme.be\/evenement\/2024-joelle-sambi\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50008088"},"it":{"name":"ET VOS CORPS SERONT CAILLASSES | Jo\u00eblle Sambi et L\u2019Arche Editeur","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/maisonpoeme.be\/evenement\/2024-joelle-sambi\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50008088"},"cn":{"name":"ET VOS CORPS SERONT CAILLASSES | Jo\u00eblle Sambi et L\u2019Arche Editeur","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/maisonpoeme.be\/evenement\/2024-joelle-sambi\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50008088"},"fr":{"name":"ET VOS CORPS SERONT CAILLASSES | Jo\u00eblle Sambi et L\u2019Arche Editeur","shortdescr":null,"longdescr":"Nourrie par les luttes de Kinshasa comme celles de Bruxelles, la po\u00e9sie slam de Jo\u00eblle Sambi est un flow ferme qui d\u00e9borde les violences exerc\u00e9es par tous les syst\u00e8mes de domination. Un flow qui saisit et d\u00e9cape jusqu\u2019\u00e0 faire appara\u00eetre les contours d\u2019un monde qui placerait la justice et la joie au centre de nos vies.\n\nSon livre \u00ab Et vos corps seront caillasses \u00bb a \u00e9t\u00e9 r\u00e9\u00e9dit\u00e9 \u00e0 l\u2019Arche le 16 f\u00e9vrier 2024. \n\nLa rencontre sera mod\u00e9r\u00e9e par Luz De Amor.\n\n\u00c0 propos des artistes\n\nPo\u00e9tesse, slameuse, f\u00e9ministe, lesbienne, activiste LGBTQIA+, exil\u00e9e permanente, Jo\u00eblle Sambi est l\u2019une des figures les plus engag\u00e9es et engageantes de la sc\u00e8ne actuelle. Elle trace un parcours o\u00f9 la po\u00e9sie est performance, au croisement des formes et des luttes. Sa parole se d\u00e9ploie aussi bien dans les lieux militants que sur les sc\u00e8nes nationales, comme le Th\u00e9\u00e2tre National Wallonie-Bruxelles, o\u00f9 elle est autrice associ\u00e9e.","performers":"Jo\u00eblle Sambi","boxoffice_url":null,"website":"https:\/\/maisonpoeme.be\/evenement\/2024-joelle-sambi\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50008088"},"sp":{"name":"ET VOS CORPS SERONT CAILLASSES | Jo\u00eblle Sambi et L\u2019Arche Editeur","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/maisonpoeme.be\/evenement\/2024-joelle-sambi\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50008088"},"nl":{"name":"ET VOS CORPS SERONT CAILLASSES | Jo\u00eblle Sambi et L\u2019Arche Editeur","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/maisonpoeme.be\/evenement\/2024-joelle-sambi\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50008088"}},"place":{"id":278685,"translations":{"de":{"name":"Maison Po\u00e8me","address_street_name":"rue d'\u00c9cosse","address_street_number":"30","address_street_box":null,"email":"info@maisonpoeme.be","website"