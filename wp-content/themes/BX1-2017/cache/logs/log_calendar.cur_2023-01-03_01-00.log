sday, friday, saturday and sunday: from 11:00 to 18:00"]},"date_start":"2022-11-18","date_end":"2023-01-29","is_also_by_appointment":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-01-02T01:09:24+01:00","published_at":"2022-11-21T09:17:27+01:00","backoffice_id":265944,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.23927227559464},{"id":545340,"date_start":"2022-11-18","date_end":"2023-05-01","date_next":"2023-01-03","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung","it":null,"sp":null,"pt":null,"cn":null}},"others":{"list":[36,42],"translations":{"fr":["Mus\u00e9es et art centers","Peinture"],"nl":["Musea en kunstcentra","Schilderkunst"],"en":["Museums and art centers","Painting"],"de":["Museen & Kunstzentren","Malerei"],"it":[null,null],"sp":[null,null],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Le Canal d'Obolensky","shortdescr":"La Fonderie vous invite pour une promenade immersive \u00e0 la (re)d\u00e9couverte du canal de Bruxelles, d\u00e9peint par un artiste phare de la sc\u00e8ne belge : Alexandre Obolensky. Une invitation \u00e0 prendre un temps d\u2019arr\u00eat, \u00e0 la fl\u00e2nerie et \u00e0 la contemplation.","longdescr":"La fonderie a le plaisir de vous annoncer l\u2019ouverture de sa nouvelle exposition \u00e9v\u00e9nement \u00ab Le Canal d\u2019Obolensky \u00bb du 18 novembre 2022 jusqu\u2019au 1er Mai 2023. Nous invitons nos publics pour une promenade immersive \u00e0 la (re)d\u00e9couverte du canal de Bruxelles, d\u00e9peint par un artiste phare de la sc\u00e8ne belge : Alexandre Obolensky. Une invitation \u00e0 prendre un temps d\u2019arr\u00eat, \u00e0 la fl\u00e2nerie et \u00e0 la contemplation.\r\n\r\nConnu comme peintre de d\u00e9cors de th\u00e9\u00e2tre, op\u00e9ra, ballet et exposition, Alexandre Obolensky (Bruxelles, 1952-2018) a \u00e9galement d\u00e9velopp\u00e9 une \u0153uvre personnelle autour du canal de Bruxelles.  \r\n\r\nL\u2019exposition invite \u00e0 une balade sensible et contemplative, \u00e0 la d\u00e9couverte d\u2019une s\u00e9rie de peintures troublantes par leur r\u00e9alisme, qui nous exposent un canal pluriel capt\u00e9 par l\u2019\u0153il de l\u2019artiste et interpr\u00e9t\u00e9 selon sa technique picturale. Au fil des lumi\u00e8res et des paysages, le canal se m\u00e9tamorphose. Les \u0153uvres sont des appels \u00e0 s\u2019arr\u00eater, \u00e0 observer et \u00e0 questionner notre regard, notre perception de ce canal inscrit dans le paysage bruxellois, mais encore souvent m\u00e9connu.  \r\n\r\nAu travers du regard de l\u2019artiste, cette promenade libre invite aussi \u00e0 la d\u00e9couverte de son processus du cr\u00e9ation. Photographier puis d\u00e9-photographier par la peinture, telle \u00e9tait la mani\u00e8re de proc\u00e9der d\u2019Obolensky. Du choix de l\u2019angle de vue \u00e0 la transposition picturale par le quadrillage, l\u2019exposition fait d\u00e9couvrir les diff\u00e9rentes \u00e9tapes d\u2019une technique pr\u00e9cise et rigoureuse. \r\n\r\nL\u2019exposition s\u2019adresse \u00e0 un large public, aux amateurs d\u2019art comme aux observateurs curieux, petits et grands, gr\u00e2ce \u00e0 l\u2019int\u00e9gration de dispositifs interactifs dans le parcours du visiteur. \r\n\r\nUn catalogue de l\u2019exposition est \u00e9galement propos\u00e9 pour poursuivre la balade de chez soi ou dans les pas de l\u2019artiste le long du canal.  \r\n\r\nPour ceux qui veulent en savoir plus sur l\u2019artiste est \u00e9galement disponible l\u2019ouvrage Alexandre Obolensky, r\u00e9trospective sur sa carri\u00e8re de peintre de d\u00e9cors et sur son travail personnel. Illustr\u00e9 de nombreuses photographies et accompagn\u00e9 de t\u00e9moignages d\u2019observateurs et de collaborateurs privil\u00e9gi\u00e9s, il retrace une vie de peinture, un m\u00e9tier unique et particulier entre op\u00e9ras, th\u00e9\u00e2tres, grandes expositions et travail intime.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.lafonderie.be","email":"info@lafonderie.be","phone_contact":"+32 2 410 99 50","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.545340"},"nl":{"name":"Het Kanaal van Obolensky","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.545340"},"en":{"name":"Le Canal d'Obolensky","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.545340"},"de":{"name":"Le Canal d'Obolensky","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.545340"},"it":{"name":"Le Canal d'Obolensky","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.545340"},"sp":{"name":"Le Canal d'Obolensky","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.545340"},"pt":{"name":"Le Canal d'Obolensky","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.545340"},"cn":{"name":"Le Canal d'Obolensky","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.545340"}},"place":{"id":252658,"translations":{"fr":{"name":"La Fonderie - Mus\u00e9e bruxellois de l'Industrie et du Travail","address_street_name":"Rue Ransfort","address_street_number":"27","address_street_box":null,"email":"info@lafonderie.be","website":"http:\/\/www.lafonderie.be","phone_contact":"+32 2 410 99 50","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Rue Ransfort, 27","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"La Fonderie propose depuis pr\u00e8s de 30 ans des visites guid\u00e9es en ville, en bateau et \u00e0 pied. R\u00e9guli\u00e8rement mises \u00e0 jour, et compl\u00e9t\u00e9es chaque ann\u00e9e de nouveaux th\u00e8mes ou dispositifs, ces visites font leur succ\u00e8s  et drainent chaque ann\u00e9e plusieurs milliers de visiteurs.   Allant des enfants  jusqu\u2019aux groupes de seniors, le public vis\u00e9 par leurs parcours est large. La plupart des visites sont disponibles \u00e0 la fois selon un calendrier fix\u00e9 pour les individuels et familles, et pour les groupes sur demande. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"La Fonderie - Brussels Museum voor Industrie en Arbeid","address_street_name":"Ransfortstraat","address_street_number":"27","address_street_box":null,"email":"info@lafonderie.be","website":"http:\/\/www.lafonderie.be","phone_contact":"+32 2 410 99 50","phone_booking":null,"address_zip":"1080","address_city":"Sint-Jans-Molenbeek","address_line1":"Ransfortstraat, 27","address_line2":"1080 Sint-Jans-Molenbeek","description_web":"De Gieterij biedt al bijna 30 jaar rondleidingen door de stad per boot en te voet aan. Deze rondleidingen, die regelmatig worden bijgewerkt en elk jaar met nieuwe thema's of apparaten worden aangevuld, hebben de goede reputatie gemaakt en trekken elk jaar enkele duizenden bezoekers.   Van kinderen tot senioren, hun rondleidingen zijn gericht op een breed publiek. De meeste rondleidingen worden zowel volgens een vast schema voor individuen en gezinnen, als voor groepen op aanvraag aangeboden. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"La Fonderie - Brussels museum of industry and labour","address_street_name":"Rue Ransfort","address_street_number":"27","address_street_box":null,"email":"info@lafonderie.be","website":"http:\/\/www.lafonderie.be","phone_contact":"+32 2 410 99 50","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Rue Ransfort, 27","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"The Foundry has been offering guided tours of the city by boat and on foot for almost 30 years. Regularly updated, and completed each year with new themes or devices, these tours are a success and attract several thousand visitors each year.   From children to groups of seniors, the target audience for their tours is wide. Most of the tours are available both on a fixed schedule for individuals and families, and for groups on request. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"La Fonderie - Mus\u00e9e bruxellois de l'Industrie et du Travail","address_street_name":"Rue Ransfort","address_street_number":"27","address_street_box":null,"email":"info@lafonderie.be","website":"http:\/\/www.lafonderie.be","phone_contact":"+32 2 410 99