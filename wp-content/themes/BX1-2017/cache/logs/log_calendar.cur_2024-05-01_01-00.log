e-de-crimes\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.509491"},"en":{"name":"Bruxelles Sc\u00e8ne de Crimes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/bruxelles-scene-de-crimes\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.509491"},"it":{"name":"Bruxelles Sc\u00e8ne de Crimes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/bruxelles-scene-de-crimes\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.509491"},"cn":{"name":"Bruxelles Sc\u00e8ne de Crimes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/bruxelles-scene-de-crimes\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.509491"},"fr":{"name":"Bruxelles Sc\u00e8ne de Crimes","shortdescr":"Accrochez-vous \u00e0 vos tripes. Nous vous faisons revivre quelques-unes des plus horribles affaires criminelles qui ont frapp\u00e9 Bruxelles entre le 19\u00e8me et le 20\u00e8me si\u00e8cle.","longdescr":"Au fil d\u2019une balade dans les sombres ruelles du centre historique, la visite \u201cBruxelles, Sc\u00e8ne de Crimes\u201d vous relates quelques affaires criminelles qui ont marqu\u00e9 la capitale aux 19\u00e8me et 20\u00e8me si\u00e8cles\u2026\r\n\r\nReplongez, comme si vous y \u00e9tiez, dans l\u2019Histoire de la ville et apprenez-en plus sur les bruxellois, sur la police, mais surtout sur la soci\u00e9t\u00e9 et les m\u0153urs des diff\u00e9rentes \u00e9poques travers\u00e9es.\r\n\r\nEngagez-vous dans une promenade frissonnante, effrayante, lugubre, parfois sanguinolente, quelques fois tr\u00e8s violente, mais toujours respectueuse des diff\u00e9rents protagonistes et scrupuleusement fid\u00e8le aux faits. \r\n\r\n\r\nQU\u2019ALLEZ-VOUS D\u00c9COUVRIR ?\r\n\r\nLe tour \u201cSc\u00e8ne de Crimes\u201d vous d\u00e9voile la face la plus sombre de l\u2019histoire de Bruxelles et vous plonge dans les m\u00e9andres les plus obscures de l\u2019\u00e2me humaine\u2026 Mais la visite vous en apprendra \u00e9galement beaucoup sur la soci\u00e9t\u00e9 bruxelloise aux diff\u00e9rentes \u00e9poques que nous traverserons.\r\n\r\nCrimes d\u2019honneur, vengeances, crimes passionnels ou crapuleux, les quelques r\u00e9cits rapport\u00e9s vous feront frissonner \u00e0 coup s\u00fbr.\r\n\r\nAu programme de la balade, entre autres\u2026\r\n\r\n\u2013 Double meurtre pour 50kg de porc, 1850\r\n\u2013 La l\u00e9gende du Coin du Diable, XVII\u00e8me si\u00e8cle\r\n\u2013 Le crime de la place Saint-Gery, 1847\r\n\u2013 L\u2019affaire Jeanne Van Calk, 1906\r\n\u2013 L\u2019\u201cincident de Bruxelles\u201d, 1873\r\n\u2013 \u2026Mais aussi de nombreuses petites histoires et anecdotes !\r\n\r\n\r\nINFORMATIONS PRATIQUES\r\nTours r\u00e9guliers en fran\u00e7ais (et bient\u00f4t en n\u00e9erlandais)\r\nPrix  : 17,00 \u20ac \/ 14,00 \u20ac tarif r\u00e9duit (\u00e9tudiant, ch\u00f4meur,..)\r\nDur\u00e9e : Environ 2 heures\r\nRendez-vous : Devant l\u2019entr\u00e9e de l\u2019H\u00f4tel Amigo\r\nRue de l\u2019Amigo, 1000 Bruxelles\r\nFin du tour : Place Saint G\u00e9ry\r\n\r\nTour priv\u00e9 sur demande en fran\u00e7ais ou en anglais : info@brusselsbyfoot.com","performers":"Une visite guid\u00e9e originale de l'association de guides ind\u00e9pendants Brussels By Foot","boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/bruxelles-scene-de-crimes\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.509491"},"sp":{"name":"Bruxelles Sc\u00e8ne de Crimes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/bruxelles-scene-de-crimes\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.509491"},"nl":{"name":"Bruxelles Sc\u00e8ne de Crimes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/bruxelles-scene-de-crimes\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.509491"}},"place":{"last_updated_at":"2023-03-06T14:01:49+01:00","published_at":"2013-10-19T01:17:58+02:00","id":242512,"translations":{"de":{"name":"H\u00f4tel Amigo","address_street_name":"Rue de l'Amigo","address_street_number":"1-3","address_street_box":null,"email":null,"website":null,"phone_contact":"+32 2 547 47 47","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de l'Amigo, 1-3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"H\u00f4tel Amigo","address_street_name":"Rue de l'Amigo","address_street_number":"1-3","address_street_box":null,"email":null,"website":null,"phone_contact":"+32 2 547 47 47","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de l'Amigo, 1-3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"H\u00f4tel Amigo","address_street_na