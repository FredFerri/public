_end":"2023-12-31","date_next":"2023-07-08","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":true,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen","it":"Visite guidate","sp":"Visitas guiadas","pt":null,"cn":null}},"others":{"list":[105],"translations":{"fr":["Gastronomie"],"nl":["Gastronomie"],"en":["Gastronomy"],"de":["Gastronomie"],"it":["Cucina"],"sp":["Gastronom\u00eda"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr","nl","en","es"],"subtitles":[]},"translations":{"fr":{"name":"Visitez une nano brasserie artisanale et distillerie","shortdescr":null,"longdescr":"Vous \u00eates \u00e0 la recherche d'une activit\u00e9 de team building amusante et engageante avec vos coll\u00e8gues ? Vous voulez vous r\u00e9unir et cr\u00e9er des souvenirs... et de la bi\u00e8re ?   \r\n\r\nSi oui, il semblerait que Tipsy Tribe Brewing & Spirit Works soit l'endroit qu'il vous faut !\r\n\r\nNous proposons des ateliers de fabrication de bi\u00e8re de haute qualit\u00e9 en anglais, avec tous les ingr\u00e9dients et le mat\u00e9riel n\u00e9cessaires. Pendant l'atelier, nous vous guiderons, vous et votre groupe, tout au long du processus de brassage.   Une fois la bi\u00e8re termin\u00e9e et ferment\u00e9e, vous serez invit\u00e9s \u00e0 revenir pour embouteiller le tout vous-m\u00eame et en ramener chez vous pour votre plus grand plaisir !  Nous proposons m\u00eame la cr\u00e9ation d'\u00e9tiquettes personnalis\u00e9es pour vos bi\u00e8res si vous le souhaitez !\r\n\r\nSi vous souhaitez plus qu'un simple brassage, nous proposons un espace pour des sessions de travail en petits groupes et des pr\u00e9sentations avec wifi, des d\u00e9jeuners de travail et des quiz dans les pubs - le tout dans le confort d'une v\u00e9ritable brasserie et distillerie artisanale en activit\u00e9 !  \r\n\r\nContactez-nous et nous nous ferons un plaisir de vous proposer une offre sur mesure pour rendre votre prochain \u00e9v\u00e9nement d'\u00e9quipe encore plus m\u00e9morable !","performers":null,"boxoffice_url":null,"website":"http:\/\/www.tipsytribe.be","email":"info@tipsytribe.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.557941"},"nl":{"name":"Bezoek een nano ambachtelijke brouwerij en distilleerderij","shortdescr":null,"longdescr":"Bent u op zoek naar een leuke en boeiende teambuildingactiviteit met collega's? Wil je samenkomen en herinneringen maken...en bier?   \r\n\r\nZo ja, dan is de Tipsy Tribe Brewing & Spirit Works de plek voor u!\r\n\r\nWij verzorgen Engelstalige workshops bier maken van hoge kwaliteit, inclusief alle ingredi\u00ebnten en apparatuur. Tijdens de workshop leiden we jou en je groep door het hele brouwproces.   Zodra het bier klaar en gefermenteerd is, wordt u uitgenodigd om alles zelf te bottelen en mee naar huis te nemen voor uw eigen plezier!  We kunnen zelfs labels op maat maken voor je bier als je dat wilt!\r\n\r\nAls je meer wilt dan alleen brouwen, bieden we ruimte voor break-out sessies en presentaties met wifi, werklunches en pubquizes - allemaal in het comfort van een echte ambachtelijke brouwerij en distilleerderij!  \r\n\r\nNeem contact met ons op en we zorgen graag voor een aanbod op maat om uw volgende teamevenement nog onvergetelijker te maken!","performers":null,"boxoffice_url":null,"website":"http:\/\/www.tipsytribe.be","email":"info@tipsytribe.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.557941"},"en":{"name":"Visit a nano craft brewery and distillery","shortdescr":null,"longdescr":"Are you looking for a fun and engaging\u202fteam building activity with colleagues? Do you want to get together and make some memories\u2026and beer?   \r\n\r\nIf yes, it looks like the Tipsy Tribe Brewing & Spirit Works is the place for you!\r\n\r\nWe provide high quality english language beer making workshops including all the ingredients and equipment. During the workshop we'll navigate you and your group through the entire brewing process.   Once the beer is done and fermented, you'll be invited back to bottle everything yourself as well and take some home for your own enjoyment!  We even offer customized label creation for your beers if you want!\r\n\r\nIf it's more than just brewing that you want, we offer space for break-out sessions and presentations with wifi, work lunches and pub quizes -  all in the comfort of a real working craft brewery and distillery!  \r\n\r\nContact us and we\u2019d be happy to provide you a tailored offering to make your next team event even more memorable!","performers":null,"boxoffice_url":null,"website":"http:\/\/www.tipsytribe.be","email":"info@tipsytribe.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.557941"},"de":{"name":"Visitez une nano brasserie artisanale et distillerie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.tipsytribe.be","email":"info@tipsytribe.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.557941"},"it":{"name":"Visitez une nano brasserie artisanale et distillerie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.tipsytribe.be","email":"info@tipsytribe.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.557941"},"sp":{"name":"Visitez une nano brasserie artisanale et distillerie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\