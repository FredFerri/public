:"2022-05-27","start":"10:00:00","end":"18:00:00"},{"day":"2022-07-21","start":"10:00:00","end":"18:00:00"},{"day":"2022-08-15","start":"10:00:00","end":"18:00:00"}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"visit_profile":{"list":[337,327],"translations":{"fr":["Highlight","Art contemporain"],"nl":["Highlight","Hedendaagse kunst"],"en":["Highlight","Contemporary art"]}},"tags":[],"accessibilities":{"list":[255,257,261,263,265],"translations":{"fr":["Accessible","Am\u00e9nagements pour personnes sourdes et malentendantes","Parking accessible","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9"],"nl":["Toegankelijk","Voorzieningen voor dove en slechthorende personen","Toegankelijke parking","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet"],"en":["Accessible","Facilities for deaf and hearing-impaired people","Accessible parking","Accessible to pedestrians with mobility aids","Adapted toilet"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-08-07T01:08:42+02:00","published_at":"2021-11-26T09:30:57+01:00","backoffice_id":243527,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.2547308482414},{"id":532381,"date_start":"2022-04-28","date_end":"2022-08-29","date_next":"2022-08-08","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[36,48],"translations":{"fr":["Mus\u00e9es et art centers","Architecture"],"nl":["Musea en kunstcentra","Architectuur"],"en":["Museums and art centers","Architecture "]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"VERTICAL URBAN FACTORY-Bruxelles, L\u2019architecture de la production industrielle.","shortdescr":"Vertical Urban Factory, organis\u00e9e par Nina Rappaport, critique d'architecture et enseignante bas\u00e9e \u00e0 New York, pr\u00e9sente la conception architecturale innovante, l'ing\u00e9nierie structurelle et les m\u00e9thodes de transformation d'importantes usines modernistes et contemporaines, ainsi que des r\u00e9flexions sur l'usine du futur.","longdescr":"Vertical Urban Factory, organis\u00e9e par Nina Rappaport, critique d'architecture et enseignante bas\u00e9e \u00e0 New York, pr\u00e9sente la conception architecturale innovante, l'ing\u00e9nierie structurelle et les m\u00e9thodes de transformation d'importantes usines modernistes et contemporaines, ainsi que des r\u00e9flexions sur l'usine du futur. En r\u00e9ponse aux difficult\u00e9s \u00e9conomiques des nations post-industrielles, l'exposition pose les questions suivantes : les nouvelles usines peuvent-elles pr\u00e9senter des solutions durables pour des villes autosuffisantes ? Comment pouvons-nous d\u00e9velopper les villes pour y inclure de nouveaux mod\u00e8les d'usines \u00e0 l\u2019heure o\u00f9 l\u2019\u00e9conomie fonctionne sur une production propre, silencieuse et \u00e0 petite \u00e9chelle ? Et quels genres de m\u00e9langes pouvons-nous proposer dans nos villes qui incluent des utilisations industrielles ?\r\n\r\nL'exposition a \u00e9t\u00e9 pr\u00e9sent\u00e9e pour la premi\u00e8re fois \u00e0 New York. Elle a voyag\u00e9 au Mus\u00e9e d'art contemporain de D\u00e9troit, au Design Exchange de Toronto, au Mus\u00e9e de l'architecture de Londres, \u00e0 Industry City \u00e0 Brooklyn, \u00e0 Archizoom \u00e0 l'EPFL, Politecnico di Torino, et \u00e0 la Biennale i2a de Lugano.\r\n \r\nVertical Urban Factory d\u00e9montre le potentiel des usines urbaines du futur qui repr\u00e9sentent un d\u00e9fi passionnant en mati\u00e8re de conception urbaine pour une infrastructure int\u00e9gr\u00e9e et hybride, o\u00f9 l'on vit et travaille ensemble. L'exposition comprend des photographies, des dessins et des diagrammes d'usines ainsi qu'une chronologie compl\u00e8te de l'industrie, de la technologie et de l'architecture. Les projets montrent un \u00e9ventail d'espaces de production urbaine, des usines automobiles de fabrication avanc\u00e9e telles que VW Dresden, aux industries n\u00e9o-cottage de Johannesburg et de D\u00e9troit et proposent des id\u00e9es pour l\u2019avenir. \r\n\r\nL'exposition a \u00e9t\u00e9 organis\u00e9e et pens\u00e9e par Nina Rappaport et son \u00e9quipe d'architectes et d'historiens, accompagn\u00e9e d\u2019une conception graphique de Sarah Gephart de MGMT.Design. Les films d'Eric Breitbart, compil\u00e9s sur les usines historiques et les entretiens de Nina Rappaport avec des ouvriers d'usine tir\u00e9s de ses films, \u00ab A Worker's Lunch Box \u00bb, compl\u00e8tent les mat\u00e9riaux architecturaux et urbains. Cette exposition comprend une section sur Bruxelles en collaboration avec Urban Brussels ainsi que Kristiaan Borrett, Ma\u00eetre architecte. L'exposition est accompagn\u00e9e d'un livre de 480 pages du m\u00eame nom de Nina Rappaport publi\u00e9 par Actar.  \r\n\r\n\r\n\"La typologie de l'usine urbaine verticale d\u00e9montre comment les questions architecturales et urbaines pr\u00e9sentent un d\u00e9fi de conception passionnant pour les syst\u00e8mes int\u00e9gr\u00e9s et les nouvelles questions sociales, \u00e9conomiques et de durabilit\u00e9 qui suscitent des concepts pour l'avenir.\"\r\n\r\nNina Rappaport.","performers":"Nina Rappaport (organisatrice)","boxoffice_url":null,"website":"http:\/\/www.hallessaintgery.be","email":"accueil@hallessaintgery.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.532381"},"nl":{"name":"VERTICAL URBAN FACTORY-Bruxelles, L\u2019architecture de la production industrielle.","shortdescr":"Vertical Urban Factory, samengesteld door Nina Rappaport, architectuurcriticus en onderwijzer uit New York, presenteert het innovatieve architectonische ontwerp, de constructietechniek en de verwerkingsmethoden van belangrijke modernistische en hedendaagse fabrieken, met speculaties over de fabriek van de toekomst.","longdescr":"Vertical Urban Factory, samengesteld door Nina Rappaport, architectuurcriticus en onderwijzer uit New York, presenteert het innovatieve architectonische ontwerp, de constructietechniek en de verwerkingsmethoden van belangrijke modernistische en hedendaagse fabrieken, met speculaties over de fabriek van de toekomst. Als antwoord op de economische moeilijkheden van postindustri\u00eble naties stelt de tentoonstelling de vraag: Kunnen nieuwe fabrieken duurzame oplossingen bieden voor zelfvoorzienende steden? Hoe kunnen we steden zo ontwikkelen dat ze nieuwe fabrieksmodellen omvatten in een tijd waarin de economie draait op schone, stille, kleinschalige productie? En welke mengvormen kunnen wij in onze steden aanbieden die ook industrieel gebruik omvatten?\r\n\r\nDe tentoonstelling werd voor het eerst gepresenteerd in New York en reisde daarna naar het Museum of Contemporary Art in Detroit, de Design Exchange in Toronto, het Museum of Architecture in Londen, Industry City in Brooklyn, Archizoom aan de EPFL, Politecnico di Torino, en de i2a Biennale in Lugano.\r\n\r\n\r\nVertical Urban Factory toont het potentieel van stedelijke fabrieken van de toekomst als een opwindende stedenbouwkundige uitdaging voor een ge\u00efntegreerde, hybride infrastructuur waarin wonen en werken samengaan. De tentoonstelling omvat foto's, tekeningen en schema's van fabrieken en een uitgebreide tijdlijn van industrie, technologie en architectuur. De projecten tonen een scala van stedelijke produktieruimten, van geavanceerde automobielfabrieken zoals VW Dresden tot neo-cottage industrie\u00ebn in Johannesburg en Detroit en bieden idee\u00ebn voor de toekomst.\r\n\r\nDe tentoonstelling is samengesteld en ontworpen door Nina Rappaport en haar team van architecten en historici, met grafisch ontwerp door Sarah Gephart van MGMT.Design. Films van Eric Breitbart samengesteld van historische fabrieken en de interviews van Nina Rappaport met fabrieksarbeiders uit haar films, 'A Worker's Lunch Box', vullen het architectonische en stedelijke materiaal aan. De tentoonstelling omvat een gedeelte over Brussel in samenwerking met Urban Brussels alsook Kristiaan Borrett, Bouwmeester-architect. De tentoonstelling gaat vergezeld van een gelijknamig boek van 480 pagina's van Nina Rappaport, uitgegeven door Actar.\r\n\r\n \"De typologie van de Vertical Urban Factory laat zien hoe architectonische en stedelijke\r\nvraagstukken een spannende ontwerpuitdaging vormen voor ge\u00efntegreerde systemen en nieuwe sociale, economische en duurzaamheidsvraagstukken die concepten voor de toekomst uitlokken.\"\r\n\r\nNina Rappaport.","performers":"Nina Rappaport (organisator)","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.532381"},"en":{"name":"VERTICAL URBAN FACTORY-Bruxelles, L\u2019architecture de la production industrielle.","shortdescr":"Vertical Urban Factory curated by New York-based architectural critic and educator, Nina Rappaport, features the innovative architectural design, structural engineering, and processing methods of significant modernist and contemporary factories with speculations on the future factory.","longdescr":"Vertical Urban Factory curated by New York-based architectural critic and educator, Nina Rappaport, features the innovative architectural design, structural engineering, and processing methods of significant modernist and contemporary factories with speculations on the future factory. A timely response to the ailing economies of post-industrial nations. The exhibition poses the questions: can new factories present sustainable solutions for self-sufficient cities? How can we develop cities to include new factory paradigms now that production in the new economy is clean, quiet, and small-scale? And what kinds of mixes can we make in our cities that includes industrial uses? \r\n\r\nThe exhibition was first shown in New York City and has traveled to Detroit\u2019s Museum of Contemporary Art, Toronto\u2019s Design Exchange, London\u2019s Architecture Museum, Industry City in Brooklyn, Archizoom at EPFL, Politecnico di Torino, and Lugano\u2019s i2a Biennale.\r\n \r\nVertical Urban Factory demonstrates the potential for change-making future urban factories that pose an exciting urban design challenge for an integrated and hybrid infrastructure including living and working together. Photographs, drawings, and diagrams of factories as well as a comprehensive timeline of industry, technology, and architecture are included in the exhibition. Projects show a range of urban production spaces from advanced manufacturing automotive factories such as VW Dresden to neo-cottage industries in Johannesburg and Detroit and proposes ideas for the future.\r\n\r\nThe exhibition organized and researched by Nina Rappaport and her team of architects and historians, with graphic design by Sarah Gephart of MGMT.Design. Films by Eric Breitbart compiled of the historic factories and Rappaport\u2019s interviews with factory workers from her films, A Worker\u2019s Lunch Box compliment the architectural and urban materials. This exhibition includes a section on Brussels in a collaboration with Urban Brussels as well as Kristiaan Borret, bouwmeester ma\u00eetre architecte. The exhibition is accompanied by a 480-page book of the same name by Nina Rappaport published by Actar.  \r\n\r\n\u201cThe Vertical Urban Factory typology demonstrates how architectural and urban\r\nissues present an exciting design challenge for integrated systems and new social, economic, and sustainability issues that provokes concepts for the future.\u201d \r\n\r\nNina Rappaport","performers":"Nina Rappaport (organizer)","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.532381"},"de":{"name":"VERTICAL URBAN FACTORY-Bruxelles, L\u2019architecture de la production industrielle.","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.532381"},"it":{"name":"VERTICAL URBAN FACTORY-Bruxelles, L\u2019architecture de la production industrielle.","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.532381"},"sp":{"name":"VERTICAL URBAN FACTORY-Bruxelles, L\u2019architecture de la production industrielle.","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.532381"},"pt":{"name":"VERTICAL URBAN FACTORY-Bruxelles, L\u2019architecture de la production industrielle.","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.532381"},"cn":{"name":"VERTICAL URBAN FACTORY-Bruxelles, L\u2019architecture de la production industrielle.","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.532381"}},"place":{"id":247371,"translations":{"fr":{"name":"Halles Saint-G\u00e9ry","address_street_name":"Place Saint-G\u00e9ry","address_street_number":null,"address_street_box":null,"email":"info@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Saint-G\u00e9ry","address_line2":"1000 Bruxelles","description_web":"Remarquable t\u00e9moin de l\u2019architecture des march\u00e9s couverts, les Halles Saint-G\u00e9ry  contribuent \u00e0 valoriser le patrimoine de la R\u00e9gion de Bruxelles-Capitale. Centre d\u2019exposition et de manifestation bas\u00e9 en plein coeur du pentagone, elles ont pour vocation de mettre en valeur les traits de d\u00e9marcation du cadre de vie bruxellois et de son identit\u00e9 urbaine par le biais d'une programmation hybride, allant des expositions, aux conf\u00e9rences, concerts, rencontres et performances \u2026\r\nLe Centre Urbain (guichet d\u2019information r\u00e9gional, pour mieux vous conseiller sur l\u2019habitat durable en R\u00e9gion de Bruxelles-Capitale) est \u00e9galement situ\u00e9 au sein des Halles.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Sint-Gorikshallen","address_street_name":"Sint-Goriksplein","address_street_number":null,"address_street_box":null,"email":"info@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Sint-Goriksplein","address_line2":"1000 Brussel","description_web":"De Sint-Gorikshallen zijn een prachtig architecturaal staaltje van openbare markthallen in het 19de-eeuwse Brussel. Het gebouw werd een aantal jaren geleden volledig gerestaureerd en doet tegenwoordig dienst als permanente informatie-, tentoonstellings- en evenementenruimte gewijd aan het erfgoed en de levenswijzen in de hoofdstad. Op amper twee minuten stappen van de Beurs vormen de Sint-Gorikshallen een gezellige plek om te ontspannen en nieuwe dingen te ontdekken, zowel overdag als bij het vallen van de nacht.\r\nDe hallen herbergen ook de Stadswinkel, een vereniging die de inwoners van het Brussels Hoofdstedelijk Gewest  wil informeren over het leefmilieu en een kwaliteitsvolle leefomgeving, huisvesting, stadsrenovatie, stedenbouw en ruimtelijke ordening, en rationeel energiegebruik. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Halles Saint-G\u00e9ry","address_street_name":"Place Saint-G\u00e9ry","address_street_number":null,"address_street_box":null,"email":"info@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Place Saint-G\u00e9ry","address_line2":"1000 Brussels","description_web":"The Saint-G\u00e9ry Market Halls are a fine architectural example of 19th-century public markets in Brussels. The building was completely restored several years ago and is now a permanent information and exhibition space, with urban planning, heritage, and urban renewal as its central themes.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Halles Saint-G\u00e9ry","address_street_name":"Place Saint-G\u00e9ry","address_street_number":null,"address_street_box":null,"email":"info@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Saint-G\u00e9ry","address_line2":"1000 Bruxelles","description_web":"Die Halles Saint-G\u00e9ry mit ihrer eklektischen Architektur wurden Ende des 19. Jahrhundert als Markthalle erbaut und spielten in der Br\u00fcsseler Stadtgeschichte eine wichtige Rolle.\r\n\r\nDie Saint-G\u00e9ry-Hallen waren einerseits sowohl legend\u00e4re als auch kaufm\u00e4nnische Wiege der Stadt. Ab dem 11. Jahrhundert stand an dieser Stelle eine dem Heiligen Saint-G\u00e9ry gewidmete Kapelle. Verschiedene Wohnh\u00e4user waren hier entstanden und aufgrund der N\u00e4he zur Senne entwickelten sich zahlreiche Aktivit\u00e4ten.\r\n\r\nIm 16. Jahrhundert erhielt die Kapelle den Status einer Pfarrkirche, die prachtvoll im gotischen Stil erweitert wurde, dann aber im Zuge der Franz\u00f6sische Revolution dem Erdboden gleichgemacht wurde.\r\n\r\nDer ehemalige Markt - und sogar das gesamte Saint-G\u00e9ry-Viertel \u2013 waren ihrerseits in den 1960er-Jahren von der Zerst\u00f6rung bedroht, bis das Viertel in den 1990er-Jahren eine Art zweiten Fr\u00fchling erlebte. Seit 1999 fungieren die Saint-G\u00e9ry-Hallen als Informations- und Ausstellungszentrum rund um die Br\u00fcsseler Stadtgeschichte und das st\u00e4dtische Leben in Br\u00fcssel. An der Bar gibt es Getr\u00e4nke und Speisen.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Halle di Saint-Gery","address_street_name":"Place Saint-G\u00e9ry","address_street_number":null,"address_street_box":null,"email":"info@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Saint-G\u00e9ry","address_line2":"1000 Bruxelles","description_web":"Le Halles Saint-G\u00e9ry (mercato coperto) ospitano un centro d'informazione dedicato al patrimonio e al quadro di vita dei Bruxellesi...\r\nLe Halles Saint-G\u00e9ry (mercato coperto) ospitano un centro d'informazione dedicato al patrimonio e al quadro di vita dei Bruxellesi. Sotto il patrocinio della regione di Bruxelles Capitale.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Halles Saint-G\u00e9ry","address_street_name":"Place Saint-G\u00e9ry","address_street_number":null,"address_street_box":null,"email":"info@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"addre