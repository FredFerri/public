:04+01:00","backoffice_id":270577,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":1.2599210498949},{"id":551281,"date_start":"2023-02-25","date_end":"2023-02-25","date_next":"2023-02-25","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert","de":"Konzert","it":"Concerti","sp":"Concierto","pt":null,"cn":null}},"others":{"list":[4,6],"translations":{"fr":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"],"nl":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"],"en":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"],"de":["Pop, Rock, Jazz...","Worldmusic, Folk & Country"],"it":["Pop, rock, jazz\u2026","Worldmusic, Folk e Country"],"sp":["Pop, rock, jazz\u2026","Worldmusic, folk y country"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Soir\u00e9e cha\u00e2bi, sauce alg\u00e9rienne (TDM 183 #34 Alg\u00e9rie)","shortdescr":"Le Mus\u00e9e \u00e9ph\u00e9m\u00e8re de l'exil (MedexMuseum) relance son \"Tour du Monde en 183 assiettes\", direction l'Alg\u00e9rie ! Le samedi 25 f\u00e9vrier, on se perdra dans le d\u00e9dale des ruelles de la Casbah d'Alger en \u00e9coutant le r\u00e9pertoire musical du groupe Alma Cha\u00e2bi.","longdescr":"Une soir\u00e9e plac\u00e9e sous le signe du cha\u00e2bi alg\u00e9rien, musique populaire dont les racines puisent dans les noubas arabo-andalouses et la po\u00e9sie maghr\u00e9bine.\r\n\r\nUn programme qui vous r\u00e9serve encore des surprises, avec entre autres un repas alg\u00e9rien et une visite guid\u00e9e de l\u2019exposition \"Arwah t'chim rihet le bled\" (viens sentir l'odeur du pays) r\u00e9alis\u00e9e par le MedexMuseum en collaboration avec des membres de la communaut\u00e9 alg\u00e9rienne de Belgique.\r\n\r\nEntr\u00e9e \u00e0 prix libre et conscient.\r\n\r\nCet \u00e9v\u00e8nement b\u00e9n\u00e9ficie du soutien de la r\u00e9gion Bruxelles-Capitale dans le cadre de l'Image de Bruxelles. \r\n\r\nPlus d'info sur la page de l'\u00e9v\u00e8nement : https:\/\/fb.me\/e\/2mPPDfjHV","performers":"Alma Cha\u00e2bi ; Mus\u00e9e \u00e9ph\u00e9m\u00e8re de l'exil (MedexMuseum)","boxoffice_url":null,"website":"http:\/\/www.medexmuseum.com","email":"medexmuseum@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.551281"},"nl":{"name":"Soir\u00e9e cha\u00e2bi, sauce alg\u00e9rienne (TDM 183 #34 Alg\u00e9rie)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.medexmuseum.com","email":"medexmuseum@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.551281"},"en":{"name":"Soir\u00e9e cha\u00e2bi, sauce alg\u00e9rienne (TDM 183 #34 Alg\u00e9rie)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.medexmuseum.com","email":"medexmuseum@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.551281"},"de":{"name":"Soir\u00e9e cha\u00e2bi, sauce alg\u00e9rienne (TDM 183 #34 Alg\u00e9rie)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.medexmuseum.com","email":"medexmuseum@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.551281"},"it":{"name":"Soir\u00e9e cha\u00e2bi, sauce alg\u00e9rienne (TDM 183 #34 Alg\u00e9rie)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.medexmuseum.com","email":"medexmuseum@gmail.com","phone_c