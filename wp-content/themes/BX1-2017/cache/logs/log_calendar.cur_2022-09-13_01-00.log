:{"name":"Job seekers"}},"value":10},{"translations":{"fr":{"name":"Article 27"},"nl":{"name":"Artikel 27"},"en":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":{"list":[252,255,256,259,261,263,265,266],"translations":{"fr":["Accessible aux personnes ayant des difficult\u00e9s de compr\u00e9hension","Accessible","Am\u00e9nagements pour les personnes aveugles et malvoyantes","Chien d'assistance","Parking accessible","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9","Brussels Health Safety Label"],"nl":["Toegankelijk voor mensen met een verstandelijke beperking","Toegankelijk","Voorzieningen voor blinde en slechtziende personen","Assistentiehonden","Toegankelijke parking","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet","Brussels Health Safety Label"],"en":["Accessible to people with intellectual disabilities","Accessible","Facilities for blind and partially-sighted persons","Assistance dogs","Accessible parking","Accessible to pedestrians with mobility aids","Adapted toilet","Brussels Health Safety Label"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-09-08T17:35:06+02:00","published_at":"2022-09-08T15:04:20+02:00","backoffice_id":261361,"import_origin":null,"sub_type":"concert","show_in_agenda":true,"ranking":1.2599210498949},{"id":538160,"date_start":"2022-09-17","date_end":"2022-09-17","date_next":"2022-09-17","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert"}},"others":{"list":[4,7],"translations":{"fr":["Pop, rock, jazz\u2026","Pop, Rock"],"nl":["Pop, rock, jazz\u2026","Pop, Rock"],"en":["Pop, rock, jazz\u2026","Pop, Rock"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Consouling Sounds evening: Alkerdeel + Sum of R (CH\/FI) + Ordigort + Ashtoreth","shortdescr":null,"longdescr":"Collectif Mental & Scratch+Snuff proudly present:\r\n\r\nA Consouling Sounds evening\r\n\r\nALKERDEEL (BE - Consouling Sounds) Black\/Doom Metal\r\nAlkerdeel spits out black\/doom metal with blown out live production, grinding guitars, blasting distorted drums, filthy vocals, all very heavy, doomy and even psychedelic. Essential for fans of Darkthrone, Burning Witch, Beherit and Meth Drinker as well as other practitioners of grim buzz and noise.\r\n\r\n\u2022 https:\/\/www.facebook.com\/alkerdeel\r\n\u2022 https:\/\/alkerdeel.bandcamp.com\r\n\r\nSUM OF R (CH\/FI - Consouling Sounds) Drone\/Dark Ambient\r\nSum of R was initially created in 2008 by Reto M\u00e4der and ever since underwent several states of metamorphosis from atmospheric doom into ritualistic drone rock into dark ambient and experimental music.\r\nNo longer an instrumental project, this new trio is now touring with their new incarnation, with Jukka R\u00e4m\u00e4nen (Dark Buddha Rising, Hexvessel) and Marko Neuman (Dark Buddha Rising).\r\nThey released a stunner of an album last fall on Consouling Sounds. Lahbryce was mixed by Victor Bullok, aka V. Santura (Triptykon, Dark Fortress).\r\n\r\n\u2022 https:\/\/www.sumofrofficial.com\r\n\u2022 https:\/\/www.facebook.com\/sumofr\r\n\u2022 https:\/\/sumofr.bandcamp.com\r\n\r\nORDIGORT (BE - Babylon Doom Cult Records) Black'n'Roll\r\nFormed during the global plague outbreak in a cottage far away at the edge of the Diestiaanzee and completely removed from human noise, Ordigort started creating sardonic hymns and chants beckoning to the end of humanity as it is. Never nihilistic nor pessimistic, Malthusian in ire yet ecstatic of the possibilities lurking between the folds: Ordigort will make you feel like an outlaw or a brigand longing for a world that may one day end.\r\nThey tell us: \u201cWe're incredibly excited and we'll do our utmost best to burn the place down\" \u2013 whether we should take that as a threat or not is still to be decided. We'll see you down the front to see what the fuss is about!\r\n\r\n\u2022 https:\/\/www.facebook.com\/Ordigort\r\n\u2022 https:\/\/ordigort-iec.bandcamp.com\r\n\r\nASHTORETH (BE - Consouling Sounds) Drone Ambient\/Doom\r\nAshtoreth is a project in a search of a shamanistic perspective, channeling at times minimal, meditative drones; and at others a catharsis of doom, noise and experimentation touching upon folk, post-rock, psychedelica and more. Always in a free form.\r\n\r\n\u2022 https:\/\/www.facebook.com\/people\/ASHTORETH\/100063497169807\r\n\u2022 https:\/\/ashtoreth1.bandcamp.com","performers":"Alkerdeel; Sum of R; Ordigort; Ashtoreth","boxoffice_url":null,"website":"https:\/\/www.facebook.com\/events\/990088418333629","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.538160"},"nl":{"name":"Consouling Sounds evening: Alkerdeel + Sum of R (CH\/FI) + Ordigort + Ashtoreth","shortdescr":null,"longdescr":"Collectif Mental & Scratch+Snuff proudly present:\r\n\r\nA Consouling Sounds evening\r\n\r\nALKERDEEL (BE - Consouling Sounds) Black\/Doom Metal\r\nAlkerdeel spits out black\/doom metal with blown out live production, grinding guitars, blasting distorted drums, filthy vocals, all very heavy, doomy and even psychedelic. Essential for fans of Darkthrone, Burning Witch, Beherit and Meth Drinker as well as other practitioners of grim buzz and noise.\r\n\r\n\u2022 https:\/\/www.facebook.com\/alkerdeel\r\n\u2022 https:\/\/alkerdeel.bandcamp.com\r\n\r\nSUM OF R (CH\/FI - Consouling Sounds) Drone\/Dark Ambient\r\nSum of R was initially created in 2008 by Reto M\u00e4der and ever since underwent several states of metamorphosis from atmospheric doom into ritualistic drone rock into dark ambient and experimental music.\r\nNo longer an instrumental project, this new trio is now touring with their new incarnation, with Jukka R\u00e4m\u00e4nen (Dark Buddha Rising, Hexvessel) and Marko Neuman (Dark Buddha Rising).\r\nThey released a stunner of an album last fall on Consouling Sounds. Lahbryce was mixed by Victor Bullok, aka V. Santura (Triptykon, Dark Fortress).\r\n\r\n\u2022 https:\/\/www.sumofrofficial.com\r\n\u2022 https:\/\/www.facebook.com\/sumofr\r\n\u2022 https:\/\/sumofr.bandcamp.com\r\n\r\nORDIGORT (BE - Babylon Doom Cult Records) Black'n'Roll\r\nFormed during the global plague outbreak in a cottage far away at the edge of the Diestiaanzee and completely removed from human noise, Ordigort started creating sardonic hymns and chants beckoning to the end of humanity as it is. Never nihilistic nor pessimistic, Malthusian in ire yet ecstatic of the possibilities lurking between the folds: Ordigort will make you feel like an outlaw or a brigand longing for a world that may one day end.\r\nThey tell us: \u201cWe're incredibly excited and we'll do our utmost best to burn the place down\" \u2013 whether we should take that as a threat or not is still to be decided. We'll see you down the front to see what the fuss is about!\r\n\r\n\u2022 https:\/\/www.facebook.com\/Ordigort\r\n\u2022 https:\/\/ordigort-iec.bandcamp.com\r\n\r\nASHTORETH (BE - Consouling Sounds) Drone Ambient\/Doom\r\nAshtoreth is a project in a search of a shamanistic perspective, channeling at times minimal, meditative drones; and at others a catharsis of doom, noise and experimentation touching upon folk, post-rock, psychedelica and more. Always in a free form.\r\n\r\n\u2022 https:\/\/www.facebook.com\/people\/ASHTORETH\/100063497169807\r\n\u2022 https:\/\/ashtoreth1.bandcamp.com","performers":"Alkerdeel; Sum of R; Ordigort; Ashtoreth","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda