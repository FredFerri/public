022-06-12","doors":null,"start":"15:00:00","end":"16:30:00","is_soldout":false,"is_canceled":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":["exterior"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-05-04T05:05:04+02:00","published_at":"2022-05-03T12:46:19+02:00","backoffice_id":252983,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":1},{"id":509499,"date_start":"2021-03-07","date_end":"2022-08-31","date_next":"2022-06-12","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{"list":[112],"translations":{"fr":["Insolite"],"nl":["Ongewoon"],"en":["Unusual"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Brusseleirs d'Hier et d'Aujourd'hui","shortdescr":"D\u00e9couvrez les gentils, les m\u00e9chants, les beaux, les laids, les stars et les anonymes,\u2026 Tous ceux qui ont forg\u00e9 Bruxelles, depuis que Bruxelles existe et jusqu\u2019\u00e0 aujourd\u2019hui.","longdescr":"- Visite guid\u00e9e insolite \u00e0 prix libre : Payez en fin de tour la prix qui vous semble juste -\r\n\r\nPartez \u00e0 la rencontre des Brusseleirs. Les gentils, les m\u00e9chants, les beaux, les laids, les stars et les inconnus,\u2026 Tous ceux qui ont fait Bruxelles depuis que Bruxelles existe et jusqu\u2019\u00e0 aujourd\u2019hui.\r\n\r\nFaites la connaissance des Bruxellois les plus marquants de l\u2019Histoire, ceux sans qui rien ne serait pareil\u2026 Parce que ce qui fait Bruxelles, avant tout, ce sont les bruxellois !\r\n\r\nQU\u2019ALLEZ-VOUS D\u00c9COUVRIR ?\r\nLe tour \u201cBrusseleirs d\u2019Hier et d\u2019Aujourd\u2019hui\u201d vous emm\u00e8ne sur les traces de quelques personnages embl\u00e9matiques qui ont marqu\u00e9 l\u2019Histoire de la ville (en bien ou en mal).\r\n\r\nAinsi, au fil d\u2019une agr\u00e9able balade hors des circuits classiques, vous ferez connaissance avec les dikkeneks (grandes gueules), les zwanzeurs et les kweebus (fous, tordus) de l\u2019Histoire\u2026\r\n\r\nLes personnages pr\u00e9sent\u00e9s sont on ne peut plus vari\u00e9s et \u00e9clectiques :\r\n\u2013 Audrey Hepburn\r\n\u2013 Stromae\r\n\u2013 Andr\u00e9 V\u00e9sale\r\n\u2013 Bonom\r\n\u2013 Madame Chapeau\r\n\u2013 \u2026\r\n\r\n\r\n\r\nINFORMATIONS PRATIQUES\r\n\r\nTours r\u00e9guliers en fran\u00e7ais, n\u00e9erlandais, anglais :\r\nPrix  : Libre et conscient*\r\nDur\u00e9e : Environ 2 heures\r\nRendez-vous : Place Poelaert (au pied du Monument aux Morts), 1000 Bruxelles\r\nFin du tour : Vers la place Fontainas\r\n\r\nTour priv\u00e9 sur demande en fran\u00e7ais, anglais, n\u00e9erandais ou espagnol","performers":"Visite guid\u00e9e originale de la compagnie de guide ind\u00e9pendants Brussels By Foot","boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/brusseleirs-dhier-et-daujourdhui\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/509499.html"},"nl":{"name":"Brusseleirs d'Hier et d'Aujourd'hui","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/509499.html"},"en":{"name":"Brusseleirs d'Hier et d'Aujourd'hui","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/509499.html"},"de":{"name":"Brusseleirs d'Hier et d'Aujourd'hui","shortd