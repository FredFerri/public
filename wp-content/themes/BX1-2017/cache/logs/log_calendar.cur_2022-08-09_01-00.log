 Des visites sp\u00e9cialement ax\u00e9es sur l'environnement pour sensibiliser les habitants au respect des espaces verts en ville et au respect de l'environnement :)\nRDV avec le guide, devant le kiosque de la guinguette.R\u00e9servation fortement conseill\u00e9e car les places sont limit\u00e9es!Merci de nous pr\u00e9venir par mail en cas de d\u00e9sistement de derni\u00e8re minute.En cas de pluie les visites sont maintenues.\navec le soutien de Bruxelles Environnement - Leefmilieu Brussel","performers":null,"boxoffice_url":null,"website":"http:\/\/www.arkadia.be","email":"info@arkadia.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/536244.html"},"nl":{"name":"PARK TOUR : Visite gratuite Parc Roi Baudouin","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/nl","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/536244.html"},"en":{"name":"PARK TOUR : Visite gratuite Parc Roi Baudouin","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/en","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/536244.html"},"de":{"name":"PARK TOUR : Visite gratuite Parc Roi Baudouin","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/536244.html"},"it":{"name":"PARK TOUR : Visite gratuite Parc Roi Baudouin","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/536244.html"},"sp":{"name":"PARK TOUR : Visite gratuite Parc Roi Baudouin","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"web