s_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/5705e422ff8c3e977315d150d5226ade52495e95.jpg","width":2048,"height":1536,"ratio":1.33,"translations":{"fr":{"title":"De place en place","copyright":null},"nl":{"title":"De place en place","copyright":null},"en":{"title":"De place en place","copyright":null}}}],"dates":[{"day":"2022-05-29","doors":"14:00:00","start":"14:00:00","end":"16:00:00","is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":10}],"child_events":[],"parent_events":[],"targets":{"list":[11],"translations":{"fr":["Famille"],"nl":["Familie"],"en":["Family"]}},"visit_profile":{"list":[320],"translations":{"fr":["Classique"],"nl":["Klassiek"],"en":["Classic"]}},"tags":["exterior","kids"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-05-17T17:35:05+02:00","published_at":"2022-05-17T17:05:37+02:00","backoffice_id":253910,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":1},{"id":526002,"date_start":"2022-03-27","date_end":"2022-10-30","date_next":"2022-05-29","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{"list":[112],"translations":{"fr":["Insolite"],"nl":["Ongewoon"],"en":["Unusual"]}}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Dimanche \u00e0 v\u00e9lo","shortdescr":"Profitez du r\u00e9veil silencieux de la ville le dimanche matin. D\u00e9couvrez le plaisir du v\u00e9lo \u00e0 Bruxelles et les endroits surprenants de la ville et de sa p\u00e9riph\u00e9rie.","longdescr":"Profitez du r\u00e9veil silencieux de la ville le dimanche matin. Une balade \u00e0 v\u00e9lo agr\u00e9able, une excellente dose de mouvement et id\u00e9ale pour rencontrer d'autres Bruxellois !\r\n\r\nChaque mois, nous mettons en avant un coin vert surprenant dans la p\u00e9riph\u00e9rie de Bruxelles. Un(e) de nos guides tracera un itin\u00e9raire agr\u00e9able \u00e0 v\u00e9lo d'environ 25 \u00e0 30 km aller-retour. Apr\u00e8s avoir profit\u00e9 de l'endroit et avoir fait une petite pause, nous retournons \u00e0 v\u00e9lo au ensemble au centre-ville. \r\n\r\nRendez-vous \u00e0 10h00 au Grand Hospice, rue du Grand Hospice 7, 1000 Bruxelles. Vers 13h00 nous serons de retour!\r\n\r\nD\u00e9couvrez le programme sur notre site web! \r\nhttps:\/\/cactus.brussels\/dimanche-a-velo","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/526002.html"},"nl":{"name":"Dimanche \u00e0 v\u00e9lo","shortdescr":"Geniet mee van de nog stille ontwakende stad op zondagochtend. Ontdek het fietsen in Brussel en verrassende plekken in de stad en de rand.","longdescr":"Geniet mee van de nog stille ontwakende stad op zondagochtend.  Een gezellige fietstocht, een gezonde dosis beweging en ideaal om andere Brusselaars te ontmoeten !\r\n\r\nElke maand selecteren we een verrassende groene plek uit in de rand van Brussel. Daar fietsen we tijdens Dimanche \u00e0 v\u00e9lo naar toe! Onze gidsen stippelen een leuke route uit van zo\u2019n 25 \u00e0 30km. Na even van de plek te hebben genoten en de pauze keren we samen terug naar het centrum. \r\n\r\nAfspraak: 10u00 bij Grand Hospice in de Grootgodshuisstraat 7, 1000 Brussel. En rond 13u00 zijn we terug!\r\n\r\nOntdek het programma op onze website!\r\nhttps:\/\/cactus.brussels\/zondag-a-velo","performers":"Cactus Brussel \u00e0 v\u00e9lo","boxoffice_url":null,"website":"https:\/\/cactus.brussels\/zondag-a-velo","email":"info@cactus.brussels","phone_contact":null,"phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/526002.html"},"en":{"name":"Dimanche \u00e0 v\u00e9lo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/526002.html"},"de":{"name":"Dimanche \u00e0 v\u00e9lo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/526002.html"},"it":{"name":"Dimanche \u00e0 v\u00e9lo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/526002.html"},"sp":{"name":"Dimanche \u00e0 v\u00e9lo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/526002.html"},"pt":{"name":"Dimanche \u00e0 v\u00e9lo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/526002.html"},"cn":{"name":"Dimanche \u00e0 v\u00e9lo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/526002.html"}},"place":{"id":276966,"translations":{"fr":{"name":"Grand Hospice","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"hospice@pali-pali.com","website":"http:\/\/grand-hospice.brussels","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 7","address_line2":"1000 Bruxelles","description_web":"Projet d\u2019occupation temporaire du site de l'Hospice Pacheco. Rejoignez-nous du lundi au dimanche pour profiter de ce petit havre de paix en plein centre de Bruxelles.\r\nLe projet, g\u00e9r\u00e9 par PaliPali, prend place jusqu\u2019en d\u00e9cembre 2023. Pour faire vivre ce petit oasis de verdure, Pali Pali s\u2019est associ\u00e9 \u00e0 Jardin afin de g\u00e9rer la guinguette du site. L\u2019id\u00e9e est de mettre \u00e0 disposition des \u00e9quipements pour l\u2019ensemble du quartier selon deux principes : cr\u00e9er du lien et vivre ensemble.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Grand Hospice","address_street_name":"Grootgodshuisstraat","address_street_number":"7","address_street_box":null,"email":"hospice@pali-pali.com","website":"http:\/\/grand-hospice.brussels","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Grootgodshuisstraat, 7","address_line2":"1000 Brussel","description_web":"In afwachting van de grote renovatie die nodig is om een complex van wooneenheden en gemeenschapsdiensten te cre\u00ebren, heeft het Brusselse OCMW beslist het Hospice Pacheco ter beschikking te stellen voor een vernieuwend project met een sterke sociale en culturele ori\u00ebntatie.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Grand Hospice","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"hospice@pali-pali.com","website":"http:\/\/grand-hospice.brussels","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue du Grand Hospice, 7","address_line2":"1000 Brussels","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtua