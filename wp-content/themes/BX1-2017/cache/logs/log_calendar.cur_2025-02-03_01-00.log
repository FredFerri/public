:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700005319"},"cn":{"name":"les trois petits cochons","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/theatreperuchet.be\/programme\/","email":"contact@theatreperuchet.be","phone_contact":"+32 2 673 87 30","phone_booking":"+32 2 673 87 30","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700005319"},"fr":{"name":"les trois petits cochons","shortdescr":"D'apr\u00e8s la c\u00e9l\u00e8bre chanson m\u00e9di\u00e9vale et une fable d'Esope. Qui est le plus fort ? dans le ciel ? Et dans le bois joli ? Le soleil, la pluie ou le vent ? L'arc-en-ciel transforme trois petits princes en trois petits cochons. L'arc-en-ciel lib\u00e8re de son affiche le grand m\u00e9chant loup. Qui a peur du grand m\u00e9chant loup ? \nUn grand classique pour les enfants revisit\u00e9 par le Peruchet.  ","longdescr":null,"performers":"Th\u00e9\u00e2tre Royal du Peruchet et son \u00e9quipe","boxoffice_url":null,"website":"https:\/\/theatreperuchet.be\/programme\/","email":"contact@theatreperuchet.be","phone_contact":"+32 2 673 87 30","phone_booking":"+32 2 673 87 30","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700005319"},"sp":{"name":"les trois petits cochons","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/theatreperuchet.be\/programme\/","email":"contact@theatreperuchet.be","phone_contact":"+32 2 673 87 30","phone_booking":"+32 2 673 87 30","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700005319"},"nl":{"name":"de drie kleine varkentjes","shortdescr":"Gebaseerd op het beroemde middeleeuwse lied en de fabel van Aesop. Wie is de sterkste? In de lucht? En in het mooie bos? De zon, de regen of de wind? De regenboog verandert drie kleine prinsen in drie kleine varkentjes. De regenboog bevrijdt de grote boze wolf van zijn poster. Wie is er bang voor de grote boze wolf? \nEen grote kinderklassieker in een nieuw jasje van Peruchet.  ","longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/theatreperuchet.be\/programme\/","email":"contact@theatreperuchet.be","phone_contact":"+32 2 673 87 30","phone_booking":"+32 2 673 87 30","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700005319"}},"place":{"id":241472,"translations":{"de":{"name":"Th\u00e9\u00e2tre Royal du Peruchet","address_street_name":"Avenue de la For\u00eat","address_street_number":"50","address_street_box":null,"email":"info@theatreperuchet.be","website":"http:\/\/www.theatreperuchet.be","phone_contact":"+32 2 673 87 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue de la For\u00eat, 50","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Th\u00e9\u00e2tre Royal du Peruchet","address_street_name":"Avenue de la For\u00eat","address_street_number":"50","address_street_box":null,"email":"info@theatreperuchet.be","website":"http:\/\/www.theatreperuchet.be","phone_contact":"+32 2 673 87 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue de la For\u00eat, 50","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Th\u00e9\u00e2tre Royal du Peruchet","address_street_name":"Avenue de la For\u00eat","address_street_number":"50","address_street_box":null,"email":"info@theatreperuchet.be","website":"http:\/\/www.theatreperuchet.be","phone_contact":"+32 2 673 87 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue de la For\u00eat, 50","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_