ice_id":293047,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"tour","ranking":0.26622042768611637,"languages":{"spoken":["nl","fr"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{"list":[251],"translations":{"de":["Zeitgen\u00f6ssische Kunst "],"pt":[null],"en":["Contemporary Art"],"it":["Arte contemporanea "],"cn":[null],"fr":["Art Contemporain "],"sp":["Arte contempor\u00e1neo "],"nl":["Hedendaagse Kunst"]}}},"translations":{"de":{"name":"Family Funday","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.wiels.org","email":"welcome@wiels.org","phone_contact":"+32 2 340 00 53","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50006470"},"pt":{"name":"Family Funday","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.wiels.org","email":"welcome@wiels.org","phone_contact":"+32 2 340 00 53","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50006470"},"en":{"name":"Family Funday","shortdescr":"Visit WIELS together with your family during a Family Funday. Our enthusiastic guides will take you on an adventurous journey of discovery through one of our exhibitions. Together, you can interact with the artworks through playful activities and exciting stories. ","longdescr":"Visit WIELS on the first and third Sunday of the month during a Family Funday!\n\nOur enthusiastic guides will take you on an adventurous journey of discovery through one of our exhibitions. Together we interact with the artworks through playful activities and exciting stories. All this for the regular admission price (free for children). A fun, creative activity for the whole family!\n\nBilingual (FR\/NL)\nFree with entry ticket (free for -18)\nChildren aged between 2 and 12 years old","performers":null,"boxoffice_url":null,"website":"https:\/\/www.wiels.org","email":"welcome@wiels.org","phone_contact":"+32 2 340 00 53","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50006470"},"it":{"name":"Family Funday","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.wiels.org","email":"welcome@wiels.org","phone_contact":"+32 2 340 00 53","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50006470"},"cn":{"name":"Family Funday","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.wiels.org","email":"welcome@wiels.org","phone_contact":"+32 2 340 00 53","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50006470"},"fr":{"name":"Family Funday","shortdescr":"Visitez WIELS en famille \u00e0 l\u2019occasion d\u2019un Family Funday. Nos guides enthousiastes vous proposent un voyage de d\u00e9couverte aventureux \u00e0 travers une de nos expositions. Entrez en interaction avec les \u0153uvres d\u2019art gr\u00e2ce \u00e0 des activit\u00e9s ludiques et des r\u00e9cits palpitants. ","longdescr":"Venez visiter le WIELS avec votre famille chaque premier et troisi\u00e8me dimanche du mois lors de nos Family Fundays !\n\nNos guides enthousiastes vous emm\u00e8nent \u00e0 la d\u00e9couverte de l'une de nos expositions. Impr\u00e9gnez vous des \u0153uvres d'art \u00e0 travers des activit\u00e9s ludiques, interactives et des histoires passionnantes pour voir les \u0153uvres autrement. Et cela au prix d\u2019entr\u00e9e habituel (gratuit pour les enfants). Un plaisir garanti pour toute la famille !\n\n\nBilingue (FR\/NL)\nInclus dans le ticket (gratuit pour les -18 ans)\nPour les enfants entre 2 et 12 ans","performers":null,"boxoffice_url":null,"website":"https:\/\/www.wiels.org","email":"welcome@wiels.org","phone_contact":"+32 2 340 00 53","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50006470"},"sp":{"name":"Family Funday","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.wiels.org","email":"welcome@wiels.org","phone_contact":"+32 2 340 00 53","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50006470"},"nl":{"name":"Family Funday","shortdescr":"Bezoek WIELS samen met je familie tijdens een Family Funday. Onze enthousiaste gidsen nemen jullie mee op een avontuurlijke ontdekkingsreis door \u00e9\u00e9n van onze tentoonstellingen. Ga samen in interactie met de kunstwerken, door middel van speelse activiteiten en spannende verhalen. ","longdescr":"Kom elke eerste en derde zondag van de maand samen met je gezin naar WIELS naar onze Family Fundays!\n\nOnze enthousiaste gidsen nemen jullie mee op een avontuurlijke ontdekkingsreis door \u00e9\u00e9n van onze tentoonstellingen. Ga samen in interactie met de kunstwerken, door middel van speelse activiteiten en spannende verhalen. En dit voor de normale toegangsprijs (gratis voor kinderen).\nPlezier gegarandeerd voor de hele familie! \n\nTweetalig FR\/NL\nInbegrepen in het tentoonstellingsticket (gratis onder 18 jaar)\nKinderen tussen 2 en 12 jaar oud","performers":"Jef Geys, Oscar Murillo ","boxoffice_url":null,"website":"https:\/\/www.wiels.org","email":"welcome@wiels.org","phone_contact":"+32 2 340 00 53","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50006470"}},"place":{"last_updated_at":"2023-05-02T15:20:32+02:00","published_at":"2013-10-19T01:13:21+02:00","id":1490,"translations":{"de":{"name":"Wiels - Zentrum f\u00fcr moderne Kunst","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+ 32 (0)2-340.00.50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":"Das WIELS ist ein hochkar\u00e4tiges, internationales Labor f\u00fcr moderne Kunst, das sich nicht nur der Ausstellung von moderner Kunst sondern auch dem kreativen Entstehungsprozess widmet. Der Schwerpunkt liegt auf der visuellen Kunst, doch es werden auch ganz bewusst Schnittstellen mit anderen Disziplinen gesucht, die die Vielfalt und das Facettenreichtum der modernen Kunst aufzuzeigen. Dem Besucher offenbart sich ein permanenter Dialog mit den Entwicklungen der modernen Kunst und eine Debatte mit der Kunstwelt der Gegenwart.\r\n\r\nAuf drei Ebenen mit insgesamt 1800 m\u00b2 Ausstellungsfl\u00e4che finden regelm\u00e4\u00dfig Ausstellungen statt. Dar\u00fcber hinaus wird das WIELS regelm\u00e4\u00dfig Schauplatz von ausgew\u00e4hlten Filmvorf\u00fchrungen, Konferenzen, Festivals und Konzerten. \r\nUntergebracht ist das WIELS in dem eindrucksvollen Eckgeb\u00e4ude der ehemaligen Brauerei Wielemans-Ceuppens, das aus der Feder des modernistischen Architekten Adrien Blomm stammt. Von der Brauereivergangenheit zeugen noch heute die majest\u00e4tischen Kupferkessel.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Wiels - Centre d\u2019art contemporain","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+ 32 (0)2-340.00.50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Wiels - Contemporary art centre","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+ 32 (0)2-340.00.50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":"It was the brewer L\u00e9on Wielemans who asked his friend, the architect Adrien Blomme, to design and build the new buildings of his brewery in Forest. It became the leading monument of industrial archaeology in the art deco style, and houses now Wiels, an international laboratory for the creation and the diffusion of contemporary art. Focusing on visual arts, but granting a particular attention to the crossings and interactions with other disciplines, the centre wishes to present contemporary art in all its diversity and to offer a permanent dialogue with the developments and the most recent debates of the art world. The Art centre has a shop, a caf\u00e9 and offer an impressive panorama on the city. ","description_print":null,"booking_url":null,"sort_order":"WIELS - CONTEMPORARY ART CENTRE","virtual_visit":null,"visit_url":null},"it":{"name":"Wiels - Centre d\u2019art contemporain","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+ 32 (0)2-340.00.50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Wiels - Centre d\u2019art contemporain","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+ 32 (0)2-340.00.50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Wiels - Centre d\u2019art contemporain","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+ 32 (0)2-340.00.50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":"Le WIELS est un laboratoire international pour la cr\u00e9ation et la diffusion de l\u2019art contemporain. Ax\u00e9 sur les arts visuels, mais accordant une place et une attention particuli\u00e8res aux croisements et interactions avec d\u2019autres disciplines, le centre d\u00e9sire pr\u00e9senter l\u2019art contemporain dans toute sa diversit\u00e9 et mettre le public en contact et en dialogue permanents avec les d\u00e9veloppements et d\u00e9bats les plus r\u00e9cents du monde de l\u2019art. Le centre d'art dispose d'un magasin, d'un caf\u00e9 et d'un toit terrasse offrant une impressionnante vue sur la ville. ","description_print":null,"booking_url":null,"sort_order":"WIELS - CONTEMPORARY ART CENTRE","virtual_visit":null,"visit_url":null},"sp":{"name":"Wiels - Centro de arte contempor\u00e1neo","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+ 32 (0)2-340.00.50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":"Fue el amante de la cerveza L\u00e9on Wielemans quien le pidi\u00f3 a su amigo, el arquitecto Adrien Blomme, dise\u00f1ar y construir los nuevos edificios para su cervecer\u00eda en Forest. Se convirti\u00f3 en el monumento m\u00e1s importante de arqueolog\u00eda industrial en estilo art d\u00e9co, y ahora alberga Wiels, un laboratorio internacional para la creaci\u00f3n y difusi\u00f3n de arte contempor\u00e1neo. Poniendo el foco en las artes visuales, pero garantizando una particular atenci\u00f3n en el cruce y las interacciones con otras disciplinas, el centro pretende mostrar el arte contempor\u00e1neo en todos sus sentidos y ofrecer un di\u00e1logo permanente con su desarrollo y los debates m\u00e1s recientes del mundo del arte.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Wiels - Centrum voor hedendaagse kunst","address_street_name":"Van Volxemlaan","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+ 32 (0)2-340.00.50","phone_booking":null,"address_zip":"1190","address_city":"Vorst","address_line1":"Van Volxemlaan, 354","address_line2":"1190 Vorst","description_web":"Wiels is een toonaangevend internationaal platform voor de creatie en presentatie van hedendaagse kunst. Het centrum ontwikkelt een programma van tijdelijke activiteiten, zonder een permanente collectie uit te bouwen. Wiels organiseert zes tot acht grote tentoonstellingen per jaar die de evoluties in hedendaagse kunst op de voet volgen. Daarnaast loopt er een residentie en educatief programma en worden er lezingen, films, performances, debatten, ontmoetingen georganiseerd. Het kunstcentrum heeft een shop, een caf\u00e9 en een dakterras met een indrukwekkend uitzicht over de stad. ","description_print":null,"booking_url":null,"sort_order":"WIELS - CONTEMPORARY ART CENTRE","virtual_visit":null,"visit_url":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[21],"translations":{"de":["S\u00fcden"],"pt":[null],"en":["South"],"it":["Sud"],"cn":[null],"fr":["Sud"],"sp":["Sur"],"nl":["Zuid"]}},"neca":"art_center","facebook_id":"https:\/\/www.facebook.com\/WielsBrussels","backoffice_id":195,"location":{"lat":50.82467444,"lon":4.32636558},"region":"brussels","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"last_updated_at":"2023-05-02T15:20:32+02:00","published_at":"2013-10-19T01:13:21+02:00","id":1490,"translations":{"de":{"name":"Wiels - Zentrum f\u00fcr moderne Kunst","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+ 32 (0)2-340.00.50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":"Das WIELS ist ein hochkar\u00e4tiges, internationales Labor f\u00fcr moderne Kunst, das sich nicht nur der Ausstellung von moderner Kunst sondern auch dem kreativen Entstehungsprozess widmet. Der Schwerpunkt liegt auf der visuellen Kunst, doch es werden auch ganz bewusst Schnittstellen mit anderen Disziplinen gesucht, die die Vielfalt und das Facettenreichtum der modernen Kunst aufzuzeigen. Dem Besucher offenbart sich ein permanenter Dialog mit den Entwicklungen der modernen Kunst und eine Debatte mit der Kunstwelt der Gegenwart.\r\n\r\nAuf drei Ebenen mit insgesamt 1800 m\u00b2 Ausstellungsfl\u00e4che finden regelm\u00e4\u00dfig Ausstellungen statt. Dar\u00fcber hinaus wird das WIELS regelm\u00e4\u00dfig Schauplatz von ausgew\u00e4hlten Filmvorf\u00fchrungen, Konferenzen, Festivals und Konzerten. \r\nUntergebracht ist das WIELS in dem eindrucksvollen Eckgeb\u00e4ude der ehemaligen Brauerei Wielemans-Ceuppens, das aus der Feder des modernistischen Architekten Adrien Blomm stammt. Von der Brauereivergangenheit zeugen noch heute die majest\u00e4tischen Kupferkessel.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Wiels - Centre d\u2019art contemporain","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+ 32 (0)2-340.00.50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Wiels - Contemporary art centre","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+ 32 (0)2-340.00.50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":"It was the brewer L\u00e9on Wielemans who asked his friend, the architect Adrien Blomme, to design and build the new buildings of his brewery in Forest. It became the leading monument of industrial archaeology in the art deco style, and houses now Wiels, an international laboratory for the creation and the diffusion of contemporary art. Focusing on visual arts, but granting a particular attention to the crossings and interactions with other disciplines, the centre wishes to present contemporary art in all its diversity and to offer a permanent dialogue with the developments and the most recent debates of the art world. The Art centre has a shop, a caf\u00e9 and offer an impressive panorama on the city. ","description_print":null,"booking_url":null,"sort_order":"WIELS - CONTEMPORARY ART CENTRE","virtual_visit":null,"visit_url":null},"it":{"name":"Wiels - Centre d\u2019art contemporain","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+ 32 (0)2-340.00.50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":