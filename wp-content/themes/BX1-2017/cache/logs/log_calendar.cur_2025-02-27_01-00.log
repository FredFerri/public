mations","sp":"Animaciones","nl":"Animaties"}},"others":{"list":[99],"translations":{"de":["Gastronomie"],"pt":[null],"en":["Gastronomy"],"it":["Cucina"],"cn":[null],"fr":["Gastronomie"],"sp":["Gastronom\u00eda"],"nl":["Gastronomie"]}}},"translations":{"de":{"name":"Repair Caf\u00e9","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.roseraie.org\/four-a-pain","email":"quartier@roseraie.org","phone_contact":null,"phone_booking":"+32 2 376 46 45","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700006132"},"pt":{"name":"Repair Caf\u00e9","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.roseraie.org\/four-a-pain","email":"quartier@roseraie.org","phone_contact":null,"phone_booking":"+32 2 376 46 45","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700006132"},"en":{"name":"Fourn\u00e9e banale : cuisson du pain dans le four de la Roseraie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.roseraie.org\/four-a-pain","email":"quartier@roseraie.org","phone_contact":null,"phone_booking":"+32 2 376 46 45","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700006132"},"it":{"name":"Repair Caf\u00e9","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.roseraie.org\/four-a-pain","email":"quartier@roseraie.org","phone_contact":null,"phone_booking":"+32 2 376 46 45","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700006132"},"cn":{"name":"Repair Caf\u00e9","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.roseraie.org\/four-a-pain","email":"quartier@roseraie.org","phone_contact":null,"phone_booking":"+32 2 376 46 45","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700006132"},"fr":{"name":"Fourn\u00e9e banale : cuisson du pain dans le four de la Roseraie","shortdescr":"Renouer avec une tradition ancestrale !","longdescr":"Le four banal, c'est le moment o\u00f9 le four \u00e0 pain \u00e9tait allum\u00e9 pour tout le village et o\u00f9 chacun\u00b7e amenait son pain \u00e0 cuire. Un moment d'\u00e9change et de convialit\u00e9 durant les minutes de cuisson.\n\nVous pr\u00e9parez vos pains \u00e0 la maison, les laissez lever et venez les cuire \u00e0 13h30 dans le four de la Roseraie : un four qui a \u00e9t\u00e9 construit collectivement par l'\u00e9quipe du Four \u00e0 lier. C'est cette m\u00eame \u00e9quipe qui enfournera vos pains (max. 1 pain d'1kg ou 2 petits de 500g par personne, 40 minutes de cuisson) !\n\nLa r\u00e9servation par mail est obligatoire : quartier@roseraie.org\n\nEn cas de mauvais temps, les fourn\u00e9es pourraient \u00eatre annul\u00e9es, nous vous tiendrons dans ce cas au courant et reprogrammons une fourn\u00e9e.\n\n\n___________________\n\nAvec le soutien du Coll\u00e8ge des Bourgmestre et \u00c9chevins, de l\u2019\u00c9chevinat de la participation citoyenne de la commune d\u2019Uccle et de la Roseraie. Depuis septembre 2023, un four \u00e0 pain et un poulailler ont \u00e9t\u00e9 construits gr\u00e2ce \u00e0 une \u00e9quipe de b\u00e9n\u00e9voles en or et au soutien de l'initiative \"Inspirons le quartier\" (GoodFood).\n","performers":null,"boxoffice_url":null,"website":"https:\/\/www.roseraie.org\/four-a-pain","email":"quartier@roseraie.org","phone_contact":null,"phone_booking":"+32 2 376 46 45","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700006132"},"sp":{"name":"Repair Caf\u00e9","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.roseraie.org\/four-a-pain","email":"quartier@roseraie.org","phone_contact":null,"phone_booking":"+32 2 376 46 45","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700006132"},"nl":{"name":"Fourn\u00e9e banale : cui