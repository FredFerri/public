s:\/\/www.youtube.com\/embed\/zr7JEZRsUtQ?feature=oembed\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" allowfullscreen><\/iframe>","translations":{"fr":{"title":"Zombie Zombie - Heavy meditation"},"nl":{"title":"Zombie Zombie - Heavy meditation"},"en":{"title":"Zombie Zombie - Heavy meditation"}}},{"type":"video","link":"https:\/\/www.youtube.com\/watch?v=lhK7YQhaRlk","oEmbed_title":"Zombie Zombie, live Barcelona 24-09-2016, BAM 2016 Plac\u0327a dels A\u0300ngels","oEmbed_author_name":"El Arranzio","oEmbed_author_url":"https:\/\/www.youtube.com\/user\/ElArranzio","oEmbed_type":"video","oEmbed_height":200,"oEmbed_width":356,"oEmbed_version":"1.0","oEmbed_provider_name":"YouTube","oEmbed_provider_url":"https:\/\/www.youtube.com\/","oEmbed_thumbnail_height":360,"oEmbed_thumbnail_width":480,"oEmbed_thumbnail_url":"https:\/\/i.ytimg.com\/vi\/lhK7YQhaRlk\/hqdefault.jpg","oEmbed_html":"<iframe width=\"356\" height=\"200\" src=\"https:\/\/www.youtube.com\/embed\/lhK7YQhaRlk?feature=oembed\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" allowfullscreen><\/iframe>","translations":{"fr":{"title":"Zombie Zombie, live Barcelona 24-09-2016, BAM 2016 Plac\u0327a dels A\u0300ngels"},"nl":{"title":"Zombie Zombie, live Barcelona 24-09-2016, BAM 2016 Plac\u0327a dels A\u0300ngels"},"en":{"title":"Zombie Zombie, live Barcelona 24-09-2016, BAM 2016 Plac\u0327a dels A\u0300ngels"}}}],"dates":[{"day":"2022-06-16","doors":"19:30:00","start":"20:00:00","end":null,"is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":27.5},{"translations":{"fr":{"name":"Pr\u00e9vente"},"nl":{"name":"Voorverkoop"},"en":{"name":"Presale"}},"value":24.5}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":{"list":[252,255,256,259,263,265],"translations":{"fr":["Accessible aux personnes ayant des difficult\u00e9s de compr\u00e9hension","Accessible","Am\u00e9nagements pour les personnes aveugles et malvoyantes","Chien d'assistance","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9"],"nl":["Toegankelijk voor mensen met een verstandelijke beperking","Toegankelijk","Voorzieningen voor blinde en slechtziende personen","Assistentiehonden","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet"],"en":["Accessible to people with intellectual disabilities","Accessible","Facilities for blind and partially-sighted persons","Assistance dogs","Accessible to pedestrians with mobility aids","Adapted toilet"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-01-25T16:35:04+01:00","published_at":"2020-05-12T17:41:53+02:00","backoffice_id":217525,"import_origin":null,"sub_type":"concert","show_in_agenda":true,"ranking":2},{"id":533539,"date_start":"2022-06-17","date_end":"2022-06-17","date_next":"2022-06-17","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert"}},"others":{"list":[4,6],"translations":{"fr":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"],"nl":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"],"en":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Jazz Jette June: Tamala (S\u00e9n\u00e9gal) | Hazmat Modine (US) | Maguare XXL (cumbia)","shortdescr":"f\u00eate de la musique","longdescr":"Cette ann\u00e9e le Jazz Jette June se tient vendredi 17 juin sur la Place Reine Astrid. Ouverture des festivit\u00e9s avec Kalasa, spectacle de la compagnie Che cirque. Dr\u00f4le et touchant, le show m\u00eale musique, domptage d\u00e9cal\u00e9, cirque et bmx avec cr\u00e9ativit\u00e9.\r\n\r\nS\u2019ensuivra le trio Tamala : le mariage parfait entre la voix mandingue, la kora africaine et le violon europ\u00e9en, sur fond de kalimba et de percussions, le tout agr\u00e9ment\u00e9 de leurs talentueux invit\u00e9s surprises. Place ensuite aux New-Yorkais d\u2019Hazmat Modine. Un m\u00e9lange original, capturant avec brio la musique roots aux saveurs de la Nouvelle-Orl\u00e9ans allant du blues au funk, en passant par le jazz ou encore le calypso. En cl\u00f4ture, le groupe belgo-colombo-chilien aussi rythm\u00e9 que cuivr\u00e9 Maguar\u00e9 d\u00e9ploiera son orchestre XXL pour faire revivre la cumbia de l\u2019\u00e9poque d\u2019or des ann\u00e9es 60\u2032.\r\n\r\nNul doute que cette programmation pointue et conviviale fera passer un moment festif d\u2019exception \u00e0 tout un chacun !","performers":"Kalasa\r\nTamala: voix mandingue, kora africaine, violon, kalimba, percussions\r\nHazmat Modine\r\nMaguare","boxoffice_url":null,"website":"http:\/\/www.muziekpublique.be","email":"info@muziekpublique.be","phone_contact":null,"phone_booking":"+32 2 217 26 00","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/533539.html"},"nl":{"name":"Jazz Jette June: Tamala (Senegal) | Hazmat Modine (US) | Maguare XXL (cumbia)","shortdescr":"f\u00eate de la musique","longdescr":"Dit jaar vindt Jazz Jette June plaats op vrijdag 17 juni op het Konigin Astridplein. De festiviteiten worden geopend door Kalasa, het spectakel van de companie Che cirque. Voor de allereerste keer is er ook een samenwerking met Muziekpublique, waarbij wij de programmatie van deze vrijdagavond verzorgen.\r\n\r\nWe openen met het trio Tamala : het perfecte huwelijk van Mandingo-zang, Afrikaanse kora en Europese viool, tegen een achtergrond van kalimba en percussie, dit alles versterkt door hun getalenteerde verrassingsgasten. De volgende zijn de New Yorkers van Hazmat Modine. Een originele mix, die op briljante wijze rootsmuziek met een New Orleans tintje vastlegt, vari\u00ebrend van blues tot funk, via jazz en calypso. Als afsluiter zal de Belgisch-Colombiaans-Chileense groep Maguar\u00e9 zijn XXL-orkest inzetten om de cumbia uit de gouden periode van de jaren zestig te doen herleven.\r\n\r\nHet lijdt geen twijfel dat dit hoogstaande en gezellige programma iedereen een uitzonderlijk feestelijk moment zal bezorgen!","performers":"Kalasa\r\nTamala: mandingo-zang, Afrikaanse kora, viool, kalimba, percussie \r\nHazmat Modine\r\nMaguare","boxoffice_url":null,"website":"http:\/\/www.muziekpublique.be","email":"info@muziekpublique.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/533539.html"},"en":{"name":"Jazz Jette June: Tamala (Senegal) | Hazmat Modine (US) | Maguare XXL (cumbia)","shortdescr":"f\u00eate de la musique","longdescr":"This year Jette Jazz will take place on Friday 17 June at the Place Reine Astrid. The festivities will open with Kalasa, a spectacle performed by the company Che Cirque. Comical and touching, the show mixes music, alternative animal taming, circus and bmx with creativity.\r\n\r\nThen follows the trio Tamala: it\u2019s a perfect marriage of mandingo vocal art, the African kora and the European violin, against a background of kalimba and percussion, the whole thing enlivened by their talented surprise guests. They then make way for New York\u2019s Hazmat Modine. This is an original mixture, capturing with flair roots music with a touch of New Orleans, going from blues to funk via jazz or even calypso. To close, the Belgo-Colombo-Chilien Maguar\u00e9, full of rhythm and brass, will bring back to life the cumbia from the golden age of the sixties.\r\n\r\nThere\u2019s no possible doubt that this relevant and spectator-friendly programme will give everyone the chance o enjoy an exceptional festive time?!","performers":"Kalasa\r\nTamala: mandingo vocal art, African kora, violin, kalimba, percussion\r\nHazmat Modine\r\nMaguare","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/533539.html"},"de":{"name":"Jazz Jette June: Tamala (S\u00e9n\u00e9gal) | Hazmat Modine (US) | Maguare XXL (cumbia)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/533539.html"},"it":{"name":"Jazz Jette June: Tamala (S\u00e9n\u00e9gal) | Hazmat Modine (US) | Maguare XXL (cumbia)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/533539.html"},"sp":{"name":"Jazz Jette June: Tamala (S\u00e9n\u00e9gal) | Hazmat Modine (US) | Maguare XXL (cumbia)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/533539.html"},"pt":{"name":"Jazz Jette June: Tamala (S\u00e9n\u00e9gal) | Hazmat Modine (US) | Maguare XXL (cumbia)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/533539.html"},"cn":{"name":"Jazz Jette June: Tamala (S\u00e9n\u00e9gal) | Hazmat Modine (US) | Maguare XXL (cumbia)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/533539.html"}},"place":{"id":242513,"translations":{"fr":{"name":"Place Reine Astrid","address_street_name":null,"address_street_number":null,"address_street_box":null,"email"