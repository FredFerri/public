s_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2023-10-05T16:15:01+02:00","published_at":"2023-06-30T11:20:35+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":280954,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.32548726473766765,"languages":{"spoken":["fr","en"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[34,24],"translations":{"de":["Multidisziplin\u00e4r","Kunstgalerien"],"pt":[null,null],"en":["Multidisciplinary","Art Galleries"],"it":["Multidisciplinare","Gallerie d'arte"],"cn":[null,null],"fr":["Pluridisciplinaire","Galeries d'art"],"sp":["Multidisciplinar","Galer\u00edas de arte"],"nl":["Pluridisciplinair","Galeries"]}}},"translations":{"de":{"name":"Pedro Paix\u00e3o","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.irenelaubgallery.com","email":"info@irenelaubgallery.be","phone_contact":"+32 2 647 55 16","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.560954"},"pt":{"name":"Pedro Paix\u00e3o","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.irenelaubgallery.com","email":"info@irenelaubgallery.be","phone_contact":"+32 2 647 55 16","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.560954"},"en":{"name":"Pedro Paix\u00e3o - 'Fire and Spirits' curated by Sorana Munsya","shortdescr":"Ir\u00e8ne Laub gallery is delighted to present a solo show by Portuguese artist Pedro A.H. Paix\u00e3o, curated by Sorana Munsya.","longdescr":"The second solo exhibition \"Fire and Spirits\" by artist Pedro A.H Paixao at Ir\u00e8ne Laub gallery, presents the beginning of his new series of vermilion monochromatic works. \nHis powerful drawings embody the paradox that seems to inhabit this series: that of the cohabitation of light and darkness. Indeed, the artist's drawings depict scenes and characters illuminated by the fire of mystery, whose origins seem to spring from both history and fable. What is history becomes fable. The fable itself becomes hypnotizing, and seems to hold certain keys to history. In this way, the protagonists of Paixao's works invite those who observe them to let themselves be caught by the fire, to feed on the light from which truth might emerge.\n\nPedro A.H. Paix\u00e3o was born in Lobito, Angola, living there until the outbreak of the Civil War in 1975. He grew up in Lisbon, studying painting and drawing at Ar.Co \u2013 Arts and Visual Communication Center, Lisbon. He holds a M.F.A. in film and video from The School of The Art Institute of Chicago, and a Ph.D. in philosophy, from Faculty of Letters of the University of Porto. He won the international Navigator Art on Paper prize in 2018, and a major retrospective exhibition of his work was held at CIAJG, in Guimar\u00e3es (PT) that same year. Besides his work with other media \u2013 like sound, video, film, or the use of objects and slide diaporamas \u2013 Pedro A.H. Paix\u00e3o has mainly been creating a broad range of monochromatic graphic works, starting with a series of scarlet drawings developed between 2007 and 2017. Often dedicated to Central Africa in (neo)colonial times and the possibilities of reparation, these drawings address the complex topic of restitution and are a place where things are felt and thought anew - not under the trial of history and morality but under their own light, breaking preconceptions and misconceptions apart.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.irenelaubgallery.com","email":"info@irenelaubgallery.be","phone_contact":"+32 2 647 55 16","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.560954"},"it":{"name":"Pedro Paix\u00e3o","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.irenelaubgallery.com","email":"info@irenelaubgallery.be","phone_contact":"+32 2 647 55 16","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.560954"},"cn":{"name":"Pedro Paix\u00e3o","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.irenelaubgallery.com","email":"info@irenelaubgallery.be","phone_contact":"+32 2 647 55 16","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.560954"},"fr":{"name":"Pedro Paix\u00e3o - 'Fire and Spirits'","shortdescr":"La galerie Ir\u00e8ne Laub a le plaisir de pr\u00e9senter une exposition personnelle de l'artiste portugais Pedro A.H. Paix\u00e3o, sous la direction de Sorana Munsya.","longdescr":"L\u2019exposition solo \u00ab Fire and Spirits \u00bb de l\u2019artiste Pedro A.H Paixao met en sc\u00e8ne ce qui est le commencement de sa nouvelle s\u00e9rie compos\u00e9e d'\u0153uvres monochromatiques vermillon. \nSes dessins puissants renferment le paradoxe qui semble habiter cette s\u00e9rie: celle de la cohabitation entre lumi\u00e8re et obscurit\u00e9. En effet, les dessins que l\u2019artiste propose d\u00e9peignent des sc\u00e8nes et des personnages \u00e9clair\u00e9s par le feu du myst\u00e8re dont l\u2019origine para\u00eet na\u00eetre \u00e0 la fois de l\u2019histoire et de la fable. Ce qui est histoire se fait fable. La fable quant \u00e0 elle devient hypnotisante et semble renfermer certaines cl\u00e9s de l\u2019histoire. Ainsi, les protagonistes des \u0153uvres de Paixao invitent ceux qui les observent \u00e0 se laisser prendre par le feu, \u00e0 se nourrir de la lumi\u00e8re d\u2019o\u00f9 pourrait \u00e9merger la v\u00e9rit\u00e9. \n\nPedro A.H. Paixa\u0303o est ne\u0301 a\u0300 Lobito, Angola, ou\u0300 il a ve\u0301cu jusqu\u2019au de\u0301clenchement de la guerre civile en 1975. C\u2019est cependant a\u0300 Lisbonne qu\u2019il grandit, et ou\u0300 il e\u0301tudie la peinture et le dessin a\u0300 Ar. Co - Arts and Visual Communication Center, Lisbonne. Il est, e\u0301galement, titulaire d\u2019un M. F. A. en cine\u0301ma et vide\u0301o de la School of The Art Institute of Chicago et d\u2019un doctorat en philosophie de la faculte\u0301 des lettres de l\u2019Universite\u0301 de Porto. Il a remporte\u0301 le prix international Navigator Art on Paper en 2018, et la premie\u0300re grande re\u0301trospective de son travail a eu lieu la me\u0302me anne\u0301e au CIAJG, a\u0300 Guimara\u0303es (PT). Outre son travail avec d\u2019autres me\u0301dias - comme le son, la vide\u0301o, le film ou l\u2019utilisation d\u2019objets et de diaporamas - Pedro A. H. Paixa\u0303o cre\u0301e principalement des \u0153uvres monochromes re\u0301alise\u0301 au graphite. Dans certaines se\u0301ries de\u0301die\u0301es a\u0300 la pe\u0301riode (ne\u0301o)coloniale en Afrique Centrale et a\u0300 la possibilite\u0301 de re\u0301parations, il aborde la the\u0301matique complexe de la resitution et pre\u0301sente des oeuvres graphiques dans lesquelles le sujet est pense\u0301 et ressenti de fac\u0327on diffe\u0301rente - non pas comme un proce\u0300s de l\u2019histoire et de la moralite\u0301, mais avec une distance nouvelle qui permet de de\u0301passer les pre\u0301juge\u0301s et l\u2019incompre\u0301hension. ","performers":"Pedro A.H. Paixa\u0303o ","boxoffice_url":null,"website":"http:\/\/www.irenelaubgallery.com","email":"info@irenelaubgallery.be","phone_contact":"+32 2 647 55 16","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.560954"},"sp":{"name":"Pedro Paix\u00e3o","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.irenelaubgallery.com","email":"info@irenelaubgallery.be","phone_contact":"+32 2 647 55 16","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.560954"},"nl":{"name":"Pedro Paix\u00e3o - 'Fire and Spirits'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.irenelaubgallery.com","email":"info@irenelaubgallery.be","phone_contact":"+32 2 647 55 16","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.560954"}},"place":{"id":248003,"translations":{"de":{"name":"Ir\u00e8ne Laub Gallery ","address_street_name":"Rue Van Eyck","address_street_number":"29","address_street_box":null,"email":"info@irenelaubgallery.be","website":"http:\/\/www.irenelaubgallery.com","phone_contact":"+32 2 647 55 16","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Van Eyck, 29","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Ir\u00e8ne Laub Gallery ","address_street_name":"Rue Van Eyck","address_street_number":"29","address_street_box":null,"email":"info@irenelaubgallery.be","website":"http:\/\/www.irenelaubgallery.com","phone_contact":"+32 2 647 55 16","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Van Eyck, 29","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Ir\u00e8ne Laub Gallery","address_street_name":"Rue Van Eyck","address_street_number":"29","address_street_box":null,"email":"info@irenelaubgallery.be","website":"http:\/\/www.irenelaubgallery.com","phone_contact":"+32 2 647 55 16","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Van Eyck, 29","address_line2":"1050 Ixelles","description_web":"Since 2016, Ir\u00e8ne Laub Gallery exhibits established and emerging artists in Brussels and in a selection of international art fairs. Our represented artists are actively committed to questioning social, political and architectural spaces. They present a very diverse body of work \u2013 inculding installation, video, sculpture, painting and drawing \u2013 and display pure and powerful aesthetics. The gallery is intended as an adaptable experimentation space, allowing the artists to stretch the boundaries of their chosen discipline, either by testing and distorting the physical frame of the work itself, or by exploring its significance in the social sphere.\r\nIn 2018, the gallery moved to a new location and developed an ambitious exhibition programme, dedicated to further a productive dialogue between international artists, curators and institutions.\r\n","description_print":null,"booking_url":null,"sort_order":"LAUB","virtual_visit":null},"it":{"name":"Ir\u00e8ne Laub Gallery ","address_street_name":"Rue Van Eyck","address_street_number":"29","address_street_box":null,"email":"info@irenelaubgallery.be","website":"http:\/\/www.irenelaubgallery.com","phone_contact":"+32 2 647 55 16","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Van Eyck, 29","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Ir\u00e8ne Laub Gallery ","address_street_name":"Rue Van Eyck","address_street_number":"29","address_street_box":null,"email":"info@irenelaubgallery.be","website":"http:\/\/www.irenelaubgallery.com","phone_contact":"+32 2 647 55 16","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Van Eyck, 29","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"fr":{"name":"Ir\u00e8ne Laub Gallery ","address_street_name":"Rue Van Eyck","address_street_number":"29","address_street_box":null,"email":"inf