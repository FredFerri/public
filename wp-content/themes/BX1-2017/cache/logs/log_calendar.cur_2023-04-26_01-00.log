web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Fais le trottoir","address_street_name":"Jean Volderslaan","address_street_number":null,"address_street_box":null,"email":"visitegraffiti@gmail.com","website":"http:\/\/www.faisletrottoir.com","phone_contact":"+32 488 98 70 33","phone_booking":null,"address_zip":"1060","address_city":"Sint-Gillis","address_line1":"Jean Volderslaan","address_line2":"1060 Sint-Gillis","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Fais le trottoir","address_street_name":"Avenue Jean Volders","address_street_number":null,"address_street_box":null,"email":"visitegraffiti@gmail.com","website":"http:\/\/www.faisletrottoir.com","phone_contact":"+32 488 98 70 33","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Avenue Jean Volders","address_line2":"1060 Saint-Gilles","description_web":"The team of \"Fais le trottoir\" brings together passionate graffiti practitioners who have been working for several years for a better (re)knowledge of this movement by acting at different levels: organization of guided tours for all ages, organization of events (KAT), documentary production, publication of fanzines, participation in debates-conferences, creation of frescoes, networking of actors on the scene ...\r\nFais le Trottoir offers different types of guided tours led by two people including an artist. During these walks, we decode the signatures, explain the history and the working techniques and the mechanisms specific to this movement.\r\nAlong the way, we discover tags, graffiti, stencils, collages, stickers, murals ...","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Fais le trottoir","address_street_name":"Avenue Jean Volders","address_street_number":null,"address_street_box":null,"email":"visitegraffiti@gmail.com","website":"http:\/\/www