subtitles":[]},"categories":{"main":{"id":49,"translations":{"de":"Theater","pt":null,"en":"Theatre","it":"Teatro","cn":null,"fr":"Th\u00e9\u00e2tre","sp":"Teatro","nl":"Theater"}},"others":{}},"translations":{"de":{"name":"Parti en Fum\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.espacemagh.be\/projects\/parti-en-fumee\/?pr=19546&gr=1&post=projects&sa=976","email":"reservation@espacemagh.be","phone_contact":"+32 2 274 05 10","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700002818"},"pt":{"name":"Parti en Fum\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.espacemagh.be\/projects\/parti-en-fumee\/?pr=19546&gr=1&post=projects&sa=976","email":"reservation@espacemagh.be","phone_contact":"+32 2 274 05 10","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700002818"},"en":{"name":"Parti en fum\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.espacemagh.be\/projects\/parti-en-fumee\/?pr=19546&gr=1&post=projects&sa=976","email":"reservation@espacemagh.be","phone_contact":"+32 2 274 05 10","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700002818"},"it":{"name":"Parti en Fum\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.espacemagh.be\/projects\/parti-en-fumee\/?pr=19546&gr=1&post=projects&sa=976","email":"reservation@espacemagh.be","phone_contact":"+32 2 274 05 10","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700002818"},"cn":{"name":"Parti en Fum\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.espacemagh.be\/projects\/parti-en-fumee\/?pr=19546&gr=1&post=projects&sa=976","email":"reservation@espacemagh.be","phone_contact":"+32 2 274 05 10","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700002818"},"fr":{"name":"Parti en fum\u00e9e","shortdescr":"Dans Parti en fum\u00e9e, Othmane Moumen tente de d\u00e9chiffrer l\u2019\u00e9nigme de son p\u00e8re. Il y a sept ans, on lui a diagnostiqu\u00e9 un cancer des poumons en stade 4\u2026 le stade terminal. Depuis, il ne lui reste qu\u2019un poumon. Pourtant, son p\u00e8re est toujours l\u00e0. Comme un sursis inesp\u00e9r\u00e9. Et il continue \u00e0 fumer clope sur clope.","longdescr":"Le poumon, c\u2019est l\u2019organe de la tristesse chez les Chinois, para\u00eet-il. Alors, je me demande\u2026 Pourquoi il s\u2019inflige \u00e7a ? Pourquoi il n\u2019arr\u00eate pas ? Les questions affluent dans ma t\u00eate, face \u00e0 ce papa qui ne parle pas. Pourquoi a-t-il migr\u00e9 un jour ? Pourquoi ne bouge-t-il plus aujourd\u2019hui ? Pourquoi refuse-t-il de repartir ? Ce n\u2019est pas facile de lui tirer les vers du nez. La pudeur des p\u00e8res, quoi ! Mais je suis all\u00e9 l\u2019interroger. Je l\u2019ai enregistr\u00e9. J\u2019ai sa voix. Elle est l\u00e0, dans la bo\u00eete, pr\u00eate \u00e0 \u00eatre utilis\u00e9e.\n\nLors d\u2019un workshop de marionnettes avec Natacha Belova, Othmane Moumen construit de ses propres mains un double de son p\u00e8re, pour le faire parler. Ce temps gagn\u00e9 sur la mort est une occasion pour lui d\u2019approfondir l\u2019enqu\u00eate, de laisser son p\u00e8re se raconter par l\u2019interm\u00e9diaire de la marionnette, vite, avant qu\u2019il ne parte d\u00e9finitivement en fum\u00e9e\u2026 Othmane Moumen livre un dialogue attendrissant et non d\u00e9nu\u00e9 d\u2019humour, entre un fils et son p\u00e8re.\n(La billetterie n\u2019est pas encore ouverte.)","performers":null,"boxoffice_url":null,"website":"https:\/\/www.espacemagh.be\/projects\/parti-en-fumee\/?pr=19546&gr=1&post=projects&sa=976","email":"reservation@espacemagh.be","phone_contact":"+32 2 274 05 10","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700002818"},"sp":{"name":"Parti en Fum\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.espacemagh.be\/projects\/parti-en-fumee\/?pr=19546&gr=1&post=projects&sa=976","email":"reservation@espacemagh.be","phone_contact":"+32 2 274 05 10","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700002818"},"nl":{"name":"Parti en fum\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.espacemagh.be\/projects\/parti-en-fumee\/?pr=19546&gr=1&post=projects&sa=976","email":"reservation@espacemagh.be","phone_contact":"+32 2 274 05 10","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700002818"}},"place":{"id":247296,"translations":{"de":{"name":"Centre culturel Espace Magh asbl","address_street_name":"Rue du Poin\u00e7on","address_street_number":null,"address_street_box":null,"email":"info@espacemagh.be","website":"http:\/\/www.espacemagh.be","phone_contact":"+32 2 274 05 10","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Poin\u00e7on","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Centre culturel Espace Magh asbl","address_street_name":"Rue du Poin\u00e7on","address_street_number":null,"address_street_box":null,"email":"info@espacemagh.be","website":"http:\/\/www.espacemagh.be","phone_contact":"+32 2 274 05 10","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Poin\u00e7on","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"