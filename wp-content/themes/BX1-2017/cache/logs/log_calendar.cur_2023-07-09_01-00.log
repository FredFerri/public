"child_events":[],"parent_events":[],"targets":{"list":[11,10],"translations":{"fr":["Famille","Seniors"],"nl":["Familie","Senioren"],"en":["Family","Seniors"],"de":["Familie","Senioren"],"it":["Famiglie","Anziani"],"sp":["Familias","Personas de la tercera edad"],"pt":[null,null],"cn":[null,null]}},"tags":["exterior","kids"],"accessibilities":{"list":[252,255,261,263],"translations":{"fr":["Accessible aux personnes ayant des difficult\u00e9s de compr\u00e9hension","Accessible","Parking accessible","Accessible aux pi\u00e9tons appareill\u00e9s"],"nl":["Toegankelijk voor mensen met een verstandelijke beperking","Toegankelijk","Toegankelijke parking","Toegankelijk voor voetgangers met hulpmiddelen"],"en":["Accessible to people with intellectual disabilities","Accessible","Accessible parking","Accessible to pedestrians with mobility aids"],"de":["Barrierefrei f\u00fcr Menschen mit Verst\u00e4ndnisschwierigkeiten","Barrierefrei","Barrierefreier Parkplatz","Barrierefrei f\u00fcr Fu\u00dfg\u00e4nger mit Gehhilfe"],"it":["Accessibile alle persone con difficolt\u00e0 di comprensione","Accessibile","Parcheggio accessibile","Accessibile ai pedoni con supporti"],"sp":["Habilitado para personas con dificultades de comprensi\u00f3n","Habilitado","Estacionamiento habilitado","Habilitado para peatones con aud\u00edfonos"],"pt":[null,null,null,null],"cn":[null,null,null,null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2023-06-15T04:35:06+02:00","published_at":"2023-06-14T15:28:12+02:00","backoffice_id":279516,"import_origin":null,"sub_type":"other","show_in_agenda":true,"ranking":1},{"id":558823,"date_start":"2023-06-18","date_end":"2023-09-03","date_next":"2023-07-09","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater","it":"Teatro","sp":"Teatro","pt":null,"cn":null}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"],"de":["Theater"],"it":["Teatro"],"sp":["Teatro"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"R\u00e9v\u00e9lation !","shortdescr":"Cette grande annonce qui bouleverse tout","longdescr":"Dans ce spectacle, vous d\u00e9tenez la cl\u00e9 de l\u2019intrigue !\r\n\r\nAvant que cette pi\u00e8ce improvis\u00e9e ne commence, les com\u00e9diens vous posent quelques questions. O\u00f9 se trouvent les personnages ? Quelles sont leurs relations ?\r\nEt surtout, quelle est la r\u00e9v\u00e9lation que l\u2019un d\u2019entre eux va faire durant l\u2019histoire ?\r\n\r\nQue sera cette grande annonce ? L\u2019un des membres du groupe d\u2019amis a-t-il gagn\u00e9 au Lotto ? Maman a-t-elle d\u00e9cid\u00e9 de refaire sa vie avec un homme de 30 ans de moins qu\u2019elle ? Une vieille l\u00e9gende raconte-t-elle que ce lieu est hant\u00e9 ?\r\nCette r\u00e9v\u00e9lation va avoir l\u2019effet d\u2019une bombe sur les personnages et leurs relations et vous allez \u00eatre t\u00e9moins des cons\u00e9quences impr\u00e9visibles de cette bouleversante nouvelle.\r\n_________________________________________________________________________\r\nChaque saison, gr\u00e2ce \u00e0 la g\u00e9n\u00e9rosit\u00e9 des com\u00e9diens jouant b\u00e9n\u00e9volement ce spectacle, la moiti\u00e9 des recettes de ce spectacle permet de soutenir une association.\r\nPendant la saison 2022-2023, il s\u2019agit de l\u2019ASBL forestoise \"Centre d\u2019accueil d\u2019urgence Ariane\". L\u2019association a comme but l\u2019organisation de l\u2019aide psychosociale permanente, 24h\/24, 7j\/7 ainsi que l\u2019accueil, les soins et l\u2019accompagnement en situation de crise de chaque personne se trouvant sur le territoire de la R\u00e9gion de Bruxelles-Capitale.\r\nEn venant assister \u00e0 ce spectacle, vous faites donc \u00e9galement une bonne action !","performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Revelation","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.558823"},"nl":{"name":"R\u00e9v\u00e9lation !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Revelation","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.558823"},"en":{"name":"R\u00e9v\u00e9lation !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Revelation","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.558823"},"de":{"name":"R\u00e9v\u00e9lation !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Revelation","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.558823"},"it":{"name":"R\u00e9v\u00e9lation !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Revelation","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.558823"},"sp":{"name":"R\u00e9v\u00e9lation !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Revelation","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.558823"},"pt":{"name":"R\u00