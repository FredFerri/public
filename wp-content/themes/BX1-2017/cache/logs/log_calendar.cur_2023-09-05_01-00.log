ns":{"de":{"name":"Visite d\u00e9coloniale @ CENTRALE","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.centrale.brussels","email":"info@centrale.brussels","phone_contact":null,"phone_booking":"+32 2 279 64 57","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.561264"},"pt":{"name":"Visite d\u00e9coloniale @ CENTRALE","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.centrale.brussels","email":"info@centrale.brussels","phone_contact":null,"phone_booking":"+32 2 279 64 57","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.561264"},"en":{"name":"Guided tour on decolonisation @ CENTRALE (FR)","shortdescr":"As part of the exhibition extra by Mehdi-Georges Lahlou & guest Candice Breitz, CENTRALE invites you on a guided tour on decolonisation with Fran\u00e7ois Makanga.","longdescr":"As part of thdecolonizationxtra by Mehdi-Georges Lahlou & guest Candice Breitz, CENTRALE invites you on a guided tour with Fran\u00e7ois Makanga. Cultural activist, tour guide and specialist in decolonial issues, Fran\u00e7ois Makanga combines convergence and awareness of decolonial issues in (European) artistic creation. He is a member of bamko asbl.\r\n\r\nMore info: bamko.org","performers":"Fran\u00e7ois Makanga;","boxoffice_url":null,"website":"http:\/\/www.centrale.brussels","email":"info@centrale.brussels","phone_contact":null,"phone_booking":"+32 2 279 64 57","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.561264"},"it":{"name":"Visite d\u00e9coloniale @ CENTRALE","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.centrale.brussels","email":"info@centrale.brussels","phone_contact":null,"phone_booking":"+32 2 279 64 57","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.561264"},"cn":{"name":"Visite d\u00e9coloniale @ CENTRALE","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.centrale.brussels","email":"info@centrale.brussels","phone_contact":null,"phone_booking":"+32 2 279 64 57","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.561264"},"fr":{"name":"Visite d\u00e9coloniale @ CENTRALE","shortdescr":"Dans le cadre de l\u2019exposition extra de Mehdi-Georges Lahlou & guest Candice Breitz, la CENTRALE vous invite \u00e0 une visite d\u00e9coloniale avec Fran\u00e7ois Makanga.","longdescr":"Dans le cadre de l\u2019exposition extra de Mehdi-Georges Lahlou & guest Candice Breitz, la CENTRALE vous invite \u00e0 une visite guid\u00e9e avec Fran\u00e7ois Makanga. Activiste culturel, guide conf\u00e9rencier, sp\u00e9cialis\u00e9 en question d\u00e9coloniale, Fran\u00e7ois Makanga allie convergence et sensibilisation des enjeux d\u00e9coloniaux dans la cr\u00e9ation artistique (europ\u00e9enne). Il est membre de Bamko asbl.\r\n\r\nA propos\r\n\r\nBamko asbl est une association sans but lucratif de droit belge, cr\u00e9\u00e9e le 23 octobre 2010, c\u2019est la continuit\u00e9 d\u2019un mouvement cr\u00e9\u00e9 en 1987 \u00e0 Bruxelles.\r\n\r\nCompos\u00e9e d\u2019un comit\u00e9 majoritairement f\u00e9minin et afrodescendant qui \u0153uvre \u00e0 l\u2019\u00e9ducation populaire \u00e0 Bruxelles et en Wallonie \u00e0 travers des formations, des visites guid\u00e9es, et des publications d\u2019articles et de livres, Bamko asbl s\u2019adresse \u00e0 tous les publics d\u00e9sireux d\u2019en apprendre davantage sur l\u2019interculturalit\u00e9.\r\n\r\nL\u2019organisation propose \u00e9galement des services d\u2019accompagnement entrepreneuriaux, de m\u00e9diation scolaire, ou encore d\u2019aides socio-juridiques et administratives.\r\n\r\nAssociation de veille antiraciste au niveau national, Bamko asbl m\u00e8ne un v\u00e9ritable plaidoyer au niveau politique et m\u00e9diatique en impulsant le d\u00e9bat public sur les questions de d\u00e9fense des droits des personnes victimes de racisme, la d\u00e9colonisation de l\u2019espace public et le travail de m\u00e9moire sur l\u2019histoire coloniale Congolo-belge.\r\n\r\nPlus d\u2019information : bamko.org","performers":"Fran\u00e7ois Makanga;","boxoffice_url":null,"website":"http:\/\/www.centrale.brussels","email":"info@centrale.brussels","phone_contact":null,"phone_booking":"+32 2 279 64 57","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.561264"},"sp":{"name":"Visite d\u00e9coloniale @ CENTRALE","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.centrale.brussels","email":"info@centrale.brussels","phone_contact":null,"phone_booking":"+32 2 279 64 57","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.561264"},"nl":{"name":"Dekoloniale rondleiding @ CENTRALE (FR)","shortdescr":"In het kader van de tentoonstelling extra van Mehdi-Georges Lahlou & guest Candice Breitz, nodigt de CENTRALE u uit voor een dekoloniale rondleiding (FR) met Fran\u00e7ois Makanga.","longdescr":"In het kader van de tentoonstelling extra van Mehdi-Georges Lahlou & guest Candice Breitz, nodigt de CENTRALE u uit voor een rondleiding (FR) met Fran\u00e7ois Makanga. Fran\u00e7ois Makanga is een culturele activist en gids gespecialiseerd in dekolonisatie. Hij combineert verbinding en sensibilisering van dekoloniale kwesties in (Europese) artistieke creatie. Hij is lid van bamko vzw.\r\n\r\nMeer info: bamko.org","performers":"Fran\u00e7ois Makanga;","boxoffice_url":null,"website":"http:\/\/www.centrale.brussels","email":"info@centrale.brussels","phone_contact":null,"phone_booking":"+32 2 279 64 57","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.561264"}},"place":{"id":243546,"translations":{"de":{"name":"CENTRALE for contemporary art","address_street_name":"Place Sainte-Catherine","address_street_number":"44","address_street_box":null,"email":"info@centrale.brussels","websit