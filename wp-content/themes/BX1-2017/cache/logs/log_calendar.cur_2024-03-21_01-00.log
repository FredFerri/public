r":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/shop.utick.net\/?module=ACTIVITYSERIEDETAILS&pos=LEPETITCHAPEAURONDROUGE&s=8BE37564-9F11-783A-605B-9CA2C54EEF03","email":"coeursvagabonds@outlook.com","phone_contact":"+32 471 69 14 63","phone_booking":"+32 471 69 14 63","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50007772"},"en":{"name":"Pourvu qu'on ait l'ivresse | Spectacle cont\u00e9 pour adultes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/shop.utick.net\/?module=ACTIVITYSERIEDETAILS&pos=LEPETITCHAPEAURONDROUGE&s=8BE37564-9F11-783A-605B-9CA2C54EEF03","email":"coeursvagabonds@outlook.com","phone_contact":"+32 471 69 14 63","phone_booking":"+32 471 69 14 63","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50007772"},"it":{"name":"Pourvu qu'on ait l'ivresse | Spectacle cont\u00e9 pour adultes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/shop.utick.net\/?module=ACTIVITYSERIEDETAILS&pos=LEPETITCHAPEAURONDROUGE&s=8BE37564-9F11-783A-605B-9CA2C54EEF03","email":"coeursvagabonds@outlook.com","phone_contact":"+32 471 69 14 63","phone_booking":"+32 471 69 14 63","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50007772"},"cn":{"name":"Pourvu qu'on ait l'ivresse | Spectacle cont\u00e9 pour adultes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/shop.utick.net\/?module=ACTIVITYSERIEDETAILS&pos=LEPETITCHAPEAURONDROUGE&s=8BE37564-9F11-783A-605B-9CA2C54EEF03","email":"coeursvagabonds@outlook.com","phone_contact":"+32 471 69 14 63","phone_booking":"+32 471 69 14 63","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50007772"},"fr":{"name":"Pourvu qu'on ait l'ivresse | Spectacle cont\u00e9 pour adultes","shortdescr":"Ce conte pour adultes est un voyage qui secoue l\u2019\u00e2me, une aventure durant laquelle on chante et l\u2019on parle, on pleure et l\u2019on s\u2019amuse, on s\u2019interroge et l\u2019on esp\u00e8re. Pendant la repr\u00e9sentation, les deux artistes conteurs convoquent Ovide et Musset, Brel et Rabelais, Daudet et Baudelaire. La narration, aussi belle qu\u2019entra\u00eenante, ravira donc les c\u0153urs sensibles \u00e0 la magie du monde. ","longdescr":"\u00ab Pourvu qu\u2019on ait l\u2019ivresse \u00bb est un r\u00e9cit pour adultes, une travers\u00e9e po\u00e9tique et \u00e9mouvante, dr\u00f4le \u00e0 certains moments, parfois tragique, mais sensible d\u2019un bout \u00e0 l\u2019autre de la corde tendue au-dessus du vide. Car voil\u00e0 bien le th\u00e8me r\u00e9el de ce spectacle : le vide inh\u00e9rent \u00e0 toute existence, la vacuit\u00e9 \u00e0 la fois terrible et joyeuse laiss\u00e9e par le temps qui passe inexorablement, le n\u00e9ant absurde que nous promet la mort, le \u00ab creux n\u00e9ant musicien \u00bb que nous offre la vie.\n\nAu cours de ce spectacle, vous suivrez le parcours chaotique de Lilah, une trentenaire \u00e0 la d\u00e9rive qui \u00e9choue, par hasard, au Pays de l'ivresse. Cet endroit pittoresque et chaleureux abrite Margot, la reine des lieux, et cinq moines tr\u00e8s particuliers. Ceux-ci racontent des histoires inspir\u00e9es des \u0153uvres d\u2019Ovide, de Rabelais ou de Daudet, tandis que Margot pousse la chansonnette.\n\nDurant une heure et demie, une quinzaine de personnages prendront vie sous vos yeux. Vous voyagerez d\u2019un bistrot au sommet d\u2019une montage, vous passerez du rire aux larmes, et vous repartirez peut-\u00eatre heureux d\u2019avoir pleur\u00e9.\n\nPOURVU QU\u2019ON AIT L\u2019IVRESSE\nUn spectacle cont\u00e9 pour adultes\n\u00c9crit et interpr\u00e9t\u00e9 par la Compagnie des c\u0153urs vagabonds\nArtistes : Simone Balthazar et Beno\u00eet Vincent\nDur\u00e9e : 1 h 40\nPensez \u00e0 r\u00e9server vos places ! :-)","performers":"Compagnie des c\u0153urs vagabonds\nDistribution : Simone BALTHAZAR & Beno\u00eet VINCENT\nCr\u00e9ation et \u00e9criture : Simone BALTHAZAR \n\nLa Compagnie des c\u0153urs vagabonds chemine pieds nus et cheveux au vent sur les sentiers de la parole et du silence. Elle se reconna\u00eet pleinement dans la fraternit\u00e9 des gens de peu. Amoureuse de la vie et de la libert\u00e9, elle cr\u00e9e des r\u00e9cits qu\u2019elle porte \u00e0 la sc\u00e8ne avec passion.","boxoffice_url":null,"website":"https:\/\/shop.utick.net\/?module=ACTIVITYSERIEDETAILS&pos=LEPETITCHAPEAURONDROUGE&s=8BE37564-9F11-783A-605B-9CA2C54EEF03","email":"coeursvagabonds@outlook.com","phone_contact":"+32 471 69 14 63","phone_booking":"+32 471 69 14 63","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50007772"},"sp":{"name":"Pourvu qu'on ait l'ivresse | Spectacle cont\u00e9 pour adultes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/shop.utick.net\/?module=ACTIVITYSERIEDETAILS&pos=LEPETITCHAPEAURONDROUGE&s=8BE37564-9F11-783A-605B-9CA2C54EEF03","email":"coeursvagabonds@outlook.com","phone_contact":"+32 471 69 14 63","phone_booking":"+32 471 69 14 63","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50007772"},"nl":{"name":"Pourvu qu'on ait l'ivresse | Spectacle cont\u00e9 pour adultes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/shop.utick.net\/?module=ACTIVITYSERIEDETAILS&pos=LEPETITCHAPEAURONDROUGE&s=8BE37564-9F11-783A-605B-9CA2C54EEF03","email":"coeursvagabonds@outlook.com","phone_contact":"+32 471 69 14 63","phone_booking":"+32 471 69 14 63","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50007772"}},"place":{"id":248422,"translations":{"de":{"name":"Le Petit Chapeau Rond Rouge","address_street_name":"Rue P\u00e8re Eudore Devroye","address_street_number":"12","address_street_box":null,"email":"info@lepetitchapeaurondrouge.be","website":"http:\/\/www.lepetitchapeauron