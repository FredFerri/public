\r\n\r\nAvec : Philippe Drecq, Barnab\u00e9 Dekeyser, St\u00e9fanie Greco, Anne-Isabelle Justens, Juan Marquez Garcia et Michael Manconi","boxoffice_url":null,"website":"http:\/\/www.magicland-theatre.com","email":"info@magicland-theatre.com","phone_contact":"+32 2 245 50 64","phone_booking":"+32 2 245 50 64","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.541130"},"nl":{"name":"Visa pour P\u00e9kin","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.541130"},"en":{"name":"Visa pour P\u00e9kin","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.541130"},"de":{"name":"Visa pour P\u00e9kin","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.541130"},"it":{"name":"Visa pour P\u00e9kin","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.541130"},"sp":{"name":"Visa pour P\u00e9kin","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.541130"},"pt":{"name":"Visa pour P\u00e9kin","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.541130"},"cn":{"name":"Visa po