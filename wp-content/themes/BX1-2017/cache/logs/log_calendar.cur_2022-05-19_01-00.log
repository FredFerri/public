":{"name":"Enfants"},"nl":{"name":"Kinderen"},"en":{"name":"Children"}},"value":5},{"translations":{"fr":{"name":"Jeunes"},"nl":{"name":"Jongeren"},"en":{"name":"Young"}},"value":9},{"translations":{"fr":{"name":"Senior"},"nl":{"name":"Senioren"},"en":{"name":"Senior"}},"value":9},{"translations":{"fr":{"name":"museumpassmus\u00e9es"},"nl":{"name":"museumpassmus\u00e9es"},"en":{"name":"museumpassmus\u00e9es"}},"value":0},{"translations":{"fr":{"name":"Article 27"},"nl":{"name":"Artikel 27"},"en":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"visit_profile":{"list":[321,337],"translations":{"fr":["Bande Dessin\u00e9e","Highlight"],"nl":["Stripverhaal","Highlight"],"en":["Comic Strip","Highlight"]}},"tags":[],"accessibilities":{"list":[252,255,256,257,259,263,265],"translations":{"fr":["Accessible aux personnes ayant des difficult\u00e9s de compr\u00e9hension","Accessible","Am\u00e9nagements pour les personnes aveugles et malvoyantes","Am\u00e9nagements pour personnes sourdes et malentendantes","Chien d'assistance","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9"],"nl":["Toegankelijk voor mensen met een verstandelijke beperking","Toegankelijk","Voorzieningen voor blinde en slechtziende personen","Voorzieningen voor dove en slechthorende personen","Assistentiehonden","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet"],"en":["Accessible to people with intellectual disabilities","Accessible","Facilities for blind and partially-sighted persons","Facilities for deaf and hearing-impaired people","Assistance dogs","Accessible to pedestrians with mobility aids","Adapted toilet"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-05-18T01:07:04+02:00","published_at":"2022-01-19T17:12:47+01:00","backoffice_id":245797,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.43233287816535},{"id":529256,"date_start":"2022-04-07","date_end":"2022-08-21","date_next":"2022-05-18","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[36,46],"translations":{"fr":["Mus\u00e9es et art centers","Pluridisciplinaire"],"nl":["Musea en kunstcentra","Multidisciplinair"],"en":["Museums and art centers","Multidisciplinary"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Michel Polak","shortdescr":"Architecte et esth\u00e8te m\u00e9connu, Michel Polak (1885-1948) est l\u2019auteur de nombreux b\u00e2timents pourtant embl\u00e9matiques de la Ville de Bruxelles \u00e0 l\u2019instar du R\u00e9sidence Palace, l\u2019h\u00f4tel Plaza ou encore la Villa Empain. Sa carri\u00e8re s\u2019\u00e9tend sur toute la premi\u00e8re moiti\u00e9 du XXe si\u00e8cle et est \u00e0 l\u2019image de cette \u00e9poque en pleine effervescence culturelle et esth\u00e9tique.","longdescr":"Architecte et esth\u00e8te m\u00e9connu, Michel Polak (1885-1948) est l\u2019auteur de nombreux b\u00e2timents pourtant embl\u00e9matiques de la Ville de Bruxelles \u00e0 l\u2019instar du R\u00e9sidence Palace, l\u2019h\u00f4tel Plaza ou encore la Villa Empain. Sa carri\u00e8re s\u2019\u00e9tend sur toute la premi\u00e8re moiti\u00e9 du XXe si\u00e8cle et est \u00e0 l\u2019image de cette \u00e9poque en pleine effervescence culturelle et esth\u00e9tique.\r\n\r\nSi l\u2019\u0153uvre de Polak est repr\u00e9sentative des styles de la fin du XIXe si\u00e8cle et de la premi\u00e8re moiti\u00e9 du XXe si\u00e8cle, elle se distingue par son opulence et son luxe. A travers ses r\u00e9alisations transpara\u00eet l\u2019\u00e9volution du m\u00e9tier de l\u2019architecte vers l\u2019architecte-artiste et un int\u00e9r\u00eat croissant pour l\u2019Orient, l\u2019Art africain et les d\u00e9couvertes en \u00e9gyptologie.\r\n\r\nL\u2019exposition propose une relecture de l\u2019\u0153uvre de Michel Polak \u00e0 la lumi\u00e8re des bouleversements historiques, technologiques et stylistiques de l\u2019\u00e9poque. Comment l\u2019architecte s\u2019ins\u00e8re et se distingue de l\u2019esth\u00e9tique en vogue, r\u00e9interpr\u00e8te les codes en vigueur, absorbe les d\u00e9couvertes de son temps et se positionne vis-\u00e0-vis de ses contemporains. Un parcours jalonn\u00e9 de documents d\u2019archives rares, de photos d\u2019\u00e9poque, de plans originaux, de films in\u00e9dits permettra un \u00e9clairage nouveau sur le travail de l\u2019architecte.\r\n\r\nCommissaires : St\u00e9phanie De Blieck & Manon Magotteaux\r\n\r\nL\u2019exposition est con\u00e7ue avec la Fondation CIVA\r\navec le soutien de CINEMATEK","performers":null,"boxoffice_url":null,"website":"http:\/\/www.villaempain.com","email":"info@boghossianfoundation.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/529256.html"},"nl":{"name":"Michel Polak","shortdescr":"Michel Polak is een weinig bekend architect en estheet die nochtans het artistieke brein is achter talrijke kenmerkende gebouwen in Brussel zoals het R\u00e9sidence Palace, het Plaza Hotel en de Villa Empain. Zijn carri\u00e8re omspant de gehele eerste helft van de 20ste eeuw en weerspiegelt deze periode van culturele en esthetische bloei.","longdescr":"Michel Polak (1885-1948) is een weinig bekend architect en estheet die nochtans het artistieke brein is achter talrijke kenmerkende gebouwen in Brussel zoals het R\u00e9sidence Palace, het Plaza Hotel en de Villa Empain. Zijn carri\u00e8re omspant de gehele eerste helft van de 20ste eeuw en weerspiegelt deze periode van culturele en esthetische bloei.\r\n\r\nOok al is het werk van Polak representatief voor de stijlen van het einde van de 19e eeuw en de eerste helft van de 20ste eeuw, toch onderscheidt het zich door zijn weelde en luxe. Zijn werk toont de evolutie van het beroep van architect naar architect-kunstenaar en een groeiende belangstelling voor het Oosten, Afrikaanse kunst en de ontdekkingen uit het Oude Egypte.\r\n\r\nDe tentoonstelling biedt een herlezing van het werk van Michel Polak in het licht van de historische, technologische en stilistische omwentelingen van die tijd. Ze toont hoe de architect zich conformeert en tegelijkertijd onderscheidt van de heersende esthetiek, de geldende codes herinterpreteert, de ontdekkingen van zijn tijd integreert in zijn werk en hoe hij zich positioneert ten opzichte van zijn tijdgenoten. Een parcours met zeldzame archiefdocumenten, historische foto\u2019s, originele plannen en niet eerder vertoonde films werpt een nieuw licht op het werk van de architect.\r\n\r\nCuratoren : St\u00e9phanie De Blieck & Manon Magotteaux\r\n\r\nDe tentoonstelling is ontworpen met de CIVA Stichting\r\nmet de steun van CINEMATEK","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/529256.html"},"en":{"name":"Michel Polak","shortdescr":"Sometimes overlooked, architect and aesthete Michel Polak nonetheless created many buildings that are now seen as emblematic of the City of Brussels, among them the Residence Palace, the Hotel Plaza and the Villa Empain. His career, spanning the entire first half of the 20th century, mirrors this culturally and aesthetically effervescent period.","longdescr":"Sometimes overlooked, architect and aesthete Michel Polak (1885-1948) nonetheless created many buildings that are now seen as emblematic of the City of Brussels, among them the Residence Palace, the Hotel Plaza and the Villa Empain. His career, spanning the entire first half of the 20th century, mirrors this culturally and aesthetically effervescent period.\r\n\r\nCurators: St\u00e9phanie De Blieck & Manon Magotteaux\r\n\r\nThe exhibition is conceived with the CIVA Foundation\r\nwith the support of CINEMATEK\r\n\r\nRepresentative of the styles of the late 19th century and the first half of the 20th century, Polak\u2019s work stands out for its opulence and luxury. Via his creations we see the profession of architect evolve towards that of architect-artist and a growing interest in the East, in African art and in discoveries in Egyptology.\r\n\r\nThe exhibition offers a rereading of Michel Polak\u2019s work in the light of the historical, technological and stylistic upheavals of the time, showing him both accommodating himself to and standing out from the prevailing aesthetics, reinterpreting the codes in force, absorbing the discoveries of his time and positioning himself vis-\u00e0-vis his contemporaries. An exhibition circuit with rare archive documents, period photos, original plans and previously unseen films will shed new light on the architect\u2019s work.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/529256.html"},"de":{"name":"Michel Polak","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/529256.html"},"it":{"name":"Michel Polak","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/529256.html"},"sp":{"name":"Michel Polak","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/529256.html"},"pt":{"name":"Michel Polak","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/529256.html"},"cn":{"name":"Michel Polak","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/529256.html"}},"place":{"id":248760,"translations":{"fr":{"name":"Fondation Boghossian \u2013 Villa Empain","address_street_name":"Avenue Franklin Roosevelt","address_street_number":"67","address_street_box":null,"email":"info@boghossianfoundation.be","website":"http:\/\/www.villaempain.com","phone_contact":"+32 2 627 52 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Franklin Roosevelt, 67","address_line2":"1050 Ixelles","description_web":"La Villa Empain, remarquable t\u00e9moin de l\u2019architecture Art d\u00e9co, abrite la Fondation Boghossian, centre d\u2019art et de dialogue entre les culture d\u2019Orient et d\u2019Occident. Une programmation riche et vari\u00e9e de performances, conf\u00e9rences, \u00e9v\u00e9nements festifs, rencontres internationales, visites guid\u00e9es et activit\u00e9s pour enfants est propos\u00e9e au public.","description_print":"Dans la prestigieuse villa Empain, cette fondation vise \u00e0 d\u00e9velopper \u00e0 Bruxelles un centre de cr\u00e9ation et de dialogue entre l\u2019Orient et l\u2019Occident. Une programmation vari\u00e9e d\u2019activit\u00e9s culturelles est pr\u00e9vue pour le public.","booking_url":null,"sort_order":"BOGHOSSIAN FOUNDATION - VILLA EMPAIN","virtual_visit":null},"nl":{"name":"Boghossian Stichting - Villa Empain","address_street_name":"Franklin Rooseveltlaan","address_street_number":"67","address_street_box":null,"email":"info@boghossianfoundation.be","website":"http:\/\/www.villaempain.com","phone_contact":"+32 2 627 52 30","phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"Franklin Rooseveltlaan, 67","address_line2":"1050 Elsene","description_web":"Een centrum voor kunst en dialoog tussen de oosterse en de westerse cultuur . E\u00e9n van de belangrijkste doelstellingen van de Boghossian-stichting is het oprichten van een centrum van culturele en artistieke dialoog tussen het Oosten en het Westen. Haar uitvalsbasis is de prestigieuze villa Empain, waarin ze allerhande culturele activiteiten organiseert voor het publiek.","description_print":"Een centrum voor kunst en dialoog tussen de oosterse en de westerse cultuur . E\u00e9n van de belangrijkste doelstellingen van de Boghossian-stichting is het oprichten van een centrum van culturele en artistieke dialoog tussen het Oosten en het Westen. Haar uitvalsbasis is de prestigieuze villa Empain, waarin ze allerhande culturele activiteiten organiseert voor het publiek.","booking_url":null,"sort_order":"BOGHOSSIAN FOUNDATION - VILLA EMPAIN","virtual_visit":null},"en":{"name":"Boghossian Foundation - Villa Empain","address_street_name":"Avenue Franklin Roosevelt","address_street_number":"67","address_street_box":null,"email":"info@boghossianfoundation.be","website":"http:\/\/www.villaempain.com","phone_contact":"+32 2 627 52 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Franklin Roosevelt, 67","address_line2":"1050 Ixelles","description_web":"A villa in Art Deco style which is now home to the Boghossian Foundation: a centre for art and dialogue between Oriental and Western culture.\r\n\r\n  ","description_print":"A villa in Art Deco style which is now home to the Boghossion Foundation: a centre for art and dialogue between Oriental and Western culture.","booking_url":null,"sort_order":"BOGHOSSIAN FOUNDATION - VILLA EMPAIN","virtual_visit":null},"de":{"name":"Boghossian-Stiftung \u2013 Villa Empain","address_street_name":"Avenue Franklin Roosevelt","address_street_number":"67","address_street_box":null,"email":"info@boghossianfoundation.be","website":"http:\/\/www.villaempain.com","phone_contact":"+32 2 627 52 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Franklin Roosevelt, 67","address_line2":"1050 Ixelles","description_web":"Die Anfang der 1930er-Jahre erbaute Villa Empain ist ein bemerkenswertes Beispiel der Art D\u00e9co-Architektur. Sie geh\u00f6rte einst einer der reichsten Familien Europas, die heute fast vollst\u00e4ndig verarmt ist. Die Villa steht seit 2007 unter Denkmalschutz.\r\n\r\nJugendstil, Art D\u00e9co und Moderne: Ihr Architekt Michel Polak (1885\u20131948) kombinierte Zierelemente des Br\u00fcsseler Jugendstils mit Formen der Moderne: Ein Gesamtkunstwerk, bei dem Formen und edle Materialien der eleganten Ausstattung untrennbar zu einer ungew\u00f6hnlichen und imposanten Einheit verschmelzen.\r\n\r\nVom drohenden Verfall zur aufwendigen Restaurierung: Nach der zwischenzeitlichen Nutzung als sowjetische Botschaft und als Studio des Fernsehsenders RTL wurde die Villa nach aufwendiger Restaurierung zur imposanten Kulisse der Kulturstiftung Fondation Boghossian.","description_print":"","booking_url":null,"sort_order":"BOGHOSSIAN FOUNDATION - VILLA EMPAIN","virtual_visit":null},"it":{"name":"Fondation Boghossian \u2013 Villa Empain","address_street_name":"Avenue Franklin Roosevelt","address_street_number":"67","address_street_box":null,"email":"info@boghossianfoundation.be","website":"http:\/\/www.villaempain.com","phone_contact":"+32 2 627 52 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Franklin Roosevelt, 67","address_line2":"1050 Ixelles","description_web":"La Villa Empain \u00e8 uno straordinario esempio di architettura Art Deco costruita all'inizio degli anni '30. Oggi ospita il Centro de'Art e Dialogo tra Oriente e Occidente....\r\n\r\nLa Villa Empain \u00e8 uno straordinario esempio di architettura Art Deco costruita all'inizio degli anni '30. Oggi ospita il Centro de'Art e Dialogo tra Oriente e Occidente.\r\nVilla Empain \u00e8 anche la sede internazionale della Fondazione Boghossian, che opera in molti paesi dal 1992.\r\nEdificio classificato dal 2007, \u00e8 stata interamente restaurata seguendo scrupolosamente le strutture originali.\r\n\r\nDa non perdere.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Villa Empain, Fundaci\u00f3n Boghossian","address_street_name":"Avenue Franklin Roosevelt","address_street_number":"67","address_street_box":null,"email":"info@boghossianfoundation.be","website":"http:\/\/www.villaempain.com","phone_contact":"+32 2 627 52 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Franklin Roosevelt, 67","address_line2":"1050 Ixelles","description_web":"La Villa Empain es un testigo destacado de la arquitectura Art d\u00e9co.\r\nConstruida a principios de los a\u00f1os 1930 y ubicada en el centro de la capital europea, se ha convertido en un Centro de Arte y de Di\u00e1logo imprescindible.\u00a0\r\n\r\nEs igualmente la sede internacional de la Fundaci\u00f3n Boghossian, que trabaja en distintos pa\u00edses desde el a\u00f1o 1992. Declarado monumento en el a\u00f1o 2007, ha sido restaurando siguiendo los criterios del edificio original.\u00a0A fecha de hoy, alberga diferentes exposiciones y actividades.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Fondation Boghossian \u2013 Villa Empain","address_street_name":"Avenue Franklin Roosevelt","address_street_number":"67","address_street_box":null,"email":"info@boghossianfoundation.be","website":"http:\/\/www.villaempain.com","phone_contact":"+32 2 627 52 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Franklin Roosevelt, 67","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":n