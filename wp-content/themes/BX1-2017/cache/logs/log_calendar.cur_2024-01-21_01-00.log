russels\/en\/visitors\/agenda\/event-detail.50002435"},"it":{"name":"Ver\u00f3nica Codesal, Didier Laloy & Damien Chierici \u00ab 100 Voltas \u00bb @Th\u00e9\u00e2tre Mercelis","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.jeunessesmusicales.be\/bruxelles\/veronica-codesal-didier-laloy-damien-chierici-100-voltas-theatre-mercelis\/","email":"jmbxl@jeunessesmusicales.be","phone_contact":"+32 2 897 01 70","phone_booking":"+32 2 897 01 70","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50002435"},"cn":{"name":"Ver\u00f3nica Codesal, Didier Laloy & Damien Chierici \u00ab 100 Voltas \u00bb @Th\u00e9\u00e2tre Mercelis","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.jeunessesmusicales.be\/bruxelles\/veronica-codesal-didier-laloy-damien-chierici-100-voltas-theatre-mercelis\/","email":"jmbxl@jeunessesmusicales.be","phone_contact":"+32 2 897 01 70","phone_booking":"+32 2 897 01 70","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50002435"},"fr":{"name":"Ver\u00f3nica Codesal, Didier Laloy & Damien Chierici \u00ab 100 Voltas \u00bb","shortdescr":"Arm\u00e9e de sa pandeireta (petit tambourin) et de ses cunchas (coquilles), 100 Voltas habille les m\u00e9lodies anciennes de textes de po\u00e9tesses et po\u00e8tes galicien\u00b7nes principalement contemporain\u00b7es, en pr\u00e9servant l\u2019essence du pass\u00e9 tout en le modernisant gr\u00e2ce \u00e0 l\u2019incorporation de diff\u00e9rents instruments et leurs effets : violon, accord\u00e9on diatonique, stompbox\u2026","longdescr":"Airs trad de Galice sur po\u00e9sie contemporaine\n\n100 VOLTAS s\u2019impr\u00e8gne des traditions de Galice, une r\u00e9gion d\u2019Espagne situ\u00e9e \u00e0 la fronti\u00e8re du Portugal. Ver\u00f3nica Codesal, dont la famille a fui le franquisme pour la Belgique, est retourn\u00e9e dans sa r\u00e9gion d\u2019origine et a parcouru les villages pour recueillir les chants aupr\u00e8s des ancien\u00b7nes. Ce patrimoine a souffert jusque dans les ann\u00e9es 80 de d\u00e9cennies d\u2019interdiction du galicien, depuis revaloris\u00e9 comme l\u2019une des quatre langues officielles d\u2019Espagne.\n\nArm\u00e9e de sa pandeireta (petit tambourin) et de ses cunchas (coquilles), Ver\u00f3nica habille les m\u00e9lodies anciennes de textes de po\u00e9tesses et po\u00e8tes galicien\u00b7nes principalement contemporain\u00b7es, dont certains ont \u00e9t\u00e9 sp\u00e9cialement \u00e9crits pour le projet 100 VOLTAS. Les paroles en r\u00e9v\u00e8lent surtout les multiples visages de femmes car, en Galice, les hommes \u00e9taient souvent partis en mer ou \u00e0 l\u2019\u00e9tranger pour travailler, laissant leurs \u00e9pouses seules \u00e0 g\u00e9rer le foyer. Ces po\u00e8mes subtils et engag\u00e9s d\u00e9crivent et d\u00e9noncent la condition des travailleur\u00b7ses, des femmes, des artistes\u2026\n\nUn r\u00e9pertoire qui pr\u00e9serve l\u2019essence du pass\u00e9 tout en le modernisant gr\u00e2ce \u00e0 l\u2019incorporation de diff\u00e9rents instruments et leurs effets : violon, accord\u00e9on diatonique, stompbox\u2026 En glanant \u00e7a et l\u00e0 ses inspirations, le trio envisage la tradition galicienne non comme une ligne d\u2019arriv\u00e9e, mais aussi comme point de d\u00e9part donnant lieu \u00e0 de nouvelles cr\u00e9ations.","performers":"Ver\u00f3nica Codesal : chant, percussions (pandeireta, cunchas)\nDidier Laloy : accord\u00e9on diatonique, stompbox\nDamien Chierici : violon, \u00e9lectro","boxoffice_url":null,"website":"https:\/\/www.jeunessesmusicales.be\/bruxelles\/veronica-codesal-didier-laloy-damien-chierici-100-voltas-theatre-mercelis\/","email":"jmbxl@jeunessesmusicales.be","phone_contact":"+32 2 897 01 70","phone_booking":"+32 2 897 01 70","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50002435"},"sp":{"name":"Ver\u00f3nica Codesal, Didier Laloy & Damien Chierici \u00ab 100 Voltas \u00bb @Th\u00e9\u00e2tre Mercelis","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.jeunessesmusicales.be\/bruxelles\/veronica-codesal-didier-laloy-damien-chierici-100-voltas-theatre-mercelis\/","email":"jmbxl@jeunessesmusicales.be","phone_contact":"+32 2 897 01 70","phone_booking":"+32 2 897 01 70","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50002435"},"nl":{"name":"Ver\u00f3nica Codesal, Didier Laloy & Damien Chierici \u00ab 100 Voltas \u00bb","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.jeunessesmusicales.be\/bruxelles\/veronica-codesal-didier-laloy-damien-chierici-100-voltas-theatre-mercelis\/","email":"jmbxl@jeunessesmusicales.be","phone_contact":"+32 2 897 01 70","phone_booking":"+32 2 897 01 70","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50002435"}},"place":{"id":50000493,"translations":{"de":{"name":"Th\u00e9atre Mercelis","address_street_name":"Rue Mercelis","address_street_number":"13","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Mercelis, 13","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Th\u00e9atre Mercelis","address_street_name":"Rue Mercelis","address_street_number":"13","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Mercelis, 13","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Th\u00e9atre Mercelis","address_street_name":"Rue Mercelis","address_street_number":"13","address_street_box":null,"email":null,"website":null,"phone_cont