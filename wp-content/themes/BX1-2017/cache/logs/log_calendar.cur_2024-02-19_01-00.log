mproviste.be\/Derriere-la-porte","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50000091"},"en":{"name":"Derri\u00e8re la porte","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Derriere-la-porte","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50000091"},"it":{"name":"Derri\u00e8re la porte","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Derriere-la-porte","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50000091"},"cn":{"name":"Derri\u00e8re la porte","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Derriere-la-porte","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50000091"},"fr":{"name":"Derri\u00e8re la porte","shortdescr":"Entrez, c\u2019est ouvert !","longdescr":"Les portes, \u00e7a craint ! C\u2019est pas joli, pas divertissant, pas \u00e9mouvant, chiant \u00e0 transporter. Ca ne va avec rien, \u00e7a claque sur le nez, \u00e7a se laisse tirer sauf quand il faut pousser, \u00e7a se ferme pour que dalle et \u00e7a se rouvre quand il n\u2019y a plus rien \u00e0 voir. Sans exag\u00e9ration : les portes, c\u2019est le pire fl\u00e9au de notre \u00e9poque. Ce qu\u2019il y a derri\u00e8re en revanche, c\u2019est beaucoup plus int\u00e9ressant. Entre surprises et impr\u00e9vus, myst\u00e8res et bouleversements, amours et trahisons, passion et raison, mensonges et v\u00e9rit\u00e9 et bien plus encore... il se passe tellement de choses derri\u00e8re une porte. Evidemment, vous ne pouvez pas savoir vu que vous \u00eates de l\u2019autre cot\u00e9, mais que diriez-vous de franchir le cap ? Rejoignez-nous et d\u00e9couvrez, le temps d\u2019une impro longue, ce que vous cachent ces traitresses (qu\u2019elles soient en bois ou en m\u00e9tal, simples ou doubles, int\u00e9rieures ou ext\u00e9rieures... Bref, toutes les portes vous mentent, faites attention !).","performers":"La Compagnie des \"Mille et Une Portes\"","boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Derriere-la-porte","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50000091"},"sp":{"name":"Derri\u00e8re la porte","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Derriere-la-porte","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50000091"},"nl":{"name":"Derri\u00e8re la porte","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Derriere-la-porte","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50000091"}},"place":{"id":270611,"translations":{"de":{"name":"Th\u00e9\u00e2tre l\u2019Improviste ","address_street_name":"Rue de Fierlant","address_street_number":"120","address_street_box":null,"email":null,"website":"http:\/\/www.improviste.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Rue de Fierlant, 120","address_line2":"1190 Forest","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Th\u00e9\u00e2tre L'improviste","address_street_name":"Rue de Fierlant","address_street_number":"120","address_street_box":null,"email":null,"web