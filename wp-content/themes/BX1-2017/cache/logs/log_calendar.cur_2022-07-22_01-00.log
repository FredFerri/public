link":"https:\/\/agendabrussels.imgix.net\/d499814debdf39ed9ef63398fd1f2a7f5e7e6d28.jpg","width":960,"height":679,"ratio":1.41,"translations":{"fr":{"title":"Balagan - le nouveau concept Bruxellois qui s'exporte!","copyright":null},"nl":{"title":"Balagan - le nouveau concept Bruxellois qui s'exporte!","copyright":null},"en":{"title":"Balagan - le nouveau concept Bruxellois qui s'exporte!","copyright":null}}}],"dates":[{"day":"2022-07-23","doors":"22:30:00","start":"22:30:00","end":null,"is_soldout":false,"is_canceled":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"visit_profile":{"list":[324],"translations":{"fr":["Culture urbaine"],"nl":["Stadscultuur"],"en":["Urban culture"]}},"tags":[],"is_part_of":"Summer in the City","accessibilities":{"list":[255,261,265],"translations":{"fr":["Accessible","Parking accessible","WC adapt\u00e9"],"nl":["Toegankelijk","Toegankelijke parking","Aangepast toilet"],"en":["Accessible","Accessible parking","Adapted toilet"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-07-19T08:35:04+02:00","published_at":"2022-07-19T08:05:14+02:00","backoffice_id":258645,"import_origin":null,"sub_type":"party","show_in_agenda":true,"ranking":1},{"id":538703,"date_start":"2022-07-23","date_end":"2022-07-31","date_next":"2022-07-23","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[36,46],"translations":{"fr":["Mus\u00e9es et art centers","Pluridisciplinaire"],"nl":["Musea en kunstcentra","Multidisciplinair"],"en":["Museums and art centers","Multidisciplinary"]}}},"languages":{"spoken":["en","fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"La maison captur\u00e9e","shortdescr":"Cr\u00e9er pendant la guerre: 200 \u0153uvres de 50 artistes contemporains ukrainiens seront montr\u00e9es lors de l'exposition \u00ab The Captured House \u00bb \u00e0 Bruxelles","longdescr":"Venez sentir, voir et \u00e9couter 50 histoires diff\u00e9rentes sur la guerre, des histoires racont\u00e9es par des artistes contemporains d\u2019Ukraine. L'exposition \u00ab The Captured House \u00bb comprend des t\u00e9moignages et des souvenirs, exprim\u00e9s par le biais de plus de 200 photos, sculptures, installations, \u0153uvres num\u00e9riques et musicales d'artistes qui sont rest\u00e9s vivre et travailler dans les r\u00e9gions o\u00f9 les combats ont eu lieu ou se poursuivent \u00e0 ce jour.\r\nNous vous invitons dans notre maison commune dont une pi\u00e8ce a \u00e9t\u00e9 captur\u00e9e par l'ennemi, mais dont les habitants continuent \u00e0 se battre pour la libert\u00e9 de chacun d'entre nous. Nous vous invitons \u00e0 l'exposition \u00abThe Captured House\u00bb.\r\nL'exposition est organis\u00e9e par l'agence de management culturel PORT.\r\nCommissariat d\u2019exposition : Kate Taylor\r\nAvec le soutien du minist\u00e8re ukrainien de la Culture et de la Politique de l'information, le minist\u00e8re ukrainien des Affaires \u00e9trang\u00e8res et l'Agence nationale ukrainienne pour les arts et l'\u00e9ducation artistique.","performers":"Katya Taylor, la commissaire d\u2019exposition","boxoffice_url":null,"website":"https:\/\/thecapturedhouse.com","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/538703.html"},"nl":{"name":"The Captured House","shortdescr":"Tentoonstelling \u00a8The Captured House\u00a8: 200 werken van dappere Oekra\u00efense kunstenaars in Brussel","longdescr":"Van 23 juli tot 31 juli 2022 wordt in het cultureel centrum Espace Vanderborght (Rue de l'Ecuyer, 50 in Brussel) een tentoonstelling gehouden \"The Captured House\". De titel verwijst naar het verhaal van de Argentijnse schrijver Julio Cort\u00e1zar. Een onbekend Kwaad, centimeter voor centimeter, bezet het huis van de hoofdpersoon, daarom moet hij de plek verlaten waar hij zijn hele leven heeft gewoond.\r\n\r\nDe titel \u201cThe Captured House\u201d verwijst naar het verhaal \u201cThe Captured House\u201d van de Argentijnse schrijver Julio Cort\u00e1zar. Een onbekend Kwaad, centimeter voor centimeter, bezet het huis van de hoofdpersoon, die gedwongen wordt de plaats, waar hij zijn hele leven heeft gewoond, te verlaten.\r\n\r\nMet meer dan 200 werken, waaronder schilderijen en grafiek, foto's, sculpturen en installaties, is \"The Captured House\" de artistieke interpretatie van 50 dappere hedendaagse Oekra\u00efense auteurs die de catastrofe vertellen die ze documenteerden in realtime oorlog in Oekra\u00efne. Alevtyna Kakhidze, Vlada Ralko, Dariia Koltsova, Mikhail Ray, Kinder Album, Evgeniy Maloletka, Maks Levin, Gamlet Zinkivskyi, Ihor Husev, Masha Shubina, Zolotar (Oleksi\u0456 Zolotariov), Stas Zhalobniuk, Volodymyr . Na de Russische aanval bleven veel van deze kunstenaars werken in de steden Kiev, Charkov, Cherson en Donetsk.\r\nDe tentoonstelling wordt georganiseerd door het culturele managementbureau PORT* (Kyiv), met de steun van het Ministerie van Buitenlandse Zaken van Oekra\u00efne, het Ministerie van Cultuur en Informatiebeleid van Oekra\u00efne en het Staatsbureau van Oekra\u00efne voor Kunst en Kunsteducatie.","performers":"Katya Taylor, de curator van het project","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/538703.html"},"en":{"name":"The Captured House","shortdescr":"Creating during the war: 200 works by 50 contemporary Ukrainian artists on the exhibition \u201cThe Captured House\u201d in  Brussels","longdescr":"Come and feel, see and listen to 50 different stories of the war, told by contemporary Ukrainian artists. \u2018The Captured House\u2019 exhibition includes evidence and memories, expressed in more than 200 photos, sculptures, installations, digital and musical works of artists, who remained to live and work in the regions where the fighting took place or keeps going.\r\n\r\nWe invite you to our shared house, whose room has been captured by the enemy, but its residents keep fighting for freedom for all of us. We invite you to \u2018The Captured House\u2019 exhibition.\r\n\r\nThe exposition is organized by the PORT. cultural management agency. \r\nThe curator: Kate Taylor \r\nWith the assistance of the Ministry of Culture and Information Policy of Ukraine, the Ministry of Foreign Affairs of Ukraine and the State Agency of Ukraine on Arts and Artistic Education.","performers":"Katya Taylor, the curator of the project","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/538703.html"},"de":{"name":"La maison captur\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/538703.html"},"it":{"name":"La maison captur\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/538703.html"},"sp":{"name":"La maison captur\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/538703.html"},"pt":{"name":"La maison captur\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/538703.html"},"cn":{"name":"La maison captur\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/538703.html"}},"place":{"id":251380,"translations":{"fr":{"name":"Espace Vanderborght","address_street_name":"Rue de l'Ecuyer","address_street_number":"50","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de l'Ecuyer, 50","address_line2":"1000 Bruxelles","description_web":"Propri\u00e9t\u00e9 de la Ville de Bruxelles, cet \u00e9difice \u00e0 la large vitrine se dresse en plein centre de Bruxelles, \u00e0 deux pas des c\u00e9l\u00e8bres Galeries royales Saint-Hubert et \u00e0 peine plus loin de la Grand-Place. Il occupe un espace impressionnant de 6 000 m\u00e8tres carr\u00e9s de surface utile, r\u00e9partis sur 5 \u00e9tages.\r\n\r\nConstruit au profit des \u00ab Nouveaux \u00c9tablissements Vanderborght Fr\u00e8res \u00bb, n\u00e9goce en mobilier (tapis, bibelots, mobilier de jardin, literie, etc.), l\u2019\u00e9difice est con\u00e7u par un tandem habitu\u00e9 \u00e0 travailler ensemble : les architectes Govaerts et Van Vaerenbergh, auteurs \u00e9galement de la maison d\u2019Alice et David van Buren \u2014 actuel mus\u00e9e van Buuren. Le chantier, entam\u00e9 en 1932, prend fin en 1935. De style moderniste, la conception de l\u2019immeuble est d\u00e9nu\u00e9e de tout ornement et privil\u00e9gie la fonction.\r\n\r\nRemarquable par ses larges vitrines permettant une grande visibilit\u00e9, chaque \u00e9tage est constitu\u00e9 d\u2019un grand un plateau de b\u00e9ton modulable, gr\u00e2ce \u00e0 un syst\u00e8me de cloisons coulissantes sur rail. Le b\u00e2timent se distingue encore par ses terrasses, lieu d\u2019exposition des meubles de jardin mais aussi de d\u00e9tente \u2014 on peut y prendre un th\u00e9 \u00e0 l\u2019\u00e9poque ! Le magasin tombe en faillite en 1980.\r\n\r\nLes Mus\u00e9es Royaux des Beaux-Arts ont envisag\u00e9 d\u2019y transf\u00e9rer leurs collections d\u2019art moderne et contemporain, mais le projet restera sans suite.\r\n\r\nLe lieu abrite aujourd\u2019hui de nombreuses expositions, principalement centr\u00e9es sur l\u2019art contemporain. Trois grands rendez-vous sont ainsi programm\u00e9s chaque ann\u00e9e :\r\n-\tCarte de Visite ARTopenKUNST en f\u00e9vrier, une expo d\u00e9di\u00e9e aux artistes amateurs et professionnels qui habitent ou travaillent sur la Ville de Bruxelles. Plus de 200 artistes envahissent tout le b\u00e2timent pendant un weekend. http:\/\/cartedevisite.brussels\/ \r\n-\tThe Independent en avril, une foire d\u2019art contemporain newyorkaise qui a pos\u00e9 ses valises \u00e0 Bruxelles. http:\/\/independenthq.com\/\r\n-\tStrokar en mai, une exposition d\u00e9di\u00e9e au Street Art et \u00e0 la photographie qui rassemble des artistes bruxellois et internationaux. http:\/\/strokar.be\/ \r\n\r\nPar ailleurs d\u2019autres expositions non r\u00e9currentes y trouvent place, ouvertes au plus grand nombre et proposant un prix tr\u00e8s accessible.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Vanderborghtgebouw","address_street_name":"Schildknaapsstraat","address_street_number":"50","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Schildknaapsstraat, 50","address_line2":"1000 Brussel","description_web":"Dit gebouw, dat eigendom is van de stad Brussel, ligt in het hartje van Brussel, op een steenworp van de beroemde Koninklijke Sint-Hubertusgalerijen en de Grote Markt. Het neemt een indrukwekkende 6.000 vierkante meter vloeroppervlak in beslag, verdeeld over 5 verdiepingen.\r\n\r\nIndertijd gebouwd voor een meubelhandelaar (tapijten, snuisterijen, tuinmeubelen, beddengoed, enz.), \"Nouveaux \u00c9tablissements Vanderborght Fr\u00e8res\", werd het gebouw ontworpen door een team dat gewend was om samen te werken: architecten Govaerts en Van Vaerenbergh, de ontwerpers van het huis van Alice en David van Buren - nu het van Buuren Museum. De bouwwerkzaamheden, die in 1932 begonnen, eindigden in 1935. Eigen aan de modernistische stijl is het ontwerp van het gebouw verstoken van ornamenten en benadrukt het de functie.\r\n\r\nElke verdieping bestaat uit een groot modulair betonnen plateau, dankzij een systeem van verschuifbare scheidingswanden op rails, met opmerkelijk grote ramen die een hoge zichtbaarheid mogelijk maken. Het gebouw kenmerkt zich ook nog door zijn terrassen, de plek waar het tuinmeubilair werd tentoongesteld en waar men ook kon ontspannen (indertijd kon je daar thee drinken). De winkel ging in 1980 failliet.\r\n\r\nDe Koninklijke Musea voor Schone Kunsten hebben overwogen om hun collecties moderne en hedendaagse kunst hierheen over te brengen, maar het project werd niet voortgezet.\r\n\r\nVandaag de dag worden er vele tentoonstellingen georganiseerd, voornamelijk gericht op hedendaagse kunst. Elk jaar staan er drie grote evenementen op het programma:\r\n- ARTopenKUNST in februari, een tentoonstelling gewijd aan amateur- en professionele kunstenaars die in de stad Brussel wonen of werken. Meer dan 200 kunstenaars vallen een weekend lang het hele gebouw binnen. http:\/\/cartedevisite.brussels\/ \r\n- The Independent in april, een New Yorkse beurs voor hedendaagse kunst die zich in Brussel heeft gevestigd. http:\/\/independenthq.com\/\r\n- Strokar in mei, een tentoonstelling gewijd aan Street Art en fotografie die Brussel en internationale kunstenaars samenbrengt. http:\/\/strokar.be\/ \r\n\r\nDaarnaast herbergt het gebouw nog vele andere, niet-wederkerende tentoonstellingen, die openstaan voor het grote publiek aan een zeer toegankelijke prijs.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Espace Vanderborght","address_street_name":"Rue de l'Ecuyer","address_street_number":"50","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue de l'Ecuyer, 50","address_line2":"1000 Brussels","description_web":"Owned by the City of Brussels, this building with a large shop window stands in the centre of Brussels, only a stone\u2019s throw from the Grand Place. It occupies an impressive 6,000 m\u00b2 of space spread over 5 stories.\r\n\r\nBuilt for the \u201cNouveaux \u00c9tablissements Vanderborght Fr\u00e8res\u201d, who traded in household products like carpets, knick-knacks, garden furniture, bedding, etc., the building was designed by architects Govaerts and Van Vaerenbergh, who were used to working together, having previously collaborated on the house of Alice and David van Buren, now the van Buren Museum. The building works, which began in 1932, were completed in 1935. Built in a modernist style, the building did away with ornamental elements, favouring function over appearance.\r\n\r\nWith remarkable large shop front windows that allow for greater visibility, each story is made up of one large concrete floorplan that can be easily modified thanks to a system of sliding partition walls on tracks. Other stand-out features of this building are its terraces, which served as exhibition spaces for the company\u2019s garden furniture back in the day, but also spots to relax and enjoy a cup of tea. The store went bankrupt in 1980.\r\n\r\nThe Royal Fine Arts Museums of Belgium once thought of moving their collections into the Vanderborght building, but the project never took off.\r\n\r\nThe venue today welcomes many exhibitions, mainly centred around contemporary art. Three major events are organised every year:\r\n-\tCarte de Visite ARTopenKUNST in February: an exhibition dedicated to amateur and professional artists living or working in the City of Brussels. More than 200 artists take over the building for a whole weekend. http:\/\/cartedevisite.brussels\/ \r\n-\tThe Independent in April: a contemporary art fair from New Year has set up shop in Brussels. http:\/\/independenthq.com\/\r\n-\tStrokar in May: an exhibition dedicated to street art and photography that gathers artists from Brussels and further afield. http:\/\/strokar.be\/ \r\n\r\nFurthermore, other, non-recurrent exhibitions also take place in the Vanderborght building and are open to all at a reasonable price.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Espace Vanderborght","address_street_name":"Rue de l'Ecuyer","address_street_number":"50","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de l'Ecuyer, 50","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Espace Vanderborght","address_street_name":"Rue de l'Ecuyer","address_street_number":"50","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de l'Ecuyer, 50","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Espace Vanderborght","address_street_name":"Rue de l'Ecuyer","address_street_number":"50","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de l'Ecuyer, 50","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Espace Vanderborght","address_street_name":"Rue de l'Ecuyer","address_street_number":"50","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de l'Ecuyer, 50","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Espace Vanderborght","address_street_name":"Rue de l'Ecuyer","address_street_number":"50","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de l'Ecuyer, 50","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":[],"zones":{"list":[19],"translations":{"fr":["Centre"],"nl":["Centrum"],"en":["Centre"]}},"neca":null,"facebook_id":null,"backoffice_id":13469,"location":{"lat":50.84878981,"lon":4.35576881},"region":"brussels","last_updated_at":"2022-07-20T09:05:05+02:00","published_at":"2013-10-19T01:37:09+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":251380,"translations":{"fr":{"name":"Espace Vanderborght","address_street_name":"Rue de l'Ecuyer","address_street_number":"50","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de l'Ecuyer, 50","address_line2":"1000 Bruxelles","description_web":"Propri\u00e9t\u00e9 de la Ville de Bruxelles, cet \u00e9difice \u00e0 la large vitrine se dresse en plein centre de Bruxelles, \u00e0 deux pas des c\u00e9l\u00e8bres Galeries royales Saint-Hubert et \u00e0 peine plus loin de la Grand-Place. Il occupe un espace impressionnant de 6 000 m\u00e8tres carr\u00e9s de surface utile, r\u00e9partis sur 5 \u00e9tages.\r\n\r\nConstruit au profit des \u00ab Nouveaux \u00c9tablissements Vanderborght Fr\u00e8res \u00bb, n\u00e9goce en mobilier (tapis, bibelots, mobilier de jardin, literie, etc.), l\u2019\u00e9difice est con\u00e7u par un tandem habitu\u00e9 \u00e0 travailler ensemble : les architectes Govaerts et Van Vaerenbergh, auteurs \u00e9galement de la maison d\u2019Alice et David van Buren \u2014 actuel mus\u00e9e van Buuren. Le chantier, entam\u00e9 en 1932, prend fin en 1935. De style moderniste, la conception de l\u2019immeuble est d\u00e9nu\u00e9e de tout ornement et privil\u00e9gie la fonction.\r\n\r\nRemarquable par ses larges vitrines permettant une grande visibilit\u00e9, chaque \u00e9tage est constitu\u00e9 d\u2019un grand un plateau de b\u00e9ton modulable, gr\u00e2ce \u00e0 un syst\u00e8me de cloisons coulissantes sur rail. Le b\u00e2timent se distingue encore par ses terrasses, lieu d\u2019exposition des meubles de jardin mais aussi de d\u00e9tente \u2014 on peut y prendre un th\u00e9 \u00e0 l\u2019\u00e9poque ! Le magasin tombe en faillite en 1980.\r\n\r\nLes Mus\u00e9es Royaux des Beaux-Arts ont envisag\u00e9 d\u2019y transf\u00e9rer leurs collections d\u2019art moderne et contemporain, mais le projet restera sans suite.\r\n\r\nLe lieu abrite aujourd\u2019hui de nombreuses expositions, principalement centr\u00e9es sur l\u2019art contemporain. Trois grands rendez-vous sont ainsi programm\u00e9s chaque ann\u00e9e :\r\n-\tCarte de Visite ARTopenKUNST en f\u00e9vrier, une expo d\u00e9di\u00e9e aux artistes amateurs et professionnels qui habitent ou travaillent sur la Ville de Bruxelles. Plus de 200 artistes envahissent tout le b\u00e2timent pendant un weekend. http:\/\/cartedevisite.brussels\/ \r\n-\tThe Independent en avril, une foire d\u2019art contemporain newyorkaise qui a pos\u00e9 ses valises \u00e0 Bruxelles. http:\/\/independenthq.com\/\r\n-\tStrokar en mai, une exposition d\u00e9di\u00e9e au Street Art et \u00e0 la photographie qui rassemble des artistes bruxellois et internationaux. http:\/\/strokar.be\/ \r\n\r\nPar ailleurs d\u2019autres expositions non r\u00e9currentes y trouvent place, ouvertes au plus grand nombre et proposant un prix tr\u00e8s accessible.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Vanderborghtgebouw","address_street_name":"Schildknaapsstraat","address_street_number":"50","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Schildknaapsstraat, 50","address_line2":"1000 Brussel","description_web":"Dit gebouw, dat eigendom is van de stad Brussel, ligt in het hartje van Brussel, op een steenworp van de beroemde Koninklijke Sint-Hubertusgalerijen en de Grote Markt. Het neemt een indrukwekkende 6.000 vierkante meter vloeroppervlak in beslag, verdeeld over 5 verdiepingen.\r\n\r\nIndertijd gebouwd voor een meubelhandelaar (tapijten, snuisterijen, tuinmeubelen, beddengoed, enz.), \"Nouveaux \u00c9tablissements Vanderborght Fr\u00e8res\", werd het gebouw ontworpen door een team dat gewend was om samen te werken: architecten Govaerts en Van Vaerenbergh, de ontwerpers van het huis van Alice en David van Buren - nu het van Buuren Museum. De bouwwerkzaamheden, die in 1932 begonnen, eindigden in 1935. Eigen aan de modernistische stijl is het ontwerp van het gebouw verstoken van ornamenten en benadrukt het de functie.\r\n\r\nElke verdieping bestaat uit een groot modulair betonnen plateau, dankzij een systeem van verschuifbare scheidingswanden op rails, met opmerkelijk grote ramen die een hoge zichtbaarheid mogelijk maken. Het gebouw kenmerkt zich ook nog door zijn terrassen, de plek waar het tuinmeubilair werd tentoongesteld en waar men ook kon ontspannen (indertijd kon je daar thee drinken). De winkel ging in 1980 failliet.\r\n\r\nDe Koninklijke Musea voor Schone Kunsten hebben overwogen om hun collecties moderne en hedendaagse kunst hierheen over te brengen, maar het project werd niet voortgezet.\r\n\r\nVandaag de dag worden er vele tentoonstellingen georganiseerd, voornamelijk gericht op hedendaagse kunst. Elk jaar staan er drie grote evenementen op het programma:\r\n- ARTopenKUNST in februari, een tentoonstelling gewijd aan amateur- en professionele kunstenaars die in de stad Brussel wonen of werken. Meer dan 200 kunstenaars vallen een weekend lang het hele gebouw binnen. http:\/\/cartedevisite.brussels\/ \r\n- The Independent in april, een New Yorkse beurs voor hedendaagse kunst die zich in Brussel heeft gevestigd. http:\/\/independenthq.com\/\r\n- Strokar in mei, een tentoonstelling gewijd aan Street Art en fotografie die Brussel en internationale kunstenaars samenbrengt. http:\/\/strokar.be\/ \r\n\r\nDaarnaast herbergt het gebouw nog vele andere, niet-wederkerende tentoonstellingen, die openstaan voor het grote publiek aan een zeer toegankelijke prijs.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Espace Vanderborght","address_street_name":"Rue de l'Ecuyer","address_street_number":"50","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue de l'Ecuyer, 50","address_line2":"1000 Brussels","description_web":"Owned by the City of Brussels, this building with a large shop window stands in the centre of Brussels, only a stone\u2019s throw from the Grand Place. It occupies an impressive 6,000 m\u00b2 of space spread over 5 stories.\r\n\r\nBuilt for the \u201cNouveaux \u00c9tablissements Vanderborght Fr\u00e8res\u201d, who traded in household products like carpets, knick-knacks, garden furniture, bedding, etc., the building was designed by architects Govaerts and Van Vaerenbergh, who were used to working together, having previously collaborated on the house of Alice and David van Buren, now the van Buren Museum. The building works, which began in 1932, were completed in 1935. Built in a modernist style, the building did away with ornamental elements, favouring function over appearance.\r\n\r\nWith remarkable large shop front windows that allow for greater visibility, each story is made up of one large concrete floorplan that can be easily modified thanks to a system of sliding partition walls on tracks. Other stand-out features of this building are its terraces, which served as exhibition spaces for the company\u2019s garden furniture back in the day, but also spots to relax and enjoy a cup of tea. The store went bankrupt in 1980.\r\n\r\nThe Royal Fine Arts Museums of Belgium once thought of moving their collections into the Vanderborght building, but the project never took off.\r\n\r\nThe venue today welcomes many exhibitions, mainly centred around contemporary art. Three major events are organised every year:\r\n-\tCarte de Visite ARTopenKUNST in February: an exhibition dedicated to amateur and professional artists living or working in the City of Brussels. More than 200 artists take over the building for a whole weekend. http:\/\/cartedevisite.brussels\/ \r\n-\tThe Independent in April: a contemporary art fair from New Year has set up shop in Brussels. http:\/\/independenthq.com\/\r\n-\tStrokar in May: an exhibition dedicated to street art and photography that gathers artists from Brussels and further afield. http:\/\/strokar.be\/ \r\n\r\nFurthermore, other, non-recurrent exhibitions also take place in the Vanderborght building and are open to all at a reasonable price.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Espace Vanderborght","address_street_name":"Rue de l'Ecuyer","address_street_number":"50","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de l'Ecuyer, 50","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Espace Vanderborght","address_street_name":"Rue de l'Ecuyer","address_street_number":"50","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de l'Ecuyer, 50","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Espace Vanderborght","address_street_name":"Rue de l'Ecuyer","address_street_number":"50","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de l'Ecuyer, 50","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Espace Vanderborght","address_street_name":"Rue de l'Ecuyer","address_street_number":"50","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de l'Ecuyer, 50","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Espace Vanderborght","address_street_name":"Rue de l'Ecuyer","address_street_number":"50","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de l'Ecuyer, 50","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":null,"facebook_id":null,"backoffice_id":13469,"location":{"lat":50.84878981,"lon":4.35576881},"region":"brussels","last_updated_at":"2022-07-20T09:05:05+02:00","published_at":"2013-10-19T01:37:09+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"media":[{"t