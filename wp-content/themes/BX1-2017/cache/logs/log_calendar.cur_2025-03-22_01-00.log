ls\/pt\/visitors\/agenda\/event-detail.5700007938"},"en":{"name":"Double exposition - \"Syrie, 13 ans de guerre\" et \"\u00c9chos de la jungle : Histoires humaines invisibles du Dari\u00e9n\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/geopolis.brussels\/","email":"contact@geopolis.brussels","phone_contact":"+32 485 32 85 90","phone_booking":"+32 485 32 85 90","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700007938"},"it":{"name":"Double exposition - \"Syrie, 13 ans de guerre\" et \"\u00c9chos de la jungle : Histoires humaines invisibles du Dari\u00e9n\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/geopolis.brussels\/","email":"contact@geopolis.brussels","phone_contact":"+32 485 32 85 90","phone_booking":"+32 485 32 85 90","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700007938"},"cn":{"name":"Double exposition - \"Syrie, 13 ans de guerre\" et \"\u00c9chos de la jungle : Histoires humaines invisibles du Dari\u00e9n\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/geopolis.brussels\/","email":"contact@geopolis.brussels","phone_contact":"+32 485 32 85 90","phone_booking":"+32 485 32 85 90","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700007938"},"fr":{"name":"Double exposition - \"Syrie, 13 ans de guerre\" et \"\u00c9chos de la jungle : Histoires humaines invisibles du Dari\u00e9n\"","shortdescr":null,"longdescr":"Du 11 mars au 30 avril 2025, G\u00e9opolis pr\u00e9sente deux expositions. \n\nLa premi\u00e8re \"Syrie, 13 ans de guerre\", r\u00e9alis\u00e9e en partenariat avec l'Agence France-Presse (AFP) revient, en 70 images, sur pr\u00e8s de 13 ans de guerre civile, du soul\u00e8vement de 2011 \u00e0 la chute de Bachar al-Assad, le 8 d\u00e9cembre 2025. \n\nLa seconde exposition \"\u00c9chos de la jungle : Histoires humaines invisibles du Dari\u00e9n\", pr\u00e9sent\u00e9e en partenariat avec la F\u00e9d\u00e9ration internationale des soci\u00e9t\u00e9s de la Croix-Rouge (IFCR) \u00e9voque un des trajets migratoires les plus dangereux et m\u00e9connus au monde : la travers\u00e9e de la jungle du Dari\u00e9n, entre la Colombie et le Panama. Une route travers\u00e9e par 500 000 personnes en 2023, soit le double du nombre enregistr\u00e9 en 2022.\n\nInformations pratiques : \n\nG\u00e9opolis - Rue des Tanneurs 58a, 1000 Bruxelles\nDu mardi au dimanche de 13h00 \u00e0 17h30\nEntr\u00e9e libre - Prix conseill\u00e9 5 euros\ncontact@geopolis.brussels - 0485 32 85 90","performers":null,"boxoffice_url":null,"website":"https:\/\/geopolis.brussels\/","email":"contact@geopolis.brussels","phone_contact":"+32 485 32 85 90","phone_booking":"+32 485 32 85 90","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700007938"},"sp":{"name":"Double exposition - \"Syrie, 13 ans de guerre\" et \"\u00c9chos de la jungle : Histoires humaines invisibles du Dari\u00e9n\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/geopolis.brussels\/","email":"contact@geopolis.brussels","phone_contact":"+32 485 32 85 90","phone_booking":"+32 485 32 85 90","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700007938"},"nl":{"name":"Double exposition - \"Syrie, 13 ans de guerre\" et \"\u00c9chos de la jungle : Histoires humaines invisibles du Dari\u00e9n\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/geopolis.brussels\/","email":"contact@geopolis.brussels","phone_contact":"+32 485 32 85 90","phone_booking":"+32 485 32 85 90","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700007938"}},"place":{"id":269816,"translations":{"de":{"name":"G\u00e9opolis","address_street_name":"Rue des Tanneurs","address_street_number":"58-60","address_street_box":null,"email":"co