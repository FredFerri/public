lse,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre"}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Comme la pluie","shortdescr":"La po\u00e9sie est comme la pluie, inutile.","longdescr":"ARTS DE LA SC\u00c8NE ET PLASTIQUES | DERNI\u00c8RE REPR\u00c9SENTATION !\r\n25\/09 \u2013 11H | TOUT PUBLIC (7-12 ANS)\r\n________________________________________________________________\r\n\r\nC\u2019est incroyable, non ? qu\u2019il y a 25 ou 30 000 ans, des hommes, des femmes aient r\u00e9alis\u00e9 des dessins sur les parois de grottes et que la falaise au-dessus de la grotte se soit effondr\u00e9e, enfermant des chefs d\u2019\u0153uvre, les prot\u00e9geant du vent, du froid, des animaux, des hommes pendant des mill\u00e9naire. Et nous, qu\u2019aurions-nous envie de laisser, que des sp\u00e9l\u00e9ologues pourraient d\u00e9couvrir ? Moi je crois que je laisserais quelques photos ou des dessins, un po\u00e8me. Oui, je crois que je laisserais des choses comme \u00e7a, des choses inutiles, comme la pluie. Un spectacle captivant qui se regarde comme une exposition, explore les plaisirs de la cr\u00e9ation et jette les ponts entre arts de la sc\u00e8ne et arts plastiques. Sur le plateau, la parole se fait rare et laisse la place au trait.","performers":"De Philippe L\u00e9onard et Pierre Richards. Interpr\u00e9tation Philippe L\u00e9onard. Mise en sc\u00e8ne Pierre Richards. Sc\u00e9nographie et costume Catherine Somers. Musique Philippe Morino et Juliette Richards. \u00c9clairage Luc Jouniaux. R\u00e9gie Luc Jouniaux ou Karl Autrique ou Guy Carbonnelle. Co-production Foule Th\u00e9\u00e2tre.","boxoffice_url":null,"website":"http:\/\/www.roseraie.org","email":"secretariat@roseraie.org","phone_contact":null,"phone_booking":"+32 2 376 46 45","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.540959"},"nl":{"name":"Comme la pluie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.540959"},"en":{"name":"Comme la pluie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.540959"},"de":{"name":"Comme la pluie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.540959"},"it":{"name":"Comme la pluie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.540959"},"sp":{"name":"Comme la pluie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.540959"},"pt":{"name":"Comme la pluie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.540959"},"cn":{"name":"Comme la pluie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.540959"}},"place":{"