/pt\/visitors\/agenda\/event-detail.50012306"},"en":{"name":"D\u00e9couverte des collections botaniques","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/sciences.brussels\/jardinmassart","email":"jardmass@ulb.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50012306"},"it":{"name":"D\u00e9couverte des collections botaniques","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/sciences.brussels\/jardinmassart","email":"jardmass@ulb.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50012306"},"cn":{"name":"D\u00e9couverte des collections botaniques","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/sciences.brussels\/jardinmassart","email":"jardmass@ulb.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50012306"},"fr":{"name":"D\u00e9couverte des collections botaniques","shortdescr":"Durant cette visite nous parcourons l\u2019ensemble des collections : Jardin de l\u2019\u00e9volution, Arboretum, Jardin des plantes m\u00e9dicinales, Verger, Ancien Jardin \u00e9thologique,\u2026 Id\u00e9al pour une premi\u00e8re visite du Jardin Massart.","longdescr":"Cr\u00e9\u00e9 en 1922, le jardin botanique Jean Massart r\u00e9unit, sur 5 hectares, pr\u00e8s de 2.000 esp\u00e8ces v\u00e9g\u00e9tales organis\u00e9es en jardins et en collections.\nDurant cette visite nous parcourons l\u2019ensemble des collections : Jardin de l\u2019\u00e9volution, Arboretum, Jardin des plantes m\u00e9dicinales, Verger, Ancien Jardin \u00e9thologique,\u2026 Id\u00e9al pour une premi\u00e8re visite du Jardin Massart.\nVisite guid\u00e9e propos\u00e9e par l'\u00e9quipe \u00e9ducative de l'Universit\u00e9 Libre de Bruxelles (ULB) au Jardin botanique Jean Massart.\nVeillez toujours \u00e0 v\u00e9rifier que votre visite est maintenue avant de vous d\u00e9placer !\nEn effet, en cas d\u2019avis de temp\u00eate ou d\u2019impossibilit\u00e9 du guide \u00e0 se pr\u00e9senter au rendez-vous nous vous en informerons via l'agenda du site web.","performers":"Visite guid\u00e9e propos\u00e9e par l'\u00e9quipe \u00e9ducative de l'Universit\u00e9 Libre de Bruxelles (ULB) au Jardin botanique Jean Massart.\n","boxoffice_url":null,"website":"https:\/\/sciences.brussels\/jardinmassart","email":"jardmass@ulb.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50012306"},"sp":{"name":"D\u00e9couverte des collections botaniques","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/sciences.brussels\/jardinmassart","email":"jardmass@ulb.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50012306"},"nl":{"name":"D\u00e9couverte des collections botaniques","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/sciences.brussels\/jardinmassart","email":"jardmass@ulb.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50012306"}},"place":{"id":106651,"translations":{"de":{"name":"Botanischer Garten Jean Massart (ULB)","address_street_name":"Chauss\u00e9e de Wavre","address_street_number":"1850","address_street_box":null,"email":"jardmass@ulb.be","website":"http:\/\/www.ulb.be\/actulb\/dds\/jmassart\/","phone_contact":"+32 2 650 91 65","phone_booking":null,"address_zip":"1160","address_city":"Auderghem","address_line1":"Chauss\u00e9e de Wavre, 1850","address_line2":"1160 Auderghem","description_web":"Der Botanische Garten Jean Massart wurde 1922 von dem gro\u00dfen Natursch\u00fctzer und Botanik-Professor an der Freien Universit\u00e4t Br\u00fcssel Jean Massart gegr\u00fcndet. Er befindet sich in Auderghem, ganz in der N\u00e4he der historischen Klosteranlage Rouge-Cl\u00f4itre, dem Soignes-Wald und den Parks Seny, Ten Reuken und Bergoje.\r\n\r\nAngelegt wurde der botanische Garten von dem Landschaftsarchitekten Jules Buyssens. Mit seinen rund 2000 Pflanzenarten z\u00e4hlt er zu den artenreichsten botanischen G\u00e4rten Belgiens. Bewundern k\u00f6nnen Sie sowohl einheimische als auch exotische Pflanzen, die hier von G\u00e4rtnern, Forschern und Studenten gehegt und gepflegt werden, denn der Garten dient als eine Art Freiluftlabor, in dem die positiven Effekte von Pflanzen in der Stadt erforscht wird. Zudem dient er als Museum der Freien Universit\u00e4t Br\u00fcssel und ist Teil des Wissenschaftsparcours, zu dem auch das Zoologische Museum geh\u00f6rt.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Jardin botanique Jean Massart (ULB)","address_street_name":"Chauss\u00e9e de Wavre","address_street_number":"1850","address_street_box":null,"email":"jardinmassart@ulb.ac.be","website":"https:\/\/sciences.brussels\/jardinmassart","phone_contact":"+32 2 650 91 65","phone_booking":null,"address_zip":"1160","address_city":"Auderghem","address_line1":"Chauss\u00e9e de Wavre, 1850","address_line2":"1160 Auderghem","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Jean Massart Botanical Garden (ULB)","address_street_name":"Waversesteenweg","address_street_number":"1850","address_street_box":null,"email":"jardmass@ulb.be","website":"http:\/\/www.ulb.be\/actulb\/dds\/jmassart\/","phone_contact":"+32 2 650 91 65","phone_booking":null,"address_zip":"1160","address_city":"Auderghem","address_line1":"Waversesteenweg, 1850","address_line2":"1160 Auderghem","description_web":"Named after its founder, the Jean Massart Botanical Garden was created in 1922 by this great defender of nature and professor of botany at the ULB (Free University of Brussels). It's located in Auderghem, a stone's throw from Rouge-Clo\u00eetre, the Sonian Forest and the Seny, Ten Reuken and Bergoje parks.\r\n\r\nThis botanical garden was designed by landscape architect Jules Buyssens. With some 2,000 plant species, it's one of the richest botanical gardens in Belgium and a real living museum. Admire the thousands of native and exotic plants that the gardeners, researchers and students take care of every day. The garden is an open-air laboratory for studying how plants can make cities healthier and more sustainable. It's also a museum of ULB and is part of the science trail, together with the Museum of Zoology.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Jardin botanique Jean Massart (ULB)","address_street_name":"Chauss\u00e9e de Wavre","address_street_number":"1850","address_street_box":null,"email":"jardinmassart@ulb.ac.be","website":"https:\/\/sciences.brussels\/jardinmassart","phone_contact":"+32 2 650 91 65","phone_booking":null,"address_zip":"1160","address_city":"Auderghem","address_line1":"Chauss\u00e9e de Wavre, 1850","address_line2":"1160 Auderghem","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Jardin botanique Jean Massart (ULB)","address_street_name":"Chauss\u00e9e de Wavre","address_street_number":"1850","address_street_box":null,"email":"jardinmassart@ulb.ac.be","website":"https:\/\/sciences.brussels\/jardinmassart","phone_contact":"+32 2 650 91 65","phone_booking":null,"address_zip":"1160","address_city":"Auderghem","address_line1":"Chauss\u00e9e de Wavre, 1850","address_line2":"1160 Auderghem","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Jardin botanique Jean Massart (ULB)","address_street_name":"Chauss\u00e9e de Wavre","address_street_number":"1850","address_street_box":null,"email":"jardinmassart@ulb.ac.be","website":"https:\/\/sciences.brussels\/jardinmassart","phone_contact":"+32 2 650 91 65","phone_booking":null,"address_zip":"1160","address_city":"Auderghem","address_line1":"Chauss\u00e9e de Wavre, 1850","address_line2":"1160 Auderghem","description_web":"Du nom de son fondateur, le jardin botanique Jean Massart a \u00e9t\u00e9 cr\u00e9\u00e9 en 1922 par ce grand d\u00e9fenseur de la nature et professeur de botanique \u00e0 l\u2019Universit\u00e9 Libre de Bruxelles. Il est situ\u00e9 \u00e0 Auderghem, \u00e0 deux pas du Rouge-Clo\u00eetre, de la for\u00eat de Soignes et des parcs Seny, Ten Reuken et du Bergoje.\n\nCe Jardin botanique a \u00e9t\u00e9 dessin\u00e9 par l\u2019architecte paysagiste Jules Buyssens. Avec ses quelque 2000 esp\u00e8ces v\u00e9g\u00e9tales, il est l\u2019un des plus riches jardins botaniques de Belgique et un v\u00e9ritable mus\u00e9e vivant. Admirez-y les milliers de plantes indig\u00e8nes et exotiques dont les jardiniers, chercheurs et \u00e9tudiants prennent soin quotidiennement. Le Jardin est un hotspot de biodiversit\u00e9, outre le r\u00e8gne v\u00e9g\u00e9tal, il accueille une diversit\u00e9 exceptionnelle d'animaux et surtout d'insectes avec plus de 4000 esp\u00e8ces r\u00e9pertori\u00e9es. Il est d\u2019ailleurs un mus\u00e9e de l\u2019Universit\u00e9 Libre de Bruxelles et fait partie du parcours des sciences, avec notamment le Mus\u00e9um de Zoologie.","description_print":"Cr\u00e9\u00e9 en 1922, le Jardin botanique Jean Massart est g\u00e9r\u00e9 par Bruxelles Environnement en collaboration avec l\u2019Universit\u00e9 Libre de Bruxelles.\r\nLe public peut y d\u00e9couvrir un v\u00e9ritable mus\u00e9e vivant de plein air comprenant plus  de 2000 esp\u00e8ces v\u00e9g\u00e9tales dont plusieurs centaines sont \u00e9tiquet\u00e9es.\r\nDestin\u00e9es \u00e0 la recherche, \u00e0 l\u2019enseignement universitaire et \u00e0 la vulgarisation,  les diverses collections qui le composent  se r\u00e9partissent sur 5 hectares en bordure de for\u00eat de Soignes.\r\n\r\nQue peut-on y voir ?\r\n\r\nDans la zone humide, \u00e9tang et marais abritent de nombreuses plantes typiques de notre r\u00e9gion.  \r\nUne collection impressionnante de plantes m\u00e9dicinales permet de rappeler l\u2019importance des plantes en th\u00e9rapeutique. Un verger regroupe d\u2019anciennes vari\u00e9t\u00e9s de pommiers et poiriers. L\u2019arboretum rassemble divers conif\u00e8res et d\u2019autres arbres non indig\u00e8nes.\r\nLes principales familles botaniques de plantes \u00e0 fleurs sont illustr\u00e9es dans le Jardin \u00e9volutif. Une collection de plantes cultiv\u00e9es rassemble plusieurs esp\u00e8ces domestiqu\u00e9es par l\u2019homme ainsi que leurs anc\u00eatres sauvages.\r\nEnfin, les plantes exotiques envahissantes et les plantes m\u00e9tallicoles, deux th\u00e9matiques \u00e9tudi\u00e9es au Laboratoire d\u2019Ecologie v\u00e9g\u00e9tale et Biog\u00e9ochimie, ont \u00e9galement leur parcelle de d\u00e9monstration.\r\n\r\nCe site particuli\u00e8rement riche et diversifi\u00e9 est class\u00e9 depuis 1997. \r\nIl est accessible gratuitement du lundi au vendredi de 9h00 \u00e0 17h00.\r\nDes visites guid\u00e9es sont propos\u00e9es tous les jeudis et 2\u00e8me samedi du mois (de mai \u00e0 fin octobre) ou sur rendez-vous pour les groupes (\u00e9coles, associations\u2026)\r\nhttp:\/\/www.ulb.ac.be\/musees\/jmassart \r\n","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Jard\u00edn bot\u00e1nico Jean Massart (ULB)","address_street_name":"Chauss\u00e9e de Wavre","address_street_number":"1850","address_street_box":null,"email":"jardmass@ulb.be","website":"http:\/\/www.ulb.be\/actulb\/dds\/jmassart\/","phone_contact":"+32 2 650 91 65","phone_booking":null,"address_zip":"1160","address_city":"Auderghem","address_line1":"Chauss\u00e9e de Wavre, 1850","address_line2":"1160 Auderghem","description_web":"Las ex\u00f3ticas colecciones vivientes del jard\u00edn bot\u00e1nico, creado en 1922 por Jean Massart, fueron creadas para la investigaci\u00f3n, la ense\u00f1anza universitaria y la promoci\u00f3n cient\u00edfica.\r\nPosee casi 2000 especies vegetales localizadas en 5 hect\u00e1reas y divididas en diferentes jardines: el jard\u00edn medicinal y plantas arom\u00e1ticas, el jard\u00edn bot\u00e1nico experimental, el jard\u00edn de plantas cultivadas, un huerto, un invernadero y un \u00e1rea experimental. Tambi\u00e9n puedes encontrar dos colecciones asociadas a dos estudios llevados a cabo por la ULB: vegetaci\u00f3n metalofita y plantas invasivas.\r\nTambi\u00e9n hay una \u00e1rea h\u00fameda establecida como reserva natural e inclu\u00edda en la Red Natura 2000.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Botanische tuin Jean Massart (ULB)","address_street_name":"Waversesteenweg","address_street_number":"1850","address_street_box":null,"email":"jardmass@ulb.be","website":"http:\/\/www.ulb.be\/actulb\/dds\/jmassart\/","phone_contact":"+32 2 650 91 65","phone_booking":null,"address_zip":"1160","address_city":"Oudergem","address_line1":"Waversesteenweg, 1850","address_line2":"1160 Oudergem","description_web":"Jean Massart was professor plantkunde aan de Universit\u00e9 Libre de Bruxelles. Hij was een fervent natuurliefhebber. In 1922 riep hij de tuin in Oudergem in het leven. De tuin ligt op een steenworp van het Roodklooster, het Zoni\u00ebnwoud en van het Seny-, het Tenreuken- en het Bergojepark.\r\n\r\nHet ontwerp komt van landschapsarchitect Jules Buyssens. Met ongeveer 2.000 plantensoorten is het een van de rijkste botanische tuinen van Belgi\u00eb. Hier waan je je in een levend museum. Elke dag worden de duizenden inheemse en exotische planten verzorgd door tuiniers, onderzoekers en studenten. De tuin is dan ook een openluchtlaboratorium. Hoe kunnen planten steden gezonder en duurzamer maken? Dat s de vraag waarover ze zich hier buigen. De tuin is ook een museum van de Universit\u00e9 Libre de Bruxelles en maakt deel uit van het wetenschapsparcours, samen met het Museum voor Dierkunde.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[21],"translations":{"de":["S\u00fcden"],"pt":[null],"en":["South"],"it":["Sud"],"cn":[null],"fr":["Sud"],"sp":["Sur"],"nl":["Zuid"]}},"neca":null,"facebook_id":null,"backoffice_id":369,"location":{"lat":50.8142056,"lon":4.4388072},"region":"brussels","last_updated_at":"2024-09-09T12:51:26+02:00","published_at":"2013-10-19T01:13:28+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":106651,"translations":{"de":{"name":"Botanischer Garten Jean Massart (ULB)","address_street_name":"Chauss\u00e9e de Wavre","address_street_number":"1850","address_street_box":null,"email":"jardmass@ulb.be","website":"http:\/\/www.ulb.be\/actulb\/dds\/jmassart\/","phone_contact":"+32 2 650 91 65","phone_booking":null,"address_zip":"1160","address_city":"Auderghem","address_line1":"Chauss\u00e9e de Wavre, 1850","address_line2":"1160 Auderghem","description_web":"Der Botanische Garten Jean Massart wurde 1922 von dem gro\u00dfen Natursch\u00fctzer und Botanik-Professor an der Freien Universit\u00e4t Br\u00fcssel Jean Massart gegr\u00fcndet. Er befindet sich in Auderghem, ganz in der N\u00e4he der historischen Klosteranlage Rouge-Cl\u00f4itre, dem Soignes-Wald und den Parks Seny, Ten Reuken und Bergoje.\r\n\r\nAngelegt wurde der botanische Garten von dem Landschaftsarchitekten Jules Buyssens. Mit seinen rund 2000 Pflanzenarten z\u00e4hlt er zu den artenreichsten botanischen G\u00e4rten Belgiens. Bewundern k\u00f6nnen Sie sowohl einheimische als auch exotische Pflanzen, die hier von G\u00e4rtnern, Forschern und Studenten gehegt und gepflegt werden, denn der Garten dient als eine Art Freiluftlabor, in dem die positiven Effekte von Pflanzen in der Stadt erforscht wird. Zudem dient er als Museum der Freien Universit\u00e4t Br\u00fcssel und ist Teil des Wissenschaftsparcours, zu dem auch das Zoologische Museum geh\u00f6rt.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Jardin botanique Jean Massart (ULB)","address_street_name":"Chauss\u00e9e de Wavre","address_street_number":"1850","address_street_box":null,"email":"jardinmassart@ulb.ac.be","website":"https:\/\/sciences.brussels\/jardinmassart","phone_contact":"+32 2 650 91 65","phone_booking":null,"address_zip":"1160","address_city":"Auderghem","address_line1":"Chauss\u00e9e de Wavre, 1850","address_line2":"1160 Auderghem","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Jean Massart Botanical Garden (ULB)","address_street_name":"Waversesteenweg","address_street_number":"1850","address_street_box":null,"email":"jardmass@ulb.be","website":"http:\/\/www.ulb.be\/actulb\/dds\/jmassart\/","phone_contact":"+32 2 650 91 65","phone_booking":null,"address_zip":"1160","address_city":"Auderghem","address_line1":"Waversesteenweg, 1850","address_line2":"1160 Auderghem","description_web":"Named after its founder, the Jean Massart Botanical Garden was created in 1922 by this great defender of nature and professor of botany at the ULB (Free University of Brussels). It's located in Auderghem, a stone's throw from Rouge-Clo\u00eetre, the Sonian Forest and the Seny, Ten Reuken and Bergoje parks.\r\n\r\nThis botanical garden was designed by landscape architect Jules Buyssens. With some 2,000 plant species, it's one of the richest botanical gardens in Belgium and a real living museum. Admire the thousands of native and exotic plants that the gardeners, researchers and students take care of every day. The garden is an open-air laboratory for studying how plants can make cities healthier and more sustainable. It's also a museum of ULB and is part of the science trail, together with the Museum of Zoology.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Jardin botanique Jean Massart (ULB)","address_street_name":"Chauss\u00e9e de Wavre","address_street_number":"1850","address_street_box":null,"email":"jardinmassart@ulb.ac.be","website":"https:\/\/sciences.brussels\/jardinmassart","phone_contact":"+32 2 650 91 65","phone_booking":null,"address_zip":"1160","address_city":"Auderghem","address_line1":"Chauss\u00e9e de Wavre, 1850","address_line2":"1160 Auderghem","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Jardin botanique Jean Massart (ULB)","address_street_name":"Chauss\u00e9e de Wavre","address_street_number":"1850","address_street_box":null,"email":"jardinmassart@ulb.ac.be","website":"https:\/\/sciences.brussels\/jardinmassart","phone_contact":"+32 2 650 91 65","phone_booking":null,"address_zip":"1160","address_city":"Auderghem","address_line1":"Chauss\u00e9e de Wavre, 1850","address_line2":"1160 Auderghem","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Jardin botanique Jean Massart (ULB)","address_street_name":"Chauss\u00e9e de Wavre","address_street_number":"1850","address_street_box":null,"email":"jardinmassart@ulb.ac.be","website":"https:\/\/sciences.brussels\/jardinmassart","phone_contact":"+32 2 650 91 65","phone_booking":null,"address_zip":"1160","address_city":"Auderghem","address_line1":"Chauss\u00e9e de Wavre, 1850","address_line2":"1160 Auderghem","description_web":"Du nom de son fondateur, le jardin botanique Jean Massart a \u00e9t\u00e9 cr\u00e9\u00e9 en 1922 par ce grand d\u00e9fenseur de la nature et professeur de botanique \u0