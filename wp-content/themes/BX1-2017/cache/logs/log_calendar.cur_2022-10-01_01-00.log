. Et sur celle-ci se posera une \u00e9motion, un univers, une histoire, des personnages. Puis un autre \u00e9l\u00e9ment, un autre univers, un autre d\u00e9cor. Et voil\u00e0 que les \u00e9l\u00e9ments entrent en mouvement, s\u2019entrem\u00ealent, s\u2019ignorent, s\u2019entrechoquent, s\u2019esquivent, s\u2019accompagnent, se s\u00e9parent, grandissent pour exprimer quelque chose de plus grand que nous.\r\n\r\nVenez, on vous emporte dans notre tourbillon.","performers":"Arnaud Petit, Laurent Cadet, Nicolas Lembr\u00e9e, Laura Matthys, Sarah Pochez, Alexandre Valancin, Catherine Lembr\u00e9e, Kevin Dehut, Laurie Andrieu, Pierre Deguee, Elsa Mikmik, Laurent Van der Rest, Mana Livardjani","boxoffice_url":null,"website":"https:\/\/www.improviste.be\/VertigO-31.html","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.539788"},"nl":{"name":"Vertig\u00d4","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.539788"},"en":{"name":"Vertig\u00d4","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.539788"},"de":{"name":"Vertig\u00d4","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.539788"},"it":{"name":"Vertig\u00d4","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.539788"},"sp":{"name":"Vertig\u00d4","shortdescr":null,