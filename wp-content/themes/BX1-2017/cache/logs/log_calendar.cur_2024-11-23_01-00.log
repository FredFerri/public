,{"day":"2024-11-27","start":"18:00:00","end":"21:00:00"},{"day":"2025-01-29","start":"18:00:00","end":"21:00:00"},{"day":"2025-02-26","start":"18:00:00","end":"21:00:00"}],"closing_days":["2024-12-25","2025-01-01"],"child_events":[],"parent_events":[],"accessibilities":[],"visit_profile":{"list":[337],"translations":{"de":["Highlight"],"pt":[null],"en":["Highlight"],"it":["Highlight"],"cn":[null],"fr":["Highlight"],"sp":["Highlight"],"nl":["Highlight"]}},"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[]},{"id":5700002570,"date_start":"2024-11-08","date_end":"2024-12-21","date_next":"2024-11-22","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-11-22T01:01:18+01:00","published_at":"2024-10-14T11:32:01+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":309702,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"other","ranking":0.2832581674713524,"languages":{"spoken":["nl","en","fr"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[30,24],"translations":{"de":["Malerei","Kunstgalerien"],"pt":[null,null],"en":["Painting","Art Galleries"],"it":["Pittura","Gallerie d'arte"],"cn":[null,null],"fr":["Peinture","Galeries d'art"],"sp":["Pintura","Galer\u00edas de arte"],"nl":["Schilderkunst","Galeries"]}}},"translations":{"de":{"name":"Christine Nicaise","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.zedes-art-gallery.be","email":"zedes.art.gallery@gmail.com","phone_contact":"+32 475 52 62 58","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700002570"},"pt":{"name":"Christine Nicaise","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.zedes-art-gallery.be","email":"zedes.art.gallery@gmail.com","phone_contact":"+32 475 52 62 58","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700002570"},"en":{"name":"Christine Nicaise","shortdescr":"Always in search of the spontaneous gesture, the artist\ncasts a sign, the energy of which emerges like the promise of an advent. This\nsign, illegible to our eyes, does not designate, does not enunciate, does not\nenclose; it enjoys existence before any structuring, before any grammar.","longdescr":"All the primordial elements are present in the art of Christine Nicaise : water, air, earth and fire. They\ncontribute to the sober palette of silent nature. In his canvases, there is no inside\nor outside, because the artist fundamentally rejects the constraint of the frame,\nwhich explains why there is no stretcher. So, the canvas lives freely.\nChristine Nicaise dilutes the layers and rubs them down to transparency. She\nblurs the colour and gives the material a matt patina. This refined austerity leaves\nno trace of the brush. We are in the reign of continuity, of purity, of patience, in a\nkind of time given to time. Always in search of the spontaneous gesture, the artist\ncasts a sign, the energy of which emerges like the promise of an advent. This\nsign, illegible to our eyes, does not designate, does not enunciate, does not\nenclose; it enjoys existence before any structuring, before any grammar.","performers":"Always in search of the spontaneous gesture, the artist Christine Nicaise\ncasts a sign, the energy of which emerges like the promise of an advent. This\nsign, illegible to our eyes, does not designate, does not enunciate, does not\nenclose; it enjoys existence before any structuring, before any grammar.","boxoffice_url":null,"website":"http:\/\/www.zedes-art-gallery.be","email":"zedes.art.gallery@gmail.com","phone_contact":"+32 475 52 62 58","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700002570"},"it":{"name":"Christine Nicaise","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.zedes-art-gallery.be","email":"zedes.art.gallery@gmail.com","phone_contact":"+32 475 52 62 58","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700002570"},"cn":{"name":"Christine Nicaise","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.zedes-art-gallery.be","email":"zedes.art.gallery@gmail.com","phone_contact":"+32 475 52 62 58","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700002570"},"fr":{"name":"Christine Nicaise","shortdescr":"Dans l'univers de Christine Nicaise,  nous sommes dans le r\u00e8gne du continu, de\nl\u2019\u00e9pur\u00e9, de la patience, dans une sorte de temps donn\u00e9 au temps. Toujours \u00e0 la\nrecherche du geste spontan\u00e9, l\u2019artiste jette un signe, dont l\u2019\u00e9nergie survient\ncomme la promesse d\u2019un av\u00e8nement. Ce signe, illisible \u00e0 nos yeux, ne d\u00e9signe\npas, il jouit de l\u2019existence avant toute structuration,avant toute grammaire.","longdescr":"Dans l'univers de Christine Nicaise,  nous sommes dans le r\u00e8gne du continu, de\nl\u2019\u00e9pur\u00e9, de la patience, dans une sorte de temps donn\u00e9 au temps. Toujours \u00e0 la\nrecherche du geste spontan\u00e9, l\u2019artiste jette un signe, dont l\u2019\u00e9nergie survient\ncomme la promesse d\u2019un av\u00e8nement. Ce signe, illisible \u00e0 nos yeux, ne d\u00e9signe\npas, n\u2019\u00e9nonce pas, n\u2019enferme pas, il jouit de l\u2019existence avant toute structuration,\navant toute grammaire.\nDans le travail r\u00e9cent,  se d\u00e9ploient en toute libert\u00e9 des signes et gribouillis plus denses\nqui imposent leur nouveau territoire dans l\u2019espace pictural. Cette po\u00e9sie graphique\n\u00e0 la fois rythm\u00e9e, tendue et contrast\u00e9e accroche ici notre attention avec un regard\nbien diff\u00e9rent et t\u00e9moigne d\u2019un regain vital, une nouvelle pulsion cr\u00e9ative de\nl'artiste.","performers":"Christine Nicaise","boxoffice_url":null,"website":"http:\/\/www.zedes-art-gallery.be","email":"zedes.art.gallery@gmail.com","phone_contact":"+32 475 52 62 58","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700002570"},"sp":{"name":"Christine Nicaise","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.zedes-art-gallery.be","email":"zedes.art.gallery@gmail.com","phone_contact":"+32 475 52 62 58","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700002570"},"nl":{"name":"Christine Nicaise","shortdescr":"Het teken dat Christine Nicaise op haar doek werpt, blijft onleesbaar\nvoor onze ogen. Het wijst niet, het beperkt niet. Het is het absolute teken, dat\nbestaat v\u00f3\u00f3r elke structurering, v\u00f3\u00f3r elke grammatica.\nHet schilderij van Christine Nicaise komt ergens vandaan, waar dingen\ngebeuren, maar zonder ons te vertellen wat,\u201d zegt Jean Marie Klinkenberg van de\nKoninklijke Academie van Belgi\u00eb.","longdescr":"Het teken dat Christine Nicaise op haar doek werpt, blijft onleesbaar\nvoor onze ogen. Het wijst niet, het beperkt niet. Het is het absolute teken, dat\nbestaat v\u00f3\u00f3r elke structurering, v\u00f3\u00f3r elke grammatica.\nHet schilderij van Christine Nicaise komt ergens vandaan, waar dingen\ngebeuren, maar zonder ons te vertellen wat,\u201d zegt Jean Marie Klinkenberg van de\nKoninklijke Academie van Belgi\u00eb.\nAlle primaire elementen spelen een rol: water, lucht, aarde en vuur. Op het doek\nis er geen buiten of binnen. Christine Nicaise verwerpt fundamenteel de\nbeperking van het frame. Het doek leeft vrij.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.zedes-art-gallery.be","email":"zedes.art.gallery@gmail.com","phone_contact":"+32 475 52 62 58","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700002570"}},"place":{"id":260455,"translations":{"de":{"name":"zedes art gallery","address_street_name":"Rue Paul Lauters","address_street_number":"36","address_street_box":null,"email":"zedes.art.gallery@gmail.com","website":"http:\/\/www.zedes-art-gallery.be","phone_contact":"+32 475 52 62 58","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Paul Lauters, 36","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"zedes art gallery","address_street_name":"Rue Paul Lauters","address_street_number":"36","address_street_box":null,"email":"zedes.art.gallery@gmail.com","website":"http:\/\/www.zedes-art-gallery.be","phone_contact":"+32 475 52 62 58","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Paul Lauters, 36","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"zedes art gallery","address_street_name":"Rue Paul Lauters","address_street_number":"36","address_street_box":null,"email":"zedes.art.gallery@gmail.com","website":"http:\/\/www.zedes-art-gallery.be","phone_contact":"+32 475 52 62 58","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Paul Lauters, 36","address_line2":"1050 Ixelles","description_web":null,"descriptio