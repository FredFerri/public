:{"name":"Cerebrum, le faiseur de r\u00e9alit\u00e9s","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.roseraie.org\/cerebrum","email":"secretariat@roseraie.org","phone_contact":"+32 2 376 46 45","phone_booking":"+32 2 376 46 45","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50005835"},"en":{"name":"Cerebrum, le faiseur de r\u00e9alit\u00e9s","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.roseraie.org\/cerebrum","email":"secretariat@roseraie.org","phone_contact":"+32 2 376 46 45","phone_booking":"+32 2 376 46 45","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50005835"},"it":{"name":"Cerebrum, le faiseur de r\u00e9alit\u00e9s","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.roseraie.org\/cerebrum","email":"secretariat@roseraie.org","phone_contact":"+32 2 376 46 45","phone_booking":"+32 2 376 46 45","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50005835"},"cn":{"name":"Cerebrum, le faiseur de r\u00e9alit\u00e9s","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.roseraie.org\/cerebrum","email":"secretariat@roseraie.org","phone_contact":"+32 2 376 46 45","phone_booking":"+32 2 376 46 45","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50005835"},"fr":{"name":"Cerebrum, le faiseur de r\u00e9alit\u00e9s","shortdescr":"Notre cerveau r\u00e9invente sans cesse notre r\u00e9alit\u00e9 !","longdescr":"Sous des allures de conf\u00e9rence, ce spectacle, alliant th\u00e9\u00e2tre et sciences, nous invite \u00e0 exp\u00e9rimenter les ph\u00e9nom\u00e8nes cr\u00e9\u00e9s par notre cerveau qui d\u00e9finissent pourtant notre r\u00e9alit\u00e9 et notre identit\u00e9.\n\nAncien biophysicien sp\u00e9cialis\u00e9 dans la plasticit\u00e9 c\u00e9r\u00e9brale, aujourd\u2019hui acteur, Yvain Juillard nous propose lors d\u2019une conf\u00e9rence spectacle d\u2019interroger le fonctionnement de notre cerveau afin de questionner la nature multiple de la r\u00e9alit\u00e9.","performers":"\u00b7 LABEL D'UTILIT\u00c9 PUBLIQUE DE LA COCOF EN 2020 \u00b7 Cr\u00e9ation, interpr\u00e9tation Yvain Juillard. \u0152il ext\u00e9rieur Olivier Boudon, Joseph Lacrosse, Laurent Wanson. Son Marc Doutrepont. R\u00e9gie g\u00e9n\u00e9rale et lumi\u00e8res Vincent Tandonnet. Vid\u00e9o Stefano Serra, Robin Yerl\u00e8s. Conseils neuroscientifiques Yves Rossetti, C\u00e9line Cappe. Production, diffusion et presse Lucie Dela Croix, Caroline Goutaudier. ","boxoffice_url":null,"website":"https:\/\/www.roseraie.org\/cerebrum","email":"secretariat@roseraie.org","phone_contact":"+32 2 376 46 45","phone_booking":"+32 2 376 46 45","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50005835"},"sp":{"name":"Cerebrum, le faiseur de r\u00e9alit\u00e9s","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.roseraie.org\/cerebrum","email":"secretariat@roseraie.org","phone_contact":"+32 2 376 46 45","phone_booking":"+32 2 376 46 45","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50005835"},"nl":{"name":"Cerebrum, le faiseur de r\u00e9alit\u00e9s","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.roseraie.org\/cerebrum","email":"secretariat@roseraie.org","phone_contact":"+32 2 376 46 45","phone_booking":"+32 2 376 46 45","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50005835"}},"place":{"id":231528,"translations":{"de":{"name":"La Roseraie","address_street_name":"Chauss\u00e9e d'Alsemberg","address_street_number":"1299","address_street_box":null,"email":"secretariat@roseraie.org","website":"http:\/\/www.roseraie.org","phone_contact":"+32 2 376 46 45","phone_booking":"+32 2 376 46 45","address_zip":"1180","add