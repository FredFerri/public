La pi\u00e8ce nous raconte la relation enfant(s) \/ parent(s) \u00e0 travers une approche r\u00e9aliste et bienveillante de la famille, quelle qu\u2019elle soit. C\u2019est ce lien qui va construire l\u2019enfant et certainement d\u00e9finir une partie de l\u2019adulte qu\u2019il deviendra : un moment crucial dans le cycle de la vie. \u00ab Mama \u00bb am\u00e8ne le public \u00e0 visiter les diff\u00e9rentes formes de parentalit\u00e9 \u00e0 travers un album de famille burlesque et de tendres confidences.","performers":"Avec Despina Psimarnou et Italia Gaeta\nPar la compagnie Jordi L. Vidal\nEcriture : Italia Gaeta\nMise en sc\u00e8ne : Jordi L. Vidal\nCostumes et accessoires : Claire Farah\nR\u00e9sidences de cr\u00e9ation : D\u00e9 au Coudre, Th\u00e9\u00e2tre de la Parole Bruxelles","boxoffice_url":null,"website":"https:\/\/ccjette.be\/evenement\/mama\/","email":"info@ccjette.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50004204"},"sp":{"name":"Mama","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/ccjette.be\/evenement\/mama\/","email":"info@ccjette.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50004204"},"nl":{"name":"Mama","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/ccjette.be\/evenement\/mama\/","email":"info@ccjette.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50004204"}},"place":{"id":232524,"translations":{"de":{"name":"Centre Culturel de Jette","address_street_name":"Bld de Smet de Naeyer","address_street_number":"145","address_street_box":null,"email":"info@ccjette.be","website":"http:\/\/www.ccjette.be","phone_contact":"+32 2 426 64 39","phone_booking":null,"address_zip":"1090","address_city":"Jette","address_line1":"Bld de Smet de Nae