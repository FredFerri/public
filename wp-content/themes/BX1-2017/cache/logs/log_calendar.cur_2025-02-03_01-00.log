 een kunstgalerie, een coworkingruimte, een bar en ... een sportzaal onder \u00e9\u00e9n dak! Hier ontdek je enkele van de mooiste stukken uit de collectie van deze liefhebber van de moderne kunst in een strak kader. Er zijn bijvoorbeeld werken te bewonderen van Fabrice Samyn, kleurrijke weefkunst van Alighiero Boetti, werken van Louise Bourgeois, Lucio Fontana en een mooie selectie kunst van opkomende kunstenaars.","description_print":null,"booking_url":null,"sort_order":"Cloud","virtual_visit":null,"visit_url":null}},"neca":"art_center","facebook_id":null,"region":"brussels","backoffice_id":37392,"location":{"lat":50.8560861,"lon":4.3481363},"last_updated_at":"2024-10-11T12:30:57+02:00","published_at":"2021-10-22T14:19:28+02:00","is_in_address_book":true,"is_in_vb_export":false,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[],"dates":[{"day":"2025-01-23","doors":null,"start":"14:00:00","end":"18:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2025-01-24","doors":null,"start":"14:00:00","end":"18:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2025-01-25","doors":null,"start":"14:00:00","end":"18:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2025-01-26","doors":null,"start":"14:00:00","end":"18:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2025-01-28","doors":null,"start":"14:00:00","end":"18:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2025-01-29","doors":null,"start":"14:00:00","end":"18:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2025-01-30","doors":null,"start":"14:00:00","end":"18:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2025-01-31","doors":null,"start":"14:00:00","end":"18:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2025-02-01","doors":null,"start":"14:00:00","end":"18:00:00","end_night_li