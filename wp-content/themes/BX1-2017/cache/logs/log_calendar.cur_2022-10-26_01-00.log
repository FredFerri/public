e Haute 195\r\n1000 Bruxelles","performers":null,"boxoffice_url":null,"website":"https:\/\/www.facebook.com\/institutfrancaisdesarts","email":"institutfrancaisdesarts@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.542829"},"nl":{"name":"Exposition \/\/\/ Retrospective \/\/\/ Thierry Dussac","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.542829"},"en":{"name":"Exposition \/\/\/ Retrospective \/\/\/ Thierry Dussac","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.542829"},"de":{"name":"Vernissage \/\/\/ Retrospective \/\/\/ Thierry Dussac","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.542829"},"it":{"name":"Vernissage \/\/\/ Retrospective \/\/\/ Thierry Dussac","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.542829"},"sp":{"name":"Vernissage \/\/\/ Retrospective \/\/\/ Thierry Dussac","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.542829"},"pt":{"name":"Vernissage \/\/\/ Retrospective \/\/\/ Thierry Dussac","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":nul