id":248907,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.23112042478354},{"id":533886,"date_start":"2022-05-22","date_end":"2022-05-22","date_next":"2022-05-22","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre"}},"others":{"list":[55],"translations":{"fr":["Th\u00e9\u00e2tre de marionnettes"],"nl":["Poppentheater"],"en":["Puppet show"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Florian le Magnifique","shortdescr":"Th\u00e9\u00e2tre forain , et farce comique des plus d\u00e9jant\u00e9s, Fahem Ab\u00e8s joue de la marionnette \u00e0 gaine de fa\u00e7on grotesque et satirique. Un vrai plaisir th\u00e9\u00e2yral de marionnettes et de conteur!","longdescr":"Dans le style du Th\u00e9\u00e2tre Forain, de la Farce et de la Com\u00e9die, ce spectacle Supervitamin\u00e9s se joue devant une magnifique Roulotte.    \r\n\"Partenaire complice\" le public s'amuse et se d\u00e9lecte de la folie artistique qui se d\u00e9gage du spectacle.\r\nUn vrai r\u00e9gal, une v\u00e9ritable gourmandise, un d\u00e9lice \u00e0 croquer sans mod\u00e9ration pour tous et par tous, enfants et parents et ados.\r\n\r\nSpectacle en fran\u00e7ais, \u00e0 partir de 4 ans. Dur\u00e9e: 30'\r\nDans le cadre du JEM festival au Peruchet (dans les jardins).","performers":"Fahem Ab\u00e8s","boxoffice_url":null,"website":"https:\/\/theatreperuchet.be\/home\/festival-2022\/","email":"info@theatreperuchet.be","phone_contact":"+32 2 673 87 30","phone_booking":"+32 2 673 87 30","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/533886.html"},"nl":{"name":"Florian le Magnifique","shortdescr":"Kermistheater, en de gekste komische klucht, Fahem Ab\u00e8s speelt met handpoppen op een groteske en satirische manier. Een echt theatraal plezier van poppen en verteller!","longdescr":"In de stijl van het Kermistheatre, Farce en Com\u00e9die, wordt deze Supervitamin\u00e9s show opgevoerd voor een prachtige Roulotte.    \r\nAls \"medeplichtige partner\" wordt het publiek geamuseerd en vermaakt in de artistieke waanzin die uit de voorstelling naar voren komt.\r\nEen echte traktatie, een echte delicatesse, een genot om zonder mate van te genieten door iedereen, kinderen, ouders en tieners.\r\n\r\nVoorstelling in het Frans, vanaf 4 jaar. Duur: 30 minuten\r\nAls onderdeel van het YWAM festival in Peruchet (in de tuinen","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/533886.html"},"en":{"name":"Florian le Magnifique","shortdescr":"Fairground theatre, and the craziest comic farce, Fahem Ab\u00e8s plays with glove puppets in a grotesque and satirical way. A real theatrical pleasure of puppets and storyteller!","longdescr":"n the style of the Th\u00e9\u00e2tre Forain, Farce and Com\u00e9die, this Supervitamin\u00e9s show is performed in front of a magnificent Roulotte.    \r\nAs an \"accomplice partner\", the audience is amused and delights in the artistic madness that emerges from the show.\r\nA real treat, a real delicacy, a delight to be enjoyed without moderation by everyone, children, parents and teenagers.\r\n\r\nShow in French, from 4 years old. Duration: 30 minutes\r\nAs part of the YWAM festival in Peruchet (in the gardens).","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/533886.html"},"de":{"name":"Florian le Magnifique","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/533886.html"},"it":{"name":"Florian le Magnifique","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/533886.html"},"sp":{"name":"Florian le Magnifique","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/533886.html"},"pt":{"name":"Florian le Magnifique","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/533886.html"},"cn":{"name":"Florian le Magnifique","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/533886.html"}},"place":{"id":241472,"translations":{"fr":{"name":"Th\u00e9\u00e2tre Royal du Peruchet","address_street_name":"Avenue de la For\u00eat","address_street_number":"50","address_street_box":null,"email":"info@theatreperuchet.be","website":"http:\/\/www.theatreperuchet.be","phone_contact":"+32 2 673 87 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue de la For\u00eat, 50","address_line2":"1050 Ixelles","description_web":"Fond\u00e9 en 1929 par Carlo Speder, le P\u00e9ruchet est un th\u00e9\u00e2tre de marionnettes \u00e0 fils qui propose un r\u00e9pertoire unique de contes traditionnels (Andersen, les fr\u00e8res Grimm, Charles Perrault, Daudet, Lafontaine, Kipling, Hoffman...) pour les petits et les grands enfants. Il est situ\u00e9 \u00e0 Ixelles depuis 1968, dans une fermette du 19\u00e8me si\u00e8cle. La l\u00e9gende raconte qu'elle aurait abrit\u00e9 Charles Decoster, l'auteur de Till Ulenspiegel. En 1983, le th\u00e9\u00e2tre s'est dot\u00e9 d'un lieu pour son Mus\u00e9e International de la Marionnette (fond\u00e9 en 1938 et accessible au public jusqu'en 1968), qui poss\u00e8de une collection des plus vari\u00e9es et des plus riches parmi les Mus\u00e9es europ\u00e9ens de la Marionnette. Les spectacles s'adressent aux enfants \u00e0 partir de 3 ans et vous pouvez visiter le mus\u00e9e pendant l'entracte des spectacles.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Th\u00e9\u00e2tre Royal du Peruchet","address_street_name":"Woudlaan","address_street_number":"50","address_street_box":null,"email":"info@theatreperuchet.be","website":"http:\/\/www.theatreperuchet.be","phone_contact":"+32 2 673 87 30","phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"Woudlaan, 50","address_line2":"1050 Elsene","description_web":"Het marionettentheater werd in 1929 opgericht in Brussel door Carlo Speder. Le P\u00e9ruchet speelt een uniek repertoire van traditionele sprookjes (Andersen, de gebroeders Grimm, Charles Perrault, Daudet, Lafontaine, Kipling, Hoffman...) voor kinderen... en voor hen die hun kinderhart hebben weten te bewaren. Het theater is sinds 1968 gevestigd in de gemeente Elsene, in een 19e-eeuwse boerderij waar volgens de legende Charles Decoster heeft gewoond (de schrijver van Tijl Ulenspiegel!). In 1983 vond het theater P\u00e9ruchet de middelen om zijn internationaal poppenmuseum in te richten, een van de rijkste en meest gevarieerde collecties in Europa. Je kan het museum bezoeken tijdens de pauzes van de voorstellingen. De voorstellingen zijn geschikt voor kinderen vanaf 3 jaar. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Th\u00e9\u00e2tre Royal du Peruchet","address_street_name":"Avenue de la For\u00eat","address_street_number":"50","address_street_box":null,"email":"info@theatreperuchet.be",