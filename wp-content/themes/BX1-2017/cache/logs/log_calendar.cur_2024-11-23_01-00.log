","is_only_by_appointment":true,"start":"16:00:00","timestamp":"2024-11-14T16:00:00"}},{"id":5700003495,"date_start":"2024-11-01","date_end":"2024-11-30","date_next":"2024-11-22","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-11-22T01:00:52+01:00","published_at":"2024-11-12T08:46:43+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":311281,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"other","ranking":0.3218297948685433,"languages":{"spoken":["en","fr"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{}},"translations":{"de":{"name":"November Exhibition","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.sablondart.com","email":"sablondart@sablondart.com","phone_contact":"+32 470 38 06 63","phone_booking":"+32 470 38 06 63","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700003495"},"pt":{"name":"November Exhibition","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.sablondart.com","email":"sablondart@sablondart.com","phone_contact":"+32 470 38 06 63","phone_booking":"+32 470 38 06 63","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700003495"},"en":{"name":"November Exhibition","shortdescr":"Dive into a world of art at Sablon d'Art\u2019s year-end exhibition! Five unique artists explore beauty, emotion, and movement through painting, sculpture, and photography. From powerful gestures to delicate forms, each piece invites you to feel, reflect, and be moved. Don\u2019t miss this celebration of creativity and artistry!","longdescr":"We are thrilled to announce our year-end exhibition, showcasing the work of 5 talented artists over the span of two months:\n\nGotiez \u2013 Allows himself to be guided by the material and the pleasure of movement, aiming to establish an intense dialogue between himself and the canvas.\n\n Agnes L-D Steeg \u2013 With a lifelong passion for artistic creation, she blends drawing, painting, and sculpture to capture the softness and strength of beings in motion, crafting powerful yet delicate works.\n\n Benedicte Fran\u00e7ois \u2013 Uses rounded, sensual shapes to express emotions through acrylics on canvas, celebrating harmony and beauty.\n\n Jo\u00eblle Boismery \u2013 Creates compositions of lines and colors, producing photographs that uniquely capture their essence with an artistic touch.\n\n Isabelle Wathelet \u2013 Decorator and ceramicist, she explores asymmetry and imperfection in her \"ORGANIC\" sculptures and GA\u00cfA ceramic vases, celebrating the authentic beauty and uniqueness of each creation.\n\nThe gallery will be open from Thursday to Sunday, 11 AM to 6 PM, and we warmly invite you to the opening on Thursday, November 7, from 6 PM to 9 PM. \nWe look forward to seeing many of you there! \n\nSablon d'Art","performers":"Gotiez (painting ) ; Agnes L-D Steeg ( sculpture ) ; Benedicte Fran\u00e7ois (acrylics) ;Jo\u00eblle Boismery (photography );  Isabelle Wathelet ( ceramics )","boxoffice_url":null,"website":"https:\/\/www.sablondart.com","email":"sablondart@sablondart.com","phone_contact":"+32 470 38 06 63","phone_booking":"+32 470 38 06 63","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700003495"},"it":{"name":"November Exhibition","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.sablo