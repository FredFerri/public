30+02:00","published_at":"2023-07-10T12:04:10+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":281644,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"theatre","ranking":0.8735804647362989,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":49,"translations":{"de":"Theater","pt":null,"en":"Theatre","it":"Teatro","cn":null,"fr":"Th\u00e9\u00e2tre","sp":"Teatro","nl":"Theater"}},"others":{"list":[50],"translations":{"de":["Theater"],"pt":[null],"en":["Theatre"],"it":["Teatro"],"cn":[null],"fr":["Th\u00e9\u00e2tre"],"sp":["Teatro"],"nl":["Theater"]}}},"translations":{"de":{"name":"Classement Sans Suite","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrecreanova.be\/spectacle\/classement-sans-suite\/","email":"adm@theatrecreanova.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.561644"},"pt":{"name":"Classement Sans Suite","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrecreanova.be\/spectacle\/classement-sans-suite\/","email":"adm@theatrecreanova.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.561644"},"en":{"name":"Classement Sans Suite","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrecreanova.be\/spectacle\/classement-sans-suite\/","email":"adm@theatrecreanova.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.561644"},"it":{"name":"Classement Sans Suite","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrecreanova.be\/spectacle\/classement-sans-suite\/","email":"adm@theatrecreanova.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.561644"},"cn":{"name":"Classement Sans Suite","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrecreanova.be\/spectacle\/classement-sans-suite\/","email":"adm@theatrecreanova.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.561644"},"fr":{"name":"Classement Sans Suite","shortdescr":"\u00abClassement sans suite\u00bb est un spectacle qui d\u00e9construit les pr\u00e9jug\u00e9s existants autour des violences sexuelles et qui nous parle des failles de notre syst\u00e8me judiciaire face \u00e0 ces violences sp\u00e9cifiques.","longdescr":"\u00abClassement sans suite\u00bb est une histoire, qui se veut, universelle. C\u2019est l\u2019histoire non pas d\u2019une victime de violences sexuelles mais de toutes les victimes, quels que soient leur \u00e2ge, leur genre, leur classe sociale, leur origine, leur lien avec l\u2019agresseur, qui d\u00e9cident de porter plainte aupr\u00e8s des services de police et d\u2019entamer une proc\u00e9dure judiciaire.\r\n\r\nSur sc\u00e8ne, cinq com\u00e9dien.ne.s dont chacun.e repr\u00e9sente une symbolique de ce parcours judiciaire : la victime (Griselda), l\u2019agresseur (Vincent), l\u2019entourage de la victime (Sophie), les associations qui accompagnent les victimes (Agn\u00e8s) et les institutions judiciaires et polici\u00e8res (Enzo).\r\n\r\nChaque com\u00e9dien.ne incarne son r\u00f4le dans toutes ses d\u00e9clinaisons possibles. Par exemple, Vincent jouera tous les agresseurs, \u00e0 la fois jeune et plus \u00e2g\u00e9, d\u2019origine \u00e9trang\u00e8re ou non, proche ou \u00e9loign\u00e9 de la victime, reconnaissant ou non sa responsabilit\u00e9...\r\n\r\nLa pi\u00e8ce est donc le r\u00e9cit d\u2019une histoire qui parle de toutes les histoires et qui nous renvoie \u00e0 notre r\u00e9alit\u00e9; celle d\u2019une soci\u00e9t\u00e9 dont les st\u00e9r\u00e9otypes doivent encore \u00eatre d\u00e9construits et qui doit absolument continuer \u00e0 combattre la culture du viol; celle d\u2019une justice, malgr\u00e9 une am\u00e9lioration de la prise en charge des victimes de violences sexuelles, peu encline \u00e0 la r\u00e9paration et \u00e0 la restauration des victimes.","performers":"Ecrit et mis en sc\u00e8ne par Luca Franceschi \r\nD'apr\u00e8s une initiative de Caroline Poir\u00e9, avocate p\u00e9naliste au Barreau de Bruxelles\r\nAvec la collaboration artistique de Carole Ventura\r\nInterpr\u00e9t\u00e9 par : Luca Franceschi, Julie Marichal, Caroline Poir\u00e9, Carole Ventura, Fabio Zenoni","boxoffice_url":null,"website":"https:\/\/www.theatrecreanova.be\/spectacle\/classement-sans-suite\/","email":"adm@theatrecreanova.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.561644"},"sp":{"name":"Classement Sans Suite","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrecreanova.be\/spectacle\/classement-sans-suite\/","email":"adm@theatrecreanova.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.561644"},"nl":{"name":"Classement Sans Suite","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrecreanova.be\/spectacle\/classement-sans-suite\/","email":"adm@theatrecreanova.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.561644"}},"place":{"id":275475,"translations":{"de":{"name":"Th\u00e9\u00e2tre CreaNova","address_street_name":"rue de la victoire ","address_street_number":"96","address_street_box":"1060","email":"contact@creabxl.org","website":"http:\/\/www.creatheatrebruxelles.be","phone_contact":"+32 499 50 12 28","phone_booking":nul