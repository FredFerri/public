\nIl n'y a donc pas de 91eme parall\u00e8le...Un nom d'\u00e9quipe est un peu loufoque, un v\u00e9ritable petit clin d\u2019\u0153il au surr\u00e9alisme belge !\n\n\nVisites publiques et priv\u00e9es, pour petits et grands, jeunes et moins jeunes. Tous nos \"voyages\" sont repris dans l'agenda en ligne sur notre site internet.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"91\u00e8me parall\u00e8le","address_street_name":"Rue Gaucheret","address_street_number":"4","address_street_box":"B73","email":"info@91parallele.be","website":"https:\/\/91parallele.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Rue Gaucheret, 4 \/ B73","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"91\u00e8me parall\u00e8le","address_street_name":"Gaucheretstraat","address_street_number":"4","address_street_box":"B73","email":"info@91parallele.be","website":"https:\/\/91parallele.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1030","address_city":"Schaarbeek","address_line1":"Gaucheretstraat, 4 \/ B73","address_line2":"1030 Schaarbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":41178,"location":{"lat":50.8624095,"lon":4.3601281},"last_updated_at":"2023-10-25T09:28:08+02:00","published_at":"2023-08-28T11:27:17+02:00","is_in_address_book":true,"is_in_vb_export":false,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/ab74c1c61cfa1e918a2039c6a9f9d060b8f75249.jpg","width":701,"height":520,"ratio":1.35,"oEmbed_height":520,"oEmbed_width":701,"translations":{"de":{"title":"Sang pour sang : Bruxelles au fil d