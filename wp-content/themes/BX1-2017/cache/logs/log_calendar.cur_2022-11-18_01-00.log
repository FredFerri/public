022-10-20T18:05:05+02:00","published_at":"2022-10-20T17:18:16+02:00","backoffice_id":264453,"import_origin":null,"sub_type":"concert","show_in_agenda":true,"ranking":1.2599210498949},{"id":545168,"date_start":"2022-11-26","date_end":"2022-11-26","date_next":"2022-11-26","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert","de":"Konzert"}},"others":{"list":[3],"translations":{"fr":["Musique Contemporaine"],"nl":["Hedendaagse Muziek"],"en":["Contemporary music"],"de":["Zeitgen\u00f6ssische Musik"]}}},"languages":{"spoken":["fr","en"],"subtitles":[]},"translations":{"fr":{"name":"Ars Musica - Piano exp\u00e9rimental: concerts et conf\u00e9rences","shortdescr":"Trois moments rares et inou\u00efs o\u00f9 le piano se d\u00e9couvre dans une aventure musicale transdisciplinaire, technologiques ou improvis\u00e9e, entre conf\u00e9rences et concerts.","longdescr":"Contemporain, d\u2019improvisation, augment\u00e9 de syst\u00e8mes technologiques ou pr\u00e9par\u00e9, le piano est un instrument d\u2019exp\u00e9rimentation sans limites\u2026 L\u2019\u00e9v\u00e8nement Piano exp\u00e9rimental se compose de trois conf\u00e9rences-concerts,consacr\u00e9es \u00e0 l\u2019aventure musicale infinie du piano.\r\n\r\nEntre nouvelle lutherie et approche organique de l\u2019instrument, le duo exp\u00e9rimental que Claudine Simon forme avec Vivien Trelcat d\u00e9veloppe le projet Pianomachine, \u00e9lectronique et acoustique, transdisciplinaire et hybride.\r\n\r\nPour Martin Loridan, la notion de P\u00e9dale \u00e9tendue : repenser l\u2019intra-piano, consiste en l\u2019\u00e9largissement du jeu pianistique depuis une exploration, \u00e9rudite, de la technicit\u00e9 de son orf\u00e8vrerie instrumentale, ce qu\u2019il nous d\u00e9montre en compagnie de Gian Ponte et du duo Tomoko Honda \/ Sara Picavet.\r\n\r\nEnfin, avec T*ActiLE (Technology and Action-led Experience in today\u2019s music performance), Giusy Caruso et Umut Eldem inscrivent cette fois l\u2019exp\u00e9rimentation pianistique au c\u0153ur de passerelles, technologiques et num\u00e9riques, avec l\u2019image et l\u2019art de la performance.","performers":"14h - Claudine Simon & Vivien Trelcat - Labo Pianomachine\r\n15h30 - Giusy Caruso - T*ActiLE Technology and Action-led Experience in today's music performance\r\n17h - Martin Loridan : P\u00e9dale \u00e9tendue : repenser l'intra-piano","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.545168"},"nl":{"name":"Ars Musica - De piano ontrafeld: concerten en conferenties","shortdescr":"De piano beleeft een muzikaal avontuur met drie zeldzame en \u00ab ongehoorde \u00bb concerten en conferenties.","longdescr":"De piano is een instrument van grenzeloze mogelijkheden; van technologische ingrepen tot de piano pr\u00e9par\u00e9, voor hedendaags werk en improvisaties, \u2026 De piano ontrafeld is een dag gewijd aan deze oneindig muzikale avonturen met drie zeldzame en \u201congehoorde\u201d concerten en conferenties.\r\n\r\nTussen nieuwe lutherie (instrumentenbouw) en een organische benadering van het instrument cre\u00eberde het experimentele duo Claudine Simon en Vivien Trelcat het elektronisch en akoestisch, transdisciplinair en hybride project Pianomachine.\r\n\r\nIn P\u00e9dale \u00e9tendue: repenser l'intra-piano onderzoekt Martin Loridan, samen met Gian Ponte en het duo Tomoko Honda \/ Sara Picavet, uiterst nauwgezet de techniciteit van het pianospel.\r\n\r\nTenslotte stellen Giusy Caruso en Umut Eldem met T*ActiLE (Technology and Action-led Experience in today's music performance) piano-experimenten centraal ondersteund door beeld- en  performancekunst.","performers":"14u - Claudine Simon & Vivien Trelcat - Labo Pianomachine\r\n15u30 - Giusy Caruso - T*ActiLE Technology and Action-led Experience in today's music performance\r\n17u - Martin Loridan : P\u00e9dale \u00e9tendue : repenser l'intra-piano","boxoffice_url":null,"website":"http:\/\/www.arsmusica.be","email":"info@arsmusica.be","phone_contact":"+32 2 219 26 60","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.545168"},"en":{"name":"Ars Musica - Piano exp\u00e9rimental: concerts et conf\u00e9rences","shortdescr":"Three unique piano concerts and conferences with music, transdisciplinarity, technology and improvisation","longdescr":"Contemporain, d\u2019improvisation, augment\u00e9 de syst\u00e8mes technologiques ou pr\u00e9par\u00e9, le piano est un instrument d\u2019exp\u00e9rimentation sans limites\u2026 L\u2019\u00e9v\u00e8nement Piano exp\u00e9rimental se compose de trois conf\u00e9rences-concerts,consacr\u00e9es \u00e0 l\u2019aventure musicale infinie du piano.\r\n\r\nEntre nouvelle lutherie et approche organique de l\u2019instrument, le duo exp\u00e9rimental que Claudine Simon forme avec Vivien Trelcat d\u00e9veloppe le projet Pianomachine, \u00e9lectronique et acoustique, transdisciplinaire et hybride.\r\n\r\nPour Martin Loridan, la notion de P\u00e9dale \u00e9tendue : repenser l\u2019intra-piano, consiste en l\u2019\u00e9largissement du jeu pianistique depuis une exploration, \u00e9rudite, de la technicit\u00e9 de son orf\u00e8vrerie instrumentale, ce qu\u2019il nous d\u00e9montre en compagnie de Gian Ponte et du duo Tomoko Honda \/ Sara Picavet.\r\n\r\nEnfin, avec T*ActiLE (Technology and Action-led Experience in today\u2019s music performance), Giusy Caruso et Umut Eldem inscrivent cette fois l\u2019exp\u00e9rimentation pianistique au c\u0153ur de passerelles, technologiques et num\u00e9riques, avec l\u2019image et l\u2019art de la performance.","performers":"14h - Claudine Simon & Vivien Trelcat - Labo Pianomachine\r\n15h30 - Giusy Caruso - T*ActiLE Technology and Action-led Experience in today's music performance\r\n17h - Martin Loridan : P\u00e9dale \u00e9tendue : repenser l'intra-piano","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.545168"},"de":{"name":"De piano ontrafeld: concerten en conferenties","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.545168"},"it":{"name":"De piano ontrafeld: concerten en conferenties","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.545168"},"sp":{"name":"De piano ontrafeld: concerten en conferenties","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.545168"},"pt":{"name":"De piano ontrafeld: concerten en conferenties","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.545168"},"cn":{"name":"De piano ontrafeld: concerten en conferenties","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.545168"}},"place":{"id":100473,"translations":{"fr":{"name":"MIM - Mus\u00e9e des instruments de musique (MRAH)","address_street_name":"Rue Montagne de la Cour","address_street_number":"2","address_street_box":null,"email":"info@mim.be","website":"http:\/\/www.mim.be","phone_contact":"+32 2 545 01 30","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Montagne de la Cour, 2","address_line2":"1000 Bruxelles","description_web":"Le monde entier admire la collection du Mus\u00e9e des instruments de musique qui fait partie du groupement des Mus\u00e9es Royaux d\u2019Art et d\u2019Histoire. Ce Mus\u00e9e est camp\u00e9 au c\u0153ur des anciens b\u00e2timents Old England, un des plus beaux b\u00e2timents de style Art Nouveau de Bruxelles, datant de 1899. Ce mus\u00e9e est l\u2019un des plus riches au monde : quelques 1.200 instruments y sont expos\u00e9s. D\u2019int\u00e9ressantes animations et de nombreux concerts y sont programm\u00e9s.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"MIM - Muziekinstrumentenmuseum (KMKG)","address_street_name":"Hofberg","address_street_number":"2","address_street_box":null,"email":"info@mim.be","website":"http:\/\/www.mim.be","phone_contact":"+32 2 545 01 30","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Brussel","address_line1":"Hofberg, 2","address_line2":"1000 Brussel","description_web":"Het Muziekinstrumentenmuseum (MIM) bewaart een onschatbare collectie van muzikaal erfgoed en presenteert ze op een schitterende manier. Het MIM beschikt daarvoor over veel troeven. De intu\u00eftieve presentatie is aantrekkelijk en klantvriendelijk. De collectie huist bovendien in een schitterend gerestaureerd Art Nouveau pand. Het MIM presenteert een honderdtal middagconcerten per jaar en biedt een waaier aan groepsactiviteiten.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"MIM - Musical Instruments Museum (MRAH)","address_street_name":"Rue Montagne de la Cour","address_street_number":"2","address_street_box":null,"email":"info@mim.be","website":"http:\/\/www.mim.be","phone_contact":"+32 2 545 01 30","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Brussels","address_line1":"Rue Montagne de la Cour, 2","address_line2":"1000 Brussels","description_web":"As soon as it opened at the end of the 19th century, the luxurious Old England department store earned an excellent reputation for its highly distinctive building. The entrance to the building is a jewel of the Art Nouveau style, while the rest is in perfect harmony with the neoclassical ensemble on the Place Royale, and just around the corner from the Grand-Place and Central Station, no less! \r\nWith a wealth of some 9.000 instruments, some 1.200 of which are on permanent exhibit, the museum's reputation is mainly built on its extraordinary collections.\r\nOnce inside, you'll embark on a true tour of the musical world. After your visit, the instruments and their history will no longer hold any secrets: from the viola da gamba from the Court of Brussels to the 20th century theremin, and even including the African kora!\r\nThe mim is nothing other than a place to experience music. A visitor's guidance system allows you to explore the thematic tours to the tune of the melodious sound of the instruments presented.\r\nA program packed with concerts, demonstrations and workshops for the young and the not so young makes the mim experience even better.\r\nThe mim has its own concert hall, specialized library, museum shop, workshop for restauration and conservation of musical instruments and is crowned by a restaurant with panoramic view over Brussels.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"MIM - Musikinstrumente-Museum (MRAH)","address_street_name":"Montagne de la Cour","address_street_number":"2","address_street_box":null,"email":"info@mim.be","website":"http:\/\/www.mim.be","phone_contact":"+32 2 545 01 30","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Montagne de la Cour, 2","address_line2":"1000 Bruxelles","description_web":"Das Br\u00fcsseler Musikinstrumente-Museum mit 1200 ausgestellten Musikinstrumenten und vielf\u00e4ltigen Sammlungen (mit insgesamt 8000 Instrumenten!), untergebracht in einem bemerkenswerten Jugendstilgeb\u00e4ude, ist ein Paradies f\u00fcr Musikinteressierte.\r\n\r\nMusikgeschichte und Jugendstilarchitektur: Das Musikinstrumente-Museum befindet sich in den ehemaligen Geb\u00e4uden des \u201eOld England\u201c-Kaufhauses und gilt als eines der herausragenden Beispiele f\u00fcr die Br\u00fcsseler Jugendstilarchitektur.\r\n\r\nMusikalische Welt- und Zeitreise: Auf vier Ebenen pr\u00e4sentiert das Museum Musikinstrumente aus verschiedenen Kulturkreisen und Epochen \u2013 und so begibt sich der Besucher auf eine musikalische Welt- und Zeitreise. Die Ausstellungsgestaltung verkn\u00fcpft gekonnt klangliche und visuelle Dimensionen.\r\n\r\nKulinarischer H\u00f6hepunkt, im wahrsten Sinne des Wortes, ist das Restaurant im 6. Stock mit Dachterrasse.\r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Museo degli Strumenti Musicali","address_street_name":"Rue Montagne de la Cour","address_street_number":"2","address_street_box":null,"email":"info@mim.be","website":"http:\/\/www.mim.be","phone_contact":"+32 2 545 01 30","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Montagne de la Cour, 2","address_line2":"1000 Bruxelles","description_web":"Il MIM presenta una collezione di strumenti musicali di fama internazionale e une larga gamma di attivit\u00e0 in collegamento con questa collezione a un pubblico largo e...\r\n\r\nIl MIM presenta una collezione di strumenti musicali di fama internazionale e une larga gamma di attivit\u00e0 in collegamento con questa collezione a un pubblico largo e diversificato dal Belgio e dall'estero. Presenta un'ampio panorama della musica antica, moderna, popolare e tradizionale.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"El MIM, Museo de Instrumentos de M\u00fasica","address_street_name":"Rue Montagne de la Cour","address_street_number":"2","address_street_box":null,"email":"info@mim.be","website":"http:\/\/www.mim.be","phone_contact":"+32 2 545 01 30","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Montagne de la Cour, 2","address_line2":"1000 Bruxelles","description_web":"El Museo MIM te invita a contemplar y escuchar 1.200 instrumentos de m\u00fasica en un edificio Art Nouveau de Bruselas. \r\n\r\nEl Museo de Instrumentos de M\u00fasica, que forma parte de los Museos Reales de Arte e Historia, abre sus puertas en las proximidades de la Place Royale, en el Mont des Arts, el barrio de los museos de Bruselas. \r\n\r\nEl MIM se encuentra en los antiguos almacenes de Art Nouveau, Old England, un aut\u00e9ntico tesoro arquitect\u00f3nico de finales del s. XIX.\r\n\r\nEl MIM debe su reputaci\u00f3n, sobre todo, a sus extraordinarias colecciones. Ven a dar la vuelta al mundo musical a trav\u00e9s de sus 1.200 piezas distribuidas por las 4 plantas de la exposici\u00f3n.\r\n\r\n\r\nComo es de suponer, el MIM es el lugar ideal para disfrutar de la m\u00fasica. Un sistema de cascos con infrarrojos permite explorar los recorridos tem\u00e1ticos al tiempo que se escucha el sonido melodioso de los instrumentos que se presentan.\r\n   \r\nEl MIM tambi\u00e9n es\u2026\r\n\r\n- Una sala de conciertos\r\n- Un espacio para talleres\r\n- Un Museumshop\r\n- Una biblioteca especializada\r\n- Y un restaurante con terraza, con unas vistas \u00fanicas al centro hist\u00f3rico de la capital europea\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"MIM - Museu dos Instrumentos Musicais","address_street_name":"Rue Montagne de la Cour","address_street_number":"2","address_street_box":null,"email":"info@mim.be","website":"http:\/\/www.mim.be","phone_contact":"+32 2 545 01 30","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Montagne de la Cour, 2","address_line2":"1000 Bruxelles","description_web":"Todo o mundo admira a cole\u00e7\u00e3o do Museu dos Instrumentos Musicais, que pertence ao conjunto dos Museus Reais de Arte e da Hist\u00f3ria. Este museu assenta no cora\u00e7\u00e3o dos velhos edif\u00edcios Old England, um dos edif\u00edcios mais belos de estilo Art Nouveau de Bruxelas, datando de 1899. Este museu \u00e9 um dos mais ricos do mundo: cerca de 1200 instrumentos encontram-se a\u00ed expostos. Consta da programa\u00e7\u00e3o de interessantes anima\u00e7\u00f5es e in\u00fameros concertos.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"MIM - Mus\u00e9e des instruments de musique (MRAH)","address_street_name":"Rue Montagne de la Cour","address_street_number":"2","address_street_box":null,"email":"info@mim.be","website":"http:\/\/www.mim.be","phone_contact":"+32 2 545 01 30","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Montagne de la Cour, 2","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[16],"translations":{"fr":["Quartier Royal"],"nl":["Koninklijke wijk"],"en":["Royal"]}},"zones":{"list":[19],"translations":{"fr":["Centre"],"nl":["Centrum"],"en":["Centre"]}},"neca":null,"facebook_id":null,"backoffice_id":359,"location":{"lat":50.84274286,"lon":4.35903823},"region":"brussels","last_updated_at":"2022-11-09T14:35:10+01:00","published_at":"2013-10-19T01:13:28+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":262346,"translations":{"fr":{"name":"Ars Musica","address_street_name"