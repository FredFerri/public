right":null},"it":{"title":"Muntpunt Schaakclub","copyright":null},"sp":{"title":"Muntpunt Schaakclub","copyright":null},"pt":{"title":"Muntpunt Schaakclub","copyright":null},"cn":{"title":"Muntpunt Schaakclub","copyright":null}}}],"dates":[{"day":"2023-03-29","doors":null,"start":"17:00:00","end":"19:00:00","is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"},"de":{"name":"Normal"},"it":{"name":"Normale"},"sp":{"name":"Normal"},"pt":{"name":"Normal"},"cn":{"name":"Normal"}},"value":0}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-02-27T19:05:09+01:00","published_at":"2023-02-17T18:00:20+01:00","backoffice_id":271987,"import_origin":"muntpunt","sub_type":"other","show_in_agenda":true,"ranking":1},{"id":553626,"date_start":"2023-03-29","date_end":"2023-03-29","date_next":"2023-03-29","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater","it":"Teatro","sp":"Teatro","pt":null,"cn":null}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"],"de":["Theater"],"it":["Teatro"],"sp":["Teatro"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"\"Les variations silencieuses\"  de la Cie oh mon amour","shortdescr":"\u00ab Les Variations Silencieuses \u00bb, un spectacle kal\u00e9idoscopique et document\u00e9 sur l\u2019intersexuation et l\u2019autod\u00e9termination.","longdescr":"Une famille normale. Ou disons plut\u00f4t dans la norme. En apparence en tous cas. C\u2019est le jour o\u00f9 Ga\u00eblle f\u00eate ses douze ans. Ses parents, Xavier et Yvette, ont convi\u00e9 ce qui leur reste de famille (une s\u0153ur pansexuelle et militante LGBTQIA+, un oncle \u00e9rudit et alcoolique, un fr\u00e8re macho et r\u00e9actionnaire, une s\u0153ur bigote et botaniste) pour ce qu\u2019ils croient \u00eatre une f\u00eate d\u2019anniversaire. Mais ce qu\u2019ont pr\u00e9par\u00e9 les parents de Ga\u00eblle se r\u00e9v\u00e8le tout autre. Il va falloir que tout le monde s\u2019accroche \u00e0 sa chaise car rien ne sera plus jamais comme avant. Les r\u00e9v\u00e9lations fusent, les masques tombent, les vernis s\u2019\u00e9caillent. Et \u00e0 chacun.e, il sera demand\u00e9, au final, de trancher (c\u2019est le cas de le dire) dans le vif du sujet. \u00ab Les Variations Silencieuses \u00bb, un spectacle kal\u00e9idoscopique et document\u00e9 sur l\u2019intersexuation et l\u2019autod\u00e9termination. Soyeux et incisif, tendre et muscl\u00e9, couillu et ovarien, il d\u00e9genre nos pr\u00e9jug\u00e9s \u00e0 coups d\u2019id\u00e9es re\u00e7ues (mais pas que) et d\u00e9gomme nos id\u00e9es re\u00e7ues \u00e0 coups de pr\u00e9jug\u00e9s (mais pas que).\r\n\r\nApr\u00e8s les 70 minutes de spectacle, la soir\u00e9e se cl\u00f4turera par un moment d\u2019\u00e9change et de parole avec l\u2019ASBL Genre pluriel.\r\n\r\n\r\nR\u00e9servation indispensable\u00a0:\r\n\r\n\u00c0 l'Accueil de l'Espace Car\u00eame, 1-7 rue du Chapelain pendant les heures d'ouverture\r\n\r\nT\u00e9l.\u00a0: 02\/526.83.30 et 02\/526.83.40\r\n\r\nMail\u00a0:  emca.reservations@anderlecht.brussels\r\n\r\n\r\nA l\u2019initiative de Fabrice Cumps, Bourgmestre et \u00e9chevin de la culture, \u00e0 l\u2019initiative de J\u00e9r\u00e9mie Drouart, \u00c9chevin de l\u2019\u00c9galit\u00e9 des Chances et avec le soutien du Coll\u00e8ge Echevinal d\u2019Anderlecht, de la F\u00e9d\u00e9ration Wallonie-Bruxelles \u2014Direction G\u00e9n\u00e9rale de la Culture- Service G\u00e9n\u00e9ral des Lettres et du Livre et de la Commission Communautaire Fran\u00e7aise de la R\u00e9gion de Bruxelles-Capitale. E.R. : Marcel Vermeulen","performers":"La Cia Ah mon amour\r\nL'ASBL Genre pluriel","boxoffice_url":null,"website":"https:\/\/www.emca.be\/iamproud","email":"emca.reservations@anderlecht.brussels","phone_contact":"+32 2 526 83 30","phone_booking":"+32 2 526 83 30","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.553626"},"nl":{"name":"\"Les variations silencieuses\"  de la Cie oh mon amour","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.emca.be\/iamproud","email":"emca.reservations@anderlecht.brussels","phone_contact":"+32 2 526 83 40","phone_booking":"+32 2 526 83 40","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.553626"},"en":{"name":"\"Les variations silencieuses\"  de la Cie oh mon amour","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.emca.be\/iamproud","email":"emca.reservations@anderlecht.brussels","phone_contact":"+32 2 526 83 30","phone_booking":"+32 2 526 83 30","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.553626"},"de":{"name":"Spectacle \"Les variations silencieuses\"  de la Cie oh mon amour","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.emca.be\/iamproud","email":"emca.reservations@anderlecht.brussels","phone_contact":"+32 2 526 83 30","phone_booking":"+32 2 526 83 30","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.553626"},"it":{"name":"Spectacle \"Les variations silencieuses\"  de la Cie oh mon amour","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.emca.be\/iamproud","email":"emca.reservations@anderlecht.brussels","phone_contact":"+32 2 526 83 30","phone_booking":"+32 2 526 83 30","agenda_url"