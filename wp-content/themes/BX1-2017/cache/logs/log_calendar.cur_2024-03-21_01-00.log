al_targets":{"list":[],"translations":{}},"tags":[]},{"id":50006111,"date_start":"2024-03-21","date_end":"2024-03-24","date_next":"2024-03-24","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-03-08T14:45:05+01:00","published_at":"2024-01-18T10:52:10+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":292495,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"festival","ranking":1.2599210498948732,"languages":{"spoken":["en","fr","nl"],"subtitles":[]},"categories":{"main":{"id":118,"translations":{"de":"Festival","pt":null,"en":"Festival","it":"Festival","cn":null,"fr":"Festival","sp":"Festival","nl":"Festival"}},"others":{}},"translations":{"de":{"name":"Invisible Festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/xr4heritage.com\/les-evenements-avatars-invisibles-festival\/","email":"g.bueken@gmail.com","phone_contact":"+32 485 87 04 32","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50006111"},"pt":{"name":"Invisible Festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/xr4heritage.com\/les-evenements-avatars-invisibles-festival\/","email":"g.bueken@gmail.com","phone_contact":"+32 485 87 04 32","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50006111"},"en":{"name":"Invisible Festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/xr4heritage.com\/les-evenements-avatars-invisibles-festival\/","email":"g.bueken@gmail.com","phone_contact":"+32 485 87 04 32","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50006111"},"it":{"name":"Invisible Festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/xr4heritage.com\/les-evenements-avatars-invisibles-festival\/","email":"g.bueken@gmail.com","phone_contact":"+32 485 87 04 32","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50006111"},"cn":{"name":"Invisible Festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/xr4heritage.com\/les-evenements-avatars-invisibles-festival\/","email":"g.bueken@gmail.com","phone_contact":"+32 485 87 04 32","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50006111"},"fr":{"name":"Invisible Festival","shortdescr":"Le 1er festival d\u2019art augment\u00e9 au coeur de l\u2019Europe qui met en lumi\u00e8re les Invisibles de l\u2019Histoire \u00e0 travers un riche programme d\u2019activit\u00e9s autour des avatars 3D et autres exp\u00e9riences artistiques immersives. \u00c0 la crois\u00e9e entre innovation sociale et innovation technologique, le INVISIBLE festival vous invite \u00e0 c\u00e9l\u00e9brer la richesse et la diversit\u00e9 culturelle au coeur de l'Europe - \u00e0 Bruxelles.","longdescr":"XR4Heritage, l\u2019activit\u00e9 immersive de l\u2019ASBL 3 Plumes est heureuse de vous pr\u00e9senter le premier festival d\u2019art augment\u00e9 au c\u0153ur de l\u2019Europe qui met en lumi\u00e8re les Invisibles de l\u2019Histoire \u00e0 travers un riche programme d\u2019activit\u00e9s autour des avatars 3D et autres exp\u00e9riences artistiques immersives. \nINVISIBLE  FESTIVAL se d\u00e9roulera du 21 au 24 mars 2024 \u00e0 Tour&Taxis, en collaboration avec le Printemps Num\u00e9rique, la biennale Women in Art & Stereopsia Europe. \n\n\u00c0 la crois\u00e9e entre innovation sociale et innovation technologique, l\u2019utilisation de la R\u00e9alit\u00e9 Augment\u00e9e, ce nouveau rendez-vous vous invite \u00e0 c\u00e9l\u00e9brer la richesse et la diversit\u00e9 culturelle au c\u0153ur  de l\u2019Europe - \u00e0  Bruxelles, la 2\u00e8me ville la plus cosmopolite au Monde.\nUn parcours de visites \u2013 une exposition en collaboration avec BXL ART NFT pour exp\u00e9rimenter l\u2019art digital en superposition au r\u00e9el - compos\u00e9 d\u2019une vingtaine d\u2019\u0153uvres  num\u00e9riques r\u00e9alis\u00e9es par des artistes belges et internationaux - mais aussi des ateliers de discussion ainsi qu\u2019un Discovery Tour \u00e0 travers la belgique pour rencontrer les innovateurs de la culture \u00ab augment\u00e9e \u00bb.\n\nLe festival INVISIBLE se veut un tremplin pour les ARTIVISTES, c\u2019est-\u00e0-dire les artistes - activistes qui donnent vie ou pr\u00eatent leur voix \u00e0 des AVATARS pour tenter d\u2019impacter positivement sur les mentalit\u00e9s ou les comportements de leurs publics.  \n\nL\u2019\u00e9dition 2024 c\u00e9l\u00e8brera la d\u00e9cennie internationale consacr\u00e9e aux personnes d\u2019ascendance africaine \u00e0 travers la mise en valeur des talents du AFRICA METAVERS MUSEUM et autres artistes autour des th\u00e9matiques du panafricanisme et de l\u2019Afro-futurisme. \n\nINVISIBLE Festival dans Printemps Num\u00e9rique (22 et 23 Mars) s'articulera autour de 4 principales zones d'activit\u00e9s: \n1. La zone HALL OF FAME : Une exp\u00e9rience interactive autour du dialogue Homme-Machine reposant sur des avatars conversationnels et chatbot. Une occasion pour discuter avec des personnages disparus mais aussi pour participer \u00e0 une large consultation citoyenne pour faire \u00e9merger des figures de h\u00e9ros et mod\u00e8les de r\u00e9ussite auxquels la population dans sa richesse et diversit\u00e9 pourra s\u2019identifier. \n2. La zone GAME & VR : une zone avec une s\u00e9lection de contenus culturels et \u00e9ducatifs pour initier au Gaming avec la pr\u00e9sentation du jeu vid\u00e9o d\u00e9di\u00e9 aux personnages historiques Africains avec AFRICA METAVERS, et \u00e0 la R\u00e9alit\u00e9 Virtuelle avec diff\u00e9rentes oeuvres d'artistes, accessible gratuitement aux visiteurs du festival.\n3. La zone d'Exp\u00e9riences en R\u00e9alit\u00e9 Augment\u00e9e (RA) pour initier \u00e0 la r\u00e9alit\u00e9 augment\u00e9e comme outil de lutte contre le racisme et les discriminations avec une l'exp\u00e9rience pr\u00e9mium NOIRE Noire, la vie m\u00e9connue de Claudette Colvin\u201d r\u00e9alis\u00e9e par St\u00e9phane Foenkinos et Pierre-Alain Giraud d\u2019apr\u00e8s l\u2019ouvrage de Tania de Montaigne. Une production Novaya et Flash Forward Entertainment (Ta\u00efwan) en partenariat avec le Centre Pompidou et lanc\u00e9 pour la 1\u00e8re fois en Belgique au INVISIBLE Festival ; et un circuit de visite d\u2019art augment\u00e9 autour de la gare maritime, co-produit avec la galerie Bxl Art NFT et la solution technologique OVER THE REALITY.\n4. La zone ATELIER : Pour nourrir la r\u00e9flexion autour des enjeux \u00e9thiques, technologiques, juridiques et artistiques, INVISIBLE festival d\u00e9veloppe, en marge de l\u2019Exposition un riche programme de tables rondes, conf\u00e9rences, animation et une s\u00e9ance de Pecha Kucha \u00e0 destination des porteurs de projets innovants. ","performers":null,"boxoffice_url":null,"website":"https:\/\/xr4heritage.com\/les-evenements-avatars-invisibles-festival\/","email":"g.bueken@gmail.com","phone_contact":"+32 485 87 04 32","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50006111"},"sp":{"name":"Invisible Festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/xr4heritage.com\/les-evenements-avatars-invisibles-festival\/","email":"g.bueken@gmail.com","phone_contact":"+32 485 87 04 32","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50006111"},"nl":{"name":"Invisible Festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/xr4heritage.com\/les-evenements-avatars-invisibles-festival\/","email":"g.bueken@gmail.com","phone_contact":"+32 485 87 04 32","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50006111"}},"place":{"id":258279,"translations":{"de":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Rue Picard","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Rue Picard","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Rue Picard","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue Picard","address_line2":"1000 Brussels","description_web":"The Gare Maritime - From industrial freight station to energy neutral urban jungle!\r\n\r\nIt is the perfect setting for innovative cultural events, film or photo shoots, trade shows, fairs, product launches or promotions. \r\nThe historic station concourse that was part of the Gare Maritime has been transformed into an indoor city with its own food hall (coming September 2021), exclusive shops and offices. Countless unique and inspiring areas and warm, wooden structures alternate in this building complex. It is perfectly suited to accommodate both small and major events. The monumental nave is a true architectural eye-catcher, bathed in indirect sunlight and providing ample space for well-attended indoor activities.\r\nAny event in the Gare Maritime is a green event. Sustainability has been key during the renovation works. The building generates its own energy from renewable sources, using geothermics and solar panels. The green boulevards on either side of the nave are lined with themed gardens and tall trees, as if the adjacent park found its way inside. \r\nThe Gare Maritime is a unique place - attractive, innovative and ambitious.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Rue Picard","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Rue Picard","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Rue Picard","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard","address_line2":"1000 Bruxelles","description_web":"La Gare Maritime : l'ancienne gare de fret devenue jungle urbaine, neutre en \u00e9nergie !\r\n\r\nElle offre le cadre id\u00e9al pour les \u00e9v\u00e9nements culturels innovants, les tournages de films ou s\u00e9ances photo, les march\u00e9s et foires, les lancements et promotions de produits. Les halles de la Gare Maritime ont \u00e9t\u00e9 transform\u00e9es en ville int\u00e9rieure. Elle comportera son propre food hall (\u00e0 partir de septembre 2021), des magasins exclusifs et des bureaux. Dans ce complexe, des espaces uniques et inspirants sont entrecoup\u00e9s de structures en bois chaleureuses. Le b\u00e2timent se pr\u00eate \u00e0 l'organisation de rencontres en petit comit\u00e9 ou de grands happenings. La nef monumentale, attrait architectural, est baign\u00e9e de lumi\u00e8re naturelle indirecte et offre suffisamment d'espace pour les activit\u00e9s int\u00e9rieures bien fr\u00e9quent\u00e9es.\r\nTout \u00e9v\u00e8nement dans la Gare Maritime sera un \u00e9v\u00e8nement \u00e9co-responsable. La durabilit\u00e9 \u00e9tait \u00e0 l'avant-plan pendant les r\u00e9novations du b\u00e2timent. L'\u00e9nergie renouvelable est produite sur place, utilisant la g\u00e9othermie et des panneaux photovolta\u00efques. Sur les promenades vertes bordant la nef centrale, des jardins \u00e0 th\u00e8me et des arbres \u00e0 haut tronc ont \u00e9t\u00e9 amen\u00e9s - comme si le parc voisin se faufile dans le b\u00e2timent. \r\nLa Gare Maritime, un lieu unique : attractif, novateur, ambitieux.\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Rue Picard","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Picardstraat","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Picardstraat","address_line2":"1000 Brussel","description_web":"Gare Maritime: van industrieel goederenstation tot energieneutrale urban jungle!\r\n\r\nDe Gare Maritime is de perfecte setting voor innovatieve, culturele evenementen, film- en fotoshoots, markten, beurzen, lanceringen en promoties. De historische stationshallen van de Gare Maritime zijn omgevormd tot overdekte stad, met foodhall (vanaf september 2021), exclusieve winkels en kantoren. Het gebouwencomplex biedt een waaier aan unieke, inspirerende ruimtes afgewisseld met warme houten volumes: perfect voor de organisatie van kleine en grootschalige happenings. D\u00e9 architecturale eyecatcher is de monumentale middenbeuk die baadt in indirect daglicht en over meer dan voldoende ruimte beschikt voor overdekte activiteiten met veel bezoekers.\r\nEen event in de Gare Maritime is een groen event. Tijdens de renovatie van het gebouw was duurzaamheid een speerpunt. Energie wordt ter plaatse hernieuwbaar opgewekt met geothermie en zonnepanelen. De groene wandelboulevards aan weerszijden van de middenbeuk zijn voorzien van thematuinen en hoogstammige bomen, alsof het aangrenzende park het gebouw binnenstroomt. Gare Maritime is een unieke plek: aantrekkelijk, vernieuwend en ambitieus.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[8],"translations":{"de":["Kanal-Viertel"],"pt":[null],"en":["Canal"],"it":["Canal"],"cn":[null],"fr":["Canal"],"sp":["Canal"],"nl":["Kanaalwijk"]}},"zones":{"