sitors\/agenda\/event-detail.50005315"},"en":{"name":"Tirailleurs","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.espacemagh.be\/projects\/tirailleurs\/?pr=18093&gr=1&post=projects&sa=872","email":"reservation@espacemagh.be","phone_contact":"+32 2 274 05 10","phone_booking":"+32 2 274 05 10","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50005315"},"it":{"name":"Tirailleurs","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.espacemagh.be\/projects\/tirailleurs\/?pr=18093&gr=1&post=projects&sa=872","email":"reservation@espacemagh.be","phone_contact":"+32 2 274 05 10","phone_booking":"+32 2 274 05 10","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50005315"},"cn":{"name":"Tirailleurs","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.espacemagh.be\/projects\/tirailleurs\/?pr=18093&gr=1&post=projects&sa=872","email":"reservation@espacemagh.be","phone_contact":"+32 2 274 05 10","phone_booking":"+32 2 274 05 10","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50005315"},"fr":{"name":"Tirailleurs","shortdescr":"Apr\u00e8s sa contribution au succ\u00e8s de la pi\u00e8ce Djihad, Reda Chebchoubi, com\u00e9dien belgo-marocain, aborde \u00e0 nouveau une th\u00e9matique qui lui tient particuli\u00e8rement \u00e0 c\u0153ur : la construction identitaire et se plonge d\u00e9sormais dans l\u2019Histoire universelle. ","longdescr":"Apr\u00e8s sa contribution au succ\u00e8s de la pi\u00e8ce Djihad, Reda Chebchoubi, com\u00e9dien belgo-marocain, aborde \u00e0 nouveau une th\u00e9matique qui lui tient particuli\u00e8rement \u00e0 c\u0153ur : la construction identitaire et se plonge d\u00e9sormais dans l\u2019Histoire universelle. \n\nSon nouveau spectacle, Tirailleurs, explore l\u2019histoire encore m\u00e9connue des tirailleurs africains recrut\u00e9s, dans leur pays d\u2019origine, par l\u2019Arm\u00e9e fran\u00e7aise pendant la guerre. Ces hommes, venus combattre en Europe, y sont rest\u00e9s, y ont fond\u00e9 des familles mais se retrouvent aujourd\u2019hui au ban de la soci\u00e9t\u00e9, totalement marginalis\u00e9s.\n\n\u00ab Ce sont des oubli\u00e9s de l\u2019histoire. Mon spectacle sera avant tout un devoir de m\u00e9moire. Il s\u2019appellera \u00ab Tirailleurs \u00bb et se pr\u00e9sentera sous forme de dialogue entre deux amis de longue date qui se rem\u00e9morent la guerre qu\u2019ils ont v\u00e9cue ensemble. Assis sur un banc, l\u2019un \u00e0 c\u00f4t\u00e9 de l\u2019autre, ils racontent l\u2019histoire de leur vie, de celle de milliers de marocains venus en Europe pour combattre sur les fronts. Bien que cette guerre n\u2019\u00e9tait pas la leur au d\u00e9part, elle l\u2019est devenue. Aujourd\u2019hui, et malgr\u00e9 cette marginalisation, \u00ab ils n\u2019en veulent pas \u00e0 la France ou \u00e0 la Belgique. C\u2019est une acceptation de son destin\u2026 peut-\u00eatre une r\u00e9signation ? J\u2019ai voulu montrer que nos grands-p\u00e8res avaient une telle foi que la rancune n\u2019\u00e9tait pas au rendez-vous, simplement la r\u00e9conciliation \u00bb (Reda Chebchoubi).\n\nIls ont acquis le statut de \u00ab fils de la France \u00bb, non pas par la filiation, mais par le sacrifice de leur propre sang. \u00ab Ne vous contentez pas de vivre ensemble, mais \u0153uvrez \u00e0 b\u00e2tir un monde meilleur ensemble ! \u00bb nous confiait Mohamed Mechti (ancien combattant marocain engag\u00e9 \u00e0 18 ans dans l\u2019arm\u00e9e fran\u00e7aise et d\u00e9c\u00e9d\u00e9 en 2010). Cette histoire s\u2019inspire de la sienne et de celle d\u2019autres h\u00e9ros africains tomb\u00e9s au champ d\u2019honneur pour la libert\u00e9. C\u2019est ind\u00e9niablement un superbe hymne \u00e0 la paix.","performers":"Mise en sc\u00e8ne et texte: Reda Chebchoubi l Casting : Samir Kadi, Shark Carrera, Reda Chebchoubi l Guest : Adnane Faraj l Regisseur : Hassan Guenam l R\u00e9gie plateau : Yasmine Chebchoubi","boxoffice_url":null,"website":"https:\/\/www.espacemagh.be\/projects\/tirailleurs\/?pr=18093&gr=1&post=projects&sa=872","email":"reservation@espacemagh.be","phone_contact":"+32 2 274 05 10","phone_booking":"+32 2 274 05 10","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50005315"},"sp":{"name":"Tirailleurs","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.espacemagh.be\/projects\/tirailleurs\/?pr=18093&gr=1&post=projects&sa=872","email":"reservation@espacemagh.be","phone_contact":"+32 2 274 05 10","phone_booking":"+32 2 274 05 10","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50005315"},"nl":{"name":"Tirailleurs","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.espacemagh.be\/projects\/tirailleurs\/?pr=18093&gr=1&post=projects&sa=872","email":"reservation@espacemagh.be","phone_contact":"+32 2 274 05 10","phone_booking":"+32 2 274 05 10","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50005315"}},"place":{"id":247296,"translations":{"de":{"name":"Centre culturel Espace Magh asbl","address_street_name":"Rue du Poin\u00e7on","address_street_number":null,"address_street_box":null,"email":"info@espacemagh.be","website":"http:\/\/www.espacemagh.be","phone_contact":"+32 2 274 05 10","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Poin\u00e7on","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Centre culturel Espace Magh asbl","address_street_name":"Rue du Poin\u00e7on","address_street_number":null,"address_street_box":null,"email":"info@espacemagh.be","website":"http:\/\/www.espacemagh.be","phone_contact":"+32 2 274 05 10","phone_booking":null,"address_zip":"