r\n\r\nSpectacle tout public des Y\u00e9tis-Garous\r\n\r\n\r\n\r\n-------\r\n\r\nINFOS PRATIQUES\r\n\r\nLieu : Le TRAC\r\nAdresse : 110, rue Albert Meunier- Auderghem\r\n\r\nSpectacle \u00e0 20h15\r\nIl est possible de manger et\/ou boire un verre sur place avant le spectacle, pensez donc \u00e0 venir plus t\u00f4t! (Derni\u00e8re commande de restauration \u00e0 19h55!)\r\n\r\nR\u00c9SERVATIONS (Vivement conseill\u00e9es)\r\nvia le lien du Trac : https:\/\/www.letrac.be\/reservations\r\n\r\nTARIFS\r\nSur r\u00e9servation : 10\u20ac\/\u00e9tudiant & 13\u20ac\/adulte\r\nSur place : 15\u20ac\/personne","performers":"L'\u00e9quipe des Y\u00e9tis-Garous","boxoffice_url":null,"website":"http:\/\/www.letrac.be\/reservation","email":"info@letrac.be","phone_contact":"+32 470 50 04 75","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.540491"},"nl":{"name":"MALEDICTION - Spectacle d'improvisation des Y\u00e9tis-Garous","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.letrac.be\/reservation","email":"info@letrac.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.540491"},"en":{"name":"MALEDICTION - Spectacle d'improvisation des Y\u00e9tis-Garous","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.letrac.be\/reservation","email":"info@letrac.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.540491"},"de":{"name":"MALEDICTION - Spectacle d'improvisation des Y\u00e9tis-Garous","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.letrac.be\/reservation","email":"info@letrac.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.540491"},"it":{"name":"MALEDICTION - Spectacle d'improvisation des 