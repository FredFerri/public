e1":"Rue Lebeau, 39","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":null,"facebook_id":null,"backoffice_id":39466,"location":{"lat":50.84249155,"lon":4.35398831},"region":"brussels","last_updated_at":"2022-11-14T09:05:18+01:00","published_at":"2022-10-05T19:00:09+02:00","import_origin":null,"external_id":null,"is_in_address_book":false,"is_in_vb_export":false,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/7dd2a4bd50a0b0738b48881a4d2a08c92b568b87.png","width":750,"height":750,"ratio":1,"translations":{"fr":{"title":"Le Quatuor Alfama joue \"La jeune fille et la Mort\" de Franz Schubert","copyright":null},"nl":{"title":"Le Quatuor Alfama joue \"La jeune fille et la Mort\" de Franz Schubert","copyright":null},"en":{"title":"Le Quatuor Alfama joue \"La jeune fille et la Mort\" de Franz Schubert","copyright":null}}}],"dates":[{"day":"2022-11-24","doors":"12:00:00","start":"12:30:00","end":null,"is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":12},{"translations":{"fr":{"name":"Etudiants"},"nl":{"name":"Studenten"},"en":{"name":"Students"}},"value":6},{"translations":{"fr":{"name":"Enfants"},"nl":{"name":"Kinderen"},"en":{"name":"Children"}},"value":0}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":{"list":[252,256,257,259,261,263,265],"translations":{"fr":["Accessible aux personnes ayant des difficult\u00e9s de compr\u00e9hension","Am\u00e9nagements pour les personnes aveugles et malvoyantes","Am\u00e9nagements pour personnes sourdes et malentendantes","Chien d'assistance","Parking accessible","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9"],"nl":["Toegankelijk voor mensen met een verstandelijke beperking","Voorzieningen voor blinde en slechtziende personen","Voorzieningen voor dove en slechthorende personen","Assistentiehonden","Toegankelijke parking","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet"],"en":["Accessible to people with intellectual disabilities","Facilities for blind and partially-sighted persons","Facilities for deaf and hearing-impaired people","Assistance dogs","Accessible parking","Accessible to pedestrians with mobility aids","Adapted toilet"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-11-14T09:05:19+01:00","published_at":"2022-11-14T08:44:02+01:00","backoffice_id":265529,"import_origin":null,"sub_type":"concert","show_in_agenda":true,"ranking":1.2599210498949},{"id":544329,"date_start":"2022-11-24","date_end":"2022-11-24","date_next":"2022-11-24","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert","de":"Konzert"}},"others":{"list":[4,10],"translations":{"fr":["Pop, rock, jazz\u2026","Jazz & Blues"],"nl":["Pop, rock, jazz\u2026","Jazz & Blues"],"en":["Pop, rock, jazz\u2026","Jazz & Blues"],"de":["Pop, Rock, Jazz...","Jazz & Blues"]}}},"languages":{"spoken":["fr","pt"],"subtitles":[]},"translations":{"fr":{"name":"Didier Sustrac Roberto Di Fernandino : \u00ab Bossa Sarav\u00e1 \u00bb","shortdescr":"Ce  jeudi 24 Novembre \u00e0 20 heures, Didier Sustrac et Roberto DI FERNANDINO l\u00e8veront le voile sur le tout nouvelle album  \u00ab BOSSA SARAV\u00c1 \u00bb","longdescr":"Si c\u2019est toujours un d\u00e9fi que de reprendre des standards, \u00e0 la premi\u00e8re \u00e9coute de ce nouvel opus, il se d\u00e9gage un plaisir singulier et l\u2019on se laisse aller sur des sentiers lents et paresseux \u00e0 red\u00e9couvrir les m\u00e9lodies, comme si l\u2019on respirait \u00e0 pleins poumons sur une plage de Rio de Janeiro.\r\nLe chant de Didier Sustrac, glisse doucement sur les harmonies, les dissonances et se confond avec la guitare de Di Ferdinando ronde, \u00e9lectrique, qui rebondit en \u00e9cho, et joue autour de la m\u00e9lodie sans jamais la d\u00e9voiler totalement.\r\nLa douceur solaire de la bossa nova se m\u00e9lange aux nuits bleut\u00e9es des guitares jazz, Rio descend dans les caves new yorkaises et laisse un peu de sable dans les rues de minuit\u2026","performers":"Didier Sustrac, voix, guitare\r\nRoberto Di Fernandino, guitare \u00e9l\u00e9ctrique","boxoffice_url":null,"website":"https:\/\/www.lebaixu.be","email":"info@lebaixu.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.544329"},"nl":{"name":"Didier Sustrac Roberto Di Fernandino : \u00ab Bossa Sarav\u00e1 \u00bb","shortdescr":"Deze donderdag 24 november om 20.00 uur zullen Didier Sustrac en Roberto DI FERNANDINO hun gloednieuwe album \"BOSSA SARAV\u00c1\" presenteren.","longdescr":"Het is altijd een uitdaging om standaarden te coveren, maar bij de eerste beluistering van dit nieuwe opus, ontstaat een bijzonder genoegen en laat men zich op langzame en luie wegen gaan om de melodie\u00ebn te herontdekken, alsof men op een strand in Rio de Janeiro wandelt.\r\nDe zang van Didier Sustrac glijdt zachtjes over de harmonie\u00ebn en dissonanten en versmelt met de ronde, elektrische gitaar van Di Ferdinando, die in echo's stuitert en rond de melodie speelt zonder deze ooit volledig prijs te geven.\r\nDe zonnige zachtheid van bossa nova vermengt zich met de blauwige nachten van jazzgitaren, Rio daalt af in de kelders van New York en laat een beetje zand achter in de middernachtelijke straten...","performers":"Didier Sustrac, stem, gitaar\r\nRoberto Di Fernandino, elektrische gitaar","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.544329"},"en":{"name":"Didier Sustrac Roberto Di Fernandino : \u00ab Bossa Sarav\u00e1 \u00bb","shortdescr":"This Thursday, November 24th at 8 pm, Didier Sustrac and Roberto DI FERNANDINO will present their brand new album \"BOSSA SARAV\u00c1\".","longdescr":"It's always a challenge to cover standards, but at the first listening of this new opus, a singular pleasure emerges and we let ourselves go on slow and lazy paths to rediscover the melodies, as if we were breathing infinitely on a beach in Rio de Janeiro.\r\nDidier Sustrac's singing, glides gently over the harmonies, the dissonances and merges with Di Ferdinando's round, electric guitar, which bounces in echo, and plays around the melody without ever revealing it completely.\r\nThe solar sweetness of bossa nova mixes with the blue nights of jazz guitars, Rio goes down into the New York cellars and leaves a little sand in the midnight streets...","performers":"Didier Sustrac, voice, guitar\r\nRoberto Di Fernandino, electric guitar","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.544329"},"de":{"name":"Didier Sustrac Roberto Di Fernandino : \u00ab Bossa Sarav\u00e1 \u00bb","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.544329"},"it":{"name":"Didier Sustrac Roberto Di Fernandino : \u00ab Bossa Sarav\u00e1 \u00bb","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.544329"},"sp":{"name":"Didier Sustrac Roberto Di Fernandino : \u00ab Bossa Sarav\u00e1 \u00bb","shortdescr":null,"longdescr":null,"perfor