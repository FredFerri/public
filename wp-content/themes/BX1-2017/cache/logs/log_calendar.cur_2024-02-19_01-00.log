cription_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Divers lieux \u00e0 Bruxelles","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Divers lieux \u00e0 Bruxelles","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Verschillende locaties in Brussel","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Verschillende locaties in Brussel","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[13],"translations":{"de":["Historisches Stadtzentrum"],"pt":[null],"en":["Historical Centre"],"it":["Centro storico"],"cn":[null],"fr":["Centre historique"],"sp":["Centro hist\u00f3rico"],"nl":["Historisch centrum"]}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":null,"facebook_id":null,"backoffice_id":7718,"location":{"lat":50.84757712,"lon":4.35053903},"region":"brussels","last_updated_at":"2022-10-13T04:20:03+02:00","published_at":"2013-10-19T01:22:45+02:00","import_origin":null,"external_id":null,"is_in_address_book":false,"is_in_vb_export":false,"resto_ranking":0},"organizer":{"id":257183,"translations":{"de":{"name":"Hangar \u2014 Art Center","address_street_name":"Place du Ch\u00e2telain","address_street_number":"18","address_street_box":null,"email":"contact@hangar.art","website":"http:\/\/www.hangar.art","phone_contact":"+32 2 538 00 85","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Place du Ch\u00e2telain, 18","address_line2":"1050 Ixelles","description_web":"Das Hangar ist ein Kunstzentrum f\u00fcr Fotografie, das f\u00fcr alle Formen und Str\u00f6mungen der zeitgen\u00f6ssischen Fotografie offen ist. Dabei sind den Genres und den Herangehensweisen des Mediums keine Grenzen gesetzt. Nur der K\u00fcnstler, die Aussage \u00fcber seine Zeit und das szenografische Erlebnis f\u00fcr den Betrachter z\u00e4hlen.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Hangar \u2014 Art Center","address_street_name":"Place du Ch\u00e2telain","address_street_number":"18","address_street_box":null,"email":"contact@hangar.art","website":"http:\/\/www.hangar.art","phone_contact":"+32 2 538 00 85","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Place du Ch\u00e2telain, 18","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Hangar","address_street_name":"Place du Ch\u00e2telain","address_street_number":"18","address_street_box":null,"email":"contact@hangar.art","website":"http:\/\/www.hangar.art","phone_contact":"+32 2 538 00 85","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Place du Ch\u00e2telain, 18","address_line2":"1050 Ixelles","description_web":"Hangar is the photo art center of Brussels. \r\nHangar organizes 3-4 large exhibitions per year among which a major annual event: PhotoBrussels Festival. Hangar is dedicated to all forms and sensitivities of contemporary photography. No restrictions as to genres, territories, or modes of operation. The only thing that counts is the artist, what they have to say about our time, and the scenographic experience they offer to the visitor. Hangar focuses on emotion as much as on the understanding of the medium. The exhibitions also serve as a theatre for conferences, workshops, performances, and meetings. Hangar is also a publisher of photography books and a bookshop offering a selection of novelties as well as the sale of limited editions. Created by a passionate Belgian art collector, Hangar is located in the heart of the Ch\u00e2telain neighborhood in Brussels and spread on more than 1000m2.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Hangar \u2014 Art Center","address_street_name":"Place du Ch\u00e2telain","address_street_number":"18","address_street_box":null,"email":"contact@hangar.art","website":"http:\/\/www.hangar.art","phone_contact":"+32 2 538 00 85","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Place du Ch\u00e2telain, 18","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Hangar \u2014 Art Center","address_street_name":"Place du Ch\u00e2telain","address_street_number":"18","address_street_box":null,"email":"contact@hangar.art","website":"http:\/\/www.hangar.art","phone_contact":"+32 2 538 00 85","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Place du Ch\u00e2telain, 18","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Hangar","address_street_name":"Place du Ch\u00e2telain","address_street_number":"18","address_street_box":null,"email":"contact@hangar.art","website":"http:\/\/www.hangar.art","phone_contact":"+32 2 538 00 85","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Place du Ch\u00e2telain, 18","address_line2":"1050 Ixelles","description_web":"Centre d\u2019art d\u00e9di\u00e9 \u00e0 la photographie, hangar se donne pour mission l\u2019ouverture \u00e0 toutes les formes et sensibilit\u00e9s de la photographie contemporaine. Pas de restriction de genres, ni de territoires, ni de modes op\u00e9ratoires du medium. Seuls comptent l\u2019artiste, ce qu\u2019il \u00e0 a dire sur son \u00e9poque par le biais de la photographie et l\u2019exp\u00e9rience sc\u00e9nographique qu\u2019il offre au visiteur.\r\n\r\nHangar soutient la jeune cr\u00e9ation photographique \u00e0 travers des partenariats avec des \u00e9coles d\u2019art et de photographie, une attention et un soutien particuliers aux jeunes talents et \r\nl\u2019organisation de concours comme le PBF Prize lors du PhotoBrussels Festival. \r\n\r\nLe rythme de 8 \u00e0 10 expositions par an est maintenu et permettra aux visiteurs de d\u00e9couvrir une large s\u00e9lection d\u2019artistes photographes. Place \u00e0 la m\u00e9diation et \u00e0 l\u2019ouverture \u00e0 tous les publics, avec un programme de conf\u00e9rences, workshops et diverses animations autour de la photo. L\u2019activit\u00e9 commerciale (vente de tirages, de livres photos, d\u2019\u00e9ditions limit\u00e9es\u2026) est abrit\u00e9e dans un nouveau bookshop et dans une nouvelle entit\u00e9 Photo Art Center galerie (PAC galerie).\r\nHangar est un centre d\u2019art priv\u00e9 belge fond\u00e9 en 2014 par Rodolphe de Spoelberch et dirig\u00e9 par Delphine Dumont depuis juillet 2017. Sur plus de 1000 m2, il est constitu\u00e9 de deux espaces d\u2019exposition (mainspace et frontspace), d\u2019un bookshop d\u00e9di\u00e9 \u00e0 la photographie et du restaurant Campo, qui jouxte le hangar.\r\n","description_print":null,"booking_url":null,"sort_order":"hangar","virtual_visit":null,"visit_url":null},"sp":{"name":"Hangar \u2014 Art Center","address_street_name":"Place du Ch\u00e2telain","address_street_number":"18","address_street_box":null,"email":"contact@hangar.art","website":"http:\/\/www.hangar.art","phone_contact":"+32 2 538 00 85","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Place du Ch\u00e2telain, 18","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Hangar","address_street_name":"Kasteleinsplein","address_street_number":"18","address_street_box":null,"email":"contact@hangar.art","website":"http:\/\/www.hangar.art","phone_contact":"+32 2 538 00 85","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Kasteleinsplein, 18","address_line2":"1050 Ixelles","description_web":"Photo Art Center Hangar presenteert een gecureerde selectie van bekende internationale kunstenaars en veelbelovend jong talent in samenwerking met het kunst-en fotografie-onderwijs. Hangar draagt zo bij tot een grotere waardering voor fotografie in Brussel. Elk jaar vinden in Hangar 8 \u00e0 10 tentoonstellingen plaats, waaronder het PhotoBrussels Festival. In het kader van deze tentoonstellingen worden vaak ook lezingen, performances en vergaderingen georganiseerd. \r\nHangar werd opgericht door een enthousiaste Belgische kunstverzamelaar. Het kunstencentrum bevindt zich in het hart van de Kasteleinswijk in Brussel en heeft een oppervlakte van meer dan 1000 m\u00b2.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":"art_center","facebook_id":null,"region":"brussels","backoffice_id":17183,"location":{"lat":50.82483298,"lon":4.36016843},"last_updated_at":"2023-01-18T12:23:32+01:00","published_at":"2014-03-14T09:48:11+01:00","is_in_address_book":true,"is_in_vb_export":false,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/a3345862a8df1ec0dec83120056fa151b166f2af.jpg","width":1500,"height":2000,"ratio":0.75,"oEmbed_height":2000,"oEmbed_width":1500,"translations":{"de":{"title":"Embrace red - Brussels African Art Center","cop