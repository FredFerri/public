anslations":{"fr":{"name":"Groupe"},"nl":{"name":"Groep"},"en":{"name":"Group"}},"value":7},{"translations":{"fr":{"name":"Article 27"},"nl":{"name":"Artikel 27"},"en":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[],"targets":{"list":[4,5,11],"translations":{"fr":["Enfants 6-9 ans","Enfants 9-12 ans","Famille"],"nl":["Kinderen 6-9 j.","Kinderen 9-12 j.","Familie"],"en":["Children 6-9 yr.","Children 9-12 yr.","Family"]}},"tags":["kids"],"accessibilities":{"list":[255,263,266],"translations":{"fr":["Accessible","Accessible aux pi\u00e9tons appareill\u00e9s","Brussels Health Safety Label"],"nl":["Toegankelijk","Toegankelijk voor voetgangers met hulpmiddelen","Brussels Health Safety Label"],"en":["Accessible","Accessible to pedestrians with mobility aids","Brussels Health Safety Label"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-10T21:35:22+02:00","published_at":"2022-09-12T16:20:40+02:00","backoffice_id":261610,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":1.2599210498949},{"id":542031,"date_start":"2022-11-23","date_end":"2022-11-23","date_next":"2022-11-23","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater"}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"],"de":["Theater"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Maison Renard","shortdescr":"Pr\u00e9parons nous au pire et esp\u00e9rons le meilleur.","longdescr":"Bertrand en est convaincu : la fin du monde, c\u2019est pour demain. Entre le r\u00e9chauffement climatique, les catastrophes naturelles, la menace nucl\u00e9aire et l\u2019\u00e9puisement des ressources, il ne faudra pas attendre 2050 pour que tout s\u2019effondre.\r\n\r\nHeureusement son entreprise d\u00e9tient LA solution. Ce soir, il vous pr\u00e9sente la B.A.D. (Base autonome durable) du lieu dans lequel vous vous trouvez. La seule alternative pour vous sauver de la catastrophe \u00e0 venir, du moins, si vous en avez les moyens.\r\n\r\nAussi dr\u00f4le que cynique, Maison Renard est un spectacle enti\u00e8rement r\u00e9alis\u00e9 avec des donn\u00e9es issues du monde scientifique. Doit-on vraiment craindre un effondrement de notre civilisation ? Comment vivre en autonomie totale ? Quelles seront les v\u00e9ritables victimes en cas d\u2019effondrement ? Apr\u00e8s ce spectacle, la survie n\u2019aura plus aucun secret pour vous.\r\n\r\nLABEL D\u2019UTILIT\u00c9 PUBLIQUE DE LA COCOF 2020","performers":"Conception et interpr\u00e9tation Alexandre Dewez. Aide \u00e0 l\u2019\u00e9criture Jean-Michel Fr\u00e8re. Assistanat Alexis Spinoy. Sc\u00e9nographie Borus Dambly et Laurent Liber. Aide technique vid\u00e9o Tonin Bruneton. Un projet de ZOE (asbl) en coproduction avec la Compagnie Victor B., le Th\u00e9\u00e2tre de Namur\/Centre Dramatique et La Coop asbl.","boxoffice_url":null,"website":"http:\/\/www.roseraie.org","email":"secretariat@roseraie.org","phone_contact":null,"phone_booking":"+32 2 376 46 45","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.542031"},"nl":{"name":"Maison Renard","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.542031"},"en":{"name":"Maison Renard","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.542031"},"de":{"name":"Maison 