19architecture de l\u2019Entre-deux-guerres introduisit des innovations constructives et d\u00e9coratives.","longdescr":"L\u2019architecture de l\u2019Entre-deux-guerres introduisit des innovations constructives et d\u00e9coratives. D\u00e9pouillement des formes, usage original des possibilit\u00e9s offertes par le b\u00e9ton, pr\u00e9occupations plus fonctionnelles pour les premiers   immeubles \u00e0 appartements\u2026 Ce tour vous emm\u00e8ne \u00e0 la d\u00e9couverte du quartier des \u00e9tangs d\u2019Ixelles, des avenues Moli\u00e8re et Coghen \u00e0 Uccle et de l\u2019Altitude Cent \u00e0 Forest.\u00a0    ","performers":null,"boxoffice_url":"https:\/\/www.visit.brussels\/fr\/visiteurs\/agenda\/event-detail\/book-tickets.Art-deco-et-Modernisme.5700005974","website":"https:\/\/www.provelo.org\/events\/art-deco-et-modernisme-art-deco-and-modernism-5\/","email":"info@provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700005974"},"sp":{"name":"Art d\u00e9co et Modernisme","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/www.visit.brussels\/es\/visitantes\/agenda\/event-detail\/book-tickets.Art-deco-et-Modernisme.5700005974","website":"https:\/\/www.provelo.org\/events\/art-deco-et-modernisme-art-deco-and-modernism-5\/","email":"info@provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700005974"},"nl":{"name":"Art d\u00e9co et Modernisme","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/www.visit.brussels\/nl\/bezoekers\/agenda\/event-detail\/book-tickets.Art-deco-et-Modernisme.5700005974","website":"https:\/\/www.provelo.org\/events\/art-deco-et-modernisme-art-deco-and-modernism-5\/","email":"info@provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700005974"}},"place":{"id":280319,"translations":{"de":{"name":"Pro Velo","address_street_name":"Rue de Dublin","address_street_number":"19","address_street_box":null,"email":"info@provelo.org","website":"http:\/\/www.provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de Dublin, 19","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Pro Velo","address_street_name":"Rue de Dublin","address_street_number":"19","address_street_box":null,"email":"info@provelo.org","website":"http:\/\/www.provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de Dublin, 19","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Pro Velo","address_street_name":"Rue de Dublin","address_street_number":"19","address_street_box":null,"email":"info@provelo.org","website":"http:\/\/www.provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de Dublin, 19","address_line2":"1050 Ixelles","description_web":"Pro Velo can help you make the transition to active mobility and cycling.\nSince 1992, our team has been offering professional support to private individuals, public authorities and businesses in the form of tailor-made services and solutions. Our main aim: to meet your needs and contribute to a better quality of life!\n--\nAll year round, Pro Velo offers guided bike rides on request or on scheduled dates in Brussels and Wallonia. Gastronomy, architecture, history, sustainable development... these are just some of the themes that will enable you to (re)discover your region from a different angle!\nPro Velo promotes quality, local, sustainable and responsible tourism, using the bicycle as a tool for discovery, well-being and sharing. \nFollow our guide with your family, friends, colleagues or on your own!","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Pro Velo","address_street_name":"Rue de Dublin","address_street_number":"19","address_street_box":null,"email":"info@provelo.org","website":"http:\/\/www.provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de Dublin, 19","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Pro Velo","address_street_name":"Rue de Dublin","address_street_number":"19","address_street_box":null,"email":"info@provelo.org","website":"http:\/\/www.provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de Dublin, 19","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Pro Velo","address_street_name":"Rue de Dublin","address_street_number":"19","address_street_box":null,"email":"info@provelo.org","website":"http:\/\/www.provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de Dublin, 19","address_line2":"1050 Ixelles","description_web":"Pro Velo vous accompagne vers une mobilit\u00e9 active et facilite votre transition vers le v\u00e9lo.\nDepuis\u00a01992, notre \u00e9quipe offre un\u00a0soutien professionnel\u00a0aux\u00a0particuliers, aux\u00a0pouvoirs publics\u00a0et aux\u00a0entreprises\u00a0sous forme de\u00a0services\u00a0et de\u00a0solutions \u00ab\u00a0sur mesure\u00a0\u00bb. Notre but principal\u00a0:\u00a0r\u00e9pondre \u00e0 vos besoins et contribuer ainsi \u00e0 une\u00a0meilleure qualit\u00e9 de vie\u00a0!\n--\nToute l\u2019ann\u00e9e, Pro Velo vous propose des balades guid\u00e9es \u00e0 v\u00e9lo sur demande ou \u00e0 des dates programm\u00e9es \u00e0 Bruxelles et en Wallonie. Gastronomie, architecture, histoire, projet durable\u2026 autant de th\u00e9matiques qui vous feront (re)d\u00e9couvrir votre r\u00e9gion sous un autre regard\u00a0!\nPro Velo promeut un tourisme de qualit\u00e9, local, durable et responsable en utilisant le v\u00e9lo comme outil de d\u00e9couverte, de bien-\u00eatre et de partage. \nSuivez notre guide en famille, entre amis, coll\u00e8gues ou en solo\u00a0!","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Pro Velo","address_street_name":"Rue de Dublin","address_street_number":"19","address_street_box":null,"email":"info@provelo.org","website":"http:\/\/www.provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de Dublin, 19","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Pro Velo","address_street_name":"Dublinstraat","address_street_number":"19","address_street_box":null,"email":"info@provelo.org","website":"http:\/\/www.provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"Dublinstraat, 19","address_line2":"1050 Elsene","description_web":"Pro Velo kan je helpen de overstap te maken naar actieve mobiliteit en fietsen.\nSinds 1992 biedt ons team professionele ondersteuning aan particulieren, overheden en bedrijven in de vorm van diensten en oplossingen op maat. Ons hoofddoel: voldoen aan uw behoeften en bijdragen tot een betere levenskwaliteit!\n--\nHet hele jaar door biedt Pro Velo begeleide fietstochten op aanvraag of op geplande data in Brussel en Walloni\u00eb. Gastronomie, architectuur, geschiedenis, duurzame ontwikkeling... dit zijn slechts enkele van de thema's die u in staat zullen stellen om uw regio vanuit een andere invalshoek te (her)ontdekken!\nPro Velo promoot kwaliteitsvol, lokaal, duurzaam en verantwoord toerisme, met de fiets als middel om te ontdekken, te genieten en te delen. \nVolg onze gids met je familie, vrienden, collega's of alleen!","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[4],"translations":{"de":["Matonge\/Saint-Boniface"],"pt":[null],"en":["Matonge\/Saint-Boniface"],"it":["Matonge\/Saint-Boniface"],"cn":[null],"fr":["Matonge\/Saint-Boniface"],"sp":["Matong\u00e9\/Saint-Boniface"],"nl":["Matonge\/Sint-Bonifatius"]}},"zones":{"list":[21],"translations":{"de":["S\u00fcden"],"pt":[null],"en":["South"],"it":["Sud"],"cn":[null],"fr":["Sud"],"sp":["Sur"],"nl":["Zuid"]}},"neca":null,"facebook_id":null,"backoffice_id":40319,"location":{"lat":50.83710821,"lon":4.36720312},"region":"brussels","last_updated_at":"2025-02-20T12:18:15+01:00","published_at":"2023-04-18T08:26:19+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":false,"resto_ranking":0},"organizer":{"id":280319,"translations":{"de":{"name":"Pro Velo","address_street_name":"Rue de Dublin","address_street_number":"19","address_street_box":null,"email":"info@provelo.org","website":"http:\/\/www.provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de Dublin, 19","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Pro Velo","address_street_name":"Rue de Dublin","address_street_number":"19","address_street_box":null,"email":"info@provelo.org","website":"http:\/\/www.provelo.or