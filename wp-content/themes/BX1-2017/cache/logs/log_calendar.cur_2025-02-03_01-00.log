:null,"visit_url":null},"fr":{"name":"Brussels By Foot","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":"info@brusselsbyfoot.com","website":"https:\/\/brusselsbyfoot.be\/sur-les-traces-de-karl-marx\/","phone_contact":"+32 472 39 82 17","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Brussels By Foot","address_line2":"1000 Bruxelles","description_web":"Brussels By Foot est une petite compagnie de visites guid\u00e9es insolites \u00e0 Bruxelles. Ils cr\u00e9ent des parcours th\u00e9matiques pour faire d\u00e9couvrir Bruxelles sous des angles tr\u00e8s particuliers, parfois surprenants...Bruxellois passionn\u00e9s, ils vous emm\u00e8nent dans les rues et ruelles de Bruxelles et vous montrent la ville telle qu'ils la connaissent, telle qu'ils l'aiment.\n\nL\u00e9gendes urbaines, luttes sociales, sc\u00e8ne de crimes, Art Nouveau, ou autres th\u00e8mes, rejoignez-les et d\u00e9couvrez Bruxelles comme vous ne l'avez jamais vue !\n\nLes visites sont accessibles sur inscription via le site internet, mais des visites priv\u00e9es pour des groupes peuvent aussi \u00eatre organis\u00e9es sur demande. Dans ces exp\u00e9riences priv\u00e9es, pourquoi ne pas m\u00ealer la balade \u00e0 une d\u00e9gustation de chocolats, un ap\u00e9ro bien brusseleir, ou \u00e0 un repas dans un \u00e9tablissement authentique de Bruxelles ?","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Brussels By Foot","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":"info@brusselsbyfoot.com","website":"https:\/\/brusselsbyfoot.be\/sur-les-traces-de-karl-marx\/","phone_contact":"+32 472 39 82 17","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Brussels By Foot","address_line2":"1000 Bruxelles","description_web":"Brussels By Foot is a small company offering unusual guided tours of Brussels. They create themed tours to help you discover Brussels from very special, sometimes surprising angles... All passionate Brusseleirs, they take you through the streets and alleys of Brussels and show you the city as they know it, as they love it.\n\nUrban legends, social struggles, crime scenes, Art Nouveau, or other themes, join us and discover Brussels as you've never seen it before!\n\nThe tours are available on registration via the website, but private tours for groups can also be arranged on request. In these private experiences, why not combine the tour with a chocolate tasting, a brusseleir aperitif, or a meal in an authentic Brussels establishment?","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Brussels By Foot","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":"info@brusselsbyfoot.com","website":"https:\/\/brusselsbyfoot.be\/sur-les-traces-de-karl-marx\/","phone_contact":"+32 472 39 82 17","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Brussels By Foot","address_line2":"1000 Brussel","description_web":"Brussels By Foot is een klein bedrijf dat ongewone rondleidingen door Brussel aanbiedt. Ze cre\u00ebren thematische rondleidingen om u Brussel te laten ontdekken vanuit heel bijzondere en soms verrassende invalshoeken... Als gepassioneerde Brusselaars nemen ze je mee door de straten en steegjes van Brussel en tonen ze je de stad zoals zij die kennen, zoals zij ervan houden.\n\nStadslegendes, sociale strubbelingen, misdaadsc\u00e8nes, Art Nouveau of andere thema's, ga met ze mee en ontdek Brussel zoals je het nog nooit hebt gezien!\n\nDe rondleidingen zijn beschikbaar op inschrijving via de website, maar op verzoek kunnen er ook priv\u00e9rondleidingen voor groepen worden geregeld. Als onderdeel van deze priv\u00e9-ervaringen kunt u de rondleiding combineren met een chocoladeproeverij, een goed gebrouwen aperitief of een maaltijd in een authentiek Brussels etablissement.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":41819,"location":{"lat":50.8446735,"lon":4.3500613},"last_updated_at":"2025-01-27T10:36:39+01:00","published_at":"2024-01-20T21:02:59+01:00","is_in_address_book":true,"is_in_vb_export":false,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/a4173a2071c84f79971f63e2b9979c108850bc49.jpg","width":960,"height":710,"ratio":1.35,"oEmbed_height":710,"oEmbed_width":960,"translations":{"de":{"title":"Bruxelles, 1000 Ans de Luttes","copyright":null},"pt":{"title":"Bruxelles, 1000 Ans de Luttes","copyright":null},"en":{"title":"Bruxelles, 1000 Ans de Luttes","copyright":null},"it":{"title":"Bruxelles, 1000 Ans de Luttes","copyright":null},"cn":{"title":"Bruxelles, 1000 Ans de Luttes","copyright":null},"fr":{"title":"Bruxelles, 1000 Ans de Luttes","copyright":null},"sp":{"title":"Bruxelles, 1000 Ans de Luttes","copyright":null},"nl":{"title":"Bruxelles, 1000 Ans de Luttes","copyright":null}}},{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/75a9450d6e104db1d432cbfd77e9f22485ac084d.jpg","width":1080,"height":810,"ratio":1.33,"oEmbed_height":810,"oEmbed_width":1080,"translations":{"de":{"title":"Bruxelles, 1000 Ans de Luttes","copyright":null},"pt":{"title":"Bruxelles, 1000 Ans de Luttes","copyright":null},"en":{"title":"Bruxelles, 1000 Ans de Luttes","copyright":null},"it":{"title":"Bruxelles, 1000 Ans de Luttes","copyright":null},"cn":{"title":"Bruxelles, 1000 Ans de Luttes","copyright":null},"fr":{"title":"Bruxelles, 1000 Ans de Luttes","copyright":null},"sp":{"title":"Bruxelles, 1000 Ans de Luttes","copyright":null},"nl":{"title":"Bruxelles, 1000 Ans de Luttes","copyright":null}}},{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/e34f34d95c8ff46a1e3e4586