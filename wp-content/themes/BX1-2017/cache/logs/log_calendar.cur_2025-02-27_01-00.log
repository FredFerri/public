oking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":32777,"location":{"lat":50.82995922,"lon":4.35926524},"last_updated_at":"2022-10-25T13:07:42+02:00","published_at":"2019-02-19T20:48:23+01:00","is_in_address_book":false,"is_in_vb_export":false,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"poster","link":"https:\/\/agendabrussels2.imgix.net\/f3a0e759fa6481275fa27d16a60f642f5634a8d0.png","width":3508,"height":4961,"ratio":0.71,"oEmbed_height":4961,"oEmbed_width":3508,"translations":{"de":{"title":"House concert 19\/02\/25","copyright":null},"pt":{"title":"House concert 19\/02\/25","copyright":null},"en":{"title":"House concert 19\/02\/25","copyright":null},"it":{"title":"House concert 19\/02\/25","copyright":null},"cn":{"title":"House concert 19\/02\/25","copyright":null},"fr":{"title":"House concert 19\/02\/25","copyright":null},"sp":{"title":"House concert 19\/02\/25","copyright":null},"nl":{"title":"House concert 19\/02\/25","copyright":null}}},{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/162949b65b671a80d4e63b3725a7dd7fb02f3b76.png","width":3000,"height":3000,"ratio":1,"oEmbed_height":3000,"oEmbed_width":3000,"translations":{"de":{"title":"House Concerts: Les mercredis jazz \u2013 Histoires et musique","copyright":null},"pt":{"title":"House Concerts: Les mercredis jazz \u2013 Histoires et musique","copyright":null},"en":{"title":"House Concerts: Les mercredis jazz \u2013 Histoires et musique","copyright":null},"it":{"title":"House Concerts: Les mercredis jazz \u2013 Histoires et musique","copyright":null},"cn":{"title":"House Concerts: Les mercredis jazz \u2013 Histoires et musique","copyright":null},"fr":{"title":"House Concerts: Les mercredis jazz \u2013 Histoires et musique","copyright":null},"sp":{"title":"House Concerts: Les mercredis jazz \u2013 Histoires et musique","copyright":null},"nl":{"title":"House Concerts: Les mer