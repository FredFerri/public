essible to people with intellectual disabilities","Accessible","Facilities for blind and partially-sighted persons","Facilities for deaf and hearing-impaired people","Assistance dogs","Accessible to pedestrians with mobility aids"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-10T17:36:43+02:00","published_at":"2022-10-04T08:54:13+02:00","backoffice_id":263050,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":0.38517135711084},{"id":544862,"date_start":"2022-10-26","date_end":"2022-12-03","date_next":"2022-11-26","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater"}},"others":{"list":[53],"translations":{"fr":["Contes"],"nl":["Verteltheater"],"en":["Tales"],"de":["M\u00e4rchen"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Contes au mus\u00e9e","shortdescr":"Laissez-vous surprendre par les fabuleuses histoires racont\u00e9es par Iota Gaganas. En puisant dans la mythologie grecque, notre conteuse vous emm\u00e8ne \u00e0 la d\u00e9couverte de la fontaine des Trois Gr\u00e2ces, de la tapisserie de Pan et Syrinx et des m\u00e9daillons des quatre saisons.","longdescr":"Les \u0153uvres du mus\u00e9e n\u2019ont plus aucun secret pour vous ? Vous n\u2019avez jamais explor\u00e9 nos collections et vous souhaitez les aborder autrement ? Laissez-vous surprendre par les fabuleuses histoires racont\u00e9es par Iota Gaganas. En puisant dans la mythologie grecque, notre conteuse vous emm\u00e8ne \u00e0 la d\u00e9couverte de la fontaine des Trois Gr\u00e2ces, de la tapisserie de Pan et Syrinx et des m\u00e9daillons des quatre saisons. Gr\u00e2ce aux amours tumultueuses de Zeus avec Europe ou de Dana\u00e9 et L\u00e9da et du mythe d\u2019Echo et de Narcisse, plongez de mani\u00e8re fantastique dans les \u0153uvres bruxelloises.","performers":"En collaboration avec la F\u00e9d\u00e9ration des Conteurs professionnels","boxoffice_url":null,"website":"http:\/\/www.museedelavilledebruxelles.brussels","email":"musea@brucity.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.544862"},"nl":{"name":"Contes au mus\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.544862"},"en":{"name":"Contes au mus\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.544862"},"de":{"name":"Contes au mus\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.544862"},"it":{"name":"Contes au mus\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.544862"},"sp":{"name":"Contes au mus\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.544862"},"pt":{"name":"Contes au mus\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.544862"},"cn":{"name":"Contes au mus\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.544862"}},"place":{"id":231543,"translations":{"fr":{"name":"Mus\u00e9e de la Ville de Bruxelles \/ Maison du Roi","address_street_name":"Grand-Place","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museedelavilledebruxelles.brussels","phone_contact":"+32 2 279 43 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"Faisant face \u00e0 l\u2019H\u00f4tel de Ville gothique, ce magnifique \u00e9difice, b\u00e2ti \u00e0 la fin du 19e si\u00e8cle, profite de la d\u00e9molition de son anc\u00eatre du 16e si\u00e8cle, qui tombe en ruine, pour le remplacer sous la forme d\u2019une reconstitution n\u00e9ogothique, men\u00e9e par l\u2019architecte de la Ville Victor Jamaer. Le souci de perfection dans la reconstitution finira par engendrer un b\u00e2timent id\u00e9alis\u00e9\u2026\r\nL\u2019appellation de l\u2019\u00e9difice appelle quelques explications et contraint \u00e0 un voyage dans le pass\u00e9. D\u00e8s le 13e si\u00e8cle, le site est occup\u00e9 par une halle au pain, construite en bois \u2014 Broodhuis en n\u00e9erlandais, appellation toujours en vigueur dans la langue de Vondel. Le duc de Brabant, propri\u00e9taire des lieux, d\u00e9cide au 15e si\u00e8cle de remplacer cette halle par un \u00e9difice prestigieux, mani\u00e8re pour lui de rappeler son pouvoir en \u00e9rigeant le b\u00e2timent en vis-\u00e0-vis de l\u2019H\u00f4tel de Ville, symbole pour sa part de l\u2019autonomie communale. La d\u00e9signation de \u00ab Maison du Roi \u00bb date du r\u00e8gne de Charles-Quint, \u00e0 la t\u00eate de plusieurs royaumes. Au m\u00eame titre que l\u2019ensemble de la Grand-Place, la Maison du Roi est inscrite au patrimoine mondial de l\u2019UNESCO depuis 2000.\r\nClass\u00e9e dans son enti\u00e8ret\u00e9 en 1936, la Maison du Roi est, depuis 2000, inscrite au patrimoine mondial de l\u2019UNESCO avec l\u2019ensemble de la Grand-Place.\r\nOuvert \u00e0 la fin du 19e si\u00e8cle, le mus\u00e9e de la Ville balaye la longue histoire bruxelloise, en insistant particuli\u00e8rement sur les sph\u00e8res de l\u2019art, de l\u2019artisanat,de l\u2019urbanisme et de l\u2019architecture  . \u00c0 ce dernier titre, une salle enti\u00e8re est d\u00e9di\u00e9e \u00e0 l\u2019histoire de la r\u00e9put\u00e9e statuette du Manneken-Pis, et pr\u00e9sente la statue originale du 17e si\u00e8cle. \u00c0 quelques pas de l\u00e0, vous d\u00e9couvrirez la GardeRobe MannekenPis, une s\u00e9lection de quelques-uns des costumes du ketje, qui en poss\u00e8de pr\u00e8s de 1000 !\r\n\r\nBillet combin\u00e9 donnant acc\u00e8s au Mus\u00e9e de la Ville de Bruxelles - Maison du Roi et \u00e0 la GardeRobe MannekenPis.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Museum van de Stad Brussel \/ Broodhuis","address_street_name":"Grote Markt","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museumvandestadbrussel.brussels","phone_contact":"+32 2 279 43 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Brussel","address_line1":"Grote Markt","address_line2":"1000 Brussel","description_web":"Op de Grote Markt van Brussel steken twee majestueuze gebouwen elkaar de loef af. Aan de ene kant het Stadhuis van Brussel, er recht tegenover het Broodhuis, UNESCO-werelderfgoed waar het Museum van de Stad Brussel gevestigd is. De rivaliteit tussen de twee gebouwen is geen toeval: de hertog van Brabant verving de 13de eeuwse houten broodhallen \u2013 vandaar de naam Broodhuis - er in de 15de eeuw door een prestigieus gebouw, dat zijn macht in de verf moest zetten en zo tegengewicht moest bieden aan het imposante gebouw aan de overkant, symbool van de stedelijke onafhankelijkheid. De Franse benaming Maison du Roi heeft het gebouw te danken aan Karel V, ooit heerser over een groot deel van de wereld en ook ooit nog eigenaar van het Broodhuis. In de 16de eeuw vernield, werd het op het einde van de 19de eeuw in neogotische stijl heropgebouwd door stadsarchitect Victor Jamaer. \r\nNiet alleen de geschiedenis en de buitenkant van het Broodhuis is de moeite waard. Binnenin geeft het Museum van de Stad Brussel een rijk gestoffeerd overzicht van de geschiedenis van Brussel, met veel aandacht voor kunst, ambachten, stedenbouw en architectuur. Het oorspronkelijke beeldje van Manneken Pis is hier om veiligheidsoverwegingen ook ondergebracht, maar zijn garderobe \u2013 met bijna 1.000 outfits groter dan die van welke fashionista ook \u2013 moet bewonderd worden in het speciaal daarvoor ingerichte museum in de Eikstraat. Veel dichter bij het blote ventje dus.\r\n\r\nEen combiticket geeft toegang tot het Museum van de Stad Brussel-Broodhuis en de Garderobe MannekenPis.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Museum of the City of Brussels","address_street_name":"Grand-Place","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.brusselscitymuseum.brussels","phone_contact":"+32 2 279 43 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Brussels","address_line1":"Grand-Place","address_line2":"1000 Brussels","description_web":"Two majestic buildings that stand opposite each other on Brussels' Grand Place have a long-standing rivalry: on one side you have Brussels' City Hall, and on the other the Broodhuis (Bread House), a UNESCO World Heritage Site which houses the Brussels City Museum. The rivalry between these two buildings is no coincidence. In the 15th century, the Duke of Brabant replaced the 13th century wooden bread market building with a prestigious building that would be a symbol of his power and face off against the imposing building on the other side of the Grand Place that symbolised the city's independence. The building owes its French name of Maison du Roi (King's House) to Charles V, Holy Roman Emperor, who once ruled over a large part of the globe and once owned the Bread House. After being destroyed in the 16th century, it was rebuilt in the Gothic Revival style in the 19th century by city architect Victor Jamaer.\r\nBut it's not all about the Broodhuis' history and facade. Inside the Brussels City Museum gives a comprehensive overview of Brussels' history, with particular attention given to the arts, crafts,urbanism and architecture . The original Manneken Pis is also housed here for security reasons, but as for his wardrobe, which is a thousand times larger than even the most passionate fashionista's, you can marvel at that in its dedicated museum on Rue du Ch\u00eane - Eikstraat. \r\n\r\nCombined ticket giving access to  the Brussels City Museum -Maison du Roi and the Garderobe MannekenPis.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Br\u00fcsseler Stadtmuseum - Maison du Roi","address_street_name":"Grand-Place","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.brusselscitymuseum.brussels","phone_contact":"+32 2 279 43 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"Das majest\u00e4tische Maison du Roi (dt. Haus des K\u00f6nigs), in dem sich das Br\u00fcsseler Stadtmuseum befindet, ist Teil des architektonischen Ensembles des ber\u00fchmten Grand-Place und z\u00e4hlt zum UNESCO-Weltkulturerbe.\r\n\r\nBei dem neogotischen Geb\u00e4ude, das im 19. Jahrhundert nach den Pl\u00e4nen des Architekten Pierre-Victor Jamaer fertiggestellt wurde, handelt es sich um eine Nachbildung eines Bauwerks im sp\u00e4tgotischen Stil des 16. Jahrhunderts. \r\n\r\nDas hier untergebrachte Br\u00fcsseler Stadtmuseum birgt Ausstellungen und Sammlungen zur Geschichte der Stadt Br\u00fcssel, Stadtentwicklung, Arch\u00e4ologie, Kunst und Stadtleben etc. Auch die Br\u00fcsseler Folklore wird beleuchtet. So ist der Garderobe von Manneken Pis ein eigener Saal gewidmet. Seit Februar 2017 hat sie sogar ein eigenes Museum: GardeRobe MannekenPis an der Rue du Ch\u00eane 19, gleich neben der ber\u00fchmten Brunnenfigur.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"MUSEO DELLA CITTA' DI BRUXELLES - CASA DEL RE","address_street_name":"Grand-Place","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.brusselscitymuseum.brussels","phone_contact":"+32 2 279 43 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"Ricostituzione del XIX secolo dell'edificio costruito durante il regno di Carlo V all'inizio del XVI secolo....\r\n\r\n\"Ricostituzione del XIX secolo dell'edificio costruito durante il regno di Carlo V all'inizio del XVI secolo.\r\nMonumento classificato come stile gotico fiammeggiante .\r\nArti plastiche e decorative di Bruxelles: pittura, pale, arazzi, sculture, porcellana, ceramica, argenteria, stagno.\r\nSviluppo urbanistico: mappe, plastici, evocazione dei problemi di comunicazione, delle zone verdi, del porto di Bruxelles, i principali monumenti, le grandi creazioni urbanistiche.\r\nStoria di Bruxelles; le istituzioni politiche locali, il ruolo di Bruxelles quale capitale, la storia economica, sociale, religiosa, culturale ed il folclore (tra cui il guardaroba del Manneken-Pis).\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Casa del Rey - Museo de la Ciudad de Bruselas","address_street_name":"Grand-Place","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.brusselscitymuseum.brussels","phone_contact":"+32 2 279 43 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"El Museo de la Ciudad de Bruselas es uno de los tres Premios de los Museos 2014. Ven a visitarlo y descubre por qu\u00e9.\u00a0...\r\n\r\nEl Museo de la Ciudad de Bruselas es uno de los tres Premios de los Museos 2014. Ven a visitarlo y descubre por qu\u00e9.\r\n\r\nUbicado en pleno centro hist\u00f3rico de la ciudad, en la Grand-Place, el Museo de la Ciudad de Bruselas se ha consagrado a la historia y a las artes de la ciudad.\u00a0\r\n\r\nLa versi\u00f3n original del m\u00e1s conocido de los bruselenses, el  Manneken-Pis y su armario, se han conservado magn\u00edficamente en este edificio neog\u00f3tico, declarado Patrimonio Mundial de la Unesco, junto con la Grand-Place.\u00a0\r\nSus colecciones presentan los or\u00edgenes de Bruselas, su desarrollo a lo largo de los siglos y la vida de sus habitantes.\r\nDurante tu visita, podr\u00e1s descubrir objetos arqueol\u00f3gicos, porcelanas, retablos y tapicer\u00edas, grabados, esculturas, pinturas y maquetas de la ciudad.\u00a0\r\n\r\nTe permitir\u00e1n comprender mejor la evoluci\u00f3n de esta capital \u00fanica. En la gran sala de la \u00faltima planta, el museo organiza exposiciones temporales y desvela el fabuloso guardarrop\u00eda de  Manneken-Pis, un tesoro que no te puedes perder.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Mus\u00e9e de la Ville de Bruxelles - Maison du Roi","address_street_name":"Grand-Place","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museedelavilledebruxelles.brussels","phone_contact":"+32 2 279 43 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Mus\u00e9e de la Ville de Bruxelles - Maison du Roi","address_street_name":"Grand-Place","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museedelavilledebruxelles.brussels","phone_contact":"+32 2 279 43 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[13],"translations":{"fr":["Centre historique"],"nl":["Historisch centrum"],"en":["Historical Centre"]}},"zones":{"list":[19],"translations":{"fr":["Centre"],"nl":["Centrum"],"en":["Centre"]}},"neca":null,"facebook_id":null,"backoffice_id":958,"location":{"lat":50.8466937,"lon":4.35252339},"region":"brussels","last_updated_at":"2022-11-04T12:05:23+01:00","published_at":"2013-10-19T01:13:56+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":231543,"translations":{"fr":{"name":"Mus\u00e9e de la Ville de Bruxelles \/ Maison du Roi","address_street_name":"Grand-Place","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museedelavilledebruxelles.brussels","phone_contact":"+32 2 279 43 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"Faisant face \u00e0 l\u2019H\u00f4tel de Ville gothique, ce magnifique \u00e9difice, b\u00e2ti \u00e0 la fin du 19e si\u00e8cle, profite de la d\u00e9molition de son anc\u00eatre du 16e si\u00e8cle, qui tombe en ruine, pour le remplacer sous la forme d\u2019une reconstitution n\u00e9ogothique, men\u00e9e par l\u2019architecte de la Ville Victor Jamaer. Le souci de perfection dans la reconstitution finira par engendrer un b\u00e2timent id\u00e9alis\u00e9\u2026\r\nL\u2019appellation de l\u2019\u00e9difice appelle quelques explications et contraint \u00e0 un voyage dans le pass\u00e9. D\u00e8s le 13e si\u00e8cle, le site est occup\u00e9 par une halle au pain, construite en bois \u2014 Broodhuis en n\u00e9erlandais, appellation toujours en vigueur dans la langue de Vondel. Le duc de Brabant, propri\u00e9taire des lieux, d\u00e9cide au 15e si\u00e8cle de remplacer cette halle par un \u00e9difice prestigieux, mani\u00e8re pour lui de rappeler son pouvoir en \u00e9rigeant le b\u00e2timent en vis-\u00e0-vis de l\u2019H\u00f4tel de Ville, symbole pour sa part de l\u2019autonomie communale. La d\u00e9signation de \u00ab Maison du Roi \u00bb date du r\u00e8gne de Charles-Quint, \u00e0 la t\u00eate de plusieurs royaumes. Au m\u00eame titre que l\u2019ensemble de la Grand-Place, la Maison du Roi est inscrite au patrimoine mondial de l\u2019UNESCO depuis 2000.\r\nClass\u00e9e dans son enti\u00e8ret\u00e9 en 1936, la Maison du Roi est, depuis 2000, inscrite au patrimoine mondial de l\u2019UNESCO avec l\u2019ensemble de la Grand-Place.\r\nOuvert \u00e0 la fin du 19e si\u00e8cle, le mus\u00e9e de la Ville balaye la longue histoire bruxelloise, en insistant particuli\u00e8rement sur les sph\u00e8res de l\u2019art, de l\u2019artisanat,de l\u2019urbanisme et de l\u2019architecture  . \u00c0 ce dernier titre, une salle enti\u00e8re est d\u00e9di\u00e9e \u00e0 l\u2019histoire de la r\u00e9put\u00e9e statuette du Manneken-Pis, et pr\u00e9sente la statue originale du 17e si\u00e8cle. \u00c0 quelques pas de l\u00e0, vous d\u00e9couvrirez la GardeRobe MannekenPis, une s\u00e9lection de quelques-uns des costumes du ketje, qui en poss\u00e8de pr\u00e8s de 1000 !\r\n\r\nBillet combin\u00e9 donnant acc\u00e8s au Mus\u00e9e de la Ville de Bruxelles - Maison du Roi et \u00e0 la GardeRobe MannekenPis.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Museum van de Stad Brussel \/ Broodhuis","address_street_name":"Grote Markt","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museumvandestadbrussel.brussels","phone_contact":"+32 2 279 43 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Brussel","address_line1":"Grote Markt","address_line2":"1000 Brussel","description_web":"Op de Grote Markt van Brussel steken twee majestueuze gebouwen elkaar de loef af. Aan de ene kant het Stadhuis van Brussel, er recht tegenover het Broodhuis, UNESCO-werelderfgoed waar het Museum van de Stad Brussel gevestigd is. De rivaliteit tussen de twee gebouwen is geen toeval: de hertog van Brabant verving de 13de eeuwse houten broodhallen \u2013 vandaar de naam Broodhuis - er in de 15de eeuw door een prestigieus gebouw, dat zijn macht in de verf moest zetten en zo tegengewicht moest bieden aan het imposante gebouw aan de overkant, symbool van de stedelijke onafhankelijkheid. De Franse benaming Maison du Roi heeft het gebouw te danken aan Karel V, ooit heerser over een groot deel van de wereld en ook ooit nog eigenaar van het Broodhuis. In de 16de eeuw vernield, werd het op het einde van de 19de eeuw in neogotische stijl heropgebouwd door stadsarchitect Victor Jamaer. \r\nNiet alleen de geschiedenis en de buitenkant van het Broodhuis is de moeite waard. Binnenin geeft het Museum van de Stad Brussel een rijk gestoffeerd overzicht van de geschiedenis van Brussel, met veel aandacht voor kunst, ambachten, stedenbouw en architectuur. Het oorspronkelijke beeldje van Manneken Pis is hier om veiligheidsoverwegingen ook ondergebracht, maar zijn garderobe \u2013 met bijna 1.000 outfits groter dan die van welke fashionista ook \u2013 moet bewonderd worden in het speciaal daarvoor ingerichte museum in de Eikstraat. Veel dichter bij het blote ventje dus.\r\n\r\nEen combiticket geeft toegang tot het Museum van de Stad Brussel-Broodhuis en de Garderobe MannekenPis.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Museum of the City of Brussels","address_street_name":"Grand-Place","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.brusselscitymuseum.brussels","phone_contact":"+32 2 279 43 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Brussels","address_line1":"Grand-Place","address_line2":"1000 Brussels","description_web":"Two majestic buildings that stand opposite each other on Brussels' Grand Place have a long-standing rivalry: on one side you have Brussels' City Hall, and on the other the Broodhuis (Bread House), a UNESCO World Heritage Site which houses the Brussels City Museum. The rivalry between these two buildings is no coincidence. In the 15th century, the Duke of Brabant replaced the 13th century wooden bread market building with a prestigious building that would be a symbol of his power and face off against the imposing building on the other side of the Grand Place that symbolised the city's independence. The building owes its French name of Maison du Roi (King's House) to Charles V, Holy Roman Emperor, who once ruled over a large part of the globe and once owned the Bread House. After being destroyed in the 16th century, it was rebuilt in the Gothic Revival style in the 19th century by city architect Victor Jamaer.\r\nBut it's not all about the Broodhuis' history and facade. Inside the Brussels City Museum gives a comprehensive overview of Brussels' history, with particular attention given to the arts, crafts,urbanism and architecture . The original Manneken Pis is also housed here for security reasons, but as for his wardrobe, which is a thousand times larger than even the most passionate fashionista's, you can marvel at that in its dedicated museum on Rue du Ch\u00eane - Eikstraat. \r\n\r\nCombined ticket giving access to  the Brussels City Museum -Maison du Roi and the Garderobe MannekenPis.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Br\u00fcsseler Stadtmuseum - Maison du Roi","address_street_name":"Grand-Place","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.brusselscitymuseum.brussels","phone_contact":"+32 2 279 43 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"Das majest\u00e4tische Maison du Roi (dt. Haus des K\u00f6nigs), in dem sich das Br\u00fcsseler Stadtmuseum befindet, ist Teil des architektonischen Ensembles des ber\u00fchmten Grand-Place und z\u00e4hlt zum UNESCO-Weltkulturerbe.\r\n\r\nBei dem neogotischen Geb\u00e4ude, das im 19. Jahrhundert nach den Pl\u00e4nen des Architekten Pierre-Victor Jamaer fertiggestellt wurde, handelt es sich um eine Nachbildung eines Bauwerks im sp\u00e4tgotischen Stil des 16. Jahrhunderts. \r\n\r\nDas hier untergebrachte Br\u00fcsseler Stadtmuseum birgt Ausstellungen und Sammlungen zur Geschichte der Stadt Br\u00fcssel, Stadtentwicklung, Arch\u00e4ologie, Kunst und Stadtleben etc. Auch die Br\u00fcsseler Folklore wird beleuchtet. So ist der Garderobe von Manneken Pis ein eigener Saal gewidmet. Seit Februar 2017 hat sie sogar ein eigenes Museum: GardeRobe MannekenPis an der Rue du Ch\u00eane 19, gleich neben der ber\u00fchmten Brunnenfigur.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"MUSEO DELLA CITTA' DI BRUXELLES - CASA DEL RE","address_street_name":"Grand-Place","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.brusselscitymuseum.brussels","phone_contact":"+32 2 279 43 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"Ricostituzione del XIX secolo dell'edificio costruito durante il regno di Carlo V all'inizio del XVI secolo....\r\n\r\n\"Ricostituzione del XIX secolo dell'edificio costruito durante il regno di Carlo V all'inizio del XVI secolo.\r\nMonumento classificato come stile gotico fiammeggiante .\r\nArti plastiche e decorative di Bruxelles: pittura, pale, arazzi, sculture, porcellana, ceramica, argenteria, stagno.\r\nSviluppo urbanistico: mappe, plastici, evocazione dei problemi di comunicazione, delle zone verdi, del porto di Bruxelles, i principali monumenti, le grandi creazioni urbanistiche.\r\nStoria di Bruxelles; le istituzioni politiche locali, il ruolo di Bruxelles quale capitale, la storia economica, sociale, religiosa, culturale ed il folclore (tra cui il guardaroba del Manneken-Pis).\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Casa del Rey - Museo de la Ciudad de Bruselas","address_street_name":"Grand-Place","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.brusselscitymuseum.brussels","phone_contact":"+32 2 279 43 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"El Museo de la Ciudad de Bruselas es uno de los tres Premios de los Museos 2014. Ven a visitarlo y descubre por qu\u00e9.\u00a0...\r\n\r\nEl Museo de la Ciudad de Bruselas es uno de los tres Premios de los Museos 2014. Ven a visitarlo y descubre por qu\u00e9.\r\n\r\nUbicado en pleno centro hist\u00f3rico de la ciudad, en la Grand-Place, el Museo de la Ciudad de Bruselas se ha consagrado a la historia y a las artes de la ciudad.\u00a0\r\n\r\nLa versi\u00f3n original del m\u00e1s conocido de los bruselenses, el  Manneken-Pis y su armario, se han conservado magn\u00edficamente en este edificio neog\u00f3tico, declarado Patrimonio Mundial de la Unesco, junto con la Grand-Place.\u00a0\r\nSus colecciones presentan los or\u00edgenes de Bruselas, su desarrollo a lo largo de los siglos y la vida de sus habitantes.\r\nDurante tu visita, podr\u00e1s descubrir objetos arqueol\u00f3gicos, porcelanas, retablos y tapicer\u00edas, grabados, esculturas, pinturas y maquetas de la ciudad.\u00a0\r\n\r\nTe permitir\u00e1n comprender mejor la evoluci\u00f3n de esta capital \u00fanica. En la gran sala de la \u00faltima planta, el museo organiza exposiciones temporales y desvela el fabuloso guardarrop\u00eda de  Manneken-Pis, un tesoro que no te puedes perder.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Mus\u00e9e de la Ville de Bruxelles - Maison du Roi","address_street_name":"Grand-Place","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museedelavilledebruxelles.brussels","phone_contact":"+32 2 279 43 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Mus\u00e9e de la Ville de Bruxelles - Maison du Roi","address_street_name":"Grand-Place","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museedelavilledebruxelles.brussels","phone_contact":"+32 2 279 43 50","phone_booking":"+32 2 279 43 67","address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":null,"f