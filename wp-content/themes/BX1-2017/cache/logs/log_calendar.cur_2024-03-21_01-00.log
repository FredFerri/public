cland-theatre.com","email":"chloe@magicland-theatre.com","phone_contact":null,"phone_booking":"+32 495 26 18 42","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50001841"},"sp":{"name":"La courbe du U","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.magicland-theatre.com","email":"chloe@magicland-theatre.com","phone_contact":null,"phone_booking":"+32 495 26 18 42","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50001841"},"nl":{"name":"La courbe du U","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.magicland-theatre.com","email":"chloe@magicland-theatre.com","phone_contact":null,"phone_booking":"+32 495 26 18 42","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50001841"}},"place":{"id":224842,"translations":{"de":{"name":"Magic Land Th\u00e9\u00e2tre","address_street_name":"Rue d'Hoogvorst","address_street_number":"8-14","address_street_box":null,"email":"info@magicland-theatre.com","website":"http:\/\/www.magicland-theatre.com","phone_contact":"+32 2 245 50 64","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Rue d'Hoogvorst, 8-14","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Magic Land Th\u00e9\u00e2tre","address_street_name":"Rue d'Hoogvorst","address_street_number":"8-14","address_street_box":null,"email":"info@magicland-theatre.com","website":"http:\/\/www.magicland-theatre.com","phone_contact":"+32 2 245 50 64","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Rue d'Hoogvorst, 8-14","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Magic Land Th\u00e9\u00e2tre","address_street_name":"Rue d'Hoogvorst","address_street_number":"8-14","address_street_box":null,"email":"info@magicland-theatre.com","website":"http:\/\/www.magicland-theatre.com","phone_contact":"+32 2 245 50 64","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Rue d'Hoogvorst, 8-14","address_line2":"1030 Schaerbeek","description_web":"The Magic Land Th\u00e9\u00e2tre was born out of a collective dream in the 1970s. It now has its\r\nactive, around fifty creations, several international tours and participation regular at most major Belgian cultural events. His multiple exp\u00e9riences artistic works carried out on so many fronts have allowed him to forge a style so particular, far removed off the beaten track of classical theater. If we had to classify the \"Magic land\" in a category \" popular theater \"is undoubtedly the adjective which would suit best even if Patrick Chaboud its founder prefers to speak of a theater of exchanges, meetings, surprises, debates, emotions and forcing anger sometimes too. At the Magic land theater, the scenic barriers conventional have long since been abolished in order to build bridges between genders, heater, dance, music, circus, humor. The Magic Land Theater is ultimately, above all, a living theater, a theater in perpetual \"reinvention\" to better ward off ideas black.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Magic Land Th\u00e9\u00e2tre","address_street_name":"Rue d'Hoogvorst","address_street_number":"8-14","address_street_box":null,"email":"info@magicland-theatre.com","website":"http:\/\/www.magicland-theatre.com","phone_contact":"+32 2 245 50 64","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Rue d'Hoogvorst, 8-14","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Magic Land Th\u00e9\u00e2tre","address_street_name":"Rue