xport":false,"resto_ranking":0},"media":[{"type":"poster","link":"https:\/\/agendabrussels.imgix.net\/218574554183f1af3afad9070ef8ac5b7b4d5b26.jpg","width":8256,"height":5504,"ratio":1.5,"translations":{"fr":{"title":"Ik en den Theo \/ Moi et le Th\u00e9o en concert au Ch\u00e2teau du Karreveld","copyright":null},"nl":{"title":"Ik en den Theo \/ Moi et le Th\u00e9o en concert au Ch\u00e2teau du Karreveld","copyright":null},"en":{"title":"Ik en den Theo \/ Moi et le Th\u00e9o en concert au Ch\u00e2teau du Karreveld","copyright":null}}}],"dates":[{"day":"2022-11-20","doors":null,"start":"15:00:00","end":null,"is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":15}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":{"list":[255],"translations":{"fr":["Accessible"],"nl":["Toegankelijk"],"en":["Accessible"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-11-17T10:35:10+01:00","published_at":"2022-10-27T12:18:45+02:00","backoffice_id":264847,"import_origin":null,"sub_type":"concert","show_in_agenda":true,"ranking":1.2599210498949},{"id":545360,"date_start":"2022-11-20","date_end":"2022-11-20","date_next":"2022-11-20","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater"}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"],"de":["Theater"]}}},"languages":{"spoken":["nl","fr"],"subtitles":[]},"translations":{"fr":{"name":"Journ\u00e9e des arts pour enfants au WIELS","shortdescr":"\u00c0 l'occasion de la Journ\u00e9e des arts pour les enfants, vous pourrez venir voir gratuitement et en famille le spectacle Lusiola d'Amadeo Kollectif au WIELS. Un spectacle participatif pour les jeunes avec votre public dans le r\u00f4le principal.","longdescr":"La rencontre entre Ola, un personnage fascinant, et Luz, une femme ouverte d'esprit. Intrigu\u00e9s, \u00e9tonn\u00e9s et timides, ils apprennent \u00e0 s'appr\u00e9cier et \u00e0 profiter du paysage sonore qu'Ola r\u00e9v\u00e8le \u00e0 Luz. L'histoire se d\u00e9veloppe dans un environnement inspirant et entra\u00eene progressivement le public dans cette histoire visuelle.","performers":"Une production d'Amadeo Kollectif mise en sc\u00e8ne par Marianne Hans\u00e9 et Elsa Debefve.","boxoffice_url":null,"website":"http:\/\/www.wiels.org","email":"welcome@wiels.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.545360"},"nl":{"name":"Kunstendag voor Kinderen in WIELS","shortdescr":"Tijdens de Kunstendag voor Kinderen kan je gratis met het hele gezin komen kijken naar de voorstelling Lusiola van Amadeo Kollectif in WIELS. Een participatieve voorstelling voor jongeren met het publiek in de hoofdrol.","longdescr":"Lusiola is het verhaal van de ontmoeting tussen Ola, een vreemd wezen, en de openhartige Luz. Ge\u00efntrigeerd, verbaasd of fel in hun ontdekkingen, temmen ze zichzelf op hun beurt door te luisteren naar de geluiden van een nieuw universum. Het verhaal evolueert in een inspirerende setting en trekt het publiek geleidelijk mee in dit denkbeeldige verhaal.","performers":"Een productie van Amadeo Kollectif geregisseerd door Marianne Hans\u00e9 en Elsa Debefve\r\n(Gespeeld door Charlotte van Wouwe en Maily Berens)","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":"+32 2 340 00 53","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.545360"},"en":{"name":"Children's Art Day at WIELS","shortdescr":"During the Children's Art Day, you and the whole family can come and see Amadeo Kollectif's performance Lusiola for free at WIELS. A participatory performance for young people starring the audience.","longdescr":"Lusiola is the story of the encounter between Ola, a strange creature, and the very open-hearted Luz. Intrigued, amazed or fierce in their discoveries, they in turn tame themselves by listening to the sounds of a new universe. The story evolves in an inspiring setting, gradually drawing the audience into this imaginary tale.","performers":"A production by Amadeo Kollectif directed by Marianne Hans\u00e9 and Elsa Debefve\r\n(Played by Charlotte van Wouwe and Maily Berens)","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.545360"},"de":{"name":"Kunstendag voor Kinderen in WIELS","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.545360"},"it":{"name":"Kunstendag voor Kinderen in WIELS","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.545360"},"sp":{"name":"Kunstendag voor Kinderen in WIELS","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.545360"},"pt":{"name":"Kunstendag voor Kinderen in WIELS","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.545360"},"cn":{"name":"Kunstendag voor Kinderen in WIELS","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.545360"}},"place":{"id":1490,"translations":{"fr":{"name":"Wiels - Centre d\u2019art contemporain","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+32 2 340 00 50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":"La r\u00e9servation est obligatoire pour le Wiels. Veuillez vous rendre sur leur site internet pour une r\u00e9servation.\r\n\r\nLe WIELS est un laboratoire international pour la cr\u00e9ation et la diffusion de l\u2019art contemporain. Ax\u00e9 sur les arts visuels, mais accordant une place et une attention particuli\u00e8res aux croisements et interactions avec d\u2019autres disciplines, le centre d\u00e9sire pr\u00e9senter l\u2019art contemporain dans toute sa diversit\u00e9 et mettre le public en contact et en dialogue permanents avec les d\u00e9veloppements et d\u00e9bats les plus r\u00e9cents du monde de l\u2019art.","description_print":"","booking_url":null,"sort_order":"WIELS - CONTEMPORARY ART CENTRE","virtual_visit":null},"nl":{"name":"Wiels - Centrum voor hedendaagse kunst","address_street_name":"Van Volxemlaan","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+32 2 340 00 50","phone_booking":null,"address_zip":"1190","address_city":"Vorst","address_line1":"Van Volxemlaan, 354","address_line2":"1190 Vorst","description_web":"De boeking is verplicht voor Wiels. Raadpleeg de webpagina van de musea om te reserveren.\r\n\r\nWiels is een toonaangevend internationaal platform voor de creatie en presentatie van hedendaagse kunst. Het centrum ontwikkelt een programma van tijdelijke activiteiten, zonder een permanente collectie uit te bouwen. Wiels organiseert zes tot acht grote tentoonstellingen per jaar die de evoluties in hedendaagse kunst op de voet volgen. Daarnaast loopt er een residentie en educatief programma en worden er lezingen, films, performances, debatten, ontmoetingen georganiseerd.","description_print":"","booking_url":null,"sort_order":"WIELS - CONTEMPORARY ART CENTRE","virtual_visit":null},"en":{"name":"Wiels - Contemporary art centre","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+32 2 340 00 50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":"Booking is compulsory for Wiels. Please consult the museum\u2019s website to book your time slot.\r\n\r\nIt was the brewer L\u00e9on Wielemans who asked his friend, the architect Adrien Blomme, to design and build the new buildings of his brewery in Forest. It became the leading monument of industrial archaeology in the art deco style, and houses now Wiels, an international laboratory for the creation and the diffusion of contemporary art. Focusing on visual arts, but granting a particular attention to the crossings and interactions with other disciplines, the centre wishes to present contemporary art in all its diversity and to offer a permanent dialogue with the developments and the most recent debates of the art world.  ","description_print":"","booking_url":null,"sort_order":"WIELS - CONTEMPORARY ART CENTRE","virtual_visit":null},"de":{"name":"Wiels - Zentrum f\u00fcr moderne Kunst","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+32 2 340 00 50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":"Das WIELS ist ein hochkar\u00e4tiges, internationales Labor f\u00fcr moderne Kunst, das sich nicht nur der Ausstellung von moderner Kunst sondern auch dem kreativen Entstehungsprozess widmet. Der Schwerpunkt liegt auf der visuellen Kunst, doch es werden auch ganz bewusst Schnittstellen mit anderen Disziplinen gesucht, die die Vielfalt und das Facettenreichtum der modernen Kunst aufzuzeigen. Dem Besucher offenbart sich ein permanenter Dialog mit den Entwicklungen der modernen Kunst und eine Debatte mit der Kunstwelt der Gegenwart.\r\n\r\nAuf drei Ebenen mit insgesamt 1800 m\u00b2 Ausstellungsfl\u00e4che finden regelm\u00e4\u00dfig Ausstellungen statt. Dar\u00fcber hinaus wird das WIELS regelm\u00e4\u00dfig Schauplatz von ausgew\u00e4hlten Filmvorf\u00fchrungen, Konferenzen, Festivals und Konzerten. \r\n\r\nUntergebracht ist das WIELS in dem eindrucksvollen Eckgeb\u00e4ude der ehemaligen Brauerei Wielemans-Ceuppens, das aus der Feder des modernistischen Architekten Adrien Blomm stammt. Von der Brauereivergangenheit zeugen noch heute die majest\u00e4tischen Kupferkessel.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Wiels - Centre d\u2019art contemporain","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+32 2 340 00 50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Wiels - Centro de arte contempor\u00e1neo","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+32 2 340 00 50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":"Fue el amante de la cerveza L\u00e9on Wielemans quien le pidi\u00f3 a su amigo, el arquitecto Adrien Blomme, dise\u00f1ar y construir los nuevos edificios para su cervecer\u00eda en Forest. Se convirti\u00f3 en el monumento m\u00e1s importante de arqueolog\u00eda industrial en estilo art d\u00e9co, y ahora alberga Wiels, un laboratorio internacional para la creaci\u00f3n y difusi\u00f3n de arte contempor\u00e1neo. Poniendo el foco en las artes visuales, pero garantizando una particular atenci\u00f3n en el cruce y las interacciones con otras disciplinas, el centro pretende mostrar el arte contempor\u00e1neo en todos sus sentidos y ofrecer un di\u00e1logo permanente con su desarrollo y los debates m\u00e1s recientes del mundo del arte.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Wiels - Centre d\u2019art contemporain","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+32 2 340 00 50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Wiels - Centre d\u2019art contemporain","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+32 2 340 00 50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":"","description_print":"","booking_url":null,"sort_order":null,"