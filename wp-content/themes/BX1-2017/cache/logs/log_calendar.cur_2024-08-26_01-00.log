urs","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/retrouvailles-ete-2024","email":null,"phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50011600"},"cn":{"name":"Sortie de secours","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/retrouvailles-ete-2024","email":null,"phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50011600"},"fr":{"name":"Sortie de secours","shortdescr":null,"longdescr":"Venez retrouver un acteur au coeur d\u2019un imbroglio familial ! Fabio Zenoni, com\u00e9dien \u00e0 multiples facettes, incarne plus d\u2019une dizaine de personnages et cr\u00e9e une com\u00e9die caustique et r\u00e9jouissante.\n \nEn plein festival d\u2019Avignon, sa m\u00e8re entend faire cesser avec panache les repr\u00e9sentations d\u2019un spectacle de Comedia del arte dans lequel il se produit. Motif invoqu\u00e9 : jouer avec un masque est un affront insupportable \u00e0 sa beaut\u00e9 et \u00e0 son talent ; il ne pourra jamais devenir une star en jouant masqu\u00e9.\n \nMais le fils aime ce qu\u2019il fait. Et m\u00eame, il y excelle\u2026 Suivant le fil d\u2019une enqu\u00eate, se succ\u00e9deront p\u00e8le m\u00eale sur sc\u00e8ne : 2 policiers belges, un r\u00e9gisseur parisien patibulaire, un psychanalyste italien de renom, un directeur de casting de pacotille, un chef de troupe aux accents r\u00e9volutionnaires, un performer d\u2019art contemporain, un com\u00e9dien obs\u00e9d\u00e9 par son image\u2026 ET une m\u00e8re pr\u00eate \u00e0 tout par \u00ab amour \u00bb, m\u00eame \u00e0 revendiquer le succ\u00e8s et la course effr\u00e9n\u00e9e \u00e0 la r\u00e9ussite pour maquiller ses propres \u00e9checs\u2026\n__________\n\nDe Fabio Zenoni \/ Mise en sc\u00e8ne et direction d\u2019acteur : Damien Bricoteaux, Thibaut N\u00e8ve et Thibault Packeu \/ Avec : Fabio Zenoni \/ Lumi\u00e8re : Martin Delval \/ Sc\u00e9nographie et masque : Stefano Perocco di Meduna\n","performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/retrouvailles-ete-2024","email":null,"phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50011600"},"sp":{"name":"Sortie de secours","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/retrouvailles-ete-2024","email":null,"phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50011600"},"nl":{"name":"Sortie de secours","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/retrouvailles-ete-2024","email":null,"phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50011600"}},"place":{"id":224476,"translations":{"de":{"name":"Th\u00e9\u00e2tre Le Public","address_street_name":"Rue Braemt","address_street_number":"64 70","address_street_box":null,"email":"contact@theatrelepublic.be","website":"http:\/\/www.theatrelepublic.be","phone_contact":"+32 2 724 24 44","phone_booking":"+32 2 724 24 44","address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Braemt, 64 70","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Th\u00e9\u00e2tre Le Public","address_street_name":"Rue Braemt","address_street_number":"64 70","address_street_box":null,"email":"contact@theatrelepublic.be","website":"http:\/\/www.theatrelepublic.be","phone_contact":"+32 2 724 24 44","phone_booking":"+32 2 724 24 44","address_zip