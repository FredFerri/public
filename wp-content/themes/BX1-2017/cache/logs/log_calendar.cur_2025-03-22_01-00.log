ays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2025-03-21T12:52:44+01:00","published_at":"2025-01-21T10:24:44+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":316602,"facebook_link":null,"import_origin":null,"is_part_of":"Art Deco 2025","sub_type":"other","ranking":0.35688292775180414,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exposici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[40,36],"translations":{"de":["Grafische K\u00fcnste","Museen & Kunstzentren"],"pt":[null,null],"en":["Graphic art","Museums and art centers"],"it":["Arti grafiche","Musei e centri artistici"],"cn":[null,null],"fr":["Arts graphiques","Mus\u00e9es et art centers"],"sp":["Artes gr\u00e1ficas","Museos y centros de arte"],"nl":["Grafische kunst, vormgeving","Musea en kunstcentra"]}}},"translations":{"de":{"name":"Expo 'Les Ma\u00eetres de l'Affiche'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.rouge-cloitre.be","email":"info@rouge-cloitre.be","phone_contact":"+32 2 660 55 91","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700005675"},"pt":{"name":"Expo 'Les Ma\u00eetres de l'Affiche'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.rouge-cloitre.be","email":"info@rouge-cloitre.be","phone_contact":"+32 2 660 55 91","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700005675"},"en":{"name":"Les Ma\u00eetres de l'Affiche","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.rouge-cloitre.be","email":"info@rouge-cloitre.be","phone_contact":"+32 2 660 55 91","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700005675"},"it":{"name":"Expo 'Les Ma\u00eetres de l'Affiche'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.rouge-cloitre.be","email":"info@rouge-cloitre.be","phone_contact":"+32 2 660 55 91","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700005675"},"cn":{"name":"Expo 'Les Ma\u00eetres de l'Affiche'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.rouge-cloitre.be","email":"info@rouge-cloitre.be","phone_contact":"+32 2 660 55 91","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700005675"},"fr":{"name":"Les Ma\u00eetres de l'Affiche","shortdescr":"\u00ab\u202fLes Ma\u00eetres de l\u2019Affiche\u202f\u00bb fut publi\u00e9e par l\u2019imprimerie Chaix \u00e0 Paris de d\u00e9cembre 1895 \u00e0 novembre 1900, sous la direction de Jules Ch\u00e9ret, lithographe, peintre et affichiste fran\u00e7ais de renom. Mensuellement, les abonn\u00e9s \u00e0 cette publication recevaient une s\u00e9lection d\u2019affiches des artistes les plus reconnus dans leur domaine. ","longdescr":"\u00ab\u202fLes Ma\u00eetres de l\u2019Affiche\u202f\u00bb fut publi\u00e9e par l\u2019imprimerie Chaix \u00e0 Paris de d\u00e9cembre 1895 \u00e0 novembre 1900, sous la direction de Jules Ch\u00e9ret, lithographe, peintre et affichiste fran\u00e7ais de renom. Mensuellement, les abonn\u00e9s \u00e0 cette publication recevaient une s\u00e9lection d\u2019affiches des artistes les plus reconnus dans leur domaine : Alphonse Mucha, Henri de Toulouse-Lautrec, Th\u00e9ophile-Alexandre Steinlen, Bonnard, Forain, Eug\u00e8ne Grasset, Georges Meunier, Louis Rhead, Dudley Hardy, etc. Les travaux de Jules Ch\u00e9ret lui-m\u00eame y \u00e9taient pr\u00e9sent\u00e9s en grand nombre. \nCe travail de publication p\u00e9riodique est r\u00e9alis\u00e9 durant \u201cLa Belle \u00c9poque\u201d, l\u2019\u00e2ge d\u2019or de la publicit\u00e9 en France qui d\u00e9bute \u00e0 la fin du 19\u00e8me si\u00e8cle. \u00c0 cette p\u00e9riode, les rues des grandes villes sont remplies de ce nouveau support visuel. L\u2019engouement des collectionneurs pour cet objet \u00e0 la fonction initiale transgress\u00e9e se manifeste progressivement. De support publicitaire, il passe au statut d\u2019objet d\u2019art en rejoignant le rang des collections. \nL\u2019art de l\u2019affiche est n\u00e9, et la lithographie se r\u00e9v\u00e8le comme une technique ad\u00e9quate \u00e0 ce double usage puisqu\u2019elle permet la cr\u00e9ation et la reproduction \u00e0 de multiples exemplaires d'un trac\u00e9 ex\u00e9cut\u00e9 \u00e0 l'encre ou au crayon. La chromolithographie repoussera ensuite les limites du proc\u00e9d\u00e9 en y ajoutant la couleur. \nCependant, collectionner des lithographies et chromolithographies originales consiste essentiellement \u00e0 conserver celles-ci \u00e0 plat ou enroul\u00e9es. Alors, comment jouir d\u2019une collection sous cette forme\u202f? C\u2019est en ce sens que la publication \u00ab\u202fLes Ma\u00eetres de l\u2019Affiche\u202f\u00bb voit le jour, permettant au public de d\u00e9couvrir et collectionner sous une forme accessible une s\u00e9lection d\u2019affiches tr\u00e8s appr\u00e9ci\u00e9es. L\u2019imprimerie Chaix joua un r\u00f4le important dans la popularisation de ce nouvel objet d\u2019art, ainsi que dans le suivi du mouvement artistique dans son ensemble. \nCes affiches, publi\u00e9es sous forme de planches il y a plus d\u2019un si\u00e8cle sont d\u00e9sormais tr\u00e8s rares. Dans cette exposition, vous en d\u00e9couvrirez une s\u00e9lection, issue d\u2019une collection belge priv\u00e9e. \nParmi les affichistes de cette s\u00e9lection\u202f: Jules Ch\u00e9ret, Lucien Lef\u00e8vre, ou encore Privat-Livemont. C'est \u00e0 ce dernier, artiste belge, parmi les repr\u00e9sentants majeurs de l\u2019affiche Art Nouveau, que nous devons l\u2019affiche \u201cAbsinthe Robette\u201d. \nL\u2019exposition \u00ab\u202fLes Ma\u00eetres de l\u2019Affiche\u202f\u00bb est r\u00e9alis\u00e9e en collaboration avec Explore.Brussels dans le cadre du Brussels Art Nouveau & Art Deco (BANAD) Festival 2025. ","performers":null,"boxoffice_url":null,"website":"http:\/\/www.rouge-cloitre.be","email":"info@rouge-cloitre.be","phone_contact":"+32 2 660 55 91","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700005675"},"sp":{"name":"Expo 'Les Ma\u00eetres de l'Affiche'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.rouge-cloitre.be","email":"info@rouge-cloitre.be","phone_contact":"+32 2 660 55 91","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700005675"},"nl":{"name":"Les Ma\u00eetres de l'Affiche","shortdescr":"'Les Ma\u00eetres de l\u2019Affiche' werd uitgegeven door drukkerij Chaix in Parijs, van december 1895 tot november 1900, onder leiding van Jules Ch\u00e9ret, een gerenommeerde Franse lithograaf, schilder en affichekunstenaar. De abonnees van de uitgave ontvingen maandelijks een selectie affiches van de meest erkende kunstenaars in hun vakgebied.","longdescr":"'Les Ma\u00eetres de l\u2019Affiche' werd uitgegeven door drukkerij Chaix in Parijs, van december 1895 tot november 1900, onder leiding van Jules Ch\u00e9ret, een gerenommeerde Franse lithograaf, schilder en affichekunstenaar. De abonnees van de uitgave ontvingen maandelijks een selectie affiches van de meest erkende kunstenaars in hun vakgebied: Alphonse Mucha, Henri de Toulouse-Lautrec, Th\u00e9ophile-Alexandre Steinlen, Bonnard, Forain, Eug\u00e8ne Grasset, Georges Meunier, Louis Rhead, Dudley Hardy enzovoort. Ook het werk van Jules Ch\u00e9ret zelf was ruim vertegenwoordigd. \nDe werken werden gepubliceerd tijdens 'La Belle \u00c9poque', het gouden tijdperk van de reclame in Frankrijk, dat begon aan het einde van de 19e eeuw. In die tijd waren de straten van grote steden gekleurd met de nieuwe visuele media. Gaandeweg groeide de interesse van verzamelaars voor dit object, en de oorspronkelijke reclamefunctie werd steeds meer overstegen. De affiche veranderde van reclamedrager tot kunstobject dat ook een plaats kreeg in collecties. De affichekunst was geboren. Lithografie bleek een geschikte techniek voor het tweeledige doel, omdat het zowel de creatie als reproductie van een tekening in inkt of potlood in meerdere exemplaren mogelijk maakte.  Chromolithografie verlegde vervolgens de grenzen van het proces door er ook kleur aan toe te voegen.\nHet verzamelen van originele lithografie\u00ebn en chromolithografie\u00ebn betekende in wezen dat ze plat of opgerold bewaard moesten worden. Hoe kon men dan van een verzameling genieten? Het antwoord daarop was de gloednieuwe publicatie 'Les Ma\u00eetres de l'Affiche' waarmee het grote publiek een selectie van geliefde affiches in een toegankelijke vorm kon ontdekken en verzamelen. Drukkerij Chaix speelde een belangrijke rol in de popularisering van het nieuwe kunstobject en in het documenteren van de artistieke beweging als geheel. \nDe affiches, die meer dan een eeuw geleden in plaatvorm uitgegeven werden, zijn tegenwoordig uiterst zeldzaam. In de tentoonstelling ontdek je een selectie van deze werken, afkomstig uit een Belgische priv\u00e9collectie. \nTot de affichekunstenaars in de selectie behoren onder andere Jules Ch\u00e9ret, Lucien Lef\u00e8vre en de Belgische kunstenaar Privat Livemont, een van de belangrijkste vertegenwoordigers van de Art Nouveau-affichekunst. Van zijn hand is de beroemde affiche 'Absinthe Robette'. \nDe tentoonstelling 'Les Ma\u00eetres de l\u2019Affiche' wordt georganiseerd in samenwerking met explore.brussels in het kader van het Brussels Art Nouveau & Art Deco (BANAD) Festival 2025. ","performers":null,"boxoffice_url":null,"website":"http:\/\/www.rouge-cloitre.be","email":"info@rouge-cloitre.be","phone_contact":"+32 2 660 55 91","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700005675"}},"place":{"id":1353,"translations":{"de":{"name":"Centre d'Art de Rouge-Clo\u00eetre","address_street_name":"Rue du Rouge-Clo\u00eetre","address_street_number":"4","address_street_box":null,"email":"info@rouge-cloitre.be","website":"http:\/\/www.rouge-cloitre.be","phone_contact":"+32 2 660 55 97","phone_booking":null,"address_zip":"1160","address_city":"Auderghem","address_line1":"Rue du Rouge-Clo\u00eetre, 4","address_line2":"1160 Auderghem","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Centre d'Art de Rouge-Clo\u00eetre","address_street_name":"Rue du Rouge-Clo\u00eetre","address_street_number":"4","address_street_box":null,"email":"info@rouge-cloitre.be","website":"http:\/\/www.rouge-cloitre.be","phone_contact":"+32 2 660 55 97","phone_booking":null,"address_zip":"1160","address_city":"Auderghem","address_line1":"Rue du Rouge-Clo\u00eetre, 4","address_line2":"1160 Auderghem","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Red Cloister Art Centre","address_street_name":"Rue du Rouge-Clo\u00eetre","address_street_number":"4","address_street_box":null,"email":"info@rouge-cloitre.be","website":"http:\/\/www.rouge-cloitre.be","phone_contact":"+32 2 660 55 97","phone_booking":null,"address_zip":"1160","address_city":"Auderghem","address_line1":"Rue du Rouge-Clo\u00eetre, 4","address_line2":"1160 Auderghem","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Centre d'Art de Rouge-Clo\u00eetre","address_str