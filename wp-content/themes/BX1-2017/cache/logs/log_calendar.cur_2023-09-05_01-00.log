sit":null},"sp":{"name":"Caf\u00e9 de La Rue","address_street_name":"Rue de la Colonne","address_street_number":"30","address_street_box":null,"email":"lecafedelarue@hotmail.com","website":"http:\/\/www.lecafedelarue.be","phone_contact":"+32 473 50 58 75","phone_booking":"+32 473 50 58 75","address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Rue de la Colonne, 30","address_line2":"1080 Molenbeek-Saint-Jean","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Caf\u00e9 de La Rue","address_street_name":"Kolomstraat","address_street_number":"30","address_street_box":null,"email":"lecafedelarue@hotmail.com","website":"http:\/\/www.lecafedelarue.be","phone_contact":"+32 473 50 58 75","phone_booking":"+32 473 50 58 75","address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Kolomstraat, 30","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"Brussel is een erfgoedparel rijker: sinds juli 2020 mag Caf\u00e9 de la Rue zich een geklasseerd Brussels monument noemen. En terecht: in deze piepkleine bruine kroeg in Laag-Molenbeek lijkt het alsof de tijd is blijven stilstaan. In het authentieke interieur vind je houten banken, een centrale kachel, een bord met de uitslagen van voetbalwedstrijden en andere originele decoratie. Alles ademt er geschiedenis uit. Sinds vzw Caf\u00e9 de La Rue er in 1980 zijn intrek nam, kan je er minstens een keer per maand naar een diner-spectacle. Reserveren is een must gezien het beperkte aantal plaatsen. Deze unieke plek, voor iedereen die houdt van een lekkere maaltijd gevolgd door een goed concert, viert dit jaar dus zijn 40ste verjaardag!\u202f ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":null,"facebook_id":"lecafedelaruebruxelles","region":"brussels","backoffice_id":1329,"location":{"lat":50.85347374,"lon":4.33537596},"last_updated_at":"2023-08-14T16:31:09+02:00","published_