r & Taxis wijk. Een atypische en warme plek bedoeld voor concerten, tentoonstellingen, filmvertoningen en conferenties en waar je ook priv\u00e9 evenementen kan organiseren. Het is een volledig uitgeruste, multidisciplinaire culturele ruimte met een oppervlakte van 150 m2, gewijd aan de \"schoonheid\" in al haar vormen. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":39109,"location":{"lat":50.86391031,"lon":4.34697026},"last_updated_at":"2024-07-30T15:45:30+02:00","published_at":"2022-07-15T20:19:31+02:00","is_in_address_book":true,"is_in_vb_export":false,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"poster","link":"https:\/\/agendabrussels2.imgix.net\/624656735feeeb02f7b8579e0836a69b59cc31db.jpeg","width":2141,"height":2126,"ratio":1.01,"oEmbed_height":2126,"oEmbed_width":2141,"translations":{"de":{"title":"Aes Duo","copyright":null},"pt":{"title":"Aes Duo","copyright":null},"en":{"title":"Aes Duo","copyright":null},"it":{"title":"Aes Duo","copyright":null},"cn":{"title":"Aes Duo","copyright":null},"fr":{"title":"Aes Duo","copyright":null},"sp":{"title":"Aes Duo","copyright":null},"nl":{"title":"Aes Duo","copyright":null}}}],"dates":[{"day":"2025-02-15","doors":"19:30:00","start":"20:00:00","end":"22:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"de":{"name":"Studierende"},"en":{"name":"Students"},"it":{"name":"Studenti"},"fr":{"name":"Etudiants"},"sp":{"name":"Estudiantes"},"nl":{"name":"Studenten"}},"value":8},{"translations":{"de":{"name":"Normal"},"en":{"name":"Normal"},"it":{"name":"Normale"},"fr":{"name":"Normal"},"sp":{"name":"Normal"},"nl":{"name":"Normaal"}},"value":17},{"translations":{"de":{"name":"Vorverkauf"},"en":{"name":"Presale"},"it":{"name":"Prevendita"},"fr":{"name":"Pr\u00e9vente"},"sp":{"name":"Preventa"},"nl":{"name":"Voorverkoop"}},"value":