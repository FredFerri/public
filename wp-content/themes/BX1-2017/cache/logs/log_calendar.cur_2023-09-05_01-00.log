dress_line1":"Rue des Thuyas, 12","address_line2":"1170 Watermael-Boitsfort","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Bruxelles Bavard","address_street_name":"Rue des Thuyas","address_street_number":"12","address_street_box":null,"email":"info@bruxellesbavard.be","website":"https:\/\/www.bruxellesbavard.be\/fr\/accueil","phone_contact":"+ 32 (0) 487 60 21 31","phone_booking":null,"address_zip":"1170","address_city":"Watermael-Boitsfort","address_line1":"Rue des Thuyas, 12","address_line2":"1170 Watermael-Boitsfort","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"fr":{"name":"Bruxelles Bavard","address_street_name":"Rue des Thuyas","address_street_number":"12","address_street_box":null,"email":"info@bruxellesbavard.be","website":"https:\/\/www.bruxellesbavard.be\/fr\/accueil","phone_contact":"+ 32 (0) 487 60 21 31","phone_booking":null,"address_zip":"1170","address_city":"Watermael-Boitsfort","address_line1":"Rue des Thuyas, 12","address_line2":"1170 Watermael-Boitsfort","description_web":"En compagnie d'un guide bavard, d\u00e9couvrez les multiples facettes de Bruxelles depuis 1983 : de la Grand Place aux quartiers Art Nouveau, du chocolat aux bi\u00e8res belges, de Bruegel \u00e0 la BD, go\u00fbtez toutes les saveurs de la belgitude. Des visites guid\u00e9es et animations originales, passionnantes et conviviales sont propos\u00e9es par cette ASBL. Par exemple, des rallyes, des balades sonores, des conf\u00e9rences en ligne... Pour les groupes et entreprises, des visites sur mesure sont propos\u00e9es.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Bruxelles Bavard","address_street_name":"Rue des Thuyas","address_street_number":"12","address_street_box":null,"email":"info@bruxellesbavard.be","website":"https:\/\/www.bruxellesbavard.be\/fr\/accueil","phone_contact":"+ 32 (0) 487 60 21 31","phone_booking":null,"address_zip":"1170","address_city":"Watermael-Boitsfort","address_line1":"Rue des Thuyas, 12","address_line2":"1170 Watermael-Boitsfort","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Brussel Babbelt","address_street_name":"Thujastraat","address_street_number":"12","address_street_box":null,"email":"info@brusselbabbelt.be","website":"https:\/\/www.bruxellesbavard.be\/nl\/home","phone_contact":"+ 32 (0) 487 60 21 31","phone_booking":null,"address_zip":"1170","address_city":"Watermael-Boitsfort","address_line1":"Thujastraat, 12","address_line2":"1170 Watermael-Boitsfort","description_web":"Ontdekken in het gezelschap van een praatgrage gids de vele facetten van Brussel sinds 1983: van de Grote Markt tot de Art Nouveau-wijken, van chocolade tot Belgische bieren, van Bruegel tot stripverhalen, proef alle smaken van het Belg-zijn. Originele, boeiende en vriendelijke rondleidingen en evenementen worden aangeboden door deze non-profit organisatie. Bijvoorbeeld, rally's, geluidswandelingen, online conferenties... Voor groepen en bedrijven worden rondleidingen op maat aangeboden.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":36947,"location":{"lat":50.80936777,"lon":4.40413914},"last_updated_at":"2022-10-10T10:25:09+02:00","published_at":"2021-07-23T15:01:51+02:00","is_in_address_book":false,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/dc057982f6d1c0e01557d9abd087e68b77ff7611.jpg","width":1500,"height":1003,"ratio":1,"oEmbed_height":1003,"oEmbed_width":1500,"translations":{"de":{"title":"Visite guid\u00e9e \u00e0 v\u00e9lo gratuite - Fresques BD \u00e0 Laeken, Jette & Molenbeek","copyright":null},"pt":{"title":"Visite guid\u00e9e \u00e0 v\u00e9lo gratu