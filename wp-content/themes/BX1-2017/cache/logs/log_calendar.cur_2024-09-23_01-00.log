an":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-09-22T02:01:50+02:00","published_at":"2024-07-23T15:02:18+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":304458,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.27327588325319846,"languages":{"spoken":["en","fr","nl"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[25,24],"translations":{"de":["Audiovisuelle K\u00fcnste","Kunstgalerien"],"pt":[null,null],"en":["Audiovisual art","Art Galleries"],"it":["Arti audiovisive","Gallerie d'arte"],"cn":[null,null],"fr":["Arts audiovisuels","Galeries d'art"],"sp":["Artes audiovisuales","Galer\u00edas de arte"],"nl":["Audiovisuele kunst","Galeries"]}}},"translations":{"de":{"name":"Peter Depelchin - Cosmogonical Treat","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.huskgallery.com","email":"info@huskgallery.com","phone_contact":"+32 478 52 16 46","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50012739"},"pt":{"name":"Peter Depelchin - Cosmogonical Treat","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.huskgallery.com","email":"info@huskgallery.com","phone_contact":"+32 478 52 16 46","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50012739"},"en":{"name":"Peter Depelchin - Cosmogonical Treat","shortdescr":"Husk Gallery is delighted to present 'Cosmogonical Treat', the third solo exhibition by Peter Depelchin  (\u00b01985, Ostend, lives and works in New York, US).","longdescr":"Peter Depelchin's new solo show 'Cosmogonical Treat' offers itself as an ouroboros (the ancient symbol of the snake biting its tail); without beginning nor end. However, as the title indicates, the expo is also a treat, specifically a treat of a cosmogony. A cosmogony is a model, a fit that serves as an explanation for the origin and development of the universe. Depelchin approaches his cosmogony from both a mythological perspective and an astrophysical one. In other words, the treat is a newly formulated origin story on the one hand and a suggestive visualization of the latest theories in relation to the origin and structure formation of our universe on the other.\n","performers":null,"boxoffice_url":null,"website":"https:\/\/www.huskgallery.com","email":"info@huskgallery.com","phone_contact":"+32 478 52 16 46","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50012739"},"it":{"name":"Peter Depelchin - Cosmogonical Treat","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.huskgallery.com","email":"info@huskgallery.com","phone_contact":"+32 478 52 16 46","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50012739"},"cn":{"name":"Peter Depelchin - Cosmogonical Treat","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.huskgallery.com","email":"info@huskgallery.com","phone_contact":"+32 478 52 16 46","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50012739"},"fr":{"name":"Peter Depelchin - Cosmogonical Treat","shortdescr":"Husk Gallery a le grand plaisir de pr\u00e9senter 'Cosmogonical Treat', la troisi\u00e8me exposition individuelle de Peter Depelchin (\u00b01985, Ostende, vit et travaille \u00e0 New York, USA).","longdescr":"'Cosmogonical Treat', la nouvelle expo individuelle de Peter Depelchin se d\u00e9veloppe selon le concept de l\u2019ouroboros (ancien symbole du serpent qui se mord la queue) : sans commencement ni fin. Cependant, comme son titre l'indique, l'exposition est aussi une g\u00e2terie, un r\u00e9gal cosmogonique. Une cosmogonie est un mod\u00e8le, une th\u00e9orie qui sert \u00e0 expliquer l'origine et le d\u00e9veloppement de l'univers. Depelchin aborde sa cosmogonie \u00e0 la fois d'un point de vue mythologique et d'un point de vue astrophysique. En d'autres termes, il s'agit, d'une part, d'un r\u00e9cit des origines nouvellement formul\u00e9 et, d'autre part, d'une visualisation \u00e9vocatrice des derni\u00e8res th\u00e9ories relatives \u00e0 l'origine et \u00e0 la formation de la structure de notre univers. ","performers":null,"boxoffice_url":null,"website":"https:\/\/www.huskgallery.com","email":"info@huskgallery.com","phone_contact":"+32 478 52 16 46","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50012739"},"sp":{"name":"Peter Depelchin - Cosmogonical Treat","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.huskgallery.com","email":"info@huskgallery.com","phone_contact":"+32 478 52 16 46","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50012739"},"nl":{"name":"Peter Depelchin - Cosmogonical Treat","shortdescr":"Husk Gallery presenteert met groot genoegen 'Cosmogonical Treat', de derde soloshow van Peter Depelchin  (\u00b01985, Oostende, woont en werkt in New York, US).","longdescr":"Peter Depelchins nieuwe soloshow 'Cosmogonical Treat' biedt zich aan als een ouroboros (het eeuwenoude symbool van de slang die zich in de staart bijt); zonder begin noch einde. Zoals de titel aangeeft, is de expo echter ook een treat, m.n. een traktatie op een kosmogonie. Een kosmogonie is een model, een pasvorm die dient als verklaring voor het ontstaan en de ontwikkeling van het universum. Depelchin benadert zijn kosmogonie zowel vanuit een mythologisch perspectief als vanuit een astrofysisch perspectief. De traktatie is met andere woorden een nieuw geformuleerd oorsprongsverhaal enerzijds en een suggestieve visualisatie van de recentste theorie\u00ebn in relatie tot het ontstaan en de structuurvorming van ons heelal anderzijds. ","performers":null,"boxoffice_url":null,"website":"https:\/\/www.huskgallery.com","email":"info@huskgallery.com","phone_contact":"+32 478 52 16 46","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50012739"}},"place":{"id":273385,"translations":{"de":{"name":"Husk Gallery","address_street_name":"Waterloosesteenweg ","address_street_number":"690","address_street_box":"12","email":"info@huskgallery.com","website":"http:\/\/www.huskgallery.com","phone_contact":"+32 478 52 16 46","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Waterloosesteenweg , 690 \/ 12","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Husk Gallery","address_street_name":"Waterloosesteenweg ","address_street_number":"690","address_street_box":"12","email":"info@huskgallery.com","website":"http:\/\/www.huskgallery.com","phone_contact":"+32 478 52 16 46","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Waterloosesteenweg , 690 \/ 12","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Husk Gallery","address_street_name":"Waterloosesteenweg ","address_street_number":"690","address_street_box":"12","email":"info@huskgallery.com","website":"http:\/\/www.huskgallery.com","phone_contact":"+32 478 52 16 46","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Waterloosesteenweg , 690 \/ 12","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_