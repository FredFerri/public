e,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":312641,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"misc","ranking":1.2599210498948732,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":84,"translations":{"de":"Verschiedenes","pt":null,"en":"Various","it":"Varie","cn":null,"fr":"Divers","sp":"Varios","nl":"Varia"}},"others":{"list":[260],"translations":{"de":["Conversations with authors"],"pt":[null],"en":["Conversations with authors"],"it":["Conversations with authors"],"cn":[null],"fr":["Rencontres"],"sp":["Conversations with authors"],"nl":["Meet-and-greets"]}}},"translations":{"de":{"name":"Ganshoren au fil des saisons : RDV avec l'hiver","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lavillaculture.be\/ganshoren-au-fil-des-saisons-rdv-avec-lhiver\/","email":"info@lavillaculture.be","phone_contact":"+32 2 420 37 27","phone_booking":"+32 2 420 37 27","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700003981"},"pt":{"name":"Ganshoren au fil des saisons : RDV avec l'hiver","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lavillaculture.be\/ganshoren-au-fil-des-saisons-rdv-avec-lhiver\/","email":"info@lavillaculture.be","phone_contact":"+32 2 420 37 27","phone_booking":"+32 2 420 37 27","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700003981"},"en":{"name":"Ganshoren au fil des saisons : RDV avec l'hiver","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lavillaculture.be\/ganshoren-au-fil-des-saisons-rdv-avec-lhiver\/","email":"info@lavillaculture.be","phone_contact":"+32 2 420 37 27","phone_booking":"+32 2 420 37 27","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700003981"},"it":{"name":"Ganshoren au fil des saisons : RDV avec l'hiver","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lavillaculture.be\/ganshoren-au-fil-des-saisons-rdv-avec-lhiver\/","email":"info@lavillaculture.be","phone_contact":"+32 2 420 37 27","phone_booking":"+32 2 420 37 27","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700003981"},"cn":{"name":"Ganshoren au fil des saisons : RDV avec l'hiver","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lavillaculture.be\/ganshoren-au-fil-des-saisons-rdv-avec-lhiver\/","email":"info@lavillaculture.be","phone_contact":"+32 2 420 37 27","phone_booking":"+32 2 420 37 27","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700003981"},"fr":{"name":"Ganshoren au fil des saisons : RDV avec l'hiver","shortdescr":"Ganshoren au fil des saisons est de retour pour une nouvelle ann\u00e9e riche en d\u00e9couvertes, animations, ateliers, rencontres\u2026, pour visibiliser les associations et initiatives locales mais aussi mettre en lumi\u00e8re des alternatives qui prennent soin de la nature et qui sont accessibles \u00e0 toustes !","longdescr":"Programme de l\u2019apr\u00e8s-midi : 13h \u00e0 18h\n\n13h : Pr\u00e9sentation sur les strat\u00e9gies d\u2019adaptation de la faune et de la flore en hiver ;\n\nEn cas de beau temps : 13h Taille du cassissier et\/ou groseiller (au jardin des aromatiques) et \u00e0 14h30 taille des framboisier (\u00e0 La Villa) et bouturage de petits fruitiers ;\n\nEn cas de mauvais temps : 13h : Animation et identification des petits fruitiers (au jardin des aromatiques) et \u00e0 14h30 atelier sur la taille des petits fruitiers (\u00e0 La Villa);\n\nD\u00e8s 14h30 : Taille des framboisiers le long de La Villa et bouturage de petits fruitiers;\n\n14h \u00e0 17h : Un atelier peinture sur courges et de peinture sur nichoirs ;\n\n14h : Balade d\u2019identification des arbres par les rameaux ; \n\n14h \u2013 17h : Un atelier de r\u00e9flexion et d\u2019\u00e9change autour du cycle de l\u2019eau et de la restauration des ruisseaux (EGEB);\n\n16h : Une lecture Kamishiba\u00ef pour famille avec Eug\u00e9nie Don, conteuse et com\u00e9dienne, en duo avec Almamy Barry, conteur;\n\n17h : Chocolat chaud aromatis\u00e9 offert (cannelle et badiane).\n\nGratuit\n\nInfos et r\u00e9servations au 02 420 37 27 - info@lavillaculture.be","performers":"En collaboration avec le Jardin des aromatiques - Clos Wagner, le Projet Quartier Marelles, la P\u00e9pini\u00e8re citoyenne, le service d\u00e9veloppement durable de la commune de Ganshoren, la Maison M\u00e9dicale Calendula, la Maison des jeunes MJ83, le Groupe Moineaux 1083, l\u2019asbl Pleine Terre, Les EGEB et le CSA THEO : Grooteiland","boxoffice_url":null,"website":"https:\/\/lavillaculture.be\/ganshoren-au-fil-des-saisons-rdv-avec-lhiver\/","email":"info@lavillaculture.be","phone_contact":"+32 2 420 37 27","phone_booking":"+32 2 420 37 27","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700003981"},"sp":{"name":"Ganshoren au fil des saisons : RDV avec l'hiver","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lavillaculture.be\/ganshoren-au-fil-des-saisons-rdv-avec-lhiver\/","email":"info@lavillaculture.be","phone_contact":"+32 2 420 37 27","phone_booking":"+32 2 420 37 27","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700003981"},"nl":{"name":"Ganshoren au fil des saisons : RDV avec l'hiver","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lavillaculture.be\/ganshoren-au-fil-des-saisons-rdv-avec-lhiver\/","email":"info@lavillaculture.be","phone_contact":"+32 2 420 37 27","phone_booking":"+32 2 420 37 27","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700003981"}},"place":{"id":220064,"translations":{"de":{"name":"Centre Culturel Ganshoren La Villa","address_street_name":"Place Guido Gezelle","addr