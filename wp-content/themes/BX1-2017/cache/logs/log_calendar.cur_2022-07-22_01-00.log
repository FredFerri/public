e9e vous ouvre gratuitement ses portes chaque premier dimanche du mois.\r\nA 14h, notre guide vous emm\u00e8ne \u00e0 la d\u00e9couverte de l\u2019exposition Kidorama, 200 ans de mode enfantine.\r\nLa r\u00e9servation pour la visite guid\u00e9e est obligatoire via notre site web","boxoffice_url":null,"website":"http:\/\/www.museemodeetdentelle.brussels","email":"musea@brucity.be","phone_contact":null,"phone_booking":"+32 2 213 44 50","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/537130.html"},"nl":{"name":"Kidorama: eerste zondag van de maand","shortdescr":"Elke eerste zondag van de maand opent het museum gratis de deuren.","longdescr":null,"performers":"Elke eerste zondag van de maand opent het museum gratis de deuren.\r\nOm 15.30 uur neemt onze gids u mee voor een rondleiding door de tentoonstelling Kidorama, 200 jaar kindermode\r\nDe reservering voor de rondleiding is aanbevolen via ons website.","boxoffice_url":null,"website":"http:\/\/www.fashionandlacemuseum.brussels\/nl","email":"musea@brucity.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/537130.html"},"en":{"name":"Kidorama : premier dimanche du mois","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/537130.html"},"de":{"name":"Kidorama : premier dimanche du mois","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/537130.html"},"it":{"name":"Kidorama : premier dimanche du mois","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/537130.html"},"sp":{"name":"Kidorama : premier dimanche du mois","shortd