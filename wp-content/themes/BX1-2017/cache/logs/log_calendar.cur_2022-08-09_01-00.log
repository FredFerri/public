 peu \u00e0 peu en sc\u00e8ne de th\u00e9\u00e2tre, ils vont travailler Shakespeare et un monologue d\u2019Hamlet, le ma\u00eetre poussant l\u2019\u00e9l\u00e8ve dans ses ultimes retranchements, au c\u0153ur des secrets du m\u00e9tier. Sous le couvert du rire, cette com\u00e9die humaine et attachante est une le\u00e7on de th\u00e9\u00e2tre et de vie.\r\n\r\nTARIF \r\nPR\u00c9VENTE jusqu\u2019au 31.07 \u20ac 19 \/ VENTE \u00e0pd 01.08 \u20ac 22 ABO ADULTE-WSL -SENIOR 17\u20ac","performers":"DE Xavier Durringer MISE EN SC\u00c8NE Alexis Goslain AVEC Bernard Sens, Gauthier Bourgeois, Alexis Goslain COSTUMES Maria Spada MONTAGE SONORE Laurent Beumier PRODUCTION Le Royal Festival de Spa, So Once Upon A Time asbl (SO OUAT)","boxoffice_url":null,"website":"https:\/\/www.wolubilis.be\/a-voir\/acting\/","email":null,"phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/537227.html"},"nl":{"name":"Spectacle d'\u00e9t\u00e9: Acting","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/537227.html"},"en":{"name":"Spectacle d'\u00e9t\u00e9: Acting","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/537227.html"},"de":{"name":"Spectacle d'\u00e9t\u00e9: Acting","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/537227.html"},"it":{"name":"Spectacle d'\u00e9t\u00e9: Acting","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/537227.html"}