Etudiants"},"pt":{"name":"Etudiants"},"cn":{"name":"Etudiants"}},"value":11.7},{"translations":{"fr":{"name":"Enfants"},"nl":{"name":"Kinderen"},"en":{"name":"Children"},"de":{"name":"Kinder"},"it":{"name":"Enfants"},"sp":{"name":"Enfants"},"pt":{"name":"Enfants"},"cn":{"name":"Enfants"}},"value":9.4},{"translations":{"fr":{"name":"Article 27"},"nl":{"name":"Artikel 27"},"en":{"name":"Article 27"},"de":{"name":"Article 27"},"it":{"name":"Article 27"},"sp":{"name":"Article 27"},"pt":{"name":"Article 27"},"cn":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":{"list":[255,265,266],"translations":{"fr":["Accessible","WC adapt\u00e9","Brussels Health Safety Label"],"nl":["Toegankelijk","Aangepast toilet","Brussels Health Safety Label"],"en":["Accessible","Adapted toilet","Brussels Health Safety Label"],"de":["Barrierefrei","Barrierefreies WC","Brussels Health Safety Label"],"it":[null,null,null],"sp":[null,null,null],"pt":[null,null,null],"cn":[null,null,null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-11-28T01:07:29+01:00","published_at":"2022-08-10T17:03:17+02:00","backoffice_id":259487,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":0.20302243466468},{"id":541835,"date_start":"2022-09-18","date_end":"2023-06-18","date_next":"2023-01-08","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert","de":"Konzert","it":null,"sp":null,"pt":null,"cn":null}},"others":{"list":[2],"translations":{"fr":["Classique"],"nl":["Klassiek"],"en":["Classical"],"de":["Klassisch"],"it":[null],"sp":[null],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Nouvelle Saison 2022-2023  Concerts Escapades","shortdescr":"Apr\u00e8s un petit repos estival, nous avons finalis\u00e9 durant l\u2019\u00e9t\u00e9 le programme de la nouvelle saison jusqu\u2019en Juin 2023: \r\nEn septembre, nouvelle salle, nouveau d\u00e9cor, nouvelle saison \u201cEscapades\u201d \u00e0 la Tricoterie.  \r\nLa Tricoterie, l\u2019endroit Saint-Gillois o\u00f9 l\u2019on fabrique des liens sera notre nouveau repaire pour vous pr\u00e9senter neuf concerts de septembre \u00e0 juin.","longdescr":"Concerts Escapades est une r\u00e9gie du CRIT de l\u2019ASBL l\u2019\u00c9quipe qui organise des concerts de musique classique, en collaboration avec \u201cMusic Project For Brussels\u201d et la prison de Forest.\r\n- Le 18 septembre \u00e0 20H30, le premier concert, Lubimov+, nom de l\u2019exceptionnel pianiste russe qui a poursuivi son jeu malgr\u00e9 la police lors d\u2019un concert \u00e0 Moscou le 13 avril dernier. Il nous jouera sans a priori des pi\u00e8ces de Silvestrov compositeur ukrainien, Arvo Part l\u2019estonien, Schubert et Haydn les autrichiens. \r\nNous continuerons avec Joy+ le 16 octobre, avec Yu Sheng Jiang, formant un groupe de jazz avec deux autres acolytes ainsi que le quatuor \u00e0 cordes portugais Quiron.\r\n- Le 13 novembre, Belgo+, place aux compositeurs belges Lekeu et Ysaye. \r\nEnfin, le 11 d\u00e9cembre, le concert O+, qui console l\u2019\u00e2me, chasse la m\u00e9lancolie par le rem\u00e8de du oud, du th\u00e9orbe et luth avec Sofie Vanden Eynde et Saad Mahmoud Jawad.\r\n- En 2023, nous commen\u00e7ons l'ann\u00e9e avec le concert de Silvestrov+. \r\nConcert classique o\u00f9 la po\u00e9sie s\u2019invite, sublim\u00e9e par la voix de Viktoria Vitrenko et le talent du pianiste d\u2019Alexei Lubimov. Concert SILVESTROV+ le 19 janvier \u00e0 20h30 \u00e0 la Tricoterie.\r\n- En Fevrier, mois de la f\u00eate des amoureux oblige, concert AMOR XXX se d\u00e9roulera le dimanche 12 f\u00e9vrier \u00e0 20h30 \u00e0 la Tricoterie. Entrez dans le jeu amoureux au temps des grandes cours europ\u00e9ennes. Rev\u00eatez vos plus beaux atours, \u00e9veillez vos sens et laissez-vous charmer par la volupt\u00e9 de IRIS ENSEMBLE et par la puret\u00e9 de la voix de Soetkin ELBERS. Musique baroque au programme.","performers":"Concert BELGO+ : Kristie Su (violon), Yu-Fen Chang 13 nov\r\nConcert \u00d4+ : Sofie Vanden Eynde (lute,theorbe) Saad Mahmood Jawad (oud), 11 dec\r\nConcert SILVESTROV+: Alexei Lubimov (piano), Viktoria Vitrenko (soprano). jeudi 19 janvier 2023 \u00e0 20H30\r\nConcert AMOR XXX ; Iris Ensemble (quintet), Soetkin Elbers (soprano). 12 f\u00e9vrier \u00e0 20h30.","boxoffice_url":null,"website":"https:\/\/shop.utick.be\/?module=ACTIVITYSERIEDETAILS&pos=LATRICOTERIE&s=DD20E1CA-2A64-C646-56FF-A1B47677F609&fbclid=IwAR1U9Awy7uRFFfb2tw18zsy4kpAs2yCyrb9bTpRBtS8ARcunywQNwYCgeQI","email":"crit.escapade@gmail.com","phone_contact":"+32 2 537 96 69","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.541835"},"nl":{"name":"Nieuw seizoen 2022-2023 Concerts Escapades","shortdescr":"Na een korte zomerstop hebben we het programma tot juni van het nieuwe seizoen afgerond: \r\nIn september, nieuwe zaal, nieuw scene, een nieuw seizoen \u201cEscapades\u201d bij La Tricoterie.  \r\nLa Tricoterie, de plaats in Sint-Gillis waar verbinding gebeurt, wordt onze nieuwe ontmoetingsplaats om van september tot juni negen concerten voor te stellen.","longdescr":"Concerts Escapades is een concertmanagement van het CRIT van de VZW l'\u00c9quipe dat klassieke muziekconcerten organiseert in samenwerking met \"Music Project For Brussels\" en de gevangenis van Vorst.\r\n- Op 18 december om 20.30 uur is het eerste concert, Lubimov+, genoemd naar de uitzonderlijke Russische pianist die ondanks de politie doorging met spelen tijdens een concert in Moskou op 13 april. Hij zal stukken spelen van de Oekra\u00efense componist Silvestrov, de Estse Arvo Part, de \u2018Oostenrijkers\u2019 Schubert en Haydn.\r\nWe gaan verder met Joy+ op 16 oktober, met Yusheng Jiang, die met twee acolieten een jazztrio vormt , en het Portugese strijkkwartet Quiron.\r\n- Op 13 november staan de Belgische componisten Lekeu en Ysaye op het programma van Belgo+. \r\n- Op 11 december ten slotte, het O+ concert, dat de ziel troost en de melancholie verdrijft met de remedie van de oud, de theorbe en de luit met Sofie Vanden Eynde en Saad Mahmoud Jawad.\r\n- In 2023 beginnen we het jaar met het Silvestrov+ concert. Een piano en zangconcert met po\u00ebzie, versterkt door de stem van Viktoria Vitrenko en het talent van pianist Alexei Lubimov. Concert Silvestrov+ op 19 januari om 20.30 uur in de Tricoterie.\r\n- In februari, de maand van de geliefden, zal het Amor XXX concert op zondag 12 februari om 20u30 in de Tricoterie plaatsvinden.  Wees uw meest verleidelijke zelf, wakker uw zintuigen aan en laat u charmeren door de klankvolheid van het Iris Ensemble en de zuivere stem van Soetkin Elbers. Barokmuziek op het programma.","performers":"Concert BELGO+ : Kristie Su (violon), Yu-Fen Chang. 13 nov\r\nConcert \u00d4+ : Sofie Vanden Eynde (lute,theorbe) Saad Mahmood Jawad (oud). 11 dec\r\nConcert SILVESTROV+: Alexei Lubimov (piano), Viktoria Vitrenko (soprano). donderdag 19 januari\r\n 2023.\r\nConcert AMOR XXX ; Iris Ensemble (quintet), Soetkin Elbers (soprano). Zondag 12 februari om 20:30","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.541835"},"en":{"name":"New Season 2022-2023 Concerts Escapades","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.541835"},"de":{"name":"Nouvelle Saison 2022_2023  Concerts Escapades","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.541835"},"it":{"name":"Nouvelle Saison 2022_2023  Concerts Escapades","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.541835"},"sp":{"name":"Nouvelle Saison 2022_2023  Concerts Escapades","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.541835"},"pt":{"name":"Nouvelle Saison 2022_2023  Concerts Escapades","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.541835"},"cn":{"name":"Nouvelle Saison 2022_2023  Concerts Escapades","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.541835"}},"place":{"id":252101,"translations":{"fr":{"name":"La Tricoterie - Fabrique de liens","address_street_name":"Rue Th\u00e9odore Verhaegen","address_street_number":"158","address_street_box":null,"email":"charlotte@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+32 2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue Th\u00e9odore Verhaegen, 158","address_line2":"1060 Saint-Gilles","description_web":"La Tricoterie se d\u00e9finit comme un lieu pluridisciplinaire avec 4 axes d'activit\u00e9s: l'\u00e9v\u00e9nementiel, le culturel, la formation et les initiatives \u00abcitoyennes \u00bb. Les activit\u00e9s sont de deux types. D'une part, les productions propres, qui constituent la saison, avec la programmation d'artistes associ\u00e9s, un march\u00e9 bio, des soir\u00e9es th\u00e9matiques ou encore des animations de quartier. D'autre part, le lieu est un outil mis \u00e0 disposition d'organisations externes et d'entreprises. Une foule de f\u00eates tr\u00e8s int\u00e9ressantes y ont lieu ! ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"La Tricoterie - Contactenfabriek","address_street_name":"Th\u00e9odore Verhaegenstraat","address_street_number":"158","address_street_box":null,"email":"charlotte@tricoterie.be","website":"http:\/\/www.tricoterie.be","phone_contact":"+32 2 537 96 69","phone_booking":null,"address_zip":"1060","address_city":"Sint-Gillis","address_line1":"Th\u00e9odore Verhaegenstraat, 158","address_line2":"1060 Sint-Gillis","description_web":"La Tricoterie is een project met een welomlijnde filosofie, die blijkt uit de zelfgekozen naam (van tricoter, breien) waarmee verwijst wordt naar het smeden van banden om de strijd tegen de ontrafeling van het sociale weefsel aan te gaan. Opgezet als een \u00abContacten Fabriek\u00bb en een ontmoetingsplaats waar verschillende disciplines en publieken elkaar ontmoeten. Naast een culturele programmering (concerten, voorstellingen, expos\u2026) en socioculturele activiteiten die sociale cohesie beogen (debatten, conferenties, intergenerationele ateliers, caf\u00e9-filo\u2026) staan de ruimtes ook open voor verhuur aan externe organisaties en bedrijven. Tal van superleuke feestjes vinden er plaats, alsook een wekelijkse biomarkt, een repaircaf\u00e9 en een alternatieve geschenkenmarkt om maar enkele van de activiteiten te noemen die de duurzame levensvisie van de plek weerspiegelen.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"La Tricoterie - Link factory","addr