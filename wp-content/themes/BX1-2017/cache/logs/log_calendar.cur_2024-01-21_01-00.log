:false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2023-07-14T16:30:26+02:00","published_at":"2023-07-06T12:10:21+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":281410,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"theatre","ranking":1.2599210498948732,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":49,"translations":{"de":"Theater","pt":null,"en":"Theatre","it":"Teatro","cn":null,"fr":"Th\u00e9\u00e2tre","sp":"Teatro","nl":"Theater"}},"others":{"list":[50],"translations":{"de":["Theater"],"pt":[null],"en":["Theatre"],"it":["Teatro"],"cn":[null],"fr":["Th\u00e9\u00e2tre"],"sp":["Teatro"],"nl":["Theater"]}}},"translations":{"de":{"name":"Notre Soleil","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wolubilis.be","email":"info@wolubilis.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.561410"},"pt":{"name":"Notre Soleil","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wolubilis.be","email":"info@wolubilis.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.561410"},"en":{"name":"Notre Soleil","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wolubilis.be","email":"info@wolubilis.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.561410"},"it":{"name":"Notre Soleil","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wolubilis.be","email":"info@wolubilis.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.561410"},"cn":{"name":"Notre Soleil","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wolubilis.be","email":"info@wolubilis.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.561410"},"fr":{"name":"Notre Soleil","shortdescr":"Spectacle T\u00e9moignage","longdescr":"Fran Kourouma, jeune Guin\u00e9en de 26 ans, a tout quitt\u00e9 dans l\u2019espoir d\u2019une vie meilleure. Avec des mots simples et poignants, il nous raconte son chemin de souffrance, de l\u2019enfer libyen \u00e0 la Belgique o\u00f9 il vit plusieurs mois dans la rue apr\u00e8s avoir \u00e9t\u00e9 au centre d\u2019accueil Fedasil, connu sous le nom de \u00ab Petit Ch\u00e2teau \u00bb. C\u2019est l\u00e0 qu\u2019il commence \u00e0 \u00e9crire son histoire, plus de 800 pages r\u00e9dig\u00e9es sur son t\u00e9l\u00e9phone portable. Gr\u00e2ce \u00e0 \u00ab la Plateforme Citoyenne \u00bb, il rencontre Sandra Raco, com\u00e9dienne et metteuse en sc\u00e8ne, qui l\u2019aide \u00e0 finaliser son r\u00e9cit et \u00e0 le faire publier. C\u2019est tout simplement qu\u2019elle am\u00e8ne Fran \u00e0 partager sa propre histoire et ses propres \u00e9motions sur sc\u00e8ne, pour redonner de l\u2019humanit\u00e9 \u00e0 cette migration qu\u2019on regarde souvent de loin. Sans \u00eatre politique, ce spectacle-t\u00e9moignage nous percute de plein fouet et remet l\u2019\u00eatre humain au vrai centre du d\u00e9bat ! Une v\u00e9rit\u00e9 qu\u2019on a rarement l\u2019occasion d\u2019entendre.\r\n\r\n\u00ab Ce texte veut rendre compte de mon exp\u00e9rience effroyable, bien \u00e9loign\u00e9e de ce qu\u2019on peut voir et entendre dans les m\u00e9dias occidentaux \u00bb (Fran Kourouma)\r\n\r\nUne rencontre facultative avec l\u2019artiste est pr\u00e9vue, en fin de spectacle, afin de favoriser un \u00e9change entre les spectateurs et lui.\r\n\r\nPRODUCTION Compagnie du Simorgh AIDE F\u00e9d\u00e9ration Wallonie Bruxelles, la Province du Brabant Wallon, le Centre Culturel Bruegel, Les Riches Claires, le BAMP, le Centre Culturel du Brabant Wallon, Le Th\u00e9\u00e2tre Jardin Passion, le Th\u00e9\u00e2tre Jean Vilar, le Cocq\u2019arts Festival, l\u2019Atelier R, le Collectif K.A.K, Globe Aroma, La Belle \u00c9quipe Productions, Com\u2019 des demoiselles, La Valette et le Th\u00e9\u00e2tre Royal des Galeries ","performers":"DE ET AVEC Fran Kourouma ADAPTATION ET MISE EN SC\u00c8NE Sandra Raco ASSITANTS MISE EN SC\u00c8NE Laure Chartier et Boris Olivier LA M\u00c8RE (VOIX OFF) Babetida Sadjo CR\u00c9ATION LUMI\u00c8RE J\u00e9r\u00f4me Dejean CR\u00c9ATION SON ET MUSIQUE Laurent Beumier D\u00c9COR Angela Castro AIDE \u00c0 LA SC\u00c9NOGRAPHIE L\u00e9a Gardin \u0152IL EXT\u00c9RIEUR Nathan Fourquet DubartIMAGE : Bartolomeo La Punzina ","boxoffice_url":null,"website":"http:\/\/www.wolubilis.be","email":"info@wolubilis.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.561410"},"sp":{"name":"Notre Soleil","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wolubilis.be","email":"info@wolubilis.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.561410"},"nl":{"name":"Notre Soleil","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.wolubilis.be\/a-voir\/notre-soleil\/","email":"info@wolubilis.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.561410"}},"place":{"id":243359,"translations":{"de":{"name":"Th\u00e9\u00e2tre Wolubilis","address_street_name":"Cours Paul-Henri Spaak","address_street_number":"1","address_street_box":null,"email":null,"website":"http:\/\/www.wolubilis.be"