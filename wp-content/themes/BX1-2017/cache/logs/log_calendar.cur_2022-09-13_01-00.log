eled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre"}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Acting","shortdescr":null,"longdescr":"\u201cGO TO THE FUCKING POINT\u201d\r\n\r\n \r\n\r\nDans une cellule de prison, Robert, acteur et metteur en sc\u00e8ne condamn\u00e9 pour meurtre, rejoint Gepetto, un petit escroc, et Horace, son myst\u00e9rieux cod\u00e9tenu muet et insomniaque. Fascin\u00e9 par les m\u00e9tamorphoses de l\u2019acteur et le glamour du grand \u00e9cran, Gepetto va demander \u00e0 son nouveau cod\u00e9tenu de lui apprendre le m\u00e9tier pour se fondre dans la peau d\u2019un autre. Entre bouffonneries et monologues shakespeariens, deux mondes et deux conceptions de l\u2019art vont se confronter dans ce huis clos carc\u00e9ral\u2026\r\n\r\n\u200b","performers":"De Xavier Durringer\r\n\r\nMise en sc\u00e8ne : Alexis Goslain\r\n\r\nAvec : Gauthier Bourgois, Alexis Goslain, Bernard Sens\r\n\r\nCostumes : Maria Spada\r\n\r\nMontage Sonore : Laurent Beumier\r\n\r\nSc\u00e9nographie : Michel Suppes\r\n\r\nUne co-production du Royal Festival de Spa et de SO OUAT asbl.","boxoffice_url":null,"website":"http:\/\/www.osamoelle.be","email":"Communication@osamoelle.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.538428"},"nl":{"name":"Acting","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.538428"},"en":{"name":"Acting","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\