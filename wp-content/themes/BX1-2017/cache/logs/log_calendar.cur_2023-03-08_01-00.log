n en didactische tentoonstellingen te combineren met evenementen en een radioprogramma, beoogt ze actuele vraagstukken bespreekbaar te maken. Het centrum, gevestigd in de Ateliers des Tanneurs op een bijzondere en polyvalente locatie, organiseert tentoonstellingen over actuele en geschiedkundige thema\u2019s met werk van zowel gevestigde fotografen als jonge talenten.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Geopolis","address_street_name":"Rue des Tanneurs","address_street_number":"58-60","address_street_box":null,"email":"contact@geopolis.brussels","website":"http:\/\/geopolis.brussels","phone_contact":"+32 485 32 85 90","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue des Tanneurs, 58-60","address_line2":"1000 Brussels","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"G\u00e9opolis","address_street_name":"Rue des Tanneurs","address_street_number":"58-60","address_street_box":null,"email":"contact@geopolis.brussels","website":"http:\/\/geopolis.brussels","phone_contact":"+32 485 32 85 90","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Tanneurs, 58-60","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"G\u00e9opolis","address_street_name":"Rue des Tanneurs","address_street_number":"58-60","address_street_box":null,"email":"contact@geopolis.brussels","website":"http:\/\/geopolis.brussels","phone_contact":"+32 485 32 85 90","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Tanneurs, 58-60","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"G\u00e9opolis","address_street_name":"Rue des Tanneurs","address_street_number":"58-