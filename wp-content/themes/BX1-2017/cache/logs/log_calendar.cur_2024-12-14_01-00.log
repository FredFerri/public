ondleidingen om u Brussel te laten ontdekken vanuit heel bijzondere en soms verrassende invalshoeken... Als gepassioneerde Brusselaars nemen ze je mee door de straten en steegjes van Brussel en tonen ze je de stad zoals zij die kennen, zoals zij ervan houden.\n\nStadslegendes, sociale strubbelingen, misdaadsc\u00e8nes, Art Nouveau of andere thema's, ga met ze mee en ontdek Brussel zoals je het nog nooit hebt gezien!\n\nDe rondleidingen zijn beschikbaar op inschrijving via de website, maar op verzoek kunnen er ook priv\u00e9rondleidingen voor groepen worden geregeld. Als onderdeel van deze priv\u00e9-ervaringen kunt u de rondleiding combineren met een chocoladeproeverij, een goed gebrouwen aperitief of een maaltijd in een authentiek Brussels etablissement.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":41819,"location":{"lat":50.8477202,"lon":4.3548659},"last_updated_at":"2024-10-16T12:31:41+02:00","published_at":"2024-01-20T21:02:59+01:00","is_in_address_book":true,"is_in_vb_export":false,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/ade6ab5302149aaaef8a4af090d87adde6240c2c.jpg","width":577,"height":864,"ratio":0.67,"oEmbed_height":864,"oEmbed_width":577,"translations":{"de":{"title":"Art Nouveau : De la Source aux \u00c9tangs","copyright":null},"pt":{"title":"Art Nouveau : De la Source aux \u00c9tangs","copyright":null},"en":{"title":"Art Nouveau : De la Source aux \u00c9tangs","copyright":null},"it":{"title":"Art Nouveau : De la Source aux \u00c9tangs","copyright":null},"cn":{"title":"Art Nouveau : De la Source aux \u00c9tangs","copyright":null},"fr":{"title":"Art Nouveau : De la Source aux \u00c9tangs","copyright":null},"sp":{"title":"Art Nouveau : De la Source aux \u00c9tangs","copyright":null},"nl":{"title":"Art Nouveau : De la Source aux \u00c9tangs","copyri