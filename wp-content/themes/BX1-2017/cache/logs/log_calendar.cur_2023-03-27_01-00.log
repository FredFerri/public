,"others":{"list":[52],"translations":{"fr":["Th\u00e9\u00e2tre musical"],"nl":["Muziektheater"],"en":["Musical theatre"],"de":["Musiktheater"],"it":["Teatro musicale"],"sp":["Teatro musical"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Garcia Lorca, le proc\u00e8s","shortdescr":"C\u2019est en s\u2019impr\u00e9gnant de l\u2019\u0153uvre de Lorca, que Jos\u00e9 Perez,  auteur, po\u00e8te, fils de r\u00e9publicain espagnol,\r\na eu l\u2019id\u00e9e de constituer le drame de la vie du Rossignol andalou \u00e0 travers la m\u00e9canique bien r\u00f4d\u00e9e d\u2019un proc\u00e8s d\u2019Inquisition,\r\navec toutes les \u00e9tapes qui vont de la pr\u00e9sentation de l\u2019h\u00e9r\u00e9tique, de l\u2019Inquisiteur, de l\u2019autodaf\u00e9 \u00e0 l\u2019ex\u00e9cution et \u00e0 la mise \u00e0 l\u2019index des \u0153uvres du po\u00e8te.","longdescr":"C\u2019est en s\u2019impr\u00e9gnant de l\u2019\u0153uvre de Lorca, que Jos\u00e9 Perez,  auteur, po\u00e8te, fils de r\u00e9publicain espagnol,\r\na eu l\u2019id\u00e9e de constituer le drame de la vie du Rossignol andalou \u00e0 travers la m\u00e9canique bien r\u00f4d\u00e9e d\u2019un proc\u00e8s d\u2019Inquisition,\r\navec toutes les \u00e9tapes qui vont de la pr\u00e9sentation de l\u2019h\u00e9r\u00e9tique, de l\u2019Inquisiteur, de l\u2019autodaf\u00e9 \u00e0 l\u2019ex\u00e9cution et \u00e0 la mise \u00e0 l\u2019index des \u0153uvres du po\u00e8te.\r\n\r\n\r\nLorca n\u2019a jamais b\u00e9n\u00e9fici\u00e9 du moindre proc\u00e8s.\r\nIl est mort dans des conditions plus ou moins d\u00e9termin\u00e9es, alors que la guerre civile d\u2019Espagne venait d\u2019\u00e9clater.\r\nIl y a 87 ans\r\n\r\nTels les h\u00e9r\u00e9tiques du temps pass\u00e9, les Parfaits, les Cathares du Languedoc, Lorca menait une croisade \u00e0 contre courant de tout,\r\net m\u00eame si aucun juge ne s\u2019est prononc\u00e9 sur son sort, certains de son temps, eux, se sont permis de mener le  proc\u00e8s le plus terrible qui soit,\r\ncelui o\u00f9 la d\u00e9fense n\u2019a pas voix au chapitre.","performers":"Textes : Jos\u00e9 Perez\r\nInterpr\u00e9tation : Myriam Kaminski, Sylvie Rigot, Jocelyne Sadis,\r\nFlorine Elslande et C\u00e9cile Rigot (chant)\r\nMise en sc\u00e8ne : Denis Gayzal\r\nProduction : Compagnie La Corde \u00e0 noeuds","boxoffice_url":null,"website":"http:\/\/www.laclarenciere.be","email":"fabienne.govaerts@skynet.be","phone_contact":"+32 2 640 46 70","phone_booking":"+32 2 640 46 76","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.550476"},"nl":{"name":"Garcia Lorca, le proc\u00e8s","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.laclarenciere.be","email":"fabienne.govaerts@skynet.be","phone_contact":"+32 2 640 46 70","phone_booking":"+32 2 640 46 76","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.550476"},"en":{"name":"Garcia Lorca, le proc\u00e8s","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.laclarenciere.be","email":"fabienne.govaerts@skynet.be","phone_contact":"+32 2 640 46 70","phone_booking":"+32 2 640 46 76","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.550476"},"de":{"name":"Garcia Lorca, le proc\u00e8s","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.laclarenciere.be","email":"fabienne.govaerts@skynet.be","phone_contact":"+32 2 640 46 70","phone_booking":"+32 2 640 46 76","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.550476"},"it":{"name":"Garcia Lorca, le proc\u00e8s","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.laclarenciere.be","email":"fabienne.govaerts@skynet.be","phone_contact":"+32 2 640 46 70","phone_booking":"+32 2 640 46 76","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.550476"