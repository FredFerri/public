te luisteren naar de subtiele en unieke klanken van de barok- en klassieke muziek, uitgevoerd op historische instrumenten.","longdescr":"Tijdens een middagconcert nemen de studenten u mee op een muzikale reis doorheen Europa. Wij gidsen u telkens door een gevarieerd en verrassend programma aan de hand van uitleg en anekdotes.","performers":"De studenten van de afdeling Historical Performance Practice van het Koninklijk Conservatorium Brussel","boxoffice_url":null,"website":"https:\/\/www.erasmushouse.museum\/nl\/2022\/01\/27-01-middagconcerten-erasmusica\/","email":"info@erasmushouse.museum","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/525120.html"},"en":{"name":"Erasmisica -  concerts of ancient music","shortdescr":"Students offer a beautiful programme to introduce us to ancient music.","longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.erasmushouse.museum\/2022\/01\/27-01-concerts-de-midi-erasmusica\/","email":"info@erasmushouse.museum","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/525120.html"},"de":{"name":"Erasmusica - concerts de midi musique ancienne","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/525120.html"},"it":{"name":"Erasmusica - concerts de midi musique ancienne","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/525120.html"},"sp":{"name":"Erasmusica - concerts de midi musique ancienne","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/525120.html"},"pt":{"name":"Erasm