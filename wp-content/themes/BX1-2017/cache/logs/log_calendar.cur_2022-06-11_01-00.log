a grande majorit\u00e9 des chansons ont des origines m\u00e9di\u00e9vales, mais certaines d'entre elles sont orales, c\u2019est pourquoi elles ont subi des transformations constantes.","performers":"Emilio Villalba (direction musicale, luth, guitare m\u00e9di\u00e9vale, alto, sp\u00e9cialiste en Interpr\u00e9tation historiquement inform\u00e9e)\r\nSara Marina (conteuse, darbouka, bendir et clavecin)","boxoffice_url":null,"website":"https:\/\/bleuhorizon.be\/emilio-villalba\/","email":"contact@bleuhorizon.be","phone_contact":"+32 486 73 31 68","phone_booking":"+32 486 73 31 68","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/534076.html"},"nl":{"name":"th\u00e9\u00e2tre musicale de marionnettes pour enfants","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.facebook.com\/events\/1370944186753592","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/534076.html"},"en":{"name":"th\u00e9\u00e2tre musicale de marionnettes pour enfants","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.ticketor.com\/horizon\/juglaresa","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/534076.html"},"de":{"name":"th\u00e9\u00e2tre musicale de marionnettes pour enfants","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/534076.html"},"it":{"name":"th\u00e9\u00e2tre musicale de marionnettes pour enfants","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/534076.html"},"sp":{"name":"th\u00e9\u00e2tre musicale de marionnettes pour enfants","shortdescr":null,"longdescr":null,"