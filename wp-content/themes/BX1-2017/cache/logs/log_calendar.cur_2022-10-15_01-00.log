-10T14:36:07+02:00","published_at":"2022-08-03T13:03:40+02:00","backoffice_id":259250,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":0.2248221565113},{"id":538415,"date_start":"2022-09-03","date_end":"2022-12-09","date_next":"2022-12-09","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater"}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"],"de":["Theater"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"FBIA Match de championnat","shortdescr":"Retrouvez les jouteur\u2022euse\u2022s au travers des histoires les plus folles, tant\u00f4t emplies d\u2019\u00e9motions et tant\u00f4t pleines d\u2019absurdit\u00e9s. Rien n\u2019est r\u00e9p\u00e9t\u00e9, rien n\u2019est pr\u00e9vu : le spectacle s\u2019\u00e9crit sous vos yeux.","longdescr":"Retrouvez nos jouteurs et jouteuses au travers des histoires les plus folles, tant\u00f4t emplies d\u2019\u00e9motions et tant\u00f4t pleine d\u2019absurdit\u00e9s ; de quoi ravir vos papilles culturelles. De septembre \u00e0 juin, assistez \u00e0 des matchs d\u2019improvisation uniques \u00e0 Bruxelles et en Wallonie pour votre plus grand bonheur ! Rien n\u2019est r\u00e9p\u00e9t\u00e9, rien n\u2019est pr\u00e9vu et c\u2019est sous vos yeux \u00e9bahis (enfin, on esp\u00e8re) que le spectacle s\u2019\u00e9crira\u2026. Alors foncez vite et r\u00e9servez vos places pour partager avec iels une soir\u00e9e de folie.","performers":"FBIA - F\u00e9d\u00e9ration belge d'improvisation amateur","boxoffice_url":null,"website":"https:\/\/culture.ixelles.be\/fr\/mercelis\/","email":"info@fbia.be","phone_contact"