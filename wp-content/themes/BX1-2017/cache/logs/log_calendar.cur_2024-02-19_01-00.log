bjj-4h93r-ykjnh-frscc-fdw8g-br676-a7jxt-y6k72-gf5hf-gnpwj","email":"info@lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50006045"},"cn":{"name":"Les Amateurs \u2013 Karim Gharbi & Benjamin Sauzereau","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lejardindemasoeur.be\/jardinevents\/2017\/10\/25\/brel-bruno-ke5n8-r6mk8-nks45-sbres-7lany-3zjhw-y6bjj-4h93r-ykjnh-frscc-fdw8g-br676-a7jxt-y6k72-gf5hf-gnpwj","email":"info@lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50006045"},"fr":{"name":"Les Amateurs \u2013 Karim Gharbi & Benjamin Sauzereau","shortdescr":"\u201c...c\u2019est beau, c\u2019est juste, \u00e7a remue, \u00e7a perturbe les pr\u00e9jug\u00e9s. Humour et \u00e9motion sont conjugu\u00e9s en mode majeur. On aper\u00e7oit parfois la d\u00e9gaine de Charlie Chaplin, on entend Paul Verlaine, on croit voir se d\u00e9hancher Mickael Jackson sur un tcha-tcha-tcha...\u201d","longdescr":"De Paris \u00e0 Caracas, de Vienne \u00e0 Marrakech, de New York \u00e0 Tombouctou, Karim Gharbi (voix) et Benjamin Sauzereau (guitare) vous emm\u00e8nent pour un voyage dans le temps et l\u2019espace. Chanter les autres au travers des reprises tous azimuts, chansons lointaines et proches, fortes et vibrantes, choisies sur le volet, chant\u00e9es en fran\u00e7ais, arabe, roumain, anglais, allemand, espagnol et m\u00eame en wallon, r\u00e9arrang\u00e9es et r\u00e9interpr\u00e9t\u00e9es pour un partage dans l'intimit\u00e9. \u201c...c\u2019est beau, c\u2019est juste, \u00e7a remue, \u00e7a perturbe les pr\u00e9jug\u00e9s. Humour et \u00e9motion sont conjugu\u00e9s en mode majeur. On aper\u00e7oit parfois la d\u00e9gaine de Charlie Chaplin, on entend Paul Verlaine, on croit voir se d\u00e9hancher Mickael Jackson sur un tcha-tcha-tcha...\u201d  \u2013 Concert \u00e0 20h45.","performers":"Karim Gharbi (interpr\u00e9tation); Benjamin Sauzereau (guitare)","boxoffice_url":null,"website":"https:\/\/www.lejardindemasoeur.be\/jardinevents\/2017\/10\/25\/brel-bruno-ke5n8-r6mk8-nks45-sbres-7lany-3zjhw-y6bjj-4h93r-ykjnh-frscc-fdw8g-br676-a7jxt-y6k72-gf5hf-gnpwj","email":"info@lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50006045"},"sp":{"name":"Les Amateurs \u2013 Karim Gharbi & Benjamin Sauzereau","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lejardindemasoeur.be\/jardinevents\/2017\/10\/25\/brel-bruno-ke5n8-r6mk8-nks45-sbres-7lany-3zjhw-y6bjj-4h93r-ykjnh-frscc-fdw8g-br676-a7jxt-y6k72-gf5hf-gnpwj","email":"info@lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50006045"},"nl":{"name":"Les Amateurs \u2013 Karim Gharbi & Benjamin Sauzereau","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lejardindemasoeur.be\/jardinevents\/2017\/10\/25\/brel-bruno-ke5n8-r6mk8-nks45-sbres-7lany-3zjhw-y6bjj-4h93r-ykjnh-frscc-fdw8g-br676-a7jxt-y6k72-gf5hf-gnpwj","email":"info@lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50006045"}},"place":{"id":220283,"translations":{"de":{"name":"Le Jardin de ma Soeur","address_street_name":"Rue du Grand Hospice","address_street_number":"54","address_street_box":null,"email":"info@lejardindemasoeur.be","website":"http:\/\/www.lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 54","address_line2":"1000 Bruxelles","description_web":"Dieses malerische Caf\u00e9-Theater, das 1994 in der N\u00e4he des alten \"Grand B\u00e9guinage de Bruxelles\" er\u00f6ffnet wurde, \u00fcberrascht durch seine \u00fcberaus kleinen R\u00e4umlichkeiten. Doch daf\u00fcr ist das Programm ist umso \"gr\u00f6\u00dfer\". Reservierung empfohlen!","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Le Jardin de ma Soeur","address_street_name":"Rue du Grand Hospice","address_street_number":"54","address_street_box":null,"email":"info@lejardindemasoeur.be","website":"http:\/\/www.lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 54","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Le Jardin de ma Soeur","address_street_name":"Grootgodshuisstraat","address_street_number":"54","address_street_box":null,"email":"info@lejardindemasoeur.be","website":"http:\/\/www.lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","address_zip":"1000","address_city":"Bruxelles","address_line1":"Grootgodshuisstraat, 54","address_line2":"1000 Bruxelles","description_web":"The desire to present theater amongst people; as if a performance is nothing but a conversation, in a place somewhere in between the large halls and the streets, half living room, half pub, in a warm ambiance where one can sip a glass while watching a performance. That's cafe-theater \"Le Jardin de ma Soeur\", at the edge of the ancient \"Grand B\u00e9guinage de Bruxelles\", alongside one of the quays of the old port of Brussels where the spirit of the dock workers lingers and where one can still feel the presence of the beguines with their long black robes.","description_print":null,"booking_ur