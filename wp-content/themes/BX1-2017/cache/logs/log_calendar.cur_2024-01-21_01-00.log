par Fabrice Vandeloise pour Vandeloise Productions of Professional Artists & Events.","performers":"Andr\u00e9 Lamy, Morgane G\u00e9r\u00f4me et Morgane Leveugle. ","boxoffice_url":null,"website":"https:\/\/lepetitchapeaurondrouge.be\/","email":"info@lepetitchapeaurondrouge.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50004157"},"sp":{"name":"Lamy and Co ! Revue satirique","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lepetitchapeaurondrouge.be\/","email":"info@lepetitchapeaurondrouge.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50004157"},"nl":{"name":"Lamy and Co ! Revue satirique","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lepetitchapeaurondrouge.be\/","email":"info@lepetitchapeaurondrouge.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50004157"}},"place":{"id":248422,"translations":{"de":{"name":"Le Petit Chapeau Rond Rouge","address_street_name":"Rue P\u00e8re Eudore Devroye","address_street_number":"12","address_street_box":null,"email":"info@lepetitchapeaurondrouge.be","website":"http:\/\/www.lepetitchapeaurondrouge.be","phone_contact":"+32 498 51 35 63","phone_booking":"+32 498 51 35 63","address_zip":"1040","address_city":"Etterbeek","address_line1":"Rue P\u00e8re Eudore Devroye, 12","address_line2":"1040 Etterbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Le Petit Chapeau Rond Rouge","address_street_name":"Rue P\u00e8re Eudore Devroye","address_street_number":"12","address_street_box":null,"email":"info@lepetitchapeaurondrouge.be","website":"http:\/\/www.lepetitchapeaurondrouge.be","phone_contact":"+32 498 51 35 63","phone_booking":"+32 498 51 35 63","addre