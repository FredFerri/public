":"2025-03-17T08:07:05+01:00","published_at":"2025-03-17T08:01:03+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":320064,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"party","ranking":1,"languages":{"spoken":["en","nl","fr"],"subtitles":[]},"categories":{"main":{"id":57,"translations":{"de":"Clubbing","pt":null,"en":"Clubbing","it":"Locali notturni","cn":null,"fr":"Clubbing","sp":"Ir de discoteca","nl":"Clubbing"}},"others":{}},"translations":{"de":{"name":"La plus Grande Soir\u00e9e Rencontres : by Coeur \u00e0 Coeur | Soir\u00e9e 30+","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.facebook.com\/events\/610466745028959\/","email":"info@justanight.net","phone_contact":"+32 478 58 60 39","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700007688"},"pt":{"name":"La plus Grande Soir\u00e9e Rencontres : by Coeur \u00e0 Coeur | Soir\u00e9e 30+","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.facebook.com\/events\/610466745028959\/","email":"info@justanight.net","phone_contact":"+32 478 58 60 39","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700007688"},"en":{"name":"La plus Grande Soir\u00e9e Rencontres : by Coeur \u00e0 Coeur | Soir\u00e9e 30+","shortdescr":"30+ Party | C\u0153ur \u00e0 C\u0153ur arrives at Cactus Club | The Biggest Live Singles Party!\n\nC\u0153ur \u00e0 C\u0153ur (30+) is coming to the Cactus Club!\n\nSaturday 22.03 | 10:30 PM | Cactus Club, Auderghem","longdescr":"30+ Party | C\u0153ur \u00e0 C\u0153ur arrives at Cactus Club | The Biggest Live Singles Party!\n\nC\u0153ur \u00e0 C\u0153ur (30+) is coming to the Cactus Club!\n\nSaturday 22.03 | 10:30 PM | Cactus Club, Auderghem\nTheme: Flashdance 80's, 90's, 2000's\nFB Event: https:\/\/fb.me\/e\/2La1VvnKW\n\nOpen to everyone!\n\nThe C\u0153ur \u00e0 C\u0153ur party is back at Cactus Club for its third edition. C\u0153ur \u00e0 C\u0153ur is the biggest live singles event for the 30+ crowd. Do not miss this exceptional night with DJ Stephen spinning six hours of the best disco, 80s, 90s, and 2000s hits.\n\nFlash Sale & Guaranteed Entry Pass [skip the line and secure your spot]:\n5\u20ac, 10\u20ac | or at the door: 10\u20ac\nEventbrite Tickets\n\nFree goodies and candy for the first 100 guests\n\nDress code: Chic\nFree parking in front\nGreat vibes guaranteed\n\nFollow us:\nInstagram: @coeuracoeur.be\nwww.coeuracoeur.be\n\nVIP Packages & Reservations: +32 478 58 60 39\n\nJoin us for an unforgettable night and meet other singles in a retro, nostalgic atmosphere.\n\nAre you celebrating a birthday, a bachelor or bachelorette party, or a night out with colleagues?\nDo you want to reserve a private table or space?\n\nVIP Packages:\nTurquoise Pack: 6 people + 2 bottles of alcohol\nSilver Pack: 10 people + 3 bottles of alcohol\nGold Pack: 15 people + 5 bottles of alcohol\n\nInfo via WhatsApp: +32 478 58 60 39\n\nYour friends\u2019 friends are our friends. Invite your 30+ friends to the event and sign up for our mailing list to stay updated on future parties at www.coeuracoeur.be\n\nMark your attendance on Facebook and invite your friends.\nRSVP on Facebook: https:\/\/fb.me\/e\/2La1VvnKW\n\nThe temperature is rising...\n\nThis night promises to be full of fun with C\u0153ur \u00e0 C\u0153ur. If you are over 30 and up for an adventure, this is the place to be.\nSee you in Auderghem.\n\nCactus Club: Boulevard du Souverain 147 - 1160 Auderghem","performers":null,"boxoffice_url":null,"website":"https:\/\/www.facebook.com\/events\/610466745028959\/","email":"info@justanight.net","phone_contact":"+32 478 58 60 39","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700007688"},"it":{"name":"La plu