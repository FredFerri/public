":170}],"child_events":[],"parent_events":[545331],"targets":{"list":[],"translations":{}},"visit_content":{"list":[428],"values":["brussels-renaissance-festival"]},"tags":["exterior"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-07-08T03:35:24+02:00","published_at":"2023-04-01T20:26:43+02:00","backoffice_id":274662,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.32548726473767},{"id":554658,"date_start":"2023-06-17","date_end":"2023-07-15","date_next":"2023-07-08","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":true,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen","it":"Visite guidate","sp":"Visitas guiadas","pt":null,"cn":null}},"others":{"list":[108],"translations":{"fr":["Folklore"],"nl":["Folklore"],"en":["Folklore"],"de":["Folklore"],"it":["Folklore"],"sp":["Folclore"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Sur les traces de Lamoral, comte d'Egmont, & Philippe de Montmorency, comte de Hornes","shortdescr":"Suivez le guide sur les traces d'Egmont et Horne, deux personnages cl\u00e9 du pass\u00e9 Bruxellois, symboles de pacification et tol\u00e9rance religieuse","longdescr":"Lamoral d'Egmont, Philippe de Hornes, deux noms qui fleurent comme une odeur de fronde face \u00e0 un aust\u00e8re joug espagnol en cette seconde moiti\u00e9 du XVI\u00e8me si\u00e8cle. Arp\u00e8s 450 ans de la d\u00e9capitation de ces deux h\u00e9ros, h\u00e9rauts de la pacification, de la tol\u00e9rance religieuse dans nos r\u00e9gions, nous vous proposons de suivre un parcours o\u00f9 nous rencontrerons leurs compagnons, des symboles de la domination du duc d'Albe, des lieux de cette trag\u00e9die narr\u00e9e par Goethe au XIX\u00e8me.\r\n\r\nVisite privative, organis\u00e9e sur mesure et \u00e0 la demande","performers":null,"boxoffice_url":null,"website":"http:\/\/www.itineraires.be","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.554658"},"nl":{"name":"Sur les traces de Lamoral, comte d'Egmont, & Philippe de Montmorency, comte de Hornes","shortdescr":"Volg de gids in de voetsporen van Egmont en Horne, twee sleutelfiguren uit het verleden van Brussel, symbolen van pacificatie en religieuze tolerantie.","longdescr":"Lamorel d'Egmont, Philippe de Hornes, twee namen die staan voor opstand tegen het strenge Spaanse juk in deze tweede helft van de 16e eeuw. Ter gelegenheid van de 450e verjaardag van de onthoofding van deze twee helden, herauten van de pacificatie en de religieuze tolerantie in onze streken, stellen wij voor een route te volgen waarbij we hun metgezellen ontmoeten, symbolen van de overheersing van de hertog van Alba, plaatsen van deze tragedie die in de 19e eeuw door Goethe werd verteld.\r\n\r\nPriv\u00e9bezoek, georganiseerd op aanvraag en op maat","performers":null,"boxoffice_url":null,"website":"http:\/\/www.itineraires.be","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.554658"},"en":{"name":"Sur les traces de Lamoral, comte d'Egmont, & Philippe de Montmorency, comte de Hornes","shortdescr":"Follow the guide on the tracks of Egmont and Horne, two key figures of Brussels' past, symbols of pacification and religious tolerance","longdescr":"Lamorel d'Egmont, Philippe de Hornes, two names that mean rebellion against the austere Spanish yoke in this second half of the 16th century. For the 450th anniversary of the beheading of these two heroes, heralds of pacification and religious tolerance in our regions, we propose to follow a route where we will meet their companions, symbols of the domination of the Duke of Alba, places of this tragedy narrated by Goethe in the 19th century.\r\n\r\nPrivate visit, organized on demand","performers":null,"boxoffice_url":null,"website":"http:\/\/www.itineraires.be","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.554658"},"de":{"name":"Sur les traces de Lamoral, comte d'Egmont, & Philippe de Montmorency, comte de Hornes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.itineraires.be","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.554658"},"it":{"name":"Sur les traces de Lamoral, comte d'Egmont, & Philippe de Montmorency, comte de Hornes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.itineraires.be","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.554658"},"sp":{"name":"tras los pasos de Lamoral, conde de Egmont, y Felipe de Montmorency, conde de Horn","shortdescr":"tras los pasos de Lamoral, conde de Egmont, y Felipe de Montmorency, conde de Horn","longdescr":"Lamoral d'Egmont y Felipe de Horn, dos nombres que hacen referencia a la subyugaci\u00f3n espa\u00f1ola en la segunda mitad del siglo XVI. Con motivo del aniversario de la decapitaci\u00f3n de estas dos figuras, h\u00e9roes de la pacificaci\u00f3n y de la tolerancia religiosa en nuestras regiones, te proponemos seguir una ruta en la que conoceremos a sus compa\u00f1eros, los s\u00edmbolos de la dominaci\u00f3n del duque de 