,"boxoffice_url":null,"website":"http:\/\/www.wolubilis.be","email":"secretariat.atl@woluwe1200.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.559313"},"en":{"name":"Th\u00e9\u00e2tre","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wolubilis.be","email":"secretariat.atl@woluwe1200.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.559313"},"it":{"name":"Th\u00e9\u00e2tre","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wolubilis.be","email":"secretariat.atl@woluwe1200.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.559313"},"cn":{"name":"Th\u00e9\u00e2tre","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wolubilis.be","email":"secretariat.atl@woluwe1200.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.559313"},"fr":{"name":"Th\u00e9\u00e2tre","shortdescr":"\u00c0 faire => Ateliers, \u00c0 faire, \u00c0 faire => Ateliers => Arts de la sc\u00e8ne\r\nTh\u00e9\u00e2tre 11-13 ans - 2023\/2024 - 123\r\nAtelier Studio | Rue Lola Bobesco 5, 1er \u00e9tage - 1200 Woluwe Saint Lambert | Voir la carte","longdescr":"-\r\nDe septembre \u00e0 juin, nous d\u00e9velopperons une th\u00e9matique choisie lors de jeux de th\u00e9\u00e2tre, de mise en confiance et d\u2019expression que nous d\u00e9clinons \u00e0 travers diff\u00e9rents langages th\u00e9\u00e2traux allant de la trag\u00e9die au burlesque. Un travail cr\u00e9atif dans lequel les com\u00e9diens en herbe approfondissent la conscience de leur corps dans l\u2019espace, la ma\u00eetrise du geste et de la parole au service du texte. Un accent est particuli\u00e8rement mis sur la cr\u00e9ation du personnage et de sa cr\u00e9dibilit\u00e9.\r\n\u00c2ge de 11 \u00e0 13 ans (D\u00e8s la 6\u00e8me primaire).\r\n\r\nLocal Studio \r\nAvec C\u00e9line Taubennest de la Cie D\u00e9j\u00e0 Demain\r\n\r\nD\u00e8s le 20 septembre, les mercredis de 15:30 \u00e0 17:30\r\nNombre d'exposants :\r\n","performers":"Avec C\u00e9line Taubennest de la Cie D\u00e9j\u00e0 Demain","boxoffice_url":null,"website":"http:\/\/www.wolubilis.be","email":"secretariat.atl@woluwe1200.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.559313"},"sp":{"name":"Th\u00e9\u00e2tre","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wolubilis.be","email":"secretariat.atl@woluwe1200.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.559313"},"nl":{"name":"Th\u00e9\u00e2tre","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wolubilis.be","email":"secretariat.atl@woluwe1200.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.559313"}},"place":{"last_updated_at":"2022-10-18T11:25:22+02:00","published_at":"2013-10-19T01:13:39+02:00","id":220532,"translations":{"de":{"name":"Centre Culturel Wolubilis","address_street_name":"Cours Paul-Henri Spaak","address_street_number":"1","address_street_box":null,"email":"secretariat.atl@woluwe1200.be","website":"http:\/\/www.wolubilis.be","phone_contact":"+32 2 761 60 29","phone_booking":"+32 2 761 60 30","address_zip":"1200","address_city":"Woluwe-Saint-Lambert","address_line1":"Cours Paul-Henri Spaak, 1","address_line2":"1200 Woluwe-Saint-Lambert","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name