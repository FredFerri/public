ast fridays of the month from 19:00 to 22:00"}}],"closing_days":["2024-01-08","2024-01-09","2024-01-10","2024-01-11","2024-01-12","2024-01-13","2024-01-14","2024-01-15","2024-01-16","2024-01-17","2024-01-18","2024-01-19","2024-01-20","2024-01-21","2024-01-22","2024-01-23","2024-01-24","2024-01-25","2024-01-26","2024-01-27","2024-01-28","2024-01-29"],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"},"de":{"name":"Normal"},"it":{"name":"Normale"},"sp":{"name":"Normal"},"pt":{"name":"Normal"},"cn":{"name":"Normal"}},"value":49.5},{"translations":{"fr":{"name":"Groupe"},"nl":{"name":"Groep"},"en":{"name":"Group"},"de":{"name":"Gruppe"},"it":{"name":"Gruppi"},"sp":{"name":"Grupo"},"pt":{"name":"Groupe"},"cn":{"name":"Groupe"}},"value":325}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"visit_profile":{"list":[323],"translations":{"fr":["Gastronomie"],"nl":["Gastronomie"],"en":["Gastronomy"],"de":["Gastronomie"],"it":["Cucina"],"sp":["Gastronom\u00eda"],"pt":[null],"cn":[null]}},"tags":[],"accessibilities":{"list":[263],"translations":{"fr":["Accessible aux pi\u00e9tons appareill\u00e9s"],"nl":["Toegankelijk voor voetgangers met hulpmiddelen"],"en":["Accessible to pedestrians with mobility aids"],"de":["Barrierefrei f\u00fcr Fu\u00dfg\u00e4nger mit Gehhilfe"],"it":["Accessibile ai pedoni con supporti"],"sp":["Habilitado para peatones con aud\u00edfonos"],"pt":[null],"cn":[null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2023-03-25T02:09:15+01:00","published_at":"2019-08-09T13:38:27+02:00","backoffice_id":199991,"import_origin":null,"sub_type":"other","show_in_agenda":true,"ranking":0.12325926707291},{"id":554223,"date_start":"2023-03-11","date_end":"2023-04-13","date_next":"2023-04-01","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen","it":"Visite guidate","sp":"Visitas guiadas","pt":null,"cn":null}},"others":{"list":[255],"translations":{"fr":["Visites d'expositions"],"nl":["Tentoonstelling"],"en":["Exhibition guided tours"],"de":["Besuche von Ausstellungen"],"it":["Visite a esposizioni"],"sp":["Visitas a las exposiciones"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr","nl","de","en"],"subtitles":[]},"translations":{"fr":{"name":"Visite Guid\u00e9es au Mus\u00e9e de Capitalisme","shortdescr":"Du 9 mars au 13 avril 2023, un Mus\u00e9e du Capitalisme s\u2019installe \u00e0 la fronti\u00e8re entre la Ville de Bruxelles et Schaerbeek dans les ateliers de Zinneke. Il s\u2019agit de proposer un espace de r\u00e9flexion et de discussion sur ce syst\u00e8me complexe qui structure nos vies, et de pr\u00e9senter des alternatives existantes en Belgique.","longdescr":"Du 9 mars au 13 avril 2023, un Mus\u00e9e du Capitalisme s\u2019installe \u00e0 la fronti\u00e8re entre la Ville de Bruxelles et Schaerbeek dans les ateliers de Zinneke. Cr\u00e9\u00e9e en 2012 par un collectif de citoyen.ne.s, l\u2019association Mus\u00e9e du Capitalisme recouvre diverses initiatives dont une exposition itin\u00e9rante et bilingue (NL\/FR) sur notre syst\u00e8me \u00e9conomique et culturel, accessible \u00e0 tout public \u00e0 partir de 15 ans. Il s\u2019agit de proposer un espace de r\u00e9flexion et de discussion sur ce syst\u00e8me complexe qui structure nos vies, et de pr\u00e9senter des alternatives existantes en Belgique. Que trouve-t-on dans le Mus\u00e9e du Capitalisme ? Origines, espoirs, limites et alternatives au capitalisme : les quatre salles de l\u2019exposition reviennent sur les fondamentaux d\u2019un syst\u00e8me souvent mentionn\u00e9 mais rarement expliqu\u00e9. On y aborde le capitalisme en lien avec diff\u00e9rentes th\u00e9matiques telles que l\u2019alimentation, la sant\u00e9, la culture, la consommation, l\u2019environnement, la finance... Pour permettre aux visiteurs d\u2019\u00e9changer sur ces sujets, pas de Monopoly ou de livre de Karl Marx, mais plut\u00f4t des vid\u00e9os, des textes, des mises en situation, des t\u00e9moignages et des animations. Le projet, engag\u00e9 mais non partisan, s\u2019inscrit dans une d\u00e9marche d\u2019\u00e9ducation permanente et est avant tout bas\u00e9 sur les \u00e9changes lors des visites guid\u00e9es organis\u00e9es pour les \u00e9coles, les groupes associatifs ainsi que pour le grand public. Des visites individuelles sont bien entendu aussi organis\u00e9es et se veulent tout aussi stimulantes, notamment gr\u00e2ce \u00e0 des brochures disponibles en fran\u00e7ais, n\u00e9erlandais, anglais, espagnol, allemand, arabe et italien. Notre souhait est que, au terme de la visite, chaque personne reparte mieux outill\u00e9e pour s\u2019affirmer pleinement dans sa citoyennet\u00e9. \u00c0 ce jour, plus de 25.000 personnes ont visit\u00e9 l\u2019exposition, ainsi que des centaines d\u2019\u00e9coles, lors de 14 \u00e9tapes : Namur (2014), Saint-Gilles (2015), Gand (2015), Laeken (2016), Mons (2017), Anderlecht (2018), Li\u00e8ge (2018), Arlon (2018), Louvain-la-Neuve (2019), Mouscron (2019), Bruxelles-Ville (2019), Gembloux (2019), Rochefort (2019), Verviers (2020), Charleroi (2021), Beauraing, Welkenraedt et Malmedy (2022) et Ciney (2023).\r\n\r\nInfos pratiques :\r\nDates : Du 18 ao\u00fbt au 23 septembre 2022\r\nLieu : Zinneke, place Masui 13, 1000 Bruxelles.\r\nTrain : Gare du Nord, Tram : Masui ligne 3, 55, 93 & Thomas ligne 4, 25. Bus : Masui ligne 58, N18.\r\n\r\n\r\nHoraires d\u2019ouverture : mercredi, jeudi et samedi de 13h \u00e0 18h, les matins et vendredi sur r\u00e9servation. Tous les jeudis soir\u00e9e culturelle.\r\n\r\nEntr\u00e9e \u00e0 prix libre\r\n\r\nInfo et reservations : contact@museeducapitalisme.org, 0472\/51.24.84\r\nSite internet : www.museeducapitalisme.org","performers":"Guides b\u00e9n\u00e9voles du Collectif du Mus\u00e9e du Capitalisme","boxoffice_url":null,"website":"https:\/\/museeducapitalisme.org\/","email":"contact@museeducapitalisme.org","phone_contact":"+32 472 51 24 84","phone_booking":"+32 472 51 24 84","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.554223"},"nl":{"name":"Gegidste rondleiding (FR) in Museum van het Kapitalisme","shortdescr":"Van 9 maart tot 13 april 2023 installeert een Museum van het Kapitalisme zich op de grens van Stad Brussel en Schaarbeek in de ateliers van Zinneke. Het doel is om ruimte te bieden voor reflectie en discussie over dit complexe systeem dat ons leven structureert, en om bestaande alternatieven in Belgi\u00eb te presenteren.","longdescr":"Van 9 maart tot 13 april installeert een Museum van het Kapitalisme zich op de grens van Stad Brussel en Schaarbeek in de ateliers van Zinneke.  In 2012 ontstond de vereniging Museum van het Kapitalisme, opgericht door een collectief van burgers, dat verschillende initiatieven omvat waaronder een tweetalige (NL\/FR) reizende tentoonstelling over ons economisch en cultureel systeem, toegankelijk voor het grote publiek vanaf de leeftijd van 15 jaar. Het doel is om ruimte te bieden voor reflectie en discussie over dit complexe systeem dat ons leven structureert, en om bestaande alternatieven in Belgi\u00eb te presenteren. Wat is er te vinden in het Museum van het Kapitalisme? Oorsprong, hoop, grenzen en alternatieven voor het kapitalisme: de vier zalen van de tentoonstelling keren terug naar de fundamenten van een systeem dat vaak wordt genoemd maar zelden wordt uitgelegd. Het kapitalisme wordt besproken in relatie tot verschillende thema's zoals voeding, gezondheid, cultuur, consumptie, milieu, financi\u00ebn, enz. Om de bezoekers in staat te stellen om over deze onderwerpen van gedachten te wisselen, geen Monopoly of Karl Marx' boek, maar video's, teksten, interactieve installaties, getuigenissen en animaties. Het project, dat ge\u00ebngageerd maar niet partizaan is, vertrekt vanuit het kader van permanente vorming en is vooral gebaseerd op uitwisselingen tijdens rondleidingen die worden georganiseerd voor scholen, verenigingen en bezoekerspubliek. Individuele bezoeken worden natuurlijk ook georganiseerd en zijn net zo stimulerend bedoeld, met name dankzij de brochures die beschikbaar zijn in het Frans, Nederlands, Engels, Spaans, Duits, Arabisch en Italiaans. Onze wens is dat, aan het einde van het bezoek, elke persoon beter uitgerust vertrekt om zich ten volle te laten gelden in zijn burgerschap. Tot nu toe hebben meer dan 25.000 mensen de tentoonstelling bezocht, evenals honderden scholen, gedurende 14 etappes: Namen (2014), Sint-Gillis (2015), Gent (2015), Laken (2016), Bergen (2017), Anderlecht (2018), Luik (2018), Aarlen (2018), Louvain-la-Neuve (2019), Moeskroen (2019), Brussel-Stad (2019), Gembloux (2019), Rochefort (2019), Verviers (2020), Charleroi (2021), Beauraing, Welkenraedt en Malmedy (2022) en Ciney (2023).\r\n\r\nPraktische informatie :\r\nData : Van 18 augustus tot 23 september 2022\r\nLocatie: Zinneke, Masuiplaats 13, 1000 Brussel\r\nTrein : Brussel-Noord Tram : Masui lijn 3, 55, 93 & Thomas lijn 4, 25. Bus : Masui lijn 58, N18.\r\n\r\nOpeningstijden: woensdag, donderdag en zaterdag van 13.00 tot 19.00 uur. Voormiddag en 's vrijdags open op reservatie. Elke donderdag culturele avonden.\r\n\r\nToegang aan vrije bijdrage\r\n\r\nReservering of info: contact@museeducapitalisme.org 0472\/51.24.84 Website : www.museeducapitalisme.org","performers":"Vrijwillige gidsen van het Collectief Museum van het Kapitalisme","boxoffice_url":null,"website":"https:\/\/museeducapitalisme.org\/nl\/homepage-2\/","email":"contact@museumvanhetkapitalisme.org","phone_contact":"+32 472 51 24 84","phone_booking":"+32 472 51 24 84","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.554223"},"en":{"name":"Guided visit (FR) at Museum of Capitalisme","shortdescr":"From 9th March to 13th April 2023, a Museum of Capitalism is set up on the border of City of Brussels and Schaerbeek, in the workplace of Zinneke. The aim is to offer a space for reflection and discussion on this complex system that structures our lives, and to present alternatives that exist in Belgium.","longdescr":"From 9th March to 13th April 2023, a Museum of Capitalism is set up on the border of City of Brussels and Schaerbeek, in the workplace of Zinneke. Created in 2012 by a collective of citizens, the association Mus\u00e9e du Capitalisme covers various initiatives including a travelling and bilingual (NL\/FR) exhibition on our economic and cultural system, accessible to the general public from the age of 15. The aim is to offer a space for reflection and discussion on this complex system that structures our lives, and to present alternatives that exist in Belgium. What can be found in the Museum of Capitalism? Origins, hopes, limits and alternatives to capitalism: the four rooms of the exhibition return to the fundamentals of a system often mentioned but rarely explained. Capitalism is discussed in relation to various themes such as food, health, culture, consumption, the environment, finance, etc. To allow visitors to exchange on these subjects, no Monopoly or Karl Marx's book, but rather videos, texts, interactive installations, testimonies and animations. The project, which is engaging but non-partisan, is part of a life-long educative approach and is above all based on exchanges during guided tours organised for schools, associations and the general public. Individual visits are of course also organised and are intended to be just as stimulating, thanks in particular to brochures available in French, Dutch, English, Spanish, German, Arabic and Italian. Our wish is that, at the end of the visit, each person leaves better equipped to assert themselves fully in their citizenship. To date, more than 25,000 people have visited the exhibition, as well as hundreds of schools, during 14 stages: Namur (2014), Saint-Gilles (2015), Ghent (2015), Laeken (2016), Mons (2017), Anderlecht (2018), Li\u00e8ge (2018), Arlon (2018), Louvain-la-Neuve (2019), Mouscron (2019), Brussels-City (2019), Gembloux (2019), Rochefort (2019), Charleroi (2021), Beauraing, Welkenraedt and Malmedy (2022) and Ciney (2023).\r\n\r\nPractical information :\r\nDates : From 6 January to 21 March 2021\r\nLocation: See U (above the Kinograph) Avenue de la Couronne, 227 1050 Ixelles\r\nBus 95 and N08; Trams 7 and 25; Etterbeek Station\r\n\r\nOpening hours: Wednesday, Thursday and Saturday from 1pm to 6pm. Open in the morning and on Friday on reservation only. Every Thursday cultural events.\r\n\r\nAdmission at free contribution\r\n\r\nReservations & info: contact@museeducapitalisme.org 0472\/51.24.84 Website : www.museeducapitalisme.org","performers":"Volunteer guides of the Museum of Capitalisme collective","boxoffice_url":null,"website":"https:\/\/museeducapitalisme.org\/","email":"contact@museeducapitalisme.org","phone_contact":"+32 472 51 24 84","phone_booking":"+32 472 51 24 84","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.554223"},"de":{"name":"Visite Guid\u00e9es au Mus\u00e9e de Capitalisme","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/museeducapitalisme.org\/","email":"contact@museeducapitalisme.org","phone_contact":"+32 472 51 24 84","phone_booking":"+32 472 51 24 84","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.554223"},"it":{"name":"Visite Guid\u00e9es au Mus\u00e9e de Capitalisme","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/museeducapitalisme.org\/","email":"contact@museeducapitalisme.org","phone_contact":"+32 472 51 24 84","phone_booking":"+32 472 51 24 84","agenda_url":"https:\