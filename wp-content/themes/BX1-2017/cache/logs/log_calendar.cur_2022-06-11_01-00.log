":true,"is_third":true,"is_fourth":true,"is_last":false},"time_start":"14:00:00","time_end":"18:00:00","translations":{"fr":"Ouvert les premier, deuxi\u00e8me, troisi\u00e8me et quatri\u00e8me samedis du mois de 14:00 \u00e0 18:00","nl":"Open op de eerste, tweede, derde en vierde zaterdags van de maand van 14:00 tot 18:00","en":"Open the first, second, third and fourth saturdays of the month from 14:00 to 18:00"}},{"day":"sunday","occurences":{"is_first":true,"is_second":true,"is_third":true,"is_fourth":true,"is_last":true},"time_start":"09:00:00","time_end":"13:00:00","translations":{"fr":"Ouvert les premier, deuxi\u00e8me, troisi\u00e8me, quatri\u00e8me et dernier dimanches du mois de 09:00 \u00e0 13:00","nl":"Open op de eerste, tweede, derde, vierde en laatste zondags van de maand van 09:00 tot 13:00","en":"Open the first, second, third, fourth and last sundays of the month from 09:00 to 13:00"}}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":75},{"translations":{"fr":{"name":"Enfants"},"nl":{"name":"Kinderen"},"en":{"name":"Children"}},"value":45}],"child_events":[],"parent_events":[],"targets":{"list":[11,10,19,7,8,16],"translations":{"fr":["Famille","Seniors","Enseignants","Jeunes 12-15 ans","Jeunes 15-18 ans","Ecoles"],"nl":["Familie","Senioren","Leerkrachten","Jongeren 12-15 j.","Jongeren 15-18 j.","Scholen"],"en":["Family","Seniors","Teachers","Youth 12-15  yr.","Youth 15-18  yr.","Schools"]}},"tags":["kids"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-06-09T01:06:09+02:00","published_at":"2021-06-16T12:32:30+02:00","backoffice_id":233441,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.10233859542617},{"id":529253,"date_start":"2022-03-24","date_end":"2022-09-04","date_next":"2022-06-10","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[36,46],"translations":{"fr":["Mus\u00e9es et art centers","Pluridisciplinaire"],"nl":["Musea en kunstcentra","Multidisciplinair"],"en":["Museums and art centers","Multidisciplinary"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Portrait of a Lady","shortdescr":"Portrait of a Lady illustre \u00e0 travers une s\u00e9rie d\u2019\u0153uvres d\u2019art la repr\u00e9sentation de la femme depuis la pr\u00e9histoire jusqu\u2019\u00e0 aujourd\u2019hui, ainsi que le parcours de quelques femmes d\u2019exception. L\u2019exposition fera dialoguer diff\u00e9rentes cultures et civilisations d\u2019orient et d\u2019occident, en r\u00e9unissant une s\u00e9lection de pi\u00e8ces anciennes et contemporaines.","longdescr":"Portrait of a Lady illustre \u00e0 travers une s\u00e9rie d\u2019\u0153uvres d\u2019art la repr\u00e9sentation de la femme depuis la pr\u00e9histoire jusqu\u2019\u00e0 aujourd\u2019hui, ainsi que le parcours de quelques femmes d\u2019exception. L\u2019exposition fera dialoguer diff\u00e9rentes cultures et civilisations d\u2019orient et d\u2019occident, en r\u00e9unissant une s\u00e9lection de pi\u00e8ces anciennes et contemporaines.\r\n\r\nLe projet pr\u00e9sente ainsi les portraits de femmes inconnues et c\u00e9l\u00e8bres, des origines \u00e0 aujourd\u2019hui. Parmi les figures historiques, les \u0153uvres convoquent notamment la Gr\u00e8ce ou encore l\u2019Afrique, \u00e0 l\u2019instar de l\u2019histoire de la reine de Saba ou celle de Didon, Reine de Carthage. Depuis la personnification de la fertilit\u00e9 jusqu\u2019\u00e0 la repr\u00e9sentation des courtisanes, en passant par celle des imp\u00e9ratrices, l\u2019exposition a pour ambition d\u2019\u00e9clairer les diff\u00e9rents regards port\u00e9s sur les femmes \u00e0 travers les \u00e9poques.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.villaempain.com","email":"info@boghossianfoundation.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/529253.html"},"nl":{"name":"Portrait of a Lady","shortdescr":"Portrait of a Lady laat aan de hand van een reeks kunstwerken zien hoe de vrouw sinds de prehistorie tot nu werd uitgebeeld. Speciale aandacht is er ook voor de levensloop van enkele uitzonderlijke vrouwen. De tentoonstelling cre\u00ebert een dialoog tussen verschillende oosterse en westerse culturen en beschavingen, via een selectie oude en hedendaagse stukken.","longdescr":"Portrait of a Lady laat aan de hand van een reeks kunstwerken zien hoe de vrouw sinds de prehistorie tot nu werd uitgebeeld. Speciale aandacht is er ook voor de levensloop van enkele uitzonderlijke vrouwen. De tentoonstelling cre\u00ebert een dialoog tussen verschillende oosterse en westerse culturen en beschavingen, via een selectie oude en hedendaagse stukken.\r\n\r\nWe krijgen portretten van beroemde en onbekende vrouwen te zien, vanaf het begin van de kunstgeschiedenis tot nu. Wat historische figuren betreft, zijn er werken uit onder meer Griekenland en Afrika. Zo is er het verhaal van de koningin van Seba en van Dido, de koningin van Carthago. De tentoonstelling wil laten zien hoe de kijk op vrouwen evolueerde in de loop der eeuwen, vanaf de personificatie van de vruchtbaarheid tot de uitbeelding van keizerinnen en courtisanes.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/529253.html"},"en":{"name":"Portrait of a Lady","shortdescr":"Through a series of artworks, Portrait of a Lady illustrates the various forms of representation of women from prehistoric times to today, as well as the more specific journeys of a few exceptional women. Grouping a selection of ancient and contemporary pieces, the exhibition will establish a dialogue between different cultures and civilizations from the East and the West.","longdescr":"Through a series of artworks, Portrait of a Lady illustrates the various forms of representation of women from prehistoric times to today, as well as the more specific journeys of a few exceptional women. Grouping a selection of ancient and contemporary pieces, the exhibition will establish a dialogue between different cultures and civilizations from the East and the West.\r\n\r\nThis project aims to honour the portraits of both renowned and unknown women from long ago to today. In addition to historical figures, the artworks convey images of Greece and Africa, with insights into the stories of the Queen of Sheba and Dido, Queen of Carthage. From the personification of fertility to the representations of courtesans and empresses, the exhibition endeavours to shed light on the different views and interpretations of women through the ages.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/529253.html"},"de":{"name":"Portrait of a Lady","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/529253.html"},"it":{"name":"Portrait of a Lady","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/529253.html"},"sp":{"name":"Portrait of a Lady","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/529253.html"},"pt":{"name":"Portrait of a Lady","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/529253.html"},"cn":{"name":"Portrait of a Lady","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/529253.html"}},"place":{"id":248760,"translations":{"fr":{"name":"Fondation Boghossian \u2013 Villa Empain","address_street_name":"Avenue Franklin Roosevelt","address_street_number":"67","address_street_box":null,"email":"info@boghossianfoundation.be","website":"http:\/\/www.villaempain.com","phone_contact":"+32 2 627 52 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Franklin Roosevelt, 67","address_line2":"1050 Ixelles","description_web":"La Villa Empain, remarquable t\u00e9moin de l\u2019architecture Art d\u00e9co, abrite la Fondation Boghossian, centre d\u2019art et de dialogue entre les culture d\u2019Orient et d\u2019Occident. Une programmation riche et vari\u00e9e de performances, conf\u00e9rences, \u00e9v\u00e9nements festifs, rencontres internationales, visites guid\u00e9es et activit\u00e9s pour enfants est propos\u00e9e au public.","description_print":"Dans la prestigieuse villa Empain, cette fondation vise \u00e0 d\u00e9velopper \u00e0 Bruxelles un centre de cr\u00e9ation et de dialogue entre l\u2019Orient et l\u2019Occident. Une programmation vari\u00e9e d\u2019activit\u00e9s culturelles est pr\u00e9vue pour le public.","booking_url":null,"sort_order":"BOGHOSSIAN FOUNDATION - VILLA EMPAIN","virtual_visit":null},"nl":{"name":"Boghossian Stichting - Villa Empain","address_street_name":"Franklin Rooseveltlaan","address_street_number":"67","address_street_box":null,"email":"info@boghossianfoundation.be","website":"http:\/\/www.villaempain.com","phone_contact":"+32 2 627 52 30","phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"Franklin Rooseveltlaan, 67","address_line2":"1050 Elsene","description_web":"Een centrum voor kunst en dialoog tussen de oosterse en de westerse cultuur . E\u00e9n van de belangrijkste doelstellingen van de Boghossian-stichting is het oprichten van een centrum van culturele en artistieke dialoog tussen het Oosten en het Westen. Haar uitvalsbasis is de prestigieuze villa Empain, waarin ze allerhande culturele activiteiten organiseert voor het publiek.","description_print":"Een centrum voor kunst en dialoog tussen de oosterse en de westerse cultuur . E\u00e9n van de belangrijkste doelstellingen van de Boghossian-stichting is het oprichten van een centrum van culturele en artistieke dialoog tussen het Oosten en het Westen. Haar uitvalsbasis is de prestigieuze villa Empain, waarin ze allerhande culturele activiteiten organiseert voor het publiek.","booking_url":null,"sort_order":"BOGHOSSIAN FOUNDATION - VILLA EMPAIN","virtual_visit":null},"en":{"name":"Boghossian Foundation - Villa Empain","address_street_name":"Avenue Franklin Roosevelt","address_street_number":"67","address_street_box":null,"email":"info@boghossianfoundation.be","website":"http:\/\/www.villaempain.com","phone_contact":"+32 2 627 52 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Franklin Roosevelt, 67","address_line2":"1050 Ixelles","description_web":"A villa in Art Deco style which is now home to the Boghossian Foundation: a centre for art and dialogue between Oriental and Western culture.\r\n\r\n  ","description_print":"A villa in Art Deco style which is now home to the Boghossion Foundation: a centre for art and dialogue between Oriental and Western culture.","booking_url":null,"sort_order":"BOGHOSSIAN FOUNDATION - VILLA EMPAIN","virtual_visit":null},"de":{"name":"Boghossian-Stiftung \u2013 Villa Empain","address_street_name":"Avenue Franklin Roosevelt","address_street_number":"67","address_street_box":null,"email":"info@boghossianfoundation.be","website":"http:\/\/www.villaempain.com","phone_contact":"+32 2 627 52 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Franklin Roosevelt, 67","address_line2":"1050 Ixelles","description_web":"Die Anfang der 1930er-Jahre erbaute Villa Empain ist ein bemerkenswertes Beispiel der Art D\u00e9co-Architektur. Sie geh\u00f6rte einst einer der reichsten Familien Europas, die heute fast vollst\u00e4ndig verarmt ist. Die Villa steht seit 2007 unter Denkmalschutz.\r\n\r\nJugendstil, Art D\u00e9co und Moderne: Ihr Architekt Michel Polak (1885\u20131948) kombinierte Zierelemente des Br\u00fcsseler Jugendstils mit Formen der Moderne: Ein Gesamtkunstwerk, bei dem Formen und edle Materialien der eleganten Ausstattung untrennbar zu einer ungew\u00f6hnlichen und imposanten Einheit verschmelzen.\r\n\r\nVom drohenden Verfall zur aufwendigen Restaurierung: Nach der zwischenzeitlichen Nutzung als sowjetische Botschaft und als Studio des Fernsehsenders RTL wurde die Villa nach aufwendiger Restaurierung zur imposanten Kulisse der Kulturstiftung Fondation Boghossian.","description_print":"","booking_url":null,"sort_order":"BOGHOSSIAN FOUNDATION - VILLA EMPAIN","virtual_visit":null},"it":{"name":"Fondation Boghossian \u2013 Villa Empain","address_street_name":"Avenue Franklin Roosevelt","address_street_number":"67","address_street_box":null,"email":"info@boghossianfoundation.be","website":"http:\/\/www.villaempain.com","phone_contact":"+32 2 627 52 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Franklin Roosevelt, 67","address_line2":"1050 Ixelles","description_web":"La Villa Empain \u00e8 uno straordinario esempio di architettura Art Deco costruita all'inizio degli anni '30. Oggi ospita il Centro de'Art e Dialogo tra Oriente e Occidente....\r\n\r\nLa Villa Empain \u00e8 uno straordinario esempio di architettura Art Deco costruita all'inizio degli anni '30. Oggi ospita il Centro de'Art e Dialogo tra Oriente e Occidente.\r\nVilla Empain \u00e8 anche la sede internazionale della Fondazione Boghossian, che opera in molti paesi dal 1992.\r\nEdificio classificato dal 2007, \u00e8 stata interamente restaurata seguendo scrupolosamente le strutture originali.\r\n\r\nDa non perdere.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Villa Empain, Fundaci\u00f3n Boghossian","address_street_name":"Avenue Franklin Roosevelt","address_street_number":"67","address_street_box":null,"email":"info@boghossianfoundation.be","website":"http:\/\/www.villaempain.com","phone_contact":"+32 2 627 52 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Franklin Roosevelt, 67","address_line2":"1050 Ixelles","description_web":"La Villa Empain es un testigo destacado de la arquitectura Art d\u00e9co.\r\nConstruida a principios de los a\u00f1os 1930 y ubicada en el centro de la capital europea, se ha convertido en un Centro de Arte y de Di\u00e1logo imprescindible.\u00a0\r\n\r\nEs igualmente la sede internacional de la Fundaci\u00f3n Boghossian, que trabaja en distintos pa\u00edses desde el a\u00f1o 1992. Declarado monumento en el a\u00f1o 2007, ha sido restaurando siguiendo los criterios del edificio original.\u00a0A fecha de hoy, alberga diferentes exposiciones y actividades.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Fondation Boghossian \u2013 Villa Empain","address_street_name":"Avenue Franklin Roosevelt","address_street_number":"67","address_street_box":null,"email":"info@boghossianfoundation.be","website":"http:\/\/www.villaempain.com","phone_contact":"+32 2 627 52 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Franklin Roosevelt, 67","address_line2":"1050 Ixelles","description_web":