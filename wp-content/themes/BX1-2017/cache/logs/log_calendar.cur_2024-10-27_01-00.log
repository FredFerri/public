:["Highlight"],"nl":["Highlight"]}},"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":["major_event"]},{"id":5700002604,"date_start":"2024-10-22","date_end":"2024-11-02","date_next":"2024-11-02","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-10-23T02:00:54+02:00","published_at":"2024-10-14T17:04:50+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":309736,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"other","ranking":0.43679023236814946,"languages":{"spoken":["en","fr"],"subtitles":[]},"categories":{"main":{"id":90,"translations":{"de":"Animationen","pt":null,"en":"Animations","it":"Animazioni","cn":null,"fr":"Animations","sp":"Animaciones","nl":"Animaties"}},"others":{"list":[99],"translations":{"de":["Gastronomie"],"pt":[null],"en":["Gastronomy"],"it":["Cucina"],"cn":[null],"fr":["Gastronomie"],"sp":["Gastronom\u00eda"],"nl":["Gastronomie"]}}},"translations":{"de":{"name":"The Wiltcher's gastronomic festival : congo edition","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/hrewards.com\/en\/steigenberger-icon-wiltchers-bruessel","email":"fandb.brussels@steigenberger.com","phone_contact":"+32 2 542 42 42","phone_booking":"+32 2 542 48 51","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700002604"},"pt":{"name":"The Wiltcher's gastronomic festival : congo edition","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/hrewards.com\/en\/steigenberger-icon-wiltchers-bruessel","email":"fandb.brussels@steigenberger.com","phone_contact":"+32 2 542 42 42","phone_booking":"+32 2 542 48 51","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700002604"},"en":{"name":"The Wiltcher's gastronomic festival : congo edition","shortdescr":"From October 22th until November 2nd, every day except Sundays and Mondays, chef Olivier Monkisheme will bring out the flavors of Congo to your taste buds. Cultural and Musical entertainment will be offered to you through meet and greets with congolese artist Barly Baruti and singer Yannick Nkoy.","longdescr":"The Wiltcher's Gastronomic Festival comes back for a new edition: Congo!\n\nAll year long, we invite food amateurs to experience a worldly culinary adventure, each edition aiming to explore new flavors and cultures. Our guests can extend this amazing experience by booking a luxurious stay in one of our elegant suites looking over Avenue Louise.\n\nFrom October 22th until November 2nd, every day except Sundays and Mondays, chef Olivier Monkisheme will bring out the flavors of Congo to your taste buds. Cultural and Musical entertainment will be offered to you through meet and greets with congolese artist Barly Baruti and singer Yannick Nkoy.\n\nJoin us at Caf\u00e9 Wiltcher's for nights of Culture and Gastronomy !\n\nCongolese buffet 85\u20ac\n(with a 50% discount for children aged 6 to 12)\nincluding all offerings except for beverages","performers":"Chef Olivier Monkisheme, congolese artist Barly Baruti and singer Yannick Nkoy.","boxoffice_url":null,"website":"https:\/\/hrewards.com\/en\/steigenberger-icon-wiltchers-bruessel","email":"fandb.brussels@steigenberger.com","phone_contact":"+32 2 542 42 42","phone_booking":"+32 2 542 48 51","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700002604"},"it":{"name":"The Wiltcher's gastronomic festival : congo edition","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/hrewards.com\/en\/steigenberger-icon-wiltchers-bruessel","email":"fandb.brussels@steigenberger.com","phone_contact":"+32 2 542 42 42","phone_booking":"+32 2 542 48 51","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700002604"},"cn":{"name":"The Wiltcher's gastronomic festival : congo edition","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/hrewards.com\/en\/steigenberger-icon-wiltchers-bruessel","email":"fandb.brussels@steigenberger.com","phone_contact":"+32 2 542 42 42","phone_booking":"+32 2 542 48 51","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700002604"},"fr":{"name":"Festival gastronomique du Wiltcher's : \u00e9dition congo","shortdescr":"Du 22 octobre au 2 novembre, tous les jours sauf les dimanches et lundis, le chef Olivier Monkisheme fera d\u00e9couvrir les saveurs du Congo \u00e0 vos papilles. Des animations culturelles et musicales vous seront propos\u00e9es \u00e0 travers des rencontres avec l'artiste congolais Barly Baruti et le chanteur Yannick Nkoy.","longdescr":"Le festival gastronomique Wiltcher's revient pour une nouvelle \u00e9dition : Congo!\n\nTout au long de l'ann\u00e9e, nous invitons les amateurs de cuisine \u00e0 vivre une aventure culinaire mondiale, chaque \u00e9dition visant \u00e0 explorer de nouvelles saveurs et cultures. Nos invit\u00e9s peuvent prolonger cette exp\u00e9rience en r\u00e9servant un s\u00e9jour luxueux dans l'une de nos suites \u00e9l\u00e9gantes donnant sur l'avenue Louise.\n\nDu 22 octobre au 2 novembre, tous les jours sauf les dimanches et lundis, le chef Olivier Monkisheme fera d\u00e9couvrir les saveurs du Congo \u00e0 vos papilles. Des animations culturelles et musicales vous seront propos\u00e9es \u00e0 travers des rencontres avec l'artiste congolais Barly Baruti et le chanteur Yannick Nkoy.\n\nRejoignez-nous sur Caf\u00e9 Wiltcher's pour des nuits de culture et de gastronomie !\n\nBuffet congolais 85\u20ac\n(avec une r\u00e9duction de 50% pour les enfants de 6 \u00e0 12 ans)\nincluant toutes les offres \u00e0 l'exception des boissons","performers":"Le chef Olivier Monkisheme, l'artiste congolais Barly Baruti et le chanteur Yannick Nkoy.","boxoffice_url":null,"website":"https:\/\/hrewards.com\/en\/steigenberger-icon-wiltchers-bruessel","email":"fandb.brussels@steigenberger.com","phone_contact":"+32 2 542 42 42","phone_booking":"+32 2 542 48 51","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700002604"},"sp":{"name":"The Wiltcher's gastronomic festival : congo edition","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/hrewards.com\/en\/steigenberger-icon-wiltchers-bruessel","email":"fandb.brussels@steigenberger.com","phone_contact":"+32 2 542 42 42","phone_booking":"+32 2 542 48 51","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700002604"},"nl":{"name":"The Wiltcher's gastronomic festival : congo edition","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/hrewards.com\/en\/steigenberger-icon-wiltchers-bruessel","email":"fandb.brussels@steigenberger.com","phone_contact":"+32 2 542 42 42","phone_booking":"+32 2 542 48 51","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700002604"}},"place":{"id":50000275,"translations":{"de":{"name":"Steigenberger Wiltcher's","address_street_name":"Avenue Louise ","address_street_number":"71","address_street_box":null,"email":"brussels@steigenberger.com","website":"https:\/\/hrewards.com\/en\/steigenberger-icon-wiltchers-bruessel","phone_contact":"+32 2 542 42 42","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Louise , 71","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Steigenberger Wiltcher's","address_street_name":"Avenue Louise ","address_street_number":"71","address_street_box":null,"email":"brussels@steigenberger.com","website":"https:\/\/hrewards.com\/en\/steigenberger-icon-wiltchers-bruessel","phone_contact":"+32 2 542 42 42","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Louise , 71","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Steigenberger Wiltcher's","address_street_name":"Avenue Louise ","address_street_number":"71","address_street_box":null,"email":"brussels@steigenberger.com","website":"https:\/\/hrewards.com\/en\/steigenberger-icon-wiltchers-bruessel","phone_contact":"+32 2 542 42 42","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Louise , 71","address_line2":"1050 Ixelles","description_web":"Only the most legendary Steigenberger hotels are permitted to call themselves \u201cSteigenberger Icons\u201d. Nestled in the most exclusive district on the most prestigious venue Avenue Louise, The Wiltcher's invites you to feel the heartbeat of the city. A unique blend of sophistication, history, and warmth make the Steigenberger Icon Wiltcher\u2019s the ideal place for a quintessentially Belgian experience. The passion and uncompromising five-star superior services are The Wiltcher\u2019s mantra. Unrivaled attention to details ensures a smooth and comfortable stay, with the highest degree of pampering you ever dream of in one of our luxury and elegant rooms. One of the 267 guestrooms is there for you - the most spacious of the city - that displays a sense of calm and serenity. \nIn addition, our esteemed guests have the pleasure of experiencing our diverse culinary offerings. Delight in the culinary artistry of La Canne en Ville, our Michelin-starred restaurant, or savor the ambience of our iconic Loui Bar, renowned for its exquisite cocktails and delectable meals.\nEach of our newly renovated event spaces offers a personality on its own, while providing contemporary and modern features that can host up to 600 people. Our 14 different meeting rooms can be modeled to fit any request, from big events such as a wedding or a concert to small board meetings. We offer our guests a special service with our Green Meeting concept. The aim of this offer is to minimize the ecological impact of an event in all its phases, from planning to execution to departure. \n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Steigenberger Wiltcher's","address_street_name":"Avenue Louise ","address_street_number":"71","address_street_box":null,"email":"brussels@steigenberger.com","website":"https:\/\/hrewards.com\/en\/steigenberger-icon-wiltchers-bruessel","phone_contact":"+32 2 542 42 42","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Louise , 71","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Steigenberger Wiltcher's","address_street_name":"Avenue Louise ","address_street_number":"71","address_street_box":null,"email":"brussels@steigenberger.com","website":"https:\/\/hrewards.com\/en\/steigenberger-icon-wiltchers-bruessel","phone_contact":"+32 2 542 42 42","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Louise , 71","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Steigenberger Wiltcher's","address_street_name":"Avenue Louise ","address_street_number":"71","address_street_box":null,"email":"brussels@steigenberger.com","website":"https:\/\/hrewards.com\/en\/steigenberger-icon-wiltchers-bruessel","phone_contact":"+32 2 542 42 42","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Louise , 71","address_line2":"1050 Ixelles","description_web":"Seuls les h\u00f4tels Steigenberger les plus l\u00e9gendaires sont autoris\u00e9s \u00e0 s'appeler \u00ab Steigenberger Icons \u00bb. Nich\u00e9 dans le quartier le plus exclusif de la prestigieuse avenue Louise, le Wiltcher's vous invite \u00e0 sentir battre le c\u0153ur de la ville. Un m\u00e9lange unique de sophistication, d'histoire et de chaleur fait de l'ic\u00f4ne Steigenberger Wiltcher's l'endroit id\u00e9al pour vivre une exp\u00e9rience typiquement belge. La passion et les services de qualit\u00e9 sup\u00e9rieure cinq \u00e9toiles sans compromis sont le mantra du Wiltcher's. L'attention in\u00e9gal\u00e9e port\u00e9e aux d\u00e9tails garantit un s\u00e9jour agr\u00e9able et confortable, avec le plus haut degr\u00e9 de chouchoutage dont vous pouvez r\u00eaver dans l'une de nos chambres luxueuses et \u00e9l\u00e9gantes. L'une des 267 chambres est l\u00e0 pour vous - la plus spacieuse de la ville - qui affiche un sentiment de calme et de s\u00e9r\u00e9nit\u00e9. \nEn outre, nos clients estim\u00e9s ont le plaisir de d\u00e9couvrir nos diverses offres culinaires. Laissez-vous s\u00e9duire par l'art culinaire de La Canne en Ville, notre restaurant \u00e9toil\u00e9 au Michelin, ou savourez l'ambiance de notre embl\u00e9matique Loui Bar, r\u00e9put\u00e9 pour ses cocktails exquis et ses repas d\u00e9lectables.\nChacun de nos espaces \u00e9v\u00e9nementiels r\u00e9cemment r\u00e9nov\u00e9s offre une personnalit\u00e9 propre, tout en pr\u00e9sentant des caract\u00e9ristiques contemporaines et modernes pouvant accueillir jusqu'\u00e0 600 personnes. Nos 14 salles de r\u00e9union diff\u00e9rentes peuvent \u00eatre mod\u00e9lis\u00e9es pour r\u00e9pondre \u00e0 toutes les demandes, qu'il s'agisse de grands \u00e9v\u00e9nements tels qu'un mariage ou un concert ou de petites r\u00e9unions de conseil d'administration. Nous offrons \u00e0 nos h\u00f4tes un service sp\u00e9cial avec notre concept Green Meeting. L'objectif de cette offre est de minimiser l'impact \u00e9cologique d'un \u00e9v\u00e9nement dans toutes ses phases, de la planification \u00e0 l'ex\u00e9cution et au d\u00e9part. \n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":"https:\/\/shorturl.at\/eqP38","visit_url":null},"sp":{"name":"Steigenberger Wiltcher's","address_street_name":"Avenue Louise ","address_street_number":"71","address_street_box":null,"email":"brussels@steigenberger.com","website":"https:\/\/hrewards.com\/en\/steigenberger-icon-wiltchers-bruessel","phone_contact":"+32 2 542 42 42","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Louise , 71","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Steigenberger Wiltcher's","address_street_name":"Avenue Louise ","address_street_number":"71","address_street_box":null,"email":"brussels@steigenberger.com","website":"https:\/\/hrewards.com\/en\/steigenberger-icon-wiltchers-bruessel","phone_contact":"+32 2 542 42 42","phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"Avenue Louise , 71","address_line2":"1050 Elsene","description_web":"Alleen de meest legendarische Steigenberger hotels mogen zich \u201cSteigenberger Iconen\u201d noemen. Wiltcher's ligt in de meest exclusieve wijk aan de prestigieuze Louizalaan en nodigt u uit om de hartslag van de stad te voelen. Een unieke mix van verfijning, geschiedenis en warmte maken het Steigenberger Icon Wiltcher's de ideale plek voor een typisch Belgische ervaring. De passie en compromisloze vijfsterren superieure diensten zijn de mantra van The Wiltcher's. Onge\u00ebvenaarde aandacht voor details zorgt voor een vlot en comfortabel verblijf, met de hoogste graad van verwennerij waar u ooit van gedroomd hebt in een van onze luxueuze en elegante kamers. Een van de 267 gastenkamers ligt voor u klaar - de ruimste van de stad - die een gevoel van rust en sereniteit uitstralen. \nDaarnaast hebben onze gewaardeerde gasten het genoegen om ons gevarieerde culinaire aanbod te ervaren. Geniet van de culinaire kunsten van La Canne en Ville, ons met een Michelin-ster bekroonde restaurant, of proef de ambiance van onze iconische Loui Bar, bekend om zijn exquise cocktails en verrukkelijke maaltijden.\nElk van onze onlangs gerenoveerde evenementenruimten heeft een eigen persoonlijkheid en biedt eigentijdse en moderne voorzieningen voor maximaal 600 personen. Onze 14 verschillende vergaderzalen kunnen worden aangepast aan elk verzoek, van grote evenementen zoals een bruiloft of een concert tot kleine bestuursvergaderingen. We bieden onze gasten een speciale service met ons Green Meeting-concept. Het doel van dit aanbod is om de ecologische impact van een evenement in alle fasen te minimaliseren, van planning tot uitvoering tot vertrek.\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[],"translations":{}},"zones":[],"neca":null,"facebook_id":null,"backoffice_id":41018,"location":{"lat":50.8324776,"lon":4.3574737},"region":"brussels","last_updated_at":"2024-05-24T15:02:34+02:00","published_at":"2023-07-31T09:16:24+02:00","import_origin":"crm","external_id":null,"is_in_address_book":false,"is_in_vb_export":false,"resto_ranking":0},"organizer":{"id":50000275,"translations":{"de":{"name":"Steigenberger Wiltcher's","address_street_name":"Avenue Louise ","address_street_number":"71","address_street_box":null,"email":"brussels@steigenberger.com","website":"https:\/\/hrewards.com\/en\/steigenberger-icon-wiltchers-bruessel","phone_contact":"+32 2 542 42 42","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Louise , 71","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"bookin