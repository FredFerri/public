festival.be\/fr\/fame-event\/mauvaise-herbes\/","email":"info@famefestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50000955"},"pt":{"name":"Mauvaises Herbes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/famefestival.be\/fr\/fame-event\/mauvaise-herbes\/","email":"info@famefestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50000955"},"en":{"name":"Mauvaises Herbes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/famefestival.be\/fr\/fame-event\/mauvaise-herbes\/","email":"info@famefestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50000955"},"it":{"name":"Mauvaises Herbes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/famefestival.be\/fr\/fame-event\/mauvaise-herbes\/","email":"info@famefestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50000955"},"cn":{"name":"Mauvaises Herbes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/famefestival.be\/fr\/fame-event\/mauvaise-herbes\/","email":"info@famefestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50000955"},"fr":{"name":"Mauvaises Herbes","shortdescr":"Promenade botanique autour des plantes sauvages de Bruxelles. Guid\u00e9e par leurs bizarro\u00efdes et jouissifs noms populaires. ","longdescr":"\n\nUne marche lente \u00e0 fleur de terre pour d\u00e9couvrir les richesses cach\u00e9es derri\u00e8re les plantes qui poussent sauvagement entre les fissures du b\u00e9ton et les l\u00e9zardes des murs. Des richesses d\u00e9voil\u00e9es une par une \u00e0 travers la d\u00e9couverte des noms populaires et de leurs significations.\n\nUne promenade bas\u00e9e sur le livre l\u2019Atlas des plantes de mauvaise vie, paru aux \u00e9ditions H\u00e9lice Helas.","performers":"Aldwin Raoul \u00b7 Olivia Moln\u00e1r","boxoffice_url":null,"website":"https:\/\/famefestival.be\/fr\/fame-event\/mauvaise-herbes\/","email":"info@famefestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50000955"},"sp":{"name":"Mauvaises Herbes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/famefestival.be\/fr\/fame-event\/mauvaise-herbes\/","email":"info@famefestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50000955"},"nl":{"name":"Mauvaises Herbes","shortdescr":"Een botanische wandeling rond de wilde planten van Brussel. Geleid door hun bizarre en verrukkelijke populaire namen.","longdescr":"\n\nEen langzame wandeling ter hoogte van de grond om de rijkdommen te ontdekken die schuilgaan achter de planten die wild groeien tussen de scheuren in het beton en de barsten in de muren. E\u00e9n voor \u00e9\u00e9n worden deze rijkdommen onthuld aan de hand van de volksnamen en hun betekenis.\n\nEen wandeling gebaseerd op het boek L\u2019 Atlas des Plantes de Mauvaise Vie, uitgegeven door H\u00e9lice Helas.\n","performers":"Onkruid","boxoffice_url":null,"website":"https:\/\/famefestival.be\/fr\/fame-event\/mauvaise-herbes\/","email":"info@famefestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50000955"}},"place":{"id":249426,"translations":{"de":{"name":"The Riches Claires street","address_street_name":"Rue des Riches Claires","address_street_number":"18","address_street_box":null,"email":"info@contedefees.be","website":null,"phone_contact":"+32 485 57 38 55","phone_bookin