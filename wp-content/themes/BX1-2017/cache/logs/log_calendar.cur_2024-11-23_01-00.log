elle.be","email":"communication@osamoelle.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50013316"},"it":{"name":"La Femme de Feydeau","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.osamoelle.be","email":"communication@osamoelle.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50013316"},"cn":{"name":"La Femme de Feydeau","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.osamoelle.be","email":"communication@osamoelle.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50013316"},"fr":{"name":"La Femme de Feydeau","shortdescr":null,"longdescr":"Georges Feydeau est l'homme de l'adult\u00e8re et du rire. Mais Feydeau avait aussi une femme. Que pense-t-elle de tout cela ? Et que pense-t-elle d'un mari qui d\u00e9couche pour \"travailler\" \u00e0 l'h\u00f4tel ?\nMarianne (puisque voil\u00e0 son pr\u00e9nom) compte bien venir fourrer son nez dans les nouveaux \u00e9crits de son cher \u00e9poux...pour le meilleur et pour le pire.\n\nEn passant par les pi\u00e8ces \"Dormez, je le veux\" et \"Gibier de potence\", les com\u00e9diens raconteront aussi un auteur et ses relations conflictuelles avec sa femme et ses com\u00e9diens. Un spectacle d\u00e9cal\u00e9 autour d'un homme qui l'\u00e9tait d\u00e9j\u00e0 pas mal.\n\nAvec : Am\u00e9lie de Casterl\u00e9, Fran\u00e7ois Doms, Kevin Ecobecq, John Krier, Florent Minotti et Charlotte Mousset.\n\nMontage et mise en sc\u00e8ne de Maxime Anselin","performers":null,"boxoffice_url":null,"website":"http:\/\/www.osamoelle.be","email":"communication@osamoelle.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50013316"},"sp":{"name":"La Femme de Feydeau","shortd