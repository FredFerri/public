rs\/agenda\/event-detail.50013085"},"it":{"name":"Drafts : Visite guid\u00e9e pour visiteurs individuels","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/fine-arts-museum.be\/fr\/agenda\/2024\/10\/19\/visite-guidee-pour-visiteurs-individuels-101","email":"reservation@fine-arts-museum.be","phone_contact":"+32 2 508 33 33","phone_booking":"+32 2 508 33 33","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50013085"},"cn":{"name":"Drafts : Visite guid\u00e9e pour visiteurs individuels","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/fine-arts-museum.be\/fr\/agenda\/2024\/10\/19\/visite-guidee-pour-visiteurs-individuels-101","email":"reservation@fine-arts-museum.be","phone_contact":"+32 2 508 33 33","phone_booking":"+32 2 508 33 33","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50013085"},"fr":{"name":"Drafts : Visite guid\u00e9e pour visiteurs individuels","shortdescr":null,"longdescr":"Des \u00ab primitifs \u00bb flamands aux peintres modernes en passant par Peter Paul Rubens, Constantin Meunier, Rik Wouters, Ren\u00e9 Magritte, Anne Bonnet \u2026 cette visite nous emm\u00e8ne au c\u0153ur du processus cr\u00e9atif qui sous-tend chaque \u0153uvre d'art en compagnie d\u2019un historien ou d\u2019une historienne de l\u2019art.\n\u00c9preuves, croquis, dessins pr\u00e9paratoires, modelli, bozetti\u2026 cette exposition pr\u00e9sente l'esquisse sous toutes ses formes et dans tous ses \u00e9tats, depuis le premier jet jusqu'\u00e0 l'\u0153uvre achev\u00e9e... ou non !\n\nVous d\u00e9sirez passer de la th\u00e9orie \u00e0 la pratique ? Des visites dessin\u00e9es pour le public individuel sont organis\u00e9es tout au long de l'exposition en compagnie d'un.e artiste plasticien.ne. Consultez la rubrique agenda ici.","performers":null,"boxoffice_url":null,"website":"https:\/\/fine-arts-museum.be\/fr\/agenda\/2024\/10\/19\/visite-guidee-pour-visiteurs-individuels-101","email":"reservation@fine-arts-museum.be","phone_contact":"+32 2 508 33 33","phone_booking":"+32 2 508 33 33","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50013085"},"sp":{"name":"Drafts : Visite guid\u00e9e pour visiteurs individuels","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/fine-arts-museum.be\/fr\/agenda\/2024\/10\/19\/visite-guidee-pour-visiteurs-individuels-101","email":"reservation@fine-arts-museum.be","phone_contact":"+32 2 508 33 33","phone_booking":"+32 2 508 33 33","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50013085"},"nl":{"name":"Drafts : Visite guid\u00e9e pour visiteurs individuels","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/fine-arts-museum.be\/fr\/agenda\/2024\/10\/19\/visite-guidee-pour-visiteurs-individuels-101","email":"reservation@fine-arts-museum.be","phone_contact":"+32 2 508 33 33","phone_booking":"+32 2 508 33 33","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50013085"}},"place":{"id":488,"translations":{"de":{"name":"Mus\u00e9es Royaux des Beaux-Arts de Belgique","address_street_name":"Rue de la R\u00e9gence","address_street_number":"3","address_street_box":null,"email":"info@fine-arts-museum.be","website":"http:\/\/www.fine-arts-museum.be","phone_contact":"+32 2 508 32 11","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la R\u00e9gence, 3","address_line2":"1000 Bruxelles","description_web":"Die Mus\u00e9es Royaux des Beaux-Arts de Belgique \u2013 6 Museen, 7 Jahrhunderte der sch\u00f6nen K\u00fcnste, 20 000 Kunstwerke und Kunstgenuss vom Feinsten:\r\n\r\n\u2022\tIm Mus\u00e9e Magritte gibt es die weltweit gr\u00f6\u00dfte Sammlung von Werken des gro\u00dfen belgischen Surrealisten Ren\u00e9 Magritte zu entdecken\r\n\r\n\u2022\tIm Mus\u00e9e Fin-de-Si\u00e8cle erwartet den Besucher mit K\u00fcnstlern wie Khnopff, Spilliaert, Horta, Rodin, Gauguin, Mucha und Bonnard das besondere Fin-de-Si\u00e8cle-Ambiente, das um 1900 in Br\u00fcssel herrschte. Mehr als 30 K\u00fcnstler \u2013 vom Impressionismus \u00fcber den Jugendstil, von den sch\u00f6nen K\u00fcnsten bis zur Oper.\r\n\r\n\u2022\tIm Mus\u00e9e Old Master gibt es Meisterwerke aus der Epoche des 15. Jahrhunderts bis hin zum 18. Jahrhundert zu sehen, unter anderem mit der weltweit gr\u00f6\u00dften Bruegel-Sammlung, verschiedenen Werken von Rubens, van der Weyden und Jordaens. \r\n\r\n\u2022\tDas Mus\u00e9e Modern Art zeigt eine Auswahl von Meisterwerken des 20. Jahrhunderts, darunter Broodthaers, Fabre, David, Panamarenko, Alechinsky.\r\n\r\n\u2022\tDie beiden Kunstatelier-Museen Mus\u00e9e Wiertz und Meunier in Ixelles geben einen faszinierenden Einblick in die Welt dieser beiden K\u00fcnstler.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Mus\u00e9es Royaux des Beaux-Arts de Belgique","address_street_name":"Rue de la R\u00e9gence","address_street_number":"3","address_street_box":null,"email":"info@fine-arts-museum.be","website":"http:\/\/www.fine-arts-museum.be","phone_contact":"+32 2 508 32 11","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la R\u00e9gence, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Royal Museums of Fine Arts of Belgium","address_street_name":"rue de la R\u00e9gence","address_street_number":"3","address_street_box":null,"email":"info@fine-arts-museum.be","website":"http:\/\/www.fine-arts-museum.be","phone_contact":"+32 2 508 32 11","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"rue de la R\u00e9gence, 3","address_line2":"1000 Brussels","description_web":"The Royal Museums o