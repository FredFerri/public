26","doors":"20:00:00","start":"20:30:00","end":null,"is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":20},{"translations":{"fr":{"name":"Jeunes"},"nl":{"name":"Jongeren"},"en":{"name":"Young people"}},"value":15}],"child_events":[],"parent_events":[539149],"targets":{"list":[],"translations":{}},"visit_profile":{"list":[326],"translations":{"fr":["Jazz"],"nl":["Jazz"],"en":["Jazz"],"de":["Jazz"]}},"visit_content":{"list":[360],"values":["cafe-theatre"]},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-11-02T16:05:05+01:00","published_at":"2022-09-05T09:11:40+02:00","backoffice_id":260948,"import_origin":null,"sub_type":"concert","show_in_agenda":true,"ranking":1.2599210498949},{"id":544453,"date_start":"2022-11-26","date_end":"2022-11-26","date_next":"2022-11-26","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":true,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert","de":"Konzert"}},"others":{"list":[4,6],"translations":{"fr":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"],"nl":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"],"en":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"],"de":["Pop, Rock, Jazz...","Worldmusic, Folk & Country"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Toasaves (BE\/CYP\/ESP) - Sortie d'album 'Zwerver'","shortdescr":"Sur la route de Wannes van de Velde","longdescr":"Toasaves est un collectif musical belge, fascin\u00e9 par le folklore des chansons flamandes ancestrales ainsi que leur relation avec la musique ancienne et orientale. Sur leur premier album Zwerver (Muziekpublique 015), Toasaves reprend des compositions du Groot Liedboek de Wannes van de Velde (1937-2008). Cet artiste-chanteur anversois a marqu\u00e9 sa ville par un r\u00e9pertoire d\u2019anciennes balades et litanies, auquel il a donn\u00e9 un nouveau souffle.\r\nC\u2019est dans l\u2019esprit de Wannes que nos troubadours emm\u00e8nent leur auditoire le long des divers ports europ\u00e9ens et baign\u00e9 dans sonorit\u00e9s iod\u00e9es. Un parcourt qui d\u00e9bute \u00e0 Anvers, o\u00f9 Wannes s\u2019est d\u00e8s sa jeunesse fait influencer par une kyrielle de cultures, langues, histoires et musiques et passe aussi par le port d\u2019attache symbolique de Bruxelles, symbole de cosmopolitisme.\r\n\r\nPartant du r\u00e9pertoire folklorique de Wannes van de Velde, le groupe cherche n\u00e9anmoins \u00e0 se r\u00e9approprier les balades qui sont au c\u0153ur du projet. La mise en avant et le savant m\u00e9lange d\u2019instruments traditionnels d\u2019Orient et d\u2019Occident \u2013 fl\u00fbtes, tambours, cistres et violons m\u00e9di\u00e9vaux, violon oriental, luths et tambours sur cadre turcs, vi\u00e8le \u00e0 roue, cornemuses flamandes et irlandaises, dilruba et bansuri indiens, rebab afghan ou encore santur perse \u2013  font briller d\u2019une sublime teinte les traditions musicales de d\u00e9part.","performers":"Tristan Driessens: oud, lavta, chant, arrangements, direction artistique\r\nRapha\u00ebl De Cock: chant, guimbarde, cornemuses, uillean pipes.\r\nHarald Bauweraerts: vi\u00e8le \u00e0 roue\r\nMiriam Encinas: flutes, santur, vi\u00e8le, dilruba, percussion.\r\nMichalis Kouloumis: violon\r\nMicha\u00eblle Gr\u00e9bil Liberg: luth m\u00e9di\u00e9val, cistre \u00e0 archet, rebab afghan, cetera corse, chant\r\nDick van der Harst: percussion","boxoffice_url":null,"website":"http:\/\/www.muziekpublique.be","email":"info@muziekpublique.be","phone_contact":null,"phone_booking":"+32 2 217 26 00","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.544453"},"nl":{"name":"Toasaves (BE\/CYP\/ESP) - Cd-release Zwerver","shortdescr":"Op reis met Wannes van de Velde","longdescr":"Toasaves is een Belgisch muziekcollectief met fascinatie voor archa\u00efsche Vlaamse volksliederen en de verhouding tot Oude Muziek en Oosterse muziek. Op hun eerste album \u201cZwerver\u201d (Muziekpublique 015) vertrekt Toasaves vanuit de composities en het Groot Liedboek van Wannes van de Velde (1937-2008), de zanger-artiest die in zijn thuishaven Antwerpen de oudste bewaard gebleven ballades en litanie\u00ebn nieuw leven inblies. In de geest van Wannes nemen deze troubadours de luisteraar op sleeptouw langsheen verschillende Europese wereldhavens en de klanken die over zee komen aangewaaid. Uiteraard is er kosmopolitische haven van Antwerpen, waar Wannes als jongeling al snel in contact kwam met allerlei culturen die via hun taal, geschiedenis en muziek hun stempel drukten op zijn denken en muzikale queeste, maar er is ook de symbolische thuishaven Brussel waarin mensen uit alle hoeken van de wereld komen aangewaaid.\r\n\r\nDankzij virtuoze uitvoeringen op traditionele instrumenten uit Oost en West \u2013  Middeleeuwse fluiten, trommels, cisters en vedels, Oosterse viool, Turkse luiten (lavta en \u2018\u00fbd) en framedrums (daf, bendir, pandero cuadrado), draailier, Vlaamse en Ierse doedelzakken, Indische dilruba en bansuri, Afghaanse rebab, Perzische santur, \u2026, wordt nieuw licht geworpen op de eigenlijke bron van muziektradities die, in tijd en ruimte van elkaar gescheiden, vaak dezelfde po\u00ebtische en muzikale geheimen bevatten. Vertrekkend van het volksrepertoire van Wannes van de Velde vindt het reisgezelschap een verrassend aanknopingspunt in Oude Muziek, traditionele dansmuziek uit de Griekse eilanden, klassieke hofmuziek (makam) uit Istanbul en zelfs volksmuziek uit Afghanistan!","performers":"Tristan Driessens: \u2018\u00fbd, lavta, zang, arrangementen, artistieke leiding\r\nRapha\u00ebl De Cock: zang, Vlaamse doedelzak, uilleann pipes, mondharp\r\nHarald Bauweraerts: draailier, zang\r\nMiriam Encinas: dilruba, blokfluiten en vedel, daf, santur, percussie\r\nMichalis Kouloumis: viool\r\nMicha\u00eblle Gr\u00e9bil Liberg: boogcister, cetera, Middeleeuwse luit, vedel, Afghaanse rebab, zang\r\nDick van der Harst: percussie","boxoffice_url":null,"website":"http:\/\/www.muziekpublique.be","email":"info@muziekpublique.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.544453"},"en":{"name":"Toasaves (BE\/CYP\/ESP) - Album release 'Zwerver'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.544453"},"de":{"name":"Toasaves (BE\/CYP\/ESP) - Sortie d'album 'Zwerver'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.544453"},"it":{"name":"Toasaves (BE\/CYP\/ESP) - Sortie d'album 'Zwerver'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.544453"},"sp":{"name":"Toasaves (BE\/CYP\/ESP) - Sortie d'album 'Zwerver'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.544453"},"pt":{"name":"Toasaves (BE\/CYP\/ESP) - Sortie d'album 'Zwerver'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.544453"},"cn":{"name":"Toasaves (BE\/CYP\/ESP) - Sortie d'album 'Zwerver'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.544453"}},"place":{"id":238099,"translations":{"fr":{"name":"Muziekpublique","address_street_name":"Galerie de la Porte de Namur","address_street_number":"3","address_street_box":null,"email":"info@muziekpublique.be","website":"http:\/\/www.muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":"+32 2 217 26 00","address_zip":"1050","address_city":"Ixelles","address_line1":"Galerie de la Porte de Namur, 3","address_line2":"1050 Ixelles","description_web":"Muziekpublique est le centre des musiques traditionnelles du monde de Bruxelles. Etablie dans le Th\u00e9\u00e2tre Moli\u00e8re au c\u0153ur du quartier africain, l\u2019asbl organise plus de 100 concerts par an et deux festivals (Hide & Seek Festival etc.). Par ailleurs Muziekpublique propose aussi 50 cours de musique et de danse du monde, comptant plus de 600 \u00e9l\u00e8ves. Ensuite, l\u2019asbl d\u00e9veloppe certains artistes et projets via son label, qui est aussi une agence de booking et de management. La musique traditionnelle a donc trouv\u00e9 un endroit id\u00e9al o\u00f9 se d\u00e9velopper et les artistes y constituent un r\u00e9seau vivant et dynamique cr\u00e9ant des liens de qualit\u00e9 avec le public. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Muziekpublique","address_street_name":"Galerij van de Naamsepoort","address_street_number":"3","address_street_box":null,"email":"info@muziekpublique.be","website":"http:\/\/www.muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":"+32 2 217 26 00","address_zip":"1050","address_city":"Elsene","address_line1":"Galerij van de Naamsepoort, 3","address_line2":"1050 Elsene","description_web":"Muziekpublique verspreidt en promoot muziek- en danstradities via een ambitieus programma van concerten, cursussen en projecten. Een jaarrond concertprogramma met Belgische en internationale artiesten vormt de kern van de activiteiten van de organisatie. Van contemplatieve tot feestelijke concerten vinden het hele jaar door plaats in het prachtige Moli\u00e8re Theater, aan de Naamsepoort, maar ook op verschillende plaatsen de hoofdstad.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Muziekpublique","address_street_name":"Galerie de la Porte de Namur","address_street_number":"3","address_street_box":null,"email":"info@muziekpublique.be","website":"http:\/\/www.muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":"+32 2 217 26 00","address_zip":"1050","address_city":"Ixelles","address_line1":"Galerie de la Porte de Namur, 3","address_line2":"1050 Ixelles","description_web":"Muziekpublique, keeps music and dance traditions alive and kicking in Brussels through an ambitious programme of concerts, courses, and projects. A year-round concert programme, featuring Belgian and international artists, forms the core of the foundation\u2019s activities. From the contemplative to the madly festive concerts take place indoors,  in the small Moli\u00e8re Theatre, in the arcade at the Porte de Namur and outdoors, around the city and throughout the year.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Muziekpublique","address_street_name":"Galerie de la Porte de Namur","address_street_number":"3","address_street_box":null,"email":"info@muziekpublique.be","website":"http:\/\/www.muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":"+32 2 217 26 00","address_zip":"1050","address_city":"Ixelles","address_line1":"Galerie de la Porte de Namur, 3","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual