ild_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":{"list":[255],"translations":{"fr":["Accessible"],"nl":["Toegankelijk"],"en":["Accessible"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-09-11T01:36:36+02:00","published_at":"2022-08-31T15:51:50+02:00","backoffice_id":260745,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.29487987310847},{"id":534633,"date_start":"2022-06-25","date_end":"2022-09-18","date_next":"2022-09-14","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":118,"translations":{"fr":"Festival","nl":"Festival","en":"Festival"}},"others":{"list":[122],"translations":{"fr":["Dance"],"nl":["Dance"],"en":["Dance"]}}},"languages":{"spoken":["fr","en"],"subtitles":[]},"translations":{"fr":{"name":"Detours Festival","shortdescr":"Le Detours Festival revient pour sa 13e \u00e9dition : TAK TIK Festival, Detours Cyphers, Detours Quartiers, Soir\u00e9e Work in Progress et bien d'autres \u00e9v\u00e9nements au programme ! Sans oublier la grande finale des Detours Cyphers le 18 septembre au Th\u00e9\u00e2tre National.","longdescr":"Cette treizi\u00e8me \u00e9dition du festival sera rythm\u00e9e par les Detours Cyphers, tous les mercredis des mois de juillet, ao\u00fbt et septembre au centre ville de Bruxelles (Mont des Arts), mais aussi \u00e0 Li\u00e8ge (Parc de la Boverie) et \u00e0 Lille (Le Flow). Cette sc\u00e8ne ouverte accueille des artistes locaux\u00b7les (professionnel\u00b7le\u00b7s et amateur\u00b7trice\u00b7s) pour pr\u00e9senter leurs \u0153uvres en cours de cr\u00e9ation, ainsi qu\u2019une programmation professionnelle en art de rue, danse, et cirque. Les styles les plus singuliers en danses urbaines y sont r\u00e9unis : New jack swing\/Hype - House Dance \u2013 Powermove \u2013 Krump \u2013 Funky Style (Poppin \u2013 Lockin \u2013 Waacking) \u2013 Afro Dance \u2013 Robots \u2013 headspin \u2013 footwork \u2013 Voguin \u2026 Cette fois, le ballet classique et l\u2019acro-danse s\u2019ajoutent \u00e0 la liste ! Le Detours Battle se poursuit par une comp\u00e9tition de danse o\u00f9 le public devient jury.\r\n\r\nPlus t\u00f4t que d\u2019habitude, le Detours s\u2019ouvrira par TAK TIK, le nouveau festival participatif, culturel, politique et citoyen \u00e0 destination des 14-17 ans, con\u00e7u pour - et par - elles\u00b7eux. Le 25 et 26 juin, les adolescent\u00b7e\u00b7s seront invit\u00e9\u00b7e\u00b7s, le temps d\u2019un week-end, \u00e0 investir tous les espaces du Th\u00e9\u00e2tre National.\r\n\r\nCette \u00e9dition verra \u00e9galement les Detours Quartiers qui viendront occuper l\u2019espace public bruxellois et ses diff\u00e9rents quartiers : du quartier Chicago, aux Marolles en passant par la Roue \u00e0 Anderlecht.\r\n\r\nLe Detours Festival continuera \u00e0 soutenir la professionnalisation des artistes chor\u00e9graphes urbain\u00b7e\u00b7s de la F\u00e9d\u00e9ration Wallonie-Bruxelles et frontalier\u00b7e\u00b7s \u00e0 travers le volet \u201cWork in progress\u201d. Les 25 et 26 septembre, deux soir\u00e9es \u00e0 plateau partag\u00e9 donneront acc\u00e8s \u00e0 de jeunes chor\u00e9graphes hip-hop aux sph\u00e8res culturelles en pr\u00e9sentant leurs \u0153uvres en cours de cr\u00e9ation. En amont, deux semaines de r\u00e9sidences sont mises \u00e0 disposition de chaque compagnie afin de peaufiner au mieux leur projet.\r\n\r\nCette 13e \u00e9dition se cl\u00f4turera par l'Urban Dance Caravan, le 18 septembre prochain, un spectacle d\u00e9ambulatoire jusqu'au Th\u00e9\u00e2tre National o\u00f9 se d\u00e9roulera la grande finale des Detours Cyphers.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.nowayback.pro","email":"milan.emmanuel@nowayback.pro","phone_contact":"+32 497 39 13 82","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.534633"},"nl":{"name":"Detours Festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.534633"},"en":{"name":"Detours Festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.534633"},"de":{"name":"Detours Festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.534633"},"it":{"name":"Detours Festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.534633"},"sp":{"name":"Detours Festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.534633"},"pt":{"name":"Detours Festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.534633"},"cn":{"name":"Detours Festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.534633"}},"place":{"id":245448,"tr