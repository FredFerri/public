l":null,"website":null,"email":"info@itineraires.be","phone_contact":"+32 2 541 03 77","phone_booking":"+32 2 541 03 77","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.532818"},"it":{"name":"Les coulisses de l\u2019Ommegang","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"info@itineraires.be","phone_contact":"+32 2 541 03 77","phone_booking":"+32 2 541 03 77","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.532818"},"cn":{"name":"Les coulisses de l\u2019Ommegang","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"info@itineraires.be","phone_contact":"+32 2 541 03 77","phone_booking":"+32 2 541 03 77","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.532818"},"fr":{"name":"Les coulisses de l\u2019Ommegang","shortdescr":null,"longdescr":"Deux heures avant l\u2019Ommegang, vous pourrez admirer et vivre les derniers pr\u00e9paratifs de ce spectacle comm\u00e9moratif. Votre guide d\u00e9chiffrera pour votre plaisir le Grand Serment des Arbal\u00e9triers, les luttes \u00e9questres, les corporations de l\u2019\u00e9poque, les rites de la cour de Charles Quint, etc. Suite \u00e0 cette introduction, nous vous invitons \u00e0 assister \u00e0 la sortie de l\u2019Ommegang dans le centre de la ville.\r\n\r\nMise \u00e0 disposition d'un guide pendant 2h.","performers":null,"boxoffice_url":null,"website":null,"email":"info@itineraires.be","phone_contact":"+32 2 541 03 77","phone_booking":"+32 2 541 03 77","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.532818"},"sp":{"name":"Los entresijos del Ommegang","shortdescr":null,"longdescr":"Dos horas antes del Ommegang, podr\u00e1s admirar y experimentar los \u00faltimos preparativos de este espect\u00e1culo conmemorativo. Tu gu\u00eda te descifrar\u00e1 el Gran Juramento de los Ballesteros, las luchas ecuestres, los gremios de la \u00e9poca, los ritos de la corte de Carlos V, etc. Despu\u00e9s de esta introducci\u00f3n, te invitamos a ver el recorrido del Ommegang por el centro de la ciudad.  \r\n\r\nPuesta a disposici\u00f3n de un gu\u00eda durante 2 horas.","performers":null,"boxoffice_url":null,"website":null,"email":"info@itineraires.be","phone_contact":"+32 2 541 03 77","phone_booking":"+32 2 541 03 77","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.532818"},"nl":{"name":"Achter de schermen van de Ommegang","shortdescr":null,"longdescr":"Twee uur voor de start van de Ommegang kan je de laatste voorbereidingen rond dit herdenkingsspektakel bewonderen en beleven. Jouw gids vertelt honderduit over de Grote Eed van de Schuttersgilde, de ruiterstornooien, de gilden uit die tijd, de gebruiken aan het hof van keizer Karel enzovoort . Na die inleiding kan je de Ommegang in het centrum van de stad meemaken. \r\n\r\nTerbeschikkingstelling van een gids gedurende 2 uur.","performers":null,"boxoffice_url":null,"website":null,"email":"info@itineraires.be","phone_contact":"+32 2 541 03 77","phone_booking":"+32 2 541 03 77","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.532818"}},"place":{"id":256078,"translations":{"de":{"name":"Soci\u00e9t\u00e9 Royale de l'Ommegang","address_street_name":"Rue des Tanneurs","address_street_number":"180","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Tanneurs, 180","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Soci\u00e9t\u00e9 Royale de l'Ommegang","address_street_name":"Rue des Tanneurs","address_street_number":"180","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"