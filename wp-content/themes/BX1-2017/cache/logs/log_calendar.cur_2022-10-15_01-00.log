":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater"}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"],"de":["Theater"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"En finir avec Eddy Bellegueule","shortdescr":null,"longdescr":"Bas\u00e9e sur le roman d\u2019Edouard Louis,\r\ncette cr\u00e9ation dresse le portrait d\u2019un ado marginalis\u00e9, n\u00e9 en Picardie dans un milieu pr\u00e9caris\u00e9, en d\u00e9calage constant avec son environnement, entre carence affective et haine de soi. Exclu, harcel\u00e9 et violent\u00e9, il grandit dans un milieu o\u00f9 les gar\u00e7ons doivent rejeter l\u2019\u00e9cole, m\u00e9priser les professeurs, \u00eatre \u00ab un dur \u00bb, travailler \u00e0 l\u2019usine, se retrouver au ch\u00f4mage puis boire pour oublier, et surtout o\u00f9 on d\u00e9teste les \u00ab p\u00e9d\u00e9s \u00bb. Et Eddy est un \u00ab p\u00e9d\u00e9 \u00bb. R\u00e9cit du coming-out d\u2019un jeune homme et de l\u2019extraction de son milieu social par la r\u00e9ussite scolaire et la vie sexuelle, Eddy Bellegueule est une version moderne du vilain petit canard, un r\u00e9cit poignant qui t\u00e9moigne d\u2019une lutte incroyable, \u00e0 la fois dr\u00f4le et violente.","performers":"COLLECTIF La B\u00e9cane \/ Jessica Gazon D\u2019apr\u00e8s le roman d\u2019\u00c9douard Louis\r\n\u00ab En finir avec Eddy Bellegueule \u00bb\r\n\r\nAdaptation : Collective\r\nMise en sc\u00e8ne : Jessica Gazon Avec : Janie Follet, Sophie Jaskulski, Louise Manteau, Fran\u00e7ois Maquet\r\nDramaturgie : Thibaut N\u00e8ve Cr\u00e9ation Costumes : \u00c9lise Abraham Cr\u00e9ation sonore : S\u00e9gol\u00e8ne Neyroud\r\nVid\u00e9o : J\u00e9r\u00f4me Guiot","boxoffice_url":null,"website":"http:\/\/www.ccu.be","email":"reservation@ccu.be","phone_contact":null,"phone_booking":"+32 2 374 64 84","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.537167"},"nl":{"name":"En finir avec Eddy Bellegueule","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.537167"},"en":{"name":"En finir avec Eddy Bellegueule","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.537167"},"de":{"name":"En finir avec Eddy Bellegueule","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.537167"},"it":{"name":"En finir avec Eddy Bellegueule","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.537167"},"sp":{"name":"En finir avec Eddy Bellegueule","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.537167"},"pt":{"name":"En finir avec Eddy Bellegueule","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.537167"},"cn":{"name":"En finir avec Eddy Bellegueule","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.537167"}},"place":{"id":7929,"translations":{"fr":{"name":"Centre Culturel d'Uccle","address_street_name":"Rue Rouge","address_street_number":"47","address_street_box":null,"email":"reservation@ccu.be","website":"http:\/\/www.ccu.be","phone_contact":"+32 2 374 64 84","phone_booking":"+32 2 374 64 84","address_zip":"1180","address_city":"Uccle","address_line1":"Rue Rouge, 47","address_line2":"1180 Uccle","description_web":"Le Centre culturel d\u2019Uccle est contemporain de l\u2019Atomium. Con\u00e7u pour se trouver dans un \u00e9crin de verdure, face au Parc de Wolvendael, la premi\u00e8re pierre fut pos\u00e9e le 30 novembre 1957. Le Centre Culturel et Artistique d\u2019Uccle fut inaugur\u00e9 le 5 octobre 1958.\r\nLe CCU est une \u0153uvre de l\u2019architecte L\u00e9on Stynen, qui avait aussi con\u00e7u les casinos de Knokke, Blankenberge et Ostende.\r\nCe nouveau Centre Culturel permit aux soci\u00e9t\u00e9s et associations int\u00e9ress\u00e9es d\u2019organiser des bals, des conf\u00e9rences, des concerts, des projections de films, des d\u00e9bats et toutes autres manifestations culturelles et artistiques (ballets, concerts, expositions, r\u00e9ceptions, \u2026). Il proposait aussi des repr\u00e9sentations th\u00e9\u00e2trales, un cycle de conf\u00e9rences et des spectacles musicaux.\r\nL'ensemble du b\u00e2timent abrite principalement un hall d\u2019entr\u00e9e donnant acc\u00e8s \u00e0 une grande Salle de Spectacle de 800 fauteuils, un Grand Foyer pouvant accueillir jusqu'\u00e0 400 personnes assises, ainsi qu'un Petit Foyer pouvant contenir 120 personnes.\r\nPlus de cinquante ans apr\u00e8s sa cr\u00e9ation, le Centre Culturel d\u2019Uccle r\u00e9nov\u00e9 a un look \u00e0 la fois contemporain et chaleureux. Pleinement actif, il r\u00e9pond aux d\u00e9fis culturels de son si\u00e8cle en accueillant les plus grands noms du th\u00e9\u00e2tre, de la danse, de la chanson et de la musique ainsi que des artistes et des conf\u00e9renciers de renom. Il s\u2019est constamment modernis\u00e9 pour offrir \u00e0 son public une vie culturelle de qualit\u00e9 au c\u0153ur de la commune d\u2019Uccle.\r\nDirig\u00e9 par une \u00e9quipe dynamique, le CCU met tout en \u0153uvre pour fid\u00e9liser sa client\u00e8le et conqu\u00e9rir sans cesse un public nouveau.\r\nLe Centre Culturel d\u2019Uccle en quelques chiffres, c\u2019est\u2026\r\n-\tUn des plus grands centres culturels \u00e0 Bruxelles et ses environs\r\n-\tUn rendez-vous des professionnels du spectacle\r\n-\t4 espaces bien distincts (Hall, Grand Foyer, Petit Foyer, Salle de Spectacle)\r\n-\tUne salle de spectacle de 800 places\r\n-\tUn gradin r\u00e9tractable de 172 places\r\n-\t200 activit\u00e9s par an\r\n-\t600 artistes par saison\r\n-\t60.000 spectateurs par an\r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"CC Ukkel","address_street_name":"Rodestraat","address_street_number":"47","address_street_box":null,"email":"info@ccu.be","website":"http:\/\/www.ccu.be","phone_contact":"+32 2 374 64 84","phone_booking":"+32 2 374 64 84","address_zip":"1180","address_city":"Ukkel","address_line1":"Rodestraat, 47","address_line2":"1180 Ukkel","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Centre Culturel d'Uccle","address_street_name":"Rue Rouge","address_street_number":"47","address_street_box":null,"email":"reservation@ccu.be","website":"http:\/\/www.ccu.be","phone_contact":"+32 2 374 64 84","phone_booking":"+32 2 374 64 84","address_zip":"1180","address_city":"Uccle","address_line1":"Rue Rouge, 47","address_line2":"1180 Uccle","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Centre Culturel d'Uccle","address_street_name":"Rue Rouge","address_street_number":"47","address_street_box":null,"email":"reservation@ccu.be","website":"http:\/\/www.ccu.be","phone_contact":"+32 2 374 64 84","phone_booking":"+32 2 374 64 84","address_zip":"1180","