ajor_event":false,"backoffice_id":310250,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"concert","ranking":1,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":1,"translations":{"de":"Konzert","pt":null,"en":"Concert","it":"Concerti","cn":null,"fr":"Concert","sp":"Concierto","nl":"Concert"}},"others":{}},"translations":{"de":{"name":"RedBox Sessions N\u00b06 - NICOLAS MICHAUX x ML","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.instagram.com\/redbox_sessions\/","email":"hello@encre-mp3.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700002881"},"pt":{"name":"RedBox Sessions N\u00b06 - NICOLAS MICHAUX x ML","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.instagram.com\/redbox_sessions\/","email":"hello@encre-mp3.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700002881"},"en":{"name":"RedBox Sessions N\u00b06 - NICOLAS MICHAUX x ML","shortdescr":"The Redbox is our playground. A vibrant red space that transforms into a field of possibilities in which we invite artists from all horizons to express themselves.\n\nFor the sixth edition Nicolas Michaux invites ML. Don't miss the opportunity to discover this unique session and enjoy a time of exchange with the artists after the concert.","longdescr":"1 box, 2 artists, 20 seats & 2 much red.\n\nThe Redbox is our playground. A vibrant red space that transforms into a field of possibilities in which we invite artists from all horizons to express themselves.\n\nFor the sixth edition Nicolas Michaux invites ML. Don't miss the opportunity to discover this unique session and enjoy a time of exchange with the artists after the concert.\n8.00PM : Open doors + drink (offered)\n8.30PM : Session begins\n9.15PM : Talk with the artists\n9.45PM : End\n\nPlease be on time - the whole session will be filmed which means that any entry after 8:15pm will be denied.\n\nPlease note that the session will be filmed. By attending, you agree to be included in the video.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.instagram.com\/redbox_sessions\/","email":"hello@encre-mp3.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700002881"},"it":{"name":"RedBox Sessions N\u00b06 - NICOLAS MICHAUX x ML","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.instagram.com\/redbox_sessions\/","email":"hello@encre-mp3.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700002881"},"cn":{"name":"RedBox Sessions N\u00b06 - NICOLAS MICHAUX x ML","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.instagram.com\/redbox_sessions\/","email":"hello@encre-mp3.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700002881"},"fr":{"name":"RedBox Sessions N\u00b06 - NICOLAS MICHAUX x ML","shortdescr":"La Redbox est notre terrain de jeu. Un espace rouge vibrant qui se transforme en champ des possibles dans lequel nous invitons des artistes de tous horizons \u00e0 s'exprimer.\n\nPour la sixi\u00e8me \u00e9dition, Nicolas Michaux invite ML. Ne manquez pas l'occasion de d\u00e9couvrir cette session unique et de profiter d'un moment d'\u00e9change avec les artistes apr\u00e8s le concert.","longdescr":"1 bo\u00eete, 2 artistes, 20 si\u00e8ges & 2 beaucoup de rouge.\n\nLa Redbox est notre terrain de jeu. Un espace rouge vibrant qui se transforme en champ des possibles dans lequel nous invitons des artistes de tous horizons \u00e0 s'exprimer.\n\nPour la sixi\u00e8me \u00e9dition, Nicolas Michaux invite ML. Ne manquez pas l'occasion de d\u00e9couvrir cette session unique et de profiter d'un temps d'\u00e9change avec les artistes apr\u00e8s le concert.\n20h00 : Portes ouvertes + boisson (offerte)\n20h30 : D\u00e9but de la session\n21h15 : Discussion avec les artistes\n9.45PM : Fin\n\nMerci d'\u00eatre \u00e0 l'heure - toute la session sera film\u00e9e, ce qui signifie que toute entr\u00e9e apr\u00e8s 20h15 sera refus\u00e9e. Veuillez noter que la session sera film\u00e9e. En participant, vous acceptez d'\u00eatre inclus dans la vid\u00e9o.","performers":"Nicolas Michaux (chant), ML (chant)","boxoffice_url":null,"website":"https:\/\/www.instagram.com\/redbox_sessions\/","email":"hello@encre-mp3.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700002881"},"sp":{"name":"RedBox Sessions N\u00b06 - NICOLAS MICHAUX x ML","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.instagram.com\/redbox_sessions\/","email":"hello@encre-mp3.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700002881"},"nl":{"name":"RedBox Sessions N\u00b06 - NICOLAS MICHAUX x ML","shortdescr":"De Redbox is onze speeltuin. Een levendige rode ruimte die verandert in een veld van mogelijkheden waarin we artiesten van alle horizonten uitnodigen om zich te uiten.\n\nVoor de zesde editie nodigt Nicolas Michaux ML uit. Mis de kans niet om deze unieke sessie te ontdekken en geniet van een moment van uitwisseling met de artiesten na het concert.","longdescr":"1 box, 2 artiesten, 20 stoelen & 2 veel rood.\n\nDe Redbox is onze speeltuin. Een levendige rode ruimte die verandert in een veld van mogelijkheden waarin we artiesten van alle horizonten uitnodigen om zich te uiten.\n\nVoor de zesde editie nodigt Nicolas Michaux ML uit. Mis de kans niet om deze unieke sessie te ontdekken en geniet van een moment van uitwisseling met de artiesten na het concert.\n20u00 : Opendeur + drankje (aangeboden)\n20u30 : Begin van de sessie\n21.15u : Gesprek met de artiesten\n21.45 : Einde\n\nKom a.u.b. op tijd - de hele sessie wordt gefilmd, wat betekent dat toegang na 20.15 uur wordt geweigerd. Houd er rekening mee dat de sessie wordt gefilmd. Door aanwezig te zijn, ga je ermee akkoord dat je wordt opgenomen in de video.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.instagram.com\/redbox_sessions\/","email":"hello@encre-mp3.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700002881"}},"place":{"id":50000701,"translations":{"de":{"name":"Encr\u00e9.","address_street_name":"Rue des Chartreux","address_street_number":"17","address_street_box":null,"email":"brussels@encre-atelier.com","website":"https:\/\/encre-atelier.com\/fr","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Chartreux, 17","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Encr\u00e9.","address_street_name":"Rue des Chartreux","address_street_number":"17","address_street_box":null,"email":"brussels@encre-atelier.com","website":"https:\/\/encre-atelier.com\/fr","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Chartreux, 17","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Encr\u00e9.","address_street_name":"Kartuizersstraat","address_street_number":"17","address_street_box":null,"email":"brussels@encre-atelier.com","website":"https:\/\/encre-atelier.com\/fr","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Kartuizersstraat, 17","address_line2":"1