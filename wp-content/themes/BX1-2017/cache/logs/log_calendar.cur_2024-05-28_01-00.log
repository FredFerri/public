 v\u00e9lo et partez \u00e0 la d\u00e9couverte des stades mythiques ainsi que de la petite et grande histoire de ce sport mondialement connu dans la capitale. Que vous soyez connaisseur ou n\u00e9ophyte ou encore si les abr\u00e9viations de l\u2019USG, du RSCA ou encore du RWDM ne vous disent rien\u00a0! Ne cherchez plus, La seule balade qui allie \u00ab\u00a0petite reine\u00a0\u00bb et \u00ab\u00a0ballon rond\u00a0\u00bb est faite pour vous\u00a0!","performers":null,"boxoffice_url":null,"website":"https:\/\/www.provelo.org\/events\/bruxelles-ville-du-football\/","email":"info@provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":"+32 2 502 73 55","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50010780"},"sp":{"name":"Bruxelles ville du football","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.provelo.org\/events\/bruxelles-ville-du-football\/","email":"info@provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":"+32 2 502 73 55","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50010780"},"nl":{"name":"Brussel voetbalstad","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.provelo.org\/events\/bruxelles-ville-du-football\/","email":"info@provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":"+32 2 502 73 55","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50010780"}},"place":{"last_updated_at":"2023-03-06T15:46:39+01:00","published_at":"2013-10-19T01:13:47+02:00","id":228485,"translations":{"de":{"name":"Pro Velo","address_street_name":"Rue de Londres ","address_street_number":"15","address_street_box":null,"email":"info@provelo.org","website":"http:\/\/www.provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de Londres , 15","address_line2":"1050 Ixelles","description_web":null,"des