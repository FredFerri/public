07+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":312281,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"concert","ranking":1.2599210498948732,"languages":{"spoken":["nl","pt","en","fr"],"subtitles":[]},"categories":{"main":{"id":1,"translations":{"de":"Konzert","pt":null,"en":"Concert","it":"Concerti","cn":null,"fr":"Concert","sp":"Concierto","nl":"Concert"}},"others":{"list":[6,4],"translations":{"de":["Worldmusic, Folk & Country","Pop, Rock, Jazz..."],"pt":[null,null],"en":["Worldmusic, Folk & Country","Pop, rock, jazz\u2026"],"it":["Worldmusic, Folk e Country","Pop, rock, jazz\u2026"],"cn":[null,null],"fr":["Worldmusic, Folk & Country","Pop, rock, jazz\u2026"],"sp":["Worldmusic, folk y country","Pop, rock, jazz\u2026"],"nl":["Worldmusic, Folk & Country","Pop, rock, jazz\u2026"]}}},"translations":{"de":{"name":"Pas de panique, Samba songs","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lebaixu.com","email":"contact@lebaixu.com","phone_contact":"+32 475 36 18 36","phone_booking":"+32 475 36 18 36","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700003852"},"pt":{"name":"Pas de panique, Samba songs","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lebaixu.com","email":"contact@lebaixu.com","phone_contact":"+32 475 36 18 36","phone_booking":"+32 475 36 18 36","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700003852"},"en":{"name":"Pas de panique, Samba songs","shortdescr":"Nicola S\u00f3n was born in Paris, but lived in Brazil for several years until 2018. Since his 1st album, he has been hailed by the Brazilian media as \"the most Brazilian of French singers\". After a trilogy in which he explored the rhythmic peculiarities of different regions of Brazil,","longdescr":" a 4th album - Piaf do Brasil - in the form of a rereading of \u00c9dith Piaf's greatest hits, Nicola S\u00f3n will release \"Pas de Panique\" in 2023.n This 5th album will seek inspiration beyond the Brazilian music of his first albums, flirting with reggae, cumbia and African music, in a more pop and modern spirit.    Nicola S\u00f3n's challenge is still to make French chanson swing by taking inspiration from music from elsewhere, as Gainsbourg did in his day with his early albums (No2, No4 and Percussions).  Accompanied by the same Brazilian producer, M\u00e1rcio Arantes (winner of the Latin Grammy Awards in 2021), who produced his hit 'Amanh\u00e3 j\u00e1 era' - playlist France Inter 2018, Nova Tunes 3.8, FIP, Cosmo in Germany) - Nicola S\u00f3n presents an album that is resolutely French, Latin and pop.\n\n","performers":null,"boxoffice_url":null,"website":"http:\/\/www.lebaixu.com","email":"contact@lebaixu.com","phone_contact":"+32 475 36 18 36","phone_booking":"+32 475 36 18 36","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700003852"},"it":{"name":"Pas de panique, Samba songs","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lebaixu.com","email":"contact@lebaixu.com","phone_contact":"+32 475 36 18 36","phone_booking":"+32 475 36 18 36","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700003852"},"cn":{"name":"Pas de panique, Samba songs","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lebaixu.com","email":"contact@lebaixu.com","phone_contact":"+32 475 36 18 36","phone_booking":"+32 475 36 18 36","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700003852"},"fr":{"name":"Pas de panique, Samba songs","shortdescr":"Nicola S\u00f3n est n\u00e9 \u00e0 Paris, mais a v\u00e9cu au Br\u00e9sil pendant plusieurs ann\u00e9es jusqu\u2019en 2018. Depuis son 1er album, il a gagn\u00e9 aupr\u00e8s des m\u00e9dias br\u00e9siliens le titre du \u00ab plus br\u00e9silien des chanteurs fran\u00e7ais \u00bb. Apr\u00e8s une trilogie o\u00f9 il a explor\u00e9 les particularit\u00e9s rythmiques de diff\u00e9rentes r\u00e9gions du Br\u00e9sil, ","longdescr":"un 4\u00e8me album \u2013 Piaf do Brasil \u2013 en forme de relecture des plus grands succ\u00e8s d\u2019\u00c9dith Piaf, Nicola S\u00f3n sort \u00ab Pas de Panique \u00bb en 2023. Ce 5\u00e8me album, va chercher des inspirations au-del\u00e0 de la musique br\u00e9silienne de ses premiers albums, en flirtant avec le reggae, la cumbia, la musique africaine, dans un esprit plus pop et moderne.    Le d\u00e9fi de Nicola S\u00f3n est toujours de faire swinguer la chanson fran\u00e7aise, en s'inspirant de musiques d'ailleurs, comme avait r\u00e9ussi \u00e0 faire Gainsbourg en son temps dans ses premiers albums (No2, No4 ou encore Percussions).  Accompagn\u00e9 du m\u00eame producteur br\u00e9silien, M\u00e1rcio Arantes (prim\u00e9 au Latin Grammy Awards en 2021), qui avait r\u00e9alis\u00e9 son tube \"Amanh\u00e3 j\u00e1 era\" - playlist France Inter 2018, Nova Tunes 3.8, FIP, Cosmo en Allemagne) - Nicola S\u00f3n pr\u00e9sente donc un album r\u00e9solument fran\u00e7ais, latin et pop.","performers":"Nicola S\u00f3n - guitare, chant, Ricardo Feij\u00e3o - basse, James M\u00fcller - batterie, Ludwig Gorhan - saxophone , flute","boxoffice_url":null,"website":"http:\/\/www.lebaixu.com","email":"contact@lebaixu.com","phone_contact":"+32 475 36 18 36","phone_booking":"+32 475 36 18 36","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700003852"},"sp":{"name":"Pas de panique, Samba songs","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lebaixu.com","email":"contact@lebaixu.com","phone_contact":"+32 475 36 18 36","phone_booking":"+32 475 36 18 36","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700003852"},"nl":{"name":"Pas de panique, Samba songs","shortdescr":"Nicola S\u00f3n is geboren in Parijs, maar heeft tot 2018 een aantal jaren in Brazili\u00eb gewoond. Sinds zijn 1e album wordt hij door de Braziliaanse media geprezen als \"de meest Braziliaanse van de Franse zangers\". Na een trilogie waarin hij de ritmische eigenaardigheden van verschillende regio's van Brazili\u00eb verkende, ","longdescr":"een 4e album - Piaf do Brasil - in de vorm van een herlezing van de grootste hits van \u00c9dith Piaf, zal Nicola S\u00f3n in 2023 \"Pas de Panique\" uitbrengen.n Dit 5e album zal inspiratie zoeken buiten de Braziliaanse muziek van zijn eerste albums, flirten met reggae, cumbia en Afrikaanse muziek, in een meer pop en moderne geest.    Nicola S\u00f3n's uitdaging is nog steeds om het Franse chanson te laten swingen door zich te laten inspireren door muziek van elders, zoals Gainsbourg destijds deed met zijn vroege albums (No2, No4 en Percussions).  Begeleid door dezelfde Braziliaanse producer, M\u00e1rcio Arantes (winnaar van de Latin Grammy Awards in 2021), die zijn hit 'Amanh\u00e3 j\u00e1 era' produceerde - playlist France Inter 2018, Nova Tunes 3.8, FIP, Cosmo in Duitsland) - presenteert Nicola S\u00f3n een album dat resoluut Frans, latin en pop is.\n","performers":null,"boxoffice_url":null,"website":"http:\/\/www.lebaixu.com","email":"contact@lebaixu.com","phone_contact":"+32 475 36 18 36","phone_booking":"+32 475 36 18 36","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700003852"}},"place":{"id":279109,"translations":{"de":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"contact@lebaixu.com","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"contact@lebaixu.com","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"contact@lebaixu.com","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue Picard, 3","address_line2":"1000 Brussels","description_web":"The name \u201cBaixu\u201d means \u201cbeautiful\u201d in the native language of the Patax\u00f3 peoples, indigenous to the south of the state of Bahia in Brazil. This word represents both the ambition of the project and the quality of the cultural events presented, as well as the founders\u2019 attachment to Brazilian culture. Baisu is a quaint and welcoming space in the Tour & Taxis neighborhood in Brussels, which hosts concerts, expositions, screenings, or conferences \u2013 or where you can organise your private event.\r\nA project dedicated to \u201cbeauty\u201d in all its forms, where the keywords are quality, exchange and interaction.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"contact@lebaixu.com","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"contact@lebaixu.com","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"contact@lebaixu.com","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard, 3","address_line2":"1000 Bruxelles","description_web":"Un lieu atypique et chaleureux dans le quartier de Tour & Taxis \u00e0 Bruxelles pour assister \u00e0 des concerts, des expositions, des projections ou des conf\u00e9rences, ou pour y organiser vos \u00e9v\u00e8nements priv\u00e9s.\r\nUn projet d\u00e9di\u00e9 au \u00ab beau \u00bb sous toutes ses coutures, dont les maitres-mots sont qualit\u00e9, \u00e9changes et rencontres.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"contact@lebaixu.com","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Le Baixu","address_street_name":"Picardstraat","address_street_number":"3","address_street_box"