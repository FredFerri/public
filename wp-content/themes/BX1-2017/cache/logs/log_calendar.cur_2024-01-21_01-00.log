65,"date_start":"2023-12-09","date_end":"2024-01-27","date_next":"2024-01-27","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2023-12-10T01:04:52+01:00","published_at":"2023-11-29T15:05:50+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":289755,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"tour","ranking":0.49324241486609405,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{"list":[251],"translations":{"de":["Zeitgen\u00f6ssische Kunst "],"pt":[null],"en":["Contemporary Art"],"it":["Arte contemporanea "],"cn":[null],"fr":["Art Contemporain "],"sp":["Arte contempor\u00e1neo "],"nl":["Hedendaagse Kunst"]}}},"translations":{"de":{"name":"Meet the curator \u2013 Fran\u00e7ois de Coninck (FR)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/centrale.brussels\/events\/meet-the-curator-francois-de-coninck\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50004865"},"pt":{"name":"Meet the curator \u2013 Fran\u00e7ois de Coninck (FR)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/centrale.brussels\/events\/meet-the-curator-francois-de-coninck\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50004865"},"en":{"name":"Meet the curator \u2013 Fran\u00e7ois de Coninck (FR)","shortdescr":"Guided tour (in French) of the exhibition L\u2019art de rien with Fran\u00e7ois de Coninck, curator of this show.","longdescr":"Meet the curator \u2013 Fran\u00e7ois de Coninck (FR)\nFree guided tour included with the purchase of your entrance ticket\nBooking required\n\nFran\u00e7ois de Coninck (1969) is an author, artist, editor and art critic (member of AICA), independent curator and teacher. Setting up klet & Ko in 2006 , which he ran for ten years, and Anima Ludens in 2014, generated numerous collaborations with artists and writers. As a curator, he has organised numerous exhibitions in Belgium, both in public (Le Botanique, Africa Museum and at\nthe cultural centres in Hasselt and Namur, Centre d\u2019art contemporain du Luxembourg belge, etc.) and at private venues (art centres and galleries). He writes for contemporary art centres, museums, artists, collectors, publishers, art galleries and auction houses \u2013 his clients include the Mus\u00e9e de la Photographie in Charleroi, the Royal Museums of Fine Arts of Belgium, Le Botanique, the Boghossian Foundation \u2013 Villa Empain and Maison Particuli\u00e8re in Brussels, Sotheby\u2019s and Christie\u2019s in Paris and Marta Herford GcmbH in Germany. He has since 2018 been a guest lecturer at ENSAV La Cambre, where he is in charge of the transdisciplinary module Art(s) et \u00e9criture(s) for Masters students. Since 2022, he has also been a guest lecturer at the Acad\u00e9mie Royale des Beaux-Arts in Brussels. He worked as a charg\u00e9 de mission for the museums of the City of Brussels in 2018 and 2019.","performers":"Fran\u00e7ois de Coninck;","boxoffice_url":null,"website":"https:\/\/centrale.brussels\/en\/events\/meet-the-curator-francois-de-coninck\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50004865"},"it":{"name":"Meet the curator \u2013 Fran\u00e7ois de Coninck (FR)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/centrale.brussels\/events\/meet-the-curator-francois-de-coninck\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50004865"},"cn":{"name":"Meet the curator \u2013 Fran\u00e7ois de Coninck (FR)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/centrale.brussels\/events\/meet-the-curator-francois-de-coninck\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50004865"},"fr":{"name":"Meet the curator \u2013 Fran\u00e7ois de Coninck (FR)","shortdescr":"Visite guid\u00e9e de l\u2019exposition L\u2019art de rien avec Fran\u00e7ois de Coninck, commissaire de l\u2019exposition.","longdescr":"Meet the curator \u2013 Fran\u00e7ois de Coninck\nVisite guid\u00e9e offerte \u00e0 l\u2019achat de votre ticket d\u2019entr\u00e9e\nR\u00e9servation ici\n\nFran\u00e7ois de Coninck (1969) est auteur, artiste, \u00e9diteur et critique d\u2019art (membre de l\u2019AICA), commissaire d\u2019exposition ind\u00e9pendant et enseignant. En cr\u00e9ant les \u00e9ditions klet & Ko en 2006 \u2013 qu\u2019il a dirig\u00e9es pendant dix ans \u2013 et les \u00e9ditions Anima Ludens en 2014, il a g\u00e9n\u00e9r\u00e9 de nombreuses collaborations avec des artistes et des \u00e9crivain.e.s. Comme curateur, il a mont\u00e9 de nombreuses expositions en Belgique, tant dans des lieux publics (Le Botanique, Africa Museum, Centres culturels de Hasselt et de Namur, Centre d\u2019art contemporain du Luxembourg belge, etc.) que priv\u00e9s (centres et galeries d\u2019art). Il \u00e9crit des textes pour des centres d\u2019art contemporain, des mus\u00e9es, des artistes, des collectionneur.se.s, des maisons d\u2019\u00e9ditions, des galeries d\u2019art ou des salles de vente \u2013 parmi ses commanditaires, on citera le Mus\u00e9e de la Photographie \u00e0 Charleroi, les Mus\u00e9es royaux des Beaux-Arts de Belgique, Le Botanique, la Fondation Boghossian \u2013 Villa Empain et Maison Particuli\u00e8re \u00e0 Bruxelles, Sotheby\u2019s et Christie\u2019s \u00e0 Paris ou encore le Marta Herford GcmbH en Allemagne. Depuis 2018, il est conf\u00e9rencier invit\u00e9 \u00e0 l\u2019ENSAV La Cambre o\u00f9 il est en charge du module transdisciplinaire Art(s) et \u00e9criture(s) \u00e0 l\u2019attention des \u00e9tudiant.e.s en Master. Depuis 2022, il intervient aussi comme conf\u00e9rencier invit\u00e9 \u00e0 l\u2019Acad\u00e9mie Royale des Beaux-Arts de Bruxelles. Il a travaill\u00e9 comme charg\u00e9 de mission pour les mus\u00e9es de la Ville de Bruxelles en 2018 et 2019.","performers":"Fran\u00e7ois de Coninck;","boxoffice_url":null,"website":"https:\/\/centrale.brussels\/events\/meet-the-curator-francois-de-coninck\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50004865"},"sp":{"name":"Meet the curator \u2013 Fran\u00e7ois de Coninck (FR)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/centrale.brussels\/events\/meet-the-curator-francois-de-coninck\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50004865"},"nl":{"name":"Meet the curator \u2013 Fran\u00e7ois de Coninck (FR)","shortdescr":"Rondleiding (in het Frans) van de tentoonstelling L\u2019art de rien met Fran\u00e7ois de Coninck, curator van deze expositie.","longdescr":"Fran\u00e7ois de Coninck (1969) is auteur, uitgever en kunstcriticus (lid van het AICA), zelfstandig curator en lesgever. Met de oprichting van Editions klet & Ko in 2006 \u2013 dat hij gedurende tien jaar heeft geleid \u2013 en van Editions Anima Ludens in 2014, bracht hij vele samenwerkingen tot stand, met tal van kunstenaars en schrijvers. Als curator organiseerde hij heel wat tentoonstellingen\nin Belgi\u00eb, zowel voor openbare instellingen (Botanique, Africa Museum, Cultuurcentra van Hasselt en Namen, Centre d\u2019art contemporain du Luxembourg belge \u2026) als particuliere initiatieven (kunstencentra en -galerie\u00ebn). Hij schrijft in opdracht van hedendaagse kunstencentra, musea, kunstenaars, collectioneurs, uitgeverijen, kunstgalerijen of verkoopzalen. Enkele van zijn opdrachtgevers zijn: Mus\u00e9e de la Photographie in Charleroi, de Koninklijke Musea voor Schone Kunsten van Belgi\u00eb, Botanique, Fondation Boghossian \u2013 Villa Empain et Maison Particuli\u00e8re in\nBrussel, Sotheby\u2019s en Christie\u2019s in Parijs en Marta Herford GcmbH in Duitsland. Sinds 2018 is hij gastspreker in La Cambre waar hij instaat voor de module Art(s) et \u00e9criture(s) voor masterstudenten. Sinds 2022 is hij ook gastspreker voor de Koninklijke Academie voor Schone Kunsten in Brussel. Hij werkte als opdrachthouder voor de Musea van de Stad Brussel in 2018 en 2019.","performers":"Fran\u00e7ois de Coninck;","boxoffice_url":null,"website":"https:\/\/centrale.brussels\/nl\/events\/meet-the-curator-francois-de-coninck\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50004865"}},"place":{"id":243546,"translations":{"de":{"name":"CENTRALE for contemporary art","address_street_name":"Place Sainte-Catherine","address_street_number":"45","address_street_box":null,"email":"info@centrale.brussels","website":"http:\/\/www.centrale.brussels","phone_contact":"+32 2 279 64 44","phone_booking":"+32 2 279 64 57","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Sainte-Catherine, 45","address_line2":"1000 Bruxelles","description_web":"Die CENTRALE for Contemporary Art hat sich im Br\u00fcsseler Stadtzentrum in einem ehemaligen Elektrizit\u00e4tswerk niedergelassen. Hier wird eine engagierte und in jeder Hinsicht offene Vision der Kunst entwickelt und gepflegt, die im engen Austausch mit der Stadt und der Gesellschaft steht. In den verschiedenen R\u00e4umen und S\u00e4len finden regelm\u00e4\u00dfig Ausstellungen und andere multidisziplin\u00e4re Projekte mit namhaften K\u00fcnstlern und aufstrebenden jungen Talenten statt, die sowohl aus Br\u00fcssel als auch von ausw\u00e4rts stammen.","description_print":null,"booking_url":null,"sort_order":"CENTRALE FOR CONTEMPORARY ART","virtual_visit":null},"pt":{"name":"CENTRALE for contemporary art","address_street_name":"Place Sainte-Catherine","address_street_number":"45","address_street_box":null,"email":"info@centrale.brussels","website":"http:\/\/www.centrale.brussels","phone_contact":"+32 2 279 64 44","phone_booking":"+32 2 279 64 57","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Sainte-Catherine, 45","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"CENTRALE for contemporary art","address_street_name":"Place Sainte-Catherine","address_street_number":"45","address_street_box":null,"email":"info@centrale.brussels","website":"http:\/\/www.centrale.brussels","phone_contact":"+32 2 279 64 44","phone_booking":"+32 2 279 64 57","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Sainte-Catherine, 45","address_line2":"1000 Bruxelles","description_web":"Nestled in a former power station in the heart of Brussels, CENTRALE for contemporary art is the contemporary art centre of the City of Brussels.\r\nIt develops a committed vision of art, beyond boundaries, and connected to the city and to society.\r\nEach year it collaborates with confirmed and emerging artists from Brussels and the international scene to produce exhibitions and multidisciplinary projects housed in its various premises.\r\n","description_print":null,"booking_url":null,"sort_order