ent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen","it":"Visite guidate","sp":"Visitas guiadas","pt":null,"cn":null}},"others":{"list":[113],"translations":{"fr":["Histoire Industrielle"],"nl":["Industri\u00eble geschiedenis"],"en":["Industrial History"],"de":["Industrielle Geschichte"],"it":["Storia industriale"],"sp":["Historia industrial"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["en","fr"],"subtitles":[]},"translations":{"fr":{"name":"Brussels Beer: A Travel through Time","shortdescr":"Venez d\u00e9couvrir ce que 100 ans d'\u00e9volution technologique change \u00e0 la bi\u00e8re et son go\u00fbt!","longdescr":"Nous sommes en Belgique assez fiers de notre h\u00e9ritage brassicole, et bien s\u00fbr Bruxelles ne fait pas exception.\r\nEt nous avons de magnifiques vestiges et autre traces de ce pass\u00e9 florissant, qui ne demandent qu'\u00e0 \u00eatre racont\u00e9s, montr\u00e9s, partag\u00e9s.\r\n\r\nMais que savons-nous au juste de ce que Bruxelles-la-brassicole a \u00e0 offrir?\r\nQuelles sont les influences du temps sur la technique de brassage, et nos go\u00fbts?\r\n\r\nPeut-on go\u00fbter la bi\u00e8re d'antan? Peut-on imaginer la bi\u00e8re du futur?\r\n\r\nRejoignez-nous pour un v\u00e9ritable voyage dans le temps, et venez go\u00fbter avec nous ce que Bruxelles a de mieux \u00e0 vous offrir en termes de bi\u00e8res, de culture, de go\u00fbt.\r\nVisite uniquement destin\u00e9e aux curieux de la bi\u00e8re... et \u00e0 ceux qui ne l'aiment pas!\r\nTous les premiers samedis du mois!","performers":"Agalmalt","boxoffice_url":null,"website":"http:\/\/www.agalmalt.com","email":"hello@agalmalt.com","phone_contact":null,"phone_booking":"+32 486 70 57 43","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.552502"},"nl":{"name":"Brussels Beer: A Travel through Time","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.agalmalt.com","email":"hello@agalmalt.com","phone_contact":null,"phone_booking":"+32 486 70 57 43","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.552502"},"en":{"name":"Brussels Beer: A Travel through Time","shortdescr":"Experience what 100 years of technological evolution does to beer!","longdescr":"In Belgium we\u2019re pretty proud of our beer legacy, and Brussels makes no exception to it. We have a flourishing past with testimonies and stories here and there, awaiting to be told.\r\n\r\nBut do we know precisely what does Brussels have to offer beer-wise ?\r\n\r\nHow does time influence brewing technique, our taste expectations ?\r\n\r\nCan we taste beer past ? Is it possible to imagine beer future ?\r\n\r\nJoin us for an exclusive time travel, and experience the evolution of brewing \u2013 and its major consequences \u2013 on-site in the core of Brussels beer culture. For beer sceptics and enthusiasts only, every first Saturday !","performers":null,"boxoffice_url":null,"website":"http:\/\/www.agalmalt.com","email":"hello@agalmalt.com","phone_contact":null,"phone_booking":"+32 486 70 57 43","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.552502"},"de":{"name":"A Travel through Time","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.agalmalt.com","email":"hello@agalmalt.com","phone_contact":null,"phone_booking":"+32 486 70 57 43","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.552502"},"it":{"name":"A Travel through Time","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.agalmalt.com","email":"hello@agalmalt.com","phone_contact":null,"phone_booking":"+32 486 70 57 43","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.552502"},"sp":{"name":"A Travel thro