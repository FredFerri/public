ortdescr":null,"longdescr":"Lamoral d'Egmont, Philippe de Hornes, deux noms qui fleurent comme une odeur de fronde face \u00e0 un aust\u00e8re joug espagnol en cette seconde moiti\u00e9 du XVI\u00e8me si\u00e8cle. En 1568 a lieu la d\u00e9capitation de ces deux personnalit\u00e9s, h\u00e9rauts de la pacification et de la tol\u00e9rance religieuse dans nos r\u00e9gions. Il vous est propos\u00e9 de suivre un parcours o\u00f9 vous rencontrerez leurs compagnons, des symboles de la domination du duc d'Albe, ainsi que des lieux de cette trag\u00e9die narr\u00e9e par Goethe au XIX\u00e8me.\r\n\r\nR\u00e9servation obligatoire et mise \u00e0 disposition d'un guide pendant 2h.","performers":null,"boxoffice_url":null,"website":null,"email":"info@itineraires.be","phone_contact":"+32 2 541 03 77","phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/532814.html"},"nl":{"name":"In de voetsporen van Lamoral, graaf van Egmont, en Philippe de Montmorency, graaf van Hornes","shortdescr":null,"longdescr":"Lamorel d'Egmont, Philippe de Hornes, twee namen die staan voor de opstand tegen het strenge Spaanse juk in de tweede helft van de 16de eeuw. We stellen voor om een route te volgen ter gelegenheid van de 405de verjaardag van de onthoofding van deze helden, de herauten van de pacificatie en religieuze tolerantie in onze streken. Zo ontmoeten we hun metgezellen, de symbolen van de overheersing van de hertog van Alba. \r\n\r\nReserveren is verplicht en een gids is beschikbaar voor 2 uur.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/532814.html"},"en":{"name":"On the footsteps of Lamoral, count of Egmont, and Philippe de Montmorency, count of Hornes","shortdescr":null,"longdescr":"Lamorel d'Egmont and Philippe de Hornes; two names that signify rebellion against the austere Spanish yoke in the second half of the 16th century. For the 450th anniversary of the beheading of these two heroes and heralds of pacification and religious tolerance in our regions, we offer a route to meet their companions, symbols of the domination of the Duke of Alba, places of this tragedy narrated by Goethe in the 19th century. \r\n\r\nReservation is required for a 2 hours guided tour.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/532814.html"},"de":{"name":"Sur les traces de Lamoral, comte d'Egmont, & Philippe de Montmorency, comte de Hornes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/532814.html"},"it":{"name":"Sur les traces de Lamoral, comte d'Egmont, & Philippe de Montmorency, comte de Hornes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/532814.html"},"sp":{"name":"Tras las huellas de Lamoral, conde de Egmont, y Philippe de Montmorency, conde de Hornes","shortdescr":null,"longdescr":"Lamoral d'Egmont y Philippe de Hornes son dos nombres que recuerdan al enfrentamiento con el austero yugo espa\u00f1ol en la segunda mitad del siglo XVI. En 1568, se decapit\u00f3 a estas dos personalidades, heraldos de la pacificaci\u00f3n y la tolerancia religiosa en nuestra regi\u00f3n. Te invitamos a seguir una ruta en la que conocer\u00e1s a sus compa\u00f1eros, los s\u00edmbolos de la dominaci\u00f3n del Duque de Alba, as\u00ed como lugares de esta tragedia narrada por Goethe en el siglo XIX. \r\n\r\nPrestaci\u00f3n de los servicios de un gu\u00eda durante 2 horas","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/532814.html"},"pt":{"name":"Sur les traces de Lamoral, comte d'Egmont, & Philippe de Montmorency, comte de Hornes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/532814.html"},"cn":{"name":"Sur les traces de Lamoral, comte d'Egmont, & Philippe de Montmorency, comte de Hornes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/532814.html"}},"place":{"id":271572,"translations":{"fr":{"name":"Eglse Notre-Dame du Sablon","address_street_name":"Rue de la R\u00e9gence","address_street_number":"3","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la R\u00e9gence, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Eglse Notre-Dame du Sablon","address_street_name":"Rue de la R\u00e9gence","address_street_number":"3","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Rue de la R\u00e9gence, 3","address_line2":"1000 Brussel","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Eglse Notre-Dame du Sablon","address_street_name":"Rue de la R\u00e9gence","address_street_number":"3","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue de la R\u00e9gence, 3","address_line2":"1000 Brussels","description_web":null,"description_print":null,"booking_url":null,"sort_order