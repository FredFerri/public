ior"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-09-02T10:05:04+02:00","published_at":"2022-09-02T09:46:42+02:00","backoffice_id":238575,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.13269424171239},{"id":540193,"date_start":"2022-09-10","date_end":"2023-09-01","date_next":"2022-10-19","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre"}},"others":{"list":[51],"translations":{"fr":["Caf\u00e9 th\u00e9\u00e2tre"],"nl":["Cabaret"],"en":["Cabaret"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"FREEF\u00d4RM DESIRE - Spectacle D'improvisation de la Troupe du Vertigo \u23f1","shortdescr":null,"longdescr":"\" FREEF\u00d4RM  \"\r\n\r\n\r\nVos d\u00e9sirs sont des impros,\r\nvos aspirations, nos inspirations!\r\n\r\nLa troupe Vertig\u00d4 revient cette ann\u00e9e avec l\u2019une de ses toutes premi\u00e8res cr\u00e9ations: Freeform Desire.\r\n\r\nTout ce que vous souhaitez, au quotidien ou dans vos r\u00eaves les plus fous, mais aussi ce que vous ne d\u00e9sirez absolument pas\u2026 voil\u00e0 les points de d\u00e9part que vous, public, donnerez \u00e0 toutes nos histoires.\r\n\r\nFugaces, parfois entrem\u00eal\u00e9es, ces histoires tr\u00e8s courtes ou plus longues exploseront dans un cocktail de formes et de couleurs, dans ce spectacle freeform sign\u00e9 Vertig\u00d4.\r\n\r\nLes membres de la troupe : \r\nArnaud Petit                       Laura Matthys\r\nLaurent Cadet                   Sarah Pochez\r\nNicolas Lembr\u00e9e              Catherine Lembr\u00e9e\r\nAlexandre Valancin          Laurie Andrieu\r\nKevin Dehut                       Elsa Mikmik\r\nPierre Deguee                   Mana Livardjani\r\nLaurent Van der Rest \r\n\r\n-------`\r\n\r\nINFOS PRATIQUES\r\n\r\nLieu : Le TRAC\r\nAdresse : 110, rue Albert Meunier- Auderghem\r\n\r\nSpectacle \u00e0 20h15\r\nIl est possible de manger et\/ou boire un verre sur place avant le spectacle, pensez donc \u00e0 venir plus t\u00f4t! (Derni\u00e8re commande de restauration \u00e0 19h55!)\r\n\r\nR\u00c9SERVATIONS (vivement conseill\u00e9es)\r\nvia le lien du Trac : https:\/\/www.letrac.be\/reservations\r\n\r\nTARIFS\r\n- Sur r\u00e9servation : 10\u20ac\/\u00e9tudiant & 13\u20ac\/adulte\r\n- Sur place : 15\u20ac\/personne","performers":"Les improvisateurs de la troupe du Vretigo","boxoffice_url":null,"website":"http:\/\/www.letrac.be\/reservation","email":"info@letrac.be","phone_contact":"+32 470 50 04 75","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.540193"},"nl":{"name":"FREEF\u00d4RM DESIRE - Spectacle D'improvisation de la Troupe du Vertigo \u23f1","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.540193"},"en":{"name":"FREEF\u00d4RM DESIRE - Spectacle D'improvisation de la Troupe du Vertigo \u23f1","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.540193"},"de":{"name":"FREEF\u00d4RM DESIRE - Spectacle D'improvisation de la Troupe du Vertigo \u23f1","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.540193"},"it":{"name":"FREEF\u00d4RM DESIRE - Spectacle D'improvisation de la Troupe du Vertigo \u23f1","shor