scr":null,"longdescr":"Lamorel d'Egmont, Philippe de Hornes, two names that mean rebellion against the austere Spanish yoke in this second half of the 16th century. For the 450th anniversary of the beheading of these two heroes, heralds of pacification and religious tolerance in our regions, we propose to follow a route where we will meet their companions, symbols of the domination of the Duke of Alba, places of this tragedy narrated by Goethe in the 19th century.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.itineraires.be\/","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50008883"},"it":{"name":"Sur les traces d\u2019Egmont et Hornes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.itineraires.be\/","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50008883"},"cn":{"name":"Sur les traces d\u2019Egmont et Hornes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.itineraires.be\/","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50008883"},"fr":{"name":"Sur les traces d\u2019Egmont et Hornes","shortdescr":null,"longdescr":"Lamoral d'Egmont, Philippe de Hornes, deux noms qui fleurent comme une odeur de fronde face \u00e0 un aust\u00e8re joug espagnol en cette seconde moiti\u00e9 du XVI\u00e8me si\u00e8cle. Pour les 450 ans de la d\u00e9capitation de ces deux h\u00e9ros, h\u00e9rauts de la pacification, de la tol\u00e9rance religieuse dans nos r\u00e9gions, nous vous proposons de suivre un parcours o\u00f9 nous rencontrerons leurs compagnons, des symboles de la domination du duc d'Albe, des lieux de cette trag\u00e9die narr\u00e9e par Goethe au XIX\u00e8me.\n","performers":null,"boxoffice_url":null,"website":"https:\/\/www.itineraires.be\/","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50008883"},"sp":{"name":"Sur les traces d\u2019Egmont et Hornes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.itineraires.be\/","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50008883"},"nl":{"name":"Sur les traces d\u2019Egmont et Hornes","shortdescr":null,"longdescr":"Lamorel d'Egmont, Philippe de Hornes, twee namen die staan voor opstand tegen het strenge Spaanse juk in deze tweede helft van de 16e eeuw. Ter gelegenheid van de 450e verjaardag van de onthoofding van deze twee helden, herauten van de pacificatie en de religieuze tolerantie in onze streken, stellen wij voor een route te volgen waarbij we hun metgezellen ontmoeten, symbolen van de overheersing van de hertog van Alba, plaatsen van deze tragedie die in de 19e eeuw door Goethe werd verteld.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.itineraires.be\/","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50008883"}},"place":{"id":260315,"translations":{"de":{"name":"Au pied de la statue des Comtes d\u2019Egmont et de Hornes","address_street_name":"Place du Petit Sablon","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place du Petit Sablon","address_line2":"1000 Bruxelles","description_web":null,"description_print