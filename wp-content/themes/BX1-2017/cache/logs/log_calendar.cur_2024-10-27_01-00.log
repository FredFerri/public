icland-theatre.com","email":"johanne@magicland-theatre.com","phone_contact":"+32 495 26 18 71","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700001270"},"it":{"name":"What The Fun x Magic Land Th\u00e9\u00e2tre: Halloween","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.magicland-theatre.com","email":"johanne@magicland-theatre.com","phone_contact":"+32 495 26 18 71","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700001270"},"cn":{"name":"What The Fun x Magic Land Th\u00e9\u00e2tre: Halloween","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.magicland-theatre.com","email":"johanne@magicland-theatre.com","phone_contact":"+32 495 26 18 71","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700001270"},"fr":{"name":"What The Fun x Magic Land Th\u00e9\u00e2tre: Halloween","shortdescr":null,"longdescr":"Plongez dans notre premi\u00e8re soir\u00e9e 2024-2025 avec le What The Fun !\n\nApr\u00e8s le succ\u00e8s des soir\u00e9es de la saison derni\u00e8re, le Magic et le What The Fun reviennent en force avec des soir\u00e9es inoubliables de STAND UP COMEDY plac\u00e9e, pour la premi\u00e8re, sous le signe d\u2019HALLOWEEN ! Sur le th\u00e8me de l\u2019Humour Noir, cette soir\u00e9e promet d\u2019\u00eatre ensorcelante.\n\nToujours pr\u00e9sent\u00e9e par le captivant Anthony Circus, pr\u00e9parez-vous \u00e0 une soir\u00e9e o\u00f9 six talents de la nouvelle g\u00e9n\u00e9ration belge viendront enflammer notre sc\u00e8ne. \n\nD\u00e9tails de la soir\u00e9e :\n\nOUVERTURE DES PORTES : 19:30\nD\u00c9BUT DU SPECTACLE : 20:00\n\nPour une immersion totale et des rires encore plus m\u00e9morables, venez d\u00e9guis\u00e9.e.s !\n\nLine Up : Hugo Simon, Ric Diez, Salim Shady, Maria Bouraga, Letizia Finizio & Romain Scurra.\n\nPour une immersion totale et des rires encore plus m\u00e9morables, venez d\u00e9guis\u00e9.e.s !\n","performers":null,"boxoffice_url":null,"website":"https:\/\/www.magicland-theatre.com","email":"johanne@magicland-theatre.com","phone_contact":"+32 495 26 18 71","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700001270"},"sp":{"name":"What The Fun x Magic Land Th\u00e9\u00e2tre: Halloween","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.magicland-theatre.com","email":"johanne@magicland-theatre.com","phone_contact":"+32 495 26 18 71","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700001270"},"nl":{"name":"What The Fun x Magic Land Th\u00e9\u00e2tre: Halloween","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.magicland-theatre.com","email":"johanne@magicland-theatre.com","phone_contact":"+32 495 26 18 71","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700001270"}},"place":{"id":224842,"translations":{"de":{"name":"Magic Land Th\u00e9\u00e2tre","address_street_name":"Rue d'Hoogvorst","address_street_number":"8-14","address_street_box":null,"email":"info@magicland-theatre.com","website":"http:\/\/www.magicland-theatre.com","phone_contact":"+32 2 245 50 64","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Rue d'Hoogvorst, 8-14","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Magic Land Th\u00e9\u00e2tre","address_street_name":"Rue d'Hoogvorst","address_street_number":"8-14","address_street_box":null,"email":"info@magicland-theatre.com","website":"http:\/\/www.magicland-theatre.com","phone_contact":"+32 2 245 50 64","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Rue d'Hoogvorst, 8-14","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Magic Land Th\u00e9\u00e2tre","address_street_name":"Rue d'Hoogvorst","address_street_number":"8-14","address_street_box":null,"email":"info@magicland-theatre.com","website":"http:\/\/www.magicland-theatre.com","phone_contact":"+32 2 245 50 64","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Rue d'Hoogvorst, 8-14","address_line2":"1030 Schaerbeek","description_web":"The Magic Land Th\u00e9\u00e2tre was born out of a collective dream in the 1970s. It now has its\r\nactive, around fifty creations, several international tours and participation regular at most major Belgian cultural events. His multiple exp\u00e9riences artistic works carried out on so many fronts have allowed him to forge a style so particular, far removed off the beaten track of classical theater. If we had to classify the \"Magic land\" in a category \" popular theater \"is undoubtedly the adjective which would suit best even if Patrick Chaboud its founder prefers to speak of a theater of exchanges, meetings, surprises, debates, emotions and forcing anger sometimes too. At the Magic land theater, the scenic barriers conventional have long since been abolished in order to build bridges between genders, heater, dance, music, circus, humor. The Magic Land Theater is ultimately, above all, a living theater, a theater in perpetual \"reinvention\" to better ward off ideas black.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Magic Land Th\u00e9\u00e2tre","address_street_name":"Rue d'Hoogvorst","address_street_number":"8-14","address_street_box":null,"email":"info@magicland-theatre.com","website":"http:\/\/www.magicland-theatre.com","phone_contact":"+32 2 245 50 64","phone_booking":null,"a