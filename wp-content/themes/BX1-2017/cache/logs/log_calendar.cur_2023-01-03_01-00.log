":null,"start":"20:00:00","end":"22:30:00"},{"day":"2022-12-16","doors":null,"start":"20:00:00","end":"22:30:00"},{"day":"2023-01-20","doors":null,"start":"20:00:00","end":"22:30:00"},{"day":"2023-02-17","doors":null,"start":"20:00:00","end":"22:30:00"},{"day":"2023-03-17","doors":null,"start":"20:00:00","end":"22:30:00"},{"day":"2023-04-21","doors":null,"start":"20:00:00","end":"22:30:00"},{"day":"2023-05-19","doors":null,"start":"20:00:00","end":"22:30:00"},{"day":"2023-06-16","doors":null,"start":"20:00:00","end":"22:30:00"}],"recurring":[{"day":"friday","occurences":{"is_first":false,"is_second":false,"is_third":true,"is_fourth":false,"is_last":false},"time_start":"20:00:00","time_end":"22:30:00","translations":{"fr":"Ouvert le troisi\u00e8me vendredi du mois de 20:00 \u00e0 22:30","nl":"Open op de derde vrijdag van de maand van 20:00 tot 22:30","en":"Open the third friday of the month from 20:00 to 22:30","de":"Open the third friday of the month from 20:00 to 22:30","it":"Open the third friday of the month from 20:00 to 22:30","sp":"Open the third friday of the month from 20:00 to 22:30","pt":"Open the third friday of the month from 20:00 to 22:30","cn":"Open the third friday of the month from 20:00 to 22:30"}}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-12-17T01:08:33+01:00","published_at":"2022-10-11T09:39:17+02:00","backoffice_id":263832,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":0.16113901317993},{"id":547644,"date_start":"2023-01-21","date_end":"2023-01-21","date_next":"2023-01-21","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":true,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert","de":"Konzert","it":null,"sp":null,"pt":null,"cn":null}},"others":{"list":[4,6],"translations":{"fr":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"],"nl":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"],"en":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"],"de":["Pop, Rock, Jazz...","Worldmusic, Folk & Country"],"it":[null,null],"sp":[null,null],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Duo Coulon \u2013 Az\u00e1n (Chili)","shortdescr":"Chansons engag\u00e9es par 2 membres d\u2019Inti-Illimani","longdescr":"Deux artistes \u00e0 la carri\u00e8re exceptionnelle se sont \u00e9chapp\u00e9s du l\u00e9gendaire groupe chilien Inti-Illimani pour nous servir en duo des chansons engag\u00e9es et po\u00e9tiques d\u2019une plume rare. Ces deux musiciens sont unis par une amiti\u00e9 forte et une sensibilit\u00e9 similaire.\r\n\r\nMarcelo Coulon est un musicien et compositeur chilien. Il est connu pour \u00eatre membre du groupe chilien Inti-Illimani depuis 1978, o\u00f9 il joue de la quena (fl\u00fbte andine), du piccolo, de la fl\u00fbte et du guitarr\u00f3n mexicain, en plus des ch\u0153urs. David Az\u00e1n est un guitariste chilien qui cumule plus de 20 ans d\u2019exp\u00e9rience en tant que directeur musical de Patricio Manns et de nombreuses participations en tant que compositeur, arrangeur et interpr\u00e8te. Il a cultiv\u00e9 un lien fort avec les musiques d\u2019Am\u00e9rique Latine.\r\n\r\nCes deux \u00e2mes de po\u00e8tes ont pass\u00e9 le confinement \u00e0 s\u2019investir dans des projets sociaux de quartiers, et aid\u00e9 ceux qui ont le plus subi la pand\u00e9mie. Aujourd\u2019hui ils pr\u00e9sentent leurs nouvelles compositions, dans lesquelles ils d\u00e9clarent avec conviction que la musique transforme les c\u0153urs et les soci\u00e9t\u00e9s dans des magnifiques morceaux tels que \u00ab Plaza Dignidad \u00bb, \u00ab El tiempo en los ojos \u00bb ou encore \u00ab Donde nace la luz \u00bb.","performers":"Marcelo Coulon : quena, piccolo, fl\u00fbte, cuatro venezolano, chant\r\nDavid Az\u00e1n : guitare, chant\r\nJos\u00e9 Buc : basse, charango, chant\r\nOsvaldo Hernandez : percussions, chant","boxoffice_url":null,"website":"http:\/\/www.muziekpublique.be","email":"info@muziekpublique.be","phone_contact":null,"phone_booking":"+32 2 217 26 00","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.547644"},"nl":{"name":"Duo Coulon \u2013 Az\u00e1n (Chili)","shortdescr":"Ge\u00ebngageerde muziek gebracht door 2 leden van Inti-Illimani","longdescr":"Twee artiesten met een uitzonderlijke carri\u00e8re zijn ontsnapt uit de legendarische Chileense groep Inti-Illimani om ons als duo enkele ge\u00ebngageerde en po\u00ebtische liedjes met uitzonderlijke pen voor te schotelen. Deze twee muzikanten vinden elkaar in een sterke vriendschap en een gelijklopende gevoeligheid.\r\n\r\nMarcelo Coulon is een Chileense muzikant en componist. Hij staat bekend als lid van de Chileense groep Inti-Illimani sinds 1978, waar hij naast de achtergrondzang ook de quena (Andesfluit), de piccolo, de fluit en de Mexicaanse guitarr\u00f3n speelt. David Az\u00e1n is een Chileense gitarist met meer dan 20 jaar ervaring als muzikaal leider van Patricio Manns en talrijke deelnames als componist, arrangeur en uitvoerder. Hij heeft een sterke band opgebouwd met Latijns-Amerikaanse muziek.\r\n\r\nDeze twee po\u00ebtische zielen hebben zich tijdens de lockdown toegelegd op sociale buurtprojecten en degenen geholpen die het meest te lijden hadden onder de pandemie. Vandaag presenteren ze hun nieuwe composities, waarin ze met overtuiging tonen dat muziek harten en samenlevingen transformeert in prachtige stukken zoals \u201cPlaza Dignidad\u201d, \u201cEl tiempo en los ojos\u201d of \u201cDonde nace la luz\u201d.","performers":"Marcelo Coulon : quena, piccolo, fluit, cuatro venezolano, zang\r\nDavid Az\u00e1n : gitaar, zang\r\nJos\u00e9 Buc : bas, charango, zang\r\nOsvaldo Hernandez : percussie, zang","boxoffice_url":null,"website":"http:\/\/www.muziekpublique.be","email":"info@muziekpublique.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.547644"},"en":{"name":"Duo Coulon \u2013 Az\u00e1n (Chile)","shortdescr":"Socially engaged songs by 2 members of Inti-Illimani","longdescr":"Two artists who have enjoyed an exceptional career have slipped away from the legendary Chilean group Inti-Illimani to perform for us as a duo, serving up committed and poetic songs from special source. These two musicians are united by a strong bond of friendship and share a similar sensitivity.\r\n\r\nMarcelo Coulon is a Chilean musician and composer. He has been a member of the well-known Chilean group Inti-Illimani since 1978; there he plays the quena (Andean flute), the piccolo, the flute and the Mexican guitarr\u00f3n, and sings as well. David Az\u00e1n is a Chilean guitarist who has had more than 20 years of experience as musical director for Patricio Manns and has worked widely as composer, arranger and performer. He has cultivated strong links with the various musics of Latin America.\r\n\r\nThese two poetic souls spent the lockdown period devoting themselves to social projects in local districts and helping those who were most deeply affected by the pandemic. Today they will be presenting their new compositions, in which they announce with conviction that music can transform hearts and societies in such magnificent pieces as \u201cPlaza Dignidad\u201d, \u201cEl Tiempo en los Ojos\u201d, and \u201cDonde Nace la Luz\u201d.","performers":"Marcelo Coulon : quena, piccolo, flute, cuatro venezolano, vocals\r\nDavid Az\u00e1n : guitar, vocals\r\nJos\u00e9 Buc : bass, charango, vocals\r\nOsvaldo Hernandez : percussion, vocals","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.547644"},"de":{"name":"Duo Coulon \u2013 Az\u00e1n (Chili)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.547644"},"it":{"name":"Duo Coulon \u2013 Az\u00e1n (Chili)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.547644"},"sp":{"name":"Duo Coulon \u2013 Az\u00e1n (Chili)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.547644"},"pt":{"name":"Duo Coulon \u2013 Az\u00e1n (Chili)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.547644"},"cn":{"name":"Duo Coulon \u2013 Az\u00e1n (Chili)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.547644"}},"place":{"id":238099,"translations":{"fr":{"name":"Muziekpublique","address_street_name":"Galerie de la Porte de Namur","address_street_number":"3","address_street_box":null,"email":"info@muziekpublique.be","website":"http:\/\/www.muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":"+32 2 217 26 00","address_zip":"1050","address_city":"Ixelles","address_line1":"Galerie de la Porte de Namur, 3","address_line2":"1050 Ixelles","description_web":"Muziekpublique est le centre des musiques traditionnelles du monde de Bruxelles. Etablie dans le Th\u00e9\u00e2tre Moli\u00e8re au c\u0153ur du quartier africain, l\u2019asbl organise plus de 100 concerts par an et deux festivals (Hide & Seek Festival etc.). Par ailleurs Muziekpublique propose aussi 50 cours de musique et de danse du monde, comptant plus de 600 \u00e9l\u00e8ves. Ensuite, l\u2019asbl d\u00e9veloppe certains artistes et projets via son label, qui est aussi une agence de booking et de management. La musique traditionnelle a donc trouv\u00e9 un endroit id\u00e9al o\u00f9 se d\u00e9velopper et les artistes y constituent un r\u00e9seau vivant et dynamique cr\u00e9ant des liens de qualit\u00e9 avec le public. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Muziekpublique","address_street_name":"Galerij van de Naamsepoort","address_street_number":"3","address_street_box":null,"email":"info@muziekpublique.be","website":"http:\/\/www.muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":"+32 2 217 26 00","address_zip":"1050","address_city":"Elsene","address_line1":"Galerij van de Naamsepoort, 3","address_line2":"1050 Elsene","description_web":"Muziekpublique verspreidt en promoot muziek- en danstradities via een ambitieus programma van concerten, cursussen en projecten. Een jaarrond concertprogramma met Belgische en internationale artiesten vormt de kern van de activiteiten van de organisatie. Van contemplatieve tot feestelijke concerten vinden het hele jaar door plaats in het prachtige Moli\u00e8re Theater, aan de Naamsepoort, maar ook op verschillende plaatsen de hoofdstad.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Muziekpublique","address_street_name":"Galerie de la Porte de Namur","address_street_number":"3","address_street_box":null,"email":"info@muziekpublique.be","website":"http:\/\/www.muziekpublique.be","phone_contact":"+32 2 217 26 00","phone_booking":"+32 2 217 26 00","addr