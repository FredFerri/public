ddress_street_name":"Place de la Monnaie","address_street_number":"6","address_street_box":null,"email":"info@muntpunt.be","website":"http:\/\/www.muntpunt.be","phone_contact":"+32 2 278 11 11","phone_booking":"+32 2 278 11 11","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Monnaie, 6","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":null,"facebook_id":null,"backoffice_id":13020,"location":{"lat":50.84996484,"lon":4.35348679},"region":"brussels","last_updated_at":"2022-09-08T13:05:30+02:00","published_at":"2013-10-19T01:35:36+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/muntpunt-1f1173a618c29948ff1dcaf75c365ff1775341b9.jpg","width":850,"height":850,"ratio":1,"translations":{"fr":{"title":"Boekenverkoop","copyright":null},"nl":{"title":"Boekenverkoop","copyright":null},"en":{"title":"Boekenverkoop","copyright":null}}}],"dates":[{"day":"2022-09-18","doors":null,"start":"10:00:00","end":"18:00:00","is_soldout":false,"is_canceled":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-09-08T13:05:30+02:00","published_at":"2022-08-29T12:00:09+02:00","backoffice_id":260582,"import_origin":"muntpunt","sub_type":"other","show_in_agenda":true,"ranking":1},{"id":540747,"date_start":"2022-09-18","date_end":"2022-09-18","date_next":"2022-09-18","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":90,"translations":{"fr":"Animations","nl":"Animaties","en":"Animations"}},"others":{}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"D\u00e9couvrez \"La Cit\u00e9 des R\u00eaveurs\"","shortdescr":"D\u00e9couvrez La Cit\u00e9 des R\u00eaveurs !\r\n\r\nLe dimanche 18 septembre 2022, \u00e0 l'occasion des journ\u00e9es du patrimoine et de la Journ\u00e9e sans voiture, venez d\u00e9couvrir (enfin) un lieu unique o\u00f9 se rencontrent les arts et les citoyens.","longdescr":"D\u00e9couvrez la Cit\u00e9 des R\u00eaveurs !\r\n\r\nLe dimanche 18 septembre 2022, \u00e0 l'occasion des journ\u00e9es du patrimoine et de la Journ\u00e9e sans voiture, venez d\u00e9couvrir (enfin) un lieu unique o\u00f9 se rencontrent les arts et les citoyens.\r\n\r\nEntr\u00e9e gratuite ! Activit\u00e9s \u00e0 prix libre !\r\n\r\nApr\u00e8s plus d'un an d'attente, apr\u00e8s les fermetures co-vid et les grands travaux du quartier o\u00f9 nous nous situons, nous pouvons enfin ouvrir la Cit\u00e9 des R\u00eaveurs ! Nous avons tellement h\u00e2te de vous faire d\u00e9couvrir ce nouveau lieu !\r\n\r\nRejoignez-nous le dimanche 18 septembre \u00e0 partir de 12H !\r\n\r\nAu programme :\r\nJeux de soci\u00e9t\u00e9\r\nConcerts\r\nJeux de plein air\r\nD\u00e9gustation locale\r\nPetite restauration\r\nCourts m\u00e9trages\r\net visites de la Cit\u00e9 des R\u00eaveurs toutes les heures piles !\r\n\r\nAlors qu'est ce qu'on attend ?","performers":"La Compagnie des R\u00eaveurs Asbl","boxoffice_url":null,"website":"http:\/\/www.lacompagniedesreveurs.com","email":"administration@lacompagniedesreveurs.com","phone_contact":null,"phone_booking":"+32 485 20 93 83","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.540747"},"nl":{"name":"Ontdek \"La Cit\u00e9 des R\u00eaveurs\"","shortdescr":"Ontdek La Cit\u00e9 des R\u00eaveurs !\r\n\r\nKom op zondag 18 september 2022, ter gelegenheid van Open Monumentendagen en Autoloze Dag, (eindelijk) een unieke plek ontdekken waar kunst en burger elkaar ontmoeten.","longdescr":"Kom op zondag 18 september 2022, ter gelegenheid van Open Monumentendagen en Autoloze Dag, (eindelijk) een unieke plek ontdekken waar kunst en burger elkaar ontmoeten.\r\n\r\nGratis toegang ! Activiteiten aan vrij prijs !\r\n\r\nNa meer dan een jaar wachten, na de co-vid sluitingen en de grote werken in de buurt waar we gevestigd zijn, mogen we eindelijk de City of Dreamers openen ! We kunnen niet wachten om je deze nieuwe plek te laten zien !\r\n\r\nDoe mee op zondag 18 september vanaf 12.00 uur !\r\n\r\nOp het programma:\r\nBordspellen\r\nOptredens\r\nBuiten spellen\r\nLokale proeverij\r\nSnacks\r\nKorte films\r\n\r\nen bezoeken aan la Cit\u00e9 des R\u00eaveurs elk uur op het hele uur !\r\n\r\nDus waar wachten we op ?","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.540747"},"en":{"name":"Discover \"La Cit\u00e9 des R\u00eaveurs\"","shortdescr":"Discover La Cit\u00e9 des R\u00eaveurs !\r\n\r\nOn Sunday, September 18, 2022, on the occasion of Heritage Days and Car-Free Day, come and discover (finally) a unique place where arts and citizens meet.","longdescr":"On Sunday, September 18, 2022, on the occasion of Heritage Days and Car-Free Day, come and discover (finally) a unique place where arts and citizens meet.\r\n\r\nFree admission ! Activities at free price !\r\n\r\nAfter more than a year of waiting, after the co-vid closures and major works in the neighborhood where we are located, we can finally open the City of Dreamers ! We can't wait to show you this new place !\r\n\r\nJoin us on Sunday, September 18 from 12 p.m.!\r\n\r\nIn the program :\r\nBoard games\r\nGigs\r\nOutdoor games\r\nLocal tasting\r\nSnacks\r\nShort films\r\n\r\nand visits to la Cit\u00e9 des R\u00eaveurs every hour on the hour !\r\n\r\nSo what are we waiting for ? \ufe0f","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.540747"},"de":{"name":"D\u00e9couvrez-Ontdek-Discover \"La Cit\u00e9 des R\u00eaveurs\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.540747"},"it":{"name":"D\u00e9couvrez-Ontdek-Discover \"La Cit\u00e9 des R\u00eaveurs\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.540747"},"sp":{"name":"D\u00e9couvrez-Ontdek-Discover \"La Cit\u00e9 des R\u00eaveurs\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.540747"},"pt":{"name":"D\u00e9couvrez-Ontdek-Discover \"La Cit\u00e9 des R\u00eaveurs\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.540747"},"cn":{"name":"D\u00e9couvrez-Ontdek-Discover \"La Cit\u00e9 des R\u00eaveurs\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.540747"}},"place":{"id":276936,"translations":{"fr":{"name":"La Cit\u00e9 des R\u00eaveurs","address_street_name":"Avenue Gustave Latinis","address_street_number":"50","address_street_box":null,"email":"administration@lacompagniedesreveurs.com","website":"http:\/\/lacompagniedesreveurs.com","phone_contact":null,"phone_booking":null,"address_z