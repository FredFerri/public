how_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":300734,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"tour","ranking":0.30146417667793085,"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{"list":[251],"translations":{"de":["Zeitgen\u00f6ssische Kunst "],"pt":[null],"en":["Contemporary Art"],"it":["Arte contemporanea "],"cn":[null],"fr":["Art Contemporain "],"sp":["Arte contempor\u00e1neo "],"nl":["Hedendaagse Kunst"]}}},"translations":{"de":{"name":"Emmanuelle Castellan \"Spektrum\" : visites guid\u00e9es","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/fondationdentreprisehermes.org","email":"laverriere@hermes.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50011013"},"pt":{"name":"Emmanuelle Castellan \"Spektrum\" : visites guid\u00e9es","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/fondationdentreprisehermes.org","email":"laverriere@hermes.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50011013"},"en":{"name":"Emmanuelle Castellan \"Spektrum\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/fondationdentreprisehermes.org","email":"laverriere@hermes.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50011013"},"it":{"name":"Emmanuelle Castellan \"Spektrum\" : visites guid\u00e9es","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/fondationdentreprisehermes.org","email":"laverriere@hermes.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50011013"},"cn":{"name":"Emmanuelle Castellan \"Spektrum\" : visites guid\u00e9es","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/fondationdentreprisehermes.org","email":"laverriere@hermes.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50011013"},"fr":{"name":"Emmanuelle Castellan \"Spektrum\"","shortdescr":"Con\u00e7u comme une exp\u00e9rience visuelle, l\u2019exposition \u00abSpektrum\u00bb peut se vivre gr\u00e2ce \u00e0 un m\u00e9diateur culturel qui propose au public  des visites comment\u00e9es sans r\u00e9servation.","longdescr":"Cinqui\u00e8me exposition de Jo\u00ebl Riff en tant que commissaire de La Verri\u00e8re, \u00abSpektrum\u00bb fait appara\u00eetre la peinture\nd\u2019Emmanuelle Castellan. Celle-ci se d\u00e9plie en \u00e9ventail dans l\u2019espace bruxellois, d\u00e9voilant des revers, partitionnant\ndes coulisses, permettant des \u00e9crans. Construite aussi bien par ajout que par retrait, son \u00e9criture picturale\nsuperpose les couches, et leurs effacements. Des surfaces subsistent, glissant entre support libre ou tableau,\nlorsque leur \u00e9piderme m\u00eame n\u2019a pas \u00e9t\u00e9 tranch\u00e9 pour mieux embarquer la deuxi\u00e8me dimension vers la troisi\u00e8me.\nDu panel au fant\u00f4me, de l\u2019apparence \u00e0 la gamme, du filtre au souvenir, la polys\u00e9mie du spectre multiplie les acc\u00e8s\n\u00e0 une production hospitali\u00e8re, qui s\u2019efforce d\u2019accueillir ce qui point. La ma\u00eetrise passe alors par la libert\u00e9 de recevoir.\nEn t\u00e9moignent des compositions qui se laissent surprendre au fil de leur latence. Une forme de passivit\u00e9 permet\nainsi aux choses d\u2019\u00e9maner, parfois lentement, \u00e9loignant tout dogmatisme.\nL\u2019accrochage permet un d\u00e9ploiement ambitieux des toiles au sein de l\u2019espace d\u2019exposition de la Fondation\nd\u2019entreprise Herm\u00e8s, propulsant l\u2019amplitude de nouveaux tableaux \u00e0 une \u00e9chelle in\u00e9dite. Leur voisinage avec les \u0153uvres\ndes peintres Norbert Schwontkowski (1949-2013) et Walter Swennen (1946) invente une filiation limpide, compl\u00e9t\u00e9e\npar les c\u00e9ramiques de Johannes Nagel (1979), les miroirs de Dagobert Peche (1887-1923) et les mots de Muriel Pic\n(1974). Cet \u00e9lan se concr\u00e9tise hors de France o\u00f9 l\u2019artiste est n\u00e9e et enseigne, et d\u2019Allemagne o\u00f9 elle est bas\u00e9e.\nLe programme renoue ainsi avec ses premi\u00e8res monographies \u00e0 Bruxelles, accordant une ampleur sans pr\u00e9c\u00e9dent\n\u00e0 la peinture d\u2019Emmanuelle Castellan.","performers":"Visite comment\u00e9e de l\u2019exposition \u00abSpektrum\u00bb. \nLa Verri\u00e8re - Fondation d\u2019entreprise Hermes \n","boxoffice_url":null,"website":"http:\/\/fondationdentreprisehermes.org","email":"laverriere@hermes.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50011013"},"sp":{"name":"Emmanuelle Castellan \"Spektrum\" : visites guid\u00e9es","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/fondationdentreprisehermes.org","email":"laverriere@hermes.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50011013"},"nl":{"name":"Emmanuelle Castellan \"Spektrum\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/fondationdentreprisehermes.org","email":"laverriere@hermes.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50011013"}},"place":{"last_updated_at":"2024-05-24T13:48:41+02:00","published_at":"2013-10-19T01:14:27+02:00","id":236592,"translations":{"de":{"name":"La Verri\u00e8re","address_street_name":"Boulevard de Waterloo","address_street_number":"50","address_street_box":null,"email":null,"website":"http:\/\/www.fondationdentreprisehermes.org","phone_contact":"+ 32 (0)2-511.20.62","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Boulevard de Waterloo, 50","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"La Verri\u00e8re","address_street_name":"Boulevard de Waterloo","address_street_number":"50","address_street_box":null,"email":null,"website":"http:\/\/www.fondationdentreprisehermes.org","phone_contact":"+ 32 (0)2-511.20.62","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Boulevard de Waterloo, 50","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"La Verri\u00e8re","address_street_name":"Boulevard de Waterloo","address_street_number":"50","address_street_box":null,"email":null,"website":"http:\/\/www.fondationdentreprisehermes.org","phone_contact":"+ 32 (0)2-511.20.62","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Boulevard de Waterloo, 50","address_line2":"1000 Brussels","description_web":"\u201cThe Fondation d\u2019entreprise Herm\u00e8s has provided long-term support for the visual arts through a programme of exhibitions conceived by curators attentive to both France\u2019s contemporary art scene and the presentation of work by French artists abroad, whether they are at the start of their careers or more established figures. Unfolding across the Foundation\u2019s four dedicated spaces in Europe and Asia, these exhibitions often feature new work and constitute broad artistic gestures that the public are invited to discover.\n \nLa Verri\u00e8re in Brussels, curated by Jo\u00ebl Riff, is a place that play host to projects specially conceived by invited artists. The Foundation closely accompanies every step of the creative process, and supports the development of original approaches and artistic gestures, from their production stages through to their presentation to the public.\u201d\n","description_print":null,"booking_url":null,"sort_order":"VERRI\u00c8RE","virtual_visit":null,"visit_url":null},"it":{"name":"La Verri\u00e8re","address_street_name":"Boulevard de Waterloo","address_street_number":"50","address_street_box":null,"email":null,"website":"http:\/\/www.fondationdentreprisehermes.org","phone_contact":"+ 32 (0)2-511.20.62","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Boulevard de Waterloo, 50","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"La Verri\u00e8re","address_street_name":"Boulevard de Waterloo","address_street_number":"50","address_street_box":null,"email":null,"website":"http:\/\/www.fondationdentreprisehermes.org","phone_contact":"+ 32 (0)2-511.20.62","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Boulevard de Waterloo, 50","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"La Verri\u00e8re","address_street_name":"Boulevard de Waterloo","address_street_number":"50","address_street_box":null,"email":null,"website":"http:\/\/www.fondationdentreprisehermes.org","phone_contact":"+ 32 (0)2-511.20.62","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Boulevard de Waterloo, 50","address_line2":"1000 Bruxelles","description_web":"\"La Fondation d'entreprise Herm\u00e8s soutient durablement les arts visuels \u00e0 travers un programme d'expositions con\u00e7ues par des commissaires attentifs \u00e0 la fois \u00e0 la sc\u00e8ne artistique contemporaine fran\u00e7aise et \u00e0 la pr\u00e9sentation d'\u0153uvres d'artistes fran\u00e7ais \u00e0 l'\u00e9tranger, qu'ils soient en d\u00e9but de carri\u00e8re ou plus confirm\u00e9s. D\u00e9ploy\u00e9es dans les quatre espaces d\u00e9di\u00e9s de la Fondation en Europe et en Asie, ces expositions pr\u00e9sentent souvent des \u0153uvres in\u00e9dites et constituent des gestes artistiques d'envergure que le public est invit\u00e9 \u00e0 d\u00e9couvrir.\n \nLa Verri\u00e8re \u00e0 Bruxelles, sous le commissariat de Jo\u00ebl Riff, est un lieu qui accueille des projets sp\u00e9cialement con\u00e7us par les artistes invit\u00e9s. La Fondation accompagne de pr\u00e8s toutes les \u00e9tapes du processus de cr\u00e9ation et soutient le d\u00e9veloppement de d\u00e9marches et de gestes artistiques originaux, depuis leur production jusqu'\u00e0 leur pr\u00e9sentation au public\".\n","description_print":null,"booking_url":null,"sort_order":"VERRI\u00c8RE","virtual_visit":null,"visit_url":null},"sp":{"name":"La Verri\u00e8re","address_street_name":"Boulevard de Waterloo","address_street_number":"50","address_street_box":null,"email":null,"website":"http:\/\/www.fondationdentreprisehermes.org","phone_contact":"+ 32 (0)2-511.20.62","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Boulevard de Waterloo, 50","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"La Verri\u00e8re","address_street_name":"Waterloolaan","address_street_number":"50","address_street_box":null,"email":null,"website":"http:\/\/www.fondationdentreprisehermes.org","phone_contact":"+ 32 (0)2-511.20.62","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Waterloolaan, 50","address_line2":