false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-05-25T02:01:30+02:00","published_at":"2024-02-14T15:57:14+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":294566,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.29119348824543295,"languages":{"spoken":["fr","en","nl"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[34,24],"translations":{"de":["Multidisziplin\u00e4r","Kunstgalerien"],"pt":[null,null],"en":["Multidisciplinary","Art Galleries"],"it":["Multidisciplinare","Gallerie d'arte"],"cn":[null,null],"fr":["Pluridisciplinaire","Galeries d'art"],"sp":["Multidisciplinar","Galer\u00edas de arte"],"nl":["Pluridisciplinair","Galeries"]}}},"translations":{"de":{"name":"Seyni Awa Camara","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.baronian.eu","email":"info@baronian.eu","phone_contact":"+32 2 512 92 95","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50007306"},"pt":{"name":"Seyni Awa Camara","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.baronian.eu","email":"info@baronian.eu","phone_contact":"+32 2 512 92 95","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50007306"},"en":{"name":"Seyni Awa Camara -  \u2018Shaping Spirits\u2019","shortdescr":"Gallery Baronian is pleased to announce an exceptional exhibition featuring around forty sculptures by Senegalese artist Seyni Awa Camara. This will be the largest and most complete exhibition ever made of her work.","longdescr":"Gallery Baronian is pleased to announce an exceptional exhibition featuring around forty sculptures by Senegalese artist Seyni Awa Camara. This will be the largest and most complete exhibition ever made of her work.\n \nSeyni Awa Camara is renowned for her exceptional talent in the field of sculpture, exploring a variety of themes through her art with profound sensitivity and remarkable technical mastery. Her work has long remained in the shadows, and we are delighted to bring it to the fore with this remarkable exhibition.\n \nAlbert Baronian became acquainted with Camara\u2019s work through a friend of his living in Cap Skiring. Following this exchange, we now work closely with her, commissioning pieces from her every year, in order to build up a substantial body of sculpture for this major exhibition.\n \nThe sculptures on display were created between 1991 and 2024, and represent a diverse selection of her work, offering visitors a glimpse of the richness and depth of her artistic expression. It is organized around the various themes that characterize her work and her world: maternity, animal bestiary, family and spirits. It promises total immersion in Camara\u2019s distinctive artistic universe.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.baronian.eu","email":"info@baronian.eu","phone_contact":"+32 2 512 92 95","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50007306"},"it":{"name":"Seyni Awa Camara","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.baronian.eu","email":"info@baronian.eu","phone_contact":"+32 2 512 92 95","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50007306"},"cn":{"name":"Seyni Awa Camara","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.baronian.eu","email":"info@baronian.eu","phone_contact":"+32 2 512 92 95","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50007306"},"fr":{"name":"Seyni Awa Camara -  \u2018Shaping Spirits\u2019","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.baronian.eu","email":"info@baronian.eu","phone_contact":"+32 2 512 92 95","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50007306"},"sp":{"name":"Seyni Awa Camara","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.baronian.eu","email":"info@baronian.eu","phone_contact":"+32 2 512 92 95","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50007306"},"nl":{"name":"Seyni Awa Camara -  \u2018Shaping Spirits\u2019","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.baronian.eu","email":"info@baronian.eu","phone_contact":"+32 2 512 92 95","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50007306"}},"place":{"last_updated_at":"2022-11-30T14:58:06+01:00","published_at":"2013-10-19T01:14:44+02:00","id":238078,"translations":{"de":{"name":"Baronian Xippas ","address_street_name":"Rue Isidore Verheyden","address_street_number":"2","address_street_box":null,"email":"info@baronian.eu","website":"http:\/\/www.baronian.eu","phone_contact":"+32 2 512 92 95","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Isidore Verheyden, 2","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Baronian Xippas ","address_street_name":"Rue Isidore Verheyden","address_street_number":"2","address_street_box":null,"email":"info@baronian.eu","website":"http:\/\/www.baronian.eu","phone_contact":"+32 2 512 92 95","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Isidore Verheyden, 2","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Baronian ","address_street_name":"Rue Isidore Verheyden","address_street_number":"2","address_street_box":null,"email":"info@baronian.eu","website":"http:\/\/www.baronian.eu","phone_contact":"+32 2 512 92 95","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Isidore Verheyden, 2","address_line2":"1050 Ixelles","description_web":"Albert Baronian is one of the most emblematic gallery owners in the capital and began his activities in the 1970s. The programme of his gallery reflects his eclectic and sensitive tastes. Artists from the arte povera movement such as Alighiero e Boetti or Mario Merz are given a Belgian showcase for their work. Gilbert & Georges, Tony Oursler, Bruno Serralongue, Robert Devriendt... The gallery's programme is devoted to contemporary art as well as to important artistic movements and artists who have marked the last forty years. Close to place St\u00e9phanie, the gallery has two distinct, but almost opposite spaces: the main gallery is located in rue Isidore Verheyden and the annex in rue de la Concorde.  \r\nAlbert Baronian opened his first gallery in 1973 and immediately enjoyed international success thanks to the presentation of Arte Povera artists Alighiero e Boetti, Mario Merz, Giulio Paolini, Gilberto Zorio. Later, as the president of the Galleries\u2019 Association, the Brussels Art fair took a more international turn whilst under his direction. He sees the responsibility of the gallery as three folds: to work for the long term development of each artists\u2019 career, acting as a liaison to international galleries and museums as well as placing works in collections; to create an historical archive for each artist; and to act as an accessible public space in which the exhibitions become an exemplary gesture of the power of subjectivity to the audience at large. The program is dedicated to contemporary art as well as important artistic movements and artists that have defined the last forty years. \u00bb \r\n","description_print":null,"booking_url":null,"sort_order":"Baronian ","virtual_visit":null,"visit_url":null},"it":{"name":"Baronian Xippas ","address_street_name":"Rue Isidore Verheyden","address_street_number":"2","address_street_box":null,"email":"info@baronian.eu","website":"http:\/\/www.baronian.eu","phone_contact":"+32 2 512 92 95","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Isidore Verheyden, 2","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Baronian Xippas ","address_street_name":"Rue Isidore Verheyden","address_street_number":"2","address_street_box":null,"email":"info@baronian.eu","website":"http:\/\/www.baronian.eu","phone_contact":"+32 2 512 92 95","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Isidore Verheyden, 2","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Baronian  ","address_street_name":"Rue Isidore Verheyden","address_street_number":"2","address_street_box":null,"email":"info@baronian.eu","website":"http:\/\/www.baronian.eu","phone_contact":"+32 2 512 92 95","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Isidore Verheyden, 2","address_line2":"1050 Ixelles","description_web":"Albert Baronian est l\u2019un des galeristes les plus embl\u00e9matiques de la capitale. Il a d\u00e9but\u00e9 ses activit\u00e9s dans les ann\u00e9es 70. La programmation de sa galerie refl\u00e8te ses gouts \u00e9clectiques et sensibles. Les artistes du mouvement de l\u2019arte povera comme Alighiero e Boetti ou Mario Merz y trouvent une vitrine belge pour valoriser leur travail. Gilbert & Georges, Tony Oursler, Bruno Serralongue, Robert Devriendt\u2026 Le programme de la galerie est consacr\u00e9 \u00e0 l\u2019art contemporain ainsi qu'aux mouvements artistiques et aux artistes importants qui ont marqu\u00e9 les quarante derni\u00e8res ann\u00e9es. Toute proche de la place St\u00e9phanie, la galerie compte deux espaces distincts mais se faisant quasiment face : la galerie principale est install\u00e9e dans la rue Isidore Verheyden et l\u2019annexe \u00e0 la rue de la Concorde. ","description_print":null,"booking_url":null,"sort_order":"Baronian ","virtual_visit":null,"visit_url":null},"sp":{"name":"Baronian Xippas ","address_street_name":"Rue Isidore Verheyden","address_street_number":"2","address_street_box":null,"email":"info@baronian.eu","website":"http:\/\/www.baronian.eu","phone_contact":"+32 2 512 92 95","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Isidore Verheyden, 2","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Baronian ","address_street_name":"Isidore Verheydenstraat","address_street_number":"2","address_street_box":null,"email":"info@baronian.eu","website":"http:\/\/www.baronian.eu","phone_contact":"+32 2 512 92 95","phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"Isidore Verheydenstraat, 2","address_line2":"1050 Elsene","description_web":"Albert Baronian is een van de meest emblematische galerijhouders in de hoofdstad, met een carri\u00e8re die eind jaren 1970 begon. Het programma van zijn galerij weerspiegelt zijn eclectische en gevoelige smaak. Kunstenaars van de arte-poverabeweging zoals Alighiero e Boetti of Mario Merz vinden er een Belgische vitrine voor hun werk. Nu circuleren er namen als Gilbert & Georges, Tony Oursler, Bruno Serralongue, Robert Devriendt en vele anderen. Het programma van de galerij is daarmee zowel gewijd aan de hedendaagse kunst als aan de kunststromingen en kunstenaars die de laatste veertig jaar hun stempel hebben gedrukt. Vlakbij het Stefaniaplein beschikt de galerie over twee verschillende, maar bijna tegenover elkaar liggende ruimtes: de hoofdgalerie bevindt zich in de Isidore Verheydenstraat en het bijgebouw in de Eendrachtsstraat. ","description_print":null,"booking_url":null,"sort_order":"Baronian ","virtual_visit":null,"visit_url":null}},"districts":{"list":[10],"translations":{"de":["Louise"],"pt":[null],"en":["Louise"],"it":["Louise"],"cn":[null],"fr":["Louise"],"sp":["Louise"],"nl":["Louiza"]}},"zones":{"list":[21],"translations":{"de":["S\u00fcden"],"pt":[null],"en":["South"],"it":["Sud"],"cn":[null],"fr":["Sud"],"sp":["Sur"],"nl":["Zuid"]}},"neca":"gallery","facebook_id":null,"backoffice_id":1917,"location":{"lat":50.83305444,"lon":4.36110166},"region":"brussels","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"last_updated_at":"2022-11-30T14:58:06+01:00","published_at":"2013-10-19T01:14:44+02:00","id":238078,"translations":{"de":{"name":"Baronian Xippas ","address_street_name":"Rue Isidore Verheyden","address_street_number":"2","address_street_box":null,"email":"info@baronian.eu","website":"http:\/\/www.baronian.eu","phone_contact":"+32 2 512 92 95","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Isidore Verheyden, 2","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Baronian Xippas ","address_street_name":"Rue Isidore Verheyden","address_street_number":"2","address_street_box":null,"email":"info@baronian.eu","website":"http:\/\/www.baronian.eu","phone_contact":"+32 2 512 92 95","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Isidore Verheyden, 2","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Baronian ","address_street_name":"Rue Isidore Verheyden","address_street_number":"2","address_street_box":null,"email":"info@baronian.eu","website":"http:\/\/www.baronian.eu","phone_contact":"+32 2 512 92 95","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Isidore Verheyden, 2","address_line2":"1050 Ixelles","description_web":"Albert Baronian is one of the most emblematic gallery owners in the capital and began his activities in the 1970s. The programme of his gallery reflects his eclectic and sensitive tastes. Artists from the arte povera movement such as Alighiero e Boetti or Mario Merz are given a Belgian showcase for their work. Gilbert & Georges, Tony Oursler, Bruno Serralongue, Robert Devriendt... The gallery's programme is devoted to contemporary art as well as to important artistic movements and artists who have marked the last forty years. Close to place St\u00e9phanie, the gallery has two distinct, but almost opposite spaces: the main gallery is located in rue Isidore Verheyden and the annex in rue de la Concorde.  \r\nAlbert Baronian opened his first gallery in 1973 and immediately enjoyed international success thanks to the presentation of Arte Povera artists Alighiero e Boetti, Mario Merz, Giulio Paolini, Gilberto Zorio. Later, as the president of the Galleries\u2019 Association, the Brussels Art fair took a more international turn whilst under his direction. He sees the responsibility of the gallery as three folds: to work for the long term development of each artists\u2019 career, acting as a liaison to international galleries and museums as well as placing works in collections; to create an historical archive for each artist; and to act as an accessible public space in which the exhibitions become an exemplary gesture of the power of subjectivity to the audience at large. The program is dedicated to contemporary art as well as important artistic movements and artists that have defined the last forty years. \u00bb \r\n","description_print":null,"booking_url":null,"sort_order":"Baronian ","virtual_visit":null,"visit_url":null},"it":{"name":"Baronian Xippas ","address_street_name":"Rue Isidore Verheyden","address_street_number":"2","address_street_box":null,"email":"info@baronian.eu","website":"http:\/\/www.baronian.eu","phone_contact":"+32 2 512 92 95","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Isidore Verheyden, 2","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Baronian Xippas ","address_street_name":"Rue Isidore Verheyden","address_street_number":"2","address_street_box":null,"email":"info@baronian.eu","website":"http:\/\/www.baronian.eu","phone_contact":"+32 2 512 92 95","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Isidore Verheyden, 2","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Baronian  ","address_street_name":"Rue Isidore Verheyden","address_street_number":"2","address_street_box":null,"email":"info@baronian.eu","website":"http:\/\/www.baronian.eu","phone_contact":"+32 2 512 92 95","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Isidore Verheyden, 2","address_line2":"1050 Ixelles","description_web":"Albert Baronian est l\u2019un des galeristes les plus embl\u00e9matiques de la capitale. Il a d\u00e9but\u00e9