king":0.27909200099982},{"id":524441,"date_start":"2022-01-04","date_end":"2022-12-06","date_next":"2022-07-05","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":84,"translations":{"fr":"Divers","nl":"Varia","en":"Various"}},"others":{}},"languages":{"spoken":["fr","nl","en","es"],"subtitles":[]},"translations":{"fr":{"name":"Repair Cafe des Marolles","shortdescr":"LE REPAIR CAFE DES MAROLLES se trouve AU CENTRE CULTUREL BRUEGEL, \u00e0 deux pas de la place du Jeu de Balle, TOUS LES PREMIERS MARDI DE CHAQUE MOIS de 17h30 \u00e0 21h.","longdescr":">> R\u00e9parer ensemble, c\u2019est l\u2019id\u00e9e des Repair Caf\u00e9s.\r\nVous apportez vos v\u00eatements, appareils \u00e9lectriques, vaisselle, objets utiles, bijoux, jouets, et autres.. ayant besoin d\u2019une r\u00e9paration.\r\nDes r\u00e9parateurs et r\u00e9paratrices b\u00e9n\u00e9voles experts en la mati\u00e8re (\u00e9lectriciens, couturiers, menuisiers, r\u00e9parateurs de v\u00e9los) sont pr\u00e9sents pour r\u00e9aliser ces petites r\u00e9parations tout en vous expliquant comment la r\u00e9aliser vous-m\u00eame dans le futur.\r\n\r\nPoint d'attention : Un seul objet \u00e0 r\u00e9parer sera accept\u00e9 par personne et par Repair Caf\u00e9.","performers":"Les fabuleux b\u00e9n\u00e9voles de 1000BXL en Transition","boxoffice_url":null,"website":"http:\/\/1000bxlentransition.be\/all-project-list\/repair-cafe-des-marolles\/","email":"1000bxlentransition@gmail.com","phone_contact":null,"phone_booking":"+32 473 93 73 08","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/524441.html"},"nl":{"name":"Repair Cafe de Marollen","shortdescr":null,"longdescr":">> Repair Caf\u00e9 dat is samen dingen herstellen. Breng je te herstellen kleding, elektrische apparaten, gebroken potten en pannen, speelgoed etc...Vrijwillige handige harry\u2019s, poppendokters en verstelkaboutertjes zullen je helpen kleine herstellingen uit te voeren terwijl ze je aanleren hoe je het zelf in de toekomst kan doen. Wie niets te herstellen heeft, komt gewoon langs, drinkt thee of koffie en verheugt zich bij het zien van zoveel leed dat geheeld wordt. Alles draait om een uitwisseling van kennis, kunde en glimlach.\r\n\r\nAttentie : Er zal \u00e9\u00e9n object per persoon per Repair Caf\u00e9 worden gerepareerd","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/524441.html"},"en":{"name":"Marolles' Repair Caf\u00e9","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/524441.html"},"de":{"name":"Repair Cafe des Marolles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/524441.html"},"it":{"name":"Repair Cafe des Marolles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/524441.html"},"sp":{"name":"Repair Cafe des Marolles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/524441.html"},"pt":{"name":"Repair Cafe des Marolles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/524441.html"},"cn":{"name":