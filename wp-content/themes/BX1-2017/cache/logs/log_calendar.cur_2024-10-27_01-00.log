slations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[],"opening":{"day":"2024-10-04","end":"23:00:00","start":"18:00:00","timestamp":"2024-10-04T18:00:00"}},{"id":5700000142,"date_start":"2024-10-18","date_end":"2024-11-16","date_next":"2024-10-26","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-10-26T03:01:41+02:00","published_at":"2024-08-20T09:59:47+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":305910,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"other","ranking":0.3218297948685433,"languages":{"spoken":["en","fr","nl"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{}},"translations":{"de":{"name":"Ado Chale exposition r\u00e9trospective","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.adochale.com\/","email":"info@adochale.com","phone_contact":"+32 2 647 82 54","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700000142"},"pt":{"name":"Ado Chale exposition r\u00e9trospective","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.adochale.com\/","email":"info@adochale.com","phone_contact":"+32 2 647 82 54","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700000142"},"en":{"name":"Ado Chale exposition r\u00e9trospective","shortdescr":"Sublimating nature seems to have always been the creative leitmotif of famous Belgian\ndesigner Ado Chale. Now supported by his children, Ilona and Pierre, he is celebrating\n65 years in the furniture business this year. It's the perfect opportunity for a\nretrospective, featuring both historic creations and never-before-seen pieces, testifying the wealth of his talent.","longdescr":"From his travels in France, Germany, Arizona, India, Afghanistan, Pakistan, Persia and\nMadagascar, Ado Chale (1928), this \u2018lover of geology\u2019, as the critic Hugues Vehenne\ndescribed him, brought back mineral treasures that were the driving force behind his\ncreative genius. Quartz, chalcedony, lapis lazuli, jade, turquoise, rhodochrosite,\namethyst and all the other natural beauties worthy of illuminating his artist's furniture\nare still at the heart of his tireless quest for these noble materials, which sublimate his\nfamous tables and turn them into mineral gardens. In addition to these geological\nmarvels, the artist's raw riches that glorify semi-precious stones and which, without\nhim, would have remained mere stones. He has also added cast bronze and cast\naluminium, always polished and smoothed in the studio until they reveal the scars and\nimperfections that make them unique. The materials he uses are so fragile and so rare\nthat they make each of his creations unique.","performers":"Ado Chale (designer), Ilona Chale (daughter of Ado Chale), Pierre Barbion-Chale (son of Ado Chale).","boxoffice_url":null,"website":"https:\/\/www.adochale.com\/","email":"info@adochale.com","phone_contact":"+32 2 647 82 54","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700000142"},"it":{"name":"Ado Chale exposition r\u00e9trospective","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.adochale.com\/","email":"info@adochale.com","phone_contact":"+32 2 647 82 54","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700000142"},"cn":{"name":"Ado Chale exposition r\u00e9trospective","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.adochale.com\/","email":"info@adochale.com","phone_contact":"+32 2 647 82 54","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700000142"},"fr":{"name":"Ado Chale exposition r\u00e9trospective","shortdescr":"\u2018\u2018Sublimer la nature !\u2019\u2019, tel semble avoir toujours \u00e9t\u00e9 le leitmotiv cr\u00e9atif du c\u00e9l\u00e8bre\ndesigner belge Ado Chale. Aujourd\u2019hui \u00e9paul\u00e9 par ses enfants, Ilona et Pierre, celui-ci\nf\u00eate cette ann\u00e9e ses 65 ans de carri\u00e8re artistique dans la cr\u00e9ation mobili\u00e8re.\nL\u2019occasion id\u00e9ale d\u2019une r\u00e9trospective, entre cr\u00e9ations historiques et pi\u00e8ces in\u00e9dites,\nt\u00e9moignant tant de la grande richesse de son talent.","longdescr":"De ses voyages en France, en Allemagne, en Arizona, en Inde, en Afghanistan, au\nPakistan, en Perse ou encore \u00e0 Madagascar, Ado Chale (1928), cet \u00ab amant de la\ng\u00e9ologie \u00bb, comme le qualifiait le critique Hugues Vehenne, a ramen\u00e9 des tr\u00e9sors\nmin\u00e9raux qui furent le moteur de son g\u00e9nie cr\u00e9atif. Quartz, calc\u00e9doine, lapis-lazuli,\njade, turquoise, rhodochrosite, am\u00e9thyste et toutes autres beaut\u00e9s naturelles dignes\nd\u2019enluminer son mobilier d\u2019artiste sont, aujourd\u2019hui encore, au c\u0153ur d\u2019une qu\u00eate\ninlassable de ces mati\u00e8res nobles, qui subliment ses fameuses tables et les changent\nen autant de jardins min\u00e9raux. A ces merveilles g\u00e9ologiques, richesses brutes\nparticipant chez l\u2019artiste \u00e0 une glorification des pierres semi-pr\u00e9cieuses et qui, sans\nlui, seraient demeur\u00e9es simples pierres, sont \u00e9galement venus s\u2019adjoindre la fonte de\nbronze et la fonte d\u2019aluminium, toujours polies et adoucies dans l\u2019atelier jusqu\u2019\u00e0 en\nd\u00e9couvrir les cicatrices et imperfections qui les rendent uniques. Car les mat\u00e9riaux\nqu\u2019il utilise sont si fragiles et si rares qu\u2019ils font de chacune de ses cr\u00e9ations un\nunicum.","performers":"Ado Chale (designer), Ilona Chale (fille d'Ado Chale), Pierre Barbion-Chale (fils d'Ado Chale).","boxoffice_url":null,"website":"https:\/\/www.adochale.com\/","email":"info@adochale.com","phone_contact":"+32 2 647 82 54","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700000142"},"sp":{"name":"Ado Chale exposition r\u00e9trospective","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.adochale.com\/","email":"info@adochale.com","phone_contact":"+32 2 647 82 54","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700000142"},"nl":{"name":"Ado Chale exposition r\u00e9trospective","shortdescr":"De creatieve rode draad van de beroemde Belgische designer Ado Chale? Dat is zonder\ntwijfel 'de natuur sublimeren!' Tegenwoordig werkt hij samen met zijn kinderen, Ilona\nen Pierre, en dit jaar viert hij een carri\u00e8re van 65 jaar als kunstenaar. De ideale gelegenheid voor een terugblik, van historische creaties tot nooit\neerder geziene stukken, die de rijkdom van zijn talent tentoonstelt.\n","longdescr":"Ado Chale (1928), een \"liefhebber van geologie\" zoals de criticus Hugues Vehenne hem\nnoemt, heeft heel wat minerale schatten teruggebracht van zijn reizen naar Frankrijk,\nDuitsland, Arizona, India, Afghanistan, Pakistan, Perzi\u00eb of Madagaskar. Stukken die\nde basis vormden voor zijn creatief genie. Kwarts, chalcedon, lapis lazuli, jade,\nturkoois, rhodochrosiet, amethist en tal van andere natuurlijke pareltjes eigen aan zijn\nkunstwerken, vormen vandaag nog steeds de rode draad in een onvermoeibare\nzoektocht naar deze edele materialen. Ze tillen de beroemde tafels naar een hoger\nniveau en toveren ze tegelijkertijd om tot een tuin van mineralen. Deze ruwe\ngeologische schatten, die dankzij deze kunstenaar verheven worden tot halfedelstenen\nworden aangevuld met brons en aluminium. Het geheel wordt in het atelier gepolijst\nen bijgeschaafd tot de unieke littekens en imperfecties zichtbaar worden. De\nmaterialen die hij gebruikt zijn zo fragiel en zeldzaam dat ze van elke creatie een uniek\nstuk maken.","performers":"Ado Chale (designer), Ilona Chale (dochter van Ado Chale), Pierre Barbion-Chale (zoon van Ado Chale).","boxoffice_url":null,"website":"https:\/\/www.adochale.com\/","email":"info@adochale.com","phone_contact":"+32 2 647 82 54","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700000142"}},"place":{"id":50002174,"translations":{"de":{"name":"Ado Chale","address_street_name":"Rue Lens","address_street_number":"36","address_street_box":null,"email":"info@adochale.com","website":"https:\/\/www.adochale.com\/","phone_contact":"+32 2 647 82 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Lens, 36","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Ado Chale","address_street_name":"Rue Lens","address_street_number":"36","address_street_box":null,"email":"info@adochale.com","website":"https:\/\/www.adochale.com\/","phone_contact":"+32 2 647 82 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Lens, 36","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Ado Chale","address_street_name":"Lensstraat","address_street_number":"36","address_street_box":null,"email":"info@adochale.com","website":"https:\/\/www.adochale.com\/","phone_cont