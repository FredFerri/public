de trop, l'une qui veut son bien, une autre qui veut \u00e0 tout prix \"r\u00e9ussir\", et encore un autre qui n'a rien \u00e0 dire , car Li Fet Met, le pass\u00e9 est mort.\nEt gr\u00e2ce au th\u00e9\u00e2tre-forum, c'est une pi\u00e8ce de th\u00e9\u00e2tre dans laquelle le public intervient pour changer le cours de l'histoire.","performers":"Cr\u00e9ation collective, interpr\u00e9t\u00e9e par la troupe de th\u00e9\u00e2tre-action de Ras El Hanout dirig\u00e9e par Kawtar BOULA\u00c2LAMAT","boxoffice_url":null,"website":"https:\/\/ras-el-hanout.be\/spectacle\/li-fet-met\/","email":"info@ras-el-hanout.be","phone_contact":"+32 488 01 14 11","phone_booking":"+32 488 01 14 11","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50012351"},"sp":{"name":"Li Fet Met","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/ras-el-hanout.be\/spectacle\/li-fet-met\/","email":"info@ras-el-hanout.be","phone_contact":"+32 488 01 14 11","phone_booking":"+32 488 01 14 11","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50012351"},"nl":{"name":"Li Fet Met","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/ras-el-hanout.be\/spectacle\/li-fet-met\/","email":"info@ras-el-hanout.be","phone_contact":"+32 488 01 14 11","phone_booking":"+32 488 01 14 11","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50012351"}},"place":{"id":237040,"translations":{"de":{"name":"Espace Toots","address_street_name":"Rue Edouard Stuckens","address_street_number":"125","address_street_box":null,"email":"espacetoots@evere.irisnet.be","website":"http:\/\/www.facebook.com\/ESpacetoots\/","phone_contact":"+32 2 241 15 83","phone_booking":null,"address_zip":"1140","address_city":"Evere","address_line1":"Rue Edouard Stuckens, 125","address_line2":"1140 Evere","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_vis