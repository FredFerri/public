rt":"11:00:00","end":"18:00:00"},{"day":"2022-09-01","doors":null,"start":"11:00:00","end":"18:00:00"},{"day":"2022-09-02","doors":null,"start":"11:00:00","end":"18:00:00"},{"day":"2022-09-03","doors":null,"start":"11:00:00","end":"18:00:00"}],"weekschema":[{"days":{"monday":{"is_open":false},"tuesday":{"is_open":true,"hours":[{"start":"11:00:00","end":"18:00:00"}]},"wednesday":{"is_open":true,"hours":[{"start":"11:00:00","end":"18:00:00"}]},"thursday":{"is_open":true,"hours":[{"start":"11:00:00","end":"18:00:00"}]},"friday":{"is_open":true,"hours":[{"start":"11:00:00","end":"18:00:00"}]},"saturday":{"is_open":true,"hours":[{"start":"11:00:00","end":"18:00:00"}]},"sunday":{"is_open":false}},"translations":{"fr":["lundi et dimanche: ferm\u00e9","mardi, mercredi, jeudi, vendredi et samedi: de 11:00 \u00e0 18:00"],"nl":["maandag en zondag: gesloten","dinsdag, woensdag, donderdag, vrijdag en zaterdag: van 11:00 tot 18:00"],"en":["monday and sunday: closed","tuesday, wednesday, thursday, friday and saturday: from 11:00 to 18:00"]},"date_start":"2022-05-17","date_end":"2022-09-04","is_also_by_appointment":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-07-21T01:08:34+02:00","published_at":"2022-06-20T09:18:48+02:00","backoffice_id":256328,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.20807776469269},{"id":526911,"date_start":"2022-02-03","date_end":"2022-09-25","date_next":"2022-07-21","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[36,42],"translations":{"fr":["Mus\u00e9es et art centers","Peinture"],"nl":["Musea en kunstcentra","Schilderkunst"],"en":["Museums and art centers","Painting"]}}},"languages":{"spoken":["nl","fr","en"],"subtitles":[]},"translations":{"fr":{"name":"R\u00e9p\u00e9tition et reprise dans l'oeuvre de Felix De Boeck","shortdescr":"Le soleil, les diagonales, les paysages abstraits, les cercles, les autoportraits... Felix De Boeck a r\u00e9p\u00e9t\u00e9 des formes, des couleurs, des th\u00e8mes et des compositions tout au long de sa - longue - vie, pour finalement revenir \u00e0 l'abstraction pure, \u00e0 des \u0153uvres d'art r\u00e9duites \u00e0 leur essence.","longdescr":"Tr\u00e8s jeune, Felix De Boeck avait d\u00e9j\u00e0 d\u00e9velopp\u00e9 une vision tr\u00e8s claire de son projet artistique. Il serait le peintre d\u2019une \u0153uvre, c\u2019est-\u00e0-dire d\u2019un ensemble coh\u00e9rent de peintures qui ne peuvent se comprendre que comme faisant partie d\u2019un tout.\r\n\r\nA premi\u00e8re vue, l\u2019ensemble de peintures qu\u2019il nous a l\u00e9gu\u00e9 est loin d\u2019\u00eatre homog\u00e8ne et il est difficile de trouver un fil conducteur. Il ne s\u2019agit pas d\u2019un d\u00e9veloppement lin\u00e9aire mais de reprises et r\u00e9p\u00e9titions : des th\u00e8mes, des compositions, des formes g\u00e9om\u00e9triques et des couleurs qui jalonnent l\u2019\u0153uvre de Felix De Boeck. Si le style \u00e9volue, les th\u00e8mes et les compositions, eux, restent.","performers":"Felix De Boeck","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/526911.html"},"nl":{"name":"Herhaling en herneming in het oeuvre van Felix De Boeck","shortdescr":"De zon, diagonalen, abstracte landschappen, cirkels, zelfportretten... Felix De Boeck hernam vormen, kleuren, thema's en composities  zijn hele - lange - leven lang, om uiteindelijk terug te keren naar de zuivere abstractie, naar kunstwerken herleid tot de essentie.","longdescr":"De ambitie van Felix De Boeck was al heel vroeg duidelijk: een \u2018oeuvre\u2019-schilder te zijn, van een levenswerk van schilderijen die alle deel uitmaken van \u00e9\u00e9n groot logisch opgebouwd geheel.\r\n\r\nHomogeniteit is op het eerste zicht echter ver te zoeken in zijn oeuvre. De ontwikkeling van zijn werk verloopt niet lineair, maar via herhalingen en hernemingen. Van thema\u2019s, composities, vormen en kleuren die steeds weer terugkeren, zij het in een andere stijl.\r\n\r\nZo laveert zijn werk door de jaren heen tussen abstractie en figuratie, experiment en thema\u2019s die worden hernomen. Zijn artistieke parcours vertaalt zich als een voortdurende zoektocht naar evenwicht tussen geometrie, kleuren en inhoud.","performers":"Felix De Boeck","boxoffice_url":null,"website":"http:\/\/www.felixart.org","email":"info@felixart.org","phone_contact":"+32 2 377 57 22","phone_booking":"+32 2 377 57 22","agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/526911.html"},"en":{"name":"Repetition and reuse in the oeuvre of Felix De Boeck","shortdescr":"The sun, diagonals, abstract landscapes, circles, self-portraits... Felix De Boeck repeated forms, colours, themes and compositions throughout his - long - life, to finally return to pure abstraction, to artworks reduced to their essence.","longdescr":"Felix De Boeck\u2019s ambition was clear from an early age: to be an \u2018oeuvre\u2019 painter, of a coherent set of paintings that can only be understood as part of a larger whole.\r\n\r\nAt first glance, however, the oeuvre he left is far from homogeneous and it is difficult to find a common thread. The development of his work is not linear but rather a repetition of themes. Themes, compositions, forms and colours keep returning, though in a different style.\r\n\r\nThroughout the years, his work navigates between abstraction and figuration, experimentation and revival of old themes. His artistic path reveals itself as a constant search for balance between geometry, colours and content.","performers":"Felix De Boeck","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/526911.html"},"de":{"name":"Herhaling en herneming in het oeuvre van Felix De Boeck","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/526911.html"},"it":{"name":"Herhaling en herneming in het oeuvre van Felix De Boeck","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/526911.html"},"sp":{"name":"Herhaling en herneming in het oeuvre van Felix De Boeck","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/526911.html"},"pt":{"name":"Herhaling en herneming in het oeuvre van Felix De Boeck","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/526911.html"},"cn":{"name":"Herhaling en herneming in het oeuvre van Felix De Boeck","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/526911.html"}},"place":{"id":248774,"translations":{"fr":{"name":"FeliXart Museum","address_street_name":"Kuikenstraat","address_street_number":"6","address_street_box":null,"email":null,"website":"http:\/\/www.felixart.org","phone_contact":"+32 2 377 57 22","phone_booking":null,"address_zip":"1620","address_city":"Drogenbos","address_line1":"Kuikenstraat, 6","address_line2":"1620 Drogenbos","description_web":"Dans un endroit inattendu, au centre de la commune urbanis\u00e9e de Drogenbos, se trouve le FeliXart Museum, entour\u00e9 d\u2019une oasis de verdure de 5ha. Ce domaine appartenait \u00e0 Felix De Boeck (1898-1995), l\u2019un des pionniers de l\u2019art abstrait en Belgique. Le mus\u00e9e a ouvert ses portes en 1996 et se concentre sur l\u2019art abstrait des avant-gardes historiques, l\u2019art contemporain ainsi que sur les questions de perception visuelle. Gr\u00e2ce \u00e0 diff\u00e9rents projets, dont des expositions et des publications d\u2019importance nationale et internationale, le mus\u00e9e a d\u00e9velopp\u00e9 une r\u00e9elle expertise sur le sujet et a pris, ces derni\u00e8res ann\u00e9es, une place de plus en plus remarqu\u00e9e au sein des institutions mus\u00e9ales.\r\n\r\nLe mus\u00e9e fonctionne avec deux grands volets. D\u2019une part, il y a FeliXeco, le volet \u00e9cologique, qui se d\u00e9ploie principalement entre les arbres sur le magnifique domaine vert du mus\u00e9e. D\u2019autre part, il y a FeliXart, la partie artistique de l\u2019organisation. L\u2019ART dans FeliXart repr\u00e9sente trois plateformes : Aspects, R\u00e9flexions et Talents. Un triptyque sur lequel le mus\u00e9e travaille pour garder l\u2019art vivant et continuer \u00e0 surprendre le visiteur. N\u00e9anmoins, le travail de Felix forme le fil conducteur, la qualit\u00e9 et l\u2019authenticit\u00e9 sont les crit\u00e8res les plus importants. L\u2019objectif est d\u2019actualiser et de contextualiser l\u2019\u0153uvre du peintre-fermier.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"FeliXart Museum","address_street_name":"Kuikenstraat","address_street_number":"6","address_street_box":null,"email":null,"website":"http:\/\/www.felixart.org","phone_contact":"+32 2 377 57 22","phone_booking":null,"address_zip":"1620","address_city":"Drogenbos","address_line1":"Kuikenstraat, 6","address_line2":"1620 Drogenbos","description_web":"Op een plek waar je het niet verwacht, in het centrum van de kleine verstedelijkte gemeente Drogenbos, ligt het FeliXart museum, in een oase van 5ha groen, het domein dat ooit van Felix De Boeck (1895-1995) was, een van de pioniers van de Belgische abstracte kunst. Het museum opende in 1996 en focust zich op historische en hedendaagse avant-gardekunst. Dankzij tentoonstellingen, projecten en publicaties van nationale en internationale uitstraling heeft het museum de laatste jaren een belangrijke plaats ingenomen binnen de expertise rond avant-garde, Interbellum en abstracte kunst.\r\n\r\nHet museum werkt met twee grote luiken. Enerzijds is het er FeliXeco, het ecologische luik, dat zich voornamelijk ontplooit tussen de bomen op het prachtige groene domein van het museum. Daarnaast is er FeliXart, het artistieke luik van de organisatie. De ART in FeliXart staat voor drie platformen: Aspecten, Reflecties en Talenten. Een drieluik waarop het museum inzet om kunst in leven te houden en de bezoeker te blijven verrasssen. Het werk van Felix vormt niettemin de rode draad, kwaliteit en authenticiteit zijn de belangrijkste criteria. Actualisering en contextualisering van het oeuvre van de schilder-boer zijn het doel.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"FeliXart Museum","address_street_name":"Kuikenstraat","address_street_number":"6","address_street_box":null,"email":null,"website":"http:\/\/www.felixart.org","phone_contact":"+32 2 377 57 22","phone_booking":null,"address_zip":"1620","address_city":"Drogenbos","address_line1":"Kuikenstraat, 6","address_line2":"1620 Drogenbos","description_web":"In a place where you wouldn\u2019t expect it, in the centre of the small urbanised municipality of Drogenbos, the FeliXart museum is situated in an oasis of 5 hectares of green, the domain that once belonged to Felix De Boeck (1895-1995), one of the pioneers of Belgian abstract art. The museum opened in 1996 and focuses on historical and contemporary avant-garde art. Thanks to exhibitions, projects and publications of national and international standing, the museum has in recent years occupied an important place within the expertise on avant-garde, Interbellum and abstract art.\r\n\r\nThe museum works with two large panels. On the one hand there is FeliXeco, the ecological hatch, which mainly unfolds between the trees on the beautiful green domain of the museum. On the other hand there is FeliXart, the artistic part of the organisation. The ART in FeliXart stands for three platforms: Aspects, Reflections and Talents. A triptych on which the museum works to keep art alive and continue to surprise the visitor. Nevertheless, Felix\u2019s work forms the common thread, quality and authenticity are the most important criteria. The aim is to update and contextualise the oeuvre of the painter-farmer.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"FeliXart Museum","address_street_name":"Kuikenstraat","address_street_number":"6","address_street_box":null,"email":null,"website":"http:\/\/www.felixart.org","phone_contact":"+32 2 377 57 22","phone_booking":null,"address_zip":"1620","address_city":"Drogenbos","address_line1":"Kuikenstraat, 6","address_line2":"1620 Drogenbos","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"FeliXart Museum","address_street_name":"Kuikenstraat","address_street_number":"6","address_street_box":null,"email":null,"website":"http:\/\/www.felixart.org","phone_contact":"+32 2 377 57 22","phone_booking":null,"address_zip":"1620","address_city":"Drogenbos","address_line1":"Kuikenstraat, 6","address_line2":"1620 Drogenbos","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"FeliXart Museum","address_street_name":"Kuikenstraat","address_street_number":"6","address_street_box":null,"email":null,"website":"http:\/\/www.felixart.org","phone_contact":"+32 2 377 57 22","phone_booking":null,"address_zip":"1620","address_city":"Drogenbos","address_line1":"Kuikenstraat, 6","address_line2":"1620 Drogenbos","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"FeliXart Museum","address_street_name":"Kuikenstraat","address_street_number":"6","address_street_box":null,"email":null,"website":"http:\/\/www.felixart.org","phone_contact":"+32 2 377 57 22","phone_booking":null,"address_zip":"1620","address_city":"Drogenbos","address_line1":"Kuikenstraat, 6","address_line2":"1620 Drogenbos","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"FeliXart Museum","address_street_name":"Kuikenstraat","address_street_number":"6","address_street_box":null,"email":null,"website":"http:\/\/www.felixart.org","phone_contact":"+32 2 377 57 22","phone_booking":null,"address_zip":"1620","address_city":"Drogenbos","address_line1":"Kuikenstraat, 6","address_line2":"1620 Drogenbos","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":[],"zones":{"list":[999],"translations":{"fr":["Autour de Bruxelles"],"nl":["Rond Brussel"],"en":["Around Brussels"]}},"tags":["force_publication"],"neca":null,"facebook_id":null,"backoffice_id":10930,"location":{"lat":50.7893747,"lon":4.3147533},"region":"flanders","last_updated_at":"2022-07-18T01:07:26+02:00","published_at":"2013-10-19T01:29:23+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":false,"resto_ranking":0},"organizer":{"id":248774,"translations":{"fr":{"name":"FeliXart Museum","address_street_name":"Kuikenstraat","address_street_number":"6","address_street_box":null,"email":null,"website":"http:\/\/www.felixart.org","phone_contact":"+32 2 377 