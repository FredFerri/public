":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen","it":"Visite guidate","sp":"Visitas guiadas","pt":null,"cn":null}},"others":{"list":[253],"translations":{"fr":["Visites guid\u00e9es d\u2019int\u00e9rieurs"],"nl":["Interieur rondleidingen"],"en":["Interior guided tours"],"de":["F\u00fchrungen durch Innenr\u00e4ume"],"it":["Visite guidate all\u2019interno"],"sp":["Visitas guiadas en espacios interiores"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"L'ancien cin\u00e9ma le Movy Club","shortdescr":null,"longdescr":"Le Movy, l\u2019enseigne d\u2019origine du cin\u00e9ma, \u00e9tait l\u2019une des dizaines de \u00ab salles des faubourgs \u00bb ou cin\u00e9ma de quartier de Bruxelles. Ouverte en 1934 dans une petite rue de Forest, la coquette salle et son \u00e9cran unique ont connu leurs heures de gloire r\u00e9centes dans les ann\u00e9es 80 et 90 sous l\u2019enseigne de Movy Club, gr\u00e2ce \u00e0 son propri\u00e9taire et exploitant homme-orchestre Pierre Gueulette. Ces soins ont permis au Movy Club d\u2019\u00eatre inscrit sur la liste de sauvegarde de la R\u00e9gion de Bruxelles-Capitale, pour son int\u00e9r\u00eat architectural, historique et technique, notamment sa cabine de projection munies de deux projecteurs au charbon.\r\nRachet\u00e9 en 2015 par la R\u00e9gion, le Movy s\u2019appr\u00eate \u00e0 redevenir un cin\u00e9ma de proximit\u00e9 \u00e0 destination du public forestois gr\u00e2ce \u00e0 une r\u00e9novation et une extension des lieux pr\u00e9vue pour 2024 environ.","performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/node\/11547","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":"+32 2 319 45 60","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.555547"},"nl":{"name":"L'ancien cin\u00e9ma le Movy Club","shortdescr":null,"longdescr":n