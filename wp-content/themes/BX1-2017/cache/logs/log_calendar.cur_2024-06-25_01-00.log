erformers":null,"boxoffice_url":null,"website":"http:\/\/fondationdentreprisehermes.org","email":"laverriere@hermes.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50011070"},"pt":{"name":"Emmanuelle Castellan \"Spektrum\" : Hors-les-murs","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/fondationdentreprisehermes.org","email":"laverriere@hermes.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50011070"},"en":{"name":"La Verri\u00e8re - Guided tour \"hors-les-murs\"","shortdescr":"The augmented visit \"Hors-les-murs\" invites you to discover several sites that inspired the exhibitions of Jo\u00ebl Riff around  La Verri\u00e8re. The opportunity to (re)discover part of the city of Brussels and its cultural heritage.","longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/fondationdentreprisehermes.org","email":"laverriere@hermes.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50011070"},"it":{"name":"Emmanuelle Castellan \"Spektrum\" : Hors-les-murs","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/fondationdentreprisehermes.org","email":"laverriere@hermes.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50011070"},"cn":{"name":"Emmanuelle Castellan \"Spektrum\" : Hors-les-murs","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/fondationdentreprisehermes.org","email":"laverriere@hermes.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50011070"},"fr":{"name":"La Verri\u00e8re - Visite guid\u00e9e \"hors-les-murs\"","shortdescr":"La visite augment\u00e9e \u00ab hors-les-murs\" vous invite \u00e0 d\u00e9couvrir plusieurs sites qui ont inspir\u00e9 les expositions de Jo\u00ebl Riff autour de la Verri\u00e8re. L\u2019occasion de (re)d\u00e9couvrir une partie de la ville de Bruxelles et de son patrimoine culturel.","longdescr":"Visite augment\u00e9e\/parcours hors-les-murs (1h30) \n\n01 juin, 29 juin et 20 juillet 2024\n\nUn parcours Hors-les-murs, accompagn\u00e9 par un m\u00e9diateur culturel pour d\u00e9couvrir des \u0153uvres cach\u00e9es dans le paysage bruxellois en r\u00e9sonance avec les expositions de La Verri\u00e8re.\n\nLe parcours reprend plusieurs sites qui ont inspir\u00e9 les expositions de Jo\u00ebl Riff au sein de la Verri\u00e8re. Des \u0153uvres sculpturales qui sont pr\u00e9sentes dans l'espace public, mais qui sont souvent occult\u00e9es par la densit\u00e9 de l\u2019architecture environnante. Le parcours Hors-les-murs est l\u2019occasion de d\u00e9couvrir une partie de la ville de Bruxelles et de son patrimoine culturel.\n\nLa visite dure 1h30 et commence \u00e0 l'accueil de La Verri\u00e8re.\nVisite gratuite sur r\u00e9servation : laverriere@hermes.com\n(En fran\u00e7ais ou en anglais)","performers":null,"boxoffice_url":null,"website":"http:\/\/fondationdentreprisehermes.org","email":"laverriere@hermes.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50011070"},"sp":{"name":"Emmanuelle Castellan \"Spektrum\" : Hors-les-murs","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/fondationdentreprisehermes.org","email":"laverriere@hermes.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50011070"},"nl":{"name":"Emmanuelle Castellan \"Spektrum\" : Hors-les-murs","shortdescr":null,"longdescr":"Visite augment\u00e9e\/outside-the-walls tour (1h30) \n\nJune 01, June 29 and July 20, 2024\n\nAn off-wall tour, accompanied by a guide, to discover works of art hidden in the Brussels landscape, in resonance with La Verri\u00e8re's exhibitions.\n\nThe tour takes you to sevral  sites that have inspired Jo\u00ebl Riff's exhibitions at La Verri\u00e8re.\n Sculptural works that are present in the public space, but are often obscured by the density of the surrounding architecture. The \"Hors-les-murs\" tour is an opportunity to discover part of the city of Brussels and its cultural heritage.\n\nThe tour lasts 1h30 and starts at La Verri\u00e8re reception desk.\n\nFree tour on reservation: laverriere@hermes.com\n(In French or English)\n\n","performers":null,"boxoffice_url":null,"website":"http:\/\/fondationdentreprisehermes.org","email":"laverriere@hermes.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50011070"}},"place":{"id":236592,"translations":{"de":{"name":"La Verri\u00e8re","address_street_name":"Boulevard de Waterloo","address_street_number":"50","address_street_box":null,"email":null,"website":"http:\/\/www.fondationdentreprisehermes.org","phone_contact":"+ 32 (0)2-511.20.62","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Boulevard de Waterloo, 50","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"La Verri\u00e8re","address_street_name":"Boulevard de Waterloo","address_street_number":"50","address_street_box":null,"email":null,"website":"http:\/\/www.fondationdentreprisehermes.org","phone_contact":"+ 32 (0)2-511.20.62","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Boulevard de Waterloo, 50","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"La Verri\u00e8re","address_street_name":"Boulevard de Waterloo","address_street_number":"50","address_street_box":null,"email":null,"website":"http:\/\/www.fondationdentreprisehermes.org","phone_contact":"+ 32 (0)2-511.20.62","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Boulevard de Waterloo, 50","address_line2":"1000 Brussels","description_web":"\u201cThe Fondation d\u2019entreprise Herm\u00e8s has provided long-term support for the visual arts through a programme of exhibitions conceived by curators attentive to both France\u2019s contemporary art scene and the presentation of work by French artists abroad, whether they are at the start of their careers or more established figures. Unfolding across the Foundation\u2019s four dedicated spaces in Europe and Asia, these exhibitions often feature new work and constitute broad artistic gestures that the public are invited to discover.\n \nLa Verri\u00e8re in Brussels, curated by Jo\u00ebl Riff, is a place that play host to projects specially conceived by invited artists. The Foundation closely accompanies every step of the creative process, and supports the development of original approaches and artistic gestures, from their production stages through to their presentation to the public.\u201d\n","description_print":null,"booking_url":null,"sort_order":"VERRI\u00c8RE","virtual_visit":null,"visit_url":null},"it":{"name":"La Verri\u00e8re","address_street_name":"Boulevard de Waterloo","address_street_number":"50","address_street_box":null,"email":null,"website":"http:\/\/www.fondationdentreprisehermes.org","phone_contact":"+ 32 (0)2-511.20.62","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Boulevard de Waterloo, 50","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"La Verri\u00e8re","address_street_name":"Boulevard de Waterloo","address_street_number":"50","address_street_box":null,"email":null,"website":"http:\/\/www.fondationdentreprisehermes.org","phone_contact":"+ 32 (0)2-511.20.62","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Boulevard de Waterloo, 50","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"La Verri\u00e8re","address_street_name":"Boulevard de Waterloo","address_street_number":"50","address_street_box":null,"email":null,"website":"http:\/\/www.fondationdentreprisehermes.org","phone_contact":"+ 32 (0)2-511.20.62","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Boulevard de Waterloo, 50","address_line2":"1000 Bruxelles","description_web":"\"La Fondation d'entreprise Herm\u00e8s soutient durablement les arts visuels \u00e0 travers un programme d'expositions con\u00e7ues par des commissaires attentifs \u00e0 la fois \u00e0 la sc\u00e8ne artistique contemporaine fran\u00e7aise et \u00e0 la pr\u00e9sentation d'\u0153uvres d'artistes fran\u00e7ais \u00e0 l'\u00e9tranger, qu'ils soient en d\u00e9but de carri\u00e8re ou plus confirm\u00e9s. D\u00e9ploy\u00e9es dans les quatre espaces d\u00e9di\u00e9s de la Fondation en Europe et en Asie, ces expositions pr\u00e9sentent souvent des \u0153uvres in\u00e9dites et constituent des gestes artistiques d'envergure que le public est invit\u00e9 \u00e0 d\u00e9couvrir.\n \nLa Verri\u00e8re \u00e0 Bruxelles, sous le commissariat de Jo\u00ebl Riff, est un lieu qui accueille des projets sp\u00e9cialement con\u00e7us par les artistes invit\u00e9s. La Fondation accompagne de pr\u00e8s toutes les \u00e9tapes du processus de cr\u00e9ation et soutient le d\u00e9veloppement de d\u00e9marches et de gestes artistiques originaux, depuis leur production jusqu'\u00e0 leur pr\u00e9sentation au public\".\n","description_print":null,"booking_url":null,"sort_order":"VERRI\u00c8RE","virtual_visit":null,"visit_url":null},"sp":{"name":"La Verri\u00e8re","address_street_name":"Boulevard de Waterloo","address_street_number":"50","address_street_box":null,"email":null,"website":"http:\/\/www.fondationdentreprisehermes.org","phone_contact":"+ 32 (0)2-511.20.62","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Boulevard de Waterloo, 50","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"La Verri\u00e8re","address_street_name":"Waterloolaan","address_street_number":"50","address_street_box":null,"email":null,"website":"http:\/\/www.fondationdentreprisehermes.org","phone_contact":"+ 32 (0)2-511.20.62","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Waterloolaan, 50","address_line2":"1000 Brussel","description_web":"De Verri\u00e8re-Herm\u00e8s die in 2000 werd opgericht, maakt deel uit van het internationale netwerk van galerijen van de Fondation d\u2019entreprise Herm\u00e8s. Deze Stichting steunt projecten die een echo vormen van het universum van het huis Herm\u00e8s: opwaardering voor ambachtelijke kennis en steun aan creativiteit, betrokkenheid bij onderwijs en bij het milieu. De Stichting ontwikkelt haar eigen programma's: tentoonstellingen en artiestenresidenties voor de plastische kunsten, Prix Emile Herm\u00e8s voor design, knowhow-academie, oproepen voor projecten rond biodiversiteit. In het raam van haar mecenaat produceert en promoot la Verri\u00e8re elk jaar vier expo\u2019s van hedendaagse kunst, gekoppeld aan designpresentaties. Voor elke tentoonstelling wordt een kleine catalogus gepubliceerd","description_print":null,"booking_url":null,"sort_order":"VERRI\u00c8RE","virtual_visit":null,"visit_url":null}},"districts":{"list":[10],"translations":{"de":["Louise"],"pt":[null],"en":["Louise"],"it":["Louise"],"cn":[null],"fr":["Louise"],"sp":["Louise"],"nl":["Louiza"]}},"zones":{"list":[19],"tran