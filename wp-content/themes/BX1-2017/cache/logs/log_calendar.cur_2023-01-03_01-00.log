lse,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater","it":null,"sp":null,"pt":null,"cn":null}},"others":{"list":[51],"translations":{"fr":["Caf\u00e9 th\u00e9\u00e2tre"],"nl":["Cabaret"],"en":["Cabaret"],"de":["Kabarett"],"it":[null],"sp":[null],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"IMPROPEDIA - Spectacle D'improvisation des Coolos","shortdescr":"Spectacles dont les b\u00e9n\u00e9fices vont \u00e0 diff\u00e9rentes associations caritatives","longdescr":"\" IMPROPEDIA \"\r\n\r\nT'as rien \u00e0 faire ce soir-l\u00e0 ?\r\n\r\n\r\nT'as envie de d\u00e9penser de l'argent pour une bonne cause (les entr\u00e9es vont au \u00e0 une association) ? T'as envie de revoir des Coolos sur sc\u00e8ne ? Tu veux devenir plus intelligent ? \r\n\r\n Alors viens te marrer devant IMPROPEDIA, un spectacle d'impro qui rend plus malin que le fils de Julien Lepers et d'Albert Einstein.\r\n\r\n\r\nPar l'\u00e9quipe des Coolos\r\n\r\n-------`\r\n\r\nINFOS PRATIQUES\r\n\r\nLieu : Le TRAC\r\nAdresse : 110, rue Albert Meunier- Auderghem\r\n\r\nSpectacle \u00e0 20h15\r\nIl est possible de manger et\/ou boire un verre sur place avant le spectacle, pensez donc \u00e0 venir plus t\u00f4t! (Derni\u00e8re commande de restauration \u00e0 19h55!)\r\n\r\nR\u00c9SERVATIONS (vivement conseill\u00e9es)\r\nvia le lien du Trac : https:\/\/www.letrac.be\/reservations\r\n\r\nTARIFS\r\n- Sur r\u00e9servation : 10\u20ac\/\u00e9tudiant & 13\u20ac\/adulte\r\n- Sur place : 15\u20ac\/personne","performers":"Spectacle de l'\u00e9quipe d'improvisation \"Les Coolos 2.0\"","boxoffice_url":null,"website":"http:\/\/www.letrac.be\/reservation","email":"info@letrac.be","phone_contact":"+32 470 50 04 75","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.544966"},"nl":{"name":"IMPROPEDIA - Spectacle D'improvisation des Coolos","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.544966"},"en":{"name":"IMPROPEDIA - Spectacle D'improvisation des Coolos","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.544966"},"de":{"name":"IMPROPEDIA - Spectacle D'improvisation des Coolos","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.544966"},"it":{"name":"IMPROPEDIA - Spectacle D'improvisation des Coolos","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.544966"},"sp":{"name":"IMPROPEDIA - Spectacle D'improvisation des Coolos","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.544966"},"pt":{"name":"IMPROPEDIA - Spectacle D'improvisation des Coolos","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.544966"},"cn":{"name":"IMPROPEDIA - Spectacle D'improvisation des Coolos","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"