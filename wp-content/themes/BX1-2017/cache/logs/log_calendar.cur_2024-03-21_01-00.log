:false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":296628,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"festival","ranking":1,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":118,"translations":{"de":"Festival","pt":null,"en":"Festival","it":"Festival","cn":null,"fr":"Festival","sp":"Festival","nl":"Festival"}},"others":{}},"translations":{"de":{"name":"Plurielles - Femmes de la Diaspora africaine","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/le-phare.mediatheque.be\/agenda\/","email":"lephare@uccle.brussels","phone_contact":"+32 2 605 14 80","phone_booking":"+32 2 605 14 80","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50008461"},"pt":{"name":"Plurielles - Femmes de la Diaspora africaine","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/le-phare.mediatheque.be\/agenda\/","email":"lephare@uccle.brussels","phone_contact":"+32 2 605 14 80","phone_booking":"+32 2 605 14 80","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50008461"},"en":{"name":"Plurielles - Femmes de la Diaspora africaine","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/le-phare.mediatheque.be\/agenda\/","email":"lephare@uccle.brussels","phone_contact":"+32 2 605 14 80","phone_booking":"+32 2 605 14 80","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50008461"},"it":{"name":"Plurielles - Femmes de la Diaspora africaine","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/le-phare.mediatheque.be\/agenda\/","email":"lephare@uccle.brussels","phone_contact":"+32 2 605 14 80","phone_booking":"+32 2 605 14 80","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50008461"},"cn":{"name":"Plurielles - Femmes de la Diaspora africaine","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/le-phare.mediatheque.be\/agenda\/","email":"lephare@uccle.brussels","phone_contact":"+32 2 605 14 80","phone_booking":"+32 2 605 14 80","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50008461"},"fr":{"name":"Plurielles - Femmes de la Diaspora africaine","shortdescr":"Expo, slam, ateliers danse et percussions, spectacle de danses rwandaises... pour adultes et enfants !\nDans le cadre du Festival des Solidarit\u00e9s Internationales - Uccle","longdescr":"10h30 : Pr\u00e9sentation de l'exposition Femmes PluriElles autour d'un petit d\u00e9jeuner\n\n11h : Pr\u00e9sentation du livre PluriElles, Femmes de la diaspora africaine et performance slam de Joy Slam\n\nJoy Slam, aussi connue sous le nom Gioia Kayaga est une artiste belgo-italo-burundaise. Po\u00e9tesse et slameuse globe-trotteuse, elle a \u00e9t\u00e9 invit\u00e9e \u00e0 se produire dans une douzaine de pays diff\u00e9rents. \u00c0 travers ses albums et les livres qu'elle \u00e9crit, elle parle de son m\u00e9tissage, de ses engagements, de ses joies et de ses r\u00e9voltes. F\u00e9ministe engag\u00e9e, elle a produit au cours de sa carri\u00e8re de nombreux projets destin\u00e9s \u00e0 donner de la visibilit\u00e9 aux femmes, en Belgique et au Burundi.\n\n12h00 - 13h00 : Repas africain, vente\/expo d'objets africains\n\n13h30 - 14h30 : Atelier d\u2019initiation \u00e0 la danse rwandaise avec Ganishya Runyinya \u2013 Pour adultes et enfants, d\u00e8s 6 ans\nGanishya propose un atelier de danses traditionnelles rwandaises, selon la m\u00e9thode \u00ab Kwikunda \u00bb qui veut dire \u00ab s\u2019aimer \u00bb en Kinyarwanda, la langue du Rwanda.\nUne des danses les plus connues est le \u00ab Gushayaya \u00bb lors de laquelle les femmes ex\u00e9cutent des mouvements \u00e9l\u00e9gants en utilisant leurs bras pour imiter la forme gracieuse des cornes des vaches Inyambo, les vaches royales \u00e0 longues cornes.\nLa m\u00e9thode de Ganishya aide \u00e0 d\u00e9velopper les capacit\u00e9s d\u2019expression, de communication et de sensibilit\u00e9.\n\n15h00 - 16h00 : Projection d'une vid\u00e9o d'activit\u00e9 d'autonomisation des femmes \u2013 Projet Makeda - d\u00e9bat\n\n16h30 - 17h30 : Atelier \u201cA la d\u00e9couverte des percussions du monde\u201d avec l\u2019ASBL Keur Niamala - Pour adultes et enfants, d\u00e8s 6ans\nDans une ambiance joyeuse et chaleureuse, on d\u00e9couvre ensemble des percussions du monde, on manipule, on danse\u2026 On voyage ensemble, petit\u00b7e\u00b7s & grand\u00b7e\u00b7s, \u00e0 travers les continents, les rythmes et les cultures, port\u00e9s par la passion, le talent musical et l\u2019\u00e9nergie solaire d\u2019Honor\u00e9.\n\n18h00 - 19h00 : Spectacle de danses traditionnelles du Rwanda avec le ballet Irebero\nInscriptions : 02 605 14 80 ou lephare@uccle.brussels","performers":"Joy Slam (po\u00e9tesse et slameuse); Dja\u00efli MBock ASBL; Ganishya Runyinya; ASBL Keur Niamala (Percussions); Ballet Irebero (Danses rwandaises)","boxoffice_url":null,"website":"https:\/\/le-phare.mediatheque.be\/agenda\/","email":"lephare@uccle.brussels","phone_contact":"+32 2 605 14 80","phone_booking":"+32 2 605 14 80","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50008461"},"sp":{"name":"Plurielles - Femmes de la Diaspora africaine","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/le-phare.mediatheque.be\/agenda\/","email":"lephare@uccle.brussels","phone_contact":"+32 2 605 14 80","phone_booking":"+32 2 605 14 80","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50008461"},"nl":{"name":"Plurielles - Femmes de la Diaspora africaine","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/le-phare.mediatheque.be\/agenda\/","email":"lephare@uccle.brussels","phone_contact":"+32 2 605 14 80","phone_booking":"+32 2 605 14 80","ag