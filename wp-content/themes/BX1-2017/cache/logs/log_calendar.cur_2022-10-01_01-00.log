,263],"translations":{"fr":["Accessible","Chien d'assistance","Accessible aux pi\u00e9tons appareill\u00e9s"],"nl":["Toegankelijk","Assistentiehonden","Toegankelijk voor voetgangers met hulpmiddelen"],"en":["Accessible","Assistance dogs","Accessible to pedestrians with mobility aids"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-09-01T01:06:37+02:00","published_at":"2022-08-23T14:41:13+02:00","backoffice_id":260184,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":0.18344040271637},{"id":537531,"date_start":"2020-09-15","date_end":"2024-06-30","date_next":"2024-06-30","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{}},"languages":{"spoken":["fr","nl","en","it"],"subtitles":[]},"translations":{"fr":{"name":"Escape game urbain - Coddy","shortdescr":"Explore la ville tout en jouant!","longdescr":"Ces aventures urbaines t\u2019invitent, en \u00e9quipe de 2 \u00e0 6 joueurs, \u00e0 parcourir la ville en suivant un sc\u00e9nario qui te plongera dans un univers ou un r\u00f4le particulier (apocalyptique, moyen\u00e2geux, futuriste \/ un enqu\u00eateur, un alchimiste, etc.). Ta mission ? T\u2019\u00e9chapper avant la fin du chrono ou simplement r\u00e9soudre toutes les \u00e9nigmes dans le temps imparti ! Laisse-toi guider par l\u2019app (gr\u00e2ce \u00e0 la carte int\u00e9gr\u00e9e et la boussole), trouve les points d\u2019int\u00e9r\u00eats o\u00f9 t\u2019attendent les missions et les \u00e9nigmes et observe bien autour de toi : les r\u00e9ponses se cachent aussi dans la ville. \r\n\r\nSi tu veux passer un bon moment en famille, entre amis, ou m\u00eame entre coll\u00e8gues, opte pour un Escape Game urbain avec Coddy ! L\u2019activit\u00e9 est s\u00e9curis\u00e9e d\u2019un point de vue sanitaire, car tu ne joues qu\u2019avec les membres de ton \u00e9quipe en plein air. C\u2019est une activit\u00e9 qui m\u00eale le jeu et la visite de la ville car tu passeras par plein d\u2019endroits diff\u00e9rents. Une occasion de (re)d\u00e9couvrir la ville et l'explorer autrement","performers":null,"boxoffice_url":null,"website":"https:\/\/www.coddygames.com","email":"hello@coddygames.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.537531"},"nl":{"name":"Citywide escape games - Coddy","shortdescr":"Een Urban Escape Game om de stad op een leuke manier te verkennen!","longdescr":"Deze stedelijke avonturen nodigen je uit om, in teams van 2 tot 6 spelers, de stad te verkennen volgens een scenario dat je onderdompelt in een bepaald universum of een bepaalde rol (apocalyptisch, middeleeuws, futuristisch \/ een speurder, een alchemist, enzovoort). Je missie? Ontsnappen voor het einde van de timer of gewoon alle raadsels oplossen in een bepaalde tijd! Laat je leiden door de app (dankzij de ge\u00efntegreerde kaart en kompas), zoek de bezienswaardigheden waar de missies en raadsels op je wachten en kijk goed om je heen: de antwoorden zijn ook verborgen in de stad. \r\n\r\nWil je een leuke tijd beleven met je familie, vrienden of zelfs collega's, kies dan voor een urban Escape Game met Coddy! De activiteit is veilig vanuit gezondheidsoogpunt, want je speelt alleen met je teamleden in de buitenlucht. Het is een activiteit die het spel mengt met een bezoek aan de stad, want u komt op veel verschillende plaatsen. Een kans om de stad te (her)ontdekken en haar op een andere manier te verkennen","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.537531"},"en":{"name":"Citywide escape games - Coddy","shortdescr":"An Urban Escape Game to explore the city in a fun way!","longdescr":"These urban adventures invite you, in teams of 2 to 6 players, to explore the city following a scenario that will immerse you in a particular universe or role (apocalyptic, medieval, futuristic \/ an investigator, an alchemist, etc.). Your mission? Escape before the timer runs out or simply solve all the riddles in the time allowed! Let yourself be guided by the app (thanks to the integrated map and compass), find the points of interest where the missions and riddles await you and look around carefully: the answers are also hidden in the city. \r\n\r\nIf you want to have a good time with your family, friends or even colleagues, opt for an urban Escape Game with Coddy! The activity is safe from a health point of view, because you only play with your team members in the open air. It's an activity that mixes the game with a visit of the city because you'll go through many different places. An opportunity to (re)discover the city and explore it in a different way","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.537531"},"de":{"name":"Escape game urbain - Coddy","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.537531"},"it":{"name":"Escape game urbain - Coddy","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.537531"},"sp":{"name":"Escape game urbain - Coddy","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.537531"},"pt":{"name":"Escape game urbain - Coddy","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.537531"},"cn":{"name":"Escape game urbain - Coddy","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.537531"}},"place":{"id":275966,"translations":{"fr":{"name":"Coddy \u2013 Urban Escape Games","address_street_name":"Grand Place","address_street_number":null,"address_street_box":null,"email":"hello@coddygames.com","website":"https:\/\/www.coddygames.com","phone_contact":"+32 2 621 01 11","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand Place","address_line2":"1000 Bruxelles","description_web":"Coddy propose des escape games urbains sur smartphone. \r\n\r\nLeurs points forts : \r\n- Exploration de lieux m\u00e9connus de la ville - \r\nEnigmes et missions bas\u00e9es sur diff\u00e9rents th\u00e8mes et sc\u00e9narios \r\n- A jouer en \u00e9quipe en respectant les r\u00e8gles de distanciation \r\n\r\nLes joueurs r\u00e9solvent des \u00e9nigmes et r\u00e9alisent des missions bas\u00e9es sur des sc\u00e9narios d\u2019environ 2 heures \u00e0 jouer entre amis ou en famille et explorent ainsi des coins moins connus de la ville tout en \u00e9lucidant des enqu\u00eates ancr\u00e9es \u00e0 la ville et \u00e0 ses lieux. \r\n\r\nPrix : 40 euros par \u00e9quipe de max 6 personnes","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Coddy \u2013 Urban Escape Games","address_street_name":"Grand Place","address_street_number":null,"address_street_box":null,"email":"hello@coddygames.com","website":"https:\/\/www.coddygames.com","phone_contact":"+32 2 621 01 11","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Grand Place","address_line2":"1000 Brussel","description_web":"Coddy biedt urban escape games op smartphone. \r\n\r\nSterke punten:\r\n- Verkenning van weinig bekende plaatsen in de stad \r\n- Puzzels en missies op basis van verschillende thema's en scenario's \r\n- Speel met je team met inachtneming van de regels van afstand. \r\n\r\nSpelers lossen puzzels op en voltooien missies op basis van scenario's die ongeveer 2 uur duren om met vrienden of familie te spelen en minder bekende hoeken van de stad te verkennen, terwijl ze de onderzoeken die in de stad en haar plaatsen geworteld zijn, ophelderen. \r\n\r\nPrijs: 40 euro per team van max. 6 personen","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Coddy \u2013 Urban Escape Games","address_street_name":"Grand Place","address_street_number":null,"address_street_box":null,"email":"hello@coddygames.com","website":"https:\/\/www.coddygames.com","phone_contact":"+32 2 621 01 11","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Grand Place","address_line2":"1000 Brussels","description_web":"Coddy offers urban escape games on smartphone. \r\n\r\nTheir advantages\r\n- Exploring lesser-known locations in the city \r\n- Puzzles and missions based on different themes and scenarios \r\n- Played as a team while respecting the rules of distancing\r\n\r\nPlayers solve puzzles and carry out missions based on scenarios of about 2 hours to play with friends or family and explore less known locations in the city while elucidating investigations anchored to the city and its places. \r\n\r\nPrice: 40 euros per team of max. 6 people","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Coddy \u2013 Urban Escape Games","address_stre