n smeren. 1030 Caf\u00e9 is open vanaf 16.00 uur. Zingen, dat is uiteraard gratis.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.1030cultuur.be\/nl\/event\/581\/schaarbeekvoix","email":"rpeeters@1030.be","phone_contact":"+32 472 85 71 58","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.544156"},"en":{"name":"Schaarbeekvoix","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.1030cultuur.be\/nl\/event\/581\/schaarbeekvoix","email":"rpeeters@1030.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.544156"},"de":{"name":"Schaarbeekvoix","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.1030cultuur.be\/nl\/event\/581\/schaarbeekvoix","email":"rpeeters@1030.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.544156"},"it":{"name":"Schaarbeekvoix","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.1030cultuur.be\/nl\/event\/581\/schaarbeekvoix","email":"rpeeters@1030.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.544156"},"sp":{"name":"Schaarbeekvoix","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.1030cultuur.be\/nl\/event\/581\/schaarbeekvoix","email":"rpeeters@1030.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.544156"},"pt":{"name":"Schaarbeekvoix","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.1030cultuur.be\/nl\/event\/581\/schaarbeekvoix","email":"rpeeters@1030.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-det