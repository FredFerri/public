t":false,"last_updated_at":"2024-03-18T01:02:18+01:00","published_at":"2024-01-09T08:47:05+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":292130,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"theatre","ranking":0.4054801330382267,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":49,"translations":{"de":"Theater","pt":null,"en":"Theatre","it":"Teatro","cn":null,"fr":"Th\u00e9\u00e2tre","sp":"Teatro","nl":"Theater"}},"others":{"list":[54],"translations":{"de":["One Man Show & Comedy"],"pt":[null],"en":["One man show and comedy"],"it":["One man Show e comicit\u00e0"],"cn":[null],"fr":["One man Show et humour"],"sp":["Espect\u00e1culo unipersonal y humor"],"nl":["Onemanshow en humor"]}}},"translations":{"de":{"name":"Le m\u00e9lomane mythomane","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lepetitchapeaurondrouge.be\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50005896"},"pt":{"name":"Le m\u00e9lomane mythomane","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lepetitchapeaurondrouge.be\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50005896"},"en":{"name":"Le m\u00e9lomane mythomane","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/www.ticketing.brussels\/en\/tickets\/event-details.Le-Melomane-Mythomane.ed2e38af-0dca-4c80-a4cc-e3212f681a20","website":"https:\/\/lepetitchapeaurondrouge.be\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50005896"},"it":{"name":"Le m\u00e9lomane mythomane","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lepetitchapeaurondrouge.be\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50005896"},"cn":{"name":"Le m\u00e9lomane mythomane","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lepetitchapeaurondrouge.be\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50005896"},"fr":{"name":"Le m\u00e9lomane mythomane","shortdescr":"Il les a tous connus, il connait tous leurs petits travers. De Trenet \u00e0 Dalida, de Maitre Gims \u00e0 Polnareff, leur carri\u00e8re c'est sa vie ! Les petites histoires des grandes chansons n'ont aucun secret pour lui. Mais qui est-il vraiment ? Quel \u00e2ge a-t-il ? D'o\u00f9 vient-il ? Comment discerner le vrai du faux ? Mensonges et musique font-ils bon m\u00e9nage ? ","longdescr":"C\u2019est le premier seul-en-sc\u00e8ne jou\u00e9 et \u00e9crit par Hugues Hamelynck, com\u00e9dien et metteur-en-sc\u00e8ne, surtout connu pour sa longue carri\u00e8re d\u2019improvisateur, il est aussi animateur \u00e0 la RTBF, en radio sur VivaCit\u00e9 et en t\u00e9l\u00e9 sur La Une. Dans ce spectacle, il vous propose une galerie de personnages qui vous feront passer du rire aux larmes et une jolie r\u00e9flexion sur la place de la musique dans l\u2019histoire de notre vie.\nPeut-on faire confiance au M\u00e9lomane Mythomane ? D\u00e9couvrez ce spectacle \u00e0 la fois dr\u00f4le et touchant qui \u00e9voque avec tendresse et fantaisie les grandes figures de la Chanson.","performers":null,"boxoffice_url":"https:\/\/www.ticketing.brussels\/fr\/tickets\/event-details.Le-Melomane-Mythomane.ed2e38af-0dca-4c80-a4cc-e3212f681a20","website":"https:\/\/lepetitchapeaurondrouge.be\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-deta