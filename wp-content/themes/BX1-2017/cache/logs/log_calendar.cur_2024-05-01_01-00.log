ull,"sub_type":"festival","ranking":0.5665163349427048,"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"categories":{"main":{"id":118,"translations":{"de":"Festival","pt":null,"en":"Festival","it":"Festival","cn":null,"fr":"Festival","sp":"Festival","nl":"Festival"}},"others":{"list":[119],"translations":{"de":["Kino"],"pt":[null],"en":["Cinema  "],"it":["Cinema"],"cn":[null],"fr":["Cin\u00e9ma"],"sp":["Cine"],"nl":["Cinema"]}}},"translations":{"de":{"name":"Brussels Short Film Festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/bsff.be\/en\/","email":"info@bsff.be","phone_contact":"+32 2 248 08 72","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50008105"},"pt":{"name":"Brussels Short Film Festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/bsff.be\/en\/","email":"info@bsff.be","phone_contact":"+32 2 248 08 72","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50008105"},"en":{"name":"Brussels Short Film Festival","shortdescr":null,"longdescr":"The Brussels Short Film Festival is back for its 27th edition! Once again this year, the Brussels Short Film Festival takes over the iconic venues of Flagey, Vend\u00f4mes and Cin\u00e9ma Galeries, next spring from April 24th to May 4th 2024. On the programme: 11 days of festival, more than 250 short films, films in competitions (national, international and Next Generation) and out of competition programs (Night of the Shorts, Oscars, free Open Air screenings\u2026), youth-focused workshops, a range of professional activities and a Marquee to take a break. Get ready for another captivating cinematic experience! Save the dates and stay tuned for details of the programme and special guests.","performers":null,"boxoffice_url":null,"website":"https:\/\/bsff.be\/en\/","email":"info@bsff.be","phone_contact":"+32 2 248 08 72","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50008105"},"it":{"name":"Brussels Short Film Festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/bsff.be\/en\/","email":"info@bsff.be","phone_contact":"+32 2 248 08 72","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50008105"},"cn":{"name":"Brussels Short Film Festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/bsff.be\/en\/","email":"info@bsff.be","phone_contact":"+32 2 248 08 72","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50008105"},"fr":{"name":"Brussels Short Film Festival - BSFF","shortdescr":null,"longdescr":"Le Brussels Short Film Festival est de retour pour sa 27e \u00e9dition ! Cette ann\u00e9e encore, le Brussels Short Film Festival reprend ses quartiers \u00e0 Flagey, au Vend\u00f4me et au Cin\u00e9ma Galeries \u00e0 sa p\u00e9riode habituelle : du 24 avril au 4 mai 2024. Au programme : 11 jours de festival, plus de 250 courts m\u00e9trages, des films en comp\u00e9titions (internationale, nationale et Next Generation) et hors comp\u00e9tition (une Nuit du Court, les Oscars, des s\u00e9ances Open Air gratuites au Mont des Arts\u2026), des ateliers pour les Youth, un panel d\u2019activit\u00e9s professionnelles et un Chapiteau pour se retrouver. Pr\u00e9parez-vous pour une nouvelle exp\u00e9rience cin\u00e9matographique captivante ! Bloquez vos dates et restez \u00e0 l'aff\u00fbt pour plus de d\u00e9tails sur la programmation et les invit\u00e9s sp\u00e9ciaux.","performers":null,"boxoffice_url":null,"website":"https:\/\/bsff.be\/en\/","email":"info@bsff.be","phone_contact":"+32 2 248 08 72","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50008105"},"sp":{"name":"Brussels Short Film Festival","shortdescr":null,"lon