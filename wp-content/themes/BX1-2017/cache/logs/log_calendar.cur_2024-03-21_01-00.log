}},"educational_targets":{"list":[],"translations":{}},"tags":["kids"]},{"id":50007252,"date_start":"2024-03-15","date_end":"2024-04-14","date_next":"2024-03-20","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-03-20T01:01:48+01:00","published_at":"2024-02-14T08:53:01+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":294491,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.40107239119071786,"languages":{"spoken":["nl","en","fr"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{}},"translations":{"de":{"name":"Titanic The Artifact Exhibition","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/titanicexpo.be\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50007252"},"pt":{"name":"Titanic The Artifact Exhibition","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/titanicexpo.be\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50007252"},"en":{"name":"Titanic The Artifact Exhibition","shortdescr":null,"longdescr":"On the night of 14 to 15 April 1912, the Titanic, the largest ship the world had ever seen and a veritable floating palace and technological feat, sank following a collision with an iceberg, killing more than 1,500 people and forever altering people's confidence in modern technology. More than a century later, Brussels is paying tribute to this tragedy, which still resonates today in the collective memory, by hosting \"Titanic - The Artifact Exhibition\".  \n\nThis educational exhibition for families focuses on the memorable stories of the men and women aboard the legendary RMS Titanic. The presentation of more than 260 objects and the reconstruction of the ship's cabins and emblematic places tells the true story of this terrible shipwreck. Visitors will be able to see authentic objects brought to the surface by Paul-Henri Nargeolet, Director of Underwater Research, and his teams. \n\nTitanic The Artifact Exhibition \n\nFrom 15 March 2024 at Tour & Taxis in Brussels. ","performers":null,"boxoffice_url":null,"website":"https:\/\/titanicexpo.be\/en\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50007252"},"it":{"name":"Titanic The Artifact Exhibition","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/titanicexpo.be\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50007252"},"cn":{"name":"Titanic The Artifact Exhibition","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/titanicexpo.be\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50007252"},"fr":{"name":"Titanic L\u2019Exposition","shortdescr":null,"longdescr":"Dans la nuit du 14 au 15 avril 1912, le Titanic, le plus grand navire jamais construit au monde, v\u00e9ritable palace flottant et prouesse technologique sombra suite \u00e0 une collision avec un iceberg causant la mort de plus de 1500 personnes et alt\u00e9rant \u00e0 tout jamais la confiance des peuples \u00e0 l\u2019\u00e9gard de la technologie moderne. Plus d\u2019un si\u00e8cle apr\u00e8s, Bruxelles rend hommage \u00e0 cette trag\u00e9die qui r\u00e9sonne encore aujourd\u2019hui dans la m\u00e9moire collective en accueillant \u00ab Titanic \u2013 l\u2019Exposition \u00bb.  \n\nCette exposition familiale et p\u00e9dagogique est ax\u00e9e sur les r\u00e9cits marquants d\u2019hommes et de femmes \u00e0 bord du l\u00e9gendaire RMS Titanic. La pr\u00e9sentation de plus de 260 reliques \u00e9mouvantes et la reconstitution des cabines et des lieux embl\u00e9matiques du navire retracent la vraie histoire de ce terrible naufrage. Les visiteurs pourront d\u00e9couvrir des objets authentiques remont\u00e9s \u00e0 la surface par le directeur des recherches sous-marines Paul-Henri Nargeolet et ses \u00e9quipes. \n\nTitanic L\u2019Exposition, \u00e0 voir \u00e0 Tour & Taxis \u00e0 Bruxelles \u00e0 partir du 15 mars\u202f! ","performers":null,"boxoffice_url":null,"website":"https:\/\/titanicexpo.be\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50007252"},"sp":{"name":"Titanic The Artifact Exhibition","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/titanicexpo.be\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50007252"},"nl":{"name":"Titanic The Artifact Exhibition","shortdescr":null,"longdescr":"In de nacht van 14 op 15 april 1912 zonk de Titanic \u2013 destijds het grootste passagiersschip ooit ter wereld gebouwd, een waar drijvend paleis en technologisch hoogstandje \u2013 na een aanvaring met een ijsberg. Hierbij kwamen meer dan 1500 personen om het leven en veranderde voor altijd het vertrouwen van mensen in moderne technologie. Meer dan een eeuw later brengt Brussel met \u2018Titanic - De Tentoonstelling\u2019 alles aan het licht van deze tragedie die nog steeds in ons collectieve geheugen gegrift staat. \/\/ Meer dan een eeuw later brengt Brussel met \u2018Titanic - De Tentoonstelling\u2019 je terug naar de tijd van deze tragedie die nog steeds in ons collectieve geheugen gegrift staat. \n\nDeze educatieve familietentoonstelling richt zich op de memorabele verhalen van de mannen en vrouwen aan boord van de legendarische RMS Titanic. De presentatie van meer dan 260 bijzondere voorwerpen, samen met gereconstrueerde hutten en karakteristieke plaatsen op het schip, vertellen het ware verhaal van deze vreselijke schipbreuk. Op de expo zien de bezoekers ook authentieke voorwerpen, boven water gehaald door Paul-Henri Nargeolet, de toenmalige directeur voor onderwateronderzoek, en zijn teams. \n\nTitanic The Artifact Exhibition \n\nTe bezoeken vanaf 15 maart 2024 in Tour & Taxis Brussel.  ","performers":null,"boxoffice_url":null,"website":"https:\/\/titanicexpo.be\/nl\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50007252"}},"place":{"id":50001244,"translations":{"de":{"name":"Tour et Taxis","address_street_name":"Tour & Taxis, 86C Avenue du Port","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Tour & Taxis, 86C Avenue du Port","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Tour et Taxis","address_street_name":"Tour & Taxis, 86C Avenue du Port","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Tour & Taxis, 86C Avenue du Port","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_ur