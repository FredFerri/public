ed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-11-22T01:01:09+01:00","published_at":"2024-10-16T12:12:29+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":true,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":309894,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"misc","ranking":0.28543716208189446,"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"categories":{"main":{"id":84,"translations":{"de":"Verschiedenes","pt":null,"en":"Various","it":"Varie","cn":null,"fr":"Divers","sp":"Varios","nl":"Varia"}},"others":{}},"translations":{"de":{"name":"Koti Sauna","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/kotisauna.be\/","email":"hello@kotisauna.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700002657"},"pt":{"name":"Koti Sauna","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/kotisauna.be\/","email":"hello@kotisauna.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700002657"},"en":{"name":"Koti Sauna","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/kotisauna.be\/","email":"hello@kotisauna.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700002657"},"it":{"name":"Koti Sauna","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/kotisauna.be\/","email":"hello@kotisauna.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700002657"},"cn":{"name":"Koti Sauna","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/kotisauna.be\/","email":"hello@kotisauna.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700002657"},"fr":{"name":"Koti Sauna","shortdescr":"Cet automne, Koti Sauna s'installe dans le paisible jardin de Op-Weule \u00e0 Woluwe-Saint-Lambert. Profitez d'une exp\u00e9rience de sauna relaxante dans un espace vert en pleine ville.","longdescr":"Le jeudi, vous pourrez prendre un verre et manger un bout avant ou apr\u00e8s votre passage au sauna au Bistro Op-Weule, ouvert jusqu'\u00e0 23 heures.\n\nSi vous pr\u00e9f\u00e9rez un moment plus calme, vous pouvez venir au sauna le lundi ou le samedi, lorsque le bar est ferm\u00e9. Vous aurez ainsi l'occasion de profiter d'une soir\u00e9e paisible et de vous laisser aller \u00e0 la z\u00e9nitude. Nous vous servirons une tisane maison pour vous hydrater.\n\nEn d\u00e9cembre, avec quelques partenaires locaux, nous participerons \u00e0 la \u00ab Warmste Week \u00bb, une action de solidarit\u00e9 organis\u00e9e chaque ann\u00e9e la semaine pr\u00e9c\u00e9dant No\u00ebl. Cette ann\u00e9e, le th\u00e8me central est \u00ab flamber ensemble contre la solitude \u00bb. Il y aura une bo\u00eete \u00e0 dons pour contribuer librement \u00e0 cette grande initiative.\n\nVeuillez noter que port du maillot de bain est demand\u00e9 car il s'agit d'un espace public.","performers":null,"boxoffice_url":null,"website":"https:\/\/kotisauna.be\/","email":"hello@kotisauna.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700002657"},"sp":{"name":"Koti Sauna","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/kotisauna.be\/","email":"hello@kotisauna.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700002657"},"nl":{"name":"Koti Sauna","shortdescr":"Deze herfst strijkt Koti Sauna neer in de tuin van Op-Weule. Kom even tot rust en warm lekker op in de sauna, rustig in het groen verscholen langs de grote berkenboom.","longdescr":"Op donderdagen kan je ook genieten van een drankje en hapje voor of na je saunabezoek in de Bistro van Op-Weule, die open is tot 23u. Als je liever een rustiger moment kiest, kan je op maandag of zaterdag in de sauna terecht, de bar is dan gesloten.\nIn december, gaan we samen met enkele lokale partners meedoen aan de Warmste Week. Dit jaar is het thema samen vlammen tegen eenzaamheid. Er zal een donatiebox zijn om vrij bij te dragen aan dit mooie initiatief.","performers":null,"boxoffice_url":null,"website":"https:\/\/kotisauna.be\/","email":"hello@kotisauna.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700002657"}},"place":{"id":50001094,"translations":{"de":{"name":"op-weule","address_street_name":"91, rue saint-lambert","address_street_number":"91","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1200","address_city":"Woluwe-Saint-Lambert","address_line1":"91, rue saint-lambert, 91","address_line2":"1200 Woluwe-Saint-Lambert","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"op-weule","address_street_name":"91, rue saint-lambert","address_street_number":"91","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1200","address_city":"Woluwe-Saint-Lambert","address_line1":"91, rue saint-lambert, 91","address_line2":"1200 Woluwe-Saint-Lambert","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"op-weule","address_street_name":"91, rue saint-lambert"