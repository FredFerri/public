\/event-detail.559596"},"cn":{"name":"Elsa Br\u00e8s","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.la-loge.be","email":"info@la-loge.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.559596"},"fr":{"name":"Conniv\u00e9ncia de Elsa Br\u00e8s","shortdescr":null,"longdescr":"L\u2019exposition d\u2019Elsa Br\u00e8s \u00e0 La loge pr\u00e9sentera un ensemble d\u2019\u0153uvres et de recherches autour de son dernier projet de film Les Sangli\u00e8res et de son territoire de r\u00e9sistance, les C\u00e9vennes. L\u2019artiste y investigue la figure du sanglier comme un potentiel alli\u00e9 de lutte anti-patriarcale et anti-capitaliste.","performers":"Elsa Br\u00e8s","boxoffice_url":null,"website":"http:\/\/www.la-loge.be","email":"info@la-loge.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.559596"},"sp":{"name":"Elsa Br\u00e8s","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.la-loge.be","email":"info@la-loge.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.559596"},"nl":{"name":"Conniv\u00e9ncia door Elsa Br\u00e8s","shortdescr":null,"longdescr":null,"performers":"Elsa Br\u00e8s","boxoffice_url":null,"website":"http:\/\/www.la-loge.be","email":"info@la-loge.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.559596"}},"place":{"id":238201,"translations":{"de":{"name":"La Loge","address_street_name":"Rue de l'Ermitage","address_street_number":"86","address_street_box":null,"email":"info@la-loge.be","website":"http:\/\/www.la-loge.be","phone_contact":"+32 2 644 42 48","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage, 86","address_line2":"1050 Ixelles","description_web":"La Loge ist ein Ort, der sich der zeitgen\u00f6ssischen Kunst, der Architektur und der Theori widmet und von dem Architekten Philippe Rotthier gegr\u00fcndet wurde. Ziel ist die Ausarbeitung einer hochwertigen Programmgestaltung mit konkreten und kritischen Projekten, die angesichts des gegenw\u00e4rtigen kulturellen Kontexts von Belang sind. Architekten, K\u00fcnstler, Ausstellungskommissare und kulturelle Akteure sind eingeladen, ihre Vorschl\u00e4ge und die spezifischen Aspekte aus ihrer Arbeit einzubringen.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"La Loge","address_street_name":"Rue de l'Ermitage","address_street_number":"86","address_street_box":null,"email":"info@la-loge.be","website":"http:\/\/www.la-loge.be","phone_contact":"+32 2 644 42 48","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage, 86","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"La Loge","address_street_name":"Rue de l'Ermitage","address_street_number":"86","address_street_box":null,"email":"info@la-loge.be","website":"http:\/\/www.la-loge.be","phone_contact":"+32 2 644 42 48","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage, 86","address_line2":"1050 Ixelles","description_web":"La Loge is a Brussels-based space dedicated to contemporary art, architecture and theory founded by architect Philippe Rotthier. Its aim is to develop a high-quality program that plays a critical role in today\u2019s cultural conversations through specific and precise projects. Architects, artists, curators and cultural agents are invited to develop propositions in which they seek out the characteristic and the peculiar within their practices.\r\nLa Loge is a space where ideas, discussion and presentation coexist. Public formats vary depending on the project; from exhibitions, symposiums, screenings, lectures, and performances to events\u2019 series. Its identity is drawn from the architectural gem that houses it, as well as from the commitment and concerns of its founders. La Loge values engagement of thought and feels particularly interested in exploring questions of space, habitat and use. The small-scale format of La Loge contributes to a context where intimate and direct conversations with its audience and the diversity of protagonists it invites can be initiated and sustained.\r\n\r\n","description_print":null,"booking_url":null,"sort_order":"LOGE","virtual_visit":null},"it":{"name":"La Loge","address_street_name":"Rue de l'Ermitage","address_street_number":"86","address_street_box":null,"email":"info@la-loge.be","website":"http:\/\/www.la-loge.be","phone_contact":"+32 2 644 42 48","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage, 86","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"La Loge","address_street_name":"Rue de l'Ermitage","address_street_number":"86","address_street_box":null,"email":"info@la-loge.be","website":"http:\/\/www.la-loge.be","phone_contact":"+32 2 644 42 48","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage, 86","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"fr":{"name":"La Loge","address_street_name":"Rue de l'Ermitage","address_street_number":"86","address_street_box":null,"email":"info@la-loge.be","website":"http:\/\/www.la-loge.be","phone_contact":"+32 2 644 42 48","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage, 86","address_line2":"1050 Ixelles","description_web":"La Loge est un espace d\u00e9di\u00e9 \u00e0 l\u2019art contemporain, l\u2019architecture et la th\u00e9orie, initi\u00e9e par l\u2019architecte Philippe Rotthier. Son objectif est de d\u00e9velopper une programmation de qualit\u00e9 \u00e0 travers des projets pr\u00e9cis et critiques, qui font sens au sein des enjeux culturels actuels. Architectes, artistes, commissaires d\u2019expositions et acteurs culturels sont invit\u00e9s \u00e0 y articuler des propositions qui explorent les aspects sp\u00e9cifiques de leur pratique.\r\nLa Loge est un lieu o\u00f9 coexistent les id\u00e9es, la discussion et la pr\u00e9sentation.\r\nChaque projet est d\u00e9velopp\u00e9 selon une formule de pr\u00e9sentation qui lui est propre, allant de l\u2019exposition au s\u00e9minaire, de la projection \u00e0 la conf\u00e9rence, de la performance \u00e0 la s\u00e9rie d\u2019\u00e9v\u00e9nements.\r\nLa Loge puise son identit\u00e9 dans le joyau architectural qui l\u2019abrite ainsi que dans l\u2019engagement et les pr\u00e9occupations de ses fondateurs. La Loge valorise une pens\u00e9e engag\u00e9e et s\u2019int\u00e9resse en particulier \u00e0 des -questions d\u2019espace, d\u2019habitat et d\u2019usage. La structure d\u2019envergure relativement r\u00e9duite de La Loge g\u00e9n\u00e8re un contexte qui permet d\u2019engager et de poursuivre un dialogue direct et intime, tant avec son public qu\u2019avec la diversit\u00e9 d\u2019intervenants qui y sont invit\u00e9s.\r\n ","description_print":null,"booking_url":null,"sort_order":"LOGE","virtual_visit":null},"sp":{"name":"La Loge","address_street_name":"Rue de l'Ermitage","address_street_number":"86","address_street_box":null,"email":"info@la-loge.be","website":"http:\/\/www.la-loge.be","phone_contact":"+32 2 644 42 48","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage, 86","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"La Loge","address_street_name":"Kluisstraat","address_street_number":"86","address_street_box":null,"email":"info@la-loge.be","website":"http:\/\/www.la-loge.be","phone_contact":"+32 2 644 42 48","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Kluisstraat, 86","address_line2":"1050 Ixelles","description_web":"La Loge is een Brusselse ruimte opgericht door architect Philippe Rotthier en gewijd aan hedendaagse kunst, architectuur en theorie. Het doel is een hoogwaardig programma te ontwikkelen dat een cruciale rol speelt in het hedendaagse culturele debat door middel van concrete en punctuele projecten. Architecten, kunstenaars, curatoren en andere culturele spelers  worden uitgenodigd om voorstellen in te dienen waarin ze op zoek gaan naar het karakteristieke en bijzondere in hun praktijk.\r\nLa Loge is een ruimte waar idee\u00ebn, dialoog en presentatie samengaan. Publieksformaten vari\u00ebren afhankelijk van het project. Dat kan gaan van tentoonstellingen, symposia, filmprojecties, lezingen tot performances of een evenementenreeks. De identiteit van La Loge is geankerd in het architectonisch juweeltje waarin het is  gevestigd maar ook in de toewijding en interesses van de oprichters. La Loge waardeert intellectueel engagement en is in het bijzonder ge\u00efnteresseerd in de verkenning van vragen rond ruimte, habitat en gebruik.\r\nDe kleinschalige vorm van La Loge draagt bij tot een context waarin er plaats is voor intieme, directe gesprekken tussen het publiek en erg diverse gesprekspartners.\r\n \r\n","description_print":null,"booking_url":null,"sort_order":"LOGE","virtual_visit":null}},"districts":{"list":[5],"translations":{"de":["Flagey"],"pt":[null],"en":["Flagey"],"it":["Flagey"],"cn":[null],"fr":["Flagey"],"sp":["Flagey"],"nl":["Flagey"]}},"zones":{"list":[21],"translations":{"de":["S\u00fcden"],"pt":[null],"en":["South"],"it":["Sud"],"cn":[null],"fr":["Sud"],"sp":["Sur"],"nl":["Zuid"]}},"neca":"art_center","facebook_id":null,"back