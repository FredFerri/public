www.wolubilis.be\/a-faire\/creation-de-mosaiques-les-dimanches-en-eclats-2023-2024-126\/","email":"secretariat.atl@woluwe1200.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.559302"},"it":{"name":"Cr\u00e9ation de Mosa\u00efques - Les Dimanches en eclats","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.wolubilis.be\/a-faire\/creation-de-mosaiques-les-dimanches-en-eclats-2023-2024-126\/","email":"secretariat.atl@woluwe1200.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.559302"},"cn":{"name":"Cr\u00e9ation de Mosa\u00efques - Les Dimanches en eclats","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.wolubilis.be\/a-faire\/creation-de-mosaiques-les-dimanches-en-eclats-2023-2024-126\/","email":"secretariat.atl@woluwe1200.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.559302"},"fr":{"name":"Cr\u00e9ation de Mosa\u00efques - Les Dimanches en eclats","shortdescr":"Cr\u00e9ation de Mosa\u00efques - Les Dimanches en eclats - 2023\/2024 - 126\r\nAtelier Couture | Rue Lola Bobesco 11, 2e \u00e9tage - 1200 Woluwe Saint Lambert | Voir la carte\r\n\r\n-\r\nAtelier cr\u00e9atif de mosa\u00efques","longdescr":"Cet atelier vous fera d\u00e9couvrir les diff\u00e9rentes techniques de la mosa\u00efque d\u00e9corative. Au d\u00e9part d\u2019un projet personnel, d\u2019une image ou d\u2019une peinture nous utiliserons divers mat\u00e9riaux tel que la fa\u00efence, le carrelage et des mat\u00e9riaux de r\u00e9cup\u00e9ration sur le support de votre choix. Tout au long des s\u00e9ances vous serez amener \u00e0 comprendre et assimiler le processus de cr\u00e9ation, la fragmentation de l\u2019image et la r\u00e9sonance des mat\u00e9riaux et des couleurs. Nous jouerons avec les \u00e9paisseurs, les espaces et les mati\u00e8res. Cette technique simple \u00e0 r\u00e9aliser permettra de mettre en pratique votre cr\u00e9ativit\u00e9 et votre sensibilit\u00e9 au cours de projets personnels et collectifs. Cet atelier est ouvert \u00e0 tous, aux d\u00e9butants comme aux initi\u00e9s.\r\nAvec Isabelle Carpentier\r\n\r\nUn dimanche par mois de 10h30 \u00e0 16H30\r\n\r\nD\u00e8s le 15\/10, 12\/11, 3\/12, 14\/1, 11\/2, 17\/3, 7\/4, 12\/5\r\n\r\nLocal Couture","performers":"Avec Isabelle Carpentier","boxoffice_url":null,"website":"https:\/\/www.wolubilis.be\/a-faire\/creation-de-mosaiques-les-dimanches-en-eclats-2023-2024-126\/","email":"secretariat.atl@woluwe1200.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.559302"},"sp":{"name":"Cr\u00e9ation de Mosa\u00efques - Les Dimanches en eclats","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.wolubilis.be\/a-faire\/creation-de-mosaiques-les-dimanches-en-eclats-2023-2024-126\/","email":"secretariat.atl@woluwe1200.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.559302"},"nl":{"name":"Cr\u00e9ation de Mosa\u00efques - Les Dimanches en eclats","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.wolubilis.be\/a-faire\/creation-de-mosaiques-les-dimanches-en-eclats-2023-2024-126\/","email":"secretariat.atl@woluwe1200.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.559302"}},"place":{"id":220532,"translations":{"de":{"name":"Centre Culturel Wolubilis","address_street_name":"Cours Paul-Henri Spaak","address_street_number":"1","address_street_box":null,"email":"secretariat.atl@woluwe1200.be","website":"http:\/\/www.wolubilis.b