is_open":true,"hours":[{"start":"09:00:00","end":"22:00:00"}]},"friday":{"is_open":true,"hours":[{"start":"09:00:00","end":"22:00:00"}]},"saturday":{"is_open":true,"hours":[{"start":"09:00:00","end":"22:00:00"}]},"sunday":{"is_open":true,"hours":[{"start":"09:00:00","end":"22:00:00"}]}},"translations":{"fr":["lundi, mardi et mercredi: ferm\u00e9","jeudi, vendredi, samedi et dimanche: de 09:00 \u00e0 22:00"],"nl":["maandag, dinsdag en woensdag: gesloten","donderdag, vrijdag, zaterdag en zondag: van 09:00 tot 22:00"],"en":["monday, tuesday and wednesday: closed","thursday, friday, saturday and sunday: from 09:00 to 22:00"]},"date_start":"2022-06-30","date_end":"2022-07-03","is_also_by_appointment":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[5,11,7,8,16],"translations":{"fr":["Enfants 9-12 ans","Famille","Jeunes 12-15 ans","Jeunes 15-18 ans","Ecoles"],"nl":["Kinderen 9-12 j.","Familie","Jongeren 12-15 j.","Jongeren 15-18 j.","Scholen"],"en":["Children 9-12 yr.","Family","Youth 12-15  yr.","Youth 15-18  yr.","Schools"]}},"visit_profile":{"list":[337],"translations":{"fr":["Highlight"],"nl":["Highlight"],"en":["Highlight"]}},"tags":["major_event","exterior","kids"],"accessibilities":{"list":[255,261,263],"translations":{"fr":["Accessible","Parking accessible","Accessible aux pi\u00e9tons appareill\u00e9s"],"nl":["Toegankelijk","Toegankelijke parking","Toegankelijk voor voetgangers met hulpmiddelen"],"en":["Accessible","Accessible parking","Accessible to pedestrians with mobility aids"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-05-30T16:35:04+02:00","published_at":"2022-05-09T11:44:54+02:00","backoffice_id":253082,"import_origin":null,"sub_type":"sport","show_in_agenda":true,"ranking":1},{"id":528925,"date_start":"2021-09-06","date_end":"2022-06-30","date_next":"2022-06-30","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":true,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":74,"translations":{"fr":"Sport","nl":"Sport","en":"Sport"}},"others":{"list":[159,167],"translations":{"fr":["Activit\u00e9 sportive","Sport traditionnel"],"nl":["Sportieve activiteit","Volkssporten"],"en":["Sporting activity","Traditional sport"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Ta\u00efji Quan\/Qi gong Jette","shortdescr":"Le Taiji Quan consiste \u00e0 r\u00e9aliser un ensemble de mouvements continus ex\u00e9cut\u00e9s avec lenteur et pr\u00e9cision dans un ordre pr\u00e9\u00e9tabli. Le Qi Gong quant \u00e0 lui, est une gymnastique traditionnelle chinoise qui associe mouvements lents, exercices respiratoires et concentration. \r\nLa pratique de ces disciplines s\u2019effectue debout et am\u00e9liore l\u2019\u00e9quilibre, renforce les muscles et le tonus g\u00e9n\u00e9ral.","longdescr":"INSCRIPTION OBLIGATOIRE\u00a0:\r\n> Par e-mail (sacasport@fmsb.be)\r\n> Par courrier (rue des Moineaux 17-19 \u2013 1000 Bruxelles)\r\n> A notre accueil (Rue du Midi 118 \u2013 1000 Bruxelles, ouvert du lundi au vendredi de 8h30 \u00e0 12h, et de 13h30 \u00e0 15h) \r\nY mentionner : nom, pr\u00e9nom, adresse, date de naissance, n\u00b0 de gsm, le(s) cours choisi(s) (commune et horaire), n\u00b0 de membre S\u2019Acad\u00e9mie (ou n\u00b0 de mutuelle)\r\nLe cours se paie :\r\n> Soit 4\u20ac \u00e0 la s\u00e9ance directement au moniteur (hors entr\u00e9e de piscine)\r\n> Soit avec un abonnement valable de janvier \u00e0 juin co\u00fbtant 64\u20ac (soit 22 s\u00e9ances pour le prix de 18 s\u00e9ances), qui s\u2019ach\u00e8te uniquement \u00e0 notre accueil en cash jusqu\u2019au 28 janvier 2022 (un abonnement par cours bien d\u00e9fini).\r\nLes cours ont lieu tous les mercredis sauf durant les cong\u00e9s scolaires.\r\nLa saison 2021-2022 se termine le 30 juin et reprendra le 05 septembre 2022.\r\n\r\n> L'affiliation\r\nLa cotisation pour l'affiliation \u00e0 Seniors Acad\u00e9mie asbl est de 50 \u20ac par an (septembre\/juin). Les membres de la F\u00e9d\u00e9ration des Mutualit\u00e9s Socialistes du Brabant qui s'affilient \u00e0 l'asbl Seniors Acad\u00e9mie obtiennent une intervention de 50 \u20ac dans le prix pay\u00e9 pour l'affiliation. De ce fait, l'affiliation \u00e0 l'asbl Seniors Acad\u00e9mie est gratuite pour les membres.\r\n\r\nLes conditions g\u00e9n\u00e9rales sous lesquelles sont organis\u00e9es les activit\u00e9s sont disponibles sur le site https:\/\/www.fmsb.be\/fr\/sacademie Vous inscrire implique que vous en ayez pris connaissance.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.fmsb.be\/fr\/sacademie","email":"sacademie@fmsb.be","phone_contact":null,"phone_booking":"+32 2 546 14 94","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/528925.html"},"nl":{"name":"Ta\u00efji Quan\/Qi gong Jette","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/528925.html"},"en":{"name":"Ta\u00efji Quan\/Qi gong Jette","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/528925.html"},"de":{"name":"Ta\u00efji Quan\/Qi gong Jette","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/528925.html"},"it":{"name":"Ta\u00efji Quan\/Qi gong Jette","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/528925.html"},"sp":{"name":"Ta\u00efji Qua