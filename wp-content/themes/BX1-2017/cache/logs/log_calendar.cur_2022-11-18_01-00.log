ays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":90,"translations":{"fr":"Animations","nl":"Animaties","en":"Animations","de":"Animationen"}},"others":{"list":[91],"translations":{"fr":["Parcs th\u00eamatiques"],"nl":["Themaparken"],"en":["Theme parks"],"de":["Themenparks"]}}},"languages":{"spoken":["nl","fr","en"],"subtitles":[]},"translations":{"fr":{"name":"LEGO Discovery Centre \u00e0 Docks Bruxsel","shortdescr":null,"longdescr":"Au LEGO Discovery Centre, l'imagination et la cr\u00e9ativit\u00e9 ne connaissent aucune limite. Il s'agit d'une incroyable aventure int\u00e9rieure de plus de 3 000 m\u00b2 o\u00f9 adultes et enfants cr\u00e9ent et jouent ensemble en parcourant 12 zones, allant de l'aventure de la construction \u00e0 un man\u00e8ge interactif. Le LEGO Discovery Centre est la maison de tous les aventuriers LEGO. Dans ce monde LEGO, vous vivrez, entre autres, un voyage inoubliable en train sur l'imagination express ou regarderez ensemble un film LEGO dans le cin\u00e9ma 4D.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.544403"},"nl":{"name":"LEGO Discovery Centre in Docks Bruxsel","shortdescr":null,"longdescr":"In het LEGO Discovery Centre kent fantasie en creativiteit geen grenzen. Het is een geweldig indoor avontuur van meer dan 3.000 m\u00b2waar volwassenen en kinderen samen cre\u00ebren en spelen terwijl ze zich een weg banen door 12 zones; van bouwavonturen tot een interactieve ride. Het LEGO Discovery Centre is de thuis voor elke LEGO avonturier. In deze LEGO wereld beleef je onder meer een onvergetelijke treinrit op de imagination express of kijk je samen naar een LEGO film in de 4D bioscoop.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.legodiscoverycentre.com\/brussels\/","email":"info.brussels@legodiscoverycentre.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.544403"},"en":{"name":"LEGO Discovery Centre in Docks Bruxsel","shortdescr":null,"longdescr":"At the LEGO Discovery Centre, imagination and creativity know no bounds. It is an amazing indoor adventure of more than 3,000 square meters where adults and children create and play together as they make their way through 12 zones; from building adventures to an interactive ride. The LEGO Discovery Centre is the home for every LEGO adventurer. In this LEGO world you can experience, among other things, an unforgettable train ride on the imagination express or watch a LEGO movie together in the 4D cinema.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.544403"},"de":{"name":"Bezoek het LEGO Discovery Centre in Docks Bruxsel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.544403"},"it":{"name":"Bezoek het LEGO Discovery Centre in Docks Bruxsel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.544403"},"sp":{"name":"Bezoek het LEGO Discovery Centre in Docks Bruxsel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.544403"},"pt":{"name":"Bezoek het LEGO Discovery Centre in Docks Bruxsel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice