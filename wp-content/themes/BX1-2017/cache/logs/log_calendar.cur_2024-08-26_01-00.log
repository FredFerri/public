descr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.91parallele.be","email":"info@91parallele.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50011664"},"cn":{"name":"A c\u00f4t\u00e9 de la plaque","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.91parallele.be","email":"info@91parallele.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50011664"},"fr":{"name":"A c\u00f4t\u00e9 de la plaque","shortdescr":null,"longdescr":"Comm\u00e9morative, de rue, fun\u00e9raire\u2026 En \u00e9mail, en bronze, en pierre\u2026\nLes plaques parlent, racontent, \u00e9voquent des \u00e9difices du pass\u00e9, des \u00e9pisodes historiques, des personnalit\u00e9s ou des anonymes, des actes h\u00e9ro\u00efques, des vies bris\u00e9es, des naissances ou des brefs s\u00e9jours en ville.\nDiscr\u00e8tes, souvent en hauteur, nous passons devant sans plus les voir ou les lire. Elles sont pourtant le t\u00e9moin de notre histoire collective.\nNotre guide vous emm\u00e8ne \u00e0 la d\u00e9couverte des histoires qui se cachent\u2026 \u00e0 c\u00f4t\u00e9 de la plaque.\n\nSamedi 31 ao\u00fbt \u00e0 10h\nRendez-vous devant le BIP (rue Royale 2-4)\n15\u20ac - 10\u20ac pour les 6-12 ans\nInfos et r\u00e9servations : info@91parallele.be","performers":null,"boxoffice_url":null,"website":"http:\/\/www.91parallele.be","email":"info@91parallele.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50011664"},"sp":{"name":"A c\u00f4t\u00e9 de la plaque","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.91parallele.be","email":"info@91parallele.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50011664"},"nl":{"name":"A c\u00f4t\u00e9 de la plaque","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.91parallele.be","email":"info@91parallele.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50011664"}},"place":{"id":50000434,"translations":{"de":{"name":"91\u00e8me parall\u00e8le","address_street_name":"Rue Gaucheret","address_street_number":"4","address_street_box":"B73","email":"info@91parallele.be","website":"https:\/\/91parallele.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Rue Gaucheret, 4 \/ B73","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"91\u00e8me parall\u00e8le","address_street_name":"Rue Gaucheret","address_street_number":"4","address_street_box":"B73","email":"info@91parallele.be","website":"https:\/\/91parallele.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Rue Gaucheret, 4 \/ B73","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"91\u00e8me parall\u00e8le","address_street_name":"Gaucheretstraat","address_street_number":"4","address_street_box":"B73","email":"info@91parallele.be","website":"https:\/\/91parallele.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Gaucheretstraat, 4 \/ B73","address_line2":"1030 Schaerbeek","description_web":"With the guides from 91eme parall\u00e8le, you can take a step back in time, discover uncharted territory and embark on a journey to the heart of history, legends, architecture and music... always with the quirky point of view that is their trademark. Why 91st parallel? Horizontally, each of the Earth's hemispheres is divided into imaginary circles linking places on the same latitude. The equator is point 0, and the North and South Poles are the 90th parallels.\n\nSo there is no 91st parallel... A team name is a bit zany, a real nod to Belgian surrealism!\n\nPublic and private tours, for young and old. All our 'trips' are listed in the online diary on our website.\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"91\u00e8me parall\u00e8le","address_street_name":"Rue Gaucheret","address_street_number":"4","address_street_box":"B73","email":"info@91parallele.be","website":"https:\/\/91parallele.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Rue Gaucheret, 4 \/ B73","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"91\u00e8me parall\u00e8le","address_street_name":"Rue Gaucheret","address_street_number":"4","address_street_box":"B73","email":"info@91parallele.be","website":"https:\/\/91parallele.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Rue Gaucheret, 4 \/ B73","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"91\u00e8me parall\u00e8le","address_street_name":"Rue Gaucheret","address_street_number":"4","address_street_box":"B73","email":"info@91parallele.be","website":"https:\/\/91parallele.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Rue Gaucheret, 4 \/ B73","address_line2":"1030 Schaerbeek","description_web":"Avec les guides de 91eme parall\u00e8le, prenez de la hauteur, d\u00e9couvrez des territoires inconnus, embarquez dans des voyages au c\u0153ur de l\u2019Histoire, des l\u00e9gendes, de l\u2019architecture, de la musique... toujours avec ce petit point de vue d\u00e9cal\u00e9 qui fait leur marque de fabrique. Pourquoi 91\u00e8me parall\u00e8le ? Horizontalement, chaque h\u00e9misph\u00e8re terrestre est divis\u00e9 en cercles imaginaires reliant les lieux se trouvant sur une m\u00eame latitude. L\u2019\u00e9quateur est le point 0, les P\u00f4le nord et sud sont les 90eme parall\u00e8les.\nIl n'y a donc pas de 91eme parall\u00e8le...Un nom d'\u00e9quipe est un peu loufoque, un v\u00e9ritable petit clin d\u2019\u0153il au surr\u00e9alisme belge !\n\n\nVisites publiques et priv\u00e9es, pour petits et grands, jeunes et moins jeunes. Tous nos \"voyages\" sont repris dans l'agenda en ligne sur notre site internet.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"91\u00e8me parall\u00e8le","address_street_name":"Rue Gaucheret","address_street_number":"4","address_street_box":"B73","email":"info@91parallele.be","website":"https:\/\/91parallele.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Rue Gaucheret, 4 \/ B73","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"91\u00e8me parall\u00e8le","address_street_name":"Gaucheretstraat","address_street_number":"4","address_street_box":"B73","email":"info@91parallele.be","website":"https:\/\/91parallele.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1030","address_city":"Schaarbeek","address_line1":"Gaucheretstraat, 4 \/ B73","address_line2":"1030 Schaarbeek","description_web":"Met de gidsen van 91e parall\u00e8le kun je een stap terug in de tijd zetten, onbekend terrein ontdekken en op reis gaan naar het hart van de geschiedenis, legendes, architectuur en muziek... altijd met de eigenzinnige invalshoek die hun handelsmerk is. Waarom de 91e breedtegraad? Horizontaal is elk halfrond van de aarde verdeeld in denkbeeldige cirkels die plaatsen op dezelfde breedtegraad met elkaar verbinden. De evenaar is punt 0 en de noord- en zuidpool zijn de 90e breedtegraad.\n\nEr is dus geen 91e breedtegraad... Een teamnaam is een beetje zany, een echte knipoog naar het Belgische surrealisme!\n\nOpenbare en priv\u00e9reizen, voor jong en oud. Al onze reizen staan vermeld in de online agenda op onze website.\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[20],"translations":{"de":["Norden"],"pt":[null],"en":["North"],"it":["Nord"],"cn":[null],"fr":["Nord"],"sp":["Norte"],"nl":["Noord"]}},"neca":null,"facebook_id":null,"backoffice_id":41178,"location":{"lat":50.8624095,"lon":4.3601281},"region":"brussels","last_updated_at":"2024-06-17T12:57:33+02:00","published_at":"2023-08-28T11:27:17+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":false,"resto_ranking":0},"organizer":{"id":50000434,"translations":{"de":{"name":"91\u00e8me parall\u00e8le","address_street_name":"Rue Gaucheret","address_street_number":"4","address_street_box":"B73","email":"info@91parallele.be","website":"https:\/\/91parallele.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Rue Gaucheret, 4 \/ B73","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"91\u00e8me parall\u00e8le","address_street_name":"Rue Gaucheret","address_street_number":"4","address_street_box":"B73","email":"info@91parallele.be","website":"https:\/\/91parallele.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1