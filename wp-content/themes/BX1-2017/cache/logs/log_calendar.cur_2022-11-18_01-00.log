00e9s d\u02bcElla), sans oublier leurs voyages en Europe du sud, Alma Tree propose une musique inspir\u00e9e de diff\u00e9rentes cultures qui ne laisse pas indiff\u00e9rent, et invite \u00e0 une r\u00e9flexion po\u00e9tique sur le sens de nos vies modernes.\r\n\r\nCeux qui ont le Pass Bruxelles sur sc\u00e8nes peuvent utiliser un voucher pour le Rayon Vert . Le bar sera ouvert et un d\u00e9licieux plat est propos\u00e9 avant concert.","performers":"Massimiliano Engeli \u00e0 la guitare, au chant et aux compositions; Alice\r\nVandevoorde \u00e0 la basse et au chant.","boxoffice_url":null,"website":"http:\/\/www.lerayonvert.be\/","email":"lerayonvert@skynet.be","phone_contact":null,"phone_booking":"+32 498 63 75 97","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.539169"},"nl":{"name":"Concert Bxl sur sc\u00e8nes : Alma Tree","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.539169"},"en":{"name":"Concert Bxl sur sc\u00e8nes : Alma Tree","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.539169"},"de":{"name":"Concert : Alma Tree","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.539169"},"it":{"name":"Concert : Alma Tree","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.539169"},"sp":{"name":"Concert : Alma Tree","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_u