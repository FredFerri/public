u00e9licieuse tranche de son quotidien d\u2019autrefois. Berceuses, comptines, musique instrumentale, gigues traditionnelles irlandaises s\u2019entrem\u00ealent, ponctu\u00e9es par l\u2019ouverture et la fermeture des portes de la basse-cour au son du \u201ccockadoodledoo !\u201d Un spectacle musical irr\u00e9sistiblement fac\u00e9tieux.","performers":"De et avec Rachel Ponsonby. Mise en sc\u00e8ne : Louis Spagna. Costume : Sophie Debaisieux. Accessoires : Toinette Clette.","boxoffice_url":null,"website":"http:\/\/www.theatremontagnemagique.be","email":"info@montagnemagique.be","phone_contact":null,"phone_booking":"+32 2 210 15 90","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.550696"},"nl":{"name":"Tic tac tock (Zirk Th\u00e9\u00e2tre)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatremontagnemagique.be","email":"info@montagnemagique.be","phone_contact":null,"phone_booking":"+32 2 210 15 90","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.550696"},"en":{"name":"Tic tac tock (Zirk Th\u00e9\u00e2tre)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatremontagnemagique.be","email":"info@montagnemagique.be","phone_contact":null,"phone_booking":"+32 2 210 15 90","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.550696"},"de":{"name":"Tic tac tock (Zirk Th\u00e9\u00e2tre)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatremontagnemagique.be","email":"info@montagnemagique.be","phone_contact":null,"phone_booking":"+32 2 210 15 90","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.550696"},"it":{"name":"Tic tac tock (Zirk Th\u00e9\u00e2tre)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatremontagnemagique.be","email":"info@montagnemagique.be","phone_cont