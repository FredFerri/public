":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{}},"translations":{"de":{"name":"GEORGE SAND \u00b7 La Voi.e.X des Femmes et de la Nature","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lhetre-asbl.be\/george-sand","email":"info@lhetre.be","phone_contact":"+32 478 30 30 73","phone_booking":"+32 478 30 30 73","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700002563"},"pt":{"name":"GEORGE SAND \u00b7 La Voi.e.X des Femmes et de la Nature","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lhetre-asbl.be\/george-sand","email":"info@lhetre.be","phone_contact":"+32 478 30 30 73","phone_booking":"+32 478 30 30 73","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700002563"},"en":{"name":"GEORGE SAND \u00b7 La Voi.e.X des Femmes et de la Nature","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lhetre-asbl.be\/george-sand","email":"info@lhetre.be","phone_contact":"+32 478 30 30 73","phone_booking":"+32 478 30 30 73","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700002563"},"it":{"name":"GEORGE SAND \u00b7 La Voi.e.X des Femmes et de la Nature","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lhetre-asbl.be\/george-sand","email":"info@lhetre.be","phone_contact":"+32 478 30 30 73","phone_booking":"+32 478 30 30 73","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700002563"},"cn":{"name":"GEORGE SAND \u00b7 La Voi.e.X des Femmes et de la Nature","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lhetre-asbl.be\/george-sand","email":"info@lhetre.be","phone_contact":"+32 478 30 30 73","phone_booking":"+32 478 30 30 73","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700002563"},"fr":{"name":"GEORGE SAND \u00b7 La Voi.e.X des Femmes et de la Nature","shortdescr":"Venez d\u00e9couvrir George SAND, Amantine Aurore Lucile DUPIN de FRANCUEIL, dans l'exposition GEORGE SAND \u00b7 LA VOI.E.X DES FEMMES ET DE LA NATURE que nous lui consacrons.\nMme Barbara TRACHTE, Ministre-Pr\u00e9sidente de la COCOF, dont nous soulignons ici les belles convictions, nous fait l'immense honneur d'H\u00caTRE la Marraine de cette exposition litt\u00e9raire, artistique, f\u00e9ministe, \u00e9cologique et sociale.","longdescr":"Cet automne,\nL'H\u00caTRE ASBL c\u00e9l\u00e8bre, d\u00e8s le 16 novembre, le g\u00e9nie de celle qui fut \u00e0 l'avant-garde de tous les nobles positionnements sociaux, philosophiques et \u00e9cologiques d'aujourd'hui.\n\nGeorge SAND (1804-1876) fut vilainement caricatur\u00e9e en son temps par les plus r\u00e9actionnaires, et son \u0153uvre \u00e9cart\u00e9e des consciences depuis la fin du XIXe.\n\nElle fut consid\u00e9r\u00e9e par les plus grands esprits europ\u00e9ens de son \u00e9poque, comme leur mentor, leur muse, leur D\u00e9esse, leur m\u00e9c\u00e8ne (pour certains d'entre eux).\n\nVenez d\u00e9couvrir George SAND, de son vrai nom Amantine Aurore Lucile DUPIN de FRANCUEIL, dans l'exposition intitul\u00e9e GEORGE SAND \u00b7 LA VOI.E.X DES FEMMES ET DE LA NATURE que nous lui consacrons dans notre espace LE GERMOIR \u00e0 Ixelles.\n\nMadame Barbara TRACHTE, Ministre-Pr\u00e9sidente de la COCOF, dont nous soulignons ici les belles convictions, nous fait l'immense honneur d'H\u00caTRE la Marraine de cette exposition litt\u00e9raire, artistique, f\u00e9ministe, philosophique, \u00e9cologique et sociale.\n\nVernissage de l'exposition :\nOuverture des portes \u00e0 16h\nInauguration officielle de 19h \u00e0 23h\n\nRejoignez-nous pour un \u00e9v\u00e9nement inspirant c\u00e9l\u00e9brant, gr\u00e2ce \u00e0 George SAND, la Voi.e.X des Femmes et de la Nature. Plongez dans la beaut\u00e9 de la litt\u00e9rature et de la Nature lors de cette rencontre unique.\n\n\"Voulez-vous r\u00eaver, jouir d'une vie intense, eh bien d\u00e9fendez la NATURE car elle est la source de l'art. Et mieux encore, elle est la source de la vie.\" George SAND\n\n\"Toute parole qui tombe de votre plume, c\u2019est l\u2019immortalit\u00e9. Vous \u00eates l\u2019une des deux ou trois personnes auxquelles tient encore la gloire de la France. Le plus grand prosateur du si\u00e8cle est une femme : Madame SAND.\" Jules MICHELET\n\n\"Sous quelle constellation \u00eates-vous donc n\u00e9e pour r\u00e9unir dans votre personne des qualit\u00e9s si diverses, si nombreuses et si rares ?\" Gustave FLAUBERT\n\n\"Les femmes de l\u2019univers entier doivent \u00e0 pr\u00e9sent porter le deuil de George SAND, parce que l\u2019un des plus nobles repr\u00e9sentants du sexe f\u00e9minin est mort, parce qu\u2019elle fut une femme d\u2019une force d\u2019esprit et d\u2019un talent presque inou\u00efs. Son nom, d\u00e8s \u00e0 pr\u00e9sent, devient historique, et c\u2019est un nom que l\u2019on n\u2019a pas le droit d\u2019oublier, qui ne dispara\u00eetra jamais.\" Fiodor DOSTO\u00cfEVSKI\n\n\"Les \u00eatres comme George SAND sont des bienfaiteurs publics. Ils passent, et \u00e0 peine ont-ils pass\u00e9 que l\u2019on voit \u00e0 leur place, qui semblait vide, surgir une r\u00e9alisation nouvelle du progr\u00e8s (...) George SAND meurt, mais elle nous l\u00e8gue le droit de la femme puisant son \u00e9vidence dans le g\u00e9nie de la femme.\" Victor HUGO\n\n#georgesand #exposition #litterature #art #culture #feminisme #philosophie #ecologie #social #transitionecologique #respectduvivant #heritage #genie #lumi\u00e8re #ixelles #bruxelles #belgique","performers":"Po\u00e9sie de la Terre : Laura SCHLICHTER,  Roxane LEFEBVRE\nMusique : GU\u00c9NO & Band\nChant : - Thibault TRIANDAFYLLOT    \nDanse : Alexandra PHOLIEN\nLecture : Aurel DELHAYE, Cl\u00e9mence DAWAGNE\n\nPr\u00e9sentateur : Vincent SCHAACK","boxoffice_url":null,"website":"https:\/\/www.lhetre-asbl.be\/george-sand","email":"info@lhetre.be","phone_contact":"+32 478 30 30 73","phone_booking":"+32 478 30 30 73","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700002563"},"sp":{"name":"GEORGE SAND \u00b7 La Voi.e.X des Femmes et de la Nature","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lhetre-asbl.be\/george-sand","email":"info@lhetre.be","phone_contact":"+32 478 30 30 73","phone_booking":"+32 478 30 30 73","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700002563"},"nl":{"name":"GEORGE SAND \u00b7 La Voi.e.X des Femmes et de la Nature","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lhetre-asbl.be\/george-sand","email":"info@lhetre.be","phone_contact":"+32 478 30 30 73","phone_booking":"+32 478 30 30 73","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700002563"}},"place":{"id":50002533,"translations":{"de":{"name":"LE GERMOIR","address_street_name":"Avenue Louise","address_street_number":"263","address_street_box":null,"email":"info@lhetre.be","website":"https:\/\/www.lhetre-asbl.be\/","phone_contact":"+32 478 30 30 73","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Louise, 263","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"LE GERMOIR","address_street_name":"Avenue Louise","address_street_number":"263","address_street_box":null,"email":"info@lhetre.be","website":"https:\/\/www.lhetre-asbl.be\/","phone_contact":"+32 478 30 30 73","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Louise, 263","address_lin