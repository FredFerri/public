ame":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"visit_profile":{"list":[337],"translations":{"fr":["Highlight"],"nl":["Highlight"],"en":["Highlight"],"de":["Highlight"],"it":["Highlight"],"sp":["Highlight"],"pt":[null],"cn":[null]}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-02-13T02:36:59+01:00","published_at":"2022-10-25T10:59:49+02:00","backoffice_id":264704,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.53814194032231},{"id":539303,"date_start":"2023-02-14","date_end":"2023-02-25","date_next":"2023-02-14","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater","it":"Teatro","sp":"Teatro","pt":null,"cn":null}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"],"de":["Theater"],"it":["Teatro"],"sp":["Teatro"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"\u00c9loge de l\u2019alt\u00e9rit\u00e9 - Isabelle Pousseur","shortdescr":"Conf\u00e9rence-spectacle th\u00e9\u00e2trale et musicale. Un spectacle cr\u00e9\u00e9 lors du Festival Mouvements d\u2019alt\u00e9rit\u00e9, en octobre 2021 au Th\u00e9\u00e2tre Oc\u00e9an Nord.","longdescr":"\u00ab \u00c9loge de l\u2019alt\u00e9rit\u00e9 est un spectacle b\u00e2ti autour de mon envie de partager une pens\u00e9e.\r\nTout est parti de l\u2019\u00e9criture d\u2019une conf\u00e9rence \u2013 au sens classique. Titr\u00e9e Conf\u00e9rence sur l\u2019alt\u00e9rit\u00e9, elle a \u00e9t\u00e9 donn\u00e9e au Th\u00e9\u00e2tre Oc\u00e9an Nord, puis en Suisse, avant de para\u00eetre en 2013 dans un num\u00e9ro sp\u00e9cial d\u2019Alternatives Th\u00e9\u00e2trales. Ma position y est celle d\u2019une metteure en sc\u00e8ne qui rend compte de sa pratique, \u00e0 partir de sa position singuli\u00e8re. Et pour moi, le metteur en sc\u00e8ne se trouve au centre d\u2019une constellation d\u2019alt\u00e9rit\u00e9s\u2009: celle de l\u2019auteur, de l\u2019acteur, du personnage et du spectateur. Cet ench\u00e2ssement de regards \u00ab\u2009autres\u2009\u00bb constitue, selon moi, la plus grande partie du travail. S\u2019interroger sur l\u2019alt\u00e9rit\u00e9, c\u2019est explorer en quoi la mise en sc\u00e8ne s\u2019enrichit des autres, comment elle les int\u00e8gre, les inclut et en d\u00e9pend.\r\n\r\nJ\u2019ai d\u00e9cid\u00e9 ensuite de transformer cette conf\u00e9rence en entretien, \u00e0 la fois parce que je trouve \u00e7a plus vivant mais aussi pour introduire une id\u00e9e de transmission. Pour cela, je me suis inspir\u00e9e de l\u2019Ab\u00e9c\u00e9daire de Gilles Deleuze qui est interview\u00e9 par une ancienne \u00e9tudiante \u00e0 lui. J\u2019ai donc propos\u00e9 \u00e0 Bogdan Kikena, un jeune metteur en sc\u00e8ne qui a \u00e9t\u00e9 mon \u00e9tudiant et mon assistant \u00e0 l\u2019INSAS, d\u2019\u00eatre mon interlocuteur. \r\n\r\nDeux ans ont pass\u00e9 et, au bout du compte, ce spectacle, dont le sous-titre est Conf\u00e9rence-spectacle th\u00e9\u00e2trale et musicale, se pr\u00e9sente comme un voyage dans lequel entretien, conversation, r\u00e9cits, fiction et musique dialoguent constamment. Aux c\u00f4t\u00e9s des com\u00e9diens avec qui je partage le plateau \u2013 Chlo\u00e9 Winkel, Francesco Italiano, Paul Camus, Amid Chakir, Bogdan Kik\u00e9na \u2013 Jean-Luc Plouvier, au piano, y tient, dans cette perspective, un r\u00f4le tr\u00e8s important.\r\n\r\nDans le spectacle, il y aura d\u2019abord un premier entretien introductif autour de la formule \u00ab\u2009Le th\u00e9\u00e2tre, art de l\u2019autre\u2009\u00bb et de la raison pour laquelle je crois que l\u2019exp\u00e9rience th\u00e9\u00e2trale se structure \u00e0 partir du concept d\u2019alt\u00e9rit\u00e9.","performers":"Isabelle Pousseur,Paul Camus,Amid Chakir,Francesco Italiano,Bogdan Kikena,Chlo\u00e9 Winkel,Jean-Luc Plouvier\/Guillemette Laurent,Nicolas Sanchez,Simon Dalemans,L\u00e9o Monvoisin \/Aminata Abdoulaye,Julien Beckers,Madeleine Camus,Ga\u00ebtan Charbonnier, Romain Cinter,No\u00e9 Englebert,Thimoth\u00e9e Journot,Louise Moret,Djo Ngeleka,Solange Muneme,Emmanuelle G.Rousseau,Papis,\u00a0Souad Toughra\u00ef \/","boxoffice_url":null,"website":"http:\/\/www.oceannord.org","email":"info@oceannord.org","phone_contact":"+32 2 242 96 89","phone_booking":"+32 2 216 75 55","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.539303"},"nl":{"name":"\u00c9loge de l\u2019alt\u00e9rit\u00e9 - Isabelle Pousseur","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.oceannord.org","email":"info@oceannord.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.539303"},"en":{"name":"\u00c9loge de l\u2019alt\u00e9rit\u00e9 - Isabelle Pousseur","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.oceannord.org","email":"info@oceannord.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.539303"},"de":{"name":"\u00c9loge de l\u2019alt\u00e9rit\u00e9 (Conf\u00e9rence-spectacle th\u00e9\u00e2trale et musicale) - Isabelle Pousseur","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.oceannord.org","email":"info@oceannord.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.539303"},"it":{"name":"\u00c9loge de l\u2019alt\u00e9rit\u00e9 (Conf\u00e9rence-spectacle th\