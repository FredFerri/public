ity":false,"is_not_major_event":false,"backoffice_id":319190,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"other","ranking":0.2696559088937193,"languages":{"spoken":["en","de","fr"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exposici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[30,24],"translations":{"de":["Malerei","Kunstgalerien"],"pt":[null,null],"en":["Painting","Art Galleries"],"it":["Pittura","Gallerie d'arte"],"cn":[null,null],"fr":["Peinture","Galeries d'art"],"sp":["Pintura","Galer\u00edas de arte"],"nl":["Schilderkunst","Galeries"]}}},"translations":{"de":{"name":"Close Encounters","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lage-egal.net","email":"off-space@lage-egal.net","phone_contact":"00491731807226","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700007219"},"pt":{"name":"Close Encounters","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lage-egal.net","email":"off-space@lage-egal.net","phone_contact":"00491731807226","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700007219"},"en":{"name":"Close Encounters","shortdescr":"Opening CLOSER ENCOUNTERS, Fri 7 March. Discover the works of German artists FRANZISKA REINBOTHE and\u00a0TOM FR\u00dcCHTL in their first Belgian show.\u00a0\n\nFounded in 2019 by Pierre Granoux, LAGE EGAL\u00a0(= location doesn\u2019t matter) is a nomadic gallery based in Berlin and Brussels (from 2024). Focused on bold, energetic artist pairings and experimental formats, it redefines what a contemporary art space can be.","longdescr":"In this second curatorial project in our new temporary exhibition space in Brussels, we are thrilled to present an exciting duo show featuring two remarkable German artists, FRANZISKA REINBOTHE based in Pretzsch near Leipzig, and TOM FR\u00dcCHTL from Berlin.\n\nIn CLOSE ENCOUNTERS, the works of the artists come together in a dynamic dialogue\u2014approaching, confronting, and intertwining with one another. This exhibition creates an intimate space where two distinct artistic practices engage in conversation, inviting the viewer to join this encounter.\n\nMarking their first exhibition in Brussels, Close Encounters draws inspiration from its title\u2019s cinematic roots in Close Encounters of the Third Kind. Much like the film\u2019s exploration of contact and communication across unknown dimensions, this exhibition investigates the interaction between two artistic worlds. Reinbothe and Fr\u00fcchtl challenge the conventional boundaries of painting, each in their own way highlights the reverse side of the canvas, the dark side of the painting.\n\nFranziska Reinbothe\u2019s work deconstructs and reassembles the canvas, unveiling its hidden structures and transforming its materiality. Meanwhile, Tom Fr\u00fcchtl reimagines the surface and physicality of painting, meticulously reconstructing forms to expose new visual possibilities. Together, their works resonate, creating subtle correspondences, contrasts, and unexpected connections.\n\nThrough this interplay, Closer Encounters invites visitors to reflect on proximity and discovery\u2014both between the artworks and within their own gaze. The result is a thoughtful exploration of what emerges in the space between visual worlds: a rich dialogue of shared tensions, affinities, and the magic of encounter.","performers":"Franziska Reinbothe, Tom Fr\u00fcchtl","boxoffice_url":null,"website":"https:\/\/www.lage-egal.net","email":"off-space@lage-egal.net","phone_contact":"00491731807226","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700007219"},"it":{"name":"Close Encounters","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lage-egal.net","email":"off-space@lage-egal.net","phone_contact":"00491731807226","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700007219"},"cn":{"name":"Close Encounters","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lage-egal.net","email":"off-space@lage-egal.net","phone_contact":"00491731807226","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700007219"},"fr":{"name":"Close Encounters","shortdescr":"Vernissage CLOSER ENCOUNTERS, le vendredi 7 mars avec les artistes FRANZISKA REINBOTHE et TOM FR\u00dcCHTL. \n\nFond\u00e9e en 2019 par Pierre Granoux, LAGE EGAL (= location doesn't matter) est une galerie nomade bas\u00e9e \u00e0 Berlin et \u00e0 Bruxelles (\u00e0 partir de 2024). Ax\u00e9e sur des paires d'artistes audacieuses et \u00e9nergiques et des formats exp\u00e9rimentaux, elle red\u00e9finit ce que peut \u00eatre un espace d'art contemporain.","longdescr":"Pour ce deuxi\u00e8me projet de commissariat dans notre nouvel espace d'exposition temporaire \u00e0 Bruxelles, nous sommes ravis de pr\u00e9senter une passionnante exposition en duo avec deux remarquables artistes allemands, FRANZISKA REINBOTHE, bas\u00e9e \u00e0 Pretzsch pr\u00e8s de Leipzig, et TOM FR\u00dcCHTL, de Berlin.\n\nDans CLOSE ENCOUNTERS, les \u0153uvres des artistes se rencontrent dans un dialogue dynamique, s'approchant, se confrontant et s'entrela\u00e7ant l'une \u00e0 l'autre. Cette exposition cr\u00e9e un espace intime o\u00f9 deux pratiques artistiques distinctes s'engagent dans une conversation, invitant le spectateur \u00e0 se joindre \u00e0 cette rencontre.\n\nPour leur premi\u00e8re exposition \u00e0 Bruxelles, Close Encounters s'inspire des racines cin\u00e9matographiques du film Close Encounters of the Third Kind. \u00c0 l'instar du film qui explore le contact et la communication \u00e0 travers des dimensions inconnues, cette exposition \u00e9tudie l'interaction entre deux mondes artistiques. Reinbothe et Fr\u00fcchtl remettent en question les limites conventionnelles de la peinture, chacun mettant en lumi\u00e8re \u00e0 sa mani\u00e8re l'envers de la toile, le c\u00f4t\u00e9 sombre de la peinture.\n\nLe travail de Franziska Reinbothe d\u00e9construit et r\u00e9assemble la toile, d\u00e9voilant ses structures cach\u00e9es et transformant sa mat\u00e9rialit\u00e9. Tom Fr\u00fcchtl, quant \u00e0 lui, r\u00e9imagine la surface et l'aspect physique de la peinture, reconstruisant m\u00e9ticuleusement les formes afin d'exposer de nouvelles possibilit\u00e9s visuelles. Ensemble, leurs \u0153uvres entrent en r\u00e9sonance, cr\u00e9ant des correspondances subtiles, des contrastes et des liens inattendus.\n\nGr\u00e2ce \u00e0 cette interaction, Rencontres plus \u00e9troites invite les visiteurs \u00e0 r\u00e9fl\u00e9chir sur la proximit\u00e9 et la d\u00e9couverte, tant entre les \u0153uvres d'art qu'au sein de leur propre regard. Le r\u00e9sultat est une exploration r\u00e9fl\u00e9chie de ce qui \u00e9merge dans l'espace entre les mondes visuels : un dialogue riche de tensions partag\u00e9es, d'affinit\u00e9s et de la magie de la rencontre.","performers":"Franziska Reinbothe, Tom Fr\u00fcchtl","boxoffice_url":null,"website":"https:\/\/www.lage-egal.net","email":"off-space@lage-egal.net","phone_contact":"00491731807226","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700007219"},"sp":{"name":"Close Encounters","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lage-egal.net","email":"off-space@lage-egal.net","phone_contact":"00491731807226","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700007219"},"nl":{"name":"Close Encounters","shortdescr":"Opening CLOSER ENCOUNTERS, vr 7 maart met de kunstenaars FRANZISKA REINBOTHE en TOM FR\u00dcCHTL. \n\nLAGE EGAL (= locatie doet er niet toe) werd in 2019 opgericht door Pierre Granoux en is een nomadische galerie gevestigd in Berlijn en Brussel (vanaf 2024). Gefocust op gedurfde, energieke kunstenaarsparen en experimentele formats, herdefinieert het wat een hedendaagse kunstruimte kan zijn.","longdescr":"In dit tweede curatori\u00eble project in onze nieuwe tijdelijke tentoonstellingsruimte in Brussel presenteren we met veel plezier een spannende duotentoonstelling met twee opmerkelijke Duitse kunstenaars, FRANZISKA REINBOTHE uit Pretzsch bij Leipzig en TOM FR\u00dcCHTL uit Berlijn.\n\nIn CLOSE ENCOUNTERS komen de werken van de kunstenaars samen in een dynamische dialoog - ze benaderen, confronteren en verstrengelen elkaar. Deze tentoonstelling cre\u00ebert een intieme ruimte waar twee verschillende artistieke praktijken met elkaar in gesprek gaan en nodigt de toeschouwer uit om deel te nemen aan deze ontmoeting.\n\nClose Encounters, de eerste tentoonstelling in Brussel, is ge\u00efnspireerd op de film Close Encounters of the Third Kind. Net zoals de film het contact en de communicatie over onbekende dimensies onderzoekt, onderzoekt deze tentoonstelling de interactie tussen twee artistieke werelden. Reinbothe en Fr\u00fcchtl dagen de conventionele grenzen van de schilderkunst uit en belichten elk op hun eigen manier de keerzijde van het doek, de donkere kant van het schilderij.\n\nHet werk van Franziska Reinbothe deconstrueert en hermonteert het doek, onthult de verborgen structuren en transformeert de materialiteit ervan. Tom Fr\u00fcchtl herinterpreteert het oppervlak en de fysiciteit van het schilderen, waarbij hij nauwgezet vormen reconstrueert om nieuwe visuele mogelijkheden bloot te leggen. Samen resoneren hun werken en cre\u00ebren ze subtiele overeenkomsten, contrasten en onverwachte verbanden.\n\nDoor deze wisselwerking nodigt Closer Encounters bezoekers uit om na te denken over nabijheid en ontdekking - zowel tussen de kunstwerken als in hun eigen blik. Het resultaat is een doordachte verkenning van wat er ontstaat in de ruimte tussen visuele werelden: een rijke dialoog van gedeelde spanningen, affiniteiten en de magie van de ontmoeting.","performers":"Franziska Reinbothe, Tom Fr\u00fcchtl","boxoffice_url":null,"website":"https:\/\/www.lage-egal.net","email":"off-space@lage-egal.net","phone_contact":"00491731807226","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700007219"}},"place":{"id":50002835,"translations":{"de":{"name":"LAGE EGAL Curatorial Projects","address_street_name":"Rue Saint-Georges","address_street_number":"5","address_street_box":null,"email":"sonderlage@lage-egal.net","website":"www.lage-egal.net","phone_contact":"+491731807226","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Saint-Georges, 5","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"LAGE EGAL Curatorial Projects","address_street_name":"Rue Saint-Georges","address_street_number":"5","address_street_box":null,"email":"sonderlage@lage-egal.net","website":"www.lage-egal.net","phone_contact":"+491731807226","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Saint-Georges, 5","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"LAGE EGAL Curatorial Projects","address_street_name":"Sint-Jorisstraat","address_street_number":"5","address_street_box":null,"email":"sonderlage@lage-egal.net","website":"www.lage-egal.net","phone_contact":"+491731807226","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Sint-Jorisstraat, 5","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"s