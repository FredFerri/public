nk":null,"import_origin":null,"is_part_of":null,"sub_type":"misc","ranking":0.25,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":84,"translations":{"de":"Verschiedenes","pt":null,"en":"Various","it":"Varie","cn":null,"fr":"Divers","sp":"Varios","nl":"Varia"}},"others":{"list":[260],"translations":{"de":["Conversations with authors"],"pt":[null],"en":["Conversations with authors"],"it":["Conversations with authors"],"cn":[null],"fr":["Rencontres"],"sp":["Conversations with authors"],"nl":["Meet-and-greets"]}}},"translations":{"de":{"name":"Les Ap\u00e9ros Culturels","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/culture.ulb.be\/fr\/programmation\/actualites\/saison-1-des-aperos-culturels","email":"culture@ulb.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700003110"},"pt":{"name":"Les Ap\u00e9ros Culturels","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/culture.ulb.be\/fr\/programmation\/actualites\/saison-1-des-aperos-culturels","email":"culture@ulb.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700003110"},"en":{"name":"Les Ap\u00e9ros Culturels","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/culture.ulb.be\/fr\/programmation\/actualites\/saison-1-des-aperos-culturels","email":"culture@ulb.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700003110"},"it":{"name":"Les Ap\u00e9ros Culturels","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/culture.ulb.be\/fr\/programmation\/actualites\/saison-1-des-aperos-culturels","email":"culture@ulb.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700003110"},"cn":{"name":"Les Ap\u00e9ros Culturels","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/culture.ulb.be\/fr\/programmation\/actualites\/saison-1-des-aperos-culturels","email":"culture@ulb.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700003110"},"fr":{"name":"Les Ap\u00e9ros Culturels - saison #1","shortdescr":"ULB Culture et le Coin Culture s'associent pour lancer un tout nouveau projet: les ap\u00e9ros culturels. Une fois par mois, nous vous invitons \u00e0 participer \u00e0 des discussions passionnantes autour d'une th\u00e9matique culturelle actuelle, en compagnie de professionnels du secteur culturel bruxellois et de membres de la communaut\u00e9 universitaire.","longdescr":"ULB Culture et le Coin Culture s'associent pour lancer un tout nouveau projet: les ap\u00e9ros culturels. Une fois par mois, nous vous invitons \u00e0 participer \u00e0 des discussions passionnantes autour d'une th\u00e9matique culturelle actuelle, en compagnie de professionnels du secteur culturel bruxellois et de membres de la communaut\u00e9 universitaire.\n\nLes ap\u00e9ros culturels auront lieu de 18h \u00e0 20h, au Coin Culture. Venez \u00e9changer, d\u00e9battre et poser vos questions dans une ambiance conviviale, inspir\u00e9e des caf\u00e9s culturels !\n \n\nCalendrier:\n3 d\u00e9cembre 2024: Culture festive, en danger ou \u00e0 r\u00e9inventer?\n\nLe 3 d\u00e9cembre 2024 \u00e0 18h, nous aborderons la question suivante : \n\u00ab Culture festive, en danger o\u00f9 \u00e0 r\u00e9inventer? \u00bb. \nLa sc\u00e8ne nocturne, et en particulier les clubs bruxellois, est confront\u00e9e \u00e0 de nombreux d\u00e9fis. Entre la gestion complexe des espaces festifs, les contraintes administratives, les nuisances sonores et la s\u00e9curit\u00e9, il devient de plus en plus difficile de maintenir ces lieux de f\u00eate en activit\u00e9. \u00c0 cela s'ajoutent les \u00e9volutions des comportements festifs et les d\u00e9fis \u00e9conomiques. Faut-il r\u00e9inventer la nightlife pour assurer sa p\u00e9rennit\u00e9 ? Quels sont les obstacles et les opportunit\u00e9s pour les professionnels de ce secteur ?\n\nIntervenants:\nBrussels by Night Federation - Lorenzo Serra\nUMI - Daria De Troostembergh\nVille de Bruxelles: Service Tranquillit\u00e9 Publique et Ev\u00e8nements - Maude Glorieux\n\n\nLes ap\u00e9ros culturels seront mod\u00e9r\u00e9s par Z\u00e9lie Sels, artiste et com\u00e9dienne.\n \n\nNe manquez pas ces rendez-vous ! Suivez ULB Culture et le Coin Culture pour \u00eatre inform\u00e9 des invit\u00e9s et des prochaines th\u00e9matiques.\n \n\nL'\u00e9v\u00e8nement est gratuit, sur inscription: veuillez vous inscrire via ce lien https:\/\/forms.office.com\/e\/GUMABGK7ZP\n\n@ulbculture\n@coinculture_bxl\n\n#partageonslaculture\n\n_________________________\n\nLes Ap\u00e9ros Culturels pass\u00e9es:\n \n\nLe 1er octobre 2024 \u00e0 18h, nous nous avons abord\u00e9 la question suivante : \u00ab Espaces communs : comment cr\u00e9er du lien ? \u00bb.\n\u00c0 Bruxelles, les tiers-lieux, coworking et occupations temporaires o\u00f9 cohabitent plusieurs associations sont de plus en plus nombreux, mais comment peut-on y faire cohabiter diff\u00e9rents projets ? Trois invit\u00e9s \u00e9taient l\u00e0 pour discuter de ce sujet et r\u00e9pondre \u00e0 toutes les questions autour d\u2019un verre.\n\nIntervenants:\n- Pierre Pev\u00e9e : Manager de LaVall\u00e9e, un tiers-lieu cr\u00e9atif situ\u00e9 \u00e0 Molenbeek o\u00f9 interagissent quotidiennement 150 entrepreneurs issus de diff\u00e9rents secteurs culturels. Il est aussi cr\u00e9ateur de la Brussels Art Factory et administrateur de Nuits Sonores Brussels.\n\n- Zaineb Hamdi : Designeuse-relieuse et graphiste, cofondatrice du 3 Studio et gestionnaire de l'ASBL Au Charbon, un collectif d\u2019artisanes et designers \u00e0 Bruxelles. Elle est \u00e9galement enseignante en design graphique.\n\n- \u00c9milie Garcia Guillen : Chercheuse post-doctorante \u00e0 l\u2019ULB, sp\u00e9cialiste des lieux culturels et cofondatrice du m\u00e9dia culturel La Pointe. Son travail porte notamment sur les questions de \"lieux communs\" et d'espaces partag\u00e9s.\n\nLe 5 novembre 2024 \u00e0 18h, nous avons abord\u00e9 la question suivante : \u00ab Consommation culturelle, vers une d\u00e9mat\u00e9rialisation totale ? \u00bb. \nDans un monde o\u00f9 le num\u00e9rique prend de plus en plus de place, la consommation culturelle \u00e9volue rapidement. Musique, films, livres: tout semble aujourd\u2019hui \u00e0 port\u00e9e de clic. Mais sommes-nous pr\u00eats pour une d\u00e9mat\u00e9rialisation compl\u00e8te ? Quels sont les avantages et les inconv\u00e9nients d\u2019une telle \u00e9volution?\n\nIntervenant\u00b7es:\n- Kinograph - Clara L\u00e9onet (co-responsable)\n- PIAS Belgium - Damien Waselle (directeur)\n- ULB - Louis Wiart (expert en communication)","performers":null,"boxoffice_url":null,"website":"https:\/\/culture.ulb.be\/fr\/programmation\/actualites\/saison-1-des-aperos-culturels","email":"culture@ulb.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700003110"},"sp":{"name":"Les Ap\u00e9ros Culturels","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/culture.ulb.be\/fr\/programmation\/actualites\/saison-1-des-aperos-culturels","email":"culture@ulb.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700003110"},"nl":{"name":"Les Ap\u00e9ros Culturels","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/culture.ulb.be\/fr\/programmation\/actualites\/saison-1-des-aperos-culturels","email":"culture@ulb.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda