 Moderne !  \r\n- Lundi 7\/11\/2022: Korczak, la t\u00eate haute  \r\n- Lundi 23\/01\/2023: Les combats de C\u00e9lestin Freinet","performers":null,"boxoffice_url":null,"website":"http:\/\/www.whalll.be","email":"billetterie@whalll.be","phone_contact":"+32 2 435 59 99","phone_booking":"+32 2 435 59 99","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.539067"},"nl":{"name":"Lectures th\u00e9\u00e2trales par les Universit\u00e9s Populaires du Th\u00e9\u00e2tre","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.539067"},"en":{"name":"Lectures th\u00e9\u00e2trales par les Universit\u00e9s Populaires du Th\u00e9\u00e2tre","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.539067"},"de":{"name":"Lectures th\u00e9\u00e2trales par les Universit\u00e9s Populiares du Th\u00e9\u00e2tre","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.539067"},"it":{"name":"Lectures th\u00e9\u00e2trales par les Universit\u00e9s Populiares du Th\u00e9\u00e2tre","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.539067"},"sp":{"name":"Lectures th\u00e9\u00e2trales par les Universit\u00e9s Populiares du Th\u00e9\u00e2tre","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/vi