l,"start":"16:00:00","end":"17:30:00"},{"day":"2022-11-19","doors":null,"start":"16:00:00","end":"17:30:00"},{"day":"2022-11-26","doors":null,"start":"16:00:00","end":"17:30:00"},{"day":"2022-12-03","doors":null,"start":"16:00:00","end":"17:30:00"},{"day":"2022-12-10","doors":null,"start":"16:00:00","end":"17:30:00"},{"day":"2022-12-17","doors":null,"start":"16:00:00","end":"17:30:00"}],"recurring":[{"day":"saturday","occurences":{"is_first":true,"is_second":true,"is_third":true,"is_fourth":true,"is_last":true},"time_start":"16:00:00","time_end":"17:30:00","translations":{"fr":"Ouvert les premier, deuxi\u00e8me, troisi\u00e8me, quatri\u00e8me et dernier samedis du mois de 16:00 \u00e0 17:30","nl":"Open op de eerste, tweede, derde, vierde en laatste zaterdags van de maand van 16:00 tot 17:30","en":"Open the first, second, third, fourth and last saturdays of the month from 16:00 to 17:30"}}],"closing_days":["2022-10-01"],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":20}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"visit_profile":{"list":[323],"translations":{"fr":["Gastronomie"],"nl":["Gastronomie"],"en":["Gastronomy"],"de":["Gastronomie"]}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-10T18:36:29+02:00","published_at":"2022-09-01T17:07:51+02:00","backoffice_id":260832,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.21129929348218},{"id":540717,"date_start":"2022-09-17","date_end":"2023-06-24","date_next":"2022-10-15","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":true,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung"}},"others":{"list":[24,34],"translations":{"fr":["Galeries d'art","Pluridisciplinaire"],"nl":["Galeries","Pluridisciplinair"],"en":["Art Galleries","Multidisciplinary"],"de":["Kunstgalerien","Multidisziplin\u00e4r"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Art Beats. Venez vibrer au rythme de l\u2019art belge.","shortdescr":"Vivez l\u2019exp\u00e9rience de la Belfius Art Collection autrement. Explorez le lien qui unit les diff\u00e9rents styles, courants et artistes. Les ma\u00eetres classiques dialoguent avec les jeunes cr\u00e9ateurs. Les \u0153uvres c\u00e9l\u00e8bres rencontrent des p\u00e9pites encore \u00e0 d\u00e9couvrir.","longdescr":"Vivez l\u2019exp\u00e9rience de la Belfius Art Collection autrement. Explorez le lien qui unit les diff\u00e9rents styles, courants et artistes. Les ma\u00eetres classiques dialoguent avec les jeunes cr\u00e9ateurs. Les \u0153uvres c\u00e9l\u00e8bres rencontrent des p\u00e9pites encore \u00e0 d\u00e9couvrir.\r\nAdmirez les \u0153uvres de Pierre-Paul Rubens, Ren\u00e9 Magritte, Rik Wouters, Paul Delvaux, L\u00e9on Spilliaert, Jules Schmalzigaug, Th\u00e9o Van Rysselberghe, James Ensor \u00e0 Pierre Alechinsky, Sanam Khatibi, Micha\u00ebl Borremans, en passant par Edith Dekyndt, Jan Vercruysse, Joris Van de Moortel, Jan Van Imschoot, Sophie Kuijken, Bendt Eyckermans et de nombreux autres artistes de renom.\r\n\r\nCette exposition c\u00e9l\u00e8bre la rencontre in\u00e9dite entre des oeuvres d\u2019art belges qui se m\u00ealent en un concert qui r\u00e9sonnera longtemps. Une exp\u00e9rience in\u00e9dite qui met tous les sens en \u00e9veil. Une \u00e9nergie unique qui vous offre un regard neuf sur l'art belge. L\u2019exposition est accessible plusieurs jours par mois sur r\u00e9servation pr\u00e9alable.\r\nInfos et inscriptions : belfius.be\/artbeats","performers":null,"boxoffice_url":null,"website":"https:\/\/www.belfius.be\/about-us\/fr\/actualites\/art-beats","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.540717"},"nl":{"name":"Art Beats. Op het ritme van de Belgische kunst.","shortdescr":"Klaar om de Belfius Art Collection op een gloednieuwe manier te ervaren? Over alle stijlen, stromingen en kunstenaars heen ontdekt u wat hen bindt.\u00a0Klassieke meesters gaan in gesprek met hedendaagse artiesten.\u00a0Beroemde werken ontmoeten nog te ontdekken pareltjes.","longdescr":"Klaar om de Belfius Art Collection op een gloednieuwe manier te ervaren? Over alle stijlen, stromingen en kunstenaars heen ontdekt u wat hen bindt.\u00a0Klassieke meesters gaan in gesprek met hedendaagse artiesten.\u00a0Beroemde werken ontmoeten nog te ontdekken pareltjes. Bewonder de werken van Pieter-Paul Rubens, Ren\u00e9 Magritte, Rik Wouters, Paul Delvaux, L\u00e9on Spilliaert, Jules Schmalzigaug, Th\u00e9o Van Rysselberghe en James Ensor, tot Pierre Alechinsky, Sanam Khatibi, Micha\u00ebl Borremans, Edith Dekyndt, Jan Vercruysse, Joris Van de Moortel, Jan Van Imschoot, Sophie Kuijken, Bendt Eyckermans en nog veel meer topartiesten.\r\n\r\nDeze tentoonstelling brengt ongeziene ontmoetingen tussen Belgische kunstwerken die elkaar versterken en uitgroeien tot\u00a0een stroom aan ervaringen die nog lang mogen nazinderen. De energie die vrijkomt, stimuleert u om Belgische kunst op een verfrissende manier te beleven.\r\n\r\nDe tentoonstelling is verschillende dagen per maand open. We vragen u wel om op voorhand in te schrijven.\r\nInfo en inschrijvingen:\u00a0belfius.be\/artbeats","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.540717"},"en":{"name":"Art Beats.","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.540717"},"de":{"name":"Art Beats. Venez vibrer au rythme de l\u2019art belge.","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.540717"},"it":{"name":"Art Beats. Venez vibrer au rythme de l\u2019art belge.","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.540717"},"sp":{"name":"Art Beats. Venez vibrer au rythme de l\u2019art belge.","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.540717"},"pt":{"name":"Art Beats. Venez vibrer au rythme de l\u2019art belge.","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.540717"},"cn":{"name":"Art Beats. Venez vibrer au rythme de l\u2019art belge.","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.540717"}},"place":{"id":266601,"translations":{"fr":{"name":"Belfius Art Gallery","address_street_name":"Place Charles Rogier","address_street_number":null,"address_street_box":null,"email":"artcollection@belfius.be","website":"http:\/\/www.belfius-art-collection.be","phone_contact":null,"phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Place Charles Rogier","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"La collection Belfius est la plus grande collection d\u2019art belge du pays. La collection compte plus de 4 300 \u0153uvres d\u2019art et r\u00e9sulte de la fusion des collections du Cr\u00e9dit communal de Belgique, de Paribas Banque Belgique et de BACOB Banque.\r\n\r\nApr\u00e8s la Deuxi\u00e8me Guerre Mondiale, tant le Cr\u00e9dit communal que Paribas Belgique ont commenc\u00e9 \u00e0 acqu\u00e9rir des \u0153uvres de grande valeur li\u00e9es \u00e0 l\u2019h\u00e9ritage national belge, afin d\u2019\u00e9viter qu\u2019elles ne disparaissent \u00e0 l\u2019\u00e9tranger. D\u00e8s le d\u00e9but, le Cr\u00e9dit communal a mis l\u2019accent sur l\u2019art belge \u00e0 partir de 1860, tandis que Paribas se concentrait principalement sur des \u0153uvres du 16e au 18e si\u00e8cle et sur l\u2019art contemporain. BACOB banque a commenc\u00e9 sa collection en 1980 et s\u2019est exclusivement consacr\u00e9e \u00e0 l\u2019art contemporain belge. Aujourd\u2019hui, la collection couvre pr\u00e8s de cinq si\u00e8cles.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Belfius Art Gallery","address_street_name":"Charles Rogierplein","address_street_number":null,"address_street_box":null,"email":"artcollection@belfius.be","website":"http:\/\/www.belfius-art-collection.be","phone_contact":null,"phone_booking":null,"address_zip":"1210","address_city":"Sint-Joost-Ten-Node","address_line1":"Charles Rogierplein","address_line2":"1210 Sint-Joost-Ten-Node","description_web":"De Belfius-kunstcollectie is de grootste verzameling van Belgische kunst van het land en omvat meer dan 4300 werken, het gevolg van de samensmelting van de kunstverzamelingen van het Gemeentekrediet, Paribas Bank Belgi\u00eb en BACOB Bank.\r\n\r\nZowel het Gemeentekrediet als Paribas Belgi\u00eb begonnen na de Tweede Wereldoorlog met het verzamelen van waardevolle kunstwerken uit het nationaal erfgoed om te vermijden dat ze naar het buitenland verdwenen. Het Gemeentekrediet legde van in het begin het accent op Belgische kunst vanaf 1860, terwijl Paribas Belgi\u00eb kunst uit de 16de tot de 18de eeuw en moderne kunst kocht. BACOB bank begon zijn verzameling in 1980 en legde zich uitsluitend toe op Belgische hedendaagse kunst. Vandaag bestrijkt de collectie werken uit bijna vijf eeuwen.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Belfius Art Gallery","address_street_name":"Place Charles Rogier","address_street_number":null,"address_street_box":null,"email":"artcollection@belfius.be","website":"http:\/\/www.belfius-art-collection.be","phone_contact":null,"phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Place Charles Rogier","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Belfius Art Gallery","address_street_name":"Place Charles Rogier","address_street_number":null,"address_street_box":null,"email":"artcollection@belfius.be","website":"http:\/\/www.belfius-art-collection.be","phone_contact":null,"phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Place Charles Rogier","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Belfius Art Gallery","address_street_name":"Place Charles Rogier","address_street_number":null,"address_street_box":null,"email":"artcollection@belfius.be","website":"http:\/\/www.belfius-art-collection.be","phone_contact":null,"phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Place Charles Rogier","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Belfius Art Gallery","address_street_name":"Place Charl