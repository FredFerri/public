en":["fr","nl","ru"],"subtitles":[]},"translations":{"fr":{"name":"L'Ecole de sorciers","shortdescr":"Les apprentis sorciers et sorci\u00e8res sont invit\u00e9s \u00e0 venir profiter des animations et ateliers sp\u00e9ciaux pour Halloween.","longdescr":"Halloween \u00e0 la Ferme du Parc Maximelien pour les enfants\r\nUne \u00e9cole de sorciers\r\nLes apprentis sorciers et sorci\u00e8res sont invit\u00e9s \u00e0 venir profiter des animations et ateliers sp\u00e9ciaux pour Halloween.\r\nDiverses activit\u00e9s sont au programme.\r\nIls iront \u00e0 la rencontre des diff\u00e9rents professeurs.\r\nRendez-vous le 26 octobre \u00e0 14h\r\nC'est le moment d'avoir un look d'enfer !\r\nAttention, la participation est gratuite mais l'inscription est obligatoire.\r\nLes places sont limit\u00e9es.\r\nR\u00e9servez la v\u00f4tre d\u00e8s maintenant.\r\nIl est interdit d'utiliser la magie pour voler celle d'un autre.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.facebook.com\/events\/1186841225581994","email":"info@vzwdebron.com","phone_contact":"+32 474 07 95 35","phone_booking":"+32 474 07 95 35","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.544670"},"nl":{"name":"Tovenaarsschool","shortdescr":"De aankomende heksen en tovenaars worden uitgenodigd om te komen genieten van de speciale Halloween animaties en workshops.","longdescr":"Halloween op boerderij Maximelienpark voor kinderen\r\nEen school van heksen\r\nDe aankomende heksen en tovenaars worden uitgenodigd om te komen genieten van de speciale Halloween animaties en workshops.\r\nEr staan verschillende activiteiten op het programma.\r\nZe zullen de verschillende leraren ontmoeten.\r\nDatum: 26 oktober om 14.00 uur\r\nHet is tijd om er goed uit te zien!\r\nOpgelet, deelname is gratis maar registratie is vereist.\r\nDe plaatsen zijn beperkt.\r\nReserveer de jouwe nu.\r\nHet is verboden magie te gebruiken om die van iemand anders te stelen.","performers":null,"boxoffice_url":null