l}}},{"type":"poster","link":"https:\/\/agendabrussels.imgix.net\/29084f1c06d22323c36db1ea9341e6779e9d640f.jpg","width":3750,"height":1438,"ratio":2.61,"translations":{"fr":{"title":"March\u00e9 annuel d'Anderlecht - 2022","copyright":null},"nl":{"title":"March\u00e9 annuel d'Anderlecht - 2022","copyright":null},"en":{"title":"March\u00e9 annuel d'Anderlecht - 2022","copyright":null}}}],"dates":[{"day":"2022-09-13","doors":null,"start":"10:00:00","end":"22:00:00","is_soldout":false,"is_canceled":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[11,7,8,16,10,12,19,5,4,3,2],"translations":{"fr":["Famille","Jeunes 12-15 ans","Jeunes 15-18 ans","Ecoles","Seniors","LGTBQIA","Enseignants","Enfants 9-12 ans","Enfants 6-9 ans","Enfants 3-6 ans","Enfants 0-3 ans"],"nl":["Familie","Jongeren 12-15 j.","Jongeren 15-18 j.","Scholen","Senioren","LGTBQIA","Leerkrachten","Kinderen 9-12 j.","Kinderen 6-9 j.","Kinderen 3-6 j.","Kinderen 0-3 j."],"en":["Family","Youth 12-15  yr.","Youth 15-18  yr.","Schools","Seniors","LGTBQIA","Teachers","Children 9-12 yr.","Children 6-9 yr.","Children 3-6 yr.","Children 0-3 yr."]}},"tags":["kids"],"accessibilities":{"list":[255,259,263,265],"translations":{"fr":["Accessible","Chien d'assistance","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9"],"nl":["Toegankelijk","Assistentiehonden","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet"],"en":["Accessible","Assistance dogs","Accessible to pedestrians with mobility aids","Adapted toilet"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-09-08T16:05:09+02:00","published_at":"2022-09-08T15:19:24+02:00","backoffice_id":261371,"import_origin":null,"sub_type":"brocante","show_in_agenda":true,"ranking":1},{"id":538731,"date_start":"2022-09-13","date_end":"2022-09-13","date_next":"2022-09-13","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert"}},"others":{"list":[4,6],"translations":{"fr":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"],"nl":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"],"en":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"]}}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Ik en den Theo \/Moi et le Th\u00e9o en concert au March\u00e9 annuel d'Anderlecht","shortdescr":null,"longdescr":"Avec Moi et le Th\u00e9o\/Ik en den Theo vous (re) d\u00e9couvrez le monde \u00e0 travers les yeux des petits. Enfants, parents et grands-parents marchent comme des robots, jouent \u00e0 la chaise musicale, re\u00e7oivent un souffle \u00e9nergique de l\u2019oncle Jazz, jouent de l\u2019air guitar et m\u00eame plus. Bref, ils explorent les limites ext\u00e9rieures de leur fantaisie.\r\n\r\nEn fonction de la composition du public, Moi et le Th\u00e9o\/Ik en den Theo chantent en fran\u00e7ais, en n\u00e9erlandais ou, dans le meilleur des mondes, en deux langues.\r\n\r\nPiet Maris et Theophane Raballand (tous les deux de Jaune Toujours) font leur truc \u00e0 l\u2019accord\u00e9on, \u00e0 la batterie et aux percussions, mais surtout\u2026 avec le public, qui est sans cesse invit\u00e9 \u00e0 danser, \u00e0 chanter, \u00e0 sauter et \u00e0 imaginer.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.538731"},"nl":{"name":"Ik en den Theo \/Moi et le Th\u00e9o in concert op de jaarmarkt in Anderlecht","shortdescr":null,"longdescr":"Bij Ik en den Theo \/ Moi et le Th\u00e9o (her)bekijk je de wereld door kinderogen. Kinderen, ouders en grootouders kunnen rondlopen als robots, stoelendansen, bezoek krijgen van nonkel Jazz, luchtgitaar spelen en nog veel meer... Kortom, ze verkennen de uiterste grenzen van hun fantasie.\r\n\r\nAfhankelijk van de samenstelling van het publiek zingen Ik en den Theo\/Moi et le Th\u00e9o in het Nederlands of in het Frans of, in de beste van alle werelden, in beide talen.\r\n\r\nPiet Maris en Theophane Raballand (allebei van Jaune Toujours) doen hun ding op accordeon en slagwerk ... en met het publiek, dat voortdurend wordt uitgedaagd om mee te zingen, dansen, springen en fantaseren.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.538731"},"en":{"name":"Ik en den Theo \/Moi et le Th\u00e9o in concert at the Annual Market in Anderlecht","shortdescr":null,"longdescr":"Ik en den Theo\/Moi et le Th\u00e9o look at the world through children's eyes. Piet Maris and Theophane Raballand ( both of Jaune Toujours) do their thing on accordion and drums... and with the audience. Depending on its composition Ik en den Theo\/Moi et le Th\u00e9o sing in Dutch or French, or in the best of worlds in both languages.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.538731"},"de":{"name":"Ik en den Theo \/Moi et le Th\u00e9o en concert au March\u00e9 annuel d'Anderlecht","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.538731"},"it":{"name":"Ik en den Theo \/Moi et le Th\u00e9o en concert au March\u00e9 annuel d'Anderlecht","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/ev