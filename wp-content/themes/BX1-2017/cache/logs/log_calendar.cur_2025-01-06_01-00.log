tart":"2025-01-14","date_end":"2025-01-25","date_next":"2025-01-14","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-09-27T19:52:27+02:00","published_at":"2024-07-01T14:01:52+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":303286,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"theatre","ranking":0.5503212081491045,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":49,"translations":{"de":"Theater","pt":null,"en":"Theatre","it":"Teatro","cn":null,"fr":"Th\u00e9\u00e2tre","sp":"Teatro","nl":"Theater"}},"others":{}},"translations":{"de":{"name":"Harriet Tubman - passeuse de l'ombre","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.oceannord.org\/2024\/harriet-tubman-passeuse-de-lombre\/","email":"billetterie@oceannord.org","phone_contact":"+32 2 242 96 89","phone_booking":"+32 2 216 75 55","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50012054"},"pt":{"name":"Harriet Tubman - passeuse de l'ombre","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.oceannord.org\/2024\/harriet-tubman-passeuse-de-lombre\/","email":"billetterie@oceannord.org","phone_contact":"+32 2 242 96 89","phone_booking":"+32 2 216 75 55","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50012054"},"en":{"name":"Harriet Tubman - passeuse de l'ombre","shortdescr":"Harriet Tubman, est une ancienne esclave dans le Maryland au sud des \u00c9tats-Unis. Elle r\u00e9ussit \u00e0 s\u2019\u00e9chapper de ses ma\u00eetres une nuit, gr\u00e2ce \u00e0 une intelligence et une t\u00e9nacit\u00e9 hors du commun, pour rejoindre le nord abolitionniste. ","longdescr":"Harriet Tubman, est une ancienne esclave dans le Maryland au sud des \u00c9tats-Unis. Elle r\u00e9ussit \u00e0 s\u2019\u00e9chapper de ses ma\u00eetres une nuit, gr\u00e2ce \u00e0 une intelligence et une t\u00e9nacit\u00e9 hors du commun, pour rejoindre le nord abolitionniste. Une fois install\u00e9e en Pennsylvanie, elle retourne plusieurs fois dans le Sud pour lib\u00e9rer sa famille et des centaines d\u2019autres esclaves avant de s\u2019engager dans l\u2019arm\u00e9e pendant la guerre de s\u00e9cession au \u00c9tats-Unis comme cuisini\u00e8re. Ensuite, elle travaille comme \u00e9claireuse, espionne et infirmi\u00e8re pour les forces de l\u2019union. Elle fut la premi\u00e8re femme \u00e0 diriger une exp\u00e9dition militaire \u00e0 bord de trois bateaux \u00e0 vapeur qui permit de lib\u00e9rer en une nuit, 750 esclaves en Caroline du sud.\n\nEn 1865, \u00e0 la fin de la guerre de s\u00e9cession, l\u2019esclavage a \u00e9t\u00e9 aboli aux \u00c9tats-Unis, c\u00e9dant la place \u00e0 un r\u00e9gime s\u00e9gr\u00e9gationniste qui a officiellement dur\u00e9 jusqu\u2019\u00e0 la fin du XXe si\u00e8cle. Harriet Tubman a ensuite dirig\u00e9 son combat vers la promotion des droits des femmes et la lutte contre le racisme syst\u00e9mique. \n\nAvec d\u2019autres femmes, elles r\u00e9ussissent \u00e0 obtenir le droit de vote pour les femmes, inaugurant ainsi une succession de droits en faveur de l\u2019\u00e9mancipation f\u00e9minine aux \u00c9tats-Unis.\n\nSon combat, accompli dans l\u2019ombre, doit aujourd\u2019hui \u00eatre mis en lumi\u00e8re, car son histoire est une source d\u2019inspiration face aux multiples d\u00e9fis que l\u2019avenir dresse \u00e0 nos soci\u00e9t\u00e9s et \u00e0 sa jeunesse.\n\nSur sc\u00e8ne, Edoxi Gnoula rend hommage \u00e0 cette h\u00e9ro\u00efne effac\u00e9e des pages de notre m\u00e9moire. Un monologue d\u2019une urgente n\u00e9cessit\u00e9 qui nous rappelle que le th\u00e9\u00e2tre est un art vivant et le lieu o\u00f9 l\u2019on convoque les morts pour qu\u2019ils nous montrent le chemin, et nous donnent la cl\u00e9 des portes de l\u2019humanit\u00e9.","performers":"Texte Penda Diouf  Mise en sc\u00e8ne Fran\u00e7ois Ebouele Avec Edoxi Lionelle Gnoula, Dominique Larose Dramaturgie Jean-Bastien Tinant Cr\u00e9ation Lumi\u00e8re Simon Renquin Cr\u00e9ation Vid\u00e9o Lionel Ravira Cr\u00e9ation Sonore Hubert Monroy Sc\u00e9nographie Sophie Carlier Chor\u00e9graphie Hippolyte Bohouo Assistante \u00e0 la mise en sc\u00e8ne Maxe Doutrelepont","boxoffice_url":null,"website":"https:\/\/www.oceannord.org\/2024\/harriet-tubman-passeuse-de-lombre\/","email":"billetterie@oceannord.org","phone_contact":"+32 2 242 96 89","phone_booking":"+32 2 216 75 55","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50012054"},"it":{"name":"Harriet Tubman - passeuse de l'ombre","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.oceannord.org\/2024\/harriet-tubman-passeuse-de-lombre\/","email":"billetterie@oceannord.org","phone_contact":"+32 2 242 96 89","phone_booking":"+32 2 216 75 55","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50012054"},"cn":{"name":"Harriet Tubman - passeuse de l'ombre","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.oceannord.org\/2024\/harriet-tubman-passeuse-de-lombre\/","email":"billetterie@oceannord.org","phone_contact":"+32 2 242 96 89","phone_booking":"+32 2 216 75 55","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50012054"},"fr":{"name":"Harriet Tubman - passeuse de l'ombre","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.oceannord.org\/2024\/harriet-tubman-passeuse-de-lombre\/","email":"billetterie@oceannord.org","phone_contact":"+32 2 2