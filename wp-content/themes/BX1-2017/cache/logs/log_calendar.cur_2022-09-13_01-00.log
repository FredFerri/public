ype":"photo","link":"https:\/\/agendabrussels.imgix.net\/219969ff2e8903189b98ee9028567588ff41c43c.jpg","width":2811,"height":3578,"ratio":0.79,"translations":{"fr":{"title":"Contemporary Design Market","copyright":null},"nl":{"title":"Contemporary Design Market","copyright":null},"en":{"title":"Contemporary Design Market","copyright":null}}},{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/e21552ec02091521b1935e00a994ee9be6d784b7.jpg","width":3605,"height":5407,"ratio":0.67,"translations":{"fr":{"title":"Contemporary Design Market","copyright":null},"nl":{"title":"Contemporary Design Market","copyright":null},"en":{"title":"Contemporary Design Market","copyright":null}}},{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/3d537c0d868beab994644ec05760c1816aa47b04.jpg","width":6000,"height":4000,"ratio":1.5,"translations":{"fr":{"title":"Contemporary Design Market","copyright":null},"nl":{"title":"Contemporary Design Market","copyright":null},"en":{"title":"Contemporary Design Market","copyright":null}}},{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/4e5e060224c500a539a5d53ff92ecf2502182cbc.jpg","width":5155,"height":7728,"ratio":0.67,"translations":{"fr":{"title":"Contemporary Design Market","copyright":null},"nl":{"title":"Contemporary Design Market","copyright":null},"en":{"title":"Contemporary Design Market","copyright":null}}}],"dates":[{"day":"2022-09-24","doors":"10:00:00","start":"10:00:00","end":"18:00:00","is_soldout":false,"is_canceled":false},{"day":"2022-09-25","doors":"10:00:00","start":"10:00:00","end":"17:00:00","is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":10}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":["major_event"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-09-09T16:05:10+02:00","published_at":"2022-08-19T10:20:04+02:00","backoffice_id":259992,"import_origin":null,"sub_type":"foire","show_in_agenda":true,"ranking":1},{"id":539407,"date_start":"2022-09-24","date_end":"2022-09-24","date_next":"2022-09-24","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{"list":[112],"translations":{"fr":["Insolite"],"nl":["Ongewoon"],"en":["Unusual"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Pr\u00e9misses et naissance du cin\u00e9matographe","shortdescr":"Depuis 1896, Bruxelles a compt\u00e9 environ deux cent cinquante lieux de cin\u00e9mas pour quatre cent quarante-six enseignes diff\u00e9rentes. Cette visite se consacrera aux balbutiements du cin\u00e9matographe \u00e0 Bruxelles.","longdescr":"Depuis 1896, Bruxelles a compt\u00e9 environ deux cent cinquante lieux de cin\u00e9mas pour quatre cent quarante-six enseignes diff\u00e9rentes. L'histoire de ces salles constitue un sujet extr\u00eamement riche qui permet de croiser une vari\u00e9t\u00e9 de regards : architectural, urbanistique, sociologique, technique et esth\u00e9tique notamment sur l\u2019espace urbain et sur le cin\u00e9ma lui-m\u00eame. Ce cycle de visites vous invite \u00e0 embrasser ces points de vue multiples en \u00e9voquant et en visitant ces lieux.\r\n\r\nCette visite se consacrera aux balbutiements du cin\u00e9matographe \u00e0 Bruxelles. Apr\u00e8s la vogue des panoramas, la premi\u00e8re projection publique belge le 1er mars 1896 remporte un \u00e9norme succ\u00e8s. D\u00e8s lors, la fi\u00e8vre du cin\u00e9matographe s\u2019empare de Bruxelles. Les projections s\u2019improvisent dans les lieux les plus vari\u00e9s : caf\u00e9, music-hall, th\u00e9\u00e2tre. Anciens lieux d'o\u00f9 rena\u00eetront le cin\u00e9ma Nova, par exemple. La premi\u00e8re v\u00e9ritable salle construite pour montrer des films de cin\u00e9ma \u00e0 cet effet sera le Th\u00e9\u00e2tre du cin\u00e9matographe en 1905. L'architecte Paul Hamesse, sp\u00e9cialiste des salles de cin\u00e9ma et de th\u00e9\u00e2tre, cr\u00e9e le Path\u00e9-Palace en 1913. C\u2019est le premier \u00ab temple \u00bb cin\u00e9matographique bruxellois, con\u00e7u pour attirer un public bourgeois.","performers":"La visite est men\u00e9e par Isabel Biver, historienne du cin\u00e9ma et guide-conf\u00e9renci\u00e8re sur les sujets tels que le spectacle cin\u00e9matographique, les arts et l'architecture. Elle enseigne aussi le patrimoine, la communication et les techniques de guidage et anime des activit\u00e9s d'\u00e9ducation \u00e0 la citoyennet\u00e9.","boxoffice_url":null,"website":"https:\/\/www.maisoncfc.be\/fr\/agenda\/1226-premisses-et-naissance-du-cinematographe","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.539407"},"nl":{"name":"Pr\u00e9misses et naissance du cin\u00e9matographe","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.539407"},"en":{"name":"Pr\u00e9misses et naissance du cin\u00e9matographe","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.539407"},"de":{"name":"Visite guid\u00e9e: Pr\u00e9misses et naissance du cin\u00e9matographe","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visi