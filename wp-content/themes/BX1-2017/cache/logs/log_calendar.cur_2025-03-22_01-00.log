nly_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2025-03-21T01:01:29+01:00","published_at":"2025-02-04T15:39:42+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":317522,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"tour","ranking":0.2936303671325454,"languages":{"spoken":["nl","fr"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{"list":[255],"translations":{"de":["Besuche von Ausstellungen"],"pt":[null],"en":["Exhibition guided tours"],"it":["Visite a esposizioni"],"cn":[null],"fr":["Visites d'expositions"],"sp":["Visitas a las exposiciones"],"nl":["Tentoonstelling"]}}},"translations":{"de":{"name":"Visites guid\u00e9es avec ou sans ateliers cr\u00e9atifs","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lamaisondesarts.be\/terrain-de-jeux\/","email":"info@lamaisondesarts.be","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 99","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700006192"},"pt":{"name":"Visites guid\u00e9es avec ou sans ateliers cr\u00e9atifs","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lamaisondesarts.be\/terrain-de-jeux\/","email":"info@lamaisondesarts.be","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 99","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700006192"},"en":{"name":"Visites guid\u00e9es avec ou sans ateliers cr\u00e9atifs","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lamaisondesarts.be\/terrain-de-jeux\/","email":"info@lamaisondesarts.be","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 99","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700006192"},"it":{"name":"Visites guid\u00e9es avec ou sans ateliers cr\u00e9atifs","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lamaisondesarts.be\/terrain-de-jeux\/","email":"info@lamaisondesarts.be","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 99","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700006192"},"cn":{"name":"Visites guid\u00e9es avec ou sans ateliers cr\u00e9atifs","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lamaisondesarts.be\/terrain-de-jeux\/","email":"info@lamaisondesarts.be","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 99","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700006192"},"fr":{"name":"Visites guid\u00e9es avec ou sans ateliers cr\u00e9atifs","shortdescr":"Dans le cadre de l\u2019exposition Terrain de Jeux","longdescr":"\nUne visite guid\u00e9e de l\u2019exposition Terrain de Jeux pouvant \u00eatre suivie de l\u2019atelier de ton choix.\n\n \n\nVisites guid\u00e9es \nL\u2019expo Terrain de jeux pr\u00e9sente huit artistes qui utilisent le jeu au sens large comme un outil favorisant l\u2019\u00e9change, l\u2019interaction, la fantaisie, l\u2019imagination, la participation et la coop\u00e9ration. Ils pensent et travaillent ainsi les conditions du \u00ab vivre ensemble \u00bb. La visite vous permettra de les d\u00e9couvrir et d\u2019aiguiser votre \u0153il.\n\nObjectif p\u00e9dagogique:\nUne visite \u00e0 la Maison des Arts articule trois \u00e9l\u00e9ments : l\u2019apprentissage des codes du mus\u00e9e, l\u2019ouverture \u00e0 un nouvel univers et regarder les \u0153uvres d\u2019art contemporaines. Les visites sont adapt\u00e9es en fonction des caract\u00e9ristiques du groupe et de l\u2019exp\u00e9rience des visiteurs.\nL\u2019objectif de la visite est d\u2019acqu\u00e9rir des outils et d\u2019aiguiser son regard.\n\nAteliers cr\u00e9atifs \nUn atelier au choix\n\nATELIER 1 | DESSINE-MOI UN MOT  (8 ans +)\n\nDessin, imagination \n\nLaisse des personnages, des fleurs, des objets prendre forme sous tes doigts.\nA partir d\u2019un mot inconnu, dessine ce qu\u2019il t\u2019\u00e9voque; en \u00e9coutant sa d\u00e9finition, fais un nouveau dessin. Lequel des deux est le plus r\u00e9ussi?\n\nObjectif p\u00e9dagogique : exp\u00e9rimenter, produire, cr\u00e9er, repr\u00e9senter le monde environnant ou donner forme \u00e0 son imaginaire.\nMat\u00e9riel : son imagination, un crayon, du papier.\n\nDur\u00e9e : 1 heure\n\n \n\nATELIER 2 | T\u00caTE D\u2019ARGILE (+4 ans)\n\nSculpture, modelage, imagination\n\nL\u2019argile est l\u2019un des plus anciens mat\u00e9riaux utilis\u00e9s par l\u2019homme. On la trouve dans la nature. Elle a \u00e9t\u00e9 utilis\u00e9e pour fabriquer des objets et aussi des sculptures, et c\u2019est toujours le cas aujourd\u2019hui. C\u2019est parfois simplement en manipulant la mati\u00e8re qu\u2019on arrive \u00e0 cr\u00e9er. A ton tour d\u2019essayer !\n\nObjectif : exp\u00e9rimenter, produire, cr\u00e9er, jouer avec la mati\u00e8re, donner forme \u00e0 son imaginaire.\nMat\u00e9riel : argile\n\nDur\u00e9e : 1 heure\n\n \n\nINFOS PRATIQUES\nR\u00e9servation obligatoire\n\nPour r\u00e9server, merci d\u2019envoyer un mail \u00e0 cperetti@1030.be avec les informations suivantes :\n\nNom du groupe\nLangue de la visite\nGsm\nDate + heure souhait\u00e9e (du mardi au vendredi entre 9h et 16h)\nNombre d\u2019enfants \/ usagers\nActivit\u00e9 souhait\u00e9e : visite simple (1h), visite + atelier (2h) \u2013 pr\u00e9ciser l\u2019atelier\n \n\nEcoles & groupes \u00e0 vis\u00e9e p\u00e9dagogique\tGroupes priv\u00e9s\nQuand?\tDu mardi au vendredi de 9h \u00e0 16h\tDu mardi au vendredi de 9h \u00e0 16h\nLe week-end de 11h \u00e0 17h\nQuoi?\t1 visite guid\u00e9e avec\/sans atelier cr\u00e9atif au choix : atelier 1 ou atelier 2\nL\u2019entr\u00e9e dans l\u2019exposition est gratuite\t1 visite guid\u00e9e avec\/sans atelier cr\u00e9atif au choix : atelier 1  ou atelier 2\nL\u2019entr\u00e9e dans l\u2019exposition est gratuite\nR\u00e9servations\t3 semaines \u00e0 l\u2019avance\t3 semaines \u00e0 l\u2019avance\nAnnulation\tDans un d\u00e9lai de 15 jours avant la date r\u00e9serv\u00e9e sinon la facture sera due\tDans un d\u00e9lai de 15 jours avant la date r\u00e9serv\u00e9e sinon la facture sera due\nNombre de personnes\t\u2013 Min : 10\n\u2013 Max : 20\t\u2013 Min : 5\n\u2013 Max : 20\nLangue\tFR\/NL\tFR\/NL\nTarif\tGroupe scolaire: Gratuit\nGroupe \u00e0 vis\u00e9e p\u00e9dagogique:\n> Visite : 2\u20ac par personne\n> Visite + atelier : 3\u20ac par personne\nArticle 27 accept\u00e9s\tEn semaine : Visite 80\u20ac \/ visite + atelier 100\u20ac\nLe weekend : Visite 100\u20ac \/ visite + atelier 135\u20ac\n\n","performers":null,"boxoffice_url":null,"website":"https:\/\/lamaisondesarts.be\/terrain-de-jeux\/","email":"info@lamaisondesarts.be","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 99","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700006192"},"sp":{"name":"Visites guid\u00e9es avec ou sans ateliers cr\u00e9atifs","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lamaisondesarts.be\/terrain-de-jeux\/","email":"info@lamaisondesarts.be","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 99","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700006192"},"nl":{"name":"Rondleidingen & creatieve workshops","shortdescr":"In het kader van de tentoonstelling Speelterrein","longdescr":"\nEen rondleiding van de tentoonstelling Speelterrein die kan worden gevolgd door de workshop van je keuze\n\n \n\nRONDLEIDINGEN \nDe tentoonstelling Speelterrein laat ons kennismaken met acht kunstenaars die het spel in de breedste zin van het woord gebruiken als instrument om uitwisseling, interactie, fantasie, verbeelding, participatie en samenwerking te stimuleren. Op die manier onderzoeken en bewerken ze de voorwaarden voor \u2018samenleven\u2019. De rondleiding geeft je de kans om ze te ontdekken en je blik te verscherpen.\n\nPedagogisch doel\nEen bezoek aan La Maison des Arts bestaat uit drie elementen: de codes van het museum leren kennen, je openstellen voor een nieuwe wereld en kijken naar hedendaagse kunstwerken, aangepast aan de bijzonderheden van de groep en de ervaring van de bezoekers.\nHet is de bedoeling om stukje bij beetje interpretatietools aan te leren en je blik te verscherpen.\n\n \n\nCREATIEVE WORKSHOPS\nEen workshop van jouw keuze\n\nWORKSHOP 1 | TEKEN EEN WOORD 8 jaar +\n\nTekenen, verbeelding \n\nLaat op het papier figuurtjes, bloemen en voorwerpen tot leven komen.\nTeken op basis van een onbekend woord wat er in je opkomt. Luister dan naar de definitie ervan en maak een nieuwe tekening. Welke tekening vind jij het meest geslaagd?\n\nPedagogische doel: Experimenteren, produceren, cre\u00ebren \u2013 de wereld rondom je uitbeelden of vorm geven aan je verbeelding\n\nMateriaal: je verbeelding, een potlood en papier.\nDuur: 1 uur\n\n \n\nWORKSHOP 2 | HOOFD VAN KLEI 4 jaar +\n\nBeeldhouwen, boetseren, verbeelding\n\nKlei is een van de oudste materialen die de mens gebruikt. Je vindt het in de natuur. We gebruiken het al vele eeuwen om voorwerpen en beeldjes te maken, en dat doen we nu nog steeds. Soms kun je pas iets cre\u00ebren door het materiaal te \u2018kneden\u2019. En nu is het aan jou!\n\nBedoeling: experimenteren, maken, cre\u00ebren \u2013   spelen met materie \u2013 je fantasie omzetten in een vorm\nMateriaal: klei\nDuur: 1 uur\n\nINFO\nReservatie verplicht\n\nOm te reserveren, stuur een e-mail naar cperetti@1030.be met de volgende informatie :\n\n\u2013 Naam van de groep\n\u2013 Taal\n\u2013 Gsm\n\u2013 Datum + gewenste tijd\n\u2013 Aantal kinderen \/ volwassenen\n\u2013 Gewenste activiteit: Rondleiding (1u), rondleiding + creatieve workshop (2u)\n\n \n \n\nScholen & groepen met een pedagogisch doel\tPriv\u00e9groepen\nWanneer?\tDinsdag tot vrijdag van 9u tot 16u\tDinsdag tot vrijdag van 9u tot 16u\nWeekends van 11u tot 17u\nWat?\t1 rondleiding met\/zonder een creatieve workshop naar keuze: workshop 1 (kleuren) of workshop 2 (schaduwen)\nDe toegang tot de tentoonstelling is gratis\n\n1 rondleiding met\/zonder een creatieve workshop naar keuze: workshop 1 (kleuren) of workshop 2 (schaduwen)\nDe toegang tot de tentoonstelling is gratis\n\nReservatie\t3 weken op voorhand\t3 weken op voorhand\nAnnulatie\tBinnen 15 dagen voor de geboekte datum, anders is de factuur verschuldigd\tBinnen 15 dagen voor de geboekte datum, anders is de factuur verschuldigd\nAantal personen\t\u2013 Min : 10\n\u2013 Max : 20\t\u2013 Min : 5\n\u2013 Max : 20\nTaal\tFR\/NL\tFR\/NL\nTarief\tSchool groep: Gratis\nGroep met een pedagogisch doel:\n> Bezoek : 2\u20ac per persoon\n> Bezoek + workshop : 3\u20ac per persoon\nArticle 27\tWeekdagen : Bezoek 80\u20ac \/ Bezoek + workshop 100\u20ac\nWeekend : Bezoek 100\u20ac \/ Bezoek + workshop 135\u20ac\n ","performers":null,"boxoffice_url":null,"website":"https:\/\/lamaisondesarts.be\/terrain-de-jeux\/","email":"info@lamaisondesarts.be","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 99","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700006192"}},"place":{"id":222932,"translations":{"de":{"name":"Maison des Arts","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 147","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Maison des Arts","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 147","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Maison des Arts","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 147","address_line2":"1030 Schaerbeek","description_web":"The MdA is run and staffed by the Francophone Cultural Service of Schaerbeek Council and is a unique place whose activities are mainly concerned with the creation of works of contemporary art with a significant partnership programme that promotes access for all to contemporary art.\r\n\r\nThe MdA has hosted a rich programme of artistic activities since the 1950s when the building was purchased by Schaerbeek Council. In 2005, the MdA began a programme of inviting artists to work in building, to build more coherence between their works of art and the MdA.\r\n\r\nMost recently, in 2016, Schaerbeek Council decided to position the MdA as a centre for the creation, diffusion and promotion of culture, contemporary two-dimensional, three-dimensional and digital art.\r\nThe MdA\u2019s educational and social approach aims to promoting equality of access to art and its introduction to new audiences.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Maison des Arts","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 147","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Maison des Arts","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 147","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Maison des Arts","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 147","address_line2":"1030 Schaerbeek","description_web":"La Maison des Arts, anim\u00e9e par le Service Culture fran\u00e7aise de la Commune de Schaerbeek, est un espace singulier dont les activit\u00e9s sont principalement ax\u00e9es sur la cr\u00e9ation contemporaine dans le domaine des arts plastiques avec un important programme de m\u00e9diation permettant l\u2019acc\u00e8s de l\u2019art contemporain \u00e0 tous.\r\n\r\nLa MA conna\u00eet une riche activit\u00e9 artistique depuis les ann\u00e9es \u201950, \u00e9poque \u00e0 laquelle la commune rach\u00e8te le b\u00e2timent. En 2005, elle se voit prendre un premier tournant en proposant aux artistes de travailler in situ, afin d\u2019\u00e9tablir une r\u00e9elle coh\u00e9rence entre l\u2019\u0153uvre et la Maison.\r\nEt finalement, c\u2019est en 2016 que la Commune de Schaerbeek d\u00e9cide de la positionner dans le domaine des arts plastiques, contemporains et num\u00e9riques comme un lieu de cr\u00e9ation, de diffusion et de rayonnement culturel.\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Maison des Arts","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 147","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Huis der Kunsten","address_street_name":"Haachtsesteenweg","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaarbeek","address_line1":"Haachtsesteenweg, 147","address_line2":"1030 Schaarbeek","description_web":"La Maison des Arts, geanimeerd door de dienst Franstalige Cultuur van de gemeente Schaarbeek, is een heel bijzondere plek. De activiteiten zijn vooral gericht op hedendaagse creativiteit in de plastische kunsten.\r\n\r\nIn La Maison des Arts heerst reeds sedert 1950 ( datum waarop de gemeente het huis aankocht) een ruime artistieke activiteit. In 2005 is er een belangrijke ontwikkeling : het voorstel aan de kunstenaars om ter plaatse te werken, teneinde een echte samenhang te bereiken tussen het werk en het Huis. Uiteindelijk beslist de Gemeente Schaarbeek er een echte broeikast van te maken in het domein van de beeldende kunsten, een bron van schepping, verspreiding en culturele uitstraling.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[20],"translations":{"de":["Norden"],"pt":[null],"en":["North"],"it":["Nord"],"cn":[null],"fr":["Nord"],"sp":["Norte"],"nl":["Noord"]}},"neca":null,"facebook_id":null,"backoffice_id":663,"location":{"lat":50.85951067,"lon":4.37063079},"region":"brussels","last_updated_at":"2022-11-09T13:59:40+01:00","published_at":"2013-10-19T01:13:42+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":222932,"translations":{"de":{"name":"Maison des Arts","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 147","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Maison des Arts","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 147","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"bookin