se,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":302181,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.19714987048647406,"languages":{"spoken":["de","nl","en","fr"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[46,36],"translations":{"de":["Multidisziplin\u00e4r","Museen & Kunstzentren"],"pt":[null,null],"en":["Multidisciplinary","Museums and art centers"],"it":["Multidisciplinare","Musei e centri artistici"],"cn":[null,null],"fr":["Pluridisciplinaire","Mus\u00e9es et art centers"],"sp":["Multidisciplinar","Museos y centros de arte"],"nl":["Multidisciplinair","Musea en kunstcentra"]}}},"translations":{"de":{"name":"Bellum & Artes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/historia.europa.eu\/fr\/expositions-et-evenements\/expositions-temporaires\/bellum-artes","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50011568"},"pt":{"name":"Bellum & Artes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/historia.europa.eu\/fr\/expositions-et-evenements\/expositions-temporaires\/bellum-artes","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50011568"},"en":{"name":"Bellum & Artes","shortdescr":"Bellum & Artes centres on the role of arts during the Thirty Years\u2019 War (1618\u20131648). The exhibition unravels the complex interplay between conflict and artistic expression. ","longdescr":"Bellum et Artes explores an early large-scale conflict in Europe through the warring parties\u2019 strategic employment of the arts as a military propaganda tool and to accentuate their power. It goes on to demonstrate the impact of works of art as \u2018ambassadors of peace\u2019. The migration of artists and the displacement of artistic treasures during this period are subjects which can be analysed through interactive media stations. Furthermore, Bellum et Artes delves into the struggle for peace, illuminating political schemes and the genesis of legal and political principles that continue to have relevance today. ","performers":null,"boxoffice_url":null,"website":"https:\/\/historia.europa.eu\/en\/exhibitions-and-events\/temporary-exhibitions\/bellum-artes","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50011568"},"it":{"name":"Bellum & Artes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/historia.europa.eu\/fr\/expositions-et-evenements\/expositions-temporaires\/bellum-artes","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50011568"},"cn":{"name":"Bellum & Artes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/historia.europa.eu\/fr\/expositions-et-evenements\/expositions-temporaires\/bellum-artes","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50011568"},"fr":{"name":"Bellum & Artes","shortdescr":"Bellum & Artes se concentre sur le r\u00f4le des arts pendant la guerre de Trente Ans (1618-1648). L'exposition met en lumi\u00e8re l'interaction complexe entre le conflit et l'expression artistique. ","longdescr":"Bellum & Artes explore un des premiers conflits \u00e0 grande \u00e9chelle en Europe \u00e0 travers l\u2019utilisation strat\u00e9gique des arts par les parties adversaires comme outil de propagande militaire et pour accentuer leur pouvoir. Il d\u00e9montre ensuite l\u2019impact des \u0153uvres d\u2019art en tant qu\u2019\u00ab ambassadeurs de la paix \u00bb. La migration des artistes et le d\u00e9placement des tr\u00e9sors artistiques au cours de cette p\u00e9riode sont des sujets qui peuvent \u00eatre analys\u00e9s \u00e0 travers des stations m\u00e9diatiques interactives.","performers":null,"boxoffice_url":null,"website":"https:\/\/historia.europa.eu\/fr\/expositions-et-evenements\/expositions-temporaires\/bellum-artes","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50011568"},"sp":{"name":"Bellum & Artes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/historia.europa.eu\/fr\/expositions-et-evenements\/expositions-temporaires\/bellum-artes","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50011568"},"nl":{"name":"Bellum & Artes","shortdescr":"In Bellum & Artes staat de rol van kunst tijdens de Dertigjarige Oorlog (1618-1648) centraal. De tentoonstelling ontrafelt de complexe wisselwerking tussen conflict en artistieke expressie. ","longdescr":"Bellum et Artes verkent een vroeg grootschalig conflict in Europa aan de hand van het strategische gebruik van kunst door de strijdende partijen als militair propagandamiddel en om hun macht te benadrukken. Daarnaasttoont de tentoonstelling ook de impact van kunstwerken als \"ambassadeurs van de vrede\". In de interactieve elementen van de tentoonstelling wordt er dieper ingegaan op de migratie van kunstenaars en de verplaatsing van kunstschatten tijdens deze periode.","performers":null,"boxoffice_url":null,"website":"https:\/\/historia.europa.eu\/nl\/tentoonstellingen-en-evenementen\/tijdelijke-tentoonstellingen\/bellum-artes","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50011568"}},"place":{"id":267078,"translations":{"de":{"name":"Haus der Europ\u00e4ischen Geschichte","address_street_name":"Rue Belliard","address_street_number":"135","address_street_box":null,"email":"historia-learning@europarl.europa.eu","website":"https:\/\/historia-europa.ep.eu\/fr\/welkom-het-huis-van-de-europese-geschiedenis","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Belliard, 135","address_line2":"1000 Bruxelles","description_web":"Das Haus der Europ\u00e4ischen Geschichte, das in dem pr\u00e4chtigen, frisch renovierten Eastman-Geb\u00e4ude untergebracht ist, zeichnet die europ\u00e4ische Geschichte und die Zukunft Europas anhand von unz\u00e4hligen Ausstellungsst\u00fccken aus den 28 Mitgliedstaaten der EU nach. Der Eintritt ist frei.\nIn den 24 Amtssprachen der Europ\u00e4ischen Union offenbart es die Geschichte Europas \u2013 von den europ\u00e4ischen Mythen und Entdeckungen, \u00fcber das Chaos und die Kriegswirren bis hin zur allm\u00e4hlichen Entwicklung eines Zugeh\u00f6rigkeitsgef\u00fchls im Laufe des 20. Jahrhunderts. Dabei wird der Besucher angeregt, die Dinge zu hinterfragen und sowohl die Vergangenheit als auch die Zukunft zu betrachten und zu analysieren. Das Haus der Europ\u00e4ischen Geschichte bietet speziell zugeschnittene Programme f\u00fcr Schulen, Familien und Gruppen. Der Eintritt ist frei.\n\nDauerausstellung: Die Dauerausstellung l\u00e4sst die gro\u00dfen Ereignisse der europ\u00e4ischen Geschichte Revue passieren und legt dabei zun\u00e4chst einen Schwerpunkt auf die im 19. Jahrhundert vorherrschenden Ideen und \u00dcberzeugungen. N\u00e4chster thematischer Schwerpunkt sind die zerst\u00f6rerischen Kriege, die Europa ersch\u00fctterten, bevor die Ausstellung sich schlie\u00dflich der europ\u00e4ischen Einigung zuwendet, die den Europ\u00e4ern eine friedlichere Zukunft sichern sollte. Das Museum regt die Besucher zum Nachdenken an \u2013 \u00fcber das heutige Europa und seine Rolle in der Welt und die M\u00f6glichkeit jedes einzelnen Europ\u00e4ers, die Zukunft des Kontinents mitzugestalten.\n\nP\u00e4dagogische Angebote und Fortbildungen: Das Haus der europ\u00e4ischen Geschichte hat eine Reihe von p\u00e4dagogischen Angeboten ausgearbeitet, die die Besichtigung zu einem echten Erlebnis machen: interaktive Pr\u00e4sentationen, Ausstellungsgegenst\u00e4nde, Multimedia-Guides, Ausstellungen, Workshops und Seminare, die den Besucher dazu anregen, seine bisherige Wahrnehmung der europ\u00e4ischen Geschichte und ihren Einfluss auf die heutige Welt zu hinterfragen.\n\nEin herausragendes Bauwerk: Das Eastman-Geb\u00e4ude, das sich im Schatten der B\u00e4ume des majest\u00e4tischen Parc L\u00e9opold erhebt, ist eine Perle des Art D\u00e9co. Hier war bis vor Kurzem noch eine Zahnklinik f\u00fcr sozial benachteiligte Kinder untergebracht, jetzt wurde das Bauwerk bis ins letzte Detail restauriert. Besonders sch\u00f6n sind dabei die Wandfresken in Anlehnung an die Fabeln von Jean de la Fontaine, die nun wieder in altem Glanz erstrahlen. Und nach der Besichtigung laden die Parkb\u00e4nke des Parc L\u00e9opold zum Picknicken und Verweilen ein. ","description_print":"Das Haus der Europ\u00e4ischen Geschichte, das in dem pr\u00e4chtigen, frisch renovierten Eastman-Geb\u00e4ude untergebracht ist, zeichnet die europ\u00e4ische Geschichte und die Zukunft Europas anhand von unz\u00e4hligen Ausstellungsst\u00fccken aus den 28 Mitgliedstaaten der EU nach. Der Eintritt ist frei.\r\nIn den 24 Amtssprachen der Europ\u00e4ischen Union offenbart es die Geschichte Europas \u2013 von den europ\u00e4ischen Mythen und Entdeckungen, \u00fcber das Chaos und die Kriegswirren bis hin zur allm\u00e4hlichen Entwicklung eines Zugeh\u00f6rigkeitsgef\u00fchls im Laufe des 20. Jahrhunderts. Dabei wird der Besucher angeregt, die Dinge zu hinterfragen und sowohl die Vergangenheit als auch die Zukunft zu betrachten und zu analysieren. Das Haus der Europ\u00e4ischen Geschichte bietet speziell zugeschnittene Programme f\u00fcr Schulen, Familien und Gruppen. Der Eintritt ist frei.\r\n\r\nDauerausstellung: Die Dauerausstellung l\u00e4sst die gro\u00dfen Ereignisse der europ\u00e4ischen Geschichte Revue passieren und legt dabei zun\u00e4chst einen Schwerpunkt auf die im 19. Jahrhundert vorherrschenden Ideen und \u00dcberzeugungen. N\u00e4chster thematischer Schwerpunkt sind die zerst\u00f6rerischen Kriege, die Europa ersch\u00fctterten, bevor die Ausstellung sich schlie\u00dflich der europ\u00e4ischen Einigung zuwendet, die den Europ\u00e4ern eine friedlichere Zukunft sichern sollte. Das Museum regt die Besucher zum Nachdenken an \u2013 \u00fcber das heutige Europa und seine Rolle in der Welt und die M\u00f6glichkeit jedes einzelnen Europ\u00e4ers, die Zukunft des Kontinents mitzugestalten.\r\n\r\nP\u00e4dagogische Angebote und Fortbildungen: Das Haus der europ\u00e4ischen Geschichte hat eine Reihe von p\u00e4dagogischen Angeboten ausgearbeitet, die die Besichtigung zu einem echten Erlebnis machen: interaktive Pr\u00e4sentationen, Ausstellungsgegenst\u00e4nde, Multimedia-Guides, Ausstellungen, Workshops und Seminare, die den Besucher dazu anregen, seine bisherige Wahrnehmung der europ\u00e4ischen Geschichte und ihren Einfluss auf die heutige Welt zu hinterfragen.\r\n\r\nEin herausragendes Bauwerk: Das Eastman-Geb\u00e4ude, das sich im Schatten der B\u00e4ume des majest\u00e4tischen Parc L\u00e9opold erhebt, ist eine Perle des Art D\u00e9co. Hier war bis vor Kurzem noch eine Zahnklinik f\u00fcr sozial benachteiligte Kinder untergebracht, jetzt wurde das Bauwerk bis ins letzte Detail restauriert. Besonders sch\u00f6n sind dabei die Wandfresken in Anlehnung an die Fabeln von Jean de la Fontaine, die nun wieder in altem Glanz erstrahlen. Und nach der Besichtigung laden die Parkb\u00e4nke des Parc L\u00e9opold zum Picknicken und Verweilen ein. \r\n\r\n","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Maison de l'Histoire europ\u00e9enne","address_street_name":"Rue Belliard","address_street_number":"135","address_street_box":null,"email":"historia-learning@europarl.europa.eu","website":"https:\/\/historia-europa.ep.eu\/fr\/welkom-het-huis-van-de-europese-geschiedenis","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Belliard, 135","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"House of European History","address_street_name":"Belliardstraat","address_street_number":"135","address_street_box":null,"email":"historia-learning@europarl.europa.eu","website":"https:\/\/historia-europa.ep.eu\/en\/welcome-house-european-history","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Belliardstraat, 135","address_line2":"1000 Brussels","description_web":"Get ready for a journey like no other! \nThe permanent exhibition begins with the myth of the goddess Europa, exploring Europe\u2019s ancient roots and the continent\u2019s heritage of shared traditions, before Europe\u2019s dramatic journey towards modernity in the 19th century and rebuilding process following World War II. \n\nA multimedia guide in 24 languages gives you new ways to interact with the exhibition, while special activities and Family Discovery Spaces allow children to grasp the story of Europe.  \n\nLocated next to the European Parliament in a striking Art Deco building in Parc L\u00e9opold, the House of European History is an essential part of any tour of the city.\n* Free\n* Available in 24 languages\n* Book online: See practical information\n\n","description_print":"This free museum in the beautifully renovated Eastman building presents an overview of European history and its possible future, thanks to hundreds of objects from all 28 EU member states. The museum recounts all of Europe\u2019s history, in each of the EU\u2019s 24 official languages, from the early European myths and discoveries, to the chaos followed by a growing feeling of unity and belonging of the 20th century. It also encourages visitors to think about, question and debate Europe\u2019s future. The House of European History provides visits perfectly tailored for schools, families and groups.\r\n\r\nThe permanent exhibition: The exhibition guides visitors through key moments of European history. First come the convictions and beliefs of the 19th century - when Europe reached \u2018modernity\u2019 - followed by a period of destruction and war, before the exhibition ends with Europe\u2019s search for a new life and an increasingly united continent. The museum hopes to get visitors to reflect on today\u2019s Europe and contemplate how each European can help to build the Europe of tomorrow.\r\n\r\nEducation and learning: The House of European History has developed various educational programmes that guarantee a memorable experience thanks to interactive equipment, original and replica objects, presentations, multimedia, teaching materials, workshops and seminars. They encourage visitors to question and debate Europe\u2019s history and its consequences for the world today.\r\n\r\nAn extraordinary location: The Eastman building \u2013 which was once a dental clinic for disadvantaged children - is an Art Deco gem. The building - which was meticulously restored \u2013 houses, among other things, some beautiful wall paintings depicting the stories of French author Jean de La Fontaine, and lies in the ten hectare Leopold park. It\u2019s the perfect place for a picnic or a relaxing break on a bench.\r\n\r\n","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Casa della storia Europea","address_street_name":"Rue Belliard","address_street_number":"135","address_street_box":null,"email":"historia-learning@europarl.europa.eu","website":"https:\/\/historia-europa.ep.eu\/fr\/welkom-het-huis-van-de-europese-geschiedenis","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Belliard, 135","address_line2":"1000 Bruxelles","description_web":"Questa mostra permanente vi guida attraverso momenti salienti della storia europea. Dalle convinzioni e credenze del XIX\u00b0 secolo - quando l\u2019Europa raggiunse la \u201cmodernit\u00e0\u201d - potrete seguire la storia attraverso la distruzione e la guerra, prima di vedere la ricerca per un\u2019esistenza nuova, pacifica e sempre pi\u00f9 all\u2019insegna dell\u2019unit\u00e0. Una guida multimediale vi offrir\u00e0 nuove modalit\u00e0 per interagire con la mostra, mentre attivit\u00e0 speciali consentono ai bambini di comprendere la storia d\u2019Europa.Un luogo straordinario per un museo straordinario: la palazzina Eastman - una volta clinica dentale per bambini disavvantaggiati - \u00e8 una gemma dell\u2019Art D\u00e9co. L\u2019edificio \u00e8 stato meticolosamente ristrutturato e annovera, tra i vari oggetti, splendidi affreschi raffiguranti i racconti dell\u2019autore francese Jean de la Fontaine. Si trova nel Parc Leopold, luogo ideale per un picnic o una passeggiata.\n\nLa prossima esposizione temporanea \u201cFalso per Vero: una storia di contraffazione e falsificazione\u201d aprir\u00e0 le porte il 24 Ottobre.\n\n* Gratuito\n* Disponibile in 24 lingue\n* Attualmente sono disponibili solo visite individuali. Prenotazione online: https:\/\/booking-visits.europarl.europa.eu\/it\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Maison de l'Histoire europ\u00e9enne","address_street_name":"Rue Belliard","address_street_number":"135","address_street_box":null,"email":"historia-learning@europarl.europa.eu","website":"https:\/\/historia-europa.ep.eu\/fr\/welkom-het-huis-van-de-europese-geschiedenis","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Belliard, 135","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Maison de l'Histoire europ\u00e9enne","address_street_name":"Rue Belliard","address_street_number":"135","address_street_box":null,"email":"historia-learning@europarl.europa.eu","website":"https:\/\/historia-europa.ep.eu\/fr\/welkom-het-huis-van-de-europese-geschiedenis","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Belliard, 135","address_line2":"1000 Bruxelles","description_web":"Pr\u00e9parez-vous \u00e0 un voyage pas comme les autres ! \n\nL'exposition permanente commence avec le mythe de la d\u00e9esse Europa, explore les racines anciennes de l'Europe et l'h\u00e9ritage des traditions communes du continent, avant le voyage spectaculaire de l'Europe vers la modernit\u00e9 au XIXe si\u00e8cle et le processus de reconstruction apr\u00e8s la Seconde Guerre mondiale. \n\nUn guide multim\u00e9dia en 24 langues vous offre de nouvelles fa\u00e7ons d'interagir avec l'exposition, tandis que des activit\u00e9s sp\u00e9ciales et des espaces de d\u00e9couverte en famille permettent aux enfants de saisir l'histoire de l'Europe.  \n\nSitu\u00e9e \u00e0 c\u00f4t\u00e9 du Parlement europ\u00e9en dans un \u00e9tonnant b\u00e2timent Art d\u00e9co du Parc L\u00e9opold, la Maison de l'histoire europ\u00e9enne est un \u00e9l\u00e9ment essentiel de toute visite de la ville.\n* Gratuit\n* Disponible en 24 langues\n* R\u00e9servation en ligne : voir informations pratiques\n\n\n","description_print":"Ce mus\u00e9e gratuit, install\u00e9 dans le magnifique b\u00e2timent Eastman r\u00e9nov\u00e9, retrace l\u2019histoire europ\u00e9enne. \r\nDes centaines de traces et d\u2019objets pour t\u00e9moigner des mythes europ\u00e9ens et des d\u00e9couvertes, jusqu'au chaos et au d\u00e9veloppement du sentiment d\u2019appartenance au cours du XX\u00e8me si\u00e8cle. Les visiteurs vont plonger dans le pass\u00e9 - et l\u2019avenir - de l\u2019Europe. La Maison de l\u2019histoire europ\u00e9enne propose des programmes sur mesure pour les \u00e9coles, les familles et les groupes.\r\n\r\nExposition permanente : Partez \u00e0 la d\u00e9couverte de l\u2019histoire europ\u00e9enne en vous arr\u00eatant d'abord sur les id\u00e9es et les convictions du XIXe si\u00e8cle, qui a marqu\u00e9 l'entr\u00e9e de l'Europe dans la modernit\u00e9. Puis penchez-vous sur la triste p\u00e9riode de guerre et de destruction et terminez par la recherche d'une vie meilleure dans une Europe toujours plus unifi\u00e9e. Le mus\u00e9e incite \u00e0 la r\u00e9flexion sur l'Europe d'aujourd'hui, et sur le r\u00f4le que tout Europ\u00e9en peut jouer pour modeler son avenir.\r\n\r\nEnseignement et formation : la Maison de l\u2019histoire europ\u00e9enne propose divers programmes de formation qui font de la visite une exp\u00e9rience captivante au fil des pr\u00e9sentations interactives, objets originaux et r\u00e9pliques, expositions, guides multim\u00e9dias, ressources p\u00e9dagogiques, ateliers et s\u00e9minaires. Ils incitent les visiteurs \u00e0 remettre en question leur conception de l'histoire europ\u00e9enne et son empreinte sur le monde contemporain.  \r\n\r\nUn site exceptionnel : le b\u00e2timent Eastman, qui abritait anciennement une clinique dentaire pour enfants d\u00e9favoris\u00e9s, est une perle de l\u2019Art D\u00e9co. Restaur\u00e9 jusque dans les moindres d\u00e9tails, le b\u00e2timent comprend notamment des fresques murales inspir\u00e9es des fables de La Fontaine. Il se dresse dans le majestueux Parc L\u00e9opold, au c\u0153ur du quartier europ\u00e9en de Bruxelles. Id\u00e9al pour un pique-nique ou une petite pause nature !\r\n\r\n","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Casa de la historia Europea","address_street_name":"Rue Belliard","address_street_number":"135","address_street_box":null,"email":"historia-learning@europarl.europa.eu","website":"https:\/\/historia-europa.ep.eu\/fr\/welkom-het-huis-van-de-europese-geschiedenis","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Belliard, 135","address_line2":"1000 Bruxelles","description_web":"La exposici\u00f3n permanente le gu\u00eda a trav\u00e9s de momentos clave de la historia europea. Desde las convicciones y creencias del siglo XIX, cuando Europa alcanz\u00f3\nla \"modernidad\", puede seguir la historia a trav\u00e9s de la destrucci\u00f3n y la guerra,\nantes de llegar a la b\u00fasqueda de una vida nueva, pac\u00edfica y cada vez m\u00e1s unida.\nUna gu\u00eda multimedia le ofrece nuevas formas de interactuar con la exposici\u00f3n;\ntambi\u00e9n ofrece actividades especiales que permiten a los ni\u00f1os comprender la\nhistoria de Europa.\nUna ubicaci\u00f3n extraordinaria para un museo extraordinario: el edificio Eastman, que\nen el pasado fue una cl\u00ednica dental para ni\u00f1os desfavorecidos, es una joya Art Deco.\nEl edificio ha sido meticulosamente restaurado y alberga, entre otras cosas,\nhermosas pinturas murales que representan las historias del autor franc\u00e9s Jean de\nLa Fontaine. Se encuentra en el Parque Leopold, un lugar perfecto para un picnic o\nun paseo.\nLa pr\u00f3xima exposici\u00f3n temporal \u201cFalso de verdad: una historia de falsificaci\u00f3n y\nfalsificaci\u00f3n\u201d se inaugurar\u00e1 el 24 de octubre.\n* Gratuito\n* Disponible en 24 idiomas\n* Por el momento solo se permiten las visitas individuales. Reserve a trav\u00e9s del enlace:\nhttps:\/\/booking-visits.europarl.europa.eu\/en\n","description_print":"Este museo gratuito, instalado en el magn\u00edfico edificio restaurado Eastman, recuerda la historia europea y reflexiona su futuro a trav\u00e9s de cientos de objetos procedentes de los 28 pa\u00edses de la UE. En \u00e9l se presenta la historia de Europa en los 24 idiomas oficiales de la Uni\u00f3n Europea, desde los mitos europeos y los descubrimientos, hasta el caos y el desarrollo del sentimiento de pertenencia que se produjeron a lo largo del siglo XX; y se anima a los visitantes a reflexionar, a plantearse preguntas y a evocar el pasado y el futuro del Viejo Continente. La Casa de la Historia Europea tambi\u00e9n ofrece programas a medida para colegios, familias y grupos.\r\n\r\nExposici\u00f3n permanente: el visitante podr\u00e1 descubrir las l\u00edneas principales de la historia europea al detenerse, en primer lugar, en las ideas y convicciones que caracterizaron al siglo XIX, que marcan \u00abla entrada de Europa en la modernidad\u00bb, antes de pasar al per\u00edodo de guerra y destrucci\u00f3n, y de terminar con la cuesti\u00f3n de la b\u00fasqueda de una vida mejor en una Europa todav\u00eda m\u00e1s unificada. El museo promueve una reflexi\u00f3n sobre la Europa de hoy en d\u00eda y sobre el papel que todos los europeos pueden desempe\u00f1ar a la hora de dar forma al futuro de Europa.\r\n\r\nEnse\u00f1anza y formaci\u00f3n: la Casa de la Historia Europea ha elaborado diferentes programas de formaci\u00f3n que consiguen que la visita sea una experiencia muy interesante gracias al uso de presentaciones interactivas, objetos originales y r\u00e9plicas, exposiciones, gu\u00edas multimedia, recursos pedag\u00f3gicos, talleres y seminarios.  Todos estos recursos animan a los visitantes a replantearse sus ideas acerca de la historia europea y su huella en el mundo contempor\u00e1neo.  \r\n\r\nUn centro excepcional: el edificio Eastman, que antiguamente albergaba una cl\u00ednica dental para ni\u00f1os desfavorecidos, es una aut\u00e9ntica joya del estilo Art D\u00e9co. Restaurado hasta el m\u00e1s m\u00ednimo detalle, el edificio est\u00e1 compuesto principalmente por frescos murales inspirados en las f\u00e1bulas de Jean de La Fontaine, en los cuales se ha realizado un magn\u00edfico trabajo de restauraci\u00f3n. El museo se levanta sobre el sombreado Parc L\u00e9opold, que, con sus diez hect\u00e1reas de extensi\u00f3n,  constituye un enclave ideal para realizar un p\u00edcnic o una breve pausa en un banco.\r\n\r\n","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Huis van de Europese geschiedenis","address_street_name":"Belliardstraat","address_street_number":"135","address_street_box":null,"email":"historia-learning@europarl.europa.eu","website":"https:\/\/historia-europa.ep.eu\/nl\/welkom-het-huis-van-de-europese-geschiedenis","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Belliardstraat, 135","address_line2":"1000 Brussel","description_web":"Bereid je voor op een reis als geen ander! \nDe permanente tentoonstelling begint met de mythe van de godin Europa en verkent de oude wortels van Europa en het erfgoed van gemeenschappelijke tradities, voordat Europa's dramatische reis naar moderniteit in de 19e eeuw en de wederopbouw na de Tweede Wereldoorlog begint. \n\nEen multimediagids in 24 talen biedt nieuwe manieren om met de tentoonstelling om te gaan, terwijl speciale activiteiten en ontdekkingsruimtes voor gezinnen kinderen in staat stellen het verhaal van Europa te begrijpen.  \n\nHet Huis van de Europese geschiedenis ligt naast het Europees Parlement in een opvallend art-decogebouw in het Leopoldpark en is een essentieel onderdeel van elk bezoek aan de stad.\n* gratis \n * in 24 talen \n * Online reserveren: zie praktische informatie","description_print":"Dit gratis museum in het prachtig gerenoveerde Eastmangebouw geeft een overzicht van de Europese geschiedenis \u00e9n toekomst, aan de hand van honderden objecten uit de 28 landen van de EU. In alle 24 offici\u00eble talen van de Europese Unie vertelt het het verhaal van Europa vanaf de Europese mythen en ontdekkingen tot de chaos en het samenhorigheidsgevoel van de twintigste eeuw en zet aan tot nadenken,  vragen stellen en praten over het Europese verleden en toekomst. Het Huis biedt programma\u2019s op maat voor scholen, gezinnen en groepen.\r\n\r\nPermanente tentoonstelling: deze voert de bezoeker langs de hoofdlijnen van de Europese geschiedenis, waarbij eerst en vooral de overtuigingen en denkbeelden van de negentiende eeuw aan bod komen, toen Europa toetrad tot de moderniteit, gevolgd door een periode van oorlog en vernieling om ten te eindigen naar de zoektocht naar een beter leven en een samenwerking die steeds hechter werd. Het museum zet aan tot reflectie over het Europa van vandaag en de wijze waarop elke Europeaan mee de toekomst van Europa kan vormgeven.\r\n\r\nOnderwijs en vorming: het Huis ontwikkelde diverse vormingsprogramma\u2019s die zorgen voor een beklijvende ervaring dankzij interactieve opstellingen, originele voorwerpen en replica\u2019s, tentoonstellingen, multimedia, leermiddelen, workshops en seminars. Zij zetten de bezoekers aan om vraagtekens te plaatsen bij de Europese geschiedenis en de gevolgen voor de wereld van vandaag.\r\n\r\nEen uitzonderlijke locatie: het Eastmangebouw - vroeger een tandheelkundige kliniek voor kansarme kinderen - is een art decopareltje. Het tot in de puntjes gerestaureerde gebouw bevat onder meer prachtig gerestaureerde muurschilderingen van de fabels van de Franse schrijver Jean de La Fontaine en is gelegen in het schaduwrijke, tien hectare grote Leopoldpark. Ideaal voor een picknick of wat uitblazen op een bankje.\r\n\r\n","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[9],"translations":{"de":["Europ\u00e4isches Viertel"],"pt":[null],"en":["European Quarter"],"it":["Quartiere europeo"],"cn":[null],"fr":["Quartier europ\u00e9en"],"sp":["Barrio Europeo"],"nl":["Europese wijk"]}},"zones":{"list":[22],"translations":{"de":["Osten"],"pt":[null],"en":["East"],"it":["Est"],"cn":[null],"fr":["Est"],"sp":["Este"],"nl":["Oost"]}},"neca":null,"facebook_id":null,"backoffice_id":27078,"location":{"lat":50.8393873,"lon":4.3786546},"region":"brussels","last_updated_at":"2024-07-19T10:34:10+02:00","published_at":"2017-02-02T16:24:49+01:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":267078,"translations":{"de":{"name":"Haus der Europ\u00e4ischen Geschichte","address_street_name":"Rue Belliard","address_street_number":"135","address_street_box":null,"email":"historia-learning@europarl.europa.eu","website":"https:\/\/historia-europa.ep.eu\/fr\/welkom-het-huis-van-de-europese-geschiedenis","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Belliard, 135","address_line2":"1000 Bruxelles","description_web":"Das Haus der Europ\u00e4ischen Geschichte, das in dem pr\u00e4chtigen, frisch renovierten Eastman-Geb\u00e4ude untergebracht ist, zeichnet die europ\u00e4ische Geschichte und die Zukunft Europas anhand von unz\u00e4hligen Ausstellungsst\u00fccken aus den 28 Mitgliedstaaten der EU nach. Der Eintritt ist frei.\nIn den 24 Amtssprachen der Europ\u00e4ischen Union offenbart es die Geschichte Europas \u2013 von den europ\u00e4ischen Mythen und Entdeckungen, \u00fcber das Chaos und die Kriegswirren bis hin zur allm\u00e4hlichen Entwicklung eines Zugeh\u00f6rigkeitsgef\u00fchls im Laufe des 20. Jahrhunderts. Dabei wird der Besucher angeregt, die Dinge zu hinterfragen und sowohl die Vergangenheit als auch die Zukunft zu betrachten und zu analysieren. Das Haus der Europ\u00e4ischen Geschichte bietet speziell zugeschnittene Programme f\u00fcr Schulen, Familien und Gruppen. Der Eintritt ist frei.\n\nDauerausstellung: Die Dauerausstellung l\u00e4sst die gro\u00dfen Ereignisse der europ\u00e4ischen Geschichte Revue passieren und legt dabei zun\u00e4chst einen Schwerpunkt auf die im 19. Jahrhundert vorherrschenden Ideen und \u00dcberzeugungen. N\u00e4chster thematischer Schwerpunkt sind die zerst\u00f6rerischen Kriege, die Europa ersch\u00fctterten, bevor die Ausstellung sich schlie\u00dflich der europ\u00e4ischen Einigung zuwendet, die den Europ\u00e4ern eine friedlichere Zukunft sichern sollte. Das Museum regt die Besucher zum Nachdenken an \u2013 \u00fcber das heutige Europa und seine Rolle in der Welt und die M\u00f6glichkeit jedes einzelnen Europ\u00e4ers, die Zukunft des Kontinents mitzugestalten.\n\nP\u00e4dagogische Angebote und Fortbildungen: Das Haus der europ\u00e4ischen Geschichte hat eine Reihe von p\u00e4dagogischen Angeboten ausgearbeitet, die die Besichtigung zu einem echten Erlebnis machen: interaktive Pr\u00e4sentationen, Ausstellungsgegenst\u00e4nde, Multimedia-Guides, Ausstellungen, Workshops und Seminare, die den Besucher dazu anregen, seine bisherige Wahrnehmung der europ\u00e4ischen Geschichte und ihren Einfluss auf die heutige Welt zu hinterfragen.\n\nEin herausragendes Bauwerk: Das Eastman-Geb\u00e4ude, das sich im Schatten der B\u00e4ume des majest\u00e4tischen Parc L\u00e9opold erhebt, ist eine Perle des Art D\u00e9co. Hier war bis vor Kurzem noch eine Zahnklinik f\u00fcr sozial benachteiligte Kinder untergebracht, jetzt wurde das Bauwerk bis ins letzte Detail restauriert. Besonders sch\u00f6n sind dabei die Wandfresken in Anlehnung an die Fabeln von Jean de la Fontaine, die nun wieder in altem Glanz erstrahlen. Und nach der Besichtigung laden die Parkb\u00e4nke des Parc L\u00e9opold zum Picknicken und Verweilen ein. ","description_print":"Das Haus der Europ\u00e4ischen Geschichte, das in dem pr\u00e4chtigen, frisch renovierten Eastman-Geb\u00e4ude untergebracht ist, zeichnet die europ\u00e4ische Geschichte und die Zukunft Europas anhand von unz\u00e4hligen Ausstellungsst\u00fccken aus den 28 Mitgliedstaaten der EU nach. Der Eintritt ist frei.\r\nIn den 24 Amtssprachen der Europ\u00e4ischen Union offenbart es die Geschichte Europas \u2013 von den europ\u00e4ischen Mythen und Entdeckungen, \u00fcber das Chaos und die Kriegswirren bis hin zur allm\u00e4hlichen Entwicklung eines Zugeh\u00f6rigkeitsgef\u00fchls im Laufe des 20. Jahrhunderts. Dabei wird der Besucher angeregt, die Dinge zu hinterfragen und sowohl die Vergangenheit als auch die Zukunft zu betrachten und zu analysieren. Das Haus der Europ\u00e4ischen Geschichte bietet speziell zugeschnittene Programme f\u00fcr Schulen, Familien und Gruppen. Der Eintritt ist frei.\r\n\r\nDauerausstellung: Die Dauerausstellung l\u00e4sst die gro\u00dfen Ereignisse der europ\u00e4ischen Geschichte Revue passieren und legt dabei zun\u00e4chst einen Schwerpunkt auf die im 19. Jahrhundert vorherrschenden Ideen und \u00dcberzeugungen. N\u00e4chster thematischer Schwerpunkt sind die zerst\u00f6rerischen Kriege, die Europa ersch\u00fctterten, bevor die Ausstellung sich schlie\u00dflich der europ\u00e4ischen Einigung zuwendet, die den Europ\u00e4ern eine friedlichere Zukunft sichern sollte. Das Museum regt die Besucher zum Nachdenken an \u2013 \u00fcber das heutige Europa und seine Rolle in der Welt und die M\u00f6glichkeit jedes einzelnen Europ\u00e4ers, die Zukunft des Kontinents mitzugestalten.\r\n\r\nP\u00e4dagogische Angebote und Fortbildungen: Das Haus der europ\u00e4ischen Geschichte hat eine Reihe von p\u00e4dagogischen Angeboten ausgearbeitet, die die Besichtigung zu einem echten Erlebnis machen: interaktive Pr\u00e4sentationen, Ausstellungsgegenst\u00e4nde, Multimedia-Guides, Ausstellungen, Workshops und Seminare, die den Besucher dazu anregen, seine bisherige Wahrnehmung der europ\u00e4ischen Geschichte und ihren Einfluss auf die heutige Welt zu hinterfragen.\r\n\r\nEin herausragendes Bauwerk: Das Eastman-Geb\u00e4ude, das sich im Schatten der B\u00e4ume des majest\u00e4tischen Parc L\u00e9opold erhebt, ist eine Perle des Art D\u00e9co. Hier war bis vor Kurzem noch eine Zahnklinik f\u00fcr sozial benachteiligte Kinder untergebracht, jetzt wurde das Bauwerk bis ins letzte Detail restauriert. Besonders sch\u00f6n sind dabei die Wandfresken in Anlehnung an die Fabeln von Jean de la Fontaine, die nun wieder in altem Glanz erstrahlen. Und nach der Besichtigung laden die Parkb\u00e4nke des Parc L\u00e9opold zum Picknicken und Verweilen ein. \r\n\r\n","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Maison de l'Histoire europ\u00e9enne","address_street_name":"Rue Belliard","address_street_number":"135","address_street_box":null,"email":"historia-learning@europarl.europa.eu","website":"https:\/\/historia-europa.ep.eu\/fr\/welkom-het-huis-van-de-europese-geschiedenis","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Belliard, 135","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"House of European History","address_street_name":"Belliardstraat","address_street_number":"135","address_street_box":null,"email":"historia-learning@europarl.europa.eu","website":"https:\/\/historia-europa.ep.eu\/en\/welcome-house-european-history","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Belliardstraat, 135","address_line2":"1000 Brussels","description_web":"Get ready for a journey like no other! \nThe permanent exhibition begins with the myth of the goddess Europa, exploring Europe\u2019s ancient roots and the continent\u2019s heritage of shared traditions, before Europe\u2019s dramatic journey towards modernity in the 19th century and rebuilding process following World War II. \n\nA multimedia guide in 24 languages gives you new ways to interact with the exhibition, while special activities and Family Discovery Spaces allow children to grasp the story of Europe.  \n\nLocated next to the European Parliament in a striking Art Deco building in Parc L\u00e9opold, the House of European History is an essential part of any tour of the city.\n* Free\n* Available in 24 languages\n* Book online: See practical information\n\n","description_print":"This free museum in the beautifully renovated Eastman building presents an overview of European history and its possible future, thanks to hundreds of objects from all 28 EU member states. The museum recounts all of Europe\u2019s history, in each of the EU\u2019s 24 official languages, from the early European myths and discoveries, to the chaos followed by a growing feeling of unity and belonging of the 20th century. It also encourages visitors to think about, question and debate Europe\u2019s future. The House of European History provides visits perfectly tailored for schools, families and groups.\r\n\r\nThe permanent exhibition: The exhibition guides visitors through key moments of European history. First come the convictions and beliefs of the 19th century - when Europe reached \u2018modernity\u2019 - followed by a period of destruction and war, before the exhibition ends with Europe\u2019s search for a new life and an increasingly united continent. The museum hopes to get visitors to reflect on today\u2019s Europe and contemplate how each European can help to build the Europe of tomorrow.\r\n\r\nEducation and learning: The House of European History has developed various educational programmes that guarantee a memorable experience thanks to interactive equipment, original and replica objects, presentations, multimedia, teaching materials, workshops and seminars. They encourage visitors to question and debate Europe\u2019s history and its consequences for the world today.\r\n\r\nAn extraordinary location: The Eastman building \u2013 which was once a dental clinic for disadvantaged children - is an Art Deco gem. The building - which was meticulously restored \u2013 houses, among other things, some beautiful wall paintings depicting the stories of French author Jean de La Fontaine, and lies in the ten hectare Leopold park. It\u2019s the perfect place for a picnic or a relaxing break on a bench.\r\n\r\n","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Casa della storia Europea","address_street_name":"Rue Belliard","address_street_number":"135","address_street_box":null,"email":"historia-learning@europarl.europa.eu","website":"https:\/\/historia-europa.ep.eu\/fr\/welkom-het-huis-van-de-europese-geschiedenis","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Belliard, 135","address_line2":"1000 Bruxelles","description_web":"Questa mostra permanente vi guida attraverso momenti salienti della storia europea. Dalle convinzioni e credenze del XIX\u00b0 secolo - quando l\u2019Europa raggiunse la \u201cmodernit\u00e0\u201d - potrete seguire la storia attraverso la distruzione e la guerra, prima di vedere la ricerca per un\u2019esistenza nuova, pacifica e sempre pi\u00f9 all\u2019insegna dell\u2019unit\u00e0. Una guida multimediale vi offrir\u00e0 nuove modalit\u00e0 per interagire con la mostra, mentre attivit\u00e0 speciali consentono ai bambini di comprendere la storia d\u2019Europa.Un luogo straordinario per un museo straordinario: la palazzina Eastman - una volta clinica dentale per bambini disavvantaggiati - \u00e8 una gemma dell\u2019Art D\u00e9co. L\u2019edificio \u00e8 stato meticolosamente ristrutturato e annovera, tra i vari oggetti, splendidi affreschi raffiguranti i racconti dell\u2019autore francese Jean de la Fontaine. Si trova nel Parc Leopold, luogo ideale per un picnic o una passeggiata.\n\nLa prossima esposizione temporanea \u201cFalso per Vero: una storia di contraffazione e falsificazione\u201d aprir\u00e0 le porte il 24 Ottobre.\n\n* Gratuito\n* Disponibile in 24 lingue\n* Attualmente sono disponibili solo visite individuali. Prenotazione online: https:\/\/booking-visits.europarl.europa.eu\/it\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Maison de l'Histoire europ\u00e9enne","address_street_name":"Rue Belliard","address_street_number":"135","address_street_box":null,"email":"historia-learning@europarl.europa.eu","website":"https:\/\/historia-europa.ep.eu\/fr\/welkom-het-huis-van-de-europese-geschiedenis","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Belliard, 135","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Maison de l'Histoire europ\u00e9enne","address_street_name":"Rue Belliard","address_street_number":"135","address_street_box":null,"email":"historia-learning@europarl.europa.eu","website":"https:\/\/historia-europa.ep.eu\/fr\/welkom-het-huis-van-de-europese-geschiedenis","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Belliard, 135","address_line2":"1000 Bruxelles","description_web":"Pr\u00e9parez-vous \u00e0 un voyage pas comme les autres ! \n\nL'exposition permanente commence avec le mythe de la d\u00e9esse Europa, explore les racines anciennes de l'Europe et l'h\u00e9ritage des traditions communes du continent, avant le voyage spectaculaire de l'Europe vers la modernit\u00e9 au XIXe si\u00e8cle et le processus de reconstruction apr\u00e8s la Seconde Guerre mondiale. \n\nUn guide multim\u00e9dia en 24 langues vous offre de nouvelles fa\u00e7ons d'interagir avec l'exposition, tandis que des activit\u00e9s sp\u00e9ciales et des espaces de d\u00e9couverte en famille permettent aux enfants de saisir l'histoire de l'Europe.  \n\nSitu\u00e9e \u00e0 c\u00f4t\u00e9 du Parlement europ\u00e9en dans un \u00e9tonnant b\u00e2timent Art d\u00e9co du Parc L\u00e9opold, la Maison de l'histoire europ\u00e9enne est un \u00e9l\u00e9ment essentiel de toute visite de la ville.\n* Gratuit\n* Disponible en 24 langues\n* R\u00e9servation en ligne : voir informations pratiques\n\n\n","description_print":"Ce mus\u00e9e gratuit, install\u00e9 dans le magnifique b\u00e2timent Eastman r\u00e9nov\u00e9, retrace l\u2019histoire europ\u00e9enne. \r\nDes centaines de traces et d\u2019objets pour t\u00e9moigner des mythes europ\u00e9ens et des d\u00e9couvertes, jusqu'au chaos et au d\u00e9veloppement du sentiment d\u2019appartenance au cours du XX\u00e8me si\u00e8cle. Les visiteurs vont plonger dans le pass\u00e9 - et l\u2019avenir - de l\u2019Europe. La Maison de l\u2019histoire europ\u00e9enne propose des programmes sur mesure pour les \u00e9coles, les familles et les groupes.\r\n\r\nExposition permanente : Partez \u00e0 la d\u00e9couverte de l\u2019histoire europ\u00e9enne en vous arr\u00eatant d'abord sur les id\u00e9es et les convictions du XIXe si\u00e8cle, qui a marqu\u00e9 l'entr\u00e9e de l'Europe dans la modernit\u00e9. Puis penchez-vous sur la triste p\u00e9riode de guerre et de destruction et terminez par la recherche d'une vie meilleure dans une Europe toujours plus unifi\u00e9e. Le mus\u00e9e incite \u00e0 la r\u00e9flexion sur l'Europe d'aujourd'hui, et sur le r\u00f4le que tout Europ\u00e9en peut jouer pour modeler son avenir.\r\n\r\nEnseignement et formation : la Maison de l\u2019histoire europ\u00e9enne propose divers programmes de formation qui font de la visite une exp\u00e9rience captivante au fil des pr\u00e9sentations interactives, objets originaux et r\u00e9pliques, expositions, guides multim\u00e9dias, ressources p\u00e9dagogiques, ateliers et s\u00e9minaires. Ils incitent les visiteurs \u00e0 remettre en question leur conception de l'histoire europ\u00e9enne et son empreinte sur le monde contemporain.  \r\n\r\nUn site exceptionnel : le b\u00e2timent Eastman, qui abritait anciennement une clinique dentaire pour enfants d\u00e9favoris\u00e9s, est une perle de l\u2019Art D\u00e9co. Restaur\u00e9 jusque dans les moindres d\u00e9tails, le b\u00e2timent comprend notamment des fresques murales inspir\u00e9es des fables de La Fontaine. Il se dresse dans le majestueux Parc L\u00e9opold, au c\u0153ur du quartier europ\u00e9en de Bruxelles. Id\u00e9al pour un pique-nique ou une petite pause nature !\r\n\r\n","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Casa de la historia Europea","address_street_name":"Rue Belliard","address_street_number":"135","address_street_box":null,"email":"historia-learning@europarl.europa.eu","website":"https:\/\/historia-europa.ep.eu\/fr\/welkom-het-huis-van-de-europese-geschiedenis","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Belliard, 135","address_line2":"1000 Bruxelles","description_web":"La exposici\u00f3n permanente le gu\u00eda a trav\u00e9s de momentos clave de la historia europea. Desde las convicciones y creencias del siglo XIX, cuando Europa alcanz\u00f3\nla \"modernidad\", puede seguir la historia a trav\u00e9s de la destrucci\u00f3n y la guerra,\nantes de llegar a la b\u00fasqueda de una vida nueva, pac\u00edfica y cada vez m\u00e1s unida.\nUna gu\u00eda multimedia le ofrece nuevas formas de interactuar con la exposici\u00f3n;\ntambi\u00e9n ofrece actividades especiales que permiten a los ni\u00f1os comprender la\nhistoria de Europa.\nUna ubicaci\u00f3n extraordinaria para un museo extraordinario: el edificio Eastman, que\nen el pasado fue una cl\u00ednica dental para ni\u00f1os desfavorecidos, es una joya Art Deco.\nEl edificio ha sido meticulosamente restaurado y alberga, entre otras cosas,\nhermosas pinturas murales que representan las historias del autor franc\u00e9s Jean de\nLa Fontaine. Se encuentra en el Parque Leopold, un lugar perfecto para un picnic o\nun paseo.\nLa pr\u00f3xima exposici\u00f3n temporal \u201cFalso de verdad: una historia de falsificaci\u00f3n y\nfalsificaci\u00f3n\u201d se inaugurar\u00e1 el 24 de octubre.\n* Gratuito\n* Disponible en 24 idiomas\n* Por el momento solo se permiten las visitas individuales. Reserve a trav\u00e9s del enlace:\nhttps:\/\/booking-visits.europarl.europa.eu\/en\n","description_print":"Este museo gratuito, instalado en el magn\u00edfico edificio restaurado Eastman, recuerda la historia europea y reflexiona su futuro a trav\u00e9s de cientos de objetos procedentes de los 28 pa\u00edses de la UE. En \u00e9l se presenta la historia de Europa en los 24 idiomas oficiales de la Uni\u00f3n Europea, desde los mitos europeos y los descubrimientos, hasta el caos y el desarrollo del sentimiento de pertenencia que se produjeron a lo largo del siglo XX; y se anima a los visitantes a reflexionar, a plantearse preguntas y a evocar el pasado y el futuro del Viejo Continente. La Casa de la Historia Europea tambi\u00e9n ofrece programas a medida para colegios, familias y grupos.\r\n\r\nExposici\u00f3n permanente: el visitante podr\u00e1 descubrir las l\u00edneas principales de la historia europea al detenerse, en primer lugar, en las ideas y convicciones que caracterizaron al siglo XIX, que marcan \u00abla entrada de Europa en la modernidad\u00bb, antes de pasar al per\u00edodo de guerra y destrucci\u00f3n, y de terminar con la cuesti\u00f3n de la b\u00fasqueda de una vida mejor en una Europa todav\u00eda m\u00e1s unificada. El museo promueve una reflexi\u00f3n sobre la Europa de hoy en d\u00eda y sobre el papel que todos los europeos pueden desempe\u00f1ar a la hora de dar forma al futuro de Europa.\r\n\r\nEnse\u00f1anza y formaci\u00f3n: la Casa de la Historia Europea ha elaborado diferentes programas de formaci\u00f3n que consiguen que la visita sea una experiencia muy interesante gracias al uso de presentaciones interactivas, objetos originales y r\u00e9plicas, exposiciones, gu\u00edas multimedia, recursos pedag\u00f3gicos, talleres y seminarios.  Todos estos recursos animan a los visitantes a replantearse sus ideas acerca de la historia europea y su huella en el mundo contempor\u00e1neo.  \r\n\r\nUn centro excepcional: el edificio Eastman, que antiguamente albergaba una cl\u00ednica dental para ni\u00f1os desfavorecidos, es una aut\u00e9ntica joya del estilo Art D\u00e9co. Restaurado hasta el m\u00e1s m\u00ednimo detalle, el edificio est\u00e1 compuesto principalmente por frescos murales inspirados en las f\u00e1bulas de Jean de La Fontaine, en los cuales se ha realizado un magn\u00edfico trabajo de restauraci\u00f3n. El museo se levanta sobre el sombreado Parc L\u00e9opold, que, con sus diez hect\u00e1reas de extensi\u00f3n,  constituye un enclave ideal para realizar un p\u00edcnic o una breve pausa en un banco.\r\n\r\n","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Huis van de Europese geschiedenis","address_street_name":"Belliardstraat","address_street_number":"135","address_street_box":null,"email":"historia-learning@europarl.europa.eu","website":"https:\/\/historia-europa.ep.eu\/nl\/welkom-het-huis-van-de-europese-geschiedenis","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Belliardstraat, 135","address_line2":"1000 Brussel","description_web":"Bereid je voor op een reis als geen ander! \nDe permanente tentoonstelling begint met de mythe van de godin Europa en verkent de oude wortels van Europa en het erfgoed van gemeenschappelijke tradities, voordat Europa's dramatische reis naar moderniteit in de 19e eeuw en de wederopbouw na de Tweede Wereldoorlog begint. \n\nEen multimediagids in 24 talen biedt nieuwe manieren om met de tentoonstelling om te gaan, terwijl speciale activiteiten en ontdekkingsruimtes voor gezinnen kinderen in staat stellen het verhaal van Europa te begrijpen.  \n\nHet Huis van de Europese geschiedenis ligt naast het Europees Parlement in een opvallend art-decogebouw in het Leopoldpark en is een essentieel onderdeel van elk bezoek aan de stad.\n* gratis \n * in 24 talen \n * Online reserveren: zie praktische informatie","description_print":"Dit gratis museum in het prachtig gerenoveerde Eastmangebouw geeft een overzicht van de Europese geschiedenis \u00e9n toekomst, aan de hand van honderden objecten uit de 28 landen van de EU. In alle 24 offici\u00eble talen van de Europese Unie vertelt het het verhaal van Europa vanaf de Europese mythen en ontdekkingen tot de chaos en het samenhorigheidsgevoel van de twintigste eeuw en zet aan tot nadenken,  vragen stellen en praten over het Europese verleden en toekomst. Het Huis biedt programma\u2019s op maat voor scholen, gezinnen en groepen.\r\n\r\nPermanente tentoonstelling: deze voert de bezoeker langs de hoofdlijnen van de Europese geschiedenis, waarbij eerst en vooral de overtuigingen en denkbeelden van de negentiende eeuw aan bod komen, toen Europa toetrad tot de moderniteit, gevolgd door een periode van oorlog en vernieling om ten te eindigen naar de zoektocht naar een beter leven en een samenwerking die steeds hechter werd. Het museum zet aan tot reflectie over het Europa van vandaag en de wijze waarop elke Europeaan mee de toekomst van Europa kan vormgeven.\r\n\r\nOnderwijs en vorming: het Huis ontwikkelde diverse vormingsprogramma\u2019s die zorgen voor een beklijvende ervaring dankzij interactieve opstellingen, originele voorwerpen en replica\u2019s, tentoonstellingen, multimedia, leermiddelen, workshops en seminars. Zij zetten de bezoekers aan om vraagtekens te plaatsen bij de Europese geschiedenis en de gevolgen voor de wereld van vandaag.\r\n\r\nEen uitzonderlijke locatie: het Eastmangebouw - vroeger een tandheelkundige kliniek voor kansarme kinderen - is een art decopareltje. Het tot in de puntjes gerestaureerde gebouw bevat onder meer prachtig gerestaureerde muurschilderingen van de fabels van de Franse schrijver Jean de La Fontaine en is gelegen in het schaduwrijke, tien hectare grote Leopoldpark. Ideaal voor een picknick of wat uitblazen op een bankje.\r\n\r\n","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":27078,"location":{"lat":50.8393873,"lon":4.3786546},"las