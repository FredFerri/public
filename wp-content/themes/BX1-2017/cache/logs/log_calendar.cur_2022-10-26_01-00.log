cr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.528714"},"pt":{"name":"Cours d'initiation au yoga","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.528714"},"cn":{"name":"Cours d'initiation au yoga","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.528714"}},"place":{"id":247056,"translations":{"fr":{"name":"Mus\u00e9e Bruxellois du Moulin et de l'Alimentation","address_street_name":"Rue du Moulin \u00e0 Vent","address_street_number":"21","address_street_box":null,"email":"mbma-bmmv@evere.brussels","website":"http:\/\/www.moulindevere.be","phone_contact":"+32 2 245 37 79","phone_booking":null,"address_zip":"1140","address_city":"Evere","address_line1":"Rue du Moulin \u00e0 Vent, 21","address_line2":"1140 Evere","description_web":"Le Mus\u00e9e bruxellois du Moulin et de l'Alimentation est situ\u00e9 dans l'ancien moulin d'Evere. T\u00e9moin unique du patrimoine industriel bruxellois, ce b\u00e2timent class\u00e9 a suivi toutes les \u00e9volutions techniques des XIXe et XXe si\u00e8cles. Les collections permanentes illustrent le monde de la meunerie et l\u2019histoire du moulin d\u2019Evere. Chaque ann\u00e9e, en septembre, le renouvellement complet des objets expos\u00e9s permet d'approfondir une th\u00e9matique alimentaire diff\u00e9rente.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Brussels Museum van de Molen en de Voeding","address_street_name":"Windmolenstraat","address_street_number":"21","address_street_box":null,"e