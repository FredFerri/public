":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-09-22T02:01:40+02:00","published_at":"2024-07-03T13:03:25+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":303523,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"theatre","ranking":0.5453180111445977,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":49,"translations":{"de":"Theater","pt":null,"en":"Theatre","it":"Teatro","cn":null,"fr":"Th\u00e9\u00e2tre","sp":"Teatro","nl":"Theater"}},"others":{}},"translations":{"de":{"name":"Moi je crois pas !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50012196"},"pt":{"name":"Moi je crois pas !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50012196"},"en":{"name":"Moi je crois pas !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50012196"},"it":{"name":"Moi je crois pas !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50012196"},"cn":{"name":"Moi je crois pas !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50012196"},"fr":{"name":"Moi je crois pas !","shortdescr":null,"longdescr":"Fini la s\u00e9duction, les \u00e9lans de l\u2019amour naissant, Monsieur et Madame s\u2019affrontent. Ils se cherchent des poux, provoquent leur guerre intestine. Ils conjurent l\u2019ennui familier \u00e0 travers les accrocs de la dispute. Le 11 septembre est-il un coup mont\u00e9 ? Y a-t-il une vie apr\u00e8s la mort ? Lui n\u2019y croit pas, elle si. Elle croit en l\u2019existence du y\u00e9ti, elle croit que les f\u00e8ves provoquent les prouts. Lui, non. Ils luttent. Batailles. Et les soir\u00e9es passent.\n\nN\u00e9 en 39, bard\u00e9 de m\u00e9dailles, de Moli\u00e8res, Jean-Claude Grumberg, l\u2019auteur de L\u2019Atelier, est laur\u00e9at des grands prix de l\u2019Acad\u00e9mie fran\u00e7aise et de la SACD pour l\u2019ensemble de son \u0153uvre.\nMoi je crois pas ! \u00ab c\u2019est une France qui aurait perdu la m\u00e9moire. Une France aux fen\u00eatres ferm\u00e9es... qui oublie qu\u2019elle n\u2019est pas seule. \u00bb\n\nLe tandem Bernard Cogniaux et C\u00e9cile Van Snick c\u2019est pour le meilleur en sc\u00e8ne. Deux b\u00eates de sc\u00e8ne labourent les terres fertiles des id\u00e9es re\u00e7ues, des pr\u00e9jug\u00e9s, et de la b\u00eatise partag\u00e9e. Portraits au vinaigre d\u2019un couple \u00e0 pantoufles tr\u00e8s \u00e9lim\u00e9es et \u00e0 la t\u00e9l\u00e9 trop allum\u00e9e.\nDeux vieux amoureux, bouff\u00e9s par la routine, avachis d\u2019un amour retomb\u00e9 comme un souffl\u00e9, qui se querellent pour des broutilles, se cherchent des poux, rivalisent de mauvaise foi.\nDeux \u00e9nergum\u00e8nes qui s\u2019affrontent gaiement sur le terrain de l\u2019habitude. C\u2019est d\u00e9risoire, comique et po\u00e9tique.\n__________\n\nDe Jean-Claude Grumberg \/ Mise en sc\u00e8ne : Marie-Paule Kumps \/ Avec : Bernard Cogniaux et C\u00e9cile Van Snick \/ Assistante \u00e0 la mise en sc\u00e8ne : Delphine Roy \/ Sc\u00e9nographie : Laura Erba \/ Costumes : B\u00e9a Pendesini \/ Lumi\u00e8re : Ga\u00ebtan van den Berg \/ Son : Philippe Lecrenier\n__________\n\nUNE PRODUCTION DU TH\u00c9\u00c2TRE LE PUBLIC. AVEC L'AIDE DE LA F\u00c9D\u00c9RATION WALLONIE-BRUXELLES - DIRECTION DU TH\u00c9\u00c2TRE, ET LE SOUTIEN DU TAX SHELTER DE L\u2019\u00c9TAT F\u00c9D\u00c9RAL BELGE VIA BESIDE. ","performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50012196"},"sp":{"name":"Moi je crois pas !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50012196"},"nl":{"name":"Moi je crois pas !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50012196"}},"place":{"id":224476,"translations":{"de":{"name":"Th\u00e9\u00e2tre Le Public","address_street_name":"Rue Braemt","address_street_number":"64 70","address_street_box":null,"email":"contact@theatrelepublic.be","website":"http:\/\/www.theatrelepublic.be","phone_contact":"+32 2 724 24 44","phone_booking":"+32 2 724 24 44","address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","add