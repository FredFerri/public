 Marie Darah et Manza, animeront la soir\u00e9e tout en verbe et en l\u00e9g\u00e8ret\u00e9.\r\n\r\n#MicroOuvert #Obs\u00e9d\u00e9Textuel #SlamPlanePourMoi\r\n\r\nSoir\u00e9e en partenariat avec Le 140, Les Midis de la po\u00e9sie et L\u00e9zarts Urbains","performers":null,"boxoffice_url":null,"website":"http:\/\/www.francofaune.be\/","email":"info@francofaune.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.538679"},"nl":{"name":"Fleurs du Slam #4 \u2022 FrancoFaune 2022","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.538679"},"en":{"name":"Fleurs du Slam #4 \u2022 FrancoFaune 2022","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.538679"},"de":{"name":"Fleurs du Slam #4","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.538679"},"it":{"name":"Fleurs du Slam #4","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.538679"},"sp":{"name":"Fleurs du Slam #4","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.538679"},"pt":{"name":"Fleurs du Slam #4","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":nul