et_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":"Depuis 1983, Arkadia explore les richesses du patrimoine belge et bruxellois et d\u00e9veloppe de nombreux projets culturels sp\u00e9cialement \u00e0 Bruxelles, entre architecture, urbanisme, culture, arts plastiques et id\u00e9ologie depuis le Moyen \u00c2ge jusqu\u2019\u00e0 nos jours. Voir et comprendre la ville et son d\u00e9veloppement architectural, approcher la cr\u00e9ation artistique et lui donner un sens, telles sont les activit\u00e9s que l'ASBL veut partager avec le public. Sp\u00e9cialistes du patrimoine  architectural et de l'art contemporain, ils font d\u00e9couvrir la ville \u00e0 travers des visites guid\u00e9es et des conf\u00e9rences en plusieurs langues.\r\n","description_print":null,"booking_url":null,"s