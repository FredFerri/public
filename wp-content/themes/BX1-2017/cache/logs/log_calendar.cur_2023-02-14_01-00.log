":"2029-01-06","is_also_by_appointment":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"},"de":{"name":"Normal"},"it":{"name":"Normale"},"sp":{"name":"Normal"},"pt":{"name":"Normal"},"cn":{"name":"Normal"}},"value":35}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-02-12T02:07:18+01:00","published_at":"2021-04-22T12:53:46+02:00","backoffice_id":230880,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.14161232289721},{"id":550162,"date_start":"2022-04-27","date_end":"2023-04-22","date_next":"2023-02-13","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":true,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung","it":"Esposizioni","sp":"Exhibici\u00f3n","pt":null,"cn":null}},"others":{"list":[36,48],"translations":{"fr":["Mus\u00e9es et art centers","Architecture"],"nl":["Musea en kunstcentra","Architectuur"],"en":["Museums and art centers","Architecture "],"de":["Museen & Kunstzentren","Architektur"],"it":["Musei e centri artistici","Architettura"],"sp":["Museos y centros de arte","Arquitectura"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Le Modernisme Ludique. Ganshoren. 1958","shortdescr":"Dans les ann\u00e9es 1950, les architectes Raoul J. Brunswyck et Odon Wathelet s\u2019emparent avec enthousiasme de l\u2019esth\u00e9tique audacieuse et color\u00e9e du Modernisme Ludique.\r\nCette expo vous initie aux lignes dynamiques et formes asym\u00e9triques de cette architecture, qui s\u2019affichera avec brio \u00e0 l\u2019Expo 58 !","longdescr":"Dans les ann\u00e9es 1950, les architectes Raoul J. Brunswyck et Odon Wathelet s\u2019emparent avec enthousiasme de l\u2019esth\u00e9tique audacieuse et color\u00e9e du Modernisme Ludique.\r\nPour vous initier aux lignes dynamiques, saillies hardies et formes asym\u00e9triques de cette architecture qui s\u2019affichera brillamment \u00e0 l\u2019Expo 58, rendez-vous dans leur ancien bureau d\u2019architecture, \u00e0 Ganshoren !\r\nAu programme: pavillon pop-up, t\u00e9moignages d\u2019habitants et visites avec un guide passionn\u00e9 ! Une carte vous emm\u00e8nera \u00e0 la d\u00e9couverte d\u2019une quarantaine de b\u00e2timents sign\u00e9s Brunswyck et Wathelet dans le nord-ouest de la capitale \u2013 Jette, Ganshoren, Berchem-Sainte-Agathe, Koekelberg et Molenbeek.\r\nPour d\u00e9couvrir toutes leurs r\u00e9alisations : brunswyck-wathelet.brussels, dernier-n\u00e9 de la plateforme\r\n\u2018Bruxelles, ville d\u2019architectes\u2019, cr\u00e9\u00e9e par l\u2019asbl ARCHistory.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.ganshoren.be","email":"info.brunswyck@ganshoren.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.550162"},"nl":{"name":"Het Speels Modernisme. Ganshoren. 1958","shortdescr":"In de jaren 1950 werden de architecten Raoul J. Brunswyck en Odon Wathelet enthousiaste voorstanders van het Speels Modernisme, met zijn gedurfde en kleurrijke esthetiek.\r\nIn deze expo maak je kennis met de dynamische lijnen en asymmetrische vormen van deze architectuur, die zich in al haar glorie liet zien op de Expo 58.","longdescr":"In de jaren 1950 werden de architecten Raoul J. Brunswyck en Odon Wathelet enthousiaste voorstanders van het Speels Modernisme, met zijn gedurfde en kleurrijke esthetiek.\r\nWil je kennismaken met de dynamische lijnen, de gewaagde uitsprongen en de asymmetrische vormen van deze architectuur, die zich in al haar glorie liet zien op de Expo 58? Geef je ogen de kost in hun voormalig kantoorgebouw te Ganshoren!\r\nOp het programma: een pop-up paviljoen, getuigenissen van bewoners en rondleidingen met een gepassioneerde gids! Met een kaart in de hand kan je ook een veertigtal door Brunswyck en Wathelet ontworpen gebouwen ontdekken in het noordwesten van de hoofdstad \u2013 Jette, Ganshoren, Sint-Agatha-Berchem, Koekelberg en Molenbeek.\r\nJe vindt al hun werken op brunswyck-wathelet.brussels, de jongste telg van het platform \u2018Brussel, stad van architecten\u2019, opgericht door de vzw ARCHistory.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.ganshoren.be","email":"info.brunswyck@ganshoren.brussels","phone_contact":"+32 2 464 95 75","phone_booking":"+32 2 464 95 75","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.550162"},"en":{"name":"Le Modernisme Ludique. Ganshoren. 1958","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.ganshoren.be","email":"info.brunswyck@ganshoren.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.550162"},"de":{"name":"Het Speels Modernisme. Ganshoren. 1958","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.ganshoren.be","email":"info.brunswyck@ganshoren.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.550162"},"it":{"name":"Het Speels Modernisme. Ganshoren. 1958","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.ganshoren.be","email":"info.brunswyck@ganshoren.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.550162"},"sp":{"name":"Het Speels Modernisme. Ganshoren. 1958","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_u