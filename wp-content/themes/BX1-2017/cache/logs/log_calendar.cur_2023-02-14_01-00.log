11:00 to 18:00"],"it":["monday and sunday: closed","tuesday, wednesday, thursday, friday and saturday: from 11:00 to 18:00"],"sp":["monday and sunday: closed","tuesday, wednesday, thursday, friday and saturday: from 11:00 to 18:00"],"pt":["monday and sunday: closed","tuesday, wednesday, thursday, friday and saturday: from 11:00 to 18:00"],"cn":["monday and sunday: closed","tuesday, wednesday, thursday, friday and saturday: from 11:00 to 18:00"]},"date_start":"2022-12-16","date_end":"2023-02-25","is_also_by_appointment":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":{"list":[255,261,263,266],"translations":{"fr":["Accessible","Parking accessible","Accessible aux pi\u00e9tons appareill\u00e9s","Brussels Health Safety Label"],"nl":["Toegankelijk","Toegankelijke parking","Toegankelijk voor voetgangers met hulpmiddelen","Brussels Health Safety Label"],"en":["Accessible","Accessible parking","Accessible to pedestrians with mobility aids","Brussels Health Safety Label"],"de":["Barrierefrei","Barrierefreier Parkplatz","Barrierefrei f\u00fcr Fu\u00dfg\u00e4nger mit Gehhilfe","Brussels Health Safety Label"],"it":["Accessibile","Parcheggio accessibile","Accessibile ai pedoni con supporti","Brussels Health Safety Label"],"sp":["Habilitado","Estacionamiento habilitado","Habilitado para peatones con aud\u00edfonos","Brussels Health Safety Label"],"pt":[null,null,null,null],"cn":[null,null,null,null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2023-02-12T03:35:29+01:00","published_at":"2023-01-10T13:16:59+01:00","backoffice_id":268874,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.30285343213869},{"id":541022,"date_start":"2022-09-16","date_end":"2023-03-05","date_next":"2023-02-14","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung","it":"Esposizioni","sp":"Exhibici\u00f3n","pt":null,"cn":null}},"others":{"list":[36,42],"translations":{"fr":["Mus\u00e9es et art centers","Peinture"],"nl":["Musea en kunstcentra","Schilderkunst"],"en":["Museums and art centers","Painting"],"de":["Museen & Kunstzentren","Malerei"],"it":["Musei e centri artistici","Pittura"],"sp":["Museos y centros de arte","Pintura"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Ari\u00e9 Mandelbaum","shortdescr":"L\u2019exposition Ari\u00e9 Mandelbaum est une cr\u00e9ation originale du Mus\u00e9e Juif de Belgique. Souvent expos\u00e9, le travail du peintre Ari\u00e9 Mandelbaum (\u00b01939, Bruxelles) n\u2019avait jamais fait l\u2019objet d\u2019une r\u00e9trospective. Pour la premi\u00e8re fois, productions anciennes et cr\u00e9ations r\u00e9centes sont ici mises en dialogue, dans un parcours s\u2019\u00e9talant de 1957 \u00e0 2022.","longdescr":"L\u2019exposition Ari\u00e9 Mandelbaum est une cr\u00e9ation originale du Mus\u00e9e Juif de Belgique. Souvent expos\u00e9, le travail du peintre Ari\u00e9 Mandelbaum (\u00b01939, Bruxelles) n\u2019avait jamais fait l\u2019objet d\u2019une r\u00e9trospective. Pour la premi\u00e8re fois, productions anciennes et cr\u00e9ations r\u00e9centes sont ici mises en dialogue, dans un parcours s\u2019\u00e9talant de 1957 \u00e0 2022.\r\n\r\nFils d\u2019immigrants juifs polonais, Ari\u00e9 Mandelbaum commence \u00e0 peindre \u00e0 l\u2019\u00e2ge de seize ans. D\u00e8s le d\u00e9but des ann\u00e9es 1960, il est consid\u00e9r\u00e9 comme l\u2019un des talents les plus prometteurs de la peinture belge. Au cours des d\u00e9cennies suivantes, il m\u00e8ne une \u0153uvre au long cours, \u00e0 la fois singuli\u00e8re et exigeante. \u00c0 l\u2019expressionisme exacerb\u00e9 de ses d\u00e9buts, succ\u00e8de \u00e0 partir des ann\u00e9es 1980 une expression plus retenue, donnant naissance \u00e0 des \u0153uvres \u00e0 la fragilit\u00e9 troublante qu\u2019il poursuit jusqu\u2019\u00e0 aujourd\u2019hui.\r\n\r\nL\u2019exposition s\u2019articule autour de diff\u00e9rents th\u00e8mes. On d\u00e9couvre d\u2019abord la mani\u00e8re dont l\u2019artiste traite de l\u2019intimit\u00e9, avant que la politique \u2013 en particulier la contestation antiautoritaire de 1968 \u2013 ne t\u00e9lescope ses questionnements int\u00e9rieurs. Le parcours se poursuit par l\u2019exploration de l\u2019autoportrait et du corps, deux th\u00e8mes \u00e0 travers lesquels on voit le travail d\u2019Ari\u00e9 Mandelbaum se transformer en une r\u00e9flexion sur la trace, l\u2019absence, l\u2019effacement. La violence politique, notamment li\u00e9e au (n\u00e9o)colonialisme, fait alors un retour marqu\u00e9 dans son \u0153uvre. Au cours des deux derni\u00e8res d\u00e9cennies, celle-ci est toujours plus marqu\u00e9e par la m\u00e9moire de la Shoah \u2013 comme un retour du refoul\u00e9 chez cet enfant de la guerre qui restera toute sa vie un peintre indocile. \r\n\r\nLes oeuvres pr\u00e9sent\u00e9es proviennent des collections du Mus\u00e9e Juif de Belgique, mais aussi d\u2019institutions comme le Mus\u00e9e d\u2019Ixelles, le Mus\u00e9e de la Banque nationale de Belgique ou encore les collections de la F\u00e9d\u00e9ration Wallonie-Bruxelles. Nombre de collections priv\u00e9es ont \u00e9galement \u00e9t\u00e9 mobilis\u00e9es, notamment celles de particuliers ou encore la Belfius Art Collection.","performers":"Ari\u00e9 Mandelbaum (artiste)","boxoffice_url":null,"website":"http:\/\/www.mjb-jmb.org","email":"info@mjb-jmb.org","phone_contact":"+32 2 500 88 37","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.541022"},"nl":{"name":"Ari\u00e9 Mandelbaum","shortdescr":"De tentoonstelling Arie Mandelbaum is een originele creatie van het Joods Museum van Belgi\u00eb. Niettegenstaande het werk van de schilder Ari\u00e9 Mandelbaum (\u00b01939, Brussel) al dikwijls werd tentoongesteld, is er tot nog toe geen retrospectieve aan hem gewijd. Voor het eerst gaan hier vroege werken en recente creaties met elkaar in dialoog over een periode van 1957 tot 2022.","longdescr":"De tentoonstelling Arie Mandelbaum is een originele creatie van het Joods Museum van Belgi\u00eb. Niettegenstaande het werk van de schilder Ari\u00e9 Mandelbaum (\u00b01939, Brussel) al dikwijls werd tentoongesteld, is er tot nog toe geen retrospectieve aan hem gewijd. Voor het eerst gaan hier vroege werken en recente creaties met elkaar in dialoog over een periode van 1957 tot 2022.\r\n\r\nAls zoon van Pools-Joodse immigranten begint Ari\u00e9 Mandelbaum op zestienjarige leeftijd met schilderen. Vanaf begin jaren zestig wordt hij beschouwd als een van de meest beloftevolle talenten van de Belgische schilderkunst. Hij cre\u00ebert een eigenzinnig en meeslepend oeuvre dat hij de daaropvolgende decennia verder ontwikkelt. Vanaf de jaren tachtig wordt het uitbundig expressionisme van zijn beginjaren gevolgd door een meer ingetogen expressie, die leidt tot werken met een verontrustende fragiliteit die hij tot op de dag van vandaag maakt.\r\n\r\nDe tentoonstelling is opgebouwd rond verschillende thema\u2019s. Eerst ontdekken we de manier  waarop de kunstenaar omgaat met intimiteit, voordat de politiek \u2013 in het bijzonder het antiautoritaire protest van 1968 \u2013 zijn innerlijke vragen binnensluipt. Het parcours gaat verder met de verkenning van het zelfportret en het lichaam, twee thema\u2019s aan de hand waarvan we het werk van Ari\u00e9 Mandelbaum zien transformeren in een reflectie op afwezigheid, uitwissing, achtergelaten sporen. Politiek geweld, met name gerelateerd aan het (neo)kolonialisme, maakt dan een uitge\r\nsproken comeback in zijn werk. De laatste twee decennia wordt het steeds meer gekenmerkt door de herinnering aan de Shoah \u2013 als een terugkeer van verdrongen gevoelens bij dit oorlogskind dat zijn hele leven een rebelse schilder zal blijven. \r\n\r\nDe voorgestelde werken zijn afkomstig uit de collecties van het Joods Museum van Belgi\u00eb, maar ook van instellingen zoals het Museum van Elsene, het Museum van de Nationale Bank van Belgi\u00eb of de collecties van de Federatie Walloni\u00eb-Brussel. Er is ook een beroep gedaan op een aantal particuliere collecties, met name die van de Belfius Kunstcollectie.","performers":"Ari\u00e9 Mandelbaum (artiest)","boxoffice_url":null,"website":"http:\/\/www.mjb-jmb.org","email":"info@mjb-jmb.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.541022"},"en":{"name":"Ari\u00e9 Mandelbaum","shortdescr":"The Arie Mandelbaum exhibition is an original creation of the Jewish Museum of Belgium. Frequently exhibited, the work of painter Ari\u00e9 Mandelbaum (\u00b01939, Brussels) had not yet been the subject of a retrospective. For the first time, old productions and recent creations engage in dialogue here, in a journey which starts in 1957 and ends in 2022.","longdescr":"The Arie Mandelbaum exhibition is an original creation of the Jewish Museum of Belgium. Frequently exhibited, the work of painter Ari\u00e9 Mandelbaum (\u00b01939, Brussels) had not yet been the subject of a retrospective. For the first time, old productions and recent creations engage in dialogue here, in a journey which starts in 1957 and ends in 2022.\r\n\r\nAri\u00e9 Mandelbaum, the son of Polish Jewish immigrants, began painting at the age of sixteen. As from the early 1960s, he was considered one of the most promising talents in Belgian painting. His idiosyncratic and compelling oeuvre continued to develop over the decades that followed. After the heightened expressionism of his early days, greater restraint followed as of the 1980s, giving rise to works of disturbing fragility, which he has created to this day.\r\n\r\nThe exhibition is structured around different themes. We first discover the way in which the artist deals with intimacy, before politics \u2013 especially the anti-authoritarian protest of 1968 \u2013 telescopes his soul-searching. The visit continues with the exploration of the self-portrait and the body, two themes through which we see the work of Ari\u00e9 Mandelbaum transform into a reflection on trace, absence and erasure. Political violence, particularly related to (neo)colonialism, then made a marked return in his work. Over the past two decades, it has become increasingly influenced by the memory of the Shoah \u2013 as a return to what was repressed in this child of the war, who will remain a rebel painter all his life.\r\n\r\nThe works presented come from the collections of the Jewish Museum of Belgium, but also from institutions such as the Museum of Ixelles, the Museum of the National Bank of Belgium or the collections of the Wallonia-Brussels Federation. A number of private collections have also been mobilized, in particular those of private individuals and the Belfius Art Collection.","performers":"Ari\u00e9 Mandelbaum (artist)","boxoffice_url":null,"website":"http:\/\/www.mjb-jmb.org","email":"info@mjb-jmb.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.541022"},"de":{"name":"Ari\u00e9 Mandelbaum","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.mjb-jmb.org","email":"info@mjb-jmb.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.541022"},"it":{"name":"Ari\u00e9 Mandelbaum","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.mjb-jmb.org","email":"info@mjb-jmb.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.541022"},"sp":{"name":"Ari\u00e9 Mandelbaum","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.mjb-jmb.org","email":"info@mjb-jmb.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.541022"},"pt":{"name":"Ari\u00e9 Mandelbaum","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.mjb-jmb.org","email":"info@mjb-jmb.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.541022"},"cn":{"name":"Ari\u00e9 Mandelbaum","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.mjb-jmb.org","email":"info@mjb-jmb.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.541022"}},"place":{"id":209899,"translations":{"fr":{"name":"Mus\u00e9e Juif de Belgique","address_street_name":"Rue des Minimes","address_street_number":"21","address_street_box":null,"email":"info@mjb-jmb.org","website":"http:\/\/www.mjb-jmb.org","phone_contact":"+32 2 512 19 63","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Minimes, 21","address_line2":"1000 Bruxelles","description_web":"Situ\u00e9 \u00e0 Bruxelles, dans le quartier du Sablon, le Mus\u00e9e Juif de Belgique porte un regard novateur sur l\u2019histoire et la culture juive \u00e0 travers des expositions et des activit\u00e9s tourn\u00e9es vers le partage, la d\u00e9couverte et l\u2019accessibilit\u00e9 \u00e0 tous les publics. \r\n \r\nR\u00e9solument ancr\u00e9 dans le pr\u00e9sent, c\u2019est un lieu culturel et artistique vivant, dynamique, pluridisciplinaire, emmen\u00e9 par une \u00e9quipe qui porte haut les valeurs d\u2019ouverture avec audace et modernit\u00e9 dont l\u2019objectif est de promouvoir la connaissance et la compr\u00e9hension de l\u2019histoire, de la religion et des cultures juives.\r\n \r\nA travers ses trois missions principales que sont la conservation du patrimoine juif de Belgique, les expositions temporaires en \u00e9cho \u00e0 des sujets d\u2019actualit\u00e9 et les activit\u00e9s \u00e9ducatives \u00e0 destination des publics scolaires, l\u2019\u00e9quipe construit progressivement le visage du Nouveau Mus\u00e9e qui verra le jour d\u2019ici 2025.\r\n \r\nEn attendant le d\u00e9but des travaux les visiteurs peuvent d\u00e9couvrir, sur deux b\u00e2timents et cinq \u00e9tages, une s\u00e9lection de la collection permanente, et plusieurs expositions temporaires. En parall\u00e8le, le Mus\u00e9e organise pl\u00e9thore d\u2019activit\u00e9s comme des conf\u00e9rences, concerts, ateliers, soir\u00e9es litt\u00e9raires.","description_print":"","booking_url":"https:\/\/ticket.visit.brussels\/fr\/209899\/Musee-Juif-de-Belgique%20\/shop","sort_order":"Jewish Museum of Belgium","virtual_visit":null},"nl":{"name":"Joods Museum van Belgi\u00eb","address_street_name":"Minimenstraat","address_street_number":"21","address_street_box":null,"email":"info@mjb-jmb.org","website":"http:\/\/www.mjb-jmb.org\/?lang=nl","phone_contact":"+32 2 512 19 63","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Minimenstraat, 21","address_line2":"1000 Brussel","description_web":"Het Joods Museum van Belgi\u00eb, gelegen in de Brusselse Zavelwijk, biedt een vernieuwende kijk op de joodse geschiedenis en cultuur aan de hand van tentoonstellingen en activiteiten die gericht zijn op uitwisseling, kennismaking en toegankelijkheid voor alle mogelijke doelgroepen. \r\n \r\nDoor zijn stevige verankering in het heden is het Museum een levendige, dynamische en multidisciplinaire culturele en artistieke locatie, die wordt gedragen door een team dat de waarden van openheid op doortastende en eigentijdse wijze uitdraagt, met de bedoeling om kennis en inzicht in de joodse geschiedenis, godsdienst en culturen te bevorderen.\r\n \r\nVia zijn drie hoofdopdrachten - het behoud van het Belgische joodse erfgoed, tijdelijke tentoonstellingen die aansluiten bij actuele onderwerpen en educatieve activiteiten voor scholen - bouwt het team geleidelijk aan het gezicht uit van het Nieuwe Museum dat tegen 2025 tot stand zal komen.\r\n \r\nIn afwachting van de werken kunnen de bezoekers verspreid over twee gebouwen en vijf verdiepingen kennismaken met een selectie van de permanente collectie en enkele tijdelijke tentoonstellingen. Tegelijk organiseert het Museum een ruime keuze aan activiteiten, zoals lezingen, concerten, workshops en literaire avonden.","description_print":"","booking_url":"https:\/\/ticket.visit.brussels\/nl\/209899\/Musee-Juif-de-Belgique%20\/shop","sort_order":null,"virtual_visit":null},"en":{"name":"Jewish Museum of Belgium","address_street_name":"Rue des Minimes","address_street_number":"21","address_street_box":null,"email":"info@mjb-jmb.org","website":"http:\/\/www.mjb-jmb.org","phone_contact":"+32 2 512 19 63","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue des Minimes, 21","address_line2":"1000 Brussels","description_web":"Located in the Sablon district of Brussels, the Jewish Museum of Belgium takes a fresh look at Jewish history and culture through exhibitions and activities focusing on sharing, discovery and accessibility for all sectors of the public. \r\n \r\nFirmly anchored in the present day, it is an artistic and cultural place that is lively, dynamic and multidisciplinary, led by a team that values openness, boldness and modernity, and whose goal is to promote a knowledge and understanding of Jewish history, religion and culture.\r\n \r\nThrough its three principal missions, namely the preservation of Jewish heritage in Belgium, temporary exhibitions reflecting topical subjects and educational activities for school groups, the team is gradually constructing the public face of the New Museum that will open its doors by 2025.\r\n \r\nPending the start of work, visitors can discover a selection of the permanent collection as well as several temporary exhibitions in two buildings covering a total area of five floors. At the same time, the Museum organises a wide range of activities such as conferences, concerts, workshops and literary evenings.","description_print":"","booking_url":"https:\/\/ticket.visit.brussels\/en\/209899\/Musee-Juif-de-Belgique%20\/shop","sort_order":null,"virtual_visit":null},"de":{"name":"Mus\u00e9e Juif de Belgique","address_street_name":"Rue des Minimes","address_street_number":"21","address_street_box":null,"email":"info@mjb-jmb.org","website":"http:\/\/www.mjb-jmb.org","phone_contact":"+32 2 512 19 63","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Minimes, 21","address_line2":"1000 Bruxelles","description_web":"Das J\u00fcdische Museum Belgiens im Sablon-Viertel wirft anhand von Ausstellungen und Aktivit\u00e4ten einen Blick auf die j\u00fcdische Geschichte und Kultur. \r\n\r\nAls lebendiger und dynamischer Ort der Kultur und der Kunst m\u00f6chte das Museum Wissen und Verst\u00e4ndnis f\u00fcr die Geschichte des j\u00fcdischen Glaubens und der Kulturen vermitteln. \r\n\r\nDie drei wichtigsten Missionen sind hierbei die Bewahrung des j\u00fcdischen Kulturguts in Belgien, Wechselausstellungen zu aktuellen Themen sowie Konferenzen, Konzerte, Workshops und Literaturabende.\r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Mus\u00e9e Juif de Belgique","address_street_name":"Rue des Minimes","address_street_number":"21","address_street_box":null,"email":"info@mjb-jmb.org","website":"http:\/\/www.mjb-jmb.org","phone_contact":"+32 2 512 19 63","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Minimes, 21","address_line2":"1000 Bruxelles","description_web":"","descri