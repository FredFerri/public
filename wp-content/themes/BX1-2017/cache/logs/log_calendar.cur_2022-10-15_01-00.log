Accessible parking","Adapted toilet"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-11T05:06:01+02:00","published_at":"2022-10-03T15:22:03+02:00","backoffice_id":262977,"import_origin":null,"sub_type":"misc","show_in_agenda":true,"ranking":1.2599210498949},{"id":540578,"date_start":"2022-10-16","date_end":"2022-10-16","date_next":"2022-10-16","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen"}},"others":{"list":[109],"translations":{"fr":["Espaces verts"],"nl":["Groene zones"],"en":["Green spaces"],"de":["Gr\u00fcnfl\u00e4chen"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Promenades guid\u00e9es des arbres remarquables \u00e0 Ixelles","shortdescr":"Suite au succ\u00e8s rencontr\u00e9 au printemps dernier de nouvelles promenades guid\u00e9es ont \u00e9t\u00e9 programm\u00e9es pour (re)d\u00e9couvrir les arbres remarquables d\u2019Ixelles.","longdescr":"Suite au succ\u00e8s rencontr\u00e9 au printemps dernier de nouvelles promenades guid\u00e9es ont \u00e9t\u00e9 programm\u00e9es pour (re)d\u00e9couvrir les arbres remarquables d\u2019Ixelles*  :\r\n\r\n- Samedi 3 septembre de 9h30 \u00e0 12h00: Etangs d\u2019Ixelles \r\n- Dimanche 16 octobre de 9h30 \u00e0 12h00: Tenbosch \r\n- Vendredi 11 novembre de 9h30 \u00e0 12h00: Boondael\r\n\r\nComme vous le savez, Ixelles a la chance de compter plus de 400 arbres remarquables sur son territoire dont certains vivent paisiblement depuis plusieurs centaines d'ann\u00e9es ! \r\n\r\n\u2705 Dix arbres remarquables ont \u00e9t\u00e9 retenus pour composer chacune des balades dans trois quartiers privil\u00e9gi\u00e9s : les Etangs d'Ixelles, le quartier Boondael, au sud de la commune et, enfin, le quartier outre Louise autour du parc Tenbosch et de l'avenue Louis Lepoutre. \r\n\u2705 Les balades sont disponibles dans les trois langues (FR-NED-ENG), en ligne \u00e0 cette adresse ou en format papier reprenant, pour chacune d'elle, le plan de la promenade ainsi qu'une fiche d'identit\u00e9 de chaque arbre d\u00e9voilant leurs secrets et bienfaits pour l'environnement. \r\n\r\n\u261d Pour rappel, ces promenades constituent \u00e9galement l'une des trente mesures du Plan Arbres de la commune d'Ixelles, consultable ici : https:\/\/www.ixelles.be\/site\/888-Plan-arbres\r\n\r\n* L\u2019itin\u00e9raire peut \u00eatre adapt\u00e9 pour les personnes \u00e0 mobilit\u00e9 r\u00e9duite, les enfants y sont accueillis \u00e0 partir de 7 ans et les inscriptions sont obligatoires via l'adresse tourisme@ixelles.brussels","performers":null,"boxoffice_url":null,"website":"http:\/\/www.ixelles.be","email":"tourisme@ixelles.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.540578"},"nl":{"name":"Promenades guid\u00e9es des arbres remarquables \u00e0 Ixelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.540578"},"en":{"name":"Promenades guid\u00e9es des arbres remarquables \u00e0 Ixelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.540578"},"de":{"name":"Promenades guid\u00e9es des arbres remarquables \u00e0 Ixelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.540578"},"it":{"name":"Promenades guid\u00e9es des arbres remarquables \u00e0 Ixelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.540578"},"sp":{"name":"Promenades guid\u00e9es des arbres remarquables \u00e0 Ixelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.540578"},"pt":{"name":"Promenades guid\u00e9es des arbres remarquables \u00e0 Ixelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.540578"},"cn":{"name":"Promenades guid\u00e9es des arbres remarquables \u00e0 Ixelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.540578"}},"place":{"id":266022,"translations":{"fr":{"name":"Parc Tenbosch","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc Tenbosch","address_line2":"1000 Bruxelles","description_web":"\u00c0 Ixelles, le parc Tenbosch est un bout de nature au c\u0153ur d\u2019un quartier dens\u00e9ment b\u00e2ti. Il a \u00e9t\u00e9 cr\u00e9\u00e9 par le dendrologue (botaniste sp\u00e9cialiste des arbres) Jean-Louis Semet, avec l\u2019aide d\u2019Hector Noyer, jardinier. Ensemble, ils ont transform\u00e9 cet espace vert en jardin botanique et en arboretum constitu\u00e9 de plantes rares. Aujourd\u2019hui, le parc poss\u00e8de toujours des sp\u00e9cimens uniques en Belgique. Il est aussi un refuge pour les oiseaux de ville.\r\n\r\nProfitez de votre promenade dans ce parc pour aller vous balader dans les espaces verts proches, dont les \u00e9tangs d\u2019Ixelles, les jardins de l\u2019abbaye de la Cambre et le bois de la Cambre.\r\n\r\nPour faire une pause gourmande \u00e0 proximit\u00e9 du parc Tenbosch, direction Old Boy ou Lil Boy, des bistrot et point de vente \u00e0 emporter de cuisine asiatique.","description_print":"Le parc Tenbosch est n\u00e9 des r\u00eaves fous de Jean-Louis Semet, dendrologue de la fin du 19\u00e8me et de son chef jardinier Hector Noyer : planter un arboretum d\u2019arbres rares \u00e0 Bruxelles. L\u00e0 o\u00f9 s\u2019\u00e9talaient les vergers et potagers de l\u2019ancien Ch\u00e2teau Ferme de Tenbosch, ils ont rassembl\u00e9 des arbres et des arbustes remarquables, parfois uniques pour Bruxelles ou la Belgique, comme ce Plaqueminier d\u2019Italie qui vient d\u2019Asie, parent de l\u2019Eb\u00e8ne et dont les fruits comestibles rappellent les kakis. Un vrai jardin botanique priv\u00e9 qui devint parc public en 1981. ","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Tenboschpark","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Tenboschpark","address_line2":"1000 Brussel","description_web":"Het Elsense Tenboschpark is een stukje natuur in het hart van een dichtbebouwde buurt. Het kwam er dankzij een boomdeskundige, Jean-Louis Semet. Die kreeg de hulp van Hector Noyer, een tuinman. Samen maakten ze van een groene ruimte een ware botanische tuin met een arboretum van zeldzame planten. Die vind je er vandaag de dag nog altijd. Het park is ook een toevluchtsoord voor stadsvogels.\r\n\r\nTrek van het Tenboschpark zeker ook naar de vijvers van Elsene voor een wandeling. De tuinen van de Terkamerenabdij en het Terkamerenbos liggen ook in de buurt.\r\n\r\nZin in iets lekkers? In de buurt van het Tenboschpark is er keuze te over. Old Boy en Lil Boy, de bekende Aziatische resto\u2019s, liggen er om de hoek.","description_print":"Het Tenboschpark is ontstaan uit de bizarre dromen van Jean-Louis Semet, een boomkundige die leefde aan het einde van de 19de eeuw, en zijn hoofdtuinier Hector Noyer: een arboretum met zeldzame bomen aanleggen in Brussel. Daar waar de boomgaarden en moestuinen van de voormalige kasteelboerderij van Tenbosch zich uitstrekten, verzamelden zij opmerkelijke en soms voor Brussel of Belgi\u00eb unieke bomen en struiken, zoals deze dadelpruimenboom uit Itali\u00eb die uit Azi\u00eb afkomstig is, en verwant is aan de ebbenboom waarvan de eetbare vruchten kaki\u2019s worden genoemd. Een echte botanische priv\u00e9tuin die in 1981 werd opengesteld voor het publiek. ","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Tenbosch Park","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Tenbosch Park","address_line2":"1000 Brussels","description_web":"In Ixelles, Tenbosch Park is a little slice of nature in the heart of a densely built-up area. It was created by dendrologist (tree botanist) Jean-Louis Semet, with the help of gardener Hector Noyer. Together, they transformed this green space into a botanical garden and arboretum of rare plants. Today, the park still has specimens that are unique in Belgium. It's also a refuge for city birds.\r\n\r\nTake advantage of your walk through this park to go for a stroll in the nearby green spaces, like the Ixelles ponds, the gardens of La Cambre Abbey and the Bois de la Cambre.\r\n\r\nFor a gourmet break near Tenbosch Park, head to Old Boy or Lil Boy, Asian food bistros that also offer takeaway food.","description_print":"Tenbosch Park is the crazy brainchild of Jean-Louis Semet, a dendrologist at the end of the 19th century, and his chief gardener Hector Noyer, namely to create an arboretum of rare trees in Brussels. They gathered remarkable trees and bushes, some of which unique in Brussels or Belgium, such as the Italian Plaqueminier which comes from Asia and is related to Ebony, whose edible fruits are called kakis, at the site of the orchards and vegetable plots of the old fortified farm of Tenbosch \u2013 a real private botanical garden which became a public park in 1981. ","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Parc Tenbosch","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc Tenbosch","address_line2":"1000 Bruxelles","description_web":"Der Parc Tenbosch in Ixelles ist eine charmante, gr\u00fcne Oase im Herzen eines dicht besiedelten Stadtviertels. Angelegt wurde er von dem Baumbotaniker Jean-Louis Semet und dem Landschaftsg\u00e4rtner Hector Noyer. Gemeinsam verwandelten sie die Gr\u00fcnfl\u00e4che in einen botanischen Garten mit Arboretum und seltenen Pflanzen. Bis heute kann man hier einige dieser in Belgien teilweise einzigartigen Exemplare bewundern. Der Park dient Stadtv\u00f6geln zudem als Ruhe- und Nistst\u00e4tte.\r\n\r\nWenn Sie Ihren Spaziergang noch etwas in die L\u00e4nge ziehen m\u00f6chten, dann begeben Sie sich in die nahegelegenen Gr\u00fcnanlagen - von den Teichen von Ixelles \u00fcber die G\u00e4rten der Abtei La Cambre bis hin zum Bois de la Cambre.\r\n\r\nAls Gourmetpause in der N\u00e4he des Parc Tenbosch bieten sich die beiden asiatischen Restaurants Old Boy oder Lil Boy an, die auch Take-away-Speisen auf der Speisekarte haben.","description_print":"Der Parc Tenbosch in Ixelles ist eine charmante, gr\u00fcne Oase im Herzen eines dicht besiedelten Stadtviertels. Angelegt wurde er von dem Baumbotaniker Jean-Louis Semet und dem Landschaftsg\u00e4rtner Hector Noyer. Gemeinsam verwandelten sie die Gr\u00fcnfl\u00e4che in einen botanischen Garten mit Arboretum und seltenen Pflanzen. Bis heute kann man hier einige dieser in Belgien teilweise einzigartigen Exemplare bewundern. Der Park dient Stadtv\u00f6geln zudem als Ruhe- und Nistst\u00e4tte.\r\n\r\nWenn Sie Ihren Spaziergang noch etwas in die L\u00e4nge ziehen m\u00f6chten, dann begeben Sie sich in die nahegelegenen Gr\u00fcnanlagen - von den Teichen von Ixelles \u00fcber die G\u00e4rten der Abtei La Cambre bis hin zum Bois de la Cambre. \r\n\r\nAls Gourmetpause in der N\u00e4he des Parc Tenbosch bieten sich die beiden asiatischen Restaurants Old Boy oder Lil Boy an, die auch Take-away-Speisen auf der Speisekarte haben.","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Parc Tenbosch","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc Tenbosch","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Parque Tenbosch","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Parque Tenbosch","address_line2":"1000 Bruxelles","description_web":"","description_print":"El Parque Tenbosch es la alocada idea de Jean-Louis Semet, un dendr\u00f3logo de finales del siglo XIX y su jardinero jefe Hector Noyer, concretamente para crear un jard\u00edn bot\u00e1nico de \u00e1rboles peculiares en Bruselas. Recopilaron una cantidad notable de \u00e1rboles y arbustos, algunos de ellos \u00fanicos de Bruselas, tales como el Caqui Italiano proveniente de Asia y relacionado con el \u00c9bano, cuyo fruto comestible es llamado caqui, en este lugar se encuentran los huertos y las parcelas de hortalizas de la antigua granja fortificada de Tenbosch \u2013 un jard\u00edn bot\u00e1nico privado real que se convirti\u00f3 en un parque p\u00fablico en 1981.\r\n ","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Parc Tenbosch","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc Tenbosch","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Parc Tenbosch","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc Tenbosch","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[6],"translations":{"fr":["Chatelain\/Bailli"],"nl":["Kasteleinswijk\/Baljuw"],"en":["Chatelain\/Bailli"]}},"zones":{"list":[21],"translations":{"fr":["Sud"],"nl":["Zuid"],"en":["South"]}},"neca":null,"facebook_id":null,"backoffice_id":26022,"location":{"lat":50.82000466,"lon":4.36486065},"region":"brussels","last_updated_at":"2022-10-11T06:06:31+02:00","published_at":"2016-06-08T17:29:08+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":271128,"translations":{"fr":{"name":"Service de la Culture d'Ixelles","address_street_name":"Rue Mercelis","address_street_number":"19","address_street_box":null,"email":"culture@ixelles.brussels",