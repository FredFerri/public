":{"title":"Club Matulu","copyright":null}}}],"dates":[{"day":"2024-09-24","doors":null,"start":"19:00:00","end":"21:30:00","end_night_life":null,"is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"de":{"name":"Normal"},"en":{"name":"Normal"},"it":{"name":"Normale"},"fr":{"name":"Normal"},"sp":{"name":"Normal"},"nl":{"name":"Normaal"}},"value":0}],"date_exceptions":[],"closing_days":[],"child_events":[],"parent_events":[],"accessibilities":[],"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[]},{"id":5700001084,"date_start":"2024-09-24","date_end":"2024-09-24","date_next":"2024-09-24","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":true,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-09-06T16:22:03+02:00","published_at":"2024-09-06T16:11:25+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":307364,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"concert","ranking":1,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":1,"translations":{"de":"Konzert","pt":null,"en":"Concert","it":"Concerti","cn":null,"fr":"Concert","sp":"Concierto","nl":"Concert"}},"others":{"list":[2],"translations":{"de":["Klassisch"],"pt":[null],"en":["Classical"],"it":["Classica"],"cn":[null],"fr":["Classique"],"sp":["Cl\u00e1sica"],"nl":["Klassiek"]}}},"translations":{"de":{"name":"Concert classique piano: Pianiste Maria Bundgaard de Paris","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.facebook.com\/events\/1238815590885114\/?ref=newsfeed","email":"danskekirke@gmail.com","phone_contact":"+32 2 660 93 34","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700001084"},"pt":{"name":"Concert classique piano: Pianiste Maria Bundgaard de Paris","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.facebook.com\/events\/1238815590885114\/?ref=newsfeed","email":"danskekirke@gmail.com","phone_contact":"+32 2 660 93 34","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700001084"},"en":{"name":"Solo piano recital de Maria Bundg\u00e5rd","shortdescr":null,"longdescr":"\n\nPianiste danoise aux origines polonaises, Maria Bundg\u00e5rd est n\u00e9e \u00e0 Varde au\nDanemark en 1991 et install\u00e9e \u00e0 Paris depuis 2014. Toute jeune, elle r\u00eavait de\njouer le concerto pour violon de Tcha\u00efkovski. Ses parents, craignant qu\u2019elle ne\nfinisse comme le fils de leurs voisins qui travaillait sa trompette le matin dans le\njardin d\u2019\u00e0 c\u00f4t\u00e9, ont pr\u00e9f\u00e9r\u00e9 l\u2019orienter vers le piano, et elle commence \u00e0 jouer \u00e0 l\u2019\u00e2ge\nde 10 ans. En 2006, \u00e0 l\u2019\u00e2ge de 14 ans, elle remporte le premier prix au Festival\nDanois de piano Steinway et repr\u00e9sente le Danemark au Festival international de\npiano Steinway \u00e0 Hambourg.\nEn 2010, elle entre \u00e0 l\u2019Acad\u00e9mie royale danoise de musique \u00e0 Copenhague pour\nsuivre les cours du pianiste Jens Elvekj\u00e6r. En 2012, elle poursuit ses \u00e9tudes \u00e0\nl\u2019Universit\u00e9 de musique Fr\u00e9deric Chopin \u00e0 Varsovie avec Bronis\u0142awa Kawalla et\nRobert Morawski.\n\nAyant obtenu sa licence en musique de l\u2019Acad\u00e9mie royale danoise en juin 2013 en\njouant le 2eme concerto de Chopin et les Images par Debussy, elle commence ses\n\u00e9tudes \u00e0 la Schola Cantorum de Paris avec Eugen Indjic et Narcis Bonet. En\nnovembre 2014, elle joue Jeux d\u2019eau de Ravel lors de l\u2019inauguration de la\nFondation Danoise \u00e0 Paris et re\u00e7oit une bourse de la princesse Marie de\nDanemark. Elle obtient son dipl\u00f4me sup\u00e9rieur de la Schola Cantorum de Paris en\njuin 2015.\nSon premier CD, Le son de l\u2019eau (Debussy, Ravel, Gaubert, Liszt), est sorti en avril\n2016, en m\u00eame temps que son premier livre avec plusieurs pr\u00e9sentations \u00e0\nDanmarks Radio, l\u2019entreprise de radio-t\u00e9l\u00e9vision publique du Danemark. Le CD\nsuivant From Russia with love (Tcha\u00efkovski, Scriabine, Rachmaninov et P\u00e4rt) est\nsorti en novembre 2016, au m\u00eame moment que son livre suivant. En juin 2017, elle\nobtient son master 2 en performance pianistique de l\u2019Acad\u00e9mie royale danoise \u00e0\nCopenhague.\n\nAu printemps 2019, elle sort son troisi\u00e8me album, L\u2019amour au milieu des\nruines (Mendelssohn, Chopin, Brahms, Liszt, Schumann) ainsi que son troisi\u00e8me\nlivre.\nCes disques sont r\u00e9guli\u00e8rement jou\u00e9s \u00e0 la Radio Nationale danoise, Danmarks\nRadio.\nEn juillet 2019 elle re\u00e7oit le 1er prix dans sa cat\u00e9gorie de musique au Prix d\u2019Europe\n\u00e0 Paris.\n\nEn 2022, Maria Bundg\u00e5rd est sujet d\u2019un portrait en forme de podcast par Le\nBicolore \/ L\u2019Ambassade du Danemark en France : Les Autres Danois : Maria Bundg\u00e5rd | Le Bicolore.\n\nAu printemps 2023 ainsi qu\u2019au printemps 2024 elle gagne la r\u00e9sidence artistique \u00e0\nl\u2019Accademia di Danimarca \u00e0 Villa Borgh\u00e8se \u00e0 Rome.\n\nEn 2023, Maria Bundg\u00e5rd sort son 4eme disque, Maria Bundgard plays Rachmaninoff \u2013 un hommage au compositeur Russe pour son 150\u00e8me anniversaire.\n\n\u201cUn grand bravo \u00e0 Maria Bundgard pour la qualit\u00e9 des interpr\u00e9tations des \u0153uvres de mon arri\u00e8re grand-p\u00e8re Sergue\u00ef Rachmaninoff. Elle sait percevoir avec d\u00e9licatesse la richesse et la profondeur de sa musique ainsi que sa personnalit\u00e9 exceptionnelle. Elle r\u00e9ussit \u00e0 nous transmettre avec \u00e9motion une illustration de l\u2019\u00e2me de ce grand compositeur et pianiste ! \n\u2013 Alexandra Conus-Rachmaninoff\u201d\n\nMaria Bundg\u00e5rd a travaill\u00e9 avec plusieurs grands pianistes : Marianna Shirinyan,\nPaolo Giacometti, Jos\u00e9 Rib\u00e9ra, Ferenc Rados et Philippe Raskin. Elle a \u00e9t\u00e9\nsoutenue financi\u00e8rement par la Fondation de la Reine Margrethe et du Prince\nHenrik de Danemark, La Fondation Wilhelm Hansen et La Fondation Arne Harrist\u00f8\nentre autres.","performers":"Solo piano recital by Maria Bundgaard, a Danish pianist residing in Paris. \nThe concert's program is strongly inspired by the history of Italian music and a personal search for romance in baroque structures. \nShe plays i.a. Scarlatti's beautiful Sonata No. 466, Bach's legendary Chaconne as well as Richard Wagner's Elegy, which he is said to have played the day before his death in Venice.","boxoffice_url":null,"website":"https:\/\/www.facebook.com\/events\/1238815590885114\/?ref=newsfeed","email":"danskekirke@gmail.com","phone_contact":"+32 2 660 93 34","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700001084"},"it":{"name":"Concert classique piano: Pianiste Maria Bundgaard de Paris","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.facebook.com\/events\/1238815590885114\/?ref=newsfeed","email":"danskekirke@gmail.com","phone_contact":"+32 2 660 93 34","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700001084"},"cn":{"name":"Concert classique piano: Pianiste Maria Bundgaard de Paris","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.facebook.com\/events\/1238815590885114\/?ref=newsfeed","email":"danskekirke@gmail.com","phone_contact":"+32 2 660 93 34","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/eve