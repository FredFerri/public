ail":"medexmuseum@gmail.com","website":"http:\/\/www.medexmuseum.com","phone_contact":"+32 488 50 60 42","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Longue Vie, 34A","address_line2":"1050 Ixelles","description_web":"Un mus\u00e9e qui n\u2019en est pas un, un mus\u00e9e valise qui porte une vision de la culture dans diff\u00e9rents endroits le temps d\u2019une exposition, d\u2019une performance ou d\u2019un \u00e9v\u00e9nement. \r\n\r\nLe Medex est un mus\u00e9e itin\u00e9rant, en d\u00e9placement, fait pour porter l'attention sur la th\u00e9matique de la migration et ses enjeux. Il est bas\u00e9 actuellement dans un ancien CARWASH \u00e0 Ixelles dans le quartier Matongu\u00e9.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Medex (Mus\u00e9e \u00e9ph\u00e9m\u00e8re de l'exil)","address_street_name":"Lang-Levenstraat","address_street_number":"34A","address_street_box":null,"email":"medexmuseum@gmail.com","website":"http:\/\/www.medexmuseum.com","phone_contact":"+32 488 50 60 42","phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"Lang-Levenstraat, 34A","address_line2":"1050 Elsene","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Medex (Mus\u00e9e \u00e9ph\u00e9m\u00e8re de l'exil)","address_street_name":"Rue Longue Vie","address_street_number":"34A","address_street_box":null,"email":"medexmuseum@gmail.com","website":"http:\/\/www.medexmuseum.com","phone_contact":"+32 488 50 60 42","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Longue Vie, 34A","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Medex (mus\u00e9e \u00e9ph\u00e9m\u00e8re de l'exil)","address_street_name":"Rue Longue Vie","address_street_number":"34A","address_street_box":nul