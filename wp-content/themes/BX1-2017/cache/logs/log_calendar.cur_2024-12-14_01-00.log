},"educational_targets":{"list":[],"translations":{}},"tags":["high_capacity","major_event","exterior"]},{"id":5700001865,"date_start":"2024-10-09","date_end":"2025-03-09","date_next":"2024-12-13","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-12-13T01:03:06+01:00","published_at":"2024-09-29T11:43:51+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":308592,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"other","ranking":0.4721631957086834,"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[46,36],"translations":{"de":["Multidisziplin\u00e4r","Museen & Kunstzentren"],"pt":[null,null],"en":["Multidisciplinary","Museums and art centers"],"it":["Multidisciplinare","Musei e centri artistici"],"cn":[null,null],"fr":["Pluridisciplinaire","Mus\u00e9es et art centers"],"sp":["Multidisciplinar","Museos y centros de arte"],"nl":["Multidisciplinair","Musea en kunstcentra"]}}},"translations":{"de":{"name":"Exhibition Terracotta Army & the First Emperor of China","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/terracotta-exhibition.com\/fr\/","email":"info@terracotta-exhibition.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700001865"},"pt":{"name":"Exhibition Terracotta Army & the First Emperor of China","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/terracotta-exhibition.com\/fr\/","email":"info@terracotta-exhibition.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700001865"},"en":{"name":"Exhibition Terracotta Army & the First Emperor of China","shortdescr":"\u201cTerracotta Army. And The First Emperor of China\u201d exhibition is an extraordinary voyage in Ancient China of 2,200 years ago. Discover one of the greatest archeological discoveries of the 20th century, witness the life of the First Emperor and meet its people!","longdescr":"In an unprecedented setting, this exhibition brings together over 300 reproductions of statues, chariots, weapons and objects discovered in the necropolis' pits. They were created by Chinese craftsmen from the Wi'an region, where the excavations took place, with particular attention to detail to preserve the beauty and authenticity of the original works.\n\nThe realism of these reproductions is enhanced by an impressive decor and a spectacular audiovisual and lighting system. To fully appreciate these cultural treasures, visitors can also enjoy videos projected on giant screens, audio commentaries and an interactive zone to immerse themselves in this unique atmosphere.\nThis immersion into the heart of the necropolis of China's First Emperor is aimed at a wide audience. \n\nSpanning no less than 1,800 m\u00b2, the exhibition covers a broad range of themes: the history of the First Emperor, his original army, his military conquests, his empire, the process of creating the soldiers of the Terracotta Army, the Emperor's tomb, the history of archaeological excavations... It also features impressive exhibits such as the life-size reproduction of over 170 warriors, presented as part of a sound and light show highlighting the reconstitution of a section of Pit N\u00b01.","performers":"Exhibition produced by Exhibition Hub in collaboration with Tempora.","boxoffice_url":null,"website":"https:\/\/terracotta-exhibition.com\/","email":"info@terracotta-exhibition.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700001865"},"it":{"name":"Exhibition Terracotta Army & the First Emperor of China","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/terracotta-exhibition.com\/fr\/","email":"info@terracotta-exhibition.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700001865"},"cn":{"name":"Exhibition Terracotta Army & the First Emperor of China","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/terracotta-exhibition.com\/fr\/","email":"info@terracotta-exhibition.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700001865"},"fr":{"name":"Exposition Terracotta Army & le Premier Empereur de Chine","shortdescr":"\u00ab Terracotta Army. Et le premier Empereur de Chine \u00bb est un voyage extraordinaire dans la Chine ancienne d'il y a 2 200 ans. Partez \u00e0 la d\u00e9couverte de l\u2019une des plus grandes merveilles arch\u00e9ologiques du XX\u00e8me si\u00e8cle. D\u00e9couvrez la Chine ancestrale et plongez dans la vie du Premier Empereur !\n\n","longdescr":"Dans une mise en sc\u00e8ne in\u00e9dite, cette exposition rassemble plus de 300 reproductions de statues, chars, armes et objets d\u00e9couverts dans les fosses de la n\u00e9cropole. Elles ont \u00e9t\u00e9 r\u00e9alis\u00e9es par des artisans chinois de la r\u00e9gion du Wi\u2019an, o\u00f9 ont eu lieu les fouilles, avec un souci particulier du d\u00e9tail permettant de conserver la beaut\u00e9 et l\u2019authenticit\u00e9 des \u0153uvres originales.\n\nLe r\u00e9alisme de ces reproductions est renforc\u00e9 par des d\u00e9cors impressionnants et un dispositif audiovisuel et lumineux spectaculaire. Pour appr\u00e9cier pleinement ces tr\u00e9sors culturels, les visiteurs et visiteuses peuvent \u00e9galement profiter de vid\u00e9os projet\u00e9es sur des \u00e9crans g\u00e9ants, de commentaires audios et d'une zone interactive afin de s\u2019immerger dans cette atmosph\u00e8re unique.\n\nCette immersion, au c\u0153ur de la n\u00e9cropole du Premier Empereur de Chine s'adresse \u00e0 un large public. Sur pas moins de 1 800 m\u00b2, l'exposition aborde de nombreux th\u00e8mes : l'histoire du Premier Empereur, son arm\u00e9e originelle, ses conqu\u00eates militaires, son empire, le processus de cr\u00e9ation des soldats de l'Arm\u00e9e de terre cuite, le tombeau de l'Empereur, l'histoire des fouilles arch\u00e9ologiques... Elle expose \u00e9galement des pi\u00e8ces impressionnantes comme la reproduction grandeur nature de plus de 170 guerriers, pr\u00e9sent\u00e9s dans le cadre d'un spectacle son et lumi\u00e8re mettant en valeur la reconstitution d'une section de la fosse N\u00b01. ","performers":"Une exposition produite par Exhibition Hub en partenariat avec Tempora.","boxoffice_url":null,"website":"https:\/\/terracotta-exhibition.com\/fr\/","email":"info@terracotta-exhibition.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700001865"},"sp":{"name":"Exhibition Terracotta Army & the First Emperor of China","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/terracotta-exhibition.com\/fr\/","email":"info@terracotta-exhibition.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700001865"},"nl":{"name":"Tentoonstelling Terracotta Army & de Eerste Keizer van China","shortdescr":"\"Terracotta Army. En de eerste Keizer van China\" is een buitengewone reis door het oude China van 2200 jaar geleden. Ontdek een van de grootste archeologische wonderen van de 20e eeuw, dompel je onder in het leven van de Eerste Keizer, ontmoet zijn volk en bewonder hun technieken!\n","longdescr":"In een originele opstelling krijgen de bezoekers meer dan driehonderd reproducties te zien van beelden, strijdwagens, wapens en voorwerpen die in necropoolkuilen werden ontdekt. Ze zijn het werk van Chinese ambachtslieden in de Wi'anregio (waar de opgravingen plaatsvonden). Die hadden bijzondere aandacht voor details, waardoor de schoonheid en authenticiteit van de originele werken zo dicht mogelijk werd benaderd. \n\nHet realisme van de reproducties wordt nog versterkt door indrukwekkende decors en een spectaculair klank- en lichtsysteem. Via video's op reuzenschermen, een audiocommentaar en een interactieve zone kunnen bezoekers zich helemaal inleven in de unieke sfeer van deze culturele schatten. \n\nDe multisensorische ervaring in de necropool van de eerste keizer van China is bedoeld voor een breed publiek. De tentoonstelling beslaat maar liefst 1.800 m\u00b2 en behandelt een groot aantal thema's: de geschiedenis van de eerste keizer, zijn oorspronkelijke leger en militaire veroveringen, het keizerrijk, de ontstaansgeschiedenis van de  terracotta soldaten, het keizerlijke graf, het verhaal van de archeologische opgravingen ... Bepaald indrukwekkend zijn de levensgrote reproducties van meer dan 170 krijgers, als onderdeel van een klank- en lichtshow waarmee de gedeeltelijke reconstructie van kuil nummer 1 wordt belicht.  \n","performers":"Een tentoonstelling geproduceerd door Exhibition Hub in samenwerking met Tempora.","boxoffice_url":null,"website":"https:\/\/terracotta-exhibition.com\/nl\/","email":"info@terracotta-exhibition.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700001865"}},"place":{"id":222762,"translations":{"de":{"name":"Tour & Taxis","address_street_name":"Avenue du Port","address_street_number":"86c","address_street_box":null,"email":null,"website":"http:\/\/www.tour-taxis.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue du Port, 86c","address_line2":"1000 Bruxelles","description_web":"Die ehemalige Logistikplattform mit Zolldepot Tour & Taxis, die Anfang des 20. Jahrhunderts erbaut und intensiv genutzt wurde, bietet eine ganze Reihe eindrucksvoller Geb\u00e4ude von hoher architektonischer Qualit\u00e4t: Entrep\u00f4t Royal, Sheds, H\u00f4tel des Douanes, H\u00f4tel de la Poste und Gare Maritime. Unter Ber\u00fccksichtigungen der urspr\u00fcnglichen Architektur und des besonderen historischen Wertes erhielt das Geb\u00e4ude nun eine zeitgem\u00e4\u00dfe Neuinterpretation und erf\u00fcllt inzwischen mehrere Aufgaben: Ausstellungen, Veranstaltungen, Arbeitsbereiche, Gesch\u00e4ftsr\u00e4ume, Dienstleistungen...\r\n\r\nDie Gr\u00fcnfl\u00e4chen und der sich entwickelnde Park als Orte der Entspannung und Unterhaltung sind zentrale Elemente des neuen Konzepts.\r\n\r\nDas industrielle Erbe von Tour & Taxis k\u00f6nnen Sie auch \u00fcber die App mit Audio-Guide, Karte und Fotos entdecken. Laden Sie die kostenlose App \u00fcber den folgenden Link herunter: www.tt-app.be\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Tour & Taxis","address_street_name":"Avenue du Port","address_street_number":"86c","address_street_box":null,"email":null,"website":"http:\/\/www.tour-taxis.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue du Port, 86c","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Tour & Taxis","address_street_name":"Avenue du Port","address_street_number":"86c","address_street_box":null,"email":null,"website":"http:\/\/www.tour-taxis.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Avenue du Port, 86c","address_line2":"1000 Brussels","description_web":"The historical logistics platform of Tour & Taxis presents a number of buildings of exceptional size and architectural value: the Royal Depot, the Sheds, the H\u00f4tel des Douanes, the H\u00f4tel de la Poste and the Gare Maritime. A modern interpretation is given to the historic buildings on the Tour & Taxis site, with great respect for their authenticity and heritage value.\r\nThe site is ideally located on the tourist routes, between the Brussels old city centre and other tourist attactions such as the Atomium.\r\nThe green areas and the evolutionary park are central features and an inherent part of the philosophy behind the Tour & Taxis development.\r\nTour & Taxis is becoming a reinvented neighbourhood with residences, culture, offices and public services all in one, creating a positive alternative for people looking for new experiences. The Sheds welcome different major events including antique and art fairs.\r\nWith eateries, bars and activities on the site, there\u2019s something to suit everyone\u2019s taste.\r\n\r\nTour & Taxis offers you the chance to discover the industrial heritage of this unique site using our App, which comprises of an audio guide working together with historic photos. You can download our App for free at: www.tt-app.be","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Tour & Taxis","address_street_name":"Avenue du Port","address_street_number":"86c","address_street_box":null,"email":null,"website":"http:\/\/www.tour-taxis.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue du Port, 86c","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Tour & Taxis","address_street_name":"Avenue du Port","address_street_number":"86c","address_street_box":null,"email":null,"website":"http:\/\/www.tour-taxis.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue du Port, 86c","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Tour & Taxis","address_street_name":"Avenue du Port","address_street_number":"86c","address_street_box":null,"email":null,"website":"http:\/\/www.tour-taxis.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue du Port, 86c","address_line2":"1000 Bruxelles","description_web":"L\u2019ancienne plateforme logistique de Tour & Taxis datant du d\u00e9but du 20\u00e8me si\u00e8cle offre des immeubles d\u2019envergure et d\u2019une haute qualit\u00e9 architecturale : l\u2019Entrep\u00f4t Royal, les Sheds, l\u2019H\u00f4tel des Douanes, l\u2019H\u00f4tel de la Poste et la Gare Maritime. Tout en respectant leur authenticit\u00e9 et leur valeur historique, une r\u00e9interpr\u00e9tation contemporaine est donn\u00e9e \u00e0 ces immeubles h\u00e9rit\u00e9s du si\u00e8cle pass\u00e9. Ils connaissent d\u00e9sormais des affectations multiples : expositions, \u00e9v\u00e9nements, espaces de travail, espaces commerciaux, services...\r\nLe site est id\u00e9alement situ\u00e9 sur le parcours touristique bruxellois, entre la vieille ville (Grand-Place, Manneken Pis \u2026) et d\u2019autres attractions touristiques telles que l\u2019Atomium.\r\nLes espaces verts et le parc \u00e9volutif sont des \u00e9l\u00e9ments centraux et inh\u00e9rents \u00e0 la philosophie de d\u00e9veloppement. Ils offrent des lieux de d\u00e9tente et de divertissement.\r\nTour & Taxis devient donc un quartier multifonctionnel r\u00e9invent\u00e9 avec des logements, de la culture, des espaces de travail, cr\u00e9ant une alternative positive pour les visiteurs \u00e0 la recherche de nouvelles exp\u00e9riences.\r\nDans un cadre inspirant, les Sheds accueillent des \u00e9v\u00e9nements incontournables et attirent de nombreux visiteurs.\r\nGr\u00e2ce aux diff\u00e9rents restaurants, bars et activit\u00e9s sur le site, il y a toujours une exp\u00e9rience \u00e0 vivre.\r\n\r\nT&T vous propose de d\u00e9couvrir l\u2019h\u00e9ritage industriel du site \u00e0 l\u2019aide de l\u2019App avec audio-guide, plan et photos. T\u00e9l\u00e9chargez l\u2019App gratuitement via le lien suivant : www.tt-app.be\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Tour & Taxis","address_street_name":"Avenue du Port","address_street_number":"86c","address_street_box":null,"email":null,"website":"http:\/\/www.tour-taxis.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue du Port, 86c","address_line2":"1000 Bruxelles","description_web":"La hist\u00f3rica plataforma log\u00edstica de Tour & Taxis presenta un n\u00famero de edificios de gran envergadura y valor arquitect\u00f3nico: Royal Depot, Sheds, H\u00f4tel des Douanes, H\u00f4tel de la Poste y Gare Maritime. Se le da una interpretaci\u00f3n moderna a los edifcios hist\u00f3ricos de Tour & Taxis, respetando su autenticidad y valor patrimonial.\r\nEl lugar est\u00e1 idealmente localizado en las rutas tur\u00edsticas, entre la parte antigua de la ciudad y otros lugares de inter\u00e9s tur\u00edstico tales como el Atomium.\r\nLas zonas verdes y el parque, que est\u00e1 en constante evoluci\u00f3n, son las principales caracter\u00edsticas y una parte inherente de la filosof\u00eda que hay detr\u00e1s del desarrollo de Tour & Taxis.\r\nTour & Taxis se est\u00e1 convirtiendo en un nuevo vecindario con residencias, cultura, oficinas y servicios p\u00fablicos todo en uno, creando una alternativa positiva para aquella gente que busca nuevas experiencias. El edificio Sheds acoge diferentes eventos de gran envergadura, incluyendo ferias de arte y antig\u00fcedades.\r\n\u00a1En los restaurantes, bares y actividades que hay en el lugar encontrar\u00e1s cosas para todos los gustos!\r\n\r\nTour & Taxis te ofrece la oportunidad de descubrir el patrimonio industrial de este lugar \u00fanico usando nuestra aplicaci\u00f3n, que incluye una audiogu\u00eda junto con fotos hist\u00f3ricas. Puedes descargar la aplicaci\u00f3n de manera gratuita aqu\u00ed: www.tt-app.be\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Tour & Taxis","address_street_name":"Havenlaan","address_street_number":"86c","address_street_box":null,"email":null,"website":"http:\/\/www.tour-taxis.com","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Havenlaan, 86c","address_line2":"1000 Brussel","description_web":"Het voormalige logistieke platform van Tour & Taxis uit de vroege jaren van de 20e eeuw  bestaat uit gebouwen met hoge architectonische kwaliteit: het Koninklijk Pakhuis, de Sheds, het H\u00f4tel des Douanes, het H\u00f4tel de la Poste en de Gare Maritime zijn stuk voor stuk erfgoedparels.  Dit patrimonium kreeg met respect  voor historische waarde en oog voor authenticiteit een nieuwe eigentijdse invulling met  tentoonstellingen, evenementen, kantoren, coworking, retail, services ...\r\nDe site sluit nauw aan bij het toeristisch parcours tussen het historische stadscentrum (Grote Markt, Manneken Pis ...) en andere bezienswaardigheden zoals het Atomium. Het bevindt zich ook op wandelafstand van het toekomstige nieuwe museum voor moderne en hedendaagse kunst.\r\nDe groene ruimtes en het moderne park bieden ruimte aan ontspanning en vrijetijdsactiviteiten.\r\nTour & Taxis wordt een vooruitstrevende participatieve wijk met woningen, cultuur, workspaces, food hall \u2026 die een uitvalsbasis vormt voor de bezoekers op zoek naar nieuwe ervaringen. Zo vinden er in de Sheds uiteenlopende topbeurzen plaats. Dankzij die grote diversiteit aan activiteiten, restaurants, bars en talloze andere activiteiten op de site valt er steeds iets te beleven.\r\n\r\nTour&Taxis biedt u de mogelijkheid om het industrieel patrimonium van de site te ontdekken aan de hand van een App met audio-guide en foto\u2019s. U kunt de App gratis downloaden op: www.tt-app.be\r\n \r\n ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[8],"translations":{"de":["Kanal-Viertel"],"pt":[null],"en":["Canal"],"it":["Canal"],"cn":[null],"fr":["Canal"],"sp":["Canal"],"nl":["Kanaalwijk"]}},"zones":{"list":[20],"translations":{"de":["Norden"],"pt":[null],"en":["North"],"it":["Nord"],"cn":[null],"fr":["Nord"],"sp":["Norte"],"nl":["Noord"]}},"neca":null,"facebook_id":null,"backoffice_id":658,"location":{"lat":50.86573978,"lon":4.3509828},"region":"brussels","last_updated_at":"2024-12-10T15:07:10+01:00","published_at":"2013-10-19T01:13:42+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":266528,"translations":{"de":{"name":"Tempora","address_street_name":"rue des Anciens Etangs","address_street_number":"44-46","address_street_box":null,"email":"info@tempora.be","website":"http:\/\/tempora.be\/","phone_contact":"+32 2 549 60 60","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"rue des Anciens Etangs, 44-46","address_line2":"1190 Forest","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Tempora","address_street_name":"rue des Anciens Etangs","address_street_number":"44-46","address_street_box":null,"email":"info@tempora.be","website":"http:\/\/tempora.be\/","phone_contact":"+32 2 549 60 60","phone_booking":null,"address_zip":"1190","addr