e":"Vorverkauf"},"it":{"name":"Pr\u00e9vente"},"sp":{"name":"Pr\u00e9vente"},"pt":{"name":"Pr\u00e9vente"},"cn":{"name":"Pr\u00e9vente"}},"value":13}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":{"list":[255,259,263],"translations":{"fr":["Accessible","Chien d'assistance","Accessible aux pi\u00e9tons appareill\u00e9s"],"nl":["Toegankelijk","Assistentiehonden","Toegankelijk voor voetgangers met hulpmiddelen"],"en":["Accessible","Assistance dogs","Accessible to pedestrians with mobility aids"],"de":["Barrierefrei","Assistenzhund","Barrierefrei f\u00fcr Fu\u00dfg\u00e4nger mit Gehhilfe"],"it":[null,null,null],"sp":[null,null,null],"pt":[null,null,null],"cn":[null,null,null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-12-01T01:07:22+01:00","published_at":"2022-10-03T09:56:21+02:00","backoffice_id":262916,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":0.19493451588086},{"id":538345,"date_start":"2022-07-16","date_end":"2023-06-30","date_next":"2023-01-14","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen","it":null,"sp":null,"pt":null,"cn":null}},"others":{"list":[105],"translations":{"fr":["Gastronomie"],"nl":["Gastronomie"],"en":["Gastronomy"],"de":["Gastronomie"],"it":[null],"sp":[null],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Visitez une ferme urbaine souterraine de 3.000m2.","shortdescr":"D\u00e9couvrez 3.000 m2 d'agriculture urbaine souterraine dans les mythiques Caves de Cureghem, au coeur de Bruxelles.","longdescr":"Venez d\u00e9couvrir en famille ou entre amis les magnifiques Caves de Cureghem et la ferme urbaine qu'elle abrite. Les caves s'\u00e9tendent sur environ 10.000 m\u00b2.\r\n\r\nQue comprend la visite ?\r\n- La visite comprend une projection vid\u00e9o et un parcours guid\u00e9 dans toutes les \u00e9tapes de production des champignons exotiques sur base dr\u00eaches de bi\u00e8re.\r\n- Notre guide vous fera d\u00e9couvrir tous les secrets des fabuleux champignons asiatiques cultiv\u00e9s par la jeune \u00e9quipe.\r\n- Vous d\u00e9couvrirez \u00e9galement une culture verticale de micropousses et herbes aromatiques !\r\n- INCLU : Repartez avec un sachet de 300g d'un m\u00e9lange de nos champignons frais, de quoi pr\u00e9parer une belle po\u00eal\u00e9e de champignons pour deux personnes !\r\n\r\nEst-ce possible d'acheter sur place ?\r\nOui ! Vous aurez \u00e9galement l'occasion d'acheter nos produits directement de la fourche \u00e0 la fourchette... plus local on ne peut pas ! Nous sommes munis d'un terminal bancontact.\r\n\r\nComment se rendre sur place ?\r\nRendez-vous \u00e0 l'adresse suivante: 24, bte 26, Rue Ropsy Chaudron, 1070 Anderlecht.\r\nTransports publics: Metro 2, 6 arr\u00eat : Clemenceau \/ Delacroix\r\nAcc\u00e8s PMR: Oui\r\n\r\nPour ne rien louper, vous recevrez lors de votre r\u00e9servation un mail de confirmation avec un plan d'acc\u00e8s \u00e0 nos locaux, ainsi qu'une notification de rappel quelques jours avant la visite.","performers":null,"boxoffice_url":null,"website":"https:\/\/eclo.farm\/fr\/visites\/","email":"info@eclo.farm","phone_contact":"+32 496 20 38 46","phone_booking":"+32 496 20 38 46","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.538345"},"nl":{"name":"Visitez une ferme urbaine souterraine de 3.000m2.","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agend