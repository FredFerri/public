"is_open":true,"hours":[{"start":"08:00:00","end":"12:45:00"}]},"saturday":{"is_open":false},"sunday":{"is_open":false}},"translations":{"fr":["lundi, mercredi, jeudi et vendredi: de 08:00 \u00e0 12:45","mardi: de 08:00 \u00e0 12:45 et de 16:00 \u00e0 19:00","samedi et dimanche: ferm\u00e9"],"nl":["maandag, woensdag, donderdag en vrijdag: van 08:00 tot 12:45","dinsdag: van 08:00 tot 12:45 en van 16:00 tot 19:00","zaterdag en zondag: gesloten"],"en":["monday, wednesday, thursday and friday: from 08:00 to 12:45","tuesday: from 08:00 to 12:45 and from 16:00 to 19:00","saturday and sunday: closed"],"de":["monday, wednesday, thursday and friday: from 08:00 to 12:45","tuesday: from 08:00 to 12:45 and from 16:00 to 19:00","saturday and sunday: closed"],"it":["monday, wednesday, thursday and friday: from 08:00 to 12:45","tuesday: from 08:00 to 12:45 and from 16:00 to 19:00","saturday and sunday: closed"],"sp":["monday, wednesday, thursday and friday: from 08:00 to 12:45","tuesday: from 08:00 to 12:45 and from 16:00 to 19:00","saturday and sunday: closed"],"pt":["monday, wednesday, thursday and friday: from 08:00 to 12:45","tuesday: from 08:00 to 12:45 and from 16:00 to 19:00","saturday and sunday: closed"],"cn":["monday, wednesday, thursday and friday: from 08:00 to 12:45","tuesday: from 08:00 to 12:45 and from 16:00 to 19:00","saturday and sunday: closed"]},"date_start":"2023-03-28","date_end":"2023-04-18","is_also_by_appointment":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"opening":{"day":"2023-03-28","start":"18:30:00","timestamp":"2023-03-28T18:30:00+02:00","is_only_by_appointment":false},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-02-27T16:05:07+01:00","published_at":"2023-02-23T15:04:07+01:00","backoffice_id":272411,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.3568829277518},{"id":553168,"date_start":"2023-03-16","date_end":"2023-04-29","date_next":"2023-03-28","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung","it":"Esposizioni","sp":"Exhibici\u00f3n","pt":null,"cn":null}},"others":{"list":[24,30],"translations":{"fr":["Galeries d'art","Peinture"],"nl":["Galeries","Schilderkunst"],"en":["Art Galleries","Painting"],"de":["Kunstgalerien","Malerei"],"it":["Gallerie d'arte","Pittura"],"sp":["Galer\u00edas de arte","Pintura"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","en"],"subtitles":[]},"translations":{"fr":{"name":"SALOM\u00c9 DE FONTAINIEU ou la destruction du motif","shortdescr":"Nous sommes heureuses de vous pr\u00e9senter, du 16 mars  au 29 avril 2023, les derni\u00e8res \u0153uvres sur papier de l'artiste fran\u00e7aise  Salom\u00e9 de Fontainieu.","longdescr":"Privil\u00e9giant la spontan\u00e9it\u00e9, Salom\u00e9 de Fontainieu n\u2019aime pas imposer ou affirmer les choses. Ses \u0153uvres, aussi libres et fortes que fragiles, transmettent un ressenti, une vision ou tout simplement, une impression. Salom\u00e9 d\u00e9pose les couleurs sur son papier, avec une brutalit\u00e9 presque affectueuse et sensuelle. Sa technique mixte est indissociable d\u2019une s\u00e9rie de gestes qui n\u00e9cessitent une ma\u00eetrise de l\u2019impr\u00e9visible et du hasard. Face \u00e0 ses papiers, dans un perp\u00e9tuel combat, Salom\u00e9 laisse son instinct s\u2019exprimer.\r\n\r\nLe papier devient peau et s\u2019impr\u00e8gne alors de tout ce qui le recouvre : encre, acrylique, jaune d\u2019\u0153uf,\u2026 On pourrait m\u00eame dire qu\u2019il devient vivant. Cette impression de vivant n\u2019est que renforc\u00e9 par les taches, h\u00e9sitations, et accidents inh\u00e9rents au processus qui animent ces paysages comme des souvenirs. Mais Salom\u00e9 ne se contente pas de restituer des souvenirs, elle d\u00e9construit ce que l\u2019on conna\u00eet pour le reconstituer gr\u00e2ce \u00e0 ses propres impressions, nous offrant ainsi une exp\u00e9rience sensorielle d\u2019une grande force et sensibilit\u00e9 \u00e0 la fois.\r\n\r\nCette marseillaise de c\u0153ur peint dans son atelier en pleine nature pr\u00e8s d\u2019Aix-en-Provence, \u00e0 Bib\u00e9mus, lieu c\u00e9l\u00e9br\u00e9 par Paul C\u00e9zanne. Ses papiers sont comme une travers\u00e9e de la nature au fil des saisons, passant du jaune vibrant aux taches de verts ou encore \u00e0 ce bleu qui rappelle les \u00e9clats de ciel que l\u2019on per\u00e7oit \u00e0 travers la densit\u00e9 des feuillages en mouvement.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.alienorprouvost.com","email":"ap@alienorprouvost.com","phone_contact":null,"phone_booking":"+32 2 347 18 49","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.553168"},"nl":{"name":"SALOM\u00c9 DE FONTAINIEU ou la destruction du motif","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.alienorprouvost.com","email":"ap@alienorprouvost.com","phone_contact":null,"phone_booking":"+32 2 347 18 49","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.553168"},"en":{"name":"SALOM\u00c9 DE FONTAINIEU ou la destruction du motif","shortdescr":"We are delighted to present the French artist, Salom\u00e9 de Fontainieu's latest works on paper from 16 March to 29 April 2023.","longdescr":"Focusing on spontaneity, Salom\u00e9 de Fontainieu does not like to impose or assert things. Her works, as free and strong as they are fragile, convey a feeling, a vision or simply an impression. Salom\u00e9 places the colors on her paper with an almost affectionate and sensual brutality. Her mixed technique goes hand in hand with a series of gestures that require a mastery of the unpredictable and the random. Facing her papers, in a perpetual struggle, Salom\u00e9 lets her instinct express itself.\r\n\r\nThe paper becomes skin and is then impregnated with everything that covers it: ink, acrylic, egg yolk,... One could even say that it becomes alive. This life impression is only reinforced by the stains, hesitations, and accidents inherent in the process that animate these landscapes like memories. But Salom\u00e9 is not only restoring memories, she deconstructs what we know in order to reconstitute it thanks to her own impressions, thus offering us a sensory experience of great strength and sensitivity at the same time. \r\n\r\nSalom\u00e9 lives in Marseille but paints most of the time in her studio in the middle of nowhere near Aix-en-Provence, in Bib\u00e9mus, a place celebrated by Paul C\u00e9zanne. Her works on paper are like a journey through nature with the passing of the seasons, going from vibrant yellow to green spots or even to this brilliant blue that reminds us of the sky that we perceive through the density of the moving foliage.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.alienorprouvost.com","email":"ap@alienorprouvost.com","phone_contact":null,"phone_booking":"+32 2 347 18 49","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.553168"},"de":{"name":"SALOME DE FONTAINIEU ou la destruction du motif","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.alienorprouvost.com","email":"ap@alienorprouvost.com","phone_contact":null,"phone_booking":"+32 2 347 18 49","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.553168"},"it":{"name":"SALOME DE FONTAINIEU ou la destruction du motif","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.alienorprouvost.com","email":"ap@alienorprouvost.com","phone_contact":null,"phone_booking":"+32 2 347 18 49","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.553168"},"sp":{"name":"SALOME DE FONTAINIEU ou la destruction du motif","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.alienorprouvost.com","email":"ap@alienorprouvost.com","phone_contact":null,"phone_booking":"+32 2 347 18 49","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.553168"},"pt":{"name":"SALOME DE FONTAINIEU ou la destruction du motif","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.alienorprouvost.com","email":"ap@alienorprouvost.com","phone_contact":null,"phone_booking":"+32 2 347 18 49","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.553168"},"cn":{"name":"SALOME DE FONTAINIEU ou la destruction du motif","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.alienorprouvost.com","email":"ap@alienorprouvost.com","phone_contact":null,"phone_booking":"+32 2 347 18 49","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.553168"}},"place":{"id":276427,"translations":{"fr":{"name":"Galerie Alienor Prouvost","address_street_name":"Rue Washington","address_street_number":"64","address_street_box":null,"email":"ap@alienorprouvost.com","website":"http:\/\/www.alienorprouvost.com","phone_contact":"+32 2 347 18 49","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Washington, 64","address_line2":"1050 Ixelles","description_web":"Apr\u00e8s quelques ann\u00e9es \u00e0 travailler dans l\u2019art moderne \u00e0 Paris, Ali\u00e9nor Prouvost d\u00e9cide de r\u00e9aliser son r\u00eave et de fonder sa galerie au c\u0153ur de la capitale europ\u00e9enne. En mars 2019, elle ouvre les portes du 64, rue Washington dans le quartier du Ch\u00e2telain.\r\n\r\nLa galerie Ali\u00e9nor Prouvost explore principalement les mouvements de l\u2019apr\u00e8s-guerre mais s\u2019int\u00e9resse aussi beaucoup \u00e0 l\u2019Art contemporain.\r\nElle a pour but de d\u00e9mocratiser l\u2019Art, le diffuser et le rendre accessible aupr\u00e8s du plus grand nombre. Elle pr\u00e9sente ainsi, pour les artistes d\u2019apr\u00e8s-guerre, souvent des \u0153uvres sur papier pour permettre aux jeunes collectionneurs de retrouver d\u2019une exposition \u00e0 l\u2019autre les m\u00eames gammes de prix ; de 25 euros \u00e0 15 000 euros. Pour les artistes d\u00e9j\u00e0 tr\u00e8s c\u00f4t\u00e9s, elle travaille \u00e9galement en courtage et essaye de rechercher pour vous l\u2019\u0153uvre la plus proche de vos souhaits.\r\n\r\nLa galerie collabore uniquement en direct avec les artistes, les ayants droit d\u2019artistes ou des fondations pour proposer un contenu toujours exclusif et unique. Gr\u00e2ce \u00e0 ces partenariats, la galerie s\u2019engage sur le long terme \u00e0 contribuer au rayonnement de leurs \u0153uvres. Attach\u00e9e \u00e0 une vision actuelle de son r\u00f4le, elle participe \u00e0 repenser l\u2019histoire de l\u2019art, aiguiser les regards \u2013 et ce \u00e0 destination de tous et toutes.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Galerie Alienor Prouvost","address_street_name":"Rue Washington","address_street_number":"64","address_street_box":null,"email":"ap@alienorprouvost.com","website":"http:\/\/www.alienorprouvost.com","phone_contact":"+32 2 347 18 49","phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"Rue Washington, 64","address_line2":"1050 Elsene","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Galerie Alienor Prouvost","address_street_name":"Rue Washington","address_street_number":"64","address_street_box":null,"email":"ap@alienorprouvost.com","website":"http:\/\/www.alienorprouvost.com","phone_contact":"+32 2 347 18 49","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Washington, 64","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Galerie Alienor Prouvost","address_street_name":"Rue Washington","address_street_number":"64","address_street_box":null,"email":"ap@alienorprouvost.com","website":"http:\/\/www.alienorprouvost.com","phone_contact":"+32 2 347 18 49","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Washington, 64","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Galerie Alienor Prouvost","address_street_name":"Rue Washington","address_street_number":"64","address_street_box":null,"email":"ap@alienorprouvost.com","website":"http:\/\/www.alienorprouvost.com","phone_contact":"+32 2 347 18 49","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Washington, 64","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Galerie Alienor Prouvost","address_street_name":"Rue Washington","address_street_number":"64","address_street_box":null,"email":"ap@alienorprouvost.com","website":"http:\/\/www.alienorprouvost.com","phone_contact":"+32 2 347 18 49","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Washington, 64","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Galerie Alienor Prouvost","address_street_name":"Rue Washington","address_street_number":"64","address_street_box":null,"email":"ap@alienorprouvost.com","website":"http:\/\/www.alienorprouvost.com","phone_contact":"+32 2 347 18 49","phone_booking":null,"address_zip":"1050","address_city"