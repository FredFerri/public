:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50000033"},"cn":{"name":"Les Bijoux de la Couronne","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.magicland-theatre.com\/","email":"info@magicland-theatre.com","phone_contact":"+32 495 26 18 42","phone_booking":"+32 495 26 18 42","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50000033"},"fr":{"name":"Le Magic Land Th\u00e9\u00e2tre dans le jardin du Silex","shortdescr":"Le 8 septembre, le Magic Land Th\u00e9\u00e2tre s\u2019installe le temps d\u2019une soir\u00e9e dans le jardin du Silex pour un spectacle en plein air. Cascades, combat \u00e0 l'\u00e9p\u00e9e, quiproquos, d\u00e9clarations enflamm\u00e9es et alexandrins, \u201cLes Bijoux de la Couronne\u201d est une nouvelle aventure o\u00f9 l'on retrouvera tout le savoir-faire (rire) de la compagnie qui s'inscrira dans la tradition de la commedia dell'arte.","longdescr":"Alors que L\u2019Affaire des Ferrets est encore toute fra\u00eeche dans les m\u00e9moires, un nouveau scandale menace la cour de France. La reine, une Milanaise fi\u00e8re comme une escalope, s\u2019ennuie \u00e0 mourir et finit par succomber aux charmes d\u2019un amant de passage. Elle ignore que celui-ci est un espion \u00e0 la solde du cardinal, elle vient de sceller son destin. Les mousquetaires parviendront-ils \u00e0 r\u00e9cup\u00e9rer les bijoux de la couronne ? \n\nComme dirait d\u2019Artagnan : \u201cil n\u2019est pas trop tard pour venir assister \u00e0 ce beau spectacle de tr\u00e9teaux\u201d ! Cascades, combat \u00e0 l'\u00e9p\u00e9e, quiproquos, d\u00e9clarations enflamm\u00e9es et alexandrins, \u201cLes Bijoux de la Couronne\u201d est une nouvelle aventure o\u00f9 l'on retrouvera tout le savoir-faire (rire) de la compagnie qui s'inscrira dans la tradition de la commedia dell'arte. \n\nUne soir\u00e9e exceptionnelle en perspective !","performers":"Texte et mise en sc\u00e8ne : Patrick Chaboud Interpr\u00e9t\u00e9 par : Am\u00e9lie Segers, Anne-Isabelle Justens, Elsa Erroyaux, Juan Marquez Garcia et Bastien Craninx","boxoffice_url":null,"website":"https:\/\/www.magicland-theatre.com\/","email":"info@magicland-theatre.com","phone_contact":"+32 495 26 18 42","phone_booking":"+32 495 26 18 42","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50000033"},"sp":{"name":"Les Bijoux de la Couronne","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.magicland-theatre.com\/","email":"info@magicland-theatre.com","phone_contact":"+32 495 26 18 42","phone_booking":"+32 495 26 18 42","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50000033"},"nl":{"name":"Le Magic Land Th\u00e9\u00e2tre dans le jardin du Silex","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.magicland-theatre.com\/","email":"info@magicland-theatre.com","phone_contact":"+32 495 26 18 42","phone_booking":"+32 495 26 18 42","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50000033"}},"place":{"id":50000005,"translations":{"de":{"name":"Le Silex asbl","address_street_name":"Rue Voot","address_street_number":"82","address_street_box":null,"email":"info@lesilex.be","website":"https:\/\/www.lesilex.be\/fr\/fm\/accueil","phone_contact":"+32 2 762 40 09","phone_booking":null,"address_zip":"1200","address_city":"Woluwe-Saint-Lambert","address_line1":"Rue Voot, 82","address_line2":"1200 Woluwe-Saint-Lambert","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Le Silex asbl","address_street_name":"Rue Voot","address_street_number":"82","address_street_box":null,"email":"info@lesilex.be","website":"https:\/\/www.lesilex.be\/fr\/fm\/accueil","phone_contact":"+32 2 762 40 09","phone_booking":null,"address_zip":"1200","address_city":"Woluwe-Saint-Lambert","address_line1":"Rue Voot, 8