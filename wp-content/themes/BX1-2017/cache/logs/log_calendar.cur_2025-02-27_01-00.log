ull,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{"list":[258],"translations":{"de":["Stadtteile"],"pt":[null],"en":["Neighbourhoods"],"it":["Quartieri"],"cn":[null],"fr":["Quartiers"],"sp":["Barrios"],"nl":["Wijken"]}}},"translations":{"de":{"name":"\u00c0 la rencontre de nos voisins \u2013 Le Groene Phare","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/sewermuseum.brussels\/news\/a-la-rencontre-de-nos-voisins-le-groene-phare\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700004755"},"pt":{"name":"\u00c0 la rencontre de nos voisins \u2013 Le Groene Phare","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/sewermuseum.brussels\/news\/a-la-rencontre-de-nos-voisins-le-groene-phare\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700004755"},"en":{"name":"\u00c0 la rencontre de nos voisins \u2013 Le Groene Phare","shortdescr":"Chaque premier dimanche du mois, durant notre nouvelle exposition \u2018Apr\u00e8s la pluie\u2019, rencontrez nos voisins.\n","longdescr":"Laissez-vous inspirer par l\u2019initiative du Groene Phare. Les r\u00e9sidents de l\u2019immeuble sur le coin du boulevard ont d\u00e9cid\u00e9, ensemble, de cr\u00e9er une oasis de verdure \u00e0 c\u00f4t\u00e9 de leur b\u00e2timent. Parmi les plantes indig\u00e8nes, chacun peut y trouver calme et fraicheur. Les fa\u00e7ades v\u00e9g\u00e9talis\u00e9es apportent de la fraicheur en p\u00e9riode de s\u00e9cheresse et une citerne r\u00e9cup\u00e8re les eaux de pluie. Habitants du quartier et passants en b\u00e9n\u00e9ficient \u00e9galement.\n\nInfos pratiques :\n\nDates: 01.12.24, 05.01.25, 06.04.25, 01.06.25\nActivit\u00e9 gratuite dans le cadre du Premier dimanche du mois\nLa r\u00e9servation est obligatoire via notre plateforme de r\u00e9servation en ligne. Elle comprend l\u2019entr\u00e9e au mus\u00e9e + la rencontre avec nos voisins \u00e0 15h15\nLe mus\u00e9e ferme \u00e0 17h, nous vous recommandons donc de profiter du mus\u00e9e d\u00e8s 14h15, avant la rencontre avec nos voisins \u00e0 15h15.","performers":null,"boxoffice_url":null,"website":"https:\/\/sewermuseum.brussels\/news\/a-la-rencontre-de-nos-voisins-le-groene-phare\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700004755"},"it":{"name":"\u00c0 la rencontre de nos voisins \u2013 Le Groene Phare","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/sewermuseum.brussels\/news\/a-la-rencontre-de-nos-voisins-le-groene-phare\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700004755"},"cn":{"name":"\u00c0 la rencontre de nos voisins \u2013 Le Groene Phare","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/sewermuseum.brussels\/news\/a-la-rencontre-de-nos-voisins-le-groene-phare\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700004755"},"fr":{"name":"\u00c0 la rencontre de nos voisins \u2013 Le Groene Phare","shortdescr":"Chaque premier dimanche du mois, durant notre nouvelle exposition \u2018Apr\u00e8s la pluie\u2019, rencontrez nos voisins.\n","longdescr":"Laissez-vous inspirer par l\u2019initiative du Groene Phare. Les r\u00e9sidents de l\u2019immeuble sur le coin du boulevard ont d\u00e9cid\u00e9, ensemble, de cr\u00e9er une oasis de verdure \u00e0 c\u00f4t\u00e9 de leur b\u00e2timent. Parmi les plantes indig\u00e8nes, chacun peut y trouver calme et fraicheur. Les fa\u00e7ades v\u00e9g\u00e9talis\u00e9es apportent de la fraicheur en p\u00e9riode de s\u00e9cheresse et une citerne r\u00e9cup\u00e8re les eaux de pluie. Habitants du quartier et passants en b\u00e9n\u00e9ficient \u00e9galement.\n\nInfos pratiques :\n\nDates: 01.12.24, 05.01.25, 06.04.25, 01.06.25\nActivit\u00e9 gratuite dans le cadre du Premier dimanche du mois\nLa r\u00e9servation est obligatoire via notre plateforme de r\u00e9servation en ligne. Elle comprend l\u2019entr\u00e9e au mus\u00e9e + la rencontre avec nos voisins \u00e0 15h15\nLe mus\u00e9e ferme \u00e0 17h, nous vous recommandons donc de profiter du mus\u00e9e d\u00e8s 14h15, avant la rencontre avec nos voisins \u00e0 15h15.","performers":null,"boxoffice_url":null,"website":"https:\/\/sewermuseum.brussels\/news\/a-la-rencontre-de-nos-voisins-le-groene-phare\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700004755"},"sp":{"name":"\u00c0 la rencontre de nos voisins \u2013 Le Groene Phare","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/sewermuseum.brussels\/news\/a-la-rencontre-de-nos-voisins-le-groene-phare\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700004755"},"nl":{"name":"\u00c0 la rencontre de nos voisins \u2013 Le Groene Phare","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/sewermuseum.brussels\/news\/a-la-rencontre-de-nos-voisins-le-groene-phare\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700004755"}},"place":{"id":242977,"translations":{"de":{"name":"Bruxella 1238","address_street_name":"Rue de la Bourse","address_street_number":null,"address_street_box":null,"email":"contact@boursebeurs.be","website":"https:\/\/www.boursebeurs.be\/fr\/bruxella-1238","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Bourse","address_line2":"1000 Bruxelles","description_web":"Am Fu\u00dfe der Br\u00fcsseler B\u00f6rse verbirgt sich eine kleine, aber ganz erstaunliche arch\u00e4ologische St\u00e4tte, die auch f\u00fcr die \u00d6ffentlichkeit zug\u00e4nglich ist. Es handelt sich um die Ruinen des Franziskanerordens, der in Br\u00fcssel ab 1238 erbaut wurde. Hier befindet sich auch das Grab des Herzogs Johann I. von Brabant. Das Fundament und verschiedene andere \u00dcberreste geben einen faszinierenden Einblick in einen weniger bekannten Teil der Br\u00fcsseler Stadtgschichte.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Bruxella 1238","address_street_name":"Rue de la Bourse","address_street_number":null,"address_street_box":null,"email":"contact@boursebeurs.be","website":"https:\/\/www.boursebeurs.be\/fr\/bruxella-1238","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Bourse","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Bruxella 1238","address_street_name":"Beursstraat","address_street_number":null,"address_street_box":null,"email":"contact@boursebeurs.be","website":"https:\/\/www.boursebeurs.be\/en\/bruxella-1238","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Beursstraat","address_line2":"1000 Brussels","description_web":"Next to the stock exchange building, in the heart of Brussels, is a fascinating little archaeological site.  It contains the remains of the Franciscan monastery founded in Brussels in 1238 and the tomb of Duke John I of Brabant.  The foundations and various other objects offer a glimpse of an unknown side of the history of Brussels, and at the same time give a good idea of the different aspects of an archaeological dig.","description_print":null,"booking_url":"https:\/\/www.ticketing.brussels\/en\/tickets\/event-details.Bruxella-1238.4e2fe0b8-72e4-44c0-abcc-d72a3b0c5618","sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Bruxella 1238","address_street_name":"Rue de la Bourse","address_street_number":null,"address_street_box":null,"email":"contact@boursebeurs.be","website":"https:\/\/www.boursebeurs.be\/fr\/bruxella-1238","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Bourse","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Bruxella 1238","address_street_name":"Rue de la Bourse","address_street_number":null,"address_street_box":null,"email":"contact@boursebeurs.be","website":"https:\/\/www.boursebeurs.be\/fr\/bruxella-1238","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Bourse","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Bruxella 1238","address_street_name":"Rue de la Bourse","address_street_number":null,"address_street_box":null,"email":"contact@boursebeurs.be","website":"https:\/\/www.boursebeurs.be\/fr\/bruxella-1238","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Bourse","address_line2":"1000 Bruxelles","description_web":"Au pied de la Bourse, se cache un \u00e9tonnant petit site arch\u00e9ologique ouvert au public, au coeur de Bruxelles, celui-ci pr\u00e9sente les vestiges du Couvent de l'ordre franciscain \u00e9rig\u00e9 \u00e0 Bruxelles d\u00e8s 1238. On y trouve notamment le tombeau du Duc Jean Ier de Brabant. Les fondations et un mat\u00e9riel diversifi\u00e9 permettent de faire revivre un pan m\u00e9connu de l'histoire de Bruxelles, tout en laissant percevoir diff\u00e9rents aspects de la r\u00e9alit\u00e9 du m\u00e9tier d'arch\u00e9ologue.","description_print":null,"booking_url":"https:\/\/www.ticketing.brussels\/fr\/tickets\/event-details.Bruxella-1238.4e2fe0b8-72e4-44c0-abcc-d72a3b0c5618","sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Bruxella 1238","address_street_name":"Rue de la Bourse","address_street_number":null,"address_street_box":null,"email":"contact@boursebeurs.be","website":"https:\/\/www.boursebeurs.be\/fr\/bruxella-1238","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Bourse","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Bruxella 1238","address_street_name":"Beursstraat","address_street_number":null,"address_street_box":null,"email":"contact@boursebeurs.be","website":"https:\/\/www.boursebeurs.be\/nl\/bruxella-1238","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Beursstraat","address_line2":"1000 Brussel","description_web":"Aan de voet van de Beurs verbergt er zich een fascinerende archeologische site in het centrum van Brussel die de bezoekers een kijk geeft op de resten van het franciscaans klooster dat in Brussel vanaf 1238 werd opgericht. We vinden er ondermeer het graf van Hertog Jan I van Brabant. De funderingen en allerlei ander materiaal laten ons toe om een ongekend stukje uit de geschiedenis van Brussel te laten herleven en ons tegelijkertijd een goed beeld te geven van de verschillende aspecten van het beroep van archeoloog.","description_print":null,"booking_url":"https:\/\/www.ticketing.brussels\/nl\/tickets\/event-details.Bruxella-1238.4e2fe0b8-72e4-44c0-abcc-d72a3b0c5618","sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[13],"translations":{"de":["Historisches Stadtzentrum"],"pt":[null],"en":["Historical Centre"],"it":["Centro storico"],"cn":[null],"fr":["Centre historique"],"sp":["Centro hist\u00f3rico"],"nl":["Historisch centrum"]}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":null,"facebook_id":null,"backoffice_id":5373,"location":{"lat":50.8480633,"lon":4.3508541},"region":"brussels","last_updated_at":"2025-02-06T08:25:54+01:00","published_at":"2013-10-19T01:18:35+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":231869,"translations":{"de":{"name":"Kanalisationsmuseum (Mus\u00e9e des \u00c9gouts)","address_street_name":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museedesegouts.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_line2":"1000 Bruxelles","description_web":"Das Kanalisationsmuseum f\u00fchrt Sie hinab in die Unterwelten der Br\u00fcsseler Kanalisation. Entdecken Sie die Geheimnisse des faszinierenden, 400 Kilometer langen Labyrinths, das sich unter dem Br\u00fcsseler Stadtgebiet auftut. Tausende Kubikmeter Wasser flie\u00dfen t\u00e4glich durch die Br\u00fcsseler Abwasserkanalisation. Was mit ihnen geschieht, welche Wege sie nehmen, erfahren Sie im Kanalisationsmuseum - ein Museum mit vielen interessanten Details f\u00fcr Gro\u00df und Klein: Geschichtliches, Technisches und Am\u00fcsantes.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Mus\u00e9e des \u00c9gouts - Mus\u00e9es de la Ville de Bruxelles","address_street_name":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museedesegouts.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Sewer Museum","address_street_name":"Octrooipaviljoen, Anderlechtsepoort","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.sewermuseum.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Octrooipaviljoen, Anderlechtsepoort","address_line2":"1000 Brussels","description_web":"Why not visit the Brussels sewers and the Sewers museum during your next excursion in Brussels. A visit of Brussels' sewerage network - led by experienced guides or ex-workers - is extraordinary, full of surprises, but above all fascinating. The sewers have become vital to our way of life, so much so that it's hard to imagine what it was like before they existed. A visit of the Sewers Museum (and a real sewer!) is therefore an amazing, unusual and thrilling experience.\r\nBrussels' first sewerage network came into use in the 17th century, but they were very limited and a large part of the city's waste still found its way into the river Senne. The river carried waste and carrion and regularly overflowed, or dried out in the summer, leaving behind less-than-pleasant smells.\r\nIt was partially due to this, that the government in the second half of the 19th century decided to completely transform the Senne and its neighbouring streets by building great boulevards to cover the insalubrious area. Between the two world wars a second transformation: a portion of the Senne was diverted and then covered over. The sewerage network improved and grew over the years, going from 45 km in 1847 to the 350 km that we have today.\r\n The entrance to the museum is housed in one of the toll pavilions that used to collect taxes on goods that entered the city.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Mus\u00e9e des \u00c9gouts - Mus\u00e9es de la Ville de Bruxelles","address_street_name":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museedesegouts.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Mus\u00e9e des \u00c9gouts - Mus\u00e9es de la Ville de Bruxelles","address_street_name":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museedesegouts.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Mus\u00e9e des \u00c9gouts","address_street_name":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museedesegouts.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_line2":"1000 Bruxelles","description_web":"Au premier abord, on n\u2019y aurait pas pens\u00e9\u2026 Aller visiter les \u00e9gouts d\u2019une grande ville ? Mais en y r\u00e9fl\u00e9chissant un court instant, on per\u00e7oit vite l\u2019int\u00e9r\u00eat et les apprentissages potentiels ! Cet endroit qu\u2019aujourd\u2019hui on n\u2019imagine pas autrement qu\u2019enfoui\u2026 n\u2019a pas toujours exist\u00e9 sous cette forme, loin s\u2019en faut !\r\nC\u2019est au 17e si\u00e8cle que se met en place \u00e0 Bruxelles le premier r\u00e9seau d\u2019\u00e9gouts ; toutefois celui-ci reste \u00e9l\u00e9mentaire et bon nombre de d\u00e9chets terminent encore leur itin\u00e9raire dans le cours d\u2019eau bruxellois, la Senne. Celle-ci charrie d\u00e9tritus et charognes, et d\u00e9borde r\u00e9guli\u00e8rement en temps de pluie, ou s\u2019ass\u00e8che en \u00e9t\u00e9, laissant s\u2019\u00e9chapper des odeurs peu subtiles\u2026\r\nUn grand plan d\u2019assainissement est ex\u00e9cut\u00e9 dans la seconde moiti\u00e9 du 19e si\u00e8cle. On d\u00e9cide de vo\u00fbter la Senne et d\u2019\u00e9tablir de larges boulevards \u00e0 la place des ruelles insalubres. Durant l\u2019entre-deux-guerres, une deuxi\u00e8me entreprise de d\u00e9tournement et de vo\u00fbtement du cours d\u2019eau viendra renforcer l\u2019efficacit\u00e9 des premiers travaux.\r\nProgressivement, le r\u00e9seau des \u00e9gouts va se perfectionner et s\u2019agrandir : comptant 45 km en 1847, on d\u00e9nombre actuellement 350 km de d\u00e9dales souterrains, qui recueillent conjointement les eaux pluviales et les eaux us\u00e9es provenant de l\u2019activit\u00e9 humaine. \r\n\r\nAper\u00e7u de ce r\u00e9seau, explications sur son histoire et le travail des hommes qui l\u2019entretiennent, cycle de l\u2019eau, etc. : ce sont l\u00e0 quelques-unes des th\u00e9matiques qui vous y attendent ! Notez que l\u2019entr\u00e9e du mus\u00e9e si\u00e8ge dans un des deux \u00ab pavillons d\u2019octroi \u00bb, b\u00e2timents qui mat\u00e9rialisent la perception de la taxe sur tous les biens entrant dans la Ville au 19e si\u00e8cle.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Museo del Alcantarillado (Mus\u00e9e des Egouts)","address_street_name":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museedesegouts.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_line2":"1000 Bruxelles","description_web":"En un primer momento, a uno no se le pasar\u00eda por la cabeza... \u00bfIr a visitar las alcantarillas de una gran ciudad? Pero si te paras a pensarlo, \u00a1ver\u00e1s r\u00e1pidamente el potencial de aprendizaje y el inter\u00e9s! Este lugar que, actualmente, solo nos imaginamos bajo tierra no siempre lo ha estado, ni mucho menos. En el siglo XVII se cre\u00f3 el primer sistema de alcantarillado en Bruselas; sin embargo, segu\u00eda siendo b\u00e1sico y muchos residuos terminaban su recorrido en el r\u00edo de la ciudad, el Senne. Este r\u00edo, que llevaba basura y carro\u00f1a, se sol\u00eda desbordar normalmente en \u00e9poca de lluvias, o se secaba en verano, lo que hac\u00eda que desprendiera olores desagradables...\r\nEn la segunda mitad del siglo XIX se puso en marcha un importante plan de saneamiento.\r\nSe decidi\u00f3 recubrir el Senne y crear amplios bulevares en lugar de callejones insalubres. Durante el per\u00edodo de entreguerras, unas segundas obras de recubrimiento y desv\u00edo del agua reforzaron las primeras. Gradualmente, el sistema de alcantarillado se mejor\u00f3 y ampli\u00f3: de 45 km en 1847, actualmente hay 350 km de laberintos subterr\u00e1neos, que recogen conjuntamente el agua de lluvia y las aguas residuales de la ciudad. El museo se inaugur\u00f3 en 1988 como respuesta a una demanda creciente y ofrece visitas realizadas por el propio personal del Servicio de Alcantarillado. Gracias a este museo podr\u00e1s disfrutar de una perspectiva general de esta red, explicaciones sobre su historia y sobre la labor que desempe\u00f1an sus trabajadores, informaci\u00f3n sobre el ciclo hidrol\u00f3gico, etc. Cabe destacar que la entrada al museo se encuentra en uno de los dos Pavillons d\u2019octroi, los edificios donde se recaudaban los impuestos de todas las mercanc\u00edas que entraban en la ciudad en el siglo XIX.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Riolenmuseum","address_street_name":"Octrooipaviljoen, Anderlechtsepoort","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.riolenmuseum.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Octrooipaviljoen, Anderlechtsepoort","address_line2":"1000 Brussel","description_web":"Zet eens een bezoek aan de Brusselse riolen en het Riolenmuseum op het programma van een uitstap in Brussel! Apart, ongewoon en onverwacht, maar vooral interessant en allesbehalve saai is zo\u2019n afdaling in ondergronds Brussel, begeleid door ervaren stadsgidsen of (voormalige) rioolwerkers.\r\nRiolen zijn levensnoodzakelijk geworden voor onze manier van leven, vandaar dat we ons maar moeilijk kunnen voorstellen hoe het eraan toeging toen ze nog niet bestonden. Een bezoek aan het Riolenmuseum (en een echte riool!) is dan ook verrassend, ongewoon en ongemeen boeiend.\r\nIn de 17de eeuw werd in Brussel een eerste riolennet in gebruik genomen. Dat bleef nog erg beperkt en het overgrote deel van het afvalwater vond nog altijd zijn weg naar die ene Brusselse rivier, de Zenne. Die voerde dan ook een smurrie van afval, viezigheid en zelfs dierenkadavers de hele stad door. Als de Zenne bij overvloedige regen overstroomde of in volle zomer opdroogde in de zomer, zorgde dat natuurlijk voor weinig aangename geurtjes...\r\nGedeeltelijk omwille van die overlast besloot de overheid in de tweede helft van de 19de eeuw om een overwelving aan te brengen boven de Zenne en grote boulevards aan te leggen in plaats van de vieze en slordige steegjes. Later werd tussen de twee Wereldoorlogen nog een tweede keer ingegrepen: een deel van de Zenne werd verlegd en er werden nog meer overwelvingen aangebracht. \r\nLangzamerhand verbeterde en vergrootte het riolennet, van 45 km in 1847 naar de huidige 350 km riool, die zowel afval- als regenwater afvoert. \r\nNaast een bezoek aan de riolen zelf levert dit museum een schat aan boeiende en interessante informatie op over alle aspecten van riolen, rioolwater en de mensen die ze \u2013 vaak in gevaarlijke en altijd in onaangename omstandigheden - onderhouden. Leuk: de ingang van het museum is gehuisvest in een van de twee octrooipaviljoenen aan de Anderlechtse Poort, waar vroeger tol werd geheven op goederen die in de stad werden binnengebracht.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":989,"location":{"lat":50.8450404,"lon":4.3386943},"last_updated_at":"2025-01-27T16:55:54+01:00","published_at":"2013-10-19T01:13:58+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/0c3444ec84f72e93aa20059425cf4a2905e53b5d.jpg","width":4032,"height":3024,"ratio":1.33,"oEmbed_height":3024,"oEmbed_width":4032,"translations":{"de":{"title":"\u00c0 la rencontre de nos voisins \u2013 Le Groene Phare","copyright":null},"pt":{"title":"\u00c0 la rencontre de nos voisins \u2013 Le Groene Phare","copyright":null},"en":{"title":"\u00c0 la rencontre de nos voisins \u2013 Le Groene Phare","copyright":null},"it":{"title":"\u00c0 la rencontre de nos voisins \u2013 Le Groene Phare","copyright":null},"cn":{"title":"\u00c0 la rencontre de nos voisins \u2013 Le Groene Phare","copyright":null},"fr":{"title":"\u00c0 la rencontre de nos voisins \u2013 Le Groene Phare","copyright":null},"sp":{"title":"\u00c0 la rencontre de nos voisins \u2013 Le Groene Phare","copyright":null},"nl":{"title":"\u00c0 la rencontre de nos voisins \u2013 Le Groene Phare","copyright":null}}}],"dates":[{"day":"2024-12-01","doors":"14:00:00","start":"14:00:00","end":"17:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2025-01-05","doors":"14:00:00","start":"14:00:00","end":"17:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2025-04-06","doors":"14:00:00","start":"14:00:00","end":"17:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2025-06-01","doors":"14:00:00","start":"14:00:00","end":"17:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false}],"prices":[],"date_exceptions":[],"closing_days":[],"child_events":[],"parent_events":[],"accessibilities":[],"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[]},{"id":5700005515,"date_start":"2025-02-06","date_end":"2025-04-07","date_next":"2025-04-07","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2025-01-25T11:52:02+01:00","published_at":"2025-01-16T10:49:52+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":316360,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"other","ranking":0.32006146360353477,"languages":{"spoken":["en","fr","nl"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[34,24],"translations":{"de":["Multidisziplin\u00e4r","Kunstgalerien"],"pt":[null,null],"en":["Multidisciplinary","Art Galleries"],"it":["Multidisciplinare","Gallerie d'arte"],"cn":[null,null],"fr":["Pluridisciplinaire","Galeries d'art"],"sp":["Multidisciplinar","Galer\u00edas de arte"],"nl":["Pluridisciplinair","Galeries"]}}},"translations":{"de":{"name":"Le G\u00e9ant Rocher Noir (The Giant Black Stone) - Expo solo de Azarakhsh Farahani","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.facebook.com\/events\/600978612524333","email":"commentpeutonetrepersan@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700005515"},"pt":{"name":"Le G\u00e9ant Rocher Noir (The Giant Black Stone) - Expo solo de Azarakhsh Farahani","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.facebook.com\/events\/600978612524333","email":"commentpeutonetrepersan@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700005515"},"en":{"name":"Le G\u00e9ant Rocher Noir (The Giant Black Stone) - Expo solo de Azarakhsh Farahani","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.facebook.com\/events\/600978612524333","email":"commentpeutonetrepersan@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700005515"},"it":{"name":"Le G\u00e9ant Rocher Noir (The Giant Black Stone) - Expo solo de Azarakhsh Farahani","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.facebook.com\/events\/600978612524333","email":"commentpeutonetrepersan@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700005515"},"cn":{"name":"Le G\u00e9ant Rocher Noir (The Giant Black Stone) - Expo solo de Azarakhsh Farahani","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.facebook.com\/events\/600978612524333","email":"commentpeutonetrepersan@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700005515"},"fr":{"name":"Le G\u00e9ant Rocher Noir (The Giant Black Stone) - Expo solo de Azarakhsh Farahani","shortdescr":"Vernissage : Jeudi 6 f\u00e9vrier 2025, de 18h \u00e0 21h\n\nHeures de visite :\n7 et 8 f\u00e9vrier : de 14h \u00e0 18h (en pr\u00e9sence de l\u2019artiste)\nDimanche 9 f\u00e9vrier : de 11h \u00e0 15h\n15 et 16 f\u00e9vrier : de 14h \u00e0 18h\nSur rendez-vous jusqu\u2019au 7 avril","longdescr":"Azarakhsh Farahani, n\u00e9 en 1980 \u00e0 T\u00e9h\u00e9ran, est un artiste multidisciplinaire iranien qui vit et travaille actuellement entre l\u2019Iran et la France. Sa prochaine exposition solo, intitul\u00e9e Le G\u00e9ant Rocher Noir, se tiendra \u00e0 la galerie Art Base \u00e0 Bruxelles. Cette exposition, compos\u00e9e de dessins et peintures, s\u2019inspire de son court m\u00e9trage \u00e9ponyme, enti\u00e8rement \u00e9crit, illustr\u00e9 et con\u00e7u sur le plan sonore par l\u2019artiste.\n\n\u00c0 travers des couches symboliques et une narration subtile, Azarakhsh d\u00e9voile une histoire poignante et captivante qui interpelle les spectateurs. Le G\u00e9ant Rocher Noir a r\u00e9cemment \u00e9t\u00e9 s\u00e9lectionn\u00e9 au Festival international du film de G\u00e9rone (Espagne, 2024) et au Festival du film Bahari (Indon\u00e9sie, 2024). Bien que ses \u0153uvres s'inspirent des r\u00e9cents \u00e9v\u00e9nements en Iran, elles transcendent les cadres politiques et sociaux pour toucher des publics universels, en particulier ceux confront\u00e9s \u00e0 des r\u00e9gimes oppressifs.\n\nAvec ses cr\u00e9ations riches en couleurs, Azarakhsh cherche \u00e0 instaurer une harmonie, tant entre les teintes qu'entre les cultures et les peuples. Dans un monde divis\u00e9 par les oppresseurs, il voit son art comme un outil d\u2019unit\u00e9, transformant sa douleur en une explosion chromatique. Son travail, profond\u00e9ment personnel, r\u00e9sonne aussi comme un message universel.\nNe manquez pas cette immersion artistique le jeudi 6 f\u00e9vrier 2025 \u00e0 la galerie Art Base, qui accueille Azarakhsh pour la seconde fois, apr\u00e8s son exposition de 2018. \n\nLe dessin anim\u00e9 Le G\u00e9ant Rocher Noir, d'une dur\u00e9e de 11 minutes, sera projet\u00e9 plusieurs fois durant l\u2019exposition.\n\nAdresse (Art Base Galerie) :\n29, rue des Sables, 1000 Bruxelles\n\n\nEn collaboration avec le collectif Comment peut-on \u00eatre persan ?\nhttps:\/\/www.facebook.com\/Commentpeutonetrepersan","performers":"Expo solo de Azarakhsh Farahani.\nAvec la projection du court m\u00e9trage d\u2019animation Le G\u00e9ant Rocher Noir, r\u00e9alis\u00e9 par Azarakhsh Farahani et Paniz Rafieimehr.","boxoffice_url":null,"website":"https:\/\/www.facebook.com\/events\/600978612524333","email":"commentpeutonetrepersan@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700005515"},"sp":{"name":"Le G\u00e9ant Rocher Noir (The Giant Black Stone) - Expo solo de Azarakhsh Farahani","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.facebook.com\/events\/600978612524333","email":"commentpeutonetrepersan@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700005515"},"nl":{"name":"Le G\u00e9ant Rocher Noir (De Reusachtige Zwarte Steen) - Solotentoonstelling van Azarakhsh Farahani","shortdescr":"Vernissage: Donderdag 6 februari 2025, van 18.00 tot 21.00 uur\n\nBezoekuren:\n7 en 8 februari: van 14.00 tot 18.00 uur (in aanwezigheid van de kunstenaar)\nZondag 9 februari: van 11.00 tot 15.00 uur\n15 en 16 februari: van 14.00 tot 18.00 uur\nOp afspraak tot 7 april","longdescr":"\nAzarakhsh Farahani, geboren in 1980 in Teheran, is een Iraanse multidisciplinaire kunstenaar die momenteel woont en werkt tussen Iran en Frankrijk. Zijn volgende solotentoonstelling, getiteld Le G\u00e9ant Rocher Noir, zal plaatsvinden in de galerie Art Base in Brussel. De tentoonstelling, bestaande uit tekeningen en schilderijen, is ge\u00efnspireerd op zijn gelijknamige korte film die volledig door de kunstenaar is geschreven, ge\u00efllustreerd en van geluid voorzien.\n\nDoor middel van lagen symboliek en subtiele vertellingen onthult Azarakhsh een aangrijpend en boeiend verhaal dat de kijker boeit. Le G\u00e9ant Rocher Noir werd onlangs geselecteerd voor het Girona International Film Festival (Spanje, 2024) en het Bahari Film Festival (Indonesi\u00eb, 2024). Hoewel haar werk is ge\u00efnspireerd door recente gebeurtenissen in Iran, overstijgt het politieke en sociale kaders om een universeel publiek te bereiken, met name degenen die te maken hebben met onderdrukkende regimes.\n\nMet haar kleurrijke creaties probeert Azarakhsh harmonie te cre\u00ebren, zowel tussen kleuren als tussen culturen en volkeren. In een wereld die verdeeld is door onderdrukkers ziet hij zijn kunst als een instrument voor eenheid, waarbij hij zijn pijn omzet in een chromatische explosie. Zijn diep persoonlijke werk resoneert ook als een universele boodschap.\nMis deze artistieke onderdompeling niet op donderdag 6 februari 2025 in de Art Base galerie, die Azarakhsh voor de tweede keer verwelkomt, na zijn tentoonstelling in 2018. \n\nDe 11 minuten durende animatiefilm Le G\u00e9ant Rocher Noir zal tijdens de tentoonstelling verschillende keren worden vertoond.\n\nAdres (Art Base Galerie):\n29, Rue des Sables, 1000 Brussel\n\nIn samenwerking met het collectief Hoe kan men Pers zijn?\nhttps:\/\/www.facebook.com\/Commentpeutonetrepersan","performers":"Solotentoonstelling van Azarakhsh Farahani.\nMet een vertoning van de korte animatiefilm Le G\u00e9ant Rocher Noir, geregisseerd door Azarakhsh Farahani en Paniz Rafieimehr.","boxoffice_url":null,"website":"https:\/\/www.facebook.com\/events\/600978612524333","email":"commentpeutonetrepersan@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700005515"}},"place":{"id":243364,"translations":{"de":{"name":"Art Base","address_street_name":"Rue des Sables","address_street_number":"29","address_street_box":null,"email":"info2@art-base.be","website":"http:\/\/www.art-base.be","phone_contact":"+32 2 217 29 20","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Sables, 29","address_line2":"1000 Bruxelles","description_web":"Ein vielseitiger Veranstaltungsraum gleich gegen\u00fcber dem Br\u00fcsseler Comic-Zentrum, der nicht nur exzellente Konzerte - vor allem Weltmusik - aber auch Gem\u00e4lde-, Skulpturen- und Fotoausstellungen stattfinden.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Art Base","address_street_name":"Rue des Sables","address_street_number":"29","address_street_box":null,"email":"info2@art-base.be","website":"http:\/\/www.art-base.be","phone_contact":"+32 2 217 29 20","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Sables, 29","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Art Base","address_street_name":"Rue des Sables","address_street_number":"29","address_street_box":null,"email":"info2@art-base.be","