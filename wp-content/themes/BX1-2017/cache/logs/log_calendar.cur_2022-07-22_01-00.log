"2022-08-17","doors":null,"start":"14:00:00","end":"17:00:00"},{"day":"2022-08-18","doors":null,"start":"14:00:00","end":"17:00:00"},{"day":"2022-08-19","doors":null,"start":"14:00:00","end":"17:00:00"},{"day":"2022-08-20","doors":null,"start":"14:00:00","end":"17:00:00"},{"day":"2022-08-21","doors":null,"start":"14:00:00","end":"17:00:00"},{"day":"2022-08-24","doors":null,"start":"14:00:00","end":"17:00:00"},{"day":"2022-08-25","doors":null,"start":"14:00:00","end":"17:00:00"},{"day":"2022-08-26","doors":null,"start":"14:00:00","end":"17:00:00"},{"day":"2022-08-27","doors":null,"start":"14:00:00","end":"17:00:00"},{"day":"2022-08-28","doors":null,"start":"14:00:00","end":"17:00:00"}],"weekschema":[{"days":{"monday":{"is_open":false},"tuesday":{"is_open":false},"wednesday":{"is_open":true,"hours":[{"start":"14:00:00","end":"17:00:00"}]},"thursday":{"is_open":true,"hours":[{"start":"14:00:00","end":"17:00:00"}]},"friday":{"is_open":true,"hours":[{"start":"14:00:00","end":"17:00:00"}]},"saturday":{"is_open":true,"hours":[{"start":"14:00:00","end":"17:00:00"}]},"sunday":{"is_open":true,"hours":[{"start":"14:00:00","end":"17:00:00"}]}},"translations":{"fr":["lundi et mardi: ferm\u00e9","mercredi, jeudi, vendredi, samedi et dimanche: de 14:00 \u00e0 17:00"],"nl":["maandag en dinsdag: gesloten","woensdag, donderdag, vrijdag, zaterdag en zondag: van 14:00 tot 17:00"],"en":["monday and tuesday: closed","wednesday, thursday, friday, saturday and sunday: from 14:00 to 17:00"]},"date_start":"2022-07-02","date_end":"2022-08-28","is_also_by_appointment":false}],"date_exceptions":[{"day":"2022-07-21","start":"14:00:00","end":"17:00:00"},{"day":"2022-08-15","start":"14:00:00","end":"17:00:00"}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":10}],"child_events":[],"parent_events":[],"targets":{"list":[4,5,11,7,8],"translations":{"fr":["Enfants 6-9 ans","Enfants 9-12 ans","Famille","Jeunes 12-15 ans","Jeunes 15-18 ans"],"nl":["Kinderen 6-9 j.","Kinderen 9-12 j.","Familie","Jongeren 12-15 j.","Jongeren 15-18 j."],"en":["Children 6-9 yr.","Children 9-12 yr.","Family","Youth 12-15  yr.","Youth 15-18  yr."]}},"tags":["kids"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-07-21T01:35:20+02:00","published_at":"2022-04-04T14:52:27+02:00","backoffice_id":250851,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.32548726473767},{"id":537707,"date_start":"2022-07-02","date_end":"2022-07-31","date_next":"2022-07-21","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[36,39],"translations":{"fr":["Mus\u00e9es et art centers","Photographie"],"nl":["Musea en kunstcentra","Fotografie"],"en":["Museums and art centers","Photography"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Secret Garden","shortdescr":"Photographie Alternative - Cr\u00e9ations bas\u00e9es sur l'imaginaire, l'organique et le v\u00e9g\u00e9tal","longdescr":"Choisis et r\u00e9cup\u00e9r\u00e9s le long des chemins, les arrangements v\u00e9g\u00e9taux imaginaires de Marie-H\u00e9l\u00e8ne Sion sont mod\u00e9lis\u00e9s et modifi\u00e9s en structures 3D mouvantes par Petermfriess. Projections d'un monde d'esp\u00e8ces v\u00e9g\u00e9tales inconnues, d'harmonies de couleurs et de formes, ils reconstituent par leur enchev\u00eatrement des paysages, passage constant entre irr\u00e9el et r\u00e9el.\r\n\r\nLes aplats de couleurs profondes de Monya Ghabantani font entrer dans une myriade de nuances et d'ombres. R\u00e9actions photochimiques entre la g\u00e9latine et les sels de fer, les chimigrammes organiques aspirent vers le noir pur.\r\n\r\nLaure Winants, exp\u00e9rimentation en cours sur la mati\u00e8re. Une rencontre entre la physique de la peinture et l'\u00e9mulsion photographique, troquant la toile par le Washi, le kozo, ou encore le shiramine.\r\n\r\nOlivier Guyaux revisite une s\u00e9rie de paysages de la for\u00eat de Soignes en 1900. Tirages pictorialistes attribu\u00e9s au \"Cercle Photographique d'Ixelles\" 1893 - 1914, ce fut l'un des plus actifs pour promouvoir la photographie comme un art \u00e0 part enti\u00e8re. Tirages proc\u00e9d\u00e9s anciens d'apr\u00e8s les plaques originales.\r\n\r\nGrands voyageurs de toujours les oiseaux brouillent les fronti\u00e8res \u00e9tablies par l'homme - et le cadre photographique - pour trouver des oasis secr\u00e8tes. D'en bas, nous pouvons rep\u00e9rer des yeux vifs exprimant une sagesse et une \u00e9motion inconnues avec lesquelles ils nous observent depuis leur cachette. Qui observe qui ? Carole Moncoquet pr\u00e9f\u00e8re les tons clairs, afin d'appr\u00e9cier pleinement les d\u00e9grad\u00e9s et les textures du r\u00e8gne animal tropical.\r\n\r\nLa serre imaginaire est compl\u00e9t\u00e9e par 'PASSAGES', court m\u00e9trage de Gianluca Colitta, qui raconte une histoire de travers\u00e9es et de changements d'\u00e9tat. Une femme sort du pass\u00e9, mais pourquoi ? Elle est \u00e0 la recherche de quelqu'un ou de quelque chose et se prom\u00e8ne dans un jardin secret rempli de souvenirs. Le film invite le public \u00e0 se promener et \u00e0 se perdre dans la beaut\u00e9 de ce lieu.","performers":"Marie-H\u00e9l\u00e8ne Sion, Petermfriess, Monya Ghabantani, Olivier Guyaux, Gianluca Colitta, Carole Moncoquet, Laure Winants","boxoffice_url":null,"website":"http:\/\/www.tinygallery.photo","email":"ogc@ogc.be","phone_contact":null,"phone_booking":"+32 475 27 95 56","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/537707.html"},"nl":{"name":"Secret Garden","shortdescr":"Alternatieve Fotografie - Creaties op basis van het imaginaire, het organische en het plantaardige","longdescr":"De buitenaardse plantenarrangementen van Marie-H\u00e9l\u00e8ne Sion zijn door Petermfriess gemodelleerd en omgevormd tot bewegende 3D-structuren, geselecteerd en geplukt langs buitenpaden. Deze projecties van een wereld van onbekende plantensoorten, van harmonie\u00ebn, kleuren en vormen, reconstitueren landschappen door hun verstrengelde verschijningen, en fungeren als een constante doorgang tussen het echte en het onechte.\r\n\r\nMonya Ghabantani's blokken van diepe kleuren laten ons binnen in een myriade van schakeringen en schaduwen. Chemigrammen, foto-chemische reacties tussen gelatine en ijzerzouten, tekenen een pure duisternis in.\r\n\r\nHet werk van Laure Winants is een voortdurend experiment met ruwe materialen. Het is een ontmoeting tussen de lichamelijkheid van verf en fotografische emulsie, waarbij het doek wordt vervangen door Washi, Kozo, en zelfs Shiramine papier.\r\n\r\nOlivier Guyaux herneemt een reeks landschappen in het Zoni\u00ebnwoud in 1900. De picturalistische prenten worden toegeschreven aan de \"Cercle Photographique d'Elsene\" (de fotografiegroep van Elsene) 1893-1914. Dit was een van de meest actieve groepen in zijn soort om de fotografie als volwaardige kunstvorm te promoten. Deze antieke afdrukken werden op traditionele wijze van originele platen vervaardigd.\r\n\r\nAls ultieme reizigers kunnen vogels de door de mens getrokken grenzen - en het fotografisch kader - doen vervagen om geheime oases te vinden. Van onderaf zien we scherpe ogen die een ongekende wijsheid en emotie uitdrukken waarmee ze ons vanuit hun schuilplaatsen observeren. Wie observeert wie? Carole Moncoquet geeft de voorkeur aan lichtere tinten, om het kleurverloop en de textuur die in het tropische dierenrijk te zien zijn ten volle te ervaren.\r\n\r\nDeze kas van de verbeelding wordt gecompleteerd door 'PASSAGES', een korte film van Gianluca Colitta. De film vertelt een verhaal van kruispunten en transformaties. Een vrouw komt uit het verleden... maar waarvoor? Ze is op zoek naar iemand of iets terwijl ze door een geheime tuin vol herinneringen dwaalt - Deze film nodigt het publiek uit om zelf ook te gaan dwalen en te verdwalen in de fantastische schoonheid van deze plek.","performers":"Marie-H\u00e9l\u00e8ne Sion, Petermfriess, Monya Ghabantani, Olivier Guyaux, Gianluca Colitta, Carole Moncoquet, Laure Winants","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/537707.html"},"en":{"name":"Secret Garden","shortdescr":"Alternative Photography - Creations based on the imaginary, organic, and vegetal","longdescr":"Selected and picked from along outdoor pathways, Marie-H\u00e9l\u00e8ne Sion\u2019s otherworldly plant arrangements have been both modelled and morphed into moving 3D structures by Petermfriess. These projections of a world of unknown plant species, of harmonies, colours and shapes, reconstitute landscapes through their entangled appearances, and act as a constant passageway between the real and the unreal.\r\n\r\nMonya Ghabantani\u2019s blocks of deep colour allow us to enter into a myriad of shades and shadows. Chemigrams, photo-chemical reactions between gelatine and iron salts, draw in a pure darkness.\r\n\r\nLaure Winants\u2019 work is an ongoing experiment with raw materials. It is a meeting between the physicality of paint and photographic emulsion, where the canvas is replaced with Washi, Kozo, and even Shiramine paper.\r\n\r\nOlivier Guyaux revisits a series of landscapes in the Sonian Forest in 1900. The pictorialist prints are attributed to the \u201cCercle Photographique d\u2019Ixelles\u201d (The Ixelles Photography Group) 1893-1914. This was one of the most active groups of its kind for promoting photography as an art form in its own right. These antique prints were produced from original plates using the traditional method.\r\n\r\nAs the ultimate travellers, birds can blur the lines of manmade frontiers -and photographic framing- to find secret oases. From below, we can spot keen eyes expressing unknown wisdom and emotion with which they observe us from their hiding places. Who is observing whom? Carole Moncoquet prefers lighter tones, to fully experience the gradient and texture that are on display in the tropical animal kingdom.\r\n\r\nThis greenhouse of the imagination is completed by \u2018PASSAGES\u2019, a short film by Gianluca Colitta. The film tells a story of intersections and transformations.  A woman comes out of the past\u2026but what for? She is searching for someone or something whilst on a wander through a secret garden filled with memories \u2013 This film invites its audience to go on a wander of their own and get lost in the fantastical beauty of this place.","performers":"Marie-H\u00e9l\u00e8ne Sion, Petermfriess, Monya Ghabantani, Olivier Guyaux, Gianluca Colitta, Carole Moncoquet, Laure Winants","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/537707.html"},"de":{"name":"Secret Garden","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/537707.html"},"it":{"name":"Secret Garden","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/537707.html"},"sp":{"name":"Secret Garden","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/537707.html"},"pt":{"name":"Secret Garden","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":