ted_at":"2024-02-18T01:03:12+01:00","published_at":"2024-01-22T16:34:38+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":292879,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.41008825631569273,"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[36],"translations":{"de":["Museen & Kunstzentren"],"pt":[null],"en":["Museums and art centers"],"it":["Musei e centri artistici"],"cn":[null],"fr":["Mus\u00e9es et art centers"],"sp":["Museos y centros de arte"],"nl":["Musea en kunstcentra"]}}},"translations":{"de":{"name":"The Colour Shifts","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/ohme.be\/fr\/studio-fr\/thecolourshifts\/","email":"info@ohme.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50006355"},"pt":{"name":"The Colour Shifts","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/ohme.be\/fr\/studio-fr\/thecolourshifts\/","email":"info@ohme.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50006355"},"en":{"name":"The Colour Shifts","shortdescr":"Come discover the magic of colours, the mystery of light and the power of sound! \n\n7 artists showcases their mersmerizing work that merge artistic practice and scientific curiosities. \nFrom changing colours to liquid crystals, from myscroscopy to brainwaves, The Colour Shifts will take you on a journey at the discovery of your perceptions. \n","longdescr":"The Colour Shifts showcases the work of artists supported by Ohme, the Brussels Art & Science organisation, over the last two years, along with some of the project realised by Ohme Lab, the research & development branch of Ohme at the service of artistic creation.\n\nPresenting an overview of the creative process and the artistic, scientific and technical explorations underway, The Colour Shifts is built around the concept of \u2018Work in Progress\u2019, and aims to immerse visitors in projects at different stages of development, ranging from initial conception to final realisation. \n\nIn this way, the exhibition creates a dialogue between the creative process, the gradual materialisation of ideas, and the finished work.\n\nBy bringing all this research together, a theme emerges, that of colour. Immersive and contemplative approaches come together to deliver sensory experiences and reflections on how colour can influence or inspire our imagination, change our perceptions and impact our senses.\nThe colour shifts is an exhibition conceived and produced by Ohme\n\nWith the support of :\nR\u00e9gion de Bruxelles-Capitale - Innoviris | F\u00e9d\u00e9ration Wallonie-Bruxelles | Loterie Nationale | CoCof\n","performers":"An exciting exhibition exploring colour, light and sound through immersive, interactive and mind-bending artworks, merging art and science in a journey full of surprises that will challenge your perceptions!\n\nWith Karl Cazavet, Clara Duflos, Yannick Jacquet, Otto Lindholm, Adrien Lucca, Ohme, Thomas Raa\n\n Fridays late on 09.02, 16.02, 23.02 and 01.03 with live music, performances, talks & djsets! ","boxoffice_url":null,"website":"https:\/\/ohme.be\/studio\/thecolourshifts\/","email":"info@ohme.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50006355"},"it":{"name":"The Colour Shifts","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/ohme.be\/fr\/studio-fr\/thecolourshifts\/","email":"info@ohme.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50006355"},"cn":{"name":"The Colour Shifts","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/ohme.be\/fr\/studio-fr\/thecolourshifts\/","email":"info@ohme.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50006355"},"fr":{"name":"The Colour Shifts","shortdescr":"Viens d\u00e9couvrir la magie des couleurs, le myst\u00e8re de la lumi\u00e8re et la puissance du son ! \n\n7 artistes te pr\u00e9sentent leurs \u0153uvres mersmerisantes qui fusionnent pratique artistique et curiosit\u00e9s scientifiques. \nDes couleurs changeantes aux cristaux liquides, de la myscroscopie aux ondes c\u00e9r\u00e9brales, The Colour Shifts t'emm\u00e8nera dans un voyage \u00e0 la d\u00e9couverte de tes perceptions. \n\n","longdescr":"The Colour Shifts pr\u00e9sente le travail des artistes soutenus par Ohme, l'organisation bruxelloise Art & Science, au cours des deux derni\u00e8res ann\u00e9es, ainsi que certains projets r\u00e9alis\u00e9s par Ohme Lab, la branche recherche & d\u00e9veloppement de ohme au service de la cr\u00e9ation artistique.\n\nPr\u00e9sentant un aper\u00e7u du processus cr\u00e9atif et des explorations artistiques, scientifiques et techniques en cours, The Colour Shifts s'articule autour du concept de \"Work in Progress\" et vise \u00e0 immerger les visiteurs dans des projets \u00e0 diff\u00e9rents stades de d\u00e9veloppement, allant de la conception initiale \u00e0 la r\u00e9alisation finale. L'exposition cr\u00e9e ainsi un dialogue entre le processus cr\u00e9atif, la mat\u00e9rialisation progressive des id\u00e9es et l'\u0153uvre achev\u00e9e.\n\nEn rassemblant toutes ces recherches, un th\u00e8me \u00e9merge, celui de la couleur. Les approches immersives et contemplatives se rejoignent pour offrir des exp\u00e9riences sensorielles et des r\u00e9flexions sur la fa\u00e7on dont la couleur peut influencer ou inspirer notre imagination, changer nos perceptions et avoir un impact sur nos sens.\n\nThe colour shifts est une exposition conc\u0327ue et produite par Ohme\n\nAvec le soutien de :\nR\u00e9gion de Bruxelles-Capitale \u2013 Innoviris | F\u00e9d\u00e9ration Wallonie-Bruxelles  | Loterie Nationale | CoCof","performers":"Une exposition passionnante qui explore la couleur, la lumi\u00e8re et le son \u00e0 travers des \u0153uvres immersives et interactives, fusionnant l'art et la science dans un voyage surprenant qui d\u00e9fie perceptions !\n\nAvec Karl Cazavet, Clara Duflos, Yannick Jacquet, Otto Lindholm, Adrien Lucca, Ohme, Thomas Raa\n\nFridays late le 09.02, 16.02, 23.02 et 01.03 avec musique live, performances, talks et djsets ! ","boxoffice_url":null,"website":"https:\/\/ohme.be\/fr\/studio-fr\/thecolourshifts\/","email":"info@ohme.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50006355"},"sp":{"name":"The Colour Shifts","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/ohme.be\/fr\/studio-fr\/thecolourshifts\/","email":"info@ohme.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50006355"},"nl":{"name":"The Colour Shifts","shortdescr":"Kom de magie van kleuren, het mysterie van licht en de kracht van geluid ontdekken! \n\n7 kunstenaars laten hun verrassende werk zien waarin artistieke praktijk en wetenschappelijke nieuwsgierigheden samenkomen. \nVan veranderende kleuren tot vloeibare kristallen, van myscroscopie tot hersengolven, The Colour Shifts neemt je mee op een reis naar de ontdekking van je waarnemingen. \n\n","longdescr":"The Colour Shifts toont het werk van kunstenaars die de afgelopen twee jaar zijn ondersteund door Ohme, de Brusselse organisatie voor Kunst & Wetenschap, samen met enkele van de projecten die zijn gerealiseerd door Ohme Lab, de onderzoeks- en ontwikkelingstak van Ohme ten dienste van artistieke creatie.\n\nThe Colour Shifts presenteert een overzicht van het creatieve proces en de lopende artistieke, wetenschappelijke en technische verkenningen en is opgebouwd rond het concept van 'Werk in uitvoering'. Het doel is om bezoekers onder te dompelen in projecten in verschillende stadia van ontwikkeling, van het eerste concept tot de uiteindelijke realisatie. \n\nOp deze manier cre\u00ebert de tentoonstelling een dialoog tussen het creatieve proces, de geleidelijke materialisatie van idee\u00ebn en het voltooide werk.\n\nDoor al dit onderzoek samen te brengen komt er een thema naar voren, namelijk kleur. Immersieve en contemplatieve benaderingen komen samen om zintuiglijke ervaringen en reflecties te bieden over hoe kleur onze verbeelding kan be\u00efnvloeden of inspireren, onze percepties kan veranderen en onze zintuigen kan be\u00efnvloeden.\n\nThe colour shifts is een tentoonstelling bedacht en geproduceerd door Ohme\n\nMet de steun van :\nBrussels Hoofdstedelijk Gewest - Innoviris | F\u00e9d\u00e9ration Wallonie-Bruxelles | Nationale Loterij | CoCof","performers":"Een spannende tentoonstelling waarin kleur, licht en geluid worden verkend door middel van meeslepende, interactieve en breinbrekende kunstwerken, waarin kunst en wetenschap samenkomen in een reis vol verrassingen die je waarnemingen op de proef zullen stellen!\n\nFridays late op 09.02, 16.02, 23.02 en 01.03 met live muziek, optredens, talks & djsets! ","boxoffice_url":null,"website":"https:\/\/ohme.be\/studio\/thecolourshifts\/","email":"info@ohme.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50006355"}},"place":{"id":273242,"translations":{"de":{"name":"LaVall\u00e9e","address_street_name":"Rue Adolphe Lavall\u00e9e","address_street_number":"39","address_street_box":null,"email":null,"website":"http:\/\/www.lavallee.brussels","phone_contact":"+32 491 71 43 65","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Rue Adolphe Lavall\u00e9e, 39","address_line2":"1080 Molenbeek-Saint-Jean","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"LaVall\u00e9e","address_street_name":"Rue Adolphe Lavall\u00e9e","address_street_number":"39","address_street_box":null,"email":null,"website":"http:\/\/www.lavallee.brussels","phone_contact":"+32 491 71 43 65","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Rue Adolphe Lavall\u00e9e, 39","address_line2":"1080 Molenbeek-Saint-Jean","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"LaVall\u00e9e","address_street_name":"Adolphe Lavall\u00e9e Straat","address_street_number":"39","address_street_box":null,"email":null,"website":"http:\/\/www.lavallee.brussels","phone_contact":"+32 491 71 43 65","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Adolphe Lavall\u00e9e Straat, 39","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"LaVall\u00e9e, a 6 000 m\u00b2 former industrial laundry in Molenbeek, is a 'third place' that houses a community of artists and creative entrepreneurs, offering a multidisciplinary cultural programme, as well as spaces for rent. \r\n\r\nIt is a dynamic and friendly space thanks to the synergies between its various occupants, and its high quality yet offbeat programming.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"LaVall\u00e9e","address_street_name":"Rue Adolphe Lavall\u00e9e","address_street_number":"39","address_street_box":null,"email":null,"website":"http:\/\/www.lavallee.brussels","phone_contact":"+32 491 71 43 65","phone_bookin