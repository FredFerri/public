":"Avenue Emile Max, 153","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"L'Os \u00e0 Moelle","address_street_name":"Avenue Emile Max","address_street_number":"153","address_street_box":null,"email":"reservation@osamoelle.be","website":"http:\/\/www.osamoelle.be","phone_contact":"+32 487 22 50 22","phone_booking":"+32 487 22 50 22","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Avenue Emile Max, 153","address_line2":"1030 Schaerbeek","description_web":"Bienvenue dans le plus ancien cabaret de Bruxelles !\u202fCela m\u00e9rite en soi un hommage. De plus, c\u2019est aussi la cave de la maison natale de notre fiert\u00e9 bruxelloise, Jacques Brel. Depuis les ann\u00e9es 60, de grandes stars sont pass\u00e9es par ici\u202f; pensez \u00e0 Toots Thielemans, Philippe Lafontaine, Barbara et Arno. D\u00e9sormais, vous pouvez venir ici chaque semaine pour profiter d'un solide programme allant du th\u00e9\u00e2tre d'improvisation, des spectacles de com\u00e9die et d'auteurs-compositeurs-interpr\u00e8tes aux soir\u00e9es de po\u00e9sie, au th\u00e9\u00e2tre de marionnettes et aux f\u00eates dans le style \u00ab\u202fann\u00e9es folles\u202f\u00bb. \r\n\r\n ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"L'Os \u00e0 Moelle","address_street_name":"Avenue Emile Max","address_street_number":"153","address_street_box":null,"email":"reservation@osamoelle.be","website":"http:\/\/www.osamoelle.be","phone_contact":"+32 487 22 50 22","phone_booking":"+32 487 22 50 22","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Avenue Emile Max, 153","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"L'Os \u00e0 Moelle","address_street_name":"Emile Maxlaan","address_street_number":"153","address_street_box":null,"email":"reservation@osamoelle.be","website":"http:\/\/www.osamoelle.be","phone_contact":"+32 487 22 50 22","phone_booking":"+32 487 22 50 22","address_zip":"1030","address_city":"Schaarbeek","address_line1":"Emile Maxlaan, 153","address_line2":"1030 Schaarbeek","description_web":"Welkom in het oudste cabarettheater van Brussel!\u202fDat op zich verdient al een pluim, en het is ook nog eens de charmante kelder van het geboortehuis van onze Brusselse trots Jacques Brel. Sinds de jaren 60 passeerden hier grote Franse sterren de revue, denk aan Toots Thielemans, Philippe Lafontaine, Barbara en Arno. Nu kan hier wekelijks komen genieten van een stevig programma gaande van improvisatietheater, comedy en singer-songwriteroptredens tot po\u00ebzieavonden, poppentheater en feestjes in \u2018roaring-twenties\u2019-stijl. \r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[22],"translations":{"de":["Osten"],"pt":[null],"en":["East"],"it":["Est"],"cn":[null],"fr":["Est"],"sp":["Este"],"nl":["Oost"]}},"neca":null,"facebook_id":"osamoellecabaret","backoffice_id":176,"location":{"lat":50.85131869,"lon":4.39874268},"region":"brussels","last_updated_at":"2022-10-10T10:25:09+02:00","published_at":"2013-10-19T01:13:20+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":1078,"translations":{"de":{"name":"L'Os \u00e0 Moelle","address_street_name":"Avenue Emile Max","address_street_number":"153","address_street_box":null,"email":"reservation@osamoelle.be","website":"http:\/\/www.osamoelle.be","phone_contact":"+32 487 22 50 22","phone_booking":"+32 487 22 50 22","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Avenue Emile Max, 153","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking