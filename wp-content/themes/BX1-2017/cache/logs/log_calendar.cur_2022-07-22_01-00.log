ll,"phone_booking":null,"address_zip":"1090","address_city":"Jette","address_line1":"Koning Boudewijnpark","address_line2":"1090 Jette","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Parc Roi Baudoin","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1090","address_city":"Jette","address_line1":"Parc Roi Baudoin","address_line2":"1090 Jette","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Parc Roi Baudoin","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1090","address_city":"Jette","address_line1":"Parc Roi Baudoin","address_line2":"1090 Jette","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Parc Roi Baudoin","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1090","address_city":"Jette","address_line1":"Parc Roi Baudoin","address_line2":"1090 Jette","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Parc Roi Baudoin","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1090","address_city":"Jette","address_line1":"Parc Roi Baudoin","address_line2":"1090 Jette","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Parque Rei Baldu\u00edno","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1090","address_city":"Jette","address_line1":"Parque Rei Baldu\u00edno","address_line2":"1090 Jette","description_web":"O Parque Rei Baldu\u00edno \u00e9 composto pelo Laarbeekbos, o Poelbos, o Parque du Sacr\u00e9-C\u0153ur (Sagrado Cora\u00e7\u00e3o) e do Bosque de Dieleghem. A descoberta de bi\u00f3topos muito variados ou de locais naturais ou seminaturais \u00e9 um dos bons motivos para partir \u00e0 descoberta deste para\u00edso verde do noroeste de Bruxelas. O aspeto rural est\u00e1 a\u00ed consumado pelos jardins hort\u00edcolas e pela Quinta das Crian\u00e7as (Ferme des Enfants). \u00c9 composto por v\u00e1rias partes ou fases que correspondem a tipos espec\u00edficos de ordena\u00e7\u00e3o. Fases I e II: parques cl\u00e1ssicos (altern\u00e2ncia de passeios, lagoas, maci\u00e7os hort\u00edcolas, bosques e espa\u00e7os para crian\u00e7as). Fase III: zona mais campestre com pradarias, pequenos bosques, sebes e zonas h\u00famidas.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Parc Roi Baudoin","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1090","address_city":"Jette","address_line1":"Parc Roi Baudoin","address_line2":"1090 Jette","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":[],"zones":{"list":[23],"translations":{"fr":["Ouest"],"nl":["West"],"en":["West"]}},"neca":null,"facebook_id":null,"backoffice_id":30957,"location":{"lat":50.86340424,"lon":4.29576836},"region":"brussels","last_updated_at":"2022-06-23T13:05:26+02:00","published_at":"2018-03-07T16:15:41+01:00","import_origin":null,"external_id":null,"is_in_address_book":false,"is_in_vb_export":false,"resto_ranking":0},"organizer":{"id":243659,"translations":{"fr":{"name":"Conte en balade (ASBL Mots et Merveilles)","address_street_name":"Rue Ver Eycken","address_street_number":"1","address_street_box":null,"email":"info@conteenbalade.be","website":"https:\/\/www.conteenbalade.be\/","phone_contact":"+32 497 78 20 75","phone_booking":"+32 497 78 20 75","address_zip":"1160","address_city":"Auderghem","address_line1":"Rue Ver Eycken, 1","address_line2":"1160 Auderghem","description_web":"G\u00e9n\u00e9tiquement nomade, l'asbl Mots et Merveilles programme des conteurs professionnels ou \u00e9mergents d'horizons vari\u00e9s et am\u00e8ne le conte dans divers lieux inattendus, ouvrant sur une d\u00e9couverte in\u00e9dite de Bruxelles-Capitale. Elle p\u00e9tise l'espace urbain en mettant en r\u00e9sonance les contes et les lieux. Elle propose des prestations artistiques de qualit\u00e9, tout en convivialit\u00e9, pour mieux emmener le public dans l\u2019univers du conte.","description_print":"Conteurs en balade est un projet port\u00e9 depuis 2002 par l'asbl Mots et Merveilles, avec un succ\u00e8s toujours grandissant. En 2013, 2100 personnes ont assist\u00e9 \u00e0 27 Balades et \u00e0 14 Midis cont\u00e9s. La premi\u00e8re Nuit du Conte a rassembl\u00e9 360 noctambules.\r\n\r\nG\u00e9n\u00e9tiquement nomade, l'asbl Mots et Merveilles programme des conteurs professionnels ou \u00e9mergents d'horizons vari\u00e9s et am\u00e8ne le conte dans divers lieux inattendus, ouvrant sur une d\u00e9couverte in\u00e9dite de Bruxelles-Capitale. Elle p\u00e9tise l'espace urbain en mettant en r\u00e9sonance les contes et les lieux. Elle propose des prestations artistiques de qualit\u00e9, tout en convivialit\u00e9, pour mieux emmener le public dans l\u2019univers du conte.\r\n\r\nInnovante, l'asbl Mots et Merveilles organise depuis 2013 une Nuit du Conte : toute une nuit peupl\u00e9e de r\u00eaves \u00e9veill\u00e9s.\r\n\r\nD\u00e9sireuse d'aller toujours vers de nouveaux publics, l\u2019association met r\u00e9guli\u00e8rement en place des partenariats avec divers acteurs culturels bruxellois : la Maison des Cultures et de la Coh\u00e9sion sociale de Molenbeek, le Centre culturel Wolubilis, la Fonderie, le Caf\u00e9 de la Rue, les communes bruxelloises, \u2026.\r\n\r\nUn conseil d'administration pilote et g\u00e8re les activit\u00e9s de l'asbl (avec le soutien de plusieurs b\u00e9n\u00e9voles) et se fait conseiller, pour la programmation, par une \u00e9quipe artistique de 6 conteurs et 1 photographe.\r\nUne Balade cont\u00e9e c\u2019est ...\r\n\r\n    Une complicit\u00e9 certaine entre les conteurs et les espaces qui les accueillent : les histoires posent un regard diff\u00e9rent sur des lieux qui portent les histoires.\r\n    Un spectacle o\u00f9 la barri\u00e8re entre les artistes et le public est supprim\u00e9e : v\u00e9ritablement un art qui rassemble.\r\n    Une forme artistique \u00e9cologique, participative, conviviale, ancr\u00e9e dans la r\u00e9alit\u00e9 et ouvrant les portes de l\u2019imaginaire : tout ce dont notre monde a besoin aujourd\u2019hui.\r\n","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Conte en balade (VZW Mots et Merveilles)","address_street_name":"Ver Eyckenstraat","address_street_number":"1","address_street_box":null,"email":"info@conteenbalade.be","website":"https:\/\/www.conteenbalade.be\/","phone_contact":"+32 497 78 20 75","phone_booking":"+32 497 78 20 75","address_zip":"1160","address_city":"Oudergem","address_line1":"Ver Eyckenstraat, 1","address_line2":"1160 Oudergem","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Conte en balade (ASBL Mots et Merveilles)","address_street_name":"Rue Ver Eycken","address_street_number":"1","address_street_box":null,"email":"info@conteenbalade.be","website":"https:\/\/www.conteenbalade.be\/","phone_contact":"+32 497 78 20 75","phone_booking":"+32 497 78 20 75","address_zip":"1160","address_city":"Auderghem","address_line1":"Rue Ver Eycken, 1","address_line2":"1160 Auderghem","description_web":"","description_print":"","booking_u