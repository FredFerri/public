ull,null],"cn":[null,null,null,null,null,null,null]}},"tags":["kids"],"accessibilities":{"list":[255,257,258,263,265],"translations":{"fr":["Accessible","Am\u00e9nagements pour personnes sourdes et malentendantes","Appareils d'amplification du son","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9"],"nl":["Toegankelijk","Voorzieningen voor dove en slechthorende personen","Geluidsversterkende apparatuur","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet"],"en":["Accessible","Facilities for deaf and hearing-impaired people","Sound-amplifying equipment","Accessible to pedestrians with mobility aids","Adapted toilet"],"de":["Barrierefrei","Anpassungen f\u00fcr geh\u00f6rlose und h\u00f6rgesch\u00e4digte Menschen.","H\u00f6rverst\u00e4rker","Barrierefrei f\u00fcr Fu\u00dfg\u00e4nger mit Gehhilfe","Barrierefreies WC"],"it":["Accessibile","Disposizioni per persone non udenti e ipoudenti","Apparecchi acustici","Accessibile ai pedoni con supporti","WC idoneo"],"sp":["Habilitado","Equipos para personas sordas y con problemas de audici\u00f3n","Aparatos de amplificaci\u00f3n del sonido","Habilitado para peatones con aud\u00edfonos","Ba\u00f1os adaptados"],"pt":[null,null,null,null,null],"cn":[null,null,null,null,null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2023-02-18T05:06:59+01:00","published_at":"2023-02-02T15:19:06+01:00","backoffice_id":270854,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":1.2599210498949},{"id":552935,"date_start":"2023-03-23","date_end":"2023-03-23","date_next":"2023-03-23","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert","de":"Konzert","it":"Concerti","sp":"Concierto","pt":null,"cn":null}},"others":{"list":[2],"translations":{"fr":["Classique"],"nl":["Klassiek"],"en":["Classical"],"de":["Klassisch"],"it":["Classica"],"sp":["Cl\u00e1sica"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Mozart et Beethoven par Anthony Romaniuk et l'Ensemble Wolf aux Concerts de Midi.","shortdescr":"Les deux grands Quintettes pour vents et pianoforte de Mozart et de Beethoven seront interpr\u00e9t\u00e9s sur des instruments historiques par l'excellent pianiste Anthony Romaniuk et l'Ensemble Wolf (Beno\u00eet Laurent, hautbois, Jean-Philippe Poncin,  clarinette, Bart Cypers, cor  et Jean-Fran\u00e7ois Carlier, basson) qui r\u00e9unit la cr\u00e8me des vents \"anciens\" en Belgique.","longdescr":"Voici le programme d\u00e9taill\u00e9:\r\n(Le programme de ce concert se retrouve sur un splendide CD, internationalement reconnu (https:\/\/www.wolfensemble.be\/) ).\r\nWofgang Amadeus MOZART (1756-1791)\r\nQuintette K452 pour pianoforte et vents en mi b\u00e9mol majeur\r\nLargo, allegro moderato\r\nLarghetto\r\nRondo Allegretto\r\n\r\nLudwig van BEETHOVEN (1770-1827)\r\nQuintette Op. 16 pour pianoforte et vents\r\nGrave allegro ma non troppo\r\nAndante cantabile\r\nRondo allegro","performers":"Anthony Romaniuk, pianoforte & Ensemble Wolf (Beno\u00eet Laurent, hautbois, Jean-Philippe Poncin,  clarinette, Bart Cypers, cor  et Jean-Fran\u00e7ois Carlier, basson)","boxoffice_url":null,"website":"https:\/\/www.concertsdemidi.be\/","email":"info@concertsdemidi.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.552935"},"nl":{"name":"Mozart en Beethoven door Anthony Romaniuk en het Ensemble Wolf in de Middagconcerten.","shortdescr":"De twee beroemde kwintetten voor blazers en pianoforte van Mozart en Beethoven zullen uitgevoerd worden op historische instrumenten door de boeiende pianist Anthony Romaniuk en het  Wolf Ensemble (Beno\u00eet Laurent, hobo, Jean-Philippe Poncin,  klarinet, Bart Cypers, hoorn en Jean-Fran\u00e7ois Carlier, fagot) samengesteld uit de meest uitmuntende \"oude\" blazers in Belgi\u00eb.","longdescr":"Ziehier het gedetailleerd programma: \r\n(Dit programma is terug te vinden op een internationaal hoog geschatte CD (https:\/\/www.wolfensemble.be\/) ).\r\n\r\n\r\nWofgang Amadeus MOZART (1756-1791)\r\nQuintette K452 pour pianoforte et vents en mi b\u00e9mol majeur\r\nLargo, allegro moderato\r\nLarghetto\r\nRondo Allegretto\r\n\r\nLudwig van BEETHOVEN (1770-1827)\r\nQuintette Op. 16 pour pianoforte et vents\r\nGrave allegro ma non troppo\r\nAndante cantabile\r\nRondo allegro","performers":"Anthony Romaniuk, pianoforte & Wolf Ensemble (Beno\u00eet Laurent, hobo, Jean-Philippe Poncin,  klarinet, Bart Cypers, hoorn en Jean-Fran\u00e7ois Carlier, fagot)","boxoffice_url":null,"website":"https:\/\/www.concertsdemidi.be\/nl\/","email":"info@concertsdemidi.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.552935"},"en":{"name":"Mozart et Beethoven par Anthony Romaniuk et l'Ensemble Wolf aux Concerts de Midi.","shortdescr":null,"longdescr":null,"performers":"","boxoffice_url":null,"website":"https:\/\/www.concertsdemidi.be\/","email":"info@concertsdemidi.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.552935"},"de":{"name":"Mozart et Beethoven par Anthony Romaniuk et l'Ensemble Wolf aux Concerts de Midi.","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.concertsdemidi.be\/","email":"info@concertsdemidi.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.552935"},"it":{"name":"Mozart et Beethoven par Anthony Romaniuk et l'Ensemble Wolf aux Concerts de Midi.","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.concertsdemidi.be\/","email":"info@concertsdemidi.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.552935"},"sp":{"name":"Mozart et Beethoven par Anthony Romaniuk et l'Ensemble Wolf aux Concerts de Midi.","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.concertsdemidi.be\/","email":"info@concertsdemidi.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.552935"},"pt":{"name":"Mozart et Beethoven par Anthony Romaniuk et l'Ensemble Wolf aux Concerts de Midi.","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.concertsdemidi.be\/","email":"info@concertsdemidi.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.552935"},"cn":{"name":"Mozart et Beethoven par Anthony Romaniuk et l'Ensemble Wolf aux Concerts de Midi.","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.concertsdemidi.be\/","email":"info@concertsdemidi.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.552935"}},"place":{"id":100473,"translations":{"fr":{"name":"MIM - Mus\u00e9e des instruments de musique (MRAH)","address_street_name":"Rue Montagne de la Cour","address_street_number":"2","address_street_box":null,"email":"info@mim.be","website":"http:\/\/www.mim.be","phone_contact":"+32 2 545 01 30","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Montagne de la Cour, 2","address_line2":"1000 Bruxelles","description_web":"Le monde entier admire la collection du Mus\u00e9e des instruments de musique qui fait partie du groupement des Mus\u00e9es Royaux d\u2019Art et d\u2019Histoire. Ce Mus\u00e9e est camp\u00e9 au c\u0153ur des anciens b\u00e2timents Old England, un des plus beaux b\u00e2timents de style Art Nouveau de Bruxelles, datant de 1899. Ce mus\u00e9e est l\u2019un des plus riches au monde : quelques 1.200 instruments y sont expos\u00e9s. D\u2019int\u00e9ressantes animations et de nombreux concerts y sont programm\u00e9s.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"MIM - Muziekinstrumentenmuseum (KMKG)","address_street_name":"Hofberg","address_street_number":"2","address_street_box":null,"email":"info@mim.be","website":"http:\/\/www.mim.be","phone_contact":"+32 2 545 01 30","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Brussel","address_line1":"Hofberg, 2","address_line2":"1000 Brussel","description_web":"Het Muziekinstrumentenmuseum (MIM) bewaart een onschatbare collectie van muzikaal erfgoed en presenteert ze op een schitterende manier. Het MIM beschikt daarvoor over veel troeven. De intu\u00eftieve presentatie is aantrekkelijk en klantvriendelijk. De collectie huist bovendien in een schitterend gerestaureerd art-nouveaupand. Het MIM presenteert een honderdtal middagconcerten per jaar en biedt een waaier aan groepsactiviteiten.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"MIM - Musical Instruments Museum (MRAH)","address_street_name":"Rue Montagne de la Cour","address_street_number":"2","address_street_box":null,"email":"info@mim.be","website":"http:\/\/www.mim.be","phone_contact":"+32 2 545 01 30","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Brussels","address_line1":"Rue Montagne de la Cour, 2","address_line2":"1000 Brussels","description_web":"As soon as it opened at the end of the 19th century, the luxurious Old England department store earned an excellent reputation for its highly distinctive building. The entrance to the building is a jewel of the Art Nouveau style, while the rest is in perfect harmony with the neoclassical ensemble on the Place Royale, and just around the corner from the Grand-Place and Central Station, no less! \r\nWith a wealth of some 9.000 instruments, some 1.200 of which are on permanent exhibit, the museum's reputation is mainly built on its extraordinary collections.\r\nOnce inside, you'll embark on a true tour of the musical world. After your visit, the instruments and their history will no longer hold any secrets: from the viola da gamba from the Court of Brussels to the 20th century theremin, and even including the African kora!\r\nThe mim is nothing other than a place to experience music. A visitor's guidance system allows you to explore the thematic tours to the tune of the melodious sound of the instruments presented.\r\nA program packed with concerts, demonstrations and workshops for the young and the not so young makes the mim experience even better.\r\nThe mim has its own concert hall, specialized library, museum shop, workshop for restauration and conservation of musical instruments and is crowned by a restaurant with panoramic view over Brussels.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"MIM - Musikinstrumente-Museum (MRAH)","address_street_name":"Montagne de la Cour","address_street_number":"2","address_street_box":null,"email":"info@mim.be","website":"http:\/\/www.mim.be","phone_contact":"+32 2 545 01 30","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Montagne de la Cour, 2","address_line2":"1000 Bruxelles","description_web":"Das Br\u00fcsseler Musikinstrumente-Museum mit 1200 ausgestellten Musikinstrumenten und vielf\u00e4ltigen Sammlungen (mit insgesamt 8000 Instrumenten!), untergebracht in einem bemerkenswerten Jugendstilgeb\u00e4ude, ist ein Paradies f\u00fcr Musikinteressierte.\r\n\r\nMusikgeschichte und Jugendstilarchitektur: Das Musikinstrumente-Museum befindet sich in den ehemaligen Geb\u00e4uden des \u201eOld England\u201c-Kaufhauses und gilt als eines der herausragenden Beispiele f\u00fcr die Br\u00fcsseler Jugendstilarchitektur.\r\n\r\nMusikalische Welt- und Zeitreise: Auf vier Ebenen pr\u00e4sentiert das Museum Musikinstrumente aus verschiedenen Kulturkreisen und Epochen \u2013 und so begibt sich der Besucher auf eine musikalische Welt- und Zeitreise. Die Ausstellungsgestaltung verkn\u00fcpft gekonnt klangliche und visuelle Dimensionen.\r\n\r\nKulinarischer H\u00f6hepunkt, im wahrsten Sinne des Wortes, ist das Restaurant im 6. Stock mit Dachterrasse.\r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Museo degli Strumenti Musicali","address_street_name":"Rue Montagne de la Cour","address_street_number":"2","address_street_box":null,"email":"info@mim.be","website":"http:\/\/www.mim.be","phone_contact":"+32 2 545 01 30","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Montagne de la Cour, 2","address_line2":"1000 Bruxelles","description_web":"Il MIM presenta una collezione di strumenti musicali di fama internazionale e une larga gamma di attivit\u00e0 in collegamento con questa collezione a un pubblico largo e...\r\n\r\nIl MIM presenta una collezione di strumenti musicali di fama internazionale e une larga gamma di attivit\u00e0 in collegamento con questa collezione a un pubblico largo e diversificato dal Belgio e dall'estero. Presenta un'ampio panorama della musica antica, moderna, popolare e tradizionale.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"El MIM, Museo de Instrumentos de M\u00fasica","address_street_name":"Rue Montagne de la Cour","address_street_number":"2","address_street_box":null,"email":"info@mim.be","website":"http:\/\/www.mim.be","phone_contact":"+32 2 545 01 30","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Montagne de la Cour, 2","address_line2":"1000 Bruxelles","description_web":"El Museo MIM te invita a contemplar y escuchar 1.200 instrumentos de m\u00fasica en un edificio Art Nouveau de Bruselas. \r\n\r\nEl Museo de Instrumentos de M\u00fasica, que forma parte de los Museos Reales de Arte e Historia, abre sus puertas en las proximidades de la Place Royale, en el Mont des Arts, el barrio de los museos de Bruselas. \r\n\r\nEl MIM se encuentra en los antiguos almacenes de Art Nouveau, Old England, un aut\u00e9ntico tesoro arquitect\u00f3nico de finales del s. XIX.\r\n\r\nEl MIM debe su reputaci\u00f3n, sobre todo, a sus extraordinarias colecciones. Ven a dar la vuelta al mundo musical a trav\u00e9s de sus 1.200 piezas distribuidas por las 4 plantas de la exposici\u00f3n.\r\n\r\n\r\nComo es de suponer, el MIM es el lugar ideal para disfrutar de la m\u00fasica. Un sistema de cascos con infrarrojos permite explorar los recorridos tem\u00e1ticos al tiempo que se escucha el sonido melodioso de los instrumentos que se presentan.\r\n   \r\nEl MIM tambi\u00e9n es\u2026\r\n\r\n- Una sala de conciertos\r\n- Un espacio para talleres\r\n- Un Museumshop\r\n- Una biblioteca especializada\r\n- Y un restaurante con terraza, con unas vistas \u00fanicas al centro hist\u00f3rico de la capital europea\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"MIM - Museu dos Instrumentos Musicais","address_street_name":"Rue Montagne de la Cour","address_street_number":"2","address_street_box":null,"email":"info@mim.be","website":"http:\/\/www.mim.be","phone_contact":"+32 2 545 01 30","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Montagne de la Cour, 2","address_line2":"1000 Bruxelles","description_web":"Todo o mundo admira a cole\u00e7\u00e3o do Museu dos Instrumentos Musicais, que pertence ao conjunto dos Museus Reais de Arte e da Hist\u00f3ria. Este museu assenta no cora\u00e7\u00e3o dos velhos edif\u00edcios Old England, um dos edif\u00edcios mais belos de estilo Art Nouveau de Bruxelas, datando de 1899. Este museu \u00e9 um dos mais ricos do mundo: cerca de 1200 instrumentos encontram-se a\u00ed expostos. Consta da programa\u00e7\u00e3o de interessantes anima\u00e7\u00f5es e in\u00fameros concertos.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"MIM - Mus\u00e9e des instruments de musique (MRAH)","address_street_name":"Rue Montagne de la Cour","address_street_number":"2","address_street_box":null,"email":"info@mim.be","website":"http:\/\/www.mim.be","phone_contact":"+32 2 545 01 30","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Montagne de la Cour, 2","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[16],"translations":{"fr":["Quartier Royal"],"nl":["Koninklijke wijk"],"en":["Royal"],"de":["K\u00f6nigliches Viertel"],"it":["Quartiere reale"],"sp":["Quartier Royal \u2014Barrio de la Corte\u2014"],"pt":[null],"cn":[null]}},"zones":{"list":[19],"translations":{"fr":["Centre"],"nl":["Centrum"],"en":["Centre"],"de":["Zentrum"],"it":["Centro"],"sp":["Centro"],"pt":[null],"cn":[null]}},"neca":null,"facebook_id":null,"backoffice_id":359,"location":{"lat":50.84274286,"lon":4.35903823},"region":"brussels","last_updated_at":"2023-03-06T12:05:07+01:00","published_at":"2013-10-19T01:13:28+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":279466,"translations":{"fr":{"name":"Concerts de Midi asbl","address_street_name":"Rue Lebeau","address_street_number":"39","address_street_box":null,"email":"info@concertsdemidi.be","website":"https:\/\/www.concertsdemidi.be\/nl\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Lebeau, 39