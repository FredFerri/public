"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-03-02T17:35:08+01:00","published_at":"2023-03-02T17:08:06+01:00","backoffice_id":272818,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":1.2599210498949},{"id":552988,"date_start":"2023-03-09","date_end":"2023-03-09","date_next":"2023-03-09","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung","it":"Esposizioni","sp":"Exhibici\u00f3n","pt":null,"cn":null}},"others":{"list":[24,27],"translations":{"fr":["Galeries d'art","Photographie"],"nl":["Galeries","Fotografie"],"en":["Art Galleries","Photography"],"de":["Kunstgalerien","Fotografie"],"it":["Gallerie d'arte","Fotografia"],"sp":["Galer\u00edas de arte","Fotograf\u00eda"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","en"],"subtitles":[]},"translations":{"fr":{"name":"Vernissage de l'exposition \"1979-2023, l'Iran en r\u00e9volutions\"","shortdescr":"Face \u00e0 la trag\u00e9die qui se d\u00e9roule actuellement en Iran o\u00f9 le r\u00e9gime des Mollahs r\u00e9prime cruellement l\u2019aspiration du peuple \u00e0 la libert\u00e9, G\u00e9opolis pr\u00e9pare, de mars \u00e0 mai prochain, un cycle d\u2019expositions et une s\u00e9rie d\u2019activit\u00e9s (rencontres, plateaux radio) d\u00e9di\u00e9s \u00e0 la situation dans ce pays.","longdescr":"Cette exposition sera organis\u00e9e en deux parties, l\u2019une d\u00e9di\u00e9e \u00e0 l\u2019histoire du pays depuis la r\u00e9volution de 1979 et la seconde d\u00e9di\u00e9e \u00e0 la r\u00e9volte en cours.\r\nPremi\u00e8re partie de l\u2019exposition - R\u00e9trospective sur l\u2019histoire de l\u2019Iran.\r\nG\u00e9opolis a sollicit\u00e9 de tr\u00e8s grands photographes pour s\u2019associer \u00e0 ce projet (Reza, Alain Keler, Marie Tihon, Michel Setboun).\r\nL\u2019exposition sera \u00e9galement pr\u00e9sent\u00e9e sur les vitres d\u2019un des b\u00e2timents de l\u2019IHECS et autour de l\u2019Ascenseur o\u00f9 seront organis\u00e9s plusieurs plateaux radio d\u00e9di\u00e9s \u00e0 la situation en Iran.\r\nCes photographes proposeront une plong\u00e9e dans l\u2019histoire tumultueuse de l\u2019Iran depuis 1979.\r\nSeconde partie de l\u2019exposition - Femmes, vie, libert\u00e9.\r\nLa seconde partie de l\u2019exposition sera d\u00e9di\u00e9e \u00e0 la r\u00e9volte en cours suite \u00e0 la mort de Mahsa Amini et la mobilisation qui se d\u00e9roule actuellement en Iran.","performers":"Marie Tihon (photographe)\r\nAlain Keler (photographe)\r\nReza (photographe)\r\nMichel Setboun (photographe)","boxoffice_url":null,"website":"http:\/\/geopolis.brussels","email":"contact@geopolis.brussels","phone_contact":"+32 485 32 85 90","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.552988"},"nl":{"name":"Opening van de tentoonstelling \"1979-2023, Iran in revoluties\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/geopolis.brussels","email":"contact@geopolis.brussels","phone_contact":"+32 472 61 83 76","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.552988"},"en":{"name":"Opening of the exhibition \"1979-2023, Iran in revolutions\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/geopolis.brussels","email":"contact@geopolis.brussels","phone_contact":"+32 485 32 85 90","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.552988"},"de":{"name":"Cycle d'exposition \"1979-2023, l'Iran en r\u00e9volutions\"","shortdescr":null,"longdescr":n