ate_next":"2024-01-27","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-01-11T17:30:01+01:00","published_at":"2024-01-09T10:15:50+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":292193,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.35163388691695935,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[30,24],"translations":{"de":["Malerei","Kunstgalerien"],"pt":[null,null],"en":["Painting","Art Galleries"],"it":["Pittura","Gallerie d'arte"],"cn":[null,null],"fr":["Peinture","Galeries d'art"],"sp":["Pintura","Galer\u00edas de arte"],"nl":["Schilderkunst","Galeries"]}}},"translations":{"de":{"name":"7e mouvement","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.melissaansel.com","email":"info@melissaansel.com","phone_contact":"+32 478 95 95 77","phone_booking":"+32 478 95 95 77","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50005905"},"pt":{"name":"7e mouvement","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.melissaansel.com","email":"info@melissaansel.com","phone_contact":"+32 478 95 95 77","phone_booking":"+32 478 95 95 77","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50005905"},"en":{"name":"7e mouvement","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.melissaansel.com","email":"info@melissaansel.com","phone_contact":"+32 478 95 95 77","phone_booking":"+32 478 95 95 77","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50005905"},"it":{"name":"7e mouvement","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.melissaansel.com","email":"info@melissaansel.com","phone_contact":"+32 478 95 95 77","phone_booking":"+32 478 95 95 77","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50005905"},"cn":{"name":"7e mouvement","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.melissaansel.com","email":"info@melissaansel.com","phone_contact":"+32 478 95 95 77","phone_booking":"+32 478 95 95 77","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50005905"},"fr":{"name":"7e mouvement","shortdescr":"L\u2019espace culturel, melissa ansel, accueillera \u00e0 Forest,\nsa dix-neuvi\u00e8me exposition...\n\nEt si nous envisagions les diff\u00e9rents protagonistes en lice tels des personnages du Tarot, ce merveilleux livre d\u2019images qui agit comme un miroir de l\u2019\u00e2me.","longdescr":"Et si nous envisagions les diff\u00e9rents protagonistes en lice tels des personnages du Tarot, ce merveilleux livre d\u2019images qui agit comme un miroir de l\u2019\u00e2me. La premi\u00e8re carte repr\u00e9senterait Melissa Ansel, ma\u00eetresse des lieux et instigatrice, personnifi\u00e9e par Le Bateleur, premier arcane majeur. La myst\u00e9rieuse autrichienne est sans doute plus exp\u00e9riment\u00e9e que ce magicien juv\u00e9nile mais, lors de chaque projet qu\u2019elle initie, elle relance \u00e9nergiquement les d\u00e9s et red\u00e9finit une nouvelle r\u00e9alit\u00e9. Qui est-elle r\u00e9ellement ? Nul ne le sait car dans les circonvolutions de son chapeau en forme de lemniscate, c\u2019est l\u2019infini qui joue \u00e0 cache-cache. \n\nLa deuxi\u00e8me carte serait Le Chariot, l\u2019arcane VII, alias Cl\u00e9ment Jacques-Vossen, fringant chevalier f\u00e9ru de folklore, d\u2019histoire(s) et d\u2019h\u00e9raldique dont les peintures foisonnantes proc\u00e8dent du m\u00e9lange des genres, du mixage d\u2019influences h\u00e9t\u00e9roclites, g\u00e9n\u00e9rant de nouvelles narrations f\u00e9condes et drolatiques. Ses r\u00e9cits pittoresques s\u2019activent et se compl\u00e8tent lors d\u2019installations et de performances, prenant corps dans les trois dimensions et la magie de l\u2019instant. \n\nEnfin, la troisi\u00e8me lame de ce tirage serait Le Mat, l\u2019arcane sans nombre, aka Philippe Koeune. Peut-\u00eatre l\u2019avez-vous crois\u00e9 sur l\u2019un des divers chemins qu\u2019il a emprunt\u00e9s, alors qu\u2019il \u00e9tait architecte, musicien, styliste ou graphiste. Peut-\u00eatre avez-vous eu la chance de voir ses dessins vibrants ou de plonger dans les m\u00e9andres de votre inconscient gr\u00e2ce aux cours de Tarot qu\u2019il prodigue et \u00e0 ses s\u00e9ances de r\u00eaves \u00e9veill\u00e9s libres. Est-il un sage ou un fou qui s\u2019\u00e9gare ? C\u2019est un \u00e9lectron libre, guid\u00e9 par ses instincts et ses d\u00e9sirs. Son nouveau corpus dessin\u00e9 exprime lui aussi une profonde libert\u00e9 avec de grands arbres gorg\u00e9s de s\u00e8ve et d\u2019\u00e2me qui, affranchis de la lin\u00e9arit\u00e9 du trait, s\u2019animent dans une intense mati\u00e8re color\u00e9e. \n\nDe la rencontre de ces deux imagiers du temps pr\u00e9sent na\u00eet le \n7e mouvement, cort\u00e8ge haut en couleurs et tonique compos\u00e9 de figures folkloriques et d\u2019arbres fantasmagoriques. Deux univers distinctifs partageant entre eux, comme avec le Tarot, une expressivit\u00e9 directe et intuitive \u00e9manant de la force du langage symbolique. \n\nSandra Caltagirone","performers":"Cl\u00e9ment Jacques-Vossen \/ artiste peintre\nPhilippe Koeune \/  artiste peintre\n\nVal\u00e9rie Lenders \/ Organisation","boxoffice_url":null,"website":"http:\/\/www.melissaansel.com","email":"info@melissaansel.com","phone_contact":"+32 478 95 95 77","phone_booking":"+32 478 95 95 77","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50005905"},"sp":{"name":"7e mouvement","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.melissaansel.com","email":"info@melissaansel.com","phone_contact":"+32 478 95 95 77","phone_booking":"+32 478 95 95 77","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50005905"},"nl":{"name":"7e mouvement","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.melissaansel.com","email":"info@melissaansel.com","phone_contact":"+32 478 95 95 77","phone_booking":"+32 478 95 95 77","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50005905"}},"place":{"id":275361,"translations":{"de":{"name":"Melissa Ansel Bxl","address_street_name":"Rue des Glands","address_street_number":"74","address_street_box":"1190","email":"info@melissaansel.com","website":"https:\/\/www.melissaansel.com\/","phone_contact":"+32 2 344 65 62","phone_booking":"+32 478 95 95 77","address_zip":"1190","address_city":"Forest","address_line1":"Rue des Glands, 74 \/ 1190","address_line2":"1190 Forest","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Melissa Ansel Bxl","address_street_name":"Rue des Glands","address_street_number":"74","address_street_box":"1190","email":"info@melissaansel.com","website":"https:\/\/www.melissaansel.com\/","phone_contact":"+32 2 344 65 62","phone_booking":"+32 478 95 95 77","address_zip":"1190","address_city":"Forest","address_line1":"Rue des Glands, 74 \/ 1190","address_line2":"1190 Forest","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Meli