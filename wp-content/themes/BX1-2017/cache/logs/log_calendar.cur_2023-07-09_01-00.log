ranslations":{"fr":["LGTBQIA"],"nl":["LGTBQIA"],"en":["LGTBQIA"],"de":["LGTBQIA"],"it":["LGTBQIA"],"sp":["LGTBQIA"],"pt":[null],"cn":[null]}},"tags":[],"accessibilities":{"list":[255,259,263,265],"translations":{"fr":["Accessible","Chien d'assistance","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9"],"nl":["Toegankelijk","Assistentiehonden","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet"],"en":["Accessible","Assistance dogs","Accessible to pedestrians with mobility aids","Adapted toilet"],"de":["Barrierefrei","Assistenzhund","Barrierefrei f\u00fcr Fu\u00dfg\u00e4nger mit Gehhilfe","Barrierefreies WC"],"it":["Accessibile","Cane guida","Accessibile ai pedoni con supporti","WC idoneo"],"sp":["Habilitado","Perros gu\u00eda","Habilitado para peatones con aud\u00edfonos","Ba\u00f1os adaptados"],"pt":[null,null,null,null],"cn":[null,null,null,null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2023-07-05T04:35:03+02:00","published_at":"2022-10-20T13:28:44+02:00","backoffice_id":264430,"import_origin":null,"sub_type":"misc","show_in_agenda":true,"ranking":0.13652195010937},{"id":560535,"date_start":"2023-07-02","date_end":"2023-08-06","date_next":"2023-08-06","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen","it":"Visite guidate","sp":"Visitas guiadas","pt":null,"cn":null}},"others":{}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Visites guid\u00e9es du toit","shortdescr":"Cet \u00e9t\u00e9, le BELvue ouvre \u00e0 nouveau exceptionnellement son toit au public. Venez admirer une des plus belles vues de Bruxelles depuis le toit du mus\u00e9e BELvue.","longdescr":"Cet \u00e9t\u00e9, le BELvue ouvre \u00e0 nouveau exceptionnellement son toit au public. Venez admirer une des plus belles vues de Bruxelles depuis le toit du mus\u00e9e BELvue. Au fil de la visite, les guides vous emm\u00e8neront dans un voyage historique, architectural et contemporain. Le BELvue, les magnifiques b\u00e2timents qui l\u2019entourent, le Parc royal et leurs petites et grandes histoires n\u2019auront plus aucun secret pour vous.\r\n\r\nLes visites se font en petits groupes de 6 personnes maximum. Pour des raisons de s\u00e9curit\u00e9, les enfants sont admis\u00b7es seulement \u00e0 partir de 13 ans.\r\n\r\nInfos pratiques\u202f:\r\n\r\nLes 2\/07 et 6\/08\r\nNL : 14h00 - 15h00\r\nFR : 15h - 16h\r\nEN : 16 h - 17 h\r\nPrix\u202f: 5\u20ac pp (prix unique)\r\nPublic\u202f: adultes et jeunes \u00e0 partir de 13 ans\r\n\r\nTickets\u202f: \u00e0 acheter \u00e0 l\u2019avance obligatoirement. Ce ticket vous donne aussi acc\u00e8s \u00e0 la visite libre (sans guide) du mus\u00e9e BELvue le m\u00eame jour.\r\n\r\nImportant\u202f: pour les visites du toit, afin de profiter au mieux de cette balade in\u00e9dite et pour ne pas endommager les surfaces, nous vous demandons de porter des chaussures plates et confortables avec des semelles en caoutchouc (pas de talons) et de porter une tenue qui vous permette d\u2019enjamber facilement quelques obstacles. Pour pouvoir rejoindre le toit, vous devrez monter des escaliers et \u00eatre bien stable sur vos jambes.\u202fLes visites sont vraiment exclusives car se font en petits groupes de max. 6 personnes \u00e0 la fois, et nous n\u2019ouvrons pas le toit au public en d\u2019autres temps.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.belvue.be","email":"info@belvue.be","phone_contact":null,"phone_booking":"+32 2 500 45 54","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.560535"},"nl":{"name":"Rondleidingen op het dak","shortdescr":"Deze zomer heropent het BELvue bij wijze van uitzondering zijn dak voor het publiek. Kom een van de mooiste uitzichten van Brussel bewonderen vanaf het dak van het BELvue museum.","longdescr":"Deze zomer heropent het BELvue bij wijze van uitzondering zijn dak voor het publiek. Kom een van de mooiste uitzichten van Brussel bewonderen vanaf het dak van het BELvue museum. Tijdens het bezoek nemen de gidsen u mee op een historische, architecturale en hedendaagse reis. Bezoek het BELvue, de prachtige gebouwen die deze omringen, het Warande park en hun kleine et en grote verhalen zullen voor u geen geheimen meer hebben.\r\n\r\nDe bezoeken worden in kleine groepen van maximaal 6 personen georganiseerd. Om veiligheidsredenen worden kinderen pas toegelaten vanaf 13 jaar.\r\n\r\nPraktische info:\r\n\r\nOp 2\/07 en 6\/08\r\nNL : 14u-15u\r\nFR\u202f: 15u \u2013 16u\r\nEN\u202f: 16u -17u\r\nPrijs: \u20ac5 pp (unieke prijs)\r\nDoelgroep: volwassenen en jongeren vanaf 13 jaar\r\nTickets: verplicht ticket op voorhand kopen. Dit ticket geeft u ook toegang tot een vrij bezoek aan het BELvue museum (zonder gids) op dezelfde dag.\r\n\r\nBelangrijk: Om optimaal van deze unieke wandeling te kunnen genieten en om beschadiging van het dak te voorkomen, vragen wij u platte, comfortabele schoenen (zoals sneakers) met rubberen zolen (geen hakken) te dragen, en kleren waarmee u gemakkelijk over sommige hindernissen kunt stappen. Om op het dak te geraken, moet u een paar trappen op en stevig op uw voeten staan. De bezoeken zijn echt exclusief, omdat ze in kleine groepen van maximaal 6 personen per bezoek plaatsvinden, en we het dak op andere tijden niet openstellen voor publiek.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.belvue.be","email":"info@belvue.be","phone_contact":null,"phone_booking":"+32 2 500 45 54","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.560535"},"en":{"name":"Rooftop tours","shortdescr":"This summer, the BELvue is once again exceptionally opening its roof to the public. Come and admire one of the most beautiful views of Brussels from the roof of the BELvue museum.","longdescr":"This summer, the BELvue is once again exceptionally opening its roof to the public. Come and admire one of the most beautiful views of Brussels from the roof of the BELvue museum. During the tour, the guides will take you on a journey through history, architecture and the present day. The BELvue, the magnificent buildings that surround it, the Royal Park and all their little and big stories will no longer hold any secrets for you. \r\nTours are given in small groups of no more than 6 people. For safety reasons, children are only admitted from the age of 13.\r\n\r\nPractical info:\r\n\r\n2\/07 and 6\/08\r\nNL: 2pm - 3pm\r\nFR : 15h - 16h\r\nEN : 16 h - 17 h\r\nPrice: \u20ac5 pp (one-off price)\r\nPublic: adults and young people aged 13 and over\r\n\r\nTickets: must be purchased in advance. This ticket also gives you access to the self-guided tour of the BELvue museum on the same day.\r\n\r\nImportant: for visits to the roof, in order to get the most out of this unique walk and to avoid damaging the surfaces, we ask you to wear flat, comfortable shoes with rubber soles (no heels) and to wear clothing that allows you to step over obstacles easily. To reach the roof, you'll need to climb some stairs and stand steady on your feet.\u202fVisits are truly exclusive, as they are made in small groups of no more than 6 people at a time, and we don't open the roof to the public at other times.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.belvue.be","email":"info@belvue.be","phone_contact":null,"phone_booking":"+32 2 500 45 54","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.560535"},"de":{"name":"Visites guid\u00e9es du toit","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.belvue.be","email":"info@belvue.be","phone_contact":null,"phone_booking":"+32 2 500 45 54","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.560535"},"it":{"name":"Visites guid\u00e9es du toit","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.belvue.be","email":"info@belvue.be","phone_contact":null,"phone_booking":"+32 2 500 45 54","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.560535"},"sp":{"name":"Visites guid\u00e9es du toit","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.belvue.be","email":"info@belvue.be","phone_contact":null,"phone_booking":"+32 2 500 45 54","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.560535"},"pt":{"name":"Visites guid\u00e9es du toit","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.belvue.be","email":"info@belvue.be","phone_contact":null,"phone_booking":"+32 2 500 45 54","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.560535"},"cn":{"name":"Visites guid\u00e9es du toit","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.belvue.be","email":"info@belvue.be","phone_contact":null,"phone_booking":"+32 2 500 45 54","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.560535"}},"place":{"id":233379,"translations":{"fr":{"name":"mus\u00e9e BELvue","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@belvue.be","website":"http:\/\/www.belvue.be","phone_contact":"+32 2 545 08 00","phone_booking":"+32 2 500 45 54","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"Se pr\u00e9sentant comme le mus\u00e9e de la Belgique et de son histoire, mais \u00e9galement comme \u00ab centre pour la d\u00e9mocratie \u00bb, l\u2019\u00e9tablissement b\u00e9n\u00e9ficie d\u2019une mus\u00e9ographie compl\u00e8tement remani\u00e9e depuis peu. D\u00e9mocratie, prosp\u00e9rit\u00e9, solidarit\u00e9, pluralisme, migrations, langues, Europe : le mus\u00e9e BELvue vous propose de d\u00e9couvrir le pays \u00e0 travers ces quelques th\u00e9matiques. L\u2019approche se veut originale, puisque chaque th\u00e9matique est d\u2019abord explicit\u00e9e \u00e0 l\u2019aide de t\u00e9moignages actuels, et ensuite contextualis\u00e9e \u00e0 travers l\u2019histoire. Plus de 200 objets composent une galerie et permettent d\u2019incarner la m\u00e9moire mat\u00e9rielle du pays. Vous y croiserez par exemple une lithographie de Magritte, des vases en cristal du Val Saint-Lambert, un costume du carnaval de Binche, ou encore un ballon sign\u00e9 par les Diables Rouges !\r\n\r\nCe b\u00e2timent, affect\u00e9 initialement \u00e0 l\u2019usage d\u2019un h\u00f4tel, est b\u00e2ti en 1776 \u2014 et ouvert dans le courant de l\u2019ann\u00e9e suivante \u2014 dans un p\u00f4le \u00e0 vocation touristique, commercial (difficile \u00e0 s\u2019imaginer aujourd\u2019hui !), et tr\u00e8s cosmopolite (l\u2019h\u00f4tel Astoria, rue Royale, en demeure le seul t\u00e9moin actuel). L\u2019\u00e9tablissement recevait essentiellement des touristes, en majorit\u00e9 anglais, mais pas n\u2019importe quels touristes : il s\u2019agit d\u2019une h\u00f4tellerie de luxe, avec des clients prestigieux.\r\n\r\nDe style n\u00e9oclassique, comme l\u2019ensemble de la place Royale, le b\u00e2timent privil\u00e9gie la sobri\u00e9t\u00e9 et les proportions harmonieuses. La visite int\u00e9rieure vous offrira davantage de d\u00e9tails sur le d\u00e9cor.\r\n\r\nLe Parc de Bruxelles constituait un p\u00f4le d\u2019attraction pour les touristes : la promenade mondaine est en effet une occupation de choix. \u00ab De midi \u00e0 une heure, cette promenade devient ordinairement le rendez-vous des \u00e9trangers et des gens riches. Cette mac\u00e9doine de nations qu\u2019on y rencontre \u00e9gaie quelques heures par jour cet endroit. \u00bb\r\nSi globalement, les relations du Bellevue avec son illustre voisin \u2014 le palais royal \u2014 restent bonnes, l\u2019h\u00f4tel h\u00e9bergeant m\u00eame souvent des invit\u00e9s de marque susceptibles d\u2019une entrevue royale, quelques frictions ont pu appara\u00eetre, notamment \u00e0 cause de la construction de terrasses adjacentes \u00e0 l\u2019\u00e9tablissement, et donnant une vue magnifique sur les jardins du roi, ce qui n\u2019\u00e9tait pas tr\u00e8s au go\u00fbt de L\u00e9opold II\u2026\r\n\r\nHoraire exceptionnel les jours de vacances scolaires et le jours f\u00e9ri\u00e9s 9h30 \u00e0 17h\r\nLe 24\/12 et le 31\/12 9h30 \u00e0 16:00\r\nL'entr\u00e9e au mus\u00e9e BELvue est gratuite tous les mercredis \u00e0 partir de 14 heures et le 1er dimanche du mois","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"BELvue museum","address_street_name":"Paleizenplein","address_street_number":"7","address_street_box":null,"email":"info@belvue.be","website":"http:\/\/www.belvue.be","phone_contact":"+32 2 545 08 00","phone_booking":"+32 2 500 45 54","address_zip":"1000","address_city":"Brussel","address_line1":"Paleizenplein, 7","address_line2":"1000 Brussel","description_web":"Frieten, bier, chocolade\u2026 maar Belgi\u00eb is toch wel meer dan dat, nietwaar? Democratie, welvaart, solidariteit, pluralisme, migratie, taal, Europa: dat zijn de thema\u2019s die het BELvue museum jullie voorstelt om kennis te maken met het land! Elk thema wordt uitgewerkt aan de hand van hedendaagse getuigenissen en vervolgens toegelicht doorheen de geschiedenis. Een eigentijdse en originele manier om een beter inzicht te verwerven in het Belgi\u00eb van vandaag.\r\nNeem zeker ook een kijkje in de galerij: daar staan meer dan 200 voorwerpen opgesteld die het materi\u00eble geheugen van Belgi\u00eb vormen. Je kunt er onder andere de volgende zaken bewonderen: een lithografie van Magritte, een motorfiets, kristallen vazen van Val Saint-Lambert, en een bal met de handtekeningen van de Rode Duivels erop. Een verzameling met een hoog Belgi\u00ebgehalte!\r\n\r\nElke woensdag vanaf 14.00 uur is het BELvue museum gratis toegankelijk.\r\nMaandag open voor groepen en scholen op reservering van 09:30 tot 17:00\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"BELvue museum","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@belvue.be","website":"http:\/\/www.belvue.be","phone_contact":"+32 2 545 08 00","phone_booking":"+32 2 500 45 54","address_zip":"1000","address_city":"Brussels","address_line1":"Place des Palais, 7","address_line2":"1000 Brussels","description_web":"Chips, beer and chocolates... surely there is more to Belgium than that? Democracy, prosperity, solidarity, pluralism, migration, languages and Europe: these are the themes used by the BELvue Museum to help you to discover Belgium. Each one is developed through present-day testimonials and then traced right through history. This is a modern, original way of gaining a fuller understanding of modern-day Belgium.\r\nHave a look at the gallery too: there are more than 200 objects to view, each one forming a tangible memory of Belgium. Here are just a few examples: a lithograph by Magritte, a motorcycle, crystal vases by Val Saint-Lambert, and a football signed by the Red Devils. The very essence of Belgian-ness!\r\n\r\nSpeciale openingstijden op schoolvakanties en feestdagen 9.30 tot 17.00 uur\r\n24\/12 en 31\/12 9u30 tot 16u00\r\nHet BELvue Museum is elke woensdag vanaf 14u en de eerste zondag van de maand gratis toegankelijk.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Museum BELvue","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@belvue.be","website":"http:\/\/www.belvue.be","phone_contact":"+32 2 545 08 00","phone_booking":"+32 2 500 45 54","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"Belgische Fritten, Bier, Schokolade...Belgien ist mehr als nur das, oder? Demokratie, Wohlstand, Solidarit\u00e4t, Vielfalt, Migration, Sprachen, Europa: Dies sind die Themen, die das BELvue Museum Ihnen auf Ihrem Rundgang durch die Ausstellungsr\u00e4ume n\u00e4herbringt! Jedes Thema wird anhand von aktuellen Kommentaren und Berichten geschildert und dann in seinen geschichtlichen Kontext gebracht. Eine moderne und originelle Herangehensweise, die den Besuchern einen faszinierenden Einblick in das Belgien der Gegenwart gew\u00e4hrt.\r\n\r\nAbsolut sehenswert ist auch die Galerie: Mehr als 200 Ausstellungsst\u00fccke verk\u00f6rpern gewisserma\u00dfen das materielle Ged\u00e4chtnis Belgiens. Zu bewundern gibt es unter anderem eine Lithographie von Magritte, Kristallvasen aus der Kristallmanufaktur Val Saint-Lambert und sogar einen von den Roten Teufeln signierten Fu\u00dfball. Eine geballte Ladung belgischer Lebensart!\r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Museo BELvue","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@belvue.be","website":"http:\/\/www.belvue.be","phone_contact":"+32 2 545 08 00","phone_booking":"+32 2 500 45 54","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"Nel Museo BELvue, grazie a numerosi documenti, i visitatori potranno scoprire i grandi periodi della storia del Belgio.\u00a0...\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Museo BELvue","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@belvue.be","website":"http:\/\/www.belvue.be","phone_contact":"+32 2 545 08 00","phone_booking":"+32 2 500 45 54","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"Conocido como el museo de B\u00e9lgica y su historia, pero tambi\u00e9n como \"centro para la democracia\", el establecimiento posee una museograf\u00eda completamente redise\u00f1ada desde hace poco. Democracia, prosperidad, solidaridad, pluralismo, migraciones, idiomas, Europa: El museo BELvue te propone descubrir el pa\u00eds a trav\u00e9s de diferentes tem\u00e1ticas. El enfoque es original, ya que cada tem\u00e1tica se explica en primer lugar con la ayuda de testimonios actuales y a continuaci\u00f3n es contextualizada a trav\u00e9s de la historia. M\u00e1s de 200 objetos componen una galer\u00eda para encarnar la memoria material del pa\u00eds. Encontrar\u00e1s, por ejemplo, una litograf\u00eda de Magritte, los vasos de cristal de Val Saint-Lambert, un disfraz del carnaval de Binche, \u00a1Y un bal\u00f3n firmado por los Diablos Rojos!\r\nEste edificio, originalmente utilizado como hotel, se construy\u00f3 en 1776 \u2014 y fue abierto durante el transcurso del a\u00f1o siguiente \u2014 como un centro de car\u00e1cter tur\u00edstico, comercial y muy cosmopolita. El establecimiento recibe esencialmente turistas, en su mayor\u00eda ingleses, pero no cualquier turista: se trata de un hospedaje de lujo, con clientes prestigiosos. De estilo neocl\u00e1sico, como el conjunto de la Place Royale, el edificio favorece la sobriedad y las proporciones armoniosas. La vista interior te ofrecer\u00e1 m\u00e1s detalles del decorado.\r\nEl Parque de Bruselas constituye un centro de atracci\u00f3n para los turistas: esta visita al parque es en efecto una excelente actividad a elegir. \"Entre media hora y una hora, este paseo se convierte generalmente en un punto de reuni\u00f3n para la diversidad, desde extranjeros hasta gente rica. Esta macedonia de nacionalidades que encontramos enriquece el ambiente del lugar\".\r\nSi las relaciones entre Bellevue y su ilustre vecino - el Palacio Real - siguen siendo buenas, el hotel hospeda a menudo a distinguidos invitados de entrevista real. Pueden haber surgido ciertos roces especialmente a causa de la contrucci\u00f3n de terrazas adyacentes al establecimiento, proporcionando una magn\u00edfica vista al Real Jard\u00edn de las Plantas Medicinales, el cual no era del agrado de Leopoldo ll.\r\nV\u00e9ase el folleto sobre la historia del edificio disponible en el lugar.\r\n\r\nLa entrada al museo BELvue es gratuita todos los mi\u00e9rcoles a partir de las 14:00.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Museo BELvue","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@belvue.be","website":"http:\/\/www.belvue.be","phone_contact":"+32 2 545 08 00","phone_booking":"+32 2 500 45 54","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"Apresentando-se como o museu da B\u00e9lgica e da sua hist\u00f3ria, mas igualmente como \u00abcentro para a democracia\u00bb, o estabelecimento beneficia de uma museografia recentemente completamente remodelada. Democracia, prosperidade, solidariedade, pluralismo, migra\u00e7\u00f5es, l\u00ednguas, Europa: o museu BELvue prop\u00f5e-lhe descobrir o pa\u00eds atrav\u00e9s desses temas. A abordagem quer-se original, pelo que cada tema \u00e9, em primeiro lugar, explicitado com a ajuda de testemunhas reais e, de seguida, contextualizado atrav\u00e9s da hist\u00f3ria. Mais de 200 objetos comp\u00f5em uma galeria e permitem incarnar a mem\u00f3ria material do pa\u00eds. Poder\u00e1 a\u00ed encontrar, por exemplo, uma litografia de Magritte, vasos em cristal produzidos por Val Saint-Lambert, m\u00e1scaras de carnaval da regi\u00e3o de Binche, ou ainda um bal\u00e3o assinado pela Sele\u00e7\u00e3o Belga de Futebol! Este edif\u00edcio, inicialmente usado como hotel, foi constru\u00eddo em 1776 \u2014 e aberto durante o ano seguinte \u2014 num tur\u00edstico, comercial (dif\u00edcil imagin\u00e1-lo hoje em dia!) e muito cosmopolita (o hotel Astoria, na rua Royale, \u00e9 a \u00fanica testemunha atual). O estabelecimento recebia essencialmente turistas, a maioria dos quais ingleses, mas n\u00e3o qualquer turista: tratava-se de um hotel de luxo, com clientes prestigiosos. De estilo neocl\u00e1ssico, como toda a Pra\u00e7a Real, o edif\u00edcio privilegia a sobriedade e as propor\u00e7\u00f5es harmoniosas. A visita interior oferecer-lhe-\u00e1 ainda mais detalhes de decora\u00e7\u00e3o. O Parque de Bruxelas consiste num polo de atra\u00e7\u00e3o para os turistas: o passeio mundano \u00e9, na realidade, um trabalho de escolha. \u00abDo meio-dia \u00e0 uma, este passeio torna-se, simplesmente, o local de encontro de estranhos e ricos. Esta salada de frutas de pa\u00edses que se encontram alegra este local durante algumas horas por dia\u00bb. Se, em geral, as rela\u00e7\u00f5es de Bellevue com o seu ilustre vizinho \u2014 o Pal\u00e1cio Real \u2014 permanecem boas, com o hotel a alojar frequentemente convidados de honra pass\u00edveis de uma visita real, poderiam ter ocorrido algumas fric\u00e7\u00f5es, nomeadamente devido \u00e0 constru\u00e7\u00e3o dos terra\u00e7os adjacentes ao estabelecimento, que oferecem uma vista magn\u00edfica para os jardins do rei, o que n\u00e3o \u00e9 muito do agrado de L\u00e9opold II\u2026 Ver o panfleto sobre a hist\u00f3ria do edif\u00edcio, dispon\u00edvel no local A entrada para o museu BELvue \u00e9 gratuita todas as ter\u00e7as-feiras a partir das 14h.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"mus\u00e9e BELvue","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@belvue.be","website":"http:\/\/www.belvue.be","phone_contact":"+32 2 545 08 00","phone_booking":"+32 2 500 45 54","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[16],"translations":{"fr":["Quartier Royal"],"nl":["Koninklijke wijk"],"en":["Royal"],"de":["K\u00f6nigliches Viertel"],"it":["Quartiere reale"],"sp":["Quartier Royal \u2014Barrio de la Corte\u2014"],"pt":[null],"cn":[null]}},"zones":{"list":[19],"translations":{"fr":["Centre"],"nl":["Centrum"],"en":["Centre"],"de":["Zentrum"],"it":["Centro"],"sp":["Centro"],"pt":[null],"cn":[null]}},"neca":null,"facebook_id":null,"backoffice_id":1250,"location":{"lat":50.84261029,"lon":4.36068879},"region":"brussels","last_updated_at":"2023-07-03T03:05:35+02:00","published_at":"2013-10-19T01:14:10+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":233379,"translations":{"fr":{"name":"mus\u00e9e BELvue","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@belvue.be","website":"http:\/\/www.belvue.be","phone_contact":"+32 2 545 08 00","phone_booking":"+32 2 500 45 54","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"Se pr\u00e9sentant comme le mus\u00e9e de la Belgique et de son histoire, mais \u00e9galement comme \u00ab centre pour la d\u00e9mocratie \u00bb, l\u2019\u00e9tablissement b\u00e9n\u00e9ficie d\u2019une mus\u00e9ographie compl\u00e8tement remani\u00e9e depuis peu. D\u00e9mocratie, prosp\u00e9rit\u00e9, solidarit\u00e9, pluralisme, migrations, langues, Europe : le mus\u00e9e BELvue vous propose de d\u00e9couvrir le pays \u00e0 travers ces quelques th\u00e9matiques. L\u2019approche se veut originale, puisque chaque th\u00e9matique est d\u2019abord explicit\u00e9e \u00e0 l\u2019aide de t\u00e9moignages actuels, et ensuite contextualis\u00e9e \u00e0 travers l\u2019histoire. Plus de 200 objets composent une galerie et permettent d\u2019incarner la m\u00e9moire mat\u00e9rielle du pays. Vous y croiserez par exemple une lithographie de Magritte, des vases en cristal du Val Saint-Lambert, un costume du carnaval de Binche, ou encore un ballon sign\u00e9 par les Diables Rouges !\r\n\r\nCe b\u00e2timent, affect\u00e9 initialement \u00e0 l\u2019usage d\u2019un h\u00f4tel, est b\u00e2ti en 1776 \u2014 et ouvert dans le courant de l\u2019ann\u00e9e suivante \u2014 dans un p\u00f4le \u00e0 vocation touristique, commercial (difficile \u00e0 s\u2019imaginer aujourd\u2019hui !), et tr\u00e8s cosmopolite (l\u2019h\u00f4tel Astoria, rue Royale, en demeure le seul t\u00e9moin actuel). L\u2019\u00e9tablissement recevait essentiellement des touristes, en majorit\u00e9 anglais, mais pas n\u2019importe quels touristes : il s\u2019agit d\u2019une h\u00f4tellerie de luxe, avec des clients prestigieux.\r\n\r\nDe style n\u00e9oclassique, comme l\u2019ensemble de la place Royale, le b\u00e2timent privil\u00e9gie la sobri\u00e9t\u00e9 et les proportions harmonieuses. La visite int\u00e9rieure vous offrira davantage de d\u00e9tails sur le d\u00e9cor.\r\n\r\nLe Parc de Bruxelles constituait un p\u00f4le d\u2019attraction pour les touristes : la promenade mondaine est en effet une occupation de choix. \u00ab De midi \u00e0 une heure, cette promenade devient ordinairement le rendez-vous des \u00e9trangers et des gens riches. Cette mac\u00e9doine de nations qu\u2019on y rencontre \u00e9gaie quelques heures par jour cet endroit. \u00bb\r\nSi globalement, les relations du Bellevue avec son illustre voisin \u2014 le palais royal \u2014 restent bonnes, l\u2019h\u00f4tel h\u00e9bergeant m\u00eame souvent des invit\u00e9s de marque susceptibles d\u2019une entrevue royale, quelques frictions ont pu appara\u00eetre, notamment \u00e0 cause de la construction de terrasses adjacentes \u00e0 l\u2019\u00e9tablissement, et donnant une vue magnifique sur les jardins du roi, ce qui n\u2019\u00e9tait pas tr\u00e8s au go\u00fbt de L\u00e9opold II\u2026\r\n\r\nHoraire exceptionnel les jours de vacances scolaires et le jours f\u00e9ri\u00e9s 9h30 \u00e0 17h\r\nLe 24\/12 et le 31\/12 9h30 \u00e0 16:00\r\nL'entr\u00e9e au mus\u00e9e BELvue est gratuite tous les mercredis \u00e0 partir de 14 heures et le 1er dimanche du mois","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"BELvue museum","address_street_name":"Paleizenplein","address_street_number":"7","address_street_box":null,"email":"info@belvue.be","website":"http:\/\/www.belvue.be","phone_contact":"+32 2 545 08 00","phone_booking":"+32 2 500 45 54","address_zip":"1000","address_city":"Brussel","address_line1":"Paleizenplein, 7","address_line2":"1000 Brussel","description_web":"Frieten, bier, chocolade\u2026 maar Belgi\u00eb is toch wel meer dan dat, nietwaar? Democratie, welvaart, solidariteit, pluralisme, migratie, taal, Europa: dat zijn de thema\u2019s die het BELvue museum jullie voorstelt om kennis te maken met het land! Elk thema wordt uitgewerkt aan de hand van hedendaagse getuigenissen en vervolgens toegelicht doorheen de geschiedenis. Een eigentijdse en originele manier om een beter inzicht te verwerven in het Belgi\u00eb van vandaag.\r\nNeem zeker ook een kijkje in de galerij: daar staan meer dan 200 voorwerpen opgesteld die het materi\u00eble geheugen van Belgi\u00eb vormen. Je kunt er onder andere de volgende zaken bewonderen: een lithografie van Magritte, een motorfiets, kristallen vazen van Val Saint-Lambert, en een bal met de handtekeningen van de Rode Duivels erop. Een verzameling met een hoog Belgi\u00ebgehalte!\r\n\r\nElke woensdag vanaf 14.00 uur is het BELvue museum gratis toegankelijk.\r\nMaandag open voor groepen en scholen op reservering van 09:30 tot 17:00\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"BELvue museum","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@belvue.be","website":"http:\/\/www.belvue.be","phone_contact":"+32 2 545 08 00","phone_booking":"+32 2 500 45 54","address_zip":"1000","address_city":"Brussels","address_line1":"Place des Palais, 7","address_line2":"1000 Brussels","description_web":"Chips, beer and chocolates... surely there is more to Belgium than that? Democracy, prosperity, solidarity, pluralism, migration, languages and Europe: these are the themes used by the BELvue Museum to help you to discover Belgium. Each one is developed through present-day testimonials and then traced right through history. This is a modern, original way of gaining a fuller understanding of modern-day Belgium.\r\nHave a look at the gallery too: there are more than 200 objects to view, each one forming a tangible memory of Belgium. Here are just a few examples: a lithograph by Magritte, a motorcycle, crystal vases by Val Saint-Lambert, and a football signed by the Red Devils. The very essence of Belgian-ness!\r\n\r\nSpeciale openingstijden op schoolvakanties en feestdagen 9.30 tot 17.00 uur\r\n24\/12 en 31\/12 9u30 tot 16u00\r\nHet BELvue Museum is elke woensdag vanaf 14u en de eerste zondag van de maand gratis toegankelijk.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Museum BELvue","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@belvue.be","website":"http:\/\/www.belvue.be","phone_contact":"+32 2 545 08 00","phone_booking":"+32 2 500 45 54","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"Belgische Fritten, Bier, Schokolade...Belgien ist mehr als nur das, oder? Demokratie, Wohlstand, Solidarit\u00e4t, Vielfalt, Migration, Sprachen, Europa: Dies sind die Themen, die das BELvue Museum Ihnen auf Ihrem Rundgang durch die Ausstellungsr\u00e4ume n\u00e4herbringt! Jedes Thema wird anhand von aktuellen Kommentaren und Berichten geschildert und dann in seinen geschichtlichen Kontext gebracht. Eine moderne und originelle Herangehensweise, die den Besuchern einen faszinierenden Einblick in das Belgien der Gegenwart gew\u00e4hrt.\r\n\r\nAbsolut sehenswert ist auch die Galerie: Mehr als 200 Ausstellungsst\u00fccke verk\u00f6rpern gewisserma\u00dfen das materielle Ged\u00e4chtnis Belgiens. Zu bewundern gibt es unter anderem eine Lithographie von Magritte, Kristallvasen aus der Kristallmanufaktur Val Saint-Lambert und sogar einen von den Roten Teufeln signierten Fu\u00dfball. Eine geballte Ladung belgischer Lebensart!\r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Museo BELvue","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@belvue.be","website":"http:\/\/www.belvue.be","phone_contact":"+32 2 545 08 00","phone_booking":"+32 2 500 45 54","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"Nel Museo BELvue, grazie a numerosi documenti, i visitatori potranno scoprire i grandi periodi della storia del Belgio.\u00a0...\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Museo BELvue","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@belvue.be","website":"http:\/\/www.belvue.be","phone_contact":"+32 2 545 08 00","phone_booking":"+32 2 500 45 54","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"Conocido como el museo de B\u00e9lgica y su historia, pero tambi\u00e9n como \"centro para la democracia\", el establecimiento posee una museograf\u00eda completamente redise\u00f1ada desde hace poco. Democracia, prosperidad, solidaridad, pluralismo, migraciones, idiomas, Europa: El museo BELvue te propone descubrir el pa\u00eds a trav\u00e9s de diferentes tem\u00e1ticas. El enfoque es original, ya que cada tem\u00e1tica se explica en primer lugar con la ayuda de testimonios actuales y a continuaci\u00f3n es contextualizada a trav\u00e9s de la historia. M\u00e1s de 200 objetos componen una galer\u00eda para encarnar la memoria material del pa\u00eds. Encontrar\u00e1s, por ejemplo, una litograf\u00eda de Magritte, los vasos de cristal de Val Saint-Lambert, un disfraz del carnaval de Binche, \u00a1Y un bal\u00f3n firmado por los Diablos Rojos!\r\nEste edificio, originalmente utilizado como hotel, se construy\u00f3 en 1776 \u2014 y fue abierto durante el transcurso del a\u00f1o siguiente \u2014 como un centro de car\u00e1cter tur\u00edstico, comercial y muy cosmopolita. El establecimiento recibe esencialmente turistas, en su mayor\u00eda ingleses, pero no cualquier turista: se trata de un hospedaje de lujo, con clientes prestigiosos. De estilo neocl\u00e1sico, como el conjunto de la Place Royale, el edificio favorece la sobriedad y las proporciones armoniosas. La vista interior te ofrecer\u00e1 m\u00e1s detalles del decorado.\r\nEl Parque de Bruselas constituye un centro de atracci\u00f3n para los turistas: esta visita al parque es en efecto una excelente actividad a elegir. \"Entre media hora y una hora, este paseo se convierte generalmente en un punto de reuni\u00f3n para la diversidad, desde extranjeros hasta gente rica. Esta macedonia de nacionalidades que encontramos enriquece el ambiente del lugar\".\r\nSi las relaciones entre Bellevue y su ilustre vecino - el Palacio Real - siguen siendo buenas, el hotel hospeda a menudo a distinguidos invitados de entrevista real. Pueden haber surgido ciertos roces especialmente a causa de la contrucci\u00f3n de terrazas adyacentes al establecimiento, proporcionando una magn\u00edfica vista al Real Jard\u00edn de las Plantas Medicinales, el cual no era del agrado de Leopoldo ll.\r\nV\u00e9ase el folleto sobre la historia del edificio disponible en el lugar.\r\n\r\nLa entrada al museo BELvue es gratuita todos los mi\u00e9rcoles a partir de las 14:00.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Museo BELvue","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@belvue.be","website":"http:\/\/www.belvue.be","phone_contact":"+32 2 545 08 00","phone_booking":"+32 2 500 45 54","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"Apresentando-se como o museu da B\u00e9lgica e da sua hist\u00f3ria, mas igualmente como \u00abcentro para a democracia\u00bb, o estabelecimento beneficia de uma museografia recentemente completamente remodelada. Democracia, prosperidade, solidariedade, pluralismo, migra\u00e7\u00f5es, l\u00ednguas, Europa: o museu BELvue prop\u00f5e-lhe descobrir o pa\u00eds atrav\u00e9s desses temas. A abordagem quer-se original, pelo que cada tema \u00e9, em primeiro lugar, explicitado com a ajuda de testemunhas reais e, de seguida, contextualizado atrav\u00e9s da hist\u00f3ria. Mais de 200 objetos comp\u00f5em uma galeria e permitem incarnar a mem\u00f3ria material do pa\u00eds. Poder\u00e1 a\u00ed encontrar, por exemplo, uma litografia de Magritte, vasos em cristal produzidos por Val Saint-Lambert, m\u00e1scaras de carnaval da regi\u00e3o de Binche, ou ainda um bal\u00e3o assinado pela Sele\u00e7\u00e3o Belga de Futebol! Este edif\u00edcio, inicialmente usado como hotel, foi constru\u00eddo em 1776 \u2014 e aberto durante o ano seguinte \u2014 num tur\u00edstico, comercial (dif\u00edcil imagin\u00e1-lo hoje em dia!) e muito cosmopolita (o hotel Astoria, na rua Royale, \u00e9 a \u00fanica testemunha atual). O estabelecimento recebia essencialmente turistas, a maioria dos quais ingleses, mas n\u00e3o qualquer turista: tratava-se de um hotel de luxo, com clientes prestigiosos. De estilo neocl\u00e1ssico, como toda a Pra\u00e7a Real, o edif\u00edcio privilegia a sobriedade e as propor\u00e7\u00f5es harmoniosas. A visita interior oferecer-lhe-\u00e1 ainda mais detalhes de decora\u00e7\u00e3o. O Parque de Bruxelas consiste num polo de atra\u00e7\u00e3o para os turistas: o passeio mundano \u00e9, na realidade, um trabalho de escolha. \u00abDo meio-dia \u00e0 uma, este passeio torna-se, simplesmente, o local de encontro de estranhos e ricos. Esta salada de frutas de pa\u00edses que se encontram alegra este local durante algumas horas por dia\u00bb. Se, em geral, as rela\u00e7\u00f5es de Bellevue com o seu ilustre vizinho \u2014 o Pal\u00e1cio Real \u2014 permanecem boas, com o hotel a alojar frequentemente convidados de honra pass\u00edveis de uma visita real, poderiam ter ocorrido algumas fric\u00e7\u00f5es, nomeadamente devido \u00e0 constru\u00e7\u00e3o dos terra\u00e7os adjacentes ao estabelecimento, que oferecem uma vista magn\u00edfica para os jardins do rei, o que n\u00e3o \u00e9 muito do agrado de L\u00e9opold II\u2026 Ver o panfleto sobre a hist\u00f3ria do edif\u00edcio, dispon\u00edvel no local A entrada para o museu BELvue \u00e9 gratuita todas as ter\u00e7as-feiras a partir das 14h.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"mus\u00e9e BELvue","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@belvue.be","website":"http:\/\/www.belvue.be","phone_contact":"+32 2 545 08 00","phone_booking":"+32 2 500 45 54","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":nul