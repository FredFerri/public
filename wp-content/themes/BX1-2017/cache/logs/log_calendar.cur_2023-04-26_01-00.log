ointment":true}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"},"de":{"name":"Normal"},"it":{"name":"Normale"},"sp":{"name":"Normal"},"pt":{"name":"Normal"},"cn":{"name":"Normal"}},"value":15},{"translations":{"fr":{"name":"Etudiants"},"nl":{"name":"Studenten"},"en":{"name":"Students"},"de":{"name":"Studierende"},"it":{"name":"Studenti"},"sp":{"name":"Estudiantes"},"pt":{"name":"Etudiants"},"cn":{"name":"Etudiants"}},"value":12},{"translations":{"fr":{"name":"Enfants"},"nl":{"name":"Kinderen"},"en":{"name":"Children"},"de":{"name":"Kinder"},"it":{"name":"Bambini"},"sp":{"name":"Ni\u00f1os"},"pt":{"name":"Enfants"},"cn":{"name":"Enfants"}},"value":10}],"child_events":[],"parent_events":[],"targets":{"list":[16,11,8,19,5,7],"translations":{"fr":["Ecoles","Famille","Jeunes 15-18 ans","Enseignants","Enfants 9-12 ans","Jeunes 12-15 ans"],"nl":["Scholen","Familie","Jongeren 15-18 j.","Leerkrachten","Kinderen 9-12 j.","Jongeren 12-15 j."],"en":["Schools","Family","Youth 15-18  yr.","Teachers","Children 9-12 yr.","Youth 12-15  yr."],"de":["Schulen","Familie","Jugendliche 15-18 Jahre","Lehrkr\u00e4fte","Kinder 9-12 Jahre","Jugendliche 12-15 Jahre"],"it":["Scuole","Famiglie","Ragazzi 15-18 anni","Insegnanti","Bambini 9-12 anni","Ragazzi 12-15 anni"],"sp":["Escuelas","Familias","J\u00f3venes de 15 a 18 a\u00f1os","Profesores","Ni\u00f1os de 9 a 12 a\u00f1os","J\u00f3venes de 12 a 15 a\u00f1os"],"pt":[null,null,null,null,null,null],"cn":[null,null,null,null,null,null]}},"tags":["exterior","kids"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-04-25T02:09:12+02:00","published_at":"2022-09-29T14:26:18+02:00","backoffice_id":262796,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.12973132109417},{"id":539766,"date_start":"2022-08-16","date_end":"2024-01-01","date_next":"2023-04-25","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen","it":"Visite guidate","sp":"Visitas guiadas","pt":null,"cn":null}},"others":{}},"languages":{"spoken":["fr","en","es"],"subtitles":[]},"translations":{"fr":{"name":"Visite gratuite de Bruxelles","shortdescr":"Visite guid\u00e9e du centre historique de Bruxelles \u00e0 10h30 et 15h30, avec d\u00e9gustation gratuite des meilleurs chocolats belges. Visitons les coins mythiques de la ville : h\u00e9ritage architectural, BD, chocolat et plus encore !","longdescr":"Avec notre visite guid\u00e9e gratuite de Bruxelles, baladons-nous dans les rues cach\u00e9es de Bruxelles accompagn\u00e9s de notre guide sp\u00e9cialis\u00e9. Nous y d\u00e9couvrirons les secrets des plus beaux lieux bruxellois gr\u00e2ce \u00e0 cette magnifique balade.\r\n\r\nDurant cette promenade, nous aurons le plaisir d\u2019apercevoir les lieux les plus iconiques de la capitale europ\u00e9enne tels que le Mus\u00e9e des Instruments de Musique \u00e0 l\u2019architecture typique Art Nouveau, l\u2019\u00eele Saint-G\u00e9ry et son march\u00e9 couvert du 19\u00e8me si\u00e8cle ou encore le mythique \u00ab petit homme qui pisse \u00bb connu sous le nom de Manneken-Pis dont notre guide se fera un plaisir de vous conter les l\u00e9gendes et les anecdotes surprenantes.\r\n\r\nApr\u00e8s avoir d\u00e9couvert le Bruxelles populaire, nous aurons l\u2019occasion d\u2019aller nous pavaner au milieu de la noblesse bruxelloise avec les mythiques cath\u00e9drale Saint-Michel et Gudule, la Place Royale et son incroyable panorama sur le Palais Royal ainsi que l\u2019incontournable Grand-Place changeante mais toujours aussi embl\u00e9matique au fil des quatre saisons\u2026\r\n\r\nC\u2019est une occasion inestim\u00e9e pour nous d\u2019en apprendre davantage sur l\u2019histoire mais aussi les traditions belges comme le chocolat et la bi\u00e8re et d\u2019enrichir notre culture artistique avec la bande dessin\u00e9e et notre auteur iconique Herg\u00e9 et les b\u00e2timents Art Nouveau, v\u00e9ritables symboles de Bruxelles et de l\u2019\u00e9poque Victor Horta.\r\n\r\nEt s\u2019il nous en faut encore plus, le prix de cette prestation est \u00e0 notre convenance : nous choisissons ce que le guide m\u00e9rite de recevoir ! N\u2019est-ce pas fantastique ? Qu\u2019attendons-nous ? R\u00e9servons d\u00e8s \u00e0 pr\u00e9sent notre visite guid\u00e9e gratuite de Bruxelles.\r\n\r\n\r\nProgramme :\r\n10h30 \u2013 Ville basse \u2013 Bruxelles populaire :\r\nLe matin, nous partirons \u00e0 la d\u00e9couverte du Bruxelles populaire dans la ville basse. Au cours de notre promenade, nous d\u00e9couvrirons non seulement les endroits les plus originaux du centre historique, mais nous nous impr\u00e9gnerons aussi de la v\u00e9ritable \u00e2me des bruxellois. \r\n\r\nLa Grand Place,\r\nLe monument \u00e0 \u00c9verard t\u2019Serclaes situ\u00e9 rue Charles Buls,\r\nLe Manneken Pis,\r\nLe quartier Saint- Jacques,\r\nL\u2019\u00e9glise Notre-Dame de Bon Secours,\r\nLe boulevard Anspach,\r\nLa vo\u00fbte de la Senne,\r\nL\u2019\u00eelot Saint-G\u00e9ry, la reconstruction de l\u2019ancien bras de la Senne,\r\nLes Halles Saint-G\u00e9ry,\r\nLe Zinneke Pis,\r\nLa Place Sainte-Catherine et son \u00e9glise,\r\nLa Tour Noire,\r\nLe B\u00e9guinage et l\u2019\u00e9glise Saint-Jean-Baptiste,\r\nLa Place De Brouck\u00e8re,\r\nLa Place de la Monnaie,\r\nLes Galeries Royales,\r\nLa Place Charles Buls.\r\n \r\n\r\n15h30 \u2013 Ville haute et le Bruxelles de la nobless:\r\nL\u2019apr\u00e8s-midi la visite se centrera sur la ville haute et le Bruxelles de la noblesse. Nous pourrons en comprendre l\u2019impact du pouvoir eccl\u00e9siastique, faire connaissance avec sa dynastie bourguignonne, sa guilde des arbal\u00e9triers et saisir l\u2019\u00e9tendue du pouvoir monarchique actuel.\r\n\r\nLa Grand Place, le pouvoir des commer\u00e7ants,\r\nLa galerie Saint Hubert,\r\nLa mort subite,\r\nLa Cath\u00e9drale des Saints Michel et Gudule (visite int\u00e9rieure : les vitraux de la Chapelle du Saint Sacrement et le patronage de la famille de Charles V ; la chaire de v\u00e9rit\u00e9),\r\nLe Parc Royal, le Palais Royal et la Place Royale,\r\nLe Palais du Coudenberg,\r\nLe Mus\u00e9e des Instruments de Musique (\u00e9difice Art Nouveau),\r\nLe palais de Charles de Lorraine, le mus\u00e9e Magritte et le palais des Beaux-Arts,\r\nLe Petit Sablon et le Grand Sablon,\r\nLa rue de Rollebeek,\r\nLa place de Dinant,\r\nLe Manneken Pis.\r\n\r\n\r\nInformations pratiques :\r\n\r\nPrix :\r\nPrix de la visite guid\u00e9e : prix libre (maximum 7 personnes par r\u00e9servation. Les groupes de plus de 7 personnes ont un co\u00fbt de 10\u20ac par personne).\r\nBravo Discovery met \u00e0 votre disposition ses meilleurs guides Bruxellois. A la fin de la visite, c\u2019est vous qui jugez la qualit\u00e9 de notre service et du guide. Vous payez ce qui vous semble juste.\r\n\r\nQuand :\r\nTous les jours.\r\n\r\nHeures de d\u00e9part :\r\nLe matin : 10h30\r\nL\u2019apr\u00e8s-midi : 15h30\r\n \r\n\r\nPoint de rencontre :\r\nLa Grand-Place de Bruxelles, en face de l\u2019H\u00f4tel de ville. Vous reconna\u00eetrez nos guides gr\u00e2ce \u00e0 leur parapluie blanc muni du logo Bravo Discovery.\r\n \r\n\r\nDur\u00e9e :\r\n2h30\r\n\r\nLangue \r\nFran\u00e7ais.\r\n\r\nInclus :\r\nGuide professionnel francophone.\r\nD\u00e9gustation gratuite des meilleurs chocolats belges.\r\n\r\nNon inclus :\r\nLe paiement du guide \u00e0 la fin de la visite (montant libre en fonction de votre satisfaction).\r\n\r\nRecommandation:\r\nPortez des chaussures confortables pour la visite.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.bravodiscovery.com","email":"info@bravodiscovery.com","phone_contact":null,"phone_booking":"+32 495 32 03 62","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.539766"},"nl":{"name":"Visite gratuite de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.bravodiscovery.com","email":"info@bravodiscovery.com","phone_contact":null,"phone_booking":"+32 495 32 03 62","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.539766"},"en":{"name":"Free tour of Brussels","shortdescr":null,"longdescr":"Free walking tour Brussels:\r\nOur professional guides welcome you every day for a guided tour of the historical center of Brussels.\r\n\r\nAs Brussels is a rather hilly town, tours have been developed with 2 different themes: Upper City and Lower City. This is also meant to help you better understand the origins and the historic development of Brussels.\r\n\r\n\r\nProgram of the free tour of Brussels:\r\n10h30 \u2013 Lower City: the popular Brussels (this tour focuses on the Marolles, people and trades):\r\nThe Grand Place,\r\nThe Everard t\u2019Serclaes monument on Charles Buls street,\r\nThe Manneken Pis and Grands Carmes street,\r\nMarch\u00e9 au Charbon street,\r\nThe Church of Our Lady of Assistance and Bon Secours street,\r\nAnspach boulevard,\r\nThe covering of the Senne,\r\nRiches Claires street and Grande \u00cele street,\r\nThe Saint-G\u00e9ry island,\r\nThe Halles Saint-G\u00e9ry,\r\nChartreux street and the Zinneke Pis,\r\nVieux March\u00e9 aux Grains street and its Art Deco building,\r\nSt-Catherine square and church,\r\nThe Black Tower,\r\nThe B\u00e9guinage and Saint John the Baptist church,\r\nThe De Brouck\u00e8re square,\r\nThe Monnaie square,\r\nThe Galeries Royales St Hubert,\r\nThe Charles Buls square.\r\n \r\n\r\n15h30 \u2013 Upper City: this tour focuses on the nobility and the church, the Burgundian dynasty, the Habsburgs, the guild of archers, the regime in power:\r\nThe Grand Place, the power of merchants,\r\nThe Galeries Royales St Hubert,\r\nThe Mort Subite,\r\nThe Cathedral of St. Michael and St. Gudula (visit inside: stained glass windows, the Chapel of the Blessed Sacrament, the pulpit),\r\nThe Royal Park, the Royal Palace and the Royal Square,\r\nThe Palace of Coudenberg,\r\nThe Musical Instruments Museum (Art Nouveau),\r\nThe Palace of Charles de Lorraine, the Magritte museum and the Palace of Fine Arts,\r\nThe Petit Sablon and the Grand Sablon,\r\nRollebeek street,\r\nThe Dinant square,\r\nThe Manneken Pis.\r\n\r\n\r\nPractical information:\r\n\r\nPrice:\r\nFree (pay what you want).\r\n\r\nWhen:\r\nEvery day.\r\n\r\nStarting time:\r\n10:30am\r\n3:30pm\r\n\r\nMeeting point:\r\nGrand-Place in front of the City Hall. Find our guides! They hold a white umbrella.\r\n\r\nDuration:\r\n2,5 hours.\r\n\r\nLanguage:\r\nEnglish.\r\n\r\nIncluded:\r\nGuided tour with an English-speaking guide.\r\nFree tasting of the best Belgian chocolates.\r\n\r\nNot included:\r\nTipping.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.bravodiscovery.com","email":"info@bravodiscovery.com","phone_contact":null,"phone_booking":"+32 495 32 03 62","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.539766"},"de":{"name":"Visite gratuite de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.bravodiscovery.com","email":"info@bravodiscovery.com","phone_contact":null,"phone_booking":"+32 495 32 03 62","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.539766"},"it":{"name":"Visite gratuite de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.bravodiscovery.com","email":"info@bravodiscovery.com","phone_contact":null,"phone_booking":"+32 495 32 03 62","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.539766"},"sp":{"name":"Visite gratuite de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.bravodiscovery.com","email":"info@bravodiscovery.com","phone_contact":null,"phone_booking":"+32 495 32 03 62","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.539766"},"pt":{"name":"Visite gratuite de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.bravodiscovery.com","email":"info@bravodiscovery.com","phone_contact":null,"phone_booking":"+32 495 32 03 62","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.539766"},"cn":{"name":"Visite gratuite de Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.bravodiscovery.com","email":"info@bravodiscovery.com","phone_contact":null,"phone_booking":"+32 495 32 03 62","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.539766"}},"place":{"id":258936,"translations":{"fr":{"name":"Bravo Discovery sprl","address_street_name":"Rue du Midi 76","address_street_number":"76","address_street_box":null,"email":"info@bravodiscovery.com","website":"http:\/\/www.bravodiscovery.com","phone_contact":"+32 470 60 35 05","phone_booking":"+32 495 32 03 62","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Midi 76, 76","address_line2":"1000 Bruxelles","description_web":"Bravo Discovery vous offre un service de qualit\u00e9 sur toute la Belgique, avec l'\u00e9thique d'un tourisme responsable.\r\nNous travaillons en partenariat avec l'Office du Tourisme bruxellois (visit.brussels). Nos collaborateurs sont des guides professionnels et nous avons une \u00e9quipe de guides free-lance dont la plupart ont \u00e9t\u00e9 form\u00e9s dans les Hautes \u00c9coles bruxelloises.\r\n\u200bNotre sp\u00e9cialisation : nous sommes sp\u00e9cialis\u00e9s dans les visites guid\u00e9es faites sur mesure, adapt\u00e9es aux attentes de nos clients. Nous sommes \u00e9galement attentifs \u00e0 l'\u00e9