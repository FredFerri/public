gation report. \r\nA ranking is then established, and a prize is awarded to the top-ranked team. \r\nOn average, the event takes 2 hours 30 minutes.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Quiveutpister","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":"guillaume@quiveutpisterbruxelles.com","website":"https:\/\/www.quiveutpisterbruxelles.com","phone_contact":"+32 2 318 36 07","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Quiveutpister","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Quiveutpister","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":"guillaume@quiveutpisterbruxelles.com","website":"https:\/\/www.quiveutpisterbruxelles.com","phone_contact":"+32 2 318 36 07","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Quiveutpister","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Quiveutpister","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":"guillaume@quiveutpisterbruxelles.com","website":"https:\/\/www.quiveutpisterbruxelles.com","phone_contact":"+32 2 318 36 07","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Quiveutpister","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Quiveutpister","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":"guillaume@quiveutpisterbruxelles.com","website":"https:\/\/www.quiveutpisterbruxelles.com","phone_contact":"+32 2 318 36