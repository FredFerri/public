,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":305109,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.28543716208189446,"languages":{"spoken":["nl","fr","en"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[36],"translations":{"de":["Museen & Kunstzentren"],"pt":[null],"en":["Museums and art centers"],"it":["Musei e centri artistici"],"cn":[null],"fr":["Mus\u00e9es et art centers"],"sp":["Museos y centros de arte"],"nl":["Musea en kunstcentra"]}}},"translations":{"de":{"name":"Alechinsky, pinceau voyageur","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/villaempain.com\/","email":"info@boghossianfoundation.be","phone_contact":"+32 2 627 52 30","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50013190"},"pt":{"name":"Alechinsky, pinceau voyageur","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/villaempain.com\/","email":"info@boghossianfoundation.be","phone_contact":"+32 2 627 52 30","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50013190"},"en":{"name":"Alechinsky, pinceau voyageur","shortdescr":"The Boghossian Foundation presents a solo exhibition devoted to a major European artist of the 20th century. \"Alechinsky, pinceau voyageur\" is an invitation to journey through the remarkable body of the artist's works. The exhibition brings together an exceptional collection of around a hundred works and numerous archival documents, gathered over the past seventy years.\n","longdescr":"The Boghossian Foundation is pleased to present \"Alechinsky, pinceau voyageur\", an invitation to journey through the remarkable body of the artist\u2019s works. For the very first time since its opening to the public in 2010, the Boghossian Foundation presents a solo exhibition devoted to a major European artist of the 20th century, in the welcoming and unique setting of the Villa.\n\nThe exhibition, curated by Catherine de Braekeleer, brings together an exceptional collection of around a hundred works and numerous archival documents, gathered over the past seventy years. \n\n\"Alechinsky, pinceau voyageur\", is an ode to travel, which explores notably this remarkable artist\u2019s fascination with artistic practices and traditions in Japan and China, which have respectively inspired him.\nAn ode to freedom, the exhibition highlights the artist\u2019s freedom of experimentation, alternating between different techniques and mediums since 1947: canvases, inks, with or without embossing, etchings, lithographs, enameled lava, porcelain books, and even a harpsichord painted in 1986, displayed in the grand hall.\nAn ode to friendship, the exhibition presents works created in collaboration with artists like Ji\u0159\u00ed Kol\u00e1\u0159, Hans Spinner, or to accompany the works of authors such as Salah St\u00e9ti\u00e9, Amos Kenan, or Joyce Mansour.\nAn ode to love, the exhibition also reveals itself through the image of the unpublished painting titled \"Comme elle partait\", created in 2023, as a tribute to Micky (1928-2023), whom he married in 1949.","performers":"Alechinsky","boxoffice_url":null,"website":"https:\/\/villaempain.com\/","email":"info@boghossianfoundation.be","phone_contact":"+32 2 627 52 30","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50013190"},"it":{"name":"Alechinsky, pinceau voyageur","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/villaempain.com\/","email":"info@boghossianfoundation.be","phone_contact":"+32 2 627 52 30","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50013190"},"cn":{"name":"Alechinsky, pinceau voyageur","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/villaempain.com\/","email":"info@boghossianfoundation.be","phone_contact":"+32 2 627 52 30","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50013190"},"fr":{"name":"Alechinsky, pinceau voyageur","shortdescr":"La Fondation Boghossian pr\u00e9sente une exposition solo consacr\u00e9e \u00e0 un artiste europ\u00e9en majeur du XXe si\u00e8cle. \"Alechinsky, pinceau voyageur\" est une invitation au voyage qui d\u00e9voile le remarquable corpus d\u2019\u0153uvres de l\u2019artiste. L\u2019exposition r\u00e9unit un ensemble exceptionnel d\u2019une centaine d\u2019\u0153uvres et de nombreux documents d\u2019archives, rassembl\u00e9s au cours des septante derni\u00e8res ann\u00e9es.\n","longdescr":"La Fondation Boghossian est infiniment heureuse de pr\u00e9senter \"Alechinsky, pinceau voyageur\", une invitation au voyage qui d\u00e9voile le remarquable corpus d\u2019\u0153uvres de l\u2019artiste. Pour la premi\u00e8re fois depuis son ouverture au public en 2010, la Fondation Boghossian pr\u00e9sente une exposition solo consacr\u00e9e \u00e0 un artiste majeur europ\u00e9en du XXe si\u00e8cle dans l\u2019\u00e9crin chaleureux et unique de la Villa.\n\nL\u2019exposition, dont le commissariat est assur\u00e9 par Catherine de Braekeleer, r\u00e9unit un ensemble exceptionnel d\u2019une centaine d\u2019\u0153uvres et de nombreux documents d\u2019archives, rassembl\u00e9s au cours des septante derni\u00e8res ann\u00e9es. \n\n\"Alechinsky, pinceau voyageur\" est une ode au voyage, qui explore notamment la fascination de l\u2019immense artiste pour les pratiques et traditions artistiques en cours au Japon et en Chine, qui l\u2019ont respectivement inspir\u00e9.\nOde \u00e0 la libert\u00e9, l\u2019exposition met en exergue la libert\u00e9 d\u2019exp\u00e9rimentation de l\u2019artiste, qui alterne diff\u00e9rentes techniques et supports depuis 1947 : toiles, encres, avec ou sans estampages, eaux-fortes, lithographies, laves \u00e9maill\u00e9es, livres en porcelaine ou encore le clavecin, peint en 1986, pr\u00e9sent\u00e9 dans le grand hall.\nOde \u00e0 l\u2019amiti\u00e9, l\u2019exposition pr\u00e9sente des oeuvres con\u00e7ues \u00e0 quatre mains par Alechinsky avec des artistes comme Ji\u0159\u00ed Kol\u00e1\u0159, Hans Spinner, ou pour accompagner les ouvrages d\u2019auteurs comme Salah St\u00e9ti\u00e9, Amos Kenan ou Joyce Mansour.\nOde \u00e0 l\u2019amour, l\u2019exposition se d\u00e9voile aussi \u00e0 travers l\u2019image de cette toile in\u00e9dite intitul\u00e9e \"Comme elle partait\" r\u00e9alis\u00e9e en 2023, en hommage \u00e0 Micky (1928-2023) qu\u2019il \u00e9pousa en 1949.","performers":"Alechinsky","boxoffice_url":null,"website":"https:\/\/villaempain.com\/","email":"info@boghossianfoundation.be","phone_contact":"+32 2 627 52 30","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50013190"},"sp":{"name":"Alechinsky, pinceau voyageur","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/villaempain.com\/","email":"info@boghossianfoundation.be","phone_contact":"+32 2 627 52 30","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50013190"},"nl":{"name":"Alechinsky, pinceau voyageur","shortdescr":"De Boghossianstichting presenteert een solotentoonstelling gewijd aan een grote Europese kunstenaar van de 20e eeuw. \"Alechinsky, pinceau voyageur\", is een uitnodiging tot reizen door het heel bijzondere \u0153uvre van deze kunstenaar. Deze tentoonstelling brengt een uitgelezen ensemble van een honderdtal werken en tal van archiefdocumenten, bijeengezameld in de loop van de laatste zeventig jaar.","longdescr":"De Boghossianstichting is verheugd te kunnen uitpakken met de tentoonstelling \"Alechinsky, pinceau voyageur\", een uitnodiging tot reizen door het heel bijzondere oeuvre van deze kunstenaar. Voor de allereerste keer sinds de Villa Empain haar deuren opende voor het publiek in 2010, presenteert de Boghossianstichting een solotentoonstelling gewijd aan een grote Europese kunstenaar van de 20e eeuw, in de unieke en gezellige setting van de Villa. Deze tentoonstelling, met Catherine de Braekeleer als curatrice, brengt een uitgelezen ensemble van een honderdtal werken en tal van archiefdocumenten, bijeengezameld in de loop van de laatste zeventig jaar.\n\n\"Alechinsky, pinceau voyageur\" is een ode aan de reis, met speciale aandacht voor de fascinatie van deze buitengewone kunstenaar voor de artistieke praktijken en tradities van Japan en China, voor hem een bron van inspiratie.\nDe tentoonstelling is ook een ode aan de vrijheid en belicht met name de experimentele vrijheid van de kunstenaar, die sinds 1947 werkt met uiteenlopende technieken en dragers: doeken, inkten, met of zonder opdruk, etsen, litho\u2019s, ge\u00ebmailleerde lava, boeken van porselein en een in 1986 geschilderde klavecimbel, te zien in de grote hal.\nDe tentoonstelling is bovendien een ode aan de vriendschap, met werken gecre\u00eberd door Alechinsky in samenwerking met kunstenaars als Ji\u0159\u00ed Kol\u00e1\u0159 en Hans Spinner, en werken die hij maakte ter illustratie van boeken van auteurs als Salah St\u00e9ti\u00e9, Amos Kenan en Joyce Mansour.\nHet is tot slot ook een ode aan de liefde, met een nooit eerder tentoongesteld schilderij, getiteld \"Comme elle partait\", dat Alechinsky schilderde in 2023, als eerbetoon aan Micky (1928-2023), met wie hij trouwde in 1949.","performers":"Alechinsky","boxoffice_url":null,"website":"https:\/\/villaempain.com\/","email":"info@boghossianfoundation.be","phone_contact":"+32 2 627 52 30","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50013190"}},"place":{"id":248760,"translations":{"de":{"name":"Boghossian-Stiftung \u2013 Villa Empain","address_street_name":"Avenue Franklin Roosevelt","address_street_number":"67","address_street_box":null,"email":"info@boghossianfoundation.be","website":"http:\/\/www.villaempain.com","phone_contact":"+32 2 627 52 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Franklin Roosevelt, 67","address_line2":"1050 Ixelles","description_web":"Die Anfang der 1930er-Jahre erbaute Villa Empain ist ein bemerkenswertes Beispiel der Art D\u00e9co-Architektur. Sie geh\u00f6rte einst einer der reichsten Familien Europas, die heute fast vollst\u00e4ndig verarmt ist. Die Villa steht seit 2007 unter Denkmalschutz.\r\n\r\nJugendstil, Art D\u00e9co und Moderne: Ihr Architekt Michel Polak (1885\u20131948) kombinierte Zierelemente des Br\u00fcsseler Jugendstils mit Formen der Moderne: Ein Gesamtkunstwerk, bei dem Formen und edle Materialien der eleganten Ausstattung untrennbar zu einer ungew\u00f6hnlichen und imposanten Einheit verschmelzen.\r\n\r\nVom drohenden Verfall zur aufwendigen Restaurierung: Nach der zwischenzeitlichen Nutzung als sowjetische Botschaft und als Studio des Fernsehsenders RTL wurde die Villa nach aufwendiger Restaurierung zur imposanten Kulisse der Kulturstiftung Fondation Boghossian.","description_print":null,"booking_url":null,"sort_order":"BOGHOSSIAN FOUNDATION - VILLA EMPAIN","virtual_visit":null,"visit_url":null},"pt":{"name":"Fondation Boghossian \u2013 Villa Empain","address_street_name":"Avenue Franklin Roosevelt","address_street_number":"67","address_street_box":null,"email":"info@boghossianfoundation.be","website":"http:\/\/www.villaempain.com","phone_contact":"+32 2 627 52 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Franklin Roosevelt, 67","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Boghossian Foundation - Villa Empain","address_street_name":"Avenue Franklin Roosevelt","address_street_number":"67","address_street_box":null,"email":"info@boghossianfoundation.be","website":"http:\/\/www.villaempain.com","phone_contact":"+32 2 627 52 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Franklin Roosevelt, 67","address_line2":"1050 Ixelles","description_web":"\r\nOpening of Villa Empain to the public according to several themes of organised activities and events (exhibitions, concerts, conferences, etc.) from 2010. La Fondation Boghossian has its international office in Villa Empain, on which restoration work began in 2008. With the Stoclet building, constructed by the Austrian architect Josef Hoffmann in 1911, Villa Empain is undoubtedly one of the finest masterpieces of Art Deco architecture in Brussels. In 1930, Baron Louis Empain, then aged 21 years, had this 2,500-metre-square mansion built on the prestigious Avenue des Nations, which was later renamed Avenue Franklin Roosevelt. He entrusted the building of this fine house to the Swiss architect Michel Polak, assisted by his colleague Alfred Hoch. The plan designed for Baron Empain on a 55-acre plot included a monumental villa with four fa\u00e7ades in polished granite, a garden surrounding a swimming pool ornamented with a pergola, and a caretaker's lodge. The modern and luxurious nature of this structure soon aroused enthusiasm and curiosity. It is true that the variety and quality of the materials used (marble, polished granite, bronze, wrought iron, stained-glass windows and precious woods), the sophistication of the details and the coherence of the whole thing with simple but imposing lines immediately contributed to its patrimonial value. \r\n  ","description_print":"A villa in Art Deco style which is now home to the Boghossion Foundation: a centre for art and dialogue between Oriental and Western culture.","booking_url":null,"sort_order":"BOGHOSSIAN FOUNDATION - VILLA EMPAIN","virtual_visit":null,"visit_url":null},"it":{"name":"Fondation Boghossian \u2013 Villa Empain","address_street_name":"Avenue Franklin Roosevelt","address_street_number":"67","address_street_box":null,"email":"info@boghossianfoundation.be","website":"http:\/\/www.villaempain.com","phone_contact":"+32 2 627 52 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Franklin Roosevelt, 67","address_line2":"1050 Ixelles","description_web":"La Villa Empain \u00e8 uno straordinario esempio di architettura Art Deco costruita all'inizio degli anni '30. Oggi ospita il Centro de'Art e Dialogo tra Oriente e Occidente....\r\n\r\nLa Villa Empain \u00e8 uno straordinario esempio di architettura Art Deco costruita all'inizio degli anni '30. Oggi ospita il Centro de'Art e Dialogo tra Oriente e Occidente.\r\nVilla Empain \u00e8 anche la sede internazionale della Fondazione Boghossian, che opera in molti paesi dal 1992.\r\nEdificio classificato dal 2007, \u00e8 stata interamente restaurata seguendo scrupolosamente le strutture originali.\r\n\r\nDa non perdere.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Fondation Boghossian \u2013 Villa Empain","address_street_name":"Avenue Franklin Roosevelt","address_street_number":"67","address_street_box":null,"email":"info@boghossianfoundation.be","website":"http:\/\/www.villaempain.com","phone_contact":"+32 2 627 52 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Franklin Roosevelt, 67","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Fondation Boghossian \u2013 Villa Empain","address_street_name":"Avenue Franklin Roosevelt","address_street_number":"67","address_street_box":null,"email":"info@boghossianfoundation.be","website":"http:\/\/www.villaempain.com","phone_contact":"+32 2 627 52 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Franklin Roosevelt, 67","address_line2":"1050 Ixelles","description_web":" A l'initiative de la Fondation Boghossian, la c\u00e9l\u00e8bre Villa Empain a \u00e9t\u00e9 enti\u00e8rement restaur\u00e9e et a ouvert ses portes au public depuis le 23 avril 2010. Lieu de rencontres et de d\u00e9couvertes, d'\u00e9motions partag\u00e9es et d'\u00e9merveillement, la Villa Empain est aussi un remarquable t\u00e9moin de l'architecture Art D\u00e9co. En 1930, le baron Louis Empain, alors \u00e2g\u00e9 de 21 ans, fit \u00e9riger cet h\u00f4tel particulier de 2500 m2 sur la prestigieuse avenue des Nations qui fut rebaptis\u00e9e plus tard avenue Franklin Roosevelt. C'est \u00e0 l'architecte suisse Michel Polak qu'il confia la construction de cette splendide maison. Le projet con\u00e7u pour le baron Empain sur un terrain de 55 ares comprenait une villa monumentale \u00e0 quatre fa\u00e7ades en granit poli, un jardin entourant une piscine agr\u00e9ment\u00e9e d'une pergola, et une conciergerie. La diversit\u00e9 et la qualit\u00e9 des mat\u00e9riaux utilis\u00e9s (marbre, granit poli, bronze, fer forg\u00e9, vitraux et bois pr\u00e9cieux), le raffinement des d\u00e9tails et la coh\u00e9rence de l'ensemble imposant des lignes simples et imposantes, contribu\u00e8rent d'embl\u00e9e \u00e0 sa valeur patrimoniale.\r\n\r\n \r\n\r\nCette belle demeure situ\u00e9e au coeur de la capitale de l'Europe est devenu un Centre d'Art et de Dialogue entre les cultures d'Orient et d'Occident. Ce centre r\u00e9pond \u00e0 plusieurs objectifs compl\u00e9mentaires: culturels, artistiques, p\u00e9dagogiques, scientifiques, ainsi qu'\u00e0 toutes activit\u00e9s qui peuvent renforcer ce dialogue. C'est dans cet esprit d'ouverture culturelle que la Fondation Boghossian y pr\u00e9sente des expositions prestigieuses, accessibles au public du mardi au dimanche. Toutes les informations utiles sont reprises sur le site internet de la Villa Empain.\r\n\r\n  ","description_print":"Dans la prestigieuse villa Empain, cette fondation vise \u00e0 d\u00e9velopper \u00e0 Bruxelles un centre de cr\u00e9ation et de dialogue entre l\u2019Orient et l\u2019Occident. Une programmation vari\u00e9e d\u2019activit\u00e9s culturelles est pr\u00e9vue pour le public.","booking_url":null,"sort_order":"BOGHOSSIAN FOUNDATION - VILLA EMPAIN","virtual_visit":null,"visit_url":null},"sp":{"name":"Villa Empain, Fundaci\u00f3n Boghossian","address_street_name":"Avenue Franklin Roosevelt","address_street_number":"67","address_street_box":null,"email":"info@boghossianfoundation.be","website":"http:\/\/www.villaempain.com","phone_contact":"+32 2 627 52 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Franklin Roosevelt, 67","address_line2":"1050 Ixelles","description_web":"La Villa Empain es un testigo destacado de la arquitectura Art d\u00e9co.\r\nConstruida a principios de los a\u00f1os 1930 y ubicada en el centro de la capital europea, se ha convertido en un Centro de Arte y de Di\u00e1logo imprescindible.\u00a0\r\n\r\nEs igualmente la sede internacional de la Fundaci\u00f3n Boghossian, que trabaja en distintos pa\u00edses desde el a\u00f1o 1992. Declarado monumento en el a\u00f1o 2007, ha sido restaurando siguiendo los criterios del edificio original.\u00a0A fecha de hoy, alberga diferentes exposiciones y actividades.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Boghossian Stichting - Villa Empain","address_street_name":"Franklin Rooseveltlaan","address_street_number":"67","address_street_box":null,"email":"info@boghossianfoundation.be","website":"http:\/\/www.villaempain.com","phone_contact":"+32 2 627 52 30","phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"Franklin Rooseveltlaan, 67","address_line2":"1050 Elsene","description_web":"De Villa Empain is vanaf 2010 toegankelijk voor het grote publiek. Er worden verschillende activiteiten en evenementen georganiseerd (tentoonstellingen, concerten, conferenties enz.). De stichting Boghossian heeft zijn internationale zetel in de Villa Empain waarvan de restauratiewerkzaamheden in 2008 zijn gestart. Samen met het Paleis Stoclet, gebouwd door de Oostenrijkse architect Josef Hoffmann in 1911, is de Villa Empain zeker een van de mooiste meesterwerken van de art-decoarchitectuur in Brussel. In 1930 liet de toen 21-jarige baron Louis Empain dit bijzondere huis ontwerpen met een oppervlakte van 2.500 vierkante meter, gelegen op de Natielaan (later de Franklin Rooseveltlaan). De bouw van dit prachtige huis vertrouwde hij toe aan de Zwitserse architect Michel Polak, bijgestaan door zijn medewerker Alfred Hoch. Het project dat voor Baron Empain werd uitgedacht op een terrein van 55 are, bestaat uit een grote villa met vier gevels in gepolijst graniet, een tuin met een zwembad, een pergola en een portierswoning. Het moderne en luxueuze karakter van deze constructie wekte al heel snel enthousiasme en nieuwsgierigheid op. De verscheidenheid, de kwaliteit van de gebruikte materialen (marmer, gepolijst graniet, brons, gietijzer en fijne houtsoorten), de verfijnde details en de harmonie van het geheel, de eenvoudige, maar indrukwekkende lijnen? Dit alles zou meteen bijdragen tot de waarde van de villa ","description_print":"Een centrum voor kunst en dialoog tussen de oosterse en de westerse cultuur . E\u00e9n van de belangrijkste doelstellingen van de Boghossian-stichting is het oprichten van een centrum van culturele en artistieke dialoog tussen het Oosten en het Westen. Haar uitvalsbasis is de prestigieuze villa Empain, waarin ze allerhande culturele activiteiten organiseert voor het publiek.","booking_url":null,"sort_order":"BOGHOSSIAN FOUNDATION - VILLA EMPAIN","virtual_visit":null,"visit_url":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[21],"translations":{"de":["S\u00fcden"],"pt":[null],"en":["South"],"it":["Sud"],"cn":[null],"fr":["Sud"],"sp":["Sur"],"nl":["Zuid"]}},"neca":"art_center","facebook_id":null,"backoffice_id":10918,"location":{"lat":50.80750954,"lon":4.38436842},"region":"brussels","last_updated_at":"2024-06-14T16:26:02+02:00","published_at":"2013-10-19T01:29:22+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":248760,"translations":{"de":{"name":"Boghossian-Stiftung \u2013 Villa Empain","address_street_name":"Avenue Franklin Roosevelt","address_street_number":"67","address_street_box":null,"email":"info@boghossianfoundation.be","website":"http:\/\/www.villaempain.com","phone_contact":"+32 2 627 52 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Franklin Roosevelt, 67","address_line2":"1050 Ixelles","description_web":"Die Anfang der 1930er-Jahre erbaute Villa Empain ist ein bemerkenswertes Beispiel der Art D\u00e9co-Architektur. Sie geh\u00f6rte einst einer der reichsten Familien Europas, die heute fast vollst\u00e4ndig verarmt ist. Die Villa steht seit 2007 unter Denkmalschutz.\r\n\r\nJugendstil, Art D\u00e9co und Moderne: Ihr Architekt Michel Polak (1885\u20131948) kombinierte Zierelemente des Br\u00fcsseler Jugendstils mit Formen der Moderne: Ein Gesamtkunstwerk, bei dem Formen und edle Materialien der eleganten Ausstattung untrennbar zu einer ungew\u00f6hnlichen und imposanten Einheit verschmelzen.\r\n\r\nVom drohenden Verfall zur aufwendigen Restaurierung: Nach der zwischenzeitlichen Nutzung als sowjetische Botschaft und als Studio des Fernsehsenders RTL wurde die Villa nach aufwendiger Restaurierung zur imposanten Kulisse der Kulturstiftung Fondation Boghossian.","description_print":null,"booking_url":null,"sort_order":"BOGHOSSIAN FOUNDATION - VILLA EMPAIN","virtual_visit":null,"visit_url":null},"pt":{"name":"Fondation Boghossian \u2013 Villa Empain","address_street_name":"Avenue Franklin Roosevelt","address_street_number":"67","address_street_box":null,"email":"info@boghossianfoundation.be","website":"http:\/\/www.villaempain.com","phone_contact":"+32 2 627 52 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Franklin Roosevelt, 67","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Boghossian Foundation - Villa Empain","address_street_name":"Avenue Franklin Roosevelt","address_street_number":"67","address_street_box":null,"email":"info@boghossianfoundation.be","website":"http:\/\/www.villaempain.com","phone_contact":"+32 2 627 52 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Franklin Roosevelt, 67","address_line2":"1050 Ixelles","description_web":"\r\nOpening of Villa Empain to the public according to several themes of organised activities and events (exhibitions, concerts, conferences, etc.) from 2010. La Fondation Boghossian has its international office in Villa Empain, on which restoration work began in 2008. With the Stoclet building, constructed by the Austrian architect Josef Hoffmann in 1911, Villa Empain is undoubtedly one of the finest masterpieces of Art Deco architecture in Brussels. In 1930, Baron Louis Empain, then aged 21 years, had this 2,500-metre-square mansion built on the prestigious Avenue des Nations, which was later renamed Avenue Franklin Roosevelt. He entrusted the building of this fine house to the Swiss architect Michel Polak, assisted by his colleague Alfred Hoch. The plan designed for Baron Empain on a 55-acre plot included a monumental villa with four fa\u00e7ades in polished granite, a garden surrounding a swimming pool ornamented with a pergola, and a caretaker's lodge. The modern and luxurious nature of this structure soon aroused enthusiasm and curiosity. It is true that the variety and quality of the materials used (marble, polished granite, bronze, wrought iron, stained-glass windows and precious woods), the sophistication of the details and the coherence of the whole thing with simple but imposing lines immediately contributed to its patrimonial value. \r\n  ","description_print":"A villa in Art Deco style which is now home to the Boghossion Foundation: a centre for art and dialogue between Oriental and Western culture.","booking_url":null,"sort_order":"BOGHOSSIAN FOUNDATION - VILLA EMPAIN","virtual_visit":null,"visit_url":null},"it":{"name":"Fondation Boghossian \u2013 Villa Empain","address_street_name":"Avenue Franklin Roosevelt","address_street_number":"67","address_street_box":null,"email":"info@boghossianfoundation.be","website":"http:\/\/www.villaempain.com","phone_contact":"+32 2 627 52 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Franklin Roosevelt, 67","address_line2":"1050 Ixelles","description_web":"La Villa Empain \u00e8 uno straordinario esempio di architettura Art Deco costruita all'inizio degli anni '30. Oggi ospita il Centro de'Art e Dialogo tra Oriente e Occidente....\r\n\r\nLa Villa Empain \u00e8 uno straordinario esempio di architettura Art Deco costruita all'inizio degli anni '30. Oggi ospita il Centro de'Art e Dialogo tra Oriente e Occidente.\r\nVilla Empain \u00e8 anche la sede internazionale della Fondazione Boghossian, che opera in molti paesi dal 1992.\r\nEdificio classificato dal 2007, \u00e8 stata interamente restaurata seguendo scrupolosamente le strutture originali.\r\n\r\nDa non perdere.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Fondation Boghossian \u2013 Villa Empain","address_street_name":"Avenue Franklin Roosevelt","address_street_number":"67","address_street_box":null,"email":"info@boghossianfoundation.be","website":"http:\/\/www.villaempain.com","phone_contact":"+32 2 627 52 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Franklin Roosevelt, 67","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Fondation Boghossian \u2013 Villa Empain","address_street_name":"Avenue Franklin Roosevelt","address_street_number":"67","address_street_box":null,"email":"info@boghossianfoundation.be","website":"http:\/\/www.villaempain.com","phone_contact":"+32 2 627 52 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Franklin Roosevelt, 67","address_line2":"1050 Ixelles","description_web":" A l'initiative de la Fondation Boghossian, la c\u00e9l\u00e8bre Villa Empain a \u00e9t\u00e9 enti\u00e8rement restaur\u00e9e et a ouvert ses portes au public depuis le 23 avril 2010. Lieu de rencontres et de d\u00e9couvertes, d'\u00e9motions partag\u00e9es et d'\u00e9merveillement, la Villa Empain est aussi un remarquable t\u00e9moin de l'architecture Art D\u00e9co. En 1930, le baron Louis Empain, alors \u00e2g\u00e9 de 21 ans, fit \u00e9riger cet h\u00f4tel particulier de 2500 m2 sur la prestigieuse avenue des Nations qui fut rebaptis\u00e9e plus tard avenue Franklin Roosevelt. C'est \u00e0 l'architecte suisse Michel Polak qu'il confia la construction de cette splendide maison. Le projet con\u00e7u pour le baron Empain sur un terrain de 55 ares comprenait une villa monumentale \u00e0 quatre fa\u00e7ades en granit poli, un jardin entourant une piscine agr\u00e9ment\u00e9e d'une pergola, et une conciergerie. La diversit\u00e9 et la qualit\u00e9 des mat\u00e9riaux utilis\u00e9s (marbre, granit poli, bronze, fer forg\u00e9, vitraux et bois pr\u00e9cieux), le raffinement des d\u00e9tails et la coh\u00e9rence de l'ensemble imposant des lignes simples et imposantes, contribu\u00e8rent d'embl\u00e9e \u00e0 sa valeur patrimoniale.\r\n\r\n \r\n\r\nCette belle demeure situ\u00e9e au coeur de la capitale de l'Europe est devenu un Centre d'Art et de Dialogue entre les cultures d'Orient et d'Occident. Ce centre r\u00e9pond \u00e0 plusieurs objectifs compl\u00e9mentaires: culturels, artistiques, p\u00e9dagogiques, scientifiques, ainsi qu'\u00e0 toutes activit\u00e9s qui peuvent renforcer ce dialogue. C'est dans cet esprit d'ouverture culturelle que la Fondation Boghossian y pr\u00e9sente des expositions prestigieuses, accessibles au public du mardi au dimanche. Toutes les informations utiles sont reprises sur le site internet de la Villa Empain.\r\n\r\n  ","description_print":"Dans la prestigieuse villa Empain, cette fondation vise \u00e0 d\u00e9velopper \u00e0 Bruxelles un centre de cr\u00e9ation et de dialogue entre l\u2019Orient et l\u2019Occident. Une programmation vari\u00e9e d\u2019activit\u00e9s culturelles est pr\u00e9vue pour le public.","booking_url":null,"sort_order":"BOGHOSSIAN FOUNDATION - VILLA EMPAIN","virtual_visit":null,"visit_url":null},"sp":{"name":"Villa Empain, Fundaci\u00f3n Boghossian","address_street_name":"Avenue Franklin Roosevelt","address_street_number":"67","address_street_box":null,"email":"info@boghossianfoundation.be","website":"http:\/\/www.villaempain.com","phone_contact":"+32 2 627 52 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Franklin Roosevelt, 67","address_line2":"1050 Ixelles","description_web":"La Villa Empain es un testigo destacado de la arquitectura Art d\u00e9co.\r\nConstruida a principios de los a\u00f1os 1930 y ubicada en el centro de la capital europea, se ha convertido en un Centro de Arte y de Di\u00e1logo imprescindible.\u00a0\r\n\r\nEs igualmente la sede internacional de la Fundaci\u00f3n Boghossian, que trabaja en distintos pa\u00edses desde el a\u00f1o 1992. Declarado monumento en el a\u00f1o 2007, ha sido restaurando siguiendo los criterios del edificio original.\u00a0A fecha de hoy, alberga diferentes exposiciones y actividades.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Boghossian Stichting - Villa Empain","address_street_name":"Franklin Rooseveltlaan","address_street_number":"67","address_street_box":null,"email":"info@boghossianfoundation.be","website":"http:\/\/www.villaempain.com","phone_contact":"+32 2 627 52 30","phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"Franklin Rooseveltlaan, 67","address_line2":"1050 Elsene","description_web":"De Villa Empain is vanaf 2010 toegankelijk voor het grote publiek. Er worden verschillende activiteiten en evenementen georganiseerd (tentoonstellingen, concerten, conferenties enz.). De stichting Boghossian heeft zijn internationale zetel in de Villa Empain waarvan de restauratiewerkzaamheden in 2008 zijn gestart. Samen met het Paleis Stoclet, gebouwd door de Oostenrijkse architect Josef Hoffmann in 1911, is de Villa Empain zeker een van de mooiste meesterwerken van de art-decoarchitectuur in Brussel. In 1930 liet de toen 21-jarige baron Louis Empain dit bijzondere huis ontwerpen met een oppervlakte van 2.500 vierkante meter, gelegen op de Natielaan (later de Franklin Rooseveltlaan). De bouw van dit prachtige huis vertrouwde hij toe aan de Zwitserse architect Michel Polak, bijgestaan door zijn medewerker Alfred Hoch. Het project dat voor Baron Empain werd uitgedacht op een terrein van 55 are, bestaat uit een grote villa met vier gevels in gepolijst graniet, een tuin met een zwembad, een pergola en een portierswoning. Het moderne en luxueuze karakter van deze constructie wekte al heel snel enthousiasme en nieuwsgierigheid op. De verscheidenheid, de kwaliteit van de gebruikte materialen (marmer, gepolijst graniet, brons, gietijzer en fijne houtsoorten), de verfijnde details en de harmonie van het geheel, de eenvoudige, maar indrukwekkende lijnen? Dit alles zou meteen bijdragen tot de waarde van de villa ","description_print":"Een centrum voor kunst en dialoog tussen de oosterse en de westerse cultuur . E\u00e9n van de belangrijkste doelstellingen van de Boghossian-stichting is het oprichten van een centrum van culturele en artistieke dialoog tussen het Oosten en het Westen. Haar uitvalsbasis is de prestigieuze villa Empain, waarin ze allerhande culturele activiteiten organiseert voor het publiek.","booking_url":null,"sort_order":"BOGHOSSIAN FOUNDATION - VILLA EMPAIN","virtual_visit":null,"visit_url":null}},"neca":"art_center","facebook_id":null,"region":"brussels","backoffice_id":10918,"location":{"lat":50.80750954,"lon":4.38436842},"last_updated_at":"2024-06-14T16:26:02+02:00","published_at":"2013-10-19T01:29:22+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/aac404d29c1b35893f049e9ce4f534c142bf7753.jpg","width":3000,"height":3671,"ratio":0.82,"oEmbed_height":3671,"oEmbed_width":3000,"translations":{"de":{"title":"Octave, 1983","copyright":"Alechinsky"},"pt":{"title":"Octave, 1983","copyright":"Alechinsky"},"en":{"title":"Octave, 1983","copyright":"Alechinsky"},"it":{"title":"Octave, 1983","copyright":"Alechinsky"},"cn":{"title":"Octave, 1983","copyright":"Alechinsky"},"fr":{"title":"Octave, 1983","copyright":"Alechinsky"},"sp":{"title":"Octave, 1983","copyright":"Alechinsky"},"nl":{"title":"Octave, 1983","copyright":"Alechinsky"}}}],"dates":[{"day":"2024-09-26","doors":null,"start":"11:00:00","end":"18:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-09-27","doors":null,"start":"11:00:00","end":"18:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-09-28","doors":null,"start":"11:00:00","end":"18:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-09-29","doors":null,"start":"11:00:00","end":"18:00:00","end_night_life":null,"is_soldout"