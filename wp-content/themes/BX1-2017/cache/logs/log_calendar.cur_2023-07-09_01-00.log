y and sunday: from 10:30 to 18:00"],"pt":["monday, tuesday, wednesday, thursday and friday: closed","saturday and sunday: from 10:30 to 18:00"],"cn":["monday, tuesday, wednesday, thursday and friday: closed","saturday and sunday: from 10:30 to 18:00"]},"date_start":"2023-06-01","date_end":"2023-07-25","is_also_by_appointment":true}],"date_exceptions":[{"day":"2023-06-01","start":"18:00:00","end":"21:00:00"}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"},"de":{"name":"Normal"},"it":{"name":"Normale"},"sp":{"name":"Normal"},"pt":{"name":"Normal"},"cn":{"name":"Normal"}},"value":0}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"opening":{"day":"2023-06-01","start":"18:00:00","timestamp":"2023-06-01T18:00:00+02:00","end":"21:00:00","is_only_by_appointment":false},"tags":[],"accessibilities":{"list":[255,263],"translations":{"fr":["Accessible","Accessible aux pi\u00e9tons appareill\u00e9s"],"nl":["Toegankelijk","Toegankelijk voor voetgangers met hulpmiddelen"],"en":["Accessible","Accessible to pedestrians with mobility aids"],"de":["Barrierefrei","Barrierefrei f\u00fcr Fu\u00dfg\u00e4nger mit Gehhilfe"],"it":["Accessibile","Accessibile ai pedoni con supporti"],"sp":["Habilitado","Habilitado para peatones con aud\u00edfonos"],"pt":[null,null],"cn":[null,null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2023-07-03T03:05:46+02:00","published_at":"2023-05-26T09:52:56+02:00","backoffice_id":277856,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.26295358943293},{"id":545586,"date_start":"2023-06-10","date_end":"2023-10-01","date_next":"2023-07-08","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung","it":"Esposizioni","sp":"Exhibici\u00f3n","pt":null,"cn":null}},"others":{"list":[36,41],"translations":{"fr":["Mus\u00e9es et art centers","Installation, performance"],"nl":["Musea en kunstcentra","Installatie, performance"],"en":["Museums and art centers","Installation, performance"],"de":["Museen & Kunstzentren","Installation, Performance"],"it":["Musei e centri artistici","Installazioni, performance"],"sp":["Museos y centros de arte","Instalaci\u00f3n, performance"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Arabesque, quand le cirque contemporain interpr\u00e8te l'Art Nouveau","shortdescr":"Exposition puridisciplinaire, Hommage \u00e0 l\u2019Art Nouveau et au Cirque Contemporain Bruxellois.","longdescr":"Sous la direction artistique de la compagnie acrobatique bruxelloise Back Pocket, en collaboration avec l\u2019artiste photographe Zenzel, et, avec la participation des \u00e9tudiants de l\u2019ESAC (Ecole Sup\u00e9rieure des Arts du cirque de Bruxelles), \u00ab ARABESQUE \u00bb est un projet qui propose une r\u00e9interpr\u00e9tation de l\u2019architecture bruxelloise Art nouveau par les arts du cirque et les arts acrobatiques. \r\nCette exposition pluridisciplinaire rythm\u00e9e par des \u0153uvres photographiques, de la vid\u00e9o et des performances se veut \u00e9minemment contemporaine, vivante. Port\u00e9e par la jeunesse, elle am\u00e8ne les publics \u00e0 poser un autre regard sur le courant Art nouveau.\r\nComment les arts du cirque et l\u2019Art nouveau se r\u00e9pondent-ils? \r\nComment le cirque contemporain peut-il mettre en lumi\u00e8re les b\u00e2timents Art nouveau, leurs courbes, leurs sinuosit\u00e9s pour nous inviter \u00e0 red\u00e9couvrir le patrimoine architectural ? \r\nComment, \u00e0 l\u2019inverse, l\u2019Art nouveau peut-il mettre en exergue la corporalit\u00e9 du circassien ?","performers":"ARABESQUE est un projet port\u00e9 par Back Pocket en collaboration avec Zenzel, co-produit par les Halles Saint-G\u00e9ry. \r\nSoutenu par l\u2019ESAC, la R\u00e9gion de Bruxelles-Capitale, la ville de Bruxelles, la Loterie Nationale et ses joueurs, CultureMoves Europe.","boxoffice_url":null,"website":"http:\/\/www.hallessaintgery.be","email":"info@hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":"+32 2 502 44 24","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.545586"},"nl":{"name":"Arabesque, wanneer het hedendaagse circus Art Nouveau interpreteert","shortdescr":"Een zuiver disciplinaire tentoonstelling, een eerbetoon aan de Art Nouveau en het Brussels Contemporary Circus.","longdescr":"Onder de artistieke leiding van het Brusselse acrobatengezelschap Back Pocket, in samenwerking met fotokunstenaar Zenzel en met de deelname van studenten van de ESAC (Ecole Sup\u00e9rieure des Arts du Cirque de Bruxelles), is \"ARABESQUE\" een project dat een herinterpretatie van de Brusselse Art Nouveau-architectuur voorstelt via de circus- en acrobatische kunsten. \r\nDeze multidisciplinaire tentoonstelling, doorspekt met fotowerken, video en performances, is uiterst hedendaags en levendig. Onder impuls van jongeren laat ze het publiek op een andere manier naar de Art Nouveau kijken.\r\nHoe werken de circuskunsten en de Art Nouveau op elkaar in? \r\nHoe kan het hedendaagse circus de Art Nouveau-gebouwen, hun rondingen en sinuositeit benadrukken en ons uitnodigen het architecturale erfgoed te herontdekken? \r\nHoe, omgekeerd, kan Art Nouveau de lichamelijkheid van de circusartiest benadrukken?","performers":"ARABESQUE is een project van Back Pocket in samenwerking met Zenzel, gecoproduceerd door Halles Saint-G\u00e9ry. \r\nGesteund door ESAC, het Brussels Hoofdstedelijk Gewest, de Stad Brussel, de Nationale Loterij en haar spelers, CultureMoves Europe.","boxoffice_url":null,"website":"http:\/\/www.hallessaintgery.be","email":"info@hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":"+32 2 502 44 24","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.545586"},"en":{"name":"Arabesque, when the contemporary circus interprets Art Nouveau","shortdescr":"Puridisciplinary exhibition, a tribute to Art Nouveau and the Brussels Contemporary Circus.","longdescr":"Under the artistic direction of the Brussels acrobatic company Back Pocket, in collaboration with the photographic artist Zenzel, and with the participation of students from ESAC (Ecole Sup\u00e9rieure des Arts du Cirque de Bruxelles), \"ARABESQUE\" is a project that proposes a reinterpretation of the Brussels Art Nouveau architecture through circus and acrobatic arts. \r\nThis multidisciplinary exhibition, punctuated by photographic works, video and performances, is eminently contemporary and lively. The exhibition is driven by young people and leads the public to take a different look at the Art Nouveau movement.\r\nHow do the circus arts and Art Nouveau interact? \r\nHow can the contemporary circus highlight Art Nouveau buildings, their curves, their sinuosities, and invite us to rediscover the architectural heritage? \r\nHow, conversely, can Art Nouveau highlight the physicality of the circus artist?","performers":"ARABESQUE is a project by Back Pocket in collaboration with Zenzel, co-produced by Halles Saint-G\u00e9ry. \r\nSupported by ESAC, the Brussels-Capital Region, the City of Brussels, the National Lottery and its players, CultureMoves Europe.","boxoffice_url":null,"website":"http:\/\/www.hallessaintgery.be","email":"info@hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":"+32 2 502 44 24","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.545586"},"de":{"name":"Arabesque, quand le cirque contemporain interpr\u00e8te l'Art Nouveau","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.hallessaintgery.be","email":"info@hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":"+32 2 502 44 24","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.545586"},"it":{"name":"Arabesque, quand le cirque contemporain interpr\u00e8te l'Art Nouveau","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.hallessaintgery.be","email":"info@hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":"+32 2 502 44 24","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.545586"},"sp":{"name":"Arabesque, quand le cirque contemporain interpr\u00e8te l'Art Nouveau","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.hallessaintgery.be","email":"info@hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":"+32 2 502 44 24","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.545586"},"pt":{"name":"Arabesque, quand le cirque contemporain interpr\u00e8te l'Art Nouveau","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.hallessaintgery.be","email":"info@hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":"+32 2 502 44 24","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.545586"},"cn":{"name":"Arabesque, quand le cirque contemporain interpr\u00e8te l'Art Nouveau","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.hallessaintgery.be","email":"info@hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":"+32 2 502 44 24","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.545586"}},"place":{"id":247371,"translations":{"fr":{"name":"Halles Saint-G\u00e9ry","address_street_name":"Place Saint-G\u00e9ry","address_street_number":null,"address_street_box":null,"email":"accueil@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Saint-G\u00e9ry","address_line2":"1000 Bruxelles","description_web":"Remarquable t\u00e9moin de l\u2019architecture des march\u00e9s couverts, les Halles Saint-G\u00e9ry  contribuent \u00e0 valoriser le patrimoine de la R\u00e9gion de Bruxelles-Capitale. Centre d\u2019exposition et de manifestation bas\u00e9 en plein coeur du pentagone, elles ont pour vocation de mettre en valeur les traits de d\u00e9marcation du cadre de vie bruxellois et de son identit\u00e9 urbaine par le biais d'une programmation hybride, allant des expositions, aux conf\u00e9rences, concerts, rencontres et performances \u2026\r\nLe Centre Urbain (guichet d\u2019information r\u00e9gional, pour mieux vous conseiller sur l\u2019habitat durable en R\u00e9gion de Bruxelles-Capitale) est \u00e9galement situ\u00e9 au sein des Halles.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Sint-Gorikshallen","address_street_name":"Sint-Goriksplein","address_street_number":null,"address_street_box":null,"email":"accueil@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Sint-Goriksplein","address_line2":"1000 Brussel","description_web":"De Sint-Gorikshallen zijn een prachtig architecturaal staaltje van openbare markthallen in het 19de-eeuwse Brussel. Het gebouw werd een aantal jaren geleden volledig gerestaureerd en doet tegenwoordig dienst als permanente informatie-, tentoonstellings- en evenementenruimte gewijd aan het erfgoed en de levenswijzen in de hoofdstad. Op amper twee minuten stappen van de Beurs vormen de Sint-Gorikshallen een gezellige plek om te ontspannen en nieuwe dingen te ontdekken, zowel overdag als bij het vallen van de nacht.\r\nDe hallen herbergen ook de Stadswinkel, een vereniging die de inwoners van het Brussels Hoofdstedelijk Gewest  wil informeren over het leefmilieu en een kwaliteitsvolle leefomgeving, huisvesting, stadsrenovatie, stedenbouw en ruimtelijke ordening, en rationeel energiegebruik. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Halles Saint-G\u00e9ry","address_street_name":"Place Saint-G\u00e9ry","address_street_number":null,"address_street_box":null,"email":"accueil@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Place Saint-G\u00e9ry","address_line2":"1000 Brussels","description_web":"The Saint-G\u00e9ry Market Halls are a fine architectural example of 19th-century public markets in Brussels. The building was completely restored several years ago and is now a permanent information and exhibition space, with urban planning, heritage, and urban renewal as its central themes.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Halles Saint-G\u00e9ry","address_street_name":"Place Saint-G\u00e9ry","address_street_number":null,"address_street_box":null,"email":"accueil@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Saint-G\u00e9ry","address_line2":"1000 Bruxelles","description_web":"Die Halles Saint-G\u00e9ry mit ihrer eklektischen Architektur wurden Ende des 19. Jahrhundert als Markthalle erbaut und spielten in der Br\u00fcsseler Stadtgeschichte eine wichtige Rolle.\r\n\r\nDie Saint-G\u00e9ry-Hallen waren einerseits sowohl legend\u00e4re als auch kaufm\u00e4nnische Wiege der Stadt. Ab dem 11. Jahrhundert stand an dieser Stelle eine dem Heiligen Saint-G\u00e9ry gewidmete Kapelle. Verschiedene Wohnh\u00e4user waren hier entstanden und aufgrund der N\u00e4he zur Senne entwickelten sich zahlreiche Aktivit\u00e4ten.\r\n\r\nIm 16. Jahrhundert erhielt die Kapelle den Status einer Pfarrkirche, die prachtvoll im gotischen Stil erweitert wurde, dann aber im Zuge der Franz\u00f6sische Revolution dem Erdboden gleichgemacht wurde.\r\n\r\nDer ehemalige Markt - und sogar das gesamte Saint-G\u00e9ry-Viertel \u2013 waren ihrerseits in den 1960er-Jahren von der Zerst\u00f6rung bedroht, bis das Viertel in den 1990er-Jahren eine Art zweiten Fr\u00fchling erlebte. Seit 1999 fungieren die Saint-G\u00e9ry-Hallen als Informations- und Ausstellungszentrum rund um die Br\u00fcsseler Stadtgeschichte und das st\u00e4dtische Leben in Br\u00fcssel. An der Bar gibt es Getr\u00e4nke und Speisen.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Halle di Saint-Gery","address_street_name":"Place Saint-G\u00e9ry","address_street_number":null,"address_street_box":null,"email":"accueil@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Saint-G\u00e9ry","address_line2":"1000 Bruxelles","description_web":"Le Halles Saint-G\u00e9ry (mercato coperto) ospitano un centro d'informazione dedicato al patrimonio e al quadro di vita dei Bruxellesi...\r\nLe Halles Saint-G\u00e9ry (mercato coperto) ospitano un centro d'informazione dedicato al patrimonio e al quadro di vita dei Bruxellesi. Sotto il patrocinio della regione di Bruxelles Capitale.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Halles Saint-G\u00e9ry","address_street_name":"Place Saint-G\u00e9ry","address_street_number":null,"address_street_box":null,"email":"accueil@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Saint-G\u00e9ry","address_line2":"1000 Bruxelles","description_web":"Verdadero testigo de los mercados cubiertos, las Halles Saint-G\u00e9ry albergan un centro de informaci\u00f3n, bajo la \u00e9gida de la Regio\u00f3n de Bruselas Capital y dedicado al patrimonio...\r\nVerdadero testigo de los mercados cubiertos, las Halles Saint-G\u00e9ry albergan un centro de informaci\u00f3n, bajo la \u00e9gida de la Regio\u00f3n de Bruselas Capital y dedicado al patrimonio y al marco de vida de los bruselenses.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Halles Saint-G\u00e9ry","address_street_name":"Place Saint-G\u00e9ry","address_street_number":null,"address_street_box":null,"email":"accueil@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Saint-G\u00e9ry","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Halles Saint-G\u00e9ry","address_street_name":"Place Saint-G\u00e9ry","address_street_number":null,"address_street_box":null,"email":"accueil@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Saint-G\u00e9ry","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[3],"translations":{"fr":["Dansaert\/Sainte-Catherine"],"nl":["Dansaertwijk\/Sint-Katelijne"],"en":["Dansaert\/Sainte-Catherine"],"de":["Dansaert\/Sainte-Catherine"],"it":["Dansaert\/Sainte-Catherine"],"sp":["Dansaert\/Sainte-Catherine"],"pt":[null],"cn":[null]}},"zones":{"list":[19],"translations":{"fr":["Centre"],"nl":["Centrum"],"en":["Centre"],"de":["Zentrum"],"it":["Centro"],"sp":["Centro"],"pt":[null],"cn":[null]}},"neca":null,"facebook_id":null,"backoffice_id":9562,"location":{"lat":50.84801328,"lon":4.34683241},"region":"brussels","last_updated_at":"2023-07-08T02:38:08+02:00","published_at":"2013-10-19T01:26:22+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":247371,"translations":{"fr":{"name":"Halles Saint-G\u00e9ry","address_street_name":"Place Saint-G\u00e9ry","address_street_number":null,"address_street_box":null,"email":"accueil@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Saint-G\u00e9ry","address_line2":"1000 Bruxelles","description_web":"Remarquable t\u00e9moin de l\u2019architecture des march\u00e9s couverts, les Halles Saint-G\u00e9ry  contribuent \u00e0 valoriser le patrimoine de la R\u00e9gion de Bruxelles-Capitale. Centre d\u2019exposition et de manifestation bas\u00e9 en plein coeur du pentagone, elles ont pour vocation de mettre en valeur les traits de d\u00e9marcation du cadre de vie bruxellois et de son identit\u00e9 urbaine par le biais d'une programmation hybride, allant des expositions, aux conf\u00e9rences, concerts, rencontres et performances \u2026\r\nLe Centre Urbain (guichet d\u2019information r\u00e9gional, pour mieux vous conseiller sur l\u2019habitat durable en R\u00e9gion de Bruxelles-Capitale) est \u00e9galement situ\u00e9 au sein des Halles.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Sint-Gorikshallen","address_street_name":"Sint-Goriksplein","address_street_number":null,"address_street_box":null,"email":"accueil@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Sint-Goriksplein","address_line2":"1000 Brussel","description_web":"De Sint-Gorikshallen zijn een prachtig architecturaal staaltje van openbare markthallen in het 19de-eeuwse Brussel. Het gebouw werd een aantal jaren geleden volledig gerestaureerd en doet tegenwoordig dienst als permanente informatie-, tentoonstellings- en evenementenruimte gewijd aan het erfgoed en de levenswijzen in de hoofdstad. Op amper twee minuten stappen van de Beurs vormen de Sint-Gorikshallen een gezellige plek om te ontspannen en nieuwe dingen te ontdekken, zowel overdag als bij het vallen van de nacht.\r\nDe hallen herbergen ook de Stadswinkel, een vereniging die de inwoners van het Brussels Hoofdstedelijk Gewest  wil informeren over het leefmilieu en een kwaliteitsvolle leefomgeving, huisvesting, stadsrenovatie, stedenbouw en ruimtelijke ordening, en rationeel energiegebruik. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Halles Saint-G\u00e9ry","address_street_name":"Place Saint-G\u00e9ry","address_street_number":null,"address_street_box":null,"email":"accueil@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Place Saint-G\u00e9ry","address_line2":"1000 Brussels","description_web":"The Saint-G\u00e9ry Market Halls are a fine architectural example of 19th-century public markets in Brussels. The building was completely restored several years ago and is now a permanent information and exhibition space, with urban planning, heritage, and urban renewal as its central themes.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Halles Saint-G\u00e9ry","address_street_name":"Place Saint-G\u00e9ry","address_street_number":null,"address_street_box":null,"email":"accueil@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Saint-G\u00e9ry","address_line2":"1000 Bruxelles","description_web":"Die Halles Saint-G\u00e9ry mit ihrer eklektischen Architektur wurden Ende des 19. Jahrhundert als Markthalle erbaut und spielten in der Br\u00fcsseler Stadtgeschichte eine wichtige Rolle.\r\n\r\nDie Saint-G\u00e9ry-Hallen waren einerseits sowohl legend\u00e4re als auch kaufm\u00e4nnische Wiege der Stadt. Ab dem 11. Jahrhundert stand an dieser Stelle eine dem Heiligen Saint-G\u00e9ry gewidmete Kapelle. Verschiedene Wohnh\u00e4user waren hier entstanden und aufgrund der N\u00e4he zur Senne entwickelten sich zahlreiche Aktivit\u00e4ten.\r\n\r\nIm 16. Jahrhundert erhielt die Kapelle den Status einer Pfarrkirche, die prachtvoll im gotischen Stil erweitert wurde, dann aber im Zuge der Franz\u00f6sische Revolution dem Erdboden gleichgemacht wurde.\r\n\r\nDer ehemalige Markt - und sogar das gesamte Saint-G\u00e9ry-Viertel \u2013 waren ihrerseits in den 1960er-Jahren von der Zerst\u00f6rung bedroht, bis das Viertel in den 1990er-Jahren eine Art zweiten Fr\u00fchling erlebte. Seit 1999 fungieren die Saint-G\u00e9ry-Hallen als Informations- und Ausstellungszentrum rund um die Br\u00fcsseler Stadtgeschichte und das st\u00e4dtische Leben in Br\u00fcssel. An der Bar gibt es Getr\u00e4nke und Speisen.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Halle di Saint-Gery","address_street_name":"Place Saint-G\u00e9ry","address_street_number":null,"address_street_box":null,"email":"accueil@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Saint-G\u00e9ry","address_line2":"1000 Bruxelles","description_web":"Le Halles Saint-G\u00e9ry (mercato coperto) ospitano un centro d'informazione dedicato al patrimonio e al quadro di vita dei Bruxellesi...\r\nLe Halles Saint-G\u00e9ry (m