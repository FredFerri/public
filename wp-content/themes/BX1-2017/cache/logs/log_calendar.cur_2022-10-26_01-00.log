campa\u00f1as. Posee un centro de recursos para profesionales de industrias culturales y sectores relacionados, junto con espacios de trabajo adaptados, lugares de reuni\u00f3n, talleres, seminarios y un gran espacio dedicado a actividades p\u00fablicas donde se organizan diversos eventos cada a\u00f1o: exhibiciones, desfiles de moda, representaciones art\u00edsticas\u2026\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"MAD \u2013 Home of Creators","address_street_name":"Place du Nouveau March\u00e9 aux Grains","address_street_number":"10","address_street_box":null,"email":"contact@mad.brussels","website":"http:\/\/www.mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":"+32 2 880 85 62","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place du Nouveau March\u00e9 aux Grains, 10","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"MAD \u2013 Home of Creators","address_street_name":"Place du Nouveau March\u00e9 aux Grains","address_street_number":"10","address_street_box":null,"email":"contact@mad.brussels","website":"http:\/\/www.mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":"+32 2 880 85 62","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place du Nouveau March\u00e9 aux Grains, 10","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":null,"facebook_id":null,"backoffice_id":12629,"location":{"lat":50.85116098,"lon":4.34417688},"region":"brussels","last_updated_at":"2022-10-24T01:36:54+02:00","published_at":"2013-10-19T01:34:31+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/1882821cb6c70aec6e0e194099feff39cbbc32f9.jpg","width":3750,