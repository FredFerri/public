,"end_night_life":"06:00:00","is_soldout":false,"is_canceled":false}],"prices":[],"date_exceptions":[],"closing_days":[],"child_events":[],"parent_events":[],"accessibilities":[],"recurring":[],"targets":{"list":[12],"translations":{"de":["LGTBQIA"],"pt":[null],"en":["LGTBQIA"],"it":["LGTBQIA"],"cn":[null],"fr":["LGTBQIA"],"sp":["LGTBQIA"],"nl":["LGTBQIA"]}},"educational_targets":{"list":[],"translations":{}},"tags":[]},{"id":50006050,"date_start":"2024-01-26","date_end":"2024-01-26","date_next":"2024-01-26","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-01-13T10:30:43+01:00","published_at":"2024-01-13T10:17:15+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":292394,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"concert","ranking":1,"languages":{"spoken":["nl","fr","en"],"subtitles":[]},"categories":{"main":{"id":1,"translations":{"de":"Konzert","pt":null,"en":"Concert","it":"Concerti","cn":null,"fr":"Concert","sp":"Concierto","nl":"Concert"}},"others":{"list":[2],"translations":{"de":["Klassisch"],"pt":[null],"en":["Classical"],"it":["Classica"],"cn":[null],"fr":["Classique"],"sp":["Cl\u00e1sica"],"nl":["Klassiek"]}}},"translations":{"de":{"name":"Belgian Romantics","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.clame.be","email":"us@clame.be","phone_contact":"+32 484 57 10 83","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50006050"},"pt":{"name":"Belgian Romantics","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.clame.be","email":"us@clame.be","phone_contact":"+32 484 57 10 83","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50006050"},"en":{"name":"Belgian Romantics","shortdescr":"Clame is delighted to invite you to a rare delight and welcome you to the concert of \u201cBelgian Romantics\u201d by Merve Mersinligil, piano and Ardashes Agoshian, double bass.At this exceptional concert, you can discover the beauty of Belgian romantic composers such as Ysa\u00ffe, Vieuxtemps, and Franck. This musical evening will begin with a short recital by Nicolas Nour, a 13 years old pianist.","longdescr":"Friday, January 26, 2024\nCharlier Museum, avenue des Arts 16, B 1210 (Arts-Loi metro station)\n6.30 p.m.: welcome drink and discovery of the museum.\n7:30 p.m.: concert (museum doors close at 7:45 p.m.)\n9:30 p.m.: end of the musical evening\n\n \n\nContinuing its 11th season, Clame is delighted to invite you to a rare delight and welcome you to the concert of \u201cBelgian Romantics\u201d by Merve Mersinligil, piano and Ardashes Agoshian, double bass.\n\nMusical partnership and friendship of two internationally acclaimed musicians is a result of an unexpected crossing of paths in Istanbul many years ago, which has continued to flourish ever since. At this exceptional concert, you can discover the beauty of Belgian romantic composers such as Ysa\u00ffe, Vieuxtemps, and Franck. This musical evening will begin with a short recital by Nicolas Nour, a 13 years old pianist.\n\nPlease feel free to share this concert announcement with your music-loving friends. As the number of seats is limited, we recommend you to book your tickets online.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.clame.be","email":"us@clame.be","phone_contact":"+32 484 57 10 83","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50006050"},"it":{"name":"Belgian Romantics","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.clame.be","email":"us@clame.be","phone_contact":"+32 484 57 10 83","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50006050"},"cn":{"name":"Belgian Romantics","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.clame.be","email":"us@clame.be","phone_contact":"+32 484 57 10 83","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50006050"},"fr":{"name":"Romantisme Belge","shortdescr":"Clame a le plaisir de vous inviter \u00e0 un plaisir rare et de vous souhaiter la bienvenue au concert \"Belgian Romantics\" de Merve Mersinligil, piano et Ardashes Agoshian, contrebasse.\nLors de ce concert exceptionnel, vous pourrez d\u00e9couvrir les compositeurs romantiques belges tels qu'Ysa\u00ffe, Vieuxtemps et Franck. Cette soir\u00e9e musicale d\u00e9butera par un court r\u00e9cital de Nicolas Nour, pianiste de 13 ans.","longdescr":"Vendredi 26 Janvier 2024\nMus\u00e9e Charlier, avenue des Arts 16, B 1210 (m\u00e9tro Arts-Loi)\n18h30 : verre d\u2019accueil et d\u00e9couverte du mus\u00e9e\n19h30 : concert (les portes du mus\u00e9e ferment \u00e0 19h45)\n21h30 : fin de la soir\u00e9e musicale\n\n\nDans le cadre de sa 11e saison, Clame a le plaisir de vous inviter \u00e0 un plaisir rare et de vous souhaiter la bienvenue au concert \"Belgian Romantics\" de Merve Mersinligil, piano et Ardashes Agoshian, contrebasse.\n\nLe partenariat musical et l'amiti\u00e9 de deux musiciens de renomm\u00e9e internationale sont le r\u00e9sultat d'une rencontre inattendue \u00e0 Istanbul il y a de nombreuses ann\u00e9es, qui n'a cess\u00e9 de s'\u00e9panouir depuis. Lors de ce concert exceptionnel, vous pourrez d\u00e9couvrir la beaut\u00e9 des compositeurs romantiques belges tels qu'Ysa\u00ffe, Vieuxtemps et Franck. Cette soir\u00e9e musicale d\u00e9butera par un court r\u00e9cital de Nicolas Nour, pianiste de 13 ans.\n\nN'h\u00e9sitez pas \u00e0 partager cette annonce de concert avec vos amis m\u00e9lomanes. Le nombre de places \u00e9tant limit\u00e9, nous vous recommandons de r\u00e9server vos billets en ligne.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.clame.be","email":"us@clame.be","phone_contact":"+32 484 57 10 83","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50006050"},"sp":{"name":"Belgian Romantics","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.clame.be","email":"us@clame.be","phone_contact":"+32 484 57 10 83","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50006050"},"nl":{"name":"Belgische Romantiek","shortdescr":"Clame verheugd u uit te nodigen voor een zeldzame traktatie en u welkom te heten op het concert \"Belgian Romantics\" van Merve Mersinligil, piano en Ardashes Agoshian, contrabas. In dit uitzonderlijke concert kun je de schoonheid van Belgische romantische componisten als Ysa\u00ffe, Vieuxtemps en Franck ontdekken. Deze muzikale avond begint met een kort recital van de 13-jarige pianist Nicolas Nour.\n","longdescr":"Vrijdag 26 Januari 2024\nCharlier Museum, Kunstlaan 16, B 1210 (metrostation Kunst-Wet)\n18.30 uur: welkomstdrankje en ontdekking van het museum\n19.30 uur: concert (de deuren van het museum sluiten om 19.45 uur)\n21.30 uur: einde van de muzikale avond\n\n \n\nIn het kader van zijn 11e seizoen is Clame verheugd u uit te nodigen voor een zeldzame traktatie en u welkom te heten op het concert \"Belgian Romantics\" van Merve Mersinligil, piano en Ardashes Agoshian, contrabas.\n\nDe muzikale samenwerking en vriendschap tussen deze twee internationaal gerenommeerde musici is het resultaat van een onverwachte ontmoeting in Istanbul vele jaren geleden, die sindsdien is blijven bloeien. In dit uitzonderlijke concert kun je de schoonheid van Belgische romantische componisten als Ysa\u00ffe, Vieuxtemps en Franck ontdekken. Deze muzikale avond begint met een kort recital van de 13-jarige pianist Nicolas Nour.\n\nAarzel niet om deze concertaankondiging te delen met je muziekminnende vrienden. Omdat het aantal plaatsen beperkt is, raden we je aan je tickets online te reserveren.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.clame.be","email":"us@clame.be","phone_contact":"+32 484 57 10 83","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50006050"}},"place":{"id":252302,"translations":{"de":{"name":"CLAME asbl","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":"us@clame.be","website":"http:\/\/www.clame.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"CLAME asbl","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"CLAME asbl","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":"us@clame.be","website":"http:\/\/www.clame.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"CLAME asbl","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"CLAME asbl","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":"us@clame.be","website":"http:\/\/www.clame.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"CLAME asbl","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"CLAME asbl","address_street_name":null,"address_street_number":null,"addre