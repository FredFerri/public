s_high_capacity":false,"is_not_major_event":false,"backoffice_id":303116,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"concert","ranking":1.8171205928321397,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":1,"translations":{"de":"Konzert","pt":null,"en":"Concert","it":"Concerti","cn":null,"fr":"Concert","sp":"Concierto","nl":"Concert"}},"others":{}},"translations":{"de":{"name":"Blackout Session - Moondog: Snaketime Series (1956)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/atelier210.be\/saisons\/saison-24-25\/blackout-session\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50011962"},"pt":{"name":"Blackout Session - Moondog: Snaketime Series (1956)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/atelier210.be\/saisons\/saison-24-25\/blackout-session\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50011962"},"en":{"name":"Blackout Session - Moondog: Snaketime Series (1956)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/atelier210.be\/saisons\/saison-24-25\/blackout-session\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50011962"},"it":{"name":"Blackout Session - Moondog: Snaketime Series (1956)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/atelier210.be\/saisons\/saison-24-25\/blackout-session\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50011962"},"cn":{"name":"Blackout Session - Moondog: Snaketime Series (1956)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/atelier210.be\/saisons\/saison-24-25\/blackout-session\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50011962"},"fr":{"name":"Blackout Session - Moondog: Snaketime Series (1956)","shortdescr":"La formule est simple : un disque \u00e0 \u00e9couter en entier et dans l\u2019obscurit\u00e9 totale. Le seule crit\u00e8re de s\u00e9lection : un album solide de bout en bout.\n\nDisque du jour: Moondog - Snaketime Series (1953)","longdescr":"La formule est simple : un disque \u00e0 \u00e9couter en entier et dans l\u2019obscurit\u00e9 totale. Le seule crit\u00e8re de s\u00e9lection : un album solide de bout en bout. Une fois par mois, ou presque. C\u2019est gratuit, sans r\u00e9servation. Par contre, on vous pr\u00e9vient, il n\u2019y a pas toujours de place pour tout le monde, donc ne venez pas trop tard. La team bar est l\u00e0 pour vous accueillir en musique. Toute entr\u00e9e est impossible apr\u00e8s le lancement du disque et le bar est ferm\u00e9 durant l\u2019\u00e9coute, qu\u2019on se le dise. Programmation et introduction par Xavier Daive alias Funky Bompa.\n\nDisque du jour: Moondog - Snaketime Series (1953)\nMoondog a \u00e9t\u00e9 \u00ab red\u00e9couvert \u00bb avec enthousiasme il y a quelques temps d\u00e9j\u00e0. Cet artiste fantasque et po\u00e8te c\u00e9leste nous emporte dans ses compositions douces, d\u00e9pouill\u00e9es, habit\u00e9es et exp\u00e9rimentales. La musique sur cet opus, auto-produit puis repris par l\u2019exigeante maison d\u2019\u00e9dition Prestige, est profonde et enivrante. Lions, oiseaux, percussions traditionnelles, instruments de pays lointains, piano classique\u2026 L\u2019aventure est cin\u00e9matique. \u00c0 vivre absolument.\n\nStyle : jazz classique experimental traditionnel\nAnn\u00e9e : 1957\nDur\u00e9e : 30:13\nLabel : auto-produit\/Prestige\nPays : USA\n\nDepuis l'\u00e9t\u00e9 2023, nous avons le plaisir de collaborer avec \n- Point Culture\n- La Biblioth\u00e8que Herg\u00e9 (Etterbeek)\n\nEnsemble, et pour chacune des Blackout Session, vous trouverez: \n- la cr\u00e9ation d\u2019une m\u00e9diagraphie (online et en print disponible le soir m\u00eame \u00e0 l'atelier 210) en lien avec le disque programm\u00e9, \n- une m\u00e9diastation \u00e0 l'atelier 210 pr\u00e9sentant une s\u00e9lection de livres, cd et dvd ;\n- ces m\u00e9dias sont disponibles \u00e0 l\u2019emprunt le soir-m\u00eame \u00e0 l'atelier 210, les retours sont possibles soit \u00e0 la Biblioth\u00e8que Herg\u00e9, soit \u00e0 la session suivante chez nous.","performers":null,"boxoffice_url":null,"website":"https:\/\/atelier210.be\/saisons\/saison-24-25\/blackout-session\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50011962"},"sp":{"name":"Blackout Session - Moondog: Snaketime Series (1956)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/atelier210.be\/saisons\/saison-24-25\/blackout-session\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50011962"},"nl":{"name":"Blackout Session - Moondog: Snaketime Series (1956)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/atelier210.be\/saisons\/saison-24-25\/blackout-session\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50011962"}},"place":{"id":241923,"translations":{"de":{"name":"Atelier 210","address_street_name":"Chauss\u00e9e Saint-Pierre","address_street_number":"210","address_street_box":null,"email":"info@atelier210.be","website":"http:\/\/www.atelier210.be","phone_contact":"+32 2 732 25 98","phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Chauss\u00e9e Saint-Pierre, 210","address_l