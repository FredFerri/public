ed_at":"2024-05-14T15:10:43+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":true,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":300193,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"party","ranking":0.2705429412981873,"languages":{"spoken":["nl","fr","en"],"subtitles":[]},"categories":{"main":{"id":57,"translations":{"de":"Clubbing","pt":null,"en":"Clubbing","it":"Locali notturni","cn":null,"fr":"Clubbing","sp":"Ir de discoteca","nl":"Clubbing"}},"others":{}},"translations":{"de":{"name":"Circle Park Summercamp","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.instagram.com\/circleparkbrussels\/","email":"alexia@saltandpepper.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50010655"},"pt":{"name":"Circle Park Summercamp","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.instagram.com\/circleparkbrussels\/","email":"alexia@saltandpepper.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50010655"},"en":{"name":"Circle Park Summercamp Open Air","shortdescr":"Circle Park Summercamp is a playground dedicated to celebrating local and festive culture, bringing together both the most prominent and also emerging operators from Brussels. Located on a former industrial wasteland, Circle Park Summercamp is a temporary occupation focused on festivity and sustainability, open all summer long on Fridays and Saturdays from June 14th to September 22nd, 2024.","longdescr":"Located in Anderlecht, in the Petite \u00cele neighborhood, the former industrial site has once again been transformed into an oasis of relaxation and an open-air dance floor. With its colorful containers, 300-seat grandstand, and murals celebrating diversity and inclusivity, the place has become a must-visit for Brussels residents seeking relaxation and entertainment.\n\nCircle Park serves as a platform for festive promoters and Brussels collectives, much to the delight of the public who have been visiting for 3 years.\n\nToday, Circle Park has become the emblematic summer destination: the public has been gathering here for the past 3 summers to discover the local electronic scene and enjoy a beer, comfortably seated in deck chairs or dancing until sunset.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.instagram.com\/circleparkbrussels\/","email":"alexia@saltandpepper.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50010655"},"it":{"name":"Circle Park Summercamp","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.instagram.com\/circleparkbrussels\/","email":"alexia@saltandpepper.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50010655"},"cn":{"name":"Circle Park Summercamp","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.instagram.com\/circleparkbrussels\/","email":"alexia@saltandpepper.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50010655"},"fr":{"name":"Circle Park Summercamp Open Air","shortdescr":"Circle Park Summercamp est un terrain de jeu d\u00e9di\u00e9 \u00e0 la c\u00e9l\u00e9bration de la culture locale et festive qui rassemble les plus grands mais aussi les plus \u00e9mergents op\u00e9rateur.ice.s de Bruxelles. Situ\u00e9 sur une ancienne friche industrielle, Circle Park Summercamp est une occupation temporaire ax\u00e9e sur le festif et le durable ouverte tout l'\u00e9t\u00e9, les vendredis et samedis du 14 juin au 22 septembre 2024.","longdescr":"Situ\u00e9 \u00e0 Anderlecht, dans le quartier de la petite \u00eele, l\u2019ancien site industriel s\u2019est de nouveau converti en une oasis de d\u00e9tente et en une piste de danse \u00e0 ciel ouvert.\nAvec ses conteneurs color\u00e9s, sa tribune de 300 places et ses fresques valorisant la diversit\u00e9, le lieu est devenu un incontournable pour les r\u00e9sidents bruxellois en qu\u00eate de d\u00e9tente et de divertissement.\n \nCircle Park assume un r\u00f4le de plateforme d\u2019expression pour les promoteur.ices festifs ainsi que pour les collectifs bruxellois, pour le plus grand plaisir du public qui est toujours au rendez-vous depuis 3 ans.\n\n\nAujourd\u2019hui, Circle Park est devenu l\u2019endroit embl\u00e9matique de l\u2019\u00e9t\u00e9 : le public se donne rendez-vous depuis trois \u00e9t\u00e9s pour d\u00e9couvrir la sc\u00e8ne \u00e9lectronique locale et partager une bi\u00e8re, confortablement install\u00e9s dans des transats ou en dansant jusqu\u2019au coucher de soleil.\n","performers":null,"boxoffice_url":null,"website":"https:\/\/www.instagram.com\/circleparkbrussels\/","email":"alexia@saltandpepper.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50010655"},"sp":{"name":"Circle Park Summercamp","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.instagram.com\/circleparkbrussels\/","email":"alexia@saltandpepper.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50010655"},"nl":{"name":"Circle Park Summercamp Open Air","shortdescr":"Circle Park Summercamp is een speeltuin bedoeld om lokale feestculturen te vieren. Het brengt enkele van de grootste en meest veelbelovende artiesten van Brussel samen. Het is een tijdelijke bezetting op een voormalig braakliggend industrieterrein, gericht op feestelijke en duurzame activiteiten. Het is de hele zomer lang open op vrijdagen en zaterdagen van 14 juni tot 22 september 2024.","longdescr":"Gelegen in Anderlecht, in de wijk Kleine Eiland, is de voormalige industri\u00eble site opnieuw omgevormd tot een oase van ontspanning en een openlucht dansvloer. Met zijn kleurrijke containers, 300 zitplaatsen tellende tribune en muurschilderingen die diversiteit vieren, is de plek een must geworden voor Brusselse bewoners op zoek naar ontspanning en vermaak.\n\nCircle Park fungeert als een platform voor feestelijke organisatoren en Brusselse collectieven, tot groot plezier van het publiek dat al drie jaar lang steeds weer aanwezig is.\n\nVandaag de dag is Circle Park de emblematische zomerbestemming geworden: het publiek komt hier al drie zomers samen om de lokale elektronische scene te ontdekken en te genieten van een biertje, comfortabel zittend in ligstoelen of dansend tot zonsondergang.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.instagram.com\/circleparkbrussels\/","email":"alexia@saltandpepper.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50010655"}},"place":{"id":276644,"translations":{"de":{"name":"Circle Park","address_street_name":"Rue des Goujons","address_street_number":"156","address_street_box":null,"email":"info@entrakt.be","website":"https:\/\/www.facebook.com\/circleparkbrussels\/","phone_contact":null,"phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue des Goujons, 156","address_line2":"1070 Anderlecht","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Circle Park","address_street_name":"Rue des Goujons","address_street_number":"156","address_street_box":null,"email":"info@entrakt.be","website":"https:\/\/www.facebook.com\/circleparkbrussels\/","phone_contact":null,"phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue des Goujons, 156","address_line2":"1070 Anderlecht","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Circle Park","address_street_name":"Rue des Goujons","address_street_number":"156","address_street_box":null,"email":"info@entrakt.be","website":"https:\/\/www.facebook.com\/circleparkbrussels\/","phone_contact":null,"phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue des Goujons, 156","address_line2":"1070 Anderlecht","description_web":"Circle Park is a temporary project in open air on an abandoned industrial terrain of 15.000 m\u00b2 with circular economy as a main theme. It is an innovative and experimental ecosystem that wants to create a communicty of different actors in the circular economy. \r\n\r\nThe site consists of sports fields (beach volley and padel), a summer bar with a sociocultural programmation responding to the needs of the neighborhood (performances, concerts, initiations ...), and production workshops that have their home in a container village.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Circle Park","address_street_name":"Rue des Goujons","address_street_number":"156","address_street_box":null,"email":"info@entrakt.be","website":"https:\/\/www.facebook.com\/circleparkbrussels\/","phone_contact":null,"phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue des Goujons, 156","address_line2":"1070 Anderlecht","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Circle Park","address_street_name":"Rue des Goujons","address_street_number":"156","address_street_box":null,"email":"info@entrakt.be","website":"https:\/\/www.facebook.com\/circleparkbrussels\/","phone_contact":null,"phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue des Goujons, 156","address_line2":"1070 Anderlecht","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Circle Park","address_street_name":"Rue des Goujons","address_street_number":"156","address_street_box":null,"email":"info@entrakt.be","website":"https:\/\/www.facebook.com\/circleparkbrussels\/","phone_contact":null,"phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue des Goujons, 156","address_line2":"1070 Anderlecht","description_web":"Circle Park est un projet temporaire \u00e0 ciel ouvert construit sur une zone industrielle abandonn\u00e9e de 15 000 m\u00b2 avec pour th\u00e8me principal \"l'\u00e9conomie circulaire\". Il s'agit d'un \u00e9cosyst\u00e8me innovant et exp\u00e9rimental qui vise \u00e0 construire une communaut\u00e9 solide de diff\u00e9rents acteurs de l'\u00e9conomie circulaire.\r\n\r\nSur le site on retrouvera des terrains de sport (beach volley et padel), une guinguette avec une programmation socio-culturelle \u00e0 l\u2019\u00e9coute des besoins du quartier (spectacles, concerts, initiations\u2026) mais \u00e9galement des ateliers de production install\u00e9s dans des conteneurs maritimes.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Circle Park","address_street_name":"Rue des Goujons","address_street_number":"156","address_street_box":null,"email":"info@entrakt.be","website":"https:\/\/www.facebook.com\/circleparkbrussels\/","phone_contact":null,"phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue des Goujons, 156","address_line2":"1070 Anderlecht","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Circle Park","address_street_name":"Grondelsstraat","address_street_number":"156","address_street_box":null,"