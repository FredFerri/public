oxoffice_url":"https:\/\/www.visit.brussels\/de\/besucher\/veranstaltungskalender\/event-detail\/book-tickets.Bruxelles-1000-Ans-de-Luttes.5700005672","website":"https:\/\/brusselsbyfoot.be\/bruxelles-1000-ans-de-luttes\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700005672"},"pt":{"name":"Bruxelles, 1000 Ans de Luttes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/www.visit.brussels\/en\/visitors\/agenda\/event-detail\/book-tickets.Bruxelles-1000-Ans-de-Luttes.5700005672","website":"https:\/\/brusselsbyfoot.be\/bruxelles-1000-ans-de-luttes\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700005672"},"en":{"name":"Bruxelles, 1000 Ans de Luttes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/www.visit.brussels\/en\/visitors\/agenda\/event-detail\/book-tickets.Bruxelles-1000-Ans-de-Luttes.5700005672","website":"https:\/\/brusselsbyfoot.be\/bruxelles-1000-ans-de-luttes\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700005672"},"it":{"name":"Bruxelles, 1000 Ans de Luttes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/www.visit.brussels\/it\/visitatori\/agenda\/event-detail\/book-tickets.Bruxelles-1000-Ans-de-Luttes.5700005672","website":"https:\/\/brusselsbyfoot.be\/bruxelles-1000-ans-de-luttes\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700005672"},"cn":{"name":"Bruxelles, 1000 Ans de Luttes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/www.visit.brussels\/en\/visitors\/agenda\/event-detail\/book-tickets.Bruxelles-1000-Ans-de-Luttes.5700005672","website":"https:\/\/brusselsbyfoot.be\/bruxelles-1000-ans-de-luttes\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700005672"},"fr":{"name":"Bruxelles, 1000 Ans de Luttes","shortdescr":"Revivez, le temps d'une balade dans les ruelles des Marolles, les grandes luttes sociales qui ont fait de ce quartier ce qu'il est aujourd'hui.","longdescr":"D\u00e9couvrez Bruxelles la Rebelle : Revivez les grandes luttes sociales qui ont transform\u00e9 la ville au fil des si\u00e8cles.\n\nNous vous pr\u00e9sentons, au cours d\u2019une balade ludique et instructive, quelques lieux embl\u00e9matiques d\u2019un quartier qui n\u2019a jamais courb\u00e9 l\u2019\u00e9chine face \u00e0 l\u2019oppresseur et face aux menaces de toutes natures.\n\nLaissez-nous vous montrer Bruxelles la Rebelle\u2026\n\nQU\u2019ALLEZ-VOUS D\u00c9COUVRIR ?\n\nLe tour \u00ab 1000 Ans de Luttes\u00ab , qui sillonne le quartier des Marolles, vous fait d\u00e9couvrir, sur un ton ludique et amusant, les nombreuses luttes sociales qui y ont pris place ; Certaines tr\u00e8s anciennes, d\u2019autres plus r\u00e9centes\u2026\n\nLa visite passe par quelques lieux incontournables du quartier, mais vous ferez aussi la d\u00e9couverte de plusieurs ruelles et impasses moins connues.\n\nAu programme, entre autres\u2026\n\n\u2013 La Bataille des Marolles, de 1969\n\u2013 La Guerre des Matelas, de 1989\n\u2013 Le Palais de Justice, le chantier \u00e9ternel\n\u2013 Des anecdotes et des histoires croustillantes\n\u2013 La Place du Jeu de Balle et son March\u00e9 aux Puces quotidien\n\u2013 Des vues imprenables sur la ville\n\u2013 \u2026\n\nINFORMATIONS PRATIQUES\n\nTours r\u00e9guliers en fran\u00e7ais, anglais et n\u00e9erlandais :\nPrix  : Libre et conscient (3\u20ac\/pers \u00e0 la r\u00e9servation, reste du montant \u00e0 payer en fin de tour (montant libre))\nDur\u00e9e : Environ 2 heures\nGroupe maximum : 20 personnes\nRendez-vous : Place de la Chapelle (sur les marches de l\u2019\u00c9glise), 1000 Bruxelles\nFin du tour : Place du Jeu de Balle\n\nTour priv\u00e9 sur demande en fran\u00e7ais, n\u00e9erlandais, anglais ou espagnol","performers":"Une visite guid\u00e9e originale de Brussels By Foot ","boxoffice_url":"https:\/\/www.visit.brussels\/fr\/visiteurs\/agenda\/event-detail\/book-tickets.Bruxelles-1000-Ans-de-Luttes.5700005672","website":"https:\/\/brusselsbyfoot.be\/bruxelles-1000-ans-de-luttes\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700005672"},"sp":{"name":"Bruxelles, 1000 Ans de Luttes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/www.visit.brussels\/es\/visitantes\/agenda\/event-detail\/book-tickets.Bruxelles-1000-Ans-de-Luttes.5700005672","website":"https:\/\/brusselsbyfoot.be\/bruxelles-1000-ans-de-luttes\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700005672"},"nl":{"name":"Bruxelles, 1000 Ans de Luttes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/www.visit.brussels\/nl\/bezoekers\/agenda\/event-detail\/book-tickets.Bruxelles-1000-Ans-de-Luttes.5700005672","website":"https:\/\/brusselsbyfoot.be\/bruxelles-1000-ans-de-luttes\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700005672"}},"place":{"id":248402,"translations":{"de":{"name":"Entr\u00e9e principale de l'Eglise de la Chapelle","address_street_name":null