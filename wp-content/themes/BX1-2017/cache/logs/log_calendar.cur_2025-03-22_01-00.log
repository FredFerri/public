:["Historisch centrum"]}}},"translations":{"de":{"name":"Lisette Lomb\u00e9, Lisette Ma Neza & Liew Niyomkarn","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.klarafestival.be\/fr\/concert\/22-03-2025\/lisette-lombe-lisette-ma-neza-liew-niyomkarn","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700006696"},"pt":{"name":"Lisette Lomb\u00e9, Lisette Ma Neza & Liew Niyomkarn","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.klarafestival.be\/fr\/concert\/22-03-2025\/lisette-lombe-lisette-ma-neza-liew-niyomkarn","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700006696"},"en":{"name":"Lisette Lomb\u00e9, Lisette Ma Neza & Liew Niyomkarn","shortdescr":"Lisette Ma Neza (Brussels City Poet), Lisette Lomb\u00e9 (Belgian Poet Laureate) and sound artist Liew Niyomkarn soak up the past and present of the Mont des Arts. Together, they create a literary soundwalk that makes this iconic site reverberate. Take a stroll with your smartphone and headphones, and discover the heart of Brussels with new ears!","longdescr":"Lisette Ma Neza (Brussels City Poet), Lisette Lomb\u00e9 (Belgian Poet Laureate) and sound artist Liew Niyomkarn soak up the past and present of the Mont des Arts. Together, they create a literary soundwalk that makes this iconic site reverberate. Take a stroll with your smartphone and headphones, and discover the heart of Brussels with new ears!\n\n22\/3\/2025 11:00 - festive launch at MIM and group walk. \nAfterwards, the soundwalk is continuously available in the geolocation app ECHOES. ","performers":"Lisette Lomb\u00e9 \u2013 text, voice\nLisette Ma Neza \u2013 text, voice \nLiew Niyomkarn \u2013 composition, sound design \nLucas Derycke \u2013 voice recording\nKatherina Lindekens, Toon Van Mierloo - concept\nCo-production: Klarafestival, Passa Porta Festival, Muntpunt, MIM","boxoffice_url":null,"website":"https:\/\/www.klarafestival.be\/en\/concert\/22-03-2025\/lisette-lombe-lisette-ma-neza-liew-niyomkarn","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700006696"},"it":{"name":"Lisette Lomb\u00e9, Lisette Ma Neza & Liew Niyomkarn","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.klarafestival.be\/fr\/concert\/22-03-2025\/lisette-lombe-lisette-ma-neza-liew-niyomkarn","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700006696"},"cn":{"name":"Lisette Lomb\u00e9, Lisette Ma Neza & Liew Niyomkarn","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.klarafestival.be\/fr\/concert\/22-03-2025\/lisette-lombe-lisette-ma-neza-liew-niyomkarn","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700006696"},"fr":{"name":"Lisette Lomb\u00e9, Lisette Ma Neza & Liew Niyomkarn","shortdescr":"Lisette Ma Neza (Po\u00e8te de la Ville de Bruxelles), Lisette Lomb\u00e9 (Po\u00e8te National) et l'artiste sonore Liew Niyomkarn s'inspirent du pass\u00e9 et du pr\u00e9sent du Mont des Arts. Ensemble, ils cr\u00e9ent une promenade litt\u00e9raire sonore qui donne vie \u00e0 ce site embl\u00e9matique. Baladez-vous avec votre smartphone et vos \u00e9couteurs, et d\u00e9couvrez le c\u0153ur de Bruxelles avec de nouvelles oreilles !","longdescr":"Lisette Ma Neza (Po\u00e8te de la Ville de Bruxelles), Lisette Lomb\u00e9 (Po\u00e8te National) et l'artiste sonore Liew Niyomkarn s'inspirent du pass\u00e9 et du pr\u00e9sent du Mont des Arts. Ensemble, ils cr\u00e9ent une promenade litt\u00e9raire sonore qui donne vie \u00e0 ce site embl\u00e9matique. Baladez-vous avec votre smartphone et vos \u00e9couteurs, et d\u00e9couvrez le c\u0153ur de Bruxelles avec de nouvelles oreilles !\n\n22\/03\/2025 11:00 - Lancement festif au MIM et promenade collective. \nEnsuite, disponible en continu via l'application de g\u00e9olocalisation ECHOES. ","performers":"Lisette Lomb\u00e9 \u2013 text, voice\nLisette Ma Neza \u2013 text, voice \nLiew Niyomkarn \u2013 composition, sound design \nLucas Derycke \u2013 voice recording\nKatherina Lindekens, Toon Van Mierloo - concept\nCo-production: Klarafestival, Passa Porta Festival, Muntpunt, MIM","boxoffice_url":null,"website":"https:\/\/www.klarafestival.be\/fr\/concert\/22-03-2025\/lisette-lombe-lisette-ma-neza-liew-niyomkarn","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700006696"},"sp":{"name":"Lisette Lomb\u00e9, Lisette Ma Neza & Liew Niyomkarn","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.klarafestival.be\/fr\/concert\/22-03-2025\/lisette-lombe-lisette-ma-neza-liew-niyomkarn","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700006696"},"nl":{"name":"Lisette Lomb\u00e9, Lisette Ma Neza & Liew Niyomkarn","shortdescr":"Lisette Ma Neza (Stadsdichter van Brussel), Lisette Lomb\u00e9 (Dichter des Vaderlands) en geluidskunstenaar Liew Niyomkarn laten zich inspireren door het heden en verleden van de Kunstberg. Samen cre\u00ebren ze een literaire geluidswandeling die deze iconische site tot klinken brengt. Ga op pad met smartphone en koptelefoon en ontdek het hart van Brussel met nieuwe oren! ","longdescr":"Lisette Ma Neza (Stadsdichter van Brussel), Lisette Lomb\u00e9 (Dichter des Vaderlands) en geluidskunstenaar Liew Niyomkarn laten zich inspireren door het heden en verleden van de Kunstberg. Samen cre\u00ebren ze een literaire geluidswandeling die deze iconische site tot klink