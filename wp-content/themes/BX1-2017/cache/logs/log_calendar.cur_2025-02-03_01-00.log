s_not_major_event":false,"backoffice_id":316651,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"concert","ranking":1.2599210498948732,"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"categories":{"main":{"id":1,"translations":{"de":"Konzert","pt":null,"en":"Concert","it":"Concerti","cn":null,"fr":"Concert","sp":"Concierto","nl":"Concert"}},"others":{"list":[2],"translations":{"de":["Klassisch"],"pt":[null],"en":["Classical"],"it":["Classica"],"cn":[null],"fr":["Classique"],"sp":["Cl\u00e1sica"],"nl":["Klassiek"]}}},"translations":{"de":{"name":"Classical concert by the Carlo Van Neste Trio at the Th\u00e9\u00e2tre Mercelis on February 8th at 7 PM","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.facebook.com\/TrioCarloVanNeste","email":"info.triocarlovanneste@gmail.com","phone_contact":"+32 488 98 30 63","phone_booking":"+32 488 98 30 63","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700005724"},"pt":{"name":"Classical concert by the Carlo Van Neste Trio at the Th\u00e9\u00e2tre Mercelis on February 8th at 7 PM","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.facebook.com\/TrioCarloVanNeste","email":"info.triocarlovanneste@gmail.com","phone_contact":"+32 488 98 30 63","phone_booking":"+32 488 98 30 63","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700005724"},"en":{"name":"Classical concert by the Carlo Van Neste Trio at the Th\u00e9\u00e2tre Mercelis on February 8th at 7 PM","shortdescr":"The Carlo Van Neste Trio invites you to its first concert of the year at the Th\u00e9\u00e2tre Mercelis on Saturday, February 8th at 7 PM.\n\nEvent address: 13 rue Mercelis, 1050 Ixelles\n\nProgram:\n\nAnton\u00edn Dvo\u0159\u00e1k: Trio Dumky Op.90\nBed\u0159ich Smetana: Piano Trio Op.15\nAstor Piazzolla: Tango\n\nReservations by phone at 0488 983 063 or by email: info.triocarlovanneste@gmail.com","longdescr":"TRIO CARLO VAN NESTE\nChamber Music\n\nThe Trio Carlo Van Neste is named after the famous Belgian violinist Carlo Van Neste, one of the prominent figures of the renowned Belgian School of Violin. The Trio Carlo Van Neste, which he founded with Naum Sluszny on piano and Eric Feldbusch on cello, was later renamed the \"Trio Reine Elisabeth of Belgium.\" Formed in 2005, the new generation of the Trio Carlo Van Neste now brings together three great talents: pianist Karin Lechner, violinist Alissa Margulis, and cellist Alexandre Debrus.\n\nAbove all, it is a long-standing friendship that unites these three musicians in this ensemble. Their camaraderie is evident in every performance, where the dialogue, momentum, and generosity unleash their unique musical chemistry. The Trio displays the brilliance of its personality at the intersection of the individual artistry of these three accomplished musicians.\n\nThrough a bold and inventive reimagining of the great repertoire for piano trio, the Trio Carlo Van Neste distinguishes itself with its lively and passionate interpretations. This is reflected in its discography, which has been widely praised by the international press. Its four recordings, released under the \"PAVANE Records\" label, are dedicated to Czech composers (Dvo\u0159\u00e1k, Smetana), German repertoire in tribute to Beethoven and Brahms, Argentine tangos by Piazzolla, and Mendelssohn's two piano trios.\n\nSince its inception, the Trio Carlo Van Neste has continually expanded its horizons. From Brussels, Biarritz, and Paris to Tel Aviv, Tokyo, Nagakute (Japan), and Novosibirsk (Siberia), as well as Shanghai, the Trio consistently delights audiences around the world. Thanks to their insatiable curiosity and constant search for renewal, Karin, Alissa, and Alexandre help us rediscover the great classics while also revealing hidden or forgotten gems from the piano trio repertoire. Honoring their Belgian roots, the three musicians bring composers such as C\u00e9sar Franck, Guillaume Lekeu, and Joseph Jongen back into the limelight. They also take us to Buenos Aires, to the banks of the Rio de la Plata, following in the footsteps of Astor Piazzolla and his nuevos tangos\u2014his new musical style with a nostalgic and sensual temperament, arranged for them by his friend and fellow student, Jos\u00e9 Bragato.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.facebook.com\/TrioCarloVanNeste","email":"info.triocarlovanneste@gmail.com","phone_contact":"+32 488 98 30 63","phone_booking":"+32 488 98 30 63","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700005724"},"it":{"name":"Classical concert by the Carlo Van Neste Trio at the Th\u00e9\u00e2tre Mercelis on February 8th at 7 PM","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.facebook.com\/TrioCarloVanNeste","email":"info.triocarlovanneste@gmail.com","phone_contact":"+32 488 98 30 63","phone_booking":"+32 488 98 30 63","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700005724"},"cn":{"name":"Classical concert by the Carlo Van Neste Trio at the Th\u00e9\u00e2tre Mercelis on February 8th at 7 PM","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.facebook.com\/TrioCarloVanNeste","email":"info.triocarlovanneste@gmail.com","phone_contact":"+32 488 98 30 63","phone_booking":"+32 488 98 30 63","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700005724"},"fr":{"name":"Concert du Trio Carlo Van Neste au Th\u00e9\u00e2tre Mercelis ce 8 f\u00e9vrier \u00e0 19h","shortdescr":"Le Trio Carlo Van Neste vous retrouve pour son premier concert de l\u2019ann\u00e9e au Th\u00e9\u00e2tre Mercelis le samedi 8 f\u00e9vrier \u00e0 19h.\n\nAdresse du jour : 13 rue Mercelis,1050 Ixelles \n\nAu Programme:\n\n- Anton\u00edn Dvo\u0159\u00e1k : Trio Dumky Op.90. \n- Bed\u0159ich Smetana : Trio \u00e0 clavier Op.15 Astor \n- Piazzolla: Tango \n\nR\u00e9servations par t\u00e9l\u00e9phone au 0488 983 063 \nou par e-mail : info.triocarlovanneste@gmail.com ","longdescr":"TRIO CARLO VAN NESTE \nMusique de Chambre \n\nLe Trio Carlo Van Neste doit son nom au c\u00e9l\u00e8bre violoniste belge Carlo Van Neste, un des repr\u00e9sentants de la c\u00e9l\u00e8bre Ecole Belge du Violon. Le Trio Carlo Van Neste qu\u2019il cr\u00e9e \u00e0 l\u2019\u00e9poque avec Naum Sluszny au piano et Eric Feldbusch au violoncelle sera rebaptis\u00e9 par la suite Trio Reine Elisabeth de Belgique. Form\u00e9 en 2005, la nouvelle g\u00e9n\u00e9ration du Trio Carlo Van Neste r\u00e9unit aujourd'hui les trois grands talents que sont la pianiste Karin Lechner, la violoniste Alissa Margulis, et le violoncelliste Alexandre Debrus. \n\nC\u2019est avant tout une longue amiti\u00e9 qui rassemble les trois musiciens au sein de cette formation musicale. Leur connivence transpara\u00eet \u00e0 chacune de leur repr\u00e9sentation o\u00f9 le dialogue, l\u2019\u00e9lan et la g\u00e9n\u00e9rosit\u00e9 lib\u00e8re cette alchimie musicale qui leur est propre. Le Trio montre l\u2019\u00e9clat de sa personnalit\u00e9 \u00e0 la jonction de celle de ces trois artistes aux carri\u00e8res accomplies.\nA travers une relecture audacieuse et inventive des \u0153uvres du grand r\u00e9pertoire pour trio \u00e0 clavier, le Trio Carlo Van Neste se distingue par ses interpr\u00e9tations vivantes et passionn\u00e9es. En t\u00e9moigne sa discographie, unanimement salu\u00e9e par la presse \u00e9trang\u00e8re. Ses quatre disques enregistr\u00e9s sous le label \u201cPAVANE Records\u201d, sont respectivement d\u00e9di\u00e9s aux compositeurs tch\u00e8ques (Dvorak, Smetana), au r\u00e9pertoire allemand en hommage \u00e0 Beethoven et Brahms, aux Tangos argentins de Piazzolla et aux deux Trios de Mendelssohn. \n\nDepuis ses d\u00e9buts, le Trio Carlo Van Neste n\u2019en finit pas d\u2019\u00e9largir ses horizons. Depuis Bruxelles, Biarritz ou Paris jusqu\u2019\u00e0 Tel Aviv, Tokyo, Nagakute (Japon) en passant par Novossibirsk (Sib\u00e9rie) et Shanghai, le Trio ne cesse de ravir son public aux quatre coins du monde. Gr\u00e2ce \u00e0 une in\u00e9puisable curiosit\u00e9 et une recherche constante de renouvellement, Karin, Alissa et Alexandre nous font red\u00e9couvrir les grands classiques et nous d\u00e9voilent des joyaux m\u00e9connus ou oubli\u00e9s du r\u00e9pertoire pour trio \u00e0 clavier. En honneur \u00e0 leurs origines, les trois musiciens remettent au go\u00fbt du jour des compositeurs belges tels que C\u00e9sar Franck, Guillaume Lekeu, Joseph Jongen, \u2026 et nous emm\u00e8nent \u00e0 Buenos Aires sur les rives du Rio de la Plata, sur les traces d\u2019Astor Piazzolla et de ses nuevos tangos, nouveau style musical, au temp\u00e9rament nostalgique et sensuel, arrang\u00e9s pour eux par son ami et condisciple, Jos\u00e9 Bragato.","performers":"Le Trio Carlo Van Neste : Karin Lechner (piano), Alissa Margulis (violon), Alexandre Debrus (violoncelle)","boxoffice_url":null,"website":"https:\/\/www.facebook.com\/TrioCarloVanNeste","email":"info.triocarlovanneste@gmail.com","phone_contact":"+32 488 98 30 63","phone_booking":"+32 488 98 30 63","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700005724"},"sp":{"name":"Classical concert by the Carlo Van Neste Trio at the Th\u00e9\u00e2tre Mercelis on February 8th at 7 PM","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.facebook.com\/TrioCarloVanNeste","email":"info.triocarlovanneste@gmail.com","phone_contact":"+32 488 98 30 63","phone_booking":"+32 488 98 30 63","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700005724"},"nl":{"name":"Klassiek concert door het Trio Carlo Van Neste in het Th\u00e9\u00e2tre Mercelis op 8 februari om 19u","shortdescr":"Het Trio Carlo Van Neste verwelkomt u voor zijn eerste concert van het jaar in het Th\u00e9\u00e2tre Mercelis op zaterdag 8 februari om 19u.\n\nAdres van de dag: 13 rue Mercelis, 1050 Elsene\n\nOp het programma:\n\nAnton\u00edn Dvo\u0159\u00e1k: Trio Dumky Op.90\nBed\u0159ich Smetana: Pianotrio Op.15\nAstor Piazzolla: Tango\n\nReserveren kan telefonisch op 0488 983 063 of via e-mail: info.triocarlovanneste@gmail.com","longdescr":"TRIO CARLO VAN NESTE\nKamermuziek\n\nHet Trio Carlo Van Neste is vernoemd naar de beroemde Belgische violist Carlo Van Neste, een van de vertegenwoordigers van de beroemde Belgische School van de Viool. Het Trio Carlo Van Neste, dat hij oprichtte samen met Naum Sluszny op piano en Eric Feldbusch op cello, werd later omgedoopt tot het \"Trio Reine Elisabeth van Belgi\u00eb.\" Het huidige Trio Carlo Van Neste werd opgericht in 2005 en bestaat uit drie grote talenten: pianiste Karin Lechner, violiste Alissa Margulis en cellist Alexandre Debrus.\n\nBoven alles is het een lange vriendschap die deze drie muzikanten verenigt in dit ensemble. Hun onderlinge verstandhouding is duidelijk merkbaar in elke uitvoering, waar de dialoog, de impuls en de vrijgevigheid de unieke muzikale chemie die hen kenmerkt, tot leven brengen. Het Trio toont de kracht van zijn persoonlijkheid op het kruispunt van de artistieke identiteit van deze drie ervaren musici.\n\nDoor een gedurfde en inventieve herinterpretatie van het grote repertoire voor piano trio, onderscheidt het Trio Carlo Van Neste zich met levendige en gepassioneerde uitvoeringen. Dit wordt weerspiegeld in hun discografie, die wereldwijd wordt geprezen door de internationale pers. De vier albums, opgenomen onder het label \"PAVANE Records\", zijn gewijd aan Tsjechische componisten (Dvo\u0159\u00e1k, Smetana), Duits repertoire ter ere van Beethoven en Brahms, Argentijnse tangos van Piazzolla en de twee pianotrio's van Mendelssohn.\n\nSinds zijn oprichting heeft het Trio Carlo Van Neste zijn horizon voortdurend verbreed. Van Brussel, Biarritz en Parijs tot Tel Aviv, Tokio, Nagakute (Japan), Novosibirsk (Siberi\u00eb) en Shanghai, het Trio blijft wereldwijd zijn publiek betoveren. Dankzij hun onvermoeibare nieuwsgierigheid en constante zoektocht naar vernieuwing, laten Karin, Alissa en Alexandre ons de grote klassiekers herontdekken en onthullen ze ons verborgen of vergeten pareltjes uit het repertoire voor piano trio. Ter ere van hun Belgische oorsprong brengen de drie musici componisten zoals C\u00e9sar Franck, Guillaume Lekeu en Joseph Jongen opnieuw onder de aandacht. Ze nemen ons ook mee naar Buenos Aires, aan de oevers van de Rio de la Plata, waar we de voetsporen van Astor Piazzolla volgen en zijn nuevos tangos ontdekken \u2013 zijn nieuwe muzikale stijl, met een nostalgisch en sensueel temperament, gearrangeerd voor hen door zijn vriend en medestudent Jos\u00e9 Bragato.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.facebook.com\/TrioCarloVanNeste","email":"info.triocarlovanneste@gmail.com","phone_contact":"+32 488 98 30 63","phone_booking":"+32 488 98 30 63","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700005724"}},"place":{"id":67,"translations":{"de":{"name":"Petit Th\u00e9\u00e2tre Mercelis","address_street_name":"Rue Mercelis","address_street_number":"13","address_street_box":null,"email":"culture@ixelles.brussels","website":"https:\/\/culture.ixelles.be\/fr\/mercelis\/","phone_contact":"+32 2 515 64 63","phone_booking":"+32 2 515 64 63","address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Mercelis, 13","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Petit Th\u00e9\u00e2tre Mercelis","address_street_name":"Rue Mercelis","address_street_number":"13","address_street_box":null,"email":"culture@ixelles.brussels","website":"https:\/\/culture.ixelles.be\/fr\/mercelis\/","phone_contact":"+32 2 515 64 63","phone_booking":"+32 2 515 64 63","address_zip":"1050","add