t":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[24,28],"translations":{"fr":["Galeries d'art","Arts graphiques"],"nl":["Galeries","Grafische kunst, vormgeving"],"en":["Art Galleries","Graphic art"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Encres de Shin","shortdescr":"Shinichiro Natsusaka, un Mangaka \u00e0 Bruxelles","longdescr":"Exposition-Vente Encres de Shin\r\n\r\nLa Maison de Vente Collauctions a le plaisir de vous convier \u00e0 l\u2019exposition \u00ab Encres de Shin \u00bb, qui pr\u00e9sentera pour la premi\u00e8re fois en Belgique, les oeuvres du Mangaka japonais Shinichiro Natsusaka. \r\nL\u2019exposition se tiendra du 8 au 28 mai \u00e0 la salle de vente Collauctions avec l'amicale participation de F\u00e9lix Meynet et Hub dont quelques oeuvres seront \u00e9galement pr\u00e9sent\u00e9es. \r\n\r\nJourn\u00e9e d\u00e9dicace (nombre de d\u00e9dicaces limit\u00e9) :\r\nHub \/ Natsusaka le samedi 28 mai de 17h \u00e0 19h\r\n\r\nInfos utiles :\r\n\r\nHoraires d'ouverture du lundi au samedi : de 13h30 \u00e0 19h\r\nEntr\u00e9e : Place St\u00e9phanie, 6 ou Rue Capitaine Crespel, 53 (1050 Bruxelles) \r\nFinissage de l'exposition le 28 mai \u00e0 partir de 13h30\r\n\r\nSi int\u00e9r\u00eat pour la s\u00e9ance d\u00e9dicace merci de nous le signifier par mail \u00e0 contact@collauctions.com et de pr\u00e9ciser si vous vous inscrivez pour l'un des artistes ou  pour les deux.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.collauctions.com","email":"contact@collauctions.com","phone_contact":null,"phone_booking":"+32 470 82 51 54","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/533884.html"},"nl":{"name":"Encres de Shin","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_b