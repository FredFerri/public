\/\/www.cauchie.be","phone_contact":"+ 32 (0)473 64 26 97","phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Frankenstraat, 5","address_line2":"1040 Etterbeek","description_web":"Het Cauchiehuis, het eigen woonhuis-atelier van het kunstenaarsduo Paul Cauchie en Caroline Voet, is een van de parels van de Brusselse Art Nouveau. Opgevat in 1905 als een visitekaartje van hun kunnen, met een indrukwekkende gevel-advertentie met meerdere sgraffito-panelen en een bel-etage vol decoratieve interieur-elementen, opent dit huis zijn deuren om zijn geschiedenis en het werk van zijn eigenaars met u te delen.\r\n\r\nElke maand open voor publiek, het eerste weekend en de derde zaterdag van de maand.\r\nBegeleide bezoeken, groepsbezoeken, private en professionele evenementen\r\n","description_print":null,"booking_url":"https:\/\/shop.utick.be\/?module=CATALOGUE&pos=MAISONCAUCHIE&lg=NL","sort_order":null,"virtual_visit":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":550,"location":{"lat":50.83837634,"lon":4.3953402},"last_updated_at":"2023-08-09T11:31:35+02:00","published_at":"2013-10-19T01:13:37+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/4e3faa566b2a700bb342e4857f52c7d9f26cd830.jpg","width":3024,"height":4032,"ratio":0.75,"oEmbed_height":4032,"oEmbed_width":3024,"translations":{"de":{"title":"*EXTRAMUROS* Paul Cauchie \u00e0 Anvers","copyright":"\u00a9 asbl Maison Cauchie"},"pt":{"title":"*EXTRAMUROS* Paul Cauchie \u00e0 Anvers","copyright":"\u00a9 asbl Maison Cauchie"},"en":{"title":"*EXTRAMUROS* Paul Cauchie \u00e0 Anvers","copyright":"\u00a9 asbl Maison Cauchie"},"it":{"title":"*EXTRAMUROS* Paul Cauchie \u00e0 Anvers","copyright":"\u00a9 asbl Maison Cauchie"},"cn":{"title":"*EXTRAMUROS* Paul Cauchie \u00e0 Anvers","copyright":"\u00a9 asbl Maison Cauchie"},"fr":{"title":"*EXTRAM