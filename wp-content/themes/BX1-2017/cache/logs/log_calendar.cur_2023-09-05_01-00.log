r?","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"rika@lafermeduchaudron.be","phone_contact":"+32 456 59 03 09","phone_booking":"+32 456 59 03 09","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50000527"},"pt":{"name":"Lokaal eten, hoe ging dat weer?","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"rika@lafermeduchaudron.be","phone_contact":"+32 456 59 03 09","phone_booking":"+32 456 59 03 09","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50000527"},"en":{"name":"Lokaal eten, hoe ging dat weer?","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"rika@lafermeduchaudron.be","phone_contact":"+32 456 59 03 09","phone_booking":"+32 456 59 03 09","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50000527"},"it":{"name":"Lokaal eten, hoe ging dat weer?","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"rika@lafermeduchaudron.be","phone_contact":"+32 456 59 03 09","phone_booking":"+32 456 59 03 09","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50000527"},"cn":{"name":"Lokaal eten, hoe ging dat weer?","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"rika@lafermeduchaudron.be","phone_contact":"+32 456 59 03 09","phone_booking":"+32 456 59 03 09","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50000527"},"fr":{"name":"Atelier alimenTERRE","shortdescr":"Tous les mardis, la Ferme du Chaudron ouvre les portes de la salle Le Cap \u00e0 Bizet. L'espace se transforme en un lieu polyvalent. Tout le monde y est le bienvenu pour une tasse de caf\u00e9 ou de th\u00e9 gratuite. Et en plus, un atelier sans engagement est toujours propos\u00e9 o\u00f9 l'on s'inspire mutuellement autour de pratiques nutritionnelles respectueuses de notre corps, de notre soci\u00e9t\u00e9 et de l'environnement.","longdescr":"Programme de septembre :\n5\/09 : transformation de quelques produits de saison en chutney\n12\/09 : cuisine de quartier* : lentilles \u00e0 l'espagnole\n19\/09 : apprenez \u00e0 faire 3 sauces maison pour accompagner vos plats\n26\/09 : exp\u00e9rimentation de burgers v\u00e9g\u00e9tariens de saison\n\n* (Tous les deuxi\u00e8mes mardis du mois, un repas complet est pr\u00e9par\u00e9 ensemble. C'est gratuit mais n\u00e9cessite une inscription au 0456590309 ou via rika@lafermeduchaudron.be)","performers":null,"boxoffice_url":null,"website":null,"email":"rika@lafermeduchaudron.be","phone_contact":"+32 456 59 03 09","phone_booking":"+32 456 59 03 09","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50000527"},"sp":{"name":"Lokaal eten, hoe ging dat weer?","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"rika@lafermeduchaudron.be","phone_contact":"+32 456 59 03 09","phone_booking":"+32 456 59 03 09","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50000527"},"nl":{"name":"Lokaal eten, hoe ging dat weer?","shortdescr":"Elke dinsdag opent La Ferme du Chaudron de deuren van Salle Le Cap in Bizet van 12u tot 16u. De ruimte transformeert zich tot multi-purpose plek. Iedereen is er welkom voor een gratis kopje koffie of thee. En daarnaast wordt er steeds een vrijblijvende workshop aangeboden waarin we elkaar onderling inspireren rond voedingspraktijken die ons lichaam, onze maatschappij en het milieu respecteren.","longdescr":"Programma van september:\n5\/09: transformatie van enkele seizoensproducten tot chutney\n12\/09: buurtkeuken* : linzen op Spaanse wijze\n19\/09: 3 huisgemaakte sauzen leren maken voor bij je gerechten\n26\/09: experimenteren met seizoensgebonden vegetarische burgers\n\n* (Elke tweede dinsdag van de maand wordt er samen een volledige maaltijd gekookt. Deze is gratis maar vereist inschrijving via 0456590309 of via rika@lafermeduchaudron.be)","performers":"La Ferme du Chaudron","boxoffice_url":null,"website":null,"email":"rika@lafermeduchaudron.be","phone_contact":"+32 456 59 03 09","phone_booking":"+32 456 59 03 09","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50000527"}},"place":{"id":277575,"translations":{"de":{"name":"Salle Le Cap","address_street_name":"Place Bizet","address_street_number":"35","address_street_box":null,"email":"diffusion@cie-ahmonamour.com","website":"https:\/\/www.cie-ahmonamour.com","phone_contact":"+32 471 62 84 78","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Place Bizet, 35","address_line2":"1070 Anderlecht","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Salle Le Cap","address_street_name":"Place Bizet","address_street_number":"35","address_street_box":null,"email":"diffusion@cie-ahmonamour.com","website":"https:\/\/www.cie-ahmonamour.com","phone_contact":"+32 471 62 84 78","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Place Bizet, 35","address_line2":"1070 Anderlecht","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Salle Le Cap","address_street_name":"Place Bizet","address_street_number":"35","address_street_box":null,"email":"diffusion@cie-ahmonamour.com","website":"https:\/\/www.cie-ahmonamour.com","phone_contact":"+32 471 62 84 78","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Place Bizet, 35","address_line2":"1070 Anderlecht","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Salle Le Cap","address_street_name":"Place Bizet","address_street_number":"35","address_street_box":null,"email":"diffusion@cie-ahmonamour.com","website"