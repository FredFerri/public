:false,"last_updated_at":"2024-08-24T02:01:19+02:00","published_at":"2024-06-07T11:44:42+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":true,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":301399,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"other","ranking":0.27909200099982406,"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"categories":{"main":{"id":90,"translations":{"de":"Animationen","pt":null,"en":"Animations","it":"Animazioni","cn":null,"fr":"Animations","sp":"Animaciones","nl":"Animaties"}},"others":{"list":[98],"translations":{"de":["Wander- & Radwege"],"pt":[null],"en":["Pedestrian and cyclist path"],"it":["Percorsi pedonali e piste ciclabili"],"cn":[null],"fr":["Parcours p\u00e9destres et cyclistes"],"sp":["Recorridos a pie y en bicicleta"],"nl":["Fiets- of wandelroute"]}}},"translations":{"de":{"name":"Roller Bike Parade","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/rollerbikeparade.be","email":null,"phone_contact":"+32 2 741 63 20","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50011327"},"pt":{"name":"Roller Bike Parade","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/rollerbikeparade.be","email":null,"phone_contact":"+32 2 741 63 20","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50011327"},"en":{"name":"Roller Bike Parade","shortdescr":"Want to roll down the boulevards and side streets of Brussels on your rollerblades, skateboard or bike, without a single car in sight?\n \nJoin the Roller Bike Parade in Brussels every Friday evening.\nSupervised by our experienced staff, come and discover Brussels while riding to the rhythm of our Dj's!","longdescr":"The Roller Bike Parade is back for a new edition in 2024!\nAccompanied by our experienced staff, come and discover Brussels to the rhythm of our Djs!\nWant to rollerblade, skateboard or bike through the grand boulevards or small streets of Brussels without cars driving around you? Then join the Roller Bike Parade in Brussels every Friday night.\nThe Roller Bike Parade is a fun and original concept that invites participants to come on rollerblades, bikes, skateboards, monowheels or longboards to invade the city streets for an evening.\nTwo routes are planned for each parade: one for beginners (about 5 km) and one for the sporty among you (about 15 km).\nFamily or alone, the parade is for everyone.\nIn all cases, it is advisable to equip yourself with safety equipment (helmet, knee pads, etc.) and something to keep you hydrated.\nWe expect you every Friday from 7 pm on the Place Poelaert in Brussels.\n- Gathering time: 7 pm\n- Departure time: 8 pm\n- Departure point: Place Poelaert\n- When: Every Friday (except June 28 and September 06).\n- Price: Free\nWe are ready for a top season! \nDo you have any questions? Want to join us?\nFind us at https:\/\/rollerbikeparade.be\/\n- Facebook: https:\/\/www.facebook.com\/RollerBikeParade\n- Instagram: https:\/\/www.instagram.com\/rollerbikeparade\/\n#rollerparade\nPLEASE NOTE \nThe parade will not take place on June 28 and September 6.\n","performers":null,"boxoffice_url":null,"website":"https:\/\/rollerbikeparade.be","email":null,"phone_contact":"+32 2 741 63 20","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50011327"},"it":{"name":"Roller Bike Parade","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/rollerbikeparade.be","email":null,"phone_contact":"+32 2 741 63 20","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50011327"},"cn":{"name":"Roller Bike Parade","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/rollerbikeparade.be","email":null,"phone_contact":"+32 2 741 63 20","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50011327"},"fr":{"name":"Roller Bike Parade","shortdescr":"Envie de rouler sur les grands boulevards ou les petites rues de Bruxelles en rollers, skateboard, ou v\u00e9lo sans aucune voiture autour de vous ?\n \nRejoignez la Roller Bike Parade \u00e0 Bruxelles tous les vendredis soirs.\nEncadr\u00e9 par nos staffeurs exp\u00e9riment\u00e9s, venez d\u00e9couvrir Bruxelles tout en roulant sur le rythme de nos Dj\u2019s !","longdescr":"Encadr\u00e9 par nos staffeurs exp\u00e9riment\u00e9s, venez d\u00e9couvrir Bruxelles tout en roulant sur le rythme de nos Dj\u2019s !\nEnvie de rouler sur les grands boulevards ou les petites rues de Bruxelles en rollers, skateboard, ou v\u00e9lo sans aucune voiture autour de vous ? Alors, rejoignez la Roller Bike Parade \u00e0 Bruxelles tous les vendredis soirs.\nLa Roller Bike Parade est un concept ludique et original qui invite les participants \u00e0 venir en roller, v\u00e9lo, skateboard, monowheel, longboard ou encore trottinette \u00e9lectrique pour envahir les rues de la ville durant une soir\u00e9e.\nDeux parcours sont pr\u00e9vus lors de chaque parade : l\u2019un pour les d\u00e9butants (environ 5 km) et l\u2019autre pour les plus sportifs d\u2019entre vous (environ 15km). Entre amis, en famille ou seul, la parade c\u2019est pour tout le monde.\nDans tous les cas, il est conseill\u00e9 de s\u2019\u00e9quiper de protections de s\u00e9curit\u00e9 (casque, genouill\u00e8res, etc.) ainsi que de quoi vous r\u00e9hydrater.\nOn vous attend donc de pied ferme tous les vendredis \u00e0 partir de 19h, Place Poelaert \u00e0 Bruxelles. D\u00e9part \u00e0 20h!\n- Heure de rassemblement: 19:00\n- Heure de d\u00e9part: 20:00\n- Lieu de d\u00e9part: Place Poelaert\n- Quand: tous les vendredis (sauf le 28 juin et le 06 septembre)\n- Prix : Gratuit\nC\u2019est parti pour une super saison ! \n Tu as des questions? Tu veux participer?\nRetrouves-nous sur https:\/\/rollerbikeparade.be\/\n- Facebook: https:\/\/www.facebook.com\/RollerBikeParade\nInstagram:\nhttps:\/\/www.instagram.com\/rollerbikeparade\/\n#rollerparade\n\nATTENTION\nLa parade n'aura pas lieu le 28 juin et le 6 septembre.","performers":null,"boxoffice_url":null,"website":"https:\/\/rollerbikeparade.be","email":null,"phone_contact":"+32 2 741 63 20","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50011327"},"sp":{"name":"Roller Bike Parade","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/rollerbikeparade.be","email":null,"phone_contact":"+32 2 741 63 20","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50011327"},"nl":{"name":"Roller Bike Parade","shortdescr":"Wil je op je skeelers, skateboard of fiets over de grote boulevards of smalle straatjes van Brussel rollen zonder dat er ook maar \u00e9\u00e9n auto in de buurt is?\n \nDoe dan elke vrijdagavond mee aan de Roller Bike Parade in Brussel.\nKom onder begeleiding van onze ervaren medewerkers Brussel ontdekken op het ritme van onze DJ's!","longdescr":"De Roller Bike Parade is terug voor een nieuwe editie in 2024!\nOnder begeleiding van onze ervaren medewerkers, kom en ontdek Brussel op het ritme van onze Dj's!\nWil je op skeelers, skateboards of fietsen door de grote boulevards of de kleine straatjes van Brussel zonder dat er auto's om je heen rijden? Doe dan elke vrijdagavond mee aan de Roller Bike Parade in Brussel.\nDe Roller Bike Parade is een leuk en origineel concept dat deelnemers uitnodigt om te komen op skeelers, fietsen, skateboards, monowheels of longboards om de straten van de stad binnen te vallen voor een avond.\nVoor elke optocht zijn twee routes gepland: \u00e9\u00e9n voor beginners (ca. 5 km) en \u00e9\u00e9n voor de sportievelingen onder u (ca. 15 km).\nFamilie of alleen, de parade is voor iedereen.\nIn alle gevallen is het raadzaam u uit te rusten met een veiligheidsuitrusting (helm, kniebeschermers, enz.) en iets om je te hydrateren.\nWe verwachten jullie elke vrijdag vanaf 19u op het Poelaertplein in Brussel.\n- Verzameltijd: 19.00 uur\n- Vertrektijd: 20.00 uur\n- Vertrekpunt: Poelaertplein\n- Wanneer: Elke vrijdag (behalve 28 juni en 06 september)\n- Prijs: Gratis\nWe zijn klaar voor een topseizoen! \nHeeft u nog vragen? Wil je meedoen?\nVind ons op https:\/\/rollerbikeparade.be\/\n- Facebook: https:\/\/www.facebook.com\/RollerBikeParade\n- Instagram: https:\/\/www.instagram.com\/rollerbikeparade\/\n#rollerparade\n LET OP \nDe parade gaat niet door op 28 juni en 6 September.","performers":null,"boxoffice_url":null,"website":"https:\/\/rollerbikeparade.be","email":null,"phone_contact":"+32 2 741 63 20","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50011327"}},"place":{"id":238555,"translations":{"de":{"name":"Place Poelaert","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Poelaert","address_line2":"1000 Bruxelles","description_web":"Bei dem Place Poelaert, der sich 63 Meter \u00fcber der Br\u00fcsseler Unterstadt befindet, handelt es sich um den Vorplatz des beeindruckenden Br\u00fcsseler Justizpalasts. Ein Fahrstuhl ist die schnellste Verbindung zwischen Ober- und Unterstadt. Der Platz misst 155 m x 50 m, d. h. knapp 8 hat - damit ist der Place Poelaert der gr\u00f6\u00dfte Platz Br\u00fcssels.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Place Poelaert","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Poelaert","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Place Poelaert","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Place Poelaert","address_line2":"1000 Brussels","description_web":"Between the popular Marolles district and the elegant Louise neighbourhood lies the place Poelaert. This is the place to go for a superb panoramic view of the lower part of the city. On the horizon are architectural heritage gems such as the Basilica of Koekelberg and the Atomium. Sunset in particular is a great time to enjoy the seemingly endless sky. Not afraid of heights? Since 2019, the giant Ferris wheel 'The View' has taken up residence here and you can admire the Belgian capital from a height of no less than one hundred metres! Afterwards, take the free glass lift and dive into the Marolles for more urban fun.\r\n\r\nPlace Poelaert, with its 750m\u00b2 surface area, is also the largest square in the capital. It was named after Joseph Poelaert, the architect of the Palace of Justice, which is the monumental courthouse you see on this square, a mastodon from the 19th century. The scaffolding surrounding the courthouse has become part of the public's collective memory.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Place Poelaert","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Poelaert","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Place Poelaert","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Poelaert","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Place Poelaert","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Poelaert","address_line2":"1000 Bruxelles","description_web":"Entre les Marolles tr\u00e8s populaires, et l'\u00e9l\u00e9gant quartier Louise, se trouve la place Poelaert. C'est le meilleur spot pour avoir une vue panoramique \u00e0 couper le souffle sur la ville. \u00c0 l'horizon se profilent des joyaux du patrimoine bruxellois comme la basilique de Koekelberg et l'Atomium ; \u00e0 admirer sans mod\u00e9ration, et particuli\u00e8rement au coucher du soleil. Vous n'avez pas le vertige ? Depuis 2019, la grande roue \" The View \" vous emm\u00e8ne \u00e0 cent m\u00e8tres de haut pour admirer la capitale belge, tandis que l'ascenseur (gratuit), tout en verre, vous fait plonger dans les Marolles pour encore plus de plaisir en ville.\r\n\r\nAvec ses 750 m2, la place Poelaert est \u00e9galement la plus grande place de la capitale. Elle doit son nom \u00e0 Joseph Poelaert, l'architecte du monumental palais de justice, construit au 19\u00e8me si\u00e8cle, qui tr\u00f4ne sur cette place ; et l\u2019\u00e9chafaudage qui le soutient depuis des ann\u00e9es fait d\u00e9sormais partie de la m\u00e9moire collective.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Place Poelaert","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Poelaert","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Poelaertplein","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Poelaertplein","address_line2":"1000 Brussel","description_web":"Tussen de volkse Marollen en de elegante Louizawijk ligt het Poelaertplein. Hier moet je zijn voor een prachtig panoramisch uitzicht over de (beneden)stad. Aan de horizon prijken architecturale erfgoedparels zoals de Basiliek van Koekelberg en het Atomium. Vooral bij zonsondergang is het hier volop genieten van een eindeloze hemel. Geen hoogtevrees? Sinds 2019 staat hier het reuzenrad \u2018The View\u2019 en kan je de Belgische hoofdstad bewonderen vanop maar liefst honderd meter hoogte! Nadien kan je gratis de glazen lift nemen en de Marollen induiken voor meer stadsplezier.\r\n\r\nHet Poelaertplein is met een oppervlakte van 750 m\u00b2 ook het grootste plein van de hoofdstad. Het werd vernoemd naar Joseph Poelaert, de architect van het justitiepaleis. Dat is het monumentale gerechtsgebouw dat je op dit plein ziet, een mastodont uit de 19de eeuw. De steigers waarin het justitiepaleis sinds jaar en dag verpakt is, maken ondertussen deel uit van het collectieve geheugen.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[2],"translations":{"de":["Marollen"],"pt":[null],"en":["Marolles"],"it":["Marolles"],"cn":[null],"fr":["Marolles"],"sp":["Marolles"],"nl":["Marollen"]}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],