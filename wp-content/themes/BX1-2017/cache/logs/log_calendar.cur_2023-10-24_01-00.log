\/Story-in-vitro","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50000124"},"en":{"name":"Story in vitro","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Story-in-vitro","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50000124"},"it":{"name":"Story in vitro","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Story-in-vitro","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50000124"},"cn":{"name":"Story in vitro","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Story-in-vitro","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50000124"},"fr":{"name":"Story in vitro","shortdescr":"Venez mettre au monde notre histoire !","longdescr":"Une improvisation publiquement assist\u00e9e.\nSur un th\u00e8me unique que vous proposez, les com\u00e9diens vont d\u2019abord jouer plusieurs courtes improvisations. Le th\u00e8me est \u00e9voqu\u00e9 sous diff\u00e9rents styles, pr\u00e9sent\u00e9 sous diff\u00e9rents points de vue, prend des interpr\u00e9tations vari\u00e9es. Des embryons d\u2019histoires apparaissent.\n\nC\u2019est ensuite \u00e0 vous de d\u00e9cider \u00e0 quelle histoire vous voudriez que les com\u00e9diens donnent vraiment naissance. Quelle version avez-vous pr\u00e9f\u00e9r\u00e9 ? Quels personnages vous ont le plus touch\u00e9s ? Quel d\u00e9but d\u2019histoire a titill\u00e9 votre curiosit\u00e9 ? Votre d\u00e9but pr\u00e9f\u00e9r\u00e9 sera alors d\u00e9velopp\u00e9 dans la seconde partie du spectacle pour en faire un beau b\u00e9b\u00e9 de 40 minutes.\n\nPar vos propositions et vos choix, vous participez activement \u00e0 la cr\u00e9ation d\u2019une histoire unique port\u00e9e par l\u2019imagination des com\u00e9diens.","performers":"Les Sarrasins","boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Story-in-vitro","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50000124"},"sp":{"name":"Story in vitro","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Story-in-vitro","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50000124"},"nl":{"name":"Story in vitro","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Story-in-vitro","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50000124"}},"place":{"id":270611,"translations":{"de":{"name":"Th\u00e9\u00e2tre l\u2019Improviste ","address_street_name":"Rue de Fierlant","address_street_number":"120","address_street_box":null,"email":null,"website":"http:\/\/www.improviste.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Rue de Fierlant, 120","address_line2":"1190 Forest","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Th\u00e9\u00e2tre L'improviste","address_street_name":"Rue de Fierlant","address_street_number":"120","address_street_box":null,"email":null,"website":"http:\/\/www.improviste.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Rue de Fierlant, 120","address_line2":"1190 Forest","descripti