":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":310580,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"concert","ranking":0.7937005259840998,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":1,"translations":{"de":"Konzert","pt":null,"en":"Concert","it":"Concerti","cn":null,"fr":"Concert","sp":"Concierto","nl":"Concert"}},"others":{"list":[2],"translations":{"de":["Klassisch"],"pt":[null],"en":["Classical"],"it":["Classica"],"cn":[null],"fr":["Classique"],"sp":["Cl\u00e1sica"],"nl":["Klassiek"]}}},"translations":{"de":{"name":"Concert pour Enfants","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.bso-orchestra.be\/?p=234","email":"info@bso-orchestra.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700003067"},"pt":{"name":"Concert pour Enfants","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.bso-orchestra.be\/?p=234","email":"info@bso-orchestra.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700003067"},"en":{"name":"Concert pour Enfants","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.bso-orchestra.be\/?p=234","email":"info@bso-orchestra.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700003067"},"it":{"name":"Concert pour Enfants","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.bso-orchestra.be\/?p=234","email":"info@bso-orchestra.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700003067"},"cn":{"name":"Concert pour Enfants","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.bso-orchestra.be\/?p=234","email":"info@bso-orchestra.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700003067"},"fr":{"name":"Concert pour Enfants","shortdescr":"Un conte de f\u00e9es magique sur le Lac des Cygnes et le vilain petit canard. Avec orchestre live, chant et danse. Odette et Siegfried seront-ils r\u00e9unis ? Et notre vilain petit canard trouvera-t-il sa confiance ? Le BSO vous invite \u00e0 entrer dans un monde o\u00f9 la Musique rencontre la Magie, accompagn\u00e9 de ses danseurs, chanteurs et en collaboration avec l\u2019Acad\u00e9mie de Sint Pieters Woluwe. ","longdescr":"Le Petit Canard, le Prince et le Cygne\nIl \u00e9tait une fois, dans un pays magique, la charmante princesse Odette, ador\u00e9e de tous, et surtout du courageux chasseur, le prince Siegfried. Le m\u00e9chant sorcier Rothbart, jaloux de leur amour, transforma Odette en cygne et la bannit au myst\u00e9rieux lac des cygnes. Seul un serment  d\u2019amour v\u00e9ritable peut briser le sort qui la retenait captive.\n\nQuelque temps plus tard, tr\u00e8s loin de la for\u00eat enchant\u00e9e, Maman Canard veillait patiemment sur son nid, gardant sept pr\u00e9cieux \u0153ufs. Bien apr\u00e8s l\u2019\u00e9closion des six premiers, voil\u00e0 qu\u2019une petite t\u00eate sortit du dernier \u0153uf\u2026 un petit canard tr\u00e8s laid\u202f!\n\nMais quel retournement de destin ! Lors d\u2019une chasse au bord de la rivi\u00e8re, ce vilain petit canard croisa le prince Siegfried, et une belle amiti\u00e9 naquit.\n\nOdette et Siegfried seront-ils r\u00e9unis ? Et notre vilain petit canard trouvera-t-il sa confiance ? L\u2019Orchestre Symphonique de Bruocsella vous invite \u00e0 entrer dans un monde o\u00f9 la Musique rencontre la Magie, accompagn\u00e9 de ses danseurs, chanteurs et en collaboration avec l\u2019Acad\u00e9mie de Sint Pieters Woluwe. Notre belle histoire vous attend !\n\nPrix des billets :\nParterre \u2013 Adultes: \u20ac 22,-\nParterre \u2013 Enfants de moins de 18 ans: \u20ac 15,-\nBalcon \u2013 Adultes: \u20ac 16,-\nBalcon \u2013 Enfants de moins de 18 ans: \u20ac 9,-\nFauteuil roulant: \u20ac 16,- (veuillez nous contacter \u00e0 info@bso-orchestra.be)","performers":"Bruocsella Symphony Orchestra asbl (BSO)\nGabriel Hollander (Chef d'orchestre)\nAlexandre Diaconu (Metteur en sc\u00e8ne)\nP\u00e1id\u00ed \u00d3 Dubh\u00e1in (soloiste)\nJan Debski (narrateur)\nMarion Audoin (soloiste et chor\u00e9graphie)\nHeidi Chadjideris (chor\u00e9graphie)\nAvec L'Academie Sint-Peters-Wolluwe \n...et bien d'autres!\n","boxoffice_url":null,"website":"https:\/\/www.bso-orchestra.be\/?p=234","email":"info@bso-orchestra.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700003067"},"sp":{"name":"Concert pour Enfants","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.bso-orchestra.be\/?p=234","email":"info@bso-orchestra.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700003067"},"nl":{"name":"Concert pour Enfants","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.bso-orchestra.be\/?p=234","email":"info@bso-orchestra.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700003067"}},"place":{"id":50001732,"translations":{"de":{"name":"WHalll - Centre culturel de Woluwe-Saint-Pierre","address_street_name":"Avenue Charles Thielemans","address_street_number":"93","address_street_box":null,"email":"info@whalll.be","website":"https:\/\/whalll.be\/","phone_contact":"+32 2 435 59 99","phone_booking":null,"address_zip":"1150","address_city":"Woluwe-Saint-Pierre","address_line1":"Avenue Charles Thielemans, 93","address_line2":"1150 Woluwe-Saint-Pierre","description_web":