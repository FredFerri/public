notamment par le biais des ateliers organis\u00e9s pour les adultes et les enfants et la Court'Echelle, espace consacr\u00e9 \u00e0 la petite enfance.\r\nLieu d\u2019accueil, de rencontres, d\u2019\u00e9changes et de dialogue, la programmation de la Maison veut aller \u00e0 l'encontre des besoins et les r\u00e9alit\u00e9s quotidiennes des habitants de Molenbeek en privil\u00e9giant la cr\u00e9ation vers la mixit\u00e9 culturelle et les relations interg\u00e9n\u00e9rationnelles.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Maison des Cultures et de la coh\u00e9sion sociale de Molenbeek (MCCS)","address_street_name":"Rue Mommaerts","address_street_number":"4","address_street_box":null,"email":"culture.1080@molenbeek.irisnet.be","website":"http:\/\/www.lamaison1080hethuis.be","phone_contact":"+32 2 415 86 03","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Rue Mommaerts, 4","address_line2":"1080 Molenbeek-Saint-Jean","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Het Huis van Culturen en Sociale Samenhang van Molenbeek (HCSS)","address_street_name":"Mommaertsstraat","address_street_number":"4","address_street_box":null,"email":"culture.1080@molenbeek.irisnet.be","website":"http:\/\/www.lamaison1080hethuis.be","phone_contact":"+32 2 415 86 03","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Mommaertsstraat, 4","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"Het Huis van Culturen en Sociale Samenhang is een initiatief van openbare dienstverlening van de gemeente Sint-Jans-Molenbeek, gelegen in het hart van het historische Molenbeek, aan de symbolische grens van de andere kant van het kanaal. Het Huis van Culturen is een artistieke ruimte die nauwe banden aanhaalt met de bewoners door onder meer workshops te organiseren voor volwassenen en kinderen, en activiteiten in Court'Echelle, de ruimte gewijd aan de allerkleinsten. In een wijk rijk aan diverse bevolkingsgroepen, wil het Huis een plek zijn voor ontmoetingen, uitwisselingen en dialoog, en met de programmatie inspelen op de dagelijkse behoeften en realiteit van de inwoners van Molenbeek.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[8],"translations":{"de":["Kanal-Viertel"],"pt":[null],"en":["Canal"],"it":["Canal"],"cn":[null],"fr":["Canal"],"sp":["Canal"],"nl":["Kanaalwijk"]}},"zones":{"list":[23],"translations":{"de":["Westen"],"pt":[null],"en":["West"],"it":["Ovest"],"cn":[null],"fr":["Ouest"],"sp":["Oeste"],"nl":["West"]}},"neca":null,"facebook_id":null,"backoffice_id":5940,"location":{"lat":50.85787224,"lon":4.33818532},"region":"brussels","last_updated_at":"2023-09-21T15:13:36+02:00","published_at":"2013-10-19T01:19:34+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":243578,"translations":{"de":{"name":"Maison des Cultures et de la coh\u00e9sion sociale de Molenbeek (MCCS)","address_street_name":"Rue Mommaerts","address_street_number":"4","address_street_box":null,"email":"culture.1080@molenbeek.irisnet.be","website":"http:\/\/www.lamaison1080hethuis.be","phone_contact":"+32 2 415 86 03","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Rue Mommaerts, 4","address_line2":"1080 Molenbeek-Saint-Jean","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Maison des Cultures et de la coh\u00e9sion sociale de Molenbeek (MCCS)","address_street_name":"Rue Mommaerts","address_street_number":"4","address_street_box":null,"email":"culture.1080@molenbeek.irisnet.be","website":"http:\/\/www.lamaison1080hethuis.be","phone_con