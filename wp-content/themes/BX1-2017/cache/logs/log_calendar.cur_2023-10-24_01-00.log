com\/embed\/store.php?l=fr-be&merchant_id=7707&reseller_id=7912&reseller_location_id=8436&raut=610c7849226764b3b63876c02812959c095a1447df3e5167412ed6a38c7e16c747a273cd2a1f85ed5c6728056d25feac","website":"https:\/\/www.legodiscoverycentre.com\/brussels\/nl\/","email":"info.brussels@legodiscoverycentre.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50003482"}},"place":{"id":279507,"translations":{"de":{"name":"LEGO\u00ae Discovery Centre Brussels","address_street_name":"Boulevard Lambermont","address_street_number":"1","address_street_box":null,"email":"info.brussels@legodiscoverycentre.com","website":"https:\/\/www.legodiscoverycentre.com","phone_contact":null,"phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Boulevard Lambermont, 1","address_line2":"1030 Schaerbeek","description_web":"Treten Sie ein in das ultimative LEGO\u00ae-Abenteuer! Das LEGO Discovery Centre Brussels ist ein \u00fcber 3000 m2 gro\u00dfer, in 12 Aktivit\u00e4tsbereiche unterteilter, Ort f\u00fcr Kinder von 2 bis 10 Jahren und ihre Familien. Spielen Sie mit \u00fcber 2 Millionen LEGO Steine, nehmen Sie an einem unserer kreativen Workshops teil, die von unseren Master Model Builders geleitet werden, begeben Sie sich auf eine Zugfahrt durch eine riesige LEGO Welt, sehen Sie sich LEGO Filme in unserem 4D Kino an und vieles mehr! Ein Ort, an dem die Fantasie keine Grenzen gesetzt sind.\r\n\r\nDer Shop schlie\u00dft t\u00e4glich eine Stunde nach Schlie\u00dfung der Attraktion. \r\nDie \u00d6ffnungszeiten k\u00f6nnen variieren, die aktuellen Zeiten finden Sie unter : www.legodiscoverycentre.com\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"LEGO\u00ae Discovery Centre Brussels","address_street_name":"Boulevard Lambermont","address_street_number":"1","address_street_box":null,"email":"info.brussels@legodiscoverycentre.com","website":"htt