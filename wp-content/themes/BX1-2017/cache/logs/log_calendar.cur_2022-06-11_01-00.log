1:00:00"}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":{"list":[255,259,263,265],"translations":{"fr":["Accessible","Chien d'assistance","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9"],"nl":["Toegankelijk","Assistentiehonden","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet"],"en":["Accessible","Assistance dogs","Accessible to pedestrians with mobility aids","Adapted toilet"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-06-10T02:05:37+02:00","published_at":"2020-09-24T13:58:48+02:00","backoffice_id":224509,"import_origin":null,"sub_type":"misc","show_in_agenda":true,"ranking":0.14574684396522},{"id":533762,"date_start":"2022-06-18","date_end":"2022-06-18","date_next":"2022-06-18","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Visite guid\u00e9e graffiti et street art  - Cr\u00e9ons","shortdescr":"Depuis plus de 10 ans, Cr\u00e9ons investit les murs de Bruxelles. Au d\u00e9but, tr\u00e8s sages et statiques, on a vu les Crayons \u00e9voluer \u00e0 travers des mises en sc\u00e8ne.\r\nCette visite se concentre sur les graffiti des Crayons et leur \u00e9volution depuis leur apparition.","longdescr":"Fais le Trottoir propose diff\u00e9rents types de visites guid\u00e9es anim\u00e9es par deux personnes dont un artiste. Lors de ces balades, nous d\u00e9codons les signatures, expliquons l\u2019historique et les techniques de travail et les m\u00e9canismes propres \u00e0 ce mouvement.\r\n\r\nR\u00e9servation indispensable.\r\nVisite organis\u00e9e avec CFC Editions.\r\nPrix: 10\u20ac\/personne\r\nInfos et inscriptions: visitegraffiti@gmail.com","performers":"Fais le trottoir ASBL","boxoffice_url":null,"website":"http:\/\/www.faisletrottoir.com","email":"visitegraffiti@gmail.com","phone_contact":null,"phone_booking":"+32 488 98 70 33","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/533762.html"},"nl":{"name":"Visite guid\u00e9e graffiti et street art  - Cr\u00e9ons","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/533762.html"},"en":{"name":"Visite guid\u00e9e graffiti et street art  - Cr\u00e9ons","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/533762.html"},"de":{"name":"Visite guid\u00e9e graffiti et street art  - Cr\u00e9ons","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/533762.html"},"it":{"name":"Visite guid\u00e9e graffiti et street art  - Cr\u00e9ons","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/533762.html"},"sp":{"name":"Visite guid\u00e9e graffiti et street art  - Cr\u00e9ons","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/533762.html"},"pt":{"name":"Visite guid\u00e9e graffiti et street art  - Cr\u00e9ons","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/533762.html"},"cn":{"name":"Visite guid\u00e9e graffiti et street art  - Cr\u00e9ons","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/533762.html"}},"place":{"id":237158,"translations":{"fr":{"name":"Flagey","address_street_name":"Place Sainte-Croix","address_street_number":null,"address_street_box":null,"email":"info@flagey.be","website":"http:\/\/www.flagey.be","phone_contact":"+32 2 641 10 10","phone_booking":"+32 2 641 10 10","address_zip":"1050","address_city":"Ixelles","address_line1":"Place Sainte-Croix","address_line2":"1050 Ixelles","description_web":"Avec un regard tourn\u00e9 vers la place Flagey, vers les \u00e9tangs d'Ixelles, cet ancien b\u00e2timent de radio et de t\u00e9l\u00e9diffusion nationale est aujourd'hui plus que jamais un point de rencontre o\u00f9 diff\u00e9rentes disciplines artistiques se croisent dans un esprit de dialogue. Les amoureux de la culture de tous \u00e2ges sont les bienvenus dans ce magnifique b\u00e2timent Art d\u00e9co pour des concerts de jazz, de musique traditionnelle, de musique classique et contemporaine, mais c\u2019est \u00e9galement une place de choix pour le cin\u00e9ma et la vid\u00e9o.\r\nChaque ann\u00e9e, Flagey accueille les plus grands artistes d\u2019ici et d\u2019ailleurs mais est \u00e9galement une vitrine pour les jeunes talents (belges). \r\nGr\u00e2ce \u00e0 l'appui structurel des diff\u00e9rentes communaut\u00e9s belges, et par les qualit\u00e9s acoustiques exceptionnelles de ses salles, sa programmation vari\u00e9e ainsi que ses festivals telles que les Flagey Piano Days et le Brussels Jazz Festival, Flagey est devenu l'une des plus importantes maisons de la culture en Belgique et \u00e0 l'\u00e9tranger.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Flagey","address_street_name":"Heilig-Kruisplein","address_street_number":null,"address_street_box":null,"email":"info@flagey.be","website":"http:\/\/www.flagey.be","phone_contact":"+32 2 641 10 10","phone_booking":"+32 2 641 10 10","address_zip":"1050","address_city":"Elsene","address_line1":"Heilig-Kruisplein","address_line2":"1050 Elsene","description_web":"Gelegen aan het Flageyplein naast de vijvers van Elsene, is dit voormalige nationale radio- en televisiegebouw een plek waar  verschillende artistieke disciplines elkaar kruisen. Cultuurliefhebbers van alle leeftijden kunnen terecht in dit prachtige art deco gebouw voor zowel jazz, wereldmuziek, als klassieke en hedendaagse muziek, maar ook voor films en videoprojecten. \r\nFlagey ontvangt jaarlijks de allergrootste artiesten uit binnen- en buitenland en wil ook kansen bieden aan jong (Belgisch) talent. \r\nDankzij de structurele steun van de verschillende Belgische gemeenschappen, door de uitzonderlijke akoestische kwaliteiten van de zalen, de gevarieerde programmatie, en door eigen festivals zoals de Flagey Piano Days en het Brussels Jazz Festival, is Flagey uitgegroeid tot \u00e9\u00e9n van de belangrijkste cultuurhuizen in binnen- en buitenland.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Flagey","address_street_name":"place Sainte-Croix","address_street_number":null,"address_street_box":null,"email":"info@flagey.be","website":"http:\/\/www.flagey.be","phone_contact":"+32 2 641 10 10","phone_booking":"+32 2 641 10 10","address_zip":"1050","address_city":"Ixelles","address_line1":"place Sainte-Croix","address_line2":"1050 Ixelles","description_web":"Located on the edge of the Flagey square and next to the Ixelles ponds, this building \u2013 formerly the headquarters of the national radio and television institution \u2013 has now more than ever become a crossroad where artistic disciplines can meet and exchange ideas. Culture lovers of all ages are welcome in this beautiful Art Deco building, to take part in various events which range from concerts of jazz, world, classical and contemporary music, to film events and video projects. Each year, Flagey has the honor of receiving some of the world\u2019s most prominent artists, yet it still insists on offering opportunities to younger (Belgian) talents.\r\n\r\nThanks to the structural support of the different Belgian communities, and because of the exceptional acoustic qualities of the concert studios, the diversity of programming and events such as the Flagey Piano Days and the Brussels Jazz Festival, Flagey is today one of the leading culture houses on the national as well as the international scene.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Flagey","address_street_name":"Place Sainte-Croix","address_street_number":null,"address_street_box":null,"email":"info@flagey.be","website":"http:\/\/www.flagey.be","phone_contact":"+32 2 641 10 10","phone_booking":"+32 2 641 10 10","address_zip":"1050","address_city":"Ixelles","address_line1":"Place Sainte-Croix","address_line2":"1050 Ixelles","description_web":"Das ehemalige Rundfunkgeb\u00e4ude mit Blick auf den Place Flagey und die Teiche von Ixelles ist heute mehr denn je ein Ort der Begegnungen f\u00fcr unterschiedliche k\u00fcnstlerische Disziplinen. Das kulturelle Angebot ist ebenso beeindruckend wie das Art-d\u00e9co-Geb\u00e4ude selbst: Jazz, traditionelle Musik, klassische und zeitgen\u00f6ssische Musik, Film- und Videokunst\u2026 Dank der hervorragenden Akustik haben verschiedene Festivals den Konzertsaal des Flagey zu ihrer B\u00fchne auserkoren, darunter die Flagey Piano Days und das Brussels Jazz Festival. Doch auch junge (belgische) Talente bekommen hier die Gelegenheit, ihr Talent unter Beweis zu stellen.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Flagey","address_street_name":"place Sainte-Croix","address_street_number":null,"address_street_box":null,"email":"info@flagey.be","website":"http:\/\/www.flagey.be","phone_contact":"+32 2 641 10 10","phone_booking":"+32 2 641 10 10","address_zip":"1050","address_city":"Ixelles","address_line1":"place Sainte-Croix","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Flagey","address_street_name":"Place Sainte-Croix","address_street_number":null,"address_street_box":null,"email":"info@flagey.be","website":"http:\/\/www.flagey.be","phone_contact":"+32 2 641 10 10","phone_booking":"+32 2 641 10 10","address_zip":"1050","address_city":"Ixelles","address_line1":"Place Sainte-Croix","address_line2":"1050 Ixelles","description_web":"Situado al borde de la plaza Flagey y cerca de los estanques de Ixelles, este edificio \u2013 anteriormente la sede central de la radio nacional y la televisi\u00f3n p\u00fablica \u2013 ahora m\u00e1s que nunca se ha convertido en un cruce donde las disciplinas art\u00edsticas pueden encontrarse y compartir ideas. Los amantes de la cultura de todas las edades son bienvenidos a este hermoso edificio Art D\u00e9co, para tomar parte en diversos eventos que var\u00edan desde conciertos de jazz, m\u00fasica universal, cl\u00e1sica y m\u00fasica contempor\u00e1nea hasta eventos cinematogr\u00e1ficos y proyecciones de video. Cada a\u00f1o, Flagey tiene el honor de recibir a algunos de los artistas m\u00e1s destacados del mundo, pero a\u00fan as\u00ed insiste en ofrecer una oportunidad a j\u00f3venes talentos.\r\n\r\nGracias al apoyo estructural de las diferentes comunidades belgas y a las excepcionales cualidades ac\u00fasticas de las salas de conciertos, la diversidad de programas y eventos tales como Flagey Piano Days y el Brussels Jazz Festival, Flagey es hoy una de las casas l\u00edderes en cultura en el plano nacional, as\u00ed como en el internacional.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Flagey","address_street_name":"Place Sainte-Croix","address_street_number":null,"address_street_box":null,"email":"info@flagey.be","website":"http:\/\/www.flagey.be","phone_contact":"+32 2 641 10 10","phone_booking":"+32 2 641 10 10","address_zip":"1050","address_city":"Ixelles","address_line1":"Place Sainte-Croix","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Flagey","address_street_name":"Place Sainte-Croix","address_street_number":null,"address_street_box":null,"email":"info@flagey.be","website":"http:\/\/www.flagey.be","phone_contact":"+32 2 641 10 10","phone_booking":"+32 2 641 10 10","address_zip":"1050","address_city":"Ixelles","address_line1":"Place Sainte-Croix","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[5],"translations":{"fr":["Flagey"],"nl":["Flagey"],"en":["Flagey"]}},"zones":{"list":[21],"translations":{"fr":["Sud"],"nl":["Zuid"],"en":["South"]}},"neca":null,"facebook_id":null,"backoffice_id":1708,"location":{"lat":50.82686549,"lon":4.37279903},"region":"brussels","last_updated_at":"2022-05-16T12:05:06+02:00","published_at":"2013-10-19T01:14:34+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":265511,"translations":{"fr":{"name":"Fais le trottoir","address_street_name":"Avenue Jean Volders","address_street_number":null,"address_street_box":null,"email":"visitegraffiti@gmail.com","website":"http:\/\/www.faisletrottoir.com","phone_contact":"+32 488 98 70 33","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Avenue Jean Volders","address_line2":"1060 Saint-Gilles","description_web":"","description_print":"","booking_url":nu