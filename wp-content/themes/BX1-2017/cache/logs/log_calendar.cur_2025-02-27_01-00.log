24T01:01:07+01:00","published_at":"2024-09-25T15:38:46+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":308448,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"other","ranking":0.2403749283845681,"languages":{"spoken":["en","nl","fr"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[36],"translations":{"de":["Museen & Kunstzentren"],"pt":[null],"en":["Museums and art centers"],"it":["Musei e centri artistici"],"cn":[null],"fr":["Mus\u00e9es et art centers"],"sp":["Museos y centros de arte"],"nl":["Musea en kunstcentra"]}}},"translations":{"de":{"name":"Fin et d\u00e9but \/ Einde en begin","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.imal.org\/en\/events\/endbeginning","email":"info@imal.org","phone_contact":"+32 2 410 30 93","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700001770"},"pt":{"name":"Fin et d\u00e9but \/ Einde en begin","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.imal.org\/en\/events\/endbeginning","email":"info@imal.org","phone_contact":"+32 2 410 30 93","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700001770"},"en":{"name":"Fin et d\u00e9but \/ Einde en begin","shortdescr":"Challenging long-held notions of human singularity, excessive progress, and growth \u00ab Fin et d\u00e9but \/ Einde en begin \u00bb redefines the notion of care as an ecological and relational structure; as a polyphonic assemblage of shared existence between human, nature and technology.","longdescr":"What comes after damaged landscapes? Where do we build our futures on? And with whom?\n\nIn her poem End and Beginning, the Polish Nobel Laureate Wis\u0142awa Szymborska, describing a barren landscape in the aftermath of war, weaves a narrative of resilience, reflection, and hope. Reflecting on the struggles for renewal, healing and collective responsibility her words carry a diachronic significance. Although referring to a specific conflict, her verses hold a frightening and unfortunate universal validity making her call for communal action, empathy, and care more relevant than ever. Inspired by Szymborska's reflection on the collapse of ideologies, the relentless passage of time and history, and the irreversible decay of the past along with everything that comes with it, iMAL wonders: How would a future built on empathy and collective care look like?\n\nChallenging long-held notions of human singularity, excessive progress, and growth Fin et d\u00e9but \/ Einde en begin redefines the notion of care as an ecological and relational structure; as a polyphonic assemblage of shared existence between human, nature and technology. Embarking on an exploratory journey into alternative systems of care between humans and non-human entities, this exhibition offers a place of transformative encounters fostering self-reflection and re-imagination of the infinite possibilities of our shared futures.\n\nCurated as an intricate narrative of care, the exhibition unfolds across three interconnected circles: Care for Humans, Care for Nature and Care for Technology. The exhibition presents 11 works produced within the European Media Arts Platform (EMAP) residency program and 4 recent productions by Belgium-based artists. Their encounter offers space for reflection and reconsideration of formative societal infrastructures such as labour, communal practices, energy consumption and highlights the vitality for inter-species knowledge exchange and the importance of empathy for humans and other-than-human entities through diverse lenses. By giving agency to and drawing connections between underrepresented voices and alternative perspectives\u2014be they human, artificial, natural, or imaginative\u2014the exhibition invites the public to take a step towards unexplored territories of our shared futures and reimagine resilient collective ecosystems rooted in multispecies cooperation.\n\nHere, \"everything is intelligent and worthy of our care and conscious attention.\" (James Bridle, Ways of Being)","performers":null,"boxoffice_url":null,"website":"https:\/\/www.imal.org\/en\/events\/endbeginning","email":"info@imal.org","phone_contact":"+32 2 410 30 93","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700001770"},"it":{"name":"Fin et d\u00e9but \/ Einde en begin","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.imal.org\/en\/events\/endbeginning","email":"info@imal.org","phone_contact":"+32 2 410 30 93","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700001770"},"cn":{"name":"Fin et d\u00e9but \/ Einde en begin","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.imal.org\/en\/events\/endbeginning","email":"info@imal.org","phone_contact":"+32 2 410 30 93","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700001770"},"fr":{"name":"Fin et d\u00e9but \/ Einde en begin","shortdescr":"\u00ab Fin et d\u00e9but \/ Einde en begin \u00bb remet en question les concepts de singularit\u00e9 humaine, ainsi que de progr\u00e8s et de croissance \u00e0 tout prix. L'exposition propose une red\u00e9finition de la notion de \u00ab soin \u00bb en tant que structure \u00e9cologique et relationnelle ; un assemblage polyphonique d'existences partag\u00e9es entre l'homme, la nature et la technologie. ","longdescr":"Que se passe-t-il apr\u00e8s les paysages endommag\u00e9s ? O\u00f9 construisons-nous notre avenir ? Et avec qui ?\n\nDans son po\u00e8me \" Fin et d\u00e9but\", la laur\u00e9ate polonaise du prix Nobel Wis\u0142awa Szymborska d\u00e9crit un paysage d\u00e9vast\u00e9 au lendemain de la guerre et tisse un r\u00e9cit de r\u00e9silience, de r\u00e9flexion et d'espoir. R\u00e9fl\u00e9chissant aux luttes pour la reconstruction, la gu\u00e9rison et la responsabilit\u00e9 collective, ses mots ont une signification diachronique. Bien qu'ils fassent r\u00e9f\u00e9rence \u00e0 un conflit sp\u00e9cifique, ses vers ont une validit\u00e9 universelle effrayante et malheureuse, ce qui rend son appel \u00e0 l'action collective, \u00e0 l'empathie et \u00e0 l'attention plus pertinent que jamais. Inspir\u00e9 par la r\u00e9flexion de Szymborska sur l'effondrement des id\u00e9ologies, le passage inexorable du temps et de l'histoire, et la d\u00e9composition irr\u00e9versible du pass\u00e9 et de tout ce qui s\u2019y rapporte, iMAL s'interroge : \u00e0 quoi ressemblerait un avenir fond\u00e9 sur l'empathie et l'attention collective ?\n\nRemettant en question les notions de singularit\u00e9 humaine, de progr\u00e8s excessif et de croissance, Fin et d\u00e9but \/ Einde en begin red\u00e9finit la notion de soin en tant que structure \u00e9cologique et relationnelle, en tant qu'assemblage polyphonique d'existence partag\u00e9e entre les humain\u00b7es, la nature et la technologie. Embarquant pour un voyage exploratoire dans les syst\u00e8mes alternatifs de soins entre les humains et les entit\u00e9s non-humaines, cette exposition offre un lieu de rencontre transformateur encourageant l'auto-r\u00e9flexion et la reconsid\u00e9ration des possibilit\u00e9s infinies de notre avenur commun.\n\nCon\u00e7ue comme un r\u00e9cit complexe du soin, l'exposition se d\u00e9ploie en trois cercles interconnect\u00e9s : soins aux personnes, soins \u00e0 la nature et soins \u00e0 la technologie. L'exposition pr\u00e9sente 11 \u0153uvres produites dans le cadre du programme de r\u00e9sidence de l'European Media Arts Platform (EMAP) et 4 productions r\u00e9centes d'artistes bas\u00e9\u00b7es en Belgique. Leur rencontre offre un espace de r\u00e9flexion et de reconsid\u00e9ration des infrastructures sociales formatrices telles que le travail, les pratiques communautaires et la consommation d'\u00e9nergie. Elle met en lumi\u00e8re la vitalit\u00e9 de l'\u00e9change de connaissances entre les esp\u00e8ces et l'importance de l'empathie pour les personnes et les entit\u00e9s autres qu'humaines, vues \u00e0 travers diverses perspectives et approches. En donnant la parole et en mettant en relation des r\u00e9flexions sous-repr\u00e9sent\u00e9es et des perspectives alternatives - qu'elles soient humaines, artificielles, naturelles ou imaginatives - l'exposition Fin et d\u00e9but \/ End and Begin invite le public \u00e0 p\u00e9n\u00e9trer dans des zones inexplor\u00e9es de notre avenir commun et \u00e0 imaginer des \u00e9cosyst\u00e8mes collectifs r\u00e9silients enracin\u00e9s dans une coop\u00e9ration multi-esp\u00e8ces.\n\nIci, \u00ab tout a un sens et m\u00e9rite notre attention et notre vigilance\u00bb. (James Bridle, Ways of Being)","performers":"Annelie Berner ; Johanna Bruckner ; Nicolas Gourault ; Darsha Hewitt ; Dasha Ilina ; Rosa Menkman ; Vivien Roubaud ; Caroline Sinders (in collaboration with Trammell Hudson) ; Studio Above & Below\nEndi Tupja (in collaboration with Klodianna Millona) ; The (new) Constellation (T(n)C) ; Total Refusal ; Ava Zevop ; Alex Verhaest","boxoffice_url":null,"website":"https:\/\/www.imal.org\/en\/events\/endbeginning","email":"info@imal.org","phone_contact":"+32 2 410 30 93","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700001770"},"sp":{"name":"Fin et d\u00e9but \/ Einde en begin","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.imal.org\/en\/events\/endbeginning","email":"info@imal.org","phone_contact":"+32 2 410 30 93","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700001770"},"nl":{"name":"Fin et d\u00e9but \/ Einde en begin","shortdescr":"In \u201c Fin et d\u00e9but \/ Einde en begin \u201d wordt het begrip zorg opnieuw gedefinieerd als een ecologische en relationele structuur; als een polyfone assemblage van een gedeeld bestaan tussen mens, natuur en technologie.","longdescr":"Wat komt er na beschadigde landschappen? Waar bouwen we onze toekomst op? En met wie?\n\nIn haar gedicht Einde en Begin, beschrijft de Poolse Nobelprijswinnares Wis\u0142awa Szymborska een beschadigd en verwoest landschap in de nasleep van een oorlog en vlecht ze een verhaal van veerkracht, reflectie en hoop. Reflecterend op de strijd voor wederopbouw, heling en collectieve verantwoordelijkheid dragen haar woorden een diachronische betekenis. Hoewel ze verwijst naar een specifiek conflict, hebben haar dichtregels een beangstigende en ongelukkige universele geldigheid, waardoor haar oproep tot gezamenlijke actie, empathie en zorg relevanter is dan ooit. Ge\u00efnspireerd door Szymborska's reflectie op de ineenstorting van ideologie\u00ebn, het meedogenloze verstrijken van tijd en geschiedenis, en het onomkeerbare verval van het verleden en samen met alles wat zich daarmee verhoudt, bevraagt iMAL zich: Hoe zou een toekomst eruit zien die gegrondvest is op empathie en collectieve zorg?\n\nFin et d\u00e9but \/ Einde en begin daagt de gehandhaafde concepten van menselijke singulariteit, excessieve vooruitgang en groei uit, en herdefinieert het begrip zorg als een ecologische en relationele structuur; als een polyfone assemblage van innige verbondenheid en gedeeld bestaan tussen mens, natuur en technologie. De tentoonstelling is een ontdekkingsreis naar alternatieve zorgsystemen tussen mensen en niet-menselijke entiteiten. Het biedt een plek voor transformatieve ontmoetingen die zelfreflectie en herbezinning op de oneindige mogelijkheden van onze gezamenlijke toekomst stimuleert.\n\nSamengesteld als een ingewikkeld verhaal over zorg ontvouwt de tentoonstelling zich in drie onderling verbonden principi\u00eble stellingnames: Zorg voor Mensen, Zorg voor Natuur en Zorg voor Technologie. Fin et d\u00e9but \/ Einde en begin presenteert samen 11 werken geproduceerd binnen het European Media Arts Platform (EMAP)-residentieprogramma en 4 recente producties van in Belgi\u00eb gevestigde kunstenaars. Deze voor het publiek nieuwe ontdekkingsgelegenheid biedt ruimte voor reflectie en heroverweging van vormende maatschappelijke infrastructuren zoals arbeid, gemeenschappelijke praktijken en energieverbruik. Het benadrukt de vitaliteit van kennisuitwisseling tussen species en het belang van empathie voor mensen en andere-dan-menselijke entiteiten gezien door verschillende invalshoeken en benaderingen. Door ondervertegenwoordigde beschouwingen en alternatieve perspectieven - menselijke, kunstmatige, natuurlijke of fantasievolle - een stem te verlenen en met elkaar in verband te brengen, nodigt de tentoonstelling Fin et d\u00e9but \/ Einde en begin het publiek uit om een stap te zetten naar onontgonnen gebieden van onze gedeelde toekomst en zich veerkrachtige collectieve ecosystemen voor te stellen die geworteld zijn in samenwerking tussen de verscheidene levensvormen.\n\nHier heeft \u201calles zin en onze zorg en bewuste aandacht waard\u201d. (James Bridle, Ways of Being)","performers":null,"boxoffice_url":null,"website":"https:\/\/www.imal.org\/en\/events\/endbeginning","email":"info@imal.org","phone_contact":"+32 2 410 30 93","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700001770"}},"place":{"id":240068,"translations":{"de":{"name":"iMAL, Center for Digital Cultures and Technology","address_street_name":"Quai des Charbonnages","address_street_number":null,"address_street_box":null,"email":"info@imal.org","website":"http:\/\/www.imal.org","phone_contact":"+32 2 410 30 93","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Quai des Charbonnages","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"iMAL ist ein international anerkanntes Kunstzentrum im Br\u00fcsseler Stadtzentrum, das den digitalen Kulturen und Technologien gewidmet ist. Sein Status als Vorreiter auf diesem Gebiet seit mehr als 20 Jahren wird durch die Er\u00f6ffnung des neuen Standorts weiter gest\u00e4rkt. Das iMAL umfasst einen gro\u00dfen Ausstellungsraum, ein hochmodernes und erweitertes FabLab und eine digitale Bibliothek.","description_print":null,"booking_url":null,"sort_order":"IMAL, CENTER FOR DIGITAL CULTURES AND TECHNOLOGY","virtual_visit":null,"visit_url":null},"pt":{"name":"iMAL, Center for Digital Cultures and Technology","address_street_name":"Quai des Charbonnages","address_street_number":null,"address_street_box":null,"email":"info@imal.org","website":"http:\/\/www.imal.org","phone_contact":"+32 2 410 30 93","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Quai des Charbonnages","address_line2":"1080 Molenbeek-Saint-Jean","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"iMAL, Center for Digital Cultures and Technology","address_street_name":"Quai des Charbonnages","address_street_number":null,"address_street_box":null,"email":"info@imal.org","website":"http:\/\/www.imal.org","phone_contact":"+32 2 410 30 93","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Quai des Charbonnages","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"iMAL is an art center for digital cultures and technology, located in the center of Brussels. Our international position as pioneer in this field since 20+ years was reinforced in 2020 with the opening of our new venue, including a large exhibition space, an expanded state-of-the-art Fablab, a digital library and more.\r\nWe support artistic and creative practices using (digital) technologies as their medium. Next to providing support for artists in their experimentation-, research- and production processes, iMAL is hosting art exhibitions, conferences, performances. Furthermore we also facilitates critical reflection, research and debates around the current and future challenges of our technological society, by stimulating cross-pollinations between art and technology.\r\nWith our wide range of activities and elaborated mediation program, we aim to empower people and inspire the next generations to actively participate in today and future digital cultures. Our Fablab encourages social inclusion and innovation towards sustainable development within the local community of Molenbeek.","description_print":null,"booking_url":null,"sort_order":"IMAL, CENTER FOR DIGITAL CULTURES AND TECHNOLOGY","virtual_visit":null,"visit_url":null},"it":{"name":"iMAL, Center for Digital Cultures and Technology","address_street_name":"Quai des Charbonnages","address_street_number":null,"address_street_box":null,"email":"info@imal.org","website":"http:\/\/www.imal.org","phone_contact":"+32 2 410 30 93","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Quai des Charbonnages","address_line2":"1080 Molenbeek-Saint-Jean","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"iMAL, Center for Digital Cultures and Technology","address_street_name":"Quai des Charbonnages","address_street_number":null,"address_street_box":null,"email":"info@imal.org","website":"http:\/\/www.imal.org","phone_contact":"+32 2 410 30 93","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Quai des Charbonnages","address_line2":"1080 Molenbeek-Saint-Jean","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"iMAL, Center for Digital Cultures and Technology","address_street_name":"Quai des Charbonnages","address_street_number":null,"address_street_box":null,"email":"info@imal.org","website":"http:\/\/www.imal.org","phone_contact":"+32 2 410 30 93","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Quai des Charbonnages","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"iMAL est un centre d\u2019art de\u0301die\u0301 aux cultures et technologies nume\u0301riques, situe\u0301 dans le centre de Bruxelles et reconnu internationalement. Sa position de pionnier dans le domaine depuis plus de 20 ans est renforce\u0301e par l\u2019ouverture de son nouveau lieu, qui comprend entre autres un grand espace d\u2019exposition, un FabLab de pointe et agrandi, et une bibliothe\u0300que du nume\u0301rique.\r\nL\u2019objectif d\u2019iMAL est de soutenir les pratiques artistiques et cre\u0301atives en lien avec les nouvelles technologies, en accueillant des expositions, confe\u0301rences et performances. iMAL soutient les artistes dans leur recherche, expe\u0301rimentation et production mais iMAL est e\u0301galement un centre de re\u0301flexion ou\u0300 l\u2019on investigue et de\u0301bat des enjeux pre\u0301sents et futurs de la socie\u0301te\u0301 technologique, en favorisant les croisements entre art, science et technologie.\r\nAvec ses activite\u0301s e\u0301ducatives et de me\u0301diation, iMAL vise a\u0300 e\u0301manciper tous les publics, et permettre aux futures ge\u0301ne\u0301rations de fac\u0327onner les cultures nume\u0301riques de demain. Le FabLab cre\u0301atif d\u2019iMAL encourage l\u2019inclusion sociale dans la communaute\u0301 locale de Molenbeek et du Canal, ainsi que l\u2019innovation vers un de\u0301veloppement plus durable.","description_print":null,"booking_url":null,"sort_order":"IMAL, CENTER FOR DIGITAL CULTURES AND TECHNOLOGY","virtual_visit":null,"visit_url":null},"sp":{"name":"iMAL, Center for Digital Cultures and Technology","address_street_name":"Quai des Charbonnages","address_street_number":null,"address_street_box":null,"email":"info@imal.org","website":"http:\/\/www.imal.org","phone_contact":"+32 2 410 30 93","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Quai des Charbonnages","address_line2":"1080 Molenbeek-Saint-Jean","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"iMAL, Center for Digital Cultures and Technology","address_street_name":"Koolmijnenkaai","address_street_number":null,"address_street_box":null,"email":"info@imal.org","website":"http:\/\/www.imal.org","phone_contact":"+32 2 410 30 93","phone_booking":null,"address_zip":"1080","address_city":"Sint-Jans-Molenbeek","address_line1":"Koolmijnenkaai","address_line2":"1080 Sint-Jans-Molenbeek","description_web":"iMAL is een kunstencentrum voor digitale cultuur en technologie, in het centrum van Brussel. Onze internationale positie als pionier in dit veld sinds 1999 werd in 2020 nog versterkt met de opening van een nieuw gebouw met een grotere expositieruimte, een uitgebreid Fablab, een digitale bibliotheek en meer.\r\nAls organisatie ondersteunen we artistieke en creatieve praktijken die (digitale) technologie als medium gebruiken. Naast het begeleiden van artiesten bij het experimenteren, onderzoeken en ontwerpen, organiseren wij ook tentoonstellingen, conferenties, performances. Verder proberen we het publieke debat en de kritische reflectie rond de huidige en toekomstige uitdagingen van onze technologische samenleving op gang te brengen en te ondersteunen door de kruisbestuiving tussen kunst, wetenschap en technologie te stimuleren.\r\nMet onze brede waaier aan activiteiten en een uitgebreid educatief programma is ons doel om iedereen met een interesse in de kunsten en technologie te inspireren om actief deel uit te maken van digitale cultuur. Ons Fablab werkt op haar beurt rond verschillende sociale en innovatieve projecten die bijdragen tot een duurzame ontwikkeling binnen de lokale gemeenschap in Molenbeek.","description_print":null,"booking_url":null,"sort_order":"IMAL, CENTER FOR DIGITAL CULTURES AND TECHNOLOGY","virtual_visit":null,"visit_url":null}},"districts":{"list":[8],"translations":{"de":["Kanal-Viertel"],"pt":[null],"en":["Canal"],"it":["Canal"],"cn":[null],"fr":["Canal"],"sp":["Canal"],"nl":["Kanaalwijk"]}},"zones":{"list":[23],"translations":{"de":["Westen"],"pt":[null],"en":["West"],"it":["Ovest"],"cn":[null],"fr":["Ouest"],"sp":["Oeste"],"nl":["West"]}},"neca":"art_center","facebook_id":null,"backoffice_id":2724,"location":{"lat":50.85475543,"lon":4.34206481},"region":"brussels","last_updated_at":"2023-09-19T16:50:32+02:00","published_at":"2013-10-19T01:15:29+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":240068,"translations":{"de":{"name":"iMAL, Center for Digital Cultures and Technology","address_street_name":"Quai des Charbonnages","address_street_number":null,"address_street_box":null,"email":"info@imal.org","website":"http:\/\/www.imal.org","phone_contact":"+32 2 410 30 93","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Quai des Charbonnages","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"iMAL ist ein international anerkanntes Kunstzentrum im Br\u00fcsseler Stadtzentrum, das den digitalen Kulturen und Technologien gewidmet ist. Sein Status als Vorreiter auf diesem Gebiet seit mehr als 20 Jahren wird durch die Er\u00f6ffnung des neuen Standorts weiter gest\u00e4rkt. Das iMAL umfasst einen gro\u00dfen Ausstellungsraum, ein hochmodernes und erweitertes FabLab und eine digitale Bibliothek.","description_print":null,"booking_url":null,"sort_order":"IMAL, CENTER FOR DIGITAL CULTURES AND TECHNOLOGY","virt