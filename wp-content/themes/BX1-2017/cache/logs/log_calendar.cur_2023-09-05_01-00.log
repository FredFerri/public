1":"de Berlaimontlaan, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[],"translations":{}},"zones":[],"neca":null,"facebook_id":null,"backoffice_id":41177,"location":{"lat":50.848849,"lon":4.3592517},"region":"brussels","last_updated_at":"2023-08-28T11:11:30+02:00","published_at":"2023-08-28T11:11:30+02:00","import_origin":null,"external_id":null,"is_in_vb_export":false,"resto_ranking":0},"organizer":{"id":220155,"translations":{"de":{"name":"Mus\u00e9e de la Banque Nationale de Belgique","address_street_name":"rue Montagne aux Herbes potag\u00e8res","address_street_number":"57","address_street_box":null,"email":"museum@nbb.be","website":"http:\/\/www.nbbmuseum.be","phone_contact":"+32 2 221 22 06","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"rue Montagne aux Herbes potag\u00e8res, 57","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Mus\u00e9e de la Banque Nationale de Belgique","address_street_name":"rue Montagne aux Herbes potag\u00e8res","address_street_number":"57","address_street_box":null,"email":"museum@nbb.be","website":"http:\/\/www.nbbmuseum.be","phone_contact":"+32 2 221 22 06","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"rue Montagne aux Herbes potag\u00e8res, 57","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Museum of the National Bank of Belgium","address_street_name":"rue Montagne aux Herbes potag\u00e8res","address_street_number":"57","address_street_box":null,"email":"museum@nbb.be","website":"http:\/\/www.nbbmuseum.be","phone_contact":"+32 2 221 22 06","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"rue Montagne aux Herbes potag\u00e8res, 57","address_line2":"1000 Bruxelles","description_web":"Since 2018 the museum of the National Bank of Belgium is housed in a splendid 19t century bank building situates at a mere 10-minute walk from the Central Station.\r\n\r\nThe first part of the exhibition pays particular attention to the role and the functions of the National Bank. By use of an audio guide and interactive displays, the visitor will no doubt discover lots of interesting facts about the issue of notes and coins, test their knowledge of the euro, or even try to control the rate of inflation.\r\n\r\nThe second part paints an overall picture of the evolution of money, and showcases many wonderful objects from the museum collection. Commodity money, diverse and peculiar objects once used for bartering, coins and notes... These many various pieces are purposely put in a thematical and chronological context which in the end will provide the visitor with a fascinating overview.\r\n\r\nThe third part of the exhibition proves just how much money is present in our day to day life by displaying a wide range of objects, some everyday and trivial, some quirky.\r\n\r\nGroup visits can be from 10 people up to 25. They are free and take about 1 hour. Please book via the website of the museum https:\/\/www.nbbmuseum.be\/en\/booking.\r\nMore information: 02 221 22 06 - museum@nbb.be ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Mus\u00e9e de la Banque Nationale de Belgique","address_street_name":"rue Montagne aux Herbes potag\u00e8res","address_street_number":"57","address_street_box":null,"email":"museum@nbb.be","website":"http:\/\/www.nbbmuseum.be","phone_contact":"+32 2 221 22 06","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"rue Montagne aux Herbes potag\u00e8res, 57","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Mus\u00e9e de la Banque Nationale de Belgique","address_street_name":"rue Montagne aux Herbes potag\u00e8res","address_street_number":"57","address_street_box":null,"email":"museum@nbb.be","website":"http:\/\/www.nbbmuseum.be","phone_contact":"+32 2 221 22 06","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"rue Montagne aux Herbes potag\u00e8res, 57","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"fr":{"name":"Mus\u00e9e de la Banque Nationale de Belgique","address_street_name":"rue Montagne aux Herbes potag\u00e8res","address_street_number":"57","address_street_box":null,"email":"museum@nbb.be","website":"http:\/\/www.nbbmuseum.be","phone_contact":"+32 2 221 22 06","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"rue Montagne aux Herbes potag\u00e8res, 57","address_line2":"1000 Bruxelles","description_web":"Depuis 2018, le mus\u00e9e de la Banque nationale de Belgique est install\u00e9 dans un magnifique b\u00e2timent bancaire datant du XIXe si\u00e8cle. \r\n\r\nUn premier circuit dans le mus\u00e9e aborde les r\u00f4les d\u2019une banque centrale \u00e0 travers une sc\u00e9nographie interactive. Gr\u00e2ce \u00e0 son audioguide, le visiteur peut ainsi tant\u00f4t en apprendre un peu plus sur l\u2019\u00e9mission des pi\u00e8ces et des billets, tant\u00f4t tester ses connaissances sur l\u2019euro ou encore \u00eatre amen\u00e9 \u00e0 contr\u00f4ler le niveau d\u2019inflation. \r\n\r\nLe second circuit retrace l\u2019\u00e9volution des moyens de payement et fait la part belle aux collections historiques du mus\u00e9e. Monnaies marchandises, anciens objets de change, anciennes pi\u00e8ces et billets se c\u00f4toient ainsi dans une fresque th\u00e9matique et chronologique qui fera voyager le visiteur dans le temps et \u00e0 travers le monde.\r\n\r\nEnfin, le dernier circuit regroupe une s\u00e9rie d\u2019objets qui d\u00e9montre \u00e0 quel point l\u2019argent est pr\u00e9sent dans notre quotidien.\r\n\r\nLes visites de groupe sont organis\u00e9es \u00e0 partir de 10 personnes - maximum 25. Elles sont gratuites et durent environ 1 heure. Les r\u00e9servations se font via le formulaire en ligne disponible sur le site internet http:\/\/www.nbbmuseum.be\/fr\/booking. \r\nRenseignements : 02 221 22 06 \u2013 museum@nbb.be","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Mus\u00e9e de la Banque Nationale de Belgique","address_street_name":"rue Montagne aux Herbes potag\u00e8res","address_street_number":"57","address_street_box":null,"email":"museum@nbb.be","website":"http:\/\/www.nbbmuseum.be","phone_contact":"+32 2 221 22 06","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"rue Montagne aux Herbes potag\u00e8res, 57","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Museum van de Nationale Bank van Belgi\u00eb","address_street_name":"Warmoesberg","address_street_number":"57","address_street_box":null,"email":"museum@nbb.be","website":"http:\/\/www.nbbmuseum.be","phone_contact":"+32 2 221 22 06","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Warmoesberg, 57","address_line2":"1000 Bruxelles","description_web":"Sinds 2018 is het museum van de Nationale Bank van Belgi\u00eb in een prachtig 19de-eeuwse bankgebouw ondergebracht.\r\n\r\nAan de hand van interactieve opstellingen focust een eerste parcours in het museum op de taken van een centrale bank. Met behulp van een audiogids kan de bezoeker meer te weten komen over de uitgifte van munten en biljetten, zijn of haar kennis van de euro testen of proberen de inflatie onder controle te houden.\r\nHet tweede parcours schetst de evolutie van de betaalmiddelen en zet hierbij de collecties van het museum in de kijker. Goederengeld, oude ruilmiddelen, munten en biljetten vormen een thematisch en chronologisch geheel, waarbij de bezoeker wordt meegenomen op een reis in de tijd en over heel de wereld.\r\nHet derde parcours tenslotte toont een aantal voorwerpen waarmee wordt aangetoond hoe sterk geld aanwezig is in ons dagelijkse leven.\r\n\r\nGroepsbezoeken kunnen vanaf 10 personen, maximum 25. Ze zijn gratis en duren ongeveer 1 uur. Reserveren graag via de website van het museum https:\/\/www.nbbmuseum.be\/nl\/booking.\r\nMeer informatie: tel 02 221 22 06 - museum@nbb.be  ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":592,"location":{"lat":50.84984775,"lon":4.35727802},"last_updated_at":"2022-10-14T03:30:05+02:00","published_at":"2013-10-19T01:13:39+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"poster","link":"https:\/\/agendabrussels2.imgix.net\/797dd909bcc5ce3a459606789d69543af938fc74.jpg","width":842,"height":1191,"ratio":0,"oEmbed_height":1191,"oEmbed_width":842,"translations":{"de":{"title":"1001 Plateaux : Sharing Collections \u2013 Sharing Connections","copyright":null},"pt":{"title":"1001 Plateaux : Sharing Collections \u2013 Sharing Connections","copyright":null},"en":{"title":"1001 Plateaux : Sharing Collections \u2013 Sharing Connections","copyright":null},"it":{"title":"1001 Plateaux : Sharing Collections \u2013 Sharing Connections","copyright":null},"cn":{"title":"1001 Plateaux : Sharing Collections \u2013 Sharing Connections","copyright":null},"fr":{"title":"1001 Plateaux : Sharing Collections \u2013 Sharing Connections","copyright":null},"sp":{"title":"1001 Plateaux : Sharing Collections \u2013 Sharing Connections","copyright":null},"nl":{"title":"1001 Plateaux : Sharing Collections \u2013 Sharing Connections","copyright":nu