pt_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[36,39],"translations":{"fr":["Mus\u00e9es et art centers","Photographie"],"nl":["Musea en kunstcentra","Fotografie"],"en":["Museums and art centers","Photography"]}}},"languages":{"spoken":["en","fr","nl","de"],"subtitles":[]},"translations":{"fr":{"name":"ICONIC Exposition temporaire","shortdescr":null,"longdescr":"L\u2019exposition \u00ab ICONIC \u00bb, con\u00e7ue sp\u00e9cialement pour le Parlement europ\u00e9en, est ax\u00e9e sur la libert\u00e9 de la presse et pr\u00e9sente une s\u00e9lection des laur\u00e9ats pr\u00e9c\u00e9dents du prix World Press Photo de l\u2019ann\u00e9e. Elle durera six mois et sera compl\u00e9t\u00e9e par un programme articul\u00e9 autour de la libert\u00e9 de la presse, de la libert\u00e9 d\u2019expression et de la s\u00e9curit\u00e9 des journalistes. D\u2019autres th\u00e8mes tels que la d\u00e9mocratie, les droits de l\u2019homme et les droits civiques et les migrations seront \u00e9galement abord\u00e9s dans le cadre du th\u00e8me principal. Le programme compl\u00e9mentaire proposera des visites guid\u00e9es, des d\u00e9bats et des tables rondes. L\u2019exposition \u00ab ICONIC \u00bb sera visible jusqu\u2019\u00e0 la mi-janvier 2023.\r\n\r\nVisites guid\u00e9es de ICONIC :\r\n\r\nLundi, jeudi et vendredi : 11h00 (en fran\u00e7ais), 15h00 (en anglais)\r\nMardi et samedi : 11h00 (en n\u00e9erlandais), 13h30 (en anglais), 15h00 (en fran\u00e7ais)\r\nMercredi et dimanche : 11h00 (en allemand), 13h30 (en fran\u00e7ais), 15h00 (en anglais)","performers":null,"boxoffice_url":null,"website":"https:\/\/visiting.europarl.europa.eu\/en\/visitor-offer\/brussels\/info-hub","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.538310"},"nl":{"name":"ICONIC Tijdelijke tentoonstelling","shortdescr":null,"longdescr":"In de tentoonstelling \u201cICONIC\u201d, die speciaal is samengesteld voor het Europees Parlement, staat persvrijheid centraal. In het kader van dit thema wordt een selectie van eerdere winnaars van de \u201cWorld Press Photo of the Year\u201d voor het voetlicht gebracht. De zes maanden durende tentoonstelling gaat vergezeld van een aanvullend programma omtrent persvrijheid, de vrijheid van meningsuiting en de veiligheid van journalisten. Aanverwante thema\u2019s, zoals democratie, burger- en mensenrechten en migratie, komen ook aan bod. Het aanvullend programma omvat rondleidingen, presentaties en paneldiscussies. De tentoonstelling \u201cICONIC\u201d loopt tot medio januari 2023.\r\n\r\nICONIC rondleidingen:\r\n\r\nMaandag, donderdag en vrijdag: 11.00 uur (Frans), 15.00 uur (Engels)\r\nDinsdag en zaterdag: 11.00 uur (Nederlands), 13.30 uur (Engels), 15.00 uur (Frans)\r\nWoensdag en zondag: 11.00 uur (Duits), 13.30 uur (Frans), 15.00 uur (Engels)","performers":null,"boxoffice_url":null,"website":"https:\/\/www.worldpressphoto.org\/calendar\/2022\/iconic","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.538310"},"en":{"name":"ICONIC Temporary exhibition","shortdescr":null,"longdescr":"The \u201cICONIC\u201d exhibition, curated especially for the European Parliament, will focus on press freedom, showcasing a selection of previous winners of the \u201cWorld Press Photo of the Year\u201d. The six-month exhibition will be complemented by a side programme revolving around press freedom, freedom of expression and safety for journalists. Other themes such as democracy, civil and human rights and migration will also be addressed as part of the key theme. The side programme will feature guided tours, talks and panel discussions. The \u201cICONIC\u201d exhibition will run until mid-January 2023.\r\n\r\nICONIC guided tours:\r\n\r\nMonday, Thursday and Friday: 11:00 (French), 15:00 (English)\r\nTuesday and Saturday: 11:00 (Dutch), 13:30 (English), 15:00 (French)\r\nWednesday and Sunday: 11:00 (German), 13:30 (French), 15:00 (English)","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.538310"},"de":{"name":"\u00abICONIC\u00bb - Exposition temporaire","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.538310"},"it":{"name":"\u00abICONIC\u00bb - Exposition temporaire","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.538310"},"sp":{"name":"\u00abICONIC\u00bb - Exposition temporaire","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.538310"},"pt":{"name":"\u00abICONIC\u00bb - Exposition temporaire","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.538310"},"cn":{"name":"\u00abICONIC\u00bb - Exposition temporaire","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.538310"}},"place":{"id":279042,"translations":{"fr":{"name":"Info Hub","address_street_name":"Esplanade Solidarnosc 1980","address_street_number":null,"address_street_box":null,"email":null,"website":"https:\/\/visiting.europarl.europa.eu\/fr\/visitor-offer\/brussels\/info-hub","phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Esplanade Solidarnosc 1980","address_line2":"1050 Ixelles","description_web":"Explorez les th\u00e9matiques qui vous int\u00e9ressent gr\u00e2ce \u00e0 nos documents de recherche, d\u00e9bats politiques et \u00e9v\u00e9nements organis\u00e9es avec la soci\u00e9t\u00e9 civile, ainsi qu\u2019\u00e0 des expositions suscitant la r\u00e9flexion, le tout en libre acc\u00e8s au c\u0153ur du quartier europ\u00e9en. Avec des espaces distincts donnant acc\u00e8s \u00e0 une vari\u00e9t\u00e9 de contenus et d'activit\u00e9s, l\u2019Info Hub de l\u2019Esplanade Solidarno\u015b\u0107 1980 r\u00e9pond \u00e0 toute une gamme de besoins. Participez au dialogue sur l\u2019Union europ\u00e9enne et la d\u00e9mocratie, assistez \u00e0 des d\u00e9bats politiques, ou asseyez-vous et lisez tout simplement pour en apprendre davantage sur l\u2019actualit\u00e9 en Europe. Le programme \u00e9v\u00e9nementiel est en constante \u00e9volution, et vous permet ainsi de revenir autant de fois que vous le voulez en d\u00e9couvrant quelque chose de nouveau \u00e0 chaque visite. \r\n\r\nUne question ? Posez-la \u00e0 notre \u00e9quipe toujours pr\u00eate \u00e0 vous aider, et elle vous guidera dans l\u2019Info Hub ou sur le campus du Parlement europ\u00e9en.  ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Info Hub","address_street_name":"Esplanade Solidarnosc 1980","address_street_number":null,"address_street_box":null,"email":null,"website":"https:\/\/visiting.europarl.europa.eu\/nl\/visitor-offer\/brussels\/info-hub","phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"Esplanade Solidarnosc 1980","address_line2":"1050 Elsene","description_web":"Verdiep u in onderwerpen die u interesseren via vrij toegankelijk onderzoeksmateriaal, beleidsbesprekingen, evenementen van het maatschappelijk middenveld en boeiende tentoonstellingen in het hart van de Europese wijk. Het aan de Esplanade Solidarno\u015b\u0107 1980 gelegen Info Hub biedt uiteenlopende activiteiten en diverse ruimten die ieder in een andere behoefte voorzien. Wissel van gedachten over de Europese Unie en democratie, woon een korte beleidsbespreking bij of neem rustig plaats om u in te lezen over wat er in Europa speelt. Dankzij de voortdurend wisselende evenementen en tentoonstellingen kunt u keer op keer terugkomen en telkens weer iets nieuws ontdekken.\r\n\r\nVragen? Onze medewerkers staan voor u klaar. Ze maken u graag wegwijs in het Info Hub of op het terrein van het Europees Parlement.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Info Hub","address_street_name":"Esplanade Solidarnosc 1980","address_street_number":null,"address_street_box":null,"email":null,"website":"https:\/\/visiting.europarl.europa.eu\/en\/visitor-offer\/brussels\/info-hub","phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Esplanade Solidarnosc 1980","address_line2":"1050 Ixelles","description_web":"Dive into the topics you are interested in with open access research material, policy talks and civil society events, and thought-provoking exhibitions at the heart of the European Quarter. With distinct areas offering access to a variety of content and activities, the Info Hub on the Esplanade Solidarno\u015b\u0107 1980 caters to many needs. Engage in a dialogue on the European Union and democracy, attend a short policy talk, or simply sit and read more about what is going on in Europe. What is more, with a constantly changing programme of events and exhibitions, you can come back time and time again, and discover something new each time.\r\n\r\nGot a question? Ask the friendly staff and they will help you find your way around the Info Hub, or the European Parliament campus.  ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Info Hub","address_street_name":"Esplanade Solidarnosc 1980","address_street_number":null,"address_street_box":null,"email":null,"website":"https:\/\/visiting.europarl.europa.eu\/fr\/visitor-offer\/brussels\/info-hub","phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Esplanade Solidarnosc 1980","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Info Hub","address_street_name":"Esplanade Solidarnosc 1980","address_street_number":null,"address_street_box":null,"email":null,"website":"https:\/\/visiting.europarl.europa.eu\/fr\/visitor-offer\/brussels\/info-hub","phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Esplanade Solidarnosc 1980","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Info Hub","address_street_name":"Esplanade Solidarnosc 1980","address_street_number":null,"address_street_box":null,"email":null,"website":"https:\/\/visiting.europarl.europa.eu\/fr\/visitor-offer\/brussels\/info-hub","phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Esplanade Solidarnosc 1980","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Info Hub","address_street_name":"Esplanade Solidarnosc 1980","address_street_number":null,"address_street_box":null,"email":null,"website":"https:\/\/visiting.europarl.europa.eu\/fr\