00","end":"16:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false}],"prices":[],"date_exceptions":[],"closing_days":[],"child_events":[],"parent_events":[],"accessibilities":[],"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[]},{"id":5700004830,"date_start":"2025-02-22","date_end":"2025-03-09","date_next":"2025-02-22","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2025-01-17T15:52:02+01:00","published_at":"2024-12-20T15:57:54+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":315185,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"misc","ranking":0.5,"languages":{"spoken":["nl","fr","en"],"subtitles":[]},"categories":{"main":{"id":84,"translations":{"de":"Verschiedenes","pt":null,"en":"Various","it":"Varie","cn":null,"fr":"Divers","sp":"Varios","nl":"Varia"}},"others":{"list":[88],"translations":{"de":["Spiele & Quiz"],"pt":[null],"en":["Games and quiz"],"it":["Giochi e quiz"],"cn":[null],"fr":["Jeux et quiz"],"sp":["Juegos y concursos"],"nl":["Spel en quiz"]}}},"translations":{"de":{"name":"Play like it's 1701!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.artandhistory.museum\/fr\/activity\/jouer-comme-en-1701","email":"public@kmkg-mrah.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700004830"},"pt":{"name":"Play like it's 1701!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.artandhistory.museum\/fr\/activity\/jouer-comme-en-1701","email":"public@kmkg-mrah.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700004830"},"en":{"name":"Play like it's 1701!","shortdescr":"Game trail in the 18th-century art rooms for families with children aged 4 to 10. In the context of Krokuskriebels 2025.","longdescr":"The ancient Egyptians were fond of board games and the Romans liked dice, but it was not until the 17th and especially the 18th centuries that people began to play more and more party games. Cards, lotto and goose games became widespread, along with the rule books that accompanied them. Knucklebones and dice remained popular, and draughts came back into fashion. Feel like playing? Go to the museum, where you can borrow a games case from the welcome desk. Then sit down at a table in the elegant rooms filled with 18th-century European art and play as much and as long as you like!\n\nIn the case you will find an assortment of six board games that vary in difficulty. You choose which games you play, so how long your museum visit lasts.\nThe games: \n- Tarot. Card game for 3 or 4 players, 20 min, 8+\n- Lotto. Game of chance for 2 to 4 players, 10 min, 4+\n- Game of the goose. Strategy game for 2 to 4 players, 20 min, 4+\n- Knuckle bones. Skill game for 2 to 4 players, 10 min, 6+\n- Dice. Game of chance for 2 to 4 players, 10 min, 4+\nDraughts. Strategy game for 2 players, 20 min, 6+\n\nThere are 4 game cases available. It is not possible to reserve one. \n","performers":null,"boxoffice_url":null,"website":"https:\/\/www.artandhistory.museum\/en\/activity\/play-its-1701","email":"public@kmkg-mrah.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700004830"},"it":{"name":"Play like it's 1701!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.artandhistory.museum\/fr\/activity\/jouer-comme-en-1701","email":"public@kmkg-mrah.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700004830"},"cn":{"name":"Play like it's 1701!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.artandhistory.museum\/fr\/activity\/jouer-comme-en-1701","email":"public@kmkg-mrah.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700004830"},"fr":{"name":"Jouer comme en 1701 !","shortdescr":"Parcours de jeux dans les salles d'art du 18e si\u00e8cle pour les familles avec des enfants de 4 \u00e0 10 ans. Dans le cadre de Krokuskriebels 2025.","longdescr":"Les \u00c9gyptiens de l'Antiquit\u00e9 aimaient d\u00e9j\u00e0 le senet et les Romains les jeux de d\u00e9s, mais c'est \u00e0 partir du 17e et surtout du 18e si\u00e8cle que l'on commence \u00e0 jouer de plus en plus aux jeux de soci\u00e9t\u00e9. Cartes, loto ou jeu de l'oie se diffusent largement avec les livres de jeux qui les accompagnent. Les osselets et les d\u00e9s restent populaires et le jeu de dames est remis au go\u00fbt du jour. D\u00e9j\u00e0 envie de jouer ? Rendez-vous au mus\u00e9e ou vous pouvez emprunter une caisse des jeux \u00e0 l'accueil. Installez-vous ensuite \u00e0 une table dans les \u00e9l\u00e9gants salons remplis d'art europ\u00e9en du 18e si\u00e8cle et jouez autant que vous le souhaitez !\n\nDans la caisse, vous trouverez un assortiment de six jeux de soci\u00e9t\u00e9 de difficult\u00e9 variable. C'est vous qui choisissez les jeux auxquels vous jouez, et donc la dur\u00e9e de votre visite au mus\u00e9e.\n\nLes jeux : \n- Tarot. Jeu de cartes pour 3 ou 4 joueurs, 20 min, 8+\n- Loto. Jeu de hasard pour 2 \u00e0 4 joueurs, 10 min, 4+.\n- Jeu de l'oie. Jeu de strat\u00e9gie pour 2 \u00e0 4 joueurs, 20 min, 4+.\n- Osselets. Jeu d'adresse pour 2 \u00e0 4 joueurs, 10 min, 6+.\n- D\u00e9s. Jeu de hasard pour 2 \u00e0 4 joueurs, 10 min, 4+.\n- Dames. Jeu de strat\u00e9gie pour 2 joueurs, 20 min, 6+\n\nIl y a 4 caisses de jeu disponibles. Il n'est pas possible d'en r\u00e9server une. ","performers":null,"boxoffice_url":null,"website":"https:\/\/www.artandhistory.museum\/fr\/activity\/jouer-comme-en-1701","email":"public@kmkg-mrah.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700004830"},"sp":{"name":"Play like it's 1701!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.artandhistory.museum\/fr\/activity\/jouer-comme-en-1701","email":"public@kmkg-mrah.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700004830"},"nl":{"name":"Spelen als was het 1701!","shortdescr":"Gezelschapsspelletjesparcours doorheen de zalen kunst uit de 18e eeuw voor gezinnen met kinderen van 4 tot 10 jaar. I.k.v. Krokuskriebels 2025.","longdescr":"De oude Egyptenaren speelden al graag bordspelen en de Romeinen hielden wel van een potje dobbelen, maar het is vanaf de 17e en vooral de 18e eeuw dat mensen meer en meer gezelschapsspelletjes gaan spelen. Kaarten, lotto, of ganzenbord worden op grote schaal verspreid met hun bijhorende spelboekjes. Bikkelen en dobbelen blijven populair en het damspel krijgt een update. Begint het al te kriebelen? Zak dan af naar het museum en ontleen een spelletjeskoffer aan het onthaal. Zet je vervolgens aan een tafeltje in de elegante salons gevuld met kunst uit de Europese 18e eeuw en speel zoveel en zolang je wil!\n\t\nIn de koffer vind je een assortiment van zes gezelschapsspelletjes die vari\u00ebren in moeilijkheidsgraad. Je kiest zelf welke spelletjes je speelt, dus hoe lang je museumbezoek duurt.\n\nDe spelletjes: \n-\tTarot. Kaartspel voor 3 of 4 spelers, 20 min, 8+\n-\tLotto. Kansspel voor 2 tot 4 spelers, 10 min, 4+\n-\tGanzenbord. Strategiespel voor 2 tot 4 spelers, 20 min, 4+\n-\tBikkelen. Behendigheidsspel voor 2 tot 4 spelers, 10 min, 6+\n-\tDobbelen. Kansspel voor 2 tot 4 spelers, 10 min, 4+\n-\tDammen. Strategiespel voor 2 spelers, 20 min, 6+\n\nEr zijn 4 spelkoffers beschikbaar. Het is niet mogelijk een exemplaar te reserveren. ","performers":null,"boxoffice_url":null,"website":"https:\/\/www.artandhistory.museum\/nl\/activity\/spelen-als-was-het-1701","email":"public@kmkg-mrah.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700004830"}},"place":{"id":61,"translations":{"de":{"name":"Mus\u00e9e Art & Histoire (MRAH)","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Bruxelles","description_web":"Das Cinquantenaire-Museum, gelegen im Br\u00fcsseler Jubelpark, ist Teil der K\u00f6niglichen Museen f\u00fcr Kunst und Geschichte und bietet einen umfassenden und vielseitigen \u00dcberblick \u00fcber die Geschichte von den Hochkulturen der Antike bis hin zu den Kunststr\u00f6mungen der Gegenwart.\r\n\r\nAntike Sammlungen: \r\nDie antiken Sammlungen befassen sich mit den untergegangenen Hochkulturen von \u00c4gypten (Neuheit: das Grabmal von Nakht), Mesopotamien, Griechenland und Rom. Gezeigt werden au\u00dferdem die gro\u00dfen Kunststr\u00f6mungen Europas vom 10. Jahrhundert bis heute. Wandteppiche, Altaraufs\u00e4tze, Spitze, Goldschmiedekunst und Porzellan geh\u00f6ren zu den kostbaren H\u00f6hepunkten der Ausstellung.\r\n\r\nVon Mikronesien bis Amerika: \r\nDie nicht-europ\u00e4ischen Werke laden ihrerseits auf eine Reise ein: nach Mikronesien, Polynesien, Indien, S\u00fcdostasien, China und ins pr\u00e4kolumbische Amerika. In den eindrucksvollen Arch\u00e4ologie-S\u00e4len wird der Geschichte der Region von der Vorgeschichte bis zur Epoche der Merowinger neues Leben eingehaucht.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Museu de Arte e Hist\u00f3ria (MRAH)","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Bruxelles","description_web":"Da arqueologia nacional \u00e0s artes decorativas europeias, passando pela antiguidade cl\u00e1ssica e pelas civiliza\u00e7\u00f5es n\u00e3o europeias, embarque numa fascinante viagem atrav\u00e9s da arte e da hist\u00f3ria num edif\u00edcio magn\u00edfico criado por L\u00e9opold II no parque do Cinquenten\u00e1rio em Bruxelas.\r\n\r\n-  Museu do Cinquenten\u00e1rio muda de pele e torna-se o Museu de Arte e Hist\u00f3ria!\r\n-  Museu do Cinquenten\u00e1rio desenvolveu um trabalho de reflex\u00e3o sobre a sua imagem. Este resultou numa campanha de reorganiza\u00e7\u00e3o global da institui\u00e7\u00e3o. Come\u00e7ou assim uma reconquista museogr\u00e1fica: a decis\u00e3o de organizar exposi\u00e7\u00f5es tempor\u00e1rias baseadas nas pr\u00f3prias cole\u00e7\u00f5es do museu e de renovar progressivamente as salas permanentes, come\u00e7ando pelo armaz\u00e9m Wolfers, que foi a primeira etapa de uma s\u00e9rie de outras renova\u00e7\u00f5es (salas Egito, salas s\u00e9culos XIX e XX, maqueta de Roma\u2026) que atingem rapidamente a sua velocidade de cruzeiro. O\r\n- Museu de Arte e Hist\u00f3ria pertence aos Museus Reais de Arte e da Hist\u00f3ria, que englobam, para al\u00e9m deste, o MIM (Museu dos Instrumentos Musicais), a Porta de Hal e os Museus do Extremo Oriente, atualmente encerrados.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Art & History Museum (RMAH)","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Brussels","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Brussels","description_web":"Embark on a fascinating journey through art and history! Come and stroll among the prehistoric flints and Egyptian mummies, walk between the ancient glasses and stand back to contemplate the impressive medieval tapestries. Immerse yourself in the oriental world as you pass Asian Buddhas and travel to the other side of the world to see a gigantic statue from Easter Island. You still have to admire the magnificent collection of Belgian Art Nouveau...\r\n\r\nThe Art & History Museum is part of the Royal Museums of Art and History (RMAH) that also cover the Musical Instruments Museum (MIM), Halle Gate and the Museums of the Far East (currently closed for renovation).","description_print":"The Cinquantenaire Museum is the headquarters of the Royal Museums of Art and History. It was erected at the end of the nineteenth century and is one of the most extensive museums in Belgium. The collections are divided according to four main themes: 1) National Archaeology; 2) Antiquity; 3) European Decorative Art; 4) Non-European Civilizations.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Museo Arte & Historia","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Bruxelles","description_web":"Situato nel cuore del complesso del Cinquantenario, il Mus\u00e9e du Cinquantenaire vi invita a viaggiatore attraverso i continenti dalla Preistoria al XX secolo. \r\n\r\n\r\nLe sue ricche collezioni sono suddivise in quattro grandi sezioni :\r\n\r\n- L'Antichit\u00e0 dove sono presentate le grandi civilt\u00e0 scomparse dell'Egitto, della Mesopotamia, della Grecia e di Roma.\r\n- Le Arti decorative europee dove scoprire le correnti artistiche dal X secolo ai giorni nostri.\r\n- Le Civilt\u00e0 non europee che invitano al viaggio: India, Sudest asiatico, Cina, America precolombiana.\r\n- L'archeologia nazionale per rivivere il passato delle nostre regioni, dalla Preistoria al periodo merovingio.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Mus\u00e9e Art & Histoire (MRAH)","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Mus\u00e9e Art & Histoire (MRAH)","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Bruxelles","description_web":"Embarquez pour un fascinant voyage \u00e0 travers l'art et l'histoire. Venez fl\u00e2ner parmi les momies \u00e9gyptiennes et les silex pr\u00e9historiques, vous promener entre les verres anciens et prendre du recul pour mieux contempler d'impressionnantes tapisseries m\u00e9di\u00e9vales. Venez vous immerger dans le monde oriental en croisant des Bouddhas d'Asie et voyager jusqu'\u00e0 l'autre bout de la terre pour apercevoir une gigantesque statue de l'\u00eele de P\u00e2ques. La magnifique collection d'Art Nouveau vous attend au bout du voyage.\r\nLe Mus\u00e9e Art & Histoire fait partie des Mus\u00e9es royaux d\u2019Art et d\u2019Histoire, appellation qui chapeaute, outre le Mus\u00e9e Art & Histoire, le mim (Mus\u00e9e des Instruments de Musique), la Porte de Hal et les Mus\u00e9es d\u2019Extr\u00eame-Orient actuellement ferm\u00e9s.\r\n\r\n\r\nLe Mus\u00e9e Art & Histoire fait partie des Mus\u00e9es royaux d\u2019Art et d\u2019Histoire, appellation qui chapeaute, outre le Mus\u00e9e Art & Histoire, le mim (Mus\u00e9e des Instruments de Musique), la Porte de Hal et les Mus\u00e9es d\u2019Extr\u00eame-Orient actuellement ferm\u00e9s. ","description_print":"Le Mus\u00e9e du Cinquantenaire illustre les activit\u00e9s humaines et artistiques des cinq continents \u2013 hormis l\u2019Afrique noire \u2013, de la Pr\u00e9histoire \u00e0 nos jours. Les collections remplissent quatre b\u00e2timents et sont regroup\u00e9es en quatre d\u00e9partements: l\u2019Antiquit\u00e9, les civilisations extra-europ\u00e9ennes, l\u2019arch\u00e9ologie nationale et les arts d\u00e9coratifs europ\u00e9ens.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Museo de Arte e Historia","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Bruxelles","description_web":"Ad\u00e9ntrate en este edificio hist\u00f3rico, uno de los mayores museos de B\u00e9lgica erigido por el anterior rey belga Leopoldo II. Descubre una gran cantidad de objetos desde la prehistoria hasta la antig\u00fcedad y de las artes aplicadas europeas hasta una amplia colecci\u00f3n de arte no europea. Explora todo, incluyendo las interesantes exposiciones temporales, conferencias y otras actividades. Desafortunadamente, la p\u00e1gina web no es tan amplia como para mostrar toda nuestra colecci\u00f3n, compuesta por miles de tesoros del arte y objetos hist\u00f3ricos. Sin embargo, esperamos que nos visites y disfrutes descubriendo o redescubriendo el inmenso patrimonio que gestionamos y exhibimos. De hecho, para nosotros el arte y la historia no son muerte y temas pasados, si no una viva y constante fuente de inspiraci\u00f3n y diversi\u00f3n.\r\n\r\nEl Museo de Arte e Historia es parte de los Museos Reales de Arte e Historia(MRAH), que incluye el Museo de Instrumentos Musicales(MIM), la Puerta de Hal y los Museos del Lejano Oriente(recientemente cerrado por renovaciones).\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Museum Kunst & Geschiedenis (KMKG)","address_street_name":"Jubelpark","address_street_number":"10","address_street_box":null,"email":"info@kmkg.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Brussel","address_line1":"Jubelpark, 10","address_line2":"1000 Brussel","description_web":"Maak een wereldreis door de geschiedenis! Wandel van prehistorische vuistbijlen naar Egyptische mummies. Snuistert tussen betoverende glas en zet een stap achteruit om de indrukwekkende Brusselse wandtapijten te bekijken. Ga de oosterse toer op tussen de Aziatische boeddha\u2019s en steek de Atlantische Oceaan over om Kuifjes \u2018beeldje met het gebroken oor\u2019. En dan is er nog de mooie collectie van Belgische art nouveau\u2026 U komt ogen en oren te kort!\r\n\r\nHet Museum Kunst & Geschiedenis maakt deel uit van de Koninklijke Musea voor Kunst en Geschiedenis (KMKG) die ook het Muziekinstrumentenmuseum (MIM), de Hallepoort en de Musea van het Verre Oosten (gesloten voor renovatie) bundelen.","description_print":"Het Jubelparkmuseum kan bogen op een imposante collectie kunstschatten en archeologische vondsten afkomstig uit de vijf continenten \u2013 met uitzondering van Zwart-Afrika \u2013 van de prehistorie tot op heden. De verzamelingen vullen vier gebouwen en zijn ingedeeld in evenveel departementen: Oudheid (het Nabije Oosten, Egypte, Griekenland, Rome en Byzantium), Niet-Europese Beschavingen (Islam, Azi\u00eb, Polynesi\u00eb & Micronesi\u00eb en Amerika), Nationale Archeologie en Europese Sierkunsten.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[9],"translations":{"de":["Europ\u00e4isches Viertel"],"pt":[null],"en":["European Quarter"],"it":["Quartiere europeo"],"cn":[null],"fr":["Quartier europ\u00e9en"],"sp":["Barrio Europeo"],"nl":["Europese wijk"]}},"zones":{"list":[22],"translations":{"de":["Osten"],"pt":[null],"en":["East"],"it":["Est"],"cn":[null],"fr":["Est"],"sp":["Este"],"nl":["Oost"]}},"neca":null,"facebook_id":null,"backoffice_id":12,"location":{"lat":50.83935087,"lon":4.3917188},"region":"brussels","last_updated_at":"2024-07-12T09:22:43+02:00","published_at":"2013-10-19T01:13:13+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":61,"translations":{"de":{"name":"Mus\u00e9e Art & Histoire (MRAH)","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Bruxelles","description_web":"Das Cinquantenaire-Museum, gelegen im Br\u00fcsseler Jubelpark, ist Teil der K\u00f6niglichen Museen f\u00fcr Kunst und Geschichte und bietet einen umfassenden und vielseitigen \u00dcberblick \u00fcber die Geschichte von den Hochkulturen der Antike bis hin zu den Kunststr\u00f6mungen der Gegenwart.\r\n\r\nAntike Sammlungen: \r\nDie antiken Sammlungen befassen sich mit den untergegangenen Hochkulturen von \u00c4gypten (Neuheit: das Grabmal von Nakht), Mesopotamien, Griechenland und Rom. Gezeigt werden au\u00dferdem die gro\u00dfen Kunststr\u00f6mungen Europas vom 10. Jahrhundert bis heute. Wandteppiche, Altaraufs\u00e4tze, Spitze, Goldschmiedekunst und Porzellan geh\u00f6ren zu den kostbaren H\u00f6hepunkten der Ausstellung.\r\n\r\nVon Mikronesien bis Amerika: \r\nDie nicht-europ\u00e4ischen Werke laden ihrerseits auf eine Reise ein: nach Mikronesien, Polynesien, Indien, S\u00fcdostasien, China und ins pr\u00e4kolumbische Amerika. In den eindrucksvollen Arch\u00e4ologie-S\u00e4len wird der Geschichte der Region von der Vorgeschichte bis zur Epoche der Merowinger neues Leben eingehaucht.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Museu de Arte e Hist\u00f3ria (MRAH)","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Bruxelles","description_web":"Da arqueologia nacional \u00e0s artes decorativas europeias, passando pela antiguidade cl\u00e1ssica e pelas civiliza\u00e7\u00f5es n\u00e3o europeias, embarque numa fascinante viagem atrav\u00e9s da arte e da hist\u00f3ria num edif\u00edcio magn\u00edfico criado por L\u00e9opold II no parque do Cinquenten\u00e1rio em Bruxelas.\r\n\r\n-  Museu do Cinquenten\u00e1rio muda de pele e torna-se o Museu de Arte e Hist\u00f3ria!\r\n-  Museu do Cinquenten\u00e1rio desenvolveu um trabalho de reflex\u00e3o sobre a sua imagem. Este resultou numa campanha de reorganiza\u00e7\u00e3o global da institui\u00e7\u00e3o. Come\u00e7ou assim uma reconquista museogr\u00e1fica: a decis\u00e3o de organizar exposi\u00e7\u00f5es tempor\u00e1rias baseadas nas pr\u00f3prias cole\u00e7\u00f5es do museu e de renovar progressivamente as salas permanentes, come\u00e7ando pelo armaz\u00e9m Wolfers, que foi a primeira etapa de uma s\u00e9rie de outras renova\u00e7\u00f5es (salas Egito, salas s\u00e9culos XIX e XX, maqueta de Roma\u2026) que atingem rapidamente a sua velocidade de cruzeiro. O\r\n- Museu de Arte e Hist\u00f3ria pertence aos Museus Reais de Arte e da Hist\u00f3ria, que englobam, para al\u00e9m deste, o MIM (Museu dos Instrumentos Musicais), a Porta de Hal e os Museus do Extremo Oriente, atualmente encerrados.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Art & History Museum (RMAH)","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Brussels","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Brussels","description_web":"Embark on a fascinating journey through art and history! Come and stroll among the prehistoric flints and Egyptian mummies, walk between the ancient glasses and stand back to contemplate the impressive medieval tapestries. Immerse yourself in the oriental world as you pass Asian Buddhas and travel to the other side of the world to see a gigantic statue from Easter Island. You still have to admire the magnificent collection of Belgian Art Nouveau...\r\n\r\nThe Art & History Museum is part of the Royal Museums of Art and History (RMAH) that also cover the Musical Instruments Museum (MIM), Halle Gate and the Museums of the Far East (currently closed for renovation).","description_print":"The Cinquantenaire Museum is the headquarters of the Royal Museums of Art and History. It was erected at the end of the nineteenth century and is one of the most extensive museums in Belgium. The collections are divided according to four main themes: 1) National Archaeology; 2) Antiquity; 3) European Decorative Art; 4) Non-European Civilizations.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Museo Arte & Historia","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_box":null,"email":"info@mrah.be","website":"https:\/\/www.artandhistory.museum","phone_contact":"+32 2 741 73 31","phone_booking":"+32 2 741 73 02","address_zip":"1000","address_city":"Bruxelles","address_line1":"Parc du Cinquantenaire, 10","address_line2":"1000 Bruxelles","description_web":"Situato nel cuore del complesso del Cinquantenario, il Mus\u00e9e du Cinquantenaire vi invita a viaggiatore attraverso i continenti dalla Preistoria al XX secolo. \r\n\r\n\r\nLe sue ricche collezioni sono suddivise in quattro grandi sezioni :\r\n\r\n- L'Antichit\u00e0 dove sono presentate le grandi civilt\u00e0 scomparse dell'Egitto, della Mesopotamia, della Grecia e di Roma.\r\n- Le Arti decorative europee dove scoprire le correnti artistiche dal X secolo ai giorni nostri.\r\n- Le Civilt\u00e0 non europee che invitano al viaggio: India, Sudest asiatico, Cina, America precolombiana.\r\n- L'archeologia nazionale per rivivere il passato delle nostre regioni, dalla Preistoria al periodo merovingio.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Mus\u00e9e Art & Histoire (MRAH)","address_street_name":"Parc du Cinquantenaire","address_street_number":"10","address_street_bo