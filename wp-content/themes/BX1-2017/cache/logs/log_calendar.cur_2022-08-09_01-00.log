,"nl":["Kanaalwijk"],"en":["Canal"]}},"zones":{"list":[23],"translations":{"fr":["Ouest"],"nl":["West"],"en":["West"]}},"neca":null,"facebook_id":null,"backoffice_id":2503,"location":{"lat":50.85284356,"lon":4.34044977},"region":"brussels","last_updated_at":"2022-08-07T01:07:41+02:00","published_at":"2013-10-19T01:15:16+02:00","import_origin":null,"external_id":null,"is_in_address_book":false,"is_in_vb_export":false,"resto_ranking":0},"organizer":{"id":275636,"translations":{"fr":{"name":"OK Coffee Tips","address_street_name":"Chauss\u00e9e de Forest","address_street_number":"254","address_street_box":null,"email":"thomas@okcoffee.tips","website":"http:\/\/www.okcoffee.tips","phone_contact":null,"phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Chauss\u00e9e de Forest, 254","address_line2":"1060 Saint-Gilles","description_web":"OK COFFEE est une structure activiste \u0153uvrant \u00e0 la reconnaissance du Caf\u00e9 de Sp\u00e9cialit\u00e9 en Belgique francophone au travers de\r\n\r\n\u2022 COURS \u2022 TOURS \u2022 CONSULTANCE\r\n\r\n\u2014\r\n\r\nSa mission : informer, former, connecter - valoriser les nouvelles vagues du caf\u00e9 et d\u00e9monter les pratiques pass\u00e9istes d'une commodit\u00e9 en r\u00e9volution.\r\n\r\nFili\u00e8res Courtes, Producteurices, Transparence, Qualit\u00e9 et Go\u00fbt sont au c\u0153ur de nos pr\u00e9occupations\r\n\r\nLisez notre MANIFESTE pour mieux comprendre nos valeurs et nos partenaires.\r\n\r\n\u2014\r\n\r\nN\u2019h\u00e9sitez pas \u00e0 vous inscrire \u00e0 notre newsletter sur notre SITE, et \u00e0 nous rejoindre sur Instagram ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"OK Coffee Tips","address_street_name":"Chauss\u00e9e de Forest","address_street_number":"254","address_street_box":null,"email":"thomas@okcoffee.tips","website":"http:\/\/www.okcoffee.tips","phone_contact":null,"phone_booking":null,"address_zip":"1060","address_cit