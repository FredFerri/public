:09:51+01:00","published_at":"2023-08-08T13:34:12+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":282957,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"concert","ranking":0.21915874168443503,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":1,"translations":{"de":"Konzert","pt":null,"en":"Concert","it":"Concerti","cn":null,"fr":"Concert","sp":"Concierto","nl":"Concert"}},"others":{}},"translations":{"de":{"name":"Mad Jam","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.osamoelle.be","email":"communication@osamoelle.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50000826"},"pt":{"name":"Mad Jam","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.osamoelle.be","email":"communication@osamoelle.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50000826"},"en":{"name":"Mad Jam","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.osamoelle.be","email":"communication@osamoelle.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50000826"},"it":{"name":"Mad Jam","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.osamoelle.be","email":"communication@osamoelle.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50000826"},"cn":{"name":"Mad Jam","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.osamoelle.be","email":"communication@osamoelle.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50000826"},"fr":{"name":"Mad Jam","shortdescr":null,"longdescr":"Mad Jam vous invite un jeudi par mois \u00e0 venir voir, \u00e9couter et faire de la musique dans le cadre unique et rempli de magie qu\u2019est notre joli cabaret.\n\nUne Jam est un rassemblement libre de musiciens dans lequel tout le monde peut monter sur sc\u00e8ne pour jouer ou chanter en live dans le respect de tous et la bonne humeur\u2026\n\n \n\nEt ce n\u2019est pas tout, en plus d\u2019\u00eatre une Jam pas comme les autres Mad Jam est une Jam masqu\u00e9e ! Si tu as toujours voulu jouer de ta voix ou de ton instrument accompagn\u00e9 d\u2019autres musiciens mais que tu n\u2019es pas \u00e0 l\u2019aise de monter sur sc\u00e8ne et bien VIENS QUAND M\u00caME, nous aurons des masques de cabaret \u00e0 te pr\u00eater histoire de passer incognito","performers":null,"boxoffice_url":null,"website":"http:\/\/www.osamoelle.be","email":"communication@osamoelle.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50000826"},"sp":{"name":"Mad Jam","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.osamoelle.be","email":"communication@osamoelle.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50000826"},"nl":{"name":"Mad Jam","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.osamoelle.be","email":"communication@osamoelle.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50000826"}},"place":{"id":1078,"translations":{"de":{"name":"L'Os \u00e0 Moelle","address_street_name":"Avenue Emile Max","address_street_number":"153","address_street_box":null,"email":"reservation@osamoelle.be","website":"http:\/\/www.osamoelle.be","phone_contact":"+32 487 22 50 22","phone_booking":"+32 487 22 50 22","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Avenue Emile Max, 153","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"L'Os \u00e0 Moelle","address_street_name":"Avenue Emile Max","address_street_number":"153","address_street_box":null,"email":"reservation@osamoelle.be","website":"http:\/\/www.osamoelle.be","phone_contact":"+32 487 22 50 22","phone_booking":"+32 487 22 50 22","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Avenue Emile Max, 153","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"L'Os \u00e0 Moelle","address_street_name":"Avenue Emile Max","address_street_number":"153","address_street_box":null,"email":"reservation@osamoelle.be","website":"http:\/\/www.osamoelle.be","phone_contact":"+32 487 22 50 22","phone_booking":"+32 487 22 50 22","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Avenue Emile Max, 153","address_line2":"1030 Schaerbeek","description_web":"Opened in spring 1960, \u2018l\u2019Os \u00e0 Moelle\u2019 is the oldest cabaret in Brussels. This cellar with its indefinable charm, located under Jacques Brel\u2019s Birth House, has always been keen to open its doors to artists of all horizons. Singers, actors, comedians; many have stepped onto the cabaret stage!","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"L'Os \u00e0 Moelle","address_street_name":"Avenue Emile Max","address_street_number":"153","address_street_box":null,"email":"reservation@osamoelle.be","website":"http:\/\/www.osamoelle.be","phone_contact":"+32 487 22 50 22","phone_booking":"+32 487 22 50 22","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Avenue Emile Max, 153","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"L'Os \u00e0 Moelle","address_street_name":"Avenue Emile Max","address_street_number":"153","address_street_box":null,"email":"reservation@osamoelle.be","website":"http:\/\/www.osamoelle.be","phone_contact":"+32 487 22 50 22","phone_booking":"+32 487 22 50 22","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Avenue Emile Max, 153","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"fr":{"name":"L'Os \u00e0 Moelle","address_street_name":"Avenue Emile Max","address_street_number":"153","address_street_box":null,"email":"reservation@osamoelle.be","website":"http:\/\/www.osamoelle.be","phone_contact":"+32 487 22 50 22","phone_booking":"+32 487 22 50 22","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Avenue Emile Max, 153","address_line2":"1030 Schaerbeek","description_web":"Bienvenue dans le plus ancien cabaret de Bruxelles !\u202fCela m\u00e9rite en soi un hommage. De plus, c\u2019est aussi la cave de la maison natale de notre fiert\u00e9 bruxelloise, Jacques Brel. Depuis les ann\u00e9es 60, de grandes stars sont pass\u00e9es par ici\u202f; pensez \u00e0 Toots Thielemans, Philippe Lafontaine, Barbara et Arno. D\u00e9sormais, vous pouvez venir ici chaque semaine pour profiter d'un solide programme allant du th\u00e9\u00e2tre d'improvisation, des spectacles de com\u00e9die et d'auteurs-compositeurs-interpr\u00e8tes aux soir\u00e9es de po\u00e9sie, au th\u00e9\u00e2tre de marionnettes et aux f\u00eates dans le style \u00ab\u202fann\u00e9es folles\u202f\u00bb. \r\n\r\n ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"L'Os \u00e0 Moelle","address_street_name":"Avenue Emile Max","address_street_number":"153","address_street_box":null,"email":"reservation@osamoelle.be","website":"http:\/\/www.osamoelle.be","phone_contact":"+32 487 22 50 22","phone_booking":"+32 487 22 50 22","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Avenue Emile Max, 153","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"L'Os \u00e0 Moelle","address_street_name":"Emile Maxlaan","address_street_number":"153","address_street_box":null,"email":"reservation@osamoelle.be","website":"http:\/\/www.osamoelle.be","phone_contact":"+32 487 22 50 22","phone_booking":"+32 487 22 50 22","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Emile Maxlaan, 153","address_line2":"1030 Schaerbeek","description_web":"Welkom in het oudste cabarettheater van Brussel!\u202fDat op zich verdient al een pluim, en het is ook nog eens de charmante kelder van het geboortehuis van onze Brusselse trots Jacques Brel. Sinds de jaren 60 passeerden hier grote Franse sterren de revue, denk aan Toots Thielemans, Philippe Lafontaine, Barbara en Arno. Nu kan hier wekelijks komen genieten van een stevig programma gaande van improvisatietheater, comedy en singer-songwriteroptredens tot po\u00ebzieavonden, poppentheater en feestjes in \u2018roaring-twenties\u2019-stijl. \r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[22],"translations":{"de":["Osten"],"pt":[null],"en":["East"],"it":["Est"],"cn":[null],"fr":["Est"],"sp":["Este"],"nl":["Oost"]}},"neca":null,"facebook_id":"osamoellecabaret","backoffice_id":176,"location":{"lat":50.85131869,"lon":4.39874268},"region":"brussels","last_updated_at":"2022-10-10T10:25:09+02:00","published_at":"2013-10-19T01:13:20+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":1078,"translations":{"de":{"name":"L'Os \u00e0 Moelle","address_street_name":"Avenue Emile Max","address_street_n