dent sur une sc\u00e8ne \u00e0 l'ambiance d\u00e9contract\u00e9e, alors venez d\u00e9couvrir les nouveaux talents de l'humour belge !","performers":"What The Fun","boxoffice_url":null,"website":"http:\/\/www.whatthefun.be","email":"info@whatthefun.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50008904"},"sp":{"name":"What The Fun","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.whatthefun.be","email":"info@whatthefun.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50008904"},"nl":{"name":"What The Fun","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.whatthefun.be","email":"info@whatthefun.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50008904"}},"place":{"id":274795,"translations":{"de":{"name":"Le Reservoir bar","address_street_name":"Rue Haute","address_street_number":"204","address_street_box":null,"email":"info@lereservoir.be","website":"https:\/\/www.lereservoir.be\/","phone_contact":"+32 2 376 76 69","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Haute, 204","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Le Reservoir bar","address_street_name":"Rue Haute","address_street_number":"204","address_street_box":null,"email":"info@lereservoir.be","website":"https:\/\/www.lereservoir.be\/","phone_contact":"+32 2 376 76 69","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Haute, 204","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"nam