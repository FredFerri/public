turday and sunday: from 17:00 to 23:30"],"pt":["monday, tuesday, wednesday, thursday, friday, saturday and sunday: from 17:00 to 23:30"],"cn":["monday, tuesday, wednesday, thursday, friday, saturday and sunday: from 17:00 to 23:30"]},"date_start":"2022-11-23","date_end":"2023-01-08","is_also_by_appointment":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":{"list":[256,263],"translations":{"fr":["Am\u00e9nagements pour les personnes aveugles et malvoyantes","Accessible aux pi\u00e9tons appareill\u00e9s"],"nl":["Voorzieningen voor blinde en slechtziende personen","Toegankelijk voor voetgangers met hulpmiddelen"],"en":["Facilities for blind and partially-sighted persons","Accessible to pedestrians with mobility aids"],"de":["Anpassungen f\u00fcr blinde und sehbehinderte Menschen","Barrierefrei f\u00fcr Fu\u00dfg\u00e4nger mit Gehhilfe"],"it":[null,null],"sp":[null,null],"pt":[null,null],"cn":[null,null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2023-01-02T01:35:43+01:00","published_at":"2022-11-21T09:34:04+01:00","backoffice_id":265895,"import_origin":null,"sub_type":"misc","show_in_agenda":true,"ranking":0.27709841865296},{"id":546291,"date_start":"2022-12-02","date_end":"2023-01-22","date_next":"2023-01-02","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung","it":null,"sp":null,"pt":null,"cn":null}},"others":{"list":[36,41],"translations":{"fr":["Mus\u00e9es et art centers","Installation, performance"],"nl":["Musea en kunstcentra","Installatie, performance"],"en":["Museums and art centers","Installation, performance"],"de":["Museen & Kunstzentren","Installation, Performance"],"it":[null,null],"sp":[null,null],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Constant_V: The SPLINt cards","shortdescr":"Le jeu de cartes SPLINT est pr\u00eat \u00e0 \u00eatre test\u00e9 !\r\nAu cours des cinq prochaines ann\u00e9es de son programme, Constant demandera sans rel\u00e2che : Que pourraient\/devraient \u00eatre des technologies sp\u00e9culatives, libres et intersectionnelles (SPLINT) ? Un jeu de cartes, les cartes SPLINT*, a \u00e9t\u00e9 cr\u00e9\u00e9.","longdescr":"Le jeu de cartes SPLINT est pr\u00eat \u00e0 \u00eatre test\u00e9 !\r\nAu cours des cinq prochaines ann\u00e9es de son programme, Constant demandera sans rel\u00e2che : Que pourraient\/devraient \u00eatre des technologies sp\u00e9culatives, libres et intersectionnelles (SPLINT) ? Un jeu de cartes, les cartes SPLINT*, a \u00e9t\u00e9 cr\u00e9\u00e9 par Constant et ses alli\u00e9\u0387e\u0387s pour mettre en place des situations de rumination autour d\u2019une question aussi vaste qu\u2019urgente.\r\n\r\nPendant deux mois, des versions agrandies de ces cartes seront r\u00e9guli\u00e8rement tir\u00e9es dans la vitrine de Constant pour donner aux passant\u0387e\u0387s un aper\u00e7u du jeu et la possibilit\u00e9 de participer \u00e0 l\u2019exploration collective en laissant leurs propres r\u00e9ponses ou des questions suppl\u00e9mentaires.\r\n\r\nVous \u00eates aussi chaleureusement invit\u00e9\u0387e\u0387s non pas \u00e0 l\u2019habituel pot de No\u00ebl mais \u00e0 une print-party SPLINT le 15 d\u00e9cembre o\u00f9 nous imprimerons des jeux pour tout le monde, discuterons du jeu et d\u00e9gusterons des boissons de No\u00ebl.\r\n\r\n*Ce jeu a \u00e9t\u00e9 inspir\u00e9 par The Oracle for Transfeminist Technologies [https:\/\/www.transfeministech.codingrights.org\/], qui a incit\u00e9 Constant \u00e0 cr\u00e9er sa propre version du jeu.","performers":"Ot Lemmens (graphistes); Mia Melvaer (artiste); Martino Morandi (artiste); Elodie Mugrefya (artiste); Wendy Van Wynsberghe (artiste)","boxoffice_url":null,"website":"http:\/\/www.constantvzw.org","email":"info@constantvzw.org","phone_contact":"+32 2 539 24 67","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.546291"},"nl":{"name":"Constant_V: de SPLINT kaarten","shortdescr":"Het SPLINT kaartspel is klaar voor de test!\r\nDe komende vijf jaren zal het programma van Constant voortdurend de vraag stellen wat Speculatieve Libre Intersectionele Technologie\u00ebn (SPLINT) zouden kunnen en\/of moeten doen? Samen met bondgenoten maakten we een SPLINT kaartspel.","longdescr":"Het SPLINT kaartspel is klaar voor de test!\r\n\r\nDe komende vijf jaren zal het programma van Constant voortdurend de vraag stellen wat Speculatieve Libre Intersectionele Technologie\u00ebn (SPLINT) zouden kunnen en\/of moeten doen? Samen met bondgenoten maakten we een SPLINT kaartspel* waarmee situaties worden opgezet om deze grote en urgente vraag telkens opnieuw te overwegen.\r\n\r\nTwee maanden lang zullen regelmatig grote versies van deze kaarten op het raam van Constant worden getekend. Voorbijgangers vangen een glimps op van het spel, ze kunnen deelnemen aan deze collectieve ontdekkingstocht door het geven van antwoorden of aanvullende vragen.\r\n\r\nJe bent ook van harte welkom bij de SPLINT print-party op 15 december, die wordt verkleed als ongebruikelijke kerstdrink. Daar printen we kaarten voor iedereen en bespreken we het spel. De datum wordt later nog bevestigd.\r\n\r\n*Dit kaartspel is ge\u00efnspireerd op The Oracle for Transfeminist Technologies [https:\/\/www.transfeministech.codingrights.org\/], dat Constant aanzette om een eigen versie van het spel te maken.","performers":"Ot Lemmens (ontwerpers); Mia Melvaer (kunstenares); Martino Morandi (kunstenaar); Elodie Mugrefya (kunstenares); Wendy Van Wynsberghe (kunstenares)","boxoffice_url":null,"website":"http:\/\/www.constantvzw.org","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.546291"},"en":{"name":"Constant_V : les cartes SPLINT","shortdescr":"Le jeu de cartes SPLINT est pr\u00eat \u00e0 \u00eatre test\u00e9 !\r\nAu cours des cinq prochaines ann\u00e9es de son programme, Constant demandera sans rel\u00e2che : Que pourraient\/devraient \u00eatre des technologies sp\u00e9culatives, libres et intersectionnelles (SPLINT) ? Un jeu de cartes, les cartes SPLINT*, a \u00e9t\u00e9 cr\u00e9\u00e9.","longdescr":"The SPLINT deck of cards is ready to be put to the test!\r\n\r\nFor the next five years of its program, Constant will relentlessly ask: What could\/should Speculative, Libre and Intersectional Technologies (SPLINT) do? A deck of cards, the SPLINT cards*, was created by Constant and allies to set up situations of rumination around such a large but urgent question.\r\n\r\nFor two months, blown-up versions of these cards will be drawn regularly in Constant\u2019s vitrine to give passers-by a peak into the game with a possibility to participate to the collective exploration by leaving their own answers or additional questions.\r\n\r\nYou are also warmly invited not to the usually christmas drinks but instead a SPLINT print-party on the 15th December where we\u2019ll print decks for everyone, discuss the game and enjoy christmas drinks.\r\n\r\n*This game was inspired by The Oracle for Transfeminist Technologies [https:\/\/www.transfeministech.codingrights.org\/], which incited Constant to make-up its own version of the game.","performers":"Ot Lemmens (graphic designers); Mia Melvaer (artist); Martino Morandi (artist); Elodie Mugrefya (artist); Wendy Van Wynsberghe (artist)","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.546291"},"de":{"name":"Constant_V: The SPLINt cards","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.546291"},"it":{"name":"Constant_V: The SPLINt cards","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.546291"},"sp":{"name":"Constant_V: The SPLINt cards","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.546291"},"pt":{"name":"Constant_V: The SPLINt cards","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.546291"},"cn":{"name":"Constant_V: The SPLINt cards","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.546291"}},"place":{"id":243917,"translations":{"fr":{"name":"Constant asbl","address_street_name":"Rue du Fort","address_street_number":"5","address_street_box":null,"email":"info@constantvzw.org","website":"http:\/\/www.constantvzw.org","phone_contact":"+32 2 539 24 67","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue du Fort, 5","address_line2":"1060 Saint-Gilles","description_web":"Constant est une association sans but lucratif bas\u00e9e \u00e0 Bruxelles, active depuis 1997 dans les domaines de l\u2019art et des m\u00e9dias.\r\nConstant est un atelier interdisciplinaire qui se concentre sur la culture et l\u2019\u00e9thique du web. La pratique artistique de Constant est inspir\u00e9e par la fa\u00e7on avec laquelle les infrastructures technologiques, les \u00e9changes de donn\u00e9es et les logiciels d\u00e9terminent nos vies quotidiennes. Quelques chantiers importants sont le logiciel libre, les alternatives au copyright et le (cyber)f\u00e9minisme.\r\nDe fa\u00e7on r\u00e9guli\u00e8re Constant organise des ateliers, des print-parties, des balades, des performances, des lectures et des rencontres \u2018Verbindingen\/Jonctions\u2019 pour un public qui aime l\u2019exp\u00e9rimentation, la discussion et des \u00e9changes de toutes sortes.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Constant vzw","address_street_name":"Fortstraat","address_street_number":"5","address_street_box":null,"email":"info@constantvzw.org","website":"http:\/\/www.constantvzw.org","phone_contact":"+32 2 539 24 67","phone_booking":null,"address_zip":"1060","address_city":"Sint-Gillis","address_line1":"Fortstraat, 5","address_line2":"1060 Sint-Gillis","description_web":"Constant is een vereniging zonder winstoogmerk werkzaam in het gebied tussen kunst en media.\r\nHet is een interdisciplinaire werkplaats die zich bezighoudt met de cultuur en ethiek van het web. De artistieke praktijk van Constant wordt ge\u00efnspireerd door de manier waarop technologische infrastructuren, data-uitwisseling en software ons dagelijkse leven bepalen. Belangrijke werkterreinen zijn vrije software, alternatieven op auteursrecht en (cyber)feminisme.\r\nConstant organiseert regelmatig workshops, print-parties, wandelingen en \u2018Verbindingen\/Jonctions\u2019-bijeenkomsten voor een publiek dat houdt van experimenten, discussies en uitwisselingen allerhande.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Constant","address_street_name":"Rue du Fort","address_street_number":"5","address_street_box":null,"email":"info@constantvzw.org","website