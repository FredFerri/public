stellingen"}},"others":{"list":[37,36],"translations":{"de":["Audiovisuelle K\u00fcnste","Museen & Kunstzentren"],"pt":[null,null],"en":["Audiovisual art","Museums and art centers"],"it":["Arti audiovisive","Musei e centri artistici"],"cn":[null,null],"fr":["Arts audiovisuels","Mus\u00e9es et art centers"],"sp":["Artes audiovisuales","Museos y centros de arte"],"nl":["Audiovisuele kunst","Musea en kunstcentra"]}}},"translations":{"de":{"name":"Planet Happiness","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.planethappiness.be","email":"hello@planethappiness.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50008824"},"pt":{"name":"Planet Happiness","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.planethappiness.be","email":"hello@planethappiness.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50008824"},"en":{"name":"Planet Happiness","shortdescr":"Unleash your inner astronaut","longdescr":"Fasten your seatbelts and get ready for take off to Planet Happiness! A brand-new immersive exhibition where curiosity knows no boundaries and the limits of your imagination are pushed to infinity and beyond.\n\nEmbark on an exploration of happiness and unleash your inner astronaut in a cosmic adventure with AI, augmented reality, and 360\u00b0 immersion. An astronomical fusion of science and art where the wonders of space become the canvas for your wildest imagination.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.planethappiness.be","email":"hello@planethappiness.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50008824"},"it":{"name":"Planet Happiness","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.planethappiness.be","email":"hello@planethappiness.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50008824"},"cn":{"name":"Planet Happiness","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.planethappiness.be","email":"hello@planethappiness.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50008824"},"fr":{"name":"Planet Happiness","shortdescr":"Unleash your inner astronaut","longdescr":"Attachez vos ceintures et pr\u00e9parez-vous \u00e0 d\u00e9coller vers Planet Happiness! Une toute nouvelle exposition immersive o\u00f9 la curiosit\u00e9 ne conna\u00eet pas de fronti\u00e8res, qui repoussera \u00e0 l'infini les limites de votre imagination.\n\nPartez \u00e0 la d\u00e9couverte du bonheur et lib\u00e9rez l'astronaute qui sommeille en vous, au fil d\u2019une aventure cosmique teint\u00e9e d\u2019IA et de r\u00e9alit\u00e9 augment\u00e9e, pour une immersion \u00e0 360\u00b0. Une fusion des sciences et des arts o\u00f9 la beaut\u00e9 de l'espace sert de toile de fond \u00e0 votre imagination.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.planethappiness.be","email":"hello@planethappiness.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50008824"},"sp":{"name":"Planet Happiness","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.planethappiness.be","email":"hello@planethappiness.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50008824"},"nl":{"name":"Planet Happiness","shortdescr":"Unleash your inner astronaut","longdescr":"Riemen vast en maak je klaar voor lancering naar Planet Happiness! Een gloednieuwe digitale tentoonstelling waar nieuwsgierigheid geen limieten kent en