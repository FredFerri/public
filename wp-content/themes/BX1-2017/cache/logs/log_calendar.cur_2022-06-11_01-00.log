s":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-06-02T01:35:30+02:00","published_at":"2022-02-21T13:19:00+01:00","backoffice_id":247991,"import_origin":null,"sub_type":"sport","show_in_agenda":true,"ranking":0.15090455083303},{"id":527977,"date_start":"2021-09-13","date_end":"2022-06-30","date_next":"2022-06-30","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":true,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":74,"translations":{"fr":"Sport","nl":"Sport","en":"Sport"}},"others":{"list":[159,163],"translations":{"fr":["Activit\u00e9 sportive","Natation et sports nautiques"],"nl":["Sportieve activiteit","Zwemmen en watersport"],"en":["Sporting activity","Swimming and water sports"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Aquagym Anderlecht","shortdescr":"L'aquagym favorise un d\u00e9veloppement harmonieux de tous les muscles du corps, soulage les douleurs de la colonne lombaire, corrige la statique et les tassements vert\u00e9braux.","longdescr":"INSCRIPTION \u00e0 partir du 16 ao\u00fbt 2021\r\n> Le cours se paie :\r\n- Soit 4\u20ac \u00e0 la s\u00e9ance directement au moniteur (hors entr\u00e9e de piscine);\r\n- Soit avec une carte de 10 s\u00e9ances, valable 4 mois \u00e0 dater de la premi\u00e8re s\u00e9ance\r\neffective et jusqu\u2019en juin 2022, co\u00fbtant 32 \u20ac (soit 10 s\u00e9ances pour le prix de 8 s\u00e9ances), qui se commande jusqu\u2019au 25 f\u00e9vrier 2022 (une carte par cours) ;\r\n- Soit avec un abonnement valable de septembre \u00e0 juin, co\u00fbtant 90 \u20ac (soit 36 s\u00e9ances\r\npour le prix de 22 s\u00e9ances), qui s\u2019ach\u00e8te jusqu\u2019au 10 octobre 2021 (un abonnement\r\npar cours).\r\n\r\n> Comment proc\u00e9der ?\r\n- Par e-mail : loisirs.sante@fmsb.be \r\n- Par courrier : rue des Moineaux 17-19, 1000 Bruxelles \r\n\r\nEn mentionnant: nom \/ pr\u00e9nom \/ adresse \/ date de naissance \/ Gsm \/ le(s) cours choisi(s) (commune et horaire) \/ n\u00b0 de membre Loisirs et Sant\u00e9 ou n\u00b0 de mutuelle. \r\nD\u00e8s que vous avez fait votre demande pour une carte de 10 s\u00e9ances ou un abonnement, vous pouvez effectuer le paiement sur le compte de Loisirs et Sant\u00e9 asbl (BE 22 3101 3243 0247) avec en communication libre : votre n\u00b0 de membre, le cours suivi, et la commune. \r\nPr\u00e9sentez votre preuve de paiement au professeur de sport, sinon le tarif \u00e0 la s\u00e9ance vous sera demand\u00e9 et ne sera pas remboursable. L\u2019abonnement ou la carte est envoy\u00e9(e) au moniteur.\r\n\r\n> D\u00e9but et fin des cours\r\nLa saison 2021-2022 reprendra le 13 septembre 2021 et se termine le 30 juin 2022. Les cours ont lieu tous les jeudis sauf pendant les cong\u00e9s scolaires.\r\n\r\n> Remarque\r\nPour la bonne marche des cours, ceux-ci sont strictement r\u00e9serv\u00e9s aux adultes en \u00e2ge d\u2019exercer une activit\u00e9 professionnelle et sont mixtes. \r\n\r\n> L'affiliation\r\nL'affiliation peut \u00eatre demand\u00e9e par toute personne en \u00e2ge d'exercer une activit\u00e9 professionnelle. La cotisation pour l'affiliation \u00e0 l'asbl Loisirs & Sant\u00e9 est de 50 \u20ac par an (septembre\/juin). Les membres de la F\u00e9d\u00e9ration des Mutualit\u00e9s Socialistes du Brabant qui s'affilient \u00e0 l'asbl Loisirs & Sant\u00e9 obtiennent une intervention de 50 \u20ac dans le prix pay\u00e9 pour l'affiliation. De ce fait, l'affiliation \u00e0 l'asbl Loisirs & Sant\u00e9 est gratuite pour les membres.\r\n\r\nLes conditions g\u00e9n\u00e9rales sous lesquelles sont organis\u00e9es les activit\u00e9s sont disponibles sur le site https:\/\/www.fmsb.be\/fr\/loisirs-et-sante Vous inscrire implique que vous en ayez pris connaissance.","performers":"Denis Huysmans","boxoffice_url":null,"website":"https:\/\/www.fmsb.be\/adultes-loisirs-et-sante-asbl","email":"loisirs.sante@fmsb.be","phone_contact":null,"phone_booking":"+32 2 546 15 70","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/527977.html"},"nl":{"name":"Aquagym","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/527977.html"},"en":{"name":"Aquagym","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/527977.html"},"de":{"name":"Aquagym","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/527977.html"},"it":{"name":"Aquagym","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/527977.html"},"sp":{"name":"Aquagym","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/527977.html"},"pt":{"name":"Aquagym","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/527977.html"},"cn":{"name":"Aquagym","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/527977.html"}},"place":{"id":277761,"translations":{"fr":{"name":"Pis