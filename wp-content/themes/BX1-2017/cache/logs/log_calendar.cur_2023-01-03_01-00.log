l"},"de":{"name":"Normal"},"it":{"name":"Normal"},"sp":{"name":"Normal"},"pt":{"name":"Normal"},"cn":{"name":"Normal"}},"value":15},{"translations":{"fr":{"name":"Demandeurs d'emploi"},"nl":{"name":"Werkzoekenden"},"en":{"name":"Job seekers"},"de":{"name":"Arbeitsuchende"},"it":{"name":"Demandeurs d'emploi"},"sp":{"name":"Demandeurs d'emploi"},"pt":{"name":"Demandeurs d'emploi"},"cn":{"name":"Demandeurs d'emploi"}},"value":10},{"translations":{"fr":{"name":"Article 27"},"nl":{"name":"Artikel 27"},"en":{"name":"Article 27"},"de":{"name":"Article 27"},"it":{"name":"Article 27"},"sp":{"name":"Article 27"},"pt":{"name":"Article 27"},"cn":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-11-23T15:54:59+01:00","published_at":"2022-06-07T13:42:12+02:00","backoffice_id":255479,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":1.1447142425533},{"id":547177,"date_start":"2023-01-13","date_end":"2023-01-13","date_next":"2023-01-13","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert","de":"Konzert","it":null,"sp":null,"pt":null,"cn":null}},"others":{"list":[2],"translations":{"fr":["Classique"],"nl":["Klassiek"],"en":["Classical"],"de":["Klassisch"],"it":[null],"sp":[null],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Alice Foccroulle et Pierre Gallon : deutsche Lieder de Joseph Haydn","shortdescr":"Avec ce r\u00e9cital consacr\u00e9 aux deutsche Lieder de Joseph Haydn, Alice Foccroulle (soprano)   et Pierre Gallon (clavecin et pianoforte) se livrent \u00e0 une lecture personnelle, d\u00e9barrass\u00e9e des vernis successifs laiss\u00e9s au fil des si\u00e8cles sur ces petits tr\u00e9sors de la musique vocale.","longdescr":"Accompagn\u00e9e par le clavecin, Alice Foccroulle nous guide sur cette fabuleuse ligne de cr\u00eate entre Baroque et Classicisme. L\u2019auditeur est convi\u00e9 au c\u0153ur des salons viennois de la fin du XVIIIe si\u00e8cle o\u00f9 chansons d\u2019amour et petits contes philosophiques ou spirituels en langue allemande accompagnent le divertissement domestique et se r\u00e9pondent avec tendresse, intensit\u00e9 et humour, que rel\u00e8ve parfois une touche de cynisme. En somme un Haydn de l\u2019intime qui traduit formidablement bien l\u2019esprit d\u2019une \u00e9poque en pleine mutation.","performers":"Alice Foccroulle (soprano)   et Pierre Gallon (clavecin et pianoforte)","boxoffice_url":null,"website":"https:\/\/www.lebaixu.be","email":"info@lebaixu.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.547177"},"nl":{"name":"Alice Foccroulle et Pierre Gallon : deutsche Lieder de Joseph Haydn","shortdescr":"In dit recital gewijd aan de deutsche Lieder van Joseph Haydn geven Alice Foccroulle (sopraan) en Pierre Gallon (klavecimbel en fortepiano) een persoonlijke lezing, vrij van de opeenvolgende vernissen die door de eeuwen heen op deze kleine schatten van vocale muziek zijn aangebracht.","longdescr":"Begeleid door het klavecimbel leidt Alice Foccroulle ons langs deze fabelachtige heuvelrug tussen barok en classicisme. De luisteraar wordt uitgenodigd in het hart van de Weense salons van de late 18e eeuw, waar liefdesliederen en kleine filosofische of spirituele verhalen in het Duits het huiselijk vermaak begeleiden en met tederheid, intensiteit en humor, soms met een vleugje cynisme, op elkaar reageren. Kortom, dit is een Haydn van het intieme die de geest van een tijdperk in volle mutatie formidabel goed vertaalt.","performers":"Alice Foccroulle (sopraan) en Pierre Gallon (klavecimbel en fortepiano)","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.547177"},"en":{"name":"Alice Foccroulle et Pierre Gallon : deutsche Lieder de Joseph Haydn","shortdescr":"In this recital devoted to Joseph Haydn's deutsche Lieder, Alice Foccroulle (soprano) and Pierre Gallon (harpsichord and fortepiano) give a personal reading, free of the successive varnishes left over the centuries on these little treasures of vocal music.","longdescr":"Accompanied by the harpsichord, Alice Foccroulle guides us along this fabulous ridge between Baroque and Classicism. The listener is invited into the heart of the Viennese salons of the late 18th century, where love songs and little philosophical or spiritual tales in German accompany domestic entertainment and respond to each other with tenderness, intensity and humour, sometimes with a touch of cynicism. In short, this is a Haydn of the intimate which translates formidably well the spirit of an era in full mutation.","performers":"Alice Foccroulle (soprano) and Pierre Gallon (harpsichord and fortepiano)","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.547177"},"de":{"name":"Alice Foccroulle et Pierre Gallon : deutsche Lieder de Joseph Haydn","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.547177"},"it":{"name":"Alice Foccroulle et Pierre Gallon : deutsche Lieder de Joseph Haydn","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"ht