":"https:\/\/www.senghor.be\/event\/tarek-alsayed\/","email":"reservation@senghor.be","phone_contact":null,"phone_booking":"+32 470 84 56 36","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50001198"},"en":{"name":"Tarek Alsayed","shortdescr":"Tarek Alsayed est un joueur de oud, compositeur et improvisateur. ","longdescr":"Tarek Alsayed est un joueur de oud, compositeur et improvisateur. Il est n\u00e9 et a \u00e9tudi\u00e9 le oud et la musique dans la ville d\u2019Alep en Syrie. Il a \u00e9galement enseign\u00e9 dans les acad\u00e9mies de musique d\u2019Alep jusqu\u2019en 2013, enseignant maintenant \u00e0 l\u2019acad\u00e9mie de musique de Sint-Niklaas, Belgique depuis 2016. Tarek a donn\u00e9 des concerts dans de nombreux pays tels que la Syrie, Liban, Tunisie, Turquie, France, Allemagne etc. Il viendra nous pr\u00e9senter sur le pi\u00e9tonnier ses propres compositions et improvisations.\n","performers":"OUD : Tarek Yahya","boxoffice_url":null,"website":"https:\/\/www.senghor.be\/event\/tarek-alsayed\/","email":"reservation@senghor.be","phone_contact":null,"phone_booking":"+32 470 84 56 36","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50001198"},"it":{"name":"Tarek Alsayed","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.senghor.be\/event\/tarek-alsayed\/","email":"reservation@senghor.be","phone_contact":null,"phone_booking":"+32 470 84 56 36","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50001198"},"cn":{"name":"Tarek Alsayed","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.senghor.be\/event\/tarek-alsayed\/","email":"reservation@senghor.be","phone_contact":null,"phone_booking":"+32 470 84 56 36","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50001198"},"fr":{"name":"Tarek Alsayed","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url"