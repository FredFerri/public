alse,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-04-30T02:00:46+02:00","published_at":"2024-02-13T09:00:57+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":294389,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.7137658555036082,"languages":{"spoken":["en","fr","nl"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[45,36],"translations":{"de":["Mode","Museen & Kunstzentren"],"pt":[null,null],"en":["Fashion","Museums and art centers"],"it":["Moda","Musei e centri artistici"],"cn":[null,null],"fr":["Mode","Mus\u00e9es et art centers"],"sp":["Moda","Museos y centros de arte"],"nl":["Mode","Musea en kunstcentra"]}}},"translations":{"de":{"name":"Brussels Jewellery Week","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.mad.brussels","email":"contact@mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50007182"},"pt":{"name":"Brussels Jewellery Week","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.mad.brussels","email":"contact@mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50007182"},"en":{"name":"Brussels Jewellery Week","shortdescr":null,"longdescr":"From 25 April to 5 May, Brussels will be all about contemporary jewellery! For its second edition, the Brussels Jewellery Week brings together established and emerging artists, collectors and an international audience. \n\nBrussels Jewellery Week aims to highlight contemporary jewellery as a creative and innovative craft. In addition to the main exhibition at MAD Brussels, tours, lectures and workshops will be organised at various locations around the city.\n\nPARTICLE[S]\n\nIn physics, \"elementary particles\" are the smallest elements that form the matter and forces of the universe: in constant motion, these small entities are capable, by fusion, of forming large ensembles, thus forming the basis of all creation and transformation. In grammar, a particle is a small unchanging element: fixed, unassuming, it inflects the meaning of a word by connecting with it.\n\nThe concept of PARTICLE[S] can be approached from a purely scientific or technical standpoint. But it can also be seen, in a world threatened by pollution, as a metaphor for many human interactions that ultimately form a critical mass. In the world of contemporary jewelry, we see that each material consists of the same tiny particles that together, in subtle arrangements, form a work of art.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.mad.brussels","email":"contact@mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50007182"},"it":{"name":"Brussels Jewellery Week","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.mad.brussels","email":"contact@mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50007182"},"cn":{"name":"Brussels Jewellery Week","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.mad.brussels","email":"contact@mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50007182"},"fr":{"name":"Brussels Jewellery Week","shortdescr":null,"longdescr":"Du 25 avril au 5 mai, Bruxelles se met \u00e0 l'heure du bijou contemporain ! La capitale europ\u00e9enne r\u00e9unit des artistes \u00e9tablis et \u00e9mergents, des collectionneurs et un public international pour la deuxi\u00e8me \u00e9dition de la Brussels Jewellery Week. Pour rappel, la premi\u00e8re \u00e9dition a eu lieu en 2022, avec l'exposition principale \"In Fieri\" au MAD Brussels.\n\nLa Brussels Jewellery Week vise \u00e0 mettre en valeur le bijou contemporain en tant qu'artisanat cr\u00e9atif et innovant. En plus de l'exposition principale au MAD Brussels, des visites guid\u00e9es, des conf\u00e9rences et des ateliers seront organis\u00e9s \u00e0 travers toute la ville.\n\nPARTICLE[S]\n\nEn physique, les \"particules \u00e9l\u00e9mentaires\" sont les plus petits \u00e9l\u00e9ments qui forment la mati\u00e8re et les forces de l'univers : en mouvement constant, ces petites entit\u00e9s sont capables, par fusion, de former de grands ensembles, \u00e0 la base de toute cr\u00e9ation et transformation. En grammaire, une particule est un petit \u00e9l\u00e9ment immuable : fixe, discr\u00e8te, elle infl\u00e9chit le sens d'un mot en se liant \u00e0 lui.\n\nLe concept de PARTICULE[S] peut \u00eatre abord\u00e9 d'un point de vue purement scientifique ou technique. Mais il peut aussi \u00eatre envisag\u00e9, dans un monde menac\u00e9 par la pollution, comme une m\u00e9taphore des nombreuses interactions humaines qui finissent par former une masse critique. Dans l'univers de la joaillerie contemporaine, on constate que chaque mat\u00e9riau est constitu\u00e9 des m\u00eames minuscules particules qui, ensemble, dans des arrangements subtils, forment une \u0153uvre d'art.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.mad.brussels","email":"contact@mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50007182"},"sp":{"name":"Brussels Jewellery Week","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.mad.brussels","email":"contact@mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50007182"},"nl":{"name":"Brussels Jewellery Week","shortdescr":null,"longdescr":"Van 25 april tot 5 mei staat Brussel in het teken van hedendaagse juwelen! Voor haar tweede editie brengt de Brussels Jewellery Week gevestigde en opkomende kunstenaars, verzamelaars en een internationaal publiek samen. \n\nDe Brussels Jewellery Week wil hedendaagse juwelen onder de aandacht brengen als een creatieve en innovatieve ambacht. Naast de hoofdtentoonstelling bij MAD Brussels worden er rondleidingen, lezingen en workshops georganiseerd op verschillende locaties in de stad.\n\nPARTICLE[S]\n\nIn de fysica zijn 'elementaire deeltjes' de kleinste elementen waaruit de materie en de krachten van het universum bestaan: in voortdurende beweging zijn deze kleine lichamen in staat om, door samensmelting, grote ensembles te vormen en zo de basis te vormen van alle schepping en transformatie. In de grammatica is een deeltje een klein onveranderlijk element: vast, bescheiden, het verbuigt de betekenis van een woord door zich ermee te verbinden.\n\nHet begrip PARTICLE[S] kan benaderd worden vanuit een puur wetenschappelijk of technisch standpunt. Maar het kan ook gezien worden, in een wereld die bedreigd wordt door vervuiling, als een metafoor voor vele menselijke interacties die uiteindelijk een kritische massa vormen. In de wereld van de hedendaagse juwelen zien we dat elk materiaal bestaat uit dezelfde kleine deeltjes die samen, in subtiele ordeningen, een kunstwerk vormen.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.mad.brussels","email":"contact@mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50007182"}},"place":{"last_updated_at":"2024-03-04T10:32:39+01:00","published_at":"2013-10-19T01:34:31+02:00","id":250516,"translations":{"de":{"name":"MAD Brussels","address_street_name":"Place du Nouveau March\u00e9 aux Grains","address_street_number":"10","address_street_box":null,"email":"contact@mad.brussels","website":"http:\/\/www.mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":"+32 2 880 85 62","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place du Nouveau March\u00e9 aux Grains, 10","address_line2":"1000 Bruxelles","description_web":"MAD Brussels ist eine Br\u00fcsseler Mode- und Designplattform, die sich der F\u00f6rderung, Unterst\u00fctzung und Begleitung der Br\u00fcsseler Modesch\u00f6pfer und Designern verschrieben hat, um sowohl landesweit als auch international ihre Reichweite zu erh\u00f6hen.\r\n\r\nDie Er\u00f6ffnung des neuen, komplett in Wei\u00df gehaltenen Geb\u00e4udes hat dem MAD Brussels noch einmal frischen Wind in den Segeln beschert. Hier befinden sich nicht nur Ressourcen f\u00fcr Vertreter der Kreativindustrie und damit zusammenh\u00e4ngenden Metiers, sondern auch vielf\u00e4ltig nutzbare Arbeitspl\u00e4tze und Orte der Begegnung. Modesch\u00f6pfer und Designer haben hier eine Anlaufstelle, gleichzeitig finden in den R\u00e4umen Ateliers, Workshops, Seminare, Ausstellungen, Modeschauen, Kunst-Performances statt\u2026\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"MAD Brussels","address_street_name":"Place du Nouveau March\u00e9 aux Grains","address_street_number":"10","address_street_box":null,"email":"contact@mad.brussels","website":"http:\/\/www.mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":"+32 2 880 85 62","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place du Nouveau March\u00e9 aux Grains, 10","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"MAD Brussels","address_street_name":"Nieuwe Graanmarkt","address_street_number":"10","address_street_box":null,"email":"contact@mad.brussels","website":"http:\/\/www.mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":"+32 2 880 85 62","address_zip":"1000","address_city":"Brussels","address_line1":"Nieuwe Graanmarkt, 10","address_line2":"1000 Brussels","description_web":"MAD Brussels is a Brussels\u2019 platform for gathering expertise from the city\u2019s Fashion and Design sectors. It aims to help with the promotion and development of Brussels stylists and designers and improve their exposure nationally and abroad.\r\n\r\nThe opening in April 2017 of their brand new, sparkling white headquarters marked something of a renaissance for the non-profit organisation, which can now multiply and combine its campaigns. It houses a ressource centre for professionals of the creative industries and related sectors, along with adaptable workspaces, meeting spaces, workshops, seminar rooms and a large space dedicated to public activities where multiple events are organised every year: exhibitions, fashion shows, artistic performances\u2026\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"MAD Brussels","address_street_name":"Place du Nouveau March\u00e9 aux Grains","address_street_number":"10","address_street_box":null,"email":"contact@mad.brussels","website":"http:\/\/www.mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":"+32 2 880 85 62","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place du Nouveau March\u00e9 aux Grains, 10","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"MAD Brussels","address_street_name":"Place du Nouveau March\u00e9 aux Grains","address_street_number":"10","address_street_box":null,"email":"contact@mad.brussels","website":"http:\/\/www.mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":"+32 2 880 85 62","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place du Nouveau March\u00e9 aux Grains, 10","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"MAD Brussels","address_street_name":"Place du Nouveau March\u00e9 aux Grains","address_street_number":"10","address_street_box":null,"email":"contact@mad.brussels","website":"http:\/\/www.mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":"+32 2 880 85 62","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place du Nouveau March\u00e9 aux Grains, 10","address_line2":"1000 Bruxelles","description_web":"MAD Brussels est la plateforme bruxelloise d\u2019expertise dans les secteurs de la Mode et du Design.   Elle s\u2019emploie \u00e0 renforcer la promotion, \u00e0 accompagner le d\u00e9veloppement des stylistes et designers bruxellois et \u00e0 accro\u00eetre leur rayonnement (inter )national.  \r\n\r\nL\u2019ouverture en avril 2017 du nouveau b\u00e2timent enti\u00e8rement blanc a marqu\u00e9 une renaissance pour l\u2019asbl, qui dans ce lieu unique multiplie et combine ses actions. Il h\u00e9berge le centre de ressources pour les professionnels des industries cr\u00e9atives aux fili\u00e8res de m\u00e9tiers d\u00e9riv\u00e9es, des espaces de travail polyvalents, lieux de rencontres, d\u2019accueil de cr\u00e9ateurs, d\u2019ateliers, de s\u00e9minaires, ainsi qu\u2019un grand espace d\u00e9di\u00e9 aux activit\u00e9s publiques o\u00f9 sont organis\u00e9es chaque ann\u00e9e de multiples \u00e9v\u00e8nements: expositions, d\u00e9fil\u00e9s, performances artistiques,\u2026\r\n\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"MAD Brussels","address_street_name":"Place du Nouveau March\u00e9 aux Grains","address_street_number":"10","address_street_box":null,"email":"contact@mad.brussels","website":"http:\/\/www.mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":"+32 2 880 85 62","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place du Nouveau March\u00e9 aux Grains, 10","address_line2":"1000 Bruxelles","description_web":"MAD Brussels es una plataforma de Bruselas que reune expertos del los sectores de la moda y el dise\u00f1o. Tiene como objetivo ayudar en la promoci\u00f3n y el desarrollo de los dise\u00f1adores y estilistas de Bruselas y mejorar su imagen nacional e internacional.\r\nLa apertura de su novedosa y chispeante sede en abril de 2017 marc\u00f3 algo as\u00ed como el renacimiento para la organizaci\u00f3n sin \u00e1nimo de lucro, que ahora puede multiplicar y combinar sus campa\u00f1as. Posee un centro de recursos para profesionales de industrias culturales y sectores relacionados, junto con espacios de trabajo adaptados, lugares de reuni\u00f3n, talleres, seminarios y un gran espacio dedicado a actividades p\u00fablicas donde se organizan diversos eventos cada a\u00f1o: exhibiciones, desfiles de moda, representaciones art\u00edsticas\u2026\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"MAD Brussels","address_street_name":"Nieuwe Graanmarkt","address_street_number":"10","address_street_box":null,"email":"contact@mad.brussels","website":"http:\/\/www.mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":"+32 2 880 85 62","address_zip":"1000","address_city":"Brussel","address_line1":"Nieuwe Graanmarkt, 10","address_line2":"1000 Brussel","description_web":"MAD Brussels is het Brussels kennisplatform voor de mode- en designsectoren.  Het zet zich in voor de promotie en begeleiding van Brusselse stylisten en ontwerpers en de vergroting van hun (inter)nationale uitstraling. \r\n\r\nDe opening van hun nieuwe, volledig witte gebouw in april 2017 betekende een belangrijke impuls voor de vzw die op die unieke plek zijn verschillende doelstellingen kan uitbreiden en combineren. Het gebouw herbergt het onderzoekscentrum voor professionals uit de creatieve sectoren en aanverwante beroepsgroepen, multifunctionele werkruimtes, ontmoetingsplekken, ontvangstruimtes voor ontwerpers, workshops en seminaries en daarbij ook nog een grote ruimte waarin elk jaar verschillende activiteiten voor het grote publiek plaatsvinden, zoals tentoonstellingen, modeshows of artistieke performances.  \r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[3],"translations":{"de":["Dansaert\/Sainte-Catherine"],"pt":[null],"en":["Dansaert\/Sainte-Catherine"],"it":["Dansaert\/Sainte-Catherine"],"cn":[null],"fr":["Dansaert\/Sainte-Catherine"],"sp":["Dansaert\/Sainte-Catherine"],"nl":["Dansaertwijk\/Sint-Katelijne"]}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":null,"facebook_id":null,"backoffice_id":12629,"location":{"lat":50.851148,"lon":4.3441836},"region":"brussels","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"last_updated_at":"2024-03-04T10:32:39+01:00","published_at":"2013-10-19T01:34:31+02:00","id":250516,"translations":{"de":{"name":"MAD Brussels","address_street_name":"Place du Nouveau March\u00e9 aux Grains","address_street_number":"10","address_street_box":null,"email":"contact@mad.brussels","website":"http:\/\/www.mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":"+32 2 880 85 62","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place du Nouveau March\u00e9 aux Grains, 10","address_line2":"1000 Bruxelles","description_web":"MAD Brussels ist eine Br\u00fcsseler Mode- und Designplattform, die sich der F\u00f6rderung, Unterst\u00fctzung