","WC idoneo"],"sp":["Habilitado","Ba\u00f1os adaptados"],"pt":[null,null],"cn":[null,null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2023-02-21T14:05:24+01:00","published_at":"2023-02-07T16:47:13+01:00","backoffice_id":269799,"import_origin":null,"sub_type":"foire","show_in_agenda":true,"ranking":0.7937005259841},{"id":552811,"date_start":"2023-03-16","date_end":"2023-04-06","date_next":"2023-03-16","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung","it":"Esposizioni","sp":"Exhibici\u00f3n","pt":null,"cn":null}},"others":{"list":[36,40],"translations":{"fr":["Mus\u00e9es et art centers","Arts graphiques"],"nl":["Musea en kunstcentra","Grafische kunst, vormgeving"],"en":["Museums and art centers","Graphic art"],"de":["Museen & Kunstzentren","Grafische K\u00fcnste"],"it":["Musei e centri artistici","Arti grafiche"],"sp":["Museos y centros de arte","Artes gr\u00e1ficas"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["it","fr","en"],"subtitles":[]},"translations":{"fr":{"name":"EXPO Perch\u00e9 ce ne andiamo ? Italiani a marzo feat. Matteo Falone","shortdescr":"Perch\u00e9 ce ne andiamo? En mars, des artistes de la deuxi\u00e8me communaut\u00e9 \u00e9trang\u00e8re de Belgique racontent pourquoi ils & elles ont quitt\u00e9 l\u2019Italie et ce qu\u2019ils ont emport\u00e9 avec eux de leur culture, et leurs regrets.","longdescr":"\u00ab Pourquoi nous partons? \u00bb Ou plut\u00f4t \u00e0 cause de qui ? Avec sa GALLERIA DEI MOSTRI, le collectif \u00e9ph\u00e9m\u00e8re des \"Italiani a marzo\" vous d\u00e9voilent les visages de ceux qui ont enlaidi l\u2019Italie. Une exposition qui montre des bouts d\u2019une histoire vilaine mais int\u00e9ressante, comme l\u2019Histoire qui est souvent vilaine mais int\u00e9ressante.\r\n\r\nLe projet des CARTE DA GIOCO de Matteo Falone racontent des histoires inqui\u00e9tantes o\u00f9 se c\u00f4toient l\u2019absurde, le grotesque, la violence et l\u2019ironie. Son jeu de carte italo-mosellan r\u00e9interpr\u00e8te le jeu de cartes traditionnel sicilien. Petit-fils d\u2019ouvriers immigr\u00e9s, le \"mazzo di carte\" est un objet culte de son h\u00e9ritage culturel, qu\u2019il d\u00e9tourne en y int\u00e9grant des \u00e9l\u00e9ments de son univers graphique m\u00e9langeant les registres cocasses et \u00e9piques, l\u2019esth\u00e9tique des friches industrielles de la Moselle aux fantasmes de la mythologie sicilienne. Une qu\u00eate identitaire plurielle, d\u00e9racin\u00e9e, ambig\u00fce.\r\n\r\nVernissage festif le jeudi 16 mars de 18h \u00e0 22h. Au programme : tournoi de fl\u00e9chettes et po\u00e9sie italienne contemporaine. \r\n\r\nEntr\u00e9e gratuite\r\nToutes les infos sur la page de l'\u00e9v\u00e8nement : https:\/\/fb.me\/e\/6ozTfTht7","performers":"Matteo Falone (exhibition ) ; MedexMuseum (exhibition)","boxoffice_url":null,"website":"http:\/\/www.medexmuseum.com","email":"medexmuseum@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.552811"},"nl":{"name":"EXPO Perch\u00e9 ce ne andiamo ? Italiani a marzo feat. Matteo Falone","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.medexmuseum.com","email":"medexmuseum@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.552811"},"en":{"name":"EXPO Perch\u00e9 ce ne andiamo ? Italiani a marzo feat. Matteo Falone","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.medexmuseum.com","email":"medexmuseum@gmail.com","phone_co