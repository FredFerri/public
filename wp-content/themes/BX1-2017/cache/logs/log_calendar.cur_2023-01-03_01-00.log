st":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-12-20T15:35:15+01:00","published_at":"2022-12-20T15:17:16+01:00","backoffice_id":267814,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.37475617678432},{"id":546746,"date_start":"2022-12-11","date_end":"2023-01-22","date_next":"2023-01-19","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater","it":null,"sp":null,"pt":null,"cn":null}},"others":{"list":[53],"translations":{"fr":["Contes"],"nl":["Verteltheater"],"en":["Tales"],"de":["M\u00e4rchen"],"it":[null],"sp":[null],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Contes au mus\u00e9e : Antre[s] de Julie Boitte","shortdescr":"\u00ab Tout commence avec l'h\u00e9ritage d'une maison : la demeure d'une grand-tante fantasque, une tourelle envahie de v\u00e9g\u00e9tation...\r\nMais m\u00eame quand le ma\u00eetre dispara\u00eet, l'Antre reste.\r\nGarde effluves, vibrations, souvenirs. \u00bb","longdescr":"Poussez la porte de la Maison Autrique et rejoignez la conteuse Julie Boitte dans un voyage peu ordinaire intitul\u00e9 \u2018Antre[s]\u2019. Au fil des contes gothiques, d\u00e9couvrez ce qu'un lieu d\u00e9voile de l\u2019\u00eatre qui l\u2019habite. Emotion, r\u00eave et frissons seront au rendez-vous\u2026\r\n\r\nEnvie d\u2019\u00e9couter et de vivre d\u2019autres contes ? Cet hiver, petit\u00b7es et grand\u00b7es pourront s\u2019\u00e9merveiller avec un panel de conteurs et conteuses aux univers divers et vari\u00e9s gr\u00e2ce \u00e0 Contes au mus\u00e9e, un projet de la F\u00e9d\u00e9ration de Conteurs Professionnels organis\u00e9 avec le soutien de Brussels Museums et Mus\u00e9es et soci\u00e9t\u00e9 en Wallonie.","performers":"Julie Boitte (\u00e9criture et jeu); Dider Kowarsky (direction d'actrice)","boxoffice_url":null,"website":"https:\/\/www.facebook.com\/maisonautrique\/","email":"info@autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":"+32 2 215 66 00","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.546746"},"nl":{"name":"Contes au mus\u00e9e : Antre[s] de Julie Boitte","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.546746"},"en":{"name":"Contes au mus\u00e9e : Antre[s] de Julie Boitte","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.546746"},"de":{"name":"Contes au mus\u00e9e : Antre[s] de Julie Boitte","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.546746"},"it":{"name":"Contes au mus\u00e9e : Antre[s] de Julie Boitte","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.546746"},"sp":{"name":"Contes au mus\u00e9e : Antre[s] de Julie Boitte","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.546746"},"pt":{"name":"Contes au mus\u00e9e : Antre[s] de Julie Boitte","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.546746"},"cn":{"name":"Contes au mus\u00e9e : Antre[s] de Julie Boitte","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.546746"}},"place":{"id":241931,"translations":{"fr":{"name":"Maison Autrique","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"https:\/\/www.facebook.com\/maisonautrique\/","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":"La Maison Autrique (Horta 1893) est un jalon important de l'Art Nouveau. Elle a fait l'objet d'une restauration exemplaire. Ouverte au public, elle permet \u00e0 chacun de mieux saisir l'int\u00e9r\u00eat historique et esth\u00e9tique des vieilles demeures bruxelloises. Lors de votre visite, vous d\u00e9couvrirez des espaces d'exposition, une petite librairie th\u00e9matique et une sc\u00e9nographie originale sign\u00e9e Beno\u00eet Peeters et Fran\u00e7ois Schuiten. La maison accueille des petits concerts, des expositions temporaires et des ateliers pour enfants. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Autrique Huis","address_street_name":"Haachtsesteenweg","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"https:\/\/www.facebook.com\/maisonautrique\/","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaarbeek","address_line1":"Haachtsesteenweg, 266","address_line2":"1030 Schaarbeek","description_web":"Het Autrique Huis is het eerste markante gebouw van Victor Horta. Het werd in 1893 gebouwd en is nog steeds een voornaam element in het architectonisch patrimonium van Brussel. Het huis werd op uitmuntende wijze gerestaureerd en is open voor het publiek. Het huis is een belangrijke maatstaf van de Art Nouveau : men vindt er reeds elementen terug die de architect en zijn zoektocht kenmerken. De manier waarop de ruimte ingedeeld is, staat garant voor verrassingen : Fran\u00e7ois Schuiten en Beno\u00eet Peeters hebben een originele enscenering opgezet, waarbij het huis van de kelder tot de zolder ingericht werd. Zodoende wordt het huis een soort van eerbetoon aan de Brusselse priv\u00e9-architectuur, terwijl het ook de verbeelding aanspreekt. Het huis organiseert intieme concerten, tentoonstellingen en workshops voor kinderen.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Autrique House","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"https:\/\/www.facebook.com\/maisonautrique\/","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":"Maison Autrique is the very first striking building Victor Horta designed. It was built in 1893 and it's a major part of Brussels' architectural patrimonium. It underwent an exemplary restoration and is now open to the public. This house is an important Art Nouveau touchstone: we can already see elements that form a part of the continual explorations of the architect. It's interior division is full of surprises: Fran\u00e7ois Schuiten and Beno\u00eet Peeters have staged an original scenography, from the cellar to the attic. The house has thus become a sort of tribute to Brussels' private architecture, while at the same time tickling the imagination. The house hosts intimate concerts, temporary exhibitions and workshops for children.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Maison Autrique","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"https:\/\/www.facebook.com\/maisonautrique\/","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":"Als erstes bedeutendes Bauwerk des Jugendstil-Architekten Victor Horta bildet das Maison Autrique ein wichtiges Element des Br\u00fcsseler Architekturerbes.\r\n\r\nEin Meilenstein der Br\u00fcsseler Architekturgeschichte: Denn das Geb\u00e4ude aus dem Jahr 1893 stellt eine wesentliche Etappe in der Entwicklung der gr\u00f6\u00dften belgischen Architekten dar. Durch das Geb\u00e4ude f\u00fchrt eine Szenographie, die von den beiden belgischen Comic-Gr\u00f6\u00dfen Fran\u00e7ois Schuiten und Beno\u00eet Peeter konzipiert wurde. Zugrundeliegende Idee war es, aus diesem Geb\u00e4ude eine Art \"Haus der H\u00e4user\" zu machen, eine Huldigung an die Br\u00fcsseler Architektur und zugleich ein Tor zum Imagin\u00e4ren.\r\n\r\nDas Maison Autrique bietet regelm\u00e4\u00dfig Ausstellungen rund um verschiedene Themen: das 19. Jahrhundert in Br\u00fcssel, Comic oder Jugenstil. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Maison Autrique","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"http:\/\/www.autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Casa Autrique","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"http:\/\/www.autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":"La casa Autrique, obra fundacional de Victor Horta, ha sido completamente renovada, con una puesta en escena imaginaria realizada por los guionistas y dibujantes Schuiten y Peeters. Al entrar, te sumerges en una atm\u00f3sfera \u00fanica.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Maison Autrique","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"http:\/\/www.autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Maison Autrique","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"266","address_street_box":null,"email":"info@autrique.be","website":"http:\/\/www.autrique.be","phone_contact":"+32 2 215 66 00","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 266","address_line2":"1030 Schaerbeek","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":[],"zones":{"list":[20],"translations":{"fr":["Nord"],"nl":["Noord"],"en":["North"],"de":["Norden"],"it":[null],"sp":[null],"pt":[null],"cn":[null]}},"neca":null,"facebook_id":null,"backoffice_id":4383,"