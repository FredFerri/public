s":[476651],"targets":{"list":[4,11,7,8,10],"translations":{"fr":["Enfants 6-9 ans","Famille","Jeunes 12-15 ans","Jeunes 15-18 ans","Seniors"],"nl":["Kinderen 6-9 j.","Familie","Jongeren 12-15 j.","Jongeren 15-18 j.","Senioren"],"en":["Children 6-9 yr.","Family","Youth 12-15  yr.","Youth 15-18  yr.","Seniors"]}},"tags":["kids"],"accessibilities":{"list":[255,259,265,266],"translations":{"fr":["Accessible","Chien d'assistance","WC adapt\u00e9","Brussels Health Safety Label"],"nl":["Toegankelijk","Assistentiehonden","Aangepast toilet","Brussels Health Safety Label"],"en":["Accessible","Assistance dogs","Adapted toilet","Brussels Health Safety Label"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-08-08T10:05:23+02:00","published_at":"2022-06-14T09:17:05+02:00","backoffice_id":255908,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":1.2599210498949},{"id":535685,"date_start":"2022-08-22","date_end":"2022-08-26","date_next":"2022-08-22","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre"}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Stage Th\u00e9\u00e2tre enfant : \u00ab Mettons-nous en sc\u00e8ne ! \u00bb","shortdescr":"Stage de th\u00e9\u00e2tre d\u00e9di\u00e9 aux enfants de 7 \u00e0 9 ans.\r\nCe stage fera de vos enfants les cr\u00e9ateurs et les interpr\u00e8tes de leur propre spectacle.","longdescr":"Stage de th\u00e9\u00e2tre d\u00e9di\u00e9 aux enfants de 7 \u00e0 9 ans \r\n\r\nNotre \u00e9cole de th\u00e9\u00e2tre propose un stage de cinq jours dans lequel vos enfants seront amen\u00e9s \u00e0 explorer et interpr\u00e9ter une histoire qu'ils auront cr\u00e9\u00e9 de toutes pi\u00e8ces.\r\n\r\nLe stage supervis\u00e9 par Carole Ventura, sera dirig\u00e9 dans la bienveillance et la bonne humeur par Lupo Franceschi et Lisa Barbier.\r\n\r\nAu programme :\r\n\u2022 Le matin : on entra\u00eene son corps et sa voix, on s\u2019exerce \u00e0 diff\u00e9rentes pratiques : jeux de r\u00f4le, jonglerie, chant, th\u00e9\u00e2tre d\u2019objet.\r\nUne pause repas pour reprendre des forces et se reposer\u2026\r\n\u2022 L\u2019apr\u00e8s-midi, place \u00e0 notre cr\u00e9ativit\u00e9 d\u2019auteurs : nous inventerons tous ensemble une histoire riche en aventures et rebondissements !\r\nEn fin de stage, les parents pourront assister \u00e0 notre spectacle.\r\n\r\nCe stage fera de vos enfants les cr\u00e9ateurs et les interpr\u00e8tes de leur propre spectacle.\r\n\r\nTarif : 140\u20ac\r\nHoraires : De 9h \u00e0 16h\r\nGarderie gratuite de 8h45 \u00e0 9h et de 16h \u00e0 16h30\r\n\r\nAttestation fiscale d\u00e9livr\u00e9e en fin de stage (donne droit \u00e0 une d\u00e9duction fiscale de 13\u20ac\/jour de stage)","performers":"Le stage supervis\u00e9 par Carole Ventura, sera dirig\u00e9 dans la bienveillance et la bonne humeur par Lupo Franceschi et Lisa Barbier.","boxoffice_url":null,"website":"https:\/\/www.theatrecreanova.be\/cours-enfants\/","email":"adm@theatrecreanova.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/535685.html"},"nl":{"name":"Stage Th\u00e9\u00e2tre enfant : \u00ab Mettons-nous en sc\u00e8ne ! \u00bb","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/535685.html"},"en":{"name":"Stage Th\u00e9\u00e2tre enfant : \u00ab Mettons-nous en sc\u00e8ne ! \u00bb","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_ur