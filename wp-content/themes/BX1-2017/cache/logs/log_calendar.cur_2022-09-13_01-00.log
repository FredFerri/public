ruxelles.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Visite Guid\u00e9e Bruxelles","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Visite Guid\u00e9e Bruxelles","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":"info@visiteguideebruxelles.be","website":"http:\/\/www.visiteguideebruxelles.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Visite Guid\u00e9e Bruxelles","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":null,"facebook_id":null,"backoffice_id":37830,"location":{"lat":50.83580932,"lon":4.30313837},"region":"brussels","last_updated_at":"2022-08-22T01:08:26+02:00","published_at":"2022-02-27T07:00:16+01:00","import_origin":null,"external_id":null,"is_in_address_book":false,"is_in_vb_export":false,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/60e07689c292ce34e24578d1f6fe02d2b5184c3e.jpg","width":810,"height":1080,"ratio":0.75,"translations":{"fr":{"title":"A la d\u00e9couverte du Bruxelles m\u00e9di\u00e9val","copyright":null},"nl":{"title":"A la d\u00e9couverte du Bruxelles m\u00e9di\u00e9val","copyright":null},"en":{"title":"A la d\u00e9couverte du Bruxelles m\u00e9di\u00e9val","copyright":null}}},{"type":"poster","link":"https:\/\/agendabrussels.imgix.net\/19d5ba73871f65ab1d06aef486338a1382e45e0b.jpg","width":1200,"height":670,"ratio":1.79,"translations":{"fr":{"title":"A la d\u00e9couverte du Bruxelles m\u00e9di\u00e9val","copyright":null},"nl":{"title":"A la d\u00e9couverte du Bruxelles m\u00e9di\u00e9val","copyright":null},"en":{"title":"A la d\u00e9couverte du Bruxelles m\u00e9di\u00e9val","copyright":null}}},{"type":"video","link":"https:\/\/www.youtube.com\/watch?v=xeEnbiMiyeQ","oEmbed_title":"Visite Bruxelles, Grand-Place, hotel de ville : l'aile droite","oEmbed_author_name":"Visite Bruxelles","oEmbed_author_url":"https:\/\/www.youtube.com\/c\/VisiteBruxelles","oEmbed_type":"video","oEmbed_height":200,"oEmbed_width":356,"oEmbed_version":"1.0","oEmbed_provider_name":"YouTube","oEmbed_provider_url":"https:\/\/www.youtube.com\/","oEmbed_thumbnail_height":360,"oEmbed_thumbnail_width":480,"oEmbed_thumbnail_url":"https:\/\/i.ytimg.com\/vi\/xeEnbiMiyeQ\/hqdefault.jpg","oEmbed_html":"<iframe width=\"356\" height=\"200\" src=\"https:\/\/www.youtube.com\/embed\/xeEnbiMiyeQ?feature=oembed\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" allowfullscreen><\/iframe>","translations":{"fr":{"title":"Visite Bruxelles, Grand-Place, hotel de ville : l'aile droite"},"nl":{"title":"Visite Bruxelles, Grand-Place, hotel de ville : l'aile droite"},"en":{"title":"Visite Bruxelles, Grand-Place, hotel de ville : l'aile droite"}}}],"dates":[{"day":"2022-05-01","doors":null,"start":"09:30:00","end":"12:30:00","is_soldout":false,"is_canceled":false},{"day":"2022-08-21","doors":null,"start":"09:30:00","end":"12:30:00","is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":32}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":["exterior"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-08-22T01:08:26+02:00","published_at":"2022-03-03T11:52:33+01:00","backoffice_id":248893,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.23112042478354},{"id":528911,"date_start":"2022-04-10","date_end":"2022-09-18","date_next":"2022-09-18","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"La Grand-Place en famille","shortdescr":"L\u00e9g\u00e8re et ludique, interactive et instructive : la visite pour les familles, smartphone \u00e0 la main pour les plus jeunes, avec des jeux-d\u00e9couvertes pour petits et grands : la Grand-Place en s'amusant.","longdescr":"Du contenu pour les parents, du ludique pour les enfants et de l'interactif pour tout le monde.\r\nUn zeste de culture g\u00e9n\u00e9rale pour tous (quand m\u00eame !), des jeux-d\u00e9couvertes de la Grand-Place pour le smartphone des enfants, pendant que les parents d\u00e9couvrent les richesses des fa\u00e7ades ... et l'une ou l'autre \u00e9nigme \u00e0 r\u00e9soudre en famille, afin d'aiguiser son regard et d\u00e9couvrir les petits secrets de la grande place du march\u00e9 bruxellois !\r\nUne visite l\u00e9g\u00e8re et sympa, hors des sentiers conventionnels.\r\nProgramme de la visite guid\u00e9e familiale\r\n*pour tous : Histoire de la Grand-Place et petites histoires anecdotiques de la vie quotidienne bruxelloise\r\n*pour les parents, regard sur les richesses patrimoniales de quelques b\u00e2timents, *interpr\u00e9tation des sculptures et autres \u00e9l\u00e9ments de d\u00e9cor...\r\n*...et pendant ce temps, les enfants tentent de r\u00e9soudre quelques \u00e9nigmes propos\u00e9es sur smartphone ou tablette, afin de percer les myst\u00e8res de la Grand-Place\r\n*pour tous :  \u200bd\u00e9couverte de quelques sculptures amusantes, provocantes, t\u00e9moins du pass\u00e9 m\u00e9di\u00e9val de la ville","performers":"Vincent Beckers, guide touristique et r\u00e9gional","boxoffice_url":null,"website":"http:\/\/www.visiteguideebruxelles.be","email":"info@visiteguideebruxelles.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.528911"},"nl":{"name":"La Grand-Place en famille","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.528911"},"en":{"name":"La Grand-Place en famille","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.528911"},"de":{"name":"La Grand-Place en famille","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.528911"},"it":{"name":"La Grand-Place en famille","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.528911"},"sp":{"name":"La Grand-Place en famille","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.528911"},"pt":{"name":"La Grand-Place en famille","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.528911"},"cn":{"name":"La Grand-Place en famille","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.528911"}},"place":{"id":3743,"translations":{"fr":{"name":"Grand-Place","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"Souvent consid\u00e9r\u00e9e comme la plus belle du monde, la r\u00e9putation de la Grand-Place de Bruxelles n\u2019est plus \u00e0 \u00e9tablir !  \r\n \r\nAujourd\u2019hui encore, elle conserve une fonction politico-administrative en accueillant l\u2019H\u00f4tel de Ville de Bruxelles, qui demeure le lieu de travail du bourgmestre et de la plupart des \u00e9chevins.  \r\n \r\nEn tant que lieu de prestige, elle h\u00e9berge de nombreux \u00e9v\u00e9nements festifs \u2014 concerts, foires, manifestations folkloriques, sapin et cr\u00e8che de No\u00ebl, son et lumi\u00e8re, tapis de fleurs en \u00e9t\u00e9, etc. \u2014 ou symboliques, comme par ex. la r\u00e9ception de sportifs suite \u00e0 leurs performances.  \r\n \r\nSon histoire commence en tant que lieu de march\u00e9 au 12e si\u00e8cle. Progressivement, la place se garnit de maisons et de halles, encore principalement en bois. Le splendide H\u00f4tel de Ville gothique est construit au 15e si\u00e8cle en trois phases ; ce m\u00eame 15e si\u00e8cle voit l\u2019installation des corporations de m\u00e9tiers dans les maisons bordant la Grand-Place. Plus encore qu\u2019actuellement, la place est le centre n\u00e9vralgique de la vie bruxelloise : sur le plan \u00e9conomique donc, comme d\u00e9j\u00e0 mentionn\u00e9, avec une intense activit\u00e9 de vente (plusieurs halles consacr\u00e9es \u00e0 la vente du pain \u2014 actuelle Maison du Roi ou Broodhuis en n\u00e9erlandais \u2014, de la viande, des draps, etc.), sur le plan culturel (repr\u00e9sentations th\u00e9\u00e2trales), sur le plan judiciaire (avec des ex\u00e9cutions qui ont lieu sur la place), et \u00e9videmment sur le plan de la politique locale.  \r\n \r\nSujette \u00e0 un bombardement par les troupes de Louis XIV en 1695, elle est presque enti\u00e8rement reconstruite \u00e0 cette occasion. Elle subit encore d\u2019importantes r\u00e9novations et modifications durant les si\u00e8cles suivants, et ce surtout au 19e si\u00e8cle, pour lui conf\u00e9rer son aspect actuel.  \r\n \r\nLa Grand-Place de Bruxelles est inscrite sur la liste du patrimoine mondial de l\u2019UNESCO depuis 1998. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Grote Markt","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Grote Markt","address_line2":"1000 Brussel","description_web":"De Brusselse Grote Markt, die te boek staat als een van de mooiste pleinen ter wereld, is een must-see op het toeristische trekpleisterlijstje.  \r\n \r\nDoor de aanwezigheid van het stadhuis van Brussel heeft het plein ook nog steeds een politieke en administratieve functie: de burgemeester en de meeste schepenen werken hier.  \r\n\r\nHet is ook een plek die aanzien uitstraalt. Getuige daarvan zijn de vele plechtige, feestelijke of symbolische evenementen die er plaatsvinden: concerten, braderie\u00ebn, volksfeesten, de jaarlijkse kerstboom en -kribbe, klank- en lichtspelen, het bloementapijt in de zomer en de huldiging van sporters na een uitzonderlijke prestatie (denk bijvoorbeeld aan het WK voetbal in 2018). \r\n\r\nDe geschiedenis van de Grote Markt als 'marktplaats' gaat terug tot de twaalfde eeuw. Na verloop van tijd werden rondom het plein huizen en hallen opgetrokken, voornamelijk van hout. De bouw van het prachtige gotische stadhuis in de vijftiende eeuw verliep in drie fasen. Vanaf die periode zouden ook de gildehuizen het uitzicht van de Grote Markt mee bepalen. Meer nog dan vandaag was de Grote Markt in die tijd het kloppende hart van de stad, op economisch, cultureel en gerechtelijk vlak. Zo werd er duchtig handel gedreven (in de hallen gingen brood \u2013 het huidige Broodhuis \u2013 vlees, stoffen enzovoort over de toonbank), kon je op het plein theatervoorstellingen bijwonen en vonden er openbare terechtstellingen plaats. Het was uiteraard ook de plek waar het lokale beleid werd uitgetekend. \r\n\r\nNa een bombardement door de troepen van Lodewijk XIV in 1695 werd de Grote Markt zo goed als volledig heropgebouwd. Tijdens de eeuwen daarna ondergingen nog heel wat gebouwen grootschalige renovaties en aanpassingen. Vooral in de negentiende eeuw werd het plein in zijn huidige gedaante vastgelegd. \r\n\r\nDe Grote Markt van Brussel staat sinds 1998 op de Werelderfgoedlijst van de Unesco. \r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Grand-Place","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Grand-Place","address_line2":"1000 Brussels","description_web":"Often considered the most beautiful square in the world, the Grand-Place of Brussels' reputation precedes it!  \r\n \r\nToday, it still has a political and administrative function as it houses the City of Brussels Town Hall, which remains the workplace of the mayor and most of their aldermen.  \r\n \r\nAs a prestigious venue, it hosts many festive events - concerts, fairs, folklore events, the Christmas tree and nativity scene, sound and light shows, the flower carpet in the summer, etc. - or symbolic events, such as the celebration of sportsmen and women after fine performances.  \r\n \r\nIts story began as a market square in the 12th century. Gradually, the square was filled with houses and halls, then primarily made of wood. The splendid Gothic town hall was built in the 15th century in three phases; the same 15th century saw the installation of trade guilds in the houses that border the Grand-Place. Even more so than at present, the square was the nerve centre of Brussels life: economically, as already mentioned, with intense sales activity (several halls devoted to the sale of bread - the present King's House or Broodhuis in Dutch -, meat, linen, etc.), culturally (theatrical performances), judicially (with executions taking place on the square) and, of course, local politics.  \r\n \r\nIt was bombarded by Louis XIV's troops in 1695 and was subsequently almost entirely rebuilt. It underwent further major renovations and modifications during the following centuries, especially in the 19th century, which gave it its current appearance.  \r\n \r\nThe Grand-Place of Brussels has been a UNESCO World Heritage Site since 1998. \r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Grand-Place","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"Der Grand-Place in Br\u00fcssel z\u00e4hlt zum UNESCO-Weltkulturerbe und gilt als einer der sch\u00f6nsten Pl\u00e4tze der Welt.\r\n\r\nArchitektonische Perlen: Hier l\u00e4sst sich eine \u00e4u\u00dferst gelungene Mischung verschiedener architektonischer Stilrichtungen bewundern, charakteristisch f\u00fcr die Kultur und die Gesellschaft einer wohlhabenden, nordeurop\u00e4ischen Stadt. Eingerahmt wird der Grand-Place von majest\u00e4tischen Zunfth\u00e4usern, die \u00fcberwiegend aus dem 17. Jahrhundert stammen. Das Rathaus von Br\u00fcssel, das Anfang des 15. Jahrhunderts (1402) erbaut wurde, dominiert das architektonische Gesamtbild.\r\n\r\nSpektakul\u00e4re Veranstaltungen auf dem Grand-Place: Der Grand-Place wird regelm\u00e4\u00dfig Schauplatz verschiedener Gro\u00dfereignisse, darunter das mittelalterliche Spektakel Ommegang und der ber\u00fchmte Blumenteppich, bei dem der gesamte Platz mit einem riesigen Blumenmeer ausgelegt wird\r\n\r\nSie befinden sich \u00fcbrigens in bester Gesellschaft, denn schon Schriftsteller wie Baudelaire und Victor Hugo und sogar Karl Marx verfielen dem Charme des Grand-Place. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Grand-Place","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"La costruzione della Grand-Place, sito che rientra nella lista dei Patrimoni Mondiali dell'Unesco, inizia nel Quindicesimo secolo; dapprima qualche mercato coperto, le case delle corporazioni, poi l'H\u00f4tel de Ville per rilanciare l'autorit\u00e0 di questo sito commerciale. Bombardata per 3 giorni dall'esercito francese nel 1695, la piazza fu quasi completamente distrutta, ma, come una fenice, rinascer\u00e0 dalle proprie ceneri in meno di 5 anni. Ecco perch\u00e9 sono quattro gli stili che si affiancano e, a volte, si sovrappongono; notiamo una miscela di gotico, opulento barocco, neoclassico e neogotico. La torre dell'H\u00f4tel de Ville \u00e8 alta circa 96 metri.\r\n\r\nUn luogo storico\r\n\r\nLuogo storico, la Grand-Place \u00e8 stata teatro di molti eventi, sia lieti che tragici:\r\n\r\nNel 1523, i primi martiri protestanti, Henri Voes e Jean Van Eschen, vengono bruciati vivi dall'Inquisizione proprio nella Piazza,\r\n1568, i conti di Egmont e Hornes vengono decapitati.\r\nAgosto 1695, nel corso della Guerra della Grande Alleanza, la maggior parte delle case che si affacciano sulla Grand-Place, delle quali alcune sono ancora in legno, vengono distrutte dal bombardamento della citt\u00e0 ad opera delle truppe francesi guidate dal maresciallo di Villeroy. Solamente la facciata e la torre dell'H\u00f4tel de Ville, che fungeva da bersaglio per l'artiglieria, e qualche muro di pietra resistono alle bombe incendiarie. Le case che davano sulla piazza vengono ricostruite rapidamente dalle varie corporazioni che, a questo punto, scelgono come materiale la pietra. Tra esse, spicca la casa della corporazione dei Birrai che oggi accoglie il Mus\u00e9e des Brasseurs (Museo della Birra).\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Grand-Place","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"Inscrita en la lista del Patrimonio Mundial de la UNESCO, la Grand Place comienza a construirse en el siglo XV. Primeramente, se erigen el mercado y algunas casas gremiales; despu\u00e9s, un Ayuntamiento con el que asentar la autoridad de dicho espacio de comercio. V\u00edctima del bombardeo perpetrado por el Ej\u00e9rcito franc\u00e9s durante 3 d\u00edas en 1695, la plaza queda pr\u00e1cticamente destruida pero, como si de un f\u00e9nix se tratase, resurgir\u00e1 de sus cenizas en menos de 5 a\u00f1os. Esa es la raz\u00f3n subyacente en el eclecticismo de la plaza: en ella, cuatro estilos conviven e incluso se superponen en ocasiones: g\u00f3tico, barroco opulento, neocl\u00e1sico y neog\u00f3tico. La torre del Ayuntamiento tiene una altitud aproximada de 96 metros.\r\n\r\nUn emplazamiento hist\u00f3rico\r\n\r\nLugar hist\u00f3rico, la Grand Place ha asistido a numerosos acontecimientos tanto alegres como tr\u00e1gicos:\r\n\r\nen 1523, los primeros m\u00e1rtires protestantes, Henri Voes y Jean Van Eschen, son quemados a manos de la Inquisici\u00f3n,\r\nen 1568, los condes de Egmont y de Hornes son decapitados.\r\nEn agosto de 1695, durante la Guerra de la Liga de Augsburgo, la mayor\u00eda de casas aleda\u00f1as a la Grand Place, algunas de ellas construidas a\u00fan en madera, son arrasadas durante el bombardeo de la ciudad a manos de las tropas francesas dirigidas por el mariscal de Villeroy. \u00danicamente la fachada y la torre del Ayuntamiento, que serv\u00eda de objetivo a los artilleros, as\u00ed como ciertos muros en piedra, resisten a las bolas incendiarias. Varios gremios se encargan de la r\u00e1pida reconstrucci\u00f3n de las casas que enmarcan la plaza, esta vez, en piedra. Entre ellas, se encuentra la casa gremial de los maestros cerveceros, que alberga hoy el Mus\u00e9e des Brasseurs (Museo de los Maestros Cerveceros).\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Grand-Place","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"Classificada como Patrim\u00f3nio Mundial da Unesco, a Grand-Place come\u00e7a a construir-se no s\u00e9culo XV: de in\u00edcio, os sal\u00f5es de algumas sedes de guildas, e, depois, a C\u00e2mara Municipal como sede da autoridade deste local de com\u00e9rcio. Bombardeada durante 3 dias pelas tropas francesas em 1695, fica quase totalmente destru\u00edda, mas, tal como uma f\u00e9nix, renascer\u00e1 das suas cinzas em menos de 5 anos. Por este motivo, quatro estilos coexistem e, por vezes, at\u00e9 se sobrep\u00f5em; \u00e9 uma esp\u00e9cie de mistura de g\u00f3tico, de barroco opulento, de neocl\u00e1ssico e de neog\u00f3tico. A torre da C\u00e2mara Municipal mede, mais ou menos, 96 metros de altura.\r\n\r\nUm local hist\u00f3rico\r\n\r\nLocal hist\u00f3rico, a Grand-Place assistiu ao desenvolvimento de acontecimentos felizes e tr\u00e1gicos:\r\n\r\nEm 1523, os primeiros m\u00e1rtires protestantes, Henri Voes e Jean Van Eschen, foram a\u00ed queimados pela Inquisi\u00e7\u00e3o.\r\nEm 1568, os condes de Egmont e de Hornes foram a\u00ed decapitados.\r\nEm agosto de 1695, durante a Guerra da Liga de Augsburgo, a maior parte das casas que rodeavam a Grand-Place, algumas das quais ainda conservavam a sua constru\u00e7\u00e3o de madeira, foram destru\u00eddas durante o bombardeamento da cidade pelas tropas francesas dirigidas pelo marechal de Villeroy. Apenas a fachada e a torre da C\u00e2mara Municipal, que servia de alvo para os artilheiros, e algumas paredes de pedra resistiram \u00e0s balas de canh\u00e3o. As casas que rodeavam a pra\u00e7a foram rapidamente reconstru\u00eddas, desta feita, usando pedra, pelas diferentes guildas. De entre elas, a sede da guilda dos Cervejeiros que hoje acolhe o Museu os Cervejeiros.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Grand-Place","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[13],"translations":{"fr":["Centre historique"],"nl":["Historisch centrum"],"en":["Historical Centre"]}},"zones":{"list":[19],"translations":{"fr":["Centre"],"nl":["Centrum"],"en":["Centre"]}},"neca":null,"facebook_id":null,"backoffice_id":266,"location":{"lat":50.84644089,"lon":4.35147641},"region":"brussels","last_updated_at":"2022-08-10T21:36:07+02:00","published_at":"2013-10-19T01:13:24+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":false,"resto_ranking":0},"organizer":{"id":277830,"translations":{"fr":{"name":"Visite Guid\u00e9e Bruxelles","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":"info@visiteguideebruxelles.be","website":"http:\/\/www.visiteguideebruxelles.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Visite Guid\u00e9e Bruxelles","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Visite Guid\u00e9e Bruxelles","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":"info@visiteguideebruxelles.be","website":"http:\/\/www.visiteguideebruxelles.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Visite Guid\u00e9e Bruxelles","address_line2":"1000 Brussel","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Visite Guid\u00e9e Bruxelles","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":"info@visiteguideebruxelles.be","website":"http:\/\/www.visiteguideebruxelles.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Visite Guid\u00e9e Bruxelles","address_line2":"1000 Brussels","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Visite Guid\u00e9e Bruxelles","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":"info@visiteguideebruxelles.be","website":"http:\/\/www.visiteguideebruxelles.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Visite Guid\u00e9e Bruxelles","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Visite Guid\u00e9e Bruxelles","address_street_name":null,"address_street_number":n