opolis.brussels\/","email":"contact@geopolis.brussels","phone_contact":"+32 475 32 85 90","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700001049"},"en":{"name":"Exposition Irak, Bosnie, Rwanda. Re\/construire","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/geopolis.brussels\/","email":"contact@geopolis.brussels","phone_contact":"+32 475 32 85 90","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700001049"},"it":{"name":"Exposition Irak, Bosnie, Rwanda. Re\/construire","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/geopolis.brussels\/","email":"contact@geopolis.brussels","phone_contact":"+32 475 32 85 90","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700001049"},"cn":{"name":"Exposition Irak, Bosnie, Rwanda. Re\/construire","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/geopolis.brussels\/","email":"contact@geopolis.brussels","phone_contact":"+32 475 32 85 90","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700001049"},"fr":{"name":"Exposition Irak, Bosnie, Rwanda. Re\/construire","shortdescr":"Du 19 septembre au 03 novembre, G\u00e9opolis pr\u00e9sente l\u2019exposition Irak, Bosnie, Rwanda. Re\/construire, en collaboration avec la F\u00e9d\u00e9ration Wallonie-Bruxelles.\n\nUne exposition qui met en lumi\u00e8re les tragiques cons\u00e9quences des g\u00e9nocides du Rwanda, de la Bosnie et des Y\u00e9zidis, en Irak.","longdescr":"Du 19 septembre au 03 novembre, G\u00e9opolis pr\u00e9sente l\u2019exposition Irak, Bosnie, Rwanda. Re\/construire, en collaboration avec la F\u00e9d\u00e9ration Wallonie-Bruxelles.\n\nUne exposition qui met en lumi\u00e8re les tragiques cons\u00e9quences des g\u00e9nocides du Rwanda, de la Bosnie et des Y\u00e9zidis, en Irak.\n\nIRAK \u2013 Y\u00e9zidis, Soleil invaincu. Con\u00e7ue par Johanna de Tessi\u00e8res (textes de Christophe Lamfalussy), cette exposition comm\u00e9more les victimes du g\u00e9nocide perp\u00e9tr\u00e9 par Daech entre 2014 et 2017, et la r\u00e9sistance de cette minorit\u00e9. Elle comprend une cinquantaine de photographies comment\u00e9es sur l\u2019histoire, la culture et les cons\u00e9quences du g\u00e9nocide sur les Y\u00e9zidis.\n\nRWANDA. Christophe Calais a consacr\u00e9 la majeure partie de son \u0153uvre photographique \u00e0 couvrir le Rwanda. Il a publi\u00e9 deux livres sur le g\u00e9nocide des Tutsi et ses s\u00e9quelles : Le Cri des morts, le silence des vivants (1998) et Rwanda, le pays hant\u00e9 (2006). Apr\u00e8s 25 ann\u00e9es de reportages, en 2016, il range ses appareils photo pour assurer la r\u00e9daction en chef de l\u2019agence Magnum Photos \u00e0 Paris. Depuis 2021, il est responsable \u00e9ditorial des Projets sp\u00e9ciaux Photo de l\u2019Agence France-Presse.\n\nBOSNIE \u2013 Between fears and hope. Pr\u00e8s de trente ans apr\u00e8s la fin de la guerre en Bosnie-Herz\u00e9govine, Fabrice Dekoninck a explor\u00e9, dans ce qu\u2019elle a de plus intime, la m\u00e9moire de ceux qui ont surv\u00e9cu au si\u00e8ge de Sarajevo, \u00e0 l\u2019\u00e9puration ethnique de la r\u00e9gion de Prijedor et au g\u00e9nocide de Srebrenica.","performers":"L'exposition pr\u00e9sente les travaux des photojournalistes Johanna de Tessi\u00e8res, Christophe Calais et Fabrice Dekoninck","boxoffice_url":null,"website":"https:\/\/geopolis.brussels\/","email":"contact@geopolis.brussels","phone_contact":"+32 475 32 85 90","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700001049"},"sp":{"name":"Exposition Irak, Bosnie, Rwanda. Re\/construire","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/geopolis.brussels\/","email":"contact@geopolis.brusse