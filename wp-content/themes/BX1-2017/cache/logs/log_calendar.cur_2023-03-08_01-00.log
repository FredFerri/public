e":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert","de":"Konzert","it":"Concerti","sp":"Concierto","pt":null,"cn":null}},"others":{"list":[2],"translations":{"fr":["Classique"],"nl":["Klassiek"],"en":["Classical"],"de":["Klassisch"],"it":["Classica"],"sp":["Cl\u00e1sica"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Cycle de respiration musicale","shortdescr":"s\u00e9ance de contemplation m\u00e9ditative accompagn\u00e9e au piano","longdescr":"Rejoignez-nous pour un moment hors du temps ! Ilios Kotsou et les instructeurs d\u2019Emergences, vous proposent \u00e0 cette occasion de vous poser et d\u2019\u00e9couter la musique plus intens\u00e9ment\u2026 Ils vous guideront dans une s\u00e9ance de contemplation afin de vous plonger et de vivre diff\u00e9remment les oeuvres de Bach, Chopin, Ravel, Brahms, Mompou ainsi que les cr\u00e9ations du pianiste Julien Brocal.","performers":"Ilios Kotsou et les instructeurs d'Emergences, Julien Brocal (piano)","boxoffice_url":null,"website":"https:\/\/www.jardinmusical.org\/agenda-billetterie","email":"info@jardinmusical.org","phone_contact":"+32 456 04 35 05","phone_booking":"+32 456 04 35 05","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.548335"},"nl":{"name":"Muzikale ademhalingscyclus","shortdescr":"Meditatieve (FR) contemplatie sessie, begeleid door piano","longdescr":"Vergezel ons voor een moment waar de tijd verdwijnt! Ilios Kotsou en de instructeurs van Emergences stellen u bij deze gelegenheid voor om een pauze te nemen en intenser naar de muziek te luisteren\u2026 Ze zullen je begeleiden in een contemplatieve sessie waarbij je ondergedompeld bent en je volgende muzikalen werken anders mag beleve