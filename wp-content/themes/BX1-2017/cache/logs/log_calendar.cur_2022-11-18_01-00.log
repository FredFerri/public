st_updated_at":"2022-10-10T22:05:59+02:00","published_at":"2021-07-23T14:48:31+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/explore-a4cf67475a0898a2cf80e43989f5bf426f529814.jpg","width":785,"height":350,"ratio":2.24,"translations":{"fr":{"title":"L'h\u00f4tel Solvay et ses innovations techniques","copyright":null},"nl":{"title":"L'h\u00f4tel Solvay et ses innovations techniques","copyright":null},"en":{"title":"L'h\u00f4tel Solvay et ses innovations techniques","copyright":null}}}],"dates":[{"day":"2022-11-18","doors":null,"start":"18:00:00","end":"19:00:00","is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":40}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-10T22:05:59+02:00","published_at":"2022-10-08T03:30:26+02:00","backoffice_id":263702,"import_origin":"explore","sub_type":"other","show_in_agenda":true,"ranking":1.2599210498949},{"id":543781,"date_start":"2022-11-18","date_end":"2022-11-18","date_next":"2022-11-18","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater"}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"],"de":["Theater"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Cerise sur le Ghetto","shortdescr":null,"longdescr":"Le pouvoir de dire NON\r\n\r\nL\u2019histoire d\u2019une vie aux accents de v\u00e9rit\u00e9 grin\u00e7ants racont\u00e9e par Sam Touzani, qui nous invite \u00e0 repenser le r\u00e9el \u00e0 partir de son histoire familiale.\r\n\r\nLe r\u00e9cit traverse trois g\u00e9n\u00e9rations, des montagnes du Rif Marocain, o\u00f9 la mis\u00e8re est si \u00e9crasante que m\u00eame les enfants r\u00eavent de partir, jusqu\u2019au bitume de Molenbeek o\u00f9 le petit Sam verra le jour dans un deux pi\u00e8ces cuisine chauff\u00e9 au charbon.\r\n\r\nPlus tard, afin d\u2019\u00e9chapper au danger du communautarisme, c\u2019est de lui-m\u00eame qu\u2019il s\u2019exile. Le fils d\u2019immigr\u00e9s peut enfin commencer son dialogue int\u00e9rieur, entre sa culture d\u2019origine et sa culture d\u2019adoption, relier les rives souterraines de ses multiples identit\u00e9s sans les r\u00e9duire \u00e0 une seule...\r\n\r\nMais tout cela suffira-t-il \u00e0 le sortir du cercle infernal de la culpabilit\u00e9 ? Celle qui, dans le silence du d\u00e9ni, ronge tous ceux qui quittent leurs terres, leurs parents, leur langue pour partir loin, tr\u00e8s loin, l\u00e0 o\u00f9 il n\u2019y a plus de soleil.\r\n\r\nSam Touzani est de retour avec l\u2019humour, la tendresse et l\u2019irr\u00e9v\u00e9rence qu\u2019on lui conna\u00eet\u2026\r\n\r\nTexte et jeu : Sam Touzani\r\n\r\nMusicien : Mathieu Gabriel\r\n\r\nMise en sc\u00e8ne & dramaturgie : Gennaro Pitisci assist\u00e9 de Ma\u00eft\u00e9 Renson\r\n\r\nR\u00e9gie : Josse Derbaix, David Vernaillen\r\n\r\nVid\u00e9os : Guillaume Nolevaux\r\n\r\nPhotos et communication : Ma\u00eft\u00e9 Renson\r\n\r\nHoraires\r\n\r\nVendredi 18 novembre - 19h\r\n\r\nInformations\r\n\r\nDur\u00e9e : 60 minutes\r\n\r\nA partir de 14 ans\r\n\r\nTarifs\r\n\r\nGratuit\r\n\r\nR\u00e9servation obligatoire\r\n\r\nPartenaires\r\n\r\nProduction : Brocoli Th\u00e9\u00e2tre, Les Temps d'Art. Espace Magh, Central et l'Atelier th\u00e9\u00e2tre Jean Vilar.\r\n\r\nLe Brocoli th\u00e9\u00e2tre est soutenu par la F\u00e9d\u00e9ration Wallonie-Bruxelles, direction des arts de la sc\u00e8ne - service du th\u00e9\u00e2tre et par la COCOF.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.lejacquesfranck.be","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.543781"},"nl":{"name":"Cerise sur le Ghetto","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.543781"},"en":{"name":"Cerise sur le Ghetto","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.543781"},"de":{"name":"Cerise sur le Ghetto","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.543781"},"it":{"name":"Cerise sur le Ghetto","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.543781"},"sp":{"name":"Cerise sur le Ghetto","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.543781"},"pt":{"name":"Cerise sur le Ghetto","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.543781"},"cn":{"name":"Cerise sur le Ghetto","shortdescr":null,"longdescr":null,"performers":nu