bed_thumbnail_height":360,"oEmbed_thumbnail_width":480,"oEmbed_thumbnail_url":"https:\/\/i.ytimg.com\/vi\/kiq0IeSUZT8\/hqdefault.jpg","oEmbed_html":"<iframe width=\"356\" height=\"200\" src=\"https:\/\/www.youtube.com\/embed\/kiq0IeSUZT8?feature=oembed\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" allowfullscreen title=\"Delwood - 'At large'\"><\/iframe>","translations":{"fr":{"title":"Delwood - 'At large'"},"nl":{"title":"Delwood - 'At large'"},"en":{"title":"Delwood - 'At large'"}}}],"dates":[{"day":"2022-10-30","doors":"19:30:00","start":"20:00:00","end":null,"is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":20.5},{"translations":{"fr":{"name":"Pr\u00e9vente"},"nl":{"name":"Voorverkoop"},"en":{"name":"Presale"}},"value":17.5}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":{"list":[252,255,256,259,263,265],"translations":{"fr":["Accessible aux personnes ayant des difficult\u00e9s de compr\u00e9hension","Accessible","Am\u00e9nagements pour les personnes aveugles et malvoyantes","Chien d'assistance","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9"],"nl":["Toegankelijk voor mensen met een verstandelijke beperking","Toegankelijk","Voorzieningen voor blinde en slechtziende personen","Assistentiehonden","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet"],"en":["Accessible to people with intellectual disabilities","Accessible","Facilities for blind and partially-sighted persons","Assistance dogs","Accessible to pedestrians with mobility aids","Adapted toilet"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-11T02:05:18+02:00","published_at":"2021-02-11T15:18:23+01:00","backoffice_id":228844,"import_origin":null,"sub_type":"concert","show_in_agenda":true,"ranking":2},{"id":542980,"date_start":"2022-10-30","date_end":"2022-10-30","date_next":"2022-10-30","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater"}},"others":{"list":[53],"translations":{"fr":["Contes"],"nl":["Verteltheater"],"en":["Tales"],"de":["M\u00e4rchen"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Vent d\u2019Est","shortdescr":"Conte merveilleux, cithare hongroise et fl\u00fbte de pan\r\nA partir de 10 ans \u2013 70 min","longdescr":"Les provinces de l\u2019Est : Lorraine, Vosges, Alsace sont les pays qui m\u2019ont nourri.\r\nApr\u00e8s avoir abord\u00e9 les contes du monde, les \u00e9pop\u00e9es, les mythes, j\u2019ai pens\u00e9 qu\u2019il \u00e9tait temps de me consacrer aux contes de mon enfance. J\u2019ai \u00e9t\u00e9 bien \u00e9tonn\u00e9 de trouver l\u00e0 un r\u00e9pertoire que j\u2019avais d\u00e9j\u00e0 rencontr\u00e9 \u00e0 d\u2019autres sources. Un corpus d\u2019histoires que je pr\u00e9f\u00e9rais d\u00e9j\u00e0 dans les versions d\u2019autres pays.\r\n\r\nLes fables, randonn\u00e9es, fac\u00e9ties, contes merveilleux, l\u00e9gendes qui ont s\u00e9journ\u00e9 dans cette r\u00e9gion, se sont si bien acclimat\u00e9s qu\u2019ils se sont fondus avec le paysage. Comme ils l\u2019ont fait partout ailleurs, d\u2019ailleurs. Mais je dois avouer que pour moi, ce sont les sapins qui font les plus belles for\u00eats.\r\nLes soirs Vosgiens sont les plus myst\u00e9rieux. Les vergers de Lorraine ont cette bonhommie qui ne se retrouve nulle part. Les villages d\u2019Alsace sont les plus beaux du monde.\r\n\r\nChauvin ? Et apr\u00e8s tout, pourquoi pas ? Lorsque je voyage dans d\u2019autres paysages, ce sont eux que je porte avec moi. Ils ont fait mes go\u00fbts, mes chim\u00e8res, mes plaisirs.\r\n\r\nAlors, il est temps de vous les faire go\u00fbter \u00e0 mon tour. Car sans perdre mon temps \u00e0 dire que les gens de l\u2019Est sont les meilleurs, ce que je ne crois pas, j\u2019aimerais vous faire go\u00fbter cette terre qui a port\u00e9 mes premiers r\u00e8ves d\u2019enfant, avant que le cheval blanc du voyage ne m\u2019ait apprivois\u00e9..\r\n\r\nLe spectacle sera suivi d'une Causerie avec Michel Hindenoch :\r\n19h : Qui a peur de la tradition ?\r\n\r\nMichel Hindenoch est n\u00e9 en For\u00eat-Noire. Conteur, chanteur et plasticien, amoureux des traditions orales, du feu, des chemins, de la nuit et des songes, il raconte les contes et les mythes qui le nourrissent, d\u2019o\u00f9 qu\u2019ils viennent, pour lesquels il compose des versions singuli\u00e8res : \u00ab Renardises \u00bb, \u00ab Asterios \u00bb, \u00ab Ribamballes \u00bb, \u00ab Fruits-Rouges \u00bb\u2026 Sa d\u00e9marche est po\u00e9tique, philosophique et politique : il est l\u2019un des inspirateurs de la Charte des Conteurs d\u2019en France et a publi\u00e9 Conter, un art ?, recueil de r\u00e9flexion sur l\u2019art du conteur.\r\n\r\nA la diff\u00e9rence d\u2019une conf\u00e9rence, plut\u00f4t frontale et unidirectionnelle, les causeries sont des moments de transmission et d\u2019\u00e9change o\u00f9 la parole circule dans un cadre accueillant et chaleureux. Les conteuses et les conteurs invit\u00e9.e.s rencontreront le public apr\u00e8s le spectacle. Chacun.e selon sa propre d\u00e9marche artistique, sa sensibilit\u00e9 et ses recherches, pourra explorer une th\u00e9matique choisie et partager son exp\u00e9rience singuli\u00e8re de l\u2019art du conte.","performers":"Michel Hindenoch","boxoffice_url":null,"website":"http:\/\/www.dimanchesduconte.be","email":"reservation@dimanchesduconte.be","phone_contact":"+32 488 51 28 60","phone_booking":"+32 488 51 28 60","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.542980"},"nl":{"name":"Vent d\u2019Est","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.542980"},"en":{"name":"Vent d\u2019Est","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.542980"},"de":{"name":"Vent d\u2019Est","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.542980"},"it":{"name":"Vent d\u2019Est","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.542980"},"sp":{"name":"Vent d\u2019Est","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.542980"},"pt":{"name":"Vent d\u2019Est","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.542980"},"cn":{"name":"Vent d\u2019Est","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.542980"}},"place":{"id":204305,"translations":{"fr":{"name":"Centre Culturel Bruegel","address_street_name":"Rue des Renards","address_street_number":"1 F","add