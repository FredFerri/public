n_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[13],"translations":{"de":["Historisches Stadtzentrum"],"pt":[null],"en":["Historical Centre"],"it":["Centro storico"],"cn":[null],"fr":["Centre historique"],"sp":["Centro hist\u00f3rico"],"nl":["Historisch centrum"]}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":null,"facebook_id":null,"backoffice_id":39609,"location":{"lat":50.84830562,"lon":4.35263376},"region":"brussels","last_updated_at":"2022-11-09T04:20:03+01:00","published_at":"2022-11-08T16:47:51+01:00","import_origin":null,"external_id":null,"is_in_address_book":false,"is_in_vb_export":false,"resto_ranking":0},"organizer":{"id":275636,"translations":{"de":{"name":"OK Coffee Tips","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":"thomas@okcoffee.tips","website":"http:\/\/www.okcoffee.tips","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"OK Coffee Tips","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"OK Coffee Tips","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":"thomas@okcoffee.tips","website":"http:\/\/www.okcoffee.tips","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"OK Coffee Tips","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"OK Coffee Tips","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":"thomas@okcoffee.tips","website":"http:\/\/www.okcoffee.tips","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"OK Coffee Tips","address_line2":"1000 Brussels","description_web":"OK Coffee: a contemporary vision of coffee\n\nOK Coffee is an independent platform dedicated to speciality coffee through public courses and barista training, HoReCa consultancy, Coffee Tours and other Teambuildings. Its mission is to inform, educate and connect you with key players who share values and a contemporary vision of the coffee industry. They focus on quality, transparency, proximity to producers and taste. \n\nThe combination of fun, walking and discovery is an integral part of Coffee Tours in Brussels. As you stroll through the neighbourhoods of the Belgian capital, you'll have the chance to visit iconic caf\u00e9s, unique tasting spaces and catering establishments that stand out for their commitment to speciality coffee. You'll be able to sample different preparations, from strong to filtered coffees, milky drinks to cold coffees, fanciful creations to traditional methods, and even some daring experiments. This fun and informative walk will allow you to discover the richness and diversity of speciality coffee, while exploring the unusual corners of Brussels. The best caf\u00e9s in Brussels. Coffee enthusiasts will be able to broaden their horizons by discovering new places and talking to experts. In addition, hospitality professionals (baristas, caf\u00e9 owners and restaurateurs) will be able to take advantage of the Coffee Tours to improve their knowledge of speciality coffee and offer an even more exceptional customer experience in their establishment. Whether you're a coffee novice or an expert, Coffee Tours in Brussels are designed to give you a unique and rewarding experience.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"OK Coffee Tips","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":"thomas@okcoffee.tips","website":"http:\/\/www.okcoffee.tips","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"OK Coffee Tips","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"OK Coffee Tips","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":"thomas@okcoffee.tips","website":"http:\/\/www.okcoffee.tips","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"OK Coffee Tips","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"OK Coffee Tips","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":"thomas@okcoffee.tips","website":"http:\/\/www.okcoffee.tips","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"OK Coffee Tips","address_line2":"1000 Bruxelles","description_web":"OK Coffee : une vision contemporaine du caf\u00e9\n\nOK Coffee est une plateforme autonome d\u00e9di\u00e9e au caf\u00e9 de sp\u00e9cialit\u00e9 \u00e0 travers les cours publics et formations barista, le conseil en HoReCa, les Coffee Tours et autres Teambuildings. Sa mission est d'informer, d'\u00e9duquer et de vous connecter avec des acteur.ices cl\u00e9s partageant des valeurs et une vision contemporaine de l'industrie du caf\u00e9. Ici on se concentre sur la qualit\u00e9, la transparence, la proximit\u00e9 avec les producteur.ices et le go\u00fbt.\n\nLa combinaison du plaisir, de la marche et des d\u00e9couvertes fait partie int\u00e9grante des Coffee Tours \u00e0 Bruxelles. En vous promenant \u00e0 travers les quartiers de la capitale belge, vous aurez l'occasion de visiter des caf\u00e9s embl\u00e9matiques, des espaces de d\u00e9gustation uniques et des \u00e9tablissements horeca qui se distinguent par leur engagement envers le caf\u00e9 de sp\u00e9cialit\u00e9. Vous pourrez d\u00e9guster diff\u00e9rentes pr\u00e9parations, des caf\u00e9s serr\u00e9s aux caf\u00e9s filtr\u00e9s, des boissons lact\u00e9es aux caf\u00e9s froids, des cr\u00e9ations fantaisistes aux m\u00e9thodes traditionnelles, voire m\u00eame des exp\u00e9rimentations audacieuses. Cette promenade \u00e0 la fois plaisante et instructive vous permettra de d\u00e9couvrir la richesse et la diversit\u00e9 du caf\u00e9 de sp\u00e9cialit\u00e9, tout en explorant les coins insolites de Bruxelles. Les meilleurs caf\u00e9s bruxellois. Les passionn\u00e9.e.s du caf\u00e9 pourront \u00e9largir leur horizon en d\u00e9couvrant de nouveaux lieux et en \u00e9changeant avec des experts. De plus, les professionnel.les de l'Horeca, (baristas, propri\u00e9taires de caf\u00e9s et restaurateurs), pourront b\u00e9n\u00e9ficier des Coffee Tours pour am\u00e9liorer leurs connaissances sur le caf\u00e9 de sp\u00e9cialit\u00e9 et ainsi offrir une exp\u00e9rience client encore plus exceptionnelles dans leur \u00e9tablissement. Que vous soyez novice ou expert.e en caf\u00e9, les Coffee Tours \u00e0 Bruxelles sont con\u00e7us pour vous permettre de vivre une exp\u00e9rience unique et enrichissante.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"OK Coffee Tips","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":"thomas@okcoffee.tips","website":"http:\/\/www.okcoffee.tips","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"OK Coffee Tips","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"OK Coffee Tips","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":"thomas@okcoffee.tips","website":"http:\/\/www.okcoffee.tips","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"OK Coffee Tips","address_line2":"1000 Brussel","description_web":"OK Coffee: een eigentijdse visie op koffie\n\nOK Coffee is een onafhankelijk platform gewijd aan koffiespecialiteiten door middel van publieke cursussen en barista trainingen, HoReCa consultancy, Coffee Tours en andere Teambuildings. De missie is om te informeren, te onderwijzen en je in contact te brengen met belangrijke spelers die waarden en een eigentijdse visie op de koffie-industrie delen. Ze richten zich op kwaliteit, transparantie, nabijheid van producenten en smaak.\n\nDe combinatie van plezier, wandelen en ontdekken is een integraal onderdeel van Koffietours in Brussel. Terwijl je door de wijken van de Belgische hoofdstad wandelt, krijg je de kans om iconische caf\u00e9s, unieke proefruimtes en horecazaken te bezoeken die zich onderscheiden door hun inzet voor koffiespecialiteiten. Je kunt er verschillende bereidingen proeven, van sterke tot gefilterde koffie, van melkdranken tot koude koffie, van fantasierijke creaties tot traditionele methodes, en zelfs enkele gewaagde experimenten. Tijdens deze leuke en leerrijke wandeling ontdek je de rijkdom en diversiteit van koffiespecialiteiten en ontdek je de ongewone hoekjes van Brussel. De beste caf\u00e9s van Brussel. Koffieliefhebbers kunnen hun horizon verbreden door nieuwe plaatsen te ontdekken en te praten met experts. Bovendien kunnen horecaprofessionals (barista's, caf\u00e9-eigenaars en restauranthouders) profiteren van de Koffietours om hun kennis over koffiespecialiteiten te verbeteren en hun zaak een nog uitzonderlijke klantenervaring te bieden. Of je nu een beginner bent of een expert, de Koffietours in Brussel zijn bedoeld om je een unieke en lonende ervaring te bezorgen.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":35636,"location":{"lat":50.8427501,"lon":4.3515499},"last_updated_at":"2025-01-27T11:15:10+01:00","published_at":"2020-07-09T09:56:01+02:00","is_in_address_book":false,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"video","link":"https:\/\/youtu.be\/hUnxpaWd0tI","width":356,"height":200,"ratio":null,"translations":{"de":{"title":"Brussels Coffee Tours","copyright":null},"pt":{"title":"Brussels Coffee Tours","copyright":null},"en":{"title":"Brussels Coffee Tours","copyright":null},"it":{"title":"Brussels Coffee Tours","copyright":null},"cn":{"title":"Brussels Coffee Tours","copyright":null},"fr":{"title":"Brussels Coffee Tours","copyright":null},"sp":{"title":"Brussels Coffee Tours","copyright":null},"nl":{"title":"Brussels Coffee Tours","copyright":null}}},{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/c1f118b54c4efeaf0856e91ebd1300ccc38e209b.jpg","width":720,"height":960,"ratio":0.75,"oEmbed_height":960,"oEmbed_width":720,"translations":{"de":{"title":"Brussels Coffee Tours","copyright":null},"pt":{"title":"Brussels Coffee Tours","copyright":null},"en":{"title":"Brussels Coffee Tours","copyright":null},"it":{"title":"Brussels Coffee Tours","copyright":null},"cn":{"title":"Brussels Coffee Tours","copyright":null},"fr":{"title":"Brussels Coffee Tours","copyright":null},"sp":{"title":"Brussels Coffee Tours","copyright":null},"nl":{"title":"Brussels Coffee Tours","copyright":null}}},{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/7a1ab266ef69cba407a10273cd282963c73757e6.jpg","width":1280,"height":1513,"ratio":0.85,"oEmbed_height":1513,"oEmbed_width":1280,"translations":{"de":{"title":"Brussels Coffee Tours","copyright":"okcoffee"},"pt":{"title":"Brussels Coffee Tours","copyright":"okcoffee"},"en":{"title":"Brussels Coffee Tours","copyright":"okcoffee"},"it":{"title":"Brussels Coffee Tours","copyright":"okcoffee"},"cn":{"t