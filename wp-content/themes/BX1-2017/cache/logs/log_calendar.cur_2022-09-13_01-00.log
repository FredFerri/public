out":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":20},{"translations":{"fr":{"name":"Pr\u00e9vente"},"nl":{"name":"Voorverkoop"},"en":{"name":"Presale"}},"value":16}],"child_events":[],"parent_events":[537708],"targets":{"list":[12],"translations":{"fr":["LGTBQIA"],"nl":["LGTBQIA"],"en":["LGTBQIA"]}},"visit_profile":{"list":[332],"translations":{"fr":["LGBTQIA+"],"nl":["LGBTQIA+"],"en":["LGBTQIA+"]}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-08-30T11:17:57+02:00","published_at":"2022-08-30T10:55:41+02:00","backoffice_id":260655,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":1},{"id":539992,"date_start":"2022-09-24","date_end":"2022-09-25","date_next":"2022-09-24","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":70,"translations":{"fr":"Foire & salon","nl":"Beurzen & salons","en":"Fairs and shows"}},"others":{}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Contemporary Design Market","shortdescr":"Le Contemporary Design Market est un \u00e9v\u00e8nement de pr\u00e9sentation et de vente pour les designers contemporains belges de tout horizon.","longdescr":"Les 24 et 25 septembre 2022, la Gare Maritime -Tour & Taxis sera \u00e0 nouveau enti\u00e8rement d\u00e9di\u00e9e au design. Le Contemporary Design Market (CDM) pr\u00e9sentera une cinquantaine de designers bas\u00e9s en Belgique, un m\u00e9lange de noms \u00e9tablis, de talents en devenir et un concept innovant, BIN\u00d4ME, qui r\u00e9unit un duo de cultures diff\u00e9rentes. L'invit\u00e9 d'honneur cette ann\u00e9e est Studio Khachatryan de l'arm\u00e9nien Noro Khachatryan.\r\n\r\n\r\n\u200bLe dernier week-end de septembre, la gare maritime \u00e0 Tour & Taxis sera le lieu de d\u00e9couverte et d'achat du design belge en direct aupr\u00e8s des cr\u00e9ateurs, avec le Contemporary Design Market. Le CDM veut briser nos cadres de r\u00e9f\u00e9rence avec lesquels nous avons grandi et explorer ce qui se passe lorsque nous sortons de nos sentiers battus.\r\n\r\nPour la quatri\u00e8me fois, l'evenement a lieu \u00e0 Bruxelles, invitant tout amateur de design, professionnel ou particulier, \u00e0 d\u00e9couvrir les cr\u00e9ations les plus diverses de la sc\u00e8ne contemporaine. Les 50 designers participants ont \u00e9t\u00e9 s\u00e9lectionn\u00e9s par un comit\u00e9 d'experts parmi plus de 130 candidatures.","performers":"Amber Dewaele -Bram Kerkhofs Design Studio - Duplex Studio - Elias Van Orshaegen - Emma Cogn\u00e9 - Gilles Mayk Navangi & Pieter Bostoen -  Lou van 't Riet - S\u00e9bastien Caporusso - Studio Nicolas Erauw - studiokhachatryan - Thibeau Scarc\u00e9riaux - ZaventemAteliers","boxoffice_url":null,"website":"https:\/\/shop.utick.be\/?module=ACTIVITYSERIEDETAILS&pos=CONTEMPORARYDESIGN&s=9E5C39B2-A46C-3497-36FC-D5CD6A719582","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.539992"},"nl":{"name":"Contemporary Design Market","shortdescr":"Contemporary Design Market is een uniek presentatie- en verkoopmoment voor zowel gevestigde als opkomende Belgische hedendaagse designers.","longdescr":"Op 24 en 25 september 2022 staat de Gare Maritime -Tour & Taxis weer volledig in het teken van design. De Contemporary Design Market (CDM) presenteert er een 50-tal ontwerpers die gevestigd zijn in Belgi\u00eb, een mix van gevestigde namen, opkomend talent en een vernieuwd concept BIN\u00d4ME waarbij een duo uit verschillende culturen samengebracht wordt. Guest of Honour is dit jaar Studio Khachatryan van de Armeense Noro Khachatryan.\r\n\r\n\r\n\u200bTijdens het laatste weekend van september wordt de vernieuwde Gare Maritime in Tour & Taxis met de Contemporary Design Market h\u00e9t evenement waar je Belgisch design rechtstreeks bij de ontwerpers kan ontdekken en kopen. CDM wil de referentiekaders waarmee ieder van ons opgroeide openbreken en onderzoeken wat er gebeurt als we onze vastgeroeste paden verlaten.\r\n\r\nVoor de vierde keer op een rij strijkt de markt neer in Brussel, een uitnodiging naar zowel professionele als particuliere designliefhebbers om er het meest uiteenlopende van de hedendaagse designsc\u00e8ne te ontdekken. De 50 deelnemende ontwerpers werden uit meer dan 130 inzendingen geselecteerd door een comit\u00e9 van experts.","performers":"Amber Dewaele -Bram Kerkhofs Design Studio - Duplex Studio - Elias Van Orshaegen - Emma Cogn\u00e9 - Gilles Mayk Navangi & Pieter Bostoen -  Lou van 't Riet - S\u00e9bastien Caporusso - Studio Nicolas Erauw - studiokhachatryan - Thibeau Scarc\u00e9riaux - ZaventemAteliers","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.539992"},"en":{"name":"Contemporary Design Market","shortdescr":"Contemporary Design Market is a unique platform, presentation and sales opportunity for both established and emerging Belgian based contemporary designers.","longdescr":"On 24 and 25 September 2022, the Gare Maritime -Tour & Taxis will once again be entirely dedicated to design. The Contemporary Design Market (CDM) will present some 50 designers based in Belgium, a mix of established names, up-and-coming talent and an innovative concept, BIN\u00d4ME, which brings together a duo from different cultures. Guest of Honour this year is Studio Khachatryan of Armenian designer Noro Khachatryan.\r\n\r\n\r\n\u200bDuring the last weekend of September, the revamped Gare Maritime at Tour & Taxis will be the place to host the Contemporary Design Market, where visitors will be able to discover and buy Belgian design directly from the designers. CDM wants to step away from the traditional design contexts and explore new design idioms.\r\n\r\nFor the fourth time, the event is coming to Brussels, inviting both professional and private design enthusiasts to discover the most diverse of the contemporary design scene. The 50 participating designers were selected by a committee of experts from more than 130 entries.","performers":"Amber Dewaele -Bram Kerkhofs Design Studio - Duplex Studio - Elias Van Orshaegen - Emma Cogn\u00e9 - Gilles Mayk Navangi & Pieter Bostoen -  Lou van 't Riet - S\u00e9bastien Caporusso - Studio Nicolas Erauw - studiokhachatryan - Thibeau Scarc\u00e9riaux - ZaventemAteliers","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.539992"},"de":{"name":"Contemporary Design Market","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.539992"},"it":{"name":"Contemporary Design Market","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.539992"},"sp":{"name":"Contemporary Design Market","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.539992"},"pt":{"name":"Contemporary Design Market","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.539992"},"cn":{"name":"Contemporary Design Market","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.539992"}},"place":{"id":258279,"translations":{"fr":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Rue Picard","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard","address_line2":"1000 Bruxelles","description_web":"La Gare Maritime : l'ancienne gare de fret devenue jungle urbaine, neutre en \u00e9nergie !\r\n\r\nElle offre le cadre id\u00e9al pour les \u00e9v\u00e9nements culturels innovants, les tournages de films ou s\u00e9ances photo, les march\u00e9s et foires, les lancements et promotions de produits. Les halles de la Gare Maritime ont \u00e9t\u00e9 transform\u00e9es en ville int\u00e9rieure. Elle comportera son propre food hall (\u00e0 partir de septembre 2021), des magasins exclusifs et des bureaux. Dans ce complexe, des espaces uniques et inspirants sont entrecoup\u00e9s de structures en bois chaleureuses. Le b\u00e2timent se pr\u00eate \u00e0 l'organisation de rencontres en petit comit\u00e9 ou de grands happenings. La nef monumentale, attrait architectural, est baign\u00e9e de lumi\u00e8re naturelle indirecte et offre suffisamment d'espace pour les activit\u00e9s int\u00e9rieures bien fr\u00e9quent\u00e9es.\r\nTout \u00e9v\u00e8nement dans la Gare Maritime sera un \u00e9v\u00e8nement \u00e9co-responsable. La durabilit\u00e9 \u00e9tait \u00e0 l'avant-plan pendant les r\u00e9novations du b\u00e2timent. L'\u00e9nergie renouvelable est produite sur place, utilisant la g\u00e9othermie et des panneaux photovolta\u00efques. Sur les promenades vertes bordant la nef centrale, des jardins \u00e0 th\u00e8me et des arbres \u00e0 haut tronc ont \u00e9t\u00e9 amen\u00e9s - comme si le parc voisin se faufile dans le b\u00e2timent. \r\nLa Gare Maritime, un lieu unique : attractif, novateur, ambitieux.\r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Picardstraat","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Picardstraat","address_line2":"1000 Brussel","description_web":"Gare Maritime: van industrieel goederenstation tot energieneutrale urban jungle!\r\n\r\nDe Gare Maritime is de perfecte setting voor innovatieve, culturele evenementen, film- en fotoshoots, markten, beurzen, lanceringen en promoties. De historische stationshallen van de Gare Maritime zijn omgevormd tot overdekte stad, met foodhall (vanaf september 2021), exclusieve winkels en kantoren. Het gebouwencomplex biedt een waaier aan unieke, inspirerende ruimtes afgewisseld met warme houten volumes: perfect voor de organisatie van kleine en grootschalige happenings. D\u00e9 architecturale eyecatcher is de monumentale middenbeuk die baadt in indirect daglicht en over meer dan voldoende ruimte beschikt voor overdekte activiteiten met veel bezoekers.\r\nEen event in de Gare Maritime is een groen event. Tijdens de renovatie van het gebouw was duurzaamheid een speerpunt. Energie wordt ter plaatse hernieuwbaar opgewekt met geothermie en zonnepanelen. De groene wandelboulevards aan weerszijden van de middenbeuk zijn voorzien van thematuinen en hoogstammige bomen, alsof het aangrenzende park het gebouw binnenstroomt. Gare Maritime is een unieke plek: aantrekkelijk, vernieuwend en ambitieus.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Rue Picard","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue Picard","address_line2":"1000 Brussels","description_web":"The Gare Maritime - From industrial freight station to energy neutral urban jungle!\r\n\r\nIt is the perfect setting for innovative cultural events, film or photo shoots, trade shows, fairs, product launches or promotions. \r\nThe historic station concourse that was part of the Gare Maritime has been transformed into an indoor city with its own food hall (coming September 2021), exclusive shops and offices. Countless unique and inspiring areas and warm, wooden structures alternate in this building complex. It is perfectly suited to accommodate both small and major events. The monumental nave is a true architectural eye-catcher, bathed in indirect sunlight and providing ample space for well-attended indoor activities.\r\nAny event in the Gare Maritime is a green event. Sustainability has been key during the renovation works. The building generates its own energy from renewable sources, using geothermics and solar panels. The green boulevards on either side of the nave are lined with themed gardens and tall trees, as if the adjacent park found its way inside. \r\nThe Gare Maritime is a unique place - attractive, innovative and ambitious.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Rue Picard","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Rue Picard","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Rue Picard","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Rue Picard","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Rue Picard","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[8],"translations":{"fr":["Canal"],"nl":["Kanaalwijk"],"en":["Canal"]}},"zones":{"list":[20],"translations":{"fr":["Nord"],"nl":["Noord"],"en":["North"]}},"neca":null,"facebook_id":null,"backoffice_id":18279,"location":{"lat":50.86410665,"lon":4.34464417},"region":"brussels","last_updated_at":"2022-09-09T16:05:10+02:00","published_at":"2014-05-14T12:03:05+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0}