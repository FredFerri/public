:"2022-06-21","doors":"18:30:00","start":"19:30:00","end":null,"is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Jeunes"},"nl":{"name":"Jongeren"},"en":{"name":"Young"}},"value":25},{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":40}],"child_events":[],"parent_events":[],"targets":{"list":[11,8,10,12],"translations":{"fr":["Famille","Jeunes 15-18 ans","Seniors","LGTBQIA"],"nl":["Familie","Jongeren 15-18 j.","Senioren","LGTBQIA"],"en":["Family","Youth 15-18  yr.","Seniors","LGTBQIA"]}},"tags":["kids"],"accessibilities":{"list":[252,255,261,263,265],"translations":{"fr":["Accessible aux personnes ayant des difficult\u00e9s de compr\u00e9hension","Accessible","Parking accessible","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9"],"nl":["Toegankelijk voor mensen met een verstandelijke beperking","Toegankelijk","Toegankelijke parking","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet"],"en":["Accessible to people with intellectual disabilities","Accessible","Accessible parking","Accessible to pedestrians with mobility aids","Adapted toilet"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-05-19T14:35:03+02:00","published_at":"2022-05-19T14:14:45+02:00","backoffice_id":254066,"import_origin":null,"sub_type":"concert","show_in_agenda":true,"ranking":1.2599210498949},{"id":533014,"date_start":"2022-06-21","date_end":"2022-06-21","date_next":"2022-06-21","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":84,"translations":{"fr":"Divers","nl":"Varia","en":"Various"}},"others":{}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"City Game : La qu\u00eate de la cl\u00e9 d'or","shortdescr":null,"longdescr":"Ann\u00e9e 1615. Alors que Bruxelles pr\u00e9pare les c\u00e9l\u00e9brations du cort\u00e8ge de l\u2019Ommegang, un jeune architecte nomm\u00e9 Joris se pr\u00e9sente \u00e0 la cour pour se mettre au service des archiducs Albert et Isabelle. Mais entrer au service de la cour est loin d\u2019\u00eatre une t\u00e2che simple : Joris va devoir prouver sa comp\u00e9tence ! Munissez-vous de votre smartphone et partez \u00e0 la d\u00e9couverte du Quartier royal en compagnie de notre h\u00e9ros, \u00e0 la rencontre de notables haut en couleurs qui vous mettront \u00e0 l\u2019\u00e9preuve : observation, r\u00e9flexion, logique\u2026 Triomphez et vous obtiendrez la pr\u00e9cieuse Cl\u00e9 d\u2019or qui vous ouvrira les portes du Palais du Coudenberg !  Une aventure \u00e0 vivre, un city game passionnant qui vous plongera en plein 17e si\u00e8cle, \u00e0 la cour des Archiducs.\r\n\r\nComment \u00e7a se passe ? Pr\u00e9sentez-vous \u00e0 l\u2019accueil pour recevoir les donn\u00e9es de t\u00e9l\u00e9chargement du jeu.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.coudenberg.brussels","email":null,"phone_contact":null,"phone_booking":"+32 2 500 45 54","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/533014.html"},"nl":{"name":"Stadsspel : de zoektocht naar de gouden sleutel","shortdescr":null,"longdescr":"In 1615, terwijl Brussel de viering van de Ommegang voorbereidt, presenteert een jonge architect, Joris, zich aan het hof om bij de aartshertogen Albrecht en Isabella in dienst te komen. In dienst treden aan het hof is verre van eenvoudig. Joris zal zijn capaciteiten moeten bewijzen! Pak je smartphone en ga op verkenning in de Koninklijke Wijk in het gezelschap van onze held. Je ontmoet kleurrijke notabelen die je op de proef zullen stellen.  Test je observatie-, reflectie-, logicavaardigheden. Wie slaagt in de opdracht, bemachtigt de kostbare gouden sleutel die de deuren van het Coudenbergpaleis opent! Een spannend stadsspel dat je onderdompelt in het midden van de 17de eeuw aan het hof van de aartshertogen. \r\n\r\nHoe werkt het? Ga naar het onthaal om het spel te kunnen downloaden.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/533014.html"},"en":{"name":"City Game : Quest of the golden key","shortdescr":null,"longdescr":"It\u2019s 1615. As Brussels prepares for the celebrations of the Ommegang procession, a young architect named Joris presents himself to the Court to enter the service of the Archdukes Albert and Isabella. But entering the service of the Court is far from being a simple task: Joris will have to prove his ability! Grab your smartphone and set off to discover the Royal Quarter in the company of our hero, meeting colourful characters who will put you to the test: observation, reflection, logic\u2026 Triumph and you\u2019ll obtain the precious Golden Key that opens the doors of the Coudenberg Palace! An adventure to be experienced, an exciting city game that will plunge you into the Court of the Archdukes in the 17th century. \r\n\r\nHow does it work? Go to the reception desk to receive the game's download data.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/533014.html"},"de":{"name":"City Game : La qu\u00eate de la cl\u00e9 d'or","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/533014.html"},"it":{"name":"City Game : La qu\u00eate de la cl\u00e9 d'or","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/533014.html"},"sp":{"name":"City Game: la b\u00fasqueda de la llave de oro","shortdescr":null,"longdescr":"A\u00f1o 1615. Mientras Bruselas se prepara para las celebraciones de la procesi\u00f3n de Ommegang, un joven arquitecto llamado Joris llega a la corte para trabajar para los archiduques Alberto e Isabel. Pero entrar al servicio de la corte no es ni mucho menos una tarea sencilla: \u00a1Joris tendr\u00e1 que demostrar su capacidad! Usa tu smartphone y atr\u00e9vete a descubrir el Barrio Real en compa\u00f1\u00eda de nuestro h\u00e9roe, conociendo a los singulares personajes que te pondr\u00e1n a prueba: observaci\u00f3n, reflexi\u00f3n, l\u00f3gica... Triunfa y obtendr\u00e1s la preciada Llave de Oro que te abrir\u00e1 las puertas del Palacio de Coudenberg. \u202fUna aventura que hay que vivir, un emocionante juego de ciudad que te sumergir\u00e1 en el coraz\u00f3n del siglo XVII, en la corte de los archiduques. \r\n\r\n\u00bfC\u00f3mo funciona? Dir\u00edgete a la recepci\u00f3n para recibir los datos de descarga del juego.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/533014.html"},"pt":{"name":"City Game : La qu\u00eate de la cl\u00e9 d'or","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/533014.html"},"cn":{"name":"City Game : La qu\u00eate de la cl\u00e9 d'or","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/533014.html"}},"place":{"id":258195,"translations":{"fr":{"name":"Palais du Coudenberg","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@coudenberg.brussels","website":"http:\/\/www.coudenberg.brussels","phone_contact":"+32 2 500 45 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"Autrefois, l\u2019impressionnant palais du Coudenberg dominait la ville de Bruxelles. Charles Quint et d\u2019autres souverains parmi les plus puissants que l\u2019Europe ait connus ont habit\u00e9 cette r\u00e9sidence princi\u00e8re du 12e au 18e si\u00e8cle, jusqu\u2019\u00e0 ce qu\u2019un terrible incendie la d\u00e9truise \u00e0 jamais. Les ruines de ce palais ont disparu pendant de nombreuses ann\u00e9es dans les sous-sols. Aujourd\u2019hui, ces vestiges forment un site arch\u00e9ologique enchanteur constitu\u00e9 d\u2019un r\u00e9seau de salles et de passages souterrains.\r\n \r\nAu cours de votre visite, vous d\u00e9couvrirez les b\u00e2timents principaux du palais et vous fl\u00e2nerez dans la rue Isabelle, qui est aujourd\u2019hui souterraine. Dans le mus\u00e9e du Coudenberg, qui est abrit\u00e9 dans l\u2019h\u00f4tel d\u2019Hoogstraeten, sont expos\u00e9es les plus belles d\u00e9couvertes arch\u00e9ologiques effectu\u00e9es lors des diff\u00e9rentes campagnes de fouilles men\u00e9es sur le site du Coudenberg\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Coudenbergpaleis","address_street_name":"Paleizenplein","address_street_number":"7","address_street_box":null,"email":"info@coudenberg.brussels","website":"http:\/\/www.coudenberg.brussels","phone_contact":"+32 2 500 45 54","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Paleizenplein, 7","address_line2":"1000 Brussel","description_web":"Ooit werd Brussel gedomineerd door het reusachtige Coudenbergpaleis. Keizer Karel en het kruim van de Europese adel verbleven er tussen de twaalfde en de achttiende eeuw. Tot het noodlot toesloeg en een brand het prachtige gebouw verwoestte. Vele resten bleven echter intact en verdwenen ... onder de grond. Nu is het een betoverende archeologische site, een netwerk van gewelfde gangen, zalen en verborgen kamers.\r\n \r\nTijdens een bezoek ontdek je de hoofdgebouwen van het paleis en flaneer je door de Isabellastraat, die nu onder de grond ligt! In het museum van de Coudenberg, dat in het bovengrondse Hof van Hoogstraeten ondergebracht is, kan je de mooiste archeologische voorwerpen bewonderen die in de loop van de verschillende opgravingswerken op de Coudenbergsite werden ontdekt.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Coudenberg Palace","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@coudenberg.brussels","website":"http:\/\/www.coudenberg.brussels","phone_contact":"+32 2 500 45 54","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Place des Palais, 7","address_line2":"1000 Brussels","description_web":"Once upon a time, the Coudenberg Palace towered over the city of Brussels. Charles V and many other of the most powerful rulers ever to reign in Europe made this princely residence their home between the 12th and 18th centuries, until it was consumed by a terrible fire.  Every trace of this prestigious palace simply disappeared underground for many years. Today, however, these ruins constitute a fascinating archeological site incorporating a network of underground passages and chambers.\r\n \r\nWhen you visit it you can explore the principal buildings of the palace and enjoy a stroll along the Rue Isabelle, which is now underground.  In the Coudenberg Museum, located in Hoogstraeten House, the finest of the archeological discoveries made during the various excavations of the Coudenberg site are displayed.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Coudenberg Palast","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@coudenberg.brussels","website":"http:\/\/www.coudenberg.brussels","phone_contact":"+32 2 500 45 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"Ein unterirdischer Parcours, in dessen Verlauf Sie die \u00dcberreste des Palastes von Charles V. entdecken k\u00f6nnen. Seit dem Mittelalter \u00fcberragt eine f\u00fcrstliche Residenz auf dem Coudenberg die Stadt Br\u00fcssel. Das architektonische Ensemble, das sich seit dem 12. Jahrhundert immer wieder weiterentwickelt hat, gilt als einer der sch\u00f6nsten Pal\u00e4ste Europas und eine der wichtigsten Residenzen von Karl V. Dieses prestigetr\u00e4chtige Geb\u00e4ude wurde bei einem Brand im Februar 1731 schwer besch\u00e4digt. Vierzig Jahre sp\u00e4ter wurden die Ruinen des Palasts dem Erdboden gleichgemacht, um Platz f\u00fcr den Place Royale zu machen. Die \u00dcberreste dieses Geb\u00e4udes bilden heute die arch\u00e4ologische St\u00e4tte des Coudenberg. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Coudenberg Palazzo","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@coudenberg.brussels","website":"http:\/\/www.coudenberg.brussels","phone_contact":"+32 2 500 45 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"\"Il sito archeologico di Coudenberg vi svela un percorso sotterraneo e un museo dedicati a Carlo V sulla Place de Palais a Bruxelles.\tSito Archeologico di Coudenbergl sito...\"\r\n\r\nIl sito archeologico di Coudenberg vi svela un percorso sotterraneo e un museo dedicati a Carlo V sulla Place de Palais a Bruxelles.\r\n\r\nSito Archeologico di Coudenberg\r\n\r\nl sito riunisce vestigia dell'antico palazzo di Bruxelles, della residenza di Hoogstraeten e della Rue Isabelle. Un'affascinante passeggiata che vi conduce sotto il pav\u00e9 della place Royale, alla scoperta dei resti del Palazzo di Coudenberg che fu una delle residenze principali di Carlo V. \u00a0\r\n\r\nMuseo del Coudenberg\r\nil museo vi invita a scoprire un'esposizione permanente di oggetti trovati durante gli scavi effettuati sul sito negli ultimi 25 anni. potete combinare la vostra visita con quella del Museo BELvue.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Coudenberg Palacio","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@coudenberg.brussels","website":"http:\/\/www.coudenberg.brussels","phone_contact":"+32 2 500 45 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"En el emplazamiento arqueol\u00f3gico de Coudenberg encontrar\u00e1s un recorrido subterr\u00e1neo y un museo dedicado al Palacio Carlos V, en la Place des Palais de Bruselas....\r\n\r\nEn el emplazamiento arqueol\u00f3gico de Coudenberg encontrar\u00e1s un recorrido subterr\u00e1neo y un museo dedicado al Palacio Carlos V, en la Place des Palais de Bruselas.\r\n\r\nEl emplazamiento arqueol\u00f3gico Coudenberg\r\n\r\nEl emplazamiento arqueol\u00f3gico Coudenberg est\u00e1 compuesto de vestigios del antiguo Palacio de Bruselas, del Hotel Hoogstraeten y de la Rue Isabelle.\u00a0Este fascinante paseo te llevar\u00e1 a descubrir los <b>vestigios del Palacio Coudenberg<\/b>, que fue una de las residencias de Carlos V.\r\n\r\nMuseo Coudenberg\r\n\r\nInstalado en los vestigios del antiguo Hotel de Hoogstraeten, el Museo Coudenberg  te invita a descubrir una <b>exposici\u00f3n permanente<\/b> de objetos hallados durante las distintas <b>excavaciones arqueol\u00f3gicas<\/b> realizadas los \u00faltimos 25 a\u00f1os.\u00a0Podr\u00e1s combinar tu visita del Coudenberg con la del Museo BELvue.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Palais du Coudenberg","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@coudenberg.brussels","website":"http:\/\/www.coudenberg.brussels","phone_contact":"+32 2 500 45 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Palais du Coudenberg","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@coudenberg.brussels","website":"http:\/\/www.coudenberg.brussels","phone_contact":"+32 2 500 45 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[16],"translations":{"fr":["Quartier Royal"],"nl":["Koninklijke wijk"],"en":["Royal"]}},"zones":{"list":[19],"translations":{"fr":["Centre"],"nl":["Centrum"],"en":["Centre"]}},"neca":null,"facebook_id":null,"backoffice_id":18195,"location":{"lat":50.84261029,"lon":4.36068879},"region":"brussels","last_updated_at":"2022-05-31T11:05:04+02:00","published_at":"2014-05-05T10:58:29+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":258195,"translations":{"fr":{"name":"Palais du Coudenberg","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@coudenberg.brussels","website":"http:\/\/www.coudenberg.brussels","phone_contact":"+32 2 500 45 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Pal