-nouveau-art-deco","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700005252"},"cn":{"name":"Art D\u00e9co autour du Canal","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.itineraires.be\/art-nouveau-art-deco","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700005252"},"fr":{"name":"Art D\u00e9co autour du Canal","shortdescr":"Qui dit canal, dit eau; qui dit eau, dit industrie; qui dit industrie, dit.. Patrimoine architectural! Rejoignez-nous pour une balade captivante \u00e0 la d\u00e9couverte de l'Art D\u00e9co entre Dansaert et le Canal. ","longdescr":"Qui dit canal, dit eau; qui dit eau, dit industrie; qui dit industrie, dit.. Patrimoine architectural! Rejoignez-nous pour une balade captivante \u00e0 la d\u00e9couverte de l'Art D\u00e9co entre Dansaert et le Canal. Entre boutiques en ville et entrep\u00f4t le long de l\u2019eau, le quartier a vu une effervescence commerciale dans les ann\u00e9es de l\u2019entre deux guerres. Effervescence qui se refl\u00e8te aussi dans les lieux de loisirs: entre th\u00e9\u00e2tres et bars d\u2019\u00e9poque, c\u2019est tout un chapitre de vie Bruxelloise que votre guide vous d\u00e9voilera.\n","performers":null,"boxoffice_url":null,"website":"https:\/\/www.itineraires.be\/art-nouveau-art-deco","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700005252"},"sp":{"name":"Art D\u00e9co autour du Canal","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.itineraires.be\/art-nouveau-art-deco","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700005252"},"nl":{"name":"Art D\u00e9co autour du Canal","shortdescr":"Kanalen betekenen water; water betekent industrie; industrie betekent... Architecturaal erfgoed! Ga mee op een boeiende wandeling en ontdek de Art Deco tussen Dansaert en het kanaal. ","longdescr":"Kanalen betekenen water; water betekent industrie; industrie betekent... Architecturaal erfgoed! Wandel met ons mee door de art-decowijk tussen Dansaert en het kanaal. Tussen de winkels in de stad en de pakhuizen langs het water kende de wijk een commerci\u00eble boom in de jaren tussen de oorlogen. De buzz is ook terug te vinden in de vrijetijdsvoorzieningen: van theaters tot historische bars, je gids zal een heel hoofdstuk van het Brusselse leven onthullen.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.itineraires.be\/art-nouveau-art-deco","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700005252"}},"place":{"id":275433,"translations":{"de":{"name":"Angle Avenue de l'H\u00e9liport \/ Avenue Baudouin (sortie M\u00e9tro Yser)","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Angle Avenue de l'H\u00e9liport \/ Avenue Baudouin (sortie M\u00e9tro Yser)","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Angle Avenue de l'H\u00e9liport \/ Avenue Baudouin (sortie M\u00e9tro Yser)","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Angle Avenue de l'H\u00e9liport \/ Avenue Baudouin (s