al van de Pataxos indianen die in de zuidelijke staat Bahia (Brazili\u00eb) wonen. Dit woord staat voor de ambitie van het project en de kwaliteit van de culturele evenementen, maar ook voor de verbondenheid van de initiatiefnemers met de Braziliaanse cultuur. \r\nLe Baixu is ondergebracht in een voormalig industrieel gebouw in het hart van de trendy Brusselse Tour & Taxis wijk. Een atypische en warme plek bedoeld voor concerten, tentoonstellingen, filmvertoningen en conferenties en waar je ook priv\u00e9 evenementen kan organiseren. Het is een volledig uitgeruste, multidisciplinaire culturele ruimte met een oppervlakte van 150 m2, gewijd aan de \"schoonheid\" in al haar vormen. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":39109,"location":{"lat":50.86391031,"lon":4.34697026},"last_updated_at":"2023-05-11T08:22:15+02:00","published_at":"2022-07-15T20:19:31+02:00","is_in_address_book":true,"is_in_vb_export":false,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"poster","link":"https:\/\/agendabrussels2.imgix.net\/da961ac13f6a5ddc38db444c85a6e61d1a499dc6.jpg","width":1052,"height":1053,"ratio":0,"oEmbed_height":1053,"oEmbed_width":1052,"translations":{"de":{"title":"JOSE","copyright":null},"pt":{"title":"JOSE","copyright":null},"en":{"title":"JOSE","copyright":null},"it":{"title":"JOSE","copyright":null},"cn":{"title":"JOSE","copyright":null},"fr":{"title":"JOSE","copyright":null},"sp":{"title":"JOSE","copyright":null},"nl":{"title":"JOSE","copyright":null}}},{"type":"video","link":"https:\/\/youtu.be\/QDXzT5U4ujI","width":null,"height":null,"ratio":null,"translations":{"de":{"title":"JAZZ EN FETE - tribute to JOSE BEDEUR","copyright":null},"pt":{"title":"JAZZ EN FETE - tribute to JOSE BEDEUR","copyright":null},"en":{"title":"JAZZ EN FETE - tribute to JOSE BEDEUR","copyright":null},"it":{"title":"JAZZ EN FETE - tribute to JOSE BEDEUR