"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[24,32],"translations":{"fr":["Galeries d'art","Design"],"nl":["Galeries","Design"],"en":["Art Galleries","Design"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Season XXII - Kiki van Eijk & Joost van Bleisjwijk, Duo show","shortdescr":null,"longdescr":"Spazio Nobile Gallery\r\n\r\nSeason XXII- Kiki van Eijk & Joost van Bleiswijk, Duo Show, Serendipity\r\n\r\nApr\u00e8s le solo show, Kiki van Eijk, The New Harvest, organis\u00e9e par Spazio Nobile \u00e0 la maison de ventes aux ench\u00e8res Lempertz \u00e0 Bruxelles en 2021, Kiki & Joost inaugurent leur premi\u00e8re exposition en duo, S\u00e9rendipit\u00e9, \u00e0 la galerie Spazio Nobile, une premi\u00e8re mondiale levant le voile sur leurs cr\u00e9ations embl\u00e9matiques et de nouvelles \u00e9ditions de pi\u00e8ces uniques et limit\u00e9es. Se trouvant au bon endroit au bon moment, le couple de designers acclam\u00e9s s'inspire et travaille l'un avec l'autre. Ils \u0153uvrent en symbiose avec leurs \u201cmains pensantes\u201d (thinking hands) et leur esprit artistique, mettant en sc\u00e8ne l'inattendu, qui se trouve \"accidentellement\" sur leur chemin, au c\u0153ur de leur processus, enrichi par leur complicit\u00e9 et amour partag\u00e9s.\r\n\r\nSpazio Nobile Gallery\u00a0\r\n\r\nKiki van Eijk & Joost van Bleiswijk, Duo Show, Serendipity\r\n\r\n22.5-4.9.2022\r\n\r\nRue Franz Merjay 142 & 169 - 1050 Brussels","performers":"Kiki van Eijk & Joost van Bleiswijk","boxoffice_url":null,"website":"http:\/\/www.spazionobilegallery.com","email":"lc@spazionobile.com","phone_contact":null,"phone_booking":"+32 475 53 19 88","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/536328.html"},"