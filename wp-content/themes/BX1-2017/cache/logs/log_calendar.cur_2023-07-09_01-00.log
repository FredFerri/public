ept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen","it":"Visite guidate","sp":"Visitas guiadas","pt":null,"cn":null}},"others":{}},"languages":{"spoken":["fr","en","nl"],"subtitles":[]},"translations":{"fr":{"name":"Tour guid\u00e9 \u00e0 v\u00e9lo | Les incontournables et sentiers moins battus de Bruxelles","shortdescr":"D\u00e9couvrez Bruxelles, ses incontournables et sentiers moins battus \u00e0 v\u00e9lo !","longdescr":"Cette visite guid\u00e9e \u00e0 v\u00e9lo est l\u2019introduction id\u00e9ale \u00e0 Bruxelles, son  histoire et ses nombreux quartiers. Un m\u00e9lange original entre les incontournables tels que le quartier des Marolles, le March\u00e9 aux Poissons, le Palais de Justice,... et les sentiers moins battus de la ville. Ce tour vous offre une vue surprenante sur la ville, son patrimoine et sa diversit\u00e9. \r\n\r\n\u00c0 mi-parcours, les v\u00e9los sont mis de c\u00f4t\u00e9 pour une pause dans un bar sympathique ou sur une terrasse.  \r\n\r\nD\u00e9couvrez plus que vous ne l'imaginez \u00e0 v\u00e9lo ! \r\n\r\nInfos pratiques: \r\n- Tous les samedis, tours en FR, NL et EN\r\n- Avec votre propre v\u00e9lo ou un v\u00e9lo classique ou e-bike \u00e0 nous\r\n- Dur\u00e9e: 3h30\r\n- D\u00e9part et arriv\u00e9e dans le centre-ville au Grand Hospice\r\n\r\nD\u00e9couvrez plus sur notre site web: https:\/\/cactus.brussels\/tours-velo-publiques","performers":null,"boxoffice_url":null,"website":"https:\/\/cactus.brussels\/tours-velo-publiques","email":"info@cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.546394"},"nl":{"name":"Gegidste fietstocht | Highlights en minder betreden paden van Brussel","shortdescr":"Ontdek Brussel, langs highlights en minder betreden paden met de fiets!","longdescr":"Deze fietstocht langs de highlights en minder betreden paden is de ideale kennismaking met Brussel, haar erfgoed en diversiteit aan wijken. Onze gidsen maken van deze tour een boeiende mix tussen highlights als de Marollen, de Vismarkt of het Justitiepaleis en de minder betreden paden van de stad. Een verrassende blik op de stad en haar veelzijdigheid want Brussel is meer dan haar klassieke highlights!\r\n\r\nHalverwege de tour gaan de fietsen aan de kant voor een pauze in een gezellige bar of terrasje.\r\n\r\nOntdek meer dan je zou verwachten, met de fiets!\r\n\r\nPraktische info: \r\n- Elke zaterdag tours in NL, FR en EN\r\n- Met je eigen fiets of een klassieke fiets of e-bike van ons\r\n- Duur: 3u30\r\n- Vertrek en einde in het stadscentrum, Grand Hospice\r\n\r\nOntdek meer op onze website: https:\/\/cactus.brussels\/publieke-fietstochten","performers":null,"boxoffice_url":null,"website":"https:\/\/cactus.brussels\/publieke-fietstochten","email":"info@cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.546394"},"en":{"name":"Guided bike tour | Brussels highlights and hidden gems","shortdescr":"Discover Brussels, its highlights and less beaten tracks by bike!","longdescr":"This bike guided bike tour along highlights and hidden gems is an ideal introduction to Brussels, its various neighbourhoods and many identities. During this tour, our guides offer you an interesting mix between highlights such as the Marolles, the Fish Market, the Courthouse and hidden gems along the city's less beaten tracks. A surprising view on the city, its heritage and versatility.\r\n\r\nThe bikes are set aside halfway the tour for a break at a cosy bar or terrace. \r\n\r\nDiscover more than you can imagine by bike!\r\n\r\nPractical info: \r\n- Every Saturday, tours in EN, FR and NL\r\n- With your own bike or with one of our classic or e-bikes\r\n- Time: 3h30\r\n- Meeting point: city center, Grand Hospice\r\n\r\nDiscover more on our website: https:\/\/cactus.brussels\/public-bike-tours","performers":null,"boxoffice_url":null,"website":"https:\/\/cactus.brussels\/public-bike-tours","email":"info@cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.546394"},"de":{"name":"Higlights en minder betreden paden van Brussel met de fiets","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/cactus.brussels\/tours-velo-publiques","email":"info@cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.546394"},"it":{"name":"Higlights en minder betreden paden van Brussel met de fiets","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/cactus.brussels\/tours-velo-publiques","email":"info@cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.546394"},"sp":{"name":"Higlights en minder betreden paden van Brussel met de fiets","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/cactus.brussels\/tours-velo-publiques","email":"info@cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.546394"},"pt":{"name":"Higlights en minder betreden paden van Brussel met de fiets","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/cactus.brussels\/tours-velo-publiques","email":"info@cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.546394"},"cn":{"name":"Higlights en minder betreden paden van Brussel met de fiets","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/cactus.brussels\/tours-velo-publiques","email":"info@cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.546394"}},"place":{"id":277608,"translations":{"fr":{"name":"Cactus Brussel \u00e0 v\u00e9lo","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"info@cactus.brussels","website":"http:\/\/www.cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 7","address_line2":"1000 Bruxelles","description_web":"Cactus Brussel \u00e0 v\u00e9lo est une association de guides b\u00e9n\u00e9voles locaux ayant \u00e0 c\u0153ur Bruxelles et le v\u00e9lo. Ils partagent avec enthousiasme leur passion pour la ville et le v\u00e9lo avec des visiteurs de Bruxelles et d\u2019autres Bruxellois. A v\u00e9lo ils trouvent le rythme id\u00e9al pour vous immerger dans la ville et ils offrent une exp\u00e9rience authentique \u00e0 Bruxelles. Avant tout, ils pr\u00e9f\u00e8rent vous guider hors des chemins battus et cela dans une ambiance conviviale. Vivez Bruxelles dans toute sa splendeur \u00e0 v\u00e9lo et d\u00e9couvrez plus que vous ne le pensez.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Cactus Brussel \u00e0 v\u00e9lo","address_street_name":"Grootgodshuisstraat","address_street_number":"7","address_street_box":null,"email":"info@cactus.brussels","website":"http:\/\/www.cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Grootgodshuisstraat, 7","address_line2":"1000 Brussel","description_web":"Cactus Brussel \u00e0 v\u00e9lo is een vereniging van lokale vrijwillige gidsen met een passie voor Brussel en de fiets. Ze delen hun passie voor de stad en het fietsen enthousiast met bezoekers van Brussel en andere Brusselaars. Op hun fietsen vinden ze het juiste tempo om u onder te dompelen in de stad en u een authentieke Brusselse ervaring te bieden. Bovenal begeleiden ze jullie graag buiten de gebaande paden in een vriendelijke sfeer. Beleef Brussel in al zijn pracht per fiets en ontdek meer dan jullie denken.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Cactus Brussel \u00e0 v\u00e9lo","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"info@cactus.brussels","website":"http:\/\/www.cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue du Grand Hospice, 7","address_line2":"1000 Brussels","description_web":"Cactus Brussel \u00e0 v\u00e9lo is an association of local volunteer guides with a passion for Brussels and cycling. They enthusiastically share their passion for the city and cycling with visitors to Brussels and other Brussels residents. On their bikes they find the right pace to immerse you in the city and offer an authentic Brussels experience. Above all, they prefer to guide you off the beaten track in a friendly atmosphere. Experience Brussels in all its splendour by bike and discover more than you think.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Cactus Brussel \u00e0 v\u00e9lo","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"info@cactus.brussels","website":"http:\/\/www.cactus.brusse