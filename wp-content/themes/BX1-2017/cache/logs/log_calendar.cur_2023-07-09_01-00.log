nnera les cl\u00e9s et vous emm\u00e8nera de surprise en surprise : d\u00e9cors, sculptures, fresques, d\u00e9tails poignants ou cocasses nous raconteront l\u2019espoir centenaire d\u2019un monde meilleur et nous incitera \u00e0 r\u00e9fl\u00e9chir \u00e0 la place de ces valeurs de progr\u00e8s pour le temps pr\u00e9sent et pour l\u2019avenir.\r\n\r\nMerci de nous fournir votre adresse lors de la r\u00e9servation.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.bruxellesbavard.be","email":"info@bruxellesbavard.be","phone_contact":"+32 488 94 18 13","phone_booking":"+32 488 94 18 13","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.560387"},"nl":{"name":"Visite gratuite de l'h\u00f4tel de ville de Saint-Gilles pour les Saint-Gillois","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.bruxellesbavard.be","email":"info@bruxellesbavard.be","phone_contact":"+32 488 94 18 13","phone_booking":"+32 488 94 18 13","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.560387"},"en":{"name":"Visite gratuite de l'h\u00f4tel de ville de Saint-Gilles pour les Saint-Gillois","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.bruxellesbavard.be","email":"info@bruxellesbavard.be","phone_contact":"+32 488 94 18 13","phone_booking":"+32 488 94 18 13","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.560387"},"de":{"name":"Visite gratuite de l'h\u00f4tel de ville de Saint-Gilles pour les Saint-Gillois","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.bruxellesbavard.be","email":"info@bruxellesbavard.be","phone_contact":"+32 488 94 18 13","phone_booking":"+32 488 94 18 13","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.560387"},"it":{"name":"Visite gratuite de l'h\u00f4tel de ville de Saint-Gilles pour les Saint-Gillois","shortdescr"