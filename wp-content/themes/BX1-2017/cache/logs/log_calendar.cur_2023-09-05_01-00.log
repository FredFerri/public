rt | Voir la carte","longdescr":"Cr\u00e9er un tableau implique le choix d'un th\u00e8me, la mise en composition et la ma\u00eetrise d'une technique (l'huile, acrylique ou autre). Lors de cet atelier vous serez amen\u00e9s \u00e0 cr\u00e9er un ou plusieurs tableaux via diff\u00e9rentes techniques gr\u00e2ce \u00e0 une approche p\u00e9dagogique adapt\u00e9e \u00e0 chacun d'entre vous dans une ambiance cr\u00e9ative et conviviale, que vous soyez d\u00e9butants ou avanc\u00e9s, que vous soyez attir\u00e9s par la peinture figurative ou abstraite.\r\nAvec Ana Tzaneva\r\n\r\na partir de 16ans\r\n\r\nLocal Studio \r\n\r\nD\u00e9s le 18 septembre, les lundis de 19:00 \u00e0 22:00","performers":"Avec Ana Tzaneva","boxoffice_url":null,"website":"http:\/\/www.wolubilis.be","email":"secretariat.atl@woluwe1200.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.559322"},"sp":{"name":"Peinture","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wolubilis.be","email":"secretariat.atl@woluwe1200.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.559322"},"nl":{"name":"Peinture","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wolubilis.be","email":"secretariat.atl@woluwe1200.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.559322"}},"place":{"id":220532,"translations":{"de":{"name":"Centre Culturel Wolubilis","address_street_name":"Cours Paul-Henri Spaak","address_street_number":"1","address_street_box":null,"email":"secretariat.atl@woluwe1200.be","website":"http:\/\/www.wolubilis.be","phone_contact":"+32 2 761 60 29","phone_booking":"+32 2 761 60 30","address_zip":"1200","address_city":"Woluwe-Saint-Lambert","address_line1":"Cours Paul-Henri