s_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2025-01-24T12:37:02+01:00","published_at":"2025-01-24T12:32:16+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":316844,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"other","ranking":0.35688292775180414,"languages":{"spoken":["fr","en"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[34,24],"translations":{"de":["Multidisziplin\u00e4r","Kunstgalerien"],"pt":[null,null],"en":["Multidisciplinary","Art Galleries"],"it":["Multidisciplinare","Gallerie d'arte"],"cn":[null,null],"fr":["Pluridisciplinaire","Galeries d'art"],"sp":["Multidisciplinar","Galer\u00edas de arte"],"nl":["Pluridisciplinair","Galeries"]}}},"translations":{"de":{"name":"Group exhibition - Never Grow Up","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.mazelgalerie.com","email":"contact@mazelgalerie.com","phone_contact":"+32 2 850 29 28","phone_booking":"+32 2 850 29 28","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700005804"},"pt":{"name":"Group exhibition - Never Grow Up","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.mazelgalerie.com","email":"contact@mazelgalerie.com","phone_contact":"+32 2 850 29 28","phone_booking":"+32 2 850 29 28","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700005804"},"en":{"name":"Group exhibition - Never Grow Up","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.mazelgalerie.com","email":"contact@mazelgalerie.com","phone_contact":"+32 2 850 29 28","phone_booking":"+32 2 850 29 28","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700005804"},"it":{"name":"Group exhibition - Never Grow Up","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.mazelgalerie.com","email":"contact@mazelgalerie.com","phone_contact":"+32 2 850 29 28","phone_booking":"+32 2 850 29 28","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700005804"},"cn":{"name":"Group exhibition - Never Grow Up","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.mazelgalerie.com","email":"contact@mazelgalerie.com","phone_contact":"+32 2 850 29 28","phone_booking":"+32 2 850 29 28","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700005804"},"fr":{"name":"Exposition collective : Never Grow Up","shortdescr":"Pour cette premi\u00e8re exposition de l'ann\u00e9e, nous vous invitons \u00e0 d\u00e9couvrir \"Never Grow Up\". Un accrochage multidisciplinaire qui r\u00e9unit une douzaine d\u2019artistes. \u00c0 travers une vari\u00e9t\u00e9 de mediums et de d\u00e9marches, cette exposition invite \u00e0 revisiter l\u2019essence m\u00eame de l\u2019enfance, cette p\u00e9riode magique o\u00f9 l\u2019imaginaire n\u2019a pas de limites et o\u00f9 l\u2019innocence trouve une place centrale.\n","longdescr":"Dans un contexte mondial toujours plus complexe et souvent marqu\u00e9 par les tensions g\u00e9opolitiques et les catastrophes naturelles, Never Grow Up se positionne comme un manifeste d\u2019espoir pour les g\u00e9n\u00e9rations futurs. En nous plongeant dans l'univers de l'enfance, les \u0153uvres expos\u00e9es appellent \u00e0 un retour \u00e0 l'essentiel, \u00e0 une qu\u00eate d'\u00e9merveillement, \u00e0 travers des visions artistiques novatrices et captivantes.\nCes \u0153uvres offrent une r\u00e9flexion sur l\u2019immat\u00e9rialit\u00e9 de l\u2019enfance et nous rappellent que, m\u00eame \u00e0 l\u2019\u00e2ge adulte, il est possible de se nourrir de la cr\u00e9ativit\u00e9 et de la libert\u00e9 qui caract\u00e9risent cette p\u00e9riode de la vie. Never Grow Up est ainsi un voyage dans l\u2019univers sensible de chaque artiste, o\u00f9 le monde de l'enfance se m\u00eale aux questionnements contemporains.\nCette exposition sera \u00e9galement l\u2019occasion de d\u00e9couvrir pour la premi\u00e8re fois deux nouvelles collaborations avec l'artiste togolais Tesprit et l\u2019artiste nig\u00e9rian Alex Peter Idoko qui seront pr\u00e9sent\u00e9s pour la premi\u00e8re fois \u00e0 la galerie.","performers":"Boris Anje (Anjel); David Bruce; Alfred Cheng; Miguel Delie; Matt Gondek; Gris1; Alex Peter Idoko; Kurar ;  Levalet; Murmure; Laurina Paperina; Pez; Austyn Taylor; Tesprit; Martin Whatson","boxoffice_url":null,"website":"http:\/\/www.mazelgalerie.com","email":"contact@mazelgalerie.com","phone_contact":"+32 2 850 29 28","phone_booking":"+32 2 850 29 28","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700005804"},"sp":{"name":"Group exhibition - Never Grow Up","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.mazelgalerie.com","email":"contact@mazelgalerie.com","phone_contact":"+32 2 850 29 28","phone_booking":"+32 2 850 29 28","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700005804"},"nl":{"name":"Exposition collective : Never Grow Up","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.mazelgalerie.com","email":"contact@mazelgalerie.com","phone_contact":"+32 2 850 29 28","phone_booking":"+32 2 850 29 28","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700005804"}},"place":{"id":248700,"translations":{"de":{"name":"Mazel Galerie","address_street_name":"Rue Capitaine Crespel","address_street_number":"22","address_street_bo