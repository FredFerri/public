{"fr":["lundi, mardi et mercredi: ferm\u00e9","jeudi, vendredi et samedi: de 20:30 \u00e0 22:00","dimanche: de 15:00 \u00e0 22:00"],"nl":["maandag, dinsdag en woensdag: gesloten","donderdag, vrijdag en zaterdag: van 20:30 tot 22:00","zondag: van 15:00 tot 22:00"],"en":["monday, tuesday and wednesday: closed","thursday, friday and saturday: from 20:30 to 22:00","sunday: from 15:00 to 22:00"]},"date_start":"2022-11-18","date_end":"2022-11-27","is_also_by_appointment":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":12},{"translations":{"fr":{"name":"Article 27"},"nl":{"name":"Artikel 27"},"en":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":{"list":[255,259,263,265],"translations":{"fr":["Accessible","Chien d'assistance","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9"],"nl":["Toegankelijk","Assistentiehonden","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet"],"en":["Accessible","Assistance dogs","Accessible to pedestrians with mobility aids","Adapted toilet"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-11-16T15:05:05+01:00","published_at":"2022-11-15T13:38:43+01:00","backoffice_id":265632,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":0.73680629972808},{"id":543631,"date_start":"2022-11-10","date_end":"2022-11-20","date_next":"2022-11-18","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung"}},"others":{"list":[24,27],"translations":{"fr":["Galeries d'art","Photographie"],"nl":["Galeries","Fotografie"],"en":["Art Galleries","Photography"],"de":["Kunstgalerien","Fotografie"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"\u00ab Infinite reflections \u00bb de Yassine Majid","shortdescr":"Exposition de photos urbaines : Bruxelles, New York, Montr\u00e9al, c\u2019est \u00e0 travers ce terrain de jeu infini que j\u2019ai capt\u00e9 \u00e0 diff\u00e9rentes p\u00e9riodes de l\u2019ann\u00e9e ces moments de r\u00e9flexion. La vitrine d\u2019un caf\u00e9, une flaque d\u2019eau, une surface m\u00e9tallique, chaque lieu et chaque instant se fond \u00e0 l\u2019infini.","longdescr":"\u00ab Tout ce que nous voyons n\u2019est visible que gr\u00e2ce \u00e0 la lumi\u00e8re qu\u2019il refl\u00e8te. \u00bb\r\nCe projet est parti d\u2019une discussion autour d\u2019un caf\u00e9 sur le \u00ab pourquoi \u00bb d\u2019une exposition.\r\nC\u2019est finalement en d\u00e9couvrant la double d\u00e9finition du mot r\u00e9flexion que j\u2019ai su o\u00f9 j\u2019allais. \r\nLa r\u00e9flexion scientifique, celle de la lumi\u00e8re, du son, de la chaleur qui est au c\u0153ur de la photographie et la r\u00e9flexion philosophique de l\u2019homme, du photographe qui cherche \u00e0 d\u00e9livrer un message au travers d\u2019une image. \r\nBruxelles, New York, Montr\u00e9al, c\u2019est \u00e0 travers ce terrain de jeu infini que j\u2019ai capt\u00e9 \u00e0 diff\u00e9rentes p\u00e9riodes de l\u2019ann\u00e9e ces moments de r\u00e9flexion. La vitrine d\u2019un caf\u00e9, une flaque d\u2019eau, une surface m\u00e9tallique, chaque lieu et chaque instant se fond \u00e0 l\u2019infini. \r\n\r\nEntr\u00e9e gratuite, sans r\u00e9servation\r\n\r\nPlus d'infos sur l'artiste : https:\/\/www.montdepiete.be\/expo-infinite-reflections","performers":"Yassine Majid (photographe)","boxoffice_url":null,"website":"https:\/\/www.montdepiete.be\/expo-infinite-reflections","email":"info@montdepiete.be","phone_contact":"+32 2 512 13 85","phone_booking":"+32 2 512 13 85","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.543631"},"nl":{"name":"\u00ab Infinite reflections \u00bb door Yassine Majid","shortdescr":"Stedelijke fototentoonstelling: Brussel, New York, Montreal, het is door deze oneindige speeltuin dat ik deze momenten van \"reflectie\" op verschillende tijdstippen van het jaar heb vastgelegd. Het raam van een caf\u00e9, een plas, een metalen oppervlak, elke plek en elk moment smelt in het oneindige.","longdescr":"\u00ab Alles wat we zien is alleen zichtbaar door het licht dat het weerkaatst. \u00bb\r\nDit project startte vanuit een gesprek met een caf\u00e9 over het \u201cwaarom\u201d van een tentoonstelling. Het was uiteindelijk door de dubbele definitie van het woord 'reflectie' te ontdekken dat ik wist welke richting ik op ging.\r\nDe wetenschappelijke \"reflectie\" van licht, geluid, warmte die de kern vormt van fotografie en de filosofische \"reflectie\" van de mens, van de fotograaf die een boodschap wil overbrengen door middel van een beeld.\r\nBrussel, New York, Montreal, het is door deze oneindige speeltuin dat ik deze momenten van \"reflectie\" op verschillende tijdstippen van het jaar heb vastgelegd. Het raam van een caf\u00e9, een plas, een metalen oppervlak, elke plek en elk moment smelt in het oneindige.\r\n\r\nGratis toegang, zonder reservatie\r\n\r\nMeer info over de kunstenaar: https:\/\/www.bergvanbarmhartigheid.be\/nl\/tentoonstelling-infinite-reflections","performers":"Yassine Majid (fotograaf)","boxoffice_url":null,"website":"https:\/\/www.bergvanbarmhartigheid.be\/nl\/tentoonstelling-infinite-reflections","email":"info@montdepiete.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.543631"},"en":{"name":"\u00ab Infinite reflections \u00bb de Yassine Majid","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"info@montdepiete.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.543631"},"de":{"name":"Expo \u00ab Infinite reflections \u00bb de Yassine Majid","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.543631"},"it":{"name":"Expo \u00ab Infinite reflections \u00bb de Yassine Majid","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.543631"},"sp":{"name":"Expo \u00ab Infinite reflections \u00bb de Yassine Majid","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.543631"},"pt":{"name":"Expo \u00ab Infinite reflections \u00bb de Yassine Majid","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.543631"},"cn":{"name":"Expo \u00ab Infinite reflections \u00bb de Yassine Majid","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.543631"}},"place":{"id":221323,"translations":{"fr":{"name":"Mont de Pi\u00e9t\u00e9 (Caisse Publique de Pr\u00eats)","address_street_name":"Rue Saint-Ghislain","address_street_number":"1923","address_street_box":null,"email":null,"website":null,"phone_contact":"+32 2 512 13 85","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Saint-Ghislain, 1923","address_line2":"1