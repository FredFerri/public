:00:00","end":"18:00:00"},{"day":"2022-10-20","doors":null,"start":"11:00:00","end":"18:00:00"},{"day":"2022-10-21","doors":null,"start":"11:00:00","end":"18:00:00"},{"day":"2022-10-22","doors":null,"start":"11:00:00","end":"18:00:00"},{"day":"2022-10-24","doors":null,"start":"11:00:00","end":"18:00:00"},{"day":"2022-10-25","doors":null,"start":"11:00:00","end":"18:00:00"},{"day":"2022-10-26","doors":null,"start":"11:00:00","end":"18:00:00"},{"day":"2022-10-27","doors":null,"start":"11:00:00","end":"18:00:00"},{"day":"2022-10-28","doors":null,"start":"11:00:00","end":"18:00:00"},{"day":"2022-10-29","doors":null,"start":"11:00:00","end":"18:00:00"}],"weekschema":[{"days":{"monday":{"is_open":true,"hours":[{"start":"11:00:00","end":"18:00:00"}]},"tuesday":{"is_open":true,"hours":[{"start":"11:00:00","end":"18:00:00"}]},"wednesday":{"is_open":true,"hours":[{"start":"11:00:00","end":"18:00:00"}]},"thursday":{"is_open":true,"hours":[{"start":"11:00:00","end":"18:00:00"}]},"friday":{"is_open":true,"hours":[{"start":"11:00:00","end":"18:00:00"}]},"saturday":{"is_open":true,"hours":[{"start":"11:00:00","end":"18:00:00"}]},"sunday":{"is_open":false}},"translations":{"fr":["lundi, mardi, mercredi, jeudi, vendredi et samedi: de 11:00 \u00e0 18:00","dimanche: ferm\u00e9"],"nl":["maandag, dinsdag, woensdag, donderdag, vrijdag en zaterdag: van 11:00 tot 18:00","zondag: gesloten"],"en":["monday, tuesday, wednesday, thursday, friday and saturday: from 11:00 to 18:00","sunday: closed"]},"date_start":"2022-10-19","date_end":"2022-10-29","is_also_by_appointment":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-25T01:36:27+02:00","published_at":"2022-10-17T10:09:46+02:00","backoffice_id":264218,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.44964431302261},{"id":542865,"date_start":"2022-09-17","date_end":"2022-11-27","date_next":"2022-10-25","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung"}},"others":{"list":[36,46],"translations":{"fr":["Mus\u00e9es et art centers","Pluridisciplinaire"],"nl":["Musea en kunstcentra","Multidisciplinair"],"en":["Museums and art centers","Multidisciplinary"],"de":["Museen & Kunstzentren","Multidisziplin\u00e4r"]}}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Henry Bauchau, sous les mots, les images","shortdescr":"Henry Bauchau (1913-2012) est un \u00e9crivain majeur, traduit dans toutes les langues europ\u00e9ennes, le chinois et le japonais. Membre de l\u2019Acad\u00e9mie de Langue et litt\u00e9rature fran\u00e7aise de Belgique. \u00c0 la fois po\u00e8te, dramaturge et diariste, il a fait sa renomm\u00e9e gr\u00e2ce \u00e0 son art du roman.","longdescr":"\u00c0 l\u2019occasion du 10e anniversaire du d\u00e9c\u00e8s de l\u2019\u00e9crivain\r\n\r\nHenry Bauchau (1913-2012) est un \u00e9crivain majeur, traduit dans toutes les langues europ\u00e9ennes, le chinois et le japonais. Membre de l\u2019Acad\u00e9mie de Langue et litt\u00e9rature fran\u00e7aise de Belgique. \u00c0 la fois po\u00e8te, dramaturge et diariste, il a fait sa renomm\u00e9e gr\u00e2ce \u00e0 son art du roman. \r\n\r\nOr sous les mots d\u2019Henry Bauchau, il y a toujours des images. \r\n\r\nD\u2019une part, il y a celles qui l\u2019inspirent : les tableaux de grands ma\u00eetres ou les cr\u00e9ations de ses contemporains qui l\u2019interpellent au point de les int\u00e9grer \u00e0 ses \u00e9crits, ou d\u2019engager une collaboration avec des plasticiens ou des photographes. Lui-m\u00eame dessinateur et sculpteur amateur, Henry Bauchau entreprend de faire \u00e9merger ce qu\u2019il appelle \u00ab les v\u00e9rit\u00e9s de la main \u00bb et confie \u00e0 ses dessins le r\u00f4le d\u2019illustration de couverture de ses livres. En tant que psychanalyste et th\u00e9rapeute, il encourage ses patients \u00e0 pratiquer les arts plastiques en atelier. Son accompagnement du jeune Lionel donne mati\u00e8re au roman L\u2019Enfant bleu (2005) et \u00e0 des projets \u00e9ditoriaux. \r\n\r\nD\u2019autre part, il y a les images que son \u00e9criture g\u00e9n\u00e8re, depuis les illustrations graphiques ou photographiques de ses r\u00e9cits aux livres d\u2019artistes et aux cr\u00e9ations les plus improbables, telles cette marionnette de glace ou cette usine con\u00e7ue par un architecte au d\u00e9part du roman \u0152dipe sur la route (1990). Les innombrables adaptations sc\u00e9niques et musicales d\u00e9borderaient le cadre de la pr\u00e9sente exposition.\r\n\r\nL\u2019exposition montre l\u2019importance des images \u00e0 l\u2019origine du travail litt\u00e9raire d\u2019Henry Bauchau et la capacit\u00e9 de l\u2019\u0153uvre \u00e0 g\u00e9n\u00e9rer chez autrui un imaginaire visuel innovant. Les vitrines sont organis\u00e9es par th\u00e8me : influences et inspirations picturales de l\u2019\u00e9crivain, collaborations avec des artistes, travail plasticien exerc\u00e9 par l\u2019auteur, initiatives ext\u00e9rieures de mises en images de ses textes.\r\n\r\nSont expos\u00e9s aussi les r\u00e9sultats du concours organis\u00e9 en 2022 \u00e0 l\u2019\u00c9cole nationale sup\u00e9rieure des arts visuels de La Cambre portant sur des cr\u00e9ations de narration graphique, des reliures ou des livres-objets : ils livrent le regard de la jeunesse contemporaine sur l\u2019\u0153uvre.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.wittockiana.org","email":"info@wittockiana.org","phone_contact":null,"phone_booking":"+32 2 770 53 33","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.542865"},"nl":{"name":"Henry Bauchau, onder de woorden, de beelden","shortdescr":"Henry Bauchau (1913-2012) is een belangrijke schrijver op het internationale literaire toneel, vertaald in bijna alle europese talen, het Chinees en het Japans. Lid van de Acad\u00e9mie de Langue et de litt\u00e9rature fran\u00e7aises de Belgique. Hij is dichter, toneelschrijver en dagboekschrijver, en heeft naam gemaakt door zijn romankunst.","longdescr":"Tentoonstelling georganiseerd ter gelegenheid van de tiende verjaardag van het overlijden van de schrijver\r\n\r\nHenry Bauchau (1913-2012) is een belangrijke schrijver op het internationale literaire toneel, vertaald in bijna alle europese talen, het Chinees en het Japans. Lid van de Acad\u00e9mie de Langue et de litt\u00e9rature fran\u00e7aises de Belgique. Hij is dichter, toneelschrijver en dagboekschrijver, en heeft naam gemaakt door zijn romankunst.\r\n\r\nOnder Henry Bauchau\u2019s woorden, zijn er altijd beelden.\r\n\r\nEnerzijds zijn er beelden die hem inspireren: de schilderijen van de grote meesters of de creaties van zijn tijdgenoten die hem zo aanspreken dat hij ze in zijn geschriften integreert, of dat hij met beeldende kunstenaars of fotografen samenwerkt. Als amateur-tekenaar en beeldhouwer neemt Henry Bauchau zich voor om wat hij noemt \u00ab de waarheden van de hand \u00bb naar voren te brengen ; hij geeft zijn tekeningen de rol van omslagillustraties voor zijn boeken. Als psychoanalist en therapeut moedigt hij zijn pati\u00ebnten aan om plastische kunsten te beoefenen in workshops. Zijn begeleiding van de jonge Lionel geeft aanleiding tot de roman L\u2019Enfant bleu (2005) en tot uitgeverijprojecten. \r\n\r\nAnderzijds zijn er de beelden die zijn geschriften voortbrengen, van de grafische of fotografische illustraties van zijn verhalen tot de kunstenaarsboeken en de meest onwaarschijnlijke creaties, zoals de ijspop of de door een architect ontworpen fabriek ge\u00efnspireerd op het boek \u0152dipe sur la route (1990). De ontelbare toneel- en musicalbewerkingen vallen buiten het bestek van deze tentoonstelling.\r\n\r\nDe tentoonstelling toont het belang van beelden in het literaire werk van Henry Bauchau en het vermogen van zijn werk om bij anderen een vernieuwende visuele verbeelding op te wekken. De vitrines zijn gerangschikt volgens thema: de picturale invloeden en inspiratiebronnen van de schrijver, de samenwerking met kunstenaars, het werk van de schrijver als beeldend kunstenaar en de externe initiatieven om zijn teksten in beeld te brengen.\r\n\r\nDe resultaten van de in 2022 aan de \u00c9cole nationale sup\u00e9rieure des arts visuels de La Cambre georganiseerde wedstrijd over grafische verhaalcreaties en boekbanden zijn ook te zien: zij geven de kijk van de hedendaagse jeugd op het werk.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.542865"},"en":{"name":"Henry Bauchau, sous les mots, les images","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.542865"},"de":{"name":"Henry Bauchau, sous les mots, les images","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.542865"},"it":{"name":"Henry Bauchau, sous les mots, les images","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.542865"},"sp":{"name":"Henry Bauchau, sous les mots, les images","shortdescr":null,"longdescr":null,"performers":null,"boxoff