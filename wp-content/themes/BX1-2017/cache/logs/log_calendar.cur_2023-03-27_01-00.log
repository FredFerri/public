intment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":70,"translations":{"fr":"Foire & salon","nl":"Beurzen & salons","en":"Fairs and shows","de":"Messe & Ausstellung","it":"Fiere ed esposizioni","sp":"Feria y exhibici\u00f3n","pt":null,"cn":null}},"others":{}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Concours d'art animalier d'Ixelles","shortdescr":"De tout temps, les animaux ont \u00e9t\u00e9 une source d\u2019inspiration in\u00e9puisable pour les artistes, des plus modestes aux plus renomm\u00e9.e.s. Les Ixellois.es ne sont pas en reste! Venez d\u00e9couvrir leurs oeuvres pour ce troisi\u00e8me concours d\u2019art animalier d\u2019Ixelles: peintures, dessins, origami, bande dessin\u00e9e\u2026 Un coup de c\u0153ur vous attend peut-\u00eatre au d\u00e9tour d\u2019une cr\u00e9ation.","longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"bienetreanimal@ixelles.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.546145"},"nl":{"name":"Dierlijke kunst wedstrijd van Elsene","shortdescr":"Dieren zijn altijd een onuitputtelijke bron van inspiratie geweest voor kunstenaars, van de meest bescheiden tot de meest gerenommeerde. Elsenaars laten zich niet uit het veld slaan! Kom en ontdek hun werken voor deze derde dierenkunstwedstrijd van Elsene: schilderijen, tekeningen, origami, strips... Een favoriet wacht misschien wel op u in de hoek van een creatie.","longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"bienetreanimal@ixelles.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.546145"},"en":{"name":"Animal art contest of Ixelles","shortdescr":"Animals have always been an inexhaustible source of inspiration for artists, from the most modest to the most renowned. The inhabitants of Ixelles are not to be outdone! Come and discover their works for this third Ixelles animal art contest: paintings, drawings, origami, comics... A favorite may be waiting for you at the corner of a creation.","longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"bienetreanimal@ixelles.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.546145"},"de":{"name":"Concours d'art animalier d'Ixelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"bienetreanimal@ixelles.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.546145"},"it":{"name":"Concours d'art animalier d'Ixelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"bienetreanimal@ixelles.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.546145"},"sp":{"name":"Concours d'art animalier d'Ixelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"bienetreanimal@ixelles.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.546145"},"pt":{"name":"Concours d'art animalier d'Ixelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"bienetreanimal@ixelles.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.546145"},"cn":{"name":"Concours d'art animalier d'Ixelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"bienetreanimal@ixelles.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.