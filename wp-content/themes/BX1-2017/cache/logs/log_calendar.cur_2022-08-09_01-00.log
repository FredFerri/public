,"value":10},{"translations":{"fr":{"name":"Enfants"},"nl":{"name":"Kinderen"},"en":{"name":"Children"}},"value":0},{"translations":{"fr":{"name":"Jeunes"},"nl":{"name":"Jongeren"},"en":{"name":"Young people"}},"value":0},{"translations":{"fr":{"name":"Seniors"},"nl":{"name":"Senioren"},"en":{"name":"Seniors"}},"value":7},{"translations":{"fr":{"name":"Demandeurs d'emploi"},"nl":{"name":"Werkzoekenden"},"en":{"name":"Job seekers"}},"value":4},{"translations":{"fr":{"name":"museumpassmus\u00e9es"},"nl":{"name":"museumpassmus\u00e9es"},"en":{"name":"museumpassmus\u00e9es"}},"value":0},{"translations":{"fr":{"name":"Article 27"},"nl":{"name":"Artikel 27"},"en":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[],"targets":{"list":[3,4,5,11],"translations":{"fr":["Enfants 3-6 ans","Enfants 6-9 ans","Enfants 9-12 ans","Famille"],"nl":["Kinderen 3-6 j.","Kinderen 6-9 j.","Kinderen 9-12 j.","Familie"],"en":["Children 3-6 yr.","Children 6-9 yr.","Children 9-12 yr.","Family"]}},"tags":["kids"],"accessibilities":{"list":[255,261,263,265,266],"translations":{"fr":["Accessible","Parking accessible","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9","Brussels Health Safety Label"],"nl":["Toegankelijk","Toegankelijke parking","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet","Brussels Health Safety Label"],"en":["Accessible","Accessible parking","Accessible to pedestrians with mobility aids","Adapted toilet","Brussels Health Safety Label"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-07-04T14:06:26+02:00","published_at":"2022-03-17T10:50:42+01:00","backoffice_id":249872,"import_origin":null,"sub_type":"other","show_in_agenda":true,"ranking":0.22833557019815},{"id":519320,"date_start":"2021-10-10","date_end":"2022-10-09","date_next":"2022-08-14","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":71,"translations":{"fr":"March\u00e9s & brocantes","nl":"Markten & brocante","en":"Markets and bric-a-brac stores"}},"others":{}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Brussels Makers Market","shortdescr":"March\u00e9 artisanal de cr\u00e9ations et produits originaux de toutes sortes r\u00e9alis\u00e9s par des fabricants belges.","longdescr":"Le Brussels Makers Market r\u00e9uni artistes, cr\u00e9atifs, bricoleurs,...,  au sein d\u2019un m\u00eame espace.\r\n\r\nDans ce march\u00e9 vous trouverez des cr\u00e9ations et produits de fabricants belges, aussi bien professionnels qu\u2019amateurs. \r\n\r\nUne s\u00e9lection sera faite en fonction de 4 crit\u00e8res:\r\n- Une fabrication artisanale locale ou \u00e9quitable\r\n- La durabilit\u00e9 \r\n- L\u2019originalit\u00e9\r\n- La pr\u00e9sence du cr\u00e9ateur.\r\n\r\nBijoux, v\u00eatements, bougies, maroquinerie, luminaires, c\u00e9ramique, macram\u00e9s, illustrations, d\u00e9coration, cosm\u00e9tiques, et bien d'autres...","performers":"Bijoux, v\u00eatements, bougies, maroquinerie, luminaires, c\u00e9ramique, macram\u00e9s, illustrations, d\u00e9coration, cosm\u00e9tiques, et bien d'autres...","boxoffice_url":null,"website":"https:\/\/www.facebook.com\/Brusselsmakersmarket","email":"brusselsmakersmarket@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/519320.html"},"nl":{"name":"Brussels Makers Market","shortdescr":"Ambachtelijke markt van creaties en originele producten van alle soorten gemaakt door Belgische fabrikanten.","longdescr":"De Brussels Makers Market brengt kunstenaars, creatievelingen, doe-het-zelvers, enz. samen in dezelfde ruimte.\r\n\r\nIn deze markt vind je creaties en producten van Belgische fabrikanten, zowel professionals als amateurs.\r\n\r\nEr wordt een selectie gemaakt op basis van 4 criteria:\r\n- Lokale of fairtrade artisanale productie\r\n- Duurzaamheid\r\n- Originaliteit\r\n- De aanwezigheid van de maker.\r\n\r\nSieraden, kleding, kaarsen, lederwaren, verlichting, keramiek, macram\u00e9, illustraties, decoratie, cosmetica en vele andere ...","performers":"Sieraden, kleding, kaarsen, lederwaren, verlichting, keramiek, macram\u00e9, illustraties, decoratie, cosmetica en vele andere ...","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/519320.html"},"en":{"name":"Brussels Makers Market","shortdescr":"Artisan market of creations and original products of all kinds made by Belgian manufacturers.","longdescr":"The Brussels Makers Market brings together artists, creatives, DIY enthusiasts, etc., in the same space.\r\n\r\nIn this market you will find creations and products from Belgian manufacturers, both professionals and amateurs.\r\n\r\nA selection will be made according to 4 criteria:\r\n- Local or fair trade artisanal production\r\n- Durability\r\n- Originality\r\n- The presence of the creator.\r\n\r\nJewelry, clothing, candles, leather goods, lighting, ceramics, macrame, illustrations, decoration, cosmetics, and many others ...","performers":"Jewelry, clothing, candles, leather goods, lighting, ceramics, macrame, illustrations, decoration, cosmetics, and many others ...","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/519320.html"},"de":{"name":"Brussels Makers Market","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/519320.html"},"it":{"name":"Brussels Makers Market","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/519320.html"},"sp":{"name":"Brussels Makers Market","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/519320.html"},"pt":{"name":"Brussels Makers Market","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/519320.html"},"cn":{"name":"Brussels Makers Market","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/519320.html"}},"place":{"id":258279,"translations":{"fr":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Rue Picard","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard","address_line2":"1000 Bruxelles","description_web":"La Gare Maritime : l'ancienne gare de fret devenue jungle urbaine, neutre en \u00e9nergie !\r\n\r\nElle offre le cadre id\u00e9al pour les \u00e9v\u00e9nements culturels innovants, les tournages de films ou s\u00e9ances photo, les march\u00e9s et foires, les lancements et promotions de produits. Les halles de la Gare Maritime ont \u00e9t\u00e9 transform\u00e9es en ville int\u00e9rieure. Elle comportera son propre food hall (\u00e0 partir de septembre 2021), des magasins exclusifs et des bureaux. Dans ce complexe, des espaces uniques et inspirants sont entrecoup\u00e9s de structures en bois chaleureuses. Le b\u00e2timent se pr\u00eate \u00e0 l'organisation de rencontres en petit comit\u00e9 ou de grands happenings. La nef monumentale, attrait architectural, est baign\u00e9e de lumi\u00e8re naturelle indirecte et offre suffisamment d'espace pour les activit\u00e9s int\u00e9rieures bien fr\u00e9quent\u00e9es.\r\nTout \u00e9v\u00e8nement dans la Gare Maritime sera un \u00e9v\u00e8nement \u00e9co-responsable. La durabilit\u00e9 \u00e9tait \u00e0 l'avant-plan pendant les r\u00e9novations du b\u00e2timent. L'\u00e9nergie renouvelable est produite sur place, utilisant la g\u00e9othermie et des panneaux photovolta\u00efques. Sur les promenades vertes bordant la nef centrale, des jardins \u00e0 th\u00e8me et des arbres \u00e0 haut tronc ont \u00e9t\u00e9 amen\u00e9s - comme si le parc voisin se faufile dans le b\u00e2timent. \r\nLa Gare Maritime, un lieu unique : attractif, novateur, ambitieux.\r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Picardstraat","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Picardstraat","address_line2":"1000 Brussel","description_web":"Gare Maritime: van industrieel goederenstation tot energieneutrale urban jungle!\r\n\r\nDe Gare Maritime is de perfecte setting voor innovatieve, culturele evenementen, film- en fotoshoots, markten, beurzen, lanceringen en promoties. De historische stationshallen van de Gare Maritime zijn omgevormd tot overdekte stad, met foodhall (vanaf september 2021), exclusieve winkels en kantoren. Het gebouwencomplex biedt een waaier aan unieke, inspirerende ruimtes afgewisseld met warme houten volumes: perfect voor de organisatie van kleine en grootschalige happenings. D\u00e9 architecturale eyecatcher is de monumentale middenbeuk die baadt in indirect daglicht en over meer dan voldoende ruimte beschikt voor overdekte activiteiten met veel bezoekers.\r\nEen event in de Gare Maritime is een groen event. Tijdens de renovatie van het gebouw was duurzaamheid een speerpunt. Energie wordt ter plaatse hernieuwbaar opgewekt met geothermie en zonnepanelen. De groene wandelboulevards aan weerszijden van de middenbeuk zijn voorzien van thematuinen en hoogstammige bomen, alsof het aangrenzende park het gebouw binnenstroomt. Gare Maritime is een unieke plek: aantrekkelijk, vernieuwend en ambitieus.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Rue Picard","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue Picard","address_line2":"1000 Brussels","description_web":"The Gare Maritime - From industrial freight station to energy neutral urban jungle!\r\n\r\nIt is the perfect setting for innovative cultural events, film or photo shoots, trade shows, fairs, product launches or promotions. \r\nThe historic station concourse that was part of the Gare Maritime has been transformed into an indoor city with its own food hall (coming September 2021), exclusive shops and offices. Countless unique and inspiring areas and warm, wooden structures alternate in this building complex. It is perfectly suited to accommodate both small and major events. The monumental nave is a true architectural eye-catcher, bathed in indirect sunlight and providing ample space for well-attended indoor activities.\r\nAny event in the Gare Maritime is a green event. Sustainability has been key during the renovation works. The building generates its own energy from renewable sources, using geothermics and solar panels. The green boulevards on either side of the nave are lined with themed gardens and tall trees, as if the adjacent park found its way inside. \r\nThe Gare Maritime is a unique place - attractive, innovative and ambitious.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Rue Picard","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Rue Picard","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Rue Picard","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Rue Picard","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Rue Picard","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard","address_li