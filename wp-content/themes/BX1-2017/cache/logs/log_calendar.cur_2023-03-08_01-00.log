2023-02-28","date_end":"2023-03-28","date_next":"2023-03-14","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":true,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert","de":"Konzert","it":"Concerti","sp":"Concierto","pt":null,"cn":null}},"others":{"list":[4,7],"translations":{"fr":["Pop, rock, jazz\u2026","Pop, Rock"],"nl":["Pop, rock, jazz\u2026","Pop, Rock"],"en":["Pop, rock, jazz\u2026","Pop, Rock"],"de":["Pop, Rock, Jazz...","Pop, Rock"],"it":["Pop, rock, jazz\u2026","Pop, Rock"],"sp":["Pop, rock, jazz\u2026","Pop, rock"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["nl","fr"],"subtitles":[]},"translations":{"fr":{"name":"Konfituur","shortdescr":"Jam pour danseurs et musiciens","longdescr":"Trois danseurs et trois musiciens se retrouvent dans le caf\u00e9 de Zinnema et donnent une ouverture funky \u00e0 la jam. Konfituur invite les danseurs et musiciens bruxellois \u00e0 se joindre \u00e0 leur vibe. Pendant ce temps, le public peut profiter de la synergie cr\u00e9\u00e9e sur sc\u00e8ne.\r\n\r\n*Consultez les r\u00e9seaux sociaux pour savoir quels artistes (musiciens et danseurs) ouvrent le jam et quels instruments sont d\u00e9j\u00e0 sur sc\u00e8ne ce soir-l\u00e0.\r\n\r\nEntr\u00e9e libre!","performers":null,"boxoffice_url":null,"website":"http:\/\/www.zinnema.be","email":"info@zinnema.be","phone_contact":null,"phone_booking":"+32 2 555 06 00","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.550135"},"nl":{"name":"Konfituur","shortdescr":"Jam voor dansers en muzikanten","longdescr":"Drie dansers en drie muzikanten ontmoeten elkaar in het caf\u00e9 van Zinnema en zorgen voor een funky opening van de jam. Konfituur nodigt Brusselse dansers en muzikanten uit om mee te gaan in hun vibe. Dit terwijl het publiek kan genieten van de synergie die ontstaat op het podium.\r\n\r\n*Check social media om te kijken welke artiesten (muzikanten en dansers) de jam openen en welke instrumenten die avond reeds aanwezig zijn op podium.\r\n\r\nVrije toegang!","performers":null,"boxoffice_url":null,"website":"http:\/\/www.zinnema.be","email":"info@zinnema.be","phone_contact":null,"phone_booking":"+32 2 555 06 00","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.550135"},"en":{"name":"Konfituur","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.zinnema.be","email":"info@zinnema.be","phone_contact":null,"phone_booking":"+32 2 555 06 00","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.550135"},"de":{"name":"Konfituur","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.zinnema.be","email":"info@zinnema.be","phone_contact":null,"phone_booking":"+32 2 555 06 00","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.550135"},"it":{"name":"Konfituur","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.zinnema.be","email":"info@zinnema.be","phone_contact":null,"phone_booking":"+32 2 555 06 00","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.550135"},"sp":{"name":"Konfituur","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.zinnema.be","email":"info@zinnema.be","phone_contact":null,"phone_booking":"+32 2 555 06 00","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.550135"},"pt":{"name":"Konfituur","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.zinnema.be","email":"info@zinnema.be","phone_contact":null,"phone_booking":"+32 2 555 06 00","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.550135"},"cn":{"name":"Konfituur","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.zinnema.be","email":"info@zinnema.be","phone_contact":null,"phone_booking":"+32 2 555 06 00","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.550135"}},"place":{"id":3232,"translations":{"fr":{"name":"Zinnema","address_street_name":"Rue de Veeweyde","address_street_number":"24 26","address_street_box":null,"email":"info@zinnema.be","website":"http:\/\/www.zinnema.be","phone_contact":"+32 2 555 06 00","phone_booking":"+32 2 555 06 00","address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de Veeweyde, 24 26","address_line2":"1070 Anderlecht","description_web":"Zinnema, Maison Ouverte aux Talents \u00e0 Bruxelles, soutient, d\u00e9veloppe et fait conna\u00eetre des projets d\u2019individus et groupes qui donnent libre cours \u00e0 leur imagination dans l\u2019une ou l\u2019autre discipline artistique \u00e0 Bruxelles ou son environnement.  Cela se passe bottom-up, par des initiatives propres, des workshops ou par leur travail de soutien.\r\nPersuad\u00e9s de l\u2019importance et de la force de l\u2019ouverture, la diversit\u00e9, l\u2019encadrement professionnel, la co\u00f6p\u00e9ration et la qualit\u00e9, Zinnema appr\u00e9cie les artistes et encourage en m\u00eame temps le renouvellement et l\u2019exp\u00e9rimentation dans le laboratoire urbain dynamique qui s\u2019appelle Bruxelles.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Zinnema","address_street_name":"Veeweidestraat","address_street_number":"24 26","address_street_box":null,"email":"info@zinnema.be","website":"http:\/\/www.zinnema.be","phone_contact":"+32 2 555 06 00","phone_booking":"+32 2 555 06 00","address_zip":"1070","address_city":"Anderlecht","address_line1":"Veeweidestraat, 24 26","address_line2":"1070 Anderlecht","description_web":"Zinnema, Open Talentenhuis in Brussel, ondersteunt, promoot en ontwikkelt projecten van individuen en groepen die in Brussel of de Rand in hun vrije tijd uiting geven aan hun verbeelding in \u00e9\u00e9n of andere artistieke discipline. Dit gebeurt bottom-up, via eigen initiatieven, workshops en de ondersteunende werking. Overtuigd van het belang en de kracht van openheid, diversiteit, professionele omkadering, samenwerking en kwaliteit koestert Zinnema artiesten, en moedigt tegelijkertijd vernieuwing en experiment aan in het dynamische stadslaboratorium dat Brussel heet.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Zinnema","address_street_name":"Rue de Veeweyde","address_street_number":"24 26","address_street_box":null,"email":"info@zinnema.be","website":"http:\/\/www.zinnema.be","phone_contact":"+32 2 555 06 00","phone_booking":"+32 2 555 06 00","address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de Veeweyde, 24 26","address_line2":"1070 Anderlecht","description_web":"Zinnema\u2019s doors are wide open for amateur artists looking to flourish within the rich and diverse atmosphere of a big city. Zinnema is an Open Talents House that encourages artists to explore their inner most selves and find inspiration in both familiar and unfamiliar places. It is a professional home for projects, but also a platform for support and collaboration.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Zinnema","address_street_name":"Rue de Veeweyde","address_street_number":"24 26","address_street_box":null,"email":"info@zinnema.be","website":"http:\/\/www.zinnema.be","phone_contact":"+32 2 555 06 00","phone_booking":"+32 2 555 06 00","address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue de Veeweyde, 24 26","address_line2":"1070 Anderlecht","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Zinnema","address_street_name":"Rue 