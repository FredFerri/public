gin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/958d603cfb69eb739537ad64ea30dc0d3c402b29.jpg","width":800,"height":800,"ratio":1,"oEmbed_height":800,"oEmbed_width":800,"translations":{"de":{"title":"Des Roses et du Pain","copyright":null},"pt":{"title":"Des Roses et du Pain","copyright":null},"en":{"title":"Des Roses et du Pain","copyright":null},"it":{"title":"Des Roses et du Pain","copyright":null},"cn":{"title":"Des Roses et du Pain","copyright":null},"fr":{"title":"Des Roses et du Pain","copyright":null},"sp":{"title":"Des Roses et du Pain","copyright":null},"nl":{"title":"Des Roses et du Pain","copyright":null}}}],"dates":[{"day":"2023-09-20","doors":"19:00:00","start":"20:00:00","end":"21:00:00","is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"de":{"name":"Kategorie 3"},"en":{"name":"Category 3"},"it":{"name":"Categoria 3"},"fr":{"name":"Cat\u00e9gorie 3"},"sp":{"name":"Categoria 3"},"nl":{"name":"Categorie 3"}},"value":18},{"translations":{"de":{"name":"Kategorie 2"},"en":{"name":"Category 2"},"it":{"name":"Categoria 2"},"fr":{"name":"Cat\u00e9gorie 2"},"sp":{"name":"Categoria 2"},"nl":{"name":"Categorie 2"}},"value":10},{"translations":{"de":{"name":"Kategorie 1"},"en":{"name":"Category 1"},"it":{"name":"Categoria 1"},"fr":{"name":"Cat\u00e9gorie 1"},"sp":{"name":"Categoria 1"},"nl":{"name":"Categorie 1"}},"value":5},{"translations":{"de":{"name":"Article 27"},"pt":{"name":"Article 27"},"en":{"name":"Article 27"},"it":{"name":"Article 27"},"cn":{"name":"Article 27"},"fr":{"name":"Article 27"},"sp":{"name":"Article 27"},"nl":{"name":"Artikel 27"}},"value":1.25}],"date_exceptions":[],"closing_days":[],"child_events":[],"parent_events":[50000179],"accessibilities":[],"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[]},{"id":50000475,"date_start":"2023-09-20","date_end":"2023-09-20","date_next":"2023-09-20","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2023-08-07T10:45:07+02:00","published_at":"2023-07-31T14:01:19+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":282499,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"theatre","ranking":1.2599210498948732,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":49,"translations":{"de":"Theater","pt":null,"en":"Theatre","it":"Teatro","cn":null,"fr":"Th\u00e9\u00e2tre","sp":"Teatro","nl":"Theater"}},"others":{}},"translations":{"de":{"name":"Amazones","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/famefestival.be\/fr\/fame-event\/amazones\/","email":"info@famefestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50000475"},"pt":{"name":"Amazones","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/famefestival.be\/fr\/fame-event\/amazones\/","email":"info@famefestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50000475"},"en":{"name":"Amazones","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/famefestival.be\/fr\/fame-event\/amazones\/","email":"info@famefestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50000475"},"it":{"name":"Amazones","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/famefestival.be\/fr\/fame-event\/amazones\/","email":"info@famefestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50000475"},"cn":{"name":"Amazones","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/famefestival.be\/fr\/fame-event\/amazones\/","email":"info@famefestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50000475"},"fr":{"name":"Amazones","shortdescr":"Des mythes grecs et des maquettes anim\u00e9es servent de pr\u00e9texte pour interroger des questionnements contemporains, comme le genre ou l'\u00e9quit\u00e9 de la violence.\n","longdescr":"Exclusivement pour les 7-12 ans (pas d'adultes)\n\nIl y a plus de trois mille ans, un groupe de femmes a fond\u00e9 une soci\u00e9t\u00e9 sur les rives de la mer Noire. Une soci\u00e9t\u00e9 form\u00e9e uniquement de femmes libres, dot\u00e9es d'un esprit communautaire et guerrier, d\u00e9sireuses de d\u00e9fendre un ordre diff\u00e9rent. \nLes Amazones.\nPourquoi les Amazones ont-elles estim\u00e9 n\u00e9cessaire de cr\u00e9er une soci\u00e9t\u00e9 sans hommes ? Pourquoi les h\u00e9ros masculins de l'Antiquit\u00e9 ont-ils r\u00e9agi de mani\u00e8re agressive \u00e0 cette soci\u00e9t\u00e9 alternative ? Est-il juste d'utiliser la violence pour se d\u00e9fendre contre des attaques ? Ou bien la d\u00e9fense de nos opinions, la lutte contre les injustices doivent-elles toujours \u00eatre pacifiques\u202f? Filles, gar\u00e7ons... sommes-nous semblables ou y a-t-il quelque chose qui nous diff\u00e9rencie ? Et... pourquoi le fleuve Amazone porte-t-il pr\u00e9cis\u00e9ment ce nom ?\n\nLe spectacle est pr\u00e9sent\u00e9 dans un langage clair et tr\u00e8s visuel. Des moments de narration alternent avec des maquettes anim\u00e9es en direct ou des promenades cartographiques interactives. Nous invitons \u00e9galement un d\u00e9bat ouvert avec les enfants du public.","performers":"Agrupaci\u00f3n Se\u00f1or Serrano","boxoffice_url":null,"website":"https:\/\/famefestival.be\/fr\/fame-event\/amazones\/","email":"info@famefestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50000475"},"sp":{"name":"Amazones","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/famefestival.be\/fr\/fame-event\/amazones\/","email":"info@famefestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50000475"},"nl":{"name":"Amazones","shortdescr":"Griekse mythen en levende schaalmodellen worden gebruikt om actuele belangrijke kwesties zoals gender of de noodzaak en rechtvaardigheid van geweld in vraag te stellen.\n","longdescr":"Uitsluitend voor 7 tot 12 jaar (geen volwassenen).\n\nMeer dan drieduizend jaar geleden cre\u00eberde een groep vrouwen een samenleving aan de oevers van de Zwarte Zee. Een samenleving alleen gevormd door vrije vrouwen, met een gemeenschaps- en krijgersgeest, bereid om een andere orde te verdedigen. De Amazones.\nWaarom geloofden de Amazones dat ze een samenleving zonder mannen moesten cre\u00ebren? Waarom reageerden mannelijke helden uit de oudheid agressief op deze alternatieve samenleving? Is het eerlijk om geweld te gebruiken om zich te verdedigen tegen aanvallen? Of moet de verdediging van iemands mening, de staking tegen onrechtvaardigheden, altijd vreedzaam zijn? Meisjes, jongens, zijn we allemaal hetzelfde of is er iets dat ons verschillend maakt? En... waarom draagt de Amazonerivier precies die naam?\n\nDe voorstelling wordt gepresenteerd in een heldere en zeer visuele taal. Momenten van vertelling worden afgewisseld met levende schaalmodellen of interactieve kaartwandelingen. We moedigen ook een open debat met de kinderen van het publiek aan.\n\n","performers":null,"boxoffice_url":null,"website":"https:\/\/famefestival.be\/fr\/fame-event\/amazones\/","email":"info@famefestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50000475"}},"place":{"id":228012,"translations":{"de":{"name":"Kindertheater - Th\u00e9\u00e2tre La montagne magique","address_street_name":"Rue du Marais","address_street_number":"57","address_street_box":null,"email":"info@montagnemagique.be","website":"http:\/\/www.theatremontagnemagique.be","phone_contact":"+32 2 210 15 90","phone_booking":"+32 2 210 15 90","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Marais, 57","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Th\u00e9\u00e2tre La montagne magique","address_street_name":"Rue du Marais","address_street_number":"57","address_street_box":null,"email":"info@montagnemagique.be","website":"http:\/\/www.theatremontagnemagique.be","phone_contact":"+32 2 210 15 90","phone_booking":"+32 2 210 15 90","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Marais, 57","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Th\u00e9\u00e2tre La montagne magique","address_street_name":"Rue du Marais","address_street_number":"57","address_street_box":null,"email":"info@montagnemagique.be","website":"http:\/\/www.theatremontagnemagique.be","phone_contact":"+32 2 210 15 90","phone_booking":"+32 2 210 15 90","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Marais, 57","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Teatro La montagne magique","address_street_name":"Rue du Marais","address_street_number":"57","address_street_box":null,"email":"info@montagnemagique.be","website":"http:\/\/www.theat