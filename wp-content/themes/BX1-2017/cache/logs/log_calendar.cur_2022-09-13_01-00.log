t_name":"Rue des Riches Claires","address_street_number":null,"address_street_box":null,"email":"bp1@brunette.brucity.be","website":"http:\/\/www.brunette.brucity.be\/","phone_contact":"+32 2 548 26 10","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Riches Claires","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Biblioth\u00e8que des Riches-Claires (Biblioth\u00e8que publique centrale pour la R\u00e9gion de Bruxelles- Capitale)","address_street_name":"Rue des Riches Claires","address_street_number":null,"address_street_box":null,"email":"bp1@brunette.brucity.be","website":"http:\/\/www.brunette.brucity.be\/","phone_contact":"+32 2 548 26 10","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Riches Claires","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Biblioth\u00e8que des Riches-Claires (Biblioth\u00e8que publique centrale pour la R\u00e9gion de Bruxelles- Capitale)","address_street_name":"Rue des Riches Claires","address_street_number":null,"address_street_box":null,"email":"bp1@brunette.brucity.be","website":"http:\/\/www.brunette.brucity.be\/","phone_contact":"+32 2 548 26 10","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Riches Claires","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":null,"facebook_id":null,"backoffice_id":1228,"location":{"lat":50.84697164,"lon":4.34623764},"region":"brussels","last_updated_at":"2022-08-30T11:05:07+02:00","published_at":"2013-10-19T01:14:09+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"media":[],"dates":[{"day":"2022-09-23","doors":"16:45:00","start":"17:00:00","end":"18:00:00","is_soldout":false,"is_canceled":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":{"list":[255,265],"translations":{"fr":["Accessible","WC adapt\u00e9"],"nl":["Toegankelijk","Aangepast toilet"],"en":["Accessible","Adapted toilet"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-08-30T11:05:07+02:00","published_at":"2022-08-30T10:55:25+02:00","backoffice_id":260660,"import_origin":null,"sub_type":"other","show_in_agenda":true,"ranking":1.2599210498949},{"id":539920,"date_start":"2022-09-23","date_end":"2022-09-23","date_next":"2022-09-23","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":true,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":84,"translations":{"fr":"Divers","nl":"Varia","en":"Various"}},"others":{"list":[89],"translations":{"fr":["Litt\u00e9rature"],"nl":["Literatuur"],"en":["Litterature "]}}},"languages":{"spoken":["en","nl","fr"],"subtitles":[]},"translations":{"fr":{"name":"Opening night poetik bazar","shortdescr":null,"longdescr":"Principalement situ\u00e9 \u00e0 BE-HERE \u00e0 Laeken, le Poetik Bazar se tiendra aussi dans la merveilleuse Maison Po\u00e8me \u00e0 Saint-Gilles, un lieu l\u00e9gendaire d\u00e9di\u00e9 \u00e0 la litt\u00e9rature sur la sc\u00e8ne duquel des \u00e9crivains et philosophes tels qu\u2019Henry Bauchau, Roland Barthes et Jacques Derrida sont mont\u00e9s depuis 1962.\r\n\r\nLa soir\u00e9e d\u2019ouverture de Poetik Bazar promet d\u2019\u00eatre m\u00e9morable. Le Belge Antoine Wauters vous transportera au fil de son livre Mahmoud ou la mont\u00e9e des eaux, r\u00e9compens\u00e9 \u00e0 plusieurs reprises depuis sa sortie (Prix Wepler, Prix Marguerite Duras et Prix du Livre Inter) tandis que l\u2019Anversois Andy Fierens fera honneur \u00e0 sa r\u00e9putation bruyante avec De trompetten van Toetanchamon. Le c\u00e9l\u00e8bre po\u00e8te russe Kirill Medvedev d\u00e9clamera des vers insoumis et la N\u00e9erlandaise Simone Atangana Bekono lira pour la premi\u00e8re fois des extraits de son nouveau recueil Zo hoog de zon stond. Enfin, trois po\u00e8tes d\u2019envergure internationale monteront pour la premi\u00e8re fois sur une sc\u00e8ne belge\u202f: Josef Straka (Tch\u00e9quie), Constantinos Papageorgiou (Chypre) et Maria Br\u00e1s Ferreira (Portugal).\r\n\r\nEt comme si cela ne suffisait pas, nous ajouterons \u00e0 ce programme une projection exclusive de deux po\u00e8mes film\u00e9s de Nils Chr. Moe-Repstadt (Danemark), avec la voix de Peter Verhelst et la musique de Fulco Ottervanger.\r\n\r\nL\u2019acteur, rappeur et \u00e9crivain Rashif El Kaoui dirigera la soir\u00e9e avec doigt\u00e9.\r\n\r\nPoetik bazar 2022\r\nPoetik Bazar est un festival de po\u00e9sie bilingue et unique dans la capitale belge et europ\u00e9enne. Il met \u00e0 l\u2019honneur des po\u00e8mes \u00e9crits des deux c\u00f4t\u00e9s de la fronti\u00e8re linguistique et en Europe, sous diff\u00e9rentes formes. Pendant trois jours, le public a l\u2019opportunit\u00e9 d\u2019y d\u00e9couvrir la vitalit\u00e9 de la po\u00e9sie contemporaine lors d\u2019une bourse d\u2019\u00e9diteurs et des conf\u00e9rences, ateliers et pr\u00e9sentations.\r\n\r\nPoetik Bazar se tient \u00e0 BE-HERE (Laeken), dans un b\u00e2timent industriel de 1923 plein de caract\u00e8re devenu aujourd\u2019hui un lieu vivant accueillant des initiatives durables et culturelles. Ce sera le centre n\u00e9vralgique du festival o\u00f9, toute la journ\u00e9e, le public aura l\u2019opportunit\u00e9 d\u2019assister \u00e0 un march\u00e9 po\u00e9tique et \u00e0 diff\u00e9rentes lectures et discussions. Plus de quarante \u00e9diteurs et magazines de po\u00e9sie y participeront. Mais des initiatives auront lieu \u00e0 plusieurs autres endroits de Bruxelles.\r\nPoetik Bazar est organis\u00e9 par de nombreux partenaires po\u00e9tiques dont\u202fles Midis de la Po\u00e9sie, les \u00e9diteurs singuliers, VONK & Zonen, Po\u00ebziecentrum, maelstr\u00d6m reEvolution, la Maison de la Po\u00e9sie d'Amay et la Foire du Livre de Bruxelles.\r\n\r\nFruit d\u2019une collaboration entre Passa Porta, Vonk & Zonen et Po\u00ebziecentrum, la soir\u00e9e d\u2019ouverture a lieu dans le cadre du projet Versopolis, une plateforme europ\u00e9enne d\u2019associations po\u00e9tiques.\r\n\r\nOrg. Passa Porta, VONK & Zonen, Po\u00ebziecentrum et Poetik Bazar","performers":null,"boxoffice_url":null,"website":"http:\/\/www.passaporta.be","email":"info@passaporta.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.539920"},"nl":{"name":"Opening night poetik bazar","shortdescr":null,"longdescr":"De tweede editie van Poetik Bazar speelt zich niet alleen af in BE-HERE (Laken) maar ook in het wonderlijke Maison Po\u00e8me. Een legendarische literaire plek in Sint-Gillis, waar sinds 1962 schrijvers en filosofen als Henry Bauchau, Roland Barthes en Jacques Derrida op de planken hebben gestaan.\r\n\r\nDe openingsavond van Poetik Bazar belooft ook memorabel te worden. Antwerpenaar Andy Fierens doet zijn reputatie van brulboei alle eer aan met De trompetten van Toetanchamon en zijn Franstalige landgenoot Antoine Wauters vervoert je met zijn meermaals bekroonde bundel Mahmoed of het wassende water (Prix Wepler, Prix Marguerite Duras \u00e9n Prix du Livre Inter). De beruchte Russische dichter Kirill Medvedev brengt weerspannige verzen. Ook geven we drie toonaangevende internationale dichters voor het eerst een podium op Belgische bodem: Josef Straka (Tsjechi\u00eb), Constantinos Papageorgiou (Cyprus) en Maria Br\u00e1s Ferreira (Portugal).\r\n\r\nAlsof dat nog niet genoeg is krijg je nog een exclusieve vertoning van twee verfilmde gedichten van Nils Chr. Moe-Repstadt (Denemarken), met de stem van Peter Verhelst en muziek van Fulco Ottervanger.\r\n\r\nActeur, rapper en schrijver Rashif El Kaoui leidt de avond in goeie banen.\r\n\r\nPoetik bazar 2022\r\nPoetik Bazar is een uniek tweetalig po\u00ebziefestival in de hoofdstad van Belgi\u00eb en Europa. Het toont po\u00ebzie van beide kanten van de taalgrens en van over heel Europa, in verschillende vormen. Drie dagen lang krijgt het publiek de kans om de vitaliteit van de hedendaagse po\u00ebzie te ontdekken op een uitgeversbeurs en tijdens allerlei lezingen, workshops, voorstellingen en presentaties.\r\n\r\nPoetik Bazar wordt opgezet in BE-HERE (Laken), een karaktervol industrieel gebouw uit 1923 dat nu een levendige plek is voor duurzame en culturele initiatieven. Dit is het festivalcentrum waar je overdag terecht kunt voor een po\u00ebziemarkt en diverse kleine voordrachten en gesprekken. Meer dan 40 po\u00ebzie-uitgevers en po\u00ebzietijdschriften nemen deel. Daarnaast zijn er initiatieven op verschillende andere plaatsen in Brussel.\r\n\r\nPoetik Bazar wordt georganiseerd door tal van po\u00ebziepartners, waaronder: Midis de la Po\u00e9sie, les \u00e9diteurs singuliers, VONK & Zonen, Po\u00ebziecentrum, maelstr\u00d6m reEvolution, het Maison de la po\u00e9sie d'Amay en de Foire du livre de Bruxelles.\r\n\r\nDe openingsavond is een samenwerking tussen Passa Porta, Vonk & Zonen en Po\u00ebziecentrum, en kadert in het project Versopolis, een Europees platform voor po\u00ebzieorganisaties.\r\n\r\nOrg. Passa Porta, VONK & Zonen, Po\u00ebziecentrum en Poetik Bazar","performers":null,"boxoffice_url":null,"website":"http:\/\/www.passaporta.be","email":"info@passaporta.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.539920"},"en":{"name":"Opening night poetik bazar","shortdescr":null,"longdescr":"The second edition of Poetik Bazar takes place not only in BE-HERE (Laken) but also in the wonderful Maison Po\u00e8me. A legendary literary venue in Sint-Gillis where, since 1962, writers and philosophers such as Henry Bauchau, Roland Barthes and Jacques Derrida have taken to the stage.\r\n\r\nThe opening night of Poetik Bazar promises to be memorable. Antwerp-native Andy Fierens will live up to his reputation as a howler with De trompetten van Toetanchamon while his French-speaking fellow-countryman Antoine Wauters will transport you with his multi-award-winning collection Mahmoud ou la mont\u00e9e des eaux (Prix Wepler, Prix Marguerite Duras and Prix du Livre Inter). The notorious Russian poet Kirill Medvedev will recite rebellious verses and Simone Atangana Bekono from the Netherlands will read from her new collection, Zo hoog de zon stond. Three leading international poets will make their first appearance on a Belgian stage: Josef Straka (Czech Republic), Constantinos Papageorgiou (Cyprus) and Maria Br\u00e1s Ferreira (Portugal).\r\n\r\nAnd as if that were not enough, there will be an exclusive screening of two filmed poems by Nils Chr. Moe-Repstadt (Denmark), with the voice of Peter Verhelst and music by Fulco Ottervanger.\r\n\r\nActor, rapper and writer Rashif El Kaoui will be the evening\u2019s master of ceremonies.\r\n\r\nPoetik bazar 2022\r\nPoetik Bazar is a unique bilingual poetry festival in the capital of Belgium and Europe. It presents poetry from both sides of the Belgian language border and from across Europe, in various forms. During three days, the public will have the opportunity to discover the vitality of contemporary poetry at a publishers\u2019 fair and through a range of readings, workshops, performances and presentations.\r\n\r\nPoetik Bazar is based in BE-HERE (Laken), a distinctive industrial building from 1923 that is now a dynamic venue for sustainable and cultural initiatives. BE-HERE will be the festival centre where, during the day, you can visit a poetry market and attend various small readings and talks. More than forty poetry publishers and poetry magazines are taking part. Initiatives are also taking place at various other locations in Brussels.\r\nPoetik Bazar is organized by several poetry partners, including: Midis de la Po\u00e9sie, les \u00e9diteurs singuliers, VONK & Zonen, Po\u00ebziecentrum, maelstr\u00d6m reEvolution, Maison de la po\u00e9sie d\u2019Amay and Foire du livre de Bruxelles.\r\n\r\nThe opening night is a collaboration between Passa Porta, VONK & Zonen and Po\u00ebziecentrum, and is part of the Versopolis project, a European platform for poetry organizations.\r\n\r\nOrg. Passa Porta, VONK & Zonen, Po\u00ebziecentrum and Poetik Bazar","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.539920"},"de":{"name":"Opening night poetik bazar","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.539920"},"it":{"name":"Opening night poetik bazar","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.539920"},"sp":{"name":"Opening night poetik bazar","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.539920"},"pt":{"name":"Opening night poetik bazar","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.539920"},"cn":{"name":"Opening night poetik bazar","shortdescr":null,"longdescr":null,"p