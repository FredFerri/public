-uo.com\/","email":"casiuo1970@gmail.com","phone_contact":"+32 475 46 79 48","phone_booking":"+32 2 521 21 25","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.560649"},"en":{"name":"Le travail : mode d\u2019emploi. Voyages au fil du temps et de l\u2019espace","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/casi-uo.com\/","email":"casiuo1970@gmail.com","phone_contact":"+32 475 46 79 48","phone_booking":"+32 2 521 21 25","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.560649"},"it":{"name":"Le travail : mode d\u2019emploi. Voyages au fil du temps et de l\u2019espace","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/casi-uo.com\/","email":"casiuo1970@gmail.com","phone_contact":"+32 475 46 79 48","phone_booking":"+32 2 521 21 25","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.560649"},"cn":{"name":"Le travail : mode d\u2019emploi. Voyages au fil du temps et de l\u2019espace","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/casi-uo.com\/","email":"casiuo1970@gmail.com","phone_contact":"+32 475 46 79 48","phone_booking":"+32 2 521 21 25","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.560649"},"fr":{"name":"Le travail : mode d\u2019emploi. Voyages au fil du temps et de l\u2019espace","shortdescr":null,"longdescr":"Connaissez-vous la Grande Rue \u00e0 Bruxelles ? Non ? \r\nC\u2019est normal, elle n\u2019existe pas.\r\n\r\nEn octobre 2022, l\u2019asbl Casi-Uo avec son groupe d\u2019a\u00een\u00e9s en collaboration avec les ateliers Mot\u2019Arts ont imagin\u00e9 un immeuble travers\u00e9 par diff\u00e9rentes g\u00e9n\u00e9rations d\u2019habitants qui prend vie de 1910 \u00e0 2023. Au rez-de-chauss\u00e9e une conciergerie et une \u00e9picerie, au premier \u00e9tage une famille de notaire, au deuxi\u00e8me une famille de banquier, au troisi\u00e8me un couple dont le mari est ma\u00e7on et sur le m\u00eame palier une couturi\u00e8re qui vit seule avec son chat, au grenier trois chambres de bonnes dont une est lou\u00e9e \u00e0 un artiste. Les a\u00een\u00e9s ont ainsi donn\u00e9 vie aux habitants d\u00e9peignant leurs histoires, leurs d\u00e9parts et leurs arriv\u00e9es.\r\n\r\nCette initiative audacieuse, enrichie par la rencontre avec des t\u00e9moins de diff\u00e9rentes \u00e9poques, a voulu rassembler les g\u00e9n\u00e9rations autour d'un m\u00e9dia puissant : l'\u00e9criture. Au c\u0153ur des r\u00e9flexions, la perception du travail au fil des \u00e2ges et des \u00e9v\u00e9nements du monde !  \r\nDans chaque atelier, les personnages vieillissent de 10 ans. Ils racontent la grande Histoire, ils parlent de leurs pr\u00e9occupations dans des lettres qu\u2019ils \u00e9crivent \u00e0 leur entourage. Un voyage cr\u00e9atif qui a abouti \u00e0 la r\u00e9alisation d\u2019un recueil captivant et d\u2019une exposition constitu\u00e9e de 13 affiches saisissantes retra\u00e7ant leurs histoires.\r\n\r\nChaque affiche r\u00e9v\u00e8le et met en lumi\u00e8re les d\u00e9veloppements les plus marquants. Cette exposition unique explore les liens profonds entre le travail, les g\u00e9n\u00e9rations et l'\u00e9mancipation et invite les spectateurs \u00e0 r\u00e9fl\u00e9chir sur le pass\u00e9, le pr\u00e9sent et l'avenir du travail en Belgique et au-del\u00e0. \r\n  \r\nNous vous invitons au vernissage de l\u2019exposition le 14 octobre au COOP asbl \u00e0 Anderlecht. Celle-ci sera accessible du 14 au 27 octobre 2023 et accompagnera l\u2019exposition permanente du COOP \u00ab Une autre histoire de Bruxelles \u00bb retra\u00e7ant l\u2019histoire des quartiers bordant le canal. \r\nPendant ces 15 jours, il vous sera possible de r\u00e9server une visite guid\u00e9e de l'exposition anim\u00e9e par le groupe des a\u00een\u00e9s. \r\n\r\nVenez d\u00e9couvrir une exp\u00e9rience immersive qui \u00e9veillera vos sens, suscitera votre curiosit\u00e9 et votre r\u00e9flexion sur le travail et son impact sur nos vies. \r\n\r\nQUAND ? Vernissage : \u00ab Le travail : mode d\u2019emploi. Voyages au fil du temps et de l\u2019espace \u00bb le 14.10.23 \/ Exposition accessible du 14 au 27 octobre 2023\r\nO\u00d9 ? COOP asbl \u2013 Quai Fernand Demets 23 \u2013 1070 Anderlecht\r\nPour information ou r\u00e9servation, nous contacter au 025212125 ou \u00e9crire sur casiuo1970@gmail.com.","performers":null,"boxoffice_url":null,"website":"https:\/\/casi-uo.com\/","email":"casiuo1970@gmail.com","phone_contact":"+32 475 46 79 48","phone_booking":"+32 2 521 21 25","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.560649"},"sp":{"name":"Le travail : mode d\u2019emploi. Voyages au fil du temps et de l\u2019espace","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/casi-uo.com\/","email":"casiuo1970@gmail.com","phone_contact":"+32 475 46 79 48","phone_booking":"+32 2 521 21 25","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.560649"},"nl":{"name":"Le travail : mode d\u2019emploi. Voyages au fil du temps et de l\u2019espace","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/casi-uo.com\/","email":"casiuo1970@gmail.com","phone_contact":"+32 475 46 79 48","phone_booking":"+32 2 521 21 25","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.560649"}},"place":{"id":266641,"translations":{"de":{"name":"Coop","address_street_name":"Quai Fernand Demets","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.coop.brussels","phone_contact":null,"phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Quai Fernand Demets","address_line2":"1070 Anderlecht","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Coop","