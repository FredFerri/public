king":1},{"id":539393,"date_start":"2022-08-14","date_end":"2022-08-14","date_next":"2022-08-14","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre"}},"others":{"list":[53],"translations":{"fr":["Contes"],"nl":["Verteltheater"],"en":["Tales"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Guy Duchesne, tricoteur de contes pour adultes : Compter les moutons pour mieux dormir avec les loups","shortdescr":"Spectacle de contes pour ados et adultes","longdescr":"Un conteur canadien a d\u00e9nich\u00e9 PLOEF! et nous propose son dernier spectacle (\u00e0 partir de 12 ans) dans notre petite salle ou dehors s'il le temps s'y pr\u00eate...\r\n\r\n\"Originaire de la Mauricie, mes racines s\u2019y \u00e9panouissent, encore et toujours, \u00e0 proximit\u00e9 du village de mes anc\u00eatres. Mes contes aussi d\u2019ailleurs. J\u2019ai toujours ch\u00e9ri la sc\u00e8ne, peu importe sa taille. Je l\u2019ai foul\u00e9 en enseignement, en th\u00e9\u00e2tre, en humour, en relations publiques.\r\n\r\nQuitter l\u2019ordinaire pour l\u2019extraordinaire. Voil\u00e0 ce que je te propose humblement, \u00e0 travers mes contes; peindre des images sur ta toile, dans ta t\u00eate, avec comme seuls outils, consonnes, voyelles et cordes vocales.\"\r\n\r\nParticipation en conscience.","performers":"Guy Duchesne","boxoffice_url":null,"website":"http:\/\/www.ploef.eu","email":"ploefplus@gmail.com","phone_contact":null,"phone_booking":"+32 2 476 98 07","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.539393"},"nl":{"name":"Guy Duchesne, tricoteur de contes pour adultes : Compter les moutons pour mieux dormir avec les loups",