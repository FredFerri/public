0 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":null,"facebook_id":null,"backoffice_id":38605,"location":{"lat":50.89467785,"lon":4.3462385},"region":"brussels","last_updated_at":"2022-05-27T11:05:04+02:00","published_at":"2022-05-14T22:54:23+02:00","import_origin":null,"external_id":null,"is_in_address_book":false,"is_in_vb_export":false,"resto_ranking":0},"media":[],"dates":[{"day":"2022-06-17","doors":"02:00:00","start":"20:00:00","end":null,"is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":50},{"translations":{"fr":{"name":"<= 21 ans"},"nl":{"name":"<= 21 jaar"},"en":{"name":"<= 21 years"}},"value":30},{"translations":{"fr":{"name":"Senior"},"nl":{"name":"Senioren"},"en":{"name":"Senior"}},"value":40}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":{"list":[252,255,263,266],"translations":{"fr":["Accessible aux personnes ayant des difficult\u00e9s de compr\u00e9hension","Accessible","Accessible aux pi\u00e9tons appareill\u00e9s","Brussels Health Safety Label"],"nl":["Toegankelijk voor mensen met een verstandelijke beperking","Toegankelijk","Toegankelijk voor voetgangers met hulpmiddelen","Brussels Health Safety Label"],"en":["Accessible to people with intellectual disabilities","Accessible","Accessible to pedestrians with mobility aids","Brussels Health Safety Label"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-05-27T11:05:04+02:00","published_at":"2022-05-16T08:39:24+02:00","backoffice_id":253760,"import_origin":null,"sub_type":"concert","show_in_agenda":true,"ranking":1.2599210498949},{"id":533499,"date_start":"2022-06-17","date_end":"2022-06-17","date_next":"2022-06-17","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":true,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert"}},"others":{"list":[4,10],"translations":{"fr":["Pop, rock, jazz\u2026","Jazz & Blues"],"nl":["Pop, rock, jazz\u2026","Jazz & Blues"],"en":["Pop, rock, jazz\u2026","Jazz & Blues"]}}},"languages":{"spoken":["nl","fr","en","de"],"subtitles":[]},"translations":{"fr":{"name":"SceneOff TOOTS100TRIBUTE concert","shortdescr":"17\/06\/2022 SceneOff TOOTS100TRIBUTE double concert Basilique Koekelberg:\r\nYOUNG TOOTS COLLECTIVE & WHAT A WONDERFUL TOOTS","longdescr":"20:00 Concert du \"Young Toots Collective\" Retour aux sources de Toots ! \r\nHommage aux premi\u00e8res ann\u00e9es de Toots, interpr\u00e9t\u00e9 par de jeunes musiciens, \u00e9tudiants du Conservatoire royal de Bruxelles.\r\nOlivier Vander Bauwede : harmonica ; Marco Marcelletti : piano ; Yuxiang Zhang : guitare ; Mehrad Hezarkhani : basse ; Victor Khaddaj : batterie.\r\nConcert de \"What A Wonderful Toots\" (WAWT), quatre musiciens qui emm\u00e8nent le public dans un voyage musical plein de chaleur, d'\u00e9motion et de virtuosit\u00e9. Ils partagent leurs exp\u00e9riences, leur passion pour la musique et leur \u00e9norme respect pour le regrett\u00e9 Toots Thielemans. Le lyrisme et la musicalit\u00e9 qui caract\u00e9risaient Toots, mais aussi sa personnalit\u00e9 chaleureuse, son appr\u00e9ciation et ses bons conseils \u00e0 tous les musiciens qui croisaient son chemin, faisaient de lui la personne que tout le monde aimait. Les quatre musiciens rendent hommage \u00e0 Toots en tant que guitariste, harmoniciste et compositeur d'un grand nombre de musiques m\u00e9morables et intemporelles.\r\nLe groupe est compos\u00e9 de :\r\nEric Melaerts (guitare) : Musicien de session\/producteur exp\u00e9riment\u00e9 qui a enregistr\u00e9 des productions t\u00e9l\u00e9vis\u00e9es et des albums avec et pour Toots. \r\nBart De Nolf, ic\u00f4ne du jazz belge \u00e0 la contrebasse. Il a \u00e9t\u00e9 l'accompagnateur de Toots pendant 17 ans. \r\nBruno Castellucci, l'un de nos meilleurs batteurs de jazz, sur lequel Toots pouvait toujours compter. Il a \u00e9t\u00e9 son \"compagnon de route\" pendant plus de 42 ans.\r\nPatrick Deltenre (guitare\/harmonica) est un excellent guitariste soulful. En plus de cela, il joue de l'harmonica chromatique depuis 10 ans et il poss\u00e8de la puissance m\u00e9lancolique de cet instrument.","performers":"20:00 \"YOUNG TOOTS COLLECTIVE\" \r\nOlivier Vander Bauwede: harmonica; Marco Marcelletti: piano; Yuxiang Zhang: guitare; Mehrad Hezarkhani: basse; Victor Khaddaj: batterie.\r\n+ \"WHAT A WONDERFUL TOOTS\" \r\nEric Melaerts: guitare; Bart De Nolf: contrebasse; Bruno Castellucci:batterie; Patrick Deltenre: guitare, harmonica","boxoffice_url":null,"website":"http:\/\/sceneoff.com","email":"henri@sceneoff.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/533499.html"},"nl":{"name":"SceneOff TOOTS100TRIBUTE concert","shortdescr":"17\/06\/2022 SceneOff TOOTS100TRIBUTE dubbelconcert Basiliek Koekelberg:\r\nYOUNG TOOTS COLLECTIVE & WHAT A WONDERFUL TOOTS","longdescr":"20:00 Concert by \u201cYoung Toots Collective\u201d Back to the roots of Toots! \r\nTribute to Toots\u2019 early years, performed by young musicians, students at Brussels Royal Conservatoire\r\nOlivier Vander Bauwede: mondharmonica; Marco Marcelletti: piano; Yuxiang Zhang: gitaar; Mehrad Hezarkhani: bas; Victor Khaddaj: drums\r\nConcert by \u201cWhat A Wonderful Toots\u201d (WAWT) zijn vier muzikanten die het publiek meenemen voor een muzikale reis vol warmte, emotie en virtuositeit. Ze delen hun ervaringen, passie voor muziek en enorm respect voor Toots Thielemans zaliger. De lyriek en muzikaliteit die Toots typeerde, maar ook zijn warme persoonlijkheid, zijn waardering voor, en goede raad aan elke muzikant die zijn pad kruiste, maakte hem tot de persoon van wie iedereen hield. De vier muzikanten brengen een ode aan Toots als gitarist, mondharmonicaspeler en componist van heel wat memorabele en tijdloze muziek.\r\nDe Band bestaat uit:\r\nEric Melaerts (gitaar): Ervaren sessiemuzikant\/producer die, met en voor Toots, TV producties en albums heeft opgenomen. \r\nBart De Nolf, Belgisch Jazzicoon op de contrabas. Hij was gedurende 17 jaar vaste begeleider van Toots. \r\nBruno Castellucci, een van onze beste Jazz-drummers waarop Toots altijd kon rekenen. Hij was meer dan 42 jaar zijn  \u201ccompagnon de route\u201d .\r\nPatrick Deltenre (gitaar\/harmonica) is een uitstekend soulful gitarist. Hij speelt daar bovenop al 10 jaar chromatische mondharmonica en heeft de melancholische kracht van dat instrument in zich.","performers":"20:00 \u201cYOOUNG TOOTS COLLECTIVE\u201d \r\nOlivier Vander Bauwede: mondharmonica; Marco Marcelletti: piano; Yuxiang Zhang: gitaar; Mehrad Hezarkhani: bas; Victor Khaddaj: drums\r\n+ \u201cWHAT A WONDERFUL TOOTS\u201d  \r\nEric Melaerts: gitaar; Bart De Nolf: contrabas; Bruno Castellucci: drums; Patrick Deltenre: gitaar\/harmonica","boxoffice_url":null,"website":"http:\/\/sceneoff.com","email":"henri@sceneoff.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/533499.html"},"en":{"name":"SceneOff TOOTS100TRIBUTE concert","shortdescr":"17\/06\/2022 SceneOff TOOTS100TRIBUTE dubbelconcert Basilica Koekelberg:\r\nYOUNG TOOTS COLLECTIVE & WHAT A WONDERFUL TOOTS","longdescr":"20:00 Concert by \"Young Toots Collective\" Back to the roots of Toots! \r\nTribute to Toots' early years, performed by young musicians, students at Brussels Royal Conservatoire\r\nOlivier Vander Bauwede: harmonica; Marco Marcelletti: piano; Yuxiang Zhang: guitar; Mehrad Hezarkhani: bass; Victor Khaddaj: drums\r\nConcert by \"What A Wonderful Toots\" (WAWT) are four musicians who take the audience on a musical journey full of warmth, emotion and virtuosity. They share their experiences, passion for music and enormous respect for the late Toots Thielemans. The lyricism and musicality that typified Toots, but also his warm personality, his appreciation for and good advice to every musician who crossed his path, made him the person everyone loved. The four musicians pay tribute to Toots as a guitarist, harmonica player and composer of a lot of memorable and timeless music.\r\nThe Band consists of:\r\nEric Melaerts (guitar): Experienced session musician\/producer who has recorded TV productions and albums with and for Toots. \r\nBart De Nolf, Belgian jazz icon on double bass. He was Toots' accompanist for 17 years. \r\nBruno Castellucci, one of our best Jazz-drummers whom Toots could always count on. He was his \"compagnon de route\" for more than 42 years.\r\nPatrick Deltenre (guitar\/harmonica) is an excellent soulful guitarist. On top of that, he has been playing chromatic harmonica for 10 years and he has the melancholic power of that instrument.","performers":"20:00 \"YYOUNG TOOTS COLLECTIVE\"\r\nOlivier Vander Bauwede: harmonica; Marco Marcelletti: piano; Yuxiang Zhang: guitar; Mehrad Hezarkhani: bass; Victor Khaddaj: drums\r\n+ \"WHAT A WONDERFUL TOOTS\"\r\nEric Melaerts: guitar; Bart De Nolf: double bass; Bruno Castellucci: drums; Patrick Deltenre: guitar, harmonica","boxoffice_url":null,"website":"http:\/\/sceneoff.com","email":"henri@sceneoff.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/533499.html"},"de":{"name":"SceneOff TOOTS100TRIBUTE concert","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/533499.html"},"it":{"name":"SceneOff TOOTS100TRIBUTE concert","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_b