se,"is_not_major_event":false,"backoffice_id":308969,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"other","ranking":0.37475617678431544,"languages":{"spoken":["it","nl","es","de","fr","en"],"subtitles":[]},"categories":{"main":{"id":90,"translations":{"de":"Animationen","pt":null,"en":"Animations","it":"Animazioni","cn":null,"fr":"Animations","sp":"Animaciones","nl":"Animaties"}},"others":{}},"translations":{"de":{"name":"Christmas fairies The Secret Kingdom","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.christmasfairiesbxl.com\/","email":"sales@roydespagne.be","phone_contact":"+32 2 513 08 07","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700002102"},"pt":{"name":"Christmas fairies The Secret Kingdom","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.christmasfairiesbxl.com\/","email":"sales@roydespagne.be","phone_contact":"+32 2 513 08 07","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700002102"},"en":{"name":"Christmas fairies The Secret Kingdom","shortdescr":"Les Plaisirs d'Hiver is one of the finest Christmas Markets around, but this year \u2018Le Roy d'Espagne\u2019 is going beyond expectations by transforming its hidden spaces into a veritable Kingdom of Santa Claus. Visitors, young and old, will have the opportunity to enjoy a unique experience as they explore the restaurant's secret corners, discovering enchanted surprises at every turn. ","longdescr":"A unique experience for ALL\nLes Plaisirs d'Hiver is one of the finest Christmas Markets around, but this year \u2018Le Roy d'Espagne\u2019 is going beyond expectations by transforming its hidden spaces into a veritable Kingdom of Santa Claus. Visitors, young and old, will have the opportunity to enjoy a unique experience as they explore the restaurant's secret corners, discovering enchanted surprises at every turn. \nThe beautifully decorated rooms immerse us in the enchanted, gradual journey to Santa's Land, symbolizing a deeper and deeper immersion in the magic of Christmas. \nEach stage of the tour represents a part of this journey, with specific settings and atmospheres that reinforce the impression of stepping away from the ordinary world and into a fairytale universe.\nEntrance :  45 rue au Beurre 1000 Bruxelles\nWithout reservation for the public from 29\/11\/2024 to 05\/01\/2025 from 12:00 to 22:00\nGroup reservation : sales@roydespagne.be\n","performers":"A journey into the magical world of Father Christmas","boxoffice_url":null,"website":"https:\/\/www.christmasfairiesbxl.com\/","email":"sales@roydespagne.be","phone_contact":"+32 2 513 08 07","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700002102"},"it":{"name":"Christmas fairies The Secret Kingdom","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.christmasfairiesbxl.com\/","email":"sales@roydespagne.be","phone_contact":"+32 2 513 08 07","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700002102"},"cn":{"name":"Christmas fairies The Secret Kingdom","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.christmasfairiesbxl.com\/","email":"sales@roydespagne.be","phone_contact":"+32 2 513 08 07","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700002102"},"fr":{"name":"Christmas fairies  The Secret Kingdom","shortdescr":"Les Plaisirs d'Hiver est l'un des plus beaux march\u00e9s de No\u00ebl, mais cette ann\u00e9e, \u00ab Le Roy d'Espagne \u00bb va d\u00e9passer toutes les attentes en transformant ses espaces cach\u00e9s en un v\u00e9ritable Royaume du P\u00e8re No\u00ebl. Les visiteurs, petits et grands, auront l'occasion de vivre une exp\u00e9rience unique en explorant les recoins secrets du restaurant et en d\u00e9couvrant des surprises enchant\u00e9es \u00e0 chaque d\u00e9tour.","longdescr":"Une exp\u00e9rience unique pour TOUS\nLes Plaisirs d'Hiver est l'un des plus beaux march\u00e9s de No\u00ebl, mais cette ann\u00e9e, \u00ab Le Roy d'Espagne \u00bb va d\u00e9passer toutes les attentes en transformant ses espaces cach\u00e9s en un v\u00e9ritable Royaume du P\u00e8re No\u00ebl. Les visiteurs, petits et grands, auront l'occasion de vivre une exp\u00e9rience unique en explorant les recoins secrets du restaurant et en d\u00e9couvrant des surprises enchant\u00e9es \u00e0 chaque d\u00e9tour.\nLes salles magnifiquement d\u00e9cor\u00e9es nous plongent dans un voyage enchant\u00e9 et progressif vers le Pays du P\u00e8re No\u00ebl, symbolisant une immersion de plus en plus profonde dans la magie de No\u00ebl.\nChaque \u00e9tape de la visite repr\u00e9sente une partie de ce voyage, avec des d\u00e9cors et des ambiances sp\u00e9cifiques qui renforcent l'impression de quitter le monde ordinaire pour entrer dans un univers f\u00e9erique.\nAdresse : 45 rue au Beurre, 1000 Bruxelles\nSans r\u00e9servation pour le public  du 29\/11\/2024 au 05\/01\/2025 de 12h00 \u00e0 22h00\nR\u00e9servation de groupes : sales@roydespagne.be\n\n","performers":"Un voyage dans le monde magique du P\u00e8re No\u00ebl","boxoffice_url":null,"website":"https:\/\/www.christmasfairiesbxl.com\/","email":"sales@roydespagne.be","phone_contact":"+32 2 513 08 07","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700002102"},"sp":{"name":"Christmas fairies The Secret Kingdom","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.christmasfairiesbxl.com\/","email":"sales@roydespagne.be","phone_contact":"+32 2 513 08 07","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700002102"},"nl":{"name":"Christmas fairies  The Secret Kingdom","shortdescr":"Plaisirs d'Hiver is een van de mooiste kerstmarkten,maar dit jaar gaat \"Le Roy d'Espagne\" alle verwachtingen overtreffen door zijn verborgen ruimtes om te toveren tot een echt Koninkrijk van de Kerstman. Bezoekers, jong en oud, zullen de kans krijgen om van een unieke ervaring te genieten terwijl ze de geheime hoekjes van het restaurant verkennen en op elke hoek betoverende verrassingen ontdekken.","longdescr":"Een unieke ervaring voor IEDEREEN\nPlaisirs d'Hiver is een van de mooiste kerstmarkten, maar dit jaar gaat \"Le Roy d'Espagne\" alle verwachtingen overtreffen door zijn verborgen ruimtes om te toveren tot een echt Koninkrijk van de Kerstman. Bezoekers, jong en oud, zullen de kans krijgen om van een unieke ervaring te genieten terwijl ze de geheime hoekjes van het restaurant verkennen en op elke hoek betoverende verrassingen ontdekken.\nDe prachtig versierde kamers nemen ons mee op een magische, geleidelijke reis naar het Land van de Kerstman, wat symbool staat voor een steeds diepere onderdompeling in de magie van Kerstmis.\nElke fase van de tour vertegenwoordigt een deel van deze reis, met specifieke decors en sferen die de indruk versterken dat men de gewone wereld verlaat en een sprookjesuniversum betreedt.\nAdres: 45 rue au Beurre, 1000 Brussel\nZonder reservering voor het publiek van 29\/11\/2024 tot 05\/01\/2025 van 12:00 tot 22:00.\nGroepsreservering: sales@roydespagne.be\n","performers":"Een reis door de magische wereld van de kerstman","boxoffice_url":null,"website":"https:\/\/www.christmasfairiesbxl.com\/","email":"sales@roydespagne.be","phone_contact":"+32 2 513 08 07","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700002102"}},"place":{"id":3743,"translations":{"de":{"name":"Grand-Place","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"Der Grand-Place in Br\u00fcssel z\u00e4hlt zum UNESCO-Weltkulturerbe und gilt als einer der sch\u00f6nsten Pl\u00e4tze der Welt.\r\n\r\nArchitektonische Perlen: Hier l\u00e4sst sich eine \u00e4u\u00dferst gelungene Mischung verschiedener architektonischer Stilrichtungen bewundern, charakteristisch f\u00fcr die Kultur und die Gesellschaft einer wohlhabenden, nordeurop\u00e4ischen Stadt. Eingerahmt wird der Grand-Place von majest\u00e4tischen Zunfth\u00e4usern, die \u00fcberwiegend aus dem 17. Jahrhundert stammen. Das Rathaus von Br\u00fcssel, das Anfang des 15. Jahrhunderts (1402) erbaut wurde, dominiert das architektonische Gesamtbild.\r\n\r\nSpektakul\u00e4re Veranstaltungen auf dem Grand-Place: Der Grand-Place wird regelm\u00e4\u00dfig Schauplatz verschiedener Gro\u00dfereignisse, darunter das mittelalterliche Spektakel Ommegang und der ber\u00fchmte Blumenteppich, bei dem der gesamte Platz mit einem riesigen Blumenmeer ausgelegt wird\r\n\r\nSie befinden sich \u00fcbrigens in bester Gesellschaft, denn schon Schriftsteller wie Baudelaire und Victor Hugo und sogar Karl Marx verfielen dem Charme des Grand-Place. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Grand-Place","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"Classificada como Patrim\u00f3nio Mundial da Unesco, a Grand-Place come\u00e7a a construir-se no s\u00e9culo XV: de in\u00edcio, os sal\u00f5es de algumas sedes de guildas, e, depois, a C\u00e2mara Municipal como sede da autoridade deste local de com\u00e9rcio. Bombardeada durante 3 dias pelas tropas francesas em 1695, fica quase totalmente destru\u00edda, mas, tal como uma f\u00e9nix, renascer\u00e1 das suas cinzas em menos de 5 anos. Por este motivo, quatro estilos coexistem e, por vezes, at\u00e9 se sobrep\u00f5em; \u00e9 uma esp\u00e9cie de mistura de g\u00f3tico, de barroco opulento, de neocl\u00e1ssico e de neog\u00f3tico. A torre da C\u00e2mara Municipal mede, mais ou menos, 96 metros de altura.\r\n\r\nUm local hist\u00f3rico\r\n\r\nLocal hist\u00f3rico, a Grand-Place assistiu ao desenvolvimento de acontecimentos felizes e tr\u00e1gicos:\r\n\r\nEm 1523, os primeiros m\u00e1rtires protestantes, Henri Voes e Jean Van Eschen, foram a\u00ed queimados pela Inquisi\u00e7\u00e3o.\r\nEm 1568, os condes de Egmont e de Hornes foram a\u00ed decapitados.\r\nEm agosto de 1695, durante a Guerra da Liga de Augsburgo, a maior parte das casas que rodeavam a Grand-Place, algumas das quais ainda conservavam a sua constru\u00e7\u00e3o de madeira, foram destru\u00eddas durante o bombardeamento da cidade pelas tropas francesas dirigidas pelo marechal de Villeroy. Apenas a fachada e a torre da C\u00e2mara Municipal, que servia de alvo para os artilheiros, e algumas paredes de pedra resistiram \u00e0s balas de canh\u00e3o. As casas que rodeavam a pra\u00e7a foram rapidamente reconstru\u00eddas, desta feita, usando pedra, pelas diferentes guildas. De entre elas, a sede da guilda dos Cervejeiros que hoje acolhe o Museu os Cervejeiros.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Grand-Place","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Grand-Place","address_line2":"1000 Brussels","description_web":"Often considered the most beautiful square in the world, the Grand-Place of Brussels' reputation precedes it!  \r\n \r\nToday, it still has a political and administrative function as it houses the City of Brussels Town Hall, which remains the workplace of the mayor and most of their aldermen.  \r\n \r\nAs a prestigious venue, it hosts many festive events - concerts, fairs, folklore events, the Christmas tree and nativity scene, sound and light shows, the flower carpet in the summer, etc. - or symbolic events, such as the celebration of sportsmen and women after fine performances.  \r\n \r\nIts story began as a market square in the 12th century. Gradually, the square was filled with houses and halls, then primarily made of wood. The splendid Gothic town hall was built in the 15th century in three phases; the same 15th century saw the installation of trade guilds in the houses that border the Grand-Place. Even more so than at present, the square was the nerve centre of Brussels life: economically, as already mentioned, with intense sales activity (several halls devoted to the sale of bread - the present King's House or Broodhuis in Dutch -, meat, linen, etc.), culturally (theatrical performances), judicially (with executions taking place on the square) and, of course, local politics.  \r\n \r\nIt was bombarded by Louis XIV's troops in 1695 and was subsequently almost entirely rebuilt. It underwent further major renovations and modifications during the following centuries, especially in the 19th century, which gave it its current appearance.  \r\n \r\nThe Grand-Place of Brussels has been a UNESCO World Heritage Site since 1998. \r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Grand-Place","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"La costruzione della Grand-Place, sito che rientra nella lista dei Patrimoni Mondiali dell'Unesco, inizia nel Quindicesimo secolo; dapprima qualche mercato coperto, le case delle corporazioni, poi l'H\u00f4tel de Ville per rilanciare l'autorit\u00e0 di questo sito commerciale. Bombardata per 3 giorni dall'esercito francese nel 1695, la piazza fu quasi completamente distrutta, ma, come una fenice, rinascer\u00e0 dalle proprie ceneri in meno di 5 anni. Ecco perch\u00e9 sono quattro gli stili che si affiancano e, a volte, si sovrappongono; notiamo una miscela di gotico, opulento barocco, neoclassico e neogotico. La torre dell'H\u00f4tel de Ville \u00e8 alta circa 96 metri.\r\n\r\nUn luogo storico\r\n\r\nLuogo storico, la Grand-Place \u00e8 stata teatro di molti eventi, sia lieti che tragici:\r\n\r\nNel 1523, i primi martiri protestanti, Henri Voes e Jean Van Eschen, vengono bruciati vivi dall'Inquisizione proprio nella Piazza,\r\n1568, i conti di Egmont e Hornes vengono decapitati.\r\nAgosto 1695, nel corso della Guerra della Grande Alleanza, la maggior parte delle case che si affacciano sulla Grand-Place, delle quali alcune sono ancora in legno, vengono distrutte dal bombardamento della citt\u00e0 ad opera delle truppe francesi guidate dal maresciallo di Villeroy. Solamente la facciata e la torre dell'H\u00f4tel de Ville, che fungeva da bersaglio per l'artiglieria, e qualche muro di pietra resistono alle bombe incendiarie. Le case che davano sulla piazza vengono ricostruite rapidamente dalle varie corporazioni che, a questo punto, scelgono come materiale la pietra. Tra esse, spicca la casa della corporazione dei Birrai che oggi accoglie il Mus\u00e9e des Brasseurs (Museo della Birra).\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Grand-Place","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Grand-Place","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"Souvent consid\u00e9r\u00e9e comme la plus belle du monde, la r\u00e9putation de la Grand-Place de Bruxelles n\u2019est plus \u00e0 \u00e9tablir !  \r\n \r\nAujourd\u2019hui encore, elle conserve une fonction politico-administrative en accueillant l\u2019H\u00f4tel de Ville de Bruxelles, qui demeure le lieu de travail du bourgmestre et de la plupart des \u00e9chevins.  \r\n \r\nEn tant que lieu de prestige, elle h\u00e9berge de nombreux \u00e9v\u00e9nements festifs \u2014 concerts, foires, manifestations folkloriques, sapin et cr\u00e8che de No\u00ebl, son et lumi\u00e8re, tapis de fleurs en \u00e9t\u00e9, etc. \u2014 ou symboliques, comme par ex. la r\u00e9ception de sportifs suite \u00e0 leurs performances.  \r\n \r\nSon histoire commence en tant que lieu de march\u00e9 au 12e si\u00e8cle. Progressivement, la place se garnit de maisons et de halles, encore principalement en bois. Le splendide H\u00f4tel de Ville gothique est construit au 15e si\u00e8cle en trois phases ; ce m\u00eame 15e si\u00e8cle voit l\u2019installation des corporations de m\u00e9tiers dans les maisons bordant la Grand-Place. Plus encore qu\u2019actuellement, la place est le centre n\u00e9vralgique de la vie bruxelloise : sur le plan \u00e9conomique donc, comme d\u00e9j\u00e0 mentionn\u00e9, avec une intense activit\u00e9 de vente (plusieurs halles consacr\u00e9es \u00e0 la vente du pain \u2014 actuelle Maison du Roi ou Broodhuis en n\u00e9erlandais \u2014, de la viande, des draps, etc.), sur le plan culturel (repr\u00e9sentations th\u00e9\u00e2trales), sur le plan judiciaire (avec des ex\u00e9cutions qui ont lieu sur la place), et \u00e9videmment sur le plan de la politique locale.  \r\n \r\nSujette \u00e0 un bombardement par les troupes de Louis XIV en 1695, elle est presque enti\u00e8rement reconstruite \u00e0 cette occasion. Elle subit encore d\u2019importantes r\u00e9novations et modifications durant les si\u00e8cles suivants, et ce surtout au 19e si\u00e8cle, pour lui conf\u00e9rer son aspect actuel.  \r\n \r\nLa Grand-Place de Bruxelles est inscrite sur la liste du patrimoine mondial de l\u2019UNESCO depuis 1998. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Grand-Place","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"Inscrita en la lista del Patrimonio Mundial de la UNESCO, la Grand Place comienza a construirse en el siglo XV. Primeramente, se erigen el mercado y algunas casas gremiales; despu\u00e9s, un Ayuntamiento con el que asentar la autoridad de dicho espacio de comercio. V\u00edctima del bombardeo perpetrado por el Ej\u00e9rcito franc\u00e9s durante 3 d\u00edas en 1695, la plaza queda pr\u00e1cticamente destruida pero, como si de un f\u00e9nix se tratase, resurgir\u00e1 de sus cenizas en menos de 5 a\u00f1os. Esa es la raz\u00f3n subyacente en el eclecticismo de la plaza: en ella, cuatro estilos conviven e incluso se superponen en ocasiones: g\u00f3tico, barroco opulento, neocl\u00e1sico y neog\u00f3tico. La torre del Ayuntamiento tiene una altitud aproximada de 96 metros.\r\n\r\nUn emplazamiento hist\u00f3rico\r\n\r\nLugar hist\u00f3rico, la Grand Place ha asistido a numerosos acontecimientos tanto alegres como tr\u00e1gicos:\r\n\r\nen 1523, los primeros m\u00e1rtires protestantes, Henri Voes y Jean Van Eschen, son quemados a manos de la Inquisici\u00f3n,\r\nen 1568, los condes de Egmont y de Hornes son decapitados.\r\nEn agosto de 1695, durante la Guerra de la Liga de Augsburgo, la mayor\u00eda de casas aleda\u00f1as a la Grand Place, algunas de ellas construidas a\u00fan en madera, son arrasadas durante el bombardeo de la ciudad a manos de las tropas francesas dirigidas por el mariscal de Villeroy. \u00danicamente la fachada y la torre del Ayuntamiento, que serv\u00eda de objetivo a los artilleros, as\u00ed como ciertos muros en piedra, resisten a las bolas incendiarias. Varios gremios se encargan de la r\u00e1pida reconstrucci\u00f3n de las casas que enmarcan la plaza, esta vez, en piedra. Entre ellas, se encuentra la casa gremial de los maestros cerveceros, que alberga hoy el Mus\u00e9e des Brasseurs (Museo de los Maestros Cerveceros).\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Grote Markt","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Grote Markt","address_line2":"1000 Brussel","description_web":"De Brusselse Grote Markt, die te boek staat als een van de mooiste pleinen ter wereld, is een must-see op het toeristische trekpleisterlijstje.  \r\n \r\nDoor de aanwezigheid van het stadhuis van Brussel heeft het plein ook nog steeds een politieke en administratieve functie: de burgemeester en de meeste schepenen werken hier.  \r\n\r\nHet is ook een plek die aanzien uitstraalt. Getuige daarvan zijn de vele plechtige, feestelijke of symbolische evenementen die er plaatsvinden: concerten, braderie\u00ebn, volksfeesten, de jaarlijkse kerstboom en -kribbe, klank- en lichtspelen, het bloementapijt in de zomer en de huldiging van sporters na een uitzonderlijke prestatie (denk bijvoorbeeld aan het WK voetbal in 2018). \r\n\r\nDe geschiedenis van de Grote Markt als 'marktplaats' gaat terug tot de twaalfde eeuw. Na verloop van tijd werden rondom het plein huizen en hallen opgetrokken, voornamelijk van hout. De bouw van het prachtige gotische stadhuis in de vijftiende eeuw verliep in drie fasen. Vanaf die periode zouden ook de gildehuizen het uitzicht van de Grote Markt mee bepalen. Meer nog dan vandaag was de Grote Markt in die tijd het kloppende hart van de stad, op economisch, cultureel en gerechtelijk vlak. Zo werd er duchtig handel gedreven (in de hallen gingen brood \u2013 het huidige Broodhuis \u2013 vlees, stoffen enzovoort over de toonbank), kon je op het plein theatervoorstellingen bijwonen en vonden er openbare terechtstellingen plaats. Het was uiteraard ook de plek waar het lokale beleid werd uitgetekend. \r\n\r\nNa een bombardement door de troepen van Lodewijk XIV in 1695 werd de Grote Markt zo goed als volledig heropgebouwd. Tijdens de eeuwen daarna ondergingen nog heel wat gebouwen grootschalige renovaties en aanpassingen. Vooral in de negentiende eeuw werd het plein in zijn huidige gedaante vastgelegd. \r\n\r\nDe Grote Markt van Brussel staat sinds 1998 op de Werelderfgoedlijst van de Unesco. \r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[13],"translations":{"de":["Historisches Stadtzentrum"],"pt":[null],"en":["Historical Centre"],"it":["Centro storico"],"cn":[null],"fr":["Centre historique"],"sp":["Centro hist\u00f3rico"],"nl":["Historisch centrum"]}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":null,"facebook_id":null,"backoffice_id":266,"location":{"lat":50.84644089,"lon":4.35147641},"region":"brussels","last_updated_at":"2023-08-14T16:33:08+02:00","published_at":"2013-10-19T01:13:24+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":false,"resto_ranking":0},"organizer":{"id":3743,"translations":{"de":{"name":"Grand-Place","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"Der Grand-Place in Br\u00fcssel z\u00e4hlt zum UNESCO-Weltkulturerbe und gilt als einer der sch\u00f6nsten Pl\u00e4tze der Welt.\r\n\r\nArchitektonische Perlen: Hier l\u00e4sst sich eine \u00e4u\u00dferst gelungene Mischung verschiedener architektonischer Stilrichtungen bewundern, charakteristisch f\u00fcr die Kultur und die Gesellschaft einer wohlhabenden, nordeurop\u00e4ischen Stadt. Eingerahmt wird der Grand-Place von majest\u00e4tischen Zunfth\u00e4usern, die \u00fcberwiegend aus dem 17. Jahrhundert stammen. Das Rathaus von Br\u00fcssel, das Anfang des 15. Jahrhunderts (1402) erbaut wurde, dominiert das architektonische Gesamtbild.\r\n\r\nSpektakul\u00e4re Veranstaltungen auf dem Grand-Place: Der Grand-Place wird regelm\u00e4\u00dfig Schauplatz verschiedener Gro\u00dfereignisse, darunter das mittelalterliche Spektakel Ommegang und der ber\u00fchmte Blumenteppich, bei dem der gesamte Platz mit einem riesigen Blumenmeer ausgelegt wird\r\n\r\nSie befinden sich \u00fcbrigens in bester Gesellschaft, denn schon Schriftsteller wie Baudelaire und Victor Hugo und sogar Karl Marx verfielen dem Charme des Grand-Place. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Grand-Place","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"Classificada como Patrim\u00f3nio Mundial da Unesco, a Grand-Place come\u00e7a a construir-se no s\u00e9culo XV: de in\u00edcio, os sal\u00f5es de algumas sedes de guildas, e, depois, a C\u00e2mara Municipal como sede da autoridade deste local de com\u00e9rcio. Bombardeada durante 3 dias pelas tropas francesas em 1695, fica quase totalmente destru\u00edda, mas, tal como uma f\u00e9nix, renascer\u00e1 das suas cinzas em menos de 5 anos. Por este motivo, quatro estilos coexistem e, por vezes, at\u00e9 se sobrep\u00f5em; \u00e9 uma esp\u00e9cie de mistura de g\u00f3tico, de barroco opulento, de neocl\u00e1ssico e de neog\u00f3tico. A torre da C\u00e2mara Municipal mede, mais ou menos, 96 metros de altura.\r\n\r\nUm local hist\u00f3rico\r\n\r\nLocal hist\u00f3rico, a Grand-Place assistiu ao desenvolvimento de acontecimentos felizes e tr\u00e1gicos:\r\n\r\nEm 1523, os primeiros m\u00e1rtires protestantes, Henri Voes e Jean Van Eschen, foram a\u00ed queimados pela Inquisi\u00e7\u00e3o.\r\nEm 1568, os condes de Egmont e de Hornes foram a\u00ed decapitados.\r\nEm agosto de 1695, durante a Guerra da Liga de Augsburgo, a maior parte das casas que rodeavam a Grand-Place, algumas das quais ainda conservavam a sua constru\u00e7\u00e3o de madeira, foram destru\u00eddas durante o bombardeamento da cidade pelas tropas francesas dirigidas pelo marechal de Villeroy. Apenas a fachada e a torre da C\u00e2mara Municipal, que servia de alvo para os artilheiros, e algumas paredes de pedra resistiram \u00e0s balas de canh\u00e3o. As casas que rodeavam a pra\u00e7a foram rapidamente reconstru\u00eddas, desta feita, usando pedra, pelas diferentes guildas. De entre elas, a sede da guilda dos Cervejeiros que hoje acolhe o Museu os Cervejeiros.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Grand-Place","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Grand-Place","address_line2":"1000 Brussels","description_web":"Often considered the most beautiful square in the world, the Grand-Place of Brussels' reputation precedes it!  \r\n \r\nToday, it still has a political and administrative function as it houses the City of Brussels Town Hall, which remains the workplace of the mayor and most of their aldermen.  \r\n \r\nAs a prestigious venue, it hosts many festive events - concerts, fairs, folklore events, the Christmas tree and nativity scene, sound and light shows, the flower carpet in the summer, etc. - or symbolic events, such as the celebration of sportsmen and women after fine performances.  \r\n \r\nIts story began as a market square in the 12th century. Gradually, the square was filled with houses and halls, then primarily made of wood. The splendid Gothic town hall was built in the 15th century in three phases; the same 15th century saw the installation of trade guilds in the houses that border the Grand-Place. Even more so than at present, the square was the nerve centre of Brussels life: economically, as already mentioned, with intense sales activity (several halls devoted to the sale of bread - the present King's House or Broodhuis in Dutch -, meat, linen, etc.), culturally (theatrical performances), judicially (with executions taking place on the square) and, of course, local politics.  \r\n \r\nIt was bombarded by Louis XIV's troops in 1695 and was subsequently almost entirely rebuilt. It underwent further major renovations and modifications during the following centuries, especially in the 19th century, which gave it its current appearance.  \r\n \r\nThe Grand-Place of Brussels has been a UNESCO World Heritage Site since 1998. \r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Grand-Place","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"La costruzione della Grand-Place, sito che rientra nella lista dei Patrimoni Mondiali dell'Unesco, inizia nel Quindicesimo secolo; dapprima qualche mercato coperto, le case delle corporazioni, poi l'H\u00f4tel de Ville per rilanciare l'autorit\u00e0 di questo sito commerciale. Bombardata per 3 giorni dall'esercito francese nel 1695, la piazza fu quasi completamente distrutta, ma, come una fenice, rinascer\u00e0 dalle proprie ceneri in meno di 5 anni. Ecco perch\u00e9 sono quattro gli stili che si affiancano e, a volte, si sovrappongono; notiamo una miscela di gotico, opulento barocco, neoclassico e neogotico. La torre dell'H\u00f4tel de Ville \u00e8 alta circa 96 metri.\r\n\r\nUn luogo storico\r\n\r\nLuogo storico, la Grand-Place \u00e8 stata teatro di molti eventi, sia lieti che tragici:\r\n\r\nNel 1523, i primi martiri protestanti, Henri Voes e Jean Van Eschen, vengono bruciati vivi dall'Inquisizione proprio nella Piazza,\r\n1568, i conti di Egmont e Hornes vengono decapitati.\r\nAgosto 1695, nel corso della Guerra della Grande Alleanza, la maggior parte delle case che si affacciano sulla Grand-Place, delle quali alcune sono ancora in legno, vengono distrutte dal bombardamento della citt\u00e0 ad opera delle truppe francesi guidate dal maresciallo di Villeroy. Solamente la facciata e la torre dell'H\u00f4tel de Ville, che fungeva da bersaglio per l'artiglieria, e qualche muro di pietra resistono alle bombe incendiarie. Le case che davano sulla piazza vengono ricostruite rapidamente dalle varie corporazioni che, a questo punto, scelgono come materiale la pietra. Tra esse, spicca la casa della corporazione dei Birrai che oggi accoglie il Mus\u00e9e des Brasseurs (Museo della Birra).\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Grand-Place","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Grand-Place","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"Souvent consid\u00e9r\u00e9e comme la plus belle du monde, la r\u00e9putation de la Grand-Place de Bruxelles n\u2019est plus \u00e0 \u00e9tablir !  \r\n \r\nAujourd\u2019hui encore, elle conserve une fonction politico-administrative en accueillant l\u2019H\u00f4tel de Ville de Bruxelles, qui demeure le lieu de travail du bourgmestre et de la plupart des \u00e9chevins.  \r\n \r\nEn tant que lieu de prestige, elle h\u00e9berge de nombreux \u00e9v\u00e9nements festifs \u2014 concerts, foires, manifestations folkloriques, sapin et cr\u00e8che de No\u00ebl, son et lumi\u00e8re, tapis de fleurs en \u00e9t\u00e9, etc. \u2014 ou symboliques, comme par ex. la r\u00e9ception de sportifs suite \u00e0 leurs performances.  \r\n \r\nSon histoire commence en tant que lieu de march\u00e9 au 12e si\u00e8cle. Progressivement, la place se garnit de maisons et de halles, encore principalement en bois. Le splendide H\u00f4tel de Ville gothique est construit au 15e si\u00e8cle en trois phases ; ce m\u00eame 15e si\u00e8cle voit l\u2019installation des corporations de m\u00e9tiers dans les maisons bordant la Grand-Place. Plus encore qu\u2019actuellement, la place est le centre n\u00e9vralgique de la vie bruxelloise : sur le plan \u00e9conomique donc, comme d\u00e9j\u00e0 mentionn\u00e9, avec une intense activit\u00e9 de vente (plusieurs halles consacr\u00e9es \u00e0 la vente du pain \u2014 actuelle Maison du Roi ou Broodhuis en n\u00e9erlandais \u2014, de la viande, des draps, etc.), sur le plan culturel (repr\u00e9sentations th\u00e9\u00e2trales), sur le plan judiciaire (avec des ex\u00e9cutions qui ont lieu sur la place), et \u00e9videmment sur le plan de la politique locale.  \r\n \r\nSujette \u00e0 un bombardement par les troupes de Louis XIV en 1695, elle est presque enti\u00e8rement reconstruite \u00e0 cette occasion. Elle subit encore d\u2019importantes r\u00e9novations et modifications durant les si\u00e8cles suivants, et ce surtout au 19e si\u00e8cle, pour lui conf\u00e9rer son aspect actuel.  \r\n \r\nLa Grand-Place de Bruxelles est inscrite sur la liste du patrimoine mondial de l\u2019UNESCO depuis 1998. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Grand-Place","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"Inscrita en la lista del Patrimonio Mundial de la UNESCO, la Grand Place comienza a construirse en el siglo XV. Primeramente, se erigen el mercado y algunas casas gremiales; despu\u00e9s, un Ayuntamiento con el que asentar la autoridad de dicho espacio de comercio. V\u00edctima del bombardeo perpetrado por el Ej\u00e9rcito franc\u00e9s durante 3 d\u00edas en 1695, la plaza queda pr\u00e1cticamente destruida pero, como si de un f\u00e9nix se tratase, resurgir\u00e1 de sus cenizas en menos de 5 a\u00f1os. Esa es la raz\u00f3n subyacente en el eclecticismo de la plaza: en ella, cuatro estilos conviven e incluso se superponen en ocasiones: g\u00f3tico, barroco opulento, neocl\u00e1sico y neog\u00f3tico. La torre del Ayuntamiento tiene una altitud aproximada de 96 metros.\r\n\r\nUn emplazamiento hist\u00f3rico\r\n\r\nLugar hist\u00f3rico, la Grand Place ha asistido a numerosos acontecimientos tanto alegres como tr\u00e1gicos:\r\n\r\nen 1523, los primeros m\u00e1rtires protestantes, Henri Voes y Jean Van Eschen, son quemados a manos de la Inquisici\u00f3n,\r\nen 1568, los condes de Egmont y de Hornes son decapitados.\r\nEn agosto de 1695, durante la Guerra de la Liga de Augsburgo, la mayor\u00eda de casas aleda\u00f1as a la Grand Place, algunas de ellas construidas a\u00fan en madera, son arrasadas durante el bombardeo de la ciudad a manos de las tropas francesas dirigidas por el mariscal de Villeroy. \u00danicamente la fachada y la torre del Ayuntamiento, que serv\u00eda de objetivo a los artilleros, as\u00ed como ciertos muros en piedra, resisten a las bolas incendiarias. Varios gremios se encargan de la r\u00e1pida reconstrucci\u00f3n de las casas que enmarcan la plaza, esta vez, en piedra. Entre ellas, se encuentra la casa gremial de los maestros cerveceros, que alberga hoy el Mus\u00e9e des Brasseurs (Museo de los Maestros Cerveceros).\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Grote Markt","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Grote Markt","address_line2":"1000 Brussel","description_web":"De Brusselse Grote Markt, die te boek staat als een van de mooiste pleinen ter wereld, is een must-see op het toeristische trekpleisterlijstje.  \r\n \r\nDoor de aanwezigheid van het stadhuis van Brussel heeft het plein ook nog steeds een politieke en administratieve functie: de burgemeester en de meeste schepenen werken hier.  \r\n\r\nHet is ook een plek die aanzien uitstraalt. Getuige daarvan zijn de vele plechtige, feestelijke of symbolische evenementen die er plaatsvinden: concerten, braderie\u00ebn, volksfeesten, de jaarlijkse kerstboom en -kribbe, klank- en lichtspelen, het bloementapijt in de zomer en de huldiging van sporters na een uitzonderlijke prestatie (denk bijvoorbeeld aan het WK voetbal in 2018). \r\n\r\nDe geschiedenis van de Grote Markt als 'marktplaats' gaat terug tot de twaalfde eeuw. Na verloop van tijd werden rondom het plein huizen en hallen opgetrokken, voornamelijk van hout. De bouw van het prachtige gotische stadhuis in de vijftiende eeuw verliep in drie fasen. Vanaf die periode zouden ook de gildehuizen het uitzicht van de Grote Markt mee bepalen. Meer nog dan vandaag was de Grote Markt in die tijd het kloppende hart van de stad, op economisch, cultureel en gerechtelijk vlak. Zo werd er duchtig handel gedreven (in de hallen gingen brood \u2013 het huidige Broodhuis \u2013 vlees, stoffen enzovoort over de toonbank), kon je op het plein theatervoorstellingen bijwonen en vonden er openbare terechtstellingen plaats. Het was uiteraard ook de plek waar het lokale beleid werd uitgetekend. \r\n\r\nNa een bombardement door de troepen van Lodewijk XIV in 1695 werd de Grote Markt zo goed als volledig heropgebouwd. Tijdens de eeuwen daarna ondergingen nog heel wat gebouwen grootschalige renovaties en aanpassingen. Vooral in de negentiende eeuw werd het plein in zijn huidige gedaante vastgelegd. \r\n\r\nDe Grote Markt van Brussel staat sinds 1998 op de Werelderfgoedlijst van de Unesco. \r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":266,"location":{"lat":50.84644089,"lon":4.35147641},"last_updated_at":"2023-08-14T16:33:08+02:00","published_at":"2013-10-19T01:13:24+02:00","is_in_address_book":true,"is_in_vb_export":false,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/426351b37179793fcc7e2864e82c0deb3dc30f82.jpg","width":1620,"height":1080,"ratio":1.5,"oEmbed_height":1080,"oEmbed_width":1620,"translations":{"de":{"title":"CHRISTMAS FAIRIES The Secret Kingdom","copyright":null},"pt":{"title":"CHRISTMAS FAIRIES The Secret Kingdom","copyright":null},"en":{"title":"CHRISTMAS FAIRIES The Secret Kingdom","copyright":null},"it":{"title":"CHRISTMAS FAIRIES The Secret Kingdom","copyright":null},"cn":{"title":"CHRISTMAS FAIRIES The Secret Kingdom","copyright":null},"fr":{"title":"CHRISTMAS FAIRIES The Secret Kingdom","copyright":null},"sp":{"title":"CHRISTMAS FAIRIES The Secret Kingdom","copyright":null},"nl":{"title":"CHRISTMAS FAIRIES The Secret Kingdom","copyright":null}}},{"type":"poster","link":"https:\/\/agendabrussels2.imgix.net\/0675d01d361a9eccc4c7940ddb4e4c54b9037a7b.jpg","width":1414,"height":2000,"ratio":0.71,"oEmbed_height":2000,"oEmbed_width":1414,"translations":{"de":{"title":"Christmas fairies  The Secret Kingdom","copyright":null},"pt":{"title":"Christmas fairies  The Secret Kingdom","copyright":null},"en":{"title":"Christmas fairies  The Secret Kingdom","copyright":null},"it":{"title":"Christmas fairies  The Secret Kingdom","copyright":null},"cn":{"title":"Christmas fairies  The Secret Kingdom","copyright":null},"fr":{"title":"Christmas fairies  The Secret Kingdom","copyright":null},"sp":{"title":"Christmas fairies  The Secret Kingdom","copyright":null},"nl":{"title":"Christmas fairies  The Secret Kingdom","copyright":null}}},{"type":"video","link":"https:\/\/vimeo.com\/938752195?share=copy#t=0","width":426,"height":240,"ratio":null,"oEmbed_title":"Christmas Fairies","oEmbed_author_name":"Aur\u00e9lie Bragard","oEmbed_author_url":"https:\/\/vimeo.com\/user197736234","oEmbed_type":"video","oEmbed_height":240,"oEmbed_width":426,"oEmbed_version":"1.0","oEmbed_provider_name":"Vimeo","oEmbed_provider_url":"https:\/\/vimeo.com\/","oEmbed_thumbnail_height":166,"oEmbed_thumbnail_width":295,"oEmbed_thumbnail_url":"https:\/\/i.vimeocdn.com\/video\/1840257549-8061065a9cc8d0c41b5189935c496b7bb568e149b8025013dffd2932638d14ee-d_295x166","oEmbed_html":"<iframe src=\"https:\/\/player.vimeo.com\/video\/938752195?app_id=122963\" width=\"426\" height=\"240\" frameborder=\"0\" allow=\"autoplay; fullscreen; picture-in-picture; clipboard-write\" title=\"Christmas Fairies\"><\/iframe>","oEmbed_description":"Illustrator and scenographer for show projects \u2018Christmas Fairies: The Secret Kingdom\u2019 invites you to a magical 15-20 minute experience at the heart of the enchanted world of Christmas. Discover the enchantment of Christmas like never before thanks to breathtaking decors. Follow the lighted clues, travel through enchanted forests, and meet magical creatures on your quest to meet Father Christmas.\n\nAt the end of your adventure, enjoy a special reward with an exceptional view of the Grand-Place, while enjoying comforting hot drinks, sweet treats and festive seasonal dishes. You'll also have the chance to meet Santa in person and capture some unforgettable memories by taking photos with him.\n\n\u2018Christmas Fairies: The Secret Kingdom\u2019 is much more than just a walk, it's an immersive experience that awakens the magic of Christmas, creating unforgettable memories for the whole family. Join us for an extraordinary adventure in search of Father Christmas in a world of enchantment and wonder.","translations":{"de":{"title":"Christmas fairies  The Secret Kingdom","copyright":null},"pt":{"title":"Christmas fairies  The Secret Kingdom","copyright":null},"en":{"title":"Christmas fairies  The Secret Kingdom","copyright":null},"it":{"title":"Christmas fairies  The Secret Kingdom","copyright":null},"cn":{"title":"Christmas fairies  The Secret Kingdom","copyright":null},"fr":{"title":"Christmas fairies  The Secret Kingdom","copyright":null},"sp":{"title":"Christmas fairies  The Secret Kingdom","copyright":null},"nl":{"title":"Christmas fairies  The Secret Kingdom","copyright":null}}}],"dates":[{"day":"2024-11-29","doors":"12:00:00","start":"12:00:00","end":"22:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"de":{"name":"Normal"},"en":{"name":"Normal"},"it":{"name":"Normale"},"fr":{"name":"Normal"},"sp":{"name":"Normal"},"nl":{"name":"Normaal"}},"value":5}],"date_exceptions":[],"closing_days":[],"child_events":[],"parent_events":[],"accessibilities":[],"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":["high_capacity","exterior"]},{"id":5700004138,"date_start":"2024-11-23","date_end":"2025-01-05","date_next":"2025-01-05","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-12-02T18:07:08+01:00","published_at":"2024-12-02T17:54:41+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":312871,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"misc","ranking":0.2832581674713524,"languages":{"spoken":["nl","fr"],"subtitles":[]},"categories":{"main":{"id":84,"translations":{"de":"Verschiedenes","pt":null,"en":"Various","it":"Varie","cn":null,"fr":"Divers","sp":"Varios","nl":"Varia"}},"others":{"list":[87],"translations":{"de":["Jahrm\u00e4rkte & Feste"],"pt":[null],"en":["Charity fairs and festivities"],"it":["Kermesse e celebrazioni"],"cn":[null],"fr":["Kermesses et festivit\u00e9s"],"sp":["Fiestas populares y festividades"],"nl":["Kermissen en feestelijkhheden"]}}},"translations":{"de":{"name":"Winter of Tour&Taxis","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/tour-taxis.com\/fr\/event\/lhiver-de-tourtaxis\/","email":"info@tour-taxis.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700004138"},"pt":{"name":"Winter of Tour&Taxis","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/tour-taxis.com\/fr\/event\/lhiver-de-tourtaxis\/","email":"info@tour-taxis.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700004138"},"en":{"name":"Winter of Tour&Taxis","shortdescr":"Come experience the magic of winter at Tour & Taxis with a series of festive events that will light up your days and evenings, from November 23 to January 5! With activities for children, dazzling shows, and winter-themed experiences, there will be something for everyone to enjoy.","longdescr":"\nThis winter, Tour & Taxis invites you to dive into the magic of the holiday season with a series of enchanting events! Meet Saint Nicholas, skate on our unique eco-friendly ice rink, or be dazzled by the magical show Sophie au Cabaret. Children can enjoy the Kids Winter Wonderland and have fun in a magical Christmas carousel, where they ride in sparkling Christmas baubles! For older visitors, there\u2019s the Christmas mode at BattleKart. From November 23 to January 5, experience unforgettable moments with family or friends, in a festive and cozy atmosphere !","performers":null,"boxoffice_url":null,"website":"https:\/\/tour-taxis.com\/event\/winter-of-tourtaxis\/","email":"info@tour-taxis.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700004138"},"it":{"name":"Winter of Tour&Taxis","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/tour-taxis.com\/fr\/event\/lhiver-de-tourtaxis\/","email":"info@tour-taxis.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700004138"},"cn":{"name":"Winter of Tour&Taxis","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/tour-taxis.com\/fr\/event\/lhiver-de-tourtaxis\/","email":"info@tour-taxis.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700004138"},"fr":{"name":"Winter of Tour&Taxis","shortdescr":"Venez vivre la magie de l'hiver \u00e0 Tour & Taxis* avec une s\u00e9rie d'\u00e9v\u00e9nements festifs qui illumineront vos journ\u00e9es et vos soir\u00e9es, du 23 novembre au 5 janvier ! Entre animations pour enfants, spectacles \u00e9blouissants et activit\u00e9s hivernales, il y en aura pour tous les go\u00fbts. ","longdescr":"Cet hiver, Tour & Taxis vous invite \u00e0 plonger dans la magie des f\u00eates avec une s\u00e9rie d\u2019\u00e9v\u00e9nements enchanteurs ! Rencontrez Saint Nicolas, patinez sur notre patinoire \u00e9cologique unique, ou laissez-vous \u00e9merveiller par le spectacle f\u00e9\u00e9rique Sophie au Cabaret. Les enfants pourront profiter du Kids Winter Wonderland et s\u2019amuser dans un carrousel de No\u00ebl magique, o\u00f9 ils embarquent dans des boules de No\u00ebl scintillantes ! Les plus grands pourront tester le mode Christmas chez BattleKart. Du 23 novembre au 5 janvier, vivez des moments inoubliables en famille ou entre amis, dans une ambiance festive et chaleureuse !","performers":null,"boxoffice_url":null,"website":"https:\/\/tour-taxis.com\/fr\/event\/lhiver-de-tourtaxis\/","email":"info@tour-taxis.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700004138"},"sp":{"name":"Winter of Tour&Taxis","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/tour-taxis.com\/fr\/event\/lhiver-de-tourtaxis\/","email":"info@tour-taxis.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700004138"},"nl":{"name":"Winter of Tour&Taxis","shortdescr":"Kom de magie van de winter beleven bij Tour & Taxis met een reeks feestelijke evenementen die je dagen en avonden zullen verlichten, van 23 november tot 5 januari ! Van kinderanimaties tot betoverende shows en winteractiviteiten, er is voor elk wat wils.","longdescr":"Deze winter nodigt Tour & Taxis je uit om in de magische sfeer van de feestdagen te duiken met een reeks betoverende evenementen! Ontmoet Sinterklaas, skate op onze unieke ecologische ijsbaan, of laat je verwonderen door de magische show Sophie au Cabaret. Kinderen kunnen genieten van het Kids Winter Wonderland en zich vermaken in een magische kerstcarrousel, waar ze kunnen rijden in schitterende kerstballen! Voor de grotere kinderen is er de Christmas-modus bij BattleKart. Van 23 november tot 5 januari kun je onvergetelijke momenten beleven met familie of vrienden, in een feestelijke en gezellige sfeer!","performers":null,"boxoffice_url":null,"website":"https:\/\/tour-taxis.com\/nl\/event\/winter-van-tourtaxis\/","email":"info@tour-taxis.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700004138"}},"place":{"id":262737,"translations":{"de":{"name":"Tour & Taxis Venues","address_street_name":"Avenue du Port","address_street_number":"86 c","address_street_box":null,"email":"welcome@tour-taxis.com","website":"http:\/\/www.tour-taxis.com\/meet-and-organise\/","phone_contact":"+32 2 421 50 02","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue du Port, 86 c","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Tour & Taxis Venues","address_street_name":"Avenue du Port","address_street_number":"86 c","address_street_box":null,"email":"welcome@tour-taxis.com","website":"http:\/\/www.tour-taxis.com\/meet-and-organise\/","phone_contact":"+32 2 421 50 02","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue du Port, 86 c","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Tour & Taxis Venues","address_street_name":"Avenue du Port","address_street_number":"86 c","address_street_box":null,"email":"welcome@tour-taxis.com","website":"http:\/\/www.tour-taxis.com\/meet-and-organise\/","phone_contact":"+32 2 421 50 02","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Avenue du Port, 86 c","address_line2":"1000 Brussels","description_web":"BRUSSELS' EVENT HUB - WHERE INTERACTION IS PARAMOUNT AND WHERE STORIES ARE CREATED\r\nThis industrial heritage site where ironworks once facilitated the transportation of goods, now promises exciting new horizons. Tour & Taxis is a complete makeover of late 19th- early 20th century shipping and customs warehouses and goods train station. Its offer of multiple upscale adjacent event spaces \u2013 each with their different atmosphere, being for 2 or for 10.000 guests \u2013 includes Maison de la Poste, The Sheds, Produits Dangereux, Gare Maritime, Place de la Musique and Quai aux Poissons. \r\n\r\nCongresses, conferences, meetings, trainings, receptions and dinners, exhibitions and fairs, festivals, product launches and other events besides\u2026 memorable events happen here! \r\n\r\nTour & Taxis aim is to provide a safe environment that is as welcoming as it is committed to sustainability, inclusivity, and accessibility. The huge multi-purpose pedestrian area is designed for the future, but with the charm of the past \u2013 a heritage to be claimed by many future generations.  \r\n\r\nView our Covid-19 measures: https:\/\/tour-taxis.com\/meet-and-organise\/covid-19-measures\/ ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":"https:\/\/www.youtube.com\/watch?v=YMTYGKDXuow","visit_url":null