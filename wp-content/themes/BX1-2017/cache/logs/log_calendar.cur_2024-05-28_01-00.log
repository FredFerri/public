/\/www.wolubilis.be","email":"secretariat.atl@woluwe1200.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.559317"},"fr":{"name":"Th\u00e9\u00e2tre","shortdescr":"Th\u00e9\u00e2tre 7-10 ans - 2023\/2024 - 127\r\nAtelier Studio | Rue Lola Bobesco 5, 1er \u00e9tage - 1200 Woluwe Saint Lambert | Voir la carte","longdescr":"Durant cet atelier, tu seras invit\u00e9 \u00e0 apprivoiser des espaces imaginaires et des personnages, \u00e0 jongler avec les \u00e9motions, les situations, les relations humaines. Une attention particuli\u00e8re est port\u00e9e \u00e0 la conscience du corps, la ma\u00eetrise du geste, la pr\u00e9sence, le tout avec humour. Cet atelier est aussi un espace de cr\u00e9ation o\u00f9 chacun.e pourra d\u00e9velopper son propre univers. Une cr\u00e9ation collective sera propos\u00e9e durant la saison afin d\u2019approfondir le travail en groupe et de d\u00e9velopper un esprit de collectivit\u00e9.\r\n\r\n\u00c2ge De 7 \u00e0 10 ans (d\u00e8s la 2\u00e8me primaire).\r\n\r\nAvec C\u00e9line Taubennest de la Cie D\u00e9j\u00e0 Demain\r\n\r\nD\u00e8s le 20 septembre, les mercredis de 13:30 \u00e0 15:30\r\n\r\nLocal Studio","performers":"Avec C\u00e9line Taubennest de la Cie D\u00e9j\u00e0 Demain","boxoffice_url":null,"website":"http:\/\/www.wolubilis.be","email":"secretariat.atl@woluwe1200.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.559317"},"sp":{"name":"Th\u00e9\u00e2tre","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wolubilis.be","email":"secretariat.atl@woluwe1200.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.559317"},"nl":{"name":"Th\u00e9\u00e2tre","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www