e,"last_updated_at":"2024-09-05T12:22:04+02:00","published_at":"2024-09-05T12:20:10+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":307232,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"tour","ranking":1,"languages":{"spoken":["nl","en","fr"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{}},"translations":{"de":{"name":"Guided Tour of the Chancellery of the Spanish Embassy - BBN 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/fr\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700000976"},"pt":{"name":"Guided Tour of the Chancellery of the Spanish Embassy - BBN 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/fr\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700000976"},"en":{"name":"Guided Tour of the Chancellery of the Spanish Embassy - BBN 2024","shortdescr":null,"longdescr":"Built on a plot of land in the rapidly developing Leopold Quarter, in the same way as dozens of other houses for wealthy customers, this large mansion meets all the requirements of a residential building: a covered carriage entrance, a monumental hallway with a marble staircase and beautifully decorated reception rooms with trompe l'oeil effects and heraldic mouldings, as well as an interior courtyard leading to the stables where interesting \"guard stones\" can still be found\u2026 The building currently houses the Chancellery of the Spanish Embassy and visitors will discover the areas reserved for protocol events, as well as the former annexes which are now used for exhibits organized by the Embassy's Cultural Section. \n\nPLEASE NOTE: For reasons of security, individual, named reservations are required. The list of visit participants will be shared with the Embassy's administrative staff and access will only be granted upon presentation of an ID card\/passport. Please arrive a few minutes before the start of your visit to allow for security checks.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/en\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700000976"},"it":{"name":"Guided Tour of the Chancellery of the Spanish Embassy - BBN 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/fr\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700000976"},"cn":{"name":"Guided Tour of the Chancellery of the Spanish Embassy - BBN 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/fr\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700000976"},"fr":{"name":"Visite Guid\u00e9e de la Chancellerie de l'ambassade d'Espagne - BBN 2024","shortdescr":null,"longdescr":"Erig\u00e9 sur une parcelle du quartier L\u00e9opold, alors en plein d\u00e9veloppement et au m\u00eame titre que des dizaines d'autres immeubles destin\u00e9s \u00e0 un public tr\u00e8s ais\u00e9, ce large h\u00f4tel de ma\u00eetre conjugue tous les codes d'une programmation r\u00e9sidentielle : entr\u00e9e coch\u00e8re couverte, hall d'entr\u00e9e magistral avec escalier de marbre, salons d'apparat aux d\u00e9cors soign\u00e9s dont de nombreux trompe-l'oeil et moulures h\u00e9raldiques ainsi qu'une cour int\u00e9rieure donnant sur des \u00e9curies o\u00f9 persistent m\u00eame d'int\u00e9ressants \"chasses-roues\"\u2026 Occup\u00e9s aujourd'hui par la Chancellerie de l'ambassade d'Espagne, les espaces habituellement r\u00e9serv\u00e9s au protocole seront \u00e0 d\u00e9couvrir, de m\u00eame que les anciennes annexes, d\u00e9volues aux expositions organis\u00e9es par le service culturel de l'ambassade. \n\nATTENTION : Pour des raisons de s\u00e9curit\u00e9, les inscriptions ne pourront \u00eatre qu'individuelles et nominatives ; la liste des participants sera transmise aux gestionnaires des lieux et l'acc\u00e8s au b\u00e2timent se fera uniquement sur pr\u00e9sentation d'une pi\u00e8ce d'identit\u00e9. Merci de vous pr\u00e9senter quelques minutes avant votre visite pour les contr\u00f4les de s\u00e9curit\u00e9.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/fr\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700000976"},"sp":{"name":"Guided Tour of the Chancellery of the Spanish Embassy - BBN 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/fr\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700000976"},"nl":{"name":"Rondleiding van het Kanselarij van de Spaanse Ambassade - BBN 2024","shortdescr":null,"longdescr":"Dit grote herenhuis werd gebouwd op een perceel in de Leopoldswijk, op een moment dat de wijk in volle ontwikkeling was. Het voldeed aan alle eisen van een residenti\u00eble woning voor een zeer welgesteld publiek, met een overdekte inrijpoort voor de koetsen, een monumentale hal met marmeren trappen en rijk gedecoreerde ontvangstruimtes met trompe-l'oeileffecten en wapenschildmotieven in de sierlijsten. De binnenplaats leidde oorspronkelijk naar de paardenstallen, getuige ook de schamppalen die nu nog te zien zijn. Vandaag huisvest het gebouw de Kanselarij van de Spaanse Ambassade. Bezoekers krijgen zowel toegang tot de zalen bestemd voor ceremonieel gebruik als tot de vroegere bijgebouwen waar de culturele dienst van de ambassade tentoonstellingen organiseert. \n\nLET OP: Om veiligheidsredenen dienen bij het inschrijven de namen van ALLE bezoekers te worden doorgegeven. De deelnemerslijst zal worden bezorgd aan de beheerders van de locatie en de toegang aan de gebouwen kan enkel worden verleend na vertoning van een identiteitsbewijs. Gelieve enkele minuten voor aanvang van het bezoek aanwezig te zijn.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/nl\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700000976"}},"place":{"id":50002341,"translations":{"de":{"name":"Chancellerie de l'ambassade d'Espagne","address_street_name":"Rue de la Science","address_street_number":"19","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Science, 19","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Chancellerie de l'ambassade d'Espagne","address_street_name":"Rue de la Science","address_street_number":"19","address_street_box":null,"email":null,"websi