"end":"18:00:00"}]}},"translations":{"fr":["lundi, mercredi, jeudi, vendredi, samedi et dimanche: de 10:00 \u00e0 18:00","mardi: ferm\u00e9"],"nl":["maandag, woensdag, donderdag, vrijdag, zaterdag en zondag: van 10:00 tot 18:00","dinsdag: gesloten"],"en":["monday, wednesday, thursday, friday, saturday and sunday: from 10:00 to 18:00","tuesday: closed"]},"date_start":"2022-03-17","date_end":"2022-11-19","is_also_by_appointment":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":14.5},{"translations":{"fr":{"name":"Enfants"},"nl":{"name":"Kinderen"},"en":{"name":"Children"}},"value":9.5},{"translations":{"fr":{"name":"Jeunes"},"nl":{"name":"Jongeren"},"en":{"name":"Young"}},"value":11.5},{"translations":{"fr":{"name":"Senior"},"nl":{"name":"Senioren"},"en":{"name":"Senior"}},"value":11.5},{"translations":{"fr":{"name":"Article 27"},"nl":{"name":"Artikel 27"},"en":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"visit_profile":{"list":[337],"translations":{"fr":["Highlight"],"nl":["Highlight"],"en":["Highlight"]}},"tags":[],"accessibilities":{"list":[255,261,265],"translations":{"fr":["Accessible","Parking accessible","WC adapt\u00e9"],"nl":["Toegankelijk","Toegankelijke parking","Aangepast toilet"],"en":["Accessible","Accessible parking","Adapted toilet"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-06-10T01:07:01+02:00","published_at":"2022-03-15T11:48:07+01:00","backoffice_id":249660,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.20053619559536},{"id":533546,"date_start":"2022-05-12","date_end":"2022-07-31","date_next":"2022-06-10","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[36,46],"translations":{"fr":["Mus\u00e9es et art centers","Pluridisciplinaire"],"nl":["Musea en kunstcentra","Multidisciplinair"],"en":["Museums and art centers","Multidisciplinary"]}}},"languages":{"spoken":["fr","en","nl"],"subtitles":[]},"translations":{"fr":{"name":"The Act of Breathing","shortdescr":"Inspir\u00e9e du po\u00e8me L'Acte de Respirer de l\u2019\u00e9crivain et po\u00e8te congolais Sony Labou Tansi, The Act of Breathing explore le souffle. Une force r\u00e9p\u00e9titive et instinctive essentielle \u00e0 la vie  qui, comme l\u2019auteur nous le fait comprendre, peut devenir un outil de r\u00e9sistance politique lorsque le droit de respirer m\u00eame doit \u00eatre d\u00e9fendu ardemment.","longdescr":"The Act of Breathing traduit l\u2019ambition de Horst de jeter un pont entre la musique et l\u2019art en une exposition multidisciplinaire. Cette ann\u00e9e, l\u2019organisation accueille la curatrice Sorana Munsya pour coordonner l\u2019exposition aux c\u00f4t\u00e9s d\u2019Evelyn Simons de Horst. Elles s\u2019associeront \u00e0 KANAL-Centre Pompidou Bruxelles pour faire venir en Belgique un ambitieux groupe d\u2019artistes. De cette collaboration r\u00e9sulteront 11 \u0153uvres d\u2019art in situ qui dialoguent avec le caract\u00e8re architectural et symbolique du site d\u2019Asiat, une ancienne base militaire. Trois autres artistes pr\u00e9senteront leur travail au Cinematek \u00e0 Bruxelles, o\u00f9 l\u2019exposition s\u2019accompagnera  d\u2019un programme de films compil\u00e9 par Monique Mbeka Phoba.\r\n \r\nCette ann\u00e9e, le vernissage co\u00efncide avec le festival de musique de 3 jours, puisqu\u2019il se d\u00e9roule du 29 avril au 1er mai. Apr\u00e8s ce week-end de festival plein d\u2019\u00e9nergie, The Act of Breathing sera \u00e0 nouveau accessible  du 12 mai au 31 juillet inclus.\r\n \r\nTous les jours de 17h30 \u00e0 22h30 : Cinematek Bruxelles. \r\n\r\nUne exposition dans le cadre de Living Traces\r\n \r\ndu 29 avril 2022 au 1 mai 2022 | 17:00-22:30\r\n&\r\ndu 12 mai 2022 au 31 juillet 22 | 11:00-18:00\r\n \r\nTarifs:\r\nTicket classique: 10 \u20ac\r\nTicket Vilvorde: 5 \u20ac \/ pour les habitants de Vilvorde\r\nTicket jeune: 5 \u20ac \/ pour les jeunes de 19 \u00e0 25 ans","performers":"Jean Kabuta, Mega Mingiedi, Agn\u00e8s Lalau & Monique Mbeka Phoba.","boxoffice_url":null,"website":"https:\/\/kanal.brussels\/fr\/evenements\/exposition\/act-breathing","email":"info@kanal.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/533546.html"},"nl":{"name":"The Act of Breathing","shortdescr":"Met het gedicht L'Acte de R\u00e9spirer van de Congolese schrijver en dichter Sony Labou Tansi als basis, verkent The Act of Breathing de adem: een repetitieve en instinctieve kracht, een noodzaak. Maar, zoals Labou Tansi ons doet inzien, kan de adem ook een potentieel instrument zijn voor politiek verzet, wanneer zelfs het recht op ademen koppig moet worden gehandhaafd.","longdescr":"The Act of Breathing vertaalt de ambitie van Horst om de cros- sover tussen muziek en kunst te verweven naar een mul;disci- plinaire tentoonstelling. Dit jaar verwelkomt de organisa;e cu- rator Sorana Munsya om naast Horst's Evelyn Simons de ten- toonstelling te cureren. De krachten worden gebundeld met KANAL-Centre Pompidou Brussel om samen een uitdagende line-up van kunstenaars naar Belgi\u00eb te halen. Het resultaat zal bestaan uit 11 in-situ kunstwerken die in dialoog treden met het architecturale en symbolische karakter van de Asiat-site, een voormalige militaire basis. Drie andere kunstenaars verto- nen hun werk in Cinematek te Brussel, alwaar de expo gekop- peld wordt aan een filmprogramma samengesteld door Moni- que Mbeka Phoba.\r\n \r\nVernissage valt dit jaar samen met het driedaagse muziekfestival: 29 april - 1 mei. Na het energieke festival weekend, opent ! The Act of Breathing op- nieuw van 12 mei tot en met 31 juli.\r\n \r\nDagelijks van 17u30 tot 22u30 : Cinematek Brussels\r\n\r\nIn het kader van Living Traces\r\n \r\nvan 29 april 2022 tot 1 mei 2022 | 17:00-22:30\r\n&\r\nvan 12 mei 2022 tot 31 juli 2022 | 11:00-18:00\r\n \r\nTarieven:\r\nStandaard Ticket: \u20ac10\r\nVilvoorde Ticket: \u20ac5 \/ voor inwoners van Vilvoorde\r\nJeugd Ticket: \u20ac5 \/ voor jeugd tussen 19 en 25 jaar","performers":"Jean Kabuta, Mega Mingiedi, Agn\u00e8s Lalau & Monique Mbeka Phoba.","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/533546.html"},"en":{"name":"The Act of Breathing","shortdescr":"The Act of Breathing is based on the poem L'Acte de R\u00e9spirer, by Congolese writer and poet Sony Labou Tansi and explores the breath - the repetitive and instinctive force that is also a necessity. As Labou Tansi reveals, the breath can also be used as a tool for political resistance, when even the right to breathe must be wilfully preserved.","longdescr":"The Act of Breathing translates Horst\u2019s mission of interweaving the crossover between music and art into a multidisciplinary exhibition. This year, Sorana Munsya has been invited to curate the exhibition alongside Horst's Evelyn Simons. These forces join with the KANAL-Centre Pompidou, Brussels to bring together an exciting line-up of artists in Belgium. The result will be 11 in-situ artworks engaging with the architectural and symbolic character of the Asiat-site, a former military base. Three other artists will present their work at Cinematek in Brussels, where the exhibition will be linked to a programme of films curated by Monique Mbeka Phoba.\r\n \r\nThis year, the opening coincides with the three-day music festival: 29 April - 1 May. After the intense festival weekend, The Act of Breathing will reopen from 12 May to 31 July.\r\n \r\nDaily from 17:30 to 22:30 : Cinematek Brussels.\r\n\r\nIn the framework of Living Traces\r\n \r\n29 April 2022 to 1 May 2022 | 17:00-22:30\r\n&\r\nfrom 12 May 2022 to 31 July 2022 | 11:00-18:00\r\n \r\nTickets:\r\nStandard ticket: \u20ac10\r\nVilvoorde Ticket: \u20ac5 \/ For all Vilvoorde residents\r\nYouth Ticket: \u20ac5 \/ For anyone aged between 19 and 25 years old","performers":"Jean Kabuta, Mega Mingiedi, Agn\u00e8s Lalau & Monique Mbeka Phoba.","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/533546.html"},"de":{"name":"The Act of Breathing","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/533546.html"},"it":{"name":"The Act of Breathing","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/533546.html"},"sp":{"name":"The Act of Breathing","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/533546.html"},"pt":{"name":"The Act of Breathing","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/533546.html"},"cn":{"name":"The Act of Breathing","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/533546.html"}},"place":{"id":1725,"translations":{"fr":{"name":"CINEMATEK","address_street_name":"Rue Baron Horta","address_street_number":"9","address_street_box":null,"email":"info@cinematek.be","website":"http:\/\/www.cinematek.be","phone_contact":"+32 2 551 19 19","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Baron Horta, 9","address_line2":"1000 Bruxelles","description_web":"La Cinematek est la vitrine publique des collections et activit\u00e9s de la Cin\u00e9math\u00e8que royale de Belgique. La collection de films est l'une des plus importantes au monde. Elle s'accro\u00eet chaque ann\u00e9e de quelque 2.000 copies en moyenne, illustrant le cin\u00e9ma des origines \u00e0 nos jours. La Cinematek propose une programmation de films exceptionnelle: anthologies, r\u00e9trospectives, cycles th\u00e9matiques, rendez-vous, etc.\r\n\r\nCORONAPROOF -  CINEMATEK VOUS DONNE L\u2019EXCLUSIVIT\u00c9 D\u2019UNE DE SES SALLES\u2009: UNE PROJECTION PRIV\u00c9E POUR VOTRE BULLE SOCIALE.\r\nPour \u20ac150, vous pouvez choisir un des 50 films \u00e0 la carte. \r\nTous les jours \u00e0 20h00, la salle Plateau de CINEMATEK est \u00e0 votre disposition et peut accueillir une bulle de 15 personnes maximum. Pour les projections de films muets, un suppl\u00e9ment\r\nde \u20ac100 est demand\u00e9 pour le pianiste. R\u00e9servation par email avec la date et le film souhait\u00e9s \u00e0 info@cinematek.be\r\nhttp:\/\/cinematek.be\/?node=429 \r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"CINEMATEK","address_street_name":"Baron Hortastraat","address_street_number":"9","address_street_box":null,"email":"info@cinematek.be","website":"http:\/\/www.cinematek.be","phone_contact":"+32 2 551 19 19","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Baron Hortastraat, 9","address_line2":"1000 Brussel","description_web":"De vernieuwde Cinematek (vroeger het Filmmuseum) is het publieke uitstalraam van de collecties en de activiteiten van het Koninklijk Belgisch Filmarchief. De filmcollectie, \u00e9\u00e9n van de belangrijkste ter wereld, groeit ieder jaar aan met zo'n 2.000 kopie\u00ebn.  Naast een permanente tentoonstelling over de geschiedenis van de film heeft de Cinematek ook een eigen filmprogrammatie: anthologie\u00ebn, retrospectieven, cyclussen rond een bepaald thema,\u2026\r\n\r\nCORONAPROOF -  CINEMATEK BIEDT FAMILIES, COLLEGA\u2019S EN GROEPEN EXCLUSIEVE EN INTIEME PRIV\u00c9-VERTONINGEN AAN VOOR HUN SOCIALE BUBBEL.\r\nVoor \u20ac150 kan je met jouw sociale bubbel een van de 50 films \u00e0 la carte kiezen.Voor vertoningen van stille films wordt \u20ac100 extra gevraagd voor de pianist.\r\nElke dag om 20u uur biedt CINEMATEK hiervoor de Plateau-zaal aan voor maximum 15 mensen.\r\nReserveer per email met de gewenste data en specifieke films naar info@cinematek.be\r\nhttp:\/\/cinematek.be\/?node=429&lng=nl\r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"CINEMATEK","address_street_name":"rue Baron Horta","address_street_number":"9","address_street_box":null,"email":"info@cinematek.be","website":"http:\/\/www.cinematek.be","phone_contact":"+32 2 551 19 19","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"rue Baron Horta, 9","address_line2":"1000 Brussels","description_web":"The Royal Belgian Film Archive now called CINEMATEK has one of the largest collection of films in the world, which illustrate the history of film from the beginnings to our times. The collection increases every year with some 2,000 copies. Cinematek proposes an excellent programmation with daily silent cinema screenings, anthologies, retrospectives etc.\r\n\r\nCORONAPROOF -  CINEMATEK IS OFFERING FAMILIES AND SOCIAL BUBBLES THE OPPORTUNITY TO PRIVATISE THEIR SMALLER SCREENING ROOM FOR AN EXCLUSIVE AND\r\nINTIMATE VIEWING.\r\nFor \u20ac150, a maximum of 15 people can choose one of the 50 selected films. The private screenings will be available daily at 20:00. For screenings of silent films, an extra \u20ac100 will be\r\nrequested for the live pianist. Reservations can be made by email with the desired dates and choice of film to info@cinematek.be\r\nhttp:\/\/cinematek.be\/dbfiles\/mfile\/283500\/283567\/Plateaualacarte.pdf\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"CINEMATEK","address_street_name":"rue Baron Horta","address_street_number":"9","address_street_box":null,"email":"info@cinematek.be","website":"http:\/\/www.cinematek.be","phone_contact":"+32 2 551 19 19","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"rue Baron Horta, 9","address_line2":"1000 Bruxelles","description_web":"Die Cinematek ist gewisserma\u00dfen die \u00f6ffentliche \u201eVitrine\u201c der Cin\u00e9math\u00e8que royale de Belgique. Die Filmsammlung z\u00e4hlt weltweit zu den gr\u00f6\u00dften ihrer Art und w\u00e4chst j\u00e4hrlich um rund 2000 Neuerwerbungen. Das Filmarchiv deckt die Filmkunst von den ersten Filmen bis zur Gegenwart ab. Das Filmprogramm umfasst h\u00e4ufig Perlen der internationalen Filmkunst, Anthologien, Retrospektiven, Themenreihen etc.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"CINEMATEK","address_street_name":"rue Baron Horta","address_street_number":"9","address_street_box":null,"email":"info@cinematek.be","website":"http:\/\/www.cinematek.be","phone_contact":"+32 2 551 19 19","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"rue Baron Horta, 9","address_line2":"1000 Bruxelles","description_web":"Quaranta vetrine ripercorrono gli albori del cinema, ovvero le principali invenzioni che hanno portato alla scoperta del cinematografo da parte dei fratelli Lumi\u00e8re. La maggior parte delle vetrine ha un meccanismo che permette di azionare i dispositivi esposti, e quindi di comprenderne il funzionamento. Le due sale di proiezione attigue illustranola storia del cinema attraverso cinque proiezioni serali: nella prima sala (125 posti) vengono proiettati ogni giorno 3 film sonori. La seconda (30 posti) \u00e8 interamente dedicata al cinema muto (vengono proiettati ogni giorno 2 film, con accompagnamento di pianoforte dal vivo). Il centro di documentazione cinematografica possiede diverse decine di migliaia di libri e periodici, e pi\u00f9 di un milione di fotografie consultabili nella sala di lettura.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"CINEMATEK","address_street_name":"rue Baron Horta","address_street_number":"9","address_street_box":null,"email":"info@cinematek.be","website":"http:\/\/www.cinematek.be","phone_contact":"+32 2 551 19 19","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"rue Baron Horta, 9","address_line2":"1000 Bruxelles","description_web":"Cuarenta vitrinas repasan la prehistoria del cine, es decir, los principales inventos que condujeron al descubrimiento del cinemat\u00f3grafo por parte de los hermanos Lumi\u00e8re. La mayor\u00eda de estas vitrinas disponen de un mecanismo que permite accionar los aparatos expuestos y, de este modo, entender su funcionamiento. Las dos salas de proyecci\u00f3n contiguas ilustran la historia del cine con 5 proyecciones diarias por la noche: en la primera sala (125 plazas) se proyectan cada d\u00eda 3 pel\u00edculas sonoras. La segunda (30 plazas) se consagra por completo al cine mudo (todos los d\u00edas se proyectan 2 pel\u00edculas con acompa\u00f1amiento de piano en directo). Un centro de documentaci\u00f3n cinematogr\u00e1fica contiene decenas de miles de libros y peri\u00f3dicos y m\u00e1s de un mill\u00f3n de fotograf\u00edas que pueden consultarse en la sala de lectura.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"CINEMATEK","address_street_name":"Rue Baron Horta","address_street_number":"9","address_street_box":null,"email":"info@cinematek.be","website":"http:\/\/www.cinematek.be","phone_contact":"+32 2 551 19 19","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Baron Horta, 9","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"CINEMATEK","address_street_name":"Rue Baron Horta","address_street_number":"9","address_street_box":null,"email":"info@cinematek.be","website":"http:\/\/www.cinematek.be","phone_contact":"+32 2 551 19 19","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Baron Horta, 9","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[16],"translations":{"fr":["Quartier Royal"],"nl":["Koninklijke wijk"],"en":["Royal"]}},"zones":{"list":[19],"translations":{"fr":["Centre"],"nl":["Centrum"],"en":["Centre"]}},"neca":null,"facebook_id":null,"backoffice_id":209,"location":{"lat":50.84410144,"lon":4.3601395},"region":"brussels","last_updated_at":"2022-06-10T01:08:28+02:00","published_at":"2013-10-19T01:13:21+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":271094,"translations":{"fr":{"name":"Kanal - Centre Pompidou","address_street_name":"Square Sainctelette","address_street_number":null,"address_street_box":null,"email":"info@kanal.brussels","website":"http:\/\/www.kanal.brussels","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Square Sainctelette","address_line2":"1000 Bruxelles","description_web":"Lors de sa re\u0301ouverture pre\u0301vue en 2024, KANAL-Centre Pompidou deviendra la plus vaste institution culturelle bruxelloise, avec plus de 35.000 m2 de\u0301die\u0301s a\u0300 la cre\u0301ation artistique sous toutes ses formes. Visitez actuellement l\u2019exposition de l\u2019artiste suisse John M Armleder et de ses invite\u0301s, sur les six e\u0301tages de l\u2019ancien showroom du garage. Pre\u0301vue jusque fin avril 2021, date de fermeture de KANAL-Centre Pompidou jusqu\u2019a\u0300 sa re\u0301ouverture en 2024,\r\ncette exposition constitue un vaste projet interdisciplinaire, confie\u0301 a\u0300 l\u2019un des artistes majeurs de la sce\u0300ne contemporaine, confirmant la volonte\u0301 d\u2019expe\u0301rimentation et d\u2019ouverture de KANAL-Centre Pompidou.\r\n","description_print":"","booking_url":null,"sort_order":"KANAL - CENTRE POMPIDOU","virtual_visit":null},"nl":{"name":"Kanal - Centre Pompidou","address_street_name":"Sainctelettesquare","address_street_number":null,"address_street_box":null,"email":"info@kanal.brussels","website":"http:\/\/www.kanal.brussels","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Sainctelettesquare","address_line2":"1000 Brussel","description_web":"Wanneer KANAL-Centre Pompidou in 2024 opnieuw opent, wordt het de grootste culturele instelling van Brussel, met meer dan 35.000 m2 gewijd aan artistieke creatie in al haar vormen. Bezoek momenteel de tentoonstelling van de Zwitserse kunstenaar John M Armleder en zijn gasten op de zes verdiepingen van de voormalige showroom van de Citroe\u0308n-garage. Deze tentoonstelling loopt tot eind april 2021, wanneer KANAL-Centrum Pompidou zal sluiten tot de heropening in 2024. Het is een grootschalig interdisciplinair project, toevertrouwd aan een van de belangrijkste kunstenaars van de hedendaagse sce\u0300ne, helemaal in het teken van experiment.","description_print":"","booking_url":null,"sort_order":"KANAL - CENTRE POMPIDOU","virtual_visit":null},"en":{"name":"Kanal - Centre Pompidou","address_street_name":"Square Sainctelette","address_street_number":null,"address_street_box":null,"email":"info@kanal.brussels","website":"http:\/\/www.kanal.brussels","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Square Sainctelette","address_line2":"1000 Brussels","description_web":"When KANAL-Centre Pompidou reopens in 2024, it will become the largest cultural institution in Brussels, with more than 35,000 m2 devoted to artistic creation in all its forms. Visit the exhibition of the Swiss artist John M Armleder and his guests on the six floors of the former showroom of the Citroe\u0308n garage. This exhibition runs until the end of April 2021, when KANAL-Centrum Pompidou will close until its reopening in 2024.\r\nIt is a large-scale interdisciplinary project, entrusted to one of the most important artists on the contemporary scene, entirely devoted to experimentation.\r\n\r\nVisit the exhibition of the Swiss artist John M Armleder and his guests on the six floors of the former showroom of the Citroe\u0308n garage. This exhibition runs until the end of April 2021, when KANAL-Centrum Pompidou will close until its reopening in 2024.\r\nIt is a large-scale interdisciplinary project, entrusted to one of the most important artists on the contemporary scene, entirely devoted to experimentation.\r\n","description_print":"","booking_url":null,"sort_order":"KANAL - CENTRE POMPIDOU","virtual_visit":null},"de":{"name":"Kanal - Centre Pompidou","address_street_name":"Square Sainctelette","address_street_number":null,"address_street_box":null,"email":"info@kanal.brussels","website":"http:\/\/www.kanal.brussels","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Square Sainctelette","address_line2":"1000 Bruxelles","description_web":"Weder auf dem Gebiet der modernen und zeitgen\u00f6ssischen Kunst noch im Bereich der Architektur ist Br\u00fcssel ein unbeschriebenes Blatt. Im Gegenteil, es gibt bereits eine ganze Reihe von Museen und Einrichtungen, die sich mit den verschiedenen k\u00fcnstlerischen Disziplinen besch\u00e4ftigen. \r\nWas jedoch bislang noch fehlte, war ein Museum f\u00fcr moderne und zeitgen\u00f6ssische Kunst und ein Architekturmuseum unter einem Dach (und was f\u00fcr einem Dach!). Und so hat das ambitionierte Projekt KANAL Centre Pompidou seine absolute Daseinsberechtigung am Br\u00fcsseler Kanal, wo es die 35 000 m\u00b2 der ehemaligen Citro\u00ebn-Werkstatt in Beschlag nehmen wird. In der Zeit bis zum Beginn der Umbauarbeiten, deren Ende f\u00fcr 2022\/2023 geplant sind, hat die Fondation Kanal beschlossen, ab dem 5. Mai 2018 eine Art \"Vorlaufjahr\" zu starten. 13 Monate lang kann das Publikum in Zusammenarbeit mit dem Centre Pompidou dieses mythische Geb\u00e4ude entdecken - Ausstellungen, Gro\u00dfinstallationen, zehn Auftragsarbeiten von Br\u00fcsseler K\u00fcnstlern sowie ein Programm mit Live-Darbietungen. ","description_print":"","booking_url":null,"sort_order":"KANAL - CENTRE POMPIDOU","virtual_visit":null},"it":{"name":"Kanal - Centre Pompidou","address_street_name":"Square Sainctelette","address_street_number":null,"address_street_box":null,"email":"info@kanal.brussels","website":"http:\/\/www.kanal.brussels","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Square Sainctelette","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":"KANAL - CENTRE POMPIDOU","virtual_visit":null},"sp":{"name":"Kanal - Centre Pompidou","address_street_name":"Square Sainctelette","address_street_number":null,"address_street_box":null,"email":"info@kanal.brussels","website":"http:\/\/www.kanal.brussels","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Square Sainctelette","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":"KANAL - CENTRE POMPIDOU","virtual_visit":null},"pt":{"name":"Kanal - Centre Pompidou","address_street_name":"Square Sainctelette","address_street_number":null,"address_street_box":null,"