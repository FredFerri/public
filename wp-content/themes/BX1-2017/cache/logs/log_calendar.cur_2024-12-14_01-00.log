:[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[46,36],"translations":{"de":["Multidisziplin\u00e4r","Museen & Kunstzentren"],"pt":[null,null],"en":["Multidisciplinary","Museums and art centers"],"it":["Multidisciplinare","Musei e centri artistici"],"cn":[null,null],"fr":["Pluridisciplinaire","Mus\u00e9es et art centers"],"sp":["Multidisciplinar","Museos y centros de arte"],"nl":["Multidisciplinair","Musea en kunstcentra"]}}},"translations":{"de":{"name":"PAYSAGES OUBLI\u00c9S du Moyen \u00c2ge au XVIIIe si\u00e8cle, Molenbeek - Koekelberg - Scheut - Berchem-Sainte-Agathe","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/associationdupatrimoineartistique.be\/actualites","email":"communication.as.pat.art@gmail.com","phone_contact":"+32 2 512 34 21","phone_booking":"+32 2 512 34 21","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700003460"},"pt":{"name":"PAYSAGES OUBLI\u00c9S du Moyen \u00c2ge au XVIIIe si\u00e8cle, Molenbeek - Koekelberg - Scheut - Berchem-Sainte-Agathe","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/associationdupatrimoineartistique.be\/actualites","email":"communication.as.pat.art@gmail.com","phone_contact":"+32 2 512 34 21","phone_booking":"+32 2 512 34 21","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700003460"},"en":{"name":"FORGOTTEN LANDSCAPE From the Middle Ages to the 18th Century","shortdescr":"The exhibition offers an imaginary stroll through these Brussels neighborhoods as they appeared from the Middle Ages until the 18th century. This unique experience features enlargements of historical maps and plans complemented by a wealth of visual documentation. Through this journey, the exhibition restores the rural landscape, topography, and activities of these areas during these periods.","longdescr":"The exhibition, \"Forgotten Landscapes\", invites visitors to journey back in time, offering an imaginary stroll through the Brussels neighborhoods of Molenbeek, Koekelberg, Scheut and Berchem-Sainte-Agathe as they appeared from the Middle Ages until the 18th century. This unique experience features enlargements of historical maps and plans, rarely accessible to the public, complemented by a wealth of visual documentation, including original engravings, books, reproductions of artwork, and archival materials. Through this journey, the exhibition restores the rural landscape, topography, and activities of these areas during these periods.\nThis collection provides insight into the evolving relationship between Brussels and its surrounding areas, highlighting the shifts in power between the burgeoning city and established feudal and ecclesiastical authorities. This exploration, rich in historical layers, gives visitors of all ages the chance to (re)discover places whose names and street layouts still echo today.","performers":null,"boxoffice_url":null,"website":"https:\/\/associationdupatrimoineartistique.be\/actualites","email":"communication.as.pat.art@gmail.com","phone_contact":"+32 2 512 34 21","phone_booking":"+32 2 512 34 21","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700003460"},"it":{"name":"PAYSAGES OUBLI\u00c9S du Moyen \u00c2ge au XVIIIe si\u00e8cle, Molenbeek - Koekelberg - Scheut - Berchem-Sainte-Agathe","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/associationdupatrimoineartistique.be\/actualites","email":"communication.as.pat.art@gmail.com","phone_contact":"+32 2 512 34 21","phone_booking":"+32 2 512 34 21","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700003460"},"cn":{"name":"PAYSAGES OUBLI\u00c9S du Moyen \u00c2ge au XVIIIe si\u00e8cle, Molenbeek - Koekelberg - Scheut - Berchem-Sainte-Agathe","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/associationdupatrimoineartistique.be\/actualites","email":"communication.as.pat.art@gmail.com","phone_contact":"+32 2 512 34 21","phone_booking":"+32 2 512 34 21","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700003460"},"fr":{"name":"PAYSAGES OUBLI\u00c9S du Moyen \u00c2ge au XVIIIe si\u00e8cle","shortdescr":"L'exposition propose une promenade imaginaire dans ces communes bruxelloises telles qu\u2019elles se pr\u00e9sentaient du Moyen \u00c2ge jusqu'\u00e0 la fin du XVIIIe si\u00e8cle. Les cartes\/plans d\u2019\u00e9poque agrandis et la riche documentation iconographique (gravures originales, reproductions d\u2019\u0153uvres et d\u2019archives) guident le visiteur dans la (re)d\u00e9couverte de ces territoires ruraux et des activit\u00e9s qui y \u00e9taient men\u00e9es.","longdescr":"\"Paysages oubli\u00e9s\" est une invitation \u00e0 remonter le temps.\nElle convie le visiteur \u00e0 une promenade imaginaire dans les communes de Molenbeek, Koekelberg, Scheut et Berchem-Sainte-Agathe telles qu\u2019elles se pr\u00e9sentaient du Moyen \u00c2ge jusqu\u2019\u00e0 la fin du XVIIIe si\u00e8cle. Le parcours se compose d\u2019agrandissements de cartes et de plans d\u2019\u00e9poque, souvent peu connus du public et sont accompagn\u00e9s d\u2019une riche documentation iconographique (gravures originales, livres, reproductions d\u2019\u0153uvres et d\u2019archives). L\u2019environnement rural, le relief de ces territoires et les activit\u00e9s qui y \u00e9taient men\u00e9es sont ainsi restitu\u00e9s.\nCet ensemble permet de mieux appr\u00e9hender les relations de Bruxelles avec sa p\u00e9riph\u00e9rie, et de souligner les renversements de pouvoir qui se sont produits entre la ville naissante et de puissantes entit\u00e9s f\u00e9odales et eccl\u00e9siastiques pr\u00e9existantes. Ce voyage charg\u00e9 d\u2019histoires offre l\u2019opportunit\u00e9 \u00e0 un public de tout \u00e2ge de (re) d\u00e9couvrir des lieux qu\u2019il connait par les appellations employ\u00e9es et par le trac\u00e9 de certaines rues qui perdurent de nos jours.\nUn cheminement in\u00e9dit dans le temps et l\u2019espace, une marche de l\u2019esprit.","performers":null,"boxoffice_url":null,"website":"https:\/\/associationdupatrimoineartistique.be\/actualites","email":"communication.as.pat.art@gmail.com","phone_contact":"+32 2 512 34 21","phone_booking":"+32 2 512 34 21","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700003460"},"sp":{"name":"PAYSAGES OUBLI\u00c9S du Moyen \u00c2ge au XVIIIe si\u00e8cle, Molenbeek - Koekelberg - Scheut - Berchem-Sainte-Agathe","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/associationdupatrimoineartistique.be\/actualites","email":"communication.as.pat.art@gmail.com","phone_contact":"+32 2 512 34 21","phone_booking":"+32 2 512 34 21","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700003460"},"nl":{"name":"VERGETEN LANDSCHAPPEN van de middeleeuwen tot de 18e eeuw","shortdescr":"De tentoonstelling biedt een denkbeeldige wandeling aan door de Brusselse gemeenten zoals ze er uitzagen over de p\u00e9riode gaan de van de Middeleeuwen tot het einde van de 18e eeuw. De uitvergrote historische kaarten\/plattegronden en de rijke iconografische documentatie zullen de bezoeker begeleiden bij zijn (her)ontdekking van deze landelijke gebieden en de activiteiten die er plaatsvonden.","longdescr":"\"Vergeten landschappen\" is een uitnodiging om in de tijd terug te gaan.\nHet nodigt de bezoeker uit voor een denkbeeldige wandeling door de gemeenten Molenbeek, Koekelberg, Scheut en Sint-Agatha-Berchem, zoals ze er uitzagen sinds de Middeleeuwen tot het einde van de 18e eeuw. De gevolgde route bestaat uit vergrotingen van historische kaarten en plattegronden die vaak weinig publiek bekend zijn, en waaraan een rijke iconografische documentatie is toegevoegd (originele gravures, boeken, reproducties van werken en archieven). De landelijke omgeving, het reli\u00ebf van deze gebieden en de activiteiten die daar werden uitgeoefend, worden hier zo weergegeven.\nDit ensemble laat ons toe de relaties tussen Brussel en zijn periferie beter te begrijpen, en de omkeringen te benadrukken van de strijd die plaatsvonden tussen de opkomende steden en de reeds bestaande machtige feodale en kerkelijke entiteiten. Deze reis vol verhalen biedt aan een publiek van alle leeftijden de mogelijkheid om plaatsen te (her)ontdekken die ze reeds kennen, doorheen namen van wegen en straten die vandaag de dag nog steeds bestaan.\nEen tot nu nog, een ongekende reis door tijd en ruimte; een wandeling van de geest.\n","performers":null,"boxoffice_url":null,"website":"https:\/\/associationdupatrimoineartistique.be\/actualites","email":"communication.as.pat.art@gmail.com","phone_contact":"+32 2 512 34 21","phone_booking":"+32 2 512 34 21","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700003460"}},"place":{"id":243535,"translations":{"de":{"name":"Association du Patrimoine Artistique asbl","address_street_name":"Rue Charles Hanssens","address_street_number":"7","address_street_box":null,"email":"info@associationdupatrimoineartistique.be","website":"http:\/\/www.associationdupatrimoineartistique.be","phone_contact":"+32 2 512 34 21","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Charles Hanssens, 7","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Association du Patrimoine Artistique asbl","address_street_name":"Rue Charles Hanssens","address_street_number":"7","address_street_box":null,"email":"info@associationdupatrimoineartistique.be","website":"http:\/\/www.associationdupatrimoineartistique.be","phone_conta