/visitors\/agenda\/event-detail.50008581"},"pt":{"name":"Pictural Fantasies : Poetic Surrealism","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/bxl.art-nft.gallery","email":"hello@art-nft.gallery","phone_contact":"+32 478 29 20 43","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50008581"},"en":{"name":"Pictural Fantasies : Poetic Surrealism","shortdescr":"Artist Anne de Decker finds painting a therapy, an expression of her creativity in music.\nHer luminous, joyful paintings, imbued with poetry and fantasy, capture the eye with their bright colours and surreal touches. Her pictorial universe is a blend of influences, from Mondrian to Klimt, with a subtle harmony between geometric shapes and generous curves.","longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/bxl.art-nft.gallery","email":"hello@art-nft.gallery","phone_contact":"+32 478 29 20 43","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50008581"},"it":{"name":"Pictural Fantasies : Poetic Surrealism","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/bxl.art-nft.gallery","email":"hello@art-nft.gallery","phone_contact":"+32 478 29 20 43","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50008581"},"cn":{"name":"Pictural Fantasies : Poetic Surrealism","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/bxl.art-nft.gallery","email":"hello@art-nft.gallery","phone_contact":"+32 478 29 20 43","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50008581"},"fr":{"name":"Fantaisies Picturales : le Surr\u00e9alisme Po\u00e9tique","shortdescr":"L'artiste Anne de Decker trouve dans la peinture une th\u00e9rapie, une expression de sa cr\u00e9ativit\u00e9 en musique.\nSes tableaux lumineux et joyeux, empreints de po\u00e9sie et de fantaisie, captent l'attention par leurs couleurs vives et leurs touches surr\u00e9alistes. Son univers pictural est un m\u00e9lange d'influences, de Mondrian \u00e0 Klimt, avec une subtile harmonie entre formes g\u00e9om\u00e9triques et courbes g\u00e9n\u00e9reuses.","longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/bxl.art-nft.gallery","email":"hello@art-nft.gallery","phone_contact":"+32 478 29 20 43","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50008581"},"sp":{"name":"Pictural Fantasies : Poetic Surrealism","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/bxl.art-nft.gallery","email":"hello@art-nft.gallery","phone_contact":"+32 478 29 20 43","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50008581"},"nl":{"name":"Picturale fantasie\u00ebn : Po\u00ebtisch surrealisme","shortdescr":"Kunstenares Anne de Decker vindt schilderen een therapie, een uiting van haar creativiteit in muziek.\nHaar heldere, vrolijke schilderijen, doordrenkt met po\u00ebzie en fantasie, vallen op door hun heldere kleuren en surrealistische accenten. Haar picturale universum is een mix van invloeden, van Mondriaan tot Klimt, met een subtiele harmonie tussen geometrische vormen en royale rondingen.\n","longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/bxl.art-nft.gallery","email":"hello@art-nft.gallery","phone_contact":"+32 478 29 20 43","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50008581"}},"place":{"id":280672,"translations":{"de":{"name":"Art.NFT.Gallery","address_street_name":"Gare Maritime - Tour & Taxis Rue Picard","address_street_number":"9","address_street_box":"MODULE 8.3","email":"info@artecom.eu","website":"https:\/\/bxl.art-nft.gallery\/fr","phone_contact":"+32 478 29 20 43","phone_booki