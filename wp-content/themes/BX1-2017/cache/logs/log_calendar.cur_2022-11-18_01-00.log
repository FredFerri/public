],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-26T17:05:07+02:00","published_at":"2022-10-10T09:58:28+02:00","backoffice_id":263692,"import_origin":null,"sub_type":"concert","show_in_agenda":true,"ranking":0.29876031643714},{"id":539263,"date_start":"2022-08-01","date_end":"2022-12-31","date_next":"2022-12-31","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":true,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":90,"translations":{"fr":"Animations","nl":"Animaties","en":"Animations","de":"Animationen"}},"others":{"list":[99],"translations":{"fr":["Gastronomie"],"nl":["Gastronomie"],"en":["Gastronomy"],"de":["Gastronomie"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Atelier chocolat","shortdescr":"R\u00e9alisez vos propres tablettes de chocolat et autres sp\u00e9cialit\u00e9s chocolat\u00e9es.","longdescr":"Avec l\u2019aide d\u2019un chocolatier vous r\u00e9alisez une tablette personnalis\u00e9e, des sucettes, des mendiants et des d\u00e9corations en chocolat, que vous pourrez facilement refaire chez vous. \r\nL\u2019atelier dure entre 45 et 60 minutes. Du mat\u00e9riel professionnel est mis \u00e0 votre disposition.\r\nL\u2019atelier s\u2019adresse aux adultes et aux enfants \u00e0 partir de 8 ans. Les enfants de moins de 8 ans ne peuvent pas participer. Par ailleurs, les enfants de 8 \u00e0 12 ans doivent \u00eatre accompagn\u00e9s d\u2019un parent payant.","performers":"Les chocolatiers du mus\u00e9e partagent leur passion et leurs secrets avec vous.","boxoffice_url":null,"website":"http:\/\/www.choco-story-brussels.be","email":"info@choco-story-brussels.be","phone_contact":null,"phone_booking":"+32 488 29 15 44","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.539263"},"nl":{"name":"Chocolade Workshop","shortdescr":"Maak je eigen chocolade tabletten en andere heerlijke chocolaatjes.","longdescr":"Met de hulp van onze chocolatier, zullen jullie een chocoladetablet maken zowel als lollies, studentenhavers en andere leuke chocolade versieringen, die u thuis mag meenemen.\r\nDie workshop duurt tussen 45 en 60 minuten. Professioneel materiaal is ter beschikking.\r\nWie mag mee doen ? Zowel volwassenen als kinderen van minstens 8 jaar. De kinderen tussen 8 en 12 jaar blijven onder de verantwoordelijkheid van hun ouders en ze mogen die workshop niet bijleven zonder een volwassene die ook voor de workshop betaald heeft.","performers":"De chocolatiers van het museum bieden je de beste tips aan.","boxoffice_url":null,"website":null,"email":"info@choco-story-brussels.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.539263"},"en":{"name":"Chocolate Workshop","shortdescr":"Create you own personnalised chocolade tablet.","longdescr":"With the help of our chocolatier, you\u2019ll make chocolate tablets, mendiants, lollipops and some nice fantasy with chocolate.\r\nIt takes between 45 and 60 minutes. Professional material is provided.\r\nThis workshop is available for adults and children above 8 years. Children between 8 ans 12 years must be accompanied by an adult with a ticket for the worksop.","performers":"The chocolate Makers of the museum will learn you how to work with chocolate.","boxoffice_url":null,"website":null,"email":"info@choco-story-brussels.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.539263"},"de":{"name":"Atelier chocolat","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.539263"},"it":{"name":"Atelier chocolat","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.539263"},"sp":{"name":"Atelier chocolat","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.539263"},"pt":{"name":"Atelier chocolat","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.539263"},"cn":{"name":"Atelier chocolat","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.539263"}},"place":{"id":231977,"translations":{"fr":{"name":"Choco-Story Brussels","address_street_name":"Rue de l\u2019\u00c9tuve","address_street_number":"41","address_street_box":null,"email":"info@choco-story-brussels.be","website":"http:\/\/www.choco-story-brussels.be","phone_contact":"+32 2 514 20 48","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de l\u2019\u00c9tuve, 41","address_line2":"1000 Bruxelles","description_web":"Tout pr\u00e8s de la Grand-Place, Choco-Story Brussels vous plonge dans l\u2019univers du cacao et du chocolat depuis les origines du cacao il y plus de 5000 ans jusqu\u2019\u00e0 la c\u00e9l\u00e8bre praline belge. Vous commencez votre parcours en Amazonie, vous traversez un temple Azt\u00e8que avant d\u2019embarquer sur le bateau de Cort\u00e8s qui a ramen\u00e9 les f\u00e8ves de cacao en Europe. Vous d\u00e9couvrirez comment le cacao est transform\u00e9 en chocolat et comment il est sublim\u00e9 par nos chocolatiers. La visite se termine par la d\u00e9monstration artisanale de la praline et des d\u00e9gustations. \r\nChez Choco-Story Brussels, deux types d\u2019ateliers sont propos\u00e9s : L\u2019atelier tablette et mendiants qui a lieu tous les jours, sur r\u00e9servation, accessible pour les individuels (adultes et enfants \u00e0 partir de 8 ans) et les groupes. La visite du mus\u00e9e est incluse dans le prix. Et l\u2019Atelier praline pour d\u00e9couvrir les secrets de la fabrication de la praline. Vous cr\u00e9ez 4 recettes en compagnie du chocolatier. L\u2019atelier est accessible pour les petits groupes de 4 \u00e0 16 personnes, uniquement sur r\u00e9servation. \r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Choco-Story Brussels","address_street_name":"Stoofstraat","address_street_number":"41","address_street_box":null,"email":"info@choco-story-brussels.be","website":"http:\/\/www.choco-story-brussels.be","phone_contact":"+32 2 514 20 48","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Stoofstraat, 41","address_line2":"1000 Brussel","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Choco-Story Brussels","address_street_name":"Rue de l\u2019\u00c9tuve","address_street_number":"41","address_street_box":null,"email":"info@choco-story-brussels.be","website":"http:\/\/www.choco-story-brussels.be","phone_contact":"+32 2 514 20 48","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue de l\u2019\u00c9tuve, 41","address_line2":"1000 Brussels","description_web":"An  interactive and greedy travel at the Choco Story Brussels Museum. Take a dive in the universe of cocoa and chocolate, pass a Maya temple where cocoa beans have been consumed 5000 years ago, step aboard the boat of Cortez who imported the cocoa beans in Europe; discover how chocolate was being used at the French Court in the 17th Century and afterwards how the \u201cpraline\u201d was crafted beginning of the 20th Century in Belgium. The cocoa culture and its transformation won\u2019t have any secrets left for you. Demonstration, tasting and audio guide are included in the visit.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Choco-Story Brussels","address_street_name":"Rue de l\u2019\u00c9tuve","address_street_number":"41","address_street_box":null,"email":"info@choco-story-brussels.be","website":"http:\/\/www.choco-story-brussels.be","phone_contact":"+32 2 514 20 48","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de l\u2019\u00c9tuve, 41","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Choco-Story Brussels","address_street_name":"Rue de l\u2019\u00c9tuve","address_street_number":"41","address_street_box":null,"email":"info@choco-story-brussels.be","website":"http:\/\/www.choco-story-brussels.be","phone_contact":"+32 2 514 20 48","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de l\u2019\u00c9tuve, 41","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Choco-Story Brussels","address_street_name":"Rue de l\u2019\u00c9tuve","address_street_number":"41","address_street_box":null,"email":"info@choco-story-brussels.be","website":"http:\/\/www.choco-story-brussels.be","phone_contact":"+32 2 514 20 48","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de l\u2019\u00c9tuve, 41","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Choco Story Brussel