ay, saturday and sunday: from 14:00 to 18:00"],"sp":["monday and tuesday: closed","wednesday, thursday, friday, saturday and sunday: from 14:00 to 18:00"],"pt":["monday and tuesday: closed","wednesday, thursday, friday, saturday and sunday: from 14:00 to 18:00"],"cn":["monday and tuesday: closed","wednesday, thursday, friday, saturday and sunday: from 14:00 to 18:00"]},"date_start":"2023-05-01","date_end":"2023-07-15","is_also_by_appointment":true}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"opening":{"day":"2023-05-12","start":"18:00:00","timestamp":"2023-05-12T18:00:00+02:00","end":"22:00:00","is_only_by_appointment":true},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-07-08T03:08:40+02:00","published_at":"2023-04-19T14:04:19+02:00","backoffice_id":275736,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.23608159785434},{"id":545893,"date_start":"2023-03-17","date_end":"2023-09-03","date_next":"2023-07-08","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":true,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung","it":"Esposizioni","sp":"Exhibici\u00f3n","pt":null,"cn":null}},"others":{"list":[36,48],"translations":{"fr":["Mus\u00e9es et art centers","Architecture"],"nl":["Musea en kunstcentra","Architectuur"],"en":["Museums and art centers","Architecture "],"de":["Museen & Kunstzentren","Architektur"],"it":["Musei e centri artistici","Architettura"],"sp":["Museos y centros de arte","Arquitectura"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Style Congo","shortdescr":"\"Style Congo\" explore les politiques de repr\u00e9sentation et d'appropriation culturelles \u00e0 travers des interventions artistiques et architecturales contemporaines et des documents et mat\u00e9riels historiques issus des collections du CIVA. L'exposition retrace la repr\u00e9sentation du Congo lors des expositions internationales organis\u00e9es entre 1885 et 1958, en utilisant l'Art nouveau comme point d'ancrage.","longdescr":"\"Style Congo. Heritage and Heresy\" explore les politiques de repr\u00e9sentation et d'appropriation culturelles \u00e0 travers des interventions artistiques et architecturales contemporaines ainsi que des documents et mat\u00e9riaux historiques issus des collections du CIVA. L'exposition propose une chronique visuelle de la repr\u00e9sentation du Congo lors des expositions internationales organis\u00e9es entre 1885 et 1958, en prenant comme point d\u2019appui l'Art nouveau. Ce mouvement - appel\u00e9 \u00e0 l'\u00e9poque \"Style Congo\" - co\u00efncide avec l'exploitation du Congo par le roi L\u00e9opold II et refl\u00e8te une fascination g\u00e9n\u00e9ralis\u00e9e pour les mat\u00e9riaux et les formes \"exotiques\".\r\n\r\nLes \u0153uvres de l'exposition remettent en question et d\u00e9stabilisent les histoires canoniques et les racines coloniales de cet h\u00e9ritage. En examinant les marques de la colonisation dans la ville de Bruxelles et dans le paysage urbain congolais, ils pr\u00e9sentent une r\u00e9signification d\u00e9coloniale des espaces priv\u00e9s et publics, et cherchent \u00e0 r\u00e9\u00e9crire les marges de l'histoire au centre.","performers":"CIVA, KANAL-Centre Pompidou, Living Traces, Twenty Nine Studio\r\nSammy Baloji, Silvia Franceschini, Nikolaus Hirsch, Estelle Lecaille, Judith Barry, Rossella Biscotti, Peggy Buth, Ayoh Kr\u00e9 Duch\u00e2telet, Jean Katambayi, Johan Lagae & Paoletta Holst, Chrystel Mukeba, Daniela Ortiz, Ruth Sacks, Traumnovelle","boxoffice_url":null,"website":"http:\/\/www.civa.brussels","email":"info@civa.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.545893"},"nl":{"name":"Style Congo","shortdescr":"\"Style Congo\" verkent de politiek van culturele representatie en toe-eigening aan de hand van hedendaagse artistieke en architecturale interventies en historische documenten en materiaal uit CIVA collecties. De tentoonstelling beschrijft de voorstelling van Congo op internationale tentoonstellingen tussen 1885 en 1958, met de art nouveau als uitgangspunt.","longdescr":"\"Style Congo. Heritage and Heresy\" verkent de politiek van culturele representatie en toe-eigening aan de hand van zowel hedendaagse artistieke en architecturale interventies als historische documenten en materiaal uit de CIVA-collecties. De tentoonstelling brengt een visuele kroniek van de vertegenwoordiging van Congo op wereldtentoonstellingen die tussen 1885 en 1958 werden georganiseerd en neemt daarbij de art nouveau als ankerpunt. Die stroming - destijds ook wel Congostijl genoemd - viel samen met de exploitatie van Congo door koning Leopold II en weerspiegelt een wijdverbreide fascinatie voor \"exotische\" materialen en vormen.\r\n\r\nDe werken in de tentoonstelling bevragen en destabiliseren de canonieke geschiedenissen en koloniale wortels van dit erfgoed. Door de sporen van de kolonisatie in de stad Brussel en in het Congolese stedelijke landschap te onderzoeken, vormen ze een dekoloniale herschikking van private en publieke ruimtes, waarbij getracht wordt de marges van de geschiedenis te herschrijven naar het centrum.","performers":"CIVA, KANAL-Centre Pompidou, Living Traces, Twenty Nine Studio\r\nSammy Baloji, Silvia Franceschini, Nikolaus Hirsch, Estelle Lecaille, Judith Barry, Rossella Biscotti, Peggy Buth, Ayoh Kr\u00e9 Duch\u00e2telet, Jean Katambayi, Johan Lagae & Paoletta Holst, Chrystel Mukeba, Daniela Ortiz, Ruth Sacks, Traumnovelle","boxoffice_url":null,"website":"http:\/\/www.civa.brussels","email":"info@civa.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.545893"},"en":{"name":"Style Congo. Heritage & Heresy","shortdescr":"\u201cStyle Congo\u201d explores the politics of cultural representation and appropriation through contemporary artistic and architectural interventions as well as historic documents and materials from CIVA\u2019s collections. The exhibition chronicles the representation of Congo in international expositions held between 1885 and 1958, using Art Nouveau as its anchor point.","longdescr":"\u201cStyle Congo. Heritage and Heresy\u201d explores the politics of cultural representation and appropriation through contemporary artistic and architectural interventions as well as historic documents and materials from CIVA's collections. The exhibition visually chronicles the representation of Congo in international expositions held between 1885 and 1958, using Art Nouveau as its anchor point. The movement\u2014at the time also called Style Congo\u2014coincided with King Leopold II\u2019s exploitation of the Congo and reflects a widespread fascination with \u201cexotic\u201d materials and forms.\r\n\r\nThe works in the exhibition question and destabilize canonical histories and the colonial roots of this heritage. By examining marks of colonization in the city of Brussels and in the Congolese urban landscape, they present a decolonial resignification of private and public spaces, seeking to rewrite the margins of history into the center.\r\n\r\nCIVA, KANAL-Centre Pompidou, Living Traces, Twenty Nine Studio\r\nSammy Baloji, Silvia Franceschini, Nikolaus Hirsch, Estelle Lecaille, Judith Barry, Rossella Biscotti, Peggy Buth, Ayoh Kr\u00e9 Duch\u00e2telet, Jean Katambayi, Johan Lagae & Paoletta Holst, Chrystel Mukeba, Daniela Ortiz, Ruth Sacks, Traumnovelle","performers":null,"boxoffice_url":null,"website":"http:\/\/www.civa.brussels","email":"info@civa.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.545893"},"de":{"name":"Style Congo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.civa.brussels","email":"info@civa.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.545893"},"it":{"name":"Style Congo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.civa.brussels","email":"info@civa.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.545893"},"sp":{"name":"Style Congo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.civa.brussels","email":"info@civa.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.545893"},"pt":{"name":"Style Congo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.civa.brussels","email":"info@civa.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.545893"},"cn":{"name":"Style Congo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.civa.brussels","email":"info@civa.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.545893"}},"place":{"id":235577,"translations":{"fr":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"CIVA est un muse\u0301e, un centre d'archives, une bibliothe\u0300que et un lieu de rencontre pour les amateurs d'architecture, d'architecture paysage\u0300re, d'e\u0301cosyste\u0300mes urbains et d'histoire a\u0300 Bruxelles. Tout au long de l'anne\u0301e, vous pouvez vous y rendre pour des expositions temporaires, des confe\u0301rences, des de\u0301bats, des visites guide\u0301es, des lancements de livres et des activite\u0301s pour les enfants. Les activite\u0301s se trouvent a\u0300 Ixelles, pre\u0300s de la Place Flagey et au centre de Bruxelles, a\u0300 KANAL - Centre Pompidou.\r\n\r\n","description_print":"","booking_url":null,"sort_order":"CIVA","virtual_visit":null},"nl":{"name":"CIVA","address_street_name":"Kluisstraat","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"Kluisstraat","address_line2":"1050 Elsene","description_web":"CIVA is een museum, een archiefcentrum, een bibliotheek en een ontmoetingsplek voor liefhebbers van architectuur, landschapsarchitectuur, stadsecosystemen en geschiedenis in Brussel. Het hele jaar door kan je er terecht voor tijdelijke tentoonstellingen, lezingen, debatten, rondleidingen, book launches en kinderactiviteiten. De activiteiten vind je in Elsene, vlakbij het Flageyplein en in Brussel-centrum, in KANAL \u2013 Centre Pompidou.","description_print":"","booking_url":null,"sort_order":"CIVA","virtual_visit":null},"en":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"CIVA is a museum, an archive center, a library and a meeting place for lovers of architecture, landscape architecture, urban ecosystems and history in Brussels. Throughout the year, CIVA organizes temporary exhibitions, lectures, debates, guided tours, book launches and activities for children. The activities are organized in Ixelles, near Place Flagey and in the center of Brussels, in KANAL - Centre Pompidou.","description_print":"","booking_url":null,"sort_order":"CIVA","virtual_visit":null},"de":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"Das Architekturzentrum CIVA, das 2016 auf Betreiben der Region Br\u00fcssel-Hauptstadt ins Leben gerufen wurde, vereint in einer einzigen Struktur Ressourcen, Wissen und Know-how verschiedener Br\u00fcsseler Vereine aus dem Bereich Kultur, Architektur, St\u00e4dteplanung, Landschaftsarchitektur und Forschungen zum \u00d6kosystem: die Archive f\u00fcr moderne Architektur, die Bibliothek Ren\u00e9 Pech\u00e8re, der Architekturfonds und das Centre Paul Duvigneaud.\r\nMit ihrem kulturellen Projekt tr\u00e4gt die Fondation CIA zur Entwicklung einer architektonischen, landschaftsarchitektonischen und st\u00e4dteplanerischen Kultur bei, die sich mit den Herausforderungen der Gegenwart auseinandersetzt. Schwerpunkt ist Br\u00fcssel. \r\n\r\nDie Fondation CIVA bietet eine ganze Reihe von Aktivit\u00e4ten und Angeboten: Ausstellungen, Konferenzen, Orte des Austauschs und der Debatten, p\u00e4dagogische Aktivit\u00e4ten, Archiveinblicke und Bibliotheken mit knapp 40.000 Werken und Zeitschriften zu den Themen Architektur, St\u00e4dteplanung, Stadtgeschichte, Landschaften, G\u00e4rten und urbane \u00d6kosysteme.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"Creado en 2016 por iniciativa de la Regi\u00f3n Bruselas-Capital, el CIVA re\u00fane una \u00fanica estructura de recursos, conocimiento y aprendizaje de varias asociaciones culturales activas en Bruselas en los campos de la arquitectura, urbanismo, paisajes y el estudio de ecosistemas: los Archivos de Arquitectura Moderna, la Biblioteca Ren\u00e9 Pech\u00e8re, los Fondos para la arquitectura, el Centro Paul Duvigneaud y el CIVA asbl, ahora disuelto.\r\nA trav\u00e9s de este proyecto cultural, la Fundaci\u00f3n CIVA contribuye al desarrollo del paisaje arquitect\u00f3nico y la cultura urbana como base para afrontar desaf\u00edos contempor\u00e1neos, poniendo especial \u00e9nfasis en Bruselas.\r\nSiempre tiene \u00e9xito a la hora de cumplir sus objetivos y tratar con un p\u00fablico amplio (adultos y ni\u00f1os, estudiantes, investigadores, arquitectos, paisajistas, amantes de la naturaleza, pol\u00edticos, etc), la fundaci\u00f3n CIVA organiza numerosos eventos y actividades en diferentes lugares, incluyendo exhibiciones permanentes y temporales, conferencias, debates y actividades educativas. Tambi\u00e9n dispone archivos excepcionales abiertos para todos los p\u00fablicos (documentos de arquitectos y paisajistas: planos, bocetos, modelos, muebles, etc.) y librer\u00edas que contienen casi 40.000 obras y peri\u00f3dicos de arquitectura, urbanismo, la historia de los pueblos y ciudades, paisajes, jardines y ecolog\u00eda urbana.\r\nEstas actividades y materiales est\u00e1n dise\u00f1ados para despertar la curiosidad y el inter\u00e9s de todo nuestro entorno, ya sea un hecho hist\u00f3rico o una construcci\u00f3n.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"CIVA","address_street_name":"Rue de l'Ermitage","address_street_number":null,"address_street_box":null,"email":"info@civa.brussels","website":"http:\/\/www.civa.brussels","phone_contact":"+32 2 642 24 50","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Ermitage","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[5],"translations":{"fr":["Flagey"],"nl":["Flagey"],"en":["Flagey"],"de":["Flagey"],"it":["Flagey"],"sp":["Flagey"],"pt":[null],"cn":[null]}},"zones":{"list":[21],"translations":{"fr":["Sud"],"nl":["Zuid"],"en":["South"],"de":["S\u00fcden"],"it":["Sud"],"sp":["Sur"],"pt":[null],"cn":[null]}},"neca":"art_center","facebook_id":null,"backoffice_id":1436,"location":{"lat":50.82873218,"lon":4.36569034},"region":"brussels","last_updated_at":"2023-07-08T03:05:20+02:00","published_at":"2013-10-19T0