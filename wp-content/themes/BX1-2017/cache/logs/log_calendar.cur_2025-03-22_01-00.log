rl":null,"website":"http:\/\/www.ccu.be","email":"reservation@ccu.be","phone_contact":"+32 2 374 04 95","phone_booking":"+32 2 374 64 84","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700000067"},"it":{"name":"As Salem aleykoum \/\/ Irr\u00e9v\u00e9rence Festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.ccu.be","email":"reservation@ccu.be","phone_contact":"+32 2 374 04 95","phone_booking":"+32 2 374 64 84","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700000067"},"cn":{"name":"As Salem aleykoum \/\/ Irr\u00e9v\u00e9rence Festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.ccu.be","email":"reservation@ccu.be","phone_contact":"+32 2 374 04 95","phone_booking":"+32 2 374 64 84","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700000067"},"fr":{"name":"As Salem aleykoum \/\/ Irr\u00e9v\u00e9rence Festival","shortdescr":"\u00ab J\u2019appartiens \u00e0 l\u2019identit\u00e9 de l\u2019entre-deux qui n\u2019a pas de patrie. Alors aujourd\u2019hui, je me l\u00e8ve pour te parler. Et je ne le fais pas seul. \u00bb","longdescr":"\u00ab Au centre du spectacle se trouve la fronti\u00e8re. Celle que nos parents ont d\u00fb traverser avant m\u00eame que l\u2019on vienne au monde. H\u00e9riti\u00e8res et h\u00e9ritiers de cette identit\u00e9 de \u201cliaison\u201d - nous pensons avoir le devoir de ne pas fuir le dialogue mais de le provoquer. Alors, en nous appuyant sur la fronti\u00e8re qui s\u00e9pare les spectateurs et spectatrices des interpr\u00e8tes, nous allons ensemble tenter de donner naissance \u00e0 un rituel d'accueil capable de gu\u00e9rir nos histoires. Que la fronti\u00e8re devienne le catalyseur d\u2019un esprit commun, c\u2019est l'enjeu de ce temps que nous occupons tous.tes. Et aucune chance d\u2019\u00e9chec avec un As Salem Aleykoum (\u0627\u0644\u0633\u0627\u0644\u0645 \u0639\u0644\u064a\u0643\u0645) - que la paix soit sur toi - en guise de bienvenue. \u00bb","performers":"Avec Edson Anibal, Jean-Marc Judith, Louise Moret, Warda Rammach, Alex Lobo ou Judith Gaillard Hwang, Mik Talib, Mehdi Zekhnini\nMise en sc\u00e8ne Jonathan Moncef et Kibani Boussaleh\nSc\u00e9nographie Aylyn Bendehina","boxoffice_url":null,"website":"http:\/\/www.ccu.be","email":"reservation@ccu.be","phone_contact":"+32 2 374 04 95","phone_booking":"+32 2 374 64 84","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700000067"},"sp":{"name":"As Salem aleykoum \/\/ Irr\u00e9v\u00e9rence Festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.ccu.be","email":"reservation@ccu.be","phone_contact":"+32 2 374 04 95","phone_booking":"+32 2 374 64 84","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700000067"},"nl":{"name":"As Salem aleykoum \/\/ Irr\u00e9v\u00e9rence Festival","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.ccu.be","email":"reservation@ccu.be","phone_contact":"+32 2 374 04 95","phone_booking":"+32 2 374 64 84","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700000067"}},"place":{"id":7929,"translations":{"de":{"name":"Centre Culturel d'Uccle","address_street_name":"Rue Rouge","address_street_number":"47","address_street_box":null,"email":"reservation@ccu.be","website":"http:\/\/www.ccu.be","phone_contact":"+32 2 374 64 84","phone_booking":"+32 2 374 64 84","address_zip":"1180","address_city":"Uccle","address_line1":"Rue Rouge, 47","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Centre Culturel d'Uccle","address_street_name":"Rue Rouge","address_street_number":"47","address_street_box":null,"email":"reservation@ccu.be","website":"http:\/\/www.ccu.be","phone_contact":"+32 2 374 64 84","phone_booking":"+32 2 374 64 84","address_zip":"1180","address_city":"Uccle","address_line1":"Rue Rouge, 47","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Centre Culturel d'Uccle","address_street_name":"Rodestraat","address_street_number":"47","address_street_box":null,"email":"reservation@ccu.be","website":"http:\/\/www.ccu.be","phone_contact":"+32 2 374 64 84","phone_booking":"+32 2 374 64 84","address_zip":"1180","address_city":"Uccle","address_line1":"Rodestraat, 47","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Centre Culturel d'Uccle","address_street_name":"Rue Rouge","address_street_number":"47","address_street_box":null,"email":"reservation@ccu.be","website":"http:\/\/www.ccu.be","phone_contact":"+32 2 374 64 84","phone_booking":"+32 2 374 64 84","address_zip":"1180","address_city":"Uccle","address_line1":"Rue Rouge, 47","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Centre Culturel d'Uccle","address_street_name":"Rue Rouge","address_street_number":"47","address_street_box":null,"email":"reservation@ccu.be","website":"http:\/\/www.ccu.be","phone_contact":"+32 2 374 64 84","phone_booking":"+32 2 374 64 84","address_zip":"1180","address_city":"Uccle","address_line1":"Rue Rouge, 47","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Centre Culturel d'Uccle","address_street_name":"Rue Rouge","address_street_number":"47","address_street_box":null,"email":"reservation@ccu.be","website":"http:\/\/www.ccu.be","phone_contact":"+32 2 374 64 84","phone_booking":"+32 2 374 64 84","address_zip":"1180","address_city":"Uccle","address_line1":"Rue Rouge, 47","address_line2":"1180 Uccle","description_web":"Le Centre culturel d\u2019Uccle est contemporain de l\u2019Atomium. Con\u00e7u pour se trouver dans un \u00e9crin de verdure, face au Parc du Wolvendael, la premi\u00e8re pierre fut pos\u00e9e le 30 novembre 1957. Le Centre Culturel et Artistique d\u2019Uccle fut inaugur\u00e9 le 5 octobre 1958.\nLe CCU est une \u0153uvre de l\u2019architecte L\u00e9on Stynen, qui avait aussi con\u00e7u les casinos de Knokke, Blankenberge et Ostende.\nCe nouveau Centre Culturel permit aux soci\u00e9t\u00e9s et associations int\u00e9ress\u00e9es d\u2019organiser des bals, des conf\u00e9rences, des concerts, des projections de films, des d\u00e9bats et toutes autres manifestations culturelles et artistiques (ballets, concerts, expositions, r\u00e9ceptions, \u2026). Il proposait aussi des repr\u00e9sentations th\u00e9\u00e2trales, un cycle de conf\u00e9rences et des spectacles musicaux.\nL'ensemble du b\u00e2timent abrite principalement un hall d\u2019entr\u00e9e donnant acc\u00e8s \u00e0 une grande Salle de Spectacle de 800 fauteuils, un Grand Foyer pouvant accueillir jusqu'\u00e0 400 personnes assises, ainsi qu'un Petit Foyer pouvant contenir 120 personnes.\nPlus de cinquante ans apr\u00e8s sa cr\u00e9ation, le Centre Culturel d\u2019Uccle r\u00e9nov\u00e9 a un look \u00e0 la fois contemporain et chaleureux. Pleinement actif, il r\u00e9pond aux d\u00e9fis culturels de son si\u00e8cle en accueillant les plus grands noms du th\u00e9\u00e2tre, de la danse, de la chanson et de la musique ainsi que des artistes et des conf\u00e9renciers de renom. Il s\u2019est constamment modernis\u00e9 pour offrir \u00e0 son public une vie culturelle de qualit\u00e9 au c\u0153ur de la commune d\u2019Uccle.\nDirig\u00e9 par une \u00e9quipe dynamique, le CCU met tout en \u0153uvre pour fid\u00e9liser sa client\u00e8le et conqu\u00e9rir sans cesse un public nouveau.\nLe Centre Culturel d\u2019Uccle en quelques chiffres, c\u2019est : \n- Un des plus grands centres culturels \u00e0 Bruxelles et ses environs,\n- Un rendez-vous des professionnels du spectacle,\n- 3 espaces bien distincts ( Grand Foyer, Petit Foyer, Salle de Spectacle),\n- Une salle de spectacle de 800 places,\n- Un gradin r\u00e9tractable de 162 places,\n- 200 activit\u00e9s par an,\n- 600 artistes par saison,\n- 50.000 spectateurs par an.\n\n-----\n\nHoraires Bureaux  > du lundi au vendredi : 9h00 > 12h00 \u2013 14h00 > 17h00\n\nR\u00e9servations > du mardi au vendredi : 11h00 > 18h00 et  1h avant les spectacles\n(ferm\u00e9 de mi-juillet \u00e0 mi-ao\u00fbt)\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Centre Culturel d'Uccle","address_street_name":"Rue Rouge","address_street_number":"47","address_street_box":null,"email":"reservation@ccu.be","website":"http:\/\/www.ccu.be","phone_contact":"+32 2 374 64 84","phone_booking":"+32 2 374 64 84","address_zip":"1180","address_city":"Uccle","address_line1":"Rue Rouge, 47","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"CC Ukkel","address_street_name":"Rodestraat","address_street_number":"47","address_street_box":null,"email":"info@ccu.be","website":"http:\/\/www.ccu.be","phone_contact":"+32 2 374 64 84","phone_booking":"+32 2 374 64 84","address_zip":"1180","address_city":"Ukkel","address_line1":"Rodestraat, 47","address_line2":"1180 Ukkel","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[21],"translations":{"de":["S\u00fcden"],"pt":[null],"en":["South"],"it":["Sud"],"cn":[null],"fr":["Sud"],"sp":["Sur"],"nl":["Zuid"]}},"neca":null,"facebook_id":null,"backoffice_id":320,"location":{"lat":50.8010349,"lo