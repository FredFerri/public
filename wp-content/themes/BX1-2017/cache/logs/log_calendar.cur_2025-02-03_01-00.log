erciale dans les ann\u00e9es de l\u2019entre deux guerres. Effervescence qui se refl\u00e8te aussi dans les lieux de loisirs: entre th\u00e9\u00e2tres et bars d\u2019\u00e9poque, c\u2019est tout un chapitre de vie Bruxelloise que votre guide vous d\u00e9voilera.\n","performers":null,"boxoffice_url":null,"website":"https:\/\/www.itineraires.be\/art-nouveau-art-deco","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700005252"},"sp":{"name":"Art D\u00e9co autour du Canal","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.itineraires.be\/art-nouveau-art-deco","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700005252"},"nl":{"name":"Art D\u00e9co autour du Canal","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.itineraires.be\/art-nouveau-art-deco","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700005252"}},"place":{"id":275433,"translations":{"de":{"name":"Angle Avenue de l'H\u00e9liport \/ Avenue Baudouin (sortie M\u00e9tro Yser)","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Angle Avenue de l'H\u00e9liport \/ Avenue Baudouin (sortie M\u00e9tro Yser)","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Angle Avenue de l'H\u00e9liport \/ Avenue Baudouin (sortie M\u00e9tro Yser)","address_street_name":null,"address_street_number":null,"address_street_box