,"published_at":"2021-10-25T08:57:01+02:00","backoffice_id":241565,"import_origin":null,"sub_type":"other","show_in_agenda":true,"ranking":0.16297813360438},{"id":535489,"date_start":"2022-06-12","date_end":"2022-06-12","date_next":"2022-06-12","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{"list":[255],"translations":{"fr":["Visites d'expositions"],"nl":["Tentoonstelling"],"en":["Exhibition guided tours"]}}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Visite guid\u00e9e expo Haute Tension","shortdescr":"Pas encore eu l\u2019occasion de voir l\u2019exposition HAUTE TENSION ?","longdescr":"Pas encore eu l\u2019occasion de voir l\u2019exposition HAUTE TENSION ? Envie de la revoir accompagn\u00e9\u00b7e d\u2019un\u00b7e guide qui vous r\u00e9v\u00e8lera les secrets des \u0153uvres expos\u00e9es ? Joignez-vous \u00e0 la visite guid\u00e9e du 12 juin !\r\n\r\nR\u00e9servation : accueil@artetmarges.be | visite comprise dans votre prix d\u2019entr\u00e9e | FR\/NL","performers":null,"boxoffice_url":null,"website":"http:\/\/www.artetmarges.be","email":"info@artetmarges.be","phone_contact":"+32 2 533 94 90","phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/535489.html"},"nl":{"name":"Visite guid\u00e9e expo Haute Tension","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.artetmarges.be","email":"info@artetmarges.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/535489.html"},"en":{"name":"Visite guid\u00e9e expo Haute Tension","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/535489.html"},"de":{"name":"Visite guid\u00e9e expo Haute Tension","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/535489.html"},"it":{"name":"Visite guid\u00e9e expo Haute Tension","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/535489.html"},"sp":{"name":"Visite guid\u00e9e expo Haute Tension","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/535489.html"},"pt":{"name":"Visite guid\u00e9e expo Haute Tension","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/535489.html"},"cn":{"name":"Visite guid\u00e9e expo Haute Tension","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/535489.html"}},"place":{"id":738,"translations":{"fr":{"name":"Art et marges mus\u00e9e","address_street_name":"Rue Haute","address_street_number":"314","address_street_box":null,"email":"info@artetmarges.be","website":"http:\/\/www.artetmarges.be","phone_contact":"+32 2 533 94 90","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Haute, 314","address_line2":"1000 Bruxelles","description_web":"Situ\u00e9 au c\u0153ur de Bruxelles, le Art et marges mus\u00e9e, mus\u00e9e d\u2019art brut - contemporain - outsider art, questionne l\u2019art et ses fronti\u00e8res. Sa collection s\u2019est constitu\u00e9e d\u00e8s le milieu des ann\u00e9es 80 aupr\u00e8s d\u2019artistes autodidactes, d\u2019ateliers artistiques pour personnes porteuses d\u2019un handicap mental ou d\u2019ateliers en milieu psychiatrique. Elle se compose aujourd\u2019hui de plus de 4000 \u0153uvres internationales produites en dehors des sentiers fr\u00e9quent\u00e9s de l\u2019art. Ses expositions temporaires, au rythme de deux \u00e0 trois par an, m\u00ealent artistes de part et d\u2019autre de la marge et questionnent l\u2019art et sa d\u00e9finition-m\u00eame. ","description_print":"Mus\u00e9e d'art outsider","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Art & marges museum","address_street_name":"Hoogstraat","address_street_number":"314","address_street_box":null,"email":"info@artetmarges.be","website":"http:\/\/www.artetmarges.be","phone_contact":"+32 2 533 94 90","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Hoogstraat, 314","address_line2":"1000 Brussel","description_web":"Outsiderkunst museum. Sinds zijn oprichting in 1984 en de eerste tentoonstelling in 1986, verdedigt de vzw Art en Marge - het huidige art )&( marges museum - kunstenaars die uit de boot van het offici\u00eble culturele circuit vallen. Die autodidactische kunstenaars worden \u201coutsiders\u201d genoemd en werken alleen of in creatieve workshops voor zieke of gehandicapte personen. Naast de permanente verzameling, zorgen tijdelijke tentoonstellingen voor een dynamische dialoog met de werken van professionele kunstenaars die actief zijn in het offici\u00eble culturele milieu, om de grenzen van de in- en outsiderkunst af te tasten. art )&( marges museum is geen ghettomuseum maar een plaats van uitwisseling, een ruimte waarin de individualiteit hoogtij viert en waarin alles in het werk gesteld wordt om ervoor te zorgen dat alle doelgroepen zich thuis voelen.\r\n\r\nOpen op vrijdag, zaterdag en zondag tussen 11.00 en 17.30 uur, alleen op afspraak.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Art & marges museum","address_street_name":"Rue Haute","address_street_number":"314","address_street_box":null,"email":"info@artetmarges.be","website":"http:\/\/www.artetmarges.be","phone_contact":"+32 2 533 94 90","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue Haute, 314","address_line2":"1000 Brussels","description_web":"Museum of outsider art. Since its founding in 1984 and the first exhibition of 1986, Art & Marge \u2013 now the \u2018art )&( marges [margins] museum\u2019 \u2013 promotes artists outside the mainstream. These self-taught artists, often called \u201coutsider artists\u201d, work either individually or in creative workshops in institutions for people who are mentally unwell or who are mentally challenged. In addition to the permanent collection,  temporary exhibitions will establish a dynamic dialogue with paintings by professional artists from the mainstream who are active in their cultural surroundings \u2013 the boundary between \u2018insider\u2019 and \u2018outsider\u2019 art?   The \u2018Art & Marges\u2019 museum is not a ghetto museum but a venue for exchange, where individuality is of prime importance and where all efforts are made to make all target groups feel at home.\r\n\r\nOpen Fridays, Saturdays and Sundays between 11.00 am and 5.30 pm by appointment only.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Mus\u00e9e Art et marges","address_street_name":"Rue Haute","address_street_number":"314","address_street_box":null,"email":"info@artetmarges.be","website":"http:\/\/www.artetmarges.be","phone_contact":"+32 2 533 94 90","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Haute, 314","address_line2":"1000 Bruxelles","description_web":"Art brut - Outsider Art - Zeitgen\u00f6ssische Kunst\r\n\r\nDas Museum Art et Marges zeigt eine Sammlung, die seit den 1980er-Jahren kontinuierlich w\u00e4chst. Dabei handelt es sich um Kunst abseits des Mainstreams, die einen Blick auf die autodidaktischen K\u00fcnslter wirft, Kunstateliers f\u00fcr Menschen mit geistiger Behinderung oder in Psychiatrien. \r\nIn den Ausstellungen mischen sich K\u00fcnstler diesseits und jenseits der Grenze des \"Au\u00dfenseitertums\" (engl. Begriff \"Art Outsider\"), die die Kunst und deren Beschr\u00e4nkungen hinterfragt.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Mus\u00e9e Art et marges","address_street_name":"Rue Haute","address_street_number":"314","address_street_box":null,"email":"info@artetmarges.be","website":"http:\/\/www.artetmarges.be","phone_contact":"+32 2 533 94 90","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Haute, 314","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Museo Art)&(Marges","address_street_name":"Rue Haute","address_street_number":"314","address_street_box":null,"email":"info@artetmarges.be","website":"http:\/\/www.artetmarges.be","phone_contact":"+32 2 533 94 90","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Haute, 314","address_line2":"1000 Bruxelles","description_web":"Desde su creaci\u00f3n, el Centro de Investigaci\u00f3n y Difusi\u00f3n del arte outsider Art en Marge (que se convirti\u00f3 posteriormente en el museo Art)&Marges) aboga por los artistas que no forman parte del circuito cultural oficial. Los conocidos actualmente como \u00aboutsiders\u00bb (ver glosario) son creadores autodidactas que trabajan solos o en talleres creativos para personas psicol\u00f3gicamente vulnerables o con alguna 