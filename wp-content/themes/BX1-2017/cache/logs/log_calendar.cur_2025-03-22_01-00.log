ingen voor geleide bezoeken in Brussel. Deze organisatie omvat ARAU, Arkadia, Bruxelles Bavard, Pro Velo, La Fonderie en Korei. De evenementen worden georganiseerd in coproductie met deze 6 bedrijven. Individuele of groepstochten zijn mogelijk te voet, per fiets, per bus en per boot.  Bezoekers ontdekken UNESCO erfgoed, Magritte, art deco, chocolade en nog veel meer. Explore.Brussels organiseert ook Brusselse festivals en andere grootschalige projecten.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":27246,"location":{"lat":50.80795462,"lon":4.34397082},"last_updated_at":"2024-05-29T15:24:29+02:00","published_at":"2017-02-27T10:05:49+01:00","is_in_address_book":false,"is_in_vb_export":false,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/260c937e3a59a0648fc4fa3b1565e48af941e1bb.JPG","width":2126,"height":1417,"ratio":1.5,"oEmbed_height":1417,"oEmbed_width":2126,"translations":{"de":{"title":"Maison Van Eycken","copyright":"\u00a9Serge Brison"},"pt":{"title":"Maison Van Eycken","copyright":"\u00a9Serge Brison"},"en":{"title":"Maison Van Eycken","copyright":"\u00a9Serge Brison"},"it":{"title":"Maison Van Eycken","copyright":"\u00a9Serge Brison"},"cn":{"title":"Maison Van Eycken","copyright":"\u00a9Serge Brison"},"fr":{"title":"Maison Van Eycken","copyright":"\u00a9Serge Brison"},"sp":{"title":"Maison Van Eycken","copyright":"\u00a9Serge Brison"},"nl":{"title":"Maison Van Eycken","copyright":"\u00a9Serge Brison"}}}],"dates":[{"day":"2025-03-29","doors":"10:00:00","start":"10:00:00","end":"17:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2025-03-30","doors":"10:00:00","start":"10:00:00","end":"17:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"de":{"name":"Studierende"},"en":{"name":"Student