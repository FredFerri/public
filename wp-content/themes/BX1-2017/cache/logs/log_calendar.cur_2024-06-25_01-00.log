7-05","date_next":"2024-06-24","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-06-22T03:01:00+02:00","published_at":"2024-04-19T13:02:07+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":298676,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.43679023236814946,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{}},"translations":{"de":{"name":"Pattrns de Ruben Voka","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.espacemagh.be","email":"reservation@espacemagh.be","phone_contact":"+32 2 274 05 10","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50009857"},"pt":{"name":"Pattrns de Ruben Voka","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.espacemagh.be","email":"reservation@espacemagh.be","phone_contact":"+32 2 274 05 10","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50009857"},"en":{"name":"Pattrns de Ruben Voka","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.espacemagh.be","email":"reservation@espacemagh.be","phone_contact":"+32 2 274 05 10","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50009857"},"it":{"name":"Pattrns de Ruben Voka","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.espacemagh.be","email":"reservation@espacemagh.be","phone_contact":"+32 2 274 05 10","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50009857"},"cn":{"name":"Pattrns de Ruben Voka","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.espacemagh.be","email":"reservation@espacemagh.be","phone_contact":"+32 2 274 05 10","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50009857"},"fr":{"name":"Pattrns de Ruben Voka","shortdescr":null,"longdescr":"\u201cPATTRNS\u201d est une exposition immersive de l\u2019artiste Ruben Voka o\u00f9 les \u201cpatterns\u201d, tant dans la forme artistique que dans la profondeur conceptuelle, se m\u00ealent, se connectent et s\u2019entrelacent pour cr\u00e9er un tout unique. L\u2019addition de chaque ligne trac\u00e9e sur papier construit un personnage comme l\u2019ensemble de ce qui compose une identit\u00e9. Culture, exp\u00e9riences, rencontres, \u00e9motions, choix\u2026 c\u2019est le m\u00e9lange de ces \u00e9l\u00e9ments qui construisent l\u2019\u00eatre unique et complexe que l\u2019on est aujourd\u2019hui. Mais \u00e0 quel point nous connaissons-nous ? \n\nPour (se) comprendre, il faut d\u00e9construire. \u201cPATTRNS\u201d n\u2019est pas une simple exposition mais une invitation \u00e0 l\u2019introspection. Chaque collection aborde un th\u00e8me repr\u00e9sentant une facette de l\u2019identit\u00e9 (culturelle, corporelle, personnelle, sexuelle,\u2026) et c\u2019est par le biais de divers moyens et supports que Ruben Voka suscite le questionnement. Il partage sa vision et invite \u00e0 explorer les m\u00e9langes et les connexions qui composent la toile de la multiculturalit\u00e9, ouvrant ainsi la voie \u00e0 une compr\u00e9hension plus profonde de son soi int\u00e9rieur et de notre identit\u00e9 per\u00e7ue de l\u2019ext\u00e9rieur.\n\nL\u2019ARTISTE\nRuben Voka, de son vrai nom Philippe Marissens, a explor\u00e9 une multitude de pratiques et techniques artistiques avant de se passionner pour le dessin en noir et blanc. Il use de crayons gras et de feutres pour r\u00e9aliser un travail de textures minutieux. Line art, pointillisme, estompage,\u2026 le style en constante \u00e9volution de Ruben Voka n\u00e9cessite technique, sensibilit\u00e9 et patience. Il repr\u00e9sente des figures r\u00e9alistes contrebalanc\u00e9es par une touche de surr\u00e9alisme justement dos\u00e9e. L\u2019artiste tient \u00e0 coeur de valoriser la diversit\u00e9 dans ses collections qui gravitent autour de la repr\u00e9sentation culturelle, de la danse, de la mode et du corps.\n\nSon insatiable curiosit\u00e9 le pousse \u00e0 se nourrir de ce qui l\u2019entoure, \u00e0 puiser son inspiration dans la musique, les livres, l\u2019audiovisuel et \u00e0 d\u00e9couvrir de nouveaux univers graphiques en permanence. Ses comp\u00e9tences de graphisme acquises \u00e0 Saint-Luc lui ont permis d\u2019ajouter une dimension suppl\u00e9mentaire \u00e0 son art. Il combine alors son savoir-faire papier et son savoir-faire digital pour \u00e9lever ses oeuvres en ajoutant, modifiant ou adaptant certains \u00e9l\u00e9ments, mais aussi pour proposer des tirages limit\u00e9s \u2013 num\u00e9rot\u00e9s et sign\u00e9s \u2013 dans divers formats, pour s\u2019adapter \u00e0 vos envies et vos espaces.\n\n","performers":"Ruben Voka, de son vrai nom Philippe Marissens, a explor\u00e9 une multitude de pratiques et techniques artistiques avant de se passionner pour le dessin en noir et blanc. Il use de crayons gras et de feutres pour r\u00e9aliser un travail de textures minutieux. Line art, pointillisme, estompage,\u2026 le style en constante \u00e9volution de Ruben Voka n\u00e9cessite technique, sensibilit\u00e9 et patience.","boxoffice_url":null,"website":"http:\/\/www.espacemagh.be","email":"reservation@espacemagh.be","phone_contact"