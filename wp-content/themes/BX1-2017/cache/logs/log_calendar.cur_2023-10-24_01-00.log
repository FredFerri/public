oldout":false,"last_updated_at":"2023-09-15T15:15:13+02:00","published_at":"2023-09-15T08:58:51+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":285419,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"tour","ranking":1,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{"list":[258],"translations":{"de":["Stadtteile"],"pt":[null],"en":["Neighbourhoods"],"it":["Quartieri"],"cn":[null],"fr":["Quartiers"],"sp":["Barrios"],"nl":["Wijken"]}}},"translations":{"de":{"name":"Comment sauver le patrimoine industriel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.arau.org\/fr\/","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50002191"},"pt":{"name":"Comment sauver le patrimoine industriel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.arau.org\/fr\/","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50002191"},"en":{"name":"Comment sauver le patrimoine industriel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.arau.org\/fr\/","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50002191"},"it":{"name":"Comment sauver le patrimoine industriel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.arau.org\/fr\/","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50002191"},"cn":{"name":"Comment sauver le patrimoine industriel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.arau.org\/fr\/","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50002191"},"fr":{"name":"Comment sauver le patrimoine industriel","shortdescr":null,"longdescr":"L\u2019industrie a longtemps \u00e9t\u00e9 la principale activit\u00e9 \u00e9conomique de Bruxelles avant de d\u00e9cliner, \u00e0 partir des ann\u00e9es 1970, et de laisser place aux bureaux. Cette \u00e9volution est particuli\u00e8rement tangible dans le quartier maritime qui n\u2019en garde pas moins une identit\u00e9 fortement marqu\u00e9e par l\u2019histoire industrielle, dont les traces se retrouvent tant dans les b\u00e2timents historiques que dans l\u2019organisation de l\u2019espace public. Malgr\u00e9 cette tertiarisation qui a fortement impact\u00e9 l\u2019\u00e9volution d\u2019un site comme celui de Tour et Taxis, les projets urbains plus r\u00e9cents se tournent vers les habitants et les visiteurs, avec les initiatives tels que le projet culturel Kanal ou la restauration de l\u2019ancien d\u00e9p\u00f4t Byrrh. Comment cette identit\u00e9 industrielle est-elle de nouveau mise \u00e0 profit dans les projets urbains ? Comment l\u2019urbanit\u00e9 se reconstruit-elle \u00e0 travers les projets de reconversion, et comment \u00e9viter les d\u00e9rives du marketing territorial ? Les activit\u00e9s industrielles trouvent-elles de nouveau une place dans ces processus de transformation et de production de la ville?\n\nDur\u00e9e : 2h\n\nLieu de d\u00e9part : En face de l\u2019entr\u00e9e principale de Kanal-Centre Pompidou, Quai des P\u00e9niches, 1000 Bruxelles ","performers":null,"boxoffice_url":null,"website":"https:\/\/www.arau.org\/fr\/","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50002191"},"sp":{"name":"Comment sauver le patrimoine industriel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.arau.org\/fr\/","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50002191"},"nl":{"name":"Comment sauver le patrimoine industriel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.arau.org\/fr\/","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50002191"}},"place":{"id":280470,"translations":{"de":{"name":" En face de l\u2019entr\u00e9e principale de Kanal-Centre Pompidou, Quai des P\u00e9niches, 1000 Bruxelles ","address_street_name":"Quai des P\u00e9niches","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Quai des P\u00e9niches","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":" En face de l\u2019entr\u00e9e principale de Kanal-Centre Pompidou, Quai des P\u00e9niches, 1000 Bruxelles ","address_street_name":"Quai des P\u00e9niches","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Quai des P\u00e9niches","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":" En face de l\u2019entr\u00e9e principale de Kanal-Centre Pompidou, Quai des P\u00e9niches, 1000 Bruxelles ","address_