ranslations":{"fr":{"title":"BYAC&AZILIZ Joint Concert ","copyright":null},"nl":{"title":"BYAC&AZILIZ Joint Concert ","copyright":null},"en":{"title":"BYAC&AZILIZ Joint Concert ","copyright":null}}},{"type":"video","link":"https:\/\/youtu.be\/B3oqUYLjgx4","oEmbed_title":"Wade in the Water (arr. Koepke) - BYAC","oEmbed_author_name":"Brussels Young Adult Choir","oEmbed_author_url":"https:\/\/www.youtube.com\/channel\/UCwap7BACurD4GfEuK18X9XQ","oEmbed_type":"video","oEmbed_height":200,"oEmbed_width":356,"oEmbed_version":"1.0","oEmbed_provider_name":"YouTube","oEmbed_provider_url":"https:\/\/www.youtube.com\/","oEmbed_thumbnail_height":360,"oEmbed_thumbnail_width":480,"oEmbed_thumbnail_url":"https:\/\/i.ytimg.com\/vi\/B3oqUYLjgx4\/hqdefault.jpg","oEmbed_html":"<iframe width=\"356\" height=\"200\" src=\"https:\/\/www.youtube.com\/embed\/B3oqUYLjgx4?feature=oembed\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" allowfullscreen title=\"Wade in the Water (arr. Koepke) - BYAC\"><\/iframe>","translations":{"fr":{"title":"Wade in the Water (arr. Koepke) - BYAC"},"nl":{"title":"Wade in the Water (arr. Koepke) - BYAC"},"en":{"title":"Wade in the Water (arr. Koepke) - BYAC"}}}],"dates":[{"day":"2022-10-23","doors":"16:00:00","start":"17:00:00","end":null,"is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Cat\u00e9gorie 1"},"nl":{"name":"Categorie 1"},"en":{"name":"Category 1"}},"value":20},{"translations":{"fr":{"name":"Cat\u00e9gorie 2"},"nl":{"name":"Categorie 2"},"en":{"name":"Category 2"}},"value":14},{"translations":{"fr":{"name":"Etudiants"},"nl":{"name":"Studenten"},"en":{"name":"Students"}},"value":16},{"translations":{"fr":{"name":"Jeunes"},"nl":{"name":"Jongeren"},"en":{"name":"Young people"}},"value":14}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-11T03:05:13+02:00","published_at":"2022-10-10T09:58:19+02:00","backoffice_id":263680,"import_origin":null,"sub_type":"concert","show_in_agenda":true,"ranking":1.2599210498949},{"id":543907,"date_start":"2022-10-23","date_end":"2022-10-23","date_next":"2022-10-23","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen"}},"others":{"list":[258],"translations":{"fr":["Quartiers"],"nl":["Wijken"],"en":["Neighbourhoods"],"de":["Stadtteile"]}}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Promenade dans la ville : Les blocs de construction des Lieux d\u2019avenir \u2013 Zone du canal au sud","shortdescr":"Pendant l'ArchiWeek, nous vous emm\u00e8nerons le long de ces Lieux d\u2019avenir, des endroits qui jettent les bases d\u2019une meilleure fa\u00e7on de vivre, de travailler et de cohabiter dans la ville.","longdescr":"L\u2019an dernier, nous avons parcouru le nord du pentagone de Bruxelles pendant l\u2019ArchiWeek. Cette ann\u00e9e, nous prenons la direction du sud-ouest. Ici aussi, les anciens quartiers industriels sont en pleine mutation. Plusieurs projets successifs se concentrent sur le r\u00e9am\u00e9nagement n\u00e9cessaire de l\u2019espace physique et social urbain et donnent \u00e0 voir les transformations que subit la ville le long du canal. L\u2019ancien tissu industriel laisse place \u00e0 de nouvelles activit\u00e9s socio-\u00e9conomiques. Nous vous emm\u00e8nerons le long de ces Lieux d\u2019avenir, des endroits qui jettent les bases d\u2019une meilleure fa\u00e7on de vivre, de travailler et de cohabiter dans la ville.\r\n\r\nNous commencerons notre promenade \u00e0 l\u2019abattoir d\u2019Anderlecht o\u00f9 le plan directeur de r\u00e9am\u00e9nagement du site bat son plein avec une ferme urbaine sur le toit d\u2019un nouveau march\u00e9 couvert. Nous sillonnerons ensuite le quartier Heyvaert de l\u2019autre c\u00f4t\u00e9 du canal, en passant par le Circularium et le parc de la Porte de Ninove. En chemin, nous croiserons toute une s\u00e9rie d\u2019initiatives inspirantes et innovantes. L\u2019Atelier Groot Eiland, par exemple, met la ville comestible au service de l\u2019emploi, avec son potager sous la tour Brunfaut r\u00e9cemment r\u00e9nov\u00e9e. La promenade se terminera sur la place MolenWest, une friche industrielle que les associations locales et les jeunes se sont temporairement appropri\u00e9e. \r\n\r\nLa promenade aura lieu le dimanche 23 octobre 2022 dans le cadre de l\u2019ArchiWeek et fait partie de La Grande Transformation 2020-2030. \r\nD\u00e9part : 14 h \u00e0 l\u2019Abattoir (Rue Ropsy Chaudron 24, 1070 Anderlecht)\r\nArriv\u00e9e : 17 h \u00e0 la place MolenWest (Rue Alphonse Vandenpeereboom 193, 1080 Molenbeek-Saint-Jean) \r\n\r\nLangue : fran\u00e7ais\/n\u00e9erlandais en alternance\r\nGuide : Roeland Dudal (Architecture Workroom Brussels)\r\nPrix : gratuit","performers":"La Grande Transformation\r\nArchiWeek","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.543907"},"nl":{"name":"Stadswandeling: Bouwstenen voor Toekomstplekken \u2013 Kanaalzone Zuid","shortdescr":"Tijdens ArchiWeek nemen we je mee langs Toekomstplekken in het zuidwesten van Brussel, die de kiemen leggen voor beter wonen, werken en samenleven in de stad.","longdescr":"Vorig jaar wandelden we tijdens de ArchiWeek door het noorden van de Brusselse vijfhoek, dit jaar trekken we naar het zuidwesten. Ook daar zijn de oude industri\u00eble wijken in volle verandering. Een aaneenschakeling van projecten focust op de noodzakelijke herinrichting van de stedelijke fysieke en sociale ruimte en maakt zichtbaar welke transformaties de stad langs het kanaal ondergaat. Het oude industri\u00eble weefsel biedt plaats aan nieuwe sociaal-economische activiteiten. We nemen je mee langs deze Toekomstplekken, plekken die de kiemen leggen voor beter wonen, werken en samenleven in de stad.\r\n\r\nWe starten de wandeling aan de het slachthuis van Anderlecht, Abattoir, waar het masterplan voor de herontwikkeling van de site in volle uitvoering is met een stadsboerderij op het dak van een nieuwe markthal. Daarna doorkruisen we de Heyvaertwijk langs het Circularium en het Ninoofsepoortpark, over het kanaal. Onderweg passeren we een reeks inspirerende en innoverende initiatieven. Atelier Groot Eiland, bijvoorbeeld, zet de eetbare stad in als hefboom voor werkgelegenheid, met een moestuin onder de pas gerenoveerde Brunfauttoren. De wandeling eindigt aan MolenWest square, een brownfield site die tijdelijk is toege\u00ebigend door lokale verenigingen en jeugd.\r\n\r\nDe wandeling vindt plaats op zondag 23 oktober 2022 in het kader van de ArchiWeek en is onderdeel van De Grote Verbouwing 2020-2030. \r\n\r\nStart: 14:00u aan Abattoir (Ropsy Chaudronstraat 24, 1070 Anderlecht)\r\nEinde: 17:00u aan MolenWest square (Alphonse Vandenpeereboomstraat 193, 1080 Sint-Jans-Molenbeek) \r\n\r\nTaal: afwisselend Frans\/ Nederlands\r\nGegidst door: Roeland Dudal (Architecture Workroom Brussels)\r\nKostprijs: gratis","performers":"De Grote Verbouwing\r\nArchiWeek","boxoffice_url":null,"website":"https:\/\/degroteverbouwing.eu\/en\/calendar\/city+walk+building+blocks+for+future+places+kanaalzone+zuid\/","email":"info@degroteverbouwing.eu","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.543907"},"en":{"name":"City walk: Building Blocks for Future Places - Kanaalzone Zuid","shortdescr":"During ArchiWeek we will take you along Future Places in the south-west of Brussels, that lay the seeds for better housing, working, and living together in the city.","longdescr":"Last year during ArchiWeek we walked through the north of the Brussels pentagon, this year we head to the southwest. There, too, the old industrial districts are in the midst of change. A series of projects focuses on the necessary rearrangement of the urban physical and social space and makes visible the transformations the city is undergoing along the canal. The old industrial fabric is giving way to new socio-economic activities. We take you along these Future Places, places that lay the seeds for better housing, working, and living together in the city.\r\n\r\nWe start the walk at Anderlecht\u2019s slaughterhouse, Abattoir, where the master plan for the redevelopment of the site is in full swing with an urban farm on the roof of a new market hall. We then cross the Heyvaert neighbourhood past the Circularium and Ninoofsepoort Park, across the canal. Along the way, we pass several inspiring and innovative initiatives. Atelier Groot Eiland, for example, uses the edible city as a lever for employment, with a vegetable garden under the newly renovated Brunfaut tower. The walk ends at MolenWest square, a brownfield site temporarily appropriated by local associations and youth. \r\n\r\nThe walk takes place on Sunday 23 October 2022 as part of ArchiWeek and The Great Transformation 2020-2030. \r\n\r\nStart: 14:00h at Abattoir (Ropsy Chaudronstraat 24, 1070 Anderlecht)\r\nEnd: 17:00h at MolenWest square (Alphonse Vandenpeereboomstraat 193, 1080 Sint-Jans-Molenbeek) \r\n\r\nLanguage: alternately French\/Dutch\r\nGuided by: Roeland Dudal (Architecture Workroom Brussels)\r\nCost: free of charge","performers":"The Great Transformation\r\nArchiWeek","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.543907"},"de":{"name":"Stadswandeling: Bouwstenen voor Toekomstplekken \u2013 Kanaalzone Zuid","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.543907"},"it":{"name":"Stadswandeling: Bouwstenen voor Toekomstplekken \u2013 Kanaalzone Zuid","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.543907"},"sp":{"name":"Stadswandeling: Bouwstenen voor Toekomstplekken \u2013 Kanaalzone Zuid","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.543907"},"pt":{"name":"Stadswandeling: Bouwstenen voor Toekomstplekken \u2013 Kanaalzone Zuid","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.543907"},"cn":{"name":"Stadswandeling: Bouwstenen voor Toekomstplekken \u2013 Kanaalzone Zuid","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.543907"}},"place":{"id":250490,"translations":{"fr":{"name":"Abattoir nv","address_street_name":"Rue Ropsy-Chaudron","address_street_number":"24","address_street_box":null,"email":"info@abattoir.be","website":"http:\/\/www.abattoir.be","phone_contact":"+32 2 521 54 19","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue Ropsy-Chaudron, 24","address_line2":"1070 Anderlecht","description_web":null,"description_print":null,"booki