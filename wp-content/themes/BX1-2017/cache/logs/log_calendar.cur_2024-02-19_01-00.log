els\/pt\/visitors\/agenda\/event-detail.50004469"},"en":{"name":"Inspired by Love - Belfius Art Collection","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/node\/13251","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50004469"},"it":{"name":"Inspired by Love - Belfius Art Collection","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/node\/13251","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50004469"},"cn":{"name":"Inspired by Love - Belfius Art Collection","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/node\/13251","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50004469"},"fr":{"name":"Inspired by Love - Belfius Art Collection","shortdescr":null,"longdescr":"Les curatrices ont propos\u00e9 \u00e0 12 artistes r\u00e9cemment entr\u00e9s dans la Belfius Art collection de se plonger dans la Belfius Art collection pour y choisir des oeuvres qui les inspirent et les touchent. Cette collection qui est connue pour son grand love pour l'art belge, de l'art primitif \u00e0 nos jours avec un accent particulier pour l'art contemporain!\n\nSitu\u00e9 au 32e \u00e9tage de la Tour Belfius, place Rogier, vous d\u00e9couvrirez aussi un panorama exceptionnel sur Bruxelles.\nL'exposition se cl\u00f4ture en juin 2024.\n\nSi vous participez \u00e0 une visite Arkadia merci de ne pas vous inscrire sur le site de Belfius. Votre place sera automatiquement r\u00e9serv\u00e9e. Merci d'arriver 10 min en avance car il y a un contr\u00f4le d'identit\u00e9 \u00e0 l'entr\u00e9e (ne pas oublier sa carte d'identit\u00e9). Vous retrouverez le guide apr\u00e8s le contr\u00f4le \u00e0 la borne \"point de rencontre\".\n\nBelfius demande \u00e0 chaque visiteur une contribution de 5 euros \u00e0 r\u00e9gler sur place afin de soutenir les actions Viva for Life (en faveur des jeunes enfants et familles qui vivent sous le seuil de pauvret\u00e9) et JEZ! (en faveur d'organisations intervenant aupr\u00e8s des jeunes). Cette contribution est facultative pour les clients Belfius munis de leur carte de banque ou de l\u2019app Belfius Mobile.","performers":"Les curatrices ont propos\u00e9 \u00e0 12 artistes r\u00e9cemment entr\u00e9s dans la Belfius Art collection de se plonger dans la Belfius Art collection pour y choisir des \u0153uvres qui les inspirent et les touchent. Cette collection qui est connue pour son grand love pour l'art belge, de l'art primitif \u00e0 nos jours avec un accent particulier pour l'art contemporain!","boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/node\/13251","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50004469"},"sp":{"name":"Inspired by Love - Belfius Art Collection","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/node\/13251","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50004469"},"nl":{"name":"Inspired by Love - Belfius Art Collection","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/node\/13251","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50004469"}},"place":{"id":266601,"translations":{"de":{"name":"Belfius Art Gallery","address_street_name":"Place Charles Rogier","address_street_number":null,"address_street_box":null,"email":"artcollection@belfius.be","website":"http:\/\/www.belfius-art-collection.be","phone_contact":null,"phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Place Charles Rogier","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Belfius Art Gallery","address_street_name":"Place Charles Rogier","address_street_number":null,"address_street_box":null,"email":"artcollection@belfius.be","website":"http:\/\/www.belfius-art-collection.be","phone_contact":null,"phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Place Charles Rogier","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Belfius Art Gallery","address_street_name":"Place Charles Rogier","address_street_number":null,"address_street_box":null,"email":"artcollection@belfius.be","website":"http:\/\/www.belfius-art-collection.be","phone_contact":null,"phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Place Charles Rogier","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Belfius Art Gallery","address_street_name":"Place Charles Rogier","address_street_number":null,"address_street_box":null,"email":"artcollection@belfius.be","website":"http:\/\/www.belfius-art-collection.be","phone_contact":null,"phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Place Charles Rogier","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Belfius Art Gallery","address_street_name":"Place Charles Rogier","address_street_number":null,"address_street_box":null,"email":"artcollection@belfius.be","website":"http:\/\/www.belfius-art-collection.be","phone_contact":null,"phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Place Charles Rogier","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Belfius Art Gallery","address_street_name":"Place Charles Rogier","address_street_number":null,"address_street_box":null,"email":"artcollection@belfius.be","website":"http:\/\/www.belfius-art-collection.be","phone_contact":null,"phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Place Charles Rogier","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"La collection Belfius est la plus grande collection d\u2019art belge du pays. La collection compte plus de 4 300 \u0153uvres d\u2019art et r\u00e9sulte de la fusion des collections du Cr\u00e9dit communal de Belgique, de Paribas Banque Belgique et de BACOB Banque.\r\n\r\nApr\u00e8s la Deuxi\u00e8me Guerre Mondiale, tant le Cr\u00e9dit communal que Paribas Belgique ont commenc\u00e9 \u00e0 acqu\u00e9rir des \u0153uvres de grande valeur li\u00e9es \u00e0 l\u2019h\u00e9ritage national belge, afin d\u2019\u00e9viter qu\u2019elles ne disparaissent \u00e0 l\u2019\u00e9tranger. D\u00e8s le d\u00e9but, le Cr\u00e9dit communal a mis l\u2019accent sur l\u2019art belge \u00e0 partir de 1860, tandis que Paribas se concentrait principalement sur des \u0153uvres du 16e au 18e si\u00e8cle et sur l\u2019art contemporain. BACOB banque a commenc\u00e9 sa collection en 1980 et s\u2019est exclusivement consacr\u00e9e \u00e0 l\u2019art contemporain belge. Aujourd\u2019hui, la collection couvre pr\u00e8s de cinq si\u00e8cles.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Belfius Art Gallery","address_street_name":"Place Charles Rogier","address_street_number":null,"address_street_box":null,"email":"artcollection@belfius.be","website":"http:\/\/www.belfius-art-collection.be","phone_contact":null,"phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Place Charles Rogier","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Belfius Art Gallery","address_street_name":"Charles Rogierplein","address_street_number":null,"address_street_box":null,"email":"artcollection@belfius.be","website":"http:\/\/www.belfius-art-collection.be","phone_contact":null,"phone_booking":null,"address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Charles Rogierplein","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":"De Belfius-kunstcollectie is de grootste verzameling van Belgische kunst van het land en omvat meer dan 4300 werken, het gevolg van de samensmelting van de kunstverzamelingen van het Gemeentekrediet, Paribas Bank Belgi\u00eb en BACOB Bank.\r\n\r\nZowel het Gemeentekrediet als Paribas Belgi\u00eb begonnen na de Tweede Wereldoorlog met het verzamelen van waardevolle kunstwerken uit het nationaal erfgoed om te vermijden dat ze naar het buitenland verdwenen. Het Gemeentekrediet legde van in het begin het accent op Belgische kunst vanaf 1860, terwijl Paribas Belgi\u00eb kunst uit de 16de tot de 18de eeuw en moderne kunst kocht. BACOB bank begon zijn verzameling in 1980 en legde zich uitsluitend toe op Belgische hedendaagse kunst. Vandaag bestrijkt de collectie werken uit bijna vijf eeuwen.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[15],"translations":{"de":["Rogier"],"pt":[null],"en":["Rogier"],"it":["Rogier"],"cn":[null],"fr":["Rogier"],"sp":["Rogier"],"nl":["Rogier"]}},"zones":{"list":[20],"tra