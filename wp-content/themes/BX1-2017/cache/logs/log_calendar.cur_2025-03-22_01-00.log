alse,"is_not_major_event":false,"backoffice_id":318380,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"other","ranking":0.3397451558437311,"languages":{"spoken":["nl","fr","en"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exposici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[44,36],"translations":{"de":["Design","Museen & Kunstzentren"],"pt":[null,null],"en":["Design","Museums and art centers"],"it":["Design","Musei e centri artistici"],"cn":[null,null],"fr":["Design","Mus\u00e9es et art centers"],"sp":["Dise\u00f1o","Museos y centros de arte"],"nl":["Design","Musea en kunstcentra"]}}},"translations":{"de":{"name":"Matching Seats","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/mad.brussels\/en\/agenda\/matching-seats","email":"contact@mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700006698"},"pt":{"name":"Matching Seats","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/mad.brussels\/en\/agenda\/matching-seats","email":"contact@mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700006698"},"en":{"name":"Matching Seats","shortdescr":"The exhibition Matching Seats brings together several remarkable pieces from the private collection of Galila Barzilai Hollander at MAD Brussels, each unique in its kind. The chosen chairs of this amazing chairwoman\u2019s collection are matched with contemporary fashion accessories resulting in surreal, humoristic and original conversations.","longdescr":"FROM BROKEN MIRRORS TO BARBIE DOLLS\n\nEye-catcher of the exhibition is the prototype that led to the Mutation Series by Brussels designer Maarten De Ceulaer. His 2011 armchair, composed of multiple stacked spheres, has since become an internationally recognized design object. German designer Kai Linke approached the standard plastic garden chair\u2014 which has proliferated across the planet over the years\u2014with a great sense of humor, transforming it into a mutated version that looks as if it came straight out of an AI machine. Sofia Leit\u00e3o used mirror shards to create a seating sculpture, while the Italian Anna Monichi crafted a chair from Barbie parts.\n\nArtists Johan De Wit and Laura Lima, for example, found inspiration in the original red and blue chair by Gerrit Rietveld from 1917. Inspired by the historical piece, they let their creativity run free. The first created a paper version in faded tones, while the second turned it into a wheelchair. Brussels-based designer Lionel Jadot pays homage to Botticelli's painting The Birth of Venus. And designer Thibeau Scarc\u00e9riaux critiques global violence with his War Chair, crafted from plates of bullet-riddled glass - a piece that has already become iconic.\n\nThe exhibition combines unique collectible objects with intriguing pieces and pairs them with striking accessories from the fashion world. As the center for fashion and design, MAD Brussels highlights this link to the fashion industry. The result is a captivating dialogue between the two worlds. Bags from designers as Eunji Oh, Sarah Levy and Naomi Gilon, will be featured next to a scarf from Aur\u00e9lie Defez and shoes from Marc Martha.\n\n  \nABOUT GALILA BARZILAI HOLLANDER, CHAIRWOMAN & ARTOHOLIC\n\nAs she states in her own words: \u201cI am not an art collector. I am an artoholic.\u201d Galila Barzilai Hollander is a fervent patron of the arts, dedicated to discovering emerging artists and acquiring their works. Her tireless pursuit of art has enabled her to develop close relationships with the creators, fostering mutual inspiration and often leading to the commissioning of exclusive pieces. Her collection encompasses over 20 themes, such as eyes, books, chairs and recycling. These motifs offer a glimpse into her psyche, transforming her collection into a personal narrative.\n\nGalila Barzilai founded P.O.C. (Passion Obsession Collection) in Brussels, where her collection can be discovered. The exhibition space is located in a historic industrial building from the 1950s, that was renovated by the architect Bruno Corbisier. P.O.C. serves as a contemporary art exhibition space for the eclectic art collection, featuring around 600 works of international artists and designers. Designed for a culture-seeking audience, it aims to provide visitors with a positive experience that ignites joy and inspiration.\n\n\nAN EXHIBITION FEATURING THE WORK OF\n\nAlessandro Guerriero, Anna Monichi, Harold Lechien, Jerszy Seymour, Johan de Wit, Julien Berthier, Kai Linke, Laura Lima, Lionel Jadot, Maarten De Ceulaer, Maria Nepomuceno, M-L-XL, Manfred Kielnhofer, Nicola Bolla, Niels Van Eijk, Pablo Reinoso, Rogier Martens, Sofia Leitao, St\u00e9phane Ducatteau, Thibeau Scarc\u00e9riaux, Tjep, Tom Schmelzer, Ty Locke, Getelin, Naomi Gilon, Dorilou, Yves Saint Laurent, Cousons Cousine, Eunji Oh, Le mot rose, MarcMartha, Komono x Uliana Shadow, Tom Van Der Borght, Aur\u00e9lie Defez, Sarah Levy.\n\nScenography by Marie Douel.\nA special thank our partners Sisley Paris, The Standard and Macallan.","performers":null,"boxoffice_url":null,"website":"https:\/\/mad.brussels\/en\/agenda\/matching-seats","email":"contact@mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700006698"},"it":{"name":"Matching Seats","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/mad.brussels\/en\/agenda\/matching-seats","email":"contact@mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700006698"},"cn":{"name":"Matching Seats","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/mad.brussels\/en\/agenda\/matching-seats","email":"contact@mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700006698"},"fr":{"name":"Matching Seats","shortdescr":"L\u2019exposition Matching Seats, pr\u00e9sent\u00e9e au MAD Brussels, rassemble une s\u00e9lection de pi\u00e8ces remarquables de la collection priv\u00e9e de Galila Barzilai Hollander. Chaque chaise, unique en son genre et minutieusement curat\u00e9e, dialogue avec des accessoires de mode contemporains, donnant naissance \u00e0 des rencontres surprenantes, empreintes d\u2019humour et de surr\u00e9alisme. ","longdescr":"DES MIROIRS BRIS\u00c9S AUX POUP\u00c9ES BARBIES\n\nLe prototype \u00e0 l\u2019origine de la s\u00e9rie Mutation du designer bruxellois Maarten De Ceulaer capte imm\u00e9diatement l\u2019attention. Son fauteuil, con\u00e7u en 2011 et compos\u00e9 d\u2019un assemblage organique de sph\u00e8res empil\u00e9es, s\u2019est rapidement hiss\u00e9 au rang de pi\u00e8ce iconique du design contemporain. Avec une touche d\u2019humour bien dos\u00e9e, le designer allemand Kai Linke a revisit\u00e9 la chaise de jardin en plastique standard \u2013 omnipr\u00e9sente dans notre quotidien depuis des d\u00e9cennies et produite \u00e0 une \u00e9chelle massive aux quatre coins du monde \u2013 en la transformant en une cr\u00e9ature mutante, digne d\u2019une cr\u00e9ation de l\u2019intelligence artificielle. De son c\u00f4t\u00e9, Sofia Leit\u00e3o fa\u00e7onne une sculpture de si\u00e8ges \u00e0 partir d\u2019\u00e9clats de miroir, tandis que l\u2019Italienne Anna Monichi donne une nouvelle vie aux poup\u00e9es Barbie en les m\u00e9tamorphosant en une assise aussi intriguante que d\u00e9routante. \n\nLes artistes Johan De Wit et Laura Lima, quant \u00e0 eux, revisitent la c\u00e9l\u00e8bre chaise rouge et bleue con\u00e7ue par Gerrit Rietveld en 1917. S\u2019inspirant de cette pi\u00e8ce historique, iels ont laiss\u00e9 libre cours \u00e0 leur cr\u00e9ativit\u00e9 : le premier a cr\u00e9\u00e9 une version en papier aux teintes d\u00e9lav\u00e9es, tandis que la seconde l'a transform\u00e9e en fauteuil roulant. Le designer bruxellois Lionel Jadot, de son c\u00f4t\u00e9, rend hommage \u00e0 la Naissance de V\u00e9nus de Botticelli, tandis que Thibeau Scarc\u00e9riaux d\u00e9nonce la violence dans le monde avec sa War Chair. Con\u00e7ue \u00e0 partir de plaques de verre cribl\u00e9es de balles, cette pi\u00e8ce percutante s\u2019impose d\u00e9j\u00e0 comme une \u0153uvre embl\u00e9matique.\n\nL'exposition associe des objets de collection uniques avec des pi\u00e8ces fascinantes, tout en les  associant \u00e0 des accessoires remarquables du monde de la mode. En tant que centre de la mode et du design, MAD Brussels souligne sa relation \u00e9troite avec l'industrie de la mode, cr\u00e9ant ainsi un dialogue captivant entre ces deux univers. Parmi les accessoires pr\u00e9sent\u00e9s, des sacs sign\u00e9s Eunji Oh, Sarah Levy et Naomi Gilon c\u00f4toieront une \u00e9charpe griff\u00e9e Aur\u00e9lie Defez et de chaussures de Marc Martha.\n\n \nA PROPOS DE GALILA BARZILAI HOLLANDER, CHAIRWOMAN ET ARTOHOLIC\n\nComme elle le dit elle-m\u00eame : \"Je ne suis pas une collectionneuse d'art. Je suis une passionn\u00e9e d'art\". Galila Barzilai Hollander, en fervente m\u00e9c\u00e8ne, se consacre \u00e0 la d\u00e9couverte d'artistes \u00e9mergent\u00b7e\u00b7s et \u00e0 l'acquisition de leurs \u0153uvres. Cette qu\u00eate sans fin l\u2019a amen\u00e9e \u00e0 tisser des liens profonds avec les cr\u00e9ateur\u00b7ice\u00b7s, favorisant un \u00e9change d\u2019inspiration mutuelle, souvent couronn\u00e9 par la commande de pi\u00e8ces exclusives. Sa collection, qui comprend plus de 20 th\u00e8mes, tels les yeux, les livres, les chaises, le recyclage, offre un aper\u00e7u fascinant de sa psych\u00e9 et transforme chaque objet en un chapitre de son propre r\u00e9cit personnel .\n\nGalila Barzilai a fond\u00e9 P.O.C. (Passion Obsession Collection) , un lieu o\u00f9 l'on peut d\u00e9couvrir sa collection h\u00e9t\u00e9roclite, nich\u00e9 dans b\u00e2timent industriel historique bruxellois des ann\u00e9es 1950, r\u00e9nov\u00e9 par l'architecte Bruno Corbisier. P.O.C., espace d'exposition d\u00e9di\u00e9 \u00e0 l\u2019art contemporain, pr\u00e9sentant environ 600 \u0153uvres de 250 artistes et designers internationaux. Pens\u00e9 pour un public en qu\u00eate de culture, il offre aux visiteur\u00b7euse\u00b7s une exp\u00e9rience immersive, qui suscite joie et inspiration.\n\n \nUNE EXPOSITION PR\u00c9SENTANT LE TRAVAIL DE\n\nAlessandro Guerriero, Anna Monichi, Harold Lechien, Jerszy Seymour, Johan de Wit, Julien Berthier, Kai Linke, Laura Lima, Lionel Jadot, Maarten De Ceulaer, Maria Nepomuceno, M-L-XL, Manfred Kielnhofer, Nicola Bolla, Niels Van Eijk, Pablo Reinoso, Rogier Martens, Sofia Leitao, St\u00e9phane Ducatteau, Thibeau Scarc\u00e9riaux, Tjep, Tom Schmelzer, Ty Locke, Getelin, Naomi Gilon, Dorilou, Yves Saint Laurent, Cousons Cousine, Eunji Oh, Le mot rose, MarcMartha, Komono x Uliana Shadow, Tom Van Der Borght, Aur\u00e9lie Defez.\n\nLa sc\u00e9nographie a \u00e9t\u00e9 cr\u00e9\u00e9e par Marie Douel. \nUn remerciement sp\u00e9cial \u00e0 nos partenaires Sisley Paris, The Standard et Macallan.","performers":null,"boxoffice_url":null,"website":"https:\/\/mad.brussels\/en\/agenda\/matching-seats","email":"contact@mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700006698"},"sp":{"name":"Matching Seats","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/mad.brussels\/en\/agenda\/matching-seats","email":"contact@mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700006698"},"nl":{"name":"Matching Seats","shortdescr":"De tentoonstelling Matching Seats brengt een aantal opmerkelijke stukken uit de priv\u00e9collectie van Galila Barzilai Hollander samen bij MAD Brussels, elk uniek in zijn soort. De geselecteerde stoelen uit de collectie van deze verbazingwekkende chairwoman worden gecombineerd met hedendaagse modeaccessoires, combinaties die surrealistische, humoristische en originele dialogen opleveren. \n\n","longdescr":"VAN GEBROKEN SPIEGELS TOT BARBIEPOPPEN\n\nBlikvanger van de tentoonstelling is het prototype dat leidde tot de Mutation Series van de Brusselse ontwerper Maarten De Ceulaer. Zijn zetel uit 2011, bestaande uit meerdere gestapelde bollen, is inmiddels uitgegroeid tot een internationaal erkend designobject. De Duitse ontwerper Kai Linke benaderde de standaard plastic tuinstoel, die wereldwijd massaal verspreid is, met een flinke dosis humor en transformeerde deze tot een gemuteerde versie die lijkt alsof hij rechtstreeks uit een AI-machine komt. Sofia Leit\u00e3o gebruikte dan weer spiegelscherven om een zitsculptuur mee te cre\u00ebren, terwijl de Italiaanse Anna Monichi een stoel maakte van Barbie-onderdelen.\n\nKunstenaars Johan De Wit en Laura Lima vonden inspiratie in de originele rood-blauwe stoel van Gerrit Rietveld uit 1917. De eerste maakte een papieren versie in vervaagde tinten, terwijl de tweede de stoel omvormde tot een rolstoel. De Brusselse ontwerper Lionel Jadot brengt een ode aan het schilderij De geboorte van Venus van Botticelli. Thibeau Scarc\u00e9riaux bekritiseert het wereldwijde geweld met zijn War Chair, vervaardigd uit platen kogelvrij glas - een stuk dat inmiddels iconisch is geworden.\n\nDe tentoonstelling combineert al deze unieke verzamelobjecten met intrigerende stukken en koppelt ze aan opvallende modeaccessoires. Als centrum voor mode en design benadrukt MAD Brussels graag de link met de mode-industrie. Het resultaat is een boeiende dialoog tussen beide werelden. Tassen van ontwerpers zoals Eunji Oh, Sarah Levy en Naomi Gilon worden gepresenteerd naast een sjaal van Aur\u00e9lie Defez en schoenen van Marc Martha.\n\n\nOVER GALILA BARZILAI HOLLANDER, CHAIRWOMAN & ARTOHOLIC\n\nIn haar eigen woorden: \"Ik ben geen kunstverzamelaar. Ik ben een artoholic.\" Galila Barzilai Hollander is een gepassioneerde kunstmecenas, toegewijd aan het ontdekken van opkomende kunstenaars en het verwerven van hun werken. Haar tomeloze zoektocht naar kunst stelde haar in staat nauwe relaties met de makers te ontwikkelen, wat vaak leidt tot exclusieve opdrachten. Haar collectie omvat meer dan twintig thema's, zoals ogen, boeken, stoelen en recyclage. Deze motieven bieden een inkijk in haar psyche en transformeren haar collectie in een persoonlijk verhaal.\n\nGalila Barzilai richtte P.O.C. (Passion Obsession Collection) op in Brussel, waar haar collectie te ontdekken is. De tentoonstellingsruimte is gevestigd in een historisch industrieel gebouw uit de jaren 50, gerenoveerd door architect Bruno Corbisier. P.O.C. fungeert als een tentoonstellingsruimte voor haar eclectische kunstcollectie met ongeveer 600 werken van internationale kunstenaars en ontwerpers. Ontworpen voor een cultuurminnend publiek, biedt het bezoekers een ervaring die vreugde en inspiratie opwekt.\n\n\nEEN TENTOONSTELLING MET HET WERK VAN\n\nAlessandro Guerriero, Anna Monichi, Harold Lechien, Jerszy Seymour, Johan de Wit, Julien Berthier, Kai Linke, Laura Lima, Lionel Jadot, Maarten De Ceulaer, Maria Nepomuceno, M-L-XL, Manfred Kielnhofer, Nicola Bolla, Niels Van Eijk, Pablo Reinoso, Rogier Martens, Sofia Leitao, St\u00e9phane Ducatteau, Thibeau Scarc\u00e9riaux, Tjep, Tom Schmelzer, Ty Locke, Getelin, Naomi Gilon, Dorilou, Yves Saint Laurent, Cousons Cousine, Eunji Oh, Le mot rose, MarcMartha, Komono x Uliana Shadow, Tom Van Der Borght, Aur\u00e9lie Defez.\n\nScenografie door werd verzorgd door Marie Douel. \nMet speciale dank aan Sisley Paris, The Standard en Macallan.","performers":null,"boxoffice_url":null,"website":"https:\/\/mad.brussels\/en\/agenda\/matching-seats","email":"contact@mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700006698"}},"place":{"id":250516,"translations":{"de":{"name":"MAD Brussels","address_street_name":"Place du Nouveau March\u00e9 aux Grains","address_street_number":"10","address_street_box":null,"email":"contact@mad.brussels","website":"http:\/\/www.mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":"+32 2 880 85 62","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place du Nouveau March\u00e9 aux Grains, 10","address_line2":"1000 Bruxelles","description_web":"MAD Brussels ist eine Br\u00fcsseler Mode- und Designplattform, die sich der F\u00f6rderung, Unterst\u00fctzung und Begleitung der Br\u00fcsseler Modesch\u00f6pfer und Designern verschrieben hat, um sowohl landesweit als auch international ihre Reichweite zu erh\u00f6hen.\r\n\r\nDie Er\u00f6ffnung des neuen, komplett in Wei\u00df gehaltenen Geb\u00e4udes hat dem MAD Brussels noch einmal frischen Wind in den Segeln beschert. Hier befinden sich nicht nur Ressourcen f\u00fcr Vertreter der Kreativindustrie und damit zusammenh\u00e4ngenden Metiers, sondern auch vielf\u00e4ltig nutzbare Arbeitspl\u00e4tze und Orte der Begegnung. Modesch\u00f6pfer und Designer haben hier eine Anlaufstelle, gleichzeitig finden in den R\u00e4umen Ateliers, Workshops, Seminare, Ausstellungen, Modeschauen, Kunst-Performances statt\u2026\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"MAD Brussels","address_street_name":"Place du Nouveau March\u00e9 aux Grains","address_street_number":"10","address_street_box":null,"email":"contact@mad.brussels","website":"http:\/\/www.mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":"+32 2 880 85 62","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place du Nouveau March\u00e9 aux Grains, 10","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"MAD Brussels","address_street_name":"Nieuwe Graanmarkt","address_street_number":"10","address_street_box":null,"email":"contact@mad.brussels","website":"http:\/\/www.mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":"+32 2 880 85 62","address_zip":"1000","address_city":"Brussels","address_line1":"Nieuwe Graanmarkt, 10","address_line2":"1000 Brussels","description_web":"MAD Brussels is a Brussels\u2019 platform for gathering expertise from the city\u2019s Fashion and Design sectors. It aims to help with the promotion and development of Brussels stylists and designers and improve their exposure nationally and abroad.\r\n\r\nThe opening in April 2017 of their brand new, sparkling white headquarters marked something of a renaissance for the non-profit organisation, which can now multiply and combine its campaigns. It houses a ressource centre for professionals of the creative industries and related sectors, along with adaptable workspaces, meeting spaces, workshops, seminar rooms and a large space dedicated to public activities where multiple events are organised every year: exhibitions, fashion shows, artistic performances\u2026\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"MAD Brussels","address_street_name":"Place du Nouveau March\u00e9 aux Grains","address_street_number":"10","address_street_box":null,"email":"contact@mad.brussels","website":"http:\/\/www.mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":"+32 2 880 85 62","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place du Nouveau March\u00e9 aux Grains, 10","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"MAD Brussels","address_street_name":"Place du Nouveau March\u00e9 aux Grains","address_street_number":"10","address_street_box":null,"email":"contact@mad.brussels","website":"http:\/\/www.mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":"+32 2 880 85 62","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place du Nouveau March\u00e9 aux Grains, 10","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"MAD Brussels","address_street_name":"Place du Nouveau March\u00e9 aux Grains","address_street_number":"10","address_street_box":null,"email":"contact@mad.brussels","website":"http:\/\/www.mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":"+32 2 880 85 62","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place du Nouveau March\u00e9 aux Grains, 10","address_line2":"1000 Bruxelles","description_web":"MAD Brussels est la plateforme bruxelloise d\u2019expertise dans les secteurs de la Mode et du Design.   Elle s\u2019emploie \u00e0 renforcer la promotion, \u00e0 accompagner le d\u00e9veloppement des stylistes et designers bruxellois et \u00e0 accro\u00eetre leur rayonnement (inter )national.  \r\n\r\nL\u2019ouverture en avril 2017 du nouveau b\u00e2timent enti\u00e8rement blanc a marqu\u00e9 une renaissance pour l\u2019asbl, qui dans ce lieu unique multiplie et combine ses actions. Il h\u00e9berge le centre de ressources pour les professionnels des industries cr\u00e9atives aux fili\u00e8res de m\u00e9tiers d\u00e9riv\u00e9es, des espaces de travail polyvalents, lieux de rencontres, d\u2019accueil de cr\u00e9ateurs, d\u2019ateliers, de s\u00e9minaires, ainsi qu\u2019un grand espace d\u00e9di\u00e9 aux activit\u00e9s publiques o\u00f9 sont organis\u00e9es chaque ann\u00e9e de multiples \u00e9v\u00e8nements: expositions, d\u00e9fil\u00e9s, performances artistiques,\u2026\r\n\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"MAD Brussels","address_street_name":"Place du Nouveau March\u00e9 aux Grains","address_street_number":"10","address_street_box":null,"email":"contact@mad.brussels","website":"http:\/\/www.mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":"+32 2 880 85 62","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place du Nouveau March\u00e9 aux Grains, 10","address_line2":"1000 Bruxelles","description_web":"MAD Brussels es una plataforma de Bruselas que reune expertos del los sectores de la moda y el dise\u00f1o. Tiene como objetivo ayudar en la promoci\u00f3n y el desarrollo de los dise\u00f1adores y estilistas de Bruselas y mejorar su imagen nacional e internacional.\r\nLa apertura de su novedosa y chispeante sede en abril de 2017 marc\u00f3 algo as\u00ed como el renacimiento para la organizaci\u00f3n sin \u00e1nimo de lucro, que ahora puede multiplicar y combinar sus campa\u00f1as. Posee un centro de recursos para profesionales de industrias culturales y sectores relacionados, junto con espacios de trabajo adaptados, lugares de reuni\u00f3n, talleres, seminarios y un gran espacio dedicado a actividades p\u00fablicas donde se organizan diversos eventos cada a\u00f1o: exhibiciones, desfiles de moda, representaciones art\u00edsticas\u2026\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"MAD Brussels","address_street_name":"Nieuwe Graanmarkt","address_street_number":"10","address_street_box":null,"email":"contact@mad.brussels","website":"http:\/\/www.mad.brussels","phone_contact":"+32 2 880 85 62","phone_booking":"+32 2 880 85 62","address_zip":"1000","address_city":"Brussel","address_line1":"Nieuwe Graanmarkt, 10","address_line2":"1000 Brussel","description_web":"MAD Brussels is het Brussels kennisplatform voor de mode- en designsectoren.  Het zet zich in voor de promotie en begeleiding van Brusselse stylisten en ontwerpers en de vergroting van hun (inter)nationale uitstraling. \r\n\r\nDe opening van hun nieuwe, volledig witte gebouw in april 2017 betekende een belangrijke impuls voor de vzw die op die unieke plek zijn verschillende doelstellingen kan uitbreiden en combineren. Het gebouw herbergt het onderzoekscentrum voor professionals uit de creatieve sectoren en aanverwante beroepsgroepen, multifunctionele werkruimtes, ontmoetingsplekken, ontvangstruimtes voor ontwerpers, workshops en seminaries en daarbij ook nog een grote ruimte waarin elk jaar verschillende activiteiten voor het grote publiek plaatsvinden, zoals tentoonstellingen, modeshows of artistieke performances.  \r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[3],"translations":{"de":["Dansaert\/Sainte-Catherine"],"pt":[null],"en":["Dansaert\/Sainte-Catherine"],"it":["Dansaert\/Sainte-Catherine"],"cn":[null],"fr":["Dansaert\/Sainte-Catherine"],"sp":["Dansaert\/Sainte-Catherine"],"nl":["Dansaertwijk\/Sint-Katelijne"]}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":null,"facebook_id":null,"backoffice_id":12629,"location":{"lat":50.851148,"lon":4.3441836},"region":"brussels","last_updated_at":"2024-03-04T10:32:39+01:00","published_at":"2013-10-19T01:34:31+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":250516,"translations":{"de":{"name":"MAD Brussels","address_street_name":"Place du Nouveau March\u00e9 aux Grains","address_street_number":"10","address_street_box":null,"email":"contact@mad.brussels","website":"http:\/\/www.mad.brussels","phone_contact":"+32 2 880 8