t":[],"translations":{}},"tags":[]},{"id":50007632,"date_start":"2024-03-24","date_end":"2024-03-24","date_next":"2024-03-24","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-02-23T16:15:07+01:00","published_at":"2024-02-22T16:57:56+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":295259,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"tour","ranking":1,"languages":{"spoken":["fr","en","nl"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{"list":[104],"translations":{"de":["Jugendstil, Art d\u00e9co"],"pt":[null],"en":["Art Nouveau, Art D\u00e9co"],"it":["Art Nouveau, Art D\u00e9co"],"cn":[null],"fr":["Art Nouveau, Art D\u00e9co"],"sp":["Art nouveau, art d\u00e9co"],"nl":["Art nouveau, art deco"]}}},"translations":{"de":{"name":"BANAD Festival - Guided tour of the Linthout school complex - Municipal school n. 13","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/banad.brussels","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50007632"},"pt":{"name":"BANAD Festival - Guided tour of the Linthout school complex - Municipal school n. 13","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/banad.brussels","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50007632"},"en":{"name":"BANAD Festival - Guided tour of the Linthout school complex - Municipal school n. 13","shortdescr":"As part of the BANAD Festival, come and discover the Linthout school complex.","longdescr":"\nHenri Jacobs designed this functional school complex with great attention to detail, as was often the case in Art Nouveau buildings. The first part of the complex opened in 1913 and the rest in 1922. The facades around the courtyards inside the blocks are a polychromatic blend of Belgian bluestone and yellow and red bricks. Jacobs commissioned Privat Livemont and Maurice Langaskens to decorate the large playgrounds. During the Biennial Event, the building will host an Art Nouveau and Art Deco antiques fair and a heritage restorers' fair.","performers":null,"boxoffice_url":null,"website":"https:\/\/banad.brussels","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50007632"},"it":{"name":"BANAD Festival - Guided tour of the Linthout school complex - Municipal school n. 13","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/banad.brussels","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50007632"},"cn":{"name":"BANAD Festival - Guided tour of the Linthout school complex - Municipal school n. 13","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/banad.brussels","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50007632"},"fr":{"name":"BANAD Festival - Visite guid\u00e9e du complexe scolaire Linthout - Ecole communale n13","shortdescr":"Dans le cadre du BANAD Festival, venez d\u00e9couvrir le complexe scolaire Linthout. ","longdescr":"Henri Jacobs a con\u00e7u ici un complexe scolaire fonctionnel o\u00f9 le souci du d\u00e9tail, comme souvent dans les constructions Art nouveau, n'est pas pour autant n\u00e9glig\u00e9. Les premiers b\u00e2timents ont \u00e9t\u00e9 inaugur\u00e9s en 1913 et les suivants en 1922. Le complexe se d\u00e9veloppe en int\u00e9rieur d'\u00eelot et pr\u00e9sente des fa\u00e7ades polychromes, r\u00e9sultat du mariage de la pierre bleue et des briques jaunes et rouges. C'est \u00e0 Privat Livemont et Maurice Langaskens qu'il revint d'orner les grands pr\u00e9aux. Le b\u00e2timent accueille une foire d'objets Art nouveau et Art d\u00e9co et un salon de restaurateurs du patrimoine.","performers":"Explore.Brussels asbl\/ vzw ","boxoffice_url":null,"website":"https:\/\/banad.brussels","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50007632"},"sp":{"name":"BANAD Festival - Guided tour of the Linthout school complex - Municipal school n. 13","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/banad.brussels","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50007632"},"nl":{"name":"BANAD Festival - Rondleiding van de scholencomplex Linthout - Gemeentschool nr. 13","shortdescr":"Kom in het kader van het BANAD Festival het scholencomplex Linthout ontdekken. ","longdescr":"\nZONDAG 24 MAART 2024\n\n\n\n\n\n\nMeeting Point \n103 Roodebeeklaan, 1030 Schaarbeek\n\n\n\n\n\n\n\n\n\nHenri Jacobs ontwierp hier een functioneel scholencomplex met toch veel oog voor detail, zoals vaak het geval is in art-nouveaugebouwen. De eerste gebouwen werden ingewijd in 1913 en de volgende in 1922. Het complex wordt omgeven door huizen en heeft veelkleurige gevels, het resultaat van de combinatie van blauwe steen en rode en gele bakstenen. Privat Livemont en Maurice Langaskens mochten de grote, overdekte speelplaatsen decoreren. Het gebouw herbergt een beurs voor art-nouveau- en art-decovoorwerpen en een beurs voor erfgoedrestaurateurs.","performers":null,"boxoffice_url":null,"website":"https:\/\/banad.brussels","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50007632"}},"place":{"id":50001222,"translations":{"de":{"name":"Complexe scolaire Linthout - Ecole communale n 13","address_street_name":"Avenue de Roodebeek","address_street_number":"103","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Avenue de Roodebeek, 103","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Complexe scolaire Linthout - Ecole communale n 13","address_street_name":"Avenue de Roodebeek","address_street_number":"103","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Avenue de Roodebeek, 103","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Linthout school complex - Municipal school n 13","address_street_name":"Roodebeeklaan","address_street_number":"103","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Roodebeeklaan, 103","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit"