tie verplicht","performers":null,"boxoffice_url":null,"website":"https:\/\/centrale.brussels\/nl\/events\/zondag-centrale-art-de-rien\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50004841"}},"place":{"id":243546,"translations":{"de":{"name":"CENTRALE for contemporary art","address_street_name":"Place Sainte-Catherine","address_street_number":"45","address_street_box":null,"email":"info@centrale.brussels","website":"http:\/\/www.centrale.brussels","phone_contact":"+32 2 279 64 44","phone_booking":"+32 2 279 64 57","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Sainte-Catherine, 45","address_line2":"1000 Bruxelles","description_web":"Die CENTRALE for Contemporary Art hat sich im Br\u00fcsseler Stadtzentrum in einem ehemaligen Elektrizit\u00e4tswerk niedergelassen. Hier wird eine engagierte und in jeder Hinsicht offene Vision der Kunst entwickelt und gepflegt, die im engen Austausch mit der Stadt und der Gesellschaft steht. In den verschiedenen R\u00e4umen und S\u00e4len finden regelm\u00e4\u00dfig Ausstellungen und andere multidisziplin\u00e4re Projekte mit namhaften K\u00fcnstlern und aufstrebenden jungen Talenten statt, die sowohl aus Br\u00fcssel als auch von ausw\u00e4rts stammen.","description_print":null,"booking_url":null,"sort_order":"CENTRALE FOR CONTEMPORARY ART","virtual_visit":null,"visit_url":null},"pt":{"name":"CENTRALE for contemporary art","address_street_name":"Place Sainte-Catherine","address_street_number":"45","address_street_box":null,"email":"info@centrale.brussels","website":"http:\/\/www.centrale.brussels","phone_contact":"+32 2 279 64 44","phone_booking":"+32 2 279 64 57","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Sainte-Catherine, 45","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"CENTRALE for contemporary art","address_street_name":"Place Sainte-Catherine","address_street_number":"45","address_street_box":null,"email":"info@centrale.brussels","website":"http:\/\/www.centrale.brussels","phone_contact":"+32 2 279 64 44","phone_booking":"+32 2 279 64 57","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Sainte-Catherine, 45","address_line2":"1000 Bruxelles","description_web":"Nestled in a former power station in the heart of Brussels, CENTRALE for contemporary art is the contemporary art centre of the City of Brussels.\r\nIt develops a committed vision of art, beyond boundaries, and connected to the city and to society.\r\nEach year it collaborates with confirmed and emerging artists from Brussels and the international scene to produce exhibitions and multidisciplinary projects housed in its various premises.\r\n","description_print":null,"booking_url":null,"sort_order":"CENTRALE FOR CONTEMPORARY ART","virtual_visit":null,"visit_url":null},"it":{"name":"CENTRALE for contemporary art","address_street_name":"Place Sainte-Catherine","address_street_number":"45","address_street_box":null,"email":"info@centrale.brussels","website":"http:\/\/www.centrale.brussels","phone_contact":"+32 2 279 64 44","phone_booking":"+32 2 279 64 57","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Sainte-Catherine, 45","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"CENTRALE for contemporary art","address_street_name":"Place Sainte-Catherine","address_street_number":"45","address_street_box":null,"email":"info@centrale.brussels","website":"http:\/\/www.centrale.brussels","phone_contact":"+32 2 279 64 44","phone_booking":"+32 2 279 64 57","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Sainte-Catherine, 45","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"CENTRALE for contemporary art","address_street_name":"Place Sainte-Catherine","address_street_number":"45","address_street_box":null,"email":"info@centrale.brussels","website":"http:\/\/www.centrale.brussels","phone_contact":"+32 2 279 64 44","phone_booking":"+32 2 279 64 57","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Sainte-Catherine, 45","address_line2":"1000 Bruxelles","description_web":"Nich\u00e9e au coeur de Bruxelles, au sein d\u2019une ancienne centrale \u00e9lectrique, la CENTRALE for contemporary art est le centre d\u2019art contemporain de la Ville de Bruxelles. Elle d\u00e9veloppe une vision engag\u00e9e et d\u00e9cloisonn\u00e9e de l\u2019art, en lien avec la cit\u00e9 et la soci\u00e9t\u00e9. Chaque ann\u00e9e, elle produit dans ses divers espaces des expositions et projets multidisciplinaires avec des artistes confirm\u00e9.e.s et \u00e9mergent.e.s, tant bruxellois.e.s qu\u2019internationaux.ales.\r\n\r\n","description_print":null,"booking_url":null,"sort_order":"CENTRALE FOR CONTEMPORARY ART","virtual_visit":null,"visit_url":null},"sp":{"name":"CENTRALE for contemporary art","address_street_name":"Place Sainte-Catherine","address_street_number":"45","address_street_box":null,"email":"info@centrale.brussels","website":"http:\/\/www.centrale.brussels","phone_contact":"+32 2 279 64 44","phone_booking":"+32 2 279 64 57","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Sainte-Catherine, 45","address_line2":"1000 Bruxelles","description_web":"El museo CENTRALE for contemporary art tiene como misi\u00f3n dar a conocer las creaciones art\u00edsticas contempor\u00e1neas en el campo de las artes visuales a un p\u00fablico lo m\u00e1s amplio posible. El centro de arte contempor\u00e1neo de la ciudad de Bruselas tambi\u00e9n quiere suscitar preguntas sobre la sociedad actual. Tiene la voluntad de ser un espacio abierto al mundo, a Europa, a la ciudad y al barrio y mostrar los aspectos espec\u00edficos de Bruselas, una ciudad caracterizada por la diversidad de su poblaci\u00f3n y su riqueza cultural. Con el CENTRALE.box y el CENTRALE.lab, el CENTRALE for contemporary art apoya a los artistas emergentes.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"CENTRALE for contemporary art","address_street_name":"Sint-Katelijneplein","address_street_number":"45","address_street_box":null,"email":"info@centrale.brussels","website":"http:\/\/www.centrale.brussels","phone_contact":"+32 2 279 64 44","phone_booking":"+32 2 279 64 57","address_zip":"1000","address_city":"Bruxelles","address_line1":"Sint-Katelijneplein, 45","address_line2":"1000 Bruxelles","description_web":"In hartje Brussel, in een oude elektriciteitscentrale vond de CENTRALE for contemporary art, het kunstencentrum van de Stad Brussel, zijn onderkomen. Het centrum geeft blijk van een ge\u00ebngageerde en open visie op kunst, afgestemd op de stad en de maatschappij. Elk jaar vinden in de verschillende ruimten van het centrum multidisciplinaire tentoonstellingen en projecten plaats met bekende en onbekende kunstenaars, al dan niet afkomstig uit Brussel en Belgi\u00eb.","description_print":null,"booking_url":null,"sort_order":"CENTRALE FOR CONTEMPORARY ART","virtual_visit":null,"visit_url":null}},"districts":{"list":[3],"translations":{"de":["Dansaert\/Sainte-Catherine"],"pt":[null],"en":["Dansaert\/Sainte-Catherine"],"it":["Dansaert\/Sainte-Catherine"],"cn":[null],"fr":["Dansaert\/Sainte-Catherine"],"sp":["Dansaert\/Sainte-Catherine"],"nl":["Dansaertwijk\/Sint-Katelijne"]}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":"art_center","facebook_id":null,"backoffice_id":5909,"location":{"lat":50.8503503,"lon":4.3480237},"region":"brussels","last_update