],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-05-31T10:05:06+02:00","published_at":"2022-05-31T09:40:29+02:00","backoffice_id":254713,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":1.2599210498949},{"id":528862,"date_start":"2022-06-19","date_end":"2022-06-19","date_next":"2022-06-19","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Les places bruxelloises : La place de Brouck\u00e8re et l'oeuvre de Peter Downsbrough","shortdescr":"La plupart des places bruxelloises sont le fruit de constructions et\/ou d\u00e9molitions successives de diff\u00e9rentes \u00e9poques.","longdescr":"La plupart des places bruxelloises sont le fruit de constructions et\/ou d\u00e9molitions successives de diff\u00e9rentes \u00e9poques. Une place est un lieu de rencontre o\u00f9 des architectures, des \u0153uvres et du mobilier sont cr\u00e9\u00e9s pour faciliter l\u2019espace d\u2019\u00e9change, de circulation et de vie.\nLa place de Brouck\u00e8re par sa situation \u00e0 l'hyper centre a, d\u00e8s son origine, attir\u00e9 de nombreux th\u00e9\u00e2tres, h\u00f4tels, cin\u00e9mas, restaurant et caf\u00e9s. Elle a subi de nombreuses transformations au cours des ann\u00e9es, des immeubles entiers furent abandonn\u00e9s, et la fontaine-ob\u00e9lisque Anspach d\u00e9plac\u00e9e lors de l'installation du m\u00e9tro en 1973. Elle retrouve, depuis peu, \u00e0 nouveau une allure de place conviviale.\nPour respecter les pr\u00e9cautions sanitaires li\u00e9es au Covid-19, chaque visiteur devra se munir de son masque.\nCette visite est soutenue par l\u2019\u00e9chevine de l\u2019Urbanisme, des Espaces public et du Patrimoine de la ville de Bruxelles.\n4 places seront offertes pour les habitants de la ville de Bruxelles dans le Brusseleir de novembre.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.arkadia.be","email":"info@arkadia.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/528862.html"},"nl":{"name":"Les places bruxelloises : La place de Brouck\u00e8re et l'oeuvre de Peter Downsbrough","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/528862.html"},"en":{"name":"Les places bruxelloises : La place de Brouck\u00e8re et l'oeuvre de Peter Downsbrough","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/528862.html"},"de":{"name":"Les places bruxelloises : La place de Brouck\u00e8re et l'oeuvre de Peter Downsbrough","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/528862.html"},"it":{"name":"Les places bruxelloises : La place de Brouck\u00e8re et l'oeuvre de Peter Downsbrough","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/528862.html"},"sp":{"name":"Les places bruxelloises : La place de Brouck\u00e8re et l'oeuvre de Peter Downsbrough","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/528862.html"},"pt":{"name":"Les places bruxelloises : La place de Brouck\u00e8re et l'oeuvre de Peter Downsbrough","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/528862.html"},"cn":{"name":"Les places bruxelloises : La place de Brouck\u00e8re et l'oeuvre de Peter Downsbrough","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/528862.html"}},"place":{"id":240987,"translations":{"fr":{"name":"Th\u00e9\u00e2tre National Wallonie-Bruxelles","address_street_name":"Boulevard Emile Jacqmain","address_street_number":"111","address_street_box":null,"email":"info@theatrenational.be","website":"http:\/\/www.theatrenational.be","phone_contact":"+32 2 203 53 03","phone_booking":"+32 2 203 41 55","address_zip":"1000","address_city":"Bruxelles","address_line1":"Boulevard Emile Jacqmain, 111","address_line2":"1000 Bruxelles","description_web":"Le r\u00e9cent et tr\u00e8s \u00e9pur\u00e9 b\u00e2timent du Th\u00e9\u00e2tre National dispose de trois salles, certainement parmi les plus belles de Belgique, aux qualit\u00e9s techniques irr\u00e9prochables. C\u2019est un th\u00e9\u00e2tre qui veut aller \u00e0 la rencontre des artistes et du public tout comme des autres arts et des cultures d\u2019ici et d\u2019ailleurs. C\u2019est un lieu o\u00f9 les id\u00e9es se partagent et s\u2019entrechoquent \u00e0 foison. Orchestr\u00e9e par Fabrice Murgia, la programmation allie th\u00e9\u00e2tre et danse, pointures internationales et cr\u00e9ations belges francophones tout en cr\u00e9ant des ponts avec son homologue (et presque voisin) flamand, le KVS.  ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Th\u00e9\u00e2tre National Wallonie-Bruxelles","address_street_name":"Emile Jacqmainlaan","address_street_number":"111","address_street_box":null,"email":"info@theatrenational.be","website":"http:\/\/www.theatrenational.be","phone_contact":"+32 2 203 53 03","phone_booking":"+32 2 203 41 55","address_zip":"1000","address_city":"Brussel","address_line1":"Emile Jacqmainlaan, 111","address_line2":"1000 Brussel","description_web":"Het Th\u00e9\u00e2tre National beschikt over drie zalen van uitzonderlijke technische geluidskwaliteit. De programmering is bestemd voor een ruim publiek, waarbij er ruimte is voor intelligente en veeleisende voorstellingen, maar ook voor plezierige en emotionele stukken. Het theater wil een ontmoetingsplaats zijn voor zowel beroemde als bijzondere artiesten uit het Belgische en het Europese theaterlandschap. Artistiek leider Fabrice Murgia zet de nauwe samenwerking met zijn Vlaamse tegenhanger en bijna buur de KVS voort. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Th\u00e9\u00e2tre National Wallonie-Bruxelles","address_street_name":"Boulevard Emile Jacqmain","address_street_number":"111","address_street_box":null,"email":"info@theatrenational.be","website":"http:\/\/www.theatrenational.be","phone_contact":"+32 2 203 53 03","phone_booking":"+32 2 203 41 55","address_zip":"1000","address_city":"Brussels","address_line1":"Boulevard Emile Jacqmain, 111","address_line2":"1000 Brussels","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Th\u00e9\u00e2tre National Wallonie-Bruxelles","address_street_name":"Boulevard Emile Jacqmain","address_street_number":"111","address_street_box":null,"email":"info@theatrenational.be","website":"http:\/\/www.theatrenational.be","phone_contact":"+32 2 203 53 03","phone_booking":"+32 2 203 41 55","address_zip":"1000","address_city":"Bruxelles","address_line1":"Boulevard Emile Jacqmain, 111","address_line2":"1000 Bruxelles","description_web":"Das moderne und schn\u00f6rkellose Geb\u00e4ude des Th\u00e9\u00e2tre National verf\u00fcgt \u00fcber drei S\u00e4le, die zu den sch\u00f6nsten Belgiens z\u00e4hlen. Das Theater sucht die Begegnung mit den K\u00fcnstlern, dem Publikum und anderen Kunstformen und Kulturen. Ein Ort des Ideenaustauschs und der Konfrontation, unter der Leitung von Fabrice Murgia, dessen Programm auf belgisches und internationales Theater und Tanz setzt. Das Theater ist vor allem franz\u00f6sischsprachig, aber auch internationale Produktionen kommen teils in Originalsprache auf die B\u00fchne - oftmals gibt es sogar mehrsprachige Untertitel. Auch der Ausstausch mit seinem fl\u00e4mischen Pendant KVS ist ein wichtiger Eckpfeiler der Philosophie.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Th\u00e9\u00e2tre National Wallonie-Bruxelles","address_street_name":"Boulevard Emile Jacqmain","address_street_number":"111","address_street_box":null,"email":"info@theatrenational.be","website":"http:\/\/www.theatrenational.be","phone_contact":"+32 2 203 53 03","phone_booking":"+32 2 203 41 55","address_zip":"1000","address_city":"Bruxelles","address_line1":"Boulevard Emile Jacqmain, 111","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Th\u00e9\u00e2tre National Wallonie-Bruxelles","address_street_name":"Boulevard Emile Jacqmain","address_street_number":"111","address_street_box":null,"email":"info@theatrenational.be","website":"http:\/\/www.theatrenational.be","phone_contact":"+32 2 203 53 03","phone_booking":"+32 2 203 41 55","address_zip":"1000","address_city":"Bruxelles","address_line1":"Boulevard Emile Jacqmain, 111","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Th\u00e9\u00e2tre National Wallonie-Bruxelles","address_street