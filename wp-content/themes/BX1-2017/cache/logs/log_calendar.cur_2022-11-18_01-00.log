 visitors to more than twenty locations in Brussels.     \r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Passa Porta","address_street_name":"Rue Antoine Dansaert","address_street_number":"46","address_street_box":null,"email":"info@passaporta.be","website":"http:\/\/www.passaporta.be","phone_contact":"+32 2 226 04 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Antoine Dansaert, 46","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Passa Porta","address_street_name":"Rue Antoine Dansaert","address_street_number":"46","address_street_box":null,"email":"info@passaporta.be","website":"http:\/\/www.passaporta.be","phone_contact":"+32 2 226 04 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Antoine Dansaert, 46","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Passa Porta","address_street_name":"Rue Antoine Dansaert","address_street_number":"46","address_street_box":null,"email":"info@passaporta.be","website":"http:\/\/www.passaporta.be","phone_contact":"+32 2 226 04 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Antoine Dansaert, 46","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Passa Porta","address_street_name":"Rue Antoine Dansaert","address_street_number":"46","address_street_box":null,"email":"info@passaporta.be","website":"http:\/\/www.passaporta.be","phone_contact":"+32 2 226 04 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Antoine Dansaert, 46","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"b