ijke ordening, en rationeel energiegebruik. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":9562,"location":{"lat":50.84801328,"lon":4.34683241},"last_updated_at":"2022-12-19T14:03:38+01:00","published_at":"2013-10-19T01:26:22+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/8fe414eac868f0308dac8b14da7a408411cb87bb.jpg","width":2484,"height":3665,"ratio":0.68,"oEmbed_height":3665,"oEmbed_width":2484,"translations":{"de":{"title":"ART NOUVEAU, un art pour tous\u00b7tes ?","copyright":"Luna van Aubel & Ema Tytgat"},"pt":{"title":"ART NOUVEAU, un art pour tous\u00b7tes ?","copyright":"Luna van Aubel & Ema Tytgat"},"en":{"title":"ART NOUVEAU, art for all ?","copyright":"Luna van Aubel & Ema Tytgat"},"it":{"title":"ART NOUVEAU, un art pour tous\u00b7tes ?","copyright":"Luna van Aubel & Ema Tytgat"},"cn":{"title":"ART NOUVEAU, un art pour tous\u00b7tes ?","copyright":"Luna van Aubel & Ema Tytgat"},"fr":{"title":"ART NOUVEAU, un art pour tous\u00b7tes ?","copyright":"Luna van Aubel & Ema Tytgat"},"sp":{"title":"ART NOUVEAU, un art pour tous\u00b7tes ?","copyright":"Luna van Aubel & Ema Tytgat"},"nl":{"title":"ART NOUVEAU, kunst voor iedereen ?","copyright":"Luna van Aubel & Ema Tytgat"}}}],"dates":[{"day":"2024-01-06","doors":null,"start":"10:00:00","end":"18:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-01-07","doors":null,"start":"10:00:00","end":"18:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-01-08","doors":null,"start":"10:00:00","end":"18:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-01-09","doors":null,"start":"10:00:00","end":"18:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day"