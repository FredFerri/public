rno"],"cn":[null],"fr":["Visites guid\u00e9es d\u2019int\u00e9rieurs"],"sp":["Visitas guiadas en espacios interiores"],"nl":["Interieur rondleidingen"]}}},"translations":{"de":{"name":"BANAD Festival - Les Pavillons Fran\u00e7ais","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700006510"},"pt":{"name":"BANAD Festival - Les Pavillons Fran\u00e7ais","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700006510"},"en":{"name":"BANAD Festival - Les Pavillons Fran\u00e7ais","shortdescr":null,"longdescr":"Following the completion of the Residence Palace which allowed wealthy Brussels residents to enjoy the advantages of living in a luxury apartment, the developer Lucien Kaisin undertook a new project: the French Pavilions based on plans by the architect Marcel Peeters. The idea was the same: to provide residents with a maximum of comfort, including elevators, central heating, hot water and functional kitchens, as well as \"essential\" services such as small salons\/offices to receive visitors outside one's apartment, a meeting room, a kitchen from which to have meals delivered, postal ducts allowing mail to be sent from higher floors, concierges, a mezzanine dedicated to servants..., all in the middle of a vast garden. This \"behind the scenes\" tour focuses on the historical evolution of living in a big building and the urban development of the district.\n\nArch. Marcel PEETERS, 1931-1934\n","performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/en\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700006510"},"it":{"name":"BANAD Festival - Les Pavillons Fran\u00e7ais","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700006510"},"cn":{"name":"BANAD Festival - Les Pavillons Fran\u00e7ais","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700006510"},"fr":{"name":"BANAD Festival - Les Pavillons Fran\u00e7ais","shortdescr":null,"longdescr":"Suite \u00e0 l'ach\u00e8vement du R\u00e9sidence Palace, qui permit aux bruxellois fortun\u00e9s d'appr\u00e9cier les avantages de la vie en appartement luxueux, le promoteur Lucien Kaisin entreprit un nouveau projet avec l'architecte Marcel Peeters : les Pavillons Fran\u00e7ais. Empruntant les m\u00eames id\u00e9es, leur but restait inchang\u00e9 : procurer aux r\u00e9sidents un confort maximal en proposant des technologies pris\u00e9es telles que des ascenseurs, du chauffage central, de l'eau chaude aux \u00e9tages ou encore des cuisines fonctionnelles, en plus des services \u00ab indispensables \u00bb tels que de petits salons-bureaux ind\u00e9pendants pr\u00e9vus pour recevoir des visiteurs hors de chez soi, une salle de r\u00e9union commune, une cuisine d'o\u00f9 on pouvait se faire livrer ses repas, des gaines postales permettant l'envoi de courrier aux \u00e9tages, plusieurs concierges, un entresol d\u00e9di\u00e9 aux domestiques,\u2026 Le tout au milieu d'un vaste jardin \u00e0 proximit\u00e9 du centre ville. Cette visite \"dans les coulisses\" est ax\u00e9e sur l'\u00e9volution historique de la vie en immeuble et l'\u00e9volution urbanistique du quartier. - \u00e0 noter: aucun appartement ne fera partie de la visite -\n\nArch. Marcel PEETERS, 1931-1934","performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700006510"},"sp":{"name":"BANAD Festival - Les Pavillons Fran\u00e7ais","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700006510"},"nl":{"name":"BANAD Festival - Les Pavillons Fran\u00e7ais","shortdescr":null,"longdescr":"\n\nArch. Marcel PEETERS, 1931-1934","performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/nl\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700006510"}},"place":{"id":50002914,"translations":{"de":{"name":"Les Pavillons Fran\u00e7ais","address_street_name":"Rue du Noyer","address_street_number":"282-282b","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Noyer, 282-282b","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Les Pavillons Fran\u00e7ais","address_street_name":"Rue du Noyer","address_street_number":"282-282b","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_lin