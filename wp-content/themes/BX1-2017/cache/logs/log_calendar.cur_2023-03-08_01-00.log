1:00","end":"21:00:00","is_only_by_appointment":false},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-03-06T10:05:04+01:00","published_at":"2023-03-06T09:40:20+01:00","backoffice_id":272888,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.28114422176725},{"id":552950,"date_start":"2023-03-10","date_end":"2023-05-07","date_next":"2023-03-10","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung","it":"Esposizioni","sp":"Exhibici\u00f3n","pt":null,"cn":null}},"others":{"list":[36,41],"translations":{"fr":["Mus\u00e9es et art centers","Installation, performance"],"nl":["Musea en kunstcentra","Installatie, performance"],"en":["Museums and art centers","Installation, performance"],"de":["Museen & Kunstzentren","Installation, Performance"],"it":["Musei e centri artistici","Installazioni, performance"],"sp":["Museos y centros de arte","Instalaci\u00f3n, performance"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"International Trans*Feminist Digital Depletion Strike","shortdescr":"Constant se joint \u00e0 l\u2019International Trans*feminist Digital Depletion Strike et invite les \u00e9l\u00e8ves du Master Design Num\u00e9rique de l\u2019\u00c9cole de Recherche Graphique (erg) \u00e0 occuper sa vitrine de la rue du Fort \u00e0 Bruxelles.","longdescr":"Constant se joint \u00e0 l\u2019International Trans*feminist Digital Depletion Strike et invite les \u00e9l\u00e8ves du master Design Num\u00e9rique de l\u2019\u00c9cole de Recherche Graphique (erg) \u00e0 occuper sa vitrine de la rue du Fort \u00e0 Bruxelles.\r\n\r\nLe 8 mars 2023, l\u2019International Trans*feminist Digital Depletion Strike appelle \u00e0 une journ\u00e9e d\u2019action contre le Cloud. Ce jour-l\u00e0, nous essaierons de nous abstenir d\u2019utiliser, de nourrir ou d\u2019entretenir le Big Tech Cloud. La gr\u00e8ve appelle \u00e0 une hyperr\u00e9duction des services num\u00e9riques extractifs, et une abondance d\u2019organisation collective. Nous nous joignons au long trac\u00e9 historique des gr\u00e8ves f\u00e9ministes internationales, car nous comprenons que cette lutte concerne le travail, le soin, l\u2019antiracisme, la vie queer et la techno-politique trans*f\u00e9ministe.\r\n\r\nLe 8 mars, Constant prendra part \u00e0 diff\u00e9rents embranchements de la gr\u00e8ve dans la ville. Le jeudi 9 mars l\u2019on c\u00e9l\u00e9brera avec l\u2019installation des \u00e9l\u00e8ves inspir\u00e9e par la gr\u00e8ve.\r\n\r\nVernissage de l\u2019installation : jeudi 9 mars \u00e0 partir de 18:00.","performers":"Les \u00e9l\u00e8ves du Master Design Num\u00e9rique de l\u2019\u00c9cole de recherche graphique de Bruxelles","boxoffice_url":null,"website":"http:\/\/www.constantvzw.org","email":"info@constantvzw.org","phone_contact":"+32 2 539 24 67","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.552950"},"nl":{"name":"International Trans*Feminist Digital Depletion Strike","shortdescr":"Constant sluit zich aan bij de International Trans*feminist Digital Depletion Strike en nodigt studenten van de masteropleiding Digital Design van de \u00c9cole de Recherche Graphique (erg) uit om de vitrine in de Fortstraat in Brussel te bezetten.","longdescr":"Constant sluit zich aan bij de International Trans*feminist Digital Depletion Strike en nodigt studenten van de masteropleiding Digital Design van de \u00c9cole de Recherche Graphique (erg) uit om de vitrine in de Fortstraat in Brussel te bezetten.\r\n\r\nOp 8 maart 2023 roept de International Trans*feminist Digital Depletion Strike op tot een actiedag tegen de Cloud. Op die dag zullen we proberen de Big Tech Cloud niet te gebruiken, te voeden of te onderhouden. De staking roept op tot een hyperscaledown van extractieve digitale diensten, en tot een overvloed aan collectieve organisatie. We sluiten ons aan bij de lange geschiedenis van internationale feministische stakingen, omdat we deze strijd begrijpen in relatie tot arbeid, zorg, antiracisme, queer life en trans*feministische techno-politiek.\r\n\r\nOp 8 maart zal Constant deelnemen aan verschillende takken van de staking in Brussel. Donderdag 9 maart wordt gevierd met een installatie ge\u00efnspireerd op de staking.\r\n\r\nOpening installatie: Donderdag 9 maart vanaf 18:00.","performers":"De studenten van de masteropleiding Digital Design van de \u00c9cole de Recherche Graphique van Brussel.","boxoffice_url":null,"website":"http:\/\/www.constantvzw.org","email":"info@constantvzw.org","phone_contact":"+32 2 539 24 67","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.552950"},"en":{"name":"International Trans*Feminist Digital Depletion Strike","shortdescr":"Constant joins the International Trans*feminist Digital Depletion Strike and invites the students of the Digital Design master\u2019s programme at \u00c9cole de Recherche Graphique (erg) to occupy its window at Rue du Fortstraat in Brussels.","longdescr":"Constant joins the International Trans*feminist Digital Depletion Strike and invites the students of the Digital Design master\u2019s programme at \u00c9cole de Recherche Graphique (erg) to occupy its window at Rue du Fortstraat in Brussels.\r\n\r\nOn 8th March 2023, the International Trans*feminist Digital Depletion Strike calls for a day of action against the Cloud. On that day, we will try to refrain from using, feeding or maintaining the Big Tech Cloud. The strike calls for a hyperscaledown of extractive digital services, and for an abundance of collective organising. We join the long historical tail of international feminist strikes, because we understand this fight to be about labour, care, anti-racism, queer life and trans*feminist techno-politics.\r\n\r\nOn 8th March, Constant will take part in different branches of the strike in Brussels. Thursday 9th March will be celebrated with an installation inspired by the strike.\r\n\r\nOpening installation: Thursday 9th March from 18:00.","performers":"The students of the Digital Design master\u2019s programme at \u00c9cole de Recherche Graphique of Brussels","boxoffice_url":null,"website":"http:\/\/www.constantvzw.org","email":"info@constantvzw.org","phone_contact":"+32 2 539 24 67","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.552950"},"de":{"name":"International Trans*Feminist Digital Depletion Strike","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.constantvzw.org","email":"info@constantvzw.org","phone_contact":"+32 2 539 24 67","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.552950"},"it":{"name":"International Trans*Feminist Digital Depletion Strike","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.constantvzw.org","email":"info@constantvzw.org","phone_contact":"+32 2 539 24 67","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.552950"},"sp":{"name":"International Trans*Feminist Digital Depletion Strike","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.constantvzw.org","email":"info@constantvzw.org","phone_contact":"+32 2 539 24 67","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.552950"},"pt":{"name":"International Trans*Feminist Digital Depletion Strike","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.constantvzw.org","email":"info@constantvzw.org","phone_contact":"+32 2 539 24 67","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.552950"},"cn":{"name":"International Trans*Feminist Digital Depletion Strike","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.constantvzw.org","email":"info@constantvzw.org","phone_contact":"+32 2 539 24 67","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.552950"}},"place":{"id":243917,"translations":{"fr":{"name":"Constant asbl","address_street_name":"Rue du Fort","address_street_number":"5","address_street_box":null,"email":"info@constantvzw.org","website":"http:\/\/www.constantvzw.org","phone_contact":"+32 2 539 24 67","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue du Fort, 5","address_line2":"1060 Saint-Gilles","description_web":"Constant est une association sans but lucratif bas\u00e9e \u00e0 Bruxelles, active depuis 1997 dans les domaines de l\u2019art et des m\u00e9dias.\r\nConstant est un atelier interdisciplinaire qui se concentre sur la culture et l\u2019\u00e9thique du web. La pratique artistique de Constant est inspir\u00e9e par la fa\u00e7on avec laquelle les infrastructures technologiques, les \u00e9changes de donn\u00e9es et les logiciels d\u00e9terminent nos vies quotidiennes. Quelques chantiers importants sont le logiciel libre, les alternatives au copyright et le (cyber)f\u00e9minisme.\r\nDe fa\u00e7on r\u00e9guli\u00e8re Constant organise des ateliers, des print-parties, des balades, des performances, des lectures et des rencontres \u2018Verbindingen\/Jonctions\u2019 pour un public qui aime l\u2019exp\u00e9rimentation, la discussion et des \u00e9changes de toutes sortes.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Constant vzw","address_street_name":"Fortstraat","address_street_number":"5","address_street_box":null,"email":"info@constantvzw.org","website":"http:\/\/www.constantvzw.org","phone_contact":"+32 2 539 24 67","phone_booking":null,"address_zip":"1060","address_city":"Sint-Gillis","address_line1":"Fortstraat, 5","address_line2":"1060 Sint-Gillis","description_web":"Constant is een vereniging zonder winstoogmerk werkzaam in het gebied tussen kunst en media.\r\nHet is een interdisciplinaire werkplaats die zich bezighoudt met de cultuur en ethiek van het web. De artistieke praktijk van Constant wordt ge\u00efnspireerd door de manier waarop technologische infrastructuren, data-uitwisseling en software ons dagelijkse leven bepalen. Belangrijke werkterreinen zijn vrije software, alternatieven op auteursrecht en (cyber)feminisme.\r\nConstant organiseert regelmatig workshops, print-parties, wandelingen en \u2018Verbindingen\/Jonctions\u2019-bijeenkomsten voor een publiek dat houdt van experimenten, discussies en uitwisselingen allerhande.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Constant","address_street_name":"Rue du Fort","address_street_number":"5","address_street_box":null,"email":"info@constantvzw.org","website":"http:\/\/www.constantvzw.org","phone_contact":"+32 2 539 24 67","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue du Fort, 5","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Constant asbl","address_street_name":"Rue du Fort","address_street_number":"5","address_street_box":null,"email":"info@constantvzw.org","website":"http:\/\/www.constantvzw.org","phone_contact":"+32 2 539 24 67","phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue du Fort, 5","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order"