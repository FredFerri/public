	<?php
			$json_file 		= file_get_contents( "./wp-content/themes/BX1-2017/cache/cache.yes.actiris.json");
			$APIContent     = json_decode($json_file, true);
			$i              = 1;
			if ($_SERVER['REMOTE_ADDR'] != '109.136.128.13-')
                {?>
    <div style="margin-top: 30px;display: grid;grid-auto-rows: 350px;grid-template-columns: repeat( auto-fill, minmax( 300px, 1fr ) );grid-gap: 2em;">
    <?php
                    foreach ($APIContent as $article)
                        {
                            if ($article["langcode"] == "fr" )
                                {
                                    $image  = $article["image"];
                                    $image = str_replace("https://yes.actiris.brussels/sites/default/files/styles/thumb_768x600px/public/media/image/","",$image);
                                    $image  = explode("?",$image);
                                    $image  = $image[0];
                                    $image = str_replace("%20",'_',$image);
                                    $image = str_replace("%CC",'_',$image);
                                    $image = str_replace("%80",'_',$image);
                                    $image = str_replace("%2B",'_',$image);
                                    $image = str_replace("%81",'_',$image);
                                    ?>
                                    <div>
                                        <div class="container">
                                            <img src="/wp-content/themes/BX1-2017/cache/img/actiris/<?php echo $image;?>" class="image">
