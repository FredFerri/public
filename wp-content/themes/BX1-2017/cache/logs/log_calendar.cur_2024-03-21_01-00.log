tart":"2024-03-23","date_end":"2024-03-23","date_next":"2024-03-23","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-02-26T11:30:06+01:00","published_at":"2024-02-15T14:12:34+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":294635,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"other","ranking":1,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":90,"translations":{"de":"Animationen","pt":null,"en":"Animations","it":"Animazioni","cn":null,"fr":"Animations","sp":"Animaciones","nl":"Animaties"}},"others":{}},"translations":{"de":{"name":"IMMENSE FESTIVAL - Expo, film et conf\u00e9rence gesticul\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/immensefestival.be\/event\/conference-gesticulee-laurent-dursel\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50007366"},"pt":{"name":"IMMENSE FESTIVAL - Expo, film et conf\u00e9rence gesticul\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/immensefestival.be\/event\/conference-gesticulee-laurent-dursel\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50007366"},"en":{"name":"IMMENSE FESTIVAL - Expo, film et conf\u00e9rence gesticul\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/immensefestival.be\/event\/conference-gesticulee-laurent-dursel\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50007366"},"it":{"name":"IMMENSE FESTIVAL - Expo, film et conf\u00e9rence gesticul\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/immensefestival.be\/event\/conference-gesticulee-laurent-dursel\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50007366"},"cn":{"name":"IMMENSE FESTIVAL - Expo, film et conf\u00e9rence gesticul\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/immensefestival.be\/event\/conference-gesticulee-laurent-dursel\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50007366"},"fr":{"name":"IMMENSE FESTIVAL - Expo, film et conf\u00e9rence gesticul\u00e9e","shortdescr":null,"longdescr":"15H30 : Ouverture de l\u2019exposition\n\n16H00 : D\u00e9but projection My Dream Home par Orfeo et Upsilove\n\n16H00-16H30 : Projection 15 min + 15 min d\u00e9bat anim\u00e9 par Orfeo et Upsilove\n\n16h30-17H00 : 2\u00e8me projection + D\u00e9bat.\n\n17H00 : Conf\u00e9rence \u201cFin du sans chez-soirisme\u201d Laurent d\u2019Ursel suivi d\u2019un d\u00e9bat avec des immenses.\n\nUPSIL\u022eV \u2013 2023\nINSTALLATION PARTICIPATIVE\nRouge \u00e9galement est l\u2019\u00e2me de la corde du marin, la corde centrale sur laquelle est tiss\u00e9 le reste de la corde. C\u2019est sa qualit\u00e9, sa r\u00e9sistance \u2013 son existence ! \u2013 qui tient la corde enti\u00e8re \u2013 et le marin en vie. (Goethe \u2013 Les affinit\u00e9s s\u00e9lectives, 1809)\n\nFil conducteur, fil du destin, il nous sort du labyrinthe, nous relie, assure la coh\u00e9rence de nos vie. Parfois il rompt, avec de la chance renoue et se renforce, croise d\u2019autres destins, tous diff\u00e9rents et similaires. Lors d\u2019un atelier de travail artistique collaboratif men\u00e9 en septembre 2023 par l\u2019artiste L\u022fV aupr\u00e8s des r\u00e9sidentes du SAMU social d\u2019Auderghem, les participantes ont effectu\u00e9 une discussion silencieuse en accrochant \u00e0 des fils, pr\u00e9alablement tendus par le groupe, leur rapport intime au foyer, \u00e0 ce que signifie \u00ab avoir un chez soi \u00bb, elles qui en sont d\u00e9pourvues. En circulant en silence parmi les cartes suspendues, elles ont cri\u00e9 leurs pertes et leurs r\u00eaves, tissant des liens entre elles et les d\u00e9ployants au del\u00e0 des murs de leur structure d\u2019accueil.\nVous \u00eates invit\u00e9\u2219es \u00e0 \u00e9changer symboliquement avec ces femmes en dessinant ou en \u00e9crivant en un mot, une phrase, dans la langue de votre choix, votre propre rapport au foyer, \u00e0 un \u00ab chez soi \u00bb, sur l\u2019une des les cartes mises \u00e0 votre disposition. D\u00e9placez-vous dans l\u2019installation, lisez les autres cartes et accrochez la v\u00f4tre sur un fil avec une pince-\u00e0-linge.\n\nNOTRE VILLAGE\nUPSIL\u022eV \u2013 2023\nOEUVRE COLLABORATIVE \u2013 COLLAGE \u2013 60X80\nLors de 4 ateliers de travail artistique collaboratif men\u00e9s en septembre 2023 par l\u2019artiste L\u022fV aupr\u00e8s des r\u00e9sidentes du SAMU social d\u2019Auderghem, les participantes ont co-cr\u00e9\u00e9 un tableau repr\u00e9sentant leur village r\u00eav\u00e9, un lieu o\u00f9 gu\u00e9rir, se reconstruire et s\u2019\u00e9panouir en paix, pour leur famille et pour elles. Sur la toile, au fil des sessions, elles ont d\u00e9pos\u00e9 leurs errances et leurs douleurs, leurs souvenirs et leurs regrets, leurs r\u00eaves et leurs espoirs ; autant de paroles accueillies au sein du groupe avec compassion et solidarit\u00e9 et port\u00e9es au dehors par leur r\u00e9alisation commune.\n\nMy dream home, film\n\n\u201cChez nous, y\u2019avait du soleil, y avait un parc, nous avions une grande maison avec 4\nchambres\u201d.\n\u201cJ\u2019aimerais me r\u00e9unir avec toute ma famille\u201d\n\u201cJ\u2019aimerais qu\u2019il y ait un jardin\u201d\n\u201cCe qui me manque ici c\u2019est la cuisine car j\u2019aime partager avec les autres.\u201d\n\u201cAvant nous \u00e9tions chez nous et il y a des messieurs qui nous ont pouss\u00e9s dans les\nescaliers et sont venus chercher notre papa \u201d\n\u201c Chez nous, Il y avait une cuisine dans laquelle je pouvais manger\u201d\nCes paroles sont celles d\u2019 enfants et celles de femmes du Samu Social d\u2019Auderghem, un centre d\u2019accueil pour familles en difficult\u00e9 d\u2019h\u00e9bergement.\nLoin de leurs proches, ces r\u00e9sident\u2219es ressassent le pass\u00e9 et r\u00eavent d\u2019un foyer comme tout le monde. Mais leur r\u00e9alit\u00e9 est diff\u00e9rente de ce qu\u2019on imagine. Certain\u2219es racontent leurs anciennes vies, d\u2019autres se consolent mutuellement de ce qu\u2019elles\/ils vivent, ou gardent espoir et se projettent dans un futur meilleur. A travers des ateliers artistiques collectifs men\u00e9s par l\u2019artiste L\u022fV, les participant\u2219es lib\u00e8rent la parole, partagent leurs exp\u00e9riences, mais surtout s\u2019\u00e9vadent quelques instants et s\u2019imaginent comment sera leur foyer de r\u00eave.\nMy dream Home , un film r\u00e9alis\u00e9 par Vanessa Mbuyi\n\n","performers":null,"boxoffice_url":null,"website":"https:\/\/immensefestival.be\/event\/conference-gesticulee-laurent-dursel\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50007366"},"sp":{"name":"IMMENSE FESTIVAL - Expo, film et conf\u00e9rence gesticul\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/immensefestival.be\/event\/conference-gesticulee-laurent-dursel\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5000