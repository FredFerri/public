sub_type":"theatre","show_in_agenda":true,"ranking":0.15396304049942},{"id":560053,"date_start":"2023-07-30","date_end":"2023-07-30","date_next":"2023-07-30","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen","it":"Visite guidate","sp":"Visitas guiadas","pt":null,"cn":null}},"others":{}},"languages":{"spoken":["nl","fr"],"subtitles":[]},"translations":{"fr":{"name":"Dimanche \u00e0 v\u00e9lo | Site de la M\u00e9m\u00e9","shortdescr":null,"longdescr":"Profitez du r\u00e9veil silencieux de la ville le dimanche matin. Une balade \u00e0 v\u00e9lo agr\u00e9able, une excellente dose de mouvement et id\u00e9ale pour rencontrer d'autres Bruxellois ! Une balade vers Woluwe-St-Lambert d'environs 18km (aller) o\u00f9 nous d\u00e9couvrirons le site de la M\u00e9m\u00e9 de l\u2019UCL. Un endroit avec un patrimoine remarquable entour\u00e9 de verdure. Nous arrivons vers midi \u00e0 notre destination. Nous pr\u00e9voyons quelque chose \u00e0 boire, n'h\u00e9sitez pas \u00e0 apporter votre propre casse-cro\u00fbte!\r\n\r\nD\u00e9part \u00e0 10h00 du Grand Hospice\r\nNous arrivons \u00e0 notre destination vers 11h30 o\u00f9 nous buvons quelque chose ensemble. N\u2019h\u00e9sitez pas \u00e0 emmener un casse-cro\u00fbte\r\nAu plus tard \u00e0 12h30, vous pouvez regagner le centre ville \u00e0 v\u00e9lo avec l'un de nos guides\r\nGratuit\r\nInscriptions: info@cactus.brussels","performers":null,"boxoffice_url":null,"website":"http:\/\/www.cactus.brussels","email":"info@cactus.brussels","phone_contact":null,"phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.560053"},"nl":{"name":"Dimanche \u00e0 v\u00e9lo | Site de la M\u00e9m\u00e9","shortdescr":null,"longdescr":"Geniet van het stille ontwaken van de stad op zondagochtend. Een aangename fietstocht, een goede dosis beweging en ideaal om andere Brusselaars te ontmoeten! Een fietstocht naar Sint-Lambrechts-Woluwe van ongeveer 18 km (heen) waar we de site van la M\u00e9m\u00e9 op de UCL-campus ontdekken. Een plek met een opmerkelijk erfgoed omgeven door groen. We komen rond het middaguur aan op onze bestemming. We zorgen voor iets te drinken en neem gerust zelf iets klein te eten mee!\r\n\r\nWe starten om 10u00 aan de Grand Hospice\r\nTegen 11u30 komen we aan en drinken we samen iets. Aarzel niet een hapje als aperitief mee te nemen\r\nTen laatste om 12u30 kan je met \u00e9\u00e9n van onze gidsen terug richting centrum fietsen\r\nGratis\r\nInschrijven: info@cactus.brussels","performers":null,"boxoffice_url":null,"website":"http:\/\/www.cactus.brussels","email":"info@cactus.brussels","phone_contact":null,"phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.560053"},"en":{"name":"Dimanche \u00e0 v\u00e9lo | Site de la M\u00e9m\u00e9","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.cactus.brussels","email":"info@cactus.brussels","phone_contact":null,"phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.560053"},"de":{"name":"Dimanche \u00e0 v\u00e9lo | Site de la M\u00e9m\u00e9","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.cactus.brussels","email":"info@cactus.brussels","phone_contact":null,"phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.560053"},"it":{"name":"Dimanche \u00e0 v\u00e9lo | Site de la M\u00e9m\u00e9","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/