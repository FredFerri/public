e":"tour","ranking":0.4807498567691361,"languages":{"spoken":["fr","en","nl"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{"list":[253],"translations":{"de":["F\u00fchrungen durch Innenr\u00e4ume"],"pt":[null],"en":["Interior guided tours"],"it":["Visite guidate all\u2019interno"],"cn":[null],"fr":["Visites guid\u00e9es d\u2019int\u00e9rieurs"],"sp":["Visitas guiadas en espacios interiores"],"nl":["Interieur rondleidingen"]}}},"translations":{"de":{"name":"BANAD Festival - Guided tour of the Max Hallet Mansion","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700006046"},"pt":{"name":"BANAD Festival - Guided tour of the Max Hallet Mansion","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700006046"},"en":{"name":"BANAD Festival - Max Hallet Mansion","shortdescr":null,"longdescr":"This mansion was built between 1902 and 1905 on the prestigious Avenue Louise for the lawyer and politician Max Hallet. Its elegant sobriety marks a toning-down of Victor Horta's exuberant style. The 14m-wide facade of Euville limestone has a strongly horizontal design. The interior is dominated by a stunning ceremonial staircase, with daylight flooding onto it through the unusually shaped winter garden and central skylight, that is reflected by white marble floors. The rooms are decorated in typical Art Nouveau style, featuring a blend of curves and counter-curves.\n\n\nArch. Victor HORTA, 1903\n","performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/en\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700006046"},"it":{"name":"BANAD Festival - Guided tour of the Max Hallet Mansion","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700006046"},"cn":{"name":"BANAD Festival - Guided tour of the Max Hallet Mansion","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700006046"},"fr":{"name":"BANAD Festival - H\u00f4tel Max","shortdescr":null,"longdescr":"Construit entre 1902 et 1905 pour l'avocat et politicien Max Hallet, cet h\u00f4tel de ma\u00eetre occupe la prestigieuse avenue Louise. D'une sobri\u00e9t\u00e9 \u00e9l\u00e9gante, cette \u0153uvre marque un passage \u00e0 un style assagi dans la carri\u00e8re de Victor Horta. La fa\u00e7ade de 14 m de long en pierre d'Euville marque par l'horizontalit\u00e9 de sa composition. L'int\u00e9rieur frappe par sa luminosit\u00e9 et son splendide escalier d'honneur, v\u00e9ritable puits de lumi\u00e8re qui repr\u00e9sente le c\u0153ur de la maison. La lumi\u00e8re se refl\u00e8te sur le marbre blanc de l'escalier et illumine la maison \u00e0 travers le superbe jardin d'hiver et le lanterneau central. Les autres pi\u00e8ces de la maison sont marqu\u00e9es d'une d\u00e9coration typiquement Art nouveau ou s'entrem\u00ealent courbes et contre courbes.\n\n\nArch. Victor HORTA, 1903\n","performers":"\n","boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700006046"},"sp":{"name":"BANAD Festival - Guided tour of the Max Hallet Mansion","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700006046"},"nl":{"name":"BANAD Festival - Hallet Herenhuis","shortdescr":null,"longdescr":"Dit herenhuis werd tussen 1902 en 1905 gebouwd voor advocaat en politicus Max Hallet en is te bewonderen in de prestigieuze Louizalaan. Dit werk, dat een elegante eenvoud uitstraalt, luidt de overgang naar een gekalmeerde stijl in de carri\u00e8re van Victor Horta in. De 14 meter lange gevel van Euvillesteen kenmerkt zich door een horizontale samenstelling. Het interieur verrast met zijn helderheid en schitterende staatsietrap, een heuse lichtschacht die het hart van het huis vormt. Het licht wordt weerkaatst op het witte marmer van de trap en verlicht het huis via de prachtige wintertuin en het centrale dakraam. De andere kamers in het huis kregen een typische decoratie in de stijl van de art nouveau, met veel ineengestrengelde bogen en tegenbogen.\n\nArch. Victor HORTA, 1903","performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/nl\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700006046"}},"place":{"id":50002213,"translations":{"de":{"name":"H\u00f4tel Max Hallet","address_street_name":"Avenue Louise","address_street_number":"346","address_street_box":null,"email":null,"website":null,"phone_contact":nu