 and saturday: from 10:30 to 17:30","sunday: closed"],"it":["monday, tuesday, wednesday, thursday, friday and saturday: from 10:30 to 17:30","sunday: closed"],"sp":["monday, tuesday, wednesday, thursday, friday and saturday: from 10:30 to 17:30","sunday: closed"],"pt":["monday, tuesday, wednesday, thursday, friday and saturday: from 10:30 to 17:30","sunday: closed"],"cn":["monday, tuesday, wednesday, thursday, friday and saturday: from 10:30 to 17:30","sunday: closed"]},"date_start":"2023-03-10","date_end":"2023-12-31","is_also_by_appointment":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"},"de":{"name":"Normal"},"it":{"name":"Normale"},"sp":{"name":"Normal"},"pt":{"name":"Normal"},"cn":{"name":"Normal"}},"value":35}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":["annee_art_nouveau"],"is_part_of":"Ann\u00e9e Art Nouveau","accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-02-10T16:35:36+01:00","published_at":"2022-11-16T16:28:36+01:00","backoffice_id":265724,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.28219327709008},{"id":549214,"date_start":"2023-01-21","date_end":"2023-03-10","date_next":"2023-03-10","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung","it":"Esposizioni","sp":"Exhibici\u00f3n","pt":null,"cn":null}},"others":{"list":[36,46],"translations":{"fr":["Mus\u00e9es et art centers","Pluridisciplinaire"],"nl":["Musea en kunstcentra","Multidisciplinair"],"en":["Museums and art centers","Multidisciplinary"],"de":["Museen & Kunstzentren","Multidisziplin\u00e4r"],"it":["Musei e centri artistici","Multidisciplinare"],"sp":["Museos y centros de arte","Multidisciplinar"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Juif ? Les st\u00e9r\u00e9otypes antis\u00e9mites, de l\u2019antiquit\u00e9 \u00e0 nos jours","shortdescr":"[GRATUIT-INSCRIPTION EN LIGNE OBLIGATOIRE]\r\nL\u2019exposition aborde l\u2019histoire des st\u00e9r\u00e9otypes et des pr\u00e9jug\u00e9s \u00e0 l\u2019encontre des Juifs, de l\u2019Empire Romain \u00e0 aujourd\u2019hui. L\u2019argent, le contr\u00f4le des m\u00e9dias et de la finance, la crise de la Covid-19\u2026 Les accusations dont les Juifs ont \u00e9t\u00e9 affubl\u00e9s au long de l\u2019histoire sont abord\u00e9es en privil\u00e9giant une approche ancr\u00e9e sur l\u2019aspect visuel.","longdescr":"[GRATUIT-INSCRIPTION EN LIGNE OBLIGATOIRE]\r\nLa haine des Juifs, l\u2019antis\u00e9mitisme ou jud\u00e9ophobie, s\u2019est appuy\u00e9 pendant des si\u00e8cles, voire des mill\u00e9naires, sur une longue s\u00e9rie de st\u00e9r\u00e9otypes. Sur base de justifications religieuses, culturellesb u encore \u00ab raciales \u00bb, les Juifs ont longtemps \u00e9t\u00e9 les boucs \u00e9missaires des pays o\u00f9 ils vivaient et parfois m\u00eame, de pays dont ils \u00e9taient absents.\r\n\r\nMais \u00ab Juifs \u00bb ? C\u2019est quoi au juste ? D\u2019o\u00f9 viennent-ils ? Quelle est l\u2019histoire des diff\u00e9rentes accusations port\u00e9es \u00e0 leur encontre ? Quand commence leur pers\u00e9cution et, surtout, pourquoi ?\r\n\r\nLes 17 panneaux de l\u2019exposition r\u00e9pondent \u00e0 ces questions, en abordant l\u2019histoire des st\u00e9r\u00e9otypes et des pr\u00e9jug\u00e9s \u00e0 l\u2019encontre des Juifs, de l\u2019Empire Romain \u00e0 aujourd'hui. Loin des formats classiques, \u201cJuif ?\u201d interroge les connaissances du public sur le th\u00e8me, en posant des questions avant de proposer des balises pour aider \u00e0 aborder un sujet aussi vaste et complexe. L\u2019argent, le contr\u00f4le des m\u00e9dias et de la finance, la crise de la Covid-19\u2026 Les diff\u00e9rentes accusations dont les Juifs ont \u00e9t\u00e9 affubl\u00e9s au long de l\u2019histoire sont abord\u00e9es de mani\u00e8re dynamique et succincte, en privil\u00e9giant une approche ancr\u00e9e sur l\u2019aspect visuel.","performers":null,"boxoffice_url":null,"website":"https:\/\/cclj.be\/evenement\/visite-interactive-de-lexposition-juif-0\/","email":"alejo@cclj.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.549214"},"nl":{"name":"Juif ? Les st\u00e9r\u00e9otypes antis\u00e9mites, de l\u2019antiquit\u00e9 \u00e0 nos jours","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/cclj.be\/evenement\/visite-interactive-de-lexposition-juif-0\/","email":"alejo@cclj.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.549214"},"en":{"name":"Juif ? Les st\u00e9r\u00e9otypes antis\u00e9mites, de l\u2019antiquit\u00e9 \u00e0 nos jours","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/cclj.be\/evenement\/visite-interactive-de-lexposition-juif-0\/","email":"alejo@cclj.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.549214"},"de":{"name":"Juif ? Les st\u00e9r\u00e9otypes antis\u00e9mites, de l\u2019antiquit\u00e9 \u00e0 nos jours","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/cclj.be\/evenement\/visite-interactive-de-lexposition-juif-0\/","email":"alejo@cclj.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.549214"},"it":{"name":"Juif ? Les st\u00e9r\u00e9otypes antis\u00e9mites, de l\u2019antiquit\u00e9 \u00e0 nos 