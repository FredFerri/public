an":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-02-18T01:02:59+01:00","published_at":"2024-01-24T16:04:58+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":293000,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.41008825631569273,"languages":{"spoken":["en","nl","fr"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[39,36],"translations":{"de":["Fotografie","Museen & Kunstzentren"],"pt":[null,null],"en":["Photography","Museums and art centers"],"it":["Fotografia","Musei e centri artistici"],"cn":[null,null],"fr":["Photographie","Mus\u00e9es et art centers"],"sp":["Fotograf\u00eda","Museos y centros de arte"],"nl":["Fotografie","Musea en kunstcentra"]}}},"translations":{"de":{"name":"Ingeborg Inside Views","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/tinygallery.photo","email":"olivier@tinygallery.brussels","phone_contact":"+32 475 27 95 56","phone_booking":"+32 475 27 95 56","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50006443"},"pt":{"name":"Ingeborg Inside Views","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/tinygallery.photo","email":"olivier@tinygallery.brussels","phone_contact":"+32 475 27 95 56","phone_booking":"+32 475 27 95 56","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50006443"},"en":{"name":"Ingeborg Inside View - Photo Brussels Festival","shortdescr":"Antwerp art photographer Ingeborg Selleslags, a 2016 victim of the national airport attacks, uses large format portraits in Van Dyke and Cyanotypes to create intricate, long, and meticulous works. These images, created in silence and solitude, explore the vulnerability of leaving life and the loneliness of the last breath of life, ultimately allowing the artist to accept and admire death\u2019s beauty.","longdescr":"Through her meticulous work, this talented photographer creates large format portraits using the VanDyke and Cyanotypes techniques. These methods require patience, precision, and a deep connection with the subject matter. The resulting images are a testament to her journey of healing and self-discovery.\nHer works speak to the vulnerability of leaving life, capturing the essence of death as a destructive, irreversible, and brutal force. Each portrait tells a story of the loneliness experienced in the moment of death, the final breath of life, and the heart-wrenching act of leaving loved ones behind. It is a poignant exploration of letting go and embracing the unknown.\n","performers":"Ingeborg Selleslags","boxoffice_url":null,"website":"https:\/\/tinygallery.photo","email":"olivier@tinygallery.brussels","phone_contact":"+32 475 27 95 56","phone_booking":"+32 475 27 95 56","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50006443"},"it":{"name":"Ingeborg Inside Views","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/tinygallery.photo","email":"olivier@tinygallery.brussels","phone_contact":"+32 475 27 95 56","phone_booking":"+32 475 27 95 56","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50006443"},"cn":{"name":"Ingeborg Inside Views","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/tinygallery.photo","email":"olivier@tinygallery.brussels","phone_contact":"+32 475 27 95 56","phone_booking":"+32 475 27 95 56","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50006443"},"fr":{"name":"Ingeborg Inside View - Photo Brussels Festival","shortdescr":"La photographe anversoise Ingeborg, victime des attentats de l\u2019a\u00e9roport national en 2016, r\u00e9alise des portraits grand format en Van Dyke pour cr\u00e9er des \u0153uvres complexes et m\u00e9ticuleuses. Ces images, cr\u00e9\u00e9es dans le silence et la solitude, explorent la vuln\u00e9rabilit\u00e9 de quitter la vie et la solitude du dernier souffle, permettant finalement \u00e0 l\u2019artiste d\u2019accepter et d\u2019admirer la beaut\u00e9 de la mort.\n","longdescr":"Par son travail minutieux, cette photographe talentueuse r\u00e9alise des portraits grand format en utilisant les techniques VanDyke et Cyanotypes. Ces m\u00e9thodes n\u00e9cessitent de la patience, de la pr\u00e9cision et un lien profond avec le sujet. Les images qui en r\u00e9sultent t\u00e9moignent de son parcours de gu\u00e9rison et de d\u00e9couverte de soi.\nSes \u0153uvres parlent de la vuln\u00e9rabilit\u00e9 de quitter la vie, capturant l'essence de la mort comme une force destructrice, irr\u00e9versible et brutale. Chaque portrait raconte l'histoire de la solitude ressentie au moment de la mort, du dernier souffle de la vie et de l'acte d\u00e9chirant de laisser derri\u00e8re soi des \u00eatres chers. C\u2019est une exploration poignante du l\u00e2cher prise et de l\u2019acceptation de l\u2019inconnu.\n","performers":"Ingeborg Selleslags","boxoffice_url":null,"website":"https:\/\/tinygallery.photo","email":"olivier@tinygallery.brussels","phone_contact":"+32 475 27 95 56","phone_booking":"+32 475 27 95 56","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50006443"},"sp":{"name":"Ingeborg Inside Views","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/tinygallery.photo","email":"olivier@tinygallery.brussels","phone_contact":"+32 475 27 95 56","phone_booking":"+32 475 27 95 56","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50006443"},"nl":{"name":"Ingeborg Inside View - Photo Brussels Festival","shortdescr":"De Antwerpse kunstfotograaf, in 2016 slachtoffer van de nationale luchthavenaanvallen, realiseerd portretten op groot formaat in Van Dyke om ingewikkelde, langdurige en nauwgezette werken te cre\u00ebren. Deze beelden, gemaakt in stilte en eenzaamheid, onderzoeken de kwetsbaarheid van het verlaten van het leven en de eenzaamheid van de laatste levensadem.\n","longdescr":"De Antwerpse kunstfotograaf, in 2016 slachtoffer van de nationale luchthavenaanvallen, gebruikt portretten op groot formaat in Van Dyke en Cyanotypes om ingewikkelde, langdurige en nauwgezette werken te cre\u00ebren. Deze beelden, gemaakt in stilte en eenzaamheid, onderzoeken de kwetsbaarheid van het verlaten van het leven en de eenzaamheid van de laatste levensadem, waardoor de kunstenaar uiteindelijk de schoonheid van de dood kan accepteren en bewonderen.\n\nDoor haar nauwgezette werk cre\u00ebert deze getalenteerde fotograaf portretten op groot formaat met behulp van de VanDyke- en Cyanotypes-technieken. Deze methoden vereisen geduld, precisie en een diepe verbinding met het onderwerp. De resulterende beelden zijn een bewijs van haar reis van genezing en zelfontdekking.\n","performers":"Ingeborg Selleslags","boxoffice_url":null,"website":"https:\/\/tinygallery.photo","email":"olivier@tinygallery.brussels","phone_contact":"+32 475 27 95 56","phone_booking":"+32 475 27 95 56","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50006443"}},"place":{"id":275243,"translations":{"de":{"name":"TinyGallery Brussels","address_street_name":"Rue de la Cuve","address_street_number":"26","address_street_box":null,"email":"ogc@ogc.be","website":"http:\/\/www.tinygallery.photo","phone_contact":"+32 475 27 95 56","phone_booking":"+32 472 27 95 56","address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de la Cuve, 26","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"TinyGallery Brussels","address_street_name":"Rue de la Cuve","address_street_number":"26","address_street_box":null,"email":"ogc@ogc.be","website":"http:\/\/www.tinygallery.photo","phone_contact":"+32 475 27 95 56","phone_booking":"+32 472 27 95 56","address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de la Cuve, 26","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"TinyGallery Brussels","address_street_name":"Rue de la Cuve","address_street_number":"26","address_street_box":null,"email":"ogc@ogc.be","website":"http:\/\/www.tinygallery.photo","phone_contact":"+32 475 27 95 56","phone_booking":"+32 472 27 95 56","address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de la Cuve, 26","address_line2":"1050 Ixelles","description_web":"TinyGallery - Small museum of amateur photography - wishes to preserve amateur photography and pay tribute to the anonymous artists who authored them.\r\n\r\nWhether produced intentionally or accidentally, amateur photography fascinates us with its spontaneous creations. Magical, raw moments are captured, allowing us an intimate insight into the lives of strangers who lived over a century ago. In a nod to the vanity of the ephemeral, these benevolent ghosts, who have long been protected by the shadows of the past, surprise us with their proximity. Battered and bruised albums scattered over flea markets surrender to us defencelessly, bearing witness to a time when photography was not considered dangerous. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"TinyGallery Brussels","address_street_name":"Rue de la Cuve","address_street_number":"26","address_street_box":null,"email":"ogc@ogc.be","website":"http:\/\/www.tinygallery.photo","phone_contact":"+32 475 27 95 56","phone_booking":"+32 472 27 95 56","address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de la Cuve, 26","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"TinyGallery Brussels","address_street_name":"Rue de la Cuve","address_street_number":"26","address_street_box":null,"email":"ogc@ogc.be","website":"http:\/\/www.tinygallery.photo","phone_contact":"+32 475 27 95 56","phone_booking":"+32 472 27 95 56","address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de la Cuve, 26","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"TinyGallery Brussels","address_street_name":"Rue de la Cuve","address_street_number":"26","address_street_box":null,"email":"ogc@ogc.be","website":"http:\/\/www.tinygallery.photo","phone_contact":"+32 475 27 95 56","phone_booking":"+32 472 27 95 56","address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de la Cuve, 26","address_line2":"1050 Ixelles","description_web":"La TinyGallery - Petit mus\u00e9e de la photographie amateur - veut conserver la photographie amateur et rendre hommage \u00e0 leurs auteurs, ces artistes anonymes.\r\n\r\nIntentionnelle ou accidentelle, la photographie amateur nous fascine par ses cr\u00e9ations spontan\u00e9es. Instants magiques et bruts o\u00f9 nous entrons dans l\u2019intimit\u00e9 de ces inconnus \u00e0 plus d\u2019un si\u00e8cle de distance. Clins d'oeil \u00e0 la vanit\u00e9 de l'\u00e9ph\u00e9m\u00e8re, ces fant\u00f4mes bienveillants longtemps prot\u00e9g\u00e9s dans l\u2019ombre des albums nous surprennent par leur proximit\u00e9. Albums d\u00e9piaut\u00e9s, dispers\u00e9s, brocant\u00e9s, se livrant et sans d\u00e9fenses, ils sont les t\u00e9moins d\u2019un temps o\u00f9 la photographie n'\u00e9tait pas consid\u00e9r\u00e9e comme dangereuse. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"TinyGallery Brussels","address_street_name":"Rue de la Cuve","address_street_number":"26","address_street_box":null,"email":"ogc@ogc.be","website":"http:\/\/www.tinygallery.photo","phone_contact":"+32 475 27 95 56","phone_booking":"+32 472 27 95 56","address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de la Cuve, 26","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"TinyGallery Brussels","address_street_name":"Kuipstraat","address_street_number":"26","address_street_box":null,"email":"ogc@ogc.be","website":"http:\/\/www.tinygallery.photo","phone_contact":"+32 475 27 95 56","phone_booking":"+32 472 27 95 56","address_zip":"1050","address_city":"Ixelles","address_line1":"Kuipstraat, 26","address_line2":"1050 Ixelles","description_web":"TinyGallery - Klein museum voor amateurfotografie - wil de amateurfotografie conserveren en hulde brengen aan hun auteurs, deze anonieme kunstenaars.\r\n\r\nAmateurfotografie fascineert ons door de spontane creaties. Ze ontstaan doelbewust of ongewild, die magische en authentieke fragmenten van de intimiteit van onbekenden die meer dan een eeuw geleden leefden. Een knipoog naar de ijdelheid van het kortstondige, welwillende geesten die lang beschermd waren in de schaduw van vergeten albums. Ze verrassen ons met hun nabijheid, intieme albums die weerloos opengerukt eindigden op de rommelmarkt, stille getuigen van een tijd waarin fotografie niet als gevaarlijk werd beschouwd. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[5],"translations":{"de":["Flagey"],"pt":[null],"en":["Flagey"],"it":["Flagey"],"cn":[null],"fr":["Flagey"],"sp":["Flagey"],"nl":["Flagey"]}},"zones":{"list":[21],"translations":{"de":["S\u00fcden"],"pt":[null],"en":["South"],"it":["Sud"],"cn":[null],"f