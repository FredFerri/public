nslations":{"de":["Stadtteile"],"pt":[null],"en":["Neighbourhoods"],"it":["Quartieri"],"cn":[null],"fr":["Quartiers"],"sp":["Barrios"],"nl":["Wijken"]}}},"translations":{"de":{"name":"Ixelles : Quartier d'Artistes et d'Anarchistes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/www.visit.brussels\/de\/besucher\/veranstaltungskalender\/event-detail\/book-tickets.Ixelles-Quartier-d-Artistes-et-d-Anarchistes.5700003850","website":"https:\/\/brusselsbyfoot.be\/ixelles-quartier-dartistes-et-danarchistes\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700003850"},"pt":{"name":"Ixelles : Quartier d'Artistes et d'Anarchistes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/www.visit.brussels\/en\/visitors\/agenda\/event-detail\/book-tickets.Ixelles-Quartier-d-Artistes-et-d-Anarchistes.5700003850","website":"https:\/\/brusselsbyfoot.be\/ixelles-quartier-dartistes-et-danarchistes\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700003850"},"en":{"name":"Ixelles : Quartier d'Artistes et d'Anarchistes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/www.visit.brussels\/en\/visitors\/agenda\/event-detail\/book-tickets.Ixelles-Quartier-d-Artistes-et-d-Anarchistes.5700003850","website":"https:\/\/brusselsbyfoot.be\/ixelles-quartier-dartistes-et-danarchistes\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700003850"},"it":{"name":"Ixelles : Quartier d'Artistes et d'Anarchistes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/www.visit.brussels\/it\/visitatori\/agenda\/event-detail\/book-tickets.Ixelles-Quartier-d-Artistes-et-d-Anarchistes.5700003850","website":"https:\/\/brusselsbyfoot.be\/ixelles-quartier-dartistes-et-danarchistes\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700003850"},"cn":{"name":"Ixelles : Quartier d'Artistes et d'Anarchistes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/www.visit.brussels\/en\/visitors\/agenda\/event-detail\/book-tickets.Ixelles-Quartier-d-Artistes-et-d-Anarchistes.5700003850","website":"https:\/\/brusselsbyfoot.be\/ixelles-quartier-dartistes-et-danarchistes\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700003850"},"fr":{"name":"Ixelles : Quartier d'Artistes et d'Anarchistes","shortdescr":"Plongez au c\u0153ur de l\u2019un des quartiers les plus vivants et iconoclastes de Bruxelles. Ce parcours immersif vous invite \u00e0 d\u00e9couvrir l'histoire fascinante d'un quartier o\u00f9 se croisent cr\u00e9ativit\u00e9, r\u00e9bellion et engagement social.","longdescr":"Plongez au c\u0153ur de l\u2019un des quartiers les plus vivants et iconoclastes de Bruxelles. Ce parcours immersif vous invite \u00e0 d\u00e9couvrir l'histoire fascinante d'un quartier o\u00f9 se croisent cr\u00e9ativit\u00e9, r\u00e9bellion et engagement social.\n\n    La gen\u00e8se de quelques grands mouvements artistiques\n    Des personnages et des personnalit\u00e9s inspirantes\n    D\u00e9couvrez les lieux de vie de quelques penseurs rebelles de leurs \u00e9poques : Karl Marx, Proudhon, Victor Serge, Neel Doff,...\n    L'\u00e9ph\u00e9m\u00e8re \"Universit\u00e9 Nouvelle\", version radicale de l'ULB\n    La maison de naissance d'Audrey Hepburn\n    Des nombreuses histoires et anecdotes inattendues\n\nLaissez-vous guider \u00e0 travers les rues pittoresques d'Ixelles, o\u00f9 l\u2019art se m\u00eale \u00e0 l\u2019histoire et o\u00f9 les traces du pass\u00e9 se retrouvent sur chaque coin de rue. De l\u2019effervescence des ateliers d'artistes aux traces laiss\u00e9es par les mouvements anarchistes et les luttes sociales, chaque \u00e9tape de cette visite vous fera d\u00e9couvrir une facette unique de la ville, entre h\u00e9ritage et modernit\u00e9.\n\nVous explorerez les galeries d'art cach\u00e9es et d\u00e9couvrirez des lieux embl\u00e9matiques qui ont \u00e9t\u00e9 des refuges pour les artistes et des points de ralliement pour les militants. Notre guide passionn\u00e9 vous racontera les anecdotes in\u00e9dites qui ont forg\u00e9 l\u2019identit\u00e9 rebelle et artistique d'Ixelles, tout en vous r\u00e9v\u00e9lant des lieux secrets, souvent ignor\u00e9s des ixellois eux-m\u00eames.\n\nQue vous soyez amateur d'art, curieux d'histoire ou passionn\u00e9 par les luttes sociales, cette visite vous offrira un regard original et profond sur un des quartiers les plus embl\u00e9matiques de Bruxelles. Venez arpenter les rues d\u2019Ixelles, un v\u00e9ritable laboratoire d\u2019id\u00e9es et de cultures o\u00f9 l\u2019art et l\u2019anarchie se rencontrent pour fa\u00e7onner un Bruxelles \u00e0 la fois libre et audacieux.","performers":"Une visite guid\u00e9e de Brussels By Foot","boxoffice_url":"https:\/\/www.visit.brussels\/fr\/visiteurs\/agenda\/event-detail\/book-tickets.Ixelles-Quartier-d-Artistes-et-d-Anarchistes.5700003850","website":"https:\/\/brusselsbyfoot.be\/ixelles-quartier-dartistes-et-danarchistes\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700003850"},"sp":{"name":"Ixelles : Quartier d'Artistes et d'Anarchistes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/www.visit.brussels\/es\/visitantes\/agen