t":"2022-11-15T05:35:25+01:00","published_at":"2013-10-19T01:13:49+02:00","import_origin":null,"external_id":null,"is_in_address_book":false,"is_in_vb_export":false,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/b15912be9dd34c1c59daad38c0cc31228051193e.jpg","width":3626,"height":2417,"ratio":1.5,"translations":{"fr":{"title":"#EU2022CZ","copyright":"(c) Martin_Divisek"},"nl":{"title":"#EU2022CZ","copyright":"(c) Martin_Divisek"},"en":{"title":"#EU2022CZ","copyright":"(c) Martin_Divisek"}}},{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/0719f56790e1ca99feb74345b0535d1cd4e894bb.jpg","width":2048,"height":1536,"ratio":1.33,"translations":{"fr":{"title":"#EU2022CZ","copyright":"(c) Dagmar Kne\u0159ov\u00e1"},"nl":{"title":"#EU2022CZ","copyright":"(c) Dagmar Kne\u0159ov\u00e1"},"en":{"title":"#EU2022CZ","copyright":"(c) Dagmar Kne\u0159ov\u00e1"}}},{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/cc9e566ce3c0c1270f614e23171d4054f9b248a7.jpg","width":1500,"height":1000,"ratio":1.5,"translations":{"fr":{"title":"#EU2022CZ","copyright":"(c) Brno"},"nl":{"title":"#EU2022CZ","copyright":"(c) Brno"},"en":{"title":"#EU2022CZ","copyright":"(c) Brno"}}},{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/6a25c6e78fb8c308f25394dd461572a6df489125.jpg","width":3456,"height":4608,"ratio":0.75,"translations":{"fr":{"title":"#EU2022CZ","copyright":"(c) Czech Centre Brussels"},"nl":{"title":"#EU2022CZ","copyright":"(c) Czech Centre Brussels"},"en":{"title":"#EU2022CZ","copyright":"(c) Czech Centre Brussels"}}}],"dates":[],"prices":[],"child_events":[536050,536150,536158,536159],"parent_events":[],"targets":{"list":[],"translations":{}},"visit_profile":{"list":[337],"translations":{"fr":["Highlight"],"nl":["Highlight"],"en":["Highlight"],"de":["Highlight"]}},"tags":["major_event"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-11-15T05:35:26+01:00","published_at":"2022-06-15T11:54:27+02:00","backoffice_id":256045,"import_origin":null,"sub_type":"festival","show_in_agenda":true,"ranking":0.22151546799152},{"id":544997,"date_start":"2022-06-17","date_end":"2023-01-01","date_next":"2023-01-01","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung"}},"others":{"list":[36,46],"translations":{"fr":["Mus\u00e9es et art centers","Pluridisciplinaire"],"nl":["Musea en kunstcentra","Multidisciplinair"],"en":["Museums and art centers","Multidisciplinary"],"de":["Museen & Kunstzentren","Multidisziplin\u00e4r"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Nikolay Karabinovych \u2013 Why do you stand at the door?","shortdescr":"Why do you stand at the door? est le r\u00e9sultat d\u2019une recherche men\u00e9e en 2021 et 2022 par l\u2019artiste ukrainien Nikolay Karabinovych (\u00b01988, Odesa*) au sein du Mus\u00e9e Juif de Belgique.","longdescr":"Why do you stand at the door? est le r\u00e9sultat d\u2019une recherche men\u00e9e en 2021 et 2022 par l\u2019artiste ukrainien Nikolay Karabinovych (\u00b01988, Odesa*) au sein du Mus\u00e9e Juif de Belgique. Dans le \u00ab Project Space \u00bb, vid\u00e9o, son, textes et installation de cet artiste multidisciplinaire sont mis en dialogue avec des publications des ann\u00e9es 1920-1930 pr\u00e9serv\u00e9es dans la biblioth\u00e8que yiddish du mus\u00e9e, ainsi qu\u2019avec des objets issus du patrimoine juif.","performers":"Nikolay Karabinovych (artiste)","boxoffice_url":null,"website":"http:\/\/www.mjb-jmb.org","email":"info@mjb-jmb.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.544997"},"nl":{"name":"Nikolay Karabinovych \u2013 Why do you stand at the door?","shortdescr":"\u2018Why do you stand at the door?\u2019 is het resultaat van een onderzoek dat de Oekra\u00efense kunstenaar Nikolay Karabinovych (\u00b01988, Odesa*) in 2021 en 2022 uitvoerde in het Joods Museum van Belgi\u00eb.","longdescr":"\u2018Why do you stand at the door?\u2019 is het resultaat van een onderzoek dat de Oekra\u00efense kunstenaar Nikolay Karabinovych (\u00b01988, Odesa*) in 2021 en 2022 uitvoerde in het Joods Museum van Belgi\u00eb. In de \u2018Project Space\u2019 laat deze multidisciplinaire kunstenaar video, geluid, teksten en installatie in dialoog gaan met publicaties uit de jaren 1920-1930 die het museum bewaart in haar Jiddische bibliotheek en ook met objecten uit het Joodse erfgoed.","performers":"Nikolay Karabinovych (artiest)","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.544997"},"en":{"name":"Nikolay Karabinovych \u2013 Why do you stand at the door?","shortdescr":"Why do you stand at the door? is the result of research carried out in 2021 and 2022 by the Ukrainian artist Nikolay Karabinovych (\u00b01988, Odesa*) at the Jewish Museum of Belgium.","longdescr":"Why do you stand at the door? is the result of research carried out in 2021 and 2022 by the Ukrainian artist Nikolay Karabinovych (\u00b01988, Odesa*) at the Jewish Museum of Belgium. In 'Project Space', video, sound, text and installation by this multidisciplinary artist are placed in dialogue with publications from the 1920s-1930s preserved in the museum's Yiddish library, as well as with objects from the Jewish heritage.","performers":"Nikolay Karabinovych (artist)","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.544997"},"de":{"name":"Nikolay Karabinovych \u2013 Why do you stand at the door?","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.544997"},"it":{"name":"Nikolay Karabinovych \u2013 Why do you stand at the door?","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.544997"},"sp":{"name":"Nikolay Karabinovych \u2013 Why do you stand at the door?","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.544997"},"pt":{"name":"Nikolay Karabinovych \u2013 Why do you stand at the door?","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.544997"},"cn":{"name":"Nikolay Karabinovych \u2013 Why do you stand at the door?","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.544997"}},"place":{"id":209899,"translations":{"fr":{"name":"Mus\u00e9e Juif de Belgique","address_street_name":"Rue des Minimes","address_street_number":"21","address_street_box":null,"email":"info@mjb-jmb.org","website":"http:\/\/www.mjb-jmb.org","phone_contact":"+32 2 512 19 63","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Minimes, 21","address_line2":"1000 Bruxelles","description_web":"Situ\u00e9 \u00e0 Bruxelles, dans le quartier du Sablon, le Mus\u00e9e Juif de Belgique porte un regard novateur sur l\u2019histoire et la culture juive \u00e0 travers des expositions et des activit\u00e9s tourn\u00e9es vers le partage, la d\u00e9couverte et l\u2019accessibilit\u00e9 \u00e0 tous les publics. \r\n \r\nR\u00e9solument ancr\u00e9 dans le pr\u00e9sent, c\u2019est un lieu culturel et artistique vivant, dynamique, pluridisciplinaire, emmen\u00e9 par une \u00e9quipe qui porte haut les valeurs d\u2019ouverture avec audace et modernit\u00e9 dont l\u2019objectif est de promouvoir la connaissance et la compr\u00e9hension de l\u2019histoire, de la religion et des cultures juives.\r\n \r\nA travers ses trois missions principales que sont la conservation du patrimoine juif de Belgique, les expositions temporaires en \u00e9cho \u00e0 des sujets d\u2019actualit\u00e9 et les activit\u00e9s \u00e9ducatives \u00e0 destination des publics scolaires, l\u2019\u00e9quipe construit progressivement le visage du Nouveau Mus\u00e9e qui verra le jour d\u2019ici 2025.\r\n \r\nEn attendant le d\u00e9but des travaux les visiteurs peuvent d\u00e9couvrir, sur deux b\u00e2timents et cinq \u00e9tages, une s\u00e9lection de la collection permanente, et plusieurs expositions temporaires. En parall\u00e8le, le Mus\u00e9e organise pl\u00e9thore d\u2019activit\u00e9s comme des conf\u00e9rences, concerts, ateliers, soir\u00e9es litt\u00e9raires.","description_print":"","booking_url":"https:\/\/ticket.visit.brussels\/fr\/209899\/Musee-Juif-de-Belgique%20\/shop","sort_order":"Jewish Museum of Belgium","virtual_visit":null},"nl":{"name":"Joods Museum van Belgi\u00eb","address_street_name":"Minimenstraat","address_street_number":"21","address_street_box":null,"email":"info@mjb-jmb.org","website":"http:\/\/www.mjb-jmb.org\/?lang=nl","phone_contact":"+32 2 512 19 63","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Minimenstraat, 21","address_line2":"1000 Brussel","description_web":"Het Joods Museum van Belgi\u00eb, gelegen in de Brusselse Zavelwijk, biedt een vernieuwende kijk op de joodse geschiedenis en cultuur aan de hand van tentoonstellingen en activiteiten die gericht zijn op uitwisseling, kennismaking en toegankelijkheid voor alle mogelijke doelgroepen. \r\n \r\nDoor zijn stevige verankering in het heden is het Museum een levendige, dynamische en multidisciplinaire culturele en artistieke locatie, die wordt gedragen door een team dat de waarden van openheid op doortastende en eigentijdse wijze uitdraagt, met de bedoeling om kennis en inzicht in de joodse geschiedenis, godsdienst en culturen te bevorderen.\r\n \r\nVia zijn drie hoofdopdrachten - het behoud van het Belgische joodse erfgoed, tijdelijke tentoonstellingen die aansluiten bij actuele onderwerpen en educatieve activiteiten voor scholen - bouwt het team geleidelijk aan het gezicht uit van het Nieuwe Museum dat tegen 2025 tot stand zal komen.\r\n \r\nIn afwachting van de werken kunnen de bezoekers verspreid over twee gebouwen en vijf verdiepingen kennismaken met een selectie van de permanente collectie en enkele tijdelijke tentoonstellingen. Tegelijk organiseert het Museum een ruime keuze aan activiteiten, zoals lezingen, concerten, workshops en literaire avonden.","description_print":"","booking_url":"https:\/\/ticket.visit.brussels\/nl\/209899\/Musee-Juif-de-Belgique%20\/shop","sort_order":null,"virtual_visit":null},"en":{"name":"Jewish Museum of Belgium","address_street_name":"Rue des Minimes","address_street_number":"21","address_street_box":null,"email":"info@mjb-jmb.org","website":"http:\/\/www.mjb-jmb.org","phone_contact":"+32 2 512 19 63","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue des Minimes, 21","address_line2":"1000 Brussels","description_web":"Located in the Sablon district of Brussels, the Jewish Museum of Belgium takes a fresh look at Jewish history and culture through exhibitions and activities focusing on sharing, discovery and accessibility for all sectors of the public. \r\n \r\nFirmly anchored in the present day, it is an artistic and cultural place that is lively, dynamic and multidisciplinary, led by a team that values openness, boldness and modernity, and whose goal is to promote a knowledge and understanding of Jewish history, religion and culture.\r\n \r\nThrough its three principal missions, namely the preservation of Jewish heritage in Belgium, temporary exhibitions reflecting topical subjects and educational activities for school groups, the team is gradually constructing the public face of the New Museum that will open its doors by 2025.\r\n \r\nPending the start of work, visitors can discover a selection of the permanent collection as well as several temporary exhibitions in two buildings covering a total area of five floors. At the same time, the Museum organises a wide range of activities such as conferences, concerts, workshops and literary evenings.","description_print":"","booking_url":"https:\/\/ticket.visit.brussels\/en\/209899\/Musee-Juif-de-Belgique%20\/shop","sort_order":null,"virtual_visit":null},"de":{"name":"Mus\u00e9e Juif de Belgique","address_street_name":"Rue des Minimes","address_street_number":"21","address_street_box":null,"email":"info@mjb-jmb.org","website":"http:\/\/www.mjb-jmb.org","phone_contact":"+32 2 512 19 63","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Minimes, 21","address_line2":"1000 Bruxelles","description_web":"Das J\u00fcdische Museum Belgiens im Sablon-Viertel wirft anhand von Ausstellungen und Aktivit\u00e4ten einen Blick auf die j\u00fcdische Geschichte und Kultur. \r\n\r\nAls lebendiger und dynamischer Ort der Kultur und der Kunst m\u00f6chte das Museum Wissen und Verst\u00e4ndnis f\u00fcr die Geschichte des j\u00fcdischen Glaubens und der Kulturen vermitteln. \r\n\r\nDie drei wichtigsten Missionen sind hierbei die Bewahrung des j\u00fcdischen Kulturguts in Belgien, Wechselausstellungen zu aktuellen Themen sowie Konferenzen, Konzerte, Workshops und Literaturabende.\r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Mus\u00e9e Juif de Belgique","address_street_name":"Rue des Minimes","address_street_number":"21","address_street_box":null,"email":"info@mjb-jmb.org","website":"http:\/\/www.mjb-jmb.org","phone_contact":"+32 2 512 19 63","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Minimes, 21","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Mus\u00e9e Juif de Belgique","address_street_name":"Rue des Minimes","address_street_number":"21","address_street_box":null,"email":"info@mjb-jmb.org","website":"http:\/\/www.mjb-jmb.org","phone_contact":"+32 2 512 19 63","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Minimes, 21","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Mus\u00e9e Juif de Belgique","address_street_name":"Rue des Minimes","address_street_number":"21","address_street_box":null,"email":"info@mjb-jmb.org","website":"http:\/\/www.mjb-jmb.org","phone_contact":"+32 2 512 19 63","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Minimes, 21","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Mus\u00e9e Juif de Belgique","address_street_name":"Rue des Minimes","address_street_number":"21","address_street_box":null,"email":"info@mjb-jmb.org","website":"http:\/\/www.mjb-jmb.org","phone_contact":"+32 2 512 19 63","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Minimes, 21","address_line2":"1000 Bruxelles","description_web":"","description_print":"","bookin