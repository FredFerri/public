is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":true,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-12-13T01:00:57+01:00","published_at":"2024-11-25T14:29:46+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":312461,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"theatre","ranking":0.7368062997280773,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":49,"translations":{"de":"Theater","pt":null,"en":"Theatre","it":"Teatro","cn":null,"fr":"Th\u00e9\u00e2tre","sp":"Teatro","nl":"Theater"}},"others":{}},"translations":{"de":{"name":"Trolls","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/theatredelavie.be\/agenda\/saison-2024-2025\/trolls-2\/","email":"reservations@theatredelavie.be","phone_contact":"+32 2 219 11 86","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700003939"},"pt":{"name":"Trolls","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/theatredelavie.be\/agenda\/saison-2024-2025\/trolls-2\/","email":"reservations@theatredelavie.be","phone_contact":"+32 2 219 11 86","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700003939"},"en":{"name":"Trolls","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/theatredelavie.be\/agenda\/saison-2024-2025\/trolls-2\/","email":"reservations@theatredelavie.be","phone_contact":"+32 2 219 11 86","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700003939"},"it":{"name":"Trolls","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/theatredelavie.be\/agenda\/saison-2024-2025\/trolls-2\/","email":"reservations@theatredelavie.be","phone_contact":"+32 2 219 11 86","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700003939"},"cn":{"name":"Trolls","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/theatredelavie.be\/agenda\/saison-2024-2025\/trolls-2\/","email":"reservations@theatredelavie.be","phone_contact":"+32 2 219 11 86","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700003939"},"fr":{"name":"Trolls","shortdescr":"Trois trolls d\u00e9couvrent l\u2019empathie.  \n\n\u00c0 une \u00e9poque o\u00f9 l'intelligence artificielle bouleverse la cr\u00e9ation artistique, Trolls interroge le rapport que nous entretenons avec notre imaginaire, avec nos r\u00e9cits intimes et les personnages qui les habitent. ","longdescr":"Trolls,\u202fselon ChatGPT\u2009:\u202f\n\n\u00ab\u2009Synopsis\u2009: Dans une for\u00eat enchant\u00e9e, trois trolls s\u2019interrogent sur les \u00e9motions humaines qu\u2019ils ne comprennent pas.\u202f\n\nLorsqu\u2019ils rencontrent Lucas Lef\u00e8vre, un humain en proie \u00e0 des pens\u00e9es sombres, les trolls tentent de l\u2019aider tout en faisant face \u00e0 leurs propres d\u00e9fis.\u202f\n\nEntre moments de tension, de r\u00e9flexion profonde et de l\u00e9g\u00e8ret\u00e9, les trolls d\u00e9couvrent la beaut\u00e9 et la douleur de la vie humaine.\n\nTh\u00e8mes\u2009: Complexit\u00e9 des \u00e9motions, amiti\u00e9, r\u00e9silience, compr\u00e9hension interculturelle.\u202f\n\nGenre\u2009: Drame avec des touches d\u2019humour et de r\u00e9flexion philosophique.\n\nCette pi\u00e8ce promet d\u2019\u00eatre \u00e0 la fois touchante et divertissante, offrant une exploration unique\ndes \u00e9motions humaines \u00e0 travers les yeux de cr\u00e9atures fantastiques.\u2009\u00bb\n\n*\n\nTrolls\u202fest la restitution fid\u00e8le d\u2019une conversation avec ChatGPT 3.0 qui a eu lieu le 21 d\u00e9cembre 2022.\u202f\n\nAucun mot n\u2019a \u00e9t\u00e9 modifi\u00e9.  Aucun mot n\u2019a \u00e9t\u00e9 ajout\u00e9.\n\nUne cr\u00e9ation du collectif .jpeg. Une production de RAVIE asbl. Avec le soutien en r\u00e9sidence du Th\u00e9\u00e2tre de la Vie, Escale du Nord, Le Salon, Vaisseau M\u00e8re\n\n*\n\n.jpeg\n\n.jpeg, collectif fond\u00e9 en 2017 par des \u00e9tudiants de l\u2019Institut des Arts de Diffusion, explore l\u2019influence\ndes outils num\u00e9riques et digitaux sur nos intimit\u00e9s et nos relations sociales, \u00e0 travers des r\u00e9cits\nfictionnels tragi-comiques.\u202f\n\nSa premi\u00e8re pi\u00e8ce,\u202fIn solidum, pr\u00e9sent\u00e9e  au Th\u00e9\u00e2tre de Poche, traitait de l\u2019amiti\u00e9 sur fond\nd\u2019arnaques sentimentales en ligne. Elle a obtenu le Label I.M.P.A.C.T. en 2021, permettant au collectif\nde d\u00e9velopper un travail de m\u00e9diation approfondi.\n\nApr\u00e8s\u202fTrolls,\u202fdeuxi\u00e8me cr\u00e9ation de .jpeg, viendra\u202fToutes les beaut\u00e9s du monde, dont la cr\u00e9ation\nest pr\u00e9vue en mars 2026 au Th\u00e9\u00e2tre Jean Vilar. La pi\u00e8ce m\u00ealera l\u2019univers des parcs animaliers\n\u00e0 celui de la r\u00e9alit\u00e9 virtuelle.\u202f","performers":"\u00c9criture : ChatGPT \/ Collaboration \u00e0 l\u2019\u00e9criture et mise en sc\u00e8ne : Siam De Muylder, J\u00e9r\u00e9my Lamblot, L\u00e9on Szafarz, L\u00e9opold Terlinden, Marjory Vesmes \/ Interpr\u00e9tation : Siam De Muylder, J\u00e9r\u00e9my Lamblot, acteur N\u00ba732665415121995B, L\u00e9on Szafarz, L\u00e9opold Terlinden \/ Cr\u00e9ation lumi\u00e8re, sonore et r\u00e9gie : Nicolas Ghion \/ Cr\u00e9ation des masques : Exoskin  ","boxoffice_url":null,"website":"https:\/\/theatredelavie.be\/agenda\/saison-2024-2025\/trolls-2\/","email":"reservations@theatredelavie.be","phone_contact":"+32 2 219 11 86","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/f