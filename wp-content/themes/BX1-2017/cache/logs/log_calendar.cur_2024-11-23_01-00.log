te":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":309310,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"concert","ranking":1.2599210498948732,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":1,"translations":{"de":"Konzert","pt":null,"en":"Concert","it":"Concerti","cn":null,"fr":"Concert","sp":"Concierto","nl":"Concert"}},"others":{}},"translations":{"de":{"name":"Family Workshop - drawn concert","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.arsmusica.be\/evenement\/atelier-famille-2-concert-dessine","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700002291"},"pt":{"name":"Family Workshop - drawn concert","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.arsmusica.be\/evenement\/atelier-famille-2-concert-dessine","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700002291"},"en":{"name":"Family Workshop - drawn concert","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.arsmusica.be\/evenement\/atelier-famille-2-concert-dessine","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700002291"},"it":{"name":"Family Workshop - drawn concert","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.arsmusica.be\/evenement\/atelier-famille-2-concert-dessine","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700002291"},"cn":{"name":"Family Workshop - drawn concert","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.arsmusica.be\/evenement\/atelier-famille-2-concert-dessine","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700002291"},"fr":{"name":"Atelier famille - concert dessin\u00e9","shortdescr":null,"longdescr":"Avant le concert, les Jeunesses Musicales de Bruxelles proposent aux familles de participer \u00e0 un atelier parents-enfants (\u00e0 partir de 6 ans) au choix :\n\nAtelier 1 : Mich\u00e8le Baczynsky propose aux petits et grands un atelier de gravure en relief. Tampons, gouges, papier et encre \u00e0 gogo. Les familles cr\u00e9eront chacun une carte personnalis\u00e9e, \u00e0 envoyer ou \u00e0 r\u00e9aliser pour soi-m\u00eame, \u00e0 partir du bestiaire ou des astres dont nous parlera le conteur Souleymane M'Bodj. Un atelier cr\u00e9atif dans l'esprit de la T\u00e9ranga, un concept Wolof (S\u00e9n\u00e9gal) qui regroupe les valeurs d\u2019accueil de partage et de solidarit\u00e9.\n\nAtelier 2 : Ludovic Jeanmart propose aux familles, le temps d\u2019un atelier, de s\u2019amuser \u00e0 cr\u00e9er un cadavre exquis en dessin ! Au d\u00e9part de petites situations tir\u00e9es au hasard, parents et enfants imagineront quel graphisme elles \u00e9voquent. Ensuite ils interpr\u00e9teront ensemble cette partition avec diff\u00e9rents instruments et objets sonores.","performers":"Coproduction: Centre Culturel d'Uccle \/ Jeunesses Musicales Bruxelles \/ Ars Musica","boxoffice_url":null,"website":"http:\/\/www.arsmusica.be\/evenement\/atelier-famille-2-concert-dessine","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700002291"},"sp":{"name":"Family Workshop - drawn concert","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.arsmusica.be\/evenement\/atelier-famille-2-concert-dessine","email":null,"phone_contact":null,"phone_booking":null,"