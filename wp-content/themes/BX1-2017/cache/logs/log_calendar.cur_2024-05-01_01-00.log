c_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-04-25T15:52:13+02:00","published_at":"2023-08-23T10:11:58+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":true,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":283734,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"tour","ranking":0.2195445853361165,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{}},"translations":{"de":{"name":"A L'aff\u00fbt !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/sewermuseum.brussels\/news\/a-laffut-3\/","email":"musea@brucity.be","phone_contact":"32 (0)2 279 43 83","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50001186"},"pt":{"name":"A L'aff\u00fbt !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/sewermuseum.brussels\/news\/a-laffut-3\/","email":"musea@brucity.be","phone_contact":"32 (0)2 279 43 83","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50001186"},"en":{"name":"A L'aff\u00fbt !","shortdescr":"VISITE HORS LES MURS\n\nLa nature en ville et la biodiversit\u00e9 sont souvent consid\u00e9r\u00e9es comme un bienfait. Force est de constater que certaines esp\u00e8ces n\u2019ont pas la cote : rats, pigeons ou souris. En compagnie de Thomas Jean, photographe de l\u2019exposition, observez la faune sauvage du centre-ville. ","longdescr":"\u00c0 L\u2019AFF\u00dbT !\n\nVISITE HORS LES MURS\n\nLa nature en ville et la biodiversit\u00e9 sont souvent consid\u00e9r\u00e9es comme un bienfait. Force est de constater que certaines esp\u00e8ces n\u2019ont pas la cote : rats, pigeons ou souris. En compagnie de Thomas Jean, photographe de l\u2019exposition, observez la faune sauvage du centre-ville. Ces esp\u00e8ces et leur \u00e9tonnante capacit\u00e9 d\u2019adaptation aux activit\u00e9s humaines, au b\u00e2ti ou aux am\u00e9nagements urbains n\u2019auront plus de secret pour vous.\n\nInfos pratiques :\n\nPour les adolescents et les adultes\nDates: 04.11.23, 12.04.24, 10.05.24\nDe 15h \u00e0 17h30\nPoint de d\u00e9part : Mus\u00e9e des \u00c9gouts, Porte d\u2019Anderlecht, arriv\u00e9e : centre-ville\n\/!\\ Le mus\u00e9e fermant \u00e0 17h, si vous souhaitez le visiter, c\u2019est avant la visite \u00e0 l\u2019aff\u00fbt\nTarif : prix d\u2019entr\u00e9e au mus\u00e9e\nMat\u00e9riel : vos yeux et vos oreilles suffisent \u00e0 l\u2019observation, mais vous pouvez emporter aussi votre appareil photo et\/ou une paire de jumelles.\nLes places \u00e9tant limit\u00e9es, la r\u00e9servation est obligatoire via notre plateforme de r\u00e9servations ","performers":null,"boxoffice_url":null,"website":"https:\/\/sewermuseum.brussels\/news\/a-laffut\/","email":"musea@brucity.be","phone_contact":"32 (0)2 279 43 83","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50001186"},"it":{"name":"A L'aff\u00fbt !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/sewermuseum.brussels\/news\/a-laffut-3\/","email":"musea@brucity.be","phone_contact":"32 (0)2 279 43 83","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50001186"},"cn":{"name":"A L'aff\u00fbt !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/sewermuseum.brussels\/news\/a-laffut-3\/","email":"musea@brucity.be","phone_contact":"32 (0)2 279 43 83","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50001186"},"fr":{"name":"A L'aff\u00fbt !","shortdescr":"VISITE HORS LES MURS\n\nLa nature en ville et la biodiversit\u00e9 sont souvent consid\u00e9r\u00e9es comme un bienfait. Force est de constater que certaines esp\u00e8ces n\u2019ont pas la cote : rats, pigeons ou souris. En compagnie de Thomas Jean, photographe de l\u2019exposition, observez la faune sauvage du centre-ville.","longdescr":"\u00c0 L\u2019AFF\u00dbT !\n\nVISITE HORS LES MURS\n\nLa nature en ville et la biodiversit\u00e9 sont souvent consid\u00e9r\u00e9es comme un bienfait. Force est de constater que certaines esp\u00e8ces n\u2019ont pas la cote : rats, pigeons ou souris. En compagnie de Thomas Jean, photographe de l\u2019exposition, observez la faune sauvage du centre-ville. Ces esp\u00e8ces et leur \u00e9tonnante capacit\u00e9 d\u2019adaptation aux activit\u00e9s humaines, au b\u00e2ti ou aux am\u00e9nagements urbains n\u2019auront plus de secret pour vous.\n\nInfos pratiques :\n\nPour les adolescents et les adultes\nDates: 04.11.23, 12.04.24, 10.05.24\nDe 15h \u00e0 17h30\nPoint de d\u00e9part : Mus\u00e9e des \u00c9gouts, Porte d\u2019Anderlecht, arriv\u00e9e : centre-ville\n\/!\\ Le mus\u00e9e fermant \u00e0 17h, si vous souhaitez le visiter, c\u2019est avant la visite \u00e0 l\u2019aff\u00fbt\nTarif : prix d\u2019entr\u00e9e au mus\u00e9e\nMat\u00e9riel : vos yeux et vos oreilles suffisent \u00e0 l\u2019observation, mais vous pouvez emporter aussi votre appareil photo et\/ou une paire de jumelles.\nLes places \u00e9tant limit\u00e9es, la r\u00e9servation est obligatoire via notre plateforme de r\u00e9servations ","performers":null,"boxoffice_url":null,"website":"https:\/\/sewermuseum.brussels\/news\/a-laffut-3\/","email":"musea@brucity.be","phone_contact":"32 (0)2 279 43 83","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50001186"},"sp":{"name":"A L'aff\u00fbt !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/sewermuseum.brussels\/news\/a-laffut-3\/","email":"musea@brucity.be","phone_contact":"32 (0)2 279 43 83","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50001186"},"nl":{"name":"A L'aff\u00fbt !","shortdescr":"VISITE HORS LES MURS\n\nLa nature en ville et la biodiversit\u00e9 sont souvent consid\u00e9r\u00e9es comme un bienfait. Force est de constater que certaines esp\u00e8ces n\u2019ont pas la cote : rats, pigeons ou souris. En compagnie de Thomas Jean, photographe de l\u2019exposition, observez la faune sauvage du centre-ville.","longdescr":"Ces esp\u00e8ces et leur \u00e9tonnante capacit\u00e9 d\u2019adaptation aux activit\u00e9s humaines, au b\u00e2ti ou aux am\u00e9nagements urbains n\u2019auront plus de secret pour vous.\n\nInfos pratiques :\n\n*Pour les adolescents et les adultes\n*Dates: 04.11.23, 12.04.24, 10.05.24\n*De 15h \u00e0 17h30\n*Point de d\u00e9part : Mus\u00e9e des \u00c9gouts, Porte d\u2019Anderlecht, arriv\u00e9e : centre-ville\n*\/!\\ Le mus\u00e9e fermant \u00e0 17h, si vous souhaitez le visiter, c\u2019est avant la visite \u00e0 l\u2019aff\u00fbt\n*Tarif : prix d\u2019entr\u00e9e au mus\u00e9e\n*Mat\u00e9riel : vos yeux et vos oreilles suffisent \u00e0 l\u2019observation, mais vous pouvez emporter aussi votre appareil photo et\/ou une paire de jumelles.\n*Les places \u00e9tant limit\u00e9es, la r\u00e9servation est obligatoire via la plateforme de r\u00e9servations sur le site web du Mus\u00e9e des \u00c9gouts ","performers":"La Minute Sauvage (photographe et guide)","boxoffice_url":null,"website":"https:\/\/sewermuseum.brussels\/news\/a-laffut-3\/","email":"musea@brucity.be","phone_contact":"32 (0)2 279 43 83","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50001186"}},"place":{"last_updated_at":"2024-04-25T15:51:55+02:00","published_at":"2013-10-19T01:13:58+02:00","id":231869,"translations":{"de":{"name":"Kanalisationsmuseum (Mus\u00e9e des \u00c9gouts)","address_street_name":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museedesegouts.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_line2":"1000 Bruxelles","description_web":"Das Kanalisationsmuseum f\u00fchrt Sie hinab in die Unterwelten der Br\u00fcsseler Kanalisation. Entdecken Sie die Geheimnisse des faszinierenden, 400 Kilometer langen Labyrinths, das sich unter dem Br\u00fcsseler Stadtgebiet auftut. Tausende Kubikmeter Wasser flie\u00dfen t\u00e4glich durch die Br\u00fcsseler Abwasserkanalisation. Was mit ihnen geschieht, welche Wege sie nehmen, erfahren Sie im Kanalisationsmuseum - ein Museum mit vielen interessanten Details f\u00fcr Gro\u00df und Klein: Geschichtliches, Technisches und Am\u00fcsantes.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Mus\u00e9e des \u00c9gouts - Mus\u00e9es de la Ville de Bruxelles","address_street_name":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museedesegouts.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Sewers Museum","address_street_name":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.sewermuseum.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_line2":"1000 Brussels","description_web":"Why not visit the Brussels sewers and the Sewers museum during your next excursion in Brussels. A visit of Brussels' sewerage network - led by experienced guides or ex-workers - is extraordinary, full of surprises, but above all fascinating. The sewers have become vital to our way of life, so much so that it's hard to imagine what it was like before they existed. A visit of the Sewers Museum (and a real sewer!) is therefore an amazing, unusual and thrilling experience.\r\nBrussels' first sewerage network came into use in the 17th century, but they were very limited and a large part of the city's waste still found its way into the river Senne. The river carried waste and carrion and regularly overflowed, or dried out in the summer, leaving behind less-than-pleasant smells.\r\nIt was partially due to this, that the government in the second half of the 19th century decided to completely transform the Senne and its neighbouring streets by building great boulevards to cover the insalubrious area. Between the two world wars a second transformation: a portion of the Senne was diverted and then covered over. The sewerage network improved and grew over the years, going from 45 km in 1847 to the 350 km that we have today.\r\n The entrance to the museum is housed in one of the toll pavilions that used to collect taxes on goods that entered the city.","description_print":null,"booking_url":"https:\/\/www.ticketing.brussels\/en\/tickets\/event-details.Votre-entree-au-Musee-des-Egouts.535f21f8-15a3-4ee5-b242-a8dc5aed84e0","sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Mus\u00e9e des \u00c9gouts - Mus\u00e9es de la Ville de Bruxelles","address_street_name":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museedesegouts.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Mus\u00e9e des \u00c9gouts - Mus\u00e9es de la Ville de Bruxelles","address_street_name":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museedesegouts.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Mus\u00e9e des Egouts","address_street_name":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museedesegouts.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_line2":"1000 Bruxelles","description_web":"Au premier abord, on n\u2019y aurait pas pens\u00e9\u2026 Aller visiter les \u00e9gouts d\u2019une grande ville ? Mais en y r\u00e9fl\u00e9chissant un court instant, on per\u00e7oit vite l\u2019int\u00e9r\u00eat et les apprentissages potentiels ! Cet endroit qu\u2019aujourd\u2019hui on n\u2019imagine pas autrement qu\u2019enfoui\u2026 n\u2019a pas toujours exist\u00e9 sous cette forme, loin s\u2019en faut !\r\nC\u2019est au 17e si\u00e8cle que se met en place \u00e0 Bruxelles le premier r\u00e9seau d\u2019\u00e9gouts ; toutefois celui-ci reste \u00e9l\u00e9mentaire et bon nombre de d\u00e9chets terminent encore leur itin\u00e9raire dans le cours d\u2019eau bruxellois, la Senne. Celle-ci charrie d\u00e9tritus et charognes, et d\u00e9borde r\u00e9guli\u00e8rement en temps de pluie, ou s\u2019ass\u00e8che en \u00e9t\u00e9, laissant s\u2019\u00e9chapper des odeurs peu subtiles\u2026\r\nUn grand plan d\u2019assainissement est ex\u00e9cut\u00e9 dans la seconde moiti\u00e9 du 19e si\u00e8cle. On d\u00e9cide de vo\u00fbter la Senne et d\u2019\u00e9tablir de larges boulevards \u00e0 la place des ruelles insalubres. Durant l\u2019entre-deux-guerres, une deuxi\u00e8me entreprise de d\u00e9tournement et de vo\u00fbtement du cours d\u2019eau viendra renforcer l\u2019efficacit\u00e9 des premiers travaux.\r\nProgressivement, le r\u00e9seau des \u00e9gouts va se perfectionner et s\u2019agrandir : comptant 45 km en 1847, on d\u00e9nombre actuellement 350 km de d\u00e9dales souterrains, qui recueillent conjointement les eaux pluviales et les eaux us\u00e9es provenant de l\u2019activit\u00e9 humaine. \r\n\r\nAper\u00e7u de ce r\u00e9seau, explications sur son histoire et le travail des hommes qui l\u2019entretiennent, cycle de l\u2019eau, etc. : ce sont l\u00e0 quelques-unes des th\u00e9matiques qui vous y attendent ! Notez que l\u2019entr\u00e9e du mus\u00e9e si\u00e8ge dans un des deux \u00ab pavillons d\u2019octroi \u00bb, b\u00e2timents qui mat\u00e9rialisent la perception de la taxe sur tous les biens entrant dans la Ville au 19e si\u00e8cle.","description_print":null,"booking_url":"https:\/\/www.ticketing.brussels\/fr\/tickets\/event-details.Votre-entree-au-Musee-des-Egouts.535f21f8-15a3-4ee5-b242-a8dc5aed84e0","sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Museo del Alcantarillado (Mus\u00e9e des Egouts)","address_street_name":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museedesegouts.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_line2":"1000 Bruxelles","description_web":"En un primer momento, a uno no se le pasar\u00eda por la cabeza... \u00bfIr a visitar las alcantarillas de una gran ciudad? Pero si te paras a pensarlo, \u00a1ver\u00e1s r\u00e1pidamente el potencial de aprendizaje y el inter\u00e9s! Este lugar que, actualmente, solo nos imaginamos bajo tierra no siempre lo ha estado, ni mucho menos. En el siglo XVII se cre\u00f3 el primer sistema de alcantarillado en Bruselas; sin embargo, segu\u00eda siendo b\u00e1sico y muchos residuos terminaban su recorrido en el r\u00edo de la ciudad, el Senne. Este r\u00edo, que llevaba basura y carro\u00f1a, se sol\u00eda desbordar normalmente en \u00e9poca de lluvias, o se secaba en verano, lo que hac\u00eda que desprendiera olores desagradables...\r\nEn la segunda mitad del siglo XIX se puso en marcha un importante plan de saneamiento.\r\nSe decidi\u00f3 recubrir el Senne y crear amplios bulevares en lugar de callejones insalubres. Durante el per\u00edodo de entreguerras, unas segundas obras de recubrimiento y desv\u00edo del agua reforzaron las primeras. Gradualmente, el sistema de alcantarillado se mejor\u00f3 y ampli\u00f3: de 45 km en 1847, actualmente hay 350 km de laberintos subterr\u00e1neos, que recogen conjuntamente el agua de lluvia y las aguas residuales de la ciudad. El museo se inaugur\u00f3 en 1988 como respuesta a una demanda creciente y ofrece visitas realizadas por el propio personal del Servicio de Alcantarillado. Gracias a este museo podr\u00e1s disfrutar de una perspectiva general de esta red, explicaciones sobre su historia y sobre la labor que desempe\u00f1an sus trabajadores, informaci\u00f3n sobre el ciclo hidrol\u00f3gico, etc. Cabe destacar que la entrada al museo se encuentra en uno de los dos Pavillons d\u2019octroi, los edificios donde se recaudaban los impuestos de todas las mercanc\u00edas que entraban en la ciudad en el siglo XIX.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Riolenmuseum","address_street_name":"Octrooipaviljoen, Anderlechtsepoort","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.riolenmuseum.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Octrooipaviljoen, Anderlechtsepoort","address_line2":"1000 Brussel","description_web":"Zet eens een bezoek aan de Brusselse riolen en het Riolenmuseum op het programma van een uitstap in Brussel! Apart, ongewoon en onverwacht, maar vooral interessant en allesbehalve saai is zo\u2019n afdaling in ondergronds Brussel, begeleid door ervaren stadsgidsen of (voormalige) rioolwerkers.\r\nRiolen zijn levensnoodzakelijk geworden voor onze manier van leven, vandaar dat we ons maar moeilijk kunnen voorstellen hoe het eraan toeging toen ze nog niet bestonden. Een bezoek aan het Riolenmuseum (en een echte riool!) is dan ook verrassend, ongewoon en ongemeen boeiend.\r\nIn de 17de eeuw werd in Brussel een eerste riolennet in gebruik genomen. Dat bleef nog erg beperkt en het overgrote deel van het afvalwater vond nog altijd zijn weg naar die ene Brusselse rivier, de Zenne. Die voerde dan ook een smurrie van afval, viezigheid en zelfs dierenkadavers de hele stad door. Als de Zenne bij overvloedige regen overstroomde of in volle zomer opdroogde in de zomer, zorgde dat natuurlijk voor weinig aangename geurtjes...\r\nGedeeltelijk omwille van die overlast besloot de overheid in de tweede helft van de 19de eeuw om een overwelving aan te brengen boven de Zenne en grote boulevards aan te leggen in plaats van de vieze en slordige steegjes. Later werd tussen de twee Wereldoorlogen nog een tweede keer ingegrepen: een deel van de Zenne werd verlegd en er werden nog meer overwelvingen aangebracht. \r\nLangzamerhand verbeterde en vergrootte het riolennet, van 45 km in 1847 naar de huidige 350 km riool, die zowel afval- als regenwater afvoert. \r\nNaast een bezoek aan de riolen zelf levert dit museum een schat aan boeiende en interessante informatie op over alle aspecten van riolen, rioolwater en de mensen die ze \u2013 vaak in gevaarlijke en altijd in onaangename omstandigheden - onderhouden. Leuk: de ingang van het museum is gehuisvest in een van de twee octrooipaviljoenen aan de Anderlechtse Poort, waar vroeger tol werd geheven op goederen die in de stad werden binnengebracht.\r\n","description_print":null,"booking_url":"https:\/\/www.ticketing.brussels\/nl\/tickets\/event-details.Votre-entree-au-Musee-des-Egouts.535f21f8-15a3-4ee5-b242-a8dc5aed84e0","sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[21],"translations":{"de":["S\u00fcden"],"pt":[null],"en":["South"],"it":["Sud"],"cn":[null],"fr":["Sud"],"sp":["Sur"],"nl":["Zuid"]}},"neca":null,"facebook_id":null,"backoffice_id":989,"location":{"lat":50.82833819,"lon":4.31090786},"region":"brussels","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"last_updated_at":"2024-04-25T15:51:55+02:00","published_at":"2013-10-19T01:13:58+02:00","id":231869,"translations":{"de":{"name":"Kanalisationsmuseum (Mus\u00e9e des \u00c9gouts)","address_street_name":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museedesegouts.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_line2":"1000 Bruxelles","description_web":"Das Kanalisationsmuseum f\u00fchrt Sie hinab in die Unterwelten der Br\u00fcsseler Kanalisation. Entdecken Sie die Geheimnisse des faszinierenden, 400 Kilometer langen Labyrinths, das sich unter dem Br\u00fcsseler Stadtgebiet auftut. Tausende Kubikmeter Wasser flie\u00dfen t\u00e4glich durch die Br\u00fcsseler Abwasserkanalisation. Was mit ihnen geschieht, welche Wege sie nehmen, erfahren Sie im Kanalisationsmuseum - ein Museum mit vielen interessanten Details f\u00fcr Gro\u00df und Klein: Geschichtliches, Technisches und Am\u00fcsantes.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Mus\u00e9e des \u00c9gouts - Mus\u00e9es de la Ville de Bruxelles","address_street_name":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museedesegouts.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Sewers Museum","address_street_name":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.sewermuseum.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_line2":"1000 Brussels","description_web":"Why not visit the Brussels sewers and the Sewers museum during your next excursion in Brussels. A visit of Brussels' sewerage network - led by experienced guides or ex-workers - is extraordinary, full of surprises, but above all fascinating. The sewers have become vital to our way of life, so much so that it's hard to imagine what it was like before they existed. A visit of the Sewers Museum (and a real sewer!) is therefore an amazing, unusual and thrilling experience.\r\nBrussels' first sewerage network came into use in the 17th century, but they were very limited and a large part of the city's waste still found its way into the river Senne. The river carried waste and carrion and regularly overflowed, or dried out in the summer, leaving behind less-than-pleasant smells.\r\nIt was partially due to this, that the government in the second half of the 19th century decided to completely transform the Senne and its neighbouring streets by building great boulevards to cover the insalubrious area. Between the two world wars a second transformation: a portion of the Senne was diverted and then covered over. The sewerage network improved and grew over the years, going from 45 km in 1847 to the 350 km that we have today.\r\n The entrance to the museum is housed in one of the toll pavilions that used to collect taxes on goods that entered the city.","description_print":null,"booking_url":"https:\/\/www.ticketing.brussels\/en\/tickets\/event-details.Votre-entree-au-Musee-des-Egouts.535f21f8-15a3-4ee5-b242-a8dc5aed84e0","sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Mus\u00e9e des \u00c9gouts - Mus\u00e9es de la Ville de Bruxelles","address_street_name":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museedesegouts.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Mus\u00e9e des \u00c9gouts - Mus\u00e9es de la Ville de Bruxelles","address_street_name":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museedesegouts.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Mus\u00e9e des Egouts","address_street_name":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museedesegouts.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_line2":"1000 Bruxelles","description_web":"Au premier abord, on n\u2019y aurait pas pens\u00e9\u2026 Aller visiter les \u00e9gouts d\u2019une grande ville ? Mais en y r\u00e9fl\u00e9chissant un court instant, on per\u00e7oit vite l\u2019int\u00e9r\u00eat et les apprentissages potentiels ! Cet endroit qu\u2019aujourd\u2019hui on n\u2019imagine pas autrement qu\u2019enfoui\u2026 n\u2019a pas toujours exist\u00e9 sous cette forme, loin s\u2019en faut !\r\nC\u2019est au 17e si\u00e8cle que se met en place \u00e0 Bruxelles le premier r\u00e9seau d\u2019\u00e9gouts ; toutefois celui-ci reste \u00e9l\u00e9mentaire et bon nombre de d\u00e9chets terminent encore leur itin\u00e9raire dans le cours d\u2019eau bruxellois, la Senne. Celle-ci charrie d\u00e9tritus et charognes, et d\u00e9borde r\u00e9guli\u00e8rement en temps de pluie, ou s\u2019ass\u00e8che en \u00e9t\u00e9, laissant s\u2019\u00e9chapper des odeurs peu subtiles\u2026\r\nUn grand plan d\u2019assainissement est ex\u00e9cut\u00e9 dans la seconde moiti\u00e9 du 19e si\u00e8cle. On d\u00e9cide de vo\u00fbter la Senne et d\u2019\u00e9tablir de larges boulevards \u00e0 la place des ruelles insalubres. Durant l\u2019entre-deux-guerres, une deuxi\u00e8me entreprise de d\u00e9tournement et de vo\u00fbtement du cours d\u2019eau viendra renforcer l\u2019efficacit\u00e9 des premiers travaux.\r\nProgressivement, le r\u00e9seau des \u00e9gouts va se perfectionner et s\u2019agrandir : comptant 45 km en 1847, on d\u00e9nombre actuellement 350 km de d\u00e9dales souterrains, qui recueillent conjointement les eaux pluviales et les eaux us\u00e9es provenant de l\u2019activit\u00e9 humaine. \r\n\r\nAper\u00e7u de ce r\u00e9seau, explications sur son histoire et le travail des hommes qui l\u2019entretiennent, cycle de l\u2019eau, etc. : ce sont l\u00e0 quelques-unes des th\u00e9matiques qui vous y attendent ! Notez que l\u2019entr\u00e9e du mus\u00e9e si\u00e8ge dans un des deux \u00ab pavillons d\u2019octroi \u00bb, b\u00e2timents qui mat\u00e9rialisent la perception de la taxe sur tous les biens entrant dans la Ville au 19e si\u00e8cle.","description_print":null,"booking_url":"https:\/\/www.ticketing.brussels\/fr\/tickets\/event-details.Votre-entree-au-Musee-des-Egouts.535f21f8-15a3-4ee5-b242-a8dc5aed84e0","sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Museo del Alcantarillado (Mus\u00e9e des Egouts)","address_street_name":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museedesegouts.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_line2":"1000 Bruxelles","description_web":"En un primer momento, a uno no se le pasar\u00eda por la cabeza... \u00bfIr a visitar las alcantarillas de una gran ciudad? Pero si te paras a pensarlo, \u00a1ver\u00e1s r\u00e1pidamente el potencial de aprendizaje y el inter\u00e9s! Este lugar que, actualmente, solo nos imaginamos bajo tierra no siempre lo ha estado, ni mucho menos. En el siglo XVII se cre\u00f3 el primer sistema de alcantarillado en Bruselas; sin embargo, segu\u00eda siendo b\u00e1sico y muchos residuos terminaban su recorrido en el r\u00edo de la ciudad, el Senne. Este r\u00edo, que llevaba basura y carro\u00f1a, se sol\u00eda desbordar normalmente en \u00e9poca de lluvias, o se secaba en verano, lo que hac\u00eda que desprendiera olores desagradables...\r\nEn la segunda mitad del siglo XIX se puso en marcha un importante plan de saneamiento.\r\nSe decidi\u00f3 recubrir el Senne y crear amplios bulevares en lugar de callejones insalubres. Durante el per\u00edodo de entreguerras, unas segundas obras de recubrimiento y desv\u00edo del agua reforzaron las primeras. Gradualmente, el sistema de alcantarillado se mejor\u00f3 y ampli\u00f3: de 45 km en 1847, actualmente hay 350 km de laberintos subterr\u00e1neos, que recogen conjuntamente el agua de lluvia y las aguas residuales de la ciudad. El museo se inaugur\u00f3 en 1988 como respuesta a una demanda creciente y ofrece visitas realizadas por el propio personal del Servicio de Alcantarillado. Gracias a este museo podr\u00e1s disfrutar de una perspectiva general de esta red, explicaciones sobre su historia y sobre la labor que desempe\u00f1an sus trabajadores, informaci\u00f3n sobre el ciclo hidrol\u00f3gico, etc. Cabe destacar que la entrada al museo se encuentra en uno de los dos Pavillons d\u2019octroi, los edificios donde se recaudaban los impuestos de todas las mercanc\u00edas que entraban en la ciudad en el siglo XIX.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Riolenmuseum","address_street_name":"Octrooipaviljoen, Anderlechtsepoort","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.riolenmuseum.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Octrooipaviljoen, Anderlechtsepoort","address_line2":"1000 Brussel","description_web":"Zet eens een bezoek aan de Brusselse riolen en het Riolenmuseum op het programma van een uitstap in Brussel! Apart, ongewoon en onverwacht, maar vooral interessant en allesbehalve saai is zo\u2019n afdaling in ondergronds Brussel, begeleid door ervaren stadsgidsen of (voormalige) rioolwerkers.\r\nRiolen zijn levensnoodzakelijk geworden voor onze manier van leven, vandaar dat we ons maar moeilijk kunnen voorstellen hoe het eraan toeging toen ze nog niet bestonden. Een bezoek aan het Riolenmuseum (en een echte riool!) is dan ook verrassend, ongewoon en ongemeen boeiend.\r\nIn de 17de eeuw werd in Brussel een eerste riolennet in gebruik genomen. Dat bleef nog erg beperkt en het overgrote deel van het afvalwater vond nog altijd zijn weg naar die ene Brusselse rivier, de Zenne. Die voerde dan ook een smurrie van afval, viezigheid en zelfs dierenkadavers de hele stad door. Als de Zenne bij overvloedige regen overstroomde of in volle zomer opdroogde in de zomer, zorgde dat natuurlijk voor weinig aangename geurtjes...\r\nGedeeltelijk omwille van die overlast besloot de overheid in de tweede helft van de 19de eeuw om een overwelving aan te brengen boven de Zenne en grote boulevards aan te leggen in plaats van de vieze en slordige steegjes. Later werd tussen de twee Wereldoorlogen nog een tweede keer ingegrepen: een deel van de Zenne werd verlegd en er werden nog meer overwelvingen aangebracht. \r\nLangzamerhand verbeterde en vergrootte het riolennet, van 45 km in 1847 naar de huidige 350 km riool, die zowel afval- als regenwater afvoert. \r\nNaast een bezoek aan de riolen zelf levert dit museum een schat aan boeiende en interessante informatie op over alle aspecten van riolen, rioolwater en de mensen die ze \u2013 vaak in gevaarlijke en altijd in onaangename omstandigheden - onderhouden. Leuk: de ingang van het museum is gehuisvest in een van de twee octrooipaviljoenen aan de Anderlechtse Poort, waar vroeger tol werd geheven op goederen die in de stad werden binnengebracht.\r\n","description_print":null,"booking_url":"https:\/\/www.ticketing.brussels\/nl\/tickets\/event-details.Votre-entree-au-Musee-des-Egouts.535f21f8-15a3-4ee5-b242-a8dc5aed84e0","sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":989,"location":{"lat":50.82833819,"lon":4.31090786},"is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/5d5c14043aca6166a09caf82f7af42e5e4f74f3c.jpg","width":3840,"height":3840,"ratio":1,"oEmbed_height":3840,"oEmbed_width":3840,"translations":{"de":{"title":"Thomas Jean","copyright":"\u00a9 Frederic De Norman"},"pt":{"title":"Thomas Jean","copyright":"\u00a9 Frederic De Norman"},"en":{"title":"Thomas Jean","copyright":"\u00a9 Frederic De Norman"},"it":{"title":"Thomas Jean","copyright":"\u00a9 Frederic De Norman"},"cn":{"title":"Thomas Jean","copyright":"\u00a9 Frederic De Norman"},"fr":{"title":"Thomas Jean","copyright":"\u00a9 Frederic De Norman"},"sp":{"title":"Thomas Jean","copyright":"\u00a9 Frederic De Norman"},"nl":{"title":"Thomas Jean","copyright":"\u00a9 Frederic De Norman"}}}],"dates":[{"day":"2023-11-04","doors":"15:00:00","start":"15:00:00","end":"17:30:00","end_night_life":null,"is_soldout":true,"is_canceled":false},{"day":"2024-04-12","doors":"15:00:00","start":"15:00:00","end":"17:30:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2024-05-10","doors":"15:00:00","start":"15:00:00","end":"17:30:00","end_night_life":null,"is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"de":{"name":"Normal"},"en":{"name":"Normal"},"it":{"name":"Normale"},"fr":{"name":"Normal"},"sp":{"name":"Normal"},"nl":{"name":"Normaal"}},"value":10},{"translations":{"de":{"name":"Studierende"},"en":{"name":"Students"},"it":{"name":"Studenti"},"fr":{"name":"Etudiants"},"sp":{"name":"Estudiantes"},"nl":{"name":"Studenten"}}