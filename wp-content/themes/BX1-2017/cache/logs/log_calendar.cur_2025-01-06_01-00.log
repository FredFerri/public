uites offrent une d\u00e9tente confortable, tandis que Sentro, notre restaurant sur place, propose une cuisine cr\u00e9ative aux saveurs belges. Profitez de notre centre de fitness, de notre Executive Lounge et d'une exposition d'art gratuite pr\u00e9sentant l'artiste belge Fran\u00e7ois Coorens en 2024. Explorez la culture, le shopping et les sites historiques de Bruxelles \u00e0 quelques pas seulement. Parfait pour les voyages d\u2019affaires ou de loisirs, nos espaces de r\u00e9union flexibles s'adaptent \u00e0 tous les \u00e9v\u00e9nements. Au Hilton Brussels Grand Place, un s\u00e9jour m\u00e9morable et confortable vous attend.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":"https:\/\/visitpandox.com\/hilton-brussels-grand-place\/","visit_url":null},"sp":{"name":"Hilton Brussels Grand Place","address_street_name":"Carrefour de l'Europe ","address_street_number":"3","address_street_box":null,"email":"brusselsgrandplace_events@hilton.com","website":"http:\/\/www.brusselsgrandplace.hilton.com","phone_contact":"+32 2 548 42 11","phone_booking":"+32 2 548 42 11","address_zip":"1000","address_city":"Bruxelles","address_line1":"Carrefour de l'Europe , 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Hilton Brussels Grand Place","address_street_name":"Carrefour de l'Europe ","address_street_number":"3","address_street_box":null,"email":"brusselsgrandplace_events@hilton.com","website":"http:\/\/www.brusselsgrandplace.hilton.com","phone_contact":"+32 2 548 42 11","phone_booking":"+32 2 548 42 11","address_zip":"1000","address_city":"Brussel","address_line1":"Carrefour de l'Europe , 3","address_line2":"1000 Brussel","description_web":"Ervaar moderne luxe bij Hilton Brussels Grand Place, ideaal gelegen tussen de Grote Markt en het Square Meeting and Convention Center. Onze 236 kamers en suites bieden comfortabele ontspanning, terwijl Sentro, ons restaurant ter plaatse, creatieve gerechten met Belgische invloeden serveert. Geniet van ons fitnesscentrum, Executive Lounge en een gratis kunsttentoonstelling met de Belgische kunstenaar Fran\u00e7ois Coorens in 2024. Ontdek de cultuur, het winkelen en de historische bezienswaardigheden van Brussel op slechts enkele stappen afstand. Perfect voor zaken of vrije tijd, onze flexibele vergaderruimtes zijn geschikt voor alle evenementen. Bij Hilton Brussels Grand Place wacht u een gedenkwaardig en comfortabel verblijf.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[],"translations":{}},"zones":[],"neca":null,"facebook_id":null,"backoffice_id":40886,"location":{"lat":50.8459706,"lon":4.3560263},"region":"brussels","last_updated_at":"2024-05-28T08:34:23+02:00","published_at":"2023-07-31T09:15:09+02:00","import_origin":"crm","external_id":null,"is_in_address_book":false,"is_in_vb_export":false,"resto_ranking":0},"organizer":{"id":50000143,"translations":{"de":{"name":"Hilton Brussels Grand Place","address_street_name":"Carrefour de l'Europe ","address_street_number":"3","address_street_box":null,"email":"brusselsgrandplace_events@hilton.com","website":"http:\/\/www.brusselsgrandplace.hilton.com","phone_contact":"+32 2 548 42 11","phone_booking":"+32 2 548 42 11","address_zip":"1000","address_city":"Bruxelles","address_line1":"Carrefour de l'Europe , 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Hilton Brussels Grand Place","address_street_name":"Carrefour de l'Europe ","address_street_number":"3","address_street_box":null,"email":"brusselsgrandplace_events@hilton.com","website":"http:\/\/www.brusselsgrandplace.hilton.com","phone_contact":"+32 2 548 42 11","phone_booking":"+32 2 548 42 11","address_zip":"1000","address_city":"Bruxelles","addres