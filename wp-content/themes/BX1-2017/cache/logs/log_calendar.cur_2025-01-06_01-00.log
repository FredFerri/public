n\/visitors\/agenda\/event-detail.5700002199"},"it":{"name":"La poup\u00e9e de Monsieur K - Cie L\u00e9Za\u00e2r","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/whalll.be\/evenement\/la-poupee-de-monsieur-k\/","email":"billetterie@whalll.be","phone_contact":"+32 2 435 59 99","phone_booking":"+32 2 435 59 99","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700002199"},"cn":{"name":"La poup\u00e9e de Monsieur K - Cie L\u00e9Za\u00e2r","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/whalll.be\/evenement\/la-poupee-de-monsieur-k\/","email":"billetterie@whalll.be","phone_contact":"+32 2 435 59 99","phone_booking":"+32 2 435 59 99","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700002199"},"fr":{"name":"La poup\u00e9e de Monsieur K - Cie L\u00e9Za\u00e2r","shortdescr":null,"longdescr":"Dur\u00e9e : 50 \u2018\nD\u00e8s 6 ans\n\nNovembre 1923. Franz Kafka, malade de la tuberculose, s\u2019octroie chaque jour une promenade au parc. Un jour, il tombe sur une petite fille en larmes : sa poup\u00e9e a disparu. Kafka se penche :\n\u2014 Ta poup\u00e9e, elle n\u2019est pas perdue, elle est partie en voyage.\n\u2014 En voyage ? Mais comment tu le sais ?\n\u2014 Je le sais parce que\u2026 elle me l\u2019a \u00e9crit.\n\u2014 Tu racontes n\u2019importe quoi !\n\u2014 Demain, je vais t\u2019apporter la lettre qu\u2019elle m\u2019a envoy\u00e9e.\n\nEt durant des semaines, chaque jour, Kafka \u00e9crit avec un soin extr\u00eame une lettre de plus \u00e0 l\u2019enfant. La fiction vole au secours du chagrin. Les lettres ont \u00e9t\u00e9 perdues. 100 ans plus tard, Thomas Gunzig s\u2019est amus\u00e9 \u00e0 les r\u00e9\u00e9crire.\n\nLa Cie L\u00e9Za\u00e2r met en images ce r\u00e9cit \u00e9pistolaire sur sc\u00e8ne. Un r\u00e9cit aventureux, humoristique, fantaisiste, \u00e9mancipatoire.","performers":null,"boxoffice_url":null,"website":"https:\/\/whalll.be\/evenement\/la-poupee-de-monsieur-k\/","email":"billetterie@whalll.be","phone_contact":"+32 2 435 59 99","phone_booking":"+32 2 435 59 99","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700002199"},"sp":{"name":"La poup\u00e9e de Monsieur K - Cie L\u00e9Za\u00e2r","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/whalll.be\/evenement\/la-poupee-de-monsieur-k\/","email":"billetterie@whalll.be","phone_contact":"+32 2 435 59 99","phone_booking":"+32 2 435 59 99","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700002199"},"nl":{"name":"La poup\u00e9e de Monsieur K - Cie L\u00e9Za\u00e2r","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/whalll.be\/evenement\/la-poupee-de-monsieur-k\/","email":"billetterie@whalll.be","phone_contact":"+32 2 435 59 99","phone_booking":"+32 2 435 59 99","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700002199"}},"place":{"id":241270,"translations":{"de":{"name":"W:Halll - Centre culturel de Woluwe-Saint-Pierre","address_street_name":"Avenue Charles Thielemans","address_street_number":"93","address_street_box":null,"email":"billetterie@whalll.be","website":"http:\/\/www.whalll.be","phone_contact":"+32 2 435 59 95","phone_booking":"+32 2 435 59 99","address_zip":"1150","address_city":"Woluwe-Saint-Pierre","address_line1":"Avenue Charles Thielemans, 93","address_line2":"1150 Woluwe-Saint-Pierre","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"W:Halll - Centre culturel de Woluwe-Saint-Pierre","address_street_name":"Avenue Charles Thielemans","address_street_number":"93","address_street_box":null,"email":"billetterie@whalll.be","website":"http:\/\/www.whalll.be","phone_contact":"+32 2 435 59 95","phone_booking":"+32 2 435 59 99","address_zip":"1150","address_city"