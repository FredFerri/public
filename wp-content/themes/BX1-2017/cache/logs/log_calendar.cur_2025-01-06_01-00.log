reatex.be\/Exhibitions\/Register?ID=1B71D1DE-7A22-EF11-A2EB-BF373B2FEF7B&date=638589672850000000","email":"reservation@fine-arts-museum.be","phone_contact":"+ 32(0)2 508 33 33","phone_booking":"+ 32(0)2 508 33 33","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50013056"},"it":{"name":"Visite-d\u00e9couverte - Le Mus\u00e9e Magritte","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/fineartsmuseum.recreatex.be\/Exhibitions\/Register?ID=1B71D1DE-7A22-EF11-A2EB-BF373B2FEF7B&date=638589672850000000","email":"reservation@fine-arts-museum.be","phone_contact":"+ 32(0)2 508 33 33","phone_booking":"+ 32(0)2 508 33 33","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50013056"},"cn":{"name":"Visite-d\u00e9couverte - Le Mus\u00e9e Magritte","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/fineartsmuseum.recreatex.be\/Exhibitions\/Register?ID=1B71D1DE-7A22-EF11-A2EB-BF373B2FEF7B&date=638589672850000000","email":"reservation@fine-arts-museum.be","phone_contact":"+ 32(0)2 508 33 33","phone_booking":"+ 32(0)2 508 33 33","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50013056"},"fr":{"name":"Visite-d\u00e9couverte - Le Mus\u00e9e Magritte","shortdescr":null,"longdescr":"Peintures, dessins, affiches, photos, films\u2026 l\u2019univers insolite du peintre-po\u00e8te est d\u00e9velopp\u00e9 au fil de sa biographie. Ses premi\u00e8res \u0153uvres sont marqu\u00e9es par  l\u2019abstraction ou le cubisme. Les climats inqui\u00e9tants de la p\u00e9riode sombre contrastent avec la po\u00e9sie plus sereine et apais\u00e9e de ses derni\u00e8res peintures.\n\nApprocher le myst\u00e8re, d\u00e9busquer les pi\u00e8ges des images ou rendre la pens\u00e9e visible, l\u2019\u0153uvre de Magritte renouvelle notre regard sur le quotidien. ","performers":"En compagnie d\u2019un historien ou d\u2019une historienne de l\u2019art, d\u00e9couvrez une collection exceptionnelle qui r\u00e9unit plus de 120 \u0153uvres de l\u2019artiste belge Ren\u00e9 Magritte (1898-1967), l\u2019un des surr\u00e9alistes les plus c\u00e9l\u00e8bres dans le monde.","boxoffice_url":null,"website":"https:\/\/fineartsmuseum.recreatex.be\/Exhibitions\/Register?ID=1B71D1DE-7A22-EF11-A2EB-BF373B2FEF7B&date=638589672850000000","email":"reservation@fine-arts-museum.be","phone_contact":"+ 32(0)2 508 33 33","phone_booking":"+ 32(0)2 508 33 33","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50013056"},"sp":{"name":"Visite-d\u00e9couverte - Le Mus\u00e9e Magritte","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/fineartsmuseum.recreatex.be\/Exhibitions\/Register?ID=1B71D1DE-7A22-EF11-A2EB-BF373B2FEF7B&date=638589672850000000","email":"reservation@fine-arts-museum.be","phone_contact":"+ 32(0)2 508 33 33","phone_booking":"+ 32(0)2 508 33 33","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50013056"},"nl":{"name":"Visite-d\u00e9couverte - Le Mus\u00e9e Magritte","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/fineartsmuseum.recreatex.be\/Exhibitions\/Register?ID=1B71D1DE-7A22-EF11-A2EB-BF373B2FEF7B&date=638589672850000000","email":"reservation@fine-arts-museum.be","phone_contact":"+ 32(0)2 508 33 33","phone_booking":"+ 32(0)2 508 33 33","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50013056"}},"place":{"id":488,"translations":{"de":{"name":"Mus\u00e9es Royaux des Beaux-Arts de Belgique","address_street_name":"Rue de la R\u00e9gence","address_street_number":"3","address_street_box":null,"email":"info@fine-arts-museum.be","website":"http:\/\/www.fine-arts-museum.be","phone_contact":"+32 2 508 32 11","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la R\u00e9gence, 3","address_line2":"1000 Bruxelles","description_web":"Die Mus\u00e9es Royaux des Beaux-Arts de Belgique \u2013 6 Museen, 7 Jahrhunderte der sch\u00f6nen K\u00fcnste, 20 000 Kunstwerke und Kunstgenuss vom Feinsten:\r\n\r\n\u2022\tIm Mus\u00e9e Magritte gibt es die weltweit gr\u00f6\u00dfte Sammlung von Werken des gro\u00dfen belgischen Surrealisten Ren\u00e9 Magritte zu entdecken\r\n\r\n\u2022\tIm Mus\u00e9e Fin-de-Si\u00e8cle erwartet den Besucher mit K\u00fcnstlern wie Khnopff, Spilliaert, Horta, Rodin, Gauguin, Mucha und Bonnard das besondere Fin-de-Si\u00e8cle-Ambiente, das um 1900 in Br\u00fcssel herrschte. Mehr als 30 K\u00fcnstler \u2013 vom Impressionismus \u00fcber den Jugendstil, von den sch\u00f6nen K\u00fcnsten bis zur Oper.\r\n\r\n\u2022\tIm Mus\u00e9e Old Master gibt es Meisterwerke aus der Epoche des 15. Jahrhunderts bis hin zum 18. Jahrhundert zu sehen, unter anderem mit der weltweit gr\u00f6\u00dften Bruegel-Sammlung, verschiedenen Werken von Rubens, van der Weyden und Jordaens. \r\n\r\n\u2022\tDas Mus\u00e9e Modern Art zeigt eine Auswahl von Meisterwerken des 20. Jahrhunderts, darunter Broodthaers, Fabre, David, Panamarenko, Alechinsky.\r\n\r\n\u2022\tDie beiden Kunstatelier-Museen Mus\u00e9e Wiertz und Meunier in Ixelles geben einen faszinierenden Einblick in die Welt dieser beiden K\u00fcnstler.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Mus\u00e9es Royaux des Beaux-Arts de Belgique","address_street_name":"Rue de la R\u00e9gence","address_street_number":"3","address_street_box":null,"email":"info@fine-arts-museum.be","website":"http:\/\/www.fine-arts-museum.be","phone_contact":"+32 2 508 32 11","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la R\u00e9gence, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Royal Museums of Fine Arts of Belgium","address_st