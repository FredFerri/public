inbrussels.be","phone_contact":"+32 2 850 60 90","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Tanneurs, 62","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":null,"facebook_id":null,"backoffice_id":31542,"location":{"lat":50.83967913,"lon":4.34655223},"region":"brussels","last_updated_at":"2023-03-05T03:35:06+01:00","published_at":"2018-06-18T12:18:42+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"media":[{"type":"poster","link":"https:\/\/agendabrussels.imgix.net\/112d395894b7f40c8df3debf429a626441667fde.jpg","width":1240,"height":1748,"ratio":0.71,"translations":{"fr":{"title":"D\u00e9couverte de la brasserie de La Senne","copyright":null},"nl":{"title":"D\u00e9couverte de la brasserie de La Senne","copyright":null},"en":{"title":"D\u00e9couverte de la brasserie de La Senne","copyright":null},"de":{"title":"D\u00e9couverte de la brasserie de La Senne","copyright":null},"it":{"title":"D\u00e9couverte de la brasserie de La Senne","copyright":null},"sp":{"title":"D\u00e9couverte de la brasserie de La Senne","copyright":null},"pt":{"title":"D\u00e9couverte de la brasserie de La Senne","copyright":null},"cn":{"title":"D\u00e9couverte de la brasserie de La Senne","copyright":null}}}],"dates":[{"day":"2023-01-28","doors":null,"start":"16:00:00","end":"17:30:00"},{"day":"2023-02-04","doors":null,"start":"16:00:00","end":"17:30:00"},{"day":"2023-02-11","doors":null,"start":"16:00:00","end":"17:30:00"},{"day":"2023-02-18","doors":null,"start":"16:00:00","end":"17:30:00"},{"day":"2023-02-25","doors":null,"start":"16:00:00","end":"17:30:00"},{"day":"2023-03-04","doors":null,"start":"16:00:00","end":"17:30:00"},{"day":"2023-03-11","doors":null,"start":"16:00:00","end":"17:30:00"},{"day":"2023-03-18","doors":null,"start":"16:00:00","end":"17:30:00"},{"day":"2023-03-25","doors":null,"start":"16:00:00","end":"17:30:00"}],"recurring":[{"day":"saturday","occurences":{"is_first":true,"is_second":true,"is_third":true,"is_fourth":true,"is_last":false},"time_start":"16:00:00","time_end":"17:30:00","translations":{"fr":"Ouvert les premier, deuxi\u00e8me, troisi\u00e8me et quatri\u00e8me samedis du mois de 16:00 \u00e0 17:30","nl":"Open op de eerste, tweede, derde en vierde zaterdags van de maand van 16:00 tot 17:30","en":"Open the first, second, third and fourth saturdays of the month from 16:00 to 17:30","de":"Open the first, second, third and fourth saturdays of the month from 16:00 to 17:30","it":"Open the first, second, third and fourth saturdays of the month from 16:00 to 17:30","sp":"Open the first, second, third and fourth saturdays of the month from 16:00 to 17:30","pt":"Open the first, second, third and fourth saturdays of the month from 16:00 to 17:30","cn":"Open the first, second, third and fourth saturdays of the month from 16:00 to 17:30"}}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"},"de":{"name":"Normal"},"it":{"name":"Normale"},"sp":{"name":"Normal"},"pt":{"name":"Normal"},"cn":{"name":"Normal"}},"value":20}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"visit_profile":{"list":[323],"translations":{"fr":["Gastronomie"],"nl":["Gastronomie"],"en":["Gastronomy"],"de":["Gastronomie"],"it":["Cucina"],"sp":["Gastronom\u00eda"],"pt":[null],"cn":[null]}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-03-05T03:35:07+01:00","published_at":"2023-01-13T09:12:00+01:00","backoffice_id":269428,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.25984142030594},{"id":545788,"date_start":"2023-03-11","date_end":"2023-07-11","date_next":"2023-03-11","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen","it":"Visite guidate","sp":"Visitas guiadas","pt":null,"cn":null}},"others":{"list":[104],"translations":{"fr":["Art Nouveau, Art D\u00e9co"],"nl":["Art nouveau, art deco"],"en":["Art Nouveau, Art D\u00e9co"],"de":["Jugendstil, Art d\u00e9co"],"it":["Art Nouveau, Art D\u00e9co"],"sp":["Art nouveau, art d\u00e9co"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["nl","fr"],"subtitles":[]},"translations":{"fr":{"name":"*EXTRAMUROS* Paul Cauchie \u00e0 Malines","shortdescr":"La Maison Cauchie part en balade ! D\u00e9couvrez le travail de l'atelier de sgraffites de Paul Cauchie dans la ville de Malines.","longdescr":"\u00c0 Malines, une vingtaine de maisons ont \u00e9t\u00e9 d\u00e9cor\u00e9es de sgraffites entre 1900 et la Premi\u00e8re Guerre mondiale. D'importants architectes comme P.J. Rooms, Cyrille Van den Bergh et l'architecte municipal Theo Vandenbergh les ont int\u00e9gr\u00e9s dans la conception de leurs fa\u00e7ades. Au cours de la promenade, vous en apprendrez davantage sur cette g\u00e9n\u00e9ration de ma\u00eetres b\u00e2tisseurs.\r\nD\u00e9part de la visite : \u00e0 l\u2019angle de Liersesteenweg et Frans Halsvest.\r\nHoraire : \r\n10h : visite en n\u00e9erlandais\r\n14h : visite en fran\u00e7ais","performers":null,"boxoffice_url":"https:\/\/shop.utick.be\/?pos=MAISONCAUCHIE&module=CATALOGUE&lg=FR","website":"http:\/\/www.cauchie.be","email":"sgraffito@cauchie.be","phone_contact":"+32 474 49 09 72","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.545788"},"nl":{"name":"*EXTRAMUROS* Paul Cauchie in Mechelen","shortdescr":"Het Cauchiehuis gaat extra muros ! Ontdek de gevelversieringen van Paul Cauchie in Mechelen.","longdescr":"In Mechelen werden in de periode tussen 1900 en de Eerste Wereldoorlog zo\u2019n twintigtal huizen versierd met sgraffito decoraties. Belangrijke architecten die ze integreerden in hun gevelontwerpen waren P.J. Rooms, Cyrille Van den Bergh en stadsingenieur Theo Vanden bergh. Tijdens de wandeling ontdek je de architecturale pareltjes van de Art nouveau en kom je meer te weten over deze generatie bouwmeesters.\r\nStartpunt van de rondleiding : hoek Liersesteenweg - Frans Halsvest.\r\nVertrektijden:\r\n10u : rondleiding in het Nederlands\r\n14u : rondleiding in het Frans","performers":null,"boxoffice_url":"https:\/\/shop.utick.be\/?pos=MAISONCAUCHIE&module=CATALOGUE&lg=NL","website":"http:\/\/www.cauchie.be","email":"sgraffito@cauchie.be","phone_contact":"+32 474 49 09 72","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.545788"},"en":{"name":"*EXTRAMUROS* Paul Cauchie in Mechelen","shortdescr":"The Cauchie House invites you to an exciting walking tour! Discover the artworks facade in Mechelen.","longdescr":"In Mechelen, between 1900 and World War I, around 20 houses were decorated with sgraffitos. Important architects - such as P.J. Rooms, Cyrille Van den Bergh and the city architect Theo Vandenbergh - integrated this technique to their fa\u00e7ades designs. During this walk, our guide will take you on an exciting tour about the fascinating history of these master builders.\r\nMeeting point : at the corner of Liersesteenweg and Frans Halsvest.\r\nTime slots avalaible  : \r\n10am : guided tour in Dutch\r\n14pm : guided tour in French","performers":null,"boxoffice_url":"https:\/\/shop.utick.be\/?pos=MAISONCAUCHIE&module=CATALOGUE&lg=EN","website":"http:\/\/www.cauchie.be","email":"sgraffito@cauchie.be","phone_contact":"+32 474 49 09 72","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.545788"},"de":{"name":"Paul Cauchie in Mechelen","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.cauchie.be","email":"sgraffito@cauchie.be","phone_contact":"+32 474 49 09 72","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.545788"},"it":{"name":"Paul Cauchie in Mechelen","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.cauchie.be","email":"sgraffito@cauchie.be","phone_contact":"+32 474 49 09 72","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.545788"},"sp":{"name":"Paul Cauchie in Mechelen","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.cauchie.be","email":"sgraffito@cauchie.be","phone_contact":"+32 474 49 09 72","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.545788"},"pt":{"name":"Paul Cauchie in Mechelen","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.cauchie.be","email":"sgraffito@cauchie.be","phone_contact":"+32 474 49 09 72","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.545788"},"cn":{"name":"Paul Cauchie in Mechelen","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.cauchie.be","email":"sgraffito@cauchie.be","phone_contact":"+32 474 49 09 72","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.545788"}},"place":{"id":217690,"translations":{"fr":{"name":"La Maison Cauchie","address_street_name":"Rue des Francs","address_street_number":"5","address_street_box":null,"email":"info@cauchie.be","website":"http:\/\/www.cauchie.be","phone_contact":"+32 473 64 26 97","phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Rue des Francs, 5","address_line2":"1040 Etterbeek","description_web":"La Maison Cauchie, habitation personnelle et atelier du couple d\u2019artistes-d\u00e9corateurs form\u00e9 par Paul Cauchie et Caroline Voet, est un des joyaux de l\u2019Art nouveau bruxellois. Con\u00e7ue en 1905 comme un v\u00e9ritable manifeste de leur savoir-faire, au travers d'une impressionnante \u00ab fa\u00e7ade - affiche \u00bb orn\u00e9e de plusieurs panneaux de sgraffites et d'un bel \u00e9tage riche en propositions de d\u00e9coration int\u00e9rieure, cette maison vous ouvre ses portes pour vous partager son histoire et l'\u0153uvre de ses propri\u00e9taires. \r\n\r\nOuvert les premiers week-ends et le troisi\u00e8me samedi du mois.  Visites guid\u00e9es individuelles, visites guid\u00e9es de groupe, \u00e9v\u00e8nements priv\u00e9s et professionnels. \r\n","description_print":"","booking_url":"https:\/\/shop.utick.be\/?module=CATALOGUE&pos=MAISONCAUCHIE&lg=FR","sort_order":null,"virtual_visit":null},"nl":{"name":"Het Cauchiehuis","address_street_name":"Frankenstraat","address_street_number":"5","address_street_box":null,"email":"info@cauchie.be","website":"http:\/\/www.cauchie.be","phone_contact":"+32 473 64 26 97","phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Frankenstraat, 5","address_line2":"1040 Etterbeek","description_web":"Het Cauchiehuis, het eigen woonhuis-atelier van het kunstenaarsduo Paul Cauchie en Caroline Voet, is een van de parels van de Brusselse Art Nouveau. Opgevat in 1905 als een visitekaartje van hun kunnen, met een indrukwekkende gevel-advertentie met meerdere sgraffito-panelen en een bel-etage vol decoratieve interieur-elementen, opent dit huis zijn deuren om zijn geschiedenis en het werk van zijn eigenaars met u te delen.\r\n\r\nElke maand open voor publiek, het eerste weekend en de derde zaterdag van de maand.\r\nBegeleide bezoeken, groepsbezoeken, private en professionele evenementen\r\n","description_print":"","booking_url":"https:\/\/shop.utick.be\/?module=CATALOGUE&pos=MAISONCAUCHIE&lg=NL","sort_order":null,"virtual_visit":null},"en":{"name":"The Cauchie House","address_street_name":"Rue des Francs","address_street_number":"5","address_street_box":null,"email":"info@cauchie.be","website":"http:\/\/www.cauchie.be","phone_contact":"+32 473 64 26 97","phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Rue des Francs, 5","address_line2":"1040 Etterbeek","description_web":"The Cauchie House is one of the most exceptional Art Nouveau masterpieces in Brussels. Built in 1905, it was originally the home to Paul Cauchie and Caroline Voet, a couple of artists and decorators. The majestic sgraffito on the fa\u00e7ade and the opulent decorations of the bel-\u00e9tage served as a manifesto for their artistic skills. We invite you to join us for a guided tour to discover its history and unique artworks.\r\n\r\nOpen on the first weekend & the third Saturday of the month. \r\nIndividual guided tours, group guided tours, private and corporate events. \r\n","description_print":"","booking_url":"https:\/\/shop.utick.be\/?module=CATALOGUE&pos=MAISONCAUCHIE&lg=EN","sort_order":null,"virtual_visit":null},"de":{"name":"Das Maison Cauchie","address_street_name":"Rue des Francs","address_street_number":"5","address_street_box":null,"email":"info@cauchie.be","website":"http:\/\/www.cauchie.be","phone_contact":"+32 473 64 26 97","phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Rue des Francs, 5","address_line2":"1040 Etterbeek","description_web":"Das Maison Cauchie kann mit Fug und Recht als eines der sch\u00f6nsten Beispiele des Br\u00fcsseler Jugendstils bezeichnet werden. Sowohl die prachtvollen Sgraffiti und Fassadenmalereien als auch die Architektur und das Interieur des Geb\u00e4udes sind absolut sehenswert. Besichtigungen sind nach Vereinbarung m\u00f6glich.\r\n\r\nPaul Cauchie und seine Frau Lina, die ersten Besitzer, verdienten ihren Lebensunterhalt als Dekorateure und Maler und fertigten anhand historischer Techniken pr\u00e4chtige Wandgem\u00e4lde und Sgrafitti an. Die meisten Br\u00fcsseler Beispiele dieser Kunstform stammen \u00fcbrigens aus der Feder dieses K\u00fcnstlerpaars. Und obwohl er eher Ambitionen als Dekorateur denn als Architekt hatte, war es Paul Cauchie pers\u00f6nlich, der sein 1905 fertiggestelltes Haus, entwarf.\r\n\r\nDie gesamte Fassade wurde prachtvoll mit Wandmalereien verziert und diente als Aush\u00e4ngeschild f\u00fcr das Unternehmen der beiden Dekorateure. Die Vorderseite des Hauses wird dabei durch drei T\u00fcren aufgeteilt: Die mittlere T\u00fcr f\u00fchrt hinab in die Kellerebene, die rechte T\u00fcr zum Hochparterre, w\u00e4hrend die dritte T\u00fcr nur dekorative Zwecke erf\u00fcllt. Auch das Interieur des Hauses wurde mit zahlreichen Sgraffiti geschm\u00fcckt. Dabei unterscheidet sich das Maison Cauchie von den Werken der Architekten Horta, Hankar, Bl\u00e9rot oder Strauven, die diese Epoche entscheidend gepr\u00e4gt haben. Die Formen dieses Bauwerks sind nicht, wie sonst in jener Epoche \u00fcblich, der Pflanzenwelt entlehnt, sondern orientieren sich strikt an der Geometrie.\r\n\r\nAls kleine Anekdote: Aufgrund der teils minderwertigen Baustoffe, die der damals noch mit bescheidenen finanziellen Mitteln ausgestattete Paul Cauchie verwenden musste, war das Bauwerk mit der Zeit bauf\u00e4llig geworden und war 1971 vom Abriss bedroht. Nur Proteste konnten dies verhindern. Seit 1975 steht das Maison Cauchie unter Denkmalschutz.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"La Maison Cauchie","address_street_name":"Rue des Francs","address_street_number":"5","address_street_box":null,"email":"info@cauchie.be","website":"http:\/\/www.cauchie.be","phone_contact":"+32 473 64 26 97","phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Rue des Francs, 5","address_line2":"1040 Etterbeek","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"La casa Cauchie","address_street_name":"Rue des Francs","address_street_number":"5","address_street_box":null,"email":"info@cauchie.be","website":"http:\/\/www.cauchie.be","phone_contact":"+32 473 64 26 97","phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Rue des Francs, 5","address_line2":"1040 Etterbeek","description_web":"Uno de los ejemplos m\u00e1s brillantes del Art Nouveau bruselense y, en concreto, del esgrafiado o pintura de fachada es la casa Cauchie. La fachada, la arquitectura y el interior de este edificio merecen sin duda alguna una visita. Es necesario reservar con antelaci\u00f3n.\r\n\r\nPaul Cauchie, el primer propietario, se dedicaba, junto con su mujer Lina, principalmente a la decoraci\u00f3n y a la pintura y, en concreto, a la creaci\u00f3n de estas pinturas murales basadas en una t\u00e9cnica ancestral. La mayor\u00eda de los ejemplos bruselenses son obra suya o de su mujer. Aunque fue m\u00e1s decorador que arquitecto, dise\u00f1\u00f3 su propia casa, que se termin\u00f3 en 1905.\r\n\r\nToda la fachada de la casa est\u00e1 ricamente decorada por estas pinturas puesto que... \u00a1serv\u00eda de publicidad para la empresa de esta pareja de decoradores! Adem\u00e1s, en la decoraci\u00f3n de su propia fechada Cauchie hizo alarde de su especialidad. La fachada del edificio est\u00e1 dividida por la presencia de tres puertas: la puerta central da acceso al nivel del s\u00f3tano, la de la derecha da acceso a la planta baja realzada, mientras que la tercera tiene una mera funci\u00f3n decorativa. El interior de la casa tambi\u00e9n est\u00e1 decorado con numerosos esgrafiados. \r\n\r\nPor \u00faltimo, destacamos que los materiales de construcci\u00f3n no siempre eran de buena calidad. El arquitecto, a sus 30 a\u00f1os, todav\u00eda no dispon\u00eda de medios suficientes. El edificio estuvo a punto de ser demolido en 1971 para albergar una nueva construcci\u00f3n. Finalmente, violentas protestas permitieron que el edificio fuese declarado edificio protegido en 1975. \r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"La Maison Cauchie","address_street_name":"Rue des Francs","address_street_number":"5","address_street_box":null,"email":"info@cauchie.be","website":"http:\/\/www.cauchie.be","phone_contact":"+32 473 64 26 97","phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Rue des Francs, 5","address_line2":"1040 Etterbeek","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"La Maison Cauchie","address_street_name":"Rue des Francs","address_street_number":"5","address_street_box":null,"email":"info@cauchie.be","website":"http:\/\/www.cauchie.be","phone_contact":"+32 473 64 26 97","phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Rue des Francs, 5","address_line2":"1040 Etterbeek","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[9],"translations":{"fr":["Quartier europ\u00e9en"],"nl":["Europese wijk"],"en":["European Quarter"],"de":["Europ\u00e4isches Viertel"],"it":["Quartiere europeo"],"sp":["Barrio Europeo"],"pt":[null],"cn":[null]}},"zones":{"list":[22],"translations":{"fr":["Est"],"nl":["Oost"],"en":["East"],"de":["Osten"],"it":["Est"],"sp":["Este"],"pt":[null],"cn":[null]}},"tags":["force_publication"],"neca":null,"facebook_id":null,"backoffice_id":550,"location":{"lat":50.83837634,"lon":4.3953402},"region":"brussels","last_updated_at":"2023-03-07T16:35:07+01:00","published_at":"2013-10-19T01:13:37+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":217690,"translations":{"fr":{"name":"La Maison Cauchie","address_street_name":"Rue des Francs","address_street_number":"5","address_street_box":null,"email":"info@cauchie.be","website":"http:\/\/www.cauchie.be","phone_contact":"+32 473 64 26 97","phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Rue des Francs, 5","address_line2":"1040 Etterbeek","description_web":"La Maison Cauchie, habitation personnelle et atelier du couple d\u2019artistes-d\u00e9corateurs form\u00e9 par Paul Cauchie et Caroline Voet, est un des joyaux de l\u2019Art nouveau bruxellois. Con\u00e7ue en 1905 comme un v\u00e9ritable manifeste de leur savoir-faire, au travers d'une impressionnante \u00ab fa\u00e7ade - affiche \u00bb orn\u00e9e de plusieurs panneaux de sgraffites et d'un bel \u00e9tage riche en propositions de d\u00e9coration int\u00e9rieure, cette maison vous ouvre ses portes pour vous partager son histoire et l'\u0153uvre de ses propri\u00e9taires. \r\n\r\nOuvert les premiers week-ends et le troisi\u00e8me samedi du mois.  Visites guid\u00e9es individuelles, visites guid\u00e9es de groupe, \u00e9v\u00e8nements priv\u00e9s et professionnels. \r\n","description_print":"","booking_url":"https:\/\/shop.utick.be\/?module=CATALOGUE&pos=MAISONCAUCHIE&lg=FR","sort_order":null,"virtual_visit":null},"nl":{"name":"Het Cauchiehuis","address_street_name":"Frankenstraat","address_street_number":"5","address_street_box":null,"email":"info@cauchie.be","website":"http:\/\/www.cauchie.be","phone_contact":"+32 473 64 26 97","phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Frankenstraat, 5","address_line2":"1040 Etterbeek","description_web":"Het Cauchiehuis, het eigen woonhuis-atelier van het kunstenaarsduo Paul Cauchie en Caroline Voet, is een van de parels van de Brusselse Art Nouveau. Opgevat in 1905 als een visitekaartje van hun kunnen, met een indrukwekkende gevel-advertentie met meerdere sgraffito-panelen en een bel-etage vol decoratieve interieur-elementen, opent dit huis zijn deuren om zijn geschiedenis en het werk van zijn eigenaars met u te delen.\r\n\r\nElke maand open voor publiek, het eerste weekend en de derde zaterdag van de maand.\r\nBegeleide bezoeken, groepsbezoeken, private en professionele evenementen\r\n","description_print":"","booking_url":"https:\/\/shop.utick.be\/?module=CATALOGUE&pos=MAISONCAUCHIE&lg=NL","sort_order":null,"virtual_visit":null},"en":{"name":"The Cauchie House","address_street_name":"Rue des Francs","address_street_number":"5","address_street_box":null,"email":"info@cauchie.be","website":"http:\/\/www.cauchie.be","phone_contact":"+32 473 64 26 97","phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Rue des Francs, 5","address_line2":"1040 Etterbeek","description_web":"The Cauchie House is one of the most exceptional Art Nouveau masterpieces in Brussels. Built in 1905, it was originally the home to Paul Cauchie and Caroline Voet, a couple of artists and decorators. The majestic sgraffito on the fa\u00e7ade and the opulent decorations of the bel-\u00e9tage served as a manifesto for their artistic skills. We invite you to join us for a guided tour to discover its history and unique artworks.\r\n\r\nOpen on the first weekend & the third Saturday of the month. \r\nIndividual guided tours, group guided tours, private and corporate events. \r\n","description_print":"","booking_url":"https:\/\/shop.utick.be\/?module=CATALOGUE&pos=MAISONCAUCHIE&lg=EN","sort_order":null,"virtual_visit":null},"de":{"name":"Das Maison Cauchie","address_street_name":"Rue des Francs","address_street_number":"5","address_street_box":null,"email":"info@cauchie.be","website":"http:\/\/www.cauchie.be","phone_contact":"+32 473 64 26 97","phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Rue des Francs, 5","address_line2":"1040 Etterbeek","description_web":"Das Maison Cauchie kann mit Fug und Recht als eines der sch\u00f6nsten Beispiele des Br\u00fcsseler Jugendstils bezeichnet werden. Sowohl die prachtvollen Sgraffiti und Fassadenmalereien als auch die Architektur und das Interieur des Geb\u00e4udes sind absolut sehenswert. Besichtigungen sind nach Vereinbarung m\u00f6glich.\r\n\r\nPaul Cauchie und seine Frau Lina, die ersten Besitzer, verdienten ihren Lebensunterhalt als Dekorateure und Maler und fertigten anhand historischer Techniken pr\u00e4chtige Wandgem\u00e4lde und Sgrafitti an. Die meisten Br\u00fcsseler Beispiele dieser Kunstform stammen \u00fcbrigens aus der Feder dieses K\u00fcnstlerpaars. Und obwohl er eher Ambitionen als Dekorateur denn als Architekt hatte, war es Paul Cauchie pers\u00f6nlich, der sein 1905 fertiggestelltes Haus, entwarf.\r\n\r\nDie gesamte Fassade wurde prachtvoll mit Wandmalereien verziert und diente als Aush\u00e4ngeschild f\u00fcr das Unternehmen der beiden Dekorateure. Die Vorderseite des Hauses wird dabei durch drei T\u00fcren aufgeteilt: Die mittlere T\u00fcr f\u00fchrt hinab in die Kellerebene, die rechte T\u00fcr zum Hochparterre, w\u00e4hrend die dritte T\u00fcr nur dekorative Zwecke erf\u00fcllt. Auch das Interieur des Hauses wurde mit zahlreichen Sgraffiti geschm\u00fcckt. Dabei unterscheidet sich das Maison Cauchie von den Werken der Architekten Horta, Hankar, Bl\u00e9rot oder Strauven, die diese Epoche entscheidend gepr\u00e4gt haben. Die Formen dieses Bauwerks sind nicht, wie sonst in jener Epoche \u00fcblich, der Pflanzenwelt entlehnt, sondern orientieren sich strikt an der Geometrie.\r\n\r\nAls kleine Anekdote: Aufgrund der teils minderwertigen Baustoffe, die der damals noch mit bescheidenen finanziellen Mitteln ausgestattete Paul Cauchie verwenden musste, war das Bauwerk mit der Zeit bauf\u00e4llig geworden und war 1971 vom Abriss bedroht. Nur Proteste konnten dies verhindern. Seit 1975 steht das Maison Cauchie unter Denkmalschutz.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"La Maison Cauchie","address_street_name":"Rue des Francs","address_street_number":"5","address_street_box":null,"email":"info@cauchie.be","website":"http:\/\/www.cauchie.be","phone_contact":"+32 473 64 26 97","phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Rue des Francs, 5","address_line2":"1040 Etterbeek","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"La casa Cauchie","address_street_name":"Rue des Francs","address_street_number":"5","address_street_box":null,"email":"info@cauchie.be","website":"http:\/\/www.cauchie.be","phone_contact":"+32 473 64 26 97","phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Rue des Francs, 5","address_line2":"1040 Etterbeek","description_web":"Uno de los ejemplos m\u00e1s brillantes del Art Nouveau bruselense y, en concreto, del esgrafiado o pintura de fachada es la casa Cauchie. La fachada, la arquitectura y el interior de este edificio merecen sin duda alguna una visita. Es necesario reservar con antelaci\u00f3n.\r\n\r\nPaul Cauchie, el primer propietario, se dedicaba, junto con su mujer Lina, principalmente a la decoraci\u00f3n y a la pintura y, en concreto, a la creaci\u00f3n de estas pinturas murales basadas en una t\u00e9cnica ancestral. La mayor\u00eda de los ejemplos bruselenses son obra suya o de su mujer. Aunque fue m\u00e1s decorador que arquitecto, dise\u00f1\u00f3 su propia casa, que se termin\u00f3 en 1905.\r\n\r\nToda la fachada de la casa est\u00e1 ricamente decorada por estas pinturas puesto que... \u00a1serv\u00eda de publicidad para la empresa de esta pareja de decoradores! Adem\u00e1s, en la decoraci\u00f3n de su propia fechada Cauchie hizo alarde de su especialidad. La fachada del edificio est\u00e1 dividida por la presencia de tres puertas: la puerta central da acceso al nivel del s\u00f3tano, la de la derecha da acceso a la planta baja realzada, mientras que la tercera tiene una mera funci\u00f3n decorativa. El interior de la casa tambi\u00e9n est\u00e1 decorado con numerosos esgrafiados. \r\n\r\nPor \u00faltimo, destacamos que los materiales de construcci\u00f3n no siempre eran de buena calidad. El arquitecto, a sus 30 a\u00f1os, todav\u00eda no dispon\u00eda de medios suficientes. El edificio estuvo a punto de ser demolido en 1971 para albergar una nueva construcci\u00f3n. Finalmente, violentas protestas permitieron que el edificio fuese declarado edificio protegido en 1975. \r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"La Maison Cauchie","address_street_name":"Rue des Francs","address_street_number":"5","address_street_box":null,"email":"info@cauchie.be","website":"http:\/\/www.cauchie.be","phone_contact":"+32 473 64 26 97","phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Rue des Francs, 5","address_line2":"1040 Etterbeek","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"La Maison Cauchie","address_street_name":"Rue des Francs","address_street_number":"5","address_street_box":null,"email":"info@cauchie.be","website":"http:\/\/www.cauchie.be","phone_contact":"+32 473 64 26 97","phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Rue des Francs, 5","address_line2":"1040 Etterbeek","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"tags":["force_publication"],"neca":null,"facebook_id":null,"backoffice_id":550,"location":{"lat":50.83837634,"lon":4.3953402},"region":"brussels","last_updated_at":"2023-03-07T16:35:07+01:00","published_at":"2013-10-19T01:13:37+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/871848d84d045a49b755b9b5a76c3ed633c75538.jpg","width":2224,"height":1487,"ratio":1.5,"translations":{"fr":{"title":"*EXTRAMUROS* Paul Cauchie \u00e0 Malines ","copyright":"\u00a9 asbl Maison Cauchie"},"nl":{"title":"*EXTRAMUROS* Paul Cauch