ents":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-10T21:05:57+02:00","published_at":"2022-08-31T11:59:41+02:00","backoffice_id":260722,"import_origin":null,"sub_type":"misc","show_in_agenda":true,"ranking":1},{"id":542105,"date_start":"2022-11-25","date_end":"2022-11-25","date_next":"2022-11-25","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":84,"translations":{"fr":"Divers","nl":"Varia","en":"Various","de":"Verschiedenes"}},"others":{"list":[89],"translations":{"fr":["Litt\u00e9rature"],"nl":["Literatuur"],"en":["Litterature "],"de":["Literatur"]}}},"languages":{"spoken":["nl","fr","en"],"subtitles":[]},"translations":{"fr":{"name":"Mama's Open Mic","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.542105"},"nl":{"name":"Mama's Open Mic","shortdescr":"Mama's Open Mic is back in town! Verwacht je aan een verrassende line-up van woordkunstenaars en aanstormend talent! Afspraak in Muntpunt voor spoken word, slam, comedy, muziek, dans en veel meer.","longdescr":"Guess who's baaaaack?\n\nAre your ready for another Mama's Open Mic in Brussels? Mama's Open Mic is \u00e9\u00e9n van de grootste en meest invloedrijke platformen voor woordkunst \u00e9n een safe space voor beginnende en meer professionele kunstenaars.\nOntdek hier binnenkort de line-up!\n\nHoe werkt het?\nEr zijn Open Mic sessies tussen de verschillende headliners. Er zijn telkens 3 \u00e0 4 spots voor artiesten die zich ter plaatsen kunnen aanmelden.\n\nKan ik mijn eigen muziek meebrengen?\u00a0\nZeker! Breng je eigen muziek mee op een USB-stick of neem je eigen instrument mee.\n\nMama's Open Mic is een safe space! We tolereren geen racisme, seksisme, leeftijdsdiscriminatie, validisme, transfobie, islamofobie\u2026 We cre\u00ebren een omgeving van wederzijds respect en waken erover dat dit zo blijft!\n\n----------------------------------------------\n\nGuess who's baaaaack?\n\nAre your ready for another Mama's Open Mic in Brussels? Mama's Open Mic is one of Belgium's largest and most influential platforms for word art and a safe space for emerging and more established artists.\nThe\u00a0 line-up will be confirmed here soon!\n\nHow does it work?\nThere are different Open Mic sessions between the headliners. There are 3 or 4 spots for artists who can register right before the event.\n\nCan I bring my own music?\nYes! Bring your music on a USB stick or bring your own instrument.\n\nMOM is a safe space, meaning there is no room for -isms (racism, sexism, ableism, ageism\u2026) or -phobias (fatphobia, islamophobia, transphobia\u2026). We will be facilitating an environment of mutual respect and take the necessary measures to keep it that way!","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.542105"},"en":{"name":"Mama's Open Mic","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.542105"},"de":{"name":"Mama's Open Mic","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.542105"},"it":{"name":"Mama's Open Mic","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":n