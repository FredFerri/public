":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.556775"},"sp":{"name":"Brussels Beer Project Dansaert - Flash Tour","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.beerproject.be\/taproom\/dansaert\/","email":"keepintouch@beerproject.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.556775"},"nl":{"name":"Brussels Beer Project Dansaert - Flash Tour","shortdescr":"Ontdek de brouwerij BBP Dansaert in het centrum van Brussel!","longdescr":"Welkom bij het Brussels Beer Project Dansaert, een brouwerij gelegen in het centrum van Brussel.\r\n\r\nKom langs in de brouwerij \/ taproom met een welkomstdrankje, uitleg van het brouwproces (30min) en sluit af met een degustatiepalet van 4 van onze nieuwste bieren (15cl)","performers":"Het BBP team","boxoffice_url":null,"website":"https:\/\/www.beerproject.be\/taproom\/dansaert\/","email":"keepintouch@beerproject.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.556775"}},"place":{"id":266293,"translations":{"de":{"name":"Brussels Beer Project","address_street_name":"Rue Antoine Dansaert","address_street_number":"188","address_street_box":null,"email":"keepintouch@beerproject.be","website":"http:\/\/www.beerproject.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Antoine Dansaert, 188","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Brussels Beer Project","address_street_name":"Rue Antoine Dansaert","address_street_number":"188","address_street_box":null,"email":"keepintouch@beerproject.be","website":"http:\/\/www.beerproject.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Antoine Dansaert, 188","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Brussels Beer Project","address_street_name":"Antoine Dansaert","address_street_number":"188","address_street_box":null,"email":"keepintouch@beerproject.be","website":"http:\/\/www.beerproject.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Antoine Dansaert, 188","address_line2":"1000 Brussels","description_web":"This young Brussels company offers atypical beers created in participation with a community of passionate beer lovers. Since a few years, a new wave has come up - bold, creative, collaborative - that challenges the idea of flavours and taste. Professional brewers from around the world are welcome in Brussels to create new flavours and push the boundaries of beer. On the menu: the whole spectrum from Russian Imperial Stouts to a mix of \u2018Old School\u2019 Belgian with influences from the New World. The all stars are : Delta, Saison IPA \u2013 a tropical view on Brussels; Dark Sister, Black IPA - maleficent sister of the Delta; Grosse Bertha, Belgian Hefeweizen - a Weizenbeer for adults and the Babylone, Bread Bitter - the first beer brewed with recycled bread. Brussels Beer Project breaths contemporary Brussels, a cosmopolitan city that lives and evolves.","description_print":"This young Brussels company offers atypical beers created in participation with a community of passionate beer lovers. Since a few years, a new wave has come up - bold, creative, collaborative - that challenges the idea of flavours and taste. Professional brewers from around the world are welcome in Brussels to create new flavours and push the boundaries of beer. On the menu: the whole spectrum from Russian Imperial Stouts to a mix of \u2018Old School\u2019 Belgian with influences from the New World. The all stars are : Delta, Saison IPA \u2013 a tropical view on Brussels; Dark Sister, Black IPA - maleficent sister of the Delta; Grosse Bertha, Belgian Hefeweizen - a Weizenbeer for adults and the Babylone, Bread Bitter - the first beer brewed with recycled bread. Brussels Beer Project breaths contemporary Brussels, a cosmopolitan city that lives and evolves.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Brussels Beer Project","address_street_name":"Rue Antoine Dansaert","address_street_number":"188","address_street_box":null,"email":"keepintouch@beerproject.be","website":"http:\/\/www.beerproject.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Antoine Dansaert, 188","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Brussels Beer Project","address_street_name":"Rue Antoine Dansaert","address_street_number":"188","address_street_box":null,"email":"keepintouch@beerproject.be","website":"http:\/\/www.beerproject.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Antoine Dansaert, 188","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Brussels Beer Project","address_street_name":"Rue Antoine Dansaert","address_street_number":"188","address_street_box":null,"email":"keepintouch@beerproject.be","website":"http:\/\/www.beerproject.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Antoine Dansaert, 188","address_line2":"1000 Bruxelles","description_web":"Cette jeune entreprise bruxelloise propose des bi\u00e8res atypiques cr\u00e9\u00e9es en partenariat avec une communaut\u00e9 de passionn\u00e9s amateurs de bi\u00e8re. Depuis quelques ann\u00e9es, une nouvelle vague est arriv\u00e9e \u2013 audacieuse, cr\u00e9ative, collaborative \u2013 qui chamboule les standards des saveurs et du go\u00fbt. Des ma\u00eetres brasseurs du monde entier sont invit\u00e9s \u00e0 Bruxelles pour co-cr\u00e9er de nouveaux go\u00fbts.  Au menu : un \u00e9ventail complet commen\u00e7ant avec les stouts imp\u00e9riales russes jusqu\u2019\u00e0 un m\u00e9lange d\u2019\u00ab Old School \u00bb belge influenc\u00e9e par des saveurs du Nouveau Monde. Les all stars sont : la Delta, Saison IPA - une vue exotique de Bruxelles ; la Dark Sister, Black IPA - la s\u0153ur mal\u00e9fique de la Delta ; la Grosse Bertha, Belgian Hefeweizen - une Weizen pour adulte et la Babylone, Bread Bitter - 1\u00e8re bi\u00e8re brass\u00e9e \u00e0 partir de pain frais recycl\u00e9. Le Brussels Beer Project repr\u00e9sente Bruxelles contemporaine, une ville cosmopolite vivante et en \u00e9volution.","description_print":"Cette jeune entreprise bruxelloise propose des bi\u00e8res atypiques cr\u00e9\u00e9es en partenariat avec une communaut\u00e9 de passionn\u00e9s amateurs de bi\u00e8re. Depuis quelques ann\u00e9es, une nouvelle vague est arriv\u00e9e \u2013 audacieuse, cr\u00e9ative, collaborative \u2013 qui chamboule les standards des saveurs et du go\u00fbt. Des ma\u00eetres brasseurs du monde entier sont invit\u00e9s \u00e0 Bruxelles pour co-cr\u00e9er de nouveaux go\u00fbts.  Au menu : un \u00e9ventail complet commen\u00e7ant avec les stouts imp\u00e9riales russes jusqu\u2019\u00e0 un m\u00e9lange d\u2019\u00ab Old School \u00bb belge influenc\u00e9e par des saveurs du Nouveau Monde. Les all stars sont : la Delta, Saison IPA - une vue exotique de Bruxelles ; la Dark Sister, Black IPA - la s\u0153ur mal\u00e9fique de la Delta ; la Grosse Bertha, Belgian Hefeweizen - une Weizen pour adulte et la Babylone, Bread Bitter - 1\u00e8re bi\u00e8re brass\u00e9e \u00e0 partir de pain frais recycl\u00e9. Le Brussels Beer Project repr\u00e9sente Bruxelles contemporaine, une ville cosmopolite vivante et en \u00e9volution.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Brussels Beer Project","address_street_name":"Rue Antoine Dansaert","address_street_number":"188","address_street_box":null,"email":"keepintouch@beerproject.be","website":"http:\/\/www.beerproject.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Antoine Dansaert, 188","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Brussels Beer Project","address_street_name":"Antoine Dansaertstraat","address_street_number":"188","address_street_box":null,"email":"keepintouch@beerproject.be","website":"http:\/\/www.beerproject.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Antoine Dansaertstraat, 188","address_line2":"1000 Brussel","description_web":"Deze jonge Brusselse onderneming biedt atypische bieren aan die gecre\u00eberd worden in samenspraak met een gemeenschap van gepassioneerde bierliefhebbers. Sinds een aantal jaren is er een nieuwe wind komen waaien - gedurfd, gewaagd en creatief - die het idee van smaak durft uitdagen. Professionele brouwers vanuit de hele wereld zijn in Brussel welkom om nieuwe smaken te cre\u00ebren en grenzen af te tasten. Op het menu staat: het hele spectrum van Russische Imperial Stout tot een mix van \u2018Old School\u2019 Belgische smaken met invloeden uit de Nieuwe Wereld. De all stars zijn: de Delta, Saison IPA - een tropisch zicht op Brussel ; de Dark Sister, Black IPA \u2013 de onheilspellende zus van de Delta ; de Grosse Bertha, Belgian Hefeweizen - een Weizen voor volwassenen en de Babylone, Bread Bitter- het eerste bier gebrouwd met gerecycleerd brood. Brussels Beer Project is een uiting van de frisse hedendaagse wind die door het cosmopolitische Brussel waait. ","description_print":"Deze jonge Brusselse onderneming biedt atypische bieren aan die gecre\u00eberd worden in samenspraak met een gemeenschap van gepassioneerde bierliefhebbers. Sinds een aantal jaren is er een nieuwe wind komen waaien - gedurfd, gewaagd en creatief - die het idee van smaak durft uitdagen. Professionele brouwers vanuit de hele wereld zijn in Brussel welkom om nieuwe smaken te cre\u00ebren en grenzen af te tasten. Op het menu staat: het hele spectrum van Russische Imperial Stout tot een mix van \u2018Old School\u2019 Belgische smaken met invloeden uit de Nieuwe Wereld. De all stars zijn: de Delta, Saison IPA - een tropisch zicht op Brussel ; de Dark Sister, Black IPA \u2013 de onheilspellende zus van de Delta ; de Grosse Bertha, Belgian Hefeweizen - een Weizen voor volwassenen en de Babylone, Bread Bitter- het eerste bier gebrouwd met gerecycleerd brood. Brussels Beer Project is een uiting van de frisse hedendaagse wind die door het cosmopolitische Brussel waait. ","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[3,8],"translations":{"de":["Dansaert\/Sainte-Catherine","Kanal-Viertel"],"pt":[null,null],"en":["Dansaert\/Sainte-Catherine","Canal"],"it":["Dansaert\/Sainte-Catherine","Canal"],"cn":[null,null],"fr":["Dansaert\/Sainte-Catherine","Canal"],"sp":["Dansaert\/Sainte-Catherine","Canal"],"nl":["Dansaertwijk\/Sint-Katelijne","Kanaalwijk"]}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":null,"facebook_id":null,"backoffice_id":26293,"location":{"lat":50.85275676,"lon":4.34190956},"region":"brussels","last_updated_at":"2024-07-18T12:10:33+02:00","published_at":"2016-08-17T17:09:08+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":266293,"translations":{"de