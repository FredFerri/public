nplaats. Hier kunnen de gasten lunchen en dineren in een intieme omgeving. De Grand Lounge straalt voor de volle 100% design uit. De harmonie tussen de hoge plafonds, de grote raampartijen, het natuurlijk licht, het metaalwerk en de vernieuwende menukaart maken van de Grand Lounge zowel een lounge als een bar. Bij mooi weer is het ook mogelijk om buiten te dineren.\nDe Lounge bar is een combinatie van een traditioneel caf\u00e9 met een loungesfeer. Met zijn hotspot interieur, creatieve drankjes en \u00e0 la carte menu trekt deze bar een client\u00e8le van stijlbewuste hotelgasten maar ook de plaatselijke jetset. De enorme raampartijen en de hoge plafonds cre\u00ebren een verrassend intieme omgeving.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":41024,"location":{"lat":50.8492677,"lon":4.3547615},"is_in_address_book":false,"is_in_vb_export":false,"import_origin":"crm","external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/fb990e8f2d9dc8c94ea849a9379e472272a5d3c8.jpg","width":4912,"height":7360,"ratio":0.67,"oEmbed_height":7360,"oEmbed_width":4912,"translations":{"de":{"title":"Antoine Leclercq","copyright":null},"pt":{"title":"Antoine Leclercq","copyright":null},"en":{"title":"Antoine Leclercq","copyright":null},"it":{"title":"Antoine Leclercq","copyright":null},"cn":{"title":"Antoine Leclercq","copyright":null},"fr":{"title":"Antoine Leclercq","copyright":null},"sp":{"title":"Antoine Leclercq","copyright":null},"nl":{"title":"Antoine Leclercq","copyright":null}}},{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/eb89ece1e9e585e9119812dbed254ca11620d0a2.jpg","width":4486,"height":6280,"ratio":0.71,"oEmbed_height":6280,"oEmbed_width":4486,"translations":{"de":{"title":"Klara Rusan","copyright":null},"pt":{"title":"Klara Rusan","copyright":null},"en":{"title":"Klara Rusan","copyright"