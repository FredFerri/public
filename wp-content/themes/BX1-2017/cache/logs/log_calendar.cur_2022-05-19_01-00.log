_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre"}},"others":{"list":[54],"translations":{"fr":["One man Show et humour"],"nl":["Onemanshow en humor"],"en":["One man show and comedy"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Les D\u00e9couvertes - Sc\u00e8nes ouvertes stand-up","shortdescr":"Les D\u00e9couvertes, c\u2019est un concept de sc\u00e8nes ouvertes qui met sous le feu des projecteurs des artistes aguerris comme des d\u00e9butants.","longdescr":"Les D\u00e9couvertes, c\u2019est un concept de sc\u00e8nes ouvertes qui met sous le feu des projecteurs des artistes aguerris comme des d\u00e9butants.\r\n\r\nJosh et Lou vous pr\u00e9senteront deux univers diff\u00e9rents : les D\u00e9couverts stand-up anim\u00e9es par Josh et\/ou les D\u00e9couvertes musicales men\u00e9es par Lou.\r\n\r\nHumour et musique, les artistes que vous rencontrerez vous surprendront !\r\n\r\nLes soir\u00e9es stand-up et musique se donneront en alternance un mercredi sur deux \u00e0 20h30 \u00e0 la Station des R\u00eaveurs.\r\n\r\nOuverture des portes \u00e0 20h, entr\u00e9e 5euros payable sur place. Un chapeau circulera pendant les d\u00e9couvertes afin de soutenir chaque artiste.\r\n\r\nTu as toi aussi envie de tenter ta chance ? Inscris-toi !","performers":null,"boxoffice_url":null,"website":"http:\/\/www.lacompagniedesreveurs.com\/event","email":"administration@lacompagniedesreveurs.com","phone_contact":null,"phone_booking":"+32 485 20 93 83","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/527158.html"},"nl":{"name":"Les D\u00e9couvertes - Sc\u00e8nes ouvertes stand-up","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda