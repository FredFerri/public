oken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Guillermo Guiz : Au Suivant !","shortdescr":"Ultime repr\u00e9sentation !","longdescr":"Quoi ? Vous n\u2019avez pas encore vu le deuxi\u00e8me spectacle de Guillermo Guiz ? Mais d\u00e9p\u00eachez-vous, malheureux ! Parce que c\u2019est maintenant ou jamais. Et parce que Guillermo Guiz c\u2019est le meilleur. Voil\u00e0, c\u2019est comme \u00e7a, c\u2019est prouv\u00e9. Que \u00e7a n\u2019emp\u00eache personne de se lancer dans l\u2019humour, tout en sachant que la place de \u00ab Roi de la vanne \u00bb est d\u00e9j\u00e0 prise.\r\n\r\nKet d\u2019Anderlecht, ancien espoir footballistique, journaliste, furtif patron de bo\u00eete de nuit, chroniqueur radio, Guy Verstraeten \u2013 de son vrai nom \u2013 a d\u00e9j\u00e0 eu mille vies. Il se raconte encore dans ce spectacle cr\u00e9\u00e9 en 2020 au TTO, explorant entre autres questions, celle de la transmission. C\u2019est dr\u00f4le bien entendu mais c\u2019est surtout intelligent, et souvent poignant. Guiz dribble avec nos \u00e9motions, on lui mange dans la main, il fait ce qu\u2019il veut de nous et on en redemande, toujours plus nombreux.","performers":"Avec Guillermo Guiz Cr\u00e9ation lumi\u00e8res Gilles Goblet Production Th\u00e9\u00e2tre de la Toison d\u2019Or","boxoffice_url":null,"website":"http:\/\/www.ttotheatre.be","email":"info@ttotheatre.be","phone_contact":null,"phone_booking":"+32 2 510 05 10","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.537536"},"nl":{"name":"Guillermo Guiz : Au Suivant !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.537536"},"en":{"name":"Guillermo Guiz : Au Suivant !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.537536"},"de":{"name":"Guillermo Guiz : Au Suivant ! - Derni\u00e8re repr\u00e9sentation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.537536"},"it":{"name":"Guillermo Guiz : Au Suivant ! - Derni\u00e8re repr\u00e9sentation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.537536"},"sp":{"name":"Guillermo Guiz : Au Suivant ! - Derni\u00e8re repr\u00e9sentation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.537536"},"pt":{"name":"Guillermo Guiz : Au Suivant ! - Derni\u00e8re repr\u00e9sentation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.537536"},"cn":{"name":"Guillermo Guiz : Au Suivant ! - Derni\u00e8re repr\u00e9sentation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.537536"}},"place":{"id":329,"translations":{"fr":{"name":"Cirque Royal","address_street_name":"Rue de l'Enseignement","address_street_number":"81","address_street_box":null,"email":"info@cirqueroyalbruxelles.be","website":"http:\/\/www.cirque-royal-bruxelles.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de l'Enseignement, 81","address_line2":"1000 Bruxelles","description_web":"La gestion artistique du lieu, longtemps assur\u00e9e par le Botanique, a \u00e9t\u00e9 attribu\u00e9 \u00e0 Brussels Expo. La programmation musicale restera centrale, n\u00e9anmoins, danse, th\u00e9\u00e2tre ou op\u00e9ra investissent quelquefois son ar\u00e8ne. Sans oublier le cirque, art auquel \u00e9tait initialement d\u00e9di\u00e9e cette salle, comme le rappelle encore son nom.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Koninklijk Circus","address_street_name":"Onderrichtsstraat","address_street_number":"81","address_street_box":null,"email":"info@koninklijkcircusbrussel.be","website":"http:\/\/www.cirque-royal-bruxelles.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Onderrichtsstraat, 81","address_line2":"1000 Brussel","description_web":"Het gebouw dateert van 1878, toen het dienstdeed als het enige permanente Brusselse circus. Dit voormalige circus is wellicht een van de gezelligste zalen van Brussel. Het artistieke beheer, lang in handen van de Botanique, is overgegaan naar Brussels Expo. De programmatie van concerten primeert, maar er vinden ook dansspektakels en shows plaats die gesmaakt worden door jong en oud. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Cirque Royal","address_street_name":"Rue de l'Enseignement","address_street_number":"81","address_street_box":null,"email":"info@cirqueroyalbruxelles.be","website":"http:\/\/www.cirque-royal-bruxelles.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue de l'Enseignement, 81","address_line2":"1000 Brussels","description_web":"This former circus built in 1878 is probably one of the nicest venues in Brussels. The artistic management of the site, long granted by the Botanique, is in the hands of Brussels Expo now. Music programming remains the central activity, however, dance, theater or opera sometimes invest its arena too. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Cirque Royal","address_street_name":"Rue de l'Enseignement","address_street_number":"81","address_street_box":null,"email":"info@cirqueroyalbruxelles.be","website":"http:\/\/www.cirque-royal-bruxelles.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de l'Enseignement, 81","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Cirque Royal","address_street_name":"Rue de l'Enseignement","address_street_number":"81","address_street_box":null,"email":"info@cirqueroyalbruxelles.be","website":"http:\/\/www.cirque-royal-bruxelles.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de l'Enseignement, 81","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Cirque Royal","address_street_name":"Rue de l'Enseignement","address_street_number":"81","address_street_box":null,"email":"info@cirqueroyalbruxelles.be","website":"http:\/\/www.cirque-royal-bruxelles.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de l'Enseignement, 81","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Circo reale","address_street_name":"Rue de l'Enseignement","address_street_number":"81","address_street_box":null,"email":"info@cirqueroyalbruxelles.be","website":"http:\/\/www.cirque-royal-bruxelles.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de l'Enseignement, 81","address_line2":"1000 Bruxelles","description_web":"A gest\u00e3o art\u00edstica do local, assegurada durante muito tempo pelo Jardim Bot\u00e2nico, foi atribu\u00edda \u00e0 Brussels Expo. A programa\u00e7\u00e3o musical permanecer\u00e1 o foco, embora a dan\u00e7a, o teatro e a \u00f3pera fa\u00e7am apari\u00e7\u00f5es espor\u00e1dicas na arena. Sem esquecer o circo, arte a que foi inicialmente dedicada esta sala, como o seu nome ainda recorda.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Cirque Royal","address_street_name":"Rue de l'Enseignement","address_street_number":"81","address_street_box":null,"email":"info@cirqueroyalbruxelles.be","website":"http:\/\/www.cirque-royal-bruxelles.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de l'Enseignement, 81","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":[],"zones":{"list":[19],"translations":{"fr":["Centre"],"nl":["Centrum"],"en":["Centre"],"de":["Zentrum"],"it":[null],"sp":[null],"pt":[null],"cn":[null]}},"neca":null,"facebook_id":null,"backoffice_id":85,"location":{"lat":50.84905517,"lon":4.36569912},"region":"brussels","last_updated_at":"2022-11-23T15:53:36+01:00","published_at":"2013-10-19T01:13:16+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":227607,"translations":{"fr":{"name":"TTO - Th\u00e9\u00e2tre de la Toison d'Or","address_street_name":"Galerie de la Toison d'Or","address_street_number":"396","address_street_box":null,"email":"info@ttotheatre.be","website":"http:\/\/www.ttotheatre.be","phone_contact":"+32 2 510 05 10","phone_booking":"+32 2 510 05 10","address_zip":"1050","address_city":"Ixelles","address_line1":"Galerie de la Toison d'Or, 396","address_line2":"1050 Ixelles","description_web":"L\