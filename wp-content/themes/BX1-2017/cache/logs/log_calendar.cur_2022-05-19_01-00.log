allowfullscreen><\/iframe>","translations":{"fr":{"title":"\u00d4 Tour des Contes 2022 | Teaser"},"nl":{"title":"\u00d4 Tour des Contes 2022 | Teaser"},"en":{"title":"\u00d4 Tour des Contes 2022 | Teaser"}}}],"dates":[],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":0}],"child_events":[],"parent_events":[],"targets":{"list":[14,2,3,4,5,19,11,7,8,10],"translations":{"fr":["Aveugle\/malvoyant","Enfants 0-3 ans","Enfants 3-6 ans","Enfants 6-9 ans","Enfants 9-12 ans","Enseignants","Famille","Jeunes 12-15 ans","Jeunes 15-18 ans","Seniors"],"nl":["Blind\/slechtziend","Kinderen 0-3 j.","Kinderen 3-6 j.","Kinderen 6-9 j.","Kinderen 9-12 j.","Leerkrachten","Familie","Jongeren 12-15 j.","Jongeren 15-18 j.","Senioren"],"en":["Blind\/visually impaired","Children 0-3 yr.","Children 3-6 yr.","Children 6-9 yr.","Children 9-12 yr.","Teachers","Family","Youth 12-15  yr.","Youth 15-18  yr.","Seniors"]}},"tags":["major_event","exterior","kids"],"accessibilities":{"list":[255,259,261,263,265],"translations":{"fr":["Accessible","Chien d'assistance","Parking accessible","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9"],"nl":["Toegankelijk","Assistentiehonden","Toegankelijke parking","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet"],"en":["Accessible","Assistance dogs","Accessible parking","Accessible to pedestrians with mobility aids","Adapted toilet"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-04-29T10:05:04+02:00","published_at":"2022-04-05T08:52:33+02:00","backoffice_id":250888,"import_origin":null,"sub_type":"festival","show_in_agenda":true,"ranking":0.69336127435063},{"id":532992,"date_start":"2022-05-22","date_end":"2022-05-22","date_next":"2022-05-22","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert"}},"others":{"list":[4,7],"translations":{"fr":["Pop, rock, jazz\u2026","Pop, Rock"],"nl":["Pop, rock, jazz\u2026","Pop, Rock"],"en":["Pop, rock, jazz\u2026","Pop, Rock"]}}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Inauguration du tunnel Annie Cordy","shortdescr":"L'inauguration officielle, en pr\u00e9sence de sa ni\u00e8ce et ayant droit Mich\u00e8le Lebon-Cooreman et des proches d\u2019Annie Cordy, marquera la fin de la r\u00e9novation compl\u00e8te du tunnel op\u00e9r\u00e9e ces derni\u00e8res ann\u00e9es afin d\u2019am\u00e9liorer la s\u00e9curit\u00e9 et le confort de ses usagers. Cette inauguration, organis\u00e9e conjointement par Bruxelles Mobilit\u00e9 et equal.brussels, se veut solidaire et festive.","longdescr":"L'inauguration officielle du tunnel sera suivie d'une marche solidaire au profit de l\u2019ASBL Pink Ribbon. A cette occasion, le tunnel sera ouvert aux marcheurs et marcheuses de tous horizons qui souhaitent marquer leur solidarit\u00e9 aux quelques 100.000 femmes qui se battent contre le cancer du sein en Belgique. La marche solidaire sera suivie par un concert-hommage gratuit dans le parc Elisabeth organis\u00e9 par la ni\u00e8ce et ayant droit d\u2019Annie Cordy. A 15h, les amis artistes d\u2019Annie Cordy, toutes g\u00e9n\u00e9rations confondues, lui rendront hommage lors d\u2019un exceptionnel spectacle kal\u00e9idoscope autour de ses chansons. Les chansons d'Annie Cordy rythmeront le parcours.","performers":"Salvatore Adamo, David Alexis, Laurence Bibot, Dave, Fr\u00e9d\u00e9ric Fran\u00e7ois, Virginie Hocq, Sandra Kim, Marka, Gilbert Montagn\u00e9, Swing Cockt\u2019elles - Annabelle Sodi-Thibault, Ita Graffin, Morgane Touzalin-Macabia, les Fr\u00e8res Taloche, Udo, Herv\u00e9 Vilard... Pr\u00e9sentation : Els De Schepper & C\u00e9cile Djunga","boxoffice_url":null,"website":"https:\/\/www.facebook.com\/events\/5285029238184230","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/532992.html"},"nl":{"name":"Inwijding Annie Cordytunnel","shortdescr":"De offici\u00eble inwijding in aanwezigheid Mich\u00e8le Lebon-Cooreman, nicht en rechthebbende, en heel wat naasten van Annie Cordy, vormt het sluitstuk van de volledige renovatie om de veiligheid en het comfort van de weggebruikers te verhogen. Deze feestelijke, solidaire inwijding is een gezamenlijke organisatie van Brussel Mobiliteit en Equal Brussels.","longdescr":"De offici\u00eble inwijding van de tunnel wordt gevolgd door een gesponsorde wandeling ten voordele van de vzw Pink Ribbon. Naar aanleiding hiervan wordt de tunnel uitzonderlijk opengesteld voor alle wandelaars die zich solidair willen tonen met de honderdduizend vrouwen die in Belgi\u00eb vechten tegen borstkanker. Na de solidariteitsmars volgt een gratis hommageconcert in het Elisabethpark, georganiseerd door de nicht en rechthebbende van Annie Cordy. Om 15 uur zullen bevriende artiesten van alle leeftijden de zangeres eer betonen met een groot caleidoscopisch spektakel rond haar liedjes.","performers":"Salvatore Adamo, David Alexis, Laurence Bibot, Dave, Fr\u00e9d\u00e9ric Fran\u00e7ois, Virginie Hocq, Sandra Kim, Marka, Gilbert Montagn\u00e9, Swing Cockt\u2019elles - Annabelle Sodi-Thibault, Ita Graffin, Morgane Touzalin-Macabia, les Fr\u00e8res Taloche, Udo, Herv\u00e9 Vilard... Pr\u00e9sentation : Els De Schepper & C\u00e9cile Djunga","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/532992.html"},"en":{"name":"Inauguration du tunnel Annie Cordy","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/532992.html"},"de":{"name":"Inauguration du tunnel Annie Cordy","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/532992.html"},"it":{"name":"Inauguration du tunnel Annie Cordy","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/532992.html"},"sp":{"name":"Inauguration du tunnel Annie Cordy","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/532992.html"},"pt":{"name":"Inauguration du tunnel Annie Cordy","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/532992.html"},"cn":{"name":"Inauguration du tunnel Annie Cordy","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/532992.html"}},"place":{"id":233248,"translations":{"fr":{"name":"Parc Elisabeth","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1081","address_city":"Koekelberg","address_line1":"Parc Elisabeth","address_line2":"1081 Koekelberg","description_web":"Le parc Elisabeth ouvre, avec ses all\u00e9es arbor\u00e9es, l\u2019une des plus belles perspectives de Bruxelles : elle plonge de la Basilique de Koekelberg jusqu\u2019au jardin Botanique en suivant le boulevard L\u00e9opold II.\r\n\r\nCon\u00e7u dans le m\u00eame esprit que le parc du Cinquantenaire, on trouve dans ce parc historique une all\u00e9e centrale qui constitue la colonne vert\u00e9brale de cette grande promenade. \r\n\r\nElle se compose d\u2019une berme gazonn\u00e9e, sertie de deux all\u00e9es arbor\u00e9es qui reproduisent dans leur trac\u00e9 le \u00ab L \u00bb (pour L\u00e9opold) du monogramme royal. De part et d\u2019autre, sur les c\u00f4t\u00e9s, on retrouve des pelouses travers\u00e9es de chemins sinueux et ponctu\u00e9es de massifs d\u2019arbres et de buissons.\r\n\r\nEquipements :\r\n- Bac \u00e0 sable\r\n- Bancs\r\n- Fontaines d\u2019eau potable\r\n- Plaine de jeux 3-7 ans\r\n- Terrain multisports\r\n- Zone \u00ab chiens en libert\u00e9 \u00bb \r\n- Panneaux d\u2019information\r\n\r\nAccessibilit\u00e9 :\r\nLe parc est accessible aux personnes \u00e0 mobilit\u00e9 r\u00e9duite.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Elisabethpark","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1081","address_city":"Koekelberg","address_line1":"Elisabethpark","address_line2":"1081 Koekelberg","description_web":"Het park bestaat uit lange boomrijke lanen die een van de mooiste vergezichten op Brussel bieden: van de Basiliek van Koekelberg tot aan de Kruidtuin, langs de Leopold II-laan.\r\n\r\nHet Elisabethpark is een klassiek historisch park in dezelfde geest als het Jubelpark. Een centrale laan vormt de ruggengraat van deze grote en kaarsrechte wandellaan. \r\n\r\nZe bestaat uit een met gras begroeide middenberm, omzoomd door twee rijen bomen die de letter \u2018L\u2019 van Leopold vormen, het monogram van de koning. Aan beide zijden liggen grasperken met kronkelende paden, boomgroepen en struiken.\r\n\r\nUitrusting :\r\n- Zitbanken\r\n- Drinkfontein\r\n- Zandbak\r\n- Speeltuintje voor 3- tot 7-jarigen\r\n- Multisportterrein\r\n- Zone waarin honden vrij mogen rondlopen\r\n- Informatieborden\r\n\r\nToegankelijkheid : \r\nHet park is toegankelijk voor mensen met beperkte mobiliteit.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Parc Elisabeth","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1081","address_city":"Koekelberg","address_line1":"Parc Elisabeth","address_line2":"1081 Koekelberg","description_web":"The 21 ha of the park are located on the plateau of Koekelberg; they present a long promenade network, comparable to the one of the Cinquantenaire, punctuated with lawns and trees clumps alternated with groves and flower-beds. The park also contains some fittings for leisure purposes, resting area, playground...\r\n\r\nThe drawing of the park evokes the Royal monogram of L\u00e9opold II, under whose reign it was designed, simultaneously with the perspective of the Basilique du Sacr\u00e9-Coeur and the very long one of the Boulevard Leopold II.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Parc Elisabeth","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1081","address_city":"Koekelberg","address_line1":"Parc Elisabeth","address_line2":"1081 Koekelberg","description_web":"Der Parc Elisabeth mit seinen von B\u00e4umen ges\u00e4umten Alleen, bietet eine der sch\u00f6nsten Br\u00fcsseler Ansichten \u2013 von der Basilique de Koekelberg \u00fcber den Boulevard L\u00e9opold II bis hin zum botanischen Garten Jardin Botanique.\r\n\r\nDer historische Park wurde im gleichen Stil wie der Parc du Cinquantenaire gestaltet und verf\u00fcgt \u00fcber eine zentrale Allee, die gewisserma\u00dfen das R\u00fcckgrat des Spazier- und Flanierwegenetzes bildet. \r\n\r\nDieses besteht aus einem Rasenabschnitt, eingefasst von zwei von B\u00e4umen ges\u00e4umten Alleen, deren Form den Buchstaben \u201eL\u201c (f\u00fcr L\u00e9opold, als Monogramm des damaligen belgischen K\u00f6nigs) bilden. Beidseitig erstrecken sich Rasenfl\u00e4chen mit verschlungenen Spazierwegen, die immer wieder von Baumgruppen und Geb\u00fcsch ges\u00e4umt werden.\r\n\r\nAusstattung :\r\n- Sandspielplatz\r\n- B\u00e4nke\r\n- Trinkwasserbrunnen\r\n- Spielplatz (3-7 Jahre)\r\n- Sportfl\u00e4che\r\n- Hundebereich\r\n- Infotafeln\r\n\r\nBarrierefreiheit :\r\nDer Park ist problemlos f\u00fcr Menschen mit eingeschr\u00e4nkter Mobilit\u00e4t zug\u00e4nglich.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Parc Elisabeth","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1081","address_city":"Koekelberg","address_line1":"Parc Elisabeth","address_line2":"1081 Koekelberg","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Parc Elisabeth","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1081","address_city":"Koekelberg","address_line1":"Parc Elisabeth","address_line2":"1081 Koekelberg","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Parque Elisabeth","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1081","address_city":"Koekelberg","address_line1":"Parque Elisabeth","address_line2":"1081 Koekelberg","description_web":"Com as suas vias arborizadas, o parque Elisabeth abre uma das vistas mais lindas de Bruxelas: mergulha da Bas\u00edlica de Koekelberg ao Jardim Bot\u00e2nico, continuando pela avenida L\u00e9opold II. Concebido no mesmo esp\u00edrito do parque do Cinquenten\u00e1rio, encontramos neste parque hist\u00f3rico uma via central que consiste na coluna vertebral deste grande parque. \u00c9 composto por uma berma relvada, cravejada de duas vias arborizadas que reproduzem, no seu tra\u00e7ado, a letra L (de L\u00e9opold) do emblema real. De uma parte e de outra, nos lados, encontramos a\u00ed campos atravessados por caminhos sinuosos, pontuados por maci\u00e7os de \u00e1rvores e de arbustos. Equipamentos: Caixa de areia- Bancos- Chafarizes de \u00e1gua pot\u00e1vel- Parque infantil 3-7 anos- Campo polidesportivo- Zona \u00abc\u00e3es em liberdade\u00bb - Painel de informa\u00e7\u00f5es Acessibilidade: o parque est\u00e1 acess\u00edvel a pessoas de mobilidade reduzida.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Parc Elisabeth","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1081","address_city":"Koekelberg","address_line1":"Parc Elisabeth","address_line2":"1081 Koekelberg","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":[],"zones":{"list":[20],"translations":{"fr":["Nord"],"nl":["Noord"],"en":["North"]}},"neca":null,"facebook_id":null,"backoffice_id":1222,"location":{"lat":50.86584571,"lon":4.32129622},"region":"brussels","last_updated_at":"2022-05-03T15:05:11+02:00","published_at":"2013-10-19T01:14:09+02:00","import_origin":null,"external_id":null,"is_in_address_book":false,"is_in_vb_export":false,"resto_ranking":0},"organizer":{"id":250434,"translations":{"fr":{"name":"Bruxelles Mobilit\u00e9","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":"bruxellesmobilite@mrbc.irisnet.be","website":"http:\/\/www.bruxellesmobilite.irisnet.be","phone_contact":"+32 80 09 40 01","phon