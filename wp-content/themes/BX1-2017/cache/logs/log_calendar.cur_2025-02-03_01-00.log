nt":false,"backoffice_id":316124,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"tour","ranking":0.13979972105947794,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{}},"translations":{"de":{"name":"La maison de St Cyr - un bijou extravagant","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/la-maison-de-st-cyr-un-bijou-extravagant","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":"+32 2 319 45 60","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700005384"},"pt":{"name":"La maison de St Cyr - un bijou extravagant","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/la-maison-de-st-cyr-un-bijou-extravagant","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":"+32 2 319 45 60","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700005384"},"en":{"name":"La maison de St Cyr - un bijou extravagant","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/la-maison-de-st-cyr-un-bijou-extravagant","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":"+32 2 319 45 60","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700005384"},"it":{"name":"La maison de St Cyr - un bijou extravagant","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/la-maison-de-st-cyr-un-bijou-extravagant","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":"+32 2 319 45 60","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700005384"},"cn":{"name":"La maison de St Cyr - un bijou extravagant","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/la-maison-de-st-cyr-un-bijou-extravagant","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":"+32 2 319 45 60","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700005384"},"fr":{"name":"La maison de St Cyr - un bijou extravagant","shortdescr":"Ouverture exceptionnelle de la maison Saint Cyr !","longdescr":"La fa\u00e7ade de la Maison Saint Cyr est probablement la plus connue des fa\u00e7ades Art nouveau bruxelloises avec ses ferronneries extravagantes sur quatre niveaux alors qu'elle ne fait que 4 m\u00e8tres de large ! Elle fut construite par Gustave Strauven entre 1901 et 1903 pour servir d'h\u00f4tel particulier au peintre Georges Saint Cyr. Pour cette visite exclusive en tr\u00e8s petit comit\u00e9 (8 personnes\/visites), vous d\u00e9couvrirez la restauration minutieuse et incroyable de la fa\u00e7ade r\u00e9alis\u00e9e en 2008 par le bureau Sum mais aussi de l'int\u00e9rieur r\u00e9alis\u00e9 \u00e0 partir de 2012 par les nouveaux propri\u00e9taires et le bureau Ma\u00b2 de Francis Metzger. Parquets, vitraux, verri\u00e8re, papier peints, stucs ont ainsi \u00e9t\u00e9 m\u00e9ticuleusement nettoy\u00e9s ou refaits \u00e0 l'identique ! Un travail qui a dur\u00e9 deux ann\u00e9es.\n\n\"D\u00e8s l\u2019origine, les d\u00e9cors Art nouveau c\u00f4toient un style n\u00e9o-Renaissance flamande, Louis XVI ou Empire, et cette succession chronologique de styles se dotera d\u2019appropriations culturelles \u00ab\u2009exotiques\u2009\u00bb, con\u00e7ues comme des ponctuations dans le cheminement.\"\n\nNous vous demanderons de d\u00e9poser vos sacs et parapluie \u00e0 l'entr\u00e9e et d'\u00eatre tr\u00e8s respectueux de la maison.\n\nLes propri\u00e9taires font don de leurs b\u00e9n\u00e9fices \u00e0 l'ASBL Le petit v\u00e9lo jaune.","performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/la-maison-de-st-cyr-un-bijou-extravagant","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":"+32 2 319 45 60","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700005384"},"sp":{"name":"La maison de St Cyr - un bijou extravagant","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/la-maison-de-st-cyr-un-bijou-extravagant","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":"+32 2 319 45 60","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700005384"},"nl":{"name":"La maison de St Cyr - un bijou extravagant","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/la-maison-de-st-cyr-un-bijou-extravagant","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":"+32 2 319 45 60","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700005384"}},"place":{"id":50002783,"translations":{"de":{"name":"Maison de St Cyr","address_street_name":"Square Ambiorix","address_street_number":"11","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Square Ambiorix, 11","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Maison de St Cyr","address_street_name":"Square Ambiorix","address_street_number":"11","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Square Ambiorix, 11","address_line2":"1000 Bruxelle