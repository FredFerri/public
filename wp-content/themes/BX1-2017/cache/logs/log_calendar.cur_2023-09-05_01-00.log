e,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2023-09-04T15:45:03+02:00","published_at":"2023-09-04T12:01:05+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":284689,"facebook_link":null,"import_origin":null,"is_part_of":"Ann\u00e9e Art Nouveau","sub_type":"festival","ranking":0.7937005259840998,"languages":{"spoken":["nl","en","fr"],"subtitles":[]},"categories":{"main":{"id":118,"translations":{"de":"Festival","pt":null,"en":"Festival","it":"Festival","cn":null,"fr":"Festival","sp":"Festival","nl":"Festival"}},"others":{}},"translations":{"de":{"name":"Heritage Days","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/heritagedays.urban.brussels\/","email":"jdp-omd@urban.brussels","phone_contact":"+32 2 432 83 00","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50001753"},"pt":{"name":"Heritage Days","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/heritagedays.urban.brussels\/","email":"jdp-omd@urban.brussels","phone_contact":"+32 2 432 83 00","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50001753"},"en":{"name":"Heritage Days","shortdescr":"ART NOUVEAU, ART FOR ALL?\nFor this 35th edition of the Heritage Days, Urban invites you to broaden your vision of Art Nouveau through a rich and varied programme of guided tours and cultural events.","longdescr":"This edition sheds light on the emergence of this architectural style and its lasting influence: against which historical, technological and social background did it come into existence?\n\nWhat are the origins and particularities of its materials? What are the challenges involved in its implementation and conservation? Who contributed to its existence? How were these premises occupied and furnished? Do they still influence the way we live in our city today?\n\nAs well as discovering these Art Nouveau venues and events, Urban also invites you to discover or rediscover many of our capital's must-see monuments and museums.\n\nRead more : https:\/\/heritagedays.urban.brussels\/","performers":null,"boxoffice_url":null,"website":"https:\/\/heritagedays.urban.brussels\/","email":"jdp-omd@urban.brussels","phone_contact":"+32 2 432 83 00","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50001753"},"it":{"name":"Heritage Days","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/heritagedays.urban.brussels\/","email":"jdp-omd@urban.brussels","phone_contact":"+32 2 432 83 00","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50001753"},"cn":{"name":"Heritage Days","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/heritagedays.urban.brussels\/","email":"jdp-omd@urban.brussels","phone_contact":"+32 2 432 83 00","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50001753"},"fr":{"name":"Heritage Days \/ Journ\u00e9es du Patrimoine","shortdescr":"ART NOUVEAU, ART POUR TOU\u00b7TE\u00b7S ?\n\nPour cette 35e \u00e9dition des Heritage Days \/ Journ\u00e9es du Patrimoine, Urban vous propose d\u2019\u00e9largir votre vision de l\u2019Art nouveau au travers d\u2019une programmation riche et vari\u00e9e, de visites guid\u00e9es et d\u2019animations culturelles.","longdescr":"Cette \u00e9dition permet de mieux comprendre l\u2019\u00e9mergence de ce style architectural et sa p\u00e9rennit\u00e9 : dans quel contexte historique, technologique et social est-il apparu ?\n\nQuelles sont les origines et les particularit\u00e9s de ses mat\u00e9riaux ? Quels sont les d\u00e9fis rencontr\u00e9s pour sa mise en \u0153uvre, mais \u00e9galement pour sa conservation ? Quels sont les acteurs qui ont contribu\u00e9 \u00e0 son existence ? Comment ces lieux \u00e9taient-ils occup\u00e9s et meubl\u00e9s ? Influencent-ils notre fa\u00e7on d\u2019habiter notre ville aujourd\u2019hui ?\n\nOutre la d\u00e9couverte de ces lieux et animations autour de l\u2019Art nouveau, Urban vous invite \u00e9galement \u00e0 d\u00e9couvrir ou red\u00e9couvrir de nombreux monuments et mus\u00e9es \u00ab incontournables \u00bb de notre capitale.\n\nEn savoir plus : https:\/\/heritagedays.urban.brussels\/","performers":null,"boxoffice_url":null,"website":"https:\/\/heritagedays.urban.brussels\/","email":"jdp-omd@urban.brussels","phone_contact":"+32 2 432 83 00","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50001753"},"sp":{"name":"Heritage Days","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/heritagedays.urban.brussels\/","email":"jdp-omd@urban.brussels","phone_contact":"+32 2 432 83 00","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50001753"},"nl":{"name":"Heritage Days \/ Open Monumentendagen","shortdescr":"ART NOUVEAU, KUNST VOOR IEDEREEN?\n\nVoor deze 35ste editie van de Heritage Days \/ Open Monumentendagen nodigt Urban u uit om uw kijk op art nouveau te verruimen via talrijke en gevarieerde rondleidingen en culturele evenementen.","longdescr":"Deze editie helpt zowel het ontstaan als het voortbestaan van deze bouwstijl beter te begrijpen. Tegen welke historische, technologische en sociale achtergrond ontstond deze stijl? Wat waren de uitdagingen bij het bouwen en voor zijn voortbestaan? Wie heeft bijgedragen aan zijn opkomst?\n\nWat is de oorsprong en wat zijn de bijzonderheden van de gebruikte materialen? Hoe werden deze panden bewoond en bemeubeld? Be\u00efnvloeden ze nog steeds ons huidig (be)leven in (van) de stad?\n\nNaast een kennismaking met deze art-nouveaulocaties en -evenementen nodigt Urban u ook uit om tal van niet te missen monumenten en musea in onze hoofdstad te (her)ontdekken.\n\nMeer weten : https:\/\/heritagedays.urban.brussels\/","performers":null,"boxoffice_url":null,"website":"https:\/\/heritagedays.urban.brussels\/","email":"jdp-omd@urban.brussels","phone_contact":"+32 2 432 83 00","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50001753"}},"place":{"id":245448,"translations":{"de":{"name":"Divers lieux \u00e0 Bruxelles","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Divers lieux \u00e0 Bruxelles","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Divers lieux \u00e0 Bruxelles","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Divers lieux \u00e0 Bruxelles","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Various places in Brussels","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Various places in Brussels","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Divers lieux \u00e0 Bruxelles","address_street_name":null,"address_street_