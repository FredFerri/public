enda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":310902,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"concert","ranking":2,"languages":{"spoken":["en","nl","fr"],"subtitles":[]},"categories":{"main":{"id":1,"translations":{"de":"Konzert","pt":null,"en":"Concert","it":"Concerti","cn":null,"fr":"Concert","sp":"Concierto","nl":"Concert"}},"others":{}},"translations":{"de":{"name":"\u2018Georg Friedrich H\u00e4ndel - Messiah\u2019","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.brusselschoralsociety.com\/concert-calendar\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700003282"},"pt":{"name":"\u2018Georg Friedrich H\u00e4ndel - Messiah\u2019","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.brusselschoralsociety.com\/concert-calendar\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700003282"},"en":{"name":"\u2018Georg Friedrich H\u00e4ndel - Messiah\u2019","shortdescr":"\u2018Georg Friedrich H\u00e4ndel - Messiah\u2019","longdescr":"Ever since its first performance in Dublin in 1742, George Frideric Handel\u2019s Messiah is one of the best-known and most popular pieces for choirs and audiences all over the world. \n\nHandel composed the Messiah in just three weeks, basing it on biblical texts describing the prophecy and birth of Jesus, the passion and resurrection, and even the Messiah\u2019s role in life after death. \n\nNow 45 years after its first performance of Messiah in its inaugural concert, the Brussels Choral Society joins the Ensemble Orchestral de Bruxelles under the baton of Eric Delson for an extraordinary musical journey, to the famous \u2018Hallelujah\u2019 and beyond.","performers":"\nBrussels Choral Society\nEnsemble Orchestral de Bruxelles\nEric Delson, conductor\nHendrickje van Kerckhove, soprano\nMarie-Juliette Ghazarian, alto\nYves Saelens, tenor\nCharles Dekeyser, bass\n","boxoffice_url":null,"website":"https:\/\/www.brusselschoralsociety.com\/concert-calendar\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700003282"},"it":{"name":"\u2018Georg Friedrich H\u00e4ndel - Messiah\u2019","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.brusselschoralsociety.com\/concert-calendar\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700003282"},"cn":{"name":"\u2018Georg Friedrich H\u00e4ndel - Messiah\u2019","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.brusselschoralsociety.com\/concert-calendar\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700003282"},"fr":{"name":"\u2018Georg Friedrich Haendel - Le Messie\u2019","shortdescr":"\n\n\u2018Georg Friedrich Haendel - Le Messie\u2019","longdescr":"Depuis sa premi\u00e8re repr\u00e9sentation \u00e0 Dublin en 1742, Le Messie de Georg Friederich Haendel est l\u2019une des \u0153uvres les plus connues et les plus populaires aupr\u00e8s des ch\u0153urs et des publics du monde entier. \n\nHaendel a compos\u00e9 Le Messie en seulement trois semaines en se basant sur des textes bibliques d\u00e9crivant la proph\u00e9tie et la naissance de J\u00e9sus, la passion et la r\u00e9surrection, et m\u00eame le r\u00f4le du Messie dans la vie apr\u00e8s la mort. \n\n45 ans apr\u00e8s sa premi\u00e8re interpr\u00e9tation du Messie lors de son concert inaugural, la Brussels Choral Society se joint \u00e0 l\u2019Ensemble Orchestral de Bruxelles sous la direction d\u2019Eric Delson pour un voyage musical extraordinaire, jusqu\u2019au c\u00e9l\u00e8bre All\u00e9luia et au-del\u00e0.","performers":"Brussels Choral Society\nEnsemble Orchestral de Bruxelles\nEric Delson, direction\nHendrickje van Kerckhove, soprano\nMarie-Juliette Ghazarian, alto\nYves Saelens, t\u00e9nor\nCharles Dekeyser, basse\n ","boxoffice_url":null,"website":"https:\/\/www.brusselschoralsociety.com\/concert-calendar\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700003282"},"sp":{"name":"\u2018Georg Friedrich H\u00e4ndel - Messiah\u2019","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.brusselschoralsociety.com\/concert-calendar\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700003282"},"nl":{"name":"\u2018Georg Friedrich H\u00e4ndel - Messiah\u2019","shortdescr":"\u2018Georg Friedrich H\u00e4ndel - Messiah\u2019","longdescr":"Al vanaf de allereerste uitvoering in Dublin in 1742, is Georg Friedrich H\u00e4ndel\u2019s \"Messiah\" \u00e9\u00e9n van de allerbekendste en meest geliefde muziekstukken geweest bij koren en concertgangers over de hele wereld. \n\nH\u00e4ndel componeerde de \"Messiah\" in een tijdsbestek van slechts drie weken, op bijbelteksten die een beschrijving geven van de profetische voorspelling en de geboorte van Jezus, het lijden en de wederopstanding, en zelfs de rol van de Messias in het leven na de dood. \n\n45 jaar nadat de Brussels Choral Society bij haar allereerste concert dit werk uitvoerde, neemt zij u nu samen met het Ensemble Orchestral de Bruxelles onder leiding van dirigent Eric Delson mee op een buitengewone muzikale reis met het beroemde \"Hallelujah\" en nog veel meer.","performers":"Brussels Choral Society\nEnsemble Orchestral de Bruxelles\nEric Delson, dirigent\nHendrickje van Kerckhove, sopraan\nMarie-Juliette Ghazarian, alt\nYves Saelens, tenor\nCharles Dekeyser, bas","boxoffice_url":null,"website":"https:\/\/www.brusselschoralsociety.com\/concert-calendar\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700003282"}},"place":{"id":63,"translations":{"de":{"name":"Palais des Beaux-Arts - Bozar","address_street_name":"Rue Ravenstein","address_street_number":"23","address_street_box":null,"email":"info@bozar.be","website":"http:\/\/www.bozar.be","phone_contact":"+32 2 507 82 00","phone_booking":"+32 2 507 82 00","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Ravenstein, 23","address_line2":"1000 Bruxelles","description_web":"Das Br\u00fcsseler BOZAR z\u00e4hlt zu den dynamischsten und hochkar\u00e4tigsten Kultur- und Kunstzentren der belgischen Kulturlandschaft. Das Art D\u00e9co-Meisterwerk aus der Feder Victor Hortas ist zudem einer der gro\u00dfen architektonischen Sch\u00e4tze Br\u00fcssels.\r\nKultur, Kultur und noch mehr Kultur! Auf mehr als 4 000 Quadratmetern gibt es Konzerte, Ausstellungen, Theater, Tanz, Literatur, Konferenzen und Filmvorf\u00fchrungen unter einem Dach zu sehen.\r\n\r\nF\u00fcr Musikinteressierte reicht das Angebot von Weltmusik \u00fcber Electronic DJs bis hin zum klassischen Symphonieorchester. Kunst- und Literaturliebhaber kommen mit zeitgen\u00f6ssischen, avantgardistischen und klassischen Kunst- und Gem\u00e4ldeausstellungen, der Fotobiennale Summer of Photography, mehrsprachigen Theaterinszenierungen, Brussels Short Film Festival, Book Clubs in franz\u00f6sischer und fl\u00e4mischer Version oder auch Architekturkonferenzen auf ihre Kosten.\r\n\r\nBOZAR-Brasserie:\r\nKulturinteressierte Genie\u00dfer k\u00f6nnen sich in der BOZAR-Brasserie von dem franz\u00f6sischen Chefkoch David Martin mit Men\u00fcs verw\u00f6hnen lassen, die dem kulturellen Angebot in nichts nachstehen. Die Brasserie ist Teil eines umfassenden Restaurierungs- und Renovierungsprogramms, sie wurde nach dem Vorbild der Original-Horta-Brasserie gestaltet. Von dem Gourmetf\u00fchrer Gault&Millau 2013 wurde sie \u00fcbrigens zur \u201eBrasserie des Jahres\" gew\u00e4hlt! \r\n\r\nBozar Caf\u00e9 Victor\r\nFr\u00fchst\u00fcck, Mittag- oder Abendessen vor oder nach dem Ausstellungs- oder Konzertbesuch k\u00f6nnen im Caf\u00e9 Victor eingenommen werden. Gro\u00dfe Fensterfronten, puristisches Design, edle Lederb\u00e4nke, spektakul\u00e4re Leuchten und feine Snacks und Speisen ergeben ein harmonisches Ensemble.\r\n","description_print":null,"booking_url":null,"sort_order":"Bozar","virtual_visit":null,"visit_url":null},"pt":{"name":"Centro de Belas Artes \u2014 Bozar","address_street_name":"Rue Ravenstein","address_street_number":"23","address_street_box":null,"email":"info@bozar.be","website":"http:\/\/www.bozar.be","phone_contact":"+32 2 507 82 00","phone_booking":"+32 2 507 82 00","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Ravenstein, 23","address_line2":"1000 Bruxelles","description_web":"Ao falar da cultura belga, \u00e9 obrigat\u00f3rio mencionar o Pal\u00e1cio de Belas Artes de Bruxelas. Quer sejam exposi\u00e7\u00f5es, concertos, teatro, cinema ou projetos liter\u00e1rios e arquitet\u00f3nicos, BOZAR coloca sempre em primeira linha a originalidade e inova\u00e7\u00e3o. N\u00e3o s\u00f3 enfatiza a cria\u00e7\u00e3o, qualidade e riqueza do programa art\u00edstico, mas preocupa-se sobretudo em oferecer uma experi\u00eancia completa aos seus visitantes.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Centre for Fine Arts - Bozar","address_street_name":"Rue Ravenstein","address_street_number":"23","address_street_box":null,"email":"info@bozar.be","website":"http:\/\/www.bozar.be","phone_contact":"+32 2 507 82 00","phone_booking":"+32 2 507 82 00","address_zip":"1000","address_city":"Brussels","address_line1":"Rue Ravenstein, 23","address_line2":"1000 Brussels","description_web":"It\u2019s impossible to talk about culture in Belgium without mentioning the Centre for Fine Arts located in Brussels. Whether it comes to exhibitions, concerts, theater performances, movies or projects concerning literature and architecture, BOZAR will always put originality and innovation first. They prove to keep a finger on the pulse with their varied and sophisticated programme. Besides emphasizing the importance of creation, quality and a rich artistic offering, BOZAR is especially concerned about the total experience of the visitors.","description_print":"It\u2019s impossible to talk about culture in Belgium without mentioning the Centre for Fine Arts located in Brussels. Whether it comes to exhibitions, concerts, theater performances, movies or projects concerning literature and architecture, BOZAR will always put originality and innovation first. They prove to keep a finger on the pulse with their varied and sophisticated programme. Besides emphasizing the importance of creation, quality and a rich artistic offering, BOZAR is especially concerned about the total experience of the visitors.","booking_url":null,"sort_order":"Bozar","virtual_visit":null,"visit_url":null},"it":{"name":"Palazzo delle Belle Arti - Bozar","address_street_name":"Rue Ravenstein","address_street_number":"23","address_street_box":null,"email":"info@bozar.be","website":"http:\/\/www.bozar.be","phone_contact":"+32 2 507 82 00","phone_booking":"+32 2 507 82 00","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Ravenstein, 23","address_line2":"1000 Bruxelles","description_web":"BOZAR il Palazzo delle Belle Arti, centro d'arte per eccellenza del panorama culturale belga, offre un programma internazionale nel cuore di Bruxelles.\r\n\r\nL'edificio \u00e8 un gioiello del patrimonio architettonico del Belgio. E' stato realizzato da Victor Horta in stile Art Nouveau nel 1920.\r\n\r\nIl Bozar \u00e8 un centro d'arte attivo e dinamico che accoglie ogni anno pi\u00f9 di un milione di visitatori: 4.000 m\u00b2 di spazi espositivi, una grandiosa sala concerti, una sala per musica da camera, due piccoli teatri, tre nuove sale multimediali, il BOZAR SHOP, la BOZAR BRASSERIE e la Cinemateca Reale, famosa in tutto il mondo per la sua collezione di grande valore.\r\n\r\n\r\nLa BOZAR BRASSERIE vi aspetta con il suo chef stellato David Martin. Prenotazioni, solo per telefono, al n\u00b0 +32 (0)2 503 00 00. Aperto 7 giorni su 7, dalle 12 alle 23.\r\n\r\nVisitate anche il BOZARSHOP: migliaia di libri d'arte, CD, DVD, idee regalo.\r\nSpazio giochi per i vostri bambini.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Palais des Beaux-Arts - Bozar","address_street_name":"Rue Ravenstein","address_street_number":"23","address_street_box":null,"email":"info@bozar.be","website":"http:\/\/www.bozar.be","phone_contact":"+32 2 507 82 00","phone_booking":"+32 2 507 82 00","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Ravenstein, 23","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Palais des Beaux-Arts - Bozar","address_street_name":"Rue Ravenstein","address_street_number":"23","address_street_box":null,"email":"info@bozar.be","website":"http:\/\/www.bozar.be","phone_contact":"+32 2 507 82 00","phone_booking":"+32 2 507 82 00","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Ravenstein, 23","address_line2":"1000 Bruxelles","description_web":"Lorsqu\u2019on parle de la culture en Belgique, on pense forc\u00e9ment au Palais des Beaux-Arts de Bruxelles. Qu\u2019il s\u2019agisse d\u2019expositions, de concerts, de th\u00e9\u00e2tre ou de cin\u00e9ma, de projets autour de la litt\u00e9rature et d\u2019architecture, BOZAR met toujours en avant l\u2019originalit\u00e9 et l\u2019innovation. Non seulement ils mettent un point d\u2019honneur \u00e0 la cr\u00e9ation, la qualit\u00e9 et la richesse du programme artistique, mais se pr\u00e9occupent surtout d\u2019offrir une exp\u00e9rience totale \u00e0 ses visiteurs.","description_print":"Lorsqu\u2019on parle de la culture en Belgique, on pense forc\u00e9ment au Palais des Beaux-Arts de Bruxelles. Qu\u2019il s\u2019agisse d\u2019expositions, de concerts, de th\u00e9\u00e2tre ou de cin\u00e9ma, de projets autour de la litt\u00e9rature et d\u2019architecture, BOZAR met toujours en avant l\u2019originalit\u00e9 et l\u2019innovation. Non seulement ils mettent un point d\u2019honneur \u00e0 la cr\u00e9ation, la qualit\u00e9 et la richesse du programme artistique, mais se pr\u00e9occupent surtout d\u2019offrir une exp\u00e9rience totale \u00e0 ses visiteurs.","booking_url":null,"sort_order":"Bozar","virtual_visit":null,"visit_url":null},"sp":{"name":"Palacio de las Bellas Artes - Bozar","address_street_name":"Rue Ravenstein","address_street_number":"23","address_street_box":null,"email":"info@bozar.be","website":"http:\/\/www.bozar.be","phone_contact":"+32 2 507 82 00","phone_booking":"+32 2 507 82 00","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Ravenstein, 23","address_line2":"1000 Bruxelles","description_web":"El Bozar, el Palacio de las Bellas Artes, es el centro de arte por excelencia del paisaje cultural belga. \r\n\r\nEl Palacio de las Bellas Artes de Bruselas ofrece un programa cultural y art\u00edstico. Es uno de los n\u00facleos art\u00edsticos m\u00e1s din\u00e1micos de B\u00e9lgica, con 1 mill\u00f3n de visitas al a\u00f1o. \r\n\r\nEn el programa: exposiciones, m\u00fasica, danza, teatro, cine, literatura o arquitectura para peque\u00f1os y no tan peque\u00f1os. \r\n\r\nEl edificio constituye una de las obras maestras del patrimonio arquitect\u00f3nico de B\u00e9lgica. \r\n\r\nEste Palacio Art D\u00e9co lo ide\u00f3 el arquitecto Victor Horta en 1920 e incluye:\r\n\r\n- M\u00e1s de 4.000 m\u00b2 espacios de exposici\u00f3n\r\n- La Sala Henry le B\u0153uf, es decir, una magn\u00edfica sala de conciertos\r\n- 1 sala de m\u00fasica de c\u00e1mara\r\n- 2 peque\u00f1os teatros y 3 nuevas salas multimedia\r\n- La Bozar Brasserie y la cocina innovadora del chef galardonado David Martin\r\n- La Cinemateca Real y su indiscutible colecci\u00f3n internacionalmente conocida\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Paleis voor Schone Kunsten - Bozar","address_street_name":"Ravensteinstraat","address_street_number":"23","address_street_box":null,"email":"info@bozar.be","website":"http:\/\/www.bozar.be","phone_contact":"+32 2 507 82 00","phone_booking":"+32 2 507 82 00","address_zip":"1000","address_city":"Brussel","address_line1":"Ravensteinstraat, 23","address_line2":"1000 Brussel","description_web":"Als je in Belgi\u00eb over cultuur spreekt, dan kun je niet om het Paleis voor Schone Kunsten in Brussel heen. Of het nu gaat om tentoonstellingen, concerten, theater- en filmvoorstellingen, projecten rond literatuur en architectuur, steeds stelt Bozar originaliteit en vernieuwing voorop. Ze bewijzen dat ze de vinger aan de pols hebben met hun gevarieerd en uitgekiend programma. Niet alleen creatie, kwaliteit en een rijk artistiek aanbod draagt de zorg weg. Bij Bozar zijn ze bekommerd om de totaalervaring. Het imposante en tegelijk intieme gebouw - van de hand van Horta- heeft een bevreemdende schoonheid.","description_print":"Als je in Belgi\u00eb over cultuur spreekt, dan kun je niet om het Paleis voor Schone Kunsten in Brussel heen. Of het nu gaat om tentoonstellingen, concerten, theater- en filmvoorstellingen, projecten rond literatuur en architectuur, steeds stelt Bozar originaliteit en vernieuwing voorop. Ze bewijzen dat ze de vinger aan de pols hebben met hun gevarieerd en uitgekiend programma. Niet alleen creatie, kwaliteit en een rijk artistiek aanbod draagt de zorg weg. Bij Bozar zijn ze bekommerd om de totaalervaring. Het imposante en tegelijk intieme gebouw - van de hand van Horta- heeft een bevreemdende schoonheid.","booking_url":null,"sort_order":"Bozar","virtual_visit":null,"visit_url":null}},"districts":{"list":[16],"translations":{"de":["K\u00f6nigliches Viertel"],"pt":[null],"en":["Royal"],"it":["Quartiere reale"],"cn":[null],"fr":["Quartier Royal"],"sp":["Quartier Royal \u2014Barrio de la Corte\u2014"],"nl":["Koninklijke wijk"]}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":"art_center","facebook_id":null,"backoffice_id":13,"location":{"lat":50.8442214,"lon":4.35950594},"region":"brussels","last_updated_at":"2024-09-25T15:34:15+02:00","published_at":"2013-10-19T01:13:13+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":244123,"translations":{"de":{"name":"BCS - Brussels Choral Society","address_street_name":"Rue des Aduatiques","address_street_number":"48","address_street_box":null,"email":null,"website":"http:\/\/www.brusselschoralsociety.com","phone_contact":null,"phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Rue des Aduatiques, 48","address_line2":"1040 Etterbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"BCS - Brussels Choral Society","address_street_name":"Rue des Aduatiques","address_street_number":"48","address_street_box":null,"email":null,"website":"http:\/\/www.brusselschoralsociety.com","phone_contact":null,"phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Rue des Aduatiques, 48","address_line2":"1040 Etterbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"BCS - Brussels Chor