l,null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2023-07-02T02:07:12+02:00","published_at":"2021-03-04T11:38:08+01:00","backoffice_id":229506,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.032627673798037},{"id":560072,"date_start":"2023-07-09","date_end":"2023-07-09","date_next":"2023-07-09","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert","de":"Konzert","it":"Concerti","sp":"Concierto","pt":null,"cn":null}},"others":{"list":[4,6],"translations":{"fr":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"],"nl":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"],"en":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"],"de":["Pop, Rock, Jazz...","Worldmusic, Folk & Country"],"it":["Pop, rock, jazz\u2026","Worldmusic, Folk e Country"],"sp":["Pop, rock, jazz\u2026","Worldmusic, folk y country"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Ik en den Theo \/ Moi et le Th\u00e9o","shortdescr":null,"longdescr":"Avec Moi et le Th\u00e9o\/Ik en den Theo vous (re) d\u00e9couvrez le monde \u00e0 travers les yeux des petits. Enfants, parents et grands-parents marchent comme des robots, jouent \u00e0 la chaise musicale, re\u00e7oivent un souffle \u00e9nergique de l\u2019oncle Jazz, jouent de l\u2019air guitar et m\u00eame plus. Bref, ils explorent les limites ext\u00e9rieures de leur fantaisie.\r\n\r\nEn fonction de la composition du public, Moi et le Th\u00e9o\/Ik en den Theo chantent en fran\u00e7ais, en n\u00e9erlandais ou, dans le meilleur des mondes, en deux langues.\r\n\r\nPiet Maris et Theophane Raballand (tous les deux de Jaune Toujours) font leur truc \u00e0 l\u2019accord\u00e9on, \u00e0 la batterie et aux percussions, mais surtout\u2026 avec le public, qui est sans cesse invit\u00e9 \u00e0 danser, \u00e0 chanter, \u00e0 sauter et \u00e0 imaginer.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.560072"},"nl":{"name":"Ik en den Theo \/ Moi et le Th\u00e9o","shortdescr":null,"longdescr":"Bij Ik en den Theo \/ Moi et le Th\u00e9o (her)bekijk je de wereld door kinderogen. Kinderen, ouders en grootouders kunnen rondlopen als robots, stoelendansen, bezoek krijgen van nonkel Jazz, luchtgitaar spelen en nog veel meer... Kortom, ze verkennen de uiterste grenzen van hun fantasie.\r\n\r\nAfhankelijk van de samenstelling van het publiek zingen Ik en den Theo\/Moi et le Th\u00e9o in het Nederlands of in het Frans of, in de beste van alle werelden, in beide talen.\r\n\r\nPiet Maris en Theophane Raballand (allebei van Jaune Toujours) doen hun ding op accordeon en slagwerk ... en met het publiek, dat voortdurend wordt uitgedaagd om mee te zingen, dansen, springen en fantaseren.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.560072"},"en":{"name":"Ik en den Theo \/ Moi et le Th\u00e9o","shortdescr":null,"longdescr":"Ik en den Theo\/Moi et le Th\u00e9o look at the world through children's eyes. Piet Maris and Theophane Raballand ( both of Jaune Toujours) do their thing on accordion and drums... and with the audience. Depending on its composition Ik en den Theo\/Moi et le Th\u00e9o sing in Dutch or French, or in the best of worlds in both languages.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.560072"},"de":{"name":"Ik en den Theo \/ Moi et le Th\u00e9o","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.560072"},"it":{"name":"Ik en den Theo \/ Moi et le Th\u00e9o","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.560072"},"sp":{"name":"Ik en den Theo \/ Moi et le Th\u00e9o","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.560072"},"pt":{"name":"Ik en den Theo \/ Moi et le Th\u00e9o","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.560072"},"cn":{"name":"Ik en den Theo \/ Moi et le Th\u00e9o","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.560072"}},"place":{"id":2507,"translations":{"fr":{"name":"Ch\u00e2teau du Karreveld","address_street_name":"Avenue Jean de la Hoese","address_street_number":"3","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Avenue Jean de la Hoese, 3","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"Le Karreveld n'est pas qu'un parc mais c'est aussi une \"ferme-ch\u00e2teau\" devenue un espace culturel au centre du parc entour\u00e9 d'arbres et d'un \u00e9tang.\r\n\r\nVous pourrez vous y promener, visiter une exposition, fl\u00e2ner le long des chemins en d\u00e9couvrant ces \u00e9co-syst\u00e8mes.\r\n\r\nAu coeur du parc, ce trouve une ancienne ferme-ch\u00e2teau devenu le lieu des c\u00e9r\u00e9monies officielles de mariages des Molenbeekois mais \u00e9galement un espace culturel accueillant des expositions, concerts, spectacles, march\u00e9 artisanal (March\u00e9 de No\u00ebl), ...","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Karreveldkasteel","address_street_name":"Jean de la Hoeselaan","address_street_number":"3","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1080","address_city":"Sint-Jans-Molenbeek","address_line1":"Jean de la Hoeselaan, 3","address_line2":"1080 Sint-Jans-Molenbeek","description_web":"\r\nHet Karreveld is niet alleen een park, maar ook een \"kasteelboerderij\" die een culturele ruimte is geworden in het midden van het park, omringd door bomen en een vijver.\r\n\r\nU kunt er rondwandelen, een tentoonstelling bezoeken, over de paden wandelen en deze ecosystemen ontdekken.\r\n\r\nIn het hart van het park bevindt zich een voormalige boerderij-kasteel waar offici\u00eble huwelijksceremonies van de Molenbeekenaars plaatsvinden, maar ook een culturele ruimte waar tentoonstellingen, concerten, voorstellingen, een ambachtsmarkt (kerstmarkt), ... plaatsvinden.\r\n\r\nOm (opnieuw) ontdekt te word","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Ch\u00e2teau du Karreveld","address_street_name":"Avenue Jean de la Hoese","address_street_number":"3","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Avenue Jean de la Hoese, 3","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"","description_print":"","booking_url":null,"sort_order":n