gr=&post=projects&sa=872","email":"reservation@espacemagh.be","phone_contact":"+32 2 274 05 10","phone_booking":"+32 2 274 05 10","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50005305"},"it":{"name":"Harrisa, contes et histoires piquantes de Tunisie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.espacemagh.be\/projects\/harissa-contes-et-histoires-piquantes-de-tunisie\/?pr=18069&gr=&post=projects&sa=872","email":"reservation@espacemagh.be","phone_contact":"+32 2 274 05 10","phone_booking":"+32 2 274 05 10","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50005305"},"cn":{"name":"Harrisa, contes et histoires piquantes de Tunisie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.espacemagh.be\/projects\/harissa-contes-et-histoires-piquantes-de-tunisie\/?pr=18069&gr=&post=projects&sa=872","email":"reservation@espacemagh.be","phone_contact":"+32 2 274 05 10","phone_booking":"+32 2 274 05 10","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50005305"},"fr":{"name":"Harrisa, contes et histoires piquantes de Tunisie","shortdescr":"Entre contes traditionnels et histoires de tous les jours, Ahmed Hafiz nous fait revivre, avec dr\u00f4lerie et \u00e9motion, la Tunisie de son enfance. Une Tunisie o\u00f9 les tunisiens, musulmans, juifs et chr\u00e9tiens, partageaient avec une convivialit\u00e9 toute m\u00e9diterran\u00e9enne des histoires aussi piquantes que la harissa.","longdescr":"Entre contes traditionnels et histoires de tous les jours, Ahmed Hafiz nous fait revivre, avec dr\u00f4lerie et \u00e9motion, la Tunisie de son enfance. Une Tunisie o\u00f9 les tunisiens, musulmans, juifs et chr\u00e9tiens, partageaient avec une convivialit\u00e9 toute m\u00e9diterran\u00e9enne des histoires aussi piquantes que la harissa.\n\nIl embarque son public dans un univers cont\u00e9 qu\u2019il puise dans la tradition tunisienne et finit par d\u00e9boucher, avec \u00ab Viva l\u2019Azouza \u00bb, une \u00e9pop\u00e9e burlesque, dans le Tunis d\u2019aujourd\u2019hui, loin de l\u2019image idyllique des circuits touristiques organis\u00e9s, des h\u00f4tels climatis\u00e9s et des plages de sable fin.\n\nTunisien de Belgique ou Belge de Tunisie, Ahmed Hafiz parle avec affection du pays o\u00f9 sont ses racines anciennes avec le point de vue de celui qui a appris \u00e0 \u00e9quilibrer une vision n\u00e9e de deux cultures.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.espacemagh.be\/projects\/harissa-contes-et-histoires-piquantes-de-tunisie\/?pr=18069&gr=&post=projects&sa=872","email":"reservation@espacemagh.be","phone_contact":"+32 2 274 05 10","phone_booking":"+32 2 274 05 10","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50005305"},"sp":{"name":"Harrisa, contes et histoires piquantes de Tunisie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.espacemagh.be\/projects\/harissa-contes-et-histoires-piquantes-de-tunisie\/?pr=18069&gr=&post=projects&sa=872","email":"reservation@espacemagh.be","phone_contact":"+32 2 274 05 10","phone_booking":"+32 2 274 05 10","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50005305"},"nl":{"name":"Harrisa, contes et histoires piquantes de Tunisie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.espacemagh.be\/projects\/harissa-contes-et-histoires-piquantes-de-tunisie\/?pr=18069&gr=&post=projects&sa=872","email":"reservation@espacemagh.be","phone_contact":"+32 2 274 05 10","phone_booking":"+32 2 274 05 10","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50005305"}},"place":{"id":247296,"translations":{"de":{"name":"Centre culturel Espace Magh asbl","address_street_name":"Rue du Poin\u00e7on","address_street_number":null,"address_street_box":null,