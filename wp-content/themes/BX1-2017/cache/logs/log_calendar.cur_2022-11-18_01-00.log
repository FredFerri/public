Fascinant petit livre, caricatural, infiniment cruel, mais aussi, nostalgique, tendre, \u00e0 sa fa\u00e7on.","performers":"Du Th\u00e9\u00e2tre du Tilleul. Interpr\u00e9tation Carine Ermans, Mark Elst, Alain Gilbert. Mise en sc\u00e8ne Margarete Jennes. Ombres Carine Ermans et Mark Elst. Musique Alain Gilbert. D\u00e9cor Alexandre Obolensky. Affiche Carine Ermans. Avec l\u2019aide de, pour la r\u00e9alisation des ombres, Marie de Patoul et Arnaud Marchant.","boxoffice_url":null,"website":"http:\/\/www.roseraie.org","email":"secretariat@roseraie.org","phone_contact":null,"phone_booking":"+32 2 376 46 45","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.542032"},"nl":{"name":"Crasse-Tignasse","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.542032"},"en":{"name":"Crasse-Tignasse","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.542032"},"de":{"name":"Crasse-Tignasse","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.542032"},"it":{"name":"Crasse-Tignasse","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.542032"},"sp":{"name":"Crasse-Tignasse","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.542032"},"pt":{"na