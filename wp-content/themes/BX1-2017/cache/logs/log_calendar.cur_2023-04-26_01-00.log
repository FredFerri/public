e  est la fa\u00e7ade du Bozar. Et oui, c\u2019est bien une fa\u00e7ade sign\u00e9e Horta. Plus \u00e9tonnant encore, c\u2019est lui qui \u00e9labore la bien connue Gare-Centrale de notre ch\u00e8re Bruxelles. \r\n\r\nVisite guid\u00e9e organis\u00e9e sur mesure pour vous et votre groupe.\r\nPrix sur demande, possibilit\u00e9 d'y inclure la visite d'un int\u00e9rieur, d'adapter en formule teambuilding et\/ou encore avec nos guides costum\u00e9s...","performers":null,"boxoffice_url":null,"website":"http:\/\/www.itineraires.be","email":"info@itineraires.be","phone_contact":null,"phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.546251"},"nl":{"name":"Art Nouveau et Art D\u00e9co \u00e0 Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.itineraires.be","email":"info@itineraires.be","phone_contact":null,"phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.546251"},"en":{"name":"Art Nouveau et Art D\u00e9co \u00e0 Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.itineraires.be","email":"info@itineraires.be","phone_contact":null,"phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.546251"},"de":{"name":"Art Nouveau et Art D\u00e9co \u00e0 Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.itineraires.be","email":"info@itineraires.be","phone_contact":null,"phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.546251"},"it":{"name":"Art Nouveau et Art D\u00e9co \u00e0 Bruxelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.itineraires.be","email":"info@itineraires.be","phone_contact":null,"phone_booking":"+32 496 38 85 94","a