],"de":["Comic","Highlight"],"it":["Fumetti","Highlight"],"sp":["C\u00f3mics","Highlight"],"pt":[null,null],"cn":[null,null]}},"tags":[],"accessibilities":{"list":[255,259,263,265],"translations":{"fr":["Accessible","Chien d'assistance","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9"],"nl":["Toegankelijk","Assistentiehonden","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet"],"en":["Accessible","Assistance dogs","Accessible to pedestrians with mobility aids","Adapted toilet"],"de":["Barrierefrei","Assistenzhund","Barrierefrei f\u00fcr Fu\u00dfg\u00e4nger mit Gehhilfe","Barrierefreies WC"],"it":["Accessibile","Cane guida","Accessibile ai pedoni con supporti","WC idoneo"],"sp":["Habilitado","Perros gu\u00eda","Habilitado para peatones con aud\u00edfonos","Ba\u00f1os adaptados"],"pt":[null,null,null,null],"cn":[null,null,null,null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2023-07-08T03:06:41+02:00","published_at":"2022-06-29T16:34:37+02:00","backoffice_id":257358,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.36802019413078},{"id":550872,"date_start":"2023-04-07","date_end":"2023-10-01","date_next":"2023-07-08","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung","it":"Esposizioni","sp":"Exhibici\u00f3n","pt":null,"cn":null}},"others":{"list":[36,47],"translations":{"fr":["Mus\u00e9es et art centers","Bande dessin\u00e9e"],"nl":["Musea en kunstcentra","Stripverhaal"],"en":["Museums and art centers","Comicstrip"],"de":["Museen & Kunstzentren","Comics"],"it":["Musei e centri artistici","Fumetti"],"sp":["Museos y centros de arte","C\u00f3mics"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"ODYSS\u00c9E aux origines de Blake et Mortimer","shortdescr":null,"longdescr":"L\u2019exposition ODYSS\u00c9E projette de replacer l\u2019\u0153uvre patrimoniale Blake et Mortimer dans son contexte \u00e0 la fois esth\u00e9tique, culturel et historique afin que le grand public en d\u00e9couvre toutes les facettes.\r\n\r\nLe parcours de l\u2019exposition sera jalonn\u00e9 de cinq th\u00e9matiques pour rythmer l\u2019exp\u00e9rience : Un Hom\u00e8re moderne, Le Th\u00e9\u00e2tre du Monde, Le Rayon de la Mort, La Terre Inconnue et L\u2019\u00c9ternel Retour.\r\n\r\nAu travers de planches et documents originaux, \u00e9videmment de E.P. Jacobs mais aussi d\u2019Etienne Schr\u00e9der et Christian Cailleux, d\u00e9couvrez comment le tr\u00e8s fameux album Le Rayon U d\u2019Edgar P. Jacobs s\u2019est positionn\u00e9 comme l\u2019un des cha\u00eenons manquants entre les comics \u00e0 l\u2019am\u00e9ricaine et la BD franco-belge.","performers":"Eric Dubois (Commissaire de l\u2019exposition)\r\nEn collaboration avec la Fondation E.P. Jacobs et les Editions Blake & Mortimer","boxoffice_url":null,"website":"http:\/\/www.cbbd.be","email":"visit@cbbd.be","phone_contact":null,"phone_booking":"+32 2 219 19 80","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.550872"},"nl":{"name":"ODYSSEE naar de oorsprong van Blake en Mortimer","shortdescr":null,"longdescr":"ODYSSEE is een tentoonstelling die het striperfgoed van Blake en Mortimer in zijn esthetische, culturele en historische context plaatst, zodat het grote publiek het werk in al zijn facetten kan (her-)ontdekken.\r\n\r\nVijf thema's vormen de rode draad: Een moderne Homerus, De wereld, een schouwtoneel, De straal van de dood, Terra Incognita en De Eeuwige Terugkeer. Terwijl je langs originele platen en documenten wandelt, uiteraard van E.P. Jacobs, maar ook van Etienne Schr\u00e9der en Christian Cailleux, ontdek je hoe het beroemde album De \"U\" straal\u00a0van Edgar P. Jacobs \u00e9\u00e9n van de ontbrekende schakels vormt tussen de Amerikaanse comics en de Frans-Belgische strips.","performers":"Eric Dubois (Curator)\r\nIn samenwerking met de E.P. Jacobs Stichting en Uitgeverij Blake & Mortimer","boxoffice_url":null,"website":"http:\/\/www.stripmuseum.be","email":"visit@stripmuseum.be","phone_contact":null,"phone_booking":"+32 2 219 19 80","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.550872"},"en":{"name":"ODDYSEY to the origins of Blake and Mortimer","shortdescr":null,"longdescr":"ODYSSEY\u00a0is an exhibition that places the heritage work of Blake and Mortimer in its aesthetic, cultural and historical context with the purpose to be (re)discovered by the public in all its facets. Five themes run throughout the exhibition: A Modern Homer, The world, a theatre, The Ray of Death, Terra Incognita and The Eternal Return.\u00a0\r\n\r\nWhile walking by the original panels and documents, of course by E.P. Jacobs, but as well created by Etienne Schr\u00e9der and Christian Cailleux, you discover how the famous album \u201cThe U Ray\u201d\u00a0is one of the missing links between American comics and the Franco-Belgian comic album.\r\n\r\n\u00a0\r\n\r\nCurator: Eric Dubois\r\n\r\nIn cooperation with the E.P. Jacobs Foundation and Editions Blake & Mortimer","performers":"Eric Dubois (Curator)\r\nIn cooperation with the E.P. Jacobs Foundation and Editions Blake & Mortimer","boxoffice_url":null,"website":"http:\/\/www.comicscenter.net\/en\/home","email":"visit@comicscenter.net","phone_contact":null,"phone_booking":"+32 2 219 19 80","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.550872"},"de":{"name":"ODYSSEE naar de oorsprong van Blake en Mortimer","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.cbbd.be","email":"visit@cbbd.be","phone_contact":null,"phone_booking":"+32 2 219 19 80","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.550872"},"it":{"name":"ODYSSEE naar de oorsprong van Blake en Mortimer","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.cbbd.be","email":"visit@cbbd.be","phone_contact":null,"phone_booking":"+32 2 219 19 80","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.550872"},"sp":{"name":"ODYSSEE naar de oorsprong van Blake en Mortimer","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.cbbd.be","email":"visit@cbbd.be","phone_contact":null,"phone_booking":"+32 2 219 19 80","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.550872"},"pt":{"name":"ODYSSEE naar de oorsprong van Blake en Mortimer","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.cbbd.be","email":"visit@cbbd.be","phone_contact":null,"phone_booking":"+32 2 219 19 80","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.550872"},"cn":{"name":"ODYSSEE naar de oorsprong van Blake en Mortimer","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.cbbd.be","email":"visit@cbbd.be","phone_contact":null,"phone_booking":"+32 2 219 19 80","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.550872"}},"place":{"id":202864,"translations":{"fr":{"name":"Mus\u00e9e de la Bande Dessin\u00e9e (Centre Belge de la Bande Dessin\u00e9e)","address_street_name":"Rue des Sables","address_street_number":"20","address_street_box":null,"email":"visit@cbbd.be","website":"http:\/\/www.cbbd.be","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Sables, 20","address_line2":"1000 Bruxelles","description_web":"Un monde merveilleux o\u00f9 la BD est Reine\r\nAttraction incontournable situ\u00e9e au c\u0153ur de Bruxelles, le mus\u00e9e de la BD met \u00e0 l'honneur le 9e Art depuis plus de 30 ans.\r\nLes expositions permanentes r\u00e9guli\u00e8rement renouvel\u00e9es et un vaste programme d'expositions temporaires am\u00e8nent les visiteurs \r\n\u00e0 d\u00e9couvrir les innombrables facettes de la bande dessin\u00e9e. Les Schtroumpfs ouvrent la voie vers d'autres aventures, \u00e0 la rencontre d'un monde dont la cr\u00e9ativit\u00e9 n'a aucune limite.\r\nDe nombreuses planches originales, des documents in\u00e9dits, des reconstitutions 3D et des jeux sont ainsi rassembl\u00e9s pour vous permettre de passer un bon moment \r\net ravir tous les amateurs et passionn\u00e9s du Neuvi\u00e8me Art de tous \u00e2ges. La dur\u00e9e de la visite est estim\u00e9e \u00e0 environ 1 heure 30, que vous pourrez ensuite poursuivre \u00e0 la Brasserie Horta.\r\nMagnifi\u00e9 par un exceptionnel cadre Art Nouveau con\u00e7u par Victor Horta, le Mus\u00e9e de la Bande Dessin\u00e9e est tout autant un hommage aux pionniers qu'un regard sur la BD actuelle.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Stripmuseum (Belgisch Stripcentrum)","address_street_name":"Zandstraat","address_street_number":"20","address_street_box":null,"email":"visit@stripmuseum.be","website":"http:\/\/www.stripmuseum.be","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Zandstraat, 20","address_line2":"1000 Brussel","description_web":"Een wondere wereld vol strips\r\n\r\nHet Stripmuseum is een ontmoetingsplek voor alle stripliefhebbers in hartje Brussel.\r\nAan de hand van permanente tentoonstellingen \u2013 die regelmatig vernieuwd worden \u2013 en een afwisselend programma van tijdelijke expo's kan je er \r\nals bezoeker kennismaken met de talrijke facetten van het stripverhaal.\r\nDe Smurfen nemen je mee naar een land vol avonturen, waar de creativiteit geen grenzen kent.\r\nTalrijke originele platen, nooit eerder geziene documenten, decors in 3D en ludieke elementen worden verzameld \r\nom alle fans en liefhebbers van de Negende Kunst te kunnen boeien!\r\nHet uitzonderlijke art nouveau-gebouw van Victor Horta geeft een bezoek nog een extra dimensie. \r\nHet Stripmuseum brengt tegelijk een hommage aan de klassiekers van het medium en een blik op het hedendaagse stripverhaal.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Comic Strip Museum  (Centre Belge de la Bande Dessin\u00e9e)","address_street_name":"Rue des Sables","address_street_number":"20","address_street_box":null,"email":"visit@comicscenter.net","website":"http:\/\/www.comicscenter.net\/en\/home","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue des Sables, 20","address_line2":"1000 Brussels","description_web":"A world full of comics\r\n\r\nAn accomplished attraction located in the heart of Brussels, the Comics Art Museum has been honouring the creators and heroes of the 9th Art for 30 years.\r\nThe regularly renewed permanent exhibitions and a diversified programme of temporary exhibitions \r\nenable visitors to discover the countless aspects of comics art. \r\nFamous characters lead the way towards new adventures, an encounter with a world where creativity has no limits.\r\nEnhanced by an exceptional Art Nouveau home designed by Victor Horta, the Comics Art Museum is just as much a tribute \r\nto the pioneers as a glimpse of contemporary comics art.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Comic-Museum (Centre Belge de la Bande Dessin\u00e9e)","address_street_name":"Rue des Sables","address_street_number":"20","address_street_box":null,"email":"visit@cbbd.be","website":"https:\/\/www.comicscenter.net\/en\/other-languages","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Sables, 20","address_line2":"1000 Bruxelles","description_web":"Br\u00fcssel als Comic-Hauptstadt g\u00f6nnt sich den Luxus eines eigenen Comic-Museums - das \u201eCentre Belge de la Bande Dessin\u00e9e\u201c. In einem eindrucksvollen Jugendstil-Bau aus der Feder von Victor Horta wird belgische und internationale Comic-Kunst pr\u00e4sentiert. Willkommen im Reich der Schl\u00fcmpfe, bei Tim und Struppi, Lucky Luke, Spirou, Gaston Lagaffe und all den anderen Comic-Helden!\r\n\r\nComic-Kunst und Jugendstilarchitektur: Der ber\u00fchmte Jugendstilarchitekt Victor Horta entwarf 1903, auf dem H\u00f6hepunkt seines Schaffens, Pl\u00e4ne f\u00fcr ein weitl\u00e4ufiges Bauwerk in Br\u00fcssel. Nach der Renovierung 1989 lie\u00df sich in den R\u00e4umen, die in allen Bereichen durch Jugendstilelemente gepr\u00e4gt sind, das \u201eCentre Belge de la Bande Dessin\u00e9e\", das Belgische Comiczentrum nieder, bei dem sich auf einer Fl\u00e4che von mehr als 4000 m\u00b2 - von den Urspr\u00fcngen bis hin zu avantgardistischen Werken - alles um Comics dreht.\r\n\r\nBelgische Comic-Kunst in all ihren Formen: Ausstellungen, Konferenzen, Kreativ-Workshops, Veranstaltungen, eine eigene Comic-Bibliothek mit Dokumentationszentrum sowie eine gut sortierte Buchhandlung bilden ein vielseitiges und buntes Comicangebot. Zentrale Themen der Dauerausstellung sind die Erfindung der Comic-Kunst, die Formen und die Entwicklung der Comic-Kunst sowie verschiedene Schwerpunkt auf belgische Comic-K\u00fcnstler von Peyo, dem Vater der Schl\u00fcmpfe bis Herg\u00e9, dem Erfinder von Tim & Struppi.\r\n\r\nComic-Fans auf zum Br\u00fcsseler Comic-Mekka!\r\n\r\nGe\u00f6ffnet von Montag bis Sonntag in Juli und August.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Museo del Fumetto","address_street_name":"Rue des Sables","address_street_number":"20","address_street_box":null,"email":"visit@comicscenter.net","website":"https:\/\/www.comicscenter.net\/en\/other-languages","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Sables, 20","address_line2":"1000 Bruxelles","description_web":"Il Museo del Fumetto CBBD, situato nel cuore storico di Bruxelles, riunisce su pi\u00f9 di 4.000 m\u00b2 tutto ci\u00f2 che riguarda il fumetto. Ospitato in un edificio tempio dell'Art Nouveau disegnato da Victor Horta, il museo \u00e8 il regno di celebri eroi dei fumetti belgi: Tintin, i Puffi, Lucky Luke, Gaston Lagaffe, Blake et Mortimer, Marsupilami... Le esposizioni organizzate, la biblioteca e il centro di documentazione, non solo rendono il museo vivo e dinamico, ma sono veri e propri centri di documentazione sul fumetto il cuicatalogo \u00e8 accessibile on-line. Il centro belga del fumetto organizza conferenze, laboratori creativi ed animazioni, ecc.\r\n\r\n\r\nAperto i giorni festivi eccetto il 25\/12 e 01\/01. Il Centro Belga del Fumetto diverse formule di visita: la visita guidata del museo, quella del Percorso del Fumetto o quella del museo Marc Sleen. Il museo, anzi il centro belga del fumetto-CBBD ospita anche una brasserie dove potete respirare l'inconfondibile atmosfera di Bruxelles.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Centro belga del c\u00f3mic (CBBD)","address_street_name":"Rue des Sables","address_street_number":"20","address_street_box":null,"email":"visit@comicscenter.net","website":"https:\/\/www.comicscenter.net\/en\/other-languages","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Sables, 20","address_line2":"1000 Bruxelles","description_web":"Ubicado en el centro de Bruselas, en un edificio Art Nouveau construido por Victor Horta en 1906, el CBBD abri\u00f3 sus puertas el 6 de octubre de 1989. \r\n\r\nEn pocos a\u00f1os, este museo se ha convertido en una de las principales atracciones de Bruselas. \r\n\r\nCada a\u00f1o, m\u00e1s de 200.000 visitantes recorren las exposiciones permanentes y temporales que se celebran en m\u00e1s de 4.000 m 2. \r\n\r\nAunque las exposiciones contribuyen a convertir este templo en un lugar viviente, din\u00e1mico y atrayente, esta herramienta al servicio de la promoci\u00f3n del c\u00f3mic constituye un centro de documentaci\u00f3n moderno, con un cat\u00e1logo accesible online. \r\n\r\nTambi\u00e9n se llevan a cabo conferencias y talleres creativos.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"O Centro Belga da Banda Desenhada","address_street_name":"Rue des Sables","address_street_number":"20","address_street_box":null,"email":"visit@cbbd.be","website":"http:\/\/www.cbbd.be","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Sables, 20","address_line2":"1000 Bruxelles","description_web":"Atra\u00e7\u00e3o incontorn\u00e1vel situada no centro de Bruxelas, o museu da BD comemora mais de 25 anos de autores e her\u00f3is da 9.\u00aa arte.\r\nAs exposi\u00e7\u00f5es permanentes regularmente renovadas e um vasto programa de exposi\u00e7\u00f5es tempor\u00e1rias levam os visitantes a descobrir as in\u00fameras facetas da banda desenhada. Tintim e os Estrumpfes abrem a porta a outras aventuras, ao encontro de um mundo onde a criatividade n\u00e3o tem limites. \r\nAmpliado por uma moldura invulgar Arte Nouveau concebida por Victor Horta, o Museu da Banda Desenhada \u00e9 tanto uma homenagem aos pioneiros que um olhar sobre a BD atual.\r\nAberto todos os dias das 10 \u00e0s 18 horas.\r\nEntrada gratuita apenas com o Brussels Card \u201c100masters\u201d","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"The Belgian Comic Strip Center","address_street_name":"Rue des Sables","address_street_number":"20","address_street_box":null,"email":"visit@cbbd.be","website":"http:\/\/www.cbbd.be","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Sables, 20","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":[],"zones":{"list":[19],"translations":{"fr":["Centre"],"nl":["Centrum"],"en":["Centre"],"de":["Zentrum"],"it":["Centro"],"sp":["Centro"],"pt":[null],"cn":[null]}},"neca":null,"facebook_id":null,"backoffice_id":405,"location":{"lat":50.85107181,"lon":4.36006874},"region":"brussels","last_updated_at":"2023-07-08T02:38:05+02:00","published_at":"2013-10-19T01:13:30+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":202864,"translations":{"fr":{"name":"Mus\u00e9e de la Bande Dessin\u00e9e (Centre Belge de la Bande Dessin\u00e9e)","address_street_name":"Rue des Sables","address_street_number":"20","address_street_box":null,"email":"visit@cbbd.be","website":"http:\/\/www.cbbd.be","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Sables, 20","address_line2":"1000 Bruxelles","description_web":"Un monde merveilleux o\u00f9 la BD est Reine\r\nAttraction incontournable situ\u00e9e au c\u0153ur de Bruxelles, le mus\u00e9e de la BD met \u00e0 l'honneur le 9e Art depuis plus de 30 ans.\r\nLes expositions permanentes r\u00e9guli\u00e8rement renouvel\u00e9es et un vaste programme d'expositions temporaires am\u00e8nent les visiteurs \r\n\u00e0 d\u00e9couvrir les innombrables facettes de la bande dessin\u00e9e. Les Schtroumpfs ouvrent la voie vers d'autres aventures, \u00e0 la rencontre d'un monde dont la cr\u00e9ativit\u00e9 n'a aucune limite.\r\nDe nombreuses planches originales, des documents in\u00e9dits, des reconstitutions 3D et des jeux sont ainsi rassembl\u00e9s pour vous permettre de passer un bon moment \r\net ravir tous les amateurs et passionn\u00e9s du Neuvi\u00e8me Art de tous \u00e2ges. La dur\u00e9e de la visite est estim\u00e9e \u00e0 environ 1 heure 30, que vous pourrez ensuite poursuivre \u00e0 la Brasserie Horta.\r\nMagnifi\u00e9 par un exceptionnel cadre Art Nouveau con\u00e7u par Victor Horta, le Mus\u00e9e de la Bande Dessin\u00e9e est tout autant un hommage aux pionniers qu'un regard sur la BD actuelle.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Stripmuseum (Belgisch Stripcentrum)","address_street_name":"Zandstraat","address_street_number":"20","address_street_box":null,"email":"visit@stripmuseum.be","website":"http:\/\/www.stripmuseum.be","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Zandstraat, 20","address_line2":"1000 Brussel","description_web":"Een wondere wereld vol strips\r\n\r\nHet Stripmuseum is een ontmoetingsplek voor alle stripliefhebbers in hartje Brussel.\r\nAan de hand van permanente tentoonstellingen \u2013 die regelmatig vernieuwd worden \u2013 en een afwisselend programma van tijdelijke expo's kan je er \r\nals bezoeker kennismaken met de talrijke facetten van het stripverhaal.\r\nDe Smurfen nemen je mee naar een land vol avonturen, waar de creativiteit geen grenzen kent.\r\nTalrijke originele platen, nooit eerder geziene documenten, decors in 3D en ludieke elementen worden verzameld \r\nom alle fans en liefhebbers van de Negende Kunst te kunnen boeien!\r\nHet uitzonderlijke art nouveau-gebouw van Victor Horta geeft een bezoek nog een extra dimensie. \r\nHet Stripmuseum brengt tegelijk een hommage aan de klassiekers van het medium en een blik op het hedendaagse stripverhaal.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Comic Strip Museum  (Centre Belge de la Bande Dessin\u00e9e)","address_street_name":"Rue des Sables","address_street_number":"20","address_street_box":null,"email":"visit@comicscenter.net","website":"http:\/\/www.comicscenter.net\/en\/home","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue des Sables, 20","address_line2":"1000 Brussels","description_web":"A world full of comics\r\n\r\nAn accomplished attraction located in the heart of Brussels, the Comics Art Museum has been honouring the creators and heroes of the 9th Art for 30 years.\r\nThe regularly renewed permanent exhibitions and a diversified programme of temporary exhibitions \r\nenable visitors to discover the countless aspects of comics art. \r\nFamous characters lead the way towards new adventures, an encounter with a world where creativity has no limits.\r\nEnhanced by an exceptional Art Nouveau home designed by Victor Horta, the Comics Art Museum is just as much a tribute \r\nto the pioneers as a glimpse of contemporary comics art.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Comic-Museum (Centre Belge de la Bande Dessin\u00e9e)","address_street_name":"Rue des Sables","address_street_number":"20","address_street_box":null,"email":"visit@cbbd.be","website":"https:\/\/www.comicscenter.net\/en\/other-languages","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Sables, 20","address_line2":"1000 Bruxelles","description_web":"Br\u00fcssel als Comic-Hauptstadt g\u00f6nnt sich den Luxus eines eigenen Comic-Museums - das \u201eCentre Belge de la Bande Dessin\u00e9e\u201c. In einem eindrucksvollen Jugendstil-Bau aus der Feder von Victor Horta wird belgische und internationale Comic-Kunst pr\u00e4sentiert. Willkommen im Reich der Schl\u00fcmpfe, bei Tim und Struppi, Lucky Luke, Spirou, Gaston Lagaffe und all den anderen Comic-Helden!\r\n\r\nComic-Kunst und Jugendstilarchitektur: Der ber\u00fchmte Jugendstilarchitekt Victor Horta entwarf 1903, auf dem H\u00f6hepunkt seines Schaffens, Pl\u00e4ne f\u00fcr ein weitl\u00e4ufiges Bauwerk in Br\u00fcssel. Nach der Renovierung 1989 lie\u00df sich in den R\u00e4umen, die in allen Bereichen durch Jugendstilelemente gepr\u00e4gt sind, das \u201eCentre Belge de la Bande Dessin\u00e9e\", das Belgische Comiczentrum nieder, bei dem sich auf einer Fl\u00e4che von mehr als 4000 m\u00b2 - von den Urspr\u00fcngen bis hin zu avantgardistischen Werken - alles um Comics dreht.\r\n\r\nBelgische Comic-Kunst in all ihren Formen: Ausstellungen, Konferenzen, Kreativ-Workshops, Veranstaltungen, eine eigene Comic-Bibliothek mit Dokumentationszentrum sowie eine gut sortierte Buchhandlung bilden ein vielseitiges und buntes Comicangebot. Zentrale Themen der Dauerausstellung sind die Erfindung der Comic-Kunst, die Formen und die Entwicklung der Comic-Kunst sowie verschiedene Schwerpunkt auf belgische Comic-K\u00fcnstler von Peyo, dem Vater der Schl\u00fcmpfe bis Herg\u00e9, dem Erfinder von Tim & Struppi.\r\n\r\nComic-Fans auf zum Br\u00fcsseler Comic-Mekka!\r\n\r\nGe\u00f6ffnet von Montag bis Sonntag in Juli und August.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Museo del Fumetto","address_street_name":"Rue des Sables","address_street_number":"20","address_street_box":null,"email":"visit@comicscenter.net","website":"https:\/\/www.comicscenter.net\/en\/other-languages","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Sables, 20","address_line2":"1000 Bruxelles","description_web":"Il Museo del Fumetto CBBD, situato nel cuore storico di Bruxelles, riunisce su pi\u00f9 di 4.000 m\u00b2 tutto ci\u00f2 che riguarda il fumetto. Ospitato in un edificio tempio dell'Art Nouveau disegnato da Victor Horta, il museo \u00e8 il regno di celebri eroi dei fumetti belgi: Tintin, i Puffi, Lucky Luke, Gaston Lagaffe, Blake et Mortimer, Marsupilami... Le esposizioni organizzate, la biblioteca e il centro di documentazione, non solo rendono il museo vivo e dinamico, ma sono veri e propri centri di documentazione sul fumetto il cuicatalogo \u00e8 accessibile on-line. Il centro belga del fumetto organizza conferenze, laboratori creativi ed animazioni, ecc.\r\n\r\n\r\nAperto i giorni festivi eccetto il 25\/12 e 01\/01. Il Centro Belga del Fumetto diverse formule di visita: la visita guidata del museo, quella del Percorso del Fumetto o quella del museo Marc Sleen. Il museo, anzi il centro belga del fumetto-CBBD ospita anche una brasserie dove potete respirare l'inconfondibile atmosfera di Bruxelles.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Centro belga del c\u00f3mic (CBBD)","address_street_name":"Rue des Sables","address_street_number":"20","address_street_box":null,"email":"visit@comicscenter.net","website":"https:\/\/www.comicscenter.net\/en\/other-languages","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Sables, 20","address_line2":"1000 Bruxelles","description_web":"Ubicado en el centro de Bruselas, en un edificio Art Nouveau construido por Victor Horta en 1906, el CBBD abri\u00f3 sus puertas el 6 de octubre de 1989. \r\n\r\nEn pocos a\u00f1os, este museo se ha convertido en una de las principales atracciones de Bruselas. \r\n\r\nCada a\u00f1o, m\u00e1s de 200.000 visitantes recorren las exposiciones permanentes y temporales que se celebran en m\u00e1s de 4.000 m 2. \r\n\r\nAunque las exposiciones contribuyen a convertir este templo en un lugar viviente, din\u00e1mico y atrayente, esta herramienta al servicio de la promoci\u00f3n del c\u00f3mic constituye un centro de documentaci\u00f3n moderno, con un cat\u00e1logo accesible online. \r\n\r\nTambi\u00e9n se llevan a cabo conferencias y talleres creativos.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"O Centro Belga da Banda Desenhada","address_street_name":"Rue des Sables","address_street_number":"20","address_street_box":null,"email":"visit@cbbd.be","website":"http:\/\/www.cbbd.be","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Sables, 20","address_line2":"1000 Bruxelles","description_web":"Atra\u00e7\u00e3o incontorn\u00e1vel situada no centro de Bruxelas, o museu da BD comemora mais de 25 anos de autores e her\u00f3is da 9.\u00aa arte.\r\nAs exposi\u00e7\u00f5es permanentes regularmente renovadas e um vasto programa de exposi\u00e7\u00f5es tempor\u00e1rias levam os visitantes a descobrir as in\u00fameras facetas da banda desenhada. Tintim e os Estrumpfes abrem a porta a outras aventuras, ao encontro de um mundo onde a criatividade n\u00e3o tem limites. \r\nAmpliado por uma moldura invulgar Arte Nouveau concebida por Victor Horta, o Museu da Banda Desenhada \u00e9 tanto uma homenagem aos pioneiros que um olhar sobre a BD atual.\r\nAberto todos os dias das 10 \u00e0s 18 horas.\r\nEntrada gratuita apenas com o Brussels Card \u201c100masters\u201d","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"The Belgian Comic Strip Center","address_street_name":"Rue des Sables","address_street_number":"20","address_street_box":null,"email":"visit@cbbd.be","website":"http:\/\/www.cbbd.be","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Sables, 20","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":null,"facebook_id":null,"backoffice_id":405,"location":{"lat":50.85107181,"lon":4.36006874},"region":"brussels","last_updated_at":"2023-07-08T02:38:05+02:00","published_at":"2013-10-19T01:13:30+02:00","import_origin":null,"ext