1:35:27+02:00","published_at":"2021-06-07T17:01:27+02:00","backoffice_id":232749,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":0.51471424920009},{"id":532312,"date_start":"2022-05-03","date_end":"2022-05-29","date_next":"2022-05-18","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":true,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[36,39],"translations":{"fr":["Mus\u00e9es et art centers","Photographie"],"nl":["Musea en kunstcentra","Fotografie"],"en":["Museums and art centers","Photography"]}}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Une fuite sans fin, (jusqu\u2019) en Europe","shortdescr":"Une fuite sans fin, (jusqu\u2019) en Europe : Une exposition de photos au MigratieMuseumMigration sur les routes des r\u00e9fugi\u00e9s.","longdescr":"Cette exposition de photos se concentre sur deux voies d\u2019\u00e9vasion : la route des Balkans et la route passant par le sud de l\u2019Italie et Vintimille. Avec leurs ramifications : Calais, Dunkerque et Zeebrugge.\r\n\r\nLes photos sont toutes prises par des journalistes qui \u00e9taient sur place et sont des \u0153uvres originales :\r\n\r\nFranky Verdickt, Elio Germani, Virgilio Martini, Francesco Campisi, Lieven Soete et Fernand Marechal.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.migratiemuseummigration.be","email":"museum@foyer.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/532312.html"},"nl":{"name":"Eindeloos op de vlucht, naar (en in) Europa","shortdescr":"Eindeloos op de vlucht, naar (en in) Europa: een fototentoonstelling in het MigratieMuseumMigration over vluchtroutes.","longdescr":"In deze fototentoonstelling worden vooral twee vluchtroutes via foto\u2019s in beeld gebracht: de Balkanroute en de route via Zuid-Itali\u00eb en Ventimiglia. Met hun uitlopers: Calais, Dunkerque en Zeebrugge.\r\n\r\nDe foto\u2019s zijn afkomstig, telkens, van reporters die ter plaatse waren en zijn origineel werk:\r\n\r\nFranky Verdickt, Elio Germani, Virgilio Martini, Francesco Campisi, Lieven Soete, Fernand Marechal.","performers":"Franky Verdickt, Elio Germani, Virgilio Martini, Francesco Campisi, Lieven Soete, Fernand Marechal.","boxoffice_url":null,"website":null,"email":null,"phone_contact":"+32 2 609 55 61","phone_booking":"+32 2 609 55 61","agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/532312.html"},"en":{"name":"The endless refugee routes in(to) Europe","shortdescr":"The endless refugee routes in(to) Europe: A photo exhibition in the MigratieMuseumMigration about refugee routes.","longdescr":"In this photo exhibition, two refugee routes in particular are portrayed through photographs: the Balkan route and the route via southern Italy and Ventimiglia. With their offshoots: Calais, Dunkerque and Zeebrugge.\r\n\r\nThe photos are all taken by reporters who were there and are original work:\r\n\r\nFranky Verdickt, Elio Germani, Virgilio Martini, Francesco Campisi, Lieven Soete, Fernand Marechal.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/532312.html"},"de":{"name":"Eindeloos op de vlucht, naar (en in) Europa","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/532312.html"},"it":{"name":"Eindeloos op de vlucht, naar (en in) Europa","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/532312.html"},"sp":{"name":"Eindeloos op de vlucht, naar (en in) Europa","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/532312.html"},"pt":{"name":"Eindeloos op de vlucht, naar (en in) Europa","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/532312.html"},"cn":{"name":"Eindeloos op de vlucht, naar (en in) Europa","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/532312.html"}},"place":{"id":274307,"translations":{"fr":{"name":"MigratieMuseumMigration","address_street_name":"rue des ateliers","address_street_number":"17","address_street_box":null,"email":"museum@foyer.be","website":"http:\/\/www.migratiemuseummigration.be","phone_contact":"+32 2 609 55 61","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue des ateliers, 17","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"Aujourd'hui, plus de 180 nationalite\u0301s vivent ensemble a\u0300 Bruxelles. Le MigratieMuseumMigration raconte l\u2019histoire de la premie\u0300re ge\u0301ne\u0301ration de travailleurs immigre\u0301s invite\u0301s, des premiers arrivants au Petit Cha\u0302teau, des expatrie\u0301s, des re\u0301fugie\u0301s de guerre, des Europe\u0301ens qui se sont de\u0301place\u0301s librement au sein de l\u2019UE et de tous les autres. C\u2019est un muse\u0301e chaleureux ou\u0300 les visiteurs peuvent de\u0301couvrir la ville et la vie des autres a\u0300 travers des souvenirs, mais aussi, et avant tout, un lieu accueillant pour y partager sa propre histoire.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"MigratieMuseumMigration","address_street_name":"Werkhuizenstraat","address_street_number":"17","address_street_box":null,"email":"museum@foyer.be","website":"http:\/\/www.migratiemuseummigration.be","phone_contact":"+32 2 609 55 61","phone_booking":null,"address_zip":"1080","address_city":"Sint-Jans-Molenbeek","address_line1":"Werkhuizenstraat, 17","address_line2":"1080 Sint-Jans-Molenbeek","description_web":"Vandaag de dag wonen meer dan 180 nationaliteiten samen in Brussel. Het MigratieMuseumMigration geeft de verhalen van de eerste generatiegastarbeiders, van de vroegste bewoners van het Klein Kasteeltje, van de expats, de oorlogsvluchtelingen, de Europeanen die zich vrij bewegen binnen de EU en vele anderen een permanente thuis. Het is een warme omgeving waar bezoekers via herinneringen en kunst op ontdekking gaan in Brussel en in het leven van anderen.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"MigratieMuseumMigration","address_street_name":"rue des ateliers","address_street_number":"17","address_street_box":null,"email":"museum@foyer.be","website":"http:\/\/www.migratiemuseummigration.be","phone_contact":"+32 2 609 55 61","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue des ateliers, 17","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"Today, more than 180 nationalities live together in Brussels. The MigratieMuseumMigration gives a permanent home to the stories of the first generation of guest workers, of the earliest inhabitants of the Petit-Cha\u0302teau, of the expats, the war refugees, the Europeans who move freely within the EU and many others. It is a warm environment where visitors can discover Brussels and the lives of others through memories and souvenirs. Above all, it is a museum with plenty of room to share your own story.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"MigratieMuseumMigration","address_street_name":"rue des ateliers","address_street_number":"17","address_street_box":null,"email":"museum@foyer.be","website":"http:\/\/www.migratiemuseummigration.be","phone_contact":"+32 2 609 55 61","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue des ateliers, 17","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"MigratieMuseumMigration","address_street_name":"rue des ateliers","address_street_number":"17","address_street_box":null,"email":"museum@foyer.be","website":"http:\/\/www.migratiemuseummigration.be","phone_contact":"+32 2 609 55 61","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue des ateliers, 17","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"MigratieMuseumMigration","address_street_name":"rue des ateliers","address_street_number":"17","address_street_box":null,"email":"museum@foyer.be","website":"http:\/\/www.migratiemuseummigration.be","phone_contact":"+32 2 609 55 61","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue des ateliers, 17","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"MigratieMuseumMigration","address_street_name":"rue des ateliers","address_street_number":"17","address_street_box":null,"email":"museum@foyer.be","website":"http:\/\/www.migratiemuseummigration.be","phone_contact":"+32 2 609 55 61","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"rue des ateliers, 17","address_