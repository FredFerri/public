1,"lon":4.33245839},"is_in_address_book":false,"is_in_vb_export":false,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/da0a573487d99df927c34cdbc7c9b56dbbcb55ac.jpg","width":1080,"height":1080,"ratio":1,"oEmbed_height":1080,"oEmbed_width":1080,"translations":{"de":{"title":"DAVE","copyright":null},"pt":{"title":"DAVE","copyright":null},"en":{"title":"DAVE","copyright":null},"it":{"title":"DAVE","copyright":null},"cn":{"title":"DAVE","copyright":null},"fr":{"title":"DAVE","copyright":null},"sp":{"title":"DAVE","copyright":null},"nl":{"title":"DAVE","copyright":null}}},{"type":"video","link":"https:\/\/youtu.be\/bEZtiK2zvvE","width":null,"height":null,"ratio":null,"translations":{"de":{"title":"DAVE","copyright":null},"pt":{"title":"DAVE","copyright":null},"en":{"title":"DAVE","copyright":null},"it":{"title":"DAVE","copyright":null},"cn":{"title":"DAVE","copyright":null},"fr":{"title":"DAVE","copyright":null},"sp":{"title":"DAVE","copyright":null},"nl":{"title":"DAVE","copyright":null}}}],"dates":[{"day":"2024-05-31","doors":null,"start":"20:00:00","end":null,"end_night_life":null,"is_soldout":false,"is_canceled":false}],"prices":[],"date_exceptions":[],"closing_days":[],"child_events":[],"parent_events":[],"accessibilities":[],"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[]},{"id":50010412,"date_start":"2024-05-31","date_end":"2024-05-31","date_next":"2024-05-31","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":true,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-05-07T07:52:03+02:00","published_at":"2024-05-07T07:49:12+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":299604,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"misc","ranking":1.2599210498948732,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":84,"translations":{"de":"Verschiedenes","pt":null,"en":"Various","it":"Varie","cn":null,"fr":"Divers","sp":"Varios","nl":"Varia"}},"others":{"list":[89],"translations":{"de":["Literatur"],"pt":[null],"en":["Litterature "],"it":["Letteratura"],"cn":[null],"fr":["Litt\u00e9rature"],"sp":["Literatura"],"nl":["Literatuur"]}}},"translations":{"de":{"name":"LECTURES MUSICALES | Autour du roman \"S\u2019en aller\" avec Sophie D\u2019Aubreby et Charlotte Maison","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/maisonpoeme.be\/evenement\/2024-lectures-musicales-sophie-daubreby-charlotte-maison\/","email":"info@maisonpoeme.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50010412"},"pt":{"name":"LECTURES MUSICALES | Autour du roman \"S\u2019en aller\" avec Sophie D\u2019Aubreby et Charlotte Maison","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/maisonpoeme.be\/evenement\/2024-lectures-musicales-sophie-daubreby-charlotte-maison\/","email":"info@maisonpoeme.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50010412"},"en":{"name":"LECTURES MUSICALES | Autour du roman \"S\u2019en aller\" avec Sophie D\u2019Aubreby et Charlotte Maison","shortdescr":"Lecture musicale du roman S\u2019en aller.\nS\u2019en aller raconte l\u2019itin\u00e9raire singulier d\u2019une femme qui choisira de ne pas emprunter les chemins trac\u00e9s pour elle. Accompagn\u00e9e de la musicienne Charlotte Maison, Sophie d\u2019Aubreby, lira des extraits de son r\u00e9cit.","longdescr":"Lecture musicale du roman S\u2019en aller.\nS\u2019en aller raconte l\u2019itin\u00e9raire singulier d\u2019une femme qui choisira de ne pas emprunter les chemins trac\u00e9s pour elle. Accompagn\u00e9e de la musicienne Charlotte Maison, Sophie d\u2019Aubreby, lira des extraits de son r\u00e9cit.\n\nApr\u00e8s avoir form\u00e9 le groupe Soldout avec David Baboulis, Charlotte Maison se consacre depuis 2019 \u00e0 la musique de films. Cette collaboration avec Sophie lui donne une occasion d\u2019exp\u00e9rimenter l\u2019interpr\u00e9tation musicale d\u2019un r\u00e9cit. Ensemble, elles proposent une experience immersive alternant lecture et musique \u00e9lectronique. Sophie d\u2019Aubreby a publi\u00e9 S\u2019en aller en 2021 et re\u00e7u le prix du Premier roman de Limoges en 2022. Comme Charlotte, c\u2019est la premi\u00e8re fois qu\u2019elle exp\u00e9rimente la mise en musique d\u2019un travail d\u2019\u00e9criture.\n\n\u00c0 propos de \u00ab S\u2019en aller \u00bb de Sophie D\u2019Aubreby :\n\n\u00ab S\u2019en aller \u00bb conte le r\u00e9cit d\u2019une \u00e9mancipation f\u00e9minine au cours de la premi\u00e8re partie du 20\u00e8me si\u00e8cle. De la Mer du Nord \u00e0 l\u2019\u00eele de Java, de son engagement dans la R\u00e9sistance jusqu\u2019\u00e0 ses derniers jours de femme \u00e2g\u00e9e, les \u00e9pisodes de la vie de Carmen sont autant de jalons sur les chemins de la libert\u00e9. Roman d\u2019apprentissage, hymne \u00e0 l\u2019amiti\u00e9, \u00ab S\u2019en aller\u00bb montre subtilement comment les luttes des femmes d\u2019aujourd\u2019hui font \u00e9cho \u00e0 celles de leurs a\u00een\u00e9es. Carmen est l\u2019une d\u2019entre elles.\n\nLu sur Cultures Sauvages :\n\u00ab Un roman arrache \u00e0 la nuit et au chaos du monde des fragments tremblants de libert\u00e9. Celle de figures insoumises et puissantes incarn\u00e9es par ces personnages romanesques qui accompagnent nos vies de lecteur et de lectrice. Carmen, protagoniste du premier roman de Sophie d\u2019Aubreby fait partie de ces personnages-l\u00e0. Comme son titre l\u2019indique, S\u2019en aller, elle va partir tr\u00e8s vite vers des ailleurs g\u00e9ographiques et parcourir le vingti\u00e8me si\u00e8cle comme un feu puissant et virevoltant. L\u2019\u00e9criture chez Sophie d\u2019Aubreby est ardemment po\u00e9tique et la construction du roman ressemble \u00e0 une danse fi\u00e9vreuse et ardente. Ainsi, pour paraphraser Guy Debord, le lecteur et la lectrice tournent en rond dans la nuit des images et des r\u00e9cits et sont d\u00e9vor\u00e9s par le feu des mots, ceux de Sophie d\u2019Aubreby. \u00bb\n \n\u00c0 propos des artistes :\n\nSophie d\u2019Aubreby est \u00e9crivaine. Elle est n\u00e9e \u00e0 Bruxelles en 1988 et a grandi en France. En 2020, elle publie \u00e0 l\u2019occasion du 8 mars la nouvelle D\u00e9plier les jambes, aux \u00e9ditions Lamiroy. S\u2019en aller, son premier roman, est publi\u00e9 en 2021 aux \u00e9ditions Inculte. Elle vit et travaille \u00e0 Bruxelles.\n\nCharlotte Maison est chanteuse et productrice de musique \u00e9lectronique, bas\u00e9e \u00e0 Bruxelles. Elle a form\u00e9 le groupe electro Soldout de 2004 \u00e0 \u00e0 2019. Depuis lors, elle se passionne pour l\u2019\u00e9criture de musique de film. Elle est r\u00e9compens\u00e9e d\u2019un Magritte pour la musique originale du film PuppyLove.","performers":"Sophie d'Aubreby (\u00e9crivaine); Charlotte Maison (chanteuse et productrice)","boxoffice_url":null,"website":"https:\/\/maisonpoeme.be\/evenement\/2024-lectures-musicales-sophie-daubreby-charlotte-maison\/","email":"info@maisonpoeme.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50010412"},"it":{"name":"LECTURES MUSICALES | Autour du roman \"S\u2019en aller\" avec Sophie D\u2019Aubreby et Charlotte Maison","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/maisonpoeme.be\/evenement\/2024-lectures-musicales-sophie-daubreby-charlotte-maison\/","email":"info@maisonpoeme.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50010412"},"cn":{"name":"LECTURES MUSICALES | Autour du roman \"S\u2019en aller\" avec Sophie D\u2019Aubreby et Charlotte Maison","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/maisonpoeme.be\/evenement\/2024-lectures-musicales-sophie-daubreby-charlotte-maison\/","email":"info@maisonpoeme.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50010412"},"fr":{"name":"LECTURES MUSICALES | Autour du roman \"S\u2019en aller\" avec Sophie D\u2019Aubreby et Charlotte Maison","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/maisonpoeme.be\/evenement\/2024-lectures-musicales-sophie-daubreby-charlotte-maison\/","email":"info@maisonpoeme.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50010412"},"sp":{"name":"LECTURES MUSICALES | Autour du roman \"S\u2019en aller\" avec Sophie D\u2019Aubreby et Charlotte Maison","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/maisonpoeme.be\/evenement\/2024-lectures-musicales-sophie-daubreby-charlotte-maison\/","email":"info@maisonpoeme.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50010412"},"nl":{"name":"LECTURES MUSICALES | Autour du roman \"S\u2019en aller\" avec Sophie D\u2019Aubreby et Charlotte Maison","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/maisonpoeme.be\/evenement\/2024-lectures-musicales-sophie-daubreby-charlotte-maison\/","email":"info@maisonpoeme.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.500104