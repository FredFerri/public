s, bref dans sa vie de papa moderne. Dans ce spectacle d\u00e9jant\u00e9, Kostia pose un \u0153il subtil et d\u00e9cal\u00e9 sur le monde qui l\u2019entoure et nous fait d\u00e9couvrir son univers. \u00c9nergique, dr\u00f4le, touchant et s\u00fbrement un peu fou. Il n\u2019est clairement pas seul dans sa t\u00eate mais c\u2019est promis tout le monde aura son mot \u00e0 dire.","performers":"Kostia","boxoffice_url":null,"website":"http:\/\/www.lepetitchapeaurondrouge.be","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.539498"},"nl":{"name":"Kostia Zielonka - Entre deux","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.539498"},"en":{"name":"Kostia Zielonka - Entre deux","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.539498"},"de":{"name":"\"Entre deux\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.539498"},"it":{"name":"\"Entre deux\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.539498"},"sp":{"name":"\"Entre deux\"","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.539498"},"pt":{"name":"\"Entre deux\"","shortdescr":null,"longdescr":null,"pe