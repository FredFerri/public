e":"https:\/\/www.lentrela.be\/evenement\/le-musee-des-technologies\/","email":"info@lentrela.be","phone_contact":"+32 2 241 15 83","phone_booking":"+32 2 241 15 83","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700004975"},"it":{"name":"Le Mus\u00e9e des Technologies","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lentrela.be\/evenement\/le-musee-des-technologies\/","email":"info@lentrela.be","phone_contact":"+32 2 241 15 83","phone_booking":"+32 2 241 15 83","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700004975"},"cn":{"name":"Le Mus\u00e9e des Technologies","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lentrela.be\/evenement\/le-musee-des-technologies\/","email":"info@lentrela.be","phone_contact":"+32 2 241 15 83","phone_booking":"+32 2 241 15 83","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700004975"},"fr":{"name":"Le Mus\u00e9e des Technologies","shortdescr":"En apoth\u00e9ose d\u2019un vaste projet sur ces technologies qui marquent nos vies, il est enfin temps d\u2019ouvrir en grand et de mani\u00e8re festive le Mus\u00e9e des Technologies ! ","longdescr":"En apoth\u00e9ose d\u2019un vaste projet sur ces technologies qui marquent nos vies, il est enfin temps d\u2019ouvrir en grand et de mani\u00e8re festive le Mus\u00e9e des Technologies ! \n\nAutour d\u2019un verre, sur la musique d\u2019Ouma Bouma et de Capelo, la soir\u00e9e du 24 janvier sera l\u2019occasion de d\u00e9couvrir une exposition pour le moins particuli\u00e8re ! \n\nLa visite du Mus\u00e9e vous emmenera \u00e0 la d\u00e9couverte d\u2019un int\u00e9rieur d\u2019appartement reconstitu\u00e9 et truff\u00e9 de technologies \u00e0 observer, \u00e0 \u00e9couter, \u00e0 toucher, \u00e0 essayer ! Une mise en sc\u00e8ne \u00e0 la port\u00e9e de vos sens, et \u00e0 la d\u00e9couverte de ces technologies qui marquent nos vies. \n\nLoin de documenter l\u2019Histoire de la technologie ou sa chronologie, le Mus\u00e9e est avant tout une immersion dans un univers subjectif ; un mus\u00e9e par les gens et pour les gens !\nGrande inauguration :\nVendredi 24\/01\/2025 \/\/ 18h\n\n18h : Ouma Bouma\n21h : Capelo\n\nSuivant l\u2019inauguration, le mus\u00e9e sera ouvert aux visites jusqu\u2019au 30 mars 2025, le mercredi et le dimanche de 15h \u00e0 18h.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.lentrela.be\/evenement\/le-musee-des-technologies\/","email":"info@lentrela.be","phone_contact":"+32 2 241 15 83","phone_booking":"+32 2 241 15 83","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700004975"},"sp":{"name":"Le Mus\u00e9e des Technologies","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lentrela.be\/evenement\/le-musee-des-technologies\/","email":"info@lentrela.be","phone_contact":"+32 2 241 15 83","phone_booking":"+32 2 241 15 83","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700004975"},"nl":{"name":"Le Mus\u00e9e des Technologies","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lentrela.be\/evenement\/le-musee-des-technologies\/","email":"info@lentrela.be","phone_contact":"+32 2 241 15 83","phone_booking":"+32 2 241 15 83","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700004975"}},"place":{"id":50002815,"translations":{"de":{"name":"Mus\u00e9e des Technologies","address_street_name":"Rue du Tilleul","address_street_number":"297","address_street_box":null,"email":"info@lentrela.be","website":"https:\/\/www.lentrela.be\/evenement\/le-musee-des-technologies\/","phone_contact":null,"phone_booking":null,"address_zip":"1140","address_city":"Evere","address_line1":"Rue du Tilleul, 297","address_line2":"1140 Evere","description_web":null,"description_print":null,"booking_