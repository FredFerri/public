l,"boxoffice_url":null,"website":"https:\/\/ras-el-hanout.be\/spectacle\/off-on\/","email":"info@ras-el-hanout.be","phone_contact":"+32 488 01 14 11","phone_booking":"+32 488 01 14 11","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50012326"},"pt":{"name":"A la prochaine, mama","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/ras-el-hanout.be\/spectacle\/off-on\/","email":"info@ras-el-hanout.be","phone_contact":"+32 488 01 14 11","phone_booking":"+32 488 01 14 11","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50012326"},"en":{"name":"A la prochaine, mama","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/ras-el-hanout.be\/spectacle\/off-on\/","email":"info@ras-el-hanout.be","phone_contact":"+32 488 01 14 11","phone_booking":"+32 488 01 14 11","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50012326"},"it":{"name":"A la prochaine, mama","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/ras-el-hanout.be\/spectacle\/off-on\/","email":"info@ras-el-hanout.be","phone_contact":"+32 488 01 14 11","phone_booking":"+32 488 01 14 11","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50012326"},"cn":{"name":"A la prochaine, mama","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/ras-el-hanout.be\/spectacle\/off-on\/","email":"info@ras-el-hanout.be","phone_contact":"+32 488 01 14 11","phone_booking":"+32 488 01 14 11","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50012326"},"fr":{"name":"A la prochaine, mama","shortdescr":"Anas partage son histoire personnelle marqu\u00e9e par l'absence de rep\u00e8res maternels, abordant le deuil et la sant\u00e9 mentale dans son premier spectacle. En une heure, il explore ses \u00e9motions et souvenirs, invitant le public \u00e0 reconnecter avec les leurs. Son r\u00e9cit, touchant et universel, cr\u00e9e un moment plein d'amour et d'empathie.\n\n\n\n\n\n\n\n\n\n\n\n\n\n","longdescr":"Anas se tient droit devant nous, et partage \u00e0 coeur ouvert son histoire, ou plut\u00f4t son absence de rep\u00e8res maternels. Avec ce premier spectacle, il l\u00e8ve le tabou du deuil, de la sant\u00e9 mentale et l'importance d' en prendre soin. \nUne heure de conversation intime ou Anas explore petit \u00e0 petit ses \u00e9motions et ses souvenirs, nous aidant ainsi \u00e0 renouer avec les n\u00f4tres. \n\"Ton histoire est tellement personnelle qu'elle en devient universelle\".\nUn moment suspendu plein d'amour et d'empathie. ","performers":"Texte : Anas ACHA\u00c2RA, Yasmina AHKIM, Mehdi BOUKYOUE et Mohamed Salim HAOUACH \/ sc\u00e9nographie  : Zenel LACI \/ R\u00e9gie : Mahir MOURNIN \/ \nCoproduction : Ras El Hanout et Zinnema ","boxoffice_url":null,"website":"https:\/\/ras-el-hanout.be\/spectacle\/off-on\/","email":"info@ras-el-hanout.be","phone_contact":"+32 488 01 14 11","phone_booking":"+32 488 01 14 11","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50012326"},"sp":{"name":"A la prochaine, mama","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/ras-el-hanout.be\/spectacle\/off-on\/","email":"info@ras-el-hanout.be","phone_contact":"+32 488 01 14 11","phone_booking":"+32 488 01 14 11","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50012326"},"nl":{"name":"A la prochaine, mama","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/ras-el-hanout.be\/spectacle\/off-on\/","email":"info@ras-el-hanout.be","phone_contact":"+32 488 01 14 11","phone_booking":"+32 488 01 14 11","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50012326"}},"place":{"id":50001112,"translations":{"de":{"name":"Maison du Peuple","address_street_name":"Parvis Saint-G