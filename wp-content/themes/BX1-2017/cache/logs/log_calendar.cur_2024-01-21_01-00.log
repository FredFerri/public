,"boxoffice_url":null,"website":"http:\/\/www.zedes-art-gallery.be","email":"zedes.art.gallery@gmail.com","phone_contact":"+32 475 52 62 58","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50005681"},"en":{"name":"Eric Kengen","shortdescr":"ERIC KENGEN (Brussels, 1952)\nEric Kengen's work is a kind of life album in which gestures forge links of all kinds,\nfilial, tender, sensual and metaphorical. Now in the fullness of his powers, he\nstimulates our imagination and regenerates the urgency of a free gaze.","longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.zedes-art-gallery.be","email":"zedes.art.gallery@gmail.com","phone_contact":"+32 475 52 62 58","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50005681"},"it":{"name":"Eric kengen","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.zedes-art-gallery.be","email":"zedes.art.gallery@gmail.com","phone_contact":"+32 475 52 62 58","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50005681"},"cn":{"name":"Eric kengen","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.zedes-art-gallery.be","email":"zedes.art.gallery@gmail.com","phone_contact":"+32 475 52 62 58","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50005681"},"fr":{"name":"Eric Kengen","shortdescr":"L\u2019\u0153uvre d'Eric Kengen (Bruxelles, 1952) est une sc\u00e8ne privil\u00e9gi\u00e9e o\u00f9 se noue sans\nse r\u00e9soudre quelque chose de violemment affectif et sensuel. Son univers \nsingulier constitue une sorte d'album de vie o\u00f9 les gestes forgent des liens de\ntoutes sortes, filiaux, tendres, m\u00e9taphoriques. Aujourd'hui dans la pl\u00e9nitude de\nses moyens, il stimule notre imagination et r\u00e9g\u00e9n\u00e8re l'urgence d'un regard libre.","longdescr":null,"performers":"Eric Kengen","boxoffice_url":null,"website":"http:\/\/www.zedes-art-gallery.be","email":"zedes.art.gallery@gmail.com","phone_contact":"+32 475 52 62 58","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50005681"},"sp":{"name":"Eric kengen","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.zedes-art-gallery.be","email":"zedes.art.gallery@gmail.com","phone_contact":"+32 475 52 62 58","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50005681"},"nl":{"name":"Eric Kengen","shortdescr":"Het werk van Eric Kengen (Brussel, 1952) is het bevoorrechte sc\u00e8ne waarop iets heftigs affectiefs en zinnelijks wordt geweven zonder te worden opgelost. Zijn eigenzinnige universum is een soort levensalbum waar gebaren allerlei soorten banden smeden: teder maar ook metaforisch. Nu, in de volheid van zijn krachten, stimuleert hij prikkelt onze verbeelding en herstelt de urgentie van een vrije blik.","longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.zedes-art-gallery.be","email":"zedes.art.gallery@gmail.com","phone_contact":"+32 475 52 62 58","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50005681"}},"place":{"id":260455,"translations":{"de":{"name":"zedes art gallery","address_street_name":"Rue Paul Lauters","address_street_number":"36","address_street_box":null,"email":"zedes.art.gallery@gmail.com","website":"http:\/\/www.zedes-art-gallery.be","phone_contact":"+32 475 52 62 58","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Paul Lauters, 36","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"zedes art gallery","address_street_name":"Rue Paul Lauters","address_street_number":"