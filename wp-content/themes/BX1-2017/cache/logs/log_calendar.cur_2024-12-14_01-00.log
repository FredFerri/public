s":null,"boxoffice_url":null,"website":"http:\/\/www.lemarchedenoel.be","email":"communication@osamoelle.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700003930"},"it":{"name":"March\u00e9 de No\u00ebl de l'Os \u00e0 Moelle","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lemarchedenoel.be","email":"communication@osamoelle.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700003930"},"cn":{"name":"March\u00e9 de No\u00ebl de l'Os \u00e0 Moelle","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lemarchedenoel.be","email":"communication@osamoelle.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700003930"},"fr":{"name":"March\u00e9 de No\u00ebl de l'Os \u00e0 Moelle","shortdescr":null,"longdescr":"Vous la sentez l'odeur de sapin et de vin chaud ? Vous aussi elle commence \u00e0 vous titiller les narines ?\n\nBonne nouvelle !\n\nCette ann\u00e9e encore le l\u00e9gendaire March\u00e9 de No\u00ebl de l'Os \u00e0 Moelle revient en force !\nVenez d\u00e9ambuler parmi les nombreux stands d'artisans, laissez-vous tenter par une tartiflette ou un vin chaud, r\u00e9chauffez vos mimines au coin d'un brasero en \u00e9coutant des chants de No\u00ebl.\n\n L'occasion de passer un agr\u00e9able moment en famille ou entre amis et de d\u00e9nicher vos derniers cadeaux de No\u00ebl.\nAmbiance assur\u00e9e !\n\nAu programme :\n- March\u00e9 artisanal int\u00e9rieur et ext\u00e9rieur\n- Environ 40 exposants aux styles divers et vari\u00e9s \n- Guinguette : braseros, bar et petite restauration \n- Animations familiales \n- Animations musicales tout au long du week-end \n- Visite du P\u00e8re No\u00ebl \n- Photobooth \n\nEn pratique :\n- Le vendredi 13 d\u00e9cembre de 16h \u00e0 22h\n- le samedi 14 d\u00e9cembre de 13h \u00e0 22h\n- le dimanche 15 d\u00e9cembre de 11h \u00e0 18h\n\nL\u2019Os \u00e0 Moelle\nAvenue Emile Max, 153\n1030 Bruxelles\nSite web de l\u2019\u00e9v\u00e8nement: www.lemarchedenoel.be\nSite web de l\u2019organisateur: www.osamoelle.be","performers":null,"boxoffice_url":null,"website":"http:\/\/www.lemarchedenoel.be","email":"communication@osamoelle.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700003930"},"sp":{"name":"March\u00e9 de No\u00ebl de l'Os \u00e0 Moelle","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lemarchedenoel.be","email":"communication@osamoelle.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700003930"},"nl":{"name":"March\u00e9 de No\u00ebl de l'Os \u00e0 Moelle","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lemarchedenoel.be","email":"communication@osamoelle.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700003930"}},"place":{"id":1078,"translations":{"de":{"name":"L'Os \u00e0 Moelle","address_street_name":"Avenue Emile Max","address_street_number":"153","address_street_box":null,"email":"reservation@osamoelle.be","website":"http:\/\/www.osamoelle.be","phone_contact":"+32 487 22 50 22","phone_booking":"+32 487 22 50 22","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Avenue Emile Max, 153","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"L'Os \u00e0 Moelle","address_street_name":"Avenue Emile Max","address_street_number":"153","address_street_box":null,"email":"reservation@osamoelle.be","website":"http:\/\/www.osamoelle.be","phone_cont