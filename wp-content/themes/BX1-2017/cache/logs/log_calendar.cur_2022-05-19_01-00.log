essibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-05-11T15:35:38+02:00","published_at":"2022-05-11T11:07:44+02:00","backoffice_id":253514,"import_origin":null,"sub_type":"concert","show_in_agenda":true,"ranking":1},{"id":533057,"date_start":"2022-04-27","date_end":"2022-05-23","date_next":"2022-05-20","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[36,39],"translations":{"fr":["Mus\u00e9es et art centers","Photographie"],"nl":["Musea en kunstcentra","Fotografie"],"en":["Museums and art centers","Photography"]}}},"languages":{"spoken":["fr","en"],"subtitles":[]},"translations":{"fr":{"name":"Collection Baleine Blanche","shortdescr":"Six explorations de la figure paternelle, une exposition photographique.","longdescr":"Du 27 avril au 23 mai 2022, Collection Baleine Blanche investit la Maison Pelgrims.\r\n\r\nOrganis\u00e9e par la maison d'\u00e9dition ind\u00e9pendante Macaronibook dans le cadre du Parcours d'Artistes 2022, cette exposition collective r\u00e9unit six photographes (Erell Hemmer, Martin Gallone, Natalie Malisse, Elie Carp, Henri Cl\u00e9ment et Camille Carbonaro) qui interrogent, explorent et reconstruisent une image du p\u00e8re.\r\n\r\nUne initiative de Macaronibook avec le soutien du Service de la Culture de Saint-Gilles, de l'asbl Les Rencontres Saint-Gilloises, de la R\u00e9gion de Bruxelles Capitale, la Cocof et la F\u00e9d\u00e9ration Wallonie-Bruxelles.","performers":"Camille Carbonaro (photographe, \u00e9ditrice et commissaire de l'exposition) ; Elie Carp (photographe) ; Henri Cl\u00e9ment (photographe) ; Martin Gallone (photographe) ; Erell Hemmer (photographe) ; Natalie Malisse (photographe)","boxoffice_url":null,"website":"https:\/\/macaronibook.com\/fr\/","email":"macaronibook@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/533057.html"},"nl":{"name":"Collection Baleine Blanche","shortdescr":"Zes exploraties van de vaderfiguur, \u00e9\u00e9n fotografische tentoonstelling.","longdescr":"Van 27 april tot 23 mei 2022 zal Collection Baleine Blanche in het Pelgrimshuis plaatsvinden.\r\n\r\nDeze groepstentoonstelling, georganiseerd door de onafhankelijke uitgeverij Macaronibook in het kader van Parcours d'Artistes 2022, brengt zes fotografen samen (Erell Hemmer, Martin Gallone, Natalie Malisse, Elie Carp, Henri Cl\u00e9ment en Camille Carbonaro) die de vaderfiguur onderzoeken.\r\n\r\nEen initiatief van Macaronibook met de steun van de Dienst Cultuur van Sint-Gillis, Les Rencontres Saint-Gilloises vzw, het Brussels Hoofdstedelijk Gewest, de Cocof en de Federatie Walloni\u00eb-Brussel.","performers":"Camille Carbonaro (fotograaf, uitgever en curator) ; Elie Carp (fotograaf) ; Henri Cl\u00e9ment (fotograaf) ; Martin Gallone (fotograaf) ; Erell Hemmer (fotograaf) ; Natalie Malisse (fotograaf)","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/533057.html"},"en":{"name":"Collection Baleine Blanche","shortdescr":"Six explorations of the paternal image, one photographic exhibition.","longdescr":"From April 27 to May 23 2022, Collection Baleine Blanche is shown at the Pelgrims House.\r\n\r\nOrganized by the independent publishing house Macaronibook as part of Parcours d'Artistes 2022, this collective exhibition gathers photography artists (Erell Hemmer, Martin Gallone, Natalie Malisse, Elie Carp, Henri Cl\u00e9ment and Camille Carbonaro) who question, research and reconstruct the paternal image. \r\n\r\nAn initiative of Macaronibook with the support of the Service de la Culture de Saint-Gilles, Les Rencontres Saint-Gilloises asbl, the Brussels Capital Region, the Cocof and the Wallonia-Brussels Federation.","performers":"Camille Carbonaro (photographer, publisher and curator) ; Elie Carp (photographer) ; Henri Cl\u00e9ment (photographer) ; Martin Gallone (photographer) ; Erell Hemmer (photographer) ; Natalie Malisse (photographer)","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/533057.html"},"de":{"name":"Collection Baleine Blanche","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/533057.html"},"it":{"name":"Collection Baleine Blanche","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/533057.html"},"sp":{"name":"Collection Baleine Blanche","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/533057.html"},"pt":{"name":"Collection Baleine Blanche","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/533057.html"},"cn":{"name":"Collection Baleine Blanche","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/533057.html"}},"place":{"id":211458,"translations":{"fr":{"name":"Maison Pelgrims","address_street_name":"Rue de Parme","address_street_number":"69","address_street_box":null,"email":"culture.1060@st