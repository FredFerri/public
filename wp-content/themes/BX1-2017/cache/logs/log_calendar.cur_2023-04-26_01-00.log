tors\/agenda\/event-detail.552864"},"cn":{"name":"L'argent fait le bonheur","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.fourire.be","email":"reservations@fourire.be","phone_contact":"+32 483 59 92 29","phone_booking":"+32 483 59 92 29","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.552864"}},"place":{"id":249081,"translations":{"fr":{"name":"Fou Rire","address_street_name":"rue des Grenadiers","address_street_number":"48","address_street_box":null,"email":"info@fourire.be","website":"http:\/\/www.fourire.be","phone_contact":"+32 483 59 92 29","phone_booking":"+32 70 66 06 01","address_zip":"1050","address_city":"Ixelles","address_line1":"rue des Grenadiers, 48","address_line2":"1050 Ixelles","description_web":"Vous cherchez une soir\u00e9e pleine d'humour et de divertissement ? Vous \u00eates alors \u00e0 la bonne adresse (attention, celle-ci a chang\u00e9 en 2019). Par la d\u00e9tente, l'interaction et l'\u00e9motion, il vise \u00e0 relier les gens par et \u00e0 travers le th\u00e9\u00e2tre bruxellois et \u00e0 les renvoyer chez eux avec un sentiment de sati\u00e9t\u00e9 et d'exub\u00e9rance. Dans ce th\u00e9\u00e2tre de quartier, le texte et l'\u00e9motion occupent une place pr\u00e9pond\u00e9rante, car en plus de la com\u00e9die, retrouvez aussi de la po\u00e9sie, de la philosophie, des contes et du th\u00e9\u00e2tre jeune public.   \r\n\r\n ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Fou Rire","address_street_name":"Grenadiersstraat","address_street_number":"48","address_street_box":null,"email":"info@fourire.be","website":"http:\/\/www.fourire.be","phone_contact":"+32 483 59 92 29","phone_booking":"+32 70 66 06 01","address_zip":"1050","address_city":"Elsene","address_line1":"Grenadiersstraat, 48","address_line2":"1050 Elsene","description_web":"Op zoek naar een avond vol humor en vermaak? Dan bij je bij Le Fou Rire aan het jui