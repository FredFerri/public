agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50007166"},"pt":{"name":"Printemps Num\u00e9rique 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/be.brussels\/fr\/activites-culturelles\/festivals-evenements\/printemps-numerique-2024","email":"PN24DL@paradigm.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50007166"},"en":{"name":"Digital Spring 2024","shortdescr":null,"longdescr":"Explore an educational itinerary on the environmental footprint of digital technology, explore the latest technological advances through interactive activities-unprecedented, let yourself be captivated by fascinating demos and exchange with industry experts to broaden your digital horizons. Why not learn coding and create your own video game? \nJoin us on an exciting journey to the digital future!","performers":"Dive into Printemps Num\u00e9rique Bruxelles 2024, an immersive experience offered by Paradigm! From virtual reality to cybersecurity, through artificial intelligence, e-gaming, retrogaming and the exploration of professional digital opportunities, the 4th edition of this event promises a captivating immersion in the latest technological advances!","boxoffice_url":null,"website":"https:\/\/be.brussels\/en\/leisure-events-sports\/cultural-activities\/festivals-evenements\/digital-spring-2024","email":"PN24DL@paradigm.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50007166"},"it":{"name":"Printemps Num\u00e9rique 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/be.brussels\/fr\/activites-culturelles\/festivals-evenements\/printemps-numerique-2024","email":"PN24DL@paradigm.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50007166"},"cn":{"name":"Printemps Num\u00e9rique 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/be.brussels\/fr\/activites-culturelles\/festivals-evenements\/printemps-numerique-2024","email":"PN24DL@paradigm.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50007166"},"fr":{"name":"Printemps Num\u00e9rique 2024","shortdescr":"\n","longdescr":"Parcourez un itin\u00e9raire didactique sur l'empreinte environnementale du num\u00e9rique, explorez les derni\u00e8res avanc\u00e9es technologiques \u00e0 travers des activit\u00e9s interactives-in\u00e9dites, laissez-vous captiver pas des d\u00e9mos fascinantes et \u00e9changez avec des experts du secteur pour \u00e9largir vos horizons num\u00e9riques. Et pourquoi ne pas vous initier au codage et cr\u00e9er votre propre jeu vid\u00e9o ? \nRejoignez-nous pour un voyage captivant vers l\u2019avenir du num\u00e9rique !","performers":"Plongez au c\u0153ur du Printemps Num\u00e9rique Bruxelles 2024, une exp\u00e9rience immersive offerte par Paradigm ! De la r\u00e9alit\u00e9 virtuelle \u00e0 la cybers\u00e9curit\u00e9, en passant par l\u2019intelligence artificielle, l\u2019e-gaming, le r\u00e9trogaming et l\u2019exploration des opportunit\u00e9s du num\u00e9rique, la 4\u00e8me \u00e9dition de ce rendez-vous incontournable promet une immersion captivante dans les derni\u00e8res avanc\u00e9es technologiques !","boxoffice_url":null,"website":"https:\/\/be.brussels\/fr\/activites-culturelles\/festivals-evenements\/printemps-numerique-2024","email":"PN24DL@paradigm.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50007166"},"sp":{"name":"Printemps Num\u00e9rique 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/be.brussels\/fr\/activites-culturelles\/festivals-evenements\/printemps-numerique-2024","email":"PN24DL@paradigm.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50007166"},"nl":{"name":"Digitale Lente 2024","shortdescr":null,"longdescr":"Volg een educatief parcours over de ecologische voetafdruk van digitale technologie, verken de nieuwste technologische ontwikkelingen via interactieve activiteiten, raak in vervoering door de fascinerende demo's en praat met experts uit de sector om uw digitale horizon te verbreden. En waarom probeert u niet eens te coderen en uw eigen videogame te ontwerpen?\nGa met ons mee op een spannende reis naar de digitale toekomst!  ","performers":"Neem een verfrissende duik in de Digitale Lente 2024, een immersieve ervaring, u aangeboden door Paradigm! Van virtual reality tot cybersecurity, via artifici\u00eble intelligentie, e-gaming, retrogaming en het verkennen van professionele digitale mogelijkheden: de vierde editie van dit niet te missen evenement belooft een boeiende onderdompeling in de nieuwste technologische ontwikkelingen!","boxoffice_url":null,"website":"https:\/\/be.brussels\/nl\/culturele-activiteiten\/festivals-evenements\/digitale-lente-2024","email":"PN24DL@paradigm.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50007166"}},"place":{"id":262737,"translations":{"de":{"name":"Tour & Taxis Venues","address_street_name":"Avenue du Port","address_street_number":"86 c","address_street_box":null,"email":"welcome@tour-taxis.com","website":"http:\/\/www.tour-taxis.com\/meet-and-organise\/","phone_contact":"+32 2 421 50 02","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Avenue du Port, 86 c","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Tour & Taxis Venues","address_street_name":"Ave