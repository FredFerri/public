ns":{"fr":{"name":"Cat\u00e9gorie 2"},"nl":{"name":"Categorie 2"},"en":{"name":"Category 2"},"de":{"name":"Kategorie 2"},"it":{"name":"Categoria 2"},"sp":{"name":"Categor\u00eda 2"},"pt":{"name":"Cat\u00e9gorie 2"},"cn":{"name":"Cat\u00e9gorie 2"}},"value":20}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-02-24T09:05:09+01:00","published_at":"2023-02-24T09:01:58+01:00","backoffice_id":272452,"import_origin":null,"sub_type":"concert","show_in_agenda":true,"ranking":1.2599210498949},{"id":551884,"date_start":"2023-03-26","date_end":"2023-03-26","date_next":"2023-03-26","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater","it":"Teatro","sp":"Teatro","pt":null,"cn":null}},"others":{"list":[52],"translations":{"fr":["Th\u00e9\u00e2tre musical"],"nl":["Muziektheater"],"en":["Musical theatre"],"de":["Musiktheater"],"it":["Teatro musicale"],"sp":["Teatro musical"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Mini-ver","shortdescr":"Les tribulations d'un petit ver de terre qui n'a personne avec qui jouer","longdescr":"Son papa, sa Maman, son fr\u00e8re: ils sont tous trop occup\u00e9s \u00e0 labourer la terre. Il lui faudrait un ami. Alors, il prend son courage \u00e0 deux mains, m\u00eame si les vers de terre n\u2019en ont pas, et s\u2019en va voir plus loin... Mais dans le jardin, il y a les belettes, les oiseaux, sans compter ceux qui coupent les vers de terre en morceaux. Au fait, un v\u00e9ritable ami, tu sais ce que c\u2019est, toi ?\r\n\r\nUn spe