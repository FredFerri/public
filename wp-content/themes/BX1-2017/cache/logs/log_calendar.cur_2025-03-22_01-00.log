":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":318702,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"tour","ranking":1.2599210498948732,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{"list":[255],"translations":{"de":["Besuche von Ausstellungen"],"pt":[null],"en":["Exhibition guided tours"],"it":["Visite a esposizioni"],"cn":[null],"fr":["Visites d'expositions"],"sp":["Visitas a las exposiciones"],"nl":["Tentoonstelling"]}}},"translations":{"de":{"name":"Nocturnes x Art et marges museum","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.artetmarges.be","email":"info@artetmarges.be","phone_contact":"+32 2 533 94 90","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700006939"},"pt":{"name":"Nocturnes x Art et marges museum","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.artetmarges.be","email":"info@artetmarges.be","phone_contact":"+32 2 533 94 90","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700006939"},"en":{"name":"Nocturnes x Art et marges museum","shortdescr":"The Art et marges museum is taking part in the Brussels museums Nocturnes program. For the occasion, the museum will be plunged into darkness! ","longdescr":"Enter the colourful swarms through your smartphone\u2019s light beam. In the chiaroscuro, Michel Goyon reveals his drawings: interlocking shapes, visual games and wordplay, plastic findings, numbers and phosphorescent surprises are inspired by art brut, American comics and scientific literature.\n\nTwo guided tours by Michel Goyon at 6pm and 8pm (in FR - limited capacity - register on site during the Nocturne - be sure to arrive well in advance). \n\nPrices and ticket purchase: https:\/\/nocturnes.brussels\/en\/tickets\/ (you can also buy your ticket on site on the day)\n","performers":"Michel Goyon (drawing artist)","boxoffice_url":null,"website":"http:\/\/www.artetmarges.be","email":"info@artetmarges.be","phone_contact":"+32 2 533 94 90","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700006939"},"it":{"name":"Nocturnes x Art et marges museum","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.artetmarges.be","email":"info@artetmarges.be","phone_contact":"+32 2 533 94 90","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700006939"},"cn":{"name":"Nocturnes x Art et marges museum","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.artetmarges.be","email":"info@artetmarges.be","phone_contact":"+32 2 533 94 90","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700006939"},"fr":{"name":"Nocturnes x Art et marges mus\u00e9e","shortdescr":"Le Art et marges mus\u00e9e participe au programme des Nocturnes de Brussels museums. Pour l\u2019occasion, le mus\u00e9e sera plong\u00e9 dans l\u2019obscurit\u00e9 ! ","longdescr":"Vous entrerez dans le fourmillement color\u00e9 de l\u2019\u0153uvre de Michel Goyon \u00e0 travers le faisceau lumineux de votre smartphone pour laisser formes imbriqu\u00e9es, jeux visuels et jeux de mots, trouvailles plastiques, chiffres en pagaille et surprises phosphorescentes se r\u00e9v\u00e9ler dans le clair-obscur. \n\nDeux visites guid\u00e9es par Michel Goyon sont pr\u00e9vues \u00e0 18h et 20h (jauge limit\u00e9e \u2013 inscrivez-vous sur place lors de la Nocturne \u2013 pr\u00e9voir un peu d\u2019avance) \n\nTarifs et achat de tickets : https:\/\/nocturnes.brussels\/fr\/tickets\/ (vous pouvez \u00e9galement acheter votre ticket sur place le jour-m\u00eame)\n","performers":"Michel Goyon (dessinateur)","boxoffice_url":null,"website":"http:\/\/www.artetmarges.be","email":"info@artetmarges.be","phone_contact":"+32 2 533 94 90","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700006939"},"sp":{"name":"Nocturnes x Art et marges museum","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.artetmarges.be","email":"info@artetmarges.be","phone_contact":"+32 2 533 94 90","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700006939"},"nl":{"name":"Nocturnes x Art et marges museum","shortdescr":"Het Art et marges museum neemt deel aan het Nocturnes programma van Brussels museums. Voor de gelegenheid wordt het museum ondergedompeld in duisternis! ","longdescr":"Betreed het kleurrijke krioelen door de lichtstraal van je smartphone en zaklamp. In clair-obscur worden de tekeningen van Michel Goyon onthuld. De in elkaar grijpende vormen, visuele spelletjes en woordspelingen, plastic ontdekkingen, door elkaar gegooide getallen en fosforescerende verrassingen zijn ge\u00efnspireerd op art brut, Amerikaanse comics en wetenschappelijke literatuur.\n\nEr zijn twee rondleidingen door Michel Goyon om 18.00 en 20.00 uur (in het FR - beperkte capaciteit - schrijf je ter plekke in tijdens de Nocturne - vooraf komen). \n\nPrijzen en aankoop van tickets: https:\/\/nocturnes.brussels\/nl\/tickets\/ (je kunt je ticket ook ter plaatse kopen op de dag zelf)\n","performers":"Michel Goyon (tekenaar)","boxoffice_url":null,"website":"http:\/\/www.artetmarges.be","email":"info@artetmarges.be","phone_contact":"+32 2 533 94 90","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700006939"}},"place":{"id":738,"translations":{"de":{"name":"Mus\u00e9e Art et marges","address_street_name":"Rue Haute","address_street_number":"314","address_street_box":null,"email":"info@artetmarges.be","website":"http:\/\/www.artetmarges.be","phone_contact":"+32 2 533 94 90","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Haute, 314","address_line2":"1000 Bruxelles","description_web":"Art brut - Outsider Art - Zeitgen\u00f6ssische Kunst\r\n\r\nDas Museum Art et Marges zeigt eine Sammlung, die seit den 1980er-Jahren kontinuierlich w\u00e4chst. Dabei handelt es sich um Kunst abseits des Mainstreams, die einen Blick auf die autodidaktischen K\u00fcnslter wirft, Kunstateliers f\u00fcr Menschen mit geistiger Behinderung oder in Psychiatrien. \r\nIn den Ausstellungen mischen sich K\u00fcnstler diesseits und jenseits der Grenze des \"Au\u00dfenseitertums\" (engl. Begriff \"Art Outsider\"), die die Kunst und deren Beschr\u00e4nkungen hinterfragt.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Art et marges mus\u00e9e","address_street_name":"Rue Haute","address_street_number":"314","address_street_box":null,"email":"info@artetmarges.be","website":"http:\/\/www.artetmarges.be","phone_contact":"+32 2 533 94 90","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Haute, 314","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Art & marges museum","address_street_name":"Hoogstraat","address_street_number":"314","address_street_box":null,"email":"info@artetmarges.be","website":"http:\/\/www.artetmarges.be","phone_contact":"+32 2 533 94 90","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Hoogstraat, 314","address_line2":"1000 Brussels","description_web":"Located in the heart of Brussels, the Art et marges museum is dedicated to \u2018art brut\u2019 or \u2018outsider art\u2019.\nIts collection was built up from the mid-1980s with artworks from self-taught artists and artistic workshops for the mentally disabled and the psychologically fragile. It now comprises over 4,500 international works produced outside the established contemporary art circuit.\n\nIts temporary exhibitions bring together artists from both sides of the fringe, questioning the boundaries of art and its very definition.\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Mus\u00e9e Art et marges","address_street_name":"Rue Haute","address_street_number":"314","address_street_box":null,"email":"info@artetmarges.be","website":"http:\/\/www.artetmarges.be","phone_contact":"+32 2 533 94 90","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Haute, 314","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Art et marges mus\u00e9e","address_street_name":"Rue Haute","address_street_number":"314","address_street_box":null,"email":"info@artetmarges.be","website":"http:\/\/www.artetmarges.be","phone_contact":"+32 2 533 94 90","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Haute, 314","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Art et marges mus\u00e9e","address_street_name":"Rue Haute","address_street_number":"314","address_street_box":null,"email":"info@artetmarges.be","website":"http:\/\/www.artetmarges.be","phone_contact":"+32 2 533 94 90","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Haute, 314","address_line2":"1000 Bruxelles","description_web":"Situ\u00e9 au c\u0153ur de Bruxelles, le Art et marges mus\u00e9e est consacr\u00e9 \u00e0 l\u2019Art brut ou outsider.\nSa collection s\u2019est constitu\u00e9e d\u00e8s le milieu des ann\u00e9es 80 aupr\u00e8s d\u2019artistes autodidactes, d\u2019ateliers artistiques pour personnes en situation de handicap mental ou psychologiquement fragilis\u00e9es. Elle se compose aujourd\u2019hui de plus de 4500 \u0153uvres internationales produites en dehors du circuit \u00e9tabli de l\u2019art contemporain.\n\nSes expositions temporaires m\u00ealent artistes de part et d\u2019autre de la marge, questionnant les fronti\u00e8res de l\u2019art et sa d\u00e9finition-m\u00eame.\n","description_print":"Mus\u00e9e d'art outsider","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Museo Art & Marges","address_street_name":"Rue Haute","address_street_number":"314","address_street_box":null,"email":"info@artetmarges.be","website":"http:\/\/www.artetmarges.be","phone_contact":"+32 2 533 94 90","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Haute, 314","address_line2":"1000 Bruxelles","description_web":"Desde su creaci\u00f3n, el Centro de Investigaci\u00f3n y Difusi\u00f3n del arte outsider Art en Marge (que se convirti\u00f3 posteriormente en el museo Art)&Marges) aboga por los artistas que no forman parte del circuito cultural oficial. Los conocidos actualmente como \u00aboutsiders\u00bb (ver glosario) son creadores autodidactas que trabajan solos o en talleres creativos para personas psicol\u00f3gicamente vulnerables o con alguna discapacidad mental. Algunos son internos de residencias para discapacitados mentales, hospitales psiqui\u00e1tricos, y otros son trabajadores o extrabajadores de una amplia gama de profesiones: fot\u00f3grafos, anticuarios, zapateros, m\u00fasicos...","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Art & marges museum","address_street_name":"Hoogstraat","address_street_number":"314","address_street_box":null,"email":"info@artetmarges.be","website":"http:\/\/www.artetmarges.be","phone_contact":"+32 2 533 94 90","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Hoogstraat, 314","address_line2":"1000 Brussel","description_web":"Het Art et marges museum ligt in het hart van Brussel en is gewijd aan outsiderkunst (of Art brut).\nDe basis voor de collectie werd in het midden van de jaren 1980 gelegd met kunstwerken van autodidactische kunstenaars en artistieke ateliers voor mensen met een verstandelijke beperking of psychische kwetsbaarheid. Ze omvat inmiddels meer dan 4.500 internationale werken die buiten het gevestigde hedendaagse kunstcircuit zijn ontstaan.\n\nDe tijdelijke tentoonstellingen brengen werk samen van outsiders en kunstenaars uit het hedendaagse kunstcircuit, waarbij de grenzen en het wezen van kunst ter discussie worden gesteld.\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[2],"translations":{"de":["Marollen"],"pt":[null],"en":["Marolles"],"it":["Marolles"],"cn":[null],"fr":["Marolles"],"sp":["Marolles"],"nl":["Marollen"]}},"zones":{"list":[19,21],"translations":{"de":["Zentrum","S\u00fcden"],"pt":[null,null],"en":["Centre","South"],"it":["Centro","Sud"],"cn":[null,null],"fr":["Centre","Sud"],"sp":["Centro","Sur"],"nl":["Centrum","Zuid"]}},"neca":null,"facebook_id":null,"backoffice_id":149,"location":{"lat":50.8347285,"lon":4.3463817},"region":"brussels","last_updated_at":"2024-06-06T16:22:48+02:00","published_at":"2013-10-19T01:13:19+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":738,"translations":{"de":{"name":"Mus\u00e9e Art et marges","address_street_name":"Rue Haute","address_street_number":"314","address_street_box":null,"email":"info@artetmarges.be","website":"http:\/\/www.artetmarges.be","phone_contact":"+32 2 533 94 90","phone_booking":null,"address_zip":"1000","