treet_box":null,"email":"info@evere.brussels","website":"http:\/\/www.evere.brussels","phone_contact":"+32 2 247 62 62","phone_booking":null,"address_zip":"1140","address_city":"Evere","address_line1":"Sq Servaas Hoedemaekers, 10","address_line2":"1140 Evere","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":null,"facebook_id":null,"backoffice_id":448,"location":{"lat":50.87251981,"lon":4.40329699},"region":"brussels","last_updated_at":"2022-05-03T17:05:06+02:00","published_at":"2013-10-19T01:13:32+02:00","import_origin":null,"external_id":null,"is_in_address_book":false,"is_in_vb_export":false,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/29ee8dcb91a5f72054ed35a0d167532f5ec25b47.jpg","width":1553,"height":1553,"ratio":1,"translations":{"fr":{"title":"Brocante Evere centre","copyright":null},"nl":{"title":"Brocante Evere centre","copyright":null},"en":{"title":"Brocante Evere centre","copyright":null}}}],"dates":[{"day":"2022-06-18","doors":null,"start":"10:00:00","end":"18:00:00","is_soldout":false,"is_canceled":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-05-03T17:05:06+02:00","published_at":"2022-05-03T16:11:22+02:00","backoffice_id":253008,"import_origin":null,"sub_type":"brocante","show_in_agenda":true,"ranking":1},{"id":528307,"date_start":"2022-03-19","date_end":"2022-06-18","date_next":"2022-06-18","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{"list":[258],"translations":{"fr":["Quartiers"],"nl":["Wijken"],"en":["Neighbourhoods"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Balades intimes du Nord-Ouest","shortdescr":"Et si vous partiez en voyage \u00e0 l\u2019int\u00e9rieur du Nord-Ouest de Bruxelles? Venez en d\u00e9couvrir les secrets lors d\u2019une balade intimiste avec les enqu\u00eatrices et enqu\u00eateurs qui ont \u00e9crit le \u00ab Guide intime du Nord-Ouest \u00bb, un livre collectif cr\u00e9\u00e9 en plein confinement.","longdescr":"Et si vous partiez en voyage \u00e0 l\u2019int\u00e9rieur du Nord-Ouest de Bruxelles? Venez en d\u00e9couvrir les secrets lors d\u2019une balade intimiste avec les enqu\u00eatrices et enqu\u00eateurs qui ont \u00e9crit le \u00ab Guide intime du Nord-Ouest \u00bb. A la mani\u00e8re d'un p\u00e8lerinage ou d'une marche en montagne, ils et elles vous emm\u00e8nent dans nos rues, port\u00e9s par les textes du guide, pendant toute une apr\u00e8s-midi... avec, \u00e0 la cl\u00e9, une pause go\u00fbter !\r\n\r\nLe \u00ab Guide intime \u00bb a \u00e9t\u00e9 \u00e9crit collectivement d'octobre 2020 \u00e0 juin 2021 par plus de 50 habitant\u00b7es de Berchem-Sainte-Agathe, Ganshoren, Jette et Koekelberg. Cr\u00e9\u00e9 pendant le confinement, il explore le th\u00e8me du voyage \u00e0 l'int\u00e9rieur : \u00eatre confin\u00e9\u00b7e dans un territoire c'est \u00eatre amen\u00e9 \u00e0 le red\u00e9couvrir autrement, et c'est aussi ouvrir nos propres fronti\u00e8res entre folie et normalit\u00e9. Nous vous parlerons de corps, de handicap, d\u2019amour, d\u2019immigration, de temp\u00eate, de fronti\u00e8res int\u00e9rieures, de respiration et de bien d\u2019autres choses\u2026\r\n\r\nSamedi 19 mars : D\u2019un monde \u00e0 l\u2019autre, marche autour de la fronti\u00e8re de Bruxelles - 4km\r\nRendez-vous \u00e0 13 h devant l\u2019h\u00f4pital UZ, Jette (arr\u00eat de tram 9)\r\nLes enqu\u00eateurs et enqu\u00eatrices vous embarquent depuis l\u2019h\u00f4pital vers les marais, \u00e0 travers la for\u00eat jusqu\u2019en Flandres. Au programme, \u00e9coute de voix qui racontent la vie, la naissance et la mort. Qui parlent de travers\u00e9es de fronti\u00e8res physiques ou mentales. Qui \u00e9voquent les langues, le bilinguisme, les mots dans le vent.\r\nLectures : \u00ab Dialogue avec moi-m\u00eame \u00bb ; \u00ab Action : observez le cycle de la vie \u00bb ; \u00ab Appels \u00e0 traverser une fronti\u00e8re \u00bb ; po\u00e9sies \u00ab Emball\u00e9 \u00bb \u00ab Cl\u00e9 \u00bb \u00ab Fronti\u00e8re lumi\u00e8re \u00bb.\r\n\r\n \r\nSamedi 30 avril : Ville refoul\u00e9e, en qu\u00eate du patrimoine vivant et de l\u2019eau sous le b\u00e9ton - 4km\r\nRendez-vous \u00e0 13 h \u00e0 la Grotte Notre-Dame de Lourdes, Jette.\r\nLes guides nous entra\u00eenent \u00e0 travers la ville, dans une sorte de p\u00e8lerinage moderne. \u00c0 la recherche de nos anc\u00eatres, de notre histoire, de l\u2019eau qui a \u00e9t\u00e9 enterr\u00e9e sous les rues de Bruxelles il y a longtemps et qui commence \u00e0 ressurgir. Et qui r\u00e9veille nos sensations.\r\nLectures : \u00ab Histoire : la Grotte Notre-Dame de Lourdes \u00bb ; \u00ab Action : entretenez un h\u00e9ritage imaginaire \u00bb ; po\u00e9sie \u00ab Tournez \u00e0 gauche \u00bb ; \u00ab Dialogue avec un activiste de l\u2019eau \u00bb ; \u00ab Action : ressentez l\u2019adr\u00e9naline \u00bb ; \u00ab Action : passez vos mains dans la source \u00bb.\r\n\r\n\r\nSamedi 18 juin : Voyage en terres cach\u00e9es, r\u00eaves et ill\u00e9galit\u00e9 - 4km\r\nRendez-vous \u00e0 13 h au Ch\u00e2teau de Rivieren, Ganshoren (devant le restaurant les Potes en Toques, Dr\u00e8ve du Ch\u00e2teau 71)\r\nEn route vers le plus vieux ch\u00e2teau (priv\u00e9) de Bruxelles avec au passage, une lecture des textes sur le r\u00eave, l\u2019inconscient et ses vertus th\u00e9rapeutiques et des rencontres avec des voyageurs ill\u00e9gaux sans-papiers et habitants des for\u00eats.\r\nLectures : \u00ab Dialogue sur les r\u00eaves \u00bb ; \u00ab Dialogue au squat Classic \u00bb ; \u00ab Dialogue avec un voyageur \u00bb ; \u00ab Action : regardez \u00e0 travers.","performers":"Habitant.e.s des images","boxoffice_url":null,"website":"http:\/\/www.habitants-des-images.be\/guide\/","email":"admin@habitants-des-images.be","phone_contact":null,"phone_booking":"+32 492 39 57 67","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/528307.html"},"nl":{"name":"Balades intimes du Nord-Ouest","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/528307.html"},"en":{"name":"Balades intimes du Nord-Ouest","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/528307.html"},"de":{"name":"Balades intimes du Nord-Ouest","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/528307.html"},"it":{"name":"Balades intimes du Nord-Ouest","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/528307.html"},"sp":{"name":"Balades intimes du Nord-Ouest","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/528307.html"},"pt":{"name":"Balades intimes du Nord-Ouest","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detai