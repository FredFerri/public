ogs\/news\/expo-women-coloring-the-world","email":"info@montdepiete.be","phone_contact":"+33025121385","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50003406"},"en":{"name":"\u00ab Women coloring the world \u00bb","shortdescr":null,"longdescr":null,"performers":"Marianne De Rauw (painter), Molly Winckelmans (painter) and Chris Van lent (painter)","boxoffice_url":null,"website":"https:\/\/montdepiete.be\/blogs\/news\/expo-women-coloring-the-world","email":"info@montdepiete.be","phone_contact":"+33025121385","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50003406"},"it":{"name":"Expo \u00ab Women coloring the world \u00bb","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/montdepiete.be\/blogs\/news\/expo-women-coloring-the-world","email":"info@montdepiete.be","phone_contact":"+33025121385","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50003406"},"cn":{"name":"Expo \u00ab Women coloring the world \u00bb","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/montdepiete.be\/blogs\/news\/expo-women-coloring-the-world","email":"info@montdepiete.be","phone_contact":"+33025121385","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50003406"},"fr":{"name":"\u00ab Women coloring the world \u00bb","shortdescr":"3 femmes,\n3 individualit\u00e9s,\n3 mondes diff\u00e9rents,\n3 approches diff\u00e9rentes de et avec leurs natures cr\u00e9atives, et pourtant reli\u00e9es par l'\u00e9merveillement, l'admiration et l'amour de la vie et de la nature.\nL'une exp\u00e9rimente inlassablement l'acrylique et le gesso.\nL'autre appr\u00e9cie le flux de l'eau et de la couleur, tandis que le troisi\u00e8me revient \u00e0 la technique ancestrale de la peinture botanique.","longdescr":"3 femmes,\n3 individualit\u00e9s,\n3 mondes diff\u00e9rents,\n3 approches diff\u00e9rentes de et avec leurs natures cr\u00e9atives, et pourtant reli\u00e9es par l'\u00e9merveillement, l'admiration et l'amour de la vie et de la nature.\nL'une exp\u00e9rimente inlassablement l'acrylique et le gesso.\nL'autre appr\u00e9cie le flux de l'eau et de la couleur, tandis que le troisi\u00e8me revient \u00e0 la technique ancestrale de la peinture botanique.\n\nDates de l'exposition\nDu 20 octobre au 12 novembre 2023\n\nHoraires de l\u2019exposition\nDu jeudi au dimanches (11h - 16h) + ouverture exceptionnelle le mardi 7 novembre (10h - 16h)\n\nVernissage\nLe vendredi 20 octobre 2023 de 18h \u00e0 22h\n\nVisites guid\u00e9es du quartier des Marolles\nJeudi 26 octobre (14h - 16h), samedi 4 et mardi 7 novembre (14h - 16h)\nLangues (bilingue) : Fr\/nl\n\ninitiation \u00e0 l'aquarelle botanique\nVendredis 27 octobre, 3 et 10 novembre de 14h \u00e0 16h\n\nEntr\u00e9e gratuite, sans r\u00e9servation\n\n\u2139 Plus d'infos sur l'expo : https:\/\/montdepiete.be\/blogs\/news\/expo-women-coloring-the-world","performers":"Marianne De Rauw (peintre), Molly Winckelmans (peintre) et Chris Van lent (peintre)","boxoffice_url":null,"website":"https:\/\/montdepiete.be\/blogs\/news\/expo-women-coloring-the-world","email":"info@montdepiete.be","phone_contact":"+33025121385","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50003406"},"sp":{"name":"Expo \u00ab Women coloring the world \u00bb","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/montdepiete.be\/blogs\/news\/expo-women-coloring-the-world","email":"info@montdepiete.be","phone_contact":"+33025121385","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50003406"},"nl":{"name":"\u00ab Women coloring the world \u00bb","shortdescr":"3 vrouwen,\n3 persoonlijkheden,\n3 andere werelden,\n3 verschillende benaderingen van en met hun creatieve aard, en toch...\nverbonden door verwondering, bewondering en liefde voor het leven en de natuur.\nDe ene in onuitputtelijk experimenteren met acryl en gesso.\nDe andere geniet van het vloeien van water en kleur,\nterwijl de derde teruggrijpt naar de aloude techniek van het botanisch fijnschilderen.","longdescr":"Tentoonstelling \u00ab Women coloring the world \u00bb\n3 vrouwen,\n3 persoonlijkheden,\n3 andere werelden,\n3 verschillende benaderingen van en met hun creatieve aard, en toch...\nverbonden door verwondering, bewondering en liefde voor het leven en de natuur.\nDe ene in onuitputtelijk experimenteren met acryl en gesso.\nDe andere geniet van het vloeien van water en kleur,\nterwijl de derde teruggrijpt naar de aloude techniek van het botanisch fijnschilderen.\n \nData van de tentoonstelling\nVan 20 oktober tot 12 november 2023\n\nOpeningsuren van de tentoonstelling\nVan donderdag tot zondag (11u - 16u) + dinsdag 7 november (10u - 16u)\n\nVernissage\nVrijdag 20 oktober 2023 van 18u tot 22u\n\nRondleiding Marollen\nDonderdag 26 oktober (14u - 16u), zaterdag 4 en dinsdag 7 november (14u - 16u)\nTaal (tweetalig): Nl\/fr\n\ninleiding tot botanische aquarellen\nVrijdag 27 oktober, 3 en 10 november van 14u tot 16u\n\nGratis toegang, zonder reservatie\n\n Meer info over de tentoonstelling: https:\/\/montdepiete.be\/nl\/blogs\/news\/expo-women-coloring-the-world","performers":"Marianne De Rauw (kunsternares), Molly Winckelmans (kunsternares) et Chris Van lent (kunsternares)","boxoffice_url":null,"website":"https:\/\/montdepiete.be\/nl\/blogs\/news\/expo-women-coloring-the-world","email":"info@montdepiete.be","phone_contact":"+33025121385","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50003406"}},"place":{"id":221323,"translations":{"de":{"name":"Mont de Pi\u00e9t\u00e9 (Caisse Publique de Pr\u00eats)","address_street_name":"Rue Saint-Ghislain","address_street_number":"1923","address_street_box":null,"email":null,"website"