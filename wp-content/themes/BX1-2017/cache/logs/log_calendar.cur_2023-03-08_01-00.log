on":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert","de":"Konzert","it":"Concerti","sp":"Concierto","pt":null,"cn":null}},"others":{"list":[2],"translations":{"fr":["Classique"],"nl":["Klassiek"],"en":["Classical"],"de":["Klassisch"],"it":["Classica"],"sp":["Cl\u00e1sica"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Eyas Ensemble, quatuor vocal  & piano","shortdescr":"L'Ensemble Eyas est un exceptionnel quatuor vocal avec piano compos\u00e9 de cinq musiciens passionn\u00e9s. Des \u0153uvres connues et moins connues font partie de leur programme.","longdescr":"Leur r\u00e9pertoire s'\u00e9tend du XIXe au XXIe si\u00e8cle et allie romantisme, humour, tradition et cr\u00e9ativit\u00e9. Les quatre chanteurs et le pianiste font vivre cette musique \"les yeux dans les yeux\" au public et travaillent avec les metteurs en sc\u00e8ne Genevi\u00e8ve Damas et Daniel Donies pour mettre en sc\u00e8ne leurs concerts.","performers":"Helga Van Campenhout (soprano)\r\nJo\u00eblle Charlier (mezzo)\r\nJoris Bosman (tenor)\r\nThierry Marchant (bass)\r\nPascale del Marmol (piano)","boxoffice_url":null,"website":"https:\/\/www.lebaixu.be","email":"info@lebaixu.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.547788"},"nl":{"name":"Eyas Ensemble, quatuor vocal  & piano","shortdescr":null,"longdescr":"Hun repertorium gaat van de 19e tot de 21ste eeuw en combineert romantiek, humor, traditie en creativiteit. De vier zangers en pianiste brengen deze muziek 'eye tot eye' naar het publiek en werken voor de enscenering van hun concerten samen met regisseurs Genevi\u00e8ve Damas en Daniel Donies.","performers":"Het Eyas Ensemble is een uitzonderlijk vocaal kwartet met piano bestaande uit vijf gepassioneerde musici. Zowel bekende als minder bekende werken maken deel uit van hun programma.","boxoffice_url":null,"website":"https:\/\/www.lebaixu.be","email":"info@lebaixu.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.547788"},"en":{"name":"Eyas Ensemble, quatuor vocal  & piano","shortdescr":null,"longdescr":"Their repertoire ranges from the 19th to the 21st century and combines romanticism, humour, tradition and creativity. The four singers and pianist bring this music 'eye to eye' to the audience and work with directors Genevi\u00e8ve Damas and Daniel Donies to stage their concerts.","performers":"The Eyas Ensemble is an exceptional vocal quartet with piano consisting of five passionate musicians. Both well-known and lesser-known works are part of their programme.","boxoffice_url":null,"website":"https:\/\/www.lebaixu.be","email":"info@lebaixu.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.547788"},"de":{"name":"Eyas Ensemble, quatuor vocal  & piano","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lebaixu.be","email":"info@lebaixu.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.547788"},"it":{"name":"Eyas Ensemble, quatuor vocal  & piano","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lebaixu.be","email":"info@lebaixu.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.547788"},"sp":{"name":"Eyas Ensemble, quatuor vocal  & piano","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lebaixu.be","email":"info@lebaixu.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.547788"},"pt":{"name":"Eyas Ensemble, quatuor vocal  & piano","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lebaixu.be","email":"info@lebaixu.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.547788"},"cn":{"name":"Eyas Ensemble, quatuor vocal  & piano","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lebaixu.be","email":"info@lebaixu.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.547788"}},"place":{"id":279109,"translations":{"fr":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"info@lebaixu.be","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard, 3","address_line2":"1000 Bruxelles","description_web":"Un lieu atypique et chaleureux dans le quartier de Tour & Taxis \u00e0 Bruxelles pour assister \u00e0 des concerts, des expositions, des projections ou des conf\u00e9rences, ou pour y organiser vos \u00e9v\u00e8nements priv\u00e9s.\r\nUn projet d\u00e9di\u00e9 au \u00ab beau \u00bb sous toutes ses coutures, dont les maitres-mots sont qualit\u00e9, \u00e9changes et rencontres.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Le Baixu","address_street_name":"Picardstraat","address_street_number":"3","address_street_box":null,"email":"info@lebaixu.be","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Picardstraat, 3","address_line2":"1000 Brussel","description_web":"De naam \"Baixu\" betekent \"mooi\" in de taal van de Pataxos indianen die in de zuidelijke staat Bahia (Brazili\u00eb) wonen. Dit woord staat voor de ambitie van het project en de kwaliteit van de culturele evenementen, maar ook voor de verbondenheid van de initiatiefnemers met de Braziliaanse cultuur. \r\nLe Baixu is ondergebracht in een voormalig industrieel gebouw in het hart van de trendy Brusselse Tour & Taxis wijk. Een atypische en warme plek bedoeld voor concerten, tentoonstellingen, filmvertoningen en conferenties en waar je ook priv\u00e9 evenementen kan organiseren. Het is een volledig uitgeruste, multidisciplinaire culturele ruimte met een oppervlakte van 150 m2, gewijd aan de \"schoonheid\" in al haar vormen. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"info@lebaixu.be","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue Picard, 3","address_line2":"1000 Brussels","description_web":"The name \u201cBaixu\u201d means \u201cbeautiful\u201d in the native language of the Patax\u00f3 peoples, indigenous to the south of the state of Bahia in Brazil. This word represents both the ambition of the project and the quality of the cultural events presented, as well as the founders\u2019 attachment to Brazilian culture. Baisu is a quaint and welcoming space in the Tour & Taxis neighborhood in Brussels, which hosts concerts, expositions, screenings, or conferences \u2013 or where you can organise your private event.\r\nA project dedicated to \u201cbeauty\u201d in all its forms, where the keywords are quality, exchange and interaction.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":