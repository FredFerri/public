":530782,"date_start":"2022-09-29","date_end":"2022-09-29","date_next":"2022-09-29","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Les secrets du square Ambiorix","shortdescr":"Le square comme vous ne l\u2019avez jamais vu !","longdescr":"Quel est le point commun entre le g\u00e9n\u00e9ral romain C\u00e9sar, le biologiste Pasteur, le Palais des Beaux Arts et le mouvement ouvrier belge ? Nous partirons \u00e0 sa recherche en parcourant le square Ambiorix dans la qui\u00e9tude de fin de journ\u00e9e entre points d\u2019eau, sculptures et massifs verdoyants : le square comme vous ne l\u2019avez jamais vu ! Une dose d\u2019histoire agr\u00e9ment\u00e9e d\u2019une pinc\u00e9e d\u2019histoire de l\u2019art, beaucoup de curiosit\u00e9 et l\u2019oeil aux aguets, tournez et vous obtiendrez une belle balade d\u2019\u00e9t\u00e9 !","performers":null,"boxoffice_url":null,"website":"http:\/\/www.arau.org","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.530782"},"nl":{"name":"Les secrets du square Ambiorix","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.530782"},"en":{"name":"Les secrets du square Ambiorix","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.530782"},"de":{"name":"Les secrets du square Ambiorix","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.530782"},"it":{"name":"Les secrets du square Ambiorix","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.530782"},"sp":{"name":"Les secrets du square Ambiorix","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.530782"},"pt":{"name":"Les secrets du square Ambiorix","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.530782"},"cn":{"name":"Les secrets du square Ambiorix","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.530782"}},"place":{"id":242906,"translations":{"fr":{"name":"Squares Ambiorix, Marie-Louise et Marguerite","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Squares Ambiorix, Marie-Louise et Marguerite","address_line2":"1000 Bruxelles","description_web":"Les squares Ambiorix, Marie-Louise et Marguerite sont am\u00e9nag\u00e9s en \u00e9tages dans l\u2019ancienne vall\u00e9e du Maelbeek, \u00e0 proximit\u00e9 du quartier europ\u00e9en. Ils sont situ\u00e9s dans le quartier dit \u00ab des squares \u00bb, architecturalement riche gr\u00e2ce \u00e0 ses maisons de styles \u00ab n\u00e9o \u00bb \u2013 n\u00e9o-renaissance ou n\u00e9o-gothique \u2013 et Art nouveau, qui se m\u00ealent \u00e0 l\u2019\u00e9clectisme. L\u2019eau est l\u2019\u00e9l\u00e9ment principal de cette cascade de parcs et reconstitue en quelque sorte l\u2019ancien cours du Maelbeek en \u00e9tant int\u00e9gr\u00e9 \u00e0 chacun d\u2019entre eux.\r\n\r\nLe square Ambiorix est am\u00e9nag\u00e9 en terrasses \u00e0 la fran\u00e7aise avec des espaces g\u00e9om\u00e9triques, des sentiers rectilignes, des parterres, des fontaines, des sculptures\u2026\r\n\r\nLe square Marie-Louise est principalement occup\u00e9 par un \u00e9tang, o\u00f9 habitent des tortues de Floride. Il est pittoresque et romantique gr\u00e2ce \u00e0 ses rocailles (jet d\u2019eau jaillissant d\u2019un rocher, fausse grotte envahie par la v\u00e9g\u00e9tation et cascades) et ses jardins anglais.\r\n\r\nQuant au square Marguerite, cet \u00ab agora space \u00bb accueille les jeunes et les sportifs qui peuvent s\u2019y d\u00e9fouler. Profitez aussi d\u2019une plaine de jeux et d\u2019une pergola.\r\n\r\nLe long des squares, admirez l\u2019H\u00f4tel van Eetvelde et la Maison Saint-Cyr, v\u00e9ritables chefs-d'\u0153uvre de l\u2019Art nouveau. Promenez-vous \u00e9galement dans le parc de Bruxelles, L\u00e9opold ou du Cinquantenaire et visitez leurs diff\u00e9rents mus\u00e9es, ou encore le mus\u00e9e Charlier.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Ambiorix-, Maria-Louiza- en Margaretasquares","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Ambiorix-, Maria-Louiza- en Margaretasquares","address_line2":"1000 Brussel","description_web":"Waar vroeger de vallei van de Maalbeek zich bevond, werden op de Ambiorix-, de Maria-Louiza- en de Margaretasquares groene ruimtes aangelegd.\r\n\r\nDe Ambiorixsquare bestaat vooral uit fonteinen en grasperken, terwijl het groen langs de Maria-Louizasquare in romantische tuinen rond waterpartijen (waterval, vijver en fonteinen) gegoten werd. Op de Margaretasquare is er dan weer plaats ingeruimd voor sport en spel, al is er ook daar een waterpartij en een pergola voor minder actieve bezoekers. \r\n\r\nHistorisch waren deze groene ruimtes eigenlijk landelijk gebied. Daarna evolueerden ze in de richting van een residenti\u00eble zone, waar de burgerij zich kwam vestigen. Vandaar dat ze nu afgeboord zijn met talloze herenhuizen, vaak in art nouveaustijl.\r\n\r\nUitrusting : \r\n- Agoraspace\r\n- Speeltuin 8-12 jaar\r\n- Zandbak\r\n- Banken\r\n- Waterkraantjes\r\n- Waterval\r\n- Fontein\r\n- Speeltuin 3-7 jaar\r\n- Tafeltennistafels\r\n- Basketbalveld \r\n\r\nToegankelijkheid : \r\nDe terrassen op de Ambiorixsquare zijn met elkaar verbonden door trappen. Maar verder zijn de grote lanen zeker goed toegankelijk voor personen met verminderde mobiliteit.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"The Ambiorix, Marie-Louise and Marguerite squares","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"The Ambiorix, Marie-Louise and Marguerite squares","address_line2":"1000 Brussels","description_web":"The Ambiorix, Marie-Louise and Marguerite squares are located in the former valley of the Maelbeek river, near the European Quarter. They are located in the so-called \"squares\" district, which is architecturally rich thanks to its neo-renaissance, neo-gothic and Art Nouveau houses, which intermingle with the eclecticism. Water is the primary element of this cascade of parks and is integrated into each of them, reconstituting the old course of the Maelbeek.\r\n\r\nSquare Ambiorix is laid out in French terraces with geometric spaces, straight paths, flowerbeds, fountains, sculptures\u2026\r\n\r\nSquare Marie-Louise is dominated by a pond, which is home to Florida tortoises. Its rock garden containing a fountain, a false grotto overgrown with vegetation and waterfalls and its English gardens give it a picturesque and romantic feel.\r\n\r\nAs for Square Marguerite, this \"agora space\" has a playground and a pergola and welcomes young people and athletes looking to let off steam.\r\n\r\nAlong the squares, admire the Hotel van Eetvelde and Saint-Cyr House, true masterpieces of Art Nouveau. Take a walk in Brussels Park, Leopold Park or Cinquantenaire Park and visit their museums and the Charlier Museum in nearby Saint-Josse-ten-Noode.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Parkanlagen Squares Ambiorix, Marie-Louise und Marguerite","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Parkanlagen Squares Ambiorix, Marie-Louise und Marguerite","address_line2":"1000 Bruxelles","description_web":"Die Squares Ambiorix, Marie-Louise und Marguerite wurden im ehemaligen Maelbeek-Tal in der N\u00e4he des Europaviertels angelegt. Sie befinden sich im sogenannten \"Squares\"-Viertel, das auch architektonisch absolut sehenswert ist: Hier mischen sich Neorenaissance, Neogotik, Jugendstil und Eklektizismus zu einem sch\u00f6nen architektonischen Ensemble. Wasserelemente ziehen sich wie ein roter Faden durch die Parks und erinnern an den historischen Lauf des Maelbeek-Fl\u00fcsschens.\r\n\r\nDer Square Ambiorix zeichnet sich durch seinen franz\u00f6sischen Terrassenstil mit geometrischen Fl\u00e4chen, geradlinigen Wegen, Beeten, Springbrunnen und Skulpturen aus.\r\n\r\nIm Square Marie-Louise dominiert der Teich mit Florida-Schildkr\u00f6ten das malerische und romantische Gesamtbild mit Steing\u00e4rten, Felsenspringbrunnen, einer von Pflanzen \u00fcberwucherten Grotte, Wasserf\u00e4llen und englischen G\u00e4rten.\r\n\r\nDer Square Marguerite ist eine Art \"Agora\" f\u00fcr Jugendliche und Sportler, die sich hier austoben k\u00f6nnen. Auch ein Spielplatz und eine Pergola sind vorhanden.\r\n\r\nEntlang der Squares k\u00f6nnen Sie mit dem H\u00f4tel van Eetvelde und dem Maison Saint-Cyr zwei Jugendstilperlen bewundern. Weitere Spazierg\u00e4nge bieten sich im Parc de Bruxelles, im Parc Leopold oder im Parc du Cinquantenaire an, wo verschiedene Museen, darunter das Mus\u00e9e Charlier, Ihren Weg s\u00e4umen.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Square Ambiorix","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Square Ambiorix","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Plaza Ambiorix","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Plaza Ambiorix","address_line2":"1000 Bruxelles","description_web":"En el siglo XVlll, este conjunto de jardines era un lugar muy rural, que entonces fue transformado en un \u00e1rea residencial de clase media. Esto explica por qu\u00e9 estos peque\u00f1os jardines p\u00fablicos se encuentran junto a numerosas mansiones Art Nouveau. Hay una fuente, una cascada, grutas artificiales y un \u00e1rea recreativa.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Squares Ambiorix, Marie-Louise et Marguerite","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Squares Ambiorix, Marie-Louise et Marguerite","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Squares Ambiorix, Marie-Louise et Marguerite","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Squares Ambiorix, Marie-Louise et Marguerite","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[9],"translations":{"fr":["Quartier europ\u00e9en"],"nl":["Europese wijk"],"en":["European Quarter"]}},"zones":{"list":[22],"translations":{"fr":["Est"],"nl":["Oost"],"en":["East"]}},"neca":null,"facebook_id":null,"backoffice_id":5306,"location":{"lat":50.84697683,"lon":4.38365221},"region":"brussels","last_updated_at":"2022-08-10T20:35:49+02:00","published_at":"2013-10-19T01:18:25+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":204134,"translations":{"fr":{"name":"Arau - Atelier de Recherche et d'Action Urbaines","address_street_name":"Boulevard Adolphe Max","address_street_number":null,"address_street_box":null,"email":"info@arau.org","website":"http:\/\/www.arau.org","phone_contact":"+32 2 219 33 45","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Boulevard Adolphe Max","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Arau - Atelier de Recherche et d'Action Urbaines","address_street_name":"Adolphe Maxlaan","address_street_number":null,"address_street_box":null,"email":"info@arau.org","website":"http:\/\/www.arau.org","phone_contact":"+32 2 219 33 45","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Adolphe Maxlaan","address_line2":"1000 Brussel","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Arau - Atelier de Recherche et d'Action Urbaines","address_street_name":"Boulevard Adolphe Max","address_street_number":null,"address_street_box":null,"email":"info@arau.org","website":"http:\/\/www.arau.org","phone_contact":"+32 2 219 33 45","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Boulevard Adolphe Max","address_line2":"1000 Brussels","description_web":"Since 1977, ARAU has been a pioneer of urban tourism in Brussels and has offered unconventional guided tours that raise awareness of urban democracy and the role of residents in the development of their city. Over the decades, ARAU has also developed an expert knowledge of the city\u2019s architectural and planning history, which it has passed on through its programme of guided tours that continue to play an essential role in the defence of the heritage buildings of Brussels.\r\n\r\nOur catalogue includes: guided tours about the history and architectural heritage of Brussels, discovery of neighbourhoods, and tours over current projects on urban development.\r\n\r\nARAU can arrange these tours on request for private groups throughout the year, tailored to your specific requirements regarding date, time, duration and language (French, English, Dutch, German, Spanish or Italian). So if you would like to follow a guided tour of Brussels with qualified guides in a convivial atmosphere, contact us!","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Arau - Atelier de Recherche et d'Action Urbaines","address_street_name":"Boulevard Adolphe Max","address_street_number":null,"address_street_box":null,"email":"info@arau.org","website":"http:\/\/www.arau.org","phone_contact":"+32 2 219 33 45","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Boulevard Adolphe Max","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Arau - Atelier de Recherche et d'Action Urbaines","address_street_name":"Boulevard Adolphe Max","address_street_number":null,"address_street_box":null,"email":"info@arau.org","website":"http:\/\/www.arau.org","phone_contact":"+32 2 219 33 45","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Boulevard Adolphe Max","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Arau - Atelier de Recherche et d'Action Urbaines","address_street_name":"Boulevard Adolphe Max","address_street_number":null,"address_street_box":null,"email":"info@arau.org","website":"http:\/\/www.arau.org","phone_contact":"+32 2 219 33 45","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Boulevard Adolphe Max","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Arau - Atelier de Recherche et d'Action Urbaines","address_street_name":"Boulevard Adolphe Max","address_street_number":null,"address_street_box":null,"email":"info@arau.org","website":"http:\/\/www.arau.org","phone_contact":"+32 2 219 33 45","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Boulevard Adolphe Max","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn