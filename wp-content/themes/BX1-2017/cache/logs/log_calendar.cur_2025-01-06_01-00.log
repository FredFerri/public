":5700001969,"date_start":"2025-01-28","date_end":"2025-02-01","date_next":"2025-01-28","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-10-01T17:52:05+02:00","published_at":"2024-10-01T17:41:39+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":308767,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"theatre","ranking":0.7368062997280773,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":49,"translations":{"de":"Theater","pt":null,"en":"Theatre","it":"Teatro","cn":null,"fr":"Th\u00e9\u00e2tre","sp":"Teatro","nl":"Theater"}},"others":{}},"translations":{"de":{"name":"Le fatal dyptique : La tr\u00e8s tragique histoire d'Oedipe + Antigone vs Cr\u00e9on","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.roseraie.org\/fatal-diptyque","email":"secretariat@roseraie.org","phone_contact":null,"phone_booking":"+32 2 376 46 45","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700001969"},"pt":{"name":"Le fatal dyptique : La tr\u00e8s tragique histoire d'Oedipe + Antigone vs Cr\u00e9on","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.roseraie.org\/fatal-diptyque","email":"secretariat@roseraie.org","phone_contact":null,"phone_booking":"+32 2 376 46 45","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700001969"},"en":{"name":"Le fatal dyptique : La tr\u00e8s tragique histoire d'Oedipe + Antigone vs Cr\u00e9on","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.roseraie.org\/fatal-diptyque","email":"secretariat@roseraie.org","phone_contact":null,"phone_booking":"+32 2 376 46 45","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700001969"},"it":{"name":"Le fatal dyptique : La tr\u00e8s tragique histoire d'Oedipe + Antigone vs Cr\u00e9on","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.roseraie.org\/fatal-diptyque","email":"secretariat@roseraie.org","phone_contact":null,"phone_booking":"+32 2 376 46 45","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700001969"},"cn":{"name":"Le fatal dyptique : La tr\u00e8s tragique histoire d'Oedipe + Antigone vs Cr\u00e9on","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.roseraie.org\/fatal-diptyque","email":"secretariat@roseraie.org","phone_contact":null,"phone_booking":"+32 2 376 46 45","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700001969"},"fr":{"name":"Le fatal dyptique : La tr\u00e8s tragique histoire d'Oedipe + Antigone vs Cr\u00e9on","shortdescr":"Une double histoire qui bousculera le public de la com\u00e9die \u00e0 la trag\u00e9die. Et inversement !","longdescr":"Deux spectacles pr\u00e9sent\u00e9s en tout public et en scolaires. Visibles s\u00e9par\u00e9ment comme des unitaires ou \u00e0 la suite l\u2019un de l\u2019autre. Comme une mini-s\u00e9rie th\u00e9\u00e2trale racontant la saga des Labdacides, la famille maudite d\u2019\u0152dipe, Antigone, Cr\u00e9on et les autres. Le premier \u00e9pisode est un condens\u00e9 de \u0152dipe Roi et de \u0152dipe \u00e0 Colone, de Sophocle.\n\nCes deux pi\u00e8ces racontent la trajectoire du h\u00e9ros mythique, du r\u00e8gne \u00e0 l\u2019exil, jusqu\u2019\u00e0 sa mort. Elles posent des questions fondamentales : qui est ce myst\u00e9rieux animal qui marche sur quatre pattes le matin, deux le midi et trois le soir ? D\u2019o\u00f9 vient-il et o\u00f9 va-t-il ? Le sait-il ?\n\nLe second \u00e9pisode est un face \u00e0 face entre un chef d\u2019\u00e9tat et une jeune f ille. Un homme de t\u00eate contre une fille de c\u0153ur. Tous les deux campant de plus en plus radicalement sur leur position. Il y aura match et tout le monde sera perdant..","performers":"Cr\u00e9ation originale de Beno\u00eet Verhaert inspir\u00e9e des Antigones \u00e0 travers le temps. Mise en sc\u00e8ne Beno\u00eet Verhaert. Interpr\u00e9tation Marina Yerl\u00e8s,  Sagadige, St\u00e9phane Pirard, Beno\u00eet Verhaert. Cr\u00e9ation lumi\u00e8re Christian Fran\u00e7ois. Diffusion Manuela Leone. Une cr\u00e9ation du Th\u00e9\u00e2tre de la Chute, avec l\u2019aide de la F\u00e9d\u00e9ration Wallonie Bruxelles.\n\n","boxoffice_url":null,"website":"https:\/\/www.roseraie.org\/fatal-diptyque","email":"secretariat@roseraie.org","phone_contact":null,"phone_booking":"+32 2 376 46 45","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700001969"},"sp":{"name":"Le fatal dyptique : La tr\u00e8s tragique histoire d'Oedipe + Antigone vs Cr\u00e9on","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.roseraie.org\/fatal-diptyque","email":"secretariat@roseraie.org","phone_contact":null,"phone_booking":"+32 2 376 46 45","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700001969"},"nl":{"name":"Le fatal dyptique : La tr\u00e8s tragique histoire d'Oedipe + Antigone vs Cr\u00e9on","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.roseraie.org\/fatal-diptyque","email":"secretariat@roseraie.org","phone_contact":null,"phone_booking":"+32 2 376 46 45","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700001969"}},"place":{"id":231528,"translations":{"de":{"name":"La Roseraie","address_street_name":"Chauss\u00e9e d'Alsemberg","address_street_number":"1299","address_street_box":null,"email":"s