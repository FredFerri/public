ds"],"opening":{"day":"2023-03-30","end":"14:00:00","is_only_by_appointment":false,"start":"11:00:00","timestamp":"2023-03-30T11:00:00"}},{"id":50005404,"date_start":"2024-01-29","date_end":"2024-01-29","date_next":"2024-01-29","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2023-12-18T09:15:04+01:00","published_at":"2023-12-18T09:04:50+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":290994,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"theatre","ranking":1.2599210498948732,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":49,"translations":{"de":"Theater","pt":null,"en":"Theatre","it":"Teatro","cn":null,"fr":"Th\u00e9\u00e2tre","sp":"Teatro","nl":"Theater"}},"others":{}},"translations":{"de":{"name":"Lecture-spectacle M\u00e9moire de fille d'Annie Ernaux","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.compagniealbertine.be\/portraits\/memoire-de-filles\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50005404"},"pt":{"name":"Lecture-spectacle M\u00e9moire de fille d'Annie Ernaux","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.compagniealbertine.be\/portraits\/memoire-de-filles\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50005404"},"en":{"name":"Lecture-spectacle M\u00e9moire de fille d'Annie Ernaux","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.compagniealbertine.be\/portraits\/memoire-de-filles\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50005404"},"it":{"name":"Lecture-spectacle M\u00e9moire de fille d'Annie Ernaux","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.compagniealbertine.be\/portraits\/memoire-de-filles\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50005404"},"cn":{"name":"Lecture-spectacle M\u00e9moire de fille d'Annie Ernaux","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.compagniealbertine.be\/portraits\/memoire-de-filles\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50005404"},"fr":{"name":"Lecture-spectacle M\u00e9moire de fille d'Annie Ernaux","shortdescr":"Dans M\u00e9moire de fille, Annie Ernaux replonge dans l\u2019\u00e9t\u00e9 1958, celui de sa premi\u00e8re nuit avec un homme, \u00e0 la colonie de S dans l\u2019Orne. Nuit dont l\u2019onde de choc s\u2019est propag\u00e9e violemment dans son corps et sur son existence durant deux ann\u00e9es.","longdescr":"Pour la premi\u00e8re lecture-spectacle musicale de lann\u00e9e 2024, le roman d'Annie Ernaux M\u00e9moire de fille sera mis \u00e0 l'honneur lors de trois dates en janvier.\n\nLe jeudi 25 janvier \u00e0 20h30, \u00e0 la Ferme de Martinrou.\nLe jeudi 29 janvier \u00e0 20h15, au Centre Culturel de Schaerbeek.\nLe Mardi 30 janvier \u00e0 20h, au Wolubilis.\n\nDans M\u00e9moire de fille, Annie Ernaux replonge dans l\u2019\u00e9t\u00e9 1958, celui de sa premi\u00e8re nuit avec un homme, \u00e0 la colonie de S dans l\u2019Orne. Nuit dont l\u2019onde de choc s\u2019est propag\u00e9e violemment dans son corps et sur son existence durant deux ann\u00e9es.\nS\u2019appuyant sur des images ind\u00e9l\u00e9biles de sa m\u00e9moire, des photos et des lettres \u00e9crites \u00e0 ses amies, elle interroge cette fille qu\u2019elle a \u00e9t\u00e9 dans un va et-vient implacable entre hier et aujourd\u2019hui.\n\nLa lectrice sera accompagn\u00e9e par une danseuse de hip hop. Une partition \u00e0 deux voix pour mettra en miroir les rapports au corps : \u00e9crits\/dits et dans\u00e9s de deux femmes de g\u00e9n\u00e9rations diff\u00e9rentes.\n\nLe texte est mis en voix par Sandrine Bonjean et lu par C\u00e9cile Van Snick. Adeola Hawna, danseuse Hip Hop, accompagnera en dansant la lecture-spectacle musicale.\n\nPionni\u00e8re des textes autobiographiques, l\u2019autrice livre un r\u00e9cit magnifique et bouleversant, sur l\u2019\u00e9t\u00e9 de ses 18 ans, en 1958, moment de honte et d\u2019humiliation. Formidable le\u00e7on sur la m\u00e9moire, sur la conscience de soi, sur la possibilit\u00e9 de la saisir, d\u2019en faire le r\u00e9cit et de lui donner un sens.\n\nAnnie Ernaux n\u00e9e en 1940 est l\u2019autrice de dix-huit livres aux \u00c9ditions Gallimard parmi lesquels La place, Passion simple, L\u2019\u00e9v\u00e9nement, Les ann\u00e9es, M\u00e9moire de fille, et derni\u00e8rement, Le jeune homme. Elle a re\u00e7u le prix litt\u00e9raire de la fondation Prince Pierre de Monaco en 2021 et le prix Nobel de Litt\u00e9rature en 2022.","performers":"Mise en voix, Sandrine Bonjean. Lecture, C\u00e9cile Van Snick. Danse Hip hop, Adeola Hawna.","boxoffice_url":null,"website":"https:\/\/www.compagniealbertine.be\/portraits\/memoire-de-filles\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50005404"},"sp":{"name":"Lecture-spectacle M\u00e9moire de fille d'Annie Ernaux","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.compagniealbertine.be\/portraits\/memoire-de-filles\/","email":null,"phone_c