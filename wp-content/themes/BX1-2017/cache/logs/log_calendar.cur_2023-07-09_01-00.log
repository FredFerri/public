09:33:20+02:00","backoffice_id":279290,"import_origin":null,"sub_type":"festival","show_in_agenda":true,"ranking":0.33333333333333},{"id":555536,"date_start":"2023-05-25","date_end":"2023-07-20","date_next":"2023-07-08","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung","it":"Esposizioni","sp":"Exhibici\u00f3n","pt":null,"cn":null}},"others":{"list":[24,34],"translations":{"fr":["Galeries d'art","Pluridisciplinaire"],"nl":["Galeries","Pluridisciplinair"],"en":["Art Galleries","Multidisciplinary"],"de":["Kunstgalerien","Multidisziplin\u00e4r"],"it":["Gallerie d'arte","Multidisciplinare"],"sp":["Galer\u00edas de arte","Multidisciplinar"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Lucile Bertrand, Fran\u00e7ois R\u00e9au","shortdescr":"La galerie Ir\u00e8ne Laub est heureuse de pr\u00e9senter un dialogue entre Lucile Bertrand et Fran\u00e7ois R\u00e9au. L'exposition \"Voyageurs Immobiles\" se pr\u00e9sente comme une exploration m\u00e9ditative du temps et de paysages en perp\u00e9tuelle \u00e9volution. A travers des \u0153uvres sur papier et des installations, les deux artistes proposent leur propre perception, mesure et compr\u00e9hension du monde qui s'\u00e9coule autour d'eux.","longdescr":"Lucile Bertrand est n\u00e9e en 1960 en France, elle vit et travaille \u00e0 Bruxelles (BE).\r\nEntre l\u00e9g\u00e8ret\u00e9 et lourdeur, entre vol et chute, Lucile Bertrand aborde avec po\u00e9sie les th\u00e8mes du d\u00e9placement, de l'absence et de la fragilit\u00e9 de la vie. Ses m\u00e9taphores visuelles dessinent souvent un paysage nuanc\u00e9 de crises humaines et politiques. La litt\u00e9rature et la philosophie nourrissent sa r\u00e9flexion et sa pratique, qui prend de multiples formes - \u0153uvres sur papier, sculptures, vid\u00e9os ou grandes installations in situ.\r\n\r\nFran\u00e7ois R\u00e9au est n\u00e9 en 1978 \u00e0 Niort (FR), il vit et travaille \u00e0 Paris (FR).\r\nPrenant le paysage et ses processus de transformation comme source de r\u00e9flexion, le travail de Fran\u00e7ois R\u00e9au \u00e9voque les th\u00e8mes de la temporalit\u00e9, de l'\u00e9ph\u00e9m\u00e8re et du voyage comme symboles d'un parcours permanent ou de toutes les \u00e9chapp\u00e9es possibles. L'attention po\u00e9tique et singuli\u00e8re qu'il porte au monde est empreinte de souvenirs, de r\u00e9alit\u00e9, d'imaginaire et de fiction, mais aussi de myst\u00e8re et de spiritualit\u00e9.","performers":"Lucile Bertrand\r\nFran\u00e7ois R\u00e9au","boxoffice_url":null,"website":"http:\/\/www.irenelaubgallery.com","email":"info@irenelaubgallery.be","phone_contact":"+32 2 647 55 16","phone_booking":"+32 2 647 55 16","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.555536"},"nl":{"name":"Lucile Bertrand, Fran\u00e7ois R\u00e9au","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.irenelaubgallery.com","email":"info@irenelaubgallery.be","phone_contact":"+32 2 647 55 16","phone_booking":"+32 2 647 55 16","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.555536"},"en":{"name":"Lucile Bertrand, Fran\u00e7ois R\u00e9au","shortdescr":"Ir\u00e8ne Laub gallery is delighted to present a dialogue between Lucile Bertrand and Fran\u00e7ois R\u00e9au. The exhibition \u201cVoyageurs Immobiles\u201d unfolds as a meditative exploration of time and ever-changing landscapes. Through works on paper and installations, both artists offer their own perception, measure and understanding of the world that flows around them.","longdescr":"Lucile Bertrand was born in 1960 in France, she lives and works in Brussels (BE)\r\nBetween lightness and heaviness, between flight and fall, Lucile Bertrand poetically addresses the themes of displacement, absence and the fragility of life. Her visual metaphors often draw a nuanced landscape of human and political crises. Literature and philosophy inform her reflection and her practice, which takes many forms \u2013 works on paper, sculpture, video, or large-scale site-specific installations.\r\n\r\nFran\u00e7ois R\u00e9au was born in 1978 in Niort (FR), he lives and works in Paris (FR)\r\nTaking landscape and its processes of transformation as a source of reflection, Fran\u00e7ois R\u00e9au\u2019s work evokes the themes of temporality, ephemera and travel as symbols of an ongoing journey, or of all possible escapes. The poetic and singular attention he pays to the world is imbued with memories, reality, imagination and fiction, but also marked by mystery and spirituality.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.irenelaubgallery.com","email":"info@irenelaubgallery.be","phone_contact":"+32 2 647 55 16","phone_booking":"+32 2 647 55 16","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.555536"},"de":{"name":"Lucile Bertrand, Fran\u00e7ois R\u00e9au","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.irenelaubgallery.com","email":"info@irenelaubgallery.be","phone_contact":"+32 2 647 55 16","phone_booking":"+32 2 647 55 16","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.555536"},"it":{"name":"Lucile Bertrand, Fran\u00e7ois R\u00e9au","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.irenelaubgallery.com","email":"info@irenelaubgallery.be","phone_contact":"+32 2 647 55 16","phone_booking":"+32 2 647 55 16","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.555536"},"sp":{"name":"Lucile Bertrand, Fran\u00e7ois R\u00e9au","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.irenelaubgallery.com","email":"info@irenelaubgallery.be","phone_contact":"+32 2 647 55 16","phone_booking":"+32 2 647 55 16","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.555536"},"pt":{"name":"Lucile Bertrand, Fran\u00e7ois R\u00e9au","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.irenelaubgallery.com","email":"info@irenelaubgallery.be","phone_contact":"+32 2 647 55 16","phone_booking":"+32 2 647 55 16","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.555536"},"cn":{"name":"Lucile Bertrand, Fran\u00e7ois R\u00e9au","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.irenelaubgallery.com","email":"info@irenelaubgallery.be","phone_contact":"+32 2 647 55 16","phone_booking":"+32 2 647 55 16","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.555536"}},"place":{"id":248003,"translations":{"fr":{"name":"Ir\u00e8ne Laub Gallery","address_street_name":"Rue Van Eyck","address_street_number":"29","address_street_box":null,"email":"info@irenelaubgallery.be","website":"http:\/\/www.irenelaubgallery.com","phone_contact":"+32 2 647 55 16","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Van Eyck, 29","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":"LAUB","virtual_visit":null},"nl":{"name":"Ir\u00e8ne Laub Gallery","address_street_name":"Van Eyckstraat","address_street_number":"29","address_street_box":null,"email":"info@irenelaubgallery.be","website":"http:\/\/www.irenelaubgallery.com","phone_contact":"+32 2 647 55 16","phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"Van Eyckstraat, 29","address_line2":"1050 Elsene","description_web":"","description_print":"","booking_