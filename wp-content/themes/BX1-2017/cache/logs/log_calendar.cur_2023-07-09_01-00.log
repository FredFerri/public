,"cn":{"name":"Enfants"}},"value":5}],"child_events":[],"parent_events":[],"targets":{"list":[11,4,5,7,8,10,19],"translations":{"fr":["Famille","Enfants 6-9 ans","Enfants 9-12 ans","Jeunes 12-15 ans","Jeunes 15-18 ans","Seniors","Enseignants"],"nl":["Familie","Kinderen 6-9 j.","Kinderen 9-12 j.","Jongeren 12-15 j.","Jongeren 15-18 j.","Senioren","Leerkrachten"],"en":["Family","Children 6-9 yr.","Children 9-12 yr.","Youth 12-15  yr.","Youth 15-18  yr.","Seniors","Teachers"],"de":["Familie","Kinder 6-9 Jahre","Kinder 9-12 Jahre","Jugendliche 12-15 Jahre","Jugendliche 15-18 Jahre","Senioren","Lehrkr\u00e4fte"],"it":["Famiglie","Bambini 6-9 anni","Bambini 9-12 anni","Ragazzi 12-15 anni","Ragazzi 15-18 anni","Anziani","Insegnanti"],"sp":["Familias","Ni\u00f1os de 6 a 9 a\u00f1os","Ni\u00f1os de 9 a 12 a\u00f1os","J\u00f3venes de 12 a 15 a\u00f1os","J\u00f3venes de 15 a 18 a\u00f1os","Personas de la tercera edad","Profesores"],"pt":[null,null,null,null,null,null,null],"cn":[null,null,null,null,null,null,null]}},"educational_targets":{"list":[2,3,6,7,8,9],"translations":{"fr":["Primaire","Secondaire","10 - 12 ans","12 - 14 ans","14 - 16 ans","16 - 18 ans"],"nl":["Lagere school","Secundair onderwijs","10 - 12 jaar","12 - 14 jaar","14 - 16 jaar","16 - 18 jaar"],"en":["Primary school","Secondary school","10 - 12 years","12 - 14 years","14 - 16 years","16 - 18 years"],"de":["Primarstufe","Sekundarstufe","10 - 12 Jahre","12 - 14 Jahre","14 - 16 Jahre","16 - 18 Jahre"],"it":["Elementari","Medie","10 - 12 anni","12 - 14 anni","14 - 16 anni","16 - 18 anni"],"sp":["Escolares de primaria","Estudiantes de secundaria","10 - 12 a\u00f1os","12 - 14 a\u00f1os","14 - 16 a\u00f1os","16 - 18 a\u00f1os"],"pt":[null,null,null,null,null,null],"cn":[null,null,null,null,null,null]}},"tags":["kids"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-07-08T02:07:57+02:00","published_at":"2018-09-21T10:42:11+02:00","backoffice_id":176203,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.088885312486153},{"id":554659,"date_start":"2017-06-23","date_end":"2023-07-15","date_next":"2023-07-08","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":true,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen","it":"Visite guidate","sp":"Visitas guiadas","pt":null,"cn":null}},"others":{"list":[108],"translations":{"fr":["Folklore"],"nl":["Folklore"],"en":["Folklore"],"de":["Folklore"],"it":["Folklore"],"sp":["Folclore"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Anderlecht : M\u00e9moire des B\u00e9guines, Saint Guidon et Erasme","shortdescr":"Suivez le guide \u00e0 la d\u00e9couverte de la Coll\u00e9giale de Saint-Guidon, la Maison d'Erasme et le B\u00e9guinage \u00e0 Anderlecht","longdescr":"Quand notre cher Guidon a foul\u00e9 du pied les berges du Broeck, caracolant le long du Rinck  de la future Vaillance, pouvait-il s'imaginer que son culte donnerait naissance \u00e0 une coll\u00e9giale superbe ? Que d'aucun se pencherait sur cette s\u00e9pulture trap\u00e9zo\u00efdale ? Que l'on referait son histoire \u00e0 coup de suppositions, intrigu\u00e9s que nous sommes tous par ces pierres aux origines incertaines? Imaginait-il aussi que de gentes b\u00e9guines participeraient \u00e0 cette vie rurale aux portes de la ville ou qu'un Humaniste des plus r\u00e9put\u00e9s se ressourcerait \u00e0 l'ombre de la coll\u00e9giale qui porte encore et toujours son nom? Ah ! Ce petit sacristain de Laeken a vraiment plus d'un tour dans son sac ! Au point de concourir aux b\u00e9n\u00e9dictions d'animaux\u2026 quitte \u00e0 rendre jaloux Hubert. Seul Pierre aura la clef du myst\u00e8re.\r\n\r\nVisite privative sur mesure et \u00e0 la demande\r\nPossibilit\u00e9 d\u2019inclure la visite de la Maison d\u2019Erasme et du B\u00e9guinage en suppl\u00e9ment","performers":null,"boxoffice_url":null,"website":"http:\/\/www.itineraires.be","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.554659"},"nl":{"name":"Anderlecht : M\u00e9moire des B\u00e9guines, Saint Guidon et Erasme","shortdescr":"Volg de gids om de collegiale kerk Saint-Guidon, het Huis van Erasmus en het Begijnhof in Anderlecht te ontdekken.","longdescr":"Toen die goeie Guido langs de beemden van het Broeck dartelde en langs de Rinck zwierf, waar later het Dapperheidsplein zou worden aangelegd, kon hij zich vast niet voorstellen dat zijn verering aanleiding zou geven tot de bouw van een prachtige collegiale kerk! Noch dat zijn trapeziumvormig graf zo druk zou worden bezocht! Of dat zijn legende bol zou staan van de hypotheses, omdat de onzekere oorsprong van die stenen ons nu eenmaal intrigeert ... Had hij zich ooit kunnen indenken dat liefelijke begijnen deel zouden gaan uitmaken van het landelijke leven aan de poorten van de stad? Of dat een van de beroemdste Humanisten zou komen herbronnen in de schaduw van de collegiale kerk die tot op vandaag zijn naam draagt? Tja, die kleine koster van Laken heeft heel wat teweeggebracht! Hij ging zelfs dieren zegenen! Sint-Hubertus werd er zowaar jaloers van! Alleen Sint-Pieter zal later een eindoordeel kunnen vellen ...\r\n\r\nPriv\u00e9 bezoek op aanvraag\r\nMogelijkheid om het bezoek aan het Erasmushuis en het Begijnhof als extra te boeken","performers":null,"boxoffice_url":null,"website":"http:\/\/www.itineraires.be","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.554659"},"en":{"name":"Anderlecht : M\u00e9moire des B\u00e9guines, Saint Guidon et Erasme","shortdescr":"Follow the guide to discover the Collegiate Church of Saint-Guidon, the House of Erasmus and the Beguinage in Anderlecht","longdescr":"When dear old Guy first set foot in Broeck, sauntering around the Rinck, which would later become known as Place de la Vaillance, little could he have imagined that his devotees would end up building him a magnificent colle- giate church.. Or that crowds would bend over this trapezoidal tomb. That his life story would be re-enacted based on suppositions and guesswork, in- trigued as we all are by tombstones of uncertain origin. How could he have envisaged that the Beguines would pay homage to his humble lifestyle by the city gates, or that one of the world\u2019s most renowned Humanists would come to re-emerge from the shadows of the collegiate church that still bears his name today? No doubt this little sacristan from Laken was truly full of surprises! He even made it his task to bless the animals\u2026 enough to make Saint Hubert, the patron saint of hunters, green with envy. Only Peter has the key to the mystery.\r\n\r\nPrivate visit on demand\r\nPossibility to include the visit of the Maison d\u2019Erasme and the B\u00e9guinage as an extra","performers":null,"boxoffice_url":null,"website":"http:\/\/www.itineraires.be","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.554659"},"de":{"name":"Anderlecht : M\u00e9moire des B\u00e9guines, Saint Guidon et Erasme","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.itineraires.be","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.554659"},"it":{"name":"Anderlecht : M\u00e9moire des B\u00e9guines, Saint Guidon et Erasme","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.itineraires.be","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.554659"},"sp":{"name":"Anderlecht, Memoria de las beguinas, San Guido y Erasmo","shortdescr":null,"longdescr":"Cuando nuestro querido San Guido puso el pie en las orillas del Broeck, cabalgando por la zona de lo que ser\u00eda la futura rue de la Vaillance, \u00bfpodr\u00eda imaginarse que su culto dar\u00eda a luz una impresionante colegiata? \u00bfQue algunas personas contemplar\u00edan su tumba trapezoidal? \u00bfQue su historia se reconstruir\u00eda mediante suposiciones, intrigados como estamos todos por estas piedras de origen incierto? \u00bfImaginaba tambi\u00e9n que las beguinas de la nobleza participar\u00edan en esa misma vida rural a las puertas de la ciudad o que uno de los humanistas m\u00e1s renombrados se instalar\u00eda a la sombra de la colegiata que a\u00fan lleva su nombre? \u00a1Este humilde sacrist\u00e1n de Laeken tiene m\u00e1s de un as en la manga! Incluso ha llegado a participar en bendiciones de animales, aunque solo fuera para dar celos a San Huberto\u2026 Qui\u00e9n sabe, solo San Pedro tiene las llaves del misterio.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.itineraires.be","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.554659"},"pt":{"name":"Anderlecht : M\u00e9moire des B\u00e9guines, Saint Guidon et Erasme","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.itineraires.be","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/