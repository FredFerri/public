+32 2 330 09 61","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700001372"},"pt":{"name":"Virtual Room Bruxelles Ast\u00e9rix: Mission Potions!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brussels.virtual-room.com\/","email":"brussels@virtual-room.com","phone_contact":"+32 2 330 09 61","phone_booking":"+32 2 330 09 61","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700001372"},"en":{"name":"Virtual Room Bruxelles Ast\u00e9rix: Mission Potions!","shortdescr":"Ast\u00e9rix: Mission Potions!, le tout premier escape game Ast\u00e9rix en r\u00e9alit\u00e9 virtuelle chez Virtual Room Bruxelles\n","longdescr":"Virtual Room est heureux d\u2019annoncer le lancement de la toute premi\u00e8re exp\u00e9rience de r\u00e9alit\u00e9 virtuelle d\u00e9di\u00e9e \u00e0 l\u2019univers d\u2019Ast\u00e9rix. Cette exp\u00e9rience in\u00e9dite, intitul\u00e9e Ast\u00e9rix : Mission Potions ! offre au public une occasion unique de plonger dans l\u2019univers des c\u00e9l\u00e8bres Gaulois, de vivre des aventures \u00e9piques, et de se confronter aux l\u00e9gionnaires Romains comme si vous \u00e9tiez en -50 avant JC. \n\nAst\u00e9rix : Mission Potions ! utilise la technologie VR de pointe pour transporter les utilisateurs dans le village gaulois et au-del\u00e0. Gr\u00e2ce \u00e0 des graphismes spectaculaires et nombreuses interactions, les participants se retrouveront aux c\u00f4t\u00e9s des personnages embl\u00e9matiques d\u2019Ast\u00e9rix. Ils exploreront \u00e9galement des environnements mythiques et rel\u00e8veront des d\u00e9fis palpitants. \n\nAu programme  : un cours particulier de potions avec Panoramix, une cueillette en for\u00eat sous haute protection, une \u00e9vasion de prison de haut vol, ainsi qu\u2019une bagarre \u00e9pique contre les Romains. \n","performers":null,"boxoffice_url":null,"website":"https:\/\/brussels.virtual-room.com\/","email":"brussels@virtual-room.com","phone_contact":"+32 2 330 09 61","phone_booking":"+32 2 330 09 61","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700001372"},"it":{"name":"Virtual Room Bruxelles Ast\u00e9rix: Mission Potions!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brussels.virtual-room.com\/","email":"brussels@virtual-room.com","phone_contact":"+32 2 330 09 61","phone_booking":"+32 2 330 09 61","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700001372"},"cn":{"name":"Virtual Room Bruxelles Ast\u00e9rix: Mission Potions!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brussels.virtual-room.com\/","email":"brussels@virtual-room.com","phone_contact":"+32 2 330 09 61","phone_booking":"+32 2 330 09 61","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700001372"},"fr":{"name":"Virtual Room Bruxelles Ast\u00e9rix: Mission Potions!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brussels.virtual-room.com\/","email":"brussels@virtual-room.com","phone_contact":"+32 2 330 09 61","phone_booking":"+32 2 330 09 61","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700001372"},"sp":{"name":"Virtual Room Bruxelles Ast\u00e9rix: Mission Potions!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brussels.virtual-room.com\/","email":"brussels@virtual-room.com","phone_contact":"+32 2 330 09 61","phone_booking":"+32 2 330 09 61","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700001372"},"nl":{"name":"Virtual Room Bruxelles Ast\u00e9rix: Mission Potions!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brussels.virtual-room.com\/","email":"brussels@virtual-room.com","phone_contact":"+32 2 330 09 61","phone_booking":"+32 2 330 09 61","