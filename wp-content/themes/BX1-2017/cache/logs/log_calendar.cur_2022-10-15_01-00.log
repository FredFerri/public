rt les premier, deuxi\u00e8me, troisi\u00e8me, quatri\u00e8me et dernier jeudis du mois de 14:00 \u00e0 16:00","nl":"Open op de eerste, tweede, derde, vierde en laatste donderdags van de maand van 14:00 tot 16:00","en":"Open the first, second, third, fourth and last thursdays of the month from 14:00 to 16:00"}},{"day":"saturday","occurences":{"is_first":true,"is_second":true,"is_third":true,"is_fourth":true,"is_last":true},"time_start":"11:00:00","time_end":"13:00:00","translations":{"fr":"Ouvert les premier, deuxi\u00e8me, troisi\u00e8me, quatri\u00e8me et dernier samedis du mois de 11:00 \u00e0 13:00","nl":"Open op de eerste, tweede, derde, vierde en laatste zaterdags van de maand van 11:00 tot 13:00","en":"Open the first, second, third, fourth and last saturdays of the month from 11:00 to 13:00"}}],"date_exceptions":[{"day":"2022-11-01","start":"10:30:00","end":"12:30:00"},{"day":"2022-11-11","start":"10:30:00","end":"12:30:00"}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[19,11,7,8,10,12],"translations":{"fr":["Enseignants","Famille","Jeunes 12-15 ans","Jeunes 15-18 ans","Seniors","LGTBQIA"],"nl":["Leerkrachten","Familie","Jongeren 12-15 j.","Jongeren 15-18 j.","Senioren","LGTBQIA"],"en":["Teachers","Family","Youth 12-15  yr.","Youth 15-18  yr.","Seniors","LGTBQIA"]}},"educational_targets":{"list":[3,7,8,9],"translations":{"fr":["Secondaire","12 - 14 ans","14 - 16 ans","16 - 18 ans"],"nl":["Secundair onderwijs","12 - 14 jaar","14 - 16 jaar","16 - 18 jaar"],"en":["Secondary school","12 - 14 years","14 - 16 years","16 - 18 years"]}},"tags":["exterior","kids"],"accessibilities":{"list":[255,261,263],"translations":{"fr":["Accessible","Parking accessible","Accessible aux pi\u00e9tons appareill\u00e9s"],"nl":["Toegankelijk","Toegankelijke parking","Toegankelijk voor voetgangers met hulpmiddelen"],"en":["Accessible","Accessible parking","Accessible to pedestrians with mobility aids"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-14T01:06:31+02:00","published_at":"2021-03-04T10:14:24+01:00","backoffice_id":229486,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.10319362513019},{"id":509506,"date_start":"2021-03-06","date_end":"2025-12-31","date_next":"2022-10-15","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen"}},"others":{"list":[104],"translations":{"fr":["Art Nouveau, Art D\u00e9co"],"nl":["Art nouveau, art deco"],"en":["Art Nouveau, Art D\u00e9co"],"de":["Jugendstil, Art d\u00e9co"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Art Nouveau dans le Quartier des Squares","shortdescr":"On l\u2019appelle la \u201cgalerie de l\u2019Art Nouveau Bruxellois\u201d. D\u00e9couvrez un quartier qui a pris son essort en m\u00eame temps que le courant Art Nouveau, entre la fin du 19\u00e8me et le d\u00e9but du 20\u00e8me si\u00e8cle.","longdescr":"- Visite guid\u00e9e \u00e0 prix libre : payer en fin de tour le prix qui vous semble juste -\r\n\r\nConsid\u00e9r\u00e9 par beaucoup comme \u201cla galerie de l\u2019Art Nouveau bruxellois\u201c, le quartier Nord-Est rec\u00e8le bien des tr\u00e9sors architecturaux qui n\u2019attendent qu\u2019\u00e0 \u00eatre d\u00e9couverts. Alors, si l\u2019envie vous prend, laissez-vous entrainer sur les traces des grands architectes au cours d\u2019une balade dans ce quartier \u00e9clectique.\r\n\r\nD\u00e9couvrez les tr\u00e9sors cach\u00e9s de la ville, des fa\u00e7ades surprenantes, des d\u00e9tails stup\u00e9fiants qui font de l\u2019Art Nouveau un joyaux du patrimoine bruxellois.\r\n\r\nQU\u2019ALLEZ-VOUS D\u00c9COUVRIR ?\r\nLe tour \u201cArt Nouveau dans le quartier des Squares\u201d vous emm\u00e8ne au coeur des squares Marie Louise et Ambiorix, ainsi que dans les rues adja\u00e7antes et met en lumi\u00e8re de nombreuses maisons. Laissez-vous conter l\u2019Histoire des quartiers Nord-Est par le prisme de l\u2019architecture et de l\u2019urbanisme.\r\n\r\nVous ferez ainsi connaissance avec des architectes, connus et moins connus, qui ont marqu\u00e9 ce quartier.\r\n\r\nAu programme de la balade, entre autres\u2026\r\n\r\n\u2013 L\u2019H\u00f4tel Deprez \u2013 Van de Velde, de Victor Horta\r\n\u2013 L\u2019H\u00f4tel Van Eetevelde, de Victor Horta\r\n\u2013 La maison du peintre Georges L\u00e9onard de Saint-Cyr, de Gustave Strauven\r\n\u2013 La Maison Van Dijk, de Gustave Strauven\r\n\u2013 D\u2019autres oeuvres de Van Waesberghe, Victor Taelemans, Georges Hob\u00e9, et bien d\u2019autres\r\n\u2013 Mais aussi de nombreuses petites histoires et anecdotes !\r\n\r\n\r\n\r\nINFORMATIONS PRATIQUES\r\n\r\nTours r\u00e9guliers en fran\u00e7ais et en anglais :\r\nPrix  : Libre et conscient*\r\nDur\u00e9e : Environ 2 heures\r\nRendez-vous : Square Marie Louise (au bas du Square, au pied de la statue), 1000 Bruxelles\r\nFin de la visite : Square Marie Louise\r\n\r\nTour priv\u00e9 sur demande en fran\u00e7ais ou en anglais : info@brusselsbyfoot.com","performers":"Une visite guid\u00e9e originale de l'association de guides ind\u00e9pendants Brussels By Foot","boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/brusseleirs-dhier-et-daujourdhui\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.509506"},"nl":{"name":"Art Nouveau dans le Quartier des Squares","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agen