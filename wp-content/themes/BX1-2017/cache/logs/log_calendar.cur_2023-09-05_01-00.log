l],"fr":["Enfants 9-12 ans","Enfants 6-9 ans","Famille"],"sp":["Ni\u00f1os de 9 a 12 a\u00f1os","Ni\u00f1os de 6 a 9 a\u00f1os","Familias"],"nl":["Kinderen 9-12 j.","Kinderen 6-9 j.","Familie"]}},"educational_targets":{"list":[],"translations":{}},"tags":["kids"]},{"id":557538,"date_start":"2023-05-26","date_end":"2024-01-24","date_next":"2023-09-05","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2023-09-04T02:02:03+02:00","published_at":"2023-05-23T13:29:22+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":277538,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.2907951382429887,"languages":{"spoken":["fr","nl"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[46,36],"translations":{"de":["Multidisziplin\u00e4r","Museen & Kunstzentren"],"pt":[null,null],"en":["Multidisciplinary","Museums and art centers"],"it":["Multidisciplinare","Musei e centri artistici"],"cn":[null,null],"fr":["Pluridisciplinaire","Mus\u00e9es et art centers"],"sp":["Multidisciplinar","Museos y centros de arte"],"nl":["Multidisciplinair","Musea en kunstcentra"]}}},"translations":{"de":{"name":"L'Immortalit\u00e9 chim\u00e9rique. Camille De Taeye dans les livres","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wittockiana.org","email":"info@wittockiana.org","phone_contact":"+32 2 770 53 33","phone_booking":"+32 2 770 53 33","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.557538"},"pt":{"name":"L'Immortalit\u00e9 chim\u00e9rique. Camille De Taeye dans les livres","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wittockiana.org","email":"info@wittockiana.org","phone_contact":"+32 2 770 53 33","phone_booking":"+32 2 770 53 33","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.557538"},"en":{"name":"L'Immortalit\u00e9 chim\u00e9rique. Camille De Taeye in the books","shortdescr":"A bon vivant with a subversive sense of humour and a tragic life, Camille De Taeye (1938-2013) was a Brussels painter who loved books. Evolving on the fringes of artistic trends and movements, he designed books with several authors, which he accompanied with lithographs. Each print is an echo of the texts but also of the multiple facets of the painter that are reflected in his paintings.","longdescr":"A bon vivant with a subversive sense of humour and a tragic life, Camille De Taeye (1938-2013) was a Brussels painter who evolved on the fringes of artistic trends and movements. His first wife Gerda Vancluysen, a writer and poet, introduced him to the world of publishing. Together they produced a series of books, developing their own pictorial and poetic universe. The artist has also designed books with several authors, which he accompanied with lithographs printed on his hand press. Each print is an echo of the texts but also of the multiple facets of the painter that are reflected in his paintings.\r\n \r\n \r\nFor Camille De Taeye, painting is a form of resilience. His work is marked by several transversal themes, embodied by recurring motifs that translate and divert the dramas of his existence through a unique imagery. This exhibition proposes to discover some crucial aspects of his creation: his syntax, his symbols, which are so many grammatical elements necessary to his relational art; the cohabitation of eros and thanatos; a form of Belgian identity and precarious equilibriums.\r\n\r\nThe opening of the exhibition is an opportunity to discover the book \u00c9quilibres pr\u00e9caires by Dani\u00e8le Gillemon, published by CFC & La Pierre d\u2019Alun on the tenth anniversary of Camille De Taeye\u2019s death.\r\n\r\nWith the support of the Fonds Camille De Taeye \u2013 King Baudouin Foundation","performers":null,"boxoffice_url":null,"website":"http:\/\/www.wittockiana.org","email":"info@wittockiana.org","phone_contact":"+32 2 770 53 33","phone_booking":"+32 2 770 53 33","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.557538"},"it":{"name":"L'Immortalit\u00e9 chim\u00e9rique. Camille De Taeye dans les livres","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wittockiana.org","email":"info@wittockiana.org","phone_contact":"+32 2 770 53 33","phone_booking":"+32 2 770 53 33","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.557538"},"cn":{"name":"L'Immortalit\u00e9 chim\u00e9rique. Camille De Taeye dans les livres","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wittockiana.org","email":"info@wittockiana.org","phone_contact":"+32 2 770 53 33","phone_booking":"+32 2 770 53 33","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.557538"},"fr":{"name":"L'Immortalit\u00e9 chim\u00e9rique. Camille De Taeye dans les livres","shortdescr":"Bon vivant \u00e0 l\u2018humour subversif et au v\u00e9cu tragique, Camille De Taeye (1938-2013) est un artiste peintre bruxellois. \u00c9voluant en marge des tendances et mouvements artistiques, il a con\u00e7u avec plusieurs auteurs et autrices des ouvrages qu\u2019il accompagnait de lithographies. Chaque estampe est un \u00e9cho aux textes mais aussi aux multiples facettes du peintre qui se retrouvent dans ses tableaux.","longdescr":"Bon vivant \u00e0 l\u2018humour subversif et au v\u00e9cu tragique, Camille De Taeye (1938-2013) est un artiste peintre bruxellois \u00e9voluant en marge des tendances et mouvements artistiques. Sa premi\u00e8re \u00e9pouse Gerda Vancluysen, \u00e9crivaine et po\u00e9tesse, l\u2019a initi\u00e9 au monde de l\u2019\u00e9dition. Ensemble, ils ont r\u00e9alis\u00e9 une s\u00e9rie de livres, d\u00e9veloppant un univers pictural et po\u00e9tique qui leur est propre. L\u2019artiste a \u00e9galement con\u00e7u avec plusieurs auteurs et autrices des ouvrages qu\u2019il accompagnait de lithographies tir\u00e9es sur sa presse \u00e0 bras. Chaque estampe est un \u00e9cho aux textes mais aussi aux multiples facettes du peintre qui se retrouvent dans ses tableaux.\r\n\t\t\t\r\nPour Camille De Taeye, la peinture est une forme de r\u00e9silience. Son \u0153uvre est jalonn\u00e9e de plusieurs th\u00e8mes transversaux, incarn\u00e9s par des motifs r\u00e9currents qui traduisent et d\u00e9tournent les drames de son existence \u00e0 travers un imaginaire singulier. Cette exposition propose de d\u00e9couvrir quelques aspects cruciaux de sa cr\u00e9ation : sa syntaxe, ses symboles, qui sont autant d\u2019\u00e9l\u00e9ments grammaticaux n\u00e9cessaires \u00e0 son art relationnel; la cohabitation de l\u2019\u00e9ros et de thanatos ; une forme d\u2019identit\u00e9 belge et les \u00e9quilibres pr\u00e9caires.\r\n\r\nL\u2019ouverture de l\u2019exposition est l\u2019occasion de d\u00e9couvrir le livre \u00c9quilibres pr\u00e9caires de Dani\u00e8le Gillemon, aux \u00c9ditions CFC & La Pierre d\u2019Alun, paru au dixi\u00e8me anniversaire de la disparition de Camille De Taeye.\r\n\r\nAvec le soutien du Fonds Camille De Taeye \u2013 Fondation Roi Baudouin","performers":null,"boxoffice_url":null,"website":"http:\/\/www.wittockiana.org","email":"info@wittockiana.org","phone_contact":"+32 2 770 53 33","phone_booking":"+32 2 770 53 33","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.557538"},"sp":{"name":"L'Immortalit\u00e9 chim\u00e9rique. Camille De Taeye dans les livres","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wittockiana.org","email":"info@wittockiana.org","phone_contact":"+32 2 770 53 33","phone_booking":"+32 2 770 53 33","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.557538"},"nl":{"name":"L'Immortalit\u00e9 chim\u00e9rique. Camille De Taeye in de boeken","shortdescr":"Camille De Taeye (1938-2013) was een Brusselse schilder met een subversief gevoel voor humor en een tragisch levensverhaal. Hij evolueerde in de marge van artistieke trends en bewegingen en ontwierp boeken met verschillende auteurs, die hij begeleidde met lithografie\u00ebn. Elke prent is een echo van de teksten, maar ook van de vele facetten van de schilder die in zijn schilderijen tot uiting komen.","longdescr":"Camille De Taeye (1938-2013), een levensgenieter met een subversief gevoel voor humor en een tragisch levensverhaal, was een Brusselse schilder die evolueerde in de marge van artistieke bewegingen. Zijn eerste vrouw Gerda Vancluysen, schrijfster en dichteres, introduceerde hem in de wereld van de uitgeverij. Samen produceerden ze een reeks boeken en ontwikkelden zo hun eigen picturale en po\u00ebtische universum. De kunstenaar ontwierp ook boeken met verschillende auteurs, die hij begeleidde met lithografie\u00ebn gedrukt op zijn handpers. Elke prent is een echo van de teksten, maar ook van de vele facetten van de schilder die in zijn schilderijen tot uiting komen.\r\n\t\t\t\r\nVoor Camille De Taeye is schilderen een vorm van veerkracht. Zijn werk wordt gekenmerkt door verschillende transversale thema's, belichaamd door terugkerende motieven die de drama's van zijn bestaan vertalen en omleiden via een singuliere verbeelding. Deze tentoonstelling wil enkele cruciale aspecten van zijn creatie onthullen: zijn syntaxis, zijn symbolen, die noodzakelijke grammaticale elementen vormen voor zijn relationele kunst; het samenleven van eros en thanatos; een vorm van Belgische identiteit en het precaire evenwicht.\r\n\r\nDe opening van de tentoonstelling is een gelegenheid om het boek \u00c9quilibres pr\u00e9caires van Dani\u00e8le Gillemon te ontdekken, uitgegeven door CFC & La Pierre d'Alun op de tiende verjaardag van de dood van Camille De Taeye.\r\n\r\nMet de steun van het Fonds Camille De Taeye - Koning Boudewijnstichting","performers":null,"boxoffice_url":null,"website":"http:\/\/www.wittockiana.org","email":"info@wittockiana.org","phone_contact":"+32 2 770 53 33","phone_booking":"+32 2 770 53 33","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.557538"}},"place":{"id":142,"translations":{"de":{"name":"Wittockiana: Msueum f\u00fcr Buch- und Buchbindekunst","address_street_name":"Rue du Bemel","address_street_number":"23","address_street_box":null,"email":"info@wittockiana.org","website":"http:\/\/www.wittockiana.org","phone_contact":"+32 2 770 53 33","phone_booking":null,"address_zip":"1150","address_city":"Woluwe-Saint-Pierre","address_line1":"Rue du Bemel, 23","address_line2":"1150 Woluwe-Saint-Pierre","description_web":"Die Wittockiana wurde 1983 von dem renommierten Buchkenners Michel Wittock gegr\u00fcndet und ist sowohl Buchmuseum als auch Bibliothek und Archiv f\u00fcr kostbare historische, moderne und zeitgen\u00f6ssische B\u00fccher.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Wittockiana : Mus\u00e9e des Arts du livre et de la Reliure ","address_street_name":"Rue du Bemel","address_street_number":"23","address_street_box":null,"email":"info@wittockiana.org","website":"http:\/\/www.wittockiana.org","phone_contact":"+32 2 770 53 33","phone_booking":null,"address_zip":"1150","address_city":"Woluwe-Saint-Pierre","address_line1":"Rue du Bemel, 23","address_line2":"1150 Woluwe-Saint-Pierre","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Wittockiana ","address_street_name":"Rue d