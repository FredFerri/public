gium Bearpride 2022"}}},{"type":"poster","link":"https:\/\/agendabrussels.imgix.net\/c8ad2e3aaf8b80f94a1426b622e15c8f5dd7b8af.jpg","width":1920,"height":1005,"ratio":1.91,"translations":{"fr":{"title":"Belgium Bearpride Brussels 2022","copyright":null},"nl":{"title":"Belgium Bearpride Brussels 2022","copyright":null},"en":{"title":"Belgium Bearpride Brussels 2022","copyright":null}}}],"dates":[],"prices":[{"translations":{"fr":{"name":"Pr\u00e9vente"},"nl":{"name":"Voorverkoop"},"en":{"name":"Presale"}},"value":16},{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":20}],"child_events":[540563,540655,540661],"parent_events":[],"targets":{"list":[12],"translations":{"fr":["LGTBQIA"],"nl":["LGTBQIA"],"en":["LGTBQIA"]}},"visit_profile":{"list":[337,332],"translations":{"fr":["Highlight","LGBTQIA+"],"nl":["Highlight","LGBTQIA+"],"en":["Highlight","LGBTQIA+"]}},"tags":["major_event"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-08-30T11:17:56+02:00","published_at":"2022-07-04T09:32:13+02:00","backoffice_id":257708,"import_origin":null,"sub_type":"festival","show_in_agenda":true,"ranking":0.73680629972808},{"id":540196,"date_start":"2022-09-23","date_end":"2022-09-25","date_next":"2022-09-25","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":90,"translations":{"fr":"Animations","nl":"Animaties","en":"Animations"}},"others":{"list":[95],"translations":{"fr":["Patrimoine"],"nl":["Erfgoed"],"en":["Heritage"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Journ\u00e9es du Matrimoine","shortdescr":"Initi\u00e9es \u00e0 Paris \u00e0 partir de 2015, les Journ\u00e9es du Matrimoine se diffusent en France\u2026 et dor\u00e9navant \u00e0 Bruxelles depuis 2019.\r\nA l\u2019initiative de l\u2019asbl L\u2019architecture qui d\u00e9genre, la quatri\u00e8me \u00e9dition des Journ\u00e9es du Matrimoine se d\u00e9rouleront \u00e0 Bruxelles les 23, 24 et 25 septembre 2022.","longdescr":"Les Journ\u00e9es du Matrimoine mettent en lumi\u00e8re d\u2019une part l\u2019h\u00e9ritage matrimonial bruxellois historique \u2013 architectural, sculptural, urbanistique, social. D\u2019autre part, les Journ\u00e9es sont aussi l\u2019occasion de d\u00e9couvrir le patrimoine actuel \u2013 artistique, politique et f\u00e9ministe.\r\n\r\nToutes les activit\u00e9s des Journ\u00e9es du Matrimoine sont gratuites. Les r\u00e9servations en ligne sont obligatoires : www.matrimonydays.be\/fr\r\nAu-del\u00e0 de la d\u00e9couverte du matrimoine bruxellois parfois, voire souvent, \u00e9clips\u00e9, la question fondamentale de l\u2019acc\u00e8s \u00e0 la propri\u00e9t\u00e9 pour les femmes et aux professions li\u00e9es est transversalement soulev\u00e9e lors d\u2019ateliers men\u00e9s par des expertes et tout au long des visites conduites par des professionnel\u00b7le\u00b7s de terrain. L\u2019ensemble du programme permet ainsi de rendre compte de la participation des femmes* et des minorit\u00e9s de genre dans les multiples corps de m\u00e9tiers li\u00e9s au matrimoine.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.matrimonydays.be\/","email":"info@matrimonydays.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.540196"},"nl":{"name":"Matrimoniumdagen","shortdescr":"In Parijs werden de Matrimoniumdagen voor het eerst georganiseerd in 2015. Het initiatief krijgt steeds meer weerklank in heel Frankrijk... en sinds 2019 ook in Brussel.\r\nOnder impuls van de vzw L\u2019architecture qui d\u00e9genre gaan de Matrimoniumdagen door op 23, 24 en 25 september 2022 in Brussel.","longdescr":"De Matrimoniumdagen plaatsen enerzijds het historisch-architecturaal, beeldhouwkundig, stedenbouwkundig, maatschappelijk Brussels erfgoed in de kijker. Anderzijds is het ook een mooie kans om het huidige artistieke, politieke en feministische erfgoed te ontdekken.\r\n\r\nNaast een ontdekkingstocht door het Brusselse matrimonium \u2013 dat soms en zelfs vaak overschaduwd wordt - komt ook de fundamentele kwestie van eigendomsrecht voor vrouwen en de daarmee verbonden beroepen aan bod, tijdens workshops met expertes en rondleidingen door vrouwen die in de praktijk staan. Zo kunt u zich dankzij het programma een beeld vormen van de participatie van vrouwen* en genderminderheden in de verschillende matrimoniumgerelateerde beroepen. \r\n\r\nAlle activiteiten van de Matrimoniumdagen zijn gratis. Online reserveren is verplicht: www.matrimonydays.be\/nl","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.540196"},"en":{"name":"Matrimony Days","shortdescr":"Initiated in Paris in 2015, the Matrimony Days have been spreading in France... and now in Brussels since 2019. \r\nOn one hand, the Matrimony Days shed light on the Brussels historic women\u2019s\u2013architectural, sculpture, urbanist, social\u2013heritage. On the other, the Matrimony Days are also a way to discover today\u2019s\u2013artistic, political and feminist\u2013heritage.","longdescr":"On one hand, the Matrimony Days shed light on the Brussels historic women\u2019s\u2013architectural, sculpture, urbanist, social\u2013heritage. On the other, the Matrimony Days are also a way to discover today\u2019s\u2013artistic, political and feminist\u2013heritage.\r\n\r\nBeyond discovering Brussels\u2019s women\u2019s heritage which is sometimes\u2013or often\u2013eclipsed, the fundamental issue of women\u2019s access to property and related professions is raised horizontally during workshops led by experts and throughout the tours led by professionals on the ground. Therefore, the entirety of the program is made to give an account of the participation of women* and gender minorities in multiple professions related to Matrimony.\r\n\r\nAll the activities of the Matrimony Days are free. Online reservations are required: www.matrimonydays.be\/","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.540196"},"de":{"name":"Journ\u00e9es du Matrimoine","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.540196"},"it":{"name":"Journ\u00e9es du Matrimoine","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.540196"},"sp":{"name":"Journ\u00e9es du Matrimoine","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.540196"},"pt":{"name":"Journ\u00e9es du Matrimoine","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.540196"},"cn":{"name":"Journ\u00e9es du Matrimoine","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.540196"}},"place":{"id":245448,"translations":{"fr":{"name":"Divers lieux \u00e0 Bruxelles","address_street_name":null,"address_street_