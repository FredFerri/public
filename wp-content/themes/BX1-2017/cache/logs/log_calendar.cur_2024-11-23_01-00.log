tdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.magicland-theatre.com","email":"johanne@magicland-theatre.com","phone_contact":"+32 495 26 18 71","phone_booking":"+32 495 26 18 71","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700002958"},"it":{"name":"Qui a tu\u00e9 Patrice Lumumba ?","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.magicland-theatre.com","email":"johanne@magicland-theatre.com","phone_contact":"+32 495 26 18 71","phone_booking":"+32 495 26 18 71","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700002958"},"cn":{"name":"Qui a tu\u00e9 Patrice Lumumba ?","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.magicland-theatre.com","email":"johanne@magicland-theatre.com","phone_contact":"+32 495 26 18 71","phone_booking":"+32 495 26 18 71","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700002958"},"fr":{"name":"Qui a tu\u00e9 Patrice Lumumba ?","shortdescr":null,"longdescr":"Une cr\u00e9ation de la Clinique juridique Rosa Parks pour les droits humains et du Magic land th\u00e9\u00e2tre\nAvec le soutien du Fonds recherche-cr\u00e9ation de l\u2019UCLouvain culture \n \nQui a tu\u00e9 Patrice Lumumba ? est une pi\u00e8ce de th\u00e9\u00e2tre qui met en sc\u00e8ne un jury d\u2019assises fictif charg\u00e9 de faire le point sur les responsabilit\u00e9s dans l\u2019assassinat de Patrice Lumumba. Et aborder cette question juridique est une opportunit\u00e9 pour raconter et questionner l\u2019Histoire coloniale de la Belgique au Congo.\n\nC\u2019est un projet artistique et p\u00e9dagogique qui s\u2019inscrit au c\u0153ur du travail de la Clinique juridique Rosa Parks pour les droits humains.\n\nCe sont ainsi les \u00e9tudiant\u00b7es de Master en droit de l\u2019UCLouvain qui ont r\u00e9alis\u00e9 les recherches n\u00e9cessaires \u00e0 l\u2019\u00e9criture du texte th\u00e9\u00e2tral et ce sont eux et elles qui assurent en partie la promotion du spectacle.\n \nPour ce faire, ils et elles sont all\u00e9.e.s \u00e0 la rencontre des chercheur\u00b7ses et sp\u00e9cialistes des diff\u00e9rents domaines : historien\u00b7nes, juristes, sp\u00e9cialistes des relations Belgique- RDC, \u00e9conomistes\u2026 ainsi que les diff\u00e9rentes associations qui \u0153uvrent en mati\u00e8re de d\u00e9colonisation.\n \nLe texte a ensuite \u00e9t\u00e9 \u00e9crit par Claire-Marie Lievens. L\u2019objet final est un spectacle d\u2019une heure trente sous forme d\u2019un jury d\u2019assises ; le ton est r\u00e9aliste, concret et parfois teint\u00e9 d\u2019humour. Il s \u2018agit donc d\u2019un spectacle tout public (et d\u2019utilit\u00e9 publique !), compr\u00e9hensible par toutes et tous. La richesse des dialogues humains entre douze personnes d\u2019horizons diff\u00e9rents permet en effet d\u2019aborder l\u2019histoire coloniale (et l\u2019assassinat de Patrice Lumumba) en faisant apparaitre une multiplicit\u00e9 de points de vue, et d\u2019\u0153uvrer par l\u00e0 m\u00eame pour une soci\u00e9t\u00e9 plus \u00e9galitaire, moins discriminante, plus juste.\n \nConna\u00eetre son Histoire pour ne pas r\u00e9p\u00e9ter les erreurs du pass\u00e9, \nComprendre et avancer,\npour que demain soit plus juste, plus lumineux.\n \nEcriture (et coordination du projet) : Claire-Marie Lievens\nMise en sc\u00e8ne et sc\u00e9nographie : Claire-Marie Lievens et Patrick Chaboud\nAssistanat : Clara Huwart\n \nSur une initiative de Cyril Wintjens. \nDistribution :\n\nNoel Yerl\u00e8s, Alain Geerinckx, Mpela Biembongo, Rapha\u00ebl Van Steenberghe, Hoonaz Ghojallu, Uriel Abogso, Elisabeth De Schutter, Hinde Louati, Ben Kamuntu, Jessica Fanhan, Clara Huwart et Palmina Da Siena. \n \nComit\u00e9 de lecture et de recherche :\nSylvie Sarolea, Rapha\u00ebl Van Steenberghe, Uriel Abogso, Elisabeth De Schutter, Ange-Marie Nguadi Pombo, Cyril Wintjens, Patient Muhri et Olivier Shukuru de l\u2019Universit\u00e9 de Bukavu (RDC), Cherif Diallo, Oumar Diallo, Nyemba Godlive, Victoria Vandermeersch pour le Placet, B\u00e9reng\u00e8re Piret, Olivier Luminet, Jacques Mbokani, Christian Chiza et Bernard Mouffe.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.magicland-theatre.com","email":"johanne@magicland-theatre.com","phone_contact":"+32 495 26 18 71","phone_booking":"+32 495 26 18 71","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700002958"},"sp":{"name":"Qui a tu\u00e9 Patrice Lumumba ?","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.magicland-theatre.com","email":"johanne@magicland-theatre.com","phone_contact":"+32 495 26 18 71","phone_booking":"+32 495 26 18 71","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700002958"},"nl":{"name":"Qui a tu\u00e9 Patrice Lumumba ?","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.magicland-theatre.com","email":"johanne@magicland-theatre.com","phone_contact":"+32 495 26 18 71","phone_booking":"+32 495 26 18 71","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700002958"}},"place":{"id":224842,"translations":{"de":{"name":"Magic Land Th\u00e9\u00e2tre","address_street_name":"Rue d'Hoogvorst","address_street_number":"8-14","address_street_box":null,"email":"info@magicland-theatre.com","website":"http:\/\/www.magicland-theatre.com","phone_contact":"+32 2 245 50 64","phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Rue d'Hoogvorst, 8-14","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Magic Land Th\u00e9\u00e2tre","address_street_name":"Rue d'Hoogvorst","address_street_number":"8-14","address_street_box":null,"email":"info@m