ww.theatrelepublic.be\/","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50012234"},"en":{"name":"Apr\u00e8s la r\u00e9p\u00e9tition","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50012234"},"it":{"name":"Apr\u00e8s la r\u00e9p\u00e9tition","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50012234"},"cn":{"name":"Apr\u00e8s la r\u00e9p\u00e9tition","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50012234"},"fr":{"name":"Apr\u00e8s la r\u00e9p\u00e9tition","shortdescr":null,"longdescr":"Nous allons partager avec vous ce que nous ne gardions que pour nous.\n\nAu th\u00e9\u00e2tre, il y a, g\u00e9n\u00e9ralement, une sc\u00e8ne et des coulisses. Mais en coulisses, se passent des choses qui ne se passent pas sur sc\u00e8ne\u2026\n \n\"Apr\u00e8s la r\u00e9p\u00e9tition\" l\u00e8ve le voile sur cet univers auquel aucun spectateur n\u2019assiste...\nSur ce qui se vit entre les artistes et le metteur en sc\u00e8ne avant, pendant, et apr\u00e8s les r\u00e9p\u00e9titions.\nEt si le th\u00e9\u00e2tre est le miroir de la vie, dans \"Apr\u00e8s la r\u00e9p\u00e9tition\", la vie devient miroir du th\u00e9\u00e2tre. \n \nS\u00e9duction, amour, manipulation, narcissisme, doutes, d\u00e9ception, humour clair et humour noir, \"Apr\u00e8s la r\u00e9p\u00e9tition\" est aussi une r\u00e9flexion sur les rapports entre artistes, aux publics, aux m\u00e9dias.\n \nVenez et \u2026 Bas les masques !\n__________\n\nD'Ingmar Bergman \/ Mise en sc\u00e8ne : Michel Kacenelenbogen \/ Avec : Laurence D\u2019Amelio, Michel Kacenelenbogen et Camille Vandevelde \/ Assistante \u00e0 la mise en sc\u00e8ne et dramaturgie : Anne Sylvain \/ Sc\u00e9nographie : Renata Gorka \/ Costumes : Chandra Vellut \/ Lumi\u00e8re : Laurent Kaye \/ Musique originale : Pascal Charpentier\n__________\n\nUNE PRODUCTION DU TH\u00c9\u00c2TRE LE PUBLIC. AVEC L'AIDE DE LA F\u00c9D\u00c9RATION WALLONIE-BRUXELLES - DIRECTION DU TH\u00c9\u00c2TRE, ET LE SOUTIEN DU TAX SHELTER DE L\u2019\u00c9TAT F\u00c9D\u00c9RAL BELGE VIA BESIDE. Les \u0153uvres th\u00e9\u00e2trales d\u2019Ingmar Bergman sont repr\u00e9sent\u00e9es dans les pays de langue fran\u00e7aise par l\u2019agence Drama \u2013 Suzanne Sarquier (www.dramaparis.com) en accord avec la Fondation Bergman (www.ingmarbergman.se) et l\u2019Agence Josef Weinberger Limited \u00e0 Londres. ","performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50012234"},"sp":{"name":"Apr\u00e8s la r\u00e9p\u00e9tition","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50012234"},"nl":{"name":"Apr\u00e8s la r\u00e9p\u00e9tition","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/","email":"contact@theatrelepublic.be","phone_contact":null,"