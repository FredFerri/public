erformers":null,"boxoffice_url":null,"website":"https:\/\/bxl.art-nft.gallery\/fr\/event\/exposition-fisherman-par-claude-baquet-67\/register","email":"hello@art-nft.gallery","phone_contact":"+32 478 29 20 43","phone_booking":"+32 474 30 33 80","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50005906"},"cn":{"name":"\"FISHERMAN\" Drawings and photos by Claude Baquet","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/bxl.art-nft.gallery\/fr\/event\/exposition-fisherman-par-claude-baquet-67\/register","email":"hello@art-nft.gallery","phone_contact":"+32 478 29 20 43","phone_booking":"+32 474 30 33 80","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50005906"},"fr":{"name":"\"FISHERMAN\" Dessins et photographies par Claude Baquet","shortdescr":"Vous \u00eates cordialement invit\u00e9s dans un lieu d'art et d'inspiration.\nVenez d\u00e9couvrir la beaut\u00e9 et la cr\u00e9ativit\u00e9 de notre artiste vedette et laissez-vous transporter dans un voyage visuel o\u00f9 la beaut\u00e9, l'\u00e9motion et l'imagination se confondent.","longdescr":"Voyagez \u00e0 travers une \u00e9tonnante collection de photographies o\u00f9 chaque image vous fera d\u00e9couvrir le monde \u00e0 travers les yeux de l'artiste, d\u00e9couvrir le monde \u00e0 travers la vision puissante de l'artiste.\nPlongez dans les teintes vibrantes, les formes intrigantes et les textures uniques des dessins de l'artiste. Une feuille retrace de mani\u00e8re envo\u00fbtante l'histoire d'un poisson imaginaire.","performers":null,"boxoffice_url":null,"website":"https:\/\/bxl.art-nft.gallery\/fr\/event\/exposition-fisherman-par-claude-baquet-67\/register","email":"hello@art-nft.gallery","phone_contact":"+32 478 29 20 43","phone_booking":"+32 474 30 33 80","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50005906"},"sp":{"name":"\"FISHERMAN\" Drawings and photos by Claude Baquet","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/bxl.art-nft.gallery\/fr\/event\/exposition-fisherman-par-claude-baquet-67\/register","email":"hello@art-nft.gallery","phone_contact":"+32 478 29 20 43","phone_booking":"+32 474 30 33 80","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50005906"},"nl":{"name":"\"FISHERMAN\" Tekeningen en foto's door Claude Baquet","shortdescr":"Je bent van harte uitgenodigd op een plek van kunst en inspiratie.\nKom en ontdek de schoonheid en creativiteit van onze sterrenkunstenaar en laat je meevoeren op een visuele reis waar schoonheid, emotie en verbeelding samensmelten.","longdescr":"Reis door een verbluffende collectie foto's waarbij elke afbeelding je meeneemt op een reis om de wereld te ontdekken door de ogen van de kunstenaar, om de wereld te ontdekken door de krachtige visie van de kunstenaar.\n\nDompel jezelf onder in de levendige tinten, intrigerende vormen en unieke texturen van de tekeningen van de kunstenaar. E\u00e9n blad vertelt het betoverende verhaal van een denkbeeldige vis.","performers":null,"boxoffice_url":null,"website":"https:\/\/bxl.art-nft.gallery\/event\/exhibition-fisherman-by-claude-baquet-67\/register","email":"hello@art-nft.gallery","phone_contact":"+32 478 29 20 43","phone_booking":"+32 474 30 33 80","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50005906"}},"place":{"id":280672,"translations":{"de":{"name":"Art.NFT.Gallery","address_street_name":"Gare Maritime - Tour & Taxis Rue Picard","address_street_number":"9","address_street_box":"MODULE 8.3","email":"info@artecom.eu","website":"https:\/\/bxl.art-nft.gallery\/fr","phone_contact":"+32 478 29 20 43","phone_booking":"+32 474 30 33 80","address_zip":"1000","address_city":"Bruxelles","address_line1":"Gare Maritime - Tour & Taxis Rue Picard, 9 \/ MODULE 8.3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order"