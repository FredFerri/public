a1fda6a6889.jpg","width":4032,"height":2268,"ratio":1.78,"translations":{"fr":{"title":"Vall\u00e9e de la Senne, \u00e0 v\u00e9lo et en bateau","copyright":"cactus brussel \u00e0 v\u00e9lo"},"nl":{"title":"Vall\u00e9e de la Senne, \u00e0 v\u00e9lo et en bateau","copyright":"cactus brussel \u00e0 v\u00e9lo"},"en":{"title":"Vall\u00e9e de la Senne, \u00e0 v\u00e9lo et en bateau","copyright":"cactus brussel \u00e0 v\u00e9lo"}}},{"type":"poster","link":"https:\/\/agendabrussels.imgix.net\/ca5742f987b95f67af6c1cdbb94bcdf74a0448ed.jpg","width":750,"height":750,"ratio":1,"translations":{"fr":{"title":"Vall\u00e9e de la Senne, \u00e0 v\u00e9lo et en bateau","copyright":null},"nl":{"title":"Vall\u00e9e de la Senne, \u00e0 v\u00e9lo et en bateau","copyright":null},"en":{"title":"Vall\u00e9e de la Senne, \u00e0 v\u00e9lo et en bateau","copyright":null}}}],"dates":[{"day":"2022-07-22","doors":null,"start":"13:30:00","end":"17:00:00","is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":5}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":["exterior"],"is_part_of":"V\u00e9lo tourisme","accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-06-15T08:35:06+02:00","published_at":"2022-06-15T08:23:43+02:00","backoffice_id":255969,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":1},{"id":537071,"date_start":"2022-07-22","date_end":"2022-07-30","date_next":"2022-07-22","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[36,42],"translations":{"fr":["Mus\u00e9es et art centers","Peinture"],"nl":["Musea en kunstcentra","Schilderkunst"],"en":["Museums and art centers","Painting"]}}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Renqu'Art","shortdescr":"L'expo Renqu'Art retrace le travail r\u00e9alis\u00e9 dans le cadre d'ateliers artistiques du m\u00eame nom. L'objectif \u00e9tant rassemblant les minorit\u00e9s issues de l'immigration et la population d\u2019accueil autour d\u2019\u0153uvres personnelles et collectives construites ensemble dans le but de d\u00e9construire les pr\u00e9jug\u00e9s sur la migration.","longdescr":"L'expo Renqu'Art retrace le travail r\u00e9alis\u00e9 dans le cadre d'ateliers artistiques du m\u00eame nom. Ces ateliers avaient comme objectifs de favoriser le dialogue interculturel \u00e0 Tournai et Bruxelles en instaurant des espaces de cr\u00e9ation artistique rassemblant les minorit\u00e9s issues de l'immigration et la population d\u2019accueil autour d\u2019\u0153uvres personnelles et collectives construites ensemble dans le but de d\u00e9construire les pr\u00e9jug\u00e9s sur la migration.\r\nLes ateliers \u00e9taient organis\u00e9s dans une d\u00e9marche de p\u00e9dagogie active. L'objectif \u00e9tant de permettre aux participant\u00b7e\u00b7s d\u2019avoir un cadre favorable \u00e0 l\u2019expression d\u2019une parole d\u2019abord individuelle puis collective lors des ateliers.\r\n\r\n\u2139 JAGORA asbl : \r\nJagora asbl encourage les 16-35 ans \u00e0 s\u2019engager dans des actions favorisant le vivre ensemble pour que tous les jeunes, quels que soient leur parcours et leur origine se rencontrent et s\u2019engagent ensemble dans la soci\u00e9t\u00e9. L\u2019interculturalit\u00e9 est ainsi au c\u0153ur de son projet associatif. En valorisant la mise en projet des jeunes, Jagora forme des jeunes CRACS (citoyen, responsable, actif, critique et solidaire) et s\u2019ancre dans une d\u00e9marche d\u2019\u00e9ducation permanente.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.montdepiete.be\/expo-renquart","email":"info@montdepiete.be","phone_contact":"+32 2 512 13 85","phone_booking":"+32 2 512 13 85","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/537071.html"},"nl":{"name":"Renqu'Art","shortdescr":"De tentoonstelling Renqu'Art geeft een overzicht van de werkzaamheden die in het kader van de gelijknamige artistieke ateliers zijn uitgevoerd. Het doel is minderheden met een immigratieachtergrond en de lokale bevolking samenbrengen om een aantal persoonlijke en collectieve werken te maken, met als doel vooroordelen over migratie te ontkrachten.","longdescr":"De tentoonstelling Renqu'Art geeft een overzicht van de werkzaamheden die in het kader van de gelijknamige artistieke ateliers zijn uitgevoerd. Het doel van deze workshops was om de interculturele dialoog in Doornik en Brussel te bevorderen. Dit door ruimtes te cre\u00ebren voor artistieke creatie waar minderheden met een immigratieachtergrond en de lokale bevolking samenkwamen om een aantal persoonlijke en collectieve werken te maken, met als doel vooroordelen over migratie te ontkrachten.\r\nDe workshops werden georganiseerd met een actieve pedagogische aanpak. Het doel was de deelnemers een kader te bieden waarin zij hun standpunten konden uiten, eerst individueel en vervolgens collectief tijdens de workshops.\r\n\r\n\u2139 JAGORA vzw: \r\nJagora vzw moedigt 16- tot 35-jarigen aan om actie te ondernemen om het samenleven te bevorderen, zodat alle jongeren, ongeacht achtergrond of afkomst, elkaar kunnen ontmoeten en aan de samenleving kunnen deelnemen. Interculturaliteit is dus de kern van haar associatieve project. Door de betrokkenheid van jongeren bij projecten te waarderen, leidt Jagora jongeren op tot verantwoordelijke, actieve, kritische en solidaire burgers. Dit maakt deel uit van een aanpak waarin levenslang leren centraal staat.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.bergvanbarmhartigheid.be\/nl\/tentoonstelling-renquart","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/537071.html"},"en":{"name":"Renqu'Art","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/537071.html"},"de":{"name":"Expo \u00ab Renqu'Art \u00bb de Jagora asbl","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/537071.html"},"it":{"name":"Expo \u00ab Renqu'Art \u00bb de Jagora asbl","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/537071.html"},"sp":{"name":"Expo \u00ab Renqu'Art \u00bb de Jagora asbl","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/537071.html"},"pt":{"name":"Expo \u00ab Renqu'Art \u00bb de Jagora asbl","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/537071.html"},"cn":{"name":"Expo \u00ab Renqu'Art \u00bb de Jagora asbl","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/537071.html"}},"place":{"id":221323,"translations":{"fr":{"name":"Mont de Pi\u00e9t\u00e9 (Caisse Publique de Pr\u00eats)","address_street_name":"Rue Saint-Ghislain","address_street_number":"1923","address_street_box":null,"email":null,"website":null,"phone_contac