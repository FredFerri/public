9hension","Accessible","Accessible aux pi\u00e9tons appareill\u00e9s","Brussels Health Safety Label"],"nl":["Toegankelijk voor mensen met een verstandelijke beperking","Toegankelijk","Toegankelijk voor voetgangers met hulpmiddelen","Brussels Health Safety Label"],"en":["Accessible to people with intellectual disabilities","Accessible","Accessible to pedestrians with mobility aids","Brussels Health Safety Label"],"de":["Barrierefrei f\u00fcr Menschen mit Verst\u00e4ndnisschwierigkeiten","Barrierefrei","Barrierefrei f\u00fcr Fu\u00dfg\u00e4nger mit Gehhilfe","Brussels Health Safety Label"],"it":["Accessibile alle persone con difficolt\u00e0 di comprensione","Accessibile","Accessibile ai pedoni con supporti","Brussels Health Safety Label"],"sp":["Habilitado para personas con dificultades de comprensi\u00f3n","Habilitado","Habilitado para peatones con aud\u00edfonos","Brussels Health Safety Label"],"pt":[null,null,null,null],"cn":[null,null,null,null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2023-02-17T10:05:04+01:00","published_at":"2023-01-19T13:58:18+01:00","backoffice_id":270029,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.38157141418444},{"id":551791,"date_start":"2023-03-10","date_end":"2023-06-30","date_next":"2023-03-10","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung","it":"Esposizioni","sp":"Exhibici\u00f3n","pt":null,"cn":null}},"others":{"list":[36,38],"translations":{"fr":["Mus\u00e9es et art centers","Sculpture"],"nl":["Musea en kunstcentra","Beeldhouwkunst"],"en":["Museums and art centers","Sculpture"],"de":["Museen & Kunstzentren","Skulptur"],"it":["Musei e centri artistici","Scultura"],"sp":["Museos y centros de arte","Escultura"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Le Chat d\u00e9ambule","shortdescr":"22 sculptures monumentales du Chat de Geluck sont expos\u00e9es dans le Parc Royal \u00e0 Bruxelles du 10 mars au 30 juin 2023","longdescr":"Apr\u00e8s les Champs-Elys\u00e9es, Bordeaux, Caen, Gen\u00e8ve, Monaco et Montreux, Le Chat d\u00e9ambule enfin \u00e0 Bruxelles, ville natale du dessinateur-humoriste Philippe Geluck. Et pour l'occasion, 2 nouvelles scuptures sont d\u00e9voil\u00e9es. Une exposition impressionnante, dans laquelle Le Chat, comme \u00e0 son habitude, nous fait rire, nous questionne et nous touche par les sujets profonds qu\u2019il aborde avec l\u00e9g\u00e8ret\u00e9.\r\n\r\nL'appli mobile Le Chat, disponible gratuitement et dans 3 langues, constitue un\r\nv\u00e9ritable audio-guide richement illustr\u00e9 de photos, dessins et vid\u00e9os.","performers":null,"boxoffice_url":null,"website":"https:\/\/lechat.com\/lechatdeambule\/exposition\/","email":"expo@geluck.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.551791"},"nl":{"name":"De Kat op pad","shortdescr":"22 monumentale bronzen beelden van De Kat worden vanaf 9 maart 2023 ge\u00efnstalleerd in het Warandepark.","longdescr":"Na Parijs, Bordeaux, Caen, Geneve, Monaco en Montreux rond wandeld eindelijk De Kat in Brussel, geboorte stad van cartoonist en humorist Philippe Geluck. En voor de gelenheid zullen er 2 nieuwe bronze beelhouwwerken onthuld worden! Een indrukwekkende tentoonstelling en zoals hij gewend is zal De Kat ons doen lachen ons ondervragen en aanvoelen met diepe onderwerpen, die hij met veel lichtheid aanpakt.\r\n \r\nDe mobile app \u201cLe Chat\u201d is gratis beschikbaar (in drie talen) en is een echte audio gids die rijk geillustreerd is met photos, tekeningen en video\u2019s.","performers":null,"boxoffice_url":null,"website":"https:\/\/lechat.com\/lechatdeambule\/exposition\/","email":"expo@geluck.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.551791"},"en":{"name":"Le Cat Walks","shortdescr":"22 sculptures of Le Cat by cartoonist Philippe Geluck are presented in Brussels' Royal Park from 10 march 2023.","longdescr":"Already presented in Paris, Bordeaux, Caen, Geneva, Monaco and Montreux, this pharaonic Le Cat exhibition is now in Brussels, hometown of humorist Philippe Geluck. And for this special occasion, 2 new sculptures will be revealed. A staggering exhibition in which Le Cat, true to himself, makes us laugh, questions us and touches us with his lighthearted approach to serious matters.\r\n\r\nThe \"Le Chat\" mobile app, free and available in 3 languages, is a real audioguide, richly illustrated with photos, drawings and videos.","performers":null,"boxoffice_url":null,"website":"https:\/\/lechat.com\/lechatdeambule\/exposition\/","email":"expo@geluck.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.551791"},"de":{"name":"Le Chat d\u00e9ambule","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lechat.com\/lechatdeambule\/exposition\/","email":"expo@geluck.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.551791"},"it":{"name":"Le Chat d\u00e9ambule","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lechat.com\/lechatdeambule\/exposition\/","email":"expo@geluck.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.551791"},"sp":{"name":"Le Chat d\u00e9ambule","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lechat.com\/lechatdeambule\/exposition\/","email":"expo@geluck.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.551791"},"pt":{"name":"Le Chat d\u00e9ambule","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lechat.com\/lechatdeambule\/exposition\/","email":"expo@geluck.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.551791"},"cn":{"name":"Le Chat d\u00e9ambule","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lechat.com\/lechatdeambule\/exposition\/","email":"expo@geluck.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.551791"}},"place":{"id":237417,"translations":{"fr":{"name":"Parc de Bruxelles \/ Parc Royal","address_street_name":"Place des Palais","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais","address_line2":"1000 Bruxelles","description_web":"Le parc de Bruxelles, auparavant appel\u00e9 \u00ab\u00a0Parc royal\u00a0\u00bb, est le plus ancien parc de la ville qui fut le premier \u00e0 \u00eatre public. Am\u00e9nag\u00e9 sur les ruines de celui des ducs de Bourgogne et des gouverneurs des Pays-Bas, il est situ\u00e9 entre le parlement F\u00e9d\u00e9ral \u2013 ou Palais de la Nation \u2013 et le palais Royal, symboles du pouvoir et de la royaut\u00e9. Ce parc est le t\u00e9moin des violents combats des Bruxellois lors de la r\u00e9volution de 1830.\r\n\r\nCon\u00e7u dans un style n\u00e9o-classique par l'architecte Guimard et le jardinier Zinner, il s\u2019ouvre sur le grand bassin pour ensuite vous offrir de larges all\u00e9es, des alignements sym\u00e9triques et des perspectives. Retrouvez des statues de la mythologie gr\u00e9co-romaine, le Vauxhall, un kiosque \u00e0 musique, le Th\u00e9\u00e2tre Royal du Parc, la Guinguette Royale ou encore le Kiosk Radio, un bar o\u00f9 danser sous les arbres\u00a0!","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Warandepark \/ Koninklijk Park","address_street_name":"Paleizenplein","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Paleizenplein","address_line2":"1000 Brussel","description_web":"Het Warandepark noemden ze vroeger \u2018Koninklijk Park\u2019. Het is het oudste park van de stad en het eerste dat openbaar werd gemaakt. Lang geleden werd het Warandepark gebouwd op de ru\u00efnes van het park van de hertogen van Bourgondi\u00eb en de gouverneurs van de Nederlanden. Nu vind je het tussen het Federaal Parlement (Paleis van de Natie) en het Koninklijk Paleis, symbolen van macht en koningschap. In dit park werd er hevig gevochten tijdens de revolutie van 1830.\r\n\r\nArchitect Guimard en de tuinman Zimmer ontwierpen het park in neo-klassieke stijl. Centraal ligt het grote dok. Vandaar vertrekken brede paden, symmetrische uitlijningen en perspectieven. Je vindt hier heel wat standbeelden uit de Grieks-Romeinse mythologie. Neem ook eens een kijkje in de Vauxhall, het Th\u00e9\u00e2tre Royal du Parc, de Guinguette Royale en Kiosk Radio, een radiostation met bar waar je kan dansen onder de bomen!","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Brussels Park","address_street_name":"Place des Palais","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Place des Palais","address_line2":"1000 Brussels","description_web":"Brussels Park, known for many years previously as the Royal Park, is the oldest park in the region which became a public park. Built on the ruins of the park of the Dukes of Burgundy and the Governors of the Spanish Netherlands, it stands proudly between the Federal Parliament and the Royal Palace, symbols of power and the monarchy. This spot, was once the site of fierce battles for the people of Brussels during the revolution in 1830.\r\n\r\nDesigned in a neo-classical style by architect Guimard and gardener Zinner, it opens onto the large pond and then offers you wide alleys, symmetrical alignments and stunning views. You'll find statues of Greco-Roman mythology, the Vauxhall, a bandstand, the Th\u00e9\u00e2tre Royal du Parc, the Guinguette Royale and even Kiosk Radio, a bar where you can dance beneath the trees!","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Parc de Bruxelles \/ Parc Royal","address_street_name":"Place des Palais","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais","address_line2":"1000 Bruxelles","description_web":"Der Parc de Bruxelles, ehemals \u201eParc Royal\u201c, ist der \u00e4lteste Park der Stadt und der erste, der f\u00fcr die \u00d6ffentlichkeit zug\u00e4nglich war. Er wurde einst auf den \u00dcberresten des Parks der Herz\u00f6ge von Burgund und der Gouverneure der Niederlande angelegt und befindet sich zwischen den beiden wichtigsten belgischen Machtzentren, d. h. dem Bundesparlament \u2013 oder Palast der Nation \u2013 und dem K\u00f6nigspalast. Der Park wurde im Zuge der Revolution im Jahr 1830 zum Schauplatz heftiger K\u00e4mpfe.\r\n\r\nEr wurde von dem Architekten Guimard und dem G\u00e4rtner Zinner im neoklassizistischen Stil angelegt und \u00f6ffnet sich zu einem gro\u00dfen Becken hin, wobei er dem Spazierg\u00e4nger mit seinen breiten Alleen und symmetrischen Fluchten sch\u00f6ne Perspektiven bietet. \u00dcber den Park verteilt finden Besucher Statuen aus der griechisch-r\u00f6mischen Mythologie, den historischen Veranstaltungsort Vauxhall, einen Musikpavillon, das Th\u00e9\u00e2tre Royal du Parc, das Park-Caf\u00e9 Guinguette Royale oder auch die kleine Holzh\u00fctte des Kiosk Radio mit eklektischer Musikauswahl und Erfrischungsgetr\u00e4nken!","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Parc de Bruxelles \/ Parc Royal","address_street_name":"Place des Palais","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Parque de Bruselas","address_street_name":"Place des Palais","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais","address_line2":"1000 Bruxelles","description_web":"Conocido como el \"Parque Real\" por muchos a\u00f1os, fue el primer parque p\u00fablico de Bruselas. Este enorme cuadril\u00e1tero sembrado de \u00e1rboles y orgulloso de situarse entre el Parlamento y el Palacio Real de Bruselas se extiende ante amplios caminos, sim\u00e9tricamente alineados y con sorprendentes perspectivas. En cuanto te abras camino atravesar\u00e1s amplios y frondosos claros, un escenario, un teatro, dos fuentes y varios quioscos que sirven refrescos. Y sin embargo, este lugar, que radia tranquilidad, una vez fue el lugar de feroces batallas por la gente de Bruselas que luch\u00f3 por su revoluci\u00f3n en 1830.\r\n\r\nEn 1770, todo el distrito  de la Corte(ahora Place Royale y el Parque de Bruselas) fue renovado. El arquitecto Guimard dibuj\u00f3 el plano para el nuevo parque. Fue aconsejado por el jardinero Zinner, a quien fue atribu\u00eddo el rol de Guimard de manera err\u00f3nea. Fue en este parque donde tuvieron lugar las primeras batallas entre los patriotas belgas y las tropas neerlandesas en 1830.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Parque de Bruxelas\/Parque Real","address_street_name":"Place des Palais","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais","address_line2":"1000 Bruxelles","description_web":"O parque de Bruxelas, antigamente denominado \u00abParque Real\u00bb foi o primeiro parque p\u00fablico de Bruxelas. Situa-se entre o Parlamento Federal e o Pal\u00e1cio Real. Oferece vias largas, alinhamentos sim\u00e9tricos e perspetivas surpreendentes. Encontramos a\u00ed clareiras de vegeta\u00e7\u00e3o, um coreto, um teatro, duas fontes e alguns quiosques de restaura\u00e7\u00e3o. O parque de Bruxelas respira agora serenidade, mas foi palco de combates violentos dos bruxelenses, que aqui lutaram pela sua revolu\u00e7\u00e3o em 1830. Na d\u00e9cada de 1770, todo o bairro da Corte foi transformado. O arquiteto Guimard desenhou o novo plano do parque. Foi assistido pelo jardineiro Zinner, a quem foi atribu\u00eddo erroneamente o papel de Guimard. Equipamentos : -Bancos -Fonte de \u00e1gua pot\u00e1vel -Parque infantil 7-12 anos -Quiosque -Sanit\u00e1rios Acessibilidade: h\u00e1 um degrau em cada entrada do parque. De seguida, \u00e9 relativamente f\u00e1cil para uma pessoa com mobilidade condicionada deslocar-se pelo parque. Alguns elementos do parque infantil foram especialmente adaptados para crian\u00e7as portadoras de defici\u00eancia.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Parc de Bruxelles \/ Parc Royal","address_street_name":"Place des Palais","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[16],"translations":{"fr":["Quartier Royal"],"nl":["Koninklijke wijk"],"en":["Royal"],"de":["K\u00f6nigliches Viertel"],"it":["Quartiere reale"],"sp":["Quartier Royal \u2014Barrio de la Corte\u2014"],"pt":[null],"cn":[null]}},"zones":{"list":[19],"translations":{"fr":["Centre"],"nl":["Centrum"],"en":["Centre"],"de":["Zentrum"],"it":["Centro"],"sp":["Centro"],"pt":[null],"cn":[null]}},"neca":null,"facebook_id":null,"backoffice_id":1764,"location":{"lat":50.84262397,"lon":4.36270506},"region":"brussels","last_updated_at":"2023-02-17T13:05:05+01:00","published_at":"2013-10-19T01:14:37+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":279955,"translations":{"fr":{"name":"Fidalian","address_street_name":"rue Elise","address_street_number":"87","address_street_box":null,"email":null,"website":"http:\/\/www.lechat.com","phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"rue Elise, 87","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Fidalian","address_street_name":"rue Elise","address_street_number":"87","address_street_box":null,"email":null,"website":"http:\/\/www.lechat.com","phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"rue Elise, 87","address_line2":"1050 Elsene","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},