l,"sub_type":"theatre","show_in_agenda":true,"ranking":0.8735804647363},{"id":545435,"date_start":"2022-11-25","date_end":"2022-12-24","date_next":"2022-11-25","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":71,"translations":{"fr":"March\u00e9s & brocantes","nl":"Markten & brocante","en":"Markets and bric-a-brac stores","de":"M\u00e4rkte & Flohm\u00e4rkte"}},"others":{}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Creators Factory - March\u00e9 Durable","shortdescr":"March\u00e9 de \u00ab transformateurs de mati\u00e8re \u00bb dont l\u2019\u00e9thique et la durabilit\u00e9 sont les ma\u00eetres-mots, le CREATORS FACTORY s\u2019inscrit dans la mutation solidaire et (\u00e9co)responsable actuelle.","longdescr":"March\u00e9 de \u00ab transformateurs de mati\u00e8re \u00bb dont l\u2019\u00e9thique et la durabilit\u00e9 sont les ma\u00eetres-mots, le CREATORS FACTORY s\u2019inscrit dans la mutation solidaire et (\u00e9co)responsable actuelle.\r\n\r\nPour sa deuxi\u00e8me \u00e9dition, il se d\u00e9ploie dans les Halles Saint-G\u00e9ry durant cinq week-ends, en collaboration avec trois op\u00e9rateurs : Christmas designers Market (du 25.11 au 27.11 et du 09.12 au 11.12), The Wild Pop-Up (du 02.12 au 04.12) et Fais-le toi-m\u00eame (du 16.12 au 18.12 et du 22.12 au 24.12).\r\n\r\nSuspendue dans les magnifiques Halles Saint-G\u00e9ry, une hyperSPHERE reproduit une lune spectaculaire. Des fanfares contribuent \u00e0 rendre cette exp\u00e9rience vraiment sp\u00e9ciale.","performers":"Christmas designers Market\r\nThe Wild Pop-Up\r\nFais-le toi-m\u00eame","boxoffice_url":null,"website":"http:\/\/plaisirsdhiver.be\/creators-factory\/","email":"info@bmeo.be","phone_contact":"+32 2 318 64 70","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.545435"},"nl":{"name":"Creators Factory - Duurzame Markt","shortdescr":"Op CREATORS FACTORY, een markt van \u2018transformatoren van de materie\u2019, zijn ethiek en duurzaamheid de sleutelwoorden. Deze markt sluit immers perfect aan bij de toenemende solidariteit en (ecologische) verantwoordelijkheid in onze wereld.","longdescr":"Op CREATORS FACTORY, een markt van \u2018transformatoren van de materie\u2019, zijn ethiek en duurzaamheid de sleutelwoorden. Deze markt sluit immers perfect aan bij de toenemende solidariteit en (ecologische) verantwoordelijkheid in onze wereld.\r\n\r\nDe tweede editie vindt gedurende vijf weekends plaats in de Sint-Gorikshallen, in samenwerking met drie organisaties: Christmas designers Market (van 25.11 tot 27.11 en van 09.12 tot 11.12), The Wild Pop-Up (van 02.12 tot 04.12) en Fais-le toi-m\u00eame (van 16.12 tot 18.12 en van 22.12 tot 24.12).\r\n\r\nIn de schitterende Sint-Gorikshallen zal een reuzenBAL worden opgehangen die een spectaculaire maan voorstelt. Met fanfares erbij wordt het een onvergetelijke ervaring.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.545435"},"en":{"name":"Creators Factory - Sustainable Market","shortdescr":"The CREATORS FACTORY is a market of \"materials transformers\" where ethics and sustainability are central. It\u2019s part of the current shift towards solidarity and (eco)responsibility.","longdescr":"The CREATORS FACTORY is a market of \"materials transformers\" where ethics and sustainability are central. It\u2019s part of the current shift towards solidarity and (eco)responsibility.\r\n\r\nIts second edition will take place in the Halles Saint-G\u00e9ry over five weekends in collaboration with three operators: Christmas designers Market (from 25.11 to 27.11 and from 09.12 to 11.12), The Wild Pop-Up (from 02.12 to 04.12) and Fais-le toi-m\u00eame (from 16.12 to 18.12 and from 22.12 to 24.12).\r\n\r\nA hyperSPHERE reproduces a spectacular moon suspended in the magnificent Halles Saint-G\u00e9ry. Brass bands help to make this a truly special experience.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.545435"},"de":{"name":"Creators Factory","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.545435"},"it":{"name":"Creators Factory","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.545435"},"sp":{"name":"Creators Factory","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.545435"},"pt":{"name":"Creators Factory","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.545435"},"cn":{"name":"Creators Factory","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.545435"}},"place":{"id":247371,"translations":{"fr":{"name":"Halles Saint-G\u00e9ry","address_street_name":"Place Saint-G\u00e9ry","address_street_number":null,"address_street_box":null,"email":"info@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Saint-G\u00e9ry","address_line2":"1000 Bruxelles","description_web":"Remarquable t\u00e9moin de l\u2019architecture des march\u00e9s couverts, les Halles Saint-G\u00e9ry  contribuent \u00e0 valoriser le patrimoine de la R\u00e9gion de Bruxelles-Capitale. Centre d\u2019exposition et de manifestation bas\u00e9 en plein coeur du pentagone, elles ont pour vocation de mettre en valeur les traits de d\u00e9marcation du cadre de vie bruxellois et de son identit\u00e9 urbaine par le biais d'une programmation hybride, allant des expositions, aux conf\u00e9rences, concerts, rencontres et performances \u2026\r\nLe Centre Urbain (guichet d\u2019information r\u00e9gional, pour mieux vous conseiller sur l\u2019habitat durable en R\u00e9gion de Bruxelles-Capitale) est \u00e9galement situ\u00e9 au sein des Halles.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Sint-Gorikshallen","address_street_name":"Sint-Goriksplein","address_street_number":null,"address_street_box":null,"email":"info@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Sint-Goriksplein","address_line2":"1000 Brussel","description_web":"De Sint-Gorikshallen zijn een prachtig architecturaal staaltje van openbare markthallen in het 19de-eeuwse Brussel. Het gebouw werd een aantal jaren geleden volledig gerestaureerd en doet tegenwoordig dienst als permanente informatie-, tentoonstellings- en evenementenruimte gewijd aan het erfgoed en de levenswijzen in de hoofdstad. Op amper twee minuten stappen van de Beurs vormen de Sint-Gorikshallen een gezellige plek om te ontspannen en nieuwe dingen te ontdekken, zowel overdag als bij het vallen van de nacht.\r\nDe hallen herbergen ook de Stadswinkel, een vereniging die de inwoners van het Brussels Hoofdstedelijk Gewest  wil informeren over het leefmilieu en een kwaliteitsvolle leefomgeving, huisvesting, stadsrenovatie, stedenbouw en ruimtelijke ordening, en rationeel energiegebruik. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Halles Saint-G\u00e9ry","address_street_name":"Place Saint-G\u00e9ry","address_street_number":null,"address_street_box":null,"email":"info@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Place Saint-G\u00e9ry","address_line2":"1000 Brussels","description_web":"The Saint-G\u00e9ry Market Halls are a fine architectural example of 19th-century public markets in Brussels. The building was completely restored several years ago and is now a permanent information and exhibition space, with urban planning, heritage, and urban renewal as its central themes.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Halles Saint-G\u00e9ry","address_street_name":"Place Saint-G\u00e9ry","address_street_number":null,"address_street_box":null,"email":"info@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Saint-G\u00e9ry","address_line2":"1000 Bruxelles","description_web":"Die Halles Saint-G\u00e9ry mit ihrer eklektischen Architektur wurden Ende des 19. Jahrhundert als Markthalle erbaut und spielten in der Br\u00fcsseler Stadtgeschichte eine wichtige Rolle.\r\n\r\nDie Saint-G\u00e9ry-Hallen waren einerseits sowohl legend\u00e4re als auch kaufm\u00e4nnische Wiege der Stadt. Ab dem 11. Jahrhundert stand an dieser Stelle eine dem Heiligen Saint-G\u00e9ry gewidmete Kapelle. Verschiedene Wohnh\u00e4user waren hier entstanden und aufgrund der N\u00e4he zur Senne entwickelten sich zahlreiche Aktivit\u00e4ten.\r\n\r\nIm 16. Jahrhundert erhielt die Kapelle den Status einer Pfarrkirche, die prachtvoll im gotischen Stil erweitert wurde, dann aber im Zuge der Franz\u00f6sische Revolution dem Erdboden gleichgemacht wurde.\r\n\r\nDer ehemalige Markt - und sogar das gesamte Saint-G\u00e9ry-Viertel \u2013 waren ihrerseits in den 1960er-Jahren von der Zerst\u00f6rung bedroht, bis das Viertel in den 1990er-Jahren eine Art zweiten Fr\u00fchling erlebte. Seit 1999 fungieren die Saint-G\u00e9ry-Hallen als Informations- und Ausstellungszentrum rund um die Br\u00fcsseler Stadtgeschichte und das st\u00e4dtische Leben in Br\u00fcssel. An der Bar gibt es Getr\u00e4nke und Speisen.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Halle di Saint-Gery","address_street_name":"Place Saint-G\u00e9ry","address_street_number":null,"address_street_box":null,"email":"info@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Saint-G\u00e9ry","address_line2":"1000 Bruxelles","description_web":"Le Halles Saint-G\u00e9ry (mercato coperto) ospitano un centro d'informazione dedicato al patrimonio e al quadro di vita dei Bruxellesi...\r\nLe Halles Saint-G\u00e9ry (mercato coperto) ospitano un centro d'informazione dedicato al patrimonio e al quadro di vita dei Bruxellesi. Sotto il patrocinio della regione di Bruxelles Capitale.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Halles Saint-G\u00e9ry","address_street_name":"Place Saint-G\u00e9ry","address_street_number":null,"address_street_box":null,"email":"info@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Saint-G\u00e9ry","address_line2":"1000 Bruxelles","description_web":"Verdadero testigo de los mercados cubiertos, las Halles Saint-G\u00e9ry albergan un centro de informaci\u00f3n, bajo la \u00e9gida de la Regio\u00f3n de Bruselas Capital y dedicado al patrimonio...\r\nVerdadero testigo de los mercados cubiertos, las Halles Saint-G\u00e9ry albergan un centro de informaci\u00f3n, bajo la \u00e9gida de la Regio\u00f3n de Bruselas Capital y dedicado al patrimonio y al marco de vida de los bruselenses.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Halles Saint-G\u00e9ry","address_street_name":"Place Saint-G\u00e9ry","address_street_number":null,"address_street_box":null,"email":"info@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Saint-G\u00e9ry","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Halles Saint-G\u00e9ry","address_street_name":"Place Saint-G\u00e9ry","address_street_number":null,"address_street_box":null,"email":"info@hallessaintgery.be","website":"http:\/\/www.hallessaintgery.be","phone_contact":"+32 2 502 44 24","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Saint-G\u00e9ry","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[3],"translations":{"fr":["Dansaert\/Sainte-Catherine"],"nl":["Dansaertwijk\/Sint-Katelijne"],"en":["Dansaert\/Sainte-Catherine"]}},"zones":{"list":[19],"translations":{"fr":["Centre"],"nl":["Centrum"],"en":["Centre"]}},"neca":null,"facebook_id":null,"backoffice_id":9562,"location":{"lat":50.84801328,"lon":4.34683241},"region":"brussels","last_updated_at":"2022-11-09T16:35:31+01:00","publ