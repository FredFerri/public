3-20","date_end":"2024-03-23","date_next":"2024-03-20","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-03-07T16:30:03+01:00","published_at":"2024-03-07T16:13:31+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":296122,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"theatre","ranking":0.7937005259840998,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":49,"translations":{"de":"Theater","pt":null,"en":"Theatre","it":"Teatro","cn":null,"fr":"Th\u00e9\u00e2tre","sp":"Teatro","nl":"Theater"}},"others":{}},"translations":{"de":{"name":"POp\u200a!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lamontagnemagique.be\/pop\/","email":"info@montagnemagique.be","phone_contact":"+32 2 210 15 90","phone_booking":"+32 2 210 15 90","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50008215"},"pt":{"name":"POp\u200a!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lamontagnemagique.be\/pop\/","email":"info@montagnemagique.be","phone_contact":"+32 2 210 15 90","phone_booking":"+32 2 210 15 90","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50008215"},"en":{"name":"POp\u200a!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lamontagnemagique.be\/pop\/","email":"info@montagnemagique.be","phone_contact":"+32 2 210 15 90","phone_booking":"+32 2 210 15 90","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50008215"},"it":{"name":"POp\u200a!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lamontagnemagique.be\/pop\/","email":"info@montagnemagique.be","phone_contact":"+32 2 210 15 90","phone_booking":"+32 2 210 15 90","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50008215"},"cn":{"name":"POp\u200a!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lamontagnemagique.be\/pop\/","email":"info@montagnemagique.be","phone_contact":"+32 2 210 15 90","phone_booking":"+32 2 210 15 90","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50008215"},"fr":{"name":"POp\u200a!","shortdescr":"Un spectacle \u00e0 l\u2019\u00e9tranget\u00e9 envoutante et hypnotique, sans parole, avec une armoire\u2026 magique\u200a!\n","longdescr":"Quand on arrive au monde, on ne connait rien, on doit tout d\u00e9couvrir, se d\u00e9couvrir.\n\nPour entrer dans le monde, il faut d\u2019abord choisir la bonne porte. Mais laquelle? Elles se ressemblent et se r\u00e9v\u00e8lent pourtant diff\u00e9rentes, un vrai labyrinthe\u200a!\nAvant de marcher, s\u00e9lectionner sa paire de chaussettes.\nMais lesquelles\u200a? Celles \u00e0 carreaux, les lign\u00e9es, les unies, les harmonieuses ou les d\u00e9pareill\u00e9es\u200a? Comment se d\u00e9finir sans \u00eatre rang\u00e9 dans une case ou finir dans un tiroir \u00e9triqu\u00e9\u200a? Et que faire lorsque son propre reflet d\u00e9cide de s\u2019en m\u00ealer\u200a?\n\n\nAvec Gaspard Rozenwajn et Jules Rozenwajn en alternance. Sc\u00e9nario et mise en sc\u00e8ne: Ariane Buhbinder. Premi\u00e8res explorations avec l\u2019aide de L\u00e9onard Berthet Rivi\u00e8re. Sc\u00e9nographie\u200a: Sylvianne Besson. Costumes: Samuel Dronet avec l\u2019aide d\u2019Odile Dubucq, Isabelle Airau et Fran\u00e7oise Van Thienen. Son: Josselin Moinet. Mixage: Chris de Vleeschouwer. Accompagnement au mouvement: Caroline Corn\u00e9lis. Maquillage: Rebecca Flores-Martinez. Construction d\u00e9cor, am\u00e9nagements et peinture: Yves Hauwaert, Sylvianne Besson et Miette. Aide d\u00e9cors et accessoires: Daniel Tison. R\u00e9gie de plateau et machiniste: Miette ou Hannah Kircher-Zuber. Lumi\u00e8re: Nicolas Fauchet. R\u00e9gie: Nicolas Fauchet ou Anthony Vanderborght. Diffusion: Pierre Ronti \u2013 Mes Id\u00e9es Fixes. Graphisme et illustrations: Loic Gaume. Avec la participation des \u00e9l\u00e8ves de 3\u00e8me ann\u00e9e de l\u2019\u00e9cole communale de Saint-Vaast et de leur institutrice Mme Laurence.\nEn coproduction avec La Coop. Avec le soutien de Tax Shelter.be, shelterprod, ING et le Tax shelter du gouvernement belge. Le service de la Cr\u00e9ation de la FWB, le service de la Diffusion, les Tourn\u00e9es Art et Vie et Spectacles \u00e0 l\u2019\u00e9cole. Le spectacle a \u00e9t\u00e9 accueilli en r\u00e9sidence par La Roseraie, Ekla pour tous, le Monty, Le Columban et Les Chiroux.\n\n","performers":"L\u2019Anneau","boxoffice_url":null,"website":"https:\/\/lamontagnemagique.be\/pop\/","email":"info@montagnemagique.be","phone_contact":"+32 2 210 15 90","phone_booking":"+32 2 210 15 90","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50008215"},"sp":{"name":"POp\u200a!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lamontagnemagique.be\/pop\/","email":"info@montagnemagique.be","phone_contact":"+32 2 210 15 90","phone_booking":"+32 2 210 15 90","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50008215"},"nl":{"name":"POp\u200a!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lamontagnemagique.be\/pop\/","email":"info@montagnemagique.be","phone_contact":"+32 2 210 15 90","phone_booking":"+32 2 210 15 90","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50008215"}},"place":{"id":228012,"translations":{"de":{"name":"Kindertheater - Th\u00e9\u00e2tre La montagne magiq