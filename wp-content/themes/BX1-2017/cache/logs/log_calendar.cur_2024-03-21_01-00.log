escr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/culture1030.be\/event\/les-crocodiles-sont-toujours-la","email":"info@culture1030.be","phone_contact":"+32 2 245 27 25","phone_booking":"+32 2 245 27 25","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50007290"},"it":{"name":"Expo \u00ab Les Crocodiles sont toujours l\u00e0 \u00bb","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/culture1030.be\/event\/les-crocodiles-sont-toujours-la","email":"info@culture1030.be","phone_contact":"+32 2 245 27 25","phone_booking":"+32 2 245 27 25","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50007290"},"cn":{"name":"Expo \u00ab Les Crocodiles sont toujours l\u00e0 \u00bb","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/culture1030.be\/event\/les-crocodiles-sont-toujours-la","email":"info@culture1030.be","phone_contact":"+32 2 245 27 25","phone_booking":"+32 2 245 27 25","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50007290"},"fr":{"name":"Expo : Les Crocodiles sont toujours l\u00e0","shortdescr":"Des t\u00e9moignages de femmes victimes de harc\u00e8lement de rue et de sexisme ordinaire, illustr\u00e9s en bande-dessin\u00e9e par Juliette Boutant et Thomas Mathieu.","longdescr":"Les hommes sont ici repr\u00e9sent\u00e9s sous la forme de crocodiles : une fa\u00e7on ludique et originale de d\u00e9peindre la r\u00e9alit\u00e9 brutale des violences sexistes qui se d\u00e9roulent dans la rue, mais \u00e9galement dans la sph\u00e8re professionnelle, m\u00e9dicale, ou encore \u00e9ducative.\n\nCette exposition, organis\u00e9e dans le cadre de la Journ\u00e9e des droits des femmes, met en lumi\u00e8re des situations souvent ignor\u00e9es, encourageant la r\u00e9flexion et la discussion sur les d\u00e9fis persistants li\u00e9s au sexisme.\n\n*\n\nCette exposition est propos\u00e9e dans le cadre du festival 364ELLES, organis\u00e9e \u00e0 l\u2019occasion de la Journ\u00e9e Internationale des Droits des Femmes du 8 mars.\n\nLe Centre Culturel de Schaerbeek propose ainsi une s\u00e9rie de rendez-vous visant \u00e0 mettre en lumi\u00e8re les droits culturels des femmes. Pour cette \u00e9dition 2024, le festival met en avant le talent exceptionnel des femmes dans le domaine de l\u2019humour et de l\u2019art, d\u00e9voilant ainsi la richesse et la diversit\u00e9 de leurs contributions.\n\nLe Centre Culturel, dont l\u2019une des missions est de renforcer l\u2019expression des droits culturels des femmes, met \u00e0 l\u2019honneur des femmes qui prennent la parole, qui donne \u00e0 voir autrement, qui questionnent les tabous, la violence et les pr\u00e9jug\u00e9s.","performers":"Juliette Boutant; Thomas Mathieu","boxoffice_url":null,"website":"https:\/\/culture1030.be\/event\/les-crocodiles-sont-toujours-la","email":"info@culture1030.be","phone_contact":"+32 2 245 27 25","phone_booking":"+32 2 245 27 25","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50007290"},"sp":{"name":"Expo \u00ab Les Crocodiles sont toujours l\u00e0 \u00bb","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/culture1030.be\/event\/les-crocodiles-sont-toujours-la","email":"info@culture1030.be","phone_contact":"+32 2 245 27 25","phone_booking":"+32 2 245 27 25","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50007290"},"nl":{"name":"\u00ab Les Crocodiles sont toujours l\u00e0 \u00bb","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/culture1030.be\/event\/les-crocodiles-sont-toujours-la","email":"info@culture1030.be","phone_contact":"+32 2 245 27 25","phone_booking":"+32 2 245 27 25","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50007290"}},"place":{"id":232783,"translations":{"de":{"name":"Centre Culturel d