:00:00"}]},"saturday":{"is_open":true,"hours":[{"start":"10:00:00","end":"18:00:00"}]},"sunday":{"is_open":true,"hours":[{"start":"10:00:00","end":"18:00:00"}]}},"translations":{"fr":["lundi: ferm\u00e9","mardi, mercredi, jeudi, vendredi, samedi et dimanche: de 10:00 \u00e0 18:00"],"nl":["maandag: gesloten","dinsdag, woensdag, donderdag, vrijdag, zaterdag en zondag: van 10:00 tot 18:00"],"en":["monday: closed","tuesday, wednesday, thursday, friday, saturday and sunday: from 10:00 to 18:00"]},"date_start":"2022-09-08","date_end":"2022-11-13","is_also_by_appointment":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":12},{"translations":{"fr":{"name":"Enfants"},"nl":{"name":"Kinderen"},"en":{"name":"Children"}},"value":5},{"translations":{"fr":{"name":"Jeunes"},"nl":{"name":"Jongeren"},"en":{"name":"Young people"}},"value":9},{"translations":{"fr":{"name":"Seniors"},"nl":{"name":"Senioren"},"en":{"name":"Seniors"}},"value":9},{"translations":{"fr":{"name":"museumpassmus\u00e9es"},"nl":{"name":"museumpassmus\u00e9es"},"en":{"name":"museumpassmus\u00e9es"}},"value":0},{"translations":{"fr":{"name":"Article 27"},"nl":{"name":"Artikel 27"},"en":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"visit_profile":{"list":[321,349,337],"translations":{"fr":["Bande Dessin\u00e9e","Geek & pop culture","Highlight"],"nl":["Stripverhaal","Geek- & popcultuur","Highlight"],"en":["Comic strip","Geek & pop culture","Highlight"],"de":["Comic","Geek & Popkultur","Highlight"]}},"tags":[],"accessibilities":{"list":[252,255,259,263,265],"translations":{"fr":["Accessible aux personnes ayant des difficult\u00e9s de compr\u00e9hension","Accessible","Chien d'assistance","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9"],"nl":["Toegankelijk voor mensen met een verstandelijke beperking","Toegankelijk","Assistentiehonden","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet"],"en":["Accessible to people with intellectual disabilities","Accessible","Assistance dogs","Accessible to pedestrians with mobility aids","Adapted toilet"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-24T01:36:24+02:00","published_at":"2022-06-29T14:32:57+02:00","backoffice_id":257315,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.62041419613207},{"id":540679,"date_start":"2022-10-25","date_end":"2022-11-06","date_next":"2022-10-25","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung"}},"others":{"list":[24,27],"translations":{"fr":["Galeries d'art","Photographie"],"nl":["Galeries","Fotografie"],"en":["Art Galleries","Photography"],"de":["Kunstgalerien","Fotografie"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"House of Souls","shortdescr":"House of Souls est une exposition photographique et immersive sur le deuil p\u00e9rinatal, une exploration intime du parcours de femmes et d\u2019hommes confront\u00e9s \u00e0 une fausse couche ou \u00e0 une mort in ut\u00e9ro. En cr\u00e9ant une alc\u00f4ve o\u00f9 la photographie sert de tremplin \u00e0 la circulation de leurs paroles, je nous invite toutes et tous \u00e0 nous confronter \u00e0 la r\u00e9alit\u00e9 de ces \u00e9v\u00e8nements.","longdescr":"Depuis que je suis tr\u00e8s jeune, je suis comme envo\u00fbt\u00e9e par les ventres. Cette r\u00e9gion cach\u00e9e derri\u00e8re le nombril, cet espace central du corps, o\u00f9 tout commence. \r\nLe ventre, l\u2019image de la vie par excellence, o\u00f9 la vie appara\u00eet, parfois miraculeusement, puis grandit ou disparait. \r\n\r\nPour les femmes et aussi pour les hommes, le ventre, le sacral, repr\u00e9sente l\u2019\u00e9nergie vitale. C\u2019est le lieu des \u00e9motions qu\u2019on montre, crie, d\u00e9voile, garde enfouies. Certains l\u2019appellent le \u00ab deuxi\u00e8me cerveau \u00bb : reflet de nous-m\u00eames, de notre histoire pass\u00e9e, de nos blessures. Il d\u00e9tient la m\u00e9moire du corps, de ce corps, de notre corps. Un esprit peut oublier mais notre corps n\u2019oublie jamais. Ce ventre est pour moi comme l\u2019encre ind\u00e9l\u00e9bile de notre vie, de notre pass\u00e9, de nos blessures, de nos forces. C\u2019est un v\u00e9ritable miroir de ce que nous sommes, voulons \u00eatre. \r\n\r\nNotre maison de l\u2019\u00e2me.\r\n\r\nJe pense depuis plusieurs ann\u00e9es \u00e0 cr\u00e9er un projet photographique autour de ce que j\u2019appelle \u201cHouse of Souls\u201d - la maison des \u00e2mes. Il y a quelques mois, l\u2019appel de ces ventres est venu me rattraper d\u2019une fa\u00e7on visc\u00e9rale alors que j\u2019ai fait une fausse couche. La sensation primaire de vie s\u2019est confront\u00e9e pour la premi\u00e8re fois brutalement \u00e0 celle de la mort. Dans un bout de moi, quelque chose s\u2019est rompu. Quelque chose qui, je le sens intimement, me suivra pour toujours. Tr\u00e8s vite, des questions sont venues me chambouler ; elles sont intimement li\u00e9es \u00e0 l\u2019envie de donner vie \u00e0 ce projet d\u2019exposition.","performers":"un projet de Rose Denis & de l'asbl Loup avec l'aide de Nastasja Saerens, Charlotte Cristin, Ayrton Heymans, Guillaume Jacquart, Hugo Corson","boxoffice_url":null,"website":"http:\/\/www.seaofclouds.be\/houseofsouls","email":"loupasbl@gmail.com","phone_contact":null,"phone_booking":"+32 483 32 17 66","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.540679"},"nl":{"name":"House of Souls","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"rosedenis.pro@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.540679"},"en":{"name":"House of Souls","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"rosedenis.pro@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.540679"},"de":{"name":"House of Souls exposition photographique et immersive sur le deuil p\u00e9rinatal","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.540679"},"it":{"name":"House of Souls exposition photographique et immersive sur le deuil p\u00e9rinatal","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.540679"},"sp":{"name":"House of Souls exposition photographique et immersive sur le deuil p\u00e9rinatal","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.540679"},"pt":{"name":"House of Souls exposition photographique et immersive sur le deuil p\u00e9rinatal","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.540679"},"cn":{"name":"House of Souls exposition photographique et immersive sur le deuil p\u00e9rinatal","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https: