":null,"website":"https:\/\/www.improviste.be\/Rencontres-com","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.561645"},"fr":{"name":"Rencontres.com","shortdescr":"Aimer, du virtuel au r\u00e9el\r\n","longdescr":"Rencontrer quelqu\u2019un en ligne. Pour un soir, pour la vie, pour tromper son ennui, pour se prouver qu\u2019on peut encore s\u00e9duire... Se pr\u00e9senter comme on se mettrait en vente sur Amazon. Juger. Comparer. D\u00e9sirer. Aborder un.e inconnu.e dans la s\u00e9curit\u00e9 et la st\u00e9rilit\u00e9 virtuelle. Oser passer le pas de la rencontre r\u00e9elle. Prendre le risque de se confronter \u00e0 la r\u00e9alit\u00e9.\r\n\r\nClaire de Reuck et Patrick Spadrille d\u00e9cortiquent avec humour et sinc\u00e9rit\u00e9 les rouages de l\u2019amour 2.0. Ses fantasmes, ses d\u00e9sillusions, ses angoisses, ses excitations, ses \u00e9checs et ses charmantes surprises.","performers":"Claire de Reuck et Patrick Spadrille","boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Rencontres-com","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.561645"},"sp":{"name":"Rencontres.com","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Rencontres-com","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.561645"},"nl":{"name":"Rencontres.com","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Rencontres-com","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.561645"}},"place":{"id":270611,"translations":{"de":{"name":"Th\u00e9\u00e2tre l\u2019Improviste ","addres