:null,"virtual_visit":null},"nl":{"name":"Cactus Brussel \u00e0 v\u00e9lo","address_street_name":"Grootgodshuisstraat","address_street_number":"7","address_street_box":"D6","email":"info@cactus.brussels","website":"http:\/\/www.cactus.brussels","phone_contact":null,"phone_booking":"+32 497 19 07 14","address_zip":"1000","address_city":"Brussel","address_line1":"Grootgodshuisstraat, 7\/D6","address_line2":"1000 Brussel","description_web":"Cactus Brussel \u00e0 v\u00e9lo is een Brusselse vereniging van lokale vrijwilligersgidsen met een hart voor Brussel en de fiets.\r\nHun passie voor de stad en de fiets delen ze met veel enthousiasme met bezoekers van de stad en andere Brusselaars. Ze bieden een authentieke ervaring en kennismaking met Brussel en vinden met de fiets het ideale ritme om je onder te dompelen in het veelzijdige Brussel. Liefst van al gidsen ze je langs de minder begane paden de stad in een gemoedelijke sfeer. Beleef Brussel ten volle met te fiets en ontdek meer dan je verwacht!","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Cactus Brussel \u00e0 v\u00e9lo","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":"D6","email":"info@cactus.brussels","website":"http:\/\/www.cactus.brussels","phone_contact":null,"phone_booking":"+32 497 19 07 14","address_zip":"1000","address_city":"Brussels","address_line1":"Rue du Grand Hospice, 7\/D6","address_line2":"1000 Brussels","description_web":"Cactus Brussels \u00e0 v\u00e9lo is an association of local guides with a heart for Brussels\r\nand the bicycle. During their guided bike tours, the guide-volunteers share their passion\r\nfor Brussels and the bicycle with both locals and visitors to the city. They offer an authentic\r\nexperience of Brussels and, thanks to the bicycle, they find the ideal rhythm to immerse you\r\nin this surprising capital. Their favorite way to surprise you is with an convivial bike tour\r\nalong the city's less beaten tracks. You can also choose from one of the various themed bike\r\ntours on offer or opt for a tour tailored to your group. The bike tours are ideal to integrate\r\ninto a teambuilding with your company or organization, to get inspired by the multifaceted\r\nBrussels or to discover the city with family and friends.\r\nExperience Brussels to the full by bike and discover more than you expect!\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Cactus Brussel \u00e0 v\u00e9lo","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":"D6","email":"info@cactus.brussels","website":"http:\/\/www.cactus.brussels","phone_contact":null,"phone_booking":"+32 497 19 07 14","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 7\/D6","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Cactus Brussel \u00e0 v\u00e9lo","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":"D6","email":"info@cactus.brussels","website":"http:\/\/www.cactus.brussels","phone_contact":null,"phone_booking":"+32 497 19 07 14","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 7\/D6","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Cactus Brussel \u00e0 v\u00e9lo","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":"D6","email":"info@cactus.brussels","website":"http:\/\/www.cactus.brussels","phone_contact":null,"phone_booking":"+32 497 19 07 14","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 7\/D6","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_v