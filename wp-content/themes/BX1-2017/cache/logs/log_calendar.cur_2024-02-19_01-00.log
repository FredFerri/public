 25 80","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.561004"},"pt":{"name":"Les trois Maria","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lesrichesclaires.be","email":null,"phone_contact":null,"phone_booking":"+32 2 548 25 80","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.561004"},"en":{"name":"Les trois Maria","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lesrichesclaires.be","email":null,"phone_contact":null,"phone_booking":"+32 2 548 25 80","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.561004"},"it":{"name":"Les trois Maria","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lesrichesclaires.be","email":null,"phone_contact":null,"phone_booking":"+32 2 548 25 80","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.561004"},"cn":{"name":"Les trois Maria","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lesrichesclaires.be","email":null,"phone_contact":null,"phone_booking":"+32 2 548 25 80","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.561004"},"fr":{"name":"Les trois Maria","shortdescr":"Les trois Maria est une performance th\u00e9\u00e2trale pour une com\u00e9dienne m\u00ealant cr\u00e9ations vid\u00e9o et sonore qui cherche \u00e0 traduire par le corps et par le langage une \u0153uvre \u00e9rotique et antifasciste.","longdescr":"Les trois Maria, c\u2019est l\u2019histoire de trois autrices qui s\u2019unissent en 1971 pour investir l\u2019espace public dans une soci\u00e9t\u00e9 fasciste, le Portugal de Salazar.\r\n\r\nL\u2019histoire d\u2019une r\u00e9volte et d\u2019une tentative de r\u00e9sistance \u00e0 trois. Le choix de transmuter la col\u00e8re en po\u00e9sie.\r\n\r\nComment l\u2019amour impacte-t-il le corps ?\r\nComment traduire par le corps et le langage une \u0153uvre \u00e9rotique et subversive ?\r\n\r\nLes trois Maria est une performance th\u00e9\u00e2trale pour une com\u00e9dienne m\u00ealant cr\u00e9ations vid\u00e9o et sonore qui cherche \u00e0 traduire par le corps et par le langage une \u0153uvre \u00e9rotique et antifasciste.\r\n\r\nUn spectacle de Coline Fouquet. Avec des extraits des Nouvelles lettres portugaises de Maria Teresa Horta, Maria Isabel Barreno, Maria Velho da Costa, Lisbonne 1972. Traduction de Monique Wittig et Evelyne Le Garrec, Paris, 1974. Des fragments des Lettres de la religieuse portugaise, Gabriel de Guilleragues, Paris 1669.\r\n\r\n___________\r\nTARIFS\r\nTarifs libres 8\u20ac \/ 12\u20ac \/ 16\u20ac \/ 20\u20ac \r\nTarif de soutien \u00e0 partir de 25\u20ac\r\n\r\nPlaces individuelles : CHOOSE CE QUE TU BETAALT (tarif libre)\r\nC'est vous qui choisissez le prix que vous souhaitez mettre, en fonction de vos moyens et de vos valeurs.\r\n\u00c0 l'exception des Lundi-Th\u00e9\u00e2tre qui restent \u00e0 6\u20ac pour tout le monde, nous vous indiquons un prix conseill\u00e9 qui permet une r\u00e9mun\u00e9ration juste pour les artistes et une gestion optimale pour le fonctionnement du th\u00e9\u00e2tre, mais \u00e0 vous de d\u00e9cider ! Payez ce que vous pouvez, ce que vous voulez, ce qui vous fait plaisir, ce qui vous para\u00eet juste, indispensable, \u00e9quitable et acceptable ! \r\n\r\nVous \u00eates en mesure de payer un peu plus pour le billet? Vous permettez de la sorte que d'autres paient un peu moins. Merci de contribuer \u00e0 un acc\u00e8s \u00e0 la culture pour tou.te.s!\r\n\r\nPREVENTE : en r\u00e9servant et payant vos places \u00e0 l'avance, vous \u00e9vitez le suppl\u00e9ment de 2\u20ac pour les achats le soir-m\u00eame.\r\n\r\nVous \u00eates \u00e9tudiant.es en Arts du spectacle ou b\u00e9n\u00e9ficiaire des tickets Article 27? Ces tarifs restent valables!\r\n\r\n___________\r\nHORAIRES\r\nmercredi 07\/02 - 19h00\r\njeudi 08\/02 - 20h30\r\nvendredi 09\/02 - 20h30\r\nlundi 12\/02 - 20h30\r\nmercredi 14\/02 - 19h00\r\njeudi 15\/02 - 20h30\r\nvendredi 16\/02 - 20h30\r\nmercredi 21\/02- 19h00\r\njeudi 22\/02 - 20h30\r\nvendredi 23\/02 - 20h30","performers":"Coline Fouquet : jeu, mise-en-sc\u00e8ne, dramaturgie - Laetitia Ajanohun : collaboratrice \u00e0 la dramaturgie et \u00e0 la mise en sc\u00e8ne - Yoris Van den Houte : collaborateur \u00e0 la dramaturgie et sc\u00e9nographe - Sean Hart : vid\u00e9aste - Composition sonore : en cours\r\n","boxoffice_url":null,"website":"http:\/\/www.lesrichesclaires.be","email":null,"phone_contact":null,"phone_booking":"+32 2 548 25 80","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.561004"},"sp":{"name":"Les trois Maria","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lesrichesclaires.be","email":null,"phone_contact":null,"phone_booking":"+32 2 548 25 80","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.561004"},"nl":{"name":"Les trois Maria","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lesrichesclaires.be","email":null,"phone_contact":null,"phone_booking":"+32 2 548 25 80","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.561004"}},"place":{"id":1085,"translations":{"de":{"name":"Les Riches-Claires","address_street_name":"Rue des Riches Claires","address_street_number":"24","address_street_box":null,"email":"accueil@lesrichesclaires.be","website":"http:\/\/www.lesrichesclaires.be","phone_contact":"+32 2 548 25 80","phone_booking":"+32 2 548 25 80","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Riches Claires, 24","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Les Riches-Claires","address_street_name":"Rue des Riches Claires","address_s