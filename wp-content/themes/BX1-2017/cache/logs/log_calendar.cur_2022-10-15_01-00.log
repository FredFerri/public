rachtige fresco\u2019s die de Belgische stripverhalen eren en ontdek het stadscentrum op een originele manier.\r\nOm deel te nemen, moet u geen getrainde sportieveling zijn.  Ook geschikt voor \"start to runners\".\r\nWaar mogelijk kan de route volgens uw wensen aangepast worden.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.514635"},"en":{"name":"City Run Comics art","shortdescr":"Discover the comic strip while jogging at your ease!","longdescr":"Belgium is famous for chocolate, beer, but also\u2026 comics art!\r\nJoin us on a 9 km tour to discover magnificent murals that honor Belgium\u2019s comics art and explore the city center in a new way.\r\nYou do not have to be a great athlete to participate: this run is accessible for \u00ab start to runners \u00bb as well.\r\nThe route may be adapted to your wishes.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.514635"},"de":{"name":"City Run Bande Dessin\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.514635"},"it":{"name":"City Run Bande Dessin\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.514635"},"sp":{"name":"City Run Bande Dessin\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.514635"},"pt":{"name":"City Run Bande 