is_not_major_event":false,"backoffice_id":308084,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"sport","ranking":0.15021939019982186,"languages":{"spoken":["fr","en","nl"],"subtitles":[]},"categories":{"main":{"id":74,"translations":{"de":"Sport","pt":null,"en":"Sport","it":"Sport","cn":null,"fr":"Sport","sp":"Deporte","nl":"Sport"}},"others":{"list":[164,159],"translations":{"de":["Fitness, Gymnastik, Tanz & Kampfsportarten","Sportliche Aktivit\u00e4t"],"pt":[null,null],"en":["Fitness, gymnastics, dance and combat sports","Sporting activity"],"it":["Fitness, ginnastica, danza e sport da combattimento","Attivit\u00e0 sportive"],"cn":[null,null],"fr":["Fitness, gymnastique, danse et sports de combats","Activit\u00e9 sportive"],"sp":["Fitnes, gimnasia, danza y deportes de combate","Actividad deportiva"],"nl":["Fitness, gymnastiek, dans en vechtsport","Sportieve activiteit"]}}},"translations":{"de":{"name":"Shinkendo - Japanese swordfighting","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.facebook.com\/shinkendobelgium\/","email":"shinkendo.be.brussels@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700001529"},"pt":{"name":"Shinkendo - Japanese swordfighting","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.facebook.com\/shinkendobelgium\/","email":"shinkendo.be.brussels@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700001529"},"en":{"name":"Shinkendo - Japanese Swordfighting","shortdescr":"Shinkendo, or \"Way of the Real Sword\", teaches you to use the katana, the curved single-edged Japanese sword. We teach how to move the body and sword efficiently, draw the sword, combine individual techniques for different purposes, spar with a partner, and cut real targets with a katana. Attention is also paid to the philosophy of the samurai.","longdescr":"Shinkendo, or \u201cWay of the Real Sword\u201d, is a practical and comprehensive study of all important aspects of Japanese swordsmanship, devised by Mr. Obata Toshishiro as a synthesis of the strong points of several traditional and modern sword arts. Through physical and mental practice, students learn how to wield the Japanese single-edged curved sword commonly known as the katana.\nAs a branch of Shinkendo Belgium and the International Shinkendo Federation, we emphasize safe practice at all times while students learn to use wooden, blunt and eventually sharp swords as their skill increases. You will learn how to effectively move the body and the sword, how to draw the sword, how to combine individual techniques for different purposes, how to practice with a partner, and how to test techniques by cutting real targets. At the same time you will learn about Japanese culture and etiquette, and how to apply the teachings and philosophy of the ancient samurai to improve your daily life.\n","performers":null,"boxoffice_url":null,"website":"https:\/\/www.facebook.com\/shinkendobelgium\/","email":"shinkendo.be.brussels@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700001529"},"it":{"name":"Shinkendo - Japanese swordfighting","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.facebook.com\/shinkendobelgium\/","email":"shinkendo.be.brussels@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700001529"},"cn":{"name":"Shinkendo - Japanese swordfighting","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.facebook.com\/shinkendobelgium\/","email":"shinkendo.be.brussels@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700001529"},"fr":{"name":"Shinkendo - Combat de Sabre Japonais","shortdescr":"Le Shinkendo, ou \u00ab Voie du Vrai Sabre \u00bb, vous apprend \u00e0 utiliser le katana, le sabre japonais courb\u00e9 \u00e0 un seul tranchant. Nous enseignons \u00e0 d\u00e9placer efficacement le corps et le sabre, \u00e0 d\u00e9gainer le sabre, \u00e0 combiner des techniques individuelles \u00e0 des fins diff\u00e9rentes, \u00e0 s\u2019entra\u00eener avec un partenaire et \u00e0 tailler de vraies cibles avec un katana. Nous examinons aussi \u00e0 la philosophie des samoura\u00efs.","longdescr":"Shinkendo, ou \"Voie du Vrai Sabre\", est une \u00e9tude pratique et compl\u00e8te de tous les aspects importants de l'art du sabre japonais, \u00e9labor\u00e9e par M. Obata Toshishiro comme une synth\u00e8se des points forts de plusieurs arts du sabre traditionnels et modernes. \u00c0 travers la pratique physique et mentale, les \u00e9l\u00e8ves apprennent \u00e0 manier le sabre courb\u00e9 japonais \u00e0 simple tranchant commun\u00e9ment appel\u00e9 le katana. \n\nEn tant que branche de Shinkendo Belgium et de la F\u00e9d\u00e9ration Internationale de Shinkendo, nous mettons l'accent sur une pratique s\u00fbre en tout temps tandis que les \u00e9l\u00e8ves apprennent \u00e0 utiliser des \u00e9p\u00e9es en bois, \u00e9mouss\u00e9es et finalement tranchantes \u00e0 mesure que leurs comp\u00e9tences s'am\u00e9liorent. Vous apprendrez comment d\u00e9placer efficacement le corps et le sabre, comment d\u00e9gainer le sabre, comment combiner des techniques individuelles \u00e0 des fins diff\u00e9rentes, comment pratiquer avec un partenaire, et comment tester des techniques en coupant de vraies cibles. En m\u00eame temps, vous en apprendrez davantage sur la culture et l'\u00e9tiquette japonaises, et sur la mani\u00e8re d'appliquer les enseignements et la philosophie des anciens samoura\u00efs pour am\u00e9liorer votre vie quotidienne.\n","performers":null,"boxoffice_url":null,"website":"https:\/\/www.facebook.com\/shinkendobelgium\/","email":"shinkendo.be.brussels@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700001529"},"sp":{"name":"Shinkendo - Japanese swordfighting","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.facebook.com\/shinkendobelgium\/","email":"shinkendo.be.brussels@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700001529"},"nl":{"name":"Shinkendo - Japans Zwaardvechten","shortdescr":"Shinkendo, of \"Weg van het Echte Zwaard\", leert u de katana te hanteren, het gekromde enkelzijdige Japanse zwaard. Wij leren hoe het lichaam en zwaard effici\u00ebnt te bewegen, het zwaard te trekken, individuele technieken te combineren voor verschillende doeleinden, met een partner te sparren, en met een katana echte doelen te snijden. Er is ook aandacht voor de filosofie van de samurai.\n","longdescr":"Shinkendo, of \"Weg van het Echte Zwaard\", is een praktische en uitgebreide studie van alle belangrijke aspecten van de Japanse zwaardvechtkunst, ontwikkeld door de Mr. Obata Toshishiro als een synthese van de sterke punten van verschillende traditionele en moderne zwaardvechtkunsten. Door fysieke en mentale oefening leren studenten het gekromde enkelzijdige Japanse zwaard, algemeen bekend als de katana, te hanteren. \nAls tak van Shinkendo Belgium en de International Shinkendo Federation leggen we altijd de nadruk op veilige praktijk, terwijl studenten leren omgaan met houten, botte en uiteindelijk scherpe zwaarden naarmate hun vaardigheden verbeteren. U zult leren hoe u effectief uw lichaam en zwaard beweegt, hoe u het zwaard trekt, hoe u individuele technieken combineert voor verschillende doeleinden, hoe u met een partner oefent, en hoe u technieken kunt testen door echte doelen te snijden. Tegelijkertijd leert u meer over de Japanse cultuur en etiquette, en hoe u de lessen en filosofie van de oude samoerai kunt toepassen om uw dagelijks leven te verbeteren.\n","performers":"Sam De Craemer (Instructor - Dojoleider)","boxoffice_url":null,"website":"https:\/\/www.facebook.com\/shinkendobelgium\/","email":"shinkendo.be.brussels@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700001529"}},"place":{"id":251294,"translations":{"de":{"name":"Hall des Sports E. Hiel","address_street_name":"Dr. des Fr\u00e9sias","address_street_number":"7","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Dr. des Fr\u00e9sias, 7","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Hall des Sports E. Hiel","address_street_name":"Dr. des Fr\u00e9sias","address_street_number":"7","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Dr. des Fr\u00e9sias, 7","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Hall des Sports E. Hiel","address_street_name":"Dr. des Fr\u00e9sias","address_street_number":"7","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1030","address_city":"Schaerbeek","address_line1":"Dr. des Fr\u00e9sias, 7","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Hall des Sports E. Hiel","address_street_name":"Dr. des Fr\u00e9sias","address_street_number":"7","address_street