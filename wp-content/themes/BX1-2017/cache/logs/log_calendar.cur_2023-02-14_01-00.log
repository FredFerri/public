t":[],"translations":{}},"tags":[],"accessibilities":{"list":[266],"translations":{"fr":["Brussels Health Safety Label"],"nl":["Brussels Health Safety Label"],"en":["Brussels Health Safety Label"],"de":["Brussels Health Safety Label"],"it":["Brussels Health Safety Label"],"sp":["Brussels Health Safety Label"],"pt":[null],"cn":[null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2023-02-13T02:07:29+01:00","published_at":"2022-04-07T14:02:59+02:00","backoffice_id":251124,"import_origin":null,"sub_type":"other","show_in_agenda":true,"ranking":0.096961157376676},{"id":547517,"date_start":"2023-02-15","date_end":"2023-02-15","date_next":"2023-02-15","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater","it":"Teatro","sp":"Teatro","pt":null,"cn":null}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"],"de":["Theater"],"it":["Teatro"],"sp":["Teatro"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Ainsi chantait l'olivier","shortdescr":null,"longdescr":"Dans un pays dont nous ne savons rien, des populations civiles sont prises sous le feu des bombes. Un groupe d\u2019anonymes tente sa chance dans la travers\u00e9e de la M\u00e9diterran\u00e9e jusqu\u2019\u00e0 leur arriv\u00e9e dans une Europe hostile et inhospitali\u00e8re. Le parcours est sem\u00e9 d\u2019emb\u00fbches. L\u2019un d\u2019eux souhaite atteindre l\u2019Angleterre mais, se sentant incapable de franchir la Manche, il va alors prendre la route vers Bruxelles. Progressivement, il se pr\u00e9sente \u00e0 nous. Il s\u2019appelle Saad, il est syrien et chanteur. \u00c0 Bruxelles, une rencontre amoureuse va illuminer son chemin et une seconde rencontre va lui permettre de fonder un groupe de musique et de transformer ses traumatismes en cr\u00e9ations. Mais la vie est fragile, surtout pour un migrant\u2026","performers":"Coordination, \u00e9criture, mise en sc\u00e8ne et interpr\u00e9tation : Rachid Benbouchta\r\nRap et slam : Manza (CNN199)\r\nVioloncelle : L\u00e9a Besan\u00e7on\r\nMusique : DJ Keso\r\nDanse : Greg Lox\r\nPercussions : Nejib Farjallah\r\nOud : Tarek Alsayed\r\nSon : Antoine Thonon\r\nSc\u00e9nographie et cr\u00e9ation lumi\u00e8re : Thibault Sinay","boxoffice_url":null,"website":"http:\/\/www.senghor.be","email":"info@senghor.be","phone_contact":null,"phone_booking":"+32 2 230 31 40","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.547517"},"nl":{"name":"Ainsi chantait l'olivier","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.senghor.be","email":"info@senghor.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.547517"},"en":{"name":"Ainsi chantait l'olivier","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.senghor.be","email":"info@senghor.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.547517"},"de":{"name":"Ainsi chantait l'olivier","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.senghor.be","email":"info@senghor.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.547517"},"it":{"name":"Ainsi chantait l'olivier","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.senghor.be","email":"info@senghor.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brus