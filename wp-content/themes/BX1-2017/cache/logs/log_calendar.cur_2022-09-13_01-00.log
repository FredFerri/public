w.youtube.com\/","oEmbed_thumbnail_height":360,"oEmbed_thumbnail_width":480,"oEmbed_thumbnail_url":"https:\/\/i.ytimg.com\/vi\/x_su1tM682s\/hqdefault.jpg","oEmbed_html":"<iframe width=\"356\" height=\"200\" src=\"https:\/\/www.youtube.com\/embed\/x_su1tM682s?feature=oembed\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\" allowfullscreen><\/iframe>","translations":{"fr":{"title":"D\u00e9couverte de l'aquaponie par AquaponieBxl"},"nl":{"title":"D\u00e9couverte de l'aquaponie par AquaponieBxl"},"en":{"title":"D\u00e9couverte de l'aquaponie par AquaponieBxl"}}},{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/d6baae223e3c07c9891fae4258ca480a93e409fc.jpg","width":1439,"height":1589,"ratio":0.91,"translations":{"fr":{"title":"Initiation \u00e0 l'aquaponie","copyright":"AquaponieBxl Laurence Vanneyre"},"nl":{"title":"Initiation \u00e0 l'aquaponie","copyright":"AquaponieBxl Laurence Vanneyre"},"en":{"title":"Initiation \u00e0 l'aquaponie","copyright":"AquaponieBxl Laurence Vanneyre"}}},{"type":"poster","link":"https:\/\/agendabrussels.imgix.net\/5da5378536c1d39ab3fb5a99788b0e122e982ab8.jpg","width":1280,"height":720,"ratio":1.78,"translations":{"fr":{"title":"Initiation \u00e0 l'aquaponie","copyright":null},"nl":{"title":"Initiation \u00e0 l'aquaponie","copyright":null},"en":{"title":"Initiation \u00e0 l'aquaponie","copyright":null}}}],"dates":[{"day":"2021-11-16","doors":null,"start":"10:00:00","end":"12:00:00","is_soldout":false,"is_canceled":false},{"day":"2021-11-19","doors":null,"start":"12:00:00","end":"14:00:00","is_soldout":false,"is_canceled":false},{"day":"2021-11-29","doors":null,"start":"10:00:00","end":"12:00:00","is_soldout":false,"is_canceled":false},{"day":"2021-12-02","doors":null,"start":"13:30:00","end":"15:30:00","is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":40},{"translations":{"fr":{"name":"Enfants"},"nl":{"name":"Kinderen"},"en":{"name":"Children"}},"value":0}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[1,2,3,4,5,6,7,8,9],"translations":{"fr":["Maternel","Primaire","Secondaire","6 - 8 ans","8 - 10 ans","10 - 12 ans","12 - 14 ans","14 - 16 ans","16 - 18 ans"],"nl":["Kleuteronderwijs","Lagere school","Secundair onderwijs","6 - 8 jaar","8 - 10 jaar","10 - 12 jaar","12 - 14 jaar","14 - 16 jaar","16 - 18 jaar"],"en":["Kindergarden","Primary school","Secondary school","6 - 8 years","8 - 10 years","10 - 12 years","12 - 14 years","14 - 16 years","16 - 18 years"]}},"tags":["exterior"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-08-10T17:35:52+02:00","published_at":"2021-11-08T11:43:11+01:00","backoffice_id":242403,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.13992727562026},{"id":518574,"date_start":"2021-11-20","date_end":"2022-11-12","date_next":"2022-11-12","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{"list":[105],"translations":{"fr":["Gastronomie"],"nl":["Gastronomie"],"en":["Gastronomy"]}}},"languages":{"spoken":["fr","en"],"subtitles":[]},"translations":{"fr":{"name":"DISCOVER & TASTE Coffee Tour - Uptown StGilles","shortdescr":"Be ready to discover and taste the new waves of coffee during this 4 hours tour in the Downtown Kanaal Brussels area. Hosted in FR & EN.","longdescr":"LES COFFEE TOURS\r\nLe caf\u00e9 de sp\u00e9cialit\u00e9 est en plein d\u00e9veloppement \u00e0 Bruxelles, avec l'\u00e9mergence de nouveaux caf\u00e9s et d'initiatives comme la Brussels Coffee Week, mais aussi gr\u00e2ce \u00e0 l\u2019impl\u00e9mentation de grains de qualit\u00e9 dans de plus en plus de lieux HoReCa, \u00e9piceries etc. Le caf\u00e9 de sp\u00e9cialit\u00e9 reste malgr\u00e9 tout encore bien trop m\u00e9connu, il est temps d'explorer ce que la capitale de l'Europe a \u00e0 offrir.\r\n\r\nCes explorations caf\u00e9\u00efn\u00e9es de la ville sont aussi inhabituelles, amusantes qu\u2019instructives et correspondent \u00e0 un cours de base complet sur le caf\u00e9, le fun et la marche en plus.\r\n\r\n\r\nPOUR QUI\r\nLes Brussels Coffee Tours s'adressent \u00e0 tout le monde, avec un focus sur l\u2019exp\u00e9rience consommateur\/coffee lovers d\u00e9sireu.x.ses de mieux comprendre leur boisson favorite.\r\n\r\nIl convient \u00e9galement aux professionnel.le.s de l\u2019HoReCa qui encore souvent ignorent ce qu\u2019est le caf\u00e9 de sp\u00e9cialit\u00e9, les aidant ainsi \u00e0 comprendre le parent pauvre de leur secteur mais aussi \u00e0 mieux appr\u00e9hender l\u2019exp\u00e9rience client li\u00e9e au caf\u00e9.\r\n\r\nJe suis l\u00e0 pour aider et esp\u00e8re combler le foss\u00e9 entre les amateurs et les professionnels. Aucun pr\u00e9requis n'est n\u00e9cessaire \u00e0 ce tour.\r\n\r\nLes buveuses et buveurs de th\u00e9 appr\u00e9cient grandement ce tour, m\u00eame quand ils pensent ne pas aimer le caf\u00e9 ;)\r\n\r\n\r\nOBJECTIF\r\nLe but des Brussels Coffee Tours est de faire d\u00e9couvrir les lieux innovants lorsqu\u2019il est question de caf\u00e9 de sp\u00e9cialit\u00e9, mais aussi de d\u00e9couvrir et comprendre comment consommer \/ go\u00fbter le caf\u00e9 sur base de crit\u00e8res de qualit\u00e9 objectifs.\r\n\r\nComprendre la cha\u00eene de production du champ \u00e0 la tasse, la diff\u00e9rence entre caf\u00e9 de sp\u00e9cialit\u00e9 et caf\u00e9 de commodit\u00e9 et apprendre \u00e0 mieux acheter son caf\u00e9 sont \u00e9galement au c\u0153ur des objectifs des Coffee Tours.\r\nDISCOVER & TASTE, UN TOUR P\u00c9DAGOGIQUE ! - EDITION UPTOWN ST GILLES\r\nLors des Brussels Coffee Tours - Discover and Taste - , nous d\u00e9ambulons dans diff\u00e9rents quartiers de Bruxelles, en fonction de l\u2019\u00e9dition, car voyager autour du caf\u00e9 de sp\u00e9cialit\u00e9 est toujours une excellente id\u00e9e pour d\u00e9couvrir les tendances locales.\r\nNous stimulerons vos papilles en go\u00fbtant un espresso, une boisson lact\u00e9e, mais aussi des m\u00e9thodes filtre et parfois m\u00eame des infusions \u00e0 froid, azot\u00e9es ou non, le tout \u00e0 mes frais. Vous ne payez pas d'extra pour vos boissons.\r\nLors de cette \u00e9dition UPTOWN ST GILLES, nous visitons 4 \u00e0 5 lieux dans le bas et le haut de Saint Gilles, comprenant un espace de coworking servant du caf\u00e9 de sp\u00e9cialit\u00e9, des coffee bars de sp\u00e9cialit\u00e9 au top, certains proposant des p\u00e2tisseries locales ou des plats v\u00e9g\u00e9taliens, et une mini-d\u00e9gustation de cold brew.\r\nNous vous sensibiliserons aux m\u00e9tiers du caf\u00e9 et aborderons diff\u00e9rents sujets tels que : les diff\u00e9rences de philosophies et les nouvelles vagues, les m\u00e9thodes de pr\u00e9paration, les habitudes de consommation, le m\u00e9tier de barista, la science derri\u00e8re le lait, le sucre, le go\u00fbt, la qualit\u00e9, le caf\u00e9 de sp\u00e9cialit\u00e9, les labels, les styles de torr\u00e9faction, les recettes etc\u2026 mais aussi les informations \u00e0 d\u00e9crypter sur les sachets de caf\u00e9 afin de mieux acheter et d\u00e9jouer le marketing global.\r\nGOOD TO KNOW\r\nLes tours se passent toujours en ext\u00e9rieur.\r\n\r\nNous marchons d'un endroit \u00e0 l'autre et jetons un \u0153il aux lieux, mais les groupes \u00e9tant grands par rapport \u00e0 la capacit\u00e9 des lieux, nous ne consommons pas assis \u00e0 l\u2019int\u00e9rieur.\r\n\r\nIl est pr\u00e9f\u00e9rable de se munir de chaussures confortables, de v\u00eatements CHAUDS en hiver (mieux vaut trop de couches que pas assez !!) et un parapluie en cas de pluie. De l\u2019eau est toujours recommand\u00e9e \u00e9galement. Masque et gel en temps de Covid.\r\n\r\nPetit d\u00e9jeunez avant la visite car nous n'avons pas le temps de manger lors des tours.\r\nPssst, rejoins-nous : INSTA @ok_coffee_tips\r\n\r\nVOTRE GUIDE\r\n\r\nThomas Wyngaard est fondateur de OK Coffee et un des rares experts en Caf\u00e9 de Sp\u00e9cialit\u00e9 en Belgique francophone. Il est consultant ind\u00e9pendant, enseignant (certifi\u00e9 par la Specialty Coffee Association de janvier 2018 \u00e0 avril 2021), tour-ist et broadcaster. Apr\u00e8s avoir \u00e9t\u00e9 form\u00e9 en France, en Pologne et en Estonie, il fait ses armes chez les meilleurs en Belgique, pour ensuite migrer pendant presque 2 ans \u00e0 New York o\u00f9 il a offici\u00e9 comme conseiller et formateur. Au-del\u00e0 de la formation sur les m\u00e9tiers du caf\u00e9, il collabore avec des torr\u00e9facteurs belges engag\u00e9s sur la reconnaissance du caf\u00e9 de sp\u00e9cialit\u00e9, \u0153uvrant ainsi \u00e0 un monde meilleur \u201cone bean at a time\u201d.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.okcoffee.tips","email":"thomas@okcoffee.tips","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.518574"},"nl":{"name":"DISCOVER & TASTE Coffee Tour - Uptown StGilles","shortdescr":"Be ready to discover and taste the new waves of coffee during this 4 hours tour in the Downtown Kanaal Brussels area. Hosted in FR & EN.","longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.518574"},"en":{"name":"DISCOVER & TASTE Coffee Tour - Uptown StGilles","shortdescr":"Be ready to discover and taste the new waves of coffee during this 4 hours tour in the Downtown Kanaal Brussels area. Hosted in FR & EN.","longdescr":"THE COFFEE TOURS\r\nSpecialty coffee is booming in Brussels, with the emergence of new coffee shops and initiatives like the Brussels Coffee Week, but also thanks to the implementation of quality beans in more and more HoReCa places, grocery stores etc. However, specialty coffee is still far too unknown. Now is the time to explore what the capital city of Europe has to offer.\r\n\r\nThese caffeinated explorations of the city, and also the methods of preparation are unusual, fun as they are highly informative, and match a complete coffee basics course, with an extra sprinkle of fun and walking.\r\n\r\n\r\nFOR WHO\r\nThe Brussels Coffee Tours are for everyone, with a focus on the consumer\/coffee lover experience to better understand your favorite beverage!\r\n\r\nIt is also suitable for HoReCa professionals who are often still unaware of what specialty coffee is, helping them to understand the poor relation of their sector but also to better understand the customer experience related to coffee.\r\n\r\nI'm here to help and hope to bridge the gap between the amateurs and the professionals. No prerequisites are necessary for this tour.\r\nTea drinkers greatly appreciate this tour, even when they think they don't like coffee ;)\r\n\r\nOBJECTIVE\r\nThe goal of the Brussels Coffee Tours is to discover innovative places when it comes to specialty coffee, but also to discover and understand how to consume\/taste coffee based on objective quality criteria.\r\nUnderstanding the production chain from field to cup, the difference between specialty and commodity coffee, and learning how to better buy coffee are also central to the objectives of the Coffee Tours.\r\nDISCOVER & TASTE, AN EDUCATIONAL TOUR! - UPTOWN ST GILLES, EDITION\r\nDuring the Brussels Coffee Tours - Discover and Taste - , we wander through different areas of Brussels, depending on the edition, because traveling around specialty coffee is always a great idea to discover local trends.\r\nWe will stimulate your taste buds by tasting espresso, milk drink, but also filter methods and sometimes even cold brew, nitrogen infused or not, all at my expense. You don't pay any extra for your drinks.\r\nDuring this UPTOWN ST GILLES edition, we visit 4 to 5 places in the lower and upper parts of Saint Gilles, including a coworking space serving specialty coffee, amazing specialty caf\u00e9s, some of them serving local pastries or vegan dishes and a cold brew mini tasting.\r\nWe will make you aware of the different coffee professions and discuss various topics such as: the differences in philosophies and the new waves, preparation methods, consumption habits, the barista's job, the science behind milk, sugar, taste, quality, specialty coffee, labels, roasting styles, recipes etc... but also the information to decipher on the coffee bags in order to buy better and thwart global marketing.\r\nGOOD TO KNOW\r\nThe tours always take place outdoors.\r\n\r\nWe walk from one place to another and have a look at the places, but the groups being large compared to the capacity of the places, we do not consume sitting inside.\r\n\r\nIt is best to bring comfortable shoes, WARM clothes in winter (better too many layers than not enough!!) and an umbrella in case of rain. Water is always recommended as well. Mask and gel in Covid times.\r\n\r\nHave breakfast beforehand because we don't have time to eat during the tours.\r\nPssst, join us: INSTA @ok_coffee_tips\r\n\r\n\r\nYOUR HOST \r\n\r\nThomas Wyngaard is the founder of OK Coffee and one of the few Specialty Coffee experts in French-speaking Belgium. He is an independent consultant, teacher (certified by the Specialty Coffee Association from January 2018 to April 2021), tour-ist and broadcaster. After training in France, Poland and Estonia, he worked with the best in Belgium, and then migrated for almost 2 years to New York where he served as a consultant and trainer. In addition to training in the coffee business, he collaborates with Belgian roasters committed to the recognition of specialty coffee, working towards a better world \"one bean at a time\".","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.518574"},"de":{"name":"DISCOVER & TASTE Coffee Tour - Uptown StGilles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.518574"},"it":{"name":"DISCOVER & TASTE Coffee Tour - Uptown StGilles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.518574"},"sp":{"name":"DISCOVER & TASTE Coffee Tour - Uptown StGilles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.518574"},"pt":{"name":"DISCOVER & TASTE Coffee Tour - Uptown StGilles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.518574"},"cn":{"name":"DISCOVER & TASTE Coffee Tour - Uptown StGilles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.518574"}},"place":{"id":234330,"translations":{"fr":{"name":"Divers lieux \u00e0 Saint-Gilles","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"addr