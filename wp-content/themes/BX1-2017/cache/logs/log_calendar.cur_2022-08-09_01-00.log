false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":118,"translations":{"fr":"Festival","nl":"Festival","en":"Festival"}},"others":{"list":[120],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Festival Th\u00e9\u00e2tres Nomades","shortdescr":"Th\u00e9\u00e2tres Nomades, festival des arts de la rue et de th\u00e9\u00e2tre, s\u2019implante chaque \u00e9t\u00e9 pendant 4 jours dans un espace vert bruxellois.","longdescr":"Le Festival Th\u00e9\u00e2tres Nomades, festival des arts de la rue, s\u2019implante chaque \u00e9t\u00e9 pendant 4 jours dans un espace vert et libre d\u2019acc\u00e8s de la capitale belge. Depuis sa cr\u00e9ation, il n\u2019a eu de cesse de se r\u00e9inventer mais conserve une identit\u00e9 qui lui est propre. Le caract\u00e8re nomade, la programmation engag\u00e9e, la d\u00e9marche durable et l\u2019accessibilit\u00e9 sont au c\u0153ur de son ADN et de son succ\u00e8s.\r\n\r\nA l\u2019instar de tous les \u00e9v\u00e9nements organis\u00e9s par la Compagnie des Nouveaux Disparus, ce festival \u0153uvre pour la d\u00e9mocratie culturelle et rassemble chaque ann\u00e9e un public toujours plus large, originaire de Bruxelles et d\u2019ailleurs, aux horizons socio-culturels divers.\r\n\r\nLe festival se veut \u00e9clectique et ouvert sur le monde, de mani\u00e8re \u00e0 g\u00e9n\u00e9rer surprise et curiosit\u00e9. Il r\u00e9unit chaque ann\u00e9e plus de 35 compagnies de domaines artistiques divers : th\u00e9\u00e2tre, cirque, conte, th\u00e9\u00e2tre d\u2019objet, danse, marionnettes, etc. La programmation fait, avant toute chose, la part belle \u00e0 la cr\u00e9ation belge, et notamment aux jeunes artistes, tout en ayant \u00e0 c\u0153ur d\u2019inviter quelques compagnies internationales \u00e9galement.\r\n\r\nNous veillons \u00e0 ce que plus d\u2019un tiers des spectacles soient sans parole, pour attirer des festivaliers ne maitrisant pas le fran\u00e7ais. Et pour soutenir l\u2019accessibilit\u00e9 des familles, nous proposons des spectacles destin\u00e9s au jeune public sp\u00e9cifiquement, au tout public et des animations pour les plus petit\u00b7es.\r\n\r\nEnfin, le Festival s\u2019inscrit depuis de nombreuses ann\u00e9es dans une d\u00e9marche \u00e9co-responsable et durable, et a d\u2019ailleurs \u00e9t\u00e9 pr\u00e9curseur en la mati\u00e8re. Au-del\u00e0 des actions concr\u00e8tes (alimentation locale, de saison et bio si possible ; toilettes s\u00e8ches ; \u00e9clairage LED ; vaisselles r\u00e9utilisables pour le catering ; conteneurs de tri des d\u00e9chets ; etc.), l\u2019\u00e9quipe organisatrice fait en sorte de rendre ses d\u00e9marches accessibles et populaires, dans l\u2019id\u00e9e que chacun\u00b7e en devienne partie prenante.\r\n\r\nPour \u00eatre tenus au courant d\u00e8s derni\u00e8res actus, suivez-nous sur Facebook (https:\/\/www.facebook.com\/events\/2225282487620459) et Instagram (https:\/\/www.instagram.com\/theatresnomades\/) !","performers":null,"boxoffice_url":null,"website":"https:\/\/festivaltheatresnomades.be\/","email":"info@lesnouveauxdisparus.com","phone_contact":"+32 2 219 11 98","phone_booking":"+32 2 219 11 98","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/535927.html"},"nl":{"name":"Festival Th\u00e9\u00e2tres Nomades","shortdescr":"Th\u00e9\u00e2tres Nomades, het straatkunsten- en theaterfestival, vindt elke zomer gedurende vier dagen plaats in een groene ruimte in Brussel.","longdescr":"Th\u00e9\u00e2tres Nomades, het straatkunsten- en theaterfestival, vindt elke zomer gedurende vier dagen plaats in een groene ruimte in Brussel. \r\n\r\nBlijf op de hoogte van de laatste nieuwsjes en volg ons op Facebook (https:\/\/www.facebook.com\/events\/2225282487620459) en Instagram (https:\/\/www.instagram.com\/theatresnomades\/)!","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/535927.html"},"en":{"name":"Festival Th\u00e9\u00e2tres Nomades","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/535927.html"},"de":{"name":"Festival Th\u00e9\u00e2tres Nomades","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/535927.html"},"it":{"name":"Festival Th\u00e9\u00e2tres Nomades","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/535927.html"},"sp":{"name":"Festival Th\u00e9\u00e2tres Nomades","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/535927.html"},"pt":{"name":"Festival Th\u00e9\u00e2tres Nomades","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/535927.html"},"cn":{"name":"Festival Th\u00e9\u00e2tres Nomades","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/535927.html"}},"place":{"id":241130,"translations":{"fr":{"name":"Bois de la Cambre: Carrefour des Attelages","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address