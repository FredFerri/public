:"Normal"},"cn":{"name":"Normal"}},"value":4}],"child_events":[],"parent_events":[],"targets":{"list":[19],"translations":{"fr":["Enseignants"],"nl":["Leerkrachten"],"en":["Teachers"],"de":["Lehrkr\u00e4fte"],"it":["Insegnanti"],"sp":["Profesores"],"pt":[null],"cn":[null]}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-04-23T03:05:48+02:00","published_at":"2023-01-03T10:18:48+01:00","backoffice_id":268325,"import_origin":null,"sub_type":"sport","show_in_agenda":true,"ranking":0.15267381577002},{"id":548330,"date_start":"2022-09-17","date_end":"2023-06-24","date_next":"2023-05-06","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":true,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":74,"translations":{"fr":"Sport","nl":"Sport","en":"Sport","de":"Sport","it":"Sport","sp":"Deporte","pt":null,"cn":null}},"others":{"list":[159,163],"translations":{"fr":["Activit\u00e9 sportive","Natation et sports nautiques"],"nl":["Sportieve activiteit","Zwemmen en watersport"],"en":["Sporting activity","Swimming and water sports"],"de":["Sportliche Aktivit\u00e4t","Schwimmen & Wassersport"],"it":["Attivit\u00e0 sportive","Nuoto e sport acquatici"],"sp":["Actividad deportiva","Nataci\u00f3n y deportes acu\u00e1ticos"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Aquagym Uccle","shortdescr":"L'aquagym favorise un d\u00e9veloppement harmonieux de tous les muscles du corps, soulage les douleurs de la colonne lombaire, corrige la statique et les tassements vert\u00e9braux. De plus, l'aquagym est pratiqu\u00e9e en eaux peu profondes, il n'est donc pas n\u00e9cessaire de savoir nager pour profiter de ses bienfaits.","longdescr":"INSCRIPTION \r\n> Le cours se paie :\r\n- Soit 4\u20ac \u00e0 la s\u00e9ance directement au moniteur (hors entr\u00e9e de piscine);\r\n- Soit avec une carte de 10 s\u00e9ances, valable 4 mois \u00e0 dater de la premi\u00e8re s\u00e9ance\r\neffective et jusqu\u2019en juin 2023, co\u00fbtant 32 \u20ac (soit 10 s\u00e9ances pour le prix de 8 s\u00e9ances), qui se commande jusqu\u2019au 24 f\u00e9vrier 2023 (une carte par cours) ;\r\n- Soit avec un abonnement valable de septembre \u00e0 juin, co\u00fbtant 90 \u20ac (soit 36 s\u00e9ances\r\npour le prix de 22 s\u00e9ances), qui s\u2019ach\u00e8te jusqu\u2019au 9 octobre 2022 (un abonnement\r\npar cours).\r\n\r\n> Comment proc\u00e9der ?\r\n- Par e-mail : loisirs.sante@solidaris.be \r\n- Par courrier : rue des Moineaux 17-19, 1000 Bruxelles \r\n\r\nEn mentionnant: nom \/ pr\u00e9nom \/ adresse \/ date de naissance \/ Gsm \/ le(s) cours choisi(s) (commune et horaire) \/ n\u00b0 de membre Loisirs et Sant\u00e9 ou n\u00b0 de mutuelle. \r\nD\u00e8s que vous avez fait votre demande pour une carte de 10 s\u00e9ances ou un abonnement, vous pouvez effectuer le paiement sur le compte de Loisirs et Sant\u00e9 asbl (BE 22 3101 3243 0247) avec en communication libre : votre n\u00b0 de membre, le cours suivi, et la commune. \r\nPr\u00e9sentez votre preuve de paiement au professeur de sport, sinon le tarif \u00e0 la s\u00e9ance vous sera demand\u00e9 et ne sera pas remboursable. L\u2019abonnement ou la carte est envoy\u00e9(e) au moniteur.\r\n\r\n> D\u00e9but et fin des cours\r\nLa saison 2022-2023 reprendra le 12 septembre 2022 et se termine le 30 juin 2023. Les cours ont lieu tous les samedis  sauf pendant les cong\u00e9s scolaires.\r\n\r\n> Remarque\r\nPour la bonne marche des cours, ceux-ci sont strictement r\u00e9serv\u00e9s aux adultes en \u00e2ge d\u2019exercer une activit\u00e9 professionnelle et sont mixtes. \r\n> L'affiliation\r\nL'affiliation peut \u00eatre demand\u00e9e par toute personne en \u00e2ge d'exercer une activit\u00e9 professionnelle.\r\nLa cotisation pour l'affiliation \u00e0 l'asbl Loisirs & Sant\u00e9 est de 50 \u20ac par an (septembre\/juin). Les membres de Solidaris Brabant qui s'affilient \u00e0 l'asbl Loisirs & Sant\u00e9 obtiennent une intervention de 50 \u20ac dans le prix pay\u00e9 pour l'affiliation. De ce fait, l'affiliation \u00e0 l'asbl Loisirs & Sant\u00e9 est gratuite pour les membres.\r\n\r\nLes conditions g\u00e9n\u00e9rales sous lesquelles sont organis\u00e9es les activit\u00e9s sont disponibles sur le site https:\/\/www.solidaris-brabant.be\/fr\/loisirs-et-sante Vous inscrire implique que vous en ayez pris connaissance.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.solidaris-brabant.be\/fr\/loisirs-et-sante","email":"loisirs.sante@solidaris.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.548330"},"nl":{"name":"Aquagym Uccle","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.solidaris-brabant.be\/fr\/loisirs-et-sante","email":"loisirs.sante@solidaris.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.548330"},"en":{"name":"Aquagym Uccle","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.solidaris-brabant.be\/fr\/loisirs-et-sante","email":"loisirs.sante@solidaris.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.548330"},"de":{"name":"Aquagym Uccle","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.solidaris-brabant.be\/fr\/loisirs-et-sante","email":"loisirs.sante@solidaris.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.548330"},"it":{"name":"Aquagym Uccle","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.soli