rgets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-04-14T16:05:07+02:00","published_at":"2022-04-14T14:18:10+02:00","backoffice_id":251992,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":0.7937005259841},{"id":524202,"date_start":"2021-12-18","date_end":"2022-12-17","date_next":"2022-05-21","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{"list":[258],"translations":{"fr":["Quartiers"],"nl":["Wijken"],"en":["Neighbourhoods"]}}},"languages":{"spoken":["nl","fr","en"],"subtitles":[]},"translations":{"fr":{"name":"Gegidste fietstocht - Brussel, de highlights en minder betreden paden","shortdescr":"Tour du samedi - D\u00e9couvrez les incontournables et les sentiers moins battus de \r\nBruxelles \u00e0 v\u00e9lo!","longdescr":"Cette visite guid\u00e9e \u00e0 v\u00e9lo est l\u2019introduction id\u00e9ale \u00e0 Bruxelles, \u00e0 son histoire et \u00e0 ses nombreux quartiers. Un m\u00e9lange id\u00e9al entre les incontournables tels que le quartier des Marolles, le March\u00e9 aux Poissons, le Palais de Justice,... et les sentiers moins battus. Pendant ce tour, nos guides vous offrent une vue surprenante sur la ville et sa diversit\u00e9.\r\n\r\nLes tours du samedi se font en petits groupes de maximum 13 personnes pour garder une ambiance conviviale! \u00c0 mi-parcours, les v\u00e9los sont mis de c\u00f4t\u00e9 pour une pause dans un caf\u00e9 sympathique ou sur une terrasse. \r\n\r\nD\u00e9couvrez Bruxelles \u00e0 v\u00e9lo et laissez-vous surprendre !\r\nPrix : \r\n\u202220 \u20ac avec son propre v\u00e9lo\r\n\u202228 \u20ac avec un v\u00e9lo classique incl.\r\n\u202241 \u20ac e-bike incl. \r\n\r\nTous les samedi. Dur\u00e9e 3,5h\r\n10h00 : tour en Fran\u00e7ais et un tour en Anglais\r\n14h00 : tour en N\u00e9erlandais\r\n\r\nhttps:\/\/cactus.brussels\/tours-du-weekend","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/524202.html"},"nl":{"name":"Gegidste fietstocht - Brussel, de highlights en minder betreden paden","shortdescr":"Zaterdagtour - Ontdek de highlights en minder betreden paden van Brussel met de fiets!","longdescr":"Deze gegidste fietstocht is een ideale kennismaking met Brussel, haar geschiedenis en haar vele wijken. Onze gidsen maken van deze fietstocht een ideale mix tussen highlights als de Marollen, de Vismarkt, het Justitiepaleis, \u2026 en de minder betreden paden van de stad en bieden je een verrassende kijk op de stad en haar veelzijdigheid. \r\n\r\nWe gaan op stap met relatief kleine groepen van max. 13 personen om het aangenaam en gezellig te houden! Halverwege de tour gaan de fietsen even aan de kant voor een pauze in een gezellig caf\u00e9 of op een terrasje.\r\n\r\nOntdek Brussel met de fiets en laat je verrassen!\r\n\r\nPrijs: \r\n\u202220 \u20ac met je eigen fiets\r\n\u202228 \u20ac klassieke fiets van cactus\r\n\u202241 \u20ac e-bike van cactus\r\nElke zaterdag. Duur, 3,5u\r\n\u202210u00 : Tour in het Frans en tour in het Engels\r\n\u202214u00: in het Nederlands\r\n\r\nhttps:\/\/cactus.brussels\/weekendtours","performers":null,"boxoffice_url":null,"website":"http:\/\/www.cactus.brussels","email":"info@cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/524202.html"},"en":{"name":"Gegidste fietstocht - Brussel, de highlights en minder betreden paden","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"web