oxoffice_url":null,"website":"https:\/\/erasmushouse.museum\/2022\/09\/concerts-de-midi-erasmusica-2\/","email":"info@erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.544728"},"nl":{"name":"Middagconcerten Erasmusica","shortdescr":null,"longdescr":"Een keer per maand nodigen de studenten van de afdeling Historical Performance Practice van het Koninklijk Conservatorium Brussel u uit te luisteren naar de subtiele en unieke klanken van de barok- en klassieke muziek, uitgevoerd op historische instrumenten. Tijdens een middagconcert nemen zij u mee op een muzikale reis doorheen Europa. Wij gidsen u telkens door een gevarieerd en verrassend programma aan de hand van uitleg en anekdotes.\r\n\r\nGratis en zonder reservering\r\nEen organisatie van het Erasmushuis & Begijnhof en het Koninklijk Conservatorium Brussel in samenwerking met de Muziekacademie Anderlecht.","performers":"De studenten van de afdeling Historical Performance Practice van het Koninklijk Conservatorium Brussel","boxoffice_url":null,"website":"https:\/\/erasmushouse.museum\/nl\/2022\/09\/middagconcerten-erasmusica-2\/","email":"info@erasmushouse.museum","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.544728"},"en":{"name":"Concerts de midi Erasmusica","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/erasmushouse.museum\/2022\/09\/concerts-de-midi-erasmusica-2\/","email":"info@erasmushouse.museum","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.544728"},"de":{"name":"Concerts de midi Erasmusica","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/erasmushouse.museum\/2022\/09\/concerts-de-midi-erasmusica-2\/","email":"info@erasmushouse.museum","phone_contact":null,"phone_booking":null