sitors\/agenda\/event-detail.50001656"},"en":{"name":"Les Dragons","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/poche.be\/show\/2023-les-dragons","email":"reservation@poche.be","phone_contact":"+32 2 647 27 26","phone_booking":"+32 2 649 17 27","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50001656"},"it":{"name":"Les Dragons","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/poche.be\/show\/2023-les-dragons","email":"reservation@poche.be","phone_contact":"+32 2 647 27 26","phone_booking":"+32 2 649 17 27","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50001656"},"cn":{"name":"Les Dragons","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/poche.be\/show\/2023-les-dragons","email":"reservation@poche.be","phone_contact":"+32 2 647 27 26","phone_booking":"+32 2 649 17 27","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50001656"},"fr":{"name":"Les Dragons","shortdescr":null,"longdescr":"Le dragon a entre treize et dix-huit ans. Il ressemble aux enfants normaux. Il est comme tout le monde mais tout le monde a d\u00e9cid\u00e9 qu\u2019il \u00e9tait diff\u00e9rent. Il croit qu\u2019il est seul au monde parce qu\u2019on ne lui a pas dit qu\u2019il y avait sur terre d\u2019autres dragons. En r\u00e9alit\u00e9, ils sont l\u00e9gion.\n\nHorizon+, h\u00f4pital psychiatrique pour adolescents. Un centre bien cach\u00e9 du monde normal. C\u2019est l\u00e0 qu\u2019atterrit, sur d\u00e9cision de justice, un jeune gar\u00e7on en col\u00e8re. Il a 15 ans. L\u2019\u00e2ge o\u00f9 la vie commence.\n\nHospitalis\u00e9e, elle aussi, Colette veut mourir. Peu importe. Il va la sauver. Et elle le sauvera aussi.\n\nMais souvent, \u00e9crivait Steinbeck dans Des Souris et des Hommes, les plans les mieux con\u00e7us ne se r\u00e9alisent pas\u2026\n\nLes dragons est \u00e9crit \u00e0 partir de vraies et belles rencontres. J\u00e9r\u00f4me Colin - animateur \u00e0 la RTBF et auteur du Champ de Bataille repris en d\u00e9but de saison - y parle du surgissement de l\u2019amour dans nos vies. Et dresse le portrait d\u2019une jeunesse exclue, mais qui sait rester tendre et solidaire \u00e0 l\u2019\u00e9gard d\u2019elle-m\u00eame.\n\nPenche-toi sur ton pass\u00e9. R\u00e9pare ce que tu peux r\u00e9parer. Et t\u00e2che de profiter de ce qui te reste. (Philip Roth)","performers":"Mise en sc\u00e8ne Marie-Paule Kumps | Assist\u00e9e de Hyuna Noben | Avec St\u00e9phane Fenocchi | Sc\u00e9nographie et costumes Sarah De Battice | Cr\u00e9ation sonore Catherine De Biasio et Lionel Vancauwenberge | Musique live Catherine De Biasio \/ L\u00e9titia Collet en alternance","boxoffice_url":null,"website":"https:\/\/poche.be\/show\/2023-les-dragons","email":"reservation@poche.be","phone_contact":"+32 2 647 27 26","phone_booking":"+32 2 649 17 27","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50001656"},"sp":{"name":"Les Dragons","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/poche.be\/show\/2023-les-dragons","email":"reservation@poche.be","phone_contact":"+32 2 647 27 26","phone_booking":"+32 2 649 17 27","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50001656"},"nl":{"name":"Les Dragons","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/poche.be\/show\/2023-les-dragons","email":"reservation@poche.be","phone_contact":"+32 2 647 27 26","phone_booking":"+32 2 649 17 27","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50001656"}},"place":{"last_updated_at":"2023-02-01T15:15:45+01:00","published_at":"2013-10-19T01:13:19+02:00","id":943,"translations":{"de":{"name":"Th\u00e9\u00e2tre de Poche","address_street_name":"Chemin du Gymnase","address_street_number":"1 A","address_street_box":nul