hortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/musee-jardins-van-buuren","email":"info@arkadia.be","phone_contact":"+32 2 319 44 85","phone_booking":"+32 2 319 44 85","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700005170"},"it":{"name":"Mus\u00e9e & Jardins Van Buuren","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/musee-jardins-van-buuren","email":"info@arkadia.be","phone_contact":"+32 2 319 44 85","phone_booking":"+32 2 319 44 85","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700005170"},"cn":{"name":"Mus\u00e9e & Jardins Van Buuren","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/musee-jardins-van-buuren","email":"info@arkadia.be","phone_contact":"+32 2 319 44 85","phone_booking":"+32 2 319 44 85","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700005170"},"fr":{"name":"Mus\u00e9e & Jardins Van Buuren","shortdescr":"Explorez l'univers unique de cette maison-mus\u00e9e et ses jardins enchanteurs. Cette visite offre une vue d'ensemble de l'histoire de la villa, construite dans le style Art D\u00e9co, ainsi que de la vie tr\u00e9pidante de ses propri\u00e9taires, David et Alice van Buuren, grands amateurs d'art et de culture.","longdescr":"\nL\u2019int\u00e9rieur, chef-d\u2019\u0153uvre de l\u2019Art D\u00e9co, offre un ensemble unique am\u00e9nag\u00e9 par des d\u00e9corateurs belges, fran\u00e7ais et n\u00e9erlandais de renom. Dans cette maison-mus\u00e9e, mobilier rare, tapis sign\u00e9s, vitraux, sculptures et tableaux de ma\u00eetres belges (de Peter Brueghel \u00e0 James Ensor) et internationaux, du XVe au XXe si\u00e8cle, sont rest\u00e9s \u00e0 leur place dans le cadre intime d\u2019une maison priv\u00e9e. Un vrai voyage dans le temps avec des \u0153uvres exceptionnelles !\nLes jardins sont en eux-m\u00eames un chef d\u2019\u0153uvre de l\u2019art paysager avec le jardin r\u00e9gulier, le jardin pittoresque et la grande roseraie con\u00e7us par Jules Buyssens. Dans les ann\u00e9es soixante, Ren\u00e9 Pech\u00e8re a cr\u00e9\u00e9 le Labyrinthe et le Jardin du c\u0153ur. Alice van Buuren a fait de ce parc un lieu de promenade, de m\u00e9ditation et de r\u00eave. \n\nApr\u00e8s la visite vous pourrez vous promenez librement dans le jardin.\n\nImportant : le ticket d'entr\u00e9e du mus\u00e9e est \u00e0 payer sur place (prix pr\u00e9f\u00e9rentiel de 14\u20ac\/entr\u00e9e au lieu de 17\u20ac, museum pass et Brussels card accept\u00e9s). Merci d'arriver 10' \u00e0 l'avance pour acheter votre ticket pour que la visite puisse commencer \u00e0 l'heure :)","performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/musee-jardins-van-buuren","email":"info@arkadia.be","phone_contact":"+32 2 319 44 85","phone_booking":"+32 2 319 44 85","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700005170"},"sp":{"name":"Mus\u00e9e & Jardins Van Buuren","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/musee-jardins-van-buuren","email":"info@arkadia.be","phone_contact":"+32 2 319 44 85","phone_booking":"+32 2 319 44 85","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700005170"},"nl":{"name":"Mus\u00e9e & Jardins Van Buuren","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/musee-jardins-van-buuren","email":"info@arkadia.be","phone_contact":"+32 2 319 44 85","phone_booking":"+32 2 319 44 85","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700005170"}},"place":{"id":5171,"translations":{"de":{"name":"Mus\u00e9e et Jardins Van Buuren","address_street_name":"Avenue L\u00e9o Errera","address_street_number":"41","address_street_box":null,"email":"info@museumvanbuuren.be","website":"http:\/\/www.museumvanbuuren.be","phone_contact":"+32 2 343 48 51","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Avenue L\u00e9o Errera, 41","address_line2":"1180 Uccle","description_web":"Das Van Buuren Museum und die dazugeh\u00f6rigen G\u00e4rten waren einst Privatbesitz des niederl\u00e4ndischen Bankiers und M\u00e4zens David Van Buuren und seiner Frau Alice Piette. Die im 20. Jahrhundert in Uccle erbaute Art-d\u00e9co-Villa ist buchst\u00e4blich ein \u201elebendiges Schatzk\u00e4stchen\u201d, in dem unz\u00e4hlige Gem\u00e4lde, Skulpturen, Glasmalereien oder auch seltene M\u00f6bel verwahrt werden. Hinzu kommen sch\u00f6ne Wechselausstellungen.\r\n\r\nDie von Jules Buyssens und Ren\u00e9 Pech\u00e8re entworfenen Art-d\u00e9co-G\u00e4rten sind ein Kleinod der Landschaftsarchitektur der 1920er-Jahre. Flanieren Sie durch den malerischen Garten, schlendern Sie durch den Herzgarten, drehen Sie eine Runde durch den Rosengarten, verlaufen Sie sich im Labyrinth und geben Sie dabei sich voll und ganz der Meditation und Tr\u00e4umerei hin.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Mus\u00e9e et Jardins Van Buuren","address_street_name":"Avenue L\u00e9o Errera","address_street_number":"41","address_street_box":null,"email":"info@museumvanbuuren.be","website":"http:\/\/www.museumvanbuuren.be","phone_contact":"+32 2 343 48 51","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Avenue L\u00e9o Errera, 41","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Van Buuren Museum and Gardens","address_street_name":"L\u00e9o Erreralaan","address_street_number":"41","address_street_box":null,"email":"info@museumvanbuuren.be","website":"http:\/\/www.museumvanbuuren.be","phone_contact":"+32 2 343 48 51","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"L\u00e9o Erreralaan, 41","address_line2":"1180 Uccle","description_web":"Nestled in the heart of a listed Art Deco architectural and furnishing estate, the van Buuren Museum & Gardens unveils a cultural treasure of rare beauty. Erected in Uccle in 1928 by architects L\u00e9on Govaerts and Alexis Van Vaerenbergh, the villa embodies the very essence of Art Deco, preserving its international character influenced by Dutch and French schools.\nInside, an invaluable collection of rare furniture, signed carpets, stained glass windows, sculptures, and masterpieces offers a fascinating dive into art history. This residence, a true architectural gem, has remained intact over the years, thus preserving the integrity of the Art Deco ensemble.\nThe art collection of the van Buuren Museum & Gardens, reflecting the taste of the owners, offers a captivating overview of art from the 15th to the 20th century. It presents Belgian and international masterpieces, allowing visitors to discover the unique aesthetics of the van Buurens.\nThe van Buuren Gardens, designed by two of the most prominent Belgian landscape architects, Jules Buyssens and Ren\u00e9 Pech\u00e8re, span 1.2 hectares, harmoniously combining picturesque elements and Art Deco. As witnesses of the evolution of the Nouveau Jardin Pittoresque, these gardens offer a unique, immersive experience through six distinct spaces. The recognition of the gardens by the European Route of Historic Gardens attests to their exceptional cultural, historical, and artistic value.\nSince its establishment in 1970 by Alice van Buuren, the van Buuren Museum & Gardens Foundation has been committed to preserving and disseminating this cultural treasure. Open to the public since 1975, the museum offers a varied artistic program, enriching the cultural landscape of the region.\n","description_print":"27\/06\/2022\r\nThe Van Buuren Museum and Gardens were the private property of David Van Buuren, a Dutch banker and patron of the arts, and his wife Alice Piette. Built in the 20th century in Uccle, this Art Deco villa is a real \"living conservatory\" where you can find paintings, sculptures, stained glass windows and rare furniture. It also hosts temporary exhibitions.\r\n\r\nAs for the gardens, they are landscape architecture jewels from the 1920s. Also in Art Deco style, they were designed by Jules Buyssens and Ren\u00e9 Pech\u00e8re. Stroll through the Picturesque Garden, the Heart Garden and the Rose Garden and lose yourself in the Labyrinth. In this vast walking area, you'll experience a delightful moment of meditation and daydreaming.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Mus\u00e9e et Jardins Van Buuren","address_street_name":"Avenue L\u00e9o Errera","address_street_number":"41","address_street_box":null,"email":"info@museumvanbuuren.be","website":"http:\/\/www.museumvanbuuren.be","phone_contact":"+32 2 343 48 51","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Avenue L\u00e9o Errera, 41","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Mus\u00e9e et Jardins Van Buuren","address_street_name":"Avenue L\u00e9o Errera","address_street_number":"41","address_street_box":null,"email":"info@museumvanbuuren.be","website":"http:\/\/www.museumvanbuuren.be","phone_contact":"+32 2 343 48 51","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Avenue L\u00e9o Errera, 41","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Mus\u00e9e et Jardins Van Buuren","address_street_name":"Avenue L\u00e9o Errera","address_street_number":"41","address_street_box":null,"email":"info@museumvanbuuren.be","website":"http:\/\/www.museumvanbuuren.be","phone_contact":"+32 2 343 48 51","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Avenue L\u00e9o Errera, 41","address_line2":"1180 Uccle","description_web":"Nich\u00e9 au c\u0153ur d'un patrimoine immobilier et mobilier Art d\u00e9co class\u00e9, le Mus\u00e9e & Jardins van Buuren d\u00e9voile un tr\u00e9sor culturel d'une rare beaut\u00e9. \u00c9rig\u00e9e en 1928 par les architectes L\u00e9on Govaerts et Alexis Van Vaerenbergh, la villa incarne l'essence m\u00eame de l'Art d\u00e9co, pr\u00e9servant son caract\u00e8re international influenc\u00e9 par les \u00e9coles hollandaise et fran\u00e7aise.\n\n\u00c0 l'int\u00e9rieur, une collection d'une valeur inestimable compos\u00e9e de mobilier rare, de tapis sign\u00e9s, de vitraux, de sculptures et de tableaux de ma\u00eetres offre une plong\u00e9e fascinante dans l'histoire de l'art. Cette demeure, v\u00e9ritable joyau architectural, est demeur\u00e9e intacte au fil des ans, pr\u00e9servant ainsi l'int\u00e9grit\u00e9 de l'ensemble Art d\u00e9co.\n\nLa collection d'\u0153uvres d'art du Mus\u00e9e & Jardins van Buuren, refl\u00e9tant le go\u00fbt des propri\u00e9taires, offre un panorama captivant de l'art du XVe au XXe si\u00e8cle. Elle pr\u00e9sente des chefs-d'\u0153uvre belges et internationaux, permettant aux visiteurs de d\u00e9couvrir l'esth\u00e9tique singuli\u00e8re des van Buuren.\n\nLes Jardins van Buuren, con\u00e7us par deux des plus \u00e9minents architectes paysagistes belges, Jules Buyssens et Ren\u00e9 Pech\u00e8re, s'\u00e9tendent sur 1,2 hectares, m\u00ealant avec harmonie \u00e9l\u00e9ments pittoresques et Art d\u00e9co. T\u00e9moins de l'\u00e9volution du Nouveau Jardin Pittoresque, ces jardins offrent une exp\u00e9rience immersive unique \u00e0 travers six espaces distincts. La reconnaissance des Jardins par la European Route of Historic Gardens t\u00e9moigne de leur valeur culturelle, historique et artistique exceptionnelle.\n\nDepuis sa cr\u00e9ation en 1970 par Alice van Buuren, la Fondation Mus\u00e9e & Jardins van Buuren s'engage \u00e0 pr\u00e9server et partager ce tr\u00e9sor culturel. Ouvert au public depuis 1975, le mus\u00e9e propose une programmation artistique vari\u00e9e, enrichissant ainsi le paysage culturel de la r\u00e9gion.\n\n","description_print":"27\/06\/2022\r\nLe mus\u00e9e et les jardins Van Buuren \u00e9taient la propri\u00e9t\u00e9 priv\u00e9e de David Van Buuren, banquier et m\u00e9c\u00e8ne n\u00e9erlandais, et son \u00e9pouse Alice Piette. Construite au XXe si\u00e8cle \u00e0 Uccle, cette villa Art d\u00e9co est un v\u00e9ritable \u00ab\u00a0conservatoire vivant\u00a0\u00bb o\u00f9 vous retrouvez autant de peintures, sculptures, vitraux ou encore mobilier rare. D\u00e9couvrez aussi des expositions temporaires.\r\n\r\nQuant aux jardins, ils sont un joyau de l\u2019architecture paysagiste des ann\u00e9es 1920. \u00c9galement de style Art d\u00e9co, ils ont \u00e9t\u00e9 con\u00e7us par Jules Buyssens et Ren\u00e9 Pech\u00e8re. Promenez-vous dans le Jardin pittoresque, baladez-vous dans le Jardin du coeur, faites un tour par la roseraie et perdez-vous dans le Labyrinthe. Dans ce vaste lieu de promenade, vous profiterez d\u2019un agr\u00e9able moment o\u00f9 m\u00e9ditation et r\u00eave sont les ma\u00eetres-mots.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Museo y jardines de David y Alice Van Buuren","address_street_name":"Avenue L\u00e9o Errera","address_street_number":"41","address_street_box":null,"email":"info@museumvanbuuren.be","website":"http:\/\/www.museumvanbuuren.be","phone_contact":"+32 2 343 48 51","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Avenue L\u00e9o Errera, 41","address_line2":"1180 Uccle","description_web":"Esta casa fue comprada en 1928 por en banquero y patr\u00f3n David Van Buuren, posee una magn\u00edfica arquitectura exterior t\u00edpica de la escuela de \u00c1msterdam. La decoraci\u00f3n de la parte interior est\u00e1 caracterizada por una decoraci\u00f3n art dec\u00f3 \u00fanica dise\u00f1ada en su totalidad por dise\u00f1adores belgas, franceses y neerlandeses. Los Van Buuren convirtieron su villa en una \"academia viviente\", donde muebles extravagantes, alfombras exc\u00e9ntricas, vidrieras, esculturas y obras maestras internacionales han permanecido en el lugar. El jard\u00edn, de un tama\u00f1o excepcional, ha sido restaurado. La casa se convirti\u00f3 en un museo en 1975 de acuerdo con el testamento de Alice Van Buuren.\r\n\r\nLa armon\u00eda era la principal preocupaci\u00f3n de David y David y Alice Van Buuren cuando dise\u00f1aron su casa, armon\u00eda en el estilo art dec\u00f3 del interior y armon\u00eda en los jardines que rodean la casa. En 1929, despu\u00e9s de empezar a cultivar el jard\u00edn, el banquero neerland\u00e9s, David Van Buuren(1886-1955) \u2014emparentado con la casa Orange-Nassau\u2014 y su mujer, Alice, construyeron su casa. Esta \u00e9poca fue una locura en Europa, ya que las \u00e9lites sociales s\u00f3lo buscaban el lujo sin l\u00edmites. Una aspiraci\u00f3n cumplida por los dise\u00f1adores y decoradores por su uso de materiales excepcionales(maderas ex\u00f3ticas, salientes, marfil, etc.). Soberbias colecciones de obras del s. XV hasta el s. XX, incluyendo una versi\u00f3n de \"Paisaje con la ca\u00edda de \u00cdcaro\" de Pieter Brueghel el Viejo. \r\n\r\nLos jardines cubren un \u00e1rea de 1'5 hect\u00e1reas incluyendo el \"Jard\u00edn del Coraz\u00f3n\" de R. Pech\u00e8re y el laberinto.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Museum en tuinen van Buuren","address_street_name":"L\u00e9o Erreralaan","address_street_number":"41","address_street_box":null,"email":"info@museumvanbuuren.be","website":"http:\/\/www.museumvanbuuren.be","phone_contact":"+32 2 343 48 51","phone_booking":null,"address_zip":"1180","address_city":"Ukkel","address_line1":"L\u00e9o Erreralaan, 41","address_line2":"1180 Ukkel","description_web":"Gelegen in het hart van een beschermd Art Deco onroerend en roerend erfgoed, onthult het van Buuren Museum & Tuinen een culturele schat van zeldzame schoonheid. De villa, opgericht in 1928 door de architecten L\u00e9on Govaerts en Alexis Van Vaerenbergh, belichaamt de essentie van de Art Deco, waarbij het internationale karakter be\u00efnvloed is door de Nederlandse en Franse scholen.\nBinnenin biedt een onschatbare collectie van zeldzaam meubilair, gesigneerde tapijten, glas-in-loodramen, beeldhouwwerken en meesterwerken een fascinerende duik in de kunstgeschiedenis. Deze woning, een echt architectonisch juweel, is door de jaren heen ongerept gebleven, waardoor de integriteit van het geheel van de Art Deco behouden blijft.\nDe kunstcollectie van het van Buuren Museum & Tuinen, die de smaak van de eigenaren weerspiegelt, biedt een boeiend overzicht van de kunst van de 15e tot de 20e eeuw. Ze presenteert Belgische en internationale meesterwerken, waardoor bezoekers de unieke esthetiek van de van Buurens kunnen ontdekken.\nDe van Buuren Tuinen, ontworpen door twee van de meest vooraanstaande Belgische landschapsarchitecten, Jules Buyssens en Ren\u00e9 Pech\u00e8re, strekken zich uit over 1,2 hectare en combineren op harmonieuze wijze pittoresque elementen en Art Deco. Als getuigen van de evolutie van de Nouveau Jardin Pittoresque bieden deze tuinen een unieke, meeslepende ervaring door middel van zes verschillende ruimtes. De erkenning van de tuinen door de European Route of Historic Gardens getuigt van hun uitzonderlijke culturele, historische en artistieke waarde.\nSinds de oprichting in 1970 door Alice van Buuren zet de van Buuren Museum & Tuinen Stichting zich in voor het behoud en de verspreiding van deze culturele schat. Sinds 1975 open voor het publiek, biedt het museum een gevarieerd artistiek programma, waardoor het culturele landschap van de regio wordt verrijkt.\n","description_print":"27\/06\/2022\r\nOoit was dit het priv\u00e9-bezit van de Nederlandse bankier en mecenas David Van Buuren en zijn vrouw Alice Piette. In deze art-decovilla in Ukkel vind je een schat aan schilderijen, beeldhouwwerken, glas-in-loodramen en zeldzaam meubilair. Er zijn ook tijdelijke tentoonstellingen.\r\n\r\nDe tuinen zijn een prachtig staaltje landschapsarchitectuur uit de jaren 1920. Jules Buyssens en Ren\u00e9 Pech\u00e8re ontwierpen ze in art-decostijl. Wandel zeker door de pittoreske tuin, de hartentuin en de rozentuin. Maar het klapstuk is het labyrint. Zorg ervoor dat je niet verdwaalt! Hier kan je volop genieten, mediteren of wegdromen.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[21],"translations":{"de":["S\u00fcden"],"pt":[null],"en":["South"],"it":["Sud"],"cn":[null],"fr":["Sud"],"sp":["Sur"],"nl":["Zuid"]}},"neca":null,"facebook_id":null,"backoffice_id":289,"location":{"lat":50.81005189,"lon":4.35382833},"region":"brussels","last_updated_at":"2024-11-22T09:39:43+01:00","published_at":"2013-10-19T01:13:25+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":276946,"translations":{"de":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be\/en","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue de Namur, 10","address_line2":"1000 Brussels","description_web":"Since 1983, Arkadia has been exploring the richness of Belgium's and Brussels' heritage and developing numerous cultural projects especially in Brussels, between architecture, urbanism, culture, plastic arts and ideology from the Middle Ages to the present day. Seeing and understanding the city and its architectural development, approaching artistic creation and giving it meaning, these are the activities that the ASBL wants to share with the public. Specialists in architectural heritage and contemporary art, they show the city through guided tours and lectures in several languages.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":"Depuis 1983, Arkadia explore les richesses du patrimoine belge et bruxellois et d\u00e9veloppe de nombreux projets culturels sp\u00e9cialement \u00e0 Bruxelles, entre architecture, urbanisme, culture, arts plastiques et id\u00e9ologie depuis le Moyen \u00c2ge jusqu\u2019\u00e0 nos jours. Voir et comprendre la ville et son d\u00e9veloppement architectural, approcher la cr\u00e9ation artistique et lui donner un sens, telles sont les activit\u00e9s que l'ASBL veut partager avec le public. Sp\u00e9cialistes du patrimoine  architectural et de l'art contemporain, ils font d\u00e9couvrir la ville \u00e0 travers des visites guid\u00e9es et des conf\u00e9rences en plusieurs langues.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Arkadia","address_street_name":"Naamsestraat","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be\/nl","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Naamsestraat, 10","address_line2":"1000 Brussel","description_web":"Sinds 1983 verkent Arkadia de rijkdom van het Belgische en Brusselse erfgoed en ontwikkelt talrijke culturele projecten, vooral in Brussel, tussen architectuur, stedenbouw, cultuur, plastische kunsten en ideologie, van de Middeleeuwen tot vandaag. De stad en haar architecturale ontwikkeling zien en begrijpen, de artistieke creatie benaderen en er een betekenis aan geven, dat zijn de activiteiten die de VZW met het publiek wil delen. Zij zijn gespecialiseerd in architectonisch erfgoed en hedendaagse kunst en laten de stad zien door middel van rondleidingen en lezingen in verschillende talen.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":36946,"location":{"lat":50.84145283,"lon":4.35976257},"last_updated_at":"2023-06-08T12:25:28+02:00","published_at":"2021-07-23T14:48:31+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/cf2bbe803387c5fac7b1110013c4e73645addce5.jpg","width":944,"height":614,"ratio":1.54,"oEmbed_height":614,"oEmbed_width":944,"translations":{"de":{"title":"Mus\u00e9e & Jardins Van Buuren","copyright":null},"pt":{"title":"Mus\u00e9e & Jardins Van Buuren","copyright":null},"en":{"title":"Mus\u00e9e & Jardins Van Buuren","copyright":null},"it":{"title":"Mus\u00e9e & Jardins Van Buuren","copyright":null},"cn":{"title":"Mus\u00e9e & Jardins Van Buuren","copyright":null},"fr":{"title":"Mus\u00e9e & Jardins Van Buuren","copyright":null},"sp":{"title":"Mus\u00e9e