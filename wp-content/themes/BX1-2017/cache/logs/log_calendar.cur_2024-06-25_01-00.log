ranslations":{"de":"Theater","pt":null,"en":"Theatre","it":"Teatro","cn":null,"fr":"Th\u00e9\u00e2tre","sp":"Teatro","nl":"Theater"}},"others":{"list":[50],"translations":{"de":["Theater"],"pt":[null],"en":["Theatre"],"it":["Teatro"],"cn":[null],"fr":["Th\u00e9\u00e2tre"],"sp":["Teatro"],"nl":["Theater"]}}},"translations":{"de":{"name":"Le baiser de la femme araign\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatrelepublic.be","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.558359"},"pt":{"name":"Le baiser de la femme araign\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatrelepublic.be","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.558359"},"en":{"name":"Le baiser de la femme araign\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatrelepublic.be","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.558359"},"it":{"name":"Le baiser de la femme araign\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatrelepublic.be","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.558359"},"cn":{"name":"Le baiser de la femme araign\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatrelepublic.be","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.558359"},"fr":{"name":"Le baiser de la femme araign\u00e9e","shortdescr":null,"longdescr":"Libert\u00e9 ch\u00e9rie!\r\nIl faut r\u00e9sister, il est de notre devoir de r\u00e9sister quand l\u2019ordre sert la tyrannie.\r\n\r\nDans un pays totalitaire, deux hommes partagent l\u2019\u00e9troitesse d\u2019une cellule de prison. Deux gars que tout oppose vont \u00eatre oblig\u00e9s de trouver le chemin qui les m\u00e8nera \u00e0 la fraternit\u00e9.\r\n\r\nSur sc\u00e8ne, vous verrez deux acteurs au sommet. Ce projet est le leur. Vous les verrez comme cul et chemise, vous emporter hors des murs et des fronti\u00e8res. Deux hommes qui sont la preuve que, gr\u00e2ce \u00e0 l\u2019imagination et aux id\u00e9es, m\u00eame au c\u0153ur d\u2019un syst\u00e8me totalitaire, les murs peuvent tomber.\r\n\r\nDans le contexte g\u00e9opolitique \u00e9minemment instable, face aux mont\u00e9es de l\u2019extr\u00eame droite partout en Europe, Le baiser de la femme araign\u00e9e, roman sorti en 1976, n\u2019a rien perdu de sa pertinence ni de sa force. Il nous parle des mensonges par lesquels les dictatures battissent leur emprise. Les pi\u00e8ges s\u00e9curisants dans lesquels on est pr\u00eats \u00e0 tomber en sacrifiant nos libert\u00e9s.\r\n\r\nLe texte de Manuel Puig a \u00e9t\u00e9 adapt\u00e9 au cin\u00e9ma par H\u00e9tor Babenco en 1985, en com\u00e9die musicale, \u00e0 l\u2019op\u00e9ra et au th\u00e9\u00e2tre, avec chaque fois la m\u00eame pertinence et le m\u00eame succ\u00e8s. Il n\u2019arr\u00eate pas de nous alerter pour qu\u2019au-del\u00e0 et par-del\u00e0 les murs nous continuions \u00e0 r\u00e9inventer toujours et toujours, la libert\u00e9.\r\n__________\r\n\r\nD'apr\u00e8s l'\u0153uvre originale de Manuel Puig \/ Mise en sc\u00e8ne : Laurent Capelluto \/ Avec : Itsik Elbaz et Antoine Guillaume\r\n__________\r\n\r\nUNE PRODUCTION DU TH\u00c9\u00c2TRE LE PUBLIC. AVEC LE SOUTIEN DU TAX SHELTER DE L\u2019\u00c9TAT F\u00c9D\u00c9RAL BELGE VIA BESIDE ET DE LA COMMUNAUT\u00c9 FRAN\u00c7AISE.\r\n","performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatrelepublic.be","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.558359"},"sp":{"name":"Le baiser de la femme araign\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatrelepublic.be","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.558359"},"nl":{"name":"Le baiser de la femme araign\u00e9e","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatrelepublic.be","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.558359"}},"place":{"id":224476,"translations":{"de":{"name":"Th\u00e9\u00e2tre Le Public","address_street_name":"Rue Braemt","address_street_number":"64 70","address_street_box":null,"email":"contact@theatrelepublic.be","website":"http:\/\/www.theatrelepublic.be","phone_contact":"+32 2 724 24 44","phone_booking":"+32 2 724 24 44","address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Braemt, 64 70","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Th\u00e9\u00e2tre Le Public","address_street_name":"Rue Braemt","address_street_number":"64 70","address_street_box":null,"email":"contact@theatrelepublic.be","website":"http:\/\/www.theatrelepublic.be","phone_contact":"+32 2 724 24 44","phone_booking":"+32 2 724 24 44","address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Braemt, 64 70","address_line2":"1