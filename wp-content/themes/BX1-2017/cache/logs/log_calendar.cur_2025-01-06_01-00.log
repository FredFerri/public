, filosofie en zelfs sprookjes en jeugdtheater ruimschoots aan bod.   ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":"lefourire","region":"brussels","backoffice_id":11226,"location":{"lat":50.8097778,"lon":4.3917894},"last_updated_at":"2024-11-07T14:28:15+01:00","published_at":"2013-10-19T01:30:00+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/de629db947090c3b5368557dfdac5f10332c9065.jpg","width":5008,"height":7063,"ratio":0.71,"oEmbed_height":7063,"oEmbed_width":5008,"translations":{"de":{"title":"Harmonie Rouffiange: Hyper","copyright":"le fourire th\u00e9\u00e2tre"},"pt":{"title":"Harmonie Rouffiange: Hyper","copyright":"le fourire th\u00e9\u00e2tre"},"en":{"title":"Harmonie Rouffiange: Hyper","copyright":"le fourire th\u00e9\u00e2tre"},"it":{"title":"Harmonie Rouffiange: Hyper","copyright":"le fourire th\u00e9\u00e2tre"},"cn":{"title":"Harmonie Rouffiange: Hyper","copyright":"le fourire th\u00e9\u00e2tre"},"fr":{"title":"Harmonie Rouffiange: Hyper","copyright":"le fourire th\u00e9\u00e2tre"},"sp":{"title":"Harmonie Rouffiange: Hyper","copyright":"le fourire th\u00e9\u00e2tre"},"nl":{"title":"Harmonie Rouffiange: Hyper","copyright":"le fourire th\u00e9\u00e2tre"}}},{"type":"poster","link":"https:\/\/agendabrussels2.imgix.net\/2d455b3f762f6a1ffe5c837b7e0f70d55b67b668.jpg","width":5008,"height":7063,"ratio":0.71,"oEmbed_height":7063,"oEmbed_width":5008,"translations":{"de":{"title":"Harmonie Rouffiange: Hyper","copyright":"le fourire th\u00e9\u00e2tre"},"pt":{"title":"Harmonie Rouffiange: Hyper","copyright":"le fourire th\u00e9\u00e2tre"},"en":{"title":"Harmonie Rouffiange: Hyper","copyright":"le fourire th\u00e9\u00e2tre"},"it":{"title":"Harmonie Rouffiange: Hyper","copyright":"le fourire th\u00e9\u00e2tre"},"cn":{"title":"Harmonie Rouffiange: Hyp