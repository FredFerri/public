ete.be\/blogs\/news\/expo-souffle-dorient-de-imene-jarry","email":null,"phone_contact":"+32 2 512 13 85","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50001192"},"pt":{"name":"Exhibition \u00ab Souffle d'Orient \u00bb of Im\u00e8ne Jarry","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/montdepiete.be\/blogs\/news\/expo-souffle-dorient-de-imene-jarry","email":null,"phone_contact":"+32 2 512 13 85","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50001192"},"en":{"name":"Im\u00e8ne Jarry - 'Souffle d'Orient'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/montdepiete.be\/blogs\/news\/expo-souffle-dorient-de-imene-jarry","email":null,"phone_contact":"+32 2 512 13 85","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50001192"},"it":{"name":"Exhibition \u00ab Souffle d'Orient \u00bb of Im\u00e8ne Jarry","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/montdepiete.be\/blogs\/news\/expo-souffle-dorient-de-imene-jarry","email":null,"phone_contact":"+32 2 512 13 85","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50001192"},"cn":{"name":"Exhibition \u00ab Souffle d'Orient \u00bb of Im\u00e8ne Jarry","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/montdepiete.be\/blogs\/news\/expo-souffle-dorient-de-imene-jarry","email":null,"phone_contact":"+32 2 512 13 85","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50001192"},"fr":{"name":"Im\u00e8ne Jarry - 'Souffle d'Orient'","shortdescr":"Artiste belge d\u2019origine tunisienne, Im\u00e8ne Jarry est passionn\u00e9e par la calligraphie arabe qu\u2019elle utilise dans son expression artistique.\nSes \u0153uvres color\u00e9es \u00e9voquent les voyages, le soleil, la mer, ses souvenirs nomades de la Belgique \u00e0 la Tunisie. Elle les propose \u00e0 travers diff\u00e9rents supports \u00e0 mettre en valeur dans un espace tant priv\u00e9 que public.","longdescr":"Artiste belge d\u2019origine tunisienne, Im\u00e8ne Jarry peint depuis l\u2019\u00e2ge de 15 ans. Autodidacte, elle a commenc\u00e9 avec le plus simple des mat\u00e9riaux : des crayons de couleur. Voyant que son entourage \u00e9tait demandeur de ses dessins, elle s\u2019engage rapidement dans la peinture essentiellement acrylique puis se passionne pour la calligraphie arabe qu\u2019elle utilise dans son expression artistique.\nSes \u0153uvres color\u00e9es \u00e9voquent les voyages, le soleil, la mer, ses souvenirs nomades de la Belgique \u00e0 la Tunisie. Elle les propose \u00e9galement \u00e0 travers diff\u00e9rents supports \u00e0 mettre en valeur dans un espace tant priv\u00e9 que public. Celles-ci sont disponibles sur son site internet Souffle d\u2019Orient.\n\nDates de l'exposition\nDu 26 ao\u00fbt au 10 septembre 2023\n\nHoraires de l\u2019exposition\nDu samedi au dimanche (10h30 - 18h)\n\nVernissage\nLe samedi 26 ao\u00fbt 2023 de 18h \u00e0 20h\n\nInitiation \u00e0 la calligraphie arabe\nDates : dimanche 27 ao\u00fbt \u00e0 11h, samedi 2 septembre \u00e0 14h et samedi 10 septembre \u00e0 14h.\nDur\u00e9e : 1 heure\nPrix : 10\u20ac. Chaque participant repartira avec une toile avec de la calligraphie arabe en souvenir \u263a\ufe0f\nMaximum 10 participants (\u00e2ge min : 6 ans), acc\u00e8s sans r\u00e9servation pr\u00e9alable.\n\nEntr\u00e9e gratuite (sauf l'atelier)\n\nPlus d'infos : https:\/\/montdepiete.be\/blogs\/news\/expo-souffle-dorient-de-imene-jarry","performers":"Im\u00e8ne Jarry (calligraphie arabe)","boxoffice_url":null,"website":"https:\/\/montdepiete.be\/blogs\/news\/expo-souffle-dorient-de-imene-jarry","email":null,"phone_contact":"+32 2 512 13 85","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50001192"},"sp":{"name":"Exhibition \u00ab Souffle d'Orient \u00bb of Im\u00e8ne Jarry","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/montdepiete.be\/blogs\/news\/expo-souffle-dorient-de-imene-jarry","email":null,"phone_contact":"+32 2 512 13 85","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50001192"},"nl":{"name":"Im\u00e8ne Jarry - 'Souffle d'Orient'","shortdescr":"De Belgische kunstenares van Tunesische afkomst, Im\u00e8ne Jarry is gepassioneerd door Arabische kalligrafie die ze gebruikt in haar artistieke expressie.\nHaar kleurrijke werken roepen reizen op, de zon, de zee, haar nomadische herinneringen van Belgi\u00eb tot Tunesi\u00eb. Ze gebruikt ook verschillende ondergronden om haar werk te tonen, dit in zowel priv\u00e9- als publieke ruimtes.","longdescr":"De Belgische kunstenares van Tunesische afkomst, Im\u00e8ne Jarry schildert sinds haar 15de. Als autodidact begon ze met het eenvoudigste materiaal: kleurpotloden. Toen ze zag dat mensen om haar heen om haar tekeningen vroegen, ontwikkelde ze zich verder, voornamelijk in acrylschilderen. Vervolgens raakte ze gepassioneerd door Arabische kalligrafie die ze gebruikt in haar artistieke expressie.\nHaar kleurrijke werken roepen reizen op, de zon, de zee, haar nomadische herinneringen van Belgi\u00eb tot Tunesi\u00eb. Ze gebruikt ook verschillende ondergronden om haar werk te tonen, dit in zowel priv\u00e9- als publieke ruimtes. Deze werken zijn beschikbaar op haar website Souffle d'Orient.\n \nData van de tentoonstelling\nVan 26 augustus tot 10 september 2023\n\nOpeningsuren van de tentoonstelling\nVan zaterdag t\/m zondag (10u30 - 18u)\n\nVernissage\nZaterdag 26 augustus 2023 van 18u tot 20u\n\nInleiding tot Arabische kalligrafie\n\nData: zondag 27 augustus om 11u, zaterdag 2 september om 14u en zaterdag 10 september om 14u\nDuur: 1 uur\nPrijs: \u20ac 10. Elke deelnemer gaat naar huis met een canvas met Arabische kalligrafie als souvenir \u263a\ufe0f\nMaximaal 10 deelnemers (min. leeftijd: 6 jaar), toegang zonder reservering.\nGratis toegang (behalve de inleiding)\n\nMeer info: https:\/\/montdepiete.be\/nl\/blogs\/news\/expo-souffle-dorient-de-imene-jarry","performers":null,"boxoffice_url":null,"website":"https:\/\/montdepiete.be\/blogs\/news\/expo-souffle-dorient-de-imene-jarry","email":null,"phone_contact":"+32 2 512 13 85","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50001192"}},"place":{"id":221323,"translations":{"de":{"name":"Mont de Pi\u00e9t\u00e9 (Caisse Publique de Pr\u00eats)","address_street_name":"Rue Saint-Ghislain","address_street_number":"1923","address_street_box":null,"email":null,"website":null,"phone_contact":"+32 2 512 13 85","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Saint-Ghislain, 1923","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Mont de Pi\u00e9t\u00e9 (Caisse Publique de Pr\u00eats)","address_street_name":"Rue Saint-Ghislain","address_street_number":"1923","address_street_box":null,"email":null,"website":null,"phone_contact":"+32 2 512 13 85","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Saint-Ghislain, 1923","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Mont de Pi\u00e9t\u00e9 (Caisse Publique de Pr\u00eats)","address_street_name":"Rue Saint-Ghislain","address_street_number":"1923","address_street_box":null,"email":null,"website":null,"phone_contact":"+32 2 512 13 85","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Saint-Ghislain, 1923","address_line2":"1000 Bruxelles","description_web":null,"description_p