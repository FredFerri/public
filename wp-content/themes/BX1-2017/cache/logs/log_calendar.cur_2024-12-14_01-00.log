rbe haut et \u00e0 la rime facile, Cornebidouille.\n\n\n\nLe petit gar\u00e7on la d\u00e9fie avec fantaisie malice au fil de ses aventures\u2026 Une histoire \u00e0 d\u00e9couvrir en famille et en chansons !\n\n> R\u00e9servations sur Ticketmaster.be","performers":"Mise en sc\u00e8ne : Emilie G\u00e9vart \/ Avec Anne-Sophie Boez, Sarah Gevart, Julien Huet, J\u00e9r\u00e9my Torres\nTechnique : Quentin Heems\nMusique : Julien Huet - Emilie G\u00e9vart\nCostumes : Bertrand Sachy","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50010283"},"sp":{"name":"Cornebidouille","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50010283"},"nl":{"name":"Cornebidouille","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50010283"}},"place":{"id":136,"translations":{"de":{"name":"Centre Culturel d'Auderghem","address_street_name":"Boulevard du Souverain","address_street_number":"183","address_street_box":null,"email":"accueil@ccauderghem.be","website":"http:\/\/www.ccauderghem.be","phone_contact":"+32 2 660 03 03","phone_booking":null,"address_zip":"1160","address_city":"Auderghem","address_line1":"Boulevard du Souverain, 183","address_line2":"1160 Auderghem","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Centre Culturel d'Auderghem","address_street_name":"Boulevard du Souverain","address_street_number":"183","address_street_box":null,"email":"accueil@ccauderghem.be","website":"http:\/\/www.ccauderghem.be","phone_contact":"+32 2 660 03 03","phone_b