4t ?\r\n\r\nLe programme complet \u00e0 d\u00e9couvrir ici https:\/\/bit.ly\/3Oslwdn\r\n\r\nUne programmation propos\u00e9e par les Centres Culturels du Nord-Ouest de Bruxelles Archipel 19 (Berchem-Sainte-Agathe et Koekelberg), La Villa (Ganshoren) et le Centre Culturel de Jette en partenariat avec le Centre Sportif Victoria, La Concertation, la Biblioth\u00e8que francophone de Koekelberg et le Belgian Chocolate Village.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.archipel19.be","email":"c.poinas@culturebruxellesno.be","phone_contact":"+32 478 90 41 99","phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/536408.html"},"nl":{"name":"L\u2019Agora s\u2019installe au parc Victoria","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/536408.html"},"en":{"name":"L\u2019Agora s\u2019installe au parc Victoria","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/536408.html"},"de":{"name":"L\u2019Agora s\u2019installe au parc Victoria","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/536408.html"},"it":{"name":"L\u2019Agora s\u2019installe au parc Victoria","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/536408.html"},"sp":{"name":"L\u2019Agora s\u2019installe au parc Victoria","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https