oxoffice_url":null,"website":null,"email":"lescompagnonsdefloreal@hotmail.com>","phone_contact":"+32 2 673 84 21","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50009807"},"fr":{"name":"Visites guid\u00e9es des Cit\u00e9s-Jardins Le Logis et Flor\u00e9al \u00e0 Watermael-Boitsfort","shortdescr":"Visitez le plus grand ensemble de cit\u00e9s-jardins en Belgique, un site class\u00e9 au patrimoine de la R\u00e9gion de Bruxelles-Capitale, en compagnie d'une guide-conf\u00e9renci\u00e8re qui y habite depuis plus de 25 ans.\nCette visite sera l'occasion de d\u00e9couvrir l'histoire, l'architecture et le paysage des cit\u00e9s-jardins ainsi que la vie d'aujourd'hui dans ce cadre exceptionnel.\n","longdescr":"Le Logis et Flor\u00e9al, n\u00e9es il y a plus de 100 ans, constituent un des plus beaux ensembles de cit\u00e9s-jardins en Europe.\nDes ruelles qui serpentent, des maisons style cottage entour\u00e9es d\u2019une v\u00e9g\u00e9tation abondante, un labyrinthe de sentiers qui passent entre les jardins et qui m\u00e8nent \u00e0 des int\u00e9rieurs d\u2019\u00eelots plant\u00e9s d\u2019arbres fruitiers, des immeubles \u00e0 l\u2019architecture moderniste\u2026.  \nVisiter Le Logis et Flor\u00e9al, c\u2019est d\u00e9couvrir tout un pan de l\u2019histoire architecturale et sociale de la Belgique du 20\u00e8me si\u00e8cle. C\u2019est aussi se promener dans un cadre pr\u00e9serv\u00e9 qui sert r\u00e9guli\u00e8rement de d\u00e9cor pour le cin\u00e9ma, c\u2019est prendre le temps de s\u2019impr\u00e9gner pleinement de la nature environnante et de rencontrer des habitants\u2026\n\nPossibilit\u00e9s de visites sur mesure :\nEnvie de d\u00e9couvrir les cit\u00e9s-jardins en famille, entre amis ou coll\u00e8gues, d\u2019organiser une activit\u00e9 avec des \u00e9l\u00e8ves ou \u00e9tudiants, d\u2019offrir un cadeau original, \u2026\nDes visites guid\u00e9es personnalis\u00e9es peuvent \u00eatre organis\u00e9es toute l'ann\u00e9e sur demande (en fran\u00e7ais et en anglais), au prix de 40 euros.\nContact: lescompagnonsdefloreal@hotmail.com  ++32 2 673 84 21\n\n","performers":null,"boxoffice_url":null,"website":null,"email":"lescompagnonsdefloreal@hotmail.com>","phone_contact":"+32 2 673 84 21","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50009807"},"sp":{"name":"Visites guid\u00e9es des Cit\u00e9s-Jardins Le Logis et Flor\u00e9al \u00e0 Watermael-Boitsfort","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"lescompagnonsdefloreal@hotmail.com>","phone_contact":"+32 2 673 84 21","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50009807"},"nl":{"name":"Visites guid\u00e9es des Cit\u00e9s-Jardins Le Logis et Flor\u00e9al \u00e0 Watermael-Boitsfort","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"lescompagnonsdefloreal@hotmail.com>","phone_contact":"+32 2 673 84 21","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50009807"}},"place":{"id":278164,"translations":{"de":{"name":"Visitor Center - Le Logis Flor\u00e9al","address_street_name":"Place Joseph Wauters","address_street_number":"2","address_street_box":null,"email":"info@lelogisfloreal.be","website":"https:\/\/www.lelogisfloreal.be\/visitor-center\/","phone_contact":null,"phone_booking":null,"address_zip":"1170","address_city":"Watermael-Boitsfort","address_line1":"Place Joseph Wauters, 2","address_line2":"1170 Watermael-Boitsfort","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Visitor Center - Le Logis Flor\u00e9al","address_street_name":"Place Joseph Wauters","address_street_number":"2","address_street_box":null,"email":"info@lelogisfloreal.be","website":"https:\/\/www.lelogisfloreal.be\/visitor-center\/","phone_cont