":0.75,"translations":{"fr":{"title":"Escape game urbain - Coddy","copyright":null},"nl":{"title":"Escape game urbain - Coddy","copyright":null},"en":{"title":"Escape game urbain - Coddy","copyright":null}}},{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/e2165d0bc04dff037c4d1aa4935d827b768402bc.jpg","width":1500,"height":1000,"ratio":1.5,"translations":{"fr":{"title":"Escape game urbain - Coddy","copyright":null},"nl":{"title":"Escape game urbain - Coddy","copyright":null},"en":{"title":"Escape game urbain - Coddy","copyright":null}}}],"dates":[],"weekschema":[{"days":{"monday":{"is_open":false},"tuesday":{"is_open":false},"wednesday":{"is_open":false},"thursday":{"is_open":false},"friday":{"is_open":false},"saturday":{"is_open":false},"sunday":{"is_open":false}},"translations":{"fr":["lundi, mardi, mercredi, jeudi, vendredi, samedi et dimanche: ferm\u00e9"],"nl":["maandag, dinsdag, woensdag, donderdag, vrijdag, zaterdag en zondag: gesloten"],"en":["monday, tuesday, wednesday, thursday, friday, saturday and sunday: closed"]},"date_start":"2020-09-15","date_end":"2024-06-30","is_also_by_appointment":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":39.99}],"child_events":[],"parent_events":[],"targets":{"list":[16,11,7,8,12,19],"translations":{"fr":["Ecoles","Famille","Jeunes 12-15 ans","Jeunes 15-18 ans","LGTBQIA","Enseignants"],"nl":["Scholen","Familie","Jongeren 12-15 j.","Jongeren 15-18 j.","LGTBQIA","Leerkrachten"],"en":["Schools","Family","Youth 12-15  yr.","Youth 15-18  yr.","LGTBQIA","Teachers"]}},"tags":["exterior","kids"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-10T11:37:35+02:00","published_at":"2022-07-01T16:58:15+02:00","backoffice_id":257531,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.089711904312664},{"id":523499,"date_start":"2021-11-25","date_end":"2025-12-31","date_next":"2025-12-31","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen"}},"others":{"list":[109],"translations":{"fr":["Espaces verts"],"nl":["Groene zones"],"en":["Green spaces"],"de":["Gr\u00fcnfl\u00e4chen"]}}},"languages":{"spoken":["nl","fr","en"],"subtitles":[]},"translations":{"fr":{"name":"Nourrir Bruxelles, entre ville et campagne","shortdescr":"D\u00e9couvrez la nature et l\u2019alimentation durable \u00e0 Neerpede (Anderlecht) \u00e0 travers une chasse aux tr\u00e9sors, guid\u00e9 par votre smartphone.","longdescr":"Connaissez-vous la zone de Neerpede \u00e0 Anderlecht ? Un territoire qui regorge de richesses naturelles ! Cette zone est cl\u00e9 pour l\u2019\u00e9quilibre de la ville, gr\u00e2ce \u00e0 ses milieux aquatiques, ses zones bois\u00e9es, ses champs et sa biodiversit\u00e9 mais aussi pour \u201cnourrir Bruxelles\u201d.\r\n\r\nCe n\u2019est pas pour rien qu\u2019on voit \u00e9merger ici de nouvelles initiatives de jeunes urbains qui se lancent dans l\u2019agriculture agro\u00e9cologique pleine terre. D\u00e9couvrez ce territoire, sa biodiversit\u00e9, ses projets & enjeux et l\u2019importance d\u2019un bon \u00e9quilibre entre agriculture et nature.\r\n\r\nCOMMENT JOUER ?\r\nLa chasse est 100% gratuite !\r\n\r\nPour participer, t\u00e9l\u00e9chargez l\u2019application TOTEMUS sur votre smartphone, cherchez la balade \u00e0 Neerpede \u00ab Nourrir Bruxelles, entre ville et campagne \u00bb et amusez-vous !","performers":null,"boxoffice_url":null,"website":"https:\/\/totemus.be\/les-chasses\/77-bruxelles-neerpede-nourrir-bruxelles-entre-ville-et-campagne","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.523499"},"nl":{"name":"Brusselse kost, tussen stad en platteland","shortdescr":"Ontdek de natuur en de duurzame voeding in Neerpede (het Pajottenland van Anderlecht) tijdens een schattenjacht, begeleid door je smartphone.","longdescr":"Ken je Neerpede in Anderlecht? Het is een plek met heel wat wondermooie natuur! Deze zone speelt een belangrijke rol in het natuurlijke evenwicht van Brussel, door de watergebieden, de bosjes, de velden en de biodiversiteit, maar ook als voedsel voor Brussel.\r\n\r\nNiet voor niets ontstaan hier allerlei nieuwe initiatieven van jonge stadsmensen, die gaan voor agro-ecologische landbouw in volle grond. Ontdek deze zone, zijn biodiversiteit, zijn projecten en uitdagingen, en het belang van een goed evenwicht tussen landbouw en natuur.\r\n\r\nHOE GA JE OP SCHATTENJACHT?\r\nDe jacht is 100% gratis !\r\n\r\nOm mee te doen installeer je de de TOTEMUS-app op je smartphone en je zoekt de de wandeling in Neerpede \u201cBrusselse kost, tussen stad en platteland.\u201d Veel plezier!","performers":null,"boxoffice_url":null,"website":null,"email":"info@mvb.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.523499"},"en":{"name":"Feeding Brussels, between city and countryside","shortdescr":"Discover nature and sustainable agriculture in Neerpede (Anderlecht), through a treasure hunt, guided by your smartphone.","longdescr":"Do you know the Neerpede area in Anderlecht? An area full of natural resources! This area is essential for the balance of the city, thanks to its aquatic environments, its wooded areas, its fields and its biodiversity, but also for \"feeding  Brussels\". It is not for nothing that new initiatives by young urbanites, who are embarking on agro-ecological farming, are emerging here.\r\nDiscover this territory, its biodiversity, its projects & challenges and the importance of a good balance between agriculture and nature.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.523499"},"de":{"name":"Brusselse kost, tussen stad en platteland","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.523499"},"it":{"name":"Brusselse kost, tussen stad en platteland","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.523499"},"sp":{"name":"Brusselse kost, tussen stad en platteland","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.523499"},"pt":{"name":"Brusselse kost, tussen stad en platteland","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.523499"},"cn":{"name":"Brusselse kost, tussen stad en platteland","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.523499"}},"place":{"id":252090,"translations":{"fr":{"name":"Maison Verte et Bleue","address_street_name":"Rue du Chaudron","address_street_number":"1","address_street_box":null,"email":"maisonverteetbleue@gmail.com","website":"http:\/\/www.maisonverteetbleue.be","phone_contact":"+32 484 11 93 56","phone_booking":"+32 484 11 93 56","address_zip