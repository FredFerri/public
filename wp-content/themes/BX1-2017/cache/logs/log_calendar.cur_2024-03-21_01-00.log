nstellingen"}},"others":{"list":[39,36],"translations":{"de":["Fotografie","Museen & Kunstzentren"],"pt":[null,null],"en":["Photography","Museums and art centers"],"it":["Fotografia","Musei e centri artistici"],"cn":[null,null],"fr":["Photographie","Mus\u00e9es et art centers"],"sp":["Fotograf\u00eda","Museos y centros de arte"],"nl":["Fotografie","Musea en kunstcentra"]}}},"translations":{"de":{"name":"Expo photo \"Valse imaginaire\" de Carole Touati","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.parlementfrancophone.brussels\/activites\/evenements\/expositions\/expos-photo-2023-2024\/expo-photo-de-carole-touati-mars-2024","email":"relpub@parlementfrancophone.brussels","phone_contact":"+32 2 504 96 21","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50008188"},"pt":{"name":"Expo photo \"Valse imaginaire\" de Carole Touati","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.parlementfrancophone.brussels\/activites\/evenements\/expositions\/expos-photo-2023-2024\/expo-photo-de-carole-touati-mars-2024","email":"relpub@parlementfrancophone.brussels","phone_contact":"+32 2 504 96 21","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50008188"},"en":{"name":"\"Valse imaginaire\" de Carole Touati","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.parlementfrancophone.brussels\/activites\/evenements\/expositions\/expos-photo-2023-2024\/expo-photo-de-carole-touati-mars-2024","email":"relpub@parlementfrancophone.brussels","phone_contact":"+32 2 504 96 21","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50008188"},"it":{"name":"Expo photo \"Valse imaginaire\" de Carole Touati","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.parlementfrancophone.brussels\/activites\/evenements\/expositions\/expos-photo-2023-2024\/expo-photo-de-carole-touati-mars-2024","email":"relpub@parlementfrancophone.brussels","phone_contact":"+32 2 504 96 21","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50008188"},"cn":{"name":"Expo photo \"Valse imaginaire\" de Carole Touati","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.parlementfrancophone.brussels\/activites\/evenements\/expositions\/expos-photo-2023-2024\/expo-photo-de-carole-touati-mars-2024","email":"relpub@parlementfrancophone.brussels","phone_contact":"+32 2 504 96 21","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50008188"},"fr":{"name":"\"Valse imaginaire\" de Carole Touati","shortdescr":"La d\u00e9marche photographique de Carole Touati est de montrer ce que l\u2019\u0153il per\u00e7oit, sans le voir. Elle se laisse guider par la g\u00e9om\u00e9trie, les lignes et les courbes mettant en lumi\u00e8re le formidable travail des architectes. Par ses photographies, Carole nous offre un monde de perspectives o\u00f9 l\u2019effet du visuel trompe l\u2019esprit et l\u2019\u0153il.","longdescr":"La d\u00e9marche photographique de Carole Touati est de montrer ce que l\u2019\u0153il per\u00e7oit, sans le voir. Elle se laisse guider par la g\u00e9om\u00e9trie, les lignes et les courbes mettant en lumi\u00e8re le formidable travail des architectes. Par ses photographies, Carole nous offre un monde de perspectives o\u00f9 l\u2019effet du visuel trompe l\u2019esprit et l\u2019\u0153il.\n\nSouvent constitu\u00e9es de plans serr\u00e9s, ses compositions se focalisent sur un d\u00e9tail, une r\u00e9p\u00e9tition de motifs, des effets d\u2019optique et des couleurs. Ces \u00e9l\u00e9ments ainsi pr\u00e9sent\u00e9s s\u2019harmonisent comme une musique o\u00f9 chaque instrument est \u00e0 sa place, irrempla\u00e7able.\n\nAinsi, tout en respectant leur travail, elle souhaite transporter les cr\u00e9ations des architectes vers un univers o\u00f9 po\u00e9sie et imaginaire font oublier l\u2019objet et le concret. \n\nLa s\u00e9rie propos\u00e9e est constitu\u00e9e des vues authentiques de notre environnement architectural. Carole n\u2019a recours \u00e0 aucune manipulation lors de la prise de vue ou du d\u00e9veloppement. Ses axes de cr\u00e9ation sont uniquement le reflet de son travail sur les cadrages, la lumi\u00e8re, les contrastes et les teintes.\n\nExpo \u00e0 voir au Parlement francophone bruxellois du 13 mars au 5 avril, du lundi au vendredi, de 10h \u00e0 16h30 (entr\u00e9e par le 69, rue du Lombard) ou en ligne : https:\/\/www.parlementfrancophone.brussels\/expo-virtuelle-mars2024 ","performers":"Carole Touati","boxoffice_url":null,"website":"https:\/\/www.parlementfrancophone.brussels\/activites\/evenements\/expositions\/expos-photo-2023-2024\/expo-photo-de-carole-touati-mars-2024","email":"relpub@parlementfrancophone.brussels","phone_contact":"+32 2 504 96 21","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50008188"},"sp":{"name":"Expo photo \"Valse imaginaire\" de Carole Touati","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.parlementfrancophone.brussels\/activites\/evenements\/expositions\/expos-photo-2023-2024\/expo-photo-de-carole-touati-mars-2024","email":"relpub@parlementfrancophone.brussels","phone_contact":"+32 2 504 96 21","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50008188"},"nl":{"name":"\"Valse imaginaire\" de Carole Touati","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.parlementfrancophone.brussels\/activites\/evenements\/expositions\/expos-photo-2023-2024\/expo-photo-de-carole-touati-mars-2024","email":"relpub@parlementfrancophone.brussels","phone_contact":"+32 2 504 96 21"