rel, magiciens, danseurs, acteurs,...\r\n- Itin\u00e9raires sur mesure: Art Nouveau, Anvers \u00e0 la mode, hommage \u00e0 Brel, Brussels by night, Bi\u00e8re et Chocolat, Bruxelles insolite, Simenon et Maigret, Atelier mode, design, Le Gay Bruxelles, \"Qui a tu\u00e9...\", Bruxelles durable.\r\n\r\nSur Bruxelles et toute la Belgique. Nous r\u00e9pondons sur mesure et \u00e0 la demande.\r\nNotre Equipe:\r\n- 4 professionnels pour s'assurer que votre programme atteigne vos objectifs et d\u00e9passe les attentes de vos clients.\r\n- 200 guides multilingues, acteurs, coordinateurs, hotesses,... sp\u00e9cialis\u00e9s dans la mise \u00e0 l'honneur de la Belgique et ses tr\u00e9sors cach\u00e9s.\r\n- 7 jours sur 7\r\n- Notre objectif: vivre l'Art comme un Art de Vivre.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Itin\u00e9raires","address_street_name":"Rue de l'Aqueduc","address_street_number":"171","address_street_box":null,"email":"info@itineraires.be","website":"http:\/\/www.itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de l'Aqueduc, 171","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Itin\u00e9raires","address_street_name":"Waterleidingsstraat","address_street_number":"171","address_street_box":null,"email":"info@itineraires.be","website":"http:\/\/www.itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"Waterleidingsstraat, 171","address_line2":"1050 Elsene","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":824,"location":{"lat":50.82309922,"lon":4.36268486},"last_up