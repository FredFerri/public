ll,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.moulindevere.be","email":"mbma-bmmv@evere.brussels","phone_contact":"+32 2 245 37 79","phone_booking":"+32 2 245 37 79","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50002989"},"en":{"name":"Forever Bread - du grain au pain","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.moulindevere.be","email":"mbma-bmmv@evere.brussels","phone_contact":"+32 2 245 37 79","phone_booking":"+32 2 245 37 79","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50002989"},"it":{"name":"Forever Bread - du grain au pain","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.moulindevere.be","email":"mbma-bmmv@evere.brussels","phone_contact":"+32 2 245 37 79","phone_booking":"+32 2 245 37 79","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50002989"},"cn":{"name":"Forever Bread - du grain au pain","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.moulindevere.be","email":"mbma-bmmv@evere.brussels","phone_contact":"+32 2 245 37 79","phone_booking":"+32 2 245 37 79","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50002989"},"fr":{"name":"Forever Bread - Du grain au pain","shortdescr":null,"longdescr":"Clef de vo\u00fbte de l\u2019alimentation humaine, les c\u00e9r\u00e9ales sont cultiv\u00e9es depuis la naissance de l\u2019agriculture. De tous temps, garantir leur production et leur approvisionnement sont donc des enjeux majeurs pour notre survie. Parmi les produits c\u00e9r\u00e9aliers, le pain est une pr\u00e9paration ancestrale qui constitue encore aujourd\u2019hui l\u2019aliment de base par excellence pour de nombreuses personnes dans le monde. \nL\u2019exposition Forever Bread retrace l\u2019\u00e9volution de la fili\u00e8re du grain au pain et d\u00e9voile les coulisses de sa fabrication, de la s\u00e9lection des graines \u00e0 l\u2019atelier du boulanger.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.moulindevere.be","email":"mbma-bmmv@evere.brussels","phone_contact":"+32 2 245 37 79","phone_booking":"+32 2 245 37 79","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50002989"},"sp":{"name":"Forever Bread - du grain au pain","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.moulindevere.be","email":"mbma-bmmv@evere.brussels","phone_contact":"+32 2 245 37 79","phone_booking":"+32 2 245 37 79","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50002989"},"nl":{"name":"Forever Bread - Van graan tot brood","shortdescr":null,"longdescr":"Graangewassen zijn de hoeksteen van de menselijke voeding en worden sinds het ontstaan van de landbouw geteeld. De pro\u0002ductie en bevoorrading ervan garanderen, is dus altijd al een belangrijke uitdaging geweest voor onze overleving. Brood, een van de afgeleide producten van graan, werd reeds door onze voorouders bereid en is vandaag nog steeds het basisvoedingsmiddel bij uitstek voor veel mensen wereldwijd. De tentoonstelling Forever Bread beschrijft hoe we van graan tot brood zijn gekomen en neemt ons mee achter de schermen van het productieproces van brood, van de selectie van de graankorrels tot de werkplaats van de bakker. ","performers":null,"boxoffice_url":null,"website":"http:\/\/www.molenevere.be","email":"mbma-bmmv@evere.brussels","phone_contact":"+32 2 245 37 79","phone_booking":"+32 2 245 37 79","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50002989"}},"place":{"last_updated_at":"2023-04-13T11:46:19+02:00","published_at":"2013-10-19T01:25:45+02:00","id":247056,"translations":{"de":{"name":"Mus\u00e9e Bruxellois du Moulin et de l'Alimentation","address_street_name":"Rue du Moulin \u00e0 Vent","address_street_number":"21","address_street_box":null,"email