dit\u00e9e et touche en plein c\u0153ur ses lecteurs. Aujourd\u2019hui, Fran monte sur sc\u00e8ne pour la partager au plus grand nombre.","performers":"De et avec: Fran Kourouma\r\nMise en sc\u00e8ne: Sandra Raco","boxoffice_url":null,"website":"http:\/\/www.bruxellons.be","email":"info@bruxelllons.net","phone_contact":"+32 2 724 24 24","phone_booking":"+32 2 724 24 24","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.556028"},"nl":{"name":"Notre soleil","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.bruxellons.be","email":"info@bruxelllons.net","phone_contact":"+32 2 724 24 24","phone_booking":"+32 2 724 24 24","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.556028"},"en":{"name":"Notre soleil","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.bruxellons.be","email":"info@bruxelllons.net","phone_contact":"+32 2 724 24 24","phone_booking":"+32 2 724 24 24","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.556028"},"de":{"name":"Notre soleil","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.bruxellons.be","email":"info@bruxelllons.net","phone_contact":"+32 2 724 24 24","phone_booking":"+32 2 724 24 24","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.556028"},"it":{"name":"Notre soleil","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.bruxellons.be","email":"info@bruxelllons.net","phone_contact":"+32 2 724 24 24","phone_booking":"+32 2 724 24 24","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.556028"},"sp":{"name":"Notre soleil","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.bruxellons.be","email":"info@bruxelllons.net","phone_contact":"+32 2 724 24 24","phone_booking":"+32 2 724 24 24","agenda