0"],"cn":["monday, tuesday and sunday: closed","wednesday, thursday and friday: from 09:30 to 17:00","saturday: from 11:00 to 19:00"]},"date_start":"2023-07-01","date_end":"2023-07-31","is_also_by_appointment":false}],"prices":[{"translations":{"fr":{"name":"Enfants"},"nl":{"name":"Kinderen"},"en":{"name":"Children"},"de":{"name":"Kinder"},"it":{"name":"Bambini"},"sp":{"name":"Ni\u00f1os"},"pt":{"name":"Enfants"},"cn":{"name":"Enfants"}},"value":4},{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"},"de":{"name":"Normal"},"it":{"name":"Normale"},"sp":{"name":"Normal"},"pt":{"name":"Normal"},"cn":{"name":"Normal"}},"value":10},{"translations":{"fr":{"name":"Seniors"},"nl":{"name":"Senioren"},"en":{"name":"Seniors"},"de":{"name":"Senioren"},"it":{"name":"Anziani"},"sp":{"name":"Mayores"},"pt":{"name":"Seniors"},"cn":{"name":"Seniors"}},"value":8}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-07-08T03:07:12+02:00","published_at":"2023-05-30T15:26:55+02:00","backoffice_id":277957,"import_origin":null,"sub_type":"other","show_in_agenda":true,"ranking":0.40107239119072},{"id":555630,"date_start":"2023-04-25","date_end":"2023-08-27","date_next":"2023-07-08","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung","it":"Esposizioni","sp":"Exhibici\u00f3n","pt":null,"cn":null}},"others":{"list":[36,47],"translations":{"fr":["Mus\u00e9es et art centers","Bande dessin\u00e9e"],"nl":["Musea en kunstcentra","Stripverhaal"],"en":["Museums and art centers","Comicstrip"],"de":["Museen & Kunstzentren","Comics"],"it":["Musei e centri artistici","Fumetti"],"sp":["Museos y centros de arte","C\u00f3mics"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Quintanilhisme : chroniques visuelles du Br\u00e9sil","shortdescr":null,"longdescr":"Qualifi\u00e9 au Br\u00e9sil de \u00ab chroniqueur visuel \u00bb, Marcello Quintanilha s\u2019inspire du r\u00e9el pour mettre en sc\u00e8ne des histoires fortes. Rio, Niteroi, Salvador de Bahia ou Sao Paulo servent de cadre \u00e0 ses r\u00e9cits r\u00e9alistes, dans lesquels il soigne les d\u00e9tails, les ambiances sonores et les dialogues. \u00c0 chaque album, il change de technique, alterne les registres, varie les cadrages et revisite les codes de la bande dessin\u00e9e. Li\u00e9s les uns aux autres, les protagonistes sont souvent confront\u00e9s \u00e0 une situation qui d\u00e9g\u00e9n\u00e8re. Entre action, introspection, peur, col\u00e8re, mais aussi entraide, amour et amiti\u00e9, l\u2019auteur m\u00eale les \u00e9motions et bouscule les lecteurs dans un r\u00e9cit qui va crescendo. Selon lui, cette tension toujours pr\u00e9sente fait \u00e9cho \u00e0 celle de la vie quotidienne au Br\u00e9sil. L\u2019auteur met en sc\u00e8ne des personnages marquants dont il affine la psychologie pour mieux raconter le pays qu\u2019il a connu et qu\u2019il porte en lui. Traduits en plusieurs langues, ses r\u00e9cits transmettent l\u2019\u00e2me d\u2019une soci\u00e9t\u00e9 multiculturelle, mais d\u00e9noncent \u00e9galement les disparit\u00e9s sociales du pays et ses in\u00e9galit\u00e9s. Une humanit\u00e9 poignante qui fait de Marcello Quintanilha un auteur contemporain incontournable et qui rend son \u0153uvre universelle.\r\nM\u00e9lanie Andrieu, Centre Belge de la Bande Dessin\u00e9e\r\n\r\nAvec le soutien de la R\u00e9gion de Bruxelles-Capitale\r\nEn collaboration avec les \u00e9ditions \u00c7\u00e0 et L\u00e0\r\nToutes les images \u00a9 \u00c7\u00e0 et L\u00e0 2022","performers":null,"boxoffice_url":null,"website":"http:\/\/www.cbbd.be","email":"visit@cbbd.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.555630"},"nl":{"name":"Quintanilha: visuele kronieken van Brazili\u00eb","shortdescr":null,"longdescr":"Marcello Quintanilha, in Brazili\u00eb omschreven als een \"visuele verhalenverteller\", laat zich inspireren door de werkelijkheid om krachtige verhalen te bedenken. Rio, Niteroi, Salvador de Bahia of Sao Paulo vormen het decor voor zijn realistische verhalen, waarin hij aandacht besteedt aan details, soundscapes en dialogen. In elk album verandert hij van techniek, wisselt hij registers af, varieert hij de kadrering en herschrijft hij de codes voor de creatie van een stripverhaal. De protagonisten zijn verbonden met elkaar en worden vaak geconfronteerd met een situatie die ontspoort. Quintanilha neemt zijn lezers mee op een reis vol gemengde emoties, actie, introspectie, angst en woede, maar ook van solidariteit, liefde en vriendschap en dompelt zijn lezers zo onder in een verhaal dat crescendo-gewijs opbouwt. Deze altijd aanwezige spanning weerspiegelt volgens hem die van het dagelijks leven in Brazili\u00eb. Quintanilha voert markante personages op waarvan hij de psychologie verfijnt om het verhaal van zijn land, het land dat hij gekend heeft en in hem zit, beter te kunnen vertellen. Zijn verhalen, die ondertussen in verschillende talen vertaald werden, tonen de ziel van een multiculturele samenleving, maar stellen ook de sociale kloof en de ongelijkheid in het land aan de kaak. Een aangrijpende menselijkheid die van Marcello Quintanilha een essenti\u00eble hedendaagse auteur maakt en die zijn werk universeel maakt.\r\n\r\nM\u00e9lanie Andrieu, Stripmuseum\r\n\r\nMet de steun van het Brussels Hoofdstedelijk Gewest \r\nIn samenwerking met Uitgeverij \u00c7\u00e0 et L\u00e0\r\nAlle afbeeldingen \u00a9 \u00c7\u00e0 et L\u00e0 2022","performers":null,"boxoffice_url":null,"website":"http:\/\/www.stripmuseum.be","email":"visit@stripmuseum.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.555630"},"en":{"name":"Quintanilha: visual chronicles of Brazil","shortdescr":null,"longdescr":"Marcello Quintanilha, described in Brazil as a \"visual storyteller\", draws inspiration from reality to create powerful stories. Rio, Niteroi, Salvador de Bahia or Sao Paulo are the setting for his realistic stories, in which he pays attention to details, soundscapes and dialogues. In each album, he changes technique, alternates register, varies framing and revisits the common codes of the comic genre. The protagonists are connected and often face a situation that escalates. Between action, introspection, fear, anger, but also mutual aid, love and friendship, Quintanilha mixes emotions and shakes the readers in a story that goes to a crescendo. This ever-present tension, he says, mirrors that of everyday life in Brazil. Quintanilha introduces striking characters whose psychology he refines in order to improve telling the story of the country he has known and carries within him. His stories, translated into several languages, show the soul of a multicultural society, but also expose the country's social inequalities and inequities. A poignant humanity that makes Marcello Quintanilha an essential contemporary author and makes his work universal.\r\n\r\nM\u00e9lanie Andrieu, Comics Art Museum\r\n\r\nWith the support of Brussels-Capital Region\r\nIn collaboration with publisher \u00c7\u00e0 et L\u00e0\r\nAll rights reserved \u00a9 \u00c7\u00e0 et L\u00e0 2022","performers":null,"boxoffice_url":null,"website":"http:\/\/www.comicscenter.net\/en\/home","email":"visit@comicscenter.net","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.555630"},"de":{"name":"Quintanilha: visuele kronieken van Brazili\u00eb","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.cbbd.be","email":"visit@cbbd.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.555630"},"it":{"name":"Quintanilha: visuele kronieken van Brazili\u00eb","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.cbbd.be","email":"visit@cbbd.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.555630"},"sp":{"name":"Quintanilha: visuele kronieken van Brazili\u00eb","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.cbbd.be","email":"visit@cbbd.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.555630"},"pt":{"name":"Quintanilha: visuele kronieken van Brazili\u00eb","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.cbbd.be","email":"visit@cbbd.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.555630"},"cn":{"name":"Quintanilha: visuele kronieken van Brazili\u00eb","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.cbbd.be","email":"visit@cbbd.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.555630"}},"place":{"id":202864,"translations":{"fr":{"name":"Mus\u00e9e de la Bande Dessin\u00e9e (Centre Belge de la Bande Dessin\u00e9e)","address_street_name":"Rue des Sables","address_street_number":"20","address_street_box":null,"email":"visit@cbbd.be","website":"http:\/\/www.cbbd.be","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Sables, 20","address_line2":"1000 Bruxelles","description_web":"Un monde merveilleux o\u00f9 la BD est Reine\r\nAttraction incontournable situ\u00e9e au c\u0153ur de Bruxelles, le mus\u00e9e de la BD met \u00e0 l'honneur le 9e Art depuis plus de 30 ans.\r\nLes expositions permanentes r\u00e9guli\u00e8rement renouvel\u00e9es et un vaste programme d'expositions temporaires am\u00e8nent les visiteurs \r\n\u00e0 d\u00e9couvrir les innombrables facettes de la bande dessin\u00e9e. Les Schtroumpfs ouvrent la voie vers d'autres aventures, \u00e0 la rencontre d'un monde dont la cr\u00e9ativit\u00e9 n'a aucune limite.\r\nDe nombreuses planches originales, des documents in\u00e9dits, des reconstitutions 3D et des jeux sont ainsi rassembl\u00e9s pour vous permettre de passer un bon moment \r\net ravir tous les amateurs et passionn\u00e9s du Neuvi\u00e8me Art de tous \u00e2ges. La dur\u00e9e de la visite est estim\u00e9e \u00e0 environ 1 heure 30, que vous pourrez ensuite poursuivre \u00e0 la Brasserie Horta.\r\nMagnifi\u00e9 par un exceptionnel cadre Art Nouveau con\u00e7u par Victor Horta, le Mus\u00e9e de la Bande Dessin\u00e9e est tout autant un hommage aux pionniers qu'un regard sur la BD actuelle.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Stripmuseum (Belgisch Stripcentrum)","address_street_name":"Zandstraat","address_street_number":"20","address_street_box":null,"email":"visit@stripmuseum.be","website":"http:\/\/www.stripmuseum.be","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Zandstraat, 20","address_line2":"1000 Brussel","description_web":"Een wondere wereld vol strips\r\n\r\nHet Stripmuseum is een ontmoetingsplek voor alle stripliefhebbers in hartje Brussel.\r\nAan de hand van permanente tentoonstellingen \u2013 die regelmatig vernieuwd worden \u2013 en een afwisselend programma van tijdelijke expo's kan je er \r\nals bezoeker kennismaken met de talrijke facetten van het stripverhaal.\r\nDe Smurfen nemen je mee naar een land vol avonturen, waar de creativiteit geen grenzen kent.\r\nTalrijke originele platen, nooit eerder geziene documenten, decors in 3D en ludieke elementen worden verzameld \r\nom alle fans en liefhebbers van de Negende Kunst te kunnen boeien!\r\nHet uitzonderlijke art nouveau-gebouw van Victor Horta geeft een bezoek nog een extra dimensie. \r\nHet Stripmuseum brengt tegelijk een hommage aan de klassiekers van het medium en een blik op het hedendaagse stripverhaal.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Comic Strip Museum  (Centre Belge de la Bande Dessin\u00e9e)","address_street_name":"Rue des Sables","address_street_number":"20","address_street_box":null,"email":"visit@comicscenter.net","website":"http:\/\/www.comicscenter.net\/en\/home","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue des Sables, 20","address_line2":"1000 Brussels","description_web":"A world full of comics\r\n\r\nAn accomplished attraction located in the heart of Brussels, the Comics Art Museum has been honouring the creators and heroes of the 9th Art for 30 years.\r\nThe regularly renewed permanent exhibitions and a diversified programme of temporary exhibitions \r\nenable visitors to discover the countless aspects of comics art. \r\nFamous characters lead the way towards new adventures, an encounter with a world where creativity has no limits.\r\nEnhanced by an exceptional Art Nouveau home designed by Victor Horta, the Comics Art Museum is just as much a tribute \r\nto the pioneers as a glimpse of contemporary comics art.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Comic-Museum (Centre Belge de la Bande Dessin\u00e9e)","address_street_name":"Rue des Sables","address_street_number":"20","address_street_box":null,"email":"visit@cbbd.be","website":"https:\/\/www.comicscenter.net\/en\/other-languages","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Sables, 20","address_line2":"1000 Bruxelles","description_web":"Br\u00fcssel als Comic-Hauptstadt g\u00f6nnt sich den Luxus eines eigenen Comic-Museums - das \u201eCentre Belge de la Bande Dessin\u00e9e\u201c. In einem eindrucksvollen Jugendstil-Bau aus der Feder von Victor Horta wird belgische und internationale Comic-Kunst pr\u00e4sentiert. Willkommen im Reich der Schl\u00fcmpfe, bei Tim und Struppi, Lucky Luke, Spirou, Gaston Lagaffe und all den anderen Comic-Helden!\r\n\r\nComic-Kunst und Jugendstilarchitektur: Der ber\u00fchmte Jugendstilarchitekt Victor Horta entwarf 1903, auf dem H\u00f6hepunkt seines Schaffens, Pl\u00e4ne f\u00fcr ein weitl\u00e4ufiges Bauwerk in Br\u00fcssel. Nach der Renovierung 1989 lie\u00df sich in den R\u00e4umen, die in allen Bereichen durch Jugendstilelemente gepr\u00e4gt sind, das \u201eCentre Belge de la Bande Dessin\u00e9e\", das Belgische Comiczentrum nieder, bei dem sich auf einer Fl\u00e4che von mehr als 4000 m\u00b2 - von den Urspr\u00fcngen bis hin zu avantgardistischen Werken - alles um Comics dreht.\r\n\r\nBelgische Comic-Kunst in all ihren Formen: Ausstellungen, Konferenzen, Kreativ-Workshops, Veranstaltungen, eine eigene Comic-Bibliothek mit Dokumentationszentrum sowie eine gut sortierte Buchhandlung bilden ein vielseitiges und buntes Comicangebot. Zentrale Themen der Dauerausstellung sind die Erfindung der Comic-Kunst, die Formen und die Entwicklung der Comic-Kunst sowie verschiedene Schwerpunkt auf belgische Comic-K\u00fcnstler von Peyo, dem Vater der Schl\u00fcmpfe bis Herg\u00e9, dem Erfinder von Tim & Struppi.\r\n\r\nComic-Fans auf zum Br\u00fcsseler Comic-Mekka!\r\n\r\nGe\u00f6ffnet von Montag bis Sonntag in Juli und August.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Museo del Fumetto","address_street_name":"Rue des Sables","address_street_number":"20","address_street_box":null,"email":"visit@comicscenter.net","website":"https:\/\/www.comicscenter.net\/en\/other-languages","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Sables, 20","address_line2":"1000 Bruxelles","description_web":"Il Museo del Fumetto CBBD, situato nel cuore storico di Bruxelles, riunisce su pi\u00f9 di 4.000 m\u00b2 tutto ci\u00f2 che riguarda il fumetto. Ospitato in un edificio tempio dell'Art Nouveau disegnato da Victor Horta, il museo \u00e8 il regno di celebri eroi dei fumetti belgi: Tintin, i Puffi, Lucky Luke, Gaston Lagaffe, Blake et Mortimer, Marsupilami... Le esposizioni organizzate, la biblioteca e il centro di documentazione, non solo rendono il museo vivo e dinamico, ma sono veri e propri centri di documentazione sul fumetto il cuicatalogo \u00e8 accessibile on-line. Il centro belga del fumetto organizza conferenze, laboratori creativi ed animazioni, ecc.\r\n\r\n\r\nAperto i giorni festivi eccetto il 25\/12 e 01\/01. Il Centro Belga del Fumetto diverse formule di visita: la visita guidata del museo, quella del Percorso del Fumetto o quella del museo Marc Sleen. Il museo, anzi il centro belga del fumetto-CBBD ospita anche una brasserie dove potete respirare l'inconfondibile atmosfera di Bruxelles.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Centro belga del c\u00f3mic (CBBD)","address_street_name":"Rue des Sables","address_street_number":"20","address_street_box":null,"email":"visit@comicscenter.net","website":"https:\/\/www.comicscenter.net\/en\/other-languages","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Sables, 20","address_line2":"1000 Bruxelles","description_web":"Ubicado en el centro de Bruselas, en un edificio Art Nouveau construido por Victor Horta en 1906, el CBBD abri\u00f3 sus puertas el 6 de octubre de 1989. \r\n\r\nEn pocos a\u00f1os, este museo se ha convertido en una de las principales atracciones de Bruselas. \r\n\r\nCada a\u00f1o, m\u00e1s de 200.000 visitantes recorren las exposiciones permanentes y temporales que se celebran en m\u00e1s de 4.000 m 2. \r\n\r\nAunque las exposiciones contribuyen a convertir este templo en un lugar viviente, din\u00e1mico y atrayente, esta herramienta al servicio de la promoci\u00f3n del c\u00f3mic constituye un centro de documentaci\u00f3n moderno, con un cat\u00e1logo accesible online. \r\n\r\nTambi\u00e9n se llevan a cabo conferencias y talleres creativos.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"O Centro Belga da Banda Desenhada","address_street_name":"Rue des Sables","address_street_number":"20","address_street_box":null,"email":"visit@cbbd.be","website":"http:\/\/www.cbbd.be","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Sables, 20","address_line2":"1000 Bruxelles","description_web":"Atra\u00e7\u00e3o incontorn\u00e1vel situada no centro de Bruxelas, o museu da BD comemora mais de 25 anos de autores e her\u00f3is da 9.\u00aa arte.\r\nAs exposi\u00e7\u00f5es permanentes regularmente renovadas e um vasto programa de exposi\u00e7\u00f5es tempor\u00e1rias levam os visitantes a descobrir as in\u00fameras facetas da banda desenhada. Tintim e os Estrumpfes abrem a porta a outras aventuras, ao encontro de um mundo onde a criatividade n\u00e3o tem limites. \r\nAmpliado por uma moldura invulgar Arte Nouveau concebida por Victor Horta, o Museu da Banda Desenhada \u00e9 tanto uma homenagem aos pioneiros que um olhar sobre a BD atual.\r\nAberto todos os dias das 10 \u00e0s 18 horas.\r\nEntrada gratuita apenas com o Brussels Card \u201c100masters\u201d","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"The Belgian Comic Strip Center","address_street_name":"Rue des Sables","address_street_number":"20","address_street_box":null,"email":"visit@cbbd.be","website":"http:\/\/www.cbbd.be","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Sables, 20","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":[],"zones":{"list":[19],"translations":{"fr":["Centre"],"nl":["Centrum"],"en":["Centre"],"de":["Zentrum"],"it":["Centro"],"sp":["Centro"],"pt":[null],"cn":[null]}},"neca":null,"facebook_id":null,"backoffice_id":405,"location":{"lat":50.85107181,"lon":4.36006874},"region":"brussels","last_updated_at":"2023-07-08T03:06:00+02:00","published_at":"2013-10-19T01:13:30+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":202864,"translations":{"fr":{"name":"Mus\u00e9e de la Bande Dessin\u00e9e (Centre Belge de la Bande Dessin\u00e9e)","address_street_name":"Rue des Sables","address_street_number":"20","address_street_box":null,"email":"visit@cbbd.be","website":"http:\/\/www.cbbd.be","phone_contact":"+32 2 219 19 80","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Sables, 20","address_line2":"1000 Bruxelles","description_web":"Un monde merveilleux o\u00f9 la BD est Reine\r\nAttraction incontournable situ\u00e9e au c\u0153ur de Bruxelles, le mus\u00e9e de la BD met \u00e0 l'honneur le 9e Art depuis plus de 30 ans.\r\nLes expositions permanentes r\u00e9guli\u00e8rement renouvel\u00e9es et un vaste programme d'expositions temporaires am\u00e8nent les visiteurs \r\n\u00e0 d\u00e9couvrir les innombrables facettes de la bande dessin\u00e9e. Les Schtroumpfs ouvrent la voie vers d'autres aventures, \u00e0 la rencontre d'un monde dont la cr\u00e9ativit\u00e9 n'a aucune limite.\r\