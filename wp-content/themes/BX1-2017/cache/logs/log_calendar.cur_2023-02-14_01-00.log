"2023-02-17","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater","it":"Teatro","sp":"Teatro","pt":null,"cn":null}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"],"de":["Theater"],"it":["Teatro"],"sp":["Teatro"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"I Have A Million Reasons","shortdescr":"Une docufiction exclusive pour questionner et d\u00e9construire sans fard ce qui peut pousser \u00e0 en finir. Un spectacle utile qui sera suivi tous les soirs d'un bord plateau.","longdescr":"Notre spectacle est issu de cinq ann\u00e9es de recherches documentaires de terrain sur le suicide\r\nCes ann\u00e9es de r\u00e9flexions, d'interviews et de rencontres humaines approfondies ont donn\u00e9 naissance \u00e0 cette \u00ab docufiction \u00bb th\u00e9\u00e2trale. Trois com\u00e9dien\u00b7ne\u00b7s y abordent la d\u00e9licate question du suicide dans une mise en sc\u00e8ne kal\u00e9idoscopique o\u00f9 apparaissent et disparaissent des situations et des personnages ayant pour point commun d'avoir \u00ab un million de raisons \u00bb d'en finir.\r\nPeu \u00e0 peu, le r\u00e9el s'immisce sur le plateau. Des extraits d'interviews r\u00e9sonnent, et des personnes rencontr\u00e9es lors du travail de terrain rejoignant les com\u00e9dien\u00b7ne\u00b7s pour explorer, danser, et ressentent ensemble les \u00e9lans et pulsions de vie qui font partie des \u00ab\u00a0millions de raisons\u00a0\u00bb de vivre.\r\nV\u00e9ritable ode \u00e0 la vie, le spectacle \u00e9volue progressivement vers un mouvement d\u00e9bordant d'\u00e9nergie vitale, un d\u00e9sir r\u00e9solument optimiste dont nous vous pr\u00e9senterons \u00e0 \u00eatre t\u00e9moins, et que nous vous pr\u00e9senterons de prolonger chaque soir \u00e0 l'occasion d'une rencontre en bord plateau organis\u00e9 \u00e0 l'\u00e9mission de la repr\u00e9sentation.","performers":"Andr\u00e9s Cifuentes (mise en sc\u00e8ne)\r\nKatrien Pairoux (com\u00e9dienne) \r\nValentin Collard (com\u00e9dien)","boxoffice_url":null,"website":"https:\/\/lesrichesclaires.be\/","email":"administration@lesrichesclaires.be","phone_contact":"+32 2 548 25 80","phone_booking":"+32 2 548 25 80","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.550568"},"nl":{"name":"I Have A Million Reasons","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lesrichesclaires.be\/","email":"administration@lesrichesclaires.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.550568"},"en":{"name":"I Have A Million Reasons","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lesrichesclaires.be\/","email":"administration@lesrichesclaires.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.550568"},"de":{"name":"I Have A Million Reasons","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lesrichesclaires.be\/","email":"administration@lesrichesclaires.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.550568"},"it":{"name":"I Have A Million Reasons","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lesrichesclaires.be\/","email":"administration@lesrichesclaires.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.550568"},"sp":{"name":"I Have A 