10904,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"other","ranking":0.5,"languages":{"spoken":["en","fr","it"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[28,24],"translations":{"de":["Grafische K\u00fcnste","Kunstgalerien"],"pt":[null,null],"en":["Graphic art","Art Galleries"],"it":["Arti grafiche","Gallerie d'arte"],"cn":[null,null],"fr":["Arts graphiques","Galeries d'art"],"sp":["Artes gr\u00e1ficas","Galer\u00edas de arte"],"nl":["Grafische kunst, vormgeving","Galeries"]}}},"translations":{"de":{"name":"Opening of Emilie Kr\u00f6ger\u2019s exhibition, Catharsis at Kalamity Vintage","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.instagram.com\/kalamity_vintage\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700003284"},"pt":{"name":"Opening of Emilie Kr\u00f6ger\u2019s exhibition, Catharsis at Kalamity Vintage","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.instagram.com\/kalamity_vintage\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700003284"},"en":{"name":"Opening of Emilie Kr\u00f6ger\u2019s exhibition, Catharsis at Kalamity Vintage","shortdescr":"After a first collaborative exhibition in April 2024 in France (Exploria, Pornic), it is at Kalamity Vintage that the artist will present to the public the exhibition La Catharsis where she brings together her works in which exposure is essential.","longdescr":"After a first collaborative exhibition in April 2024 in France (Exploria, Pornic), it is at Kalamity Vintage that the artist will present to the public the exhibition La Catharsis where she brings together her works in which exposure is essential. \nThere we discover gardens steeped in harmony, soothing landscapes, nostalgic scenes of freedom in suspended moments; serene contemplation mixes with the sweetness of the blues and transports us into a state of docile wonder.\nEmilie, a spectator of (human?) nature, invites us to a gentle immersion in her deep blue, her own universe...\nLooking forward to meeting you there","performers":"Emilie Kr\u00f6ger is a Franco-German artist, recently settled in Brussels.\nKalamity Vintage is a second-hand clothing and object store that offers artists the opportunity to exhibit themselves.","boxoffice_url":null,"website":"https:\/\/www.instagram.com\/kalamity_vintage\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700003284"},"it":{"name":"Opening of Emilie Kr\u00f6ger\u2019s exhibition, Catharsis at Kalamity Vintage","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.instagram.com\/kalamity_vintage\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700003284"},"cn":{"name":"Opening of Emilie Kr\u00f6ger\u2019s exhibition, Catharsis at Kalamity Vintage","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.instagram.com\/kalamity_vintage\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700003284"},"fr":{"name":"Vernissage de l'exposition d'Emilie Kr\u00f6ger, la Catharsis chez Kalamity Vintage","shortdescr":"Apr\u00e8s une premi\u00e8re exposition collaborative en avril 2024 en France (Exploria, Pornic), c'est chez Kalamity Vintage que l'artiste pr\u00e9sentera au public l'exposition La Catharsis o\u00f9 elle rassemble ses \u0153uvres  dans lesquelles la mise \u00e0 nu est essentielle.","longdescr":"Apr\u00e8s une premi\u00e8re exposition collaborative en avril 2024 en France (Exploria, Pornic), c'est chez Kalamity Vintage que l'artiste pr\u00e9sentera au public l'exposition La Catharsis o\u00f9 elle rassemble ses \u0153uvres  dans lesquelles la mise \u00e0 nu est essentielle. \nOn y d\u00e9couvre des jardins p\u00e9tris d'harmonie, des paysage apaisants, des sc\u00e8nes nostalgiques de libert\u00e9s dans des moments suspendus; la contemplation sereine se m\u00eale \u00e0 la douceur du blues et nous transporte dans un \u00e9tat d'\u00e9merveillement docile.\nEmilie, spectatrice de la nature (humaine?), nous invite \u00e0 une immersion en douceur dans son grand bleu, son univers bien \u00e0 elle \u2026\nAu plaisir de vous y rencontrer","performers":"Emilie Kr\u00f6ger est une artiste franco-allemande, fra\u00eechement install\u00e9e \u00e0 Bruxelles.\nKalamity Vintage est une boutique de v\u00eatements et objets de seconde main qui offre aux artiste la possibilit\u00e9 de s'exposer.","boxoffice_url":null,"website":"https:\/\/www.instagram.com\/kalamity_vintage\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700003284"},"sp":{"name":"Opening of Emilie Kr\u00f6ger\u2019s exhibition, Catharsis at Kalamity Vintage","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.instagram.com\/kalamity_vintage\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700003284"},"nl":{"name":"Opening van de tentoonstelling van Emilie Kr\u00f6ger, Catharsis bij Kalamity Vintage","shortdescr":"Na een eerste gezamenlijke tentoonstelling in april 2024 in Frankrijk (Exploria, Pornic), zal de kunstenaar in Kalamity Vintage de tentoonstelling La Catharsis aan het publiek presenteren, waar ze haar werken samenbrengt waarin belichting essentieel is.","longdescr":"Na een eerste gezamenlijke tentoonstelling in april 2024 in Frankrijk (Exploria, Pornic), zal de kunstenaar in Kalamity Vintage de tentoonstelling La Catharsis aan het publiek presenteren, waar ze haar werken samenbrengt waarin belichting essentieel is. \nDaar ontdekken we tuinen vol harmonie, rustgevende landschappen, nostalgische taferelen van vrijheid in opgeschorte momenten; serene contemplatie vermengt zich met de zoetheid van de blues en brengt ons in een staat van volgzame verwondering.\nEmilie, toeschouwer van de (menselijke?) natuur, nodigt ons uit voor een zachte onderdompeling in haar diepe blauw, haar eigen universum...\nIk kijk ernaar uit u daar te ontmoeten","performers":"Emilie Kr\u00f6ger is een Frans-Duitse kunstenaar, onlangs gevestigd in Brussel.\nKalamity Vintage is een tweedehands kleding- en voorwerpenwinkel die kunstenaars de mogelijkheid biedt zichzelf te exposeren.","boxoffice_url":null,"website":"https:\/\/www.instagram.com\/kalamity_vintage\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700003284"}},"place":{"id":275938,"translations":{"de":{"name":"Quartier du Rideau","address_street_name":"du coll\u00e8ge","address_street_number":"24","address_street_box":null,"email":null,"website":"https:\/\/www.instagram.com\/kalamity_vintage\/","phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"du coll\u00e8ge, 24","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Quartier du Rideau","address_street_name":"du coll\u00e8ge","address_street_number":"24","address_street_box":null,"email":null,"website":"https:\/\/www.instagram.com\/kalamity_vintage\/","phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"du coll\u00e8ge, 24","address_