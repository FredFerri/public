:00","start":"20:30:00","end":null,"is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":18},{"translations":{"fr":{"name":"Etudiants"},"nl":{"name":"Studenten"},"en":{"name":"Students"}},"value":15},{"translations":{"fr":{"name":"Seniors"},"nl":{"name":"Senioren"},"en":{"name":"Seniors"}},"value":15},{"translations":{"fr":{"name":"Demandeurs d'emploi"},"nl":{"name":"Werkzoekenden"},"en":{"name":"Job seekers"}},"value":15}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-11T03:06:35+02:00","published_at":"2022-07-14T15:42:19+02:00","backoffice_id":258429,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":0.8735804647363},{"id":536505,"date_start":"2022-10-20","date_end":"2022-10-29","date_next":"2022-10-20","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater"}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"],"de":["Theater"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Courir Nager Sauter Plonger","shortdescr":"Tant qu\u2019on court on vit. Tant qu\u2019on nage on vit. Tant qu\u2019on saute (sauf sur une bombe) on vit\u00a0!  Alors, tant qu\u2019on vit on peut sauter le pas et \u00e9crire un texte et le jouer\u2026 m\u00eame seule\u2026 m\u00eame si on doute, on peut plonger dans un spectacle o\u00f9 la No\u00ebl, la famille, le deuil\u00a0s\u2019entrem\u00ealent... Et tant qu'on vit, on va au th\u00e9\u00e2tre...","longdescr":"\u201cAvec cette succession d\u2019histoires courtes, Pascale Vander Zypen frappe juste, suscite les rires autant que l\u2019\u00e9motion, chaque \u00e9pisode trouvant un \u00e9cho chez chacun des spectateurs.\u201d Jean-Marie Wynants, Le Soir. Alors, tant qu\u2019on vit on peut sauter le pas et \u00e9crire un texte et le jouer\u2026 m\u00eame seule\u2026 m\u00eame si on doute, on peut plonger dans un spectacle o\u00f9 la No\u00ebl, la famille, le deuil\u00a0s\u2019entrem\u00ealent\u00a0et toutes ces petites choses qui font qu'on se ressemble... : les rites du 24 d\u00e9cembre, J\u00e9sus h\u00e9site \u00e0 venir au monde, le r\u00e9veillon des employ\u00e9s M\u00e9nart et Joblin, la douleur de M\u00e9d\u00e9e abandonn\u00e9e, Annie sur la tombe de Monique, Bouly le hamster mort et ses questions existentielles\u00a0: \u00e0 qui est-ce que je vais l\u00e9guer ma cage, l\u2019enterrement imaginaire, la chatte fant\u00f4me qui d\u00e9fend le droit \u00e0 l\u2019euthanasie pour les animaux\u2026 Des s\u00e9quences de com\u00e9die o\u00f9 la trag\u00e9die est sous-jacente \u00e0 chaque personnage et chaque situation. Et tant qu'on vit, on va au th\u00e9\u00e2tre...","performers":"Pascale Vander Zyppen (conception, interpr\u00e9tation); Jean Lambert (regard complice)","boxoffice_url":null,"website":"http:\/\/www.lejardindemasoeur.be","email":"info@lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.536505"},"nl":{"name":"Courir Nager Sauter Plonger","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.536505"},"en":{"name":"Courir Nager Sauter Plonger","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.536505"},"de":{"name":"Courir Nager Sauter Plonger","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.536505"},"it":{"name":"Courir Nager Sauter Plonger","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.536505"},"sp":{"name":"Courir Nager Sauter Plonger","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.536505"},"pt":{"name":"Courir Nager Sauter Plonger","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.536505"},"cn":{"name":"Courir Nager Sauter Plonger","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.536505"}},"place":{"id":220283,"translations":{"fr":{"name":"Le Jardin de ma Soeur","address_street_name":"A l'angle du quai au Bois \u00e0 Br\u00fbler et de la rue du Grand Hospice","address_street_number":null,"address_street_box":null,"email":"info@lejardindemasoeur.be","website":"http:\/\/www.lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","address_zip":"1000","address_city":"Bruxelles","address_line1":"A l'angle du quai au Bois \u00e0 Br\u00fbler et de la rue du Grand Hospice","address_line2":"1000 Bruxelles","description_web":"Le Jardin de ma S\u0153ur est situ\u00e9 au coin d'une rue du pittoresque March\u00e9 aux poissons, \u00e0 proximit\u00e9 de l\u2019ancien Grand B\u00e9guinage de Bruxelles. On peut difficilement imaginer un nom plus familier. Pourtant, cet endroit n'a pas vol\u00e9 son nom. Vous obtenez exactement ce que vous attendez : une soir\u00e9e sans pr\u00e9tention, pleine de divertissements et de moments partag\u00e9s. Vous vous y sentez comme dans votre salon. Vous oubliez imm\u00e9diatement tous vos soucis et riez, chantez et profitez du spectacle avec les autres participants. Sp\u00e9cialement pour les amateurs de chanson fran\u00e7aise et de th\u00e9\u00e2tre.  \u202f \r\nPensez \u00e0 r\u00e9server votre place !\r\n ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Le Jardin de ma Soeur","address_street_name":"Op de hoek van de Brandhoutkaai en de Grootgodshuisstraat","address_street_number":null,"address_street_box":null,"email":"info@lejardindemasoeur.be","website":"http:\/\/www.lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","address_zip":"1000","address_city":"Brussel","address_line1":"Op de hoek van de Brandhoutkaai en de Grootgodshuisstraat","address_line2":"1000 Brussel","description_web":"Op een straathoek aan de pittoreske Vismarkt ligt Le Jardin de ma Soeur. Een familialere naam kan je haast niet bedenken. Toch heeft deze plek haar naam niet gestolen. Je krijgt exact wat je er zou verwachten: een pretentieloze avond vol vertier en gedeelde momenten. Hier waan je je in een gezellige en veilige woonkamer. Je vergeet er meteen al je zorgen en lacht, zingt en geniet met de andere aanwezigen. Vooral voor liefhebbers van het Franse chanson en verhaaltheater.    \u202f\u202f\u202f ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Le Jardin de ma Soeur","address_street_name":"A l'angle du quai au Bois \u00e0 Br\u00fbler et de la rue du Grand Hospice","address_street_number":null,"address_street_box":null,"email":"info@lejardindemasoeur.be","website":"http:\/\/www.lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","address_zip":"1000","address_city":"Brussels","address_line1":"A l'angle du quai au Bois \u00e0 Br\u00fbler et de la rue du Grand Hospice","address_line2":"1000 Brussels","description_web":"The desire to present theater amongst people; as if a performance is nothing but a conversation, in a place somewhere in between the large halls and the streets, half living room, half pub, in a warm ambiance where one can sip a glass while watching a performance. That's cafe-theater \"Le Jardin de ma Soeur\", at the edge of the ancient \"Grand B\u00e9guinage de Bruxelles\", alongside one of the quays of the old port of Brussels where the spirit of the dock workers lingers and where one can still feel the presence of the beguines with their long black robes.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Le Jardin de ma Soeur","address_street_name":"A l'angle du quai au Bois \u00e0 Br\u00fbler et de la rue du Grand Hospice","address_street_number":null,"address_street_box":null,"email":"info@lejardindemasoeur.be","website":"http:\/\/www.lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","address_zip":"1000","address_city":"Bruxelles","address_line1":"A l'angle du quai au Bois \u00e0 Br\u00fbler et de la rue du Grand Hospice","address_line2":"1000 Bruxelles","description_web":"Dieses malerische Caf\u00e9-Theater, das 1994 in der N\u00e4he des alten \"Grand B\u00e9guinage de Bruxelles\" er\u00f6ffnet wurde, \u00fcberrascht durch seine \u00fcberaus kleinen R\u00e4umlichkeiten. Doch daf\u00fcr ist das Programm ist umso \"gr\u00f6\u00dfer\". Reservierung empfohlen!","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Le Jardin de ma Soeur","address_street_name":"A l'angle du quai au Bois \u00e0 Br\u00fbler et de la rue du Grand Hospice","address_street_number":null,"address_street_box":null,"email":"info@lejardindemasoeur.be","website":"http:\/\/www.lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","address_zip":"1000","address_city":"Bruxelles","address_line1":"A l'angle du quai au Bois \u00e0 Br\u00fbler et de la rue du Grand Hospice","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Le Jardin de ma Soeur","address_street_name":"A l'angle du quai au Bois \u00e0 Br\u00fbler et de la rue du Grand Hospice","address_street_number":null,"address_street_box":null,"email":"info@lejardindemasoeur.be","website":"http:\/\/www.lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","address_zip":"1000","address_city":"Bruxelles","address_line1":"A l'angle du quai au Bois \u00e0 Br\u00fbler et de la rue du Grand Hospice","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Le Jardin de ma Soeur","address_street_name":"A l'angle du quai au Bois \u00e0 Br\u00fbler et de la rue du Grand Hospice","address_street_number":null,"address_street_box":null,"email":"info@lejardindemasoeur.be","website":"http:\/\/www.lejardindemasoeur.be","phone_contact":"+32 2 217 65 82","phone_booking":"+32 2 217 65 82","address_zip":"1000","address_city":"Bruxelles","address_line1":"A l'angle du quai au Bois \u00e0 Br\u00fbler et de la rue du Grand Hospice","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Le Jardin de ma Soeur","address_street_name":"A l'angle du quai au Bois \u00e0 Br\u00fbler et de la rue du Grand Hospice","addres