an Gomez Tamayo d\u00e9marre sa tourn\u00e9e europ\u00e9enne au Studio 84.\r\nLa photographe Yseult D vous fera voyager dans le temps avec une s\u00e9rie photographique d'exploration de lieux abandonn\u00e9s.\r\nL'auteur St\u00e9phane Maton-Vann pr\u00e9sente son nouvel opus d\u00e9di\u00e9 \u00e0 l'auteur et photographe Herv\u00e9 Guibert.","performers":"Yseult D (Photographe), St\u00e9phane Maton-Vann (Auteur), Wilman Gomez Tamayo (Plasticien et performer)","boxoffice_url":null,"website":"https:\/\/www.facebook.com\/studio84bxl\/","email":"studio84.bxl@gmail.com","phone_contact":null,"phone_booking":"+32 475 85 03 57","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.541072"},"nl":{"name":"M\u00e9moire","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.541072"},"en":{"name":"M\u00e9moire","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.541072"},"de":{"name":"M\u00e9moire","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.541072"},"it":{"name":"M\u00e9moire","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.541072"},"sp":{"name":"M\u00e9moire","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.541072"},"pt":{"n