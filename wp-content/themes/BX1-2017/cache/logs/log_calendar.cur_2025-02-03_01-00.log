fice_url":null,"website":"https:\/\/www.espacemagh.be\/projects\/furio-friends\/?pr=19953&gr=1&post=projects&sa=","email":"reservation@espacemagh.be","phone_contact":"+32 2 274 05 10","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700004595"},"it":{"name":"Furio & Friends","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.espacemagh.be\/projects\/furio-friends\/?pr=19953&gr=1&post=projects&sa=","email":"reservation@espacemagh.be","phone_contact":"+32 2 274 05 10","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700004595"},"cn":{"name":"Furio & Friends","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.espacemagh.be\/projects\/furio-friends\/?pr=19953&gr=1&post=projects&sa=","email":"reservation@espacemagh.be","phone_contact":"+32 2 274 05 10","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700004595"},"fr":{"name":"Furio & Friends","shortdescr":"Apr\u00e8s 20 ans \u00e0 arpenter les sc\u00e8nes belges et internationales, Furio, rappeur namurois de renom, d\u00e9voile enfin son premier album solo : Antarctique. \u00c0 d\u00e9couvrir sur sc\u00e8ne dans un set d\u00e9bordant d\u2019\u00e9nergie et d\u2019\u00e9motions.","longdescr":"Furio, c\u2019est 20 ans d\u2019exp\u00e9rience : un MC charismatique qui m\u00eale pr\u00e9sence sc\u00e9nique, diction impeccable et textes touchants. Avec ses groupes (Ligne 81, Trafiquants d\u2019art, 5.1), il a marqu\u00e9 les festivals tels que Dour, Couleur Caf\u00e9 et le Cabaret Vert.\n\nSon album Antarctique est une \u0153uvre m\u00fbre o\u00f9 il aborde parentalit\u00e9, amour et d\u00e9sir, avec des productions vari\u00e9es sign\u00e9es Olvo, Smimooz, JohnZ, Augustin Fi\u00e9vet et Ypsos. Entre boombap, trap, house et soul, ce projet s\u2019enrichit de featurings 100% namurois (Vesty, Max V, Tony Rondelle) pour une musique qui parle \u00e0 tous.\n\nLe single Le son des claquettes invite \u00e0 la l\u00e9g\u00e8ret\u00e9, tandis que Les tambours d\u00e9voile un texte percutant. Ne manquez pas un show aff\u00fbt\u00e9 o\u00f9 Furio fera monter ses potes sur sc\u00e8ne pour des connexions 100 % hip-hop !","performers":null,"boxoffice_url":null,"website":"https:\/\/www.espacemagh.be\/projects\/furio-friends\/?pr=19953&gr=1&post=projects&sa=","email":"reservation@espacemagh.be","phone_contact":"+32 2 274 05 10","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700004595"},"sp":{"name":"Furio & Friends","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.espacemagh.be\/projects\/furio-friends\/?pr=19953&gr=1&post=projects&sa=","email":"reservation@espacemagh.be","phone_contact":"+32 2 274 05 10","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700004595"},"nl":{"name":"Furio & Friends","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.espacemagh.be\/projects\/furio-friends\/?pr=19953&gr=1&post=projects&sa=","email":"reservation@espacemagh.be","phone_contact":"+32 2 274 05 10","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700004595"}},"place":{"id":247296,"translations":{"de":{"name":"Centre culturel Espace Magh asbl","address_street_name":"Rue du Poin\u00e7on","address_street_number":null,"address_street_box":null,"email":"info@espacemagh.be","website":"http:\/\/www.espacemagh.be","phone_contact":"+32 2 274 05 10","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Poin\u00e7on","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Centre culturel Espace Magh a