nslations":{"de":{"name":"And ... Cut !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/docs.google.com\/forms\/d\/e\/1FAIpQLSdR6kvstVV4dLMxgH0hOKMKM-6qjfc6C5cYfcKeImb0ICXkpA\/viewform","email":"clembree@protonmail.com","phone_contact":null,"phone_booking":"+32 473 81 53 45","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700001653"},"pt":{"name":"And ... Cut !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/docs.google.com\/forms\/d\/e\/1FAIpQLSdR6kvstVV4dLMxgH0hOKMKM-6qjfc6C5cYfcKeImb0ICXkpA\/viewform","email":"clembree@protonmail.com","phone_contact":null,"phone_booking":"+32 473 81 53 45","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700001653"},"en":{"name":"And ... Cut !","shortdescr":"Ce soir, VOUS d\u00e9cidez du film qui se d\u00e9roulera devant vous. Inspir\u00e9s par vos choix d'affiches et de titre, et guid\u00e9s par le r\u00e9gisseur et la metteuse en sc\u00e8ne, les com\u00e9diennes et com\u00e9diens vous proposeront un film improvis\u00e9 qui ferait rougir les Studios Marvel !\n\nR\u00e9servations sur https:\/\/www.letrac.be\/calendrier","longdescr":"Les studios Val'Ambr\u00e9e, form\u00e9s par Catherine Lembr\u00e9e et Alexandre Valencin, artistes et coachs aguerris, ont a c\u0153ur de proposer des films improvis\u00e9s rassemblant des com\u00e9diens et com\u00e9diennes qui ne se connaissent pas et se d\u00e9couvrent sur sc\u00e8ne le temps d'une soir\u00e9e.\n\nPassionn\u00e9s d'impro et de cin\u00e9ma, Alexandre et Catherine vous entrainent ainsi que les com\u00e9diens et com\u00e9diennes dans leurs univers f\u00e9tiches pour des histoires improvis\u00e9es. Attrapez votre bol de popcorn, s\u00e9lectionnez votre affiche et laissez vous porter !","performers":"Catherine Lembr\u00e9e, Alexandre Valancin et leurs invit\u00e9.e.s","boxoffice_url":null,"website":"https:\/\/www.ebullitiontheatre.org\/","email":"clembree@protonmail.com","phone_contact":null,"phone_booking":"+32 473 81 53 45","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700001653"},"it":{"name":"And ... Cut !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/docs.google.com\/forms\/d\/e\/1FAIpQLSdR6kvstVV4dLMxgH0hOKMKM-6qjfc6C5cYfcKeImb0ICXkpA\/viewform","email":"clembree@protonmail.com","phone_contact":null,"phone_booking":"+32 473 81 53 45","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700001653"},"cn":{"name":"And ... Cut !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/docs.google.com\/forms\/d\/e\/1FAIpQLSdR6kvstVV4dLMxgH0hOKMKM-6qjfc6C5cYfcKeImb0ICXkpA\/viewform","email":"clembree@protonmail.com","phone_contact":null,"phone_booking":"+32 473 81 53 45","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700001653"},"fr":{"name":"And ... Cut !","shortdescr":"Ce soir, VOUS d\u00e9cidez du film qui se d\u00e9roulera devant vous. Inspir\u00e9s par vos choix d'affiches et de titre, et guid\u00e9s par le r\u00e9gisseur et la metteuse en sc\u00e8ne, les com\u00e9diennes et com\u00e9diens vous proposeront un film improvis\u00e9 qui ferait rougir les Studios Marvel !","longdescr":"Le ou la metteur.euse en sc\u00e8ne guidera les com\u00e9dien.nes et le.la r\u00e9gisseur.euse ajoutera sa touche magique, pour vous offrir une exp\u00e9rience th\u00e9\u00e2trale in\u00e9dite o\u00f9 tout peut arriver.\n\nAND...CUT ! est une invitation \u00e0 explorer ce qui se cache derri\u00e8re l'improvisation, \u00e0 d\u00e9couvrir les choix artistiques, et \u00e0 vivre une soir\u00e9e o\u00f9 la cr\u00e9ativit\u00e9 et l'audace sont \u00e0 l'honneur. Faites confiance au processus, et laissez-vous surprendre par l'histoire qui va se d\u00e9rouler sous vos yeux !\n\nNe manquez pas cette immersion totale dans l'art de l'impro !","performers":"Sous la direction attentive de Alexandre Valancin et Catherine Lembr\u00e9e, ainsi que leurs invit\u00e9.es du soir, vous assisterez \u00e0 la naissance d'une grande histoire de 2x40 minutes.","boxoffice_url":null,"website":"https:\/\/docs.google.com\/forms\/d\/e\/1FAIpQLSdR6kvstVV4dLMxgH0hOKMKM-6qjfc6C5cYfcKeImb0ICXkpA\/viewform","email":"clembree@protonmail.com","phone_contact":null,"phone_booking":"+32 473 81 53 45","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700001653"},"sp":{"name":"And ... Cut !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/docs.google.com\/forms\/d\/e\/1FAIpQLSdR6kvstVV4dLMxgH0hOKMKM-6qjfc6C5cYfcKeImb0ICXkpA\/viewform","email":"clembree@protonmail.com","phone_contact":null,"phone_booking":"+32 473 81 53 45","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700001653"},"nl":{"name":"And ... Cut !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/docs.google.com\/forms\/d\/e\/1FAIpQLSdR6kvstVV4dLMxgH0hOKMKM-6qjfc6C5cYfcKeImb0ICXkpA\/viewform","email":"clembree@protonmail.com","phone_contact":null,"phone_booking":"+32 473 81 53 45","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700001653"}},"place":{"id":267378,"translations":{"de":{"name":"Le TRAC","address_street_name":"Rue Albert Meunier","address_street_number":"110","address_street_box":null,"email":"info@letrac.be","website":"http:\/\/www.letrac.be\/","phone_contact":"+32 470 50 04 75","phone_booking":null,"address_zip":"1160","address_city":"Auderghem","address_line1":"Rue Albert Meunier, 110","address_line2":"1160 Auderghem","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Le TRAC","address_street_name":"Rue Albert Meunier","address_street_number":"110","address_street_box":null,"email":"info@letrac.be","website":"http:\/\/w