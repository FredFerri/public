023-01-01T01:09:20+01:00","published_at":"2022-10-05T11:08:31+02:00","backoffice_id":262298,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.47425244059868},{"id":545641,"date_start":"2022-12-07","date_end":"2023-01-08","date_next":"2023-01-04","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung","it":null,"sp":null,"pt":null,"cn":null}},"others":{"list":[36,46],"translations":{"fr":["Mus\u00e9es et art centers","Pluridisciplinaire"],"nl":["Musea en kunstcentra","Multidisciplinair"],"en":["Museums and art centers","Multidisciplinary"],"de":["Museen & Kunstzentren","Multidisziplin\u00e4r"],"it":[null,null],"sp":[null,null],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Exposition ID","shortdescr":"Quelle ID te fais-tu de moi ? \r\n\r\n\u201cSe faire une id\u00e9e\u201d de quelqu\u2019un, de quelque chose, en voil\u00e0 une expression singuli\u00e8re. Et toi, quelle id\u00e9e te fais-tu de ton voisin, de ton quartier, d\u2019une inconnue ? Viens questionner ces id\u00e9es pr\u00e9con\u00e7ues, tenter de les comprendre et surtout les d\u00e9construire.","longdescr":"Cette exposition temporaire met en lumi\u00e8re 3 projets artistiques,","performers":null,"boxoffice_url":null,"website":"http:\/\/www.horslesmuren.be","email":"horslesmuren@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.545641"},"nl":{"name":"ID tentoonstelling","shortdescr":"Welk ID krijg jij van mij?\r\n\r\nEen idee van iets of iemand \u201ckrijgen\u201d\u2026 wat een bijzondere uitdrukking! En jij, wat idee krijg jij van je buurman, je wijk, of een onbekende? Kom deze vooroordelen in twijfel trekken, probeer ze te begrijpen en vooral te deconstrueren.","longdescr":"Gedurende deze tijdelijke tentoonstelling worden","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.545641"},"en":{"name":"ID exhibition","shortdescr":"What ID are you getting of me?\r\nTo \u201cget an idea\u201d of someone or something\u2026 what a strange expression. What ideas are you getting from your neighbour, your neighbourhood, or from a stranger? Come and question those preconceived ideas, try to understand them and above all deconstruct them.","longdescr":"This temporary exhibition puts forward","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.545641"},"de":{"name":"Exposition ID","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.545641"},"it":{"name":"Exposition ID","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.545641"},"sp":{"name":"Exposition ID","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.545641"},"pt":{"name":"Exposition ID","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.545641"},"cn":{"name":"Exposition ID","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.545641"}},"place":{"id":1490,"translations":{"fr":{"name":"Wiels - Centre d\u2019art contemporain","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+32 2 340 00 50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":"La r\u00e9servation est obligatoire pour le Wiels. Veuillez vous rendre sur leur site internet pour une r\u00e9servation.\r\n\r\nLe WIELS est un laboratoire international pour la cr\u00e9ation et la diffusion de l\u2019art contemporain. Ax\u00e9 sur les arts visuels, mais accordant une place et une attention particuli\u00e8res aux croisements et interactions avec d\u2019autres disciplines, le centre d\u00e9sire pr\u00e9senter l\u2019art contemporain dans toute sa diversit\u00e9 et mettre le public en contact et en dialogue permanents avec les d\u00e9veloppements et d\u00e9bats les plus r\u00e9cents du monde de l\u2019art.","description_print":"","booking_url":null,"sort_order":"WIELS - CONTEMPORARY ART CENTRE","virtual_visit":null},"nl":{"name":"Wiels - Centrum voor hedendaagse kunst","address_street_name":"Van Volxemlaan","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+32 2 340 00 50","phone_booking":null,"address_zip":"1190","address_city":"Vorst","address_line1":"Van Volxemlaan, 354","address_line2":"1190 Vorst","description_web":"De boeking is verplicht voor Wiels. Raadpleeg de webpagina van de musea om te reserveren.\r\n\r\nWiels is een toonaangevend internationaal platform voor de creatie en presentatie van hedendaagse kunst. Het centrum ontwikkelt een programma van tijdelijke activiteiten, zonder een permanente collectie uit te bouwen. Wiels organiseert zes tot acht grote tentoonstellingen per jaar die de evoluties in hedendaagse kunst op de voet volgen. Daarnaast loopt er een residentie en educatief programma en worden er lezingen, films, performances, debatten, ontmoetingen georganiseerd.","description_print":"","booking_url":null,"sort_order":"WIELS - CONTEMPORARY ART CENTRE","virtual_visit":null},"en":{"name":"Wiels - Contemporary art centre","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+32 2 340 00 50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":"Booking is compulsory for Wiels. Please consult the museum\u2019s website to book your time slot.\r\n\r\nIt was the brewer L\u00e9on Wielemans who asked his friend, the architect Adrien Blomme, to design and build the new buildings of his brewery in Forest. It became the leading monument of industrial archaeology in the art deco style, and houses now Wiels, an international laboratory for the creation and the diffusion of contemporary art. Focusing on visual arts, but granting a particular attention to the crossings and interactions with other disciplines, the centre wishes to present contemporary art in all its diversity and to offer a permanent dialogue with the developments and the most recent debates of the art world.  ","description_print":"","booking_url":null,"sort_order":"WIELS - CONTEMPORARY ART CENTRE","virtual_visit":null},"de":{"name":"Wiels - Zentrum f\u00fcr moderne Kunst","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+32 2 340 00 50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":"Das WIELS ist ein hochkar\u00e4tiges, internationales Labor f\u00fcr moderne Kunst, das sich nicht nur der Ausstellung von moderner Kunst sondern auch dem kreativen Entstehungsprozess widmet. Der Schwerpunkt liegt auf der visuellen Kunst, doch es werden auch ganz bewusst Schnittstellen mit anderen Disziplinen gesucht, die die Vielfalt und das Facettenreichtum der modernen Kunst aufzuzeigen. Dem Besucher offenbart sich ein permanenter Dialog mit den Entwicklungen der modernen Kunst und eine Debatte mit der Kunstwelt der Gegenwart.\r\n\r\nAuf drei Ebenen mit insgesamt 1800 m\u00b2 Ausstellungsfl\u00e4che finden regelm\u00e4\u00dfig Ausstellungen statt. Dar\u00fcber hinaus wird das WIELS regelm\u00e4\u00dfig Schauplatz von ausgew\u00e4hlten Filmvorf\u00fchrungen, Konferenzen, Festivals und Konzerten. \r\n\r\nUntergebracht ist das WIELS in dem eindrucksvollen Eckgeb\u00e4ude der ehemaligen Brauerei Wielemans-Ceuppens, das aus der Feder des modernistischen Architekten Adrien Blomm stammt. Von der Brauereivergangenheit zeugen noch heute die majest\u00e4tischen Kupferkessel.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Wiels - Centre d\u2019art contemporain","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+32 2 340 00 50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Wiels - Centro de arte contempor\u00e1neo","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+32 2 340 00 50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":"Fue el amante de la cerveza L\u00e9on Wielemans quien le pidi\u00f3 a su amigo, el arquitecto Adrien Blomme, dise\u00f1ar y construir los nuevos edificios para su cervecer\u00eda en Forest. Se convirti\u00f3 en el monumento m\u00e1s importante de arqueolog\u00eda industrial en estilo art d\u00e9co, y ahora alberga Wiels, un laboratorio internacional para la creaci\u00f3n y difusi\u00f3n de arte contempor\u00e1neo. Poniendo el foco en las artes visuales, pero garantizando una particular atenci\u00f3n en el cruce y las interacciones con otras disciplinas, el centro pretende mostrar el arte contempor\u00e1neo en todos sus sentidos y ofrecer un di\u00e1logo permanente con su desarrollo y los debates m\u00e1s recientes del mundo del arte.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Wiels - Centre d\u2019art contemporain","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+32 2 340 00 50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Wiels - Centre d\u2019art contemporain","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+32 2 340 00 50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","descrip