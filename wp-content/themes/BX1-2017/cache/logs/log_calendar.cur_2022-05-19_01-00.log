ce_id":249240,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.45428014820803},{"id":515288,"date_start":"2021-09-07","date_end":"2022-06-30","date_next":"2022-05-18","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[36,46],"translations":{"fr":["Mus\u00e9es et art centers","Pluridisciplinaire"],"nl":["Musea en kunstcentra","Multidisciplinair"],"en":["Museums and art centers","Multidisciplinary"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Fred Sandback","shortdescr":"La Fondation CAB a l'honneur de pr\u00e9senter Fred Sandback au coeur d\u2019une exposition personnelle de sculptures et de reliefs du c\u00e9l\u00e8bre artiste am\u00e9ricain (1943-2003).","longdescr":"La Fondation CAB a l'honneur de pr\u00e9senter Fred Sandback au coeur d\u2019une exposition personnelle de sculptures et de reliefs du c\u00e9l\u00e8bre artiste am\u00e9ricain (1943-2003). L'exposition comprendra des oeuvres pr\u00e9sent\u00e9es dans des expositions historiques et d'autres sculptures jamais expos\u00e9es auparavant. Elle retrace les diff\u00e9rentes p\u00e9riodes de l'oeuvre de l'artiste, avec des sculptures lin\u00e9aires en fil acrylique, cordes \u00e9lastiques et tiges d'acier.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.fondationcab.com","email":"info@fondationcab.com","phone_contact":null,"phone_booking":"+32 2 644 34 32","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/515288.html"},"nl":{"name":"Fred Sandback","shortdescr":"Fondation CAB is vereerd om Fred Sandback te mogen presenteren, een solotentoonstelling met sculpturen en reli\u00ebfs van de gerenommeerde Amerikaanse kunstenaar (1943-2003).","longdescr":"Fondation CAB is vereerd om Fred Sandback te mogen presenteren, een solotentoonstelling met sculpturen en reli\u00ebfs van de gerenommeerde Amerikaanse kunstenaar (1943-2003). De tentoonstelling omvat kunstwerken die in historische tentoonstellingen te zien waren, samen met andere, nooit eerder getoonde sculpturen. Ze schetst een beeld van de verschillende periodes in het oeuvre van de kunstenaar met lineaire sculpturen in acrylgaren, elastisch koord en stalen staven.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/515288.html"},"en":{"name":"Fred Sandback","shortdescr":"Fondation CAB is honored to present Fred Sandback, a solo exhibition featuring sculptures and reliefs by the renowned American artist (1943\u20132003).","longdescr":"Fondation CAB is honored to present Fred Sandback, a solo exhibition featuring sculptures and reliefs by the renowned American artist (1943\u20132003). The exhibition will include artworks shown in historic exhibitions and other sculptures never previously exhibited. It traces the different periods of the artist\u2019s oeuvre, featuring linear sculptures in acrylic yarn, elastic cord, and steel rod.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/515288.html"},"de":{"name":"Fred Sandback","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/515288.html"},"it":{"name":"Fred Sandback","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/515288.html"},"sp":{"name":"Fred Sandback","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/515288.html"},"pt":{"name":"Fred Sandback","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/515288.html"},"cn":{"name":"Fred Sandback","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/515288.html"}},"place":{"id":251140,"translations":{"fr":{"name":"Fondation CAB","address_street_name":"Rue Borrens","address_street_number":"32-34","address_street_box":null,"email":"info@fondationcab.com","website":"http:\/\/www.fondationcab.com","phone_contact":"+32 2 644 34 32","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Borrens, 32-34","address_line2":"1050 Ixelles","description_web":"Le CAB est un centre priv\u00e9 d\u00e9di\u00e9 \u00e0 l\u2019art contemporain. Il promeut l\u2019art contemporain au travers de l\u2019organisation de projets artistiques dans un magnifique espace d\u2019exposition Art D\u00e9co situ\u00e9 non loin de Flagey.  Le CAB soutient les artistes en leur donnant une visibilit\u00e9 dans un lieu qui n\u2019est ni une institution ni une galerie. Il organise deux projets par an, de septembre \u00e0 d\u00e9cembre et d\u2019avril \u00e0 juin, en invitant un curateur d\u2019un mus\u00e9e ou d\u2019une galerie, belge ou international. Avec ses projets, le CAB d\u00e9sire encourager le dialogue et informer le public sur la sc\u00e8ne artistique \u00e9mergeante. ","description_print":"","booking_url":null,"sort_order":"FONDATION CAB","virtual_visit":null},"nl":{"name":"Fondation CAB","address_street_name":"Borrensstraat","address_street_number":"32-34","address_street_box":null,"email":"info@fondationcab.com","website":"http:\/\/www.fondationcab.com","phone_contact":"+32 2 644 34 32","phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"Borrensstraat, 32-34","address_line2":"1050 Elsene","description_web":"CAB is een priv\u00e9centrum voor hedendaagse kunst. Het promoot eigentijdse kunst via de organisatie van artistieke projecten in een schitterende  art deco tentoonstellingsruimte in de buurt van Flagey. CAB steunt artiesten door ze een zichtbaarheid te schenken in een ruimte die geen instelling en evenmin een galerij is. Het organiseert elk jaar twee projecten, september-december en april-juni, en nodigt hiertoe de curator van een Belgisch(e) of buitenlands(e) museum of galerij uit. Met zijn projecten wil CAB de dialoog aanmoedigen en het publiek informeren over de opkomende kunstsc\u00e8ne. ","description_print":"","booking_url":null,"sort_order":"FONDATION CAB","virtual_visit":null},"en":{"name":"Fondation CAB","address_street_name":"Rue Borrens","address_street_number":"32-34","address_street_box":null,"email":"info@fondationcab.com","website":"http:\/\/www.fondationcab.com","phone_contact":"+32 2 644 34 32","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Borrens, 32-34","address_line2":"1050 Ixelles","description_web":"CAB is a private centre dedicated to contemporary art. It promotes that genre by holding art projects in a splendid Art Deco exhibition space located not far from Flagey.  CAB supports artists by giving them visibility in a place that\u2019s neither an institution nor a gallery. It organises two projects a year, from September to December and from April to June, inviting a curator from a museum or gallery, Belgian or international. With its projects, CAB wants to encourage dialogue and inform the public about the emerging art scene. ","description_print":"","booking_url":null,"sort_order":"FONDATION CAB","virtual_visit":null},"de":{"name":"Fondation CAB","address_street_name":"Rue Borrens","address_street_number":"32-34","address_street_box":null,"email":"info@fondationcab.com","website":"http:\/\/www.fondationcab.com","phone_contact":"+32 2 644 34 32","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Borrens, 32-34","address_line2":"1050 Ixelles","description_web":"Das CAB ist ein privates Kunstzentrum f\u00fcr zeitgen\u00f6ssische Kunst, die hier durch die Organisation von Kunstprojekten in einem pr\u00e4chitgen Ausstellungsraum im Art-d\u00e9co-Stil, in der N\u00e4he des Place Flagey perfekt in Szene gesetzt wird. Das CAB unterst\u00fctzt die K\u00fcnstler, indem es ihnen zu mehr Sichtbarkeit verhilft, ohne eine Institution oder eine Galerie zu sein. Jedes Jahr werden zwei Projekte durchgef\u00fchrt - jeweils von September bis Dezember und von April bis Juni - in deren Rahmen  der Kurator eines belgischen oder internationalen  Museums oder einer Galerie eingeladen wird. Mit seinen Projekten m\u00f6chte das CAB den Dialog f\u00f6rdern und das interessierte Publikum \u00fcber die aufstrebende k\u00fcnstlerische Szene informieren.","description_print":"","booking_url":null,"sort_order":"FONDATION CAB","virtual_visit":null},"it":{"name":"Fondation CAB","address_street_name":"Rue Borrens","address_street_number":"32-34","address_street_box":null,"email":"info@fondationcab.com","website":"http:\/\/www.fondationcab.com","phone_contact":"+32 2 644 34 32","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Borrens, 32-34","address_line2":"1050 Ixelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Fondation CAB","address_street_name":"Rue Borrens","address_street_number":"32-34","address_street_box":null,"email":"info@fondationcab.com","website":"http:\/\/www.fondationcab.com","phone_cont