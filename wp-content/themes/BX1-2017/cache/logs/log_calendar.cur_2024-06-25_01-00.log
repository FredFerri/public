3"},"it":{"name":"Inauguration de l\u2019exposition Woman in Photography\/Germaine Van Parys","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/geopolis.brussels\/2024\/05\/23\/30-05-a-19h-inauguration-de-lexposition-woman-in-photography-germaine-van-parys-a-geopolis\/","email":"contact@geopolis.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50011033"},"cn":{"name":"Inauguration de l\u2019exposition Woman in Photography\/Germaine Van Parys","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/geopolis.brussels\/2024\/05\/23\/30-05-a-19h-inauguration-de-lexposition-woman-in-photography-germaine-van-parys-a-geopolis\/","email":"contact@geopolis.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50011033"},"fr":{"name":"Women in Photography\/ Germaine Van Parys","shortdescr":"Aboutissement de cette premi\u00e8re \u00e9dition du Prix Women in photography\/Germaine Van Parys lanc\u00e9 par l\u2019Echevinat de la Culture de la Ville de Bruxelles et G\u00e9opolis, nous avons le plaisir de vous pr\u00e9senter l\u2019exposition des laur\u00e9ates.\n","longdescr":"En d\u00e9cembre 2023, la Ville de Bruxelles en partenariat avec le Centre G\u00e9opolis a lanc\u00e9 le concours Women In Photography\/ Prix Germaine Van Parys.\nUn prix qui porte le nom d\u2019une femme hors du commun, r\u00e9sistante, entrepreneuse et pionni\u00e8re du photojournalisme \u00e0 Bruxelles. Un prix qui vise \u00e0 valoriser le travail des femmes photographes et \u00e0 faire \u00e9merger de nouveaux talents.\n\nLaur\u00e9ates expos\u00e9es :\n\n \u2013 Marie Sordat (grand prix), \n\n\u2013 C\u00e9cili Matureli (prix \u201cEtudiante\u201d), \n\n\u2013 Marie Ruwet et Lila Kirch (finalistes du prix \u201cEtudiante\u201d). \n\nCette exposition est aussi l\u2019occasion d\u2019un hommage \u00e0 Germaine Van Parys dont nous pr\u00e9sentons une r\u00e9trospective de son travail sur Bruxelles.","performers":"Lila Kirch (photographe), Marie Ruwet (photographe), Marie Sordat (photographe), C\u00e9cili Matureli (photographe), Germaine Van Parys (photographe)","boxoffice_url":null,"website":"https:\/\/geopolis.brussels\/2024\/05\/23\/30-05-a-19h-inauguration-de-lexposition-woman-in-photography-germaine-van-parys-a-geopolis\/","email":"contact@geopolis.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50011033"},"sp":{"name":"Inauguration de l\u2019exposition Woman in Photography\/Germaine Van Parys","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/geopolis.brussels\/2024\/05\/23\/30-05-a-19h-inauguration-de-lexposition-woman-in-photography-germaine-van-parys-a-geopolis\/","email":"contact@geopolis.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50011033"},"nl":{"name":"Women in Photography\/ Germaine Van Parys","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/geopolis.brussels\/2024\/05\/23\/30-05-a-19h-inauguration-de-lexposition-woman-in-photography-germaine-van-parys-a-geopolis\/","email":"contact@geopolis.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50011033"}},"place":{"id":269816,"translations":{"de":{"name":"G\u00e9opolis","address_street_name":"Rue des Tanneurs","address_street_number":"58-60","address_street_box":null,"email":"contact@geopolis.brussels","website":"http:\/\/geopolis.brussels","phone_contact":"+32 485 32 85 90","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Tanneurs, 58-60","address_line2":"1000 Bruxelles","description_web":null,"description_