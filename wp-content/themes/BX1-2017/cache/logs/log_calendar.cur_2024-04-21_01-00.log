mily"],"it":["Famiglie"],"cn":[null],"fr":["Famille"],"sp":["Familias"],"nl":["Familie"]}},"educational_targets":{"list":[],"translations":{}},"tags":["kids"]},{"id":50009089,"date_start":"2024-04-13","date_end":"2024-04-28","date_next":"2024-04-20","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-04-20T00:22:21+02:00","published_at":"2024-04-02T11:13:46+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":297621,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.3968502629920499,"languages":{"spoken":["nl","fr","en"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{}},"translations":{"de":{"name":"Toi(ts) la nuit","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.instagram.com\/mariabaoli\/","email":"holamariabaoli@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50009089"},"pt":{"name":"Toi(ts) la nuit","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.instagram.com\/mariabaoli\/","email":"holamariabaoli@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50009089"},"en":{"name":"Toi(ts) la nuit","shortdescr":"This photographic series, produced by Maria Baoli in partnership with young people from the CEMO NGO, began in 2022, and dives into the heart of the complex realities of young people experiencing breakups and\/or wandering. \nOpening 11.04.24 at 6pm\nGuided tours on Saturdays and Sundays 2-5pm","longdescr":"A reality that has been exacerbated since the health crisis which aggravates mental health problems, leading to a significant increase in psychological disorders in this vulnerable population. They embody disbelonging, displacement, and the search for home on the margins of contemporary society. They also show the image of a resilient youth, who despite everything, tries to build themselves positively.\nMaria Baoli invites the public to question these trajectories punctuated by ruptures, evoking the universal desire for a space in which to evolve in security, without fear or anxieties. To what extent are bodies, houses, institutions reliable? By highlighting their stories, their challenges and their dreams, this photographic series aspires to give a voice to those who are often marginalized and to spark constructive dialogue around issues of identity and resilience, in the hope of creating a more inclusive and united world where everyone can find their place.","performers":"Maria Baoli & the younsgters of CEMI","boxoffice_url":null,"website":"https:\/\/www.instagram.com\/mariabaoli\/","email":"holamariabaoli@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50009089"},"it":{"name":"Toi(ts) la nuit","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.instagram.com\/mariabaoli\/","email":"holamariabaoli@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50009089"},"cn":{"name":"Toi(ts) la nuit","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.instagram.com\/mariabaoli\/","email":"holamariabaoli@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50009089"},"fr":{"name":"Toi(ts) la nuit","shortdescr":"Cette s\u00e9rie photographique, r\u00e9alis\u00e9e par Maria Baoli en partenariat avec les jeunes du dispositif KAP du CEMO, a d\u00e9but\u00e9 en 2022,  et plonge au c\u0153ur des r\u00e9alit\u00e9s complexes des jeunes en situation de ruptures et\/ou d\u2019errance. \nVernissage jeudi 11 avril \u00e0 18H\nvisites guid\u00e9es les samedis et dimanches de 14 \u00e0 17h","longdescr":"Une r\u00e9alit\u00e9 exacerb\u00e9e depuis la crise sanitaire qui aggrave les probl\u00e8mes de sant\u00e9 mentale, entra\u00eenant une augmentation significative des troubles psychiques chez cette population vuln\u00e9rable. Ils incarnent la d\u00e9sappartenance, le d\u00e9placement, et la qu\u00eate de foyer dans les marges de la soci\u00e9t\u00e9 contemporaine. Ils montrent \u00e9galement l\u2019image d\u2019une jeunesse r\u00e9siliente, qui malgr\u00e9 tout, essaye de se construire positivement.\nMaria Baoli invite le public \u00e0 s\u2019interroger sur ces trajectoires jalonn\u00e9es de ruptures, \u00e9voquant le d\u00e9sir universel d\u2019un espace o\u00f9 \u00e9voluer en s\u00e9curit\u00e9, sans craintes ni angoisses. Dans quelle mesure les corps, les maisons, les institutions, sont-ils fiables? En mettant en lumi\u00e8re leurs histoires, leurs d\u00e9fis et leurs r\u00eaves, cette s\u00e9rie photographique aspire \u00e0 donner une voix \u00e0 ceux qui sont souvent marginalis\u00e9s et \u00e0 susciter un dialogue constructif autour des questions d'identit\u00e9 et de r\u00e9silience, dans l'espoir de cr\u00e9er un monde plus inclusif et solidaire o\u00f9 chacun peut trouver sa place.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.instagram.com\/mariabaoli\/","email":"holamariabaoli@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50009089"},"sp":{"name":"Toi(ts) la nuit","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.instagram.com\/mariabaoli\/","email":"holamariabaoli@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50009089"},"nl":{"name":"Toi(ts) la nuit","shortdescr":"Deze fotografische serie, geproduceerd in samenwerking met jongeren uit het Cemo, begon in 2022 en duikt in het hart van de complexe realiteit van jonge mensen die een scheiding ervaren en\/of ronddwalen. \nOpening op donderdag 11 april om 18 uur\nRondleidingen op zaterdag en zondag van 14 tot 17 uur","longdescr":"Ze belichamen het niet erbij horen, ontheemding en de zoektocht naar een thuis aan de rand van de hedendaagse samenleving. Ze laten ook het beeld zien van een veerkrachtige jeugd, die ondanks alles zichzelf positief probeert op te bouwen.\n\nOpening op donderdag 11 april om 18 uur\nRondleidingen op zaterdag en zondag van 14 tot 17 uur","performers":null,"boxoffice_url":null,"website":"https:\/\/www.instagram.com\/mariabaoli\/","email":"holamariabaoli@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50009089"}},"place":{"id":245191,"translations":{"de":{"name":"Maison des Cultures de Saint-Gilles","address_street_name":"Rue de Belgrade","address_street_number":"120","address_street_box":null,"email":"maisondescultures@stgilles.brussels","website":"http:\/\/mdc1060.brussels\/","phone_contact":"+32 2 850 44 18","phone_booking":"+32 2 850 44 18","address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Rue de Belgrade, 120","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Maison des Cultures de Saint-Gilles","address_street_name":"Rue de Belgrade","address_street_number":"120","address_street_box"