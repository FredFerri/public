et\/f936f7150f76eefc6c3fab29dba0ced52d06a0a5.jpg","width":2898,"height":1410,"ratio":2.06,"translations":{"fr":{"title":"Ik en den Theo \/ Moi et le Th\u00e9o en concert aux Bib.Sophia & Bib. S\u00e9same","copyright":null},"nl":{"title":"Ik en den Theo \/ Moi et le Th\u00e9o en concert aux Bib.Sophia & Bib. S\u00e9same","copyright":null},"en":{"title":"Ik en den Theo \/ Moi et le Th\u00e9o en concert aux Bib.Sophia & Bib. S\u00e9same","copyright":null}}}],"dates":[{"day":"2022-09-24","doors":null,"start":"14:00:00","end":null,"is_soldout":false,"is_canceled":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-08-10T21:05:50+02:00","published_at":"2022-06-16T11:38:30+02:00","backoffice_id":256189,"import_origin":null,"sub_type":"concert","show_in_agenda":true,"ranking":1},{"id":540097,"date_start":"2022-09-24","date_end":"2022-09-24","date_next":"2022-09-24","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Balade anti-sp\u00e9culative le long du canal #2","shortdescr":"Le Casi-Uo propose une s\u00e9rie de visites pour de (re)d\u00e9couvrir Bruxelles, son histoire, l'histoire de sa population, pour d\u00e9construire certains clich\u00e9s, pour que chacun(e) puisse s'approprier son espace de vie et aborder l'espace public de mani\u00e8re critique.\r\nLe CASI-UO vous invite \u00e0 la balade anti-sp\u00e9culative le long du canal en d\u00e9couvrant cette fois-ci le tron\u00e7on Tour et Taxis - Up Site.","longdescr":"Le canal de Bruxelles est un lieu historique de promenade. N\u00e9anmoins, sa vocation premi\u00e8re consiste \u00e0 transporter des marchandises et aussi des personnes. Pr\u00e8s de trois cents ans plus tard, c\u2019est le d\u00e9veloppement industriel qui lui donnera plus ou moins sa morphologie actuelle. Toutefois, sa transformation continue\u2026Il n\u2019aura pas \u00e9chapp\u00e9 aux bruxellois\u00b7es que les nombreux terrains bordant le canal, destin\u00e9s jusqu\u2019il y a peu \u00e0 accueillir des activit\u00e9s \u00e9conomiques utilisant ou non la voie d\u2019eau, sont affect\u00e9s aujourd\u2019hui \u00e0 des fonctions culturelles et de loisirs (Mus\u00e9e Kanal), de commerces (Docks Bruxsel) et de logements haut de gamme (Up Site). Un mouvement de transformation soumis \u00e0 la pression exog\u00e8ne, celle des promoteurs et des convoitises qui en font aujourd\u2019hui un lieu de rente, de sp\u00e9culation ou de consommation.\r\nLes territoires qui bordent le canal sont alors pr\u00e9sent\u00e9s comme des quartiers ghettos \u00e0 revitaliser, des friches industrielles \u00e0 reconqu\u00e9rir par les pouvoirs publics, les promoteurs, les cr\u00e9atifs et les touristes de tout poil. Notre souhait est de mettre en miroir le versant moins visible et anti-sp\u00e9culatif du canal, celui des habitant\u00b7es, des travailleurs\u00b7euses, avec ses quartiers populaires comme lieu de vie, d\u2019accueil, de solidarit\u00e9s et de ressources, avec ses vastes terrains connect\u00e9s \u00e0 la voie d\u2019eau pour accueillir des entreprises et jouer un r\u00f4le d\u2019approvisionnement de la ville en mat\u00e9riaux et marchandises.\r\nC'est ce que nous avons l'intention de d\u00e9couvrir lors de cette balade avec Inter-Environnement Bruxelles le 24 septembre prochain en explorant les quartiers autour de Tour et Taxis et de la tour Up-SIte!\r\n\r\nINFORMATIONS\/R\u00c9SERVATION sur casiuo1970@gmail.com\r\nLA BALADE EST GRATUITE\r\nAvec le soutien de la F\u00e9d\u00e9ration Wallonie Bruxelles","performers":null,"boxoffice_url":null,"website":"https:\/\/casi-uo.com\/","email":"casiuo1970@gmail.com","phone_contact":"+32 475 46 79 48","phone_booking":"+32 475 46 79 48","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.540097"},"nl":{"name":"Balade anti-sp\u00e9culative le long du canal #2","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.540097"},"en":{"name":"Balade anti-sp\u00e9culative le long du canal #2","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.540097"},"de":{"name":"Balade anti-sp\u00e9culative le long du canal #2","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.540097"},"it":{"name":"Balade anti-sp\u00e9culative le long du canal #2","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.540097"},"sp":{"name":"Balade anti-sp\u00e9culative le long du canal #2","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.540097"},"pt":{"name":"Balade anti-sp\u00e9culative le long du canal #2","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"ht