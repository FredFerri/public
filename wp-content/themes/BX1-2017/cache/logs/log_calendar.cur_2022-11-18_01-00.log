8 ans"],"nl":["Familie","Senioren","LGTBQIA","Jongeren 12-15 j.","Jongeren 15-18 j."],"en":["Family","Seniors","LGTBQIA","Youth 12-15  yr.","Youth 15-18  yr."]}},"tags":["kids"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-11-02T16:05:06+01:00","published_at":"2022-11-02T16:00:30+01:00","backoffice_id":264452,"import_origin":null,"sub_type":"concert","show_in_agenda":true,"ranking":1.2599210498949},{"id":541478,"date_start":"2022-11-19","date_end":"2022-11-19","date_next":"2022-11-19","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater"}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"],"de":["Theater"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Norman c'est comme normal, \u00e0 une lettre pr\u00e8s","shortdescr":"Norman (qui n\u2019est pas normand) est un petit gar\u00e7on assez banal, mais Norman aime porter des robes.\r\n\r\nSur le chemin de l\u2019\u00e9cole, il tournicote, plus \u00e7a vole, plus c\u2019est chouette, plus c\u2019est a\u00e9rien, plus c\u2019est gai, tout le monde vous le dira, \u00e7a donne le sentiment de s\u2019envoler. Aujourd\u2019hui, le p\u00e8re de Norman a d\u00e9cid\u00e9 d\u2019accompagner son fils en robe aussi.","longdescr":"Norman (qui n\u2019est pas normand) est un petit gar\u00e7on assez banal, mais Norman aime porter des robes.\r\n\r\nSur le chemin de l\u2019\u00e9cole, il tournicote, plus \u00e7a vole, plus c\u2019est chouette, plus c\u2019est a\u00e9rien, plus c\u2019est gai, tout le monde vous le dira, \u00e7a donne le sentiment de s\u2019envoler. Aujourd\u2019hui, le p\u00e8re de Norman a d\u00e9cid\u00e9 d\u2019accompagner son fils en robe aussi.\r\n\r\nIl ne supporte plus les regards lanc\u00e9s comme des lames sur son fils\u2026\r\n\r\n\u00c0 travers l\u2019anecdote du v\u00eatement, ce spectacle questionne le rapport \u00e0 la norme, l\u2019acceptation de la diff\u00e9rence et les codes culturels d\u2019appartenance aux genres. Jamais didactique, encore moins moralisateur, Norman c\u2019est comme normal, \u00e0 une lettre pr\u00e8s privil\u00e9gie l\u2019humour, la danse, les jeux de mots et de narration. Une envol\u00e9e l\u00e9g\u00e8re comme du tulle, inattendue de bout en bout.","performers":"Kosmocompany\r\nAvec Antoine Cogniaux, Deborah Marchal et Lylybeth Merle. Mise en sc\u00e8ne et chor\u00e9graphie\u200a: Cl\u00e9ment Thirion. Texte\u200a: Marie Henry. Direction technique et lumi\u00e8re\u200a: Gaspard Schelck. Son\u200a: Thomas Turine. Sc\u00e9nographie et costumes\u200a: Katrijn Baeten et Saskia Louwaard.","boxoffice_url":null,"website":"https:\/\/lamontagnemagique.be\/norman-cest-comme-normal-a-une-lettre-pres-3\/","email":"info@montagnemagique.be","phone_contact":null,"phone_booking":"+32 2 210 15 90","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.541478"},"nl":{"name":"Norman c'est comme normal, \u00e0 une lettre pr\u00e8s","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.541478"},"en":{"name":"Norman c'est comme normal, \u00e0 une lettre pr\u00e8s","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.541478"},"de":{"name":"Norman c'est comme normal, \u00e0 une lettre pr\u00e8s","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":