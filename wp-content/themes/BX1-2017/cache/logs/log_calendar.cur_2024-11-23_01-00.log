n":["fr"],"subtitles":[]},"categories":{"main":{"id":49,"translations":{"de":"Theater","pt":null,"en":"Theatre","it":"Teatro","cn":null,"fr":"Th\u00e9\u00e2tre","sp":"Teatro","nl":"Theater"}},"others":{}},"translations":{"de":{"name":"Y'a d'la joie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50012202"},"pt":{"name":"Y'a d'la joie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50012202"},"en":{"name":"Y'a d'la joie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50012202"},"it":{"name":"Y'a d'la joie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50012202"},"cn":{"name":"Y'a d'la joie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50012202"},"fr":{"name":"Y'a d'la joie","shortdescr":null,"longdescr":"Dis-moi Charles, y a-t-il a encore de la joie ? Et le Soleil et la Lune, ont-ils toujours rendez-vous ? Et c\u2019est vrai que les po\u00e8tes ont disparu ?\n\nCe \u00e0 quoi vous allez assister n\u2019est ni un concert ni un tour de chant : c\u2019est une source d\u2019euphorie tout droit jaillie de la plume et la verve de Charles Trenet. Greg Houben nous ouvre grandes les vannes d\u2019un torrent de bonne humeur ! Tout est de Charles Trenet. Tout, sauf ce qui est de Greg Houben et \u00c9ric De Staercke.\nEt surtout, ne pensez pas que c\u2019est du fan\u00e9, du d\u00e9pass\u00e9, du surann\u00e9... C\u2019est \u00e9ternel, universel, intemporel. Vous serez plonge\u0301 d\u00e8s la premi\u00e8re seconde dans un r\u00e9servoir de joie, un pipeline de folie, une fontaine d\u2019enthousiasme.\n\nVoici une pantalonnade d\u00e9clar\u00e9e d\u2019int\u00e9r\u00eat public. Si, si, vous voil\u00e0 immerg\u00e9s jusqu\u2019aux oreilles dans un bain de jouvence musical, dont vous sortirez revigor\u00e9s, c\u2019est promis.\n\nAlors, si vous vous demandez s\u2019il y a encore de la joie ici-bas, ce qu\u2019il reste de nos amours, de nos beaux jours, si le Soleil a toujours rendez-vous avec la Lune et si la mer danse \u00e9ternellement le long des golfes clairs ? Venez ! Votre c\u0153ur fera d\u2019autant Boum, qu\u2019il a encore de la joie, parce que les po\u00e8tes, \u00e7a ne disparait pas ! La preuve !\n\nMais oui ! Y a d\u2019la joie. Partout y a d\u2019la joie ! Il suffit pour \u00e7a... d\u2019un peu d\u2019imagination !\n__________\n\nD\u2019apr\u00e8s Charles Trenet \/ Mise en sc\u00e8ne : Eric De Staercke \/ Avec : Greg Houben, Quentin Li\u00e9geois (Guitare) et C\u00e9dric Raymond (Contrebasse) \/ Assistante \u00e0 la mise en sc\u00e8ne : C\u00e9cile Delberghe \/ Lumi\u00e8re : Nicolas Thill \/ Cr\u00e9ation son : Beno\u00eet De Visscher\n__________\n\nUNE PRODUCTION DU TH\u00c9\u00c2TRE LE PUBLIC. AVEC L'AIDE DE LA F\u00c9D\u00c9RATION WALLONIE-BRUXELLES - DIRECTION DU TH\u00c9\u00c2TRE, ET LE SOUTIEN DU TAX SHELTER DE L\u2019\u00c9TAT F\u00c9D\u00c9RAL BELGE VIA BESIDE.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50012202"},"sp":{"name":"Y'a d'la joie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50012202"},"nl":{"name":"Y'a d'la joie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatrelepublic.be\/","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50012202"}},"place":{"id":224476,"translations":{"de":{"name":"Th\u00e9\u00e2tre Le Public","address_street_name":"Rue Braemt","address_street_number":"64 70","address_street_box":null,"email":"contact@theatrelepublic.be","website":"http:\/\/www.theatrelepublic.be","phone_contact":"+32 2 724 24 44","phone_booking":"+32 2 724 24 44","address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Braemt, 64 70","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Th\u00e9\u00e2tre Le Public","address_street_name":"Rue Braemt","address_street_number":"64 70","address_street_box":null,"email":"contact@theatrelepublic.be","website":"http:\/\/www.theatrelepublic.be","phone_contact":"+32 2 724 24 44","phone_booking":"+32 2 724 24 44","address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Braemt, 64 70","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":null,"descriptio