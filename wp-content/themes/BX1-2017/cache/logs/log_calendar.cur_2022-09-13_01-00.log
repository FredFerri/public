ointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{"list":[109],"translations":{"fr":["Espaces verts"],"nl":["Groene zones"],"en":["Green spaces"]}}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Tour guid\u00e9 \u00e0 v\u00e9lo - Bruxelles, au fil de l'eau","shortdescr":"Au cours de ce tour \u00e0 v\u00e9lo, nous passons devant des sources, des fontaines, des \u00e9tangs et d'autres \u00e9l\u00e9ments aquatiques qui nous en disent plus sur notre relation \u00e0 l'eau et sur le regain d'int\u00e9r\u00eat pour l'eau dans la ville.","longdescr":"Sortez des sentiers battus de Bruxelles le dimanche sans voiture et d\u00e9couvrez les perles bleues et l'importance de l'eau dans la ville. Au cours de cette balade \u00e0 v\u00e9lo, vous d\u00e9couvrirez le r\u00f4le important de l'eau dans la naissance et le d\u00e9veloppement de Bruxelles. Au cours de ce tour \u00e0 v\u00e9lo, nous passerons devant des sources, des fontaines, des \u00e9tangs et d'autres \u00e9l\u00e9ments aquatiques qui en disent plus sur notre relation \u00e0 l'eau et sur le regain d'int\u00e9r\u00eat pour l'eau dans la ville.\r\n\r\nR\u00e9servation: info@cactus.brussels \r\n\r\nLangue: FR\/NL\r\nTarif: 8 \u20ac \r\nV\u00e9los disponibles (+5\u20ac)\r\nPauze pr\u00e9vue pendant le tour (+\/- 25min)","performers":null,"boxoffice_url":null,"website":"http:\/\/www.cactus.brussels","email":"info@cactus.brussels","phone_contact":null,"phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.540238"},"nl":{"name":"Gegidste fietstocht - Brussel, langs het water","shortdescr":"Tijdens deze fietstocht fietsen we langs bronnen, fonteinen, vijvers en andere waterpartijen die meer vertellen over onze relatie tot water en over de hernieuwde belangstelling voor water in de stad.","longdescr":"Verlaat de platgetreden paden van de Brussel op de autoloze zondag en ontdek de blauwe parels en het belang van water in de stad. Tijdens deze fietstocht ontdek je de belangrijke rol van water in het ontstaan en de ontwikkeling van de Brussel. Tijdens deze fietstocht fietsen we langs bronnen, fonteinen, vijvers en andere waterpartijen die meer vertellen over onze relatie tot water en over de hernieuwde belangstelling voor water in de stad.\r\n\r\nReserveren? info@cactus.brussels \r\n\r\nTaal: NL\/FR\r\nTarief: 8 \u20ac\r\nFietsen beschikbaar (+5\u20ac)\r\nPauze voorzien onderweg (+\/- 25min.)","performers":null,"boxoffice_url":null,"website":"http:\/\/www.cactus.brussels","email":"info@cactus.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.540238"},"en":{"name":"Tour guid\u00e9 \u00e0 v\u00e9lo - Bruxelles, au fil de l'eau","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.540238"},"de":{"name":"Gegidste fietstocht - Brussel, naar het water","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.540238"},"it":{"name":"Gegidste fietstocht - Brussel, naar het water","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.540238"},"sp":{"name":"Gegidste fietstocht - Brussel, naar het water","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https: