e,"categories":{"main":{"id":90,"translations":{"fr":"Animations","nl":"Animaties","en":"Animations"}},"others":{"list":[93],"translations":{"fr":["Ev\u00e9nement touristique"],"nl":["Toeristisch evenement"],"en":["Tourist event"]}}},"languages":{"spoken":["nl","fr","en"],"subtitles":[]},"translations":{"fr":{"name":"Weekend festif au Logis-Flor\u00e9al: Parcours des talents","shortdescr":"Le Logis-Flor\u00e9al c\u00e9l\u00e8bre ses cent ans ! Un week-end entier d'activit\u00e9s aura lieu dans les cit\u00e9s-jardins.","longdescr":"A l\u2019occasion du 100 e anniversaire des cit\u00e9s -jardins, les Compagnons du quartier Flor\u00e9al et la Soci\u00e9t\u00e9 Coop\u00e9rative Le Logis-Flor\u00e9al vous invitent \u00e0 rencontrer les nombreux talents qui habitent les cit\u00e9s-jardins, lors d\u2019un parcours d\u00e9couverte. Poussez la porte des maisons, rejoignez les jardins en passant par les venelles et d\u00e9couvrez des expositions de peinture, sculpture, photographie, c\u00e9ramique, des concerts, des jardins fleuris, des visites guid\u00e9es\u2026 autant de passions qui animent \u00ab ces talentueux habitants \u00bb.\r\n\r\nPlan de parcours disponible aux deux points de d\u00e9part. \r\nPoints de d\u00e9part : Studio Logis et Visitor Center","performers":null,"boxoffice_url":null,"website":"https:\/\/www.lelogisfloreal.be\/","email":"100ans@lelogisfloreal.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/531991.html"},"nl":{"name":"Feestweekend in Le Logis-Flor\u00e9al: Talententocht","shortdescr":"Le Logis-Flor\u00e9al bestaat 100 jaar en dat mag gevierd worden. Een heel weekend lang vinden er in de tuinwijken heel wat activiteiten plaats.","longdescr":"Ter gelegenheid van de 100ste verjaardag van de tuinwijken nodigen les Compagnons du quartier Flor\u00e9al en de sociale huisvestingsmaatschappij Le Logis-Flor\u00e9al je uit om tijdens een ontdekkingstocht kennis te maken met de vele talenten die in de tuinsteden wonen. Open de deuren van de huizen, ga door de steegjes naar de tuinen en ontdek tentoonstellingen van schilderkunst, beeldhouwkunst, fotografie, keramiek, concerten, bloementuinen, rondleidingen... en zo veel meer!\r\n\r\nPlan van het parcours te verkrijgen aan beide vertrekpunten. \r\nVertrekpunten: Studio Logis en Visitor Center","performers":null,"boxoffice_url":null,"website":"https:\/\/www.lelogisfloreal.be\/","email":"100ans@lelogisfloreal.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/531991.html"},"en":{"name":"Weekend festif au Logis-Flor\u00e9al: Parcours des talents","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/531991.html"},"de":{"name":"Weekend festif au Logis-Flor\u00e9al: Parcours des talents","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/531991.html"},"it":{"name":"Weekend festif au Logis-Flor\u00e9al: Parcours des talents","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/531991.html"},"sp":{"name":"Weekend festif au Logis-Flor\u00e9al: Parcours des talents","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/531991.html"},"pt":{"name":"Weekend festif au Logis-Flor\u00e9al: Parcours des talents","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detai