{"id":552483,"date_start":"2023-03-08","date_end":"2023-03-08","date_next":"2023-03-08","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert","de":"Konzert","it":"Concerti","sp":"Concierto","pt":null,"cn":null}},"others":{}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Idyl","shortdescr":null,"longdescr":"Jeune chanteuse Belge imbib\u00e9e de notes et de m\u00e9lodies depuis sa naissance. L\u2019initiation commence au temps des berceuses chant\u00e9es chaque soir au pieds de la nuit.\r\nDe l\u00e0 se cr\u00e9e un climat de tendresse et de g\u00e9n\u00e9rosit\u00e9. S\u2019en suit une \u00e9ducation musicale classique. Cours de piano et de solf\u00e8ge succ\u00e8dent les longues journ\u00e9es d\u2019\u00e9cole pour aider \u00e0 la construction d\u2019une voix, d\u2019une identit\u00e9 et bient\u00f4t \u00e0 celle d\u2019un r\u00eave. La vraie question est plut\u00f4t \u00ab qu\u2019est ce qu\u2019une idylle ? \u00bb Tout un monde. Tout un conte. L\u00e0 o\u00f9 les mots ont toutes les formes et les pens\u00e9es toutes les couleurs. L\u00e0 o\u00f9 les ambitions peuvent naitre et renaitre. L\u00e0 o\u00f9 les voix font r\u00e9sonner la bienveillance.\r\nUne Terre d\u2019accueil \u00e0 tous les r\u00eaveurs. Une place pour les randonneurs en qu\u00eate de l\u2019infini, cette soif de d\u00e9couverte \u00e9ternelle. Une histoire d\u2019amour avec les secrets du monde, de l\u2019Humain et ses vibrations. Ne faire qu\u2019un avec ce qui nous anime. Son chant. sa voix. Ses mots. Sa fr\u00e9quence. Un son r\u00e9parateur. Voici son Idyl.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.culture1030.be\/","email":"info@culture1030.be","phone_contact":"+32 2 245 27 25","phone_booking":"+32 2 245 27 25","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.552483"},"nl":{"name":"Idyl","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.culture1030.be\/","email":"info@culture1030.be","phone_contact":"+32 2 245 27 25","phone_booking":"+32 2 245 27 25","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.552483"},"en":{"name":"Idyl","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.culture1030.be\/","email":"info@culture1030.be","phone_contact":"+32 2 245 27 25","phone_booking":"+32 2 245 27 25","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.552483"},"de":{"name":"Idyl","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.culture1030.be\/","email":"info@culture1030.be","phone_contact":"+32 2 245 27 25","phone_booking":"+32 2 245 27 25","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.552483"},"it":{"name":"Idyl","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.culture1030.be\/","email":"info@culture1030.be","phone_contact":"+32 2 245 27 25","phone_booking":"+32 2 245 27 25","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.552483"},"sp":{"name":"Idyl","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.culture1030.be\/","email":"info@culture1030.be","phone_contact":"+32 2 245 27 25","phone_booking":"+32 2 245 27 25","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.552483"},"pt":{"name":"Idyl","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.culture1030.be\/","email":"info@culture1030.be","phone_contact":"+32 2 245 27 25","phone_booking":"+32 2 245 27 25","agenda_url":"ht