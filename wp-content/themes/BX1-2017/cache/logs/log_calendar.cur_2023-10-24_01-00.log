ion_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":282519,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"theatre","ranking":0.15769573216382957,"languages":{"spoken":["en","fr"],"subtitles":[]},"categories":{"main":{"id":49,"translations":{"de":"Theater","pt":null,"en":"Theatre","it":"Teatro","cn":null,"fr":"Th\u00e9\u00e2tre","sp":"Teatro","nl":"Theater"}},"others":{}},"translations":{"de":{"name":"Formation professionnelle de l\u2019acteur au cin\u00e9ma en cours du jour","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.scenocity.be","email":"contact@scenocity.be","phone_contact":"+32 473 27 20 91","phone_booking":"+32 2 732 47 73","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50000495"},"pt":{"name":"Formation professionnelle de l\u2019acteur au cin\u00e9ma en cours du jour","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.scenocity.be","email":"contact@scenocity.be","phone_contact":"+32 473 27 20 91","phone_booking":"+32 2 732 47 73","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50000495"},"en":{"name":"Formation professionnelle de l\u2019acteur au cin\u00e9ma en cours du jour","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.scenocity.be","email":"contact@scenocity.be","phone_contact":"+32 473 27 20 91","phone_booking":"+32 2 732 47 73","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50000495"},"it":{"name":"Formation professionnelle de l\u2019acteur au cin\u00e9ma en cours du jour","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.scenocity.be","email":"contact@scenocity.be","phone_contact":"+32 473 27 20 91","phone_booking":"+32 2 732 47 73","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50000495"},"cn":{"name":"Formation professionnelle de l\u2019acteur au cin\u00e9ma en cours du jour","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.scenocity.be","email":"contact@scenocity.be","phone_contact":"+32 473 27 20 91","phone_booking":"+32 2 732 47 73","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50000495"},"fr":{"name":"Formation professionnelle de l\u2019acteur au cin\u00e9ma en cours du jour","shortdescr":"Dans cet espace de jeu cin\u00e9matographique, nous r\u00e9aliserons  votre bande d\u00e9mo compos\u00e9e d\u2019une \u00e0 deux sc\u00e8nes de film, de s\u00e9rie TV, un monologue, une sc\u00e8ne de film jamais jou\u00e9e, plus les tournages professionnelles qui pourront se r\u00e9aliser.\nVous terminerez votre cycle avec votre CV papier, votre site internet, votre bande d\u00e9mo et un shooting photo en juin. Finalit\u00e9 un film \u00e0 pr\u00e9senter en Festival.\n","longdescr":"\u2022\tFinalit\u00e9 un court m\u00e9trage original destin\u00e9 \u00e0 un Festival International du Film. La saison 2022\/23 \u00e0 permis au \u00e9l\u00e8ves d\u2019\u00eatre en comp\u00e9tition au Ramdam Tournai Film  Festival et nous sommes en comp\u00e9tition au Festival International de l\u2019Espoir les 21, 22 et 23 septembre avec le film \"Putain d'amendement\" r\u00e9alis\u00e9 par Philippe Cornette, Festival organis\u00e9 par L\u2019UNESCO. Un troisi\u00e8me film est en post-production.\nVous allez vivre le jeu et les techniques pour \u00e9viter les blocages face \u00e0 la cam\u00e9ra. Cette approche pour un acteur, c\u2019est la diff\u00e9rence entre un musicien qui pratique la guitare dans sa chambre et un musicien qui joue un concert en direct devant un public.\nNous travaillerons : les lignes d\u2019actions physiques, la pr\u00e9paration et les r\u00e9p\u00e9titions.\nL\u2019objectif, le surobjectif, le verbe d\u2019action, les besoins.\nLe travail \u00e9motionnel. La m\u00e9moire sensorielle et affective. Le verbe dans l\u2019art de l\u2019acteur.\nLa pr\u00e9paration aux diff\u00e9rents castings.\nVous participerez a des activit\u00e9s suivant l\u2019actualit\u00e9, participation \u00e0 des festivals (du film Cor\u00e9en, Festival Memorium, Festival du court m\u00e9trage de Bruxelles, Ramdam Tournai film Festival, etc), \u00e0 la projection de films et rencontres avec des acteurs, producteurs, autres au cin\u00e9ma galerie \u00e0 la Cinematek dont vous aurez la carte de membre et o\u00f9 les r\u00e9alisations seront projet\u00e9es .\n\u2022\tNous travaillerons : Les circonstances propos\u00e9es, les \u00e9v\u00e8nements, les r\u00e9p\u00e9titions par l\u2019\u00e9tude, le monologue int\u00e9rieur. Une nouvelle approche de jeu pour une dramaturgie contemporaine. La performativit\u00e9 et des exercices d\u2019explorations intelligentes.\n\u2022\tIntervention des trois moteurs : De l\u2019Intelligence \u2013 De la Volont\u00e9 \u2013 De l\u2019Affectivit\u00e9.\n\u2022\tRecourir \u00e0 l\u2019action en elle-m\u00eame pour agir.\n\u2022\tLe si magique \u2013 Les circonstances donn\u00e9es \u2013 M\u00e9moire \u00e9motionnelle affective.\n1.\tVotre demande se fera par Email, t\u00e9l\u00e9phone ou sur la page Contact comprenant votre motivation.\n2.\tUn CV et une photo.\n3.\tLa participation \u00e0 un stage permet d\u2019int\u00e9grer la formation professionnelle de l\u2019acteur d\u00e8s octobre 2023. Ils seront re\u00e7us sur validation de l\u2019\u00e9quipe Scenocity.\n4.\tL\u2019\u2019\u00e9l\u00e8ve sera convi\u00e9 \u00e0 un entretien de s\u00e9lection et sera invit\u00e9 \u00e0 passer une audition. L\u2019audition consiste en un monologue travaill\u00e9 pr\u00e9alablement avec un coach. FORMATION INTENSIVE FORMULE 20h acad\u00e9miques\/SEM\nPROCHAINE RENTR\u00c9E LE 17 OCTOBRE 2023 \u2013 FIN DES COURS LE 27 JUIN 2024.\n","performers":"Philippe Cornette (Cin\u00e9aste, metteur en sc\u00e8ne, acteur et auteur); Pierre Lekeux (Acteur, Producteur); Serge Pierre (Acteur); C\u00e9dric Cerbara (Acteur, chor\u00e9graphe de cascades)","boxoffice_url":null,"website":"https:\/\/www.scenocity.be","email":"contact@scenocity.be","phone_contact":"+32 473 27 20 91","phone_booking":"+32 2 732 47 73","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50000495"},"sp":{"name":"Formation professionnelle de l\u2019acteur au cin\u00e9ma en cours du jour","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.scenocity.be","email":"contact@scenocity.be","phone_contact":"+32 473 27 20 91","phone_booking":"+32 2 732 47 73","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50000495"},"nl":{"name":"Formation professionnelle de l\u2019acteur au cin\u00e9ma en cours du jour","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.scenocity.be","email":"contact@scenocity.be","phone_contact":"+32 473 27 20 91","phone_booking":"+32 2 732 47 73","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50000495"}},"place":{"id":269799,"translations":{"de":{"name":"Salle paroissiale","address_street_name":"rue Jacques Hoton","address_street_number":"11","address_street_box":null,"email":null,"website":null,"phone_contact":"+32 2 771 63 75","phone_booking":"+32 2 771 63 75","address_zip":"1200","address_city":"Woluwe-Saint-Lambert","address_line1":"rue Jacques Hoton, 11","address_line2":"1200 Woluwe-Saint-Lambert","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Salle paroissiale Sainte Famille","address_street_name":"rue Jacques Hoton","address_street_number":"11","address_street_box":null,"email":null,"website":null,"phone_contact":"+32 2 771 63 75","phone_booking":"+32 2 771 63 75","address_zip":"1200","address_city":"Woluwe-Saint-Lambert","address_li