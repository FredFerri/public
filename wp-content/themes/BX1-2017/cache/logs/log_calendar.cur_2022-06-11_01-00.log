ermaal-Bosvoorde","description_web":"Gesticht in 1991 door \u00e9\u00e9n van de grootste violisten van de 20ste eeuw, wil \r\ndeze stichting een stem geven aan kinderen, culturele minderheden en artiesten uit alle kunstdisciplines d.m.v. de co\u00f6rdinatie, het op poten zetten en het verspreiden van culturele en humanitaire ondernemingen in de geest van Yehudi Menuhin.\r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"International Yehudi Menuhin Foundation (IYMF)","address_street_name":"Boulevard du Souverain","address_street_number":"36","address_street_box":null,"email":"info@menuhin-foundation.com","website":"http:\/\/www.menuhin-foundation.com","phone_contact":"+32 2 673 35 04","phone_booking":null,"address_zip":"1170","address_city":"Watermael-Boitsfort","address_line1":"Boulevard du Souverain, 36","address_line2":"1170 Watermael-Boitsfort","description_web":"The International Yehudi Menuhin Foundation empowers children, cultural minorities and artists across all disciplines to collaborate in new ways and to build bridges towards greater understanding and world peace. Art is the starting and ending point.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"International Yehudi Menuhin Foundation (IYMF)","address_street_name":"Boulevard du Souverain","address_street_number":"36","address_street_box":null,"email":"info@menuhin-foundation.com","website":"http:\/\/www.menuhin-foundation.com","phone_contact":"+32 2 673 35 04","phone_booking":null,"address_zip":"1170","address_city":"Watermael-Boitsfort","address_line1":"Boulevard du Souverain, 36","address_line2":"1170 Watermael-Boitsfort","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"International Yehudi Menuhin Foundation (IYMF)","address_street_name":"Boulevard du Souverain","address_street_number":"36","address_street_box":null,"email":"i