m","phone_contact":"+32 475 53 19 88","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50012547"},"sp":{"name":"Season XXX \u2013 Salon d\u2019Automne : Artists and Designers in Dialogue, Group Show","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/spazionobile.com\/","email":"lc@spazionobile.com","phone_contact":"+32 475 53 19 88","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50012547"},"nl":{"name":"Season XXX \u2013 Salon d\u2019Automne : Artists and Designers in Dialogue, Group Show","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/spazionobile.com\/","email":"lc@spazionobile.com","phone_contact":"+32 475 53 19 88","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50012547"}},"place":{"id":265998,"translations":{"de":{"name":"Spazio Nobile Gallery, Contemporary Applied Arts","address_street_name":"Rue Franz Merjay","address_street_number":"142","address_street_box":null,"email":"lc@spazionobile.com","website":"www.spazionobile.com","phone_contact":"+32 2 768 25 10","phone_booking":"+32 475 53 19 88","address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Franz Merjay, 142","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Spazio Nobile Gallery, Contemporary Applied Arts","address_street_name":"Rue Franz Merjay","address_street_number":"142","address_street_box":null,"email":"lc@spazionobile.com","website":"www.spazionobile.com","phone_contact":"+32 2 768 25 10","phone_booking":"+32 475 53 19 88","address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Franz Merjay, 142","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Spazio Nobile Gallery, Contemporary Applied Arts","address_street_name":"Franz Merjaystraat","address_street_number":"142","address_street_box":null,"email":"lc@spazionobile.com","website":"www.spazionobile.com","phone_contact":"+32 2 768 25 10","phone_booking":"+32 475 53 19 88","address_zip":"1050","address_city":"Ixelles","address_line1":"Franz Merjaystraat, 142","address_line2":"1050 Ixelles","description_web":"Spazio Nobile Gallery for applied art, design and photography..\r\nA space dedicated to culture and creation\r\n\r\nHighlighting expertise in design and the applied arts (glass, metal, wood, ceramic, etc.) as well as in photography, Spazio Nobile Gallery aims to create a dialogue between diverse disciplines; a harmonious melange of contemporaneity and sense of history.\r\n\r\nSpazio Nobile Gallery is the shared project of a couple made up of two art historians who have taken complementary paths in their own lives. With more than 20-years in the field of art and design, Lise Coirier has focussed her career on spotlighting designers who infuse matter with form and life. Her husband, Gian Giuseppe Simeone, followed a parallel journey, concentrating on the preservation of cultural and artistic heritage but also public awareness.\r\n","description_print":"Spazio Nobile Gallery for applied art, design and photography opens its doors.\r\nA space dedicated to culture and creation\r\n\r\nHighlighting expertise in design and the applied arts (glass, metal, wood, ceramic, etc.) as well as in photography, Spazio Nobile aims to create a dialogue between diverse disciplines; a harmonious melange of contemporaneity and sense of history.\r\n\r\nSpazio Nobile is the shared project of a couple made up of two art historians who have taken complementary paths in their own lives. With more than 20-years in the field of art and design, Lise Coirier has focussed her career on spotlighting designers who infuse matter with form and life. Her husband, Gian Giuseppe Simeone, followed a parallel journey, concentrating on the preservation of cultural and artistic heritage but also public awareness.\r\n\r\n","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Spazio Nobile Gallery, Contemporary Applied Arts","address_street_name":"Rue Franz Merjay","address_street_number":"142","address_street_box":null,"email":"lc@spazionobile.com","website":"www.spazionobile.com","phone_contact":"+32 2 768 25 10","phone_booking":"+32 475 53 19 88","address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Franz Merjay, 142","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Spazio Nobile Gallery, Contemporary Applied Arts","address_street_name":"Rue Franz Merjay","address_street_number":"142","address_street_box":null,"email":"lc@spazionobile.com","website":"www.spazionobile.com","phone_contact":"+32 2 768 25 10","phone_booking":"+32 475 53 19 88","address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Franz Merjay, 142","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Spazio Nobile Gallery, Contemporary Applied Arts","address_street_name":"Rue Franz Merjay","address_street_number":"142","address_street_box":null,"email":"lc@spazionobile.com","website":"www.spazionobile.com","phone_contact":"+32 2 768 25 10","phone_booking":"+32 475 53 19 88","address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Franz Merjay, 142","address_line2":"1050 Ixelles","description_web":"Spazio Nobile Gallery, la galerie d\u2019arts appliqu\u00e9s, de design et de photographie.\r\nUn espace d\u00e9di\u00e9 \u00e0 la culture de la cr\u00e9ation\r\n\r\nMettant \u00e0 l\u2019honneur la cr\u00e9ation et le savoir-faire tant dans le design et les arts appliqu\u00e9s (verre, m\u00e9tal, bois, c\u00e9ramique\u2026) que dans la photographie, Spazio Nobile a pour ambition de faire dialoguer ces diff\u00e9rentes disciplines en m\u00ealant harmonieusement la contemporan\u00e9it\u00e9 et le sensde l\u2019histoire.\r\n\r\nSpazio Nobile Gallery, c\u2019est tout d\u2019abord le projet partag\u00e9 d\u2019un couple d\u2019historiens de l\u2019art aux parcours on ne peut plus compl\u00e9mentaires. Active depuis plus de 20 ans dans le domaine du design et de la cr\u00e9ation, Lise Coirier s\u2019investit depuis le d\u00e9but de sa carri\u00e8re pour mettre en \u00e9vidence ces cr\u00e9ateurs qui insufflent forme et vie \u00e0 la mati\u00e8re. Son mari, Gian Giuseppe Simeone, suit une voie parall\u00e8le, ax\u00e9e davantage sur la sauvegarde et la mise en valeur du patrimoine culturel et artistique, ainsi que leur diffusion vers les publics.\r\n\r\n","description_print":"Spazio Nobile Gallery, la galerie d\u2019arts appliqu\u00e9s, de design et de photographie.\r\nUn espace d\u00e9di\u00e9 \u00e0 la culture de la cr\u00e9ation\r\n\r\nMettant \u00e0 l\u2019honneur la cr\u00e9ation et le savoir-faire tant dans le design et les arts appliqu\u00e9s (verre, m\u00e9tal, bois, c\u00e9ramique\u2026) que dans la photographie, Spazio Nobile a pour ambition de faire dialoguer ces diff\u00e9rentes disciplines en m\u00ealant harmonieusement la contemporan\u00e9it\u00e9 et le sensde l\u2019histoire.\r\n\r\nSpazio Nobile, c\u2019est tout d\u2019abord le projet partag\u00e9 d\u2019un couple d\u2019historiens de l\u2019art aux parcours on ne peut plus compl\u00e9mentaires. Active depuis plus de 20 ans dans le domaine du design et de la cr\u00e9ation, Lise Coirier s\u2019investit depuis le d\u00e9but de sa carri\u00e8re pour mettre en \u00e9vidence ces cr\u00e9ateurs qui insufflent forme et vie \u00e0 la mati\u00e8re. Son mari, Gian Giuseppe Simeone, suit une voie parall\u00e8le, ax\u00e9e davantage sur la sauvegarde et la mise en valeur du patrimoine culturel et artistique, ainsi que leur diffusion vers les publics.\r\n","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Spazio Nobile Gallery, Contemporary Applied Arts","address_street_name":"Rue Franz Merjay","address_street_number":"142","address_street_box":null,"email":"lc@spazionobile.com","website":"www.spazionobile.com","phone_contact":"+32 2 768 25 10","phone_booking":"+32 475 53 19 88","address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Franz Merjay, 142","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Spazio Nobile Gallery, Contemporary Applied Arts","address_street_name":"Franz Merjaystraat","address_street_number":"142","address_street_box":null,"email":"lc@spazionobile.com","website":"www.spazionobile.com","phone_contact":"+32 2 768 25 10","phone_booking":"+32 475 53 19 88","address_zip":"1050","address_city":"Elsene","address_line1":"Franz Merjaystraat, 142","address_line2":"1050 Elsene","description_web":"Spazio Nobile Gallery, de Galerij voor toegepaste kunst, design en fotografie.\r\nEen oase gewijd aan de cultuur van het cre\u00ebren. \r\n\r\nSpazio Nobile Gallery ambieert een oord van kruisbestuiving en dialoog tussen de verschillende\r\ndisciplines design, toegepaste kunst ( metaal, glas, hout en keramiek ) en fotografie, waarbij het accent gelegd wordt op creatie en know-how, en heden en verleden harmonieus samenvloeien.\r\n\r\nSpazio Nobile Gallery is in de eerste plaats het gezamenlijke project van een uiterst complementair koppel kunsthistorici. Lise Coirier is reeds meer dan 20 jaar actief in de wereld van design en creatie. Sinds het begin van haar carri\u00e8re ijvert ze om de ontwerpers, die de materie vorm en leven inblazen, in het voetlicht te plaatsen. Haar echtgenoot Gian Giuseppe Simeone volgt een gelijkaardig traject, maar richt zich eerder op het behoud en de waardering van het artistieke en culturele patrimonium, en hun publieke verspreiding. \r\n","description_print":"Spazio Nobile Gallery, de Galerij voor toegepaste kunst, design en fotografie.\r\nEen plek gewijd aan de cultuur van het cre\u00ebren. \r\n\r\nSpazio Nobile ambieert een oord van kruisbestuiving en dialoog tussen de verschillende\r\ndisciplines design, toegepaste kunst ( metaal, glas, hout en keramiek ) en fotografie, waarbij het accent gelegd wordt op creatie en know-how, en heden en verleden harmonieus samenvloeien.\r\n\r\nSpazio Nobile is in de eerste plaats het gezamenlijke project van een uiterst complementair koppel kunsthistorici. Lise Coirier is reeds meer dan 20 jaar actief in de wereld van design en creatie. Sinds het begin van haar carri\u00e8re ijvert ze om de ontwerpers, die de materie vorm en leven inblazen, in het voetlicht te plaatsen. Haar echtgenoot Gian Giuseppe Simeone volgt een gelijkaardig traject, maar richt zich eerder op het behoud en de waardering van het artistieke en culturele patrimonium, en hun publieke verspreiding. \r\n\r\nMeer dan een \u201cgalerij\u201d in de gewone zin van het woord, wenst Spazio Nobile een plaats te worden waar werk en leven in elkaar overvloeien, waar kennis wordt uitgewisseld, een\r\nesthetische confrontatie opgevat als een volwaardige culturele en zintuigelijke ervaring.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[6],"translations":{"de":["Chatelain\/Bailli"],"pt":[null],"en":["Chatelain\/Bailli"],"it":["Chatelain\/Bailli"],"cn":[null],"fr":["Chatelain\/Bailli"],"sp":["Ch\u00e2telain\/Bailli"],"nl":["Kasteleinswijk\/Baljuw"]}},"zones":{"list":[21],"translations":{"de":["S\u00fcden"],"pt":[null],"en":["South"],"it":["Sud"],"cn":[null],"fr":["Sud"],"sp":["Sur"],"nl":["Zuid"]}},"neca":"gallery","facebook_id":null,"backoffice_id":25998,"location":{"lat":50.8167139,"lon":4.3520211},"region":"brussels","last_updated_at":"2024-09-23T08:45:00+02:00","published_at":"2016-06-03T14:55:14+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":false,"resto_ranking":0},"organizer":{"id":265998,"translations":{"de":{"name":"Spazio Nobile Gallery, Contemporary Applied Arts","address_street_name":"Rue Franz Merjay","address_street_number":"142","address_street_box":null,"email":"lc@spazionobile.com","website":"www.spazionobile.com","phone_contact":"+32 2 768 25 10","phone_booking":"+32 475 53 19 88","address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Franz Merjay, 142","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Spazio Nobile Gallery, Contemporary Applied Arts","address_street_name":"Rue Franz Merjay","address_street_number":"142","address_street_box":null,"email":"lc@spazionobile.com","website":"www.spazionobile.com","phone_contact":"+32 2 768 25 10","phone_booking":"+32 475 53 19 88","address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Franz Merjay, 142","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Spazio Nobile Gallery, Contemporary Applied Arts","address_street_name":"Franz Merjaystraat","address_street_number":"142","address_street_box":null,"email":"lc@spazionobile.com","website":"www.spazionobile.com","phone_contact":"+32 2 768 25 10","phone_booking":"+32 475 53 19 88","address_zip":"1050","address_city":"Ixelles","address_line1":"Franz Merjaystraat, 142","address_line2":"1050 Ixelles","description_web":"Spazio Nobile Gallery for applied art, design and photography..\r\nA space dedicated to culture and creation\r\n\r\nHighlighting expertise in design and the applied arts (glass, metal, wood, ceramic, etc.) as well as in photography, Spazio Nobile Gallery aims to create a dialogue between diverse disciplines; a harmonious melange of contemporaneity and sense of history.\r\n\r\nSpazio Nobile Gallery is the shared project of a couple made up of two art historians who have taken complementary paths in their own lives. With more than 20-years in the field of art and design, Lise Coirier has focussed her career on spotlighting designers who infuse matter with form and life. Her husband, Gian Giuseppe Simeone, followed a parallel journey, concentrating on the preservation of cultural and artistic heritage but also public awareness.\r\n","description_print":"Spazio Nobile Gallery for applied art, design and photography opens its doors.\r\nA space dedicated to culture and creation\r\n\r\nHighlighting expertise in design and the applied arts (glass, metal, wood, ceramic, etc.) as well as in photography, Spazio Nobile aims to create a dialogue between diverse disciplines; a harmonious melange of contemporaneity and sense of history.\r\n\r\nSpazio Nobile is the shared project of a couple made up of two art historians who have taken complementary paths in their own lives. With more than 20-years in the field of art and design, Lise Coirier has focussed her career on spotlighting designers who infuse matter with form and life. Her husband, Gian Giuseppe Simeone, followed a parallel journey, concentrating on the preservation of cultural and artistic heritage but also public awareness.\r\n\r\n","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Spazio Nobile Gallery, Contemporary Applied Arts","address_street_name":"Rue Franz Merjay","address_street_number":"142","address_street_box":null,"email":"lc@spazionobile.com","website":"www.spazionobile.com","phone_contact":"+32 2 768 25 10","phone_booking":"+32 475 53 19 88","address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Franz Merjay, 142","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Spazio Nobile Gallery, Contemporary Applied Arts","address_street_name":"Rue Franz Merjay","address_street_number":"142","address_street_box":null,"email":"lc@spazionobile.com","website":"www.spazionobile.com","phone_contact":"+32 2 768 25 10","phone_booking":"+32 475 53 19 88","address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Franz Merjay, 142","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Spazio Nobile Gallery, Contemporary Applied Arts","address_street_name":"Rue Franz Merjay","address_street_number":"142","address_street_box":null,"email":"lc@spazionobile.com","website":"www.spazionobile.com","phone_contact":"+32 2 768 25 10","phone_booking":"+32 475 53 19 88","address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Franz Merjay, 142","address_line2":"1050 Ixelles","description_web":"Spazio Nobile Gallery, la galerie d\u2019arts appliqu\u00e9s, de design et de photographie.\r\nUn espace d\u00e9di\u00e9 \u00e0 la culture de la cr\u00e9ation\r\n\r\nMettant \u00e0 l\u2019honneur la cr\u00e9ation et le savoir-faire tant dans le design et les arts appliqu\u00e9s (verre, m\u00e9tal, bois, c\u00e9ramique\u2026) que dans la photographie, Spazio Nobile a pour ambition de faire dialoguer ces diff\u00e9rentes disciplines en m\u00ealant harmonieusement la contemporan\u00e9it\u00e9 et le sensde l\u2019histoire.\r\n\r\nSpazio Nobile Gallery, c\u2019est tout d\u2019abord le projet partag\u00e9 d\u2019un couple d\u2019historiens de l\u2019art aux parcours on ne peut plus compl\u00e9mentaires. Active depuis plus de 20 ans dans le domaine du design et de la cr\u00e9ation, Lise Coirier s\u2019investit depuis le d\u00e9but de sa carri\u00e8re pour mettre en \u00e9vidence ces cr\u00e9ateurs qui insufflent forme et vie \u00e0 la mati\u00e8re. Son mari, Gian Giuseppe Simeone, suit une voie parall\u00e8le, ax\u00e9e davantage sur la sauvegarde et la mise en valeur du patrimoine culturel et artistique, ainsi que leur diffusion vers les publics.\r\n\r\n","description_print":"Spazio Nobile Gallery, la galerie d\u2019arts appliqu\u00e9s, de design et de photographie.\r\nUn espace d\u00e9di\u00e9 \u00e0 la culture de la cr\u00e9ation\r\n\r\nMettant \u00e0 l\u2019honneur la cr\u00e9ation et le savoir-faire tant dans le design et les arts appliqu\u00e9s (verre, m\u00e9tal, bois, c\u00e9ramique\u2026) que dans la photographie, Spazio Nobile a pour ambition de faire dialoguer ces diff\u00e9rentes disciplines en m\u00ealant harmonieusement la contemporan\u00e9it\u00e9 et le sensde l\u2019histoire.\r\n\r\nSpazio Nobile, c\u2019est tout d\u2019abord le projet partag\u00e9 d\u2019un couple d\u2019historiens de l\u2019art aux parcours on ne peut plus compl\u00e9mentaires. Active depuis plus de 20 ans dans le domaine du design et de la cr\u00e9ation, Lise Coirier s\u2019investit depuis le d\u00e9but de sa carri\u00e8re pour mettre en \u00e9vidence ces cr\u00e9ateurs qui insufflent forme et vie \u00e0 la mati\u00e8re. Son mari, Gian Giuseppe Simeone, suit une voie parall\u00e8le, ax\u00e9e davantage sur la sauvegarde et la mise en valeur du patrimoine culturel et artistique, ainsi que leur diffusion vers les publics.\r\n","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Spazio Nobile Gallery, Contemporary Applied Arts","address_street_name":"Rue Franz Merjay","address_street_number":"142","address_street_box":null,"email":"lc@spazionobile.com","website":"www.spazionobile.com","phone_contact":"+32 2 768 25 10","phone_booking":"+32 475 53 19 88","address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Franz Merjay, 142","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Spazio Nobile Gallery, Contemporary Appl