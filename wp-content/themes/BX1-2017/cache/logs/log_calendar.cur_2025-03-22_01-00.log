can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2025-03-17T01:00:24+01:00","published_at":"2024-11-26T20:04:48+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":312643,"facebook_link":null,"import_origin":null,"is_part_of":"Art Deco 2025","sub_type":"tour","ranking":0.5,"languages":{"spoken":["nl","en","fr"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{"list":[253],"translations":{"de":["F\u00fchrungen durch Innenr\u00e4ume"],"pt":[null],"en":["Interior guided tours"],"it":["Visite guidate all\u2019interno"],"cn":[null],"fr":["Visites guid\u00e9es d\u2019int\u00e9rieurs"],"sp":["Visitas guiadas en espacios interiores"],"nl":["Interieur rondleidingen"]}}},"translations":{"de":{"name":"Brussels Art Nouveau & Art Deco (BANAD) Festival 2025","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700003983"},"pt":{"name":"Brussels Art Nouveau & Art Deco (BANAD) Festival 2025","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700003983"},"en":{"name":"Brussels Art Nouveau & Art Deco (BANAD) Festival 2025","shortdescr":null,"longdescr":"The unmissable annual event spanning three weekends, the ninth edition of the Brussels Art Nouveau & Art Deco Festival will take place on March 15 & 16; 22 & 23, and 29 & 30, 2025. The BANAD Festival invites you to discover remarkable locations showcasing the Art Nouveau and Art Deco architecture of the Brussels-Capital Region.\n\nOn the agenda: tours of around sixty interiors usually closed to the public (some accessible for the very first time), about twenty thematic guided routes to explore on foot or by bike, original lectures, inclusive and family-friendly activities, and finally the famous Object Fair and the Restorers & Experts Salon.\n\nFollowing the success of the Art Nouveau Year 2023, its international acclaim, and record attendance, Urban and Visit.Brussels are launching an Art Deco Year 2025 in the Brussels-Capital Region to celebrate the 100th anniversary of the 1925 Paris Industrial Exhibition of Decorative Arts. The BANAD 2025 program will thus place greater emphasis on this style.","performers":"The BANAD Festival is organised by Explore.Brussels, a network of associations that organise guided tours: ARAU, Arkadia, Brussels Chatterguides and Pro Velo. For this event, Explore.Brussels will work together with many different partners on the topic of Art Nouveau and Art Deco in Brussels in order to offer a programme of guided tours and events that celebrate these two architectural styles. ","boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/en\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700003983"},"it":{"name":"Brussels Art Nouveau & Art Deco (BANAD) Festival 2025","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700003983"},"cn":{"name":"Brussels Art Nouveau & Art Deco (BANAD) Festival 2025","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700003983"},"fr":{"name":"Brussels Art Nouveau & Art Deco (BANAD) Festival 2025","shortdescr":null,"longdescr":"Incontournable \u00e9v\u00e8nement annuel se d\u00e9clinant sur trois weekends, la neuvi\u00e8me \u00e9dition du Brussels Art Nouveau Art Deco Festival se tiendra les 15 & 16 ; 22 & 23 et 29 & 30 mars 2025. Le BANAD festival est une invitation \u00e0 la d\u00e9couverte de lieux remarquables r\u00e9v\u00e9lant l'architecture Art nouveau et Art D\u00e9co de la R\u00e9gion bruxelloise.\n\nAu programme : les visites d\u2019une soixantaine d\u2019int\u00e9rieurs habituellement ferm\u00e9s au public (dont certains accessibles pour la toute premi\u00e8re fois), une vingtaine de parcours guid\u00e9s th\u00e9matiques \u00e0 suivre \u00e0 pied ou \u00e0 v\u00e9lo, des conf\u00e9rences originales, des activit\u00e9s inclusives et familiales, et enfin les fameuses Foire d\u2019objets et Salon des restaurateurs & experts. \n\nApr\u00e8s le succ\u00e8s de l'Ann\u00e9e Art nouveau 2023, sa notori\u00e9t\u00e9 hors fronti\u00e8re et ses records de fr\u00e9quentation, Urban et Visit.Brussels initient en R\u00e9gion bruxelloise une Ann\u00e9e Art D\u00e9co 2025 c\u00e9l\u00e9brant les 100 ans de l\u2019Exposition Industrielle des Arts D\u00e9coratifs de Paris. Aussi, la programmation du BANAD 2025 mettra davantage ce style en lumi\u00e8re. ","performers":"Le BANAD Festival est organis\u00e9 par Explore.Brussels et ses associations membres : ARAU, Arkadia, Bruxelles Bavard et Pro Velo. Ces associations de visites guid\u00e9es s'associent pour l'occasion avec de nombreux\u00b7ses partenaires actifs autour des th\u00e9matiques Art nouveau et Art D\u00e9co \u00e0 Bruxelles afin de pouvoir proposer ensemble une mise en valeur totale de ces deux mouvements architecturaux.","boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700003983"},"sp":{"name":"Brussels Art Nouveau & Art Deco (BANAD) Festival 2025","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/fr\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700003983"},"nl":{"name":"Brussels Art Nouveau & Art Deco (BANAD) Festival 2025","shortdescr":null,"longdescr":"Het jaarlijkse niet te missen evenement dat zich over drie weekenden uitstrekt, de negende editie van het Brussels Art Nouveau & Art Deco Festival, vindt plaats op 15 & 16; 22 & 23 en 29 & 30 maart 2025. Het BANAD Festival nodigt u uit om opmerkelijke locaties te ontdekken die de Art Nouveau- en Art Deco-architectuur van het Brussels Hoofdstedelijk Gewest onthullen.\n\nOp het programma: rondleidingen door ongeveer zestig interieurs die normaal gesloten zijn voor het publiek (waarvan sommige voor het eerst toegankelijk zijn), een twintigtal thematische gegidste routes te voet of per fiets, originele lezingen, inclusieve en gezinsvriendelijke activiteiten en ten slotte de beroemde Objectenbeurs en het Salon van Restaurateurs & Experts.\n\nNa het succes van het Art Nouveau Jaar 2023, zijn internationale bekendheid en recordbezoek, lanceren Urban en Visit.Brussels in het Brussels Hoofdstedelijk Gewest een Art Deco Jaar 2025 ter ere van de 100e verjaardag van de Industri\u00eble Tentoonstelling van Decoratieve Kunsten in Parijs. Het BANAD 2025-programma zal dan ook meer nadruk leggen op deze stijl.","performers":"Het BANAD Festival is een organisatie van Explore.Brussels en zijn netwerk van organisaties: ARAU, Arkadia, Brussel Babbelt en Pro Velo. Deze netwerk van organisaties voor geleide bezoeken gaat voor deze gelegenheid samenwerken met talloze partners die zich bezighouden met art nouveau en art Deco in Brussel om deze twee architecturale stijlen samen goed in de kijker te kunnen zetten.","boxoffice_url":null,"website":"https:\/\/www.banad.brussels\/nl\/","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700003983"}},"place":{"id":267246,"translations":{"de":{"name":"Explore.brussels ","address_street_name":"Avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"https:\/\/www.explore.brussels\/fr","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Avenue Brugmann, 405","address_line2":"1180 Uccle","description_web":"Explore.Brussels ist ein Zusammenschluss von Vereinen, die qualitativ hochwertige Stadtf\u00fchrungen in der Region Br\u00fcssel-Hauptstadt organisieren.\r\nDie Mitgliedsvereine sind ARAU, Pro Velo, Brussels Chatterguides und Arkadia. Im Jahr 2020 hat sich La Fonderie als Partnerverein angeschlossen.\r\nEntdecken Sie das UNESCO-Weltkulturerbe, Jugendstilarchitektur, die Bauwerke von Victoria Horta, Gem\u00e4lde von Magritte, Comic-Kunst von Herg\u00e9, Streetart, Europa, Bier, Schokolade oder besichtigen Sie architektonische Perlen des Jugendstils, des Art-d\u00e9co oder des Neoklassizismus, die normalerweise nicht f\u00fcr die \u00d6ffentlichkeit zug\u00e4nglich sind. Die F\u00fchrungen werden sowohl f\u00fcr Einzelbesucher als auch f\u00fcr Gruppen angeboten und reichen von klassischen \u00fcber originelle bis hin zu vollkommen neuen Konzepten und Formaten. Neben Stadtf\u00fchrungen zu Fu\u00df sind auch Besichtigungen per Fahrrad, Bus oder Boot m\u00f6glich.\r\nExplore.Brussels organisiert unter anderem auch das Jugendstil- und Art-d\u00e9co-Festival BANAD, die Brussels Biennale - Neoclassic (BBN) sowie weitere Projekte, darunter die Ausbildung von Stadtf\u00fchrern, der \u201eVerein der Freunde\u201c und der \u201eVerein der Eigent\u00fcmer\u201c. \r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Explore.brussels ","address_street_name":"Avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"https:\/\/www.explore.brussels\/fr","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Avenue Brugmann, 405","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Explore.brussels ","address_street_name":"Avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"https:\/\/www.explore.brussels\/fr","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Avenue Brugmann, 405","address_line2":"1180 Uccle","description_web":"Explore.Brussels is a network of guided tour associations in Brussels. This organisation includes ARAU, Arkadia, Bruxelles Bavard, Pro Velo, La Fonderie and Korei. Events are organised in co-production with these 6 companies. Individual or group tours are available on foot, by bike, by bus and by boat.  Visitors discover UNESCO heritage, Magritte, art deco, chocolate and much more. Explore.Brussels also organises Brussels festivals and other large-scale projects.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Explore.brussels ","address_street_name":"Avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"https:\/\/www.explore.brussels\/fr","phone_cont