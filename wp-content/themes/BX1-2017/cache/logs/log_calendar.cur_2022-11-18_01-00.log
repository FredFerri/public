true,"is_in_vb_export":false,"resto_ranking":0},"media":[{"type":"poster","link":"https:\/\/agendabrussels.imgix.net\/d6b9a711a06d92c525c45eebb461984db62be101.jpg","width":755,"height":566,"ratio":1.33,"translations":{"fr":{"title":"Elles","copyright":null},"nl":{"title":"Elles","copyright":null},"en":{"title":"Elles","copyright":null}}}],"dates":[{"day":"2022-11-19","doors":"19:30:00","start":"20:00:00","end":null,"is_soldout":false,"is_canceled":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":{"list":[252,256,257,259,261,263,265],"translations":{"fr":["Accessible aux personnes ayant des difficult\u00e9s de compr\u00e9hension","Am\u00e9nagements pour les personnes aveugles et malvoyantes","Am\u00e9nagements pour personnes sourdes et malentendantes","Chien d'assistance","Parking accessible","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9"],"nl":["Toegankelijk voor mensen met een verstandelijke beperking","Voorzieningen voor blinde en slechtziende personen","Voorzieningen voor dove en slechthorende personen","Assistentiehonden","Toegankelijke parking","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet"],"en":["Accessible to people with intellectual disabilities","Facilities for blind and partially-sighted persons","Facilities for deaf and hearing-impaired people","Assistance dogs","Accessible parking","Accessible to pedestrians with mobility aids","Adapted toilet"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-10T21:36:38+02:00","published_at":"2022-10-10T12:04:25+02:00","backoffice_id":263782,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":1.2599210498949},{"id":540721,"date_start":"2022-11-19","date_end":"2022-11-19","date_next":"2022-11-19","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert","de":"Konzert"}},"others":{"list":[3],"translations":{"fr":["Musique Contemporaine"],"nl":["Hedendaagse Muziek"],"en":["Contemporary music"],"de":["Zeitgen\u00f6ssische Musik"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Br\u00fbler - Danser \u25cf Lisette Lomb\u00e9 & Clo\u00e9 du Tr\u00e8fle","shortdescr":"Le duo Lisette Lomb\u00e9 et Clo\u00e9 du Tr\u00e8fle, c'est la rencontre du slam et de la musique \u00e9lectronique, une rencontre n\u00e9e du confinement.","longdescr":"\"Br\u00fbler Danser, c'est une remontada singuli\u00e8re. Il n'y a pas d'\u00e9quipe adverse. L'ennemi, c'est le temps qui imprime inlassablement sa marque. C'est l'histoire d'une reconqu\u00eate de soi, par le mouvement. Les mots et les sons se frottent. La proposition est organique, puls\u00e9e, port\u00e9e par un duo in\u00e9dit. C'est un voyage au pays de la nuit et de la po\u00e9sie perform\u00e9e. C'est une aube, un espoir de respirer autrement.\" \r\n\r\nLe duo Lisette Lomb\u00e9 et Clo\u00e9 du Tr\u00e8fle, c'est la rencontre du slam et de la musique \u00e9lectronique, une rencontre n\u00e9e du confinement. Le spectacle questionne le temps du post-confinement, le choc post-traumatique collectif et la possibilit\u00e9 de r\u00e9silience. Apr\u00e8s le confinement, il a fallu \u00f4ter nos masques et r\u00e9cr\u00e9er du lien interpersonnel, r\u00e9investir nos espaces de loisirs et de travail pour ensuite tenter de refaire corps social. C\u2019est dans le dialogue entre expression corporelle, musique \u00e9lectronique et po\u00e9sie, dans ce passage d\u2019une grammaire \u00e0 une autre et dans les interstices qui s'y cr\u00e9ent que grandira une parole neuve. \r\n\r\nDans le cadre de Voix Plurielles, en partenariat avec La V\u00e9nerie.","performers":"Lisette Lomb\u00e9 & Clo\u00e9 du Tr\u00e8fle","boxoffice_url":null,"website":"https:\/\/culture.ixelles.be\/fr\/art-boondael\/","email":"culture@ixelles.brussels","phone_contact":null,"phone_booking":"+32 2 515 64 63","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.540721"},"nl":{"name":"Br\u00fbler - Danser \u25cf Lisette Lomb\u00e9 & Clo\u00e9 du Tr\u00e8fle","shortdescr":"Het duo Lisette Lomb\u00e9 en Clo\u00e9 du Tr\u00e8fle is de ontmoeting tussen slam en elektronische muziek, een ontmoeting geboren gedurende de lockdown.","longdescr":"Het duo Lisette Lomb\u00e9 en Clo\u00e9 du Tr\u00e8fle is de ontmoeting tussen slam en elektronische muziek, een ontmoeting geboren gedurende de lockdown. De voorstelling bevraagt de tijd na de lockdown, de collectieve posttraumatische shock en de mogelijkheid van veerkracht. Na de lockdown moesten we onze maskers afzetten en opnieuw in verbinding komen, onze vrijetijds- en werkruimten opnieuw beleggen om vervolgens te trachten ons sociale lichaam opnieuw op te bouwen. Het is in de dialoog tussen lichamelijke expressie, elektronische muziek en po\u00ebzie, in deze overgang van de ene grammatica naar de andere en in de tussenruimten die ontstaan, dat een nieuw woord zal groeien. \r\n\r\nIn het kader van Vrouwenstemmen, in samenwerking met La V\u00e9nerie.","performers":"Lisette Lomb\u00e9 & Clo\u00e9 du Tr\u00e8fle","boxoffice_url":null,"website":"https:\/\/cultuur.elsene.be\/nl\/art-boondael\/","email":"cultuur@elsene.brussels","phone_contact":null,"phone_booking":"+32 2 515 64 63","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.540721"},"en":{"name":"Br\u00fbler - Danser \u25cf Lisette Lomb\u00e9 & Clo\u00e9 du Tr\u00e8fle","shortdescr":"The duo Lisette Lomb\u00e9 and Clo\u00e9 du Tr\u00e8fle is the encounter of slam and electronic music, born during the lockdown.","longdescr":"The duo Lisette Lomb\u00e9 and Clo\u00e9 du Tr\u00e8fle is the encounter of slam and electronic music, born during the lockdown. The show questions the post-lockdown time, the collective post-traumatic shock and the possibility of resilience. After the lockdown, we had to take off our masks and recreate interpersonal links, reinvest our leisure and work spaces to then try to become a social entity again. It is in the dialogue between corporal expression, electronic music and poetry, in this passage from one grammar to another and in the interstices that are created that a new word will grow. \r\n\r\nAs part of Women\u2019s voices, in partnership with La V\u00e9nerie.","performers":"Lisette Lomb\u00e9 & Clo\u00e9 du Tr\u00e8fle","boxoffice_url":null,"website":"https:\/\/culture.ixelles.be\/en\/art-boondael\/","email":"culture@ixelles.brussels","phone_contact":null,"phone_booking":"+32 2 515 64 63","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.540721"},"de":{"name":"Br\u00fbler - Danser \u25cf Lisette Lomb\u00e9 & Clo\u00e9 du Tr\u00e8fle","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.540721"},"it":{"name":"Br\u00fbler - Danser \u25cf Lisette Lomb\u00e9 & Clo\u00e9 du Tr\u00e8fle","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.540721"},"sp":{"name":"Br\u00fbler - Danser \u25cf Lisette Lomb\u00e9 & Clo\u00e9 du Tr\u00e8fle","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.540721"},"pt":{"name":"Br\u00fbler - Danser \u25cf Lisette Lomb\u00e9 & Clo\u00e9 du Tr\u00e8fle","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_ur