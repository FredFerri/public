Cancelleria Vaticana.\nArtiste peintre, plusieurs fois prim\u00e9e, dont les peintures ont \u00e9t\u00e9 expos\u00e9es \u00e0 l\u2019\u00e9chelle internationale.\nL\u2019exposition \u00ab\u00a0La Cantinetta in Arte\u00a0\u00bb se d\u00e9roule \u00e0 une adresse \u00e9l\u00e9gante et ultra authentique pour une balade gourmande italienne.","performers":"L'artiste Chanterax opte pour le Pop, le clin d\u2019oeil  malicieux, le choix r\u00e9fl\u00e9chi et subtil dans sa mani\u00e8re de mettre en valeur ses mod\u00e8les. Curieuse et ouverte aux autres, Chanterax illumine ses tableaux avec force et vigueur par les teintes pures des acryliques et r\u00e9v\u00e8le ce qu\u2019elle d\u00e9couvre en chacun de ses mod\u00e8les.","boxoffice_url":null,"website":"https:\/\/www.instagram.com\/chanterax\/","email":"chantalhem@gmail.com","phone_contact":"+32 493 56 44 93","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700002683"},"sp":{"name":"La Cantinetta in Arte","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.instagram.com\/chanterax\/","email":"chantalhem@gmail.com","phone_contact":"+32 493 56 44 93","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700002683"},"nl":{"name":"La Cantinetta in Arte","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.instagram.com\/chanterax\/","email":"chantalhem@gmail.com","phone_contact":"+32 493 56 44 93","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700002683"}},"place":{"id":50002544,"translations":{"de":{"name":"La Cantinetta","address_street_name":"Rue de la Paix","address_street_number":"24","address_street_box":null,"email":"chantalhem@gmail.com","website":"https:\/\/lacantinetta.be\/fr","phone_contact":"+32 493 56 44 93","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_