ategories":{"main":{"id":90,"translations":{"fr":"Animations","nl":"Animaties","en":"Animations","de":"Animationen","it":"Animazioni","sp":"Animaciones","pt":null,"cn":null}},"others":{}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Initiations aux danses folk et Bal Folk","shortdescr":"7\u00e8me \u00e9dition du Bal Folk du Rayon Vert avec le groupe Bal & Gambettes","longdescr":"On vous propose des danses traditionnelles accompagn\u00e9es en direct par des musiciens. Ils m\u00ealent des danses de couples (polka, scottish) et collectives (bourr\u00e9e, rondeau, etc.). La pr\u00e9sence de vrai.e.s musicien.ne.s du groupe Bal & Gambettes, et non de musique enregistr\u00e9e, est un \u00e9l\u00e9ment clef du succ\u00e8s des bals folk : le lien musicien.ne.s-danseur.euse.s permet d\u2019insuffler l\u2019\u00e9nergie de la musique dans les mouvements de la danse et de s\u2019adapter \u00e0 la rapidit\u00e9 d\u2019apprentissage du groupe.\r\n\r\nVous \u00eates d\u00e9butant.e.s ou simplement curieux de d\u00e9couvrir ces moments de partage conviviaux ? Une animatrice, en plus des musicien.ne.s, assurera une initiation rapide et ludique aux pas de base d\u2019une dizaine de danses typiques, en privil\u00e9giant le plaisir de la danse plut\u00f4t que la technicit\u00e9 ! \u00ab La vari\u00e9t\u00e9 des instruments jou\u00e9s (violon, violoncelle, clarinette, percussions et nyckelharpa) permet diff\u00e9rentes couleurs musicales pour un voyage \u00e0 travers l\u2019Europe musicale : France, Irlande, Italie. \u00bb","performers":"Groupe Bal & Gambettes","boxoffice_url":null,"website":"http:\/\/www.lerayonvert.be\/","email":"lerayonvert@skynet.be","phone_contact":null,"phone_booking":"+32 498 63 75 97","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.550172"},"nl":{"name":"Initiations aux danses folk et Bal Folk","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.lerayonvert.be