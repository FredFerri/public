":258700,"import_origin":null,"sub_type":"concert","show_in_agenda":true,"ranking":1},{"id":542531,"date_start":"2022-10-14","date_end":"2022-10-15","date_next":"2022-10-15","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":118,"translations":{"fr":"Festival","nl":"Festival","en":"Festival","de":"Festival"}},"others":{}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Massimadi : Festival de films et des arts LGBTQ+ d'Afrique et de ses diasporas. 8e \u00e9dition","shortdescr":"L'incontournable des espaces LGBTQIA+ noirs de Bruxelles","longdescr":"Apr\u00e8s deux ann\u00e9es d'absence et une transition g\u00e9n\u00e9rationnelle dans l'\u00e9quipe, Massimadi revient comme \u00e9v\u00e9nement incontournable des espaces LGBTQIA+ noirs de la r\u00e9gion bruxelloise depuis 2013. C'est un festival multidisciplinaire, performatif, \"politique\". C'est le lieu d'expression des identit\u00e9s multiples qui traversent les personnes LGBTQIA+ noires. \r\nPour l'\u00e9dition 2022, nous souhaitons contribuer aux \u00e9changes entre les diff\u00e9rentes g\u00e9n\u00e9rations. En effet, ces expressions ne prennent pas le m\u00eame sens selon que l'on soit n\u00e9 dans les ann\u00e9es 2000, 90, 80, 70 ou m\u00eame avant.\r\nLes espaces du festival offriront donc des occasions de palabrer autour de questions multiples et vari\u00e9es.\r\nVenez donc y contribuer, mais aussi faire la f\u00eate les 14 et 15 octobre 2022.","performers":"Marthe Djilo Kamga (Artiste\/R\u00e9alisatrice); \r\nPatrick Atangana (Artiste peintre);\r\nAdrien Njooh (Artiste plasticien);\r\nPorcelaine id (Artiste musicien);\r\nKevin Mambele (DJ);\r\nKym Mb\u00e9mb\u00e9 (DJ)","boxoffice_url":null,"website":"https:\/\/www.facebook.com\/MassimadiBruxelles\/","email":"massimadi.info@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.542531"},"nl":{"name":"Massimadi : Zwarte LGBTQI+ film- en kunstenfestival uit Afrika en zijn diaspora . 8e editie","shortdescr":"De \"place to be\" in Brussel voor zwarte LGBTQIA+ personen","longdescr":"Na een afwezigheid van twee jaar en een generatiewissel in het team, keert Massimadi  terug als een essentieel evenement voor LGBTQIA + black spaces in de Brusselse regio sinds 2013. Het is een multidisciplinair, performatief, en 'politiek' festival. De plaats waar uitdrukking wordt gegeven aan de meervoudige identiteiten die zwarte LGBTQIA+ mensen doorkruisen.\r\nVoor de editie van 2022 willen we bijdragen tot de wisselwerking tussen de verschillende generaties. Uitdrukkingsvormen hebben namelijk niet dezelfde betekenis naargelang je in de jaren 2000, 90, 80, 70, of zelfs daarvoor geboren bent.\r\nDe festivalruimten zullen de gelegenheid bieden om veelvoudige en gevarieerde onderwerpen te bespreken.\r\nkom erbij en feest mee op 14 en 15 oktober 2022.","performers":"Marthe Djilo Kamga (Artiest\/Cineast); \r\nPatrick Atangana (Kunstschilder);\r\nAdrien Njooh (beeldend Kunstenaar);\r\nPorcelaine id (Artiest muzikant);\r\nKevin Mambele (DJ);\r\nKym Mb\u00e9mb\u00e9 (DJ)","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.542531"},"en":{"name":"Massimadi : Black LGBTQI+ film and arts festival from Africa and its diasporas. 8th \u00e9dition","shortdescr":"The place to be in Brussels for black LGBTQIA+ people","longdescr":"After an absence of two years and a generational transition within the team, Massimadi returns as an essential event for LGBTQIA + black spaces in the Brussels region since 2013. It is a multidisciplinary, performative, and 'political' festival. It is the place to express the multiple identities that black LGBTQIA+ people traverse. \r\nFor the 2022 edition, we want to contribute to the interaction between the different generations. After all, forms of expression do not have the same meaning depending on whether you were born in the 2000s, 90s, 80s, 70s, or even before that.\r\nThe festival spaces will offer opportunities to discuss a wide variety of issues.\r\nCome and take part, but also celebrate with us on  the 14th and 15th October 2022.","performers":"Marthe Djilo Kamga (Artist-Filmmaker); \r\nPatrick Atangana (Artist painter);\r\nAdrien Njooh (Plastic artist);\r\nPorcelaine id (Musician artist);\r\nKevin Mambele (DJ);\r\nKym Mb\u00e9mb\u00e9 (DJ)","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.542531"},"de":{"name":"Massimadi : Festival de films et des arts LGBTQ+ d'Afrique et de ses diasporas. 8e \u00e9dition","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.542531"},"it":{"name":"Massimadi : Festival de films et des arts LGBTQ+ d'Afrique et de ses diasporas. 8e \u00e9dition","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.542531"},"sp":{"name":"Massimadi : Festival de films et des arts LGBTQ+ d'Afrique et de ses diasporas. 8e \u00e9dition","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.542531"},"pt":{"name":"Massimadi : Festival de films et des arts LGBTQ+ d'Afrique et de ses diasporas. 8e \u00e9dit