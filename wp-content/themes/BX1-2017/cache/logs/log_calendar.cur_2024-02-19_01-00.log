e":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":278116,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"theatre","ranking":0.5147142492000893,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":49,"translations":{"de":"Theater","pt":null,"en":"Theatre","it":"Teatro","cn":null,"fr":"Th\u00e9\u00e2tre","sp":"Teatro","nl":"Theater"}},"others":{"list":[50],"translations":{"de":["Theater"],"pt":[null],"en":["Theatre"],"it":["Teatro"],"cn":[null],"fr":["Th\u00e9\u00e2tre"],"sp":["Teatro"],"nl":["Theater"]}}},"translations":{"de":{"name":"La t\u00eate dans le frigo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatrelepublic.be","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.558116"},"pt":{"name":"La t\u00eate dans le frigo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatrelepublic.be","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.558116"},"en":{"name":"La t\u00eate dans le frigo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatrelepublic.be","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.558116"},"it":{"name":"La t\u00eate dans le frigo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatrelepublic.be","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.558116"},"cn":{"name":"La t\u00eate dans le frigo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatrelepublic.be","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.558116"},"fr":{"name":"La t\u00eate dans le frigo","shortdescr":null,"longdescr":"Dans sa maison de retraite, Granny a \u00e9t\u00e9 retrouv\u00e9e morte, la t\u00eate dans le frigo. Bim !\r\nMourir la t\u00eate dans le frigo franchement, a-t-on id\u00e9e !\r\nSa fille, ses deux petites-filles et leur cousine se retrouvent pour organiser les fun\u00e9railles. Un noyau f\u00e9minin explosif qui va faire fondre la glace des non-dits, de la langue de bois et du politiquement correct.\r\n\r\nUn spectacle qui raconte avec une d\u00e9rision bienvenue la p\u00e9riode des fun\u00e9railles. Car quand tout s\u2019arr\u00eate, en fait, rien ne s\u2019arr\u00eate : du cercueil aux derni\u00e8res volont\u00e9s, des pompes fun\u00e8bres \u00e0 l\u2019h\u00e9ritage, du cimeti\u00e8re \u00e0 la vie d\u2019avant, et puis les souvenirs...\r\n\r\n\u00c9crite au cordeau pour quatre com\u00e9diennes \u00e9patantes, la pi\u00e8ce nous parle du chagrin, de la douleur, d\u2019amour. Et l\u2019on rit. Parce que ce n\u2019est jamais facile un enterrement. En cette p\u00e9riode contrast\u00e9e, \u00e7a fait un bien fou.\r\n\r\nLe deuil, tout le monde passe par l\u00e0. C\u2019est une \u00e9preuve, un passage. Faut traverser. Ici c\u2019est le d\u00e9but du voyage, il est lumineux et tendre. Un road trip sur sc\u00e8ne pour un voyage intra-familial et une palette d\u2019actrices qui forment une famille vraie. Un peu comme les n\u00f4tres, en somme.\r\n__________\r\n\r\nDe Julie Dacquin \/ Mise en sc\u00e8ne : Isabelle Paternotte \/ Avec : Julie Dacquin, Alexia Depicker, Jo Deseure et Laure Godisiabois\r\n__________\r\n\r\nUNE COPRODUCTION DU TH\u00c9\u00c2TRE LE PUBLIC ET DE LA COMPAGNIE LES YEUX OUVERTS. AVEC LE SOUTIEN DU TAX SHELTER DE L\u2019\u00c9TAT F\u00c9D\u00c9RAL BELGE VIA BESIDE, DE LA COMMUNAUT\u00c9 FRAN\u00c7AISE. AVEC L\u2019AIDE DE LA F\u00c9D\u00c9RATION WALLONIE-BRUXELLES, SERVICE G\u00c9N\u00c9RAL DE LA CR\u00c9ATION ARTISTIQUE - DIRECTION DU TH\u00c9\u00c2TRE, DE LA SACD, DE PASSA PORTA ET DU CENTRE DES \u00c9CRITURES DRAMATIQUES WALLONIE-BRUXELLES.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatrelepublic.be","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.558116"},"sp":{"name":"La t\u00eate dans le frigo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatrelepublic.be","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.558116"},"nl":{"name":"La t\u00eate dans le frigo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatrelepublic.be","email":"contact@theatrelepublic.be","phone_contact":null,"phone_booking":"+32 2 724 24 44","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.558116"}},"place":{"id":224476,"translations":{"de":{"name":"Th\u00e9\u00e2tre Le Public","address_street_name":"Rue Braemt","address_street_number":"64 70","address_street_box":null,"email":"contact@theatrelepublic.be","website":"http:\/\/www.theatrelepublic.be","phone_contact":"+32 2 724 24 44","phone_booking":"+32 2 724 24 44","address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Braemt, 64 70","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Th\u00e9\u00e2tre Le Public","address_street_name":"Rue Braemt","address_street_number":"64 70","address_street_box":null