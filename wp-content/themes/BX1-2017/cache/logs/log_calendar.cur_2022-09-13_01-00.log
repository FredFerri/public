:false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{"list":[109],"translations":{"fr":["Espaces verts"],"nl":["Groene zones"],"en":["Green spaces"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"PARK TOUR - Visite gratuite au Rouge-Clo\u00eetre","shortdescr":"Certains dimanches de l'\u00e9t\u00e9, Arkadia vous guidera gratuitement dans un ou plusieurs parcs de Bruxelles !","longdescr":"Certains dimanches de l'\u00e9t\u00e9, Arkadia vous guidera gratuitement dans un ou plusieurs parcs de Bruxelles !\nAu d\u00e9part de la Guinguette du Rouge Clo\u00eetre - Bar Jeanne, un guide Arkadia vous fera d\u00e9couvrir l'histoire du parc et de son environnement proche. Il abordera aussi des notions d'\u00e9cologie. Des visites sp\u00e9cialement ax\u00e9es sur l'environnement pour sensibiliser les habitants au respect des espaces verts en ville et au respect de l'environnement :)\nRDV avec le guide, devant le kiosque de la guinguette.R\u00e9servation fortement conseill\u00e9e car les places sont limit\u00e9es!Merci de nous pr\u00e9venir par mail en cas de d\u00e9sistement de derni\u00e8re minute.En cas de pluie les visites sont maintenues.\navec le soutien de Bruxelles Environnement - Leefmilieu Brussel","performers":null,"boxoffice_url":null,"website":"http:\/\/www.arkadia.be","email":"info@arkadia.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.533655"},"nl":{"name":"PARK TOUR - Visite gratuite au Rouge-Clo\u00eetre","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.arkadia.be","email":"info@arkadia.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.533655"},"en":{"name":"PAR