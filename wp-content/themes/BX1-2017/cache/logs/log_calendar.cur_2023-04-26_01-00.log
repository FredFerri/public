ate_end":"2023-04-27","date_next":"2023-04-25","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":118,"translations":{"fr":"Festival","nl":"Festival","en":"Festival","de":"Festival","it":"Festival","sp":"Festival","pt":null,"cn":null}},"others":{"list":[119],"translations":{"fr":["Cin\u00e9ma"],"nl":["Cinema"],"en":["Cinema  "],"de":["Kino"],"it":["Cinema"],"sp":["Cine"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr","en"],"subtitles":[]},"translations":{"fr":{"name":"One World in Brussels 2023","shortdescr":"Le festival de films documentaires One World revient \u00e0 Bruxelles pour sa 16e \u00e9dition. Toutes les projections seront suivies de discussions avec des experts, des cin\u00e9astes, des personnages politiques et des repr\u00e9sentants d'organisations internationales.","longdescr":"L'\u00e9dition de cette ann\u00e9e aura lieu du 20 au 27 avril et se concentrera sur un sujet important dans la soci\u00e9t\u00e9 d'aujourd'hui \u2013 les droits de l'homme. Le festival pr\u00e9sentera 13 films au Parlement europ\u00e9en, au Palais des Beaux-Arts BOZAR, \u00e0 la Repr\u00e9sentation permanente de la R\u00e9publique tch\u00e8que aupr\u00e8s de l'UE et ailleurs. \r\n\r\nProjections gratuites (sauf ouverture \u00e0 Bozar) - r\u00e9servations souhait\u00e9es!","performers":null,"boxoffice_url":null,"website":"https:\/\/www.oneworld.cz\/brussels\/","email":"brussels@oneworld.cz","phone_contact":"+32 2 641 89 47","phone_booking":"+32 2 641 89 47","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.555373"},"nl":{"name":"One World in Brussels 2023","shortdescr":"Brussel zal opnieuw het One World Documentary Film Festival verwelkomen. Na elke filmvertoning kan het publiek zich verheugen op discussies met deskundigen, filmmakers, beleidsmakers en vertegenwoordigers van internationale organisaties.","longdescr":"De editie van dit jaar vindt plaats van 20 t.e.m. 27 april en gaat over een belangrijk thema in de hedendaagse samenleving, namelijk mensenrechten. Het One World Festival in Brussel zal 13 films presenteren in het Europees Parlement, het Paleis voor Schone Kunsten BOZAR, de Tsjechische Permanente Vertegenwoordiging bij de EU en elders.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.oneworld.cz\/brussels\/","email":"brussels@oneworld.cz","phone_contact":"+32 2 641 89 47","phone_booking":"+32 2 641 89 47","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.555373"},"en":{"name":"One World in Brussels 2023","shortdescr":"International Human Rights Documentary Film Festival One World in Brussels comes back to Brussels for its 16th edition. After each film screening, visitors can look forward to discussions with experts, filmmakers, policymakers, or representatives of international organizations.","longdescr":"This year's edition will take place from 20 to 27 April and will be focused on an important topic of today's society, human rights. The One World Festival in Brussels will present 13 films at the premises of the European Parliament, the Palace of Fine Arts BOZAR, and the Permanent Representation of the Czech Republic to the EU, among others. \r\n\r\nEntry is free to all projections (except for the Opening Ceremony at Bozar), reservations are needed!","performers":null,"boxoffice_url":null,"website":"https:\/\/www.oneworld.cz\/brussels\/","email":"brussels@oneworld.cz","phone_contact":"+32 2 641 89 47","phone_booking":"+32 2 641 89 47","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.555373"},"de":{"name":"One World in Brussels 2023","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.oneworld.cz\/brussels\/","email":"brussels@oneworld.cz