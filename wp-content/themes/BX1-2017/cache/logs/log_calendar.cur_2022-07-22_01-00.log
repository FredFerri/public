deren 6-9 j.","Kinderen 9-12 j.","Leerkrachten","Familie","Jongeren 12-15 j.","Jongeren 15-18 j.","LGTBQIA","Senioren","Doof\/slechthorend"],"en":["Blind\/visually impaired","Schools","Children 3-6 yr.","Children 0-3 yr.","Children 6-9 yr.","Children 9-12 yr.","Teachers","Family","Youth 12-15  yr.","Youth 15-18  yr.","LGTBQIA","Seniors","Deaf\/hard of hearing"]}},"educational_targets":{"list":[1,2,3,4,5,6,7,8,9],"translations":{"fr":["Maternel","Primaire","Secondaire","6 - 8 ans","8 - 10 ans","10 - 12 ans","12 - 14 ans","14 - 16 ans","16 - 18 ans"],"nl":["Kleuteronderwijs","Lagere school","Secundair onderwijs","6 - 8 jaar","8 - 10 jaar","10 - 12 jaar","12 - 14 jaar","14 - 16 jaar","16 - 18 jaar"],"en":["Kindergarden","Primary school","Secondary school","6 - 8 years","8 - 10 years","10 - 12 years","12 - 14 years","14 - 16 years","16 - 18 years"]}},"visit_profile":{"list":[331,333,320],"translations":{"fr":["Enfants","Bruxelles accessible","Classique"],"nl":["Kinderen","Toegankelijk Brussel","Klassiek"],"en":["Kids","Accessible Brussels","Classical"]}},"tags":["kids"],"accessibilities":{"list":[252,255,256,257,259,263,265,266],"translations":{"fr":["Accessible aux personnes ayant des difficult\u00e9s de compr\u00e9hension","Accessible","Am\u00e9nagements pour les personnes aveugles et malvoyantes","Am\u00e9nagements pour personnes sourdes et malentendantes","Chien d'assistance","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9","Brussels Health Safety Label"],"nl":["Toegankelijk voor mensen met een verstandelijke beperking","Toegankelijk","Voorzieningen voor blinde en slechtziende personen","Voorzieningen voor dove en slechthorende personen","Assistentiehonden","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet","Brussels Health Safety Label"],"en":["Accessible to people with intellectual disabilities","Accessible","Facilities for blind and partially-sighted persons","Facilities for deaf and hearing-impaired people","Assistance dogs","Accessible to pedestrians with mobility aids","Adapted toilet","Brussels Health Safety Label"]}},"facebook_link":"http:\/\/www.facebook.com\/BELvuemuseum","publication_state":"public","last_updated_at":"2022-07-21T01:06:53+02:00","published_at":"2015-06-15T10:06:38+02:00","backoffice_id":81994,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.16757672110742},{"id":537125,"date_start":"2022-07-08","date_end":"2023-03-05","date_next":"2022-07-21","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[36,45],"translations":{"fr":["Mus\u00e9es et art centers","Mode"],"nl":["Musea en kunstcentra","Mode"],"en":["Museums and art centers","Fashion"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Kidorama, 200 ans de mode enfantine","shortdescr":"La mode pour enfants se porte mieux que jamais. Plus inclusive, plus \u00e9cologique, privil\u00e9giant le fait-main, chaque ann\u00e9e de nouveaux labels voient le jour. Mais habiller un enfant n\u2019est pas toujours facile ! \u00c0 travers un parcours \u00e0 la fois th\u00e9matique et chronologique, cette nouvelle exposition pose un regard sur la mode actuelle \u00e0 la lumi\u00e8re des tenues enfantines port\u00e9es depuis 1820.","longdescr":"La mode pour enfants se porte mieux que jamais. Plus inclusive, plus \u00e9cologique, privil\u00e9giant le fait-main, chaque ann\u00e9e de nouveaux labels voient le jour. Mais habiller un enfant n\u2019est pas toujours facile ! La mode reste avant tout un ph\u00e9nom\u00e8ne social et les enfants aussi attachent de l\u2019importance \u00e0 ce qu\u2019ils portent.\r\n \r\n\u00c0 travers un parcours \u00e0 la fois th\u00e9matique et chronologique, cette nouvelle exposition pose un regard sur la mode actuelle \u00e0 la lumi\u00e8re des tenues enfantines port\u00e9es depuis 1820.\r\n\r\nEn puisant dans ses collections r\u00e9cemment enrichies de pi\u00e8ces belges mais aussi gr\u00e2ce \u00e0 plusieurs pr\u00eats prestigieux, le mus\u00e9e questionne entre autres la construction des genres, le d\u00e9veloppement de la mode mixte ou unisexe, le mim\u00e9tisme avec la mode adulte mais \u00e9galement l\u2019int\u00e9r\u00eat grandissant de l\u2019industrie du luxe pour les kids. Plus qu\u2019une exposition de mode, Kidorama raconte la place de l\u2019enfant et le d\u00e9veloppement de sa personnalit\u00e9 au sein de notre soci\u00e9t\u00e9.\r\n\r\nUne exposition \u00e0 voir avec des yeux d\u2019enfants !\r\n\r\nL\u2019exposition s\u2019adresse bien entendu aux adultes mais \u00e9galement aux enfants, d\u00e9couvrez toutes les activit\u00e9s du mus\u00e9e sur notre site (parcours ludique, carnet de coloriage, atelier paper dolls ...)","performers":"\u00c0 travers un parcours \u00e0 la fois th\u00e9matique et chronologique, cette nouvelle exposition pose un regard sur la mode actuelle \u00e0 la lumi\u00e8re des tenues enfantines port\u00e9es depuis 1820.\r\nL\u2019exposition s\u2019adresse bien entendu aux adultes mais \u00e9galement aux enfants, d\u00e9couvrez toutes les activit\u00e9s du mus\u00e9e sur notre site (parcours ludique, carnet de coloriage, atelier paper dolls ...)","boxoffice_url":null,"website":"https:\/\/www.fashionandlacemuseum.brussels\/fr\/","email":"musea@brucity.be","phone_contact":null,"phone_booking":"+32 2 213 44 50","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/537125.html"},"nl":{"name":"Kidorama, 200 ans jaar kindermode","shortdescr":"Kindermode doet het beter dan ooit. Meer en meer inclusief, ecologisch, met handgemaakte producten en elk jaar nieuwe merken. Maar kinderen kleden is niet altijd gemakkelijk!  Deze nieuwe tentoonstelling verkent thematisch en chronologisch de invloed van de kinderkleding sinds 1820 op onze hedendaagse kindermode.","longdescr":"Kindermode doet het beter dan ooit. Meer en meer inclusief, ecologisch, met handgemaakte producten en elk jaar nieuwe merken. Maar kinderen kleden is niet altijd gemakkelijk! Mode blijft een sociaal verschijnsel en ook kinderen hechten belang aan wat ze dragen.\r\n\r\nDeze nieuwe tentoonstelling verkent thematisch en chronologisch de invloed van de kinderkleding sinds 1820 op onze hedendaagse kindermode.\r\n\r\nKidoroma toont de evolutie van genderconstructies, de ontwikkeling van genderneutrale mode, de invloed van mode voor volwassenen en de groeiende belangstelling van de luxemerken voor kinderen. Het museum put daarvoor uit zijn rijke collecties, onlangs aangevuld met Belgische stukken, maar ook uit verschillende prestigieuze bruiklenen. Kidorama is meer dan een modetentoonstelling. Ze vertelt het verhaal van de plaats van het kind en de ontwikkeling van zijn persoonlijkheid binnen onze samenleving.\r\n\r\nEen tentoonstelling die het kind in ons weer tot leven brengt!\r\n\r\nDe tentoonstelling richt zich uiteraard zowel tot volwassenen als tot kinderen. Ontdek alle activiteiten van het museum  op onze website (speelse rondleiding, kleurboekje, workshops paper dolls ...)","performers":"Deze nieuwe tentoonstelling verkent thematisch en chronologisch de invloed van de kinderkleding sinds 1820 op onze hedendaagse kindermode.\r\nDe tentoonstelling richt zich uiteraard zowel tot volwassenen als tot kinderen. Ontdek alle activiteiten van het museum  op onze website (speelse rondleiding, kleurboekje, workshops paper dolls ...)","boxoffice_url":null,"website":"https:\/\/www.fashionandlacemuseum.brussels\/nl\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/537125.html"},"en":{"name":"Kidorama, 200 year of children's fashion","shortdescr":"Children\u2019s fashion is healthier than ever. More inclusive, more environmentally friendly, with an emphasis on handmade items: new labels appear each year. But dressing a child is not always easy!  Through a trajectory that is both thematic and chronological, this new exhibition casts its eye on current fashion in the light of children\u2019s wear since 1820.","longdescr":"Children\u2019s fashion is healthier than ever. More inclusive, more environmentally friendly, with an emphasis on handmade items: new labels appear each year. But dressing a child is not always easy! Fashion is first and foremost a social phenomenon and children also care about what they wear.\r\n\r\nThrough a trajectory that is both thematic and chronological, this new exhibition casts its eye on current fashion in the light of children\u2019s wear since 1820.\r\n\r\nBy delving into its collections, recently enriched by Belgian items as well as several prestigious loans, the museum raises questions about issues such as construction of gender, the development of mixed or unisex fashion, imitation of adult fashion as well as the growing interest in the luxury industry for kids. More than just a fashion exhibition, Kidorama tells the story of the place of the child and the development of his\/her personality within our society.\r\n\r\nAn exhibition to enjoy through children\u2019s eyes!\r\n\r\nThe exhibition is of course aimed at adults but also at children, discover all the activities of the museum on our website (interactive modules, coloring book ...)","performers":"Through a trajectory that is both thematic and chronological, this new exhibition casts its eye on current fashion in the light of children\u2019s wear since 1820.\r\nThe exhibition is of course aimed at adults but also at children, discover all the activities of the museum on our website (interactive modules, coloring book ...)","boxoffice_url":null,"website":"https:\/\/www.fashionandlacemuseum.brussels\/en\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/537125.html"},"de":{"name":"Kidorama, 200 ans de mode enfantine","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/537125.html"},"it":{"name":"Kidorama, 200 ans de mode enfantine","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/537125.html"},"sp":{"name":"Kidorama, 200 ans de mode enfantine","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/537125.html"},"pt":{"name":"Kidorama, 200 ans de mode enfantine","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/537125.html"},"cn":{"name":"Kidorama, 200 ans de mode enfantine","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/537125.html"}},"place":{"id":278879,"translations":{"fr":{"name":"Mus\u00e9e Mode & Dentelle","address_street_name":"Rue de la Violette","address_street_number":"12","address_street_box":null,"email":null,"website":"https:\/\/www.fashionandlacemuseum.brussels\/fr\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Violette, 12","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Mode & Kant Museum","address_street_name":"Violetstraat","