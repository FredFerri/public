"],"fr":["lundi, mardi, mercredi, jeudi, vendredi, samedi et dimanche: de 13:00 \u00e0 19:00"],"nl":["maandag, dinsdag, woensdag, donderdag, vrijdag, zaterdag en zondag: van 13:00 tot 19:00"]},"date_start":"2023-09-21","date_end":"2023-10-29","is_also_by_appointment":true}],"date_exceptions":[],"closing_days":[],"child_events":[],"parent_events":[],"accessibilities":[],"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":["annee_art_nouveau"]},{"id":50001782,"date_start":"2023-09-21","date_end":"2024-06-20","date_next":"2023-09-21","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2023-09-04T15:45:01+02:00","published_at":"2023-09-04T15:32:22+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":284718,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"concert","ranking":0.15396304049941917,"languages":{"spoken":["en","fr","nl"],"subtitles":[]},"categories":{"main":{"id":1,"translations":{"de":"Konzert","pt":null,"en":"Concert","it":"Concerti","cn":null,"fr":"Concert","sp":"Concierto","nl":"Concert"}},"others":{"list":[2],"translations":{"de":["Klassisch"],"pt":[null],"en":["Classical"],"it":["Classica"],"cn":[null],"fr":["Classique"],"sp":["Cl\u00e1sica"],"nl":["Klassiek"]}}},"translations":{"de":{"name":"Erasmusica concerts","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/erasmushouse.museum\/2022\/09\/concerts-de-midi-erasmusica-2\/","email":"info@erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50001782"},"pt":{"name":"Erasmusica concerts","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/erasmushouse.museum\/2022\/09\/concerts-de-midi-erasmusica-2\/","email":"info@erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50001782"},"en":{"name":"Erasmusica concerts","shortdescr":"Ancient music","longdescr":"11:00 > 12:00 Pr\u00e9lude litt\u00e9raire (FR, Biblioth\u00e8que de l\u2019Espace Maurice Car\u00eame)\n12:30 > 13:15 Concert\n\nStudents from the HIPP department (Historical Performance Practice) of the Koninklijk Conservatorium Brussel offer a beautiful programme to introduce us to ancient music.\n\nFree of charge and no reservation required\nThe concerts take place in the hall of the Muziekacademie Anderlecht (Place de la Vaillance, 5 \u2013 1070 Anderlecht)","performers":"Students from the HIPP department (Historical Performance Practice) of the Koninklijk Conservatorium Brussel","boxoffice_url":null,"website":"https:\/\/erasmushouse.museum\/en\/2021\/09\/erasmusica-concerts\/","email":"info@erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50001782"},"it":{"name":"Erasmusica concerts","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/erasmushouse.museum\/2022\/09\/concerts-de-midi-erasmusica-2\/","email":"info@erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50001782"},"cn":{"name":"Erasmusica concerts","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/erasmushouse.museum\/2022\/09\/concerts-de-midi-erasmusica-2\/","email":"info@erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50001782"},"fr":{"name":"Concerts de midi Erasmusica","shortdescr":"Concerts de musique ancienne et pr\u00e9lude litt\u00e9raire","longdescr":"11:00 > 12:00 Pr\u00e9lude litt\u00e9raire\n12:30 > 13:15 Concert\n\nLes \u00e9tudiants de la section HIPP (Historical Performance Practice) du Koninklijk Conservatorium Brussel vous invitent \u00e0 \u00e9couter chaque mois les sonorit\u00e9s subtiles et uniques de la musique ancienne interpr\u00e9t\u00e9e sur des instruments d\u2019\u00e9poque.\nLes musiciens vous proposent un voyage \u00e0 travers toute l\u2019Europe. A chaque \u00e9dition, c'est un programme surprise vari\u00e9 qui vous est pr\u00e9sent\u00e9, accompagn\u00e9 d\u2019explications et d\u2019anecdotes tout au long du concert.\n\nLa biblioth\u00e8que Maurice Car\u00eame quant \u00e0 elle vous propose une introduction au concert litt\u00e9raire. La premi\u00e8re session fera d\u00e9couvrir les livres qui mettent en sc\u00e8ne la musique et les suivantes se d\u00e9clineront au gr\u00e9 des envies \/ passions \/ saisons.\n\n\u2013 Gratuit et sans r\u00e9servation\n\u2013 Le pr\u00e9lude litt\u00e9raire est pr\u00e9sent\u00e9 par l\u2019\u00e9quipe de la Biblioth\u00e8que de l\u2019Espace Maurice Car\u00eame, rue du Chapelain 1-7, 1070 Anderlecht\n\u2013 Le concert se d\u00e9roule dans la salle de la Muziekacademie Anderlecht, Place de la Vaillance, 5, 1070 Anderlecht\n\u2013 Les portes ferment \u00e0 12:25, le concert commence \u00e0 12:30\n\n","performers":"Les \u00e9tudiants de la section HIPP (Historical Performance Practice) du Koninklijk Conservatorium Brussel \nL'\u00e9quipe de la biblioth\u00e8que Maurice Car\u00eame\n\n\n","boxoffice_url":null,"website":"https:\/\/erasmushouse.museum\/2022\/09\/concerts-de-midi-erasmusica-2\/","email":"info@erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50001782"},"sp":{"name":"Erasmusica concerts","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/erasmushouse.museum\/2022\/09\/concerts-de-midi-erasmusica-2\/","email":"info@erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50001782"},"nl":{"name":"Middagconcerten Erasmusica","shortdescr":"BAROK- EN KLASSIEKE MUZIEK CONCERTEN","longdescr":"11:00 > 12:00 Pr\u00e9lude litt\u00e9raire (FR, Biblioth\u00e8que de l\u2019Espace Maurice Car\u00eame)\n12:30 > 13:15 Concert\n\nEen keer per maand nodigen de studenten van de afdeling Historical Performance Practice van het Koninklijk Conservatorium Brussel u uit te luisteren naar de subtiele en unieke klanken van de barok- en klassieke muziek, uitgevoerd op historische instrumenten. Tijdens een middagconcert nemen zij u mee op een muzikale reis doorheen Europa. Wij gidsen u telkens door een gevarieerd en verrassend programma aan de hand van uitleg en anekdotes.\n\n\u2013 De deuren sluiten om 12.25 uur, het concert begint precies om 12.30 uur.\n\u2013 Gratis en zonder reservatie!\n\u2013 De concert vindt plaats in de zaal van de Muziekacademie Anderlecht (Dapperheidsplein 5 \u2013 1070 Anderlecht)","performers":"Studenten van de afdeling Historical Performance Practice van het Koninklijk Conservatorium","boxoffice_url":null,"website":"https:\/\/erasmushouse.museum\/nl\/2022\/09\/middagconcerten-erasmusica-2\/","email":"info@erasmushouse.museum","phone_contact":"+32 2 521 13 83","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50001782"}},"place":{"id":265380,"translations":{"de":{"name":"Muziekacademie Anderlecht","address_street_name":"Place de la Vaillance","address_street_number":"5","address_street_box":null,"email":"dir@ma-an.be","website":"http:\/\/www.ma-an.be","phone_contact":"+32 2 522 05 51","phone_booking":"+32 2 522 05 51","address_