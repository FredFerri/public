s"}}},{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/47723f8affb2c4cc5aea3eaca52f387def13075f.jpg","width":4032,"height":3024,"ratio":1.33,"translations":{"fr":{"title":"KIDS (un)common values","copyright":"KIDS (un)common values"},"nl":{"title":"KIDS (un)common values","copyright":"KIDS (un)common values"},"en":{"title":"KIDS (un)common values","copyright":"KIDS (un)common values"}}}],"dates":[{"day":"2022-07-01","doors":null,"start":"10:00:00","end":"18:00:00","is_soldout":false,"is_canceled":false},{"day":"2022-09-18","doors":null,"start":"10:00:00","end":"18:00:00","is_soldout":false,"is_canceled":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[4,5],"translations":{"fr":["Enfants 6-9 ans","Enfants 9-12 ans"],"nl":["Kinderen 6-9 j.","Kinderen 9-12 j."],"en":["Children 6-9 yr.","Children 9-12 yr."]}},"tags":["kids"],"accessibilities":{"list":[255,263,265],"translations":{"fr":["Accessible","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9"],"nl":["Toegankelijk","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet"],"en":["Accessible","Accessible to pedestrians with mobility aids","Adapted toilet"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-07-06T13:05:23+02:00","published_at":"2022-07-06T13:02:55+02:00","backoffice_id":257903,"import_origin":null,"sub_type":"misc","show_in_agenda":true,"ranking":0.23207944168064},{"id":538205,"date_start":"2022-07-01","date_end":"2022-09-30","date_next":"2022-09-30","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":true,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":74,"translations":{"fr":"Sport","nl":"Sport","en":"Sport"}},"others":{"list":[159,163],"translations":{"fr":["Activit\u00e9 sportive","Natation et sports nautiques"],"nl":["Sportieve activiteit","Zwemmen en watersport"],"en":["Sporting activity","Swimming and water sports"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Kayak cleanup - Let's Mingle","shortdescr":"\u00c7a vous dit de rencontrer une nouvelle personne cet \u00e9t\u00e9 tout en faisant une bonne action ? Avec sa campagne estivale \u00ab Let\u2019s Mingle \u00bb, Canal It Up vous aide \u00e0 faire une nouvelle rencontre pendant son activit\u00e9 de p\u00eache aux d\u00e9chets en kayak sur le canal de Bruxelles. Rendez-vous romantique ou sympathique, c\u2019est \u00e0 vous de voir !","longdescr":"Vos amis vous ont laiss\u00e9 \u00e0 Bruxelles pour faire des vacances en famille ? Vous ne partez pas cet \u00e9t\u00e9 et vous cherchez une alternative au verre en terrasse ? Les sites de rencontre ne vous proposent rien de bon ces derniers temps ? \r\n\r\nCanal It Up vous entend et lance une nouvelle campagne estivale \u00ab Let\u2019s Mingle \u00bb pour vous faire rencontrer une nouvelle personne. Pourquoi ? Simplement parce qu\u2019\u00e9changer avec quelqu\u2019un de nouveau peut nous aider \u00e0 lib\u00e9rer notre cr\u00e9ativit\u00e9, \u00e0 nous donner l\u2019\u00e9nergie pour monter un projet, \u00e0 \u00e9largir notre horizon \u2013 bref \u00e0 faire germer de belles id\u00e9es !\r\n\r\nEt quelle meilleure mani\u00e8re de briser la glace qu\u2019une p\u00eache aux d\u00e9chets en kayak ? Vous serez tous deux hors de votre zone de confort, vous devrez coop\u00e9rer pour avancer et les objets trouv\u00e9s dans l\u2019eau alimenteront la conversation.\r\n\r\nConcr\u00e8tement, l\u2019association a pr\u00e9par\u00e9 un formulaire pour r\u00e9colter quelques informations et pouvoir apparier les participants : https:\/\/www.canalitup.org\/letsmingle\/. Pour prendre part, il suffit donc de le compl\u00e9ter, d\u2019attendre que l\u2019on vous d\u00e9niche un partenaire et que l\u2019on vous propose une date et heure.\r\n\r\nL\u2019activit\u00e9 dure 1h30 et le rendez-vous se fait sur le quai \u00e0 hauteur du Quai des P\u00e9niches 10, 1000 Bruxelles. Rencontre romantique ou sympathique, \u00e0 vous de voir !","performers":"Canal It Up","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/538205.html"},"nl":{"name":"Kayak cleanup - Let's Mingle","shortdescr":"Zin om iets goed te doen voor de planeet EN om iemand nieuw te leren kennen deze zomer? Met zijn actie \u201cLet\u2019s Mingle\u201d maakt Canal It Up het mogelijk voor je om met een nieuw persoon kennis te maken tijdens een afval clean up per kayak op het kanaal van Brussel. Romantisch of niet, dat kiest je zelf.","longdescr":"Zijn al je vrienden op vakantie en ben je alleen achtergebleven in Brussel? Ben je vrienden kwijt gespeeld in het web van corona lockdowns of hebben ze kinderen gemaakt en zijn te druk bezig? Ben je klaar voor een nieuw romantisch avontuur maar vind weinig interessants op de dating apps? \r\n\r\nCanal It Up heeft jullie signalen opgevangen en lanceert een zomer campagne  - \u00ab Let\u2019s Mingle \u00bb - om jullie een nieuw persoon te laten leren kennen. Waarom? Simpelweg omdat een uitwisseling met een nieuw persoon ons kan helpen onze creativiteit aan te wakkeren, ons de energie kan geven een project op te starten of onze horizon kan verruimen \u2013 veel nieuwe idee\u00ebn kunnen ontspruiten bij zulke ontmoetingen!\r\n\r\nEn welke betere manier bestaat er om het ijs te breken dan kajakken op het kanaal om afval uit het water te vissen? Jullie beide zullen zich buiten jullie comfortzone bevinden, jullie zullen moeten samenwerken om vooruit te geraken en de gevonden objecten (soms zeer merkwaardig) zullen het gesprek voorzien van genoeg gespreksstof.\r\n\r\nZin om mee te doen? We hebben een formulier opgesteld om wat informatie te verzamelen en de mensen te kunnen kopellen: https:\/\/www.canalitup.org\/letsmingle\/. Je moet dus gewoon het formulier invullen, wachten tot wanneer we de perfecte partner vinden en een datum en uur voorstellen voor de vaartocht.\r\n\r\nDe activiteit duurt 1,5u, is plezier verzekerd en kan romantisch zijn of niet, dat kiest iedereen zelf. Afspraak op de kade ter hoogte van Akenkaai 10, 1000 Brussels.","performers":"Canal It Up","boxoffice_url":null,"website":"https:\/\/www.canalitup.org\/letsmingle\/","email":"info@canalitup.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/538205.html"},"en":{"name":"Kayak cleanup - Let's Mingle","shortdescr":"Would you like to meet someone new while doing a good deed? With its Summer action \u201cLet\u2019s Mingle\u201d, Canal It Up arranges for you to meet a new person while fishing for trash by kayak on Brussels canal. A friendly or a romantic encounter \u2013 it\u2019s up to you to decide!","longdescr":"Your friends have left you behind in Brussels to go on holiday? Or did some friendships not survive the corona lockdowns? Or maybe you\u2019re ready for a new romantic adventures but not very inspired by the dating apps?\r\n\r\nCanal It Up saw the signs and launched its Summer action \u201cLet\u2019s Mingle\u201d to help you meet someone new. Why? Because connecting with new people can help us unleash our creativity, give us the energy to start a project, broaden our world view \u2013 in short, because great ideas sprout out of new encounters!\r\n\r\nAnd can you think of something better to do to break the ice than kayaking? You\u2019ll both be out of your comfort zone, you won\u2019t have to feel self-conscious about your clothes because you\u2019ll be wearing a flashy life jacket anyway, you\u2019ll have to collaborate to move forward and the things you\u2019ll find in the water will fuel your conversation.\r\n\r\nWant to participate? We have prepared a form to collect some information that will allow us to find the right partner: https:\/\/www.canalitup.org\/letsmingle\/. So fill it in and then wait until we\u2019ve found you a match and we contact you to fix a date. \r\n\r\nThe activity lasts for one and a half hour and the meeting point is on the quay at Quai des P\u00e9niches 10, 1000 Brussels. A friendly or romantic encounter \u2013 it\u2019s up to you to decide!","performers":"Canal It Up","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/538205.html"},"de":{"name":"Kayak cleanup - Let's Mingle","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/538205.html"},"it":{"name":"Kayak cleanup - Let's Mingle","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/538205.html"},"sp":{"name":"Kayak cleanup - Let's Mingle","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/538205.html"},"pt":{"name":"Kayak cleanup - Let's Mingle","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/538205.html"},"cn":{"name":"Kayak cleanup - Let's Mingle","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/538205.html"}},"place":{"id":275624,"translations":{"fr":{"name":"Canal it up","address_street_name":"Leopold II laan","address_street_number":"23","address_street_box":null,"email":"Canalitup@outlook.be","website":"http: