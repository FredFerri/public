tart":"18:15:00","end":"19:15:00"},{"day":"2022-03-07","doors":null,"start":"18:15:00","end":"19:15:00"},{"day":"2022-04-04","doors":null,"start":"18:15:00","end":"19:15:00"},{"day":"2022-05-02","doors":null,"start":"18:15:00","end":"19:15:00"},{"day":"2022-06-06","doors":null,"start":"18:15:00","end":"19:15:00"}],"recurring":[{"day":"monday","occurences":{"is_first":true,"is_second":false,"is_third":false,"is_fourth":false,"is_last":false},"time_start":"18:15:00","time_end":"19:15:00","translations":{"fr":"Ouvert le premier lundi du mois de 18:15 \u00e0 19:15","nl":"Open op de eerste maandag van de maand van 18:15 tot 19:15","en":"Open the first monday of the month from 18:15 to 19:15"}}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":4}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-05-03T01:07:33+02:00","published_at":"2022-02-21T13:10:50+01:00","backoffice_id":248000,"import_origin":null,"sub_type":"sport","show_in_agenda":true,"ranking":0.15090455083303},{"id":528707,"date_start":"2021-09-06","date_end":"2022-06-30","date_next":"2022-06-06","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":true,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":74,"translations":{"fr":"Sport","nl":"Sport","en":"Sport"}},"others":{"list":[159,167],"translations":{"fr":["Activit\u00e9 sportive","Sport traditionnel"],"nl":["Sportieve activiteit","Volkssporten"],"en":["Sporting activity","Traditional sport"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Yoga doux Schaerbeek","shortdescr":"Le yoga est la pratique d'un ensemble d\u2019exercices physiques et de respiration qui contribue \u00e0 la sant\u00e9 et au bien \u00eatre. Ce cours renforce la musculature en douceur tout en am\u00e9liorant l\u2019\u00e9tat d\u2019esprit g\u00e9n\u00e9ral face aux situations difficiles de la vie. Le coach vous guide pas \u00e0 pas, que vous soyez d\u00e9butant ou averti.","longdescr":"INSCRIPTION OBLIGATOIRE\u00a0:\r\n> Par e-mail (sacasport@fmsb.be)\r\n> Par courrier (rue des Moineaux 17-19 \u2013 1000 Bruxelles)\r\n> A notre accueil (Rue du Midi 118 \u2013 1000 Bruxelles, ouvert du lundi au vendredi de 8h30 \u00e0 12h, et de 13h30 \u00e0 15h) \r\nY mentionner : nom, pr\u00e9nom, adresse, date de naissance, n\u00b0 de gsm, le(s) cours choisi(s) (commune et horaire), n\u00b0 de membre S\u2019Acad\u00e9mie (ou n\u00b0 de mutuelle)\r\nLe cours se paie :\r\n> Soit 4\u20ac \u00e0 la s\u00e9ance directement au moniteur (hors entr\u00e9e de piscine)\r\n> Soit avec un abonnement valable de janvier \u00e0 juin co\u00fbtant 64\u20ac (soit 22 s\u00e9ances pour le prix de 18 s\u00e9ances), qui s\u2019ach\u00e8te uniquement \u00e0 notre accueil en cash jusqu\u2019au 28 janvier 2022 (un abonnement par cours bien d\u00e9fini).\r\nLes cours ont lieu tous les lundis sauf durant les cong\u00e9s scolaires.\r\nLa saison 2021-2022 se termine le 30 juin et reprendra le 05 septembre 2022.\r\n\r\n> L'affiliation\r\nLa cotisation pour l'affiliation \u00e0 Seniors Acad\u00e9mie asbl est de 50 \u20ac par an (septembre\/juin). Les membres de la F\u00e9d\u00e9ration des Mutualit\u00e9s Socialistes du Brabant qui s'affilient \u00e0 l'asbl Seniors Acad\u00e9mie obtiennent une intervention de 50 \u20ac dans le prix pay\u00e9 pour l'affiliation. De ce fait, l'affiliation \u00e0 l'asbl Seniors Acad\u00e9mie est gratuite pour les membres.\r\n\r\nLes conditions g\u00e9n\u00e9rales sous lesquelles sont organis\u00e9es les activit\u00e9s sont disponibles sur le site https:\/\/www.fmsb.be\/fr\/sacademie Vous inscrire implique que vous en ayez pris connaissance.","performers":null,"