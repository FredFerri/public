se,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-09-05T11:52:06+02:00","published_at":"2024-09-05T11:49:23+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":307228,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"tour","ranking":0.7937005259840998,"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{}},"translations":{"de":{"name":"Visite Guid\u00e9e des Appartements et Int\u00e9rieurs des Galeries Royales Saint-Hubert - BBN 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/fr\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700000972"},"pt":{"name":"Visite Guid\u00e9e des Appartements et Int\u00e9rieurs des Galeries Royales Saint-Hubert - BBN 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/fr\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700000972"},"en":{"name":"Guided Tour of the Apartments and Interiors of the Royal Saint-Hubert Galleries - BBN 2024","shortdescr":null,"longdescr":"The idea behind the Galeries Royales Saint-Hubert came from Jean-Pierre Cluysenaar in 1837, and they were inaugurated ten years later by King Leopold I. Known as the \"Umbrella of Brussels\", this monumental covered passageway bears beautiful witness to the city's commercial development before the arrival of department stores. The Royal Galleries became a much appreciated meeting place for the inhabitants of Brussels, intellectuals and political refugees, Victor Hugo, Alexandre Dumas and Charles Baudelaire among them. Listed in 1986, they comprise three shopping arcades: the Queen's Gallery, the King's Gallery and the Princes' Gallery. Today the Royal Galleries house numerous stores and entertainment venues, as well as co-working spaces, hotel rooms and apartments on the upper floors. Behind the well-known fa\u00e7ades, the guided visits exceptionally include an upper-floor apartment and the offices of the Soci\u00e9t\u00e9 des Galeries, as well as the structure of the glass roof which is accessible from the top floor\u2026 Meeting point: the intersection between the King's Gallery, the Queen's Gallery and the Rue des Bouchers.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/en\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700000972"},"it":{"name":"Visite Guid\u00e9e des Appartements et Int\u00e9rieurs des Galeries Royales Saint-Hubert - BBN 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/fr\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700000972"},"cn":{"name":"Visite Guid\u00e9e des Appartements et Int\u00e9rieurs des Galeries Royales Saint-Hubert - BBN 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/fr\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700000972"},"fr":{"name":"Visite Guid\u00e9e des Appartements et Int\u00e9rieurs des Galeries Royales Saint-Hubert - BBN 2024","shortdescr":null,"longdescr":"Imagin\u00e9es en 1837 par Jean-Pierre Cluysenaar, les Galeries Royales Saint-Hubert sont inaugur\u00e9es dix ans plus tard par le roi L\u00e9opold Ier. Autrefois surnomm\u00e9 le \u00abParapluie de Bruxelles\u00bb ce passage monumental couvert reste le plus beau t\u00e9moin de l'essor commercial de la ville avant l'apparition des grands magasins. Les galeries deviennent un lieu de rendez-vous pris\u00e9 par les Bruxellois, les intellectuels et les r\u00e9fugi\u00e9s politiques, parmi lesquels Victor Hugo, Alexandre Dumas, Charles Baudelaire. Class\u00e9es en 1986, elles sont compos\u00e9es de trois passages commerciaux : la Galerie de la Reine, la Galerie du Roi et la Galerie des Princes. Les Galeries Royales accueillent aujourd'hui de nombreux commerces et lieux de divertissement ainsi qu'aux \u00e9tages des espaces de coworking, chambres d'h\u00f4tel et encore de nombreux appartements. Derri\u00e8re des fa\u00e7ades connues de toutes et tous, seront exceptionnellement ouverts \u00e0 la visite : un appartement aux \u00e9tages, le si\u00e8ge de la Soci\u00e9t\u00e9 des Galeries ainsi que la structure de la verri\u00e8re, accessible depuis le dernier niveau. Point de rencontre \u00e0 l'intersection des Galeries du Roi, de la Reine et de la rue des Bouchers.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/fr\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700000972"},"sp":{"name":"Visite Guid\u00e9e des Appartements et Int\u00e9rieurs des Galeries Royales Saint-Hubert - BBN 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/fr\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700000972"},"nl":{"name":"Rondleiding van de appartementen en interieurs Koninklijke Sint-Hubertusgalerijen - BBN 2024","shortdescr":null,"longdescr":"De Koninklijke Sint-Hubertusgalerijen werden in 1837 ontworpen door Jean-Pierre Cluysenaar en tien jaar later door koning Leopold I ingehuldigd. Deze monumentale doorgang, die vroeger de bijnaam \"Paraplu van Brussel\" kreeg, blijft de mooiste getuige van de commerci\u00eble bloei van de stad v\u00f3\u00f3r de komst van de warenhuizen. De Koninklijke Galerijen werden een trefpunt voor tal van Brusselaars, intellectuelen en politieke vluchtelingen, onder wie Victor Hugo, Alexandre Dumas en Charles Baudelaire. Het in 1986 geklasseerde gebouw bestaat uit drie winkelgalerijen: de Koninginnegalerij, de Koningsgalerij en de Prinsengalerij. De Koninklijke Sint- Hubertusgalerijen bieden vandaag niet alleen plaats aan de vele winkels en uitgaansgelegenheden op de benedenverdieping, maar ook aan co-workingruimtes, hotelkamers en appartementen op de verdiepingen erboven. Uitzonderlijk zijn verschillende ruimtes te bezichtigen die doorgaans verstopt blijven achter de welbekende gevels. De rondleiding leidt onder meer naar een appartement op de bovenverdieping en naar de zetel van de Soci\u00e9t\u00e9 des Galeries, maar het bezoek staat ook stil bij de structuur van het glazen dak, toegankelijk vanop de bovenste verdieping. Ontmoetingspunt is het kruispunt van de Koningsgalerij, de Koninginnegalerij en de Beenhouwersstraat.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/nl\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700000972"}},"place":{"id":277004,"translations":{"de":{"name":"Galerie de la Reine ","address_st