["Green & sustainable"]}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-07-14T13:05:37+02:00","published_at":"2022-07-14T03:30:16+02:00","backoffice_id":258329,"import_origin":"explore","sub_type":"other","show_in_agenda":true,"ranking":1.2599210498949},{"id":530787,"date_start":"2022-08-28","date_end":"2022-08-28","date_next":"2022-08-28","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Le quartier Flagey","shortdescr":"Au croisement de la vall\u00e9e du Maelbeek et de la chauss\u00e9e d\u2019Ixelles, la place Flagey occupe l\u2019emplacement d\u2019un ancien \u00e9tang ass\u00e9ch\u00e9.","longdescr":"Au croisement de la vall\u00e9e du Maelbeek et de la chauss\u00e9e d\u2019Ixelles, la place Flagey occupe l\u2019emplacement d\u2019un ancien \u00e9tang ass\u00e9ch\u00e9. Si le Maelbeek, ce cours d\u2019eau aujourd\u2019hui enterr\u00e9, fait encore reparler de lui lors de fortes pluies, les noms des rues, quant \u00e0 eux, nous rappellent la pr\u00e9sence de nombreuses brasseries dans ce qui fut le coeur de l\u2019ancien village d\u2019Ixelles. La place, telle que nous la connaissons, a \u00e9t\u00e9 am\u00e9nag\u00e9e dans les ann\u00e9es 1930, autour du \u00abPaquebot\u00bb, \u00e9difice embl\u00e9matique dessin\u00e9 par Joseph Diongre pour l\u2019Institut national de radiodiffusion. Elle fait le lien entre des univers urbains aussi diff\u00e9rents qu\u2019int\u00e9ressants. Cette promenade part \u00e0 la d\u00e9couverte d\u2019un quartier pas comme les autres.","performe