},"nl":{"name":"Normaal"}},"value":21.5},{"translations":{"de":{"name":"Vorverkauf"},"en":{"name":"Presale"},"it":{"name":"Prevendita"},"fr":{"name":"Pr\u00e9vente"},"sp":{"name":"Preventa"},"nl":{"name":"Voorverkoop"}},"value":18.5},{"translations":{"de":{"name":"Senioren"},"en":{"name":"Seniors"},"it":{"name":"Anziani"},"fr":{"name":"Seniors"},"sp":{"name":"Mayores"},"nl":{"name":"Senioren"}},"value":16}],"date_exceptions":[],"closing_days":[],"child_events":[],"parent_events":[],"accessibilities":{"list":[255,265],"translations":{"de":["Barrierefrei","Barrierefreies WC"],"pt":[null,null],"en":["Accessible","Adapted toilet"],"it":["Accessibile","WC idoneo"],"cn":[null,null],"fr":["Accessible","WC adapt\u00e9"],"sp":["Habilitado","Ba\u00f1os adaptados"],"nl":["Toegankelijk","Aangepast toilet"]}},"recurring":[],"targets":{"list":[4,16,3,5],"translations":{"de":["Kinder 6-9 Jahre","Schulen","Kinder 3-6 Jahre","Kinder 9-12 Jahre"],"pt":[null,null,null,null],"en":["Children 6-9 yr.","Schools","Children 3-6 yr.","Children 9-12 yr."],"it":["Bambini 6-9 anni","Scuole","Bambini 3-6 anni","Bambini 9-12 anni"],"cn":[null,null,null,null],"fr":["Enfants 6-9 ans","Ecoles","Enfants 3-6 ans","Enfants 9-12 ans"],"sp":["Ni\u00f1os de 6 a 9 a\u00f1os","Escuelas","Ni\u00f1os de 3 a 6 a\u00f1os","Ni\u00f1os de 9 a 12 a\u00f1os"],"nl":["Kinderen 6-9 j.","Scholen","Kinderen 3-6 j.","Kinderen 9-12 j."]}},"educational_targets":{"list":[],"translations":{}},"tags":["kids"]},{"id":50001104,"date_start":"2024-01-21","date_end":"2024-06-16","date_next":"2024-01-21","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2023-10-20T10:45:02+02:00","published_at":"2023-08-21T11:57:10+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":283615,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.23818958080238592,"languages":{"spoken":["nl","fr"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[36],"translations":{"de":["Museen & Kunstzentren"],"pt":[null],"en":["Museums and art centers"],"it":["Musei e centri artistici"],"cn":[null],"fr":["Mus\u00e9es et art centers"],"sp":["Museos y centros de arte"],"nl":["Musea en kunstcentra"]}}},"translations":{"de":{"name":"Family Sunday: Rattus","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/sewermuseum.brussels\/news\/family-sunday-9\/","email":"musea@brucity.be","phone_contact":"32 (0)2 279 43 83","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50001104"},"pt":{"name":"Family Sunday: Rattus","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/sewermuseum.brussels\/news\/family-sunday-9\/","email":"musea@brucity.be","phone_contact":"32 (0)2 279 43 83","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50001104"},"en":{"name":"Family Sunday: Rattus","shortdescr":"Chaque 3e dimanche du mois, le mus\u00e9e propose aux familles une journ\u00e9e pleine  d\u2019activit\u00e9s pour mieux conna\u00eetre et comprendre le rat.\nProchaines dates: 15.10, 19.11, 17.12.23, 21.01.24, 18.02, 17.03, 21.04, 19.05 et 16.06.24","longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/sewermuseum.brussels\/news\/family-sunday-9\/","email":"musea@brucity.be","phone_contact":"32 (0)2 279 43 83","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50001104"},"it":{"name":"Family Sunday: Rattus","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/sewermuseum.brussels\/news\/family-sunday-9\/","email":"musea@brucity.be","phone_contact":"32 (0)2 279 43 83","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50001104"},"cn":{"name":"Family Sunday: Rattus","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/sewermuseum.brussels\/news\/family-sunday-9\/","email":"musea@brucity.be","phone_contact":"32 (0)2 279 43 83","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50001104"},"fr":{"name":"Family Sunday: Rattus","shortdescr":"Chaque 3e dimanche du mois, le mus\u00e9e propose aux familles une journ\u00e9e pleine  d\u2019activit\u00e9s pour mieux conna\u00eetre et comprendre le rat.\nProchaines dates: 15.10, 19.11, 17.12.23, 21.01.24, 18.02, 17.03, 21.04, 19.05 et 16.06.24","longdescr":"En matin\u00e9e : RATTUS LAB\n\nNotre \u00e9quipe vous accueille dans l\u2019espace d\u2019introduction modulable de l\u2019exposition. Elle vous propose une animation scientifique autour de la biologie du rat et de son \u00e9volution.\n\n\u2022 Il a la classe ce rat ! de 10h \u00e0 12h (20 min) + 9\nL\u2019humain est curieux. Il compare, range, trie et classe le vivant pour mieux le comprendre et retracer l\u2019histoire de la vie. D\u00e9couvrez \u00e0 l\u2019aide de jeux d\u2019observation et de r\u00e9flexion la classification de notre voisin le rat. Appartient-il au m\u00eame groupe que le lapin ? Est-il proche de nous ? Pourquoi est-il si unique ?\nDates : 21.01, 17.03 et 19.05.24\n\n\u2022 Quel cr\u00e2neur ce rat, de 10h \u00e0 12h (20 min) +6\nVoici un atelier surprenant ! Jean Goossens, naturaliste passionn\u00e9, vous guide dans l\u2019observation de cr\u00e2nes. Trouvez le cr\u00e2ne du Rattus norvegicus ! Pas facile de le distinguer parmi les autres rongeurs. Les cr\u00e2nes de ses pr\u00e9dateurs, carnivores, illustrent les raisons du rat d\u2019avoir une dent contre eux !\nDates : 18.02, 21.04 et 16.06.24 \n\nEn apr\u00e8s-midi : LE COIN DES RATS\u2019CONTEURS\n\nUn espace convivial accueille les familles pour \u00e9changer leurs impressions, lire quelques histoires ou s\u2019essayer \u00e0 un portrait de notre ami le rat, devenu un peu plus familier. \n\n\u2022 Contes, de 11h00 \u00e0 13h00 Tous publics\nDepuis des si\u00e8cles, les rats peuplent nos livres d\u2019histoire. Savourez les r\u00e9cits et  l\u00e9gendes du rongeur. Pas seulement pour les rats de biblioth\u00e8ques ! \n\n\u2022Focus Rattus, nos standing guides vous accueillent de 12h30 \u00e0 16h30 Tous publics\n\n\u2022 Construis ta marionnette, de 13h30 \u00e0 16h30 (20 min) +8\nSympathique, le rat ! Souhaitez-vous en faire un animal de compagnie ? Donnez vie \u00e0 \nvotre marionnette rat.\nDates: 21\/01\/2024, 18\/02\/23,  21\/04\/2024, 16\/06\/24\n\n\u2022 Croque ton rat, de 13h30 \u00e0 16h30 (20 min) +8\nEn compagnie d\u2019une illustratrice de BD, initiez-vous au croquis, \u00e0 l\u2019\u00e9laboration d\u2019un \ngag ou \u00e0 l\u2019\u00e9criture d\u2019un petit sc\u00e9nario mettant en sc\u00e8ne le rat. \nDates: 15\/10\/23, 17\/12\/23, 17\/03\/2024, 19\/05\/2024\n\n\u2022 Entr\u00e9e gratuite pour les moins de 18 ans (prix d\u2019entr\u00e9e au mus\u00e9e pour les adultes)\n\u2022 Activit\u00e9s gratuites pour tou.te.s\n\u2022 Les places par activit\u00e9 \u00e9tant limit\u00e9es, la r\u00e9servation est obligatoire pour chaque activit\u00e9 via notre plateforme de r\u00e9servations","performers":null,"boxoffice_url":null,"website":"https:\/\/sewermuseum.brussels\/news\/family-sunday-9\/","email":"musea@brucity.be","phone_contact":"32 (0)2 279 43 83","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50001104"},"sp":{"name":"Family Sunday: Rattus","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/sewermuseum.brussels\/news\/family-sunday-9\/","email":"musea@brucity.be","phone_contact":"32 (0)2 279 43 83","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50001104"},"nl":{"name":"Family Sunday: Rattus","shortdescr":"Elke 3e zondag van de maand organiseert het museum een gezinsdag vol activiteiten om de rat te leren kennen en begrijpen.\nData : 21.01.24, 18.02, 17.03, 21.04, 19.05 en 16.06.24","longdescr":"Ochtendactiviteit : RATTUS LAB\n\nOns team verwelkomt je in de modulaire introductieruimte van de tentoonstelling,  waar je vergast wordt op een wetenschappelijke presentatie over de biologie van de rat en haar evolutie.\n\nEen klasse apart, die rat!, van 10u tot 12u (20 min) + 9\nMensen zijn nieuwsgierig. We vergelijken, rangschikken, sorteren en classificeren levende wezens en planten om ze beter te begrijpen en de geschiedenis van het leven te achterhalen. Via observatiespelletjes en breinbrekers achterhaal je waar onze buur, de rat, ergens is ingedeeld. Behoort zij tot dezelfde groep als het konijn? Staat zij dicht bij ons? Waarom is zij zo uniek?\nData : 21\/01\/2024, 17\/03\/2024, 19\/05\/2024\n\n\u2022 Wat een opschepper, die rat!, van 10u tot 12u (20 min) +6\nDat is nog eens een verrassende workshop! Wist je dat knaagdieren 40% van alle zoogdieren uitmaken? Jean Goossens, een gedreven natuuronderzoeker, zal je begeleiden bij het observeren van schedels: zoek de schedel van de rattus norvegicus! Hij lijkt nogal sterk op die van andere knaagdieren. Dat wordt dus niet gemakkelijk, maar je brengt het beslist voor elkaar. Ratten verdedigden zich tot het uiterste tegen hun vleesetende aanvallers en beten waar ze maar konden, tot in hun schedels toe! \nData : 18\/02\/23, 21\/04\/2024, 16\/06\/24\n\nNamiddagactiviteit : HET HOEKJE VAN DE VERTELLERS, RAD VAN TONG \n\nEen gezellige ruimte waar gezinnen hun indrukken kunnen delen, een aantal verhalen  kunnen lezen of een portret kunnen tekenen van onze vriend de rat, die we nu al wat  beter kennen.\n\n\u2022 Verhalen vertellen, van 11u tot 13u Voor allen\nAl eeuwenlang bevolken ratten onze geschiedenisboeken. Geniet van de verhalen en legendes rond dit knaagdier. Niet alleen voor bibliotheekratten!\n\u2022Focus Rattus, onze standing guides ontvangen je van 12u30 tot 16u30 (doorlopend). Voor allen\n\n\u2022 Maak je eigen marionettenpop, van 13u30 tot 16u30 (20 min) +8\nWat een toffe rat! Wil je er een huisdier van maken? Breng je rattenpop tot leven \nData: 21\/01\/2024, 18\/02\/23, 21\/04\/2024, 16\/06\/24\n\n\u2022 Teken je rat, van 13u30 tot 16u30 (20 min) +8 \nProbeer in gezelschap van een striptekenaar een schets, een gag of een kort script te maken met een rat als hoofdpersoon. \nData : 15\/10\/23, 17\/12\/23, 17\/03\/2024, 19\/05\/2024\n\n\u2022 Gratis toegang voor deelnemers onder de 18 jaar\n\u2022 Gratis activiteiten voor iedereen (museumtoegang betalend voor volwassenen)\n\u2022 Het aantal plaatsen voor de activiteiten is beperkt, reservatie verplicht via ons online reservatieplatform","performers":null,"boxoffice_url":null,"website":"https:\/\/sewermuseum.brussels\/nl\/news\/family-sunday-16\/","email":"musea@brucity.be","phone_contact":"32 (0)2 279 43 83","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50001104"}},"place":{"id":231869,"translations":{"de":{"name":"Kanalisationsmuseum (Mus\u00e9e des \u00c9gouts)","address_street_name":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museedesegouts.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_line2":"1000 Bruxelles","description_web":"Das Kanalisationsmuseum f\u00fchrt Sie hinab in die Unterwelten der Br\u00fcsseler Kanalisation. Entdecken Sie die Geheimnisse des faszinierenden, 400 Kilometer langen Labyrinths, das sich unter dem Br\u00fcsseler Stadtgebiet auftut. Tausende Kubikmeter Wasser flie\u00dfen t\u00e4glich durch die Br\u00fcsseler Abwasserkanalisation. Was mit ihnen geschieht, welche Wege sie nehmen, erfahren Sie im Kanalisationsmuseum - ein Museum mit vielen interessanten Details f\u00fcr Gro\u00df und Klein: Geschichtliches, Technisches und Am\u00fcsantes.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Mus\u00e9e des \u00c9gouts - Mus\u00e9es de la Ville de Bruxelles","address_street_name":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museedesegouts.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Sewers Museum ","address_street_name":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.sewermuseum.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_line2":"1000 Bruxelles","description_web":"Why not visit the Brussels sewers and the Sewers museum during your next excursion in Brussels. A visit of Brussels' sewerage network - led by experienced guides or ex-workers - is extraordinary, full of surprises, but above all fascinating. The sewers have become vital to our way of life, so much so that it's hard to imagine what it was like before they existed. A visit of the Sewers Museum (and a real sewer!) is therefore an amazing, unusual and thrilling experience.\r\nBrussels' first sewerage network came into use in the 17th century, but they were very limited and a large part of the city's waste still found its way into the river Senne. The river carried waste and carrion and regularly overflowed, or dried out in the summer, leaving behind less-than-pleasant smells.\r\nIt was partially due to this, that the government in the second half of the 19th century decided to completely transform the Senne and its neighbouring streets by building great boulevards to cover the insalubrious area. Between the two world wars a second transformation: a portion of the Senne was diverted and then covered over. The sewerage network improved and grew over the years, going from 45 km in 1847 to the 350 km that we have today.\r\n The entrance to the museum is housed in one of the toll pavilions that used to collect taxes on goods that entered the city.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Mus\u00e9e des \u00c9gouts - Mus\u00e9es de la Ville de Bruxelles","address_street_name":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museedesegouts.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Mus\u00e9e des \u00c9gouts - Mus\u00e9es de la Ville de Bruxelles","address_street_name":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museedesegouts.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"fr":{"name":"Mus\u00e9e des Egouts","address_street_name":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museedesegouts.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_line2":"1000 Bruxelles","description_web":"Au premier abord, on n\u2019y aurait pas pens\u00e9\u2026 Aller visiter les \u00e9gouts d\u2019une grande ville ? Mais en y r\u00e9fl\u00e9chissant un court instant, on per\u00e7oit vite l\u2019int\u00e9r\u00eat et les apprentissages potentiels ! Cet endroit qu\u2019aujourd\u2019hui on n\u2019imagine pas autrement qu\u2019enfoui\u2026 n\u2019a pas toujours exist\u00e9 sous cette forme, loin s\u2019en faut !\r\nC\u2019est au 17e si\u00e8cle que se met en place \u00e0 Bruxelles le premier r\u00e9seau d\u2019\u00e9gouts ; toutefois celui-ci reste \u00e9l\u00e9mentaire et bon nombre de d\u00e9chets terminent encore leur itin\u00e9raire dans le cours d\u2019eau bruxellois, la Senne. Celle-ci charrie d\u00e9tritus et charognes, et d\u00e9borde r\u00e9guli\u00e8rement en temps de pluie, ou s\u2019ass\u00e8che en \u00e9t\u00e9, laissant s\u2019\u00e9chapper des odeurs peu subtiles\u2026\r\nUn grand plan d\u2019assainissement est ex\u00e9cut\u00e9 dans la seconde moiti\u00e9 du 19e si\u00e8cle. On d\u00e9cide de vo\u00fbter la Senne et d\u2019\u00e9tablir de larges boulevards \u00e0 la place des ruelles insalubres. Durant l\u2019entre-deux-guerres, une deuxi\u00e8me entreprise de d\u00e9tournement et de vo\u00fbtement du cours d\u2019eau viendra renforcer l\u2019efficacit\u00e9 des premiers travaux.\r\nProgressivement, le r\u00e9seau des \u00e9gouts va se perfectionner et s\u2019agrandir : comptant 45 km en 1847, on d\u00e9nombre actuellement 350 km de d\u00e9dales souterrains, qui recueillent conjointement les eaux pluviales et les eaux us\u00e9es provenant de l\u2019activit\u00e9 humaine. \r\n\r\nAper\u00e7u de ce r\u00e9seau, explications sur son histoire et le travail des hommes qui l\u2019entretiennent, cycle de l\u2019eau, etc. : ce sont l\u00e0 quelques-unes des th\u00e9matiques qui vous y attendent ! Notez que l\u2019entr\u00e9e du mus\u00e9e si\u00e8ge dans un des deux \u00ab pavillons d\u2019octroi \u00bb, b\u00e2timents qui mat\u00e9rialisent la perception de la taxe sur tous les biens entrant dans la Ville au 19e si\u00e8cle.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Museo del Alcantarillado (Mus\u00e9e des Egouts)","address_street_name":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museedesegouts.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_line2":"1000 Bruxelles","description_web":"En un primer momento, a uno no se le pasar\u00eda por la cabeza... \u00bfIr a visitar las alcantarillas de una gran ciudad? Pero si te paras a pensarlo, \u00a1ver\u00e1s r\u00e1pidamente el potencial de aprendizaje y el inter\u00e9s! Este lugar que, actualmente, solo nos imaginamos bajo tierra no siempre lo ha estado, ni mucho menos. En el siglo XVII se cre\u00f3 el primer sistema de alcantarillado en Bruselas; sin embargo, segu\u00eda siendo b\u00e1sico y muchos residuos terminaban su recorrido en el r\u00edo de la ciudad, el Senne. Este r\u00edo, que llevaba basura y carro\u00f1a, se sol\u00eda desbordar normalmente en \u00e9poca de lluvias, o se secaba en verano, lo que hac\u00eda que desprendiera olores desagradables...\r\nEn la segunda mitad del siglo XIX se puso en marcha un importante plan de saneamiento.\r\nSe decidi\u00f3 recubrir el Senne y crear amplios bulevares en lugar de callejones insalubres. Durante el per\u00edodo de entreguerras, unas segundas obras de recubrimiento y desv\u00edo del agua reforzaron las primeras. Gradualmente, el sistema de alcantarillado se mejor\u00f3 y ampli\u00f3: de 45 km en 1847, actualmente hay 350 km de laberintos subterr\u00e1neos, que recogen conjuntamente el agua de lluvia y las aguas residuales de la ciudad. El museo se inaugur\u00f3 en 1988 como respuesta a una demanda creciente y ofrece visitas realizadas por el propio personal del Servicio de Alcantarillado. Gracias a este museo podr\u00e1s disfrutar de una perspectiva general de esta red, explicaciones sobre su historia y sobre la labor que desempe\u00f1an sus trabajadores, informaci\u00f3n sobre el ciclo hidrol\u00f3gico, etc. Cabe destacar que la entrada al museo se encuentra en uno de los dos Pavillons d\u2019octroi, los edificios donde se recaudaban los impuestos de todas las mercanc\u00edas que entraban en la ciudad en el siglo XIX.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Riolenmuseum","address_street_name":"Octrooipaviljoen, Anderlechtsepoort","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.riolenmuseum.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Octrooipaviljoen, Anderlechtsepoort","address_line2":"1000 Bruxelles","description_web":"Zet eens een bezoek aan de Brusselse riolen en het Riolenmuseum op het programma van een uitstap in Brussel! Apart, ongewoon en onverwacht, maar vooral interessant en allesbehalve saai is zo\u2019n afdaling in ondergronds Brussel, begeleid door ervaren stadsgidsen of (voormalige) rioolwerkers.\r\nRiolen zijn levensnoodzakelijk geworden voor onze manier van leven, vandaar dat we ons maar moeilijk kunnen voorstellen hoe het eraan toeging toen ze nog niet bestonden. Een bezoek aan het Riolenmuseum (en een echte riool!) is dan ook verrassend, ongewoon en ongemeen boeiend.\r\nIn de 17de eeuw werd in Brussel een eerste riolennet in gebruik genomen. Dat bleef nog erg beperkt en het overgrote deel van het afvalwater vond nog altijd zijn weg naar die ene Brusselse rivier, de Zenne. Die voerde dan ook een smurrie van afval, viezigheid en zelfs dierenkadavers de hele stad door. Als de Zenne bij overvloedige regen overstroomde of in volle zomer opdroogde in de zomer, zorgde dat natuurlijk voor weinig aangename geurtjes...\r\nGedeeltelijk omwille van die overlast besloot de overheid in de tweede helft van de 19de eeuw om een overwelving aan te brengen boven de Zenne en grote boulevards aan te leggen in plaats van de vieze en slordige steegjes. Later werd tussen de twee Wereldoorlogen nog een tweede keer ingegrepen: een deel van de Zenne werd verlegd en er werden nog meer overwelvingen aangebracht. \r\nLangzamerhand verbeterde en vergrootte het riolennet, van 45 km in 1847 naar de huidige 350 km riool, die zowel afval- als regenwater afvoert. \r\nNaast een bezoek aan de riolen zelf levert dit museum een schat aan boeiende en interessante informatie op over alle aspecten van riolen, rioolwater en de mensen die ze \u2013 vaak in gevaarlijke en altijd in onaangename omstandigheden - onderhouden. Leuk: de ingang van het museum is gehuisvest in een van de twee octrooipaviljoenen aan de Anderlechtse Poort, waar vroeger tol werd geheven op goederen die in de stad werden binnengebracht.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[21],"translations":{"de":["S\u00fcden"],"pt":[null],"en":["South"],"it":["Sud"],"cn":[null],"fr":["Sud"],"sp":["Sur"],"nl":["Zuid"]}},"neca":null,"facebook_id":null,"backoffice_id":989,"location":{"lat":50.82833819,"lon":4.31090786},"region":"brussels","last_updated_at":"2023-08-02T11:39:17+02:00","published_at":"2013-10-19T01:13:58+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":231869,"translations":{"de":{"name":"Kanalisationsmuseum (Mus\u00e9e des \u00c9gouts)","address_street_name":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museedesegouts.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_line2":"1000 Bruxelles","description_web":"Das Kanalisationsmuseum f\u00fchrt Sie hinab in die Unterwelten der Br\u00fcsseler Kanalisation. Entdecken Sie die Geheimnisse des faszinierenden, 400 Kilometer langen Labyrinths, das sich unter dem Br\u00fcsseler Stadtgebiet auftut. Tausende Kubikmeter Wasser flie\u00dfen t\u00e4glich durch die Br\u00fcsseler Abwasserkanalisation. Was mit ihnen geschieht, welche Wege sie nehmen, erfahren Sie im Kanalisationsmuseum - ein Museum mit vielen interessanten Details f\u00fcr Gro\u00df und Klein: Geschichtliches, Technisches und Am\u00fcsantes.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Mus\u00e9e des \u00c9gouts - Mus\u00e9es de la Ville de Bruxelles","address_street_name":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museedesegouts.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Sewers Museum ","address_street_name":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.sewermuseum.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_line2":"1000 Bruxelles","description_web":"Why not visit the Brussels sewers and the Sewers museum during your next excursion in Brussels. A visit of Brussels' sewerage network - led by experienced guides or ex-workers - is extraordinary, full of surprises, but above all fascinating. The sewers have become vital to our way of life, so much so that it's hard to imagine what it was like before they existed. A visit of the Sewers Museum (and a real sewer!) is therefore an amazing, unusual and thrilling experience.\r\nBrussels' first sewerage network came into use in the 17th century, but they were very limited and a large part of the city's waste still found its way into the river Senne. The river carried waste and carrion and regularly overflowed, or dried out in the summer, leaving behind less-than-pleasant smells.\r\nIt was partially due to this, that the government in the second half of the 19th century decided to completely transform the Senne and its neighbouring streets by building great boulevards to cover the insalubrious area. Between the two world wars a second transformation: a portion of the Senne was diverted and then covered over. The sewerage network improved and grew over the years, going from 45 km in 1847 to the 350 km that we have today.\r\n The entrance to the museum is housed in one of the toll pavilions that used to collect taxes on goods that entered the city.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Mus\u00e9e des \u00c9gouts - Mus\u00e9es de la Ville de Bruxelles","address_street_name":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museedesegouts.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Mus\u00e9e des \u00c9gouts - Mus\u00e9es de la Ville de Bruxelles","address_street_name":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museedesegouts.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"fr":{"name":"Mus\u00e9e des Egouts","address_street_name":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_street_number":null,"address_street_box":null,"email":"musea@brucity.be","website":"http:\/\/www.museedesegouts.brussels","phone_contact":"+32 2 279 43 83","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Pavillons d\u2019Octroi, Porte d'Anderlecht","address_line2":"1000 Bruxelles","description_web":"Au premier abord, on n\u2019y aurait pas pens\u00e9\u2026 Aller visiter les \u00e9gouts d\u2019une grande ville ? Mais en y r\u00e9fl\u00e9chissant un court instant, on per\u00e7oit vite l\u2019int\u00e9r\u00eat et les apprentissages potentiels ! Cet endroit qu\u2019aujourd\u2019hui on n\u2019imagine pas autrement qu\u2019enfoui\u2026 n\u2019a pas toujours exist\u00e9 sous cette forme, loin s\u2019en faut !\r\nC\u2019est au 17e si\u00e8cle que se met en place \u00e0 Bruxelles le 