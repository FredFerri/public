ointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung","it":"Esposizioni","sp":"Exhibici\u00f3n","pt":null,"cn":null}},"others":{"list":[36,48],"translations":{"fr":["Mus\u00e9es et art centers","Architecture"],"nl":["Musea en kunstcentra","Architectuur"],"en":["Museums and art centers","Architecture "],"de":["Museen & Kunstzentren","Architektur"],"it":["Musei e centri artistici","Architettura"],"sp":["Museos y centros de arte","Arquitectura"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Inauguration de la Fondation blan","shortdescr":"Ixelles, 26 boulevard Ge\u0301ne\u0301ral Jacques, la Fondation blan voit le jour au rond-point de l\u2019Etoile. Thomas de Wouters, son fondateur, souhaite apporter un regard neuf sur l\u2019art contemporain.\r\nUn endroit exceptionnel dont l\u2019artiste plasticien Stephan Balleux prendra largement possession dans le cadre de son exposition inaugurale \"Artificialia\".","longdescr":"Ixelles, 26 boulevard Ge\u0301ne\u0301ral Jacques, la Fondation blan voit le jour au rond-point de l\u2019Etoile. Thomas de Wouters, son fondateur, souhaite apporter un regard neuf sur l\u2019art contemporain.\r\n\r\nC'est dans un ho\u0302tel de mai\u0302tre de quatre e\u0301tages surplombe\u0301s d'un jardin suspendu que ce projet d'envergure a \u00e9t\u00e9 imagin\u00e9. Un appel a\u0300 l'audace. A l'image de la fondation.\r\n\r\nNi galerie d\u2019art, ni muse\u0301e, le lieu se veut e\u0301clectique. Aux arts plastiques r\u00e9pondront d\u2019\u00e9tonnantes correspondances, qu\u2019elles soient lie\u0301es a\u0300 la musique, a\u0300 la litte\u0301rature, aux performances, au cine\u0301ma ou encore au the\u0301a\u0302tre.\r\n\r\nCette furieuse envie de nouveaute\u0301 et de frai\u0302cheur s\u2019installera au c\u0153ur de Bruxelles. Un endroit exceptionnel dont l\u2019artiste plasticien Stephan Balleux prendra largement possession dans le cadre de son exposition inaugurale \"Artificialia\".\r\n\r\nPROGRAMME (sur r\u00e9servation avant le 7 mars, places limit\u00e9es)\r\n23 mars 18h - Cocktail inaugural et vernissage de l'exposition Artificialia - Stephan Balleux\r\n24 mars 14h - Rencontre et visite de l'exposition en compagnie de l'artiste Stephan Balleux\r\n24 mars 15h - Rencontre et visite de l'exposition en compagnie de l'artiste Stephan Balleux\r\n24 mars 16h - Rencontre et visite de l'exposition en compagnie de l'artiste Stephan Balleux\r\n25 mars 9h30 - Atelier pour enfants autour de l\u2019exposition Artificialia\r\n25 mars 11h - Atelier pour enfants autour de l\u2019exposition Artificialia\r\n25 mars 17h - Lecture en proses par Elya Verdal, piano et voix\r\n26 mars 15h - Entre concert et d\u00e9clamation th\u00e9\u00e2trale, Josse de Pauw et le trio Kris Defoort","performers":"Thomas de Wouters ; Stephan Balleux ; Elya Verdal ; Josse de Pauw ; Kris Defoort ; Nicolas Thys ; Virginie Mamet","boxoffice_url":null,"website":"https:\/\/www.fondationblan.org\/","email":"info@fondationblan.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.552409"},"nl":{"name":"Inauguratie van de Fondation blan","shortdescr":"Een nieuwe stichting ziet het daglicht op het Sterreplein in Elsene, aan de Generaal Jacqueslaan 26. Oprichter Thomas de Wouters wil een nieuwe blik op hedendaagse kunst bieden.\r\n\r\nEen uitzonderlijke plek, waarvan de beeldende kunstenaar Stephan Balleux een groot deel zal innemen in het kader van de openingstentoonstelling \"Artificialia\".","longdescr":"Een nieuwe stichting ziet het daglicht op het Sterreplein in Elsene, aan de Generaal Jacqueslaan 26. Oprichter Thomas de Wouters wil een nieuwe blik op hedendaagse kunst bieden.\r\n\r\nDit grootschalige project is opgezet in een herenhuis met vier verdiepingen en een overhangende tuin. Een oproep tot durf. Net zoals de stichting.\r\n\r\nDeze plek is geen galerie, noch museum, ze wil eclectisch zijn. Er zullen zich verbazingwekkende overeenkomsten ontvouwen tussen de beeldende kunst en muziek, literatuur, performances, film of theater.\r\n\r\nDeze hang naar vernieuwing en frisheid komt centraal te staan in het Brusselse herenhuis. Een uitzonderlijke plek, waarvan de beeldende kunstenaar Stephan Balleux een groot deel zal innemen in het kader van de openingstentoonstelling \"Artificialia\".\r\n\r\nAGENDA (op reservatie voor 7 maart, beperkte plaatsen)\r\n23 maart 18u - Inauguratie drink en vernissage van de tentoonstelling Artificialia - Stephan Balleux\r\n24 maart 14u - Ontmoeting en bezoek aan de tentoonstelling in aanwezigheid van de kunstenaar Stephan Balleux\r\n24 maart 15u - Ontmoeting en bezoek aan de tentoonstelling in aanwezigheid van de kunstenaar Stephan Balleux\r\n24 maart 16u - Ontmoeting en bezoek aan de tentoonstelling in aanwezigheid van de kunstenaar Stephan Balleux\r\n25 maart 9u30 - Workshop voor kinderen rond de tentoonstelling Artificialia\r\n25 maart 11u - Workshop voor kinderen rond de tentoonstelling Artificialia\r\n25 maart 17u - Prozalezing door Elya Verdal, piano en zang\r\n26 maart 15u - Tussen concert en theatrale vertoning, Josse de Pauw en het Kris Defoort trio","performers":"Thomas de Wouters ; Stephan Balleux ; Elya Verdal ; Josse de Pauw ; Kris Defoort ; Nicolas Thys ; Virginie Mamet","boxoffice_url":null,"website":"https:\/\/www.fondationblan.org\/","email":"info@fondationblan.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.552409"},"en":{"name":"Inauguration of the Fondation blan","shortdescr":"In Ixelles, 26 boulevard G\u00e9n\u00e9ral Jacques, a new foundation will open its doors at the Etoile Roundabout: blan, born out of the aim of Thomas de Wouters, its founder, to take on a new look on contemporary art.","longdescr":"In Ixelles, 26 boulevard G\u00e9n\u00e9ral Jacques, a new foundation will open its doors at the Etoile Roundabout: blan, born out of the aim of Thomas de Wouters, its founder, to take on a new look on contemporary art. To discover as from 23th of March 2023.\r\n\r\nJust like in his photography, Thomas de Wouters wants to show a part of humanity with a concerned eye, in a sensitive way. A view that he hopes to pass on to visitors.\r\n\r\nThis eclectic new space dedicated to contemporary art is not a gallery nor a museum. Surprising links will be created between visual arts and music, literature, performance, cinema or theatre.\r\n\r\nNext to the exhibitions and events that will make it come to life, the blan foundation will also be a residence where emerging artists can interpret and question the meaningfulness and critical thinking, while bearing a constant search for aesthetics in mind. The selection will be assigned to an artistic committee.\r\n\r\nThe foundation wants to be a real place of encounters, lively and in constant motion. Just like the artistic salons in the 19th century. \"La vie, quoi!\"\r\n\r\nThis desire for innovation and freshness will come to life in the heart of this Brussels mansion. An exceptional place which the artist Stephan Balleux will take over in the context of its inaugural exhibition \"Artificialia\".\r\n\r\nNothing is left to chance. Not even the acronym of the foundation. blan, in reference to the blank page and to this new look at art. blan, without the \"C\", because it leaves an opening to the world. blan, like the four initials of Thomas de Wouters' children's names.  The perfect name for his foundation.","performers":"Thomas de Wouters ; Stephan Balleux ; Elya Verdal ; Josse de Pauw ; Kris Defoort ; Nicolas Thys ; Virginie Mamet","boxoffice_url":null,"website":"https:\/\/www.fondationblan.org\/","email":"info@fondationblan.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.552409"},"de":{"name":"Fondation blan | Inauguration","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.fondationblan.org\/","email":"info@fondationblan.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.552409"},"it":{"name":"Fondation blan | Inauguration","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.fondationblan.org\/","email":"info@fondationblan.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.552409"},"sp":{"name":"Fondation blan | Inauguration","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.fondationblan.org\/","email":"info@fondationblan.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.552409"},"pt":{"name":"Fondation blan | Inauguration","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.fondationblan.org\/","email":"info@fondationblan.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.552409"},"cn":{"name":"Fondation blan | Inauguration","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.fondationblan.org\/","email":"info@fondationblan.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.552409"}},"place":{"id":279998,"translations":{"fr":{"name":"Fondation blan","address_street_name":"Boulevard G\u00e9n\u00e9ral Jacques","address_street_number":"26","address_street_box":null,"email":"info@fondationblan.org","website":"https:\/\/www.fondationblan.org\/","phone_contact":null,"phone_booking":null,"address