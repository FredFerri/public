scr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.racontance.be","email":"racontance@hotmail.com","phone_contact":"+32 477 91 04 30","phone_booking":"+32 477 91 04 30","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.543832"},"it":{"name":"Les Zap\u00e9ro-contes \u00e0  De Ultieme Hallucinatie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.racontance.be","email":"dominique.brynaert@skynet.be","phone_contact":"+32 477 91 04 30","phone_booking":"+32 477 91 04 30","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.543832"},"cn":{"name":"Les Zap\u00e9ro-contes \u00e0  De Ultieme Hallucinatie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.racontance.be","email":"dominique.brynaert@skynet.be","phone_contact":"+32 477 91 04 30","phone_booking":"+32 477 91 04 30","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.543832"},"fr":{"name":"Les Zap\u00e9ro-contes","shortdescr":"Huit conteuses et conteurs se partagent la sc\u00e8ne pour vous raconter des histoires surprenantes, \u00e9mouvantes, passionnantes, pleine d'humour, dans un lieu art nouveau totalement hallucinant. Le conte n'est pas fait que pour endormir les enfants, il r\u00e9veille les adultes !","longdescr":"Osez le conte pour adultes !  (Spectacle en fran\u00e7ais)\nChaque troisi\u00e8me vendredi du mois de 20h \u00e0 22h30, on vous raconte des histoires dr\u00f4les, \u00e9tonnantes, d\u00e9lirantes, \u00e9mouvantes, destin\u00e9es \u00e0 un public adulte.  Depuis treize ans, la sc\u00e8ne ouverte \"Les Zap\u00e9ro-contes\" accueille \u00e0 Bruxelles des conteurs de toute la Belgique et parfois aussi de France. Organis\u00e9es par l'Asbl Racontance, ces sc\u00e8nes ouvertes ont pour objectif de vous faire d\u00e9couvrir l'immense richesse de l'univers du conte (traditionnel, philosophique, fantastique, humoristique\u2026et m\u00eame parfois coquin) tout en battant en br\u00e8che le clich\u00e9 r\u00e9ducteur qui veut que celui-ci soit destin\u00e9 aux seuls enfants. La soir\u00e9e est anim\u00e9e par Dominique Brynaert, conteur et ancien journaliste t\u00e9l\u00e9. \nCes soir\u00e9es se d\u00e9roulent dans le fantastique d\u00e9cor Art Nouveau d\u2019une maison et brasserie mythique de Bruxelles : De Ultieme Hallucinatie, restaur\u00e9e par une \u00e9quipe passionn\u00e9e de patrimoine et de culture. \nL'entr\u00e9e est libre (participation au chapeau en solidarit\u00e9 avec les artistes) afin de vous faire d\u00e9couvrir cette discipline artistique et offrir la culture \u00e0 toutes les bourses.  Vu le succ\u00e8s habituel, les r\u00e9servations sont fortement recommand\u00e9es via le site de Racontance : www.racontance.be ou par mail : racontance@hotmail.com\nPossibilit\u00e9s de repas sur place avant spectacle en r\u00e9servant une table via le site internet de De Ultieme Hallucinatie \n","performers":"8 conteuses et conteurs en sc\u00e8ne partag\u00e9e","boxoffice_url":null,"website":"http:\/\/www.racontance.be","email":"dominique.brynaert@skynet.be","phone_contact":"+32 477 91 04 30","phone_booking":"+32 477 91 04 30","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.543832"},"sp":{"name":"Les Zap\u00e9ro-contes \u00e0  De Ultieme Hallucinatie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.racontance.be","email":"dominique.brynaert@skynet.be","phone_contact":"+32 477 91 04 30","phone_booking":"+32 477 91 04 30","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.543832"},"nl":{"name":"Les Zap\u00e9ro-contes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.racontance.be","email":"racontance@hotmail.com","phone_contact":"+32 477 91 04 30","phone_booking":"+32 477 91 04 30","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.543832"}},"place":{"id":260326,"translations":{"de":{"name":"De Ultieme Hallucinatie","address_street_name":"Rue Royale","address_street_number":"316","address_street_box":null,"email":"event@deultiemehallucinatie.be","website":"https:\/\/www.ultiemehallucinatie.be\/","phone_contact":"+32 2 889 03 16","phone_booking":"+32 2 889 03 16","address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Royale, 316","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"De Ultieme Hallucinatie","address_street_name":"Rue Royale","address_street_number":"316","address_street_box":null,"email":"event@deultiemehallucinatie.be","website":"https:\/\/www.ultiemehallucinatie.be\/","phone_contact":"+32 2 889 03 16","phone_booking":"+32 2 889 03 16","address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Royale, 316","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"De Ultieme Hallucinatie","address_street_name":"Rue Royale","address_street_number":"316","address_street_box":null,"email":"event@deultiemehallucinatie.be","website":"https:\/\/www.ultiemehallucinatie.be\/","phone_contact":"+32 2 889 03 16","phone_booking":"+32 2 889 03 16","address_zip":"1210","address_city":"Saint-Josse-Ten-Noode","address_line1":"Rue Royale, 316","address_line2":"1210 Saint-Josse-Ten-Noode","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"De Ultieme Hallucinatie","address_street_name":"Rue Royale","address_street_number":"316","address_street_box":null,"email":"event@deultiemehallucinatie.be","website":"https:\/\/www.ultiemehallucinatie.be\/","phone_contact":"+32 2 889 03 16","phone_booking":"+3