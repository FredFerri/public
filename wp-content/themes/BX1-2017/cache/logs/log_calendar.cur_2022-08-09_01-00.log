]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Montre-moi tes bourgeons, et je te dirai qui tu es!","shortdescr":"Reconna\u00eetre les arbres nus et, derri\u00e8re leur apparente dormance, d\u00e9couvrir leur vie en hiver. R\u00e9servation et masque obligatoires.","longdescr":"Quel est cet arbre ? Pas si simple, lorsqu\u2019il a perdu ses feuilles ! Heureusement, d\u2019autres indices (\u00e9corce, bourgeons, fruits, forme de son port) permettent de l\u2019identifier. Au cours de la promenade, nous jouerons les d\u00e9tectives \u00e0 la recherche de ces indices. Puis, nous d\u00e9couvrirons qu\u2019en secret, derri\u00e8re leur dormance, ils restent bien actifs et pr\u00e9parent d\u00e9j\u00e0 le retour des beaux jours.\r\nR\u00e9servation et masque obligatoires.","performers":"Guide: Hugo Hubert","boxoffice_url":null,"website":"http:\/\/www.scheutbos.be\/","email":"scheutbos@yahoo.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/488413.html"},"nl":{"name":"Montre-moi tes bourgeons, et je te dirai qui tu es!","shortdescr":"Rondleiding in't Frans","longdescr":"Rondleiding in't Frans","performers":null,"boxoffice_url":null,"website":"http:\/\/www.scheutbos.be\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/488413.html"},"en":{"name":"Montre-moi tes bourgeons, et je te dirai qui tu es!","shortdescr":"Guided tour in French","longdescr":"Guided tour in French","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/488413.html"},"de":{"name":"Montre-moi tes bourgeons, et je te dirai qui tu es!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/488413.html"},"it":