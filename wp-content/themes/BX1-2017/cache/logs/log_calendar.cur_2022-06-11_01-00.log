ilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-06-09T13:05:08+02:00","published_at":"2022-05-30T14:02:39+02:00","backoffice_id":254633,"import_origin":null,"sub_type":"festival","show_in_agenda":true,"ranking":0.28543716208189},{"id":532837,"date_start":"2022-06-29","date_end":"2022-07-01","date_next":"2022-06-29","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Vivre l'Ommegang au Sablon","shortdescr":null,"longdescr":"L\u2019Ommegang est une procession historique et religieuse qui existe depuis le 14\u00e8me si\u00e8cle et qui inclut tous les acteurs de la ville. Chaque ann\u00e9e, les Bruxellois perp\u00e9tuent la tradition \u00e0 travers une reconstitution de l\u2019Ommegang de 1549, organis\u00e9 pour l\u2019empereur Charles Quint et son fils Philippe. \u00c0 cette occasion, les deux serments d\u2019arbal\u00e9triers de Bruxelles organisent un concours de tir, un Charles Quint plus vrai que nature vient saluer la vierge \u00e0 la barque dans l\u2019\u00e9glise Notre-Dame du Sablon et plus de 1.400 figurants d\u00e9filent du Sablon jusqu\u2019\u00e0 la Grand-Place. V\u00eatus de costumes d\u2019\u00e9poque, vos guides vous feront revivre cet \u00e9v\u00e9nement incontournable du folklore bruxellois, en commentant cette page d\u2019histoire. Tels des journalistes sportifs regardant passer le peloton, ils vous d\u00e9voileront tout ce que vous avez toujours voulu savoir sur l\u2019Ommegang !\r\n\r\nR\u00e9servation obligatoire par mail.","performers":null,"boxoffice_url":null,"website":"https:\/\/onceinbrussels.be\/","email":"melanie@onceinbrussels.be","phone_contact":"+32 2 850 60 90","phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/532837.html"},"nl":{"name":"De Ommegang leven op de Sablon","shortdescr":null,"longdescr":"De Ommegang is een historische en religieuze processie die al sinds de 14e eeuw bestaat en waaraan alle acteurs van de stad deelnemen. Dankzij de zorgen van de Brusselaars, herleeft elk jaar de traditie van de Ommegang, voor het eerst georganiseerd door keizer Karel V en zijn zoon Filips in 1549. \r\nBij deze gelegenheid organiseren de twee Brusselse kruisboogschuttersgilden een schietwedstrijd, komt een levensechte Karel V de Maagd begroeten in de boot aan de Onze-Lieve-Vrouwe-ter-Zavelkerk en paraderen meer dan 1.400 figuranten van de Zavel naar de Grote Markt. \r\nDe gidsen zijn gekleed in historische kostuums en geven uitleg bij deze niet te missen gebeurtenis uit de Brusselse folklore, terwijl je deze bladzijde uit de geschiedenis herbeleeft. Zoals sportjournalisten die het peloton zien voorbijfietsen, vertellen de gidsen je alles wat je over de Ommegang wilde weten! \r\n\r\nReserveren: verplicht","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/532837.html"},"en":{"name":"Living the Ommegang at the Sablon\u202f","shortdescr":null,"longdescr":"L\u2019Ommegang est une procession historique et religieuse qui existe depuis le 14\u00e8me si\u00e8cle et qui inclut tous les acteurs de la ville. Chaque ann\u00e9e, les Bruxellois perp\u00e9tuent la tradition \u00e0 travers une reconstitution de l\u2019Ommegang de 1549, organis\u00e9 pour l\u2019empereur Charles Quint et son fils Philippe. \u00c0 cette occasion, les deux serments d\u2019arbal\u00e9triers de Bruxelles organisent un concours de tir, un Charles Quint plus vrai que nature vient saluer la vierge \u00e0 la barque dans l\u2019\u00e9glise Notre-Dame du Sablon et plus de 1.400 figurants d\u00e9filent du Sablon jusqu\u2019\u00e0 la Grand-Place. V\u00eatus de costumes d\u2019\u00e9poque, vos guides vous feront revivre cet \u00e9v\u00e9nement incontournable du folklore bruxellois, en commentant cette page d\u2019histoire. Tels des journalistes sportifs regardant passer le peloton, ils vous d\u00e9voileront tout ce que vous avez toujours voulu savoir sur l\u2019Ommegang ! \r\n\r\nReservation is required.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/532837.html"},"de":{"name":"Vivre l'Ommegang au Sablon","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/532837.html"},"it":{"name":"Vivre l'Ommegang au Sablon","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/532837.html"},"sp":{"name":"Vive el Ommegang en el Sablon\u202f","shortdescr":null,"longdescr":"El Ommegang es una procesi\u00f3n hist\u00f3rica y religiosa que existe desde el siglo XIV y que incluye a todos los actores de la ciudad. Cada a\u00f1o, los habitantes de Bruselas siguen con la tradici\u00f3n a trav\u00e9s de una reconstrucci\u00f3n del Ommegang de 1549, organizada para el emperador Carlos V y su hijo Felipe. En esta ocasi\u00f3n, los dos Juramentos de Ballesteros de Bruselas organizan una competici\u00f3n de tiro, un Carlos V m\u00e1s verdadero que el aut\u00e9ntico viene a saludar a la Virgen del barco en la iglesia de Notre-Dame du Sablon y m\u00e1s de 1.400 figurantes desfilan desde el Sablon hasta la Grand-Place. Vestidos con trajes de \u00e9poca, sus gu\u00edas te har\u00e1n revivir este evento imperdible del folclore de Bruselas, comentando en esta p\u00e1gina de la historia. Como periodistas deportivos que observan pasar el pelot\u00f3n, \u00a1te dir\u00e1n todo lo que siempre quisiste saber sobre Ommegang! \r\n\r\nEs necesario reservar.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/532837.html"},"pt":{"name":"Vivre l'Ommegang au Sablon","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/532837.html"},"cn":{"name":"Vivre l'Ommegang au Sablon","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/532837.html"}},"place":{"id":260227,"translations":{"fr":{"name":"Square du Petit Sablon","address_street_name":"Place du Petit Sablon","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place du Petit Sablon","address_line2":"1000 Bruxelles","description_web":"De style n\u00e9o-renaissance flamande, le jardin fleuri du square du Petit Sablon est un bijou architectural situ\u00e9 juste en face de l\u2019\u00e9glise Notre-Dame-au-Sablon. Dans ce mus\u00e9e en plein air, les diff\u00e9rentes corporations bruxelloises sont personnifi\u00e9es par 48 statues et dix autres repr\u00e9sentent les grands humanistes du XVIe si\u00e8cle\u00a0: Mercator, Ort\u00e9lius... La flore cache d\u2019autres symboles\u00a0: neuf massifs de buis taill\u00e9s repr\u00e9sentant les neuf provinces belges de cette \u00e9poque ainsi qu\u2019une couronne \u00e9voquant le royaume.\r\n\r\nAu fond du jardin est \u00e9rig\u00e9e une statue-fontaine en hommage aux comtes d\u2019Egmont et de Hornes, r\u00e9sistants d\u00e9capit\u00e9s au XVIe si\u00e8cle pendant la tyrannie espagnole. Pour finir, deux vol\u00e9es d\u2019escaliers aboutissent dans la rue aux Laines qui vous m\u00e8ne au Parc d\u2019Egmont.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Kleine Zavelsquare","address_street_name":"Place du Petit Sablon","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Place du Petit Sablon","address_line2":"1000 Brussel","description_web":"De Kleine Zavelsquare is een architecturaal juweeltje in Vlaamse neorenaissancestijl. Het parkje bevindt zich recht tegenover de Onze-Lieve-Vrouw-ter-Zavelkerk. In dit openluchtmuseum worden de verschillende Brusselse gilden verpersoonlijkt door 48 standbeelden. Er zijn ook 10 andere beelden die staan voor de grote humanisten van de 16e eeuw: Mercator, Ortelius... De bloemen en planten in het park staan ook bol van de symboliek. Wist je dat de gesnoeide buxussen de negen Belgische provincies uit die periode voorstellen ? De kroon is een verwijzing naar het koninkrijk.\r\n\r\nAchteraan vind je een standbeeld als eerbetoon aan de graven Egmont en Hoorn. Dat waren verzetsstrijders die in de 16e eeuw werden onthoofd tijdens de Spaanse onderdrukking. Neem nu de trappen naar de Wolstraat. Daar kan je naar het Egmontpark.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Square du Petit Sablon","address_street_name":"Place du Petit Sablon","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Place du Petit Sablon","address_line2":"1000 Brussels","description_web":"Designed in a Flemish neo-renaissance style, the flower garden of square du Petit Sablon is an architectural gem right opposite the Church of Our Lady of the Sablon. In Flemish neo-renaissance style, the flower garden of square du Petit Sablon is an architectural gem right opposite the Church of Our Lady of the Sablon. In this open-air museum, the various Brussels guilds of the day are personified by 48 statues and ten others represent the great humanists of the 16th century: Mercator, Ort\u00e9lius... The flora reveals yet more symbolism: nine clumps of carved boxwood representing the nine Belgian provinces of the era and a crown for the kingdom as a whole.\r\n\r\nAt the bottom of the garden stands a fountain-statue in honour of the Counts of Egmont and Hornes, resistance fighters who were beheaded in the 16th century during the tyrannical Spanish regime. Last but not least, two flights of stairs lead you to Rue aux Laines and on to Egmont Park.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Square du Petit Sablon","address_street_name":"Rue de la R\u00e9gence","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la R\u00e9gence","address_line2":"1000 Bruxelles","description_web":"Der Square du Petit Sablon im fl\u00e4mischen Neo-Renaissance-Stil, gleich gegen\u00fcber der Kirche Notre-Dame-au-Sablon, gilt es eines der architektonischen Kleinode der Br\u00fcsseler Innenstadt.\r\n\r\nMit seinen Monumenten und Skulpturen mutet der Petit Sablon fast wie ein Freilichtmuseum an: Den schmiedeeisernen Zaun zieren 48 majest\u00e4tische romanische S\u00e4ulen, auf denen ebenso viele Bronzestatuen prangen, die die Br\u00fcsseler Handwerksz\u00fcnfte verk\u00f6rpern. Die zehn Statuen im hinteren Teil des Gartens zeigen die gro\u00dfen belgischen Humanisten, von Mercator bis Ort\u00e9lius... Der symmetrische Platz besitzt eine gro\u00dfe Symbolkraft, die bis in die Pflanzenwelt hineinreicht: Die neun Buschformationen stehen f\u00fcr die damaligen neun belgischen Provinzen.\r\n\r\nDie zentralen Statuen stellen die Grafen von Egmont und von Hornes dar, die sich im 16. Jahrhundert der spanischen Tyrannenherrschaft entgegenstellten und schlie\u00dflich enthauptet wurden. Zwei Treppen f\u00fchren in die Rue aux Laines, von der aus Sie in den Parc d\u2019Egmont gelangen.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Square du Petit Sablon","address_street_name":"Place du Petit Sablon","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place du Petit Sablon","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Plaza del Petit Sablon","address_street_name":"Place du Petit Sablon","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place du Petit Sablon","address_line2":"1000 Bruxelles","description_web":"Inaugurada en 1890, la plaza est\u00e1 rodeada por una balaustrada de hierro forjado, decorada con 48 estatuillas de bronce que representan antiguos oficios practicados en Bruselas. Hay diez estatuas que decoran la parte posterior del parque, con la intenci\u00f3n de ilustrar el siglo XVI en B\u00e9lgica a trav\u00e9s c\u00e9lebres eruditos y humanistas, tales como Mercator, Abraham Ortelius, Louis Van Bodeghem o Rombaud Dodon\u00e9e, entre otros. En el centro, las estatuas del Conde Egmont y Hornes simbolizan la lucha contra la tiran\u00eda espa\u00f1ola del siglo XVI. El pedestal est\u00e1 decorado con los escudos de los dos se\u00f1ores.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Pra\u00e7a do Petit Sablon","address_street_name":"Place du Petit Sablon","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place du Petit Sablon","address_line2":"1000 Bruxelles","description_web":"Considerado uma das joias arquitet\u00f3nicas do centro de Bruxelas, o jardim florido de estilo renascentista flamengo da Pra\u00e7a do Petit Sablon foi decorado em cerca de 1890 ao longo do tra\u00e7ado da rua R\u00e9gence. Neste museu ao c\u00e9u aberto, as diferentes corpora\u00e7\u00f5es bruxelenses s\u00e3o representadas por 48 est\u00e1tuas de bronze. As est\u00e1tuas que ornamentam o fundo do jardim ilustram o s\u00e9culo XVI belga atrav\u00e9s dos seus grandes humanistas Mercator, Abraham Ort\u00e9lius, Louis Van Bodeghem e Rombaud Dodon\u00e9e, entre outros, num total de 10. As est\u00e1tuas que ornamentam o fundo do jardim ilustram o s\u00e9culo XVI belga atrav\u00e9s dos seus grandes humanistas Mercator, Abraham Ort\u00e9lius, Louis Van Bodeghem e Rombaud Dodon\u00e9e, entre outros, num total de 10. No centro, para simbolizar a luta contra a tirania espanhola do s\u00e9culo XVI, encontramos as est\u00e1tuas dos contes de Egmont e de Hornes Equipamentos: -Bancos Acessibilidade: a pra\u00e7a est\u00e1 acess\u00edvel a pessoas portadoras de defici\u00eancia.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Square du Petit Sablon","address_street_name":"Place du Petit Sablon","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place du Petit Sablon","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[16],"translations":{"fr":["Quartier Royal"],"nl":["Koninklijke wijk"],"en":["Royal"]}},"zones":{"list":[19],"translations":{"fr":["Centre"],"nl":["Centrum"],"en":["Centre"]}},"neca":null,"facebook_id":null,"backoffice_id":20227,"location":{"lat":50.83951455,"lon":4.35661018},"region":"brussels","last_updated_at":"2022-05-19T23:05:13+02:00","published_at":"2015-03-11T14:57:28+01:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":278061,"translations":{"fr":{"name":"Once in Brussels","address_street_name":"Rue des Tanneurs","address_street_number":"62","address_street_box":null,"email":"info@onceinbrussels.be","website":"https:\/\/onceinbrussels.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Tanneurs, 62","address_line2":"1000 Bruxelles","description_web":"Once in Brussels c\u2019est une invitation \u00e0 d\u00e9couvrir la capitale sous un angle diff\u00e9rent. Ils proposent des balades et des jeux de piste o\u00f9 le Bruxelles historique rencontre celui des gastronomes, des amateurs de chocolat et des buveurs de bi\u00e8res !\r\nDes visites guid\u00e9es qui se partagent entre amis, entre coll\u00e8gues et en famille. Quelle que soit la formule, l\u2019\u00e9quipe se coupent en quatre pour concocter aux visiteurs un programme sur mesure et pour faire vivre une exp\u00e9rience unique. Ils proposent aussi un agenda d'activit\u00e9s fixes, ouvertes \u00e0 tous, pour profiter du Bruxelles qui leur passionne !\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Once in Brussels","address_street_name":"Huidevettersstraat","address_street_number":"62","address_street_box":null,"email":"info@onceinbrussels.be","website":"https:\/\/onceinbrussels.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Huidevettersstraat, 62","address_line2":"1000 Brussel","description_web":"Once in Brussels is een uitnodiging om de hoofdstad vanuit een andere invalshoek te ontdekken. Zij bieden wandelingen en speurtochten aan waar historisch Brussel de wereld van gastronomen, chocoladeliefhebbers en bierdrinkers ontmoet!\r\nRondleidingen die kunnen worden gedeeld met vrienden, collega's of familie. Wat de formule ook is, het team stelt alles in het werk om voor de bezoekers een programma op maat samen te stellen en een unieke ervaring te bieden. Ze bieden ook een vast activiteitenprogramma aan, dat voor iedereen toegankelijk is, om te genieten van het Brussel waar ze gepassioneerd over zijn!","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Once in Brussels","address_street_name":"Rue des Tanneurs","address_street_number":"62","address_street_box":null,"email":"info@onceinbrussels.be","website":"https:\/\/onceinbrussels.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue des Tanneurs, 62","address_line2":"1000 Brussels","description_web":"Once in Brussels is an invitation to discover the capital from a different angle. They offer walks and treasure hunts where historical Brussels meets the world of gastronomes, chocolate lovers and beer drinkers!\r\nGuided tours that can be shared with friends, colleagues or family. Whatever the formula, the team goes out of its way to concoct a tailor-made programme for visitors and to provide a unique experience. They also offer a fixed schedule of activities, open to all, to enjoy the Brussels they are passionate about!","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Once in Brussels","address_street_name":"Rue des Tanneurs","address_street_number":"62","address_street_box":null,"email":"info@onceinbrussels.be","website":"https:\/\/onceinbrussels.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","add