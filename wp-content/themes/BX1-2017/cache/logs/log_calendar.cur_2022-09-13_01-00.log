ns":{"fr":{"name":"Etudiants"},"nl":{"name":"Studenten"},"en":{"name":"Students"}},"value":15}],"child_events":[],"parent_events":[],"targets":{"list":[11,19,10,8,12],"translations":{"fr":["Famille","Enseignants","Seniors","Jeunes 15-18 ans","LGTBQIA"],"nl":["Familie","Leerkrachten","Senioren","Jongeren 15-18 j.","LGTBQIA"],"en":["Family","Teachers","Seniors","Youth 15-18  yr.","LGTBQIA"]}},"tags":["kids"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-09-12T10:05:08+02:00","published_at":"2022-08-31T10:06:36+02:00","backoffice_id":260710,"import_origin":null,"sub_type":"concert","show_in_agenda":true,"ranking":1.2599210498949},{"id":541141,"date_start":"2022-09-17","date_end":"2022-09-17","date_next":"2022-09-17","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre"}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Qui est blanc dans cette histoire ?","shortdescr":null,"longdescr":"Trois r\u00e9cits mis en parall\u00e8le : un missionnaire parti au Congo \u00e0 la fin du XIXe si\u00e8cle, une jeune Congolaise de la m\u00eame \u00e9poque et une femme d\u2019aujourd\u2019hui, m\u00e8re de trois enfants m\u00e9tis. Construit \u00e0 partir d\u2019archives familiales et de t\u00e9moignages, ce monologue pose la question des traces ind\u00e9l\u00e9biles que laisse l\u2019histoire coloniale.\r\n\r\nQuand? : Le samedi 17 septembre, de 11h \u00e0 12h\r\nO\u00f9 ? : A la Ferme Rose, avenue de Fr\u00e9 44\r\nR\u00e9servation souhait\u00e9e par email \u00e0 l'adresse : culture@uccle.brussels ou par t\u00e9l\u00e9phone au 02\/605.15.30","performers":"Rapha\u00eblle Bruneau","boxoffice_url":null,"website":"http:\/\/www.uccle.be","email":"culture@uccle.brussels","phone_contact":"+32 2 605 15 30","phone_booking":"+32 2 605 15 30","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.541141"},"nl":{"name":"Qui est blanc dans cette histoire ?","shortdescr":null,"longdescr":"Drie verhaallijnen naast elkaar: een missionaris die eind 19e eeuw naar Congo vertrok, een jonge Congolese vrouw uit dezelfde tijd en een vrouw van nu, moeder van drie kinderen van gemengde rassen. Gebaseerd op familiearchieven en getuigenissen, stelt deze monoloog de vraag naar de onuitwisbare sporen die de koloniale geschiedenis heeft nagelaten.\r\n\r\nZaterdag 17 september 2022 van 11 tot 12 uur.\r\nHof ten Hove _ De Fr\u00e9laan 44\r\nReservering gewenst per e-mail naar: culture@uccle.brussels of per telefoon op 02\/605.15.30","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.541141"},"en":{"name":"Qui est blanc dans cette histoire ?","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.541141"},"de":{"name":"Qui est blanc dans cette histoire ?","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.541141"},"it":{"name":"Qui est blanc dans cette histoire ?","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.541141"},"sp":{"name":"Qui est bla