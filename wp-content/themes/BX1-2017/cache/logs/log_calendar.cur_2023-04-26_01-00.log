genda":true,"ranking":0.082778184256805},{"id":550450,"date_start":"2023-04-29","date_end":"2023-04-29","date_next":"2023-04-29","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":true,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert","de":"Konzert","it":"Concerti","sp":"Concierto","pt":null,"cn":null}},"others":{"list":[4,6],"translations":{"fr":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"],"nl":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"],"en":["Pop, rock, jazz\u2026","Worldmusic, Folk & Country"],"de":["Pop, Rock, Jazz...","Worldmusic, Folk & Country"],"it":["Pop, rock, jazz\u2026","Worldmusic, Folk e Country"],"sp":["Pop, rock, jazz\u2026","Worldmusic, folk y country"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Bal & Basta ! - Viorel (Belgique) Bargainatt (France)","shortdescr":"Bal & Basta, votre bal folk du dimanche, est de retour en 2023 avec une programmation des plus exquises. Viorel r\u00e9unit deux valeurs s\u00fbres de la sc\u00e8ne bal folk belge. Bargainatt en est une autre c\u00f4t\u00e9 fran\u00e7ais.","longdescr":"Bal & Basta, votre bal folk du dimanche, est de retour en 2023 avec une programmation des plus exquises. Viorel r\u00e9unit deux valeurs s\u00fbres de la sc\u00e8ne bal folk belge. Bargainatt en est une autre c\u00f4t\u00e9 fran\u00e7ais.\r\n\r\nPassionn\u00e9 par le bal folk, Viorel nous livre une musique d\u00e9di\u00e9e \u00e0 la danse, interpr\u00e9t\u00e9e par les flandriens folk Hartwin Dhoore \u00e0 l\u2019accord\u00e9on diatonique et Jeroen Geerinck \u00e0 la guitare acoustique. Apr\u00e8s avoir tourn\u00e9 \u00e0 travers l\u2019Europe en tant qu\u2019artiste solo pendant plusieurs ann\u00e9es, ils entament avec Viorel une nouvelle \u00e9tape de leur voyage musical.\r\nUne musique moderne et authentique, alliant compositions personnelles et m\u00e9lodies traditionnelles : c\u2019est la marque de fabrique de Bargainatt ! Les musiciens puisent leur inspiration dans les danses des diff\u00e9rentes r\u00e9gions de France ch\u00e8res \u00e0 leur c\u0153ur : Auvergne, Poitou, Gascogne, Bretagne\u2026 Ce faisant, ils conservent les subtilit\u00e9s de la tradition tout en proposant un son vif et \u00e9nergique.","performers":"Viorel :\r\n\u2013 Hartwin Dhoore : accord\u00e9on\r\n\u2013 Jeroen Geerinck : guitare acoustique\r\n\r\nBargainatt :\r\n\u2013 Camille Stimbre : violon, chant\r\n\u2013 Youmi Bazoge : violon, chant\r\n\u2013 L\u00e9on Ollivier : accord\u00e9on diatonique, chant\r\n\u2013 No\u00e9 Bazoge : violoncelle, chant","boxoffice_url":null,"website":"http:\/\/www.muziekpublique.be","email":"info@muziekpublique.be","phone_contact":null,"phone_booking":"+32 2 217 26 00","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.550450"},"nl":{"name":"Bal & Basta ! - Viorel (Belgi\u00eb) Bargainatt (Frankrijk)","shortdescr":"Bal & Basta!, uw verfijne folkbal, is terug met een uitgelezen programma. Viorel verenigt twee vaste waarden binnen de Belgische balfolk-scene. Bargainatt is dan weer een grote naam uit Frankrijk.","longdescr":"Bal & Basta!, uw verfijne folkbal, is terug met een uitgelezen programma. Viorel verenigt twee vaste waarden binnen de Belgische balfolk-scene. Bargainatt is dan weer een grote naam uit Frankrijk.\r\n\r\nViorel heeft een passie voor balfolk: muziek, vooral gemaakt om te dansen, gebracht door folk-flandriens Hartwin Dhoore op diatonische accordeon en Jeroen Geerinck op akoestische gitaar. Als soloartiesten toerden ze al enkele jaren doorheen heel Europa, Viorel is nu een nieuwe \u201cetappe \u201d op hun muzikale reis.\r\nAan de hand van eigen composities en traditionele melodie\u00ebn neemt Bargainatt ons mee in een die zowel modern als authentiek is. De muzikanten halen hun inspiratie uit de dansen van de verschillende regio\u2019s van Frankrijk die hen nauw aan het hart liggen: Auvergne, Poitou, Gascogne, Bretagne\u2026 Daarbij proberen ze de subtiliteiten van de traditie zo goed mogelijk te respecteren, terwijl ze tegelijkertijd fris en energiek klinken.","performers":"Viorel:\r\n\u2013 Hartwin Dhoore: accordeon\r\n\u2013 Jeroen Geerinck: akoestische gitaar\r\n\r\nBargainatt :\r\n\u2013 Camille Stimbre : viool, zang\r\n\u2013 Youmi Bazoge : viool, zang\r\n\u2013 L\u00e9on Ollivier : diatonisch accordeon, zang\r\n\u2013 No\u00e9 Bazoge : cello, zang","boxoffice_url":null,"website":"http:\/\/www.muziekpublique.be","email":"info@muziekpublique.be","phone_contact":null,"phone_booking":"+32 2 217 26 00","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.550450"},"en":{"name":"Bal & Basta ! - Viorel (Belgium) Bargainatt (France)","shortdescr":"Bal & Basta, your Sunday folk ball, is back in 2023 with the most exquisite programming. Viorel brings together two sure values \u200b\u200bof the Belgian folk dance scene. Bargainatt is another one on the French side.","longdescr":"Bal & Basta, your Sunday folk ball, is back in 2023 with the most exquisite programming. Viorel brings together two sure values \u200b\u200bof the Belgian folk dance scene. Bargainatt is another one on the French side.\r\n\r\nPassionate about folk ball, Viorel delivers music dedicated to dance, performed by Flanders folk Hartwin Dhoore on the diatonic accordion and Jeroen Geerinck on the acoustic guitar. After touring Europe as a solo artist for several years, they are embarking on a new stage of their musical journey with Viorel.\r\nModern and authentic music, combining personal compositions and traditional melodies: this is the hallmark of Bargainatt! The musicians draw their inspiration from the dances of the different regions of France dear to their hearts: Auvergne, Poitou, Gascony, Brittany... In doing so, they preserve the subtleties of tradition while offering a lively and energetic sound.","performers":"Viorel:\r\n\u2013 Hartwin Dhoore: accordion\r\n\u2013 Jeroen Geerinck: acoustic guitar\r\n\r\nBargainatt :\r\n\u2013 Camille Stimbre: violin, vocals\r\n\u2013 Youmi Bazoge: violin, vocals\r\n\u2013 L\u00e9on Ollivier: diatonic accordion, vocals\r\n\u2013 No\u00e9 Bazoge: cello, vocals","boxoffice_url":null,"website":"http:\/\/www.muziekpublique.be","email":"info@muziekpublique.be","phone_contact":null,"phone_booking":"+32 2 217 26 00","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.550450"},"de":{"name":"Bal & Basta ! - Viorel (Belgique) Bargainatt (France)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.muziekpublique.be","email":"info@muziekpublique.be","phone_contact":null,"phone_booking":"+32 2 217 26 00","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.550450"},"it":{"name":"Bal & Basta ! - Viorel (Belgique) Bargainatt (France)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.muziekpublique.be","email":"info@muziekpublique.be","phone_contact":null,"phone_booking":"+32 2 217 26 00","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.550450"},"sp":{"name":"Bal & Basta ! - Viorel (Belgique) Bargainatt (France)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.muziekpublique.be","email":"info@muziekpublique.be","phone_contact":null,"phone_booking":"+32 2 217 26 00","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.550450"},"pt":{"name":"Bal & Basta ! - Viorel (Belgique) Bargainatt (France)","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.muziekpublique.be","email":"info@muziekpublique.be","phone_contact":null,"phone_booking":"+32