name":"Normaal"},"en":{"name":"Normal"}},"value":5},{"translations":{"fr":{"name":"Enfants"},"nl":{"name":"Kinderen"},"en":{"name":"Children"}},"value":0},{"translations":{"fr":{"name":"Jeunes"},"nl":{"name":"Jongeren"},"en":{"name":"Young people"}},"value":3},{"translations":{"fr":{"name":"Seniors"},"nl":{"name":"Senioren"},"en":{"name":"Seniors"}},"value":3},{"translations":{"fr":{"name":"museumpassmus\u00e9es"},"nl":{"name":"museumpassmus\u00e9es"},"en":{"name":"museumpassmus\u00e9es"}},"value":0},{"translations":{"fr":{"name":"Etudiants"},"nl":{"name":"Studenten"},"en":{"name":"Students"}},"value":3},{"translations":{"fr":{"name":"Article 27"},"nl":{"name":"Artikel 27"},"en":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-24T01:36:10+02:00","published_at":"2022-09-30T15:50:26+02:00","backoffice_id":262865,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.43679023236815},{"id":539248,"date_start":"2022-10-25","date_end":"2022-11-05","date_next":"2022-10-25","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater"}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"],"de":["Theater"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Hamlet sauv\u00e9\u00b7e des os - Groupe Mat\u00e9riau","shortdescr":"Ceci commence mal, mais pire viendra\r\n    Hamlet, W. Shakespeare, III, 4","longdescr":"Le temps presse.\r\nLa tragique histoire d\u2019Hamlet, en 37 mots : Hamlet, prince du Danemark, a perdu son p\u00e8re. Ce dernier revient sous la forme d\u2019un spectre, r\u00e9v\u00e8le les circonstances de sa mort \u2013 un crime odieux \u2013 et demande que justice lui soit rendue en tuant l\u2019assassin.\r\nImaginez que nous ayons pass\u00e9 la pi\u00e8ce de Shakespeare dans plusieurs bains de chimie successifs, compos\u00e9s des produits que sont nos inconscients, nos questionnements, nos lubies, nos impuissances : se r\u00e9v\u00e8le alors un divertissement acide et explosif.\r\nDes d\u00e9chets de cette exp\u00e9rience, appara\u00eet un groupe de survivant\u00b7e\u00b7s d\u2019une possible apocalypse \u00e9voquant la fin du monde.\r\n\r\nRestez avec nous.\r\n\r\nDans cette course folle \u00e0 la distraction, les vestiges de l\u2019oeuvre de Shakespeare \u00e9mergent comme des \u00eelots, et nous invitent \u00e0 ralentir, \u00e0 honorer nos morts.\r\n\r\nBienvenue \u00e0 Elseneur, ce pays charmant.","performers":"Le groupe Mat\u00e9riau, qui s\u2019est constitu\u00e9 au cours d\u2019un atelier professionnel dirig\u00e9 par Isabelle Pousseur autour de la pi\u00e8ce Tourista de Mayenburg, s\u2019empare de Hamlet, de William Shakespeare, pour en faire \u00e9merger la pi\u00e8ce fant\u00f4me. \r\n\r\nAvec Brune Bazin, C\u00e9line Beigbeder, Ir\u00e8ne Berruyer, Adrien Desbons, Francesco Italiano, Sarah Messens.","boxoffice_url":null,"website":"http:\/\/www.oceannord.org","email":"info@oceannord.org","phone_contact":"+32 2 242 96 89","phone_booking":"+32 2 216 75 55","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.539248"},"nl":{"name":"Hamlet sauv\u00e9\u00b7e des os","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.539248"},"en":{"name":"Hamlet sauv\u00e9\u00b7e des os","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"web