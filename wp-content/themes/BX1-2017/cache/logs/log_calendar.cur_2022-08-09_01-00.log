opyright":null},"en":{"title":"Le quartier Flagey","copyright":null}}}],"dates":[{"day":"2022-08-28","doors":null,"start":"14:00:00","end":"16:00:00","is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":10},{"translations":{"fr":{"name":"Article 27"},"nl":{"name":"Artikel 27"},"en":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-07-27T12:05:40+02:00","published_at":"2022-04-03T03:30:21+02:00","backoffice_id":250787,"import_origin":"explore","sub_type":"other","show_in_agenda":true,"ranking":1},{"id":523548,"date_start":"2022-08-28","date_end":"2022-08-28","date_next":"2022-08-28","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{"list":[109],"translations":{"fr":["Espaces verts"],"nl":["Groene zones"],"en":["Green spaces"]}}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Evolution; sexe, drogues et violence","shortdescr":"A 14h: La nature est belle \u2026 et impitoyable, aussi au Scheutbos. Venez d\u00e9couvrir ce monde insoup\u00e7onn\u00e9 : \u00e7a se bagarre et \u00e7a copule, parfois les deux ensemble. Ajoutez-y un soup\u00e7on de chimie malveillante. Posez un regard sur la face cach\u00e9e de la nature.\r\nR\u00e9servatioon et masque obligatoires","longdescr":"A 14h: Une nature intacte qui nous offre une image idyllique et romantique. C\u2019est incontestable. Mais en coulisse se jouent des milliers de micro-drames, parfois cruels. Des insectes obs\u00e9d\u00e9s sexuels aux plantes herbicidaires \u2013 recourant \u00e0 l\u2019arme chimique - en passant par les luttes territoriales chantantes, nous vous invitons \u00e0 venir voir notre environnement sous un autre angle. Un monde o\u00f9 l\u2019\u00e9volution ne fait pas de quartier.\r\nR\u00e9servation et masque obligatoires","performers":null,"boxoffice_url":null,"website":"http:\/\/www.scheutbos.be\/","email":"scheutbos@yahoo.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/523548.html"},"nl":{"name":"Evolutie: seks, drugs en geweld","shortdescr":"Om 9u30: De natuur is mooi \u00e9n genadeloos, ook in het Scheutbos. Kom deze onvermoede wereld ontdekken. Knokken, vechten, doden, paren zijn dagelijkse kost van de bewoners van het Scheutbos. Voeg er een zweem van boosaardige chemie aan toe. Een kijk op een onverwachte natuur ! Inschrijving en masker verplicht.","longdescr":"Om 9u30: Een ongerepte natuurgebied biedt een idyllisch en romantisch beeld. Zo is het ook. Maar achter het scherm voordoen zich gruwelijke minidrama\u2019s. Van seksmaniakinsecten tot herbicidale chemisch-bewapende planten en geweldadige vogelszang(vecht)partijen, wij nodigen je uit om onze natuurgebieden vanuit een ander perspectief te bekijken. Een wereld waar de evolutie geen genade toont. Inschrijving en masker verplicht","performers":null,"boxoffice_url":null,"website":"http:\/\/www.scheutbos.be\/","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/523548.html"},"en":{"name":"Evolution; sexe, drogues et violence","shortdescr":"In Dutch at 9.30 en in French at 14.00","longdescr":"In Dutch at 9.30 en in French at 14.00","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/523548.html"},"de":{"name":"Evolution; sexe, drogues et violence","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/523548.html"},"it":{"name":"Evolution; sexe, drogues et violence","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/523548.html"},"sp":{"name":"Evolution; sexe, drogues et violence","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/523548.html"},"pt":{"name":"Evolution; sexe, drogues et violence","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/523548.html"},"cn":{"name":"Evolution; sexe, drogues et violence","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/523548.html"}},"place":{"id":250983,"translations":{"fr":{"name":"Les Amis du Scheutbos","address_street_name":"Rue Scheutbosch","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.scheutbos.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Rue Scheutbosch","address_line2":"1080 Molenbeek-Saint-Jean","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Les Amis du Scheutbos","address_street_name":"Scheutboschstraat","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.scheutbos.be\/","phone_con