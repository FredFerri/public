}},"others":{}},"translations":{"de":{"name":"Histoire de la fille qui ne voulait pas \u00eatre un chien","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lamontagnemagique.be\/histoire-de-la-fille-qui-ne-voulait-pas-etre-un-chien\/","email":"info@montagnemagique.be","phone_contact":"+32 2 210 15 90","phone_booking":"+32 2 210 15 90","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50008219"},"pt":{"name":"Histoire de la fille qui ne voulait pas \u00eatre un chien","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lamontagnemagique.be\/histoire-de-la-fille-qui-ne-voulait-pas-etre-un-chien\/","email":"info@montagnemagique.be","phone_contact":"+32 2 210 15 90","phone_booking":"+32 2 210 15 90","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50008219"},"en":{"name":"Histoire de la fille qui ne voulait pas \u00eatre un chien","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lamontagnemagique.be\/histoire-de-la-fille-qui-ne-voulait-pas-etre-un-chien\/","email":"info@montagnemagique.be","phone_contact":"+32 2 210 15 90","phone_booking":"+32 2 210 15 90","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50008219"},"it":{"name":"Histoire de la fille qui ne voulait pas \u00eatre un chien","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lamontagnemagique.be\/histoire-de-la-fille-qui-ne-voulait-pas-etre-un-chien\/","email":"info@montagnemagique.be","phone_contact":"+32 2 210 15 90","phone_booking":"+32 2 210 15 90","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50008219"},"cn":{"name":"Histoire de la fille qui ne voulait pas \u00eatre un chien","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lamontagnemagique.be\/histoire-de-la-fille-qui-ne-voulait-pas-etre-un-chien\/","email":"info@montagnemagique.be","phone_contact":"+32 2 210 15 90","phone_booking":"+32 2 210 15 90","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50008219"},"fr":{"name":"Histoire de la fille qui ne voulait pas \u00eatre un chien","shortdescr":"Un narrateur et une danseuse r\u00e9gisseuse nous accompagnent dans l\u2019histoire et dans un d\u00e9dale d\u2019ampoules. Peu \u00e0 peu, fils \u00e9lectriques et fils narratifs s\u2019entrem\u00ealent, l\u2019imagination du public bat son plein. Reste une ligne claire, limpide\u200a: l\u2019importance de la transmission r\u00e9ciproque et des rapports simples et doux.\n","longdescr":"Sacha, 9 ans, a enfin l\u2019\u00e2ge de participer \u00e0 la course annuelle de Caisse-\u00e0-savon au parc Josaphat.\n\nPour entrer dans cette histoire, il faut d\u2019abord passer par un parc, emprunter ses chemins, longer ses \u00e9tangs, croiser des promeneurs et promeneuses, des cyclistes, quelques animaux\u2026 Une fois entr\u00e9s et entr\u00e9es dans cette histoire, vous d\u00e9couvrez Sacha et son papa. Sacha r\u00eave de gagner la course de caisse-\u00e0-savon \u00e0 la f\u00eate du parc. Mais pourra-t-elle y participer\u200a\u200a? Une mauvaise nouvelle vient perturber leurs plans\u200a: bient\u00f4t, son papa sera aveugle. Mais c\u2019est sans compter sur l\u2019\u00e9nergie de vie de la fillette, de ses amis et amies, de tout leur entourage\u2026\n\nAvec Philippe L\u00e9onard (com\u00e9dien) et Lucia Palladino (danseuse). \u00c9criture\u200a: Philippe L\u00e9onard et Olivier Lenel. Mise en sc\u00e8ne\u200a: Olivier Lenel. Sc\u00e9nographie et costumes\u200a: Catherine Somers. D\u00e9cor sonore et musique\u200a: Philippe Morino. Lumi\u00e8re et r\u00e9gie\u200a: Emanuele Gonano. Collaboration chor\u00e9graphique\u200a: Anne-C\u00e9cile Shane-Tune.","performers":"Foule Th\u00e9\u00e2tre","boxoffice_url":null,"website":"https:\/\/lamontagnemagique.be\/histoire-de-la-fille-qui-ne-voulait-pas-etre-un-chien\/","email":"info@montagnemagique.be","phone_contact":"+32 2 210 15 90","phone_booking":"+32 2 210 15 90","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50008219"},"sp":{"name":"Histoire de la fille qui ne voulait pas \u00eatre un chien","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lamontagnemagique.be\/histoire-de-la-fille-qui-ne-voulait-pas-etre-un-chien\/","email":"info@montagnemagique.be","phone_contact":"+32 2 210 15 90","phone_booking":"+32 2 210 15 90","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50008219"},"nl":{"name":"Histoire de la fille qui ne voulait pas \u00eatre un chien","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lamontagnemagique.be\/histoire-de-la-fille-qui-ne-voulait-pas-etre-un-chien\/","email":"info@montagnemagique.be","phone_contact":"+32 2 210 15 90","phone_booking":"+32 2 210 15 90","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50008219"}},"place":{"id":228012,"translations":{"de":{"name":"Kindertheater - Th\u00e9\u00e2tre La montagne magique","address_street_name":"Rue du Marais","address_street_number":"57","address_street_box":null,"email":"info@montagnemagique.be","website":"http:\/\/www.theatremontagnemagique.be","phone_contact":"+32 2 210 15 90","phone_booking":"+32 2 210 15 90","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Marais, 57","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Th\u00e9\u00e2tre La montagne magique","address_street_name":"Rue du Marais","address_street_number":"57","address_street_box":null,"email":"info@montagnemagique.be","website":"http:\/\/www.theatremontagnemagique.be","phone_contact":"+32 2 210 15 90","phone_booking":"+32 2 210 15 90","address_zip":"10