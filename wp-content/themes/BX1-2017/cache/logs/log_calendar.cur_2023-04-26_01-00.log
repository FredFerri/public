origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.23404631038832},{"id":554153,"date_start":"2023-04-13","date_end":"2023-06-30","date_next":"2023-04-26","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung","it":"Esposizioni","sp":"Exhibici\u00f3n","pt":null,"cn":null}},"others":{"list":[24,34],"translations":{"fr":["Galeries d'art","Pluridisciplinaire"],"nl":["Galeries","Pluridisciplinair"],"en":["Art Galleries","Multidisciplinary"],"de":["Kunstgalerien","Multidisziplin\u00e4r"],"it":["Gallerie d'arte","Multidisciplinare"],"sp":["Galer\u00edas de arte","Multidisciplinar"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","en","nl"],"subtitles":[]},"translations":{"fr":{"name":"EXPO 3 : PAVILLON \/ Ateliers J&J","shortdescr":"Apr\u00e8s le succ\u00e8s du Pavillon \u00e0 la foire Collectible, les Ateliers J&J vous invitent \u00e0 venir d\u00e9couvrir leur nouvelle exposition EXPO 3, au Shop & Labo, Alsemberg 110, \u00e0 partir du 13 avril d\u00e8s 18h.","longdescr":"Apr\u00e8s le succ\u00e8s du Pavillon \u00e0 la foire Collectible, les Ateliers J&J vous invitent \u00e0 venir d\u00e9couvrir leur nouvelle exposition EXPO 3, au Shop & Labo, Alsemberg 110, \u00e0 partir du 13 avril d\u00e8s 18h. \r\n\r\nLes artistes et designers Cristina Gusano, Jules Bouchier-V\u00e9gis, Benjamin Mengitsu-Navet, Tommy Lhomme, El\u00e9onore Joulin, Mon Colonel & Spit, Studio El\u00e9mentaires et Pascale Theodoly vous pr\u00e9senteront leurs nouvelles cr\u00e9ations au sein de l'espace Alsemberg 110. \r\n\r\nLe vernissage de l'EXPO 3 aura lieu le jeudi 13 avril de 18h \u00e0 21h, en pr\u00e9sence des artistes. Sans oublier la traditionnelle tombola qui aura pour but de soutenir un projet qui nous tient \u00e0 coeur : l'ASBL L'ilot, avec leur projet \"Le 73\", la construction d'un nouveau centre d'accueil de jour pour les personnes sans abri, \u00e0 Saint Gilles. \r\n\r\nEXPO 3 : PAVILLON x ATELIERS J&J chez ALSEMBERG 110, \u00e0 partir du 14 avril. \r\nChauss\u00e9e d'alsemberg 110, 1060 Saint-Gilles\r\nVernissage le jeudi 13 avril, de 18h \u00e0 21h - Tombola \u00e0 20h","performers":"Les artistes et designers Cristina Gusano, Jules Bouchier-V\u00e9gis, Benjamin Mengitsu-Navet, Tommy Lhomme, El\u00e9onore Joulin, Mon Colonel & Spit, Studio El\u00e9mentaires et Pascale Theodoly vous pr\u00e9senteront leurs nouvelles cr\u00e9ations au sein de l'espace Alsemberg 110 avec Ateliers J&J.","boxoffice_url":null,"website":"http:\/\/www.alsemberg110.biz","email":"contact@ateliersjetj.com","phone_contact":"+32 485 13 19 63","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.554153"},"nl":{"name":"EXPO 3 : PAVILLON \/ Ateliers J&J","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.alsemberg110.biz","email":"contact@ateliersjetj.com","phone_contact":"+32 485 13 19 63","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.554153"},"en":{"name":"EXPO 3 : PAVILLON \/ Ateliers J&J","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.alsemberg110.biz","email":"contact@ateliersjetj.com","phone_contact":"+32 485 13 19 63","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.554153"},"de":{"name":"EXPO 3 : PAVILLON \/ Ateliers J&J chez Alsemberg 110","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.alsemberg110.biz","email":"contact@ateliersjetj.com","phone_contact":"+32 485 13 19 63","phone_booking":null,"agenda_url":"https:\/\/v