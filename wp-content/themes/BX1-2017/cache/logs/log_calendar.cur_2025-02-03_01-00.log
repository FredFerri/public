 380 22 09","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700005305"},"pt":{"name":"Promenade & Visite d\u2019interieur : \u201cDans les coulisses de Tour & Taxis\u201d","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/korei.be\/fr\/event\/promenade-visite-dinterieur-dans-les-coulisses-de-tour-taxis-2\/","email":"info@korei.be","phone_contact":"+32 2 380 22 09","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700005305"},"en":{"name":"Promenade & Visite d\u2019interieur : \u201cDans les coulisses de Tour & Taxis\u201d","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/korei.be\/fr\/event\/promenade-visite-dinterieur-dans-les-coulisses-de-tour-taxis-2\/","email":"info@korei.be","phone_contact":"+32 2 380 22 09","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700005305"},"it":{"name":"Promenade & Visite d\u2019interieur : \u201cDans les coulisses de Tour & Taxis\u201d","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/korei.be\/fr\/event\/promenade-visite-dinterieur-dans-les-coulisses-de-tour-taxis-2\/","email":"info@korei.be","phone_contact":"+32 2 380 22 09","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700005305"},"cn":{"name":"Promenade & Visite d\u2019interieur : \u201cDans les coulisses de Tour & Taxis\u201d","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/korei.be\/fr\/event\/promenade-visite-dinterieur-dans-les-coulisses-de-tour-taxis-2\/","email":"info@korei.be","phone_contact":"+32 2 380 22 09","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700005305"},"fr":{"name":"Promenade & Visite d\u2019interieur : \u201cDans les coulisses de Tour & Taxis\u201d","shortdescr":"Nous vous emmenons dans les coulisses du site en constante \u00e9volution de Tour & Taxis\u2026\nNous partons de l\u2019Entrep\u00f4t Royal o\u00f9 nous d\u00e9couvrons l\u2019\u00e9norme site, son histoire et ses fonctions au fil du temps \u00e0 l\u2019aide d\u2019une maquette. Le guide nous donnera \u00e9galement un aper\u00e7u des nouvelles \u00e9volutions : quels projets ont d\u00e9j\u00e0 \u00e9t\u00e9 r\u00e9alis\u00e9s et quels sont ceux qui sont encore en cours ?\n","longdescr":"Nous visitons le toit-terrasse de l\u2019Entrep\u00f4t Royal et d\u00e9couvrons les caves vo\u00fbt\u00e9es des Sheds, qui abritent m\u00eame un producteur de pleurotes.\nEt nous d\u00e9couvrons la Gare Maritime, b\u00e2timent monumental et \u00e9poustouflant, r\u00e9cemment restaur\u00e9e : une ville dans la ville o\u00f9 il ne pleut jamais. Les gigantesques salles, d\u2019une profondeur de 175 m\u00e8tres, reposent sur de minces piliers en fonte avec des \u00e9l\u00e9ments Art Nouveau. La gare, construite entre 1902 et 1908, \u00e9tait \u00e0 l\u2019\u00e9poque la plus grande gare de fret d\u2019Europe. L\u2019architecte Jan De Moffarts (Altstadt) a r\u00e9alis\u00e9 la restauration en collaboration avec le Bureau Bouwtechniek. Neutelings Riedijk Architects, connu du MAS d\u2019Anvers, y a ajout\u00e9 de nouveaux \u00e9l\u00e9ments qui s\u2019int\u00e8gre merveilleusement bien. Pour conclure le tour, nous visiterons l\u2019un de ces modules qui sert de bureau.\n","performers":"Korei Guided Tours","boxoffice_url":null,"website":"https:\/\/korei.be\/fr\/event\/promenade-visite-dinterieur-dans-les-coulisses-de-tour-taxis-2\/","email":"info@korei.be","phone_contact":"+32 2 380 22 09","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700005305"},"sp":{"name":"Promenade & Visite d\u2019interieur : \u201cDans les coulisses de Tour & Taxis\u201d","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url