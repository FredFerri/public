ion_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Zinneke","address_street_name":"Place Masui","address_street_number":"13","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Masui, 13","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":[],"zones":{"list":[20],"translations":{"fr":["Nord"],"nl":["Noord"],"en":["North"],"de":["Norden"],"it":["Nord"],"sp":["Norte"],"pt":[null],"cn":[null]}},"neca":null,"facebook_id":null,"backoffice_id":39183,"location":{"lat":50.87116404,"lon":4.36449896},"region":"brussels","last_updated_at":"2023-03-26T04:35:49+02:00","published_at":"2022-08-10T15:11:10+02:00","import_origin":null,"external_id":null,"is_in_address_book":false,"is_in_vb_export":false,"resto_ranking":0},"organizer":{"id":275932,"translations":{"fr":{"name":"Mus\u00e9e du Capitalisme","address_street_name":"Place Masui","address_street_number":"13","address_street_box":null,"email":"contact@museeducapitalisme.org","website":"https:\/\/museeducapitalisme.org\/","phone_contact":"+32 472 51 24 84","phone_booking":"+32 472 51 24 84","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Masui, 13","address_line2":"1000 Bruxelles","description_web":"Le Mus\u00e9e du Capitalisme est aujourd\u2019hui une ASBL orient\u00e9e autours d\u2019un projet central : le Mus\u00e9e Nomade. Exposition itin\u00e9rante et innovante sur notre syst\u00e8me \u00e9conomique et culturel, le Mus\u00e9e Nomade propose un contenu accessible \u00e0 un large public, \u00e0 travers une ambiance interactive et agr\u00e9able \u00e0 visiter.\r\n\r\nCette exposition bilingue (FR-NL) offre un espace original d\u2019apprentissage sur notre soci\u00e9t\u00e9, \u00e0 travers 4 salles : origines, espoirs, limites et alternatives du capitalisme. En abordant des th\u00e8mes comme l\u2019alimentation, la sant\u00e9, la culture, la consommation ou la finance, cette exposition, ouverte \u00e0 tous publics d\u00e9s 15 ans, se veut \u00eatre une tentative aboutie de mise en d\u00e9bat d\u2019une actualit\u00e9 \u00e9conomique complexe qui structure n\u00e9anmoins nos vies.\r\n\r\nL\u2019exposition est engag\u00e9e mais non partisane, elle est un outil au service de la citoyennet\u00e9 active.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Museum van het Kapitalisme","address_street_name":"Masuiplein","address_street_number":"13","address_street_box":null,"email":"contact@museumvanhetkapitalisme.org","website":"https:\/\/museeducapitalisme.org\/nl\/homepage-2\/","phone_contact":"+32 472 51 24 84","phone_booking":"+32 472 51 24 84","address_zip":"1000","address_city":"Brussel","address_line1":"Masuiplein, 13","address_line2":"1000 Brussel","description_web":"Het Museum van het Kapitalisme is een vereniging zonder winstoogmerk met als centraal project het Nomadisch Museum. Het Nomadisch Museum, is een vernieuwende reizende tentoonstelling over ons economisch en cultureel systeem en biedt een inhoud die toegankelijk is voor een breed publiek, via een interactieve en toegankelijke sfeer.\r\n\r\nDe tweetalige tentoonstelling (FR-NL) biedt een originele leerplek over onze samenleving, aan de hand van 4 zalen: oorsprong, hoop, grenzen en alternatieven van het kapitalisme. Door thema's als voeding, gezondheid, cultuur, consumptie en financi\u00ebn te behandelen, is deze tentoonstelling, die toegankelijk is voor een publiek vanaf 15 jaar, een poging om een debat aan te gaan over een complexe maatschappelijke situatie die niettemin ons dagelijkse leven structureert.\r\n\r\nDe tentoonstelling is ge\u00ebngageerd maar niet partijdig, het is een medium voor actief burgerschap.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Museum of Capitalism","address_street_name":"Place Masui","address_street_number":"13","address_street_box":null,"email":"contact@museeducapitalisme.org","website":"https:\/\/museeducapitalisme.org\/","phone_contact":"+32 472 51 24 84","phone_booking":"+32 472 51 24 84","address_zip":"1000","address_city":"Brussels","address_line1":"Place Masui, 13","address_line2":"1000 Brussels","description_web":"The Museum of Capitalism is a travelling and innovative exhibition about our economic and cultural system with content accessible to a broad audience, through an interactive exhibit with a pleasant atmosphere during the visit.\r\n\r\nThe bilingual exhibition (FR-NL) offers an original space for learning about our society, through 4 rooms: origins, hopes, limits and alternatives of capitalism. By addressing themes such as food, health, culture, consumerism and finance, this exhibition is open to all audiences from the age of 15. It is intended to provoke and facilitate the debate about a complex economic issue that nevertheless structures our lives.\r\n\r\nThe exhibition is engaged but not party related, it is a tool at the service of active citizenship.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Mus\u00e9e du Capitalisme","address_street_name":"Place Masui","address_street_number":"13","address_street_box":null,"email":"contact@museeducapitalisme.org","website":"https:\/\/museeducapitalisme.org\/","phone_contact":"+32 472 51 24 84","phone_booking":"+32 472 51 24 84","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Masui, 13","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Mus\u00e9e du Capitalisme","address_street_name":"Place Masui","address_street_number":"13","address_street_box":null,"email":"contact@museeducapitalisme.org","website":"https:\/\/museeducapitalisme.org\/","phone_contact":"+32 4