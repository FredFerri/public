ild_events":[],"parent_events":[],"targets":{"list":[3,4,5,11,10],"translations":{"fr":["Enfants 3-6 ans","Enfants 6-9 ans","Enfants 9-12 ans","Famille","Seniors"],"nl":["Kinderen 3-6 j.","Kinderen 6-9 j.","Kinderen 9-12 j.","Familie","Senioren"],"en":["Children 3-6 yr.","Children 6-9 yr.","Children 9-12 yr.","Family","Seniors"],"de":["Kinder 3-6 Jahre","Kinder 6-9 Jahre","Kinder 9-12 Jahre","Familie","Senioren"],"it":["Bambini 3-6 anni","Bambini 6-9 anni","Bambini 9-12 anni","Famiglie","Anziani"],"sp":["Ni\u00f1os de 3 a 6 a\u00f1os","Ni\u00f1os de 6 a 9 a\u00f1os","Ni\u00f1os de 9 a 12 a\u00f1os","Familias","Personas de la tercera edad"],"pt":[null,null,null,null,null],"cn":[null,null,null,null,null]}},"tags":["kids"],"accessibilities":{"list":[255],"translations":{"fr":["Accessible"],"nl":["Toegankelijk"],"en":["Accessible"],"de":["Barrierefrei"],"it":["Accessibile"],"sp":["Habilitado"],"pt":[null],"cn":[null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2023-02-28T05:36:58+01:00","published_at":"2023-02-15T12:34:10+01:00","backoffice_id":271773,"import_origin":null,"sub_type":"concert","show_in_agenda":true,"ranking":1.2599210498949},{"id":552823,"date_start":"2023-03-11","date_end":"2023-03-11","date_next":"2023-03-11","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":1,"translations":{"fr":"Concert","nl":"Concert","en":"Concert","de":"Konzert","it":"Concerti","sp":"Concierto","pt":null,"cn":null}},"others":{"list":[4,10],"translations":{"fr":["Pop, rock, jazz\u2026","Jazz & Blues"],"nl":["Pop, rock, jazz\u2026","Jazz & Blues"],"en":["Pop, rock, jazz\u2026","Jazz & Blues"],"de":["Pop, Rock, Jazz...","Jazz & Blues"],"it":["Pop, rock, jazz\u2026","Jazz e Blues"],"sp":["Pop, rock, jazz\u2026","Jazz y blues"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"SAOUTA, Damien Brassart quartet","shortdescr":"Un oud, des tablas, un saxophone soprano, une contrebasse: les quatre voix s\u2019entrecroisent. Elles parlent au travers de leurs intonations et de leurs couleurs diffe\u0301rentes.  L\u2019univers de Saouta, fruit d\u2019un imaginaire nourri de musiques celtique, arabe, indienne et de jazz, est une ode aux voyages, a\u0300 l\u2019instant, au souffle qui passe.","longdescr":"Comme dans tous re\u0301cits sur les origines, tout commence par un son, un souffle qui soudain se mettrait en mouvement, impulsant l\u2019ordre du monde. \u00ab Ode to travel \u00bb s\u2019inscrit dans cette dynamique, ce flux de re\u0301sonances sonores et musicales, sources de joie et de connexions.\r\n\r\nAu commencement donc, Damien Brassart (saxophone soprano) fe\u0301ru de musiques celtiques et orientales, prompt a\u0300 se saisir de l\u2019esprit jazz pour mieux abolir les frontie\u0300res, devait proposer a\u0300 Bernard Flament (tabla) une se\u0301rie de compositions souffle\u0301es. Sans toutefois remplir les de\u0301sirs d\u2019Orient, d\u2019extase, de transe soufie iranienne et indienne qui coexistent en ce premier re\u0301pertoire, c\u2019est au contact d\u2019Akram Ben Romdhane, virtuose tunisien du oud, que leur voyage vers l\u2019Est s\u2019affirme soudain. A Saouta - Sax-Oud-Tabla \u2013 viendra finalement s\u2019adjoindre la contrebasse de Jim Monneau, venu offrir le surcroi\u0302t de profondeur rythmique et harmonique aux compositions existantes.\r\n\r\nDu fil de cette libre traverse\u0301e vers le Levant subsiste ne\u0301anmoins un fort esprit\r\n\u00ab jazz \u00bb commun a\u0300 ces quatre artistes. Ce jazz qui assure si bien l\u2019e\u0301lan vital en se jouant des vents contraires, des violentes mare\u0301es de nos passions quotidiennes. Ce souffle cre\u0301atif venu d\u2019Afrique qui contrecarre les coups du sort en immisc\u0327ant aux pulsations, la joie d\u2019e\u0302tre la\u0300, vivant et vibrant! Un esprit jazz tendu vers l\u2019Ouest qui de Bruxelles, au carrefour de l\u2019Europe, se retourne cependant a\u0300 la rencontre du grand Est, de l\u2019Orient, pour y tisser des liens, jeter des ponts, tracer des routes, ramifier des rencontres, ba\u0302tir enfin des cultures qui de\u0301sarment, ce\u0301le\u0300brent, rassemblent au-dela\u0300 de toutes frontie\u0300res.","performers":"Damien Brassart  Saxophone soprano,  Akram Ben Romdane  Oud, Jim Monneau   Contrebasse,    Bernard Flament Percussions","boxoffice_url":null,"website":"https:\/\/www.lebaixu.be","email":"info@lebaixu.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.552823"},"nl":{"name":"SAOUTA, Damien Brassart quartet","shortdescr":"Een oud, tablas, sopraansaxofoon, contrabas: de vier stemmen verstrengelen. Ze spreken door hun verschillende intonaties en kleuren.","longdescr":"Saouta's universum, de vrucht van een verbeelding gevoed door Keltische, Arabische, Indische en jazzmuziek, is een ode aan het reizen, aan het moment, aan de voorbijgaande adem. \r\nZoals in alle oorsprongsverhalen begint alles met een geluid, een adem die zich plotseling in beweging zet en de orde van de wereld aanstuurt. \"Ode aan de reis\" maakt deel uit van deze dynamiek, deze stroom van geluid en muzikale resonanties, bronnen van vreugde en verbindingen. \r\nIn het begin zou Damien Brassart (sopraansaxofoon), een liefhebber van Keltische en Ori\u00ebntaalse muziek, die snel de geest van de jazz aangrijpt om de grenzen beter op te heffen, aan Bernard Flament (tabla) een reeks geblazen composities voorstellen. Zonder echter de verlangens van het Oosten, van extase, van Iraanse en Indische soefi-trance die in dit eerste repertoire samenkomen, te vervullen, is het in contact met Akram Ben Romdhane, Tunesische virtuoos van de oud, dat hun reis naar het Oosten zich plotseling doet gelden. Saouta - Sax-Oud-Tabla - krijgt tenslotte gezelschap van de contrabas van Jim Monneau, die ritmische en harmonische diepte toevoegt aan de bestaande composities. \r\nUit de rode draad van deze vrije oversteek naar de Levant blijkt toch een sterke \"jazz\"-geest die deze vier artiesten gemeen hebben.\r\n\"geest\" die deze vier artiesten gemeen hebben. Deze jazz die de vitale impuls zo goed verzekert door te spelen met de tegenwind, de gewelddadige getijden van onze dagelijkse passies. Deze creatieve adem uit Afrika die de slagen van het lot tegengaat door aan de pulsaties de vreugde toe te voegen van het daar zijn, levend en bruisend! Een jazz-geest die zich uitstrekt naar het Westen, die zich vanuit Brussel, op het kruispunt van Europa, toch naar het Oosten richt, naar het Oosten, om banden te smeden, bruggen te bouwen, routes te traceren, ontmoetingen te vertakken en uiteindelijk culturen op te bouwen die ontwapenen, vieren en samenkomen over alle grenzen heen","performers":"Damien Brassart  Saxophone soprano,  Akram Ben Romdane  Oud, Jim Monneau   Contrebasse,    Bernard Flament Percussions","boxoffice_url":null,"website":"https:\/\/www.lebaixu.be","email":"info@lebaixu.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.552823"},"en":{"name":"SAOUTA, Damien Brassart quartet","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lebaixu.be","email":"info@lebaixu.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.552823"},"de":{"name":"SAOUTA, Damien Brassart quartet","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lebaixu.be","email":"info@lebaixu.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.552823"},"it":{"name":"SAOUTA, Damien Brassart quartet","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lebaixu.be","email":"info@lebaixu.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.552823"},"sp":{"name":"SAOUTA, Damien Brassart quartet","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lebaixu.be","email":"info@lebaixu.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.552823"},"pt":{"name":"SAOUTA, Damien Brassart quartet","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lebaixu.be","email":"info@lebaixu.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.552823"},"cn":{"name":"SAOUTA, Damien Brassart quartet","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.lebaixu.be","email":"info@lebaixu.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.552823"}},"place":{"id":279109,"translations":{"fr":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"info@lebaixu.be","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard, 3","address_line2":"1000 Bruxelles","description_web":"Un lieu atypique et chaleureux dans le quartier de Tour & Taxis \u00e0 Bruxelles pour assister \u00e0 des concerts, des expositions, des projections ou des conf\u00e9rences, ou pour y organiser vos \u00e9v\u00e8nements priv\u00e9s.\r\nUn projet d\u00e9di\u00e9 au \u00ab beau \u00bb sous toutes ses coutures, dont les maitres-mots sont qualit\u00e9, \u00e9changes et rencontres.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Le Baixu","address_street_name":"Picardstraat","address_street_number":"3","address_street_box":null,"email":"info@lebaixu.be","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Picardstraat, 3","address_line2":"1000 Brussel","description_web":"De naam \"Baixu\" betekent \"mooi\" in de taal van de Pataxos indianen die in de zuidelijke staat Bahia (Brazili\u00eb) wonen. Dit woord staat voor de ambitie van het project en de kwaliteit van de culturele evenementen, maar ook voor de verbondenheid van de initiatiefnemers met de Braziliaanse cultuur. \r\nLe Baixu is ondergebracht in een voormalig industrieel gebouw in het hart van de trendy Brusselse Tour & Taxis wijk. Een atypische en warme plek bedoeld voor concerten, tentoonstellingen, filmvertoningen en conferenties en waar je ook priv\u00e9 evenementen kan organiseren. Het is een volledig uitgeruste, multidisciplinaire culturele ruimte met een oppervlakte van 150 m2, gewijd aan de \"schoonheid\" in al haar vormen. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"info@lebaixu.be","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue Picard, 3","address_line2":"1000 Brussels","description_web":"The name \u201cBaixu\u201d means \u201cbeautiful\u201d in the native language of the Patax\u00f3 peoples, indigenous to the south of the state of Bahia in Brazil. This word represents both the ambition of the project and the quality of the cultural events presented, as well as the founders\u2019 attachment to Brazilian culture. Baisu is a quaint and welcoming space in the Tour & Taxis neighborhood in Brussels, which hosts concerts, expositions, screenings, or conferences \u2013 or where you can organise your private event.\r\nA project dedicated to \u201cbeauty\u201d in all its forms, where the keywords are quality, exchange and interaction.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"info@lebaixu.be","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard, 3","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"info@lebaixu.be","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard, 3","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"info@lebaixu.be","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard, 3","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Le Baixu","address_street_name":"Rue Picard","address_street_number":"3","address_street_box":null,"email":"info@lebaixu.be","website":"https:\/\/www.lebaixu.be","phone_contact":"+32 475 36 18 36","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","addres