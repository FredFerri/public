,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":57,"translations":{"fr":"Clubbing","nl":"Clubbing","en":"Clubbing","de":"Clubbing"}},"others":{}},"languages":{"spoken":["fr","en","nl"],"subtitles":[]},"translations":{"fr":{"name":"Halloween Boat Party","shortdescr":"Venez monter \u00e0 bord de notre \"Black Pearl\" lundi, le 31 octobre 2022, pour une soir\u00e9e d'enfer!","longdescr":"Venez monter \u00e0 bord de notre \"Black Pearl\" lundi, le 31 octobre 2022, pour une soir\u00e9e d'enfer!\r\nKIR ROYAL offert pour les gens look\u00e9s Halloween\r\nAu programme:\r\n\u00c0 19h\r\n* Dance Master class \r\n* Grimage\r\n\u00c0 partir de 21h\r\n* Zakouski et cocktails sanglants !  (uniquement cash)\r\n* D\u00e9co et ambiance 100% Halloween\r\n* DJ aux platines and Sax\r\n* Performance de danseurs professionnels\r\n* Photographe professionnel\r\n* Terrasse ext\u00e9rieur \/ espace fumeu","performers":"Katarina Dariy (DJ), Tatiana Taratayko (sax), Elena Oro Burlakova (danse orientale), Rene Lomanga (danse)","boxoffice_url":null,"website":"https:\/\/fb.me\/e\/20xLoSXvo","email":"info@vzwdebron.com","phone_contact":"+32 474 07 95 35","phone_booking":"+32 474 07 95 35","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.544665"},"nl":{"name":"Halloween Boat Party","shortdescr":"Als je een open geest hebt en van de gekke sfeer houdt, kom dan naar het Halloweenfeest op de boot. #halloween #feestje #brussel","longdescr":"als je een open geest hebt en van de gekke sfeer houdt, kom dan naar het Halloweenfeest op de boot. #halloween #feestje #brussel\r\n\u2620RDV maandag 31 oktober 2022 aan boord van onze \"Black Pearl\". Laten we op reis gaan naar het hiernamaals.\r\nOp het programma: Dansles om 19.00 uur\r\nVanaf 21.00 uur - opening van het bal met een duivelse DJ, sax, showprogramma van professionele dansers, cocktails en bloederige Zakouskis.\r\nEn vele andere macabere verrassingen\r\nHalloween look = Kir Royal aangeboden.","performers":null,"boxoffice_url":null,"website":null,"email":"info@vzwdebron.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.544665"},"en":{"name":"Halloween Boat Party","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"info@vzwdebron.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.544665"},"de":{"name":"Halloween Boat Party","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.544665"},"it":{"name":"Halloween Boat Party","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.544665"},"sp":{"name":"Halloween Boat Party","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.544665"},"pt":{"name":"Halloween Boat Party","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.544665"},"cn":{"name":"Halloween Boat Party","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.544665"}},"place":{"id":274667,"translations":{"fr":{"name":"The Loftboat","address_street_name":"Quai des P\u00e9niches","addr