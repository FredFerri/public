5-17T01:06:36+02:00","published_at":"2022-03-15T11:48:07+01:00","backoffice_id":249660,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.20053619559536},{"id":516129,"date_start":"2021-09-01","date_end":"2022-06-29","date_next":"2022-05-18","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":true,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":74,"translations":{"fr":"Sport","nl":"Sport","en":"Sport"}},"others":{"list":[159,164],"translations":{"fr":["Activit\u00e9 sportive","Fitness, gymnastique, danse et sports de combats"],"nl":["Sportieve activiteit","Fitness, gymnastiek, dans en vechtsport"],"en":["Sporting activity","Fitness, gymnastics, dance and combat sports"]}}},"languages":{"spoken":["fr","en","it"],"subtitles":[]},"translations":{"fr":{"name":"Cours de self-d\u00e9fense pour ados et adultes","shortdescr":"L'asbl Red Force propose \u00e0 Bruxelles des cours de self-d\u00e9fense pour ados et adultes.\r\n\r\nPendant les cours les participants vont apprendre \u00e0 se d\u00e9fendre contre diff\u00e9rentes formes d'agressions: attaques des jambes, \u00e9tranglements, frappes directes ou circulaires, attaques \u00e0 l'arme blanche, etc.","longdescr":"La self-d\u00e9fense n'est pas un art martial en soi, mais le r\u00e9sultat de combinations des differentes techniques de d\u00e9fense et d'attaque provenant principalement de ju jitsu et d'autres arts martiaux dont le but principal est l'auto-d\u00e9fense. Dans cette logique, la self-d\u00e9fense n'ob\u00e9it \u00e0 aucune r\u00e9gle sportive ou comp\u00e9titionnelle.\r\n\r\nLes objectifs de ces cours :\r\n- Aider l\u2019individu \u00e0 prendre confiance en lui\r\n- Sensibilisation aux diff\u00e9rents risques encourus face \u00e0 une arme\r\n- Savoir se d\u00e9fendre face \u00e0 une agression ou une situation d\u00e9sagr\u00e9able\r\n- Prise de conscience de l\u2019int\u00e9r\u00eat de la self-d\u00e9fense dans la vie de tous les jours\r\n- Prendre conscience des possibilit\u00e9s de la self-d\u00e9fense tout en restant dans le cadre l\u00e9gal\r\n- Etre en mesure de s\u2019adapter techniquement face \u00e0 un individu plus imposant que soi-m\u00eame\r\n- Obtenir des r\u00e9flexes par des gestes simples et proportionn\u00e9s \u00e0 tous types d\u2019agressions physiques\r\n- Donner la possibilit\u00e9 \u00e0 chacun de pouvoir analyser une situation pouvant nuire \u00e0 son int\u00e9grit\u00e9 physique","performers":null,"boxoffice_url":null,"website":"https:\/\/www.redforce.be","email":"contact@redforce.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/516129.html"},"nl":{"name":"Cours de self-d\u00e9fense pour ados et adultes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/516129.html"},"en":{"name":"Cours de self-d\u00e9fense pour ados et adultes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/516129.html"},"de":{"name":"Cours de self-d\u00e9fense pour ados et adultes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/516129.html"},"it":{"name":"Cours de self-d\u00e9fense pour ados et adultes","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/516129.html"},"sp":{"name":"Cours de self-d\u00e9fense pour ados e