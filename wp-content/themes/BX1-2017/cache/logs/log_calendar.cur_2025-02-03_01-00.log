n 1983, le th\u00e9\u00e2tre s'est dot\u00e9 d'un lieu pour son Mus\u00e9e International de la Marionnette (fond\u00e9 en 1938 et accessible au public jusqu'en 1968), qui poss\u00e8de une collection des plus vari\u00e9es et des plus riches parmi les Mus\u00e9es europ\u00e9ens de la Marionnette. Les spectacles s'adressent aux enfants \u00e0 partir de 3 ans et vous pouvez visiter le mus\u00e9e pendant l'entracte des spectacles.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Th\u00e9\u00e2tre Royal du Peruchet","address_street_name":"Avenue de la For\u00eat","address_street_number":"50","address_street_box":null,"email":"info@theatreperuchet.be","website":"http:\/\/www.theatreperuchet.be","phone_contact":"+32 2 673 87 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue de la For\u00eat, 50","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Th\u00e9\u00e2tre Royal du Peruchet","address_street_name":"Woudlaan","address_street_number":"50","address_street_box":null,"email":"info@theatreperuchet.be","website":"http:\/\/www.theatreperuchet.be","phone_contact":"+32 2 673 87 30","phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"Woudlaan, 50","address_line2":"1050 Elsene","description_web":"Het marionettentheater werd in 1929 opgericht in Brussel door Carlo Speder. Le P\u00e9ruchet speelt een uniek repertoire van traditionele sprookjes (Andersen, de gebroeders Grimm, Charles Perrault, Daudet, Lafontaine, Kipling, Hoffman...) voor kinderen... en voor hen die hun kinderhart hebben weten te bewaren. Het theater is sinds 1968 gevestigd in de gemeente Elsene, in een 19e-eeuwse boerderij waar volgens de legende Charles Decoster heeft gewoond (de schrijver van Tijl Ulenspiegel!). In 1983 vond het theater P\u00e9ruchet de middelen om zijn internationaal poppenmuseum in te richten, een van de rijkste en meest gevarieerde collecties in Europa. Je kan het museum bezoeken tijdens de pauzes van de voorstellingen. De voorstellingen zijn geschikt voor kinderen vanaf 3 jaar. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[21],"translations":{"de":["S\u00fcden"],"pt":[null],"en":["South"],"it":["Sud"],"cn":[null],"fr":["Sud"],"sp":["Sur"],"nl":["Zuid"]}},"neca":null,"facebook_id":null,"backoffice_id":3952,"location":{"lat":50.80189257,"lon":4.39256459},"region":"brussels","last_updated_at":"2022-10-10T10:25:09+02:00","published_at":"2013-10-19T01:16:49+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":241472,"translations":{"de":{"name":"Th\u00e9\u00e2tre Royal du Peruchet","address_street_name":"Avenue de la For\u00eat","address_street_number":"50","address_street_box":null,"email":"info@theatreperuchet.be","website":"http:\/\/www.theatreperuchet.be","phone_contact":"+32 2 673 87 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue de la For\u00eat, 50","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Th\u00e9\u00e2tre Royal du Peruchet","address_street_name":"Avenue de la For\u00eat","address_street_number":"50","address_street_box":null,"email":"info@theatreperuchet.be","website":"http:\/\/www.theatreperuchet.be","phone_contact":"+32 2 673 87 30","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue de la For\u00eat, 50","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Th\u00e9\u00e2tr