hool_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen","it":"Visite guidate","sp":"Visitas guiadas","pt":null,"cn":null}},"others":{}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Fashion walk : Diane von Furstenberg. Woman Before Fashion","shortdescr":null,"longdescr":"Linda Van Waesberge vous emm\u00e8ne \u00e0 la d\u00e9couverte des boutiques tendance du haut de la ville. D\u00e9couvrez la mode belge en passant notamment par la boutique bruxelloise de Diane Von Furstenberg. Un essayage de l\u2019embl\u00e9matique robe portefeuille vous est propos\u00e9.\r\n\r\nTarif : 10 \u20ac (max. 15 personnes)\r\nA 10h, arr\u00eat Tram petit Sablon (92-93) devant l\u2019Eglise Notre-Dame Des Victoires au Sabon\r\nLa r\u00e9servation est obligatoire via notre site web","performers":"Linda Van Waesberge vous emm\u00e8ne \u00e0 la d\u00e9couverte des boutiques tendance du haut de la ville.","boxoffice_url":null,"website":"http:\/\/www.museemodeetdentelle.brussels","email":"musea@brucity.be","phone_contact":null,"phone_booking":"+32 2 279 43 67","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.555528"},"nl":{"name":"Fashion walk : Diane von Furstenberg. Woman Before Fashion","shortdescr":null,"longdescr":"Linda Van Waesberge neemt u mee naar de trendy boetieks in de stad. Volg het spoor van de Belgische mode en bezoek de Brusselse boetiek van Diane von Furstenberg. De bekende wikkeljurk kan er worden gepast.\r\n\r\nTarief: 10 \u20ac (max. 15 personen)\r\nVertrek om 10u aan tramhalte: Kleine Zavel (92,93) voor de Onze-Lieve-Vrouw-ter-Zavelkerke\r\nVerplicht reserveren via onze website","performers":"Linda Van Waesberge neemt u mee naar de trendy boetieks in de stad.","boxoffice_url