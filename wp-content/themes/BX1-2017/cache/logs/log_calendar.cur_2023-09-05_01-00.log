 30 30","phone_booking":"+32 2 505 30 30","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50001293"},"it":{"name":"Lysistrata","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatreduparc.be\/","email":"Billetterie@theatreduparc.be","phone_contact":"+32 2 505 30 30","phone_booking":"+32 2 505 30 30","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50001293"},"cn":{"name":"Lysistrata","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatreduparc.be\/","email":"Billetterie@theatreduparc.be","phone_contact":"+32 2 505 30 30","phone_booking":"+32 2 505 30 30","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50001293"},"fr":{"name":"Lysistrata","shortdescr":"Librement inspir\u00e9 d\u2019ARISTOPHANE\n\nIl y a 2400 ans, des femmes ath\u00e9niennes d\u00e9cident de faire la gr\u00e8ve du sexe tant que leurs maris feront la guerre.","longdescr":"La pi\u00e8ce que nous vous proposons pour d\u00e9marrer la saison 23-24 est tr\u00e8s librement inspir\u00e9e d\u2019une com\u00e9die d\u2019Aristophane, \u00e9crite il y a plus de 2400 ans.\n\nLe pitch est tr\u00e8s moderne : les ath\u00e9niennes en ont assez de voir leurs maris se battre contre la cit\u00e9 de Sparte depuis 20 ans. Elles s\u2019allient aux femmes spartiates et menacent leurs hommes d\u2019une gr\u00e8ve du sexe si le conflit ne s\u2019arr\u00eate pas imm\u00e9diatement. Mais leurs revendications ne s\u2019arr\u00eatent pas l\u00e0\u2026\n\nLa pi\u00e8ce nous plonge dans la Gr\u00e8ce antique d\u2019il y a plus de deux mill\u00e9naires, tout en nous offrant un propos tr\u00e8s actuel qui nous touche au plus profond de notre \u00eatre.\n\nUn spectacle haut en couleur accessible \u00e0 partir de 12 ans !","performers":"Avec B\u00e9atrix Ferauge, Margaux Frichet, Oc\u00e9a Gonel, Charlotte De Halleux, No\u00e9mie Maton, Tiphanie Lefran\u00e7ois, Alex Lobo, Guy Pion, Emma Seine, Anouchka Vingtier.\n\nMise en sc\u00e8ne Thierry Debroux \n\n","boxoffice_url":null,"website":"https:\/\/www.theatreduparc.be\/","email":"Billetterie@theatreduparc.be","phone_contact":"+32 2 505 30 30","phone_booking":"+32 2 505 30 30","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50001293"},"sp":{"name":"Lysistrata","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatreduparc.be\/","email":"Billetterie@theatreduparc.be","phone_contact":"+32 2 505 30 30","phone_booking":"+32 2 505 30 30","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50001293"},"nl":{"name":"Lysistrata","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.theatreduparc.be\/","email":"Billetterie@theatreduparc.be","phone_contact":"+32 2 505 30 30","phone_booking":"+32 2 505 30 30","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50001293"}},"place":{"id":331,"translations":{"de":{"name":"Th\u00e9\u00e2tre Royal du Parc","address_street_name":"Rue de la Loi","address_street_number":"3","address_street_box":null,"email":"info@theatreduparc.be","website":"http:\/\/www.theatreduparc.be","phone_contact":null,"phone_booking":"+32 2 505 30 30","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Loi, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Th\u00e9\u00e2tre Royal du Parc","address_street_name":"Rue de la Loi","address_street_number":"3","address_street_box":null,"email":"info@theatreduparc.be","website":"http:\/\/www.theatreduparc.be","phone_contact":null,"phone_booking":"+32 2 505 30 30","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Loi, 3","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"bo