light"],"nl":["Highlight"]}},"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":["major_event","exterior"]},{"id":5700000393,"date_start":"2024-08-31","date_end":"2024-08-31","date_next":"2024-08-31","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-08-23T16:37:07+02:00","published_at":"2024-08-23T16:22:19+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":true,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":306306,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"misc","ranking":1,"languages":{"spoken":["en","fr"],"subtitles":[]},"categories":{"main":{"id":84,"translations":{"de":"Verschiedenes","pt":null,"en":"Various","it":"Varie","cn":null,"fr":"Divers","sp":"Varios","nl":"Varia"}},"others":{}},"translations":{"de":{"name":"Immersive brunch \u03df A beauty that drives us mad \u03df","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.eventbrite.be\/e\/daylab-a-beauty-that-drives-us-mad-tickets-983705498627?utm-campaign=social&utm-content=attendeeshare&utm-medium=discovery&utm-term=listing&utm-source=cp&aff=ebdsshcopyurl","email":"ioana@vanna.digital","phone_contact":"+32 487 18 36 40","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700000393"},"pt":{"name":"Immersive brunch \u03df A beauty that drives us mad \u03df","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.eventbrite.be\/e\/daylab-a-beauty-that-drives-us-mad-tickets-983705498627?utm-campaign=social&utm-content=attendeeshare&utm-medium=discovery&utm-term=listing&utm-source=cp&aff=ebdsshcopyurl","email":"ioana@vanna.digital","phone_contact":"+32 487 18 36 40","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700000393"},"en":{"name":"Immersive brunch \u03df A beauty that drives us mad \u03df","shortdescr":"This Daylab brunch brings to life movie moments, while creating the best place for you to share conversations and meet other creatives.","longdescr":"What to expect?\nA decadent brunch imagined by SoCity, our guest chef for the night. You have the possibility to opt for natural sparkling wine that our team carefully picked, or a funky non-alcoholic alternative.\n\nDate: August 31\nTime: 11:00\nLocation: Chateau de Jolimont, 70 rue de middelbourg 1170\n\nEach event is designed by a nomad team with the wish to inspire the creative community, encouraging participants to consider new perspectives in their practice.\n\n\n\nThird edition: A beauty that drives us mad\nCinema, as an art form, has always inspired innovators and creators with its characters and narratives. One example is the mobile phone.\n\nFilms evoke emotions, challenge social norms, and transport us with decadent aesthetics. For this edition, we\u2019re are bringing to life table settings you see in movies.\n\nUsing the film Saltburn as starting point, we aim to bring together creatives to reimagine the use of spaces around us. By drawing on the eccentric, we aspire to create an inclusive experience where each guest can express their most extra self.\n","performers":null,"boxoffice_url":null,"website":"https:\/\/www.eventbrite.be\/e\/daylab-a-beauty-that-drives-us-mad-tickets-983705498627?utm-campaign=social&utm-content=attendeeshare&utm-medium=discovery&utm-term=listing&utm-source=cp&aff=ebdsshcopyurl","email":"ioana@vanna.digital","phone_contact":"+32 487 18 36 40","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700000393"},"it":{"name":"Immersive brunch \u03df A beauty that drives us mad \u03df","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.eventbrite.be\/e\/daylab-a-beauty-that-drives-us-mad-tickets-983705498627?utm-campaign=social&utm-content=attendeeshare&utm-medium=discovery&utm-term=listing&utm-source=cp&aff=ebdsshcopyurl","email":"ioana@vanna.digital","phone_contact":"+32 487 18 36 40","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700000393"},"cn":{"name":"Immersive brunch \u03df A beauty that drives us mad \u03df","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.eventbrite.be\/e\/daylab-a-beauty-that-drives-us-mad-tickets-983705498627?utm-campaign=social&utm-content=attendeeshare&utm-medium=discovery&utm-term=listing&utm-source=cp&aff=ebdsshcopyurl","email":"ioana@vanna.digital","phone_contact":"+32 487 18 36 40","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700000393"},"fr":{"name":"Brunch immersif \u03df A beauty that drives us mad \u03df","shortdescr":"Ce brunch Daylab donne vie \u00e0 des moments de cin\u00e9ma, tout en cr\u00e9ant le meilleur cadre pour partager des conversations et rencontrer d'autres cr\u00e9atifs et cr\u00e9atives \u00e0 Bruxelles","longdescr":"\u00c0 quoi s'attendre ?\nUn brunch d\u00e9cadent imagin\u00e9 par SoCity, nos chefs invit\u00e9s. Vous avez la possibilit\u00e9 d'opter pour un vin p\u00e9tillant naturel que notre \u00e9quipe a soigneusement s\u00e9lectionn\u00e9, ou pour une alternative funky sans alcool.\n\nDate du brunch : 31 ao\u00fbt\nHeure : 11:00\nLieu : Ch\u00e2teau de Jolimont Ch\u00e2teau de Jolimont, 70 rue de middelbourg 1170\n\nChaque \u00e9v\u00e9nement est con\u00e7u par une \u00e9quipe nomade avec le souhait d'inspirer la communaut\u00e9 cr\u00e9ative, en encourageant les participants \u00e0 envisager de nouvelles perspectives dans leur pratique.\n\n\nTroisi\u00e8me \u00e9dition : A beauty that drives us mad\nLe cin\u00e9ma, en tant que forme d'art, a toujours inspir\u00e9 les innovateurs et les cr\u00e9ateurices avec ses personnages et ses r\u00e9cits. Le t\u00e9l\u00e9phone portable en est un exemple.\n\nLes films \u00e9voquent des \u00e9motions, remettent en question les normes sociales et nous transportent dans une esth\u00e9tique d\u00e9cadente. Pour cette \u00e9dition, nous donnons vie aux d\u00e9cors de table que l'on voit dans les films.\n\nEn utilisant le film Saltburn comme point de d\u00e9part, nous souhaitons rassembler des cr\u00e9atifs et cr\u00e9atives pour r\u00e9imaginer l'utilisation des espaces qui nous entourent. En nous inspirant de l'excentricit\u00e9, nous aspirons \u00e0 cr\u00e9er une exp\u00e9rience inclusive o\u00f9 chaque invit\u00e9.e peut exprimer ce qu'iel a de plus extra.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.eventbrite.be\/e\/daylab-a-beauty-that-drives-us-mad-tickets-983705498627?utm-campaign=social&utm-content=attendeeshare&utm-medium=discovery&utm-term=listing&utm-source=cp&aff=ebdsshcopyurl","email":"ioana@vanna.digital","phone_contact":"+32 487 18 36 40","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700000393"},"sp":{"name":"Immersive brunch \u03df A beauty that drives us mad \u03df","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.eventbrite.be\/e\/daylab-a-beauty-that-drives-us-mad-tickets-983705498627?utm-campaign=social&utm-content=attendeeshare&utm-medium=discovery&utm-term=listing&utm-source=cp&aff=ebdsshcopyurl","email":"ioana@vanna.digital","phone_contact":"+32 487 18 36 40","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700000393"},"nl":{"name":"Immersive brunch \u03df A beauty that drives us mad \u03df","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/