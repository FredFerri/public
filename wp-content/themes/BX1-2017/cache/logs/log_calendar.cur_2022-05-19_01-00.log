day":"2022-05-21","doors":"22:00:00","start":"22:00:00","end":null,"is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":10}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"visit_profile":{"list":[324],"translations":{"fr":["Culture urbaine"],"nl":["Stadscultuur"],"en":["Urban culture"]}},"tags":[],"is_part_of":"Party.brussels","accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-05-16T16:05:10+02:00","published_at":"2022-05-16T15:48:45+02:00","backoffice_id":253782,"import_origin":null,"sub_type":"party","show_in_agenda":true,"ranking":0.7937005259841},{"id":530784,"date_start":"2022-05-21","date_end":"2022-09-03","date_next":"2022-05-21","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{"list":[113],"translations":{"fr":["Histoire Industrielle"],"nl":["Industri\u00eble geschiedenis"],"en":["Industrial History"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Comment sauver le patrimoine industriel","shortdescr":"L\u2019industrie a longtemps \u00e9t\u00e9 la principale activit\u00e9 \u00e9conomique de Bruxelles avant de d\u00e9cliner, \u00e0 partir des ann\u00e9es 1970, et de laisser place aux bureaux.","longdescr":"L\u2019industrie a longtemps \u00e9t\u00e9 la principale activit\u00e9 \u00e9conomique de Bruxelles avant de d\u00e9cliner, \u00e0 partir des ann\u00e9es 1970, et de laisser place aux bureaux. Cette \u00e9volution est particuli\u00e8rement tangible dans le quartier maritime qui n\u2019en garde pas moins une identit\u00e9 fortement marqu\u00e9e par l\u2019histoire industrielle, dont les traces se retrouvent tant dans les b\u00e2timents historiques que dans l\u2019organisation de l\u2019espace public. Malgr\u00e9 cette tertiarisation qui a fortement impact\u00e9 l\u2019\u00e9volution d\u2019un site comme celui de Tour et Taxis, les projets urbains plus r\u00e9cents se tournent vers les habitants et les visiteurs, avec les initiatives tels que le projet culturel Kanal ou la restauration de l\u2019ancien d\u00e9p\u00f4t Byrrh. Comment cette identit\u00e9 industrielle est-elle de nouveau mise \u00e0 profit dans les projets urbains ? Comment l\u2019urbanit\u00e9 se reconstruit-elle \u00e0 travers les projets de reconversion, et comment \u00e9viter les d\u00e9rives du marketing territorial ? Les activit\u00e9s industrielles trouvent-elles de nouveau une place dans ces processus de transformation et de production de la ville ?","performers":null,"boxoffice_url":null,"website":"http:\/\/www.arau.org","email":"info@arau.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/530784.html"},"nl":{"name":"Comment sauver le patrimoine industriel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/530784.html"},"en":{"name":"Comment sauver le patrimoine industriel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/530784.html"},"de":{"name":"Comment sauver le patrimoine industriel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/530784.html"},"it":{"name":"Comment sauver le patrimoine industriel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/530784.html"},"sp":{"name":"Comment sauver le patrimoine industriel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/530784.html"},"pt":{"name":"Comment sauver le patrimoine industriel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/530784.html"},"cn":{"name":"Comment sauver le patrimoine industriel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/530784.html"}},"place":{"id":271094,"translations":{"fr":{"name":"Kanal - Centre Pompidou","address_street_name":"Square Sainctelette","address_street_number":null,"address_street_box":null,"email":"info@kanal.brussels","website":"http:\/\/www.kanal.brussels","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Square Sainctelette","address_line2":"1000 Bruxelles","description_web":"Lors de sa re\u0301ouverture pre\u0301vue en 2024, KANAL-Centre Pompidou deviendra la plus vaste institution culturelle bruxelloise, avec plus de 35.000 m2 de\u0301die\u0301s a\u0300 la cre\u0301ation artistique sous toutes ses formes. Visitez actuellement l\u2019exposition de l\u2019artiste suisse John M Armleder et de ses invite\u0301s, sur les six e\u0301tages de l\u2019ancien showroom du garage. Pre\u0301vue jusque fin avril 2021, date de fermeture de KANAL-Centre Pompidou jusqu\u2019a\u0300 sa re\u0301ouverture en 2024,\r\ncette exposition constitue un vaste projet interdisciplinaire, confie\u0301 a\u0300 l\u2019un des artistes majeurs de la sce\u0300ne contemporaine, confirmant la volonte\u0301 d\u2019expe\u0301rimentation et d\u2019ouverture de KANAL-Centre Pompidou.\r\n","description_print":"","booking_url":null,"sort_order":"KANAL - CENTRE POMPIDOU","virtual_visit":null},"nl":{"name":"Kanal - Centre Pompidou","address_street_name":"Sainctelettesquare","address_street_number":null,"address_street_box":null,"email":"info@kanal.brussels","website":"http:\/\/www.kanal.brussels","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Sainctelettesquare","address_line2":"1000 Brussel","description_web":"Wanneer KANAL-Centre Pompidou in 2024 opnieuw opent, wordt het de grootste culturele instelling van Brussel, met meer dan 35.000 m2 gewijd aan artistieke creatie in al haar vormen. Bezoek momenteel de tentoonstelling van de Zwitserse kunstenaar John M Armleder en zijn gasten op de zes verdiepingen van de voormalige showroom van de Citroe\u0308n-garage. Deze tentoonstelling loopt tot eind april 2021, wanneer KANAL-Centrum Pompidou zal sluiten tot de heropening in 2024. Het is een grootschalig interdisciplinair project, toevertrouwd aan een van de belangrijkste kunstenaars van de hedendaagse sce\u0300ne, helemaal in het teken van experiment.","description_print":"","booking_url":null,"sort_order":"KANAL - CENTRE POMPIDOU","virtual_visit":null},"en":{"name":"Kanal - Centre Pompidou","address_street_name":"Square Sainctelette","address_street_number":null,"address_street_box":null,"email":"info@kanal.brussels","website":"http:\/\/www.kanal.brussels","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Square Sainctelette","address_line2":"1000 Brussels","description_web":"When KANAL-Centre Pompidou reopens in 2024, it will become the largest cultural institution in Brussels, with more than 35,000 m2 devoted to artistic creation in all its forms. Visit the exhibition of the Swiss artist John M Armleder and his guests on the six floors of the former showroom of the Citroe\u0308n garage. This exhibition runs until the end of April 2021, when KANAL-Centrum Pompidou will close until its reopening in 2024.\r\nIt is a large-scale interdisciplinary project, entrusted to one of the most important artists on the contemporary scene, entirely devoted to experimentation.\r\n\r\nVisit the exhibition of the Swiss artist John M Armleder and his guests on the six floors of the former showroom of the Citroe\u0308n garage. This exhibition runs until the end of April 2021, when KANAL-Centrum Pompidou will close until its reopening in 2024.\r\nIt is a large-scale interdisciplinary project, entrusted to one of the most important artists on the contemporary scene, entirely devoted to experimentation.\r\n","description_print":"","booking_url":null,"sort_order":"KANAL - CENTRE POMPIDOU","virtual_visit":null},"de":{"name":"Kanal - Centre Pompidou","address_street_name":"Square Sainctelette","address_street_number":null,"address_street_box":null,"email":"info@kanal.brussels","website":"http:\/\/www.kanal.brussels","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Square Sainctelette","address_line2":"1000 Bruxelles","description_web":"Weder auf dem Gebiet der modernen und zeitgen\u00f6ssischen Kunst noch im Bereich der Architektur ist Br\u00fcssel ein unbeschriebenes Blatt. Im Gegenteil, es gibt bereits eine ganze Reihe von Museen und Einrichtungen, die sich mit den verschiedenen k\u00fcnstlerischen Disziplinen besch\u00e4ftigen. \r\nWas jedoch bislang noch fehlte, war ein Museum f\u00fcr moderne und zeitgen\u00f6ssische Kunst und ein Architekturmuseum unter einem Dach (und was f\u00fcr einem Dach!). Und so hat das ambitionierte Projekt KANAL Centre Pompidou seine absolute Daseinsberechtigung am Br\u00fcsseler Kanal, wo es die 35 000 m\u00b2 der ehemaligen Citro\u00ebn-Werkstatt in Beschlag nehmen wird. In der Zeit bis zum Beginn der Umbauarbeiten, deren Ende f\u00fcr 2022\/2023 geplant sind, hat die Fondation Kanal beschlossen, ab dem 5. Mai 2018 eine Art \"Vorlaufjahr\" zu starten. 13 Monate lang kann das Publikum in Zusammenarbeit mit dem Centre Pompidou dieses mythische Geb\u00e4ude entdecken - Ausstellungen, Gro\u00dfinstallationen, zehn Auftragsarbeiten von Br\u00fcsseler K\u00fcnstlern sowie ein Programm mit Live-Darbietungen. ","description_print":"","booking_url":null,"sort_order":"KANAL - CENTRE POMPIDOU","virtual_visit":null},"it":{"name":"Kanal - Centre Pompidou","address_street_name":"Square Sainctelette","address_street_number":null,"address_street_box":null,"email":"info@kanal.brussels","website":"http:\/\/www.kanal.brussels","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Square Sainctelette","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":"KANAL - CENTRE POMPIDOU","virtual_visit":null},"sp":{"name":"Kanal - Centre Pompidou","address_street_name":"Square Sainctelette","address_street_number":null,"address_street_box":null,"email":"info@kanal.brussels","website":"http:\/\/www.kanal.brussels","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Square Sainctelette","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":"KANAL - CENTRE POMPIDOU","virtual_visit":null},"pt":{"name":"Kanal - Centre Pompidou","address_street_name":"Square Sainctelette","address_street_number":null,"address_street_box":null,"email":"info@kanal.brussels","website":"http:\/\/www.kanal.brussels","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Square Sainctelette","address_line2":"1000 Bruxelles","description_web":"","des