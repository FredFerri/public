gitte.Dhossche@hubruxelles.be","phone_contact":"+32 2 555 34 31","phone_booking":"+32 2 555 34 31","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700002161"},"cn":{"name":"Halloween Party!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.museemedecine.be","email":"Brigitte.Dhossche@hubruxelles.be","phone_contact":"+32 2 555 34 31","phone_booking":"+32 2 555 34 31","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700002161"},"fr":{"name":"Halloween Party !","shortdescr":"Le Mus\u00e9e de la M\u00e9decine vous propose son Halloween Party pour les enfants de 6 \u00e0 12 ans. Un jeu de piste effrayant vous permettra d\u2019aider les \u00e2mes qui  hantent le mus\u00e9e \u00e0 retrouver la paix. ","longdescr":"Le Mus\u00e9e de la M\u00e9decine vous propose son Halloween Party pour les enfants de 6 \u00e0 12 ans (accompagn\u00e9s d\u2019un adulte). Le docteur Schnabel, m\u00e9decin de la peste, vous ouvrira les portes pour p\u00e9n\u00e9trer dans le Mus\u00e9e et vous proposera un jeu de piste effrayant afin de vous permettre d\u2019aider les \u00e2mes qui le hantent \u00e0 retrouver la paix. Au terme des \u00e9preuves, les petits monstres repartiront avec leur friandises bien m\u00e9rit\u00e9es.\n\nUne participation de 1\u20ac par enfant sera demand\u00e9e. Entr\u00e9e gratuite pour les adultes.\nQuand : le 31 octobre 2024 \u00e0 partir de 17h00.\nVenez tous d\u00e9guis\u00e9s !\nR\u00e9servation obligatoire uniquement par t\u00e9l\u00e9phone au 02\/555.34.31 au plus tard le 25\/10\/2024.\n\n","performers":"\n","boxoffice_url":null,"website":"http:\/\/www.museemedecine.be","email":"Brigitte.Dhossche@hubruxelles.be","phone_contact":"+32 2 555 34 31","phone_booking":"+32 2 555 34 31","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700002161"},"sp":{"name":"Halloween Party!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.museemedecine.be","email":"Brigitte.Dhossche@hubruxelles.be","phone_contact":"+32 2 555 34 31","phone_booking":"+32 2 555 34 31","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700002161"},"nl":{"name":"Halloween Party!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.museemedecine.be","email":"Brigitte.Dhossche@hubruxelles.be","phone_contact":"+32 2 555 34 31","phone_booking":"+32 2 555 34 31","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700002161"}},"place":{"id":230242,"translations":{"de":{"name":"Mus\u00e9e de la M\u00e9decine (ULB)","address_street_name":"Route de Lennik","address_street_number":"808","address_street_box":null,"email":"museemed@ulb.ac.be","website":"http:\/\/www.museemedecine.be\/","phone_contact":"+32 2 555 34 31","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Route de Lennik, 808","address_line2":"1070 Anderlecht","description_web":"Das Medizinmusem richtet sich an alle medizinisch interessierten Besucher. Theamtisch abgedeckt wird nicht nur die Medizin, sondern auch die medizinische Denkweise in Kunst, Geschichte und Literatur - von der Antike bis zur Gegenwart.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Mus\u00e9e de la M\u00e9decine (ULB)","address_street_name":"Route de Lennik","address_street_number":"808","address_street_box":null,"email":"museemed@ulb.ac.be","website":"http:\/\/www.museemedecine.be\/","phone_contact":"+32 2 555 34 31","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Route de Lennik, 808","address_line2":"1070 Anderlecht","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Mus\u00e9e de la M\u00e9decine (ULB)","address_street_name":"Route de Lennik","address_street_number":"808","address_street_box":null,"email":"museemed@ulb.ac.be","website":"http:\/\/www.museemedecine.be\/","phone_contact":"+32 2 555 34 31","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Route de Lennik, 808","address_line2":"1070 Anderlecht","description_web":"The Museum of Medicine is intended for all enthusiasts, experts or simply anyone interested in medicine and medical thinking featured in art, history and literature, from antiquity to the present day.\r\nIts proximity to Erasmus Hospital allows the museum to reconstruct its items in fascinating X-rays, revealing the secrets of their composition, such as the museum\u2019s latest masterpiece, Dr Auzoux\u2019s \"Ecorch\u00e9\"","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Mus\u00e9e de la M\u00e9decine (ULB)","address_street_name":"Route de Lennik","address_street_number":"808","address_street_box":null,"email":"museemed@ulb.ac.be","website":"http:\/\/www.museemedecine.be\/","phone_contact":"+32 2 555 34 31","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Route de Lennik, 808","address_line2":"1070 Anderlecht","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Mus\u00e9e de la M\u00e9decine (ULB)","address_street_name":"Route de Lennik","address_street_number":"808","address_street_box":null,"email":"museemed@ulb.ac.be","website":"http:\/\/www.museemedecine.be\/","phone_contact":"+32 2 555 34 31","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Route de Lennik, 808","address_line2":"1070 Anderlecht","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Mus\u00e9e de la M\u00e9decine (ULB)","address_street_name":"Route de Lennik","address_street_number":"808","address_street_box":null,"email":"museemed@ulb.ac.be","website":"http:\/\/www.museemedecine.be\/","phone_contact":"+32 2 555 34 31","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Route de Lennik, 808","address_line2":"1070 Anderlecht","description_web":"Le Mus\u00e9e de la M\u00e9decine s\u2019adresse \u00e0 tous les passionn\u00e9s, experts ou simples curieux de la m\u00e9decine et de la pens\u00e9e m\u00e9dicale dans l\u2019art, l\u2019histoire et la litt\u00e9rature, de l\u2019Antiquit\u00e9 \u00e0 nos jours.\r\nLa proximit\u00e9 avec l\u2019h\u00f4pital Erasme permet au Mus\u00e9e de restituer ses objets en radiographies fascinantes, r\u00e9v\u00e9lant les secrets de leur composition, comme \u00ab l\u2019Ecorch\u00e9 \u00bb du Dr Auzoux, le nouveau chef-d\u2019\u0153uvre du mus\u00e9e!","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Museo de Medicina (ULB)","address_street_name":"Route de Lennik","address_street_number":"808","address_street_box":null,"email":"museemed@ulb.ac.be","website":"http:\/\/www.museemedecine.be\/","phone_contact":"+32 2 555 34 31","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Route de Lennik, 808","address_line2":"1070 Anderlecht","description_web":"El Museo de Medicina est\u00e1 destinado para todos los entusiastas, expertos o simplemente interesados en la medicina y el pensamiento m\u00e9dico representado en el arte, la historia y la literatura, desde la antig\u00fcedad hasta la actualidad.\r\nSu cercan\u00eda con el Hospital Erasmus permite al museo reconstruir sus art\u00edculos en fascinantes rayos X, revelando los secretos de su composici\u00f3n, por ejemplo, la \u00faltima obra maestra del museo, \"Ecorch\u00e9\" de Dr Auzoux.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Geneeskundemuseum (ULB)","address_street_name":"Lennikse Baan","address_street_number":"808","address_street_box":null,"email":"museemed@ulb.ac.be","website":"http:\/\/www.museemedecine.be\/","phone_contact":"+32 2 555 34 31","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Lennikse Baan, 808","address_line2":"1070 Anderlecht","description_web":"Het Geneeskundemuseum is niet alleen een must voor experten, maar voor iedereen die geboeid is door of nieuwsgierig is naar geneeskunde. Het museum biedt een overzicht van de Oudheid tot vandaag en ook de invloed van geneeskunde op de kunsten, geschiedenis en literatuur komt aan bod. Dankzij de nabijheid van het Erasmusziekenhuis kon het museum ro\u0308ntgenfoto\u2019s maken van enkele van zijn voorwerpen, wat unieke beelden geeft van hun samenstelling. Een mooi voorbeeld hiervan is het anatomisch spiermodel van Dr Auzoux, het nieuwe topstuk van het museum!","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[21],"translations":{"de":["S\u00fcden"],"pt":[null],"en":["South"],"it":["Sud"],"cn":[null],"fr":["Sud"],"sp":["Sur"],"nl":["Zuid"]}},"neca":null,"facebook_id":null,"backoffice_id":842,"location":{"lat":50.81365646,"lon":4.26640357},"region":"brussels","last_updated_at":"2024-10-04T15:01:42+02:00","published_at":"2013-10-19T01:13:50+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":230242,"translations":{"de":{"name":"Mus\u00e9e de la M\u00e9decine (ULB)","address_street_name":"Route de Lennik","address_street_number":"808","address_street_box":null,"email":"museemed@ulb.ac.be","website":"http:\/\/www.museemedecine.be\/","phone_contact":"+32 2 555 34 31","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Route de Lennik, 808","address_line2":"1070 Anderlecht","description_web":"D