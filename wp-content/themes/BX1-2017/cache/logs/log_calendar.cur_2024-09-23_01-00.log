t_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-09-05T12:52:08+02:00","published_at":"2024-09-05T12:47:42+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":307235,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"tour","ranking":0.7937005259840998,"languages":{"spoken":["nl","en","fr"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{}},"translations":{"de":{"name":"Guided Tour of the Duden Castle - BBN 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/fr\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700000979"},"pt":{"name":"Guided Tour of the Duden Castle - BBN 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/fr\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700000979"},"en":{"name":"Guided Tour of the Duden Castle - BBN 2024","shortdescr":null,"longdescr":"This building was conceived as a country house by the architect Eduard Schwartz for Wilhelm Friedrich Karl Ludwig Duden, a German industrialist who had made his fortune in the lace business. It stands on the top of a hill in the middle of the Duden Park with its main fa\u00e7ade facing Avenue Victor Rousseau. Built between 1873 and 1875, the Neoclassical design seems to have been influenced by Villa H\u00fcgel in Essen in Germany, which belonged to the Krupp family of industrialists. Inside, a large entrance hall with elaborate columns leads to a monumental marble staircase. Since 2012, the building has housed the Dutch-language film school NARAFI, which is now part of the LUCA School of Arts. Despite its transformation, many original details remain, including stuccoed ceilings, wood panelling, marble fireplaces topped by panels and mirrors, and herringbone parquet floors.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/en\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700000979"},"it":{"name":"Guided Tour of the Duden Castle - BBN 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/fr\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700000979"},"cn":{"name":"Guided Tour of the Duden Castle - BBN 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/fr\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700000979"},"fr":{"name":"Visite Guid\u00e9e du Ch\u00e2teau Duden - BBN 2024","shortdescr":null,"longdescr":"R\u00e9sidence de campagne, con\u00e7ue par l'architecte Eduard Schwartz pour Wilhelm Friedrich Karl Ludwig Duden (un industriel allemand qui fit fortune dans la dentelle), cette b\u00e2tisse se dresse au sommet d'une colline, au centre du parc Duden et d\u00e9voile sa fa\u00e7ade principale vers l'avenue Victor Rousseau. \u00c9rig\u00e9 entre 1873-1875 dans un style n\u00e9oclassique, sa conception semble avoir \u00e9t\u00e9 influenc\u00e9e par la Villa H\u00fcgel \u00e0 Essen en Allemagne, propri\u00e9t\u00e9 de la famille Krupp ; \u00e0 l'int\u00e9rieur, un grand hall d'entr\u00e9e \u00e0 colonnes coiff\u00e9es de chapiteaux ouvrag\u00e9s m\u00e8ne \u00e0 un monumental escalier de marbre. Depuis 2012, le ch\u00e2teau est occup\u00e9 par l'\u00e9cole de film n\u00e9erlandophone NARAFI, qui fait d\u00e9sormais partie de la Luca School of Arts. Malgr\u00e9 sa transformation, bon nombre de d\u00e9tails originaux restent toujours visibles : plafonds stuqu\u00e9s, lambris de bois, chemin\u00e9es en marbre surmont\u00e9s de panneaux form\u00e9s et de miroirs, parquets \u00e0 b\u00e2tons rompus,...","performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/fr\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700000979"},"sp":{"name":"Guided Tour of the Duden Castle - BBN 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/fr\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700000979"},"nl":{"name":"Rondleiding van het Dudenkasteel - BBN 2024","shortdescr":null,"longdescr":"Dit buitenverblijf werd ontworpen door de architect Eduard Schwartz voor Wilhelm Friedrich Karl Ludwig Duden, een Duits ondernemer die fortuin maakte in de kantindustrie. Het ligt op de top van een heuvel in het midden van het Dudenpark, met de voorgevel gericht naar de Victor Rousseaulaan. Het kasteel in neoklassieke stijl werd gebouwd tussen 1873 en 1875 en zou ge\u00efnspireerd zijn op de Villa H\u00fcgel in Essen in Duitsland, eigendom van de industri\u00eble familie Krupp. Binnen is er een grote inkomhal met rijkelijk versierde zuilen en een indrukwekkende marmeren trap die naar de bovenverdiepingen leidt. Sinds 2012 wordt het kasteel gebruikt door de Nederlandstalige filmschool NARAFI, die tegenwoordig deel uitmaakt van de LUCA School of Arts. Ondanks de transformaties die het gebouw onderging, zijn vele originele decoraties nog duidelijk aanwezig, met onder meer plafonds met stucwerk, houten lambriseringen, marmeren schoorsteenmantels en visgraatparket.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/nl\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700000979"}},"place":{"id":50002342,"translations":{"de":{"name":"Ch\u00e2teau Duden","address_street_name":"Avenue Gabriel Faur\u00e9","address_street_number":"2","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Gabriel Faur\u00e9, 2","address_line2":"1190 Forest","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Ch\u00e2teau Duden","address_street_name":"Avenue Gabriel Faur\u00e9","address_street_number":"2","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Gabriel Faur\u00e9, 2","address_line2":"1190 Forest","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Duden Castle","address_street_name":"Gabriel Faur\u00e9laan","address_street_number":"2","address_street_box":null,"email":null,"website":null,"phone_cont