yantes","Am\u00e9nagements pour personnes sourdes et malentendantes","Chien d'assistance","Parking accessible","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9","Brussels Health Safety Label"],"nl":["Toegankelijk voor mensen met een verstandelijke beperking","Toegankelijk","Voorzieningen voor blinde en slechtziende personen","Voorzieningen voor dove en slechthorende personen","Assistentiehonden","Toegankelijke parking","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet","Brussels Health Safety Label"],"en":["Accessible to people with intellectual disabilities","Accessible","Facilities for blind and partially-sighted persons","Facilities for deaf and hearing-impaired people","Assistance dogs","Accessible parking","Accessible to pedestrians with mobility aids","Adapted toilet","Brussels Health Safety Label"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-06-10T01:35:25+02:00","published_at":"2022-05-17T17:08:16+02:00","backoffice_id":253908,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.35421952306087},{"id":532152,"date_start":"2022-05-19","date_end":"2022-07-16","date_next":"2022-06-10","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[24,28],"translations":{"fr":["Galeries d'art","Arts graphiques"],"nl":["Galeries","Grafische kunst, vormgeving"],"en":["Art Galleries","Graphic art"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"\"C'est pas mon genre\" - Ramuntcho Matta","shortdescr":"Pour cette exposition \u00ab C\u2019est pas mon genre \u00bb, la galerie Ali\u00e9nor Prouvost pr\u00e9sente les \u0153uvres de Ramuntcho Matta, un artiste pluridisciplinaire de grand talent. \u00c0 travers plus d\u2019une centaine d\u2019\u0153uvres sur papier, il nous entraine dans son quotidien par sa pratique du dessin","longdescr":"Ramuntcho Matta est n\u00e9 \u00e0 Paris en 1960, il vit et travaille \u00e0 Paris et \u00e0 Epaux-B\u00e9zu.\r\n\u00c0 la fin des ann\u00e9es 70, Ramuntcho Matta d\u00e9bute sa carri\u00e8re artistique dans la musique, il utilise\r\nd\u00e9j\u00e0 les arts plastiques par-del\u00e0 son travail de compositeur afin de donner forme \u00e0 des\r\nquestionnements, des sujets de cr\u00e9ation plus singuliers et complexes utilisant parfois le son, le\r\ndessin, la vid\u00e9o, l'espace, les mots ou des combinatoires.\r\nChris Marker en tentant de d\u00e9finir son travail trouva l\u2019adjectif : \"multimedium\".\r\nPrivil\u00e9giant souvent le collaboratif, il a travaill\u00e9 avec de nombreux artistes comme Don Cherry,\r\nBrion Gysin, John Cage ou Chris Marker.\r\nIl a r\u00e9alis\u00e9 une vingtaine de disques en solo, et autant en collectif.\r\nIl a jou\u00e9 et expos\u00e9 \u00e0 Paris, New-York, Londres, Madrid, Barcelone, Tokyo, Rome... Il a \u00e9galement\r\nparticip\u00e9 \u00e0 de nombreuses expositions collectives comme \u00e0 l\u2019espace Louis Vuitton de Paris, \u00e0 la\r\nArt Library de Milan, au Mus\u00e9e des Beaux-Arts de Valenciennes, au mus\u00e9e des Beaux- Arts de San\r\nDiego, au Palais de Tokyo \u00e0 Paris, \u00e0 La Piscine de Roubaix.","performers":null,"boxoffice_url":null,"website":"https:\/\/alienorprouvost.com\/","email":"ap@alienorprouvost.com","phone_contact":"+32 2 347 18 49","phone_booking":"+32 2 347 18 49","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/532152.html"},"nl":{"name":"\"C'est pas mon genre\" - Ramuntcho Matta","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"ap@alienorprouvost.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/532152.html"},"en":{"name":"\"C'est pas mon genre\" - Ramuntcho Matta","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"ap@alienorprouvost.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/532152.html"},"de":{"name":"\"C'est pas mon genre\" - Ramuntcho Matta","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/532152.html"},"it":{"name":"\"C'est pas mon genre\" - Ramuntcho Matta","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/532152.html"},"sp":{"name":"\"C'est pas mon genre\" - Ramuntcho Matta","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/532152.html"},"pt":{"name":"\"C'est pas mon genre\" - Ramuntcho Matta","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/532152.html"},"cn":{"name":"\"C'est pas mon genre\" - Ramuntcho Matta","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/532152.html"}},"place":{"id":276427,"translations":{"fr":{"name":"Galerie Alienor Prouvost","address_street_name":"Rue Washington","address_street_number":"64","address_street_box":null,"email":"ap@alienorprouvost.com","website":"http:\/\/www.alienorprouvost.com","phone_contact":"+32 2 347 18 49","phone_booking":null,"addre