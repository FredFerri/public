te_start":"2022-09-21","date_end":"2022-09-22","date_next":"2022-09-22","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre"}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Sexplay","shortdescr":"Voyage initiatique dans une sexualit\u00e9 libre, ce r\u00e9cit autofictionnel d\u00e9complexe la parole sur la sexualit\u00e9 et le plaisir vulvaire. Masturbation et club berlinois ne sont qu\u2019alibis pour questionner nos libert\u00e9s et nos limites.","longdescr":"Dans cette performance auto-fictionnelle, une jeune femme doute, interroge et expose les sinueux cheminements de ses d\u00e9sirs. \u00c0 partir de ses exp\u00e9riences charnelles, elle nous confie ses plaisirs, ses failles, ses limites. Autant de tentatives pour s\u2019approprier sa sexualit\u00e9, d\u00e9couvrir de nouveaux champs de libert\u00e9 et go\u00fbter \u00e0 la jouissance de se mettre en danger. Elle nous invite \u00e0 questionner nos imaginaires pornographiques, retourner nos \u00e9vidences, et \u00e0 lib\u00e9rer nos sens. Les repr\u00e9sentations de la sexualit\u00e9 incluent trop souvent les m\u00eames sc\u00e9narios, les m\u00eames imaginaires. La r\u00e9volution sexuelle a encore besoin d\u2019actes subversifs. Les mots \u00ab d\u00e9viance \u00bb et \u00ab perversion \u00bb sont forts et g\u00e9n\u00e9ralement stigmatisants. Pourtant, d\u00e9vier d\u2019un chemin, c\u2019est aussi en d\u00e9couvrir d\u2019autres.\r\n \r\nTh\u00e9matique : Corps\r\nParcours : R\u00eaver - Construire - Contester","performers":"Le Darouri Express Collectif \u00b7 Camille Husson","boxoffice_url":null,"website":"http:\/\/www.famefestival.be","email":"ticket@famefestival.be","phone_contact":null,"phone_booking":"+32 474 30 96 81","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.538078"},"nl":{"name":"Sexplay","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"info@famefestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.538078"},"en":{"name":"Sexplay","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.538078"},"de":{"name":"Sexplay","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.538078"},"it":{"name":"Sexplay","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.538078"},"sp":{"name":"Sexplay","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.538078"},"pt":{"name":"Sexplay","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.538078"},"cn":{"name":"Sexplay","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.538078"}},"place":{"id":1085,"translations":{"fr":{"name":"Les Riches-Claires","address_street_name":"Rue des Riches Claires","address_street_number":"24","address_street_box":null,"email":"accueil@lesrichesclaires.be","website":"http:\/\/www.lesrichesclaires.be","phone_contact":"+32 2 548 25 80","phone_booking":"+32 2 548 25 80","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Riches Claires, 24","address_line2":"1000 Bruxelles","description_web":"Le centre culturel Les Riches-Claires est ouvert \u00e0 toutes les disciplines des arts de la sc\u00e8ne, situ\u00e9 \u00e0 deux pas de la Place Saint-G\u00e9ry et de la Bourse. Le lieu se d\u00e9finit comme une rampe de lancement pour les jeunes artistes tout en permettant aux compagnies confirm\u00e9es de tenter de nouvelles exp\u00e9riences. Par sa programmation, originale et accessible, les Riches-Claires cherchent \u00e0 perp\u00e9tuer sa tradition de sc\u00e8ne th\u00e9\u00e2trale privil\u00e9giant l'humour, tout en offrant un espace d\u2019expression \u00e0 la danse contemporaine, la musique et le cin\u00e9ma.\r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Les Riches-Claires","address_street_name":"Rijkeklarenstraat","address_street_number":"24","address_street_box":null,"email":"accueil@lesrichesclaires.be","website":"http:\/\/www.lesrichesclaires.be","phone_contact":"+32 2 548 25 80","phone_booking":"+32 2 548 25 80","address_zip":"1000","address_city":"Brussel","address_line1":"Rijkeklarenstraat, 24","address_line2":"1000 Brussel","description_web":"Riches-Claires is een cultureel centrum open voor alle disciplines van de podiumkunsten, gelegen op slechts een steenworp afstand van het Sint-Goriksplein en de Beurs. De plaats definieert zich als een lanceerplatform voor jonge kunstenaars terwijl gevestigde waarden er kunnen experimenteren. Met haar originele en toegankelijke programmering wil de instelling zijn traditie