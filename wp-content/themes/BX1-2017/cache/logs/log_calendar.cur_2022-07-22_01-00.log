s":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":0}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-07-21T01:05:38+02:00","published_at":"2022-04-04T12:35:37+02:00","backoffice_id":250824,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.10317473211894},{"id":535909,"date_start":"2022-07-28","date_end":"2022-07-28","date_next":"2022-07-28","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre"}},"others":{"list":[52],"translations":{"fr":["Th\u00e9\u00e2tre musical"],"nl":["Muziektheater"],"en":["Musical theatre"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"La femme du vent","shortdescr":"Hommage \u00e0 Anne Sylvestre - 60 ans d'avant-garde","longdescr":"\u00ab L\u2019une des figures les plus marquantes de la chanson fran\u00e7aise. \u00bb Le Monde\r\n\u00ab Anne Sylvestre est loin d\u2019avoir tout dit. Elle n\u2019a pas fini d\u2019\u00e9puiser le bonheur de la sc\u00e8ne. \u00bb France TV info\r\n\u00ab Son \u0153uvre est d\u2019une richesse affolante. Une \u00e9criture en majuscule, foudroyante, pr\u00e9cise. \u00bb Lib\u00e9ration\r\n\u00ab Anne Sylvestre est engag\u00e9e depuis ses d\u00e9buts dans le pr\u00e9sent et l\u2019avenir de l\u2019humain. \u00bb La Croix\r\n\r\nLa chanson fran\u00e7aise a perdu fin 2020 un de ses phares, la chanteuse Anne Sylvestre est morte \u00e0 l\u2019\u00e2ge de 86 ans \u00ab des suites d\u2019un AVC \u00bb. Bien que son succ\u00e8s n\u2019ait pas \u00e9t\u00e9 retentissant, Anne Sylvestre \u00e9tait un monument \u00e0 sa fa\u00e7on. Elle fut l\u2019une des premi\u00e8res femmes, avant Barbara, \u00e0 \u00e9crire et \u00e0 chanter ses propres chansons, \u00e0 une \u00e9poque o\u00f9 la plupart des chanteuses fran\u00e7aises se contentaient d\u2019\u00eatre des interpr\u00e8tes.\r\n\r\nAnne Sylvestre, cette grande dame qui nous a quitt\u00e9s fin 2020, laisse derri\u00e8re elle un r\u00e9pertoire gigantesque de chansons po\u00e9tiques et engag\u00e9es, v\u00e9ritables t\u00e9moins de la vie des gens, passant de l\u2019humour caustique \u00e0 la sinc\u00e9rit\u00e9 la plus touchante.\r\n\r\nUn hommage \u00e0 son image, dans lequel sont interpr\u00e9t\u00e9s une dizaine de morceaux connus et moins connus choisis parmi plus de 700 chansons.\r\nUn concert ponctu\u00e9 de bribes de ses textes et d\u2019extraits d\u2019interviews.","performers":"CONCERT HOMMAGE \u00c0 ANNE SYLVESTRE\r\nHommage \u00e0 Anne Sylvestre \u25aa Avec: Ariane Rousseau et Eric Bribosia","boxoffice_url":"https:\/\/shop.utick.be\/?pos=FESTIVALBRUXELLONS&module=CATALOGUE&lg=FR","website":"http:\/\/www.bruxellons.be","email":"info@bruxellons.net","phone_contact":null,"phone_booking":"+32 2 724 24 24","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/535909.html"},"nl":{"name":"La femme du vent","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/shop.utick.be\/?pos=FESTIVALBRUXELLONS&module=CATALOGUE&lg=NL","website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/535909.html"},"en":{"name":"La femme du vent","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/shop.utick.be\/?pos=FESTIVALBRUXELLONS&module=CATALOGUE&lg=EN","website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/535909.html"},"de":{"name":"La femme du vent","shortdescr":null,"longdescr":null,"performers":null,