es\/la-maison-hannon-primaire\/","email":"classesdupatrimoine@coudenberg.brussels","phone_contact":"+32 2 563 63 73","phone_booking":"+32 2 563 63 73","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.557130"},"en":{"name":"Les mille et une vies de la Maison Hannon","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.classesdupatrimoine.brussels\/toutes-les-activites\/la-maison-hannon-primaire\/","email":"classesdupatrimoine@coudenberg.brussels","phone_contact":"+32 2 563 63 73","phone_booking":"+32 2 563 63 73","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.557130"},"it":{"name":"Les mille et une vies de la Maison Hannon","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.classesdupatrimoine.brussels\/toutes-les-activites\/la-maison-hannon-primaire\/","email":"classesdupatrimoine@coudenberg.brussels","phone_contact":"+32 2 563 63 73","phone_booking":"+32 2 563 63 73","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.557130"},"cn":{"name":"Les mille et une vies de la Maison Hannon","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.classesdupatrimoine.brussels\/toutes-les-activites\/la-maison-hannon-primaire\/","email":"classesdupatrimoine@coudenberg.brussels","phone_contact":"+32 2 563 63 73","phone_booking":"+32 2 563 63 73","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.557130"},"fr":{"name":"Les mille et une vies de la Maison Hannon","shortdescr":null,"longdescr":"En 1905, \u00c9douard Hannon, un ing\u00e9nieur passionn\u00e9 de photographie, et son \u00e9pouse Marie Debard, emm\u00e9nagent dans la nouvelle demeure que leur a r\u00e9alis\u00e9, cl\u00e9 sur porte, l\u2019architecte Jules Brunfaut. \r\n\r\nEt si on se glissait dans la peau de ses occupants pour imaginer comment la vie de la maison s\u2019organisait autour de l\u2019impressionnante cage d\u2019escalier ? Et si on essayait de comprendre comment les restaurateurs d\u2019aujourd\u2019hui ont ramen\u00e9 \u00e0 la vie l\u2019\u0153uvre des artisans de l\u2019\u00e9poque ?\r\n\r\nDe la maison au mus\u00e9e, en passant par une galerie d\u00e9di\u00e9e \u00e0 la photographie, nous suivrons, pas \u00e0 pas, l\u2019\u00e9volution du b\u00e2timent pour d\u00e9coder les traces de ses mille et une vies.\r\n","performers":null,"boxoffice_url":null,"website":"https:\/\/www.classesdupatrimoine.brussels\/toutes-les-activites\/la-maison-hannon-primaire\/","email":"classesdupatrimoine@coudenberg.brussels","phone_contact":"+32 2 563 63 73","phone_booking":"+32 2 563 63 73","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.557130"},"sp":{"name":"Les mille et une vies de la Maison Hannon","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.classesdupatrimoine.brussels\/toutes-les-activites\/la-maison-hannon-primaire\/","email":"classesdupatrimoine@coudenberg.brussels","phone_contact":"+32 2 563 63 73","phone_booking":"+32 2 563 63 73","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.557130"},"nl":{"name":"Les mille et une vies de la Maison Hannon","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.classesdupatrimoine.brussels\/toutes-les-activites\/la-maison-hannon-primaire\/","email":"classesdupatrimoine@coudenberg.brussels","phone_contact":"+32 2 563 63 73","phone_booking":"+32 2 563 63 73","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.557130"}},"place":{"id":244861,"translations":{"de":{"name":"Maison Hannon","address_street_name":"Av. de la Jonction","address_street_number":"1","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Av. de la Jonction, 1","address_line2":"1060 Saint-Gilles","description_web":"Edouard Hannon, Ingenieur der Gesellschaft Solvay und einer der Vertreter der industriellen Bourgeoisie, erwarb 1902 ein Grundst\u00fcck an der Avenue Brugman und beauftragte den Architekten Jules Brunfaut mit dem Bau eines prachtvollen Herrenhauses im Jugendstil.\r\n\r\nJules Brunfaut z\u00e4hlte bis dato nicht zu den Jugendstil-Architekten. Er bediente sich dieses Stils lediglich, um seinem Freund und Gesch\u00e4ftspartner einen Gefallen zu tun. 1903, als sich der Jugendstil auch international durchgesetzt hatte, wagte er sich an neue Stilelemente heran: Ihm sind die Fenster im Tiffany-Stil zu verdanken. Und es wird deutlich, wer Brunfauts Vorbilder waren: Victor Horta und Octave van Rijsselberghe (der Architekt des H\u00f4tel Otlet und H\u00f4tel de Brouck\u00e8re).\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Maison Hannon","address_street_name":"Avenue de la Jonction","address_street_number":"1","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Avenue de la Jonction, 1","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Maison Hannon","address_street_name":"Avenue de la Jonction","address_street_number":"1","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Avenue de la Jonction, 1","address_line2":"1060 Saint-Gilles","description_web":"The Maison Hannon, on the corner of Avenue Brugmann and Avenue de la Jonction, was built in 1902, at the request of the couple Marie and \u00c9douard Hannon, by their friend, the architect Jules Brunfaut. Conceived as a symbolist and dreamlike universe, the house is one of the masterpieces of art nouveau in Brussels, a union of Belgian and French art of the time. \r\nJules Brunfaut, unfamiliar with the new style, was inspired by other architects' houses, such as those of Victor Horta (personal house, Tassel and Wessinger hotels), Ernest Bl\u00e9rot (personal house, now destroyed) and Octave Van Rysselbeghe and Henry Van de Velde (Otlet hotel). \r\nCombining the beaux-arts style with that of modernity, or art nouveau at that period, the Maison Hannon is a singular work, an intimate and personal house, bringing together the tastes and passions of its commissioners. \r\n\r\nThe Maison Hannon will open its doors to the public on June 1, 2023, as a house museum. ","description_print":null,"booking_url":"https:\/\/shop.utick.net\/?pos=AGENDABRUSSELS&module=ACTIVITYSERIEDETAILS&s=089B0E9A-DB73-AE2D-92E9-879659B7E80B&lg=en","sort_order":null,"virtual_visit":null},"it":{"name":"Maison Hannon","address_street_name":"Avenue de la Jonction","address_street_number":"1","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Avenue de la Jonction, 1","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Maison Hannon","address_street_name":"Avenue de la Jonction","address_street_number":"1","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Avenue de la Jonction, 1","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"fr":{"name":"Maison Hannon","address_street_name":"Avenue de la Jonction","address_street_number":"1","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Avenue de la Jonction, 1","address_line2":"1060 Saint-Gilles","description_web":"La Maison Hannon, \u00e0 l\u2019angle des avenues Brugmann et de la Jonction, a \u00e9t\u00e9 construite en 1902, \u00e0 la demande du couple Marie et \u00c9douard Hannon, par leur ami l\u2019architecte Jules Brunfaut. Con\u00e7ue comme univers symboliste et onirique, la maison est un des chefs-d\u2019\u0153uvre de l\u2019art nouveau \u00e0 Bruxelles, union de l\u2019art belge et de l\u2019art fran\u00e7ais de l\u2019\u00e9poque. \r\n\r\nJules Brunfaut, peu familier au style nouveau, s\u2019inspirera d\u2019autres maisons d\u2019architectes de l\u2019\u00e9poque, tel que celles de Victor Horta (maison personnelle, h\u00f4tels Tassel et Wessinger), d\u2019Ernest Bl\u00e9rot (maison personnelle, aujourd\u2019hui d\u00e9truite) et d\u2019Octave Van Rysselbeghe et Henry Van de Velde (h\u00f4tel Otlet). \r\n\r\nAlliant style beaux-arts \u00e0 celui de la modernit\u00e9, soit l\u2019art nouveau \u00e0 l\u2019\u00e9poque, la Maison Hannon est une \u0153uvre singuli\u00e8re, une maison intime et personnelle, r\u00e9unissant les go\u00fbts et passions de ses commanditaires. \r\n\r\nLa Maison Hannon ouvre ses portes au public le 1er juin 2023, en tant que maison-mus\u00e9e.\r\n","description_print":null,"booking_url":"https:\/\/shop.utick.net\/?pos=AGENDABRUSSELS&module=ACTIVITYSERIEDETAILS&s=089B0E9A-DB73-AE2D-92E9-879659B7E80B&lg=fr","sort_order":null,"virtual_visit":null},"sp":{"name":"Maison Hannon","address_street_name":"Avenue de la Jonction","address_street_number":"1","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Avenue de la Jonction, 1","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Maison Hannon","address_street_name":"Verbindingslaan","address_street_number":"1","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Verbindingslaan, 1","address_line2":"1060 Saint-Gilles","description_web":"Het Maison Hannon werd in 1902 gebouwd op de hoek van de Brugmannlaan en de Verbindingslaan in Sint-Gillis door de architect Jules Brunfaut op verzoek van het echtpaar Marie en \u00c9douard Hannon. Het huis, opgevat als een droomachtig, symbolistische omsloten wereld, is een van de meesterwerken van de Brusselse art nouveau, een vereniging van Belgische en Franse kunst uit die tijd.\r\n\r\nJules Brunfaut, onbekend met de nouveau-stijl, liet zich inspireren door de huizen van andere architecten uit die tijd, zoals die van Victor Horta (persoonlijk huis, hotels Tassel en Wessinger), Ernest Bl\u00e9rot (persoonlijk huis, nu vernietigd) en Octave Van Rysselbeghe en Henry Van de Velde (hotel Otlet). \r\nHet Maison Hannon combineert de Beaux-Arts stijl met die van de moderniteit, de toenmalige art nouveau, en is een uniek werk, een intiem en persoonlijk huis dat de smaak en de passies van zijn opdrachtgevers samenbrengt. \r\n\r\nHet Maison Hannon zal op 1 juni 2023 de deuren voor het publiek openen als huis-museum.","description_print":null,"booking_url":"https:\/\/shop.utick.net\/?pos=AGENDABRUSSELS&module=ACTIVITYSERIEDETAILS&s=089B0E9A-DB73-AE2D-92E9-879659B7E80B&lg=nl","sort_order":null,"virtual_visit":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[21],"translations":{"de":["S\u00fcden"],"pt":[null],"en":["South"],"it":["Sud"],"cn":[null],"fr":["Sud"],"sp":["Sur"],"nl":["Zuid"]}},"neca":"","facebook_id":null,"backoffice_id":7146,"location":{"lat":50.82090346,"lon":4.35220579},"region":"brussels","last_updated_at":"2023-08-17T17:34:20+02:00","published_at":"2013-10-19T01:21:40+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},