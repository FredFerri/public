3,4,5,11],"translations":{"fr":["Enfants 3-6 ans","Enfants 6-9 ans","Enfants 9-12 ans","Famille"],"nl":["Kinderen 3-6 j.","Kinderen 6-9 j.","Kinderen 9-12 j.","Familie"],"en":["Children 3-6 yr.","Children 6-9 yr.","Children 9-12 yr.","Family"]}},"tags":["kids"],"accessibilities":{"list":[255,261,263,265,266],"translations":{"fr":["Accessible","Parking accessible","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9","Brussels Health Safety Label"],"nl":["Toegankelijk","Toegankelijke parking","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet","Brussels Health Safety Label"],"en":["Accessible","Accessible parking","Accessible to pedestrians with mobility aids","Adapted toilet","Brussels Health Safety Label"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-04-15T13:24:26+02:00","published_at":"2022-03-17T10:50:42+01:00","backoffice_id":249872,"import_origin":null,"sub_type":"other","show_in_agenda":true,"ranking":0.22833557019815},{"id":528893,"date_start":"2022-04-10","date_end":"2022-09-18","date_next":"2022-08-21","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"A la d\u00e9couverte du Bruxelles m\u00e9di\u00e9val","shortdescr":"Balade au coeur historique\r\n\r\nde Bruxelles.\r\nDe l'Histoire aux l\u00e9gendes, venez d\u00e9couvrir la ville au 13\u00e8me si\u00e8cle, au travers d'un parcours in\u00e9dit, suivant le trac\u00e9 de la premi\u00e8re enceinte de la ville.\r\nLe Best Seller de Visite Guid\u00e9e Bruxelles : tout simplement.","longdescr":"De l'Histoire aux l\u00e9gendes, venez d\u00e9couvrir la ville au 13\u00e8me si\u00e8cle, au travers d'un parcours in\u00e9dit, suivant le trac\u00e9 de la premi\u00e8re enceinte de la ville.\r\nVous prendrez conscience de l'importance du r\u00f4le de la Senne dans le d\u00e9veloppement de la ville, la symbolique haut de la ville - bas de la ville, la distinction entre les trois pouvoirs m\u00e9di\u00e9vaux : duc, clerg\u00e9, bourgeois.\r\nUn parcours s\u00e9rieux pour apprendre l'histoire de la ville.\r\nSans se prendre au s\u00e9rieux.\r\n\u200bProgramme de la visite, Bruxelles, la m\u00e9di\u00e9vale\r\n*\u00eelot Saint-G\u00e9ry, l\u00e0 o\u00f9 tout commen\u00e7a\r\n* \u00e9glises : Saint-Jacques, de la Madeleine, N-D du Bon-Secours, ...\r\n*l\u00e9gende et petite histoire : le zinneke-pis : mieux que le manneken pis !\r\n*Grand-Place\r\n*cath\u00e9drale Saint-Michel et Gudule\r\n*place Sainte-Catherine (ancien port, march\u00e9s)\r\n* palais royal (Coudenberg)\r\n* vestiges du mur d'enceinte et des tours (tour Noire, tour d'Angle, mur de Villers, ...)\r\n* quelques lieux secrets ou in\u00e9dits\r\n... et en option, le pot de lambic pour cl\u00f4turer le tout en beaut\u00e9, \u00e0 la bruxelloise, non, peut-\u00eatre !","performers":"Vincent Beckers, guide touristique et r\u00e9gional","boxoffice_url":null,"website":"http:\/\/www.visiteguideebruxelles.be","email":"info@visiteguideebruxelles.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/528893.html"},"nl":{"name":"A la d\u00e9couverte du Bruxelles m\u00e9di\u00e9val","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/528893.html"},"en":{"name":"A la d\u00e9couverte du Bruxelles m\u00e9di\u00e9val","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/528893.html"},"de":{"name":"A la d\u00e9couverte du Bruxelles m\u00e9di\u00e9val","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/528893.html"},"it":{"name":"A la d\u00e9couverte du Bruxelles m\u00e9di\u00e9val","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/528893.html"},"sp":{"name":"A la d\u00e9couverte du Bruxelles m\u00e9di\u00e9val","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/528893.html"},"pt":{"name":"A la d\u00e9couverte du Bruxelles m\u00e9di\u00e9val","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/528893.html"},"cn":{"name":"A la d\u00e9couverte du Bruxelles m\u00e9di\u00e9val","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/528893.html"}},"place":{"id":475,"translations":{"fr":{"name":"H\u00f4tel de Ville de Bruxelles","address_street_name":"Grand-Place","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.bruxelles.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"\u00c9l\u00e9gant b\u00e2timent datant du 15\u00e8me si\u00e8cle, l\u2019H\u00f4tel de Ville de Bruxelles se situe au c\u0153ur du centre historique, sur la somptueuse Grand-Place.\r\nSouvent consid\u00e9r\u00e9 comme la pi\u00e8ce ma\u00eetresse de la plus belle place du monde, il est probablement l\u2019un des plus beaux \u00e9difices du pays et \u00e9videmment l\u2019un des monuments \u00e0 ne pas manquer lors de votre s\u00e9jour \u00e0 Bruxelles. Sa splendide tour se dresse tel un rep\u00e8re aussi bien pour les curieux d\u2019un jour que les belges de passage dans le centre de la capitale.\r\nUn r\u00e9gal pour les yeux\r\nParticuli\u00e8rement imposant par ses dimensions, ses remarquables d\u00e9cors sculpt\u00e9s et sa fa\u00e7ade asym\u00e9trique, il attire rapidement les regards. En vous promenant devant ce prestigieux b\u00e2timent, peut-\u00eatre que vous apercevrez aux balcons de jeunes mari\u00e9s c\u00e9l\u00e9brer leur union.\r\nL\u2019int\u00e9rieur de l\u2019H\u00f4tel de Ville vaut \u00e9galement le d\u00e9tour. Il attise la curiosit\u00e9 de ceux qui souhaitent d\u00e9couvrir la disposition et l\u2019am\u00e9nagement des diff\u00e9rentes salles de ce chef-d\u2019\u0153uvre architectural. Des visites guid\u00e9es de l\u2019H\u00f4tel de Ville de Bruxelles sont r\u00e9guli\u00e8rement organis\u00e9es afin de d\u00e9couvrir la richesse de cet int\u00e9rieur qui ne cesse d\u2019\u00e9blouir les visiteurs.\r\nL\u2019\u00e9volution d\u2019un b\u00e2timent singulier\r\nSa construction s'\u00e9tale sur une longue p\u00e9riode et voit d\u00e9filer plusieurs architectes. \u00c0 l\u2019origine, l\u2019\u00e9difice ne comptait qu\u2019un beffroi et la partie gauche qui elle est rest\u00e9e identique jusqu\u2019\u00e0 aujourd\u2019hui. Le beffroi, quant \u00e0 lui, est par contre rapidement remplac\u00e9 par la tour actuelle lorsque les maisons des diff\u00e9rentes corporations de m\u00e9tiers s\u2019installent sur la place. Une aile suppl\u00e9mentaire est \u00e9galement ajout\u00e9e sur la droite pour inclure au mieux ces immeubles dans cet incomparable d\u00e9cor.\r\nAu sommet de la nouvelle tour, haute de plus de 90m, la fl\u00e8che est couronn\u00e9e de l\u2019archange Saint-Michel, grand Patron de la ville de Bruxelles. Cette statue en cuivre dor\u00e9 sert en r\u00e9alit\u00e9 de girouette. Si les vents vous sont favorables, vous aurez l\u2019occasion de pouvoir admirer convenablement la mani\u00e8re dont cet embl\u00e8me vient \u00e0 bout du dragon !\r\nActuellement, ce joyau du patrimoine bruxellois abrite l\u2019office du Tourisme.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Stadhuis Brussel","address_street_name":"Grote Markt","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.brussel.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Grote Markt","address_line2":"1000 Brussel","description_web":"Het elegante stadhuis van Brussel dateert uit de 15de eeuw en ligt in het historische hart van de stad, op de prachtige Grote Markt. \r\n\r\nHet wordt vaak beschouwd als het absolute pronkstuk van het mooiste plein ter wereld en is wellicht een van de mooiste gebouwen van het land. Het is dan ook een niet te missen monument tijdens je bezoek aan Brussel. Zijn prachtige toren is een herkenningspunt voor zowel de dagjestoeristen als de Belgen die door het stadscentrum kuieren. \r\nEen lust voor het oog \r\nNiet alleen de indrukwekkende afmetingen van het gebouw, maar ook de opmerkelijke gebeeldhouwde ornamenten en de asymmetrische gevel trekken meteen de aandacht. En terwijl je dit prestigieuze gebouw voorbij wandelt, word je misschien toegewuifd door een pasgetrouwd stel op het balkon ... \r\nHet interieur van het stadhuis is eveneens een omweg waard. Wie wil, kan een blik werpen op de indeling en de inrichting van de verschillende zalen van dit architecturale meesterwerk. Er worden regelmatig rondleidingen in het Brussels stadhuis georganiseerd om de rijkdom van het interieur aan de bezoekers te tonen. \r\nEvolutie van een uniek gebouw \r\nHet gebouw werd over een lange periode ontworpen door verschillende architecten. Oorspronkelijk bestond het enkel uit een belfort en het linkerdeel, dat ongewijzigd is gebleven. Het belfort daarentegen werd al snel vervangen door de huidige toren, toen de huizen van de verschillende gilden zich op de grote markt begonnen te vestigen. Aan de rechterkant werd een extra vleugel bijgebouwd, om deze gebouwen beter in dit unieke decor op te nemen. \r\nBovenaan de meer dan 90 meter hoge, nieuwe toren, werd de torenspits bekroond met aartsengel Micha\u00ebl, de beschermheilige van de stad Brussel. Het standbeeld in verguld koper doet in werkelijkheid dienst als windwijzer. Bij gunstige wind kan je zelfs zien hoe dit embleem de draak velt! \r\nMomenteel is de toeristische dienst ondergebracht in dit pronkstuk van het Brusselse erfgoed. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Brussels Town Hall","address_street_name":"Grand-Place","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.bruxelles.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Grand-Place","address_line2":"1000 Brussels","description_web":"An elegant building dating back to the 15th century, the City of Brussels Town Hall is located in the heart of the historical centre, on the sumptuous Grand-Place.\r\nOften considered to be the centrepiece of the most beautiful square in the world, it is undoubtedly one of the most stunning buildings in Belgium and definitely one of the unmissable highlights of your stay in Brussels. Its splendid tower stands as a landmark both for day-trippers and Belgians passing through the centre of the capital.\r\n\r\nA feast for the eyes\r\nParticularly imposing due to its size, its remarkable sculpted decorations and its asymmetrical facade, it quickly catches the eye. Walking in front of this prestigious building, you might spot newlyweds celebrating their union on the balconies.\r\nThe Town Hall's interior is also well worth a visit. It attracts the curiosity of those who want to know more about the layout and arrangement of the different rooms of this architectural masterpiece. Guided tours of the City of Brussels Town Hall are regularly organised and let you discover the richness of this interior which never fails to dazzle its visitors.\r\n\r\nThe evolution of a unique building\r\nIts construction was spread out over a long period of time and is the work of several architects. Originally, the building had only a belfry and the left part of the building has remained the same until today. The belfry, on the other hand, was quickly replaced by the current tower when the houses of the various trade guilds moved into the square. An additional wing was also added on the right to better incorporate these buildings into this exceptional setting.\r\nAt the top of the new tower, more than 90m high, the spire is crowned with the Archangel Saint-Michel, the patron saint of the City of Brussels. This gilded copper statue is actually used as a weather vane. If the winds blow the right way, you can admire the city's hero as he defeats the dragon!\r\nThis jewel of Brussels' architectural heritage currently houses the Tourist Office.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Rathaus Br\u00fcssel","address_street_name":"Grand-Place","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.brussel.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"Das Br\u00fcsseler Rathaus ist ein elegantes Bauwerk aus dem 15. Jahrhundert, gelegen auf dem pr\u00e4chtigen Grand-Place im Herzen des historischen Stadtzentrums. \r\n\r\nEs gilt als das architektonische Meisterwerk eines der sch\u00f6nsten Pl\u00e4tze der Welt und z\u00e4hlt dar\u00fcber hinaus zu den wahrscheinlich eindrucksvollsten Bauwerken Belgiens, das Sie bei Ihrem Besuch in Br\u00fcssel unbedingt besichtigen sollten. Zu verfehlen ist es kaum, denn sein majest\u00e4tischer Turm ragt hoch in den Br\u00fcsseler Himmel hinein.  \r\n\r\nEin Augenschmaus \r\n\r\nInsbesondere seine imposanten Dimensionen, seine bemerkenswerten skulpturalen Verzierungen und seine asymmetrische Fassade fallen sofort ins Auge. Und wenn man Gl\u00fcck hat, kann man auf dem majest\u00e4tischen Balkon einen Blick auf ein frischgebackenes Brautpaar erhaschen. \r\n\r\nAuch das Innere des Rathauses ist einen Besuch wert, denn die Aufteilung und die Anordnung der verschiedenen S\u00e4le dieses architektonischen Meisterwerks sind absolut sehenswert. Es finden regelm\u00e4\u00dfig F\u00fchrungen durch das Br\u00fcsseler Rathaus statt, die spannende Einblicke in die Reicht\u00fcmer des Interieurs gew\u00e4hren, das die Besucher immer wieder aufs Neue begeistert. \r\n\r\nDie Entstehung eines einzigartigen Geb\u00e4udes \r\n\r\nDer Bau des Rathauses erstreckte sich \u00fcber einen relativ langen Zeitraum und war das Werk mehrerer Architekten. Urspr\u00fcnglich bestand das Geb\u00e4ude nur aus einem Glockenturm und dem bis heute unver\u00e4nderten linken Geb\u00e4udefl\u00fcgel. Der Glockenturm hingegen wurde schon bald durch den heutigen Turm ersetzt, als sich die H\u00e4user der verschiedenen Handwerksz\u00fcnfte am Grand-Place niederlie\u00dfen. Um das Geb\u00e4ude noch harmonischer in das Stadtbild einzuf\u00fcgen, wurde ein zus\u00e4tzlicher Fl\u00fcgel auf der rechten Seite hinzugef\u00fcgt. \r\n\r\nAn der Spitze des neuen, mehr als 90 m hohen Turms  thront der Erzengel Michael, der Schutzpatron der Stadt Br\u00fcssel. Die vergoldete Kupferstatue dient eigentlich als Wetterfigur \u2013 und wenn der Wind g\u00fcnstig steht, k\u00f6nnen Sie beobachten, wie die die Engelsfigur den Drachen besiegt! \r\n\r\nDerzeit beherbergt dieses Kleinod des Br\u00fcsseler Architekturerbes das Tourismusb\u00fcro.  ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Municipio di Bruxelles","address_street_name":"Grand-Place","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.bruxelles.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"Elegante edificio risalente al 15\u00b0 secolo, il municipio di Bruxelles si trova nel cuore del centro storico, nella sontuosa Grand-Place. \r\n\r\nSpesso considerato come l\u2019elemento centrale della piazza pi\u00f9 bella del mondo, \u00e8 probabilmente uno degli edifici pi\u00f9 belli del paese e sicuramente uno dei monumenti da non perdere quando si visita Bruxelles. La sua splendida torre funge da punto di riferimento sia per i turisti che per i belgi di passaggio nel centro della capitale. \r\n\r\nUna festa per gli occhi \r\n\r\nParticolarmente imponente per le sue dimensioni, le sue stupende decorazioni scolpite e la sua facciata asimmetrica, cattura rapidamente l\u2019attenzione. Passeggiando davanti a tale edificio prestigioso, \u00e8 possibile scorgere sui balconi gli sposi novelli intenti a festeggiare il loro matrimonio. \r\n\r\nVale la pena visitare anche gli interni del municipio. Suscitano la curiosit\u00e0 di chi desidera scoprire la disposizione e l\u2019arredamento delle varie sale di questo capolavoro architettonico. Vengono periodicamente organizzate visite guidate al municipio di Bruxelles durante le quali \u00e8 possibile ammirare la ricchezza degli interni che non smettono mai di affascinare i visitatori. \r\n\r\nL\u2019evoluzione di un edificio eccezionale \r\n\r\nLa sua costruzione avviene nel corso di un lungo periodo di tempo e vede l\u2019avvicendarsi di vari architetti. In origine, l\u2019edificio comprendeva solo una torre campanaria e la parte sinistra, rimasta identica fino ai nostri giorni. La torre campanaria \u00e8 stata invece sostituita rapidamente dalla torre attuale quando le case delle varie corporazioni sono state trasferite nella piazza. \u00c8 stata peraltro aggiunta un\u2019altra ala sulla destra per accogliere al meglio tali edifici in questa cornice dalla bellezza incomparabile. \r\n\r\nIn cima alla nuova torre, alta pi\u00f9 di 90 m, la guglia \u00e8 coronata da San Michele arcangelo, santo patrono della citt\u00e0 di Bruxelles. Tale raffigurazione in rame dorato funge in realt\u00e0 da segnavento. Se il vento soffia nella direzione giusta, avrete modo di ammirare per bene l\u2019eroe della citt\u00e0 che sconfigge il drago! \r\n\r\nQuesto gioiello del patrimonio di Bruxelles ospita attualmente l\u2019ufficio del Turismo. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Ayuntamiento de Bruselas","address_street_name":"Grand-Place","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.brussel.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"El elegante edificio del siglo XV del ayuntamiento de Bruselas se encuentra en el coraz\u00f3n del centro hist\u00f3rico de la ciudad, en la suntuosa Grand-Place. \r\n\r\nConsiderado a menudo como la pieza clave de la plaza m\u00e1s bella del mundo es probablemente uno de los edificios m\u00e1s hermosos del pa\u00eds y evidentemente uno de los monumentos que no debes perderte en tu visita a Bruselas. Su espl\u00e9ndida torre se alza como punto de referencia, tanto para los visitantes del d\u00eda como para los belgas que pasan por el centro de la capital. \r\n\r\nUn regalo para la vista \r\n\r\nEste monumento, imponente por sus dimensiones, sus adornos esculpidos y su fachada asim\u00e9trica, llama r\u00e1pidamente la atenci\u00f3n de los transe\u00fantes. No es extra\u00f1o que al pasear delante de este prestigioso edificio veas en los balcones a alguna pareja de reci\u00e9n casados celebrando su enlace en los balcones. \r\n\r\nEl interior del ayuntamiento tambi\u00e9n merece una visita. Despierta la curiosidad de quienes desean descubrir la disposici\u00f3n y dise\u00f1o de las salas de esta obra maestra arquitect\u00f3nica. Se organizan con regularidad visitas guiadas al ayuntamiento para descubrir la riqueza de su interior que fascina a los visitantes. \r\n\r\nLa evoluci\u00f3n de un edificio singular \r\n\r\nSu construcci\u00f3n abarc\u00f3 un largo periodo y cont\u00f3 con la direcci\u00f3n de varios arquitectos. En un principio, el edificio \u00fanicamente contaba con un campanario y la parte izquierda que se ha conservado intacta hasta el d\u00eda de hoy. El campanario fue r\u00e1pidamente sustituido por la torre actual, cuando las casas de los diferentes gremios se instalaron en la plaza. Asimismo, se a\u00f1adi\u00f3 un ala adicional en la parte derecha para integrar mejor los nuevos edificios en este incomparable decorado. \r\n\r\nEn la cima de la nueva torre, de m\u00e1s de 90 m de altura, el arc\u00e1ngel San Miguel, patr\u00f3n de la ciudad de Bruselas, corona la aguja. Esta estatua de cobre dorado sirve de veleta. Si el viento sopla a su favor, tendr\u00e1s la ocasi\u00f3n de admirar de la mejor forma \u00a1c\u00f3mo San Miguel vence al drag\u00f3n! \r\n\r\nActualmente, esta joya del patrimonio bruselense alberga la oficina de turismo. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"C\u00e2mara Municipal de Bruxelas","address_street_name":"Grand-Place","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.bruxelles.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"O edif\u00edcio da C\u00e2mara Municipal de Bruxelas \u00e9 uma obra de arte da arquitetura civil g\u00f3tica do s\u00e9culo XV. No s\u00e9culo XVIII, foi-lhe adicionada uma ala de estilo cl\u00e1ssico. As in\u00fameras salas competem entre si em aparato. S\u00e3o notavelmente ornamentadas por tape\u00e7arias excecionais que evocam epis\u00f3dios locais e nacionais da hist\u00f3ria belga. Exposi\u00e7\u00f5es ocupam pontualmente os espa\u00e7os.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"H\u00f4tel de Ville de Bruxelles","address_street_name":"Grand-Place","address_street_number":null,"address_street_box":null,"email":null,"website":"http:\/\/www.bruxelles.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grand-Place","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[13],"translations":{"fr":["Centre historique"],"nl":["Historisch centrum"],"en":["Historical Centre"]}},"zones":{"list":[19],"translations":{"fr":["Centre"],"nl":["Centrum"],"en":["Centre"]}},"neca":null,"facebook_id":null,"backoffice_id":112,"location":{"lat":50.8466937,"lon":4.35252339},"region":"brussels","last_updated_at":"2022-05-02T01:07:05+02:00","published_at":"2013-10-19T01:13:17+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":277830,"translations":{"fr":{"name":"Visite Guid\u00e9e Bruxelles","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":"info@visiteguideebruxelles.be","website":"http:\/\/www.visiteguideebruxelles.be","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Visite Guid\u00e9e Bruxelles","address_line2":"1000 Bruxelles","description_web":"