0.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.559486"},"it":{"name":"Cr\u00e9ation de bijoux contemporains ' Le bijou dans tous ses \u00e9tats'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/shop.utick.net\/?module=ACTIVITYSERIEDETAILS&pos=WOLUCULTURE&s=FB69F707-BF17-1AD2-9F70-709D438FAAFA","email":"secretariat.atl@woluwe1200.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.559486"},"cn":{"name":"Cr\u00e9ation de bijoux contemporains ' Le bijou dans tous ses \u00e9tats'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/shop.utick.net\/?module=ACTIVITYSERIEDETAILS&pos=WOLUCULTURE&s=FB69F707-BF17-1AD2-9F70-709D438FAAFA","email":"secretariat.atl@woluwe1200.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.559486"},"fr":{"name":"Cr\u00e9ation de bijoux contemporains ' Le bijou dans tous ses \u00e9tats'","shortdescr":"Cr\u00e9ation de bijoux contemporains \" Le bijou dans tous ses \u00e9tats\" - 2023\/2023 - 111\r\nAtelier Couture | Rue Lola Bobesco 11, 2e \u00e9tage - 1200 Woluwe Saint Lambert | Voir la carte","longdescr":"Cet atelier vous invite \u00e0 d\u00e9couvrir le monde de la bijouterie contemporaine. Nous porterons une attention particuli\u00e8re \u00e0 la recherche ; \u00e0 l\u2019esth\u00e9tique du bijou, \u00e0 sa portabilit\u00e9 et \u00e0 son rapport au corps. Nous exp\u00e9rimenterons les diff\u00e9rentes techniques pour cr\u00e9er des bijoux : la cire perdue, le travail du m\u00e9tal sans soudures, la transformation d\u2019ancienne pi\u00e8ces (upcycling). Mais aussi un travail des mati\u00e8res autres que le m\u00e9tal : papier, textile, objets de r\u00e9cup\u00e9ration, bois, vieux jouets, perles, boutons etc Tout les mat\u00e9riaux sont les bienvenus. L\u2019atelier vise \u00e0 d\u00e9velopper et enrichir votre univers cr\u00e9atif et savoir faire.\r\n\r\nAccessible aux d\u00e9butant.e.s et confirm\u00e9.e.s\r\n\r\nCet atelier requiert un outillage de base qui peut \u00eatre achet\u00e9 sur place ainsi que la cire.\r\n\r\nMat\u00e9riel \u00e0 apporter :Photos, dessins, illustrations de bijoux que vous aimeriez porter et\/ou r\u00e9aliser, un bloc de feuilles, un crayon ou porte-mine. La cire utilis\u00e9e pour la r\u00e9alisation des maquettes ainsi que l'outillage peuvent \u00eatre achet\u00e9s sur place au prix co\u00fbtant.\r\n\r\nAvec Isabelle Carpentier\r\n\r\nD\u00e9s le 19 septembre, les mardis de 18:30 \u00e0 21:00","performers":"Avec Isabelle Carpentier","boxoffice_url":null,"website":"https:\/\/shop.utick.net\/?module=ACTIVITYSERIEDETAILS&pos=WOLUCULTURE&s=FB69F707-BF17-1AD2-9F70-709D438FAAFA","email":"secretariat.atl@woluwe1200.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.559486"},"sp":{"name":"Cr\u00e9ation de bijoux contemporains ' Le bijou dans tous ses \u00e9tats'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/shop.utick.net\/?module=ACTIVITYSERIEDETAILS&pos=WOLUCULTURE&s=FB69F707-BF17-1AD2-9F70-709D438FAAFA","email":"secretariat.atl@woluwe1200.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.559486"},"nl":{"name":"Cr\u00e9ation de bijoux contemporains ' Le bijou dans tous ses \u00e9tats'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/shop.utick.net\/?module=ACTIVITYSERIEDETAILS&pos=WOLUCULTURE&s=FB69F707-BF17-1AD2-9F70-709D438FAAFA","email":"secretariat.atl@woluwe1200.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agen