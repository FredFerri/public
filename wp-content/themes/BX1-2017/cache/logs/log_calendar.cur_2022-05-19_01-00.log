:{"fr":["Accessible","Appareils d'amplification du son","Chien d'assistance","Parking accessible","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9"],"nl":["Toegankelijk","Geluidsversterkende apparatuur","Assistentiehonden","Toegankelijke parking","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet"],"en":["Accessible","Sound-amplifying equipment","Assistance dogs","Accessible parking","Accessible to pedestrians with mobility aids","Adapted toilet"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-04-01T12:05:05+02:00","published_at":"2022-02-16T11:47:34+01:00","backoffice_id":247675,"import_origin":null,"sub_type":"festival","show_in_agenda":true,"ranking":1},{"id":531126,"date_start":"2022-05-21","date_end":"2022-05-22","date_next":"2022-05-21","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[36,39],"translations":{"fr":["Mus\u00e9es et art centers","Photographie"],"nl":["Musea en kunstcentra","Fotografie"],"en":["Museums and art centers","Photography"]}}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Caf\u00e9 Patrimoine du Homborch et Expo Homborch d'Antan","shortdescr":"Venez partager vos tr\u00e9sors du pass\u00e9 \u00e0 ce caf\u00e9 patrimoine en collaboration avec ABC (Alliance Bruxelloise Coop\u00e9rative) et Erfgoedbank Brussel. Et d\u00e9couvrez l\u2019histoire du quartier pendant la petite exposition Homborch d'Antan.","longdescr":"Le centenaire des cit\u00e9s-jardins \u00e0 Bruxelles : Le Homborch \r\nEn mai 2022, les cit\u00e9s-jardins de Bruxelles f\u00eateront leur 100e anniversaire. Et bien que la cit\u00e9-jardin du Homborch n\u2019ait pas tout \u00e0 fait 100 ans (elle a \u00e9t\u00e9 construite en 1928), le quartier sera en f\u00eate tout le week-end du 21 et 22 mai !\r\n\r\nProfitez-en pour (re)d\u00e9couvrir le quartier avec, entre autres, l\u2019exposition \u00ab Homborch d'antan \u00bb, des visites guid\u00e9es mais \u00e9galement un Caf\u00e9 Patrimoine qui sera le lieu d\u2019\u00e9changes entre habitants du quartier, nouveaux ou anciens, invit\u00e9s \u00e0 partager des photos, des documents et des histoires du pass\u00e9 concernant le Homborch. Vous disposez de documents ou photos du quartier, n'h\u00e9sitez pas \u00e0 les apporter pour les partager !","performers":"En collaboration avec ABC (Alliance Bruxelloise Coop\u00e9rative), Erfgoedbank Brussel et le CoCoLo (Conseil Consultatif des Locataires).","boxoffice_url":null,"website":null,"email":"culture@uccle.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/531126.html"},"nl":{"name":"Ergoedcaf\u00e9 Homborch en Expo Homborch d'Antan","shortdescr":"Deel jouw \u2018schatten uit het verleden\u2019 tijdens dit caf\u00e9 in samenwerking met ABC  (Alliance Bruxelloise Coop\u00e9rative) en Erfgoedbank Brussel. En ontdek de geschiedenis van de wijk tijdens de mini expo 'Homborch d'Antan'.","longdescr":"100 jaar tuinwijken in Brussel: De Homborchwijk \r\nIn mei 2022 vieren de Brusselse tuinwijken hun 100-jarige bestaan. En ook al kwam de Homborchwijk er pas later in 1928, toch viert Ukkel tijdens het weekend van 21 en 22 mei volop mee!\r\n\r\nBenieuwd om in dit kader de prachtige Homborchwijk te (her)ontdekken? Grijp dan nu je kans! Naast de expo Homborch d\u2019antan kan je genieten van rondleidingen en een Erfgoedcaf\u00e9. Op dit laatste worden buurt en ge\u00efnteresseerden uitgenodigd om foto\u2019s, documenten en verhalen van vroeger over de tuinwijk te delen. Heb je thuis materiaal over de wijk liggen dat je graag met ons deelt? Neem dat dan zeker mee!","performers":"In samenwerking met ABC (Alliance Bruxelloise Coop\u00e9rative), Erfgoedbank Brussel en le CoCoLo (Conseil Consultatif des Locataires).","boxoffice_url":null,"website":"http:\/\/www.uccle.be","email":"cultuur@ukkel.brussels","phone_contact":"+32 2 605 15 33","phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/531126.html"},"en":{"name":"Ergoedcaf\u00e9 Homborch en Expo Homborch d'Antan","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/531126.html"},"de":{"name":"Ergoedcaf\u00e9 Homborch en Expo Homborch d'Antan","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/531126.html"},"it":{"name":"Ergoedcaf\u00e9 Homborch en Expo Homborch d'Antan","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/531126.html"},"sp":{"name":"Ergoedcaf\u00e9 Homborch en Expo Homborch d'Antan","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/531126.html"},"pt":{"name":"Ergoedcaf\u00e9 Homborch en Expo Homborch d'Antan","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/531126.html"},"cn":{"name":"Ergoedcaf\u00e9 Homborch en Expo Homborch d'Antan","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agend