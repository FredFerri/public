-08-20","2022-08-21","2022-08-22","2022-08-23","2022-08-24","2022-08-25","2022-08-26"],"date_exceptions":[{"day":"2022-06-18","start":"15:30:00","end":"18:00:00"}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"opening":{"day":"2022-06-18","start":"15:30:00","timestamp":"2022-06-18T15:30:00+02:00","end":"18:00:00","is_only_by_appointment":false},"tags":[],"accessibilities":{"list":[257,259],"translations":{"fr":["Am\u00e9nagements pour personnes sourdes et malentendantes","Chien d'assistance"],"nl":["Voorzieningen voor dove en slechthorende personen","Assistentiehonden"],"en":["Facilities for deaf and hearing-impaired people","Assistance dogs"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-07-10T01:08:09+02:00","published_at":"2022-06-20T09:18:25+02:00","backoffice_id":256325,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.27144176165949},{"id":530582,"date_start":"2022-04-22","date_end":"2022-08-28","date_next":"2022-08-27","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre"}},"others":{"list":[51],"translations":{"fr":["Caf\u00e9 th\u00e9\u00e2tre"],"nl":["Cabaret"],"en":["Cabaret"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Dans l'oeil du 6Cl\u00f4ne \/ 6Degr\u00e9s","shortdescr":null,"longdescr":"\u00ab Dans l\u2019\u0153il du cyclone \u00bb \/\/ Mais c\u2019est quoi ce concept ?\r\nH\u00e9 bien en fait, c\u2019est tr\u00e8s simple. Vous prenez une \u00e9quipe d\u2019impro. Cinq personnes. Ou six, enfin on verra. Vous en mettez un au milieu, il a peur, il flippe sa m\u00e8re, peut-\u00eatre m\u00eame qu\u2019il commence une crise d\u2019urticaire si c\u2019est un sensible. Les autres sont autour, et paf paf, ils font comme \u00e7a, et apr\u00e8s ils encha\u00eenent avec un tour de passe-passe, ils sautent, il y a une corde qui descend du plafond et des aigles qui arrivent sur la sc\u00e8ne. Et l\u00e0, c\u2019est le moment crucial : on allume la m\u00e8che, et soudain, SCHLAAAH ! Ah ben oui, c\u2019est tout \u00e7a. Ou ce sera peut-\u00eatre tout autre chose, parce que bon, c'est de l'impro.\r\n--------------\r\n\r\nIl est possible de manger et\/ou boire un verre sur place avant le spectacle, pensez donc \u00e0 venir plus t\u00f4t! (Derni\u00e8re commande de restauration \u00e0 20h00!)\r\nR\u00c9SERVATIONS (obligatoires)","performers":"L'\u00e9quipe des 6Cl\u00f4nes","boxoffice_url":null,"website":"http:\/\/www.letrac.be\/reservations","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/530582.html"},"nl":{"name":"Dans l'oeil du 6Cl\u00f4ne \/ 6Degr\u00e9s","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/530582.html"},"en":{"name":"Dans l'oeil du 6Cl\u00f4ne \/ 6Degr\u00e9s","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/530582.html"},"de":{"name":"Dans l'oeil du 6Cl\u00f4ne \/ 6Degr\u00e9s - Spectacle d'improvisation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/530582.html"},"it":{"name":"Dans l'oeil du 6Cl\u00f4ne \/ 6Degr\u00e9s - Spectacle d'improvisation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,