\u00e9ances), qui s\u2019ach\u00e8te uniquement \u00e0 notre accueil en cash jusqu\u2019au 1er octobre 2023 (un abonnement par cours bien d\u00e9fini). \n\n\nSeniors Acad\u00e9mie organise des cours de sports dans diff\u00e9rentes communes de Bruxelles. Consultez le programme complet (yoga, gymnastique douce, aquagym, Qi Gong, Ta\u00efji Quan) dans notre brochure semestrielle l\u2019Echomutualiste Seniors ou sur le site de Solidaris brabant www.solidaris-brabant.be\/fr\/sacademie. \n\nVoici \u00e9galement nos conditions g\u00e9n\u00e9rales","performers":null,"boxoffice_url":null,"website":"http:\/\/www.solidaris-brabant.be\/fr\/sacademie","email":"sacademie.asbl@solidaris.be","phone_contact":"+32 2 546 14 94","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50003210"},"sp":{"name":"Gymnastique douce \u00e0  Berchem-Ste-Agathe","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.solidaris-brabant.be\/fr\/sacademie","email":"sacademie.asbl@solidaris.be","phone_contact":"+32 2 546 14 94","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50003210"},"nl":{"name":"Gymnastique douce \u00e0  Berchem-Ste-Agathe","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.solidaris-brabant.be\/fr\/sacademie","email":"sacademie.asbl@solidaris.be","phone_contact":"+32 2 546 14 94","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50003210"}},"place":{"id":50000662,"translations":{"de":{"name":"Omnisport de Berchem","address_street_name":"Rue des Ch\u00e2lets","address_street_number":"1","address_street_box":null,"email":"sacademie.asbl@solidaris.be","website":"www.solidaris-brabant.be\/fr\/sacademie","phone_contact":"+32 2 546 14 94","phone_booking":null,"address_zip":"1082","address_city":"Berchem-Sainte-Agathe","address_line1":"Rue des Ch\u00e2lets, 1","add