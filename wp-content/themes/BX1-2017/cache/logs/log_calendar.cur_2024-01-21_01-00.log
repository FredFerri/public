r un.e inconnu.e dans la s\u00e9curit\u00e9 et la st\u00e9rilit\u00e9 virtuelle. Oser passer le pas de la rencontre r\u00e9elle. Prendre le risque de se confronter \u00e0 la r\u00e9alit\u00e9.\r\n\r\nClaire de Reuck et Patrick Spadrille d\u00e9cortiquent avec humour et sinc\u00e9rit\u00e9 les rouages de l\u2019amour 2.0. Ses fantasmes, ses d\u00e9sillusions, ses angoisses, ses excitations, ses \u00e9checs et ses charmantes surprises.","performers":"Claire de Reuck et Patrick Spadrille","boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Rencontres-com","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.561645"},"sp":{"name":"Rencontres.com","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Rencontres-com","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.561645"},"nl":{"name":"Rencontres.com","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Rencontres-com","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.561645"}},"place":{"id":270611,"translations":{"de":{"name":"Th\u00e9\u00e2tre l\u2019Improviste ","address_street_name":"Rue de Fierlant","address_street_number":"120","address_street_box":null,"email":null,"website":"http:\/\/www.improviste.be\/","phone_contact":null,"phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Rue de Fierlant, 120","address_line2":"1190 Forest","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Th\u00e9\u00e2tre L'improviste","address_street_name":"Rue de Fierlant","address_street_number":"120","address_st