 in Etterbeek een parel van een theatercaf\u00e9 met een sprookjesachtige naam: Le Petit Chapeau Rond Rouge. Hier kan je van woensdag tot en met zaterdag terecht voor een eclectisch programma van voorstellingen: humor, improvisatie, concerten en muziekquizzen. Je zal er betoverd worden door de gemoedelijke en uiterst sympathieke sfeer.  ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Le Petit Chapeau Rond Rouge","address_street_name":"Rue P\u00e8re Eudore Devroye","address_street_number":"12","address_street_box":null,"email":"info@lepetitchapeaurondrouge.be","website":"http:\/\/www.lepetitchapeaurondrouge.be","phone_contact":"+32 498 51 35 63","phone_booking":"+32 498 51 35 63","address_zip":"1040","address_city":"Etterbeek","address_line1":"Rue P\u00e8re Eudore Devroye, 12","address_line2":"1040 Etterbeek","description_web":"This attractive cafe-theatre is open from Wednesday to Saturday from 7p.m. Besides theatrical and humorous performances, there are also jazz and rock concerts.\r\n ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Le Petit Chapeau Rond Rouge","address_street_name":"Rue P\u00e8re Eudore Devroye","address_street_number":"12","address_street_box":null,"email":"info@lepetitchapeaurondrouge.be","website":"http:\/\/www.lepetitchapeaurondrouge.be","phone_contact":"+32 498 51 35 63","phone_booking":"+32 498 51 35 63","address_zip":"1040","address_city":"Etterbeek","address_line1":"Rue P\u00e8re Eudore Devroye, 12","address_line2":"1040 Etterbeek","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Le Petit Chapeau Rond Rouge","address_street_name":"Rue P\u00e8re Eudore Devroye","address_street_number":"12","address_street_box":null,"email":"info@lepetitchapeaurondrouge.be","website":"http:\/\/www.lepetitchapeaurondrouge.be","phone_contact":"+32 498 51 35 63","phone_booking":"+32 498 51 35 63