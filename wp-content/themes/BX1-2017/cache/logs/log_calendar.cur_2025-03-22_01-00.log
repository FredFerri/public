:{"spoken":["nl","en","fr"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibitions","it":"Esposizioni","cn":null,"fr":"Expositions","sp":"Exposici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[39,36],"translations":{"de":["Fotografie","Museen & Kunstzentren"],"pt":[null,null],"en":["Photography","Museums and art centers"],"it":["Fotografia","Musei e centri artistici"],"cn":[null,null],"fr":["Photographie","Mus\u00e9es et art centers"],"sp":["Fotograf\u00eda","Museos y centros de arte"],"nl":["Fotografie","Musea en kunstcentra"]}}},"translations":{"de":{"name":"Expo \u00ab Seuls avec les autres \u00bb","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/montdepiete.be\/blogs\/news\/expo-seuls-avec-les-autres","email":"info@montdepiete.be","phone_contact":"+32 2 512 13 85","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700007640"},"pt":{"name":"Expo \u00ab Seuls avec les autres \u00bb","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/montdepiete.be\/blogs\/news\/expo-seuls-avec-les-autres","email":"info@montdepiete.be","phone_contact":"+32 2 512 13 85","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700007640"},"en":{"name":"Seuls avec les autres","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/montdepiete.be\/blogs\/news\/expo-seuls-avec-les-autres","email":"info@montdepiete.be","phone_contact":"+32 2 512 13 85","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700007640"},"it":{"name":"Expo \u00ab Seuls avec les autres \u00bb","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/montdepiete.be\/blogs\/news\/expo-seuls-avec-les-autres","email":"info@montdepiete.be","phone_contact":"+32 2 512 13 85","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700007640"},"cn":{"name":"Expo \u00ab Seuls avec les autres \u00bb","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/montdepiete.be\/blogs\/news\/expo-seuls-avec-les-autres","email":"info@montdepiete.be","phone_contact":"+32 2 512 13 85","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700007640"},"fr":{"name":"Seuls avec les autres","shortdescr":"Projet sur les handicaps visibles et invisibles. \nL'exposition explore le quotidien de personnes autistes et au-del\u00e0. Avec bienveillance, les photographes captent leur r\u00e9alit\u00e9 sans intrusion.\n\nM\u00ealant photos et art brut, elle offre une immersion unique, sensibilisant au handicap et promouvant l\u2019inclusion sociale par l\u2019art, le partage et l\u2019\u00e9change.","longdescr":"C\u2019est le nom qu\u2019ont donn\u00e9 les photographes Michel Loriaux et Lionel Jusseret \u00e0 propos de leur travail en immersion aupr\u00e8s de personnes autistes dans leurs lieux de vie. Leur approche bienveillante et leur regard, l\u2019attente et la patience qu\u2019un tel documentaire photographique exige, se veulent comme une aide \u00e0 la construction d\u2019une image de soi, en se situant \u00e0 la distance juste, avec le bon r\u00e9flexe, la bonne optique, tout en n'\u00e9tant jamais \"l\u2019intrus\".\nEn collaboration avec le CAJ Les Platanes, l\u2019exposition pr\u00e9sent\u00e9e ici propose des photographies et des \u0153uvres d'art brut, diff\u00e9renci\u00e9 ou outsider, c'est selon. Cet \u00e9v\u00e8nement qui m\u00eale les photographi\u00e9-es et les \u0153uvres picturales d'autres comme elle-eux, est une porte ouverte vers l\u2019univers de chacune de ces personnes ; autistes (mais pas que), artistes (mais pas que), dans le dessein d\u2019une inclusion sociale de ces dernier-es \u00e0 travers une d\u00e9marche artistique, une ouverture sur le handicap pour tous les publics et une inclusion de cette m\u00eame notion d\u2019handicap dans la soci\u00e9t\u00e9 comme vecteur d'\u00e9change, de partage, de collaboration et d'apprivoisement mutuel.\n","performers":"Le centre de jour Les Platanes, Michel Loriaux (photographe) et Lionel Jusseret (photographe)","boxoffice_url":null,"website":"https:\/\/montdepiete.be\/blogs\/news\/expo-seuls-avec-les-autres","email":"info@montdepiete.be","phone_contact":"+32 2 512 13 85","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700007640"},"sp":{"name":"Expo \u00ab Seuls avec les autres \u00bb","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/montdepiete.be\/blogs\/news\/expo-seuls-avec-les-autres","email":"info@montdepiete.be","phone_contact":"+32 2 512 13 85","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700007640"},"nl":{"name":"Seuls avec les autres","shortdescr":"Project over zichtbare en onzichtbare handicaps.\nDe tentoonstelling verkent het dagelijks leven van mensen met autisme en meer. Met zorg leggen de fotografen hun realiteit vast zonder opdringerig te zijn.\n\nDoor fotografie en outsiderkunst te combineren, biedt ze een unieke inkijk, sensibiliseert ze voor handicaps en bevordert ze sociale inclusie via kunst, ontmoeting en uitwisseling.","longdescr":"Dit is de naam die fotografen Michel Loriaux en Lionel Jusseret hebben gegeven aan hun werk gemakt bij mensen met autisme in hun leefomgeving. Hun vriendelijke benadering en blik, het geduld en de tijd die een dergelijk fotografisch documentaire vereist, dienen als een hulpmiddel voor het opbouwen van een zelfbeeld, door op de juiste afstand te blijven, met het juiste reflex, de juiste ingesteldheid, zonder ooit \"de indringer\" te zijn.\nIn samenwerking met het CAJ Les Platanes presenteert deze tentoonstelling foto\u2019s en werken van art brut, gedifferentieerd of outsider kunst, afhankelijk van het perspectief. Dit evenement, dat gefotografeerden en picturale werken van anderen zoals zij combineert, is een open deur naar het universum van elk van deze personen; autistisch (maar niet enkel dat), artistiek (maar niet enkel dat), met als doel sociale inclusie van deze laatsten via een artistieke benadering, een openheid van de handicap voor iedereen en een inclusie van dit handicapconcept in de samenleving als vector van uitwisseling, delen, samenwerking en wederzijdse acceptatie.\n ","performers":"door het dagcentrum Les Platanes, Michel Loriaux (fotograf) en Lionel Jusseret (fotograf)","boxoffice_url":null,"website":"https:\/\/montdepiete.be\/nl\/blogs\/news\/expo-seuls-avec-les-autres","email":"info@bergvanbarmhartigheid.be","phone_contact":"+32 2 512 13 85","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700007640"}},"place":{"id":221323,"translations":{"de":{"name":"Mont de Pi\u00e9t\u00e9 (Caisse Publique de Pr\u00eats)","address_street_name":"Rue Saint-Ghislain","address_street_number":"1923","address_street_box":null,"email":null,"website":null,"phone_contact":"+32 2 512 13 85","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Saint-Ghislain, 1923","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Mont de Pi\u00e9t\u00e9 (Caisse Publique de Pr\u00eats)","address_street_name":"Rue Saint-Ghislain","address_street_number":"1923","address_street_box":null,"email":null,"website":null,"phone_contact":"+32 2 512 13 85","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Saint-Ghislain, 1923","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"e