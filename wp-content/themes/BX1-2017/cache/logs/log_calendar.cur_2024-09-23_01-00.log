"closing_days":[],"child_events":[],"parent_events":[],"accessibilities":[],"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[]},{"id":5700000966,"date_start":"2024-09-28","date_end":"2024-09-29","date_next":"2024-09-28","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-09-05T12:07:06+02:00","published_at":"2024-09-05T12:03:36+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":307222,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"tour","ranking":1,"languages":{"spoken":["fr","en","nl"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{}},"translations":{"de":{"name":"Guided Tour of the Former Bureau des Ouvrages de la Cour (King Baudouin Fondation) - BBN 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/fr\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700000966"},"pt":{"name":"Guided Tour of the Former Bureau des Ouvrages de la Cour (King Baudouin Fondation) - BBN 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/fr\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700000966"},"en":{"name":"Guided Tour of the Former Bureau des Ouvrages de la Cour (King Baudouin Fondation) - BBN 2024","shortdescr":null,"longdescr":"Located in Rue de Brederode, next to the gardens of the Royal Palace, since 1982 this Neoclassical mansion has housed the King Baudouin Foundation, the mission of which is to work for a better society, serving the public interest and social cohesion, by accompanying philanthropists and donors throughout the world. Built between 1779 and 1781 for the Bureau des Ouvrages de la Cour, the edifice became part of the Royal Trust and subsequently housed the Museum of the Belgian Dynasty. In the past, the property comprised stables and a garden, as well as a carriage entrance. The main building retains a beautiful staircase and interesting remnants of 19th century parquet and panelling.\n\nThe visits are accessible to wheelchair users.\n\n","performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/en\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700000966"},"it":{"name":"Guided Tour of the Former Bureau des Ouvrages de la Cour (King Baudouin Fondation) - BBN 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/fr\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700000966"},"cn":{"name":"Guided Tour of the Former Bureau des Ouvrages de la Cour (King Baudouin Fondation) - BBN 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/fr\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700000966"},"fr":{"name":"Visite Guid\u00e9e de l'Ancien Bureau des Ouvrages de la Cour (Fondation Roi Baudouin) - BBN 2024","shortdescr":null,"longdescr":"Situ\u00e9 dans la rue de Brederode, en face des jardins du Palais royal, cet h\u00f4tel de ma\u00eetre n\u00e9oclassique abrite, depuis 1982, le si\u00e8ge de la Fondation Roi Baudouin. Ayant pour mission de contribuer \u00e0 une soci\u00e9t\u00e9 meilleure, au service de l'int\u00e9r\u00eat g\u00e9n\u00e9ral et de la coh\u00e9sion sociale, cette fondation accompagne les philanthropes et les donateurs dans le monde entier. Construit entre 1779 et 1781 pour le Bureau des Ouvrages de la Cour, cet \u00e9difice int\u00e9gra la Donation royale et abrita par la suite le Mus\u00e9e de la Dynastie. Autrefois, cette propri\u00e9t\u00e9 \u00e9tait dot\u00e9e d'\u00e9curies et d'un jardin, ainsi que d'une porte coch\u00e8re ; le b\u00e2timent principal conserve encore un bel escalier ainsi que d'int\u00e9ressants vestiges de parquet et de lambris du XIXe si\u00e8cle. \n\nCes visites sont accessibles aux personnes en fauteuil roulant.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/fr\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700000966"},"sp":{"name":"Guided Tour of the Former Bureau des Ouvrages de la Cour (King Baudouin Fondation) - BBN 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/fr\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700000966"},"nl":{"name":"Rondleiding van het Voormalig Bureau des Ouvrages de la Cour (Koning Boudewijnstichting) - BBN 2024","shortdescr":null,"longdescr":"Dit neoklassieke herenhuis aan de Brederodestraat, gelegen tegenover de tuinen van het Koninklijk Paleis, huisvest sinds 1982 de zetel van de Koning Boudewijnstichting. Die stelt zich ten dienste van het algemeen belang en de sociale cohesie door filantropen en schenkers van over de hele wereld te ondersteunen. Het gebouw werd tussen 1779 en 1781 ontworpen voor het Bureau des Ouvrages de la Cour - \"Het Bureau voor Werkzaamheden aan het Hof\". Later werd het opgenomen in de Koninklijke Schenking en bood het onderdak aan het Museum voor de Dynastie. Vroeger bevonden er zich ook paardenstallen en een tuin bij het pand, evenals een inrijpoort voor koetsen. In het hoofdgebouw zijn een mooie trap en interessante restanten van de 19e-eeuwse parketvloeren en lambriseringen bewaard gebleven. \n\nDe bezoeken zijn toegankelijk voor rolstoelgebruikers.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/nl\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700000966"}},"place":{"id":10228,"translations":{"de":{"name":"Fondation Roi Baudouin","address_street_name":"Rue Brederode","address_street_number":"21","address_street_box":null,"email":"info@kbs-frb.be","website":"http:\/\/www.kbs-frb.be","phone_contact":"+32 2 500 45 55","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Brederode, 21","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Fondation Roi Baudouin","address_street_name":"Rue Brederode","address_street_number":"21","address_street_box":null,"email":"info@kbs-frb.be","website":"http:\/\/www.kbs-frb.be","phone_contact":"+32 2 500 45 55","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Brederode, 21","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"King Baudouin Foundation ","address_street_name":"Rue Brederode","address_street_number":"21","address_street_box":null,"email":"info@kbs-frb.be","website":"http:\/\/www.kbs-frb.be","phone_contact":"+32 2 500 45 55","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue Brederode, 21","address_line2":"1000 Brussels","description_web":"The King Baudouin Foundation (KBF)\u2019 mission is clear and wide-ranging: to help improve living conditions for the population. It is an independent, pluralistic foundation that aims to contribute in innovative and sustainable ways towards greater social justice, democracy and respect for diversity. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Fondation Roi Baudouin","address_street_name":"Rue Brederode","address_street_number":"21","address_street_box":null,"email":"info@kbs-frb.be","website":"http:\/\/www.kbs-frb.be","phone_contact":"+32 2 500 45 55","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Brederode, 21","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Fondation Roi Baudouin","address_street_name":"Rue Brederode","address_street_number":"21","address_street_box":null,"email":"info@kbs-frb.be","website":"http:\/\/www.kbs-frb.be","phone_contact":"+32 2 500 45 55","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Brederode, 21","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Fondation Roi Baudouin","address_street_name":"Rue Brederode","address_street_number":"21","address_street_box":null,"email":"info@kbs-frb.be","website":"http:\/\/www.kbs-frb.be","phone_contact":"+32 2 500 45 55","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Brederode, 21","address_line2":"1000 Bruxelles","description_web":"La mission de la Fondation Roi Baudouin est \u00e0 la fois claire et complexe: contribuer \u00e0 am\u00e9liorer les conditions de vie de la population. En tant que fondation ind\u00e9pendante et pluraliste, qui veut contribuer de mani\u00e8re durable et innovante \u00e0 plus de justice sociale, de d\u00e9mocratie et de respect de la diversit\u00e9,  la Fondation Roi Baudouin organise des colloques et des groupes de r\u00e9flexion, elle soutient des projets tiers, diffuse des \u00e9tudes et rapports etc\u2026\r\nElle organise des s\u00e9minaires, journ\u00e9es de dialogue, conf\u00e9rences et journ\u00e9es d'\u00e9tudes \u00e0 l'attention d'un vaste public, des campagnes de sensibilisation autour de th\u00e8mes sp\u00e9cifiques, des expositions (mus\u00e9e BELvue, le Fonds du Patrimoine de la Fondation Roi Baudouin).","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Fondation Roi Baudouin","address_street_name":"Rue Brederode","address_street_number":"21","address_street_box":null,"email":"info@kbs-frb.be","website":"http:\/\/www.kbs-frb.be","phone_contact":"+32 2 500 45 55","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Brederode, 21","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Koning Boudewijnstichting","address_street_name":"Brederodestraat","address_street_number":"21","address_street_box":null,"email":"info@kbs-frb.be","website":"http:\/\/www.kbs-frb.be","phone_contact":"+32 2 500 45 55","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Brederodestraat, 21","address_line2":"1000 Brussel","description_web":"De opdracht van de Koning Boudewijnstichting is duidelijk en tegelijk veelomvattend: de levensomstandigheden van de bevolking helpen verbeteren. Als onafhankelijke, pluralistische stichting, die op een duurzame en vernieuwende manier wil bijdragen tot meer sociale rechtvaardigheid, democratie en respect voor diversiteit, organiseert de Stichting debatgroepen, ze publiceert studies en rapporten, en ondersteunt projecten van derden. Voor een breed publiek worden gratis seminaries, dialoogdagen, conferenties en studiedagen georganiseerd, alsook sensibilisatiecampagnes rond specifieke thema\u2019s en tentoonstellingen opgezet (BELvue museum, Erfgoedfonds van de Koning Boudewijnstichting). \r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[16],"translations":{"de":["K\u00f6nigliches Viertel"],"pt":[null],"en":["Royal"],"it":["Quartiere reale"],"cn":[null],"fr":["Quartier Royal"],"sp":["Quartier Royal \u2014Barrio de la Corte\u2014"],"nl":["Koninklijke wijk"]}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":null,"facebook_id":null,"backoffice_id":341,"location":{"lat":50.84035796,"lon":4.36226037},"region":"brussels","last_updated_at":"2022-10-13T10:47:34+02:00","published_at":"2013-10-19T01:13:27+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":false,"resto_ranking":0},"organizer":{"id":240214,"translations":{"de":{"name":"Explore.brussels","address_street_name":"avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"http:\/\/www.explore.brussels\/","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"avenue Brugmann, 405","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Explore.brussels","address_street_name":"avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"http:\/\/www.explore.brussels\/","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"avenue Brugmann, 405","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Explore.Brussels","address_street_name":"avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"http:\/\/www.explore.brussels\/","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"avenue Brugmann, 405","address_line2":"1180 Uccle","description_web":"Explore.Brussels is a network of associations that organize top-quality guided tours in the Brussels-Capital Region. \r\nIts membre associations are ARAU, Pro Velo, Brussels Chatterguides and Arkadia. La Fonderie (in 2020) & Korei (in 2021) joined the network as a partner association.\r\n\r\nDiscover UNESCO\u2019s heritage, Art nouveau, Victoria Horta, Magritte, Herg\u00e9, Street art, Europe, beer, chocolate, or visit buildings built in Art Nouveau, Art Deco or neoclassical style that are usually closed for public visits. Tours are available for individual visitors and groups, and organized in a classical, exceptional or completely new way. Besides walking tours, visits can be organized by bike, bus or boat.\r\n\r\nExplore.Brussels organizes the Brussels Art Nouveau & Art Deco (BANAD) Festival and Brussels Biennale \u2013 Neoclassic (BBN), Brussels Biennale of Eclectic Architecture (BBEA) as well as other projects such as the visits of Art Nouveau Mansions, the formation of tour guides, the owners club and the friends club. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Explore.brussels","address_street_name":"avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"http:\/\/www.explore.brussels\/","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"avenue Brugmann, 405","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Explore.brussels","address_street_name":"avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"http:\/\/www.explore.brussels\/","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"avenue Brugmann, 405","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Explore.Brussels","address_street_name":"avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"http:\/\/www.explore.brussels\/","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"avenue Brugmann, 405","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Explore.brussels","address_street_name":"avenue Brugmann","address_street_number":"405","address_street_box":null,"email":"info@explore.brussels","website":"http:\/\/www.explore.brussels\/","phone_contact":"+32 2 319 50 01","phone_booking":null,"address_zip":"1180","address_city