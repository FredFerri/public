sauvage.be\/produit\/rando-au-crepuscule-21122024\/\n*********************\nA l\u2019occasion de la journ\u00e9e la plus courte de l\u2019ann\u00e9e, partons d\u00e9couvrir la For\u00eat de Soignes autrement\u2026 Nous nous donnerons rendez-vous \u00e0 14h pour d\u00e9marrer une belle boucle de 15 km \u00e0 la d\u00e9couverte de vall\u00e9es encaiss\u00e9es, \u00e9tangs, clairi\u00e8res, monuments et autres traces laiss\u00e9es par l'Homme dans le paysage forestier. Le retour se fera bien apr\u00e8s le coucher du soleil, aid\u00e9 par les lueurs de nos lampes frontales !\nL'inscription est obligatoire (https:\/\/hetresauvage.be\/produit\/rando-au-crepuscule-21122024\/)\n","performers":null,"boxoffice_url":null,"website":"https:\/\/hetresauvage.be\/agenda\/","email":"HetreSauvage@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50013091"},"sp":{"name":"Randonn\u00e9e au cr\u00e9puscule","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/hetresauvage.be\/agenda\/","email":"HetreSauvage@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50013091"},"nl":{"name":"Randonn\u00e9e au cr\u00e9puscule","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/hetresauvage.be\/agenda\/","email":"HetreSauvage@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50013091"}},"place":{"id":279847,"translations":{"de":{"name":"H\u00eatre Sauvage","address_street_name":"Dr\u00e8ve du Rouge-Clo\u00eetre","address_street_number":"1","address_street_box":null,"email":"hetresauvage@gmail.com","website":"https:\/\/www.facebook.com\/Hetresauvage\/about","phone_contact":null,"phone_booking":null,"address_zip":"1160","address_city":"Auderghem","address_line1":"Dr\u00e8ve du Rouge-Clo\