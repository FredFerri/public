":"info@voceorgano.be","website":"http:\/\/www.voceorgano.be","phone_contact":"+32 499 14 48 99","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Bodenbroek, 6","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Voce et Organo asbl","address_street_name":"Rue Bodenbroek","address_street_number":"6","address_street_box":null,"email":"info@voceorgano.be","website":"http:\/\/www.voceorgano.be","phone_contact":"+32 499 14 48 99","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Bodenbroek, 6","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"tags":["force_publication"],"neca":null,"facebook_id":null,"backoffice_id":5206,"location":{"lat":50.84083701,"lon":4.3561839},"region":"brussels","last_updated_at":"2022-09-12T06:06:25+02:00","published_at":"2013-10-19T01:18:18+02:00","import_origin":null,"external_id":null,"is_in_address_book":false,"is_in_vb_export":false,"resto_ranking":0},"media":[{"type":"poster","link":"https:\/\/agendabrussels.imgix.net\/05bf38e52347f671c4d1aaafeee9ff048e458f08.jpg","width":2896,"height":4096,"ratio":0.71,"translations":{"fr":{"title":"Festival Voce et Organo 2022","copyright":null},"nl":{"title":"Festival Voce et Organo 2022","copyright":null},"en":{"title":"Festival Voce et Organo 2022","copyright":null}}}],"dates":[],"prices":[],"child_events":[536287],"parent_events":[],"targets":{"list":[],"translations":{}},"visit_profile":{"list":[337],"translations":{"fr":["Highlight"],"nl":["Highlight"],"en":["Highlight"]}},"tags":["major_event","force_publication"],"accessibilities":{"list":[255],"translations":{"fr":["Accessible"],"nl":["Toegankelijk"],"en":["Accessible"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-09-12T06:06:25+02:00","published_at":"2022-06-17T16:40:51+02:00","backoffice_id":256281,"import_origin":null,"sub_type":"festival","show_in_agenda":true,"ranking":0.62996052494744},{"id":537718,"date_start":"2022-09-02","date_end":"2022-09-18","date_next":"2022-09-14","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[36,46],"translations":{"fr":["Mus\u00e9es et art centers","Pluridisciplinaire"],"nl":["Musea en kunstcentra","Multidisciplinair"],"en":["Museums and art centers","Multidisciplinary"]}}},"languages":{"spoken":["nl","fr","en"],"subtitles":[]},"translations":{"fr":{"name":"Sit Back, Relax & Enjoy the Apocalypse","shortdescr":"Comment aborder l'id\u00e9e de la fin du monde ? Que symbolise r\u00e9ellement cette id\u00e9e ?\r\nOutre la survie de l'humanit\u00e9, cette exposition est une exploration de la survie des jeunes artistes. La vision des jeunes artistes sur l'avenir de l'humanit\u00e9 doit \u00eatre partag\u00e9e car ils inspireront et fa\u00e7onneront le monde de demain.","longdescr":"Du 2 septembre au 18 septembre 2022, l\u2019exposition physique \u201cSit Back, Relax & Enjoy the Apocalypse\u201d ouvrira ses portes pendant trois semaines dans les salles d\u2019exposition de LaVall\u00e9e, au c\u0153ur de Bruxelles.\r\n\r\nSeppe De Roo a \u00e9t\u00e9 nomm\u00e9 curateur de cette exposition. Seppe De Roo est un artiste visuel multidisciplinaire originaire de Bruxelles, n\u00e9 en 1994. Il cr\u00e9e cette exposition comme une \u0153uvre d\u2019art.\r\n\r\nComment aborder l\u2019id\u00e9e d\u2019une civilisation finissante ? Que symbolise cette id\u00e9e dans la r\u00e9alit\u00e9 ?\r\nDepuis le d\u00e9but de la soci\u00e9t\u00e9, l\u2019humanit\u00e9 a conceptualis\u00e9 et d\u00e9peint la fin des temps. Les r\u00e9cits apocalyptiques font appel \u00e0 l\u2019imagination de l\u2019homme contemporain. Il existe un fort pessimisme dans la soci\u00e9t\u00e9 quant \u00e0 l\u2019avenir de l\u2019humanit\u00e9 : la fin est proche, pour ainsi dire.\r\nCette croyance a quelque chose d\u2019ironique. Partout, \u00e0 toutes les \u00e9poques, des gens ont pens\u00e9 \u00e0 la fin et ont proclam\u00e9 des proph\u00e9ties. L\u2019Apocalypse est l\u2019une des histoires arch\u00e9typales les plus anciennes qui se r\u00e9invente \u00e0 chaque \u00e9poque. Pour ceux qui ont grandi pendant la guerre froide, elle a \u00e9t\u00e9 recr\u00e9\u00e9e dans la crainte d\u2019un holocauste nucl\u00e9aire. Pour la jeune g\u00e9n\u00e9ration, c\u2019est l\u2019\u00e9cocide.\r\nMalgr\u00e9 tous les probl\u00e8mes, il est possible de visualiser une plan\u00e8te et une soci\u00e9t\u00e9 meilleures pour l\u2019avenir.\r\nLes 14 jeunes artistes s\u00e9lectionn\u00e9s sont en partie des artistes de renomm\u00e9e internationale et en partie des talents \u00e9mergents de Bruxelles et de Belgique.\r\nOutre la survie de l\u2019humanit\u00e9, cette exposition est une exploration de la survie des jeunes artistes.\r\n\r\nLes visions des jeunes artistes sur l\u2019avenir de l\u2019humanit\u00e9 doivent \u00eatre partag\u00e9es car elles inspireront et fa\u00e7onneront le monde de demain.\r\nQue peut signifier cette histoire pour l\u2019humanit\u00e9 et la plan\u00e8te ? Non seulement dans sa fin, mais aussi dans sa renaissance ?\r\nChaque artiste s\u00e9lectionn\u00e9 a une perspective unique sur ce sujet qui se refl\u00e8te dans la science, la religion et les questions existentielles englob\u00e9es dans une vari\u00e9t\u00e9 de m\u00e9dias, de la peinture \u00e0 l\u2019art high-tech.\r\n\r\nEn plus d\u2019une r\u00e9sidence de 4 semaines pour tous les artistes participants dans les espaces d\u2019exposition de LaVall\u00e9e, il y aura une plateforme de performance chaque dimanche en collaboration avec le \u2018Tictac Art Center\u2019 \u00e0 Anderlecht et \u2018Ne Mosquito Pas\u2019. Pendant l\u2019exposition, il y aura des performances musicales, des ateliers et des visites guid\u00e9es gratuites par Seppe De Roo pour les jeunes de Molenbeek gr\u00e2ce \u00e0 des partenariats strat\u00e9giques avec \u2018Foyer\u2019 et \u2018Arts & Public\u2019, deux organisations de m\u00e9diation culturelle bas\u00e9es \u00e0 Molenbeek.","performers":"Jordan Edge\r\nSeppe De Roo\r\nEdwina McLennan\r\nAnna Zanichelli\r\nFilip Harna\r\nEmma Karolina Robertsson\r\nTora Wallander\r\nStudio Misti\r\nNathan Ishar\r\nLionel Dury\r\nLes Mains Fr\u00eales\r\nMaarten Van den Bussche\r\nMarilou Dejans\r\nArieh Frosh\r\nTic Tac Art Center\r\nNe Mosquito Pas\r\nArts & Publics\r\nle Foyer","boxoffice_url":null,"website":"https:\/\/www.enjoytheapocalypse.be\/about-the-exposition.html","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.537718"},"nl":{"name":"Sit Back, Relax & Enjoy the Apocalypse","shortdescr":"Hoe gaan we om met het idee van een eindigende beschaving? Wat symboliseert dit idee in realiteit? \r\nNaast het voortbestaan van de mensheid is deze tentoonstelling een verkenning van het voortbestaan van jonge kunstenaars. De visies van jonge kunstenaars op de toekomst van de mensheid moeten worden gedeeld, omdat zij de wereld van morgen zullen inspireren en vormgeven.","longdescr":"Van 2 september tot 18 september 2022 opent de fysieke tentoonstelling \u201cSit Back, Relax & Enjoy theApocalypse\u201d gedurende drie weken haar deuren in de tentoonstellingshallen van LaVall\u00e9e, in het hart van Brussel.\r\n\r\nSeppe De Roo is aangesteld als curator van deze tentoonstelling. Seppe De Roo is een multidisciplinair beeldend kunstenaar uit Brussel, geboren in 1994. Hij cre\u00ebert deze tentoonstelling als een kunstwerk.\r\n\r\nHoe gaan we om met het idee van een eindigende beschaving? Wat symboliseert dit idee in de realiteit?\r\nSinds het begin van de samenleving heeft de mensheid het einde der tijden geconceptualiseerd en verbeeld. Apocalyptische verhalen spreken tot de verbeelding van de hedendaagse mens. Er heerst in de samenleving een sterk pessimisme over de toekomst van de mensheid: het einde is als het ware nabij.\r\nEr is iets ironisch aan dit geloof. Overal, in alle tijden, hebben mensen nagedacht over het einde en profetie\u00ebn verkondigd. De Apocalyps is een van de oudste archetypische verhalen die zichzelf in elke tijd opnieuw uitvindt. Voor degenen die tijdens de Koude Oorlog zijn opgegroeid, is het herschapen in de angstvoor een nucleaire holocaust. Voor de jongere generatie is het de ecocide.\r\nOndanks alle problemen is het mogelijk een betere planeet en samenleving voor de toekomst te visualiseren.\r\nDe 14 geselecteerde jonge kunstenaars zijn deels kunstenaars van internationale faam en deels opkomende talenten uit Brussel en Belgi\u00eb.\r\nNaast het voortbestaan van de mensheid is deze tentoonstelling een verkenning van het voortbestaan van jonge kunstenaars. De visies van jonge kunstenaars op de toekomst van de mensheid moeten worden gedeeld, omdat zij de wereld van morgen zullen inspireren en vormgeven.\r\nWat kan dit verhaal betekenen voor de mensheid en de planeet? Niet alleen in haar einde, maar ook in haar wedergeboorte?\r\nElke geselecteerde kunstenaar heeft hier een uniek perspectief op dat wordt weerspiegeld in wetenschap, religie en existenti\u00eble vragen die in een verscheidenheid aan media, van schilderkunst tot hightech kunst,zijn vervat.\r\n\r\nNaast een residentie van 4 weken voor alle deelnemende kunstenaars in de tentoonstellingsruimtes vanLaVall\u00e9e, zal er elke zondag een performance platform zijn in samenwerking met \u2018Tictac Art Centre\u2019 in Anderlecht & \u2018Ne Mosquito Pas\u2019. Tijdens de tentoonstelling zijn er muziekoptredens, workshops en gratisrondleidingen door Seppe De Roo voor jongeren in Molenbeek via strategische partnerships met \u2018Foyer\u2019en Arts & Public\u2019, 2 culturele bemiddelingsorganisaties gevestigd in Molenbeek.","performers":"Jordan Edge\r\nSeppe De Roo\r\nEdwina McLennan\r\nAnna Zanichelli\r\nFilip Harna\r\nEmma Karolina Robertsson\r\nTora Wallander\r\nStudio Misti\r\nNathan Ishar\r\nLionel Dury\r\nLes Mains Fr\u00eales\r\nMaarten Van den Bussche\r\nMarilou Dejans\r\nArieh Frosh\r\nTic Tac Art Center\r\nNe Mosquito Pas\r\nArts & Publics\r\nle Foyer","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.537718"},"en":{"name":"Sit Back, Relax & Enjoy the Apocalypse","shortdescr":"How do we deal with the idea of an ending civilisation? What does this idea symbolise in reality?\r\nBesides the survival of humanity, this exhibition is an exploration of the survival of young artists. Young artists' visions of the future of mankind need to be shared as they will inspire and shape the world of tomorrow.","longdescr":"From the 1st of September until the 18th of september 2022, the physical exhibition \"Sit Back, Relax & Enjoy the Apocalypse\" will open its doors for three weeks in the exhibition halls of LaVall\u00e9e, in the heart of Brussels.\r\n\r\nSeppe De Roo has been appointed as curator of this exhibition and will be advised by renowned curator and writer Hans Theys. Seppe De Roo is a multidisciplinary visual artist from Brussels, born in 1994. He is creating this exhibition as a work of art.\r\n\r\nHow do we deal with the idea of an ending civilisation? What does this idea symbolise in reality?\r\nSince the beginning of society, mankind has conceptualised and depicted the end of times. Apocalyptic stories appeal to the imagination of contemporary humans. There is a strong pessimism in society about the future of mankind: the end is near, so to speak.\r\nThere is something ironic about this belief. People everywhere, in every age, have thought about the end and proclaimed prophecies. The Apocalypse is one of the oldest archetypal stories that reinvents itself in every age. For those who grew up during the Cold War, it was recreated in fear of a nuclear holocaust. For the younger generation, it is ecocide.\r\nDespite all the problems, it is possible to visualise a better planet and society for the future.\r\nThe 15 selected young artists are partly artists of international standing and partly emerging talents from Brussels and Belgium.\r\nBesides the survival of humanity, this exhibition is an exploration of the survival of young artists. Young artists' visions of the future of mankind need to be shared as they will inspire and shape the world of tomorrow.\r\nWhat can this story mean for humanity and the planet? Not only in its end, but also in its rebirth?\r\n\r\nEach selected artist has a unique perspective on this that is reflected in science, religion and existential questions encompassed in a variety of media, from painting to high-tech art.\r\n\r\nIn addition to a 4-week residency for all participating artists in LaVall\u00e9e's exhibition spaces, there will be a performance platform every Sunday in collaboration with \u2018Tictac Art Center\u2019 in Anderlecht & \u2018Ne Mosquito Pas\u2019.\r\nDuring the exhibition there will be music performances, workshops and free guided tours by Seppe De Roo for young people in Molenbeek through strategic partnerships with \u2018Foyer\u2019 and Arts & Public\u2019, 2 cultural mediation organizations based in Molenbeek.","performers":"Jordan Edge\r\nSeppe De Roo\r\nEdwina McLennan\r\nAnna Zanichelli\r\nFilip Harna\r\nEmma Karolina Robertsson\r\nTora Wallander\r\nStudio Misti\r\nNathan Ishar\r\nLionel Dury\r\nLes Mains Fr\u00eales\r\nMaarten Van den Bussche\r\nMarilou Dejans\r\nArieh Frosh\r\nTic Tac Art Center\r\nNe Mosquito Pas\r\nArts & Publics\r\nle Foyer","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.537718"},"de":{"name":"\u201cSit Back, Relax & Enjoy the Apocalypse\u201d","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.537718"},"it":{"name":"\u201cSit Back, Relax & Enjoy the Apocalypse\u201d","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.537718"},"sp":{"name":"\u201cSit Back, Relax & Enjoy the Apocalypse\u201d","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.537718"},"pt":{"name":"\u201cSit Back, Relax & Enjoy the Apocalypse\u201d","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.537718"},"cn":{"name":"\u201cSit Back, Relax & Enjoy the Apocalypse\u201d","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.537718"}},"place":{"id":273242,"translations":{"fr":{"name":"LaVall\u00e9e","address_street_name":"Rue Adolphe Lavall\u00e9e","address_street_number":"39","address_street_box":null,"email":null,"website":"http:\/\/www.lavallee.brussels","phone_contact":"+32 491 71 43 65","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Rue Adolphe Lavall\u00e9e, 39","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"Ancienne blanchisserie industrielle de 6 000 m\u00b2 \u00e0 Molenbeek, LaVall\u00e9e est un tiers-lieu abritant une communaut\u00e9 d\u2019artistes et d\u2019entrepreneurs cr\u00e9atifs, proposant une programmation culturelle pluridisciplinaire, ainsi que des espaces \u00e0 la location. \r\n\r\nUn espace dynamique et convivial gr\u00e2ce aux synergies entre ses diff\u00e9rents occupants, mais aussi \u00e0 sa programmation \u00e0 la fois qualitative et d\u00e9cal\u00e9e.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"LaVall\u00e9e","address_street_name":"Adolphe Lavall\u00e9e Straat","address_street_number":"39","address_street_box":null,"email":null,"website":"http:\/\/www.lavallee.brussels","phone_contact":"+32 491 71 43 65","phone_booking":null,"address_zip":"1080","address_city":"Sint-Jans-Molenbeek","address_line1":"Adolphe Lavall\u00e9e Straat, 39","address_line2":"1080 Sint-Jans-Molenbeek","description_web":"Deze voormalige industri\u00eble wasserij van 6.000 vierkante meter in Molenbeek is een ontmoetingsruimte die onderdak biedt aan een gemeenschap van kunstenaars en creatieve ondernemers, met een multidisciplinaire culturele programmatie en zaalverhuur. \r\n\r\nLaVall\u00e9e is een dynamische en gemoedelijke plek dankzij de kruisbestuivingen tussen de verschillende bewoners, maar ook dankzij de kwalitatieve en eigenzinnige programmering. ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"LaVall\u00e9e","address_street_name":"Adolphe Lavall\u00e9e Street","address_street_number":"39","address_street_box":null,"email":null,"website":"http:\/\/www.lavallee.brussels","phone_contact":"+32 491 71 43 65","phone_booking":null,"address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Adolphe Lavall\u00e9e Street, 39","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"LaVall\u00e