ccessible","Chien d'assistance","Parking accessible","Accessible aux pi\u00e9tons appareill\u00e9s","WC adapt\u00e9"],"nl":["Toegankelijk","Assistentiehonden","Toegankelijke parking","Toegankelijk voor voetgangers met hulpmiddelen","Aangepast toilet"],"en":["Accessible","Assistance dogs","Accessible parking","Accessible to pedestrians with mobility aids","Adapted toilet"],"de":["Barrierefrei","Assistenzhund","Barrierefreier Parkplatz","Barrierefrei f\u00fcr Fu\u00dfg\u00e4nger mit Gehhilfe","Barrierefreies WC"],"it":["Accessibile","Cane guida","Parcheggio accessibile","Accessibile ai pedoni con supporti","WC idoneo"],"sp":["Habilitado","Perros gu\u00eda","Estacionamiento habilitado","Habilitado para peatones con aud\u00edfonos","Ba\u00f1os adaptados"],"pt":[null,null,null,null,null],"cn":[null,null,null,null,null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2023-06-26T02:35:41+02:00","published_at":"2023-03-08T17:02:55+01:00","backoffice_id":273102,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.20107818794899},{"id":549961,"date_start":"2023-04-01","date_end":"2023-10-28","date_next":"2023-08-27","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen","it":"Visite guidate","sp":"Visitas guiadas","pt":null,"cn":null}},"others":{}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Visite guid\u00e9e de Bruxelles m\u00e9di\u00e9val","shortdescr":"Une visite le long de la premi\u00e8re enceinte de Bruxelles.","longdescr":"Parcours Bruxelles m\u00e9di\u00e9val : une visite guid\u00e9e qui vous propose de poser Un Autre Regard, d\u00e9cal\u00e9, sur le coeur historique de Bruxelles.\r\nDe l\u2019Histoire aux l\u00e9gendes, venez d\u00e9couvrir la ville au 13\u00e8me si\u00e8cle, au travers d\u2019un parcours in\u00e9dit, suivant le trac\u00e9 de la premi\u00e8re enceinte de la ville.\r\nVous prendrez conscience de l\u2019importance du r\u00f4le de la Senne dans le d\u00e9veloppement de la ville, la symbolique haut de la ville \u2013 bas de la ville, la distinction entre les trois pouvoirs m\u00e9di\u00e9vaux : duc, clerg\u00e9, bourgeois.\r\nUn parcours s\u00e9rieux pour apprendre l\u2019histoire de la ville.\r\nSans se prendre au s\u00e9rieux.\r\nAvec un guide bruxellois !","performers":"Vincent Beckers, guide touristique et r\u00e9gional","boxoffice_url":null,"website":"http:\/\/www.visiteguideebruxelles.be","email":"info@visiteguideebruxelles.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.549961"},"nl":{"name":"Visite guid\u00e9e de Bruxelles m\u00e9di\u00e9val","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.visiteguideebruxelles.be","email":"info@visiteguideebruxelles.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.549961"},"en":{"name":"Visite guid\u00e9e de Bruxelles m\u00e9di\u00e9val","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.visiteguideebruxelles.be","email":"info@visiteguideebruxelles.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.549961"},"de":{"name":"Visite guid\u00e9e de Bruxelles m\u00e9di\u00e9val","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.visiteguideebruxelles.be","email":"info@visiteguideebruxelles.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/