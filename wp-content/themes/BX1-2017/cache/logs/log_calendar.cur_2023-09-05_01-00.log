"2023-07-31T14:00:21+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":282507,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"tour","ranking":1.2599210498948732,"languages":{"spoken":["en","fr"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{"list":[255],"translations":{"de":["Besuche von Ausstellungen"],"pt":[null],"en":["Exhibition guided tours"],"it":["Visite a esposizioni"],"cn":[null],"fr":["Visites d'expositions"],"sp":["Visitas a las exposiciones"],"nl":["Tentoonstelling"]}}},"translations":{"de":{"name":"MUSOGYNIE","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/famefestival.be\/fr\/fame-event\/musogynie\/","email":"info@famefestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50000483"},"pt":{"name":"MUSOGYNIE","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/famefestival.be\/fr\/fame-event\/musogynie\/","email":"info@famefestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50000483"},"en":{"name":"MUSOGYNIE","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/famefestival.be\/fr\/fame-event\/musogynie\/","email":"info@famefestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50000483"},"it":{"name":"MUSOGYNIE","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/famefestival.be\/fr\/fame-event\/musogynie\/","email":"info@famefestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50000483"},"cn":{"name":"MUSOGYNIE","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/famefestival.be\/fr\/fame-event\/musogynie\/","email":"info@famefestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50000483"},"fr":{"name":"MUSOGYNIE, mus\u00e9e de la misogynie","shortdescr":"Visite guid\u00e9e de la collection d\u2019objets de MUSOGYNIE, un mus\u00e9e de la misogynie et de ses esth\u00e9tiques traditionnelles.","longdescr":"Objets et artefacts sur la f\u00e9tichisation des repr\u00e9sentations des corps de femmes trouvent leur place dans la collection de ce mus\u00e9e, \u00e0 la crois\u00e9e des disciplines : statues, imprim\u00e9s, bijoux, chansons, livres\u2026 Cette collection a \u00e9t\u00e9 fond\u00e9e en 2018 par M\u00e9lina Ghorafi et ne cesse de grandir depuis. Il s\u2019agit de se r\u00e9approprier les produits de la misogynie pour en d\u00e9samorcer sa violence. Cette collection est comme un mus\u00e9e du futur, rassemblant les vestiges d\u2019une misogynie d\u00e9sormais pass\u00e9e.\nLors de la visite, M\u00e9lina guidera le public dans un voyage collectif au c\u0153ur des objets composant MUSOGYNIE, retra\u00e7ant leurs histoires et origines. Elle propose de tisser une cartographie de cette violence syst\u00e9mique \u00e0 travers ses artefacts en examinant ensemble le contenu de la collection. Les objets serviront de supports d\u2019\u00e9changes et de discussions sur ces sujets.","performers":"M\u00e9lina Ghorafi","boxoffice_url":null,"website":"https:\/\/famefestival.be\/fr\/fame-event\/musogynie\/","email":"info@famefestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50000483"},"sp":{"name":"MUSOGYNIE","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/famefestival.be\/fr\/fame-event\/musogynie\/","email":"info@famefestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50000483"},"nl":{"name":"MUSOGYNIE","shortdescr":"Rondleiding door de collectie MUSOGYNIE, een museum over misogynie en haar traditionele esthetiek.","longdescr":"Voorwerpen en artefacten over de fetisjering van de representaties van vrouwenlichamen vinden hun plaats in de collectie van dit museum, op het kruispunt van disciplines: beelden, prenten, juwelen, liederen, boeken\u2026 \nDeze collectie werd in 2018 opgericht door Melina Ghorafi en blijft groeien sindsdien. Het gaat over het opnieuw toe-eigenen van de producten van misogynie om het geweld ervan te ontkrachten. Deze collectie is als een museum van de toekomst en brengt de overblijfselen van een misogynie die intussen voorbij is samen.\nTijdens het bezoek zal M\u00e9lina het publiek meenemen op een collectieve reis naar het hart van de voorwerpen waaruit MUSOGYNIE bestaat en hun geschiedenis en oorsprong herleiden. Ze stelt voor een cartografie van dit systematisch geweld te weven via de artefacten, door samen de inhoud van de collectie te onderzoeken. De objecten zullen dienen als medium voor uitwisseling en discussie over deze onderwerpen.\n","performers":null,"boxoffice_url":null,"website":"https:\/\/famefestival.be\/fr\/fame-event\/musogynie\/","email":"info@famefestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50000483"}},"place":{"id":1085,"translations":{"de":{"name":"Les Riches-Claires","address_street_name":"Rue des Riches Claires","address_street_number":"24","address_street_box":null,"email":"accueil@lesrichesclaires.be","website":"http:\/\/www.lesrichesclaires.be","phone_contact":"+32 2 548 25 80","phone_booking":"+32 2 548 25 80","address_zip":"1000"