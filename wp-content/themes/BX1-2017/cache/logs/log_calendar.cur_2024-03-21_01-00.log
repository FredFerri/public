":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wolubilis.be","email":"secretariat.atl@woluwe1200.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.559495"},"en":{"name":"\u00c9veil Musical Enfant-Parent","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wolubilis.be","email":"secretariat.atl@woluwe1200.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.559495"},"it":{"name":"\u00c9veil Musical Enfant-Parent","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wolubilis.be","email":"secretariat.atl@woluwe1200.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.559495"},"cn":{"name":"\u00c9veil Musical Enfant-Parent","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wolubilis.be","email":"secretariat.atl@woluwe1200.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.559495"},"fr":{"name":"\u00c9veil Musical Enfant-Parent","shortdescr":"Dans cet atelier d\u00e9di\u00e9 aux touts petits accompagn\u00e9s d'un parent, les enfants explorent de nouvelles sensations \u00e0 travers la d\u00e9couverte des sons. Gr\u00e2ce \u00e0 des activit\u00e9s ludiques et apaisantes, ils d\u00e9veloppent non seulement l'\u00e9coute et le toucher, mais \u00e9galement le sens de l'attention. ","longdescr":"Dans cet atelier d\u00e9di\u00e9 aux touts petits accompagn\u00e9s d'un parent, les enfants explorent de nouvelles sensations \u00e0 travers la d\u00e9couverte des sons. Gr\u00e2ce \u00e0 des activit\u00e9s ludiques et apaisantes, ils d\u00e9veloppent non seulement l'\u00e9coute et le toucher, mais \u00e9galement le sens de l'attention. C'est un moment de plaisir et de partage o\u00f9 l'on s'amuse avec son corps, sa voix, et des instruments de musique issus des quatre coins du monde. L'activit\u00e9 se d\u00e9roule pieds nus ou en chaussettes.\r\n\r\nLocal Th\u00e9atre \r\n\r\nPar Cecilia Pencanha\r\n\r\nD\u00e9s le 16 septembre de 9h30 \u00e0 10h30 \r\n\r\nLes dates : 16\/9, 30\/9, 14\/10, 4\/11, 18\/11, 2\/12, 16\/12, 13\/1, 27\/1, 10\/2, 9\/3, 23\/3, 6\/4, 20\/4, 18\/5","performers":"Par Cecilia Pencanha","boxoffice_url":null,"website":"http:\/\/www.wolubilis.be","email":"secretariat.atl@woluwe1200.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.559495"},"sp":{"name":"\u00c9veil Musical Enfant-Parent","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wolubilis.be","email":"secretariat.atl@woluwe1200.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.559495"},"nl":{"name":"\u00c9veil Musical Enfant-Parent","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wolubilis.be","email":"secretariat.atl@woluwe1200.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.559495"}},"place":{"id":220532,"translations":{"de":{"name":"Centre Culturel Wolubilis","address_street_name":"Cours Paul-Henri Spaak","address_street_number":"1","address_street_box":null,"email":"secretariat.atl@woluwe1200.be","website":"http:\/\/www.wolubilis.be","phone_contact":"+32 2 761 60 29","phone_booking":"+32 2 761 60 30","address_zip":"1200","address_city":"Woluwe-Saint-Lambert","address_line1":"Cours Paul-Henri Spaak, 1","address_line2":"1200 Woluwe-Saint-Lambert","description_web":null,"description_print":null,"booking_url":null,"sort_order