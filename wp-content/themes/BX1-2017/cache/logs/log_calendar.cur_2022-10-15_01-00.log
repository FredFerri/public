_id":null,"backoffice_id":422,"location":{"lat":50.85312505,"lon":4.35539915},"region":"brussels","last_updated_at":"2022-10-11T01:36:47+02:00","published_at":"2013-10-19T01:13:31+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/explore-6f3917d071b4ec7b2741f4500a20a0b8b2da8797.jpg","width":999,"height":1500,"ratio":0.67,"translations":{"fr":{"title":"\u00c0 la d\u00e9couverte de l'Art D\u00e9co dans le nord de Bruxelles","copyright":null},"nl":{"title":"\u00c0 la d\u00e9couverte de l'Art D\u00e9co dans le nord de Bruxelles","copyright":null},"en":{"title":"\u00c0 la d\u00e9couverte de l'Art D\u00e9co dans le nord de Bruxelles","copyright":null}}}],"dates":[{"day":"2022-10-30","doors":null,"start":"14:00:00","end":"16:00:00","is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":10},{"translations":{"fr":{"name":"Article 27"},"nl":{"name":"Artikel 27"},"en":{"name":"Article 27"}},"value":1.25}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"visit_profile":{"list":[322],"translations":{"fr":["Art Nouveau & Art D\u00e9co"],"nl":["Art nouveau & art deco"],"en":["Art Nouveau &  Art D\u00e9co"],"de":["Jugendstil & Art d\u00e9co"]}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-11T01:36:48+02:00","published_at":"2022-04-03T03:30:25+02:00","backoffice_id":250795,"import_origin":"explore","sub_type":"other","show_in_agenda":true,"ranking":1},{"id":542184,"date_start":"2022-10-30","date_end":"2022-10-30","date_next":"2022-10-30","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":57,"translations":{"fr":"Clubbing","nl":"Clubbing","en":"Clubbing","de":"Clubbing"}},"others":{}},"languages":{"spoken":["en","nl","fr"],"subtitles":[]},"translations":{"fr":{"name":"Th\u00e9 Dansant Dia de los Muertos Fluo","shortdescr":"Animation et d\u00e9coration Dia de los muertos et maquillage gratuit \u00e0 l'entr\u00e9e. Touche en plus : fluo ! \r\n\r\nIl y aura \u00e9galement un autel traditionnel Dia de los Muertos avec des fleurs et de l'encens o\u00f9 vous pourrez laisser une photo d'un ami ou famille qui est d\u00e9c\u00e9d\u00e9 pour comm\u00e9morer cette personne.","longdescr":"Le concept de soir\u00e9es d\u00e9guis\u00e9es Th\u00e9 Dansant, qui invite les passionn\u00e9s d'\u00e9lectronique dans des lieux insolites les dimanches apr\u00e8s-midi, organise Th\u00e9 Dansant Dia de los Muertos au Silo Bruxelles pour la 2e ann\u00e9e cons\u00e9cutive. Silo Brussels est une ancienne brasserie qui surprend les visiteurs par son c\u00f4t\u00e9 industriel, m\u00e9lange de vieilles briques, d'acier et de b\u00e9ton et, en plus, une grande terrasse avec vue sur le canal et Bruxelles.\r\n\r\nD\u00eda de Muertos, le jour des morts, est une c\u00e9l\u00e9bration mexicaine qui c\u00e9l\u00e8bre la vie de ceux qui ne sont plus l\u00e0. Pour cette \u00e9dition, Th\u00e9 Dansant invite tous les visiteurs \u00e0 s'habiller dans le style Dia de los Muertos avec des cr\u00e2nes, des fleurs et des tenues color\u00e9es.\r\n\r\nUne s\u00e9lection des meilleurs artistes bruxellois, ainsi que des DJ de renomm\u00e9e nationale et la t\u00eate d'affiche internationale du label Afterlife, joueront dans la salle principale. Dans la 2\u00e8me salle, la house plus funky est pr\u00e9sent\u00e9e avec le concept WeZienWel et t\u00eate d'affiche dj f\u00e9minin de Defected in the house (UK) ! Un boisson 'day of the dead' fratuit avant 15h.","performers":"Main: Citizen Kain (Afterlife, FR), Caspar - Be & Don Cabron, Lola Jones, Belben, Tumzz, Sylphomatic \r\nHouse hosted by Wezienwel: Paige Tomlinson (Defected Records, UK), Jeroen Delodder - Sheridan, WLC & Mona Lee, Forbidden Fruit (live), MDC. (live), Maeyer b2b Dexter manuel","boxoffice_url":null,"website":"https:\/\/www.facebook.com\/events\/499171471966481","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.542184"},"nl":{"name":"Th\u00e9 Dansant Dia de los Muertos Fluo","shortdescr":"Dia de los muertos animatie en decoratie plus gratis make-up aan de inkom. Extra touch: fluo! Fluorescerende hallogeen-lampen en je eigen outfit plus make-up zullen voor een kleurrijk schouwspel zorgen! \r\n\r\nEr zal ook een traditioneel Dia de los Muertos altaar zijn met bloemen en wierook waar je een foto van een dierbare overledene kan achterlaten om deze persoon te herdenken.","longdescr":"Het verkleed feestconcept Th\u00e9 Dansant dat elektronische liefhebbers uitnodigt op unieke locaties op zondagnamiddagen, organiseert voor het 2e jaar op rij Th\u00e9 Dansant Dia de los Muertos in Silo Brussels. Silo Brussels is een oude brouwerij die de bezoekers verrast met zijn industri\u00eble kant, een mix van oude bakstenen, staal en beton en als extra een groot terras met zicht op het kanaal en Brussel. \r\n\r\nD\u00eda de Muertos, de Dag van de Doden, is een Mexicaans feest waarbij het leven van hen die er niet meer zijn feestelijk wordt herdacht. Th\u00e9 Dansant nodigt voor deze editie dan ook alle bezoekers uit hen te kleden in Dia de los Muertos stijl met doodskoppen, bloemen & kleurrijke outfits. \r\n\r\nIn de grote zaal speelt een selectie van Brusselse top-dus plus nationaal bekende djs en internationale headliner van het Afterlife label. In de 2e zaal wordt de meer funky house gebracht met het concept WeZienWel en headliner van Defected in the house (UK)! Gratis Day of the dead drankje voor 15u.","performers":"Main: Citizen Kain (Afterlife, FR), Caspar - Be & Don Cabron, Lola Jones, Belben, Tumzz, Sylphomatic \r\nHouse hosted by Wezienwel: Paige Tomlinson (Defected Records, UK), Jeroen Delodder - Sheridan, WLC & Mona Lee, Forbidden Fruit (live), MDC. (live), Maeyer b2b Dexter manuel","boxoffice_url":null,"website":"http:\/\/www.thedansant.party","email":"sundayafternoonparties@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.542184"},"en":{"name":"Th\u00e9 Dansant Dia de los Muertos Fluo","shortdescr":"Dia de los muertos animation and decoration plus free make-up at the entrance. Extra touch: fluorescent! Fluorescent halogen lamps and your own outfit plus make-up will make for a colorful spectacle!\r\n\r\nThere will also be a traditional Dia de los Muertos altar with flowers and incense where you can leave a photo of family or friend that passed away to commemorate this person.","longdescr":"The fancy dresscode party concept Th\u00e9 Dansant, which invites electronic enthusiasts to unique locations on Sunday afternoons, is organizing Th\u00e9 Dansant Dia de los Muertos in Silo Brussels for the 2nd year in a row. Silo Brussels is an old brewery that surprises visitors with its industrial side, a mix of old bricks, steel and concrete and, in addition, a large terrace with a view of the canal and Brussels.\r\n\r\nD\u00eda de Muertos, the Day of the Dead, is a Mexican celebration that celebrates the lives of those who are no longer there. For this edition, Th\u00e9 Dansant invites all visitors to dress in Dia de los Muertos style with skulls, flowers & colorful outfits.\r\n\r\nA selection of top Brussels artists, plus nationally known DJs and international headliner from the Afterlife label, will play in the main hall. In the 2nd room, the more funky house is presented with the concept WeZienWel and headliner of Defected in the house (UK)! One free day of the dead drink before 15h","performers":"Main: Citizen Kain (Afterlife, FR), Caspar - Be & Don Cabron, Lola Jones, Belben, Tumzz, Sylphomatic \r\nHouse hosted by Wezienwel: Paige Tomlinson (Defected Records, UK), Jeroen Delodder - Sheridan, WLC & Mona Lee, Forbidden Fruit (live), MDC. (live), Maeyer b2b Dexter manuel","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.542184"},"de":{"name":"Th\u00e9 Dansant Dia de los Muertos Fluo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.542184"},"it":{"name":"Th\u00e9 Dansant Dia de los Muertos Fluo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.542184"},"sp":{"name":"Th\u00e9 Dansant Dia de los Muertos Fluo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.542184"},"pt":{"name":"Th\u00e9 Dansant Dia de los Muertos Fluo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.542184"},"cn":{"name":"Th\u00e9 Dansant Dia de los Muertos Fluo","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.542184"}},"place":{"id":277206,"translations":{"fr":{"name":"Silo Brussels","address_street_name":"Rue de Meudon","address_street_number":"54","address_street_box":null,"email":"event@silo.br