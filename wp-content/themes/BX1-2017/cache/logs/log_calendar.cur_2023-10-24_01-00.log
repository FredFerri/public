":"+32 2 240 34 99","phone_booking":"+32 2 240 34 99","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50000591"},"en":{"name":"MEET THE CURATOR","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/lamaisondesarts.be\/meet-the-curator-dressing\/","email":"info@lamaisondesarts.be","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 99","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50000591"},"it":{"name":"MEET THE CURATOR","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/lamaisondesarts.be\/meet-the-curator-dressing\/","email":"info@lamaisondesarts.be","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 99","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50000591"},"cn":{"name":"MEET THE CURATOR","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/lamaisondesarts.be\/meet-the-curator-dressing\/","email":"info@lamaisondesarts.be","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 99","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50000591"},"fr":{"name":"MEET THE CURATOR","shortdescr":"VISITE GUID\u00c9E EN DUO DE L\u2019EXPO DRESSING","longdescr":"\nAnne-C\u00e9cile Mar\u00e9chal, responsable de la programmation artistique \u00e0 la Maison des Arts et Aline Wachtelaer, archiviste \u00e0 l\u2019administration communale de Schaerbeek, vous proposent une visite guid\u00e9e en duo, un dialogue entre \u0153uvres contemporaines et collection communale.\n\nInfos pratiques\n\n15. 10 & 26.11\n11:00 > 12:30\nPrix: 5\u20ac. R\u00e9servation obligatoire.","performers":null,"boxoffice_url":null,"website":"http:\/\/lamaisondesarts.be\/meet-the-curator-dressing\/","email":"info@lamaisondesarts.be","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 99","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50000591"},"sp":{"name":"MEET THE CURATOR","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/lamaisondesarts.be\/meet-the-curator-dressing\/","email":"info@lamaisondesarts.be","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 99","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50000591"},"nl":{"name":"MEET THE CURATOR","shortdescr":"DUOBEZOEK VAN DE TENTOONSTELLING DRESSING","longdescr":"Duobezoek met Anne-C\u00e9cile Mar\u00e9chal, verantwoordelijk voor de artiestieke programmering in la Maison des Arts en Aline Wachtelaer, archivaris bij het gemeentebestuur van Schaarbeek.\n\nEen dialoog tussen hedendaagse kunstwerken en de collectie van de gemeente. Tegelijkertijd wordt er ook een Nederlandstalig bezoek aangeboden (26\/11).\n\nInfo\n\n26.11 (FR\/NL)\n11:00 > 12:30\nPrijs: 5\u20ac. Reservatie verplicht.","performers":null,"boxoffice_url":null,"website":"http:\/\/lamaisondesarts.be\/meet-the-curator-dressing\/","email":"info@lamaisondesarts.be","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 99","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50000591"}},"place":{"id":222932,"translations":{"de":{"name":"Maison des Arts","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 147","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Maison des Arts","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 147","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Maison des Arts","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 147","address_line2":"1030 Schaerbeek","description_web":"The MdA is run and staffed by the Francophone Cultural Service of Schaerbeek Council and is a unique place whose activities are mainly concerned with the creation of works of contemporary art with a significant partnership programme that promotes access for all to contemporary art.\r\n\r\nThe MdA has hosted a rich programme of artistic activities since the 1950s when the building was purchased by Schaerbeek Council. In 2005, the MdA began a programme of inviting artists to work in building, to build more coherence between their works of art and the MdA.\r\n\r\nMost recently, in 2016, Schaerbeek Council decided to position the MdA as a centre for the creation, diffusion and promotion of culture, contemporary two-dimensional, three-dimensional and digital art.\r\nThe MdA\u2019s educational and social approach aims to promoting equality of access to art and its introduction to new audiences.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Maison des Arts","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 147","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Maison des Arts","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 147","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"fr":{"name":"Maison des Arts","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 147","address_line2":"1030 Schaerbeek","description_web":"La Maison des Arts, anim\u00e9e par le Service Culture fran\u00e7aise de la Commune de Schaerbeek, est un espace singulier dont les activit\u00e9s sont principalement ax\u00e9es sur la cr\u00e9ation contemporaine dans le domaine des arts plastiques avec un important programme de m\u00e9diation permettant l\u2019acc\u00e8s de l\u2019art contemporain \u00e0 tous.\r\n\r\nLa MA conna\u00eet une riche activit\u00e9 artistique depuis les ann\u00e9es \u201950, \u00e9poque \u00e0 laquelle la commune rach\u00e8te le b\u00e2timent. En 2005, elle se voit prendre un premier tournant en proposant aux artistes de travailler in situ, afin d\u2019\u00e9tablir une r\u00e9elle coh\u00e9rence entre l\u2019\u0153uvre et la Maison.\r\nEt finalement, c\u2019est en 2016 que la Commune de Schaerbeek d\u00e9cide de la positionner dans le domaine des arts plastiques, contemporains et num\u00e9riques comme un lieu de cr\u00e9ation, de diffusion et de rayonnement culturel.\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Maison des Arts","address_street_name":"Chauss\u00e9e de Haecht","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Chauss\u00e9e de Haecht, 147","address_line2":"1030 Schaerbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Huis der Kunsten","address_street_name":"Haachtsesteenweg","address_street_number":"147","address_street_box":null,"email":"info@lamaisondesarts.be","website":"http:\/\/www.lamaisondesarts.be\/","phone_contact":"+32 2 240 34 99","phone_booking":"+32 2 240 34 85","address_zip":"1030","address_city":"Schaerbeek","address_line1":"Haachtsesteenweg, 147","address_line2":"1030 Schaerbeek","description_web":"La Maison des Arts, geanimeerd door de dienst Franstalige Cultuur van de gemeente Schaarbeek, is een heel bijzondere plek. De activiteiten zijn vooral gericht op hedendaagse creativiteit in de plastische kunsten.\r\n\r\nIn La Maison des Arts heerst reeds sedert 1950 ( datum waarop de gemeente het huis aankocht) een ruime artistieke activiteit. In 2005 is er een belangrijke ontwikkeling : het voorstel aan de kunstenaars om ter plaatse te werken, teneinde een echte samenhang te bereiken tussen het werk en het Huis. Uiteindelijk beslist de Gemeente Schaarbeek er een echte broeikast van te maken in het domein van de beeldende kunsten, een bron van schepping, verspreiding en culturele uitstraling.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[],"