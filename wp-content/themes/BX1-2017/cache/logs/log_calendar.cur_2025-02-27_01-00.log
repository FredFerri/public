scr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/cactus.brussels\/tours-velo-publiques","email":"info@cactus.brussels","phone_contact":null,"phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700005784"},"en":{"name":"Guided Bike Tour 'Brussels highlights & hidden gems'","shortdescr":"Discover Brussels by bike during our Highlights & Hidden Gems guided bike tour","longdescr":"Explore the City of Brussels and its charming surrounding towns on a captivating 3h30 guided tour. Our local guides unveil both the iconic landmarks and hidden gems nestled along the lesser-known paths. Get immersed in the rich history and culture of this cosmopolitan city as you experience Brussels in a delightfully engaging way. Let yourself be amazed by the lesser beaten tracks winding through Brussels and its lively neighborhoods. \nHalf-way we'll make a pit stop at a cozy caf\u00e9, offering the perfect opportunity to connect with fellow travelers and savor the local ambiance. \nJoin us for an unforgettable Brussels experience on two wheels! Discover our availability on our website. ","performers":null,"boxoffice_url":null,"website":"https:\/\/cactus.brussels\/bike-tours-brussels","email":"info@cactus.brussels","phone_contact":null,"phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700005784"},"it":{"name":"Guided Bike Tour 'Brussels highlights & hidden gems'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/cactus.brussels\/tours-velo-publiques","email":"info@cactus.brussels","phone_contact":null,"phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700005784"},"cn":{"name":"Guided Bike Tour 'Brussels highlights & hidden gems'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/cactus.brussels\/tours-velo-publiques","email":"info@cactus.brussels","phone_contact":null,"phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700005784"},"fr":{"name":"Visite guid\u00e9e \u00e0 v\u00e9lo 'Bruxelles, les incontournables et insolites'","shortdescr":"D\u00e9couvrez Bruxelles \u00e0 v\u00e9lo lors de notre visite guid\u00e9e 'les incontournables et insolites de Bruxelles'. ","longdescr":"Explorez Bruxelles \u00e0 v\u00e9lo. Une aventure captivante de 3,5 heures pendant laquelle vous plongez au c\u0153ur de Bruxelles en compagnie de nos guides locaux passionn\u00e9s. Laissez-vous guider \u00e0 travers les joyaux cach\u00e9s, les sites embl\u00e9matiques de la ville et immergez-vous dans son histoire fascinante. \nD\u00e9couvrez Bruxelles de mani\u00e8re ludique et immersive, en d\u00e9nichant des tr\u00e9sors m\u00e9connus et en explorant ses quartiers dynamiques. \nA mi-chemin, une pause en pr\u00e9vue dans un caf\u00e9 sympa. Le moment de mieux connaitre les autres voyageurs et de profiter de l'atmosph\u00e8re locale. \nR\u00e9servez d\u00e8s maintenant votre place pour une aventure bruxelloise inoubliable \u00e0 v\u00e9lo ! D\u00e9couvrez nos disponibilit\u00e9s sur notre site web. ","performers":null,"boxoffice_url":null,"website":"https:\/\/cactus.brussels\/tours-velo-publiques","email":"info@cactus.brussels","phone_contact":null,"phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700005784"},"sp":{"name":"Guided Bike Tour 'Brussels highlights & hidden gems'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/cactus.brussels\/tours-velo-publiques","email":"info@cactus.brussels","phone_contact":null,"phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700005784"},"nl":{"name":"Gegidste fietstocht 'Highlights & minder betreden paden van Brussel'","shortdescr":"Ontdek Brussel langs de highlights en minder betreden paden met de fiets!","longdescr":"Beleef Brussel tijdens een onvergetelijke fietstour van 3,5 uur, waarbij onze lokale gidsen zowel de iconische als verborgen bezienswaardigheden onthullen. \nDuik in de rijke geschiedenis en cultuur van deze kosmopolitische stad en ontdek Brussel op een leuke en verrijkende manier. Laat je verrassen door de minder betreden paden van Brussel en haar diverse bruisende wijken. Onderweg pauzeren we in een gezellige caf\u00e9, ontmoet je andere reizigers en geniet je van de lokale sfeer. \nBoek nu je plek voor een onvergetelijk Brussels avontuur met de fiets! Ontdek onze beschikbaarheden op onze website!","performers":null,"boxoffice_url":null,"website":"https:\/\/cactus.brussels\/brussel-met-de-fiets","email":"info@cactus.brussels","phone_contact":null,"phone_booking":"+32 497 19 07 14","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700005784"}},"place":{"id":277608,"translations":{"de":{"name":"Cactus Brussel \u00e0 v\u00e9lo","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"info@cactus.brussels","website":"https:\/\/cactus.brussels\/","phone_contact":"+32 497 19 07 14","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 7","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Cactus Brussel \u00e0 v\u00e9lo","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"info@cactus.brussels","website":"https:\/\/cactus.brussels\/","phone_contact":"+32 497 19 07 14","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 7","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Cactus Brussel \u00e0 v\u00e9lo","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"info@cactus.brussels","website":"https:\/\/cactus.brussels\/","phone_contact":"+32 497 19 07 14","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue du Grand Hospice, 7","address_line2":"1000 Brussels","description_web":"Cactus Brussel \u00e0 v\u00e9lo is an association of local volunteer guides with a passion for Brussels and cycling. They enthusiastically share their passion for the city and cycling with visitors to Brussels and other Brussels residents. On their bikes they find the right pace to immerse you in the city and offer an authentic Brussels experience. Above all, they prefer to guide you off the beaten track in a friendly atmosphere. Experience Brussels in all its splendour by bike and discover more than you think.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Cactus Brussel \u00e0 v\u00e9lo","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"info@cactus.brussels","website":"https:\/\/cactus.brussels\/","phone_contact":"+32 497 19 07 14","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 7","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Cactus Brussel \u00e0 v\u00e9lo","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"info@cactus.brussels","website":"https:\/\/cactus.brussels\/","phone_contact":"+32 497 19 07 14","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 7","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Cactus Brussel \u00e0 v\u00e9lo","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"info@cactus.brussels","website":"https:\/\/cactus.brussels\/","phone_contact":"+32 497 19 07 14","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 7","address_line2":"1000 Bruxelles","description_web":"Cactus Brussel \u00e0 v\u00e9lo est une association de guides b\u00e9n\u00e9voles locaux ayant \u00e0 c\u0153ur Bruxelles et le v\u00e9lo. Ils partagent avec enthousiasme leur passion pour la ville et le v\u00e9lo avec des visiteurs de Bruxelles et d\u2019autres Bruxellois. A v\u00e9lo ils trouvent le rythme id\u00e9al pour vous immerger dans la ville et ils offrent une exp\u00e9rience authentique \u00e0 Bruxelles. Avant tout, ils pr\u00e9f\u00e8rent vous guider hors des chemins battus et cela dans une ambiance conviviale. Vivez Bruxelles dans toute sa splendeur \u00e0 v\u00e9lo et d\u00e9couvrez plus que vous ne le pensez.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Cactus Brussel \u00e0 v\u00e9lo","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"info@cactus.brussels","website":"https:\/\/cactus.brussels\/","phone_contact":"+32 497 19 07 14","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 7","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Cactus Brussel \u00e0 v\u00e9lo","address_street_name":"Grootgodshuisstraat","address_street_number":"7","address_street_box":null,"email":"info@cactus.brussels","website":"http: