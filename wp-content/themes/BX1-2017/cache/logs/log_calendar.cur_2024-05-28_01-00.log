":"http:\/\/www.muntpunt.be","phone_contact":"+32 2 278 11 11","phone_booking":"+32 2 278 11 11","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Monnaie, 6","address_line2":"1000 Bruxelles","description_web":"Muntpunt est une biblioth\u00e8que, un lieu d'information et de rencontres. Laissez-vous inspirer par des livres, des histoires et des rencontres adapt\u00e9es \u00e0 la capitale. Apprenez tout sur le travail, les \u00e9tudes, et la vie \u00e0 Bruxelles et en Flandre. D\u00e9couvrez la richesse de l' offre culturelle n\u00e9erlandophone des organisations bruxelloises et flamandes.  ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Muntpunt","address_street_name":"Place de la Monnaie","address_street_number":"6","address_street_box":null,"email":"info@muntpunt.be","website":"http:\/\/www.muntpunt.be","phone_contact":"+32 2 278 11 11","phone_booking":"+32 2 278 11 11","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Monnaie, 6","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Muntpunt ","address_street_name":"Muntplein","address_street_number":"6","address_street_box":null,"email":"info@muntpunt.be","website":"http:\/\/www.muntpunt.be","phone_contact":"+32 2 278 11 11","phone_booking":"+32 2 278 11 11","address_zip":"1000","address_city":"Brussel","address_line1":"Muntplein, 6","address_line2":"1000 Brussel","description_web":"Muntpunt is een bibliotheek, informatiehuis, ontmoetingsplek en je venster op Brussel. Laat je inspireren door boeken, verhalen en ontmoetingen op maat van de hoofdstad. Kom meer te weten over wonen, werken, studeren, leven en beleven in Brussel en Vlaanderen. Ontdek het rijke Nederlandstalige culturele en vrijetijdsaanbod van Brusselse en Vlaamse organisaties.\r\n\r\nIn Muntpunt kan je meer dan alleen boeken, cd\u2019s en dvd\u2019s ontlenen. Je kan er ook terecht voor activiteiten, taalcursussen, infosessies, luisterboeken, strips, spelletjes, en nog veel meer. Er valt bijna dagelijks iets te beleven in Muntpunt, van voorlezen tot documentaires, van infosessies tot rondleidingen, voor jong en oud. De activiteiten sluiten aan bij de bibliotheekwerking of spelen in op actuele thema's, steeds met de Brusselse hoofdstedelijke context in het achterhoofd. De rode draad door de programmatie is de samenwerking met Vlaamse en Brusselse partnerorganisaties. \r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":13020,"location":{"lat":50.84996484,"lon":4.35348679},"is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/1710218556896-muntpunt-00b7129241ef135f674fe6f8b4daa1c2b8ca3e3b.jpg","width":2250,"height":2250,"ratio":1,"oEmbed_height":2250,"oEmbed_width":2250,"translations":{"de":{"title":"Muntpunt Schaakclub","copyright":null},"pt":{"title":"Muntpunt Schaakclub","copyright":null},"en":{"title":"Muntpunt Schaakclub","copyright":null},"it":{"title":"Muntpunt Schaakclub","copyright":null},"cn":{"title":"Muntpunt Schaakclub","copyright":null},"fr":{"title":"Muntpunt Schaakclub","copyright":null},"sp":{"title":"Muntpunt Schaakclub","copyright":null},"nl":{"title":"Muntpunt Schaakclub","copyright":null}}}],"dates":[{"day":"2024-05-29","doors":null,"start":"16:00:00","end":"19:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"de":{"name":"Normal"},"en":{"name":"Normal"},"it":{"name":"Normale"},"fr":{"name":"Normal"},"sp":{"name":"Normal"},"nl":{"name":"Normaal"}},"value":0}],"date_exceptions":[],"closing_days":[],"child_events":[],"parent_events":[],"accessibilities":[],"recurring"