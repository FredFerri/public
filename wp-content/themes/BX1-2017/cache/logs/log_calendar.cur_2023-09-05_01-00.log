rios"],"nl":["Wijken"]}}},"translations":{"de":{"name":"Brussels by Night | Vorst & Sint-Gillis","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/cactus.brussels\/brussels-by-night","email":"info@cactus.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50001727"},"pt":{"name":"Brussels by Night | Vorst & Sint-Gillis","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/cactus.brussels\/brussels-by-night","email":"info@cactus.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50001727"},"en":{"name":"Brussels by Night | Vorst & Sint-Gillis","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/cactus.brussels\/brussels-by-night","email":"info@cactus.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50001727"},"it":{"name":"Brussels by Night | Vorst & Sint-Gillis","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/cactus.brussels\/brussels-by-night","email":"info@cactus.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50001727"},"cn":{"name":"Brussels by Night | Vorst & Sint-Gillis","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/cactus.brussels\/brussels-by-night","email":"info@cactus.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50001727"},"fr":{"name":"Brussels by Night |  Forest & Saint-Gilles","shortdescr":"D\u00e9couvrez Forest & Saint-Gilles et leurs diff\u00e9rents quartiers et lieux embl\u00e9matiques au cr\u00e9puscule \u00e0 v\u00e9lo. ","longdescr":"D\u00e9couvrez Forest & Saint-Gilles et leurs diff\u00e9rents quartiers et lieux embl\u00e9matiques au cr\u00e9puscule \u00e0 v\u00e9lo. Des endroits qui sont particuli\u00e8rement charmants \u00e0 la tomb\u00e9e de la nuit, des panoramas magnifiques, des lumi\u00e8res f\u00e9eriques et, qui sait, un beau coucher de soleil.\n\nUn tour \u00e0 v\u00e9lo le long des sentiers moins battus d'environ 16 km. Nous ferons quelques arr\u00eats en cours de route, mais nous vous ferons surtout vivre la ville \u00e0 v\u00e9lo la nuit. Une petite pause est pr\u00e9vue pour un petit stop ap\u00e9ro!\n\nTarif: \u20ac 6\nD\u00e9part et arriv\u00e9 au Grand Hospice, 1000 Bruxelles\nLangue: Fran\u00e7ais\/N\u00e9erlandais\nV\u00e9los disponibles\nInformations et r\u00e9servations ==> info@cactus.brussels\n","performers":null,"boxoffice_url":null,"website":"https:\/\/cactus.brussels\/brussels-by-night","email":"info@cactus.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50001727"},"sp":{"name":"Brussels by Night | Vorst & Sint-Gillis","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/cactus.brussels\/brussels-by-night","email":"info@cactus.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50001727"},"nl":{"name":"Brussels by Night | Vorst & Sint-Gillis","shortdescr":"Ontdek Vorst en Sint-Gillis en hun verschillende wijken in het avondlicht met de fiets!","longdescr":"Ontdek Vorst en Sint-Gillis en hun verschillende wijken in het avondlicht met de fiets! Plekken en wijken die bijzonder charmant zijn bij avondschemering, met prachtige panorama's en magische lichtjes en, wie weet, een mooie zonsondergang.\n\nEen fietstocht langs minder betreden paden van ongeveer 16km. We maken een paar stops onderweg, maar we willen je vooral de stad 's avonds al fietsend laten beleven. Een korte pauze voor een aperitief is voorzien!\n\nPrijs: \u20ac 6\nVertrek en aankomst in het Grand Hospice, 1000 Brussel\nTaal: Frans\/Nederlands\nFietsen beschikbaar\nInformatie en reservaties: info@cactus.brussels","performers":null,"boxoffice_url":null,"website":"https:\/\/cactus.brussels\/brussels-by-night","email":"info@cactus.brussels","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50001727"}},"place":{"id":277608,"translations":{"de":{"name":"Cactus Brussel \u00e0 v\u00e9lo","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"info@cactus.brussels","website":"http:\/\/www.cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 7","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Cactus Brussel \u00e0 v\u00e9lo","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"info@cactus.brussels","website":"http:\/\/www.cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 7","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Cactus Brussel \u00e0 v\u00e9lo","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"info@cactus.brussels","website":"http:\/\/www.cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 7","address_line2":"1000 Bruxelles","description_web":"Cactus Brussel \u00e0 v\u00e9lo is an association of local volunteer guides with a passion for Brussels and cycling. They enthusiastically share their passion for the city and cycling with visitors to Brussels and other Brussels residents. On their bikes they find the right pace to immerse you in the city and offer an authentic Brussels experience. Above all, they prefer to guide you off the beaten track in a friendly atmosphere. Experience Brussels in all its splendour by bike and discover more than you think.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Cactus Brussel \u00e0 v\u00e9lo","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"info@cactus.brussels","website":"http:\/\/www.cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 7","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Cactus Brussel \u00e0 v\u00e9lo","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"info@cactus.brussels","website":"http:\/\/www.cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 7","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"fr":{"name":"Cactus Brussel \u00e0 v\u00e9lo","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"info@cactus.brussels","website":"http:\/\/www.cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 7","address_line2":"1000 Bruxelles","description_web":"Cactus Brussel \u00e0 v\u00e9lo est une association de guides b\u00e9n\u00e9voles locaux ayant \u00e0 c\u0153ur Bruxelles et le v\u00e9lo. Ils partagent avec enthousiasme leur passion pour la ville et le v\u00e9lo avec des visiteurs de Bruxelles et d\u2019autres Bruxellois. A v\u00e9lo ils trouvent le rythme id\u00e9al pour vous immerger dans la ville et ils offrent une exp\u00e9rience authentique \u00e0 Bruxelles. Avant tout, ils pr\u00e9f\u00e8rent vous guider hors des chemins battus et cela dans une ambiance conviviale. Vivez Bruxelles dans toute sa splendeur \u00e0 v\u00e9lo et d\u00e9couvrez plus que vous ne le pensez.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Cactus Brussel \u00e0 v\u00e9lo","address_street_name":"Rue du Grand Hospice","address_street_number":"7","address_street_box":null,"email":"info@cactus.brussels","website":"http:\/\/www.cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Grand Hospice, 7","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Cactus Brussel \u00e0 v\u00e9lo","address_street_name":"Grootgodshuisstraat","address_street_number":"7","address_street_box":null,"email":"info@cactus.brussels","website":"http:\/\/www.cactus.brussels","phone_contact":"+32 497 19 07 14","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Grootgodshuisstraat, 7","address_line2":"1000 Bruxelles","description_web":"Cactus Brussel \u00e0 v\u00e9lo is een vereniging van lokale vrijwillige gidsen met een passie voor Brussel en de fiets. Ze delen hun passie voor de stad en het fietsen enthousiast met bezoekers van Brussel en andere Brusselaars. Op hun fietsen vinden ze het juiste tempo om u onder te dompelen in de stad en u een authentieke Brusselse ervaring te bieden. Bovenal begeleiden ze jullie graag buiten de gebaande paden in een vrie