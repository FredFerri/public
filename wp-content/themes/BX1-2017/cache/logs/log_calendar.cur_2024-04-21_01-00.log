ries":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[27,24],"translations":{"de":["Fotografie","Kunstgalerien"],"pt":[null,null],"en":["Photography","Art Galleries"],"it":["Fotografia","Gallerie d'arte"],"cn":[null,null],"fr":["Photographie","Galeries d'art"],"sp":["Fotograf\u00eda","Galer\u00edas de arte"],"nl":["Fotografie","Galeries"]}}},"translations":{"de":{"name":"Temporary views","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"cg.brussels@mzv.sk","phone_contact":"+32 488 33 10 21","phone_booking":"+32 488 33 10 21","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50009617"},"pt":{"name":"Temporary views","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"cg.brussels@mzv.sk","phone_contact":"+32 488 33 10 21","phone_booking":"+32 488 33 10 21","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50009617"},"en":{"name":"Temporary views","shortdescr":"The Temporary views project explores the constants and variables of the Belgian North Sea coast. It creates a multi-layered visual story of the interaction of nature and man on one of the most unique and at the same time the most vulnerable coasts of Europe.","longdescr":"No area of Belgium has undergone such a radical process of transformation as the North Sea coast. This transformation is a story of demolition, construction, reconstruction in an effort to withstand the elements and respond to the challenges of the economy, transport, fishing, and above all tourism. Ecological, economic and industrial challenges meet here with the amazement or admiration of visitors, the carefreeness of tourists, and the nostalgia of old settlers. In the rhythm of the tides, everything is connected by an endless tide, on a unique background where the border between the sea and the sky blurs.","performers":"Diana Takacsova (*1992), a photographer from Slovakia living in Ostend, Belgium, will present her view of the Belgian coast of the North Sea. She mainly works on long-term, research-based projects. In her work, she explores themes related to identity, physical and emotional attachment to a place, migration, and the relationship of man to nature and the environment. (https:\/\/www.diatakacsova.com\/)","boxoffice_url":null,"website":null,"email":"cg.brussels@mzv.sk","phone_contact":"+32 488 33 10 21","phone_booking":"+32 488 33 10 21","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50009617"},"it":{"name":"Temporary views","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"cg.brussels@mzv.sk","phone_contact":"+32 488 33 10 21","phone_booking":"+32 488 33 10 21","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50009617"},"cn":{"name":"Temporary views","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"cg.brussels@mzv.sk","phone_contact":"+32 488 33 10 21","phone_booking":"+32 488 33 10 21","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50009617"},"fr":{"name":"Vues temporaires","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"cg.brussels@mzv.sk","phone_contact":"+32 488 33 10 21","phone_booking":"+32 488 33 10 21","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50009617"},"sp":{"name":"Temporary views","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"cg.brussels@mzv.sk","phone_contact":"+32 488 33 10 21","phone_booking":"+32 488 33 10 21","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50009617"},"nl":{"name":"Tijdelijke weergaven","shortdescr":null,"longdescr":null,"performers":null