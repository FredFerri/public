ns":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"},"de":{"name":"Normal"},"it":{"name":"Normale"},"sp":{"name":"Normal"},"pt":{"name":"Normal"},"cn":{"name":"Normal"}},"value":75},{"translations":{"fr":{"name":"Groupe"},"nl":{"name":"Groep"},"en":{"name":"Group"},"de":{"name":"Gruppe"},"it":{"name":"Gruppi"},"sp":{"name":"Grupo"},"pt":{"name":"Groupe"},"cn":{"name":"Groupe"}},"value":85}],"child_events":[],"parent_events":[],"targets":{"list":[5],"translations":{"fr":["Enfants 9-12 ans"],"nl":["Kinderen 9-12 j."],"en":["Children 9-12 yr."],"de":["Kinder 9-12 Jahre"],"it":["Bambini 9-12 anni"],"sp":["Ni\u00f1os de 9 a 12 a\u00f1os"],"pt":[null],"cn":[null]}},"tags":["kids"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-03-25T02:08:24+01:00","published_at":"2022-04-04T12:13:23+02:00","backoffice_id":250835,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.10311813598464},{"id":543917,"date_start":"2023-03-28","date_end":"2023-04-02","date_next":"2023-03-28","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater","it":"Teatro","sp":"Teatro","pt":null,"cn":null}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"],"de":["Theater"],"it":["Teatro"],"sp":["Teatro"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Pourquoi Jessica a-t-elle quitt\u00e9 Brandon ?","shortdescr":"Un r\u00e9cit \u00e0 clef, un puzzle critique, une enqu\u00eate passionnante o\u00f9 s\u2019entrecroisent r\u00e9alit\u00e9, virtualit\u00e9, guerre propre, digital natives et pouvoir des m\u00e9dias.","longdescr":"Dans un caf\u00e9 Starbucks quelconque, Jessica prononce cette phrase terrible : \u00abBrandon, ou bien tu me parles, ou bien je te quitte\u00bb. Et Brandon va parler, et Jessica va le quitter. Fin de l\u2019histoire, le suspense est grill\u00e9.\u2028Mais cet \u00e9pisode aussi insignifiant qu\u2019universel, est le d\u00e9marrage d\u2019une enqu\u00eate th\u00e9\u00e2trale des plus jouissives qui nous emm\u00e8ne sur les traces bien r\u00e9elles d\u2019un ancien pilote de drone militaire devenu lanceur d\u2019alerte, et nous voil\u00e0 transbahut\u00e9s sans crier gare d\u2019un canap\u00e9 de cuir brun caramel vers un container climatis\u00e9, pour pilotes de drones militaires, planqu\u00e9 dans le d\u00e9sert du Nouveau Mexique.\r\nEn s\u2019emparant avec d\u00e9rision d\u2019outils num\u00e9riques vari\u00e9s, en passant d\u2019une conf\u00e9rence gesticul\u00e9e au r\u00e9cit tragique de Brandon, Pierre Solot et Emmanuel De Candido reconstruisent en direct le puzzle d\u2019un \u00abdigital native\u00bb dont chaque pi\u00e8ce aborde, l\u2019air de rien, les notions complexes d\u2019une soci\u00e9t\u00e9 hyper- connect\u00e9e : r\u00e9alit\u00e9, virtualit\u00e9, fiction, guerre propre et pouvoir fascinant des m\u00e9dias.","performers":"conception & jeu Pierre Solot & Emmanuel De Candido \u2022 co-mise en sce\u0300ne Olivier Lenel","boxoffice_url":null,"website":"http:\/\/www.theatre-martyrs.be","email":"billetterie@theatre-martyrs.be","phone_contact":null,"phone_booking":"+32 2 223 32 08","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.543917"},"nl":{"name":"Pourquoi Jessica a-t-elle quitt\u00e9 Brandon ?","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.theatre-martyrs.be","email":"billetterie@theatre-martyrs.be","phone_contact":null,"phone_booking":"+32 2 223 32 08","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.543917"},"