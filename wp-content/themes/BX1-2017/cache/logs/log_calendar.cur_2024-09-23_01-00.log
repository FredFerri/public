"nl":{"name":"Artikel 27"}},"value":1.25}],"date_exceptions":[],"closing_days":[],"child_events":[],"parent_events":[],"accessibilities":[],"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[]},{"id":5700000971,"date_start":"2024-09-28","date_end":"2024-09-29","date_next":"2024-09-28","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-09-05T11:52:06+02:00","published_at":"2024-09-05T11:47:26+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":307227,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"tour","ranking":1,"languages":{"spoken":["en","nl","fr"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{}},"translations":{"de":{"name":"Guided Tour of the Fondation BLAN - BBN 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/fr\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700000971"},"pt":{"name":"Guided Tour of the Fondation BLAN - BBN 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/fr\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700000971"},"en":{"name":"Guided Tour of the Fondation BLAN - BBN 2024","shortdescr":null,"longdescr":"Built shortly after World War I on a boulevard which was in the midst of a veritable building boom, by an architect whose identity remains unknown, this majestic mansion has a fa\u00e7ade of no less than 9 metres. Covered in French stone, the fa\u00e7ade is rigorously divided into four floors with a typical carriage entrance at street level. Having recently been carefully restored to become an art foundation, the building has kept all its cachet with a grand staircase, edged parquet of tropical wood, allegorical mouldings and restored decorations\u2026 Overlooking a roof terrace, a daring modern extension appears to be suspended in mid-air and contrasts with the original construction. Dedicated to art and artistic creation, the blan Foundation was inaugurated in March 2023 and offers a multifaceted programme: exhibits, concerts, artists in residence, talks, workshops\u2026 The guided visit will explain how this former family home, which for a time was transformed into offices, has been saved and restored in order to take on a new function while preserving the decorative touches which miraculously remain intact. Only the public spaces of the Foundation are accessible.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/en\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700000971"},"it":{"name":"Guided Tour of the Fondation BLAN - BBN 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/fr\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700000971"},"cn":{"name":"Guided Tour of the Fondation BLAN - BBN 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/fr\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700000971"},"fr":{"name":"Visite Guid\u00e9e de la Fondation BLAN - BBN 2024","shortdescr":null,"longdescr":"\u00c9difi\u00e9 peu apr\u00e8s la Premi\u00e8re Guerre mondiale, sur un boulevard qui conna\u00eet alors une v\u00e9ritable fr\u00e9n\u00e9sie constructive et par un architecte dont l'identit\u00e9 demeure inconnue, ce majestueux h\u00f4tel de ma\u00eetre d\u00e9veloppe pas moins de neuf m\u00e8tres de fa\u00e7ade. Par\u00e9e de pierre de France, celle-ci s'ordonnance rigoureusement sur quatre \u00e9tages, le rez d\u00e9ployant la belle entr\u00e9e coch\u00e8re propre aux h\u00f4tels de ma\u00eetre. R\u00e9cemment restaur\u00e9e avec grand soin pour \u00eatre transform\u00e9e en fondation d'art, cette demeure a conserv\u00e9 tout son cachet avec son escalier d'honneur, ses parquets liser\u00e9s de bois exotique, ses moulures all\u00e9goriques, ses d\u00e9cors restaur\u00e9s, \u2026 Surplombant un jardin am\u00e9nag\u00e9 en toiture, une audacieuse extension contemporaine semble suspendue et joue de contraste avec la composition originelle. Inaugur\u00e9e en mars 2023 et d\u00e9di\u00e9e \u00e0 l'art et \u00e0 la cr\u00e9ation artistique, la fondation blan propose une programmation polymorphe : expositions, concerts, r\u00e9sidences d'artistes, causeries, ateliers,\u2026 La visite guid\u00e9e permettra de comprendre comment cette ancienne maison de famille, transform\u00e9e un temps en bureaux, a pu \u00eatre sauv\u00e9e et restaur\u00e9e afin d'accueillir sa nouvelle fonction, tout en conservant ses d\u00e9cors rest\u00e9s magnifiquement restaur\u00e9s. Seuls les espaces publics d\u00e9volus \u00e0 la Fondation seront accessibles.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/fr\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700000971"},"sp":{"name":"Guided Tour of the Fondation BLAN - BBN 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/fr\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700000971"},"nl":{"name":"Rondleiding van de Fondation BLAN - BBN 2024","shortdescr":null,"longdescr":"Kort na de Tweede Wereldoorlog, op een moment waarop er langs de Generaal Jacqueslaan een ware bouwwoede heerste, bouwde een onbekend gebleven architect dit majestueuze herenhuis van vier verdiepingen hoog. De gevel is maar liefst negen meter breed en bedekt met Franse natuursteen. Onderaan de gevel treffen we nog de voor herenhuizen zo typische koetspoort aan. Het gebouw, dat onlangs met veel zorg werd gerestaureerd om onderdak te bieden aan een kunststichting, heeft zijn hele cachet bewaard met onder meer een eretrap, parketvloeren in tropisch hout, allegorische sierlijsten en tal van decoraties. Boven de daktuin lijkt een gewaagde moderne aanbouw in de lucht te zweven, een opvallend contrast met de oorspronkelijke constructie. Fondation blan opende in maart 2023 de deuren. Deze stichting, die gewijd is aan kunst en aan artistieke creatie, biedt een zeer veelzijdig programma aan, met tentoonstellingen, concerten, kunstenaarsresidenties, lezingen, workshops, enz. Tijdens het bezoek zal uitgebreid uit de doeken worden gedaan hoe deze voormalige familiewoning, die ooit ook nog een kantoorfunctie vervulde, kon gered en gerestaureerd worden en worden aangepast aan haar nieuwe functie, m\u00e9t behoud van alle decorelementen die miraculeus bewaard zijn gebleven. Tijdens het bezoek zullen enkel de publieke ruimtes van de Fondation blan toegankelijk zijn.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/nl\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700000971"}},"place":{"id":279998,"translations":{"de":{"name":"Fondation blan","address_street_name":"Boulevard G\u00e9n\u00e9ral Jacques","address_street_number":"26","address_street_box":null,"email":"info@fondationblan.org","website":"https:\/\/www.fondationblan.org\/","phone_contact":"+32 2 883 31 46","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Boulevard G\u00e9n\u00e9ral Jacques, 26","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Fondation blan","address_street_name":"Boulevard G\u00e9n\u00e9ral Jacques","address_street_number":"26","address_street_box":null,"email":"info@fondationblan.org","website":"https:\/\/www.fondationblan.org\/","phone_contact":"+32 2 883 31 46","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Boulevard G\u00e9n\u00e9ral Jacques, 26","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Fondation blan","address_street_name":"Boulevard G\u00e9n\u00e9ral Jacques","address_street_number":"26","address_street_box":null,"email":"info@fondationblan.org","website":"https:\/\/www.fondationblan.org\/","phone_contact":"+32 2 883 31 46","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Boulevard G\u00e9n\u00e9ral Jacques, 26","address_line2":"1050 Ixelles","description_web":"The blan Foundation is a venue dedicated to contemporary art and artistic creation. The venue, which will include exhibition halls, studios and an artist residency, offers an eclectic programme: exhibitions, concerts, artist residencies, lectures, workshops, master classes, etc.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Fondation blan","address_street_name":"Boulevard G\u00e9n\u00e9ral Jacques","address_street_number":"26","address_street_box":null,"email":"info@fondationblan.org","website":"https:\/\/www.fondationblan.org\/","phone_contact":"+32 2 883 31 46","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Boulevard G\u00e9n\u00e9ral Jacques, 26","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Fondation blan","address_street_name":"Boulevard G\u00e9n\u00e9ral Jacques","address_street_number":"26","address_street_box":null,"email":"info@fondationblan.org","website":"https:\/\/www.fondationblan.org\/","phone_contact":"+32 2 883 31 46","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Boulevard G\u00e9n\u00e9ral Jacques, 26","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Fondation blan","address_street_name":"Boulevard G\u00e9n\u00e9ral Jacques","address_street_number":"26","address_street_box":null,"email":"info@fondationblan.org","website":"https:\/\/www.fondationblan.org\/","phone_contact":"+32 2 883 31 46","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Boulevard G\u00e9n\u00e9ral Jacques, 26","address_line2":"1050 Ixelles","description_web":"Inaugur\u00e9e en mars 2023, la Fondation blan est un lieu d\u00e9di\u00e9 aux arts contemporains et \u00e0 la cr\u00e9ation artistique. Le lieu, constitu\u00e