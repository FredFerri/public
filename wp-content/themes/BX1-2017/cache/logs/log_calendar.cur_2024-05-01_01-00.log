ien de Habsbourg avec la derni\u00e8re descendante des ducs de Bourgogne fit de Bruxelles l\u2019un des principaux centres du pouvoir imp\u00e9rial, de nombreuses familles de la noblesse europ\u00e9enne y converg\u00e8rent. On profita alors de l\u2019agrandissement de l\u2019enceinte urbaine pour cr\u00e9er un nouveau quartier noble : le Sablon.\n","performers":null,"boxoffice_url":null,"website":"https:\/\/www.itineraires.be\/","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50008864"},"sp":{"name":"Le Quartier Noble du Sablon","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.itineraires.be\/","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50008864"},"nl":{"name":"Le Quartier Noble du Sablon","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.itineraires.be\/","email":"info@itineraires.be","phone_contact":"+32 496 38 85 94","phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50008864"}},"place":{"last_updated_at":"2022-05-30T12:22:16+02:00","published_at":"2014-04-03T15:14:23+02:00","id":257582,"translations":{"de":{"name":" Fontaine de Minerve","address_street_name":"place du Grand Sablon","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"place du Grand Sablon","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":" Fontaine de Minerve","address_street_name":"place du Grand Sablon","address_street_number":null