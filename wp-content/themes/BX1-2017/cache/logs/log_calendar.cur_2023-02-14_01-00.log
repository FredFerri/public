":["Accessible to people with intellectual disabilities","Accessible","Facilities for blind and partially-sighted persons","Facilities for deaf and hearing-impaired people","Assistance dogs","Accessible to pedestrians with mobility aids","Adapted toilet"],"de":["Barrierefrei f\u00fcr Menschen mit Verst\u00e4ndnisschwierigkeiten","Barrierefrei","Anpassungen f\u00fcr blinde und sehbehinderte Menschen","Anpassungen f\u00fcr geh\u00f6rlose und h\u00f6rgesch\u00e4digte Menschen.","Assistenzhund","Barrierefrei f\u00fcr Fu\u00dfg\u00e4nger mit Gehhilfe","Barrierefreies WC"],"it":["Accessibile alle persone con difficolt\u00e0 di comprensione","Accessibile","Disposizioni per persone non vedenti e ipovedenti","Disposizioni per persone non udenti e ipoudenti","Cane guida","Accessibile ai pedoni con supporti","WC idoneo"],"sp":["Habilitado para personas con dificultades de comprensi\u00f3n","Habilitado","Equipos para personas con problemas de visi\u00f3n y audici\u00f3n","Equipos para personas sordas y con problemas de audici\u00f3n","Perros gu\u00eda","Habilitado para peatones con aud\u00edfonos","Ba\u00f1os adaptados"],"pt":[null,null,null,null,null,null,null],"cn":[null,null,null,null,null,null,null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2023-02-13T03:05:53+01:00","published_at":"2022-10-11T15:43:36+02:00","backoffice_id":263911,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":0.7937005259841},{"id":548277,"date_start":"2023-02-14","date_end":"2023-02-18","date_next":"2023-02-14","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater","it":"Teatro","sp":"Teatro","pt":null,"cn":null}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"],"de":["Theater"],"it":["Teatro"],"sp":["Teatro"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Aux P'Tits Bonheurs ... La Chance de et par Bernard Damien","shortdescr":"Une com\u00e9die douce-am\u00e8re \r\n\r\nplus douce qu' am\u00e8re qui se conclut en joyeuse d\u00e9claration d'amour \u00e0 la vie !","longdescr":"Au d\u00e9part d'une des plus belles et \u00e9mouvantes chansons de Jacques BREL : \u00ab La Qu\u00eate \u00bb ,\r\nBernard Damien nous entra\u00eene dans un d\u00e9lire orchestr\u00e9 par l'humour et la po\u00e9sie , un voyage hors du temps dans un espace non clos (!) \r\no\u00f9 l'imaginaire n'a d'\u00e9gal que la fantaisie, o\u00f9 toutes les col\u00e8res et les r\u00e9voltes du monde actuel sont bouscul\u00e9es par une remise en cause fondamentale : \r\net si les moulins \u00e0 vent de Don Quichotte \u00e9taient vraiment des g\u00e9ants ? Et si les \u00e9toiles inaccessibles \u00e9taient plus proches qu'on ne l'imagine ? \r\n\r\nR\u00e9ponse sur sc\u00e8ne. \r\nPeut-\u00eatre ... \r\n\r\n\r\nLa pi\u00e8ce\r\n\r\nAlex - Bernard Damien - est d\u00e9m\u00e9nageur \u00absp\u00e9cialis\u00e9\u00bb dans le d\u00e9m\u00e9nagement de personnes atteintes de Alzheimer \r\nqui int\u00e8grent leur (dernier ...) appartement dans un EHPAD. \r\nIl s'est donn\u00e9 pour mission de raconter ses propres souvenirs afin de stimuler la m\u00e9moire de ses clients\/patients \r\n\r\nCe soir, en compagnie de Miss Old LADY   \u2013 Anne-Marie Cappeliez-   tous les moyens lui sont bons ! \r\nIl  raconte , il se raconte, il invente, il improvise , il joue au clown, il s'agace , il s'\u00e9nerve, il gueule !\r\nil conte ses amours, ses emmerdes, son errance dans un monde qu'il ne domestique pas toujours \r\nmais qu'il essaie d'enjoliver parfois pour \u00e9veiller quelques images, quelques chansons ,\r\nquelques joies et plaisirs du pass\u00e9 dans le c\u0153ur de sa myst\u00e9rieuse patiente... \r\n\r\nUn hymne \u00e0 l'amour  inconditionnel qu'il porte \u00e0 la vie ... m\u00eame en ce monde de brutes !","performers":"de et par Bernard Damien\r\nAvec l'aimable participation de Anne-Marie Cappeliez\r\nCoproduction Le Th\u00e9\u00e2tre sous les Etoiles de Provence \r\nen coproduction avec Le Th\u00e9\u00e2tre du Grand Midi","boxoffice_url":null,"website":"http:\/\/www.laclarenciere.be","email":"fabienne.govaerts@skynet.be","phone_contact":"+32 2 640 46 70","phone_booking":"+32 2 640 46 76","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.548277"},"nl":{"name":"Aux P'Tits Bonheurs ... La Chance de et par Bernard Damien","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.laclarenciere.be","email":"fabienne.govaerts@skynet.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.548277"},"en":{"name":"Aux P'Tits Bonheurs ... La Chance de et par Bernard Damien","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.laclarenciere.be","email":"fabienne.govaerts@skynet.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.548277"},"de":{"name":"Aux P'Tits Bonheurs ... La Chance de et par Bernard Damien","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.laclarenciere.be","email":"fabienne.govaerts@skynet.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.548277"},"it":{"name":"Aux P'Tits Bonheurs ... La Chance de et par Bernard Damien","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.laclarenciere.be","email":"fabienne.govaerts@skynet.be","phone_contact":null,"phone_booking":null,"agenda_url":"h