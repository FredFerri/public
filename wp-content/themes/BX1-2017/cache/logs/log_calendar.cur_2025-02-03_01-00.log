:"2025-02-11","date_end":"2025-02-22","date_next":"2025-02-11","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":true,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-11-14T09:07:04+01:00","published_at":"2024-09-26T16:12:08+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":308523,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"theatre","ranking":0.7937005259840998,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":49,"translations":{"de":"Theater","pt":null,"en":"Theatre","it":"Teatro","cn":null,"fr":"Th\u00e9\u00e2tre","sp":"Teatro","nl":"Theater"}},"others":{"list":[50],"translations":{"de":["Theater"],"pt":[null],"en":["Theatre"],"it":["Teatro"],"cn":[null],"fr":["Th\u00e9\u00e2tre"],"sp":["Teatro"],"nl":["Theater"]}}},"translations":{"de":{"name":"Les enchantements","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lerideau.brussels\/","email":"reservation@lerideau.brussels","phone_contact":"+32 2 737 16 00","phone_booking":"+32 2 737 16 01","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700001822"},"pt":{"name":"Les enchantements","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lerideau.brussels\/","email":"reservation@lerideau.brussels","phone_contact":"+32 2 737 16 00","phone_booking":"+32 2 737 16 01","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700001822"},"en":{"name":"Les enchantements","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lerideau.brussels\/","email":"reservation@lerideau.brussels","phone_contact":"+32 2 737 16 00","phone_booking":"+32 2 737 16 01","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700001822"},"it":{"name":"Les enchantements","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lerideau.brussels\/","email":"reservation@lerideau.brussels","phone_contact":"+32 2 737 16 00","phone_booking":"+32 2 737 16 01","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700001822"},"cn":{"name":"Les enchantements","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lerideau.brussels\/","email":"reservation@lerideau.brussels","phone_contact":"+32 2 737 16 00","phone_booking":"+32 2 737 16 01","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700001822"},"fr":{"name":"Les enchantements","shortdescr":"C\u2019est l\u2019\u00e9t\u00e9 caniculaire dans une cit\u00e9, une partie des gens est partie en vacances. Pour les autres, c\u2019est la routine, le b\u00e9ton, la chaleur. Il manque d\u2019argent, la piscine municipale est ferm\u00e9e. Six jeunes des Enchantements, une cit\u00e9 urbaine comme il en existe beaucoup, vont se r\u00e9aliser dans un projet audacieux et d\u00e9lur\u00e9. Une r\u00e9elle issue po\u00e9tique.","longdescr":"Cr\u00e9ation\nA partir de 16 ans\n\n\nLes bruits sourds des grands ensembles\n\nC\u2019est l\u2019histoire d\u2019une belle id\u00e9e qui se r\u00e9alise, un r\u00e9cit de jeunes qui cr\u00e9ent leurs utopies. C\u2019est un r\u00e9cit qui nous d\u00e9place et nous grandit dans la joie et la douceur. Cathy Min Jung\n\nSix jeunes habitants d\u2019une cit\u00e9 urbaine comme il en existe beaucoup en p\u00e9riph\u00e9rie des grandes villes occidentales, vont se r\u00e9aliser dans un projet audacieux et d\u00e9lur\u00e9.\n\nC\u2019est l\u2019\u00e9t\u00e9, une partie de la population est partie en vacances. Pour l\u2019autre, c\u2019est la routine, le b\u00e9ton, la canicule.\nIl fait mourant de chaud, il manque d\u2019argent pour rejoindre les territoires qui font r\u00eaver, la piscine municipale est ferm\u00e9e. Qu\u2019\u00e0 cela ne tienne, Mo, Lu, Tratra et puis Ma\u00ef, So et Cha ne vont pas attendre les bras crois\u00e9s que le monde se pr\u00e9occupe de leur sort. Ils et elles vont d\u00e9ployer des tr\u00e9sors d\u2019imagination pour faire de cet \u00e9t\u00e9 un v\u00e9ritable enchantement, jusqu\u2019\u00e0 ce que la pluie tombe, pas une pluie grise qui renfrogne et enferme, une pluie douce, attendue, qui lib\u00e8re et offre une issue po\u00e9tique \u00e0 tous les emp\u00eachements de l\u2019\u00e9t\u00e9 dans une cit\u00e9.\n\n\u2022 RENCONTRE \u2013 JE 13.02 apr\u00e8s la repr\u00e9sentation.\n\n\u2022 AFTER SCENE \u2013 SA 15.02 apr\u00e8s la repr\u00e9sentation. Avec l\u2019\u00e9quipe du spectacle.\n\n\n\u00c9criture Cl\u00e9mence Attar \u2013 Mise en sc\u00e8ne Cathy Min Jung \u2013 Avec Onur Aydin, Mahi Hadjammar, Ana\u00efs Moray, Adel Namli, Warda Rammach, Estelle Strypstein\u2013 Assistant \u00e0 la mise en sc\u00e8ne Hugo Favier \u2013 Cr\u00e9ateur sonore S\u00e9bastien Fernandez \u2013 Sc\u00e9nographie et costumes Ronald Beurms \u2013 Cr\u00e9ation vid\u00e9o Allan Beurms \u2013 Cr\u00e9ation lumi\u00e8re Aur\u00e9lie Perret \u2013 Distribution en cours.\n\nVisuel (montage photo) \u00a9Ronald Beurms.\n\nUne cr\u00e9ation de la Cie Billie On Stage.\nCoproduction le Rideau, L\u2019Ancre, la Coop asbl et Shelter Prod.\nAvec le soutien de la COCOF - Fonds d'acteur, Taxshelter.be, ING et le Tax Shelter du Gouvernement f\u00e9d\u00e9ral belge.\nProduction d\u00e9l\u00e9gu\u00e9e Le Rideau.\n\n\u00c9ditions THEATRALES 2023.","performers":"\u00c9criture Cl\u00e9mence Attar \u2013 Mise en sc\u00e8ne Cathy Min Jung \u2013 Avec Onur Aydin, Mahi Hadjammar, Ana\u00efs Moray, Adel Namli, Warda Rammach, Estelle Strypstein\u2013 Assistant \u00e0 la mise en sc\u00e8ne Hugo Favier \u2013 Cr\u00e9ateur sonore S\u00e9bastien Fernandez \u2013 Sc\u00e9nographie et costumes Ronald Beurms \u2013 Cr\u00e9ation vid\u00e9o Allan Beurms \u2013 Cr\u00e9ation lumi\u00e8re Aur\u00e9lie Perret \u2013 Distribution en cours.","boxoffice_url":null,"website":"https:\/\/lerideau.brussels\/","email":"reservation@lerideau.brussels","phone_contact":"+32 2 737 16 00","phone_booking":"+32 2 737 16 01","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700001822"},"sp":{"name":"Les enchantements","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lerideau.brussels\/","email":"reservation@lerideau.brussels","phone_contact":"+32 2 737 16 00","phone_booking":"+32 2 737 16 01","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700001822"},"nl":{"name":"Les enchantements","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lerideau.brussels\/","email":"reservation@lerideau.brussels","phone_contact":"+32 2 737 16 00","phone_booking":"+32 2 737 16 01","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700001822"}},"place":{"id":944,"translations":{"de":{"name":"Le Rideau","address_street_name":"Rue Goffart","address_street_number":"7 A","address_street_box":null,"email":"contact@lerideau.brussels","website":"https:\/\/lerideau.brussels","phone_contact":"+32 2 737 16 00","phone_booking":"+32 2 737 16 01","address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Goffart, 7 A","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Le Rideau","address_street_name":"Rue Goffart","address_street_number":"7 A","address_street_box":null,"email":"contact@lerideau.brussels","website":"https:\/\/lerideau.brussels","phone_contact":"+32 2 737 16 00","phone_booking":"+32 2 737 16 01","address_zip":"1050","address_city":"Ixelles","add