5:21:20+02:00","backoffice_id":258549,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.33755319058958},{"id":542697,"date_start":"2022-09-30","date_end":"2022-10-29","date_next":"2022-09-30","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[24,30],"translations":{"fr":["Galeries d'art","Peinture"],"nl":["Galeries","Schilderkunst"],"en":["Art Galleries","Painting"]}}},"languages":{"spoken":["fr","en"],"subtitles":[]},"translations":{"fr":{"name":"Erik Minter - Dopamine","shortdescr":"Il s'agit de la premi\u00e8re exposition personnelle de Erik Minter \u00e0 la galerie, sa plus importante en Europe \u00e0 ce jour.","longdescr":"Minter est connu pour son utilisation de combinaisons de couleurs vibrantes qui se tissent entre des formes graphiques \u00e9tranges et des \u00e9claboussures fluides. Son travail combine l'abstraction avec une figuration surr\u00e9aliste, car il cherche \u00e0 capturer les \u00e9motions d'une exp\u00e9rience, \u00e9vocatrice de r\u00eaves ou de nostalgie. Si les compositions sont relativement planifi\u00e9es, son approche de la peinture est improvis\u00e9e. Chaque pi\u00e8ce est cr\u00e9\u00e9e \u00e0 l'aide d'une combinaison de techniques qui impliquent la pulv\u00e9risation, le coulage, des marques gestuelles et le masquage des formes en \"dessinant\" avec du ruban adh\u00e9sif.\r\n\"Dopamine\" est, au fond, l'exploration par Minter de l'inconnu familier tout en r\u00e9alisant un num\u00e9ro d'\u00e9quilibriste entre conception contr\u00f4l\u00e9e et spontan\u00e9it\u00e9. Minter d\u00e9clare que \"lorsque des inconnus sont jet\u00e9s dans le m\u00e9lange, cela ajoute un \u00e9l\u00e9ment de chaos qui doit \u00eatre justifi\u00e9 par des compromis visuels. Une partie de mon travail consiste \u00e0 d\u00e9construire la pr\u00e9visibilit\u00e9. Si quelque chose devient routinier, nous risquons de perdre ce sentiment d'excitation. C'est peut-\u00eatre ma fa\u00e7on de rechercher des sensations fortes visuelles...\". La juxtaposition de formes tangibles et d'\u00e9clats de couleur amorphes se d\u00e9pla\u00e7ant ensemble dans l'espace cr\u00e9e un sentiment de perp\u00e9tuit\u00e9. Quand tout peut sembler si incertain, les \u0153uvres de Minter offrent une sorte de \"remontant\", s'accrochant \u00e0 un moment pour \u00e9viter le crash. Il explore des th\u00e8mes li\u00e9s aux connexions sociales, aux d\u00e9connexions et aux reconnexions, repr\u00e9sentant des \u00e9nergies et des objets qui interagissent en recherchant continuellement la prochaine dose de \"Dopamine\".","performers":"Erik Minter","boxoffice_url":null,"website":"http:\/\/www.mazelgalerie.com","email":"contact@mazelgalerie.com","phone_contact":"+32 2 850 29 28","phone_booking":"+32 2 850 29 28","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.542697"},"nl":{"name":"Erik Minter - Dopamine","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.542697"},"en":{"name":"Erik Minter - Dopamine","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.542697"},"de":{"name":"Erik Minter - Dopamine","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.542697"},"it":{"name":"