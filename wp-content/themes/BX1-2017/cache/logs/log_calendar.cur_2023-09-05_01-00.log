contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Poelaertplein","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":null,"facebook_id":null,"backoffice_id":39379,"location":{"lat":50.83789948,"lon":4.3529282},"region":"brussels","last_updated_at":"2022-09-20T04:20:03+02:00","published_at":"2022-09-19T11:40:48+02:00","import_origin":null,"external_id":null,"is_in_address_book":false,"is_in_vb_export":false,"resto_ranking":0},"organizer":{"id":278418,"translations":{"de":{"name":"Tram experience","address_street_name":"Place Poelaert","address_street_number":null,"address_street_box":null,"email":"tramexperience@visit.brussels","website":"https:\/\/www.visit.brussels\/fr\/visiteurs\/boire-et-manger\/tram-experience","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Poelaert","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Tram experience","address_street_name":"Place Poelaert","address_street_number":null,"address_street_box":null,"email":"tramexperience@visit.brussels","website":"https:\/\/www.visit.brussels\/fr\/visiteurs\/boire-et-manger\/tram-experience","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Poelaert","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Tram experience","address_street_name":"Place Poelaert","address_street_number":null,"address_street_box":null,"email":"tramexperience@visit.brussels","website":"https:\/\/www.visit.brussels\/en\/visitors\/where-to-eat\/tram-experience","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Poelaert","address_line2":"1000 Bruxelles","description_web":"Embark on a unique gastronomic journey through Brussels\r\n\r\nThe Tram Experience is celebrating its 10th anniversary! Over the last decade, we've extraordinarily fortunate to share this extraordinary gastronomic experience with food lovers from Brussels and beyond. \r\n\r\nAfter a well-deserved makeover and a successful comeback last September, it's time to discover the newest iteration of the Tram Experience.\r\n \r\nEach menu follows the rhythm of the seasons and is an opportunity for our chefs to present their reinterpretation of Belgian cuisine and delight your taste buds! Rediscover Belgian gastronomy in the unique, welcoming atmosphere of a tram as it travels Brussels. \r\n\r\nInimitable chef Lionel Rigolet* is once again doing us the great honour of being the patron of the Tram Experience! His rigour and expertise, as chef of the prestigious Comme chez Soi, guarantee you delicious, perfectly executed menus. The dishes are prepared on board by catering chef Thibault Granville from Taste Great.\r\n\r\nAll aboard!","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Tram experience","address_street_name":"Place Poelaert","address_street_number":null,"address_street_box":null,"email":"tramexperience@visit.brussels","website":"https:\/\/www.visit.brussels\/fr\/visiteurs\/boire-et-manger\/tram-experience","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Poelaert","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Tram experience","address_street_name":"Place Poelaert","address_street_number":null,"address_street_box":null,"email":"tramexperience@visit.brussels","website":"https:\/\/www.visit.brussels\/fr\/visiteurs\/boire-et-manger\/tram-experience","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Poelaert","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"fr":{"name":"Tram experience","address_street_name":"Place Poelaert","address_street_number":null,"address_street_box":null,"email":"tramexperience@visit.brussels","website":"https:\/\/www.visit.brussels\/fr\/visiteurs\/boire-et-manger\/tram-experience","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Poelaert","address_line2":"1000 Bruxelles","description_web":"Embarquez pour un voyage gastronomique unique \u00e0 travers Bruxelles\r\n\r\nLe Tram Experience f\u00eate ses 10 ans ! Tout au long de la derni\u00e8re d\u00e9cennie, nous avons eu la chance de partager cette exp\u00e9rience gastronomique hors-du-commun avec les amateurs de grande cuisine, de Bruxelles et d\u2019ailleurs. \r\n\r\nApr\u00e8s un relooking bien m\u00e9rit\u00e9 et un retour en fanfare en septembre dernier, le temps est venu de d\u00e9couvrir la nouvelle \u00e9dition du Tram Experience. \r\n\r\nAu rythme des saisons, chaque menu est l\u2019occasion pour nos chefs de vous pr\u00e9senter leur r\u00e9interpr\u00e9tation de la cuisine belge. De quoi ravir vos papilles ! Red\u00e9couvrez la gastronomie belge dans l\u2019atmosph\u00e8re unique et chaleureuse d\u2019un tram circulant \u00e0 travers Bruxelles. \r\n\r\nL\u2019incontournable Lionel Rigolet* nous fait, une nouvelle fois, le plaisir d\u2019\u00eatre le parrain du Tram Experience ! Sa rigueur et son expertise, en tant que chef du prestigieux Comme chez Soi, vous garantissent des menus savoureux \u00e0 l\u2019ex\u00e9cution parfaite.\r\n\r\nLes plats sont r\u00e9alis\u00e9s \u00e0 bord par notre chef traiteur, Thibault Granville - Taste Great.\r\n\r\nEn voiture !","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Tram experience","address_street_name":"Place Poelaert","address_street_number":null,"address_street_box":null,"email":"tramexperience@visit.brussels","website":"https:\/\/www.visit.brussels\/fr\/visiteurs\/boire-et-manger\/tram-experience","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place Poelaert","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Tram experience","address_street_name":"Poelaertplein","address_street_number":null,"address_street_box":null,"email":"tramexperience@visit.brussels","website":"https:\/\/www.visit.brussels\/nl\/visitors\/where-to-eat\/tram-experience","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Poelaertplein","address_line2":"1000 Bruxelles","description_web":"Ga mee op een unieke gastronomische reis door Brussel \r\n\r\nDe Tram Experience viert zijn 10e verjaardag! Al tien jaar lang mogen we deze buitengewone gastronomische ervaring delen met liefhebbers van lekker eten uit Brussel en daarbuiten.\r\n\r\nNa een welverdiende make-over en een geweldige comeback afgelopen september, is de Tram Experience toe aan een nieuwe editie, klaar om ontdekt te worden!\r\n\r\nElk seizoensgebonden menu is voor onze chefs een gelegenheid om hun herinterpretaties van de Belgische keuken voor te stellen en je smaakpapillen stevig te verwennen. Je herontdekt de Belgische gastronomie en dat in de unieke en gezellige sfeer van een tram die door Brussel rolt.\r\n\r\nDe onnavolgbare Lionel Rigolet*, chef van het prestigieuze Comme chez Soi, vereert ons door opnieuw peetvader te zijn van de Tram Experience. Zijn precisie en deskundigheid garanderen je overheerlijke menu\u2019s die tot in de puntjes uitgewerkt zijn. \r\nAan boord worden de gerechten bereid door onze chef-kok Thibault Granville van Taste Great.\r\n\r\nOpstappen maar!","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":38418,"location":{"lat":50.83780026,"lon":4.35310484},"last_updated_at":"2022-10-10T10:25:09+02:00","published_at":"2022-04-20T15:57:08+02:00","is_in_address_book":false,"is_in_vb_export":false,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/26564430161dcd690070282996103311c5a877fc.jpg","width":3464,"height":5196,"ratio":0.67,"oEmbed_height":5196,"oEmbed_width":3464,"translations":{"de":{"title":"Tram Experience","copyright":"David Olkarny"},"pt":{"title":"Tram Experience","copyright":"David Olkarny"},"en":{"title":"Tram Experience","copyright":"David Olkarny"},"it":{"title":"Tram Experience","copyright":"David Olkarny"},"cn":{"title":"Tram Experience","copyright":"David Olkarny"},"fr":{"title":"Tram Experience","copyright":"David Olkarny"},"sp":{"title":"Tram Experience","copyright":"David Olkarny"},"nl":{"title":"Tram Experience","copyright":"David Olkarny"}}},{"type":"poster","link":"https:\/\/agendabrussels2.imgix.net\/401e19dd26a2c23274660a4519847664722b6b4c.png","width":600,"height":688,"ratio":0.87,"oEmbed_height":688,"oEmbed_width":600,"translations":{"de":{"title":"Tram Experience","copyright":null},"pt":{"title":"Tram Experience","copyright":null},"en":{"title":"Tram Experience","copyright":null},"it":{"title":"Tram Experience","copyright":null},"cn":{"title":"Tram Experience","copyright":null},"fr":{"title":"Tram Experience","copyright":null},"sp":{"title":"Tram Experience","copyright":null},"nl":{"title":"Tram Experience","copyright":null}}},{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/90167cd0f174e