cr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/inspired-love-belfius-art-collection","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50008019"},"en":{"name":"Inspired by Love - Belfius Art Collection","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/inspired-love-belfius-art-collection","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50008019"},"it":{"name":"Inspired by Love - Belfius Art Collection","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/inspired-love-belfius-art-collection","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50008019"},"cn":{"name":"Inspired by Love - Belfius Art Collection","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/inspired-love-belfius-art-collection","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50008019"},"fr":{"name":"Inspired by Love - Belfius Art Collection","shortdescr":null,"longdescr":"Les curatrices ont propos\u00e9 \u00e0 12 artistes r\u00e9cemment entr\u00e9s dans la Belfius Art collection de se plonger dans la Belfius Art collection pour y choisir des oeuvres qui les inspirent et les touchent. Cette collection qui est connue pour son grand love pour l'art belge, de l'art primitif \u00e0 nos jours avec un accent particulier pour l'art contemporain!\n\nSitu\u00e9 au 32e \u00e9tage de la Tour Belfius, place Rogier, vous d\u00e9couvrirez aussi un panorama exceptionnel sur Bruxelles.\nL'exposition se cl\u00f4ture en juin 2024.\n\nSi vous participez \u00e0 une visite Arkadia merci de ne pas vous inscrire sur le site de Belfius. Votre place sera automatiquement r\u00e9serv\u00e9e. Merci d'arriver 10 min en avance car il y a un contr\u00f4le d'identit\u00e9 \u00e0 l'entr\u00e9e (ne pas oublier sa carte d'identit\u00e9). Vous retrouverez le guide apr\u00e8s le contr\u00f4le \u00e0 la borne \"point de rencontre\".\n\nBelfius demande \u00e0 chaque visiteur une contribution de 5 euros \u00e0 r\u00e9gler sur place afin de soutenir les actions Viva for Life (en faveur des jeunes enfants et familles qui vivent sous le seuil de pauvret\u00e9) et JEZ! (en faveur d'organisations intervenant aupr\u00e8s des jeunes). Cette contribution est facultative pour les clients Belfius munis de leur carte de banque ou de l\u2019app Belfius Mobile.","performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/inspired-love-belfius-art-collection","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50008019"},"sp":{"name":"Inspired by Love - Belfius Art Collection","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/inspired-love-belfius-art-collection","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50008019"},"nl":{"name":"Inspired by Love - Belfius Art Collection","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites-guidees\/inspired-love-belfius-art-collection","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5000