,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-04-20T02:01:35+02:00","published_at":"2024-03-28T13:24:44+01:00","publication_state":"published","date_embargo":"2024-04-04","show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":297438,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.3684031498640387,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[39,36],"translations":{"de":["Fotografie","Museen & Kunstzentren"],"pt":[null,null],"en":["Photography","Museums and art centers"],"it":["Fotografia","Musei e centri artistici"],"cn":[null,null],"fr":["Photographie","Mus\u00e9es et art centers"],"sp":["Fotograf\u00eda","Museos y centros de arte"],"nl":["Fotografie","Musea en kunstcentra"]}}},"translations":{"de":{"name":"Why...Not! #1 Opening Night and Magazine Launch","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/culturesetpublics.be\/","email":"info@culturesetpublics.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50008964"},"pt":{"name":"Why...Not! #1 Opening Night and Magazine Launch","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/culturesetpublics.be\/","email":"info@culturesetpublics.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50008964"},"en":{"name":"Why...Not! #1 Opening Night and Magazine Launch","shortdescr":"Photo exhibition and launch of Why\u2026Not! #1 \nArtists, photographers, authors and illustrators dialogue via exquisite corpses in order to propose different ways of co-creating around the theme \"Siphoning minds\".","longdescr":"Why\u2026Not! is a quarterly photographic magazine, digital and printed, initiated by the ASBL Cultures & Publics.\n\nThe magazine engages in co-creation on the subjects of Utopia, the urban landscape, the night, the body... And more generally on the impact of the photographic and literary medium in the construction of aesthetic and social relationships.\n\nWith the release of No. 1, la Maison Commune presents an exquisite corpse of works around the theme \u201cSiphoning minds\u201d.\n\nCome discover the work of our contributors from Monday April 18 at 6 p.m. !\n\nThe exhibition, visible until May 7, will end with an evening of artistic and literary performances on from 6 p.m. to 10 p.m.","performers":null,"boxoffice_url":null,"website":"https:\/\/culturesetpublics.be\/","email":"info@culturesetpublics.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50008964"},"it":{"name":"Why...Not! #1 Opening Night and Magazine Launch","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/culturesetpublics.be\/","email":"info@culturesetpublics.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50008964"},"cn":{"name":"Why...Not! #1 Opening Night and Magazine Launch","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/culturesetpublics.be\/","email":"info@culturesetpublics.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50008964"},"fr":{"name":"Why...Not! #1 Vernissage d'exposition et lancement de revue","shortdescr":"Exposition photographique et lancement du n\u00b01 de la revue Why...Not!\nDes artistes, photographes, auteur\u00b7e\u00b7s, dessinateur\u00b7ice\u00b7s dialoguent via des cadavres exquis afin de proposer diff\u00e9rentes mani\u00e8res de co-cr\u00e9er autour du th\u00e8me \"Siphonner les esprits\".","longdescr":"Why\u2026Not! est une revue photographique trimestrielle, num\u00e9rique et imprim\u00e9e, initi\u00e9e par l\u2019ASBL Cultures & Publics.\u00a0\nProjet prot\u00e9iforme, la revue s\u2019engage dans une co-cr\u00e9ation sur les sujets de l\u2019Utopie, le paysage urbain, la nuit, le corps\u2026 Et plus globalement sur l\u2019impact du m\u00e9dium photographique et litt\u00e9raire dans la construction du lien esth\u00e9tique et social.\n\n\u00c0 l\u2019occasion de la sortie du n\u00b01, la Maison Commune, lieu d\u2019occupation de Cultures & Publics, pr\u00e9sente un cadavre exquis d\u2019oeuvres autour du th\u00e8me \u00ab\u00a0Siphonner les esprits\u00a0\u00bb.\u00a0\n\nVenez d\u00e9couvrir le travail de nos contributeurs \u00e0 partir du lundi 18 avril \u00e0 18h !\n\nL\u2019exposition, visible jusqu\u2019au 7 mai, se terminera sur une soir\u00e9e de performances artistiques et litt\u00e9raires de 18h \u00e0 22h.","performers":null,"boxoffice_url":null,"website":"https:\/\/culturesetpublics.be\/","email":"info@culturesetpublics.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50008964"},"sp":{"name":"Why...Not! #1 Opening Night and Magazine Launch","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/culturesetpublics.be\/","email":"info@culturesetpublics.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50008964"},"nl":{"name":"Why...Not! #1 Tentoonstelling en boekpresentatie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/culturesetpublics.be\/","email":"info@culturesetpublics.be","phone_contact":null,"phone_booking":nul