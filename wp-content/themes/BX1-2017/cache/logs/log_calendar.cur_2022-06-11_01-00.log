_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-04-08T04:05:40+02:00","published_at":"2022-04-08T03:30:15+02:00","backoffice_id":250995,"import_origin":"explore","sub_type":"other","show_in_agenda":true,"ranking":1},{"id":527363,"date_start":"2022-06-25","date_end":"2022-06-25","date_next":"2022-06-25","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours"}},"others":{}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Visite musicale : d\u00e9couverte de l'\u00e2me d'un quartier en histoire et m\u00e9lodie","shortdescr":"Clap Culture vous invite en ce d\u00e9but d'\u00e9t\u00e9 \u00e0 venir, entre les \u00e9tendues vertes et les arbres, les bancs et les fleurs parfum\u00e9es, d\u00e9couvrir ce que nous \"cache\" ce parc embl\u00e9matique d'Uccle qu'est le parc Wolvendael\u2026 en musique ! Il y en aura pour tous les go\u00fbts !","longdescr":"En ce d\u00e9but d'\u00e9t\u00e9, quoi de mieux que de renouer au contact de la nature ? \u00e7a tombe bien \u00e0 Uccle, nous comptons beaucoup de parcs... dont un des plus incontournables : le parc Wolvendael ! Nous vous proposons une balade entre les arbres et les sentiers de cet espace vert typiquement ucclois. Nous irons voir toutes ces choses qu'il abrite, \u00e7a et l\u00e0, et qui sont riches en Histoire avec un grand H, en anecdotes et t\u00e9moignages locaux. De l'all\u00e9e Bob De Moor \u00e0 celle de Herg\u00e9, en passant par celle un peu plus \u00e0 l'\u00e9cart de Jos Albert, ce c\u00e9l\u00e8bre peintre ucclois et par le pavillon Louis XV ou la p\u00e9pini\u00e8re citoyenne d'Uccle. C'est ce que notre guide vous pr\u00e9sentera. Chaque \u00e9tape de notre visite sera agr\u00e9ment\u00e9e par un morceau de musique originale, interpr\u00e9t\u00e9 par un-e musicien-ne professionnel-le ! Quelques quizz seront \u00e9galement au rendez-vous pour \u00e9changer avec vous des devinettes sur l'histoire du parc Wolvendael ! Rendez-vous le 25 juin \u00e0 15H \u00e0 l'entr\u00e9e en haut du parc Wolvendael (Dieweg, pr\u00e8s de l'arr\u00eat de tram).","performers":"Un-e guide et un-e musicien-ne","boxoffice_url":null,"website":"https:\/\/www.facebook.com\/MusicalVisitBrussels","email":"clapculture@gmail.com","phone_contact":"+32 477 62 31 64","phone_booking":"+32 477 62 31 64","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/527363.html"},"nl":{"name":"Visite musicale : d\u00e9couverte de l'\u00e2me d'un quartier en histoire et m\u00e9lodie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/527363.html"},"en":{"name":"Visite musicale : d\u00e9couverte de l'\u00e2me d'un quartier en histoire et m\u00e9lodie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/527363.html"},"de":{"name":"Visite musicale : d\u00e9couverte de l'\u00e2me d'un quartier en histoire et m\u00e9lodie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/527363.html"},"it":{"name":"Visite musicale : d\u00e9couverte de l'\u00e2me d'un quartier en histoire et m\u00e9lodie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"ph