en":false},"sunday":{"is_open":false}},"translations":{"fr":["lundi, mardi, mercredi, jeudi et vendredi: de 09:00 \u00e0 18:00","samedi et dimanche: ferm\u00e9"],"nl":["maandag, dinsdag, woensdag, donderdag en vrijdag: van 09:00 tot 18:00","zaterdag en zondag: gesloten"],"en":["monday, tuesday, wednesday, thursday and friday: from 09:00 to 18:00","saturday and sunday: closed"],"de":["monday, tuesday, wednesday, thursday and friday: from 09:00 to 18:00","saturday and sunday: closed"],"it":["monday, tuesday, wednesday, thursday and friday: from 09:00 to 18:00","saturday and sunday: closed"],"sp":["monday, tuesday, wednesday, thursday and friday: from 09:00 to 18:00","saturday and sunday: closed"],"pt":["monday, tuesday, wednesday, thursday and friday: from 09:00 to 18:00","saturday and sunday: closed"],"cn":["monday, tuesday, wednesday, thursday and friday: from 09:00 to 18:00","saturday and sunday: closed"]},"date_start":"2023-03-06","date_end":"2023-04-07","is_also_by_appointment":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-03-25T03:36:23+01:00","published_at":"2023-03-07T12:26:32+01:00","backoffice_id":272973,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.31498026247372},{"id":550786,"date_start":"2023-02-01","date_end":"2023-03-31","date_next":"2023-03-27","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung","it":"Esposizioni","sp":"Exhibici\u00f3n","pt":null,"cn":null}},"others":{"list":[24,30],"translations":{"fr":["Galeries d'art","Peinture"],"nl":["Galeries","Schilderkunst"],"en":["Art Galleries","Painting"],"de":["Kunstgalerien","Malerei"],"it":["Gallerie d'arte","Pittura"],"sp":["Galer\u00edas de arte","Pintura"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["en","fr"],"subtitles":[]},"translations":{"fr":{"name":"Wang Jojo : 'Le souffle de Ga\u00efa'","shortdescr":"La galerie Art Y\u012b vous pr\u00e9sente une nouvelle exposition de peinture des derni\u00e8res \u0153uvres de Wang Jojo, qui est une artiste Chinoise contemporain vivant \u00e0 Paris. Dans la mythologie grecque, Ga\u00efa, qui signifie \u00ab terre \u00bb ou \u00ab terre \u00bb), est la personnification de la Terre, la m\u00e8re ancestrale de toute vie.","longdescr":"\u2022 Wang Jojo dessine un mythe ancien. Ses \u0153uvres sont libres, romantiques, oniriques avec une saveur orientale ; dialoguent dans un jeu entre fantasme et r\u00e9alit\u00e9.\r\n \r\n\u2022 Elle puise son inspiration pour ses \u0153uvres dans l'ukiyo-e et le yamato-e (styles de peinture traditionnels japonais). Son objectif est de trouver l'esth\u00e9tique commune entre la peinture japonaise du pass\u00e9 et le mythe antique chinois. L'artiste tente de red\u00e9couvrir ce qu'elle appelle \u00abl'Esth\u00e9tique orientale\u00bb, qui na\u00eet naturellement de l'int\u00e9rieur de la femme et un pouvoir libre qui relie le \u00abelle\u00bb int\u00e9rieur et la nature. Selon l'artiste, le monde est \u00e0 l'int\u00e9rieur de \"moi\", alors que je fais aussi partie du monde.\r\n\r\n\u2022 Art Y\u012b est une galerie d'art contemporain situ\u00e9e aux Monts-des-Arts, \u00e0 c\u00f4t\u00e9 de la Gare Centrale et \u00e0 100m de la Grand Place. La galerie offre une fusion unique d'art contemporain universel. Un large \u00e9ventail de sculptures et de peintures d'artistes internationaux est pr\u00e9sent\u00e9.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.art-yi.com","email":"info@art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.550786"},"nl":{"name":"Wang Jojo: 'De adem van Gaia'","shortdescr":"Kunstgalerie Art Y\u012b opent een nieuwe schilderijententoonstelling met de nieuwste kunstwerken van Wang Jojo (\u738b\u6893\u4e54), een hedendaagse Chinese kunstenaar die in Parijs woont. In de Griekse mythologie is Gaia, wat 'land' of 'aarde' betekent, de personificatie van de aarde, de voorouderlijke moeder van al het leven.","longdescr":"\u2022 Wang Jojo tekent een oude mythe. Haar werken zijn vrij, romantisch, dromerig met een ori\u00ebntaals tintje; een dialoog tussen fantasie en werkelijkheid.\r\n \r\n\u2022 Ze haalt haar inspiratie voor haar werken uit ukiyo-e en yamato-e (Japanse traditionele schilderstijlen). Haar doel is om de gemeenschappelijke esthetiek te vinden tussen de Japanse schilderkunst uit het verleden en de Chinese oude mythe. De kunstenares probeert te herontdekken wat zij de \"East Aesthetics\" noemt, die op natuurlijke wijze vanuit de vrouw wordt geboren en een vrije kracht is die het innerlijke \"haar\" en de natuur met elkaar verbindt. Volgens de kunstenaar zit de wereld in 'mij', terwijl ik ook een deel van de wereld ben.\r\n \r\n\u2022 Art Y\u012b is een hedendaagse kunstgalerij gelegen op de Kunstberg, naast het Centraal Station en op 100 meter van de Grote Markt. De galerij biedt een unieke mix van universele hedendaagse kunst. Ze presenteert een breed scala aan sculpturen en schilderijen van internationale kunstenaars.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.art-yi.com","email":"info@art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.550786"},"en":{"name":"WANG Jojo: \"The Breath of Gaia\"","shortdescr":"Art Y\u012b gallery is opening a new painting exhibition of the latest artworks of Wang Jojo (\u738b\u6893\u4e54), who is a contemporary Chinese artist living in Paris. In Greek mythology, Gaia, meaning \"land\" or \"earth\"), is the personification of the Earth, the ancestral mother of all life.","longdescr":"\u2022 Wang Jojo draws an ancient myth. Her works are free, romantic, dreamlike with an oriental flavor; dialogue in a game between fantasy and reality.\r\n \r\n\u2022 She draws her inspiration for her works from ukiyo-e and yamato-e (Japanese traditional painting styles). Her objective is to find the common aesthetic between Japanese painting of the past and Chinese ancient myth. The artist tries to rediscover what she calls the \u201cEast Aesthetics\u201d, which is born naturally from within the woman and a free power that connects the inner \"her\" and the nature. According to the artist, the world is inside of \"me\", while I am also a part of the world.\r\n\r\n\u2022 Art Y\u012b is a contemporary art gallery located at Monts-des-Arts, next to the Central Station and 100m to the Grand Place. The gallery offers a unique fusion of universal contemporary art. A wide range of sculptures and paintings by international artists is presented.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.art-yi.com","email":"info@art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.550786"},"de":{"name":"Exposition de Peinture Wang Jojo : 'Le souffle de Ga\u00efa'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.art-yi.com","email":"info@art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.550786"},"it":{"name":"Exposition de Peinture Wang Jojo : 'Le souffle de Ga\u00efa'","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.art-yi.com","email":"info@art-yi.com","phone_contact":"+32 474 70 04 07","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/