_start":"2023-09-18","date_end":"2023-09-19","date_next":"2023-09-18","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2023-08-07T10:45:07+02:00","published_at":"2023-07-31T14:01:14+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":282500,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"theatre","ranking":1,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":49,"translations":{"de":"Theater","pt":null,"en":"Theatre","it":"Teatro","cn":null,"fr":"Th\u00e9\u00e2tre","sp":"Teatro","nl":"Theater"}},"others":{}},"translations":{"de":{"name":"Ciseaux","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/famefestival.be\/fr\/fame-event\/ciseaux\/","email":"info@famefestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50000476"},"pt":{"name":"Ciseaux","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/famefestival.be\/fr\/fame-event\/ciseaux\/","email":"info@famefestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50000476"},"en":{"name":"Ciseaux","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/famefestival.be\/fr\/fame-event\/ciseaux\/","email":"info@famefestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50000476"},"it":{"name":"Ciseaux","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/famefestival.be\/fr\/fame-event\/ciseaux\/","email":"info@famefestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50000476"},"cn":{"name":"Ciseaux","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/famefestival.be\/fr\/fame-event\/ciseaux\/","email":"info@famefestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50000476"},"fr":{"name":"Ciseaux","shortdescr":"Un sprint tonique dans la m\u00e9moire queer de Montr\u00e9al. Celle-ci est raviv\u00e9e d\u2019un point de vue f\u00e9ministe \u00e0 l'aide de num\u00e9ros drag, de mat\u00e9riaux documentaires et de prises de parole.","longdescr":"Deux com\u00e9diennes explorent les moments et lieux marquants du pass\u00e9 lesbien des 70 derni\u00e8res ann\u00e9es de la ville de Montr\u00e9al. Chemin faisant, elles identifient, d\u00e9jouent et se r\u00e9approprient des clich\u00e9s persistants.\n\nCes souvenirs ressurgissent \u00e0 l\u2019aide de num\u00e9ros drag king, de mat\u00e9riaux documentaires et de prises de parole de personnalit\u00e9s de la diversit\u00e9 sexuelle telles que Manon Mass\u00e9, Safia Nolin, Judith Lussier et Monique Giroux.\n\nIntimement, on se r\u00e9approprie les clich\u00e9s lesbophobes pour tenter de se d\u00e9couvrir et de se comprendre.\nEt peut-\u00eatre m\u00eame, d\u2019\u00e9prouver un sentiment d\u2019appartenance ? La compagnie Pleurer Dans\u2019 Douche am\u00e8ne avec humour, festivit\u00e9 et authenticit\u00e9 une r\u00e9flexion sur la sous-repr\u00e9sentativit\u00e9 des femmes queers dans les livres d\u2019histoire et les m\u00e9dias grand public.","performers":"Pleurer Dans\u2019 Douche","boxoffice_url":null,"website":"https:\/\/famefestival.be\/fr\/fame-event\/ciseaux\/","email":"info@famefestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50000476"},"sp":{"name":"Ciseaux","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/famefestival.be\/fr\/fame-event\/ciseaux\/","email":"info@famefestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50000476"},"nl":{"name":"Ciseaux","shortdescr":"Een opwekkende sprint door het queer geheugen van Montreal. Het wordt herleefd vanuit een feministisch standpunt met behulp van drag acts, documentair materiaal en gesproken tekst.","longdescr":"Twee actrices verkennen de bepalende momenten en plaatsen van Montreal's lesbische verleden van de afgelopen 70 jaar. Onderweg identificeren ze hardnekkige clich\u00e9s, stellen ze die in vraag en eigenen ze zich opnieuw toe.\nDeze herinneringen komen tot leven via drag king acts, documentair materiaal en de woorden van bekenden uit de seksuele diversiteit zoals Manon Mass\u00e9, Safia Nolin, Judith Lussier en Monique Giroux.\n\nIntiem hergebruiken we lesbofobe clich\u00e9s in een poging onszelf te ontdekken en te begrijpen.\nEn misschien zelfs om een gevoel van verbondenheid teweeg te brengen? Met humor, festiviteit en authenticiteit reflecteert het gezelschap Pleurer Dans' Douche op de ondervertegenwoordiging van queer vrouwen in de geschiedenisboeken en de mainstream media.\n","performers":null,"boxoffice_url":null,"website":"https:\/\/famefestival.be\/fr\/fame-event\/ciseaux\/","email":"info@famefestival.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50000476"}},"place":{"id":271867,"translations":{"de":{"name":"Centre Culturel et Sportif Tour \u00e0 Plomb","address_street_name":"rue de l'Abattoir","address_street_number":"20-26","address_street_box":null,"email":"touraplomb@brucity.be","website":"https:\/\/touraplomb.be\/","phone_contact":"+32 2 279 59 10","phone_booking":null,"address_zip":"10