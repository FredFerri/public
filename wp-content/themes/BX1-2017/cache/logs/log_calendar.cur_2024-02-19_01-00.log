tags":["kids","annee_art_nouveau"]},{"id":554601,"date_start":"2023-04-06","date_end":"2024-04-21","date_next":"2024-02-18","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-02-18T01:03:58+01:00","published_at":"2023-03-30T15:33:28+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":274601,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.21877559624976306,"languages":{"spoken":["nl","fr","en"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[40,36],"translations":{"de":["Grafische K\u00fcnste","Museen & Kunstzentren"],"pt":[null,null],"en":["Graphic art","Museums and art centers"],"it":["Arti grafiche","Musei e centri artistici"],"cn":[null,null],"fr":["Arts graphiques","Mus\u00e9es et art centers"],"sp":["Artes gr\u00e1ficas","Museos y centros de arte"],"nl":["Grafische kunst, vormgeving","Musea en kunstcentra"]}}},"translations":{"de":{"name":"N'appelez pas \u00e7a Art brut","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.artetmarges.be","email":"info@artetmarges.be","phone_contact":"+32 2 533 94 90","phone_booking":"+32 2 533 94 90","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.554601"},"pt":{"name":"N'appelez pas \u00e7a Art brut","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.artetmarges.be","email":"info@artetmarges.be","phone_contact":"+32 2 533 94 90","phone_booking":"+32 2 533 94 90","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.554601"},"en":{"name":"Don't call it Art brut","shortdescr":"Like a K-Way from the 1980s, the ART ET MARGES MUSEUM turns itself inside out to unfold an expanse of colours and shapes that you never knew existed! ","longdescr":"Like a K-Way from the 1980s, the ART ET MARGES MUSEUM turns itself inside out to unfold an expanse of colours and shapes that you never knew existed! At the bottom, a warning from Jean Dubuffet, the inventor of Art brut: \u201cYou will have to find another designation\u201d. The letter dates from 1984. With this terminological marker in place, Art en marge began its search for art that grows on the edges. Since then, the association has become the ART ET MARGES MUSEUM. How did its collection develop, how have its ambitions evolved, and what about the whole field around it, filled with all the names born of the Dubuffetian ban? Some answers can be found in this exhibition, which will evolve throughout the year.\r\n\r\nThe ART ET MARGES MUSEUM takes you into its reserves, brings out works that taste had relegated there, serves you its new discoveries on a rotating tray and questions the margin with artists from the contemporary scene who resolutely ask us the question of the limits of Art brut. Oops! Don't call it Art brut, he said!\r\n\r\nHIGHLIGHTS\r\nApr. 4, 2023\u2014July 2, 2023 Francis Goidts | Executive Master Food Design ARBA ESA\r\nJuly 6, 2023\u2014Nov. 5, 2023 Adalberto Colarelli | Shen \u00d6zdemir\r\nNov. 9, 2023\u2014Jan. 28, 2024 Margot | Pratique de l\u2019exposition ESA Saint-Luc Bruxelles\r\nFebr. 8, 2024\u2014Apr. 21, 2024 Norbert Moutier | \u00c9ric Croes\r\n(Attention: the museum is closed for installation between these periods)","performers":"Francis Goidts, Executive Master Food Design ARBA ESA, Adalberto Colarelli, Shen \u00d6zdemir, Margot, Pratique de l'exposition ESA Saint-Luc Bruxelles, Norbert Moutier, \u00c9ric Croes ","boxoffice_url":null,"website":"http:\/\/www.artetmarges.be","email":"info@artetmarges.be","phone_contact":"+32 2 533 94 90","phone_booking":"+32 2 533 94 90","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.554601"},"it":{"name":"N'appelez pas \u00e7a Art brut","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.artetmarges.be","email":"info@artetmarges.be","phone_contact":"+32 2 533 94 90","phone_booking":"+32 2 533 94 90","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.554601"},"cn":{"name":"N'appelez pas \u00e7a Art brut","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.artetmarges.be","email":"info@artetmarges.be","phone_contact":"+32 2 533 94 90","phone_booking":"+32 2 533 94 90","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.554601"},"fr":{"name":"N'appelez pas \u00e7a Art brut","shortdescr":"Tel un K-Way des ann\u00e9es 80, le ART ET MARGES MUS\u00c9E se retourne sur lui-m\u00eame pour d\u00e9ployer une \u00e9tendue de couleurs et de formes que vous ne soup\u00e7onniez pas !","longdescr":"Tel un K-Way des ann\u00e9es 80, le ART ET MARGES MUS\u00c9E se retourne sur lui-m\u00eame pour d\u00e9ployer une \u00e9tendue de couleurs et de formes que vous ne soup\u00e7onniez pas ! Au fond d\u2019une poche, une mise en garde de Jean Dubuffet, l\u2019inventeur de l\u2019Art brut : \u00ab il vous faudra trouver une autre d\u00e9signation \u00bb. La lettre date de 1984. Cette balise terminologique pos\u00e9e, Art en marge commen\u00e7ait ses prospections pour trouver un art qui pousse dans les lisi\u00e8res. Depuis, l\u2019association est devenue le ART ET MARGES MUS\u00c9E. Comment a grandi sa collection, comment ont \u00e9volu\u00e9 ses ambitions, et le champ tout autour, garni de toutes les appellations n\u00e9es de l\u2019interdiction dubuffetienne ? Des pistes de r\u00e9ponse sont \u00e0 trouver dans cette expo chantier qui \u00e9voluera tout au long de l'ann\u00e9e.\r\n\r\nLe ART ET MARGES MUS\u00c9E vous fait rentrer dans ses r\u00e9serves, en ressort les \u0153uvres que le go\u00fbt y avait rel\u00e9gu\u00e9, vous sert ses nouvelles d\u00e9couvertes sur un plateau tournant et interroge la marge avec des artistes de la sc\u00e8ne contemporaine qui nous posent r\u00e9solument la question des limites de l\u2019Art brut. Oups ! N\u2019appelez pas \u00e7a Art brut, il disait !\r\n\r\nFOCUS\r\n06.04.2023\u201402.07.2023 Francis Goidts | Executive Master Food Design ARBA ESA\r\n06.07.2023\u201405.11.2023 Adalberto Colarelli | Shen \u00d6zdemir\r\n09.11.2023\u201428.01.2024 Margot | Pratique de l\u2019exposition ESA Saint-Luc Bruxelles\r\n08.02.2024\u201421.04.2024 Norbert Moutier | \u00c9ric Croes\r\n(Attention : le mus\u00e9e est ferm\u00e9 pour montage entre ces p\u00e9riodes)\r\n\r\n","performers":"Francis Goidts, Executive Master Food Design ARBA ESA, Adalberto Colarelli, Shen \u00d6zdemir, Margot, Pratique de l'exposition ESA Saint-Luc Bruxelles, Norbert Moutier, \u00c9ric Croes ","boxoffice_url":null,"website":"http:\/\/www.artetmarges.be","email":"info@artetmarges.be","phone_contact":"+32 2 533 94 90","phone_booking":"+32 2 533 94 90","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.554601"},"sp":{"name":"N'appelez pas \u00e7a Art brut","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.artetmarges.be","email":"info@artetmarges.be","phone_contact":"+32 2 533 94 90","phone_booking":"+32 2 533 94 90","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.554601"},"nl":{"name":"Noem het geen Art brut","shortdescr":"Als een K-Way uit de jaren 1980 keert het ART ET MARGES MUSEUM zichzelf binnenstebuiten en ontvouwt een waaier van kleuren en vormen waarvan niemand het bestaan vermoedde!","longdescr":"Als een K-Way uit de jaren 1980 keert het ART ET MARGES MUSEUM zichzelf binnenstebuiten en ontvouwt een waaier van kleuren en vormen waarvan niemand het bestaan vermoedde! Helemaal onderaan staat een waarschuwing van Jean Dubuffet, de uitvinder van de art brut: \u201cZoek een andere benaming\u201d. De brief dateert uit 1984. Met deze terminologische kwestie begon Art en marge zijn zoektocht naar kunst die floreert aan de zijkant. Sindsdien is de vereniging uitgegroeid tot het ART ET MARGES MUSEUM. Hoe groeide de collectie, hoe evolueerden de ambities en de context, gevuld met alle namen die ontstonden uit de ban van Dubuffet? Enkele antwoorden zijn te vinden in deze tentoonstelling, die in de loop van het jaar zal evolueren.\r\n\r\nHet ART ET MARGES MUSEUM neemt u graag mee voor een duik in zijn reserves, dankzij werken die door de invloed van mode en smaak naar de achtergrond waren verdwenen, serveert u zijn nieuwe ontdekkingen op blaadje en stelt de marge in vraag, met de hulp van kunstenaars uit de hedendaagse scene die resoluut experimenteren met de grenzen van art brut. Oeps! Noem het geen art brut, zei hij!\r\n\r\nFOCUS\r\n06.04.2023\u201402.07.2023 Francis Goidts | Executive Master Food Design ARBA ESA\r\n06.07.2023\u201405.11.2023 Adalberto Colarelli | Shen \u00d6zdemir\r\n09.11.2023\u201428.01.2024Margot | Pratique de l\u2019exposition ESA Saint-Luc Bruxelles\r\n08.02.2024\u201421.04.2024 Norbert Moutier | \u00c9ric Croes\r\n(Let op: het museum is tussen deze periodes gesloten voor montage)\r\n","performers":"Francis Goidts, Executive Master Food Design ARBA ESA, Adalberto Colarelli, Shen \u00d6zdemir, Margot, Pratique de l'exposition ESA Saint-Luc Bruxelles, Norbert Moutier, \u00c9ric Croes ","boxoffice_url":null,"website":"http:\/\/www.artetmarges.be","email":"info@artetmarges.be","phone_contact":"+32 2 533 94 90","phone_booking":"+32 2 533 94 90","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.554601"}},"place":{"id":738,"translations":{"de":{"name":"Mus\u00e9e Art et marges","address_street_name":"Rue Haute","address_street_number":"314","address_street_box":null,"email":"info@artetmarges.be","website":"http:\/\/www.artetmarges.be","phone_contact":"+32 2 533 94 90","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Haute, 314","address_line2":"1000 Bruxelles","description_web":"Art brut - Outsider Art - Zeitgen\u00f6ssische Kunst\r\n\r\nDas Museum Art et Marges zeigt eine Sammlung, die seit den 1980er-Jahren kontinuierlich w\u00e4chst. Dabei handelt es sich um Kunst abseits des Mainstreams, die einen Blick auf die autodidaktischen K\u00fcnslter wirft, Kunstateliers f\u00fcr Menschen mit geistiger Behinderung oder in Psychiatrien. \r\nIn den Ausstellungen mischen sich K\u00fcnstler diesseits und jenseits der Grenze des \"Au\u00dfenseitertums\" (engl. Begriff \"Art Outsider\"), die die Kunst und deren Beschr\u00e4nkungen hinterfragt.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Art et marges mus\u00e9e","address_street_name":"Rue Haute","address_street_number":"314","address_street_box":null,"email":"info@artetmarges.be","website":"http:\/\/www.artetmarges.be","phone_contact":"+32 2 533 94 90","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Haute, 314","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Art & marges museum","address_street_name":"Rue Haute","address_street_number":"314","address_street_box":null,"email":"info@artetmarges.be","website":"http:\/\/www.artetmarges.be","phone_contact":"+32 2 533 94 90","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Haute, 314","address_line2":"1000 Bruxelles","description_web":"Museum of outsider art. Since its founding in 1984 and the first exhibition of 1986, Art & Marge \u2013 now the \u2018art )&( marges [margins] museum\u2019 \u2013 promotes artists outside the mainstream. These self-taught artists, often called \u201coutsider artists\u201d, work either individually or in creative workshops in institutions for people who are mentally unwell or who are mentally challenged. In addition to the permanent collection,  temporary exhibitions will establish a dynamic dialogue with paintings by professional artists from the mainstream who are active in their cultural surroundings \u2013 the boundary between \u2018insider\u2019 and \u2018outsider\u2019 art?   The \u2018Art & Marges\u2019 museum is not a ghetto museum but a venue for exchange, where individuality is of prime importance and where all efforts are made to make all target groups feel at home.\r\n\r\nOpen Fridays, Saturdays and Sundays between 11.00 am and 5.30 pm by appointment only.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Mus\u00e9e Art et marges","address_street_name":"Rue Haute","address_street_number":"314","address_street_box":null,"email":"info@artetmarges.be","website":"http:\/\/www.artetmarges.be","phone_contact":"+32 2 533 94 90","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Haute, 314","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Art et marges mus\u00e9e","address_street_name":"Rue Haute","address_street_number":"314","address_street_box":null,"email":"info@artetmarges.be","website":"http:\/\/www.artetmarges.be","phone_contact":"+32 2 533 94 90","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Haute, 314","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Art et marges mus\u00e9e","address_street_name":"Rue Haute","address_street_number":"314","address_street_box":null,"email":"info@artetmarges.be","website":"http:\/\/www.artetmarges.be","phone_contact":"+32 2 533 94 90","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Haute, 314","address_line2":"1000 Bruxelles","description_web":"Situ\u00e9 au c\u0153ur de Bruxelles, le Art et marges mus\u00e9e, mus\u00e9e d\u2019art brut - contemporain - outsider art, questionne l\u2019art et ses fronti\u00e8res. Sa collection s\u2019est constitu\u00e9e d\u00e8s le milieu des ann\u00e9es 80 aupr\u00e8s d\u2019artistes autodidactes, d\u2019ateliers artistiques pour personnes porteuses d\u2019un handicap mental ou d\u2019ateliers en milieu psychiatrique. Elle se compose aujourd\u2019hui de plus de 4000 \u0153uvres internationales produites en dehors des sentiers fr\u00e9quent\u00e9s de l\u2019art. Ses expositions temporaires, au rythme de deux \u00e0 trois par an, m\u00ealent artistes de part et d\u2019autre de la marge et questionnent l\u2019art et sa d\u00e9finition-m\u00eame. ","description_print":"Mus\u00e9e d'art outsider","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Museo Art)&(Marges","address_street_name":"Rue Haute","address_street_number":"314","address_street_box":null,"email":"info@artetmarges.be","website":"http:\/\/www.artetmarges.be","phone_contact":"+32 2 533 94 90","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Haute, 314","address_line2":"1000 Bruxelles","description_web":"Desde su creaci\u00f3n, el Centro de Investigaci\u00f3n y Difusi\u00f3n del arte outsider Art en Marge (que se convirti\u00f3 posteriormente en el museo Art)&Marges) aboga por los artistas que no forman parte del circuito cultural oficial. Los conocidos actualmente como \u00aboutsiders\u00bb (ver glosario) son creadores autodidactas que trabajan solos o en talleres creativos para personas psicol\u00f3gicamente vulnerables o con alguna discapacidad mental. Algunos son internos de residencias para discapacitados mentales, hospitales psiqui\u00e1tricos, y otros son trabajadores o extrabajadores de una amplia gama de profesiones: fot\u00f3grafos, anticuarios, zapateros, m\u00fasicos...","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Art & marges museum","address_street_name":"Hoogstraat","address_street_number":"314","address_street_box":null,"email":"info@artetmarges.be","website":"http:\/\/www.artetmarges.be","phone_contact":"+32 2 533 94 90","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Hoogstraat, 314","address_line2":"1000 Bruxelles","description_web":"Outsiderkunst museum. Sinds zijn oprichting in 1984 en de eerste tentoonstelling in 1986, verdedigt de vzw Art en Marge - het huidige art )&( marges museum - kunstenaars die uit de boot van het offici\u00eble culturele circuit vallen. Die autodidactische kunstenaars worden \u201coutsiders\u201d genoemd en werken alleen of in creatieve workshops voor zieke of gehandicapte personen. Naast de permanente verzameling, zorgen tijdelijke tentoonstellingen voor een dynamische dialoog met de werken van professionele kunstenaars die actief zijn in het offici\u00eble culturele milieu, om de grenzen van de in- en outsiderkunst af te tasten. art )&( marges museum is geen ghettomuseum maar een plaats van uitwisseling, een ruimte waarin de individualiteit hoogtij viert en waarin alles in het werk gesteld wordt om ervoor te zorgen dat alle doelgroepen zich thuis voelen.\r\n\r\nOpen op vrijdag, zaterdag en zondag tussen 11.00 en 17.30 uur, alleen op afspraak.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[2],"translations":{"de":["Marollen"],"pt":[null],"en":["Marolles"],"it":["Marolles"],"cn":[null],"fr":["Marolles"],"sp":["Marolles"