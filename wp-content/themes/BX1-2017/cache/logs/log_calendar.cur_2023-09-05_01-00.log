18 anni"],"cn":[null,null,null,null,null],"fr":["Famille","Seniors","LGTBQIA","Aveugle\/malvoyant","Jeunes 15-18 ans"],"sp":["Familias","Personas de la tercera edad","LGTBQIA","Personas invidentes o con problemas de visi\u00f3n","J\u00f3venes de 15 a 18 a\u00f1os"],"nl":["Familie","Senioren","LGTBQIA","Blind\/slechtziend","Jongeren 15-18 j."]}},"educational_targets":{"list":[],"translations":{}},"tags":["kids"]},{"id":50001669,"date_start":"2023-09-10","date_end":"2023-09-10","date_next":"2023-09-10","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2023-09-01T11:00:02+02:00","published_at":"2023-09-01T10:47:30+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":true,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":284441,"facebook_link":null,"import_origin":null,"is_part_of":"BD Comic Strip Festival","sub_type":"tour","ranking":1.2599210498948732,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{}},"translations":{"de":{"name":"Visite guid\u00e9e \u00e0 pied gratuite - Statues Le Chat, fresques BD au centre-ville & Mus\u00e9e de la BD","shortdescr":null,"longdescr":"Le 9e art fait partie de l'ADN de Bruxelles. Au d\u00e9tour d'une rue, au c\u0153ur d'un parc ou dans l'ambiance feutr\u00e9e d'un mus\u00e9e, la BD a, depuis longtemps, quitt\u00e9 le cadre strict de ses cases pour enchanter la ville et le quotidien de ses habitants. C'est particuli\u00e8rement le cas pour le centre-ville o\u00f9 bouillonnent un v\u00e9ritable concentr\u00e9 de ces h\u00e9ros et h\u00e9ro\u00efnes de papiers. Et pour mieux les appr\u00e9hender, le BD Comic Strip Festival vous propose une visite guid\u00e9e afin de (re)d\u00e9couvrir ces tr\u00e9sors, permanents ou \u00e9ph\u00e9m\u00e8res. Pour commencer, une balade dans le Parc de Bruxelles o\u00f9 sont encore expos\u00e9es, jusqu'au 10 septembre, les statues de l'exposition Le Chat d\u00e9ambule. La visite vous m\u00e8nera ensuite \u00e0 travers les rues et ruelles du centre pour admirer les fresques d'une partie du fameux parcours BD. Enfin, le parcours se terminera au Mus\u00e9e de la BD (CBBD). Apr\u00e8s une introduction, vous aurez la libert\u00e9 de visiter les lieux directement, o\u00f9 de revenir quand bon vous semble gr\u00e2ce \u00e0 un ticket d\u2019entr\u00e9e valable jusqu\u2019au 31\/12\/2023 qui vous est offert !\n\nVisite \u00e0 pied gratuite sur r\u00e9servation\nLieu de d\u00e9part : BIP - rue Royale 2\nDur\u00e9e de la visite: 2h\nDistance: 4km\nLieu d'arriv\u00e9e : Mus\u00e9e de la BD (CBBD)","performers":null,"boxoffice_url":"https:\/\/shop.utick.net\/?module=ACTIVITYSERIEDETAILS&pos=AGENDABRUSSELS&s=B25049D9-24FD-DA70-5018-7BA8F368568A","website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50001669"},"pt":{"name":"Visite guid\u00e9e \u00e0 pied gratuite - Statues Le Chat, fresques BD au centre-ville & Mus\u00e9e de la BD","shortdescr":null,"longdescr":"Le 9e art fait partie de l'ADN de Bruxelles. Au d\u00e9tour d'une rue, au c\u0153ur d'un parc ou dans l'ambiance feutr\u00e9e d'un mus\u00e9e, la BD a, depuis longtemps, quitt\u00e9 le cadre strict de ses cases pour enchanter la ville et le quotidien de ses habitants. C'est particuli\u00e8rement le cas pour le centre-ville o\u00f9 bouillonnent un v\u00e9ritable concentr\u00e9 de ces h\u00e9ros et h\u00e9ro\u00efnes de papiers. Et pour mieux les appr\u00e9hender, le BD Comic Strip Festival vous propose une visite guid\u