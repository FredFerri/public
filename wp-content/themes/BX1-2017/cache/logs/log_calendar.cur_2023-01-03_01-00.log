:["Voorzieningen voor blinde en slechtziende personen","Assistentiehonden","Toegankelijk voor voetgangers met hulpmiddelen"],"en":["Facilities for blind and partially-sighted persons","Assistance dogs","Accessible to pedestrians with mobility aids"],"de":["Anpassungen f\u00fcr blinde und sehbehinderte Menschen","Assistenzhund","Barrierefrei f\u00fcr Fu\u00dfg\u00e4nger mit Gehhilfe"],"it":[null,null,null],"sp":[null,null,null],"pt":[null,null,null],"cn":[null,null,null]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-12-13T15:05:04+01:00","published_at":"2022-12-07T09:03:17+01:00","backoffice_id":266746,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":0.35962828892923},{"id":547824,"date_start":"2023-01-19","date_end":"2023-03-18","date_next":"2023-01-19","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung","it":null,"sp":null,"pt":null,"cn":null}},"others":{"list":[24,30],"translations":{"fr":["Galeries d'art","Peinture"],"nl":["Galeries","Schilderkunst"],"en":["Art Galleries","Painting"],"de":["Kunstgalerien","Malerei"],"it":[null,null],"sp":[null,null],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Planetarium de Julien Meert","shortdescr":"Pour sa deuxi\u00e8me exposition personnelle dans la galerie Sorry We\u2019re Closed, \r\nJulien Meert propose avec \u00ab Planetarium \u00bb une nouvelle s\u00e9rie de peintures \r\npanoramiques horizontales, passant du portrait \u00e0 la sc\u00e8ne.","longdescr":"Pour sa deuxi\u00e8me exposition personnelle dans la galerie Sorry We\u2019re Closed, \r\nJulien Meert propose avec \u00ab Planetarium \u00bb une nouvelle s\u00e9rie de peintures \r\npanoramiques horizontales, passant du portrait \u00e0 la sc\u00e8ne.\r\n\r\nCe renversement de format permet \u00e0 l\u2019artiste de faire dialoguer plusieurs \r\n personnages\/entit\u00e9s au sein d\u2019un ensemble de sc\u00e8nes picturales. Julien Meert a cette \r\nparticularit\u00e9 d\u2019aborder la peinture sous un angle dramaturgique.\r\n\r\nDans l\u2019exposition \u00abPlanetarium\u00bb, il est question de l\u2019absurdit\u00e9 de notre condition \r\nd\u2019\u00eatres humains, vivants sur une plan\u00e8te en flottaison dans une immensit\u00e9 infinie.\r\n\"Planetarium\" est cartographie de constellations, m\u00e9taphore des familles qui \r\ncomposent le travail et dont l\u2019artiste choisit de montrer un aper\u00e7u.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.sorrywereclosed.com\/","email":"info@sorrywereclosed.com","phone_contact":null,"phone_booking":"+32 478 35 42 13","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.547824"},"nl":{"name":"Planetarium van Julien Meert","shortdescr":"Voor zijn tweede persoonlijke tentoonstelling in de galerij Sorry We\u2019re Closed \r\nstelt Julien Meert met \u201cPlanetarium\u201d een nieuwe reeks horizontale \r\npanoramische schilderijen voor, gaande van portretten tot taferelen.","longdescr":"Voor zijn tweede persoonlijke tentoonstelling in de galerij Sorry We\u2019re Closed \r\nstelt Julien Meert met \u201cPlanetarium\u201d een nieuwe reeks horizontale \r\npanoramische schilderijen voor, gaande van portretten tot taferelen.\r\n\r\nHet omgedraaide formaat stelt de kunstenaar in staat om verschillende personages of \r\nentiteiten met elkaar in dialoog te laten treden in een geheel van geschilderde\r\ntaferelen. De schilderkunst bekijken vanuit het perspectief van de dramaturg is een van  de bijzondere kenmerken die Julien Meert typeert.\r\n\r\nIn de tentoonstelling \u201cPlanetarium\u201d draait alles rond de absurditeit van onze toestand \r\nals menselijke wezens, levend op een planeet die zweeft in een oneindige\r\nuitgestrektheid.\r\n\r\n\u201cPlanetarium\u201d brengt constellaties in kaart. Een metafoor voor de families die deel \r\nuitmaken van het werk en voor hun leven waarin de kunstenaar ons laat binnenkijken. \r\nMetafysische en existenti\u00eble vragen die met een zekere theatraliteit aangekaart \r\nworden en die we ook terugvinden in de tekeningen en video\u2019s van de kunstenaar.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.547824"},"en":{"name":"Planetarium de Julien Meert","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.547824"},"de":{"name":"Planetarium de Julien Meert","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.547824"},"it":{"name":"Planetarium de Julien Meert","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.547824"},"sp":{"name":"Planetarium de Julien Meert","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.547824"},"pt":{"name":"Planetarium de Julien Meert","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.547824"},"cn":{"name":"Planetarium de Julien Meert","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.547824"}},"place":{"id":242439,"translations":{"fr":{"name":"Sorry We're Closed","address_street_name":"Rue des Minimes","address_street_number":"39","address_street_box":null,"email":"info@sorrywereclosed.com","website":"http:\/\/www.sorrywereclosed.com","phone_contact":"+32 478 35 42 13","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Minimes, 39","address_line2":"1000 Bruxelles","description_web":"Sorry We\u2019re Closed est une galerie d'art contemporain cr\u00e9\u00e9 par Sebastien Janssen qui met l'accent sur des artistes belges et \u00e9trangers, \u00e9mergents et en mi-carri\u00e8re. Depuis 2015 la galerie est situ\u00e9e dans un nouvel espace dans le coeur de Bruxelles. Le lieu tient un programme d'exposition diversifi\u00e9 avec des expositions individuelles des artistes de galerie ainsi que des expositions de groupe et des projets sp\u00e9ciaux.","description_print":"","booking_url":null,"sort_order":"SORRY WE'RE CLOSED","virtual_visit":null},"nl":{"name":"Sorry We're Closed","address_street_name":"Minimenstraat","address_street_number":"39","address_street_box":null,"email":"info@sorrywereclosed.com","website":"http:\/\/www.sorrywereclosed.com","phone_contact":"+32 478 35 42 13","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Minimenstraat, 39","address_line2":"1000 Brussel","description_web":"Sorry We\u2019re Closed is een galerie voor hedendaagse kunst opgericht door Sebastien Janssen die zich richt op binnen- en buitenlands kunstenaars, zowel opkomend talent als in mid-career.\r\nSinds 2015 is de galerie gevestigd in een nieuwe ruimte in het centrum van Brussel. Het brede tentoonstellingsprogramma werd behouden, met solo- en groepstentoonstellingen van de gepromote artiesten, alsook speciale projecten.","description_print":"","booking_url":null,"sort_order":"SORRY WE'RE CLOSED","virtual_visit":null},"en":{"name":"Sorry We're Closed","address_street_name":"Rue des Minimes","address_street_number":"39","address_street_box":null,"email":"info@sorrywereclosed.com","website":"http:\/\/www.sorrywereclosed.com","phone_contact":"+32 478 35 42 13","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue des Minimes, 39","address_line2":"1000 Brussels","description_web":"Sorry We\u2019re Closed is a contemporary art gallery created by Sebastien Janssen. The focus of the gallery is upon mid-career and emerging artists from Belgium and abroad. Since 2015, the gallery is located in a new 130 meter square space, in the center of Brussels. The gallery maintains a diverse exhibition program with solo exhibitions of the gallery artists as well as group exhibitions and special projects as editing artists jewels or showing vernacular photography.\r\n\r\n","description_print":"","booking_url":null,"sort_order":"SORRY WE'RE CLOSED","virtual_visit":null},"de":{"name":"Sorry We're Closed","address_street_name":"Rue des Minimes","address_street_number":"39","address_street_box":null,"email":"info@sorrywereclosed.com","website":"http:\/\/www.sorrywereclosed.com","phone_contact":"+32 478 35 42 13","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue des Minimes, 39","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Sorry We're Closed","address_street_name":"Rue des Minimes","address_street_number":"39","address_street_box":null,"email":"info@sorrywereclosed.com","website":"http:\/\/www.sorrywereclosed.com","phone_contact":"+32 478 35 42 13","phone_booking":null,"address