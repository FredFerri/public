egion":"brussels","last_updated_at":"2022-05-12T10:05:07+02:00","published_at":"2013-10-19T01:20:03+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":243945,"translations":{"fr":{"name":"Centre Albert Marinus (Mus\u00e9e de Woluwe-Saint-Lambert)","address_street_name":"Rue de la Charrette","address_street_number":null,"address_street_box":null,"email":"info@albertmarinus.org","website":"http:\/\/www.albertmarinus.org","phone_contact":"+32 2 762 62 14","phone_booking":null,"address_zip":"1200","address_city":"Woluwe-Saint-Lambert","address_line1":"Rue de la Charrette","address_line2":"1200 Woluwe-Saint-Lambert","description_web":"Le centre a \u00e9t\u00e9 cr\u00e9\u00e9e en l\u2019honneur d\u2019Albert Marinus, sociologue, folkloriste et humaniste de r\u00e9putation mondiale. Elle a pour but, au travers d'expositions, de sensibiliser le public au folklore, aux arts et traditions populaires en tant que patrimoine culturel.\r\nEn tant qu\u2019association sans but lucratif, il poursuit un triple but scientifique :\r\nla sauvegarde et la diffusion des \u00e9crits d'Albert Marinus, la poursuite de la recherche folklorique et sociologique selon ses conceptions en encourageant ou en d\u00e9veloppant des \u00e9tudes ax\u00e9es sur le patrimoine immat\u00e9riel et la vie populaire, et la sensibilisation du public au patrimoine immat\u00e9riel, aux arts et traditions populaires en tant que patrimoine culturel, mais aussi outil de connaissance et de r\u00e9flexion sur la vie sociale. Le centre a r\u00e9cemment \u00e9t\u00e9 reconnu par l'Unesco.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Albert Marinus Centrum  (Museum van Sint-Lambrechts-Woluwe)","address_street_name":"Karrestraat","address_street_number":null,"address_street_box":null,"email":"info@albertmarinus.org","website":"http:\/\/www.albertmarinus.org","phone_contact":"+32 2 762 62 14","phone_booking":null,"address_zip":"1200","address_city":"Sint-Lambrechts-Woluwe","address_line1":"Karrestraat","address_line2":"1200 Sint-Lambrechts-Woluwe","description_web":"Het Albert Marinuscentrum is een gemeentelijk documentatiecentrum dat d.m.v. wetenschappelijke, culturele en sensibiliserende activiteiten rond erfgoed en folklore het publiek wil sensibiliseren voor de volkskunsten en \u2013tradities.  Dit centrum werd opgericht ter ere van internationaal gereputeerd socioloog, volkskundige en humanist Albert Marinus wiens teksten en onderzoek op die manier verspreid en verdergezet worden. \r\nHet Albert Marinuscentrum in Sint-Lambrechts-Woluwe werd onlangs door Unesco erkend als erfgoedbeschermer. Dankzij de prestigieuze accreditatie wordt het centrum een echte autoriteit op het gebied van immaterieel cultureel erfgoed.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Albert Marinus Centre","address_street_name":"Rue de la Charrette","address_street_number":null,"address_street_box":null,"email":"info@albertmarinus.org","website":"http:\/\/www.albertmarinus.org","phone_contact":"+32 2 762 62 14","phone_booking":null,"address_zip":"1200","address_city":"Woluwe-Saint-Lambert","address_line1":"Rue de la Charrette","address_line2":"1200 Woluwe-Saint-Lambert","description_web":"This centre was established in honour of Albert Marinus, sociologist, world renowned folklorist, and humanist. It aims, through exhibitions, to increase public awareness of folklore, folk arts and traditions as a cultural heritage.The centre has recently been recognized by UNESCO","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Centre Albert Marinus (Museum Woluwe-Saint-Lambert)","address_street_name":"Rue de la Charrette","address_street_number":null,"address_street_box":null,"email":"info@albertmarinus.org","website":"http:\/\/www.albertmarinus.org","phone_contact":"+32 2 762 62 14","phone_