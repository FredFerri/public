oitsfort","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":null,"facebook_id":null,"backoffice_id":196,"location":{"lat":50.80936777,"lon":4.40413914},"region":"brussels","last_updated_at":"2022-10-11T01:36:06+02:00","published_at":"2013-10-19T01:13:21+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels.imgix.net\/explore-b87af0ef627eb5a49da17981baa9fe96c356ba1a.jpg","width":800,"height":400,"ratio":2,"translations":{"fr":{"title":"Parcours de femmes \u00e0 Bruxelles : aristocrates, b\u00e9guines, poissonni\u00e8res et stylistes","copyright":null},"nl":{"title":"Parcours de femmes \u00e0 Bruxelles : aristocrates, b\u00e9guines, poissonni\u00e8res et stylistes","copyright":null},"en":{"title":"Parcours de femmes \u00e0 Bruxelles : aristocrates, b\u00e9guines, poissonni\u00e8res et stylistes","copyright":null}}}],"dates":[{"day":"2022-10-31","doors":null,"start":"14:30:00","end":"16:30:00","is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":0}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-11T01:36:06+02:00","published_at":"2022-10-08T03:30:21+02:00","backoffice_id":250396,"import_origin":"explore","sub_type":"other","show_in_agenda":true,"ranking":1},{"id":543790,"date_start":"2022-10-31","date_end":"2022-11-04","date_next":"2022-10-31","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":90,"translations":{"fr":"Animations","nl":"Animaties","en":"Animations","de":"Animationen"}},"others":{}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Retour \u00e0 la ferme NBB","shortdescr":"L\u2019automne est de retour et l\u2019heure de la grande r\u00e9colte a sonn\u00e9 ! Saurez-vous aider Victor le cochon-tirelire lors du grand jeu de la ferme ?","longdescr":"Apr\u00e8s une saison d\u2019\u00e9t\u00e9 r\u00e9ussie \u00e0 la ferme, Victor le cochon-tirelire revient au mus\u00e9e.  Enfile tes sabots, attrape ta fourche et retrousse tes manches ! Participe \u00e0 la sauvegarde de la ferme et, qui sait, peut-\u00eatre qu\u2019une belle r\u00e9colte t\u2019attendra \u00e0 la fin de la qu\u00eate !  \r\n\r\nD\u00e9couvrez le mus\u00e9e \u00e0 l\u2019aide de livrets d\u2019activit\u00e9s ludiques adapt\u00e9s \u00e0 l\u2019\u00e2ge de votre enfant. Ces derniers sont aussi bien disponibles en Fran\u00e7ais qu\u2019en N\u00e9erlandais sur simple demande \u00e0 l\u2019accueil du mus\u00e9e. Le jeu est supervis\u00e9 par les parents, ou tout autre accompagnant, et constitue une excellente sortie pour toute la famille.  \r\n\r\n  \r\n\r\nQUAND : La ferme de Victor ouvre ses portes du lundi 31 octobre au vendredi 4 novembre, de 9h00 \u00e0 17h00. Veuillez noter que le mus\u00e9e sera ferm\u00e9 le mardi 1er novembre.  \r\n\r\nPOUR QUI : Tous les amis des animaux de 4 \u00e0 6 ans et les fermiers en herbe de 7 \u00e0 12 ans sont invit\u00e9s \u00e0 retrousser leurs manches.  \r\n\r\nDUREE : L\u2019aventure dure de 45 minutes \u00e0 1h00.  \r\n\r\nVictor le cochon-tirelire a besoin de toute l\u2019aide possible. Notre activit\u00e9 est donc totalement GRATUITE.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.nbbmuseum.be","email":"museum@nbb.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.543790"},"nl":{"name":"Welkom terug op de NBBoerderij!","shortdescr":"De herfst is in ons land! Het is tijd om de grote oogst binnen te halen. Help jij Victor het Spaarvarken met het grote boerderijspel in het museum van de Nationale Bank van Belgi\u00eb?","longdescr":"Na het geslaagde zomerseizoen op de boerderij keert Victor het spaarvarken terug naar het museum. Pak jouw klompen, neem de hooivork en steek jouw handen uit de mouwen! En wie weet heb je op het einde van de zoektocht een mooie oogst! \r\n\r\nVerken het museum aan de hand van speelse doe-boekjes op maat van de leeftijd van jouw kind. Deze zijn zowel in het Frans als het Nederlands te verkrijgen. Het spel wordt begeleid door de ouders (of andere begeleiders) en is een fijne uitstap voor het hele gezin. \r\n\r\n \r\n\r\nWANNEER: Victors boerderij opent de deuren van maandag 31 oktober tot vrijdag 4 november, telkens van 9u tot 17u. Opgelet: Op dinsdag 1 november is het museum gesloten. \r\n\r\nVOOR WIE: Alle dierenvrienden van 4 tot 6 jaar en alle boeren-in-sp\u00e9 van 7 tot 12 jaar zijn welkom om hun handen uit de mouwen te steken. \r\n\r\nDUUR: Het avontuur op de boerderij duurt ongeveer 45 minuten tot 1 uur. \r\n\r\nPRIJS: Victor het spaarvarken kan alle hulp gebruiken. Onze activiteit is dan ook volledig GRATIS!","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.543790"},"en":{"name":"Welkom terug op de NBBoerderij!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.543790"},"de":{"name":"Welkom terug op de NBBoerderij!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.543790"},"it":{"name":"Welkom terug op de NBBoerderij!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.543790"},"sp":{"name":"Welkom terug op de NBBoerderij!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.543790"},"pt":{"name":"Welkom terug op de NBBoerderij!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.543790"},"cn":{"name":"Welkom terug op de NBBoerderij!","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.543790"}},"place":{"id":220155,"translations":{"fr":{"name":"Mus\u00e9e de la Banque Nationale de Belgique","address_street_name":"rue Montagne aux Herbes potag\u00e8res","address_street_number":"57","address_street_box":null,"email":"museum@nbb.be","website":"http:\/\/www.nbbmuseum.be","phone_contact":"+32 2 221 22 06","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"rue Montagne aux Herbes potag\u00e8res, 57","address_line2":"1000 Bruxelles","description_web":"Depuis 2018, le mus\u00e9e de la Banque nationale de Belgique est install\u00e9 dans un magnifique b\u00e2timent bancaire datant du XIXe si\u00e8cle. \r\n\r\nUn premier circuit dans le mus\u00e9e aborde les r\u00f4les d\u2019une banque centrale \u00e0 travers une sc\u00e9nographie interactive. Gr\u00e2ce \u00e0 son audioguide, le visiteur peut ainsi tant\u00f4t en apprendre un peu plus sur l\u2019\u00e9mission des pi\u00e8ces et des billets, tant\u00f4t tester ses connaissances sur l\u2019euro ou encore \u00eatre amen\u00e9 \u00e0 contr\u00f4ler le niveau d\u2019inflation. \r\n\r\nLe second circuit retrace l\u2019\u00e9volution des moyens de payement et fait la part belle aux collections historiques du mus\u00e9e. Monnaies marchandises, anciens objets de change, anciennes pi\u00e8ces et billets se c\u00f4toient ainsi dans une fresque th\u00e9matique et chronologique qui fera voyager le visiteur dans le temps et \u00e0 travers le monde.\r\n\r\nEnfin, le dernier circuit regroupe une s\u00e9rie d\u2019objets qui d\u00e9montre \u00e0 quel point l\u2019argent est pr\u00e9sent dans notre quotidien.\r\n\r\nLes visites de groupe sont organis\u00e9es \u00e0 partir de 10 personnes - maximum 25. Elles sont gratuites et durent environ 1 heure. Les r\u00e9servations se font via le formulaire en ligne disponible sur le site internet http:\/\/www.nbbmuseum.be\/fr\/booking. \r\nRenseignements : 02 221 22 06 \u2013 museum@nbb.be","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Museum van de Nationale Bank van Belgi\u00eb","address_street_name":"Warmoesberg","address_street_number":"57","address_street_box":null,"email":"museum@nbb.be","website":"http:\/\/www.nbbmuseum.be","phone_contact":"+32 2 221 22 06","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Warmoesberg, 57","address_line2":"1000 Brussel","description_web":"Sinds 2018 is het museum van de Nationale Bank van Belgi\u00eb in een prachtig 19de-eeuwse bankgebouw ondergebracht.\r\n\r\nAan de hand van interactieve opstellingen focust een eerste parcours in het museum op de taken van een centrale bank. Met behulp van een audiogids kan de bezoeker meer te weten komen over de uitgifte van munten en biljetten, zijn of haar kennis van de euro testen of proberen de inflatie onder controle te houden.\r\nHet tweede parcours schetst de evolutie van de betaalmiddelen en zet hierbij de collecties van het museum in de kijker. Goederengeld, oude ruilmiddelen, munten en biljetten vormen een thematisch en chronologisch geheel, waarbij de bezoeker wordt meegenomen op een reis in de tijd en over heel de wereld.\r\nHet derde parcours tenslotte toont een aantal voorwerpen waarmee wordt aangetoond hoe sterk geld aanwezig is in ons dagelijkse leven.\r\n\r\nGroepsbezoeken kunnen vanaf 10 personen, maximum 25. Ze zijn gratis en duren ongeveer 1 uur. Reserveren graag via de website van het museum https:\/\/www.nbbmuseum.be\/nl\/booking.\r\nMeer informatie: tel 02 221 22 06 - museum@nbb.be  ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Museum of the National Bank of Belgium","address_street_name":"rue Montagne aux Herbes potag\u00e8res","address_street_number":"57","address_street_box":null,"email":"museum@nbb.be","website":"http:\/\/www.nbbmuseum.be","phone_contact":"+32 2 221 22 06","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"rue Montagne aux Herbes potag\u00e8res, 57","address_line2":"1000 Brussels","description_web":"Since 2018 the museum of the National Bank of Belgium is housed in a splendid 19t century bank building situates at a mere 10-minute walk from the Central Station.\r\n\r\nThe first part of the exhibition pays particular attention to the role and the functions of the National Bank. By use of an audio guide and interactive displays, the visitor will no doubt discover lots of interesting facts about the issue of notes and coins, test their knowledge of the euro, or even try to control the rate of inflation.\r\n\r\nThe second part paints an overall picture of the evolution of money, and showcases many wonderful objects from the museum collection. Commodity money, diverse and peculiar objects once used for bartering, coins and notes... These many various pieces are purposely put in a thematical and chronological context which in the end will provide the visitor with a fascinating overview.\r\n\r\nThe third part of the exhibition proves just how much money is present in our day to day life by displaying a wide range of objects, some everyday and trivial, some quirky.\r\n\r\nGroup visits can be from 10 people up to 25. They are free and take about 1 hour. Please book via the website of the museum https:\/\/www.nbbmuseum.be\/en\/booking.\r\nMore information: 02 221 22 06 - museum@nbb.be ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Mus\u00e9e de la Banque Nationale de Belgique","address_street_name":"rue Montagne aux Herbes potag\u00e8res","address_street_number":"57","address_street_box":null,"email":"museum@nbb.be","website":"http:\/\/www.nbbmuseum.be","phone_contact":"+32 2 221 22 06","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"rue Montagne aux Herbes potag\u00e8res, 57","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Mus\u00e9e de la Banque Nationale de Belgique","address_street_name":"rue Montagne aux Herbes potag\u00e8res","address_street_number":"57","address_street_box":null,"email":"museum@nbb.be","website":"http:\/\/www.nbbmuseum.be","phone_contact":"+32 2 221 22 06","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"rue Montagne aux Herbes potag\u00e8res, 57","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Mus\u00e9e de la Banque Nationale de Belgique","address_street_name":"rue Montagne aux Herbes potag\u00e8res","address_street_number":"57","address_street_box":null,"email":"museum@nbb.be","website":"http:\/\/www.nbbmuseum.be","phone_contact":"+32 2 221 22 06","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"rue Montagne aux Herbes potag\u00e8res, 57","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Mus\u00e9e de la Banque Nationale de Belgique","address_street_name":"rue Montagne aux Herbes potag\u00e8res","address_street_number":"57","address_street_box":null,"email":"museum@nbb.be","website":"http:\/\/www.nbbmuseum.be","phone_contact":"+32 2 221 22 06","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"rue Montagne aux Herbes potag\u00e8res, 57","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Mus\u00e9e de la Banque Nationale de Belgique","address_street_name":"rue Montagne aux Herbes potag\u00e8res","address_street_number":"57","address_street_box":null,"email":"museum@nbb.be","website":"http:\/\/www.nbbmuseum.be","phone_contact":"+32 2 221 22 06","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"rue Montagne aux Herbes potag\u00e8res, 57","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":[],"zones":{"list":[19],"translations":{"fr":["Centre"],"nl":["Centrum"],"en":["Centre"]}},"neca":null,"facebook_id":null,"backoffice_id":592,"location":{"lat":50.84984775,"lon":4.35727802},"region":"brussels","last_updated_at":"2022-10-13T11:05:11+02:00","published_at":"2013-10-19T01:13:39+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":220155,"translations":{"fr":{"name":"Mus\u00e9e de la Banque Nationale de Belgique","address_street_name":"rue Montagne aux Herbes potag\u00e8res","address_street_number":"57","address_street_box":null,"email":"museum@nbb.be","website":"http:\/\/www.nbbmuseum.be","phone_contact":"+32 2 221 22 06","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"rue Montagne aux Herbes potag\u00e8res, 57","address_line2":"1000 Bruxelles","description_web":"Depuis 2018, le mus\u00e9e de la Banque nationale de Belgique est install\u00e9 dans un magnifique b\u00e2timent bancaire datant du XIXe si\u00e8cle. \r\n\r\nUn premier circuit dans le mus\u00e9e aborde les r\u00f4les d\u2019une banque centrale \u00e0 travers une sc\u00e9nographie interactive. Gr\u00e2ce \u00e0 son audioguide, le visiteur peut ainsi tant\u00f4t en apprendre un peu plus sur l\u2019\u00e9mission des pi\u00e8ces et des billets, tant\u00f4t tester ses connaissances sur l\u2019euro ou encore \u00eatre amen\u00e9 \u00e0 contr\u00f4ler le niveau d\u2019inflation. \r\n\r\nLe second circuit retrace l\u2019\u00e9volution des moyens de payement et fait la part belle aux collections historiques du mus\u00e9e. Monnaies marchandises, anciens objets de change, anciennes pi\u00e8ces et billets se c\u00f4toient ainsi dans une fresque th\u00e9matique et chronologique qui fera voyager le visiteur dans le temps et \u00e0 travers le monde.\r\n\r\nEnfin, le dernier circuit regroupe une s\u00e9rie d\u2019objets qui d\u00e9montre \u00e0 quel point l\u2019argent est pr\u00e9sent dans notre quotidien.\r\n\r\nLes visites de groupe sont organis\u00e9es \u00e0 partir de 10 personnes - maximum 25. Elles sont gratuites et durent environ 1 heure. Les r\u00e9servations se font via le formulaire en ligne disponible sur le site internet http:\/\/www.nbbmuseum.be\/fr\/booking. \r\nRenseignements : 02 221 22 06 \u2013 museum@nbb.be","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Museum van de Nationale Bank van Belgi\u00eb","address_street_name":"Warmoesberg","address_street_number":"57","address_street_box":null,"email":"museum@nbb.be","website":"http:\/\/www.nbbmuseum.be","phone_contact":"+32 2 221 22 06","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Warmoesberg, 57","address_line2":"1000 Brussel","description_web":"Sinds 2018 is het museum van de Nationale Bank van Belgi\u00eb in een prachtig 19de-eeuwse bankgebouw ondergebracht.\r\n\r\nAan de hand van interactieve opstellingen focust een eerste parcours in het museum op de taken van een centrale bank. Met behulp van een audiogids kan de bezoeker meer te weten komen over de uitgifte van munten en biljetten, zijn of haar kennis van de euro testen of proberen de inflatie onder controle te houden.\r\nHet tweede parcours schetst de evolutie van de betaalmiddelen en zet hierbij de collecties van het museum in de kijker. Goederengeld, oude ruilmiddelen, munten en biljetten vormen een thematisch en chronologisch geheel, waarbij de bezoeker wordt meegenomen op een reis in de tijd en over heel de wereld.\r\nHet derde parcours tenslotte toont een aantal voorwerpen waarmee wordt aangetoond hoe sterk geld aanwezig is in ons dagelijkse leven.\r\n\r\nGroepsbezoeken kunnen vanaf 10 personen, maximum 25. Ze zijn gratis en duren ongeveer 1 uur. Reserveren graag via de website van het museum https:\/\/www.nbbmuseum.be\/nl\/booking.\r\nMeer informatie: tel 02 221 22 06 - museum@nbb.be  ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Museum of the National Bank of Belgium","address_street_name":"rue Montagne aux Herbes potag\u00e8res","address_street_number":"57","address_street_box":null,"email":"museum@nbb.be","website":"http:\/\/www.nbbmuseum.be","phone_contact":"+32 2 221 22 06","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"rue Montagne aux Herbes potag\u00e8res, 57","address_line2":"1000 Brussels","description_web":"Since 2018 the museum of the National Bank of Belgium is housed in a splendid 19t century bank building situates at a mere 10-minute walk from the Central Station.\r\n\r\nThe first part of the exhibition pays particular attention to the role and the functions of the National Bank. By use of an audio guide and interactive displays, the visitor will no doubt discover lots of interesting facts about the issue of notes and coins, test their knowledge of the euro, or even try to control the rate of inflation.\r\n\r\nThe second part paints an overall picture of the evolution of money, and showcases many wonderful objects from the museum collection. Commodity money, diverse and peculiar objects once used for bartering, coins and notes... These many various pieces are purposely put in a thematical and chronological context which in the end will provide the visitor with a fascinating overview.\r\n\r\nThe third part of the exhibition proves just how much money is present in our day to day life by displaying a wide range of objects, some everyday and trivial, some quirky.\r\n\r\nGroup visits can be from 10 people up to 25. They are free and take about 1 hour. Please book via the website of the museum https:\/\/www.nbbmuseum.be\/en\/booking.\r\nMore information: 02 221 22 06 - museum@nbb.be ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Mus\u00e9e de la Banque Nationale de Belgique","address_street_name":"rue Montagne aux Herbes potag\u00e8res","address_street_number":"57","address_street_box":null,"email":"museum@nbb.be","website":"http:\/\/www.nbbmuseum.be","phone_contact":"+32 2 221 22 06","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"rue Montagne aux Herbes potag\u00e8res, 57","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Mus\u00e9e de la Banque Nationale de Belgique","address_street_name":"rue Montagne aux Herbes potag\u00e8res","address_street_number":"57","address_street_box":null,"email":"museum@nbb.be","website":"http:\/\/www.nbbmuseum.be","phone_contact":"+32 2 221 22 06","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"rue Montagne aux Herbes potag\u00e8res, 57","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Mus\u00e9e de la Banque Nationale de Belgique","address_street_name":"rue Montagne aux Herbes potag\u00e8res","address_street_number":"57","address_street_box":null,"email":"museum@nbb.be","website":"http:\/\/www.nbbmuseum.be","phone_contact":"+32 2 221 22 06","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"rue Montagne aux Herbes potag\u00e8res, 57","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Mus\u00e9e de la Banque Nationale de Belgique","address_street_name":"rue Montagne aux Herbes potag\u00e8res","address_street_number":"57","address_street_box":null,"email":"museum@nbb.be","website":"http:\/\/www.nbbmuseum.be","phone_contact":"+32 2 221 22 06","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"rue Montagne aux Herbes potag\u00e8res, 57","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Mus\u00e9e de la Banque Nationale de Belgique","address_street_name":"rue Montagne aux Herbes potag\u00e8res","address_street_number":"57","address_street_box":null,"email":"museum@nbb.be","website":"http:\/\/www.nbbmuseum.be","phone_contact":"+32 2 221 22 06","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"rue Montagne aux Herbes potag\u00e8res, 57","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":null,"facebook_id":null,"backoffice_id":592,"location":{"lat":50.84984775,"lon":4.35727802},"region":"brussels","last_updated_at":"2022-10-13T11:05:11+02:00","published_at":"2013-10-19T01:13:39+02:00",