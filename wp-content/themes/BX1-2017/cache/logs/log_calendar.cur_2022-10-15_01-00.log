gories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater"}},"others":{"list":[52],"translations":{"fr":["Th\u00e9\u00e2tre musical"],"nl":["Muziektheater"],"en":["Musical theatre"],"de":["Musiktheater"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Vice-Versa","shortdescr":"Quand le jeu inspire la musique et... Vice-Versa !","longdescr":"Et si l\u2019on permettait \u00e0 la musique de participer autant \u00e0 l\u2019histoire que le jeu et les mots !? Et si des notes rempla\u00e7aient dans un dialogue les paroles de l\u2019un des personnages !? Et si une m\u00e9lodie seule \u00e9crivait la narration d\u2019un chapitre de l\u2019histoire !? Et si tant\u00f4t la musique inspirait le com\u00e9dien, tant\u00f4t l\u2019inverse !?\r\n\r\nThierry Bilisko & Antoine Lefort s\u2019associent afin de vous proposer une formule rarement produite sur sc\u00e8ne. Sur des propositions et\/ou anecdotes offertes par les spectateurs, la musique d\u2019Antoine et le jeu de Thierry bouillonnent ensemble, se r\u00e9pondent, s\u2019entrem\u00ealent, s\u2019invectivent ou s\u2019entrechoquent\u2026 avec d\u00e9lectation, \u00e9motion, finesse et folie.","performers":"Thierry Bilisko, Antoine Lefort","boxoffice_url":null,"website":"https:\/\/www.improviste.be\/Vice-Versa-188.html","email":"info@improviste.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.539792"},"nl":{"name":"Vice-Versa","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.539792"},"en":{"name":"Vice-Versa","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\