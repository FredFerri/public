0e0 la fois de porter une attention particuli\u00e8re aux cultures dites minoritaires, d\u2019\u00eatre \u00e0 l\u2019\u00e9coute des artistes issus des immigrations, trop souvent m\u00e9connus, et, enfin, d\u2019agir comme une chambre d\u2019\u00e9cho pour un certain nombre d\u2019auteurs du Sud ou d\u2019ailleurs, \u00e9tonnants autant qu\u2019ignor\u00e9s, qui n\u2019ont pas trouv\u00e9 asile ailleurs. Lieu de cr\u00e9ation, de production et de diffusion, l\u2019Espace Magh propose une programmation ouverte, contemporaine et pluridisciplinaire, ainsi que des ateliers et des stages. Ce programme a pour but de contribuer au rayonnement des expressions multiculturelles, artistiques, intellectuelles et litt\u00e9raires.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Centre culturel Espace Magh asbl","address_street_name":"Priemstraat","address_street_number":null,"address_street_box":null,"email":"info@espacemagh.be","website":"http:\/\/www.espacemagh.be","phone_contact":"+32 2 274 05 10","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Priemstraat","address_line2":"1000 Brussel","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Centre culturel Espace Magh asbl","address_street_name":"Rue du Poin\u00e7on","address_street_number":null,"address_street_box":null,"email":"info@espacemagh.be","website":"http:\/\/www.espacemagh.be","phone_contact":"+32 2 274 05 10","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue du Poin\u00e7on","address_line2":"1000 Brussels","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Centre culturel Espace Magh asbl","address_street_name":"Rue du Poin\u00e7on","address_street_number":null,"address_street_box":null,"email":"info@espacemagh.be","website":"http:\/\/www.espacemagh.be","phone_cont