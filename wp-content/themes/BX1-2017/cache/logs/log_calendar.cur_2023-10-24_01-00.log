eur et le r\u00e9alisateur.","longdescr":"L'animateur Philippe Cornette a pris ses \u00e9l\u00e8ves comme acteur dans son film \"Putain d'amendement\", qui est en comp\u00e9tition au FIFE Festival International de l'Espoir, ZINEBI Bilbao, RIFF Roma Independent Film Festival, Festival Internacional De Cortometrajes Vitafest Chili, Bristol Independent Film Festival, Paris Art & Movie Awards, Warsaw International Film Festival Poland. \u00c0 travers plusieurs exercices, nous toucherons \u00e0 un maximum de techniques d\u2019acteur et de mise en sc\u00e8ne comme \u00e0 Hollywood. Nous d\u00e9velopperons l\u2019enjeu de chaque interaction entre l\u2019acteur et le r\u00e9alisateur.\n","performers":"Philippe Cornette (Cin\u00e9aste, auteur, acteur, metteur en sc\u00e8ne)","boxoffice_url":null,"website":"https:\/\/www.scenocity.be","email":"contact@scenocity.be","phone_contact":"+32 473 27 20 91","phone_booking":"+32 2 732 47 73","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50000502"},"sp":{"name":"Atelier face cam\u00e9ra du jeudi Camera & Acting Work","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.scenocity.be","email":"contact@scenocity.be","phone_contact":"+32 473 27 20 91","phone_booking":"+32 2 732 47 73","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50000502"},"nl":{"name":"Atelier face cam\u00e9ra du jeudi Camera & Acting Work","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.scenocity.be","email":"contact@scenocity.be","phone_contact":"+32 473 27 20 91","phone_booking":"+32 2 732 47 73","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50000502"}},"place":{"id":269799,"translations":{"de":{"name":"Salle paroissiale","address_street_name":"rue Jacques Hoton","address_street_number":"11","address_street_box":null,"email":null,"website":null,"phone_contact":"+32 2 771 63 75","phone_bo