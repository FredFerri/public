url":null,"website":"https:\/\/escaledunord.brussels\/event\/second-souffle\/","email":"info@escaledunord.brussels","phone_contact":"+32 496 94 43 18","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50010044"},"cn":{"name":"Second Souffle","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/escaledunord.brussels\/event\/second-souffle\/","email":"info@escaledunord.brussels","phone_contact":"+32 496 94 43 18","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50010044"},"fr":{"name":"Second Souffle","shortdescr":"L\u2019optimisme comme bazooka.","longdescr":"Deux grenouilles se d\u00e9battent dans un bocal de lait. L\u2019une abandonne et meurt. L\u2019autre, \u00e0 force de battre des pattes, transforme le lait en beurre et sort du pot.\n\nMorgane Raoux est clarinettiste. Passionn\u00e9e. Et promise \u00e0 un bel avenir : op\u00e9ras nationaux, grands orchestres symphoniques. \u00c0 25 ans, un pneumothorax stoppe net sa trajectoire fulgurante et sa grande carri\u00e8re \u00e0 peine entam\u00e9e. Morgane a perdu le souffle\u2026\n\nAvec Second Souffle, elle traite de sa r\u00e9silience heureuse et profitable. De l\u2019optimisme galopant qu\u2019elle utilise comme un bazooka. Finalement, il n\u2019est question ici que d\u2019espoir. De vivre plut\u00f4t que de survivre. D\u2019entendre le sang bouillir dans les veines et de sentir la belle sant\u00e9 nous traverser. A l\u2019instar de la pierre philosophale, Morgane a su transformer la mis\u00e8re en joyau.\n\n\u2014\nAuteur : Morgane Raoux selon une adaptation de son roman autobiographique \u00ab Je ne souffle pas, je chante \u00bb (\u00e9ditions Michalon)\nInterpr\u00e8tes : Morgane Raoux, Nicolas Wanczycki\nMise en sc\u00e8ne : Julie-Anne Roth\nUne coproduction de Madame Clarinette (France) et Pony Production. Spectacle cr\u00e9\u00e9 en r\u00e9sidence avec le soutien de la ville de Villeneuve-la-Garenne et du CENTQUATRE-PARIS. Avec le soutien du Th\u00e9\u00e2tre de Poche de Bruxelles.","performers":null,"boxoffice_url":null,"website":"https:\/\/escaledunord.brussels\/event\/second-souffle\/","email":"info@escaledunord.brussels","phone_contact":"+32 496 94 43 18","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50010044"},"sp":{"name":"Second Souffle","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/escaledunord.brussels\/event\/second-souffle\/","email":"info@escaledunord.brussels","phone_contact":"+32 496 94 43 18","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50010044"},"nl":{"name":"Second Souffle","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/escaledunord.brussels\/event\/second-souffle\/","email":"info@escaledunord.brussels","phone_contact":"+32 496 94 43 18","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50010044"}},"place":{"last_updated_at":"2021-08-22T04:13:13+02:00","published_at":"2021-03-16T12:28:09+01:00","id":276400,"translations":{"de":{"name":"Escale du Nord (Antenne Scheut)","address_street_name":"Avenue de Scheut","address_street_number":"147","address_street_box":null,"email":"info@escaledunord.brussels","website":"http:\/\/www.escaledunord.brussels","phone_contact":"+32 496 94 43 18","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Avenue de Scheut, 147","address_line2":"1070 Anderlecht","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Escale du Nord (Antenne Scheut)","address_street_name":"Avenue de Scheut","address_street_number":"147","address_street_box":null,"email":"info@escaledunord.brussels","website":"http:\/\/www.escaledunord.brussels","phone_contac