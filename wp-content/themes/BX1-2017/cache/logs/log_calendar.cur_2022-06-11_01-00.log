5:00","zaterdag en zondag: gesloten"],"en":["monday, tuesday, wednesday and thursday: from 10:00 to 17:00","friday: from 10:00 to 15:00","saturday and sunday: closed"]},"date_start":"2022-04-20","date_end":"2022-06-17","is_also_by_appointment":false}],"prices":[],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"opening":{"day":"2022-04-20","start":"12:30:00","timestamp":"2022-04-20T12:30:00+02:00","end":"14:00:00","is_only_by_appointment":true},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-06-10T02:05:36+02:00","published_at":"2022-04-06T14:47:46+02:00","backoffice_id":251046,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.32363786536193},{"id":531969,"date_start":"2022-05-20","date_end":"2022-06-11","date_next":"2022-06-10","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[24,28],"translations":{"fr":["Galeries d'art","Arts graphiques"],"nl":["Galeries","Grafische kunst, vormgeving"],"en":["Art Galleries","Graphic art"]}}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Franck Sarfati - Archipelagos 2022","shortdescr":"Saint-Martin Bookshop est une librairie unique d\u00e9di\u00e9e aux livres d\u2019art et aux livres d\u2019artistes. La librairie, install\u00e9e dans l\u2019ancienne Maison Martin Margiela \u00e0 Bruxelles, accueille \u00e9galement des artistes. Emmanuelle Lain\u00e9, Gabriel Kuri, Pierre Leguillon, Machteld Rullens ou On Kawara ont \u00e9t\u00e9 expos\u00e9s. Et maintenant Franck Sarfati.","longdescr":"En antith\u00e8se \u00e0 nos villes d\u00e9shumanis\u00e9es, et dans ma d\u00e9marche utopique - dystopique - j\u2019ai voulu formaliser une organisation spatiale interconnect\u00e9e. Ces cellules sont con\u00e7ues comme des \u00e9l\u00e9ments uniques faisant partie d\u2019une s\u00e9rie. Rebelles face \u00e0 l\u2019adversit\u00e9 du monde, face au constat du d\u00e9clin annonc\u00e9. Elles se veulent un \u00e9change entre les organismes vivants, tels des archipels. Une grande instalation (550 x 260 cm), et ses d\u00e9clinaisons emboss\u00e9es sur papier Awagami Hakuho, seront expos\u00e9es chez Saint-Martin Bookshop du 20 mai au 11 juin.\r\nEt maintenant Franck Sarfati.","performers":"Franck Sarfati","boxoffice_url":null,"website":"https:\/\/saint-martin-bookshop.com\/pages\/contact","email":"hello@saint-martin-bookshop.com","phone_contact":"+32 487 13 65 72","phone_booking":"+32 487 13 65 72","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/531969.html"},"nl":{"name":"Franck Sarfati - Archipelagos 2022","shortdescr":"Saint-Martin Bookshop is een unieke boekhandel gewijd aan kunstboeken en kunstenaarsboeken. De boekhandel, gevestigd in de voormalige Maison Martin Margiela in Brussel, verwelkomt ook kunstenaars. Emmanuelle Lain\u00e9, Gabriel Kuri, Pierre Leguillon, Machteld Rullens of On Kawara waren er te zien. En nu Franck Sarfati.","longdescr":"Als antithese voor onze ontmenselijkte steden, en in mijn utopische \u2013 dystopische \u2013 aanpak wilde ik een verweven ruimtelijke organisatie formaliseren. Deze cellen zijn ontworpen als unieke elementen die deel uitmaken van een reeks. Rebellerend tegen de moeilijkheden van de wereld, in het aanzicht van een aangekondigd verval. Ze willen een uitwisseling zijn tussen levende organismen, zoals een archipel.\r\nDe composities zijn gemaakt van unieke stukken gemaakt in ge\u00ebmailleerd Limoges-porselein . Een grote installatie (550 x 260 cm), en de variaties ervan in reli\u00ebf op Awagami Hakuho-papier,\r\nwordt tentoongesteld in Saint-Martin Bookshop van 20 mei tot 11 juni.","performers":"Franck Sarfati","boxoffice_url":null,"website":null,"email":"hello@saint-martin-bookshop.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/531969.html"},"en":{"name":"Franck Sarfati - Archipelagos 2022","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"hello@saint-martin-bookshop.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/531969.html"},"de":{"name":"Franck Sarfati - Archipelagos 2022","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/531969.html"},"it":{"name":"Franck Sarfati - Archipelagos 2022","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/531969.html"},"sp":{"name":"Franck Sarfati - Archipelagos 2022","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/531969.html"},"pt":{"name":"Franck Sarfati - Archipelagos 2022","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/531969.html"},"cn":{"name":"Franck Sarfati - Archipelagos 2022","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/531969.html"}},"place":{"id":278381,"translations":{"fr":{"name":"Saint-Martin Bookshop","address_street_name":"Rue de Flandre","address_street_number":"114","address