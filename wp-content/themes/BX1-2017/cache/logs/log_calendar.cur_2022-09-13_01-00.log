,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":118,"translations":{"fr":"Festival","nl":"Festival","en":"Festival"}},"others":{}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Festival Voce et Organo 2022","shortdescr":"LUX VENETIAE - 4 concerts de musique ancienne \r\nSous la th\u00e9matique LUX VENETIAE, le Festival Voce et Organo 2022 met \u00e0 l\u2019honneur le grand compositeur Allemand Heinrich SCH\u00dcTZ (1585-1672), parfois appel\u00e9 \u00ab le Monteverdi allemand \u00bb, figure transitionnelle entre l\u2019esth\u00e9tique de la Renaissance et la modernit\u00e9 baroque venue d\u2019Italie.","longdescr":"2 \u00e9glises, 2 lieux d'exception pour les 4 concerts du Festival Voce et Organo 2022 ! \r\nBruxelles, Eglise Notre-Dame de la Chapelle (07\/09, 09,\/09, 14\/09 - 20h00)\r\nOrp-Le-Grand, Eglise Saints Martin-et-Ad\u00e8le (11\/09 - 16h00)","performers":"07\/09 - Claire Lefilli\u00e2tre - Beno\u00eet Mernier\r\n09\/09 - Le Choeur de Chambre de Namur - Arnaud Van de Cauter\r\n11\/09 - Hortus Musicalis (F) - Jean-Luc Iffrig \r\n14\/09 - Oltremontano - Luc Ponet","boxoffice_url":"https:\/\/shop.utick.be\/?module=CATALOGUE&pos=VOCEETORGANO&lg=FR","website":"http:\/\/www.voceorgano.be","email":"info@voceorgano.be","phone_contact":"+32 487 49 76 59","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.536281"},"nl":{"name":"Festival Voce et Organo 2022","shortdescr":"Het Festival Voce & Organo 2022 \u00ab LUX VENETIAE \u00bb brengt hulde aan de befaamde componist Heinrich SCH\u00dcTZ (1585-1672), soms ook de Duitse Monteverdi genoemd, spilfiguur tussen de Renaissance esthetiek en de Italiaanse \u2018moderne\u2019  Barok.","longdescr":"2 kerken, 2 uitzonderlijke locaties !  \r\nBrussel, OLV ter Kapellekerk (07\/09, 09,\/09, 14\/09 - 20u00)\r\nOrp-Le-Grand, Kerk Saints Martin-et-Ad\u00e8le (11\/09 - 16u00)","performers":"07\/09 - Claire Lefilli\u00e2