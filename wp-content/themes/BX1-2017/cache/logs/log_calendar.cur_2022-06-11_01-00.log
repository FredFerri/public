ions":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":0}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"visit_profile":{"list":[328],"translations":{"fr":["Vert & Durable"],"nl":["Groen"],"en":["Green"]}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-05-24T04:05:24+02:00","published_at":"2022-05-13T03:30:04+02:00","backoffice_id":253654,"import_origin":"explore","sub_type":"other","show_in_agenda":true,"ranking":0.46415888336128},{"id":531109,"date_start":"2022-06-19","date_end":"2022-06-19","date_next":"2022-06-19","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":74,"translations":{"fr":"Sport","nl":"Sport","en":"Sport"}},"others":{"list":[160,76],"translations":{"fr":["Manifestation sportive","Athl\u00e9tisme et Cyclisme"],"nl":["Sportmanifestatie","Atletiek en wielrennen"],"en":["Sporting event","Athletics and cycling"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Bxl Tour","shortdescr":"Le dimanche 19 juin prochain aura lieu la sixi\u00e8me \u00e9dition du BXL TOUR, la course cycliste de 40km dans les rues de la capitale.","longdescr":"Cet \u00e9v\u00e9nement occupe d\u00e9sormais une place incontournable dans l\u2019agenda de plusieurs milliers de cyclistes qui, depuis 2017, rel\u00e8vent avec enthousiasme ce d\u00e9fi. Traversant huit communes de Bruxelles, le parcours permettra aux cyclistes d\u2019en (re)d\u00e9couvrir quelques lieux symboliques dans des conditions privil\u00e9gi\u00e9es. \r\n\r\nLe BXL TOUR propose trois cat\u00e9gories :\r\n\r\n\u2022Master : 40 km \u00e0 minimum 40 km\/h de vitesse moyenne, pour les plus exp\u00e9riment\u00e9s\r\n\u2022Cyclo : 40 km \u00e0 minimum 20km\/h de vitesse moyenne, pour les cyclistes entra\u00een\u00e9s\r\n\u2022Ride : 32km \u00e0 minimum 16 km\/h de vitesse moyenne, parcours en mode balade, v\u00e9los \u00e0 assistance \u00e9lectrique autoris\u00e9s\r\n\r\nD\u00e9part : Place des Palais\r\nArriv\u00e9e : Atomium","performers":null,"boxoffice_url":null,"website":"https:\/\/www.bxltour.be\/","email":"info@bxltour.be","phone_contact":"+32 2 318 64 70","phone_booking":"+32 2 318 64 70","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/531109.html"},"nl":{"name":"Bxl Tour","shortdescr":"Op zondag 19 juni vindt de zesde editie plaats van BXL TOUR, de 40 km lange wielerwedstrijd door de straten van de hoofdstad.","longdescr":"Het evenement staat met stip genoteerd in de agenda van enkele duizenden fietsers die sinds 2017 met veel enthousiasme de uitdaging aangaan. Het parcours doorkruist acht verschillende Brusselse gemeenten. Zo kunnen de fietsers in bevoorrechte omstandigheden enkele iconische plekken (her)ontdekken. \r\n\r\nBXL TOUR biedt de keuze uit drie categorie\u00ebn:\r\n\r\n\u2022Master : 40 km met een minimale gemiddelde snelheid van 40 km\/u, voor de meest ervaren fietsers\r\n\u2022Cyclo : 40 km met een gemiddelde snelheid van minimaal 20 km\/u, voor getrainde fietsers\r\n\u2022Ride : 32 km met een minimale gemiddelde snelheid van 16 km\/u, ontspannen meerijden in de koers, elektrisch fietsen toegestaan\r\n\r\nVertrek: Paleizenplein\r\nAankomst: Atomium","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/531109.html"},"en":{"name":"Bxl Tour","shortdescr":"Sunday 19 June is the day for the sixth edition of the BXL TOUR, the 40 km cycle race through the streets of the capital.","longdescr":"This event is now a permanent fixture in the diary of several thousand cyclists who have enthusiastically taken up this challenge since 2017. Crossing eight municipalities in Brussels, it will allow cyclists to (re)discover some symbolic places in unique conditions.\r\n\r\nThe BXL TOUR offers three categories:\r\n\r\n\r\n\u2022Master : 40 km at a minimum average speed of 40 km\/h, for the most experienced cyclists\r\n\u2022Cyclo : 40 km at a minimum average speed of 20km\/h, for trained cyclists\r\n\u2022Ride : 32km at a minimum average speed of 16 km\/h, stroll mode, electric bikes allowed\r\n\r\nStart: Place des Palais\r\nFinish: Atomium","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/531109.html"},"de":{"name":"Bxl tour","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/531109.html"},"it":{"name":"Bxl tour","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/531109.html"},"sp":{"name":"Bxl tour","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/531109.html"},"pt":{"name":"Bxl tour","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/531109.html"},"cn":{"name":"Bxl tour","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/531109.html"}},"place":{"id":276760,"translations":{"fr":{"name":"R\u00e9gion de Bruxelles-Capitale","address_street_name":null,"address_str