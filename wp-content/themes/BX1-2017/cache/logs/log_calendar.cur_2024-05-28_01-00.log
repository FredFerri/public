 industriels comme Cockerill,\u2026 La liste est longue et les rebondissements nombreux.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.rdvculturels.be","email":"rdvculturelsbe@gmail.com","phone_contact":"+32 476 40 98 30","phone_booking":"+32 476 40 98 30","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50008048"},"sp":{"name":"It\u2019s Brussels,  my dear !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.rdvculturels.be","email":"rdvculturelsbe@gmail.com","phone_contact":"+32 476 40 98 30","phone_booking":"+32 476 40 98 30","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50008048"},"nl":{"name":"It\u2019s Brussels,  my dear !","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.rdvculturels.be","email":"rdvculturelsbe@gmail.com","phone_contact":"+32 476 40 98 30","phone_booking":"+32 476 40 98 30","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50008048"}},"place":{"last_updated_at":"2022-05-30T12:22:16+02:00","published_at":"2014-04-03T15:14:23+02:00","id":257582,"translations":{"de":{"name":" Fontaine de Minerve","address_street_name":"place du Grand Sablon","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"place du Grand Sablon","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":" Fontaine de Minerve","address_street_name":"place du Grand Sablon","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"place du Grand Sablon","address_line2":"1000 Bruxelles","description_web":null,"desc