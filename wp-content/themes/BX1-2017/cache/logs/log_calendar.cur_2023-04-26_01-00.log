n":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen","it":"Visite guidate","sp":"Visitas guiadas","pt":null,"cn":null}},"others":{"list":[255],"translations":{"fr":["Visites d'expositions"],"nl":["Tentoonstelling"],"en":["Exhibition guided tours"],"de":["Besuche von Ausstellungen"],"it":["Visite a esposizioni"],"sp":["Visitas a las exposiciones"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Ap\u00e9ro Tour","shortdescr":"Venez d\u00e9couvrir les expositions du WIELS avec un.e guide passionn\u00e9.e et initi\u00e9.e, et d\u00e9gustez une boisson pour parfaire l\u2019exp\u00e9rience avant ou apr\u00e8s la visite.","longdescr":"L'Ap\u00e9ro Tour est un voyage culturel qui sort de l\u2019ordinaire, amusant et instructif. Il vous est \u00e9galement possible de participer aux ateliers gratuits. La r\u00e9servation n'est pas obligatoire mais recommand\u00e9e.\r\n\r\nTicket d'entr\u00e9e + \u20ac7 (boisson comprise)","performers":null,"boxoffice_url":null,"website":"http:\/\/www.wiels.org","email":"welcome@wiels.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.552508"},"nl":{"name":"Ap\u00e9ro Tour","shortdescr":"Ontdek de WIELS-tentoonstellingen met een gepassioneerde en deskundige gids en geniet ervoor of erna van een drankje in het WIELS' Cafe.","longdescr":"Voor \u20ac7 extra krijg je een rondleiding van een deskundige gids \u00e9n een drankje naar keuze voor of na de tour. Nadien kan je ook aansluiten bij de gratis nocturne workshops. Reserveren is aangeraden, maar niet verplicht.\r\n\r\nToegangsticket + \u20ac7 (incl. drankje)","performers":null,"boxoffice_url":null,"website":"http:\/\/www.wiels.org","email":"welcome@wiels.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.552508"},"en":{"name":"Ap\u00e9ro Tour","shortdescr":"Experience the WIELS exhibitions in a unique way with the Apero Tour!","longdescr":"Our passionate and knowledgeable guides will take you on a fascinating journey of discovery, while you enjoy a complimentary drink of your choice. And if that's not enough, you can join us afterwards for our free nocturne workshops. For just \u20ac7 more, you get a full guided tour from an expert guide and a drink of your choice before or after the tour. Reservation is not compulsory but recommended.\r\n\r\nEntry ticket + \u20ac7 (drink included)","performers":null,"boxoffice_url":null,"website":"http:\/\/www.wiels.org","email":"welcome@wiels.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.552508"},"de":{"name":"Ap\u00e9ro Tour","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wiels.org","email":"welcome@wiels.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.552508"},"it":{"name":"Ap\u00e9ro Tour","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wiels.org","email":"welcome@wiels.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.552508"},"sp":{"name":"Ap\u00e9ro Tour","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wiels.org","email":"welcome@wiels.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.552508"},"pt":{"name":"Ap\u00e9ro Tour","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wiels.org","email":"welcome@wiels.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.552508"},"cn":{"name":"Ap\u00e9ro Tour","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wiels.org","email":"welcome@wiels.org","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.552508"}},"place":{"id":1490,"translations":{"fr":{"name":"Wiels - Centre d\u2019art contemporain","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+32 2 340 00 50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":"Le WIELS est un laboratoire international pour la cr\u00e9ation et la diffusion de l\u2019art contemporain. Ax\u00e9 sur les arts visuels, mais accordant une place et une attention particuli\u00e8res aux croisements et interactions avec d\u2019autres disciplines, le centre d\u00e9sire pr\u00e9senter l\u2019art contemporain dans toute sa diversit\u00e9 et mettre le public en contact et en dialogue permanents avec les d\u00e9veloppements et d\u00e9bats les plus r\u00e9cents du monde de l\u2019art. Le centre d'art dispose d'un magasin, d'un caf\u00e9 et d'un toit terrasse offrant une impressionnante vue sur la ville. ","description_print":"","booking_url":null,"sort_order":"WIELS - CONTEMPORARY ART CENTRE","virtual_visit":null},"nl":{"name":"Wiels - Centrum voor hedendaagse kunst","address_street_name":"Van Volxemlaan","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+32 2 340 00 50","phone_booking":null,"address_zip":"1190","address_city":"Vorst","address_line1":"Van Volxemlaan, 354","address_line2":"1190 Vorst","description_web":"Wiels is een toonaangevend internationaal platform voor de creatie en presentatie van hedendaagse kunst. Het centrum ontwikkelt een programma van tijdelijke activiteiten, zonder een permanente collectie uit te bouwen. Wiels organiseert zes tot acht grote tentoonstellingen per jaar die de evoluties in hedendaagse kunst op de voet volgen. Daarnaast loopt er een residentie en educatief programma en worden er lezingen, films, performances, debatten, ontmoetingen georganiseerd. Het kunstcentrum heeft een shop, een caf\u00e9 en een dakterras met een indrukwekkend uitzicht over de stad. ","description_print":"","booking_url":null,"sort_order":"WIELS - CONTEMPORARY ART CENTRE","virtual_visit":null},"en":{"name":"Wiels - Contemporary art centre","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+32 2 340 00 50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":"It was the brewer L\u00e9on Wielemans who asked his friend, the architect Adrien Blomme, to design and build the new buildings of his brewery in Forest. It became the leading monument of industrial archaeology in the art deco style, and houses now Wiels, an international laboratory for the creation and the diffusion of contemporary art. Focusing on visual arts, but granting a particular attention to the crossings and interactions with other disciplines, the centre wishes to present contemporary art in all its diversity and to offer a permanent dialogue with the developments and the most recent debates of the art world. The Art centre has a shop, a caf\u00e9 and offer an impressive panorama on the city. ","description_print":"","booking_url":null,"sort_order":"WIELS - CONTEMPORARY ART CENTRE","virtual_visit":null},"de":{"name":"Wiels - Zentrum f\u00fcr moderne Kunst","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+32 2 340 00 50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":"Das WIELS ist ein hochkar\u00e4tiges, internationales Labor f\u00fcr moderne Kunst, das sich nicht nur der Ausstellung von moderner Kunst sondern auch dem kreativen Entstehungsprozess widmet. Der Schwerpunkt liegt auf der visuellen Kunst, doch es werden auch ganz bewusst Schnittstellen mit anderen Disziplinen gesucht, die die Vielfalt und das Facettenreichtum der modernen Kunst aufzuzeigen. Dem Besucher offenbart sich ein permanenter Dialog mit den Entwicklungen der modernen Kunst und eine Debatte mit der Kunstwelt der Gegenwart.\r\n\r\nAuf drei Ebenen mit insgesamt 1800 m\u00b2 Ausstellungsfl\u00e4che finden regelm\u00e4\u00dfig Ausstellungen statt. Dar\u00fcber hinaus wird das WIELS regelm\u00e4\u00dfig Schauplatz von ausgew\u00e4hlten Filmvorf\u00fchrungen, Konferenzen, Festivals und Konzerten. \r\nUntergebracht ist das WIELS in dem eindrucksvollen Eckgeb\u00e4ude der ehemaligen Brauerei Wielemans-Ceuppens, das aus der Feder des modernistischen Architekten Adrien Blomm stammt. Von der Brauereivergangenheit zeugen noch heute die majest\u00e4tischen Kupferkessel.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Wiels - Centre d\u2019art contemporain","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+32 2 340 00 50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Wiels - Centro de arte contempor\u00e1neo","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+32 2 340 00 50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":"Fue el amante de la cerveza L\u00e9on Wielemans quien le pidi\u00f3 a su amigo, el arquitecto Adrien Blomme, dise\u00f1ar y construir los nuevos edificios para su cervecer\u00eda en Forest. Se convirti\u00f3 en el monumento m\u00e1s importante de arqueolog\u00eda industrial en estilo art d\u00e9co, y ahora alberga Wiels, un laboratorio internacional para la creaci\u00f3n y difusi\u00f3n de arte contempor\u00e1neo. Poniendo el foco en las artes visuales, pero garantizando una particular atenci\u00f3n en el cruce y las interacciones con otras disciplinas, el centro pretende mostrar el arte contempor\u00e1neo en todos sus sentidos y ofrecer un di\u00e1logo permanente con su desarrollo y los debates m\u00e1s recientes del mundo del arte.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Wiels - Centre d\u2019art contemporain","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+32 2 340 00 50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Wiels - Centre d\u2019art contemporain","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+32 2 340 00 50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":"","description_print":"","booking_url