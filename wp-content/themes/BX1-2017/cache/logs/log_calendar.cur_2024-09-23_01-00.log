pose des promenades guid\u00e9es sur deux roues en fran\u00e7ais, n\u00e9erlandais et anglais. Une id\u00e9e sympathique qui permet d\u2019appr\u00e9cier la petite reine ET les richesses multiples de l\u2019environnement bruxellois. Il n\u2019y a plus qu\u2019\u00e0 baisser la t\u00eate pour avoir l\u2019air d\u2019un coureur! Mais non, ce serait dommage, levez les yeux et appr\u00e9ciez le paysage...\r\nLangues: allemand - anglais - espagnol - fran\u00e7ais - n\u00e9erlandais - portugais","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Pro Velo","address_street_name":"Rue de Londres ","address_street_number":"15","address_street_box":null,"email":"info@provelo.org","website":"http:\/\/www.provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de Londres , 15","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Pro Velo","address_street_name":"Londenstraat","address_street_number":"15","address_street_box":null,"email":"info@provelo.org","website":"http:\/\/www.provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"Londenstraat, 15","address_line2":"1050 Elsene","description_web":"De vzw Pro V\u00e9lo streeft naar meer mobiliteit voor de Brusselse fietsers en organiseert gegidste fietstochten in het Nederlands, Frans en Engels. Kortom, een fijn idee voor wie graag met de haren in de wind de stad afschuimt.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":773,"location":{"lat":50.83799952,"lon":4.36754042},"last_updated_at":"2024-06-21T11:14:06+02:00","published_at":"2013-10-19T01:13:47+02:00","is_in_address_book":f