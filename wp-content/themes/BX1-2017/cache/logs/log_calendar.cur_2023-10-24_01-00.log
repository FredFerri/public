_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.3419951893353394,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[42,36],"translations":{"de":["Malerei","Museen & Kunstzentren"],"pt":[null,null],"en":["Painting","Museums and art centers"],"it":["Pittura","Musei e centri artistici"],"cn":[null,null],"fr":["Peinture","Mus\u00e9es et art centers"],"sp":["Pintura","Museos y centros de arte"],"nl":["Schilderkunst","Musea en kunstcentra"]}}},"translations":{"de":{"name":"Retour \u00e0 la source Pierre Lef\u00e8vre","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/musee-art-spontane.be\/","email":"museedartspontane@gmail.com","phone_contact":"+32 2 426 84 04","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50002146"},"pt":{"name":"Retour \u00e0 la source Pierre Lef\u00e8vre","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/musee-art-spontane.be\/","email":"museedartspontane@gmail.com","phone_contact":"+32 2 426 84 04","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50002146"},"en":{"name":"Retour \u00e0 la source Pierre Lef\u00e8vre","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/musee-art-spontane.be\/","email":"museedartspontane@gmail.com","phone_contact":"+32 2 426 84 04","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50002146"},"it":{"name":"Retour \u00e0 la source Pierre Lef\u00e8vre","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/musee-art-spontane.be\/","email":"museedartspontane@gmail.com","phone_contact":"+32 2 426 84 04","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50002146"},"cn":{"name":"Retour \u00e0 la source Pierre Lef\u00e8vre","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/musee-art-spontane.be\/","email":"museedartspontane@gmail.com","phone_contact":"+32 2 426 84 04","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50002146"},"fr":{"name":"Retour \u00e0 la source Pierre Lef\u00e8vre","shortdescr":"Retour \u00e0 la source,\nhistoire de la cr\u00e9ation du mus\u00e9e d'art spontan\u00e9.","longdescr":"Lettre ouverte \u00e0 Pierre Lef\u00e8vre (\u00e9crit \u00e0 la main)\n\"Vingt-cinq ans se sont \u00e9coul\u00e9s\u2026\nD\u00e9sempar\u00e9e par la perte d\u2019un fils, le hasard de la providence fit que se croisent nos chemins. En t\u2019adressant ce message je me rem\u00e9more le chemin parcouru.\nLors de notre premi\u00e8re rencontre, tu peignais depuis longtemps, mais tes personnages \u00e9tranges et peu acad\u00e9miques suscitaient l\u2019incr\u00e9dulit\u00e9.\nJe me demande encore pourquoi \u00ab le living \u00bb, \u00ab le cirque \u00bb, \u00ab le mariage des animaux \u00bb, ou encore un certain \u00ab paysage de neige \u00bb provoquaient en moi une si intense \u00e9motion.\nPeut-\u00eatre une sensibilit\u00e9 exacerb\u00e9e par le chagrin me fit prendre conscience d\u2019une vocation personnelle contrari\u00e9e et cela par la d\u00e9couverte de tes propres possibilit\u00e9s artistiques.\nJe d\u00e9cidai de te faire conna\u00eetre.\nRedoutant d\u2019agir trop impulsivement je fis contact avec des artistes.\nLeurs avis s\u2019av\u00e8rent favorables.\nD\u00e8s lors, il s\u2019\u00e9tablit entre nous une tendre complicit\u00e9 et notre \u00ab aventure \u00bb pris son essor !\nComme souvent tes tableaux traduisent de fa\u00e7on inconsciente la vision tr\u00e8s personnelle que tu portes sur le quotidien et que seul ton pinceau peut exprimer, je donne le titre \u00e0 l\u2019\u0153uvre.\nSouviens-toi de \u00ab la fin d\u2019un royaume \u00bb, \u00ab Colombus \u00bb, \u00ab pour qui, pourquoi ? \u00bb et tant d\u2019autres. J\u2019avais l\u2019enthousiasme des n\u00e9ophytes mais aucune exp\u00e9rience.\nLa route fut longue et difficile.\nIl est certain que nul n\u2019aurait pu imaginer la r\u00e9trospective d\u2019aujourd\u2019hui, ni la fondation de la maison des arts spontan\u00e9s et na\u00effs, ni la cr\u00e9ation d\u2019un mus\u00e9e-centre de documentation et encore moins l\u2019acceptation par le mus\u00e9e moderne des beaux-arts de Bruxelles de l\u2019une de tes \u0153uvres.\nSi c\u2019est bien involontairement que tu m\u2019as entrain\u00e9e \u00e0 r\u00e9aliser cette aventure, il est certain que c\u2019est \u00e0 ton art que je dois d\u2019avoir pu redonner un sens \u00e0 ma vie.\"\nMimi de N\u00e9eff, juillet 1987","performers":null,"boxoffice_url":null,"website":"https:\/\/musee-art-spontane.be\/","email":"museedartspontane@gmail.com","phone_contact":"+32 2 426 84 04","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50002146"},"sp":{"name":"Retour \u00e0 la source Pierre Lef\u00e8vre","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/musee-art-spontane.be\/","email":"museedartspontane@gmail.com","phone_contact":"+32 2 426 84 04","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50002146"},"nl":{"name":"Retour \u00e0 la source Pierre Lef\u00e8vre","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/musee-art-spontane.be\/","email":"museedartspontane@gmail.com","phone_contact":"+32 2 426 84 04","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50002146"}},"place":{"id":1834,"translations":{"de":{"name":"Mus\u00e9e d'Art Spontan\u00e9","address