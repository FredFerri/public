slations":{"fr":{"name":"Enfants"},"nl":{"name":"Kinderen"},"en":{"name":"Children"},"de":{"name":"Kinder"},"it":{"name":"Bambini"},"sp":{"name":"Ni\u00f1os"},"pt":{"name":"Enfants"},"cn":{"name":"Enfants"}},"value":8}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"visit_profile":{"list":[337],"translations":{"fr":["Highlight"],"nl":["Highlight"],"en":["Highlight"],"de":["Highlight"],"it":["Highlight"],"sp":["Highlight"],"pt":[null],"cn":[null]}},"tags":["major_event"],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2023-03-01T09:35:08+01:00","published_at":"2023-01-02T09:14:56+01:00","backoffice_id":268221,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":1.5874010519682},{"id":550917,"date_start":"2023-03-18","date_end":"2023-03-19","date_next":"2023-03-18","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":90,"translations":{"fr":"Animations","nl":"Animaties","en":"Animations","de":"Animationen","it":"Animazioni","sp":"Animaciones","pt":null,"cn":null}},"others":{}},"languages":{"spoken":["fr","en","nl","de"],"subtitles":[]},"translations":{"fr":{"name":"Brosse dor\u00e9e Competition Ma\u00eetres de Cireurs de Chaussures","shortdescr":"Tout le monde est le bienvenu pour faire entretenir ses chaussures de mani\u00e8re professionnelle et gratuite par un cireur de chaussures renomm\u00e9, explique Marcello Faraggi, pr\u00e9sident de l'ESSA.","longdescr":"Tout le monde est le bienvenu pour faire entretenir ses chaussures de mani\u00e8re professionnelle et gratuite par un cireur de chaussures renomm\u00e9, explique Marcello Faraggi, pr\u00e9sident de l'ESSA.\r\nCette comp\u00e9tition particuli\u00e8re se d\u00e9roulera simultan\u00e9ment sur trois chaises de cirage diff\u00e9rentes.\r\nUn jury de haut niveau compos\u00e9 de trois personnes d\u00e9signera le meilleur cireur de chaussures selon un catalogue de points.\r\nEn tant que seul cireur de chaussures professionnel et \u00e0 plein temps en Belgique, Faraggi travaille depuis 2015 notamment pour des \u00e9v\u00e9nements et des h\u00f4tels de luxe, comme le \"Stanhope Hotel\" ou les h\u00f4tels Thon. Il compte \u00e9galement des cabinets d'avocats et des bureaux parmi ses clients. En 2016, il avait fond\u00e9 ESSA avec plusieurs coll\u00e8gues.","performers":"Les meilleurs Ma\u00eetres Cireurs de Chaussures en Europe vont pr\u00e9senter leurs savoir-faire.","boxoffice_url":null,"website":"http:\/\/www.essa.expert","email":"info@essa.expert","phone_contact":"+32 486 60 00 98","phone_booking":"+32 486 60 00 98","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.550917"},"nl":{"name":"Brosse dor\u00e9e Competition Ma\u00eetres de Cireurs de Chaussures","shortdescr":null,"longdescr":"Iedereen is welkom om zijn schoenen professioneel en gratis te laten poetsen door een gerenommeerde schoenpoetser\", aldus Marcello Faraggi, voorzitter van ESSA.\r\nDeze speciale wedstrijd zal gelijktijdig plaatsvinden op drie verschillende stralende stoelen.\r\nEen prominente jury van drie personen kiest aan de hand van een puntencatalogus de beste schoenpoetser.\r\nAls enige fulltime professionele schoenpoetser in Belgi\u00eb werkt Faraggi sinds 2015 voor luxe evenementen en hotels, zoals het Stanhope Hotel en de Thon Hotels. Hij rekent ook advocatenkantoren en kantoren tot zijn klanten. In 2016 richtte hij met enkele collega's ESSA op.","performers":"De beste Master Shoe Polishers in Europa zullen hun vaardigheden presenteren","boxoffice_url":null,"website":"http:\/\/www.essa.expert","email":"info@essa.expert","phone_contact":"+32 486 60 00 98","phone_booking":"+32 486 60 00 98","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.550917"},"en":{"name":"Brosse dor\u00e9e Competition Ma\u00eetres de Cireurs de Chaussures","shortdescr":"Everyone is welcome to have their shoes shined professionally and free of charge by a renowned shoe shiner, explains Marcello Faraggi, President of ESSA.","longdescr":"Everyone is welcome to have their shoes shined professionally and free of charge by a renowned shoe shiner,\" explains Marcello Faraggi, President of ESSA.\r\nThis special competition will take place simultaneously on three different shining chairs.\r\nA high-level jury of three people will select the best shoe shiner according to a points catalogue.\r\nAs the only full-time professional shoe shiner in Belgium, Faraggi has been working since 2015 for luxury events and hotels, such as the Stanhope Hotel and the Thon Hotels. He also counts law firms and offices among his clients. In 2016, he founded ESSA with several colleagues.","performers":"The best Shoe Shiners in Europe will present their skills","boxoffice_url":null,"website":"http:\/\/www.essa.expert","email":"info@essa.expert","phone_contact":"+32 486 60 00 98","phone_booking":"+32 486 60 00 98","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.550917"},"de":{"name":"Brosse dor\u00e9e Competition Ma\u00eetres de Cireurs de Chaussures","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.essa.expert","email":"info@essa.expert","phone_contact":"+32 486 60 00 98","phone_booking":"+32 486 60 00 98","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.550917"},"it":{"name":"Brosse dor\u00e9e Competition Ma\u00eetres de Cireurs de Chaussures","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.essa.expert","email":"info@essa.expert","phone_contact":"+32 486 60 00 98","phone_booking":"+32 486 60 00 98","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.550917"},"sp":{"name":"Brosse dor\u00e9e Competition Ma\u00eetres de Cireurs de Chaussures","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.essa.expert","email":"info@essa.expert","phone_contact":"+32 486 60 00 98","phone_booking":"+32 486 60 00 98","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.550917"},"pt":{"name":"Brosse dor\u00e9e Competition Ma\u00eetres de Cireurs de Chaussures","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.essa.expert","email":"info@essa.expert","phone_contact":"+32 486 60 00 98","phone_booking":"+32 486 60 00 98","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.550917"},"cn":{"name":"Brosse dor\u00e9e Competition Ma\u00eetres de Cireurs de Chaussures","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.essa.expert","email":"info@essa.expert","phone_contact":"+32 486 60 00 98","phone_booking":"+32 486 60 00 98","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.550917"}},"place":{"id":258279,"translations":{"fr":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Rue Picard","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard","address_line2":"1000 Bruxelles","description_web":"La Gare Maritime : l'ancienne gare de fret devenue jungle urbaine, neutre en \u00e9nergie !\r\n\r\nElle offre le cadre id\u00e9al pour les \u00e9v\u00e9nements culturels innovants, les tournages de films ou s\u00e9ances photo, les march\u00e9s et foires, les lancements et promotions de produits. Les halles de la Gare Maritime ont \u00e9t\u00e9 transform\u00e9es en ville int\u00e9rieure. Elle comportera son propre food hall (\u00e0 partir de septembre 2021), des magasins exclusifs et des bureaux. Dans ce complexe, des espaces uniques et inspirants sont entrecoup\u00e9s de structures en bois chaleureuses. Le b\u00e2timent se pr\u00eate \u00e0 l'organisation de rencontres en petit comit\u00e9 ou de grands happenings. La nef monumentale, attrait architectural, est baign\u00e9e de lumi\u00e8re naturelle indirecte et offre suffisamment d'espace pour les activit\u00e9s int\u00e9rieures bien fr\u00e9quent\u00e9es.\r\nTout \u00e9v\u00e8nement dans la Gare Maritime sera un \u00e9v\u00e8nement \u00e9co-responsable. La durabilit\u00e9 \u00e9tait \u00e0 l'avant-plan pendant les r\u00e9novations du b\u00e2timent. L'\u00e9nergie renouvelable est produite sur place, utilisant la g\u00e9othermie et des panneaux photovolta\u00efques. Sur les promenades vertes bordant la nef centrale, des jardins \u00e0 th\u00e8me et des arbres \u00e0 haut tronc ont \u00e9t\u00e9 amen\u00e9s - comme si le parc voisin se faufile dans le b\u00e2timent. \r\nLa Gare Maritime, un lieu unique : attractif, novateur, ambitieux.\r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Picardstraat","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Picardstraat","address_line2":"1000 Brussel","description_web":"Gare Maritime: van industrieel goederenstation tot energieneutrale urban jungle!\r\n\r\nDe Gare Maritime is de perfecte setting voor innovatieve, culturele evenementen, film- en fotoshoots, markten, beurzen, lanceringen en promoties. De historische stationshallen van de Gare Maritime zijn omgevormd tot overdekte stad, met foodhall (vanaf september 2021), exclusieve winkels en kantoren. Het gebouwencomplex biedt een waaier aan unieke, inspirerende ruimtes afgewisseld met warme houten volumes: perfect voor de organisatie van kleine en grootschalige happenings. D\u00e9 architecturale eyecatcher is de monumentale middenbeuk die baadt in indirect daglicht en over meer dan voldoende ruimte beschikt voor overdekte activiteiten met veel bezoekers.\r\nEen event in de Gare Maritime is een groen event. Tijdens de renovatie van het gebouw was duurzaamheid een speerpunt. Energie wordt ter plaatse hernieuwbaar opgewekt met geothermie en zonnepanelen. De groene wandelboulevards aan weerszijden van de middenbeuk zijn voorzien van thematuinen en hoogstammige bomen, alsof het aangrenzende park het gebouw binnenstroomt. Gare Maritime is een unieke plek: aantrekkelijk, vernieuwend en ambitieus.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Rue Picard","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue Picard","address_line2":"1000 Brussels","description_web":"The Gare Maritime - From industrial freight station to energy neutral urban jungle!\r\n\r\nIt is the perfect setting for innovative cultural events, film or photo shoots, trade shows, fairs, product launches or promotions. \r\nThe historic station concourse that was part of the Gare Maritime has been transformed into an indoor city with its own food hall (coming September 2021), exclusive shops and offices. Countless unique and inspiring areas and warm, wooden structures alternate in this building complex. It is perfectly suited to accommodate both small and major events. The monumental nave is a true architectural eye-catcher, bathed in indirect sunlight and providing ample space for well-attended indoor activities.\r\nAny event in the Gare Maritime is a green event. Sustainability has been key during the renovation works. The building generates its own energy from renewable sources, using geothermics and solar panels. The green boulevards on either side of the nave are lined with themed gardens and tall trees, as if the adjacent park found its way inside. \r\nThe Gare Maritime is a unique place - attractive, innovative and ambitious.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Rue Picard","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Rue Picard","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Rue Picard","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Gare Maritime - Tour & Taxis","address_street_name":"Rue Picard","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Picard","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Gare Maritime - Tour & Taxis","address_street_