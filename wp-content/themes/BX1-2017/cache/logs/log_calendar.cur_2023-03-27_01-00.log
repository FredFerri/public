ull,"cn":null}},"others":{"list":[36,46],"translations":{"fr":["Mus\u00e9es et art centers","Pluridisciplinaire"],"nl":["Musea en kunstcentra","Multidisciplinair"],"en":["Museums and art centers","Multidisciplinary"],"de":["Museen & Kunstzentren","Multidisziplin\u00e4r"],"it":["Musei e centri artistici","Multidisciplinare"],"sp":["Museos y centros de arte","Multidisciplinar"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Food and the City. Nourrir la ville hier et aujourd'hui","shortdescr":"\u2018Food and the City\u2019 esquisse une image de l'\u00e9volution historique de l'approvisionnement alimentaire et jette un regard sur les d\u00e9fis actuels auxquels les villes font face pour se nourrir.","longdescr":"Chaque jour, plus de 7,5 milliards de personnes sur la plan\u00e8te ont besoin de se nourrir. Cette population vit depuis 2006 majoritairement en zone urbaine. Parall\u00e8lement, le nombre de producteurs ne cesse de diminuer.\r\nMais comment allons-nous nourrir les villes grandissantes si de moins en moins de personnes produisent de la nourriture ?\r\n\u2018Food and the City\u2019 esquisse une image de l'\u00e9volution historique de l'approvisionnement alimentaire et jette un regard sur les d\u00e9fis actuels auxquels les villes font face pour se nourrir.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.moulindevere.be","email":"mbma-bmmv@evere.brussels","phone_contact":"+32 2 245 37 79","phone_booking":"+32 2 245 37 79","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.518227"},"nl":{"name":"Food and the City. De stad voeden, vroeger en nu","shortdescr":"\u2018Food and the City\u2019 schetst een beeld van de historische evolutie van de voedselvoorziening van steden en werpt een blik op de hedendaagse uitdagingen om een stad te voeden.","longdescr":"Meer dan 7,5 miljard mensen op aarde hebben dagelijks behoefte aan voeding. Sinds 2006 leeft meer dan de helft van de wereldbevolking in steden, terwijl het aantal producenten blijft dalen.\r\nMaar hoe gaan we steden voorzien van voedsel als ze steeds groter worden en steeds minder mensen voedsel produceren ?\r\n\u2018Food and the City\u2019 schetst een beeld van de historische evolutie van de voedselvoorziening van steden en werpt een blik op de hedendaagse uitdagingen om een stad te voeden.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.molenevere.be","email":"mbma-bmmv@evere.brussels","phone_contact":"+32 2 245 37 79","phone_booking":"+32 2 245 37 79","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.518227"},"en":{"name":"Food and the City. Nourrir la ville hier et aujourd'hui","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.moulindevere.be","email":"mbma-bmmv@evere.brussels","phone_contact":"+32 2 245 37 79","phone_booking":"+32 2 245 37 79","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.518227"},"de":{"name":"Food and the City. Nourrir la ville hier et aujourd'hui","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.moulindevere.be","email":"mbma-bmmv@evere.brussels","phone_contact":"+32 2 245 37 79","phone_booking":"+32 2 245 37 79","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.518227"},"it":{"name":"Food and the City. Nourrir la ville hier et aujourd'hui","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.moulindevere.be","email":"mbma-bmmv@evere.brussels","phone_contact":"+32 2 245 37 79","phone_booking":"+32 2 245 37 79","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.518227"},"sp":{"name":"Food and the City. Nourrir la ville hier et aujourd'hui","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.moulindevere.be","email":"mbma-bmmv@evere.brussels","phone_contact":"+32 2 245 37 79","phone_booking":"+32 2 245 37 79","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.518227"},"pt":{"name":"Food and the City. Nourrir la ville hier et aujourd'hui","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.moulindevere.be","email":"mbma-bmmv@evere.brussels","phone_contact":"+32 2 245 37 79","phone_booking":"+32 2 245 37 79","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.518227"},"cn":{"name":"Food and the City. Nourrir la ville hier et aujourd'hui","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.moulindevere.be","email":"mbma-bmmv@evere.brussels","phone_contact":"+32 2 245 37 79","phone_booking":"+32 2 245 37 79","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.518227"}},"place":{"id":247056,"translations":{"fr":{"name":"Mus\u00e9e Bruxellois du Moulin et de l'Alimentation","address_street_name":"Rue du Moulin \u00e0 Vent","address_street_number":"21","address_street_box":null,"email":"mbma-bmmv@evere.brussels","website":"http:\/\/www.moulindevere.be","phone_contact":"+32 2 245 37 79","phone_booking":null,"address_zip":"1140","address_city":"Evere","address_line1":"Rue du Moulin \u00e0 Vent, 21","address_line2":"1140 Evere","description_web":"Le Mus\u00e9e bruxellois du Moulin et de l'Alimentation est situ\u00e9 dans l'ancien moulin d'Evere. T\u00e9moin unique du patrimoine industriel bruxellois, ce b\u00e2timent class\u00e9 a suivi toutes les \u00e9volutions techniques des XIXe et XXe si\u00e8cles. Les collections permanentes illustrent le monde de la meunerie et l\u2019histoire du moulin d\u2019Evere. Chaque ann\u00e9e, en septembre, le renouvellement complet des objets expos\u00e9s permet d'approfondir une th\u00e9matique alimentaire diff\u00e9rente.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Brussels Museum van de Molen en de Voeding","address_street_name":"Windmolenstraat","address_street_number":"21","address_street_box":null,"email":"mbma-bmmv@evere.brussels","website":"http:\/\/www.molenevere.be","phone_contact":"+32 2 245 37 79","phone_booking":null,"address_zip":"1140","address_city":"Evere","address_line1":"Windmolenstraat, 21","address_line2":"1140 Evere","description_web":"Het Brussels Museum van de Molen en de Voeding is gelegen in de oude molen van Evere. Als unieke getuige van het industrieel erfgoed van Brussel, heeft dit beschermde monumentale gebouw alle technische ontwikkelingen van de negentiende en twintigste eeuw gekend. De permanente collecties illustreren de wereld en de geschiedenis van de molen van Evere. Elk jaar in september wordt de selectie van tentoongestelde voorwerpen compleet vernieuwd wat toelaat zich telkens opnieuw in een nieuw voedingsthema te verdiepen.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Brussels Museum of the Mill and Food","address_street_name":"Rue du Moulin \u00e0 Vent","address_street_number":"21","address_street_box":null,"email":"mbma-bmmv@evere.brussels","website":"http:\/\/www.moulindevere.be","phone_contact":"+32 2 245 37 79","phone_booking":null,"address_zip":"1140","address_city":"Evere","address_line1":"Rue du Moulin \u00e0 Vent, 21","address_line2":"1140 Evere","description_web":"Based in a former windmill, the Brussels Museum of the Mill and Food is located in an extensive island of greenery. Since its opening in 2008, the museum has explored numerous topics related to food in temporary exhibitions.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Mus\u00e9e Bruxellois du Moulin et de l'Alimentation","address_street_name":"Rue du Moulin \u00e0 Vent","address_street_number":"21","address_street_box":null,"email":"mbma-bmmv@evere.brussels","website":"http:\/\/www.moulindevere.be","phone_contact":"+32 2 245 37 79","phone_booking":null,"address_zip":"1140","address_city":"Evere","address_line1":"Rue du Moulin \u00e0 Vent, 21","address_line2":"1140 Evere","description_web":"Das Br\u00fcsseler Museum der M\u00fchle und der Ern\u00e4hrung ist in der alten M\u00fchle von Evere untergebracht. Als architektonisches Zeugnis des Br\u00fcsseler Industrieerbes hat die M\u00fchle s\u00e4mtliche technische Entwicklungen des 19. und 20. Jahrhunderts durchlaufen. Die Ausstellungen zeigen die Welt der M\u00fcllerei und die Geschichte der M\u00fchle von Evere. Jedes Jahre im September werden die Exponate ausgetauscht, so dass immer wieder neue Themen im Zusammenhang mit der Ern\u00e4hrung vertieft werden k\u00f6nnen.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Mus\u00e9e Bruxellois du Moulin et de l'Alimentation","address_street_name":"Rue du Moulin \u00e0 Vent","address_street_number":"21","address_street_box":null,"email":"mbma-bmmv@evere.brussels","website":"http:\/\/www.moulindevere.be","phone_contact":"+32 2 245 37 79","phone_booking":null,"address_zip":"1140","address_city":"Evere","address_line1":"Rue du Moulin \u00e0 Vent, 21","address_line2":"1140 Evere","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Mus\u00e9e Bruxellois du Moulin et de l'Alimentation","address_street_name":"Rue du Moulin \u00e0 Vent","address_street_number":"21","address_street_box":null,"email":"mbma-bmmv@evere.brussels","website":"http:\/\/www.moulindevere.be","phone_contact":"+32 2 245 37 79","phone_booking":null,"address_zip":"1140","address_city":"Evere","address_line1":"Rue du Moulin \u00e0 Vent, 21","address_line2":"1140 Evere","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Mus\u00e9e Bruxellois du Moulin et de l'Alimentation","address_street_name":"Rue du Moulin \u00e0 Vent","address_street_number":"21"