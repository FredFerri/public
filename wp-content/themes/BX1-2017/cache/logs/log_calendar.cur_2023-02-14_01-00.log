gin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":1.2599210498949},{"id":550724,"date_start":"2023-02-17","date_end":"2023-02-18","date_next":"2023-02-17","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre","de":"Theater","it":"Teatro","sp":"Teatro","pt":null,"cn":null}},"others":{"list":[50],"translations":{"fr":["Th\u00e9\u00e2tre"],"nl":["Theater"],"en":["Theatre"],"de":["Theater"],"it":["Teatro"],"sp":["Teatro"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Couple en danger","shortdescr":"Vivre en couple, une utopie ?","longdescr":"Vivre en couple, une utopie ?\r\n\r\nEric Assous s\u2019immisce avec humour et \u00e9motion dans la vie d\u2019un couple de \r\nquadrag\u00e9naires en plein questionnement : comment et pourquoi continuer \u00e0 vivre \r\nensemble alors que la routine s\u2019est \r\ninstall\u00e9e et que chacun.e semble ne plus attendre la m\u00eame chose du voyage ?\r\n\r\nUne discussion anodine \u00e0 propos d\u2019un film se transforme en crise conjugale ; de la \r\nfiction \u00e0 la r\u00e9alit\u00e9, faudra-t-il revoir ses d\u00e9sirs \u00e0 la baisse ou regarder la vie \r\nautrement ?","performers":"Mise en sc\u00e8ne : Marie-Paule Kumps\r\nAvec Delphine Charlier & Laurent Bonnet\r\nTexte de Eric Assous","boxoffice_url":null,"website":"http:\/\/www.fourire.be","email":"reservations@fourire.be","phone_contact":"+32 483 59 92 29","phone_booking":"+32 483 59 92 29","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.550724"},"nl":{"name":"Couple en danger","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"h