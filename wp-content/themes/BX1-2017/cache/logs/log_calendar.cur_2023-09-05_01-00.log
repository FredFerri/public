tuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2023-09-04T20:15:05+02:00","published_at":"2023-06-20T08:37:14+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":280009,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"concert","ranking":1,"languages":{"spoken":["fr","nl"],"subtitles":[]},"categories":{"main":{"id":1,"translations":{"de":"Konzert","pt":null,"en":"Concert","it":"Concerti","cn":null,"fr":"Concert","sp":"Concierto","nl":"Concert"}},"others":{"list":[2],"translations":{"de":["Klassisch"],"pt":[null],"en":["Classical"],"it":["Classica"],"cn":[null],"fr":["Classique"],"sp":["Cl\u00e1sica"],"nl":["Klassiek"]}}},"translations":{"de":{"name":"Ensemble Psallentes - Arnaud Van de Cauter - VOX ANGELI","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.voceorgano.be","email":"info@voceorgano.be","phone_contact":"+32 487 49 76 59","phone_booking":"+32 487 49 76 59","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.560009"},"pt":{"name":"Ensemble Psallentes - Arnaud Van de Cauter - VOX ANGELI","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.voceorgano.be","email":"info@voceorgano.be","phone_contact":"+32 487 49 76 59","phone_booking":"+32 487 49 76 59","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.560009"},"en":{"name":"Ensemble Psallentes - Arnaud Van de Cauter - VOX ANGELI","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"http:\/\/ticket.visit.brussels\/en\/560009\/ensemble-psallentes-arnaud-van-de-cauter-vox-angeli\/shop","website":"http:\/\/www.voceorgano.be","email":"info@voceorgano.be","phone_contact":"+32 487 49 76 59","phone_booking":"+32 487 49 76 59","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.560009"},"it":{"name":"Ensemble Psallentes - Arnaud Van de Cauter - VOX ANGELI","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.voceorgano.be","email":"info@voceorgano.be","phone_contact":"+32 487 49 76 59","phone_booking":"+32 487 49 76 59","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.560009"},"cn":{"name":"Ensemble Psallentes - Arnaud Van de Cauter - VOX ANGELI","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.voceorgano.be","email":"info@voceorgano.be","phone_contact":"+32 487 49 76 59","phone_booking":"+32 487 49 76 59","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.560009"},"fr":{"name":"Ensemble Psallentes - Arnaud Van de Cauter - VOX ANGELI","shortdescr":"VOX ANGELI : un concert - \u00e9v\u00e9nement que ce premier concert d'inauguration de l'orgue Schyven restaur\u00e9 ! Codex Calixtinus et oeuvres de Cesar Franck, Alphonse Mailly, Joseph Jongen","longdescr":"A bout de souffle depuis de nombreuses ann\u00e9es, il y a bien longtemps que cet orgue, construit en 1890 par le facteur d\u2019orgues Bruxellois Pierre Schyven, n\u2019a plus r\u00e9sonn\u00e9 sous les vo\u00fbtes de l\u2019\u00e9glise Notre-Dame de la Chapelle de Bruxelles. Le voici d\u00e9sormais fra\u00eechement restaur\u00e9 par Michel Jurine. On d\u00e9crit parfois Psallentes comme des anges qui chantent... Cette fois, ce sera vrai ! Sept chanteuses interpr\u00e9teront la musique des anges, celle des \"Anges Chantants\" peints par Hans Memling au XVe si\u00e8cle. Mais il n'y a ni temps ni espace au paradis : vous entendrez donc de la musique du XIIe si\u00e8cle (comme le \"Codex Calixtinus\"), du XIVe si\u00e8cle (la \"Messe de Tournai\") et m\u00eame du XIXe si\u00e8cle (\"Abide with me\"). Des \u0153uvres qui alterneront avec le r\u00e9pertoire pour orgue dans des pages sign\u00e9es par des compositeurs belges qui ont fait la renomm\u00e9e de la musique de chez nous bien au-del\u00e0 de nos fronti\u00e8res : Alphonse Mailly, C\u00e9sar Franck, Joseph Jongen.","performers":"Ensemble Psallentes Hendrik Vanden Abeele, direction Arnaud Van de Cauter, orgue","boxoffice_url":"http:\/\/ticket.visit.brussels\/fr\/560009\/ensemble-psallentes-arnaud-van-de-cauter-vox-angeli\/shop","website":"http:\/\/www.voceorgano.be","email":"info@voceorgano.be","phone_contact":"+32 487 49 76 59","phone_booking":"+32 487 49 76 59","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.560009"},"sp":{"name":"Ensemble Psallentes - Arnaud Van de Cauter - VOX ANGELI","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.voceorgano.be","email":"info@voceorgano.be","phone_contact":"+32 487 49 76 59","phone_booking":"+32 487 49 76 59","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.560009"},"nl":{"name":"Ensemble Psallentes - Arnaud Van de Cauter - VOX ANGELI","shortdescr":"VOX ANGELI : Inhuldiging van het gerestaureerd Schyven orgel (1) Codex Calixtinus en werken van Cesar Franck, Alphonse Mailly, Joseph Jongen","longdescr":"Jarenlang buiten adem, weerklonk het in 1890 gebouwde orgel van de Brusselse orgelbouwer Pierre Schyven sinds lang niet meer onder de gewelven van de OLV ter Kapellekerk. Des te gelukkiger zijn wij de inhuldiging van het orgel, gerestaureerd door Michel Jurine (F), aan te kondigen: het eerste concert heeft plaats op vrijdag 8 september 2023. Organist Arnaud Van de Cauter zal samen met het Psallentes-ensemble spelen geleid door Hendrik Vanden Abeele. Van Psallentes wordt al eens gezegd dat het is alsof er engelen zingen, maar deze keer mag je dat iets letterlijker nemen: de zeven zangeressen hebben \u2018engelenmuziek\u2019 gekozen die goed past bij Memlings Zingende Engelen. Omdat in de hemel tijd noch ruimte is, hoeft dat niet per se muziek uit de tijd van Memling te zijn. Er is muziek te horen uit de XIIde eeuw (zoals de Codex Calixtinus), de XIVde eeuw (Messe de Tournai) tot de XIXde eeuw (Abide with me). De cantus planus wordt afgewisseld met werken voor orgel in pagina\u2019s van Belgische componisten die de Belgische muziek tot ver buiten onze grenzen beroemd hebben gemaakt: Alphonse Mailly, C\u00e9sar Franck, Joseph Jongen.","performers":"Ensemble Psallentes Hendrik Vanden Abeele, directie Arnaud Van de Cauter, orgel","boxoffice_url":"http:\/\/ticket.visit.brussels\/nl\/560009\/ensemble-psallentes-arnaud-van-de-cauter-vox-angeli\/shop","website":"http:\/\/www.voceorgano.be","email":"info@voceorgano.be","phone_contact":"+32 487 49 76 59","phone_booking":"+32 487 49 76 59","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.560009"}},"place":{"id":479,"translations":{"de":{"name":"Kirche Notre-Dame de la Chapelle","address_street_name":"Place de la Chapelle","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Chapelle","address_line2":"1000 Bruxelles","description_web":"Die Br\u00fcsseler Notre Dame de la Chapelle-Kirche ist aufgrund ihrer romanischen Architektur bemerkenswert und gilt als eine der interessantesten Kirchen Belgiens.\r\n\r\nIn einer der Kapellen befindet sich das Grabmal des Malers Pieter Breughel und seiner Gemahlin, Marie Coucke. In der Kapelle des Heiligen Sakraments erinnert eine Gedenktafel daran, dass sich hier auch die letzte Ruhest\u00e4tte des zum Tode verurteilten und hingerichteten K\u00f6rperschafts\u00e4ltesten Fran\u00e7ois Anneessens, der sich f\u00fcr die Gemeindefreiheit der Stadt Br\u00fcssel eingesetzt hat, befindet.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"\u00c9glise Notre-Dame de la Chapelle","address_street_name":"Rue de la Chapelle","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Chapelle","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"\u00c9glise Notre-Dame de la Chapelle","address_street_name":"Rue de la Chapelle","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Chapelle","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"\u00c9glise Notre-Dame de la Chapelle","address_street_name":"Rue de la Chapelle","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Chapelle","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"\u00c9glise Notre-Dame de la Chapelle","address_street_name":"Rue de la Chapelle","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de la Chapelle","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"fr":{"name":"\u00c9glise Notre-Dame de la Chapelle","address_street_name":"Rue de la Chapelle","address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_boo