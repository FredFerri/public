aux sources qu\u2019il se r\u00e9jouit de pr\u00e9senter au public belge. La volont\u00e9 de se produire dans de petites salles au charme atypique, au plus proche de son public existe depuis des ann\u00e9es chez Bastian.\n\nCette envie se transforme en r\u00e9alit\u00e9. Au programme, tous ses tubes interpr\u00e9t\u00e9s dans leur version originale, anecdotes de tourn\u00e9es, interaction, improvisation, setlist \u00ab\u202f\u00e0 la carte\u202f\u00bb.\n\nUne soir\u00e9e comme vous n\u2019en avez jamais v\u00e9cue, aux c\u00f4t\u00e9s de l\u2019artiste\u202f!","performers":null,"boxoffice_url":null,"website":"https:\/\/whalll.be\/evenement\/bastian-baker\/","email":"billetterie@whalll.be","phone_contact":"+32 2 435 59 99","phone_booking":"+32 2 435 59 99","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50007526"},"sp":{"name":"Bastian Baker","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/whalll.be\/evenement\/bastian-baker\/","email":"billetterie@whalll.be","phone_contact":"+32 2 435 59 99","phone_booking":"+32 2 435 59 99","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50007526"},"nl":{"name":"Bastian Baker","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/whalll.be\/evenement\/bastian-baker\/","email":"billetterie@whalll.be","phone_contact":"+32 2 435 59 99","phone_booking":"+32 2 435 59 99","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50007526"}},"place":{"id":241270,"translations":{"de":{"name":"W:Halll - Centre culturel de Woluwe-Saint-Pierre","address_street_name":"Avenue Charles Thielemans","address_street_number":"93","address_street_box":null,"email":"billetterie@whalll.be","website":"http:\/\/www.whalll.be","phone_contact":"+32 2 435 59 95","phone_booking":"+32 2 435 59 99","address_zip":"1150","address_city":"Woluwe-Saint-Pierre","address_line1":"Avenue Charles Thielemans, 93","a