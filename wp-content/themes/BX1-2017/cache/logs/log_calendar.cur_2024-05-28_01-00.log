e anthropologique qui cherche \u00e0 fabriquer un nouveau paradigme socioprofessionnel.\r\nC\u2019est un de ces territoires\r\no\u00f9 les diff\u00e9rentes esp\u00e8ces cohabitent,\r\nse laissant boire tranquillement l\u2019eau devenue si rare,\r\nparce qu\u2019il faut bien de ces espaces l\u00e0 dans une telle \u00e9poque,\r\nparce qu\u2019il est toujours bon d\u2019essayer encore une fois de vivre autrement. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Le Lac","address_street_name":"rue de Witte de Haelen","address_street_number":"36","address_street_box":null,"email":"lemaildulac@gmail.com","website":"https:\/\/www.lelac.info\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"rue de Witte de Haelen, 36","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Le Lac","address_street_name":"de Witte de Haelenstraat","address_street_number":"36","address_street_box":null,"email":"lemaildulac@gmail.com","website":"https:\/\/www.lelac.info\/","phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"de Witte de Haelenstraat, 36","address_line2":"1000 Brussel","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[3,8],"translations":{"de":["Dansaert\/Sainte-Catherine","Kanal-Viertel"],"pt":[null,null],"en":["Dansaert\/Sainte-Catherine","Canal"],"it":["Dansaert\/Sainte-Catherine","Canal"],"cn":[null,null],"fr":["Dansaert\/Sainte-Catherine","Canal"],"sp":["Dansaert\/Sainte-Catherine","Canal"],"nl":["Dansaertwijk\/Sint-Katelijne","Kanaalwijk"]}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Ce