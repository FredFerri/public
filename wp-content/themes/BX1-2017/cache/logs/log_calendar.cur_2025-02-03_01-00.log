qui se d\u00e9battent pour exister. Odette, Daniel et Jean vivent dans une petite commune au coeur des Laurentides, au nord de Montr\u00e9al, coinc\u00e9e entre les sapins et les lignes \u00e0 haute tension. L\u00e0, dans ces vastes espaces o\u00f9 tout semble jou\u00e9 d'avance, un \u00e9v\u00e9nement brutal fait voler en \u00e9clats l'apparente tranquillit\u00e9 des lieux. Ce huis-clos enneig\u00e9, cadre d\u2019une trag\u00e9die ordinaire, questionne avec d\u00e9licatesse l\u2019isolement et la pr\u00e9destination, fils rouges in\u00e9vitables d\u2019un portrait social tendre et grin\u00e7ant \u00e0 la fois.","performers":"\u00c9criture et Mise en sc\u00e8ne Diane Jacquier | Avec Julie Meyer, Samuel Padolus, Lionel Robyr | Lumi\u00e8res Cl\u00e9ment Reber | Musique Samuel Padolus | Accompagnement chor\u00e9graphique Natacha Nicora","boxoffice_url":null,"website":"https:\/\/lesrichesclaires.be\/saison\/sloche\/","email":"diffusion@lesrichesclaires.be","phone_contact":"+32 2 548 25 80","phone_booking":"+32 2 548 25 80","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700001487"},"sp":{"name":"Sloche","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lesrichesclaires.be\/saison\/sloche\/","email":"diffusion@lesrichesclaires.be","phone_contact":"+32 2 548 25 80","phone_booking":"+32 2 548 25 80","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700001487"},"nl":{"name":"Sloche","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lesrichesclaires.be\/saison\/sloche\/","email":"diffusion@lesrichesclaires.be","phone_contact":"+32 2 548 25 80","phone_booking":"+32 2 548 25 80","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700001487"}},"place":{"id":1085,"translations":{"de":{"name":"Les Riches-Claires","address_street_name":"Rue des Riches Claires","address_street_number":"24","address_street_box":null,