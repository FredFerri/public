ns":{"fr":["Centre"],"nl":["Centrum"],"en":["Centre"],"de":["Zentrum"],"it":["Centro"],"sp":["Centro"],"pt":[null],"cn":[null]}},"neca":null,"facebook_id":null,"backoffice_id":35830,"location":{"lat":50.84996484,"lon":4.35348679},"region":"brussels","last_updated_at":"2023-04-25T13:05:16+02:00","published_at":"2020-08-19T18:00:11+02:00","import_origin":"muntpunt","external_id":null,"is_in_address_book":false,"is_in_vb_export":false,"resto_ranking":0},"organizer":{"id":250926,"translations":{"fr":{"name":"Muntpunt","address_street_name":"Place de la Monnaie","address_street_number":"6","address_street_box":null,"email":"info@muntpunt.be","website":"http:\/\/www.muntpunt.be","phone_contact":"+32 2 278 11 11","phone_booking":"+32 2 278 11 11","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Monnaie, 6","address_line2":"1000 Bruxelles","description_web":"Muntpunt est une biblioth\u00e8que, un lieu d'information et de rencontres. Laissez-vous inspirer par des livres, des histoires et des rencontres adapt\u00e9es \u00e0 la capitale. Apprenez tout sur le travail, les \u00e9tudes, et la vie \u00e0 Bruxelles et en Flandre. D\u00e9couvrez la richesse de l' offre culturelle n\u00e9erlandophone des organisations bruxelloises et flamandes.  ","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Muntpunt","address_street_name":"Muntplein","address_street_number":"6","address_street_box":null,"email":"info@muntpunt.be","website":"http:\/\/www.muntpunt.be","phone_contact":"+32 2 278 11 11","phone_booking":"+32 2 278 11 11","address_zip":"1000","address_city":"Brussel","address_line1":"Muntplein, 6","address_line2":"1000 Brussel","description_web":"Muntpunt is een bibliotheek, informatiehuis, ontmoetingsplek en je venster op Brussel. Laat je inspireren door boeken, verhalen en ontmoetingen op maat van de hoofdstad. Kom meer te weten over wonen, werken, studeren, leven en beleven in Brussel en Vlaanderen. Ontdek het rijke Nederlandstalige culturele en vrijetijdsaanbod van Brusselse en Vlaamse organisaties.\r\n\r\nIn Muntpunt kan je meer dan alleen boeken, cd\u2019s en dvd\u2019s ontlenen. Je kan er ook terecht voor activiteiten, taalcursussen, infosessies, luisterboeken, strips, spelletjes, en nog veel meer. Er valt bijna dagelijks iets te beleven in Muntpunt, van voorlezen tot documentaires, van infosessies tot rondleidingen, voor jong en oud. De activiteiten sluiten aan bij de bibliotheekwerking of spelen in op actuele thema's, steeds met de Brusselse hoofdstedelijke context in het achterhoofd. De rode draad door de programmatie is de samenwerking met Vlaamse en Brusselse partnerorganisaties. \r\n\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Muntpunt","address_street_name":"Place de la Monnaie","address_street_number":"6","address_street_box":null,"email":"info@muntpunt.be","website":"http:\/\/www.muntpunt.be","phone_contact":"+32 2 278 11 11","phone_booking":"+32 2 278 11 11","address_zip":"1000","address_city":"Brussels","address_line1":"Place de la Monnaie, 6","address_line2":"1000 Brussels","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Muntpunt","address_street_name":"Place de la Monnaie","address_street_number":"6","address_street_box":null,"email":"info@muntpunt.be","website":"http:\/\/www.muntpunt.be","phone_contact":"+32 2 278 11 11","phone_booking":"+32 2 278 11 11","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place de la Monnaie, 6","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Muntpunt","address_street_name":"Place de la Monnaie","address_street_number":"6","address_street_box":null,"email":"info@muntpunt.be","website":"http:\/\/www.muntpunt.be","phone_contact":"+32 2 278 11 11","phone_booking":"+32 2 278 11 11","ad