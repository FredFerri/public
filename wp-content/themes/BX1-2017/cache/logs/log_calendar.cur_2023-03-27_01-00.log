4054},{"id":546511,"date_start":"2022-12-01","date_end":"2023-12-31","date_next":"2023-03-26","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":true,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen","it":"Visite guidate","sp":"Visitas guiadas","pt":null,"cn":null}},"others":{"list":[112],"translations":{"fr":["Insolite"],"nl":["Ongewoon"],"en":["Unusual"],"de":["Ausgefallenes"],"it":["Insolito"],"sp":["Ins\u00f3lito"],"pt":[null],"cn":[null]}}},"languages":{"spoken":["fr","en"],"subtitles":[]},"translations":{"fr":{"name":"A la recherche de Victor Sackville","shortdescr":"Au travers d\u2019une v\u00e9ritable chasse \u00e0 l\u2019espion dans le quartier, pr\u00e9parez vous \u00e0 une course sportive et culturelle, venez \u00e0 la rencontre de l\u2019aventurier qui sommeille en vous!","longdescr":"Plongez dans coeur battant de la capitale avec une mission bien pr\u00e9cise: aider l\u2019espion Victor Sackville! Responsable du transport des bijoux de la reine d\u2019Angleterre, il a \u00e9t\u00e9 victime d\u2019un assaut: bless\u00e9, il a perdu la m\u00e9moire et les bijoux ont \u00e9t\u00e9 vol\u00e9s!\r\nPlusieurs agents secrets, cach\u00e9s \u00e0 Bruxelles, sont pr\u00eats \u00e0 l\u2019aider... Mais si l\u2019un d\u2019entre eux \u00e9tait l\u2019agresseur?\r\n\r\nLa bande annonce: https:\/\/youtu.be\/88-vnZLbQa8 \r\n\r\nAu travers d\u2019une v\u00e9ritable chasse \u00e0 l\u2019espion dans le quartier, pr\u00e9parez-vous \u00e0 une course sportive et culturelle, venez \u00e0 la rencontre de l\u2019aventurier qui sommeille en vous!\r\nD\u2019une \u00e9preuve \u00e0 l\u2019autre, qui sera l\u2019\u00e9quipe gagnante qui trouvera l\u2019espion en premi\u00e8re?","performers":null,"boxoffice_url":null,"website":"http:\/\/www.itineraires.be","email":"info@itineraires.be","phone_contact":null,"phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.546511"},"nl":{"name":"A la recherche de Victor Sackville","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.itineraires.be","email":"info@itineraires.be","phone_contact":null,"phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.546511"},"en":{"name":"Mission: Victor Sackville","shortdescr":"Through a real spy hunt in the neighborhood, get ready for a sportive and cultural race, come and meet the adventurer in you!","longdescr":"Dive into the Marolles, the beating heart of the capital, with a very specific mission: help the spy Victor Sackville! In charge of transporting the jewels of the Queen, he has been the victim of an assault: wounded, he has lost his memory and the jewels have been stolen!\r\nSeveral secret agents, hidden in Brussels, are ready to help him... But what if one of them was the aggressor?\r\nThrough a real spy hunt in the neighborhood, get ready for a sportive and cultural race, come and meet the adventurer in you!\r\nFrom one spot to the next, who will be the winning team that finds the spy first?\r\n\r\nDiscover our teaser : https:\/\/youtu.be\/b2p9Np4mVcs","performers":null,"boxoffice_url":null,"website":"http:\/\/www.itineraires.be","email":"info@itineraires.be","phone_contact":null,"phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.546511"},"de":{"name":"A la recherche de Victor Sackville","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.itineraires.be","email":"info@itineraires.be","phone_contact":null,"phone_booking":"+32 496 38 85 94","agenda_url":"https:\/\/visit.brussels\/de\/vis