s":null,"boxoffice_url":"https:\/\/www.visit.brussels\/en\/visitors\/agenda\/event-detail\/book-tickets.Schaerbeek-fleuron-de-l-Art-deco.5700005982","website":"https:\/\/www.provelo.org\/events\/schaerbeek-fleuron-de-larchitecture-de-lentre-deux-guerres-2\/","email":"info@provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700005982"},"en":{"name":"Schaerbeek, fleuron de l'Art d\u00e9co","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/www.visit.brussels\/en\/visitors\/agenda\/event-detail\/book-tickets.Schaerbeek-fleuron-de-l-Art-deco.5700005982","website":"https:\/\/www.provelo.org\/events\/schaerbeek-fleuron-de-larchitecture-de-lentre-deux-guerres-2\/","email":"info@provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700005982"},"it":{"name":"Schaerbeek, fleuron de l'Art d\u00e9co","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/www.visit.brussels\/it\/visitatori\/agenda\/event-detail\/book-tickets.Schaerbeek-fleuron-de-l-Art-deco.5700005982","website":"https:\/\/www.provelo.org\/events\/schaerbeek-fleuron-de-larchitecture-de-lentre-deux-guerres-2\/","email":"info@provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700005982"},"cn":{"name":"Schaerbeek, fleuron de l'Art d\u00e9co","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/www.visit.brussels\/en\/visitors\/agenda\/event-detail\/book-tickets.Schaerbeek-fleuron-de-l-Art-deco.5700005982","website":"https:\/\/www.provelo.org\/events\/schaerbeek-fleuron-de-larchitecture-de-lentre-deux-guerres-2\/","email":"info@provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700005982"},"fr":{"name":"Schaerbeek, fleuron de l'architecture de l'Entre-deux-guerres","shortdescr":"Si Schaerbeek est c\u00e9l\u00e8bre pour son patrimoine Art nouveau, les architectes de l\u2019Entre-deux guerres y ont \u00e9t\u00e9 aussi tr\u00e8s actifs.","longdescr":"Si Schaerbeek est c\u00e9l\u00e8bre pour son patrimoine Art nouveau, les architectes de l\u2019Entre-deux guerres y ont \u00e9t\u00e9 aussi tr\u00e8s actifs. Apr\u00e8s la 1\u00e8re guerre mondiale, la commune va conna\u00eetre un second d\u00e9veloppement urbain. Habitation unifamiliale, \u00e9coles, immeuble \u00e0 appartement, \u00e9glise et cit\u00e9-jardin vont alors faire la part belle \u00e0 deux styles architecturaux de l\u2019\u00e9poque : l\u2019Art d\u00e9co qui d\u00e8s les ann\u00e9es 20 va d\u00e9velopper un langage ornemental liant modernit\u00e9, luxe et exotisme et le Modernisme qui \u00e0 partir des ann\u00e9es 30 viendra s\u2019opposer \u00e0 l\u2019Art d\u00e9co en privil\u00e9giant la fonction \u00e0 l\u2019ornementation. Enfourchez votre v\u00e9lo et admirez de ce que les ann\u00e9es folles ont produit de mieux, un fabuleux patrimoine architectural. Du quartier des fleurs, aux cit\u00e9-jardin du Terdelt, de l\u2019\u00e9glise Sainte-Suzanne au neptunium, d\u00e9couvrez une nouvelle facette de cette commune devenue fleuron de l\u2019architecture de l\u2019Entre-deux-guerres.","performers":null,"boxoffice_url":"https:\/\/www.visit.brussels\/fr\/visiteurs\/agenda\/event-detail\/book-tickets.Schaerbeek-fleuron-de-l-architecture-de-l-Entre-deux-guerres.5700005982","website":"https:\/\/www.provelo.org\/events\/schaerbeek-fleuron-de-larchitecture-de-lentre-deux-guerres-2\/","email":"info@provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700005982"},"sp":{"name":"Schaerbeek, fleuron de l'Art d\u00e9co","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/www.visit.brussels\/es\/visitantes\/agenda\/event-detail\/book-tickets.Schaerbeek-fleuron-de-l-Art-deco.5700005982","website":"https:\/\/www.provelo.org\/events\/schaerbeek-fleuron-de-larchitecture-de-lentre-deux-guerres-2\/","email":"info@provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700005982"},"nl":{"name":"Schaerbeek, fleuron de l'Art d\u00e9co","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"https:\/\/www.visit.brussels\/nl\/bezoekers\/agenda\/event-detail\/book-tickets.Schaerbeek-fleuron-de-l-Art-deco.5700005982","website":"https:\/\/www.provelo.org\/events\/schaerbeek-fleuron-de-larchitecture-de-lentre-deux-guerres-2\/","email":"info@provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700005982"}},"place":{"id":280319,"translations":{"de":{"name":"Pro Velo","address_street_name":"Rue de Dublin","address_street_number":"19","address_street_box":null,"email":"info@provelo.org","website":"http:\/\/www.provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de Dublin, 19","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Pro Velo","address_street_name":"Rue de Dublin","address_street_number":"19","address_street_box":null,"email":"info@provelo.org","website":"http:\/\/www.provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de Dublin, 19","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Pro Velo","address_street_name":"Rue de Dublin","address_street_number":"19","address_street_box":null,"email":"info@provelo.org","website":"http:\/\/www.provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de Dublin, 19","address_line2":"1050 Ixelles","description_web":"Pro Velo can help you make the transition to active mobility and cycling.\nSince 1992, our team has been offering professional support to private individuals, public authorities and businesses in the form of tailor-made services and solutions. Our main aim: to meet your needs and contribute to a better quality of life!\n--\nAll year round, Pro Velo offers guided bike rides on request or on scheduled dates in Brussels and Wallonia. Gastronomy, architecture, history, sustainable development... these are just some of the themes that will enable you to (re)discover your region from a different angle!\nPro Velo promotes quality, local, sustainable and responsible tourism, using the bicycle as a tool for discovery, well-being and sharing. \nFollow our guide with your family, friends, colleagues or on your own!","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Pro Velo","address_street_name":"Rue de Dublin","address_street_number":"19","address_street_box":null,"email":"info@provelo.org","website":"http:\/\/www.provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de Dublin, 19","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Pro Velo","address_street_name":"Rue de Dublin","address_street_number":"19","address_street_box":null,"email":"info@provelo.org","website":"http:\/\/www.provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de Dublin, 19","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Pro Velo","address_street_name":"Rue de Dublin","address_street_number":"19","address_street_box":null,"email":"info@provelo.org","website":"http:\/\/www.provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de Dublin, 19","address_line2":"1050 Ixelles","description_web":"Pro Velo vous accompagne vers une mobilit\u00e9 active et facilite votre transition vers le v\u00e9lo.\nDepuis\u00a01992, notre \u00e9quipe offre un\u00a0soutien professionnel\u00a0aux\u00a0particuliers, aux\u00a0pouvoirs publics\u00a0et aux\u00a0entreprises\u00a0sous forme de\u00a0services\u00a0et de\u00a0solutions \u00ab\u00a0sur mesure\u00a0\u00bb. Notre but principal\u00a0:\u00a0r\u00e9pondre \u00e0 vos besoins et contribuer ainsi \u00e0 une\u00a0meilleure qualit\u00e9 de vie\u00a0!\n--\nToute l\u2019ann\u00e9e, Pro Velo vous propose des balades guid\u00e9es \u00e0 v\u00e9lo sur demande ou \u00e0 des dates programm\u00e9es \u00e0 Bruxelles et en Wallonie. Gastronomie, architecture, histoire, projet durable\u2026 autant de th\u00e9matiques qui vous feront (re)d\u00e9couvrir votre r\u00e9gion sous un autre regard\u00a0!\nPro Velo promeut un tourisme de qualit\u00e9, local, durable et responsable en utilisant le v\u00e9lo comme outil de d\u00e9couverte, de bien-\u00eatre et de partage. \nSuivez notre guide en famille, entre amis, coll\u00e8gues ou en solo\u00a0!","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Pro Velo","address_street_name":"Rue de Dublin","address_street_number":"19","address_street_box":null,"email":"info@provelo.org","website":"http:\/\/www.provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de Dublin, 19","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Pro Velo","address_street_name":"Dublinstraat","address_street_number":"19","address_street_box":null,"email":"info@provelo.org","website":"http:\/\/www.provelo.org","phone_contact":"+32 2 502 73 55","phone_booking":null,"address_zip":"1050","address_city":"Elsene","address_line1":"Dublinstraat, 19","address_line2":"1050 Elsene","description_web":"Pro Velo kan je helpen de overstap te maken naar actieve mobiliteit en fietsen.\nSinds 1992 biedt ons team professionele ondersteuning aan particulieren, overheden en bedrijven in de vorm van diensten en oplossingen op maat. Ons hoofddoel: voldoen aan uw behoeften en bijdragen tot een betere levenskwaliteit!\n--\nHet hele jaar door biedt Pro Velo begeleide fietstochten op aanvraag of op geplande data in Brussel en Walloni\u00eb. Gastronomie, architectuur, geschiedenis, duurzame ontwikkeling... dit zijn slechts enkele van de thema's die u in staat zullen stellen om uw regio vanuit een andere invalshoek te (her)ontdekken!\nPro Velo promoot kwaliteitsvol, lokaal, duurzaam en verantwoord toerisme, met de fiets als middel om te ontdekken, te genieten en te delen. \nVolg onze gids met je familie, vrienden, collega's of alleen!","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[4],"translations":{"de":["Matonge\/Saint-Boniface"],"pt":[null],"en":["Matonge\/Saint-Boniface"],"it":["Matonge\/Saint-Boniface"],"cn":[null],"fr":["Matonge\/Saint-Boniface"],"sp":["Matong\u00e9\/Saint-Boniface"],"nl":["Matonge\/Sint-Bonifatius"]}},"zones":{"list":[21],"translations":{"de":["S\u00fcden"],"pt":[null],"en":["South"],"it":["Sud"],"cn":[null],"fr":["Sud"],"sp":["Sur"],"nl":["Zuid"]}},"neca":null,"facebook_id":null,"backoffice_id":40319,"location":{"lat":50.83710821,"lon":4.36720312},"region":"brussels"