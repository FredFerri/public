,"end":"17:00:00"}]},"thursday":{"is_open":true,"hours":[{"start":"10:00:00","end":"17:00:00"}]},"friday":{"is_open":true,"hours":[{"start":"10:00:00","end":"17:00:00"}]},"saturday":{"is_open":true,"hours":[{"start":"10:00:00","end":"17:00:00"}]},"sunday":{"is_open":false}},"translations":{"fr":["lundi, mardi, mercredi, jeudi, vendredi et samedi: de 10:00 \u00e0 17:00","dimanche: ferm\u00e9"],"nl":["maandag, dinsdag, woensdag, donderdag, vrijdag en zaterdag: van 10:00 tot 17:00","zondag: gesloten"],"en":["monday, tuesday, wednesday, thursday, friday and saturday: from 10:00 to 17:00","sunday: closed"]},"date_start":"2022-06-18","date_end":"2022-07-10","is_also_by_appointment":false}],"prices":[{"translations":{"fr":{"name":"Normal"},"nl":{"name":"Normaal"},"en":{"name":"Normal"}},"value":0}],"child_events":[],"parent_events":[532743],"targets":{"list":[],"translations":{}},"visit_profile":{"list":[320],"translations":{"fr":["Classique"],"nl":["Klassiek"],"en":["Classic"]}},"visit_content":{"list":[428],"values":["brussels-renaissance-festival"]},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-05-12T11:05:05+02:00","published_at":"2022-04-29T14:34:31+02:00","backoffice_id":252838,"import_origin":null,"sub_type":"tour","show_in_agenda":true,"ranking":0.35163388691696},{"id":532744,"date_start":"2022-06-18","date_end":"2022-07-10","date_next":"2022-06-18","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[36],"translations":{"fr":["Mus\u00e9es et art centers"],"nl":["Musea en kunstcentra"],"en":["Museums and art centers"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Projet Ommegang","shortdescr":null,"longdescr":"L\u2019exposition Projet Ommegang invite les visiteurs \u00e0 se plonger dans l\u2019histoire de l\u2019un des \u00e9v\u00e9nements les plus anciens parmi les traditions bruxelloises : l\u2019Ommegang, en d\u00e9couvrant une s\u00e9lection de pr\u00e8s de 200 dessins originaux r\u00e9alis\u00e9s entre 1928 et 1929 \u00e0 l\u2019occasion de la renaissance de ce cort\u00e8ge historique dans le contexte de la c\u00e9l\u00e9bration du centenaire de l\u2019ind\u00e9pendance de la Belgique. De nombreux \u00e9l\u00e9ments originaux de 1930 \u2014 banni\u00e8res, instruments de musique, costumes, hallebardes, arbal\u00e8tes, affiches, programmes, etc. \u2014 compl\u00e8tent la sc\u00e9nographie qui met en lumi\u00e8re la qualit\u00e9 du travail graphique r\u00e9alis\u00e9 pour la pr\u00e9paration de ce formidable projet.\r\n\r\nL'entr\u00e9e \u00e0 l'exposition est gratuite et le prix pour les visites guid\u00e9es est de 5\u20ac par personne. La r\u00e9servation est obligatoire pour celles-ci et ce seront des groupes de maximum 15 personnes.","performers":null,"boxoffice_url":null,"website":"http:\/\/www.albertmarinus.org","email":"centremarinus@woluwe1200.be","phone_contact":"+32 2 762 62 11","phone_booking":"+32 2 762 62 11","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/532744.html"},"nl":{"name":"Project Ommegang","shortdescr":null,"longdescr":"De tentoonstelling Project Ommegang nodigt de bezoekers uit om zich onder te dompelen in de geschiedenis van een van de oudste evenementen van de Brusselse tradities: de Ommegang. Ze kunnen er een selectie van dit waardevolle erfgoed ontdekken, dat uit zo\u2019n 200 originele tekeningen bestaat die tussen 1928 en 1929 werden gemaakt voor de herdenking van deze historische processie ter gelegenheid van de honderdste verjaardag van de Belgische onafhankelijkheid. De scenografie benadrukt de kwaliteit van het grafische werk dat ter voorbereiding van dit schitterende project is verricht en bestaat uit verscheidene originele elementen uit 1930 (vaandels, muziekinstrumenten, kostuums, hellebaarden, kruisbogen, posters, programma\u2019s, enzovoort). Albert Marinus reconstrueerde de Ommegang in 1930. De processie van de Ommegang is ontstaan in het midden van de 14de eeuw ter herdenking van de aankomst in Brussel van een beeld van de Heilige Maagd (ook wel bekend als Notre-Dame \u00e0 la branche) dat uit Antwerpen is meegebracht. Na verschillende evoluties verdween de processie in 1785.","performers":null,"boxoffice_url":null,"website":null,"email":"centremarinus@woluwe1200.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/532744.html"},"en":{"name":"Project Ommegang","shortdescr":null,"longdescr":"The Project Ommegang exhibition invites visitors to immerse themselves in the history of an event that is one of Brussels\u2019 oldest traditions: the Ommegang. There, they will discover a selection of art pieces, made up of almost 200 original drawings produced between 1928 and 1929 for the recreation of this historic procession on the occasion of the celebration of the centenary of Belgium\u2019s independence. The scenography highlights the quality of the graphic work carried out in preparation of this wonderful project and consists of numerous original elements from 1930: banners, musical instruments, costumes, halberds, crossbows, posters, programmes, etc. Albert Marinus recreates the Ommegang in 1930. The Ommegang procession emerged in the middle of the 14th century to commemorate the arrival in Brussels of a statue of the Holy Virgin \u2013 also known as Notre-Dame \u00e0 la branche \u2013 which was brought from Antwerp. After various evolutions, the procession eventually disappeared in 1785. While Belgium was preparing for the centenary of its independence in 1930, the Grand Serment Royal et de Saint-Georges des Arbal\u00e9triers and Abbot Fran\u00e7ois Desmet, vicar of the Church of Our Lady of the Sablon, suggested in 1928 to recreate the Ommegang procession for this special occasion. The task was entrusted to a committee headed by Albert Marinus, a humanist and sociologist who had been working for a long time at international level for the recognition of folk traditions and folklore. Albert Marinus took inspiration from the Ommegang organised by the city in 1549 on the occasion of the visit of Charles V and his son Philip II, and adapted it to contemporary ideas. This was a daunting task. Through his friend Constant Montald who was head of the Academy of Fine Arts, Albert Marinus received support from about twenty Brussels artists, painters, sculptors, architects and decorators to draw up sketches for the event. \r\n\r\nAdmission to the exhibition is free and the price for guided tours is 5\u20ac per person. Reservations are required for these tours (groups of 15 people max).","performers":null,"boxoffice_url":null,"website":null,"email":"centremarinus@woluwe1200.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/532744.html"},"de":{"name":"Projet Ommegang","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"centremarinus@woluwe1200.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/532744.html"},"it":{"name":"Projet Ommegang","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"centremarinus@woluwe1200.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/532744.html"},"sp":{"name":"Proyecto Ommegang","shortdescr":null,"longdescr":"La exposici\u00f3n Proyecto Ommegang invita a los visitantes a sumergirse en la historia de uno de los acontecimientos con m\u00e1s tradici\u00f3n de las fiestas bruselenses: el Ommegang, descubriendo una selecci\u00f3n de casi 200 dise\u00f1os originales realizados entre 1928 y 1929 con motivo del renacimiento de esta hist\u00f3rica procesi\u00f3n en este contexto de la celebraci\u00f3n del centenario de la independencia de B\u00e9lgica. Numerosos elementos originales de 1930 \u2014 estandartes, instrumentos musicales, trajes, alabardas, ballestas, carteles, programas, etc. completan la escenograf\u00eda que pone de manifiesto la calidad del trabajo gr\u00e1fico realizado para preparar este formidable proyecto. \r\n\r\nReservas: para las visitas guiadas es necesario reservar","performers":null,"boxoffice_url":null,"website":null,"email":"centremarinus@woluwe1200.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/532744.html"},"pt":{"name":"Projet Ommegang","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"centremarinus@woluwe1200.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/532744.html"},"cn":{"name":"Projet Ommegang","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":"centremarinus@woluwe1200.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/532744.html"}},"place":{"id":243945,"translations":{"fr":{"name":"Centre Albert Marinus (Mus\u00e9e de Woluwe-Saint-Lambert)","address_street_name":"Rue de la Charrette","address_street_number":null,"address_street_box":null,"email":"info@albertmarinus.org","website":"http:\/\/www.albertmarinus.org","phone_contact":"+32 2 762 62 14","phone_booking":null,"address_zip":"1200","address_city":"Woluwe-Saint-Lambert","address_line1":"Rue de la Charrette","address_line2":"1200 Woluwe-Saint-Lambert","description_web":"Le centre a \u00e9t\u00e9 cr\u00e9\u00e9e en l\u2019honneur d\u2019Albert Marinus, sociologue, folkloriste et humaniste de r\u00e9putation mondiale. Elle a pour but, au travers d'expositions, de sensibiliser le public au folklore, aux arts et traditions populaires en tant que patrimoine culturel.\r\nEn tant qu\u2019association sans but lucratif, il poursuit un triple but scientifique :\r\nla sauvegarde et la diffusion des \u00e9crits d'Albert Marinus, la poursuite de la recherche folklorique et sociologique selon ses conceptions en encourageant ou en d\u00e9veloppant des \u00e9tudes ax\u00e9es sur le patrimoine immat\u00e9riel et la vie populaire, et la sensibilisation du public au patrimoine immat\u00e9riel, aux arts et traditions populaires en tant que patrimoine culturel, mais aussi outil de connaissance et de r\u00e9flexion sur la vie sociale. Le centre a r\u00e9cemment \u00e9t\u00e9 reconnu par l'Unesco.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Albert Marinus Centrum  (Museum van Sint-Lambrechts-Woluwe)","address_street_name":"Karrestraat","address_street_number":null,"address_street_box":null,"email":"info@albertmarinus.org","website":"http:\/\/www.albertmarinus.org","phone_contact":"+32 2 762 62 14","phone_booking":null,"address_zip":"1200","address_city":"Sint-Lambrechts-Woluwe","address_line1":"Karrestraat","address_line2":"1200 Sint-Lambrechts-Woluwe","description_web":"Het Albert Marinuscentrum is een gemeentelijk documentatiecentrum dat d.m.v. wetenschappelijke, culturele en sensibiliserende activiteiten rond erfgoed en folklore het publiek wil sensibiliseren voor de volkskunsten en \u2013tradities.  Dit centrum werd opgericht ter ere van internationaal gereputeerd socioloog, volkskundige en humanist Albert Marinus wiens teksten en onderzoek op die manier verspreid en verdergezet worden. \r\nHet Albert Marinuscentrum in Sint-Lambrechts-Woluwe werd onlangs door Unesco erkend als erfgoedbeschermer. Dankzij de prestigieuze accreditatie wordt het centrum een echte autoriteit op het gebied van immaterieel cultureel erfgoed.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Albert Marinus Centre","address_street_name":"Rue de la Charrette","address_street_number":null,"address_street_box":null,"email":"info@albertmarinus.org","website":"http:\/\/www.albertmarinus.org","phone_contact":"+32 2 762 62 14","phone_booking":null,"address_zip":"1200","address_city":"Woluwe-Saint-Lambert","address_line1":"Rue de la Charrette","address_line2":"1200 Woluwe-Saint-Lambert","description_web":"This centre was established in honour of Albert Marinus, sociologist, world renowned folklorist, and humanist. It aims, through exhibitions, to increase public awareness of folklore, folk arts and traditions as a cultural heritage.The centre has recently been recognized by UNESCO","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Centre Albert Marinus (Museum Woluwe-Saint-Lambert)","address_street_name":"Rue de la Charrette","address_street_number":null,"address_street_box":null,"email":"info@albertmarinus.org","website":"http:\/\/www.albertmarinus.org","phone_contact":"+32 2 762 62 14","phone_booking":null,"address_zip":"1200","address_city":"Woluwe-Saint-Lambert","address_line1":"Rue de la Charrette","address_line2":"1200 Woluwe-Saint-Lambert","description_web":"Das Zentrum wurde zu Ehren von Albert Marinus ins Leben gerufen - einem Soziologen, Folkloristen und Humanisten mit Weltruf. Sein Ziel ist es, anhand von Ausstellungen das Publikum f\u00fcr Folklore, Kunst und volkst\u00fcmliche Traditionen als Kulturerbe zu sensibilisieren.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Centre Albert Marinus (Mus\u00e9e de Woluwe-Saint-Lambert)","address_street_name":"Rue de la Charrette","address_street_number":null,"address_street_box":null,"email":"info@albertmarinus.org","website":"http:\/\/www.albertmarinus.org","phone_contact":"+32 2 762 62 14","phone_booking":null,"address_zip":"1200","address_city":"Woluwe-Saint-Lambert","address_line1":"Rue de la 