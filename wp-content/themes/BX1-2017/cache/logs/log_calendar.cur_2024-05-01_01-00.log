ng":"+32 2 720 01 23","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50006762"},"fr":{"name":"1 Heure de Quiz Game 150% FUN pour 2 personnes","shortdescr":"Bienvenue au Quiz Game o\u00f9 vous pourrez buzzer comme sur un plateau t\u00e9l\u00e9 en affrontant vos amis, votre famille ou vos coll\u00e8gues (de 2 \u00e0 8 joueurs en simultan\u00e9) au cours d\u2019une session enchainant 8 manches successives (chacune avec ses propres r\u00e8gles) et avec de nombreux th\u00e8mes : music blind test, cin\u00e9ma, s\u00e9ries, sport, jeux-vid\u00e9os, people, histoire, imaginaire, ...\n\n","longdescr":"En famille ou entre amis, vous prendrez place derri\u00e8re un pupitre \u00e9quip\u00e9 de 4 buzzers pour affronter d\u2019autres joueurs\/\u00e9quipes au cours de 4 \u00e9preuves de quiz cons\u00e9cutives, dans un d\u00e9cor de plateau TV avec un v\u00e9ritable show son et lumi\u00e8re. La salle de Quiz Game est \u00e9quip\u00e9e de 4 pupitres pouvant accueillir des \u00e9quipes jusqu'\u00e0 3 participants ! Le jeu est disponible en Fran\u00e7ais et en Anglais. 60 minutes = 8 manches, chacune avec sa propre r\u00e8gle 150% FUN","performers":null,"boxoffice_url":null,"website":"http:\/\/www.spacefungame.com","email":"info@spacefungame.com","phone_contact":"+32 2 720 01 23","phone_booking":"+32 2 720 01 23","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50006762"},"sp":{"name":"1 H Quiz Game 150% FUN : 2 persons","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.spacefungame.com","email":"info@spacefungame.com","phone_contact":"+32 2 720 01 23","phone_booking":"+32 2 720 01 23","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50006762"},"nl":{"name":"1 U Quiz Game 150% FUN : 2 personen","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.spacefungame.com","email":"info@spacefungame.com","phone_contact":"+32 2 720 01 23","phone_booking":"+32 2 720 01 23","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50006762"}},"place":{"last_updated_at":"2024-01-10T18:56:28+01:00","published_at":"2017-05-30T14:59:45+02:00","id":267946,"translations":{"de":{"name":"Space Fun Games","address_street_name":"Galerie Carrefour Shopping Saint Michel","address_street_number":null,"address_street_box":null,"email":"info@spacefungame.com","website":"http:\/\/www.spacefungame.com","phone_contact":"+32 2 720 01 23","phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Galerie Carrefour Shopping Saint Michel","address_line2":"1040 Etterbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Space Fun Games","address_street_name":"Galerie Carrefour Shopping Saint Michel","address_street_number":null,"address_street_box":null,"email":"info@spacefungame.com","website":"http:\/\/www.spacefungame.com","phone_contact":"+32 2 720 01 23","phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Galerie Carrefour Shopping Saint Michel","address_line2":"1040 Etterbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Space Fun Games","address_street_name":"Galerie Carrefour Shopping Saint Michel","address_street_number":null,"address_street_box":null,"email":"info@spacefungame.com","website":"http:\/\/www.spacefungame.com","phone_contact":"+32 2 720 01 23","phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Galerie Carrefour Shopping Saint Michel","address_line2":"1040 Etterbeek","description_web":"Space Fun Games = Space Laser Games + Space Team Games\r\n1000 m2 dedicated to 150% Fun!\r\nWhy choose the Space Fun Game for your Event? To Unite, Move and Have Fun as a Team! \r\n5 in 1 solution : multi-activity-purpose venue \r\n\r\nSpace Laser Games: largest in Brussels with 500m2 of spatial labyrinth to hide in. Think of yourself as a superhero, shoot at your enemies without hurting them, gain super powers and pull your head out into the stars. \r\n\r\nSpace Team Games: new in Belgium 250m2, 11 mini Challeges & Escape Games (action, reflection and agility), a kind of futuristic \"Fort Boyard\" to be achieved in 1H with timed collective games for 2 to 6 people.\r\n\r\nAccessible to almost everyone, from 10 years old. \r\nIdeal location, close to Ring & airport, Free Carrefour Parking (1 rue de l\u2019Escadron), Thieffry Metro at 200m and public transports. Bike friendly \r\nCapacity: 200 persons\r\nA la carte services (including privatisation, meeting room, drinks & catering) \r\nCompetitive pricing: From 20\u20ac per person for 1H of activity.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Space Fun Games","address_street_name":"Galerie Carrefour Shopping Saint Michel","address_street_number":null,"address_street_box":null,"email":"info@spacefungame.com","website":"http:\/\/www.spacefungame.com","phone_contact":"+32 2 720 01 23","phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Galerie Carrefour Shopping Saint Michel","address_line2":"1040 Etterbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Space Fun Games","address_street_name":"Galerie Carrefour Shopping Saint Michel","address_street_number":null,"address_street_box":null,"email":"info@spacefungame.com","website":"http:\/\/www.spacefungame.com","phone_contact":"+32 2 720 01 23","phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Galerie Carrefour Shopping Saint Michel","address_line2":"1040 Etterbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virt