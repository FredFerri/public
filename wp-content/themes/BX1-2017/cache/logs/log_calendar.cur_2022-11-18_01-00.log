"value":10}],"child_events":[],"parent_events":[],"targets":{"list":[],"translations":{}},"tags":[],"accessibilities":[],"facebook_link":null,"publication_state":"public","last_updated_at":"2022-10-22T01:36:20+02:00","published_at":"2022-10-11T16:23:48+02:00","backoffice_id":263926,"import_origin":null,"sub_type":"concert","show_in_agenda":true,"ranking":0.32737967507804},{"id":545348,"date_start":"2022-11-25","date_end":"2023-01-01","date_next":"2022-11-25","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":84,"translations":{"fr":"Divers","nl":"Varia","en":"Various","de":"Verschiedenes"}},"others":{}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Plaisirs d'Hiver","shortdescr":"La 22e \u00e9dition de Plaisirs d\u2019Hiver aura lieu du 25.11.2022 au 01.01.2023.","longdescr":"La 22e \u00e9dition de Plaisirs d\u2019Hiver aura lieu du 25.11.2022 au 01.01.2023.\r\n\r\nEt qui mieux que cet \u00e9v\u00e9nement international illustre la magie des f\u00eates de fin d\u2019ann\u00e9e dans la capitale de l\u2019Europe ?\r\n\r\nSon March\u00e9 de No\u00ebl est un des plus beaux d\u2019Europe (source : Best Christmas Market in Europe) et accueille pr\u00e8s de 250 chalets aux offres envo\u00fbtantes sur un parcours de pr\u00e8s de 3 km dans le c\u0153ur de Bruxelles. Mais ce n\u2019est pas tout ! Ce rendez-vous majeur propose \u00e9galement une foule d\u2019animations dans le centre de Bruxelles : un magnifique sapin de No\u00ebl et un show son et lumi\u00e8re sur la Grand-Place, des activit\u00e9s culturelles, des d\u00e9couvertes artistiques, une grande patinoire et des spectacles en tout genre pour petits et grands.","performers":null,"boxoffice_url":null,"website":"http:\/\/plaisirsdhiver.be","email":"info@bmeo.be","phone_contact":"+32 2 318 64 70","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.545348"},"nl":{"name":"Winterpret","shortdescr":"De 22e editie van Winterpret vindt plaats van 25.11.2022 tot 01.01.2023.","longdescr":"De 22e editie van Winterpret vindt plaats van 25.11.2022 tot 01.01.2023. \r\n\r\nEn wie beter dan dit internationale evenement om de magie van de eindejaarsfeesten in de hoofdstad van Europa illustreren?\r\n\r\nZijn kerstmarkt is een van de mooiste van Europa (bron: Best Christmas Market in Europe) en telt bijna 250 chalets met betoverende aanbiedingen op een route van bijna 3 km in het hart van Brussel. Maar dat is niet alles! Dit grote evenement biedt ook tal van activiteiten in het centrum van Brussel: een prachtige kerstboom, en een klank- en lichtshow op de Grote Markt, culturele activiteiten, artistieke ontdekkingen, een grote ijsbaan en allerlei voorstellingen voor jong en oud.","performers":null,"boxoffice_url":null,"website":"http:\/\/winterpret.be","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.545348"},"en":{"name":"Winter Wonders","shortdescr":"The 22nd edition of Winter Wonders will take place from 25.11.2022 to 01.01.2023.","longdescr":"The 22nd edition of Winter Wonders will take place from 25.11.2022 to 01.01.2023. \r\n\r\nAnd who better than this international event to illustrate the magic of the festive season in the capital of Europe?\r\n\r\nIts Christmas Market is one of the most beautiful in Europe (source: Best Christmas Market in Europe) and hosts nearly 250 chalets with enchanting offers on a route of nearly 3 km in the heart of Brussels. But that\u2019s not all! This major event also offers a number of activities in the centre of Brussels: a magnificent Christmas tree and a sound and light show on the Grand-Place, cultural activities, artistic discoveries, a large ice rink and shows of all kinds for young and old.","performers":null,"boxoffice_url":null,"website":"http:\/\/winterwonders.be","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.545348"},"de":{"name":"Plaisirs d'Hiver","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.545348"},"it":{"name":"Plaisirs d'Hiver","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.545348"},"sp":{"name":"Plaisirs d'Hiver","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.545348"},"pt":{"name":"Plaisirs d'Hiver","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.545348"},"cn":{"name":"Plaisirs d'Hiver","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.545348"}},"place":{"id":279611,"translations":{"fr":{"name":"Ville de Bruxelles","address_street_name":null,"address_street_number":null,"address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Ville de Bruxelles","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visi