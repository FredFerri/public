se}],"prices":[{"translations":{"de":{"name":"Normal"},"en":{"name":"Normal"},"it":{"name":"Normale"},"fr":{"name":"Normal"},"sp":{"name":"Normal"},"nl":{"name":"Normaal"}},"value":13},{"translations":{"de":{"name":"Studierende"},"en":{"name":"Students"},"it":{"name":"Studenti"},"fr":{"name":"Etudiants"},"sp":{"name":"Estudiantes"},"nl":{"name":"Studenten"}},"value":6.5},{"translations":{"de":{"name":"Arbeitsuchende"},"en":{"name":"Job seekers"},"it":{"name":"Disoccupati"},"fr":{"name":"Demandeurs d'emploi"},"sp":{"name":"Desempleados"},"nl":{"name":"Werkzoekenden"}},"value":6.5},{"translations":{"de":{"name":"Article 27"},"pt":{"name":"Article 27"},"en":{"name":"Article 27"},"it":{"name":"Article 27"},"cn":{"name":"Article 27"},"fr":{"name":"Article 27"},"sp":{"name":"Article 27"},"nl":{"name":"Artikel 27"}},"value":1.25}],"date_exceptions":[],"closing_days":[],"child_events":[],"parent_events":[],"accessibilities":[],"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[]},{"id":5700000983,"date_start":"2024-09-28","date_end":"2024-09-29","date_next":"2024-09-28","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-09-05T12:52:09+02:00","published_at":"2024-09-05T12:40:42+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":307239,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"tour","ranking":1,"languages":{"spoken":["en","fr","nl"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{}},"translations":{"de":{"name":"Guided Tour of the  Former Solvay property - BBN 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/fr\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700000983"},"pt":{"name":"Guided Tour of the  Former Solvay property - BBN 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/fr\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700000983"},"en":{"name":"Guided Tour of the  Former Solvay property - BBN 2024","shortdescr":null,"longdescr":"In the heart of Ixelles, this Neoclassical private house built around 1850 - not to be confused with the mansion of the same name on Avenue Louise (arch. Victor Horta, 1895-1903) - was acquired by the noted chemical engineer Ernest Solvay in 1884 and turned into a home for him and his family. He tasked the architects Constant Bosmans and Henri Vandevelde with the interior decoration, assisted by Alban Chambon, the Dillens brothers and Henri Baes; the result is a sumptuous house adorned with wood panelling, fireplaces, mosaics and an impressive stained-glass and wrought-iron window overlooking the grand staircase. Several works of art can also be found in the surrounding landscaped park which covers over a hectare, among them a bust of Alfred Solvay - Ernest's brother - on a pedestal designed by the architect Victor Horta. This is the first time the Syensqo (Science and Research) company, a Solvay spin-off, opens the doors of this exceptional building to the public, a special occasion not to be missed!\n\nPLEASE NOTE: There is a supplement of \u20ac5.00 per person per visit.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/en\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700000983"},"it":{"name":"Guided Tour of the  Former Solvay property - BBN 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/fr\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700000983"},"cn":{"name":"Guided Tour of the  Former Solvay property - BBN 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/fr\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700000983"},"fr":{"name":"Visite Guid\u00e9e de l'Ancienne propri\u00e9t\u00e9 Solvay - BBN 2024","shortdescr":null,"longdescr":"Implant\u00e9 en plein c\u0153ur de la commune d'Ixelles, cet h\u00f4tel particulier n\u00e9oclassique construit vers 1850 - \u00e0 ne pas confondre avec l'h\u00f4tel \u00e9ponyme situ\u00e9 sur l'avenue Louise (arch. Victor Horta, 1895-1903) - fut acquis et transform\u00e9 en 1884 par le c\u00e9l\u00e8bre chimiste Ernest Solvay en vue de s'y installer avec sa famille. Ce dernier chargea les architectes Constant Bosmans et Henri Vandevelde de la d\u00e9coration int\u00e9rieure, \u00e9galement assist\u00e9s d'Alban Chambon, des fr\u00e8res Dillens ou encore d'Henri Baes ; en r\u00e9sulte un h\u00f4tel somptueux, orn\u00e9 de lambris, de chemin\u00e9es, de mosa\u00efques et d'une impressionnante verri\u00e8re en fer forg\u00e9 dominant l'escalier d'apparat. \u00c0 l'ext\u00e9rieur, et se d\u00e9veloppant sur plus d'un hectare, le parc paysag\u00e9 rec\u00e8le plusieurs autres r\u00e9alisations, dont un buste d'Alfred Solvay - le fr\u00e8re d'Ernest - reposant sur un socle dessin\u00e9 par l'architecte Victor Horta. La soci\u00e9t\u00e9 Syensqo, n\u00e9e du spin off de l'entreprise Solvay, ouvre pour la premi\u00e8re fois les portes de cet \u00e9difice exceptionnel au public ; une occasion rare \u00e0 ne pas manquer!\n\nATTENTION : un suppl\u00e9ment de 5 \u20ac est demand\u00e9, par visite et par personne.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/fr\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700000983"},"sp":{"name":"Guided Tour of the  Former Solvay property - BBN 2024","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/fr\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700000983"},"nl":{"name":"Rondleiding van het Voormalige eigendom Solvay - BBN 2024","shortdescr":null,"longdescr":"Dit neoklassieke herenhuis uit 1850 - dat niet verward mag worden met het gelijknamige herenhuis op de Louizalaan ontworpen door Victor Horta (1895-1903) - bevindt zich in het hart van Elsene. Het was de beroemde scheikundige Ernest Solvay die het gebouw in 1884 kocht en liet verbouwen alvorens er met zijn gezin in te trekken. Voor de binnenhuisdecoratie stelde Solvay het architectenduo Constant Bosmans en Henri Vandeveld aan, die zich op hun beurt lieten bijstaan door Alban Chambon, de gebroeders Dillens en Henri Baes. Het resultaat is een weelderig huis, gedecoreerd met lambriseringen, schoorsteenmantels, moza\u00efeken en een indrukwekkend dakraam in smeedijzer boven de ontvangstruimte. Buiten bevindt zich een aangelegde tuin van meer dan 1 hectare groot waar verschillende kunstwerken staan opgesteld, onder meer een buste van Alfred Solvay - de broer van Ernest - op een sokkel van Victor Horta. Met dank aan het bedrijf Syensqo (Science and Research), een recente spin-off van het bedrijf Solvay, zijn de deuren van dit uitzonderlijke gebouw voor het eerst voor het publiek geopend - een zeldzame, niet te missen kans!\n\nLET OP: bij dit bezoek is een toeslag van \u20ac5,00 van toepassing (per bezoek en per persoon).","performers":null,"boxoffice_url":null,"website":"https:\/\/www.explore.brussels\/nl\/bbn","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":"+32 2 319 50 01","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700000983"}},"place":{"id":279019,"translations":{"de":{"name":"Ancienne propri\u00e9t\u00e9 d\u2019Ernest Solvay","address_street_name":"Rue des Champs Elys\u00e9es","address_street_number":"43, 58, 58a, 61, 63","address_street_box":null,"email":null,"website":"https:\/\/monument.heritage.brussels\/fr\/buildings\/18733","phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue des Champs Elys\u00e9es, 43, 58, 58a, 61, 63","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Ancienne propri\u00e9t\u00e9 d\u2019Ernest Solvay","address_street_name":"Rue des Champs Elys\u00e9es","address_street_number":"43, 58, 58a, 61, 63","address_street_box":null,"email":null,"website":"https:\/\/monument.heritage.brussels\/fr\/buildings\/18733","phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Rue des Champs Elys\u00e9es, 43, 58, 58a, 61, 63","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":