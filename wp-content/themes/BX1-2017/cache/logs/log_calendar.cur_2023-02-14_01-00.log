ow_in_agenda":true,"ranking":0.38380548976378},{"id":550165,"date_start":"2023-01-28","date_end":"2023-02-14","date_next":"2023-02-14","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung","it":"Esposizioni","sp":"Exhibici\u00f3n","pt":null,"cn":null}},"others":{"list":[36,42],"translations":{"fr":["Mus\u00e9es et art centers","Peinture"],"nl":["Musea en kunstcentra","Schilderkunst"],"en":["Museums and art centers","Painting"],"de":["Museen & Kunstzentren","Malerei"],"it":["Musei e centri artistici","Pittura"],"sp":["Museos y centros de arte","Pintura"],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","nl","de"],"subtitles":[]},"translations":{"fr":{"name":"Ulla Hase - Gardening by the moon","shortdescr":"\u00ab Mon travail na\u00eet de l\u2019interaction des mati\u00e8res, des pens\u00e9es et des gestes, de leur nature et de leur intensit\u00e9. Pour moi, le dessin est une fa\u00e7on d\u2019explorer le potentiel des choses et des id\u00e9es, et de les rendre tangibles. C'est une \u0153uvre profond\u00e9ment sculpturale et contemplative. Je cr\u00e9e des structures et des espaces, charg\u00e9s d\u2019\u00e9nergie et .... \u00bb","longdescr":"Le contact permanent avec le support et la mati\u00e8re, c'est ce qui d\u00e9finit le travail de l\u2019artiste plasticienne Ulla Hase : \u00ab mon travail na\u00eet de l\u2019interaction des mati\u00e8res, des pens\u00e9es et des gestes, de leur nature et de leur intensit\u00e9. Pour moi, le dessin est une fa\u00e7on d\u2019explorer le potentiel des choses et des id\u00e9es, et de les rendre tangibles. C'est une \u0153uvre profond\u00e9ment sculpturale et contemplative. Je cr\u00e9e des structures et des espaces, charg\u00e9s d\u2019\u00e9nergie et de rythmes, \u00e0 la fois proches et inaccessibles, entre le microscopique et l\u2019infiniment grand. \u00bb\r\n\r\nArtiste invit\u00e9e : L\u00f6na Richter. Elle exposera ses peintures miniatures.\r\n\r\nDates de l'exposition\r\nDu samedi 28 janvier au mardi 14 f\u00e9vrier 2023\r\n\r\nHoraires de l\u2019exposition\r\nLes mardis (10h - 16h), les jeudis (13h - 19h), les samedis et les dimanches (11h - 16h)\r\n\r\nVernissage\r\nLe jeudi 26 janvier 2023 de 18h \u00e0 21h\r\n\r\nChambre d\u2019\u00e9coute RED\/Laboratoire P\u00e9dagogique\r\nLe jeudi 2 f\u00e9vrier 2023 \u00e0 20h\r\n\r\n\u00c9v\u00e9nement (d\u00e9tails sur Instagram)\r\nLe jeudi 9 f\u00e9vrier 2023 \u00e0 20h\r\n\r\nEntr\u00e9e gratuite, sans r\u00e9servation\r\n\r\nPlus d'infos sur l'artiste : https:\/\/www.montdepiete.be\/expo-gardening-by-the-moon","performers":"Ulla Hase (artiste plasticienne) et L\u00f6na Richter (artiste plasticienne invit\u00e9e)","boxoffice_url":null,"website":"https:\/\/www.montdepiete.be\/expo-gardening-by-the-moon","email":"info@montdepiete.be","phone_contact":"+32 2 513 13 85","phone_booking":"+32 2 513 13 85","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.550165"},"nl":{"name":"Ulla Hase - Gardening by the moon","shortdescr":"\u00ab Mijn werk ontstaat uit de interactie van materialen, gedachten en gebaren, hun aard en hun intensiteit. Voor mij is tekenen een manier om het potentieel van dingen en idee\u00ebn te verkennen en tastbaar te maken. Het is een diep sculpturaal en contemplatief werk. Ik cre\u00eber structuren en ruimtes, geladen met energie en ritme, zowel ... \u00bb","longdescr":"Het constante contact met het medium en het materiaal is wat het werk van de kunstenares Ulla Hase definieert: \u00ab Mijn werk ontstaat uit de interactie van materialen, gedachten en gebaren, hun aard en hun intensiteit. Voor mij is tekenen een manier om het potentieel van dingen en idee\u00ebn te verkennen en tastbaar te maken. Het is een diep sculpturaal en contemplatief werk. Ik cre\u00eber structuren en ruimtes, geladen met energie en ritme, zowel dichtbij als ontoegankelijk, tussen het microscopische en het oneindig grote. \u00bb\r\n\r\nGastkunstenares\r\nL\u00f6na Richter. Ze zal haar miniatuurschilderijen tentoonstellen.\r\n\r\nData van de tentoonstelling\r\nVan zaterdag 28 januari tot dinsdag 14 februari 2023\r\n\r\nOpeningsuren van de tentoonstelling\r\nDinsdag (10u - 16u), donderdag (13u - 19u) en in het weekend (11u - 16u)\r\n\r\nVernissage\r\nDonderdag 26 januari 2023 van 18u tot 21u\r\n\r\nLuisterkamer RED\/laboratoire P\u00e9dagogique\r\nDonderdag 2 februari 2023 om 20u\r\n\r\nEvenement (details op Instagram)\r\nDonderdag 9 februari 2023 om 20u\r\n\r\nGratis toegang, zonder reservatie\r\n\r\nMeer info over de kunstenares: https:\/\/www.bergvanbarmhartigheid.be\/nl\/tentoonstelling-gardening-by-the-moon","performers":"Ulla Hase (kunstenares) en L\u00f6na Richter (gastkunstenares)","boxoffice_url":null,"website":"https:\/\/www.bergvanbarmhartigheid.be\/nl\/tentoonstelling-gardening-by-the-moon","email":"info@montdepiete.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.550165"},"en":{"name":"Ulla Hase - Gardening by the moon","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.montdepiete.be\/expo-gardening-by-the-moon","email":"info@montdepiete.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.550165"},"de":{"name":"Expo \u00ab Gardening by the moon \u00bb de Ulla Hase","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.montdepiete.be\/expo-gardening-by-the-moon","email":"info@montdepiete.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\