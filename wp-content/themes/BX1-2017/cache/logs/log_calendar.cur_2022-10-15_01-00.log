ultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":102,"translations":{"fr":"Visites Guid\u00e9es","nl":"Begeleide rondleidingen","en":"Guided tours","de":"Stadtf\u00fchrungen"}},"others":{}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"La Raffinerie \/ Visite avec expert Filippo Intile","shortdescr":"\"Avec ses cinq \u00e9tages, ses espaces scand\u00e9s par le rythme des colonnes en fonte, ses plafonds bas et vo\u00fbt\u00e9s, son labyrinte de salles, sa serre sous les toits, ses escaliers secrets, la Raffinerie est l'un des derniers exemples, en Belgique, du patrimoine industriel du XIXe si\u00e8cle.","longdescr":"\"Avec ses cinq \u00e9tages, ses espaces scand\u00e9s par le rythme des colonnes en fonte, ses plafonds bas et vo\u00fbt\u00e9s, son labyrinte de salles, sa serre sous les toits, ses escaliers secrets, la Raffinerie est l'un des derniers exemples, en Belgique, du patrimoine industriel du XIXe si\u00e8cle. Elle fut construite, non loin du canal, par les Raffineries Graeffe, en 1850, afin d'alimenter la population belge en d\u00e9licieuse cassonade. Pendant plus d'un demi-si\u00e8cle, ce quartier, aujourd'hui encore m\u00e9connu de beaucoup, fut anim\u00e9 par les deux mille ouvriers qui se r\u00e9unissaient apr\u00e8s le travail dans les caf\u00e9s de la rue de Manchester.\" Le b\u00e2timent est ensuite d\u00e9sert\u00e9 \u00e0 partir de 1958. En 1979, l\u2019ensemble des b\u00e2timents fut reconverti en un lieu \u00e0 vocation culturelle, le Plan K qui y pr\u00e9sentera des nombreux spectacles de th\u00e9\u00e2tre et de danse, des concerts, des films, des expositions.D\u00e9but 2000, d\u2019importants travaux de r\u00e9novation ont \u00e9t\u00e9 r\u00e9alis\u00e9s par le bureau belge Art &amp; Build avec l\u2019inauguration officielle en mars 2004. Aujourd\u2019hui, La Raffinerie abrite l\u2019antenne bruxelloise de Charleroi danse, Centre chor\u00e9graphique de la F\u00e9d\u00e9ration Wallonie-Bruxelles.La visite par le guide arkadia et l'architecte Filippo Intile du bureau Art &amp; Build vous pr\u00e9sentera les coulisses de la Raffinerie.\nAvec le soutien de la F\u00e9d\u00e9ration Wallonie-Bruxelles, cellule.archi.","performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be","email":"info@arkadia.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.541422"},"nl":{"name":"La Raffinerie \/ Visite avec expert Filippo Intile","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/nl","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.541422"},"en":{"name":"La Raffinerie \/ Visite avec expert Filippo Intile","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/en","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.541422"},"de":{"name":"La Raffinerie \/ Visite avec expert Filippo Intile","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.541422"},"it":{"name":"La Raffinerie \/ Visite avec expert Filippo Intile","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.541422"},"sp":{"name":"La Raffinerie \/ Visite avec expert Filippo Intile","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.541422"},"pt":{"name":"La Raffinerie \/ Visite avec expert Filippo Intile","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.541422"},"cn":{"name":"La Raffinerie \/ Visite avec expert Filippo Intile","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.541422"}},"place":{"id":144,"translations":{"fr":{"name":"Charleroi danse \/ La Raffinerie","address_street_name":"Rue de Manchester","address_street_number":"21","address_street_box":null,"email":"contact@charleroi-danse.be","website":"http:\/\/www.charleroi-danse.be","phone_contact":"+32 71 20 56 40","phone_booking":"+32 71 20 56 40","address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Rue de Manchester, 21","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"Construite au milieu du XIXe si\u00e8cle, l'ancienne raffinerie de sucre Gr\u00e4ffe demeure, avec ses murs de brique et son ossature de fer et de fonte, un t\u00e9moin important de l'architecture industrielle du quartier de la place de la Duchesse de Brabant. \r\nEn 1979, l'ensemble des b\u00e2timents fut reconverti en un lieu \u00e0 vocation culturelle, si\u00e8ge du renomm\u00e9 Plan K qui y pr\u00e9sentera des nombreux spectacles de th\u00e9\u00e2tre et de danse, des concerts, des films, des expositions.\r\nR\u00e9nov\u00e9e, La Raffinerie abrite actuellement l'antenne bruxelloise de Charleroi danse, Centre chor\u00e9graphique de la F\u00e9d\u00e9ration Wallonie-Bruxelles.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Charleroi danse \/ La Raffinerie","address_street_name":"Manchesterstraat","address_street_number":"21","address_street_box":null,"email":"contact@charleroi-danse.be","website":"http:\/\/www.charleroi-danse.be","phone_contact":"+32 71 20 56 40","phone_booking":"+32 71 20 56 40","address_zip":"1080","address_city":"Sint-Jans-Molenbeek","address_line1":"Manchesterstraat, 21","address_line2":"1080 Sint-Jans-Molenbeek","description_web":"Built in the mid-nineteenth century, the old Gr\u00e4ffe sugar refinery, with its brick walls and frame and cast iron, an important witness of the industrial architecture of the neighborhood instead of the Duchess of Brabant. \r\nIn 1979, all the buildings were converted into a place for cultural, seat of famous Plan K, which presented many theater and dance performances, concerts, films and exhibitions. \r\nRenovated, The Refinery currently houses the Brussels branch of Charleroi danse, Choreographic Centre of the Federation Wallonia-Brussels. \r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Charleroi danse \/ La Raffinerie","address_street_name":"Manchesterstreet","address_street_number":"21","address_street_box":null,"email":"contact@charleroi-danse.be","website":"http:\/\/www.charleroi-danse.be","phone_contact":"+32 71 20 56 40","phone_booking":"+32 71 20 56 40","address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Manchesterstreet, 21","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"Gebouwd in het midden van de 19de eeuw, vormt de voormalige suikerraffinaderij Gr\u00e4ffe, met zijn bakstenen muren en geraamte uit ijzer en gietijzer, en belangrijke getuige van het industri\u00ebel verlenden van de Hertogin van Brabantwijk.\r\nIn 1979, kreeg het geheel van gebouwen een culturele bestemming. Het Plan K organiseerde er talloze theater en dansvoorstellingen, concerten, films, tentoonstelligen.\r\nIn La Raffineriej, die ondertussen werd gerenoveerd, is thans de Brusselse afdeling van Charleroi danse, Choreografisch Centrum van de Federatie Walloni\u00eb-Brussel ondergebracht.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Charleroi danse \/ La Raffinerie","address_street_name":"Rue de Manchester","address_street_number":"21","address_street_box":null,"email":"contact@charleroi-danse.be","website":"http:\/\/www.charleroi-danse.be","phone_contact":"+32 71 20 56 40","phone_booking":"+32 71 20 56 40","address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Rue de Manchester, 21","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Charleroi danse \/ La Raffinerie","address_street_name":"Rue de Manchester","address_street_number":"21","address_street_box":null,"email":"contact@charleroi-danse.be","website":"http:\/\/www.charleroi-danse.be","phone_contact":"+32 71 20 56 40","phone_booking":"+32 71 20 56 40","address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Rue de Manchester, 21","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Charleroi danse \/ La Raffinerie","address_street_name":"Rue de Manchester","address_street_number":"21","address_street_box":null,"email":"contact@charleroi-danse.be","website":"http:\/\/www.charleroi-danse.be","phone_contact":"+32 71 20 56 40","phone_booking":"+32 71 20 56 40","address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Rue de Manchester, 21","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Charleroi danse \/ La Raffinerie","address_street_name":"Rue de Manchester","address_street_number":"21","address_street_box":null,"email":"contact@charleroi-danse.be","website":"http:\/\/www.charleroi-danse.be","phone_contact":"+32 71 20 56 40","phone_booking":"+32 71 20 56 40","address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Rue de Manchester, 21","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Charleroi danse \/ La Raffinerie","address_street_name":"Rue de Manchester","address_street_number":"21","address_street_box":null,"email":"contact@charleroi-danse.be","website":"http:\/\/www.charleroi-danse.be","phone_contact":"+32 71 20 56 40","phone_booking":"+32 71 20 56 40","address_zip":"1080","address_city":"Molenbeek-Saint-Jean","address_line1":"Rue de Manchester, 21","address_line2":"1080 Molenbeek-Saint-Jean","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":{"list":[8],"translations":{"fr":["Canal"],"nl":["Kanaalwijk"],"en":["Canal"]}},"zones":{"list":[23],"translations":{"fr":["Ouest"],"nl":["West"],"en":["West"]}},"neca":null,"facebook_id":"charleroidanse","backoffice_id":27,"location":{"lat":50.8482375,"lon":4.32879799},"region":"brussels","last_updated_at":"2022-10-11T02:05:34+02:00","published_at":"2013-10-19T01:13:14+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":false,"resto_ranking":0},"organizer":{"id":276946,"translations":{"fr":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":"Depuis 1983, Arkadia explore les richesses du patrimoine belge et bruxellois et d\u00e9veloppe de nombreux projets culturels sp\u00e9cialement \u00e0 Bruxelles, entre architecture, urbanisme, culture, arts plastiques et id\u00e9ologie depuis le Moyen \u00c2ge jusqu\u2019\u00e0 nos jours. Voir et comprendre la ville et son d\u00e9veloppement architectural, approcher la cr\u00e9ation artistique et lui donner un sens, telles sont les activit\u00e9s que l'ASBL veut partager avec le public. Sp\u00e9cialistes du patrimoine  architectural et de l'art contemporain, ils font d\u00e9couvrir la ville \u00e0 travers des visites guid\u00e9es et des conf\u00e9rences en plusieurs langues.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Arkadia","address_street_name":"Naamsestraat","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be\/nl","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Brussel","address_line1":"Naamsestraat, 10","address_line2":"1000 Brussel","description_web":"Sinds 1983 verkent Arkadia de rijkdom van het Belgische en Brusselse erfgoed en ontwikkelt talrijke culturele projecten, vooral in Brussel, tussen architectuur, stedenbouw, cultuur, plastische kunsten en ideologie, van de Middeleeuwen tot vandaag. De stad en haar architecturale ontwikkeling zien en begrijpen, de artistieke creatie benaderen en er een betekenis aan geven, dat zijn de activiteiten die de VZW met het publiek wil delen. Zij zijn gespecialiseerd in architectonisch erfgoed en hedendaagse kunst en laten de stad zien door middel van rondleidingen en lezingen in verschillende talen.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be\/en","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Brussels","address_line1":"Rue de Namur, 10","address_line2":"1000 Brussels","description_web":"Since 1983, Arkadia has been exploring the richness of Belgium's and Brussels' heritage and developing numerous cultural projects especially in Brussels, between architecture, urbanism, culture, plastic arts and ideology from the Middle Ages to the present day. Seeing and understanding the city and its architectural development, approaching artistic creation and giving it meaning, these are the activities that the ASBL wants to share with the public. Specialists in architectural heritage and contemporary art, they show the city through guided tours and lectures in several languages.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":"","description_print":"","booking_url":null,