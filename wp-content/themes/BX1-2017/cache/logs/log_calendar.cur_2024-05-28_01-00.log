s_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-04-19T21:22:38+02:00","published_at":"2024-03-13T14:51:22+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":296505,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"theatre","ranking":1.2599210498948732,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":49,"translations":{"de":"Theater","pt":null,"en":"Theatre","it":"Teatro","cn":null,"fr":"Th\u00e9\u00e2tre","sp":"Teatro","nl":"Theater"}},"others":{"list":[50],"translations":{"de":["Theater"],"pt":[null],"en":["Theatre"],"it":["Teatro"],"cn":[null],"fr":["Th\u00e9\u00e2tre"],"sp":["Teatro"],"nl":["Theater"]}}},"translations":{"de":{"name":"Casimir","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lamontagnemagique.be\/casimir-2\/","email":"info@montagnemagique.be","phone_contact":"+32 2 210 15 90","phone_booking":"+32 2 210 15 90","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50008414"},"pt":{"name":"Casimir","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lamontagnemagique.be\/casimir-2\/","email":"info@montagnemagique.be","phone_contact":"+32 2 210 15 90","phone_booking":"+32 2 210 15 90","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50008414"},"en":{"name":"Casimir","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lamontagnemagique.be\/casimir-2\/","email":"info@montagnemagique.be","phone_contact":"+32 2 210 15 90","phone_booking":"+32 2 210 15 90","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50008414"},"it":{"name":"Casimir","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lamontagnemagique.be\/casimir-2\/","email":"info@montagnemagique.be","phone_contact":"+32 2 210 15 90","phone_booking":"+32 2 210 15 90","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50008414"},"cn":{"name":"Casimir","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lamontagnemagique.be\/casimir-2\/","email":"info@montagnemagique.be","phone_contact":"+32 2 210 15 90","phone_booking":"+32 2 210 15 90","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50008414"},"fr":{"name":"Casimir","shortdescr":"Au plus profond de la grande for\u00eat, il y a un village.\nO\u00f9 vivent des lutins.","longdescr":"Chacun et chacune sa petite maison, son petit chapeau rouge avec son petit grelot, ses petits matins et ses petits voisins.\nDans cette for\u00eat, les hivers sont rudes, tr\u00e8s tr\u00e8s rudes.\nEt quand vient l\u2019hiver, on reste bien au chaud chez soi.\nOr cet hiver-l\u00e0, on a vu arriver Casimir, avec Madame Casimir et les enfants Casimir. On ne pouvait pas les laisser dehors\u200a!\nPas question\u200a! Oui mais\u200a? Comment les accueillir\u200a?\nEt o\u00f9\u200a? Ah \u00e7a oui, comment\u200a? O\u00f9\u200a?\n\nC\u2019est dans un d\u00e9cor merveilleux, qui nous immerge au fin fond des bois, que trois artistes qui n\u2019ont pas froid au c\u0153ur nous racontent avec de tout petits personnages cette histoire d\u2019hospitalit\u00e9, de jalousie, de solidarit\u00e9, de petitesse, o\u00f9 nous reconnaissons nos tentatives et nos faiblesses humaines.\n\u00c0 voir et \u00e0 m\u00e9diter.\n\nAvec Martine Godard, Sabine Thunus et Gauthier Vaessen. \u00c9criture collective d\u2019apr\u00e8s le conte \u00ab Casimir \u00bb de Gr\u00e9goire Solotareff. Mise en sc\u00e8ne\u200a: Jean-Michel Fr\u00e8re. Coaching objets\u200a: Sabine Durand. Sc\u00e9nographie\u200a: Valentin P\u00e9rilleux assist\u00e9 de Jeannine Bouhon. Toile peinte\u200a: Eug\u00e9nie Obolenski. M\u00e9canismes\u200a: Paco Arg\u00fcelles Gonzalez. Costumes\u200a: H\u00e9l\u00e8ne Lhoest. Lumi\u00e8re\u200a: Dimitri Joukovski. Musique\u200a: Pirly Zurstrassen. Son\u200a: Maxime Glaude. Chor\u00e9graphie\u200a: Laetitia Lucatelli. R\u00e9gie\u200a: Gauthier Vaessen. Animations\u200a: Stefanie Heinrichs et Pauline Moureau.","performers":"Cie Arts & Couleurs","boxoffice_url":null,"website":"https:\/\/lamontagnemagique.be\/casimir-2\/","email":"info@montagnemagique.be","phone_contact":"+32 2 210 15 90","phone_booking":"+32 2 210 15 90","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50008414"},"sp":{"name":"Casimir","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lamontagnemagique.be\/casimir-2\/","email":"info@montagnemagique.be","phone_contact":"+32 2 210 15 90","phone_booking":"+32 2 210 15 90","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50008414"},"nl":{"name":"Casimir","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lamontagnemagique.be\/casimir-2\/","email":"info@montagnemagique.be","phone_contact":"+32 2 210 15 90","phone_booking":"+32 2 210 15 90","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50008414"}},"place":{"last_updated_at":"2022-10-10T10:25:09+02:00","published_at":"2013-10-19T01:13:46+02:00","id":228012,"translations":{"de":{"name":"Kindertheater - Th\u00e9\u00e2tre La montagne magique","address_street_name":"Rue du Marais","address_street_number":"57","address_street_box":null,"email":"info@montagnemagique.be","website":"http:\/\/www.theatremontagnemagique.be","phone_contact":"+32 2 210 15 90","phone_booking":"+32 2 210 15 90","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue du Marais, 57","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Th\u00e9\u