ebsite":"https:\/\/arkadia.be\/fr\/visites\/dans-les-coulisses-de-la-r-novation-de-lh-tel-solvay","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50006181"},"pt":{"name":"Dans les coulisses de la r\u00e9novation de l'h\u00f4tel Solvay","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/dans-les-coulisses-de-la-r-novation-de-lh-tel-solvay","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50006181"},"en":{"name":"Dans les coulisses de la r\u00e9novation de l'h\u00f4tel Solvay","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/dans-les-coulisses-de-la-r-novation-de-lh-tel-solvay","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50006181"},"it":{"name":"Dans les coulisses de la r\u00e9novation de l'h\u00f4tel Solvay","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/dans-les-coulisses-de-la-r-novation-de-lh-tel-solvay","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50006181"},"cn":{"name":"Dans les coulisses de la r\u00e9novation de l'h\u00f4tel Solvay","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/dans-les-coulisses-de-la-r-novation-de-lh-tel-solvay","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50006181"},"fr":{"name":"Dans les coulisses de la r\u00e9novation de l'h\u00f4tel Solvay","shortdescr":null,"longdescr":"De 1894 \u00e0 1898, Victor Horta construit pour Armand Solvay, le fils du c\u00e9l\u00e8bre industriel Ernest Solvay, le plus prestigieux des h\u00f4tels de ma\u00eetre Art nouveau \u00e0 Bruxelles. Construction majeure du ma\u00eetre de l'Art nouveau Victor Horta, il a la chance d'avoir conserv\u00e9 tous ses \u00e9l\u00e9ments d'origine : mobilier, luminaires, tentures et objets d'art de l'\u00e9poque.\nCette ann\u00e9e, le propri\u00e9taire de l'h\u00f4tel Solvay a lanc\u00e9 la r\u00e9novation compl\u00e8te de la facade c\u00f4t\u00e9 rue qui n\u00e9cessitait une restauration au niveau des chassis, des vitres, de la ferronnerie et des poutres de soutien. Outre la visite de l'h\u00f4tel de ma\u00eetre, notre guide vous expliquera les d\u00e9tails surprenants de cette r\u00e9novation. La fa\u00e7ade sera donc couverte d'une b\u00e2che !\nClass\u00e9 au patrimoine mondial de l'UNESCO, c'est un \u00e9crin unique, o\u00f9 la notion d'art total prend ici tout son sens.\n\n(enfants de -12 ans non-admis)","performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/dans-les-coulisses-de-la-r-novation-de-lh-tel-solvay","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50006181"},"sp":{"name":"Dans les coulisses de la r\u00e9novation de l'h\u00f4tel Solvay","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/dans-les-coulisses-de-la-r-novation-de-lh-tel-solvay","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50006181"},"nl":{"name":"Dans les coulisses de la r\u00e9novation de l'h\u00f4tel Solvay","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/arkadia.be\/fr\/visites\/dans-les-coulisses-de-la-r-novation-de-lh-tel-solvay","email":"info@arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50006181"}},"place":{"id":261979,"translations":{"de":{"name":"H\u00f4tel Solvay","address_street_name":"Avenue Louise","address_street_number":"224","address_street_box":null,"email":"info@hotelsolvay.be","website":"http:\/\/www.hotelsolvay.be","phone_contact":"+32 2 640 56 45","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Louise, 224","address_line2":"1050 Ixelles","description_web":"Architekt: Victor Horta - 1895\/1898\r\nDieses luxuri\u00f6se Anwesen wurde 1894 von Victor Horta f\u00fcr den Sohn des Unternehmers Ernest Solvay erbaut. Dem Architekten wurde vollkommen freie Hand gelassen und bei der bis ins kleinste Detail durchdachten Innenausstattung und dem Mobiliar \u00fcberlie\u00df er nichts dem Zufall. Die Fassade wird von zwei symmetrischen Erkern geziert, die sich \u00fcber zwei Etagen erstrecken. Dar\u00fcber befinden sich zwei Balkone. Im Interieur erwartet den Besucher ein optisches Feuerwerk. Die Farbpalette zwischen Rot- und Oranget\u00f6nen verst\u00e4rkt noch den Eindruck von Luxus und Komfort. Ein Besuch lohnt sich! ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"H\u00f4tel Solvay","address_street_name":"Avenue Louise","address_street_number":"224","address_street_box":null,"email":"info@hotelsolvay.be","website":"http:\/\/www.hotelsolvay.be","phone_contact":"+32 2 640 56 45","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Louise, 224","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Solvay House","address_street_name":"Louizalaan","address_street_number":"224","address_street_box":null,"email":"info@hotelsolvay.be","website":"http:\/\/www.hotelsolvay.be","phone_contact":"+32 2 640 56 45","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Louizalaan, 224","address_line2":"1050 Ixelles","description_web":"Architect: Victor Horta - 1895\/1898 \r\nThis luxury townhouse was built by Victor Horta in 1894 for the son of captain of industry Ernest Solvay. The architect was given \u201ccarte blanche\u201d and designed the interior and the furniture down to the smallest detail. On the fa\u00e7ade, two symmetric bow windows surmounted by balconies are seen to protrude across two floors. Indoors it is a visual extravaganza, with the sheer range of red-orange hues on offer only acting to underpin the atmosphere of luxury and comfort. A must-see building. \r\n\r\nPlease note : Children under 12 years of age are not admitted to the guided tours.\r\n","description_print":null,"booking_url":"http:\/\/ticket.visit.brussels\/en\/261979\/solvay-house\/shop","sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"H\u00f4tel Solvay","address_street_name":"Avenue Louise","address_street_number":"224","address_street_box":null,"email":"info@hotelsolvay.be","website":"http:\/\/www.hotelsolvay.be","phone_contact":"+32 2 640 56 45","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Louise, 224","address_line2":"1050 Ixelles","description_web":"Architetto Victor Horta \u2013 1895 \/ 1898 \r\nQuesta lussuosa villa \u00e9 stata costruita da Victor Horta nel 1894 per il figlio dell\u2019industriale Ernest Solvay. L\u2019architetto ha ricevuto totale libert\u00e0 e ha concepito l\u2019interno e i mobili nei minimi dettagli. Sulla facciata, due \u201cbow-window\u201d simetriche si elevano su due piani e sono superate da balconi. Al interno, \u00e9 un fuoco d'artificio visivo. La gamma dei toni rossi \u2013 arrancione rinforza l\u2019atmosfera di lusso e di conforto. Da vedere assolutamente. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"H\u00f4tel Solvay","address_street_name":"Avenue Louise","address_street_number":"224","address_street_box":null,"email":"info@hotelsolvay.be","website":"http:\/\/www.hotelsolvay.be","phone_contact":"+32 2 640 56 45","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Louise, 224","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"H\u00f4tel Solvay","address_street_name":"Avenue Louise","address_street_number":"224","address_street_box":null,"email":"info@hotelsolvay.be","website":"http:\/\/www.hotelsolvay.be","phone_contact":"+32 2 640 56 45","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Louise, 224","address_line2":"1050 Ixelles","description_web":"Architecte: Victor Horta - 1895\/1898\nCette demeure luxueuse fut construite par Victor Horta en 1894 pour le fils de l\u2019industriel Ernest Solvay. L\u2019architecte re\u00e7ut \u201ccarte blanche\u201d et con\u00e7ut l\u2019int\u00e9rieur et le mobilier jusque dans les moindres d\u00e9tails. Sur la fa\u00e7ade, deux bow-windows sym\u00e9triques s\u2019\u00e9l\u00e8vent sur deux \u00e9tages et sont surmont\u00e9s de balcons. A l\u2019int\u00e9rieur, c\u2019est un feu d\u2019artifices visuel. La gamme des tons rouge-orange renforce l\u2019atmosph\u00e8re de luxe et de confort. A voir absolument.\n\nAchat des tickets uniquement en ligne.\n\nVisite guid\u00e9e sur demande \u00e0 l'adresse  info@hotelsolvay.be\n\nAttention : Les enfants de moins de 12 ans ne sont pas admis aux visites guid\u00e9es.","description_print":null,"booking_url":"http:\/\/ticket.visit.brussels\/fr\/261979\/hotel-solvay\/shop","sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"H\u00f4tel Solvay","address_street_name":"Avenue Louise","address_street_number":"224","address_street_box":null,"email":"info@hotelsolvay.be","website":"http:\/\/www.hotelsolvay.be","phone_contact":"+32 2 640 56 45","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Avenue Louise, 224","address_line2":"1050 Ixelles","description_web":"Arquitecto: Victor Horta - 1895\/1898\r\nEsta lujosa mansi\u00f3n fue construida por Victor Horta en 1894 para el hijo del empresario Ernest Solvay. El arquitecto recibi\u00f3 carta blanca y concibi\u00f3 el interior y el mobiliario hasta el \u00faltimo detalle. En la fachada, dos miradores sim\u00e9tricos se elevan sobre los dos pisos y los balcones. El interior es una maravilla visual. La gama de los tonos rojo-naranja refuerza la atm\u00f3sfera de lujo y de confort. Una visita imprescindible.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Solvay Herenhuis","address_street_name":"Louizalaan","address_street_number":"224","address_street_box":null,"email":"info@hotelsolvay.be","website":"http:\/\/www.hotelsolvay.be","phone_contact":"+32 2 640 56 45","phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"Louizalaan, 224","address_line2":"1050 Ixelles","description_web":"Architect: Victor Horta - 1895\/1898\r\nVictor Horta bouwde dit luxueuze herenhuis in 1894 voor de zoon van de industrieel Ernest Solvay. De architect kreeg carte blanche voor dit project. Hij ontwierp het interieur en het meubilair tot in de kleinste details. Op de gevel lopen twee symmetrische erkers over twee verdiepingen, met daarboven balkons. Binnen wacht een visueel vuurwerk. Het palet van rood- en oranjetinten zet de sfeer van luxe en comfort nog sterker in de verf. Een bezoek meer dan waard.\r\n\r\nBelangrijke opmerking : Kinderen jonger dan 12 jaar mogen niet deelnemen aan rondleidingen.\r\n","description_print":null,"booking_url":"http:\/\/ticket.visit.brussels\/nl\/261979\/solvay-herenhuis\/shop","sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[5,6],"translations":{"de":["Flagey","Chatelain\/Bailli"],"pt":[null,null],"en":["Flagey","Chatelain\/Bailli"],"it":["Flagey","Chatelain\/Bailli"],"cn":[null,null],"fr":["Flagey","Chatelain\/Bailli"],"sp":["Flagey","Ch\u00e2telain\/Bailli"],"nl":["Flagey","Kasteleinswijk\/Baljuw"]}},"zones":{"list":[21],"translations":{"de":["S\u00fcden"],"pt":[null],"en":["South"],"it":["Sud"],"cn":[null],"fr":["Sud"],"sp":["Sur"],"nl":["Zuid"]}},"neca":null,"facebook_id":null,"backoffice_id":21979,"location":{"lat":50.8263727,"lon":4.3654832},"region":"brussels","last_updated_at":"2023-12-01T10:46:01+01:00","published_at":"2015-06-26T11:03:12+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":276946,"translations":{"de":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be\/en","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":"Since 1983, Arkadia has been exploring the richness of Belgium's and Brussels' heritage and developing numerous cultural projects especially in Brussels, between architecture, urbanism, culture, plastic arts and ideology from the Middle Ages to the present day. Seeing and understanding the city and its architectural development, approaching artistic creation and giving it meaning, these are the activities that the ASBL wants to share with the public. Specialists in architectural heritage and contemporary art, they show the city through guided tours and lectures in several languages.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":"Depuis 1983, Arkadia explore les richesses du patrimoine belge et bruxellois et d\u00e9veloppe de nombreux projets culturels sp\u00e9cialement \u00e0 Bruxelles, entre architecture, urbanisme, culture, arts plastiques et id\u00e9ologie depuis le Moyen \u00c2ge jusqu\u2019\u00e0 nos jours. Voir et comprendre la ville et son d\u00e9veloppement architectural, approcher la cr\u00e9ation artistique et lui donner un sens, telles sont les activit\u00e9s que l'ASBL veut partager avec le public. Sp\u00e9cialistes du patrimoine  architectural et de l'art contemporain, ils font d\u00e9couvrir la ville \u00e0 travers des visites guid\u00e9es et des conf\u00e9rences en plusieurs langues.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Arkadia","address_street_name":"Rue de Namur","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue de Namur, 10","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Arkadia","address_street_name":"Naamsestraat","address_street_number":"10","address_street_box":null,"email":"info@arkadia.be","website":"https:\/\/arkadia.be\/nl","phone_contact":"+32 2 319 45 60","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Naamsestraat, 10","address_line2":"1000 Bruxelles","description_web":"Sinds 1983 verkent Arkadia de rijkdom van het Belgische en Brusselse erfgoed en ontwikkelt talrijke culturele projecten, vooral in Brussel, tussen architectuur, stedenbouw, cultuur, plastische kunsten en ideologie, van de Middeleeuwen tot vandaag. De stad en haar architecturale ontwikkeling zien en begrijpen, de artistieke creatie benaderen en er een betekenis aan geven, dat zijn de activiteiten die de VZW met het publiek wil delen. Zij zijn gespecialiseerd in architectonisch erfgoed en hedendaagse kunst en laten de stad zien door middel van rondleidingen en lezingen in verschillende talen.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":36946,"location":{"lat":50.84145283,"lon":4.35976257},"last_updated_at":"2023-06-08T12:25:28+02:00","published_at":"2021-07-23T14:48:31+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/9eb35ad3e0bfcd66348bef4b70d58d8590e12e38.jpg","width":5021,"height":4251,"ratio":1.18,"oEmbed_height":4251,"oEmbed_width":5021,"translations":{"de":{"title":"Dans les coulisses de la r\u00e9novation de l'h\u00f4tel Solvay","copyright":"\u00a9EB - Photographe Voituron"},"pt":{"title":"Dans les coulisses de la r\u00e9novation de l'h\u00f4tel Solvay","copyright":"\u00a9EB - Photographe Voituron"},"en":{"title":"Dans les coulisses de la r\u00e9novation de l'h\u00f4tel Solvay","copyright":"\u00a9EB - Photographe Voituron"},"it":{"title":"Dans les coulisses de la r\u00e9novation de l'h\u00f4tel Solvay","copyright":"\u00a9EB - Photographe Voituron"},"cn":{"title":"Dans les coulisses de la r\u00e9novation de l'h\u00f4tel Solvay","copyright":"\u00a9EB - Photographe Voituron"},"fr":{"title":"Dans les coulisses de la r\u00e9novation de l'h\u00f4tel Solvay","copyright":"\u00a9EB - Photographe Voituron"},"sp":{"title":"Dans les coulisses de la r\u00e9novation de l'h\u00f4tel Solvay","copyright":"\u00a9EB - Photographe Voituron"},"nl":{"title":"Dans les coulisses de la r\u00e9novation de l'h\u00f4tel Solvay","copyright":"\u00a9EB - Photographe Voituron"}}}],"dates":[{"day":"2024-02-09","doors":null,"start":"18:00:00","end":"19:15:00","end_night_life":null,"is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"de":{"name":"Normal"},"en":{"name":"Normal"},"it":{"name":"Normale"},"fr":{"name":"Normal"},"sp":{"name":"Normal"},"nl":{"name":"Normaal"}},"value":40}],"date_exceptions":[],"closing_days":[],"child_events":[],"parent_events":[],"accessibilities":[],"recurring":[],"targets":{"list":[],"translations":{}},"educational_targets":{"list":[],"translations":{}},"tags":[]},{"id":50006585,"date_start":"2024-02-03","date_end":"2024-04-11","date_next":"2024-02-15","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-02-04T01:03:54+01:00","published_at":"2024-01-29T17:26:45+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":293189,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"other","ranking":0.3071804943499485,"languages":{"spoken":["nl","fr"],"subtitles":[]},"categories":{"main":{"id":90,"translations":{"de":"Animationen","pt":null,"en":"Animations","it":"Animazioni","cn":null,"fr":"Animations","sp":"Animaciones","nl":"Animaties"}},"others":{}},"translations":{"de":{"name":"Expeditie Inclusief","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.belvue.be\/fr\/activities\/expedition-inclusion","email":"info@belvue.be","phone_contact":"+32 2 545 08 00","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50006585"},"pt":{"name":"Expeditie Inclusief","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.belvue.be\/fr\/activities\/expedition-inclusion","email":"info@belvue.be","phone_contact":"+32 2 545 08 00","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50006585"},"en":{"name":"Expeditie Inclusief","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.belvue.be\/fr\/activities\/expedition-inclusion","email":"info@belvue.be","phone_contact":"+32 2 545 08 00","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50006585"},"it":{"name":"Expeditie Inclusief","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.belvue.be\/fr\/activities\/expedition-inclusion","email":"info@belvue.be","phone_contact":"+32 2 545 08 00","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50006585"},"cn":{"name":"Expeditie Inclusief","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.belvue.be\/fr\/activities\/expedition-inclusion","email":"info@belvue.be","phone_contact":"+32 2 545 08 00","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50006585"},"fr":{"name":"Exp\u00e9dition Inclusion","shortdescr":"Exp\u00e9dition inclusion un jeu coop\u00e9ratif et accessible gr\u00e2ce auquel les enfants d\u2019\u00e2ge  mental de 6 \u00e0 10 ans abordent les questions climatiques en collaboration, avec ses famille et en groupes d'enfants. ","longdescr":"Venez jouer Exp\u00e9dition Inclusion, le jeu qui enflamme la banquise\u202f!\n\nExp\u00e9dition Inclusion un jeu coop\u00e9ratif et accessible gr\u00e2ce auquel les enfants d\u2019\u00e2ge mental de 6 \u00e0 10 ans abordent les questions climatiques. Tout le monde va devoir s\u2019entraider pour sauver une colonie de manchot\u00b7es en d\u00e9tresse face \u00e0 la fonte de la banquise.\n\nOutre le plaisir du jeu, la sensibilisation au handicap est l'objectif principal de cette exp\u00e9rience ludique inclusive. Les enfants, avec ou sans handicap, d\u00e9couvrent le monde de l'autre. Ce jeu a \u00e9t\u00e9 d\u00e9velopp\u00e9 par De Ouders vzw. Il est compl\u00e8tement gratuit et sans r\u00e9servation.\n\nPour plus d'informations, visitez notre site web.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.belvue.be\/fr\/activities\/expedition-inclusion","email":"info@belvue.be","phone_contact":"+32 2 545 08 00","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50006585"},"sp":{"name":"Expeditie Inclusief","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.belvue.be\/fr\/activities\/expedition-inclusion","email":"info@belvue.be","phone_contact":"+32 2 545 08 00","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50006585"},"nl":{"name":"Expeditie Inclusief","shortdescr":"Expeditie inclusief is een co\u00f6peratief en toegankelijk spel dat kinderen helpt om samen met hun familie of in een groep klimaatproblemen aan te pakken. ","longdescr":"Ontdek Expeditie Inclusief, het spel waar iedereen warm van wordt!\n\nExpeditie Inclusief is een co\u00f6peratief en toegankelijk spel dat kinderen met de mentale leeftijd van 6 tot 10 jaar helpt om klimaatproblemen aan te pakken. Iedereen moet elkaar helpen om een kolonie pingu\u00efns in nood te redden van het smeltende pakijs.\n\nNaast het spelplezier is de bewustmaking rond mensen met een beperking het hoofddoel van deze inclusieve spelervaring. Kinderen, met of zonder beperking, ontdekken de wereld van anderen.\n\nDit spel werd ontwikkeld door De Ouders vzw, en is volledig gratis en zonder reservatie beschikbaar!\n\nVoor meer informatie bezoek onze website ","performers":null,"boxoffice_url":null,"website":"https:\/\/www.belvue.be\/nl\/activities\/expeditie-inclusief","email":"info@belvue.be","phone_contact":"+32 2 545 08 00","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50006585"}},"place":{"id":233379,"translations":{"de":{"name":"Museum BELvue","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@belvue.be","website":"http:\/\/www.belvue.be","phone_contact":"+32 2 545 08 00","phone_booking":"+32 2 500 45 54","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"Belgische Fritten, Bier, Schokolade...Belgien ist mehr als nur das, oder? Demokratie, Wohlstand, Solidarit\u00e4t, Vielfalt, Migration, Sprachen, Europa: Dies sind die Themen, die das BELvue Museum Ihnen auf Ihrem Rundgang durch die Ausstellungsr\u00e4ume n\u00e4herbringt! Jedes Thema wird anhand von aktuellen Kommentaren und Berichten geschildert und dann in seinen geschichtlichen Kontext gebracht. Eine moderne und originelle Herangehensweise, die den Besuchern einen faszinierenden Einblick in das Belgien der Gegenwart gew\u00e4hrt.\r\n\r\nAbsolut sehenswert ist auch die Galerie: Mehr als 200 Ausstellungsst\u00fccke verk\u00f6rpern gewisserma\u00dfen das materielle Ged\u00e4chtnis Belgiens. Zu bewundern gibt es unter anderem eine Lithographie von Magritte, Kristallvasen aus der Kristallmanufaktur Val Saint-Lambert und sogar einen von den Roten Teufeln signierten Fu\u00dfball. Eine geballte Ladung belgischer Lebensart!\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Museo BELvue","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@belvue.be","website":"http:\/\/www.belvue.be","phone_contact":"+32 2 545 08 00","phone_booking":"+32 2 500 45 54","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"Apresentando-se como o museu da B\u00e9lgica e da sua hist\u00f3ria, mas igualmente como \u00abcentro para a democracia\u00bb, o estabelecimento beneficia de uma museografia recentemente completamente remodelada. Democracia, prosperidade, solidariedade, pluralismo, migra\u00e7\u00f5es, l\u00ednguas, Europa: o museu BELvue prop\u00f5e-lhe descobrir o pa\u00eds atrav\u00e9s desses temas. A abordagem quer-se original, pelo que cada tema \u00e9, em primeiro lugar, explicitado com a ajuda de testemunhas reais e, de seguida, contextualizado atrav\u00e9s da hist\u00f3ria. Mais de 200 objetos comp\u00f5em uma galeria e permitem incarnar a mem\u00f3ria material do pa\u00eds. Poder\u00e1 a\u00ed encontrar, por exemplo, uma litografia de Magritte, vasos em cristal produzidos por Val Saint-Lambert, m\u00e1scaras de carnaval da regi\u00e3o de Binche, ou ainda um bal\u00e3o assinado pela Sele\u00e7\u00e3o Belga de Futebol! Este edif\u00edcio, inicialmente usado como hotel, foi constru\u00eddo em 1776 \u2014 e aberto durante o ano seguinte \u2014 num tur\u00edstico, comercial (dif\u00edcil imagin\u00e1-lo hoje em dia!) e muito cosmopolita (o hotel Astoria, na rua Royale, \u00e9 a \u00fanica testemunha atual). O estabelecimento recebia essencialmente turistas, a maioria dos quais ingleses, mas n\u00e3o qualquer turista: tratava-se de um hotel de luxo, com clientes prestigiosos. De estilo neocl\u00e1ssico, como toda a Pra\u00e7a Real, o edif\u00edcio privilegia a sobriedade e as propor\u00e7\u00f5es harmoniosas. A visita interior oferecer-lhe-\u00e1 ainda mais detalhes de decora\u00e7\u00e3o. O Parque de Bruxelas consiste num polo de atra\u00e7\u00e3o para os turistas: o passeio mundano \u00e9, na realidade, um trabalho de escolha. \u00abDo meio-dia \u00e0 uma, este passeio torna-se, simplesmente, o local de encontro de estranhos e ricos. Esta salada de frutas de pa\u00edses que se encontram alegra este local durante algumas horas por dia\u00bb. Se, em geral, as rela\u00e7\u00f5es de Bellevue com o seu ilustre vizinho \u2014 o Pal\u00e1cio Real \u2014 permanecem boas, com o hotel a alojar frequentemente convidados de honra pass\u00edveis de uma visita real, poderiam ter ocorrido algumas fric\u00e7\u00f5es, nomeadamente devido \u00e0 constru\u00e7\u00e3o dos terra\u00e7os adjacentes ao estabelecimento, que oferecem uma vista magn\u00edfica para os jardins do rei, o que n\u00e3o \u00e9 muito do agrado de L\u00e9opold II\u2026 Ver o panfleto sobre a hist\u00f3ria do edif\u00edcio, dispon\u00edvel no local A entrada para o museu BELvue \u00e9 gratuita todas as ter\u00e7as-feiras a partir das 14h.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"BELvue museum","address_street_name":"Paleizenplein","address_street_number":"7","address_street_box":null,"email":"info@belvue.be","website":"http:\/\/www.belvue.be","phone_contact":"+32 2 545 08 00","phone_booking":"+32 2 500 45 54","address_zip":"1000","address_city":"Bruxelles","address_line1":"Paleizenplein, 7","address_line2":"1000 Bruxelles","description_web":"Chips, beer and chocolates... surely there is more to Belgium than that? Democracy, prosperity, solidarity, pluralism, migration, languages and Europe: these are the themes used by the BELvue Museum to help you to discover Belgium. Each one is developed through present-day testimonials and then traced right through history. This is a modern, original way of gaining a fuller understanding of modern-day Belgium.\r\nHave a look at the gallery too: there are more than 200 objects to view, each one forming a tangible memory of Belgium. Here are just a few examples: a lithograph by Magritte, a motorcycle, crystal vases by Val Saint-Lambert, and a football signed by the Red Devils. The very essence of Belgian-ness!\r\n\r\nSpeciale openingstijden op schoolvakanties en feestdagen 9.30 tot 17.00 uur\r\n24\/12 en 31\/12 9u30 tot 16u00\r\nHet BELvue Museum is elke woensdag vanaf 14u en de eerste zondag van de maand gratis toegankelijk.\r\n","description_print":null,"booking_url":"https:\/\/www.ticketing.brussels\/en\/tickets\/event-details.BELvue-Museum.49937124-48cf-411f-a59c-8cac972ead6d","sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Museo BELvue","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@belvue.be","website":"http:\/\/www.belvue.be","phone_contact":"+32 2 545 08 00","phone_booking":"+32 2 500 45 54","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"Nel Museo BELvue, grazie a numerosi documenti, i visitatori potranno scoprire i grandi periodi della storia del Belgio.\u00a0...\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"mus\u00e9e BELvue","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@belvue.be","website":"http:\/\/www.belvue.be","phone_contact":"+32 2 545 08 00","phone_booking":"+32 2 500 45 54","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"mus\u00e9e BELvue","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@belvue.be","website":"http:\/\/www.belvue.be","phone_contact":"+32 2 545 08 00","phone_booking":"+32 2 500 45 54","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"Se pr\u00e9sentant comme le mus\u00e9e de la Belgique et de son histoire, mais \u00e9galement comme \u00ab centre pour la d\u00e9mocratie \u00bb, l\u2019\u00e9tablissement b\u00e9n\u00e9ficie d\u2019une mus\u00e9ographie compl\u00e8tement remani\u00e9e depuis peu. D\u00e9mocratie, prosp\u00e9rit\u00e9, solidarit\u00e9, pluralisme, migrations, langues, Europe : le mus\u00e9e BELvue vous propose de d\u00e9couvrir le pays \u00e0 travers ces quelques th\u00e9matiques. L\u2019approche se veut originale, puisque chaque th\u00e9matique est d\u2019abord explicit\u00e9e \u00e0 l\u2019aide de t\u00e9moignages actuels, et ensuite contextualis\u00e9e \u00e0 travers l\u2019histoire. Plus de 200 objets composent une galerie et permettent d\u2019incarner la m\u00e9moire mat\u00e9rielle du pays. Vous y croiserez par exemple une lithographie de Magritte, des vases en cristal du Val Saint-Lambert, un costume du carnaval de Binche, ou encore un ballon sign\u00e9 par les Diables Rouges !\r\n\r\nCe b\u00e2timent, affect\u00e9 initialement \u00e0 l\u2019usage d\u2019un h\u00f4tel, est b\u00e2ti en 1776 \u2014 et ouvert dans le courant de l\u2019ann\u00e9e suivante \u2014 dans un p\u00f4le \u00e0 vocation touristique, commercial (difficile \u00e0 s\u2019imaginer aujourd\u2019hui !), et tr\u00e8s cosmopolite (l\u2019h\u00f4tel Astoria, rue Royale, en demeure le seul t\u00e9moin actuel). L\u2019\u00e9tablissement recevait essentiellement des touristes, en majorit\u00e9 anglais, mais pas n\u2019importe quels touristes : il s\u2019agit d\u2019une h\u00f4tellerie de luxe, avec des clients prestigieux.\r\n\r\nDe style n\u00e9oclassique, comme l\u2019ensemble de la place Royale, le b\u00e2timent privil\u00e9gie la sobri\u00e9t\u00e9 et les proportions harmonieuses. La visite int\u00e9rieure vous offrira davantage de d\u00e9tails sur le d\u00e9cor.\r\n\r\nLe Parc de Bruxelles constituait un p\u00f4le d\u2019attraction pour les touristes : la promenade mondaine est en effet une occupation de choix. \u00ab De midi \u00e0 une heure, cette promenade devient ordinairement le rendez-vous des \u00e9trangers et des gens riches. Cette mac\u00e9doine de nations qu\u2019on y rencontre \u00e9gaie quelques heures par jour cet endroit. \u00bb\r\nSi globalement, les relations du Bellevue avec son illustre voisin \u2014 le palais royal \u2014 restent bonnes, l\u2019h\u00f4tel h\u00e9bergeant m\u00eame souvent des invit\u00e9s de marque susceptibles d\u2019une entrevue royale, quelques frictions ont pu appara\u00eetre, notamment \u00e0 cause de la construction de terrasses adjacentes \u00e0 l\u2019\u00e9tablissement, et donnant une vue magnifique sur les jardins du roi, ce qui n\u2019\u00e9tait pas tr\u00e8s au go\u00fbt de L\u00e9opold II\u2026\r\n\r\nHoraire exceptionnel les jours de vacances scolaires et le jours f\u00e9ri\u00e9s 9h30 \u00e0 17h\r\nLe 24\/12 et le 31\/12 9h30 \u00e0 16:00\r\nL'entr\u00e9e au mus\u00e9e BELvue est gratuite tous les mercredis \u00e0 partir de 14 heures et le 1er dimanche du mois","description_print":null,"booking_url":"https:\/\/www.ticketing.brussels\/fr\/tickets\/event-details.Musee-BELvue.49937124-48cf-411f-a59c-8cac972ead6d","sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Museo BELvue","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@belvue.be","website":"http:\/\/www.belvue.be","phone_contact":"+32 2 545 08 00","phone_booking":"+32 2 500 45 54","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"Conocido como el museo de B\u00e9lgica y su historia, pero tambi\u00e9n como \"centro para la democracia\", el establecimiento posee una museograf\u00eda completamente redise\u00f1ada desde hace poco. Democracia, prosperidad, solidaridad, pluralismo, migraciones, idiomas, Europa: El museo BELvue te propone descubrir el pa\u00eds a trav\u00e9s de diferentes tem\u00e1ticas. El enfoque es original, ya que cada tem\u00e1tica se explica en primer lugar con la ayuda de testimonios actuales y a continuaci\u00f3n es contextualizada a trav\u00e9s de la historia. M\u00e1s de 200 objetos componen una galer\u00eda para encarnar la memoria material del pa\u00eds. Encontrar\u00e1s, por ejemplo, una litograf\u00eda de Magritte, los vasos de cristal de Val Saint-Lambert, un disfraz del carnaval de Binche, \u00a1Y un bal\u00f3n firmado por los Diablos Rojos!\r\nEste edificio, originalmente utilizado como hotel, se construy\u00f3 en 1776 \u2014 y fue abierto durante el transcurso del a\u00f1o siguiente \u2014 como un centro de car\u00e1cter tur\u00edstico, comercial y muy cosmopolita. El establecimiento recibe esencialmente turistas, en su mayor\u00eda ingleses, pero no cualquier turista: se trata de un hospedaje de lujo, con clientes prestigiosos. De estilo neocl\u00e1sico, como el conjunto de la Place Royale, el edificio favorece la sobriedad y las proporciones armoniosas. La vista interior te ofrecer\u00e1 m\u00e1s detalles del decorado.\r\nEl Parque de Bruselas constituye un centro de atracci\u00f3n para los turistas: esta visita al parque es en efecto una excelente actividad a elegir. \"Entre media hora y una hora, este paseo se convierte generalmente en un punto de reuni\u00f3n para la diversidad, desde extranjeros hasta gente rica. Esta macedonia de nacionalidades que encontramos enriquece el ambiente del lugar\".\r\nSi las relaciones entre Bellevue y su ilustre vecino - el Palacio Real - siguen siendo buenas, el hotel hospeda a menudo a distinguidos invitados de entrevista real. Pueden haber surgido ciertos roces especialmente a causa de la contrucci\u00f3n de terrazas adyacentes al establecimiento, proporcionando una magn\u00edfica vista al Real Jard\u00edn de las Plantas Medicinales, el cual no era del agrado de Leopoldo ll.\r\nV\u00e9ase el folleto sobre la historia del edificio disponible en el lugar.\r\n\r\nLa entrada al museo BELvue es gratuita todos los mi\u00e9rcoles a partir de las 14:00.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"BELvue museum","address_street_name":"Paleizenplein","address_street_number":"7","address_street_box":null,"email":"info@belvue.be","website":"http:\/\/www.belvue.be","phone_contact":"+32 2 545 08 00","phone_booking":"+32 2 500 45 54","address_zip":"1000","address_city":"Bruxelles","address_line1":"Paleizenplein, 7","address_line2":"1000 Bruxelles","description_web":"Frieten, bier, chocolade\u2026 maar Belgi\u00eb is toch wel meer dan dat, nietwaar? Democratie, welvaart, solidariteit, pluralisme, migratie, taal, Europa: dat zijn de thema\u2019s die het BELvue museum jullie voorstelt om kennis te maken met het land! Elk thema wordt uitgewerkt aan de hand van hedendaagse getuigenissen en vervolgens toegelicht doorheen de geschiedenis. Een eigentijdse en originele manier om een beter inzicht te verwerven in het Belgi\u00eb van vandaag.\r\nNeem zeker ook een kijkje in de galerij: daar staan meer dan 200 voorwerpen opgesteld die het materi\u00eble geheugen van Belgi\u00eb vormen. Je kunt er onder andere de volgende zaken bewonderen: een lithografie van Magritte, een motorfiets, kristallen vazen van Val Saint-Lambert, en een bal met de handtekeningen van de Rode Duivels erop. Een verzameling met een hoog Belgi\u00ebgehalte!\r\n\r\nElke woensdag vanaf 14.00 uur is het BELvue museum gratis toegankelijk.\r\nMaandag open voor groepen en scholen op reservering van 09:30 tot 17:00\r\n","description_print":null,"booking_url":"https:\/\/www.ticketing.brussels\/nl\/tickets\/event-details.BELvue-museum.49937124-48cf-411f-a59c-8cac972ead6d","sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[16],"translations":{"de":["K\u00f6nigliches Viertel"],"pt":[null],"en":["Royal"],"it":["Quartiere reale"],"cn":[null],"fr":["Quartier Royal"],"sp":["Quartier Royal \u2014Barrio de la Corte\u2014"],"nl":["Koninklijke wijk"]}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":null,"facebook_id":null,"backoffice_id":1250,"location":{"lat":50.8426107,"lon":4.3606882},"region":"brussels","last_updated_at":"2024-01-31T10:06:01+01:00","published_at":"2013-10-19T01:14:10+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":233379,"translations":{"de":{"name":"Museum BELvue","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@belvue.be","website":"http:\/\/www.belvue.be","phone_contact":"+32 2 545 08 00","phone_booking":"+32 2 500 45 54","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"Belgische Fritten, Bier, Schokolade...Belgien ist mehr als nur das, oder? Demokratie, Wohlstand, Solidarit\u00e4t, Vielfalt, Migration, Sprachen, Europa: Dies sind die Themen, die das BELvue Museum Ihnen auf Ihrem Rundgang durch die Ausstellungsr\u00e4ume n\u00e4herbringt! Jedes Thema wird anhand von aktuellen Kommentaren und Berichten geschildert und dann in seinen geschichtlichen Kontext gebracht. Eine moderne und originelle Herangehensweise, die den Besuchern einen faszinierenden Einblick in das Belgien der Gegenwart gew\u00e4hrt.\r\n\r\nAbsolut sehenswert ist auch die Galerie: Mehr als 200 Ausstellungsst\u00fccke verk\u00f6rpern gewisserma\u00dfen das materielle Ged\u00e4chtnis Belgiens. Zu bewundern gibt es unter anderem eine Lithographie von Magritte, Kristallvasen aus der Kristallmanufaktur Val Saint-Lambert und sogar einen von den Roten Teufeln signierten Fu\u00dfball. Eine geballte Ladung belgischer Lebensart!\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Museo BELvue","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@belvue.be","website":"http:\/\/www.belvue.be","phone_contact":"+32 2 545 08 00","phone_booking":"+32 2 500 45 54","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"Apresentando-se como o museu da B\u00e9lgica e da sua hist\u00f3ria, mas igualmente como \u00abcentro para a democracia\u00bb, o estabelecimento beneficia de uma museografia recentemente completamente remodelada. Democracia, prosperidade, solidariedade, pluralismo, migra\u00e7\u00f5es, l\u00ednguas, Europa: o museu BELvue prop\u00f5e-lhe descobrir o pa\u00eds atrav\u00e9s desses temas. A abordagem quer-se original, pelo que cada tema \u00e9, em primeiro lugar, explicitado com a ajuda de testemunhas reais e, de seguida, contextualizado atrav\u00e9s da hist\u00f3ria. Mais de 200 objetos comp\u00f5em uma galeria e permitem incarnar a mem\u00f3ria material do pa\u00eds. Poder\u00e1 a\u00ed encontrar, por exemplo, uma litografia de Magritte, vasos em cristal produzidos por Val Saint-Lambert, m\u00e1scaras de carnaval da regi\u00e3o de Binche, ou ainda um bal\u00e3o assinado pela Sele\u00e7\u00e3o Belga de Futebol! Este edif\u00edcio, inicialmente usado como hotel, foi constru\u00eddo em 1776 \u2014 e aberto durante o ano seguinte \u2014 num tur\u00edstico, comercial (dif\u00edcil imagin\u00e1-lo hoje em dia!) e muito cosmopolita (o hotel Astoria, na rua Royale, \u00e9 a \u00fanica testemunha atual). O estabelecimento recebia essencialmente turistas, a maioria dos quais ingleses, mas n\u00e3o qualquer turista: tratava-se de um hotel de luxo, com clientes prestigiosos. De estilo neocl\u00e1ssico, como toda a Pra\u00e7a Real, o edif\u00edcio privilegia a sobriedade e as propor\u00e7\u00f5es harmoniosas. A visita interior oferecer-lhe-\u00e1 ainda mais detalhes de decora\u00e7\u00e3o. O Parque de Bruxelas consiste num polo de atra\u00e7\u00e3o para os turistas: o passeio mundano \u00e9, na realidade, um trabalho de escolha. \u00abDo meio-dia \u00e0 uma, este passeio torna-se, simplesmente, o local de encontro de estranhos e ricos. Esta salada de frutas de pa\u00edses que se encontram alegra este local durante algumas horas por dia\u00bb. Se, em geral, as rela\u00e7\u00f5es de Bellevue com o seu ilustre vizinho \u2014 o Pal\u00e1cio Real \u2014 permanecem boas, com o hotel a alojar frequentemente convidados de honra pass\u00edveis de uma visita real, poderiam ter ocorrido algumas fric\u00e7\u00f5es, nomeadamente devido \u00e0 constru\u00e7\u00e3o dos terra\u00e7os adjacentes ao estabelecimento, que oferecem uma vista magn\u00edfica para os jardins do rei, o que n\u00e3o \u00e9 muito do agrado de L\u00e9opold II\u2026 Ver o panfleto sobre a hist\u00f3ria do edif\u00edcio, dispon\u00edvel no local A entrada para o museu BELvue \u00e9 gratuita todas as ter\u00e7as-feiras a partir das 14h.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"BELvue museum","address_street_name":"Paleizenplein","address_street_number":"7","address_street_box":null,"email":"info@belvue.be","website":"http:\/\/www.belvue.be","phone_contact":"+32 2 545 08 00","phone_booking":"+32 2 500 45 54","address_zip":"1000","address_city":"Bruxelles","address_line1":"Paleizenplein, 7","address_line2":"1000 Bruxelles","description_web":"Chips, beer and chocolates... surely there is more to Belgium than that? Democracy, prosperity, solidarity, pluralism, migration, languages and Europe: these are the themes used by the BELvue Museum to help you to discover Belgium. Each one is developed through present-day testimonials and then traced right through history. This is a modern, original way of gaining a fuller understanding of modern-day Belgium.\r\nHave a look at the gallery too: there are more than 200 objects to view, each one forming a tangible memory of Belgium. Here are just a few examples: a lithograph by Magritte, a motorcycle, crystal vases by Val Saint-Lambert, and a football signed by the Red Devils. The very essence of Belgian-ness!\r\n\r\nSpeciale openingstijden op schoolvakanties en feestdagen 9.30 tot 17.00 uur\r\n24\/12 en 31\/12 9u30 tot 16u00\r\nHet BELvue Museum is elke woensdag vanaf 14u en de eerste zondag van de maand gratis toegankelijk.\r\n","description_print":null,"booking_url":"https:\/\/www.ticketing.brussels\/en\/tickets\/event-details.BELvue-Museum.49937124-48cf-411f-a59c-8cac972ead6d","sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Museo BELvue","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@belvue.be","website":"http:\/\/www.belvue.be","phone_contact":"+32 2 545 08 00","phone_booking":"+32 2 500 45 54","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"Nel Museo BELvue, grazie a numerosi documenti, i visitatori potranno scoprire i grandi periodi della storia del Belgio.\u00a0...\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"mus\u00e9e BELvue","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@belvue.be","website":"http:\/\/www.belvue.be","phone_contact":"+32 2 545 08 00","phone_booking":"+32 2 500 45 54","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"mus\u00e9e BELvue","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@belvue.be","website":"http:\/\/www.belvue.be","phone_contact":"+32 2 545 08 00","phone_booking":"+32 2 500 45 54","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"Se pr\u00e9sentant comme le mus\u00e9e de la Belgique et de son histoire, mais \u00e9galement comme \u00ab centre pour la d\u00e9mocratie \u00bb, l\u2019\u00e9tablissement b\u00e9n\u00e9ficie d\u2019une mus\u00e9ographie compl\u00e8tement remani\u00e9e depuis peu. D\u00e9mocratie, prosp\u00e9rit\u00e9, solidarit\u00e9, pluralisme, migrations, langues, Europe : le mus\u00e9e BELvue vous propose de d\u00e9couvrir le pays \u00e0 travers ces quelques th\u00e9matiques. L\u2019approche se veut originale, puisque chaque th\u00e9matique est d\u2019abord explicit\u00e9e \u00e0 l\u2019aide de t\u00e9moignages actuels, et ensuite contextualis\u00e9e \u00e0 travers l\u2019histoire. Plus de 200 objets composent une galerie et permettent d\u2019incarner la m\u00e9moire mat\u00e9rielle du pays. Vous y croiserez par exemple une lithographie de Magritte, des vases en cristal du Val Saint-Lambert, un costume du carnaval de Binche, ou encore un ballon sign\u00e9 par les Diables Rouges !\r\n\r\nCe b\u00e2timent, affect\u00e9 initialement \u00e0 l\u2019usage d\u2019un h\u00f4tel, est b\u00e2ti en 1776 \u2014 et ouvert dans le courant de l\u2019ann\u00e9e suivante \u2014 dans un p\u00f4le \u00e0 vocation touristique, commercial (difficile \u00e0 s\u2019imaginer aujourd\u2019hui !), et tr\u00e8s cosmopolite (l\u2019h\u00f4tel Astoria, rue Royale, en demeure le seul t\u00e9moin actuel). L\u2019\u00e9tablissement recevait essentiellement des touristes, en majorit\u00e9 anglais, mais pas n\u2019importe quels touristes : il s\u2019agit d\u2019une h\u00f4tellerie de luxe, avec des clients prestigieux.\r\n\r\nDe style n\u00e9oclassique, comme l\u2019ensemble de la place Royale, le b\u00e2timent privil\u00e9gie la sobri\u00e9t\u00e9 et les proportions harmonieuses. La visite int\u00e9rieure vous offrira davantage de d\u00e9tails sur le d\u00e9cor.\r\n\r\nLe Parc de Bruxelles constituait un p\u00f4le d\u2019attraction pour les touristes : la promenade mondaine est en effet une occupation de choix. \u00ab De midi \u00e0 une heure, cette promenade devient ordinairement le rendez-vous des \u00e9trangers et des gens riches. Cette mac\u00e9doine de nations qu\u2019on y rencontre \u00e9gaie quelques heures par jour cet endroit. \u00bb\r\nSi globalement, les relations du Bellevue avec son illustre voisin \u2014 le palais royal \u2014 restent bonnes, l\u2019h\u00f4tel h\u00e9bergeant m\u00eame souvent des invit\u00e9s de marque susceptibles d\u2019une entrevue royale, quelques frictions ont pu appara\u00eetre, notamment \u00e0 cause de la construction de terrasses adjacentes \u00e0 l\u2019\u00e9tablissement, et donnant une vue magnifique sur les jardins du roi, ce qui n\u2019\u00e9tait pas tr\u00e8s au go\u00fbt de L\u00e9opold II\u2026\r\n\r\nHoraire exceptionnel les jours de vacances scolaires et le jours f\u00e9ri\u00e9s 9h30 \u00e0 17h\r\nLe 24\/12 et le 31\/12 9h30 \u00e0 16:00\r\nL'entr\u00e9e au mus\u00e9e BELvue est gratuite tous les mercredis \u00e0 partir de 14 heures et le 1er dimanche du mois","description_print":null,"booking_url":"https:\/\/www.ticketing.brussels\/fr\/tickets\/event-details.Musee-BELvue.49937124-48cf-411f-a59c-8cac972ead6d","sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Museo BELvue","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@belvue.be","website":"http:\/\/www.belvue.be","phone_contact":"+32 2 545 08 00","phone_booking":"+32 2 500 45 54","address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"Conocido como el museo de B\u00e9lgica y su historia, pero tambi\u00e9n como \"centro para la democracia\", el establecimiento posee una museograf\u00eda completamente redise\u00f1ada desde hace poco. Democracia, prosperidad, solidaridad, pluralismo, migraciones, idiomas, Europa: El museo BELvue te propone descubrir el pa\u00eds a trav\u00e9s de diferentes tem\u00e1ticas. El enfoque es original, ya que cada tem\u00e1tica se explica en primer lugar con la ayuda de testimonios actuales y a continuaci\u00f3n es contextualizada a trav\u00e9s de la historia. M\u00e1s de 200 objetos componen una galer\u00eda para encarnar la memoria material del pa\u00eds. Encontrar\u00e1s, por ejemplo, una litograf\u00eda de Magritte, los vasos de cristal de Val Saint-Lambert, un disfraz del carnaval de Binche, \u00a1Y un bal\u00f3n firmado por los Diablos Rojos!\r\nEste edificio, originalmente utilizado como hotel, se construy\u00f3 en 1776 \u2014 y fue abierto durante el transcurso del a\u00f1o siguiente \u2014 como un centro de car\u00e1cter tur\u00edstico, comercial y muy cosmopolita. El establecimiento recibe esencialmente turistas, en su mayor\u00eda ingleses, pero no cualquier turista: se trata de un hospedaje de lujo, con clientes prestigiosos. De estilo neocl\u00e1sico, como el conjunto de la Place Royale, el edificio favorece la sobriedad y las proporciones armoniosas. La vista interior te ofrecer\u00e1 m\u00e1s detalles del decorado.\r\nEl Parque de Bruselas constituye un centro de atracci\u00f3n para los turistas: esta visita al parque es en efecto una excelente actividad a elegir. \"Entre media hora y una hora, este paseo se convierte generalmente en un punto de reuni\u00f3n para la diversidad, desde extranjeros hasta gente rica. Esta macedonia de nacionalidades que encontramos enriquece el ambiente del lugar\".\r\nSi las relaciones entre Bellevue y su ilustre vecino - el Palacio Real - siguen siendo buenas, el hotel hospeda a menudo a distinguidos invitados de entrevista real. Pueden haber surgido ciertos roces especialmente a causa de la contrucci\u00f3n de terrazas adyacentes al establecimiento, proporcionando una magn\u00edfica vista al Real Jard\u00edn de las Plantas Medicinales, el cual no era del agrado de Leopoldo ll.\r\nV\u00e9ase el folleto sobre la historia del edificio disponible en el lugar.\r\n\r\nLa entrada al museo BELvue es gratuita todos los mi\u00e9rcoles a partir de las 14:00.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"BELvue museum","address_street_name":"Paleizenplein","address_street_number":"7","address_street_box":null,"email":"info@belvue.be","website":"http:\/\/www.belvue.be","phone_contact":"+32 2 545 08 00","phone_booking":"+32 2 500 45 54","address_zip":"1000","address_city":"Bruxelles","address_line1":"Paleizenplein, 7","address_line2":"1000 Bruxelles","description_web":"Frieten, bier, chocolade\u2026 maar Belgi\u00eb is toch wel meer dan dat, nietwaar? Democratie, welvaart, solidariteit, pluralisme, migratie, taal, Europa: dat zijn de thema\u2019s die het BELvue museum jullie voorstelt om kennis te maken met het land! Elk thema wordt uitgewerkt aan de hand van hedendaagse getuigenissen en vervolgens toegelicht doorheen de geschiedenis. Een eigentijdse en originele manier om een beter inzicht te verwerven in het Belgi\u00eb van vandaag.\r\nNeem zeker ook een kijkje in de galerij: daar staan meer dan 200 voorwerpen opgesteld die het materi\u00eble geheugen van Belgi\u00eb vormen. Je kunt er onder andere de volgende zaken bewonderen: een lithografie van Magritte, een motorfiets, kristallen vazen van Val Saint-Lambert, en een bal met de handtekeningen van de Rode Duivels erop. Een verzameling met een hoog Belgi\u00ebgehalte!\r\n\r\nElke woensdag vanaf 14.00 uur is het BELvue museum gratis toegankelijk.\r\nMaandag open voor groepen en scholen op reservering van 09:30 tot 17:00\r\n","description_print":null,"booking_url":"https:\/\/www.ticketing.brussels\/nl\/tickets\/event-details.BELvue-museum.49937124-48cf-411f-a59c-8cac972ead6d","sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":1250,"location":{"lat":50.8426107,"lon":4.3606882},"last_updated_at":"2024-01-31T10:06:01+01:00","published_at":"2013-10-