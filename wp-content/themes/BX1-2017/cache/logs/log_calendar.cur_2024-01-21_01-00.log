scr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.uccle.be","email":"culture@uccle.brussels","phone_contact":"+32 2 605 15 30","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50005902"},"pt":{"name":"\u00ab Absolute Beginner \u00bb de Laure Hassel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.uccle.be","email":"culture@uccle.brussels","phone_contact":"+32 2 605 15 30","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50005902"},"en":{"name":"\u00ab Absolute Beginner \u00bb de Laure Hassel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.uccle.be","email":"culture@uccle.brussels","phone_contact":"+32 2 605 15 30","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50005902"},"it":{"name":"\u00ab Absolute Beginner \u00bb de Laure Hassel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.uccle.be","email":"culture@uccle.brussels","phone_contact":"+32 2 605 15 30","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50005902"},"cn":{"name":"\u00ab Absolute Beginner \u00bb de Laure Hassel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.uccle.be","email":"culture@uccle.brussels","phone_contact":"+32 2 605 15 30","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50005902"},"fr":{"name":"\u00ab Absolute Beginner \u00bb de Laure Hassel","shortdescr":"Peintures, installations et vid\u00e9o.","longdescr":"Laure Hassel, sc\u00e9nographe de formation et artiste pluridisciplinaire, vous invite dans son univers tr\u00e8s personnel. \u00c0 travers une trame narrative, inspir\u00e9e d\u2019une exp\u00e9rience de vie avec la nature comme fil rouge m\u00e9taphorique, le travail de l\u2019artiste nous rappelle que tout est toujours un (re)commencement. Avec ses installations et ses peintures grand format, Laure Hassel s\u2019emploie \u00e0 faire ressurgir et \u00e9merger \u00e9motions et souvenirs, et nous raconte des histoires personnelles au moyen d\u2019assemblages et de d\u00e9tournements. Comme en exploration dans un monde parall\u00e8le qui s\u2019inscrit de mani\u00e8re invisible entre les lignes, elle expose le r\u00e9el dans une mise en sc\u00e8ne sensible, \u00e0 fleur de peau.\n\nQuand ? Du vendredi 12 au dimanche 28 janvier 2024, ouvert du jeudi au dimanche de 11h00 \u00e0 17h00. Vernissage le jeudi 11 janvier de 18h30 \u00e0 21h00.\nO\u00f9 ? \u00c0 la Maison des Arts d\u2019Uccle ( rue du Doyenn\u00e9 102).\nCo\u00fbt ? Entr\u00e9e libre.\nInfos ? 02\/605.15.30 ou culture@uccle.brussels","performers":"Laure Hassel","boxoffice_url":null,"website":"http:\/\/www.uccle.be","email":"culture@uccle.brussels","phone_contact":"+32 2 605 15 30","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50005902"},"sp":{"name":"\u00ab Absolute Beginner \u00bb de Laure Hassel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.uccle.be","email":"culture@uccle.brussels","phone_contact":"+32 2 605 15 30","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50005902"},"nl":{"name":"\u00ab Absolute Beginner \u00bb van Laure Hassel","shortdescr":"Schilderijen, installaties, video","longdescr":"Laure Hassel, decorontwerpster van opleiding en multidisciplinair kunstenares, nodigt je uit in haar zeer persoonlijke wereld. Aan de hand van een verhaallijn, ge\u00efnspireerd op een levenservaring met de natuur als metaforische rode draad, herinnert het werk van de kunstenares ons eraan dat alles steeds een (nieuw) begin is. Met haar installaties en grote schilderijen haalt Laure Hassel emoties en herinneringen opnieuw tevoorschijn en vertelt ze ons persoonlijke verhalen aan de hand van assemblages en verdraaiingen. Op verkenning in een alternatieve wereld, onzichtbaar tussen de lijnen, stelt ze de werkelijkheid voor in een gevoelige en prikkelbare setting.\n\nWanneer? Van vrijdag 12 tot zondag 28 januari 2024, van donderdag tot zondag van 11 tot 17 uur. Vernissage op donderdag 11 januari van 18.30 tot 21.00 uur.\nWaar? In het Kunstenhuis Ukkel ( Dekenijstraat 102).\nPrijs? Vrije toegang.\nInfo? 02\/605.15.30 of  cultuur@ukkel.brussels","performers":null,"boxoffice_url":null,"website":"http:\/\/www.uccle.be","email":"culture@uccle.brussels","phone_contact":"+32 2 605 15 30","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50005902"}},"place":{"id":243015,"translations":{"de":{"name":"Le Doyenn\u00e9, Maison des Arts d\u2019Uccle","address_street_name":"Rue du Doyenn\u00e9","address_street_number":"102","address_street_box":null,"email":null,"website":null,"phone_contact":"+32 2 345 14 69","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Rue du Doyenn\u00e9, 102","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Le Doyenn\u00e9, Maison des Arts d\u2019Uccle","address_street_name":"Rue du Doyenn\u00e9","address_street_number":"102","address_street_box":null,"email":null,"website":null,"phone_contact":"+32 2 345 14 69","phone_booking":null,"address_zip":"1180","address_city":"Uccle","address_line1":"Rue du Doyenn\u00e9, 102","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Le Doyenn\u00e9, Maison des Arts d\u2019Uccle","address_street_name":"Rue du Doyenn\u00e9","address_street_number":"102","address_street_box":null,"email":null,"website":null