d":5700004566,"date_start":"2025-02-11","date_end":"2025-02-11","date_next":"2025-02-11","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_pay_as_you_can":false,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2024-12-28T17:52:01+01:00","published_at":"2024-12-12T15:44:27+01:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":314245,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"concert","ranking":1.2599210498948732,"languages":{"spoken":["fr"],"subtitles":[]},"categories":{"main":{"id":1,"translations":{"de":"Konzert","pt":null,"en":"Concert","it":"Concerti","cn":null,"fr":"Concert","sp":"Concierto","nl":"Concert"}},"others":{"list":[10,4],"translations":{"de":["Jazz & Blues","Pop, Rock, Jazz..."],"pt":[null,null],"en":["Jazz & Blues","Pop, rock, jazz\u2026"],"it":["Jazz e Blues","Pop, rock, jazz\u2026"],"cn":[null,null],"fr":["Jazz & Blues","Pop, rock, jazz\u2026"],"sp":["Jazz y blues","Pop, rock, jazz\u2026"],"nl":["Jazz & Blues","Pop, rock, jazz\u2026"]}}},"translations":{"de":{"name":"X Expender","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lejacquesfranck.be\/event\/x-expender\/2025-02-11\/","email":"info@lejacquesfranck.be","phone_contact":"+32 2 538 90 20","phone_booking":"+32 2 538 90 20","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700004566"},"pt":{"name":"X Expender","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lejacquesfranck.be\/event\/x-expender\/2025-02-11\/","email":"info@lejacquesfranck.be","phone_contact":"+32 2 538 90 20","phone_booking":"+32 2 538 90 20","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700004566"},"en":{"name":"X Expender","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lejacquesfranck.be\/event\/x-expender\/2025-02-11\/","email":"info@lejacquesfranck.be","phone_contact":"+32 2 538 90 20","phone_booking":"+32 2 538 90 20","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700004566"},"it":{"name":"X Expender","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lejacquesfranck.be\/event\/x-expender\/2025-02-11\/","email":"info@lejacquesfranck.be","phone_contact":"+32 2 538 90 20","phone_booking":"+32 2 538 90 20","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700004566"},"cn":{"name":"X Expender","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lejacquesfranck.be\/event\/x-expender\/2025-02-11\/","email":"info@lejacquesfranck.be","phone_contact":"+32 2 538 90 20","phone_booking":"+32 2 538 90 20","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700004566"},"fr":{"name":"X Expender","shortdescr":"Soutenez le premier concert des Expenders !\n\nLe nouveau projet x expender prend forme d\u00e8s 2024, au carrefour d\u2019exp\u00e9riences diverses.\n\n","longdescr":"- KOBA [1991\/Jan Rzewski saxo soprano, Jean-Yves Evrard guitare \u00e9lectrique, Jean Kowalski drums, Baudouin de Jaer basse].\n- Les rencontres avec BLURT\/Ted Milton [1993],\n- L'Op\u00e9ra DEJAER\/ARCAS [2012-2023] La for\u00eat, le D\u00e9sert- ce qui vit en nous -\n- Th\u00e9\u00e2tre de la BALSAMINE et CAV&MA Namur, et la d\u00e9couverte des instruments cor\u00e9ens [tout particuli\u00e8rement le Geomungo, la cithare basse \u00e0 six cordes jou\u00e9es au plectre\/5 CD chez SUB ROSA].\n\nPour cette raison Baudouin de Jaer rassemble les musiciens de jazz Achille Gabry et L\u00e9o Chupin, \u00e9l\u00e8ves du Conservatoire de Bruxelles, le saxophoniste compositeur et improvisateur Jan Rzewki, le pianiste compositeur et improvisateur Fabian Coomans (musique contemporaine) et la mezzo-soprano lyrique Marie-Juliette Ghazarian actuellement \u00e0 la Chapelle Reine \u00c9lisabeth.\n\nLes choix des textes dits et chant\u00e9s sont multiples : John Steinberg, William Burroughs, Jon Fosse, le po\u00e8te belge Albert Giraud, St\u00e9phane Arcas, des textes trouv\u00e9s sur Internet, des extraits de manuel de physique des particules et des modes d'emploi d\u2019instruments m\u00e9nagers.\n\nx expender porte \u00e9galement des textes de jeunes auteurices : l'Oreille du jour \u00e9crit par trois jeunes adolescentes d'une Ath\u00e9n\u00e9e de Bruxelles centre : une r\u00e9v\u00e9lation, l\u2019essence du futur dans les textes extraordinaires que plusieurs ados ont \u00e0 nous transmettre ! x expender porterait alors diff\u00e9rents textes de jeunes auteurices, mais aussi de cuisinier\u00b7es, de d\u00e9tenu\u00b7es, d\u2019instituteurices : des gens que nous sommes.\n\nTravaill\u00e9es ind\u00e9pendamment, la vingtaine de compositions sont reli\u00e9es par un fil invisible : sujets classiques tel que Terre, nature, plan\u00e8te, sport, humain, de l\u2019amour [et STOP les guerres], et donc la pr\u00e9vention [sportive et artistique] [le plaisir] l\u2019\u00e9coute, la physique quantique, l\u2019espace-temps, la spontan\u00e9it\u00e9, la diversit\u00e9. Nous reprenons quatre compositions de KOBA {J\u2019essaye Jan Rweski et trois compositions de Jean-Yves Evrard}, deux airs de Purcell. Contrast\u00e9es dans leur structure, leur longueur, leur contenu, leur orchestration, certaines g\u00e9om\u00e9triques d\u2019autres lyriques, les musiques \u00e9crites, [parsem\u00e9es d\u2019improvisations cibl\u00e9es] impliquent des m\u00e9langes de styles, des croisements de citations interpr\u00e9t\u00e9s par des musicien\u00b7nes de diff\u00e9rents horizons.\n\n","performers":"Marie-Juliette Ghazarian : voix [mezzo-soprano]\nAchille Gabry : drums\nL\u00e9o Chupin : basse\nJan Rzewski : saxo soprano\nFabian Coomans : clavier\nBaudouin de Jaer : trompette\nVisuel : J-Y Le Docte ","boxoffice_url":null,"website":"https:\/\/lejacquesfranck.be\/event\/x-expender\/2025-02-11\/","email":"info@lejacquesfranck.be","phone_contact":"+32 2 538 90 20","phone_booking":"+32 2 538 90 20","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700004566"},"sp":{"name":"X Expender","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lejacquesfranck.be\/event\/x-expender\/2025-02-11\/","email":"info@lejacquesfranck.be","phone_contact":"+32 2 538 90 20","phone_booking":"+32 2 538 90 20","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700004566"},"nl":{"name":"X Expender","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/lejacquesfranck.be\/event\/x-expender\/2025-02-11\/","email":"info@lejacquesfranck.be","phone_contact":"+32 2 538 90 20","phone_booking":"+32 2 538 90 20","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700004566"}},"place":{"id":4,"translations":{"de":{"name":"Centre Culturel Jacques Franck","address_street_name":"Chauss\u00e9e de Waterloo","address_street_number":"94","address_street_box":null,"email":"info@lejacquesfranck.be","website":"http:\/\/www.lejacquesfranck.be","phone_contact":"+32 2 538 90 20","phone_booking":"+32 2 538 90 20","address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Chauss\u00e9e de Waterloo, 94","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Centre Culturel Jacques Franck","address_street_name":"Chauss\u00e9e de Waterloo","address_street_number":"94","address_street_box":null,"email":"info@lejacquesfranck.be","website":"http:\/\/www.lejacquesfranck.be","phone_c