null,"boxoffice_url":null,"website":"https:\/\/catchart.be\/experiences\/","email":"contact@catchart.be","phone_contact":"+32 486 77 68 30","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50008825"},"cn":{"name":"\"Les formes de la nature\"  exposition des artistes Roubens et Benjamin Hendlisz","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/catchart.be\/experiences\/","email":"contact@catchart.be","phone_contact":"+32 486 77 68 30","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50008825"},"fr":{"name":"\"Les formes de la nature\"  exposition des artistes Roubens et Benjamin Hendlisz","shortdescr":"\"Les Formes de la Nature\", met en vedette les \u0153uvres des artistes Adrien Roubens et Benjamin Hendlisz. Une invitation \u00e0 vous immerger dans un univers contemplatif de paysages, de mati\u00e8res min\u00e9rales et v\u00e9g\u00e9tales. Un lien entre des sujets intemporels et des oeuvres contemporaines. Les deux artistes ont leurs styles propres mais ont l\u2019habitude de travailler ensemble \u00e0 l\u2019habillage harmonieux de lieux.","longdescr":"\"Les Formes de la Nature\", met en vedette les \u0153uvres des artistes Adrien Roubens et Benjamin Hendlisz. Une invitation \u00e0 vous immerger dans un univers contemplatif de paysages, de mati\u00e8res min\u00e9rales et v\u00e9g\u00e9tales. Un lien entre des sujets intemporels et des oeuvres contemporaines. Les deux artistes ont leurs styles propres mais ont l\u2019habitude de travailler ensemble \u00e0 l\u2019habillage harmonieux de lieux. Des oeuvres sur toile\u2026. mais aussi d\u2019autres surprises en terme de support vous attendront sur place.","performers":"Roubens ; Benjamin Hendlisz ","boxoffice_url":null,"website":"https:\/\/catchart.be\/experiences\/","email":"contact@catchart.be","phone_contact":"+32 486 77 68 30","phone_booking":null,"agenda_url":"https:\/\/visi