impaired people","Assistance dogs","Accessible to pedestrians with mobility aids","Adapted toilet"]}},"facebook_link":null,"publication_state":"public","last_updated_at":"2022-11-17T01:06:54+01:00","published_at":"2022-10-06T12:49:27+02:00","backoffice_id":263605,"import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":0.37641441155241},{"id":543962,"date_start":"2022-11-15","date_end":"2022-12-03","date_next":"2022-11-17","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":true,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition","de":"Ausstellung"}},"others":{"list":[24,29],"translations":{"fr":["Galeries d'art","Installation"],"nl":["Galeries","Installatiekunst"],"en":["Art Galleries","Installation"],"de":["Kunstgalerien","Installation"]}}},"languages":{"spoken":["fr","nl"],"subtitles":[]},"translations":{"fr":{"name":"Identit\u00e9s en partage","shortdescr":"Ina Lichtenberg ouvre la porte de ses mondes int\u00e9rieurs au travers des bo\u00eetes ou \u00ab assemblages \u00bb sous verres, terriblement intimistes.","longdescr":"Comme les langues, transmises sur le parcours familial, qu\u2019elle collectionne et pratique en polyglotte hors pair, Ina Lichtenberg ramasse et r\u00e9cup\u00e8re des objets pour donner vie \u00e0 des bo\u00eetes \u00e0 souvenirs. \r\n\r\nCes objets sont assembl\u00e9s, coll\u00e9s, for\u00e9s, peints, \u00ab mis en bo\u00eete \u00bb comme autant de m\u00e9tamorphoses de la mati\u00e8re. \r\nIssues d'une r\u00eaverie au caract\u00e8re fortement nostalgique et autobiographiques, ces bo\u00eetes rel\u00e8vent d'une sc\u00e9nographie intime profond\u00e9ment enracin\u00e9e dans le v\u00e9cu de l'artiste. V\u00e9ritables t\u00e9moins de l\u2019inconscient, presque reliquaires, constitu\u00e9es d'objets r\u00e9cup\u00e9r\u00e9s pour leur forme, leur valeur symbolique ou esth\u00e9tique mais aussi d\u2019\u00e9l\u00e9ments organiques, de photographies, etc., les boites donnent libre cours \u00e0 une po\u00e9tique formelle et m\u00e9taphorique d'inspiration existentialiste.\r\n\r\nGratuit.\r\nVisite libre de l'exposition pendant les heures d\u2019ouverture de la Maison Communale et des biblioth\u00e8ques communales du 15 novembre au 3 d\u00e9cembre 2022","performers":null,"boxoffice_url":null,"website":null,"email":"ddo@evere.brussels","phone_contact":"+32 2 563 60 65","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.543962"},"nl":{"name":"Identit\u00e9s en partage","shortdescr":"Ina Lichtenberg geeft een inkijk in haar innerlijk leven via dozen of \u2018assemblages\u2019 onder glazen, bijzonder intimistisch.","longdescr":"Net als de talen, die haar werden doorgegeven via het parcours van haar familie, en die zij verzamelt en beoefent als geen ander, zo verzamelt en recupereert Ina Lichtenberg objecten om herinneringsdozen leven in te blazen. \r\nDeze objecten worden geassembleerd, gelijmd, geboord, geschilderd, \u2018in een doos geplaatst\u2019, als evenveel metamorfosen van het materiaal. \r\nDeze dozen zijn het resultaat van een sterk nostalgische en autobiografische mijmering, een intieme scenografie die diep geworteld is in het leven van de kunstenares. Als echte getuigen van het onbewuste, bijna relikwie\u00ebn, samengesteld uit objecten die zijn gerecupereerd om hun vorm, hun symbolische of esthetische waarde, maar ook uit organische elementen, foto's, enz., laten de dozen een formele en metaforische po\u00ebtiek van existentialistische inspiratie de vrije loop.\r\n\r\nGratis\r\nDe tentoonstelling kan vrij worden bezocht tijdens de openingsuren van het gemeentehuis en de gemeentelijke bibliotheken van 15 november tot 3 december 2022.","performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.543962"},"en":{"name":"Identit\u00e9s en partage","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.543962"},"de":{"name":"Identit\u00e9s en partage","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.543962"},"it":{"name":"Identit\u00e9s en partage","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.543962"},"sp":{"name":"Identit\u00e9s en partage","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.543962"},"pt":{"name":"Identit\u00e9s en partage","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.543962"},"cn":{"name":"Identit\u00e9s en partage","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.543962"}},"place":{"id":206581,"translations":{"fr":{"name":"Administration communale d'Evere","address_street_name":"Sq Servaas Hoedemaekers","address_street_number":"10","address_street_box":null,"email":"info@evere.brussels","website":"http: