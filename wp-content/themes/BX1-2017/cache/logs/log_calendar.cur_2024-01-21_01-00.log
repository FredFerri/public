s_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":288381,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.2342968954944761,"languages":{"spoken":["nl","fr"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[36],"translations":{"de":["Museen & Kunstzentren"],"pt":[null],"en":["Museums and art centers"],"it":["Musei e centri artistici"],"cn":[null],"fr":["Mus\u00e9es et art centers"],"sp":["Museos y centros de arte"],"nl":["Musea en kunstcentra"]}}},"translations":{"de":{"name":"Giants","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.naturalsciences.be","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50004087"},"pt":{"name":"Giants","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.naturalsciences.be","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50004087"},"en":{"name":"Giants","shortdescr":"A big opportunity to feel small\nThey all roamed the earth after the dinosaurs. Do you know about them ?\nMeet eleven animals of spectacular proportions.\nExplore the lives of these giants. Who were they ? Why did they go extinct ?\nThey have since been replaced by other giant animals...bur for how much longer ?\nAn exhibition for families and school groups (9+years old)","longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.naturalsciences.be","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50004087"},"it":{"name":"Giants","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.naturalsciences.be","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50004087"},"cn":{"name":"Giants","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.naturalsciences.be","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50004087"},"fr":{"name":"Giants","shortdescr":"Une grande occasion de se sentir tout petit\nIls ont tous v\u00e9cu sur Terre apr\u00e8s les dinosaures. \nRencontrez-y onze animaux aux dimensions spectaculaires \nExplorez la vie de ces g\u00e9ants. Qui sont-ils ? Quelles sont les raisons de leur extinction ? \nD\u2019autres g\u00e9ants les ont remplac\u00e9s depuis\u2026 mais pour combien de temps encore ?\nUne exposition pour un public familial et scolaire \u00e0 partir de 9 ans\n","longdescr":"Une grande occasion de se sentir tout petit\nIls ont tous v\u00e9cu sur Terre apr\u00e8s les dinosaures. Les connaissez-vous ?\nIl y a 66 millions d\u2019ann\u00e9es, l\u2019impact d\u2019une m\u00e9t\u00e9orite provoquait l\u2019extinction d\u2019innombrables esp\u00e8ces animales : dinosaures, pl\u00e9siosaures, mosasaures, etc. Une chance pour certains petits animaux qui, jusqu\u2019alors, avaient v\u00e9cu dans l\u2019ombre des grands ! Ils se diversifient et certains d\u2019entre eux grandissent parfois jusqu\u2019\u00e0 atteindre des tailles gigantesques.\nGIANTS vous invite \u00e0 un voyage dans le temps, du Pal\u00e9og\u00e8ne au Quaternaire. Rencontrez-y onze animaux aux dimensions spectaculaires comme Otodus megalodon, le plus puissant des requins de tous les temps, et Gigantopithecus blacki, le singe asiatique dont la taille \u00e9quivaut \u00e0 trois orangs-outangs. \nAdmirez 6 repr\u00e9sentations animales 3D \u00e0 taille r\u00e9elle et 5 squelettes (presque) complets, et tel un pal\u00e9ontologue, menez vos propres recherches avec les interactifs et images multim\u00e9dias. Explorez la vie de ces g\u00e9ants. Qui sont-ils ? Quels avantages leur procurait leur grande taille ? Quelles sont les raisons de leur extinction ? \nD\u2019autres g\u00e9ants les ont remplac\u00e9s depuis\u2026 mais pour combien de temps encore ?\nUne exposition pour un public familial et scolaire \u00e0 partir de 9 ans\n","performers":null,"boxoffice_url":null,"website":"http:\/\/www.naturalsciences.be","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50004087"},"sp":{"name":"Giants","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.naturalsciences.be","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50004087"},"nl":{"name":"Giants","shortdescr":"Een reuzenkans om je klein te voelen\nZe leefden na de dinosauri\u00ebrs. Ken jij ze?\nOntmoet elf spectaculair grote dieren.\nVerken het leven van deze reuzen. Wie waren ze? Wat waren de voordelen van hun grote omvang?\nSindsdien zijn ze vervangen door andere gigantische dieren... maar voor hoe lang nog? \nVoor gezinnen en scholen (vanaf 9 jaar).\n","longdescr":"EEN REUZENKANS OM JE KLEIN TE VOELEN\nEen reuzenkans om je klein te voelen\nSmilodon, Paraceratherium, Megatherium \u2026\nZe leefden na de dinosauri\u00ebrs. Ken jij ze?\n\n66 miljoen jaar geleden veroorzaakte een meteorietinslag het uitsterven van talloze diersoorten: dinosauri\u00ebrs, plesiosauri\u00ebrs, mosasauri\u00ebrs en vele andere. Dit cre\u00eberde kansen voor sommige van de kleine dieren die tot dan toe in de schaduw van de grote jongens hadden geleefd! Ze diversifieerden en sommige werden zelfs gigantisch groot.\nMet GIANTS kan je terugkeren in de tijd, van het Paleogeen tot het Kwartair. Ontmoet elf spectaculair grote dieren zoals Otodus megalodon, de machtigste haai die ooit heeft bestaan, en Gigantopithecus blacki, de Aziatische aap zo groot als drie orang-oetans.\nBewonder 6 levensgrote 3D-diervoorstellingen en 5 (bijna) complete skeletten, en voer als een paleontoloog je eigen onderzoek uit met behulp van de interactieve elementen en multimediale beelden. Verken het leven van deze reuzen. Wie waren ze? Wat waren de voordelen van hun grote omvang? En waarom zijn ze uitgestorven? \nSindsdien zijn ze vervangen door andere gigantische dieren... maar voor hoe lang nog? Veel huidige reuzen \u2013 denk maar aan olifanten, neushoorns en walvissen - staan onder druk\u2026 \nVoor gezinnen en scholen (vanaf 9 jaar).\n","performers":null,"boxoffice_url":null,"website":"http:\/\/www.naturalsciences.be","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50004087"}},"place":{"id":47,"translations":{"de":{"name":"Institut f\u00fcr Naturwissenschaften","address_street_name":"Rue Vautier","address_street_number":"29","address_street_box":null,"email":"info@naturalsciences.be","website":"https:\/\/www.naturalsciences.be\/de","phone_contact":"+32 2 627 42 11","phone_booking":"+32 2 627 42 34","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Vautier, 29","address_line2":"1000 Bruxelles","description_web":null,"description_print":"22\/06\/2022\r\nNaturwissenschaften und Naturgeschichte hautnah im Br\u00fcsseler Museum f\u00fcr Naturwissenschaften mit der gr\u00f6\u00dften Dinosaurierausstellung Europas\r\n\r\nVon den Dinosauriern bis zum Menschen: Lust, einem Mammut in den R\u00fcssel zu schauen, einem Dinosaurier tief in die Augen zu blicken oder in die Haut eines Neandertalers zu schl\u00fcpfen? Das Museum f\u00fcr Naturwissenschaften steckt voller Leben... und voller \u00dcberraschungen. \r\n\r\nDie gr\u00f6\u00dfte Dinosaurierausstellung Europas: Die Dinosauriergalerie mit mehr als drei\u00dfig vollst\u00e4ndigen Skeletten und zahlreichen Dinosaurierfragmenten ist die gr\u00f6\u00dfte Dinosaurierausstellung Europas. Nebenbei erf\u00e4hrt man interessante Details aus dem Leben - und Sterben - der Dinosaurier...\r\n\r\nNeuheiten: Die \u201eGalerie de l'Homme\": Neuste Attraktion ist die \u201eGalerie de l'Homme\" - die Galerie des Menschen, die einen faszinierenden Einblick in 7 Millionen Jahre Menschheitsgeschichte gibt. Vom Embryo zum Erwachsenen - entdecken Sie die Entwicklung und die Evolution bis zum modernen Menschen oder den menschlichen K\u00f6rper und seine Funktionsweise anhand von Fossiliensammlungen, 3D-Nachbildungen und interaktiven Pr\u00e4sentationen. \r\n\r\nDer Mosasaurier-Saal: Die Mosasaurier waren in der Oberkreide eine weltweit verbreitete Gruppe von Meeresreptilien. In dem neuen Saal, der sich unterhalb der Dinosaurier-Galerie befindet, haben Sie Gelegenheit, diese \u201eurzeitlichen K\u00f6nige der Meere\" zu bewundern.\r\n\r\nLeibliches Wohl:\r\n\r\nDer Magen knurrt, die Zunge ist trocken? G\u00f6nnen Sie sich eine kleine Pause im Dino Caf\u00e9.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Instituto das Ci\u00eancias Naturais","address_street_name":"Rue Vautier","address_street_number":"29","address_street_box":null,"email":"info@naturalsciences.be","website":"http:\/\/www.naturalsciences.be","phone_contact":"+32 2 627 42 11","phone_booking":"+32 2 627 42 34","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Vautier, 29","address_line2":"1000 Bruxelles","description_web":null,"description_print":"22\/06\/2022\r\nExplore a evolu\u00e7\u00e3o do ser humano e do seu corpo \u2013 do Sahelanthropus ao Homo sapiens, do embri\u00e3o ao adulto \u2013 tudo na nova Galeria do Ser Humano \u2013 a nossa evolu\u00e7\u00e3o, o nosso corpo.\r\nMas n\u00e3o \u00e9 tudo! Pode tamb\u00e9m descobrir a maior Galeria de Dinossauros da Europa, voltar no tempo na Galeria da Evolu\u00e7\u00e3o, com os seus 1000 esp\u00e9cimes, mergulhar em conjunto com os gigantescos lagartos marinhos do Cret\u00e1ceo na Sala dos Mosassauros, embarcar num safari urbano em BiodiverCITY e descobrir a hist\u00f3ria do museu atrav\u00e9s de 14 \u201ccap\u00edtulos\u201d simb\u00f3licos de 250 anos de Ci\u00eancias Naturais. Por \u00faltimo, as salas dedicadas aos Minerais, aos Insetos (com um viveiro, onde tar\u00e2ntulas, bichos-pau e outros vos far\u00e3o tremer) e aos Moluscos convencer-vos-\u00e3o que h\u00e1 sempre algo a descobrir nas nossas cole\u00e7\u00f5es permanentes.\r\nNavegue no site www.sciencesnaturelles.be para mais informa\u00e7\u00f5es sobre as exposi\u00e7\u00f5es tempor\u00e1rias","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Institute of Natural Sciences","address_street_name":"Vautierstraat","address_street_number":"29","address_street_box":null,"email":"info@naturalsciences.be","website":"http:\/\/www.naturalsciences.be","phone_contact":"+32 2 627 42 11","phone_booking":"+32 2 627 42 52","address_zip":"1000","address_city":"Bruxelles","address_line1":"Vautierstraat, 29","address_line2":"1000 Bruxelles","description_web":"The Institute of Natural Sciences: a great day out, naturally!\n\nIn the largest Dinosaur Gallery in Europe, you can meet the famous Bernissart Iguanodons, T.rex, Triceratops, Diplodocus, and 34 other species.\nBut that\u2019s not all!\n\nThe Earth is swarming with life - rediscover it in the new Gallery, Living Planet, through an aesthetic, family-friendly and scientific approach to biodiversity. Learn about the human body and how we evolved in the Gallery of Humankind and go back in time in the Gallery of Evolution. You can also find out about urban species in BiodiverCITY, discover 250 years of the history of Natural Sciences through 14 iconic specimens, beware of the kings of the Cretaceous seas in the Mosasaur Hall or admire the magnificent crystals in the Mineral Hall.\n\nAnd last but not least, don't miss the temporary exhibitions and all the activities of the Educational Service: more information at www.naturalsciences.be.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Istituto di Scienze Naturali","address_street_name":"Rue Vautier","address_street_number":"29","address_street_box":null,"email":"info@naturalsciences.be","website":"https:\/\/www.naturalsciences.be\/","phone_contact":"+32 2 627 42 11","phone_booking":"+32 2 627 42 34","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Vautier, 29","address_line2":"1000 Bruxelles","description_web":null,"description_print":"22\/06\/2022\r\nIl Museo di Scienze naturali di Bruxelles conserva la pi\u00f9 importante collezione di scheletri di dinosauro d\u2019Europa, ma non solo!\r\n\r\nTroverete molti dinosauri tra cui Tirannosauri Rex, Triceratopi e Diplodochi, potrete ammirare anche la vasta collezione di fossili d\u2019Iguanodonti di inestimabile valore, di cui il Belgio \u00e8 estremamente fiero.     \r\n\r\n\r\nDa non perdere: la Nuova Galleria dell\u2019Uomo \r\n\r\nDal Sahelanthropus all'Homo sapiens, dall'embrione all'adulto: nella nuova galleria del museo potete esplorare l\u2019evoluzione dell\u2019uomo e del corpo umano. Quest\u2019area vi d\u00e0 la possibilit\u00e0 di conoscere i cambiamenti che hanno portato all\u2019uomo moderno e l\u2019evoluzione nel corso di 7 milioni di anni, attraverso fossili, video-ricostruzioni 3D, presentazioni interattive.  \r\n\r\nPer saperne di pi\u00f9 \r\n\r\n\r\n\r\nDa vedere anche:\r\n\r\nLa sala dei Mosasauri\r\nQuesta sala di recente costruzione, situata sopra la Galleria dei Dinosauri vi permetter\u00e0 di ammirare i \"re dei mari antichi\", i Mosasauri, gigantesche lucertole marine equivalente acquatico dei dinosauri. \r\n\r\nLa Galleria dei Dinosauri \r\nLa pi\u00f9 grande esposizione di Dinosauri d'Europa, con pi\u00f9 di 30 scheletri di cui alcuni interamente conservati.\r\n\r\nLa Galleria dell'Evoluzione\r\nUn'esposizione unica nel suo genere in Belgio! Circa 600 fossili e 400 animali imbalsamati a testimoniare la biodiversit\u00e0 delle specie animali di milioni di anni.\r\n\r\n250 anni di Scienze naturali\r\nUn percorso all\u2019insegna di 20 testimonianze storico-scientifiche.\r\n  \r\nBiodiverCITY\r\nQuesta sala, dedicata alla biodiversit\u00e0 cittadina, offre un'avventura urbana a grandi e piccini. Dagli 8 anni in su.\r\n","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Institut des Sciences Naturelles","address_street_name":"Rue Vautier","address_street_number":"29","address_street_box":null,"email":"info@naturalsciences.be","website":"http:\/\/www.naturalsciences.be","phone_contact":"+32 2 627 42 11","phone_booking":"+32 2 627 42 34","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Vautier, 29","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Institut des Sciences naturelles","address_street_name":"Rue Vautier","address_street_number":"29","address_street_box":null,"email":"info@naturalsciences.be","website":"http:\/\/www.naturalsciences.be","phone_contact":"+32 2 627 42 11","phone_booking":"+32 2 627 42 34","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Vautier, 29","address_line2":"1000 Bruxelles","description_web":"L'Institut des Sciences Naturelles, un incontournable pour les curieux de nature\n\nIci vous rencontrerez les fameux Iguanodons de Bernissart, T.rex, Triceratops, Diplodocus, et 34 autres esp\u00e8ces dans la plus grande Galerie de Dinosaures d\u2019Europe.\nMais ce n\u2019est pas tout ! \n\nRed\u00e9couvrez aussi notre Terre, grouillante de vie, dans une approche \u00e0 la fois esth\u00e9tique, familiale et scientifique de la biodiversit\u00e9 dans la nouvelle Galerie Plan\u00e8te Vivante . D\u00e9couvrez notre \u00e9volution et le fonctionnement de notre corps dans la Galerie de l\u2019Homme. Remontez le temps dans la Galerie de l\u2019\u00c9volution. Explorez la diversit\u00e9 des esp\u00e8ces urbaines dans BiodiverCITY. Observez des sp\u00e9cimens illustrant l\u2019histoire de l'institut au travers de 14 chapitres symboliques dans 250 ans de Sciences naturelles. Tremblez devant les terreurs des mers du Cr\u00e9tac\u00e9 dans la Salle des Mosasaures et admirez les magnifiques cristaux de la Salle des Min\u00e9raux.\n\nEt enfin ne manquez pas les expositions temporaires et toutes les animations du Service \u00e9ducatif : plus d\u2019informations sur www.naturalsciences.be\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Instituto de Ciencias Naturales","address_street_name":"Rue Vautier","address_street_number":"29","address_street_box":null,"email":"info@naturalsciences.be","website":"https:\/\/www.naturalsciences.be\/","phone_contact":"+32 2 627 42 11","phone_booking":"+32 2 627 42 34","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Vautier, 29","address_line2":"1000 Bruxelles","description_web":null,"description_print":"22\/06\/2022\r\nDescubre la naturaleza en el Real Instituto Belga de Ciencias Naturales de Bruselas, donde podr\u00e1s explorar la naturaleza y nuestra evoluci\u00f3n y biolog\u00eda en la nueva Galer\u00eda de Biolog\u00eda Humana: desde el Sahelanthropus hasta el Homo sapiens, y desde el embri\u00f3n hasta el adulto.\r\n\r\n\u00a1Pero eso no es todo! En este museo encontrar\u00e1s la galer\u00eda de dinosaurios m\u00e1s grande de Europa, tendr\u00e1s la oportunidad de estudiar m\u00e1s de 1000 espec\u00edmenes en la Galer\u00eda de la Evoluci\u00f3n, sumergirte con lagartos de mar gigantes del Cret\u00e1cico en la Sala de los Mosasaurios, disfrutar de un safari urbano en BiodiverCITY y descubrir 250 a\u00f1os de historia de las ciencias naturales a trav\u00e9s de 14 extraordinarios espec\u00edmenes. Con salas dedicadas a temas diversos como los minerales, insectos(en el Vivarium podr\u00e1s observar entre otros seres vivos tar\u00e1ntulas e insectos palo) y conchas, siempre hay algo que descubrir en las colecciones permanentes.\r\n\r\nVisita la p\u00e1gina www.naturalsciences.be para m\u00e1s informaci\u00f3n sobre las exhibiciones temporales.\r\n","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Instituut voor Natuurwetenschappen","address_street_name":"Vautierstraat","address_street_number":"29","address_street_box":null,"email":"info@naturalsciences.be","website":"http:\/\/www.naturalsciences.be","phone_contact":"+32 2 627 42 11","phone_booking":"+32 2 627 42 52","address_zip":"1000","address_city":"Bruxelles","address_line1":"Vautierstraat, 29","address_line2":"1000 Bruxelles","description_web":"Het Instituut voor Natuurwetenschappen, een natuurlijke bestemming voor jong en oud\n\nHier ontmoet je de beroemde Iguanodons van Bernissart, T.rex, Triceratops, Diplodocus, en 34 andere soorten in de grootste Dinosauri\u00ebrzaal van Europa.\nEn dat is nog maar het begin!\nHerontdek onze aarde, die krioelt van het leven, in de nieuwe Galerij Levende Planeet: een streling voor het oog, geschikt voor het hele gezin en wetenschappelijk verantwoord. Ontdek de evolutie van de mens en hoe ons lichaam werkt in de Galerij van de Mens. Stap miljoenen jaren terug in de tijd in de Galerij van de Evolutie. \tVerken de stedelijke biodiversiteit in BiodiverCITY. Ontdek 250 Jaar Natuurwetenschappen aan de hand van 14 natuurwetenschappelijke iconen. Deins terug voor de verschrikkelijke zeereptielen uit het Krijttijdperk in onze Zaal van de Mosasauri\u00ebrs en bewonder de prachtige exemplaren in de Mineralenzaal;\n\nTot slot mag je de tijdelijke tentoonstellingen en alle activiteiten van de Educatieve Dienst niet missen: meer informatie op www.naturalsciences.be\n\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[9],"translations":{"de":["Europ\u00e4isches Viertel"],"pt":[null],"en":["European Quarter"],"it":["Quartiere europeo"],"cn":[null],"fr":["Quartier europ\u00e9en"],"sp":["Barrio Europeo"],"nl":["Europese wijk"]}},"zones":{"list":[22],"translations":{"de":["Osten"],"pt":[null],"en":["East"],"it":["Est"],"cn":[null],"fr":["Est"],"sp":["Este"],"nl":["Oost"]}},"neca":null,"facebook_id":null,"backoffice_id":8,"location":{"lat":50.8366595,"lon":4.376632},"region":"brussels","last_updated_at":"2023-11-14T12:25:40+01:00","published_at":"2013-10-19T01:13:13+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":47,"translations":{"de":{"name":"Institut f\u00fcr Naturwissenschaften","address_street_name":"Rue Vautier","address_street_number":"29","address_street_box":null,"email":"info@naturalsciences.be","website":"https:\/\/www.naturalsciences.be\/de","phone_contact":"+32 2 627 42 11","phone_booking":"+32 2 627 42 34","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Vautier, 29","address_line2":"1000 Bruxelles","description_web":null,"description_print":"22\/06\/2022\r\nNaturwissenschaften und Naturgeschichte hautnah im Br\u00fcsseler Museum f\u00fcr Naturwissenschaften mit der gr\u00f6\u00dften Dinosaurierausstellung Europas\r\n\r\nVon den Dinosauriern bis zum Menschen: Lust, einem Mammut in den R\u00fcssel zu schauen, einem Dinosaurier tief in die Augen zu blicken oder in die Haut eines Neandertalers zu schl\u00fcpfen? Das Museum f\u00fcr Naturwissenschaften steckt voller Leben... und voller \u00dcberraschungen. \r\n\r\nDie gr\u00f6\u00dfte Dinosaurierausstellung Europas: Die Dinosauriergalerie mit mehr als drei\u00dfig vollst\u00e4ndigen Skeletten und zahlreichen Dinosaurierfragmenten ist die gr\u00f6\u00dfte Dinosaurierausstellung Europas. Nebenbei erf\u00e4hrt man interessante Details aus dem Leben - und Sterben - der Dinosaurier...\r\n\r\nNeuheiten: Die \u201eGalerie de l'Homme\": Neuste Attraktion ist die \u201eGalerie de l'Homme\" - die Galerie des Menschen, die einen faszinierenden Einblick in 7 Millionen Jahre Menschheitsgeschichte gibt. Vom Embryo zum Erwachsenen - entdecken Sie die Entwicklung und die Evolution bis zum modernen Menschen oder den menschlichen K\u00f6rper und seine Funktionsweise anhand von Fossiliensammlungen, 3D-Nachbildungen und interaktiven Pr\u00e4sentationen. \r\n\r\nDer Mosasaurier-Saal: Die Mosasaurier waren in der Oberkreide eine weltweit verbreitete Gruppe von Meeresreptilien. In dem neuen Saal, der sich unterhalb der Dinosaurier-Galerie befindet, haben Sie Gelegenheit, diese \u201eurzeitlichen K\u00f6nige der Meere\" zu bewundern.\r\n\r\nLeibliches Wohl:\r\n\r\nDer Magen knurrt, die Zunge ist trocken? G\u00f6nnen Sie sich eine kleine Pause im Dino Caf\u00e9.","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Instituto das Ci\u00eancias Naturais","address_street_name":"Rue Vautier","address_street_number":"29","address_street_box":null,"email":"info@naturalsciences.be","website":"http:\/\/www.naturalsciences.be","phone_contact":"+32 2 627 42 11","phone_booking":"+32 2 627 42 34","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Vautier, 29","address_line2":"1000 Bruxelles","description_web":null,"description_print":"22\/06\/2022\r\nExplore a evolu\u00e7\u00e3o do ser humano e do seu corpo \u2013 do Sahelanthropus ao Homo sapiens, do embri\u00e3o ao adulto \u2013 tudo na nova Galeria do Ser Humano \u2013 a nossa evolu\u00e7\u00e3o, o nosso corpo.\r\nMas n\u00e3o \u00e9 tudo! Pode tamb\u00e9m descobrir a maior Galeria de Dinossauros da Europa, voltar no tempo na Galeria da Evolu\u00e7\u00e3o, com os seus 1000 esp\u00e9cimes, mergulhar em conjunto com os gigantescos lagartos marinhos do Cret\u00e1ceo na Sala dos Mosassauros, embarcar num safari urbano em BiodiverCITY e descobrir a hist\u00f3ria do museu atrav\u00e9s de 14 \u201ccap\u00edtulos\u201d simb\u00f3licos de 250 anos de Ci\u00eancias Naturais. Por \u00faltimo, as salas dedicadas aos Minerais, aos Insetos (com um viveiro, onde tar\u00e2ntulas, bichos-pau e outros vos far\u00e3o tremer) e aos Moluscos convencer-vos-\u00e3o que h\u00e1 sempre algo a descobrir nas nossas cole\u00e7\u00f5es permanentes.\r\nNavegue no site www.sciencesnaturelles.be para mais informa\u00e7\u00f5es sobre as exposi\u00e7\u00f5es tempor\u00e1rias","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Institute of Natural Sciences","address_street_name":"Vautierstraat","address_street_number":"29","address_street_box":null,"email":"info@naturalsciences.be","website":"http:\/\/www.naturalsciences.be","phone_contact":"+32 2 627 42 11","phone_booking":"+32 2 627 42 52","address_zip":"1000","address_city":"Bruxelles","address_line1":"Vautierstraat, 29","address_line2":"1000 Bruxelles","description_web":"The Institute of Natural Sciences: a great day out, naturally!\n\nIn the largest Dinosaur Gallery in Europe, you can meet the famous Bernissart Iguanodons, T.rex, Triceratops, Diplodocus, and 34 other species.\nBut that\u2019s not all!\n\nThe Earth is swarming with life - rediscover it in the new Gallery, Living Planet, through an aesthetic, family-friendly and scientific approach to biodiversity. Learn about the human body and how we evolved in the Gallery of Humankind and go back in time in the Gallery of Evolution. You can also find out about urban species in BiodiverCITY, discover 250 years of the history of Natural Sciences through 14 iconic specimens, beware of the kings of the Cretaceous seas in the Mosasaur Hall or admire the magnificent crystals in the Mineral Hall.\n\nAnd last but not least, don't miss the temporary exhibitions and all the activities of the Educational Service: more information at www.naturalsciences.be.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Istituto di Scienze Naturali","address_street_name":"Rue Vautier","address_street_number":"29","address_street_box":null,"email":"info@naturalsciences.be","website":"https:\/\/www.naturalsciences.be\/","phone_contact":"+32 2 627 42 11","phone_booking":"+32 2 627 42 34","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Vautier, 29","address_line2":"1000 Bruxelles","description_web":null,"description_print":"22\/06\/2022\r\nIl Museo di Scienze naturali di Bruxelles conserva la pi\u00f9 importante collezione di scheletri di dinosauro d\u2019Europa, ma non solo!\r\n\r\nTroverete molti dinosauri tra cui Tirannosauri Rex, Triceratopi e Diplodochi, potrete ammirare anche la vasta collezione di fossili d\u2019Iguanodonti di inestimabile valore, di cui il Belgio \u00e8 estremamente fiero.     \r\n\r\n\r\nDa non perdere: la Nuova Galleria dell\u2019Uomo \r\n\r\nDal Sahelanthropus all'Homo sapiens, dall'embrione all'adulto: nella nuova galleria del museo potete esplorare l\u2019evoluzione dell\u2019uomo e del corpo umano. Quest\u2019area vi d\u00e0 la possibilit\u00e0 di conoscere i cambiamenti che hanno portato all\u2019uomo moderno e l\u2019evoluzione nel corso di 7 milioni di anni, attraverso fossili, video-ricostruzioni 3D, presentazioni interattive.  \r\n\r\nPer saperne di pi\u00f9 \r\n\r\n\r\n\r\nDa vedere anche:\r\n\r\nLa sala dei Mosasauri\r\nQuesta sala di recente costruzione, situata sopra la Galleria dei Dinosauri vi permetter\u00e0 di ammirare i \"re dei mari antichi\", i Mosasauri, gigantesche lucertole marine equivalente acquatico dei dinosauri. \r\n\r\nLa Galleria dei Dinosauri \r\nLa pi\u00f9 grande esposizione di Dinosauri d'Europa, con pi\u00f9 di 30 scheletri di cui alcuni interamente conservati.\r\n\r\nLa Galleria dell'Evoluzione\r\nUn'esposizione unica nel suo genere in Belgio! Circa 600 fossili e 400 animali imbalsamati a testimoniare la biodiversit\u00e0 delle specie animali di milioni di anni.\r\n\r\n250 anni di Scienze naturali\r\nUn percorso all\u2019insegna di 20 testimonianze storico-scientifiche.\r\n  \r\nBiodiverCITY\r\nQuesta sala, dedicata alla biodiversit\u00e0 cittadina, offre un'avventura urbana a grandi e piccini. Dagli 8 anni in su.\r\n","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Institut des Sciences Naturelles","address_street_name":"Rue Vautier","address_street_number":"29","address_street_box":null,"email":"info@naturalsciences.be","website":"http:\/\/www.naturalsciences.be","phone_contact":"+32 2 627 42 11","phone_booking":"+32 2 627 42 34","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Vautier, 29","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Institut des Sciences naturelles","address_street_name":"Rue Vautier","address_street_number":"29","address_street_box":null,"email":"info@naturalsciences.be","website":"http:\/\/www.naturalsciences.be","phone_contact":"+32 2 627 42 11","phone_booking":"+32 2 627 42 34","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Vautier, 29","address_line2":"1000 Bruxelles","description_web":"L'Institut des Sciences Naturelles, un incontournable pour les curieux de nature\n\nIci vous rencontrerez les fameux Iguanodons de Bernissart, T.rex, Triceratops, Diplodocus, et 34 autres esp\u00e8ces dans la plus grande Galerie de Dinosaures d\u2019Europe.\nMais ce n\u2019est pas tout ! \n\nRed\u00e9couvrez aussi notre Terre, grouillante de vie, dans une approche \u00e0 la fois esth\u00e9tique, familiale et scientifique de la biodiversit\u00e9 dans la nouvelle Galerie Plan\u00e8te Vivante . D\u00e9couvrez notre \u00e9volution et le fonctionnement de notre corps dans la Galerie de l\u2019Homme. Remontez le temps dans la Galerie de l\u2019\u00c9volution. Explorez la diversit\u00e9 des esp\u00e8ces urbaines dans BiodiverCITY. Observez des sp\u00e9cimens illustrant l\u2019histoire de l'institut au travers de 14 chapitres symboliques dans 250 ans de Sciences naturelles. Tremblez devant les terreurs des mers du Cr\u00e9tac\u00e9 dans la Salle des Mosasaures et admirez les magnifiques cristaux de la Salle des Min\u00e9raux.\n\nEt enfin ne manquez pas les expositions temporaires et toutes les animations du Service \u00e9ducatif : plus d\u2019informations sur www.naturalsciences.be\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Instituto de Ciencias Naturales","address_street_name":"Rue Vautier","address_street_number":"29","address_street_box":null,"email":"info@naturalsciences.be","website":"https:\/\/www.naturalsciences.be\/","phone_contact":"+32 2 627 42 11","phone_booking":"+32 2 627 42 34","address_zip":"1000","address_city":"Bruxelles","address_line1":"Rue Vautier, 29","address_line2":"1000 Bruxelles","description_web":null,"description_print":"22\/06\/2022\r\nDescubre la naturaleza en el Real Instituto Belga de Ciencias Naturales de Bruselas, donde podr\u00e1s explorar la naturaleza y nuestra evoluci\u00f3n y biolog\u00eda en la nueva Galer\u00eda de Biolog\u00eda Humana: desde el Sahelanthropus hasta el Homo sapiens, y desde el embri\u00f3n hasta el adulto.\r\n\r\n\u00a1Pero eso no es todo! En este museo encontrar\u00e1s la galer\u00eda de dinosaurios m\u00e1s grande de Europa, tendr\u00e1s la oportunidad de estudiar m\u00e1s de 1000 espec\u00edmenes en la Galer\u00eda de la Evoluci\u00f3n, sumergirte con lagartos de mar gigantes del Cret\u00e1cico en la Sala de los Mosasaurios, disfrutar de un safari urbano en BiodiverCITY y descubrir 250 a\u00f1os de historia de las ciencias naturales a trav\u00e9s de 14 extraordinarios espec\u00edmenes. Con salas dedicadas a temas diversos como los minerales, insectos(en el Vivarium podr\u00e1s observar entre otros seres vivos tar\u00e1ntulas e insectos palo) y conchas, siempre hay algo que descubrir en las colecciones permanentes.\r\n\r\nVisita la p\u00e1gina www.naturalsciences.be para m\u00e1s informaci\u00f3n sobre las exhibiciones temporales.\r\n","booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Instituut voor Natuurwetenschappen","address_street_name":"Vautierstraat","address_street_number":"29","address_street_box":null,"email":"info@naturalsciences.be","website":"http:\/\/www.naturalsciences.be","phone_contact":"+32 2 627 42 11","phone_booking":"+32 2 627 42 52","address_zip":"1000","address_city":"Bruxelles","address_line1":"Vautierstraat, 29","address_line2":"1000 Bruxelles","description_web":"Het Instituut voor Natuurwetenschappen, een natuurlijke bestemming voor jong en oud\n\nHier ontmoet je de beroemde Iguanodons van Bernissart, T.rex, Triceratops, Diplodocus, en 34 andere soorten in de grootste Dinosauri\u00ebrzaal van Europa.\nEn dat is nog maar het begin!\nHerontdek onze aarde, die krioelt van het leven, in de nieuwe Galerij Levende Planeet: een streling voor het oog, geschikt voor het hele gezin en wetenschappelijk verantwoord. Ontdek de evolutie van de mens en hoe ons lichaam werkt in de Galerij van de Mens. Stap miljoenen jaren terug in de tijd in de Galerij van de Evolutie. \tVerken de stedelijke biodiversiteit in BiodiverCITY. Ontdek 250 Jaar Natuurwetenschappen aan de hand van 14 natuurwetenschappelijke iconen. Deins terug voor de verschrikkelijke zeereptielen uit het Krijttijdperk in onze Zaal van de Mosasauri\u00ebrs en bewonder de prachtige exemplaren in de Mineralenzaal;\n\nTot slot mag je de tijdelijke tentoonstellingen en alle activiteiten van de Educatieve Dienst niet missen: meer informatie op www.naturalsciences.be\n\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":8,"location":{"lat":50.8366595,"lon":4.376632},"last_updated_at":"2023-11-14T12:25:40+01:00","published_at":"2013-10-19T01:13:13+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/2b0ee4911130db4218f844cfe3cf1bfaa9e148c3.jpg","width":3840,"height":2160,"ratio":1,"oEmbed_height":2160,"oEmbed_width":3840,"translations":{"de":{"title":"Giants","copyright":null},"pt":{"title":"Giants","copyright":null},"en":{"title":"Giants","copyright":null},"it":{"title":"Giants","copyright":null},"cn":{"title":"Giants","copyright":null},"fr":{"title":"Giants","copyright":null},"sp":{"title":"Giants","copyright":null},"nl":{"title":"Giants","copyright":null}}}],"dates":[{"day":"2023-10-20","doors":null,"start":"09:30:00","end":"17:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2023-10-21","doors":null,"start":"10:00:00","end":"18:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2023-10-22","doors":null,"start":"10:30:00","end":"18:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2023-10-24","doors":null,"start":"09:30:00","end":"17:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2023-10-25","doors":null,"start":"09:30:00","end":"17:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2023-10-26","doors":null,"start":"09:30:00","end":"17:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2023-10-27","doors":null,"start":"09:30:00","end":"17:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2023-10-28","doors":null,"start":"10:00:00","end":"18:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2023-10-29","doors":null,"start":"10:30:00","end":"18:00:00","end_night_life":null,"is_soldout":false,"is_canceled":false},{"day":"2023-10-31","doors":null,"start":"09:30:00","end":"17:00:00","e