dress_line2":"1190 Forest","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Wiels - Centre d\u2019art contemporain","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+ 32 (0)2-340.00.50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Wiels - Centre d\u2019art contemporain","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+ 32 (0)2-340.00.50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":"Le WIELS est un laboratoire international pour la cr\u00e9ation et la diffusion de l\u2019art contemporain. Ax\u00e9 sur les arts visuels, mais accordant une place et une attention particuli\u00e8res aux croisements et interactions avec d\u2019autres disciplines, le centre d\u00e9sire pr\u00e9senter l\u2019art contemporain dans toute sa diversit\u00e9 et mettre le public en contact et en dialogue permanents avec les d\u00e9veloppements et d\u00e9bats les plus r\u00e9cents du monde de l\u2019art. Le centre d'art dispose d'un magasin, d'un caf\u00e9 et d'un toit terrasse offrant une impressionnante vue sur la ville. ","description_print":null,"booking_url":null,"sort_order":"WIELS - CONTEMPORARY ART CENTRE","virtual_visit":null,"visit_url":null},"sp":{"name":"Wiels - Centro de arte contempor\u00e1neo","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+ 32 (0)2-340.00.50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":"Fue el amante de la cerveza L\u00e9on Wielemans quien le pidi\u00f3 a su amigo, el arquitecto Adrien Blomme, dise\u00f1ar y construir los nuevos edificios para su cervecer\u00eda en Forest. Se convirti\u00f3 en el monumento m\u00e1s importante de arqueolog\u00eda industrial en estilo art d\u00e9co, y ahora alberga Wiels, un laboratorio internacional para la creaci\u00f3n y difusi\u00f3n de arte contempor\u00e1neo. Poniendo el foco en las artes visuales, pero garantizando una particular atenci\u00f3n en el cruce y las interacciones con otras disciplinas, el centro pretende mostrar el arte contempor\u00e1neo en todos sus sentidos y ofrecer un di\u00e1logo permanente con su desarrollo y los debates m\u00e1s recientes del mundo del arte.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Wiels - Centrum voor hedendaagse kunst","address_street_name":"Van Volxemlaan","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+ 32 (0)2-340.00.50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Van Volxemlaan, 354","address_line2":"1190 Forest","description_web":"Wiels is een toonaangevend internationaal platform voor de creatie en presentatie van hedendaagse kunst. Het centrum ontwikkelt een programma van tijdelijke activiteiten, zonder een permanente collectie uit te bouwen. Wiels organiseert zes tot acht grote tentoonstellingen per jaar die de evoluties in hedendaagse kunst op de voet volgen. Daarnaast loopt er een residentie en educatief programma en worden er lezingen, films, performances, debatten, ontmoetingen georganiseerd. Het kunstcentrum heeft een shop, een caf\u00e9 en een dakterras met een indrukwekkend uitzicht over de stad. ","description_print":null,"booking_url":null,"sort_order":"WIELS - CONTEMPORARY ART CENTRE","virtual_visit":null,"visit_url":null}},"neca":"art_center","facebook_id":"https:\/\/www.facebook.com\/WielsBrussels","region":"brussels","backoffice_id":195,"location":{"lat":50.82467444,"lon":4.32636558},"last_updated_at":"2023-05-02T15:20:32+02:00","published_at":"2013-10-19T01:13:21+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/8e286982d643ddc2ee4f8374e8fcedb70f267393.jpg","width":2000,"height":1333,"ratio":1.5,"oEmbed_height":1333,"oEmbed_width":2000,"translations":{"de":{"title":"Family Funday","copyright":"Diana Vos"},"pt":{"title":"Family Funday","copyright":"Diana Vos"},"en":{"title":"Family Funday","copyright":"Diana Vos"},"it":{"title":"Family Funday","copyright":"Diana Vos"},"cn":{"title":"Family Funday","copyright":"Diana Vos"},"fr":{"title":"Family Funday","copyright":"Diana Vos"},"sp":{"title":"Family Funday","copyright":"Diana Vos"},"nl":{"title":"Family Funday","copyright":"Diana Vos"}}},{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/c2f222b2729f2ef4a5cd19a6ad4386479b0f8f9a.jpg","width":2677,"height":2139,"ratio":1.25,"oEmbed_height":2139,"oEmbed_width":2677,"translations":{"de":{"title":"Oscar Murillo, disrupted frequencies (detail), 2013-2023 ","copyright":"\u00a9 Oscar Murillo. Photo: Tim Bowditch & Reinis Lismanis"},"pt":{"title":"Oscar Murillo, disrupted frequencies (detail), 2013-2023 ","copyright":"\u00a9 Oscar Murillo. Photo: Tim Bowditch & Reinis Lismanis"},"en":{"title":"Oscar Murillo, disrupted frequencies (detail), 2013-2023 ","copyright":"\u00a9 Oscar Murillo. Photo: Tim Bowditch & Reinis Lismanis"},"it":{"title":"Oscar Murillo, disrupted frequencies (detail), 2013-2023 ","copyright":"\u00a9 Oscar Murillo. Photo: Tim