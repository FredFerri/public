import_origin":null,"sub_type":"expo","show_in_agenda":true,"ranking":1},{"id":530597,"date_start":"2022-04-30","date_end":"2022-06-11","date_next":"2022-06-11","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":49,"translations":{"fr":"Th\u00e9\u00e2tre","nl":"Theater","en":"Theatre"}},"others":{"list":[51],"translations":{"fr":["Caf\u00e9 th\u00e9\u00e2tre"],"nl":["Cabaret"],"en":["Cabaret"]}}},"languages":{"spoken":["fr"],"subtitles":[]},"translations":{"fr":{"name":"Mal\u00e9dictions - Spectacle d'improvisation","shortdescr":null,"longdescr":"Le jour ils sont comme tout le monde, poli, respectable, pr\u00e9sentable, de vrais citoyens. Mais \u00e0 la tomb\u00e9 de la nuit! La mal\u00e9diction s'abat sur eux! tout comme le y\u00e9tis-garous se transforme durant la nuit.\r\nVenez jeter votre mal\u00e9diction sur ces pauvres infortun\u00e9s personnages qui devront trouver ensemble comment s'en lib\u00e9rer.\r\nVenez voir deux histoires de mal\u00e9dictions, le tout racont\u00e9 par un narrateur impitoyable qui se fera un plaisir de voir ses personnages se d\u00e9battre face aux mal\u00e9dictions qui les emp\u00e8cheront de mener leur vie normale.\r\n\r\nSpectacle tout public !","performers":"Les Y\u00e9tis-Garous","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/530597.html"},"nl":{"name":"Mal\u00e9dictions - Spectacle d'improvisation","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/530597.html"},"en":{"name":"Mal\u00e9dictions - Spectacle d'improvisation","shortdescr":nul