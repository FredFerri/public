tgalerien","Fotografie"],"it":[null,null],"sp":[null,null],"pt":[null,null],"cn":[null,null]}}},"languages":{"spoken":["fr","en"],"subtitles":[]},"translations":{"fr":{"name":"Season XXIV - J\u00f6rg Br\u00e4uer, Solo Show, Lithologie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.545944"},"nl":{"name":"Season XXIV - J\u00f6rg Br\u00e4uer, Solo Show, Lithologie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/spazionobile.com\/","email":"lc@spazionobile.com","phone_contact":"+32 475 53 19 88","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.545944"},"en":{"name":"Season XXIV - J\u00f6rg Br\u00e4uer, Solo Show, Lithologie","shortdescr":null,"longdescr":"Lithologie\r\n\r\nJo\u0308rg Bra\u0308uer, Solo Show\r\n\r\nVernissage 17.11.2022, 18-21.00 In the presence of the artist\r\n\r\nSpazio Nobile Gallery is pleased to present a substantial solo-exhibition of new works by J\u00f6rg Br\u00e4uer. His artistic research focuses on the perception on time, expressed through different means: photography, typography, sculpture, painting and installations. J\u00f6rg Br\u00e4uer pursues his poetic and aesthetic quest, focusing on landscape, architecture and still life with a quality that exposes finer details with great depth and contrast, revealing the restrained beauty that inhabits the unknown and magical world around us. Works have been realized in Capri, Santorini, Mediterranean Sea and Charente. The artist invites to rethink his position with earth and time.","performers":"Jo\u0308rg Bra\u0308uer, Solo Show","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.545944"},"de":{"name":"Season XXIV - J\u00f6rg Br\u00e4uer, Solo Show, Lithologie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.545944"},"it":{"name":"Season XXIV - J\u00f6rg Br\u00e4uer, Solo Show, Lithologie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.545944"},"sp":{"name":"Season XXIV - J\u00f6rg Br\u00e4uer, Solo Show, Lithologie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.545944"},"pt":{"name":"Season XXIV - J\u00f6rg Br\u00e4uer, Solo Show, Lithologie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.545944"},"cn":{"name":"Season XXIV - J\u00f6rg Br\u00e4uer, Solo Show, Lithologie","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.545944"}},"place":{"id":265998,"translations":{"fr":{"name":"Spazio Nobile Gallery, Contemporary Applied Arts","address_street_name":"Rue Franz Merjay","address_street_number":"142","address_street_box":null,"email":"lc@spazionobile.com","website":"http:\/\/www.spazionobilegallery.com","phone_contact":"+32 2 768 25 10","phone_booking":"+32 475 53 19 88","address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Franz Merjay, 142","address_line2":"1050 Ixelles","description_web":"Spazio Nobile Gallery, la galerie d\u2019arts appliqu\u00e9s, de design et de photographie.\r\nUn espace d\u00e9di\u00e9 \u00e0 la culture de la cr\u00e9ation\r\n\r\nMettant \u00e0 l\u2019honneur la cr\u00e9ation et le savoir-faire tant dans le design et les arts appliqu\u00e9s (verre, m\u00e9tal, bois, c\u00e9ramique\u2026) que dans la photographie, Spazio Nobile a pour ambition de faire dialoguer ces diff\u00e9rentes disciplines en m\u00ealant harmonieusement la contemporan\u00e9it\u00e9 et le sensde l\u2019histoire.\r\n\r\nSpazio Nobile Gallery, c\u2019est tout d\u2019abord le projet partag\u00e9 d\u2019un couple d\u2019historiens de l\u2019art aux parcours on ne peut plus compl\u00e9mentaires. Active depuis plus de 20 ans dans le domaine du design et de la cr\u00e9ation, Lise Coirier s\u2019investit depuis le d\u00e9but de sa carri\u00e8re pour mettre en \u00e9vidence ces cr\u00e9ateurs qui insufflent forme et vie \u00e0 la mati\u00e8re. Son mari, Gian Giuseppe Simeone, suit une voie parall\u00e8le, ax\u00e9e davantage sur la sauvegarde et la mise en valeur du patrimoine culturel et artistique, ainsi que leur diffusion vers les publics.\r\n\r\n","description_print":"Spazio Nobile Gallery, la galerie d\u2019arts appliqu\u00e9s, de design et de photographie.\r\nUn espace d\u00e9di\u00e9 \u00e0 la culture de la cr\u00e9ation\r\n\r\nMettant \u00e0 l\u2019honneur la cr\u00e9ation et le savoir-faire tant dans le design et les arts appliqu\u00e9s (verre, m\u00e9tal, bois, c\u00e9ramique\u2026) que dans la photographie, Spazio Nobile a pour ambition de faire dialoguer ces diff\u00e9rentes disciplines en m\u00ealant harmonieusement la contemporan\u00e9it\u00e9 et le sensde l\u2019histoire.\r\n\r\nSpazio Nobile, c\u2019est tout d\u2019abord le projet partag\u00e9 d\u2019un couple d\u2019historiens de l\u2019art aux parcours on ne peut plus compl\u00e9mentaires. Active depuis plus de 20 ans dans le domaine du design et de la cr\u00e9ation, Lise Coirier s\u2019investit depuis le d\u00e9but de sa carri\u00e8re pour mettre en \u00e9vidence ces cr\u00e9ateurs qui insufflent forme et vie \u00e0 la mati\u00e8re. Son mari, Gian Giuseppe Simeone, suit une voie parall\u00e8le, ax\u00e9e davantage sur la sauvegarde et la mise en valeur du patrimoine culturel et artistique, ainsi que leur diffusion vers les publics.\r\n","booking_url":null,"sort_order":null,"virtual_visit":null},"nl":{"name":"Spazio Nobile Gallery, Contemporary Applied Arts","address_street_name":"Franz Merjaystraat","address_street_number":"142","address_street_box":null,"email":"lc@spazionobile.com","website":"http:\/\/www.spazionobilegallery.com","phone_contact":"+32 2 768 25 10","phone_booking":"+32 475 53 19 88","address_zip":"1050","address_city":"Elsene","address_line1":"Franz Merjaystraat, 142","address_line2":"1050 Elsene","description_web":"Spazio Nobile Gallery, de Galerij voor toegepaste kunst, design en fotografie.\r\nEen oase gewijd aan de cultuur van het cre\u00ebren. \r\n\r\nSpazio Nobile Gallery ambieert een oord van kruisbestuiving en dialoog tussen de verschillende\r\ndisciplines design, toegepaste kunst ( metaal, glas, hout en keramiek ) en fotografie, waarbij het accent gelegd wordt op creatie en know-how, en heden en verleden harmonieus samenvloeien.\r\n\r\nSpazio Nobile Gallery is in de eerste plaats het gezamenlijke project van een uiterst complementair koppel kunsthistorici. Lise Coirier is reeds meer dan 20 jaar actief in de wereld van design en creatie. Sinds het begin van haar carri\u00e8re ijvert ze om de ontwerpers, die de materie vorm en leven inblazen, in het voetlicht te plaatsen. Haar echtgenoot Gian Giuseppe Simeone volgt een gelijkaardig traject, maar richt zich eerder op het behoud en de waardering van het artistieke en culturele patrimonium, en hun publieke verspreiding. \r\n","description_print":"Spazio Nobile Gallery, de Galerij voor toegepaste kunst, design en fotografie.\r\nEen plek gewijd aan de cultuur van het cre\u00ebren. \r\n\r\nSpazio Nobile ambieert een oord van kruisbestuiving en dialoog tussen de verschillende\r\ndisciplines design, toegepaste kunst ( metaal, glas, hout en keramiek ) en fotografie, waarbij het accent gelegd wordt op creatie en know-how, en heden en verleden harmonieus samenvloeien.\r\n\r\nSpazio Nobile is in de eerste plaats het gezamenlijke project van een uiterst complementair koppel kunsthistorici. Lise Coirier is reeds meer dan 20 jaar actief in de wereld van design en creatie. Sinds het begin van haar carri\u00e8re ijvert ze om de ontwerpers, die de materie vorm en leven inblazen, in het voetlicht te plaatsen. Haar echtgenoot Gian Giuseppe Simeone volgt een gelijkaardig traject, maar richt zich eerder op het behoud en de waardering van het artistieke en culturele patrimonium, en hun publieke verspreiding. \r\n\r\nMeer dan een \u201cgalerij\u201d in de gewone zin van het woord, wenst Spazio Nobile een plaats te worden waar werk en leven in elkaar overvloeien, waar kennis wordt uitgewisseld, een\r\nesthetische confrontatie opgevat als een volwaardige culturele en zintuigelijke ervaring.","booking_url":null,"sort_order":null,"virtual_visit":null},"en":{"name":"Spazio Nobile Gallery, Contemporary Applied Arts","address_street_name":"Rue Franz Merjay","address_street_number":"142","address_street_box":null,"email":"lc@spazionobile.com","website":"http:\/\/www.spazionobilegallery.com","phone_contact":"+32 2 768 25 10","phone_booking":"+32 475 53 19 88","address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Franz Merjay, 142","address_line2":"1050 Ixelles","description_web":"Spazio Nobile Gallery for applied art, design and photography..\r\nA space dedicated to culture and creation\r\n\r\nHighlighting expertise in design and the applied arts (glass, metal, wood, ceramic, etc.) as well as in photography, Spazio Nobile Gallery aims to create a dialogue between diverse disciplines; a harmonious melange of contemporaneity and sense of history.\r\n\r\nSpazio Nobile Gallery is the shared project of a couple made up of two art historians who have taken complementary paths in their own lives. With more than 20-years in the field of art and design, Lise Coirier has focussed her career on spotlighting designers who infuse matter with form and life. Her husband, Gian Giuseppe Simeone, followed a parallel journey, concentrating on the preservation of cultural and artistic heritage but also public awareness.\r\n","description_print":"Spazio Nobile Gallery for applied art, design and photography opens its doors.\r\nA space dedicated to culture and creation\r\n\r\nHighlighting expertise in design and the applied arts (glass, metal, wood, ceramic, etc.) as well as in photography, Spazio Nobile aims to create a dialogue between diverse disciplines; a harmonious melange of contemporaneity and sense of history.\r\n\r\nSpazio Nobile is the shared project of a couple made up of two art historians who have taken complementary paths in their own lives. With more than 20-years in the field of art and design, Lise Coirier has focussed her career on spotlighting designers who infuse matter with form and life. Her husband, Gian Giuseppe Simeone, followed a parallel journey, concentrating on the preservation of cultural and artistic heritage but also public awareness.\r\n\r\n","booking_url":null,"sort_order":null,"virtual_visit":null},"de":{"name":"Spazio Nobile Gallery, Contemporary Applied Arts","address_street_name":"Rue Franz Merjay","address_street_number":"142","address_street_box":null,"email":"lc@spazionobile.com","website":"http:\/\/www.spazionobilegallery.com","phone_contact":"+32 2 768 25 10","phone_booking":"+32 475 53 19 88","address_zip":"1050","address_city":"Ixelles","address_line1":"Rue Franz Merjay, 142","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Spazio Nobile Gallery, Contemporary Applied Arts","address_street_name":"Rue Franz Merjay","address_street_number":"142"