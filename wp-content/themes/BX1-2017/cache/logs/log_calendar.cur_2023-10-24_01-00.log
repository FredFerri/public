 l\u2019espace, la ma\u00eetrise du geste et de la parole au service du texte. Un accent est particuli\u00e8rement mis sur la cr\u00e9ation du personnage et de sa cr\u00e9dibilit\u00e9.\r\n\u00c2ge de 11 \u00e0 13 ans (D\u00e8s la 6\u00e8me primaire).\r\n\r\nLocal Studio \r\nAvec C\u00e9line Taubennest de la Cie D\u00e9j\u00e0 Demain\r\n\r\nD\u00e8s le 20 septembre, les mercredis de 15:30 \u00e0 17:30\r\nNombre d'exposants :\r\n","performers":"Avec C\u00e9line Taubennest de la Cie D\u00e9j\u00e0 Demain","boxoffice_url":null,"website":"http:\/\/www.wolubilis.be","email":"secretariat.atl@woluwe1200.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.559313"},"sp":{"name":"Th\u00e9\u00e2tre","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wolubilis.be","email":"secretariat.atl@woluwe1200.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.559313"},"nl":{"name":"Th\u00e9\u00e2tre","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.wolubilis.be","email":"secretariat.atl@woluwe1200.be","phone_contact":null,"phone_booking":"+32 2 761 60 30","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.559313"}},"place":{"id":220532,"translations":{"de":{"name":"Centre Culturel Wolubilis","address_street_name":"Cours Paul-Henri Spaak","address_street_number":"1","address_street_box":null,"email":"secretariat.atl@woluwe1200.be","website":"http:\/\/www.wolubilis.be","phone_contact":"+32 2 761 60 29","phone_booking":"+32 2 761 60 30","address_zip":"1200","address_city":"Woluwe-Saint-Lambert","address_line1":"Cours Paul-Henri Spaak, 1","address_line2":"1200 Woluwe-Saint-Lambert","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Centre Cult