":{"de":["Jugendstil, Art d\u00e9co"],"pt":[null],"en":["Art Nouveau, Art D\u00e9co"],"it":["Art Nouveau, Art D\u00e9co"],"cn":[null],"fr":["Art Nouveau, Art D\u00e9co"],"sp":["Art nouveau, art d\u00e9co"],"nl":["Art nouveau, art deco"]}}},"translations":{"de":{"name":"BANAD Festival - BANAD Festival - Guided tour of the former hotel of the telephone and telegraph company","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50007626"},"pt":{"name":"BANAD Festival - BANAD Festival - Guided tour of the former hotel of the telephone and telegraph company","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50007626"},"en":{"name":"BANAD Festival - BANAD Festival - Guided tour of the former hotel of the telephone and telegraph company","shortdescr":"As part of the BANAD Festival, come and discover the former Telegraph and Telephone Office. A large-scale complex built by the architect Michel Polak and his sons.  ","longdescr":"Initially built in 1936-37 in response to a commission by the Belgian state and meant to house the administration of the R\u00e9gie des T\u00e9l\u00e9graphes et T\u00e9l\u00e9phones (RTT), and extended in 1946 in the Modernist style, this vast ensemble was designed by the architect Michel Polak and his sons Jean and Andr\u00e9 Polak. The ground floor is no doubt the best preserved part of the building with its monumental entrance topped with geometric bas-reliefs. Having ascended the main staircase, the visit takes you through certain corridors that have kept their period cachet before ending at the top of one of the towers with its stunning views of the city.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50007626"},"it":{"name":"BANAD Festival - BANAD Festival - Guided tour of the former hotel of the telephone and telegraph company","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50007626"},"cn":{"name":"BANAD Festival - BANAD Festival - Guided tour of the former hotel of the telephone and telegraph company","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50007626"},"fr":{"name":"BANAD Festival - Visite guid\u00e9e de l'ancien h\u00f4tel de l'administration centrale de la RTT","shortdescr":"Dans le cadre du BANAD Festival, venez d\u00e9couvrir l'ancienne r\u00e9gie des T\u00e9l\u00e9graphes et T\u00e9l\u00e9phones. Un ensemble d'envergure construit par l'architecte Michel Polak et ses fils.  ","longdescr":"Erig\u00e9 dans un premier temps en 1936-7 sur commande de l'Etat belge dans le but d'y installer les la R\u00e9gie des T\u00e9l\u00e9graphes et T\u00e9l\u00e9phones (RTT), et \u00e0 partir de 1946 une extension de style moderniste, le b\u00e2timent est un ensemble d'envergure construit par l'architecte Michel Polak et ses fils Jean et Andr\u00e9 Polak. Le rez-de-chauss\u00e9e est sans doute la partie la mieux conserv\u00e9e du b\u00e2timent avec notamment l'entr\u00e9e monumentale surmont\u00e9e de bas-reliefs g\u00e9om\u00e9triques. En empruntant l'escalier principal, la visite passe par certains bureaux du 1er et 3e \u00e9tage qui ont gard\u00e9 tout leur cachet d'\u00e9poque. ","performers":"Explore.Brussels asbl \/ vzw","boxoffice_url":null,"website":"https:\/\/www.banad.brussels","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50007626"},"sp":{"name":"BANAD Festival - BANAD Festival - Guided tour of the former hotel of the telephone and telegraph company","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50007626"},"nl":{"name":"BANAD Festival -  Rondleiding door het voormalige RTT-hoofdkwartier","shortdescr":"Kom in het kader van het BANAD Festival het voormalige Telegraaf- en Telefoonkantoor ontdekken. Een grootschalig complex gebouwd door architect Michel Polak en zijn zonen. ","longdescr":"Dit gebouw werd oorspronkelijk opgetrokken in 1936-7, in opdracht van de Belgische Staat, om er de R\u00e9gie des T\u00e9l\u00e9graphes et T\u00e9l\u00e9phones (RTT) in onder te brengen. In 1946 kwam er een modernistische uitbouw bij. Dit grootschalige complex is van de hand van architect Michel Polak en zijn zonen Jean en Andr\u00e9 Polak. De benedenverdieping is waarschijnlijk het best bewaarde deel van het gebouw, met een monumentale ingang die wordt bekroond door geometrische bas-reli\u00ebfs. Via het hoofdtrappenhuis loopt de rondleiding door enkele kantoren op de eerste en derde verdieping. Ze zijn helemaal in de stijl van die tijd gebleven. ","performers":null,"boxoffice_url":null,"website":"https:\/\/www.banad.brussels","email":"info@explore.brussels","phone_contact":"+32 2 319 50 01","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/n