l":"Animaties"}},"others":{}},"translations":{"de":{"name":"Matin de PAC \u2013 Intervenir dans les quartiers","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.pac-g.be\/","email":"animation@pac-g.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700000891"},"pt":{"name":"Matin de PAC \u2013 Intervenir dans les quartiers","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.pac-g.be\/","email":"animation@pac-g.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700000891"},"en":{"name":"Matin de PAC \u2013 Intervenir dans les quartiers","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.pac-g.be\/","email":"animation@pac-g.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700000891"},"it":{"name":"Matin de PAC \u2013 Intervenir dans les quartiers","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.pac-g.be\/","email":"animation@pac-g.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700000891"},"cn":{"name":"Matin de PAC \u2013 Intervenir dans les quartiers","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.pac-g.be\/","email":"animation@pac-g.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700000891"},"fr":{"name":"REPORT\u00c9 \/\/ Matin de PAC \u2013 Intervenir dans les quartiers","shortdescr":null,"longdescr":"Le Mouvement Pr\u00e9sence et Action Culturelles vous invite \u00e0 une matin\u00e9e d\u2019\u00e9changes, anim\u00e9e par July Robert et en pr\u00e9sence de :\nCharlotte Maisin \u2013 membre de la cellule recherch\u2019action de la FdSS\nRobin Susswein \u2013 sociologue, charg\u00e9 de recherche \u00e0 la Ligue Bruxelloise pour la sant\u00e9 mentale\nJustine Vleminckx \u2013 charg\u00e9e de recherche et d\u2019intervention \u00e0 la FdSS\nJoaquin Santos do Barbosa \u2013 travailleur \u00e0 la FdSS\nLe travail social dans certains quartiers s\u2019effectue de mani\u00e8re transversale, en impliquant tant les associations que les communaut\u00e9s locales et les professionnel\u00b7les de ces services qui travaillent en premi\u00e8re ligne, en contact direct avec les usager\u00b7\u00e8res. Qu\u2019il s\u2019agisse des CPAS ou des services sociaux de proximit\u00e9 (tels que l\u2019Entr\u2019aide des Marolles, active dans le centre de Bruxelles depuis plus d\u2019un si\u00e8cle), les institutions de travail social sont confront\u00e9es \u00e0 un probl\u00e8me commun. Ce dernier s\u2019articule autour de la distance grandissante entre les autorit\u00e9s publiques et certaines populations pr\u00e9caris\u00e9es qui, depuis la crise sanitaire notamment, ont perdu confiance.\n\nUn foss\u00e9 parfois grandissant et qui ne va pas sans poser de nombreuses questions, que nous aborderons avec nos intervenant\u00b7es issu\u00b7es du secteur :\n\nLa connaissance et le quadrillage des territoires sont-ils l\u2019objet d\u2019un fantasme politique ?\nQu\u2019en est-il de ce travail qui est \u00ab en train de se faire \u00bb dans les quartiers et les territoires ? Quels sont atouts et ses limites, ses difficult\u00e9s et ses succ\u00e8s ?\nQuelles sont les limites et logiques d\u2019action des services de premi\u00e8re ligne qui construisent, et parfois bricolent, des pratiques qui vont dans le sens d\u2019une approche territorialis\u00e9e de leurs actions ?\nGr\u00e2ce aux exp\u00e9riences et aux regards de ces professionnel\u00b7les de ces services, nous verrons que se dessinent une diversit\u00e9 d\u2019appr\u00e9hension de cette notion de territoire, construite parfois hors des cadres d\u00e9finis par les autorit\u00e9s publiques.","performers":"Charlotte Maisin \u2013 membre de la cellule recherch\u2019action de la FdSS\nRobin Susswein \u2013 sociologue, charg\u00e9 de recherche \u00e0 la Ligue Bruxelloise pour la sant\u00e9 mentale\nJustine Vleminckx \u2013 charg\u00e9e de recherche et d\u2019intervention \u00e0 la FdSS\nJoaquin Santos do Barbosa \u2013 travailleur \u00e0 la FdSS","boxoffice_url":null,"website":"https:\/\/www.pac-g.be\/","email":"animation@pac-g.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700000891"},"sp":{"name":"Matin de PAC \u2013 Intervenir dans les quartiers","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.pac-g.be\/","email":"animation@pac-g.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700000891"},"nl":{"name":"Matin de PAC \u2013 Intervenir dans les quartiers","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.pac-g.be\/","email":"animation@pac-g.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700000891"}},"place":{"id":258564,"translations":{"de":{"name":"Pr\u00e9sence et Action Culturelles - G\u00e9n\u00e9rale","address_street_name":"Rue Lambert Crickx","address_street_number":"5","address_street_box":null,"email":null,"website":null,"phone_contact":"+32 2 545 79 18","phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"Rue Lambert Crickx, 5","address_line2":"1070 Anderlecht","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Pr\u00e9sence et Action Culturelles - G\u00e9n\u00e9rale","address_street_name":"Rue Lambert Crickx","address_st