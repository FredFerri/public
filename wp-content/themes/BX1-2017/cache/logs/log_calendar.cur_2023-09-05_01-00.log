lse hoofdstedelijke context in het achterhoofd. De rode draad door de programmatie is de samenwerking met Vlaamse en Brusselse partnerorganisaties. \r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":null,"facebook_id":null,"region":"brussels","backoffice_id":13020,"location":{"lat":50.84996484,"lon":4.35348679},"last_updated_at":"2022-11-03T17:13:45+01:00","published_at":"2013-10-19T01:35:36+02:00","is_in_address_book":true,"is_in_vb_export":true,"import_origin":null,"external_id":null,"resto_ranking":0},"media":[{"type":"photo","link":"https:\/\/agendabrussels2.imgix.net\/1693626158160-muntpunt-00b7129241ef135f674fe6f8b4daa1c2b8ca3e3b.jpg","width":2250,"height":2250,"ratio":1,"oEmbed_height":2250,"oEmbed_width":2250,"translations":{"de":{"title":"Muntpunt Schaakclub","copyright":null},"pt":{"title":"Muntpunt Schaakclub","copyright":null},"en":{"title":"Muntpunt Schaakclub","copyright":null},"it":{"title":"Muntpunt Schaakclub","copyright":null},"cn":{"title":"Muntpunt Schaakclub","copyright":null},"fr":{"title":"Muntpunt Schaakclub","copyright":null},"sp":{"title":"Muntpunt Schaakclub","copyright":null},"nl":{"title":"Muntpunt Schaakclub","copyright":null}}}],"dates":[{"day":"2023-09-06","doors":null,"start":"16:00:00","end":"19:00:00","is_soldout":false,"is_canceled":false}],"prices":[{"translations":{"de":{"name":"Normal"},"en":{"name":"Normal"},"it":{"name":"Normale"},"fr":{"name":"Normal"},"sp":{"name":"Normal"},"nl":{"name":"Normaal"}},"value":0}],"date_exceptions":[],"closing_days":[],"child_events":[],"parent_events":[],"accessibilities":[],"recurring":[],"targets":{"list":[8,4,5],"translations":{"de":["Jugendliche 15-18 Jahre","Kinder 6-9 Jahre","Kinder 9-12 Jahre"],"pt":[null,null,null],"en":["Youth 15-18  yr.","Children 6-9 yr.","Children 9-12 yr."],"it":["Ragazzi 15-18 anni","Bambini 6-9 anni","Bambini 9-12 anni"],"cn":[null,null,null],"fr":["Jeunes 15-18 ans","Enfants 6-9 ans","Enfants 9-12 ans"],"sp":["