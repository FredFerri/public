pdated_at":"2022-05-12T15:35:25+02:00","published_at":"2021-06-30T17:35:54+02:00","backoffice_id":234824,"import_origin":null,"sub_type":"theatre","show_in_agenda":true,"ranking":1.2599210498949},{"id":529843,"date_start":"2022-03-02","date_end":"2022-08-14","date_next":"2022-06-15","accept_article27":true,"accept_cultuurbon":false,"accept_paspartoe":true,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":false,"is_online":false,"is_canceled":false,"is_soldout":false,"categories":{"main":{"id":23,"translations":{"fr":"Exposition","nl":"Tentoonstellingen","en":"Exhibition"}},"others":{"list":[36,46],"translations":{"fr":["Mus\u00e9es et art centers","Pluridisciplinaire"],"nl":["Musea en kunstcentra","Multidisciplinair"],"en":["Museums and art centers","Multidisciplinary"]}}},"languages":{"spoken":["fr","nl","en"],"subtitles":[]},"translations":{"fr":{"name":"Nocturnes + Ateliers au WIELS","shortdescr":"Chaque 1e et 3e mercredi du mois, WIELS vous invite \u00e0 prendre part \u00e0 un atelier qui explore des id\u00e9es et techniques cr\u00e9atives employ\u00e9es par les artistes expos\u00e9s. Participez et prolongez le plaisir de la visite en ramenant votre cr\u00e9ation \u00e0 la maison.","longdescr":"EXPOSITIONS \r\nChaque 1er et 3e mercredi du mois, WIELS est ouvert jusqu'\u00e0 21:00.\r\n\r\nATELIERS DES NOCTURNES \r\nLors des nocturnes, WIELS vous invite \u00e0 prendre part \u00e0 un atelier qui explore des id\u00e9es et techniques cr\u00e9atives employ\u00e9es par les artistes expos\u00e9s. Participez et prolongez le plaisir de la visite en ramenant votre cr\u00e9ation \u00e0 la maison.\r\n\r\nTous les 1iers mercredis du mois : Un atelier autour de l'exposition de Kasper Bosmans\r\n\r\nVenez cr\u00e9er votre propre frise \u00e0 l\u2019aide d\u2019un rouleau estampill\u00e9 selon votre go\u00fbt. Cette activit\u00e9 invite \u00e0 la cr\u00e9ation d\u2019un rouleau \u00e0 estampiller, avec lequel vous pourrez reproduire votre frise, reprenant des images-objets trouvant leur source dans diff\u00e9rentes \u0153uvres de Kasper Bosmans. \u00c0 la fin de l'atelier, il vous sera possible de reprendre votre cr\u00e9ation avec vous.\r\n\r\nTous les 3e mercredis du mois : Atelier autour de l'exposition de Huguette Caland\r\n\r\nS\u2019habiller diff\u00e9remment, en adaptant ses v\u00eatements \u00e0 son corps et non l\u2019inverse, cr\u00e9er ses parures soi-m\u00eame, exp\u00e9rimenter les lignes et les porter... une exp\u00e9rience v\u00e9cue par Huguette Caland au cours de sa vie comme artiste.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.wiels.org\/fr\/events\/les-ateliers-des-nocturnes","email":"welcome@wiels.org","phone_contact":"+32 2 340 00 53","phone_booking":"+32 2 340 00 53","agenda_url":"https:\/\/agenda.brussels\/fr\/detail\/id\/529843.html"},"nl":{"name":"Nocturnes + Workshops in WIELS","shortdescr":"Elke 1e en 3e woensdag van de maand nodigt WIELS je uit om deel te nemen aan een workshop die creatieve idee\u00ebn en technieken uit de lopende tentoonstellingen verkent. Neem na afloop je eigen creatie mee naar huis en beleef de tentoonstelling verder!","longdescr":"TENTOONSTELLINGEN \r\nElke 1e en 3e woensdag van de maand zijn de tentoonstellingen van WIELS open tot 21:00! \r\n\r\nNOCTURNE WORKSHOPS \r\nWIELS nodigt je uit om deel te nemen aan een workshop die creatieve idee\u00ebn en technieken uit de lopende tentoonstellingen verkent. Neem na afloop je eigen creatie mee naar huis en beleef de tentoonstelling verder!\r\n\r\nElke 1e woensdag van de maand: Workshop rond de tentoonstelling van Kasper Bosmans\r\n\r\nMaak je eigen fries, gedrukt naar je eigen smaak! Deze activiteit nodigt je uit om een drukrol te maken, waarmee je een motief kan reproduceren om tot je eigen fries te komen, waarin je wezens kan verwerken die je tegenkwam in de verschillende werken van Kasper Bosmans. Aan het einde van de workshop is het mogelijk om je eigen creatie mee naar huis te nemen.\r\n\r\nElke 3e woensdag van de maand: workshop rond de tentoonstelling van Huguette Caland\r\n\r\nNeem deel aan deze workshop en borduur samen met ons in een serene maar revolutionaire sfeer. Zich anders kleden, je kleren aanpassen aan je lichaam en niet andersom, je eigen versieringen cre\u00ebren, experimenteren met lijnen om te dragen: allemaal belangrijke ervaringen die Huguette Caland opdeed tijdens haar leven als kunstenares.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.wiels.org\/nl\/events\/nocturne-workshops","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/nl\/detail\/id\/529843.html"},"en":{"name":"Late Night Openings + Workshops at WIELS","shortdescr":"Every 1st and 3rd Wednesday of the month, WIELS invites you to take part in a workshop that explores creative ideas and techniques used in the current exhibitions. Continue your exhibition experience by taking your own creation home!","longdescr":"EXHIBITIONS \r\nEvery 1st and 3rd Wednesday of the month, the exhibitions of WIELS are open until 21:00. \r\n\r\nLATE NIGHT OPENING WORKSHOPS \r\nDuring the late night openings, WIELS invites you to take part in a workshop that explores creative ideas and techniques used in the current exhibitions. Continue your exhibition experience by taking your own creation home!\r\n\r\nEvery first Wednesday of the month: Workshop in the framework of Kasper Bosmans' exhibition\r\n\r\nCreate your own frieze printed to your taste! This activity invites you to create a printing roll, with which you can reproduce a motif to create your own frieze, incorporating if you so wish creatures observed in the various works by Kasper Bosmans. At the end of the workshop, it\u2019s possible to take your own creation home with you.\r\n\r\nEvery 3rd Wednesday of the month: Workshop in the framework of Huguette Caland's exhibition\r\n\r\nTake part in this workshop and embroider together with us in a serene but revolutionary atmosphere. Dressing differently, adapting your clothes to your body and not the other way round, creating your own adornments, experimenting with lines and wearing them: these were important experiences Huguette Caland had during her life as an artist.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.wiels.org\/en\/events\/late-night-workshops","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/en\/detail\/id\/529843.html"},"de":{"name":"Nocturnes + Ateliers au WIELS","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/de\/detail\/id\/529843.html"},"it":{"name":"Nocturnes + Ateliers au WIELS","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/it\/detail\/id\/529843.html"},"sp":{"name":"Nocturnes + Ateliers au WIELS","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/sp\/detail\/id\/529843.html"},"pt":{"name":"Nocturnes + Ateliers au WIELS","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/pt\/detail\/id\/529843.html"},"cn":{"name":"Nocturnes + Ateliers au WIELS","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/agenda.brussels\/cn\/detail\/id\/529843.html"}},"place":{"id":1490,"translations":{"fr":{"name":"Wiels - Centre d\u2019art contemporain","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+32 2 340 00 50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":"La r\u00e9servation est obligatoire pour le Wiels. Veuillez vous rendre sur leur site internet pour une r\u00e9servation.\r\n\r\nLe WIELS est un laboratoire international pour la cr\u00e9ation et la diffusion de l\u2019art contemporain. Ax\u00e9 sur les arts visuels, mais accordant une place et une attention particuli\u00e8res aux croisements et interactions avec d\u2019autres disciplines, le centre d\u00e9sire pr\u00e9senter l\u2019art contemporain dans toute sa diversit\u00e9 et mettre le public en contact et en dialogue permanents avec les d\u00e9veloppements et d\u00e9bats les plus r\u00e9cents du monde de l\u2019art.","description_print":"","booking_url":null,"sort_order":"WIELS - CONTEMPORARY ART CENTRE","virtual_visit":null},"nl":{"name":"Wiels - Centrum voor hedendaagse kunst","address_street_name":"Van Volxemlaan","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+32 2 340 00 50","phone_booking":null,"address_zip":"1190","address_city":"Vorst","address_line1":"Van Volxemlaan, 354","address_line2":"1190 Vorst","description_web":"De boeking is verplicht voor Wiels. Raadpleeg de webpagina van de musea om te reserveren.\r\n\r\nWiels is een toonaangevend internationaal platform voor de creatie en presentatie van hedendaagse kunst. Het centrum ontwikkelt een programma van tijdelijke activiteiten, zonder een permanente collectie uit te bouwen. Wiels organiseert zes tot acht grote tentoonstellingen per jaar die de evoluties in hedendaagse kunst op de voet volgen. Daarnaast loopt er een residentie en educatief programma en worden er lezingen, films, performances, debatten, ontmoetingen georganiseerd.","description_print":"","booking_url":null,"sort_order":"WIELS - CONTEMPORARY ART CENTRE","virtual_visit":null},"en":{"name":"Wiels - Contemporary art centre","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+32 2 340 00 50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":"Booking is compulsory for Wiels. Please consult the museum\u2019s website to book your time slot.\r\n\r\nIt was the brewer L\u00e9on Wielemans who asked his friend, the architect Adrien Blomme, to design and build the new buildings of his brewery in Forest. It became the leading monument of industrial archaeology in the art deco style, and houses now Wiels, an international laboratory for the creation and the diffusion of contemporary art. Focusing on visual arts, but granting a particular attention to the crossings and interactions with other disciplines, the centre wishes to present contemporary art in all its diversity and to offer a permanent dialogue with the developments and the most recent debates of the art world.  ","description_print":"","booking_url":null,"sort_order":"WIELS - CONTEMPORARY ART CENTRE","virtual_visit":null},"de":{"name":"Wiels - Zentrum f\u00fcr moderne Kunst","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+32 2 340 00 50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":"Das WIELS ist ein hochkar\u00e4tiges, internationales Labor f\u00fcr moderne Kunst, das sich nicht nur der Ausstellung von moderner Kunst sondern auch dem kreativen Entstehungsprozess widmet. Der Schwerpunkt liegt auf der visuellen Kunst, doch es werden auch ganz bewusst Schnittstellen mit anderen Disziplinen gesucht, die die Vielfalt und das Facettenreichtum der modernen Kunst aufzuzeigen. Dem Besucher offenbart sich ein permanenter Dialog mit den Entwicklungen der modernen Kunst und eine Debatte mit der Kunstwelt der Gegenwart.\r\n\r\nAuf drei Ebenen mit insgesamt 1800 m\u00b2 Ausstellungsfl\u00e4che finden regelm\u00e4\u00dfig Ausstellungen statt. Dar\u00fcber hinaus wird das WIELS regelm\u00e4\u00dfig Schauplatz von ausgew\u00e4hlten Filmvorf\u00fchrungen, Konferenzen, Festivals und Konzerten. \r\n\r\nUntergebracht ist das WIELS in dem eindrucksvollen Eckgeb\u00e4ude der ehemaligen Brauerei Wielemans-Ceuppens, das aus der Feder des modernistischen Architekten Adrien Blomm stammt. Von der Brauereivergangenheit zeugen noch heute die majest\u00e4tischen Kupferkessel.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Wiels - Centre d\u2019art contemporain","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+32 2 340 00 50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Wiels - Centro de arte contempor\u00e1neo","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+32 2 340 00 50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":"Fue el amante de la cerveza L\u00e9on Wielemans quien le pidi\u00f3 a su amigo, el arquitecto Adrien Blomme, dise\u00f1ar y construir los nuevos edificios para su cervecer\u00eda en Forest. Se convirti\u00f3 en el monumento m\u00e1s importante de arqueolog\u00eda industrial en estilo art d\u00e9co, y ahora alberga Wiels, un laboratorio internacional para la creaci\u00f3n y difusi\u00f3n de arte contempor\u00e1neo. Poniendo el foco en las artes visuales, pero garantizando una particular atenci\u00f3n en el cruce y las interacciones con otras disciplinas, el centro pretende mostrar el arte contempor\u00e1neo en todos sus sentidos y ofrecer un di\u00e1logo permanente con su desarrollo y los debates m\u00e1s recientes del mundo del arte.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Wiels - Centre d\u2019art contemporain","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+32 2 340 00 50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Wiels - Centre d\u2019art contemporain","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+32 2 340 00 50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"districts":[],"zones":{"list":[21],"translations":{"fr":["Sud"],"nl":["Zuid"],"en":["South"]}},"neca":"art_center","facebook_id":null,"backoffice_id":195,"location":{"lat":50.82467444,"lon":4.32636558},"region":"brussels","last_updated_at":"2022-06-02T01:08:20+02:00","published_at":"2013-10-19T01:13:21+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":1490,"translations":{"fr":{"name":"Wiels - Centre d\u2019art contemporain","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+32 2 340 00 50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":"La r\u00e9servation est obligatoire pour le Wiels. Veuillez vous rendre sur leur site internet pour une r\u00e9servation.\r\n\r\nLe WIELS est un laboratoire international pour la cr\u00e9ation et la diffusion de l\u2019art contemporain. Ax\u00e9 sur les arts visuels, mais accordant une place et une attention particuli\u00e8res aux croisements et interactions avec d\u2019autres disciplines, le centre d\u00e9sire pr\u00e9senter l\u2019art contemporain dans toute sa diversit\u00e9 et mettre le public en contact et en dialogue permanents avec les d\u00e9veloppements et d\u00e9bats les plus r\u00e9cents du monde de l\u2019art.","description_print":"","booking_url":null,"sort_order":"WIELS - CONTEMPORARY ART CENTRE","virtual_visit":null},"nl":{"name":"Wiels - Centrum voor hedendaagse kunst","address_street_name":"Van Volxemlaan","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+32 2 340 00 50","phone_booking":null,"address_zip":"1190","address_city":"Vorst","address_line1":"Van Volxemlaan, 354","address_line2":"1190 Vorst","description_web":"De boeking is verplicht voor Wiels. Raadpleeg de webpagina van de musea om te reserveren.\r\n\r\nWiels is een toonaangevend internationaal platform voor de creatie en presentatie van hedendaagse kunst. Het centrum ontwikkelt een programma van tijdelijke activiteiten, zonder een permanente collectie uit te bouwen. Wiels organiseert zes tot acht grote tentoonstellingen per jaar die de evoluties in hedendaagse kunst op de voet volgen. Daarnaast loopt er een residentie en educatief programma en worden er lezingen, films, performances, debatten, ontmoetingen georganiseerd.","description_print":"","booking_url":null,"sort_order":"WIELS - CONTEMPORARY ART CENTRE","virtual_visit":null},"en":{"name":"Wiels - Contemporary art centre","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+32 2 340 00 50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":"Booking is compulsory for Wiels. Please consult the museum\u2019s website to book your time slot.\r\n\r\nIt was the brewer L\u00e9on Wielemans who asked his friend, the architect Adrien Blomme, to design and build the new buildings of his brewery in Forest. It became the leading monument of industrial archaeology in the art deco style, and houses now Wiels, an international laboratory for the creation and the diffusion of contemporary art. Focusing on visual arts, but granting a particular attention to the crossings and interactions with other disciplines, the centre wishes to present contemporary art in all its diversity and to offer a permanent dialogue with the developments and the most recent debates of the art world.  ","description_print":"","booking_url":null,"sort_order":"WIELS - CONTEMPORARY ART CENTRE","virtual_visit":null},"de":{"name":"Wiels - Zentrum f\u00fcr moderne Kunst","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+32 2 340 00 50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":"Das WIELS ist ein hochkar\u00e4tiges, internationales Labor f\u00fcr moderne Kunst, das sich nicht nur der Ausstellung von moderner Kunst sondern auch dem kreativen Entstehungsprozess widmet. Der Schwerpunkt liegt auf der visuellen Kunst, doch es werden auch ganz bewusst Schnittstellen mit anderen Disziplinen gesucht, die die Vielfalt und das Facettenreichtum der modernen Kunst aufzuzeigen. Dem Besucher offenbart sich ein permanenter Dialog mit den Entwicklungen der modernen Kunst und eine Debatte mit der Kunstwelt der Gegenwart.\r\n\r\nAuf drei Ebenen mit insgesamt 1800 m\u00b2 Ausstellungsfl\u00e4che finden regelm\u00e4\u00dfig Ausstellungen statt. Dar\u00fcber hinaus wird das WIELS regelm\u00e4\u00dfig Schauplatz von ausgew\u00e4hlten Filmvorf\u00fchrungen, Konferenzen, Festivals und Konzerten. \r\n\r\nUntergebracht ist das WIELS in dem eindrucksvollen Eckgeb\u00e4ude der ehemaligen Brauerei Wielemans-Ceuppens, das aus der Feder des modernistischen Architekten Adrien Blomm stammt. Von der Brauereivergangenheit zeugen noch heute die majest\u00e4tischen Kupferkessel.","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"it":{"name":"Wiels - Centre d\u2019art contemporain","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+32 2 340 00 50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"sp":{"name":"Wiels - Centro de arte contempor\u00e1neo","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+32 2 340 00 50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":"Fue el amante de la cerveza L\u00e9on Wielemans quien le pidi\u00f3 a su amigo, el arquitecto Adrien Blomme, dise\u00f1ar y construir los nuevos edificios para su cervecer\u00eda en Forest. Se convirti\u00f3 en el monumento m\u00e1s importante de arqueolog\u00eda industrial en estilo art d\u00e9co, y ahora alberga Wiels, un laboratorio internacional para la creaci\u00f3n y difusi\u00f3n de arte contempor\u00e1neo. Poniendo el foco en las artes visuales, pero garantizando una particular atenci\u00f3n en el cruce y las interacciones con otras disciplinas, el centro pretende mostrar el arte contempor\u00e1neo en todos sus sentidos y ofrecer un di\u00e1logo permanente con su desarrollo y los debates m\u00e1s recientes del mundo del arte.\r\n","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"pt":{"name":"Wiels - Centre d\u2019art contemporain","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+32 2 340 00 50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null},"cn":{"name":"Wiels - Centre d\u2019art contemporain","address_street_name":"Avenue Van Volxem","address_street_number":"354","address_street_box":null,"email":"welcome@wiels.org","website":"http:\/\/www.wiels.org","phone_contact":"+32 2 340 00 50","phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Avenue Van Volxem, 354","address_line2":"1190 Forest","description_web":"","description_print":"","booking_url":null,"sort_order":null,"virtual_visit":null}},"neca":"art_center","facebook_id":null,"backoffice_id":195,"location":{"lat":50.82467444,"lon":4.32636558},"region":"brussels","last_updated_at":"2022-06-02T0