00e0 notre accueil en cash jusqu\u2019au 1er octobre 2023 (un abonnement par cours bien d\u00e9fini). \n\nPour y participer, il faut \u00eatre membre de notre association moyennant une cotisation annuelle de 50 \u20ac par an (except\u00e9 pour les membres de Solidaris Brabant).\n\nSeniors Acad\u00e9mie organise des cours de sports dans diff\u00e9rentes communes de Bruxelles. Consultez le programme complet (yoga, gymnastique douce, aquagym, Qi Gong, Ta\u00efji Quan) dans notre brochure semestrielle l\u2019Echomutualiste Seniors ou sur le site de Solidaris brabant www.solidaris-brabant.be\/fr\/sacademie. \n\nVoici \u00e9galement nos conditions g\u00e9n\u00e9rales","performers":null,"boxoffice_url":null,"website":"http:\/\/www.solidaris-brabant.be\/fr\/sacademie","email":"sacademie.asbl@solidaris.be","phone_contact":"+32 2 546 14 94","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50003401"},"sp":{"name":"Gym douce \u00e0 Ixelles le vendredi \u00e0 10h45","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.solidaris-brabant.be\/fr\/sacademie","email":"sacademie.asbl@solidaris.be","phone_contact":"+32 2 546 14 94","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50003401"},"nl":{"name":"Gym douce \u00e0 Ixelles","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.solidaris-brabant.be\/fr\/sacademie","email":"sacademie.asbl@solidaris.be","phone_contact":"+32 2 546 14 94","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50003401"}},"place":{"id":240963,"translations":{"de":{"name":"Square du Vieux Tilleul","address_street_name":"Avenue du Bois de la Cambre","address_street_number":"10","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1050","address_city":"Ixelles","address_line1":"