s":[]},"categories":{"main":{"id":1,"translations":{"de":"Konzert","pt":null,"en":"Concert","it":"Concerti","cn":null,"fr":"Concert","sp":"Concierto","nl":"Concert"}},"others":{"list":[3],"translations":{"de":["Zeitgen\u00f6ssische Musik"],"pt":[null],"en":["Contemporary music"],"it":["Musica contemporanea"],"cn":[null],"fr":["Musique Contemporaine"],"sp":["M\u00fasica contempor\u00e1nea"],"nl":["Hedendaagse Muziek"]}}},"translations":{"de":{"name":"Concert dessin\u00e9","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.arsmusica.be\/evenement\/concert-dessine","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700002292"},"pt":{"name":"Concert dessin\u00e9","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.arsmusica.be\/evenement\/concert-dessine","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700002292"},"en":{"name":"Concert dessin\u00e9","shortdescr":"A Senegalese narrative set to new music and live projected drawings intertwine Europe and Africa.\n","longdescr":"The Concert Dessin\u00e9 invites you to an extraordinary experience, between the arts, music and storytelling, stage and drawing, Europe and Africa... How does it work? Two composers, Sarah Triquet and Thomas Foguenne, have written an original work for Contes et musiques de la T\u00e9ranga, a story by Souleymane Mbodj. With T\u00e9ranga, a Wolof concept from Senegal that encompasses the values of welcoming, sharing and solidarity, author and musician Souleymane Mbodj tells a story that is passed down from generation to generation, like a gift, a sharing. The magic of the music, performed by Ensemble 21, and the story told by Souleymane Mbodj, is extended to drawings created in real time by Vincent Fortemps and projected onto a screen. A rare, multimedia, extra-geographical and extra-temporal experience.","performers":"Sarah Triquet : Concert dessin\u00e9 , World premiere \/ Commissioned by Ars Musica\nThomas Foguene : Concert dessin\u00e9 , World premiere \/ Commissioned by Ars Musica\nSouleymane M'Bodj : Concert dessin\u00e9 , World premiere \/ Commissioned by Ars Musica\nCoproduction: Centre Culturel d'Uccle \/ Ars Musica\nEnsemble 21\nSouleymane M'Bodj: Voice, percussion\nVincent Fortemps: Drawing\nMarc Collet: Conductor","boxoffice_url":null,"website":"https:\/\/www.arsmusica.be\/evenement\/concert-dessine","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700002292"},"it":{"name":"Concert dessin\u00e9","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.arsmusica.be\/evenement\/concert-dessine","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700002292"},"cn":{"name":"Concert dessin\u00e9","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.arsmusica.be\/evenement\/concert-dessine","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700002292"},"fr":{"name":"Concert dessin\u00e9","shortdescr":"Un conte s\u00e9n\u00e9galais associ\u00e9 \u00e0 une musique de cr\u00e9ation, accompagn\u00e9s de dessins projet\u00e9s en direct.\n\n","longdescr":"Dit getekend concert laat je genieten van een buitengewone ervaring die muziek aan vertelling koppelt, schets en sc\u00e8ne vervlecht en Europa en Afrika samenbrengt... Het originele werk van Sarah Triquet en Thomas Foguenne vormt hierbij het uitgangspunt. De twee componisten schreven dit stuk voor Contes et musiques de la T\u00e9ranga, een verhaal van auteur en muzikant Souleymane Mbodj, uit de rijke Senegalese verhalentraditie. Met \u2018T\u00e9ranga\u2019, een Wolof-begrip uit Senegal dat de waarden van gastvrijheid, vrijgevigheid en solidariteit omvat, vertelt Mbodj een verhaal dat van generatie op generatie wordt doorgegeven. Het magische samenspel van muziek en vertelling wordt nog aangevuld met tekeningen die ter plekke gemaakt worden door Vincent Fortemps en op een scherm geprojecteerd worden. ","performers":"Sarah Triquet : Concert dessin\u00e9 , Cr\u00e9ation mondiale \/ Commande Ars Musica\nThomas Foguene : Concert dessin\u00e9 , Cr\u00e9ation mondiale \/ Commande Ars Musica\nSouleymane M'Bodj : Concert dessin\u00e9 , Cr\u00e9ation mondiale \/ Commande Ars Musica\nCoproduction: Centre Culturel d'Uccle \/ Ars Musica\nEnsemble 21\nSouleymane M'Bodj: Voix, percussions\nVincent Fortemps: Dessin\nMarc Collet: Chef d'orchestre","boxoffice_url":null,"website":"https:\/\/www.arsmusica.be\/evenement\/concert-dessine","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700002292"},"sp":{"name":"Concert dessin\u00e9","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.arsmusica.be\/evenement\/concert-dessine","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700002292"},"nl":{"name":"Concert dessin\u00e9","shortdescr":"Een Senegalese vertelling op nieuwe muziek en live geprojecteerde tekeningen vervlechten Europa en Afrika.\n\n","longdescr":"C\u2019est \u00e0 une exp\u00e9rience hors du commun que le Concert dessin\u00e9 vous invite, entre les arts, la musique et le conte, entre la sc\u00e8ne et le dessin, l\u2019Europe et l\u2019Afrique\u2026 Son principe ? Deux compositeurs, Sarah Triquet et Thomas Foguenne, ont \u00e9crit une \u0153uvre originale pour les Contes et musiques de la T\u00e9ranga, un r\u00e9cit de Souleymane Mbodj. Avec la T\u00e9ranga, concept wolof du S\u00e9n\u00e9gal qui regroupe les valeurs d\u2019accueil, de partage et de solidarit\u00e9, Souleymane Mbodj, auteur et musicien, raconte une histoire qui se transmet de g\u00e9n\u00e9ration en g\u00e9n\u00e9ration, comme un cadeau, un partage. Cette magie de la musique, interpr\u00e9t\u00e9e par l\u2019Ensemble 21, et du r\u00e9cit cont\u00e9 par Souleymane Mbodj, se prolonge en dessins r\u00e9alis\u00e9s en temps r\u00e9el par Vincent Fortemps et projet\u00e9s sur \u00e9cran. Une exp\u00e9rience rare, multim\u00e9dia, extra-g\u00e9ographique et extra-temporelle.","performers":"Sarah Triquet : Concert dessin\u00e9 , Wereldpremi\u00e8re \/ In opdracht van Ars Musica\nThomas Foguene : Concert dessin\u00e9 , Wereldpremi\u00e8re \/ In opdracht van Ars Musica\nSouleymane M'Bodj : Concert dessin\u00e9 , Wereldpremi\u00e8re \/ In opdracht van Ars Musica\nCoproductie: Cultureel Centrum van Ukkel \/ Ars Musica\nEnsemble 21\nSouleymane M'Bodj: Zang, slagwerk\nVincent Fortemps: Tekening\nMarc Collet: Dirigent","boxoffice_url":null,"website":"https:\/\/www.arsmusica.be\/evenement\/concert-dessine","email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700002292"}},"place":{"id":7929,"translations":{"de":{"name":"Centre Culturel d'Uccle","address_street_name":"Rue Rouge","address_street_number":"47","address_street_box":null,"email":"reservation@ccu.be","website":"http:\/\/www.ccu.be","phone_contact":"+32 2 374 64 84","phone_booking":"+32 2 374 64 84","address_zip":"1180","address_city":"Uccle","address_line1":"Rue Rouge, 47","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Centre Culturel d'Uccle","address_street_name":"Rue Rouge","address_street_number":"47","address_street_box":null,"email":"reservation@ccu.be","website":"http:\/\/www.ccu.be","phone_contact":"+32 2 374 64 84","phone_booking":"+32 2 374 64 84","address_zip":"1180","address_city":"Uccle","address_line1":"Rue Rouge, 47","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Centre Culturel d'Uccle","address_street_name":"Rue Rouge","address_street_number":"47","address_street_box":null,"email":"reservation@ccu.be","website":"http:\/\/www.ccu.be","phone_contact":"+32 2 374 64 84","phone_booking":"+32 2 374 64 84","address_zip":"1180","address_city":"Uccle","address_line1":"Rue Rouge, 47","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Centre Culturel d'Uccle","address_street_name":"Rue Rouge","address_street_number":"47","address_street_box":null,"email":"reservation@ccu.be","website":"http:\/\/www.ccu.be","phone_contact":"+32 2 374 64 84","phone_booking":"+32 2 374 64 84","address_zip":"1180","address_city":"Uccle","address_line1":"Rue Rouge, 47","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Centre Culturel d'Uccle","address_street_name":"Rue Rouge","address_street_number":"47","address_street_box":null,"email":"reservation@ccu.be","website":"http:\/\/www.ccu.be","phone_contact":"+32 2 374 64 84","phone_booking":"+32 2 374 64 84","address_zip":"1180","address_city":"Uccle","address_line1":"Rue Rouge, 47","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Centre Culturel d'Uccle","address_street_name":"Rue Rouge","address_street_number":"47","address_street_box":null,"email":"reservation@ccu.be","website":"http:\/\/www.ccu.be","phone_contact":"+32 2 374 64 84","phone_booking":"+32 2 374 64 84","address_zip":"1180","address_city":"Uccle","address_line1":"Rue Rouge, 47","address_line2":"1180 Uccle","description_web":"Le Centre culturel d\u2019Uccle est contemporain de l\u2019Atomium. Con\u00e7u pour se trouver dans un \u00e9crin de verdure, face au Parc de Wolvendael, la premi\u00e8re pierre fut pos\u00e9e le 30 novembre 1957. Le Centre Culturel et Artistique d\u2019Uccle fut inaugur\u00e9 le 5 octobre 1958.\r\nLe CCU est une \u0153uvre de l\u2019architecte L\u00e9on Stynen, qui avait aussi con\u00e7u les casinos de Knokke, Blankenberge et Ostende.\r\nCe nouveau Centre Culturel permit aux soci\u00e9t\u00e9s et associations int\u00e9ress\u00e9es d\u2019organiser des bals, des conf\u00e9rences, des concerts, des projections de films, des d\u00e9bats et toutes autres manifestations culturelles et artistiques (ballets, concerts, expositions, r\u00e9ceptions, \u2026). Il proposait aussi des repr\u00e9sentations th\u00e9\u00e2trales, un cycle de conf\u00e9rences et des spectacles musicaux.\r\nL'ensemble du b\u00e2timent abrite principalement un hall d\u2019entr\u00e9e donnant acc\u00e8s \u00e0 une grande Salle de Spectacle de 800 fauteuils, un Grand Foyer pouvant accueillir jusqu'\u00e0 400 personnes assises, ainsi qu'un Petit Foyer pouvant contenir 120 personnes.\r\nPlus de cinquante ans apr\u00e8s sa cr\u00e9ation, le Centre Culturel d\u2019Uccle r\u00e9nov\u00e9 a un look \u00e0 la fois contemporain et chaleureux. Pleinement actif, il r\u00e9pond aux d\u00e9fis culturels de son si\u00e8cle en accueillant les plus grands noms du th\u00e9\u00e2tre, de la danse, de la chanson et de la musique ainsi que des artistes et des conf\u00e9renciers de renom. Il s\u2019est constamment modernis\u00e9 pour offrir \u00e0 son public une vie culturelle de qualit\u00e9 au c\u0153ur de la commune d\u2019Uccle.\r\nDirig\u00e9 par une \u00e9quipe dynamique, le CCU met tout en \u0153uvre pour fid\u00e9liser sa client\u00e8le et conqu\u00e9rir sans cesse un public nouveau.\r\nLe Centre Culturel d\u2019Uccle en quelques chiffres, c\u2019est\u2026\r\n-\tUn des plus grands centres culturels \u00e0 Bruxelles et ses environs\r\n-\tUn rendez-vous des professionnels du spectacle\r\n-\t4 espaces bien distincts (Hall, Grand Foyer, Petit Foyer, Salle de Spectacle)\r\n-\tUne salle de spectacle de 800 places\r\n-\tUn gradin r\u00e9tractable de 172 places\r\n-\t200 activit\u00e9s par an\r\n-\t600 artistes par saison\r\n-\t60.000 spectateurs par an\r\n\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Centre Culturel d'Uccle","address_street_name":"Rue Rouge","address_street_number":"47","address_street_box":null,"email":"reservation@ccu.be","website":"http:\/\/www.ccu.be","phone_contact":"+32 2 374 64 84","phone_booking":"+32 2 374 64 84","address_zip":"1180","address_city":"Uccle","address_line1":"Rue Rouge, 47","address_line2":"1180 Uccle","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"CC Ukkel","address_street_name":"Rodestraat","address_street_number":"47","address_street_box":null,"email":"info@ccu.be","website":"http:\/\/www.ccu.be","phone_contact":"+32 2 374 64 84","phone_booking":"+32 2 374 64 84","address_zip":"1180","address_city":"Ukkel","address_line1":"Rodestraat, 47","address_line2":"1180 Ukkel","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[],"translations":{}},"zones":{"list":[21],"translations":{"de":["S\u00fcden"],"pt":[null],"en":["South"],"it":["Sud"],"cn":[null],"fr":["Sud"],"sp":["Sur"],"nl":["Zuid"]}},"neca":null,"facebook_id":null,"backoffice_id":320,"location":{"lat":50.80103183,"lon":4.34237168},"region":"brussels","last_updated_at":"2024-03-12T13:44:51+01:00","published_at":"2013-10-19T01:13:26+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":false,"resto_ranking":0},"organizer":{"id":