cle \u00e0 20h15\r\nIl est possible de manger et\/ou boire un verre sur place avant le spectacle, pensez donc \u00e0 venir plus t\u00f4t! (Derni\u00e8re commande de restauration \u00e0 19h55!)\r\n\r\nR\u00c9SERVATIONS (vivement conseill\u00e9es)\r\nvia le lien du Trac : https:\/\/www.letrac.be\/reservations\r\n\r\nTARIFS\r\n- Sur r\u00e9servation : 10\u20ac\/\u00e9tudiant & 13\u20ac\/adulte\r\n- Sur place : 15\u20ac\/personne","performers":"Les improvisateurs de l'\u00e9quipe des Motus et leurs merveilleu.x.ses artistes-invit\u00e9.e.s !","boxoffice_url":null,"website":"http:\/\/www.letrac.be\/reservation","email":"info@letrac.be","phone_contact":"+32 470 50 04 75","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.540299"},"nl":{"name":"LES MOTUS & BOUCHES COUSUES - Spectacle D'improvisation des MOTUS","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.540299"},"en":{"name":"LES MOTUS & BOUCHES COUSUES - Spectacle D'improvisation des MOTUS","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.540299"},"de":{"name":"LES MOTUS & BOUCHES COUSUES - Spectacle D'improvisation des MOTUS","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.540299"},"it":{"name":"LES MOTUS & BOUCHES COUSUES - Spectacle D'improvisation des MOTUS","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-d