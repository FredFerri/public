ons":{"de":{"name":"Exposition R\u00e9sistants d'origine congolaise dans la R\u00e9sistance belge","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.museumresistance.be\/","email":"museum.resistance.verzet@gmail.com","phone_contact":"+32 2 522 40 41","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.5700000212"},"pt":{"name":"Exposition R\u00e9sistants d'origine congolaise dans la R\u00e9sistance belge","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.museumresistance.be\/","email":"museum.resistance.verzet@gmail.com","phone_contact":"+32 2 522 40 41","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700000212"},"en":{"name":"Exposition R\u00e9sistants d'origine congolaise dans la R\u00e9sistance belge","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.museumresistance.be\/","email":"museum.resistance.verzet@gmail.com","phone_contact":"+32 2 522 40 41","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700000212"},"it":{"name":"Exposition R\u00e9sistants d'origine congolaise dans la R\u00e9sistance belge","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.museumresistance.be\/","email":"museum.resistance.verzet@gmail.com","phone_contact":"+32 2 522 40 41","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700000212"},"cn":{"name":"Exposition R\u00e9sistants d'origine congolaise dans la R\u00e9sistance belge","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.museumresistance.be\/","email":"museum.resistance.verzet@gmail.com","phone_contact":"+32 2 522 40 41","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.5700000212"},"fr":{"name":"Exposition R\u00e9sistants d'origine congolaise dans la R\u00e9sistance belge","shortdescr":"\u00c0 l\u2019occasion du 80e anniversaire de la Lib\u00e9ration de Bruxelles, l\u2019association Bakushinta, le Mus\u00e9e des R\u00e9sistances vous pr\u00e9sentent l\u2019exposition pop-up intitul\u00e9e \u201cR\u00e9sistants d\u2019origine congolaise dans la R\u00e9sistance belge 1940-1945\u201d. Cette exposition in\u00e9dite mettra en lumi\u00e8re les parcours individuels de r\u00e9sistants congolais et m\u00e9tis pendant la Seconde Guerre mondiale","longdescr":"C\u2019est dans le cadre du programme \u00ab A Nous l\u2019Histoire : restaurer les m\u00e9moires \u00bb que cette exposition a vu le jour. La participation de personnes d\u2019origine congolaise \u00e0 la R\u00e9sistance contre l\u2019occupant nazi sur le sol belge durant la Seconde guerre mondiale est une r\u00e9alit\u00e9 largement ignor\u00e9e. Fruit d\u2019un travail totalement in\u00e9dit, l\u2019exposition d\u00e9voile de nombreux parcours individuels de r\u00e9sistants congolais et m\u00e9tis, r\u00e9sistants ou combattants volontaires. Cette red\u00e9couverte s\u2019ins\u00e8re dans le cadre plus large de la question de la participation des Congolais et du Congo \u00e0 la victoire alli\u00e9e. \nL\u2019exposition se tiendra \u00e0 l\u2019espace 16Arts (Anderlecht)  et sera ponctu\u00e9e de trois moments forts consacr\u00e9s \u00e0 trois figures de la mobilisation contre l\u2019occupant nazi  : Fran\u00e7ois Kamanda et le groupe du Refuge 24 de l\u2019Arm\u00e9e secr\u00e8te, le jeudi 29 aout \u00e0 18h ; l\u2019infirmi\u00e8re Augusta Chiwy, surnomm\u00e9e l\u2019ange de Bastogne, le mardi 03 septembre \u00e0 18h ; John Vost\u00e9, de l\u2019engagement dans la r\u00e9sistance \u00e0 la d\u00e9portation, le dimanche 8 septembre \u00e0 14h. ","performers":null,"boxoffice_url":null,"website":"http:\/\/www.museumresistance.be\/","email":"museum.resistance.verzet@gmail.com","phone_contact":"+32 2 522 40 41","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.5700000212"},"sp":{"name":"Exposition R\u00e9sistants d'origine congolaise dans la R\u00e9sistance belge","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.museumresistance.be\/","email":"museum.resistance.verzet@gmail.com","phone_contact":"+32 2 522 40 41","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.5700000212"},"nl":{"name":"Tentoonstelling \u201cVerzetsstrijders van Congolese afkomst in het Belgisch Verzet 1940-1945\u201d","shortdescr":"Ter gelegenheid van de 80ste verjaardag van de bevrijding van Brussel, presenteren de vereniging Bakushinta, het Museum van het Verzet, een pop-up tentoonstelling getiteld \u201cVerzetsstrijders van Congolese afkomst in het Belgisch Verzet 1940-1945\u201d. Deze uitzonderlijke tentoonstelling legt de nadruk op de individuele parcours van Congolese en metisse verzetsstrijders","longdescr":"Deze tentoonstelling maakt deel uit van het project \u201cOns verhaal: Het collectieve geheugen herstellen\u201d. De deelname van mensen van Congolese afkomst aan het verzet tegen de Duitse bezetter tijdens de Tweede Wereldoorlog is nog steeds onderbelicht. De tentoonstelling is het resultaat van een volledig nieuw project en onthult de vele individuele verhalen van Congolese en metisse verzetsstrijders en oorlogsvrijwilligers. Deze herontdekking sluit aan op een ruimere vraag naar de deelname van de Congolezen en Congo aan de overwinning van de Geallieerden. \nDe tentoonstelling vindt plaats in de Espace 16Arts (Anderlecht) en zal gekenmerkt worden door drie hoogtepunten gewijd aan drie figuren die het verzet tegen de nazi-bezetter belichamen: Fran\u00e7ois Kamanda en de groep van het Schuiloord 24 van het Geheim Leger, op donderdag 29 augustus om 18u; verpleegster Augusta Chiwy, bijgenaamd de Engel van Bastenaken, op dinsdag 03 september om 18u; John Vost\u00e9, van het Verzet tot de deportatie, op zondag 8 september om 14u. \n","performers":null,"boxoffice_url":null,"website":"http:\/\/www.museumresistance.be\/","email":"museum.resistance.verzet@gmail.com","phone_contact":"+32 2 522 40 41","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.5700000212"}},"place":{"id":267822,"translations":{"de":{"name":"Espace 16 Arts","address_street_name":"rue Rossini","address_street_number":"16","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"rue Rossini, 16","address_line2":"1070 Anderlecht","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Espace 16 Arts","address_street_name":"rue Rossini","address_street_number":"16","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"rue Rossini, 16","address_line2":"1070 Anderlecht","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Espace 16 Arts","address_street_name":"rue Rossini","address_street_number":"16","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"rue Rossini, 16","address_line2":"1070 Anderlecht","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Espace 16 Arts","address_street_name":"rue Rossini","address_street_number":"16","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1070","address_city":"Anderlecht","address_line1":"rue Rossini, 16","address_li