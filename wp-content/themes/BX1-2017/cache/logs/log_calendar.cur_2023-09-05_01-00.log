s","Ni\u00f1os de 9 a 12 a\u00f1os","Familias","Personas de la tercera edad"],"nl":["Jongeren 12-15 j.","Jongeren 15-18 j.","Scholen","Leerkrachten","Kinderen 6-9 j.","Kinderen 9-12 j.","Familie","Senioren"]}},"educational_targets":{"list":[],"translations":{}},"tags":["kids"],"opening":{"day":"2020-09-18","end":"17:00:00","is_only_by_appointment":false,"start":"10:00:00","timestamp":"2020-09-18T10:00:00"}},{"id":50001089,"date_start":"2023-09-06","date_end":"2023-09-06","date_next":"2023-09-06","accept_article27":false,"accept_cultuurbon":false,"accept_paspartoe":false,"is_closed_on_public_holidays":false,"is_closed_on_school_holidays":false,"is_only_by_appointment":false,"is_permanent":false,"is_free":true,"is_online":false,"is_canceled":false,"is_soldout":false,"last_updated_at":"2023-08-21T09:15:04+02:00","published_at":"2023-08-21T09:07:34+02:00","publication_state":"public","date_embargo":null,"show_in_agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":283513,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"concert","ranking":1.2599210498948732,"languages":{"spoken":["it","en","fr"],"subtitles":[]},"categories":{"main":{"id":1,"translations":{"de":"Konzert","pt":null,"en":"Concert","it":"Concerti","cn":null,"fr":"Concert","sp":"Concierto","nl":"Concert"}},"others":{"list":[2],"translations":{"de":["Klassisch"],"pt":[null],"en":["Classical"],"it":["Classica"],"cn":[null],"fr":["Classique"],"sp":["Cl\u00e1sica"],"nl":["Klassiek"]}}},"translations":{"de":{"name":"Concert: Echoes of Time: Chamber Music Through the Ages","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/iicbruxelles.esteri.it","email":"iicbruxelles@esteri.it","phone_contact":null,"phone_booking":"+32 2 533 27 20","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50001089"},"pt":{"name":"Concert: Echoes of Time: Chamber Music Through the Ages","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/iicbruxelles.esteri.it","email":"iicbruxelles@esteri.it","phone_contact":null,"phone_booking":"+32 2 533 27 20","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50001089"},"en":{"name":"Concert: Echoes of Time: Chamber Music Through the Ages","shortdescr":"This chamber music concert will take the audience on a captivating journey through different eras of classical music, showcasing the evolution and diverse styles of chamber music compositions. The program will feature a selection of works from various time periods, highlighting the unique characteristics and artistic expressions of each composer.","longdescr":"PROGRAMME\n\nNicolas Bacri: Sonatina Lirica op.108 (2008)\nAlla sonatina (Adagietto amoroso e comodo) \/ Canzonetta per un bambino (Adagio e mesto) \/ Rondo versatile (Allegretto)\nThis contemporary piece by Nicolas Bacri combines lyrical melodies with modern harmonies, creating a bridge between traditional and contemporary chamber music.\n\nJohannes Brahms: Sonata n.1 in f minor, op.120 (1894)\nI. Allegro appassionato\nII. Andante un poco adagio\nIII. Allegretto grazioso\nIV. Vivace\nJohannes Brahms' sonata represents the romantic period and embodies the emotional intensity and introspection typical of that Era.\n\npause\n\nJ\u00f6rg Widmann: 5 Br\u00fcchst\u00fccke (2004)\nI. Aussert Langsam\nII. Presto Possibile\nIII. Sehr Langsam, Frei\nIV. Energiegeladen, Sehr Schnell\nV. Achtel=40\nJo\u0308rg Widmann's composition offers a glimpse into the complexities of contemporary chamber music, with its fragmented structure and dynamic interplay between instruments.\n\nLeo\u0161 Jan\u00e1\u010dek: Sonata per violino e pianoforte (JW VII\/7) (1922)\n(trascritta per clarinetto da Shirley Brill)\nI. Con moto \nII. Ballada \nIII. Allegretto \nIV. Adagio\nLeos Janacek's violin sonata showcases the expressive power and distinctive folk-inspired melodies that characterize his music.\n","performers":"Emanuele Mammarella (clarinet) and Marco Mantovani (piano), two young Italian musicians formed at \u201cKoninklijk Conservatorium Brussel\u201d. ","boxoffice_url":null,"website":"http:\/\/iicbruxelles.esteri.it","email":"iicbruxelles@esteri.it","phone_contact":null,"phone_booking":"+32 2 533 27 20","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50001089"},"it":{"name":"Concert: Echoes of Time: Chamber Music Through the Ages","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/iicbruxelles.esteri.it","email":"iicbruxelles@esteri.it","phone_contact":null,"phone_booking":"+32 2 533 27 20","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50001089"},"cn":{"name":"Concert: Echoes of Time: Chamber Music Through the Ages","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/iicbruxelles.esteri.it","email":"iicbruxelles@esteri.it","phone_contact":null,"phone_booking":"+32 2 533 27 20","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50001089"},"fr":{"name":"Echoes of time : la musique de chambre \u00e0 travers les \u00e2ges","shortdescr":"Ce concert de musique de chambre emm\u00e8nera le public dans un voyage captivant \u00e0 travers diff\u00e9rentes \u00e9poques de la musique classique, mettant en valeur l'\u00e9volution et les divers styles des compositions de musique de chambre. Le programme comprendra une s\u00e9lection d'\u0153uvres de diff\u00e9rentes \u00e9poques, mettant en \u00e9vidence les caract\u00e9ristiques uniques et les expressions artistiques de chaque compositeur.","longdescr":"PROGRAMME\nNicolas Bacri: Sonatina Lirica op.108 (2008)\n\nAlla sonatina (Adagietto amoroso e comodo) \/ Canzonetta per un bambino (Adagio e mesto) \/ Rondo versatile (Allegretto)\n\nCette pi\u00e8ce contemporaine de Nicolas Bacri combine des m\u00e9lodies lyriques avec des harmonies modernes, cr\u00e9ant un pont entre la musique de chambre traditionnelle et contemporaine.\n\nJohannes Brahms: Sonata n.1 in f minor, op.120 (1894)\n\nI. Allegro appassionato\nII. Andante un poco adagio\nIII. Allegretto grazioso\nIV. Vivace\n\nLa sonate de Johannes Brahms repr\u00e9sente la p\u00e9riode romantique et incarne l'intensit\u00e9 \u00e9motionnelle et l'introspection typiques de cette \u00e9poque.\n\n* pausa *\n\nJ\u00f6rg Widmann: 5 Br\u00fcchst\u00fccke (2004)\n\nI. Aussert Langsam\nII. Presto Possibile\nIII. Sehr Langsam, Frei\nIV. Energiegeladen, Sehr Schnell\nV. Achtel=40\n\nLa composition de J\u00f6rg Widmann offre un aper\u00e7u des complexit\u00e9s de la musique de chambre contemporaine, avec sa structure fragment\u00e9e et l'interaction dynamique entre les instruments.\n\nLeo\u0161 Jan\u00e1\u010dek: Sonata per violino e pianoforte (JW VII\/7) (1922)\n(trascritta per clarinetto da Shirley Brill)\n\nI. Con moto\nII. Ballada\nIII. Allegretto\nIV. Adagio\n\nLa sonate pour violon de Leos Janacek met en valeur la puissance expressive et les m\u00e9lodies d'inspiration folklorique qui caract\u00e9risent sa musique.","performers":"Emanuele Mammarella (clarinette) et Marco Mantovani (piano), deux jeunes musiciens italiens form\u00e9s au \"Koninklijk Conservatorium Brussel\"\n","boxoffice_url":null,"website":"http:\/\/iicbruxelles.esteri.it","email":"iicbruxelles@esteri.it","phone_contact":null,"phone_booking":"+32 2 533 27 20","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50001089"},"sp":{"name":"Concert: Echoes of Time: Chamber Music Through the Ages","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/iicbruxelles.esteri.it","email":"iicbruxelles@esteri.it","phone_contact":null,"phone_booking":"+32 2 533 27 20","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50001089"},"nl":{"name":"Concert: Echoes of Time: Chamber Music Through the Ages","shortdescr":null,"longdes