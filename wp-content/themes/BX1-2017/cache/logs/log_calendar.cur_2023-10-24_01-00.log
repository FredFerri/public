"ranking":0.12549213105967125,"languages":{"spoken":["fr","en","es"],"subtitles":[]},"categories":{"main":{"id":102,"translations":{"de":"Stadtf\u00fchrungen","pt":null,"en":"Guided tours","it":"Visite guidate","cn":null,"fr":"Visites Guid\u00e9es","sp":"Visitas guiadas","nl":"Begeleide rondleidingen"}},"others":{}},"translations":{"de":{"name":"Le City Tour de Bruxelles le plus complet","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.brussels-city-tours.com\/","email":"info@brussels-city-tours.com","phone_contact":"+32 2 513 77 44","phone_booking":"+32 2 513 77 44","agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.545392"},"pt":{"name":"Le City Tour de Bruxelles le plus complet","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.brussels-city-tours.com\/","email":"info@brussels-city-tours.com","phone_contact":"+32 2 513 77 44","phone_booking":"+32 2 513 77 44","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.545392"},"en":{"name":"Brussels Highlights Walking and Bus Tour","shortdescr":"Discover the Belgian capital during this 3-hour tour which will take you to all the main sites: Grand Place, Atomium, Palais Royale, Parc du Cinquantenaire and the European Parliament.","longdescr":"Our guided tour of Brussels is the perfect introduction to the fascinating capital of\nBelgium. You will have the chance to discover the ancient buildings of the city\nas well as its splendid modern districts. Our local guides are passionate on sharing information about our city\u2019s past, present and future. The tour will start with the majestic Grand Place, the\ncradle of medieval Brussels, followed by our iconic Manneken Pis and the stunning\nRoyal Galleries. We then hop on in one of our cozy coaches and the next stop will be the world-famous Atomium. After that, we drive along the marvelous Chinese and Japanese Tower. From\nthe Royal Residence, we will return to the city center to visit the Royal Palace, the European Parliament, the Commission and the Council of Europ Europe. After this\ntour\u2026 you have seen all the highlights of our amazing capital city!","performers":"Multilingual guide\nAir-conditioned coach \/ bus","boxoffice_url":"http:\/\/ticket.visit.brussels\/en\/545392\/brussels-highlights-walking-and-bus-tour\/shop","website":"http:\/\/www.brussels-city-tours.com\/","email":"info@brussels-city-tours.com","phone_contact":"+32 2 513 77 44","phone_booking":"+32 2 513 77 44","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.545392"},"it":{"name":"Le City Tour de Bruxelles le plus complet","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.brussels-city-tours.com\/","email":"info@brussels-city-tours.com","phone_contact":"+32 2 513 77 44","phone_booking":"+32 2 513 77 44","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.545392"},"cn":{"name":"Le City Tour de Bruxelles le plus complet","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.brussels-city-tours.com\/","email":"info@brussels-city-tours.com","phone_contact":"+32 2 513 77 44","phone_booking":"+32 2 513 77 44","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.545392"},"fr":{"name":"Visite \u00e0 pied et en bus des incontournables de Bruxelles","shortdescr":"D\u00e9couvrez la capitale belge au cours de cette visite de 3 heures qui vous emm\u00e8nera vers tous les principaux sites : Grand-Place, Atomium, Palais Royale, parc du Cinquantenaire ou encore Parlement europ\u00e9en.","longdescr":"Notre visite guid\u00e9e de Bruxelles est une introduction id\u00e9ale \u00e0 la fascinante capitale belge. Vous aurez la chance de d\u00e9couvrir les b\u00e2timents anciens de la ville ainsi que ses splendides quartiers modernes. Nos guides professionnels vous l\u2019histoire de notre ville. La visite commencera par la magnifique Grand Place, berceau du Bruxelles m\u00e9di\u00e9val, suivie de notre embl\u00e9matique Manneken Pis et des superbes Galeries Royales. Nous monterons ensuite dans l'un de nos autocars vers le c\u00e9l\u00e8bre Atomium, et longerons la tour chinoise et japonaise. De la R\u00e9sidence Royale, nous retournerons ensuite au centre-ville pour observer le Palais Royal, le Parlement europ\u00e9en, la Commission et le Conseil de l'Europe.  Apr\u00e8s cette visite\u2026 vous aurez tout vu !","performers":"Guide multilingue\nTransport en bus climatis\u00e9","boxoffice_url":"http:\/\/ticket.visit.brussels\/fr\/545392\/visite-a-pied-et-en-bus-des-incontournables-de-bruxelles\/shop","website":"http:\/\/www.brussels-city-tours.com\/","email":"info@brussels-city-tours.com","phone_contact":"+32 2 513 77 44","phone_booking":"+32 2 513 77 44","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.545392"},"sp":{"name":"Le City Tour de Bruxelles le plus complet","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.brussels-city-tours.com\/","email":"info@brussels-city-tours.com","phone_contact":"+32 2 513 77 44","phone_booking":"+32 2 513 77 44","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.545392"},"nl":{"name":"Halfdaagse stadstour van Brussel","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":"http:\/\/ticket.visit.brussels\/nl\/545392\/halfdaagse-stadstour-van-brussel\/shop","website":"http:\/\/www.brussels-city-tours.com\/","email":"info@brussels-city-tours.com","phone_contact":"+32 2 513 77 44","phone_booking":"+32 2 513 77 44","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.545392"}},"place":{"id":50000497,"translations":{"de":{"name":"Brussels City Tours","address_street_name":"Rue du March\u00e9 aux Herbes","address_street_number":"61","address_street_box":null,"email":"info@brussels-city.com