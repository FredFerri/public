ll,"boxoffice_url":null,"website":"https:\/\/www.bruxellesbavard.be\/fr\/visites-pour-individuels\/298--1832--visite-gratuite-de-l-hotel-de-ville-de-saint-gilles-pour-les-saint-gillois","email":"info@bruxellesbavard.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50008270"},"cn":{"name":"Visite gratuite H\u00f4tel de ville de Saint-Gilles pour les Saint-Gillois","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.bruxellesbavard.be\/fr\/visites-pour-individuels\/298--1832--visite-gratuite-de-l-hotel-de-ville-de-saint-gilles-pour-les-saint-gillois","email":"info@bruxellesbavard.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50008270"},"fr":{"name":"Visite gratuite H\u00f4tel de ville de Saint-Gilles pour les Saint-Gillois","shortdescr":null,"longdescr":"Vous habitez Saint-Gilles ? Venez d\u00e9couvrir gratuitement l\u2019h\u00f4tel de Ville de votre commune, lieu de vie, d\u2019art et de m\u00e9moire.\n\nInaugur\u00e9 en 1904, cet h\u00f4tel de ville est l'un des plus beaux de notre capitale. Con\u00e7u dans l\u2019ambiance optimiste de la Belle Epoque, il a fait appel aux meilleurs artistes pour illustrer la conviction que les progr\u00e8s de l\u2019humanit\u00e9 se feront par l\u2019Art, la Science, l\u2019Education, la D\u00e9mocratie, le Travail\u2026. Quel programme ! Et quelle r\u00e9ussite artistique ! Notre parcours int\u00e9rieur et ext\u00e9rieur vous en donnera les cl\u00e9s et vous emm\u00e8nera de surprise en surprise : d\u00e9cors, sculptures, fresques, d\u00e9tails poignants ou cocasses nous raconteront l\u2019espoir centenaire d\u2019un monde meilleur et nous incitera \u00e0 r\u00e9fl\u00e9chir \u00e0 la place de ces valeurs de progr\u00e8s pour le temps pr\u00e9sent et pour l\u2019avenir.\n\nMerci de nous fournir votre adresse lors de la r\u00e9servation.\n\nRendez-vous au pied de l'escalier d'honneur de l\u2019h\u00f4tel de Ville de Saint-Gilles.","performers":null,"boxoffice_url":null,"website":"https:\/\/www.bruxellesbavard.be\/fr\/visites-pour-individuels\/298--1832--visite-gratuite-de-l-hotel-de-ville-de-saint-gilles-pour-les-saint-gillois","email":"info@bruxellesbavard.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50008270"},"sp":{"name":"Visite gratuite H\u00f4tel de ville de Saint-Gilles pour les Saint-Gillois","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.bruxellesbavard.be\/fr\/visites-pour-individuels\/298--1832--visite-gratuite-de-l-hotel-de-ville-de-saint-gilles-pour-les-saint-gillois","email":"info@bruxellesbavard.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50008270"},"nl":{"name":"Visite gratuite H\u00f4tel de ville de Saint-Gilles pour les Saint-Gillois","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/www.bruxellesbavard.be\/fr\/visites-pour-individuels\/298--1832--visite-gratuite-de-l-hotel-de-ville-de-saint-gilles-pour-les-saint-gillois","email":"info@bruxellesbavard.be","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50008270"}},"place":{"id":50000553,"translations":{"de":{"name":"H\u00f4tel de ville de Saint-Gilles","address_street_name":"Place Maurice Van Meenen","address_street_number":"39","address_street_box":null,"email":null,"website":null,"phone_contact":null,"phone_booking":null,"address_zip":"1060","address_city":"Saint-Gilles","address_line1":"Place Maurice Van Meenen, 39","address_line2":"1060 Saint-Gilles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"H\u00f4tel de ville de Saint-Gill