cr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.mazelgalerie.com","email":"contact@mazelgalerie.com","phone_contact":"+32 2 850 29 28","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.5700003245"},"en":{"name":"Rock, paper, scissors","shortdescr":"Pour cette derni\u00e8re exposition de l'ann\u00e9e, la Mazel Galerie r\u00e9unit une quinzaine de ses artistes, dont deux nouvelles collaborations : le duo espagnol PichiAvo et l'artiste fran\u00e7aise YZ (Eyes). \n","longdescr":"Derri\u00e8re ce titre ludique \"Pierre, feuille, ciseaux\" se cache les diff\u00e9rents m\u00e9diums et techniques que les visiteurs pourront d\u00e9couvrir \u00e0 la galerie, allant de la c\u00e9ramique au dessin en passant par la peinture, le collage et d'autres ...\nDans l'art contemporain, les \u0153uvres combinent de plus en plus souvent des techniques mixtes. C'est la richesse de ces associations de mat\u00e9riaux au service de la repr\u00e9sentation d'un sujet ou d'une id\u00e9e qu'illustre cette exposition.","performers":"Add Fuel; David Bruce; C215; Fanakapan; Maike Freess; Stan Manoukian; Murmure; Gabriela Noelle -  Laurina Paperina; Pantonio; PEZ; PichiAvo; Austyn Taylor; YZ","boxoffice_url":null,"website":"http:\/\/www.mazelgalerie.com","email":"contact@mazelgalerie.com","phone_contact":"+32 2 850 29 28","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.5700003245"},"it":{"name":"Rock, paper, scissor","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.mazelgalerie.com","email":"contact@mazelgalerie.com","phone_contact":"+32 2 850 29 28","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.5700003245"},"cn":{"name":"Rock, paper, scissor","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"http:\/\/www.mazelgalerie.com","email":"cont