agenda":true,"is_outside":false,"is_high_capacity":false,"is_not_major_event":false,"backoffice_id":289394,"facebook_link":null,"import_origin":null,"is_part_of":null,"sub_type":"expo","ranking":0.18758399854508012,"languages":{"spoken":["es","fr","de","nl","en"],"subtitles":[]},"categories":{"main":{"id":23,"translations":{"de":"Ausstellung","pt":null,"en":"Exhibition","it":"Esposizioni","cn":null,"fr":"Exposition","sp":"Exhibici\u00f3n","nl":"Tentoonstellingen"}},"others":{"list":[36],"translations":{"de":["Museen & Kunstzentren"],"pt":[null],"en":["Museums and art centers"],"it":["Musei e centri artistici"],"cn":[null],"fr":["Mus\u00e9es et art centers"],"sp":["Museos y centros de arte"],"nl":["Musea en kunstcentra"]}}},"translations":{"de":{"name":"Happy Visit \/ Nocturne","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/coudenberg.brussels\/","email":"info@belvue.be","phone_contact":"+ 32 (0)2 500 45 54","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/de\/visitors\/agenda\/event-detail.50004715"},"pt":{"name":"Happy Visit \/ Nocturne","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/coudenberg.brussels\/","email":"info@belvue.be","phone_contact":"+ 32 (0)2 500 45 54","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.50004715"},"en":{"name":"Happy Visit \/ Nocturne","shortdescr":"50% off the admission price","longdescr":"You get 50% off the admission price after 5pm on Saturday and Sunday.\nThe Coudenberg Palace and BELvue Museum are open until 7pm. So take advantage of the late afternoon to visit our museums!\n\nFrom Tuesday to Friday, the museum is open from 9.30am to 5pm and on Saturday and Sunday from 11am to 7pm. During the week and on weekends before 5pm, you pay the standaard admission price. ","performers":null,"boxoffice_url":null,"website":"https:\/\/coudenberg.brussels\/","email":"info@belvue.be","phone_contact":"+ 32 (0)2 500 45 54","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.50004715"},"it":{"name":"Happy Visit \/ Nocturne","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/coudenberg.brussels\/","email":"info@belvue.be","phone_contact":"+ 32 (0)2 500 45 54","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.50004715"},"cn":{"name":"Happy Visit \/ Nocturne","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/coudenberg.brussels\/","email":"info@belvue.be","phone_contact":"+ 32 (0)2 500 45 54","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.50004715"},"fr":{"name":"Happy Visit \/ Nocturne","shortdescr":"une r\u00e9duction de 50 % sur le prix d'entr\u00e9e","longdescr":"Vous b\u00e9n\u00e9ficiez d'une r\u00e9duction de 50 % sur le prix d'entr\u00e9e apr\u00e8s 17h le samedi et le dimanche.\nLe Palais du Coudenberg et le Mus\u00e9e BELvue ouvrent jusqu\u2019\u00e0 19h. Profitez donc de la fin d\u2019apr\u00e8s-midi pour visiter nos mus\u00e9es !\n\nDu mardi au vendredi, le mus\u00e9e est ouvert de 9h30 \u00e0 17h et le samedi et le dimanche de 11h \u00e0 19h. En semaine et le week-end avant 17h, vous payez le tarif normal. ","performers":null,"boxoffice_url":null,"website":"https:\/\/coudenberg.brussels\/","email":"info@belvue.be","phone_contact":"+ 32 (0)2 500 45 54","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50004715"},"sp":{"name":"Happy Visit \/ Nocturne","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/coudenberg.brussels\/","email":"info@belvue.be","phone_contact":"+ 32 (0)2 500 45 54","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50004715"},"nl":{"name":"Happy Visit \/ Nocturne","shortdescr":"50% korting op de toegangsprijs","longdescr":"Je krijgt 50% korting op de toegangsprijs na 17u op zaterdag en zondag.\nHet Coudenbergpaleis en het BELvue Museum zijn open tot 19u. Profiteer dus van de late namiddag om onze musea te bezoeken!\n\nVan dinsdag tot vrijdag is het museum open van 9u30 tot 17u en op zaterdag en zondag van 11u tot 19u. Tijdens de week en in het weekend voor 17u betaal je het standaardtarief. \n ","performers":null,"boxoffice_url":null,"website":"https:\/\/coudenberg.brussels\/","email":"info@belvue.be","phone_contact":"+ 32 (0)2 500 45 54","phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50004715"}},"place":{"id":258195,"translations":{"de":{"name":"Coudenberg Palast","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@coudenberg.brussels","website":"http:\/\/www.coudenberg.brussels","phone_contact":"+32 2 500 45 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"Ein unterirdischer Parcours, in dessen Verlauf Sie die \u00dcberreste des Palastes von Charles V. entdecken k\u00f6nnen. Seit dem Mittelalter \u00fcberragt eine f\u00fcrstliche Residenz auf dem Coudenberg die Stadt Br\u00fcssel. Das architektonische Ensemble, das sich seit dem 12. Jahrhundert immer wieder weiterentwickelt hat, gilt als einer der sch\u00f6nsten Pal\u00e4ste Europas und eine der wichtigsten Residenzen von Karl V. Dieses prestigetr\u00e4chtige Geb\u00e4ude wurde bei einem Brand im Februar 1731 schwer besch\u00e4digt. Vierzig Jahre sp\u00e4ter wurden die Ruinen des Palasts dem Erdboden gleichgemacht, um Platz f\u00fcr den Place Royale zu machen. Die \u00dcberreste dieses Geb\u00e4udes bilden heute die arch\u00e4ologische St\u00e4tte des Coudenberg. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Palais du Coudenberg","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@coudenberg.brussels","website":"http:\/\/www.coudenberg.brussels","phone_contact":"+32 2 500 45 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Coudenberg Palace","address_street_name":"Paleizenplein","address_street_number":"7","address_street_box":null,"email":"info@coudenberg.brussels","website":"http:\/\/www.coudenberg.brussels","phone_contact":"+32 2 500 45 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Paleizenplein, 7","address_line2":"1000 Bruxelles","description_web":"Once upon a time, the Coudenberg Palace towered over the city of Brussels. Charles V and many other of the most powerful rulers ever to reign in Europe made this princely residence their home between the 12th and 18th centuries, until it was consumed by a terrible fire.  Every trace of this prestigious palace simply disappeared underground for many years. Today, however, these ruins constitute a fascinating archeological site incorporating a network of underground passages and chambers.\r\n \r\nWhen you visit it you can explore the principal buildings of the palace and enjoy a stroll along the Rue Isabelle, which is now underground.  In the Coudenberg Museum, located in Hoogstraeten House, the finest of the archeological discoveries made during the various excavations of the Coudenberg site are displayed.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Coudenberg Palazzo","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@coudenberg.brussels","website":"http:\/\/www.coudenberg.brussels","phone_contact":"+32 2 500 45 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"\"Il sito archeologico di Coudenberg vi svela un percorso sotterraneo e un museo dedicati a Carlo V sulla Place de Palais a Bruxelles.\tSito Archeologico di Coudenbergl sito...\"\r\n\r\nIl sito archeologico di Coudenberg vi svela un percorso sotterraneo e un museo dedicati a Carlo V sulla Place de Palais a Bruxelles.\r\n\r\nSito Archeologico di Coudenberg\r\n\r\nl sito riunisce vestigia dell'antico palazzo di Bruxelles, della residenza di Hoogstraeten e della Rue Isabelle. Un'affascinante passeggiata che vi conduce sotto il pav\u00e9 della place Royale, alla scoperta dei resti del Palazzo di Coudenberg che fu una delle residenze principali di Carlo V. \u00a0\r\n\r\nMuseo del Coudenberg\r\nil museo vi invita a scoprire un'esposizione permanente di oggetti trovati durante gli scavi effettuati sul sito negli ultimi 25 anni. potete combinare la vostra visita con quella del Museo BELvue.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Palais du Coudenberg","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@coudenberg.brussels","website":"http:\/\/www.coudenberg.brussels","phone_contact":"+32 2 500 45 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Palais du Coudenberg","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@coudenberg.brussels","website":"http:\/\/www.coudenberg.brussels","phone_contact":"+32 2 500 45 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"Autrefois, l\u2019impressionnant palais du Coudenberg dominait la ville de Bruxelles. Charles Quint et d\u2019autres souverains parmi les plus puissants que l\u2019Europe ait connus ont habit\u00e9 cette r\u00e9sidence princi\u00e8re du 12e au 18e si\u00e8cle, jusqu\u2019\u00e0 ce qu\u2019un terrible incendie la d\u00e9truise \u00e0 jamais. Les ruines de ce palais ont disparu pendant de nombreuses ann\u00e9es dans les sous-sols. Aujourd\u2019hui, ces vestiges forment un site arch\u00e9ologique enchanteur constitu\u00e9 d\u2019un r\u00e9seau de salles et de passages souterrains.\r\n \r\nAu cours de votre visite, vous d\u00e9couvrirez les b\u00e2timents principaux du palais et vous fl\u00e2nerez dans la rue Isabelle, qui est aujourd\u2019hui souterraine. Dans le mus\u00e9e du Coudenberg, qui est abrit\u00e9 dans l\u2019h\u00f4tel d\u2019Hoogstraeten, sont expos\u00e9es les plus belles d\u00e9couvertes arch\u00e9ologiques effectu\u00e9es lors des diff\u00e9rentes campagnes de fouilles men\u00e9es sur le site du Coudenberg\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Coudenberg Palacio","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@coudenberg.brussels","website":"http:\/\/www.coudenberg.brussels","phone_contact":"+32 2 500 45 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"En el emplazamiento arqueol\u00f3gico de Coudenberg encontrar\u00e1s un recorrido subterr\u00e1neo y un museo dedicado al Palacio Carlos V, en la Place des Palais de Bruselas....\r\n\r\nEn el emplazamiento arqueol\u00f3gico de Coudenberg encontrar\u00e1s un recorrido subterr\u00e1neo y un museo dedicado al Palacio Carlos V, en la Place des Palais de Bruselas.\r\n\r\nEl emplazamiento arqueol\u00f3gico Coudenberg\r\n\r\nEl emplazamiento arqueol\u00f3gico Coudenberg est\u00e1 compuesto de vestigios del antiguo Palacio de Bruselas, del Hotel Hoogstraeten y de la Rue Isabelle.\u00a0Este fascinante paseo te llevar\u00e1 a descubrir los vestigios del Palacio Coudenberg, que fue una de las residencias de Carlos V.\r\n\r\nMuseo Coudenberg\r\n\r\nInstalado en los vestigios del antiguo Hotel de Hoogstraeten, el Museo Coudenberg  te invita a descubrir una exposici\u00f3n permanente de objetos hallados durante las distintas excavaciones arqueol\u00f3gicas realizadas los \u00faltimos 25 a\u00f1os.\u00a0Podr\u00e1s combinar tu visita del Coudenberg con la del Museo BELvue.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Coudenbergpaleis","address_street_name":"Paleizenplein","address_street_number":"7","address_street_box":null,"email":"info@coudenberg.brussels","website":"http:\/\/www.coudenberg.brussels","phone_contact":"+32 2 500 45 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Paleizenplein, 7","address_line2":"1000 Bruxelles","description_web":"Ooit werd Brussel gedomineerd door het reusachtige Coudenbergpaleis. Keizer Karel en het kruim van de Europese adel verbleven er tussen de twaalfde en de achttiende eeuw. Tot het noodlot toesloeg en een brand het prachtige gebouw verwoestte. Vele resten bleven echter intact en verdwenen ... onder de grond. Nu is het een betoverende archeologische site, een netwerk van gewelfde gangen, zalen en verborgen kamers.\r\n \r\nTijdens een bezoek ontdek je de hoofdgebouwen van het paleis en flaneer je door de Isabellastraat, die nu onder de grond ligt! In het museum van de Coudenberg, dat in het bovengrondse Hof van Hoogstraeten ondergebracht is, kan je de mooiste archeologische voorwerpen bewonderen die in de loop van de verschillende opgravingswerken op de Coudenbergsite werden ontdekt.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[16],"translations":{"de":["K\u00f6nigliches Viertel"],"pt":[null],"en":["Royal"],"it":["Quartiere reale"],"cn":[null],"fr":["Quartier Royal"],"sp":["Quartier Royal \u2014Barrio de la Corte\u2014"],"nl":["Koninklijke wijk"]}},"zones":{"list":[19],"translations":{"de":["Zentrum"],"pt":[null],"en":["Centre"],"it":["Centro"],"cn":[null],"fr":["Centre"],"sp":["Centro"],"nl":["Centrum"]}},"neca":null,"facebook_id":null,"backoffice_id":18195,"location":{"lat":50.8426107,"lon":4.3606882},"region":"brussels","last_updated_at":"2024-01-31T10:06:37+01:00","published_at":"2014-05-05T10:58:29+02:00","import_origin":null,"external_id":null,"is_in_address_book":true,"is_in_vb_export":true,"resto_ranking":0},"organizer":{"id":258195,"translations":{"de":{"name":"Coudenberg Palast","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@coudenberg.brussels","website":"http:\/\/www.coudenberg.brussels","phone_contact":"+32 2 500 45 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":"Ein unterirdischer Parcours, in dessen Verlauf Sie die \u00dcberreste des Palastes von Charles V. entdecken k\u00f6nnen. Seit dem Mittelalter \u00fcberragt eine f\u00fcrstliche Residenz auf dem Coudenberg die Stadt Br\u00fcssel. Das architektonische Ensemble, das sich seit dem 12. Jahrhundert immer wieder weiterentwickelt hat, gilt als einer der sch\u00f6nsten Pal\u00e4ste Europas und eine der wichtigsten Residenzen von Karl V. Dieses prestigetr\u00e4chtige Geb\u00e4ude wurde bei einem Brand im Februar 1731 schwer besch\u00e4digt. Vierzig Jahre sp\u00e4ter wurden die Ruinen des Palasts dem Erdboden gleichgemacht, um Platz f\u00fcr den Place Royale zu machen. Die \u00dcberreste dieses Geb\u00e4udes bilden heute die arch\u00e4ologische St\u00e4tte des Coudenberg. ","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Palais du Coudenberg","address_street_name":"Place des Palais","address_street_number":"7","address_street_box":null,"email":"info@coudenberg.brussels","website":"http:\/\/www.coudenberg.brussels","phone_contact":"+32 2 500 45 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Place des Palais, 7","address_line2":"1000 Bruxelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Coudenberg Palace","address_street_name":"Paleizenplein","address_street_number":"7","address_street_box":null,"email":"info@coudenberg.brussels","website":"http:\/\/www.coudenberg.brussels","phone_contact":"+32 2 500 45 54","phone_booking":null,"address_zip":"1000","address_city":"Bruxelles","address_line1":"Paleizenplein, 7","address_line2":"1000 Bruxelles","description_web":"Once upon a time, the Coudenberg Palace towered over the city of Brussels. Charles V and many other of the most powerful rulers ever to reign in Europe made this princely residence their home between the 12th and 18th centuries, until it was consumed by a terrible fire.  Every trace of this prestigious palace simply disappeared underground for many years. Today, however, these ruins constitute a fascinating archeological site incorporating a network of underground passages and chambers.\r\n \r\nWhen you visit it you can explore the principal buildings of the palace and enjoy a stroll along the Rue Isabelle, which is now underground.  In the Coudenberg Museum, located in Hoogstraeten House, the finest of the archeological discoveries made during the various excavations of the Coudenberg site are displayed.\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit