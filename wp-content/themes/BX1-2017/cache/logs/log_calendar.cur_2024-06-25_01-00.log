en une seule soir\u00e9e !\n\nLe Spirito : Rue de Stassart 18, 1050 Ixelles\n\nOUVERTURE Des Portes : 19h00\nD\u00c9BUT du Spectacle : 20h\n\nWhat The Fun : la Nouvelle vague du Stand Up","performers":"50 humoristes de la plateforme What The Fun","boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50011183"},"sp":{"name":"50 Humoristes sur Sc\u00e8ne","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50011183"},"nl":{"name":"50 Humoristes sur Sc\u00e8ne","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":null,"email":null,"phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50011183"}},"place":{"id":266561,"translations":{"de":{"name":"Spirito Brussels","address_street_name":"Rue de Stassart ","address_street_number":"18","address_street_box":null,"email":null,"website":"http:\/\/www.spiritobrussels.com\/","phone_contact":"+32 483 58 06 97","phone_booking":"+32 483 58 06 97","address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de Stassart , 18","address_line2":"1050 Ixelles","description_web":"Das Spirito ist ein Tanz-Tempel im wahrsten Sinne des Wortes, denn der Club ist in einer ehemaligen anglikanischen Kirche untergebracht. Das Spirito mit seinen pr\u00e4chtigen Gold- und Kristallverzierungen bietet einen riesigen Dancefloor, ein fantastisches Ambiente, 3 Bars und eine Lounge. Blickfang ist der spektakul\u00e4re, \u00fcberdimensionale Kronleuchter aus echtem Muranoglas. Einfach g\u00f6ttlich!\r\n\r\nGe\u00f6ffnet: Freitag \/ Samstag von 23:00 bis 06:00 Uhr.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Spirito Brussels","address_street_name":"Rue de Stassart","address_street_number":"18","address_street_box":null,"email":null,"website":"http:\/\/www.spiritobrussels.com\/","phone_contact":"+32 483 58 06 97","phone_booking":"+32 483 58 06 97","address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de Stassart, 18","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Spirito Brussels","address_street_name":"Rue de Stassart ","address_street_number":"18","address_street_box":null,"email":null,"website":"http:\/\/www.spiritobrussels.com\/","phone_contact":"+32 483 58 06 97","phone_booking":"+32 483 58 06 97","address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de Stassart , 18","address_line2":"1050 Ixelles","description_web":"Spirito Brussels, the temple of the night, located in Brussels, in an old anglican church.\r\n\r\nIn an innovative decor made of crystal and gold, SPIRITO BRUSSELS offers a huge dance floor in an incredible ambience. Tinted glass railings, mirrors and clean lines make the place\u2019s exceptional environment. Particular attention was paid to the lighting of the club, where the 'RGB lights' created a unique and mysterious atmosphere. Indeed, in a report by the edge channel 7, SPIRITO BRUSSELS has been ranked as one of the most beautiful clubs in the world.\r\n \r\nThe Club is open every Friday, Saturday and public holiday eve from 11p","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"it":{"name":"Spirito Brussels","address_street_name":"Rue de Stassart ","address_street_number":"18","address_street_box":null,"email":null,"website":"http:\/\/www.spiritobrussels.com\/","phone_contact":"+32 483 58 06 97","phone_booking":"+32 483 58 06 97","address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de Stassart , 18","address_line2":"1050 Ixelles","description_web":"Un locale cult nella capitale, tra le mura di un'antica chiesa anglicana: un ambiente mozzafiato!\r\nQuando: Venerd\u00ec \/ Sabato dalle 23:00 alle 06:00\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Spirito Brussels","address_street_name":"Rue de Stassart","address_street_number":"18","address_street_box":null,"email":null,"website":"http:\/\/www.spiritobrussels.com\/","phone_contact":"+32 483 58 06 97","phone_booking":"+32 483 58 06 97","address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de Stassart, 18","address_line2":"1050 Ixelles","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Spirito Brussels","address_street_name":"Rue de Stassart","address_street_number":"18","address_street_box":null,"email":null,"website":"http:\/\/www.spiritobrussels.com\/","phone_contact":"+32 483 58 06 97","phone_booking":"+32 483 58 06 97","address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de Stassart, 18","address_line2":"1050 Ixelles","description_web":"Un lieu culte de la capitale dans les murs d'une ancienne \u00e9glise anglicane : un d\u00e9cor \u00e0 couper le souffle !\r\nEn poussant les portes de notre church d\u00e9sacralis\u00e9e, convertissez-vous au plaisir des sens. Franchissez les limites du politiquement correct et bravez l'interdit sur notre dancefloor o\u00f9 la luxure n'est plus un p\u00each\u00e9. Chaque weekend, assistez \u00e0 nos soir\u00e9es d\u2019exception dans un cadre somptueux et faites la f\u00eate dans un d\u00e9cor fait d\u2019or et de cristal.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Spirito Brussels","address_street_name":"Rue de Stassart ","address_street_number":"18","address_street_box":null,"email":null,"website":"http:\/\/www.spiritobrussels.com\/","phone_contact":"+32 483 58 06 97","phone_booking":"+32 483 58 06 97","address_zip":"1050","address_city":"Ixelles","address_line1":"Rue de Stassart , 18","address_line2":"1050 Ixelles","description_web":"Un lugar de culto de la capital dentro de una antigua iglesia anglicana: \u00a1una decoraci\u00f3n que quita el hipo!\r\nCu\u00e1ndo: Viernes\/s\u00e1bado de 23.00 a 6.00\r\n","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"nl":{"name":"Spirito Brussels","address_street_name":"de Stassartstraat","address_street_number":"18","address_street_box":null,"email":null,"website":"http:\/\/www.spiritobrussels.com\/","phone_contact":"+32 483 58 06 97","phone_booking":"+32 483 58 06 97","address_zip":"1050","address_city":"Elsene","address_line1":"de Stassartstraat, 18","address_line2":"1050 Elsene","description_web":"Een cultclub op een cultlocatie: in een voormalige anglicaanse kerk !\r\nOpen de deuren van deze voormalige kerk en bekeer je tot tot het plezier van de zintuigen. Verleg de grenzen van het politiek correcte en negeer alle geboden op onze dansvloer, waar lust niet langer een zonde is. Feest elk weekend tijdens onze adembenemende avonden in een weelderige setting en feest in een decor gemaakt van goud en kristal.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null}},"districts":{"list":[4],"translations":{"de":["Matonge\/Saint-Boniface"],"pt":[null],"en":["Matonge\/Saint-Boniface"],"it":["Matonge\/Saint-Boniface"],"cn":[null],"fr":["Matonge\/Saint-Boniface"],"sp":["Matong\u00e9\/Saint-Boniface"],"nl":["Matonge\/Sint-Bonifatius"]}},"zones":{"list":[21],"translations":{"de":["S\u00fcden"],"pt":[null],"en":["South"],"it":["Sud"],"cn":[null],"fr":["Sud"],"sp":["Sur"],"nl":["Zuid"]}},"neca":null,"facebook_id":null,"backoffice_id":26561,"location":{"lat":50.83730156,"lon":4.36130405},"region":"brussels","last_updated_at":"2023-09-14T10:17:58+02:00","published_at":"2016-10-07T17:02:35+02:00"