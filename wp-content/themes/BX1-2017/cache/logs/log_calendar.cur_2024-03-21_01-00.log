ors\/agenda\/event-detail.551525"},"pt":{"name":"Etterbeek, le Petit Village devenu Capitale de l'Europe","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/etterbeek-le-petit-village-devenu-capitale-de-leurope\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/pt\/visitors\/agenda\/event-detail.551525"},"en":{"name":"Etterbeek, le Petit Village devenu Capitale de l'Europe","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/etterbeek-le-petit-village-devenu-capitale-de-leurope\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/en\/visitors\/agenda\/event-detail.551525"},"it":{"name":"Etterbeek, le Petit Village devenu Capitale de l'Europe","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/etterbeek-le-petit-village-devenu-capitale-de-leurope\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/it\/visitors\/agenda\/event-detail.551525"},"cn":{"name":"Etterbeek, le Petit Village devenu Capitale de l'Europe","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/etterbeek-le-petit-village-devenu-capitale-de-leurope\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/cn\/visitors\/agenda\/event-detail.551525"},"fr":{"name":"Etterbeek, le Petit Village devenu Capitale de l'Europe","shortdescr":"Qui aurait pu deviner qu\u2019Etterbeek, un petit village situ\u00e9 \u00e0 l\u2019ext\u00e9rieur de la deuxi\u00e8me enceinte de Bruxelles, deviendrait un jour le centre du pouvoir europ\u00e9en ?","longdescr":"Pourquoi Bruxelles a-t-elle endoss\u00e9 le r\u00f4le de capitale europ\u00e9enne ? \r\n\r\nNous vous emmenons dans un voyage \u00e0 travers le temps. De l\u2019Etterbeek bucolique d\u2019avant le 19e si\u00e8cle, o\u00f9 l\u2019\u00e9lite bruxelloise habitait de luxueuses et vastes demeures, au 19e si\u00e8cle, et jusqu\u2019aux ann\u00e9es 50, lorsque l\u2019Union europ\u00e9enne a d\u00e9cid\u00e9 de s\u2019y installer, on vous emm\u00e8ne dans l\u2019Histoire et la g\u00e9ographie d\u2019un quartier unique !\r\n\r\nAu cours de cette promenade, vous d\u00e9couvrirez :\r\n\u2013 Les vestiges du Domaine d\u2019Eggevoorde des 16\u00e8me et 17\u00e8me si\u00e8cles ;\r\n\u2013 Le Zoo de Bruxelles ;\r\n\u2013 La \u00ab Cit\u00e9 des Sciences \u00bb fond\u00e9e par Ernest Solvay (o\u00f9 se sont d\u00e9roul\u00e9es les c\u00e9l\u00e8bres conf\u00e9rences Solvay) ;\r\n\u2013 L\u2019ancien atelier et la maison du peintre Paul Parmentier, un exemple incroyable de construction n\u00e9ogothique ;\r\n\u2013 Les plus importantes institutions europ\u00e9ennes ;\r\n\u2013 \u2026et bien d\u2019autres choses encore ","performers":"Une visite guid\u00e9e originale de Brussels By Foot","boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/etterbeek-le-petit-village-devenu-capitale-de-leurope\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.551525"},"sp":{"name":"Etterbeek, le Petit Village devenu Capitale de l'Europe","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/etterbeek-le-petit-village-devenu-capitale-de-leurope\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.551525"},"nl":{"name":"Etterbeek, le Petit Village devenu Capitale de l'Europe","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/brusselsbyfoot.be\/etterbeek-le-petit-village-devenu-capitale-de-leurope\/","email":"info@brusselsbyfoot.com","phone_contact":"+32 472 39 82 17","phone_booking":"+32 472 39 82 17","agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.551525"}},"place":{"id":262770,"translations":{"de":{"name":"Sofitel Brussels Europe","address_street_name":"Place Jourdan","address_street_number":"1","address_street_box":null,"email":"H5282-SB@sofitel.com","website":"https:\/\/www.sofitel-brussels-europe.com\/en\/","phone_contact":"+32 2 235 51 00","phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Place Jourdan, 1","address_line2":"1040 Etterbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"Sofitel Brussels Europe","address_street_name":"Place Jourdan","address_street_number":"1","address_street_box":null,"email":"H5282-SB@sofitel.com","website":"https:\/\/www.sofitel-brussels-europe.com\/en\/","phone_contact":"+32 2 235 51 00","phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Place Jourdan, 1","address_line2":"1040 Etterbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"en":{"name":"Sofitel Brussels Europe","address_street_name":"Jourdanplein","address_street_number":"1","address_street_box":null,"email":"H5282-SB@sofitel.com","website":"https:\/\/www.sofitel-brussels-europe.com\/en\/","phone_contact":"+32 2 235 51 00","phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Jourdanplein, 1","address_line2":"1040 Etterbeek","description_web":"Discover the metamorphosis of the hotel after the refurbishment of the rooftop, meeting rooms, lobby, bar and restaurant.\n\nOur 5* hotel is ideally located on the lively Place Jourdan in the heart of the EU District, surrounded by the Leopold Park.\n\nThe hotel features 147 contemporary and stylish guestrooms and 12 recently renovated daylight meeting rooms, with a capacity up to 225 attendees.\n\nThe meeting rooms are all located on the same floor around the luminous atrium.\n\nJust inside the hotel lobby, you will find our in-house Neuhaus boutique, providing you with Belgium\u2019s best chocolates.\n\nLooking for an amazing Belgian Restaurant? \u201cTHE 1040\u201d is the place to be! In a bright and modern decor, Executive chef Gabriele Petrucci will surprise you with their reimagined Belgian classic dishes with a beautiful twist.\n\nDiscover our new Rooftop terrace bar on the 7th floor with an amazing view on the Jourdan square. It can be privatized up to 65 persons.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":"https:\/\/storage.net-fs.com\/hosting\/6128842\/9\/","visit_url":null},"it":{"name":"Sofitel Brussels Europe","address_street_name":"Place Jourdan","address_street_number":"1","address_street_box":null,"email":"H5282-SB@sofitel.com","website":"https:\/\/www.sofitel-brussels-europe.com\/en\/","phone_contact":"+32 2 235 51 00","phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Place Jourdan, 1","address_line2":"1040 Etterbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"cn":{"name":"Sofitel Brussels Europe","address_street_name":"Place Jourdan","address_street_number":"1","address_street_box":null,"email":"H5282-SB@sofitel.com","website":"https:\/\/www.sofitel-brussels-europe.com\/en\/","phone_contact":"+32 2 235 51 00","phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Place Jourdan, 1","address_line2":"1040 Etterbeek","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"fr":{"name":"Sofitel Brussels Europe","address_street_name":"Place Jourdan","address_street_number":"1","address_street_box":null,"email":"H5282-SB@sofitel.com","website":"http:\/\/www.sofitel-brussels-europe.com","phone_contact":"+32 2 235 51 00","phone_booking":null,"address_zip":"1040","address_city":"Etterbeek","address_line1":"Place Jourdan, 1","address_line2":"1040 Etterbeek","description_web":"D\u00e9couvrez la m\u00e9tamorphose de l'h\u00f4tel apr\u00e8s la r\u00e9novation du rooftop, des salles de r\u00e9union, du lobby, du bar et du restaurant.\n\nNotre h\u00f4tel 5* est id\u00e9alement situ\u00e9 sur la place Jourdan, au c\u0153ur du quartier europ\u00e9en, entour\u00e9 du parc L\u00e9opold.\n\nL'h\u00f4tel dispose de 147 chambres contemporaines et \u00e9l\u00e9gantes et de 12 salles de r\u00e9union \u00e0 la lumi\u00e8re du jour, r\u00e9cemment r\u00e9nov\u00e9es, pouvant accueillir jusqu'\u00e0 225 personnes.\n\nLes salles de r\u00e9union sont toutes situ\u00e9es au m\u00eame \u00e9tage autour de l'atrium lumineux.\n\nJuste \u00e0 l'int\u00e9rieur du hall de l'h\u00f4tel, vous trouverez la boutique Neuhaus, qui vous propose les meilleurs chocolats de Belgique.\n\nVous \u00eates \u00e0 la recherche d'un excellent restaurant belge ? Le \"THE 1040\" est l'endroit id\u00e9al ! Dans un d\u00e9cor lumineux et moderne, le chef ex\u00e9cutif Gabriele Petrucci vous surprendra avec ses plats classiques belges r\u00e9imagin\u00e9s avec une belle touche.\n\nD\u00e9couvrez notre nouveau bar terrasse-rooftop au 7\u00e8me \u00e9tage avec une vue imprenable sur la place Jourdan. Il peut \u00eatre privatis\u00e9 jusqu'\u00e0 65 personnes.","description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"sp":{"name":"Sofitel Brussels Europe","address_street_name":"Place Jourdan","address_street_number":"1","address_street_box":null,"email":"H5282-SB@sofitel.com","website":"h