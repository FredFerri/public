 et couturiers\nwww.instagram.com\/merceriemoderne\n\u2594\u2594\u2594\u2594\u2594\u2594\u2594\n tof\nrue vanp\u00e9 52\n1190 Forest - Vorst\nla boutique ferme ses portes le 26 avril.","performers":"la tof team - compos\u00e9e de \nMercerie Moderne\nGalia Ganga\nTiketik\nLes objets de Fr\u00e9do\nAtelier Brun Sauvant\nKyo Bags\nAtelier Sieste\nZohra Capucine\nKnit Knit Knit\nAtelier Upcirculer","boxoffice_url":null,"website":"https:\/\/tof.greenfabric.be","email":"popupgreenfabric@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/fr\/visitors\/agenda\/event-detail.50009682"},"sp":{"name":"le tof weekend","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/tof.greenfabric.be","email":"popupgreenfabric@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/sp\/visitors\/agenda\/event-detail.50009682"},"nl":{"name":"le tof weekend","shortdescr":null,"longdescr":null,"performers":null,"boxoffice_url":null,"website":"https:\/\/tof.greenfabric.be","email":"popupgreenfabric@gmail.com","phone_contact":null,"phone_booking":null,"agenda_url":"https:\/\/visit.brussels\/nl\/visitors\/agenda\/event-detail.50009682"}},"place":{"id":50001119,"translations":{"de":{"name":"tof","address_street_name":"Rue Jean-Baptiste Vanp\u00e9","address_street_number":"52","address_street_box":null,"email":"popupgreenfabric@gmail.com","website":"https:\/\/tof.greenfabric.be","phone_contact":null,"phone_booking":null,"address_zip":"1190","address_city":"Forest","address_line1":"Rue Jean-Baptiste Vanp\u00e9, 52","address_line2":"1190 Forest","description_web":null,"description_print":null,"booking_url":null,"sort_order":null,"virtual_visit":null,"visit_url":null},"pt":{"name":"tof","address_street_name":"Rue Jean-Baptiste Vanp\u00e9","address_street_number":"52","address_street_box":null,"email":"popupgreenfabric@gmail.com","website":"https:\/\/tof.greenfabric.be","phone_contac